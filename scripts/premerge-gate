#!/bin/bash
set -euo pipefail

script_dir="$(cd "$(dirname "$0")" && pwd -P)"
if [ "${BLORP_TEST_LOCK_HELD:-0}" != "1" ]; then
    export BLORP_TEST_LOCK_HELD=1
    exec "$script_dir/with-build-lock" "$script_dir/premerge-gate" "$@"
fi

cd "$script_dir/.."

clean_build=1
run_quality=1
run_sanitize=1
force_full=0
run_docker="auto"
docker_clean=0
docker_platform="linux/amd64"
check_examples=1
run_examples=1
run_preview_smoke=1
run_security=1
release_compiler=1
dry_run=0
test_timeout="${BLORP_TEST_TIMEOUT:-30}"
runtime_test_timeout="${BLORP_RUNTIME_TEST_TIMEOUT:-${BLORP_TEST_TIMEOUT:-60}}"
leak_test_timeout="${BLORP_LEAK_TEST_TIMEOUT:-${BLORP_TEST_TIMEOUT:-60}}"
compiler_test_timeout="${BLORP_COMPILER_TEST_TIMEOUT:-360}"
example_timeout=10

# scripts/test's own BLORP_GATE_RESULT line (from run_test_suites, below) is
# captured here so this script can print one aggregate verdict line of its
# own as the last line of stdout, however the script exits.
PREMERGE_TEST_LOG=$(mktemp "${TMPDIR:-/tmp}/blorp-premerge-test.XXXXXX")
# A gate that runs the test suites must end with exactly one valid test verdict.
# A documentation-only change skips them, and its verdict counts no tests.
test_verdict_expected=1

# Stop every child of this script, leaf first: TERM each process tree, poll
# briefly for it to exit, then KILL and reap what remains. Children only, never
# a process group. scripts/docker-gate and scripts/premerge-gate each carry
# this helper, and scripts/test has the same logic in terminate_running_gates;
# the scripts share no library, so keep them in step.
TERMINATION_GRACE_POLLS=10
TERMINATION_POLL_SECONDS=0.1

list_child_pids() {
    local parent="$1"
    if command -v pgrep >/dev/null 2>&1; then
        pgrep -P "$parent" 2>/dev/null || true
    else
        ps -o pid= -P "$parent" 2>/dev/null | tr -d ' ' || true
    fi
}

terminate_process_tree() {
    local pid="$1"
    local signal="${2:-TERM}"
    local child
    [ -n "$pid" ] || return 0
    for child in $(list_child_pids "$pid"); do
        terminate_process_tree "$child" "$signal"
    done
    kill -"$signal" "$pid" 2>/dev/null || true
}

# Whether `ps` shows the process as alive; a zombie awaiting `wait` is not.
process_is_running() {
    local state
    state=$(ps -o stat= -p "$1" 2>/dev/null || true)
    [ -n "$state" ] && [ "${state#Z}" = "$state" ]
}

terminate_child_processes() {
    local children pid poll still_running
    children=$(list_child_pids "$$")
    [ -n "$children" ] || return 0
    for pid in $children; do
        terminate_process_tree "$pid" TERM
    done
    for poll in $(seq 1 "$TERMINATION_GRACE_POLLS"); do
        still_running=0
        for pid in $children; do
            process_is_running "$pid" && still_running=1
        done
        [ "$still_running" -eq 1 ] || break
        sleep "$TERMINATION_POLL_SECONDS"
    done
    for pid in $children; do
        terminate_process_tree "$pid" KILL
        wait "$pid" 2>/dev/null || true
    done
}

# One entry per step the gate reached, in order: its name, outcome and seconds.
# The outcome is PASS, FAIL or SKIP (a step that chose not to run). The summary
# is printed from the EXIT trap, so a gate that stops early still reports the
# steps it reached, and the step that stopped it is FAIL.
step_names=()
step_statuses=()
step_seconds=()
# Set while a step runs. A step that skips itself at run time calls
# mark_step_skipped; the step functions run in this shell, not a subshell.
open_step_name=""
open_step_started=0
open_step_outcome="PASS"

step_slug() {
    printf '%s' "$1" | tr '[:upper:] ' '[:lower:]-'
}

record_step() {
    step_names+=("$1")
    step_statuses+=("$2")
    step_seconds+=("$3")
}

# One aligned table of every step reached, then the total. $1 is the gate's
# overall verdict and $2 its elapsed seconds.
print_step_table() {
    local overall="$1" total_seconds="$2" index
    echo ""
    printf '%-20s %-7s %7s\n' "Step" "Status" "Seconds"
    for ((index = 0; index < ${#step_names[@]}; index++)); do
        printf '%-20s %-7s %7s\n' \
            "${step_names[$index]}" "${step_statuses[$index]}" "${step_seconds[$index]}"
    done
    printf '%-20s %-7s %7s\n' "Total" "$overall" "$total_seconds"
}

# One BLORP_GATE_STEP line per step, for tools; see scripts/README.md.
print_step_records() {
    local index
    for ((index = 0; index < ${#step_names[@]}; index++)); do
        printf 'BLORP_GATE_STEP name=%s status=%s seconds=%s\n' \
            "$(step_slug "${step_names[$index]}")" "${step_statuses[$index]}" "${step_seconds[$index]}"
    done
}

# Set to 1 as the script's last statement. The EXIT trap treats any earlier
# exit as a failure: a fatal signal (bash runs the EXIT trap with `$?` still
# holding the last command's status, often 0) or a `set -e` abort. No signal is
# trapped, because bash defers a trap until the foreground command finishes,
# which would hold a TERM for the whole `scripts/test | tee`.
gate_finished=0
# `--help` and `--dry-run` validate nothing, so they print no verdict (a failed
# dry run still prints FAIL).
print_passing_verdict=1

premerge_gate_verdict() {
    local exit_code=$?
    # An interrupted run's `scripts/test | tee` would otherwise carry on and
    # print its own verdict after ours.
    [ "$gate_finished" -eq 1 ] || terminate_child_processes
    local total_passed=0 total_failed=0 total_tests=0 overall="PASS"
    local line status verdict_pattern parsed_passed parsed_failed parsed_tests
    local max_gate_count_digits=18
    # scripts/test may print verdicts for its own sub-gates. Its aggregate
    # must be the only gate=test result and the last line of its output.
    line=$(awk '{ last = $0 }
        $1 == "BLORP_GATE_RESULT" && $2 == "gate=test" {
            count++
            if (count == 1) result = $0
        }
        END { if (count == 1 && last == result) print result }' \
        "$PREMERGE_TEST_LOG" 2>/dev/null || true)
    rm -f "$PREMERGE_TEST_LOG"
    # Help and dry runs intentionally invoke no nested gate and print no PASS.
    if [ "$print_passing_verdict" -eq 1 ] && [ "$test_verdict_expected" -eq 1 ]; then
        # At most 18 digits per count keeps their sum within signed 64-bit
        # arithmetic, so an overflowing result cannot appear consistent.
        verdict_pattern="^BLORP_GATE_RESULT gate=test status=(PASS|FAIL) passed=([0-9]{1,$max_gate_count_digits}) failed=([0-9]{1,$max_gate_count_digits}) tests=([0-9]{1,$max_gate_count_digits})$"
        if [[ "$line" =~ $verdict_pattern ]]; then
            status=${BASH_REMATCH[1]}
            parsed_passed=${BASH_REMATCH[2]}
            parsed_failed=${BASH_REMATCH[3]}
            parsed_tests=${BASH_REMATCH[4]}
            if (( 10#$parsed_passed + 10#$parsed_failed != 10#$parsed_tests )) ||
                { [ "$status" = "PASS" ] && (( 10#$parsed_failed != 0 )); } ||
                { [ "$status" = "FAIL" ] && (( 10#$parsed_failed == 0 )); }; then
                overall="FAIL"
            else
                total_passed=$parsed_passed
                total_failed=$parsed_failed
                total_tests=$parsed_tests
                [ "$status" = "PASS" ] || overall="FAIL"
            fi
        else
            overall="FAIL"
        fi
    fi
    [ "$exit_code" -eq 0 ] || overall="FAIL"
    [ "$gate_finished" -eq 1 ] || overall="FAIL"
    # The exit status must agree with the verdict.
    [ "$overall" = "PASS" ] || [ "$exit_code" -ne 0 ] || exit_code=1
    # A step still open here aborted the gate (set -e, a signal): it failed.
    if [ -n "$open_step_name" ]; then
        record_step "$open_step_name" FAIL "$(( $(date +%s) - open_step_started ))"
        open_step_name=""
    fi
    if [ "${#step_names[@]}" -gt 0 ]; then
        print_step_table "$overall" "$(( $(date +%s) - gate_start ))"
        [ "$print_passing_verdict" -eq 0 ] || print_step_records
    fi
    if [ "$overall" = "PASS" ] && [ "$print_passing_verdict" -eq 0 ]; then
        exit "$exit_code"
    fi
    printf 'BLORP_GATE_RESULT gate=premerge-gate status=%s passed=%s failed=%s tests=%s\n' \
        "$overall" "${total_passed:-0}" "${total_failed:-0}" "${total_tests:-0}"
    exit "$exit_code"
}
trap premerge_gate_verdict EXIT

usage() {
    cat <<'EOF'
Usage: scripts/premerge-gate [options]

Run the local pre-merge validation gate. This composes the existing build,
quality, test, example, sanitizer, Docker, and lightweight security checks.

Defaults:
  - clean build at -O2 (BLORP_CLI_C_OPTIMIZATION=-O2)
  - make quality
  - make benchmark-tooling-check, when the change touches benchmark tooling
  - scripts/test --serial --release-compiler
  - focused preview CLI/runtime smoke
  - check all examples/
  - run curated fast examples
  - make test-asan
  - run Docker gate if Docker is available
  - run lightweight secret-pattern scan

The change is classified first (scripts/gate-scope, which prints a "Change
scope:" line). A documentation-only change runs only the preflight, security
scan and drift/hygiene steps; the others are reported as SKIP. When the scope
cannot be determined (no merge base with origin/main) every step runs.

Options:
  --full               Run every step, whatever the change touches.
  --quick              Skip clean build, sanitizer, Docker, and example runs.
  --no-clean           Do not run make clean before make.
  --no-quality         Skip make quality and make benchmark-tooling-check.
  --no-sanitize        Skip make test-asan.
  --no-docker          Skip Docker validation.
  --require-docker     Fail if Docker is unavailable.
  --docker-clean       Use scripts/docker-gate --clean.
  --docker-platform P  Docker platform (default: linux/amd64).
  --no-examples-check  Skip bin/blorp check examples/.
  --no-examples-run    Skip running curated examples.
  --no-preview-smoke   Skip focused preview CLI/runtime smoke.
  --no-security        Skip lightweight security scan.
  --no-release-compiler  Build/test with the default -O0 compiler instead of -O2.
  --timeout N          Test timeout in seconds (runtime uses this unless BLORP_RUNTIME_TEST_TIMEOUT is set).
  --example-timeout N  Example run timeout in seconds (default: 10).
  --dry-run            Print commands without running them.
  -h, --help           Show this help.

Examples:
  scripts/premerge-gate
  scripts/premerge-gate --quick
  scripts/premerge-gate --no-docker --no-sanitize
  scripts/premerge-gate --require-docker --docker-clean
EOF
}

while [ $# -gt 0 ]; do
    case "$1" in
        --quick)
            clean_build=0
            run_sanitize=0
            run_docker=0
            run_examples=0
            run_preview_smoke=0
            shift
            ;;
        --full)
            force_full=1
            shift
            ;;
        --no-clean)
            clean_build=0
            shift
            ;;
        --no-quality)
            run_quality=0
            shift
            ;;
        --no-sanitize)
            run_sanitize=0
            shift
            ;;
        --no-docker)
            run_docker=0
            shift
            ;;
        --require-docker)
            run_docker="require"
            shift
            ;;
        --docker-clean)
            docker_clean=1
            shift
            ;;
        --docker-platform)
            docker_platform="$2"
            shift 2
            ;;
        --no-examples-check)
            check_examples=0
            shift
            ;;
        --no-examples-run)
            run_examples=0
            shift
            ;;
        --no-preview-smoke)
            run_preview_smoke=0
            shift
            ;;
        --no-security)
            run_security=0
            shift
            ;;
        --no-release-compiler)
            release_compiler=0
            shift
            ;;
        --timeout)
            test_timeout="$2"
            if [ -z "${BLORP_RUNTIME_TEST_TIMEOUT:-}" ]; then
                runtime_test_timeout="$2"
            fi
            if [ -z "${BLORP_LEAK_TEST_TIMEOUT:-}" ]; then
                leak_test_timeout="$2"
            fi
            shift 2
            ;;
        --example-timeout)
            example_timeout="$2"
            shift 2
            ;;
        --dry-run)
            dry_run=1
            print_passing_verdict=0
            shift
            ;;
        -h|--help)
            usage
            print_passing_verdict=0
            gate_finished=1
            exit 0
            ;;
        *)
            echo "Unknown option: $1" >&2
            usage >&2
            exit 1
            ;;
    esac
done

if [ "$release_compiler" -eq 1 ]; then
    export BLORP_CLI_C_OPTIMIZATION=-O2
fi

step_count=0
gate_start=$(date +%s)

print_header() {
    step_count=$((step_count + 1))
    echo ""
    echo "[$step_count] $1"
    echo "----------------------------------------"
}

elapsed_since() {
    local started="$1"
    local now
    now=$(date +%s)
    echo "$((now - started))s"
}

quote_cmd() {
    local part
    for part in "$@"; do
        printf "%q " "$part"
    done
}

run_cmd() {
    printf '+ '
    quote_cmd "$@"
    echo ""
    if [ "$dry_run" -eq 1 ]; then
        return 0
    fi
    "$@"
}

begin_step() {
    print_header "$1"
    open_step_name="$1"
    open_step_started=$(date +%s)
    open_step_outcome="PASS"
}

# Records the open step as completed with its recorded outcome.
finish_step() {
    local seconds=$(( $(date +%s) - open_step_started ))
    record_step "$open_step_name" "$open_step_outcome" "$seconds"
    open_step_name=""
    echo "Completed in ${seconds}s."
}

mark_step_skipped() {
    echo "$1"
    open_step_outcome="SKIP"
}

# A step the gate decides not to run before it starts.
skip_step_fn() {
    begin_step "$1"
    mark_step_skipped "$2"
    finish_step
}

run_step_fn() {
    local name="$1"
    shift
    begin_step "$name"
    "$@"
    finish_step
}

snapshot_git_state() {
    local output_file="$1"
    {
        git status --porcelain=v1 --untracked-files=all
        printf '\n-- tracked diff --\n'
        git diff --binary --no-ext-diff
        printf '\n-- staged diff --\n'
        git diff --cached --binary --no-ext-diff
    } > "$output_file"
}

run_non_mutating_step_fn() {
    local name="$1"
    shift
    local before after status snapshot_status changed
    begin_step "$name"

    if [ "$dry_run" -eq 1 ]; then
        "$@"
        finish_step
        return 0
    fi

    before=$(mktemp "${TMPDIR:-/tmp}/blorp-premerge-before.XXXXXX") || return 1
    after=$(mktemp "${TMPDIR:-/tmp}/blorp-premerge-after.XXXXXX") || {
        rm -f "$before"
        return 1
    }

    if ! snapshot_git_state "$before"; then
        rm -f "$before" "$after"
        return 1
    fi

    set +e
    (
        set -euo pipefail
        "$@"
    )
    status=$?
    snapshot_git_state "$after"
    snapshot_status=$?
    set -e

    if [ "$snapshot_status" -ne 0 ]; then
        rm -f "$before" "$after"
        return "$snapshot_status"
    fi

    changed=0
    if ! cmp -s "$before" "$after"; then
        echo "$name changed the working tree; premerge validation must be non-mutating." >&2
        echo "Current git status:" >&2
        git status --short >&2
        echo "Run git diff to inspect the mutation." >&2
        changed=1
    fi

    rm -f "$before" "$after"

    if [ "$status" -ne 0 ]; then
        return "$status"
    fi

    if [ "$changed" -ne 0 ]; then
        return 1
    fi

    finish_step
}

fail_if_unmerged() {
    local unmerged
    unmerged=$(git diff --name-only --diff-filter=U)
    if [ -n "$unmerged" ]; then
        echo "Unmerged files remain:" >&2
        echo "$unmerged" >&2
        return 1
    fi
}

run_clean_build() {
    if [ "$clean_build" -eq 1 ]; then
        run_cmd make clean
    fi
    run_cmd make
}

run_quality_gate() {
    if [ "$run_quality" -eq 0 ]; then
        mark_step_skipped "Skipping quality gate."
        return 0
    fi
    run_cmd make quality
}

run_benchmark_tooling_gate() {
    if [ "$run_quality" -eq 0 ]; then
        mark_step_skipped "Skipping benchmark tooling checks."
        return 0
    fi
    run_cmd make benchmark-tooling-check
}

run_test_suites() {
    local test_flags=(--serial)
    if [ "$release_compiler" -eq 1 ]; then
        test_flags+=(--release-compiler)
    fi
    local cmd=(
        env "BLORP_TEST_TIMEOUT=$test_timeout" \
        "BLORP_RUNTIME_TEST_TIMEOUT=$runtime_test_timeout" \
        "BLORP_LEAK_TEST_TIMEOUT=$leak_test_timeout" \
        "BLORP_COMPILER_TEST_TIMEOUT=$compiler_test_timeout" scripts/test "${test_flags[@]}" \
        compiler-blorp compiler-tools std-check runtime leak doctest cli-deep lsp compiler-new compiler-new-parity
    )
    printf '+ '
    quote_cmd "${cmd[@]}"
    echo ""
    if [ "$dry_run" -eq 1 ]; then
        return 0
    fi
    "${cmd[@]}" | tee "$PREMERGE_TEST_LOG"
}

run_codegen_audit() {
    run_cmd blorp/test/test_compiler/test_pipeline/codegen_audit/run_codegen_audit.sh bin/blorp
}

run_preview_lsp_smoke() {
    local output_file="$1"
    printf '+ bin/blorp lsp < /dev/null > %q\n' "$output_file"
    if [ "$dry_run" -eq 1 ]; then
        return 0
    fi
    bin/blorp lsp < /dev/null > "$output_file"
}

run_preview_smoke_gate() {
    local tmpdir smoke tmpc lsp_out
    tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/blorp-preview.XXXXXX")
    (
        set -euo pipefail
        trap 'rm -rf "$tmpdir"' EXIT

        smoke="$tmpdir/preview.brp"
        tmpc="$tmpdir/preview.c"
        lsp_out="$tmpdir/lsp.out"

        cat > "$smoke" <<'BRP'
func main(args: List[String]) -> Int:
	print("preview smoke")
	0
BRP

        run_cmd bin/blorp check --no-format "$smoke"
        run_cmd bin/blorp compile --no-format -o "$tmpc" "$smoke"
        run_cmd bin/blorp run --timeout 5 --no-format "$smoke"
        run_cmd bin/blorp test --timeout 5 blorp/test/test_runtime/test_types/test_bool.brp
        run_cmd bin/blorp test --warmup-only
        run_cmd bin/blorp test --leak-check --suite --timeout 5 \
            blorp/test/test_runtime/test_memory/leak_check_baselines/empty_main.brp

        if [ "$run_sanitize" -eq 1 ]; then
            run_cmd bin/blorp test --sanitize --timeout 5 blorp/test/test_runtime/test_types/test_bool.brp
        else
            echo "Skipping preview sanitizer smoke."
        fi

        run_preview_lsp_smoke "$lsp_out"
        run_cmd env BLORP_TIMEOUT=5 bin/blorp test blorp/test/test_runtime/test_types/test_bool.brp
        run_cmd env BLORP_STD=standard_library/src BLORP_NO_FORMAT=1 bin/blorp check \
            blorp/test/test_runtime/test_types/test_bool.brp

        if [ "$run_sanitize" -eq 1 ]; then
            run_cmd env BLORP_SANITIZE=1 bin/blorp test --timeout 5 \
                blorp/test/test_runtime/test_types/test_bool.brp
        fi
    )
}

run_example_checks() {
    if [ "$check_examples" -eq 0 ]; then
        mark_step_skipped "Skipping example checks."
        return 0
    fi
    run_cmd bin/blorp check --no-format examples/
}

run_example_smokes() {
    local example
    if [ "$run_examples" -eq 0 ]; then
        mark_step_skipped "Skipping example runs."
        return 0
    fi

    for example in \
        examples/hello.brp \
        examples/welcome.brp \
        examples/vector_bounds.brp \
        examples/matrix_bounds.brp \
        examples/tensor_bounds.brp \
        examples/square_roots.brp \
        examples/debug_printing.brp
    do
        run_cmd bin/blorp run --timeout "$example_timeout" --no-format "$example"
    done
}

run_sanitizer_gate() {
    if [ "$run_sanitize" -eq 0 ]; then
        mark_step_skipped "Skipping sanitizer gate."
        return 0
    fi
    run_cmd make test-asan
}

run_docker_gate() {
    local args
    if [ "$run_docker" = "0" ]; then
        mark_step_skipped "Skipping Docker gate."
        return 0
    fi

    args=(scripts/docker-gate --platform "$docker_platform")
    if [ "$docker_clean" -eq 1 ]; then
        args+=(--clean)
    fi

    if [ "$dry_run" -eq 1 ]; then
        run_cmd "${args[@]}"
        return 0
    fi

    if ! command -v docker >/dev/null 2>&1; then
        if [ "$run_docker" = "require" ]; then
            echo "Docker is required but was not found in PATH." >&2
            return 1
        fi
        mark_step_skipped "Docker not found; skipping Docker gate. Use --require-docker to make this a hard failure."
        return 0
    fi

    if ! docker info >/dev/null 2>&1; then
        if [ "$run_docker" = "require" ]; then
            echo "Docker is required but the Docker daemon is unavailable." >&2
            return 1
        fi
        mark_step_skipped "Docker daemon unavailable; skipping Docker gate. Use --require-docker to make this a hard failure."
        return 0
    fi

    run_cmd "${args[@]}"
}

run_security_scan() {
    local matches
    local status
    local secret_patterns
    local grep_args
    if [ "$run_security" -eq 0 ]; then
        mark_step_skipped "Skipping security scan."
        return 0
    fi

    secret_patterns='AKIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9_]{36,255}|sk-[A-Za-z0-9]{20,}|xox[baprs]-[A-Za-z0-9-]{20,}|sk_live_[A-Za-z0-9]{20,}|-----BEGIN ((RSA|DSA|EC|OPENSSH|PGP) )?PRIVATE KEY-----'
    grep_args=(
        git grep -nI -E "$secret_patterns" --
        .
        ':(exclude)blorp/build/_build'
        ':(exclude)_build'
        ':(exclude).git'
    )

    # Absolute paths into a user's home or per-user temp directory name the
    # machine's user and its layout. Records and scripts spell them as
    # <repo>, <worktree:NAME>, $TMPDIR or ~ instead. The scan covers tracked
    # files and is deliberately narrow: shared temp paths such as /tmp name
    # no user.
    local local_path_patterns='/User[s]/[A-Za-z0-9_][A-Za-z0-9._-]*/|/hom[e]/[A-Za-z0-9_][A-Za-z0-9._-]*/|/var/folder[s]/'
    local path_grep_args=(
        git grep -nI -E "$local_path_patterns" --
        .
        ':(exclude)blorp/build/_build'
        ':(exclude)_build'
        ':(exclude).git'
    )

    if [ "$dry_run" -eq 1 ]; then
        run_cmd "${grep_args[@]}"
        run_cmd "${path_grep_args[@]}"
        return 0
    fi

    set +e
    matches=$("${grep_args[@]}" 2>&1)
    status=$?
    set -e

    if [ "$status" -gt 1 ]; then
        echo "Security scan failed:" >&2
        echo "$matches" >&2
        return "$status"
    fi

    if [ "$status" -eq 1 ]; then
        matches=""
    fi

    if [ -n "$matches" ]; then
        echo "Potential secret material found:" >&2
        echo "$matches" >&2
        return 1
    fi

    echo "No high-confidence secret patterns found."

    set +e
    matches=$("${path_grep_args[@]}" 2>&1)
    status=$?
    set -e

    if [ "$status" -gt 1 ]; then
        echo "Local path scan failed:" >&2
        echo "$matches" >&2
        return "$status"
    fi

    if [ "$status" -eq 0 ]; then
        echo "Machine-local paths found in tracked files; write <repo>, <worktree:NAME>, \$TMPDIR or ~ instead:" >&2
        # A match in a single-line JSON record can be very long.
        echo "$matches" | cut -c1-200 >&2
        return 1
    fi

    echo "No machine-local paths found."
}

run_drift_checks() {
    run_cmd git diff --check
    run_cmd git diff --check --cached
    if [ "$gate_scope" = "docs-only" ]; then
        # Skipping the build leaves out make tooling-check, which needs one.
        run_cmd make hygiene-check
        run_cmd make artifact-scan
    elif [ "$run_quality" -eq 0 ]; then
        run_cmd make hygiene-check
        run_cmd make tooling-check
        run_cmd make artifact-scan
    fi

}

# The scope decides which steps run; see scripts/gate-scope for the rules.
gate_scope=""
benchmark_tooling=""
scope_summary=""
scope_args=()
[ "$force_full" -eq 0 ] || scope_args+=(--full)
scope_output=$(scripts/gate-scope ${scope_args[@]+"${scope_args[@]}"})
while IFS='=' read -r scope_key scope_value; do
    case "$scope_key" in
        scope) gate_scope="$scope_value" ;;
        benchmark_tooling) benchmark_tooling="$scope_value" ;;
        summary) scope_summary="$scope_value" ;;
    esac
done <<<"$scope_output"
case "$gate_scope:$benchmark_tooling" in
    docs-only:skip|full:run|full:skip) ;;
    *)
        echo "scripts/gate-scope printed an unexpected scope: $scope_output" >&2
        exit 1
        ;;
esac
echo "Change scope: $scope_summary"
[ "$gate_scope" != "docs-only" ] || test_verdict_expected=0

# Runs `<runner> <name> <function>` unless the change is documentation only.
code_step() {
    if [ "$gate_scope" = "docs-only" ]; then
        skip_step_fn "$2" "Skipping: documentation-only change."
    else
        "$@"
    fi
}

run_step_fn "Preflight" fail_if_unmerged
code_step run_step_fn "Build" run_clean_build
code_step run_step_fn "Quality" run_quality_gate
if [ "$benchmark_tooling" = "run" ]; then
    code_step run_step_fn "Benchmark tooling" run_benchmark_tooling_gate
else
    skip_step_fn "Benchmark tooling" "Skipping: no input of the benchmark tooling suites changed."
fi
code_step run_step_fn "Tests" run_test_suites
code_step run_step_fn "Codegen audit" run_codegen_audit
if [ "$run_preview_smoke" -eq 1 ]; then
    code_step run_non_mutating_step_fn "Preview smoke" run_preview_smoke_gate
else
    # Decided here: the step function runs its body in a subshell, where a
    # skip could not be recorded.
    skip_step_fn "Preview smoke" "Skipping preview smoke."
fi
code_step run_step_fn "Example checks" run_example_checks
code_step run_step_fn "Example smoke runs" run_example_smokes
code_step run_step_fn "Sanitizers" run_sanitizer_gate
code_step run_step_fn "Docker" run_docker_gate
run_step_fn "Security scan" run_security_scan
run_step_fn "Drift and hygiene" run_drift_checks

echo ""
echo "Premerge gate completed in $(elapsed_since "$gate_start")."

gate_finished=1
