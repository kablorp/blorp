#!/bin/bash
set -euo pipefail

script_dir="$(cd "$(dirname "$0")" && pwd -P)"
if [ "${BLORP_TEST_LOCK_HELD:-0}" != "1" ]; then
    export BLORP_TEST_LOCK_HELD=1
    exec "$script_dir/with-build-lock" "$script_dir/premerge-gate" "$@"
fi

cd "$script_dir/.."

clean_build=1
run_quality=1
run_sanitize=1
run_docker="auto"
docker_clean=0
docker_platform="linux/amd64"
check_examples=1
run_examples=1
run_preview_smoke=1
run_security=1
release_compiler=1
dry_run=0
test_timeout="${BLORP_TEST_TIMEOUT:-30}"
runtime_test_timeout="${BLORP_RUNTIME_TEST_TIMEOUT:-${BLORP_TEST_TIMEOUT:-60}}"
leak_test_timeout="${BLORP_LEAK_TEST_TIMEOUT:-${BLORP_TEST_TIMEOUT:-60}}"
compiler_test_timeout="${BLORP_COMPILER_TEST_TIMEOUT:-360}"
example_timeout=10

# scripts/test's own BLORP_GATE_RESULT line (from run_test_suites, below) is
# captured here so this script can print one aggregate verdict line of its
# own as the last line of stdout, however the script exits.
PREMERGE_TEST_LOG=$(mktemp "${TMPDIR:-/tmp}/blorp-premerge-test.XXXXXX")

premerge_gate_verdict() {
    local exit_code=$?
    local total_passed=0 total_failed=0 total_tests=0 overall="PASS"
    local line status
    line=$(grep '^BLORP_GATE_RESULT gate=' "$PREMERGE_TEST_LOG" 2>/dev/null | tail -1 || true)
    rm -f "$PREMERGE_TEST_LOG"
    if [ -n "$line" ]; then
        status=$(printf '%s\n' "$line" | sed -n 's/.*status=\([A-Z]*\).*/\1/p')
        total_passed=$(printf '%s\n' "$line" | sed -n 's/.*passed=\([0-9]*\).*/\1/p')
        total_failed=$(printf '%s\n' "$line" | sed -n 's/.*failed=\([0-9]*\).*/\1/p')
        total_tests=$(printf '%s\n' "$line" | sed -n 's/.*tests=\([0-9]*\).*/\1/p')
        [ "$status" = "FAIL" ] && overall="FAIL"
    fi
    if [ "$exit_code" -ne 0 ]; then
        overall="FAIL"
    fi
    printf 'BLORP_GATE_RESULT gate=premerge-gate status=%s passed=%s failed=%s tests=%s\n' \
        "$overall" "${total_passed:-0}" "${total_failed:-0}" "${total_tests:-0}"
    exit "$exit_code"
}
trap premerge_gate_verdict EXIT

usage() {
    cat <<'EOF'
Usage: scripts/premerge-gate [options]

Run the local pre-merge validation gate. This composes the existing build,
quality, test, example, sanitizer, Docker, and lightweight security checks.

Defaults:
  - clean build at -O2 (BLORP_CLI_C_OPTIMIZATION=-O2)
  - make quality
  - scripts/test --serial --release-compiler
  - focused preview CLI/runtime smoke
  - check all examples/
  - run curated fast examples
  - make test-asan
  - run Docker gate if Docker is available
  - run lightweight secret-pattern scan

Options:
  --quick              Skip clean build, sanitizer, Docker, and example runs.
  --no-clean           Do not run make clean before make.
  --no-quality         Skip make quality.
  --no-sanitize        Skip make test-asan.
  --no-docker          Skip Docker validation.
  --require-docker     Fail if Docker is unavailable.
  --docker-clean       Use scripts/docker-gate --clean.
  --docker-platform P  Docker platform (default: linux/amd64).
  --no-examples-check  Skip bin/blorp check examples/.
  --no-examples-run    Skip running curated examples.
  --no-preview-smoke   Skip focused preview CLI/runtime smoke.
  --no-security        Skip lightweight security scan.
  --no-release-compiler  Build/test with the default -O0 compiler instead of -O2.
  --timeout N          Test timeout in seconds (runtime uses this unless BLORP_RUNTIME_TEST_TIMEOUT is set).
  --example-timeout N  Example run timeout in seconds (default: 10).
  --dry-run            Print commands without running them.
  -h, --help           Show this help.

Examples:
  scripts/premerge-gate
  scripts/premerge-gate --quick
  scripts/premerge-gate --no-docker --no-sanitize
  scripts/premerge-gate --require-docker --docker-clean
EOF
}

while [ $# -gt 0 ]; do
    case "$1" in
        --quick)
            clean_build=0
            run_sanitize=0
            run_docker=0
            run_examples=0
            run_preview_smoke=0
            shift
            ;;
        --no-clean)
            clean_build=0
            shift
            ;;
        --no-quality)
            run_quality=0
            shift
            ;;
        --no-sanitize)
            run_sanitize=0
            shift
            ;;
        --no-docker)
            run_docker=0
            shift
            ;;
        --require-docker)
            run_docker="require"
            shift
            ;;
        --docker-clean)
            docker_clean=1
            shift
            ;;
        --docker-platform)
            docker_platform="$2"
            shift 2
            ;;
        --no-examples-check)
            check_examples=0
            shift
            ;;
        --no-examples-run)
            run_examples=0
            shift
            ;;
        --no-preview-smoke)
            run_preview_smoke=0
            shift
            ;;
        --no-security)
            run_security=0
            shift
            ;;
        --no-release-compiler)
            release_compiler=0
            shift
            ;;
        --timeout)
            test_timeout="$2"
            if [ -z "${BLORP_RUNTIME_TEST_TIMEOUT:-}" ]; then
                runtime_test_timeout="$2"
            fi
            if [ -z "${BLORP_LEAK_TEST_TIMEOUT:-}" ]; then
                leak_test_timeout="$2"
            fi
            shift 2
            ;;
        --example-timeout)
            example_timeout="$2"
            shift 2
            ;;
        --dry-run)
            dry_run=1
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "Unknown option: $1" >&2
            usage >&2
            exit 1
            ;;
    esac
done

if [ "$release_compiler" -eq 1 ]; then
    export BLORP_CLI_C_OPTIMIZATION=-O2
fi

step_count=0
gate_start=$(date +%s)

print_header() {
    step_count=$((step_count + 1))
    echo ""
    echo "[$step_count] $1"
    echo "----------------------------------------"
}

elapsed_since() {
    local started="$1"
    local now
    now=$(date +%s)
    echo "$((now - started))s"
}

quote_cmd() {
    local part
    for part in "$@"; do
        printf "%q " "$part"
    done
}

run_cmd() {
    printf '+ '
    quote_cmd "$@"
    echo ""
    if [ "$dry_run" -eq 1 ]; then
        return 0
    fi
    "$@"
}

run_step_fn() {
    local name="$1"
    shift
    local started
    print_header "$name"
    started=$(date +%s)
    "$@"
    echo "Completed in $(elapsed_since "$started")."
}

snapshot_git_state() {
    local output_file="$1"
    {
        git status --porcelain=v1 --untracked-files=all
        printf '\n-- tracked diff --\n'
        git diff --binary --no-ext-diff
        printf '\n-- staged diff --\n'
        git diff --cached --binary --no-ext-diff
    } > "$output_file"
}

run_non_mutating_step_fn() {
    local name="$1"
    shift
    local started before after status snapshot_status changed
    print_header "$name"
    started=$(date +%s)

    if [ "$dry_run" -eq 1 ]; then
        "$@"
        echo "Completed in $(elapsed_since "$started")."
        return 0
    fi

    before=$(mktemp "${TMPDIR:-/tmp}/blorp-premerge-before.XXXXXX") || return 1
    after=$(mktemp "${TMPDIR:-/tmp}/blorp-premerge-after.XXXXXX") || {
        rm -f "$before"
        return 1
    }

    if ! snapshot_git_state "$before"; then
        rm -f "$before" "$after"
        return 1
    fi

    set +e
    (
        set -euo pipefail
        "$@"
    )
    status=$?
    snapshot_git_state "$after"
    snapshot_status=$?
    set -e

    if [ "$snapshot_status" -ne 0 ]; then
        rm -f "$before" "$after"
        return "$snapshot_status"
    fi

    changed=0
    if ! cmp -s "$before" "$after"; then
        echo "$name changed the working tree; premerge validation must be non-mutating." >&2
        echo "Current git status:" >&2
        git status --short >&2
        echo "Run git diff to inspect the mutation." >&2
        changed=1
    fi

    rm -f "$before" "$after"

    if [ "$status" -ne 0 ]; then
        return "$status"
    fi

    if [ "$changed" -ne 0 ]; then
        return 1
    fi

    echo "Completed in $(elapsed_since "$started")."
}

fail_if_unmerged() {
    local unmerged
    unmerged=$(git diff --name-only --diff-filter=U)
    if [ -n "$unmerged" ]; then
        echo "Unmerged files remain:" >&2
        echo "$unmerged" >&2
        return 1
    fi
}

run_clean_build() {
    if [ "$clean_build" -eq 1 ]; then
        run_cmd make clean
    fi
    run_cmd make
}

run_quality_gate() {
    if [ "$run_quality" -eq 0 ]; then
        echo "Skipping quality gate."
        return 0
    fi
    run_cmd make quality
}

run_test_suites() {
    local test_flags=(--serial)
    if [ "$release_compiler" -eq 1 ]; then
        test_flags+=(--release-compiler)
    fi
    local cmd=(
        env "BLORP_TEST_TIMEOUT=$test_timeout" \
        "BLORP_RUNTIME_TEST_TIMEOUT=$runtime_test_timeout" \
        "BLORP_LEAK_TEST_TIMEOUT=$leak_test_timeout" \
        "BLORP_COMPILER_TEST_TIMEOUT=$compiler_test_timeout" scripts/test "${test_flags[@]}" \
        compiler-blorp compiler-tools std-check runtime leak doctest cli-deep lsp
    )
    printf '+ '
    quote_cmd "${cmd[@]}"
    echo ""
    if [ "$dry_run" -eq 1 ]; then
        return 0
    fi
    "${cmd[@]}" | tee "$PREMERGE_TEST_LOG"
}

run_codegen_audit() {
    run_cmd blorp/test/compiler/pipeline/codegen_audit/run_codegen_audit.sh bin/blorp
}

run_preview_lsp_smoke() {
    local output_file="$1"
    printf '+ bin/blorp lsp < /dev/null > %q\n' "$output_file"
    if [ "$dry_run" -eq 1 ]; then
        return 0
    fi
    bin/blorp lsp < /dev/null > "$output_file"
}

run_preview_smoke_gate() {
    local tmpdir smoke tmpc lsp_out
    if [ "$run_preview_smoke" -eq 0 ]; then
        echo "Skipping preview smoke."
        return 0
    fi

    tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/blorp-preview.XXXXXX")
    (
        set -euo pipefail
        trap 'rm -rf "$tmpdir"' EXIT

        smoke="$tmpdir/preview.brp"
        tmpc="$tmpdir/preview.c"
        lsp_out="$tmpdir/lsp.out"

        cat > "$smoke" <<'BRP'
func main(args: List[String]) -> Int:
	print("preview smoke")
	0
BRP

        run_cmd bin/blorp check --no-format "$smoke"
        run_cmd bin/blorp compile --no-format -o "$tmpc" "$smoke"
        run_cmd bin/blorp run --timeout 5 --no-format "$smoke"
        run_cmd bin/blorp test --timeout 5 blorp/test/runtime/types/test_bool.brp
        run_cmd bin/blorp test --warmup-only
        run_cmd bin/blorp test --leak-check --suite --timeout 5 \
            blorp/test/runtime/memory/leak_check_baselines/empty_main.brp

        if [ "$run_sanitize" -eq 1 ]; then
            run_cmd bin/blorp test --sanitize --timeout 5 blorp/test/runtime/types/test_bool.brp
        else
            echo "Skipping preview sanitizer smoke."
        fi

        run_preview_lsp_smoke "$lsp_out"
        run_cmd env BLORP_TIMEOUT=5 bin/blorp test blorp/test/runtime/types/test_bool.brp
        run_cmd env BLORP_STD=standard_library/src BLORP_NO_FORMAT=1 bin/blorp check \
            blorp/test/runtime/types/test_bool.brp

        if [ "$run_sanitize" -eq 1 ]; then
            run_cmd env BLORP_SANITIZE=1 bin/blorp test --timeout 5 \
                blorp/test/runtime/types/test_bool.brp
        fi
    )
}

run_example_checks() {
    if [ "$check_examples" -eq 0 ]; then
        echo "Skipping example checks."
        return 0
    fi
    run_cmd bin/blorp check --no-format examples/
}

run_example_smokes() {
    local example
    if [ "$run_examples" -eq 0 ]; then
        echo "Skipping example runs."
        return 0
    fi

    for example in \
        examples/hello.brp \
        examples/welcome.brp \
        examples/vector_bounds.brp \
        examples/matrix_bounds.brp \
        examples/tensor_bounds.brp \
        examples/square_roots.brp \
        examples/debug.brp
    do
        run_cmd bin/blorp run --timeout "$example_timeout" --no-format "$example"
    done
}

run_sanitizer_gate() {
    if [ "$run_sanitize" -eq 0 ]; then
        echo "Skipping sanitizer gate."
        return 0
    fi
    run_cmd make test-asan
}

run_docker_gate() {
    local args
    if [ "$run_docker" = "0" ]; then
        echo "Skipping Docker gate."
        return 0
    fi

    args=(scripts/docker-gate --platform "$docker_platform")
    if [ "$docker_clean" -eq 1 ]; then
        args+=(--clean)
    fi

    if [ "$dry_run" -eq 1 ]; then
        run_cmd "${args[@]}"
        return 0
    fi

    if ! command -v docker >/dev/null 2>&1; then
        if [ "$run_docker" = "require" ]; then
            echo "Docker is required but was not found in PATH." >&2
            return 1
        fi
        echo "Docker not found; skipping Docker gate. Use --require-docker to make this a hard failure."
        return 0
    fi

    if ! docker info >/dev/null 2>&1; then
        if [ "$run_docker" = "require" ]; then
            echo "Docker is required but the Docker daemon is unavailable." >&2
            return 1
        fi
        echo "Docker daemon unavailable; skipping Docker gate. Use --require-docker to make this a hard failure."
        return 0
    fi

    run_cmd "${args[@]}"
}

run_security_scan() {
    local matches
    local status
    local secret_patterns
    local grep_args
    if [ "$run_security" -eq 0 ]; then
        echo "Skipping security scan."
        return 0
    fi

    secret_patterns='AKIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9_]{36,255}|sk-[A-Za-z0-9]{20,}|xox[baprs]-[A-Za-z0-9-]{20,}|sk_live_[A-Za-z0-9]{20,}|-----BEGIN ((RSA|DSA|EC|OPENSSH|PGP) )?PRIVATE KEY-----'
    grep_args=(
        git grep -nI -E "$secret_patterns" --
        .
        ':(exclude)blorp/build/_build'
        ':(exclude)_build'
        ':(exclude).git'
    )

    if [ "$dry_run" -eq 1 ]; then
        run_cmd "${grep_args[@]}"
        return 0
    fi

    set +e
    matches=$("${grep_args[@]}" 2>&1)
    status=$?
    set -e

    if [ "$status" -gt 1 ]; then
        echo "Security scan failed:" >&2
        echo "$matches" >&2
        return "$status"
    fi

    if [ "$status" -eq 1 ]; then
        matches=""
    fi

    if [ -n "$matches" ]; then
        echo "Potential secret material found:" >&2
        echo "$matches" >&2
        return 1
    fi

    echo "No high-confidence secret patterns found."
}

run_drift_checks() {
    run_cmd git diff --check
    run_cmd git diff --check --cached
    if [ "$run_quality" -eq 0 ]; then
        run_cmd make hygiene-check
    fi

}

run_step_fn "Preflight" fail_if_unmerged
run_step_fn "Build" run_clean_build
run_step_fn "Quality" run_quality_gate
run_step_fn "Tests" run_test_suites
run_step_fn "Codegen audit" run_codegen_audit
run_non_mutating_step_fn "Preview smoke" run_preview_smoke_gate
run_step_fn "Example checks" run_example_checks
run_step_fn "Example smoke runs" run_example_smokes
run_step_fn "Sanitizers" run_sanitizer_gate
run_step_fn "Docker" run_docker_gate
run_step_fn "Security scan" run_security_scan
run_step_fn "Drift and hygiene" run_drift_checks

echo ""
echo "Premerge gate passed in $(elapsed_since "$gate_start")."
