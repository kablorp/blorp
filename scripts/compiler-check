#!/usr/bin/env python3
"""Plan focused Blorp source checks from explicit, checked-in ownership data."""

from __future__ import annotations

import argparse
from dataclasses import dataclass
from datetime import datetime, timezone
from enum import Enum
from fnmatch import fnmatchcase
import json
import os
from pathlib import Path, PurePosixPath
import platform
import posixpath
import re
import shlex
import shutil
import subprocess
import sys
import time
from typing import Any, Iterable


MANIFEST_PATH = Path("blorp/test/test_compiler/compiler_test_ownership.json")
PRODUCTION_SOURCE_DIRECTORY = Path("blorp/src")
COMPILER_TEST_DIRECTORY = Path("blorp/test")
PRODUCTION_COMPOSITION_ROOTS = (Path("blorp/src/main.brp"),)
SUPPORTED_SCHEMA_VERSION = 1
DEFAULT_SUITE_TIMEOUT_SECONDS = "180"
TEST_SUITE_DECLARATION = re.compile(r"^\s*tests\s*:\s*TestSuite\s*=", re.MULTILINE)
FIXTURE_DIRECTORY_NAMES = {"fixture", "fixtures", "should_pass", "should_fail", "golden", "testdata"}
# Runtime TestSuites are selected by the runtime/leak/sanitizer gates rather
# than by compiler source ownership. Keep their inventory out of this focused
# compiler manifest without misclassifying them as fixture inputs.
BROAD_GATE_SUITE_OWNER_DIRECTORIES = {"test_runtime"}
# Source owners with their own test manifest and gate, outside this manifest:
# the rewritten compiler stages. The discovery stage's lexer and table parser are
# linked into bin/blorp (the front end runs them), so a change there is not
# covered by this manifest's focused checks; `hand_back_for` says which gates a
# change set needs instead. Their
# sources live under blorp/src/<owner> and their suites under
# blorp/test/test_<owner>.
SEPARATELY_GATED_OWNERS = {"compiler_new": "scripts/test compiler-new"}
SEPARATELY_GATED_TEST_OWNERS = {"test_compiler_new": "compiler_new"}


def separately_gated_owner(path: str) -> str | None:
    parts = Path(path).parts
    if len(parts) > 2 and parts[0] == "blorp" and parts[1] in {"src", "test"}:
        owner = (
            parts[2]
            if parts[1] == "src"
            else SEPARATELY_GATED_TEST_OWNERS.get(parts[2])
        )
        if owner in SEPARATELY_GATED_OWNERS:
            return owner
    return None


# --- Hand-back scope ---------------------------------------------------------
#
# Which gates a worker hands back for a change set. The discovery stage's tree
# path (the `tree_*` parse modules and their support under `compiler_new`, and
# the tree projection of the parsed AST in
# `compiler/discovery_tree_projection.brp`) is imported by nothing that is
# compiled into a program, so it is not part of `bin/blorp` or any other tool,
# and a change set confined to it cannot change what they do. The full
# compiler-blorp gate has nothing to say about it. What it needs is the suites
# that import the changed files and the compiler-new gates.
#
# Which modules are tree path is read from the import graph, not listed. A
# module is a candidate only if it lives under `blorp/src/compiler_new/` or is
# the tree projection. Every other `blorp/src` module may be a program's entry
# (`main.brp`, the formatter, the bridge and benchmark roots; no list of them is
# kept, since each is just a module nothing else need import), so a candidate is
# tree path exactly when no module outside the candidates reaches it. A path is
# judged where it is:
#
#   * a candidate module is tree path when nothing outside the candidates
#     reaches it, and production otherwise; any other `blorp/src` module is
#     production;
#   * a `blorp/test/test_compiler_new` file, or a test that imports a tree-path
#     module, is tree path unless it carries the `RUN-BLORP-CHECK` marker, which
#     sends the file through production `bin/blorp check` in compiler-blorp;
#   * documentation and measurement records are inert;
#   * everything else, and everything that cannot be resolved (an import that
#     resolves to no file, a file that is not there), is production.
#
# A tree-path test may import production modules (the projection tests compare
# against the existing parser); a change to the test cannot change production.
# The hand-back runs the suites that import any changed Blorp file.
TREE_PROJECTION_MODULE = "blorp/src/compiler/discovery_tree_projection.brp"
SOURCE_MODULE_ROOT = "blorp/src/"
CANDIDATE_MODULE_ROOT = "blorp/src/compiler_new/"
TEST_ROOT = "blorp/test/"
COMPILER_NEW_TEST_ROOT = "blorp/test/test_compiler_new/"
BLORP_SOURCE_SUFFIX = ".brp"
STANDARD_LIBRARY_ROOT = "standard_library/src/"
# Fixtures marked with this line run through production `bin/blorp check` in
# compiler-blorp (`blorp/test/test_lib/run_blorp_check_fixtures.py`).
CHECKED_FIXTURE_MARKER = "-- RUN-BLORP-CHECK"
# Not Blorp, so not in the import graph: the parity script and its test.
PARITY_SCRIPT_TESTS = "blorp/test/test_build/test_compiler_new_parity.py"
TREE_PATH_TOOLING = ("scripts/compiler-new-parity", PARITY_SCRIPT_TESTS)
# Documentation and measurement records: no gate reads them, so they neither
# join a tree-path change set nor widen it. `scripts/gate-scope` keeps its own
# `DOCUMENTATION_PATH_RULES` for the same notion; sharing one definition is a
# follow-up (this script is copied alone into the test repositories).
INERT_PATTERNS = ("docs/*", "benchmarks/results/*", "*.md")
HAND_BACK_LISTED_PATH_LIMIT = 10
TREE_PATH_GATES = ("compiler-new", "compiler-new-parity")
BROAD_GATES = (*TREE_PATH_GATES, "compiler-blorp")


class PathScope(Enum):
    INERT = "inert"
    TREE_PATH = "tree path"
    PRODUCTION = "production"


@dataclass(frozen=True)
class SourceImports:
    """What a Blorp file imports: the files its imports resolve to, and the
    spellings that resolve to no file (what they name is unknown, never assumed
    safe)."""

    targets: tuple[str, ...]
    unresolved: tuple[str, ...]

    @property
    def complete(self) -> bool:
        return not self.unresolved


def _module_imports(text: str) -> list[str]:
    """The module spellings of a Blorp file's `import:` block."""
    block = re.search(r"^import:\n((?:(?:\t.*)?\n)*)", text, re.MULTILINE)
    if block is None:
        return []
    spellings = []
    for line in block.group(1).splitlines():
        header = re.match(r"\t(\S+?)(?: as \w+)?(?::.*)?$", line)
        if header is not None and not line.startswith("\t\t"):
            spellings.append(header.group(1))
    return spellings


class ImportGraph:
    """The import graph of the checkout's Blorp files, read on demand."""

    def __init__(self, root: Path) -> None:
        self.root = root
        self._imports: dict[str, SourceImports | None] = {}

    def imports(self, path: str) -> SourceImports | None:
        """The imports of `path`, or `None` when it is not a readable file."""
        if path not in self._imports:
            self._imports[path] = self._read_imports(path)
        return self._imports[path]

    def _read_imports(self, path: str) -> SourceImports | None:
        file = self.root / path
        if not path.endswith(BLORP_SOURCE_SUFFIX) or not file.is_file():
            return None
        targets: list[str] = []
        unresolved: list[str] = []
        for spelling in _module_imports(file.read_text(encoding="utf-8")):
            beside = posixpath.normpath(
                posixpath.join(posixpath.dirname(path), spelling + BLORP_SOURCE_SUFFIX)
            )
            library = f"{STANDARD_LIBRARY_ROOT}{spelling}{BLORP_SOURCE_SUFFIX}"
            for candidate in (beside, library):
                if (self.root / candidate).is_file():
                    targets.append(candidate)
                    break
            else:
                unresolved.append(spelling)
        return SourceImports(tuple(targets), tuple(unresolved))

    def reachable_from(self, starts: list[str]) -> set[str]:
        """Every Blorp file `starts` name, and every file they import, directly
        or not. A start that is not a Blorp file is left out."""
        seen = {start for start in starts if self.imports(start) is not None}
        pending = list(seen)
        while pending:
            imported = self.imports(pending.pop())
            for target in imported.targets if imported else ():
                if target not in seen:
                    seen.add(target)
                    pending.append(target)
        return seen

    def importers_of(self, modules: set[str]) -> set[str]:
        """The Blorp files under `blorp/` that import any of `modules`,
        transitively."""
        reverse: dict[str, set[str]] = {}
        for file in sorted((self.root / "blorp").rglob(f"*{BLORP_SOURCE_SUFFIX}")):
            path = file.relative_to(self.root).as_posix()
            imported = self.imports(path)
            for target in imported.targets if imported else ():
                reverse.setdefault(target, set()).add(path)
        seen: set[str] = set()
        pending = list(modules)
        while pending:
            for importer in reverse.get(pending.pop(), ()):
                if importer not in seen:
                    seen.add(importer)
                    pending.append(importer)
        return seen


def is_candidate_module(path: str) -> bool:
    return path.startswith(CANDIDATE_MODULE_ROOT) or path == TREE_PROJECTION_MODULE


class PathClassifier:
    """The scope of a changed path, judged on the checkout's import graph."""

    def __init__(self, root: Path) -> None:
        self.root = root
        self.graph = ImportGraph(root)
        self.production_modules = self._reached_outside_candidates()

    def unprovable_reason(self, changed_paths: Iterable[str]) -> str | None:
        """Why the tree path cannot be told from production here, or `None`: the
        first import under a program (or in a changed file) that resolves to no
        file. The usual cause is a checkout that has not run `make`, which writes
        the generated modules."""
        files = sorted(self.graph.reachable_from(self._program_files())) if self.production_modules is None else []
        for path in [*files, *sorted(changed_paths)]:
            imported = self.graph.imports(path)
            if imported is not None and imported.unresolved:
                return (
                    f"tree path not provable: {path} imports {imported.unresolved[0]}, "
                    "which does not resolve; run make"
                )
        return None

    def _program_files(self) -> list[str]:
        """The `blorp/src` modules outside the candidates: any may be a program's
        entry."""
        paths = (
            file.relative_to(self.root).as_posix()
            for file in sorted((self.root / SOURCE_MODULE_ROOT).rglob(f"*{BLORP_SOURCE_SUFFIX}"))
        )
        return [path for path in paths if not is_candidate_module(path)]

    def _reached_outside_candidates(self) -> set[str] | None:
        """Everything the non-candidate `blorp/src` modules reach, and those
        modules; `None` when an import under them does not resolve (a generated
        module not built yet, say), since what they reach is then unknown."""
        reached = self.graph.reachable_from(self._program_files())
        if not all(self.graph.imports(path).complete for path in reached):
            return None
        return reached

    def scope(self, path: str) -> PathScope:
        if any(fnmatchcase(path, pattern) for pattern in INERT_PATTERNS):
            return PathScope.INERT
        if path in TREE_PATH_TOOLING:
            return PathScope.TREE_PATH
        if path.startswith(COMPILER_NEW_TEST_ROOT) and not path.endswith(BLORP_SOURCE_SUFFIX):
            # The suite manifest and other data nothing but the compiler-new gate reads.
            return PathScope.TREE_PATH
        imported = self.graph.imports(path)
        if imported is None or not imported.complete or self.production_modules is None:
            return PathScope.PRODUCTION
        if path.startswith(SOURCE_MODULE_ROOT):
            return PathScope.TREE_PATH if self.is_tree_path_module(path) else PathScope.PRODUCTION
        if path.startswith(TEST_ROOT) and self._is_tree_path_test(path, imported):
            return PathScope.TREE_PATH
        return PathScope.PRODUCTION

    def _is_tree_path_test(self, path: str, imported: SourceImports) -> bool:
        if CHECKED_FIXTURE_MARKER in (self.root / path).read_text(encoding="utf-8"):
            return False
        return path.startswith(COMPILER_NEW_TEST_ROOT) or any(
            self.is_tree_path_module(target) for target in imported.targets
        )

    def is_tree_path_module(self, path: str) -> bool:
        return (
            is_candidate_module(path)
            and self.production_modules is not None
            and path not in self.production_modules
        )


@dataclass(frozen=True)
class NoHandBack:
    """The change set is not about the discovery stage; the manifest's selection
    is the whole answer."""


@dataclass(frozen=True)
class TreePathOnly:
    """Every changed path is on the tree path (or inert)."""

    tree_paths: tuple[str, ...]
    commands: tuple[str, ...]


@dataclass(frozen=True)
class BroadHandBack:
    """The change set touches the discovery stage and something production
    executes, or something that cannot be proven otherwise."""

    tree_paths: tuple[str, ...]
    production_paths: tuple[str, ...]
    commands: tuple[str, ...]
    # Why the tree path could not be proven, when that is why this is broad.
    unprovable: str | None = None


HandBack = NoHandBack | TreePathOnly | BroadHandBack


def hand_back_for(root: Path, manifest: "Manifest", changed_paths: Iterable[str]) -> HandBack:
    """The gates to hand back for `changed_paths`."""
    classifier = PathClassifier(root)
    scoped = {path: classifier.scope(path) for path in sorted(set(changed_paths))}
    tree_paths = tuple(path for path, scope in scoped.items() if scope is PathScope.TREE_PATH)
    production_paths = tuple(
        path for path, scope in scoped.items() if scope is PathScope.PRODUCTION
    )
    if not tree_paths and not any(separately_gated_owner(path) for path in production_paths):
        return NoHandBack()
    if production_paths:
        return BroadHandBack(
            tree_paths,
            production_paths,
            (shlex.join(["scripts/test", *BROAD_GATES]),),
            classifier.unprovable_reason(scoped),
        )
    return TreePathOnly(tree_paths, tuple(_tree_path_commands(manifest, classifier, tree_paths)))


def _tree_path_commands(
    manifest: "Manifest", classifier: PathClassifier, tree_paths: tuple[str, ...]
) -> list[str]:
    """The suites that run the changed files, then the compiler-new gates: the
    registered suites among the changed paths, those of the manifest-owned
    changed modules, and every registered suite that imports a changed Blorp
    file, directly or not."""
    owned = [path for path in tree_paths if path in manifest.modules]
    selection = _selection_for_modules(manifest, owned)
    suites = {suite.identifier: suite for suite in selection.suites}
    blorp_files = {
        path for path in tree_paths if classifier.graph.imports(path) is not None
    }
    for path in blorp_files | classifier.graph.importers_of(blorp_files):
        if (suite := manifest.suites_by_path.get(path)) is not None:
            suites[suite.identifier] = suite
    focused = Selection(
        selection.sources,
        tuple(sorted(suites.values(), key=lambda item: item.path)),
        selection.checks,
    )
    commands = [shlex.join(command) for command in _focused_action_commands(focused)]
    # The parity script and its tests are Python: their own tests run directly.
    if any(path in TREE_PATH_TOOLING for path in tree_paths):
        commands.append(shlex.join(["python3", "-m", "unittest", PARITY_SCRIPT_TESTS]))
    commands.append(shlex.join(["scripts/test", "--no-build", *TREE_PATH_GATES]))
    return commands


class ManifestError(Exception):
    def __init__(self, errors: list[str]):
        super().__init__("\n".join(errors))
        self.errors = errors


@dataclass(frozen=True)
class Suite:
    identifier: str
    path: str
    broad_only: bool


@dataclass(frozen=True)
class Check:
    identifier: str
    path: str
    command: tuple[str, ...] | None
    gate: str | None


@dataclass(frozen=True)
class BroadGate:
    identifier: str
    path: str
    gate: str


@dataclass(frozen=True)
class ModuleOwnership:
    path: str
    stage: str
    suites: tuple[str, ...]
    checks: tuple[str, ...]
    broad_gate: str


@dataclass(frozen=True)
class Manifest:
    stages: tuple[str, ...]
    suites: dict[str, Suite]
    suites_by_path: dict[str, Suite]
    checks: dict[str, Check]
    broad_gates: dict[str, BroadGate]
    modules: dict[str, ModuleOwnership]


@dataclass(frozen=True)
class Selection:
    sources: tuple[str, ...]
    suites: tuple[Suite, ...]
    checks: tuple[Check, ...]


@dataclass(frozen=True)
class Plan:
    selection: Selection
    changed_tests: tuple[Suite, ...]
    source_label: str


def _reject_duplicate_json_keys(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
    result: dict[str, Any] = {}
    for key, value in pairs:
        if key in result:
            raise ValueError(f"duplicate JSON field {key!r}")
        result[key] = value
    return result


def _unknown_fields(value: dict[str, Any], allowed: set[str], context: str, errors: list[str]) -> None:
    for field in sorted(set(value) - allowed):
        errors.append(f"{context}: unknown field {field!r}")


def _is_nonempty_string(value: Any) -> bool:
    return isinstance(value, str) and bool(value)


def _validate_relative_path(value: Any, context: str, errors: list[str]) -> str | None:
    if not _is_nonempty_string(value):
        errors.append(f"{context}: expected a non-empty repository-relative path")
        return None
    path = PurePosixPath(value)
    if path.is_absolute() or ".." in path.parts or value != path.as_posix():
        errors.append(f"{context}: expected a normalized repository-relative path, got {value!r}")
        return None
    return value


def _validate_string_list(value: Any, context: str, errors: list[str]) -> tuple[str, ...]:
    if not isinstance(value, list):
        errors.append(f"{context}: expected an array")
        return ()
    result: list[str] = []
    for index, item in enumerate(value):
        if not _is_nonempty_string(item):
            errors.append(f"{context}[{index}]: expected a non-empty string")
        else:
            result.append(item)
    return tuple(result)


def _require_object(value: Any, context: str, errors: list[str]) -> dict[str, Any] | None:
    if not isinstance(value, dict):
        errors.append(f"{context}: expected an object")
        return None
    return value


def _require_array(value: Any, context: str, errors: list[str]) -> list[Any]:
    if not isinstance(value, list):
        errors.append(f"{context}: expected an array")
        return []
    return value


def _path_exists(root: Path, relative_path: str | None, kind: str, errors: list[str]) -> None:
    if relative_path is not None and not (root / relative_path).is_file():
        errors.append(f"{kind} path does not exist: {relative_path}")


def load_manifest(root: Path) -> Manifest:
    manifest_path = root / MANIFEST_PATH
    try:
        raw = manifest_path.read_text(encoding="utf-8")
    except OSError as error:
        raise ManifestError([f"cannot read manifest {MANIFEST_PATH}: {error}"]) from error
    try:
        content = json.loads(raw, object_pairs_hook=_reject_duplicate_json_keys)
    except (json.JSONDecodeError, ValueError) as error:
        raise ManifestError([f"malformed JSON in {MANIFEST_PATH}: {error}"]) from error

    errors: list[str] = []
    root_object = _require_object(content, "manifest", errors)
    if root_object is None:
        raise ManifestError(errors)
    _unknown_fields(
        root_object,
        {"schema_version", "stages", "suites", "checks", "broad_gates", "modules"},
        "manifest",
        errors,
    )
    schema_version = root_object.get("schema_version")
    if type(schema_version) is not int or schema_version != SUPPORTED_SCHEMA_VERSION:
        errors.append(
            f"unsupported schema version {schema_version!r}; expected {SUPPORTED_SCHEMA_VERSION}"
        )

    stages = _validate_string_list(root_object.get("stages"), "stages", errors)
    if len(stages) != len(set(stages)):
        errors.append("duplicate stage id")
    stage_ids = set(stages)

    suites: dict[str, Suite] = {}
    suites_by_path: dict[str, Suite] = {}
    for index, item in enumerate(_require_array(root_object.get("suites"), "suites", errors)):
        context = f"suites[{index}]"
        entry = _require_object(item, context, errors)
        if entry is None:
            continue
        _unknown_fields(entry, {"id", "path", "scope"}, context, errors)
        identifier = entry.get("id")
        path = _validate_relative_path(entry.get("path"), f"{context}.path", errors)
        if "scope" in entry and entry["scope"] != "broad-only":
            errors.append(f"{context}.scope: expected 'broad-only'")
        if path is not None and (
            not path.startswith("blorp/test/") or not path.endswith(".brp")
        ):
            errors.append(f"{context}.path: suite must be a blorp/test .brp file")
        if not _is_nonempty_string(identifier):
            errors.append(f"{context}.id: expected a non-empty string")
            continue
        if identifier in suites:
            errors.append(f"duplicate suite id: {identifier}")
        if path is not None and path in suites_by_path:
            errors.append(f"duplicate suite path: {path}")
        _path_exists(root, path, "suite", errors)
        if path is not None and identifier not in suites and path not in suites_by_path:
            suite = Suite(identifier, path, entry.get("scope") == "broad-only")
            suites[identifier] = suite
            suites_by_path[path] = suite

    checks: dict[str, Check] = {}
    for index, item in enumerate(_require_array(root_object.get("checks"), "checks", errors)):
        context = f"checks[{index}]"
        entry = _require_object(item, context, errors)
        if entry is None:
            continue
        _unknown_fields(entry, {"id", "path", "command", "gate"}, context, errors)
        identifier = entry.get("id")
        path = _validate_relative_path(entry.get("path"), f"{context}.path", errors)
        command_value = entry.get("command")
        gate_value = entry.get("gate")
        command = None
        gate = None
        if command_value is not None and gate_value is not None:
            errors.append(f"{context}: command and gate are mutually exclusive")
        elif command_value is not None:
            command = _validate_string_list(command_value, f"{context}.command", errors)
            if not command:
                errors.append(f"{context}.command: expected at least one argument")
        elif _is_nonempty_string(gate_value):
            gate = gate_value
        else:
            errors.append(f"{context}: expected exactly one of command or gate")
        if not _is_nonempty_string(identifier):
            errors.append(f"{context}.id: expected a non-empty string")
            continue
        if identifier in checks:
            errors.append(f"duplicate check id: {identifier}")
        if identifier in suites:
            errors.append(f"duplicate suite/check id: {identifier}")
        if command and path is not None and command[0] != path:
            errors.append(f"{context}.command: first argument must match check path {path!r}")
        _path_exists(root, path, "check", errors)
        if path is not None and identifier not in checks:
            checks[identifier] = Check(identifier, path, command, gate)

    broad_gates: dict[str, BroadGate] = {}
    for index, item in enumerate(
        _require_array(root_object.get("broad_gates"), "broad_gates", errors)
    ):
        context = f"broad_gates[{index}]"
        entry = _require_object(item, context, errors)
        if entry is None:
            continue
        _unknown_fields(entry, {"id", "path", "gate"}, context, errors)
        identifier = entry.get("id")
        path = _validate_relative_path(entry.get("path"), f"{context}.path", errors)
        gate = entry.get("gate")
        if not _is_nonempty_string(identifier):
            errors.append(f"{context}.id: expected a non-empty string")
            continue
        if not _is_nonempty_string(gate):
            errors.append(f"{context}.gate: expected a non-empty string")
            continue
        if identifier in broad_gates:
            errors.append(f"duplicate broad gate id: {identifier}")
        _path_exists(root, path, "broad gate", errors)
        if path is not None and identifier not in broad_gates:
            broad_gates[identifier] = BroadGate(identifier, path, gate)

    modules: dict[str, ModuleOwnership] = {}
    for index, item in enumerate(_require_array(root_object.get("modules"), "modules", errors)):
        context = f"modules[{index}]"
        entry = _require_object(item, context, errors)
        if entry is None:
            continue
        _unknown_fields(
            entry, {"path", "stage", "suites", "checks", "broad_gate"}, context, errors
        )
        path = _validate_relative_path(entry.get("path"), f"{context}.path", errors)
        stage = entry.get("stage")
        focused_suites = _validate_string_list(entry.get("suites"), f"{context}.suites", errors)
        special_checks = _validate_string_list(entry.get("checks"), f"{context}.checks", errors)
        broad_gate = entry.get("broad_gate")
        if path is not None and path in modules:
            errors.append(f"duplicate module path: {path}")
        _path_exists(root, path, "source", errors)
        if not _is_nonempty_string(stage) or stage not in stage_ids:
            errors.append(f"{context}: unknown stage {stage!r}")
        if not focused_suites:
            errors.append(f"{context}: must reference at least one focused suite")
        if len(focused_suites) != len(set(focused_suites)):
            errors.append(f"{context}: duplicate focused suite reference")
        for suite_id in focused_suites:
            if suite_id not in suites:
                errors.append(f"{context}: unknown suite {suite_id!r}")
            elif suites[suite_id].broad_only:
                errors.append(
                    f"{context}: broad-only suite {suite_id!r} is referenced by production module"
                )
        for check_id in special_checks:
            if check_id not in checks:
                errors.append(f"{context}: unknown check {check_id!r}")
        if len(special_checks) != len(set(special_checks)):
            errors.append(f"{context}: duplicate special check reference")
        if not _is_nonempty_string(broad_gate) or broad_gate not in broad_gates:
            errors.append(f"{context}: unknown broad gate {broad_gate!r}")
        if path is not None and path not in modules:
            modules[path] = ModuleOwnership(
                path,
                stage if isinstance(stage, str) else "",
                focused_suites,
                special_checks,
                broad_gate if isinstance(broad_gate, str) else "",
            )

    referenced_suites = {suite_id for module in modules.values() for suite_id in module.suites}
    for suite in suites.values():
        if not suite.broad_only and suite.identifier not in referenced_suites:
            errors.append(
                f"focused suite {suite.identifier!r} is not referenced by any production module"
            )

    production_paths = _git_paths(
        root,
        [
            "ls-files",
            "--cached",
            "--others",
            "--exclude-standard",
            "-z",
            "--",
            PRODUCTION_SOURCE_DIRECTORY.as_posix(),
        ],
    )
    # `git ls-files --cached` includes tracked paths deleted in the worktree.
    # Exclude them so a module deletion and its manifest removal can be
    # validated together before the change is staged or committed.
    production_paths = {
        path
        for path in production_paths
        if path.endswith(".brp")
        and (root / path).is_file()
        and separately_gated_owner(path) is None
    }
    production_paths.update(
        path.as_posix()
        for path in PRODUCTION_COMPOSITION_ROOTS
        if (root / path).is_file()
    )
    for path in sorted(production_paths - set(modules)):
        errors.append(
            f"unowned production Blorp module: {path}; update {MANIFEST_PATH} "
            "and run scripts/compiler-check --validate-manifest"
        )
    for path in sorted(set(modules) - production_paths):
        if (root / path).is_file():
            errors.append(f"module is outside the production Blorp inventory: {path}")

    executable_suite_paths = set()
    for path in (root / COMPILER_TEST_DIRECTORY).rglob("*.brp"):
        relative_path = path.relative_to(root).as_posix()
        test_parts = path.relative_to(root / COMPILER_TEST_DIRECTORY).parts
        if (
            test_parts[0] in BROAD_GATE_SUITE_OWNER_DIRECTORIES
            or separately_gated_owner(relative_path) is not None
            or not TEST_SUITE_DECLARATION.search(path.read_text(encoding="utf-8"))
        ):
            continue
        if FIXTURE_DIRECTORY_NAMES.intersection(test_parts[:-1]):
            errors.append(f"executable Blorp suite in fixture directory: {relative_path}")
        else:
            executable_suite_paths.add(relative_path)
    for path in sorted(executable_suite_paths - set(suites_by_path)):
        errors.append(f"unregistered executable Blorp suite: {path}")

    if errors:
        raise ManifestError(errors)
    return Manifest(stages, suites, suites_by_path, checks, broad_gates, modules)


def _git_paths(root: Path, arguments: list[str]) -> set[str]:
    result = subprocess.run(
        ["git", *arguments], cwd=root, stdout=subprocess.PIPE, stderr=subprocess.PIPE
    )
    if result.returncode != 0:
        message = result.stderr.decode("utf-8", errors="replace").strip()
        raise RuntimeError(f"git {' '.join(arguments)} failed: {message}")
    return {
        path.decode("utf-8", errors="surrogateescape")
        for path in result.stdout.split(b"\0")
        if path
    }


# Every kind of change, and a rename as a delete plus an add: the changed set
# names the path a file left as well as the one it reached. A deleted file is
# in the set, so removing a production file beside a tree-path edit is not a
# tree-path change.
CHANGE_KINDS = "ACDMR"


DIFF_ARGUMENTS = ("diff", "--name-only", "--no-renames", f"--diff-filter={CHANGE_KINDS}", "-z")


def changed_repository_paths(root: Path, base: str | None) -> set[str]:
    changed = set()
    changed.update(_git_paths(root, [*DIFF_ARGUMENTS]))
    changed.update(_git_paths(root, [*DIFF_ARGUMENTS, "--cached"]))
    changed.update(_git_paths(root, ["ls-files", "--others", "--exclude-standard", "-z"]))
    if base is not None:
        merge_base = subprocess.run(
            ["git", "merge-base", base, "HEAD"],
            cwd=root,
            text=True,
            capture_output=True,
        )
        if merge_base.returncode != 0:
            message = merge_base.stderr.strip()
            raise RuntimeError(f"cannot find merge base for {base!r}: {message}")
        changed.update(_git_paths(root, [*DIFF_ARGUMENTS, merge_base.stdout.strip(), "HEAD"]))
    return changed


def changed_production_sources(changed_paths: Iterable[str]) -> tuple[str, ...]:
    prefix = PRODUCTION_SOURCE_DIRECTORY.as_posix() + "/"
    composition_roots = {path.as_posix() for path in PRODUCTION_COMPOSITION_ROOTS}
    return tuple(
        sorted(
            path
            for path in changed_paths
            if (
                path.startswith(prefix)
                and path.endswith(".brp")
                and separately_gated_owner(path) is None
            )
            or path in composition_roots
        )
    )


def _selection_for_modules(manifest: Manifest, source_paths: Iterable[str]) -> Selection:
    sources = tuple(sorted(set(source_paths)))
    unknown = [path for path in sources if path not in manifest.modules]
    if unknown:
        raise ManifestError(
            [
                (
                    f"unowned production Blorp source selected by --changed: {path}; "
                    f"update {MANIFEST_PATH} and run scripts/compiler-check --validate-manifest"
                )
                for path in unknown
            ]
        )
    suite_ids = {suite_id for path in sources for suite_id in manifest.modules[path].suites}
    check_ids = {check_id for path in sources for check_id in manifest.modules[path].checks}
    suites = tuple(sorted((manifest.suites[item] for item in suite_ids), key=lambda item: item.path))
    checks = tuple(sorted((manifest.checks[item] for item in check_ids), key=lambda item: item.identifier))
    return Selection(sources, suites, checks)


def select_changed(manifest: Manifest, changed_paths: Iterable[str]) -> Selection:
    paths = set(changed_paths)
    selection = _selection_for_modules(manifest, changed_production_sources(paths))
    direct_suites = {
        suite.identifier: suite
        for path in paths
        if (suite := manifest.suites_by_path.get(path)) is not None
    }
    suites_by_id = {suite.identifier: suite for suite in selection.suites}
    suites_by_id.update(direct_suites)
    return Selection(
        selection.sources,
        tuple(sorted(suites_by_id.values(), key=lambda item: item.path)),
        selection.checks,
    )


def suites_importing_changed_tests(
    graph: "ImportGraph", manifest: Manifest, changed_paths: Iterable[str]
) -> tuple[Suite, ...]:
    """The registered suites that import a changed test file, directly or not: a
    helper or another suite's module is run by the suites that use it."""
    tests = {
        path
        for path in changed_paths
        if path.startswith(TEST_ROOT) and graph.imports(path) is not None
    }
    return tuple(
        sorted(
            (
                suite
                for path in graph.importers_of(tests)
                if (suite := manifest.suites_by_path.get(path)) is not None
            ),
            key=lambda item: item.path,
        )
    )


def with_suites(selection: Selection, suites: Iterable[Suite]) -> Selection:
    merged = {suite.identifier: suite for suite in (*selection.suites, *suites)}
    return Selection(
        selection.sources,
        tuple(sorted(merged.values(), key=lambda item: item.path)),
        selection.checks,
    )


def directly_changed_suites(manifest: Manifest, changed_paths: Iterable[str]) -> tuple[Suite, ...]:
    return tuple(
        sorted(
            {
                suite.identifier: suite
                for path in changed_paths
                if (suite := manifest.suites_by_path.get(path)) is not None
            }.values(),
            key=lambda item: item.path,
        )
    )


def select_stage(manifest: Manifest, stage: str) -> Selection:
    if stage not in manifest.stages:
        raise ValueError(f"unknown stage {stage!r}; known stages: {', '.join(manifest.stages)}")
    return _selection_for_modules(
        manifest, (module.path for module in manifest.modules.values() if module.stage == stage)
    )


def select_suite(manifest: Manifest, suite_path: str) -> Selection:
    normalized = PurePosixPath(suite_path).as_posix()
    suite = manifest.suites_by_path.get(normalized)
    if suite is None:
        raise ValueError(f"unknown suite {suite_path!r}; pass an exact registered suite path")
    return Selection((), (suite,), ())


def _print_selection(selection: Selection) -> None:
    print("Selected production sources:")
    if selection.sources:
        for path in selection.sources:
            print(f"  {path}")
    else:
        print("  (none)")
    print("Selected focused suites:")
    if selection.suites:
        for suite in selection.suites:
            print(f"  {suite.identifier}: {suite.path}")
    else:
        print("  (none)")
    print("Selected special checks:")
    if selection.checks:
        for check in selection.checks:
            print(f"  {check.identifier}: {check.path}")
    else:
        print("  (none)")
    sys.stdout.flush()


def _plan_check_command(check: Check) -> list[str]:
    if check.gate is not None:
        return [check.path, "--no-build", "--serial", check.gate]
    assert check.command is not None
    return list(check.command)


def _focused_action_commands(selection: Selection) -> list[list[str]]:
    commands: list[list[str]] = []
    if selection.suites or selection.checks:
        commands.append(["make"])
    if selection.suites:
        timeout = os.environ.get("BLORP_COMPILER_TEST_TIMEOUT", DEFAULT_SUITE_TIMEOUT_SECONDS)
        commands.append(
            ["bin/blorp", "test", "--timeout", timeout, *[suite.path for suite in selection.suites]]
        )
    commands.extend(_plan_check_command(check) for check in selection.checks)
    return commands


def _broad_gate_commands(manifest: Manifest, selection: Selection) -> tuple[str, ...]:
    broad_gate_ids = {
        manifest.modules[path].broad_gate
        for path in selection.sources
        if path in manifest.modules
    }
    commands = [
        shlex.join([gate.path, gate.gate])
        for gate in sorted(
            (manifest.broad_gates[item] for item in broad_gate_ids),
            key=lambda item: item.identifier,
        )
    ]
    return tuple(commands)


def _selection_paths(selection: Selection) -> dict[str, list[str]]:
    return {
        "sources": list(selection.sources),
        "suites": [suite.path for suite in selection.suites],
        "checks": [check.identifier for check in selection.checks],
    }


def _print_noop_plan() -> None:
    print("Selected 0 production sources, 0 suites, 0 special checks.")
    print(
        "No compiler-focused behavior was selected for these changes. This is a no-op, "
        "not a passing validation; use the task-specific build/docs/release checks."
    )


def _listed(paths: tuple[str, ...]) -> str:
    shown = ", ".join(paths[:HAND_BACK_LISTED_PATH_LIMIT])
    hidden = len(paths) - HAND_BACK_LISTED_PATH_LIMIT
    return f"{shown} and {hidden} more" if hidden > 0 else shown


def _print_hand_back(hand_back: HandBack) -> None:
    match hand_back:
        case NoHandBack():
            return
        case TreePathOnly():
            print("Hand-back gates: tree path only")
            print(
                "  No changed path is imported by production code: each is a discovery tree "
                "parser or its projection, a test or tool of them, or documentation."
            )
            print("  Hand-back action: " + "; ".join(hand_back.commands))
            print(
                "  Not required for the hand-back: the full compiler-blorp gate. The Docker "
                "premerge gate runs once at landing, by policy; this script does not check it."
            )
        case BroadHandBack():
            print("Hand-back gates: broad")
            if hand_back.unprovable is not None:
                print(f"  {hand_back.unprovable}")
            if hand_back.production_paths:
                print(f"  outside the tree path: {_listed(hand_back.production_paths)}")
                print(
                    "  These are production, or cannot be shown not to be (a path the import "
                    "graph does not resolve counts as production)."
                )
            print("  Hand-back action: " + "; ".join(hand_back.commands))
    sys.stdout.flush()


def _print_plan(manifest: Manifest, plan: Plan, hand_back: HandBack) -> None:
    selection = plan.selection
    print("Mode: plan only (no build, compiler, test, log, or generated-file write)")
    if not selection.sources and not selection.suites and not selection.checks:
        _print_noop_plan()
        _print_hand_back(hand_back)
        return

    print(
        f"Selected {len(selection.sources)} production sources, "
        f"{len(selection.suites)} suites, {len(selection.checks)} special checks."
    )
    for path in selection.sources:
        module = manifest.modules[path]
        print(f"{plan.source_label}: {shlex.quote(path)}")
        print(f"  owner stage: {module.stage}")
        for suite_id in module.suites:
            print(f"  focused suite: {manifest.suites[suite_id].path}")
        for check_id in module.checks:
            print(f"  selected special check: {check_id}")
    for suite in plan.changed_tests:
        print(f"Changed test: {suite.path}")

    commands = _focused_action_commands(selection)
    if commands:
        print(f"Focused action: {'; '.join(shlex.join(command) for command in commands)}")
    else:
        print("Focused action: (none)")

    for command in _broad_gate_commands(manifest, selection):
        print(f"Recommended additional gate: {command}")
        print("Reason: manifest broad_gate; review guidance only, not run by --plan")
    _print_hand_back(hand_back)
    sys.stdout.flush()


def _hand_back_json(hand_back: HandBack) -> dict[str, Any]:
    match hand_back:
        case NoHandBack():
            return {"scope": "none", "tree_paths": [], "production_paths": [], "commands": []}
        case TreePathOnly():
            return {
                "scope": "tree-path-only",
                "tree_paths": list(hand_back.tree_paths),
                "production_paths": [],
                "commands": list(hand_back.commands),
            }
        case BroadHandBack():
            return {
                "scope": "broad",
                "tree_paths": list(hand_back.tree_paths),
                "production_paths": list(hand_back.production_paths),
                "unprovable": hand_back.unprovable,
                "commands": list(hand_back.commands),
            }


def _print_plan_json(manifest: Manifest, plan: Plan, hand_back: HandBack) -> None:
    payload = {
        "schema_version": 1,
        "mode": "plan",
        "selection": _selection_paths(plan.selection),
        "changed_tests": [suite.path for suite in plan.changed_tests],
        "source_label": plan.source_label,
        "focused_action": [command for command in _focused_action_commands(plan.selection)],
        "recommendations": list(_broad_gate_commands(manifest, plan.selection)),
        "recommendation_authority": "manifest broad_gate",
        "hand_back": _hand_back_json(hand_back),
    }
    print(json.dumps(payload, indent=2))


def _run_logged(
    command: list[str], root: Path, log_path: Path, extra_env: dict[str, str] | None = None
) -> int:
    print(f"Running: {shlex.join(command)}")
    sys.stdout.flush()
    env = dict(os.environ)
    if extra_env:
        env.update(extra_env)
    with log_path.open("w", encoding="utf-8") as log:
        process = subprocess.Popen(
            command,
            cwd=root,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            env=env,
        )
        assert process.stdout is not None
        for line in process.stdout:
            log.write(line)
            log.flush()
        return process.wait()


GATE_RESULT_PATTERN = re.compile(
    r"^BLORP_GATE_RESULT gate=\S+ status=(?P<status>PASS|FAIL) "
    r"passed=(?P<passed>\d+) failed=(?P<failed>\d+) tests=(?P<tests>\d+)\s*$"
)


def _read_gate_result(log_path: Path) -> tuple[int, int, int] | None:
    """Return (passed, failed, tests) from the last BLORP_GATE_RESULT line, if any."""
    try:
        lines = log_path.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return None
    for line in reversed(lines):
        match = GATE_RESULT_PATTERN.match(line.strip())
        if match:
            return int(match["passed"]), int(match["failed"]), int(match["tests"])
    return None


def _print_verdict(status: int, passed: int, failed: int, tests: int) -> None:
    verdict = "PASS" if status == 0 else "FAIL"
    print(
        f"BLORP_GATE_RESULT gate=compiler-check status={verdict} "
        f"passed={passed} failed={failed} tests={tests}"
    )


def _repository_revision(root: Path) -> str:
    result = subprocess.run(
        ["git", "rev-parse", "HEAD"], cwd=root, text=True, capture_output=True
    )
    return result.stdout.strip() if result.returncode == 0 else "unknown"


def _write_failure_context(root: Path, log_directory: Path, rerun: str) -> None:
    metadata = {
        "schema_version": 1,
        "recorded_at": datetime.now(timezone.utc).isoformat(),
        "revision": _repository_revision(root),
        "platform": platform.platform(),
        "command": rerun,
    }
    (log_directory / "metadata.json").write_text(
        json.dumps(metadata, indent=2) + "\n", encoding="utf-8"
    )
    (log_directory / "rerun.txt").write_text(rerun + "\n", encoding="utf-8")


def execute_selection(root: Path, selection: Selection, original_arguments: list[str]) -> int:
    start = time.monotonic()
    if not selection.suites and not selection.checks:
        elapsed = time.monotonic() - start
        print(
            f"Selected {len(selection.sources)} production sources, 0 suites, 0 special checks."
        )
        print(
            "No compiler-focused behavior was selected for these changes. This is a no-op, "
            "not a passing validation; use the task-specific build/docs/release checks."
        )
        print(
            f"Compiler check completed with no selected work in {elapsed:.2f}s"
        )
        _print_verdict(0, 0, 0, 0)
        return 0

    log_root = root / "logs"
    log_root.mkdir(exist_ok=True)
    timestamp = datetime.now().strftime("%Y%m%d-%H%M%S")
    log_directory = log_root / f"compiler-check-{timestamp}-{os.getpid()}"
    log_directory.mkdir()
    rerun = shlex.join(["scripts/compiler-check", *original_arguments])
    (log_directory / "selection.json").write_text(
        json.dumps(
            {
                "schema_version": 1,
                "sources": list(selection.sources),
                "suites": [suite.path for suite in selection.suites],
                "checks": [check.identifier for check in selection.checks],
            },
            indent=2,
        )
        + "\n",
        encoding="utf-8",
    )

    total_passed = 0
    total_failed = 0
    total_tests = 0

    status = _run_logged(["make"], root, log_directory / "prepare.log")
    if status == 0 and selection.suites:
        timeout = os.environ.get("BLORP_COMPILER_TEST_TIMEOUT", DEFAULT_SUITE_TIMEOUT_SECONDS)
        suites_log = log_directory / "suites.log"
        status = _run_logged(
            ["bin/blorp", "test", "--timeout", timeout, *[suite.path for suite in selection.suites]],
            root,
            suites_log,
            extra_env={"BLORP_GATE_RESULT": "compiler-check-suites"},
        )
        result = _read_gate_result(suites_log)
        if result is not None:
            passed, failed, tests = result
            total_passed += passed
            total_failed += failed
            total_tests += tests
        else:
            total_tests += 1
            if status == 0:
                total_passed += 1
            else:
                total_failed += 1
    if status == 0:
        for check in selection.checks:
            if check.gate is not None:
                gate_log_directory = log_directory / check.identifier
                gate_log_directory.mkdir()
                command = [
                    check.path,
                    "--no-build",
                    "--serial",
                    "--log-dir",
                    str(gate_log_directory),
                    check.gate,
                ]
            else:
                assert check.command is not None
                command = list(check.command)
            check_log = log_directory / f"check-{check.identifier}.log"
            status = _run_logged(command, root, check_log)
            result = _read_gate_result(check_log)
            if result is not None:
                passed, failed, tests = result
                total_passed += passed
                total_failed += failed
                total_tests += tests
            else:
                total_tests += 1
                if status == 0:
                    total_passed += 1
                else:
                    total_failed += 1
            if status != 0:
                break

    if status != 0:
        _write_failure_context(root, log_directory, rerun)
        print(f"Compiler check failed with status {status}.", file=sys.stderr)
        print(f"Rerun: {rerun}", file=sys.stderr)
        print(f"Logs retained at: {log_directory.relative_to(root)}", file=sys.stderr)
        _print_verdict(status, total_passed, total_failed, total_tests)
        return status

    shutil.rmtree(log_directory)
    elapsed = time.monotonic() - start
    print(
        f"Compiler check passed: {len(selection.sources)} sources, "
        f"{len(selection.suites)} suites, {len(selection.checks)} checks in {elapsed:.2f}s"
    )
    _print_verdict(0, total_passed, total_failed, total_tests)
    return 0


def argument_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="scripts/compiler-check",
        description="Run manifest-owned focused checks for Blorp changes.",
    )
    parser.add_argument("suite", nargs="?", help="exact registered Blorp suite path")
    parser.add_argument("--stage", metavar="NAME", help="select one exact manifest stage")
    parser.add_argument(
        "--changed",
        action="store_true",
        help="select changed production sources and registered suites",
    )
    parser.add_argument("--base", metavar="REF", help="also include committed changes from merge base")
    parser.add_argument(
        "--plan",
        action="store_true",
        help="print selected checks and next-gate guidance without building or running tests",
    )
    parser.add_argument(
        "--json",
        action="store_true",
        help="with --plan, print the selected checks and recommendations as JSON",
    )
    parser.add_argument(
        "--validate-manifest",
        action="store_true",
        help="validate ownership manifest coverage without running checks",
    )
    return parser


def main(arguments: list[str]) -> int:
    parser = argument_parser()
    options = parser.parse_args(arguments)
    selected_modes = int(options.suite is not None) + int(options.stage is not None) + int(options.changed)
    if options.base is not None and not options.changed:
        parser.error("--base requires --changed")
    if options.json and not options.plan:
        parser.error("--json requires --plan")
    if options.validate_manifest:
        if selected_modes or options.base is not None or options.plan or options.json:
            parser.error("--validate-manifest is incompatible with selection modes")
    elif selected_modes == 0:
        parser.error("choose a suite path, --stage NAME, or --changed")
    elif selected_modes > 1:
        parser.error("suite, --stage, and --changed are mutually exclusive")

    root = Path(__file__).resolve().parent.parent
    try:
        manifest = load_manifest(root)
        changed_paths: set[str] = set()
        hand_back: HandBack = NoHandBack()
        if options.validate_manifest:
            print(
                f"Compiler test ownership manifest is valid: {len(manifest.modules)} production modules, "
                f"{len(manifest.suites)} suites, {len(manifest.checks)} checks"
            )
            return 0
        if options.suite is not None:
            selection = select_suite(manifest, options.suite)
        elif options.stage is not None:
            selection = select_stage(manifest, options.stage)
        else:
            changed_paths = changed_repository_paths(root, options.base)
            # Selection runs on files that exist; a deleted or renamed-away path
            # only widens the hand-back.
            existing_paths = {path for path in changed_paths if (root / path).exists()}
            selection = with_suites(
                select_changed(manifest, existing_paths),
                suites_importing_changed_tests(ImportGraph(root), manifest, existing_paths),
            )
            hand_back = hand_back_for(root, manifest, changed_paths)
    except ManifestError as error:
        for message in error.errors:
            print(f"error: {message}", file=sys.stderr)
        return 2
    except (RuntimeError, ValueError) as error:
        parser.error(str(error))

    if options.changed:
        changed_tests = directly_changed_suites(manifest, changed_paths)
        source_label = "Changed production source"
    else:
        changed_tests = ()
        source_label = "Selected production source"
    if options.plan:
        plan = Plan(selection, changed_tests, source_label)
        if options.json:
            _print_plan_json(manifest, plan, hand_back)
        else:
            _print_plan(manifest, plan, hand_back)
        return 0

    _print_hand_back(hand_back)
    _print_selection(selection)
    return execute_selection(root, selection, arguments)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
