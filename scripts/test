run_compiler_blorp() {
    echo "═══ Compiler Blorp TestSuites (.brp) ═══"
    echo ""
    local output exit_code output_file start_seconds
    start_seconds=$(now_seconds)
    output_file=$(mktemp "${TMPDIR:-/tmp}/blorp_compiler_blorp.XXXXXX") || exit 1
    : > "$output_file"
    run_compiler_blorp_gate_commands "$output_file" "$verbose"
    exit_code=$?
    output=$(cat "$output_file")
    record_gate_log "compiler-blorp" "$output_file"
    maybe_print_failure_excerpt "compiler-blorp" "$output_file" "$exit_code"
    print_blorp_test_timing_summary "$output_file"
    rm -f "$output_file"
    compiler_blorp_seconds=$(elapsed_since "$start_seconds")
    echo ""
    parse_blorp_output "$output" "compiler_blorp"
    mark_gate_process_failure "compiler_blorp" "$exit_code"
    return $exit_code
}

