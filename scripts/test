run_leak() {
    echo "═══ Leak-Check Ownership Suites + Diagnostics ═══"
    echo ""
    local output exit_code output_file diag_output_file start_seconds
    local suite_exit diag_exit suite_output diag_output
    start_seconds=$(now_seconds)
    output_file=$(mktemp "${TMPDIR:-/tmp}/blorp_leak.XXXXXX") || exit 1
    diag_output_file=$(mktemp "${TMPDIR:-/tmp}/blorp_leak_diag.XXXXXX") || {
        rm -f "$output_file"
        exit 1
    }
    if $verbose; then
        env BLORP_GATE_RESULT=leak ./blorp test --no-format --leak-check --suite --timeout "$test_timeout" "${leak_roots[@]}" 2>&1 | tee "$output_file"
        suite_exit=${PIPESTATUS[0]}
        suite_output=$(cat "$output_file")
        tests/test_leak_report.sh 2>&1 | tee "$diag_output_file"
        diag_exit=${PIPESTATUS[0]}
        diag_output=$(cat "$diag_output_file")
        cat "$diag_output_file" >> "$output_file"
    else
        env BLORP_GATE_RESULT=leak ./blorp test --no-format --leak-check --suite --timeout "$test_timeout" "${leak_roots[@]}" > "$output_file" 2>&1
        suite_exit=$?
        suite_output=$(cat "$output_file")
        tests/test_leak_report.sh > "$diag_output_file" 2>&1
        diag_exit=$?
        diag_output=$(cat "$diag_output_file")
        cat "$diag_output_file" >> "$output_file"
    fi
    emit_combined_leak_result "$suite_output" "$diag_output" "$suite_exit" "$diag_exit" >> "$output_file"
    if [ "$suite_exit" -eq 0 ] && [ "$diag_exit" -eq 0 ]; then
        exit_code=0
    else
        exit_code=1
    fi
    output=$(cat "$output_file")
    record_gate_log "leak" "$output_file"
    maybe_print_failure_excerpt "leak" "$output_file" "$exit_code"
    rm -f "$output_file" "$diag_output_file"
    leak_seconds=$(elapsed_since "$start_seconds")
    echo ""
    parse_blorp_output "$output" "leak"
    mark_gate_process_failure "leak" "$exit_code"
    return $exit_code
}

run_doctest() {
    echo "═══ Doctests (std/) ═══"
    echo ""
    local output exit_code output_file start_seconds
    start_seconds=$(now_seconds)
    output_file=$(mktemp "${TMPDIR:-/tmp}/blorp_doctest.XXXXXX") || exit 1
    capture_stream "$output_file" env BLORP_GATE_RESULT=doctest ./blorp test --no-format --doc --timeout "$test_timeout" std/
    exit_code=$?
    output=$(cat "$output_file")
    record_gate_log "doctest" "$output_file"
    maybe_print_failure_excerpt "doctest" "$output_file" "$exit_code"
    rm -f "$output_file"
    doctest_seconds=$(elapsed_since "$start_seconds")
    echo ""
    parse_blorp_output "$output" "doctest"
    mark_gate_process_failure "doctest" "$exit_code"
    return $exit_code
}

run_cli() {
    echo "═══ CLI Smoke / Exit Codes ═══"
    echo ""
    local output exit_code output_file start_seconds
    start_seconds=$(now_seconds)
    output_file=$(mktemp "${TMPDIR:-/tmp}/blorp_cli.XXXXXX") || exit 1
    capture_stream "$output_file" tests/test_cli.sh --smoke --timeout "$test_timeout"
    exit_code=$?
    output=$(cat "$output_file")
    record_gate_log "cli" "$output_file"
    maybe_print_failure_excerpt "cli" "$output_file" "$exit_code"
    rm -f "$output_file"
    cli_seconds=$(elapsed_since "$start_seconds")
    echo ""
    parse_cli "$output"
    mark_gate_process_failure "cli" "$exit_code"
    return $exit_code
}

run_cli_deep() {
    echo "═══ CLI Deep Integration ═══"
    echo ""
    local output exit_code output_file start_seconds
    start_seconds=$(now_seconds)
    output_file=$(mktemp "${TMPDIR:-/tmp}/blorp_cli_deep.XXXXXX") || exit 1
    capture_stream "$output_file" tests/test_cli.sh --all --timeout "$test_timeout" --gate-name cli_deep
    exit_code=$?
    output=$(cat "$output_file")
    record_gate_log "cli-deep" "$output_file"
    maybe_print_failure_excerpt "cli-deep" "$output_file" "$exit_code"
    rm -f "$output_file"
    cli_deep_seconds=$(elapsed_since "$start_seconds")
    echo ""
    parse_cli_deep "$output"
    mark_gate_process_failure "cli_deep" "$exit_code"
    return $exit_code
}

# ─── Run gates ─────────────────────────────────────────────────────

any_failed=false
parallel_gates=("${gates[@]}")

# Multiple selected gates use fixed waves rather than launching everything at
# once. This is intentionally not a scheduler: the expensive gates already have
# their own internal execution strategy, and making the shell harness infer CPU
# needs from names or timings would be fragile. Static waves keep the local run
# predictable while avoiding the worst contention between compiler fixtures,
# generated-C compiles, runtime tests, and the serial Alcotest suite.
init_gate_output() {
    local gate="$1"
    local outfile="$2"
    case "$gate" in
        unit)
            {
                echo "═══ Compiler Unit Tests (OCaml/Alcotest) ═══"
                echo ""
            } > "$outfile"
            ;;
        unit_deep)
            {
                echo "═══ Compiler Unit Deep Tests (OCaml/Alcotest integration) ═══"
                echo ""
            } > "$outfile"
            ;;
        compiler)
            {
                echo "═══ Compiler Tests (fast fixtures) ═══"
                echo ""
            } > "$outfile"
            ;;
        compiler_deep)
            {
                echo "═══ Compiler Deep Tests (codegen audit + compiler/blorp) ═══"
                echo ""
            } > "$outfile"
            ;;
        compiler_core_sanitize)
            {
                echo "═══ Compiler Core Ownership Tests (ASan + UBSan) ═══"
                echo ""
            } > "$outfile"
            ;;
        compiler_blorp_sanitize)
            {
                echo "═══ Compiler Blorp Ownership Tests (ASan + UBSan) ═══"
                echo ""
            } > "$outfile"
            ;;
        std_check)
            {
                echo "═══ Std Typecheck Check ═══"
                echo ""
            } > "$outfile"
            ;;
        runtime)
            {
                echo "═══ Runtime Tests (.brp) ═══"
                echo ""
            } > "$outfile"
            ;;
        leak)
            {
                echo "═══ Leak-Check Ownership Suites + Diagnostics ═══"
                echo ""
            } > "$outfile"
            ;;
        doctest)
            {
                echo "═══ Doctests (std/) ═══"
                echo ""
            } > "$outfile"
            ;;
        cli)
            {
                echo "═══ CLI Smoke / Exit Codes ═══"
                echo ""
            } > "$outfile"
            ;;
        cli_deep)
            {
                echo "═══ CLI Deep Integration ═══"
                echo ""
            } > "$outfile"
            ;;
    esac
}

run_gate_to_file() {
    local gate="$1"
    local outfile="$2"
    case "$gate" in
        unit)
            if $coverage; then
                run_compiler_unit_coverage_command >> "$outfile" 2>&1
            else
                run_compiler_unit_scope_command default >> "$outfile" 2>&1
            fi
            ;;
        unit_deep)
            if $coverage; then
                echo "Error: --coverage is only supported for compiler-unit, not compiler-unit-deep." >> "$outfile"
                return 2
            else
                run_compiler_unit_scope_command deep >> "$outfile" 2>&1
            fi
            ;;
        compiler)
            run_compiler_gate_commands "$outfile" false
            ;;
        compiler_deep)
            run_compiler_deep_gate_commands "$outfile" false
            ;;
        compiler_core_sanitize)
            run_compiler_core_sanitize_commands "$outfile" false
            ;;
        compiler_blorp_sanitize)
            run_compiler_blorp_sanitize_commands "$outfile" false
            ;;
        std_check)
            run_std_check_gate_commands "$outfile"
            ;;
        runtime)
            env BLORP_GATE_RESULT=runtime ./blorp test --no-format --timeout "$test_timeout" "${runtime_roots[@]}" >> "$outfile" 2>&1
            ;;
        leak)
            env BLORP_GATE_RESULT=leak ./blorp test --no-format --leak-check --suite --timeout "$parallel_leak_timeout" "${leak_roots[@]}" >> "$outfile" 2>&1
            leak_suite_exit=$?
            leak_suite_output=$(cat "$outfile")
            leak_diag_outfile="$gate_tmpdir/${gate}_diag_output"
            tests/test_leak_report.sh > "$leak_diag_outfile" 2>&1
            leak_diag_exit=$?
            leak_diag_output=$(cat "$leak_diag_outfile")
            cat "$leak_diag_outfile" >> "$outfile"
            emit_combined_leak_result "$leak_suite_output" "$leak_diag_output" "$leak_suite_exit" "$leak_diag_exit" >> "$outfile"
            if [ "$leak_suite_exit" -ne 0 ] || [ "$leak_diag_exit" -ne 0 ]; then
                false
            else
                true
            fi
            ;;
        doctest)
            env BLORP_GATE_RESULT=doctest ./blorp test --no-format --doc --timeout "$test_timeout" std/ >> "$outfile" 2>&1
            ;;
        cli)
            tests/test_cli.sh --smoke --timeout "$test_timeout" >> "$outfile" 2>&1
            ;;
        cli_deep)
            tests/test_cli.sh --all --timeout "$test_timeout" --gate-name cli_deep >> "$outfile" 2>&1
            ;;
    esac
}

launch_gate_worker() {
    local gate="$1"
    local outfile="$gate_tmpdir/${gate}_output"
    local exitfile="$gate_tmpdir/${gate}_exit"
    local secondsfile="$gate_tmpdir/${gate}_seconds"

    init_gate_output "$gate" "$outfile"
    {
        gate_start_seconds=$(now_seconds)
        run_gate_to_file "$gate" "$outfile"
        gate_exit=$?
        echo "$gate_exit" > "$exitfile"
        elapsed_since "$gate_start_seconds" > "$secondsfile"
        exit "$gate_exit"
    } &
    gate_pids+=($!)
    gate_names+=("$gate")
    echo "RUN gate: $gate (pid $!)"
}

collect_gate_worker() {
    local gate="$1"
    local outfile="$gate_tmpdir/${gate}_output"
    local exitfile="$gate_tmpdir/${gate}_exit"
    local secondsfile="$gate_tmpdir/${gate}_seconds"
    local local_exit=1
    local local_seconds=0
    local local_output=""

    [ -f "$exitfile" ] && local_exit=$(cat "$exitfile")
    [ -f "$secondsfile" ] && local_seconds=$(cat "$secondsfile")
    eval "${gate}_seconds=\$local_seconds"

    if [ -f "$outfile" ]; then
        record_gate_log "$gate" "$outfile"
    fi

    if [ -f "$outfile" ] && $verbose; then
        echo ""
        cat "$outfile"
    elif [ -f "$outfile" ] && [ "$local_exit" != "0" ]; then
        print_failure_excerpt "$gate" "$outfile"
    fi
    if [ -f "$outfile" ]; then
        print_compiler_unit_timing_summary "$gate" "$outfile"
    fi

    [ -f "$outfile" ] && local_output=$(cat "$outfile")
    case "$gate" in
        unit)     parse_unit "$local_output" ;;
        unit_deep) parse_unit_deep "$local_output" ;;
        compiler) parse_compiler_gate_output "$local_output" ;;
        compiler_deep) parse_compiler_deep_gate_output "$local_output" ;;
        compiler_core_sanitize) parse_blorp_output "$local_output" "compiler_core_sanitize" ;;
        compiler_blorp_sanitize) parse_blorp_output "$local_output" "compiler_blorp_sanitize" ;;
        std_check) parse_std_check_gate_output "$local_output" ;;
        runtime)  parse_blorp_output "$local_output" "runtime" ;;
        leak)     parse_blorp_output "$local_output" "leak" ;;
        doctest)  parse_blorp_output "$local_output" "doctest" ;;
        cli)      parse_cli "$local_output" ;;
        cli_deep) parse_cli_deep "$local_output" ;;
    esac
    mark_gate_process_failure "$gate" "$local_exit"
    [ "$local_exit" != "0" ] && any_failed=true
}

gate_selected() {
    local wanted="$1"
    local gate
    for gate in "${parallel_gates[@]}"; do
        [ "$gate" = "$wanted" ] && return 0
    done
    return 1
}

run_gate_wave() {
    local wave_name="$1"
    shift
    local wave_gates=()
    local gate pid

    for gate in "$@"; do
        if gate_selected "$gate"; then
            wave_gates+=("$gate")
        fi
    done

    [ ${#wave_gates[@]} -gt 0 ] || return 0
    if [ ${#wave_gates[@]} -eq 1 ]; then
        echo "RUN wave: $wave_name (${wave_gates[0]})"
    else
        echo "RUN wave: $wave_name (${wave_gates[*]})"
    fi

    gate_pids=()
    gate_names=()
    for gate in "${wave_gates[@]}"; do
        launch_gate_worker "$gate"
    done

    for pid in "${gate_pids[@]}"; do
        wait "$pid" 2>/dev/null || true
    done
    gate_pids=()
    gate_names=()

    for gate in "${wave_gates[@]}"; do
        collect_gate_worker "$gate"
    done
}

# Each gate's output is captured for summary parsing; --verbose prints it back.
if [ ${#parallel_gates[@]} -eq 0 ]; then
    :
elif $serial || [ ${#parallel_gates[@]} -le 1 ]; then
    # Single-gate and serial mode: run directly; gate runners self-capture.
    for gate in "${parallel_gates[@]}"; do
        case "$gate" in
            unit)     run_unit     || any_failed=true ;;
            unit_deep) run_unit_deep || any_failed=true ;;
            compiler) run_compiler || any_failed=true ;;
            compiler_deep) run_compiler_deep || any_failed=true ;;
            compiler_core_sanitize) run_compiler_core_sanitize || any_failed=true ;;
            compiler_blorp_sanitize) run_compiler_blorp_sanitize || any_failed=true ;;
            std_check) run_std_check || any_failed=true ;;
            runtime)  run_runtime  || any_failed=true ;;
            leak)     run_leak     || any_failed=true ;;
            doctest)  run_doctest  || any_failed=true ;;
            cli)      run_cli      || any_failed=true ;;
            cli_deep) run_cli_deep || any_failed=true ;;
        esac
    done
else
    # Multiple gates: run in fixed waves, collect results.
    # Pre-warm the precompiled runtime cache to prevent race conditions
    # between gate runners that both call precompile_runtime().
    if ! ./blorp test --warmup-only 2>/dev/null; then
        echo "Warning: runtime cache warmup failed — parallel tests may have cache misses" >&2
    fi
    parallel_leak_timeout=$(parallel_default_timeout "$test_timeout" "${#parallel_gates[@]}")
    gate_tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/blorp_gates.XXXXXX")

    run_gate_wave "compiler-unit" unit
    run_gate_wave "compiler-unit-deep" unit_deep
    run_gate_wave "compiler" compiler
    run_gate_wave "compiler-deep" compiler_deep
    run_gate_wave "compiler-core-sanitize" compiler_core_sanitize
    run_gate_wave "compiler-blorp-sanitize" compiler_blorp_sanitize
    run_gate_wave "std-check" std_check
    run_gate_wave "runtime" runtime
    run_gate_wave "tail" leak doctest cli
    run_gate_wave "cli-deep" cli_deep
fi

# ─── Summary ────────────────────────────────────────────────────────

total_tests=0
total_passed=0
total_failed=0
total_gate_seconds=0
overall="PASS"

for s in "${gates[@]}"; do
    st=$(eval echo "\$${s}_status")
    p=$(eval echo "\$${s}_passed")
    f=$(eval echo "\$${s}_failed")
    t=$(eval echo "\$${s}_tests")
    sec=$(eval echo "\$${s}_seconds")
    total_passed=$((total_passed + p))
    total_failed=$((total_failed + f))
    total_tests=$((total_tests + t))
    total_gate_seconds=$((total_gate_seconds + sec))
    if [ "$st" = "FAIL" ]; then
        overall="FAIL"
    fi
done

total_wall_seconds=$(elapsed_since "$script_start_seconds")

echo "══════════════════════════════════════════════════════════"
echo "  Gate          Status   Passed  Failed   Tests     Time"
echo "──────────────────────────────────────────────────────────"
for s in "${gates[@]}"; do
    st=$(eval echo "\$${s}_status")
    p=$(eval echo "\$${s}_passed")
    f=$(eval echo "\$${s}_failed")
    t=$(eval echo "\$${s}_tests")
    sec=$(eval echo "\$${s}_seconds")
    case "$s" in
        unit)     label="Compiler-unit" ;;
        unit_deep) label="Compiler-unit-deep" ;;
        compiler) label="Compiler" ;;
        compiler_deep) label="Compiler-deep" ;;
        compiler_core_sanitize) label="Compiler-Core-ASan" ;;
        compiler_blorp_sanitize) label="Compiler-Blorp-ASan" ;;
        std_check) label="Std-check" ;;
        runtime)  label="Runtime" ;;
        leak)     label="Leak-check" ;;
        doctest)  label="Doctests" ;;
        cli)      label="CLI" ;;
        cli_deep) label="CLI-deep" ;;
    esac
    printf "  %-13s %-6s %8d %7d %7d %8s\n" "$label" "$st" "$p" "$f" "$t" "$(format_seconds "$sec")"
done
echo "──────────────────────────────────────────────────────────"
printf "  %-13s %-6s %8d %7d %7d %8s\n" "Total" "$overall" "$total_passed" "$total_failed" "$total_tests" "$(format_seconds "$total_wall_seconds")"
echo "══════════════════════════════════════════════════════════"
echo "Setup: build $(format_seconds "$build_seconds"), bridge prepare $(format_seconds "$bridge_prepare_seconds"), gate-sum $(format_seconds "$total_gate_seconds")."

# List failing tests if any
if [ "$overall" = "FAIL" ]; then
    echo ""
    echo "Failed tests:"
    for s in "${gates[@]}"; do
        local_failures=$(eval echo "\"\$${s}_failures\"")
        if [ -n "$local_failures" ]; then
            echo "$local_failures" | while IFS= read -r line; do
                echo "  $line"
            done
        fi
    done
fi

if $any_failed || [ "$overall" = "FAIL" ]; then
    exit 1
fi
