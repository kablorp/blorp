#!/bin/bash
# Run blorp test gates
#
# Usage:
#   scripts/test                    # Run default test gates
#   scripts/test compiler-blorp     # Compiler-owned Blorp TestSuites
#   scripts/test compiler-tools     # Formatter, purify, and lint public CLI fixtures
#   scripts/test compiler-core-sanitize  # Focused Core .brp tests under ASan + UBSan
#   scripts/test compiler-blorp-sanitize # Compiler-owned .brp tests under ASan + UBSan
#   scripts/test std-check          # Broad std/ typecheck sweep
#   scripts/test runtime            # Runtime .brp tests (language features)
#   scripts/test leak               # Focused --leak-check suites and leak diagnostics
#   scripts/test doctest            # Doctests only (std/ library)
#   scripts/test cli                # Public CLI and LSP smoke checks
#   scripts/test cli-deep           # Full CLI integration checks
#   scripts/test lsp                # Public LSP protocol fixtures
#   scripts/test package            # Public package lifecycle integration
#   scripts/test compiler-blorp runtime  # Multiple gates
#   scripts/test --serial           # Run selected gates one at a time
#   scripts/test --no-build         # Test the existing installed toolchain
#   scripts/test --timings          # Print generated TestSuite phase timings
#   scripts/test --verbose          # Print every child-runner line
#   scripts/test --log-dir logs     # Save premerge gate logs

script_dir="$(cd "$(dirname "$0")" && pwd -P)"
if [ "${BLORP_TEST_LOCK_HELD:-0}" != "1" ]; then
    export BLORP_TEST_LOCK_HELD=1
    exec "$script_dir/with-build-lock" "$script_dir/test" "$@"
fi

cd "$script_dir/.."

runner_label="scripts/test"
script_start_seconds=$(date +%s)

now_seconds() {
    date +%s
}

elapsed_since() {
    local start="$1"
    local end
    end=$(now_seconds)
    echo $((end - start))
}

format_seconds() {
    local seconds="$1"
    if [ "$seconds" -lt 60 ]; then
        printf "%ds" "$seconds"
    else
        printf "%dm%02ds" $((seconds / 60)) $((seconds % 60))
    fi
}

usage() {
    echo "Usage: $runner_label [options] [compiler-blorp] [compiler-tools] [compiler-core-sanitize] [compiler-blorp-sanitize] [std-check] [runtime] [leak] [doctest] [cli] [cli-deep] [lsp] [package]"
    cat <<'EOF'

Options:
  --serial       Run selected gates one at a time.
  --no-build     Use the existing installed toolchain without invoking make.
  --timings      Print generated TestSuite phase timings.
  --verbose      Stream full child-runner output, including passing tests.
  --quiet        Suppress passing-test output (default).
  --log-dir DIR  Copy each gate's full captured output into DIR.
EOF
}

# Parse arguments
gates=()
skip_build=false
serial=false
verbose=false
timings=false
log_dir=""
while [ $# -gt 0 ]; do
    arg="$1"
    shift
    case "$arg" in
        --no-build) skip_build=true ;;
        --timings) timings=true ;;
        --serial) serial=true ;;
        --verbose) verbose=true ;;
        --quiet) verbose=false ;;
        --log-dir)
            if [ $# -eq 0 ]; then
                echo "Error: --log-dir requires a directory path." >&2
                usage
                exit 1
            fi
            log_dir="$1"
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        compiler-blorp) gates+=("compiler_blorp") ;;
        compiler-tools) gates+=("compiler_tools") ;;
        compiler-core-sanitize) gates+=("compiler_core_sanitize") ;;
        compiler-blorp-sanitize) gates+=("compiler_blorp_sanitize") ;;
        std-check) gates+=("std_check") ;;
        cli-deep) gates+=("cli_deep") ;;
        runtime|leak|doctest|cli|lsp|package) gates+=("$arg") ;;
        *)
            echo "Unknown argument: $arg"
            usage
            exit 1
            ;;
    esac
done

if $timings; then
    export BLORP_TEST_TIMINGS=1
fi

default_gates=(compiler_blorp runtime leak doctest cli)
if [ ${#gates[@]} -eq 0 ]; then
    gates=("${default_gates[@]}")
fi

if [ -n "$log_dir" ]; then
    mkdir -p "$log_dir"
fi

default_test_timeout=30
test_timeout="${BLORP_TEST_TIMEOUT:-$default_test_timeout}"
# Compiler-owned Blorp suites combine many sources into each generated binary.
# A cold combined run can spend more than 60 seconds in a healthy compiler
# phase without emitting TestSuite progress.
default_compiler_blorp_test_timeout=180
compiler_blorp_test_timeout="${BLORP_COMPILER_TEST_TIMEOUT:-${BLORP_TEST_TIMEOUT:-$default_compiler_blorp_test_timeout}}"
expected_blorp_check_fixture_count=52
# Compiler-owned sanitizer suites are grouped into source-budgeted executables.
# The largest group currently needs about 107 seconds under ASan/UBSan on macOS,
# so keep a finite per-executable budget with enough headroom for loaded hosts.
default_compiler_sanitize_test_timeout=180
compiler_sanitize_test_timeout="${BLORP_COMPILER_SANITIZE_TEST_TIMEOUT:-$default_compiler_sanitize_test_timeout}"
runtime_roots_per_invocation=64
compiler_blorp_test_roots=()
compiler_blorp_test_shard_summary=""
compiler_blorp_test_shard_error=""

# Leak instrumentation owns both the dedicated memory corpus and regressions
# whose resource/COW behavior is not represented there yet. The runtime gate
# excludes these exact sources so every case still executes once by default.
leak_roots=(
    tests/test_blorp/memory/
    # LSP transitions retain immutable protocol and overlay state across
    # requests, so normal compiler-Blorp execution is insufficient coverage.
    compiler/tests/lsp/*/test_compiler_lsp_*.brp
    # Header installation stores resolved generic payloads in several internal
    # containers. Keep their representation choices under ARC instrumentation.
    compiler/tests/test_compiler_bound_module_graph.brp
    compiler/tests/test_compiler_callable_headers.brp
    compiler/tests/test_compiler_implementation_headers.brp
    compiler/tests/test_compiler_trait_topology_graph.brp
    compiler/tests/test_compiler_type_header_graph.brp
    # Core traversal passes capturing callbacks through hot stack-only state.
    # Leak instrumentation enforces that callback ownership remains balanced.
    compiler/tests/test_compiler_core_traverse.brp
    tests/test_std/list/test_list_of_vectors.brp
    tests/test_std/list/test_list_pattern.brp
    tests/test_std/list/test_tailrec_list_pattern.brp
    tests/test_std/list/test_list_pipeline_fusion.brp
    tests/test_std/list/test_list_get_or_set_ir.brp
    tests/test_std/dict/test_dict_fold.brp
    tests/test_std/dict/test_dict_increment.brp
    tests/test_std/dict/test_dict_return_local_after_entries.brp
    tests/test_std/heap/test_heap_cow.brp
    tests/test_std/set/
    tests/test_blorp/text/test_string_ops.brp
    tests/test_blorp/text/test_string_ir.brp
    tests/test_blorp/numeric/test_vector_cow.brp
    tests/test_blorp/numeric/test_tensor_raw_view_cow.brp
    tests/test_blorp/numeric/test_matrix_builtins_alloc.brp
    tests/test_blorp/numeric/test_tensor_chained.brp
    tests/test_blorp/numeric/test_tensor_nested_loop.brp
    tests/test_blorp/concurrency/test_detached_channel_fanout_regression.brp
    tests/test_blorp/concurrency/test_task_result_alias.brp
    tests/test_blorp/sys/test_directory_resource.brp
    tests/test_blorp/sys/test_file_resource.brp
)

is_leak_owned_source() {
    local source_path="$1"
    local leak_root

    for leak_root in "${leak_roots[@]}"; do
        case "$leak_root" in
            */)
                case "$source_path" in
                    "$leak_root"*) return 0 ;;
                esac
                ;;
            *)
                [ "$source_path" = "$leak_root" ] && return 0
                ;;
        esac
    done

    return 1
}

directory_contains_leak_owned_source() {
    local directory="$1"
    local leak_root

    for leak_root in "${leak_roots[@]}"; do
        case "$leak_root" in
            "$directory"*) return 0 ;;
        esac
    done

    return 1
}

append_runtime_directory() {
    local directory="$1"
    local source_path

    [ -d "$directory" ] || return
    if ! directory_contains_leak_owned_source "$directory"; then
        runtime_roots+=("$directory")
        return
    fi

    while IFS= read -r source_path; do
        if ! is_leak_owned_source "$source_path"; then
            runtime_roots+=("$source_path")
        fi
    done < <(LC_ALL=C find "$directory" -type f -name '*.brp' -print | LC_ALL=C sort)
}

runtime_roots=()
for root in tests/test_blorp/*/ tests/test_std/*/; do
    append_runtime_directory "$root"
done
append_runtime_directory tests/test_pkg/
for source_path in tests/test_blorp/*.brp tests/test_std/*.brp; do
    if [ -f "$source_path" ] && ! is_leak_owned_source "$source_path"; then
        runtime_roots+=("$source_path")
    fi
done

compiler_core_sanitize_roots=()
while IFS= read -r root; do
    [ -n "$root" ] || continue
    compiler_core_sanitize_roots+=("$root")
done < scripts/compiler-core-sanitize-roots.txt

parallel_default_timeout() {
    local base_timeout="$1"
    local gate_count="$2"
    if [ -n "${BLORP_TEST_TIMEOUT:-}" ] || [ "$base_timeout" -eq 0 ]; then
        printf '%s\n' "$base_timeout"
    else
        printf '%s\n' $((base_timeout * gate_count))
    fi
}

# Background process tracking. Bash does not give us structured child cleanup,
# so keep this small and explicit: track the real worker PIDs and recursively
# terminate their descendants on interruption.
gate_pids=()
gate_names=()
gate_tmpdir=""

list_child_pids() {
    local parent="$1"
    if command -v pgrep >/dev/null 2>&1; then
        pgrep -P "$parent" 2>/dev/null || true
    else
        ps -o pid= -P "$parent" 2>/dev/null | tr -d ' ' || true
    fi
}

terminate_process_tree() {
    local pid="$1"
    local signal="${2:-TERM}"
    local child
    [ -n "$pid" ] || return 0

    for child in $(list_child_pids "$pid"); do
        terminate_process_tree "$child" "$signal"
    done
    kill -"$signal" "$pid" 2>/dev/null || true
}

wait_for_tracked_pids() {
    local pid
    for pid in "$@"; do
        [ -n "$pid" ] && wait "$pid" 2>/dev/null || true
    done
}

cleanup_gate_tmpdir() {
    if [ -n "$gate_tmpdir" ]; then
        rm -rf "$gate_tmpdir"
        gate_tmpdir=""
    fi
}

terminate_parallel_gates() {
    local pid
    if [ ${#gate_pids[@]} -gt 0 ]; then
        for pid in "${gate_pids[@]}"; do
            terminate_process_tree "$pid" TERM
        done
        sleep 1
        for pid in "${gate_pids[@]}"; do
            terminate_process_tree "$pid" KILL
        done
        wait_for_tracked_pids "${gate_pids[@]}"
        gate_pids=()
        gate_names=()
    fi
}

on_interrupt() {
    echo "" >&2
    echo "Interrupted; terminating test gates..." >&2
    trap - INT TERM EXIT
    terminate_parallel_gates
    cleanup_gate_tmpdir
    exit 130
}

trap on_interrupt INT TERM
trap cleanup_gate_tmpdir EXIT

build_seconds=0
if $skip_build; then
    build_seconds=0
else
    build_start_seconds=$(now_seconds)
    if ! make install; then
        build_seconds=$(elapsed_since "$build_start_seconds")
        echo "Error: compiler build failed; aborting test run." >&2
        exit 1
    fi
    build_seconds=$(elapsed_since "$build_start_seconds")
fi

# ─── Result tracking (bash 3.2 compatible) ──────────────────────────
# Each gate gets: _status, _passed, _failed, _tests, _failures (newline-separated list)
compiler_blorp_status="SKIP"; compiler_blorp_passed=0; compiler_blorp_failed=0; compiler_blorp_tests=0; compiler_blorp_failures=""
compiler_tools_status="SKIP"; compiler_tools_passed=0; compiler_tools_failed=0; compiler_tools_tests=0; compiler_tools_failures=""
compiler_core_sanitize_status="SKIP"; compiler_core_sanitize_passed=0; compiler_core_sanitize_failed=0; compiler_core_sanitize_tests=0; compiler_core_sanitize_failures=""
compiler_blorp_sanitize_status="SKIP"; compiler_blorp_sanitize_passed=0; compiler_blorp_sanitize_failed=0; compiler_blorp_sanitize_tests=0; compiler_blorp_sanitize_failures=""
std_check_status="SKIP"; std_check_passed=0; std_check_failed=0; std_check_tests=0; std_check_failures=""
runtime_status="SKIP"; runtime_passed=0; runtime_failed=0; runtime_tests=0; runtime_failures=""
leak_status="SKIP"; leak_passed=0; leak_failed=0; leak_tests=0; leak_failures=""
doctest_status="SKIP"; doctest_passed=0; doctest_failed=0; doctest_tests=0; doctest_failures=""
cli_status="SKIP"; cli_passed=0; cli_failed=0; cli_tests=0; cli_failures=""
cli_deep_status="SKIP"; cli_deep_passed=0; cli_deep_failed=0; cli_deep_tests=0; cli_deep_failures=""
lsp_status="SKIP"; lsp_passed=0; lsp_failed=0; lsp_tests=0; lsp_failures=""
package_status="SKIP"; package_passed=0; package_failed=0; package_tests=0; package_failures=""

compiler_blorp_seconds=0
compiler_tools_seconds=0
compiler_core_sanitize_seconds=0
compiler_blorp_sanitize_seconds=0
std_check_seconds=0
runtime_seconds=0
leak_seconds=0
doctest_seconds=0
cli_seconds=0
cli_deep_seconds=0
lsp_seconds=0
package_seconds=0

# ─── Parsers ────────────────────────────────────────────────────────

result_field() {
    local line="$1"
    local key="$2"
    printf '%s\n' "$line" | tr ' ' '\n' | sed -n "s/^${key}=//p" | tail -1
}

structured_gate_values_are_valid() {
    local status="$1"
    local passed="$2"
    local failed="$3"
    local tests="$4"
    local passed_number failed_number tests_number
    # Two accepted counts can be added without approaching Bash integer limits.
    local max_count_digits=9

    case "$passed" in ''|*[!0-9]*) return 1 ;; esac
    case "$failed" in ''|*[!0-9]*) return 1 ;; esac
    case "$tests" in ''|*[!0-9]*) return 1 ;; esac
    [ "${#passed}" -le "$max_count_digits" ] || return 1
    [ "${#failed}" -le "$max_count_digits" ] || return 1
    [ "${#tests}" -le "$max_count_digits" ] || return 1

    passed_number=$((10#$passed))
    failed_number=$((10#$failed))
    tests_number=$((10#$tests))
    [ $((passed_number + failed_number)) -eq "$tests_number" ] || return 1

    case "$status" in
        PASS) [ "$failed_number" -eq 0 ] ;;
        FAIL) [ "$failed_number" -gt 0 ] ;;
        *) return 1 ;;
    esac
}

parse_structured_gate_result() {
    local output="$1"
    local key="$2"
    local line status passed failed tests

    line=$(printf '%s\n' "$output" | grep "^BLORP_GATE_RESULT gate=$key " | tail -1)
    [ -n "$line" ] || return 1

    status=$(result_field "$line" status)
    passed=$(result_field "$line" passed)
    failed=$(result_field "$line" failed)
    tests=$(result_field "$line" tests)

    if ! structured_gate_values_are_valid "$status" "$passed" "$failed" "$tests"; then
        eval "${key}_status=FAIL"
        eval "${key}_passed=0"
        eval "${key}_failed=1"
        eval "${key}_tests=1"
        local message="$key gate reported an invalid structured result"
        eval "${key}_failures=\$message"
        return 0
    fi

    passed=$((10#$passed))
    failed=$((10#$failed))
    tests=$((10#$tests))

    eval "${key}_status=\$status"
    eval "${key}_passed=\$passed"
    eval "${key}_failed=\$failed"
    eval "${key}_tests=\$tests"
    return 0
}

append_gate_failure() {
    local key="$1"
    local message="$2"
    local current

    eval "current=\${${key}_failures}"
    if [ -n "$current" ]; then
        current="${current}
${message}"
    else
        current="$message"
    fi
    eval "${key}_failures=\$current"
}

mark_gate_process_failure() {
    local key="$1"
    local exit_code="$2"
    local current_status current_failed current_tests

    [ "$exit_code" = "0" ] && return 0

    eval "current_status=\${${key}_status}"
    eval "current_failed=\${${key}_failed}"
    eval "current_tests=\${${key}_tests}"
    current_status="${current_status:-unknown}"
    current_failed="${current_failed:-0}"
    current_tests="${current_tests:-0}"

    # A gate can report a structured PASS summary and still return nonzero if
    # the runner hits cleanup, timeout, or process-management trouble after
    # counting tests. CI must surface that as the same gate failure that drives
    # the final process exit, otherwise the table says PASS while Actions fails.
    eval "${key}_status=FAIL"
    if [ "$current_failed" -eq 0 ]; then
        eval "${key}_failed=1"
        eval "${key}_tests=$((current_tests + 1))"
        append_gate_failure "$key" "$key gate process exited with status $exit_code after reporting $current_status"
    fi
}

parse_blorp_output() {
    local output="$1"
    local key="$2"
	if parse_structured_gate_result "$output" "$key"; then
		if [ "$(eval echo "\$${key}_status")" = "FAIL" ]; then
			local fails
			fails=$(echo "$output" \
				| grep -E '^(FAIL:|[[:space:]]*\[FAIL\])' \
				| sed -E 's/^FAIL: *//; s/^[[:space:]]*\[FAIL\] *//')
			[ -n "$fails" ] && eval "${key}_failures=\$fails"
		fi
        return
    fi

    # "Results: 403 passed, 3 failed (3312 tests)" or "Results: 45 passed, 0 failed (0 tests, 718 doctests)"
    local summary
    summary=$(echo "$output" | grep '^Results:')
    if [ -z "$summary" ]; then
        eval "${key}_status=FAIL"
        eval "${key}_passed=0"
        eval "${key}_failed=1"
        eval "${key}_tests=1"
        local fails
        fails=$(echo "$output" | grep -E '^(Combined test compile failed|error:|\(C compilation failed\))' | head -1)
        [ -n "$fails" ] || fails="$key gate exited before reporting Results"
        eval "${key}_failures=\$fails"
        return
    fi

    local p f t
    p=$(echo "$summary" | grep -o '[0-9]* passed' | grep -o '[0-9]*')
    f=$(echo "$summary" | grep -o '[0-9]* failed' | grep -o '[0-9]*')
    # Total: sum all numbers inside parentheses (handles "0 tests, 718 doctests")
    t=$(echo "$summary" | sed 's/.*(\(.*\))/\1/' | grep -o '[0-9]*' | awk '{s+=$1} END {print s}')

    eval "${key}_passed=$p"
    eval "${key}_failed=$f"
    eval "${key}_tests=$t"
    if [ "$f" -eq 0 ]; then
        eval "${key}_status=PASS"
    else
        eval "${key}_status=FAIL"
        local fails
        fails=$(echo "$output" | grep "^FAIL:" | sed 's/^FAIL: *//')
        eval "${key}_failures=\$fails"
    fi
}

emit_combined_leak_result() {
    local suite_output="$1"
    local diag_output="$2"
    local suite_exit="$3"
    local diag_exit="$4"
    local suite_line diag_summary
    local suite_status suite_passed suite_failed suite_tests
    local diag_passed diag_failed diag_tests
    local passed failed tests status

    suite_line=$(printf '%s\n' "$suite_output" | grep "^BLORP_GATE_RESULT gate=leak " | tail -1)
    if [ -n "$suite_line" ]; then
        suite_status=$(result_field "$suite_line" status)
        suite_passed=$(result_field "$suite_line" passed)
        suite_failed=$(result_field "$suite_line" failed)
        suite_tests=$(result_field "$suite_line" tests)
    fi
    if ! structured_gate_values_are_valid "${suite_status:-}" \
        "${suite_passed:-}" "${suite_failed:-}" "${suite_tests:-}"
    then
        suite_status="FAIL"
        suite_passed=0
        suite_failed=1
        suite_tests=1
    else
        suite_passed=$((10#$suite_passed))
        suite_failed=$((10#$suite_failed))
        suite_tests=$((10#$suite_tests))
    fi

    if [ "$suite_exit" -ne 0 ]; then
        suite_status="FAIL"
        if [ "$suite_failed" -eq 0 ]; then
            suite_failed=1
            suite_tests=$((suite_passed + suite_failed))
        fi
    fi

    diag_summary=$(printf '%s\n' "$diag_output" | grep '^Diagnostic results: [0-9][0-9]* passed, [0-9][0-9]* failed$' | tail -1)
    if [ -n "$diag_summary" ]; then
        diag_passed=$(printf '%s\n' "$diag_summary" | sed -n 's/^Diagnostic results: \([0-9][0-9]*\) passed, \([0-9][0-9]*\) failed$/\1/p')
        diag_failed=$(printf '%s\n' "$diag_summary" | sed -n 's/^Diagnostic results: \([0-9][0-9]*\) passed, \([0-9][0-9]*\) failed$/\2/p')
        diag_tests=$((diag_passed + diag_failed))
    fi
    case "${diag_passed:-}:${diag_failed:-}:${diag_tests:-}" in
        [0-9]*:[0-9]*:[0-9]*) ;;
        *)
            diag_passed=0
            diag_failed=1
            diag_tests=1
            ;;
    esac

    if [ "$diag_exit" -ne 0 ] && [ "$diag_failed" -eq 0 ]; then
        diag_failed=1
        diag_tests=$((diag_passed + diag_failed))
    fi

    passed=$((suite_passed + diag_passed))
    failed=$((suite_failed + diag_failed))
    tests=$((suite_tests + diag_tests))
    status="PASS"
    if [ "$suite_status" != "PASS" ] || [ "$failed" -ne 0 ]; then
        status="FAIL"
    fi

    printf 'Results: %s passed, %s failed (%s leak checks)\n' "$passed" "$failed" "$tests"
    printf 'BLORP_GATE_RESULT gate=leak status=%s passed=%s failed=%s tests=%s\n' "$status" "$passed" "$failed" "$tests"
}

emit_aggregated_blorp_result() {
    local output="$1"
    local gate="$2"
    local expected_results="$3"
    local result_gate="${4:-$gate}"
    local line status passed failed tests
    local result_count=0
    local total_passed=0
    local total_failed=0
    local total_tests=0
    local aggregation_error=false

    while IFS= read -r line; do
        [ -n "$line" ] || continue
        status=$(result_field "$line" status)
        passed=$(result_field "$line" passed)
        failed=$(result_field "$line" failed)
        tests=$(result_field "$line" tests)
        if structured_gate_values_are_valid "$status" "$passed" "$failed" "$tests"; then
            total_passed=$((total_passed + 10#$passed))
            total_failed=$((total_failed + 10#$failed))
            total_tests=$((total_tests + 10#$tests))
        else
            total_failed=$((total_failed + 1))
            total_tests=$((total_tests + 1))
            aggregation_error=true
        fi
        result_count=$((result_count + 1))
    done < <(printf '%s\n' "$output" | grep "^BLORP_GATE_RESULT gate=$gate " || true)

    if [ "$result_count" -ne "$expected_results" ]; then
        total_failed=$((total_failed + 1))
        total_tests=$((total_tests + 1))
        aggregation_error=true
    fi

    if $aggregation_error; then
        printf 'FAIL: %s gate reported an invalid structured result\n' "$gate"
    fi
    status="PASS"
    if [ "$total_failed" -ne 0 ]; then
        status="FAIL"
    fi
    printf 'BLORP_GATE_RESULT gate=%s status=%s passed=%s failed=%s tests=%s\n' \
        "$result_gate" "$status" "$total_passed" "$total_failed" "$total_tests"
}

parse_cli_for_key() {
    local output="$1"
    local key="$2"
    local status failures message

    if parse_structured_gate_result "$output" "$key"; then
        eval "status=\$${key}_status"
        if [ "$status" = "FAIL" ]; then
            failures=$(echo "$output" | grep '^FAIL:' | sed 's/^FAIL: *//')
            [ -n "$failures" ] && eval "${key}_failures=\$failures"
        fi
        return
    fi

    local summary p f t
    summary=$(echo "$output" | grep '^Results:')
    if [ -z "$summary" ]; then
        eval "${key}_status=FAIL"
        eval "${key}_passed=0"
        eval "${key}_failed=1"
        eval "${key}_tests=1"
        message="${key} gate exited before reporting Results"
        eval "${key}_failures=\$message"
        return
    fi

    p=$(echo "$summary" | grep -o '[0-9]* passed' | grep -o '[0-9]*')
    f=$(echo "$summary" | grep -o '[0-9]* failed' | grep -o '[0-9]*')
    t=$(echo "$summary" | sed 's/.*(\(.*\))/\1/' | grep -o '[0-9]*' | head -1)

    eval "${key}_passed=\$p"
    eval "${key}_failed=\$f"
    eval "${key}_tests=\$t"
    if [ "$f" -eq 0 ]; then
        eval "${key}_status=PASS"
    else
        eval "${key}_status=FAIL"
        failures=$(echo "$output" | grep '^FAIL:' | sed 's/^FAIL: *//')
        eval "${key}_failures=\$failures"
    fi
}

parse_cli() {
    parse_cli_for_key "$1" "cli"
}

parse_cli_deep() {
    parse_cli_for_key "$1" "cli_deep"
}

capture_stream() {
    local output_file="$1"
    shift
    if $verbose; then
        "$@" 2>&1 | tee "$output_file"
        return ${PIPESTATUS[0]}
    else
        "$@" > "$output_file" 2>&1
        return $?
    fi
}

capture_stream_append() {
    local output_file="$1"
    local live="$2"
    shift 2
    if [ "$live" = "true" ]; then
        "$@" 2>&1 | tee -a "$output_file"
        return ${PIPESTATUS[0]}
    else
        "$@" >> "$output_file" 2>&1
        return $?
    fi
}

capture_stream_append_with_artifact_progress() {
    local output_file="$1"
    local live="$2"
    local command_status
    shift 2

    if [ "$live" = "true" ]; then
        capture_stream_append "$output_file" "$live" "$@"
        return $?
    fi

    "$@" 2>&1 | tee -a "$output_file" | while IFS= read -r line; do
        case "$line" in
            BLORP_TEST_ARTIFACT_START\ *|BLORP_TEST_ARTIFACT_SOURCE\ *|BLORP_TEST_ARTIFACT_RESULT\ *|BLORP_TEST_ARTIFACT_END\ *)
                printf '%s\n' "$line"
                ;;
        esac
    done
    command_status=${PIPESTATUS[0]}
    return "$command_status"
}

record_gate_log() {
    local gate="$1"
    local output_file="$2"
    if [ -n "$log_dir" ]; then
        cp "$output_file" "$log_dir/$gate.log"
    fi
}

print_blorp_test_timing_summary() {
    local output_file="$1"

    $timings || return 0
    grep -q '^BLORP_TEST_TIMING ' "$output_file" || return 0

    echo "Generated TestSuite phase totals:"
    awk '
        $1 == "BLORP_TEST_TIMING" {
            phase = ""
            duration = 0
            for (i = 2; i <= NF; i++) {
                split($i, field, "=")
                if (field[1] == "phase") phase = field[2]
                if (field[1] == "duration_ms") duration = field[2] + 0
            }
            if (phase != "") {
                count[phase]++
                total[phase] += duration
            }
        }
        END {
            phase_order = "discovery planning frontend_graph frontend_finalize graph_typecheck backend_emission core_pipeline pipeline host_c execution"
            phase_count = split(phase_order, phases, " ")
            for (i = 1; i <= phase_count; i++) {
                phase = phases[i]
                if (count[phase] > 0) {
                    printf "  %-16s %4d calls  %9.3fs\n", phase, count[phase], total[phase] / 1000.0
                }
            }
        }
    ' "$output_file"
    echo ""
}

print_failure_excerpt() {
    local gate="$1"
    local output_file="$2"
    local excerpt_file

    echo ""
    echo "Failure output for $gate:"
    excerpt_file=$(mktemp "${TMPDIR:-/tmp}/blorp_failure_excerpt.XXXXXX") || exit 1
    awk '
        /^(FAIL:|FAIL |[[:space:]]*\[FAIL\]|✗ |DETAIL|DETAIL:|error:|Error:|Fatal error:|warning:|Warning:|Combined test compile failed|\(C compilation failed\))/ {
            print
            after = 12
            shown = 1
            next
        }
        shown && after > 0 {
            print
            after--
        }
    ' "$output_file" | head -160 > "$excerpt_file"
    if [ -s "$excerpt_file" ]; then
        cat "$excerpt_file"
        echo ""
        echo "Terminal output:"
        tail -40 "$output_file"
    else
        tail -80 "$output_file"
    fi
    rm -f "$excerpt_file"
    if [ -n "$log_dir" ]; then
        echo "Full log: $log_dir/$gate.log"
    else
        echo "Re-run with --verbose for the full log."
    fi
}

maybe_print_failure_excerpt() {
    local gate="$1"
    local output_file="$2"
    local exit_code="$3"
    if [ "$exit_code" != "0" ] && ! $verbose; then
        print_failure_excerpt "$gate" "$output_file"
    fi
}

run_runtime_gate_commands() {
    local output_file="$1"
    local live="${2:-false}"
    local offset=0
    local invocation_count=0
    local command_status=0
    local exit_code=0
    local output

    while [ "$offset" -lt "${#runtime_roots[@]}" ]; do
        capture_stream_append "$output_file" "$live" \
            env BLORP_GATE_RESULT=runtime ./blorp test --suite --timeout "$test_timeout" \
            "${runtime_roots[@]:offset:runtime_roots_per_invocation}"
        command_status=$?
        if [ "$command_status" -ne 0 ]; then
            exit_code=$command_status
        fi
        invocation_count=$((invocation_count + 1))
        offset=$((offset + runtime_roots_per_invocation))
    done

    output=$(cat "$output_file")
    emit_aggregated_blorp_result "$output" "runtime" "$invocation_count" >> "$output_file"
    return "$exit_code"
}

select_compiler_blorp_test_roots() {
    local shard_index="${BLORP_COMPILER_TEST_SHARD_INDEX:-}"
    local shard_count="${BLORP_COMPILER_TEST_SHARD_COUNT:-}"
    local source_path source_position source_index source_size
    local total_source_count base_shard_size extra_source_count
    local shard_start shard_size
    local total_source_bytes=0 current_shard current_shard_bytes
    local remaining_bytes remaining_shards target_bytes before_delta after_delta after_bytes
    local inventory_file sorted_inventory_file
    local all_source_paths=()
    local all_source_sizes=()

    compiler_blorp_test_roots=()
    compiler_blorp_test_shard_summary=""
    compiler_blorp_test_shard_error=""

    if [ -z "$shard_index" ] && [ -z "$shard_count" ]; then
        compiler_blorp_test_roots=(compiler/tests/)
        return 0
    fi
    if [ -z "$shard_index" ] || [ -z "$shard_count" ]; then
        compiler_blorp_test_shard_error="compiler test shard index and count must be set together"
        return 2
    fi
    case "$shard_count" in
        0|0*|*[!0-9]*)
            compiler_blorp_test_shard_error="compiler test shard count must be a positive integer"
            return 2
            ;;
    esac
    case "$shard_index" in
        0|0*|*[!0-9]*)
            compiler_blorp_test_shard_error="compiler test shard index must be a positive integer"
            return 2
            ;;
    esac
    if [ "$shard_index" -gt "$shard_count" ]; then
        compiler_blorp_test_shard_error="compiler test shard index must be between 1 and $shard_count"
        return 2
    fi

    inventory_file=$(mktemp "${TMPDIR:-/tmp}/blorp_compiler_test_inventory.XXXXXX") || {
        compiler_blorp_test_shard_error="cannot create compiler test shard inventory"
        return 2
    }
    sorted_inventory_file=$(mktemp "${TMPDIR:-/tmp}/blorp_compiler_test_inventory_sorted.XXXXXX") || {
        rm -f "$inventory_file"
        compiler_blorp_test_shard_error="cannot create sorted compiler test shard inventory"
        return 2
    }
    if ! find compiler/tests -type f -name '*.brp' -print > "$inventory_file"; then
        rm -f "$inventory_file" "$sorted_inventory_file"
        compiler_blorp_test_shard_error="cannot discover compiler test shard sources"
        return 2
    fi
    if ! LC_ALL=C sort "$inventory_file" > "$sorted_inventory_file"; then
        rm -f "$inventory_file" "$sorted_inventory_file"
        compiler_blorp_test_shard_error="cannot sort compiler test shard sources"
        return 2
    fi

    while IFS= read -r source_path; do
        all_source_paths+=("$source_path")
        source_size=$(wc -c < "$source_path") || {
            rm -f "$inventory_file" "$sorted_inventory_file"
            compiler_blorp_test_shard_error="cannot read compiler test source size: $source_path"
            return 2
        }
        all_source_sizes+=("$source_size")
        total_source_bytes=$((total_source_bytes + source_size))
    done < "$sorted_inventory_file"
    rm -f "$inventory_file" "$sorted_inventory_file"

    total_source_count=${#all_source_paths[@]}
    if [ "$shard_count" -gt "$total_source_count" ]; then
        compiler_blorp_test_shard_error="compiler test shard $shard_index/$shard_count selected no sources"
        return 2
    fi

    if [ "$total_source_bytes" -eq 0 ]; then
        base_shard_size=$((total_source_count / shard_count))
        extra_source_count=$((total_source_count % shard_count))
        if [ "$shard_index" -le "$extra_source_count" ]; then
            shard_size=$((base_shard_size + 1))
            shard_start=$(((shard_index - 1) * shard_size))
        else
            shard_size=$base_shard_size
            shard_start=$((extra_source_count * (base_shard_size + 1) + (shard_index - extra_source_count - 1) * base_shard_size))
        fi

        source_position=0
        while [ "$source_position" -lt "$shard_size" ]; do
            source_index=$((shard_start + source_position))
            compiler_blorp_test_roots+=("${all_source_paths[$source_index]}")
            source_position=$((source_position + 1))
        done
    else
        current_shard=1
        current_shard_bytes=0
        remaining_bytes=$total_source_bytes
        remaining_shards=$shard_count
        source_index=0

        while [ "$source_index" -lt "$total_source_count" ]; do
            source_size=${all_source_sizes[$source_index]}
            target_bytes=$(((remaining_bytes + remaining_shards / 2) / remaining_shards))
            after_bytes=$((current_shard_bytes + source_size))
            before_delta=$((current_shard_bytes > target_bytes ? current_shard_bytes - target_bytes : target_bytes - current_shard_bytes))
            after_delta=$((after_bytes > target_bytes ? after_bytes - target_bytes : target_bytes - after_bytes))

            if [ "$current_shard_bytes" -gt 0 ] \
                && [ "$current_shard" -lt "$shard_count" ] \
                && [ "$before_delta" -lt "$after_delta" ] \
                && [ $((total_source_count - source_index)) -ge $((remaining_shards - 1)) ]; then
                remaining_bytes=$((remaining_bytes - current_shard_bytes))
                remaining_shards=$((remaining_shards - 1))
                current_shard=$((current_shard + 1))
                current_shard_bytes=0
            fi

            if [ "$current_shard" -eq "$shard_index" ]; then
                compiler_blorp_test_roots+=("${all_source_paths[$source_index]}")
            fi
            current_shard_bytes=$((current_shard_bytes + source_size))
            source_index=$((source_index + 1))
        done
    fi

    if [ ${#compiler_blorp_test_roots[@]} -eq 0 ]; then
        compiler_blorp_test_shard_error="compiler test shard $shard_index/$shard_count selected no sources"
        return 2
    fi

    compiler_blorp_test_shard_summary="Compiler Blorp source shard: $shard_index/$shard_count (${#compiler_blorp_test_roots[@]} files)"
    return 0
}

run_compiler_blorp_tests() {
    local output_file="$1"
    local live="${2:-false}"
    local result_gate="${3:-compiler_blorp_component}"

    if [ ! -d compiler/tests ]; then
        return 0
    fi

    {
        echo ""
        echo "═══ Compiler Blorp TestSuites (.brp) ═══"
        echo ""
    } >> "$output_file"

    if ! select_compiler_blorp_test_roots; then
        echo "Error: $compiler_blorp_test_shard_error" >&2
        echo "Error: $compiler_blorp_test_shard_error" >> "$output_file"
        return 2
    fi
    if [ -n "$compiler_blorp_test_shard_summary" ]; then
        echo "$compiler_blorp_test_shard_summary"
        echo "$compiler_blorp_test_shard_summary" >> "$output_file"
    fi

    if [ "${BLORP_COMPILER_TEST_PROGRESS:-0}" = "1" ]; then
        capture_stream_append_with_artifact_progress "$output_file" "$live" \
            env BLORP_GATE_RESULT="$result_gate" \
            ./blorp test --suite --maximal-artifacts \
            --timeout "$compiler_blorp_test_timeout" \
            "${compiler_blorp_test_roots[@]}"
    else
        capture_stream_append "$output_file" "$live" env BLORP_GATE_RESULT="$result_gate" \
            ./blorp test --suite --maximal-artifacts \
            --timeout "$compiler_blorp_test_timeout" \
            "${compiler_blorp_test_roots[@]}"
    fi
}

should_run_blorp_check_fixtures() {
    [ -z "${BLORP_COMPILER_TEST_SHARD_INDEX:-}" ] \
        || [ "${BLORP_COMPILER_TEST_SHARD_INDEX}" = "1" ]
}

run_compiler_blorp_gate_commands() {
    local output_file="$1"
    local live="${2:-false}"
    local suites_exit fixtures_exit expected_results output

    run_compiler_blorp_tests "$output_file" "$live" "compiler_blorp_component"
    suites_exit=$?
    fixtures_exit=0
    expected_results=1

    if should_run_blorp_check_fixtures; then
        {
            echo ""
            echo "═══ Production Blorp Check Fixtures (.brp) ═══"
            echo ""
        } >> "$output_file"
        capture_stream_append "$output_file" "$live" \
            python3 tests/test_compiler/run_blorp_check_fixtures.py \
                --blorp-bin ./blorp \
                --timeout "$compiler_blorp_test_timeout" \
                --expected-count "$expected_blorp_check_fixture_count" \
                --gate-name compiler_blorp_component
        fixtures_exit=$?
        expected_results=2
    fi

    output=$(cat "$output_file")
    emit_aggregated_blorp_result \
        "$output" "compiler_blorp_component" "$expected_results" \
        "compiler_blorp" >> "$output_file"

    if [ "$suites_exit" -ne 0 ]; then
        return "$suites_exit"
    fi
    return "$fixtures_exit"
}

run_compiler_tools_commands() {
    local output_file="$1"
    local live="${2:-false}"
    local args

    args=(
        --blorp-bin ./blorp
        --timeout "$compiler_blorp_test_timeout"
        --gate-name compiler_tools
    )
    if $verbose || [ -n "$log_dir" ]; then
        args+=(--verbose)
    fi
    capture_stream_append "$output_file" "$live" \
        env PYTHONDONTWRITEBYTECODE=1 \
        python3 tests/test_compiler/run_compiler_tool_fixtures.py "${args[@]}"
}

run_compiler_core_sanitize_commands() {
    local output_file="$1"
    local live="${2:-false}"

    capture_stream_append "$output_file" "$live" env BLORP_GATE_RESULT=compiler_core_sanitize \
        ./blorp test --sanitize --timeout "$compiler_sanitize_test_timeout" \
        "${compiler_core_sanitize_roots[@]}"
}

run_compiler_blorp_sanitize_commands() {
    local output_file="$1"
    local live="${2:-false}"

    capture_stream_append "$output_file" "$live" env BLORP_GATE_RESULT=compiler_blorp_sanitize \
        ./blorp test --sanitize --timeout "$compiler_sanitize_test_timeout" compiler/tests/
}

parse_std_check_gate_output() {
    local output="$1"
    if parse_structured_gate_result "$output" "std_check"; then
        if [ "$std_check_status" = "FAIL" ]; then
            local failures
            failures=$(echo "$output" | grep '^FAIL:' | sed 's/^FAIL: *//')
            [ -n "$failures" ] && std_check_failures="$failures"
        fi
        return
    fi

    std_check_status="FAIL"
    std_check_passed=0
    std_check_failed=1
    std_check_tests=1
    std_check_failures="std-check gate exited before reporting a summary"
}

run_std_check_gate_commands() {
    local output_file="$1"
    local checked std_root
    checked=$(find std -name '*.brp' | wc -l | tr -d ' ')
	std_root=$(CDPATH= cd -- std && pwd -P)

    if ./blorp check --no-format --std-dir "$std_root" "$std_root" >> "$output_file" 2>&1; then
        echo "PASS: std typecheck ($checked modules)" >> "$output_file"
        echo "BLORP_GATE_RESULT gate=std_check status=PASS passed=1 failed=0 tests=1" >> "$output_file"
        return 0
    fi

    echo "FAIL: std typecheck ($checked modules)" >> "$output_file"
    echo "BLORP_GATE_RESULT gate=std_check status=FAIL passed=0 failed=1 tests=1" >> "$output_file"
    return 1
}

record_lsp_gate_failure_if_missing() {
    local output_file="$1"
    local completed_suites="$2"

    # Protocol fixtures can report exact case counts. Preserve that result;
    # synthesize a suite-level failure only for plain unittest processes.
    if grep -q '^BLORP_GATE_RESULT gate=lsp status=FAIL ' "$output_file"; then
        return
    fi
    echo "BLORP_GATE_RESULT gate=lsp status=FAIL passed=$completed_suites failed=1 tests=$((completed_suites + 1))" >> "$output_file"
}

run_lsp_gate_commands() {
    local output_file="$1"
    local live="${2:-false}"
    local completed_suites=0

    if capture_stream_append "$output_file" "$live" \
        python3 tests/lsp/test_lsp_fixture_process.py; then
        completed_suites=$((completed_suites + 1))
    else
        record_lsp_gate_failure_if_missing "$output_file" "$completed_suites"
        return 1
    fi
    if capture_stream_append "$output_file" "$live" \
        python3 tests/lsp/test_lsp_native_baseline.py; then
        completed_suites=$((completed_suites + 1))
    else
        record_lsp_gate_failure_if_missing "$output_file" "$completed_suites"
        return 1
    fi
    if capture_stream_append "$output_file" "$live" \
        python3 tests/lsp/test_lsp_native_measurements.py; then
        completed_suites=$((completed_suites + 1))
    else
        record_lsp_gate_failure_if_missing "$output_file" "$completed_suites"
        return 1
    fi
    if capture_stream_append "$output_file" "$live" \
        python3 tests/lsp/test_lsp_native_runtime.py; then
        completed_suites=$((completed_suites + 1))
    else
        record_lsp_gate_failure_if_missing "$output_file" "$completed_suites"
        return 1
    fi
    if capture_stream_append "$output_file" "$live" \
        python3 tests/lsp/test_lsp_stdio_transport.py; then
        completed_suites=$((completed_suites + 1))
    else
        record_lsp_gate_failure_if_missing "$output_file" "$completed_suites"
        return 1
    fi
    if capture_stream_append "$output_file" "$live" env BLORP_LSP_STDIO_SANITIZE=1 \
        python3 tests/lsp/test_lsp_stdio_transport.py; then
        completed_suites=$((completed_suites + 1))
    else
        record_lsp_gate_failure_if_missing "$output_file" "$completed_suites"
        return 1
    fi

    local test_count
    test_count=$(awk '/^Ran [0-9]+ tests? in / { total += $2 } END { print total + 0 }' "$output_file")
    if ! grep -q '^BLORP_GATE_RESULT gate=lsp status=PASS ' "$output_file"; then
        echo "BLORP_GATE_RESULT gate=lsp status=PASS passed=$test_count failed=0 tests=$test_count" >> "$output_file"
    fi
}

