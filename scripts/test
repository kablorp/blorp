#!/bin/bash
# Run blorp test gates
#
# Usage:
#   scripts/test                    # Run default test gates
#   scripts/test compiler-unit      # Compiler-internal OCaml/Alcotest tests only
#   scripts/test compiler           # Fast compiler surface tests
#   scripts/test compiler-deep      # Full codegen audit + compiler/blorp TestSuites
#   scripts/test runtime            # Runtime .brp tests (language features)
#   scripts/test leak               # Focused --leak-check suites and leak diagnostics
#   scripts/test doctest            # Doctests only (std/ library)
#   scripts/test cli                # Public CLI, REPL, and LSP smoke checks
#   scripts/test compiler-unit compiler  # Multiple gates
#   scripts/test --serial           # Run selected gates one at a time
#   scripts/test --coverage         # Compiler-unit coverage report
#   scripts/test --verbose          # Print every child-runner line
#   scripts/test --log-dir logs     # Save premerge gate logs

script_dir="$(cd "$(dirname "$0")" && pwd -P)"
if [ "${BLORP_TEST_LOCK_HELD:-0}" != "1" ]; then
    export BLORP_TEST_LOCK_HELD=1
    exec "$script_dir/with-build-lock" "$script_dir/test" "$@"
fi

cd "$script_dir/.."

runner_label="scripts/test"
script_start_seconds=$(date +%s)
std_preflight_cache_version="blorp-std-preflight-v1"

now_seconds() {
    date +%s
}

elapsed_since() {
    local start="$1"
    local end
    end=$(now_seconds)
    echo $((end - start))
}

format_seconds() {
    local seconds="$1"
    if [ "$seconds" -lt 60 ]; then
        printf "%ds" "$seconds"
    else
        printf "%dm%02ds" $((seconds / 60)) $((seconds % 60))
    fi
}

hash_stream() {
    if command -v shasum >/dev/null 2>&1; then
        shasum -a 256
    elif command -v sha256sum >/dev/null 2>&1; then
        sha256sum
    else
        return 1
    fi
}

hash_stdin_key() {
    local output_file key
    output_file=$(mktemp "${TMPDIR:-/tmp}/blorp_hash.XXXXXX") || return 1
    if ! hash_stream > "$output_file"; then
        rm -f "$output_file"
        return 1
    fi
    key=$(awk '{print $1}' "$output_file")
    rm -f "$output_file"
    [ -n "$key" ] || return 1
    printf '%s\n' "$key"
}

hash_file() {
    local file="$1"
    if command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$file"
    elif command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$file"
    else
        return 1
    fi
}

hash_blorp_source_tree() {
    local root="$1"
    [ -d "$root" ] || return 0
    while IFS= read -r file; do
        hash_file "$file" || return 1
    done < <(find "$root" -name '*.brp' -type f | LC_ALL=C sort)
}

std_preflight_cache_key() {
    local input_file key
    input_file=$(mktemp "${TMPDIR:-/tmp}/blorp_std_preflight_key.XXXXXX") || return 1
    if ! {
        printf '%s\n' "$std_preflight_cache_version" &&
            printf 'BLORP_STD=%s\n' "${BLORP_STD:-}" &&
            hash_file ./blorp &&
            hash_blorp_source_tree std &&
            { [ -z "${BLORP_STD:-}" ] || hash_blorp_source_tree "$BLORP_STD"; }
    } > "$input_file"; then
        rm -f "$input_file"
        return 1
    fi
    key=$(hash_stdin_key < "$input_file") || {
        rm -f "$input_file"
        return 1
    }
    rm -f "$input_file"
    printf '%s\n' "$key"
}

std_preflight_cache_file() {
    local key="$1"
    local repo_key cache_root
    repo_key=$(printf '%s\n' "$(pwd -P)" | hash_stdin_key) || return 1
    cache_root="${TMPDIR:-/tmp}/blorp-std-preflight-${repo_key}"
    mkdir -p "$cache_root"
    printf '%s/%s.ok\n' "$cache_root" "$key"
}

usage() {
    echo "Usage: $runner_label [options] [compiler-unit] [compiler] [compiler-deep] [runtime] [leak] [doctest] [cli]"
    cat <<'EOF'

Options:
  --serial       Run selected gates one at a time.
  --coverage     Run compiler-unit tests with coverage instrumentation.
  --verbose      Stream full child-runner output, including passing tests.
  --quiet        Suppress passing-test output (default).
  --log-dir DIR  Copy each gate's full captured output into DIR.

Legacy aliases:
  unit           Alias for compiler-unit.
EOF
}

# Parse arguments
gates=()
coverage=false
serial=false
verbose=false
log_dir=""
while [ $# -gt 0 ]; do
    arg="$1"
    shift
    case "$arg" in
        --coverage) coverage=true ;;
        --serial) serial=true ;;
        --verbose) verbose=true ;;
        --quiet) verbose=false ;;
        --log-dir)
            if [ $# -eq 0 ]; then
                echo "Error: --log-dir requires a directory path." >&2
                usage
                exit 1
            fi
            log_dir="$1"
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        compiler-unit|unit) gates+=("unit") ;;
        compiler-deep) gates+=("compiler_deep") ;;
        compiler|runtime|leak|doctest|cli) gates+=("$arg") ;;
        *)
            echo "Unknown argument: $arg"
            usage
            exit 1
            ;;
    esac
done

# Default: run the normal local confidence gates. The full generated-C audit is
# available as compiler-deep and is included by scripts/premerge-gate.
if [ ${#gates[@]} -eq 0 ]; then
    gates=(unit compiler runtime leak doctest cli)
fi

if [ -n "$log_dir" ]; then
    mkdir -p "$log_dir"
fi

default_test_timeout=30
test_timeout="${BLORP_TEST_TIMEOUT:-$default_test_timeout}"
runtime_roots=()
for root in tests/test_blorp/ tests/test_std/ tests/test_pkg/; do
    if [ -d "$root" ]; then
        runtime_roots+=("$root")
    fi
done

leak_roots=(
    tests/test_blorp/memory/leak_check_baselines/
    tests/test_blorp/memory/*.brp
    tests/test_std/list/test_list_of_vectors.brp
    tests/test_std/list/test_list_pattern.brp
    tests/test_std/list/test_tailrec_list_pattern.brp
    tests/test_std/list/test_list_pipeline_fusion.brp
    tests/test_std/list/test_list_get_or_set_ir.brp
    tests/test_std/dict/test_dict_fold.brp
    tests/test_std/dict/test_dict_increment.brp
    tests/test_std/dict/test_dict_return_local_after_entries.brp
    tests/test_std/heap/test_heap_cow.brp
    tests/test_std/set/
    tests/test_blorp/text/test_string_ops.brp
    tests/test_blorp/text/test_string_ir.brp
    tests/test_blorp/numeric/test_vector_cow.brp
    tests/test_blorp/numeric/test_tensor_raw_view_cow.brp
    tests/test_blorp/numeric/test_matrix_builtins_alloc.brp
    tests/test_blorp/numeric/test_tensor_chained.brp
    tests/test_blorp/numeric/test_tensor_nested_loop.brp
    tests/test_blorp/concurrency/test_detached_channel_fanout_regression.brp
    tests/test_blorp/concurrency/test_task_result_alias.brp
    tests/test_blorp/sys/test_directory_resource.brp
    tests/test_blorp/sys/test_file_resource.brp
)

parallel_default_timeout() {
    local base_timeout="$1"
    local gate_count="$2"
    if [ -n "${BLORP_TEST_TIMEOUT:-}" ] || [ "$base_timeout" -eq 0 ]; then
        printf '%s\n' "$base_timeout"
    else
        printf '%s\n' $((base_timeout * gate_count))
    fi
}

# Background process tracking. Bash does not give us structured child cleanup,
# so keep this small and explicit: track the real worker PIDs and recursively
# terminate their descendants on interruption.
gate_pids=()
gate_names=()
gate_tmpdir=""
bridge_prepare_tmpdir=""

list_child_pids() {
    local parent="$1"
    if command -v pgrep >/dev/null 2>&1; then
        pgrep -P "$parent" 2>/dev/null || true
    else
        ps -o pid= -P "$parent" 2>/dev/null | tr -d ' ' || true
    fi
}

terminate_process_tree() {
    local pid="$1"
    local signal="${2:-TERM}"
    local child
    [ -n "$pid" ] || return 0

    for child in $(list_child_pids "$pid"); do
        terminate_process_tree "$child" "$signal"
    done
    kill -"$signal" "$pid" 2>/dev/null || true
}

wait_for_tracked_pids() {
    local pid
    for pid in "$@"; do
        [ -n "$pid" ] && wait "$pid" 2>/dev/null || true
    done
}

cleanup_gate_tmpdir() {
    if [ -n "$gate_tmpdir" ]; then
        rm -rf "$gate_tmpdir"
        gate_tmpdir=""
    fi
    if [ -n "$bridge_prepare_tmpdir" ]; then
        rm -rf "$bridge_prepare_tmpdir"
        bridge_prepare_tmpdir=""
    fi
}

terminate_parallel_gates() {
    local pid
    if [ ${#gate_pids[@]} -gt 0 ]; then
        for pid in "${gate_pids[@]}"; do
            terminate_process_tree "$pid" TERM
        done
        sleep 1
        for pid in "${gate_pids[@]}"; do
            terminate_process_tree "$pid" KILL
        done
        wait_for_tracked_pids "${gate_pids[@]}"
        gate_pids=()
        gate_names=()
    fi
}

on_interrupt() {
    echo "" >&2
    echo "Interrupted; terminating test gates..." >&2
    trap - INT TERM EXIT
    terminate_parallel_gates
    cleanup_gate_tmpdir
    exit 130
}

trap on_interrupt INT TERM
trap cleanup_gate_tmpdir EXIT

# Ensure compiler is built. If the rebuild fails, stop here; continuing with a
# stale ./blorp is worse than not running tests because it can hide strict
# typecheck failures behind old compiler behavior.
build_seconds=0
build_start_seconds=$(now_seconds)
if ! make --quiet 2>/dev/null; then
    if ! make; then
        build_seconds=$(elapsed_since "$build_start_seconds")
        echo "Error: compiler build failed; aborting test run." >&2
        exit 1
    fi
fi
build_seconds=$(elapsed_since "$build_start_seconds")

bridge_prepare_seconds=0
configure_compiler_bridge_environment() {
    local pinned_bridge_bin

    if [ -z "${BLORP_COMPILER_BRIDGE_CACHE_DIR:-}" ]; then
        if [ -n "${XDG_CACHE_HOME:-}" ]; then
            export BLORP_COMPILER_BRIDGE_CACHE_DIR="$XDG_CACHE_HOME/blorp/compiler-bridge"
        elif [ -n "${HOME:-}" ]; then
            export BLORP_COMPILER_BRIDGE_CACHE_DIR="$HOME/.cache/blorp/compiler-bridge"
        else
            export BLORP_COMPILER_BRIDGE_CACHE_DIR="${TMPDIR:-/tmp}/.cache/blorp/compiler-bridge"
        fi
    fi

    if [ -z "${BLORP_COMPILER_BRIDGE_BIN:-}" ]; then
        if ! pinned_bridge_bin=$("$script_dir/blorp-compiler-bootstrap" --print-path); then
            echo "Error: failed to resolve pinned Blorp compiler bootstrap." >&2
            exit 1
        fi
        export BLORP_COMPILER_BRIDGE_BIN="$pinned_bridge_bin"
    fi
}

prepare_compiler_bridge_helpers() {
    local prepare_dir prepare_output prepare_start_seconds name value

    if [ -n "${BLORP_COMPILER_RENDERER_BRIDGE_BIN:-}" ] && [ -n "${BLORP_COMPILER_PARSER_BRIDGE_BIN:-}" ]; then
        export BLORP_COMPILER_REQUIRE_PREPARED_BRIDGE=1
        bridge_prepare_seconds=0
        return 0
    fi

    prepare_start_seconds=$(now_seconds)
    if [ -n "${BLORP_COMPILER_BRIDGE_STARTUP_DIR:-}" ]; then
        prepare_dir="$BLORP_COMPILER_BRIDGE_STARTUP_DIR"
        mkdir -p "$prepare_dir"
    else
        bridge_prepare_tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/blorp_compiler_bridge.XXXXXX") || exit 1
        prepare_dir="$bridge_prepare_tmpdir"
    fi

    if ! prepare_output=$(./blorp __compiler-bridge-prepare "$prepare_dir" 2>&1); then
        bridge_prepare_seconds=$(elapsed_since "$prepare_start_seconds")
        echo "Error: failed to prepare Blorp compiler bridge helpers." >&2
        printf '%s\n' "$prepare_output" >&2
        exit 1
    fi

    while IFS='=' read -r name value; do
        case "$name" in
            BLORP_COMPILER_RENDERER_BRIDGE_BIN|BLORP_COMPILER_PARSER_BRIDGE_BIN)
                export "$name=$value"
                ;;
        esac
    done <<EOF
$prepare_output
EOF

    if [ -z "${BLORP_COMPILER_RENDERER_BRIDGE_BIN:-}" ] || [ -z "${BLORP_COMPILER_PARSER_BRIDGE_BIN:-}" ]; then
        bridge_prepare_seconds=$(elapsed_since "$prepare_start_seconds")
        echo "Error: bridge helper preparation did not report both helper binaries." >&2
        printf '%s\n' "$prepare_output" >&2
        exit 1
    fi

    export BLORP_COMPILER_REQUIRE_PREPARED_BRIDGE=1
    bridge_prepare_seconds=$(elapsed_since "$prepare_start_seconds")
}

needs_compiler_bridge_helpers=false
for gate in "${gates[@]}"; do
    case "$gate" in
        compiler_deep|runtime|leak|doctest|cli)
            needs_compiler_bridge_helpers=true
            ;;
    esac
done

if $needs_compiler_bridge_helpers; then
    configure_compiler_bridge_environment
    prepare_compiler_bridge_helpers
fi

# ─── Result tracking (bash 3.2 compatible) ──────────────────────────
# Each gate gets: _status, _passed, _failed, _tests, _failures (newline-separated list)
unit_status="SKIP"; unit_passed=0; unit_failed=0; unit_tests=0; unit_failures=""
compiler_status="SKIP"; compiler_passed=0; compiler_failed=0; compiler_tests=0; compiler_failures=""
compiler_deep_status="SKIP"; compiler_deep_passed=0; compiler_deep_failed=0; compiler_deep_tests=0; compiler_deep_failures=""
compiler_deep_tools_status="SKIP"; compiler_deep_tools_passed=0; compiler_deep_tools_failed=0; compiler_deep_tools_tests=0; compiler_deep_tools_failures=""
compiler_deep_blorp_status="SKIP"; compiler_deep_blorp_passed=0; compiler_deep_blorp_failed=0; compiler_deep_blorp_tests=0; compiler_deep_blorp_failures=""
runtime_status="SKIP"; runtime_passed=0; runtime_failed=0; runtime_tests=0; runtime_failures=""
leak_status="SKIP"; leak_passed=0; leak_failed=0; leak_tests=0; leak_failures=""
doctest_status="SKIP"; doctest_passed=0; doctest_failed=0; doctest_tests=0; doctest_failures=""
cli_status="SKIP"; cli_passed=0; cli_failed=0; cli_tests=0; cli_failures=""

unit_seconds=0
compiler_seconds=0
compiler_deep_seconds=0
runtime_seconds=0
leak_seconds=0
doctest_seconds=0
cli_seconds=0
std_preflight_seconds=0

# ─── Parsers ────────────────────────────────────────────────────────

result_field() {
    local line="$1"
    local key="$2"
    printf '%s\n' "$line" | tr ' ' '\n' | sed -n "s/^${key}=//p" | tail -1
}

parse_structured_gate_result() {
    local output="$1"
    local key="$2"
    local line status passed failed tests

    line=$(printf '%s\n' "$output" | grep "^BLORP_GATE_RESULT gate=$key " | tail -1)
    [ -n "$line" ] || return 1

    status=$(result_field "$line" status)
    passed=$(result_field "$line" passed)
    failed=$(result_field "$line" failed)
    tests=$(result_field "$line" tests)

    case "$status:$passed:$failed:$tests" in
        PASS:[0-9]*:[0-9]*:[0-9]*|FAIL:[0-9]*:[0-9]*:[0-9]*) ;;
        *) return 1 ;;
    esac

    eval "${key}_status=\$status"
    eval "${key}_passed=\$passed"
    eval "${key}_failed=\$failed"
    eval "${key}_tests=\$tests"
    return 0
}

append_gate_failure() {
    local key="$1"
    local message="$2"
    local current

    eval "current=\${${key}_failures}"
    if [ -n "$current" ]; then
        current="${current}
${message}"
    else
        current="$message"
    fi
    eval "${key}_failures=\$current"
}

mark_gate_process_failure() {
    local key="$1"
    local exit_code="$2"
    local current_status current_failed current_tests

    [ "$exit_code" = "0" ] && return 0

    eval "current_status=\${${key}_status}"
    eval "current_failed=\${${key}_failed}"
    eval "current_tests=\${${key}_tests}"
    current_status="${current_status:-unknown}"
    current_failed="${current_failed:-0}"
    current_tests="${current_tests:-0}"

    # A gate can report a structured PASS summary and still return nonzero if
    # the runner hits cleanup, timeout, or process-management trouble after
    # counting tests. CI must surface that as the same gate failure that drives
    # the final process exit, otherwise the table says PASS while Actions fails.
    eval "${key}_status=FAIL"
    if [ "$current_failed" -eq 0 ]; then
        eval "${key}_failed=1"
        eval "${key}_tests=$((current_tests + 1))"
        append_gate_failure "$key" "$key gate process exited with status $exit_code after reporting $current_status"
    fi
}

parse_unit() {
    local output="$1"
    # Alcotest:
    #   "Test Successful in 0.014s. 71 tests run."
    #   "6 failures! in 3.666s. 734 tests run."
    local tests_line failures_line tests failures
    tests_line=$(echo "$output" | grep -o '[0-9][0-9]* tests run' | tail -1)
    failures_line=$(echo "$output" | grep -o '[0-9][0-9]* failures!' | tail -1)
    tests=0
    failures=0

    if [ -n "$tests_line" ]; then
        tests="${tests_line%% *}"
    fi
    if [ -n "$failures_line" ]; then
        failures="${failures_line%% *}"
    fi

    if [ "$tests" -eq 0 ] && [ "$failures" -eq 0 ]; then
        unit_tests=1
        unit_failed=1
        unit_passed=0
    else
        unit_tests=$tests
        unit_failed=$failures
        unit_passed=$((tests - failures))
    fi
    if [ "$failures" -eq 0 ] && [ "$tests" -gt 0 ]; then
        unit_status="PASS"
    else
        unit_status="FAIL"
        unit_failures=$(echo "$output" | grep '\[FAIL\]' | sed -E 's/.*\[FAIL\][[:space:]]*//; s/[[:space:]]*│$//; s/[.]+$//')
    fi
}

parse_compiler() {
    local output="$1"
    if parse_structured_gate_result "$output" "compiler"; then
        if [ "$compiler_status" = "FAIL" ]; then
            compiler_failures=$(echo "$output" | grep -E '^(FAIL:|✗ \[)' | sed -e 's/^FAIL: *//' -e 's/^✗ //')
        fi
        return
    fi

    # "✓ All 500 compiler tests passed" or "✗ 490/500 compiler tests passed (10 failed)"
    local summary
    summary=$(echo "$output" | grep -E '(All [0-9]+ compiler|[0-9]+/[0-9]+ compiler)')
    if echo "$summary" | grep -q "All"; then
        local n
        n=$(echo "$summary" | grep -o 'All [0-9]*' | grep -o '[0-9]*')
        compiler_passed=$n
        compiler_tests=$n
        compiler_status="PASS"
    elif [ -n "$summary" ]; then
        compiler_passed=$(echo "$summary" | grep -o '[0-9]*/[0-9]*' | cut -d/ -f1)
        compiler_tests=$(echo "$summary" | grep -o '[0-9]*/[0-9]*' | cut -d/ -f2)
        compiler_failed=$(echo "$summary" | grep -o '([0-9]* failed)' | grep -o '[0-9]*')
        compiler_status="FAIL"
        compiler_failures=$(echo "$output" | grep -E '^(FAIL:|✗ \[)' | sed -e 's/^FAIL: *//' -e 's/^✗ //')
    else
        compiler_status="FAIL"
        compiler_passed=0
        compiler_failed=1
        compiler_tests=1
        compiler_failures="compiler gate exited before reporting a summary"
    fi
}

parse_codegen_audit() {
    local output="$1"
    local key="$2"
    local summary p f

    summary=$(echo "$output" | grep '^Results: [0-9][0-9]* passed, [0-9][0-9]* failed$' | tail -1)
    if [ -z "$summary" ]; then
        eval "${key}_status=FAIL"
        eval "${key}_passed=0"
        eval "${key}_failed=1"
        eval "${key}_tests=1"
        local fails
        fails=$(echo "$output" | grep '^FAIL:' | sed 's/^FAIL: *//' | head -20)
        [ -n "$fails" ] || fails="$key gate exited before reporting Results"
        eval "${key}_failures=\$fails"
        return
    fi

    p=$(echo "$summary" | sed -n 's/^Results: \([0-9][0-9]*\) passed, \([0-9][0-9]*\) failed$/\1/p')
    f=$(echo "$summary" | sed -n 's/^Results: \([0-9][0-9]*\) passed, \([0-9][0-9]*\) failed$/\2/p')

    eval "${key}_passed=$p"
    eval "${key}_failed=$f"
    eval "${key}_tests=$((p + f))"
    if [ "$f" -eq 0 ]; then
        eval "${key}_status=PASS"
    else
        eval "${key}_status=FAIL"
        local fails
        fails=$(echo "$output" | grep '^FAIL:' | sed 's/^FAIL: *//')
        eval "${key}_failures=\$fails"
    fi
}

parse_blorp_output() {
    local output="$1"
    local key="$2"
    if parse_structured_gate_result "$output" "$key"; then
        if [ "$(eval echo "\$${key}_status")" = "FAIL" ]; then
            local fails
            fails=$(echo "$output" | grep "^FAIL:" | sed 's/^FAIL: *//')
            eval "${key}_failures=\$fails"
        fi
        return
    fi

    # "Results: 403 passed, 3 failed (3312 tests)" or "Results: 45 passed, 0 failed (0 tests, 718 doctests)"
    local summary
    summary=$(echo "$output" | grep '^Results:')
    if [ -z "$summary" ]; then
        eval "${key}_status=FAIL"
        eval "${key}_passed=0"
        eval "${key}_failed=1"
        eval "${key}_tests=1"
        local fails
        fails=$(echo "$output" | grep -E '^(Combined test compile failed|error:|\(C compilation failed\))' | head -1)
        [ -n "$fails" ] || fails="$key gate exited before reporting Results"
        eval "${key}_failures=\$fails"
        return
    fi

    local p f t
    p=$(echo "$summary" | grep -o '[0-9]* passed' | grep -o '[0-9]*')
    f=$(echo "$summary" | grep -o '[0-9]* failed' | grep -o '[0-9]*')
    # Total: sum all numbers inside parentheses (handles "0 tests, 718 doctests")
    t=$(echo "$summary" | sed 's/.*(\(.*\))/\1/' | grep -o '[0-9]*' | awk '{s+=$1} END {print s}')

    eval "${key}_passed=$p"
    eval "${key}_failed=$f"
    eval "${key}_tests=$t"
    if [ "$f" -eq 0 ]; then
        eval "${key}_status=PASS"
    else
        eval "${key}_status=FAIL"
        local fails
        fails=$(echo "$output" | grep "^FAIL:" | sed 's/^FAIL: *//')
        eval "${key}_failures=\$fails"
    fi
}

emit_combined_leak_result() {
    local suite_output="$1"
    local diag_output="$2"
    local suite_exit="$3"
    local diag_exit="$4"
    local suite_line diag_summary
    local suite_status suite_passed suite_failed suite_tests
    local diag_passed diag_failed diag_tests
    local passed failed tests status

    suite_line=$(printf '%s\n' "$suite_output" | grep "^BLORP_GATE_RESULT gate=leak " | tail -1)
    if [ -n "$suite_line" ]; then
        suite_status=$(result_field "$suite_line" status)
        suite_passed=$(result_field "$suite_line" passed)
        suite_failed=$(result_field "$suite_line" failed)
        suite_tests=$(result_field "$suite_line" tests)
    fi
    case "${suite_status:-}:${suite_passed:-}:${suite_failed:-}:${suite_tests:-}" in
        PASS:[0-9]*:[0-9]*:[0-9]*|FAIL:[0-9]*:[0-9]*:[0-9]*) ;;
        *)
            suite_status="FAIL"
            suite_passed=0
            suite_failed=1
            suite_tests=1
            ;;
    esac

    if [ "$suite_exit" -ne 0 ]; then
        suite_status="FAIL"
        if [ "$suite_failed" -eq 0 ]; then
            suite_failed=1
            suite_tests=$((suite_passed + suite_failed))
        fi
    fi

    diag_summary=$(printf '%s\n' "$diag_output" | grep '^Results: [0-9][0-9]* passed, [0-9][0-9]* failed$' | tail -1)
    if [ -n "$diag_summary" ]; then
        diag_passed=$(printf '%s\n' "$diag_summary" | sed -n 's/^Results: \([0-9][0-9]*\) passed, \([0-9][0-9]*\) failed$/\1/p')
        diag_failed=$(printf '%s\n' "$diag_summary" | sed -n 's/^Results: \([0-9][0-9]*\) passed, \([0-9][0-9]*\) failed$/\2/p')
        diag_tests=$((diag_passed + diag_failed))
    fi
    case "${diag_passed:-}:${diag_failed:-}:${diag_tests:-}" in
        [0-9]*:[0-9]*:[0-9]*) ;;
        *)
            diag_passed=0
            diag_failed=1
            diag_tests=1
            ;;
    esac

    if [ "$diag_exit" -ne 0 ] && [ "$diag_failed" -eq 0 ]; then
        diag_failed=1
        diag_tests=$((diag_passed + diag_failed))
    fi

    passed=$((suite_passed + diag_passed))
    failed=$((suite_failed + diag_failed))
    tests=$((suite_tests + diag_tests))
    status="PASS"
    if [ "$suite_status" != "PASS" ] || [ "$failed" -ne 0 ]; then
        status="FAIL"
    fi

    printf 'BLORP_GATE_RESULT gate=leak status=%s passed=%s failed=%s tests=%s\n' "$status" "$passed" "$failed" "$tests"
}

parse_compiler_deep_gate_output() {
    local output="$1"

    parse_codegen_audit "$output" "compiler_deep"
    if echo "$output" | grep -q '^BLORP_GATE_RESULT gate=compiler_deep_tools '; then
        compiler_deep_tools_status="SKIP"
        compiler_deep_tools_passed=0
        compiler_deep_tools_failed=0
        compiler_deep_tools_tests=0
        compiler_deep_tools_failures=""
        parse_structured_gate_result "$output" "compiler_deep_tools"
        if [ "$compiler_deep_tools_status" = "FAIL" ]; then
            compiler_deep_tools_failures=$(echo "$output" | grep '^FAIL:' | sed 's/^FAIL: *//')
        fi
        compiler_deep_passed=$((compiler_deep_passed + compiler_deep_tools_passed))
        compiler_deep_failed=$((compiler_deep_failed + compiler_deep_tools_failed))
        compiler_deep_tests=$((compiler_deep_tests + compiler_deep_tools_tests))
        if [ "$compiler_deep_tools_status" = "FAIL" ]; then
            compiler_deep_status="FAIL"
            if [ -n "$compiler_deep_failures" ] && [ -n "$compiler_deep_tools_failures" ]; then
                compiler_deep_failures="${compiler_deep_failures}
${compiler_deep_tools_failures}"
            elif [ -n "$compiler_deep_tools_failures" ]; then
                compiler_deep_failures="$compiler_deep_tools_failures"
            fi
        fi
    fi
    if echo "$output" | grep -q '^BLORP_GATE_RESULT gate=compiler_deep_blorp '; then
        compiler_deep_blorp_status="SKIP"
        compiler_deep_blorp_passed=0
        compiler_deep_blorp_failed=0
        compiler_deep_blorp_tests=0
        compiler_deep_blorp_failures=""
        parse_blorp_output "$output" "compiler_deep_blorp"
        compiler_deep_passed=$((compiler_deep_passed + compiler_deep_blorp_passed))
        compiler_deep_failed=$((compiler_deep_failed + compiler_deep_blorp_failed))
        compiler_deep_tests=$((compiler_deep_tests + compiler_deep_blorp_tests))
        if [ "$compiler_deep_blorp_status" = "FAIL" ]; then
            compiler_deep_status="FAIL"
            if [ -n "$compiler_deep_failures" ] && [ -n "$compiler_deep_blorp_failures" ]; then
                compiler_deep_failures="${compiler_deep_failures}
${compiler_deep_blorp_failures}"
            elif [ -n "$compiler_deep_blorp_failures" ]; then
                compiler_deep_failures="$compiler_deep_blorp_failures"
            fi
        fi
    fi
}

parse_cli() {
    local output="$1"
    if parse_structured_gate_result "$output" "cli"; then
        if [ "$cli_status" = "FAIL" ]; then
            cli_failures=$(echo "$output" | grep '^FAIL:' | sed 's/^FAIL: *//')
        fi
        return
    fi

    local summary p f t
    summary=$(echo "$output" | grep '^Results:')
    if [ -z "$summary" ]; then
        cli_status="FAIL"
        cli_passed=0
        cli_failed=1
        cli_tests=1
        cli_failures="cli gate exited before reporting Results"
        return
    fi

    p=$(echo "$summary" | grep -o '[0-9]* passed' | grep -o '[0-9]*')
    f=$(echo "$summary" | grep -o '[0-9]* failed' | grep -o '[0-9]*')
    t=$(echo "$summary" | sed 's/.*(\(.*\))/\1/' | grep -o '[0-9]*' | head -1)

    cli_passed=$p
    cli_failed=$f
    cli_tests=$t
    if [ "$f" -eq 0 ]; then
        cli_status="PASS"
    else
        cli_status="FAIL"
        cli_failures=$(echo "$output" | grep '^FAIL:' | sed 's/^FAIL: *//')
    fi
}

capture_stream() {
    local output_file="$1"
    shift
    if $verbose; then
        "$@" 2>&1 | tee "$output_file"
        return ${PIPESTATUS[0]}
    else
        "$@" > "$output_file" 2>&1
        return $?
    fi
}

capture_stream_append() {
    local output_file="$1"
    local live="$2"
    shift 2
    if [ "$live" = "true" ]; then
        "$@" 2>&1 | tee -a "$output_file"
        return ${PIPESTATUS[0]}
    else
        "$@" >> "$output_file" 2>&1
        return $?
    fi
}

record_gate_log() {
    local gate="$1"
    local output_file="$2"
    if [ -n "$log_dir" ]; then
        cp "$output_file" "$log_dir/$gate.log"
    fi
}

print_failure_excerpt() {
    local gate="$1"
    local output_file="$2"
    local excerpt_file

    echo ""
    echo "Failure output for $gate:"
    excerpt_file=$(mktemp "${TMPDIR:-/tmp}/blorp_failure_excerpt.XXXXXX") || exit 1
    awk '
        /^(FAIL:|FAIL |✗ |DETAIL|DETAIL:|error:|Error:|Fatal error:|warning:|Warning:|Combined test compile failed|\(C compilation failed\))/ {
            print
            after = 12
            shown = 1
            next
        }
        shown && after > 0 {
            print
            after--
        }
    ' "$output_file" | head -160 > "$excerpt_file"
    if [ -s "$excerpt_file" ]; then
        cat "$excerpt_file"
    else
        sed -n '1,40p' "$output_file"
    fi
    rm -f "$excerpt_file"
    if [ -n "$log_dir" ]; then
        echo "Full log: $log_dir/$gate.log"
    else
        echo "Re-run with --verbose for the full log."
    fi
}

maybe_print_failure_excerpt() {
    local gate="$1"
    local output_file="$2"
    local exit_code="$3"
    if [ "$exit_code" != "0" ] && ! $verbose; then
        print_failure_excerpt "$gate" "$output_file"
    fi
}

run_compiler_gate_commands() {
    local output_file="$1"
    local live="${2:-false}"
    local include_codegen_audit="${3:-false}"
    local args

    args=()

    if $verbose || [ -n "$log_dir" ]; then
        args+=(--verbose)
    else
        args+=(--quiet)
    fi
    if [ "$include_codegen_audit" != "true" ]; then
        args+=(--no-codegen-audit)
    fi
    args+=(--no-tool-fixtures)
    capture_stream_append "$output_file" "$live" tests/test_compiler/run_compiler_tests.sh "${args[@]}"
    return $?
}

run_compiler_tool_fixtures() {
    local output_file="$1"
    local live="${2:-false}"
    local args

    args=(--only-tool-fixtures --no-codegen-audit --gate-name compiler_deep_tools)
    if $verbose || [ -n "$log_dir" ]; then
        args+=(--verbose)
    else
        args+=(--quiet)
    fi

    {
        echo ""
        echo "═══ Compiler Tool Fixtures (format/purify) ═══"
        echo ""
    } >> "$output_file"
    capture_stream_append "$output_file" "$live" tests/test_compiler/run_compiler_tests.sh "${args[@]}"
}

run_compiler_blorp_tests() {
    local output_file="$1"
    local live="${2:-false}"
    local result_gate="${3:-compiler_deep_blorp}"

    if [ ! -d compiler/blorp/tests ]; then
        return 0
    fi

    {
        echo ""
        echo "═══ Compiler Blorp TestSuites (.brp) ═══"
        echo ""
    } >> "$output_file"
    capture_stream_append "$output_file" "$live" env BLORP_GATE_RESULT="$result_gate" ./blorp test --no-format --timeout "$test_timeout" compiler/blorp/tests/
}

run_compiler_deep_gate_commands() {
    local output_file="$1"
    local live="${2:-false}"
    local codegen_audit codegen_exit tools_exit blorp_exit

    codegen_audit="tests/test_compiler/codegen_audit/run_codegen_audit.sh"
    if [ -x "$codegen_audit" ]; then
        capture_stream_append "$output_file" "$live" "$codegen_audit" ./blorp
        codegen_exit=$?
    else
        {
            echo "FAIL: missing runner: $codegen_audit"
            echo ""
            echo "Results: 0 passed, 1 failed"
        } >> "$output_file"
        return 1
    fi

    if [ "$codegen_exit" -ne 0 ]; then
        return "$codegen_exit"
    fi

    run_compiler_tool_fixtures "$output_file" "$live"
    tools_exit=$?
    if [ "$tools_exit" -ne 0 ]; then
        return "$tools_exit"
    fi

    run_compiler_blorp_tests "$output_file" "$live" "compiler_deep_blorp"
    blorp_exit=$?
    if [ "$blorp_exit" -ne 0 ]; then
        return "$blorp_exit"
    fi

    return 0
}

parse_compiler_gate_output() {
    local output="$1"

    parse_compiler "$output"
}

run_std_typecheck_preflight() {
    echo "═══ Std Typecheck Preflight ═══"
    echo ""

    local checked output_file start_seconds cache_key cache_file tmp_cache_file
    start_seconds=$(now_seconds)
    checked=$(find std -name '*.brp' | wc -l | tr -d ' ')

    if [ "${BLORP_TEST_PREFLIGHT_CACHE:-1}" != "0" ]; then
        cache_key=$(std_preflight_cache_key || true)
        if [ -n "$cache_key" ]; then
            cache_file=$(std_preflight_cache_file "$cache_key")
            if [ -f "$cache_file" ]; then
                std_preflight_seconds=$(elapsed_since "$start_seconds")
                echo "Std typecheck preflight cached ($checked modules, $(format_seconds "$std_preflight_seconds"))."
                echo ""
                return 0
            fi
        fi
    fi

    output_file=$(mktemp "${TMPDIR:-/tmp}/blorp_std_typecheck.XXXXXX") || exit 1

    if ! {
        ./blorp check --no-format std
    } > "$output_file" 2>&1; then
        std_preflight_seconds=$(elapsed_since "$start_seconds")
        echo "FAIL: std typecheck preflight"
        sed -n '1,80p' "$output_file"
        rm -f "$output_file"
        return 1
    fi

    std_preflight_seconds=$(elapsed_since "$start_seconds")
    if [ -n "${cache_file:-}" ]; then
        tmp_cache_file="${cache_file}.$$"
        printf 'ok\nmodules=%s\n' "$checked" > "$tmp_cache_file"
        mv "$tmp_cache_file" "$cache_file"
    fi
    rm -f "$output_file"
    echo "Std typecheck preflight passed ($checked modules, $(format_seconds "$std_preflight_seconds"))."
    echo ""
    return 0
}

needs_std_typecheck_preflight=false
for gate in "${gates[@]}"; do
    case "$gate" in
        compiler_deep|runtime|leak|doctest)
            needs_std_typecheck_preflight=true
            ;;
    esac
done

if $needs_std_typecheck_preflight; then
    run_std_typecheck_preflight || exit 1
fi

# ─── Gate runners ───────────────────────────────────────────────────

run_unit() {
    echo "═══ Compiler Unit Tests (OCaml/Alcotest) ═══"
    echo ""
    local output exit_code output_file start_seconds
    start_seconds=$(now_seconds)
    output_file=$(mktemp "${TMPDIR:-/tmp}/blorp_unit.XXXXXX") || exit 1
    if $coverage; then
        capture_stream "$output_file" make coverage
        exit_code=$?
    else
        capture_stream "$output_file" bash -c 'cd compiler && dune runtest --force'
        exit_code=$?
    fi
    output=$(cat "$output_file")
    record_gate_log "compiler-unit" "$output_file"
    maybe_print_failure_excerpt "compiler-unit" "$output_file" "$exit_code"
    rm -f "$output_file"
    unit_seconds=$(elapsed_since "$start_seconds")
    echo ""
    parse_unit "$output"
    mark_gate_process_failure "unit" "$exit_code"
    return $exit_code
}

run_compiler() {
    echo "═══ Compiler Tests (fast fixtures) ═══"
    echo ""
    local output exit_code output_file start_seconds
    start_seconds=$(now_seconds)
    output_file=$(mktemp "${TMPDIR:-/tmp}/blorp_compiler.XXXXXX") || exit 1
    : > "$output_file"
    run_compiler_gate_commands "$output_file" "$verbose"
    exit_code=$?
    output=$(cat "$output_file")
    record_gate_log "compiler" "$output_file"
    maybe_print_failure_excerpt "compiler" "$output_file" "$exit_code"
    rm -f "$output_file"
    compiler_seconds=$(elapsed_since "$start_seconds")
    echo ""
    parse_compiler_gate_output "$output"
    mark_gate_process_failure "compiler" "$exit_code"
    return $exit_code
}

run_compiler_deep() {
    echo "═══ Compiler Deep Tests (codegen audit + compiler/blorp) ═══"
    echo ""
    local output exit_code output_file start_seconds
    start_seconds=$(now_seconds)
    output_file=$(mktemp "${TMPDIR:-/tmp}/blorp_compiler_deep.XXXXXX") || exit 1
    : > "$output_file"
    run_compiler_deep_gate_commands "$output_file" "$verbose"
    exit_code=$?
    output=$(cat "$output_file")
    record_gate_log "compiler-deep" "$output_file"
    maybe_print_failure_excerpt "compiler-deep" "$output_file" "$exit_code"
    rm -f "$output_file"
    compiler_deep_seconds=$(elapsed_since "$start_seconds")
    echo ""
    parse_compiler_deep_gate_output "$output"
    mark_gate_process_failure "compiler_deep" "$exit_code"
    return $exit_code
}

run_runtime() {
    echo "═══ Runtime Tests (.brp) ═══"
    echo ""
    local output exit_code output_file start_seconds
    start_seconds=$(now_seconds)
    output_file=$(mktemp "${TMPDIR:-/tmp}/blorp_runtime.XXXXXX") || exit 1
    capture_stream "$output_file" env BLORP_GATE_RESULT=runtime ./blorp test --no-format --timeout "$test_timeout" "${runtime_roots[@]}"
    exit_code=$?
    output=$(cat "$output_file")
    record_gate_log "runtime" "$output_file"
    maybe_print_failure_excerpt "runtime" "$output_file" "$exit_code"
    rm -f "$output_file"
    runtime_seconds=$(elapsed_since "$start_seconds")
    echo ""
    parse_blorp_output "$output" "runtime"
    mark_gate_process_failure "runtime" "$exit_code"
    return $exit_code
}

run_leak() {
    echo "═══ Leak-Check Ownership Suites + Diagnostics ═══"
    echo ""
    local output exit_code output_file diag_output_file start_seconds
    local suite_exit diag_exit suite_output diag_output
    start_seconds=$(now_seconds)
    output_file=$(mktemp "${TMPDIR:-/tmp}/blorp_leak.XXXXXX") || exit 1
    diag_output_file=$(mktemp "${TMPDIR:-/tmp}/blorp_leak_diag.XXXXXX") || {
        rm -f "$output_file"
        exit 1
    }
    if $verbose; then
        env BLORP_GATE_RESULT=leak ./blorp test --no-format --leak-check --suite --timeout "$test_timeout" "${leak_roots[@]}" 2>&1 | tee "$output_file"
        suite_exit=${PIPESTATUS[0]}
        suite_output=$(cat "$output_file")
        tests/test_leak_report.sh 2>&1 | tee "$diag_output_file"
        diag_exit=${PIPESTATUS[0]}
        diag_output=$(cat "$diag_output_file")
        cat "$diag_output_file" >> "$output_file"
    else
        env BLORP_GATE_RESULT=leak ./blorp test --no-format --leak-check --suite --timeout "$test_timeout" "${leak_roots[@]}" > "$output_file" 2>&1
        suite_exit=$?
        suite_output=$(cat "$output_file")
        tests/test_leak_report.sh > "$diag_output_file" 2>&1
        diag_exit=$?
        diag_output=$(cat "$diag_output_file")
        cat "$diag_output_file" >> "$output_file"
    fi
    emit_combined_leak_result "$suite_output" "$diag_output" "$suite_exit" "$diag_exit" >> "$output_file"
    if [ "$suite_exit" -eq 0 ] && [ "$diag_exit" -eq 0 ]; then
        exit_code=0
    else
        exit_code=1
    fi
    output=$(cat "$output_file")
    record_gate_log "leak" "$output_file"
    maybe_print_failure_excerpt "leak" "$output_file" "$exit_code"
    rm -f "$output_file" "$diag_output_file"
    leak_seconds=$(elapsed_since "$start_seconds")
    echo ""
    parse_blorp_output "$output" "leak"
    mark_gate_process_failure "leak" "$exit_code"
    return $exit_code
}

run_doctest() {
    echo "═══ Doctests (std/) ═══"
    echo ""
    local output exit_code output_file start_seconds
    start_seconds=$(now_seconds)
    output_file=$(mktemp "${TMPDIR:-/tmp}/blorp_doctest.XXXXXX") || exit 1
    capture_stream "$output_file" env BLORP_GATE_RESULT=doctest ./blorp test --no-format --doc --timeout "$test_timeout" std/
    exit_code=$?
    output=$(cat "$output_file")
    record_gate_log "doctest" "$output_file"
    maybe_print_failure_excerpt "doctest" "$output_file" "$exit_code"
    rm -f "$output_file"
    doctest_seconds=$(elapsed_since "$start_seconds")
    echo ""
    parse_blorp_output "$output" "doctest"
    mark_gate_process_failure "doctest" "$exit_code"
    return $exit_code
}

run_cli() {
    echo "═══ CLI Smoke / Exit Codes ═══"
    echo ""
    local output exit_code output_file start_seconds
    start_seconds=$(now_seconds)
    output_file=$(mktemp "${TMPDIR:-/tmp}/blorp_cli.XXXXXX") || exit 1
    capture_stream "$output_file" env BLORP_CLI_TEST_TIMEOUT="${BLORP_CLI_TEST_TIMEOUT:-$test_timeout}" tests/test_cli.sh
    exit_code=$?
    output=$(cat "$output_file")
    record_gate_log "cli" "$output_file"
    maybe_print_failure_excerpt "cli" "$output_file" "$exit_code"
    rm -f "$output_file"
    cli_seconds=$(elapsed_since "$start_seconds")
    echo ""
    parse_cli "$output"
    mark_gate_process_failure "cli" "$exit_code"
    return $exit_code
}

# ─── Run gates ─────────────────────────────────────────────────────

any_failed=false
parallel_gates=("${gates[@]}")

# When running multiple gates, run them in parallel for speed unless --serial is
# set. CI uses serial mode so per-test timeouts are not distorted by concurrent
# generated-C compiles and other gate-level load.
# Each gate's output is captured for summary parsing; --verbose prints it back.
if [ ${#parallel_gates[@]} -eq 0 ]; then
    :
elif $serial || [ ${#parallel_gates[@]} -le 1 ]; then
    # Single-gate and serial mode: run directly; gate runners self-capture.
    for gate in "${parallel_gates[@]}"; do
        case "$gate" in
            unit)     run_unit     || any_failed=true ;;
            compiler) run_compiler || any_failed=true ;;
            compiler_deep) run_compiler_deep || any_failed=true ;;
            runtime)  run_runtime  || any_failed=true ;;
            leak)     run_leak     || any_failed=true ;;
            doctest)  run_doctest  || any_failed=true ;;
            cli)      run_cli      || any_failed=true ;;
        esac
    done
else
    # Multiple gates: run in parallel, collect results.
    # Pre-warm the precompiled runtime cache to prevent race conditions
    # between parallel gate runners that both call precompile_runtime().
    if ! ./blorp test --warmup-only 2>/dev/null; then
        echo "Warning: runtime cache warmup failed — parallel tests may have cache misses" >&2
    fi
    parallel_leak_timeout=$(parallel_default_timeout "$test_timeout" "${#parallel_gates[@]}")
    gate_tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/blorp_gates.XXXXXX")

    for gate in "${parallel_gates[@]}"; do
        outfile="$gate_tmpdir/${gate}_output"
        exitfile="$gate_tmpdir/${gate}_exit"
        secondsfile="$gate_tmpdir/${gate}_seconds"
        case "$gate" in
            unit)
                {
                    echo "═══ Compiler Unit Tests (OCaml/Alcotest) ═══"
                    echo ""
                } > "$outfile"
                ;;
            compiler)
                {
                    echo "═══ Compiler Tests (fast fixtures) ═══"
                    echo ""
                } > "$outfile"
                ;;
            compiler_deep)
                {
                    echo "═══ Compiler Deep Tests (codegen audit + compiler/blorp) ═══"
                    echo ""
                } > "$outfile"
                ;;
            runtime)
                {
                    echo "═══ Runtime Tests (.brp) ═══"
                    echo ""
                } > "$outfile"
                ;;
            leak)
                {
                    echo "═══ Leak-Check Ownership Suites + Diagnostics ═══"
                    echo ""
                } > "$outfile"
                ;;
            doctest)
                {
                    echo "═══ Doctests (std/) ═══"
                    echo ""
                } > "$outfile"
                ;;
            cli)
                {
                    echo "═══ CLI Smoke / Exit Codes ═══"
                    echo ""
                } > "$outfile"
                ;;
        esac
        {
            gate_start_seconds=$(now_seconds)
            case "$gate" in
                unit)
                    if $coverage; then
                        make coverage >> "$outfile" 2>&1
                    else
                        (cd compiler && exec dune runtest --force) >> "$outfile" 2>&1
                    fi
                    ;;
                compiler)
                    run_compiler_gate_commands "$outfile" false
                    ;;
                compiler_deep)
                    run_compiler_deep_gate_commands "$outfile" false
                    ;;
                runtime)
                    env BLORP_GATE_RESULT=runtime ./blorp test --no-format --timeout "$test_timeout" "${runtime_roots[@]}" >> "$outfile" 2>&1
                    ;;
                leak)
                    env BLORP_GATE_RESULT=leak ./blorp test --no-format --leak-check --suite --timeout "$parallel_leak_timeout" "${leak_roots[@]}" >> "$outfile" 2>&1
                    leak_suite_exit=$?
                    leak_suite_output=$(cat "$outfile")
                    leak_diag_outfile="$gate_tmpdir/${gate}_diag_output"
                    tests/test_leak_report.sh > "$leak_diag_outfile" 2>&1
                    leak_diag_exit=$?
                    leak_diag_output=$(cat "$leak_diag_outfile")
                    cat "$leak_diag_outfile" >> "$outfile"
                    emit_combined_leak_result "$leak_suite_output" "$leak_diag_output" "$leak_suite_exit" "$leak_diag_exit" >> "$outfile"
                    if [ "$leak_suite_exit" -ne 0 ] || [ "$leak_diag_exit" -ne 0 ]; then
                        false
                    else
                        true
                    fi
                    ;;
                doctest)
                    env BLORP_GATE_RESULT=doctest ./blorp test --no-format --doc --timeout "$test_timeout" std/ >> "$outfile" 2>&1
                    ;;
                cli)
                    env BLORP_CLI_TEST_TIMEOUT="${BLORP_CLI_TEST_TIMEOUT:-$test_timeout}" tests/test_cli.sh >> "$outfile" 2>&1
                    ;;
            esac
            gate_exit=$?
            echo "$gate_exit" > "$exitfile"
            elapsed_since "$gate_start_seconds" > "$secondsfile"
            exit "$gate_exit"
        } &
        gate_pids+=($!)
        gate_names+=("$gate")
        echo "RUN gate: $gate (pid $!)"
    done

    # Wait for all gates to complete. Gate worker subshells write their own
    # exit and timing files at the actual finish time, so a slow earlier gate
    # does not inflate timings for faster later gates.
    for pid in "${gate_pids[@]}"; do
        wait "$pid" 2>/dev/null || true
    done
    gate_pids=()
    gate_names=()

    # Parse captured results in gate order.
    for gate in "${parallel_gates[@]}"; do
        outfile="$gate_tmpdir/${gate}_output"
        exitfile="$gate_tmpdir/${gate}_exit"
        secondsfile="$gate_tmpdir/${gate}_seconds"
        local_exit=1
        local_seconds=0
        [ -f "$exitfile" ] && local_exit=$(cat "$exitfile")
        [ -f "$secondsfile" ] && local_seconds=$(cat "$secondsfile")
        eval "${gate}_seconds=\$local_seconds"

        if [ -f "$outfile" ]; then
            record_gate_log "$gate" "$outfile"
        fi

        if [ -f "$outfile" ] && $verbose; then
            echo ""
            cat "$outfile"
        elif [ -f "$outfile" ] && [ "$local_exit" != "0" ]; then
            print_failure_excerpt "$gate" "$outfile"
        fi

        # Re-parse output to extract counts (parsers set global vars)
        local_output=""
        [ -f "$outfile" ] && local_output=$(cat "$outfile")
        case "$gate" in
            unit)     parse_unit "$local_output" ;;
            compiler) parse_compiler_gate_output "$local_output" ;;
            compiler_deep) parse_compiler_deep_gate_output "$local_output" ;;
            runtime)  parse_blorp_output "$local_output" "runtime" ;;
            leak)     parse_blorp_output "$local_output" "leak" ;;
            doctest)  parse_blorp_output "$local_output" "doctest" ;;
            cli)      parse_cli "$local_output" ;;
        esac
        mark_gate_process_failure "$gate" "$local_exit"
        [ "$local_exit" != "0" ] && any_failed=true
    done
fi

# ─── Summary ────────────────────────────────────────────────────────

total_tests=0
total_passed=0
total_failed=0
total_gate_seconds=0
overall="PASS"

for s in "${gates[@]}"; do
    st=$(eval echo "\$${s}_status")
    p=$(eval echo "\$${s}_passed")
    f=$(eval echo "\$${s}_failed")
    t=$(eval echo "\$${s}_tests")
    sec=$(eval echo "\$${s}_seconds")
    total_passed=$((total_passed + p))
    total_failed=$((total_failed + f))
    total_tests=$((total_tests + t))
    total_gate_seconds=$((total_gate_seconds + sec))
    if [ "$st" = "FAIL" ]; then
        overall="FAIL"
    fi
done

total_wall_seconds=$(elapsed_since "$script_start_seconds")

echo "══════════════════════════════════════════════════════════"
echo "  Gate          Status   Passed  Failed   Tests     Time"
echo "──────────────────────────────────────────────────────────"
for s in "${gates[@]}"; do
    st=$(eval echo "\$${s}_status")
    p=$(eval echo "\$${s}_passed")
    f=$(eval echo "\$${s}_failed")
    t=$(eval echo "\$${s}_tests")
    sec=$(eval echo "\$${s}_seconds")
    case "$s" in
        unit)     label="Compiler-unit" ;;
        compiler) label="Compiler" ;;
        compiler_deep) label="Compiler-deep" ;;
        runtime)  label="Runtime" ;;
        leak)     label="Leak-check" ;;
        doctest)  label="Doctests" ;;
        cli)      label="CLI" ;;
    esac
    printf "  %-13s %-6s %8d %7d %7d %8s\n" "$label" "$st" "$p" "$f" "$t" "$(format_seconds "$sec")"
done
echo "──────────────────────────────────────────────────────────"
printf "  %-13s %-6s %8d %7d %7d %8s\n" "Total" "$overall" "$total_passed" "$total_failed" "$total_tests" "$(format_seconds "$total_wall_seconds")"
echo "══════════════════════════════════════════════════════════"
echo "Setup: build $(format_seconds "$build_seconds"), bridge prepare $(format_seconds "$bridge_prepare_seconds"), std preflight $(format_seconds "$std_preflight_seconds"), gate-sum $(format_seconds "$total_gate_seconds")."

# List failing tests if any
if [ "$overall" = "FAIL" ]; then
    echo ""
    echo "Failed tests:"
    for s in "${gates[@]}"; do
        local_failures=$(eval echo "\"\$${s}_failures\"")
        if [ -n "$local_failures" ]; then
            echo "$local_failures" | while IFS= read -r line; do
                echo "  $line"
            done
        fi
    done
fi

if $any_failed; then
    exit 1
fi
