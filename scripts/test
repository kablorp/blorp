#!/bin/bash
# Run blorp test gates
#
# Usage:
#   scripts/test                    # Run all test gates
#   scripts/test unit               # OCaml unit tests only
#   scripts/test compiler           # Compiler tests plus codegen audit
#   scripts/test runtime            # Runtime .brp tests (language features)
#   scripts/test leak               # Focused --leak-check ownership baselines
#   scripts/test doctest            # Doctests only (std/ library)
#   scripts/test cli                # Public CLI, REPL, and LSP smoke checks
#   scripts/test unit compiler      # Multiple gates
#   scripts/test --serial           # Run selected gates one at a time
#   scripts/test --coverage         # Unit tests with coverage report
#   scripts/test --verbose          # Print every child-runner line
#   scripts/test --log-dir logs     # Save premerge gate logs

script_dir="$(cd "$(dirname "$0")" && pwd -P)"
if [ "${BLORP_TEST_LOCK_HELD:-0}" != "1" ]; then
    export BLORP_TEST_LOCK_HELD=1
    exec "$script_dir/with-build-lock" "$script_dir/test" "$@"
fi

cd "$script_dir/.."

runner_label="scripts/test"

usage() {
    echo "Usage: $runner_label [options] [unit] [compiler] [runtime] [leak] [doctest] [cli]"
    cat <<'EOF'

Options:
  --serial       Run selected gates one at a time.
  --coverage     Run OCaml unit tests with coverage instrumentation.
  --verbose      Stream full child-runner output, including passing tests.
  --quiet        Suppress passing-test output (default).
  --log-dir DIR  Copy each gate's full captured output into DIR.
EOF
}

# Parse arguments
gates=()
coverage=false
serial=false
verbose=false
log_dir=""
while [ $# -gt 0 ]; do
    arg="$1"
    shift
    case "$arg" in
        --coverage) coverage=true ;;
        --serial) serial=true ;;
        --verbose) verbose=true ;;
        --quiet) verbose=false ;;
        --log-dir)
            if [ $# -eq 0 ]; then
                echo "Error: --log-dir requires a directory path." >&2
                usage
                exit 1
            fi
            log_dir="$1"
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        unit|compiler|runtime|leak|doctest|cli) gates+=("$arg") ;;
        *)
            echo "Unknown argument: $arg"
            usage
            exit 1
            ;;
    esac
done

# Default: run all gates
if [ ${#gates[@]} -eq 0 ]; then
    gates=(unit compiler runtime leak doctest cli)
fi

if [ -n "$log_dir" ]; then
    mkdir -p "$log_dir"
fi

test_timeout="${BLORP_TEST_TIMEOUT:-30}"
runtime_roots=()
for root in tests/test_blorp/ tests/test_std/ tests/test_pkg/; do
    if [ -d "$root" ]; then
        runtime_roots+=("$root")
    fi
done

# Background process tracking. Bash does not give us structured child cleanup,
# so keep this small and explicit: track the real worker PIDs and recursively
# terminate their descendants on interruption.
gate_pids=()
gate_names=()
gate_tmpdir=""

list_child_pids() {
    local parent="$1"
    if command -v pgrep >/dev/null 2>&1; then
        pgrep -P "$parent" 2>/dev/null || true
    else
        ps -o pid= -P "$parent" 2>/dev/null | tr -d ' ' || true
    fi
}

terminate_process_tree() {
    local pid="$1"
    local signal="${2:-TERM}"
    local child
    [ -n "$pid" ] || return 0

    for child in $(list_child_pids "$pid"); do
        terminate_process_tree "$child" "$signal"
    done
    kill -"$signal" "$pid" 2>/dev/null || true
}

wait_for_tracked_pids() {
    local pid
    for pid in "$@"; do
        [ -n "$pid" ] && wait "$pid" 2>/dev/null || true
    done
}

cleanup_gate_tmpdir() {
    if [ -n "$gate_tmpdir" ]; then
        rm -rf "$gate_tmpdir"
        gate_tmpdir=""
    fi
}

terminate_parallel_gates() {
    local pid
    if [ ${#gate_pids[@]} -gt 0 ]; then
        for pid in "${gate_pids[@]}"; do
            terminate_process_tree "$pid" TERM
        done
        sleep 1
        for pid in "${gate_pids[@]}"; do
            terminate_process_tree "$pid" KILL
        done
        wait_for_tracked_pids "${gate_pids[@]}"
        gate_pids=()
        gate_names=()
    fi
}

on_interrupt() {
    echo "" >&2
    echo "Interrupted; terminating test gates..." >&2
    trap - INT TERM EXIT
    terminate_parallel_gates
    cleanup_gate_tmpdir
    exit 130
}

trap on_interrupt INT TERM
trap cleanup_gate_tmpdir EXIT

# Ensure compiler is built. If the rebuild fails, stop here; continuing with a
# stale ./blorp is worse than not running tests because it can hide strict
# typecheck failures behind old compiler behavior.
if ! make --quiet 2>/dev/null; then
    if ! make; then
        echo "Error: compiler build failed; aborting test run." >&2
        exit 1
    fi
fi

# ─── Result tracking (bash 3.2 compatible) ──────────────────────────
# Each gate gets: _status, _passed, _failed, _tests, _failures (newline-separated list)
unit_status="SKIP"; unit_passed=0; unit_failed=0; unit_tests=0; unit_failures=""
compiler_status="SKIP"; compiler_passed=0; compiler_failed=0; compiler_tests=0; compiler_failures=""
runtime_status="SKIP"; runtime_passed=0; runtime_failed=0; runtime_tests=0; runtime_failures=""
leak_status="SKIP"; leak_passed=0; leak_failed=0; leak_tests=0; leak_failures=""
doctest_status="SKIP"; doctest_passed=0; doctest_failed=0; doctest_tests=0; doctest_failures=""
cli_status="SKIP"; cli_passed=0; cli_failed=0; cli_tests=0; cli_failures=""

# ─── Parsers ────────────────────────────────────────────────────────

result_field() {
    local line="$1"
    local key="$2"
    printf '%s\n' "$line" | tr ' ' '\n' | sed -n "s/^${key}=//p" | tail -1
}

parse_structured_gate_result() {
    local output="$1"
    local key="$2"
    local line status passed failed tests

    line=$(printf '%s\n' "$output" | grep "^BLORP_GATE_RESULT gate=$key " | tail -1)
    [ -n "$line" ] || return 1

    status=$(result_field "$line" status)
    passed=$(result_field "$line" passed)
    failed=$(result_field "$line" failed)
    tests=$(result_field "$line" tests)

    case "$status:$passed:$failed:$tests" in
        PASS:[0-9]*:[0-9]*:[0-9]*|FAIL:[0-9]*:[0-9]*:[0-9]*) ;;
        *) return 1 ;;
    esac

    eval "${key}_status=\$status"
    eval "${key}_passed=\$passed"
    eval "${key}_failed=\$failed"
    eval "${key}_tests=\$tests"
    return 0
}

parse_unit() {
    local output="$1"
    # Alcotest:
    #   "Test Successful in 0.014s. 71 tests run."
    #   "6 failures! in 3.666s. 734 tests run."
    local tests_line failures_line tests failures
    tests_line=$(echo "$output" | grep -o '[0-9][0-9]* tests run' | tail -1)
    failures_line=$(echo "$output" | grep -o '[0-9][0-9]* failures!' | tail -1)
    tests=0
    failures=0

    if [ -n "$tests_line" ]; then
        tests="${tests_line%% *}"
    fi
    if [ -n "$failures_line" ]; then
        failures="${failures_line%% *}"
    fi

    if [ "$tests" -eq 0 ] && [ "$failures" -eq 0 ]; then
        unit_tests=1
        unit_failed=1
        unit_passed=0
    else
        unit_tests=$tests
        unit_failed=$failures
        unit_passed=$((tests - failures))
    fi
    if [ "$failures" -eq 0 ] && [ "$tests" -gt 0 ]; then
        unit_status="PASS"
    else
        unit_status="FAIL"
        unit_failures=$(echo "$output" | grep '^\> \[FAIL\]' | sed 's/^> \[FAIL\][[:space:]]*//')
    fi
}

parse_compiler() {
    local output="$1"
    if parse_structured_gate_result "$output" "compiler"; then
        if [ "$compiler_status" = "FAIL" ]; then
            compiler_failures=$(echo "$output" | grep -E '^(FAIL:|✗ \[)' | sed -e 's/^FAIL: *//' -e 's/^✗ //')
        fi
        return
    fi

    # "✓ All 500 compiler tests passed" or "✗ 490/500 compiler tests passed (10 failed)"
    local summary
    summary=$(echo "$output" | grep -E '(All [0-9]+ compiler|[0-9]+/[0-9]+ compiler)')
    if echo "$summary" | grep -q "All"; then
        local n
        n=$(echo "$summary" | grep -o 'All [0-9]*' | grep -o '[0-9]*')
        compiler_passed=$n
        compiler_tests=$n
        compiler_status="PASS"
    elif [ -n "$summary" ]; then
        compiler_passed=$(echo "$summary" | grep -o '[0-9]*/[0-9]*' | cut -d/ -f1)
        compiler_tests=$(echo "$summary" | grep -o '[0-9]*/[0-9]*' | cut -d/ -f2)
        compiler_failed=$(echo "$summary" | grep -o '([0-9]* failed)' | grep -o '[0-9]*')
        compiler_status="FAIL"
        compiler_failures=$(echo "$output" | grep -E '^(FAIL:|✗ \[)' | sed -e 's/^FAIL: *//' -e 's/^✗ //')
    else
        compiler_status="FAIL"
        compiler_passed=0
        compiler_failed=1
        compiler_tests=1
        compiler_failures="compiler gate exited before reporting a summary"
    fi
}

parse_blorp_output() {
    local output="$1"
    local key="$2"
    if parse_structured_gate_result "$output" "$key"; then
        if [ "$(eval echo "\$${key}_status")" = "FAIL" ]; then
            local fails
            fails=$(echo "$output" | grep "^FAIL:" | sed 's/^FAIL: *//')
            eval "${key}_failures=\$fails"
        fi
        return
    fi

    # "Results: 403 passed, 3 failed (3312 tests)" or "Results: 45 passed, 0 failed (0 tests, 718 doctests)"
    local summary
    summary=$(echo "$output" | grep '^Results:')
    if [ -z "$summary" ]; then
        eval "${key}_status=FAIL"
        eval "${key}_passed=0"
        eval "${key}_failed=1"
        eval "${key}_tests=1"
        local fails
        fails=$(echo "$output" | grep -E '^(Combined test compile failed|error:|\(C compilation failed\))' | head -1)
        [ -n "$fails" ] || fails="$key gate exited before reporting Results"
        eval "${key}_failures=\$fails"
        return
    fi

    local p f t
    p=$(echo "$summary" | grep -o '[0-9]* passed' | grep -o '[0-9]*')
    f=$(echo "$summary" | grep -o '[0-9]* failed' | grep -o '[0-9]*')
    # Total: sum all numbers inside parentheses (handles "0 tests, 718 doctests")
    t=$(echo "$summary" | sed 's/.*(\(.*\))/\1/' | grep -o '[0-9]*' | awk '{s+=$1} END {print s}')

    eval "${key}_passed=$p"
    eval "${key}_failed=$f"
    eval "${key}_tests=$t"
    if [ "$f" -eq 0 ]; then
        eval "${key}_status=PASS"
    else
        eval "${key}_status=FAIL"
        local fails
        fails=$(echo "$output" | grep "^FAIL:" | sed 's/^FAIL: *//')
        eval "${key}_failures=\$fails"
    fi
}

parse_cli() {
    local output="$1"
    if parse_structured_gate_result "$output" "cli"; then
        if [ "$cli_status" = "FAIL" ]; then
            cli_failures=$(echo "$output" | grep '^FAIL:' | sed 's/^FAIL: *//')
        fi
        return
    fi

    local summary p f t
    summary=$(echo "$output" | grep '^Results:')
    if [ -z "$summary" ]; then
        cli_status="FAIL"
        cli_passed=0
        cli_failed=1
        cli_tests=1
        cli_failures="cli gate exited before reporting Results"
        return
    fi

    p=$(echo "$summary" | grep -o '[0-9]* passed' | grep -o '[0-9]*')
    f=$(echo "$summary" | grep -o '[0-9]* failed' | grep -o '[0-9]*')
    t=$(echo "$summary" | sed 's/.*(\(.*\))/\1/' | grep -o '[0-9]*' | head -1)

    cli_passed=$p
    cli_failed=$f
    cli_tests=$t
    if [ "$f" -eq 0 ]; then
        cli_status="PASS"
    else
        cli_status="FAIL"
        cli_failures=$(echo "$output" | grep '^FAIL:' | sed 's/^FAIL: *//')
    fi
}

capture_stream() {
    local output_file="$1"
    shift
    if $verbose; then
        "$@" 2>&1 | tee "$output_file"
        return ${PIPESTATUS[0]}
    else
        "$@" > "$output_file" 2>&1
        return $?
    fi
}

record_gate_log() {
    local gate="$1"
    local output_file="$2"
    if [ -n "$log_dir" ]; then
        cp "$output_file" "$log_dir/$gate.log"
    fi
}

print_failure_excerpt() {
    local gate="$1"
    local output_file="$2"

    echo ""
    echo "Failure output for $gate:"
    awk '
        /^(FAIL:|FAIL |✗ |DETAIL|DETAIL:|error:|warning:|Combined test compile failed|\(C compilation failed\))/ {
            print
            after = 12
            shown = 1
            next
        }
        shown && after > 0 {
            print
            after--
        }
    ' "$output_file" | head -160
    if [ -n "$log_dir" ]; then
        echo "Full log: $log_dir/$gate.log"
    else
        echo "Re-run with --verbose for the full log."
    fi
}

maybe_print_failure_excerpt() {
    local gate="$1"
    local output_file="$2"
    local exit_code="$3"
    if [ "$exit_code" != "0" ] && ! $verbose; then
        print_failure_excerpt "$gate" "$output_file"
    fi
}

run_std_typecheck_preflight() {
    echo "═══ Std Typecheck Preflight ═══"
    echo ""

    local checked output_file
    checked=$(find std -name '*.brp' | wc -l | tr -d ' ')
    output_file=$(mktemp "${TMPDIR:-/tmp}/blorp_std_typecheck.XXXXXX") || exit 1

    if ! {
        ./blorp check --no-format std
    } > "$output_file" 2>&1; then
        echo "FAIL: std typecheck preflight"
        sed -n '1,80p' "$output_file"
        rm -f "$output_file"
        return 1
    fi

    rm -f "$output_file"
    echo "Std typecheck preflight passed ($checked modules)."
    echo ""
    return 0
}

needs_std_typecheck_preflight=false
for gate in "${gates[@]}"; do
    case "$gate" in
        compiler|runtime|leak|doctest)
            needs_std_typecheck_preflight=true
            ;;
    esac
done

if $needs_std_typecheck_preflight; then
    run_std_typecheck_preflight || exit 1
fi

# ─── Gate runners ───────────────────────────────────────────────────

run_unit() {
    echo "═══ Unit Tests (OCaml) ═══"
    echo ""
    local output exit_code output_file
    output_file=$(mktemp "${TMPDIR:-/tmp}/blorp_unit.XXXXXX") || exit 1
    if $coverage; then
        capture_stream "$output_file" make coverage
        exit_code=$?
    else
        capture_stream "$output_file" bash -c 'cd compiler && dune runtest --force'
        exit_code=$?
    fi
    output=$(cat "$output_file")
    record_gate_log "unit" "$output_file"
    maybe_print_failure_excerpt "unit" "$output_file" "$exit_code"
    rm -f "$output_file"
    echo ""
    if [ $exit_code -eq 0 ]; then
        parse_unit "$output"
    else
        unit_status="FAIL"
        parse_unit "$output"
        unit_status="FAIL"
    fi
    return $exit_code
}

run_compiler() {
    echo "═══ Compiler Tests (should_pass/should_fail + codegen audit) ═══"
    echo ""
    local output exit_code output_file
    output_file=$(mktemp "${TMPDIR:-/tmp}/blorp_compiler.XXXXXX") || exit 1
    if $verbose || [ -n "$log_dir" ]; then
        capture_stream "$output_file" tests/test_compiler/run_compiler_tests.sh --verbose
    else
        capture_stream "$output_file" tests/test_compiler/run_compiler_tests.sh --quiet
    fi
    exit_code=$?
    output=$(cat "$output_file")
    record_gate_log "compiler" "$output_file"
    maybe_print_failure_excerpt "compiler" "$output_file" "$exit_code"
    rm -f "$output_file"
    echo ""
    parse_compiler "$output"
    return $exit_code
}

run_runtime() {
    echo "═══ Runtime Tests (.brp) ═══"
    echo ""
    local output exit_code output_file
    output_file=$(mktemp "${TMPDIR:-/tmp}/blorp_runtime.XXXXXX") || exit 1
    capture_stream "$output_file" env BLORP_GATE_RESULT=runtime ./blorp test --timeout "$test_timeout" "${runtime_roots[@]}"
    exit_code=$?
    output=$(cat "$output_file")
    record_gate_log "runtime" "$output_file"
    maybe_print_failure_excerpt "runtime" "$output_file" "$exit_code"
    rm -f "$output_file"
    echo ""
    parse_blorp_output "$output" "runtime"
    return $exit_code
}

run_leak() {
    echo "═══ Leak-Check Baselines (.brp) ═══"
    echo ""
    local output exit_code output_file
    output_file=$(mktemp "${TMPDIR:-/tmp}/blorp_leak.XXXXXX") || exit 1
    capture_stream "$output_file" env BLORP_GATE_RESULT=leak ./blorp test --leak-check --suite --timeout "$test_timeout" tests/test_blorp/memory/leak_check_baselines/
    exit_code=$?
    output=$(cat "$output_file")
    record_gate_log "leak" "$output_file"
    maybe_print_failure_excerpt "leak" "$output_file" "$exit_code"
    rm -f "$output_file"
    echo ""
    parse_blorp_output "$output" "leak"
    return $exit_code
}

run_doctest() {
    echo "═══ Doctests (std/) ═══"
    echo ""
    local output exit_code output_file
    output_file=$(mktemp "${TMPDIR:-/tmp}/blorp_doctest.XXXXXX") || exit 1
    capture_stream "$output_file" env BLORP_GATE_RESULT=doctest ./blorp test --doc --timeout "$test_timeout" std/
    exit_code=$?
    output=$(cat "$output_file")
    record_gate_log "doctest" "$output_file"
    maybe_print_failure_excerpt "doctest" "$output_file" "$exit_code"
    rm -f "$output_file"
    echo ""
    parse_blorp_output "$output" "doctest"
    return $exit_code
}

run_cli() {
    echo "═══ CLI Smoke / Exit Codes ═══"
    echo ""
    local output exit_code output_file
    output_file=$(mktemp "${TMPDIR:-/tmp}/blorp_cli.XXXXXX") || exit 1
    capture_stream "$output_file" env BLORP_CLI_TEST_TIMEOUT="${BLORP_CLI_TEST_TIMEOUT:-$test_timeout}" tests/test_cli.sh
    exit_code=$?
    output=$(cat "$output_file")
    record_gate_log "cli" "$output_file"
    maybe_print_failure_excerpt "cli" "$output_file" "$exit_code"
    rm -f "$output_file"
    echo ""
    parse_cli "$output"
    return $exit_code
}

# ─── Run gates ─────────────────────────────────────────────────────

any_failed=false
parallel_gates=("${gates[@]}")

# Dune-backed work must stay serial. The initial make preflight above already
# runs before any gate work; keep OCaml unit tests out of the parallel worker
# block as well so this script never starts dune from a background gate.
if [ ${#gates[@]} -gt 1 ]; then
    non_dune_gates=()
    for gate in "${gates[@]}"; do
        case "$gate" in
            unit)
                run_unit || any_failed=true
                ;;
            *)
                non_dune_gates+=("$gate")
                ;;
        esac
    done
    parallel_gates=("${non_dune_gates[@]}")
fi

# When running multiple non-Dune gates, run them in parallel for speed unless
# --serial is set. CI uses serial mode so per-test timeouts are not distorted by
# concurrent generated-C compiles and other gate-level load.
# Each gate's output is captured for summary parsing; --verbose prints it back.
if [ ${#parallel_gates[@]} -eq 0 ]; then
    :
elif $serial || [ ${#parallel_gates[@]} -le 1 ]; then
    # Single-gate and serial mode: run directly; gate runners self-capture.
    for gate in "${parallel_gates[@]}"; do
        case "$gate" in
            unit)     run_unit     || any_failed=true ;;
            compiler) run_compiler || any_failed=true ;;
            runtime)  run_runtime  || any_failed=true ;;
            leak)     run_leak     || any_failed=true ;;
            doctest)  run_doctest  || any_failed=true ;;
            cli)      run_cli      || any_failed=true ;;
        esac
    done
else
    # Multiple non-Dune gates: run in parallel, collect results
    # Pre-warm the precompiled runtime cache to prevent race conditions
    # between parallel gate runners that both call precompile_runtime()
    if ! ./blorp test --warmup-only 2>/dev/null; then
        echo "Warning: runtime cache warmup failed — parallel tests may have cache misses" >&2
    fi
    gate_tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/blorp_gates.XXXXXX")

    for gate in "${parallel_gates[@]}"; do
        outfile="$gate_tmpdir/${gate}_output"
        case "$gate" in
            unit)
                {
                    echo "═══ Unit Tests (OCaml) ═══"
                    echo ""
                } > "$outfile"
                if $coverage; then
                    make coverage >> "$outfile" 2>&1 &
                else
                    (cd compiler && exec dune runtest --force) >> "$outfile" 2>&1 &
                fi
                ;;
            compiler)
                {
                    echo "═══ Compiler Tests (should_pass/should_fail + codegen audit) ═══"
                    echo ""
                } > "$outfile"
                if $verbose || [ -n "$log_dir" ]; then
                    tests/test_compiler/run_compiler_tests.sh --verbose >> "$outfile" 2>&1 &
                else
                    tests/test_compiler/run_compiler_tests.sh --quiet >> "$outfile" 2>&1 &
                fi
                ;;
            runtime)
                {
                    echo "═══ Runtime Tests (.brp) ═══"
                    echo ""
                } > "$outfile"
                env BLORP_GATE_RESULT=runtime ./blorp test --timeout "$test_timeout" "${runtime_roots[@]}" >> "$outfile" 2>&1 &
                ;;
            leak)
                {
                    echo "═══ Leak-Check Baselines (.brp) ═══"
                    echo ""
                } > "$outfile"
                env BLORP_GATE_RESULT=leak ./blorp test --leak-check --suite --timeout "$test_timeout" tests/test_blorp/memory/leak_check_baselines/ >> "$outfile" 2>&1 &
                ;;
            doctest)
                {
                    echo "═══ Doctests (std/) ═══"
                    echo ""
                } > "$outfile"
                env BLORP_GATE_RESULT=doctest ./blorp test --doc --timeout "$test_timeout" std/ >> "$outfile" 2>&1 &
                ;;
            cli)
                {
                    echo "═══ CLI Smoke / Exit Codes ═══"
                    echo ""
                } > "$outfile"
                env BLORP_CLI_TEST_TIMEOUT="${BLORP_CLI_TEST_TIMEOUT:-$test_timeout}" tests/test_cli.sh >> "$outfile" 2>&1 &
                ;;
        esac
        gate_pids+=($!)
        gate_names+=("$gate")
        echo "RUN gate: $gate (pid $!)"
    done

    # Wait for all gates to complete
    for i in "${!gate_pids[@]}"; do
        pid="${gate_pids[$i]}"
        gate="${gate_names[$i]}"
        if wait "$pid" 2>/dev/null; then
            echo 0 > "$gate_tmpdir/${gate}_exit"
        else
            echo $? > "$gate_tmpdir/${gate}_exit"
        fi
    done
    gate_pids=()
    gate_names=()

    # Parse captured results in gate order.
    for gate in "${parallel_gates[@]}"; do
        outfile="$gate_tmpdir/${gate}_output"
        exitfile="$gate_tmpdir/${gate}_exit"
        local_exit=1
        [ -f "$exitfile" ] && local_exit=$(cat "$exitfile")

        if [ -f "$outfile" ]; then
            record_gate_log "$gate" "$outfile"
        fi

        if [ -f "$outfile" ] && $verbose; then
            echo ""
            cat "$outfile"
        elif [ -f "$outfile" ] && [ "$local_exit" != "0" ]; then
            print_failure_excerpt "$gate" "$outfile"
        fi

        # Re-parse output to extract counts (parsers set global vars)
        local_output=""
        [ -f "$outfile" ] && local_output=$(cat "$outfile")
        case "$gate" in
            unit)     parse_unit "$local_output"; [ "$local_exit" != "0" ] && unit_status="FAIL" ;;
            compiler) parse_compiler "$local_output" ;;
            runtime)  parse_blorp_output "$local_output" "runtime" ;;
            leak)     parse_blorp_output "$local_output" "leak" ;;
            doctest)  parse_blorp_output "$local_output" "doctest" ;;
            cli)      parse_cli "$local_output" ;;
        esac
        [ "$local_exit" != "0" ] && any_failed=true
    done
fi

# ─── Summary ────────────────────────────────────────────────────────

total_tests=0
total_passed=0
total_failed=0
overall="PASS"

for s in "${gates[@]}"; do
    st=$(eval echo "\$${s}_status")
    p=$(eval echo "\$${s}_passed")
    f=$(eval echo "\$${s}_failed")
    t=$(eval echo "\$${s}_tests")
    total_passed=$((total_passed + p))
    total_failed=$((total_failed + f))
    total_tests=$((total_tests + t))
    if [ "$st" = "FAIL" ]; then
        overall="FAIL"
    fi
done

echo "════════════════════════════════════════════════"
echo "  Gate          Status   Passed  Failed   Tests"
echo "────────────────────────────────────────────────"
for s in "${gates[@]}"; do
    st=$(eval echo "\$${s}_status")
    p=$(eval echo "\$${s}_passed")
    f=$(eval echo "\$${s}_failed")
    t=$(eval echo "\$${s}_tests")
    case "$s" in
        unit)     label="Unit" ;;
        compiler) label="Compiler" ;;
        runtime)  label="Runtime" ;;
        leak)     label="Leak-check" ;;
        doctest)  label="Doctests" ;;
        cli)      label="CLI" ;;
    esac
    printf "  %-13s %-6s %8d %7d %7d\n" "$label" "$st" "$p" "$f" "$t"
done
echo "────────────────────────────────────────────────"
printf "  %-13s %-6s %8d %7d %7d\n" "Total" "$overall" "$total_passed" "$total_failed" "$total_tests"
echo "════════════════════════════════════════════════"

# List failing tests if any
if [ "$overall" = "FAIL" ]; then
    echo ""
    echo "Failed tests:"
    for s in "${gates[@]}"; do
        local_failures=$(eval echo "\"\$${s}_failures\"")
        if [ -n "$local_failures" ]; then
            echo "$local_failures" | while IFS= read -r line; do
                echo "  $line"
            done
        fi
    done
fi

if $any_failed; then
    exit 1
fi
