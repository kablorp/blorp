#!/usr/bin/env bash
# Guard against recursive self-hosted bridge functions regressing into huge
# generated-C stack frames. This catches the architectural issue directly
# instead of depending on CI stack limits to expose it as a late crash.

set -euo pipefail

cd "$(dirname "$0")/.."

tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/blorp_bridge_stack.XXXXXX")
trap 'rm -rf "$tmp_dir"' EXIT

c_file="compiler/_build/blorp-cli/blorp_cli_main.c"
obj_file="$tmp_dir/blorp_cli_main.o"

if [ ! -s "$c_file" ]; then
	echo "FAIL: generated Blorp CLI C is missing: $c_file"
	echo "Run make before compiler bridge stack checks."
	exit 1
fi

# This check is intentionally limited to recursive CoreExpr dispatchers. Large
# exhaustive helpers are acceptable when recursive edges first pass through a
# small dispatcher; recursive entry points must remain below this limit.
stack_limit_bytes=16384

echo "Compiler bridge stack check generated C: $c_file"

"${CC:-cc}" -O0 -fwrapv -pipe -w -fstack-usage \
	-include compiler/lib/runtime_decl.c \
	-Icompiler/blorp/src/stage_01_file_io \
	-Icompiler/blorp/src/stage_06_typecheck/graph \
	-Icompiler/blorp/src/stage_12_cli \
	-Icompiler/blorp/src/stage_12_lsp \
	-c "$c_file" -o "$obj_file" >/dev/null

su_file=$(find "$tmp_dir" -name '*.su' -print -quit)
if [ -z "$su_file" ]; then
	echo "FAIL: C compiler did not produce stack-usage metadata"
	exit 1
fi

python3 - "$su_file" "$stack_limit_bytes" <<'PY'
from pathlib import Path
import sys

su_file = Path(sys.argv[1])
stack_limit_bytes = int(sys.argv[2])

target_definition_ids = {
    # Keep the source declaration and reviewed definition ID together so an
    # intentional ID change fails closed and can be updated mechanically.
    "ir__core_expr_to_json": 10224,
    # The production CLI no longer decodes Core JSON now that its semantic
    # middle is Blorp-owned. Decoder behavior remains covered by the focused
    # IR tests, but it is intentionally absent from this C
    # artifact and therefore cannot provide stack-usage metadata here.
    "closure__convert_expr": 8049,
    "resolve__resolve_callable_id_expr": 12330,
    "resolve__resolve_global_value_expr": 12313,
    "resolve__resolve_global_value_expr_inner": 12314,
    "resolve__resolve_global_value_variable_expr": 12318,
    "resolve__resolve_global_value_binding_expr": 12319,
    "resolve__resolve_global_value_loop_expr": 12320,
    "resolve__resolve_global_value_concurrency_expr": 12321,
    "resolve__resolve_global_value_match_expr": 12322,
    "resolve__resolve_global_value_generic_expr": 12323,
    "emit__emit_condition": 14559,
    "emit__emit_logical_body": 14568,
    "emit__emit_simple_expr": 15044,
    "emit__emit_function_body": 15212,
}

base62_alphabet = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"


def projected_symbol(definition_id):
    if definition_id == 0:
        return "brp_0"

    encoded = ""
    remaining = definition_id
    while remaining > 0:
        remaining, digit = divmod(remaining, len(base62_alphabet))
        encoded = base62_alphabet[digit] + encoded
    return "brp_" + encoded


targets = {
    source_name: projected_symbol(definition_id)
    for source_name, definition_id in target_definition_ids.items()
}

found = {name: [] for name in targets}
for line in su_file.read_text().splitlines():
    parts = line.split("\t")
    if len(parts) < 2:
        continue

    loc_and_function = parts[0]
    size_text = parts[1]
    try:
        size = int(size_text)
    except ValueError:
        continue

    function_name = loc_and_function.split(":")[-1]
    for target_name, needle in targets.items():
        if function_name.endswith(needle):
            found[target_name].append((size, function_name))

failed = False
for target_name, entries in sorted(found.items()):
    definition_id = target_definition_ids[target_name]
    if not entries:
        print(
            "FAIL: stack usage missing for "
            f"{target_name} (definition {definition_id}, symbol {targets[target_name]})"
        )
        failed = True
        continue

    size, function_name = max(entries)
    if size > stack_limit_bytes:
        print(
            "FAIL: "
            f"{target_name} (definition {definition_id}) generated-C stack frame is {size} bytes "
            f"(limit {stack_limit_bytes}); function={function_name}"
        )
        failed = True
    else:
        print(
            "PASS: "
            f"{target_name} (definition {definition_id}) generated-C stack frame is {size} bytes "
            f"(limit {stack_limit_bytes})"
        )

sys.exit(1 if failed else 0)
PY
