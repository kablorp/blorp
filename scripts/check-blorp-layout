#!/usr/bin/env python3
"""Validate Blorp source ownership and mirrored test-layout invariants."""

from __future__ import annotations

import argparse
import json
import re
import sys
from collections import defaultdict
from pathlib import Path


# One module entry of an `import:` block: `path`, `path as Alias`, `path: symbols`
# or `path as Alias: symbols`, one indent in. Deeper lines are the symbols of
# the entry above, not modules. A module imported without symbols (`path` or
# `path as Alias`) has no colon, so it must match too: it is still an import.
IMPORT_MODULE = re.compile(
	r"^\t([./A-Za-z0-9_-]+)(?:\s+as\s+[A-Za-z0-9_]+)?(?::|\s*$)"
)
TEST_SUFFIXES = {".brp", ".py", ".sh"}


def parse_arguments(arguments: list[str]) -> argparse.Namespace:
	parser = argparse.ArgumentParser(description=__doc__)
	parser.add_argument("--root", type=Path, default=Path.cwd())
	parser.add_argument("--manifest", type=Path)
	return parser.parse_args(arguments)


def load_manifest(path: Path) -> dict[str, object]:
	with path.open(encoding="utf-8") as source:
		manifest = json.load(source)
	if manifest.get("version") != 1:
		raise ValueError("source ownership manifest version must be 1")
	return manifest


def source_imports(path: Path) -> list[str]:
	"""Import module names of a real Blorp source, which must be UTF-8.

	Fixture inputs are not sources and never reach this function: they may
	contain invalid bytes on purpose (see `test_module_sources`).
	"""
	imports: list[str] = []
	in_import_block = False
	try:
		text = path.read_text(encoding="utf-8")
	except UnicodeDecodeError as error:
		raise ValueError(
			f"{path} is not valid UTF-8 at byte {error.start}: "
			"Blorp sources must be UTF-8"
		) from error
	for line in text.splitlines():
		if line == "import:":
			in_import_block = True
			continue
		if not in_import_block:
			continue
		if line and not line[0].isspace():
			break
		match = IMPORT_MODULE.match(line)
		if match is not None:
			imports.append(match.group(1))
	return imports


def is_within(path: Path, root: Path) -> bool:
	try:
		path.relative_to(root)
		return True
	except ValueError:
		return False


def resolve_import(source: Path, module: str, source_root: Path) -> Path | None:
	if module.startswith("."):
		return (source.parent / f"{module}.brp").resolve()
	local_candidate = source.parent / f"{module}.brp"
	if local_candidate.is_file():
		return local_candidate.resolve()
	root_candidate = source_root / f"{module}.brp"
	if root_candidate.is_file():
		return root_candidate.resolve()
	return None


def module_owner(path: Path, source_root: Path, owners: set[str]) -> str | None:
	relative = path.relative_to(source_root)
	if len(relative.parts) == 1:
		return None
	return relative.parts[0] if relative.parts[0] in owners | {"lib"} else None


def test_module_sources(
	test_root: Path,
	owner_test_root: Path,
	fixture_directories: set[str],
) -> list[Path]:
	"""Test modules below an owner's test tree, excluding fixture inputs.

	A fixture is test data for the compiler under test, not a module of the
	owner: its imports do not count toward isolation and its bytes may be
	deliberately invalid UTF-8.
	"""
	return [
		test
		for test in sorted(owner_test_root.rglob("*.brp"))
		if not fixture_directories.intersection(
			test.relative_to(test_root).parts[:-1]
		)
	]


def validate_test_names(
	test_root: Path,
	fixture_directories: set[str],
	test_support_paths: set[str],
	errors: list[str],
) -> None:
	if not test_root.exists():
		return
	for path in sorted(test_root.rglob("*")):
		if not path.is_file() or path.suffix not in TEST_SUFFIXES:
			continue
		relative = path.relative_to(test_root)
		if fixture_directories.intersection(relative.parts[:-1]):
			continue
		if str(relative) in test_support_paths:
			continue
		if not path.name.startswith("test_"):
			errors.append(f"test module must start with test_: {relative}")


def validate_isolated_test_imports(
	source_root: Path,
	test_root: Path,
	isolated_test_owners: set[str],
	fixture_directories: set[str],
	errors: list[str],
) -> None:
	"""Tests of an isolated owner import only that owner, lib and their own tree.

	Bare imports that resolve to no repository file are standard-library
	modules (such as `test`) and are allowed.
	"""
	for owner in sorted(isolated_test_owners):
		owner_test_root = test_root / owner
		if not owner_test_root.is_dir():
			continue
		allowed_source_roots = [
			(source_root / owner).resolve(),
			(source_root / "lib").resolve(),
		]
		for test in test_module_sources(test_root, owner_test_root, fixture_directories):
			relative = test.relative_to(test_root)
			for module in source_imports(test):
				target = resolve_import(test, module, source_root)
				if target is None:
					if module.startswith("."):
						errors.append(f"unresolved relative import {module}: {relative}")
					continue
				if is_within(target, owner_test_root.resolve()):
					continue
				if any(is_within(target, allowed) for allowed in allowed_source_roots):
					continue
				errors.append(
					f"isolated test owner {owner} may import only {owner}, lib and its own tests: "
					f"{relative} imports {module}"
				)


def validate_isolated_reachability(
	source_root: Path,
	test_root: Path,
	isolated_test_owners: set[str],
	owner_sources: dict[str, set[Path]],
	graph: dict[Path, set[Path]],
	fixture_directories: set[str],
	errors: list[str],
) -> None:
	"""An isolated owner reaches only itself and lib, also through lib.

	`lib` may import `compiler`, so a direct-import check alone would let an
	isolated owner depend on another owner through a shared module. The
	owner's sources and the lib modules its tests import are followed
	transitively.
	"""
	lib_root = (source_root / "lib").resolve()
	for owner in sorted(isolated_test_owners):
		owner_root = (source_root / owner).resolve()
		starts = set(owner_sources.get(owner, set()))
		owner_test_root = test_root / owner
		if owner_test_root.is_dir():
			for test in test_module_sources(test_root, owner_test_root, fixture_directories):
				for module in source_imports(test):
					target = resolve_import(test, module, source_root)
					if target is not None and is_within(target, lib_root):
						starts.add(target)
		for path in sorted(reachable(graph, starts)):
			if is_within(path, owner_root) or is_within(path, lib_root):
				continue
			errors.append(
				f"isolated owner {owner} reaches another owner through lib: "
				f"{path.relative_to(source_root)}"
			)


def reachable(graph: dict[Path, set[Path]], starts: set[Path]) -> set[Path]:
	seen: set[Path] = set()
	pending = list(starts)
	while pending:
		current = pending.pop()
		if current in seen:
			continue
		seen.add(current)
		pending.extend(graph.get(current, set()) - seen)
	return seen


def validate_layout(root: Path, manifest: dict[str, object]) -> list[str]:
	errors: list[str] = []
	source_root = (root / str(manifest["source_root"])).resolve()
	test_root = (root / str(manifest["test_root"])).resolve()
	owners = set(str(owner) for owner in manifest["owner_roots"])
	composition_roots = set(str(path) for path in manifest["composition_roots"])
	legacy_roots = [
		(root / str(path)).resolve()
		for path in manifest.get("legacy_source_roots", [])
	]
	forbidden_top_level_paths = [
		root / str(path)
		for path in manifest.get("forbidden_top_level_paths", [])
	]
	legacy_owner_paths = [
		(source_root / str(path)).resolve()
		for path in manifest.get("legacy_owner_paths", [])
	]
	legacy_owner_importers = {
		str(path): set(str(importer) for importer in importers)
		for path, importers in dict(
			manifest.get("legacy_owner_importers", {})
		).items()
	}
	legacy_owner_roots = {
		str(path): (source_root / str(path)).resolve()
		for path in manifest.get("legacy_owner_paths", [])
	}
	temporary_cross_owner_imports = {
		str(importer): set(str(target) for target in targets)
		for importer, targets in dict(
			manifest.get("temporary_cross_owner_imports", {})
		).items()
	}
	observed_temporary_cross_owner_imports: dict[str, set[str]] = defaultdict(set)
	fixture_directories = set(
		str(path) for path in manifest.get("fixture_directories", [])
	)
	shared_consumers = {
		str(path): [str(owner) for owner in consumers]
		for path, consumers in dict(
			manifest.get("shared_module_consumers", {})
		).items()
	}
	test_support_paths = set(
		str(path) for path in manifest.get("test_support_paths", [])
	)
	isolated_test_owners = set(
		str(owner) for owner in manifest.get("isolated_test_owners", [])
	)
	for owner in sorted(isolated_test_owners - owners):
		errors.append(f"isolated test owner is not a registered owner: {owner}")

	if not source_root.is_dir():
		return [f"source root does not exist: {source_root}"]
	for path in forbidden_top_level_paths:
		if path.exists():
			errors.append(
				f"forbidden top-level path exists: {path.relative_to(root)}"
			)
	for legacy_owner in sorted(set(legacy_owner_importers) - set(legacy_owner_roots)):
		errors.append(f"importers declared for unknown legacy owner: {legacy_owner}")

	sources = sorted(path.resolve() for path in source_root.rglob("*.brp"))
	graph: dict[Path, set[Path]] = defaultdict(set)
	owner_sources: dict[str, set[Path]] = defaultdict(set)
	observed_legacy_owner_importers: dict[str, set[str]] = defaultdict(set)

	for source in sources:
		relative = source.relative_to(source_root)
		owner = module_owner(source, source_root, owners)
		if len(relative.parts) == 1 and str(relative) not in composition_roots:
			errors.append(f"unregistered source-root module: {relative}")
		if len(relative.parts) > 1 and owner is None:
			errors.append(f"unregistered source owner: {relative.parts[0]} ({relative})")
		if owner is not None and owner != "lib":
			owner_sources[owner].add(source)
		if "tests" in relative.parts:
			errors.append(f"test directory is not allowed under source root: {relative}")
		if "test" in relative.parts[1:-1]:
			errors.append(f"nested test directory is not allowed under source root: {relative}")
		if fixture_directories.intersection(relative.parts[:-1]):
			errors.append(f"fixture directory is not allowed under source root: {relative}")
		in_legacy_owner = any(
			is_within(source, legacy_owner_path)
			for legacy_owner_path in legacy_owner_paths
		)
		if source.name.startswith("test_") and not in_legacy_owner:
			errors.append(f"test-shaped module is not allowed under source root: {relative}")

		for module in source_imports(source):
			target = resolve_import(source, module, source_root)
			if target is None:
				if module.startswith("."):
					errors.append(f"unresolved relative import {module}: {relative}")
				continue
			if is_within(target, source_root):
				graph[source].add(target)
				for legacy_owner, legacy_owner_root in legacy_owner_roots.items():
					if not is_within(target, legacy_owner_root):
						continue
					if is_within(source, legacy_owner_root):
						break
					observed_legacy_owner_importers[legacy_owner].add(str(relative))
					allowed_importers = legacy_owner_importers.get(legacy_owner, set())
					if str(relative) not in allowed_importers:
						errors.append(
							f"unregistered legacy-owner import into {legacy_owner}: "
							f"{relative} imports {target.relative_to(source_root)}"
						)
					break
				target_owner = module_owner(target, source_root, owners)
				if owner is None:
					continue
				if owner == "lib":
					allowed = target_owner in {"lib", "compiler"}
				else:
					allowed = target_owner in {owner, "lib"}
				if not allowed:
					importer = str(relative)
					target_relative = str(target.relative_to(source_root))
					if target_relative in temporary_cross_owner_imports.get(importer, set()):
						observed_temporary_cross_owner_imports[importer].add(target_relative)
						continue
					errors.append(
						f"cross-owner import {owner} -> {target_owner}: "
						f"{relative} imports {target.relative_to(source_root)}"
					)
				continue
			if not any(is_within(target, legacy_root) for legacy_root in legacy_roots):
				errors.append(f"import escapes registered source roots: {relative} -> {target}")

	for legacy_owner, importers in sorted(legacy_owner_importers.items()):
		for importer in sorted(importers - observed_legacy_owner_importers[legacy_owner]):
			errors.append(
				f"stale legacy-owner importer permission into {legacy_owner}: {importer}"
			)

	for importer, targets in sorted(temporary_cross_owner_imports.items()):
		for target in sorted(targets - observed_temporary_cross_owner_imports[importer]):
			errors.append(
				f"stale temporary cross-owner import permission: {importer} -> {target}"
			)

	lib_root = source_root / "lib"
	lib_modules = {
		str(path.relative_to(lib_root)): path.resolve()
		for path in sorted(lib_root.rglob("*.brp"))
	} if lib_root.is_dir() else {}
	if set(lib_modules) != set(shared_consumers):
		for missing in sorted(set(lib_modules) - set(shared_consumers)):
			errors.append(f"shared module has no consumer declaration: {missing}")
		for stale in sorted(set(shared_consumers) - set(lib_modules)):
			errors.append(f"consumer declaration has no shared module: {stale}")

	reachable_by_owner = {
		owner: reachable(graph, starts)
		for owner, starts in owner_sources.items()
	}
	for module, consumers in sorted(shared_consumers.items()):
		if len(set(consumers)) < 2:
			errors.append(f"shared module requires two distinct consumers: {module}")
		for consumer in consumers:
			if consumer not in owners:
				errors.append(f"unknown shared-module consumer {consumer}: {module}")
				continue
			if module in lib_modules and lib_modules[module] not in reachable_by_owner.get(
				consumer,
				set(),
			):
				errors.append(f"declared consumer {consumer} cannot reach {module}")

	validate_isolated_reachability(
		source_root,
		test_root,
		isolated_test_owners,
		owner_sources,
		graph,
		fixture_directories,
		errors,
	)
	validate_test_names(test_root, fixture_directories, test_support_paths, errors)
	validate_isolated_test_imports(
		source_root,
		test_root,
		isolated_test_owners,
		fixture_directories,
		errors,
	)
	return errors


def main(arguments: list[str]) -> int:
	options = parse_arguments(arguments)
	root = options.root.resolve()
	manifest_path = options.manifest or root / "blorp/source_ownership.json"
	try:
		manifest = load_manifest(manifest_path)
		errors = validate_layout(root, manifest)
	except (OSError, ValueError, KeyError, TypeError, json.JSONDecodeError) as error:
		print(f"error: {error}", file=sys.stderr)
		return 1
	for error in errors:
		print(f"error: {error}", file=sys.stderr)
	return 1 if errors else 0


if __name__ == "__main__":
	raise SystemExit(main(sys.argv[1:]))
