#!/usr/bin/env python3
"""Hold a POSIX build lock across exec when the flock utility is unavailable."""

import fcntl
import os
import sys


def main() -> int:
    lock_path, *command = sys.argv[1:]
    try:
        descriptor = os.open(lock_path, os.O_CREAT | os.O_RDWR, 0o600)
        fcntl.flock(descriptor, fcntl.LOCK_EX)
        # Keep the kernel lock attached to the command until it exits, even
        # when the wrapper itself is replaced by exec.
        os.set_inheritable(descriptor, True)
        os.execvpe(command[0], command, os.environ)
    except OSError as error:
        print(f"error: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
