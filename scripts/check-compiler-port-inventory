#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "$0")" && pwd -P)"
repo_root="$(cd "$script_dir/.." && pwd -P)"
cd "$repo_root"

inventory="compiler/blorp/src/stage_99_meta/ocaml_port_inventory.tsv"

# These OCaml Core implementations were retired after the Blorp-owned semantic
# middle became the production path. Keep them deleted: implementation-only
# tests are not a reason to restore a superseded compiler stage.
retired_ocaml_core_paths=(
    compiler/lib/core.ml
    compiler/lib/core_error.ml
    compiler/lib/core_layout_type.ml
    compiler/lib/core_layout_type.mli
    compiler/lib/core_option_layout.ml
    compiler/lib/core_ownership.ml
    compiler/lib/core_tensor_type.ml
    compiler/lib/core_tensor_type.mli
    compiler/test/test_core.ml
    compiler/test/test_core_layout_type.ml
    compiler/test/test_core_option_layout.ml
    compiler/test/test_core_ownership.ml
    compiler/test/test_core_tensor_type.ml
)

retired_path_found=0
for path in "${retired_ocaml_core_paths[@]}"; do
    if [ -e "$path" ]; then
        echo "Retired OCaml Core path must remain deleted: $path" >&2
        retired_path_found=1
    fi
done
if [ "$retired_path_found" -ne 0 ]; then
    exit 1
fi

if [ ! -f "$inventory" ]; then
    echo "Missing compiler port inventory: $inventory" >&2
    exit 1
fi

tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/blorp-port-inventory.XXXXXX")
trap 'rm -rf "$tmp_dir"' EXIT

tracked_sources="$tmp_dir/tracked"
inventory_paths="$tmp_dir/inventory-paths"

git ls-files --cached --others --exclude-standard \
    'compiler/lib/*.ml' \
    'compiler/lib/*.mli' \
    'compiler/lib/*.mll' \
    'compiler/lib/*.mly' \
    'compiler/bin/*.ml' \
    'compiler/tools/*.ml' |
    while IFS= read -r path; do
        [ -e "$path" ] && printf '%s\n' "$path"
    done |
    LC_ALL=C sort > "$tracked_sources"

awk -F '\t' '
    /^#/ || NF == 0 { next }
    NF != 2 {
        printf "%s:%d: expected path<TAB>migration_group\n", FILENAME, FNR > "/dev/stderr"
        bad = 1
        next
    }
    $1 == "" || $2 == "" {
        printf "%s:%d: inventory fields cannot be empty\n", FILENAME, FNR > "/dev/stderr"
        bad = 1
        next
    }
    $2 !~ /^(bridge|backend|final_core|middle_core|lowering|ctfe|type_system|parser|tools)$/ {
        printf "%s:%d: unknown migration group `%s`\n", FILENAME, FNR, $2 > "/dev/stderr"
        bad = 1
    }
    { print $1 }
    END { if (bad) exit 1 }
' "$inventory" | LC_ALL=C sort > "$inventory_paths"

duplicates=$(awk -F '\t' '/^#/ || NF == 0 { next } { print $1 }' "$inventory" | LC_ALL=C sort | uniq -d)
if [ -n "$duplicates" ]; then
    echo "Duplicate paths in compiler port inventory:" >&2
    echo "$duplicates" >&2
    exit 1
fi

if ! diff -u "$tracked_sources" "$inventory_paths" > "$tmp_dir/inventory.diff"; then
    echo "Compiler port inventory is out of sync." >&2
    echo "Every production OCaml source in the working tree must be classified before it is merged." >&2
    cat "$tmp_dir/inventory.diff" >&2
    exit 1
fi

check_grep_allowlist() {
    local label="$1"
    local pattern="$2"
    shift 2
    local allowed_path line file bad
    bad=0

    while IFS= read -r line; do
        [ -n "$line" ] || continue
        file=${line%%:*}
        for allowed_path in "$@"; do
            if [ "$file" = "$allowed_path" ]; then
                continue 2
            fi
        done
        if [ "$bad" -eq 0 ]; then
            echo "$label is outside the allowed migration boundary:" >&2
        fi
        echo "$line" >&2
        bad=1
    done < <(git grep -n -E "$pattern" -- compiler/bin compiler/lib compiler/tools || true)

    if [ "$bad" -ne 0 ]; then
        exit 1
    fi
}

check_grep_allowlist \
    "Hidden compiler bridge command reference" \
    'BLORP_COMPILER_BRIDGE_BIN|BLORP_COMPILER_PARSER_BRIDGE_BIN|BLORP_COMPILER_REQUIRE_PREPARED_BRIDGE|compiler_parser_bridge_cli\.brp' \
    compiler/bin/blorp_ocaml_host.ml \
    compiler/lib/compiler_blorp_bridge.ml

check_grep_allowlist \
    "Hidden bootstrap compile command reference" \
    '__compiler-bootstrap-compile'

check_grep_allowlist \
    "Bootstrap parser session mode reference" \
    'bootstrap_menhir_parser'

check_grep_allowlist \
    "Retired frontend parser selector reference" \
    'BLORP_FRONTEND_PARSER|frontend_parser|OcamlParser|BlorpBridgeParser' \
    compiler/lib/compiler_blorp_bridge.ml

check_grep_allowlist \
    "Direct Menhir parser bootstrap reference" \
    'Parser\.program|Lexer\.next_token|parse_source_with_bootstrap_menhir|parse_expr_string_with_menhir|transform_program_with_bootstrap_menhir_expr_parser'

check_grep_allowlist \
    "Direct Blorp template manifest access" \
    'Core_emit_blorp_[A-Za-z0-9_]*_templates|core_emit_blorp_[A-Za-z0-9_]*_templates\.tsv|Core_emit_blorp_template\.(create|render_exn|emit|find)'

legacy_pipeline_pattern='(Blorp\.)?Pipeline\.(compile_legacy_direct_source|compile|typecheck_only|typecheck_only_typed|typecheck_module_only_typed|typecheck_source_package_module_only_typed)\b'
legacy_pipeline_bad=0

while IFS= read -r line; do
    [ -n "$line" ] || continue
    file=${line%%:*}
    allowed=0

    case "$file" in
        compiler/lib/pipeline.ml|compiler/lib/pipeline.mli|compiler/lib/package_check.ml|compiler/lib/repl.ml)
            allowed=1
            ;;
        compiler/bin/blorp_ocaml_host.ml)
            case "$line" in
                *"Pipeline.typecheck_module_only_typed"*)
                    allowed=1
                    ;;
            esac
            ;;
    esac

    if [ "$allowed" -eq 0 ]; then
        if [ "$legacy_pipeline_bad" -eq 0 ]; then
            echo "Legacy direct-source pipeline reference is outside the allowed migration boundary:" >&2
        fi
        echo "$line" >&2
        legacy_pipeline_bad=1
    fi
done < <(git grep -n -E "$legacy_pipeline_pattern" -- compiler/bin compiler/lib compiler/tools || true)

if [ "$legacy_pipeline_bad" -ne 0 ]; then
    exit 1
fi

if git grep -n '../stage_10_backend' -- \
    compiler/blorp/src/stage_09_core/compiler_core_pipeline.brp
then
    echo "Stage 09 Core pipeline must not depend on the Stage 10 backend." >&2
    exit 1
fi

echo "Compiler port inventory check passed."
