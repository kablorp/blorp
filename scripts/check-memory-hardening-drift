#!/usr/bin/env python3
"""Check the memory hardening matrix stays in sync with leak gate roots."""

from __future__ import annotations

import fnmatch
import pathlib
import re
import shlex
import sys


ROOT = pathlib.Path(__file__).resolve().parents[1]
ROADMAP = ROOT / "docs" / "0.1_MEMORY_HARDENING.md"
TEST_SCRIPT = ROOT / "scripts" / "test"

LEAK_ROOT_START = "leak_roots=("
MATRIX_START = "| Feature | Official leak coverage / tracked gap |"
MATRIX_END = "Done when: each row has either"


def display(path: pathlib.Path) -> str:
    return path.relative_to(ROOT).as_posix()


def parse_leak_roots() -> list[str]:
    roots: list[str] = []
    in_array = False
    for line in TEST_SCRIPT.read_text().splitlines():
        stripped = line.strip()
        if stripped == LEAK_ROOT_START:
            in_array = True
            continue
        if not in_array:
            continue
        if stripped == ")":
            return roots
        if not stripped or stripped.startswith("#"):
            continue
        # Keep this parser intentionally narrow: leak_roots is a literal shell
        # array of paths, not arbitrary script.
        roots.extend(shlex.split(stripped))

    raise ValueError("could not find leak_roots array in scripts/test")


def phase_5_table_lines() -> list[str]:
    lines = ROADMAP.read_text().splitlines()
    try:
        start = next(i for i, line in enumerate(lines) if line == MATRIX_START)
    except StopIteration as exc:
        raise ValueError("could not find Phase 5 memory risk matrix") from exc

    rows: list[str] = []
    for line in lines[start + 2 :]:
        if line.startswith(MATRIX_END):
            break
        if line.startswith("|"):
            rows.append(line)
    if not rows:
        raise ValueError("Phase 5 memory risk matrix has no rows")
    return rows


def normalize_doc_link(target: str) -> str | None:
    if not target.startswith("../tests/"):
        return None
    normalized = target.removeprefix("../")
    if "#" in normalized:
        normalized = normalized.split("#", 1)[0]
    return normalized


def matrix_links_by_row() -> list[tuple[str, list[str]]]:
    rows: list[tuple[str, list[str]]] = []
    link_re = re.compile(r"\]\(([^)]+)\)")
    for line in phase_5_table_lines():
        cells = [cell.strip() for cell in line.strip("|").split("|")]
        feature = cells[0] if cells else "<unknown feature>"
        links = [
            normalized
            for target in link_re.findall(line)
            if (normalized := normalize_doc_link(target)) is not None
        ]
        rows.append((feature, links))
    return rows


def covered_by_root(path: str, root: str) -> bool:
    if any(char in root for char in "*?["):
        return fnmatch.fnmatch(path, root)
    if root.endswith("/"):
        return path == root or path.startswith(root)
    return path == root


def covered_by_any_root(path: str, roots: list[str]) -> bool:
    return any(covered_by_root(path, root) for root in roots)


def root_represented_by_matrix(root: str, links: set[str]) -> bool:
    if any(char in root for char in "*?["):
        return True
    if root.endswith("/"):
        return root in links or any(link.startswith(root) for link in links)
    return root in links


def main() -> int:
    errors: list[str] = []
    roots = parse_leak_roots()
    rows = matrix_links_by_row()
    matrix_links = {link for _, links in rows for link in links}

    for feature, links in rows:
        if not links:
            errors.append(f"matrix row has no test links: {feature}")
            continue
        covered_links = [link for link in links if covered_by_any_root(link, roots)]
        if not covered_links:
            errors.append(
                f"matrix row is not covered by scripts/test leak_roots: {feature}"
            )

    for link in sorted(matrix_links):
        path = ROOT / link
        if not path.exists():
            errors.append(f"matrix link does not exist: {link}")

    for root in roots:
        if any(char in root for char in "*?["):
            matches = sorted(ROOT.glob(root))
            if not matches:
                errors.append(f"leak root glob matches no files: {root}")
            continue
        path = ROOT / root
        if not path.exists():
            errors.append(f"leak root does not exist: {root}")
        if not root_represented_by_matrix(root, matrix_links):
            errors.append(f"leak root is missing from Phase 5 matrix: {root}")

    if errors:
        print("memory hardening drift check failed:", file=sys.stderr)
        for error in errors:
            print(error, file=sys.stderr)
        return 1

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
