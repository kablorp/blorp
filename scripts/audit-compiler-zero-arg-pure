#!/usr/bin/env bash

set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
STRICT=0

if [[ ${1:-} == "--strict" ]]; then
	STRICT=1
elif [[ $# -ne 0 ]]; then
	echo "usage: scripts/audit-compiler-zero-arg-pure [--strict]" >&2
	exit 2
fi

MATCHES=$(
	while IFS= read -r -d '' FILE; do
		perl -0777 -ne '
			while (/^\h*(?:private )?pure func ([A-Za-z_][A-Za-z0-9_]*)\(\s*\)/mg) {
				$prefix = substr($_, 0, $-[0]);
				$line = 1 + ($prefix =~ tr/\n//);
				print "$ARGV:$line:$1\n";
			}
	' "$FILE"
	done < <(rg --files -0 "$ROOT/compiler/blorp/src" --glob '*.brp')
)

PATH_IDENTITY_EXEMPTION="$ROOT/compiler/blorp/src/stage_01_file_io/path_identity.brp"
CORE_FACTORY_EXEMPTION="$ROOT/compiler/blorp/src/stage_09_core/core_synth_string.brp"
SIGNAL_BUILTIN_EXEMPTION="$ROOT/compiler/blorp/src/stage_12_cli/cli_signal_broker.brp"
FILTERED_MATCHES=""
EXEMPTION_COUNT=0

while IFS= read -r MATCH; do
	[[ -z $MATCH ]] && continue

	case $MATCH in
		# Foreign platform probes cannot be evaluated by CTFE.
		"$PATH_IDENTITY_EXEMPTION":*:compiler_path_host_is_windows)
			EXEMPTION_COUNT=$((EXEMPTION_COUNT + 1))
			;;
		# This Core factory has an indirect global dependency during CTFE setup.
		"$CORE_FACTORY_EXEMPTION":*:append_replacement_character)
			EXEMPTION_COUNT=$((EXEMPTION_COUNT + 1))
			;;
		# Runtime builtins require a declared zero-argument return type.
		"$SIGNAL_BUILTIN_EXEMPTION":*:interrupt_signal_number|\
		"$SIGNAL_BUILTIN_EXEMPTION":*:terminate_signal_number)
			EXEMPTION_COUNT=$((EXEMPTION_COUNT + 1))
			;;
		*)
			FILTERED_MATCHES+="${FILTERED_MATCHES:+$'\n'}$MATCH"
			;;
	esac
done <<< "$MATCHES"

MATCHES=$FILTERED_MATCHES

if [[ -z $MATCHES ]]; then
	echo "production zero-argument pure functions: 0"
	echo "documented zero-argument exemptions: $EXEMPTION_COUNT"
	exit 0
fi

COUNT=$(printf '%s\n' "$MATCHES" | wc -l | tr -d ' ')
echo "production zero-argument pure functions: $COUNT"
echo "documented zero-argument exemptions: $EXEMPTION_COUNT"
printf '%s\n' "$MATCHES" | sed "s|$ROOT/||"

if [[ $STRICT -eq 1 ]]; then
	exit 1
fi
