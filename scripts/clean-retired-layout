#!/bin/bash
# Remove generated artifacts that can keep retired top-level layout roots alive.
set -euo pipefail

root="${1:-.}"

for generated_directory in \
	"$root/compiler/_build" \
	"$root/compiler/_coverage"
do
	if [ -d "$generated_directory" ]; then
		rm -rf "$generated_directory"
	fi
done

if [ -d "$root/tests" ]; then
	find "$root/tests" -type d -name __pycache__ -prune -exec rm -rf {} +
	while IFS= read -r generated_c; do
		first_line=""
		IFS= read -r first_line <"$generated_c" || true
		if [ "$first_line" = '/* Generated by blorp compiler */' ]; then
			rm -f "$generated_c"
		fi
	done < <(find "$root/tests" -type f -name '*.c' -print)
fi

for retired_root in "$root/compiler" "$root/tests"; do
	if [ -d "$retired_root" ]; then
		find "$retired_root" -depth -type d -empty -delete
	fi
done
