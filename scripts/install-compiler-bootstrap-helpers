#!/usr/bin/env bash
# Install one complete, verified compiler bridge helper generation.

set -euo pipefail

if [ "$#" -ne 4 ]; then
	echo "Usage: $0 TOOLCHAIN_DIR INSTALL_DIR STAMP_PATH INSTALL_ID" >&2
	exit 2
fi

toolchain_dir=$1
install_dir=$2
stamp_path=$3
install_id=$4
helpers=(
	blorp-compiler-renderer
	blorp-compiler-parser
	blorp-compiler-typecheck
)

for helper in "${helpers[@]}"; do
	source_path="$toolchain_dir/$helper"
	if [ ! -f "$source_path" ] || [ ! -x "$source_path" ]; then
		echo "Pinned compiler helper is missing or not executable: $source_path" >&2
		exit 1
	fi
done

installed_id=$(cat "$stamp_path" 2>/dev/null || true)
needs_install=0
if [ "$installed_id" != "$install_id" ]; then
	needs_install=1
fi

for helper in "${helpers[@]}"; do
	source_path="$toolchain_dir/$helper"
	target_path="$install_dir/$helper"
	if [ -L "$target_path" ] ||
		{ [ -e "$target_path" ] && [ ! -f "$target_path" ]; }
	then
		echo "Refusing to replace non-regular compiler helper target: $target_path" >&2
		exit 1
	fi
	if [ ! -f "$target_path" ] ||
		[ ! -x "$target_path" ] ||
		! cmp -s "$source_path" "$target_path"
	then
		needs_install=1
	fi
done

if [ "$needs_install" -eq 0 ]; then
	exit 0
fi

mkdir -p "$install_dir"
stamp_dir=$(dirname "$stamp_path")
mkdir -p "$stamp_dir"
stage_dir=$(mktemp -d "$install_dir/.blorp-bootstrap-helpers.XXXXXX")
stamp_tmp=$(mktemp "$stamp_dir/.installed-bootstrap.XXXXXX")
cleanup() {
	rm -rf "$stage_dir"
	rm -f "$stamp_tmp"
}
trap cleanup EXIT

for helper in "${helpers[@]}"; do
	source_path="$toolchain_dir/$helper"
	staged_path="$stage_dir/$helper"
	cp "$source_path" "$staged_path"
	chmod +x "$staged_path"
	if ! cmp -s "$source_path" "$staged_path"; then
		echo "Failed to stage pinned compiler helper exactly: $helper" >&2
		exit 1
	fi
done

# The stamp moves last. If publication is interrupted, the old identity and
# byte checks make the next installation repair the incomplete generation.
for helper in "${helpers[@]}"; do
	mv "$stage_dir/$helper" "$install_dir/$helper"
done
for helper in "${helpers[@]}"; do
	source_path="$toolchain_dir/$helper"
	target_path="$install_dir/$helper"
	if [ -L "$target_path" ] ||
		[ ! -f "$target_path" ] ||
		[ ! -x "$target_path" ] ||
		! cmp -s "$source_path" "$target_path"
	then
		echo "Published compiler helper failed verification: $target_path" >&2
		exit 1
	fi
done
printf '%s\n' "$install_id" > "$stamp_tmp"
mv "$stamp_tmp" "$stamp_path"
