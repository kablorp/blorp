#!/usr/bin/env python3
"""Audit active issue handoffs for mechanical link and shape drift."""

from __future__ import annotations

import argparse
import json
import re
import sys
from dataclasses import dataclass
from pathlib import Path


INDEX_PATH = Path("docs/issues/README.md")
LINE_GUIDELINE = 300
MARKDOWN_LINK = re.compile(r"(?<!!)\[[^\]]+\]\(([^)]+)\)")
INDEX_LINK = re.compile(r"- \[[^\]]+\]\(([^)]+\.md(?:#[^)]+)?)\)")
HEADING = re.compile(r"^#{1,6}\s+(.+?)\s*$")


@dataclass(frozen=True)
class Finding:
	severity: str
	kind: str
	path: str
	message: str

	def to_json(self) -> dict[str, str]:
		return {
			"severity": self.severity,
			"kind": self.kind,
			"path": self.path,
			"message": self.message,
		}


def parse_arguments(arguments: list[str]) -> argparse.Namespace:
	parser = argparse.ArgumentParser(description=__doc__)
	parser.add_argument("--root", type=Path, default=Path.cwd())
	parser.add_argument(
		"--scope",
		action="append",
		type=Path,
		default=[],
		help="Issue directory or file to audit, relative to --root.",
	)
	parser.add_argument("--json", action="store_true", dest="as_json")
	return parser.parse_args(arguments)


def clean_link_target(target: str) -> tuple[str, str | None] | None:
	if "://" in target or target.startswith("mailto:"):
		return None
	path, separator, fragment = target.partition("#")
	return (path.strip(), fragment.strip() if separator else None)


def relative_path(path: Path, root: Path) -> str:
	return path.relative_to(root).as_posix()


def is_within(path: Path, parent: Path) -> bool:
	try:
		path.relative_to(parent)
		return True
	except ValueError:
		return False


def scope_contains(path: Path, scope: Path) -> bool:
	if scope.is_file():
		return path == scope
	return is_within(path, scope)


def resolve_scope(root: Path, scope: Path) -> Path:
	candidate = (root / scope).resolve()
	if not is_within(candidate, root.resolve()):
		raise ValueError(f"scope escapes repository root: {scope}")
	if not candidate.exists():
		raise ValueError(f"scope does not exist: {scope}")
	return candidate


def scoped_issue_files(scopes: list[Path], indexed_files: set[Path]) -> list[Path]:
	files: set[Path] = set()
	for scope in scopes:
		if scope.is_file():
			if is_issue_handoff(scope) or scope.resolve() in indexed_files:
				files.add(scope)
			continue
		for path in scope.rglob("*.md"):
			if is_issue_handoff(path) or path.resolve() in indexed_files:
				files.add(path)
	return sorted(files)


def is_issue_handoff(path: Path) -> bool:
	if path.name == "README.md":
		return False
	try:
		text = path.read_text(encoding="utf-8")
	except UnicodeDecodeError:
		return False
	return "**Status:**" in text or path.name[:2].isdigit()


def index_issue_links(root: Path) -> list[Path]:
	index = root / INDEX_PATH
	if not index.is_file():
		return []
	links: list[Path] = []
	for match in INDEX_LINK.finditer(index.read_text(encoding="utf-8")):
		cleaned = clean_link_target(match.group(1))
		if cleaned is None:
			continue
		target, _fragment = cleaned
		links.append((index.parent / target).resolve())
	return links


def add_index_findings(
	root: Path,
	scopes: list[Path],
	issue_files: list[Path],
	findings: list[Finding],
) -> None:
	index = root / INDEX_PATH
	index_links = index_issue_links(root)
	for link in index_links:
		if any(scope_contains(link, scope) for scope in scopes) and not link.is_file():
			findings.append(
				Finding(
					"error",
					"broken_index_link",
					relative_path(index, root),
					f"index link target is missing: {relative_path(link, root)}",
				)
			)
	index_link_set = set(index_links)
	for issue in issue_files:
		if issue.resolve() not in index_link_set:
			findings.append(
				Finding(
					"error",
					"unindexed_issue",
					relative_path(issue, root),
					"issue file is not linked from docs/issues/README.md",
				)
			)


def add_shape_findings(root: Path, issue: Path, findings: list[Finding]) -> None:
	text = issue.read_text(encoding="utf-8")
	relative = relative_path(issue, root)
	if "**Status:**" not in text:
		findings.append(
			Finding("error", "missing_status", relative, "issue is missing a Status field")
		)
	if re.search(r"^## Objective\s*$", text, re.MULTILINE) is None:
		findings.append(
			Finding(
				"error",
				"missing_objective",
				relative,
				"issue is missing a ## Objective section",
			)
		)
	line_count = len(text.splitlines())
	if line_count > LINE_GUIDELINE:
		findings.append(
			Finding(
				"warning",
				"long_document",
				relative,
				f"issue is {line_count} lines, above the {LINE_GUIDELINE}-line guideline",
			)
		)


def add_link_findings(root: Path, source: Path, findings: list[Finding]) -> None:
	text = source.read_text(encoding="utf-8")
	for match in MARKDOWN_LINK.finditer(text):
		cleaned = clean_link_target(match.group(1))
		if cleaned is None:
			continue
		target, fragment = cleaned
		if target == "":
			target_path = source.resolve()
		elif target.startswith("/"):
			target_path = (root / target.lstrip("/")).resolve()
		else:
			target_path = (source.parent / target).resolve()
		if not is_within(target_path, root.resolve()):
			findings.append(
				Finding(
					"error",
					"broken_local_link",
					relative_path(source, root),
					f"local link escapes repository root: {target}",
				)
			)
		elif not target_path.exists():
			findings.append(
				Finding(
					"error",
					"broken_local_link",
					relative_path(source, root),
					f"local link target is missing: {target}",
				)
			)
		elif fragment and target_path.suffix == ".md" and not has_markdown_anchor(
			target_path,
			fragment,
		):
			findings.append(
				Finding(
					"error",
					"broken_local_link",
					relative_path(source, root),
					f"local link anchor is missing: {target}#{fragment}",
				)
			)


def markdown_heading_slug(heading: str) -> str:
	text = re.sub(r"`([^`]*)`", r"\1", heading.strip().lower())
	text = re.sub(r"<[^>]+>", "", text)
	text = re.sub(r"[^\w\- ]+", "", text)
	return re.sub(r"\s+", "-", text.strip())


def markdown_anchors(path: Path) -> set[str]:
	anchors: set[str] = set()
	slug_counts: dict[str, int] = {}
	for line in path.read_text(encoding="utf-8").splitlines():
		match = HEADING.match(line)
		if match is not None:
			base_slug = markdown_heading_slug(match.group(1))
			count = slug_counts.get(base_slug, 0)
			slug_counts[base_slug] = count + 1
			anchors.add(base_slug if count == 0 else f"{base_slug}-{count}")
	return anchors


def has_markdown_anchor(path: Path, fragment: str) -> bool:
	return fragment in markdown_anchors(path)


def audit(root: Path, scopes: list[Path]) -> list[Finding]:
	resolved_root = root.resolve()
	resolved_scopes = [
		resolve_scope(resolved_root, scope)
		for scope in (scopes if scopes else [Path("docs/issues")])
	]
	issue_files = scoped_issue_files(resolved_scopes, set(index_issue_links(resolved_root)))
	findings: list[Finding] = []
	add_index_findings(resolved_root, resolved_scopes, issue_files, findings)
	for issue in issue_files:
		if issue == resolved_root / INDEX_PATH:
			continue
		add_shape_findings(resolved_root, issue, findings)
		add_link_findings(resolved_root, issue, findings)
	return sorted(findings, key=lambda finding: (finding.path, finding.kind, finding.message))


def render_text(findings: list[Finding]) -> str:
	severity_labels = {"error": "ERROR", "warning": "WARN"}
	lines = [
		f"{severity_labels[finding.severity]} {finding.kind} {finding.path}: {finding.message}"
		for finding in findings
	]
	errors = sum(1 for finding in findings if finding.severity == "error")
	warnings = sum(1 for finding in findings if finding.severity == "warning")
	lines.append(f"summary: errors={errors} warnings={warnings}")
	return "\n".join(lines) + "\n"


def render_json(findings: list[Finding]) -> str:
	errors = sum(1 for finding in findings if finding.severity == "error")
	warnings = sum(1 for finding in findings if finding.severity == "warning")
	payload = {
		"summary": {"errors": errors, "warnings": warnings},
		"findings": [finding.to_json() for finding in findings],
	}
	return json.dumps(payload, indent=2, sort_keys=True) + "\n"


def main(arguments: list[str]) -> int:
	args = parse_arguments(arguments)
	try:
		findings = audit(args.root, args.scope)
	except ValueError as error:
		print(f"error: {error}", file=sys.stderr)
		return 2
	if args.as_json:
		sys.stdout.write(render_json(findings))
	else:
		sys.stdout.write(render_text(findings))
	return 1 if any(finding.severity == "error" for finding in findings) else 0


if __name__ == "__main__":
	raise SystemExit(main(sys.argv[1:]))
