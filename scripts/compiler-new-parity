HASH_SYMBOL_KIND = "HashSymbol"
IDENTIFIER_KIND = "IdentifierToken"
DIMENSION_NAME_KIND = "DimensionNameToken"

# A token line is `start end Kind text`; the text is absent for kinds with
# none and never contains a raw newline (the dumpers escape it).
TOKEN_FIELDS_WITHOUT_TEXT = 3
TOKEN_FIELDS_WITH_TEXT = 4

# The fixtures that hold inputs the existing lexer reads wrongly and the stage
# reads as the language says. The nesting fixture is accepted by both, so token
# and adapter differences name it; the existing parser rejects the pipe-brace
# fixture, so only its verdict differs.
KNOWN_DIFFERENCES_FIXTURE = "blorp/test/test_compiler/tools/fixtures/known_differences/interpolation_nesting.brp"
KNOWN_PIPE_BRACES_FIXTURE = "blorp/test/test_compiler/tools/fixtures/known_differences/interpolation_pipe_braces.brp"

# Files on which the two front ends are known to disagree, with why. Each is a
# fixture that pins the disagreement; a file listed here must still disagree
# (so the entry is removed when the stage is fixed or the fixture deleted) and
# must still be in the corpus. Every other disagreement fails the gate.
KNOWN_DIVERGENCES: dict[str, str] = {
    KNOWN_DIFFERENCES_FIXTURE: (
        "interpolation nested three levels deep: the existing lexer reads it wrongly, "
        "the stage as the language says"
    ),
    KNOWN_PIPE_BRACES_FIXTURE: (
        "braces in an interpolated pipe string: the existing lexer reads every brace "
        "as a hole and finalization rejects a hole the source does not write as "
        "`${...}`; the stage reads only `${...}` as one"
    ),
}

# Files whose first parse diagnostic is reported at a different position by the
# two front ends, with why. Same discipline as `KNOWN_DIVERGENCES`: a file
# listed here must still differ and must still be in the corpus.
KNOWN_POSITION_DIVERGENCES: dict[str, str] = {
    "blorp/test/test_compiler_new/test_stage_01_discovery/test_parse/fixtures/should_fail/"
    "import_constructors_unclosed.brp": (
        "the existing parser reports the unclosed constructor list at the last "
        "constructor; discovery reports it at the token after the list"
    ),
    "blorp/test/test_compiler_new/test_stage_01_discovery/test_parse/fixtures/should_fail/"
    "interpolation_hole_two_expressions.brp": (
        "the existing parser re-parses the hole text on its own and reports a "
        "position inside the hole; discovery reports the second expression"
    ),
}


@dataclass(frozen=True)
class WordingDifference:
    """A first-diagnostic wording the two front ends deliberately disagree on.

    `legacy` is a regular expression the whole existing text must match;
    `discovery` is the text discovery must print, with `{name}` replaced by
    the expression's named group of that name. An entry that no file uses is an error, so
    the list cannot outlive the difference it names.
    """

    legacy: str
    discovery: str
    reason: str

    def allows(self, legacy_text: str, discovery_text: str) -> bool:
        found = re.fullmatch(self.legacy, legacy_text)
        if found is None:
            return False
        expected = self.discovery
        for name, text in found.groupdict().items():
            expected = expected.replace("{" + name + "}", text)
        return expected == discovery_text


@dataclass(frozen=True)
class AdapterDifference:
    """A field the legacy adapter and the existing parser deliberately disagree on.

    `path` is a regular expression the whole JSON path of the differing field
    must match (`decls[3].function.params[0].span.end_column`); `declaration`
    and `module` restrict the entry to a declaration name or a module path when
    they are not `None`. An entry no difference uses is an error, so the list
    cannot outlive the difference it names.
    """

    path: str
    reason: str
    declaration: str | None = None
    module: str | None = None

    def allows(self, difference: "AdapterFieldDifference") -> bool:
        return (
            re.fullmatch(self.path, difference.path) is not None
            and (self.declaration is None or self.declaration == difference.declaration)
            and (self.module is None or self.module == difference.module)
        )


# Fields on which the adapter's parsed AST differs from the existing parser's
# on purpose, each with why. The existing lexer reads interpolation nested three
# levels deep wrongly, and the stage reads it as the language says; the corpus
# holds it only in one fixture, which exists to show it. A difference that is
# not listed fails the gate.
ADAPTER_DIFFERENCES: tuple[AdapterDifference, ...] = (
    AdapterDifference(
        path=r"decls\[0\]\.function\.body\.items\[0\]\..*",
        reason=(
            "interpolation nested three levels deep: the existing lexer treats the "
            "innermost string's hole as text, the stage interpolates it"
        ),
        declaration="nesting",
        module=KNOWN_DIFFERENCES_FIXTURE,
    ),
)


# Why a message differs. Positions must still agree whatever the wording.
ADVICE_MOVED_TO_HELP = (
    "the existing message embeds its advice; discovery states the problem in "
    "the message and the advice in the help line"
)
POOR_EXISTING_TEXT = "the existing text names the wrong construct or an internal parse step"

WORDING_DIFFERENCES: tuple[WordingDifference, ...] = (
    WordingDifference(
        r"expected indented function body",
        "expected indented imports after `import:`",
        POOR_EXISTING_TEXT + " (a bare `import:` is not a function)",
    ),
    WordingDifference(
        r"expected indented function body",
        "expected indented variants",
        POOR_EXISTING_TEXT + " (a union's variants are not a function body)",
    ),
    WordingDifference(
        r"`(?P<keyword>\w+)` is a reserved keyword and cannot be used as a name; "
        r"choose another identifier such as `(?P=keyword)_name`",
        "`{keyword}` is a reserved keyword and cannot be used as a name",
        ADVICE_MOVED_TO_HELP,
    ),
    WordingDifference(
        r"`\?=` cannot bind to `_`; use a name for the unwrapped value",
        "`?=` cannot bind to `_`",
        ADVICE_MOVED_TO_HELP,
    ),
    WordingDifference(
        r"Field assignment is not supported\. Use record update syntax: \{ record \| field = value \}",
        "field assignment is not supported",
        ADVICE_MOVED_TO_HELP,
    ),
    WordingDifference(
        r"A condition cannot be an assignment\. Use `==` to compare, or assign on its own line "
        r"before the condition",
        "a condition cannot be an assignment",
        ADVICE_MOVED_TO_HELP,
    ),
    WordingDifference(
        r"An assignment is a statement, not an expression\. Assign on its own line first, then "
        r"use the name where the value is needed",
        "an assignment is a statement, not an expression",
        ADVICE_MOVED_TO_HELP,
    ),
    WordingDifference(
        r"expected trait bound",
        "expected trait name",
        "the existing text names the position (a bound); discovery names the construct (a trait)",
    ),
    WordingDifference(
        r"expected supertrait name",
        "expected trait name",
        "the existing text names the position (a supertrait); discovery names the construct (a trait)",
    ),
    WordingDifference(
        r"Parse error in interpolated expression: expected `=` after top-level variable declaration",
        "an interpolation hole must hold exactly one expression",
        POOR_EXISTING_TEXT + " (the hole text is re-parsed as a declaration)",
    ),
)

# A help line the two front ends deliberately word differently, as
# `WORDING_DIFFERENCES` does for messages.
HELP_DIFFERENCES: tuple[WordingDifference, ...] = ()

# Where the existing parser prints no help line, discovery may add one: every
# error teaches, so the added line is the improvement, not a divergence.
HELP_ADDED = "discovery teaches a correction where the existing parser prints none"

# The dumpers print one line per token; keep mismatch excerpts readable.
EXCERPT_LIMIT = 200

# Flags of the host C compile of a dumper: optimized enough that the corpus
# runs in seconds, with the wrapping integer semantics the runtime assumes.
C_COMPILE_FLAGS = ("-O1", "-fwrapv", "-w")
# A targeted run compiles its dumpers without optimization. Measured on the
# adapter differential (14 MB of C): `-O0` builds in 15 s instead of 92 s and
# runs the whole corpus 2.4 times slower (203 s instead of 84 s), so it wins
# whenever the run covers less than about two thirds of the corpus.
TARGETED_C_COMPILE_FLAGS = ("-O0", "-fwrapv", "-w")
# Native headers (`*_ffi.h`) the existing compiler's foreign declarations
# include, found beside the declaring module; only the adapter differential builds
# the whole compiler, but every dumper is given the directories.
C_INCLUDE_FLAGS = tuple(
    flag
    for directory in sorted({str(path.parent) for path in REPO_ROOT.glob("blorp/src/**/*_ffi.h")})
    for flag in ("-I", directory)
)
C_LINK_FLAGS = ("-lm", "-lpthread")
DEFAULT_C_COMPILER = "clang"
C_COMPILER_VARIABLE = "BLORP_CC"


@dataclass
class FileDump:
    """What one front end reported for one file."""

    tokens: list[str] = field(default_factory=list)
    lexer_diagnostics: int = 0
    parse_diagnostics: int = 0
    # The first parse diagnostic of a rejected file: `line:column`, message
    # and help (None when it has none or the file is accepted).
    first_position: str | None = None
    first_message: str | None = None
    first_help: str | None = None
    complete: bool = False


def parse_dump(text: str) -> dict[str, FileDump]:
    """Read a dumper's output: `== path`, token lines, then the two counts."""
    files: dict[str, FileDump] = {}
    current: FileDump | None = None
    for line in text.split("\n"):
        if line.startswith(FILE_HEADER_PREFIX):
            current = FileDump()
            files[line[len(FILE_HEADER_PREFIX):]] = current
        elif line.startswith(UNREADABLE_PREFIX):
            # Reported by a dumper that could not read a file: never complete.
            files[line[len(UNREADABLE_PREFIX):].split(":", 1)[0]] = FileDump()
            current = None
        elif current is None or not line:
            continue
        elif line.startswith(LEXER_COUNT_PREFIX):
            current.lexer_diagnostics = int(line[len(LEXER_COUNT_PREFIX):])
        elif line.startswith(PARSE_COUNT_PREFIX):
            current.parse_diagnostics = int(line[len(PARSE_COUNT_PREFIX):])
            current.complete = True
        elif line.startswith(FIRST_DIAGNOSTIC_PREFIX):
            position, _, message = line[len(FIRST_DIAGNOSTIC_PREFIX):].partition(" ")
            current.first_position = position
            current.first_message = message
        elif line.startswith(FIRST_HELP_PREFIX):
            current.first_help = line[len(FIRST_HELP_PREFIX):]
        else:
            current.tokens.append(line)
    return files


def merge_dimension_names(tokens: list[str]) -> list[str]:
    """Write the existing lexer's `#` and name pair as the one token the new
    lexer emits: a hash symbol directly followed (no gap) by an identifier."""
    merged: list[str] = []
    index = 0
    while index < len(tokens):
        hash_fields = tokens[index].split(" ", 2)
        if (
            hash_fields[2:] == [HASH_SYMBOL_KIND]
            and index + 1 < len(tokens)
        ):
            name_fields = tokens[index + 1].split(" ", TOKEN_FIELDS_WITH_TEXT - 1)
            if (
                len(name_fields) == TOKEN_FIELDS_WITH_TEXT
                and name_fields[2] == IDENTIFIER_KIND
                and name_fields[0] == hash_fields[1]
            ):
                merged.append(
                    f"{hash_fields[0]} {name_fields[1]} {DIMENSION_NAME_KIND} {name_fields[3]}"
                )
                index += 2
                continue
        merged.append(tokens[index])
        index += 1
    return merged


def excerpt(token_line: str) -> str:
    return token_line[:EXCERPT_LIMIT]


def file_mismatches(path: str, legacy: FileDump | None, discovery: FileDump | None) -> list[str]:
    """The disagreements between the two front ends on one file."""
    if legacy is None or not legacy.complete:
        return [f"{path}: the existing front end produced no dump"]
    if discovery is None or not discovery.complete:
        return [f"{path}: the discovery stage produced no dump"]

    problems: list[str] = []
    legacy_tokens = merge_dimension_names(legacy.tokens)
    if legacy_tokens != discovery.tokens:
        for position, (old, new) in enumerate(zip(legacy_tokens, discovery.tokens)):
            if old != new:
                problems.append(
                    f"{path}: first differing token #{position}\n"
                    f"    existing:  {excerpt(old)}\n"
                    f"    discovery: {excerpt(new)}"
                )
                break
        else:
            problems.append(
                f"{path}: token count differs: existing {len(legacy_tokens)}, "
                f"discovery {len(discovery.tokens)}"
            )
    if (legacy.lexer_diagnostics > 0) != (discovery.lexer_diagnostics > 0):
        problems.append(
            f"{path}: lexer diagnostics differ: existing {legacy.lexer_diagnostics}, "
            f"discovery {discovery.lexer_diagnostics}"
        )
    if (legacy.parse_diagnostics > 0) != (discovery.parse_diagnostics > 0):
        verdict = lambda count: "reject" if count > 0 else "accept"
        problems.append(
            f"{path}: verdict differs: existing {verdict(legacy.parse_diagnostics)} "
            f"({legacy.parse_diagnostics} diagnostics), discovery "
            f"{verdict(discovery.parse_diagnostics)} ({discovery.parse_diagnostics} diagnostics)"
        )
    return problems


@dataclass
class FirstDiagnosticTally:
    """What the first-diagnostic comparison saw, before any allowance."""

    compared: int = 0
    position_differences: int = 0
    message_differences: int = 0
    help_differences: int = 0
    helps_added: int = 0
    known_positions_used: set[str] = field(default_factory=set)
    wording_used: set[WordingDifference] = field(default_factory=set)
    help_wording_used: set[WordingDifference] = field(default_factory=set)


def allowed_wording(
    entries: tuple[WordingDifference, ...], legacy_text: str, discovery_text: str
) -> WordingDifference | None:
    for entry in entries:
        if entry.allows(legacy_text, discovery_text):
            return entry
    return None


def describe_first_diagnostic(dump: FileDump) -> str:
    help_text = f" / help: {dump.first_help}" if dump.first_help is not None else ""
    return f"{dump.first_position} {dump.first_message}{help_text}"


def first_diagnostic_problems(
    path: str,
    legacy: FileDump,
    discovery: FileDump,
    tally: FirstDiagnosticTally,
    known_positions: dict[str, str],
    wording: tuple[WordingDifference, ...],
    help_wording: tuple[WordingDifference, ...],
) -> list[str]:
    """The disagreements on the first diagnostic of a file both front ends reject.

    Position must agree unless the file is in `known_positions`; the message
    and help must agree unless an entry of `wording` or `help_wording` names
    the difference, or the existing parser printed no help.
    """
    if legacy.first_position is None and discovery.first_position is None:
        return []
    tally.compared += 1
    problems: list[str] = []
    excerpts = (
        f"    existing:  {describe_first_diagnostic(legacy)}\n"
        f"    discovery: {describe_first_diagnostic(discovery)}"
    )
    if legacy.first_position != discovery.first_position:
        tally.position_differences += 1
        if path in known_positions:
            tally.known_positions_used.add(path)
        else:
            problems.append(f"{path}: first diagnostic position differs\n{excerpts}")
    if legacy.first_message != discovery.first_message:
        tally.message_differences += 1
        entry = allowed_wording(wording, legacy.first_message or "", discovery.first_message or "")
        if entry is None:
            problems.append(f"{path}: first diagnostic message differs\n{excerpts}")
        else:
            tally.wording_used.add(entry)
    if legacy.first_help != discovery.first_help:
        tally.help_differences += 1
        if legacy.first_help is None and discovery.first_help is not None:
            tally.helps_added += 1
        else:
            entry = allowed_wording(
                help_wording, legacy.first_help or "", discovery.first_help or ""
            )
            if entry is None:
                problems.append(f"{path}: first diagnostic help differs\n{excerpts}")
            else:
                tally.help_wording_used.add(entry)
    return problems


def stale_allowance_problems(
    tally: FirstDiagnosticTally,
    known_positions: dict[str, str],
    wording: tuple[WordingDifference, ...],
    help_wording: tuple[WordingDifference, ...],
    corpus: set[str],
) -> list[str]:
    """Allowances over the whole corpus that no file needs any more."""
    problems: list[str] = []
    for path, reason in sorted(known_positions.items()):
        if path not in corpus:
            problems.append(
                f"{path}: listed in KNOWN_POSITION_DIVERGENCES ({reason}) but is not in the "
                "corpus; remove the entry"
            )
        elif path not in tally.known_positions_used:
            problems.append(
                f"{path}: listed in KNOWN_POSITION_DIVERGENCES ({reason}) but the first "
                "diagnostic positions now agree; remove the entry"
            )
    for name, entries, used in (
        ("WORDING_DIFFERENCES", wording, tally.wording_used),
        ("HELP_DIFFERENCES", help_wording, tally.help_wording_used),
    ):
        for entry in entries:
            if entry not in used:
                problems.append(
                    f"{name} entry no file needs any more ({entry.legacy!r} -> "
                    f"{entry.discovery!r}); remove it"
                )
    return problems


@dataclass
class Comparison:
    files: int
    tokens: int
    mismatched_files: int
    known_divergences: int
    rejected_by_both: int
    lexer_diagnostic_files: int
    problems: list[str]
    notes: list[str]
    first_diagnostics: FirstDiagnosticTally = field(default_factory=FirstDiagnosticTally)


def compare_dumps(
    legacy: dict[str, FileDump],
    discovery: dict[str, FileDump],
    known_divergences: dict[str, str] | None = None,
    known_positions: dict[str, str] | None = None,
    wording: tuple[WordingDifference, ...] | None = None,
    help_wording: tuple[WordingDifference, ...] | None = None,
) -> Comparison:
    known = KNOWN_DIVERGENCES if known_divergences is None else known_divergences
    positions = KNOWN_POSITION_DIVERGENCES if known_positions is None else known_positions
    messages = WORDING_DIFFERENCES if wording is None else wording
    helps = HELP_DIFFERENCES if help_wording is None else help_wording
    tally = FirstDiagnosticTally()
    paths = sorted(set(legacy) | set(discovery))
    problems: list[str] = []
    notes: list[str] = []
    mismatched_files = 0
    known_count = 0
    tokens = 0
    rejected_by_both = 0
    lexer_diagnostic_files = 0
    for path in paths:
        old = legacy.get(path)
        new = discovery.get(path)
        found = file_mismatches(path, old, new)
        if not found and old is not None and new is not None:
            if old.parse_diagnostics > 0 and new.parse_diagnostics > 0:
                found = first_diagnostic_problems(path, old, new, tally, positions, messages, helps)
        if path in known and found:
            known_count += 1
            notes.append(f"known divergence {path}: {known[path]}")
        elif found:
            mismatched_files += 1
            problems.extend(found)
        elif path in known:
            mismatched_files += 1
            problems.append(
                f"{path}: listed in KNOWN_DIVERGENCES ({known[path]}) but the front ends "
                "now agree; remove the entry"
            )
        elif old is not None:
            tokens += len(new.tokens)
            rejected_by_both += old.parse_diagnostics > 0
            lexer_diagnostic_files += old.lexer_diagnostics > 0
    for path in sorted(set(known) - set(paths)):
        mismatched_files += 1
        problems.append(
            f"{path}: listed in KNOWN_DIVERGENCES ({known[path]}) but is not in the corpus; "
            "remove the entry"
        )
    return Comparison(
        files=len(paths),
        tokens=tokens,
        mismatched_files=mismatched_files,
        known_divergences=known_count,
        rejected_by_both=rejected_by_both,
        lexer_diagnostic_files=lexer_diagnostic_files,
        problems=problems,
        notes=notes,
        first_diagnostics=tally,
    )


@dataclass(frozen=True)
class AdapterFieldDifference:
    """One field `discovery_adapter_differential.brp` found to differ."""

    module: str
    declaration: str
    path: str
    old: str
    new: str


@dataclass
class TreePrefixReport:
    """Bounded tree declaration evidence, separate from the full table adapter."""

    modules: int = 0
    compared: int = 0
    skipped: int = 0
    errors: int = 0
    declarations: int = 0
    completed_functions: int = 0
    completed_traits: int = 0
    completed_implementations: int = 0
    difference_count: int = 0
    reported: int = 0
    kinds: dict[str, int] = field(default_factory=dict)
    stops: dict[str, int] = field(default_factory=dict)
    skipped_paths: list[str] = field(default_factory=list)
    error_lines: list[str] = field(default_factory=list)
    differences: list[AdapterFieldDifference] = field(default_factory=list)
    problems: list[str] = field(default_factory=list)


def parse_adapter_difference(body: str) -> AdapterFieldDifference | None:
    """Decode the field protocol shared by table and tree differences."""
    head, marker, new_value = body.rpartition(NEW_VALUE_MARKER)
    fields = head.split(DIFFERENCE_FIELD_SEPARATOR, 3)
    if not marker or len(fields) != 4 or not fields[3].startswith(OLD_VALUE_PREFIX):
        return None
    return AdapterFieldDifference(
        module=fields[0],
        declaration=fields[1],
        path=fields[2],
        old=fields[3][len(OLD_VALUE_PREFIX):].replace(ESCAPED_FIELD_SEPARATOR, DIFFERENCE_FIELD_SEPARATOR),
        new=new_value.replace(ESCAPED_FIELD_SEPARATOR, DIFFERENCE_FIELD_SEPARATOR),
    )


def parse_tree_prefix_output(text: str) -> TreePrefixReport:
    """Require one complete summary and check that its emitted evidence agrees."""
    report = TreePrefixReport()
    summary: dict[str, int] = {}
    summaries = 0
    for line in text.splitlines():
        if not line.startswith(TREE_PREFIX_NAMESPACE):
            continue
        if line.startswith(TREE_PREFIX_DIFFERENCE):
            difference = parse_adapter_difference(line[len(TREE_PREFIX_DIFFERENCE):])
            if difference is None or not difference.module or not difference.path:
                report.problems.append(f"unreadable tree prefix difference line: {line}")
            else:
                report.differences.append(difference)
        elif line.startswith(TREE_PREFIX_SKIPPED):
            path, separator, reason = line[len(TREE_PREFIX_SKIPPED):].partition(SKIPPED_REASON_SEPARATOR)
            if not path or not separator or reason != EXISTING_PARSER_REJECTED_REASON:
                report.problems.append(f"unreadable tree prefix skipped line: {line}")
            else:
                report.skipped_paths.append(path)
        elif line.startswith(TREE_PREFIX_ERROR):
            fields = line[len(TREE_PREFIX_ERROR):].split(DIFFERENCE_FIELD_SEPARATOR, 2)
            if len(fields) != 3 or not all(fields) or fields[1] not in TREE_PREFIX_ERROR_STAGES:
                report.problems.append(f"unreadable tree prefix error line: {line}")
            else:
                report.error_lines.append(line)
        elif line.startswith(TREE_PREFIX_SUMMARY):
            summaries += 1
            if summaries > 1:
                report.problems.append("the tree prefix differential printed a duplicate summary")
                continue
            seen: set[str] = set()
            for item in line[len(TREE_PREFIX_SUMMARY):].split():
                name, separator, value = item.partition("=")
                if not separator or name not in TREE_PREFIX_SUMMARY_FIELDS:
                    report.problems.append(f"unknown or malformed tree prefix summary field: {item}")
                elif name in seen:
                    report.problems.append(f"duplicate tree prefix summary field: {name}")
                elif re.fullmatch(r"[0-9]+", value) is None:
                    report.problems.append(f"invalid nonnegative tree prefix count: {item}")
                else:
                    try:
                        summary[name] = int(value)
                    except ValueError:
                        report.problems.append(f"invalid tree prefix count: {item}")
                seen.add(name)
            missing = TREE_PREFIX_SUMMARY_FIELDS - seen
            if missing:
                report.problems.append(f"missing tree prefix summary fields: {', '.join(sorted(missing))}")
        else:
            report.problems.append(f"unexpected tree prefix differential output: {line}")
    if summaries == 0:
        report.problems.append("the tree prefix differential printed no summary")

    report.modules = summary.get("modules", 0)
    report.compared = summary.get("compared", 0)
    report.skipped = summary.get("skipped", 0)
    report.errors = summary.get("errors", 0)
    report.declarations = summary.get("declarations", 0)
    report.completed_functions = summary.get("completed_functions", 0)
    report.completed_traits = summary.get("completed_traits", 0)
    report.completed_implementations = summary.get("completed_implementations", 0)
    report.difference_count = summary.get("differences", 0)
    report.reported = summary.get("reported", 0)
    report.kinds = {kind: summary.get(f"kind_{kind}", 0) for kind in TREE_PREFIX_KINDS}
    report.stops = {stop: summary.get(f"stop_{stop}", 0) for stop in TREE_PREFIX_STOPS}
    if report.modules != report.compared + report.skipped + report.errors:
        report.problems.append("tree prefix module counts do not account for every module")
    if sum(report.stops.values()) != report.compared:
        report.problems.append("tree prefix stop counts do not equal compared modules")
    if any(count > report.compared for count in report.kinds.values()):
        report.problems.append("tree prefix kind count exceeds compared modules")
    if sum(report.kinds[kind] for kind in TREE_PREFIX_COMPLETED_KINDS) > report.declarations:
        report.problems.append("tree prefix completed kind counts exceed completed declarations")
    if report.completed_functions + report.completed_traits + report.completed_implementations > report.declarations:
        report.problems.append("tree prefix completed function count exceeds completed declarations")
    if report.skipped != len(report.skipped_paths) or len(set(report.skipped_paths)) != len(report.skipped_paths):
        report.problems.append("tree prefix skipped count does not match unique skipped lines")
    if report.errors != len(report.error_lines):
        report.problems.append("tree prefix error count does not match error lines")
    if report.reported != len(report.differences) or report.reported > report.difference_count:
        report.problems.append("tree prefix reported difference count does not match difference lines")
    # A mismatched boundary deliberately earns no preview coverage. Equality is
    # therefore required only when the comparison itself reports no differences.
    if not report.problems and report.difference_count == 0:
        # A module that completes owners before a later preview stop is covered
        # by both, so an owner kind's coverage may exceed its stops.
        for kind, stop in TREE_PREFIX_PREVIEW_STOP_PAIRS:
            if report.kinds[kind] < report.stops[stop]:
                report.problems.append(f"tree prefix {kind} coverage is below its {stop} stops")
        if report.kinds["constant_global"] + report.kinds["mutable_global"] < report.stops["global_initializer"]:
            report.problems.append("tree prefix global coverage does not include every global_initializer stop")
    return report


@dataclass
class TreeModuleReport:
    """Whole-module tree evidence: assembled modules compared in full."""

    totals: dict[str, int] = field(default_factory=dict)
    stops: dict[str, int] = field(default_factory=dict)
    rejected_lines: list[str] = field(default_factory=list)
    skipped_paths: list[str] = field(default_factory=list)
    error_lines: list[str] = field(default_factory=list)
    differences: list[AdapterFieldDifference] = field(default_factory=list)
    problems: list[str] = field(default_factory=list)


def parse_tree_module_output(text: str) -> TreeModuleReport:
    """Require one complete summary whose counts account for every line."""
    report = TreeModuleReport()
    summaries = 0
    for line in text.splitlines():
        if not line.startswith(TREE_MODULE_NAMESPACE):
            continue
        if line.startswith(TREE_MODULE_DIFFERENCE):
            difference = parse_adapter_difference(line[len(TREE_MODULE_DIFFERENCE):])
            if difference is None or not difference.module or not difference.path:
                report.problems.append(f"unreadable tree module difference line: {line}")
            else:
                report.differences.append(difference)
        elif line.startswith(TREE_MODULE_REJECTED):
            report.rejected_lines.append(line)
        elif line.startswith(TREE_MODULE_SKIPPED):
            path, separator, reason = line[len(TREE_MODULE_SKIPPED):].partition(SKIPPED_REASON_SEPARATOR)
            if not path or not separator or reason != EXISTING_PARSER_REJECTED_REASON:
                report.problems.append(f"unreadable tree module skipped line: {line}")
            else:
                report.skipped_paths.append(path)
        elif line.startswith(TREE_MODULE_ERROR):
            fields = line[len(TREE_MODULE_ERROR):].split(DIFFERENCE_FIELD_SEPARATOR, 2)
            if len(fields) != 3 or not all(fields) or fields[1] not in TREE_MODULE_ERROR_STAGES:
                report.problems.append(f"unreadable tree module error line: {line}")
            else:
                report.error_lines.append(line)
        elif line.startswith(TREE_MODULE_SUMMARY):
            summaries += 1
            if summaries > 1:
                report.problems.append("the tree module differential printed a duplicate summary")
                continue
            summary: dict[str, int] = {}
            for item in line[len(TREE_MODULE_SUMMARY):].split():
                name, separator, value = item.partition("=")
                if not separator or name not in TREE_MODULE_SUMMARY_FIELDS or name in summary:
                    report.problems.append(f"unknown, malformed or duplicate tree module summary field: {item}")
                elif re.fullmatch(r"[0-9]+", value) is None:
                    report.problems.append(f"invalid tree module count: {item}")
                else:
                    summary[name] = int(value)
            missing = TREE_MODULE_SUMMARY_FIELDS - summary.keys()
            if missing:
                report.problems.append(f"missing tree module summary fields: {', '.join(sorted(missing))}")
            report.totals = {name: summary.get(name, 0) for name in TREE_MODULE_TOTAL_FIELDS}
            report.stops = {stop: summary.get(f"stop_{stop}", 0) for stop in TREE_MODULE_STOPS}
        else:
            report.problems.append(f"unexpected tree module differential output: {line}")
    if summaries == 0:
        report.problems.append("the tree module differential printed no summary")
        return report

    totals = report.totals
    if totals["modules"] != sum(totals[name] for name in ("assembled", "rejected", "unassembled", "skipped", "errors")):
        report.problems.append("tree module counts do not account for every module")
    if sum(report.stops.values()) != totals["unassembled"]:
        report.problems.append("tree module stop counts do not equal unassembled modules")
    if totals["rejected"] != len(report.rejected_lines):
        report.problems.append("tree module rejected count does not match rejected lines")
    if totals["skipped"] != len(report.skipped_paths) or len(set(report.skipped_paths)) != len(report.skipped_paths):
        report.problems.append("tree module skipped count does not match unique skipped lines")
    if totals["errors"] != len(report.error_lines):
        report.problems.append("tree module error count does not match error lines")
    if totals["reported"] != len(report.differences) or totals["reported"] > totals["differences"]:
        report.problems.append("tree module reported difference count does not match difference lines")
    return report


def tree_module_problems(
    description: str,
    report: TreeModuleReport,
    expected_skipped: set[str],
    allowances: tuple[AdapterDifference, ...],
    used: set[AdapterDifference],
) -> list[str]:
    """Every assembled module must equal the existing parser's program; a
    module the tree path rejects, a census or projection error and an accepted
    module stopped at a rejected declaration all fail. Only the existing
    parser's known faults (`ADAPTER_DIFFERENCES`) are allowed."""
    problems = [f"{description}: {problem}" for problem in report.problems]
    problems.extend(f"{description}: {line}" for line in report.error_lines)
    problems.extend(
        f"{description}: the tree path rejects a module the existing parser accepts: {line}"
        for line in report.rejected_lines
    )
    skipped = set(report.skipped_paths)
    if skipped != expected_skipped:
        problems.append(
            f"{description}: skipped modules differ from the ones the existing parser rejects: "
            f"unexpected {sorted(skipped - expected_skipped)[:1]}, "
            f"missing {sorted(expected_skipped - skipped)[:1]}"
        )
    unlisted: list[AdapterFieldDifference] = []
    for difference in report.differences:
        entry = next((entry for entry in allowances if entry.allows(difference)), None)
        if entry is None:
            unlisted.append(difference)
        else:
            used.add(entry)
    for difference in unlisted[:MAX_REPORTED_ADAPTER_DIFFERENCES]:
        label = difference.declaration or "(module)"
        problems.append(
            f"{description}: {difference.module} | {label} | {difference.path}\n"
            f"    existing parser: {difference.old}\n"
            f"    tree module:     {difference.new}"
        )
    if len(unlisted) > MAX_REPORTED_ADAPTER_DIFFERENCES:
        problems.append(
            f"{description}: {len(unlisted) - MAX_REPORTED_ADAPTER_DIFFERENCES} more tree module differences not shown"
        )
    if report.totals and report.totals["differences"] > len(report.differences):
        problems.append(
            f"{description}: {report.totals['differences'] - len(report.differences)} tree module differences "
            "were counted but not reported"
        )
    for stop in TREE_MODULE_REJECTED_STOPS:
        if report.stops.get(stop, 0) > 0:
            problems.append(f"{description}: accepted modules stopped at {stop}: {report.stops[stop]}")
    return problems


@dataclass
class AdapterReport:
    """What one run of the adapter differential printed."""

    modules: int
    compared: int
    skipped: int
    skipped_paths: list[str]
    declarations: int
    differences: list[AdapterFieldDifference]
    problems: list[str]
    listed_modules: list[str] = field(default_factory=list)
    tree_prefix: TreePrefixReport = field(default_factory=TreePrefixReport)
    tree_module: TreeModuleReport = field(default_factory=TreeModuleReport)


def parse_adapter_output(text: str) -> AdapterReport:
    """The differences and totals in the differential's output.

    A run that printed no summary, or printed lines this does not know, is a
    problem: the check must not pass because the tool died or changed format.
    """
    differences: list[AdapterFieldDifference] = []
    skipped_paths: list[str] = []
    listed_modules: list[str] = []
    problems: list[str] = []
    summary: dict[str, int] | None = None
    for line in text.splitlines():
        if line.startswith(TREE_PREFIX_NAMESPACE) or line.startswith(TREE_MODULE_NAMESPACE):
            # Their strict parsers record problems on the separate tree reports.
            continue
        if line.startswith(DIFFERENCE_PREFIX):
            difference = parse_adapter_difference(line[len(DIFFERENCE_PREFIX):])
            if difference is None:
                problems.append(f"unreadable adapter difference line: {line}")
                continue
            differences.append(difference)
        elif line.startswith(SKIPPED_PREFIX):
            skipped_paths.append(line[len(SKIPPED_PREFIX):].split(SKIPPED_REASON_SEPARATOR, 1)[0])
        elif line.startswith(LISTED_MODULE_PREFIX):
            listed_modules.append(line[len(LISTED_MODULE_PREFIX):])
        elif line.startswith(ADAPTER_ERROR_PREFIX):
            problems.append(f"the adapter could not rebuild a module: {line}")
        elif line.startswith(SUMMARY_PREFIX):
            summary = {
                name: int(value)
                for name, _, value in (item.partition("=") for item in line[len(SUMMARY_PREFIX):].split())
            }
        elif line.strip():
            problems.append(f"unexpected adapter differential output: {line}")
    if summary is None:
        problems.append("the adapter differential printed no summary")
        summary = {}
    return AdapterReport(
        modules=summary.get("modules", 0),
        compared=summary.get("compared", 0),
        skipped=summary.get("skipped", 0),
        skipped_paths=skipped_paths,
        declarations=summary.get("declarations", 0),
        differences=differences,
        problems=problems,
        listed_modules=listed_modules,
        tree_prefix=parse_tree_prefix_output(text),
        tree_module=parse_tree_module_output(text),
    )


def tree_prefix_problems(
    description: str,
    report: TreePrefixReport,
    expected_skipped: set[str],
    require_completed_kinds: bool = False,
    allowances: tuple[AdapterDifference, ...] = (),
    used: set[AdapterDifference] | None = None,
) -> list[str]:
    """Every tree mismatch fails unless an allowance names it. The only
    allowances are the existing parser's own known faults, passed by the caller
    (`ADAPTER_DIFFERENCES`); a run that uses one records it in `used`."""
    problems = [f"{description}: {problem}" for problem in report.problems]
    problems.extend(f"{description}: {line}" for line in report.error_lines)
    skipped = set(report.skipped_paths)
    if skipped != expected_skipped:
        problems.append(
            f"{description}: skipped modules differ from the ones the existing parser rejects: "
            f"unexpected {sorted(skipped - expected_skipped)[:1]}, "
            f"missing {sorted(expected_skipped - skipped)[:1]}"
        )
    if report.compared == 0:
        problems.append(f"{description}: no module was compared")
    unlisted: list[AdapterFieldDifference] = []
    for difference in report.differences:
        entry = next((entry for entry in allowances if entry.allows(difference)), None)
        if entry is None:
            unlisted.append(difference)
        elif used is not None:
            used.add(entry)
    for difference in unlisted[:MAX_REPORTED_ADAPTER_DIFFERENCES]:
        label = difference.declaration or "(module)"
        problems.append(
            f"{description}: {difference.module} | {label} | {difference.path}\n"
            f"    existing parser: {difference.old}\n"
            f"    tree prefix:     {difference.new}"
        )
    if len(unlisted) > MAX_REPORTED_ADAPTER_DIFFERENCES:
        problems.append(
            f"{description}: {len(unlisted) - MAX_REPORTED_ADAPTER_DIFFERENCES} more tree prefix differences not shown"
        )
    unreported = report.difference_count - len(report.differences)
    if unreported > 0:
        problems.append(f"{description}: {unreported} tree prefix differences were counted but not reported")
    for stop in TREE_PREFIX_REJECTED_STOPS:
        if report.stops.get(stop, 0) > 0:
            problems.append(f"{description}: accepted modules stopped at {stop}: {report.stops[stop]}")
    if require_completed_kinds:
        for kind in TREE_PREFIX_COMPLETED_KINDS:
            if report.kinds.get(kind, 0) == 0:
                problems.append(f"{description}: no completed {kind} declaration was compared")
    return problems


def adapter_problems(
    description: str,
    report: AdapterReport,
    allowances: tuple[AdapterDifference, ...],
    used: set[AdapterDifference],
    expected_skipped: set[str],
) -> list[str]:
    """Why a differential run fails: unlisted differences, an unreadable run, a
    run that compared nothing, or a skipped set that is not `expected_skipped`
    (the modules the existing parser is known to reject), so a module that
    silently stops being compared fails the gate. Allowances it needs are added
    to `used`."""
    problems = [f"{description}: {problem}" for problem in report.problems]
    skipped = set(report.skipped_paths)
    if skipped != expected_skipped and not report.problems:
        extra = sorted(skipped - expected_skipped)
        missing = sorted(expected_skipped - skipped)
        problems.append(
            f"{description}: skipped modules differ from the ones the existing parser rejects: "
            f"{len(extra)} skipped without being rejected (for example {extra[:1]}), "
            f"{len(missing)} rejected but not skipped (for example {missing[:1]})"
        )
    unlisted: list[AdapterFieldDifference] = []
    for difference in report.differences:
        entry = next((entry for entry in allowances if entry.allows(difference)), None)
        if entry is None:
            unlisted.append(difference)
        else:
            used.add(entry)
    for difference in unlisted[:MAX_REPORTED_ADAPTER_DIFFERENCES]:
        label = difference.declaration or "(module)"
        problems.append(
            f"{description}: {difference.module} | {label} | {difference.path}\n"
            f"    existing parser: {difference.old}\n"
            f"    adapter:         {difference.new}"
        )
    if len(unlisted) > MAX_REPORTED_ADAPTER_DIFFERENCES:
        problems.append(
            f"{description}: {len(unlisted) - MAX_REPORTED_ADAPTER_DIFFERENCES} more differences not shown"
        )
    if report.compared == 0 and not report.problems:
        problems.append(f"{description}: no module was compared")
    return problems


def stale_adapter_allowances(
    allowances: tuple[AdapterDifference, ...], used: set[AdapterDifference]
) -> list[str]:
    """Allowances no run needs any more."""
    return [
        f"ADAPTER_DIFFERENCES entry no module needs any more ({entry.path!r}: {entry.reason}); remove it"
        for entry in allowances
        if entry not in used
    ]


@dataclass(frozen=True)
class CorpusSelection:
    """The corpus files a run covers. The gate covers the whole corpus; a
    targeted run covers part of it and is never the gate."""

    paths: tuple[str, ...]
    description: str
    targeted: bool

    @classmethod
    def full(cls, corpus: list[str]) -> "CorpusSelection":
        return cls(tuple(corpus), "the corpus", targeted=False)

    @classmethod
    def of_files(cls, paths: list[str], description: str) -> "CorpusSelection":
        return cls(tuple(paths), description, targeted=True)

    @property
    def stores_census(self) -> bool:
        """Only a census of the whole corpus can be selected from later."""
        return not self.targeted


def selection_problems(description: str, report: AdapterReport, selected: tuple[str, ...]) -> list[str]:
    """Whether a targeted adapter run covered exactly the selected files: each
    was compared (`listed-module`), none else was, and each was either compared
    or skipped as rejected. Without this a run that reached nothing, or a
    different set, would pass with no differences."""
    problems = []
    seen = set(report.listed_modules)
    wanted = set(selected)
    if seen != wanted or len(report.listed_modules) != len(seen):
        problems.append(
            f"{description}: the run did not cover exactly the selected files: "
            f"{len(wanted - seen)} not reached (for example {sorted(wanted - seen)[:1]}), "
            f"{len(seen - wanted)} others compared (for example {sorted(seen - wanted)[:1]})"
        )
    if report.modules != len(selected) or report.compared + report.skipped != len(selected):
        problems.append(
            f"{description}: {report.compared} compared and {report.skipped} skipped of "
            f"{report.modules} modules, but {len(selected)} files were selected"
        )
    return problems


def adapter_runs(
    file_list: Path, selection: CorpusSelection
) -> list[tuple[str, tuple[str, ...], bool]]:
    """The adapter differential's runs: (description, dumper arguments, whether
    it is the run over the corpus files). The gate also runs every `ROOT_CHECKS`
    root with the options the graph check uses; a targeted run compares only
    the selected files."""
    if selection.targeted:
        return [(selection.description, (ADAPTER_FILES_MODE, str(file_list), ONLY_LISTED_FLAG), True)]
    runs = [
        (check.description, (check.mode, check.root, *check.options), False)
        for check in ROOT_CHECKS
    ]
    runs.append(("every corpus file as a root", (ADAPTER_FILES_MODE, str(file_list)), True))
    return runs


def check_adapter(
    work: Path,
    file_list: Path,
    rejected_files: set[str] | None,
    selection: CorpusSelection,
) -> tuple[list[str], list[str], int]:
    """Run the adapter differential over `adapter_runs`: (notes, problems, failed
    checks). The root runs skip nothing; the run over files skips exactly
    `rejected_files`, or whatever it skipped when that is `None` (no token dump
    was made to say which the existing parser rejects). Each run is a check, and
    so is the list of allowances, which a targeted run cannot judge."""
    binary = build_dumper(ADAPTER_DIFFERENTIAL, work, selection)
    notes: list[str] = []
    problems: list[str] = []
    failed = 0
    used: set[AdapterDifference] = set()
    for description, arguments, over_files in adapter_runs(file_list, selection):
        report = parse_adapter_output(run_dumper(binary, *arguments, allowed_statuses=(0, ADAPTER_ERROR_STATUS)))
        expected_skipped = set()
        if over_files:
            expected_skipped = set(report.skipped_paths) if rejected_files is None else rejected_files
        found = adapter_problems(
            f"adapter differential, {description}", report, ADAPTER_DIFFERENCES, used, expected_skipped
        )
        if selection.targeted:
            found.extend(selection_problems(description, report, selection.paths))
        found.extend(tree_prefix_problems(
            f"tree prefix differential, {description}", report.tree_prefix, expected_skipped,
            require_completed_kinds=over_files and not selection.targeted,
            allowances=ADAPTER_DIFFERENCES, used=used,
        ))
        if report.tree_prefix.modules != report.modules:
            found.append(f"tree prefix differential, {description}: module total differs from the full adapter")
        found.extend(tree_module_problems(
            f"tree module differential, {description}", report.tree_module, expected_skipped,
            ADAPTER_DIFFERENCES, used,
        ))
        if report.tree_module.totals.get("modules") != report.modules:
            found.append(f"tree module differential, {description}: module total differs from the full adapter")
        problems.extend(found)
        failed += bool(found)
        if not found:
            notes.append(
                f"adapter agrees with the existing parser for {description}: "
                f"{report.compared} modules compared, {report.skipped} rejected by the existing "
                f"parser, {report.declarations} declarations"
            )
            prefix = report.tree_prefix
            notes.append(
                f"tree prefix agrees with the existing parser for {description}: "
                f"{prefix.compared} modules compared, {prefix.declarations} completed declarations "
                f"({prefix.completed_functions} functions, {prefix.completed_traits} traits and "
                f"{prefix.completed_implementations} implementations with bodies); "
                + ", ".join(f"{stop}={prefix.stops[stop]}" for stop in TREE_PREFIX_STOPS)
            )
            module = report.tree_module
            notes.append(
                f"tree modules agree with the existing parser for {description}: "
                f"{module.totals['assembled']} of {report.compared} accepted modules assembled and compared in full, "
                f"{module.totals['unassembled']} not yet read in full ("
                + ", ".join(f"{stop}={module.stops[stop]}" for stop in TREE_MODULE_STOPS)
                + ")"
            )
    if not selection.targeted:
        stale = stale_adapter_allowances(ADAPTER_DIFFERENCES, used)
        problems.extend(stale)
        failed += bool(stale)
    return notes, problems, failed


STOP_CENSUS_FLAG = "--stop-census"
STOP_REASON_PREFIX = "stop-reason "
STOP_REASON_FIELDS = 5
FIRST_STOP = "first"
LATER_STOP = "later"


@dataclass
class StopReasonCount:
    """One reason: the modules whose first unread declaration stopped for it
    (`modules`, with an example) and every unread declaration it stopped."""
    modules: int = 0
    declarations: int = 0
    example: str = ""


@dataclass
class StopCensus:
    reasons: dict[str, StopReasonCount] = field(default_factory=dict)
    kinds: dict[str, int] = field(default_factory=dict)


def parse_stop_census(text: str) -> StopCensus:
    """Collect the `stop-reason <path> | <kind> | <reason> | <line> | <order>`
    lines. The first module in corpus order is each reason's example."""
    census = StopCensus()
    for line in text.splitlines():
        if not line.startswith(STOP_REASON_PREFIX):
            continue
        fields = line[len(STOP_REASON_PREFIX):].split(" | ")
        if len(fields) != STOP_REASON_FIELDS:
            raise SystemExit(f"FAIL: malformed stop-reason line: {line}")
        path, kind, reason, source_line, order = fields
        count = census.reasons.setdefault(reason, StopReasonCount())
        count.declarations += 1
        if order == FIRST_STOP:
            count.modules += 1
            census.kinds[kind] = census.kinds.get(kind, 0) + 1
            if not count.example:
                count.example = f"{path}:{source_line}"
        elif order != LATER_STOP:
            raise SystemExit(f"FAIL: unknown stop order in: {line}")
    return census


def render_stop_census(census: StopCensus, files: int, scope: str = "Corpus files") -> str:
    """A ranked markdown table: most common reason first, ties by name."""
    stopped = sum(count.modules for count in census.reasons.values())
    declined = sum(count.declarations for count in census.reasons.values())
    kinds = ", ".join(f"{kind} {census.kinds[kind]}" for kind in sorted(census.kinds))
    lines = [
        f"{scope}: {files}. Modules whose tree scan left a declaration unread: {stopped} ({kinds}); "
        f"declarations left unread in all: {declined}.",
        "",
        "| Rank | Reason | First-stop modules | Share | All unread declarations | Example |",
        "| ---: | --- | ---: | ---: | ---: | --- |",
    ]
    ranked = sorted(
        census.reasons.items(), key=lambda item: (-item[1].modules, -item[1].declarations, item[0])
    )
    for rank, (reason, count) in enumerate(ranked, start=1):
        share = 100.0 * count.modules / stopped
        lines.append(
            f"| {rank} | {reason} | {count.modules} | {share:.1f}% | {count.declarations} | {count.example or '-'} |"
        )
    return "\n".join(lines)


CENSUS_RESULT_NAME = "stop-census.txt"
CENSUS_HEADER_PREFIX = "# "
CHECKOUT_DIGEST_LENGTH = 12


def default_census_file(root: Path) -> Path:
    """Where the full census keeps its result: one directory per checkout (named
    by a digest of its path, so worktrees never read each other's census) under
    the system temporary directory."""
    digest = hashlib.sha256(str(root).encode("utf-8")).hexdigest()[:CHECKOUT_DIGEST_LENGTH]
    return Path(tempfile.gettempdir()) / f"compiler-new-parity-{digest}" / CENSUS_RESULT_NAME


def census_result_text(output: str, header: str) -> str:
    """The reusable form of a census run: a header line saying when and where it
    was recorded, then the dumper's `stop-reason` lines and nothing else."""
    stops = [line for line in output.splitlines() if line.startswith(STOP_REASON_PREFIX)]
    return "\n".join([f"{CENSUS_HEADER_PREFIX}{header}", *stops]) + "\n"


def write_census_result(path: Path, output: str, header: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(census_result_text(output, header), encoding="utf-8")


def read_census_result(path: Path) -> tuple[str, str]:
    """The stored census and its header line, or an exit saying how to make one."""
    if not path.is_file():
        raise SystemExit(
            f"FAIL: no stop census at {path}; run `scripts/compiler-new-parity {STOP_CENSUS_FLAG}` "
            "over the whole corpus first, which stores it"
        )
    text = path.read_text(encoding="utf-8")
    first = text.splitlines()[0] if text else ""
    header = first[len(CENSUS_HEADER_PREFIX):] if first.startswith(CENSUS_HEADER_PREFIX) else "no header"
    return text, header


def first_stop_locations(census_text: str, reason: str) -> list[tuple[str, int]]:
    """The `(path, line)` of each module's first unread declaration that stopped
    for `reason`, in census order. A reason that no module stops at first is an
    exit naming the reasons that do, so a misspelt label teaches the right one."""
    first_stops: dict[str, list[tuple[str, int]]] = {}
    seen: set[str] = set()
    for line in census_text.splitlines():
        if not line.startswith(STOP_REASON_PREFIX):
            continue
        fields = line[len(STOP_REASON_PREFIX):].split(" | ")
        if len(fields) != STOP_REASON_FIELDS:
            raise SystemExit(f"FAIL: malformed stop-reason line: {line}")
        path, _, stop_reason, source_line, order = fields
        if not source_line.isdigit():
            raise SystemExit(f"FAIL: malformed stop-reason line (the line number is not a number): {line}")
        seen.add(stop_reason)
        if order == FIRST_STOP:
            first_stops.setdefault(stop_reason, []).append((path, int(source_line)))
    if reason in first_stops:
        return first_stops[reason]
    if reason in seen:
        raise SystemExit(
            f"FAIL: no module's first stop was {reason} in the census (it only stops later "
            "declarations); select a reason from the table's First-stop modules column"
        )
    known = ", ".join(sorted(first_stops))
    raise SystemExit(f"FAIL: unknown stop reason {reason}; the census has first stops for: {known}")


def first_stop_modules(census_text: str, reason: str) -> list[str]:
    """The modules whose first unread declaration stopped for `reason`, in census
    order."""
    return [path for path, _ in first_stop_locations(census_text, reason)]


def select_files(requested: list[str], tracked: list[str]) -> list[str]:
    """`requested` as tracked source files in `tracked` order, once each; a name
    that is not one is an exit naming it."""
    known = set(tracked)
    unknown = sorted({name for name in requested if name not in known})
    if unknown:
        raise SystemExit(
            f"FAIL: not a tracked `{CORPUS_SUFFIX}` file (give repository-relative paths): "
            f"{', '.join(unknown)}"
        )
    wanted = set(requested)
    return [name for name in tracked if name in wanted]


def run_stop_census(
    work: Path, file_list: Path, selection: CorpusSelection, census_file: Path
) -> int:
    """The `--stop-census` mode: the adapter differential's per-module stops. The
    census of the whole corpus is also stored in `census_file`."""
    binary = build_dumper(ADAPTER_DIFFERENTIAL, work, selection)
    flags = (STOP_CENSUS_FLAG, ONLY_LISTED_FLAG) if selection.targeted else (STOP_CENSUS_FLAG,)
    output = run_dumper(binary, ADAPTER_FILES_MODE, str(file_list), *flags)
    scope = "Selected files" if selection.targeted else "Corpus files"
    print(render_stop_census(parse_stop_census(output), len(selection.paths), scope))
    if selection.stores_census:
        write_census_result(census_file, output, census_header(len(selection.paths)))
        print(
            f"\nStored the stop census in {census_file}; `--stop-reason LABEL` runs "
            "the modules whose first stop was that reason."
        )
    return 0


def census_header(files: int) -> str:
    revision = subprocess.run(
        ["git", "rev-parse", "--short", "HEAD"], cwd=REPO_ROOT, capture_output=True, text=True
    ).stdout.strip()
    return f"{files} corpus files at {revision or 'unknown revision'}, {time.strftime('%Y-%m-%d %H:%M')}"


def tracked_files(roots: tuple[str, ...]) -> list[str]:
    """Tracked `.brp` files under `roots`, in a fixed order."""
    listing = subprocess.run(
        ["git", "ls-files", "-z", "--", *roots],
        cwd=REPO_ROOT,
        capture_output=True,
        check=True,
    ).stdout.decode("utf-8")
    return sorted(
        name for name in listing.split("\0") if name.endswith(CORPUS_SUFFIX)
    )


def corpus_files() -> list[str]:
    """The corpus the gate covers: tracked `.brp` files under the corpus roots."""
    return tracked_files(CORPUS_ROOTS)


def run_checked(command: list[str], description: str) -> None:
    result = subprocess.run(command, cwd=REPO_ROOT, capture_output=True, text=True)
    if result.returncode != 0:
        sys.stdout.write(f"FAIL: {description}\n{result.stdout}{result.stderr}")
        raise SystemExit(1)


def c_compile_flags(selection: CorpusSelection) -> tuple[str, ...]:
    return TARGETED_C_COMPILE_FLAGS if selection.targeted else C_COMPILE_FLAGS


def build_dumper(source: str, work: Path, selection: CorpusSelection) -> Path:
    """Compile a dumper to a host binary: Blorp to C, then the C compiler."""
    stem = Path(source).stem
    c_file = work / f"{stem}.c"
    binary = work / stem
    compiler = os.environ.get(C_COMPILER_VARIABLE, DEFAULT_C_COMPILER)
    run_checked(
        ["bin/blorp", "compile", "--no-format", "-o", str(c_file), source],
        f"compile {source} to C",
    )
    run_checked(
        [compiler, "-x", "c", str(c_file), *c_compile_flags(selection), *C_INCLUDE_FLAGS, *C_LINK_FLAGS, "-o", str(binary)],
        f"compile {c_file} with {compiler}",
    )
    return binary


def run_dumper(binary: Path, *arguments: str | Path, allowed_statuses: tuple[int, ...] = (0,)) -> str:
    result = subprocess.run(
        [str(binary), *(str(argument) for argument in arguments)],
        cwd=REPO_ROOT,
        capture_output=True,
        check=False,
    )
    if result.returncode not in allowed_statuses:
        sys.stdout.write(f"FAIL: {binary.name} exited with status {result.returncode}\n")
        sys.stdout.write(result.stderr.decode("utf-8", "replace"))
        raise SystemExit(1)
    return result.stdout.decode("utf-8", "surrogateescape")


def degraded_graph_problems(check: RootCheck, modules: list[str]) -> list[str]:
    """Why a graph is too small or lacks the origin the check is for."""
    problems = []
    if len(modules) < check.minimum_modules:
        problems.append(
            f"discovery graph for {check.description} ({check.root}) loaded {len(modules)} modules, "
            f"fewer than the expected minimum {check.minimum_modules}"
        )
    if check.required_origin_prefix and not any(
        line.startswith(check.required_origin_prefix) for line in modules
    ):
        problems.append(
            f"discovery graph for {check.description} ({check.root}) has no module with origin "
            f"`{check.required_origin_prefix}...`"
        )
    return problems


def check_discovery_graphs(work: Path, selection: CorpusSelection) -> tuple[list[str], list[str]]:
    """Run the discovery stage's order dumper for every `ROOT_CHECKS` root: (notes, problems)."""
    binary = build_dumper(DISCOVERY_ORDER_DUMPER, work, selection)
    notes: list[str] = []
    problems: list[str] = []
    for check in ROOT_CHECKS:
        modules = run_dumper(binary, check.mode, check.root, *check.options).splitlines()
        found = degraded_graph_problems(check, modules)
        problems.extend(found)
        if not found:
            notes.append(f"discovery graph is complete for {check.description} ({check.root}): {len(modules)} modules")
    return notes, problems


def with_stale_allowances(comparison: Comparison, corpus: set[str]) -> Comparison:
    """`comparison` plus a problem for each allowance no corpus file needs."""
    stale = stale_allowance_problems(
        comparison.first_diagnostics,
        KNOWN_POSITION_DIVERGENCES,
        WORDING_DIFFERENCES,
        HELP_DIFFERENCES,
        corpus,
    )
    comparison.problems.extend(stale)
    comparison.mismatched_files += len(stale)
    return comparison


def compare_selected_dumps(
    legacy: dict[str, FileDump], discovery: dict[str, FileDump], paths: tuple[str, ...]
) -> Comparison:
    """The comparison of a targeted run: the allowances for files outside the
    selection are left out, since the files they name are not being compared,
    and staleness of the allowance lists is a whole-corpus question the gate
    answers."""
    selected = set(paths)
    return compare_dumps(
        legacy,
        discovery,
        {path: reason for path, reason in KNOWN_DIVERGENCES.items() if path in selected},
        {path: reason for path, reason in KNOWN_POSITION_DIVERGENCES.items() if path in selected},
    )


def report(comparison: Comparison, seconds: float, selection: CorpusSelection) -> int:
    for note in comparison.notes:
        print(note)
    for problem in comparison.problems:
        print(problem)
    tally = comparison.first_diagnostics
    agreeing = comparison.files - comparison.mismatched_files
    status = "PASS" if comparison.mismatched_files == 0 else "FAIL"
    if selection.targeted:
        # Never a BLORP_GATE_RESULT line: a log of a narrowed run must not read
        # as the gate's verdict.
        print(
            f"compiler-new parity, targeted run over {selection.description} (not the gate): {status} "
            f"files={comparison.files} tokens={comparison.tokens} "
            f"mismatched_files={comparison.mismatched_files} seconds={seconds:.1f}"
        )
        return 0 if comparison.mismatched_files == 0 else 1
    print(
        f"compiler-new parity: files={comparison.files} tokens={comparison.tokens} "
        f"rejected_by_both={comparison.rejected_by_both} "
        f"files_with_lexer_diagnostics={comparison.lexer_diagnostic_files} "
        f"known_divergences={comparison.known_divergences} "
        f"first_diagnostics={tally.compared} "
        f"position_differences={tally.position_differences} "
        f"message_differences={tally.message_differences} "
        f"help_differences={tally.help_differences} "
        f"helps_added={tally.helps_added} "
        f"mismatched_files={comparison.mismatched_files} seconds={seconds:.1f}"
    )
    print(
        f"BLORP_GATE_RESULT gate=compiler_new_parity status={status} "
        f"passed={agreeing} failed={comparison.mismatched_files} tests={comparison.files}"
    )
    return 0 if comparison.mismatched_files == 0 else 1


def parse_arguments(argv: list[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    parser.add_argument("--keep", type=Path, help="keep dumpers and dumps in this directory")
    parser.add_argument(
        "--compare",
        nargs=2,
        metavar=("LEGACY_DUMP", "DISCOVERY_DUMP"),
        help="compare two existing dump files instead of building and running the dumpers",
    )
    parser.add_argument(
        "--stop-census",
        action="store_true",
        help="print the ranked reasons the tree scan stops at a declaration, instead of checking parity; "
        "a census of the whole corpus is stored for --stop-reason",
    )
    parser.add_argument(
        "--census-file",
        type=Path,
        help="where the full census stores its result and --stop-reason reads it "
        "(default: stop-census.txt in this checkout's directory under the system temporary directory)",
    )
    selection = parser.add_mutually_exclusive_group()
    selection.add_argument(
        "--files",
        nargs="+",
        metavar="PATH",
        help="run only these tracked corpus files (a targeted run, not the gate)",
    )
    selection.add_argument(
        "--stop-reason",
        metavar="LABEL",
        help="run only the modules whose first stop in the last full --stop-census had this reason "
        "(a targeted run, not the gate)",
    )
    parser.add_argument(
        "--adapter-only",
        action="store_true",
        help="with --files or --stop-reason, run only the adapter differential, not the token dumps",
    )
    options = parser.parse_args(argv)
    targeted = options.files is not None or options.stop_reason is not None
    if options.adapter_only and not targeted:
        parser.error("--adapter-only needs --files or --stop-reason")
    if options.compare and (targeted or options.stop_census or options.adapter_only or options.census_file):
        parser.error("--compare takes no other option except --keep")
    return options


def choose_selection(options: argparse.Namespace, corpus: list[str]) -> CorpusSelection:
    """The files a run covers: those named by `--files`, those a stored census
    attributes to `--stop-reason`, or the whole corpus. A targeted run may name
    any tracked source file, not only a corpus root: the census also ranks
    modules the corpus files import from elsewhere."""
    if options.files is None and options.stop_reason is None:
        return CorpusSelection.full(corpus)
    tracked = tracked_files((".",))
    if options.files is not None:
        paths = select_files(options.files, tracked)
        return CorpusSelection.of_files(paths, f"{len(paths)} listed files")
    census_file = options.census_file or default_census_file(REPO_ROOT)
    text, header = read_census_result(census_file)
    stopped = first_stop_modules(text, options.stop_reason)
    known = set(tracked)
    paths = select_files([path for path in stopped if path in known], tracked)
    gone = len(stopped) - len(paths)
    note = f"; {gone} not tracked now (generated or deleted)" if gone else ""
    print(f"Selected {len(paths)} modules with first stop {options.stop_reason} from the census of {header}{note}")
    return CorpusSelection.of_files(paths, f"{len(paths)} modules with first stop {options.stop_reason}")


def main(argv: list[str] | None = None) -> int:
    options = parse_arguments(argv)
    started = time.monotonic()

    if options.compare:
        legacy_text, discovery_text = (
            Path(name).read_text(encoding="utf-8", errors="surrogateescape")
            for name in options.compare
        )
        legacy_files = parse_dump(legacy_text)
        discovery_files = parse_dump(discovery_text)
        names = set(legacy_files) | set(discovery_files)
        comparison = with_stale_allowances(compare_dumps(legacy_files, discovery_files), names)
        return report(comparison, time.monotonic() - started, CorpusSelection.full(sorted(names)))

    corpus = corpus_files()
    if not corpus:
        print("FAIL: no corpus files found (is this a git checkout?)")
        return 1
    selection = choose_selection(options, corpus)
    files = list(selection.paths)

    work = options.keep if options.keep else Path(tempfile.mkdtemp(prefix="compiler_new_parity."))
    work.mkdir(parents=True, exist_ok=True)
    try:
        file_list = work / "corpus.txt"
        file_list.write_text("\n".join(files) + "\n", encoding="utf-8")
        if options.stop_census:
            return run_stop_census(
                work, file_list, selection, options.census_file or default_census_file(REPO_ROOT)
            )
        if selection.targeted:
            return run_targeted_parity(work, file_list, selection, options.adapter_only, started)
        legacy_binary = build_dumper(LEGACY_DUMPER, work, selection)
        discovery_binary = build_dumper(DISCOVERY_DUMPER, work, selection)
        legacy_dump = run_dumper(legacy_binary, file_list)
        discovery_dump = run_dumper(discovery_binary, file_list)
        if options.keep:
            for name, dump in (("legacy.dump", legacy_dump), ("discovery.dump", discovery_dump)):
                (work / name).write_text(dump, encoding="utf-8", errors="surrogateescape")
        legacy_files = parse_dump(legacy_dump)
        discovery_files = parse_dump(discovery_dump)
        comparison = with_stale_allowances(
            compare_dumps(legacy_files, discovery_files), set(files)
        )
        graph_notes, graph_problems = check_discovery_graphs(work, selection)
        comparison.notes.extend(graph_notes)
        comparison.problems.extend(graph_problems)
        # Each root is one more check, failing when its discovery graph is degraded.
        comparison.files += len(ROOT_CHECKS)
        comparison.mismatched_files += sum(1 for line in graph_problems if line.startswith("discovery graph "))
        rejected = {path for path, dump in legacy_files.items() if dump.parse_diagnostics > 0}
        adapter_notes, adapter_problem_lines, adapter_failures = check_adapter(work, file_list, rejected, selection)
        comparison.notes.extend(adapter_notes)
        comparison.problems.extend(adapter_problem_lines)
        # Each adapter run, and the allowance list, is one more check.
        comparison.files += len(ROOT_CHECKS) + 2
        comparison.mismatched_files += adapter_failures
        missing = set(files) - (set(legacy_files) & set(discovery_files))
        if missing:
            comparison.problems.append(f"dumps omit {len(missing)} corpus files, for example {sorted(missing)[0]}")
            comparison.mismatched_files += len(missing)
        return report(comparison, time.monotonic() - started, selection)
    finally:
        if not options.keep:
            shutil.rmtree(work, ignore_errors=True)


def run_targeted_parity(
    work: Path, file_list: Path, selection: CorpusSelection, adapter_only: bool, started: float
) -> int:
    """The narrowed parity run: token and verdict parity over the selected files
    (unless `adapter_only`), then the adapter differential over them. It skips
    the root and graph checks, which no file selection changes."""
    paths = selection.paths
    if adapter_only:
        comparison = compare_selected_dumps({}, {}, ())
        rejected = None
    else:
        legacy_dump = run_dumper(build_dumper(LEGACY_DUMPER, work, selection), file_list)
        discovery_dump = run_dumper(build_dumper(DISCOVERY_DUMPER, work, selection), file_list)
        legacy_files = parse_dump(legacy_dump)
        discovery_files = parse_dump(discovery_dump)
        comparison = compare_selected_dumps(legacy_files, discovery_files, paths)
        rejected = {path for path, dump in legacy_files.items() if dump.parse_diagnostics > 0}
        missing = set(paths) - (set(legacy_files) & set(discovery_files))
        if missing:
            comparison.problems.append(f"dumps omit {len(missing)} selected files, for example {sorted(missing)[0]}")
            comparison.mismatched_files += len(missing)
    notes, problems, failures = check_adapter(work, file_list, rejected, selection)
    comparison.notes.extend(notes)
    comparison.problems.extend(problems)
    # The files covered, whichever checks looked at them.
    comparison.files = len(paths)
    comparison.mismatched_files += failures
    return report(comparison, time.monotonic() - started, selection)


if __name__ == "__main__":
    sys.exit(main())
