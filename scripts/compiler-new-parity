OLD_VALUE_PREFIX = "old="

TREE_PREFIX_NAMESPACE = "tree-prefix-"
TREE_PREFIX_DIFFERENCE = "tree-prefix-difference "
TREE_PREFIX_SKIPPED = "tree-prefix-skipped "
TREE_PREFIX_ERROR = "tree-prefix-error "
TREE_PREFIX_ERROR_STAGES = frozenset(("source", "input", "projection"))
TREE_PREFIX_SUMMARY = "tree-prefix-summary "
TREE_PREFIX_COMPLETED_KINDS = (
