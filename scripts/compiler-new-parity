#!/usr/bin/env python3
"""Compare the new discovery stage with the existing front end over the corpus.

For every tracked `.brp` file under `blorp/src`, `standard_library/src` and
`blorp/test`, both front ends lex and parse the file, and this script checks
per file that they agree on

  * every token: byte range, kind and text (the existing lexer's `#` followed
    by a name is one `DimensionNameToken` in the new lexer, so that pair is
    merged before comparing),
  * whether the lexer reported a diagnostic, and
  * whether the parser rejected the file (the accept/reject verdict), and,
    for a file both reject, the first diagnostic: its `line:column` must be
    the same, and its message and help must be the same except where a
    `WORDING_DIFFERENCES` or `HELP_DIFFERENCES` entry names the difference
    and its reason.

Each side is one dumper program, compiled to a binary once and run once,
sequentially, over the whole file list:

  * `blorp/test/compiler/tools/legacy_front_end_dump.brp` (existing compiler),
  * `blorp/test/compiler_new/tools/corpus_dump.brp` (discovery stage).

It also runs the legacy adapter's differential
(`discovery_adapter_differential.brp`): for the same two roots, and once over
every corpus file as a root of one discovery, each module's parsed program
rebuilt from the discovery stage's tables by `discovery_adapter.brp` (every
declaration and every body) must equal the existing parser's with its
interpolation holes parsed, field for field and span for span. A deliberate
difference needs an `ADAPTER_DIFFERENCES` entry naming it and its reason.

It also checks the discovery stage's module graph (`discovery_module_order_dump.brp`)
for one compile root and one `blorp test` root: it must load at least the
expected number of modules, so a root or package that failed to resolve cannot
pass, and a package fixture must contribute a module with its origin. The same
roots run again with the standard library read from the compiler's embedded
texts (no standard-library directory), and a fixture project runs with two
`blorp.toml` source packages (an export, a module that is not exported, an
internal import and a relative import that must stay in its package).

A mismatch is printed with its file and, for tokens, the first differing
token. Exit status 0 means every file agrees.

Usage: scripts/compiler-new-parity [--keep DIR] [--compare OLD_DUMP NEW_DUMP]
"""

from __future__ import annotations

import argparse
from dataclasses import dataclass, field
import os
import re
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
import time


REPO_ROOT = Path(__file__).resolve().parent.parent

CORPUS_ROOTS = ("blorp/src", "standard_library/src", "blorp/test")
CORPUS_SUFFIX = ".brp"

LEGACY_DUMPER = "blorp/test/compiler/tools/legacy_front_end_dump.brp"
DISCOVERY_DUMPER = "blorp/test/compiler_new/tools/corpus_dump.brp"
DISCOVERY_ORDER_DUMPER = "blorp/test/compiler/tools/discovery_module_order_dump.brp"
ADAPTER_DIFFERENTIAL = "blorp/test/compiler/tools/discovery_adapter_differential.brp"

# The dumpers' command line (see `module_order_options.brp`): the standard
# library from the compiler's embedded texts, and one source package.
EMBEDDED_STANDARD_LIBRARY_FLAG = "--embedded-std"
PACKAGE_FLAG = "--package"

SOURCE_PACKAGE_ORIGIN_PREFIX = "source-package:"
NATIVE_PACKAGE_ORIGIN_PREFIX = "native-package:"

# Lower bounds on each root's module count, well under today's counts (396, 62,
# 39 and 41) so ordinary growth never trips them but a failed resolution does.
COMPILE_ROOT_MINIMUM_MODULES = 300
TEST_ROOT_MINIMUM_MODULES = 50
PACKAGE_FIXTURE_MINIMUM_MODULES = 30

SOURCE_PACKAGE_FIXTURE = "blorp/test/compiler/tools/fixtures/source_packages"
NATIVE_PACKAGE_FIXTURE = "blorp/test/compiler/tools/fixtures/native_package"


@dataclass(frozen=True)
class RootCheck:
    """One root whose discovery graph is checked, and how the dumpers run on it."""

    description: str
    mode: str
    root: str
    # A graph that loads fewer modules than this is degraded (a root or a
    # package that failed to resolve), so it fails.
    minimum_modules: int
    options: tuple[str, ...] = ()
    # Origin prefix (`source-package:`, `native-package:`) at least one module
    # must have, for a fixture that exists to exercise that origin.
    required_origin_prefix: str = ""


# A compile root and a test root (which also seeds the test runtime), each with
# the standard library on disk and embedded, and the source-package fixture:
# `tools` exports `toolkit` and `toolkit/format`, `more` exports `second`.
ROOT_CHECKS = (
    RootCheck("compile root", "compile", "blorp/src/main.brp", COMPILE_ROOT_MINIMUM_MODULES),
    RootCheck(
        "test root",
        "test",
        "blorp/test/compiler_new/stage_01_discovery/test_pipeline.brp",
        TEST_ROOT_MINIMUM_MODULES,
    ),
    RootCheck(
        "compile root, embedded standard library",
        "compile",
        "blorp/src/main.brp",
        COMPILE_ROOT_MINIMUM_MODULES,
        (EMBEDDED_STANDARD_LIBRARY_FLAG,),
    ),
    RootCheck(
        "test root, embedded standard library",
        "test",
        "blorp/test/compiler_new/stage_01_discovery/test_pipeline.brp",
        TEST_ROOT_MINIMUM_MODULES,
        (EMBEDDED_STANDARD_LIBRARY_FLAG,),
    ),
    RootCheck(
        "native package",
        "compile",
        f"{NATIVE_PACKAGE_FIXTURE}/main.brp",
        PACKAGE_FIXTURE_MINIMUM_MODULES,
        required_origin_prefix=NATIVE_PACKAGE_ORIGIN_PREFIX,
    ),
    RootCheck(
        "native package, embedded standard library",
        "compile",
        f"{NATIVE_PACKAGE_FIXTURE}/main.brp",
        PACKAGE_FIXTURE_MINIMUM_MODULES,
        (EMBEDDED_STANDARD_LIBRARY_FLAG,),
        NATIVE_PACKAGE_ORIGIN_PREFIX,
    ),
    RootCheck(
        "source packages",
        "compile",
        f"{SOURCE_PACKAGE_FIXTURE}/app/main.brp",
        PACKAGE_FIXTURE_MINIMUM_MODULES,
        (
            PACKAGE_FLAG,
            f"tools:toolkit:{SOURCE_PACKAGE_FIXTURE}/vendor/toolkit:toolkit,toolkit/format",
            PACKAGE_FLAG,
            f"more:second:{SOURCE_PACKAGE_FIXTURE}/vendor/second:second",
        ),
        SOURCE_PACKAGE_ORIGIN_PREFIX,
    ),
)

