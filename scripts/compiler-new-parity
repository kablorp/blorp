@dataclass(frozen=True)
class RootCheck:
    """One root whose discovery graph is checked, and how the dumpers run on it."""

    description: str
    mode: str
    root: str
    # A graph that loads fewer modules than this is degraded (a root or a
    # package that failed to resolve), so it fails.
    minimum_modules: int
    options: tuple[str, ...] = ()
    # Origin prefix (`source-package:`, `native-package:`) at least one module
    # must have, for a fixture that exists to exercise that origin.
    required_origin_prefix: str = ""


# A compile root and a test root (which also seeds the test runtime), each with
# the standard library on disk and embedded, and the source-package fixture:
# `tools` exports `toolkit` and `toolkit/format`, `more` exports `second`.
ROOT_CHECKS = (
    RootCheck("compile root", "compile", "blorp/src/main.brp", COMPILE_ROOT_MINIMUM_MODULES),
    RootCheck(
        "test root",
        "test",
        "blorp/test/test_compiler_new/test_stage_01_discovery/test_pipeline.brp",
        TEST_ROOT_MINIMUM_MODULES,
    ),
    RootCheck(
        "compile root, embedded standard library",
        "compile",
        "blorp/src/main.brp",
        COMPILE_ROOT_MINIMUM_MODULES,
        (EMBEDDED_STANDARD_LIBRARY_FLAG,),
    ),
    RootCheck(
        "test root, embedded standard library",
        "test",
        "blorp/test/test_compiler_new/test_stage_01_discovery/test_pipeline.brp",
        TEST_ROOT_MINIMUM_MODULES,
        (EMBEDDED_STANDARD_LIBRARY_FLAG,),
    ),
    RootCheck(
        "native package",
        "compile",
        f"{NATIVE_PACKAGE_FIXTURE}/main.brp",
        PACKAGE_FIXTURE_MINIMUM_MODULES,
        required_origin_prefix=NATIVE_PACKAGE_ORIGIN_PREFIX,
    ),
    RootCheck(
        "native package, embedded standard library",
        "compile",
        f"{NATIVE_PACKAGE_FIXTURE}/main.brp",
        PACKAGE_FIXTURE_MINIMUM_MODULES,
        (EMBEDDED_STANDARD_LIBRARY_FLAG,),
        NATIVE_PACKAGE_ORIGIN_PREFIX,
    ),
    RootCheck(
        "source packages",
        "compile",
        f"{SOURCE_PACKAGE_FIXTURE}/app/main.brp",
        PACKAGE_FIXTURE_MINIMUM_MODULES,
        (
            PACKAGE_FLAG,
            f"tools:toolkit:{SOURCE_PACKAGE_FIXTURE}/vendor/toolkit:toolkit,toolkit/format",
            PACKAGE_FLAG,
            f"more:second:{SOURCE_PACKAGE_FIXTURE}/vendor/second:second",
        ),
        SOURCE_PACKAGE_ORIGIN_PREFIX,
    ),
)

