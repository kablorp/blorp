# Default per-artifact timeouts, in seconds, for the test gates. This file is the
# only place the values live: shell scripts source it and compiler-check parses
# its KEY=VALUE lines. BLORP_TEST_TIMEOUT, when set, overrides every one of them
# (it is also the variable `bin/blorp test` itself reads).

# Ordinary generated test artifacts: CLI, package, doctest and fixture runs.
GATE_TEST_TIMEOUT=30
# The runtime gate compiles the complete runtime corpus into one artifact. Its
# measured execution exceeds the ordinary single-artifact default on macOS.
GATE_RUNTIME_TEST_TIMEOUT=60
# Leak instrumentation adds enough teardown work that the consolidated
# ownership corpus also needs a larger execution budget than ordinary tests.
GATE_LEAK_TEST_TIMEOUT=60
# Compiler-owned Blorp suites combine many sources into each generated binary.
# A cold combined run can spend more than 60 seconds in a healthy compiler
# phase without emitting TestSuite progress.
GATE_COMPILER_TEST_TIMEOUT=360
# Compiler-owned sanitizer suites are grouped into source-budgeted executables.
# The largest group currently needs about 107 seconds under ASan/UBSan on macOS,
# so keep a finite per-executable budget with enough headroom for loaded hosts.
GATE_COMPILER_SANITIZE_TEST_TIMEOUT=180
