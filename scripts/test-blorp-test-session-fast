TERMINATION_GRACE_SECONDS = 1.0
DESCENDANT_POLL_SECONDS = 0.05
DIAGNOSTIC_TAIL_BYTES = 64 * 1024
DIAGNOSTIC_READ_BYTES = 64 * 1024
DIAGNOSTIC_DRAIN_BYTES_PER_TURN = 256 * 1024
PROCESS_SAMPLE_ATTEMPTS = 3
PROCESS_SAMPLE_RETRY_SECONDS = 0.02
DARWIN_PROCESS_LIST_INITIAL_BYTES = 4096
DARWIN_PROCESS_LIST_MAX_BYTES = 16 * 1024 * 1024
FINAL_DRAIN_MAX_TURNS = 4
EMBEDDED_INPUT_MANIFEST = "compiler/_build/blorp-cli/embedded-inputs.sha256"
BUILD_INPUT_MANIFEST = "compiler/_build/blorp-cli/build-inputs.sha256"
COMPILER_FINGERPRINT_PREFIX = "blorp-sha256 "


@dataclass(frozen=True)
class FastCase:
    command: tuple[str, ...]
    source_paths: tuple[str, ...]
    median_budget_seconds: float
    supervisor_timeout_seconds: float
    stdin_bytes: bytes | None = None
    expected_stdout: tuple[bytes, ...] = ()
    expected_stderr: tuple[bytes, ...] = ()


@dataclass(frozen=True)
class SupervisedProcessResult:
    timed_out: bool
    descendants_at_exit: frozenset[ProcessIdentity]
    cleanup_survivors: frozenset[ProcessIdentity]
    stdout: bytes
    stderr: bytes
    stdin_delivery_error: str | None = None


@dataclass(frozen=True)
class ProcessIdentity:
    process_id: int
    birth_identity: str


@dataclass(frozen=True)
class ProcessRow:
    parent_process_id: int
    process_group_id: int
    state: str
    birth_identity: str


