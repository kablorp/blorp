#!/usr/bin/env bash
set -euo pipefail

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$script_dir/.." && pwd)

allowed_emit="compiler/blorp/src/stage_10_backend/emit.brp"
allowed_test="compiler/blorp/tests/test_compiler_core_emit.brp"
raw_apis='try_emit_unprojected_prepared_core_program_c_artifact_for_tests|emit_unprojected_core_program_c_artifact_with_profile_for_tests|emit_unprojected_core_program_c_artifact_for_tests'

cd "$repo_root"

status=0
while IFS= read -r path; do
	case "$path" in
		"$allowed_emit"|"$allowed_test")
			;;
		*)
			echo "Unprojected C emission API used outside its renderer-test boundary: $path" >&2
			status=1
			;;
	esac
done < <(rg -l "$raw_apis" --glob '*.brp' . | sed 's#^\./##' || true)

if [ "$status" -ne 0 ]; then
	exit "$status"
fi

echo "C symbol projection boundary: ok"
