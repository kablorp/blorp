#!/usr/bin/env python3
"""Remove identifier and filename prefixes across a tracked repository."""

from __future__ import annotations

import argparse
from pathlib import Path
import re
import subprocess
import sys


IDENTIFIER = re.compile(r"[A-Za-z_][A-Za-z0-9_]*")
IMPORT_MODULE = re.compile(
    r"^(?P<indent>[ \t]+)(?P<path>(?:\.\.?/)?[A-Za-z0-9_./-]+)(?=(?:[ \t]+as[ \t]+|:))",
)


def fail(message: str) -> None:
    raise ValueError(message)


def git(repo: Path, *args: str, capture: bool = False) -> str:
    result = subprocess.run(
        ["git", *args],
        cwd=repo,
        check=True,
        stdout=subprocess.PIPE if capture else None,
        text=True,
    )
    return result.stdout if capture else ""


def repository_root(start: Path) -> Path:
    result = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        cwd=start,
        check=True,
        stdout=subprocess.PIPE,
        text=True,
    )
    return Path(result.stdout.strip()).resolve()


def tracked_text_paths(repo: Path) -> list[Path]:
    output = git(repo, "ls-files", "-z", capture=True)
    paths: list[Path] = []
    for relative in output.split("\0"):
        if not relative:
            continue
        path = repo / relative
        if not path.is_file():
            continue
        try:
            path.read_text()
        except (UnicodeDecodeError, OSError):
            continue
        paths.append(path)
    return paths


def source_text_paths(repo: Path, source_root: Path) -> list[Path]:
    return [path for path in tracked_text_paths(repo) if path.is_relative_to(source_root)]


def parse_override(value: str) -> tuple[str, str]:
    old, separator, new = value.partition("=")
    if not separator or not IDENTIFIER.fullmatch(old) or not IDENTIFIER.fullmatch(new):
        fail(f"invalid --rename {value!r}; expected OLD_IDENTIFIER=NEW_IDENTIFIER")
    if old == new:
        fail(f"invalid --rename {value!r}; endpoints must differ")
    return old, new


def discovered_renames(
    repo: Path,
    source_root: Path,
    prefixes: list[str],
    excluded: set[str],
    protected_modules: set[str],
    overrides: dict[str, str],
) -> dict[str, str]:
    if any(not prefix for prefix in prefixes):
        fail("prefixes must not be empty")
    ordered_prefixes = sorted(set(prefixes), key=len, reverse=True)

    renames: dict[str, str] = {}
    for path in source_text_paths(repo, source_root):
        for identifier in IDENTIFIER.findall(path.read_text()):
            if identifier in excluded or (identifier in protected_modules and identifier not in overrides):
                continue
            for prefix in ordered_prefixes:
                if identifier.startswith(prefix) and len(identifier) > len(prefix):
                    destination = overrides.get(identifier, identifier[len(prefix) :])
                    if not IDENTIFIER.fullmatch(destination):
                        fail(f"stripping {prefix!r} from {identifier!r} produces invalid identifier {destination!r}")
                    renames[identifier] = destination
                    break

    for old, new in overrides.items():
        if old not in excluded:
            renames[old] = new

    validate_renames(renames)
    return renames


def validate_renames(renames: dict[str, str]) -> None:
    destinations: dict[str, str] = {}
    for old, new in renames.items():
        previous = destinations.get(new)
        if previous is not None and previous != old:
            fail(f"both {previous!r} and {old!r} rename to {new!r}")
        destinations[new] = old


def path_module_renames(
    paths: list[tuple[Path, Path]],
) -> dict[str, str]:
    renames: dict[str, str] = {}
    for old, new in paths:
        old_module = old.stem
        new_module = new.stem
        previous = renames.get(old_module)
        if previous is not None and previous != new_module:
            fail(f"{old_module!r} has conflicting destinations {previous!r} and {new_module!r}")
        renames[old_module] = new_module
    validate_renames(renames)
    return renames


def path_renames(
    repo: Path,
    source_root: Path,
    prefix: str | None,
    excluded: set[str],
) -> list[tuple[Path, Path]]:
    if prefix is None:
        return []
    if not prefix:
        fail("--rename-file-prefix must not be empty")

    paths: list[tuple[Path, Path]] = []
    for old in tracked_text_paths(repo):
        if not old.is_relative_to(source_root) or not old.name.startswith(prefix):
            continue
        if old.stem in excluded or old.name in excluded:
            continue
        new = old.with_name(old.name[len(prefix) :])
        paths.append((old.relative_to(repo), new.relative_to(repo)))
    return sorted(paths)


def parse_overrides(values: list[str]) -> dict[str, str]:
    overrides: dict[str, str] = {}
    for value in values:
        old, new = parse_override(value)
        if old in overrides:
            fail(f"duplicate --rename source: {old}")
        overrides[old] = new
    return overrides


def replacement_pattern(renames: dict[str, str]) -> re.Pattern[str] | None:
    if not renames:
        return None
    alternatives = "|".join(re.escape(old) for old in sorted(renames, key=lambda value: -len(value)))
    return re.compile(rf"(?<![A-Za-z0-9_])(?:{alternatives})(?![A-Za-z0-9_])")


def replace_import_modules(text: str, renames: dict[str, str]) -> str:
    def replace(match: re.Match[str]) -> str:
        path = match.group("path")
        prefix, separator, module = path.rpartition("/")
        replacement = renames.get(module)
        if replacement is None:
            return match.group(0)
        updated_path = prefix + separator + replacement if separator else replacement
        return match.group("indent") + updated_path

    lines: list[str] = []
    inside_import = False
    for line in text.splitlines(keepends=True):
        if line.startswith("import:"):
            inside_import = True
            lines.append(line)
            continue
        if inside_import and line.strip() and not line[0].isspace():
            inside_import = False
        lines.append(IMPORT_MODULE.sub(replace, line) if inside_import else line)
    return "".join(lines)


def changed_texts(
    repo: Path,
    renames: dict[str, str],
    modules: dict[str, str],
    paths: list[tuple[Path, Path]],
) -> list[tuple[Path, str]]:
    pattern = replacement_pattern(renames)

    changed: list[tuple[Path, str]] = []
    for path in tracked_text_paths(repo):
        relative = path.relative_to(repo)
        if relative.parts[:2] == ("benchmarks", "results"):
            continue
        original = path.read_text()
        updated = original
        if pattern is not None:
            updated = pattern.sub(lambda match: renames[match.group(0)], updated)
        if path.suffix == ".brp":
            updated = replace_import_modules(updated, modules)
        for old, new in paths:
            path_pairs = [(str(old), str(new))]
            if len(old.parts) >= 2:
                path_pairs.append(("/".join(old.parts[-2:]), "/".join(new.parts[-2:])))
            for old_path, new_path in path_pairs:
                path_pattern = re.compile(
                    rf"(?<![A-Za-z0-9_.-]){re.escape(old_path)}(?![A-Za-z0-9_.-])"
                )
                updated = path_pattern.sub(new_path, updated)
            if path.suffix == ".brp" and old.suffix == ".h":
                updated = updated.replace(
                    f'foreign(include: "{old.name}")',
                    f'foreign(include: "{new.name}")',
                )
        if updated != original:
            changed.append((path, updated))
    return changed


def preflight_paths(repo: Path, paths: list[tuple[Path, Path]]) -> None:
    targets: set[Path] = set()
    for old_relative, new_relative in paths:
        old = repo / old_relative
        new = repo / new_relative
        if not old.exists():
            fail(f"path source does not exist: {old_relative}")
        if new.exists() and new != old:
            fail(f"path target already exists: {new_relative}")
        if new_relative in targets:
            fail(f"duplicate path target: {new_relative}")
        targets.add(new_relative)


def apply(
    repo: Path,
    renames: dict[str, str],
    modules: dict[str, str],
    paths: list[tuple[Path, Path]],
    dry_run: bool,
) -> int:
    preflight_paths(repo, paths)

    for old, new in paths:
        print(f"path\t{old}\t{new}")
    if not dry_run:
        for old, new in paths:
            (repo / new).parent.mkdir(parents=True, exist_ok=True)
            git(repo, "mv", str(old), str(new))

    changes = changed_texts(repo, renames, modules, paths)
    for path, _ in changes:
        print(f"edit\t{path.relative_to(repo)}")
    if not dry_run:
        for path, updated in changes:
            path.write_text(updated)

    print(f"renamed {len(paths)} paths; edited {len(changes)} tracked text files")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("source_root", type=Path)
    parser.add_argument("--strip-prefix", action="append", default=[])
    parser.add_argument("--rename-file-prefix")
    parser.add_argument("--rename", action="append", default=[], metavar="OLD=NEW")
    parser.add_argument("--exclude", action="append", default=[], metavar="IDENTIFIER")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--repo", type=Path, default=Path.cwd())
    arguments = parser.parse_args()

    try:
        repo = repository_root(arguments.repo.resolve())
        source_root = (repo / arguments.source_root).resolve()
        if not source_root.is_dir() or not source_root.is_relative_to(repo):
            fail(f"source root must be a repository directory: {arguments.source_root}")
        excluded = set(arguments.exclude)
        overrides = parse_overrides(arguments.rename)
        if not arguments.strip_prefix and arguments.rename_file_prefix is None:
            fail("at least one --strip-prefix or --rename-file-prefix is required")
        paths = path_renames(
            repo,
            source_root,
            arguments.rename_file_prefix,
            excluded,
        )
        renamed_modules = {old.stem for old, _ in paths}
        protected_modules = {
            path.stem
            for path in tracked_text_paths(repo)
            if path.suffix == ".brp" and path.stem not in renamed_modules
        }
        renames = discovered_renames(
            repo,
            source_root,
            arguments.strip_prefix,
            excluded,
            protected_modules,
            overrides,
        )
        modules = path_module_renames(paths)
        return apply(repo, renames, modules, paths, arguments.dry_run)
    except (ValueError, subprocess.CalledProcessError, OSError) as error:
        print(f"error: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
