#!/bin/bash
set -euo pipefail

cd "$(dirname "$0")/.."

out_dir="${1:-dist}"
binary="${BLORP_RELEASE_BINARY:-./blorp}"
target="${BLORP_RELEASE_TARGET:-$(scripts/target-triple)}"

if [ ! -x "$binary" ]; then
    echo "Release binary not found or not executable: $binary" >&2
    exit 1
fi

version="${BLORP_RELEASE_VERSION:-}"
if [ -z "$version" ]; then
    version=$("$binary" --version | sed -n '1s/^blorp //p' | awk '{print $1}')
fi

if [ -z "$version" ]; then
    echo "Could not determine release version from $binary --version" >&2
    exit 1
fi

archive_base="blorp-${version}-${target}"
tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/blorp-release.XXXXXX")
trap 'rm -rf "$tmp_dir"' EXIT

pkg_dir="$tmp_dir/$archive_base"
mkdir -p "$pkg_dir"
cp "$binary" "$pkg_dir/blorp"
cp README.md LICENSE "$pkg_dir/"

mkdir -p "$out_dir"
tar -C "$tmp_dir" -czf "$out_dir/$archive_base.tar.gz" "$archive_base"
shasum -a 256 "$out_dir/$archive_base.tar.gz" > "$out_dir/$archive_base.tar.gz.sha256"

echo "$out_dir/$archive_base.tar.gz"
echo "$out_dir/$archive_base.tar.gz.sha256"
