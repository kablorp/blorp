#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

out_dir="${1:-dist}"
binary="${BLORP_RELEASE_BINARY:-bin/blorp}"
target="${BLORP_RELEASE_TARGET:-$(scripts/target-triple)}"

if [ ! -x "$binary" ]; then
	echo "Release binary not found or not executable: $binary" >&2
	exit 1
fi
mkdir -p "$out_dir"
output="$out_dir/blorp-${target}"
staged_output="$output.tmp.$$"
trap 'rm -f "$staged_output"' EXIT

cp "$binary" "$staged_output"
chmod 0755 "$staged_output"
mv "$staged_output" "$output"
trap - EXIT

echo "$output"
