#!/bin/bash
set -euo pipefail

cd "$(dirname "$0")/.."

out_dir="${1:-dist}"
binary="${BLORP_RELEASE_BINARY:-./blorp}"
binary_dir=$(dirname "$binary")
ocaml_host="${BLORP_RELEASE_OCAML_HOST:-$binary_dir/blorp-ocaml-host}"
ocaml_middle="${BLORP_RELEASE_OCAML_MIDDLE:-$binary_dir/blorp-ocaml-middle}"
renderer_bridge="${BLORP_RELEASE_RENDERER_BRIDGE:-}"
parser_bridge="${BLORP_RELEASE_PARSER_BRIDGE:-}"
typecheck_bridge="${BLORP_RELEASE_TYPECHECK_BRIDGE:-}"
bridge_override_count=0
for bridge_override in \
    "$renderer_bridge" \
    "$parser_bridge" \
    "$typecheck_bridge"
do
    if [ -n "$bridge_override" ]; then
        bridge_override_count=$((bridge_override_count + 1))
    fi
done
if [ "$bridge_override_count" -ne 0 ] &&
    [ "$bridge_override_count" -ne 3 ]
then
    echo "BLORP_RELEASE_RENDERER_BRIDGE, BLORP_RELEASE_PARSER_BRIDGE, and BLORP_RELEASE_TYPECHECK_BRIDGE must be provided together." >&2
    exit 1
fi
target="${BLORP_RELEASE_TARGET:-$(scripts/target-triple)}"

if [ ! -x "$binary" ]; then
    echo "Release binary not found or not executable: $binary" >&2
    exit 1
fi
if [ ! -x "$ocaml_host" ]; then
    echo "Release OCaml host not found or not executable: $ocaml_host" >&2
    exit 1
fi
if [ ! -x "$ocaml_middle" ]; then
    echo "Release OCaml middle worker not found or not executable: $ocaml_middle" >&2
    exit 1
fi
version="${BLORP_RELEASE_VERSION:-}"
if [ -z "$version" ]; then
    version=$("$binary" --version | sed -n '1s/^blorp //p' | awk '{print $1}')
fi

if [ -z "$version" ]; then
    echo "Could not determine release version from $binary --version" >&2
    exit 1
fi

archive_base="blorp-${version}-${target}"
tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/blorp-release.XXXXXX")
trap 'rm -rf "$tmp_dir"' EXIT

if [ "$bridge_override_count" -eq 0 ]; then
    prepared_bridge_dir="$tmp_dir/prepared-bridges"
    mkdir -p "$prepared_bridge_dir"
    BLORP_OCAML_HOST_BIN="$ocaml_host" \
        BLORP_OCAML_MIDDLE_BIN="$ocaml_middle" \
        "$binary" __compiler-bridge-prepare "$prepared_bridge_dir" >/dev/null
    renderer_bridge="$prepared_bridge_dir/compiler_renderer_bridge.bin"
    parser_bridge="$prepared_bridge_dir/compiler_parser_bridge.bin"
    typecheck_bridge="$prepared_bridge_dir/compiler_typecheck_bridge.bin"
fi

if [ ! -x "$renderer_bridge" ]; then
    echo "Release renderer bridge not found or not executable: $renderer_bridge" >&2
    exit 1
fi
if [ ! -x "$parser_bridge" ]; then
    echo "Release parser bridge not found or not executable: $parser_bridge" >&2
    exit 1
fi
if [ ! -x "$typecheck_bridge" ]; then
    echo "Release typecheck bridge not found or not executable: $typecheck_bridge" >&2
    exit 1
fi

pkg_dir="$tmp_dir/$archive_base"
mkdir -p "$pkg_dir"
cp "$binary" "$pkg_dir/blorp"
cp "$ocaml_host" "$pkg_dir/blorp-ocaml-host"
cp "$ocaml_middle" "$pkg_dir/blorp-ocaml-middle"
cp "$renderer_bridge" "$pkg_dir/blorp-compiler-renderer"
cp "$parser_bridge" "$pkg_dir/blorp-compiler-parser"
cp "$typecheck_bridge" "$pkg_dir/blorp-compiler-typecheck"
cp README.md LICENSE "$pkg_dir/"

mkdir -p "$out_dir"
tar -C "$tmp_dir" -czf "$out_dir/$archive_base.tar.gz" "$archive_base"
shasum -a 256 "$out_dir/$archive_base.tar.gz" > "$out_dir/$archive_base.tar.gz.sha256"

echo "$out_dir/$archive_base.tar.gz"
echo "$out_dir/$archive_base.tar.gz.sha256"
