#!/usr/bin/env bash

set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
BLORP=${1:-bin/blorp}
FIXTURE=blorp/test/compiler/pipeline/codegen_audit/should_pass/int16_add_trait_intrinsic.brp
GENERATED_C=$(mktemp "${TMPDIR:-/tmp}/blorp-trait-operators.XXXXXX")
trap 'rm -f "$GENERATED_C"' EXIT

cd "$ROOT"

if [[ ! -x "$BLORP" ]]; then
	echo "compiler is missing: $BLORP; run make first" >&2
	exit 1
fi

"$BLORP" test --timeout 180 \
	blorp/test/compiler/stage_06_typecheck/type_system/test_env.brp \
	blorp/test/compiler/stage_06_typecheck/test_infer.brp \
	blorp/test/compiler/stage_08_core_lower/test_core_lower.brp \
	blorp/test/compiler/stage_09_core/test_core_synth.brp \
	blorp/test/compiler/stage_09_core/test_core_trait_resolve.brp
"$BLORP" run --no-format "$FIXTURE"
"$BLORP" compile --check-invariants --no-format --no-embed-runtime -o "$GENERATED_C" "$FIXTURE"

grep -Fq 'return (operator_left + operator_right);' "$GENERATED_C"
grep -Fq 'return (explicit_left + explicit_right);' "$GENERATED_C"
grep -Fq 'return (generic_left + generic_right);' "$GENERATED_C"
grep -Fq 'return (operator_left - operator_right);' "$GENERATED_C"
grep -Fq 'return (explicit_left - explicit_right);' "$GENERATED_C"
grep -Fq 'return (generic_left - generic_right);' "$GENERATED_C"
grep -Fq 'return (operator_left * operator_right);' "$GENERATED_C"
grep -Fq 'return (explicit_left * explicit_right);' "$GENERATED_C"
grep -Fq 'return (generic_left * generic_right);' "$GENERATED_C"
grep -Fq 'return ((int16_t)(-operator_value));' "$GENERATED_C"
grep -Fq 'return ((int16_t)(-explicit_value));' "$GENERATED_C"
grep -Fq 'return ((int16_t)(-generic_value));' "$GENERATED_C"
grep -Fq 'return (operator_left == operator_right);' "$GENERATED_C"
grep -Fq 'return (explicit_left == explicit_right);' "$GENERATED_C"
grep -Fq 'return (generic_left == generic_right);' "$GENERATED_C"
grep -Fq 'return (operator_left != operator_right);' "$GENERATED_C"
grep -Fq 'return (explicit_left != explicit_right);' "$GENERATED_C"
grep -Fq 'return (generic_left != generic_right);' "$GENERATED_C"
grep -Fq 'return (operator_left < operator_right);' "$GENERATED_C"
grep -Fq 'return (explicit_left < explicit_right);' "$GENERATED_C"
grep -Fq 'return (generic_left < generic_right);' "$GENERATED_C"
grep -Fq 'return (operator_left > operator_right);' "$GENERATED_C"
grep -Fq 'return (explicit_left > explicit_right);' "$GENERATED_C"
grep -Fq 'return (operator_left <= operator_right);' "$GENERATED_C"
grep -Fq 'return (explicit_left <= explicit_right);' "$GENERATED_C"
grep -Fq 'return (operator_left >= operator_right);' "$GENERATED_C"
grep -Fq 'return (explicit_left >= explicit_right);' "$GENERATED_C"
grep -Fq 'return (blorp_string_compare(left, right) < 0);' "$GENERATED_C"
grep -Fq 'return blorp_fixed_ge(left, right);' "$GENERATED_C"
grep -Fq 'int16_t __blorp_internal_arithmetic_left = operator_left; int16_t __blorp_internal_arithmetic_right = operator_right;' "$GENERATED_C"
grep -Fq 'int16_t __blorp_internal_arithmetic_left = explicit_left; int16_t __blorp_internal_arithmetic_right = explicit_right;' "$GENERATED_C"
grep -Fq 'int16_t __blorp_internal_arithmetic_left = generic_left; int16_t __blorp_internal_arithmetic_right = generic_right;' "$GENERATED_C"
grep -Fq '__blorp_internal_arithmetic_right == -1 && __blorp_internal_arithmetic_left == INT16_MIN ? INT16_MIN' "$GENERATED_C"
grep -Fq '__blorp_internal_arithmetic_left % __blorp_internal_arithmetic_right' "$GENERATED_C"
grep -Fq 'fmod(' "$GENERATED_C"
grep -Fq 'fmodf(' "$GENERATED_C"
grep -Fq 'blorp_string_concat(' "$GENERATED_C"
grep -Fq 'blorp_fixed_add(' "$GENERATED_C"
grep -Fq 'blorp_fixed_sub(' "$GENERATED_C"
grep -Fq 'blorp_fixed_mul(' "$GENERATED_C"
grep -Fq 'blorp_fixed_div(' "$GENERATED_C"
grep -Fq 'return blorp_string_eq(left, right);' "$GENERATED_C"
grep -Fq 'return (!blorp_string_eq(left, right));' "$GENERATED_C"
grep -Fq 'return blorp_vector_eq(0, left, right);' "$GENERATED_C"
grep -Fq 'return (!blorp_vector_eq(0, left, right));' "$GENERATED_C"

if grep -Eq 'Addable_add_(Int16|String|Fixed)\(|Subtractable_subtract_(Int16|Fixed)\(|Multipliable_multiply_(Int16|Fixed)\(|Divisible_divide_(Int16|Fixed)\(|Modulable_remainder_(Int16|Float|Float16|Float32)\(|Negatable_negate_(Int|Int8|Int16|Int32|Int128|Float|Float16|Float32)\(|Equatable_(equals|not_equals)_(Int|Int8|Int16|Int32|Int128|UInt8|UInt16|UInt32|UInt64|UInt128|Float|Float16|Float32|Fixed|Bool|Char)\(|Orderable_(less_than|greater_than|less_than_or_equal|greater_than_or_equal)_(Int|Int8|Int16|Int32|Int128|UInt8|UInt16|UInt32|UInt64|UInt128|Float|Float16|Float32|Fixed|Char)\(' "$GENERATED_C"; then
	echo "generated C contains an avoidable scalar trait wrapper" >&2
	exit 1
fi

echo "trait operator checks passed"
