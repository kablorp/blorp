#!/usr/bin/env bash

set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
BLORP=${1:-bin/blorp}
FIXTURE=blorp/test/compiler/pipeline/codegen_audit/should_pass/int16_add_trait_intrinsic.brp
GENERATED_C=$(mktemp "${TMPDIR:-/tmp}/blorp-trait-operators.XXXXXX.c")
trap 'rm -f "$GENERATED_C"' EXIT

cd "$ROOT"

if [[ ! -x "$BLORP" ]]; then
	echo "compiler is missing: $BLORP; run make first" >&2
	exit 1
fi

"$BLORP" test --timeout 180 \
	blorp/test/compiler/stage_08_core_lower/test_core_lower.brp \
	blorp/test/compiler/stage_09_core/test_core_synth.brp \
	blorp/test/compiler/stage_09_core/test_core_trait_resolve.brp
"$BLORP" run --no-format "$FIXTURE"
"$BLORP" compile --no-format --no-embed-runtime -o "$GENERATED_C" "$FIXTURE"

grep -Fq 'return (operator_left + operator_right);' "$GENERATED_C"
grep -Fq 'return (explicit_left + explicit_right);' "$GENERATED_C"
grep -Fq 'return (generic_left + generic_right);' "$GENERATED_C"
grep -Fq 'return (operator_left - operator_right);' "$GENERATED_C"
grep -Fq 'return (explicit_left - explicit_right);' "$GENERATED_C"
grep -Fq 'return (generic_left - generic_right);' "$GENERATED_C"
grep -Fq 'return (operator_left * operator_right);' "$GENERATED_C"
grep -Fq 'return (explicit_left * explicit_right);' "$GENERATED_C"
grep -Fq 'return (generic_left * generic_right);' "$GENERATED_C"

if grep -Eq 'Addable_add_Int16\(|Subtractable_subtract_Int16\(|Multipliable_multiply_Int16\(' "$GENERATED_C"; then
	echo "generated C contains an avoidable scalar trait wrapper" >&2
	exit 1
fi

echo "trait operator checks passed"
