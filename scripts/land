#!/bin/bash
# Land one branch on main as a single commit and push it.
#
#   scripts/land <branch> --title "<title>" [--body "<text>"] \
#       [--record <file> --record-name <name>] [--dry-run]
#
# 1. Merge origin/main into the branch, so any conflict is resolved on the
#    branch. This happens in the branch's own worktree when it is checked out
#    somewhere (that worktree must be clean), otherwise in a temporary one, so
#    the branch gets the merge commit even on a dry run.
# 2. Squash-merge the branch onto origin/main as one commit with the given
#    title, in a temporary detached worktree; the caller's checkout is untouched.
# 3. Push that commit to origin main. If origin/main moved meanwhile, repeat
#    from 1; any other push failure stops the landing.
#
# It runs no gates. Validate the branch first with the CI-equivalent Docker
# gate: `scripts/docker-gate --premerge-gate -- --no-sanitize`.
set -euo pipefail

usage() {
    echo "Usage: scripts/land <branch> --title TITLE [--body TEXT]" >&2
    echo "  [--record FILE --record-name NAME] [--dry-run]" >&2
}

# How many times to re-merge and retry when origin/main moves between the
# squash commit and the push.
PUSH_ATTEMPTS=5

branch="" title="" body="" record="" record_name="" dry_run=0
while [ $# -gt 0 ]; do
    case "$1" in
        --title) title="$2"; shift 2 ;;
        --body) body="$2"; shift 2 ;;
        --record) record="$2"; shift 2 ;;
        --record-name) record_name="$2"; shift 2 ;;
        --dry-run) dry_run=1; shift ;;
        -h|--help) usage; exit 0 ;;
        -*) echo "Unknown option: $1" >&2; usage; exit 1 ;;
        *) [ -z "$branch" ] || { echo "Only one branch may be given." >&2; exit 1; }; branch="$1"; shift ;;
    esac
done
[ -n "$branch" ] || { echo "Missing branch." >&2; usage; exit 1; }
[ -n "$title" ] || { echo "Missing --title." >&2; usage; exit 1; }
case "$title" in
    Merge*) echo "Refusing title starting with 'Merge': $title" >&2; exit 1 ;;
esac
printf '%s' "$title" | grep -Eq '#[0-9]+' &&
    { echo "Refusing title containing an issue reference: $title" >&2; exit 1; }
if { [ -n "$record" ] && [ -z "$record_name" ]; } || { [ -z "$record" ] && [ -n "$record_name" ]; }; then
    echo "--record and --record-name must be given together." >&2
    exit 1
fi
if [ -n "$record" ]; then
    [ -f "$record" ] || { echo "No such record file: $record" >&2; exit 1; }
    record="$(cd "$(dirname "$record")" && pwd -P)/$(basename "$record")"
fi
git show-ref --verify --quiet "refs/heads/$branch" ||
    { echo "Not a local branch: $branch" >&2; exit 1; }

# The worktree that has the branch checked out, if any.
branch_worktree() {
    git worktree list --porcelain | awk -v ref="branch refs/heads/$branch" '
        /^worktree / { tree = substr($0, 10) }
        $0 == ref { print tree }'
}

scratch="$(mktemp -d "${TMPDIR:-/tmp}/blorp-land.XXXXXX")"
temp_worktrees=()
cleanup() {
    for tree in ${temp_worktrees[@]+"${temp_worktrees[@]}"}; do
        git worktree remove --force "$tree" >/dev/null 2>&1 || true
    done
    git worktree prune >/dev/null 2>&1 || true
    rm -rf "$scratch"
}
trap cleanup EXIT

merge_main_into_branch() {
    local tree
    tree="$(branch_worktree)"
    if [ -n "$tree" ]; then
        if [ -n "$(git -C "$tree" status --porcelain)" ]; then
            echo "Refusing: $branch is checked out at $tree with uncommitted changes." >&2
            exit 1
        fi
    else
        tree="$scratch/branch"
        git worktree add -q "$tree" "$branch"
        temp_worktrees+=("$tree")
    fi
    git -C "$tree" merge-base --is-ancestor origin/main HEAD && return 0
    if ! git -C "$tree" merge -q --no-edit origin/main; then
        git -C "$tree" merge --abort 2>/dev/null || true
        echo "Could not merge origin/main into $branch (see above); resolve it on the branch and rerun." >&2
        exit 1
    fi
}

attempt=1
while :; do
    git fetch -q origin
    base="$(git rev-parse origin/main)"

    # 1. Bring the branch up to date with main.
    merge_main_into_branch

    # 2. One squash commit on top of main, in a temporary detached worktree.
    land_tree="$scratch/land-$attempt"
    git worktree add -q --detach "$land_tree" "$base"
    temp_worktrees+=("$land_tree")
    if ! git -C "$land_tree" merge -q --squash "$branch"; then
        echo "Squash-merging $branch onto origin/main failed unexpectedly after the branch was merged with it." >&2
        exit 1
    fi
    if [ -n "$record" ]; then
        mkdir -p "$land_tree/benchmarks/results"
        cp "$record" "$land_tree/benchmarks/results/$record_name"
        git -C "$land_tree" add "benchmarks/results/$record_name"
    fi
    if git -C "$land_tree" diff --cached --quiet; then
        echo "$branch has no changes relative to origin/main." >&2
        exit 1
    fi
    if [ -n "$body" ]; then
        git -C "$land_tree" commit -q -m "$title" -m "$body"
    else
        git -C "$land_tree" commit -q -m "$title"
    fi
    landed_sha="$(git -C "$land_tree" rev-parse HEAD)"

    if [ "$dry_run" -eq 1 ]; then
        echo "Dry run: not pushed. Squash commit: $landed_sha"
        exit 0
    fi

    # 3. Push. Retry only when the rejection is because origin/main moved.
    if git -C "$land_tree" push -q origin HEAD:main; then
        echo "Landed $landed_sha on main."
        exit 0
    fi
    git fetch -q origin
    if [ "$(git rev-parse origin/main)" = "$base" ]; then
        echo "Push failed and origin/main did not move; not retrying." >&2
        exit 1
    fi
    if [ "$attempt" -ge "$PUSH_ATTEMPTS" ]; then
        echo "origin/main kept moving; gave up after $PUSH_ATTEMPTS attempts." >&2
        exit 1
    fi
    attempt=$((attempt + 1))
    echo "origin/main moved; merging it into $branch and retrying ($attempt/$PUSH_ATTEMPTS)." >&2
done
