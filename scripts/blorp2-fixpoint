#!/bin/bash
# Measure and prove the Blorp 2 self-compile fixpoint.
#
# Stages, after the self-compile plan's definition of done:
#   A   the host bin/blorp builds blorp_2/src into compiler A
#   B   A compiles blorp_2/src; the C compiler links B
#   C   B compiles blorp_2/src; the C compiler links C; C compiles blorp_2/src
# The fixpoint holds when B and C emit byte-identical C for blorp_2/src, A and B
# emit identical C and diagnostics for every e2e fixture, and B passes the e2e
# suite. Every stage links at -O2 through the Makefile's own recipes
# (make -C blorp_2 test-compiler and link-test-compiler), so the compile and
# link flags have one source; the e2e suite then runs B through the same
# Makefile (make -C blorp_2 test-e2e BLORP2_COMPILER=...).
#
# Usage:
#   scripts/blorp2-fixpoint --frontier   how far the pilot gets on its own source;
#                                        a measurement, so it always exits 0
#   scripts/blorp2-fixpoint --prove      the M8 gate: exit 0 at the fixpoint, 1 at
#                                        the first failed stage with its reason
# Setup errors exit 2 in both modes: a stale host, missing tools, a failed stage A
# build, or (--frontier) a failing or count-less source-tree suite run.
#
# The frontier is one rung of this ladder, the first that fails:
#   parsed N/M      N of M files under blorp_2/src parse, as the unit suite
#                   test/unit/test_parse/test_source_tree reports (frontier only)
#   rejected        A rejects main.brp with a diagnostic in a source file: loading,
#                   parsing or checking; the pilot does not name the phase
#   internal-error  A rejects main.brp with a compiler-located diagnostic
#   crash           A ends with a signal or an exit status other than 0 or 1
#   b-links         the C compiler rejects A's C
#   b-emits         B fails on main.brp
#   c-links         the C compiler rejects B's C
#   c-emits         C fails on main.brp
#   b-equals-c      B and C emit different C (the first differing line is printed)
#   fixtures        A and B differ on an e2e fixture
#   e2e             B fails the e2e suite
#   fixpoint        every stage passed
#
# Artifacts and provenance.txt are written under blorp_2/build/fixpoint/, which
# is ignored; a run replaces the previous one.

set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd -P)
cd "$root"

source_dir=blorp_2/src
main_source=$source_dir/main.brp
library_root=blorp_2/standard_library_temp
fixture_root=blorp_2/test/e2e/fixtures
work=$root/blorp_2/build/fixpoint
stage_flags=-O2

usage() {
    sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'
}

die() {
    echo "blorp2-fixpoint: error: $*" >&2
    exit 2
}

mode=""
case ${1:-} in
    --frontier|--prove) mode=${1#--} ;;
    --help|-h) usage; exit 0 ;;
    "") die "a mode is required: --frontier or --prove" ;;
    *) die "unknown argument: $1" ;;
esac
[ $# -eq 1 ] || die "$1 takes no further arguments"

if command -v shasum > /dev/null 2>&1; then
    sha() { shasum -a 256 "$1" | cut -d ' ' -f 1; }
else
    sha() { sha256sum "$1" | cut -d ' ' -f 1; }
fi

note() {
    printf '%s\n' "$*" | tee -a "$work/provenance.txt"
}

# The ladder stops at the first failing rung: a measurement in --frontier, a
# verdict in --prove.
stop() {
    local rung=$1 reason=$2
    echo
    if [ "$mode" = frontier ]; then
        echo "frontier: $rung"
        echo "  $reason"
        echo "artifacts: $work"
        exit 0
    fi
    echo "NOT A FIXPOINT at $rung: $reason"
    echo "artifacts: $work"
    exit 1
}

# The pilot's command line is its only interface; a parent's leak mode would
# add stderr lines, so the environment is isolated as the e2e harness does.
# Prints nothing; returns the pilot's exit status (128+signal for a signal).
run_pilot() {
    local compiler=$1 input=$2 output=$3 stdout=$4 stderr=$5
    /usr/bin/env -u BLORP_LEAK_CHECK -u BLORP_MEMORY_STATS "$compiler" \
        --library-root "$library_root" "$input" "$output" > "$stdout" 2> "$stderr"
}

# Classifies A's run on main.brp from its exit status and the form of the
# first stderr line: ok, crash, internal-error (the compiler-located
# `blorp_2: error: ` form that blorp_2/src/main.brp renders) or rejected (a
# diagnostic located in a source file). The pilot names neither the phase nor,
# by exit status, whether a rejection is internal; a distinct exit status for
# internal errors would remove this last reading of diagnostic text.
classify() {
    local status=$1 stderr=$2
    case $status in
        0) echo ok ;;
        1) case $(head -n 1 "$stderr") in
               "blorp_2: error: "*) echo internal-error ;;
               *) echo rejected ;;
           esac ;;
        *) echo crash ;;
    esac
}

first_line() {
    head -n 1 "$1"
}

build_stage() {
    local generated_c=$1 binary=$2 label=$3 log=$work/$(basename "$2").build.log
    shift 3
    echo "== $label"
    if ! make -C blorp_2 --no-print-directory "$@" \
        BLORP2_COMPILER_C="$generated_c" BLORP2_COMPILER="$binary" \
        TEST_COMPILER_FLAGS="$stage_flags" > "$log" 2>&1; then
        tail -n 20 "$log" >&2
        return 1
    fi
}

# Reports the first differing line of B's and C's C, like scripts/compiler-fixpoint.
first_difference() {
    local left=$1 right=$2 report line
    report=$(cmp "$left" "$right" 2>&1 || true)
    case $report in
        *" differ: "*"line "*)
            line=${report##*line }
            echo "first difference at line $line:"
            echo "  B: $(sed -n "${line}p" "$left" | cut -c 1-200)"
            echo "  C: $(sed -n "${line}p" "$right" | cut -c 1-200)" ;;
        *)
            echo "one output is a prefix of the other: B's C has $(wc -l < "$left" | tr -d ' ') lines, C's has $(wc -l < "$right" | tr -d ' ')" ;;
    esac
}

# --- setup and provenance -------------------------------------------------

[ -x bin/blorp ] || die "bin/blorp is missing; run make first"
scripts/compiler-build-status --quiet || die "bin/blorp is not FRESH; run make first"
rm -rf "$work"
mkdir -p "$work"
cc=${BLORP_CC:-clang}
note "mode=$mode"
note "revision=$(git rev-parse HEAD)"
note "host_binary=bin/blorp"
note "host_commit=$(bin/blorp --version | sed -n 's/^commit: //p')"
note "host_binary_sha256=$(sha bin/blorp)"
note "cc=$cc"
note "cc_version=$("$cc" --version | head -n 1)"
note "stage_link=make -C blorp_2 link-test-compiler TEST_COMPILER_FLAGS=$stage_flags (memory diagnostics on, as the e2e suite requires)"
note "library_root=$library_root"
note "BLORP_2_INSTRUCTION_CHECK=${BLORP_2_INSTRUCTION_CHECK:-unset (the e2e harness requires counters)}"
note "started_utc=$(date -u +%Y-%m-%dT%H:%M:%SZ)"

# --- stage A: the host builds the pilot -----------------------------------

host_c=$work/host.c
stage_a=$work/stage_a
build_stage "$host_c" "$stage_a" "stage A: bin/blorp emits $source_dir; link A" test-compiler \
    || die "stage A not built: the host could not build the pilot; see $work/stage_a.build.log"
note "host_c_sha256=$(sha "$host_c")"
note "stage_a_sha256=$(sha "$stage_a")"

# --- frontier only: how many source files parse ---------------------------
# The unit suite parses each file directly and prints one line per file
# ("parsed  PATH" or "stopped PATH at MESSAGE") and the count.

if [ "$mode" = frontier ]; then
    suite=blorp_2/test/unit/test_parse/test_source_tree.brp
    echo "== $suite"
    if ! bin/blorp test --timeout 180 "$suite" > "$work/source_tree.log" 2>&1; then
        tail -n 20 "$work/source_tree.log" >&2
        die "the source-tree parse suite failed; see $work/source_tree.log"
    fi
    count=$(sed -n 's/^\([0-9][0-9]*\/[0-9][0-9]*\) source files parsed$/\1/p' "$work/source_tree.log")
    [ -n "$count" ] || die "the source-tree parse suite printed no 'N/M source files parsed' line; see $work/source_tree.log"
    note "parsed=$count"
    if [ "${count%/*}" -ne "${count#*/}" ]; then
        grep '^stopped ' "$work/source_tree.log" || true
        stop "parsed $count" "the files above do not parse; the suite's output is in $work/source_tree.log"
    fi
fi

# --- stage B: A compiles the pilot ----------------------------------------

a_c=$work/a.c
stage_b=$work/stage_b
echo "== stage B: A emits $source_dir"
status=0
run_pilot "$stage_a" "$main_source" "$a_c" "$work/a.stdout" "$work/a.stderr" || status=$?
rung=$(classify "$status" "$work/a.stderr")
case $rung in
    ok) ;;
    crash) stop crash "stage B not built: A exited with status $status on $main_source" ;;
    *) stop "$rung" "stage B not built: A rejects $main_source: $(first_line "$work/a.stderr")" ;;
esac
note "a_c_sha256=$(sha "$a_c")"
build_stage "$a_c" "$stage_b" "stage B: link B from A's C" link-test-compiler \
    || stop b-links "stage B not built: the C compiler rejects A's C; see $work/stage_b.build.log"
note "stage_b_sha256=$(sha "$stage_b")"

# --- stage C: B compiles the pilot, C compiles it again -------------------

b_c=$work/b.c
stage_c=$work/stage_c
c_c=$work/c.c
echo "== stage C: B emits $source_dir"
run_pilot "$stage_b" "$main_source" "$b_c" "$work/b.stdout" "$work/b.stderr" \
    || stop b-emits "stage C not built: B fails on $main_source: $(first_line "$work/b.stderr")"
note "b_c_sha256=$(sha "$b_c")"
build_stage "$b_c" "$stage_c" "stage C: link C from B's C" link-test-compiler \
    || stop c-links "stage C not built: the C compiler rejects B's C; see $work/stage_c.build.log"
note "stage_c_sha256=$(sha "$stage_c")"
echo "== C emits $source_dir"
run_pilot "$stage_c" "$main_source" "$c_c" "$work/c.stdout" "$work/c.stderr" \
    || stop c-emits "C fails on $main_source: $(first_line "$work/c.stderr")"
note "c_c_sha256=$(sha "$c_c")"

if cmp -s "$a_c" "$b_c"; then
    note "a_equals_b_on_source=yes"
else
    note "a_equals_b_on_source=no (A was built by the host; B by the pilot)"
fi
if cmp -s "$b_c" "$c_c"; then
    note "b_equals_c_on_source=yes"
else
    note "b_equals_c_on_source=no"
    first_difference "$b_c" "$c_c"
    stop b-equals-c "B and C emit different C for $source_dir"
fi

# --- every e2e fixture under A and under B --------------------------------

echo "== every fixture under A and under B"
find "$fixture_root" -name '*.brp' | LC_ALL=C sort > "$work/fixtures.txt"
fixture_total=$(wc -l < "$work/fixtures.txt" | tr -d ' ')
count=0
while IFS= read -r fixture; do
    count=$((count + 1))
    relative=${fixture#"$fixture_root"/}
    for stage in a b; do
        out=$work/fixtures/$stage/$relative
        mkdir -p "$(dirname "$out")"
        status=0
        run_pilot "$work/stage_$stage" "$fixture" "$out.c" "$out.stdout" "$out.stderr" || status=$?
        echo "$status" > "$out.exit"
    done
    out_a=$work/fixtures/a/$relative
    out_b=$work/fixtures/b/$relative
    for part in exit stdout stderr; do
        cmp -s "$out_a.$part" "$out_b.$part" \
            || stop fixtures "A and B differ on $relative ($part): A $(first_line "$out_a.$part"); B $(first_line "$out_b.$part")"
    done
    if [ -e "$out_a.c" ] || [ -e "$out_b.c" ]; then
        { [ -e "$out_a.c" ] && [ -e "$out_b.c" ] && cmp -s "$out_a.c" "$out_b.c"; } \
            || stop fixtures "A and B emit different C for $relative"
    fi
    if [ $((count % 50)) -eq 0 ] || [ "$count" -eq "$fixture_total" ]; then
        echo "fixtures: $count/$fixture_total identical"
    fi
done < "$work/fixtures.txt"
note "fixtures_identical_under_a_and_b=$fixture_total"

# --- the e2e suite under B ------------------------------------------------

echo "== the e2e suite under B (log: $work/e2e.log)"
if ! make -C blorp_2 --no-print-directory test-e2e BLORP2_COMPILER="$stage_b" > "$work/e2e.log" 2>&1; then
    tail -n 20 "$work/e2e.log"
    stop e2e "B fails the e2e suite; see $work/e2e.log"
fi
note "e2e_under_b=passed"

echo
if [ "$mode" = frontier ]; then
    echo "frontier: fixpoint"
else
    echo "FIXPOINT: B and C emit identical C; A and B agree on every fixture; B passes e2e"
fi
echo "artifacts: $work"
