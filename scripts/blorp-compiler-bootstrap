#!/usr/bin/env bash
# Resolve the pinned Blorp executable used to compile compiler-owned Blorp
# sources. Keep this pin boring and explicit so self-hosted compiler changes do
# not accidentally depend on the just-built workspace ./blorp.

set -euo pipefail

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
repo_root=$(cd "$script_dir/.." && pwd -P)
manifest="$repo_root/compiler/bootstrap.env"

if [ ! -r "$manifest" ]; then
	echo "Compiler bootstrap manifest is missing: $manifest" >&2
	exit 1
fi

# shellcheck source=../compiler/bootstrap.env
source "$manifest"

for required_value in \
	BLORP_BOOTSTRAP_REPO \
	BLORP_BOOTSTRAP_TAG \
	BLORP_BOOTSTRAP_VERSION \
	BLORP_BOOTSTRAP_LAYOUT \
	BLORP_BOOTSTRAP_SHA256_AARCH64_APPLE_DARWIN \
	BLORP_BOOTSTRAP_SHA256_X86_64_UNKNOWN_LINUX_GNU \
	BLORP_BOOTSTRAP_SHA256_AARCH64_UNKNOWN_LINUX_GNU
do
	if [ -z "${!required_value:-}" ]; then
		echo "Compiler bootstrap manifest is missing $required_value: $manifest" >&2
		exit 1
	fi
done

repo="${BLORP_COMPILER_BOOTSTRAP_REPO:-$BLORP_BOOTSTRAP_REPO}"
tag="$BLORP_BOOTSTRAP_TAG"
version="$BLORP_BOOTSTRAP_VERSION"
layout="$BLORP_BOOTSTRAP_LAYOUT"

case "$layout" in
	single | toolchain) ;;
	*)
		echo "Compiler bootstrap manifest has unsupported layout: $layout" >&2
		exit 1
		;;
esac
toolchain_executables="blorp blorp-ocaml-host blorp-compiler-renderer blorp-compiler-parser blorp-compiler-typecheck"
bootstrap_compiler_executable="blorp-bootstrap-compiler"
bootstrap_companion_executables="blorp-bootstrap-host blorp-bootstrap-renderer blorp-bootstrap-parser blorp-bootstrap-typecheck"
bootstrap_artifact_executables="$bootstrap_compiler_executable $bootstrap_companion_executables"
bootstrap_layout_name="blorp-bootstrap-layout"
bootstrap_layout_version="isolated-v1"
bootstrap_artifact_files="$bootstrap_artifact_executables $bootstrap_layout_name"

if [[ ! "$tag" =~ ^dev-[0-9a-f]{12}$ ]]; then
	echo "Compiler bootstrap tag must be an immutable dev revision: $tag" >&2
	exit 1
fi

revision="${tag#dev-}"
if [[ "$version" != *"-dev.$revision" ]]; then
	echo "Compiler bootstrap version does not match $tag: $version" >&2
	exit 1
fi

for archive_sha in \
	"$BLORP_BOOTSTRAP_SHA256_AARCH64_APPLE_DARWIN" \
	"$BLORP_BOOTSTRAP_SHA256_X86_64_UNKNOWN_LINUX_GNU" \
	"$BLORP_BOOTSTRAP_SHA256_AARCH64_UNKNOWN_LINUX_GNU"
do
	if [[ ! "$archive_sha" =~ ^[0-9a-f]{64}$ ]]; then
		echo "Compiler bootstrap manifest contains an invalid SHA-256: $archive_sha" >&2
		exit 1
	fi
done

cache_root="${BLORP_COMPILER_BOOTSTRAP_CACHE_DIR:-}"
if [ -z "$cache_root" ]; then
	if [ -n "${XDG_CACHE_HOME:-}" ]; then
		cache_root="$XDG_CACHE_HOME/blorp/compiler-bootstrap"
	else
		cache_root="${HOME:-/tmp}/.cache/blorp/compiler-bootstrap"
	fi
fi

usage() {
	cat <<'EOF'
Usage: scripts/blorp-compiler-bootstrap [options] [blorp-args...]

Resolve and run the pinned Blorp executable used for compiler-owned Blorp code.
When running blorp, this wrapper uses the current repository root as the working
directory so the pinned compiler can find compiler bootstrap manifests.

Options:
  --print-tag            Print the pinned release tag without running blorp
  --print-id             Print the pinned release id without running blorp
  --print-path           Print the resolved executable path without running blorp
  --print-toolchain-dir  Print the verified complete-toolchain directory
  --print-compiler-path  Print the immutable compiler used to build Blorp itself
  -h, --help             Show this help

Environment:
  BLORP_COMPILER_BOOTSTRAP_REPO       GitHub mirror containing the pinned release
  BLORP_COMPILER_BOOTSTRAP_CACHE_DIR  Cache directory for the downloaded binary
EOF
}

target_triple() {
	local arch os
	arch=$(uname -m)
	os=$(uname -s)

	case "$os:$arch" in
		Darwin:arm64) echo "aarch64-apple-darwin" ;;
		Linux:x86_64) echo "x86_64-unknown-linux-gnu" ;;
		Linux:aarch64 | Linux:arm64) echo "aarch64-unknown-linux-gnu" ;;
		Darwin:x86_64)
			echo "Pinned compiler bootstrap ${tag} has no x86_64-apple-darwin asset." >&2
			exit 1
			;;
		*)
			echo "Unsupported compiler bootstrap target: $os/$arch" >&2
			exit 1
			;;
	esac
}

expected_archive_sha256() {
	case "$1" in
		aarch64-apple-darwin)
			echo "$BLORP_BOOTSTRAP_SHA256_AARCH64_APPLE_DARWIN"
			;;
		x86_64-unknown-linux-gnu)
			echo "$BLORP_BOOTSTRAP_SHA256_X86_64_UNKNOWN_LINUX_GNU"
			;;
		aarch64-unknown-linux-gnu)
			echo "$BLORP_BOOTSTRAP_SHA256_AARCH64_UNKNOWN_LINUX_GNU"
			;;
		*)
			echo "No pinned compiler bootstrap checksum for target $1" >&2
			exit 1
			;;
	esac
}

download_file() {
	local url="$1"
	local output="$2"

	if command -v curl >/dev/null 2>&1; then
		curl -fsSL "$url" -o "$output"
	elif command -v wget >/dev/null 2>&1; then
		wget -q "$url" -O "$output"
	else
		echo "Compiler bootstrap download requires curl or wget." >&2
		exit 1
	fi
}

sha256_file() {
	local path="$1"

	if command -v shasum >/dev/null 2>&1; then
		shasum -a 256 "$path" | awk '{print $1}'
	elif command -v sha256sum >/dev/null 2>&1; then
		sha256sum "$path" | awk '{print $1}'
	else
		echo "Compiler bootstrap verification requires shasum or sha256sum." >&2
		exit 1
	fi
}

cache_marker_matches() {
	local install_dir="$1"
	local marker="$2"
	local target="$3"
	local archive_sha="$4"
	local binary="$install_dir/blorp"
	local executable actual_sha

	if [ ! -x "$binary" ] || [ ! -f "$marker" ]; then
		return 1
	fi

	if ! grep -Fxq "repo=$repo" "$marker" ||
		! grep -Fxq "tag=$tag" "$marker" ||
		! grep -Fxq "version=$version" "$marker" ||
		! grep -Fxq "layout=$layout" "$marker" ||
		! grep -Fxq "target=$target" "$marker" ||
		! grep -Fxq "archive_sha256=$archive_sha" "$marker"
	then
		return 1
	fi

	if [ "$layout" = "single" ]; then
		actual_sha=$(sha256_file "$binary")
		grep -Fxq "binary_sha256=$actual_sha" "$marker"
		return
	fi

	for executable in $toolchain_executables; do
		if [ ! -x "$install_dir/$executable" ]; then
			return 1
		fi
		actual_sha=$(sha256_file "$install_dir/$executable")
		if ! grep -Fxq "file_sha256_${executable}=$actual_sha" "$marker"; then
			return 1
		fi
	done

	if grep -q "^file_sha256_${bootstrap_compiler_executable}=" "$marker"; then
		if [ ! -f "$install_dir/$bootstrap_layout_name" ] ||
			[ "$(cat "$install_dir/$bootstrap_layout_name")" != "$bootstrap_layout_version" ]
		then
			return 1
		fi
		for executable in $bootstrap_artifact_executables; do
			if [ ! -x "$install_dir/$executable" ]; then
				return 1
			fi
			actual_sha=$(sha256_file "$install_dir/$executable")
			if ! grep -Fxq "file_sha256_${executable}=$actual_sha" "$marker"; then
				return 1
			fi
		done
		actual_sha=$(sha256_file "$install_dir/$bootstrap_layout_name")
		if ! grep -Fxq "file_sha256_${bootstrap_layout_name}=$actual_sha" "$marker"; then
			return 1
		fi
	else
		for artifact in $bootstrap_artifact_files; do
			if [ -e "$install_dir/$artifact" ]; then
				return 1
			fi
		done
	fi
}

install_bootstrap() {
	local target="$1"
	local archive_sha="$2"
	local install_dir="$3"
	local binary="$4"
	local marker="$5"
	local asset archive checksum url expected_checksum actual_checksum
	local binary_path package_dir stage_dir executable actual_sha

	asset="blorp-${version}-${target}.tar.gz"
	url="https://github.com/${repo}/releases/download/${tag}/${asset}"

	stage_dir=$(mktemp -d "${TMPDIR:-/tmp}/blorp-compiler-bootstrap.XXXXXX")
	trap 'rm -rf "$stage_dir"; for artifact in $toolchain_executables $bootstrap_artifact_files; do rm -f "$install_dir/$artifact.tmp.$$"; done; rm -f "$marker.tmp.$$"' EXIT

	archive="$stage_dir/$asset"
	checksum="$archive.sha256"

	download_file "$url" "$archive"
	download_file "$url.sha256" "$checksum"

	expected_checksum=$(awk '{print $1}' "$checksum")
	if [ "$expected_checksum" != "$archive_sha" ]; then
		echo "Pinned compiler bootstrap checksum mismatch for $asset" >&2
		echo "expected pin: $archive_sha" >&2
		echo "release file:  $expected_checksum" >&2
		echo "Update compiler/bootstrap.env only if this pin change is intentional." >&2
		exit 1
	fi

	actual_checksum=$(sha256_file "$archive")
	if [ "$actual_checksum" != "$archive_sha" ]; then
		echo "Downloaded compiler bootstrap archive failed checksum verification." >&2
		echo "expected: $archive_sha" >&2
		echo "actual:   $actual_checksum" >&2
		exit 1
	fi

	tar -xzf "$archive" -C "$stage_dir"
	binary_path=$(find "$stage_dir" -type f -name blorp -print -quit)
	if [ -z "$binary_path" ]; then
		echo "Downloaded compiler bootstrap archive did not contain a blorp binary." >&2
		exit 1
	fi

	package_dir=$(dirname "$binary_path")
	if [ "$layout" = "toolchain" ]; then
		for executable in $toolchain_executables; do
			if [ ! -f "$package_dir/$executable" ]; then
				echo "Downloaded compiler bootstrap archive is missing $executable." >&2
				exit 1
			fi
		done
		if [ -f "$package_dir/$bootstrap_compiler_executable" ]; then
			if [ ! -f "$package_dir/$bootstrap_layout_name" ] ||
				[ "$(cat "$package_dir/$bootstrap_layout_name")" != "$bootstrap_layout_version" ]
			then
				echo "Downloaded compiler bootstrap archive contains an unsupported immutable bootstrap layout." >&2
				exit 1
			fi
			for executable in $bootstrap_companion_executables; do
				if [ ! -f "$package_dir/$executable" ]; then
					echo "Downloaded compiler bootstrap archive contains an incomplete immutable bootstrap bundle: missing $executable." >&2
					exit 1
				fi
			done
		fi
	fi

	mkdir -p "$install_dir"
	if [ "$layout" = "toolchain" ]; then
		for executable in $toolchain_executables; do
			cp "$package_dir/$executable" "$install_dir/$executable.tmp.$$"
			chmod 0755 "$install_dir/$executable.tmp.$$"
		done
		if [ -f "$package_dir/$bootstrap_compiler_executable" ]; then
			for executable in $bootstrap_artifact_executables; do
				cp "$package_dir/$executable" "$install_dir/$executable.tmp.$$"
				chmod 0755 "$install_dir/$executable.tmp.$$"
			done
			cp "$package_dir/$bootstrap_layout_name" \
				"$install_dir/$bootstrap_layout_name.tmp.$$"
			chmod 0644 "$install_dir/$bootstrap_layout_name.tmp.$$"
		fi
	else
		cp "$binary_path" "$binary.tmp.$$"
		chmod 0755 "$binary.tmp.$$"
	fi

	{
		echo "repo=$repo"
		echo "tag=$tag"
		echo "version=$version"
		echo "layout=$layout"
		echo "target=$target"
		echo "archive_sha256=$archive_sha"
		if [ "$layout" = "toolchain" ]; then
			for executable in $toolchain_executables; do
				actual_sha=$(sha256_file "$install_dir/$executable.tmp.$$")
				echo "file_sha256_${executable}=$actual_sha"
			done
			if [ -f "$install_dir/$bootstrap_compiler_executable.tmp.$$" ]; then
				for executable in $bootstrap_artifact_executables; do
					actual_sha=$(sha256_file "$install_dir/$executable.tmp.$$")
					echo "file_sha256_${executable}=$actual_sha"
				done
				actual_sha=$(sha256_file "$install_dir/$bootstrap_layout_name.tmp.$$")
				echo "file_sha256_${bootstrap_layout_name}=$actual_sha"
			fi
		else
			actual_sha=$(sha256_file "$binary.tmp.$$")
			echo "binary_sha256=$actual_sha"
		fi
	} > "$marker.tmp.$$"

	if [ "$layout" = "toolchain" ]; then
		for executable in $toolchain_executables; do
			if [ "$executable" != "blorp" ]; then
				mv "$install_dir/$executable.tmp.$$" "$install_dir/$executable"
			fi
		done
		if [ -f "$install_dir/$bootstrap_compiler_executable.tmp.$$" ]; then
			for executable in $bootstrap_companion_executables; do
				mv "$install_dir/$executable.tmp.$$" "$install_dir/$executable"
			done
			mv "$install_dir/$bootstrap_layout_name.tmp.$$" \
				"$install_dir/$bootstrap_layout_name"
			mv "$install_dir/$bootstrap_compiler_executable.tmp.$$" \
				"$install_dir/$bootstrap_compiler_executable"
		else
			for artifact in $bootstrap_artifact_files; do
				rm -f "$install_dir/$artifact"
			done
		fi
		mv "$install_dir/blorp.tmp.$$" "$binary"
	else
		mv "$binary.tmp.$$" "$binary"
	fi
	mv "$marker.tmp.$$" "$marker"
	rm -rf "$stage_dir"
	trap - EXIT
}

resolve_bootstrap_path() {
	local target archive_sha key install_dir binary marker

	target=$(target_triple)
	archive_sha=$(expected_archive_sha256 "$target")
	key="${tag}/${layout}/${target}/${archive_sha}"
	install_dir="$cache_root/$key"
	binary="$install_dir/blorp"
	marker="$install_dir/MANIFEST"

	if ! cache_marker_matches "$install_dir" "$marker" "$target" "$archive_sha"
	then
		install_bootstrap "$target" "$archive_sha" "$install_dir" "$binary" "$marker"
	fi

	printf '%s\n' "$binary"
}

resolve_bootstrap_toolchain_dir() {
	local bootstrap_path

	if [ "$layout" != "toolchain" ]; then
		echo "Pinned compiler bootstrap $tag does not provide a complete compiler toolchain." >&2
		exit 1
	fi

	bootstrap_path=$(resolve_bootstrap_path)
	dirname "$bootstrap_path"
}

resolve_bootstrap_compiler_path() {
	local toolchain_dir dedicated legacy

	toolchain_dir=$(resolve_bootstrap_toolchain_dir)
	dedicated="$toolchain_dir/$bootstrap_compiler_executable"
	legacy="$toolchain_dir/blorp-ocaml-host"

	if [ -x "$dedicated" ]; then
		printf '%s\n' "$dedicated"
	elif [ -x "$legacy" ]; then
		# Transition support for immutable toolchains published before the
		# bootstrap compiler received its own artifact name.
		printf '%s\n' "$legacy"
	else
		echo "Pinned compiler bootstrap does not contain an immutable bootstrap compiler." >&2
		exit 1
	fi
}

case "${1:-}" in
	--print-tag)
		printf '%s\n' "$tag"
		exit 0
		;;
	--print-id)
		printf '%s %s\n' "$tag" "$version"
		exit 0
		;;
	--print-path)
		resolve_bootstrap_path
		exit 0
		;;
	--print-toolchain-dir)
		resolve_bootstrap_toolchain_dir
		exit 0
		;;
	--print-compiler-path)
		resolve_bootstrap_compiler_path
		exit 0
		;;
	-h | --help)
		usage
		exit 0
		;;
esac

bootstrap_path=$(resolve_bootstrap_path)
cd "$repo_root"

# Compatibility for pinned external bootstraps that still read
# BLORP_FRONTEND_PARSER. Current compiler sessions do not use this variable for
# normal source parsing, but older bootstrap binaries must stay on their built-in
# OCaml parser while compiling bridge helpers in renderer-helper mode.
if [ "${BLORP_COMPILER_RENDERER_HELPER:-}" = "1" ] && [ -z "${BLORP_FRONTEND_PARSER:-}" ]; then
	export BLORP_FRONTEND_PARSER=ocaml
fi

exec "$bootstrap_path" "$@"
