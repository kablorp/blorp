#!/bin/bash
set -euo pipefail

repo="${BLORP_INSTALL_REPO:-kablorp/blorp}"
tag="${BLORP_INSTALL_TAG:-dev}"
install_dir="${BLORP_INSTALL_DIR:-$HOME/.local/bin}"
print_url=0

usage() {
    cat <<'EOF'
Usage: scripts/install-dev [options]

Download and install the Blorp dev compiler toolchain for this platform.

Options:
  --install-dir DIR  Install blorp into DIR (default: $HOME/.local/bin)
  --print-url        Print the resolved download URL without installing
  -h, --help         Show this help

Environment:
  BLORP_INSTALL_REPO  GitHub repo to download from (default: kablorp/blorp)
  BLORP_INSTALL_TAG   Release tag to download from (default: dev; e.g. dev-<short-sha>)
  BLORP_INSTALL_DIR   Install directory (default: $HOME/.local/bin)
EOF
}

while [ $# -gt 0 ]; do
    case "$1" in
        --install-dir)
            if [ $# -lt 2 ]; then
                echo "Missing value for --install-dir" >&2
                exit 1
            fi
            install_dir="$2"
            shift 2
            ;;
        --print-url)
            print_url=1
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "Unknown option: $1" >&2
            usage >&2
            exit 1
            ;;
    esac
done

target_triple() {
    local arch os
    arch=$(uname -m)
    os=$(uname -s)

    case "$os:$arch" in
        Darwin:arm64) echo "aarch64-apple-darwin" ;;
        Darwin:x86_64) echo "x86_64-apple-darwin" ;;
        Linux:x86_64) echo "x86_64-unknown-linux-gnu" ;;
        Linux:aarch64|Linux:arm64) echo "aarch64-unknown-linux-gnu" ;;
        *)
            echo "Unsupported release target: $os/$arch" >&2
            exit 1
            ;;
    esac
}

download_file() {
    local url="$1"
    local output="$2"

    if command -v curl >/dev/null 2>&1; then
        curl -fsSL "$url" -o "$output"
    elif command -v wget >/dev/null 2>&1; then
        wget -q "$url" -O "$output"
    else
        echo "Install requires curl or wget." >&2
        exit 1
    fi
}

sha256_file() {
    local path="$1"

    if command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$path" | awk '{print $1}'
    elif command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$path" | awk '{print $1}'
    else
        echo "Install requires shasum or sha256sum." >&2
        exit 1
    fi
}

sha256_stdin() {
    if command -v shasum >/dev/null 2>&1; then
        shasum -a 256 | awk '{print $1}'
    elif command -v sha256sum >/dev/null 2>&1; then
        sha256sum | awk '{print $1}'
    else
        echo "Install requires shasum or sha256sum." >&2
        exit 1
    fi
}

target="$(target_triple)"
asset="blorp-dev-${target}.tar.gz"
url="https://github.com/${repo}/releases/download/${tag}/${asset}"

if [ "$print_url" -eq 1 ]; then
    echo "$url"
    exit 0
fi

tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/blorp-install-dev.XXXXXX")
install_stage=""
cleanup() {
    rm -rf "$tmp_dir"
    if [ -n "$install_stage" ]; then
        rm -rf "$install_stage"
    fi
}
trap cleanup EXIT

archive="$tmp_dir/$asset"
checksum="$archive.sha256"

echo "Target: $target"
echo "Download: $url"
echo "Install path: $install_dir/blorp"

download_file "$url" "$archive"
download_file "$url.sha256" "$checksum"

expected_checksum=$(awk '{print $1}' "$checksum")
actual_checksum=$(sha256_file "$archive")

if [ "$expected_checksum" != "$actual_checksum" ]; then
    echo "Checksum mismatch for $asset" >&2
    echo "expected: $expected_checksum" >&2
    echo "actual:   $actual_checksum" >&2
    exit 1
fi

tar -xzf "$archive" -C "$tmp_dir"
binary_path=$(find "$tmp_dir" -type f -name blorp -print -quit)

if [ -z "$binary_path" ]; then
    echo "Downloaded archive did not contain a blorp binary." >&2
    exit 1
fi

package_dir=$(dirname "$binary_path")
bootstrap_compiler_path="$package_dir/blorp-bootstrap-compiler"
bootstrap_layout_name="blorp-bootstrap-layout"
bootstrap_layout_version="isolated-v1"
bootstrap_layout_path="$package_dir/$bootstrap_layout_name"
bootstrap_bundle_names=(
    blorp-bootstrap-compiler
    blorp-bootstrap-host
    blorp-bootstrap-renderer
    blorp-bootstrap-parser
    blorp-bootstrap-typecheck
)
ocaml_host_path="$package_dir/blorp-ocaml-host"
ocaml_middle_path="$package_dir/blorp-ocaml-middle"
renderer_bridge_path="$package_dir/blorp-compiler-renderer"
parser_bridge_path="$package_dir/blorp-compiler-parser"
typecheck_bridge_path="$package_dir/blorp-compiler-typecheck"
has_dedicated_bootstrap=1
if [ ! -f "$bootstrap_compiler_path" ] && [ -f "$ocaml_host_path" ]; then
    # Immutable releases published before the dedicated artifact name carried
    # the same bootstrap command in their OCaml host.
    bootstrap_compiler_path="$ocaml_host_path"
    has_dedicated_bootstrap=0
fi
if [ ! -f "$bootstrap_compiler_path" ] ||
    [ ! -f "$ocaml_host_path" ] ||
    [ ! -f "$ocaml_middle_path" ] ||
    [ ! -f "$renderer_bridge_path" ] ||
    [ ! -f "$parser_bridge_path" ] ||
    [ ! -f "$typecheck_bridge_path" ]
then
    echo "Downloaded archive did not contain the complete Blorp compiler toolchain." >&2
    echo "Expected the public compiler, immutable bootstrap compiler, OCaml workers, and prepared bridge helpers in one directory." >&2
    exit 1
fi
if [ "$has_dedicated_bootstrap" -eq 1 ]; then
    if [ ! -f "$bootstrap_layout_path" ] ||
        [ "$(cat "$bootstrap_layout_path")" != "$bootstrap_layout_version" ]
    then
        echo "Downloaded archive contains an unsupported immutable bootstrap layout." >&2
        echo "A dedicated compiler without matching generation metadata is unsafe to install." >&2
        exit 1
    fi
    for bootstrap_file in "${bootstrap_bundle_names[@]}"; do
        if [ ! -f "$package_dir/$bootstrap_file" ]; then
            echo "Downloaded archive contains an incomplete immutable bootstrap bundle." >&2
            echo "Missing: $package_dir/$bootstrap_file" >&2
            exit 1
        fi
    done
fi

mkdir -p "$install_dir"
install_stage=$(mktemp -d "$install_dir/.blorp-install.XXXXXX")
bootstrap_stage="$install_stage/bootstrap-generation"
mkdir -p "$bootstrap_stage"
cp "$binary_path" "$install_stage/blorp"
if [ "$has_dedicated_bootstrap" -eq 1 ]; then
    for bootstrap_file in "${bootstrap_bundle_names[@]}"; do
        cp "$package_dir/$bootstrap_file" "$bootstrap_stage/$bootstrap_file"
    done
    cp "$bootstrap_layout_path" "$bootstrap_stage/$bootstrap_layout_name"
else
    cat >"$bootstrap_stage/blorp-bootstrap-compiler" <<'SH'
#!/bin/sh
set -eu

toolchain_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
export BLORP_COMPILER_RENDERER_BRIDGE_BIN="$toolchain_dir/blorp-bootstrap-renderer"
export BLORP_COMPILER_PARSER_BRIDGE_BIN="$toolchain_dir/blorp-bootstrap-parser"
export BLORP_COMPILER_TYPECHECK_BRIDGE_BIN="$toolchain_dir/blorp-bootstrap-typecheck"
export BLORP_COMPILER_REQUIRE_PREPARED_BRIDGE=1
exec "$toolchain_dir/blorp-bootstrap-host" "$@"
SH
    cp "$bootstrap_compiler_path" "$bootstrap_stage/blorp-bootstrap-host"
    cp "$renderer_bridge_path" "$bootstrap_stage/blorp-bootstrap-renderer"
    cp "$parser_bridge_path" "$bootstrap_stage/blorp-bootstrap-parser"
    cp "$typecheck_bridge_path" "$bootstrap_stage/blorp-bootstrap-typecheck"
    printf '%s\n' "$bootstrap_layout_version" \
        >"$bootstrap_stage/$bootstrap_layout_name"
fi
cat >"$install_stage/blorp-bootstrap-compiler" <<'SH'
#!/bin/sh
set -eu

install_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
bootstrap_generation=$(cat "$install_dir/.blorp-bootstrap/active")
exec "$install_dir/.blorp-bootstrap/$bootstrap_generation/blorp-bootstrap-compiler" "$@"
SH
cp "$ocaml_host_path" "$install_stage/blorp-ocaml-host"
cp "$ocaml_middle_path" "$install_stage/blorp-ocaml-middle"
cp "$renderer_bridge_path" "$install_stage/blorp-compiler-renderer"
cp "$parser_bridge_path" "$install_stage/blorp-compiler-parser"
cp "$typecheck_bridge_path" "$install_stage/blorp-compiler-typecheck"
chmod 0755 \
    "$install_stage/blorp" \
    "$install_stage/blorp-bootstrap-compiler" \
    "$install_stage/blorp-ocaml-host" \
    "$install_stage/blorp-ocaml-middle" \
    "$install_stage/blorp-compiler-renderer" \
    "$install_stage/blorp-compiler-parser" \
    "$install_stage/blorp-compiler-typecheck"
chmod 0755 \
    "$bootstrap_stage/blorp-bootstrap-compiler" \
    "$bootstrap_stage/blorp-bootstrap-host" \
    "$bootstrap_stage/blorp-bootstrap-renderer" \
    "$bootstrap_stage/blorp-bootstrap-parser" \
    "$bootstrap_stage/blorp-bootstrap-typecheck"
chmod 0644 "$bootstrap_stage/$bootstrap_layout_name"

bootstrap_generation=$(
    {
        for bootstrap_file in \
            "$bootstrap_layout_name" \
            "${bootstrap_bundle_names[@]}"
        do
            printf '%s ' "$bootstrap_file"
            sha256_file "$bootstrap_stage/$bootstrap_file"
        done
    } | sha256_stdin
)
bootstrap_store="$install_dir/.blorp-bootstrap"
bootstrap_generation_dir="$bootstrap_store/$bootstrap_generation"
mkdir -p "$bootstrap_store"
if [ -d "$bootstrap_generation_dir" ]; then
    for bootstrap_file in \
        "$bootstrap_layout_name" \
        "${bootstrap_bundle_names[@]}"
    do
        if ! cmp "$bootstrap_stage/$bootstrap_file" \
            "$bootstrap_generation_dir/$bootstrap_file"
        then
            echo "Installed bootstrap generation failed content verification: $bootstrap_generation" >&2
            exit 1
        fi
    done
    rm -rf "$bootstrap_stage"
else
    mv "$bootstrap_stage" "$bootstrap_generation_dir"
fi

# A compiler invocation reads this pointer once through its launcher. Replacing
# the regular file with rename is the only activation step, so interruption
# cannot expose a mixed bundle.
active_link="$bootstrap_store/active"
active_link_next="$bootstrap_store/.active.$$"
rm -f "$active_link_next"
printf '%s\n' "$bootstrap_generation" >"$active_link_next"
mv -f "$active_link_next" "$active_link"

mv "$install_stage/blorp-bootstrap-compiler" "$install_dir/blorp-bootstrap-compiler"
mv "$install_stage/blorp-ocaml-host" "$install_dir/blorp-ocaml-host"
mv "$install_stage/blorp-ocaml-middle" "$install_dir/blorp-ocaml-middle"
mv "$install_stage/blorp-compiler-renderer" "$install_dir/blorp-compiler-renderer"
mv "$install_stage/blorp-compiler-parser" "$install_dir/blorp-compiler-parser"
mv "$install_stage/blorp-compiler-typecheck" "$install_dir/blorp-compiler-typecheck"
mv "$install_stage/blorp" "$install_dir/blorp"
rmdir "$install_stage"
install_stage=""

echo "Installed blorp dev compiler toolchain to $install_dir"
echo "Public command: $install_dir/blorp"
echo "Remove blorp, blorp-* private executables, and $install_dir/.blorp-bootstrap to uninstall."

case ":$PATH:" in
    *":$install_dir:"*) ;;
    *) echo "Note: $install_dir is not on PATH." ;;
esac
