#!/bin/bash
set -euo pipefail

repo="${BLORP_INSTALL_REPO:-kablorp/blorp}"
tag="${BLORP_INSTALL_TAG:-dev}"
install_dir="${BLORP_INSTALL_DIR:-$HOME/.local/bin}"
print_url=0

usage() {
    cat <<'EOF'
Usage: scripts/install-dev [options]

Download and install the Blorp dev compiler toolchain for this platform.

Options:
  --install-dir DIR  Install blorp into DIR (default: $HOME/.local/bin)
  --print-url        Print the resolved download URL without installing
  -h, --help         Show this help

Environment:
  BLORP_INSTALL_REPO  GitHub repo to download from (default: kablorp/blorp)
  BLORP_INSTALL_TAG   Release tag to download from (default: dev; e.g. dev-<short-sha>)
  BLORP_INSTALL_DIR   Install directory (default: $HOME/.local/bin)
EOF
}

while [ $# -gt 0 ]; do
    case "$1" in
        --install-dir)
            if [ $# -lt 2 ]; then
                echo "Missing value for --install-dir" >&2
                exit 1
            fi
            install_dir="$2"
            shift 2
            ;;
        --print-url)
            print_url=1
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "Unknown option: $1" >&2
            usage >&2
            exit 1
            ;;
    esac
done

target_triple() {
    local arch os
    arch=$(uname -m)
    os=$(uname -s)

    case "$os:$arch" in
        Darwin:arm64) echo "aarch64-apple-darwin" ;;
        Darwin:x86_64) echo "x86_64-apple-darwin" ;;
        Linux:x86_64) echo "x86_64-unknown-linux-gnu" ;;
        Linux:aarch64|Linux:arm64) echo "aarch64-unknown-linux-gnu" ;;
        *)
            echo "Unsupported release target: $os/$arch" >&2
            exit 1
            ;;
    esac
}

download_file() {
    local url="$1"
    local output="$2"

    if command -v curl >/dev/null 2>&1; then
        curl -fsSL "$url" -o "$output"
    elif command -v wget >/dev/null 2>&1; then
        wget -q "$url" -O "$output"
    else
        echo "Install requires curl or wget." >&2
        exit 1
    fi
}

sha256_file() {
    local path="$1"

    if command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$path" | awk '{print $1}'
    elif command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$path" | awk '{print $1}'
    else
        echo "Install requires shasum or sha256sum for legacy releases." >&2
        exit 1
    fi
}

validate_binary() {
    local binary="$1"
    local expected_target="$2"
    local release_tag="$3"
    local output revision version

    if ! output=$("$binary" --version); then
        echo "Downloaded file is not a working Blorp compiler." >&2
        return 1
    fi
    if ! grep -Fxq "target: $expected_target" <<<"$output"; then
        echo "Downloaded compiler does not target $expected_target." >&2
        return 1
    fi

    case "$release_tag" in
        dev)
            if ! grep -Fxq 'channel: dev' <<<"$output"; then
                echo "Downloaded compiler is not a dev build." >&2
                return 1
            fi
            ;;
        dev-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f])
            revision=${release_tag#dev-}
            if ! grep -Eq "^commit: ${revision}[0-9a-f]*$" <<<"$output"; then
                echo "Downloaded compiler does not match $release_tag." >&2
                return 1
            fi
            ;;
        v*)
            version=${release_tag#v}
            if ! grep -Fxq "blorp $version" <<<"$output"; then
                echo "Downloaded compiler does not match $release_tag." >&2
                return 1
            fi
            ;;
    esac
}

target="$(target_triple)"
asset="blorp-${target}"
url="https://github.com/${repo}/releases/download/${tag}/${asset}"

if [ "$print_url" -eq 1 ]; then
    echo "$url"
    exit 0
fi

tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/blorp-install-dev.XXXXXX")
install_stage=""
cleanup() {
    rm -rf "$tmp_dir"
    if [ -n "$install_stage" ]; then
        rm -rf "$install_stage"
    fi
}
trap cleanup EXIT

binary_path="$tmp_dir/$asset"
direct_download_error="$tmp_dir/direct-download.error"

echo "Target: $target"
echo "Download: $url"
echo "Install path: $install_dir/blorp"

if ! download_file "$url" "$binary_path" 2>"$direct_download_error"; then
    # The moving dev release may still use the previous format while the first
    # direct-binary workflow is qualifying. Remove this branch after rollout.
    legacy_asset="blorp-dev-${target}.tar.gz"
    legacy_url="https://github.com/${repo}/releases/download/${tag}/${legacy_asset}"
    legacy_archive="$tmp_dir/$legacy_asset"
    legacy_checksum="$legacy_archive.sha256"
    if ! download_file "$legacy_url" "$legacy_archive" ||
        ! download_file "$legacy_url.sha256" "$legacy_checksum"
    then
        echo "Direct binary download also failed:" >&2
        cat "$direct_download_error" >&2
        echo "Legacy release download failed: $legacy_url" >&2
        exit 1
    fi
    expected_checksum=$(awk 'NF { print $1; exit }' "$legacy_checksum")
    actual_checksum=$(sha256_file "$legacy_archive")
    if [ "$actual_checksum" != "$expected_checksum" ]; then
        echo "Checksum mismatch for $legacy_asset" >&2
        exit 1
    fi
    tar -xzf "$legacy_archive" -C "$tmp_dir"
    binary_path=$(find "$tmp_dir" -type f -name blorp -print -quit)
    if [ -z "$binary_path" ]; then
        echo "Downloaded legacy release did not contain blorp." >&2
        exit 1
    fi
fi

mkdir -p "$install_dir"
install_stage=$(mktemp -d "$install_dir/.blorp-install.XXXXXX")
cp "$binary_path" "$install_stage/blorp"
chmod 0755 "$install_stage/blorp"
validate_binary "$install_stage/blorp" "$target" "$tag"

mv "$install_stage/blorp" "$install_dir/blorp"
rmdir "$install_stage"
install_stage=""

# Releases before direct public-compiler bootstrapping installed a launcher and
# a private immutable helper store. They are owned by this installer and are no
# longer read by either builds or the public toolchain.
rm -f "$install_dir/blorp-bootstrap-compiler"
rm -rf "$install_dir/.blorp-bootstrap"

echo "Installed blorp dev compiler to $install_dir"
echo "Public command: $install_dir/blorp"
echo "Remove blorp to uninstall."

case ":$PATH:" in
    *":$install_dir:"*) ;;
    *) echo "Note: $install_dir is not on PATH." ;;
esac
