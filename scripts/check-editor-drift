#!/usr/bin/env bash
# Guard editor metadata that is intentionally duplicated across extensions.

set -euo pipefail

cd "$(dirname "$0")/.."

fail() {
    echo "$1" >&2
    exit 1
}

check_json() {
    local path="$1"
    python3 -m json.tool "$path" >/dev/null || fail "Invalid JSON: $path"
}

check_same() {
    local canonical="$1"
    local duplicate="$2"
    local label="$3"

    if ! cmp -s "$canonical" "$duplicate"; then
        echo "Editor metadata drift: $label differs." >&2
        echo "Canonical: $canonical" >&2
        echo "Duplicate: $duplicate" >&2
        echo "Keep VSCode and IntelliJ TextMate metadata in sync." >&2
        exit 1
    fi
}

vscode_config="editor/vscode/language-configuration.json"
intellij_config="editor/intellij/src/main/resources/textmate/blorp/language-configuration.json"
vscode_grammar="editor/vscode/syntaxes/blorp.tmLanguage.json"
intellij_grammar="editor/intellij/src/main/resources/textmate/blorp/syntaxes/blorp.tmLanguage.json"

check_json "$vscode_config"
check_json "$intellij_config"
check_json "$vscode_grammar"
check_json "$intellij_grammar"

check_same "$vscode_config" "$intellij_config" "language configuration"
check_same "$vscode_grammar" "$intellij_grammar" "TextMate grammar"
