#!/usr/bin/env bash
# Guard editor metadata that is intentionally duplicated across extensions.

set -euo pipefail

cd "$(dirname "$0")/.."

fail() {
    echo "$1" >&2
    exit 1
}

check_json() {
    local path="$1"
    python3 -m json.tool "$path" >/dev/null || fail "Invalid JSON: $path"
}

check_same() {
    local canonical="$1"
    local duplicate="$2"
    local label="$3"

    if ! cmp -s "$canonical" "$duplicate"; then
        echo "Editor metadata drift: $label differs." >&2
        echo "Canonical: $canonical" >&2
        echo "Duplicate: $duplicate" >&2
        echo "Keep VSCode and IntelliJ TextMate metadata in sync." >&2
        exit 1
    fi
}

check_contains() {
    local path="$1"
    local needle="$2"
    local label="$3"

    if ! grep -Fq "$needle" "$path"; then
        echo "Editor metadata missing: $label" >&2
        echo "File: $path" >&2
        echo "Expected to find: $needle" >&2
        exit 1
    fi
}

vscode_config="editor/vscode/language-configuration.json"
intellij_config="editor/intellij/src/main/resources/textmate/blorp/language-configuration.json"
vscode_grammar="editor/vscode/syntaxes/blorp.tmLanguage.json"
intellij_grammar="editor/intellij/src/main/resources/textmate/blorp/syntaxes/blorp.tmLanguage.json"
intellij_plugin="editor/intellij/src/main/resources/META-INF/plugin.xml"
intellij_lsp="editor/intellij/src/main/resources/META-INF/lsp.xml"
intellij_editor_highlighter_provider="editor/intellij/src/main/kotlin/com/blorp/intellij/BlorpEditorHighlighterProvider.kt"

check_json "$vscode_config"
check_json "$intellij_config"
check_json "$vscode_grammar"
check_json "$intellij_grammar"

check_same "$vscode_config" "$intellij_config" "language configuration"
check_same "$vscode_grammar" "$intellij_grammar" "TextMate grammar"

check_contains "$intellij_plugin" "com.blorp.intellij.BlorpFileType" "IntelliJ Blorp file type"
check_contains "$intellij_plugin" "com.blorp.intellij.BlorpParserDefinition" "IntelliJ Blorp parser definition"
check_contains "$intellij_plugin" "com.blorp.intellij.BlorpSyntaxHighlighterFactory" "IntelliJ Blorp syntax highlighter"
check_contains "$intellij_plugin" "com.blorp.intellij.BlorpEditorHighlighterProvider" "IntelliJ editor highlighter provider"
check_contains "$intellij_plugin" "com.blorp.intellij.BlorpTextMateBundleProvider" "IntelliJ TextMate bundle provider"
check_contains "$intellij_plugin" "config-file=\"lsp.xml\"" "IntelliJ optional LSP config file"
check_contains "$intellij_lsp" "com.blorp.intellij.BlorpLspServerSupportProvider" "IntelliJ LSP support provider"
check_contains "$intellij_lsp" "com.blorp.intellij.BlorpGotoDeclarationHandler" "IntelliJ goto declaration handler"
check_contains "$intellij_editor_highlighter_provider" "TextMateEditorHighlighterProvider" "IntelliJ TextMate editor highlighter wrapper"
