#!/usr/bin/env python3
"""Check std function builtin bodies use explicit, stable identities."""

from __future__ import annotations

import pathlib
import re
import sys


ROOT = pathlib.Path(__file__).resolve().parents[1]
FUNC_RE = re.compile(
    r"^\s*(?:private\s+)?(?:pure\s+)?func\s+([A-Za-z_][A-Za-z0-9_]*)\b"
)
BUILTIN_BODY_RE = re.compile(r'^\s*builtin\s*(?:\(\s*"([^"]+)"\s*\))?\s*$')


def check_file(path: pathlib.Path) -> list[str]:
    errors: list[str] = []
    current_func: str | None = None
    module_path = path.relative_to(ROOT).with_suffix("").as_posix()

    for line_number, line in enumerate(path.read_text().splitlines(), start=1):
        if match := FUNC_RE.match(line):
            current_func = match.group(1)

        match = BUILTIN_BODY_RE.match(line)
        if not match:
            continue

        builtin_name = match.group(1)
        if builtin_name is None:
            errors.append(
                f"{path.relative_to(ROOT)}:{line_number}: "
                "std function builtin bodies must use builtin(\"name\")"
            )
            continue

        if not builtin_name.startswith("std/"):
            continue

        expected = (
            f"{module_path}.{current_func}" if current_func is not None else None
        )
        if builtin_name != expected:
            expected_text = expected if expected is not None else "<inside function>"
            errors.append(
                f"{path.relative_to(ROOT)}:{line_number}: "
                f"expected builtin(\"{expected_text}\"), "
                f"got builtin(\"{builtin_name}\")"
            )

    return errors


def main() -> int:
    std_dir = ROOT / "std"
    errors: list[str] = []

    for path in sorted(std_dir.rglob("*.brp")):
        errors.extend(check_file(path))

    if errors:
        print("std builtin identity check failed:", file=sys.stderr)
        for error in errors:
            print(error, file=sys.stderr)
        return 1

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
