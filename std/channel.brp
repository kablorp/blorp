import:
	units: Duration, to_timeout_milliseconds


-- Channel - Bounded multi-producer, multi-consumer channels.
--
-- Channels are the primary synchronization primitive for [concurrent:]
-- blocks, [detach]ed tasks, and fiber-to-fiber message passing. Sends and
-- receives are fiber-aware: blocking operations park the fiber without
-- occupying an OS thread.
--
-- Provided by the compiler runtime.
type Channel[T] = builtin


-- Error returned by concurrent work when a timeout fires, a task fails, or
-- cancellation interrupts a blocking operation. Auto-imported for
-- [concurrent:] scope.
union ConcurrencyError:
	Timeout
	TaskFailed(String)
	Cancelled


-- Public name for the result produced by a fixed [concurrent:] task.
-- This is an alias, so existing Ok/Err matching works directly while the type
-- still makes the task boundary visible in annotations and documentation.
type alias TaskResult[T] = Result[T, ConcurrencyError]


-- Outcome returned by typed channel send-attempt helpers.
union SendAttempt:
	SendAccepted
	SendWouldBlock
	SendSealed
	SendTimedOut


-- Outcome returned by typed channel receive-attempt helpers. RecvWouldBlock
-- means no value is currently buffered, RecvSealed means the channel is sealed
-- and drained, and RecvTimedOut means a timed receive reached its timeout
-- before observing a value or seal.
union RecvAttempt[T]:
	RecvValue(T)
	RecvWouldBlock
	RecvSealed
	RecvTimedOut


-- Error returned by typed channel send helpers when a channel has been sealed.
union ChannelSealed:
	Sealed


-- ============================================================================
-- Channel construction
-- ============================================================================
---
Create a bounded channel with the given capacity.
Sending when full blocks until a slot is free; receiving when empty blocks
until a value arrives or the channel is sealed. Capacities less than 1 are
clamped to 1 so channel construction is infallible.
---
func channel[T](capacity: Int) -> Channel[T]:
	builtin


-- ============================================================================
-- Blocking send/recv
-- ============================================================================
---
Compatibility blocking send. Blocks if the channel is full. Returns False if
the channel is sealed.

Prefer wait_send when backpressure is intentional and the sealed case should
remain visible in the type. Prefer try_send_attempt when fullness is a normal
branch.
---
func send[T](ch: Channel[T], val: T) -> Bool:
	builtin


---
Send a value, blocking if the channel is full. Returns Ok(void) if the value
was accepted, or Err(Sealed) if the channel has been sealed.

Use this when backpressure is intentional and the sealed case should remain
visible in the type.

doctests:
    :: wait_send accepts a value
    ch: Channel[Int] = channel(1)
    match wait_send(ch, 7):
        Ok(_): recv(ch) == Some(7)
        Err(_): False

    :: wait_send reports a sealed channel
    ch: Channel[Int] = channel(1)
    seal(ch)
    match wait_send(ch, 7):
        Ok(_): False
        Err(Sealed): True
---
func wait_send[T](ch: Channel[T], val: T) -> Result[Void, ChannelSealed]:
	if send(ch, val):
		Ok(void)
	else:
		Err(Sealed)


---
Receive a value. Blocks if the channel is empty. Returns None once the
channel is sealed and drained.
---
func recv[T](ch: Channel[T]) -> Option[T]:
	builtin


---
Receive a value, blocking if the channel is empty. Returns Ok(value) when a
value is available, or Err(Sealed) once the channel is sealed and drained.

Use this when a consumer needs the sealed case in the type instead of an
Option sentinel.

doctests:
    :: wait_recv accepts a buffered value
    ch: Channel[Int] = channel(1)
    _ = send(ch, 7)
    match wait_recv(ch):
        Ok(v): v == 7
        Err(_): False

    :: wait_recv reports a sealed and drained channel
    ch: Channel[Int] = channel(1)
    seal(ch)
    match wait_recv(ch):
        Ok(_): False
        Err(Sealed): True
---
func wait_recv[T](ch: Channel[T]) -> Result[T, ChannelSealed]:
	match recv(ch):
		Some(value): Ok(value)
		None: Err(Sealed)


-- ============================================================================
-- Non-blocking variants
-- ============================================================================
---
Non-blocking send. Returns False immediately if the channel is full or
sealed.
---
func try_send[T](ch: Channel[T], val: T) -> Bool:
	builtin


---
Non-blocking send with a typed outcome. Returns SendAccepted when the value was
accepted, SendWouldBlock when the channel is full, or SendSealed when no more
sends are accepted.

doctests:
    :: try_send_attempt accepts when capacity is available
    ch: Channel[Int] = channel(1)
    match try_send_attempt(ch, 7):
        SendAccepted: recv(ch) == Some(7)
        _: False

    :: try_send_attempt reports a full channel
    ch: Channel[Int] = channel(1)
    _ = send(ch, 1)
    match try_send_attempt(ch, 2):
        SendWouldBlock: True
        _: False
---
func try_send_attempt[T](ch: Channel[T], val: T) -> SendAttempt:
	builtin("blorp_channel_try_send_attempt")


---
Non-blocking receive. Returns None immediately if the channel is empty
or sealed.
---
func try_recv[T](ch: Channel[T]) -> Option[T]:
	builtin


---
Non-blocking receive with a typed outcome. Returns RecvValue(value) when a
value was available, RecvWouldBlock when the channel is currently empty, or
RecvSealed when the channel is sealed and drained.

The channel may be sealed by another fiber immediately after RecvWouldBlock;
the result describes one coherent observation of the channel state, not a
static refinement of the channel handle.

doctests:
    :: try_recv_attempt accepts a buffered value
    ch: Channel[Int] = channel(1)
    _ = send(ch, 7)
    match try_recv_attempt(ch):
        RecvValue(v): v == 7
        _: False

    :: try_recv_attempt reports an empty channel
    ch: Channel[Int] = channel(1)
    match try_recv_attempt(ch):
        RecvWouldBlock: True
        _: False

    :: try_recv_attempt reports a sealed and drained channel
    ch: Channel[Int] = channel(1)
    seal(ch)
    match try_recv_attempt(ch):
        RecvSealed: True
        _: False
---
func try_recv_attempt[T](ch: Channel[T]) -> RecvAttempt[T]:
	builtin("blorp_channel_try_recv_attempt")


-- ============================================================================
-- Timeouts
-- ============================================================================
---
Receive with a timeout in milliseconds. Returns None on timeout or if
the channel is sealed. A timeout less than or equal to 0 does not wait, but
still receives a value already available in the channel.

This is a compatibility API: None intentionally does not distinguish timeout
from sealed-and-drained. Use wait_recv when a blocking receive needs the sealed
case in the type, or try_recv_attempt when a non-blocking receive needs a typed
outcome.

doctests:
    :: recv_timeout reports sealed and drained as None
    ch: Channel[Int] = channel(1)
    seal(ch)
    match recv_timeout(ch, 1):
        None: True
        Some(_): False
---
func recv_timeout[T](ch: Channel[T], ms: Int) -> Option[T]:
	builtin


---
Receive with a timeout in milliseconds and a typed outcome. Returns
RecvValue(value) when a value arrives, RecvTimedOut when the timeout expires,
or RecvSealed once the channel is sealed and drained. A timeout less than or
equal to 0 does not wait, but still receives a value already available in the
channel.

Unlike recv_timeout, this observes value, timeout, and sealed state in one
runtime-backed channel wait.

doctests:
    :: recv_timeout_attempt reports timeout
    ch: Channel[Int] = channel(1)
    match recv_timeout_attempt(ch, 1):
        RecvTimedOut: True
        _: False

    :: recv_timeout_attempt reports sealed and drained
    ch: Channel[Int] = channel(1)
    seal(ch)
    match recv_timeout_attempt(ch, 1):
        RecvSealed: True
        _: False
---
func recv_timeout_attempt[T](ch: Channel[T], ms: Int) -> RecvAttempt[T]:
	builtin("blorp_channel_recv_timeout_attempt")


---
Send with a timeout in milliseconds. Returns False on timeout, full
channel, or sealed channel. A timeout less than or equal to 0 does not wait,
but still sends if capacity is already available.
---
func send_timeout[T](ch: Channel[T], val: T, ms: Int) -> Bool:
	builtin


---
Receive with a typed Duration timeout and typed outcome. Returns
RecvValue(value) when a value arrives, RecvTimedOut when the timeout expires,
or RecvSealed once the channel is sealed and drained. A timeout less than or
equal to zero does not wait, but still receives a value already available in
the channel. Positive durations below one millisecond round up to one
millisecond.

doctests:
    :: Duration recv attempt reports timeout
    import:
        units: microseconds

    ch: Channel[Int] = channel(1)
    timeout: Duration = microseconds(1)
    match recv_timeout_attempt_for(ch, timeout):
        RecvTimedOut: True
        _: False
---
func recv_timeout_attempt_for[T](ch: Channel[T], timeout: Duration) -> RecvAttempt[T]:
	recv_timeout_attempt(ch, to_timeout_milliseconds(timeout))


---
Send with a timeout and a typed outcome. Returns SendAccepted when the value
was accepted, SendTimedOut when capacity did not become available in time, or
SendSealed when no more sends are accepted. A timeout less than or equal to 0
does not wait, but still sends if capacity is already available.

doctests:
    :: send_timeout_attempt accepts when capacity is available
    ch: Channel[Int] = channel(1)
    match send_timeout_attempt(ch, 7, 100):
        SendAccepted: recv(ch) == Some(7)
        _: False

    :: send_timeout_attempt reports a sealed channel
    ch: Channel[Int] = channel(1)
    seal(ch)
    match send_timeout_attempt(ch, 7, 100):
        SendSealed: True
        _: False
---
func send_timeout_attempt[T](ch: Channel[T], val: T, ms: Int) -> SendAttempt:
	builtin("blorp_channel_send_timeout_attempt")


---
Send with a typed Duration timeout and typed outcome. Returns SendAccepted
when the value was accepted, SendTimedOut when capacity did not become
available in time, or SendSealed when no more sends are accepted. A timeout
less than or equal to zero does not wait, but still sends if capacity is
already available. Positive durations below one millisecond round up to one
millisecond.

doctests:
    :: Duration send attempt reports timeout
    import:
        units: microseconds

    ch: Channel[Int] = channel(1)
    _ = send(ch, 1)
    timeout: Duration = microseconds(1)
    match send_timeout_attempt_for(ch, 2, timeout):
        SendTimedOut: True
        _: False
---
func send_timeout_attempt_for[T](ch: Channel[T], val: T, timeout: Duration) -> SendAttempt:
	send_timeout_attempt(ch, val, to_timeout_milliseconds(timeout))


-- ============================================================================
-- Lifecycle
-- ============================================================================
---
Seal the channel. Further sends fail; values already in flight are still
deliverable via recv/try_recv. Receivers get None once the channel is sealed
and drained. Idempotent.
---
func seal[T](ch: Channel[T]) -> Void:
	builtin("blorp_channel_seal")


-- ============================================================================
-- Scheduler primitives
-- ============================================================================
---
Sleep the current fiber for [ms] milliseconds. Fiber-aware: does not
block the underlying OS thread, so the scheduler can run other fibers.
---
func sleep(ms: Int) -> Void:
	builtin


---
Cooperatively yield the current fiber.

This gives the scheduler a chance to run other ready fibers without installing
a timer or blocking an OS thread. It is a scheduling hint for tests,
benchmarks, and explicit cooperative handoff points; it does not guarantee that
another fiber runs before the current fiber resumes.
---
func yield_now() -> Void:
	builtin


---
Sleep the current fiber for a typed Duration. Positive durations below one
millisecond round up to one millisecond so they remain real waits when
forwarded to the current millisecond runtime primitive.
---
func sleep_for(timeout: Duration) -> Void:
	sleep(to_timeout_milliseconds(timeout))


---
Return the number of worker threads available for [concurrent:] blocks.
Determined at runtime from the [BLORP_NUM_WORKERS] environment variable
or a platform default.
---
pure func max_threads() -> Int:
	builtin
