-- Result - Error handling type
--
-- Result[T, E] represents either success (Ok) or failure (Err).
-- Used for functions that can fail in predictable ways.
-- Union (sum type) definition
union Result[T, E]:
	Ok(T)
	Err(E)


---
Check if result is success.

doctests:
    :: Ok is ok
    ok: Result[Int, String] = Ok(42)
    is_ok(ok) == True

    :: Err is not ok
    err: Result[Int, String] = Err("fail")
    is_ok(err) == False
---
pure func is_ok[T, E](self: Result[T, E]) -> Bool:
	match self:
		Ok(_): True
		Err(_): False


---
Check if result is error.

doctests:
    :: Err is err
    err: Result[Int, String] = Err("fail")
    is_err(err) == True

    :: Ok is not err
    ok: Result[Int, String] = Ok(42)
    is_err(ok) == False
---
pure func is_err[T, E](self: Result[T, E]) -> Bool:
	match self:
		Ok(_): False
		Err(_): True


---
Get the value or return a default.
---
pure func get_or[T, E](self: Result[T, E], default: T) -> T:
	match self:
		Ok(val): val
		Err(_): default


func get_or_else[T, E](
	self: Result[T, E],
	default_fn: (E) -> T,
) -> T:
pure func get_or_else[T, E](
	self: Result[T, E],
	default_fn: pure (E) -> T,
) -> T:
	match self:
		Ok(val): val
		Err(e): default_fn(e)


---
Map a function over the success value.
---
func map[T, U, E](
	self: Result[T, E],
	f: (T) -> U,
) -> Result[U, E]:
pure func map[T, U, E](
	self: Result[T, E],
	f: pure (T) -> U,
) -> Result[U, E]:
	match self:
		Ok(val):
			r: Result[U, E] = Ok(f(val))
			r
		Err(e):
			r: Result[U, E] = Err(e)
			r


---
Map a function over the error value.
---
func map_err[T, E, F](
	self: Result[T, E],
	f: (E) -> F,
) -> Result[T, F]:
pure func map_err[T, E, F](
	self: Result[T, E],
	f: pure (E) -> F,
) -> Result[T, F]:
	match self:
		Ok(val):
			r: Result[T, F] = Ok(val)
			r
		Err(e): Err(f(e))


---
Chain operations that can fail.
Returns f(val) if Ok, propagates Err otherwise.
---
func and_then[T, U, E](
	self: Result[T, E],
	f: (T) -> Result[U, E],
) -> Result[U, E]:
pure func and_then[T, U, E](
	self: Result[T, E],
	f: pure (T) -> Result[U, E],
) -> Result[U, E]:
	match self:
		Ok(val): f(val)
		Err(e): Err(e)


---
Convert Option to Result, using given error if None.

doctests:
    :: Some converts to Ok
    match from_option(Some(42), "missing"):
        Ok(v): v == 42
        Err(_): False

    :: None converts to Err
    opt: Option[Int] = None

    match from_option(opt, "missing"):
        Ok(_): False
        Err(e): e == "missing"
---
pure func from_option[T, E](opt: Option[T], error: E) -> Result[T, E]:
	match opt:
		Some(val):
			r: Result[T, E] = Ok(val)
			r
		None: Err(error)


---
Convert Result to Option, discarding the error.

doctests:
    :: Ok converts to Some
    ok: Result[Int, String] = Ok(42)

    match to_option(ok):
        Some(v): v == 42
        None: False
---
pure func to_option[T, E](self: Result[T, E]) -> Option[T]:
	match self:
		Ok(val): Some(val)
		Err(_): None


---
Swap Ok and Err values.
Useful for working with the error side of a Result.

doctests:
    :: Swap Ok to Err
    ok: Result[Int, String] = Ok(42)

    match swap(ok):
        Ok(_): False
        Err(v): v == 42
---
pure func swap[T, E](self: Result[T, E]) -> Result[E, T]:
	match self:
		Ok(val):
			r: Result[E, T] = Err(val)
			r
		Err(e): Ok(e)


implements ToBool for Result[T, E]:
	pure func to_bool[T, E](self: Result[T, E]) -> Bool:
		match self:
			Ok(_): True
			Err(_): False


implements Stringable for Result[T:Stringable, E:Stringable]:
	pure func to_string[T, E](self: Result[T, E]) -> String:
		match self:
			Ok(v): "Ok(" + v.to_string() + ")"
			Err(e): "Err(" + e.to_string() + ")"


implements Equatable for Result[T:Equatable, E:Equatable]:
	pure func equals[T:Equatable, E:Equatable](a: Result[T, E], b: Result[T, E]) -> Bool:
		match a:
			Ok(x):
				match b:
					Ok(y): equals(x, y)
					Err(_): False
			Err(x):
				match b:
					Ok(_): False
					Err(y): equals(x, y)

	pure func not_equals[T:Equatable, E:Equatable](a: Result[T, E], b: Result[T, E]) -> Bool:
		match a:
			Ok(x):
				match b:
					Ok(y): not equals(x, y)
					Err(_): True
			Err(x):
				match b:
					Ok(_): True
					Err(y): not equals(x, y)
-- Get value or compute default lazily (pure version)
-- Get value or compute default lazily (impure version)
