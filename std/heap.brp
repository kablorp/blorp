-- Heap - Min-heap (priority queue) backed by a List
--
-- A min-heap where the smallest element is always at the top.
-- Backed by a list representing a complete binary tree (array-indexed).
-- Parent of index i is at (i-1)/2, children at 2i+1 and 2i+2.
-- All operations maintain the heap property: parent <= children.
--
-- Push and pop are O(log n). Peek and size are O(1).
record Heap[T] {
	data: List[T]
}


-- ============================================================================
-- Construction
-- ============================================================================
---
Create an empty min-heap.

doctests:
    :: New heap is empty
    h: Heap[Int] = heap()
    h.is_empty() == True
---
pure func heap[T]() -> Heap[T]:
	result: Heap[T] = {
		data = []
	}
	result


-- ============================================================================
-- Core Operations
-- ============================================================================
---
Push a value onto the heap. Returns a new heap with the value inserted. O(log n).

doctests:
    :: Push increases size
    h: Heap[Int] = heap().push(5)
    h.size() == 1
---
pure func push[T:Orderable](h: Heap[T], val: T) -> Heap[T]:
	new_data: List[T] = h.data.append(val)
	result: Heap[T] = {
		data = bubble_up(new_data, new_data.length() - 1)
	}
	result


---
Remove and return the minimum element from the heap. O(log n).
Returns Some((min, new_heap)) or None if empty.

doctests:
    :: Pop returns minimum
    var h: Heap[Int] = heap()
    h = h.push(3)
    h = h.push(1)
    h = h.push(2)
    match h.pop():
        Some(pair): pair[0] == 1
        None: False
---
pure func pop[T:Orderable](h: Heap[T]) -> Option[(T, Heap[T])]:
	sz: Int = h.data.length()
	if sz == 0:
		r: Option[(T, Heap[T])] = None
		r
	else if sz == 1:
		min_val ?= h.data.get(0)
		empty: Heap[T] = {
			data = []
		}
		Some((min_val, empty))
	else:
		match h.data.get(0):
			Some(min_val):
				match h.data.get(sz - 1):
					Some(last_val):
						trimmed: List[T] = h.data.take(sz - 1)
						match trimmed.set_index(0, last_val):
							Some(replaced):
								sifted: List[T] = sift_down(replaced, sz - 1, 0)
								new_heap: Heap[T] = {
									data = sifted
								}
								Some((min_val, new_heap))
							None:
								r: Option[(T, Heap[T])] = None
								r
					None:
						r: Option[(T, Heap[T])] = None
						r
			None:
				r: Option[(T, Heap[T])] = None
				r


---
Peek at the minimum element without removing it. O(1).

doctests:
    :: Peek on empty returns None
    h: Heap[Int] = heap()
    match h.peek():
        Some(_): False
        None: True
---
pure func peek[T:Orderable](h: Heap[T]) -> Option[T]:
	if h.data.length() == 0:
		None
	else:
		h.data.get(0)


---
Get the number of elements in the heap. O(1).
---
pure func size[T](h: Heap[T]) -> Int:
	h.data.length()


---
Check if the heap is empty. O(1).
---
pure func is_empty[T](h: Heap[T]) -> Bool:
	h.data.length() == 0


---
Create a heap from a list of values. O(n log n).

doctests:
    :: From list preserves min
    h: Heap[Int] = [5, 3, 1, 4, 2].from_list()
    match h.peek():
        Some(v): v == 1
        None: False
---
pure func from_list[T:Orderable](items: List[T]) -> Heap[T]:
	var h: Heap[T] = heap()
	for val in items:
		h = h.push(val)
	h


---
Convert a heap to a sorted list in ascending order (heap sort). O(n log n).
---
pure func to_sorted[T:Orderable](h: Heap[T]) -> List[T]:
	var result: List[T] = []
	var current: Heap[T] = h
	var done: Bool = False
	while not done:
		match current.pop():
			Some(pair):
				result = result.append(pair[0])
				current = pair[1]
			None:
				done = True
	result


-- ============================================================================
-- Internal Helpers
-- ============================================================================
-- Bubble up element at index to maintain heap property
private pure func bubble_up[T:Orderable](data: List[T], idx: Int) -> List[T]:
	if idx == 0:
		data
	else:
		parent_idx: Int = (idx - 1) / 2
		match data.get(idx):
			Some(child_val):
				match data.get(parent_idx):
					Some(parent_val):
						if child_val < parent_val:
							swapped: List[T] = list_swap(data, idx, parent_idx)
							bubble_up(swapped, parent_idx)
						else:
							data
					None: data
			None: data


-- Sift down element at index to maintain heap property
private pure func sift_down[T:Orderable](data: List[T], heap_size: Int, idx: Int) -> List[T]:
	left: Int = 2 * idx + 1
	right_idx: Int = 2 * idx + 2
	var smallest: Int = idx
	match data.get(idx):
		None:
			data
		Some(current_val):
			var smallest_val: T = current_val
			if left < heap_size:
				match data.get(left):
					Some(left_val):
						if left_val < smallest_val:
							smallest = left
							smallest_val = left_val
					None: void
			if right_idx < heap_size:
				match data.get(right_idx):
					Some(right_val):
						if right_val < smallest_val:
							smallest = right_idx
							smallest_val = right_val
					None: void
			if smallest != idx:
				swapped: List[T] = list_swap(data, idx, smallest)
				sift_down(swapped, heap_size, smallest)
			else:
				data


-- Swap two elements in a list using the builtin set_index (COW-safe)
private pure func list_swap[T](data: List[T], i: Int, j: Int) -> List[T]:
	match data.get(i):
		Some(val_i):
			match data.get(j):
				Some(val_j):
					match data.set_index(i, val_j):
						Some(step1):
							match step1.set_index(j, val_i):
								Some(result): result
								None: data
						None: data
				None: data
		None: data
