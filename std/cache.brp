import:
	int: INT_MAX


-- Cache - LRU (Least Recently Used) cache with fixed capacity.
--
-- Pure, immutable cache backed by a Dict with logical timestamps.
-- When the cache is full, the least-recently-used entry is evicted.
--
-- Usage:
-- import:
-- cache as C
-- c = C.cache(100)
-- c = C.put(c, "key", 42)
-- match C.get(c, "key"):
-- Some(val): use(val)
-- None: compute()
--
-- Performance:
-- get:      O(1) via Dict lookup
-- put:      O(1) amortized, O(n) on eviction (scans for min timestamp)
-- contains: O(1) via Dict lookup
-- remove:   O(1) via Dict remove
-- length:   O(1)
---
LRU cache with fixed maximum capacity.
Entries are (value, timestamp) pairs; timestamp tracks access recency.
---
opaque type Cache[K, V] = (Int, Dict[K, (V, Int)], Int)


---
Create a new empty cache with the given maximum capacity.

---
pure func cache[K, V](capacity: Int) -> Cache[K, V]:
	from_parts(capacity, {}, 0)


---
Look up a value in the cache without updating access time.
Use touch after a successful get to refresh the entry's recency.

---
pure func get[K, V](cache: Cache[K, V], key: K) -> Option[V]:
	cache_data(cache)
		.get(key)
		.map(func(entry): entry[0])


---
Touch a key to refresh its access timestamp (marks it as recently used).
Call after get to implement LRU behavior.
---
pure func touch[K, V](cache: Cache[K, V], key: K) -> Cache[K, V]:
	data: Dict[K, (V, Int)] = cache_data(cache)

	match data.get(key):
		Some(entry):
			new_counter: Int = cache_counter(cache) + 1
			from_parts(cache_capacity(cache), data.set(key, (entry[0], new_counter)), new_counter)
		None:
			cache


---
Put a key-value pair into the cache. If the cache is at capacity,
the least-recently-used entry is evicted.
---
pure func put[K, V](cache: Cache[K, V], key: K, value: V) -> Cache[K, V]:
	capacity: Int = cache_capacity(cache)
	data: Dict[K, (V, Int)] = cache_data(cache)
	new_counter: Int = cache_counter(cache) + 1

	if data.contains(key):
		from_parts(capacity, data.set(key, (value, new_counter)), new_counter)
	else if data.length() >= capacity:
		evicted: Dict[K, (V, Int)] = evict_lru(data)
		from_parts(capacity, evicted.set(key, (value, new_counter)), new_counter)
	else:
		from_parts(capacity, data.set(key, (value, new_counter)), new_counter)


---
Check if a key exists in the cache (does not update access time).
---
pure func contains[K, V](cache: Cache[K, V], key: K) -> Bool:
	cache_data(cache).contains(key)


---
Get the number of entries in the cache.
---
pure func length[K, V](cache: Cache[K, V]) -> Int:
	cache_data(cache).length()


---
Remove a key from the cache.
---
pure func remove[K, V](cache: Cache[K, V], key: K) -> Cache[K, V]:
	from_parts(cache_capacity(cache), cache_data(cache).remove(key), cache_counter(cache))


-- ============================================================================
-- Internal
-- ============================================================================
private pure func from_parts[K, V](
	capacity: Int,
	data: Dict[K, (V, Int)],
	counter: Int,
) -> Cache[K, V]:
	into Cache[K, V]((capacity, data, counter))


private pure func cache_parts[K, V](cache: Cache[K, V]) -> (Int, Dict[K, (V, Int)], Int):
	from Cache[K, V](cache)


private pure func cache_capacity[K, V](cache: Cache[K, V]) -> Int:
	parts: (Int, Dict[K, (V, Int)], Int) = cache_parts(cache)
	parts[0]


private pure func cache_data[K, V](cache: Cache[K, V]) -> Dict[K, (V, Int)]:
	parts: (Int, Dict[K, (V, Int)], Int) = cache_parts(cache)
	parts[1]


private pure func cache_counter[K, V](cache: Cache[K, V]) -> Int:
	parts: (Int, Dict[K, (V, Int)], Int) = cache_parts(cache)
	parts[2]


private pure func evict_lru[K, V](data: Dict[K, (V, Int)]) -> Dict[K, (V, Int)]:
	entries: List[(K, (V, Int))] = data.entries()
	var min_key: Option[K] = None
	var min_time: Int = INT_MAX

	for entry in entries:
		k: K = entry[0]
		val_and_time: (V, Int) = entry[1]
		timestamp: Int = val_and_time[1]

		if timestamp < min_time:
			min_time = timestamp
			min_key = Some(k)

	match min_key:
		Some(k):
			data.remove(k)
		None:
			data
