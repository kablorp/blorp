-- Int16 - Trait Implementations
--
-- Signed 16-bit integer type.
type Int16 = builtin


implements Stringable for Int16:
	pure func to_string(val: Int16) -> String:
		builtin("blorp_to_string")


implements Equatable for Int16:
	pure func equals(a: Int16, b: Int16) -> Bool:
		a == b

	pure func not_equals(a: Int16, b: Int16) -> Bool:
		a != b


implements Orderable for Int16:
	pure func less_than(a: Int16, b: Int16) -> Bool:
		a < b

	pure func greater_than(a: Int16, b: Int16) -> Bool:
		a > b

	pure func less_than_or_equal(a: Int16, b: Int16) -> Bool:
		a <= b

	pure func greater_than_or_equal(a: Int16, b: Int16) -> Bool:
		a >= b


implements Bounded for Int16:
	pure func min(a: Int16, b: Int16) -> Int16:
		match a < b:
			True:
				a
			_:
				b

	pure func max(a: Int16, b: Int16) -> Int16:
		match a > b:
			True:
				a
			_:
				b


implements Absolute for Int16:
	pure func abs(val: Int16) -> Int16:
		match val < to_int16(0):
			True:
				-val
			_:
				val


implements Negatable for Int16:
	pure func negate(a: Int16) -> Int16:
		-a


implements HasZero for Int16:
	pure func zero() -> Int16:
		to_int16(0)


implements HasOne for Int16:
	pure func one() -> Int16:
		to_int16(1)


implements ToBool for Int16:
	pure func to_bool(val: Int16) -> Bool:
		val != to_int16(0)


implements ToInt for Int16:
	pure func to_int(val: Int16) -> Int:
		to_int(val)


implements Addable for Int16:
	pure func add(a: Int16, b: Int16) -> Int16:
		a + b


implements Subtractable for Int16:
	pure func subtract(a: Int16, b: Int16) -> Int16:
		a - b


implements Multipliable for Int16:
	pure func multiply(a: Int16, b: Int16) -> Int16:
		a * b


implements Divisible for Int16:
	pure func divide(a: Int16, b: Int16) -> Int16:
		a / b


implements Modulable for Int16:
	pure func remainder(a: Int16, b: Int16) -> Int16:
		a % b
