-- Float - Floating-point type trait implementations
--
-- Provides standard trait implementations and math functions for Float:
--
-- Math Functions (builtins):
-- - sqrt, pow: Power operations
-- - sin, cos, tan: Trigonometric functions
-- - floor, ceil, round: Rounding functions
--
-- Trait Implementations:
-- - Stringable: Convert to string representation
-- - Absolute, Bounded: Value operations
-- - Addable, Subtractable, Multipliable, Divisible, Negatable: Arithmetic
-- - Equatable, Orderable: Comparison operations
-- - HasZero, HasOne: Numeric identity values
-- - ToInt, ToBool: Type conversions
--
-- Note: Float division by zero returns 0.0 (safe by default).
type Float = builtin


-- Sized float conversion builtins.
pure func to_float32[T](value: T) -> Float32:
	builtin("blorp_to_float32")


pure func to_float16[T](value: T) -> Float16:
	builtin("blorp_to_float16")


-- ============================================================================
-- Math Functions (builtins)
-- ============================================================================
---
Square root.

doctests:
    :: Square root of 4
    sqrt(4.0) == 2.0

    :: Square root of 9
    sqrt(9.0) == 3.0
---
pure func sqrt(x: Float) -> Float:
	builtin("std/float.sqrt")


---
Power (base^exp).

doctests:
    :: Power of 2 cubed
    pow(2.0, 3.0) == 8.0

    :: Anything to zero power
    pow(10.0, 0.0) == 1.0
---
pure func pow(base: Float, exp: Float) -> Float:
	builtin("std/float.pow")


---
Sine (radians).

doctests:
    :: Sine of zero
    approx_eq(sin(0.0), 0.0) == True
---
pure func sin(x: Float) -> Float:
	builtin("std/float.sin")


---
Cosine (radians).

doctests:
    :: Cosine of zero
    approx_eq(cos(0.0), 1.0) == True
---
pure func cos(x: Float) -> Float:
	builtin("std/float.cos")


---
Tangent (radians).

doctests:
    :: Tangent of zero
    approx_eq(tan(0.0), 0.0) == True
---
pure func tan(x: Float) -> Float:
	builtin("std/float.tan")


---
Round down to nearest integer.

doctests:
    :: Floor positive
    floor(3.7) == 3.0

    :: Floor negative
    floor(-2.3) == -3.0
---
pure func floor(x: Float) -> Float:
	builtin("std/float.floor")


---
Round up to nearest integer.

doctests:
    :: Ceil positive
    ceil(3.2) == 4.0

    :: Ceil negative
    ceil(-2.7) == -2.0
---
pure func ceil(x: Float) -> Float:
	builtin("std/float.ceil")


---
Round to nearest integer (half away from zero).

doctests:
    :: Round up
    round(3.5) == 4.0

    :: Round down
    round(3.4) == 3.0
---
pure func round(x: Float) -> Float:
	builtin("std/float.round")


-- ============================================================================
-- Inverse Trigonometric Functions (builtins)
-- ============================================================================
---
Arc sine. Returns angle in radians for x in [-1, 1].

doctests:
    :: Arcsine of 0
    approx_eq(asin(0.0), 0.0) == True

    :: Arcsine of 1
    approx_eq(asin(1.0), 1.5707963267948966) == True
---
pure func asin(x: Float) -> Float:
	builtin("std/float.asin")


---
Arc cosine. Returns angle in radians for x in [-1, 1].

doctests:
    :: Arccosine of 1
    approx_eq(acos(1.0), 0.0) == True

    :: Arccosine of 0
    approx_eq(acos(0.0), 1.5707963267948966) == True
---
pure func acos(x: Float) -> Float:
	builtin("std/float.acos")


---
Arc tangent. Returns angle in radians.

doctests:
    :: Arctangent of 0
    approx_eq(atan(0.0), 0.0) == True

    :: Arctangent of 1
    approx_eq(atan(1.0), 0.7853981633974483) == True
---
pure func atan(x: Float) -> Float:
	builtin("std/float.atan")


---
Two-argument arc tangent. Returns angle in radians of the point (x, y).

doctests:
    :: atan2 of (0, 1)
    approx_eq(atan2(0.0, 1.0), 0.0) == True

    :: atan2 of (1, 0)
    approx_eq(atan2(1.0, 0.0), 1.5707963267948966) == True
---
pure func atan2(y: Float, x: Float) -> Float:
	builtin("std/float.atan2")


-- ============================================================================
-- Hyperbolic Functions (builtins)
-- ============================================================================
---
Hyperbolic sine.

doctests:
    :: Sinh of 0
    approx_eq(sinh(0.0), 0.0) == True
---
pure func sinh(x: Float) -> Float:
	builtin("std/float.sinh")


---
Hyperbolic cosine.

doctests:
    :: Cosh of 0
    approx_eq(cosh(0.0), 1.0) == True
---
pure func cosh(x: Float) -> Float:
	builtin("std/float.cosh")


---
Hyperbolic tangent.

doctests:
    :: Tanh of 0
    approx_eq(tanh(0.0), 0.0) == True
---
pure func tanh(x: Float) -> Float:
	builtin("std/float.tanh")


---
Inverse hyperbolic sine.

doctests:
    :: Asinh of 0
    approx_eq(asinh(0.0), 0.0) == True
---
pure func asinh(x: Float) -> Float:
	builtin("std/float.asinh")


---
Inverse hyperbolic cosine. Defined for x >= 1.

doctests:
    :: Acosh of 1
    approx_eq(acosh(1.0), 0.0) == True
---
pure func acosh(x: Float) -> Float:
	builtin("std/float.acosh")


---
Inverse hyperbolic tangent. Defined for x in (-1, 1).

doctests:
    :: Atanh of 0
    approx_eq(atanh(0.0), 0.0) == True
---
pure func atanh(x: Float) -> Float:
	builtin("std/float.atanh")


-- ============================================================================
-- Exponential / Logarithmic Functions (builtins)
-- ============================================================================
---
Natural exponential (e^x).

doctests:
    :: Exp of 0
    approx_eq(exp(0.0), 1.0) == True

    :: Exp of 1
    approx_eq(exp(1.0), 2.718281828459045) == True
---
pure func exp(x: Float) -> Float:
	builtin("std/float.exp")


---
Base-2 exponential (2^x).

doctests:
    :: 2^0 = 1
    approx_eq(exp2(0.0), 1.0) == True

    :: 2^3 = 8
    approx_eq(exp2(3.0), 8.0) == True
---
pure func exp2(x: Float) -> Float:
	builtin("std/float.exp2")


---
Natural logarithm (base e).

doctests:
    :: Log of 1
    approx_eq(log(1.0), 0.0) == True

    :: Log of e
    approx_eq(log(2.718281828459045), 1.0) == True
---
pure func log(x: Float) -> Float:
	builtin("std/float.log")


---
Base-2 logarithm.

doctests:
    :: Log2 of 1
    approx_eq(log2(1.0), 0.0) == True

    :: Log2 of 8
    approx_eq(log2(8.0), 3.0) == True
---
pure func log2(x: Float) -> Float:
	builtin("std/float.log2")


---
Base-10 logarithm.

doctests:
    :: Log10 of 1
    approx_eq(log10(1.0), 0.0) == True

    :: Log10 of 1000
    approx_eq(log10(1000.0), 3.0) == True
---
pure func log10(x: Float) -> Float:
	builtin("std/float.log10")


---
Natural logarithm of (1 + x). More accurate than log(1+x) for small x.

doctests:
    :: Log1p of 0
    approx_eq(log1p(0.0), 0.0) == True
---
pure func log1p(x: Float) -> Float:
	builtin("std/float.log1p")


---
e^x - 1. More accurate than exp(x)-1 for small x.

doctests:
    :: Expm1 of 0
    approx_eq(expm1(0.0), 0.0) == True
---
pure func expm1(x: Float) -> Float:
	builtin("std/float.expm1")


-- ============================================================================
-- Power / Root Functions (builtins)
-- ============================================================================
---
Cube root.

doctests:
    :: Cube root of 27
    approx_eq(cbrt(27.0), 3.0) == True

    :: Cube root of -8
    approx_eq(cbrt(-8.0), -2.0) == True
---
pure func cbrt(x: Float) -> Float:
	builtin("std/float.cbrt")


---
Euclidean distance: sqrt(x*x + y*y), computed without overflow.

doctests:
    :: 3-4-5 triangle
    approx_eq(hypot(3.0, 4.0), 5.0) == True
---
pure func hypot(x: Float, y: Float) -> Float:
	builtin("std/float.hypot")


-- ============================================================================
-- Rounding / Float Utility Functions (builtins)
-- ============================================================================
---
Truncate toward zero (remove fractional part).

doctests:
    :: Truncate positive
    trunc(3.7) == 3.0

    :: Truncate negative
    trunc(-3.7) == -3.0
---
pure func trunc(x: Float) -> Float:
	builtin("std/float.trunc")


---
Floating-point remainder of x/y (same sign as x).

doctests:
    :: Fmod positive
    approx_eq(fmod(5.3, 2.0), 1.3) == True

    :: Fmod negative dividend
    approx_eq(fmod(-5.3, 2.0), -1.3) == True
---
pure func fmod(x: Float, y: Float) -> Float:
	builtin("std/float.fmod")


---
Returns x with the sign of y.

doctests:
    :: Copy positive sign
    copysign(3.0, 1.0) == 3.0

    :: Copy negative sign
    copysign(3.0, -1.0) == -3.0
---
pure func copysign(x: Float, y: Float) -> Float:
	builtin("std/float.copysign")


---
Fused multiply-add: (x * y) + z with a single rounding step.

doctests:
    :: Basic fma
    approx_eq(fma(2.0, 3.0, 4.0), 10.0) == True
---
pure func fma(x: Float, y: Float, z: Float) -> Float:
	builtin("std/float.fma")


-- ============================================================================
-- Float Classification Functions (builtins)
-- ============================================================================
---
Returns True if x is NaN.

doctests:
    :: Normal number is not NaN
    is_nan(1.0) == False

    :: NaN is NaN (1.0/0.0 - 1.0/0.0 produces NaN)
    is_nan(1.0 / 0.0 - 1.0 / 0.0) == True
---
pure func is_nan(x: Float) -> Bool:
	builtin("std/float.is_nan")


---
Returns True if x is positive or negative infinity.

doctests:
    :: Normal number is not infinite
    is_inf(1.0) == False

    :: Infinity is infinite (1.0/0.0 produces infinity)
    is_inf(1.0 / 0.0) == True
---
pure func is_inf(x: Float) -> Bool:
	builtin("std/float.is_inf")


---
Returns True if x is neither NaN nor infinity.

doctests:
    :: Normal number is finite
    is_finite(1.0) == True

    :: Infinity is not finite
    is_finite(1.0 / 0.0) == False
---
pure func is_finite(x: Float) -> Bool:
	builtin("std/float.is_finite")


-- ============================================================================
-- Special Float Constants
--
-- The runtime supplies the actual IEEE-754 bit patterns via the
-- float arithmetic expressions below; they avoid running helper functions
-- while globals are initialized before main.
-- ============================================================================
-- Positive infinity (1.0 / 0.0 in IEEE-754).
INFINITY: Float = 1.0 / 0.0

-- Negative infinity (-1.0 / 0.0 in IEEE-754).
NEG_INFINITY: Float = -1.0 / 0.0

-- NaN (Not a Number). [NAN != NAN] is True per IEEE-754.
NAN: Float = 0.0 / 0.0


-- ============================================================================
-- Pure Float Helper Functions
-- ============================================================================
---
Convert radians to degrees.

doctests:
    :: Pi radians is close to 180 degrees
    degrees(3.141592653589793) > 179.99

    :: Zero stays zero
    degrees(0.0) == 0.0
---
pure func degrees(radians: Float) -> Float:
	radians / 3.141592653589793 * 180.0


---
Convert degrees to radians.

doctests:
    :: 180 degrees is close to pi radians
    radians(180.0) > 3.1415

    :: Zero stays zero
    radians(0.0) == 0.0
---
pure func radians(deg: Float) -> Float:
	deg / 180.0 * 3.141592653589793


---
Sign of a float: returns -1.0, 0.0, or 1.0.

doctests:
    :: Positive
    sign(42.0) == 1.0

    :: Negative
    sign(-3.5) == -1.0

    :: Zero
    sign(0.0) == 0.0
---
pure func sign(x: Float) -> Float:
	if x > 0.0:
		1.0
	else if x < 0.0:
		-1.0
	else:
		0.0


-- ============================================================================
-- Trait Implementations
-- ============================================================================
-- Format a float with a fixed number of decimal places.
pure func format_float(f: Float, precision: Int) -> String:
	builtin("blorp_format_float")


-- String conversion
implements Stringable for Float:
	pure func to_string(val: Float) -> String:
		builtin("blorp_float_to_string")


-- Absolute value
implements Absolute for Float:
	pure func abs(val: Float) -> Float:
		match val < 0.0:
			True: -val
			_: val


-- Min/Max
implements Bounded for Float:
	pure func min(a: Float, b: Float) -> Float:
		match a < b:
			True: a
			_: b

	pure func max(a: Float, b: Float) -> Float:
		match a > b:
			True: a
			_: b


-- Arithmetic operators
implements Addable for Float:
	pure func add(a: Float, b: Float) -> Float:
		a + b


implements Subtractable for Float:
	pure func subtract(a: Float, b: Float) -> Float:
		a - b


implements Multipliable for Float:
	pure func multiply(a: Float, b: Float) -> Float:
		a * b


implements Divisible for Float:
	pure func divide(a: Float, b: Float) -> Float:
		a / b


implements Negatable for Float:
	pure func negate(a: Float) -> Float:
		-a


-- Comparison operators
implements Equatable for Float:
	pure func equals(a: Float, b: Float) -> Bool:
		a == b

	pure func not_equals(a: Float, b: Float) -> Bool:
		a != b


implements Orderable for Float:
	pure func less_than(a: Float, b: Float) -> Bool:
		a < b

	pure func greater_than(a: Float, b: Float) -> Bool:
		a > b

	pure func less_than_or_equal(a: Float, b: Float) -> Bool:
		a <= b

	pure func greater_than_or_equal(a: Float, b: Float) -> Bool:
		a >= b


-- Numeric trait support
implements HasZero for Float:
	pure func zero() -> Float:
		0.0


implements HasOne for Float:
	pure func one() -> Float:
		1.0


-- Type conversions FROM Float
implements ToInt for Float:
	pure func to_int(val: Float) -> Int:
		to_int(val)


implements ToBool for Float:
	pure func to_bool(val: Float) -> Bool:
		val != 0.0


implements ToFloat for Float:
	pure func to_float(val: Float) -> Float:
		val


implements Numeric for Float:
	pure func __numeric_marker() -> Float:
		0.0


-- marker trait: all methods inherited from super-traits
---
Linear interpolation: lerp(a, b, t) = a + (b - a) * t.

doctests:
    :: Lerp midpoint
    lerp(0.0, 10.0, 0.5) == 5.0

    :: Lerp at start
    lerp(0.0, 10.0, 0.0) == 0.0
---
pure func lerp(a: Float, b: Float, t: Float) -> Float:
	a + (b - a) * t


---
Clamp a value to [lo, hi].

doctests:
    :: Value in range
    clamp(5.0, 0.0, 10.0) == 5.0

    :: Value below range
    clamp(-5.0, 0.0, 10.0) == 0.0

    :: Value above range
    clamp(15.0, 0.0, 10.0) == 10.0
---
pure func clamp(val: Float, lo: Float, hi: Float) -> Float:
	match val < lo:
		True: lo
		False:
			match val > hi:
				True: hi
				False: val


---
Inverse lerp: returns where val falls in [a, b] as a 0..1 fraction.

doctests:
    :: Midpoint
    inverse_lerp(0.0, 10.0, 5.0) == 0.5

    :: Start
    inverse_lerp(0.0, 10.0, 0.0) == 0.0

    :: End
    inverse_lerp(0.0, 10.0, 10.0) == 1.0
---
pure func inverse_lerp(a: Float, b: Float, val: Float) -> Float:
	(val - a) / (b - a)


---
Remap a value from one range to another.

doctests:
    :: Remap midpoint
    remap(5.0, 0.0, 10.0, 0.0, 100.0) == 50.0

    :: Remap zero
    remap(0.0, 0.0, 10.0, 20.0, 40.0) == 20.0
---
pure func remap(
	val: Float,
	in_lo: Float,
	in_hi: Float,
	out_lo: Float,
	out_hi: Float,
) -> Float:
	lerp(out_lo, out_hi, inverse_lerp(in_lo, in_hi, val))


---
Smoothstep: smooth Hermite interpolation between 0 and 1.
Returns 0 when val <= lo, 1 when val >= hi, smooth curve between.

doctests:
    :: Below range
    smoothstep(0.0, 1.0, -0.5) == 0.0

    :: Above range
    smoothstep(0.0, 1.0, 1.5) == 1.0

    :: Midpoint
    smoothstep(0.0, 1.0, 0.5) == 0.5
---
pure func smoothstep(lo: Float, hi: Float, val: Float) -> Float:
	t: Float = clamp((val - lo) / (hi - lo), 0.0, 1.0)
	t * t * (3.0 - 2.0 * t)


---
Smoother step (Ken Perlin's improved version).
Fifth-order polynomial with zero 1st and 2nd derivatives at edges.
---
pure func smootherstep(lo: Float, hi: Float, val: Float) -> Float:
	t: Float = clamp((val - lo) / (hi - lo), 0.0, 1.0)
	t * t * t * (t * (t * 6.0 - 15.0) + 10.0)


-- ============================================================================
-- Easing Functions
-- ============================================================================
-- All easing functions take t in [0, 1] and return a curved value.
-- Useful for animations, transitions, and "juice" in games and UIs.
---
Ease in quadratic: starts slow, accelerates.

doctests:
    :: Start
    ease_in_quad(0.0) == 0.0

    :: End
    ease_in_quad(1.0) == 1.0
---
pure func ease_in_quad(t: Float) -> Float:
	t * t


---
Ease out quadratic: starts fast, decelerates.
---
pure func ease_out_quad(t: Float) -> Float:
	1.0 - (1.0 - t) * (1.0 - t)


---
Ease in-out quadratic: slow start and end, fast middle.
---
pure func ease_in_out_quad(t: Float) -> Float:
	if t < 0.5:
		2.0 * t * t
	else:
		1.0 - (-2.0 * t + 2.0) * (-2.0 * t + 2.0) / 2.0


---
Ease in cubic.
---
pure func ease_in_cubic(t: Float) -> Float:
	t * t * t


---
Ease out cubic.
---
pure func ease_out_cubic(t: Float) -> Float:
	v: Float = 1.0 - t
	1.0 - v * v * v


---
Ease in-out cubic.
---
pure func ease_in_out_cubic(t: Float) -> Float:
	if t < 0.5:
		4.0 * t * t * t
	else:
		v: Float = -2.0 * t + 2.0
		1.0 - v * v * v / 2.0


---
Ease in quartic.
---
pure func ease_in_quart(t: Float) -> Float:
	t * t * t * t


---
Ease out quartic.
---
pure func ease_out_quart(t: Float) -> Float:
	v: Float = 1.0 - t
	1.0 - v * v * v * v


---
Ease in-out quartic.
---
pure func ease_in_out_quart(t: Float) -> Float:
	if t < 0.5:
		8.0 * t * t * t * t
	else:
		v: Float = -2.0 * t + 2.0
		1.0 - v * v * v * v / 2.0


---
Ease in sine: gentle start.
---
pure func ease_in_sine(t: Float) -> Float:
	1.0 - cos(t * 3.14159265358979 / 2.0)


---
Ease out sine: gentle end.
---
pure func ease_out_sine(t: Float) -> Float:
	sin(t * 3.14159265358979 / 2.0)


---
Ease in-out sine: gentle start and end.
---
pure func ease_in_out_sine(t: Float) -> Float:
	-(cos(3.14159265358979 * t) - 1.0) / 2.0


---
Ease in exponential: very slow start, fast end.
---
pure func ease_in_expo(t: Float) -> Float:
	if t == 0.0:
		0.0
	else:
		pow(2.0, 10.0 * t - 10.0)


---
Ease out exponential: fast start, very slow end.
---
pure func ease_out_expo(t: Float) -> Float:
	if t == 1.0:
		1.0
	else:
		1.0 - pow(2.0, -10.0 * t)


---
Ease in-out exponential.
---
pure func ease_in_out_expo(t: Float) -> Float:
	if t == 0.0:
		0.0
	else if t == 1.0:
		1.0
	else if t < 0.5:
		pow(2.0, 20.0 * t - 10.0) / 2.0
	else:
		(2.0 - pow(2.0, -20.0 * t + 10.0)) / 2.0


---
Ease in elastic: overshoots with a spring-like wobble.
---
pure func ease_in_elastic(t: Float) -> Float:
	if t == 0.0:
		0.0
	else if t == 1.0:
		1.0
	else:
		c: Float = 2.0 * 3.14159265358979 / 3.0
		-pow(2.0, 10.0 * t - 10.0) * sin((t * 10.0 - 10.75) * c)


---
Ease out elastic: settles with a spring-like wobble.
---
pure func ease_out_elastic(t: Float) -> Float:
	if t == 0.0:
		0.0
	else if t == 1.0:
		1.0
	else:
		c: Float = 2.0 * 3.14159265358979 / 3.0
		pow(2.0, -10.0 * t) * sin((t * 10.0 - 0.75) * c) + 1.0


---
Ease in back: pulls back before moving forward.
---
pure func ease_in_back(t: Float) -> Float:
	c: Float = 1.70158
	c3: Float = c + 1.0
	c3 * t * t * t - c * t * t


---
Ease out back: overshoots target then settles.
---
pure func ease_out_back(t: Float) -> Float:
	c: Float = 1.70158
	c3: Float = c + 1.0
	v: Float = t - 1.0
	1.0 + c3 * v * v * v + c * v * v


---
Ease in-out back: pulls back and overshoots.
---
pure func ease_in_out_back(t: Float) -> Float:
	c: Float = 1.70158 * 1.525

	if t < 0.5:
		2.0 * t * 2.0 * t * ((c + 1.0) * 2.0 * t - c) / 2.0
	else:
		v: Float = 2.0 * t - 2.0
		(v * v * ((c + 1.0) * v + c) + 2.0) / 2.0


---
Ease out bounce: bouncing ball effect.
---
pure func ease_out_bounce(t: Float) -> Float:
	n: Float = 7.5625
	d: Float = 2.75

	if t < 1.0 / d:
		n * t * t
	else if t < 2.0 / d:
		v: Float = t - 1.5 / d
		n * v * v + 0.75
	else if t < 2.5 / d:
		v: Float = t - 2.25 / d
		n * v * v + 0.9375
	else:
		v: Float = t - 2.625 / d
		n * v * v + 0.984375


---
Ease in bounce.
---
pure func ease_in_bounce(t: Float) -> Float:
	1.0 - ease_out_bounce(1.0 - t)


---
Ease in-out bounce.
---
pure func ease_in_out_bounce(t: Float) -> Float:
	if t < 0.5:
		(1.0 - ease_out_bounce(1.0 - 2.0 * t)) / 2.0
	else:
		(1.0 + ease_out_bounce(2.0 * t - 1.0)) / 2.0


---
Approximate equality for floating-point comparisons.
Returns True if |a - b| <= epsilon.

doctests:
    :: Within epsilon
    almost_equal(1.0, 1.0000001, 0.001) == True

    :: Outside epsilon
    almost_equal(1.0, 2.0, 0.001) == False
---
pure func almost_equal(a: Float, b: Float, epsilon: Float) -> Bool:
	diff: Float = a - b
	abs_diff: Float = match diff < 0.0:
		True: -diff
		False: diff
	abs_diff <= epsilon


---
Default epsilon version of almost_equal (epsilon = 1e-9).

doctests:
    :: Equal values are approximately equal
    approx_eq(1.0, 1.0) == True
---
pure func approx_eq(a: Float, b: Float) -> Bool:
	almost_equal(a, b, 0.000000001)


---
Format a float with the given number of decimal places.

doctests:
    :: Two decimal places
    format(3.14159, 2) == "3.14"

    :: Zero decimal places
    format(3.14159, 0) == "3"
---
pure func format(f: Float, decimals: Int) -> String:
	format_float(f, decimals)
