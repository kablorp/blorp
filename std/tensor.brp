-- Tensor - Generic multi-dimensional array operations
--
-- Core operations that work on ANY tensor regardless of dimensionality.
-- These operate on the first dimension (peeling semantics).
--
-- #N... (variadic dimensions) means "any number of dimensions." It is used
-- in function signatures to accept tensors of any shape. The concrete
-- dimensions flow through at the call site:
--
-- v = vector(0.0, 5)   -- 5-element zero vector
-- w = vector(42, 3)     -- 3-element vector filled with 42
-- m = matrix(0, 2, 3)  -- 2x3 matrix of zeros
--
-- #N... accepts any number of dimensions. It must be the last type
-- argument and can only appear once.
--
-- For 1D-specific ops (reductions, HOFs), see vector.
-- For 2D-specific ops (multiply, transpose), see matrix.
-- ============================================================================
-- Core Operations (builtins)
-- ============================================================================
---
Get the length of the first dimension.
---
pure func length[T](arr: T[#_...]) -> Int:
	builtin("std/tensor.length")


---
Bounds-checked element access.
Returns Some(element) for valid index, None for out-of-bounds.
---
pure func get(arr: T[#_], index: Int) -> Option[T]:
	builtin("std/tensor.get")


---
Get element at index, returning default if out of bounds.
---
pure func get_or(arr: T[#_], index: Int, default: T) -> T:
	match arr.get(index):
		Some(v): v
		None: default


---
Bounds-checked element update (returns new tensor with COW).
Returns Some(new_tensor) on success, None for out-of-bounds.
---
pure func set_index(arr: T[#N], index: Int, val: T) -> Option[T[#N]]:
	builtin("std/tensor.set_index")


-- ============================================================================
-- Shape
-- ============================================================================
---
Runtime shape assertion: refine a variadic-dim tensor to a concrete size.
Returns Some(tensor) when [length(t) == expected_len], or None otherwise.
Used to convert [T[#Ds...]] into [T[#N]] at API boundaries
where the expected size is a constant.
---
pure func assert_shape(t: T[#Ds...], expected_len: Int) -> Option[T[#Ds...]]:
	builtin("std/tensor.assert_shape")


---
First-dimension index loop combinator.
Use in [for]: [for i in indices(vector): ...].
In for-position, inference rewrites this into a non-materializing loop-view.
The yielded index is range-refined, so tensor subscripts using it are
compile-time bounds-checked.
---
pure func indices(vec: T[#Ds...]) -> List[Int]:
	builtin("std/tensor.indices")


---
Flat 2D iteration combinator: yields (row, col, value) triples.
Use in [for]: [for (i, j, v) in enumerate2(matrix): ...].
In for-position, inference rewrites this into a non-materializing loop-view, so
no intermediate List is allocated.
---
pure func enumerate2(mat: T[#M, #N]) -> List[(Int, Int, T)]:
	builtin("std/tensor.enumerate2")


---
Flat 1D iteration combinator: yields (index, value) pairs.
Use in [for]: [for (i, v) in enumerate(vector): ...].
In for-position, inference rewrites this into a non-materializing loop-view, so
no intermediate List is allocated.
---
pure func enumerate(vec: T[#Ds...]) -> List[(Int, T)]:
	builtin("std/tensor.enumerate")


---
Sliding window loop combinator over 1D tensors.
Use in [for]: [for w in windows(v, 3): ...].
In for-position, inference rewrites this into a non-materializing loop-view.
Each yielded [w] has type [T[#K]] and supports compile-time
bounds-checked indexing with [0..K-1] inside the loop body.
---
pure func windows(vec: T[#Ds...], size: Int) -> List[T]:
	builtin("std/tensor.windows")


-- ============================================================================
-- Compile-time Bounds-checked Access (desugared from subscript syntax)
-- ============================================================================
---
Compile-time bounds-checked single-index access (dimensional peeling).
Desugared from x[i]. On 1D returns element, on N-D returns (N-1)-D slice.
---
pure func checked_get(arr: T[#_], index: Int) -> T:
	builtin("std/tensor.checked_get")


---
Compile-time bounds-checked single-index peel on N-D tensors.
Compiler-emitted helper for subscript desugaring when [x[i]] returns a sub-tensor.
---
pure func tensor_peel[T](arr: T, index: Int) -> T:
	builtin("blorp_tensor_peel")


---
Compile-time bounds-checked 1D element write (COW).
Desugared from x[i] = val. Returns the (possibly COW-copied) tensor.
---
pure func checked_set(arr: T[#N], index: ..#N, val: T) -> T[#N]:
	builtin("std/tensor.checked_set")


---
Compile-time bounds-checked 1D range slice.
Desugared from x[s..e].
---
pure func checked_slice[T, #N](arr: T[#N], start: Int, end_idx: Int) -> T[#_]:
	builtin("std/tensor.checked_slice")


---
Compile-time bounds-checked 2D flat element access.
Desugared from m[i, j]. Returns the element directly via flat index.
---
pure func matrix_checked_get[T, #M, #N](arr: T[#M, #N], row: Int, col: Int) -> T:
	builtin("std/tensor.matrix_checked_get")


---
Compile-time bounds-checked 2D flat element write (COW).
Desugared from m[i, j] = val.
---
pure func matrix_checked_set[T, #M, #N](
	arr: T[#M, #N],
	row: Int,
	col: Int,
	val: T,
) -> T[#M, #N]:
	builtin("std/tensor.matrix_checked_set")


---
Compile-time bounds-checked 3D flat element access.
---
pure func tensor3_checked_get[T, #A, #B, #C](
	arr: T[#A, #B, #C],
	i: Int,
	j: Int,
	k: Int,
) -> T:
	builtin("std/tensor.tensor3_checked_get")


---
Compile-time bounds-checked 3D flat element write (COW).
---
pure func tensor3_checked_set[T, #A, #B, #C](
	arr: T[#A, #B, #C],
	i: Int,
	j: Int,
	k: Int,
	val: T,
) -> T[#A, #B, #C]:
	builtin("std/tensor.tensor3_checked_set")


---
Compile-time bounds-checked 4D flat element access.
---
pure func tensor4_checked_get[T, #A, #B, #C, #D](
	arr: T[#A, #B, #C, #D],
	i: Int,
	j: Int,
	k: Int,
	l: Int,
) -> T:
	builtin("std/tensor.tensor4_checked_get")


---
Compile-time bounds-checked 4D flat element write (COW).
---
pure func tensor4_checked_set[T, #A, #B, #C, #D](
	arr: T[#A, #B, #C, #D],
	i: Int,
	j: Int,
	k: Int,
	l: Int,
	val: T,
) -> T[#A, #B, #C, #D]:
	builtin("std/tensor.tensor4_checked_set")


---
Compile-time bounds-checked 5D flat element access.
---
pure func tensor5_checked_get[T, #A, #B, #C, #D, #E](
	arr: T[#A, #B, #C, #D, #E],
	i: Int,
	j: Int,
	k: Int,
	l: Int,
	m: Int,
) -> T:
	builtin("std/tensor.tensor5_checked_get")


---
Compile-time bounds-checked 5D flat element write (COW).
---
pure func tensor5_checked_set[T, #A, #B, #C, #D, #E](
	arr: T[#A, #B, #C, #D, #E],
	i: Int,
	j: Int,
	k: Int,
	l: Int,
	m: Int,
	val: T,
) -> T[#A, #B, #C, #D, #E]:
	builtin("std/tensor.tensor5_checked_set")


---
Create a 1D vector filled with a value.

doctests:
    :: Vector of zeros
    v: Int[#3] = vector(0, 3)
    v.length() == 3
---
pure func vector(value: T, size: #N) -> T[#N]:
	builtin("std/tensor.vector")


---
Create a 2D matrix filled with a value.

doctests:
    :: 2x3 matrix has 2 rows
    m: Int[#2, #3] = matrix(0, 2, 3)
    m.length() == 2
---
pure func matrix[T, #N, #M](value: T, rows: #N, cols: #M) -> T[#N, #M]:
	builtin("std/tensor.matrix")


---
Create a 3D tensor filled with a value.

doctests:
    :: 2x3x4 tensor has 2 slices
    t: Int[#2, #3, #4] = tensor3(0, 2, 3, 4)
    t.length() == 2
---
pure func tensor3[T, #X, #Y, #Z](value: T, x: #X, y: #Y, z: #Z) -> T[#X, #Y, #Z]:
	builtin("std/tensor.tensor3")


---
Create a 4D tensor filled with a value.
---
pure func tensor4[T, #A, #B, #C, #D](value: T, d1: #A, d2: #B, d3: #C, d4: #D) -> T[#A, #B, #C, #D]:
	builtin("std/tensor.tensor4")


---
Create a 5D tensor filled with a value.
---
pure func tensor5[T, #A, #B, #C, #D, #E](
	value: T,
	d1: #A,
	d2: #B,
	d3: #C,
	d4: #D,
	d5: #E,
) -> T[#A, #B, #C, #D, #E]:
	builtin("std/tensor.tensor5")


---
Set all elements to a value. Returns a new tensor (COW).

Signature is 1D (`T[#N]`) because the body writes a scalar at
each index — the multi-dim form `arr[i] = val` would peel to a row and
reject the scalar. For variadic-dim fills, callers should write the
loop explicitly with `blorp_tensor_fill`-style runtime primitives.

doctests:
    :: Set all to zero
    v: Int[#3] = {1, 2, 3}
    set_all(v, 0) == {0, 0, 0}
---
pure func set_all[T, #N](arr: T[#N], val: T) -> T[#N]:
	var result = arr

	for i in 0..result.length():
		result[i] = val

	result


---
Check if the tensor is empty.
---
pure func is_empty[T](arr: T[#_...]) -> Bool:
	arr.length() == 0
