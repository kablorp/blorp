-- Matrix - 2D array operations
--
-- This module provides 2D-specific operations: matmul, transpose.
-- For generic tensor ops (length, get, set_index), see tensor.
---
Set element at (row, col), returning unchanged matrix if out of bounds.
---
pure func set_at[T, #M, #N](m: T[#M, #N], row: Int, col: Int, val: T) -> T[#M, #N]:
	builtin


-- ============================================================================
-- Matrix Operations (special-case codegen)
-- ============================================================================
---
Matrix multiplication: C[M,N] = A[M,K] * B[K,N].
K dimension must match (validated at compile time).
---
pure func matmul[T:Numeric, #M, #K, #N](a: T[#M, #K], b: T[#K, #N]) -> T[#M, #N]:
	builtin


---
Matrix transpose: swap rows and columns.
---
pure func transpose[T, #M, #N](m: T[#M, #N]) -> T[#N, #M]:
	builtin


---
Matrix-vector multiply: y[i] = sum_j(W[i,j] * x[j]).
W is [M, N], x is [N], result is [M].
---
pure func matvec[T:Numeric, #M, #N](w: T[#M, #N], x: T[#N]) -> T[#M]:
	builtin


---
Outer product: result[i,j] = a[i] * b[j].
a is [M], b is [N], result is [M, N].
---
pure func outer[T:Numeric, #M, #N](a: T[#M], b: T[#N]) -> T[#M, #N]:
	builtin


---
Transpose-matvec: y[j] = sum_i(W[i,j] * x[i]) = W^T * x.
W is [M, N], x is [M], result is [N].
Computes the transpose multiply without allocating a transposed matrix.
Useful for backpropagation: dx = matvec_t(w, dy).
---
pure func matvec_t[T:Numeric, #M, #N](w: T[#M, #N], x: T[#M]) -> T[#N]:
	builtin


-- ============================================================================
-- 2D Element Access (runtime bounds-checked)
-- ============================================================================
---
Get element at (row, col), returning None if out of bounds.
---
pure func get[T, #M, #N](m: T[#M, #N], row: Int, col: Int) -> Option[T]:
	builtin


---
Get element at (row, col), returning default if out of bounds.
---
pure func get_or[T, #M, #N](m: T[#M, #N], row: Int, col: Int, default: T) -> T:
	-- Call the 2D accessor under a private name that can't be shadowed by
	-- tensor's 2-arg `get` in batch-compile environments where both are in
	-- scope.
	match _matrix_get(m, row, col):
		Some(v): v
		None: default


-- Private 2D accessor — same codegen as [get] above, re-exported under a
-- name that doesn't collide with tensor's 1-D 2-arg `get`. Used by
-- [get_or]'s body because calls to bare `get(m, row, col)` can be
-- misresolved to tensor's 2-arg signature when tensor's `get` is also in
-- the typecheck env (see Phase 1.5 test-runner isolation).
private pure func _matrix_get[T, #M, #N](m: T[#M, #N], row: Int, col: Int) -> Option[T]:
	builtin
