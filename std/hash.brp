-- Hash - Cryptographic and non-cryptographic hash functions
--
-- Provides FNV-1a (fast, non-cryptographic), SHA-256, and MD5 hash functions.
-- All hash functions are pure — they produce deterministic output from input.
---
Compute FNV-1a hash of a string. Returns a 64-bit integer.
Fast non-cryptographic hash suitable for hash tables and checksums.

doctests:
    :: Same input produces same hash
    hash("hello") == hash("hello")

    :: Different inputs produce different hashes
    hash("hello") != hash("world")

    :: Empty string has a defined hash
    hash("") == hash("")
---
pure func hash(s: String) -> Int:
	builtin("blorp_hash")


---
Compute FNV-1a hash of raw bytes.

doctests:
    :: Bytes hash is deterministic
    hash_bytes("test".to_bytes()) == hash_bytes("test".to_bytes())
---
pure func hash_bytes(b: Bytes) -> Int:
	builtin("blorp_hash_bytes")


---
Combine two hash values into a new hash value.
Useful when implementing Hashable for records with multiple fields.
---
pure func hash_combine(seed: Int, value: Int) -> Int:
	builtin("blorp_hash_combine")


---
Compute SHA-256 hash, returning a 64-character lowercase hex string.

doctests:
    :: SHA-256 of empty string
    sha256("") == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"

    :: SHA-256 of known input
    sha256("hello") == "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824"

    :: SHA-256 produces 64-char hex
    sha256("test").length() == 64
---
pure func sha256(s: String) -> String:
	builtin("blorp_sha256")


---
Compute MD5 hash, returning a 32-character lowercase hex string.
Note: MD5 is cryptographically broken. Use SHA-256 for security purposes.

doctests:
    :: MD5 of empty string
    md5("") == "d41d8cd98f00b204e9800998ecf8427e"

    :: MD5 of known input
    md5("hello") == "5d41402abc4b2a76b9719d911017c592"

    :: MD5 produces 32-char hex
    md5("test").length() == 32
---
pure func md5(s: String) -> String:
	builtin("blorp_md5")


---
Compute SHA-1 hash, returning a 40-character lowercase hex string.
Note: SHA-1 is cryptographically weak. Use SHA-256 for security purposes.

doctests:
    :: SHA-1 of empty string
    sha1("") == "da39a3ee5e6b4b0d3255bfef95601890afd80709"

    :: SHA-1 of known input
    sha1("abc") == "a9993e364706816aba3e25717850c26c9cd0d89d"

    :: SHA-1 produces 40-char hex
    sha1("test").length() == 40
---
pure func sha1(s: String) -> String:
	builtin("blorp_sha1")


---
Compute SHA-512 hash, returning a 128-character lowercase hex string.

doctests:
    :: SHA-512 of empty string
    sha512("") == "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e"

    :: SHA-512 produces 128-char hex
    sha512("test").length() == 128
---
pure func sha512(s: String) -> String:
	builtin("blorp_sha512")


---
Compute CRC32 checksum (IEEE 802.3), returning a 32-bit integer.
Fast, non-cryptographic checksum suitable for data integrity checks.

doctests:
    :: CRC32 of empty string
    crc32("") == 0

    :: CRC32 of known input
    crc32("hello") == crc32("hello")
---
pure func crc32(s: String) -> Int:
	builtin("blorp_crc32")


---
Compute SHA-256 hash of raw bytes, returning a 64-character lowercase hex string.

doctests:
    :: SHA-256 of bytes matches string
    sha256_bytes("hello".to_bytes()) == sha256("hello")
---
pure func sha256_bytes(b: Bytes) -> String:
	builtin("blorp_sha256_bytes")


---
Compute MD5 hash of raw bytes, returning a 32-character lowercase hex string.

doctests:
    :: MD5 of bytes matches string
    md5_bytes("hello".to_bytes()) == md5("hello")
---
pure func md5_bytes(b: Bytes) -> String:
	builtin("blorp_md5_bytes")


---
Compute SHA-1 hash of raw bytes, returning a 40-character lowercase hex string.

doctests:
    :: SHA-1 of bytes matches string
    sha1_bytes("hello".to_bytes()) == sha1("hello")
---
pure func sha1_bytes(b: Bytes) -> String:
	builtin("blorp_sha1_bytes")


---
Compute SHA-512 hash of raw bytes, returning a 128-character lowercase hex string.

doctests:
    :: SHA-512 of bytes matches string
    sha512_bytes("hello".to_bytes()) == sha512("hello")
---
pure func sha512_bytes(b: Bytes) -> String:
	builtin("blorp_sha512_bytes")


---
Compute CRC32 checksum of raw bytes, returning a 32-bit integer.

doctests:
    :: CRC32 of bytes matches string
    crc32_bytes("hello".to_bytes()) == crc32("hello")
---
pure func crc32_bytes(b: Bytes) -> Int:
	builtin("blorp_crc32_bytes")


---
Compute HMAC-SHA256 message authentication code.
Returns a 64-character lowercase hex string.

doctests:
    :: HMAC with known test vector
    hmac_sha256("key", "message").length() == 64

    :: HMAC is deterministic
    hmac_sha256("key", "msg") == hmac_sha256("key", "msg")
---
pure func hmac_sha256(key: String, msg: String) -> String:
	builtin("blorp_hmac_sha256")
