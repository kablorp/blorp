import:
	geometry: Vec2, vec2, vec2_add, vec2_dot, vec2_length, vec2_normalize, vec2_scale, vec2_sub


-- Physics - 2D physics simulation primitives
--
-- Pure functions for integration, forces, and collision response.
-- All functions operate on Vec2 from geometry.brp.
-- Integration
---
Euler integration step: updates position and velocity given acceleration.
Returns (new_position, new_velocity).

doctests:
    :: Euler step with constant velocity
    r: (Vec2, Vec2) = euler_step(vec2(0.0, 0.0), vec2(1.0, 0.0), vec2(0.0, 0.0), 1.0)
    r.0.x.approx_eq(1.0)
---
pure func euler_step(pos: Vec2, vel: Vec2, acc: Vec2, dt: Float) -> (Vec2, Vec2):
	new_vel: Vec2 = vec2_add(vel, vec2_scale(acc, dt))
	new_pos: Vec2 = vec2_add(pos, vec2_scale(new_vel, dt))
	(new_pos, new_vel)


---
Verlet integration step: uses current and previous position.
Returns (new_position, current_position_as_prev).

doctests:
    :: Verlet step extrapolates motion
    r: (Vec2, Vec2) = verlet_step(vec2(1.0, 0.0), vec2(0.0, 0.0), vec2(0.0, 0.0), 1.0)
    r.0.x.approx_eq(2.0)
---
pure func verlet_step(
	pos: Vec2,
	prev_pos: Vec2,
	acc: Vec2,
	dt: Float,
) -> (Vec2, Vec2):
	dt2: Float = dt * dt
	new_pos: Vec2 = vec2_add(vec2_sub(vec2_scale(pos, 2.0), prev_pos), vec2_scale(acc, dt2))
	(new_pos, pos)


---
4th-order Runge-Kutta integration step.
acc_fn computes acceleration given position and velocity.
Returns (new_position, new_velocity).

doctests:
    :: RK4 step moves forward
    acc: pure (Vec2, Vec2) -> Vec2 = pure func(p: Vec2, v: Vec2): vec2(0.0, -9.8)
    r: (Vec2, Vec2) = rk4_step(vec2(0.0, 0.0), vec2(10.0, 10.0), acc, 0.1)
    r.0.x > 0.0
---
pure func rk4_step(
	pos: Vec2,
	vel: Vec2,
	acc_fn: pure (Vec2, Vec2) -> Vec2,
	dt: Float,
) -> (Vec2, Vec2):
	-- k1
	a1: Vec2 = acc_fn(pos, vel)
	v1: Vec2 = vel

	-- k2
	p2: Vec2 = vec2_add(pos, vec2_scale(v1, dt * 0.5))
	v2: Vec2 = vec2_add(vel, vec2_scale(a1, dt * 0.5))
	a2: Vec2 = acc_fn(p2, v2)

	-- k3
	p3: Vec2 = vec2_add(pos, vec2_scale(v2, dt * 0.5))
	v3: Vec2 = vec2_add(vel, vec2_scale(a2, dt * 0.5))
	a3: Vec2 = acc_fn(p3, v3)

	-- k4
	p4: Vec2 = vec2_add(pos, vec2_scale(v3, dt))
	v4: Vec2 = vec2_add(vel, vec2_scale(a3, dt))
	a4: Vec2 = acc_fn(p4, v4)

	-- Combine
	vel_sum: Vec2 = vec2_add(vec2_add(v1, vec2_scale(v2, 2.0)), vec2_add(vec2_scale(v3, 2.0), v4))
	acc_sum: Vec2 = vec2_add(vec2_add(a1, vec2_scale(a2, 2.0)), vec2_add(vec2_scale(a3, 2.0), a4))
	new_pos: Vec2 = vec2_add(pos, vec2_scale(vel_sum, dt / 6.0))
	new_vel: Vec2 = vec2_add(vel, vec2_scale(acc_sum, dt / 6.0))
	(new_pos, new_vel)


-- Forces
---
Gravity force (downward). Returns (0, mass * g).
Convention: positive g means downward force.

doctests:
    :: Gravity on unit mass
    f: Vec2 = gravity_force(1.0, 9.8)
    f.y.approx_eq(9.8)
---
pure func gravity_force(mass: Float, g: Float) -> Vec2:
	vec2(0.0, mass * g)


---
Spring force (Hooke's law) pulling position toward anchor.

doctests:
    :: Spring pulls back toward anchor
    f: Vec2 = spring_force(vec2(2.0, 0.0), vec2(0.0, 0.0), 1.0, 0.0)
    f.x < 0.0
---
pure func spring_force(
	pos: Vec2,
	anchor: Vec2,
	k: Float,
	rest_length: Float,
) -> Vec2:
	diff: Vec2 = vec2_sub(anchor, pos)
	dist: Float = vec2_length(diff)
	if dist == 0.0:
		vec2(0.0, 0.0)
	else:
		stretch: Float = dist - rest_length
		dir: Vec2 = vec2_normalize(diff)
		vec2_scale(dir, k * stretch)


---
Damping force opposing velocity.

doctests:
    :: Damping opposes motion
    f: Vec2 = damping_force(vec2(10.0, 0.0), 0.5)
    f.x.approx_eq(-5.0)
---
pure func damping_force(vel: Vec2, coeff: Float) -> Vec2:
	vec2_scale(vel, -coeff)


---
Attraction force toward a target point.

doctests:
    :: Attracts toward target
    f: Vec2 = attract_force(vec2(0.0, 0.0), vec2(1.0, 0.0), 10.0)
    f.x > 0.0
---
pure func attract_force(pos: Vec2, target: Vec2, strength: Float) -> Vec2:
	diff: Vec2 = vec2_sub(target, pos)
	dist: Float = vec2_length(diff)
	if dist == 0.0:
		vec2(0.0, 0.0)
	else:
		vec2_scale(vec2_normalize(diff), strength)


-- Collision response
---
Reflect velocity off a surface with the given normal (perfect bounce).

doctests:
    :: Reflect off horizontal surface
    r: Vec2 = reflect(vec2(1.0, -1.0), vec2(0.0, 1.0))
    r.y.approx_eq(1.0)
---
pure func reflect(vel: Vec2, normal: Vec2) -> Vec2:
	d: Float = vec2_dot(vel, normal)
	vec2_sub(vel, vec2_scale(normal, 2.0 * d))


---
Bounce with energy loss (restitution 0..1, where 1 = perfect bounce).

doctests:
    :: Bounce with half restitution
    b: Vec2 = bounce(vec2(1.0, -1.0), vec2(0.0, 1.0), 0.5)
    b.y.approx_eq(0.5)
---
pure func bounce(vel: Vec2, normal: Vec2, restitution: Float) -> Vec2:
	d: Float = vec2_dot(vel, normal)
	vec2_sub(vel, vec2_scale(normal, (1.0 + restitution) * d))


---
Separate two overlapping circles by pushing them apart equally.
Returns (new_a_pos, new_b_pos).

doctests:
    :: Separate overlapping circles
    r: (Vec2, Vec2) = separate_circles(vec2(0.0, 0.0), 1.0, vec2(1.0, 0.0), 1.0)
    r.0.x < 0.0
---
pure func separate_circles(
	a_pos: Vec2,
	a_radius: Float,
	b_pos: Vec2,
	b_radius: Float,
) -> (Vec2, Vec2):
	diff: Vec2 = vec2_sub(b_pos, a_pos)
	dist: Float = vec2_length(diff)
	min_dist: Float = a_radius + b_radius
	if dist >= min_dist or dist == 0.0:
		(a_pos, b_pos)
	else:
		overlap: Float = min_dist - dist
		dir: Vec2 = vec2_normalize(diff)
		half_push: Vec2 = vec2_scale(dir, overlap * 0.5)
		(vec2_sub(a_pos, half_push), vec2_add(b_pos, half_push))


-- Utilities
---
Move current position toward target by at most max_delta distance.

doctests:
    :: Move toward target with limit
    v: Vec2 = move_toward(vec2(0.0, 0.0), vec2(10.0, 0.0), 3.0)
    v.x.approx_eq(3.0)
---
pure func move_toward(current: Vec2, target: Vec2, max_delta: Float) -> Vec2:
	diff: Vec2 = vec2_sub(target, current)
	dist: Float = vec2_length(diff)
	if dist <= max_delta or dist == 0.0:
		target
	else:
		vec2_add(current, vec2_scale(vec2_normalize(diff), max_delta))


---
Critically damped spring smoothing for a single Float value.
Returns (new_value, new_velocity).

doctests:
    :: Smooth damp moves toward target
    r: (Float, Float) = smooth_damp(0.0, 10.0, 0.0, 0.5, 0.016)
    r.0 > 0.0
---
pure func smooth_damp(
	current: Float,
	target: Float,
	vel: Float,
	smooth_time: Float,
	dt: Float,
) -> (Float, Float):
	omega: Float = 2.0 / smooth_time
	x: Float = omega * dt
	exp_factor: Float = 1.0 / (1.0 + x + 0.48 * x * x + 0.235 * x * x * x)
	change: Float = current - target
	new_vel: Float = (vel + omega * change) * exp_factor
	new_val: Float = target + (change + dt * vel) * exp_factor
	(new_val, new_vel)
