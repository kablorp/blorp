-- Time - Date and time operations ( POSIX-time-centric)
--
-- Time is represented as an Int (POSIX microseconds since epoch).
-- Pure functions extract calendar parts. No DateTime record needed.
-- All extraction and formatting functions assume UTC.
-- ============================================================================
-- Current Time (impure — non-deterministic)
-- ============================================================================
---
Get current wall-clock time in microseconds since POSIX epoch.
Impure: returns a different value each time it's called.
---
func now() -> Int:
	builtin("blorp_time_now")


-- ============================================================================
-- Calendar Part Extraction (all pure, all UTC)
-- ============================================================================
---
Extract year from POSIX microseconds (e.g. 2026).
---
pure func to_year(us: Int) -> Int:
	builtin("blorp_time_to_year")


---
Extract month from POSIX microseconds (1-12).
---
pure func to_month(us: Int) -> Int:
	builtin("blorp_time_to_month")


---
Extract day of month from POSIX microseconds (1-31).
---
pure func to_day(us: Int) -> Int:
	builtin("blorp_time_to_day")


---
Extract hour from POSIX microseconds (0-23).
---
pure func to_hour(us: Int) -> Int:
	builtin("blorp_time_to_hour")


---
Extract minute from POSIX microseconds (0-59).
---
pure func to_minute(us: Int) -> Int:
	builtin("blorp_time_to_minute")


---
Extract second from POSIX microseconds (0-59).
---
pure func to_second(us: Int) -> Int:
	builtin("blorp_time_to_second")


---
Extract day of week from POSIX microseconds (0=Sun, 1=Mon, ..., 6=Sat).
---
pure func to_weekday(us: Int) -> Int:
	builtin("blorp_time_to_weekday")


-- ============================================================================
-- Construction and Conversion
-- ============================================================================
---
Construct POSIX microseconds from calendar parts (UTC).
---
pure func from_parts(year: Int, month: Int, day: Int, hour: Int, minute: Int, second: Int) -> Int:
	builtin("blorp_time_from_parts")


---
Format timestamp using strftime codes (e.g. "%Y-%m-%d %H:%M:%S").

doctests:
    :: Format date
    t: Int = from_parts(
        2026,
        1,
        15,
        10,
        30,
        0,
    )
    format_time(t, "%Y-%m-%d") == "2026-01-15"
---
pure func format_time(us: Int, fmt: String) -> String:
	builtin("blorp_time_format")


---
Parse date string using strptime codes.
Returns Some(microseconds) on success, None on failure.

doctests:
    :: Parse valid date
    match parse_time("2026-01-15", "%Y-%m-%d"):
        Some(_): True
        None: False
---
pure func parse_time(s: String, fmt: String) -> Option[Int]:
	builtin("blorp_time_parse")


-- ============================================================================
-- Duration Constants (microseconds)
-- ============================================================================
---
Convert seconds to microseconds.

doctests:
    :: One second in microseconds
    seconds(1) == 1000000
---
pure func seconds(n: Int) -> Int:
	n * 1000000


---
Convert minutes to microseconds.

doctests:
    :: One minute in microseconds
    minutes(1) == 60000000
---
pure func minutes(n: Int) -> Int:
	n * 60000000


---
Convert hours to microseconds.

doctests:
    :: One hour in microseconds
    hours(1) == 3600000000
---
pure func hours(n: Int) -> Int:
	n * 3600000000


-- ============================================================================
-- Convenience Formatting
-- ============================================================================
---
Format as ISO 8601 string (UTC).

doctests:
    :: Format as ISO 8601
    t: Int = from_parts(
        2026,
        6,
        15,
        12,
        0,
        0,
    )
    to_iso(t) == "2026-06-15T12:00:00Z"
---
pure func to_iso(us: Int) -> String:
	format_time(us, "%Y-%m-%dT%H:%M:%SZ")


-- ============================================================================
-- Duration Constructors (additional)
-- ============================================================================
---
Convert days to microseconds.

doctests:
    :: One day
    days(1) == 86400000000

    :: One week
    days(7) == 604800000000
---
pure func days(n: Int) -> Int:
	n * 86400000000


---
Convert weeks to microseconds.

doctests:
    :: One week
    weeks(1) == days(7)

    :: Two weeks
    weeks(2) == days(14)
---
pure func weeks(n: Int) -> Int:
	n * 604800000000


-- ============================================================================
-- Unix Timestamp Interop
-- ============================================================================
---
Convert POSIX microseconds to Unix seconds.

doctests:
    :: Convert
    to_unix_seconds(1000000) == 1
---
pure func to_unix_seconds(us: Int) -> Int:
	us / 1000000


---
Convert Unix seconds to POSIX microseconds.

doctests:
    :: Convert
    from_unix_seconds(1) == 1000000
---
pure func from_unix_seconds(s: Int) -> Int:
	s * 1000000


---
Convert POSIX microseconds to Unix milliseconds.

doctests:
    :: Convert
    to_unix_millis(1000000) == 1000
---
pure func to_unix_millis(us: Int) -> Int:
	us / 1000


---
Convert Unix milliseconds to POSIX microseconds.

doctests:
    :: Convert
    from_unix_millis(1000) == 1000000
---
pure func from_unix_millis(ms: Int) -> Int:
	ms * 1000


-- ============================================================================
-- ISO 8601 Parsing
-- ============================================================================
---
Parse an ISO 8601 / RFC 3339 date string to POSIX microseconds.
Handles: "2024-01-15T10:30:00Z", "2024-01-15T10:30:00+05:30",
"2024-01-15T10:30:00.123Z", "2024-01-15" (date-only, midnight UTC).
Returns None on invalid input.

doctests:
    :: Basic UTC
    match from_iso("2026-06-15T12:00:00Z"):
        Some(t): to_iso(t) == "2026-06-15T12:00:00Z"
        None: False

    :: Date only
    match from_iso("2026-06-15"):
        Some(t): to_year(t) == 2026 and to_month(t) == 6 and to_day(t) == 15
        None: False

    :: Invalid
    match from_iso("not-a-date"):
        Some(_): False
        None: True
---
pure func from_iso(s: String) -> Option[Int]:
	builtin("blorp_time_from_iso")


-- ============================================================================
-- Truncation Functions
-- ============================================================================
---
Truncate to start of day (midnight UTC).

doctests:
    :: Truncate afternoon
    t: Int = from_parts(
        2026,
        3,
        15,
        14,
        30,
        45,
    )
    to_hour(start_of_day(t)) == 0 and to_minute(start_of_day(t)) == 0
---
pure func start_of_day(us: Int) -> Int:
	from_parts(
		to_year(us),
		to_month(us),
		to_day(us),
		0,
		0,
		0,
	)


---
Truncate to start of month (1st day, midnight UTC).

doctests:
    :: Truncate mid-month
    t: Int = from_parts(
        2026,
        7,
        22,
        14,
        30,
        0,
    )
    to_day(start_of_month(t)) == 1 and to_hour(start_of_month(t)) == 0
---
pure func start_of_month(us: Int) -> Int:
	from_parts(
		to_year(us),
		to_month(us),
		1,
		0,
		0,
		0,
	)


---
Truncate to start of year (Jan 1, midnight UTC).

doctests:
    :: Truncate mid-year
    t: Int = from_parts(
        2026,
        11,
        22,
        14,
        30,
        0,
    )
    to_month(start_of_year(t)) == 1 and to_day(start_of_year(t)) == 1
---
pure func start_of_year(us: Int) -> Int:
	from_parts(
		to_year(us),
		1,
		1,
		0,
		0,
		0,
	)


-- ============================================================================
-- Weekday Name
-- ============================================================================
---
Get the name of the day of the week.

doctests:
    :: Known day
    weekday_name(
        from_parts(
            2024,
            1,
            8,
            0,
            0,
            0,
        ),
    ) == "Monday"
---
pure func weekday_name(us: Int) -> String:
	wd: Int = to_weekday(us)
	match wd:
		0: "Sunday"
		1: "Monday"
		2: "Tuesday"
		3: "Wednesday"
		4: "Thursday"
		5: "Friday"
		_: "Saturday"


-- ============================================================================
-- Date Arithmetic
-- ============================================================================
---
Add n days to a timestamp.

doctests:
    :: Add 1 day
    t: Int = from_parts(
        2024,
        1,
        1,
        0,
        0,
        0,
    )
    t2: Int = add_days(t, 1)
    to_day(t2) == 2
---
pure func add_days(us: Int, n: Int) -> Int:
	us + n * 86400000000


---
Add n hours to a timestamp.
---
pure func add_hours(us: Int, n: Int) -> Int:
	us + n * 3600000000


---
Add n minutes to a timestamp.
---
pure func add_minutes(us: Int, n: Int) -> Int:
	us + n * 60000000


---
Add n seconds to a timestamp.
---
pure func add_seconds(us: Int, n: Int) -> Int:
	us + n * 1000000


---
Add n months to a timestamp. Clamps day if target month is shorter.
---
pure func add_months(us: Int, n: Int) -> Int:
	y: Int = to_year(us)
	m: Int = to_month(us)
	d: Int = to_day(us)
	h: Int = to_hour(us)
	mi: Int = to_minute(us)
	s: Int = to_second(us)
	total_months: Int = y * 12 + m - 1 + n
	var new_year: Int = total_months / 12
	var new_month: Int = total_months % 12 + 1
	if new_month <= 0:
		new_month += 12
		new_year -= 1
	max_day: Int = days_in_month(new_year, new_month)
	new_day: Int = if d > max_day:
		max_day
	else:
		d
	from_parts(
		new_year,
		new_month,
		new_day,
		h,
		mi,
		s,
	)


---
Add n years to a timestamp.
---
pure func add_years(us: Int, n: Int) -> Int:
	add_months(us, n * 12)


---
Difference between two timestamps in days (truncated).
---
pure func diff_days(a: Int, b: Int) -> Int:
	(a - b) / 86400000000


---
Check if a year is a leap year.

doctests:
    :: 2024 is a leap year
    is_leap_year(2024) == True

    :: 2023 is not
    is_leap_year(2023) == False
---
pure func is_leap_year(year: Int) -> Bool:
	if year % 400 == 0:
		True
	else if year % 100 == 0:
		False
	else:
		year % 4 == 0


---
Number of days in a given month (1-12) for a given year.

doctests:
    :: February in leap year
    days_in_month(2024, 2) == 29

    :: January
    days_in_month(2024, 1) == 31
---
pure func days_in_month(year: Int, month: Int) -> Int:
	match month:
		1: 31
		2:
			if is_leap_year(year):
				29
			else:
				28
		3: 31
		4: 30
		5: 31
		6: 30
		7: 31
		8: 31
		9: 30
		10: 31
		11: 30
		_: 31


---
Month name from number (1-12).

doctests:
    :: January
    month_name(1) == "January"
---
pure func month_name(month: Int) -> String:
	match month:
		1: "January"
		2: "February"
		3: "March"
		4: "April"
		5: "May"
		6: "June"
		7: "July"
		8: "August"
		9: "September"
		10: "October"
		11: "November"
		_: "December"
