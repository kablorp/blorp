-- UInt64 - Trait Implementations
--
-- Unsigned 64-bit integer type.
type UInt64 = builtin


implements Stringable for UInt64:
	pure func to_string(val: UInt64) -> String:
		builtin("blorp_to_string")


implements Equatable for UInt64:
	pure func equals(a: UInt64, b: UInt64) -> Bool:
		a == b

	pure func not_equals(a: UInt64, b: UInt64) -> Bool:
		a != b


implements Orderable for UInt64:
	pure func less_than(a: UInt64, b: UInt64) -> Bool:
		a < b

	pure func greater_than(a: UInt64, b: UInt64) -> Bool:
		a > b

	pure func less_than_or_equal(a: UInt64, b: UInt64) -> Bool:
		a <= b

	pure func greater_than_or_equal(a: UInt64, b: UInt64) -> Bool:
		a >= b


implements Bounded for UInt64:
	pure func min(a: UInt64, b: UInt64) -> UInt64:
		match a < b:
			True: a
			_: b

	pure func max(a: UInt64, b: UInt64) -> UInt64:
		match a > b:
			True: a
			_: b


implements HasZero for UInt64:
	pure func zero() -> UInt64:
		to_uint64(0)


implements HasOne for UInt64:
	pure func one() -> UInt64:
		to_uint64(1)


implements ToBool for UInt64:
	pure func to_bool(val: UInt64) -> Bool:
		val != to_uint64(0)


implements ToInt for UInt64:
	pure func to_int(val: UInt64) -> Int:
		to_int(val)


implements Addable for UInt64:
	pure func add(a: UInt64, b: UInt64) -> UInt64:
		a + b


implements Subtractable for UInt64:
	pure func subtract(a: UInt64, b: UInt64) -> UInt64:
		a - b


implements Multipliable for UInt64:
	pure func multiply(a: UInt64, b: UInt64) -> UInt64:
		a * b


implements Divisible for UInt64:
	pure func divide(a: UInt64, b: UInt64) -> UInt64:
		a / b


implements Modulable for UInt64:
	pure func remainder(a: UInt64, b: UInt64) -> UInt64:
		a % b


implements Absolute for UInt64:
	pure func abs(val: UInt64) -> UInt64:
		val
