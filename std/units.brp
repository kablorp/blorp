-- ============================================================================
-- Audio
-- ============================================================================
struct Hz {
	value: Float
}


struct Db {
	value: Float
}


struct Amplitude {
	value: Float
}


struct Samples {
	value: Int
}


struct MidiNote {
	value: Int
}


---
Create a Hz (frequency) value.

doctests:
    :: Create Hz
    f: Hz = hz(440.0)
    f.value == 440.0
---
pure func hz(v: Float) -> Hz:
	{
		value = v
	}


---
Create a Db (decibels) value.

doctests:
    :: Create dB
    d: Db = db(-6.0)
    d.value == -6.0
---
pure func db(v: Float) -> Db:
	{
		value = v
	}


---
Create an Amplitude value (linear, typically 0.0-1.0).

doctests:
    :: Create amplitude
    a: Amplitude = amp(0.5)
    a.value == 0.5
---
pure func amp(v: Float) -> Amplitude:
	{
		value = v
	}


---
Create a Samples value (audio sample count).

doctests:
    :: Create samples
    s: Samples = samples(4410)
    s.value == 4410
---
pure func samples(v: Int) -> Samples:
	{
		value = v
	}


---
Create a MidiNote value (0-127).

doctests:
    :: Middle C
    n: MidiNote = midi(60)
    n.value == 60
---
pure func midi(v: Int) -> MidiNote:
	{
		value = v
	}


-- Audio conversions
---
Convert linear amplitude to decibels.

doctests:
    :: Unity gain is 0 dB
    d: Db = amp_to_db(amp(1.0))
    d.value == 0.0
---
pure func amp_to_db(a: Amplitude) -> Db:
	if a.value <= 0.0:
		{
			value = -120.0
		}
	else:
		{
			value = 20.0 * log10(a.value)
		}


---
Convert decibels to linear amplitude.

doctests:
    :: 0 dB is unity gain
    a: Amplitude = db_to_amp(db(0.0))
    a.value == 1.0
---
pure func db_to_amp(d: Db) -> Amplitude:
	{
		value = pow(10.0, d.value / 20.0)
	}


---
Convert a MIDI note number to frequency in Hz.

doctests:
    :: A4 (MIDI 69) is 440 Hz
    f: Hz = midi_to_hz(midi(69))
    f.value == 440.0
---
pure func midi_to_hz(note: MidiNote) -> Hz:
	{
		value = 440.0 * pow(2.0, to_float(note.value - 69) / 12.0)
	}


---
Convert a frequency in Hz to the nearest MIDI note number.

doctests:
    :: 440 Hz is MIDI 69
    n: MidiNote = hz_to_midi(hz(440.0))
    n.value == 69
---
pure func hz_to_midi(freq: Hz) -> MidiNote:
	{
		value = to_int(round(12.0 * log(freq.value / 440.0) / log(2.0) + 69.0))
	}


---
Convert frequency to period in seconds.

doctests:
    :: 1000 Hz has 1 ms period
    p: Seconds = hz_to_period(hz(1000.0))
    p.value == 0.001
---
pure func hz_to_period(freq: Hz) -> Seconds:
	{
		value = 1.0 / freq.value
	}


---
Convert period to frequency.

doctests:
    :: 0.001 s period is 1000 Hz
    f: Hz = period_to_hz(sec(0.001))
    f.value == 1000.0
---
pure func period_to_hz(period: Seconds) -> Hz:
	{
		value = 1.0 / period.value
	}


---
Convert a time in seconds to sample count at a given sample rate.

doctests:
    :: 0.1 seconds at 44100 Hz
    s: Samples = sec_to_samples(sec(0.1), hz(44100.0))
    s.value == 4410
---
pure func sec_to_samples(t: Seconds, rate: Hz) -> Samples:
	{
		value = to_int(t.value * rate.value)
	}


---
Convert sample count to time in seconds at a given sample rate.

doctests:
    :: 44100 samples at 44100 Hz is 1 second
    t: Seconds = samples_to_sec(samples(44100), hz(44100.0))
    t.value == 1.0
---
pure func samples_to_sec(s: Samples, rate: Hz) -> Seconds:
	{
		value = to_float(s.value) / rate.value
	}


