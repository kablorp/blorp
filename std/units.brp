	pure func greater_than(a: Seconds, b: Seconds) -> Bool:
		a.value > b.value

	pure func less_than_or_equal(a: Seconds, b: Seconds) -> Bool:
		a.value <= b.value

	pure func greater_than_or_equal(a: Seconds, b: Seconds) -> Bool:
		a.value >= b.value


implements Stringable for Seconds:
