-- Duration (integer microseconds)
---
Create a Duration from microseconds.

doctests:
    :: Create duration
    d: Duration = microseconds(1500)
    d.us == 1500
---
pure func microseconds(n: Int) -> Duration:
	{
		us = n
	}


---
Create a Duration from milliseconds.

doctests:
    :: 100 ms in microseconds
    d: Duration = from_milliseconds(100)
    d.us == 100000
---
pure func from_milliseconds(n: Int) -> Duration:
	{
		us = n * 1000
	}


---
Create a Duration from seconds.

doctests:
    :: 2 seconds in microseconds
    d: Duration = from_seconds(2)
    d.us == 2000000
---
pure func from_seconds(n: Int) -> Duration:
	{
		us = n * 1000000
	}


---
Create a Duration from minutes.

doctests:
    :: 2 minutes in microseconds
    d: Duration = from_minutes(2)
    d.us == 120000000
---
pure func from_minutes(n: Int) -> Duration:
	{
		us = n * 60000000
	}


---
Create a Duration from hours.

doctests:
    :: 1 hour in microseconds
    d: Duration = from_hours(1)
    d.us == 3600000000
---
pure func from_hours(n: Int) -> Duration:
	{
		us = n * 3600000000
	}


---
Create a Duration from days.

doctests:
    :: 1 day in microseconds
    d: Duration = from_days(1)
    d.us == 86400000000
---
pure func from_days(n: Int) -> Duration:
	{
		us = n * 86400000000
	}


---
Create a Duration from weeks.

doctests:
    :: 1 week in microseconds
    d: Duration = from_weeks(1)
    d.us == 604800000000
---
pure func from_weeks(n: Int) -> Duration:
	{
		us = n * 604800000000
	}


---
Return the raw microsecond value for a Duration.

doctests:
    :: Duration to microseconds
    to_microseconds(from_milliseconds(3)) == 3000
---
pure func to_microseconds(d: Duration) -> Int:
	d.us


---
Convert a Duration to a non-negative millisecond count for timeout APIs.
Positive sub-millisecond durations round up to 1 ms so they do not collapse
into an immediate poll. Non-positive durations return 0.

doctests:
    :: Sub-millisecond timeout rounds up
    to_timeout_milliseconds(microseconds(1)) == 1

    :: Exact millisecond is unchanged
    to_timeout_milliseconds(microseconds(1000)) == 1

    :: Non-positive timeout is immediate
    to_timeout_milliseconds(microseconds(-1)) == 0
---
pure func to_timeout_milliseconds(d: Duration) -> Int:
	if d.us <= 0:
		0
	else:
		whole_ms: Int = d.us / 1000
		if d.us % 1000 == 0:
			whole_ms
		else:
			whole_ms + 1


---
Convert Duration to seconds as Float.

doctests:
    :: 1500000 us is 1.5 seconds
    dur_to_seconds(microseconds(1500000)) == 1.5
---
pure func dur_to_seconds(d: Duration) -> Float:
	to_float(d.us) / 1000000.0


---
Convert Duration to Seconds unit type.

doctests:
    :: Duration to Seconds
    s: Seconds = dur_to_sec(microseconds(2000000))
    s.value == 2.0
---
pure func dur_to_sec(d: Duration) -> Seconds:
	{
		value = to_float(d.us) / 1000000.0
	}


---
Convert Seconds to Duration.

doctests:
    :: Seconds to Duration
    d: Duration = sec_to_dur(sec(1.5))
    d.us == 1500000
---
pure func sec_to_dur(s: Seconds) -> Duration:
	{
		us = to_int(s.value * 1000000.0)
	}


---
Format a Duration in human-readable form, auto-selecting the best unit.

doctests:
    :: Format large duration
    format_duration(from_seconds(3)) == "3 s"

    :: Format milliseconds
    format_duration(from_milliseconds(150)) == "150 ms"

    :: Format microseconds
    format_duration(microseconds(42)) == "42 us"
---
pure func format_duration(d: Duration) -> String:
	if d.us >= 1000000:
		(to_float(d.us) / 1000000.0).to_string() + " s"
	else if d.us >= 1000:
		(to_float(d.us) / 1000.0).to_string() + " ms"
	else:
		d.us.to_string() + " us"


implements Addable for Duration:
	pure func add(a: Duration, b: Duration) -> Duration:
		{
			us = a.us + b.us
		}


implements Subtractable for Duration:
	pure func subtract(a: Duration, b: Duration) -> Duration:
		{
			us = a.us - b.us
		}


implements Negatable for Duration:
	pure func negate(a: Duration) -> Duration:
		{
			us = -a.us
		}


implements Equatable for Duration:
	pure func equals(a: Duration, b: Duration) -> Bool:
		a.us == b.us


implements Orderable for Duration:
	pure func less_than(a: Duration, b: Duration) -> Bool:
		a.us < b.us

	pure func greater_than(a: Duration, b: Duration) -> Bool:
		a.us > b.us

	pure func less_than_or_equal(a: Duration, b: Duration) -> Bool:
		a.us <= b.us

	pure func greater_than_or_equal(a: Duration, b: Duration) -> Bool:
		a.us >= b.us


implements Stringable for Duration:
	pure func to_string(d: Duration) -> String:
		format_duration(d)


