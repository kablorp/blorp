-- Compiler executable support.
--
-- Ordinary programs receive empty source values. The Blorp compiler executable
-- links a generated provider containing the exact runtime translation unit and
-- declarations used for artifact writing and runtime-object compilation.

private pure func compiler_runtime_source_raw() -> String:
	builtin("blorp_compiler_runtime_source")


private pure func compiler_runtime_declarations_raw() -> String:
	builtin("blorp_compiler_runtime_decl")


record CompilerRuntimeSources {
	runtime: String,
	declarations: String
}


pure func compiler_runtime_sources() -> CompilerRuntimeSources:
	{
		runtime = compiler_runtime_source_raw(),
		declarations = compiler_runtime_declarations_raw()
	}
