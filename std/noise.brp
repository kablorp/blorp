-- Noise - Procedural noise functions for terrain, textures, and effects.
--
-- Provides value noise and Perlin noise in 1D, 2D, and 3D.
-- All functions are pure and deterministic.
import:
	float: floor, lerp


private NOISE_HASH_MULTIPLIER: Int = 1103515245

private NOISE_HASH_INCREMENT: Int = 12345

private NOISE_HASH_SHIFT_DIVISOR: Int = 65536

private NOISE_HASH_MODULUS: Int = 32768

private VALUE_NOISE_BUCKETS: Int = 10000

private VALUE_NOISE_BUCKETS_FLOAT: Float = 10000.0

private VALUE_NOISE_Y_STRIDE: Int = 57

private VALUE_NOISE_Z_STRIDE: Int = 113


-- ============================================================================
-- Hash (internal)
-- ============================================================================
-- Integer hash for noise permutation
private pure func noise_hash(n: Int) -> Int:
	var h: Int = n
	h = (h * NOISE_HASH_MULTIPLIER + NOISE_HASH_INCREMENT) / NOISE_HASH_SHIFT_DIVISOR % NOISE_HASH_MODULUS
	h = h * NOISE_HASH_MULTIPLIER + NOISE_HASH_INCREMENT
	if h < 0:
		0 - h
	else:
		h


private pure func unit_noise_value(cell: Int) -> Float:
	to_float(noise_hash(cell) % VALUE_NOISE_BUCKETS) / VALUE_NOISE_BUCKETS_FLOAT


private pure func value_noise_cell_2d(xi: Int, yi: Int) -> Int:
	xi + yi * VALUE_NOISE_Y_STRIDE


private pure func value_noise_cell_3d(xi: Int, yi: Int, zi: Int) -> Int:
	xi + yi * VALUE_NOISE_Y_STRIDE + zi * VALUE_NOISE_Z_STRIDE


-- ============================================================================
-- Value Noise
-- ============================================================================
---
1D value noise. Returns a smooth random value in [0, 1] for any input.
Continuous and deterministic.

doctests:
    :: Deterministic
    value_noise_1d(5.5) == value_noise_1d(5.5)

    :: In range
    value_noise_1d(3.7) >= 0.0
---
pure func value_noise_1d(x: Float) -> Float:
	xi: Int = to_int(floor(x))
	xf: Float = x - to_float(xi)
	t: Float = xf * xf * (3.0 - 2.0 * xf)
	a: Float = unit_noise_value(xi)
	b: Float = unit_noise_value(xi + 1)
	lerp(a, b, t)


---
2D value noise. Returns smooth random value in [0, 1].

doctests:
    :: Deterministic
    value_noise_2d(1.5, 2.3) == value_noise_2d(1.5, 2.3)

    :: In range
    value_noise_2d(3.7, 8.1) >= 0.0
---
pure func value_noise_2d(x: Float, y: Float) -> Float:
	xi: Int = to_int(floor(x))
	yi: Int = to_int(floor(y))
	xf: Float = x - to_float(xi)
	yf: Float = y - to_float(yi)
	tx: Float = xf * xf * (3.0 - 2.0 * xf)
	ty: Float = yf * yf * (3.0 - 2.0 * yf)
	n00: Float = unit_noise_value(value_noise_cell_2d(xi, yi))
	n10: Float = unit_noise_value(value_noise_cell_2d(xi + 1, yi))
	n01: Float = unit_noise_value(value_noise_cell_2d(xi, yi + 1))
	n11: Float = unit_noise_value(value_noise_cell_2d(xi + 1, yi + 1))
	lerp(lerp(n00, n10, tx), lerp(n01, n11, tx), ty)


---
3D value noise. Returns smooth random value in [0, 1].
---
pure func value_noise_3d(x: Float, y: Float, z: Float) -> Float:
	xi: Int = to_int(floor(x))
	yi: Int = to_int(floor(y))
	zi: Int = to_int(floor(z))
	xf: Float = x - to_float(xi)
	yf: Float = y - to_float(yi)
	zf: Float = z - to_float(zi)
	tx: Float = xf * xf * (3.0 - 2.0 * xf)
	ty: Float = yf * yf * (3.0 - 2.0 * yf)
	tz: Float = zf * zf * (3.0 - 2.0 * zf)
	n000: Float = unit_noise_value(value_noise_cell_3d(xi, yi, zi))
	n100: Float = unit_noise_value(value_noise_cell_3d(xi + 1, yi, zi))
	n010: Float = unit_noise_value(value_noise_cell_3d(xi, yi + 1, zi))
	n110: Float = unit_noise_value(value_noise_cell_3d(xi + 1, yi + 1, zi))
	n001: Float = unit_noise_value(value_noise_cell_3d(xi, yi, zi + 1))
	n101: Float = unit_noise_value(value_noise_cell_3d(xi + 1, yi, zi + 1))
	n011: Float = unit_noise_value(value_noise_cell_3d(xi, yi + 1, zi + 1))
	n111: Float = unit_noise_value(value_noise_cell_3d(xi + 1, yi + 1, zi + 1))
	x0: Float = lerp(lerp(n000, n100, tx), lerp(n010, n110, tx), ty)
	x1: Float = lerp(lerp(n001, n101, tx), lerp(n011, n111, tx), ty)
	lerp(x0, x1, tz)


-- ============================================================================
-- Fractal Brownian Motion (fBm)
-- ============================================================================
---
Fractal Brownian motion in 2D: layers multiple octaves of noise
for natural-looking terrain, clouds, etc.

octaves: number of noise layers (4-8 typical)
persistence: amplitude decay per octave (0.5 typical)

doctests:
    :: Deterministic
    fbm_2d(1.5, 2.3, 4, 0.5) == fbm_2d(1.5, 2.3, 4, 0.5)
---
pure func fbm_2d(
	x: Float,
	y: Float,
	octaves: Int,
	persistence: Float,
) -> Float:
	var total: Float = 0.0
	var amplitude: Float = 1.0
	var frequency: Float = 1.0
	var max_val: Float = 0.0
	var i: Int = 0
	while i < octaves:
		total += value_noise_2d(x * frequency, y * frequency) * amplitude
		max_val += amplitude
		amplitude *= persistence
		frequency *= 2.0
		i += 1
	total / max_val


---
Fractal Brownian motion in 3D.
---
pure func fbm_3d(
	x: Float,
	y: Float,
	z: Float,
	octaves: Int,
	persistence: Float,
) -> Float:
	var total: Float = 0.0
	var amplitude: Float = 1.0
	var frequency: Float = 1.0
	var max_val: Float = 0.0
	var i: Int = 0
	while i < octaves:
		total += value_noise_3d(x * frequency, y * frequency, z * frequency) * amplitude
		max_val += amplitude
		amplitude *= persistence
		frequency *= 2.0
		i += 1
	total / max_val
