-- Rate Limit — Pure rate limiting primitives
--
-- Token bucket and fixed window rate limiters with pure, functional state.
-- Time is passed in as microseconds (Int) — use now_microseconds() from system
-- or now() from time. State is returned, never mutated internally.
--
-- Usage:
-- import: rate_limit as RL
-- bucket: TokenBucket = RL.token_bucket(100.0, 50)
-- match RL.acquire(bucket, now_microseconds()):
-- Some(b): handle_request(b)
-- None: reject()
import:
	float: clamp


-- ============================================================================
-- Types
-- ============================================================================
---
Token bucket rate limiter. Pure state — time is passed in, not read internally.
Tokens refill continuously at refill_rate tokens per microsecond.
---
record TokenBucket {
	tokens: Float,
	max_tokens: Float,
	refill_rate: Float,
	last_refill: Int
}


---
Fixed window rate limiter. Counts requests per time window.
Simpler than token bucket but less smooth (allows bursts at window edges).
---
record FixedWindow {
	max_requests: Int,
	window_us: Int,
	current_count: Int,
	window_start: Int
}


-- ============================================================================
-- Token Bucket
-- ============================================================================
---
Create a token bucket allowing `rate` tokens per second with `burst` capacity.
Tokens refill continuously. Starts with a full bucket.

doctests:
    :: Bucket with 10 tokens/sec, burst of 10
    b: TokenBucket = token_bucket(10.0, 10)
    b.max_tokens == 10.0

    :: Burst sets initial tokens
    b: TokenBucket = token_bucket(100.0, 50)
    b.tokens == 50.0
---
pure func token_bucket(rate: Float, burst: Int) -> TokenBucket:
	-- Clamp inputs: negative rate/burst are nonsensical
	var r: Float = rate
	var b: Int = burst
	if r < 0.0:
		r = 0.0
	if b < 0:
		b = 0
	{
		tokens = to_float(b),
		max_tokens = to_float(b),
		refill_rate = r / 1000000.0,
		last_refill = 0
	}


---
Try to consume one token. Returns Some(updated_bucket) if allowed, None if denied.
Refills tokens based on elapsed time before checking.

doctests:
    :: Fresh bucket allows acquire
    b: TokenBucket = token_bucket(10.0, 10)
    match acquire(b, 1000000):
        Some(b2): b2.tokens == 9.0
        None: False

    :: Empty bucket denies
    b: TokenBucket = {
        tokens = 0.0,
        max_tokens = 10.0,
        refill_rate = 0.0,
        last_refill = 0
    }
    match acquire(b, 0):
        Some(_): False
        None: True
---
pure func acquire(bucket: TokenBucket, now_microseconds: Int) -> Option[TokenBucket]:
	acquire_n(bucket, 1, now_microseconds)


---
Try to consume N tokens. Returns Some(updated_bucket) if allowed, None if denied.

doctests:
    :: Acquire 5 from a bucket of 10
    b: TokenBucket = token_bucket(10.0, 10)
    match acquire_n(b, 5, 1000000):
        Some(b2): b2.tokens == 5.0
        None: False
---
pure func acquire_n(bucket: TokenBucket, n: Int, now_microseconds: Int) -> Option[TokenBucket]:
	refilled: TokenBucket = refill(bucket, now_microseconds)

	-- Clamp n to prevent negative acquisition (would add tokens)
	var needed: Float = to_float(n)
	if n < 0:
		needed = 0.0
	if refilled.tokens >= needed:
		Some({ refilled | tokens = refilled.tokens - needed })
	else:
		-- Explicit type annotation: blorp can't infer None's type parameter here
		opt: Option[TokenBucket] = None
		opt


---
Number of whole tokens currently available after refill.

doctests:
    :: Fresh bucket has full tokens
    b: TokenBucket = token_bucket(10.0, 10)
    remaining(b, 0) == 10
---
pure func remaining(bucket: TokenBucket, now_microseconds: Int) -> Int:
	refilled: TokenBucket = refill(bucket, now_microseconds)
	to_int(refilled.tokens)


---
Microseconds until N tokens will be available. Returns 0 if already available.
Returns a large sentinel (~2.7 hours) if refill_rate is zero (tokens will never arrive).

doctests:
    :: Already available returns 0
    b: TokenBucket = token_bucket(10.0, 10)
    wait_time(b, 5, 0) == 0
---
pure func wait_time(bucket: TokenBucket, n: Int, now_microseconds: Int) -> Int:
	refilled: TokenBucket = refill(bucket, now_microseconds)

	-- Clamp n to 0 (consistent with acquire_n)
	var needed: Float = to_float(n)
	if n < 0:
		needed = 0.0
	if refilled.tokens >= needed:
		0
	else:
		deficit: Float = needed - refilled.tokens
		if refilled.refill_rate <= 0.0:
			9999999999
		else:
			to_int(deficit / refilled.refill_rate) + 1


-- Tokens will never arrive — return a very large wait
---
Refill tokens based on elapsed time since last refill.
Caps at max_tokens. Public so callers can get refilled state without acquiring.
When time goes backward, updates last_refill to prevent starvation.
---
pure func refill(bucket: TokenBucket, now_microseconds: Int) -> TokenBucket:
	elapsed: Int = now_microseconds - bucket.last_refill
	if elapsed <= 0:
		{ bucket | last_refill = now_microseconds }
	else:
		-- Clock skew: update timestamp to prevent starvation
		added: Float = to_float(elapsed) * bucket.refill_rate
		new_tokens: Float = clamp(bucket.tokens + added, 0.0, bucket.max_tokens)
		{ bucket | tokens = new_tokens, last_refill = now_microseconds }


---
Reset a token bucket to full capacity, preserving configuration.
Sets last_refill to 0; the next refill will clamp at max_tokens (no overshoot).

doctests:
    :: Reset restores tokens to max
    b: TokenBucket = {
        tokens = 2.0,
        max_tokens = 10.0,
        refill_rate = 0.00001,
        last_refill = 500
    }
    r: TokenBucket = reset(b)
    r.tokens == 10.0
---
pure func reset(bucket: TokenBucket) -> TokenBucket:
	{ bucket | tokens = bucket.max_tokens, last_refill = 0 }


-- ============================================================================
-- Fixed Window
-- ============================================================================
---
Create a fixed window rate limiter allowing max_requests per window.
Window size is specified in seconds. The first acquire starts the first window.

doctests:
    :: Window of 100 requests per 60 seconds
    w: FixedWindow = fixed_window(100, 60)
    w.max_requests == 100

    :: Window is stored in microseconds
    w: FixedWindow = fixed_window(100, 1)
    w.window_us == 1000000
---
pure func fixed_window(max_requests: Int, window_seconds: Int) -> FixedWindow:
	-- Clamp: 0 requests = deny-all, window must be >= 1s (0s would bypass limiting)
	var mr: Int = max_requests
	var ws: Int = window_seconds
	if mr < 0:
		mr = 0
	if ws < 1:
		ws = 1
	{
		max_requests = mr,
		window_us = ws * 1000000,
		current_count = 0,
		window_start = 0
	}


---
Try to acquire one request in the current window.
Returns Some(updated_window) if allowed, None if denied.
If the current window has elapsed, resets the counter and starts a new window.

doctests:
    :: First request succeeds
    w: FixedWindow = fixed_window(10, 1)
    match acquire_window(w, 100):
        Some(w2): w2.current_count == 1
        None: False

    :: At limit is denied
    w: FixedWindow = {
        max_requests = 1,
        window_us = 1000000,
        current_count = 1,
        window_start = 0
    }
    match acquire_window(w, 500):
        Some(_): False
        None: True
---
pure func acquire_window(w: FixedWindow, now_microseconds: Int) -> Option[FixedWindow]:
	elapsed: Int = now_microseconds - w.window_start
	if elapsed >= w.window_us:
		if w.max_requests > 0:
			Some({ w | current_count = 1, window_start = now_microseconds })
		else:
			-- New window. Deny if max_requests is 0 (deny-all).
			-- Explicit type annotation: blorp can't infer None's type parameter here
			opt: Option[FixedWindow] = None
			opt
	else if w.current_count < w.max_requests:
		Some({ w | current_count = w.current_count + 1 })
	else:
		-- Explicit type annotation: blorp can't infer None's type parameter here
		opt: Option[FixedWindow] = None
		opt


---
Number of requests remaining in the current window.

doctests:
    :: Fresh window has full capacity
    w: FixedWindow = fixed_window(10, 1)
    window_remaining(w) == 10
---
pure func window_remaining(w: FixedWindow) -> Int:
	r: Int = w.max_requests - w.current_count
	if r < 0:
		0
	else:
		r


---
Microseconds until the current window resets.

doctests:
    :: Window resets in remaining time
    w: FixedWindow = {
        max_requests = 10,
        window_us = 1000000,
        current_count = 5,
        window_start = 0
    }
    window_resets_in(w, 300000) == 700000
---
pure func window_resets_in(w: FixedWindow, now_microseconds: Int) -> Int:
	r: Int = w.window_us - (now_microseconds - w.window_start)
	if r < 0:
		0
	else:
		r


---
Reset a fixed window counter, preserving configuration.
Sets window_start to 0; the next acquire will start a new window at the given time.

doctests:
    :: Reset clears counter
    w: FixedWindow = {
        max_requests = 10,
        window_us = 1000000,
        current_count = 8,
        window_start = 500
    }
    r: FixedWindow = reset_window(w)
    r.current_count == 0
---
pure func reset_window(w: FixedWindow) -> FixedWindow:
	{ w | current_count = 0, window_start = 0 }
