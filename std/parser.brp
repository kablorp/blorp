import:
	slice: StringSlice, from_string
	string: is_alpha, is_digit, is_whitespace


-- Parser Combinator Library
-- Functional parsing with composable parsers
-- Parse result: either success with value and remaining input, or failure with message
union ParseResult[T]:
	Success(T, String)
	Failure(String, String)


pure func is_success[T](result: ParseResult[T]) -> Bool:
	match result:
		Success(_, _): True
		Failure(_, _): False


pure func get_value[T](result: ParseResult[T]) -> Option[T]:
	match result:
		Success(v, _): Some(v)
		Failure(_, _): None


pure func get_remaining[T](result: ParseResult[T]) -> Option[String]:
	match result:
		Success(_, r): Some(r)
		Failure(_, _): None


pure func get_error[T](result: ParseResult[T]) -> Option[String]:
	match result:
		Success(_, _): None
		Failure(e, _): Some(e)


pure func map[A, B](
	result: ParseResult[A],
	f: pure (A) -> B,
) -> ParseResult[B]:
	match result:
		Success(v, rest): Success(f(v), rest)
		Failure(e, pos): Failure(e, pos)


pure func flat_map[A, B](
	result: ParseResult[A],
	f: pure (A, String) -> ParseResult[B],
) -> ParseResult[B]:
	match result:
		Success(v, rest): f(v, rest)
		Failure(e, pos): Failure(e, pos)


pure func is_letter(c: Char) -> Bool:
	is_alpha(c)


pure func char_to_string(c: Char) -> String:
	from_char(c)


pure func any_char(input: String) -> ParseResult[Char]:
	match input.get(0):
		Some(c): Success(c, input.substring(1, input.length()))
		None: Failure("unexpected end of input", input)


pure func satisfy(
	pred: pure (Char) -> Bool,
	input: String,
) -> ParseResult[Char]:
	match input.get(0):
		Some(c):
			if pred(c):
				Success(c, input.substring(1, input.length()))
			else:
				Failure("character did not match", input)
		None: Failure("unexpected end of input", input)


pure func char(expected: Char, input: String) -> ParseResult[Char]:
	match input.get(0):
		Some(c):
			if c == expected:
				Success(c, input.substring(1, input.length()))
			else:
				Failure("expected character", input)
		None: Failure("unexpected end of input", input)


pure func literal(expected: String, input: String) -> ParseResult[String]:
	if input.starts_with(expected):
		Success(expected, input.substring(expected.length(), input.length()))
	else:
		Failure("expected string", input)


pure func digit(input: String) -> ParseResult[Char]:
	satisfy(is_digit, input)


pure func letter(input: String) -> ParseResult[Char]:
	satisfy(is_letter, input)


pure func whitespace(input: String) -> ParseResult[Char]:
	satisfy(is_whitespace, input)


pure func or_else[A](
	p1: pure (String) -> ParseResult[A],
	p2: pure (String) -> ParseResult[A],
	input: String,
) -> ParseResult[A]:
	match p1(input):
		Success(v, rest): Success(v, rest)
		Failure(_, _): p2(input)


pure func many[A](
	parser: pure (String) -> ParseResult[A],
	input: String,
) -> ParseResult[List[A]]:
	var results: List[A] = []
	var current: String = input
	var done: Bool = False
	while not done:
		match parser(current):
			Success(v, rest):
				results = results.append(v)
				current = rest
			Failure(_, _):
				done = True
	Success(results, current)


pure func many1[A](
	parser: pure (String) -> ParseResult[A],
	input: String,
) -> ParseResult[List[A]]:
	match parser(input):
		Success(first, rest):
			var results: List[A] = [first]
			var current: String = rest
			var done: Bool = False
			while not done:
				match parser(current):
					Success(v, rest2):
						results = results.append(v)
						current = rest2
					Failure(_, _):
						done = True
			Success(results, current)
		Failure(e, pos):
			fail: ParseResult[List[A]] = Failure(e, pos)
			fail


pure func skip_whitespace(input: String) -> ParseResult[String]:
	var current: String = input
	var cont: Bool = True
	while cont:
		match current.get(0):
			Some(c):
				if is_whitespace(c):
					current = current.substring(1, current.length())
				else:
					cont = False
			None: cont = False
	Success("", current)


pure func take_while(
	pred: pure (Char) -> Bool,
	input: String,
) -> ParseResult[String]:
	var result: String = ""
	var i: Int = 0
	var cont: Bool = True
	while cont:
		match input.get(i):
			Some(c):
				if pred(c):
					result += from_char(c)
					i += 1
				else:
					cont = False
			None: cont = False
	Success(result, input.substring(i, input.length()))


pure func take_while1(
	pred: pure (Char) -> Bool,
	input: String,
) -> ParseResult[String]:
	match input.get(0):
		Some(c):
			if pred(c):
				take_while(pred, input)
			else:
				Failure("expected at least one matching character", input)
		None: Failure("expected at least one matching character", input)


pure func then[A, B](
	p1: pure (String) -> ParseResult[A],
	p2: pure (String) -> ParseResult[B],
	input: String,
) -> ParseResult[B]:
	p1(input).flat_map(pure func(_: A, rest: String): p2(rest))


pure func skip[A, B](
	p1: pure (String) -> ParseResult[A],
	p2: pure (String) -> ParseResult[B],
	input: String,
) -> ParseResult[A]:
	match p1(input):
		Success(v, rest):
			match p2(rest):
				Success(_, rest2): Success(v, rest2)
				Failure(e, pos): Failure(e, pos)
		Failure(e, pos): Failure(e, pos)


func between[A, O, C](
	open: pure (String) -> ParseResult[O],
	p: pure (String) -> ParseResult[A],
	close: pure (String) -> ParseResult[C],
	input: String,
) -> ParseResult[A]:
	match open(input):
		Success(_, rest1):
			match p(rest1):
				Success(v, rest2):
					match close(rest2):
						Success(_, rest3): Success(v, rest3)
						Failure(e, pos): Failure(e, pos)
				Failure(e, pos): Failure(e, pos)
		Failure(e, pos): Failure(e, pos)


pure func sep_by[A, S](
	item: pure (String) -> ParseResult[A],
	sep: pure (String) -> ParseResult[S],
	input: String,
) -> ParseResult[List[A]]:
	match item(input):
		Failure(_, _):
			empty: List[A] = []
			Success(empty, input)
		Success(first, rest):
			var results: List[A] = [first]
			var current: String = rest
			var done: Bool = False
			while not done:
				match sep(current):
					Success(_, sep_rest):
						match item(sep_rest):
							Success(v, item_rest):
								results = results.append(v)
								current = item_rest
							Failure(_, _):
								done = True
					Failure(_, _):
						done = True
			Success(results, current)


pure func optional[A](
	parser: pure (String) -> ParseResult[A],
	input: String,
) -> ParseResult[Option[A]]:
	match parser(input):
		Success(v, rest): Success(Some(v), rest)
		Failure(_, _):
			result: ParseResult[Option[A]] = Success(None, input)
			result


pure func end_of_input(input: String) -> ParseResult[String]:
	if input.length() == 0:
		Success("", input)
	else:
		Failure("expected end of input", input)


union SliceParseResult[T]:
	SliceSuccess(T, StringSlice)
	SliceFailure(String, StringSlice)


pure func slice_is_success[T](result: SliceParseResult[T]) -> Bool:
	match result:
		SliceSuccess(_, _): True
		SliceFailure(_, _): False


pure func slice_get_value[T](result: SliceParseResult[T]) -> Option[T]:
	match result:
		SliceSuccess(v, _): Some(v)
		SliceFailure(_, _): None


func slice_map[A, B](
	result: SliceParseResult[A],
	f: (A) -> B,
) -> SliceParseResult[B]:
pure func slice_map[A, B](
	result: SliceParseResult[A],
	f: pure (A) -> B,
) -> SliceParseResult[B]:
	match result:
		SliceSuccess(v, rest): SliceSuccess(f(v), rest)
		SliceFailure(e, pos): SliceFailure(e, pos)


pure func any_char_slice(input: StringSlice) -> SliceParseResult[Char]:
	match input.get(0):
		Some(c): SliceSuccess(c, input.substring(1, input.length() - 1))
		None: SliceFailure("unexpected end of input", input)


pure func satisfy_slice(
	pred: pure (Char) -> Bool,
	input: StringSlice,
) -> SliceParseResult[Char]:
	match input.get(0):
		Some(c):
			if pred(c):
				SliceSuccess(c, input.substring(1, input.length() - 1))
			else:
				SliceFailure("character did not match", input)
		None: SliceFailure("unexpected end of input", input)


pure func char_slice(expected: Char, input: StringSlice) -> SliceParseResult[Char]:
	match input.get(0):
		Some(c):
			if c == expected:
				SliceSuccess(c, input.substring(1, input.length() - 1))
			else:
				SliceFailure("expected character", input)
		None: SliceFailure("unexpected end of input", input)


pure func literal_slice(expected: String, input: StringSlice) -> SliceParseResult[StringSlice]:
	if input.starts_with(expected):
		matched: StringSlice = input.substring(0, expected.length())
		SliceSuccess(
			matched,
			input.substring(
				expected.length(),
				input.length() - expected.length(),
			),
		)
	else:
		SliceFailure("expected string", input)


pure func take_while_slice(
	pred: pure (Char) -> Bool,
	input: StringSlice,
) -> SliceParseResult[StringSlice]:
	var i: Int = 0
	slen: Int = input.length()
	var cont: Bool = True
	while cont:
		match input.get(i):
			Some(c):
				if pred(c):
					i += 1
				else:
					cont = False
			None: cont = False
	matched: StringSlice = input.substring(0, i)
	rest: StringSlice = input.substring(i, slen - i)
	SliceSuccess(matched, rest)


pure func take_while1_slice(
	pred: pure (Char) -> Bool,
	input: StringSlice,
) -> SliceParseResult[StringSlice]:
	match input.get(0):
		Some(c):
			if pred(c):
				take_while_slice(pred, input)
			else:
				SliceFailure("expected at least one matching character", input)
		None: SliceFailure("expected at least one matching character", input)


pure func skip_whitespace_slice(input: StringSlice) -> SliceParseResult[StringSlice]:
	var i: Int = 0
	slen: Int = input.length()
	var cont: Bool = True
	while cont:
		match input.get(i):
			Some(c):
				if is_whitespace(c):
					i += 1
				else:
					cont = False
			None: cont = False
	SliceSuccess(input.substring(0, i), input.substring(i, slen - i))


pure func slice_result_to_string_result[T](result: SliceParseResult[T]) -> ParseResult[T]:
	match result:
		SliceSuccess(v, rest): Success(v, rest.to_string())
		SliceFailure(e, pos): Failure(e, pos.to_string())


pure func to_slice(s: String) -> StringSlice:
	from_string(s)


pure func digit_slice(input: StringSlice) -> SliceParseResult[Char]:
	satisfy_slice(is_digit, input)


pure func letter_slice(input: StringSlice) -> SliceParseResult[Char]:
	satisfy_slice(is_letter, input)


pure func whitespace_slice(input: StringSlice) -> SliceParseResult[Char]:
	satisfy_slice(is_whitespace, input)
