-- Property — Property-based testing with shrinking
--
-- Generates random inputs and checks that properties hold.
-- Uses the pure SplitMix64 RNG from random — all generators are pure.
--
-- Typical use: import the generators and `check` from `property`.
--
-- func main(args: List[String]):
-- ok: Bool = check("addition is commutative", 100, gen_int(-100, 100),
-- pure func(x: Int): x + 0 == x)
-- if ok: 0 else: 1
import:
	random: rng_bool, rng_float, rng_int, rng_new
	string: string


-- ============================================================================
-- Generator Type
-- ============================================================================
-- A generator is a pure function: RNG state -> (value, new_state)
type alias Gen[T] = pure (Int) -> (T, Int)


-- ============================================================================
-- Primitive Generators
-- ============================================================================
---
Generate a random Int in [lo, hi).
---
pure func gen_int(lo: Int, hi: Int) -> Gen[Int]:
	pure func(state: Int): rng_int(state, lo, hi)


---
Generate a random Float in [0.0, 1.0).
---
pure func gen_float() -> Gen[Float]:
	pure func(state: Int): rng_float(state)


---
Generate a random Float in [min, max).
---
pure func gen_float_range(lo: Float, hi: Float) -> Gen[Float]:
	pure func(state: Int):
		r: (Float, Int) = rng_float(state)
		(lo + r.0 * (hi - lo), r.1)


---
Generate a random Bool.
---
pure func gen_bool() -> Gen[Bool]:
	pure func(state: Int): rng_bool(state)


---
Generate a constant value (always the same).
---
pure func gen_const[T](value: T) -> Gen[T]:
	pure func(state: Int): (value, state)


-- ============================================================================
-- Combinator Generators
-- ============================================================================
---
Transform a generator's output with a pure function.
---
pure func gen_map[A, B](gen: Gen[A], f: pure (A) -> B) -> Gen[B]:
	pure func(state: Int):
		r: (A, Int) = gen(state)
		(f(r.0), r.1)


---
Generate one of two values based on a random Bool.
---
pure func gen_one_of_2[T](a: Gen[T], b: Gen[T]) -> Gen[T]:
	pure func(state: Int):
		coin: (Bool, Int) = rng_bool(state)
		if coin.0:
			a(coin.1)
		else:
			b(coin.1)


---
Generate a list of random length [0, max_len) with the given element generator.
---
pure func gen_list[T](elem: Gen[T], max_len: Int) -> Gen[List[T]]:
	pure func(state: Int):
		len_result: (Int, Int) = rng_int(state, 0, max_len)
		n: Int = len_result.0
		var st: Int = len_result.1
		var result: List[T] = []
		var i: Int = 0
		while i < n:
			item: (T, Int) = elem(st)
			result = result.append(item.0)
			st = item.1
			i += 1
		(result, st)


---
Generate an Option[T] — Some(value) 75% of the time, None 25%.
---
pure func gen_option[T](inner: Gen[T]) -> Gen[Option[T]]:
	pure func(state: Int):
		r: (Int, Int) = rng_int(state, 0, 4)
		if r.0 == 0:
			(None, r.1)
		else:
			val: (T, Int) = inner(r.1)
			(Some(val.0), val.1)


---
Generate a random ASCII string of length [0, max_len).
---
pure func gen_string(max_len: Int) -> Gen[String]:
	pure func(state: Int):
		len_result: (Int, Int) = rng_int(state, 0, max_len)
		n: Int = len_result.0
		var st: Int = len_result.1
		var buf: String = string(n)
		var i: Int = 0
		while i < n:
			ch: (Int, Int) = rng_int(st, 32, 127)
			buf = buf.append_char(to_char(ch.0))
			st = ch.1
			i += 1
		(buf, st)


---
Generate a random alphanumeric string of length [0, max_len).
---
pure func gen_alphanumeric(max_len: Int) -> Gen[String]:
	pure func(state: Int):
		len_result: (Int, Int) = rng_int(state, 0, max_len)
		n: Int = len_result.0
		var st: Int = len_result.1
		chars: String = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
		var buf: String = string(n)
		var i: Int = 0
		while i < n:
			idx: (Int, Int) = rng_int(st, 0, 62)
			match chars.get(idx.0):
				Some(c): buf = buf.append_char(c)
				None: void
			st = idx.1
			i += 1
		(buf, st)


-- ============================================================================
-- Property Checking
-- ============================================================================
---
Check a property over N random inputs. Prints failures with the offending input.
Returns True if all tests pass.

doctests:
    :: Identity property passes
    check("x + 0 == x", 50, gen_int(-100, 100), pure func(x: Int): x + 0 == x)
---
func check[T:Stringable](
	name: String,
	num_tests: Int,
	gen: Gen[T],
	prop: pure (T) -> Bool,
) -> Bool:
	var state: Int = rng_new(12345)
	var passed: Int = 0
	var failed: Bool = False
	var i: Int = 0
	while i < num_tests and not failed:
		result: (T, Int) = gen(state)
		val: T = result.0
		state = result.1
		if prop(val):
			passed += 1
		else:
			print(
				"  FAIL: " + name + " — counterexample: " + to_string(
					val,
				) + " (test " + (i + 1).to_string() + ")",
			)
			failed = True
		i += 1
	if not failed:
		print("  OK: " + name + " (" + passed.to_string() + " tests)")
	not failed


---
Check a property with two random inputs.
---
func check2[A:Stringable, B:Stringable](
	name: String,
	num_tests: Int,
	gen_a: Gen[A],
	gen_b: Gen[B],
	prop: pure (A, B) -> Bool,
) -> Bool:
	var state: Int = rng_new(12345)
	var passed: Int = 0
	var failed: Bool = False
	var i: Int = 0
	while i < num_tests and not failed:
		ra: (A, Int) = gen_a(state)
		rb: (B, Int) = gen_b(ra.1)
		state = rb.1
		if prop(ra.0, rb.0):
			passed += 1
		else:
			print(
				"  FAIL: " + name + " — counterexample: (" + to_string(
					ra.0,
				) + ", " + rb.0.to_string() + ") (test " + (i + 1).to_string() + ")",
			)
			failed = True
		i += 1
	if not failed:
		print("  OK: " + name + " (" + passed.to_string() + " tests)")
	not failed


-- ============================================================================
-- Shrinking
-- ============================================================================
---
Shrink an Int toward zero. Returns a list of simpler values.
---
pure func shrink_int(n: Int) -> List[Int]:
	if n == 0:
		[]
	else:
		-- Generate candidates between 0 and n (closer to zero)
		var result: List[Int] = [0]
		var abs_n: Int = n
		if abs_n < 0:
			abs_n = 0 - abs_n
		var s: Int = abs_n / 2
		while s > 0:
			-- For positive n: candidates are n - s (between 0 and n)
			-- For negative n: candidates are n + s (between n and 0)
			if n > 0:
				result = result.append(n - s)
			else:
				result = result.append(n + s)
			s /= 2
		result


---
Check a property with shrinking on failure. Finds a minimal counterexample.
---
func check_shrink(
	name: String,
	num_tests: Int,
	gen: Gen[Int],
	prop: pure (Int) -> Bool,
) -> Bool:
	var state: Int = rng_new(12345)
	var failed: Bool = False
	var i: Int = 0
	while i < num_tests and not failed:
		result: (Int, Int) = gen(state)
		val: Int = result.0
		state = result.1
		if not prop(val):
			-- Found failure, try shrinking
			var smallest: Int = val
			candidates: List[Int] = shrink_int(val)
			var j: Int = 0
			while j < candidates.length():
				match candidates.get(j):
					Some(c):
						if not prop(c):
							smallest = c
					None: void
				j += 1
			print(
				"  FAIL: " + name + " — smallest counterexample: " + to_string(
					smallest,
				) + " (original: " + val.to_string() + ")",
			)
			failed = True
		i += 1
	if not failed:
		print("  OK: " + name + " (" + num_tests.to_string() + " tests)")
	not failed
