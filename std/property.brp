-- Property — Property-based testing with shrinking
--
-- Generates random inputs and checks that properties hold.
-- Uses the pure SplitMix64 RNG from random — all generators are pure.
--
-- Typical use: import the generators and `check` from `property`.
--
-- func main(args: List[String]):
-- ok: Bool = check("addition is commutative", 100, gen_int(-100, 100),
-- pure func(x: Int): x + 0 == x)
-- if ok: 0 else: 1
import:
	random:
		RngState,
		RngStep,
		rng_bool,
		rng_float,
		rng_int,
		rng_new,
		rng_next_state,
		rng_step,
		rng_value,
	string: string


-- ============================================================================
-- Generator Type
-- ============================================================================
-- A generator is a pure function: RNG state -> generated value and next state.
type alias Gen[T] = pure (RngState) -> RngStep[T]


-- ============================================================================
-- Primitive Generators
-- ============================================================================
---
Generate a random Int in [lo, hi).
---
pure func gen_int(lo: Int, hi: Int) -> Gen[Int]:
	pure func(state: RngState): rng_int(state, lo, hi)


---
Generate a random Float in [0.0, 1.0).
---
pure func gen_float() -> Gen[Float]:
	pure func(state: RngState): rng_float(state)


---
Generate a random Float in [min, max).
---
pure func gen_float_range(lo: Float, hi: Float) -> Gen[Float]:
	pure func(state: RngState):
		r: RngStep[Float] = rng_float(state)
		rng_step(lo + r.rng_value() * (hi - lo), r.rng_next_state())


---
Generate a random Bool.
---
pure func gen_bool() -> Gen[Bool]:
	pure func(state: RngState): rng_bool(state)


---
Generate a constant value (always the same).
---
pure func gen_const[T](value: T) -> Gen[T]:
	pure func(state: RngState): rng_step(value, state)


-- ============================================================================
-- Combinator Generators
-- ============================================================================
---
Transform a generator's output with a pure function.
---
pure func gen_map[A, B](
	gen: Gen[A],
	f: pure (A) -> B,
) -> Gen[B]:
	pure func(state: RngState):
		r: RngStep[A] = gen(state)
		rng_step(f(r.rng_value()), r.rng_next_state())


---
Generate one of two values based on a random Bool.
---
pure func gen_one_of_2[T](a: Gen[T], b: Gen[T]) -> Gen[T]:
	pure func(state: RngState):
		coin: RngStep[Bool] = rng_bool(state)
		if coin.rng_value():
			a(coin.rng_next_state())
		else:
			b(coin.rng_next_state())


---
Generate a list of random length [0, max_len) with the given element generator.
---
pure func gen_list[T](elem: Gen[T], max_len: Int) -> Gen[List[T]]:
	pure func(state: RngState):
		len_result: RngStep[Int] = rng_int(state, 0, max_len)
		n: Int = len_result.rng_value()
		var st: RngState = len_result.rng_next_state()
		var result: List[T] = []
		var i: Int = 0
		while i < n:
			item: RngStep[T] = elem(st)
			result = result.append(item.rng_value())
			st = item.rng_next_state()
			i += 1
		rng_step(result, st)


---
Generate an Option[T] — Some(value) 75% of the time, None 25%.
---
pure func gen_option[T](inner: Gen[T]) -> Gen[Option[T]]:
	pure func(state: RngState):
		r: RngStep[Int] = rng_int(state, 0, 4)
		if r.rng_value() == 0:
			rng_step(None, r.rng_next_state())
		else:
			val: RngStep[T] = inner(r.rng_next_state())
			rng_step(Some(val.rng_value()), val.rng_next_state())


---
Generate a random ASCII string of length [0, max_len).
---
pure func gen_string(max_len: Int) -> Gen[String]:
	pure func(state: RngState):
		len_result: RngStep[Int] = rng_int(state, 0, max_len)
		n: Int = len_result.rng_value()
		var st: RngState = len_result.rng_next_state()
		var buf: String = string(n)
		var i: Int = 0
		while i < n:
			ch: RngStep[Int] = rng_int(st, 32, 127)
			buf = buf.append_char(to_char(ch.rng_value()))
			st = ch.rng_next_state()
			i += 1
		rng_step(buf, st)


---
Generate a random alphanumeric string of length [0, max_len).
---
pure func gen_alphanumeric(max_len: Int) -> Gen[String]:
	pure func(state: RngState):
		len_result: RngStep[Int] = rng_int(state, 0, max_len)
		n: Int = len_result.rng_value()
		var st: RngState = len_result.rng_next_state()
		chars: String = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
		var buf: String = string(n)
		var i: Int = 0
		while i < n:
			idx: RngStep[Int] = rng_int(st, 0, 62)
			match chars.get(idx.rng_value()):
				Some(c): buf = buf.append_char(c)
				None: void
			st = idx.rng_next_state()
			i += 1
		rng_step(buf, st)


-- ============================================================================
-- Property Checking
-- ============================================================================
---
Check a property over N random inputs. Prints failures with the offending input.
Returns True if all tests pass.

doctests:
    :: Identity property passes
    check(
        "x + 0 == x",
        50,
        gen_int(
            -100,
            100,
        ),
        pure func(x: Int): x + 0 == x,
    )
---
func check[T:Stringable](
	name: String,
	num_tests: Int,
	gen: Gen[T],
	prop: pure (T) -> Bool,
) -> Bool:
	var state: RngState = rng_new(12345)
	var passed: Int = 0
	var failed: Bool = False
	var i: Int = 0
	while i < num_tests and not failed:
		result: RngStep[T] = gen(state)
		val: T = result.rng_value()
		state = result.rng_next_state()
		if prop(val):
			passed += 1
		else:
			print(
				"  FAIL: " + name + " — counterexample: " + to_string(
					val,
				) + " (test " + (i + 1).to_string() + ")",
			)
			failed = True
		i += 1
	if not failed:
		print("  OK: " + name + " (" + passed.to_string() + " tests)")
	not failed


---
Check a property with two random inputs.
---
func check2[A:Stringable, B:Stringable](
	name: String,
	num_tests: Int,
	gen_a: Gen[A],
	gen_b: Gen[B],
	prop: pure (A, B) -> Bool,
) -> Bool:
	var state: RngState = rng_new(12345)
	var passed: Int = 0
	var failed: Bool = False
	var i: Int = 0
	while i < num_tests and not failed:
		ra: RngStep[A] = gen_a(state)
		rb: RngStep[B] = gen_b(ra.rng_next_state())
		state = rb.rng_next_state()
		if prop(ra.rng_value(), rb.rng_value()):
			passed += 1
		else:
			print(
				"  FAIL: " + name + " — counterexample: (" + to_string(ra.rng_value()) + ", " + rb
					.rng_value()
					.to_string() + ") (test " + (i + 1).to_string() + ")",
			)
			failed = True
		i += 1
	if not failed:
		print("  OK: " + name + " (" + passed.to_string() + " tests)")
	not failed


-- ============================================================================
-- Shrinking
-- ============================================================================
---
Shrink an Int toward zero. Returns a list of simpler values.
---
pure func shrink_int(n: Int) -> List[Int]:
	if n == 0:
		[]
	else:
		-- Generate candidates between 0 and n (closer to zero)
		var result: List[Int] = [0]
		var abs_n: Int = n
		if abs_n < 0:
			abs_n = 0 - abs_n
		var s: Int = abs_n / 2
		while s > 0:
			-- For positive n: candidates are n - s (between 0 and n)
			-- For negative n: candidates are n + s (between n and 0)
			if n > 0:
				result = result.append(n - s)
			else:
				result = result.append(n + s)
			s /= 2
		result


---
Check a property with shrinking on failure. Finds a minimal counterexample.
---
func check_shrink(
	name: String,
	num_tests: Int,
	gen: Gen[Int],
	prop: pure (Int) -> Bool,
) -> Bool:
	var state: RngState = rng_new(12345)
	var failed: Bool = False
	var i: Int = 0
	while i < num_tests and not failed:
		result: RngStep[Int] = gen(state)
		val: Int = result.rng_value()
		state = result.rng_next_state()
		if not prop(val):
			-- Found failure, try shrinking
			var smallest: Int = val
			candidates: List[Int] = shrink_int(val)
			var j: Int = 0
			while j < candidates.length():
				match candidates.get(j):
					Some(c):
						if not prop(c):
							smallest = c
					None: void
				j += 1
			print(
				"  FAIL: " + name + " — smallest counterexample: " + to_string(
					smallest,
				) + " (original: " + val.to_string() + ")",
			)
			failed = True
		i += 1
	if not failed:
		print("  OK: " + name + " (" + num_tests.to_string() + " tests)")
	not failed
