-- Bytes - Immutable binary buffer with COW optimization
--
-- Bytes is a contiguous buffer of unsigned bytes (0-255) for binary data.
type Bytes = builtin


-- Uses ARC with COW semantics — all operations are semantically immutable.
-- Safe: all access is bounds-checked and returns Option for reads.
-- ============================================================================
-- Core Builtins
-- ============================================================================
---
Create a zero-filled Bytes buffer of the given size.

doctests:
    :: Bytes buffer has correct length
    b: Bytes = bytes(10)
    b.length() == 10
---
pure func bytes(size: Int) -> Bytes:
	builtin


-- [to_string(self: Bytes) -> String] lives below in the Stringable
-- implementation. It interprets bytes as UTF-8.
---
Get a byte at the given index.
Returns None if index is out of bounds, Some(Int) with value 0-255 otherwise.

doctests:
    :: Get valid index
    b: Bytes = "A".to_bytes()
    match b.get(0):
        Some(v): v == 65
        None: False
---
pure func get(self: Bytes, index: Int) -> Option[Int]:
	builtin


---
Set a byte at the given index (COW).
Values are clamped to 0-255. Returns the buffer unchanged if index is OOB.

doctests:
    :: Set and read back
    var b: Bytes = bytes(3)
    b = b.set_index(0, 42)
    match b.get(0):
        Some(v): v == 42
        None: False
---
pure func set_index(self: Bytes, index: Int, value: Int) -> Bytes:
	builtin


---
Extract a sub-buffer starting at `start` of length `len`.

doctests:
    :: Slice middle
    b: Bytes = "hello".to_bytes()
    s: Bytes = b.slice(1, 3)
    s.to_string() == "ell"
---
pure func slice(self: Bytes, start: Int, len: Int) -> Bytes:
	builtin


---
Append another Bytes buffer (COW).

doctests:
    :: Append two buffers
    a: Bytes = "hel".to_bytes()
    b: Bytes = "lo".to_bytes()
    c: Bytes = a.append(b)
    c.to_string() == "hello"
---
pure func append(a: Bytes, b: Bytes) -> Bytes:
	builtin


---
Get the length of a Bytes buffer.

doctests:
    :: Length of buffer
    b: Bytes = "test".to_bytes()
    b.length() == 4
---
pure func length(self: Bytes) -> Int:
	builtin


---
Fill all bytes with a value (0-255), COW.

doctests:
    :: Fill with value
    var b: Bytes = bytes(3)
    b = b.fill(255)
    match b.get(0):
        Some(v): v == 255
        None: False
---
pure func fill(self: Bytes, value: Int) -> Bytes:
	builtin


---
Bulk copy bytes from src into dst at their respective offsets.
Performs a single COW check on dst and a single memcpy.
len is clamped so neither range exceeds its buffer's bounds.

doctests:
    :: Copy region from src into dst
    src: Bytes = "hello".to_bytes()
    var dst: Bytes = bytes(5)
    dst = dst.blit(
        0,
        src,
        1,
        3,
    )
    slice_result: Bytes = dst.slice(0, 3)
    slice_result.to_string() == "ell"
---
pure func blit(
	self: Bytes,
	dst_offset: Int,
	src: Bytes,
	src_offset: Int,
	len: Int,
) -> Bytes:
	builtin


---
Find the first occurrence of a byte value starting from `start`.
Returns None if not found.

doctests:
    :: Find existing byte
    b: Bytes = "hello".to_bytes()
    b.index_of(108, 0) == Some(2)
---
pure func index_of(self: Bytes, value: Int, start: Int) -> Option[Int]:
	builtin


---
Concatenate a list of Bytes buffers into one.

doctests:
    :: Concat list
    parts: List[Bytes] = ["a".to_bytes(), "b".to_bytes(), "c".to_bytes()]
    parts
        .concat()
        .to_string() == "abc"
---
pure func concat(parts: List[Bytes]) -> Bytes:
	var total: Int = 0
	for p in parts:
		total += p.length()
	var result: Bytes = bytes(total)
	var pos: Int = 0
	for p in parts:
		result = result.blit(
			pos,
			p,
			0,
			p.length(),
		)
		pos += p.length()
	result


-- ============================================================================
-- Binary Encoding
-- ============================================================================
---
Write a 16-bit integer at offset in big-endian byte order (COW).
---
pure func write_int16_be(self: Bytes, offset: Int, value: Int) -> Bytes:
	r: Bytes = self.set_index(offset, bit_and(shift_right(value, 8), 255))
	r.set_index(offset + 1, bit_and(value, 255))


---
Write a 16-bit integer at offset in little-endian byte order (COW).
---
pure func write_int16_le(self: Bytes, offset: Int, value: Int) -> Bytes:
	r: Bytes = self.set_index(offset, bit_and(value, 255))
	r.set_index(offset + 1, bit_and(shift_right(value, 8), 255))


---
Read a 16-bit integer at offset in big-endian byte order.
Returns None if not enough bytes.
---
pure func read_int16_be(self: Bytes, offset: Int) -> Option[Int]:
	if offset < 0 or offset + 2 > self.length():
		None
	else:
		match self.get(offset):
			Some(hi):
				match self.get(offset + 1):
					Some(lo): Some(bit_or(shift_left(hi, 8), lo))
					None: None
			None: None


---
Read a 16-bit integer at offset in little-endian byte order.
Returns None if not enough bytes.
---
pure func read_int16_le(self: Bytes, offset: Int) -> Option[Int]:
	if offset < 0 or offset + 2 > self.length():
		None
	else:
		match self.get(offset):
			Some(lo):
				match self.get(offset + 1):
					Some(hi): Some(bit_or(shift_left(hi, 8), lo))
					None: None
			None: None


---
Write a 32-bit integer at offset in big-endian byte order (COW).
---
pure func write_int32_be(self: Bytes, offset: Int, value: Int) -> Bytes:
	r0: Bytes = self.set_index(offset, bit_and(shift_right(value, 24), 255))
	r1: Bytes = r0.set_index(offset + 1, bit_and(shift_right(value, 16), 255))
	r2: Bytes = r1.set_index(offset + 2, bit_and(shift_right(value, 8), 255))
	r2.set_index(offset + 3, bit_and(value, 255))


---
Write a 32-bit integer at offset in little-endian byte order (COW).
---
pure func write_int32_le(self: Bytes, offset: Int, value: Int) -> Bytes:
	r0: Bytes = self.set_index(offset, bit_and(value, 255))
	r1: Bytes = r0.set_index(offset + 1, bit_and(shift_right(value, 8), 255))
	r2: Bytes = r1.set_index(offset + 2, bit_and(shift_right(value, 16), 255))
	r2.set_index(offset + 3, bit_and(shift_right(value, 24), 255))


---
Read a 32-bit integer at offset in big-endian byte order.
Returns None if not enough bytes.
---
pure func read_int32_be(self: Bytes, offset: Int) -> Option[Int]:
	if offset < 0 or offset + 4 > self.length():
		None
	else:
		match self.get(offset):
			Some(b3):
				match self.get(offset + 1):
					Some(b2):
						match self.get(offset + 2):
							Some(b1):
								match self.get(offset + 3):
									Some(b0): Some(
										bit_or(
											bit_or(
												shift_left(
													b3,
													24,
												),
												shift_left(
													b2,
													16,
												),
											),
											bit_or(
												shift_left(
													b1,
													8,
												),
												b0,
											),
										),
									)
									None: None
							None: None
					None: None
			None: None


---
Read a 32-bit integer at offset in little-endian byte order.
Returns None if not enough bytes.
---
pure func read_int32_le(self: Bytes, offset: Int) -> Option[Int]:
	if offset < 0 or offset + 4 > self.length():
		None
	else:
		match self.get(offset):
			Some(b0):
				match self.get(offset + 1):
					Some(b1):
						match self.get(offset + 2):
							Some(b2):
								match self.get(offset + 3):
									Some(b3): Some(
										bit_or(
											bit_or(
												shift_left(
													b3,
													24,
												),
												shift_left(
													b2,
													16,
												),
											),
											bit_or(
												shift_left(
													b1,
													8,
												),
												b0,
											),
										),
									)
									None: None
							None: None
					None: None
			None: None


---
Convert Bytes to a hex string representation.
---
pure func to_hex(self: Bytes) -> String:
	hex_chars: String = "0123456789abcdef"
	blen: Int = self.length()
	var result: String = ""
	for i in 0..blen:
		match self.get(i):
			Some(b):
				result = result + hex_chars.substring(b / 16, 1) + hex_chars.substring(b % 16, 1)
			None: void
	result


---
Parse a hex string into Bytes. Returns None for invalid input.
Accepts both uppercase and lowercase hex digits.

doctests:
    :: Decode valid hex
    match from_hex("48656c6c6f"):
        Some(b): b.length() == 5
        None: False

    :: Hex round-trip
    match from_hex("4f4b"):
        Some(b): to_hex(b) == "4f4b"
        None: False

    :: Odd-length hex is invalid
    match from_hex("abc"):
        Some(_): False
        None: True

    :: Empty hex
    match from_hex(""):
        Some(b): b.length() == 0
        None: False
---
pure func from_hex(s: String) -> Option[Bytes]:
	builtin


-- ============================================================================
-- UTF-8 Encoding/Decoding
-- ============================================================================
---
Encode a list of Unicode codepoints to UTF-8 bytes.

doctests:
    :: Encode ASCII
    b: Bytes = encode_utf8(['H', 'i'])
    b.length() == 2
---
pure func encode_utf8(chars: List[Char]) -> Bytes:
	builtin


---
Decode UTF-8 bytes to a list of Unicode codepoints.
Returns None for invalid UTF-8 sequences.

doctests:
    :: Decode ASCII bytes
    match decode_utf8("Hi".to_bytes()):
        Some(chars): chars.length() == 2
        None: False

    :: Round-trip through encode/decode
    match decode_utf8(encode_utf8(['A', 'B', 'C'])):
        Some(chars): chars.length() == 3
        None: False
---
pure func decode_utf8(self: Bytes) -> Option[List[Char]]:
	builtin


-- ============================================================================
-- Trait Implementations
-- ============================================================================
implements HasLength for Bytes:
	pure func length(self: Bytes) -> Int:
		builtin


---
Convert Bytes to a String by interpreting the bytes as UTF-8.

doctests:
    :: Convert back to string
    b: Bytes = "world".to_bytes()
    b.to_string() == "world"
---
implements Stringable for Bytes:
	pure func to_string(self: Bytes) -> String:
		builtin("blorp_bytes_to_string")


-- ============================================================================
-- Convenience
-- ============================================================================
---
Check if buffer is empty.
---
pure func is_empty(self: Bytes) -> Bool:
	self.length() == 0
