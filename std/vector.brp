import:
	tensor: length


type ParallelVector[T, #N] = builtin


-- Vector - 1D array operations
--
-- This module provides 1D-specific operations: factories, HOFs, numeric builtins.
-- For generic tensor ops (length, get, set_index), see tensor.
-- ============================================================================
-- Factory
-- ============================================================================
---
Clear a vector's data to zero without reallocating.
Returns the same vector. Requires unique ownership (var vector).
---
func clear[T, #N](arr: T[#N]) -> T[#N]:
	builtin


---
Index of max element (type-dispatched).
---
pure func argmax[T:Orderable+HasZero, #N](arr: T[#N]) -> Int:
	builtin


---
Index of min element (type-dispatched).
---
pure func argmin[T:Orderable+HasZero, #N](arr: T[#N]) -> Int:
	builtin


---
Cumulative sum (type-dispatched).
---
pure func cumsum[T:Addable+HasZero, #N](arr: T[#N]) -> T[#N]:
	builtin


---
Cross product (3D Float vectors only).
---
pure func cross(a: Float[#3], b: Float[#3]) -> Float[#3]:
	builtin


-- ============================================================================
-- Scoped Parallel Pipelines
-- ============================================================================
---
Run a parallel vector pipeline.

The callback receives a ParallelVector[T, #N], which intentionally exposes only
shape-preserving parallel combinators. The result is materialized back into a
normal fixed-size vector when the callback returns.
---
pure func parallel[T, U, #N](
	self: T[#N],
	body: pure (ParallelVector[T, #N]) -> ParallelVector[U, #N],
) -> U[#N]:
	builtin


-- ============================================================================
-- Higher-Order Functions
-- ============================================================================
---
Map: apply function to each element, returns new vector.
---
func map[T, U, #N](
	arr: T[#N],
	f: (T) -> U,
) -> U[#N]:
	builtin


---
Fold: reduce array to single value with an accumulator.
---
func fold[T, Acc, #N](
	arr: T[#N],
	init: Acc,
	f: (Acc, T) -> Acc,
) -> Acc:
	var result: Acc = init
	for i in 0..arr.length():
		result = f(result, arr[i])
	result


---
Zip: combine two arrays element-wise into pairs.
---
pure func zip[T, U, #N](a: T[#N], b: U[#N]) -> (T, U)[#N]:
	builtin


---
All: check if all elements satisfy predicate.
---
func all[T, #N](
	arr: T[#N],
	pred: (T) -> Bool,
) -> Bool:
	var result: Bool = True
	for i in 0..arr.length():
		result = pred(arr[i])
		if not result:
			break
	result


---
Any: check if any element satisfies predicate.
---
func any[T, #N](
	arr: T[#N],
	pred: (T) -> Bool,
) -> Bool:
	var result: Bool = False
	for i in 0..arr.length():
		result = pred(arr[i])
		if result:
			break
	result


---
Convert vector to list.
---
pure func to_list[T, #N](arr: T[#N]) -> List[T]:
	var result: List[T] = []
	for i in 0..arr.length():
		result = result.append(arr[i])
	result


-- ============================================================================
-- Unified Numeric Operations (type-dispatched at codegen time)
-- ============================================================================
---
Sum all elements for additive numeric tensor element types.
---
pure func sum[T:Addable+HasZero, #N](arr: T[#N]) -> T:
	builtin


---
Product of all elements for multiplicative numeric tensor element types.
---
pure func product[T:Multipliable+HasOne, #N](arr: T[#N]) -> T:
	builtin


---
Max element for ordered numeric tensor element types.
---
pure func max[T:Orderable+HasZero, #N](arr: T[#N]) -> T:
	builtin


---
Min element for ordered numeric tensor element types.
---
pure func min[T:Orderable+HasZero, #N](arr: T[#N]) -> T:
	builtin


---
Mean of all elements (always returns Float).
---
pure func mean[T:Addable+HasZero+ToFloat, #N](arr: T[#N]) -> Float:
	builtin


---
Dot product for numeric tensor element types.
---
pure func dot[T:Numeric, #N](a: T[#N], b: T[#N]) -> T:
	builtin


-- ============================================================================
-- Float-specific Numeric Operations
-- ============================================================================
---
Euclidean norm (L2 norm). Float, Float32, or Float16 vectors.
---
pure func norm[T:FloatingPoint, #N](arr: T[#N]) -> T:
	builtin


---
Element-wise exp() on a float vector. Returns a new vector.
Float, Float32, or Float16.
---
pure func vector_exp[T:FloatingPoint, #N](arr: T[#N]) -> T[#N]:
	builtin


---
Element-wise log() on a float vector. Returns a new vector.
Float, Float32, or Float16.
---
pure func vector_log[T:FloatingPoint, #N](arr: T[#N]) -> T[#N]:
	builtin


---
Element-wise sqrt() on a float vector/matrix. Returns a new tensor.
Uses sqrt(abs(x)) for safety (no NaN from negative values).
Float, Float32, or Float16.
---
pure func vector_sqrt[T:FloatingPoint](arr: T[#_...]) -> T[#_...]:
	builtin


-- ============================================================================
-- Utility Operations
-- ============================================================================
---
Multiply every element by a scalar. Compiles to SIMD-accelerated C.
---
pure func scale[#N](v: Float[#N], s: Float) -> Float[#N]:
	v * s


---
Linear interpolation between two vectors. ratio=0 returns a, ratio=1 returns b.
Uses the formula a + (b - a) * ratio for numerical stability.
---
pure func lerp[#N](a: Float[#N], b: Float[#N], ratio: Float) -> Float[#N]:
	a + (b - a) * ratio
