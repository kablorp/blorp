-- Random - Random number generation
--
-- Provides deterministic pseudo-random number generation using
-- thread-local rand_r() state. Seed with seed_random() for
-- reproducible sequences.
--
-- All random functions are impure (modify internal RNG state).
--
-- For pure/deterministic random, use the rng_* functions which
-- take and return explicit state (SplitMix64 algorithm).
-- ============================================================================
-- Core Random Operations (builtins, impure)
-- ============================================================================
---
Seed the random number generator for deterministic sequences.
Call before generating random values to get reproducible results.
---
func seed_random(seed: Int) -> Void:
	builtin("blorp_seed_random")


---
Generate a random integer in [min, max) half-open range.
Empty or inverted range returns min.

doctests:
    :: Random int in range
    seed_random(42)
    x: Int = random_int(1, 7)
    x >= 1 and x < 7
---
func random_int(min: Int, max: Int) -> Int:
	builtin("blorp_random_int")


---
Generate a random float in [0.0, 1.0).

doctests:
    :: Random float in unit interval
    seed_random(42)
    x: Float = random_float()
    x >= 0.0 and x < 1.0
---
func random_float() -> Float:
	builtin("blorp_random_float")


-- ============================================================================
-- Convenience Functions (impure)
-- ============================================================================
---
Generate a random boolean (50/50 chance).

doctests:
    :: Random bool is True or False
    seed_random(42)
    b: Bool = random_bool()
    b == True or b == False
---
func random_bool() -> Bool:
	random_float() < 0.5


---
Pick a random element from a list, or None if empty.

doctests:
    :: Choice picks from list
    seed_random(42)
    items: List[Int] = [10, 20, 30]
    match choice(items):
        Some(v): v == 10 or v == 20 or v == 30
        None: False
---
func choice[T](items: List[T]) -> Option[T]:
	len: Int = items.length()
	if len == 0:
		None
	else:
		idx: Int = random_int(0, len)
		items.get(idx)


-- ============================================================================
-- Pure PRNG (SplitMix64)
-- ============================================================================
-- State is a single Int. Each call returns (value, new_state).
-- All functions are pure -- no global state mutation.
-- Uses SplitMix64 algorithm (pure bitwise arithmetic).
-- SplitMix64 mixing function
private pure func __unsigned_shift_right(x: Int, n: Int) -> Int:
	if n <= 0:
		x
	else if n >= 64:
		0
	else:
		shifted: Int = shift_right(x, n)
		if x < 0:
			shifted + shift_left(1, 64 - n)
		else:
			shifted


private pure func __splitmix64(s: Int) -> Int:
	var z: Int = s + -7046029254386353131
	z = bit_xor(z, __unsigned_shift_right(z, 30)) * -4658895280553007687
	z = bit_xor(z, __unsigned_shift_right(z, 27)) * -7723592293110705685
	bit_xor(z, __unsigned_shift_right(z, 31))


---
Create a new RNG state from a seed. Pure.

doctests:
    :: Seed creates deterministic state
    rng_new(42) == rng_new(42)
---
pure func rng_new(seed: Int) -> Int:
	seed


---
Generate the next random Int. Returns (value, new_state). Pure.

doctests:
    :: rng_next is deterministic
    r1: (Int, Int) = rng_next(rng_new(42))
    r2: (Int, Int) = rng_next(rng_new(42))
    r1.0 == r2.0
---
pure func rng_next(state: Int) -> (Int, Int):
	new_state: Int = state + -7046029254386353131
	value: Int = __splitmix64(state)
	(value, new_state)


---
Generate a random Float in [0.0, 1.0). Returns (value, new_state). Pure.

doctests:
    :: rng_float in unit interval
    r: (Float, Int) = rng_float(rng_new(42))
    r.0 >= 0.0 and r.0 < 1.0
---
pure func rng_float(state: Int) -> (Float, Int):
	new_state: Int = state + -7046029254386353131
	value: Int = __splitmix64(state)
	f: Float = to_float(__unsigned_shift_right(value, 11)) * (1.0 / 9007199254740992.0)
	(f, new_state)


---
Generate a random Int in [min, max). Returns (value, new_state). Pure.

doctests:
    :: rng_int in range
    r: (Int, Int) = rng_int(rng_new(42), 1, 100)
    r.0 >= 1 and r.0 < 100
---
pure func rng_int(state: Int, min: Int, max: Int) -> (Int, Int):
	r: (Int, Int) = rng_next(state)
	val: Int = r.0
	range: Int = max - min

	-- Make positive and mod to range
	var v: Int = val
	if v < 0:
		v = -(v + 1)
	v = v % range + min
	(v, r.1)


---
Generate a random Bool. Returns (value, new_state). Pure.

doctests:
    :: rng_bool returns Bool
    r: (Bool, Int) = rng_bool(rng_new(42))
    r.0 == True or r.0 == False
---
pure func rng_bool(state: Int) -> (Bool, Int):
	r: (Float, Int) = rng_float(state)
	(r.0 < 0.5, r.1)
