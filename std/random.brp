-- Random - Random number generation
--
-- Provides deterministic pseudo-random number generation using
-- thread-local rand_r() state. Seed with seed_random() for
-- reproducible sequences.
--
-- All random functions are impure (modify internal RNG state).
--
-- For pure/deterministic random, use the rng_* functions which
-- take and return explicit state (SplitMix64 algorithm).
-- ============================================================================
-- Core Random Operations (builtins, impure)
-- ============================================================================
---
Seed the random number generator for deterministic sequences.
Call before generating random values to get reproducible results.
---
func seed_random(seed: Int) -> Void:
	builtin("blorp_seed_random")


---
Generate a random integer in [min, max) half-open range.
Empty or inverted range returns min.

doctests:
    :: Random int in range
    seed_random(42)
    x: Int = random_int(1, 7)
    x >= 1 and x < 7
---
func random_int(min: Int, max: Int) -> Int:
	builtin("blorp_random_int")


---
Generate a random float in [0.0, 1.0).

doctests:
    :: Random float in unit interval
    seed_random(42)
    x: Float = random_float()
    x >= 0.0 and x < 1.0
---
func random_float() -> Float:
	builtin("blorp_random_float")


-- ============================================================================
-- Convenience Functions (impure)
-- ============================================================================
---
Generate a random boolean (50/50 chance).

doctests:
    :: Random bool is True or False
    seed_random(42)
    b: Bool = random_bool()
    b == True or b == False
---
func random_bool() -> Bool:
	random_float() < 0.5


---
Pick a random element from a list, or None if empty.

doctests:
    :: Choice picks from list
    seed_random(42)
    items: List[Int] = [10, 20, 30]

    match choice(items):
        Some(v): v == 10 or v == 20 or v == 30
        None: False
---
func choice[T](items: List[T]) -> Option[T]:
	len: Int = items.length()

	if len == 0:
		None
	else:
		idx: Int = random_int(0, len)
		items.get(idx)


-- ============================================================================
-- Pure PRNG (SplitMix64)
-- ============================================================================
-- State has an Int representation, but callers use RngState and RngStep.
-- All functions are pure -- no global state mutation.
-- Uses SplitMix64 algorithm (pure bitwise arithmetic).
opaque type RngState = Int

opaque type RngStep[T] = (T, RngState)

private SPLITMIX_GAMMA: Int = -7046029254386353131

private SPLITMIX_MIX_MULTIPLIER_1: Int = -4658895280553007687

private SPLITMIX_MIX_MULTIPLIER_2: Int = -7723592293110705685

private SPLITMIX_FLOAT_SHIFT: Int = 11

private SPLITMIX_FLOAT_DENOMINATOR: Float = 9007199254740992.0


---
Value produced by a pure RNG step.
---
pure func rng_value[T](step: RngStep[T]) -> T:
	parts: (T, RngState) = from RngStep[T](step)
	parts[0]


---
State to pass to the next pure RNG call.
---
pure func rng_next_state[T](step: RngStep[T]) -> RngState:
	parts: (T, RngState) = from RngStep[T](step)
	parts[1]


---
Compare two pure RNG states explicitly.
---
pure func rng_state_equal(a: RngState, b: RngState) -> Bool:
	rng_state_raw(a) == rng_state_raw(b)


---
Construct a pure RNG step from a value and next state.
Useful for custom generators built on RngState.
---
pure func rng_step[T](value: T, next_state: RngState) -> RngStep[T]:
	into RngStep[T]((value, next_state))


private pure func rng_state_raw(state: RngState) -> Int:
	from RngState(state)


private pure func rng_state_from_raw(raw: Int) -> RngState:
	into RngState(raw)


-- SplitMix64 mixing function
private pure func __unsigned_shift_right(x: Int, n: Int) -> Int:
	if n <= 0:
		x
	else if n >= 64:
		0
	else:
		shifted: Int = shift_right(x, n)

		if x < 0:
			shifted + shift_left(1, 64 - n)
		else:
			shifted


private pure func __splitmix64(s: Int) -> Int:
	var z: Int = s + SPLITMIX_GAMMA
	z = bit_xor(z, __unsigned_shift_right(z, 30)) * SPLITMIX_MIX_MULTIPLIER_1
	z = bit_xor(z, __unsigned_shift_right(z, 27)) * SPLITMIX_MIX_MULTIPLIER_2
	bit_xor(z, __unsigned_shift_right(z, 31))


---
Create a new RNG state from a seed. Pure.

doctests:
    :: Seed creates deterministic state
    rng_state_equal(rng_new(42), rng_new(42))
---
pure func rng_new(seed: Int) -> RngState:
	rng_state_from_raw(seed)


---
Generate the next random Int. Pure.

doctests:
    :: rng_next is deterministic
    r1 = rng_next(rng_new(42))
    r2 = rng_next(rng_new(42))
    r1.rng_value() == r2.rng_value()
---
pure func rng_next(state: RngState) -> RngStep[Int]:
	raw_state: Int = rng_state_raw(state)
	new_state: RngState = rng_state_from_raw(raw_state + SPLITMIX_GAMMA)
	value: Int = __splitmix64(raw_state)
	rng_step(value, new_state)


---
Generate a random Float in [0.0, 1.0). Pure.

doctests:
    :: rng_float in unit interval
    r = rng_float(rng_new(42))
    r.rng_value() >= 0.0 and r.rng_value() < 1.0
---
pure func rng_float(state: RngState) -> RngStep[Float]:
	raw_state: Int = rng_state_raw(state)
	new_state: RngState = rng_state_from_raw(raw_state + SPLITMIX_GAMMA)
	value: Int = __splitmix64(raw_state)
	f: Float = to_float(
		__unsigned_shift_right(
			value,
			SPLITMIX_FLOAT_SHIFT,
		),
	) * (1.0 / SPLITMIX_FLOAT_DENOMINATOR)
	rng_step(f, new_state)


---
Generate a random Int in [min, max). Pure.

doctests:
    :: rng_int in range
    r = rng_int(rng_new(42), 1, 100)
    r.rng_value() >= 1 and r.rng_value() < 100
---
pure func rng_int(state: RngState, min: Int, max: Int) -> RngStep[Int]:
	r: RngStep[Int] = rng_next(state)
	val: Int = r.rng_value()
	range: Int = max - min

	-- Make positive and mod to range
	var v: Int = val

	if v < 0:
		v = -(v + 1)

	v = v % range + min
	rng_step(v, r.rng_next_state())


---
Generate a random Bool. Pure.

doctests:
    :: rng_bool returns Bool
    r = rng_bool(rng_new(42))
    r.rng_value() == True or r.rng_value() == False
---
pure func rng_bool(state: RngState) -> RngStep[Bool]:
	r: RngStep[Float] = rng_float(state)
	rng_step(r.rng_value() < 0.5, r.rng_next_state())
