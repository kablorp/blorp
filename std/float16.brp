-- Float16 - Trait Implementations
--
-- 16-bit half-precision floating-point type.
type Float16 = builtin


implements Stringable for Float16:
	pure func to_string(val: Float16) -> String:
		builtin("blorp_float16_to_string")


implements Equatable for Float16:
	pure func equals(a: Float16, b: Float16) -> Bool:
		a == b

	pure func not_equals(a: Float16, b: Float16) -> Bool:
		a != b


implements Orderable for Float16:
	pure func less_than(a: Float16, b: Float16) -> Bool:
		a < b

	pure func greater_than(a: Float16, b: Float16) -> Bool:
		a > b

	pure func less_than_or_equal(a: Float16, b: Float16) -> Bool:
		a <= b

	pure func greater_than_or_equal(a: Float16, b: Float16) -> Bool:
		a >= b


implements Bounded for Float16:
	pure func min(a: Float16, b: Float16) -> Float16:
		match a < b:
			True:
				a
			_:
				b

	pure func max(a: Float16, b: Float16) -> Float16:
		match a > b:
			True:
				a
			_:
				b


implements Absolute for Float16:
	pure func abs(val: Float16) -> Float16:
		match val < to_float16(0):
			True:
				-val
			_:
				val


implements Negatable for Float16:
	pure func negate(a: Float16) -> Float16:
		-a


implements HasZero for Float16:
	pure func zero() -> Float16:
		to_float16(0)


implements HasOne for Float16:
	pure func one() -> Float16:
		to_float16(1)


implements ToBool for Float16:
	pure func to_bool(val: Float16) -> Bool:
		val != to_float16(0)


implements ToInt for Float16:
	pure func to_int(val: Float16) -> Int:
		to_int(val)


implements ToFloat for Float16:
	pure func to_float(val: Float16) -> Float:
		to_float(val)


implements Addable for Float16:
	pure func add(a: Float16, b: Float16) -> Float16:
		a + b


implements Subtractable for Float16:
	pure func subtract(a: Float16, b: Float16) -> Float16:
		a - b


implements Multipliable for Float16:
	pure func multiply(a: Float16, b: Float16) -> Float16:
		a * b


implements Divisible for Float16:
	pure func divide(a: Float16, b: Float16) -> Float16:
		a / b


implements Numeric for Float16:
	pure func __numeric_marker() -> Float16:
		to_float16(0)
-- marker trait: all methods inherited from super-traits
