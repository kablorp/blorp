-- IO - Input/Output operations
--
-- Core I/O functions for console and stdin/stdout interaction.
-- All functions are impure — I/O is an observable side effect.
---
Print a value to stdout followed by a newline.
---
func print[T:Stringable](value: T) -> Void:
	__print_string(value.to_string())


private func __print_string(s: String) -> Void:
	builtin("blorp_print")


---
Print a value to stdout without adding a newline.
---
func puts[T:Stringable](value: T) -> Void:
	__puts_string(value.to_string())


private func __puts_string(s: String) -> Void:
	builtin("blorp_puts")


---
Print a value to stderr followed by a newline. Use for diagnostics so
that normal output on stdout remains clean for pipes and redirection.
---
func err_print[T:Stringable](value: T) -> Void:
	__err_print_string(value.to_string())


private func __err_print_string(s: String) -> Void:
	builtin("blorp_err_print")


---
Read a single line from stdin, stripping the trailing newline.
Returns None at EOF, so empty user-entered lines remain distinguishable
from end-of-input. On interactive terminals, Ctrl-D returns None for that read
without making later reads immediately return EOF.
---
func read_line() -> Option[String]:
	builtin("blorp_read_line")


---
Read a single line from stdin, stripping the trailing newline.
Alias for `read_line`.
---
func read_line_opt() -> Option[String]:
	read_line()


---
Read a single line from stdin, stripping the trailing newline.
Returns an empty string at EOF.
---
func read_line_or_empty() -> String:
	builtin("blorp_read_line_or_empty")


---
Write `prompt` to stdout (without a trailing newline) and read one line
from stdin. Trailing newline on the input is stripped. Returns None at EOF.
On interactive terminals, Ctrl-D returns None for that read without making later
reads immediately return EOF.
---
func input(prompt: String) -> Option[String]:
	builtin("blorp_input")


---
Write `prompt` to stdout (without a trailing newline) and read one line
from stdin. Alias for `input`.
---
func input_opt(prompt: String) -> Option[String]:
	input(prompt)


---
Write `prompt` to stdout (without a trailing newline) and read one line
from stdin. Returns an empty string at EOF.
---
func input_or_empty(prompt: String) -> String:
	builtin("blorp_input_or_empty")
