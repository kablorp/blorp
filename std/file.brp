-- Typed file resource API foundation.
--
-- This module exposes scoped file handles through explicit capability traits.
-- `with` owns handle cleanup; operation traits describe what a handle can do.
import:
	stream: FallibleStream


---
Opaque handle for read-only file operations.
---
resource type FileReader = builtin("blorp_file_close_reader")


---
Opaque handle for write-only file operations.
---
resource type FileWriter = builtin("blorp_file_close_writer")


---
Opaque handle for append-only file operations.
---
resource type FileAppender = builtin("blorp_file_close_appender")


---
Opaque handle for read-write file operations.
---
resource type FileReadWriter = builtin("blorp_file_close_read_writer")


---
Opaque handle for read-append file operations.
---
resource type FileReadAppender = builtin("blorp_file_close_read_appender")


---
Private finalizer trait implemented by scoped file handles.

`with` blocks use compiler-owned cleanup builtins directly. This trait keeps the
runtime finalizers documented inside the module without exporting a manual
`close` operation that could conflict with scoped cleanup ownership.
---
private trait FileClosable:
	func close(handle: Self) -> Void


implements FileClosable for FileReader:
	func close(reader: FileReader) -> Void:
		builtin("blorp_file_close_reader")


implements FileClosable for FileWriter:
	func close(writer: FileWriter) -> Void:
		builtin("blorp_file_close_writer")


implements FileClosable for FileAppender:
	func close(appender: FileAppender) -> Void:
		builtin("blorp_file_close_appender")


implements FileClosable for FileReadWriter:
	func close(file: FileReadWriter) -> Void:
		builtin("blorp_file_close_read_writer")


implements FileClosable for FileReadAppender:
	func close(file: FileReadAppender) -> Void:
		builtin("blorp_file_close_read_appender")


---
Read sequentially from a scoped file handle.
---
trait FileReadable:
	func read_text(handle: Self) -> Result[String, IOError]
	func read_bytes(handle: Self) -> Result[Bytes, IOError]
	func read_chunk(handle: Self, max_bytes: Int) -> Result[Bytes, IOError]
	func count_lines(handle: Self) -> Result[Int, IOError]


---
Read from a stable offset without changing the handle's current file offset.
---
trait FileReadAt:
	func read_chunk_at(handle: Self, offset: Int, max_bytes: Int) -> Result[Bytes, IOError]


---
Write at the handle's current file offset.
---
trait FileWritable:
	func write_text(handle: Self, text: String) -> Result[Void, IOError]
	func write_bytes(handle: Self, data: Bytes) -> Result[Void, IOError]
	func write_chunk(handle: Self, data: Bytes) -> Result[Int, IOError]


---
Append to the end of the file.
---
trait FileAppendable:
	func append_text(handle: Self, text: String) -> Result[Void, IOError]
	func append_bytes(handle: Self, data: Bytes) -> Result[Void, IOError]
	func append_chunk(handle: Self, data: Bytes) -> Result[Int, IOError]


---
Query metadata from an open file handle.
---
trait FileSized:
	func size(handle: Self) -> Result[Int, IOError]


---
Errors reported by typed file APIs.

Path-specific variants carry the path that was used for the operation. General
variants carry a human-readable detail string from the runtime or caller.
---
union IOError:
	NotFound(String)
	PermissionDenied(String)
	AlreadyExists(String)
	InvalidInput(String)
	Interrupted(String)
	TimedOut(String)
	Unsupported(String)
	Other(String)


---
Return a stable, human-readable description of an I/O error.

doctests:
    :: Missing path
    message(NotFound("/tmp/missing")) == "not found: /tmp/missing"

    :: Permission denied
    message(PermissionDenied("/root/secret")) == "permission denied: /root/secret"
---
pure func message(err: IOError) -> String:
	match err:
		NotFound(path): "not found: " + path
		PermissionDenied(path): "permission denied: " + path
		AlreadyExists(path): "already exists: " + path
		InvalidInput(detail): "invalid input: " + detail
		Interrupted(detail): "interrupted: " + detail
		TimedOut(detail): "timed out: " + detail
		Unsupported(detail): "unsupported: " + detail
		Other(detail): "io error: " + detail


implements Stringable for IOError:
	pure func to_string(err: IOError) -> String:
		message(err)


---
Open a file for reading as a scoped resource.

Use with `with reader ?= open_read(path):` so the reader is closed
automatically when the block exits.
---
func open_read(path: String) -> Result[FileReader, IOError]:
	builtin("blorp_file_open_read_raw")


---
Open a file for writing as a scoped resource.

Creates the file if it is missing and truncates it if it already exists. Use
with `with writer ?= open_write(path):` so the writer is closed automatically
when the block exits.
---
func open_write(path: String) -> Result[FileWriter, IOError]:
	builtin("blorp_file_open_write_raw")


---
Open a file for appending as a scoped resource.

Creates the file if it is missing and preserves existing contents. Use with
`with appender ?= open_append(path):` so the appender is closed automatically
when the block exits.
---
func open_append(path: String) -> Result[FileAppender, IOError]:
	builtin("blorp_file_open_append_raw")


---
Open an existing file for reading and writing as a scoped resource.

The path must already exist. The file is not truncated. Use with
`with file ?= open_read_write(path):` so the handle is closed automatically
when the block exits.
---
func open_read_write(path: String) -> Result[FileReadWriter, IOError]:
	builtin("blorp_file_open_read_write_raw")


---
Open an existing file for reading and appending as a scoped resource.

The path must already exist. Reads use the current file offset, while append
operations always write at the end of the file.
---
func open_read_append(path: String) -> Result[FileReadAppender, IOError]:
	builtin("blorp_file_open_read_append_raw")


implements FileReadable for FileReader:
	@resource_result_ordinary
	func read_text(reader: FileReader) -> Result[String, IOError]:
		builtin("blorp_file_read_text_reader_raw")

	@resource_result_ordinary
	func read_bytes(reader: FileReader) -> Result[Bytes, IOError]:
		builtin("blorp_file_read_bytes_reader_raw")

	@resource_result_ordinary
