-- First-class integer range values.
--
-- `start..end` is half-open: it includes `start` and excludes `end`.
-- Backwards ranges iterate down, still excluding `end`. Empty ranges iterate
-- zero times.
import:
	list: List


struct Range {start: Int, end: Int}


---
Return the number of integers in the range.

doctests:
    :: Ascending range
    (0..5).length() == 5

    :: Descending range
    (5..2).length() == 3

    :: Empty range
    (3..3).length() == 0
---
pure func length(self: Range) -> Int:
	if self.start <= self.end:
		self.end - self.start
	else:
		self.start - self.end


---
Return True when the range contains no values.
---
pure func is_empty(self: Range) -> Bool:
	self.start == self.end


---
Return True when `value` is inside the half-open range.
The start is included and the end is excluded for both directions.

doctests:
    :: Ascending contains
    (2..5).contains(4) == True

    :: Ascending excludes end
    (2..5).contains(5) == False

    :: Descending contains
    (5..2).contains(3) == True

    :: Descending excludes end
    (5..2).contains(2) == False
---
pure func contains(self: Range, value: Int) -> Bool:
	if self.start <= self.end:
		value >= self.start and value < self.end
	else:
		value <= self.start and value > self.end


---
Collect the range into a list of Int values.

doctests:
    :: Ascending list
    (1..4).to_list() == [1, 2, 3]

    :: Descending list
    (4..1).to_list() == [4, 3, 2]
---
pure func to_list(self: Range) -> List[Int]:
	var result: List[Int] = []
	for value in self:
		result = result.append(value)
	result


---
Fold over all values in the range.
---
func fold[Acc](
	self: Range,
	init: Acc,
	f: (Acc, Int) -> Acc,
) -> Acc:
pure func fold[Acc](
	self: Range,
	init: Acc,
	f: pure (Acc, Int) -> Acc,
) -> Acc:
	var acc: Acc = init
	for value in self:
		acc = f(acc, value)
	acc


---
Apply a side-effecting function to each value in the range.
---
func for_each(
	self: Range,
	f: (Int) -> Void,
) -> Void:
	for value in self:
		f(value)
