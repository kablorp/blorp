-- Int - Integer type trait implementations
--
-- Provides standard trait implementations for the Int type including:
-- - Stringable: Convert to string representation
-- - Absolute: Absolute value computation
-- - Bounded: Min/max operations
-- - Addable, Subtractable, Multipliable, Divisible, Modulable: Arithmetic
-- - Negatable: Unary negation
-- - Equatable, Orderable: Comparison operations
-- - HasZero, HasOne: Numeric identity values
-- - ToFloat, ToBool, ToChar: Type conversions
--
-- All arithmetic is safe by default:
-- - Division/modulo by zero returns 0
-- - Integer overflow wraps (two's complement)
type Int = builtin


-- 64-bit signed integer alias (blorp Int is 64-bit).
type alias Int64 = Int


import:
	math: MathError(DivByZero, Overflow, Underflow)


-- Sized integer conversion builtins.
pure func to_int8[T](value: T) -> Int8:
	builtin("blorp_to_int8")


pure func to_int16[T](value: T) -> Int16:
	builtin("blorp_to_int16")


pure func to_int32[T](value: T) -> Int32:
	builtin("blorp_to_int32")


pure func to_int128[T](value: T) -> Int128:
	builtin("blorp_to_int128")


pure func to_uint8[T](value: T) -> UInt8:
	builtin("blorp_to_uint8")


pure func to_uint16[T](value: T) -> UInt16:
	builtin("blorp_to_uint16")


pure func to_uint32[T](value: T) -> UInt32:
	builtin("blorp_to_uint32")


pure func to_uint64[T](value: T) -> UInt64:
	builtin("blorp_to_uint64")


pure func to_uint128[T](value: T) -> UInt128:
	builtin("blorp_to_uint128")


-- String conversion
implements Stringable for Int:
	pure func to_string(val: Int) -> String:
		builtin("blorp_to_string")


-- Absolute value
implements Absolute for Int:
	pure func abs(val: Int) -> Int:
		match val < 0:
			True: -val
			_: val


-- Min/Max
implements Bounded for Int:
	pure func min(a: Int, b: Int) -> Int:
		match a < b:
			True: a
			_: b

	pure func max(a: Int, b: Int) -> Int:
		match a > b:
			True: a
			_: b


-- Arithmetic operators
implements Addable for Int:
	pure func add(a: Int, b: Int) -> Int:
		a + b


implements Subtractable for Int:
	pure func subtract(a: Int, b: Int) -> Int:
		a - b


implements Multipliable for Int:
	pure func multiply(a: Int, b: Int) -> Int:
		a * b


implements Divisible for Int:
	pure func divide(a: Int, b: Int) -> Int:
		a / b


implements Modulable for Int:
	pure func remainder(a: Int, b: Int) -> Int:
		a % b


implements Negatable for Int:
	pure func negate(a: Int) -> Int:
		-a


-- Comparison operators
implements Equatable for Int:
	pure func equals(a: Int, b: Int) -> Bool:
		a == b

	pure func not_equals(a: Int, b: Int) -> Bool:
		a != b


implements Orderable for Int:
	pure func less_than(a: Int, b: Int) -> Bool:
		a < b

	pure func greater_than(a: Int, b: Int) -> Bool:
		a > b

	pure func less_than_or_equal(a: Int, b: Int) -> Bool:
		a <= b

	pure func greater_than_or_equal(a: Int, b: Int) -> Bool:
		a >= b


-- Numeric trait support
implements HasZero for Int:
	pure func zero() -> Int:
		0


implements HasOne for Int:
	pure func one() -> Int:
		1


-- Type conversions FROM Int
implements ToFloat for Int:
	pure func to_float(val: Int) -> Float:
		to_float(val)


implements ToBool for Int:
	pure func to_bool(val: Int) -> Bool:
		val != 0


implements ToChar for Int:
	pure func to_char(val: Int) -> Char:
		to_char(val)


implements ToInt for Int:
	pure func to_int(val: Int) -> Int:
		val


implements Numeric for Int:
	pure func __numeric_marker() -> Int:
		0


-- marker trait: all methods inherited from super-traits
-- ============================================================================
-- Range bounds
--
-- [Int] is a 64-bit signed integer, so the bounds are the full ±2^63
-- IEEE range. Useful as "infinity" sentinels for find-min / find-max
-- loops:
--
-- var lowest: Int = INT_MAX
-- for x in xs:
-- if x < lowest:
-- lowest = x
--
-- INT_MIN is written as [-INT_MAX - 1] because the literal
-- [-9223372036854775808] would lex as [MINUS 9223372036854775808],
-- and the positive value alone overflows int64 by one.
-- ============================================================================
INT_MAX: Int = 9223372036854775807

INT_MIN: Int = -9223372036854775807 - 1


-- ============================================================================
-- Checked Arithmetic
-- ============================================================================
---
Safe division that returns Result instead of 0 on divide-by-zero.

doctests:
    :: Basic division
    match divide_checked(10, 2):
        Ok(v): v == 5
        Err(_): False

    :: Division by zero returns error
    match divide_checked(10, 0):
        Ok(_): False
        Err(DivByZero): True
        Err(_): False
---
pure func divide_checked(a: Int, b: Int) -> Result[Int, MathError]:
	if b == 0:
		Err(DivByZero)
	else:
		Ok(a / b)


---
Safe modulo that returns Result instead of 0 on modulo-by-zero.

doctests:
    :: Modulo success
    match mod_checked(10, 3):
        Ok(v): v == 1
        Err(_): False

    :: Modulo by zero returns error
    match mod_checked(10, 0):
        Ok(_): False
        Err(DivByZero): True
        Err(_): False
---
pure func mod_checked(a: Int, b: Int) -> Result[Int, MathError]:
	if b == 0:
		Err(DivByZero)
	else:
		Ok(a % b)


---
Safe addition with overflow/underflow checking.

doctests:
    :: Basic addition
    match add_checked(1, 2):
        Ok(v): v == 3
        Err(_): False
---
pure func add_checked(a: Int, b: Int) -> Result[Int, MathError]:
	-- Overflow: b > 0 and a > INT_MAX - b
	-- Underflow: b < 0 and a < INT_MIN - b
	if b > 0:
		if a > INT_MAX - b:
			Err(Overflow)
		else:
			Ok(a + b)
	else if a < INT_MIN - b:
		Err(Underflow)
	else:
		Ok(a + b)


---
Safe subtraction with overflow/underflow checking.

doctests:
    :: Basic subtraction
    match subtract_checked(5, 3):
        Ok(v): v == 2
        Err(_): False
---
pure func subtract_checked(a: Int, b: Int) -> Result[Int, MathError]:
	-- Overflow: b < 0 and a > INT_MAX + b
	-- Underflow: b > 0 and a < INT_MIN + b
	if b < 0:
		if a > INT_MAX + b:
			Err(Overflow)
		else:
			Ok(a - b)
	else if a < INT_MIN + b:
		Err(Underflow)
	else:
		Ok(a - b)


---
Safe multiplication with overflow/underflow checking.

doctests:
    :: Basic multiplication
    match multiply_checked(3, 4):
        Ok(v): v == 12
        Err(_): False
---
pure func multiply_checked(a: Int, b: Int) -> Result[Int, MathError]:
	-- Handle zero cases first
	if a == 0:
		Ok(0)
	else if b == 0:
		Ok(0)
	else if a > 0:
		if b > 0:
			if a > INT_MAX / b:
				Err(Overflow)
			else:
				Ok(a * b)
		else if b < INT_MIN / a:
			Err(Underflow)
		else:
			Ok(a * b)
	else if b > 0:
		if a < INT_MIN / b:
			Err(Underflow)
		else:
			Ok(a * b)
	else if a < INT_MAX / b:
		Err(Overflow)
	else:
		Ok(a * b)


-- ============================================================================
-- Saturating Arithmetic
-- ============================================================================
---
Saturating addition - clamps at INT_MAX/INT_MIN instead of overflowing.

doctests:
    :: Normal addition
    add_saturating(1, 2) == 3

    :: Negative numbers
    add_saturating(-5, 3) == -2
---
pure func add_saturating(a: Int, b: Int) -> Int:
	if b > 0:
		if a > INT_MAX - b:
			INT_MAX
		else:
			a + b
	else if a < INT_MIN - b:
		INT_MIN
	else:
		a + b


---
Saturating subtraction - clamps at INT_MAX/INT_MIN instead of overflowing.

doctests:
    :: Subtract positive numbers
    subtract_saturating(5, 3) == 2

    :: Subtract to negative
    subtract_saturating(0, 1) == -1
---
pure func subtract_saturating(a: Int, b: Int) -> Int:
	if b < 0:
		if a > INT_MAX + b:
			INT_MAX
		else:
			a - b
	else if a < INT_MIN + b:
		INT_MIN
	else:
		a - b


---
Saturating multiplication - clamps at INT_MAX/INT_MIN instead of overflowing.

doctests:
    :: Basic multiplication
    multiply_saturating(3, 4) == 12

    :: Multiply by zero
    multiply_saturating(0, 100) == 0
---
pure func multiply_saturating(a: Int, b: Int) -> Int:
	if a == 0:
		0
	else if b == 0:
		0
	else if a > 0:
		if b > 0:
			if a > INT_MAX / b:
				INT_MAX
			else:
				a * b
		else if b < INT_MIN / a:
			INT_MIN
		else:
			a * b
	else if b > 0:
		if a < INT_MIN / b:
			INT_MIN
		else:
			a * b
	else if a < INT_MAX / b:
		INT_MAX
	else:
		a * b


-- ============================================================================
-- Integer Utility Functions
-- ============================================================================
---
Clamps a value to the range [min_val, max_val].

doctests:
    :: Value within range stays the same
    clamp(5, 0, 10) == 5

    :: Value below minimum gets clamped up
    clamp(-5, 0, 10) == 0

    :: Value above maximum gets clamped down
    clamp(15, 0, 10) == 10
---
pure func clamp(value: Int, min_val: Int, max_val: Int) -> Int:
	if value < min_val:
		min_val
	else if value > max_val:
		max_val
	else:
		value


---
Sign of an integer: returns -1, 0, or 1.

doctests:
    :: Positive
    sign(42) == 1

    :: Negative
    sign(-7) == -1

    :: Zero
    sign(0) == 0
---
pure func sign(x: Int) -> Int:
	if x > 0:
		1
	else if x < 0:
		-1
	else:
		0


---
Returns True if x is even.

doctests:
    :: Even number
    is_even(4) == True

    :: Odd number
    is_even(3) == False

    :: Zero is even
    is_even(0) == True
---
pure func is_even(x: Int) -> Bool:
	x % 2 == 0


---
Returns True if x is odd.

doctests:
    :: Odd number
    is_odd(3) == True

    :: Even number
    is_odd(4) == False

    :: Zero is not odd
    is_odd(0) == False
---
pure func is_odd(x: Int) -> Bool:
	x % 2 != 0


---
Greatest common divisor using the Euclidean algorithm.

doctests:
    :: GCD of 12 and 8
    gcd(12, 8) == 4

    :: GCD with zero
    gcd(7, 0) == 7

    :: GCD of coprime numbers
    gcd(13, 7) == 1

    :: GCD with negative numbers
    gcd(-12, 8) == 4
---
pure func gcd(a: Int, b: Int) -> Int:
	var x: Int = a
	if a < 0:
		x = 0 - a
	var y: Int = b
	if b < 0:
		y = 0 - b
	if y == 0:
		x
	else:
		gcd(y, x % y)


---
Least common multiple.

doctests:
    :: LCM of 4 and 6
    lcm(4, 6) == 12

    :: LCM with zero
    lcm(0, 5) == 0

    :: LCM of same number
    lcm(7, 7) == 7
---
pure func lcm(a: Int, b: Int) -> Int:
	if a == 0:
		0
	else if b == 0:
		0
	else:
		var abs_a: Int = a
		if a < 0:
			abs_a = 0 - a
		var abs_b: Int = b
		if b < 0:
			abs_b = 0 - b
		abs_a / gcd(a, b) * abs_b


---
Factorial. Returns n! for n >= 0. Returns 1 for n <= 0.

doctests:
    :: Factorial of 0
    factorial(0) == 1

    :: Factorial of 5
    factorial(5) == 120

    :: Factorial of 1
    factorial(1) == 1

    :: Factorial of 10
    factorial(10) == 3628800
---
pure func factorial(n: Int) -> Int:
	factorial_loop(n, 1, 2)


private @tail_recursive pure func factorial_loop(n: Int, acc: Int, i: Int) -> Int:
	if i > n:
		acc
	else:
		factorial_loop(n, acc * i, i + 1)


---
Returns True if n is a power of two (n > 0 and n & (n-1) == 0).

doctests:
    :: 1 is a power of two
    is_power_of_two(1) == True

    :: 8 is a power of two
    is_power_of_two(8) == True

    :: 6 is not a power of two
    is_power_of_two(6) == False

    :: 0 is not a power of two
    is_power_of_two(0) == False
---
pure func is_power_of_two(n: Int) -> Bool:
	if n <= 0:
		False
	else:
		is_power_of_two_check(n)


-- n & (n-1) == 0 means power of two.
-- Implement without bitwise: keep dividing by 2.
private @tail_recursive pure func is_power_of_two_check(n: Int) -> Bool:
	if n == 1:
		True
	else if n % 2 != 0:
		False
	else:
		is_power_of_two_check(n / 2)


---
Smallest power of two >= n. Returns 1 for n <= 1.

doctests:
    :: Already a power of two
    next_power_of_two(8) == 8

    :: Not a power of two
    next_power_of_two(5) == 8

    :: One
    next_power_of_two(1) == 1

    :: Zero
    next_power_of_two(0) == 1
---
pure func next_power_of_two(n: Int) -> Int:
	if n <= 1:
		1
	else:
		next_pow2_loop(n, 1)


private @tail_recursive pure func next_pow2_loop(n: Int, p: Int) -> Int:
	if p >= n:
		p
	else:
		next_pow2_loop(n, p * 2)
