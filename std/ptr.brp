-- Ptr - Opaque C pointer.
--
-- Used exclusively for interop with C code declared via [foreign:].
-- Blorp code cannot dereference a [Ptr]; pointer arithmetic, allocation,
-- and deallocation all happen on the C side. A [Ptr] value is passed
-- through as a [void*] at the C ABI boundary.
--
-- Example:
-- foreign:
--     func sdl_load_texture(path: String) -> Ptr = "SDL_LoadTexture"
type Ptr = builtin
