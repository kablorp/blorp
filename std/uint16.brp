-- UInt16 - Trait Implementations
--
-- Unsigned 16-bit integer type.
type UInt16 = builtin


implements Stringable for UInt16:
	pure func to_string(val: UInt16) -> String:
		builtin("blorp_to_string")


implements Equatable for UInt16:
	pure func equals(a: UInt16, b: UInt16) -> Bool:
		a == b

	pure func not_equals(a: UInt16, b: UInt16) -> Bool:
		a != b


implements Orderable for UInt16:
	pure func less_than(a: UInt16, b: UInt16) -> Bool:
		a < b

	pure func greater_than(a: UInt16, b: UInt16) -> Bool:
		a > b

	pure func less_than_or_equal(a: UInt16, b: UInt16) -> Bool:
		a <= b

	pure func greater_than_or_equal(a: UInt16, b: UInt16) -> Bool:
		a >= b


implements Bounded for UInt16:
	pure func min(a: UInt16, b: UInt16) -> UInt16:
		match a < b:
			True: a
			_: b

	pure func max(a: UInt16, b: UInt16) -> UInt16:
		match a > b:
			True: a
			_: b


implements HasZero for UInt16:
	pure func zero() -> UInt16:
		to_uint16(0)


implements HasOne for UInt16:
	pure func one() -> UInt16:
		to_uint16(1)


implements ToBool for UInt16:
	pure func to_bool(val: UInt16) -> Bool:
		val != to_uint16(0)


implements ToInt for UInt16:
	pure func to_int(val: UInt16) -> Int:
		to_int(val)


implements Addable for UInt16:
	pure func add(a: UInt16, b: UInt16) -> UInt16:
		a + b


implements Subtractable for UInt16:
	pure func subtract(a: UInt16, b: UInt16) -> UInt16:
		a - b


implements Multipliable for UInt16:
	pure func multiply(a: UInt16, b: UInt16) -> UInt16:
		a * b


implements Divisible for UInt16:
	pure func divide(a: UInt16, b: UInt16) -> UInt16:
		a / b


implements Modulable for UInt16:
	pure func remainder(a: UInt16, b: UInt16) -> UInt16:
		a % b


implements Absolute for UInt16:
	pure func abs(val: UInt16) -> UInt16:
		val
