import:
	heap: Heap, heap
	int: max_int


-- Graph - Directed graph
--
-- A simple directed graph where nodes are integers.
-- Represented as a single List[Int]:
-- [num_nodes, node1, ..., nodeN, src1, dst1, w1, src2, dst2, w2, ...]
-- The first element is the count of nodes. The rest after nodes are edge triples.
type alias Graph = List[Int]


-- ============================================================================
-- Construction
-- ============================================================================
---
Create an empty graph.

doctests:
    :: New graph is empty
    g: List[Int] = graph()
    node_count(g) == 0
---
pure func graph() -> Graph:
	[0]


-- ============================================================================
-- Mutation
-- ============================================================================
---
Add a node to the graph. No-op if already exists.

doctests:
    :: Add node increases size
    g: List[Int] = add_node(graph(), 1)
    node_count(g) == 1
---
pure func add_node(self: List[Int], node: Int) -> List[Int]:
	nc: Int = get_int(self, 0)
	if node_exists(self, nc, node):
		self
	else:
		-- Insert node: shift edges right by 1, put node at position nc+1
		var result: List[Int] = [nc + 1]

		-- Copy existing nodes
		var i: Int = 0
		while i < nc:
			result = result.append(get_int(self, 1 + i))
			i += 1

		-- Add new node
		result = result.append(node)

		-- Copy edges
		i = 1 + nc
		while i < self.length():
			result = result.append(get_int(self, i))
			i += 1
		result


---
Add a directed edge from src to dst with weight.
Adds nodes if they don't exist.

doctests:
    :: Add edge creates connection
    g: List[Int] = add_edge(
        graph(),
        1,
        2,
        1,
    )
    has_edge(g, 1, 2) == True
---
pure func add_edge(
	self: List[Int],
	src: Int,
	dst: Int,
	weight: Int,
) -> List[Int]:
	var g2: List[Int] = self
	g2 = add_node(g2, src)
	g2 = add_node(g2, dst)
	g2 = g2.append(src)
	g2 = g2.append(dst)
	g2 = g2.append(weight)
	g2


---
Add an undirected edge (adds both directions).
---
pure func add_undirected_edge(
	self: List[Int],
	a: Int,
	b: Int,
	weight: Int,
) -> List[Int]:
	g2: List[Int] = add_edge(
		self,
		a,
		b,
		weight,
	)
	add_edge(
		g2,
		b,
		a,
		weight,
	)


-- ============================================================================
-- Queries
-- ============================================================================
---
Check if an edge exists from src to dst.
---
pure func has_edge(self: List[Int], src: Int, dst: Int) -> Bool:
	nc: Int = get_int(self, 0)
	edge_start: Int = 1 + nc
	find_edge(
		self,
		edge_start,
		src,
		dst,
	)


---
Get neighbors of a node (nodes reachable by one edge).

doctests:
    :: Neighbors returns adjacent nodes
    var g: List[Int] = graph()
    g = add_edge(
        g,
        1,
        2,
        1,
    )
    g = add_edge(
        g,
        1,
        3,
        1,
    )
    neighbors(g, 1).length() == 2
---
pure func neighbors(self: List[Int], node: Int) -> List[Int]:
	nc: Int = get_int(self, 0)
	edge_start: Int = 1 + nc
	collect_neighbors(self, edge_start, node)


---
Get the number of nodes.
---
pure func node_count(self: List[Int]) -> Int:
	get_int(self, 0)


---
Get the number of edges.
---
pure func edge_count(self: List[Int]) -> Int:
	nc: Int = get_int(self, 0)
	(self.length() - 1 - nc) / 3


---
Check if the graph contains a node.
---
pure func has_node(self: List[Int], node: Int) -> Bool:
	nc: Int = get_int(self, 0)
	node_exists(self, nc, node)


-- ============================================================================
-- Traversals
-- ============================================================================
---
Breadth-first search from a start node. Returns nodes in BFS order.

doctests:
    :: BFS visits all reachable nodes
    var g: List[Int] = graph()
    g = add_edge(
        g,
        1,
        2,
        1,
    )
    g = add_edge(
        g,
        1,
        3,
        1,
    )
    g = add_edge(
        g,
        2,
        4,
        1,
    )
    bfs(g, 1).length() == 4
---
pure func bfs(self: List[Int], start: Int) -> List[Int]:
	var visited: List[Int] = [start]
	var queue: List[Int] = [start]
	var done: Bool = False
	while not done:
		if queue.length() == 0:
			done = True
		else:
			match queue.get(0):
				Some(current):
					queue = list_tail_int(queue)
					nbrs: List[Int] = neighbors(self, current)
					var j: Int = 0
					while j < nbrs.length():
						match nbrs.get(j):
							Some(nbr):
								if not list_contains_int(visited, nbr):
									visited = visited.append(nbr)
									queue = queue.append(nbr)
								else:
									void
							None: void
						j += 1
				None:
					done = True
	visited


---
Depth-first search from a start node. Returns nodes in DFS order.

doctests:
    :: DFS visits all reachable nodes
    var g: List[Int] = graph()
    g = add_edge(
        g,
        1,
        2,
        1,
    )
    g = add_edge(
        g,
        2,
        3,
        1,
    )
    dfs(g, 1).length() == 3
---
pure func dfs(self: List[Int], start: Int) -> List[Int]:
	var visited: List[Int] = []
	var stack: List[Int] = [start]
	var done: Bool = False
	while not done:
		if stack.length() == 0:
			done = True
		else:
			match stack.get(stack.length() - 1):
				Some(current):
					stack = list_take_int(stack, stack.length() - 1)
					if not list_contains_int(visited, current):
						visited = visited.append(current)
						nbrs: List[Int] = neighbors(self, current)
						var j: Int = 0
						while j < nbrs.length():
							match nbrs.get(j):
								Some(nbr):
									if not list_contains_int(visited, nbr):
										stack = stack.append(nbr)
									else:
										void
								None: void
							j += 1
					else:
						void
				None:
					done = True
	visited


---
Shortest path from src to dst using Dijkstra's algorithm.
Returns the shortest distance, or None if unreachable.

doctests:
    :: Shortest path finds optimal route
    var g: List[Int] = graph()
    g = add_edge(
        g,
        1,
        2,
        4,
    )
    g = add_edge(
        g,
        1,
        3,
        1,
    )
    g = add_edge(
        g,
        3,
        2,
        2,
    )
    match shortest_path(g, 1, 2):
        Some(d): d == 3
        None: False
---
pure func shortest_path(self: List[Int], src: Int, dst: Int) -> Option[Int]:
	nc: Int = get_int(self, 0)
	edge_start: Int = 1 + nc

	-- Dijkstra's using min-heap. Encode (distance, node) as a single Int:
	-- encoded = distance * NODE_SCALE + node_id
	-- Supports up to 1,000,000,000 nodes and distances up to ~9.2 billion.
	node_scale: Int = 1000000000
	var dist_keys: List[Int] = [src]
	var dist_vals: List[Int] = [0]
	var pq: Heap[Int] = heap()
	pq = pq.push(src)
	var visited: List[Int] = []
	var result: Option[Int] = None
	var done: Bool = False
	while not done:
		match pq.pop():
			None:
				done = True
			Some(pop_result):
				encoded: Int = pop_result[0]
				pq = pop_result[1]
				cur_node: Int = encoded % node_scale
				cur_dist: Int = encoded / node_scale
				if cur_node == dst:
					result = Some(cur_dist)
					done = True
				else if not list_contains_int(visited, cur_node):
					visited = visited.append(cur_node)
					var j: Int = edge_start
					while j + 2 < self.length():
						es: Int = get_int(self, j)
						if es == cur_node:
							nbr: Int = get_int(self, j + 1)
							w: Int = get_int(self, j + 2)
							new_dist: Int = cur_dist + w
							old_dist: Option[Int] = lookup_int(dist_keys, dist_vals, nbr)
							var should_add: Bool = False
							match old_dist:
								Some(od):
									if new_dist < od:
										should_add = True
									else:
										void
								None:
									should_add = True
							if should_add:
								dist_keys = upsert_key(dist_keys, nbr)
								dist_vals = upsert_val(
									dist_keys,
									dist_vals,
									nbr,
									new_dist,
								)
								pq = pq.push(new_dist * node_scale + nbr)
							else:
								void
						else:
							void
						j += 3
				else:
					void
	result


---
Topological sort of a directed acyclic graph.
Returns nodes in topological order, or empty list if cycle detected.

doctests:
    :: Topological sort orders dependencies
    var g: List[Int] = graph()
    g = add_edge(
        g,
        1,
        2,
        1,
    )
    g = add_edge(
        g,
        1,
        3,
        1,
    )
    g = add_edge(
        g,
        2,
        4,
        1,
    )
    g = add_edge(
        g,
        3,
        4,
        1,
    )
    topological_sort(g).length() == 4
---
pure func topological_sort(self: List[Int]) -> List[Int]:
	nc: Int = get_int(self, 0)
	edge_start: Int = 1 + nc

	-- Kahn's algorithm using parallel key/val lists for in-degree
	var deg_keys: List[Int] = []
	var deg_vals: List[Int] = []
	var i: Int = 0
	while i < nc:
		deg_keys = deg_keys.append(get_int(self, 1 + i))
		deg_vals = deg_vals.append(0)
		i += 1

	-- Count incoming edges
	i = edge_start
	while i + 2 < self.length():
		dst_node: Int = get_int(self, i + 1)
		old_deg: Int = lookup_int_default(
			deg_keys,
			deg_vals,
			dst_node,
			0,
		)
		deg_vals = update_val(
			deg_keys,
			deg_vals,
			dst_node,
			old_deg + 1,
		)
		i += 3

	-- Collect nodes with in-degree 0
	var queue: List[Int] = []
	i = 0
	while i < deg_keys.length():
		match deg_vals.get(i):
			Some(d):
				if d == 0:
					match deg_keys.get(i):
						Some(node):
							queue = queue.append(node)
						None: void
				else:
					void
			None: void
		i += 1

	-- Process
	var result: List[Int] = []
	var loop_done: Bool = False
	while not loop_done:
		if queue.length() == 0:
			loop_done = True
		else:
			match queue.get(0):
				Some(node):
					queue = list_tail_int(queue)
					result = result.append(node)
					nbrs: List[Int] = neighbors(self, node)
					var j: Int = 0
					while j < nbrs.length():
						match nbrs.get(j):
							Some(nbr):
								nd: Int = lookup_int_default(
									deg_keys,
									deg_vals,
									nbr,
									0,
								) - 1
								deg_vals = update_val(
									deg_keys,
									deg_vals,
									nbr,
									nd,
								)
								if nd == 0:
									queue = queue.append(nbr)
								else:
									void
							None: void
						j += 1
				None:
					loop_done = True
	if result.length() == nc:
		result
	else:
		[]


-- ============================================================================
-- Advanced Algorithms
-- ============================================================================
---
Bellman-Ford single-source shortest path. Handles negative edge weights.
Returns (distances, predecessors) as parallel lists keyed by node.
Unreachable nodes have distance max_int() and predecessor -1.

doctests:
    :: Shortest distances with negative weights
    var g: List[Int] = graph()
    g = add_edge(
        g,
        0,
        1,
        4,
    )
    g = add_edge(
        g,
        0,
        2,
        5,
    )
    g = add_edge(
        g,
        1,
        2,
        -3,
    )
    result: (List[Int], List[Int]) = bellman_ford(g, 0)
    dists: List[Int] = result[1]

    -- Node 2 is reachable with distance 1 (0→1→2: 4 + -3)
    dists.length() > 0
---
pure func bellman_ford(g: List[Int], source: Int) -> (List[Int], List[Int]):
	nc: Int = get_int(g, 0)
	edge_start: Int = 1 + nc
	inf: Int = max_int()

	-- Build node list
	var nodes: List[Int] = []
	var i: Int = 0
	while i < nc:
		nodes = nodes.append(get_int(g, 1 + i))
		i += 1

	-- Initialize distances and predecessors
	var dist_vals: List[Int] = []
	var pred_vals: List[Int] = []
	i = 0
	while i < nc:
		node: Int = get_int(g, 1 + i)
		if node == source:
			dist_vals = dist_vals.append(0)
		else:
			dist_vals = dist_vals.append(inf)
		pred_vals = pred_vals.append(-1)
		i += 1

	-- Relax edges |V|-1 times
	var iteration: Int = 0
	while iteration < nc - 1:
		var j: Int = edge_start
		while j + 2 < g.length():
			src_node: Int = get_int(g, j)
			dst_node: Int = get_int(g, j + 1)
			w: Int = get_int(g, j + 2)
			src_dist: Int = lookup_int_default(
				nodes,
				dist_vals,
				src_node,
				inf,
			)
			if src_dist < inf:
				new_dist: Int = src_dist + w
				dst_dist: Int = lookup_int_default(
					nodes,
					dist_vals,
					dst_node,
					inf,
				)
				if new_dist < dst_dist:
					dist_vals = update_val(
						nodes,
						dist_vals,
						dst_node,
						new_dist,
					)
					pred_vals = update_val(
						nodes,
						pred_vals,
						dst_node,
						src_node,
					)
			j += 3
		iteration += 1
	(dist_vals, pred_vals)


---
Prim's minimum spanning tree for undirected weighted graphs.
Returns list of (from, to, weight) triples representing MST edges.
Starts from the first node in the graph.

doctests:
    :: MST of triangle graph
    var g: List[Int] = graph()
    g = add_undirected_edge(
        g,
        0,
        1,
        1,
    )
    g = add_undirected_edge(
        g,
        1,
        2,
        2,
    )
    g = add_undirected_edge(
        g,
        0,
        2,
        3,
    )
    mst: List[(Int, Int, Int)] = prim_mst(g)
    mst.length() == 2
---
pure func prim_mst(g: List[Int]) -> List[(Int, Int, Int)]:
	nc: Int = get_int(g, 0)
	if nc == 0:
		[]
	else:
		edge_start: Int = 1 + nc
		start_node: Int = get_int(g, 1)
		var in_mst: List[Int] = [start_node]
		var result: List[(Int, Int, Int)] = []

		-- Use a min-heap encoding: weight * 1000000 + from * 1000 + to
		-- This limits node IDs to < 1000 and weights to < 1000000
		var pq: Heap[Int] = heap()

		-- Add edges from start node
		var j: Int = edge_start
		while j + 2 < g.length():
			if get_int(g, j) == start_node:
				dst: Int = get_int(g, j + 1)
				w: Int = get_int(g, j + 2)
				pq = pq.push(w * 1000000 + start_node * 1000 + dst)
			j += 3
		var done: Bool = False
		while not done:
			match pq.pop():
				None:
					done = True
				Some(pop_result):
					encoded: Int = pop_result[0]
					pq = pop_result[1]
					to_node: Int = encoded % 1000
					from_node: Int = encoded / 1000 % 1000
					w: Int = encoded / 1000000
					if list_contains_int(in_mst, to_node):
						void
					else:
						in_mst = in_mst.append(to_node)
						result = result.append((from_node, to_node, w))

						-- Add edges from newly added node
						var k: Int = edge_start
						while k + 2 < g.length():
							if get_int(g, k) == to_node:
								nbr: Int = get_int(g, k + 1)
								if not list_contains_int(in_mst, nbr):
									nw: Int = get_int(g, k + 2)
									pq = pq.push(nw * 1000000 + to_node * 1000 + nbr)
							k += 3
		result


---
Tarjan's algorithm for strongly connected components.
Returns a list of SCCs, where each SCC is a list of node IDs.

doctests:
    :: Single SCC in a cycle
    var g: List[Int] = graph()
    g = add_edge(
        g,
        0,
        1,
        1,
    )
    g = add_edge(
        g,
        1,
        2,
        1,
    )
    g = add_edge(
        g,
        2,
        0,
        1,
    )
    sccs: List[List[Int]] = tarjan_scc(g)
    sccs.length() == 1

    :: Two SCCs
    var g: List[Int] = graph()
    g = add_edge(
        g,
        0,
        1,
        1,
    )
    g = add_edge(
        g,
        1,
        0,
        1,
    )
    g = add_edge(
        g,
        2,
        3,
        1,
    )
    g = add_edge(
        g,
        3,
        2,
        1,
    )
    g = add_edge(
        g,
        1,
        2,
        1,
    )
    sccs: List[List[Int]] = tarjan_scc(g)
    sccs.length() == 2
---
pure func tarjan_scc(g: List[Int]) -> List[List[Int]]:
	nc: Int = get_int(g, 0)

	-- Build node list
	var nodes: List[Int] = []
	var i: Int = 0
	while i < nc:
		nodes = nodes.append(get_int(g, 1 + i))
		i += 1

	-- Parallel arrays for index, lowlink, on_stack
	var indices: List[Int] = []
	var lowlinks: List[Int] = []
	var on_stack: List[Int] = []
	i = 0
	while i < nc:
		indices = indices.append(-1)
		lowlinks = lowlinks.append(-1)
		on_stack = on_stack.append(0)
		i += 1
	var stack: List[Int] = []
	var current_index: Int = 0
	var result: List[List[Int]] = []

	-- Process each node
	i = 0
	while i < nc:
		node: Int = get_int(g, 1 + i)
		node_idx: Int = node_pos(nodes, node)
		if node_idx >= 0:
			idx_val: Int = lookup_int_default(
				nodes,
				indices,
				node,
				-1,
			)
			if idx_val == -1:
				-- strongconnect
				var sc_stack: List[(Int, Int)] = [(node, 0)]
				var sc_done: Bool = False
				while not sc_done:
					if sc_stack.length() == 0:
						sc_done = True
					else:
						match sc_stack.get(sc_stack.length() - 1):
							Some(frame):
								v: Int = frame[0]
								nbr_idx: Int = frame[1]
								sc_stack = list_take_int_tuples(sc_stack, sc_stack.length() - 1)
								v_idx_val: Int = lookup_int_default(
									nodes,
									indices,
									v,
									-1,
								)
								if v_idx_val == -1:
									-- First visit
									indices = update_val(
										nodes,
										indices,
										v,
										current_index,
									)
									lowlinks = update_val(
										nodes,
										lowlinks,
										v,
										current_index,
									)
									current_index += 1
									on_stack = update_val(
										nodes,
										on_stack,
										v,
										1,
									)
									stack = stack.append(v)
								nbrs: List[Int] = neighbors(g, v)
								var j: Int = nbr_idx
								var pushed: Bool = False
								while j < nbrs.length() and not pushed:
									match nbrs.get(j):
										Some(w):
											w_idx_val: Int = lookup_int_default(
												nodes,
												indices,
												w,
												-1,
											)
											if w_idx_val == -1:
												-- Push current frame back, then push w
												sc_stack = sc_stack.append((v, j + 1))
												sc_stack = sc_stack.append((w, 0))
												pushed = True
											else:
												w_on_stack: Int = lookup_int_default(
													nodes,
													on_stack,
													w,
													0,
												)
												if w_on_stack == 1:
													v_low: Int = lookup_int_default(
														nodes,
														lowlinks,
														v,
														0,
													)
													w_idx: Int = lookup_int_default(
														nodes,
														indices,
														w,
														0,
													)
													if w_idx < v_low:
														lowlinks = update_val(
															nodes,
															lowlinks,
															v,
															w_idx,
														)
												j += 1
										None:
											j += 1
								if not pushed:
									-- All neighbors processed, check if root of SCC
									v_low: Int = lookup_int_default(
										nodes,
										lowlinks,
										v,
										0,
									)
									v_idx2: Int = lookup_int_default(
										nodes,
										indices,
										v,
										0,
									)
									if v_low == v_idx2:
										-- Pop SCC from stack
										var scc: List[Int] = []
										var pop_done: Bool = False
										while not pop_done:
											if stack.length() == 0:
												pop_done = True
											else:
												w2: Int = get_int(stack, stack.length() - 1)
												stack = list_take_int(stack, stack.length() - 1)
												on_stack = update_val(
													nodes,
													on_stack,
													w2,
													0,
												)
												scc = scc.append(w2)
												if w2 == v:
													pop_done = True
										result = result.append(scc)

									-- Update parent's lowlink
									if sc_stack.length() > 0:
										match sc_stack.get(sc_stack.length() - 1):
											Some(parent_frame):
												parent: Int = parent_frame[0]
												p_low: Int = lookup_int_default(
													nodes,
													lowlinks,
													parent,
													0,
												)
												if v_low < p_low:
													lowlinks = update_val(
														nodes,
														lowlinks,
														parent,
														v_low,
													)
											None: void
							None:
								sc_done = True
		i += 1
	result


---
Get the list of all nodes in the graph.
---
pure func nodes_of(g: List[Int]) -> List[Int]:
	nc: Int = get_int(g, 0)
	var nodes: List[Int] = []
	var i: Int = 0
	while i < nc:
		nodes = nodes.append(get_int(g, 1 + i))
		i += 1
	nodes


---
Find position of a node in the node list. Returns -1 if not found.
---
private pure func node_pos(nodes: List[Int], node: Int) -> Int:
	var i: Int = 0
	var result: Int = -1
	while i < nodes.length():
		if get_int(nodes, i) == node:
			result = i
			break
		i += 1
	result


-- List take for tuple lists
private pure func list_take_int_tuples(lst: List[(Int, Int)], n: Int) -> List[(Int, Int)]:
	var result: List[(Int, Int)] = []
	var i: Int = 0
	while i < n:
		match lst.get(i):
			Some(v): result = result.append(v)
			None: void
		i += 1
	result


-- ============================================================================
-- Internal Helpers
-- ============================================================================
private pure func get_int(lst: List[Int], idx: Int) -> Int:
	match lst.get(idx):
		Some(v): v
		None: 0


private pure func node_exists(g: List[Int], nc: Int, node: Int) -> Bool:
	var i: Int = 0
	var found: Bool = False
	while i < nc and not found:
		if get_int(g, 1 + i) == node:
			found = True
		else:
			void
		i += 1
	found


private pure func find_edge(
	g: List[Int],
	edge_start: Int,
	src: Int,
	dst: Int,
) -> Bool:
	var i: Int = edge_start
	var found: Bool = False
	while i + 2 < g.length() and not found:
		if get_int(g, i) == src and get_int(g, i + 1) == dst:
			found = True
		else:
			void
		i += 3
	found


private pure func collect_neighbors(g: List[Int], edge_start: Int, node: Int) -> List[Int]:
	var result: List[Int] = []
	var i: Int = edge_start
	while i + 2 < g.length():
		if get_int(g, i) == node:
			result = result.append(get_int(g, i + 1))
		else:
			void
		i += 3
	result


private pure func list_contains_int(lst: List[Int], val: Int) -> Bool:
	var i: Int = 0
	var found: Bool = False
	while i < lst.length() and not found:
		match lst.get(i):
			Some(v):
				if v == val:
					found = True
				else:
					void
			None: void
		i += 1
	found


private pure func list_tail_int(lst: List[Int]) -> List[Int]:
	var result: List[Int] = []
	var i: Int = 1
	while i < lst.length():
		result = result.append(get_int(lst, i))
		i += 1
	result


private pure func list_take_int(lst: List[Int], n: Int) -> List[Int]:
	var result: List[Int] = []
	var i: Int = 0
	while i < n:
		result = result.append(get_int(lst, i))
		i += 1
	result


private pure func lookup_int(keys: List[Int], vals: List[Int], key: Int) -> Option[Int]:
	var i: Int = 0
	var result: Option[Int] = None
	var done: Bool = False
	while i < keys.length() and not done:
		if get_int(keys, i) == key:
			result = vals.get(i)
			done = True
		else:
			void
		i += 1
	result


private pure func lookup_int_default(
	keys: List[Int],
	vals: List[Int],
	key: Int,
	default_val: Int,
) -> Int:
	match lookup_int(keys, vals, key):
		Some(v): v
		None: default_val


private pure func upsert_key(keys: List[Int], key: Int) -> List[Int]:
	if list_contains_int(keys, key):
		keys
	else:
		keys.append(key)


private pure func upsert_val(
	keys: List[Int],
	vals: List[Int],
	key: Int,
	val: Int,
) -> List[Int]:
	if list_contains_int(keys, key):
		update_val(
			keys,
			vals,
			key,
			val,
		)
	else:
		vals.append(val)


private pure func update_val(
	keys: List[Int],
	vals: List[Int],
	key: Int,
	val: Int,
) -> List[Int]:
	var result: List[Int] = []
	var i: Int = 0
	while i < keys.length():
		if get_int(keys, i) == key:
			result = result.append(val)
		else:
			result = result.append(get_int(vals, i))
		i += 1
	result
