-- UInt32 - Trait Implementations
--
-- Unsigned 32-bit integer type.
type UInt32 = builtin


implements Stringable for UInt32:
	pure func to_string(val: UInt32) -> String:
		builtin("blorp_to_string")


implements Equatable for UInt32:
	pure func equals(a: UInt32, b: UInt32) -> Bool:
		a == b

	pure func not_equals(a: UInt32, b: UInt32) -> Bool:
		a != b


implements Orderable for UInt32:
	pure func less_than(a: UInt32, b: UInt32) -> Bool:
		a < b

	pure func greater_than(a: UInt32, b: UInt32) -> Bool:
		a > b

	pure func less_than_or_equal(a: UInt32, b: UInt32) -> Bool:
		a <= b

	pure func greater_than_or_equal(a: UInt32, b: UInt32) -> Bool:
		a >= b


implements Bounded for UInt32:
	pure func min(a: UInt32, b: UInt32) -> UInt32:
		match a < b:
			True:
				a
			_:
				b

	pure func max(a: UInt32, b: UInt32) -> UInt32:
		match a > b:
			True:
				a
			_:
				b


implements HasZero for UInt32:
	pure func zero() -> UInt32:
		to_uint32(0)


implements HasOne for UInt32:
	pure func one() -> UInt32:
		to_uint32(1)


implements ToBool for UInt32:
	pure func to_bool(val: UInt32) -> Bool:
		val != to_uint32(0)


implements ToInt for UInt32:
	pure func to_int(val: UInt32) -> Int:
		to_int(val)


implements Addable for UInt32:
	pure func add(a: UInt32, b: UInt32) -> UInt32:
		a + b


implements Subtractable for UInt32:
	pure func subtract(a: UInt32, b: UInt32) -> UInt32:
		a - b


implements Multipliable for UInt32:
	pure func multiply(a: UInt32, b: UInt32) -> UInt32:
		a * b


implements Divisible for UInt32:
	pure func divide(a: UInt32, b: UInt32) -> UInt32:
		a / b


implements Modulable for UInt32:
	pure func remainder(a: UInt32, b: UInt32) -> UInt32:
		a % b


implements Absolute for UInt32:
	pure func abs(val: UInt32) -> UInt32:
		val
