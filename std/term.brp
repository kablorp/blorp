-- ============================================================================
-- Background Colors
-- ============================================================================
pure func bg_red(s: String) -> String:
	wrap("41", s, "49")


pure func bg_green(s: String) -> String:
	wrap("42", s, "49")


pure func bg_yellow(s: String) -> String:
	wrap("43", s, "49")


pure func bg_blue(s: String) -> String:
	wrap("44", s, "49")


pure func bg_magenta(s: String) -> String:
	wrap("45", s, "49")


pure func bg_cyan(s: String) -> String:
	wrap("46", s, "49")


pure func bg_white(s: String) -> String:
	wrap("47", s, "49")


-- ============================================================================
-- 256-Color and RGB
-- ============================================================================
---
Color text with a 256-color palette index (0-255).
---
pure func color256(s: String, n: Int) -> String:
	"\u{1B}[38;5;" + n.to_string() + "m" + s + esc("39")


---
Color background with a 256-color palette index (0-255).
---
pure func bg_color256(s: String, n: Int) -> String:
	"\u{1B}[48;5;" + n.to_string() + "m" + s + esc("49")


---
Color text with an RGB value.
---
pure func rgb(s: String, r: Int, g: Int, b: Int) -> String:
	"\u{1B}[38;2;" + r.to_string() + ";" + g.to_string() + ";" + b.to_string() + "m" + s + esc("39")


---
Color background with an RGB value.
---
pure func bg_rgb(s: String, r: Int, g: Int, b: Int) -> String:
	"\u{1B}[48;2;" + r.to_string() + ";" + g.to_string() + ";" + b.to_string() + "m" + s + esc("49")


-- ============================================================================
-- Reset
-- ============================================================================
---
Strip all ANSI formatting (reset code).
---
pure func reset() -> String:
	esc("0")


-- ============================================================================
-- Composition Helpers
-- ============================================================================
---
Apply multiple styles to a string. Innermost style wins for conflicts.

doctests:
    :: Compose bold and red
    s: String = bold(red("error"))
    s.length() > 5
---
pure func styled(s: String, styles: List[pure (String) -> String]) -> String:
	var result: String = s
	var i: Int = styles.length() - 1
	while i >= 0:
		match styles.get(i):
			Some(f): result = f(result)
			None: void
		i -= 1
	result


-- ============================================================================
-- Table Formatting
-- ============================================================================
---
Format a simple text table with headers and rows.
Columns are auto-sized to fit content.

doctests:
    :: Table has header
    t: String = table(["Name", "Age"], [["Alice", "30"], ["Bob", "25"]])
    t.length() > 10
---
pure func table(headers: List[String], rows: List[List[String]]) -> String:
	-- Compute column widths
	num_cols: Int = headers.length()
	var widths: List[Int] = []
	var c: Int = 0
	while c < num_cols:
		var w: Int = match headers.get(c):
			Some(h): h.length()
			None: 0
		var r: Int = 0
		while r < rows.length():
			match rows.get(r):
				Some(row):
					match row.get(c):
						Some(cell):
							cell_len: Int = cell.length()
							if cell_len > w:
								w = cell_len
						None: void
				None: void
			r += 1
		widths = widths.append(w)
		c += 1

	-- Build table
	var buf: String = string(256)

	-- Header
	buf = buf.append_str(format_row(headers, widths))
	buf = buf.append_char('\n')

	-- Separator
	buf = buf.append_str(format_separator(widths))
	buf = buf.append_char('\n')

	-- Rows
	var r: Int = 0
	while r < rows.length():
		match rows.get(r):
			Some(row):
				buf = buf.append_str(format_row(row, widths))
				if r < rows.length() - 1:
					buf = buf.append_char('\n')
			None: void
		r += 1
	buf


private pure func format_row(cells: List[String], widths: List[Int]) -> String:
	var buf: String = string(64)
	var c: Int = 0
	while c < widths.length():
		if c > 0:
			buf = buf.append_str("  ")
		cell: String = match cells.get(c):
			Some(s): s
			None: ""
		w: Int = match widths.get(c):
			Some(n): n
			None: 0
		buf = buf.append_str(cell.pad_right(w))
		c += 1
	buf


private pure func format_separator(widths: List[Int]) -> String:
	var buf: String = string(64)
	var c: Int = 0
	while c < widths.length():
		if c > 0:
			buf = buf.append_str("  ")
		w: Int = match widths.get(c):
			Some(n): n
			None: 0
		var i: Int = 0
		while i < w:
			buf = buf.append_char('-')
			i += 1
		c += 1
	buf


---
Pad a string on the right with spaces to reach the target width.
---
pure func pad_right(s: String, width: Int) -> String:
	padding: Int = width - s.length()
	if padding <= 0:
		s
	else:
		var buf: String = string(width).append_str(s)
		var i: Int = 0
		while i < padding:
			buf = buf.append_char(' ')
			i += 1
		buf


---
Pad a string on the left with spaces to reach the target width.
---
pure func pad_left(s: String, width: Int) -> String:
	padding: Int = width - s.length()
	if padding <= 0:
		s
	else:
		var buf: String = string(width)
		var i: Int = 0
		while i < padding:
			buf = buf.append_char(' ')
			i += 1
		buf.append_str(s)


-- ============================================================================
-- Progress Bar
-- ============================================================================
---
Render a progress bar string.
`current` is the current progress, `total` is the maximum.
`width` is the bar width in characters.

doctests:
    :: Half progress
    bar: String = progress_bar(50, 100, 20)
    bar.length() > 0
---
pure func progress_bar(current: Int, total: Int, width: Int) -> String:
	fraction: Float = if total == 0:
		0.0
	else:
		to_float(current) / to_float(total)
	filled: Int = to_int(fraction * to_float(width))
	var buf: String = string(width + 20)
	buf = buf.append_char('[')
	var i: Int = 0
	while i < width:
		if i < filled:
			buf = buf.append_char('#')
		else:
			buf = buf.append_char('-')
		i += 1
	buf = buf.append_str("] ")
	pct: Int = to_int(fraction * 100.0)
	buf = buf.append_str(pct.to_string())
	buf.append_char('%')
