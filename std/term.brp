-- Term — Terminal formatting (ANSI colors, styles, tables)
--
-- Pure functions for building ANSI-colored strings.
-- All functions return decorated strings — they don't print directly.
--
-- Typical use: import the formatting functions you need from `term`.
-- print(bold("Title") + ": " + green("OK"))
import:
	string: string


-- ============================================================================
-- ANSI Escape Codes
-- ============================================================================
private pure func esc(code: String) -> String:
	"\u{1B}[" + code + "m"


private pure func wrap(code: String, s: String, reset: String) -> String:
	esc(code) + s + esc(reset)


-- ============================================================================
-- Styles
-- ============================================================================
---
Make text bold.

doctests:
    :: Bold wraps with codes
    bold("hi").length() > 2
---
pure func bold(s: String) -> String:
	wrap("1", s, "22")


---
Make text dim.
---
pure func dim(s: String) -> String:
	wrap("2", s, "22")


---
Make text italic.
---
pure func italic(s: String) -> String:
	wrap("3", s, "23")


---
Make text underlined.
---
pure func underline(s: String) -> String:
	wrap("4", s, "24")


---
Make text strikethrough.
---
pure func strikethrough(s: String) -> String:
	wrap("9", s, "29")


-- ============================================================================
-- Foreground Colors
-- ============================================================================
---
Color text red.

doctests:
    :: Red wraps with codes
    red("hi").length() > 2
---
pure func red(s: String) -> String:
	wrap("31", s, "39")


---
Color text green.
---
pure func green(s: String) -> String:
	wrap("32", s, "39")


---
Color text yellow.
---
pure func yellow(s: String) -> String:
	wrap("33", s, "39")


---
Color text blue.
---
pure func blue(s: String) -> String:
	wrap("34", s, "39")


---
Color text magenta.
---
pure func magenta(s: String) -> String:
	wrap("35", s, "39")


---
Color text cyan.
---
pure func cyan(s: String) -> String:
	wrap("36", s, "39")


---
Color text white.
---
pure func white(s: String) -> String:
	wrap("37", s, "39")


---
Color text gray (bright black).
---
pure func gray(s: String) -> String:
	wrap("90", s, "39")


-- ============================================================================
-- Bright Foreground Colors
-- ============================================================================
pure func bright_red(s: String) -> String:
	wrap("91", s, "39")


pure func bright_green(s: String) -> String:
	wrap("92", s, "39")


pure func bright_yellow(s: String) -> String:
	wrap("93", s, "39")


pure func bright_blue(s: String) -> String:
	wrap("94", s, "39")


pure func bright_magenta(s: String) -> String:
	wrap("95", s, "39")


pure func bright_cyan(s: String) -> String:
