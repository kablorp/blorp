import:
	list: append


-- Set - Immutable hash set with COW optimization
--
-- Set[T] is a collection of unique elements with O(1) average
-- membership testing, insertion, and removal.
type Set[T] = builtin


-- Uses separate chaining with ARC and COW optimization.
-- All operations are semantically immutable.
--
-- Supported element types: Int, String (hash/equality provided by runtime)
-- ============================================================================
-- Core Builtins
-- ============================================================================
---
Create an empty Set.

doctests:
    :: Empty set is empty
    s: Set[Int] = set()
    s.is_empty() == True
---
pure func set[T]() -> Set[T]:
	builtin


---
Add an element to the set, returns new set.
No-op if element already present.

doctests:
    :: Add element
    s: Set[Int] = set().add(1)
    s.contains(1) == True
---
pure func add[T](self: Set[T], elem: T) -> Set[T]:
	builtin


---
Remove an element from the set, returns new set.
No-op if element not present.

doctests:
    :: Remove element
    s: Set[Int] = set().add(1)
    s2: Set[Int] = s.remove(1)
    s2.contains(1) == False
---
pure func remove[T](self: Set[T], elem: T) -> Set[T]:
	builtin


---
Check if an element is in the set.

doctests:
    :: Contains existing element
    s: Set[Int] = set().add(42)
    s.contains(42) == True

    :: Does not contain missing element
    s: Set[Int] = set()
    s.contains(99) == False
---
pure func contains[T](self: Set[T], elem: T) -> Bool:
	builtin


-- Internal length for trait implementation.
private pure func length[T](self: Set[T]) -> Int:
	builtin


---
Convert to a list of elements.

doctests:
    :: Convert to list
    s: Set[Int] = set().add(1)
    s.to_list().length() == 1
---
pure func to_list[T](self: Set[T]) -> List[T]:
	builtin


---
Set union: all elements from both sets.

doctests:
    :: Union of sets
    a: Set[Int] = set().add(1)
    b: Set[Int] = set().add(2)
    c: Set[Int] = a.combine(b)
    c.contains(1) == True
---
pure func combine[T](a: Set[T], b: Set[T]) -> Set[T]:
	builtin


---
Set intersection: elements in both sets.

doctests:
    :: Intersection of sets
    a: Set[Int] = set().add(1).add(2)
    b: Set[Int] = set().add(2).add(3)
    c: Set[Int] = a.intersect(b)
    c.contains(2) == True
---
pure func intersect[T](a: Set[T], b: Set[T]) -> Set[T]:
	builtin


---
Set difference: elements in a but not in b.

doctests:
    :: Difference of sets
    a: Set[Int] = set().add(1).add(2)
    b: Set[Int] = set().add(2)
    c: Set[Int] = a.difference(b)
    c.contains(1) == True
---
pure func difference[T](a: Set[T], b: Set[T]) -> Set[T]:
	builtin


---
Set union: alias for combine. Named set_union because union is a keyword.

doctests:
    :: Union of sets
    a: Set[Int] = set().add(1)
    b: Set[Int] = set().add(2)
    c: Set[Int] = a.set_union(b)
    c.contains(1) and c.contains(2)
---
pure func set_union[T](a: Set[T], b: Set[T]) -> Set[T]:
	a.combine(b)


-- ============================================================================
-- Higher-Order Functions
-- ============================================================================
---
Apply a function to each element and collect results into a new set.

doctests:
    :: Map doubles
    s: Set[Int] = [1, 2, 3].from_list()
    result: Set[Int] = s.map(pure func(x: Int): x * 2)
    result.contains(2) and result.contains(4) and result.contains(6)
---
pure func map[T, U](self: Set[T], f: pure (T) -> U) -> Set[U]:
	builtin
---
Transform elements (impure version).
---
func map[T, U](self: Set[T], f: (T) -> U) -> Set[U]:
	builtin


---
Filter elements by predicate.

doctests:
    :: Filter evens
    s: Set[Int] = [1, 2, 3, 4].from_list()
    result: Set[Int] = s.filter(pure func(x: Int): x % 2 == 0)
    result.contains(2) and result.contains(4) and not result.contains(1)
---
pure func filter[T](self: Set[T], pred: pure (T) -> Bool) -> Set[T]:
	builtin
---
Filter elements (impure version).
---
func filter[T](self: Set[T], pred: (T) -> Bool) -> Set[T]:
	builtin


---
Fold over set elements.

doctests:
    :: Sum elements
    s: Set[Int] = [1, 2, 3].from_list()
    s.fold(0, pure func(acc: Int, x: Int): acc + x) == 6
---
pure func fold[T, Acc](self: Set[T], init: Acc, f: pure (Acc, T) -> Acc) -> Acc:
	builtin
---
Fold over set elements (impure version).
---
func fold[T, Acc](self: Set[T], init: Acc, f: (Acc, T) -> Acc) -> Acc:
	builtin


-- ============================================================================
-- Construction
-- ============================================================================
---
Create a Set from a list (duplicates removed).

doctests:
    :: Create from list deduplicates
    s: Set[Int] = [1, 2, 2, 3].from_list()
    s.to_list().length() == 3
---
pure func from_list[T](items: List[T]) -> Set[T]:
	var result: Set[T] = set()
	for i in 0..items.length():
		match items.get(i):
			Some(item): result = result.add(item)
			None: void
	result


-- ============================================================================
-- Extended Operations
-- ============================================================================
---
Check if the set is empty.

doctests:
    :: Empty set is empty
    s: Set[Int] = set()
    s.is_empty() == True

    :: Non-empty set is not empty
    s: Set[Int] = set().add(1)
    s.is_empty() == False
---
pure func is_empty[T](self: Set[T]) -> Bool:
	self.length() == 0


---
Check if a is a subset of b (all elements of a are in b).

doctests:
    :: Subset check
    a: Set[Int] = set().add(1)
    b: Set[Int] = set().add(1).add(2)
    a.is_subset(b) == True
---
pure func is_subset[T](a: Set[T], b: Set[T]) -> Bool:
	builtin


---
Check if a is a superset of b (all elements of b are in a).

doctests:
    :: Superset check
    a: Set[Int] = set().add(1).add(2)
    b: Set[Int] = set().add(1)
    a.is_superset(b) == True
---
pure func is_superset[T](a: Set[T], b: Set[T]) -> Bool:
	b.is_subset(a)


---
Elements in either set but not both (a XOR b).

doctests:
    :: Symmetric difference excludes common elements
    a: Set[Int] = [1, 2, 3].from_list()
    b: Set[Int] = [2, 3, 4].from_list()
    sd: Set[Int] = a.symmetric_difference(b)
    sd.contains(1) and sd.contains(4) and not sd.contains(2)

    :: Empty if sets are equal
    a: Set[Int] = [1, 2].from_list()
    b: Set[Int] = [1, 2].from_list()
    a.symmetric_difference(b).is_empty()

    :: Disjoint sets return union
    a: Set[Int] = [1, 2].from_list()
    b: Set[Int] = [3, 4].from_list()
    a.symmetric_difference(b).length() == 4
---
pure func symmetric_difference[T](a: Set[T], b: Set[T]) -> Set[T]:
	a
		.difference(b)
		.combine(b.difference(a))


-- ============================================================================
-- Trait Implementations
-- ============================================================================
-- Implement HasLength trait for Set
implements HasLength for Set[T]:
	pure func length[T](self: Set[T]) -> Int:
		builtin


-- String conversion
implements Stringable for Set[T:Stringable]:
	pure func to_string[T](self: Set[T]) -> String:
		if self.is_empty():
			"{}"
		else:
			to_string_impl(self)


-- Helper for to_string
private pure func to_string_impl[T:Stringable](self: Set[T]) -> String:
	var parts: List[String] = []
	var items: List[T] = self.to_list()
	for i in 0..items.length():
		match items.get(i):
			Some(item): parts = parts.append(item.to_string())
			None: void
	"{" + parts.join(", ") + "}"
