import:
	float: atan2, cos, pi, sin, sqrt
	tensor: get, get_or, length, set_index, vector


-- FFT - Fast Fourier Transform (Cooley-Tukey radix-2)
--
-- Operates on split real/imaginary vectors. Input length must be a power of 2.
-- Returns (real, imaginary) vector pairs.
--
-- For real-valued signals, pass vector(0.0, N) as the imaginary part.
-- ============================================================================
-- Bit-reversal permutation
-- ============================================================================
---
Compute bit-reversal of index i for an n-element FFT.

doctests:
    :: Index 0 stays at 0
    bit_reverse(0, 8) == 0

    :: Index 1 maps to 4
    bit_reverse(1, 8) == 4

    :: Index 3 maps to 6
    bit_reverse(3, 8) == 6
---
pure func bit_reverse(i: Int, n: Int) -> Int:
	var bits: Int = 0
	var tmp: Int = n / 2
	while tmp > 0:
		bits += 1
		tmp /= 2
	var val: Int = i
	var result: Int = 0
	var step: Int = 0
	while step < bits:
		result = result * 2 + val % 2
		val /= 2
		step += 1
	result


---
Apply bit-reversal permutation to real and imaginary vectors.
---
private pure func bit_reverse_copy[#N](re: Float[#N], im: Float[#N]) -> (Float[#N], Float[#N]):
	n: Int = re.length()
	var out_re: Float[#N] = vector(0.0, n)
	var out_im: Float[#N] = vector(0.0, n)
	for i in 0..out_re.length():
		rev: Int = bit_reverse(i, n)

		-- rev is algorithmically in [0, n) but the compiler can't prove it;
		-- use get() for the runtime-checked access.
		match re.get(rev):
			Some(v): out_re[i] = v
			None: void
		match im.get(rev):
			Some(v): out_im[i] = v
			None: void
	(out_re, out_im)


-- ============================================================================
-- Core FFT
-- ============================================================================
---
Forward FFT (Cooley-Tukey radix-2, decimation-in-time).

Input length must be a power of 2. Returns (real, imaginary) frequency-domain
vectors of the same length.

For real-valued signals, pass vector(0.0, N) as the imaginary input.
---
func fft[#N](re: Float[#N], im: Float[#N]) -> (Float[#N], Float[#N]):
	n: Int = re.length()
	br: (Float[#N], Float[#N]) = bit_reverse_copy(re, im)
	var xr: Float[#N] = br.0
	var xi: Float[#N] = br.1

	-- Butterfly stages: size doubles each stage (2, 4, 8, ..., n)
	var sz: Int = 2
	while sz <= n:
		half: Int = sz / 2
		angle: Float = -2.0 * pi() / to_float(sz)
		var g: Int = 0
		while g < n:
			for k in 0..half:
				idx_top: Int = g + k
				idx_bot: Int = g + k + half
				tw_angle: Float = angle * to_float(k)
				tw_re: Float = cos(tw_angle)
				tw_im: Float = sin(tw_angle)

				-- idx_top and idx_bot are algorithmically in [0, n) but the
				-- compiler can't prove that from the surrounding arithmetic;
				-- use get/set_index for runtime-checked access.
				bot_re: Float = xr.get_or(idx_bot, 0.0)
				bot_im: Float = xi.get_or(idx_bot, 0.0)
				tr: Float = tw_re * bot_re - tw_im * bot_im
				ti: Float = tw_re * bot_im + tw_im * bot_re
				top_re: Float = xr.get_or(idx_top, 0.0)
				top_im: Float = xi.get_or(idx_top, 0.0)
				match xr.set_index(idx_top, top_re + tr):
					Some(v): xr = v
					None: void
				match xi.set_index(idx_top, top_im + ti):
					Some(v): xi = v
					None: void
				match xr.set_index(idx_bot, top_re - tr):
					Some(v): xr = v
					None: void
				match xi.set_index(idx_bot, top_im - ti):
					Some(v): xi = v
					None: void
			g += sz
		sz *= 2
	(xr, xi)


---
Inverse FFT. Recovers the time-domain signal from frequency-domain vectors.

Conjugate input, apply forward FFT, conjugate and scale by 1/N.
---
func ifft[#N](re: Float[#N], im: Float[#N]) -> (Float[#N], Float[#N]):
	n: Int = re.length()
	scale: Float = 1.0 / to_float(n)

	-- Conjugate imaginary part
	var neg_im: Float[#N] = vector(0.0, n)
	for i in 0..neg_im.length():
		neg_im[i] = -im[i]

	-- Forward FFT on conjugated input
	result: (Float[#N], Float[#N]) = fft(re, neg_im)

	-- Conjugate and scale output
	var out_re: Float[#N] = vector(0.0, n)
	var out_im: Float[#N] = vector(0.0, n)
	for i in 0..out_re.length():
		out_re[i] = result.0[i] * scale
		out_im[i] = -result.1[i] * scale
	(out_re, out_im)


-- ============================================================================
-- Spectral analysis
-- ============================================================================
---
Magnitude spectrum: sqrt(re^2 + im^2) for each frequency bin.
---
pure func fft_magnitude[#N](re: Float[#N], im: Float[#N]) -> Float[#N]:
	var result: Float[#N] = vector(0.0, re.length())
	for i in 0..result.length():
		r: Float = re[i]
		m: Float = im[i]
		result[i] = sqrt(r * r + m * m)
	result


---
Power spectrum: re^2 + im^2 for each bin. Avoids the sqrt of magnitude.
---
pure func fft_power[#N](re: Float[#N], im: Float[#N]) -> Float[#N]:
	var result: Float[#N] = vector(0.0, re.length())
	for i in 0..result.length():
		r: Float = re[i]
		m: Float = im[i]
		result[i] = r * r + m * m
	result


---
Phase spectrum: atan2(im, re) for each bin. Returns radians in (-pi, pi].
---
pure func fft_phase[#N](re: Float[#N], im: Float[#N]) -> Float[#N]:
	var result: Float[#N] = vector(0.0, re.length())
	for i in 0..result.length():
		result[i] = atan2(im[i], re[i])
	result


---
Spectral centroid: the amplitude-weighted mean frequency.
Indicates the "brightness" of a signal. Returns Hz.
---
pure func spectral_centroid[#N](re: Float[#N], im: Float[#N], sample_rate: Float) -> Float:
	n: Int = re.length()
	n_half: Int = n / 2
	var weight_sum: Float = 0.0
	var mag_sum: Float = 0.0
	for i in 0..re.length():
		if i >= n_half:
			void
		else:
			r: Float = re[i]
			m: Float = im[i]
			mag: Float = sqrt(r * r + m * m)
			freq: Float = to_float(i) * sample_rate / to_float(n)
			weight_sum += freq * mag
			mag_sum += mag
	if mag_sum > 0.0:
		weight_sum / mag_sum
	else:
		0.0


-- ============================================================================
-- Convolution
-- ============================================================================
---
Smallest power of 2 >= n.
---
pure func next_pow2(n: Int) -> Int:
	var p: Int = 1
	while p < n:
		p *= 2
	p


---
Convolve a statically-sized signal with a runtime-sized kernel (impulse
response). The kernel is a List[Float] because its length is typically not
known at compile time (e.g. loaded from a WAV file at runtime).

Returns a Vector of length #N — the "valid" output aligned with the input
(no extra tail from the IR ringing out).

Implementation: direct O(N*K) convolution. Adequate for cabinet IRs in the
few-thousand-sample range at typical audio block sizes. For much longer
kernels, an overlap-add FFT implementation would be faster but requires
runtime-sized Vector support (not available today — the FFT primitives only
accept statically-dimensioned Float[#N]).
---
func fft_convolve[#N](signal: Float[#N], kernel: List[Float]) -> Float[#N]:
	kern_len: Int = kernel.length()
	var output: Float[#N] = vector(0.0, signal.length())
	if kern_len == 0:
		output
	else:
		for i in 0..output.length():
			var acc: Float = 0.0

			-- output[i] = sum_{k=0..kern_len} kernel[k] * signal[i-k]
			-- where samples with i-k < 0 are zero (causal).
			var k: Int = 0
			while k < kern_len and k <= i:
				ksig: Int = i - k

				-- ksig is in [0, i] ⊆ [0, #N) but the compiler can't
				-- prove the bound from the arithmetic; use get().
				sk: Float = signal.get_or(ksig, 0.0)
				match kernel.get(k):
					Some(kv): acc += sk * kv
					None: void
				k += 1
			output[i] = acc
		output
