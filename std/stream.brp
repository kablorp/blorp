-- Stream - Lazy, composable sequences
--
-- Streams process elements one at a time with constant memory.
-- Created from sources (lists, ranges, files), transformed with
-- intermediate operations (map, filter, take), and consumed with
-- terminal operations (collect, fold, count).
--
-- All intermediate operations are lazy — they build a pipeline
-- description that only executes when a terminal operation runs.
-- Streams are one-shot cursors with mutable pull state. The compiler rejects
-- binding them globally, storing them in ordinary aggregates or ordinary
-- carrier type aliases/ascriptions, binding carrier values such as
-- Option[Stream[T]], using ordinary function signatures that contain stream
-- carriers, using function values whose parameters or return values hide
-- stream carriers, and capturing them in closures, detach bodies, and
-- concurrent task bodies. Generic records and unions are checked after
-- substitution, so the rule follows their actual fields or variants. Keep
-- streams in direct local bindings, then consume them with terminal stream
-- operations. Direct producer functions such as () -> Stream[T] are ordinary
-- values.
--
-- Implementation: Stream[T] is a builtin type backed by a C-level
-- iterator with a pull function and opaque state. Closures for
-- map/filter callbacks are stored in the stream's state.
type Stream[T] = builtin


---
A lazy, one-shot stream whose pull operation may fail with `E`.

Fallible streams are intended for I/O-backed sources. Terminal operations
return `Result` so read errors are explicit instead of being confused with
normal end-of-stream.

Like `Stream[T]`, a `FallibleStream[T, E]` is a one-shot cursor. Consume it in
the scope where it was created; do not store it in ordinary aggregates or
ordinary carrier type aliases/ascriptions, do not bind carrier values such as
`Option[FallibleStream[T, E]]`, do not use ordinary function signatures that
contain fallible-stream carriers, do not use function values whose parameters
or return values hide fallible-stream carriers, and do not capture it in
closures, detach bodies, or concurrent task bodies.
---
type FallibleStream[T, E] = builtin


---
A future resource-producing source.

`ResourceSource[R, E]` is a type anchor for APIs such as TCP listener
connections and database pool checkouts that produce owned resources one at a
time. It is intentionally not an ordinary collection: it cannot be stored in
records, unions, lists, globals, type aliases that hide it inside ordinary
carriers, ordinary carrier type ascriptions such as
`None as Option[ResourceSource[...]]`, or ordinary local bindings such as
`Option[ResourceSource[...]]`, and ordinary user functions cannot accept or
return it yet. Function values may directly produce resource sources, but their
parameters and return values cannot hide resource sources in ordinary carriers
such as `() -> Option[ResourceSource[R, E]]`. Sequential `for` iteration
transfers each produced resource into a scoped loop body that owns its cleanup.
`for ... concurrently(limit: N)` moves each produced resource into exactly one
child task; the child task owns scoped cleanup before user code can park. Direct
source locals must be immutable, must come from producer calls rather than
copies of existing source locals, and must not be discarded or returned from
concurrent tasks. Generic record and union wrappers are checked after
substitution, so direct resource-source producers remain ordinary while hidden
carriers are rejected.
---
type ResourceSource[R, E] = builtin


-- ============================================================================
-- Sources (constructors)
-- ============================================================================
---
Create a stream from a list. Iterates elements in order, constant memory.

doctests:
    :: Stream from list
    from_list([1, 2, 3]).collect() == [1, 2, 3]
---
func from_list[T](items: List[T]) -> Stream[T]:
	builtin


---
Create a stream of integers from start (inclusive) to end (exclusive).

doctests:
    :: Range stream
    from_range(0, 3).collect() == [0, 1, 2]
---
func from_range(start: Int, end: Int) -> Stream[Int]:
	builtin


---
Create an infinite stream that repeats a value.
Must be consumed with take() or another limiting operation.
---
func repeat[T](value: T) -> Stream[T]:
	builtin


---
Create a stream by repeatedly applying a function to a state.
Returns Some((value, next_state)) to yield, None to end.

---
func unfold[T, S](
	seed: S,
	f: (S) -> Option[(T, S)],
) -> Stream[T]:
	builtin


---
Create an empty stream.
---
func empty[T]() -> Stream[T]:
	builtin


-- ============================================================================
-- Intermediate operations (lazy)
-- ============================================================================
---
Transform each element. Lazy.

doctests:
    :: Map doubles
    from_list([1, 2, 3])
        .map(func(x: Int): x * 2)
        .collect() == [2, 4, 6]
---
func map[T, U](
	self: Stream[T],
	f: (T) -> U,
) -> Stream[U]:
	builtin


---
Keep only elements where predicate returns True. Lazy.

doctests:
    :: Filter evens
    from_list([1, 2, 3, 4])
        .filter(func(x: Int): x % 2 == 0)
        .collect() == [2, 4]
---
func filter[T](
	self: Stream[T],
	pred: (T) -> Bool,
) -> Stream[T]:
	builtin


---
Filter and map in one pass. Keeps only Some results.
---
func filter_map[T, U](
	self: Stream[T],
	f: (T) -> Option[U],
) -> Stream[U]:
	builtin


---
Take at most n elements.

doctests:
    :: Take 2
    from_list([1, 2, 3, 4])
        .take(2)
        .collect() == [1, 2]
---
func take[T](self: Stream[T], n: Int) -> Stream[T]:
	builtin


---
Skip the first n elements.

doctests:
    :: Drop 2
    from_list([1, 2, 3, 4])
        .drop(2)
        .collect() == [3, 4]
---
func drop[T](self: Stream[T], n: Int) -> Stream[T]:
	builtin


---
Take elements while predicate returns True. Stops at first False.
---
func take_while[T](
	self: Stream[T],
	pred: (T) -> Bool,
) -> Stream[T]:
	builtin


---
Pair each element with its index (0-based).
---
func enumerate[T](self: Stream[T]) -> Stream[(Int, T)]:
	builtin


-- ============================================================================
-- Terminal operations (consume the stream)
-- ============================================================================
---
Collect all elements into a List.

doctests:
    :: Collect
    from_list([1, 2]).collect() == [1, 2]
---
func collect[T](self: Stream[T]) -> List[T]:
	builtin


---
Collect all elements from a fallible stream into a List.

If the source reports an error while pulling, returns `Err(error)` and discards
the partially collected list.
---
@resource_result_ordinary
func collect_result[T, E](self: FallibleStream[T, E]) -> Result[List[T], E]:
	builtin("blorp_fallible_stream_collect_raw")


---
Fold a fallible stream with an accumulator.

Stops at the first source error and returns `Err(error)`. Otherwise returns the
final accumulator in `Ok`.
---
@resource_result_ordinary
func fold_result[T, Acc, E](
	self: FallibleStream[T, E],
	init: Acc,
	f: (Acc, T) -> Acc,
) -> Result[Acc, E]:
	builtin("blorp_fallible_stream_fold_raw")


---
Fold (reduce) the stream with an accumulator.
---
func fold[T, Acc](
	self: Stream[T],
	init: Acc,
	f: (Acc, T) -> Acc,
) -> Acc:
	builtin


---
Count the number of elements.
---
func count[T](self: Stream[T]) -> Int:
	builtin


---
Count the number of elements in a fallible stream.

Stops at the first source error and returns `Err(error)`.
---
@resource_result_ordinary
func count_result[T, E](self: FallibleStream[T, E]) -> Result[Int, E]:
	builtin("blorp_fallible_stream_count_raw")


---
Apply a side-effecting function to each element.
---
func for_each[T](
	self: Stream[T],
	f: (T) -> Void,
) -> Void:
	builtin


---
Find the first element matching a predicate.
---
func find[T](
	self: Stream[T],
	pred: (T) -> Bool,
) -> Option[T]:
	builtin


---
Find the first element matching a predicate in a fallible stream.

Returns `Ok(Some(value))` for the first match, `Ok(None)` if the stream ends
normally with no match, or `Err(error)` if the source reports an error.
The result preserves the concrete `Option[T]` layout, including primitive,
managed, and nested-option payloads.
---
@resource_result_ordinary
func find_result[T, E](
	self: FallibleStream[T, E],
	pred: (T) -> Bool,
) -> Result[Option[T], E]:
	builtin("blorp_fallible_stream_find_raw")


---
Check if any element satisfies the predicate. Short-circuits.
---
func any[T](
	self: Stream[T],
	pred: (T) -> Bool,
) -> Bool:
	builtin


---
Check if any element in a fallible stream satisfies the predicate.

Short-circuits on the first matching element or the first source error.
---
@resource_result_ordinary
func any_result[T, E](
	self: FallibleStream[T, E],
	pred: (T) -> Bool,
) -> Result[Bool, E]:
	builtin("blorp_fallible_stream_any_raw")


---
Check if all elements satisfy the predicate. Short-circuits.
---
func all[T](
	self: Stream[T],
	pred: (T) -> Bool,
) -> Bool:
	builtin


---
Check if all elements in a fallible stream satisfy the predicate.

Short-circuits on the first non-matching element or the first source error.
---
@resource_result_ordinary
func all_result[T, E](
	self: FallibleStream[T, E],
	pred: (T) -> Bool,
) -> Result[Bool, E]:
	builtin("blorp_fallible_stream_all_raw")
