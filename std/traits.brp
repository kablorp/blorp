-- Standard Library Traits
--
-- Traits define requirements for generic type parameters.
-- Each trait contains method signatures that implementers must provide.
-- ============================================================================
-- Core Traits
-- ============================================================================
-- String Representation
trait Stringable:
	pure func to_string(value: Self) -> String


-- Arithmetic Operations
trait Addable:
	pure func add(a: Self, b: Self) -> Self


trait Subtractable:
	pure func subtract(a: Self, b: Self) -> Self


trait Multipliable:
	pure func multiply(a: Self, b: Self) -> Self


trait Divisible:
	pure func divide(a: Self, b: Self) -> Self


trait Modulable:
	pure func remainder(a: Self, b: Self) -> Self


trait Negatable:
	pure func negate(a: Self) -> Self


-- Zero and One values for numeric operations
trait HasZero:
	pure func zero() -> Self


trait HasOne:
	pure func one() -> Self


-- Comparison Operations
--
-- `not_equals` has a default derived from `equals`; implementations only need
-- to provide `equals`. The compiler synthesizes `not_equals` via trait default bodies.
trait Equatable:
	pure func equals(a: Self, b: Self) -> Bool
	pure func not_equals(a: Self, b: Self) -> Bool: not equals(a, b)


-- `Orderable` requires `Equatable` as a supertrait, matching
-- Rust/Haskell/Swift/C++. Total ordering defines equality via
-- antisymmetry (a <= b and b <= a implies a == b), so every ordered
-- type is also equatable — this prevents the Java footgun of ordering
-- that is inconsistent with equals. `greater_than`, `less_than_or_equal`, and
-- `greater_than_or_equal` default to expressions over `less_than` alone.
trait Orderable: Equatable:
	pure func less_than(a: Self, b: Self) -> Bool
	pure func greater_than(a: Self, b: Self) -> Bool: less_than(b, a)
	pure func less_than_or_equal(a: Self, b: Self) -> Bool: not less_than(b, a)
	pure func greater_than_or_equal(a: Self, b: Self) -> Bool: not less_than(a, b)


-- Absolute Value
trait Absolute:
	pure func abs(value: Self) -> Self


-- Min/Max Operations
trait Bounded:
	pure func min(a: Self, b: Self) -> Self
	pure func max(a: Self, b: Self) -> Self


-- Hash Operations
--
-- `Hashable` requires `Equatable` as a supertrait: the contract is
-- that `a == b` implies `hash(a) == hash(b)`, which is meaningless
-- without an equality relation. Blorp's built-in Dict and Set use
-- an internal HashDoS-resistant seeded hash for primitive keys;
-- this trait is the extension point for user types. The returned
-- Int is an implementation-defined hash value — relying on its
-- absolute value across runs is a bug (the runtime seeds hashers
-- at process start). For cryptographic hashing (SHA-256 etc.), see
-- `hash.brp`.
trait Hashable: Equatable:
	pure func hash(self: Self) -> Int


-- Collection Operations
trait HasLength:
	pure func length(coll: Self) -> Int


trait ToBool:
	pure func to_bool(value: Self) -> Bool


-- Logical Operations
trait Logical:
	pure func logical_and(a: Self, b: Self) -> Self
	pure func logical_or(a: Self, b: Self) -> Self
	pure func logical_not(a: Self) -> Self


-- Type Conversions
trait ToInt:
	pure func to_int(value: Self) -> Int


trait ToFloat:
	pure func to_float(value: Self) -> Float


trait ToFixed:
	pure func to_fixed(value: Self) -> Fixed


trait ToChar:
	pure func to_char(value: Self) -> Char


-- ============================================================================
-- Numeric Type Family Traits
-- ============================================================================
-- Integer family: Int, Int8..Int128, UInt8..UInt128
trait Integer: Addable + Subtractable + Multipliable + Divisible + Modulable + Orderable + HasZero + HasOne + Stringable + Absolute + Bounded + ToInt:
	pure func checked_div(a: Self, b: Self) -> Option[Self]
	pure func checked_mod(a: Self, b: Self) -> Option[Self]
	pure func bit_and(a: Self, b: Self) -> Self
	pure func bit_or(a: Self, b: Self) -> Self
	pure func bit_xor(a: Self, b: Self) -> Self
	pure func bit_not(a: Self) -> Self
	pure func shift_left(a: Self, n: Int) -> Self
	pure func shift_right(a: Self, n: Int) -> Self


trait SignedInteger: Integer + Negatable


trait UnsignedInteger: Integer


-- FloatingPoint family: Float, Float32, Float16
trait FloatingPoint: Addable + Subtractable + Multipliable + Divisible + Negatable + Orderable + HasZero + HasOne + Stringable + Absolute + Bounded + ToFloat:
	pure func floor(x: Self) -> Self
	pure func ceil(x: Self) -> Self
	pure func round(x: Self) -> Self
	pure func trunc(x: Self) -> Self
	pure func sqrt(x: Self) -> Self
	pure func sin(x: Self) -> Self
	pure func cos(x: Self) -> Self
	pure func tan(x: Self) -> Self
	pure func exp(x: Self) -> Self
	pure func log(x: Self) -> Self
	pure func pow(x: Self, y: Self) -> Self
	pure func is_nan(x: Self) -> Bool
	pure func is_inf(x: Self) -> Bool
	pure func is_finite(x: Self) -> Bool


-- Numeric: the minimal bound for numeric operations
-- (dot product, reductions, etc.). Any type that supports addition,
-- multiplication, and has a zero element qualifies.
trait Numeric: Addable + Multipliable + HasZero


-- MatrixNumeric: element types with dedicated matrix-kernel runtime support.
-- This is intentionally narrower than Numeric: fixed-shape matrix kernels have
-- typed backend loops, so unsupported Numeric types should fail in typechecking
-- rather than later in Core specialization.
trait MatrixNumeric: Numeric


-- FixedPoint family: Fixed
trait FixedPoint: Addable + Subtractable + Multipliable + Divisible + Orderable + HasZero + Stringable + Absolute + Bounded:
	pure func get_scale(x: Self) -> Int
	pure func round_to(x: Self, s: Int) -> Self


-- Copying
trait Copyable:
	pure func copy(value: Self) -> Self


trait Cloneable:
	func clone(value: Self) -> Self
-- ============================================================================
-- Usage Examples
-- ============================================================================
--
-- Generic function with single trait bound:
-- pure func sum[T: Addable + HasZero](list: List[T]) -> T:
-- var result: T = zero()
-- for item in list:
-- result = add(result, item)
-- result
--
-- Implementing a trait for a type:
-- implements Stringable for Vector2:
-- pure func to_string(value: Vector2) -> String:
-- "Vector2(" + value.x.to_string() + ", " + value.y.to_string() + ")"
--
-- implements Addable for Vector2:
-- pure func add(a: Vector2, b: Vector2) -> Vector2:
-- Vector2 { x = a.x + b.x, y = a.y + b.y }
