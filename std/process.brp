-- Process - Spawn and capture output of external processes
--
-- Provides safe process spawning with stdout/stderr capture.
-- Uses posix_spawnp internally (no shell injection risk for run()).
-- shell() is provided for convenience but runs via /bin/sh.
-- ============================================================================
-- Process Output Type
-- ============================================================================
-- ProcessOutput is a tuple: (stdout: String, stderr: String, exit_code: Int)
-- Access fields via .0 (stdout), .1 (stderr), .2 (exit_code)
-- ============================================================================
-- Core Functions (builtins)
-- ============================================================================
---
Run a program with arguments. Captures stdout and stderr.
Returns a tuple of (stdout, stderr, exit_code).
Uses posix_spawnp, so the program is looked up in PATH.

doctests:
    :: Run echo
    r: Result[(String, String, Int), String] = run("echo", ["hello"])
    match r:
        Ok(out): out.2 == 0
        Err(_): False
---
func run(program: String, args: List[String]) -> Result[(String, String, Int), String]:
	process_run(program, args)


---
Run a shell command via /bin/sh -c. Captures stdout and stderr.
Returns a tuple of (stdout, stderr, exit_code).

WARNING: This function passes the command to a shell. Do NOT use
with untrusted input — use run() instead to avoid shell injection.

doctests:
    :: Shell echo
    r: Result[(String, String, Int), String] = shell("echo hello")
    match r:
        Ok(out): out.2 == 0
        Err(_): False
---
func shell(command: String) -> Result[(String, String, Int), String]:
	process_shell(command)


-- ============================================================================
-- Builtins (internal)
-- ============================================================================
private func process_run(
	program: String,
	args: List[String],
) -> Result[(String, String, Int), String]:
	builtin("blorp_process_run")


private func process_shell(command: String) -> Result[(String, String, Int), String]:
	builtin("blorp_process_shell")


-- ============================================================================
-- Unix Signal Handling
-- ============================================================================
---
Signal number for SIGHUP (hangup).
---
pure func sig_hup() -> Int:
	1


---
Signal number for SIGINT (interrupt, Ctrl-C).
---
pure func sig_int() -> Int:
	2


---
Signal number for SIGTERM (termination).
---
pure func sig_term() -> Int:
	15


---
Signal number for SIGUSR1 (user-defined 1).
---
pure func sig_usr1() -> Int:
	10


---
Signal number for SIGUSR2 (user-defined 2).
---
pure func sig_usr2() -> Int:
	12


private func signal_on_builtin(signum: Int, handler: () -> Void) -> Void:
	builtin("blorp_signal_on")


private func signal_received_builtin(signum: Int) -> Bool:
	builtin("blorp_signal_received")


private func signal_raise_builtin(signum: Int) -> Void:
	builtin("blorp_signal_raise")


---
Register a handler for a Unix signal. The handler runs asynchronously
on the thread pool when the signal is received.

doctests:
    :: Signal constants are correct
    sig_int() == 2
---
func on_signal(signum: Int, handler: () -> Void) -> Void:
	signal_on_builtin(signum, handler)


---
Register a handler for SIGINT (Ctrl-C).
---
func on_interrupt(handler: () -> Void) -> Void:
	signal_on_builtin(2, handler)


---
Register a handler for SIGTERM.
---
func on_terminate(handler: () -> Void) -> Void:
	signal_on_builtin(15, handler)


---
Check if a signal was received since last check (clears the flag).
---
func signal_received(signum: Int) -> Bool:
	signal_received_builtin(signum)


---
Raise a signal (send to own process). Useful for testing.
---
func raise_signal(signum: Int) -> Void:
	signal_raise_builtin(signum)
