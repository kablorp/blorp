-- Tuple — trait implementations for fixed-size heterogeneous collections.
--
-- Tuples are a surface-level language construct (2-4 elements, structural
-- `(a, b)` / `[0]` / `(a, b) = t`). This module adds `Equatable`, `Stringable`,
-- and `Orderable` impls so bare `a == b`, `to_string(t)`, and `a < b` work on
-- tuples with no extra ceremony at the call site.
--
-- Scope: arities 2, 3, and 4 (matches the current parser cap). If the cap
-- changes, add matching arity-5+ impls here.
--
-- Bounds are declared once in the `implements ... for (...)` clause; method
-- signatures inherit them. Calling a trait method on a tuple whose elements
-- don't satisfy the bound produces a standard "does not implement trait"
-- typecheck error naming the offending element's type.
-- ============================================================================
-- Stringable
-- ============================================================================
--
-- Format: "(e0, e1, ...)" — comma + single space, parens wrapping. Matches
-- Python / Rust / OCaml repr convention.
implements Stringable for (A:Stringable, B:Stringable):
	pure func to_string(t: (A, B)) -> String:
		"(" + t[0].to_string() + ", " + t[1].to_string() + ")"


implements Stringable for (A:Stringable, B:Stringable, C:Stringable):
	pure func to_string(t: (A, B, C)) -> String:
		"(" + t[0].to_string() + ", " + t[1].to_string() + ", " + t[2].to_string() + ")"


implements Stringable for (A:Stringable, B:Stringable, C:Stringable, D:Stringable):
	pure func to_string(t: (A, B, C, D)) -> String:
		"(" + t[0].to_string() + ", " + t[1].to_string() + ", " + t[2].to_string() + ", " + t[3].to_string() + ")"


-- ============================================================================
-- Equatable
-- ============================================================================
--
-- Pairwise equality. Two tuples are equal iff all corresponding fields are
-- equal. `not_equals` derives from `equals` via the default trait method body.
implements Equatable for (A:Equatable, B:Equatable):
	pure func equals(a: (A, B), b: (A, B)) -> Bool:
		a[0] == b[0] and a[1] == b[1]


implements Equatable for (A:Equatable, B:Equatable, C:Equatable):
	pure func equals(a: (A, B, C), b: (A, B, C)) -> Bool:
		a[0] == b[0] and a[1] == b[1] and a[2] == b[2]


implements Equatable for (A:Equatable, B:Equatable, C:Equatable, D:Equatable):
	pure func equals(a: (A, B, C, D), b: (A, B, C, D)) -> Bool:
		a[0] == b[0] and a[1] == b[1] and a[2] == b[2] and a[3] == b[3]


-- ============================================================================
-- Orderable
-- ============================================================================
--
-- Lexicographic ordering: compare elements left-to-right, first difference
-- wins. The non-strict comparison methods default via the trait bodies
-- expressed over `less_than` alone. Only `Orderable` is needed as a bound:
-- `Orderable: Equatable`
-- supertrait relationship (traits.brp) means each element's type
-- automatically satisfies `Equatable` for the `!=` operator below. The
-- supertrait graph is globally resolvable once the `traits` module is
-- loaded, so tuple.brp doesn't need to import it.
implements Orderable for (A:Orderable, B:Orderable):
	pure func less_than(a: (A, B), b: (A, B)) -> Bool:
		if a[0] != b[0]:
			a[0] < b[0]
		else:
			a[1] < b[1]


implements Orderable for (A:Orderable, B:Orderable, C:Orderable):
	pure func less_than(a: (A, B, C), b: (A, B, C)) -> Bool:
		if a[0] != b[0]:
			a[0] < b[0]
		else if a[1] != b[1]:
			a[1] < b[1]
		else:
			a[2] < b[2]


implements Orderable for (A:Orderable, B:Orderable, C:Orderable, D:Orderable):
	pure func less_than(a: (A, B, C, D), b: (A, B, C, D)) -> Bool:
		if a[0] != b[0]:
			a[0] < b[0]
		else if a[1] != b[1]:
			a[1] < b[1]
		else if a[2] != b[2]:
			a[2] < b[2]
		else:
			a[3] < b[3]
