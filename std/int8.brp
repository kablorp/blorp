-- Int8 - Trait Implementations
--
-- Signed 8-bit integer type.
type Int8 = builtin


implements Stringable for Int8:
	pure func to_string(val: Int8) -> String:
		builtin("blorp_to_string")


implements Equatable for Int8:
	pure func equals(a: Int8, b: Int8) -> Bool:
		a == b

	pure func not_equals(a: Int8, b: Int8) -> Bool:
		a != b


implements Orderable for Int8:
	pure func less_than(a: Int8, b: Int8) -> Bool:
		a < b

	pure func greater_than(a: Int8, b: Int8) -> Bool:
		a > b

	pure func less_than_or_equal(a: Int8, b: Int8) -> Bool:
		a <= b

	pure func greater_than_or_equal(a: Int8, b: Int8) -> Bool:
		a >= b


implements Bounded for Int8:
	pure func min(a: Int8, b: Int8) -> Int8:
		match a < b:
			True: a
			_: b

	pure func max(a: Int8, b: Int8) -> Int8:
		match a > b:
			True: a
			_: b


implements Absolute for Int8:
	pure func abs(val: Int8) -> Int8:
		match val < to_int8(0):
			True: -val
			_: val


implements Negatable for Int8:
	pure func negate(a: Int8) -> Int8:
		-a


implements HasZero for Int8:
	pure func zero() -> Int8:
		to_int8(0)


implements HasOne for Int8:
	pure func one() -> Int8:
		to_int8(1)


implements ToBool for Int8:
	pure func to_bool(val: Int8) -> Bool:
		val != to_int8(0)


implements ToInt for Int8:
	pure func to_int(val: Int8) -> Int:
		to_int(val)


implements Addable for Int8:
	pure func add(a: Int8, b: Int8) -> Int8:
		a + b


implements Subtractable for Int8:
	pure func subtract(a: Int8, b: Int8) -> Int8:
		a - b


implements Multipliable for Int8:
	pure func multiply(a: Int8, b: Int8) -> Int8:
		a * b


implements Divisible for Int8:
	pure func divide(a: Int8, b: Int8) -> Int8:
		a / b


implements Modulable for Int8:
	pure func remainder(a: Int8, b: Int8) -> Int8:
		a % b
