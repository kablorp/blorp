-- Float32 - Trait Implementations
--
-- 32-bit single-precision floating-point type.
type Float32 = builtin


implements Stringable for Float32:
	pure func to_string(val: Float32) -> String:
		builtin("blorp_float32_to_string")


implements Equatable for Float32:
	pure func equals(a: Float32, b: Float32) -> Bool:
		a == b

	pure func not_equals(a: Float32, b: Float32) -> Bool:
		a != b


implements Orderable for Float32:
	pure func less_than(a: Float32, b: Float32) -> Bool:
		a < b

	pure func greater_than(a: Float32, b: Float32) -> Bool:
		a > b

	pure func less_than_or_equal(a: Float32, b: Float32) -> Bool:
		a <= b

	pure func greater_than_or_equal(a: Float32, b: Float32) -> Bool:
		a >= b


implements Bounded for Float32:
	pure func min(a: Float32, b: Float32) -> Float32:
		match a < b:
			True: a
			_: b

	pure func max(a: Float32, b: Float32) -> Float32:
		match a > b:
			True: a
			_: b


implements Absolute for Float32:
	pure func abs(val: Float32) -> Float32:
		match val < to_float32(0):
			True: -val
			_: val


implements Negatable for Float32:
	pure func negate(a: Float32) -> Float32:
		-a


implements HasZero for Float32:
	pure func zero() -> Float32:
		to_float32(0)


implements HasOne for Float32:
	pure func one() -> Float32:
		to_float32(1)


implements ToBool for Float32:
	pure func to_bool(val: Float32) -> Bool:
		val != to_float32(0)


implements ToInt for Float32:
	pure func to_int(val: Float32) -> Int:
		to_int(val)


implements ToFloat for Float32:
	pure func to_float(val: Float32) -> Float:
		to_float(val)


implements Addable for Float32:
	pure func add(a: Float32, b: Float32) -> Float32:
		a + b


implements Subtractable for Float32:
	pure func subtract(a: Float32, b: Float32) -> Float32:
		a - b


implements Multipliable for Float32:
	pure func multiply(a: Float32, b: Float32) -> Float32:
		a * b


implements Divisible for Float32:
	pure func divide(a: Float32, b: Float32) -> Float32:
		a / b


implements Numeric for Float32:
	pure func __numeric_marker() -> Float32:
		to_float32(0)
-- marker trait: all methods inherited from super-traits
