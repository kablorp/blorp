-- MIME Types - Common MIME type lookups
--
-- Maps file extensions to MIME types and vice versa.
-- All functions are pure.
-- ============================================================================
-- Extension → MIME Type
-- ============================================================================
---
Get the MIME type for a file extension (without dot).
Returns "application/octet-stream" for unknown extensions.

doctests:
    :: HTML extension
    from_extension("html") == "text/html"

    :: JSON extension
    from_extension("json") == "application/json"

    :: Unknown extension
    from_extension("xyz") == "application/octet-stream"

    :: Case insensitive
    from_extension("HTML") == "text/html"
---
pure func from_extension(ext: String) -> String:
	e: String = ext.lower()

	if e == "html" or e == "htm":
		"text/html"
	else if e == "css":
		"text/css"
	else if e == "js" or e == "mjs":
		"text/javascript"
	else if e == "json":
		"application/json"
	else if e == "xml":
		"application/xml"
	else if e == "txt":
		"text/plain"
	else if e == "csv":
		"text/csv"
	else if e == "md":
		"text/markdown"
	else if e == "yaml" or e == "yml":
		"text/yaml"
	else if e == "toml":
		"application/toml"
	else:
		from_extension_media(e)


private pure func from_extension_media(e: String) -> String:
	if e == "png":
		"image/png"
	else if e == "jpg" or e == "jpeg":
		"image/jpeg"
	else if e == "gif":
		"image/gif"
	else if e == "svg":
		"image/svg+xml"
	else if e == "ico":
		"image/x-icon"
	else if e == "webp":
		"image/webp"
	else if e == "avif":
		"image/avif"
	else if e == "bmp":
		"image/bmp"
	else if e == "mp3":
		"audio/mpeg"
	else if e == "wav":
		"audio/wav"
	else if e == "ogg":
		"audio/ogg"
	else if e == "flac":
		"audio/flac"
	else if e == "mp4":
		"video/mp4"
	else if e == "webm":
		"video/webm"
	else if e == "avi":
		"video/x-msvideo"
	else if e == "mov":
		"video/quicktime"
	else:
		from_extension_app(e)


private pure func from_extension_app(e: String) -> String:
	if e == "pdf":
		"application/pdf"
	else if e == "zip":
		"application/zip"
	else if e == "gz" or e == "gzip":
		"application/gzip"
	else if e == "tar":
		"application/x-tar"
	else if e == "wasm":
		"application/wasm"
	else if e == "woff":
		"font/woff"
	else if e == "woff2":
		"font/woff2"
	else if e == "ttf":
		"font/ttf"
	else:
		"application/octet-stream"


-- ============================================================================
-- MIME Type → Extension
-- ============================================================================
---
Get a file extension for a MIME type.
Returns None for unrecognized MIME types.

doctests:
    :: HTML type
    match to_extension("text/html"):
        Some(e): e == "html"
        None: False

    :: Unknown type
    match to_extension("application/x-custom"):
        Some(_): False
        None: True
---
pure func to_extension(mime: String) -> Option[String]:
	if mime == "text/html":
		Some("html")
	else if mime == "text/css":
		Some("css")
	else if mime == "text/javascript":
		Some("js")
	else if mime == "application/json":
		Some("json")
	else if mime == "application/xml":
		Some("xml")
	else if mime == "text/plain":
		Some("txt")
	else if mime == "text/csv":
		Some("csv")
	else if mime == "image/png":
		Some("png")
	else if mime == "image/jpeg":
		Some("jpg")
	else if mime == "image/gif":
		Some("gif")
	else if mime == "image/svg+xml":
		Some("svg")
	else if mime == "audio/mpeg":
		Some("mp3")
	else if mime == "video/mp4":
		Some("mp4")
	else if mime == "application/pdf":
		Some("pdf")
	else if mime == "application/zip":
		Some("zip")
	else if mime == "application/gzip":
		Some("gz")
	else if mime == "application/wasm":
		Some("wasm")
	else:
		None


-- ============================================================================
-- Utilities
-- ============================================================================
---
Check if a MIME type is a text type.
---
pure func is_text(mime: String) -> Bool:
	(
		mime.starts_with("text/")
		or mime == "application/json"
		or mime == "application/xml"
		or mime == "application/javascript"
	)
