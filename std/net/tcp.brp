-- TCP Networking - Socket primitives for TCP connections
--
-- All functions are impure (I/O). Returns Result[T, String] for error handling.
-- Uses Int for file descriptors and Bytes for data buffers.
---
Create a TCP server socket, bind to host:port, and start listening.
Returns the server socket fd on success.
---
func listen(host: String, port: Int, backlog: Int) -> Result[Int, String]:
	builtin


---
Accept an incoming connection on a listening socket.
Returns the client socket fd on success.
---
func accept(server_fd: Int) -> Result[Int, String]:
	builtin


---
Connect to a remote TCP server at host:port.
Returns the socket fd on success.
---
func connect(host: String, port: Int) -> Result[Int, String]:
	builtin


---
Read up to max_bytes from a socket.
Returns the data actually read (may be less than max_bytes).
Returns empty Bytes on connection close.
---
func read(fd: Int, max_bytes: Int) -> Result[Bytes, String]:
	builtin


---
Write all bytes in data to a socket.
Returns the number of bytes written on success.
---
func write(fd: Int, data: Bytes) -> Result[Int, String]:
	builtin


---
Close a socket. Always succeeds (ignores errors).
---
func close(fd: Int) -> Void:
	builtin


---
Set SO_REUSEADDR on a socket.
---
func set_reuse_addr(fd: Int) -> Result[Int, String]:
	builtin


---
Set send/receive timeout in milliseconds.
---
func set_timeout(fd: Int, ms: Int) -> Result[Int, String]:
	builtin
