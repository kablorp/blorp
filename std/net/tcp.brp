-- TCP Networking - scoped socket resources.
--
-- TcpListener and TcpStream are external capabilities. Acquire them with a
-- scoped `with` binding so the compiler installs deterministic cleanup. TCP
-- endpoints are explicit typed values: use `Port` to represent concrete remote
-- ports, `listen_*_any_port` when the OS should choose an ephemeral listener
-- port, `IpAddress` for numeric addresses, and `DnsName` when hostname
-- resolution is intended. Hostname resolution still uses blocking DNS;
-- validated numeric addresses avoid that resolver path.
import:
	stream: FallibleStream, ResourceSource


---
Opaque resource for a listening TCP socket.
---
resource type TcpListener = builtin("blorp_tcp_close_listener")


---
Opaque resource for a connected TCP socket.
---
resource type TcpStream = builtin("blorp_tcp_close_stream")


---
IP protocol family.
---
enum IpFamily:
	IPv4
	IPv6


---
Validated IP address text.

`IpAddress` is a nominal builtin type, not a `String` alias. Construct it with
`ipv4(...)` or `parse_ip(...)` so invalid IP text cannot flow into typed TCP
APIs as an already-validated address.
---
type IpAddress = builtin


---
Validated DNS name text.

`DnsName` keeps hostname resolution explicit. Use `dns_name(...)` before
connecting by name, and use `ipv4(...)` or `parse_ip(...)` for IP literals.
---
type DnsName = builtin


---
Validated IPv6 interface scope or zone identifier.

Scopes are OS-specific text, for example an interface name or numeric zone. The
constructor rejects only empty, NUL-containing, and oversized values so the API
does not rule out legal platform forms.
---
type InterfaceScope = builtin


---
Validated remote TCP port.

`Port` represents concrete ports 1 through 65535. Binding to an OS-assigned
ephemeral port is represented by `listen_*_any_port` APIs, not by passing magic
port 0.
---
type Port = builtin


---
Private finalizer trait implemented by scoped TCP resources.

`with` blocks use compiler-owned cleanup builtins directly. This trait keeps the
runtime finalizers documented inside the module without exporting a manual
`close` operation that could conflict with scoped cleanup ownership.
---
private trait TcpClosable:
	func close(handle: Self) -> Void


implements TcpClosable for TcpListener:
	func close(listener: TcpListener) -> Void:
		builtin("blorp_tcp_close_listener")


implements TcpClosable for TcpStream:
	func close(stream: TcpStream) -> Void:
		builtin("blorp_tcp_close_stream")


---
Typed error surface for TCP APIs.

The current runtime still reports most TCP failures as strings. The resource
bridge classifies explicit Blorp-side precondition failures as `InvalidInput`
and preserves lower-level runtime details as `Other` until the runtime exposes
stable TCP error classes directly.
---
union TcpError:
	InvalidInput(String)
	TimedOut(String)
	Closed(String)
	Busy(String)
	Dns(String)
	ConnectionFailed(String)
	Interrupted(String)
	Unsupported(String)
	Other(String)


---
Return a stable, human-readable description of a TCP error.

doctests:
    :: Invalid input includes detail
    message(InvalidInput("bad port")) == "invalid input: bad port"

    :: Runtime compatibility errors preserve detail
    message(Other("tcp read: timed out")) == "tcp error: tcp read: timed out"
---
pure func message(err: TcpError) -> String:
	match err:
		InvalidInput(detail): "invalid input: " + detail
		TimedOut(detail): "timed out: " + detail
		Closed(detail): "closed: " + detail
		Busy(detail): "busy: " + detail
		Dns(detail): "dns error: " + detail
		ConnectionFailed(detail): "connection failed: " + detail
		Interrupted(detail): "interrupted: " + detail
		Unsupported(detail): "unsupported: " + detail
		Other(detail): "tcp error: " + detail


implements Stringable for TcpError:
	pure func to_string(err: TcpError) -> String:
		message(err)


---
Return True when a TCP error is a timeout.

doctests:
    :: TimedOut is recognized
    is_timed_out(TimedOut("accept")) == True

    :: Other errors are not timeouts
    is_timed_out(Other("closed")) == False
---
pure func is_timed_out(err: TcpError) -> Bool:
	match err:
		TimedOut(_): True
		_: False


private pure func map_address_error[T](result: Result[T, String]) -> Result[T, TcpError]:
	match result:
		Ok(value): Ok(value)
		Err(detail): Err(InvalidInput(detail))


---
Construct a validated IPv4 address from four bytes.

doctests:
    :: IPv4 constructor formats dotted decimal
    ipv4(to_uint8(127), to_uint8(0), to_uint8(0), to_uint8(1)).to_string() == "127.0.0.1"
---
pure func ipv4(a: UInt8, b: UInt8, c: UInt8, d: UInt8) -> IpAddress:
	builtin("blorp_tcp_ipv4_raw")


private pure func parse_ip_raw(text: String) -> Result[IpAddress, String]:
	builtin("blorp_tcp_parse_ip_raw")


---
Parse IPv4 or IPv6 address text into a validated IP address.
---
pure func parse_ip(text: String) -> Result[IpAddress, TcpError]:
	text
		.parse_ip_raw()
		.map_address_error()


private pure func dns_name_raw(text: String) -> Result[DnsName, String]:
	builtin("blorp_tcp_dns_name_raw")


---
Validate DNS name text.

This intentionally performs only structural checks that are universally useful:
the name must be non-empty, shorter than the runtime host buffer, and free of
NUL bytes. IP literals are rejected so numeric endpoints stay explicit.
Resolution remains a separate operation performed by connect APIs.
---
pure func dns_name(text: String) -> Result[DnsName, TcpError]:
	text
		.dns_name_raw()
		.map_address_error()


private pure func interface_scope_raw(text: String) -> Result[InterfaceScope, String]:
	builtin("blorp_tcp_interface_scope_raw")


---
Validate an IPv6 interface scope or zone identifier.
---
pure func interface_scope(text: String) -> Result[InterfaceScope, TcpError]:
	text
		.interface_scope_raw()
		.map_address_error()


private pure func port_raw(value: Int) -> Result[Port, String]:
	builtin("blorp_tcp_port_raw")


---
Validate a concrete remote TCP port.

Ports are 1 through 65535. Use a `listen_*_any_port` API when binding a listener
and asking the OS to assign an ephemeral port.
---
pure func port(value: Int) -> Result[Port, TcpError]:
	value
		.port_raw()
		.map_address_error()


---
Return the stored text representation of a validated IP address.
---
pure func ip_text(address: IpAddress) -> String:
	builtin("blorp_tcp_ip_text_raw")


implements Stringable for IpAddress:
	pure func to_string(address: IpAddress) -> String:
		address.ip_text()


---
Return the text representation of a validated DNS name.
---
pure func dns_name_text(name: DnsName) -> String:
	builtin("blorp_tcp_dns_name_text_raw")


implements Stringable for DnsName:
	pure func to_string(name: DnsName) -> String:
		name.dns_name_text()


---
Return the text representation of an interface scope.
---
pure func interface_scope_text(scope: InterfaceScope) -> String:
	builtin("blorp_tcp_interface_scope_text_raw")


implements Stringable for InterfaceScope:
	pure func to_string(scope: InterfaceScope) -> String:
		scope.interface_scope_text()


private pure func port_value(value: Port) -> Int:
	builtin("blorp_tcp_port_value_raw")


implements Stringable for Port:
	pure func to_string(value: Port) -> String:
		value
			.port_value()
			.to_string()


---
Return the local port for a scoped listener.
---
@resource_result_ordinary
func local_port(listener: TcpListener) -> Result[Int, TcpError]:
	builtin("blorp_tcp_local_port_listener_raw")


---
Return the local port for a scoped stream.
---
@resource_result_ordinary
func stream_local_port(stream: TcpStream) -> Result[Int, TcpError]:
	builtin("blorp_tcp_local_port_stream_raw")


---
Set the default runtime operation timeout for a scoped listener.

This is a virtual-thread deadline used by accept waits on an existing listener,
not a kernel socket timeout. Negative timeouts are rejected.
---
@resource_result_ordinary
func set_timeout(listener: TcpListener, ms: Int) -> Result[Void, TcpError]:
	builtin("blorp_tcp_set_timeout_listener_raw")


---
Set the default runtime operation timeout for a scoped stream.

This is a virtual-thread deadline used by read/write waits on an existing
stream, not a kernel socket timeout. Negative timeouts are rejected.
---
@resource_result_ordinary
func set_stream_timeout(stream: TcpStream, ms: Int) -> Result[Void, TcpError]:
	builtin("blorp_tcp_set_timeout_stream_raw")


---
Listen on a loopback address for one IP family.
---
func listen_loopback(family: IpFamily, port: Port, backlog: Int) -> Result[TcpListener, TcpError]:
	builtin("blorp_tcp_listen_loopback_raw")


---
Listen on a loopback address and ask the OS to assign an available port.
---
func listen_loopback_any_port(family: IpFamily, backlog: Int) -> Result[TcpListener, TcpError]:
	builtin("blorp_tcp_listen_loopback_any_port_raw")


---
Listen on all local interfaces for one IP family.
---
func listen_any_interface(
	family: IpFamily,
	port: Port,
	backlog: Int,
) -> Result[TcpListener, TcpError]:
	builtin("blorp_tcp_listen_any_interface_raw")


---
Listen on all local interfaces and ask the OS to assign an available port.
---
func listen_any_interface_any_port(family: IpFamily, backlog: Int) -> Result[TcpListener, TcpError]:
	builtin("blorp_tcp_listen_any_interface_any_port_raw")


---
Listen on a validated IP address.
---
func listen_ip(address: IpAddress, port: Port, backlog: Int) -> Result[TcpListener, TcpError]:
	builtin("blorp_tcp_listen_ip_raw")


---
Listen on a validated IP address and ask the OS to assign an available port.
---
func listen_ip_any_port(address: IpAddress, backlog: Int) -> Result[TcpListener, TcpError]:
	builtin("blorp_tcp_listen_ip_any_port_raw")


---
Listen on a validated IPv6 address with an explicit interface scope.
---
func listen_scoped_ip(
	address: IpAddress,
	scope: InterfaceScope,
	port: Port,
	backlog: Int,
) -> Result[TcpListener, TcpError]:
	builtin("blorp_tcp_listen_scoped_ip_raw")


---
Listen on a scoped IPv6 address and ask the OS to assign an available port.
---
func listen_scoped_ip_any_port(
	address: IpAddress,
	scope: InterfaceScope,
	backlog: Int,
) -> Result[TcpListener, TcpError]:
	builtin("blorp_tcp_listen_scoped_ip_any_port_raw")


---
Accept an incoming connection on a listening socket.

The listener must be a scoped `with` binding. Only one parked accept may be in
progress for a listener. Use a single accept loop or a resource source such as
`connections_continue_on_error(listener)` to fan accepted streams into
structured concurrent consumers; overlapping parked accepts return an error
instead of pretending the listener is closed.
---
func accept(listener: TcpListener) -> Result[TcpStream, TcpError]:
	builtin("blorp_tcp_accept_raw")


---
Create a resource-producing source of accepted streams.

The source borrows the scoped listener, so it must stay inside the listener's
`with` block. Sequential `for` iteration transfers each accepted stream into a
scoped loop body and closes it at the end of that iteration. Accept errors end
the source.
---
func connections_stop_on_error(listener: TcpListener) -> ResourceSource[TcpStream, TcpError]:
	builtin("blorp_tcp_connections_stop_on_error_raw")


---
Create a resource-producing source of accepted streams.

The source borrows the scoped listener, so it must stay inside the listener's
`with` block. Sequential `for` iteration transfers each accepted stream into a
scoped loop body and closes it at the end of that iteration. Accept timeouts
are treated as transient and the source continues accepting; other accept
errors end the source.
---
func connections_continue_on_error(listener: TcpListener) -> ResourceSource[TcpStream, TcpError]:
	builtin("blorp_tcp_connections_continue_on_error_raw")


---
Connect to this machine's loopback address for one IP family.
---
func connect_loopback(family: IpFamily, port: Port) -> Result[TcpStream, TcpError]:
	builtin("blorp_tcp_connect_loopback_raw")


---
Connect to a validated IP address.
---
func connect_ip(address: IpAddress, port: Port) -> Result[TcpStream, TcpError]:
	builtin("blorp_tcp_connect_ip_raw")


---
Connect to a validated IPv6 address with an explicit interface scope.
---
func connect_scoped_ip(
	address: IpAddress,
	scope: InterfaceScope,
	port: Port,
) -> Result[TcpStream, TcpError]:
	builtin("blorp_tcp_connect_scoped_ip_raw")


---
Connect to a validated DNS name.
---
func connect_name(name: DnsName, port: Port) -> Result[TcpStream, TcpError]:
	builtin("blorp_tcp_connect_name_raw")


---
Read up to `max_bytes` from a socket.

The stream must be a scoped `with` binding. Returns the data actually read,
which may be less than `max_bytes`. An empty `Bytes` value means the peer closed
the connection. Passing a non-positive size or a size larger than 64 MiB returns
`Err(InvalidInput(...))`.
---
@resource_result_ordinary
func read_chunk(stream: TcpStream, max_bytes: Int) -> Result[Bytes, TcpError]:
	builtin("blorp_tcp_read_raw")


---
Alias for `read_chunk`.
---
@resource_result_ordinary
func read(stream: TcpStream, max_bytes: Int) -> Result[Bytes, TcpError]:
	builtin("blorp_tcp_read_raw")


---
Create a fallible stream of byte chunks from a scoped TCP stream.

Each pull reads up to `max_bytes` bytes. An empty read from the peer ends the
stream normally; socket, timeout, and cancellation-adjacent failures are
reported through terminal operations as `Result[..., TcpError]`.
---
func chunks(stream: TcpStream, max_bytes: Int) -> FallibleStream[Bytes, TcpError]:
	builtin("blorp_tcp_chunks_raw")


---
Create a fallible stream of text lines from a scoped TCP stream.

Lines are returned without trailing `\n` or `\r\n`. The stream ends normally
when the peer closes the connection; a final line without a trailing newline is
still yielded.
---
func lines(stream: TcpStream) -> FallibleStream[String, TcpError]:
	builtin("blorp_tcp_lines_raw")


---
Write one byte chunk to a socket.

The stream must be a scoped `with` binding. Returns the number of bytes written
on success. If cancellation, timeout, or an OS error happens after a partial
send, the function returns an error and the peer may still have received the
bytes already sent.
---
@resource_result_ordinary
func write(stream: TcpStream, data: Bytes) -> Result[Int, TcpError]:
	builtin("blorp_tcp_write_raw")


---
Write all bytes in `data` to a socket.

Returns `Ok(void)` once every byte has been written. If cancellation, timeout,
or an OS error happens after a partial send, the function returns an error and
the peer may still have received bytes already sent.
---
@resource_result_ordinary
func write_all(stream: TcpStream, data: Bytes) -> Result[Void, TcpError]:
	builtin("blorp_tcp_write_all_raw")


---
Set SO_REUSEADDR on a listener.
---
@resource_result_ordinary
func set_reuse_addr(listener: TcpListener) -> Result[Void, TcpError]:
	builtin("blorp_tcp_set_reuse_addr_raw")
