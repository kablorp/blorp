-- TCP Networking - scoped socket resources.
--
-- TcpListener and TcpStream are external capabilities. Acquire them with
-- `with listener ?= listen(...):` or `with stream ?= connect(...):` so the
-- compiler installs deterministic cleanup. Numeric-address socket operations
-- are fiber-aware; hostname resolution still uses blocking DNS. Use numeric
-- hosts such as "127.0.0.1" or "" bind-any hosts when OS-worker pinning during
-- DNS resolution is unacceptable.
import:
	stream: ResourceSource


---
Opaque resource for a listening TCP socket.
---
resource type TcpListener = builtin("blorp_tcp_close_listener")


---
Opaque resource for a connected TCP socket.
---
resource type TcpStream = builtin("blorp_tcp_close_stream")


---
Private finalizer trait implemented by scoped TCP resources.

`with` blocks use compiler-owned cleanup builtins directly. This trait keeps the
runtime finalizers documented inside the module without exporting a manual
`close` operation that could conflict with scoped cleanup ownership.
---
private trait TcpClosable:
	func close(handle: Self) -> Void


implements TcpClosable for TcpListener:
	func close(listener: TcpListener) -> Void:
		builtin("blorp_tcp_close_listener")


implements TcpClosable for TcpStream:
	func close(stream: TcpStream) -> Void:
		builtin("blorp_tcp_close_stream")


---
Typed error surface for TCP APIs.

The current runtime still reports most TCP failures as strings. The resource
bridge classifies explicit Blorp-side precondition failures as `InvalidInput`
and preserves lower-level runtime details as `Other` until the runtime exposes
stable TCP error classes directly.
---
union TcpError:
	InvalidInput(String)
	TimedOut(String)
	Closed(String)
	Busy(String)
	Dns(String)
	ConnectionFailed(String)
	Interrupted(String)
	Unsupported(String)
	Other(String)


---
Return a stable, human-readable description of a TCP error.

doctests:
    :: Invalid input includes detail
    message(InvalidInput("bad port")) == "invalid input: bad port"

    :: Runtime compatibility errors preserve detail
    message(Other("tcp read: timed out")) == "tcp error: tcp read: timed out"
---
pure func message(err: TcpError) -> String:
	match err:
		InvalidInput(detail): "invalid input: " + detail
		TimedOut(detail): "timed out: " + detail
		Closed(detail): "closed: " + detail
		Busy(detail): "busy: " + detail
		Dns(detail): "dns error: " + detail
		ConnectionFailed(detail): "connection failed: " + detail
		Interrupted(detail): "interrupted: " + detail
		Unsupported(detail): "unsupported: " + detail
		Other(detail): "tcp error: " + detail


implements Stringable for TcpError:
	pure func to_string(err: TcpError) -> String:
		message(err)


---
Return the local port for a scoped listener.
---
@resource_result_ordinary
func local_port(listener: TcpListener) -> Result[Int, TcpError]:
	builtin("blorp_tcp_local_port_listener_raw")


---
Return the local port for a scoped stream.
---
@resource_result_ordinary
func stream_local_port(stream: TcpStream) -> Result[Int, TcpError]:
	builtin("blorp_tcp_local_port_stream_raw")


---
Set the default runtime operation timeout for a scoped listener.

This is a virtual-thread deadline used by accept waits on an existing listener,
not a kernel socket timeout. Negative timeouts are rejected.
---
@resource_result_ordinary
func set_timeout(listener: TcpListener, ms: Int) -> Result[Void, TcpError]:
	builtin("blorp_tcp_set_timeout_listener_raw")


---
Set the default runtime operation timeout for a scoped stream.

This is a virtual-thread deadline used by read/write waits on an existing
stream, not a kernel socket timeout. Negative timeouts are rejected.
---
@resource_result_ordinary
func set_stream_timeout(stream: TcpStream, ms: Int) -> Result[Void, TcpError]:
	builtin("blorp_tcp_set_timeout_stream_raw")


---
Create a TCP server socket, bind to host:port, and start listening.

Use with `with listener ?= listen(host, port, backlog):` so the listener is
closed automatically when the block exits. Numeric hosts avoid DNS. Use "" to
bind to the platform's passive any-host address without DNS.
---
func listen(host: String, port: Int, backlog: Int) -> Result[TcpListener, TcpError]:
	builtin("blorp_tcp_listen_raw")


---
Accept an incoming connection on a listening socket.

The listener must be a scoped `with` binding. Only one parked accept may be in
progress for a listener. Start one accept loop and fan accepted streams into
structured resource-source consumers once that syntax lands; overlapping parked
accepts return an error instead of pretending the listener is closed.
---
func accept(listener: TcpListener) -> Result[TcpStream, TcpError]:
	builtin("blorp_tcp_accept_raw")


---
Create a resource-producing source of accepted streams.

The source borrows the scoped listener, so it must stay inside the listener's
`with` block. Sequential `for` iteration transfers each accepted stream into a
scoped loop body and closes it at the end of that iteration. Accept errors end
the source.
---
func connections_stop_on_error(listener: TcpListener) -> ResourceSource[TcpStream, TcpError]:
	builtin("blorp_tcp_connections_stop_on_error_raw")


---
Create a resource-producing source of accepted streams.

The source borrows the scoped listener, so it must stay inside the listener's
`with` block. Sequential `for` iteration transfers each accepted stream into a
scoped loop body and closes it at the end of that iteration. The current runtime
ends the source on accept errors while the typed transient-error policy is being
finished.
---
func connections_continue_on_error(listener: TcpListener) -> ResourceSource[TcpStream, TcpError]:
	builtin("blorp_tcp_connections_continue_on_error_raw")


---
Connect to a remote TCP server at host:port.

Use with `with stream ?= connect(host, port):` so the stream is closed
automatically when the block exits. Numeric hosts avoid DNS and the socket
connect parks fibers while waiting. Hostnames may block an OS thread during
resolution before the socket connect.
---
func connect(host: String, port: Int) -> Result[TcpStream, TcpError]:
	builtin("blorp_tcp_connect_raw")


---
Read up to `max_bytes` from a socket.

The stream must be a scoped `with` binding. Returns the data actually read,
which may be less than `max_bytes`. An empty `Bytes` value means the peer closed
the connection. Passing a non-positive size or a size larger than 64 MiB returns
`Err(InvalidInput(...))`.
---
@resource_result_ordinary
func read_chunk(stream: TcpStream, max_bytes: Int) -> Result[Bytes, TcpError]:
	builtin("blorp_tcp_read_raw")


---
Alias for `read_chunk`.
---
@resource_result_ordinary
func read(stream: TcpStream, max_bytes: Int) -> Result[Bytes, TcpError]:
	builtin("blorp_tcp_read_raw")


---
Write one byte chunk to a socket.

The stream must be a scoped `with` binding. Returns the number of bytes written
on success. If cancellation, timeout, or an OS error happens after a partial
send, the function returns an error and the peer may still have received the
bytes already sent.
---
@resource_result_ordinary
func write(stream: TcpStream, data: Bytes) -> Result[Int, TcpError]:
	builtin("blorp_tcp_write_raw")


---
Write all bytes in `data` to a socket.

Returns `Ok(void)` once every byte has been written. If cancellation, timeout,
or an OS error happens after a partial send, the function returns an error and
the peer may still have received bytes already sent.
---
@resource_result_ordinary
func write_all(stream: TcpStream, data: Bytes) -> Result[Void, TcpError]:
	builtin("blorp_tcp_write_all_raw")


---
Set SO_REUSEADDR on a listener.
---
@resource_result_ordinary
func set_reuse_addr(listener: TcpListener) -> Result[Void, TcpError]:
	builtin("blorp_tcp_set_reuse_addr_raw")
