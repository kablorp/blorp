-- URL - RFC 3986 URL parsing and manipulation
--
-- Provides URL parsing, reconstruction, percent encoding/decoding,
-- and query string utilities.
-- ============================================================================
-- Types
-- ============================================================================
record Url {
	scheme: String,
	host: String,
	port: Option[Int],
	path: String,
	query: String,
	fragment: String
}


-- ============================================================================
-- Parsing
-- ============================================================================
---
Parse a URL string into its components.
Supports http, https, and other schemes.

doctests:
    :: Parse simple URL
    match parse("https://example.com/path"):
        Ok(u): u.scheme == "https" and u.host == "example.com" and u.path == "/path"
        Err(_): False

    :: Parse URL with port
    match parse("http://localhost:8080/api"):
        Ok(u): u.host == "localhost"
        Err(_): False

    :: Parse URL with query and fragment
    match parse("https://example.com/search?q=hello#results"):
        Ok(u): u.query == "q=hello" and u.fragment == "results"
        Err(_): False
---
pure func parse(url: String) -> Result[Url, String]:
	colon_idx: Int = url.raw_index_of("://")
	if colon_idx == -1:
		Err("invalid URL: missing scheme")
	else:
		scheme: String = url.substring(0, colon_idx)
		after_scheme: String = url.substring(colon_idx + 3, url.length() - colon_idx - 3)

		-- Split authority from path+query+fragment
		slash_idx: Int = after_scheme.raw_index_of("/")
		var authority: String = ""
		var remainder: String = "/"
		if slash_idx == -1:
			authority = after_scheme.substring(0, after_scheme.length())
		else:
			authority = after_scheme.substring(0, slash_idx)
			remainder = after_scheme.substring(slash_idx, after_scheme.length() - slash_idx)

		-- Extract fragment
		frag_idx: Int = remainder.raw_index_of("#")
		var fragment: String = ""
		var before_frag: String = ""
		if frag_idx == -1:
			before_frag = remainder.substring(0, remainder.length())
		else:
			fragment = remainder.substring(frag_idx + 1, remainder.length() - frag_idx - 1)
			before_frag = remainder.substring(0, frag_idx)

		-- Extract query
		q_idx: Int = before_frag.raw_index_of("?")
		var query: String = ""
		var path: String = "/"
		if q_idx == -1:
			path = before_frag.substring(0, before_frag.length())
		else:
			query = before_frag.substring(q_idx + 1, before_frag.length() - q_idx - 1)
			path = before_frag.substring(0, q_idx)

		-- Parse host:port
		port_idx: Int = authority.raw_index_of(":")
		var host: String = ""
		var port: Option[Int] = None
		if port_idx == -1:
			host = authority.substring(0, authority.length())
		else:
			host = authority.substring(0, port_idx)
			port_str: String = authority.substring(port_idx + 1, authority.length() - port_idx - 1)
			port = port_str.parse_int()
		result: Url = {
			scheme = scheme,
			host = host,
			port = port,
			path = path,
			query = query,
			fragment = fragment
		}
		Ok(result)


-- ============================================================================
-- Reconstruction
-- ============================================================================
---
Reconstruct a URL string from its components.

doctests:
    :: Round-trip simple URL
    match parse("https://example.com/path"):
        Ok(u): u.to_string() == "https://example.com/path"
        Err(_): False
---
implements Stringable for Url:
	pure func to_string(url: Url) -> String:
		var result: String = url.scheme + "://" + url.host
		match url.port:
			Some(p): result = result + ":" + port_to_string(p)
			None: void
		result += url.path
		if url.query.length() > 0:
			result = result + "?" + url.query
		if url.fragment.length() > 0:
			result = result + "#" + url.fragment
		result


-- Helper: format port number as string
private pure func port_to_string(n: Int) -> String:
	var result: String = ""
	if n == 0:
		result = "0"
	else:
		var num: Int = n
		while num > 0:
			digit: Int = num % 10
			result = from_char(to_char(digit + 48)) + result
			num /= 10
	result


-- ============================================================================
-- Percent Encoding
-- ============================================================================
---
Percent-encode a string for use in URLs (RFC 3986).
Delegates to the existing url_encode builtin.

doctests:
    :: Encode spaces
    encode("hello world") == "hello%20world"

    :: Encode special chars
    encode("a&b=c") == "a%26b%3Dc"
---
pure func encode(s: String) -> String:
	s.url_encode()


---
Decode a percent-encoded string.
Delegates to the existing url_decode builtin.

doctests:
    :: Decode percent encoding
    decode("hello%20world") == "hello world"
---
pure func decode(s: String) -> String:
	s.url_decode()


-- ============================================================================
-- Query String Utilities
-- ============================================================================
---
Parse a query string into key-value pairs.
Decodes percent-encoded keys and values.

doctests:
    :: Parse simple query
    pairs: List[(String, String)] = parse_query("foo=bar&baz=qux")
    pairs.length() == 2

    :: Parse encoded values
    pairs: List[(String, String)] = parse_query("name=hello%20world")
    pairs.length() == 1
---
pure func parse_query(query: String) -> List[(String, String)]:
	if query.length() == 0:
		[]
	else:
		parts: List[String] = query.split("&")
		var result: List[(String, String)] = []
		var i: Int = 0
		while i < parts.length():
			match parts.get(i):
				Some(part):
					eq_idx: Int = part.raw_index_of("=")
					if eq_idx > 0:
						key: String = part
							.substring(0, eq_idx)
							.url_decode()
						val: String = part
							.substring(eq_idx + 1, part.length() - eq_idx - 1)
							.url_decode()
						result = result.append((key, val))
					else if part.length() > 0:
						result = result.append((part.url_decode(), ""))
				None: void
			i += 1
		result


---
Build a query string from key-value pairs.
Percent-encodes both keys and values.

doctests:
    :: Build query string
    build_query([("foo", "bar"), ("q", "hello world")]) == "foo=bar&q=hello%20world"
---
pure func build_query(pairs: List[(String, String)]) -> String:
	var parts: List[String] = []
	var i: Int = 0
	while i < pairs.length():
		match pairs.get(i):
			Some(pair):
				parts = parts.append(pair.0.url_encode() + "=" + pair.1.url_encode())
			None: void
		i += 1
	parts.join("&")


-- ============================================================================
-- Utility Functions
-- ============================================================================
---
Get the effective port for a URL (returns default port for scheme if not specified).
---
pure func effective_port(url: Url) -> Int:
	match url.port:
		Some(p): p
		None:
			if url.scheme == "https":
				443
			else if url.scheme == "http":
				80
			else:
				0


---
Check if a URL uses TLS (https scheme).
---
pure func is_https(url: Url) -> Bool:
	url.scheme == "https"
