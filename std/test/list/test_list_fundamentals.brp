import:
	list: drop, filter, get, sort, sort_by
	test: TestSuite


func test_length_empty() -> Bool:
	xs: List[Int] = []
	xs.length() == 0


func test_length_nonempty() -> Bool:
	length([1, 2, 3]) == 3


func test_length_strings() -> Bool:
	length(["a", "b"]) == 2


func test_to_string_empty() -> Bool:
	xs: List[Int] = []
	xs.to_string() == "[]"


func test_to_string_ints() -> Bool:
	to_string([1, 2, 3]) == "[1, 2, 3]"


func test_to_string_strings() -> Bool:
	to_string(["a", "b"]) == "[\"a\", \"b\"]"


func test_to_string_bools() -> Bool:
	to_string([True, False]) == "[True, False]"


func test_sized_int32_get_set() -> Bool:
	xs: List[Int32] = [to_int32(10), to_int32(20), to_int32(-30)]
	updated: List[Int32] = xs.set(1, to_int32(99))
	first_ok: Bool = updated.get_or(0, to_int32(0)) == to_int32(10)
	second_ok: Bool = updated.get_or(1, to_int32(0)) == to_int32(99)
	third_ok: Bool = updated.get_or(2, to_int32(0)) == to_int32(-30)
	first_ok and second_ok and third_ok


func test_sized_int32_for_in() -> Bool:
	xs: List[Int32] = [to_int32(1), to_int32(2), to_int32(3)]
	var total: Int32 = to_int32(0)
	for x in xs:
		total += x
	total == to_int32(6)


func test_sized_int32_filter_drop() -> Bool:
	xs: List[Int32] = [to_int32(1), to_int32(2), to_int32(3), to_int32(4)]
	kept: List[Int32] = xs.filter(pure func(x: Int32): x > to_int32(1))
	tail: List[Int32] = kept.drop(1)
	len_ok: Bool = tail.length() == 2
	first_ok: Bool = tail.get_or(0, to_int32(0)) == to_int32(3)
	second_ok: Bool = tail.get_or(1, to_int32(0)) == to_int32(4)
	len_ok and first_ok and second_ok


func test_bool_get_set() -> Bool:
	flags: List[Bool] = [True, False, True]
	updated: List[Bool] = flags.set(1, True)
	updated.get_or(0, False) and updated.get_or(1, False) and updated.get_or(2, False)


func test_sort_empty() -> Bool:
	xs: List[Int] = []
	sort(xs) == xs


func test_sort_ints() -> Bool:
	sort([3, 1, 2]) == [1, 2, 3]


func test_sort_strings() -> Bool:
	sort(["c", "a", "b"]) == ["a", "b", "c"]


func test_sort_by_key() -> Bool:
	items: List[(Int, String)] = [(3, "c"), (1, "a"), (2, "b")]
	sorted: List[(Int, String)] = sort_by(items, func(p: (Int, String)): p[0])
	match get(sorted, 0):
		Some(p): p[0] == 1
		None: False


tests: TestSuite = {
	description = "List Fundamentals",
	tests = [
		("length empty", test_length_empty),
		("length nonempty", test_length_nonempty),
		("length strings", test_length_strings),
		("to_string empty", test_to_string_empty),
		("to_string ints", test_to_string_ints),
		("to_string strings", test_to_string_strings),
		("to_string bools", test_to_string_bools),
		("sized Int32 get/set", test_sized_int32_get_set),
		("sized Int32 for-in", test_sized_int32_for_in),
		("sized Int32 filter/drop", test_sized_int32_filter_drop),
		("Bool get/set", test_bool_get_set),
		("sort empty", test_sort_empty),
		("sort ints", test_sort_ints),
		("sort strings", test_sort_strings),
		("sort by key", test_sort_by_key),
	]
}
