-- Test COW (Copy-on-Write) for List Operations
import:
	list: List, append, concat, get, insert, length, remove, set_index
	memory: MemStats, get_mem_stats, reset_mem_stats
	test: TestSuite


tests: TestSuite = {
	description = "List COW Semantics",
	tests = [
		("append unique minimal allocs", func():
			-- COW success (unique)
			reset_mem_stats()
			var list: List[Int] = [1, 2, 3]
			stats_after_create: MemStats = get_mem_stats()
			initial_allocs: Int = stats_after_create.total_allocations
			list = list.append(4)
			list = list.append(5)
			list = list.append(6)
			stats_after_appends: MemStats = get_mem_stats()
			final_allocs: Int = stats_after_appends.total_allocations
			list.length() == 6 and final_allocs < initial_allocs + 5
		),
		("list literal is fresh", func(): [1, 2, 3].length() == 3),
		("set_index unique", func():
			list: List[Int] = [1, 2, 3]
			match list.set_index(1, 42):
				Some(new_list):
					match new_list.get(1):
						Some(val): val == 42
						None: False
				None: False
		),
		("insert unique", func():
			list: List[Int] = [1, 3]
			match list.insert(1, 2):
				Some(new_list):
					match new_list.get(0):
						Some(v): v == 1
						None: False
					and match new_list.get(1):
						Some(v): v == 2
						None: False
					and match new_list.get(2):
						Some(v): v == 3
						None: False
					and new_list.length() == 3
				None: False
		),
		("remove unique", func():
			list: List[Int] = [1, 2, 3]
			match list.remove(1):
				Some(new_list):
					match new_list.get(0):
						Some(v): v == 1
						None: False
					and match new_list.get(1):
						Some(v): v == 3
						None: False
					and new_list.length() == 2
				None: False
		),
		("append result correct", func():
			var list: List[Int] = [1, 2, 3]
			list = list.append(4)
			list = list.append(5)
			list.length() == 5
		),
		("chained set_index", func():
			var list: List[Int] = [0, 0, 0]
			match list.set_index(0, 1):
				Some(l1):
					match l1.set_index(1, 2):
						Some(l2):
							match l2.set_index(2, 3):
								Some(l3):
									match l3.get(0):
										Some(v0):
											match l3.get(1):
												Some(v1):
													match l3.get(2):
														Some(v2): v0 == 1 and v1 == 2 and v2 == 3
														None: False
												None: False
										None: False
								None: False
						None: False
				None: False
		),
		("set_index out of bounds", func():
			-- Bounds checking
			match [1, 2, 3].set_index(10, 42):
				Some(_): False
				None: True
		),
		("insert out of bounds", func():
			match [1, 2, 3].insert(10, 42):
				Some(_): False
				None: True
		),
		("remove out of bounds", func():
			match [1, 2, 3].remove(10):
				Some(_): False
				None: True
		),
		("insert at end is valid", func():
			match [1, 2, 3].insert(3, 4):
				Some(new_list): new_list.length() == 4
				None: False
		),
		("negative index returns none", func():
			list: List[Int] = [1, 2, 3]
			set_result: Bool = match list.set_index(-1, 42):
				Some(_): False
				None: True
			insert_result: Bool = match list.insert(-1, 42):
				Some(_): False
				None: True
			remove_result: Bool = match list.remove(-1):
				Some(_): False
				None: True
			set_result and insert_result and remove_result
		),
		("set_index at zero", func():
			match [1, 2, 3].set_index(0, 42):
				Some(new_list):
					match new_list.get(0):
						Some(val): val == 42
						None: False
				None: False
		),
		("set_index at last", func():
			match [1, 2, 3].set_index(2, 42):
				Some(new_list):
					match new_list.get(2):
						Some(val): val == 42
						None: False
				None: False
		),
		("insert at zero prepends", func():
			match [2, 3].insert(0, 1):
				Some(new_list):
					match new_list.get(0):
						Some(val): val == 1 and new_list.length() == 3
						None: False
				None: False
		),
		("remove at zero", func():
			match [1, 2, 3].remove(0):
				Some(new_list):
					match new_list.get(0):
						Some(val): val == 2 and new_list.length() == 2
						None: False
				None: False
		),
		("remove last", func():
			match [1, 2, 3].remove(2):
				Some(new_list): new_list.length() == 2
				None: False
		),
		("concat result correct", func(): [1, 2, 3]
				.concat([4, 5])
				.length() == 5),
		("concat with empty first", func():
			-- Concat tests
			empty: List[Int] = []
			empty
				.concat([1, 2, 3])
				.length() == 3
		),
		("concat with empty second", func():
			empty: List[Int] = []
			[1, 2, 3]
				.concat(empty)
				.length() == 3
		),
		("concat two empty", func():
			e1: List[Int] = []
			e2: List[Int] = []
			e1
				.concat(e2)
				.length() == 0
		),
		("concat elements correct", func():
			result: List[Int] = [1, 2, 3].concat([4, 5])
			match result.get(0):
				Some(v): v == 1
				None: False
			and match result.get(2):
				Some(v): v == 3
				None: False
			and match result.get(3):
				Some(v): v == 4
				None: False
			and match result.get(4):
				Some(v): v == 5
				None: False
		),
		("chained concat", func(): [1]
				.concat([2])
				.concat([3])
				.length() == 3)
	]
}
