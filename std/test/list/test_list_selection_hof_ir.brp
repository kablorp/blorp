import:
	list: max_by, min_by
	test: TestSuite


func word_score(s: String) -> Int:
	s.length()


func shortest_word() -> Option[String]:
	words: List[String] = ["bear", "ant", "dolphin"]
	words.min_by(word_score)


func longest_word() -> Option[String]:
	words: List[String] = ["bear", "ant", "dolphin"]
	words.max_by(word_score)


func test_min_by_returns_retained_managed_value() -> Bool:
	match shortest_word():
		Some(word): word == "ant"
		None: False


func test_max_by_returns_retained_managed_value() -> Bool:
	match longest_word():
		Some(word): word == "dolphin"
		None: False


func test_min_max_by_empty_returns_none() -> Bool:
	empty: List[String] = []
	min_ok: Bool = match empty.min_by(word_score):
		Some(_): False
		None: True
	max_ok: Bool = match empty.max_by(word_score):
		Some(_): False
		None: True
	min_ok and max_ok


func test_min_by_string_key() -> Bool:
	words: List[String] = ["d", "bbb", "aa"]
	match words.min_by(func(s: String): s):
		Some(word): word == "aa"
		None: False


func test_max_by_string_key() -> Bool:
	words: List[String] = ["d", "bbb", "aa"]
	match words.max_by(func(s: String): s):
		Some(word): word == "d"
		None: False


tests: TestSuite = {
	description = "List selection HOF IR",
	tests = [
		("min_by returns retained managed value", test_min_by_returns_retained_managed_value),
		("max_by returns retained managed value", test_max_by_returns_retained_managed_value),
		("min_by and max_by empty returns none", test_min_max_by_empty_returns_none),
		("min_by string key", test_min_by_string_key),
		("max_by string key", test_max_by_string_key),
	]
}
