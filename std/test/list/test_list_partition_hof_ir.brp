import:
	test: TestSuite


func short_word(s: String) -> Bool:
	s.length() < 4


func test_partition_string_values() -> Bool:
	words: List[String] = ["ant", "bear", "cat", "dolphin"]
	result: (List[String], List[String]) = words.partition(short_word)
	short_words: List[String] = result[0]
	long_words: List[String] = result[1]
	match short_words.get(1):
		Some(second_short):
			match long_words.get(0):
				Some(first_long):
					short_words.length() == 2 and long_words.length() == 2 and second_short == "cat" and first_long == "bear"
				None: False
		None: False


tests: TestSuite = {
	description = "List partition HOF IR",
	tests = [("partition preserves managed values", test_partition_string_values)]
}
