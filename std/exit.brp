-- Process exit status support.
--
-- A runnable program may return any concrete type that implements
-- ExitStatusAble. The compiler-generated entrypoint resolves that value to
-- an integer code and prints a non-zero diagnostic, when present.
import:
	option: Option(Some, None)


---
Exit status returned by a program.

The code becomes the process exit code. A message is printed to stderr only
when the code is non-zero and the message is present.

doctests:
	:: A status carries its code and optional message
	status: ExitStatus = { code = 2, message = Some("invalid configuration") }
	status.code == 2 and status.message == Some("invalid configuration")
---
record ExitStatus {
	code: Int,
	message: Option[String]
}


---
Types that may be returned from a program's `main` function.

Implement this trait for a locally owned type to choose a process exit code
and optional diagnostic message.
---
trait ExitStatusAble:
	pure func to_exit_status(value: Self) -> ExitStatus
	func resolve_exit_status(value: Self) -> Int:
		status = value.to_exit_status()

		if status.code != 0:
			match status.message:
				Some(message):
					print_error(message)
				None:
					void

		status.code


---
Void-returning programs exit successfully without a diagnostic.
---
implements ExitStatusAble for Void:
	pure func to_exit_status(value: Void) -> ExitStatus:
		{
			code = 0,
			message = None
		}


---
An Int return value is used directly as the process exit code.
---
implements ExitStatusAble for Int:
	pure func to_exit_status(value: Int) -> ExitStatus:
		{
			code = value,
			message = None
		}
