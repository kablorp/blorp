-- Path - File path manipulation utilities
--
-- Pure functions for working with file paths. All operations are string-based
-- and do not access the filesystem. Uses '/' as the path separator.
-- Helper: find the last index of a character in a string. Returns -1 if not found.
private pure func last_index_of_char(s: String, c: Char) -> Int:
	var i: Int = s.length() - 1
	var found: Int = 0 - 1

	while i >= 0:
		match s.get(i):
			Some(ch):
				if ch == c:
					found = i
					i = 0 - 1
				else:
					i -= 1
			None:
				i -= 1

	found


---
Join two path segments with a separator.
If the second path is absolute, it is returned as-is.

doctests:
    :: Join two segments
    "foo".join("bar") == "foo/bar"

    :: Join with trailing slash
    "foo/".join("bar") == "foo/bar"

    :: Absolute second path
    "foo".join("/bar") == "/bar"

    :: Empty first path
    "".join("bar") == "bar"
---
pure func join(a: String, b: String) -> String:
	if b.starts_with("/"):
		b
	else if a.length() == 0:
		b
	else if a.ends_with("/"):
		a + b
	else:
		a + "/" + b


---
Get the directory portion of a path.
Returns "." if the path has no directory component.

doctests:
    :: Simple path
    dirname("/foo/bar/baz.txt") == "/foo/bar"

    :: Root path
    dirname("/foo") == "/"

    :: No directory
    dirname("file.txt") == "."

    :: Trailing slash stripped first
    dirname("/foo/bar/") == "/foo"
---
pure func dirname(path: String) -> String:
	p: String = if path.length() > 1:
		if path.ends_with("/"):
			path.take_left(path.length() - 1)
		else:
			path
	else:
		path
	idx: Int = last_index_of_char(p, '/')

	if idx < 0:
		"."
	else if idx == 0:
		"/"
	else:
		p.take_left(idx)


---
Get the filename portion of a path (everything after the last '/').

doctests:
    :: Simple path
    basename("/foo/bar/baz.txt") == "baz.txt"

    :: No directory
    basename("file.txt") == "file.txt"

    :: Trailing slash
    basename("/foo/bar/") == "bar"

    :: Root
    basename("/") == ""
---
pure func basename(path: String) -> String:
	p: String = if path.length() > 1:
		if path.ends_with("/"):
			path.take_left(path.length() - 1)
		else:
			path
	else:
		path
	idx: Int = last_index_of_char(p, '/')

	if idx < 0:
		p
	else:
		p.drop_left(idx + 1)


---
Get the file extension (including the dot), or None if there is none.

doctests:
    :: Has extension
    extension("file.txt") == Some(".txt")

    :: No extension
    match extension("Makefile"):
        None: True
        Some(_): False

    :: Multiple dots
    extension("archive.tar.gz") == Some(".gz")

    :: Hidden file with no extension
    match extension(".gitignore"):
        None: True
        Some(_): False
---
pure func extension(path: String) -> Option[String]:
	name: String = basename(path)
	idx: Int = last_index_of_char(name, '.')

	if idx <= 0:
		None
	else:
		Some(name.drop_left(idx))


---
Get the filename without its extension.

doctests:
    :: Simple stem
    stem("file.txt") == "file"

    :: No extension
    stem("Makefile") == "Makefile"

    :: Full path
    stem("/foo/bar/baz.tar.gz") == "baz.tar"
---
pure func stem(path: String) -> String:
	name: String = basename(path)
	idx: Int = last_index_of_char(name, '.')

	if idx <= 0:
		name
	else:
		name.take_left(idx)


---
Check if a path is absolute (starts with '/').

doctests:
    :: Absolute path
    is_absolute("/foo/bar") == True

    :: Relative path
    is_absolute("foo/bar") == False

    :: Empty path
    is_absolute("") == False
---
pure func is_absolute(path: String) -> Bool:
	path.starts_with("/")


---
Normalize a path by resolving '.' and '..' components and collapsing
multiple consecutive slashes.

doctests:
    :: Resolve dot-dot
    normalize("/foo/bar/../baz") == "/foo/baz"

    :: Resolve single dot
    normalize("/foo/./bar") == "/foo/bar"

    :: Collapse multiple slashes
    normalize("/foo//bar") == "/foo/bar"

    :: Already clean
    normalize("/foo/bar") == "/foo/bar"

    :: Relative path
    normalize("foo/bar/../baz") == "foo/baz"
---
pure func normalize(path: String) -> String:
	abs: Bool = is_absolute(path)
	parts: List[String] = path.split("/")
	var stack: List[String] = []
	var count: Int = 0

	for part in parts:
		if part.length() == 0:
			void
		else if part == ".":
			void
		else if part == "..":
			if count > 0:
				stack = stack.take(count - 1)
				count -= 1
			else if not abs:
				stack = stack.append("..")
				count += 1
		else:
			stack = stack.append(part)
			count += 1

	if abs:
		var result: String = "/"
		var first: Bool = True

		for seg in stack:
			if first:
				result += seg
				first = False
			else:
				result = result + "/" + seg

		result
	else if count == 0:
		"."
	else:
		var result: String = ""
		var first: Bool = True

		for seg in stack:
			if first:
				result = seg
				first = False
			else:
				result = result + "/" + seg

		result
