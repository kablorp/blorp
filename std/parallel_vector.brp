-- ParallelVector - scoped combinators for Vector.parallel callbacks.
import:
	vector: ParallelVector


private pure func __parallel_vector_map[T, U, #N](
	self: ParallelVector[T, #N],
	f: pure (T) -> U,
) -> ParallelVector[U, #N]:
	builtin("blorp_vmap_parallel")


private pure func __parallel_vector_map_indexed[T, U, #N](
	self: ParallelVector[T, #N],
	f: pure (..#N, T) -> U,
) -> ParallelVector[U, #N]:
	builtin("blorp_vmap_indexed_parallel")


private pure func __parallel_vector_zip_map[A, B, C, #N](
	self: ParallelVector[A, #N],
	other: B[#N],
	f: pure (A, B) -> C,
) -> ParallelVector[C, #N]:
	builtin("blorp_vzip_parallel")


---
Parallel shape-preserving map over a ParallelVector.
---
pure func map[T, U, #N](
	self: ParallelVector[T, #N],
	f: pure (T) -> U,
) -> ParallelVector[U, #N]:
	__parallel_vector_map(self, f)


---
Parallel shape-preserving indexed map over a ParallelVector.
---
pure func map_indexed[T, U, #N](
	self: ParallelVector[T, #N],
	f: pure (..#N, T) -> U,
) -> ParallelVector[U, #N]:
	__parallel_vector_map_indexed(self, f)


---
Parallel shape-preserving zip-map over a ParallelVector and same-sized vector.
---
pure func zip_map[A, B, C, #N](
	self: ParallelVector[A, #N],
	other: B[#N],
	f: pure (A, B) -> C,
) -> ParallelVector[C, #N]:
	__parallel_vector_zip_map(self, other, f)
