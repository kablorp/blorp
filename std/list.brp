    names: List[String] = ["a", "b", "c"]
    result: List[(Int, String)] = names.enumerate()
    result.length() == 3

    :: First pair has index 0
    nums: List[Int] = [10, 20]
    result: List[(Int, Int)] = nums.enumerate()
