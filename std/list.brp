---
Find the index of the first element matching a predicate.

doctests:
    :: Find index of first even number
    nums: List[Int] = [1, 3, 4, 6]
    match nums.find_index(func(x: Int): x % 2 == 0):
        Some(i): i == 2
        None: False

    :: Not found returns None
    nums: List[Int] = [1, 3, 5]
    match nums.find_index(func(x: Int): x % 2 == 0):
        Some(_): False
        None: True
---
func find_index[T](
	self: List[T],
	pred: (T) -> Bool,
) -> Option[Int]:
pure func find_index[T](
	self: List[T],
	pred: pure (T) -> Bool,
