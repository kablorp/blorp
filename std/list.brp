import:
	traits: one, zero
	units: Duration, to_timeout_milliseconds


-- List - Dynamic array type operations
--
-- List[T] is a dynamic, heap-allocated array with automatic memory management.
-- Uses ARC (Automatic Reference Counting) and COW (Copy-on-Write) optimization.
-- All operations are semantically immutable - mutations return new lists.
-- COW optimization mutates in-place when refcount is 1.
type List[T] = builtin


type ParallelList[T] = builtin


-- ============================================================================
-- Core List Operations (builtins)
-- ============================================================================
---
Create an empty List[T] with the given capacity reserved.

The list starts with length 0; `capacity` is a hint to the runtime for how
many elements will fit without reallocation. Useful when appending in a loop
where the final size is known in advance.

doctests:
    :: Empty list with capacity
    xs: List[Int] = list(100)
    xs.length() == 0

    :: Appending within capacity
    var xs: List[Int] = list(8)
    for i in 0..5:
        xs = xs.append(i)
    xs.length() == 5
---
pure func list[T](capacity: Int) -> List[T]:
	builtin


---
Get element at index, returning Option[T].

doctests:
    :: Get element in bounds
    nums: List[Int] = [10, 20, 30]
    match nums.get(1):
        Some(v): v == 20
        None: False

    :: Get element out of bounds returns None
    nums: List[Int] = [10, 20, 30]
    match nums.get(5):
        Some(_): False
        None: True
---
pure func get[T](self: List[T], index: Int) -> Option[T]:
	if index >= 0 and index < self.length():
		Some(__unsafe_list_get(self, index))
	else:
		None


private pure func __unsafe_list_get[T](self: List[T], index: Int) -> T:
	builtin


---
Get element at index, or return a default value if out of bounds.

doctests:
    :: Get element in bounds
    [10, 20, 30].get_or(1, 0) == 20

    :: Get element out of bounds returns default
    [10, 20, 30].get_or(5, 99) == 99

    :: Get from empty list returns default
    empty: List[Int] = []
    empty.get_or(0, 42) == 42
---
pure func get_or[T](self: List[T], index: Int, default: T) -> T:
	builtin


---
Append an element to the end of the list. Returns a new list.

doctests:
    :: Append to empty list
    empty: List[Int] = []
    result: List[Int] = empty.append(42)
    result.length() == 1

    :: Append preserves existing elements
    nums: List[Int] = [1, 2, 3]
    result: List[Int] = nums.append(4)
    result.length() == 4
---
pure func append[T](self: List[T], elem: T) -> List[T]:
	builtin


---
Replace element at index. Returns Some(new_list) on success, None if out of bounds.
---
pure func set_index[T](self: List[T], index: Int, elem: T) -> Option[List[T]]:
	if index < 0 or index >= self.length():
		None
	else:
		Some(__unsafe_list_set_index(self, index, elem))


private pure func __unsafe_list_set_index[T](self: List[T], index: Int, elem: T) -> List[T]:
	builtin


---
Swap two list elements. Returns Some(new_list) on success, None if either
index is negative or out of bounds.

doctests:
    :: Swap first and last
    match [1, 2, 3].swap(0, 2):
        Some(xs): xs == [3, 2, 1]
        None: False

    :: Same index is valid and unchanged
    xs: List[Int] = [1, 2, 3]
    match xs.swap(1, 1):
        Some(swapped): swapped == xs
        None: False

    :: Negative index returns None
    match [1, 2, 3].swap(-1, 2):
        Some(_): False
        None: True

    :: Out-of-bounds index returns None
    match [1, 2, 3].swap(0, 3):
        Some(_): False
        None: True
---
pure func swap[T](self: List[T], i: Int, j: Int) -> Option[List[T]]:
	if i < 0 or j < 0:
		None
	else:
		max_index: Int = if i > j:
			i
		else:
			j
		if max_index >= self.length():
			None
		else if i == j:
			Some(self)
		else:
			Some(__unsafe_list_swap(self, i, j))


private pure func __unsafe_list_swap[T](self: List[T], i: Int, j: Int) -> List[T]:
	builtin


---
Replace element at index. Returns updated list, or the original list unchanged
if the index is out of bounds.

doctests:
    :: Set valid index
    [1, 2, 3].set(1, 99) == [1, 99, 3]

    :: Out of bounds returns original
    [1, 2, 3].set(10, 99) == [1, 2, 3]
---
pure func set[T](self: List[T], index: Int, elem: T) -> List[T]:
	builtin


---
Insert element at index, shifting later elements right.
Returns Some(new_list) on success, None if index out of bounds.
---
pure func insert[T](self: List[T], index: Int, elem: T) -> Option[List[T]]:
	if index < 0 or index > self.length():
		None
	else:
		Some(__unsafe_list_insert(self, index, elem))


private pure func __unsafe_list_insert[T](self: List[T], index: Int, elem: T) -> List[T]:
	builtin


---
Remove element at index, shifting later elements left.
Returns Some(new_list) on success, None if index out of bounds.
---
pure func remove[T](self: List[T], index: Int) -> Option[List[T]]:
	if index < 0 or index >= self.length():
		None
	else:
		Some(__unsafe_list_remove(self, index))


private pure func __unsafe_list_remove[T](self: List[T], index: Int) -> List[T]:
	builtin


-- Implement HasLength trait for List
implements HasLength for List[T]:
	pure func length[T](self: List[T]) -> Int:
		builtin


-- Implement Stringable trait for List
implements Stringable for List[T:Stringable]:
	pure func to_string[T](self: List[T]) -> String:
		builtin


---
Check if the list is empty.

doctests:
    :: Empty list is empty
    empty: List[Int] = []
    empty.is_empty() == True

    :: Non-empty list is not empty
    nums: List[Int] = [1, 2, 3]
    nums.is_empty() == False
---
pure func is_empty[T](self: List[T]) -> Bool:
	self.length() == 0


---
Get first element of list.
Returns Some(element) if list is non-empty, None otherwise.

doctests:
    :: Head of non-empty list
    nums: List[Int] = [10, 20, 30]
    match nums.head():
        Some(v): v == 10
        None: False

    :: Head of empty list is None
    empty: List[Int] = []
    match empty.head():
        Some(_): False
        None: True
---
pure func head[T](self: List[T]) -> Option[T]:
	self.get(0)


---
Get all elements except the first.
Returns a new list without the first element, or empty list if input is empty.

doctests:
    :: Tail of a 3-element list
    nums: List[Int] = [10, 20, 30]
    result: List[Int] = nums.tail()
    result.length() == 2

    :: Tail of empty list is empty
    empty: List[Int] = []
    empty
        .tail()
        .length() == 0

    :: Tail of single element is empty
    one: List[Int] = [42]
    one
        .tail()
        .length() == 0
---
pure func tail[T](self: List[T]) -> List[T]:
	__unsafe_list_tail(self)


private pure func __unsafe_list_tail[T](self: List[T]) -> List[T]:
	builtin


---
Map a function over all elements.
Returns a new list with the function applied to each element.
---
func map[T, U](
	self: List[T],
	f: (T) -> U,
) -> List[U]:
pure func map[T, U](
	self: List[T],
	f: pure (T) -> U,
) -> List[U]:
	builtin


---
Map a function over all elements concurrently, collecting one Result per input.

This is the preferred method name for virtual-thread fan-out that returns
values. It matches `parallel` as a list method while keeping statement fan-out
on `for ... concurrently(limit: N)`.

The result order matches the input order. `limit` is the maximum number of
tasks active at once; values less than 1 run serially with a limit of 1.

doctests:
    :: Concurrent method preserves input order
    nums: List[Int] = [1, 2, 3]
    results: List[Result[Int, ConcurrencyError]] = nums.concurrent(2, func(n: Int): n * 2)
    match results.get(1):
        Some(Ok(v)): v == 4
        _: False
---
func concurrent[T, U](
	self: List[T],
	limit: Int,
	f: (T) -> U,
) -> List[Result[U, ConcurrencyError]]:
	builtin


---
Map a function over all elements concurrently with a typed whole-operation
timeout, collecting one Result per input.

Use `for ... concurrently(limit: N, timeout: d):` for statement fan-out and
`list.concurrent_with_timeout(limit, d, func)` when the caller needs the
collected results.

The result order matches the input order. `limit` is the maximum number of
tasks active at once; values less than 1 run serially with a limit of 1. The
timeout applies to the whole operation, not to each item.

doctests:
    :: Concurrent method with timeout preserves input order
    nums: List[Int] = [1, 2, 3]
    timeout: Duration = {us = 100000}
    results: List[Result[Int, ConcurrencyError]] = nums.concurrent_with_timeout(
        2,
        timeout,
        func(n: Int): n * 2,
    )
    match results.get(1):
        Some(Ok(v)): v == 4
        _: False
---
func concurrent_with_timeout[T, U](
	self: List[T],
	limit: Int,
	timeout: Duration,
	f: (T) -> U,
) -> List[Result[U, ConcurrencyError]]:
	__concurrent_timeout_ms(
		self,
		limit,
		to_timeout_milliseconds(timeout),
		f,
	)


private func __concurrent_timeout_ms[T, U](
	self: List[T],
	limit: Int,
	timeout_ms: Int,
	f: (T) -> U,
) -> List[Result[U, ConcurrencyError]]:
	builtin


---
Filter list by predicate.
Returns a new list containing only elements where predicate returns True.
---
func filter[T](
	self: List[T],
	predicate: (T) -> Bool,
) -> List[T]:
pure func filter[T](
	self: List[T],
	predicate: pure (T) -> Bool,
) -> List[T]:
	builtin


---
Filter and map in one pass.
Applies function to each element, keeping only Some results.
---
func filter_map[T, U](
	self: List[T],
	f: (T) -> Option[U],
) -> List[U]:
pure func filter_map[T, U](
	self: List[T],
	f: pure (T) -> Option[U],
) -> List[U]:
	builtin


---
Fold (reduce) from left to right.
Combines all elements using a binary function and initial accumulator.
---
func fold_left[T, Acc](
	self: List[T],
	init: Acc,
	f: (Acc, T) -> Acc,
) -> Acc:
pure func fold_left[T, Acc](
	self: List[T],
	init: Acc,
	f: pure (Acc, T) -> Acc,
) -> Acc:
	builtin


---
Fold (reduce) from right to left.
Combines all elements using a binary function and initial accumulator.
---
func fold_right[T, Acc](
	self: List[T],
	init: Acc,
	f: (T, Acc) -> Acc,
) -> Acc:
pure func fold_right[T, Acc](
	self: List[T],
	init: Acc,
	f: pure (T, Acc) -> Acc,
) -> Acc:
	builtin


---
Apply a side-effecting function to each element.
---
func for_each[T](
	self: List[T],
	f: (T) -> Void,
) -> Void:
	builtin


---
Concatenate two lists into a new list.

doctests:
    :: Concatenate two lists
    a: List[Int] = [1, 2]
    b: List[Int] = [3, 4]
    result: List[Int] = a.concat(b)
    result.length() == 4

    :: Concat with empty list
    nums: List[Int] = [1, 2, 3]
    empty: List[Int] = []
    nums
        .concat(empty)
        .length() == 3
---
pure func concat[T](a: List[T], b: List[T]) -> List[T]:
	builtin


implements Addable for List[T]:
	pure func add[T](a: List[T], b: List[T]) -> List[T]:
		a.concat(b)


---
Zip two lists into a list of pairs.
Result length is the minimum of the two input lengths.
---
pure func zip[A, B](list_a: List[A], list_b: List[B]) -> List[(A, B)]:
	builtin


