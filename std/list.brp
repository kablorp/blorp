---
Sort list in ascending order (stable merge sort).
Elements must implement Orderable (Int, Float, String, Char, etc.).

doctests:
    :: Sort integers
    nums: List[Int] = [3, 1, 4, 1, 5]
    sorted: List[Int] = nums.sort()
    match sorted.get(0):
        Some(v): v == 1
        None: False

    :: Sort already sorted list
    sorted: List[Int] = [1, 2, 3].sort()
    sorted.length() == 3
---
pure func sort[T:Orderable](self: List[T]) -> List[T]:
	builtin


---
Sort list by key function (stable).
key_fn extracts a comparable key from each element.

doctests:
    :: Sort by value
    [3, 1, 2].sort_by(func(x: Int): x) == [1, 2, 3]
---
func sort_by[T, K:Orderable](
	self: List[T],
	key_fn: (T) -> K,
) -> List[T]:
pure func sort_by[T, K:Orderable](
	self: List[T],
	key_fn: pure (T) -> K,
) -> List[T]:
	builtin


---
Sort list by key function in descending order (stable).

doctests:
    :: Sort descending by value
    [1, 3, 2].sort_desc_by(func(x: Int): x) == [3, 2, 1]

    :: Sort descending by second element
    r: List[(String, String)] = [
        ("a", "mid"),
        ("b", "low"),
        ("c", "top"),
    ].sort_desc_by(
        func(p: (String, String)): p[1],
    )
    match r.get(0):
        Some(p): p[0] == "c" and p[1] == "top"
        None: False
---
func sort_desc_by[T, K:Orderable](
	self: List[T],
	key_fn: (T) -> K,
) -> List[T]:
pure func sort_desc_by[T, K:Orderable](
	self: List[T],
	key_fn: pure (T) -> K,
) -> List[T]:
	builtin


-- ============================================================================
-- Search
-- ============================================================================
---
Binary search on a sorted list. Returns the index of the target, or None.
The list must be sorted in ascending order.

doctests:
    :: Find element
    [1, 2, 3, 4, 5].binary_search(3) == Some(2)

    :: Element not found
    [1, 2, 3, 4, 5].binary_search(6) == None

    :: Empty list
    xs: List[Int] = []
    xs.binary_search(1) == None
---
pure func binary_search[T:Orderable](sorted: List[T], target: T) -> Option[Int]:
	builtin


---
Binary search using a custom comparison function.
compare(a, b) should return negative if a < b, 0 if equal, positive if a > b.
The list must be sorted according to the same comparison function.

doctests:
    :: Find with custom compare
    cmp: pure (Int, Int) -> Int = pure func(a: Int, b: Int): a - b
    [1, 2, 3, 4, 5].binary_search_by(3, cmp) == Some(2)

    :: Not found with custom compare
    cmp: pure (Int, Int) -> Int = pure func(a: Int, b: Int): a - b
    [1, 2, 3, 4, 5].binary_search_by(6, cmp) == None
---
pure func binary_search_by[T](
	sorted: List[T],
	target: T,
	compare: pure (T, T) -> Int,
) -> Option[Int]:
	builtin


