---
Find the index of the first occurrence of an element.

doctests:
    :: Find existing element
    nums: List[Int] = [10, 20, 30]
    match nums.index_of(20):
        Some(i): i == 1
        None: False

    :: Element not found
    nums: List[Int] = [10, 20, 30]
    match nums.index_of(99):
        Some(_): False
        None: True
---
pure func index_of[T:Equatable](self: List[T], elem: T) -> Option[Int]:
	self.find_index(pure func(x: T): x == elem)


