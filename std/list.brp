---
Reverse the order of elements.

doctests:
    :: Reverse a list
    nums: List[Int] = [1, 2, 3]
    reversed: List[Int] = nums.reverse()
    match reversed.get(0):
        Some(v): v == 3
        None: False
---
pure func reverse[T](self: List[T]) -> List[T]:
	builtin


---
Find the first element matching a predicate.

doctests:
    :: Find element matching predicate
    nums: List[Int] = [1, 2, 3, 4, 5]
    match nums.find(func(x: Int): x > 3):
        Some(v): v == 4
        None: False

    :: Find in empty list returns None
    empty: List[Int] = []
    match empty.find(func(x: Int): x > 0):
        Some(_): False
        None: True
---
func find[T](
	self: List[T],
	pred: (T) -> Bool,
) -> Option[T]:
pure func find[T](
	self: List[T],
	pred: pure (T) -> Bool,
) -> Option[T]:
	builtin


---
Check if a list contains an element.

doctests:
    :: Contains existing element
    nums: List[Int] = [1, 2, 3]
    nums.contains(2) == True

    :: Does not contain missing element
    nums: List[Int] = [1, 2, 3]
    nums.contains(5) == False
---
pure func contains[T:Equatable](self: List[T], elem: T) -> Bool:
	self.any(pure func(x: T): x == elem)


---
Take the first n elements.

doctests:
    :: Take first 3 elements
    nums: List[Int] = [1, 2, 3, 4, 5]
    result: List[Int] = nums.take(3)
    result.length() == 3
---
pure func take[T](self: List[T], n: Int) -> List[T]:
	builtin


---
Drop the first n elements.

doctests:
    :: Drop first 2 elements
    nums: List[Int] = [1, 2, 3, 4, 5]
    result: List[Int] = nums.drop(2)
    result.length() == 3
---
pure func drop[T](self: List[T], n: Int) -> List[T]:
	builtin


---
Flatten a list of lists into a single list.

doctests:
    :: Flatten nested lists
    nested: List[List[Int]] = [[1, 2], [3, 4]]
    result: List[Int] = nested.flatten()
    result.length() == 4
---
pure func flatten[T](lists: List[List[T]]) -> List[T]:
	builtin


-- ============================================================================
-- Extended Operations
-- ============================================================================
---
Get the last element of a list.
Returns Some(element) if non-empty, None otherwise.

doctests:
    :: Last of non-empty list
    nums: List[Int] = [10, 20, 30]
    match nums.last():
        Some(v): v == 30
        None: False

    :: Last of empty list
    empty: List[Int] = []
    match empty.last():
        Some(_): False
        None: True
---
pure func last[T](self: List[T]) -> Option[T]:
	self.get(self.length() - 1)


---
All elements except the last.
Returns a new list, or empty if input has 0 or 1 elements.

doctests:
    :: Drop last of 3-element list
    nums: List[Int] = [1, 2, 3]
    result: List[Int] = nums.drop_last()
    result.length() == 2

    :: Drop last preserves order
    nums: List[Int] = [10, 20, 30]
    result: List[Int] = nums.drop_last()
    match result.get(1):
        Some(v): v == 20
        None: False

    :: Drop last of empty list
    empty: List[Int] = []
    empty
        .drop_last()
        .length() == 0
---
pure func drop_last[T](self: List[T]) -> List[T]:
	if self.length() == 0:
		result: List[T] = []
		result
	else:
		self.take(self.length() - 1)


---
Map each element to a list and flatten the results.

doctests:
    :: Duplicate each element
    nums: List[Int] = [1, 2, 3]
    result: List[Int] = nums.flat_map(func(x: Int): [x, x])
    result.length() == 6

    :: Flat map with varying lengths
    nums: List[Int] = [1, 2, 3]
    result: List[Int] = nums.flat_map(func(x: Int): [x, x + 10])
    match result.get(2):
        Some(v): v == 2
        None: False
---
func flat_map[T, U](
	self: List[T],
	f: (T) -> List[U],
) -> List[U]:
pure func flat_map[T, U](
	self: List[T],
	f: pure (T) -> List[U],
) -> List[U]:
	builtin


