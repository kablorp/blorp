---
Take elements from the front while the predicate holds.
Stops at the first element that doesn't match.

doctests:
    :: Take while less than 4
    nums: List[Int] = [1, 2, 3, 5, 1]
    result: List[Int] = nums.take_while(func(x: Int): x < 4)
    result.length() == 3

    :: All elements match
    nums: List[Int] = [1, 2, 3]
    nums
        .take_while(func(x: Int): x < 10)
        .length() == 3

    :: No elements match
    nums: List[Int] = [5, 6, 7]
    nums
        .take_while(func(x: Int): x < 3)
        .length() == 0
---
func take_while[T](
	self: List[T],
	pred: (T) -> Bool,
) -> List[T]:
pure func take_while[T](
	self: List[T],
	pred: pure (T) -> Bool,
) -> List[T]:
	builtin


---
Drop elements from the front while the predicate holds.
Returns the remaining elements starting from the first non-match.

doctests:
    :: Drop while less than 3
    nums: List[Int] = [1, 2, 3, 4, 5]
    result: List[Int] = nums.drop_while(func(x: Int): x < 3)
    result.length() == 3

    :: No elements dropped
    nums: List[Int] = [5, 6, 7]
    nums
        .drop_while(func(x: Int): x < 3)
        .length() == 3

    :: All elements dropped
    nums: List[Int] = [1, 2, 3]
    nums
        .drop_while(func(x: Int): x < 10)
        .length() == 0
---
func drop_while[T](
	self: List[T],
	pred: (T) -> Bool,
) -> List[T]:
pure func drop_while[T](
	self: List[T],
	pred: pure (T) -> Bool,
) -> List[T]:
	builtin


---
Split a list into elements that match and elements that don't.
Returns (matching, not_matching).

doctests:
    :: Partition into even and odd
    nums: List[Int] = [1, 2, 3, 4, 5]
    result: (List[Int], List[Int]) = nums.partition(func(x: Int): x % 2 == 0)
    evens: List[Int] = result[0]
    odds: List[Int] = result[1]
    evens.length() == 2 and odds.length() == 3

    :: Empty list
    empty: List[Int] = []
    result: (List[Int], List[Int]) = empty.partition(func(x: Int): x > 0)
    result[0].length() == 0 and result[1].length() == 0
---
func partition[T](
	self: List[T],
	pred: (T) -> Bool,
) -> (List[T], List[T]):
pure func partition[T](
	self: List[T],
	pred: pure (T) -> Bool,
) -> (List[T], List[T]):
	builtin


---
Split a list at index n into (first n elements, rest).

doctests:
    :: Split at index 2
    nums: List[Int] = [1, 2, 3, 4, 5]
    result: (List[Int], List[Int]) = nums.split_at(2)
    left: List[Int] = result[0]
    right: List[Int] = result[1]
    left.length() == 2 and right.length() == 3

    :: Split at 0
    nums: List[Int] = [1, 2, 3]
    result: (List[Int], List[Int]) = nums.split_at(0)
    result[0].length() == 0 and result[1].length() == 3
---
pure func split_at[T](self: List[T], n: Int) -> (List[T], List[T]):
	(self.take(n), self.drop(n))


---
Combine two lists element-wise using a function.
Result length is the minimum of the two input lengths.

doctests:
    :: Add corresponding elements
    a: List[Int] = [1, 2, 3]
    b: List[Int] = [10, 20, 30]
    result: List[Int] = a.zip_with(b, func(x: Int, y: Int): x + y)
    match result.get(0):
        Some(v): v == 11
        None: False

    :: Different length lists use shorter
    a: List[Int] = [1, 2]
    b: List[Int] = [10, 20, 30]
    a
        .zip_with(b, func(x: Int, y: Int): x + y)
        .length() == 2
---
func zip_with[A, B, C](
	list_a: List[A],
	list_b: List[B],
	f: (A, B) -> C,
) -> List[C]:
pure func zip_with[A, B, C](
	list_a: List[A],
	list_b: List[B],
	f: pure (A, B) -> C,
) -> List[C]:
	builtin


---
Split a list of pairs into a pair of lists.
Inverse of zip.

doctests:
    :: Unzip pairs
    pairs: List[(Int, String)] = [(1, "a"), (2, "b"), (3, "c")]
    result: (List[Int], List[String]) = pairs.unzip()
    result[0].length() == 3 and result[1].length() == 3

    :: Unzip preserves order
    pairs: List[(Int, Int)] = [(10, 1), (20, 2)]
    result: (List[Int], List[Int]) = pairs.unzip()
    firsts: List[Int] = result[0]
    match firsts.get(0):
        Some(v): v == 10
        None: False
---
pure func unzip[A, B](self: List[(A, B)]) -> (List[A], List[B]):
	builtin


---
Create a list containing n copies of a value.

doctests:
    :: Repeat 3 times
    result: List[Int] = 42.repeat(3)
    result.length() == 3

    :: All elements are the same
    result: List[Int] = 7.repeat(2)
    match result.get(1):
        Some(v): v == 7
        None: False

    :: Repeat 0 times
    1
        .repeat(0)
        .length() == 0
---
pure func repeat[T](elem: T, n: Int) -> List[T]:
	builtin


---
Create a list of integers from start (inclusive) to stop (exclusive).

doctests:
    :: Range from 1 to 5
    result: List[Int] = range(1, 5)
    result.length() == 4

    :: First element is start
    result: List[Int] = range(3, 7)
    match result.get(0):
        Some(v): v == 3
        None: False

    :: Empty range when start >= stop
    range(5, 3).length() == 0
---
pure func range(start: Int, stop: Int) -> List[Int]:
	builtin


---
Remove duplicate elements, preserving the first occurrence of each.
Uses equality comparison. O(n^2).

doctests:
    :: Remove duplicates
    nums: List[Int] = [1, 2, 3, 2, 1, 4]
    result: List[Int] = nums.unique()
    result.length() == 4

    :: Preserves first occurrence order
    nums: List[Int] = [3, 1, 2, 1, 3]
    result: List[Int] = nums.unique()
    match result.get(0):
        Some(v): v == 3
        None: False

    :: Already unique list unchanged
    nums: List[Int] = [1, 2, 3]
    nums
        .unique()
        .length() == 3
---
pure func unique[T:Equatable](self: List[T]) -> List[T]:
	builtin


-- =============================================================================
-- String Reductions
-- =============================================================================
---
Join a list of strings with a separator.

doctests:
    :: Join with comma
    ["a", "b", "c"].join(",") == "a,b,c"

    :: Join single element
    ["hello"].join(" ") == "hello"

    :: Join empty list
    empty: List[String] = []
    empty.join(",") == ""
---
pure func join(self: List[String], sep: String) -> String:
	var result: String = ""
	var first: Bool = True
	for s in self:
		if first:
			if s.length() > 0:
				result = result.string_append(s)
			first = False
		else:
			if sep.length() > 0:
				result = result.string_append(sep)
			if s.length() > 0:
				result = result.string_append(s)
	result


private pure func string_append(self: String, other: String) -> String:
	builtin


-- =============================================================================
-- Numeric Reductions
-- =============================================================================
---
Sum all elements of a list.

doctests:
    :: Sum of integers
    sum([1, 2, 3, 4]) == 10

    :: Sum of floats
    sum([1.0, 2.5, 3.5]) == 7.0

    :: Sum of empty list
    empty: List[Int] = []
    sum(empty) == 0
---
pure func sum[T:Addable+HasZero](self: List[T]) -> T:
	var total: T = zero()
	for x in self:
		total += x
	total


---
Product of all elements of a list.

doctests:
    :: Product of integers
    product([1, 2, 3, 4]) == 24

    :: Product of floats
    product([2.0, 3.0, 4.0]) == 24.0

    :: Product with zero
    product([5, 0, 3]) == 0
---
pure func product[T:Multipliable+HasOne](self: List[T]) -> T:
	var total: T = one()
	for x in self:
		total *= x
	total


---
Find the element that produces the minimum value when transformed by f.
Returns None for empty lists.

doctests:
    :: Min by identity
    nums: List[Int] = [3, 1, 2]
    min_by(nums, pure func(x: Int): x) == Some(1)

    :: Min by negation (finds max)
    nums: List[Int] = [3, 1, 2]
    min_by(nums, pure func(x: Int): 0 - x) == Some(3)
---
func min_by[T, K:Orderable](
	self: List[T],
	f: (T) -> K,
) -> Option[T]:
pure func min_by[T, K:Orderable](
	self: List[T],
	f: pure (T) -> K,
) -> Option[T]:
	builtin


---
Find the element that produces the maximum value when transformed by f.
Returns None for empty lists.

doctests:
    :: Max by identity
    nums: List[Int] = [3, 1, 2]
    max_by(nums, pure func(x: Int): x) == Some(3)

    :: Max by negation (finds min)
    nums: List[Int] = [3, 1, 2]
    max_by(nums, pure func(x: Int): 0 - x) == Some(1)
---
func max_by[T, K:Orderable](
	self: List[T],
	f: (T) -> K,
) -> Option[T]:
pure func max_by[T, K:Orderable](
	self: List[T],
	f: pure (T) -> K,
) -> Option[T]:
	builtin


-- =============================================================================
-- Windowing and Scanning
-- =============================================================================
---
Sliding windows of size n over the list.
Returns a list of sub-lists, each of length n.
Returns empty list if n <= 0 or n > list.length().

doctests:
    :: Sliding windows of size 2
    nums: List[Int] = [1, 2, 3, 4]
    w: List[List[Int]] = windows(nums, 2)
    w.length() == 3

    :: Single-element windows
    nums: List[Int] = [1, 2, 3]
    w: List[List[Int]] = windows(nums, 1)
    w.length() == 3

    :: Window size equals list length
    nums: List[Int] = [1, 2, 3]
    w: List[List[Int]] = windows(nums, 3)
    w.length() == 1

    :: Window too large returns empty
    nums: List[Int] = [1, 2]
    w: List[List[Int]] = windows(nums, 5)
    w.length() == 0
---
pure func windows[T](self: List[T], n: Int) -> List[List[T]]:
	builtin


---
Non-overlapping chunks of size n.
The last chunk may be smaller than n if the list length is not divisible by n.
Returns empty list if n <= 0.

doctests:
    :: Even chunks
    nums: List[Int] = [1, 2, 3, 4]
    c: List[List[Int]] = chunks(nums, 2)
    c.length() == 2

    :: Uneven chunks — last chunk is smaller
    nums: List[Int] = [1, 2, 3, 4, 5]
    c: List[List[Int]] = chunks(nums, 2)
    c.length() == 3

    :: Chunk size equals list length
    nums: List[Int] = [1, 2, 3]
    c: List[List[Int]] = chunks(nums, 3)
    c.length() == 1

    :: Chunk size larger than list
    nums: List[Int] = [1, 2]
    c: List[List[Int]] = chunks(nums, 5)
    c.length() == 1
---
pure func chunks[T](self: List[T], n: Int) -> List[List[T]]:
	builtin


---
Fold with intermediate results. Like fold_left but returns a list of
all accumulated values, starting with the initial value.
---
func scan[T, A](
	self: List[T],
	init: A,
	f: (A, T) -> A,
) -> List[A]:
pure func scan[T, A](
	self: List[T],
	init: A,
	f: pure (A, T) -> A,
) -> List[A]:
	builtin


-- =============================================================================
-- Parallel List Pipelines
-- =============================================================================
-- `parallel` is the only public entry point for list parallelism. The callback
-- receives a ParallelList[T], which intentionally exposes only parallel-safe
-- combinators. It cannot be indexed, measured, collected, or mutated directly.
---
Run a parallel list pipeline.

The callback can use ParallelList.map, ParallelList.filter, and
ParallelList.filter_map. The result is materialized back into a normal List
when the callback returns.
---
pure func parallel[T, U](
	self: List[T],
	body: pure (ParallelList[T]) -> ParallelList[U],
) -> List[U]:
	builtin
