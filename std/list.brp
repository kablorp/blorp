    nums: List[Int] = [10, 20, 30]
    result: List[Int] = nums.map_indexed(func(i: Int, x: Int): i * x)
    match result.get(2):
        Some(v): v == 60
        None: False

    :: Index starts at zero
    nums: List[String] = ["a", "b"]
    result: List[Int] = nums.map_indexed(func(i: Int, s: String): i)
    match result.get(0):
        Some(v): v == 0
        None: False
