-- StringSlice - Zero-copy string views for efficient parsing
--
-- StringSlice provides a view into an existing string without copying.
-- This is essential for efficient parsing where substring operations
-- would otherwise allocate new memory for each parse step.
--
-- StringSlice is a built-in type backed by the runtime. It holds a reference
-- to a base string plus offset and length, enabling zero-copy substring views.
type StringSlice = builtin


-- ============================================================================
-- Builtins
-- ============================================================================
---
Create a slice from a string (covers the entire string).

doctests:
    :: Create from string
    s: StringSlice = from_string("hello")
    s.length() == 5
---
pure func from_string(s: String) -> StringSlice:
	builtin("std/slice.from_string")


---
Get the length of the slice (in bytes).

doctests:
    :: Length of slice
    s: StringSlice = from_string("hello")
    s.length() == 5
---
pure func length(slice: StringSlice) -> Int:
	builtin("std/slice.length")


---
Materialize the slice into a new String (allocates).
---
implements Stringable for StringSlice:
	pure func to_string(slice: StringSlice) -> String:
		builtin("std/slice.to_string")


implements HasLength for StringSlice:
	pure func length(slice: StringSlice) -> Int:
		builtin("std/slice.length")


---
Get a sub-slice (zero-copy, shares base string).
start is byte offset, len is byte length.

doctests:
    :: Sub-slice of string
    s: StringSlice = from_string("hello world")
    sub: StringSlice = s.substring(0, 5)
    sub.length() == 5
---
pure func substring(slice: StringSlice, start: Int, len: Int) -> StringSlice:
	builtin("std/slice.substring")


---
Check if slice starts with a given prefix.

doctests:
    :: Matching prefix
    s: StringSlice = from_string("hello")
    s.starts_with("hel") == True

    :: Non-matching prefix
    s: StringSlice = from_string("hello")
    s.starts_with("xyz") == False
---
pure func starts_with(slice: StringSlice, prefix: String) -> Bool:
	builtin("std/slice.starts_with")


-- ============================================================================
-- Safe Access
-- ============================================================================
---
Bounds-checked character access.
Returns Some(char) for valid index, None for out-of-bounds.

doctests:
    :: Get first character
    s: StringSlice = from_string("hello")

    match s.get(0):
        Some(c):
            c == 'h'
        None:
            False
---
pure func get(slice: StringSlice, index: Int) -> Option[Char]:
	builtin("std/slice.get")


-- ============================================================================
-- Utilities
-- ============================================================================
---
Check if the slice is empty.

doctests:
    :: Empty slice is empty
    s: StringSlice = from_string("")
    is_empty(s) == True

    :: Non-empty slice is not empty
    s: StringSlice = from_string("hello")
    is_empty(s) == False
---
pure func is_empty(slice: StringSlice) -> Bool:
	slice.length() == 0


---
Get the first character of the slice, or None if empty.

doctests:
    :: Head of slice
    s: StringSlice = from_string("hello")

    match head(s):
        Some(c):
            c == 'h'
        None:
            False
---
pure func head(slice: StringSlice) -> Option[Char]:
	get(slice, 0)


---
Get a slice without the first character (zero-copy).

doctests:
    :: Tail removes first character
    s: StringSlice = from_string("hello")
    tail(s).length() == 4
---
pure func tail(slice: StringSlice) -> StringSlice:
	if slice.length() > 0:
		slice.substring(1, slice.length() - 1)
	else:
		slice


---
Check if slice ends with the given suffix string.

doctests:
    :: Matching suffix
    s: StringSlice = from_string("hello")
    s.ends_with("llo") == True

    :: Non-matching suffix
    s: StringSlice = from_string("hello")
    s.ends_with("xyz") == False
---
pure func ends_with(slice: StringSlice, suffix: String) -> Bool:
	suf_slice: StringSlice = from_string(suffix)
	suf_len: Int = suf_slice.length()
	sl_len: Int = slice.length()

	if suf_len > sl_len:
		False
	else:
		sub: StringSlice = slice.substring(sl_len - suf_len, suf_len)
		sub.to_string() == suffix


---
Check if slice contains the given needle string.

doctests:
    :: Contains substring
    s: StringSlice = from_string("hello world")
    s.contains("world") == True

    :: Does not contain
    s: StringSlice = from_string("hello")
    s.contains("xyz") == False
---
pure func contains(slice: StringSlice, needle: String) -> Bool:
	match slice.index_of(needle):
		Some(_):
			True
		None:
			False


---
Find the index of needle in the slice.
Returns Some(index) if found, None if not found.

doctests:
    :: Find existing substring
    s: StringSlice = from_string("hello world")

    match s.index_of("world"):
        Some(i):
            i == 6
        None:
            False
---
pure func index_of(slice: StringSlice, needle: String) -> Option[Int]:
	needle_slice: StringSlice = from_string(needle)
	needle_len: Int = needle_slice.length()
	sl_len: Int = slice.length()

	if needle_len > sl_len:
		None
	else:
		var i: Int = 0
		var result: Option[Int] = None

		while i <= sl_len - needle_len:
			sub: StringSlice = slice.substring(i, needle_len)

			if sub.to_string() == needle:
				result = Some(i)
				break

			i += 1

		result


---
Trim leading and trailing whitespace from a slice.
Returns a new sub-slice (zero-copy).

doctests:
    :: Trim whitespace
    s: StringSlice = from_string("  hello  ")
    trim(s).to_string() == "hello"
---
pure func trim(slice: StringSlice) -> StringSlice:
	sl_len: Int = slice.length()
	var start: Int = 0

	while start < sl_len:
		match slice.get(start):
			Some(c):
				if (
					c == ' '
					or c == '\t'
					or c == '\n'
					or c == '\r'
				):
					start += 1
				else:
					break
			None:
				break

	var end_pos: Int = sl_len

	while end_pos > start:
		match slice.get(end_pos - 1):
			Some(c):
				if (
					c == ' '
					or c == '\t'
					or c == '\n'
					or c == '\r'
				):
					end_pos -= 1
				else:
					break
			None:
				break

	slice.substring(start, end_pos - start)
