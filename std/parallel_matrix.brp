-- ParallelMatrix - scoped combinators for Matrix.parallel callbacks.
import:
	matrix: ParallelMatrix


private pure func __parallel_matrix_map[T, U, #M, #N](
	self: ParallelMatrix[T, #M, #N],
	f: pure (T) -> U,
) -> ParallelMatrix[U, #M, #N]:
	builtin("blorp_mmap_parallel")


private pure func __parallel_matrix_map_indexed[T, U, #M, #N](
	self: ParallelMatrix[T, #M, #N],
	f: pure (..#M, ..#N, T) -> U,
) -> ParallelMatrix[U, #M, #N]:
	builtin("blorp_mmap_indexed_parallel")


private pure func __parallel_matrix_zip_map[A, B, C, #M, #N](
	self: ParallelMatrix[A, #M, #N],
	other: B[#M, #N],
	f: pure (A, B) -> C,
) -> ParallelMatrix[C, #M, #N]:
	builtin("blorp_mzip_parallel")


---
Parallel shape-preserving map over a ParallelMatrix.
---
pure func map[T, U, #M, #N](
	self: ParallelMatrix[T, #M, #N],
	f: pure (T) -> U,
) -> ParallelMatrix[U, #M, #N]:
	__parallel_matrix_map(self, f)


---
Parallel shape-preserving indexed map over a ParallelMatrix.
---
pure func map_indexed[T, U, #M, #N](
	self: ParallelMatrix[T, #M, #N],
	f: pure (..#M, ..#N, T) -> U,
) -> ParallelMatrix[U, #M, #N]:
	__parallel_matrix_map_indexed(self, f)


---
Parallel shape-preserving zip-map over a ParallelMatrix and same-sized matrix.
---
pure func zip_map[A, B, C, #M, #N](
	self: ParallelMatrix[A, #M, #N],
	other: B[#M, #N],
	f: pure (A, B) -> C,
) -> ParallelMatrix[C, #M, #N]:
	__parallel_matrix_zip_map(self, other, f)
