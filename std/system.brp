-- System - System interface and File I/O operations
--
-- Provides functions for interacting with the operating system and file system.
-- All file I/O functions are impure as they have side effects.
import:
	fs: IOError, open_dir, read_entry


-- ============================================================================
-- Command Execution
-- ============================================================================
---
Execute a shell command, returns exit code.
WARNING: Uses system() which spawns a shell. User input passed to this
function can lead to command injection. Prefer process.run() for safe
command execution without shell interpretation.
---
func exec(command: String) -> Int:
	builtin("blorp_exec")


-- ============================================================================
-- File System Queries
-- ============================================================================
-- Check if a file or directory exists
func file_exists(path: String) -> Bool:
	builtin("blorp_file_exists")


-- Check if path is a directory
func is_directory(path: String) -> Bool:
	builtin("blorp_is_directory")


-- ============================================================================
-- File I/O
-- ============================================================================
-- Read entire file contents, returns Err with error message on failure
func read_file(path: String) -> Result[String, String]:
	builtin("blorp_read_file")


-- Write content to file, returns Err with error message on failure
func write_file(path: String, content: String) -> Result[Void, String]:
	builtin("blorp_write_file")


-- Read entire file contents as raw bytes, returns Err with error message on failure
func read_bytes(path: String) -> Result[Bytes, String]:
	builtin("blorp_read_bytes")


-- Write bytes directly to a file, returns Err with error message on failure
func write_bytes(path: String, content: Bytes) -> Result[Void, String]:
	builtin("blorp_write_bytes")


-- Read all lines from a file into a list (strips newlines)
-- Returns empty list if file doesn't exist
-- Loads entire file into memory; for small/medium files
func read_all_lines(path: String) -> List[String]:
	builtin("blorp_read_all_lines")


-- Write list of strings as lines to a file (adds newlines)
-- Returns True on success
func write_lines(path: String, lines: List[String]) -> Bool:
	match write_file(
		path,
		lines.join("\n"),
	):
		Ok(_):
			True
		Err(_):
			False


-- Append content to end of file, returns True on success
func append_file(path: String, content: String) -> Bool:
	builtin("blorp_append_file")


-- Process a file line by line with constant memory usage
-- Callback receives (line_number, line_content) — 1-indexed, newlines stripped
-- Returns Ok on success, Err on file open failure
func for_each_line(
	path: String,
	callback: (Int, String) -> Void,
) -> Result[Void, String]:
	builtin("blorp_for_each_line")


---
Process a file in chunks with constant memory usage.
Reads chunk_size bytes at a time, calls callback with each chunk as a String.
Returns Ok on success, Err on file open failure.

doctests:
    :: Read file in chunks
    _ = write_file("/tmp/__blorp_test_chunk", "hello world")
    result: Result[Void, String] = for_each_chunk("/tmp/__blorp_test_chunk", 5, func(chunk: String):
        _ = chunk.length()
    )
    _ = remove_file("/tmp/__blorp_test_chunk")
    to_bool(result)
---
func for_each_chunk(
	path: String,
	chunk_size: Int,
	callback: (String) -> Void,
) -> Result[Void, String]:
	builtin("blorp_for_each_chunk")


-- ============================================================================
-- Filesystem Operations
-- ============================================================================
---
Get the current working directory.
Returns empty string if the directory cannot be determined.

doctests:
    :: getcwd returns a non-empty string
    getcwd().length() > 0
---
func getcwd() -> String:
	builtin("blorp_getcwd")


---
Create a directory at the given path with mode 0755.
Returns True on success, False on failure (e.g., path already exists).

doctests:
    :: Create and clean up a test directory
    _ = mkdir("/tmp/__blorp_test_mkdir")
    result: Bool = file_exists("/tmp/__blorp_test_mkdir")
    _ = remove_dir("/tmp/__blorp_test_mkdir")
    result == True
---
func mkdir(path: String) -> Bool:
	builtin("blorp_mkdir")


---
Remove a file at the given path.
Returns True on success, False on failure (e.g., file does not exist).

doctests:
    :: Remove a file that was just created
    _ = write_file("/tmp/__blorp_test_rm", "x")
    remove_file("/tmp/__blorp_test_rm") == True

    :: Removing a nonexistent file returns False
    remove_file("/tmp/__blorp_nonexistent_file_xyz") == False
---
func remove_file(path: String) -> Bool:
	builtin("blorp_remove_file")


---
Remove an empty directory at the given path.
Returns True on success, False on failure (e.g., not empty or does not exist).

doctests:
    :: Remove an empty directory
    _ = mkdir("/tmp/__blorp_test_rmdir")
    remove_dir("/tmp/__blorp_test_rmdir") == True

    :: Removing a nonexistent directory returns False
    remove_dir("/tmp/__blorp_nonexistent_dir_xyz") == False
---
func remove_dir(path: String) -> Bool:
	builtin("blorp_remove_dir")


---
Rename a file or directory from src path to dst path.
Returns True on success, False on failure.

doctests:
    :: Rename a file
    _ = write_file("/tmp/__blorp_test_rename_src", "data")
    _ = rename("/tmp/__blorp_test_rename_src", "/tmp/__blorp_test_rename_dst")
    result: Bool = file_exists("/tmp/__blorp_test_rename_dst")
    _ = remove_file("/tmp/__blorp_test_rename_dst")
    result == True
---
func rename(src: String, dst: String) -> Bool:
	builtin("blorp_rename")


---
Execute a shell command and capture its stdout output.
Returns Ok with the output string (trailing newline stripped) on success,
or Err with an error message on failure.

WARNING: Uses popen() which spawns a shell. User input passed to this
function can lead to command injection. Prefer process.run() for safe
command execution without shell interpretation.

doctests:
    :: Capture echo output
    to_bool(exec_output("echo hello"))

    :: Failed command returns Err
    not to_bool(exec_output("false"))
---
func exec_output(command: String) -> Result[String, String]:
	builtin("blorp_exec_output")


-- ============================================================================
-- Environment Variables
-- ============================================================================
-- Get environment variable value, returns None if not set
func getenv(name: String) -> Option[String]:
	builtin("blorp_getenv")


-- Set environment variable, returns True on success
func setenv(name: String, value: String) -> Bool:
	builtin("blorp_setenv")


-- ============================================================================
-- Timing
-- ============================================================================
-- Get monotonic time in microseconds (for performance measurement)
-- NOTE: This is monotonic clock time, not wall-clock. Use time for dates.
func now_microseconds() -> Int:
	builtin("blorp_now_us")


-- ============================================================================
-- File Metadata
-- ============================================================================
---
Get file size in bytes.

doctests:
    :: Get size of a file
    _ = write_file("/tmp/__blorp_test_fsize", "hello")

    match file_size("/tmp/__blorp_test_fsize"):
        Ok(n):
            n == 5
        Err(_):
            False
---
func file_size(path: String) -> Result[Int, String]:
	builtin("blorp_file_size")


---
Get file modification time as seconds since Unix epoch.

doctests:
    :: Get mtime of a file
    _ = write_file("/tmp/__blorp_test_fmod", "data")

    match file_modified("/tmp/__blorp_test_fmod"):
        Ok(t):
            t > 0
        Err(_):
            False
---
func file_modified(path: String) -> Result[Int, String]:
	builtin("blorp_file_modified")


---
Get the system temporary directory path.

doctests:
    :: Temp dir is non-empty
    temp_dir().length() > 0
---
func temp_dir() -> String:
	builtin("blorp_temp_dir")


---
Create a temporary file with a given prefix. Returns the path on success.

doctests:
    :: Create temp file
    match mkstemp_path("blorp_test_"):
        Ok(path):
            file_exists(path)
        Err(_):
            False
---
func mkstemp_path(prefix: String) -> Result[String, String]:
	builtin("blorp_mkstemp_path")


---
Recursively list all files under a directory.

doctests:
    :: Walk dir finds files
    _ = mkdir("/tmp/__blorp_test_walk")
    _ = write_file("/tmp/__blorp_test_walk/a.txt", "a")
    files: List[String] = walk_dir("/tmp/__blorp_test_walk")
    _ = remove_file("/tmp/__blorp_test_walk/a.txt")
    _ = remove_dir("/tmp/__blorp_test_walk")
    files.length() >= 1
---
private func walk_dir_result(path: String) -> Result[List[String], IOError]:
	with dir ?= open_dir(path):
		var result: List[String] = []
		var done: Bool = False
		var error: Option[IOError] = None

		while not done:
			match read_entry(dir):
				Ok(Some(entry)):
					full: String = path + "/" + entry.name

					if is_directory(full):
						for sub in walk_dir(full):
							result = result.append(sub)
					else:
						result = result.append(full)
				Ok(None):
					done = True
				Err(err):
					error = Some(err)
					done = True

		match error:
			Some(err):
				Err(err)
			None:
				Ok(result)


func walk_dir(path: String) -> List[String]:
	match walk_dir_result(path):
		Ok(files):
			files
		Err(_):
			[]
