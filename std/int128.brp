-- Int128 - Trait Implementations
--
-- Signed 128-bit integer type.
type Int128 = builtin


implements Stringable for Int128:
	pure func to_string(val: Int128) -> String:
		builtin("blorp_int128_to_string")


implements Equatable for Int128:
	pure func equals(a: Int128, b: Int128) -> Bool:
		a == b

	pure func not_equals(a: Int128, b: Int128) -> Bool:
		a != b


implements Orderable for Int128:
	pure func less_than(a: Int128, b: Int128) -> Bool:
		a < b

	pure func greater_than(a: Int128, b: Int128) -> Bool:
		a > b

	pure func less_than_or_equal(a: Int128, b: Int128) -> Bool:
		a <= b

	pure func greater_than_or_equal(a: Int128, b: Int128) -> Bool:
		a >= b


implements Bounded for Int128:
	pure func min(a: Int128, b: Int128) -> Int128:
		match a < b:
			True: a
			_: b

	pure func max(a: Int128, b: Int128) -> Int128:
		match a > b:
			True: a
			_: b


implements Absolute for Int128:
	pure func abs(val: Int128) -> Int128:
		match val < to_int128(0):
			True: -val
			_: val


implements Negatable for Int128:
	pure func negate(a: Int128) -> Int128:
		-a


implements HasZero for Int128:
	pure func zero() -> Int128:
		to_int128(0)


implements HasOne for Int128:
	pure func one() -> Int128:
		to_int128(1)


implements ToBool for Int128:
	pure func to_bool(val: Int128) -> Bool:
		val != to_int128(0)


implements ToInt for Int128:
	pure func to_int(val: Int128) -> Int:
		to_int(val)


implements Addable for Int128:
	pure func add(a: Int128, b: Int128) -> Int128:
		a + b


implements Subtractable for Int128:
	pure func subtract(a: Int128, b: Int128) -> Int128:
		a - b


implements Multipliable for Int128:
	pure func multiply(a: Int128, b: Int128) -> Int128:
		a * b


implements Divisible for Int128:
	pure func divide(a: Int128, b: Int128) -> Int128:
		a / b


implements Modulable for Int128:
	pure func remainder(a: Int128, b: Int128) -> Int128:
		a % b
