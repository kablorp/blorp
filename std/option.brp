-- Option - Optional value type
--
-- Option[T] represents a value that may or may not be present.
-- Used for safe handling of "nullable" values without null pointers.
-- The compiler specializes the representation by payload type: primitive
-- scalars, Int128/UInt128, ranges, enums, and structs use stack layouts;
-- managed payloads use an internal nullable pointer; nested/unsafe generic
-- cases stay boxed.
--
-- Variants:
-- - Some(T): Contains a value
-- - None: No value present
--
-- Core Functions:
-- - is_some, is_none: Check presence
-- - get_or, get_or_else: Get value with default
-- - map, and_then, filter: Transform contents
--
-- Trait Implementations:
-- - ToBool: Some -> True, None -> False
-- - Stringable: "Some(x)" or "None" (requires T: Stringable)
-- - Equatable: Compare by contents (requires T: Equatable)
-- Union (sum type) definition
union Option[T]:
	Some(T)
	None


---
Check if option contains a value.

doctests:
    :: Some returns true
    is_some(Some(42)) == True
---
pure func is_some[T](self: Option[T]) -> Bool:
	match self:
		Some(_): True
		None: False


---
Check if option is empty.

doctests:
    :: None case
    opt: Option[Int] = None
    is_none(opt) == True
---
pure func is_none[T](self: Option[T]) -> Bool:
	match self:
		Some(_): False
		None: True


---
Get the value or return a default.

doctests:
    :: Unwrap Some returns value
    get_or(Some(42), 0) == 42

    :: Unwrap None returns default
    opt: Option[Int] = None
    opt.get_or(0) == 0
---
pure func get_or[T](self: Option[T], default_val: T) -> T:
	match self:
		Some(val): val
		None: default_val


---
Map a function over an option
Returns Some(f(val)) if Some, None if None.

doctests:
    :: Map over Some
    match map(Some(5), func(x: Int): x * 2):
        Some(v): v == 10
        None: False
---
func map[T, U](
	self: Option[T],
	f: (T) -> U,
) -> Option[U]:
pure func map[T, U](
	self: Option[T],
	f: pure (T) -> U,
) -> Option[U]:
	match self:
		Some(val): Some(f(val))
		None: None


---
Chain operations that return Option (pure version).
Returns f(val) if Some, None if None.

doctests:
    :: and_then over Some
    match and_then(Some(5), func(x: Int): Some(x * 2)):
        Some(v): v == 10
        None: False
---
func and_then[T, U](
	self: Option[T],
	f: (T) -> Option[U],
) -> Option[U]:
pure func and_then[T, U](
	self: Option[T],
	f: pure (T) -> Option[U],
) -> Option[U]:
	match self:
		Some(val): f(val)
		_: None


---
Keep value only if predicate is true (pure version).

doctests:
    :: Filter keeps matching value
    match filter(Some(10), func(x: Int): x > 5):
        Some(v): v == 10
        None: False
---
func filter[T](
	self: Option[T],
	pred: (T) -> Bool,
) -> Option[T]:
pure func filter[T](
	self: Option[T],
	pred: pure (T) -> Bool,
) -> Option[T]:
	match self:
		Some(val):
			if pred(val):
				Some(val)
			else:
				None
		None: None


---
Get value or compute default lazily

doctests:
    :: Unwrap Some skips default function
    get_or_else(Some(42), func(): 0) == 42
---
pure func get_or_else[T](
	self: Option[T],
	default_fn: pure () -> T,
) -> T:
func get_or_else[T](
	self: Option[T],
	default_fn: () -> T,
) -> T:
	match self:
		Some(val): val
		None: default_fn()


---
Convert Option to Result, using given error value if None.
Useful with ? operator: `some_option().ok_or("missing")?`
---
pure func ok_or[T, E](self: Option[T], error: E) -> Result[T, E]:
	match self:
		Some(val): Ok(val)
		None: Err(error)


implements ToBool for Option[T]:
	pure func to_bool[T](self: Option[T]) -> Bool:
		match self:
			Some(_): True
			None: False


implements Stringable for Option[T:Stringable]:
	pure func to_string[T:Stringable](self: Option[T]) -> String:
		match self:
			Some(val): "Some(" + val.to_string() + ")"
			None: "None"


implements Equatable for Option[T:Equatable]:
	pure func equals[T:Equatable](a: Option[T], b: Option[T]) -> Bool:
		match a:
			Some(x):
				match b:
					Some(y): equals(x, y)
					None: False
			None:
				match b:
					Some(_): False
					None: True

	pure func not_equals[T:Equatable](a: Option[T], b: Option[T]) -> Bool:
		match a:
			Some(x):
				match b:
					Some(y): not equals(x, y)
					None: True
			None:
				match b:
					Some(_): True
					None: False
