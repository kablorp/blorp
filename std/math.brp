-- Math - mathematical constants and cross-type math helpers.
-- Mathematical constants
PI: Float = 3.141592653589793

E: Float = 2.718281828459045

TAU: Float = 6.283185307179586

PHI: Float = 1.618033988749895


-- Checked arithmetic error type.
--
-- Integer checked arithmetic helpers live in std/int.brp. This error type
-- stays here for now because divide_checked_float still belongs to math until
-- the float API cleanup happens.
union MathError:
	DivByZero
	Overflow
	Underflow


---
Safe float division that returns Result instead of 0.0 on divide-by-zero.

doctests:
    :: Float division success
    match divide_checked_float(10.0, 2.0):
        Ok(v):
            v > 4.9
        Err(_):
            False

    :: Float division by zero returns error
    match divide_checked_float(10.0, 0.0):
        Ok(_):
            False
        Err(DivByZero):
            True
        Err(_):
            False
---
pure func divide_checked_float(a: Float, b: Float) -> Result[Float, MathError]:
	if b == 0.0:
		Err(DivByZero)
	else:
		Ok(a / b)
