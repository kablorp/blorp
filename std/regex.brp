-- Regex - Regular expression operations (POSIX Extended)
--
-- Uses POSIX Extended Regular Expressions (ERE) via regex.h.
-- All functions return Result to handle invalid patterns.
--
-- POSIX ERE limitations (by design — no external dependencies):
-- - No non-greedy quantifiers (*?, +?)
-- - No lookahead/lookbehind (?=...), (?<=...)
-- - No Unicode character classes (\p{L})
-- - No backreferences in replacement strings
--
-- Supported syntax: . * + ? [] [^] () | {} ^ $ \b
-- Character classes: [a-z] [0-9] [[:alpha:]] [[:digit:]] etc.
-- ============================================================================
-- Core Regex Operations (builtins)
-- ============================================================================
---
Test if pattern matches anywhere in text.
Returns Ok(True) if match found, Ok(False) if not, Err(msg) for invalid pattern.

doctests:
    :: Pattern matches
    match test_regex("[0-9]+", "abc123"):
        Ok(v): v == True
        Err(_): False

    :: Pattern does not match
    match test_regex("[0-9]+", "abc"):
        Ok(v): v == False
        Err(_): False
---
pure func test_regex(pattern: String, text: String) -> Result[Bool, String]:
	builtin("blorp_regex_test")


---
Find first match with capture groups.
Returns Ok(Some([full_match, group1, ...])) on match, Ok(None) if no match.

doctests:
    :: Find first match
    match "[0-9]+".find("abc123def"):
        Ok(result):
            match result:
                Some(matches): matches.length() > 0
                None: False
        Err(_): False
---
pure func find(pattern: String, text: String) -> Result[Option[List[String]], String]:
	builtin("blorp_regex_find")


---
Replace all occurrences of pattern with replacement.
Returns Ok(result_string), Err(msg) for invalid pattern.

doctests:
    :: Replace all matches
    match "[0-9]+".replace_all("NUM", "abc123def456"):
        Ok(v): v == "abcNUMdefNUM"
        Err(_): False
---
pure func replace_all(pattern: String, replacement: String, text: String) -> Result[String, String]:
	builtin("blorp_regex_replace_all")


---
Find all non-overlapping matches (full matches only, no groups).
Returns Ok([match1, match2, ...]), Err(msg) for invalid pattern.

doctests:
    :: Find all matches
    match find_all("[0-9]+", "abc123def456"):
        Ok(matches): matches.length() == 2
        Err(_): False
---
pure func find_all(pattern: String, text: String) -> Result[List[String], String]:
	builtin("blorp_regex_find_all")
