-- Test - Testing framework for blorp programs
--
-- Provides a simple test suite structure for writing and running tests.
--
-- Usage: import `test: TestSuite` in an import block.
--
-- func test_something() -> Bool:
-- actual == expected
--
-- tests: TestSuite = {
-- description = "My Tests",
-- tests = [("test name", test_something)]
-- }
--
-- Run with: ./blorp test path/to/test.brp
--
-- The test runner automatically detects the `tests` binding and runs it.
import:
	memory: MemStats, get_mem_stats, print_live_object_summary, reset_mem_stats


-- TestSuite record type for structured testing
record TestSuite {
	description: String,
	tests: List[(String, () -> Bool)]
}


---
Test-only cancellation hook.

Runs `task` in a child task, waits until the child is observed parked at a
runtime cancellation point, then cancels and joins it. Returns False if the
child completed or could not be observed parked before the bounded probe ended.

Use this only for deterministic runtime hardening tests that need to avoid
wall-clock timeout races.
---
func cancel_after_parked_for_test(task: () -> Int) -> Bool:
	builtin("blorp_test_cancel_after_parked")


---
Test-only task-window cleanup probe.

Checks that runtime task-window cleanup flushes pending batched child tasks and
owns any still-live task slots before freeing its paired storage. Use this only
for deterministic scheduler runtime hardening tests.
---
func task_window_pending_cleanup_probe_for_test() -> Bool:
	builtin("blorp_test_task_window_pending_cleanup_probe")


---
Test-only task join slot probe.

Checks that the runtime task join slot can replace a stale waiter and clears
the slot through the shared remove helper. Use this only for deterministic
scheduler runtime hardening tests.
---
func task_join_slot_probe_for_test() -> Bool:
	builtin("blorp_test_task_join_slot_probe")


---
Test-only scheduler creation probe.

Checks that newly-created fibers start unparked and move to queued through the
created-fiber scheduling path, not through the parked wake path. Use this only
for deterministic scheduler runtime hardening tests.
---
func fiber_created_schedule_probe_for_test() -> Bool:
	builtin("blorp_test_fiber_created_schedule_probe")


---
Test-only scheduler timer probe.

Checks that runtime timer waiters are tied to an exact wait operation, so a
stale deadline cannot wake a later wait on the same fiber. Use this only for
deterministic runtime hardening tests.
---
func timer_waiter_identity_probe_for_test() -> Bool:
	builtin("blorp_test_timer_waiter_identity_probe")


---
Test-only scheduler wait-owner probe.

Checks that a runtime wait operation has a concrete owner and operation id
before it is marked ready to park, and that the ready-to-park transition
preserves that identity. Use this only for deterministic runtime hardening
tests.
---
func wait_ready_to_park_probe_for_test() -> Bool:
	builtin("blorp_test_wait_ready_to_park_probe")


---
Test-only scheduler lifecycle probe.

Checks that the runtime represents the ready-to-park state explicitly between
running and parked, including the wake-before-yield handoff that records a
pending wake before the fiber has actually yielded. Use this only for
deterministic scheduler runtime hardening tests.
---
func fiber_lifecycle_ready_to_park_probe_for_test() -> Bool:
	builtin("blorp_test_fiber_lifecycle_ready_to_park_probe")


---
Test-only scheduler cancellation-before-park probe.

Checks that cancellation delivered after a running fiber checks cancellation but
before it marks itself parked records a pending wake. Use this only for
deterministic scheduler runtime hardening tests.
---
func fiber_cancel_before_park_probe_for_test() -> Bool:
	builtin("blorp_test_fiber_cancel_before_park_probe")


---
Test-only scheduler timer-install probe.

Checks that a current fiber wait can install and remove its timer deadline
through the shared runtime helper without losing the wait operation identity.
Use this only for deterministic runtime hardening tests.
---
func current_timer_wait_install_probe_for_test() -> Bool:
	builtin("blorp_test_current_timer_wait_install_probe")


---
Test-only scheduler timeout arithmetic probe.

Checks that runtime timeout conversion and deadline helpers saturate instead
of overflowing. Use this only for deterministic runtime hardening tests.
---
func timeout_arithmetic_probe_for_test() -> Bool:
	builtin("blorp_test_timeout_arithmetic_probe")


---
Test-only cooperative checkpoint probe.

Runs the compiler-owned cooperative checkpoint helper and verifies that an
expired reduction budget yields from a fiber. Use this only for scheduler
runtime hardening tests; normal Blorp programs should use `yield_now()` for an
explicit source-level handoff.
---
func cooperative_checkpoint_probe_for_test() -> Bool:
	builtin("blorp_test_cooperative_checkpoint_probe")


---
Test-only TLS runtime state probe.

Exercises internal TLS session states without exposing a fake `TlsSession`
resource to user programs. Use this only for deterministic runtime hardening
tests around the portable TLS backend boundary.
---
func tls_state_probe_for_test() -> Bool:
	builtin("blorp_test_tls_state_probe")


---
Test-only WebSocket runtime state probe.

Exercises internal WebSocket session states without exposing a fake
`WebSocketSession` resource to user programs. Use this only for deterministic
runtime hardening tests around the portable WebSocket backend boundary.
---
func websocket_state_probe_for_test() -> Bool:
	builtin("blorp_test_websocket_state_probe")


---
Assert a value is True. Prints a message on failure.

doctests:
    :: True passes
    assert_true(True) == True
---
func assert_true(value: Bool) -> Bool:
	if value:
		True
	else:
		print("  assert_true failed: got False")
		False


---
Assert two floats are approximately equal within epsilon.

doctests:
    :: Close values pass
    assert_approx(1.0, 1.0000001, 0.001) == True
---
func assert_approx(actual: Float, expected: Float, epsilon: Float) -> Bool:
	diff: Float = actual - expected
	var abs_diff: Float = diff

	if abs_diff < 0.0:
		abs_diff = -abs_diff

	if abs_diff <= epsilon:
		True
	else:
		print(
			"  assert_approx failed: expected " + to_string(
				expected,
			) + " +/- " + epsilon.to_string() + ", got " + actual.to_string(),
		)
		False


---
Assert two values are equal. Prints expected vs actual on failure.
---
func assert_eq[T:Equatable+Stringable](actual: T, expected: T) -> Bool:
	if actual == expected:
		True
	else:
		print(
			"  assert_eq failed: expected " + expected.to_string() + ", got " + actual.to_string(),
		)
		False


---
Assert a value is False. Prints a message on failure.
---
func assert_false(value: Bool) -> Bool:
	if not value:
		True
	else:
		print("  assert_false failed: got True")
		False


---
Assert an Option is Some. Prints on failure.
---
func assert_some[T](value: Option[T]) -> Bool:
	match value:
		Some(_):
			True
		None:
			print("  assert_some failed: got None")
			False


---
Assert an Option is None. Prints on failure.
---
func assert_none[T](value: Option[T]) -> Bool:
	match value:
		None:
			True
		Some(_):
			print("  assert_none failed: got Some")
			False


---
Assert a Result is Ok. Prints on failure.
---
func assert_ok[T, E:Stringable](value: Result[T, E]) -> Bool:
	match value:
		Ok(_):
			True
		Err(e):
			print("  assert_ok failed: got Err(" + e.to_string() + ")")
			False


---
Assert a Result is Err. Prints on failure.
---
func assert_err[T, E](value: Result[T, E]) -> Bool:
	match value:
		Err(_):
			True
		Ok(_):
			print("  assert_err failed: got Ok")
			False


-- Run all tests in a test suite
func run_suite(suite: TestSuite) -> Bool:
	print("")
	print(">> " + suite.description + " Tests")
	var test_count: Int = suite.tests.length()
	var passed: Int = 0

	for test_pair in suite.tests:
		if test_pair[1]():
			print("  [PASS] " + test_pair[0])
			passed += 1
		else:
			print("  [FAIL] " + test_pair[0])

	print("")

	if passed == test_count:
		print("All " + test_count.to_string() + " tests passed")
		True
	else:
		print((test_count - passed).to_string() + " of " + test_count.to_string() + " tests failed")
		False


func run_suite_leak_check(suite: TestSuite) -> Bool:
	print("")
	print(">> " + suite.description + " Tests (leak-check)")
	var test_count: Int = suite.tests.length()
	var passed: Int = 0
	var leaked_tests: Int = 0

	for test_pair in suite.tests:
		-- Reset stats before each test, run, then check
		reset_mem_stats()
		result: Bool = test_pair[1]()
		stats: MemStats = get_mem_stats()
		objects_after: Int = stats.current_objects

		-- get_mem_stats() is untracked, so any live object after a test is signal.
		has_leak: Bool = objects_after > 0

		if result:
			if has_leak:
				print(
					"  [FAIL] " + test_pair[0] + " [LEAK: " + to_string(
						objects_after,
					) + " objects]",
				)
				print_live_object_summary()
				leaked_tests += 1
			else:
				print("  [PASS] " + test_pair[0])
				passed += 1
		else if has_leak:
			print("  [FAIL] " + test_pair[0] + " [LEAK: " + objects_after.to_string() + " objects]")
			print_live_object_summary()
			leaked_tests += 1
		else:
			print("  [FAIL] " + test_pair[0])

	print("")

	if leaked_tests > 0:
		print("ERROR: " + leaked_tests.to_string() + " test(s) leaked memory")

	suite_ok: Bool = passed == test_count and leaked_tests == 0

	if suite_ok:
		print("All " + test_count.to_string() + " tests passed")
	else:
		print((test_count - passed).to_string() + " of " + test_count.to_string() + " tests failed")

	reset_mem_stats()
	suite_ok
