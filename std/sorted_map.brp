-- SortedMap - Sorted key-value map backed by a sorted list
--
-- A map where keys are kept in sorted order. All operations maintain
-- sorted key order. Supports O(n) insert/lookup and O(1) min/max access.
-- Wrapped in an opaque type for type safety and to protect the sorted-list
-- invariant from direct construction.
--
-- Comparison with Dict:
-- Dict: O(1) average lookup/insert, insertion-ordered iteration, keys need Hashable
-- SortedMap: O(n) lookup/insert, key-sorted iteration, keys need Orderable
-- Use Dict when you need fast lookup and don't care about key order.
-- Use SortedMap when you need sorted iteration, min/max, or range queries.
opaque type SortedMap[K, V] = List[(K, V)]


-- ============================================================================
-- Construction
-- ============================================================================
---
Create an empty sorted map.

doctests:
    :: Map is empty after removing its only entry
    sm = sorted_map()
        .set(1, 10)
        .remove(1)
    sm.is_empty() == True
---
pure func sorted_map[K, V]() -> SortedMap[K, V]:
	from_pairs([])


-- ============================================================================
-- Core Operations
-- ============================================================================
---
Insert a key-value pair. If key exists, updates the value.
Returns a new sorted map. O(n).

doctests:
    :: Insert increases size
    sm = sorted_map().set(1, 10)
    sm.map_length() == 1
---
pure func set[K:Orderable+Equatable, V](sm: SortedMap[K, V], key: K, val: V) -> SortedMap[K, V]:
	data: List[(K, V)] = sorted_map_pairs(sm)
	from_pairs(insert_sorted(data, key, val, 0))


---
Get the value for a key. O(n).

doctests:
    :: Get existing key
    sm = sorted_map().set(1, 10)

    match sm.get(1):
        Some(v):
            v == 10
        None:
            False
---
pure func get[K:Orderable+Equatable, V](sm: SortedMap[K, V], key: K) -> Option[V]:
	find_key(sorted_map_pairs(sm), key, 0)


---
Check if a key exists in the map. O(n).

doctests:
    :: Contains after insert
    sm = sorted_map().set(1, 10)
    sm.has_key(1) == True
---
pure func has_key[K:Orderable+Equatable, V](sm: SortedMap[K, V], key: K) -> Bool:
	match sm.get(key):
		Some(_):
			True
		None:
			False


---
Remove a key from the map. O(n).
Returns the new map (unchanged if key not found).

doctests:
    :: Remove existing key
    var sm = sorted_map()
    sm = sm.set(1, 10)
    sm = sm.remove(1)
    sm.map_length() == 0
---
pure func remove[K:Orderable+Equatable, V](sm: SortedMap[K, V], key: K) -> SortedMap[K, V]:
	data: List[(K, V)] = sorted_map_pairs(sm)
	from_pairs(remove_key(data, key, 0))


---
Get the minimum key-value pair. O(1).

doctests:
    :: Min returns smallest key
    var sm = sorted_map()
    sm = sm.set(3, 30)
    sm = sm.set(1, 10)

    match sm.min():
        Some(pair):
            pair[0] == 1 and pair[1] == 10
        None:
            False
---
pure func min[K, V](sm: SortedMap[K, V]) -> Option[(K, V)]:
	data: List[(K, V)] = sorted_map_pairs(sm)

	if data.length() == 0:
		r: Option[(K, V)] = None
		r
	else:
		data.get(0)


---
Get the maximum key-value pair. O(1).

doctests:
    :: Max returns largest key
    var sm = sorted_map()
    sm = sm.set(1, 10)
    sm = sm.set(3, 30)

    match sm.max():
        Some(pair):
            pair[0] == 3 and pair[1] == 30
        None:
            False
---
pure func max[K, V](sm: SortedMap[K, V]) -> Option[(K, V)]:
	data: List[(K, V)] = sorted_map_pairs(sm)

	if data.length() == 0:
		r: Option[(K, V)] = None
		r
	else:
		data.get(data.length() - 1)


---
Get all key-value pairs with keys in range [lo, hi] inclusive. O(n).

doctests:
    :: Range query
    var sm = sorted_map()
    sm = sm.set(1, 10)
    sm = sm.set(2, 20)
    sm = sm.set(3, 30)
    sm
        .range(1, 2)
        .length() == 2
---
pure func range[K:Orderable, V](sm: SortedMap[K, V], lo: K, hi: K) -> List[(K, V)]:
	collect_range(sorted_map_pairs(sm), lo, hi, 0)


---
Get all keys in sorted order. O(n).
---
pure func keys[K, V](sm: SortedMap[K, V]) -> List[K]:
	extract_keys(sorted_map_pairs(sm), 0)


---
Get all values in key-sorted order. O(n).
---
pure func values[K, V](sm: SortedMap[K, V]) -> List[V]:
	extract_values(sorted_map_pairs(sm), 0)


---
Convert to a list of (key, value) pairs in sorted order. O(n).
---
pure func to_list[K, V](sm: SortedMap[K, V]) -> List[(K, V)]:
	sorted_map_pairs(sm)


---
Create a sorted map from a list of (key, value) pairs. O(n^2).
---
pure func from_list[K:Orderable+Equatable, V](pairs: List[(K, V)]) -> SortedMap[K, V]:
	var result: SortedMap[K, V] = sorted_map()

	for pair in pairs:
		result = result.set(pair[0], pair[1])

	result


---
Get the number of entries. O(1).
---
pure func map_length[K, V](sm: SortedMap[K, V]) -> Int:
	sorted_map_pairs(sm).length()


---
Check if the map is empty. O(1).
---
pure func is_empty[K, V](sm: SortedMap[K, V]) -> Bool:
	sorted_map_pairs(sm).length() == 0


-- ============================================================================
-- Internal Helpers
-- ============================================================================
private pure func from_pairs[K, V](pairs: List[(K, V)]) -> SortedMap[K, V]:
	into SortedMap[K, V](pairs)


private pure func sorted_map_pairs[K, V](sm: SortedMap[K, V]) -> List[(K, V)]:
	from SortedMap[K, V](sm)


-- Insert in sorted position, replacing if key exists
private pure func insert_sorted[K:Orderable+Equatable, V](
	data: List[(K, V)],
	key: K,
	val: V,
	i: Int,
) -> List[(K, V)]:
	var idx: Int = i
	var result: List[(K, V)] = data
	var done: Bool = False

	while idx < data.length() and not done:
		match data.get(idx):
			Some(pair):
				if pair[0] == key:
					result = list_set_pair(data, idx, (key, val))
					done = True
				else if key < pair[0]:
					result = list_insert_pair(data, idx, (key, val))
					done = True
				else:
					idx += 1
			None:
				done = True

	if not done:
		result = result.append((key, val))

	result


-- Find key and return value
private pure func find_key[K:Orderable+Equatable, V](
	data: List[(K, V)],
	key: K,
	i: Int,
) -> Option[V]:
	var idx: Int = i
	var result: Option[V] = None
	var done: Bool = False

	while idx < data.length() and not done:
		match data.get(idx):
			Some(pair):
				if pair[0] == key:
					result = Some(pair[1])
					done = True
				else if pair[0] > key:
					done = True
				else:
					idx += 1
			None:
				done = True

	result


-- Remove key from sorted list
private pure func remove_key[K:Orderable+Equatable, V](
	data: List[(K, V)],
	key: K,
	i: Int,
) -> List[(K, V)]:
	var idx: Int = i
	var result: List[(K, V)] = data
	var done: Bool = False

	while idx < data.length() and not done:
		match data.get(idx):
			Some(pair):
				if pair[0] == key:
					result = list_remove_at(data, idx)
					done = True
				else if pair[0] > key:
					done = True
				else:
					idx += 1
			None:
				done = True

	result


-- Collect pairs in [lo, hi] range
private pure func collect_range[K:Orderable, V](
	data: List[(K, V)],
	lo: K,
	hi: K,
	i: Int,
) -> List[(K, V)]:
	var result: List[(K, V)] = []
	var idx: Int = i

	while idx < data.length():
		match data.get(idx):
			Some(pair):
				if pair[0] > hi:
					idx = data.length()
				else if pair[0] >= lo:
					result = result.append(pair)
			None:
				void

		idx += 1

	result


-- Extract all keys
private pure func extract_keys[K, V](data: List[(K, V)], i: Int) -> List[K]:
	data
		.drop(i)
		.map(func(pair: (K, V)): pair[0])


-- Extract all values
private pure func extract_values[K, V](data: List[(K, V)], i: Int) -> List[V]:
	data
		.drop(i)
		.map(func(pair: (K, V)): pair[1])


-- Set pair at index (returns new list)
private pure func list_set_pair[K, V](data: List[(K, V)], idx: Int, pair: (K, V)) -> List[(K, V)]:
	var result: List[(K, V)] = []
	var i: Int = 0

	while i < data.length():
		if i == idx:
			result = result.append(pair)
		else:
			match data.get(i):
				Some(p):
					result = result.append(p)
				None:
					void

		i += 1

	result


-- Insert pair at index (shifts elements right)
private pure func list_insert_pair[K, V](
	data: List[(K, V)],
	idx: Int,
	pair: (K, V),
) -> List[(K, V)]:
	var result: List[(K, V)] = []
	var i: Int = 0

	while i < data.length():
		if i == idx:
			result = result.append(pair)

		match data.get(i):
			Some(p):
				result = result.append(p)
			None:
				void

		i += 1

	result


-- Remove element at index
private pure func list_remove_at[K, V](data: List[(K, V)], idx: Int) -> List[(K, V)]:
	var result: List[(K, V)] = []
	var i: Int = 0

	while i < data.length():
		if i != idx:
			match data.get(i):
				Some(p):
					result = result.append(p)
				None:
					void

		i += 1

	result
