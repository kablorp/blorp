-- Terminal — Terminal formatting (ANSI colors, styles, tables)
--
-- Pure functions for building ANSI-colored strings.
-- All functions return decorated strings — they don't print directly.
--
-- Typical use: import the formatting functions you need from `terminal`.
-- print(bold("Title") + ": " + green("OK"))
import:
	string: string


-- ============================================================================
-- ANSI Escape Codes
-- ============================================================================
private ANSI_ESCAPE_PREFIX: String = "\u{1B}["

private ANSI_SGR_SUFFIX: String = "m"

private ANSI_PARAM_SEPARATOR: String = ";"

private ANSI_RESET_ALL: String = "0"

private ANSI_RESET_INTENSITY: String = "22"

private ANSI_RESET_ITALIC: String = "23"

private ANSI_RESET_UNDERLINE: String = "24"

private ANSI_RESET_STRIKETHROUGH: String = "29"

private ANSI_RESET_FOREGROUND: String = "39"

private ANSI_RESET_BACKGROUND: String = "49"

private ANSI_STYLE_BOLD: String = "1"

private ANSI_STYLE_DIM: String = "2"

private ANSI_STYLE_ITALIC: String = "3"

private ANSI_STYLE_UNDERLINE: String = "4"

private ANSI_STYLE_STRIKETHROUGH: String = "9"

private ANSI_FOREGROUND_RED: String = "31"

private ANSI_FOREGROUND_GREEN: String = "32"

private ANSI_FOREGROUND_YELLOW: String = "33"

private ANSI_FOREGROUND_BLUE: String = "34"

private ANSI_FOREGROUND_MAGENTA: String = "35"

private ANSI_FOREGROUND_CYAN: String = "36"

private ANSI_FOREGROUND_WHITE: String = "37"

private ANSI_FOREGROUND_GRAY: String = "90"

private ANSI_FOREGROUND_BRIGHT_RED: String = "91"

private ANSI_FOREGROUND_BRIGHT_GREEN: String = "92"

private ANSI_FOREGROUND_BRIGHT_YELLOW: String = "93"

private ANSI_FOREGROUND_BRIGHT_BLUE: String = "94"

private ANSI_FOREGROUND_BRIGHT_MAGENTA: String = "95"

private ANSI_FOREGROUND_BRIGHT_CYAN: String = "96"

private ANSI_BACKGROUND_RED: String = "41"

private ANSI_BACKGROUND_GREEN: String = "42"

private ANSI_BACKGROUND_YELLOW: String = "43"

private ANSI_BACKGROUND_BLUE: String = "44"

private ANSI_BACKGROUND_MAGENTA: String = "45"

private ANSI_BACKGROUND_CYAN: String = "46"

private ANSI_BACKGROUND_WHITE: String = "47"

private ANSI_FOREGROUND_256_PREFIX: String = "38;5;"

private ANSI_BACKGROUND_256_PREFIX: String = "48;5;"

private ANSI_FOREGROUND_RGB_PREFIX: String = "38;2;"

private ANSI_BACKGROUND_RGB_PREFIX: String = "48;2;"

private ANSI_COLOR_COMPONENT_MIN: Int = 0

private ANSI_COLOR_COMPONENT_MAX: Int = 255


private pure func esc(code: String) -> String:
	ANSI_ESCAPE_PREFIX + code + ANSI_SGR_SUFFIX


private pure func ansi_wrap(code: String, s: String, reset: String) -> String:
	esc(code) + s + esc(reset)


private pure func ansi_color_component(n: Int) -> Int:
	if n < ANSI_COLOR_COMPONENT_MIN:
		ANSI_COLOR_COMPONENT_MIN
	else if n > ANSI_COLOR_COMPONENT_MAX:
		ANSI_COLOR_COMPONENT_MAX
	else:
		n


-- ============================================================================
-- Styles
-- ============================================================================
---
Make text bold.

doctests:
    :: Bold wraps with codes
    bold("hi").length() > 2
---
pure func bold(s: String) -> String:
	ansi_wrap(ANSI_STYLE_BOLD, s, ANSI_RESET_INTENSITY)


---
Make text dim.
---
pure func dim(s: String) -> String:
	ansi_wrap(ANSI_STYLE_DIM, s, ANSI_RESET_INTENSITY)


---
Make text italic.
---
pure func italic(s: String) -> String:
	ansi_wrap(ANSI_STYLE_ITALIC, s, ANSI_RESET_ITALIC)


---
Make text underlined.
---
pure func underline(s: String) -> String:
	ansi_wrap(ANSI_STYLE_UNDERLINE, s, ANSI_RESET_UNDERLINE)


---
Make text strikethrough.
---
pure func strikethrough(s: String) -> String:
	ansi_wrap(ANSI_STYLE_STRIKETHROUGH, s, ANSI_RESET_STRIKETHROUGH)


-- ============================================================================
-- Foreground Colors
-- ============================================================================
---
Color text red.

doctests:
    :: Red wraps with codes
    red("hi").length() > 2
---
pure func red(s: String) -> String:
	ansi_wrap(ANSI_FOREGROUND_RED, s, ANSI_RESET_FOREGROUND)


---
Color text green.
---
pure func green(s: String) -> String:
	ansi_wrap(ANSI_FOREGROUND_GREEN, s, ANSI_RESET_FOREGROUND)


---
Color text yellow.
---
pure func yellow(s: String) -> String:
	ansi_wrap(ANSI_FOREGROUND_YELLOW, s, ANSI_RESET_FOREGROUND)


---
Color text blue.
---
pure func blue(s: String) -> String:
	ansi_wrap(ANSI_FOREGROUND_BLUE, s, ANSI_RESET_FOREGROUND)


---
Color text magenta.
---
pure func magenta(s: String) -> String:
	ansi_wrap(ANSI_FOREGROUND_MAGENTA, s, ANSI_RESET_FOREGROUND)


---
Color text cyan.
---
pure func cyan(s: String) -> String:
	ansi_wrap(ANSI_FOREGROUND_CYAN, s, ANSI_RESET_FOREGROUND)


---
Color text white.
---
pure func white(s: String) -> String:
	ansi_wrap(ANSI_FOREGROUND_WHITE, s, ANSI_RESET_FOREGROUND)


---
Color text gray (bright black).
---
pure func gray(s: String) -> String:
	ansi_wrap(ANSI_FOREGROUND_GRAY, s, ANSI_RESET_FOREGROUND)


-- ============================================================================
-- Bright Foreground Colors
-- ============================================================================
pure func bright_red(s: String) -> String:
	ansi_wrap(ANSI_FOREGROUND_BRIGHT_RED, s, ANSI_RESET_FOREGROUND)


pure func bright_green(s: String) -> String:
	ansi_wrap(ANSI_FOREGROUND_BRIGHT_GREEN, s, ANSI_RESET_FOREGROUND)


pure func bright_yellow(s: String) -> String:
	ansi_wrap(ANSI_FOREGROUND_BRIGHT_YELLOW, s, ANSI_RESET_FOREGROUND)


pure func bright_blue(s: String) -> String:
	ansi_wrap(ANSI_FOREGROUND_BRIGHT_BLUE, s, ANSI_RESET_FOREGROUND)


pure func bright_magenta(s: String) -> String:
	ansi_wrap(ANSI_FOREGROUND_BRIGHT_MAGENTA, s, ANSI_RESET_FOREGROUND)


pure func bright_cyan(s: String) -> String:
	ansi_wrap(ANSI_FOREGROUND_BRIGHT_CYAN, s, ANSI_RESET_FOREGROUND)


-- ============================================================================
-- Background Colors
-- ============================================================================
pure func bg_red(s: String) -> String:
	ansi_wrap(ANSI_BACKGROUND_RED, s, ANSI_RESET_BACKGROUND)


pure func bg_green(s: String) -> String:
	ansi_wrap(ANSI_BACKGROUND_GREEN, s, ANSI_RESET_BACKGROUND)


pure func bg_yellow(s: String) -> String:
	ansi_wrap(ANSI_BACKGROUND_YELLOW, s, ANSI_RESET_BACKGROUND)


pure func bg_blue(s: String) -> String:
	ansi_wrap(ANSI_BACKGROUND_BLUE, s, ANSI_RESET_BACKGROUND)


pure func bg_magenta(s: String) -> String:
	ansi_wrap(ANSI_BACKGROUND_MAGENTA, s, ANSI_RESET_BACKGROUND)


pure func bg_cyan(s: String) -> String:
	ansi_wrap(ANSI_BACKGROUND_CYAN, s, ANSI_RESET_BACKGROUND)


pure func bg_white(s: String) -> String:
	ansi_wrap(ANSI_BACKGROUND_WHITE, s, ANSI_RESET_BACKGROUND)


-- ============================================================================
-- 256-Color and RGB
-- ============================================================================
---
Color text with a 256-color palette index. Values outside 0-255 are clamped.
---
pure func color256(s: String, n: Int) -> String:
	index: Int = ansi_color_component(n)
	esc(ANSI_FOREGROUND_256_PREFIX + index.to_string()) + s + esc(ANSI_RESET_FOREGROUND)


---
Color background with a 256-color palette index. Values outside 0-255 are clamped.
---
pure func bg_color256(s: String, n: Int) -> String:
	index: Int = ansi_color_component(n)
	esc(ANSI_BACKGROUND_256_PREFIX + index.to_string()) + s + esc(ANSI_RESET_BACKGROUND)


---
Color text with an RGB value. Each channel is clamped to 0-255.
---
pure func rgb(s: String, r: Int, g: Int, b: Int) -> String:
	rr: Int = ansi_color_component(r)
	gg: Int = ansi_color_component(g)
	bb: Int = ansi_color_component(b)
	esc(
		ANSI_FOREGROUND_RGB_PREFIX + rr.to_string() + ANSI_PARAM_SEPARATOR + gg.to_string() + ANSI_PARAM_SEPARATOR + bb.to_string(),
	) + s + esc(ANSI_RESET_FOREGROUND)


---
Color background with an RGB value. Each channel is clamped to 0-255.
---
pure func bg_rgb(s: String, r: Int, g: Int, b: Int) -> String:
	rr: Int = ansi_color_component(r)
	gg: Int = ansi_color_component(g)
	bb: Int = ansi_color_component(b)
	esc(
		ANSI_BACKGROUND_RGB_PREFIX + rr.to_string() + ANSI_PARAM_SEPARATOR + gg.to_string() + ANSI_PARAM_SEPARATOR + bb.to_string(),
	) + s + esc(ANSI_RESET_BACKGROUND)


-- ============================================================================
-- Reset
-- ============================================================================
-- Strip all ANSI formatting.
RESET: String = "\u{1B}[0m"


-- ============================================================================
-- Composition Helpers
-- ============================================================================
---
Apply multiple styles to a string. Innermost style wins for conflicts.

doctests:
    :: Compose bold and red
    s: String = bold(red("error"))
    s.length() > 5
---
pure func styled(
	s: String,
	styles: List[pure (String) -> String],
) -> String:
	var result: String = s
	var i: Int = styles.length() - 1
	while i >= 0:
		match styles.get(i):
			Some(f): result = f(result)
			None: void
		i -= 1
	result


-- ============================================================================
-- Table Formatting
-- ============================================================================
---
Format a simple text table with headers and rows.
Columns are auto-sized to fit content.

doctests:
    :: Table has header
    t: String = table(
        ["Name", "Age"],
        [["Alice", "30"], ["Bob", "25"]],
    )
    t.length() > 10
---
pure func table(headers: List[String], rows: List[List[String]]) -> String:
	-- Compute column widths
	num_cols: Int = headers.length()
	var widths: List[Int] = []
	var c: Int = 0
	while c < num_cols:
		var w: Int = match headers.get(c):
			Some(h): h.length()
			None: 0
		var r: Int = 0
		while r < rows.length():
			match rows.get(r):
				Some(row):
					match row.get(c):
						Some(cell):
							cell_len: Int = cell.length()
							if cell_len > w:
								w = cell_len
						None: void
				None: void
			r += 1
		widths = widths.append(w)
		c += 1

	-- Build table
	var buf: String = string(256)

	-- Header
	buf = buf.append_str(format_row(headers, widths))
	buf = buf.append_char('\n')

	-- Separator
	buf = buf.append_str(format_separator(widths))
	buf = buf.append_char('\n')

	-- Rows
	var r: Int = 0
	while r < rows.length():
		match rows.get(r):
			Some(row):
				buf = buf.append_str(format_row(row, widths))
				if r < rows.length() - 1:
					buf = buf.append_char('\n')
			None: void
		r += 1
	buf


private pure func format_row(cells: List[String], widths: List[Int]) -> String:
	var buf: String = string(64)
	var c: Int = 0
	while c < widths.length():
		if c > 0:
			buf = buf.append_str("  ")
		cell: String = cells
			.get(c)
			.get_or("")
		w: Int = widths
			.get(c)
			.get_or(0)
		buf = buf.append_str(cell.pad_right(w))
		c += 1
	buf


private pure func format_separator(widths: List[Int]) -> String:
	var buf: String = string(64)
	var c: Int = 0
	while c < widths.length():
		if c > 0:
			buf = buf.append_str("  ")
		w: Int = widths
			.get(c)
			.get_or(0)
		var i: Int = 0
		while i < w:
			buf = buf.append_char('-')
			i += 1
		c += 1
	buf


---
Pad a string on the right with spaces to reach the target width.
---
pure func pad_right(s: String, width: Int) -> String:
	padding: Int = width - s.length()
	if padding <= 0:
		s
	else:
		var buf: String = string(width).append_str(s)
		var i: Int = 0
		while i < padding:
			buf = buf.append_char(' ')
			i += 1
		buf


---
Pad a string on the left with spaces to reach the target width.
---
pure func pad_left(s: String, width: Int) -> String:
	padding: Int = width - s.length()
	if padding <= 0:
		s
	else:
		var buf: String = string(width)
		var i: Int = 0
		while i < padding:
			buf = buf.append_char(' ')
			i += 1
		buf.append_str(s)


-- ============================================================================
-- Progress Bar
-- ============================================================================
---
Render a progress bar string.
`current` is the current progress, `total` is the maximum.
`width` is the bar width in characters.

doctests:
    :: Half progress
    bar: String = progress_bar(50, 100, 20)
    bar.length() > 0
---
pure func progress_bar(current: Int, total: Int, width: Int) -> String:
	fraction: Float = if total == 0:
		0.0
	else:
		to_float(current) / to_float(total)
	filled: Int = to_int(fraction * to_float(width))
	var buf: String = string(width + 20)
	buf = buf.append_char('[')
	var i: Int = 0
	while i < width:
		if i < filled:
			buf = buf.append_char('#')
		else:
			buf = buf.append_char('-')
		i += 1
	buf = buf.append_str("] ")
	pct: Int = to_int(fraction * 100.0)
	buf = buf.append_str(pct.to_string())
	buf.append_char('%')
