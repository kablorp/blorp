-- Deque - Double-ended queue
--
-- A double-ended queue backed by two lists (front and back).
-- Supports O(1) amortized push/pop from both ends.
-- Represented as (front_list, back_list) tuple.
-- ============================================================================
-- Construction
-- ============================================================================
---
Create an empty deque.
Returns a pair of (front, back) lists.

doctests:
    :: New deque is empty
    d: (List[Int], List[Int]) = deque()
    d.is_empty() == True
---
pure func deque[T]() -> (List[T], List[T]):
	front: List[T] = []
	back: List[T] = []
	(front, back)


-- ============================================================================
-- Core Operations
-- ============================================================================
---
Push a value to the front of the deque.

doctests:
    :: Push front adds to front
    var d: (List[Int], List[Int]) = deque()
    d = d.push_front(1)
    d.to_list().length() == 1
---
pure func push_front[T](self: (List[T], List[T]), val: T) -> (List[T], List[T]):
	front: List[T] = self.0
	new_front: List[T] = front.prepend(val)
	(new_front, self.1)


---
Push a value to the back of the deque.

doctests:
    :: Push back adds to back
    var d: (List[Int], List[Int]) = deque()
    d = d.push_back(1)
    d.to_list().length() == 1
---
pure func push_back[T](self: (List[T], List[T]), val: T) -> (List[T], List[T]):
	back: List[T] = self.1
	new_back: List[T] = back.prepend(val)
	(self.0, new_back)


---
Pop a value from the front of the deque.
Returns None if empty, Some((value, new_deque)) otherwise.

doctests:
    :: Pop front returns first pushed
    var d: (List[Int], List[Int]) = deque()
    d = d.push_front(1)
    d = d.push_front(2)
    match d.pop_front():
        Some(pair): pair.0 == 2
        None: False
---
func pop_front[T](self: (List[T], List[T])) -> Option[(T, (List[T], List[T]))]:
	front: List[T] = self.0
	back: List[T] = self.1
	none: Option[(T, (List[T], List[T]))] = None
	if list_len(front) > 0:
		match front.get(0):
			Some(val):
				rest: List[T] = list_tail(front)
				Some((val, (rest, back)))
			None:
				none
	else if list_len(back) == 0:
		none
	else:
		-- Reverse back to become front
		reversed: List[T] = list_reverse(back)
		match reversed.get(0):
			Some(val):
				rest: List[T] = list_tail(reversed)
				empty_back: List[T] = []
				Some((val, (rest, empty_back)))
			None:
				none


---
Pop a value from the back of the deque.
Returns None if empty, Some((value, new_deque)) otherwise.

doctests:
    :: Pop back returns last pushed
    var d: (List[Int], List[Int]) = deque()
    d = d.push_back(1)
    d = d.push_back(2)
    match d.pop_back():
        Some(pair): pair.0 == 2
        None: False
---
func pop_back[T](self: (List[T], List[T])) -> Option[(T, (List[T], List[T]))]:
	front: List[T] = self.0
	back: List[T] = self.1
	none: Option[(T, (List[T], List[T]))] = None
	if list_len(back) > 0:
		match back.get(0):
			Some(val):
				rest: List[T] = list_tail(back)
				Some((val, (front, rest)))
			None:
				none
	else if list_len(front) == 0:
		none
	else:
		-- Reverse front to become back
		reversed: List[T] = list_reverse(front)
		match reversed.get(0):
			Some(val):
				rest: List[T] = list_tail(reversed)
				empty_front: List[T] = []
				Some((val, (empty_front, rest)))
			None:
				none


---
Peek at the front element without removing.
---
pure func peek_front[T](self: (List[T], List[T])) -> Option[T]:
	front: List[T] = self.0
	back: List[T] = self.1
	if list_len(front) > 0:
		front.get(0)
	else if list_len(back) == 0:
		None
	else:
		back.get(list_len(back) - 1)


-- Last element of back is front
---
Peek at the back element without removing.
---
pure func peek_back[T](self: (List[T], List[T])) -> Option[T]:
	front: List[T] = self.0
	back: List[T] = self.1
	if list_len(back) > 0:
		back.get(0)
	else if list_len(front) == 0:
		None
	else:
		front.get(list_len(front) - 1)


-- Last element of front is back
---
Check if the deque is empty.
---
pure func is_empty[T](self: (List[T], List[T])) -> Bool:
	list_len(self.0) == 0 and list_len(self.1) == 0


-- Count elements in a list without calling length (avoids shadowing by deque's length)
private pure func list_len[T](lst: List[T]) -> Int:
	var n: Int = 0
	for _ in lst:
		n += 1
	n


---
Get the total number of elements.
---
pure func length[T](self: (List[T], List[T])) -> Int:
	list_len(self.0) + list_len(self.1)


---
Convert deque to a list (front to back order).
---
pure func to_list[T](self: (List[T], List[T])) -> List[T]:
	front: List[T] = self.0
	back: List[T] = self.1
	reversed_back: List[T] = list_reverse(back)
	front.concat(reversed_back)


-- ============================================================================
-- Internal Helpers
-- ============================================================================
-- Prepend element to list (add at front)
private pure func prepend[T](lst: List[T], val: T) -> List[T]:
	var result: List[T] = [val]
	var i: Int = 0
	while i < list_len(lst):
		match lst.get(i):
			Some(v):
				result = result.append(v)
			None: void
		i += 1
	result


-- Reverse a list
private pure func list_reverse[T](lst: List[T]) -> List[T]:
	var result: List[T] = []
	var i: Int = list_len(lst) - 1
	while i >= 0:
		match lst.get(i):
			Some(v):
				result = result.append(v)
			None: void
		i -= 1
	result


-- Get tail of list (everything except first element)
private pure func list_tail[T](lst: List[T]) -> List[T]:
	var result: List[T] = []
	var i: Int = 1
	while i < list_len(lst):
		match lst.get(i):
			Some(v):
				result = result.append(v)
			None: void
		i += 1
	result
