-- Deque - Double-ended queue
--
-- A double-ended queue backed by two lists (front and back).
-- Supports O(1) amortized push/pop from both ends.
-- The two-list representation is private to this module.
-- ============================================================================
opaque type Deque[T] = (List[T], List[T])


-- Construction
-- ============================================================================
---
Create an empty deque.

doctests:
    :: New deque is empty
    d = deque()
    filled = d.push_back(1)
    d.is_empty() == True and filled
        .to_list()
        .length() == 1
---
pure func deque[T]() -> Deque[T]:
	front: List[T] = []
	back: List[T] = []
	from_parts(front, back)


-- ============================================================================
-- Core Operations
-- ============================================================================
---
Push a value to the front of the deque.

doctests:
    :: Push front adds to front
    var d = deque()
    d = d.push_front(1)
    d
        .to_list()
        .length() == 1
---
pure func push_front[T](self: Deque[T], val: T) -> Deque[T]:
	parts: (List[T], List[T]) = deque_parts(self)
	front: List[T] = parts[0]
	new_front: List[T] = front.prepend(val)
	from_parts(new_front, parts[1])


---
Push a value to the back of the deque.

doctests:
    :: Push back adds to back
    var d = deque()
    d = d.push_back(1)
    d
        .to_list()
        .length() == 1
---
pure func push_back[T](self: Deque[T], val: T) -> Deque[T]:
	parts: (List[T], List[T]) = deque_parts(self)
	back: List[T] = parts[1]
	new_back: List[T] = back.prepend(val)
	from_parts(parts[0], new_back)


---
Pop a value from the front of the deque.
Returns None if empty, Some((value, new_deque)) otherwise.

doctests:
    :: Pop front returns first pushed
    var d = deque()
    d = d.push_front(1)
    d = d.push_front(2)

    match d.pop_front():
        Some(pair):
            pair[0] == 2
        None:
            False
---
func pop_front[T](self: Deque[T]) -> Option[(T, Deque[T])]:
	parts: (List[T], List[T]) = deque_parts(self)
	front: List[T] = parts[0]
	back: List[T] = parts[1]
	none: Option[(T, Deque[T])] = None

	if list_len(front) > 0:
		val ?= front.get(0)
		rest: List[T] = list_tail(front)
		Some((val, from_parts(rest, back)))
	else if list_len(back) == 0:
		none
	else:
		-- Reverse back to become front
		reversed: List[T] = list_reverse(back)
		val ?= reversed.get(0)
		rest: List[T] = list_tail(reversed)
		empty_back: List[T] = []
		Some((val, from_parts(rest, empty_back)))


---
Pop a value from the back of the deque.
Returns None if empty, Some((value, new_deque)) otherwise.

doctests:
    :: Pop back returns last pushed
    var d = deque()
    d = d.push_back(1)
    d = d.push_back(2)

    match d.pop_back():
        Some(pair):
            pair[0] == 2
        None:
            False
---
func pop_back[T](self: Deque[T]) -> Option[(T, Deque[T])]:
	parts: (List[T], List[T]) = deque_parts(self)
	front: List[T] = parts[0]
	back: List[T] = parts[1]
	none: Option[(T, Deque[T])] = None

	if list_len(back) > 0:
		val ?= back.get(0)
		rest: List[T] = list_tail(back)
		Some((val, from_parts(front, rest)))
	else if list_len(front) == 0:
		none
	else:
		-- Reverse front to become back
		reversed: List[T] = list_reverse(front)
		val ?= reversed.get(0)
		rest: List[T] = list_tail(reversed)
		empty_front: List[T] = []
		Some((val, from_parts(empty_front, rest)))


---
Peek at the front element without removing.
---
pure func peek_front[T](self: Deque[T]) -> Option[T]:
	parts: (List[T], List[T]) = deque_parts(self)
	front: List[T] = parts[0]
	back: List[T] = parts[1]

	if list_len(front) > 0:
		front.get(0)
	else if list_len(back) == 0:
		None
	else:
		back.get(list_len(back) - 1)


-- Last element of back is front
---
Peek at the back element without removing.
---
pure func peek_back[T](self: Deque[T]) -> Option[T]:
	parts: (List[T], List[T]) = deque_parts(self)
	front: List[T] = parts[0]
	back: List[T] = parts[1]

	if list_len(back) > 0:
		back.get(0)
	else if list_len(front) == 0:
		None
	else:
		front.get(list_len(front) - 1)


-- Last element of front is back
---
Check if the deque is empty.
---
pure func is_empty[T](self: Deque[T]) -> Bool:
	parts: (List[T], List[T]) = deque_parts(self)
	list_len(parts[0]) == 0 and list_len(parts[1]) == 0


-- Count elements in a list without calling length (avoids shadowing by deque's length)
private pure func list_len[T](lst: List[T]) -> Int:
	var n: Int = 0

	for _ in lst:
		n += 1

	n


---
Get the total number of elements.
---
pure func length[T](self: Deque[T]) -> Int:
	parts: (List[T], List[T]) = deque_parts(self)
	list_len(parts[0]) + list_len(parts[1])


---
Convert deque to a list (front to back order).
---
pure func to_list[T](self: Deque[T]) -> List[T]:
	parts: (List[T], List[T]) = deque_parts(self)
	front: List[T] = parts[0]
	back: List[T] = parts[1]
	reversed_back: List[T] = list_reverse(back)
	front.concat(reversed_back)


-- ============================================================================
-- Internal Helpers
-- ============================================================================
private pure func from_parts[T](front: List[T], back: List[T]) -> Deque[T]:
	into Deque[T]((front, back))


private pure func deque_parts[T](self: Deque[T]) -> (List[T], List[T]):
	from Deque[T](self)


-- Prepend element to list (add at front)
private pure func prepend[T](lst: List[T], val: T) -> List[T]:
	var result: List[T] = [val]
	var i: Int = 0

	while i < list_len(lst):
		match lst.get(i):
			Some(v):
				result = result.append(v)
			None:
				void

		i += 1

	result


-- Reverse a list
private pure func list_reverse[T](lst: List[T]) -> List[T]:
	var result: List[T] = []
	var i: Int = list_len(lst) - 1

	while i >= 0:
		match lst.get(i):
			Some(v):
				result = result.append(v)
			None:
				void

		i -= 1

	result


-- Get tail of list (everything except first element)
private pure func list_tail[T](lst: List[T]) -> List[T]:
	var result: List[T] = []
	var i: Int = 1

	while i < list_len(lst):
		match lst.get(i):
			Some(v):
				result = result.append(v)
			None:
				void

		i += 1

	result
