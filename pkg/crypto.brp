-- Crypto - Authenticated encryption and key derivation
--
-- Provides AES-256-CBC + HMAC-SHA256 authenticated encryption (Encrypt-then-MAC)
-- and PBKDF2-SHA256 key derivation.
--
-- Wire format: IV (16 bytes) || ciphertext (PKCS7-padded) || HMAC-SHA256 tag (32 bytes)
-- Sub-keys are derived from the user key via HMAC-SHA256.
--
-- Usage:
-- import:
-- pkg/crypto as C
-- crypto_random { crypto_random_bytes }
-- result { Result(Ok, Err) }
-- bytes as B
--
-- key: Bytes = crypto_random_bytes(32)
-- match C.encrypt("secret message".to_bytes(), key):
-- Ok(ciphertext):
-- match C.decrypt(ciphertext, key):
-- Ok(plaintext): print(B.to_string(plaintext))
-- Err(e): print(e)
-- Err(e): print(e)
foreign(include: "crypto_ffi.h", link_linux: "-lcrypto"):
	func encrypt_ffi(plaintext: Bytes, key: Bytes) -> Result[Bytes, String] = "blorp_crypto_encrypt"
	func decrypt_ffi(
		ciphertext: Bytes,
		key: Bytes,
	) -> Result[Bytes, String] = "blorp_crypto_decrypt"
	func derive_key_ffi(
		password: String,
		salt: Bytes,
		iterations: Int,
	) -> Bytes = "blorp_crypto_derive_key"


---
Encrypt plaintext bytes using AES-256-CBC + HMAC-SHA256.
A random IV is generated for each call. The key can be any length
(sub-keys are derived via HMAC-SHA256).

Returns the ciphertext as: IV (16 bytes) || encrypted data || HMAC tag (32 bytes).

doctests:
    :: Encrypt produces longer output than input
    import:
        crypto_random: crypto_random_bytes
        bytes as B

    key: Bytes = crypto_random_bytes(32)
    match encrypt("hello".to_bytes(), key):
        Ok(ct): B.length(ct) > 5
        Err(_): False
---
func encrypt(plaintext: Bytes, key: Bytes) -> Result[Bytes, String]:
	encrypt_ffi(plaintext, key)


---
Decrypt ciphertext produced by encrypt().
Verifies the HMAC-SHA256 tag before decrypting (constant-time comparison).
Returns Err if the key is wrong or the ciphertext has been tampered with.

doctests:
    :: Encrypt then decrypt roundtrip
    import:
        crypto_random: crypto_random_bytes
        bytes as B

    key: Bytes = crypto_random_bytes(32)
    match encrypt("hello world".to_bytes(), key):
        Ok(ct):
            match decrypt(ct, key):
                Ok(pt): B.to_string(pt) == "hello world"
                Err(_): False
        Err(_): False
---
func decrypt(ciphertext: Bytes, key: Bytes) -> Result[Bytes, String]:
	decrypt_ffi(ciphertext, key)


---
Derive a 32-byte encryption key from a password and salt using PBKDF2-SHA256.
Use crypto_random_bytes(16) to generate a salt. Store the salt alongside
the ciphertext (it is not secret).

doctests:
    :: Derive key produces 32 bytes
    import:
        bytes as B

    k1: Bytes = derive_key("pass", "salt".to_bytes(), 1000)
    k2: Bytes = derive_key("pass", "salt".to_bytes(), 1000)
    B.to_hex(k1) == B.to_hex(k2)
---
func derive_key(password: String, salt: Bytes, iterations: Int) -> Bytes:
	derive_key_ffi(password, salt, iterations)
