import:
	bytes as B


-- Compress - zlib compression and decompression
--
-- Provides gzip and deflate compression/decompression for Bytes data.
-- Requires zlib (-lz) which is available on macOS and Linux by default.
--
-- Usage:
-- import:
-- pkg/compress as C
-- bytes as B
--
-- data: Bytes = "hello world".to_bytes()
-- match C.gzip(data):
-- Ok(compressed): ...
-- Err(e): ...
foreign(include: "compress_ffi.h", link: "-lz"):
	func deflate_compress_ffi(data: Bytes) -> Result[Bytes, String] = "blorp_deflate_compress"
	func deflate_decompress_ffi(data: Bytes) -> Result[Bytes, String] = "blorp_deflate_decompress"
	func gzip_compress_ffi(data: Bytes) -> Result[Bytes, String] = "blorp_gzip_compress"
	func gzip_decompress_ffi(data: Bytes) -> Result[Bytes, String] = "blorp_gzip_decompress"


---
Compress data using gzip format (with gzip header/trailer).

doctests:
    :: Compress empty bytes
    match gzip(B.bytes(0)):
        Ok(b): B.length(b) == 0
        Err(_): False
---
func gzip(data: Bytes) -> Result[Bytes, String]:
	gzip_compress_ffi(data)


---
Decompress gzip-compressed data.
---
func gunzip(data: Bytes) -> Result[Bytes, String]:
	gzip_decompress_ffi(data)


---
Compress data using raw deflate (no gzip header).
---
func deflate(data: Bytes) -> Result[Bytes, String]:
	deflate_compress_ffi(data)


---
Decompress raw deflate-compressed data.
---
func inflate(data: Bytes) -> Result[Bytes, String]:
	deflate_decompress_ffi(data)
