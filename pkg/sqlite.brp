-- SQLite - SQLite3 database bindings
--
-- Provides a simple interface to SQLite3 databases.
-- Requires libsqlite3 (available on macOS and most Linux systems).
--
-- Usage:
-- import:
-- pkg/sqlite as DB
-- result { Result(Ok, Err) }
--
-- match DB.open(":memory:"):
-- Ok(db):
-- _ = DB.execute(db, "CREATE TABLE t (id INTEGER, name TEXT)")
-- _ = DB.execute_params(db, "INSERT INTO t VALUES (?, ?)", ["1", "alice"])
-- match DB.query(db, "SELECT * FROM t"):
-- Ok(rows): print(to_string(rows))
-- Err(e): print(e)
-- DB.close(db)
-- Err(e): print(e)
foreign(include: "sqlite_ffi.h", link: "-lsqlite3"):
	func sqlite_open_ffi(path: String) -> Result[Ptr, String] = "blorp_sqlite_open"
	func sqlite_close_ffi(db: Ptr) -> Void = "blorp_sqlite_close"
	func sqlite_exec_ffi(db: Ptr, sql: String) -> Result[Void, String] = "blorp_sqlite_exec"
	func sqlite_query_ffi(
		db: Ptr,
		sql: String,
	) -> Result[List[List[String]], String] = "blorp_sqlite_query"
	func sqlite_columns_ffi(
		db: Ptr,
		sql: String,
	) -> Result[List[String], String] = "blorp_sqlite_columns"
	@no_copy func sqlite_exec_params_ffi(
		db: Ptr,
		sql: String,
		params: List[String],
	) -> Result[Void, String] = "blorp_sqlite_exec_params"
	@no_copy func sqlite_query_params_ffi(
		db: Ptr,
		sql: String,
		params: List[String],
	) -> Result[List[List[String]], String] = "blorp_sqlite_query_params"


---
Open a SQLite database. Use ":memory:" for an in-memory database.

doctests:
    :: Open in-memory database
    match open(":memory:"):
        Ok(db):
            close(db)
            True
        Err(_): False
---
func open(path: String) -> Result[Ptr, String]:
	sqlite_open_ffi(path)


---
Close a database connection.
---
func close(db: Ptr) -> Void:
	sqlite_close_ffi(db)


---
Execute a SQL statement (CREATE, INSERT, UPDATE, DELETE).
Does not return rows. The sql parameter must be a string literal
(enforced at compile time) to prevent SQL injection.
Use execute_params() for queries with dynamic values.

doctests:
    :: Create table
    match open(":memory:"):
        Ok(db):
            match execute(db, "CREATE TABLE t (id INTEGER)"):
                Ok(_):
                    close(db)
                    True
                Err(_):
                    close(db)
                    False
        Err(_): False
---
func execute(db: Ptr, sql: LiteralString) -> Result[Void, String]:
	sqlite_exec_ffi(db, sql)


---
Execute a SQL statement with parameters (SQL injection safe).
Parameters are bound positionally using ? placeholders.
All parameter values are strings. The sql template must be a string literal.
---
func execute_params(db: Ptr, sql: LiteralString, params: List[String]) -> Result[Void, String]:
	sqlite_exec_params_ffi(db, sql, params)


---
Execute a query and return rows as a list of lists.
Each row is a List[String] of column values. NULL values become "".
The sql parameter must be a string literal to prevent SQL injection.
Use query_params() for queries with dynamic values.
---
func query(db: Ptr, sql: LiteralString) -> Result[List[List[String]], String]:
	sqlite_query_ffi(db, sql)


---
Execute a parameterized query and return rows.
The sql template must be a string literal.
---
func query_params(
	db: Ptr,
	sql: LiteralString,
	params: List[String],
) -> Result[List[List[String]], String]:
	sqlite_query_params_ffi(db, sql, params)


---
Get column names for a query.
---
func columns(db: Ptr, sql: LiteralString) -> Result[List[String], String]:
	sqlite_columns_ffi(db, sql)
