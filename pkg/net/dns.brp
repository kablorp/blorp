-- DNS - Domain Name System resolution
--
-- Provides hostname resolution using the system resolver.
-- Returns both IPv4 and IPv6 addresses.
--
-- Usage:
-- import:
-- pkg/net/dns as DNS
-- result { Result(Ok, Err) }
--
-- match DNS.resolve("example.com"):
-- Ok(ips):
-- for ip in ips:
-- print(ip)
-- Err(e): print(e)
foreign(include: "udp_ffi.h"):
	func resolve_ffi(hostname: String) -> Result[List[String], String] = "blorp_dns_resolve"


---
Resolve a hostname to a list of IP addresses (IPv4 and IPv6).
Returns deduplicated results.

doctests:
    :: Resolve localhost
    match resolve("localhost"):
        Ok(ips): ips.length() > 0
        Err(_): True
---
func resolve(hostname: String) -> Result[List[String], String]:
	resolve_ffi(hostname)
