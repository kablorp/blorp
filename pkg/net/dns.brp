-- DNS - Domain Name System resolution
--
-- Provides hostname resolution using the system resolver.
-- Returns both IPv4 and IPv6 addresses.
--
-- Current implementation note: this package uses the platform blocking
-- resolver through FFI. The networking resource roadmap tracks a future
-- virtual-thread-friendly resolver service.
--
-- Usage:
-- import:
-- pkg/net/dns as DNS
-- result { Result(Ok, Err) }
--
-- match DNS.resolve("example.com"):
-- Ok(ips):
-- for ip in ips:
-- print(ip)
-- Err(e): print(DNS.message(e))
foreign(include: "dns_ffi.h"):
	private func resolve_ffi(hostname: String) -> Result[List[String], String] = "blorp_dns_resolve"


---
Typed DNS resolver error.
---
union DnsError:
	LookupFailed(String)


---
Return a stable, human-readable description of a DNS error.

doctests:
    :: Lookup errors include detail
    message(LookupFailed("no address")) == "lookup failed: no address"
---
pure func message(err: DnsError) -> String:
	match err:
		LookupFailed(detail): "lookup failed: " + detail


implements Stringable for DnsError:
	pure func to_string(err: DnsError) -> String:
		message(err)


---
Resolve a hostname to a list of IP addresses (IPv4 and IPv6).
Returns deduplicated results.

doctests:
    :: Resolve localhost
    match resolve("localhost"):
        Ok(ips): ips.length() > 0
        Err(_): True
---
func resolve(hostname: String) -> Result[List[String], DnsError]:
	match resolve_ffi(hostname):
		Ok(addresses): Ok(addresses)
		Err(detail): Err(LookupFailed(detail))
