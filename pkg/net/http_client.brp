import:
	bytes as B
	net/http: Header, Response, get_header
	net/tcp as TCP
	net/url as U: Url, effective_port, is_https
	pkg/net/tls as TLS


---
Make an HTTP GET request to the given URL.

doctests:
    :: GET returns a Result
    match http_get("http://httpbin.org/get"):
        Ok(resp): resp.status_code > 0
        Err(_): True
---
func http_get(url: String) -> Result[Response, String]:
	request("GET", url, [], None)


---
Make an HTTP POST request with a body and content type.
---
func http_post(url: String, body: String, content_type: String) -> Result[Response, String]:
	ct_header: Header = {name = "Content-Type", value = content_type}
	hdrs: List[Header] = [ct_header]
	request("POST", url, hdrs, Some(body))


---
Make an HTTP request with full control over method, headers, and body.
Follows redirects up to 10 hops.
---
func request(
	method: String,
	url: String,
	headers: List[Header],
	body: Option[String],
) -> Result[Response, String]:
	request_with_redirects(method, url, headers, body, 0)


private func request_with_redirects(
	method: String,
	url: String,
	headers: List[Header],
	body: Option[String],
	redirect_count: Int,
) -> Result[Response, String]:
	if redirect_count > 10:
		Err("too many redirects")
	else:
		match do_request(method, url, headers, body):
			Ok(resp):
				if resp.status_code >= 300 and resp.status_code < 400:
					match get_header(resp.headers, "Location"):
						Some(location):
							var new_url: String = location.substring(0, location.length())
							if not location.starts_with("http"):
								match U.parse(url):
									Ok(parsed):
										new_url = parsed.scheme + "://" + parsed.host + location
									Err(_): void
							request_with_redirects(
								method,
								new_url,
								headers,
								body,
								redirect_count + 1,
							)
						None:
							Ok(resp)
				else:
					Ok(resp)
			Err(e):
				Err(e)


private pure func has_crlf(s: String) -> Bool:
	s.contains("\r") or s.contains("\n")


private pure func validate_headers(headers: List[Header]) -> Result[Bool, String]:
	var j: Int = 0
	var valid: Bool = True
	while j < headers.length() and valid:
		match headers.get(j):
			Some(hdr):
				h: Header = hdr
				if has_crlf(h.name) or has_crlf(h.value):
					valid = False
			None: void
		j += 1
	if valid:
		Ok(True)
	else:
		Err("invalid header: contains CR/LF")


private func do_request(
	method: String,
	url: String,
	headers: List[Header],
	body: Option[String],
) -> Result[Response, String]:
	match U.parse(url):
		Err(e): Err(e)
		Ok(parsed):
			port: Int = effective_port(parsed)
			host: String = parsed.host.substring(0, parsed.host.length())
			if has_crlf(parsed.path) or has_crlf(parsed.query) or has_crlf(parsed.host):
				Err("invalid URL: contains CR/LF")
			else:
				match validate_headers(headers):
					Err(e): Err(e)
					Ok(_):
						var path: String = "/"
						if parsed.path.length() > 0:
							path = parsed.path.substring(0, parsed.path.length())
						var query_part: String = ""
						if parsed.query.length() > 0:
							query_part = "?" + parsed.query
						request_line: String = method + " " + path + query_part + " HTTP/1.1\r\n"
						var header_str: String = request_line
						header_str = header_str + "Host: " + host + "\r\n"
						header_str += "Connection: close\r\n"
						header_str += "User-Agent: blorp/1.0\r\n"
						match body:
							Some(b):
								header_str = header_str + "Content-Length: " + to_string(
									b.length(),
								) + "\r\n"
							None: void
						var i: Int = 0
						while i < headers.length():
							match headers.get(i):
								Some(h):
									hdr: Header = h
									header_str = header_str + hdr.name + ": " + hdr.value + "\r\n"
								None: void
							i += 1
						header_str += "\r\n"
						var request_data: Bytes = header_str.to_bytes()
						match body:
							Some(b):
								request_data = B.append(request_data, b.to_bytes())
							None: void
						if is_https(parsed):
							do_tls_request(host, port, request_data)
						else:
							do_tcp_request(host, port, request_data)


private func do_tcp_request(
	host: String,
	port: Int,
	request_data: Bytes,
) -> Result[Response, String]:
	match TCP.connect(host, port):
		Err(e): Err("TCP connect failed: " + e)
		Ok(fd):
			match TCP.write(fd, request_data):
				Err(e):
					TCP.close(fd)
					Err("TCP write failed: " + e)
				Ok(_):
					response_result: Result[Response, String] = read_tcp_response(fd)
					TCP.close(fd)
					response_result


private func do_tls_request(
	host: String,
	port: Int,
	request_data: Bytes,
) -> Result[Response, String]:
	match TLS.connect(host, port):
		Err(e): Err("TLS connect failed: " + e)
		Ok(conn):
			match TLS.write(conn, request_data):
				Err(e):
					TLS.close(conn)
					Err("TLS write failed: " + e)
				Ok(_):
					response_result: Result[Response, String] = read_tls_response(conn)
					TLS.close(conn)
					response_result


private func read_tcp_response(fd: Int) -> Result[Response, String]:
	var buf: Bytes = B.bytes(0)
	var done: Bool = False
	while not done:
		match TCP.read(fd, 8192):
			Ok(chunk):
				if B.length(chunk) == 0:
					done = True
				else:
					buf = B.append(buf, chunk)
			Err(_):
				done = True
	parse_http_response(buf)


private func read_tls_response(conn: Ptr) -> Result[Response, String]:
	var buf: Bytes = B.bytes(0)
	var done: Bool = False
	while not done:
		match TLS.read(conn, 8192):
			Ok(chunk):
				if B.length(chunk) == 0:
					done = True
				else:
					buf = B.append(buf, chunk)
			Err(_):
				done = True
	parse_http_response(buf)


private func parse_http_response(raw: Bytes) -> Result[Response, String]:
	raw_str: String = B.to_string(raw)
	sep_idx: Int = raw_str.raw_index_of("\r\n\r\n")
	if sep_idx == -1:
		Err("malformed response: missing header terminator")
	else:
		header_section: String = raw_str.substring(0, sep_idx)
		body_start: Int = sep_idx + 4
		var body_bytes: Bytes = B.bytes(0)
		if body_start < B.length(raw):
			body_bytes = B.slice(raw, body_start, B.length(raw) - body_start)
		header_lines: List[String] = header_section.split("\r\n")
		if header_lines.length() == 0:
			Err("malformed response: empty headers")
		else:
			match header_lines.get(0):
				Some(status_line):
					parse_status_line(status_line, header_lines, body_bytes)
				None:
					Err("malformed response: no status line")


private func parse_status_line(
	status_line: String,
	header_lines: List[String],
	body_bytes: Bytes,
) -> Result[Response, String]:
	first_space: Int = status_line.raw_index_of(" ")
	if first_space == -1:
		Err("malformed status line")
	else:
		after_version: String = status_line.substring(
			first_space + 1,
			status_line.length() - first_space - 1,
		)
		second_space: Int = after_version.raw_index_of(" ")
		var code_str: String = ""
		var reason: String = ""
		if second_space == -1:
			code_str = after_version.substring(0, after_version.length())
			reason = ""
		else:
			code_str = after_version.substring(0, second_space)
			reason = after_version.substring(
				second_space + 1,
				after_version.length() - second_space - 1,
			)
		match code_str.parse_int():
			Some(code):
				var hdrs: List[Header] = []
				var i: Int = 1
				while i < header_lines.length():
					match header_lines.get(i):
						Some(line):
							colon_idx: Int = line.raw_index_of(": ")
							if colon_idx > 0:
								hname: String = line.substring(0, colon_idx)
								hvalue: String = line.substring(
									colon_idx + 2,
									line.length() - colon_idx - 2,
								)
								hdrs = hdrs.append({name = hname, value = hvalue})
						None: void
					i += 1
				resp: Response = {
					status_code = code,
					status_text = reason,
					headers = hdrs,
					body = body_bytes,
				}
				Ok(resp)
			None:
				Err("malformed status code: " + code_str)
