import:
	bytes as B
	crypto_random: crypto_random_bytes
	hash: sha1
	net/url as U: Url


-- WebSocket - RFC 6455 helpers.
--
-- The old client API returned a `WebSocket` record that owned a TCP stream.
-- That shape is incompatible with scoped resources: records are copyable
-- ordinary values, while socket resources need compiler-owned cleanup edges.
-- Scoped session ownership now lives in `net/websocket`; this package
-- exposes ordinary frame and handshake helpers plus a typed migration error.
-- ============================================================================
-- Types
-- ============================================================================
-- Message received from a WebSocket peer.
union Message:
	Text(String)
	Binary(Bytes)
	Close(Int, String)
	Ping(Bytes)
	Pong(Bytes)


---
Typed error surface for WebSocket helpers.
---
union WebSocketError:
	InvalidUrl(String)
	ResourceApiRequired(String)


private RESOURCE_API_REQUIRED_DETAIL: String = "Use net/websocket for scoped native WebSocket sessions"


private pure func has_websocket_scheme(url: Url) -> Bool:
	url.scheme == "ws" or url.scheme == "wss"


private pure func has_raw_space_or_control(s: String) -> Bool:
	var found: Bool = False
	var i: Int = 0

	while i < s.length() and not found:
		match s.get(i):
			Some(c):
				code: Int = to_int(c)

				if code <= 32 or code == 127:
					found = True
			None:
				found = True

		i += 1

	found


private pure func is_authority_delimiter(c: Char) -> Bool:
	c == '/' or c == '?' or c == '#'


private pure func authority_end_index(url: String, start: Int) -> Int:
	var i: Int = start
	var end: Int = url.length()
	var done: Bool = False

	while i < url.length() and not done:
		match url.get(i):
			Some(c):
				if is_authority_delimiter(c):
					end = i
					done = True
			None:
				end = i
				done = True

		i += 1

	end


private pure func validate_host_text(host: String) -> Result[Void, WebSocketError]:
	if host.length() == 0:
		Err(InvalidUrl("url must include a host"))
	else:
		Ok(void)


private pure func validate_port_text(port: String) -> Result[Void, WebSocketError]:
	if port.length() == 0:
		Err(InvalidUrl("port must not be empty"))
	else:
		var valid: Bool = True
		var value: Int = 0
		var i: Int = 0

		while i < port.length() and valid:
			match port.get(i):
				Some(c):
					code: Int = to_int(c)

					if code < 48 or code > 57:
						valid = False
					else:
						value = value * 10 + code - 48

						if value > 65535:
							valid = False
				None:
					valid = False

			i += 1

		if not valid:
			match port.parse_int():
				Some(n):
					if n > 65535:
						Err(InvalidUrl("port must be between 0 and 65535"))
					else:
						Err(InvalidUrl("port must contain only digits"))
				None:
					Err(InvalidUrl("port must contain only digits"))
		else:
			Ok(void)


private pure func validate_authority(authority: String) -> Result[Void, WebSocketError]:
	if authority.length() == 0:
		Err(InvalidUrl("url must include a host"))
	else if authority.contains("@"):
		Err(InvalidUrl("url must not include user info"))
	else if authority.starts_with("["):
		end_idx: Int = authority.raw_index_of("]")

		if end_idx == -1:
			Err(InvalidUrl("IPv6 host must close with ]"))
		else:
			host: String = authority.substring(1, end_idx - 1)

			match validate_host_text(host):
				Err(err):
					Err(err)
				Ok(_):
					if end_idx + 1 == authority.length():
						Ok(void)
					else:
						match authority.get(end_idx + 1):
							Some(':'):
								port: String = authority.substring(
									end_idx + 2,
									authority.length() - end_idx - 2,
								)
								validate_port_text(port)
							Some(_):
								Err(InvalidUrl("invalid character after IPv6 host"))
							None:
								Err(InvalidUrl("invalid character after IPv6 host"))
	else:
		colon_idx: Int = authority.raw_index_of(":")

		if colon_idx == -1:
			validate_host_text(authority)
		else:
			host: String = authority.substring(0, colon_idx)

			match validate_host_text(host):
				Err(err):
					Err(err)
				Ok(_):
					port: String = authority.substring(
						colon_idx + 1,
						authority.length() - colon_idx - 1,
					)
					validate_port_text(port)


private pure func validate_websocket_url_text(url: String) -> Result[Void, WebSocketError]:
	if url.length() == 0:
		Err(InvalidUrl("url must not be empty"))
	else if has_raw_space_or_control(url):
		Err(InvalidUrl("url must not contain raw control or space characters"))
	else if url.contains("#"):
		Err(InvalidUrl("url must not include a fragment"))
	else:
		var host_start: Int = -1

		if url.starts_with("ws://"):
			host_start = 5
		else if url.starts_with("wss://"):
			host_start = 6

		if host_start == -1:
			Err(InvalidUrl("scheme must be ws:// or wss://"))
		else:
			auth_end: Int = authority_end_index(url, host_start)
			authority: String = url.substring(host_start, auth_end - host_start)
			validate_authority(authority)


private pure func validate_websocket_url(url: Url) -> Result[Void, WebSocketError]:
	if not has_websocket_scheme(url):
		Err(InvalidUrl("scheme must be ws:// or wss://"))
	else if url.host.length() == 0:
		Err(InvalidUrl("url must include a host"))
	else:
		Ok(void)


---
Return a stable, human-readable description of a WebSocket error.

doctests:
    :: Resource API errors include detail
    message(
        ResourceApiRequired(
            "missing scoped session",
        ),
    ) == "resource API required: missing scoped session"
---
pure func message(err: WebSocketError) -> String:
	match err:
		InvalidUrl(detail):
			"invalid URL: " + detail
		ResourceApiRequired(detail):
			"resource API required: " + detail


implements Stringable for WebSocketError:
	pure func to_string(err: WebSocketError) -> String:
		message(err)


-- ============================================================================
-- Byte Access Helper
-- ============================================================================
-- Get a byte value (0-255) from Bytes at index, returns 0 for out-of-bounds.
pure func byte_at(b: Bytes, i: Int) -> Int:
	match B.get(b, i):
		Some(v):
			v
		None:
			0


-- ============================================================================
-- Constants
-- ============================================================================
private WS_GUID: String = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"

private OPCODE_TEXT: Int = 1

private OPCODE_BINARY: Int = 2

private OPCODE_CLOSE: Int = 8

private OPCODE_PING: Int = 9

private OPCODE_PONG: Int = 10


-- ============================================================================
-- Connection
-- ============================================================================
---
Report that WebSocket connections live on the std scoped resource surface.

This function intentionally does not return a connection handle. Returning a
copyable `WebSocket` value that owns a socket would make cleanup unsound. Use
`net/websocket` for scoped native sessions.
---
func connect(url: String) -> Result[Void, WebSocketError]:
	match validate_websocket_url_text(url):
		Err(err):
			Err(err)
		Ok(_):
			match U.parse(url):
				Err(e):
					Err(InvalidUrl(e))
				Ok(parsed):
					match validate_websocket_url(parsed):
						Err(err):
							Err(err)
						Ok(_):
							Err(ResourceApiRequired(RESOURCE_API_REQUIRED_DETAIL))


-- ============================================================================
-- Frame Encoding
-- ============================================================================
---
Encode a client WebSocket frame.

Client frames are masked as required by RFC 6455. This function is impure
because it calls `crypto_random_bytes` to generate the mask key.
---
func encode_frame(opcode: Int, payload: Bytes) -> Bytes:
	payload_len: Int = B.length(payload)

	-- Calculate header size.
	header_size: Int = 2 + 4

	header_size2: Int = if payload_len >= 65536:
		header_size + 8
	else if payload_len >= 126:
		header_size + 2
	else:
		header_size

	var frame: Bytes = B.bytes(header_size2 + payload_len)
	frame = B.set_index(frame, 0, 128 + opcode)

	var offset: Int = 2

	if payload_len < 126:
		frame = B.set_index(frame, 1, 128 + payload_len)
	else if payload_len < 65536:
		frame = B.set_index(frame, 1, 128 + 126)
		frame = B.set_index(frame, 2, payload_len / 256)
		frame = B.set_index(frame, 3, payload_len % 256)
		offset = 4
	else:
		frame = B.set_index(frame, 1, 128 + 127)
		frame = write_u64_be(frame, 2, payload_len)
		offset = 10

	mask: Bytes = crypto_random_bytes(4)
	frame = B.blit(frame, offset, mask, 0, 4)

	var i: Int = 0

	while i < payload_len:
		pb: Int = byte_at(payload, i)
		mb: Int = byte_at(mask, i % 4)
		frame = B.set_index(
			frame,
			offset + 4 + i,
			bitwise_xor_byte(pb, mb),
		)
		i += 1

	frame


---
Apply a WebSocket masking key to payload bytes.

doctests:
    :: Mask shorter than four bytes leaves data unchanged
    apply_mask("ping".to_bytes(), B.bytes(0)).to_string() == "ping"
---
pure func apply_mask(data: Bytes, mask: Bytes) -> Bytes:
	if B.length(mask) < 4:
		data
	else:
		len: Int = B.length(data)
		var result: Bytes = B.bytes(len)
		var i: Int = 0

		while i < len:
			db: Int = byte_at(data, i)
			mb: Int = byte_at(mask, i % 4)
			result = B.set_index(
				result,
				i,
				bitwise_xor_byte(db, mb),
			)
			i += 1

		result


-- Bitwise XOR for single bytes (0-255).
pure func bitwise_xor_byte(a: Int, b: Int) -> Int:
	var result: Int = 0
	var va: Int = a % 256
	var vb: Int = b % 256
	var bit: Int = 1
	var i: Int = 0

	while i < 8:
		da: Int = va / bit % 2
		db: Int = vb / bit % 2

		if da != db:
			result += bit

		bit *= 2
		i += 1

	result


-- ============================================================================
-- Handshake Helpers
-- ============================================================================
-- Generate a random WebSocket key (16 bytes base64-encoded).
func generate_key() -> String:
	raw: Bytes = crypto_random_bytes(16)
	B
		.to_string(raw)
		.base64_encode()


-- Build the HTTP upgrade request.
pure func build_handshake(host: String, port: Int, url: Url, key: String) -> Bytes:
	var path: String = "/"

	if url.path.length() > 0:
		path = url.path.substring(0, url.path.length())

	var query_part: String = ""

	if url.query.length() > 0:
		query_part = "?" + url.query

	var s: String = "GET " + path + query_part + " HTTP/1.1\r\n"
	s = s + "Host: " + host + "\r\n"
	s += "Upgrade: websocket\r\n"
	s += "Connection: Upgrade\r\n"
	s = s + "Sec-WebSocket-Key: " + key + "\r\n"
	s += "Sec-WebSocket-Version: 13\r\n"
	s += "\r\n"
	s.to_bytes()


-- Compute the expected accept value for a given key.
pure func compute_accept(key: String) -> String:
	combined: String = key + WS_GUID
	hex: String = sha1(combined)

	match B.from_hex(hex):
		Some(raw):
			B
				.to_string(raw)
				.base64_encode()
		None:
			""


-- Verify the server's handshake response.
pure func verify_handshake(response: String, key: String) -> Result[Bool, String]:
	if not response.contains("101"):
		trunc_len: Int = if response.length() < 100:
			response.length()
		else:
			100

		Err("server rejected upgrade: " + response.substring(0, trunc_len))
	else:
		expected: String = compute_accept(key)

		if response.contains(expected):
			Ok(True)
		else:
			Err("invalid Sec-WebSocket-Accept")


-- ============================================================================
-- Binary Helpers
-- ============================================================================
-- Read big-endian u16 from bytes at offset.
pure func read_u16_be(b: Bytes, offset: Int) -> Int:
	byte_at(b, offset) * 256 + byte_at(b, offset + 1)


-- Read big-endian u64 from bytes at offset.
pure func read_u64_be(b: Bytes, offset: Int) -> Int:
	var result: Int = 0
	var i: Int = 0

	while i < 8:
		result = result * 256 + byte_at(b, offset + i)
		i += 1

	result


-- Write big-endian u64 to bytes at offset.
private pure func write_u64_be(b: Bytes, offset: Int, value: Int) -> Bytes:
	var result: Bytes = b
	var v: Int = value
	var i: Int = 7

	while i >= 0:
		result = B.set_index(result, offset + i, v % 256)
		v /= 256
		i -= 1

	result
