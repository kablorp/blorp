-- UDP - User Datagram Protocol sockets
--
-- Provides UDP socket operations for connectionless networking.
-- Useful for DNS queries, game networking, and other datagram protocols.
--
-- Usage:
-- import:
-- pkg/net/udp as UDP
-- result { Result(Ok, Err) }
-- bytes as B
--
-- match UDP.socket():
-- Ok(fd):
-- _ = UDP.sendto(fd, "hello".to_bytes(), "127.0.0.1", 9000)
-- match UDP.recvfrom(fd, 1024):
-- Ok(data): print(B.to_string(data))
-- Err(e): print(e)
-- UDP.close(fd)
-- Err(e): print(e)
foreign(include: "udp_ffi.h"):
	func socket_ffi() -> Result[Int, String] = "blorp_udp_socket"
	func bind_ffi(fd: Int, host: String, port: Int) -> Result[Void, String] = "blorp_udp_bind"
	func sendto_ffi(
		fd: Int,
		data: Bytes,
		host: String,
		port: Int,
	) -> Result[Int, String] = "blorp_udp_sendto"
	func recvfrom_ffi(fd: Int, max_bytes: Int) -> Result[Bytes, String] = "blorp_udp_recvfrom"
	func close_ffi(fd: Int) -> Void = "blorp_udp_close"


---
Create a UDP socket. Returns the socket file descriptor.
---
func socket() -> Result[Int, String]:
	socket_ffi()


---
Bind a UDP socket to a local address and port.
Use "0" for any address.
---
func bind(fd: Int, host: String, port: Int) -> Result[Void, String]:
	bind_ffi(fd, host, port)


---
Send data to a specific host and port.
Returns the number of bytes sent.
---
func sendto(fd: Int, data: Bytes, host: String, port: Int) -> Result[Int, String]:
	sendto_ffi(fd, data, host, port)


---
Receive data from a UDP socket.
Returns up to max_bytes of data.
---
func recvfrom(fd: Int, max_bytes: Int) -> Result[Bytes, String]:
	recvfrom_ffi(fd, max_bytes)


---
Close a UDP socket.
---
func close(fd: Int) -> Void:
	close_ffi(fd)
