-- UDP - User Datagram Protocol sockets
--
-- Provides UDP socket operations for connectionless networking.
-- Useful for DNS queries, game networking, and other datagram protocols.
-- This package is native-backed and blocking; it is not yet fiber-aware.
--
-- Usage:
-- import:
-- pkg/net/udp as UDP
-- result { Result(Ok, Err) }
-- bytes as B
--
-- match UDP.socket():
-- Ok(sock):
-- _ = UDP.sendto(sock, "hello".to_bytes(), "127.0.0.1", 9000)
-- match UDP.recvfrom(sock, 1024):
-- Ok(data): print(B.to_string(data))
-- Err(e): print(e)
-- UDP.close(sock)
-- Err(e): print(e)
new type UdpSocket = Int


foreign(include: "udp_ffi.h"):
	func socket_ffi() -> Result[Int, String] = "blorp_udp_socket"
	func bind_ffi(fd: Int, host: String, port: Int) -> Result[Void, String] = "blorp_udp_bind"
	func sendto_ffi(
		fd: Int,
		data: Bytes,
		host: String,
		port: Int,
	) -> Result[Int, String] = "blorp_udp_sendto"
	func recvfrom_ffi(fd: Int, max_bytes: Int) -> Result[Bytes, String] = "blorp_udp_recvfrom"
	func close_ffi(fd: Int) -> Void = "blorp_udp_close"


---
Create a UDP socket. Returns an opaque socket handle.
---
func socket() -> Result[UdpSocket, String]:
	match socket_ffi():
		Ok(fd): Ok(UdpSocket(fd))
		Err(e): Err(e)


---
Bind a UDP socket to a local address and port.
Use "0" for any address.
---
func bind(sock: UdpSocket, host: String, port: Int) -> Result[Void, String]:
	bind_ffi(sock.value(), host, port)


---
Send data to a specific host and port.
Returns the number of bytes sent.
---
func sendto(
	sock: UdpSocket,
	data: Bytes,
	host: String,
	port: Int,
) -> Result[Int, String]:
	sendto_ffi(sock.value(), data, host, port)


---
Receive data from a UDP socket.
Returns up to max_bytes of data.
---
func recvfrom(sock: UdpSocket, max_bytes: Int) -> Result[Bytes, String]:
	recvfrom_ffi(sock.value(), max_bytes)


---
Close a UDP socket.
---
func close(sock: UdpSocket) -> Void:
	close_ffi(sock.value())
