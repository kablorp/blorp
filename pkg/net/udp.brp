-- UDP - scoped resource API placeholder.
--
-- The old package API exposed raw integer file descriptors plus manual
-- `close`. That shape is incompatible with Blorp's resource model: a socket is
-- an external capability with one cleanup owner, not an ordinary copyable Int.
-- Scoped UDP support now lives in `std/net/udp`. This package remains only as
-- a compatibility placeholder so old raw-descriptor imports fail with a typed
-- resource-migration error instead of reintroducing manual ownership.
---
Typed error surface for the placeholder UDP package.
---
union UdpError:
	ResourceApiRequired(String)


private pure func resource_api_required_detail() -> String:
	"UDP sockets require a scoped UDP resource API"


---
Return a stable, human-readable description of a UDP error.

doctests:
    :: Resource API errors include detail
    message(
        ResourceApiRequired("missing scoped handle"),
    ) == "resource API required: missing scoped handle"
---
pure func message(err: UdpError) -> String:
	match err:
		ResourceApiRequired(detail): "resource API required: " + detail


implements Stringable for UdpError:
	pure func to_string(err: UdpError) -> String:
		message(err)


---
Report that UDP sockets are pending a scoped resource API.

This function intentionally does not return a raw file descriptor. Real UDP
support is available as `std/net/udp.UdpSocket` with compiler-owned cleanup and
fiber-aware receive waits.
---
func socket() -> Result[Void, UdpError]:
	Err(ResourceApiRequired(resource_api_required_detail()))
