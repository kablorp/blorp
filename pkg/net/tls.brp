-- TLS - scoped resource API placeholder.
--
-- The old package API exposed opaque `Ptr` sessions plus manual `close`.
-- That shape is incompatible with Blorp's resource model: TLS sessions own
-- external state and must have compiler-owned cleanup. Scoped TLS support now
-- lives in `std/net/tls`; this package exposes only a typed migration error.
--
-- New work should target `std/net/tls`, which now owns the scoped resource
-- surface. This package remains only as a compatibility placeholder for the
-- old native-backed package path.
---
Typed error surface for the placeholder TLS package.
---
union TlsError:
	ResourceApiRequired(String)


private pure func resource_api_required_detail() -> String:
	"TLS sessions require a scoped TLS resource API"


---
Return a stable, human-readable description of a TLS error.

doctests:
    :: Resource API errors include detail
    message(
        ResourceApiRequired("missing scoped handle"),
    ) == "resource API required: missing scoped handle"
---
pure func message(err: TlsError) -> String:
	match err:
		ResourceApiRequired(detail): "resource API required: " + detail


implements Stringable for TlsError:
	pure func to_string(err: TlsError) -> String:
		message(err)


---
Report that TLS sessions are pending a scoped resource API.

This function intentionally does not return an opaque pointer. Real TLS support
should land as a scoped resource that owns or consumes its underlying transport
and closes all native state through compiler-owned cleanup.
---
func connect(host: String, port: Int) -> Result[Void, TlsError]:
	Err(ResourceApiRequired(resource_api_required_detail()))
