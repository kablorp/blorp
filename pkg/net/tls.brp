-- TLS Networking - Secure socket connections via OpenSSL
--
-- All functions are impure (I/O). Returns Result[T, String] for error handling.
-- Uses an opaque TLS connection handle. Caller must call close() to free.
-- This package is native-backed and blocking; it is not yet fiber-aware.
--
-- Requires: OpenSSL (brew install openssl)
new type TlsConn = Ptr


foreign(include: "tls_ffi.h", link_macos: "-I/opt/homebrew/opt/openssl@3/include -L/opt/homebrew/opt/openssl@3/lib -lssl -lcrypto", link_linux: "-lssl -lcrypto"):
	func tls_connect_ffi(host: String, port: Int) -> Result[Ptr, String] = "blorp_tls_connect"
	func tls_read_ffi(conn: Ptr, max_bytes: Int) -> Result[Bytes, String] = "blorp_tls_read"
	func tls_write_ffi(conn: Ptr, data: Bytes) -> Result[Int, String] = "blorp_tls_write"
	func tls_set_timeout_ffi(conn: Ptr, ms: Int) -> Result[Int, String] = "blorp_tls_set_timeout"
	func tls_close_ffi(conn: Ptr) -> Void = "blorp_tls_close"


func connect(host: String, port: Int) -> Result[TlsConn, String]:
	match tls_connect_ffi(host, port):
		Ok(conn): Ok(TlsConn(conn))
		Err(e): Err(e)


func read(conn: TlsConn, max_bytes: Int) -> Result[Bytes, String]:
	tls_read_ffi(conn.value(), max_bytes)


func write(conn: TlsConn, data: Bytes) -> Result[Int, String]:
	tls_write_ffi(conn.value(), data)


func set_timeout(conn: TlsConn, ms: Int) -> Result[Int, String]:
	tls_set_timeout_ffi(conn.value(), ms)


func close(conn: TlsConn) -> Void:
	tls_close_ffi(conn.value())
