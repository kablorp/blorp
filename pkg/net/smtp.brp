import:
	bytes as B
	net/tcp as TCP
	net/tls as TLS


-- SMTP Client - Send emails via scoped TCP resources.
--
-- The plain TCP path is resource-safe: the stream is acquired with `with` and
-- all socket operations stay inside that scope. STARTTLS is also structured as
-- a scoped TCP stream with a dependent TLS session. Portable builds report a
-- deterministic TLS support error; native TLS profiles use the same scoped
-- resource path.
--
-- Usage:
-- import:
-- pkg/net/smtp as SMTP
-- result { Result(Ok, Err) }
--
-- config: SMTP.Config = {
-- host = "localhost",
-- port = 25,
-- username = "sender@example.com",
-- password = "",
-- use_tls = False
-- }
-- match SMTP.send_email(config, "to@example.com", "Subject", "Body text"):
-- Ok(_): print("sent!")
-- Err(e): print("error: " + e)
-- ============================================================================
-- Types
-- ============================================================================
---
SMTP server configuration.

`use_tls = True` returns an explicit error unless the runtime has an
implemented native TLS backend. When native TLS is available, the STARTTLS path
targets `std/net/tls` scoped sessions instead of the old package pointer API.
---
record Config {
	host: String,
	port: Int,
	username: String,
	password: String,
	use_tls: Bool
}


private union SmtpOutcome:
	SmtpSent
	SmtpProtocolError(String)


private func smtp_port_for_message(port_num: Int) -> Result[TCP.Port, String]:
	match TCP.port(port_num):
		Ok(remote): Ok(remote)
		Err(err): Err("SMTP transport: " + TCP.message(err))


private func smtp_dns_name_for_message(host: String) -> Result[TCP.DnsName, String]:
	match TCP.dns_name(host):
		Ok(name): Ok(name)
		Err(err): Err("SMTP transport: " + TCP.message(err))


-- ============================================================================
-- Public API
-- ============================================================================
---
Send a plain text email.

Connects to the SMTP server over scoped TCP, authenticates if credentials are
provided, and sends the email.
---
func send_email(
	config: Config,
	to: String,
	subject: String,
	body: String,
) -> Result[Bool, String]:
	send_email_full(config, to, subject, body, "text/plain")


---
Send an HTML email.
---
func send_html_email(
	config: Config,
	to: String,
	subject: String,
	html_body: String,
) -> Result[Bool, String]:
	send_email_full(config, to, subject, html_body, "text/html")


-- ============================================================================
-- Internal Implementation
-- ============================================================================
private func send_email_full(
	config: Config,
	to: String,
	subject: String,
	body: String,
	content_type: String,
) -> Result[Bool, String]:
	if config.use_tls:
		if not TLS.native_available():
			Err((
					"SMTP STARTTLS requires TLS resource support: native TLS support is not "
					+ "implemented yet"
				))
		else:
			message: String = build_message(config.username, to, subject, body, content_type)
			match smtp_starttls_session(config, to, message):
				Ok(SmtpSent): Ok(True)
				Ok(SmtpProtocolError(err)): Err(err)
				Err(err): Err(err)
	else:
		message: String = build_message(config.username, to, subject, body, content_type)
		match smtp_plain_tcp_session(config, to, message):
			Ok(SmtpSent): Ok(True)
			Ok(SmtpProtocolError(err)): Err(err)
			Err(err): Err("SMTP transport: " + TCP.message(err))


private func smtp_plain_tcp_session(
	config: Config,
	to: String,
	message: String,
) -> Result[SmtpOutcome, TCP.TcpError]:
	remote ?= TCP.port(config.port)
	match TCP.parse_ip(config.host):
		Ok(address): smtp_plain_tcp_session_ip(config, to, message, address, remote)
		Err(_):
			name ?= TCP.dns_name(config.host)
			smtp_plain_tcp_session_name(config, to, message, name, remote)


private func smtp_plain_tcp_session_ip(
	config: Config,
	to: String,
	message: String,
	address: TCP.IpAddress,
	remote: TCP.Port,
) -> Result[SmtpOutcome, TCP.TcpError]:
	with stream ?= TCP.connect_ip(address, remote):
		ignored ?= TCP.set_stream_timeout(stream, 10000)
		steps: List[(String, String, String)] = smtp_steps(config, to, message)
		var outcome: SmtpOutcome = SmtpSent
		var failed: Bool = False
		var transport_error: Option[TCP.TcpError] = None
		for step in steps:
			if not failed:
				command: String = step[0]
				expect_prefix: String = step[1]
				label: String = step[2]
				if command.length() > 0:
					match TCP.write_all(stream, command.to_bytes()):
						Ok(_): void
						Err(err):
							transport_error = Some(err)
							failed = True
				if not failed:
					var buf: Bytes = B.bytes(0)
					var done: Bool = False
					while not done and not failed:
						match TCP.read(stream, 4096):
							Ok(chunk):
								if B.length(chunk) == 0:
									done = True
								else:
									buf = B.append(buf, chunk)
									response_so_far: String = B.to_string(buf)
									if response_so_far.contains("\r\n"):
										done = True
							Err(err):
								transport_error = Some(err)
								done = True
								failed = True
					if not failed:
						response: String = B.to_string(buf)
						if not response.starts_with(expect_prefix):
							outcome = SmtpProtocolError(
								label + ": expected " + expect_prefix + ", got: " + response,
							)
							failed = True
		if not failed:
			match TCP.write_all(stream, "QUIT\r\n".to_bytes()):
				Ok(_): void
				Err(_): void
		match transport_error:
			Some(err): Err(err)
			None: Ok(outcome)


private func smtp_plain_tcp_session_name(
	config: Config,
	to: String,
	message: String,
	name: TCP.DnsName,
	remote: TCP.Port,
) -> Result[SmtpOutcome, TCP.TcpError]:
	with stream ?= TCP.connect_name(name, remote):
		ignored ?= TCP.set_stream_timeout(stream, 10000)
		steps: List[(String, String, String)] = smtp_steps(config, to, message)
		var outcome: SmtpOutcome = SmtpSent
		var failed: Bool = False
		var transport_error: Option[TCP.TcpError] = None
		for step in steps:
			if not failed:
				command: String = step[0]
				expect_prefix: String = step[1]
				label: String = step[2]
				if command.length() > 0:
					match TCP.write_all(stream, command.to_bytes()):
						Ok(_): void
						Err(err):
							transport_error = Some(err)
							failed = True
				if not failed:
					var buf: Bytes = B.bytes(0)
					var done: Bool = False
					while not done and not failed:
						match TCP.read(stream, 4096):
							Ok(chunk):
								if B.length(chunk) == 0:
									done = True
								else:
									buf = B.append(buf, chunk)
									response_so_far: String = B.to_string(buf)
									if response_so_far.contains("\r\n"):
										done = True
							Err(err):
								transport_error = Some(err)
								done = True
								failed = True
					if not failed:
						response: String = B.to_string(buf)
						if not response.starts_with(expect_prefix):
							outcome = SmtpProtocolError(
								label + ": expected " + expect_prefix + ", got: " + response,
							)
							failed = True
		if not failed:
			match TCP.write_all(stream, "QUIT\r\n".to_bytes()):
				Ok(_): void
				Err(_): void
		match transport_error:
			Some(err): Err(err)
			None: Ok(outcome)


private func smtp_starttls_session(
	config: Config,
	to: String,
	message: String,
) -> Result[SmtpOutcome, String]:
	remote ?= smtp_port_for_message(config.port)
	match TCP.parse_ip(config.host):
		Ok(address): smtp_starttls_session_ip(config, to, message, address, remote)
		Err(_):
			name ?= smtp_dns_name_for_message(config.host)
			smtp_starttls_session_name(config, to, message, name, remote)


private func smtp_starttls_session_ip(
	config: Config,
	to: String,
	message: String,
	address: TCP.IpAddress,
	remote: TCP.Port,
) -> Result[SmtpOutcome, String]:
	with stream ?= TCP.connect_ip(address, remote) on err => "SMTP transport: " + TCP.message(err):
		var setup_error: Option[String] = None
		match TCP.set_stream_timeout(stream, 10000):
			Ok(_): void
			Err(err): setup_error = Some("SMTP transport: " + TCP.message(err))
		match setup_error:
			Some(err): Err(err)
			None:
				pre_tls_steps: List[(String, String, String)] = smtp_starttls_preamble_steps()
				var outcome: SmtpOutcome = SmtpSent
				var failed: Bool = False
				var transport_error: Option[String] = None
				for step in pre_tls_steps:
					if not failed:
						command: String = step[0]
						expect_prefix: String = step[1]
						label: String = step[2]
						if command.length() > 0:
							match TCP.write_all(stream, command.to_bytes()):
								Ok(_): void
								Err(err):
									transport_error = Some("SMTP transport: " + TCP.message(err))
									failed = True
						if not failed:
							var buf: Bytes = B.bytes(0)
							var done: Bool = False
							while not done and not failed:
								match TCP.read(stream, 4096):
									Ok(chunk):
										if B.length(chunk) == 0:
											done = True
										else:
											buf = B.append(buf, chunk)
											response_so_far: String = B.to_string(buf)
											if response_so_far.contains("\r\n"):
												done = True
									Err(err):
										transport_error = Some(
											"SMTP transport: " + TCP.message(err),
										)
										done = True
										failed = True
							if not failed:
								response: String = B.to_string(buf)
								if not response.starts_with(expect_prefix):
									outcome = SmtpProtocolError(
										label + ": expected " + expect_prefix + ", got: " + response,
									)
									failed = True
				match transport_error:
					Some(err): Err(err)
					None:
						if failed:
							Ok(outcome)
						else:
							with session ?= TLS.connect(
								stream,
								config.host,
							) on err => "SMTP STARTTLS requires TLS resource support: " + TLS.message(
								err,
							):
								tls_steps: List[(String, String, String)] = smtp_tls_steps(
									config,
									to,
									message,
								)
								var tls_outcome: SmtpOutcome = SmtpSent
								var tls_failed: Bool = False
								var tls_error: Option[String] = None
								for step in tls_steps:
									if not tls_failed:
										command: String = step[0]
										expect_prefix: String = step[1]
										label: String = step[2]
										if command.length() > 0:
											match TLS.write_all(session, command.to_bytes()):
												Ok(_): void
												Err(err):
													tls_error = Some(
														"SMTP TLS transport: " + TLS.message(err),
													)
													tls_failed = True
										if not tls_failed:
											var buf: Bytes = B.bytes(0)
											var done: Bool = False
											while not done and not tls_failed:
												match TLS.read(session, 4096):
													Ok(chunk):
														if B.length(chunk) == 0:
															done = True
														else:
															buf = B.append(buf, chunk)
															response_so_far: String = B.to_string(
																buf,
															)
															if response_so_far.contains("\r\n"):
																done = True
													Err(err):
														tls_error = Some(
															"SMTP TLS transport: " + TLS.message(
																err,
															),
														)
														done = True
														tls_failed = True
											if not tls_failed:
												response: String = B.to_string(buf)
												if not response.starts_with(expect_prefix):
													tls_outcome = SmtpProtocolError(
														label + ": expected " + expect_prefix + ", got: " + response,
													)
													tls_failed = True
								if not tls_failed:
									match TLS.write_all(session, "QUIT\r\n".to_bytes()):
										Ok(_): void
										Err(_): void
								match tls_error:
									Some(err): Err(err)
									None: Ok(tls_outcome)


private func smtp_starttls_session_name(
	config: Config,
	to: String,
	message: String,
	name: TCP.DnsName,
	remote: TCP.Port,
) -> Result[SmtpOutcome, String]:
	with stream ?= TCP.connect_name(name, remote) on err => "SMTP transport: " + TCP.message(err):
		var setup_error: Option[String] = None
		match TCP.set_stream_timeout(stream, 10000):
			Ok(_): void
			Err(err): setup_error = Some("SMTP transport: " + TCP.message(err))
		match setup_error:
			Some(err): Err(err)
			None:
				pre_tls_steps: List[(String, String, String)] = smtp_starttls_preamble_steps()
				var outcome: SmtpOutcome = SmtpSent
				var failed: Bool = False
				var transport_error: Option[String] = None
				for step in pre_tls_steps:
					if not failed:
						command: String = step[0]
						expect_prefix: String = step[1]
						label: String = step[2]
						if command.length() > 0:
							match TCP.write_all(stream, command.to_bytes()):
								Ok(_): void
								Err(err):
									transport_error = Some("SMTP transport: " + TCP.message(err))
									failed = True
						if not failed:
							var buf: Bytes = B.bytes(0)
							var done: Bool = False
							while not done and not failed:
								match TCP.read(stream, 4096):
									Ok(chunk):
										if B.length(chunk) == 0:
											done = True
										else:
											buf = B.append(buf, chunk)
											response_so_far: String = B.to_string(buf)
											if response_so_far.contains("\r\n"):
												done = True
									Err(err):
										transport_error = Some(
											"SMTP transport: " + TCP.message(err),
										)
										done = True
										failed = True
							if not failed:
								response: String = B.to_string(buf)
								if not response.starts_with(expect_prefix):
									outcome = SmtpProtocolError(
										label + ": expected " + expect_prefix + ", got: " + response,
									)
									failed = True
				match transport_error:
					Some(err): Err(err)
					None:
						if failed:
							Ok(outcome)
						else:
							with session ?= TLS.connect(
								stream,
								config.host,
							) on err => "SMTP STARTTLS requires TLS resource support: " + TLS.message(
								err,
							):
								tls_steps: List[(String, String, String)] = smtp_tls_steps(
									config,
									to,
									message,
								)
								var tls_outcome: SmtpOutcome = SmtpSent
								var tls_failed: Bool = False
								var tls_error: Option[String] = None
								for step in tls_steps:
									if not tls_failed:
										command: String = step[0]
										expect_prefix: String = step[1]
										label: String = step[2]
										if command.length() > 0:
											match TLS.write_all(session, command.to_bytes()):
												Ok(_): void
												Err(err):
													tls_error = Some(
														"SMTP TLS transport: " + TLS.message(err),
													)
													tls_failed = True
										if not tls_failed:
											var buf: Bytes = B.bytes(0)
											var done: Bool = False
											while not done and not tls_failed:
												match TLS.read(session, 4096):
													Ok(chunk):
														if B.length(chunk) == 0:
															done = True
														else:
															buf = B.append(buf, chunk)
															response_so_far: String = B.to_string(
																buf,
															)
															if response_so_far.contains("\r\n"):
																done = True
													Err(err):
														tls_error = Some(
															"SMTP TLS transport: " + TLS.message(
																err,
															),
														)
														done = True
														tls_failed = True
											if not tls_failed:
												response: String = B.to_string(buf)
												if not response.starts_with(expect_prefix):
													tls_outcome = SmtpProtocolError(
														label + ": expected " + expect_prefix + ", got: " + response,
													)
													tls_failed = True
								if not tls_failed:
									match TLS.write_all(session, "QUIT\r\n".to_bytes()):
										Ok(_): void
										Err(_): void
								match tls_error:
									Some(err): Err(err)
									None: Ok(tls_outcome)


private func smtp_starttls_preamble_steps() -> List[(String, String, String)]:
	var steps: List[(String, String, String)] = []
	steps = steps.append(("", "220", "greeting"))
	steps = steps.append(("EHLO blorp\r\n", "250", "EHLO"))
	steps.append(("STARTTLS\r\n", "220", "STARTTLS"))


private func smtp_tls_steps(
	config: Config,
	to: String,
	message: String,
) -> List[(String, String, String)]:
	var steps: List[(String, String, String)] = []
	steps = steps.append(("EHLO blorp\r\n", "250", "EHLO after STARTTLS"))
	if config.username.length() > 0:
		steps = steps.append((auth_plain_command(config.username, config.password), "235", "AUTH"))
	steps = steps.append(("MAIL FROM:<" + config.username + ">\r\n", "250", "MAIL FROM"))
	steps = steps.append(("RCPT TO:<" + to + ">\r\n", "250", "RCPT TO"))
	steps = steps.append(("DATA\r\n", "354", "DATA"))
	steps.append((message, "250", "message"))


private func smtp_steps(
	config: Config,
	to: String,
	message: String,
) -> List[(String, String, String)]:
	var steps: List[(String, String, String)] = []
	steps = steps.append(("", "220", "greeting"))
	steps = steps.append(("EHLO blorp\r\n", "250", "EHLO"))
	if config.username.length() > 0:
		steps = steps.append((auth_plain_command(config.username, config.password), "235", "AUTH"))
	steps = steps.append(("MAIL FROM:<" + config.username + ">\r\n", "250", "MAIL FROM"))
	steps = steps.append(("RCPT TO:<" + to + ">\r\n", "250", "RCPT TO"))
	steps = steps.append(("DATA\r\n", "354", "DATA"))
	steps.append((message, "250", "message"))


-- Send AUTH PLAIN (base64-encoded \0username\0password).
private pure func auth_plain_command(username: String, password: String) -> String:
	var auth_bytes: Bytes = B.bytes(1 + username.length() + 1 + password.length())
	auth_bytes = B.set_index(auth_bytes, 0, 0)
	auth_bytes = B.blit(auth_bytes, 1, username.to_bytes(), 0, username.length())
	auth_bytes = B.set_index(auth_bytes, 1 + username.length(), 0)
	auth_bytes = B.blit(
		auth_bytes,
		2 + username.length(),
		password.to_bytes(),
		0,
		password.length(),
	)
	encoded: String = B
		.to_string(auth_bytes)
		.base64_encode()
	"AUTH PLAIN " + encoded + "\r\n"


---
Build a MIME message for SMTP DATA.
---
pure func build_message(
	from: String,
	to: String,
	subject: String,
	body: String,
	content_type: String,
) -> String:
	var msg: String = "From: " + from + "\r\n"
	msg = msg + "To: " + to + "\r\n"
	msg = msg + "Subject: " + subject + "\r\n"
	msg += "MIME-Version: 1.0\r\n"
	msg = msg + "Content-Type: " + content_type + "; charset=utf-8\r\n"
	msg += "\r\n"
	msg = msg + body + "\r\n"
	msg += ".\r\n"
	msg
