{
  "comments": {
    "lineComment": "--"
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:(?:private\\s+)?(?:func|pure\\s+func|builtin\\s+func|builtin\\s+pure\\s+func|foreign\\s+func|foreign\\s+pure\\s+func|foreign|concurrent|detach|if|else|while|for|match|with|select|debug|trait|implements|union|enum|record|struct|resource\\s+type|import)\\b.*|(?:[a-zA-Z_][a-zA-Z0-9_]*|_)\\s+from\\b.*|_\\s+after\\b.*|sealed\\b.*):\\s*(--.*)?$",
    "decreaseIndentPattern": "^\\s*(else)\\b"
  },
  "wordPattern": "#[a-zA-Z0-9_]+|[a-zA-Z_][a-zA-Z0-9_]*"
}
