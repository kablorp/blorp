{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Blorp",
  "scopeName": "source.blorp",
  "patterns": [
    { "include": "#docstrings" },
    { "include": "#comments" },
    { "include": "#annotations" },
    { "include": "#strings" },
    { "include": "#characters" },
    { "include": "#function-signatures" },
    { "include": "#declarations" },
    { "include": "#imports" },
    { "include": "#contextual-bindings" },
    { "include": "#match-arms" },
    { "include": "#control-keywords" },
    { "include": "#logical-operators" },
    { "include": "#self" },
    { "include": "#booleans" },
    { "include": "#builtin-keyword" },
    { "include": "#function-return-type" },
    { "include": "#operators" },
    { "include": "#numeric-type-params" },
    { "include": "#floats" },
    { "include": "#integers" },
    { "include": "#builtin-types" },
    { "include": "#variants" },
    { "include": "#member-access" },
    { "include": "#bindings" },
    { "include": "#assignment-targets" },
    { "include": "#type-names" },
    { "include": "#function-calls" },
    { "include": "#other-keywords" },
    { "include": "#punctuation" },
    { "include": "#wildcard" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-dash.blorp",
          "match": "--.*$"
        }
      ]
    },
    "docstrings": {
      "patterns": [
        {
          "name": "comment.block.documentation.blorp",
          "begin": "^(\\s*)(---)\\s*$",
          "end": "^(\\s*)(---)\\s*$",
          "beginCaptures": {
            "2": { "name": "punctuation.definition.comment.documentation.begin.blorp" }
          },
          "endCaptures": {
            "2": { "name": "punctuation.definition.comment.documentation.end.blorp" }
          },
          "patterns": [
            {
              "name": "meta.doctest.block.blorp",
              "begin": "^\\s*(doctests:)\\s*$",
              "end": "^(?=\\s*---\\s*$)",
              "beginCaptures": {
                "1": { "name": "markup.heading.doctest.blorp" }
              },
              "patterns": [
                {
                  "match": "^\\s*(::)\\s*(.*)$",
                  "captures": {
                    "1": { "name": "keyword.operator.doctest.name.blorp" },
                    "2": { "name": "entity.name.section.doctest.blorp" }
                  }
                },
                {
                  "match": "^(\\s*)(>>>)\\s*(.*)$",
                  "captures": {
                    "2": { "name": "keyword.operator.doctest.prompt.blorp" },
                    "3": { "name": "source.blorp.embedded.doctest" }
                  }
                },
                {
                  "match": "^\\s*(#.*)$",
                  "captures": {
                    "1": { "name": "comment.line.number-sign.doctest.blorp" }
                  }
                },
                { "include": "source.blorp" }
              ]
            },
            {
              "match": "^\\s*(Examples:)\\s*$",
              "captures": {
                "1": { "name": "markup.heading.documentation.examples.blorp" }
              }
            }
          ]
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "match": "(@)(\\w+)",
          "captures": {
            "1": { "name": "punctuation.definition.annotation.blorp" },
            "2": { "name": "entity.name.annotation.blorp" }
          }
        }
      ]
    },
    "function-signatures": {
      "patterns": [
        {
          "comment": "named function signature header and parameter list",
          "begin": "\\b(?:(private)\\s+)?(?:(?:(builtin)|(foreign))\\s+)?(?:(pure)\\s+)?(func)\\s+([a-z_][a-zA-Z0-9_]*)(?=\\s*(?:\\[|\\())",
          "end": "(?=\\s*(?:->|:|=|$))",
          "beginCaptures": {
            "1": { "name": "storage.modifier.private.blorp" },
            "2": { "name": "keyword.other.builtin.blorp" },
            "3": { "name": "keyword.other.foreign.blorp" },
            "4": { "name": "storage.modifier.pure.blorp" },
            "5": { "name": "storage.type.function.blorp" },
            "6": { "name": "entity.name.function.definition.blorp" }
          },
          "patterns": [
            { "include": "#function-type-parameters" },
            { "include": "#function-parameters" }
          ]
        },
        {
          "comment": "lambda signature parameter list",
          "begin": "\\b(?:(pure)\\s+)?(func)(?=\\s*\\()",
          "end": "(?=\\s*(?:->|:|=|$))",
          "beginCaptures": {
            "1": { "name": "storage.modifier.pure.blorp" },
            "2": { "name": "storage.type.function.blorp" }
          },
          "patterns": [
            { "include": "#function-parameters" }
          ]
        }
      ]
    },
    "function-type-parameters": {
      "patterns": [
        {
          "begin": "\\[",
          "end": "\\]",
          "beginCaptures": {
            "0": { "name": "punctuation.section.type-parameters.begin.blorp" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.section.type-parameters.end.blorp" }
          },
          "patterns": [
            {
              "name": "variable.parameter.type.blorp",
              "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
            },
            { "include": "#numeric-type-params" },
            { "include": "#builtin-types" },
            { "include": "#type-names" },
            { "include": "#punctuation" }
          ]
        }
      ]
    },
    "function-parameters": {
      "patterns": [
        {
          "begin": "\\(",
          "end": "\\)",
          "beginCaptures": {
            "0": { "name": "punctuation.section.parameters.begin.blorp" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.section.parameters.end.blorp" }
          },
          "patterns": [
            {
              "match": "\\b([a-z_][a-zA-Z0-9_]*)(\\s*)(:)",
              "captures": {
                "1": { "name": "variable.parameter.function.blorp" },
                "3": { "name": "punctuation.definition.type-annotation.parameter.blorp" }
              }
            },
            {
              "match": "\\b(_)(\\s*)(:)",
              "captures": {
                "1": { "name": "variable.language.wildcard.parameter.blorp" },
                "3": { "name": "punctuation.definition.type-annotation.parameter.blorp" }
              }
            },
            {
              "name": "variable.language.wildcard.parameter.blorp",
              "match": "\\b_\\b"
            },
            {
              "name": "variable.parameter.function.blorp",
              "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
            },
            { "include": "#function-type-parameters" },
            { "include": "#numeric-type-params" },
            { "include": "#builtin-types" },
            { "include": "#type-names" },
            { "include": "#booleans" },
            { "include": "#floats" },
            { "include": "#integers" },
            { "include": "#operators" },
            { "include": "#punctuation" }
          ]
        }
      ]
    },
    "function-return-type": {
      "patterns": [
        {
          "begin": "->",
          "end": "(?=\\s*:|\\s*=|$)",
          "beginCaptures": {
            "0": { "name": "keyword.operator.return-type.blorp" }
          },
          "patterns": [
            { "include": "#function-type-parameters" },
            { "include": "#numeric-type-params" },
            { "include": "#builtin-types" },
            { "include": "#type-names" },
            { "include": "#punctuation" }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "comment": "raw pipe string: raw followed by indented | lines",
          "name": "string.unquoted.pipe.raw.blorp",
          "begin": "\\b(raw)\\s*$",
          "end": "^(?!\\s*\\|)",
          "beginCaptures": {
            "1": { "name": "storage.type.string.raw.blorp" }
          },
          "patterns": [
            {
              "match": "^(\\s*)(\\|\\|?)(.*)$",
              "captures": {
                "2": { "name": "punctuation.definition.string.begin.blorp" },
                "3": { "name": "string.unquoted.pipe.raw.content.blorp" }
              }
            }
          ]
        },
        {
          "comment": "raw string: raw\"...\" (no escapes, no interpolation)",
          "name": "string.quoted.double.raw.blorp",
          "begin": "raw\"",
          "end": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.blorp" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.blorp" }
          }
        },
        {
          "comment": "pipe string line: |...",
          "name": "string.unquoted.pipe.blorp",
          "begin": "^(\\s*)(\\|\\|?)",
          "end": "$",
          "beginCaptures": {
            "2": { "name": "punctuation.definition.string.begin.blorp" }
          },
          "patterns": [
            { "include": "#string-interpolation" }
          ]
        },
        {
          "name": "string.quoted.double.blorp",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.blorp" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.blorp" }
          },
          "patterns": [
            { "include": "#string-escape" },
            { "include": "#string-interpolation" }
          ]
        }
      ]
    },
    "string-escape": {
      "patterns": [
        {
          "name": "constant.character.escape.blorp",
          "match": "\\\\[ntr\\\\\"'0{}]"
        },
        {
          "name": "constant.character.escape.unicode.blorp",
          "match": "\\\\u\\{[0-9a-fA-F]+\\}"
        }
      ]
    },
    "string-interpolation": {
      "patterns": [
        {
          "begin": "\\$\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": { "name": "punctuation.section.interpolation.begin.blorp" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.section.interpolation.end.blorp" }
          },
          "patterns": [
            { "include": "source.blorp" }
          ]
        }
      ]
    },
    "characters": {
      "patterns": [
        {
          "name": "string.quoted.single.blorp",
          "match": "'(\\\\u\\{[0-9a-fA-F]+\\}|\\\\[ntr\\\\\"'0]|[^\\\\'])'",
          "captures": {
            "1": { "name": "constant.character.blorp" }
          }
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "comment": "builtin pure func declaration",
          "match": "\\b(builtin)\\s+(pure)\\s+(func)\\s+([a-z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.builtin.blorp" },
            "2": { "name": "storage.modifier.pure.blorp" },
            "3": { "name": "storage.type.function.blorp" },
            "4": { "name": "entity.name.function.blorp" }
          }
        },
        {
          "comment": "builtin func declaration",
          "match": "\\b(builtin)\\s+(func)\\s+([a-z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.builtin.blorp" },
            "2": { "name": "storage.type.function.blorp" },
            "3": { "name": "entity.name.function.blorp" }
          }
        },
        {
          "comment": "private pure func declaration",
          "match": "\\b(private)\\s+(pure)\\s+(func)\\s+([a-z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.private.blorp" },
            "2": { "name": "storage.modifier.pure.blorp" },
            "3": { "name": "storage.type.function.blorp" },
            "4": { "name": "entity.name.function.blorp" }
          }
        },
        {
          "comment": "private func declaration",
          "match": "\\b(private)\\s+(func)\\s+([a-z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.private.blorp" },
            "2": { "name": "storage.type.function.blorp" },
            "3": { "name": "entity.name.function.blorp" }
          }
        },
        {
          "comment": "pure func declaration (named)",
          "match": "\\b(pure)\\s+(func)\\s+([a-z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.pure.blorp" },
            "2": { "name": "storage.type.function.blorp" },
            "3": { "name": "entity.name.function.blorp" }
          }
        },
        {
          "comment": "func declaration (named — lookahead for [ or ()",
          "match": "\\b(func)\\s+([a-z_][a-zA-Z0-9_]*)(?=\\s*[\\[(])",
          "captures": {
            "1": { "name": "storage.type.function.blorp" },
            "2": { "name": "entity.name.function.blorp" }
          }
        },
        {
          "comment": "pure lambda (no name)",
          "match": "\\b(pure)\\s+(func)(?=\\s*\\()",
          "captures": {
            "1": { "name": "storage.modifier.pure.blorp" },
            "2": { "name": "storage.type.function.blorp" }
          }
        },
        {
          "comment": "lambda (no name)",
          "match": "\\b(func)(?=\\s*\\()",
          "captures": {
            "1": { "name": "storage.type.function.blorp" }
          }
        },
        {
          "comment": "foreign block header: foreign: or foreign(...)",
          "match": "\\b(foreign)(?=\\s*[:(])",
          "captures": {
            "1": { "name": "keyword.other.foreign.blorp" }
          }
        },
        {
          "comment": "foreign pure func declaration",
          "match": "\\b(foreign)\\s+(pure)\\s+(func)\\s+([a-z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.foreign.blorp" },
            "2": { "name": "storage.modifier.pure.blorp" },
            "3": { "name": "storage.type.function.blorp" },
            "4": { "name": "entity.name.function.blorp" }
          }
        },
        {
          "comment": "foreign func declaration",
          "match": "\\b(foreign)\\s+(func)\\s+([a-z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.foreign.blorp" },
            "2": { "name": "storage.type.function.blorp" },
            "3": { "name": "entity.name.function.blorp" }
          }
        },
        {
          "comment": "private resource type declaration",
          "match": "\\b(private)\\s+(resource)\\s+(type)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.private.blorp" },
            "2": { "name": "keyword.declaration.resource.blorp" },
            "3": { "name": "keyword.declaration.type.blorp" },
            "4": { "name": "entity.name.type.resource.blorp" }
          }
        },
        {
          "comment": "resource type declaration",
          "match": "\\b(resource)\\s+(type)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.resource.blorp" },
            "2": { "name": "keyword.declaration.type.blorp" },
            "3": { "name": "entity.name.type.resource.blorp" }
          }
        },
        {
          "comment": "private struct declaration",
          "match": "\\b(private)\\s+(struct)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.private.blorp" },
            "2": { "name": "keyword.declaration.struct.blorp" },
            "3": { "name": "entity.name.type.struct.blorp" }
          }
        },
        {
          "comment": "struct declaration",
          "match": "\\b(struct)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.struct.blorp" },
            "2": { "name": "entity.name.type.struct.blorp" }
          }
        },
        {
          "comment": "private union declaration",
          "match": "\\b(private)\\s+(union)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.private.blorp" },
            "2": { "name": "keyword.declaration.union.blorp" },
            "3": { "name": "entity.name.type.union.blorp" }
          }
        },
        {
          "comment": "union declaration",
          "match": "\\b(union)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.union.blorp" },
            "2": { "name": "entity.name.type.union.blorp" }
          }
        },
        {
          "comment": "private enum declaration",
          "match": "\\b(private)\\s+(enum)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.private.blorp" },
            "2": { "name": "keyword.declaration.enum.blorp" },
            "3": { "name": "entity.name.type.enum.blorp" }
          }
        },
        {
          "comment": "enum declaration",
          "match": "\\b(enum)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.enum.blorp" },
            "2": { "name": "entity.name.type.enum.blorp" }
          }
        },
        {
          "comment": "private record declaration",
          "match": "\\b(private)\\s+(record)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.private.blorp" },
            "2": { "name": "keyword.declaration.record.blorp" },
            "3": { "name": "entity.name.type.record.blorp" }
          }
        },
        {
          "comment": "record declaration",
          "match": "\\b(record)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.record.blorp" },
            "2": { "name": "entity.name.type.record.blorp" }
          }
        },
        {
          "comment": "private trait declaration",
          "match": "\\b(private)\\s+(trait)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.private.blorp" },
            "2": { "name": "keyword.declaration.trait.blorp" },
            "3": { "name": "entity.name.type.trait.blorp" }
          }
        },
        {
          "comment": "trait declaration",
          "match": "\\b(trait)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.trait.blorp" },
            "2": { "name": "entity.name.type.trait.blorp" }
          }
        },
        {
          "comment": "implements declaration with receiver type",
          "match": "\\b(implements)\\s+([A-Z][a-zA-Z0-9_]*)(\\s+)(for)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.implements.blorp" },
            "2": { "name": "entity.name.type.trait.blorp" },
            "4": { "name": "keyword.control.for.blorp" },
            "5": { "name": "entity.name.type.blorp" }
          }
        },
        {
          "comment": "implements declaration",
          "match": "\\b(implements)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.implements.blorp" },
            "2": { "name": "entity.name.type.trait.blorp" }
          }
        },
        {
          "comment": "private opaque type declaration",
          "match": "\\b(private)\\s+(opaque)\\s+(type)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.private.blorp" },
            "2": { "name": "storage.modifier.opaque.blorp" },
            "3": { "name": "keyword.declaration.type.blorp" },
            "4": { "name": "entity.name.type.opaque.blorp" }
          }
        },
        {
          "comment": "opaque type declaration",
          "match": "\\b(opaque)\\s+(type)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.opaque.blorp" },
            "2": { "name": "keyword.declaration.type.blorp" },
            "3": { "name": "entity.name.type.opaque.blorp" }
          }
        },
        {
          "comment": "builtin type declaration",
          "match": "\\b(type)\\s+([A-Z][a-zA-Z0-9_]*)(?=\\s*(?:\\[|=))",
          "captures": {
            "1": { "name": "keyword.declaration.type.blorp" },
            "2": { "name": "entity.name.type.blorp" }
          }
        },
        {
          "comment": "private type alias declaration",
          "match": "\\b(private)\\s+(type)\\s+(alias)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.private.blorp" },
            "2": { "name": "keyword.declaration.type.blorp" },
            "3": { "name": "keyword.declaration.alias.blorp" },
            "4": { "name": "entity.name.type.alias.blorp" }
          }
        },
        {
          "comment": "type alias declaration",
          "match": "\\b(type)\\s+(alias)\\s+([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.type.blorp" },
            "2": { "name": "keyword.declaration.alias.blorp" },
            "3": { "name": "entity.name.type.alias.blorp" }
          }
        }
      ]
    },
    "imports": {
      "patterns": [
        {
          "comment": "import: block",
          "begin": "\\b(import)\\s*:",
          "end": "^(?=\\S)",
          "beginCaptures": {
            "1": { "name": "keyword.control.import.blorp" }
          },
          "patterns": [
            { "include": "#comments" },
            {
              "comment": "module path with as alias and selective imports",
              "match": "^\\s+((?:(?:\\.\\./)+|\\./)?[A-Za-z_][A-Za-z0-9_]*(?:/[A-Za-z_][A-Za-z0-9_]*)*)\\s+(as)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(:)",
              "captures": {
                "1": { "name": "string.unquoted.module-path.blorp" },
                "2": { "name": "keyword.control.import.blorp" },
                "3": { "name": "entity.name.namespace.blorp" },
                "4": { "name": "punctuation.separator.colon.blorp" }
              }
            },
            {
              "comment": "module path with selective imports",
              "match": "^\\s+((?:(?:\\.\\./)+|\\./)?[A-Za-z_][A-Za-z0-9_]*(?:/[A-Za-z_][A-Za-z0-9_]*)*)\\s*(:)",
              "captures": {
                "1": { "name": "string.unquoted.module-path.blorp" },
                "2": { "name": "punctuation.separator.colon.blorp" }
              }
            },
            {
              "comment": "module path with as alias",
              "match": "^\\s+((?:(?:\\.\\./)+|\\./)?[A-Za-z_][A-Za-z0-9_]*(?:/[A-Za-z_][A-Za-z0-9_]*)*)\\s+(as)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*$",
              "captures": {
                "1": { "name": "string.unquoted.module-path.blorp" },
                "2": { "name": "keyword.control.import.blorp" },
                "3": { "name": "entity.name.namespace.blorp" }
              }
            },
            {
              "comment": "bare module path in import block",
              "match": "^\\s+((?:(?:\\.\\./)+|\\./)?[A-Za-z_][A-Za-z0-9_]*(?:/[A-Za-z_][A-Za-z0-9_]*)*)\\s*$",
              "captures": {
                "1": { "name": "string.unquoted.module-path.blorp" }
              }
            },
            {
              "name": "keyword.control.import.blorp",
              "match": "\\bas\\b"
            },
            {
              "name": "entity.name.type.imported.blorp",
              "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
            },
            {
              "name": "variable.other.imported.blorp",
              "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
            },
            { "include": "#punctuation" }
          ]
        }
      ]
    },
    "contextual-bindings": {
      "patterns": [
        {
          "comment": "for-loop binder",
          "match": "\\b(for)\\s+([a-z_][a-zA-Z0-9_]*|_)(\\s+)(in)\\b",
          "captures": {
            "1": { "name": "keyword.control.blorp" },
            "2": { "name": "variable.parameter.loop.blorp" },
            "4": { "name": "keyword.control.blorp" }
          }
        },
        {
          "comment": "resource acquisition binder",
          "match": "\\b(with)\\s+([a-z_][a-zA-Z0-9_]*)(\\s*)(\\?=)",
          "captures": {
            "1": { "name": "keyword.control.blorp" },
            "2": { "name": "variable.other.resource.blorp" },
            "4": { "name": "keyword.operator.try-bind.blorp" }
          }
        },
        {
          "comment": "typed resource acquisition binder",
          "match": "\\b(with)\\s+([a-z_][a-zA-Z0-9_]*)(\\s*)(:)",
          "captures": {
            "1": { "name": "keyword.control.blorp" },
            "2": { "name": "variable.other.resource.blorp" },
            "4": { "name": "punctuation.definition.type-annotation.blorp" }
          }
        },
        {
          "comment": "select receive or timeout arm binder",
          "match": "^(\\s*)([a-z_][a-zA-Z0-9_]*|_)(\\s+)(from|after)\\b",
          "captures": {
            "2": { "name": "variable.parameter.select.blorp" },
            "4": { "name": "keyword.control.blorp" }
          }
        }
      ]
    },
    "match-arms": {
      "patterns": [
        {
          "comment": "constructor or enum match arm",
          "match": "^(\\s*)([A-Z][a-zA-Z0-9_]*)(?=\\s*(?:\\(|:|\\||,|$|--))",
          "captures": {
            "2": { "name": "entity.name.type.variant.blorp" }
          }
        },
        {
          "comment": "wildcard match arm",
          "match": "^(\\s*)(_)(?=\\s*:)",
          "captures": {
            "2": { "name": "variable.language.wildcard.blorp" }
          }
        },
        {
          "comment": "empty list match arm",
          "match": "^(\\s*)(\\[\\])(?=\\s*:)",
          "captures": {
            "2": { "name": "constant.language.empty-list.blorp" }
          }
        }
      ]
    },
    "control-keywords": {
      "patterns": [
        {
          "name": "keyword.control.blorp",
          "match": "\\b(if|else|for|while|match|in|break|continue|where|with|select|into_opaque|from|from_opaque|after|sealed|debug|concurrent|concurrently|detach|as)\\b"
        }
      ]
    },
    "logical-operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.blorp",
          "match": "\\b(and|or|not)\\b"
        }
      ]
    },
    "self": {
      "patterns": [
        {
          "name": "variable.language.self.blorp",
          "match": "\\bSelf\\b"
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.blorp",
          "match": "\\b(True|False)\\b"
        }
      ]
    },
    "builtin-keyword": {
      "patterns": [
        {
          "name": "keyword.other.builtin.blorp",
          "match": "\\bbuiltin\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.blorp",
          "match": "->"
        },
        {
          "name": "keyword.operator.fatarrow.blorp",
          "match": "=>"
        },
        {
          "name": "keyword.operator.comparison.blorp",
          "match": "==|!=|<=|>="
        },
        {
          "name": "keyword.operator.try-bind.blorp",
          "match": "\\?="
        },
        {
          "name": "keyword.operator.assignment.compound.blorp",
          "match": "\\+=|-=|\\*=|/="
        },
        {
          "name": "keyword.operator.spread.blorp",
          "match": "\\.\\.\\."
        },
        {
          "name": "keyword.operator.range.blorp",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.assignment.blorp",
          "match": "(?<![=!<>])=(?!=)"
        },
        {
          "name": "keyword.operator.comparison.blorp",
          "match": "<|>"
        },
        {
          "name": "keyword.operator.arithmetic.blorp",
          "match": "[+\\-*/%]"
        }
      ]
    },
    "numeric-type-params": {
      "patterns": [
        {
          "name": "variable.other.type-param.numeric.blorp",
          "match": "#(?:[a-zA-Z_][a-zA-Z0-9_]*(?:\\.\\.\\.)?|[0-9]+)"
        }
      ]
    },
    "floats": {
      "patterns": [
        {
          "name": "constant.numeric.float.blorp",
          "match": "\\b(?:[0-9]+\\.[0-9]+(?:[eE][+-]?[0-9]+)?|[0-9]+[eE][+-]?[0-9]+)\\b"
        }
      ]
    },
    "integers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.blorp",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "builtin-types": {
      "patterns": [
        {
          "name": "support.type.blorp",
          "match": "\\b(Int|Float|String|Bool|Char|Void|Tensor|Vector|Matrix|List|Dict|Set|Option|Result|Fixed|TestSuite|Bytes|Ptr|Channel|Int8|Int16|Int32|Int64|Int128|UInt8|UInt16|UInt32|UInt64|UInt128|Float32|Float16)\\b"
        }
      ]
    },
    "variants": {
      "patterns": [
        {
          "comment": "indented nullary or payload union variants",
          "match": "^(\\s+)([A-Z][a-zA-Z0-9_]*)(?=\\s*(?:\\(|:|\\||,|$|--))",
          "captures": {
            "2": { "name": "entity.name.type.variant.blorp" }
          }
        }
      ]
    },
    "member-access": {
      "patterns": [
        {
          "comment": "method call through UFCS syntax",
          "match": "\\b([A-Za-z_][a-zA-Z0-9_]*)(\\.)([a-z_][a-zA-Z0-9_]*)(?=\\s*[\\[(])",
          "captures": {
            "1": { "name": "variable.other.object.blorp" },
            "2": { "name": "punctuation.accessor.dot.blorp" },
            "3": { "name": "entity.name.function.method.blorp" }
          }
        },
        {
          "comment": "qualified type or constructor access",
          "match": "\\b([A-Za-z_][a-zA-Z0-9_]*)(\\.)([A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "entity.name.namespace.blorp" },
            "2": { "name": "punctuation.accessor.dot.blorp" },
            "3": { "name": "entity.name.type.blorp" }
          }
        },
        {
          "comment": "field or qualified member access",
          "match": "\\b([A-Za-z_][a-zA-Z0-9_]*)(\\.)([A-Za-z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "variable.other.object.blorp" },
            "2": { "name": "punctuation.accessor.dot.blorp" },
            "3": { "name": "variable.other.member.blorp" }
          }
        }
      ]
    },
    "bindings": {
      "patterns": [
        {
          "comment": "mutable local binding",
          "match": "\\b(var)\\s+([a-z_][a-zA-Z0-9_]*)(?=\\s*(?::|=|\\?=))",
          "captures": {
            "1": { "name": "storage.type.blorp" },
            "2": { "name": "variable.other.definition.blorp" }
          }
        },
        {
          "comment": "typed local or top-level binding",
          "match": "\\b([a-z_][a-zA-Z0-9_]*)(\\s*)(:)",
          "captures": {
            "1": { "name": "variable.other.definition.blorp" },
            "3": { "name": "punctuation.definition.type-annotation.blorp" }
          }
        },
        {
          "comment": "binding through propagation",
          "match": "\\b([a-z_][a-zA-Z0-9_]*)(\\s*)(\\?=)",
          "captures": {
            "1": { "name": "variable.other.definition.blorp" },
            "3": { "name": "keyword.operator.try-bind.blorp" }
          }
        }
      ]
    },
    "assignment-targets": {
      "patterns": [
        {
          "comment": "line-start assignment target",
          "match": "^(\\s*)([a-z_][a-zA-Z0-9_]*|_)(\\s*)(=)(?!=)",
          "captures": {
            "2": { "name": "variable.other.assignment.blorp" },
            "4": { "name": "keyword.operator.assignment.blorp" }
          }
        }
      ]
    },
    "type-names": {
      "patterns": [
        {
          "name": "entity.name.type.blorp",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "match": "\\b([a-z_][a-zA-Z0-9_]*)(?=\\s*[\\[(])",
          "captures": {
            "1": { "name": "entity.name.function.call.blorp" }
          }
        }
      ]
    },
    "other-keywords": {
      "patterns": [
        {
          "name": "storage.modifier.private.blorp",
          "match": "\\bprivate\\b"
        },
        {
          "name": "storage.type.blorp",
          "match": "\\b(var|func|pure)\\b"
        },
        {
          "name": "keyword.declaration.type.blorp",
          "match": "\\b(union|enum|record|struct|resource|type|opaque)\\b"
        },
        {
          "name": "keyword.declaration.alias.blorp",
          "match": "\\balias\\b"
        },
        {
          "name": "keyword.declaration.trait.blorp",
          "match": "\\btrait\\b"
        },
        {
          "name": "keyword.declaration.implements.blorp",
          "match": "\\bimplements\\b"
        },
        {
          "name": "keyword.other.foreign.blorp",
          "match": "\\bforeign\\b"
        },
        {
          "name": "keyword.other.void.blorp",
          "match": "\\bvoid\\b"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.parens.begin.blorp",
          "match": "\\("
        },
        {
          "name": "punctuation.section.parens.end.blorp",
          "match": "\\)"
        },
        {
          "name": "punctuation.section.brackets.begin.blorp",
          "match": "\\["
        },
        {
          "name": "punctuation.section.brackets.end.blorp",
          "match": "\\]"
        },
        {
          "name": "punctuation.section.braces.begin.blorp",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.braces.end.blorp",
          "match": "\\}"
        },
        {
          "name": "punctuation.separator.colon.blorp",
          "match": ":"
        },
        {
          "name": "punctuation.separator.comma.blorp",
          "match": ","
        },
        {
          "name": "punctuation.accessor.dot.blorp",
          "match": "\\."
        },
        {
          "name": "punctuation.separator.pipe.blorp",
          "match": "\\|"
        }
      ]
    },
    "wildcard": {
      "patterns": [
        {
          "name": "variable.language.wildcard.blorp",
          "match": "\\b_\\b"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.blorp",
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
