<idea-plugin>
    <id>com.blorp.lang</id>
    <name>Blorp</name>
    <vendor>blorp</vendor>
    <description>Blorp language support: the file type, plus colours and diagnostics from the blorp lsp server.</description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.redhat.devtools.lsp4ij</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType
            name="Blorp"
            language="Blorp"
            implementationClass="com.blorp.intellij.BlorpFileType"
            fieldName="INSTANCE"
            extensions="brp"/>
        <lang.parserDefinition
            language="Blorp"
            implementationClass="com.blorp.intellij.BlorpParserDefinition"/>
        <notificationGroup id="Blorp" displayType="BALLOON"/>
        <projectConfigurable
            parentId="language"
            instance="com.blorp.intellij.BlorpConfigurable"
            id="com.blorp.intellij.BlorpConfigurable"
            displayName="Blorp"/>
    </extensions>

    <extensions defaultExtensionNs="com.redhat.devtools.lsp4ij">
        <server
            id="blorp"
            name="Blorp"
            factoryClass="com.blorp.intellij.BlorpLanguageServerFactory">
            <description><![CDATA[The Blorp language server: <code>blorp lsp</code>.]]></description>
        </server>
        <languageMapping language="Blorp" serverId="blorp" languageId="blorp"/>
        <semanticTokensColorsProvider
            serverId="blorp"
            class="com.blorp.intellij.BlorpSemanticTokensColors"/>
    </extensions>
</idea-plugin>
