<idea-plugin>
    <id>com.blorp.lang</id>
    <name>Blorp</name>
    <version>0.0.1</version>
    <vendor>blorp</vendor>
    <description>Language support for the Blorp programming language: syntax highlighting, diagnostics, hover, completion, and definition via LSP.</description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.textmate</depends>
    <depends optional="true" config-file="lsp.xml">com.intellij.modules.lsp</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType
            name="Blorp"
            language="Blorp"
            implementationClass="com.blorp.intellij.BlorpFileType"
            fieldName="INSTANCE"
            extensions="brp"/>
        <lang.parserDefinition
            language="Blorp"
            implementationClass="com.blorp.intellij.BlorpParserDefinition"/>
        <lang.syntaxHighlighterFactory
            language="Blorp"
            implementationClass="com.blorp.intellij.BlorpSyntaxHighlighterFactory"/>
        <editorHighlighterProvider
            filetype="Blorp"
            implementationClass="com.blorp.intellij.BlorpEditorHighlighterProvider"/>
        <textmate.bundleProvider
            implementation="com.blorp.intellij.BlorpTextMateBundleProvider"/>
        <projectService
            serviceImplementation="com.blorp.intellij.BlorpSettings"/>
        <projectConfigurable
            parentId="language"
            instance="com.blorp.intellij.BlorpConfigurable"
            id="com.blorp.intellij.BlorpConfigurable"
            displayName="Blorp"/>
    </extensions>
</idea-plugin>
