<idea-plugin>
    <id>com.blorp.lang</id>
    <name>Blorp</name>
    <vendor>blorp</vendor>
    <description>Blorp language support: the file type, plus colours and diagnostics from the blorp lsp server.</description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lsp</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType
            name="Blorp"
            language="Blorp"
            implementationClass="com.blorp.intellij.BlorpFileType"
            fieldName="INSTANCE"
            extensions="brp"/>
        <lang.parserDefinition
            language="Blorp"
            implementationClass="com.blorp.intellij.BlorpParserDefinition"/>
        <notificationGroup id="Blorp" displayType="BALLOON"/>
        <platform.lsp.integrationProvider
            implementation="com.blorp.intellij.BlorpLspIntegrationProvider"/>
        <gotoDeclarationHandler implementation="com.blorp.intellij.BlorpGotoDeclarationHandler"/>
        <projectConfigurable
            parentId="language"
            instance="com.blorp.intellij.BlorpConfigurable"
            id="com.blorp.intellij.BlorpConfigurable"
            displayName="Blorp"/>
    </extensions>
</idea-plugin>
