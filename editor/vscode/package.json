{
  "name": "blorp-lang",
  "displayName": "Blorp",
  "description": "Language support for the Blorp programming language",
  "version": "0.0.1",
  "publisher": "blorp",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": ["Programming Languages"],
  "activationEvents": [
    "onLanguage:blorp"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "blorp",
        "aliases": ["Blorp", "blorp"],
        "extensions": [".brp"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "blorp",
        "scopeName": "source.blorp",
        "path": "./syntaxes/blorp.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Blorp",
      "properties": {
        "blorp.serverPath": {
          "type": "string",
          "default": "blorp",
          "description": "Path to the blorp executable"
        }
      }
    }
  },
  "devDependencies": {
    "@vscode/test-electron": "^2.4.1",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.0"
  },
  "scripts": {
    "compile": "tsc -p .",
    "compile:test": "tsc -p tsconfig.test.json",
    "test:e2e": "npm run compile && npm run compile:test && node ./out-test/test/runTest.js",
    "watch": "tsc -watch -p ."
  }
}
