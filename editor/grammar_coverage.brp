-- Grammar coverage fixture for the editor tmLanguage grammar.
--
-- This file exercises every syntactic construct the editor grammar is
-- expected to highlight. It is not a runtime test — it is a contract:
-- every feature here must be represented by a rule in
-- editor/{intellij,vscode}/.../blorp.tmLanguage.json.
--
-- Verify the file parses and typechecks cleanly:
-- ./blorp check --no-format editor/grammar_coverage.brp
--
-- When adding new syntax to the language, extend this file first, then
-- update the grammar until every token is styled.
import:
	channel: Channel
	debug as dbg
	dict: Dict, dict as dict_new
	fs: IOError, open_read
	list: filter, map
	option as O


-- ============================================================================
-- Visibility and declarations
-- ============================================================================
private func private_helper(x: Int) -> Int:
	x + 1


private pure func private_pure_helper(x: Int) -> Int:
	x * 2


private record InternalState {
	value: Int
}


private union InternalResult:
	InternalOk(Int)
	InternalErr(String)


-- ============================================================================
-- Types: union, enum, record, struct, type alias
-- ============================================================================
union Shape:
	Circle(Float)
	Rectangle(Float, Float)


enum Direction:
	North
	South
	East
	West


record Point[T] {
	x: T,
	y: T
}


struct Color {
	r: UInt8,
	g: UInt8,
	b: UInt8,
	a: UInt8
}


type alias Pair[T] = (T, T)

type alias Callback = (Int) -> Bool


-- ============================================================================
-- Traits and impls
-- ============================================================================
trait Describable:
	pure func describe(self: Self) -> String


implements Describable for Direction:
	pure func describe(self: Direction) -> String:
		match self:
			North: "north"
			South: "south"
			East | West: "east or west"


-- ============================================================================
-- Foreign functions
-- ============================================================================
foreign:
	pure func c_abs(x: Int) -> Int = "abs"


-- ============================================================================
-- Numeric literals and dim params
-- ============================================================================
pure func numerics() -> Float:
	a: Int = 42
	b: Float = 3.14
	to_float(a) + b


pure func dim_arith[T, #M, #N](a: T[#M], b: T[#N]) -> Int:
	length(a) + length(b)


-- ============================================================================
-- Strings: plain, multiline, raw, interpolation
-- ============================================================================
pure func strings(name: String) -> String:
	plain: String = "hello\nworld"
	raw: String = raw"C:\Users\name\Documents"
	multiline: String =
		|line one
		|line two "with quotes" here
	raw_multiline: String = raw
		|C:\Users\name
		|\d+\.\d+
	interp: String = "Hello, ${name}! Count is ${1 + 2}"
	plain + raw + multiline + raw_multiline + interp


-- ============================================================================
-- Control flow and operators
-- ============================================================================
func control_flow(items: List[Int]) -> Int:
	var total: Int = 0
	for i in 0..items.length():
		match items.get(i):
			Some(n):
				if n > 100:
					break
				else if n < 0:
					continue
				total += n
			None: void
	var guard: Int = 0
	while guard < 10 and total > 0:
		guard += 1
		total -= 1
		guard /= 1
	debug:
		dbg.log("control flow")
	total


-- Logical operators: and, or, not
---
Return a compound boolean expression.

doctests:
    :: Both true
    logic(True, True) == True
---
pure func logic(a: Bool, b: Bool) -> Bool:
	a and b or not a


-- Question-bind propagation (Option)
pure func question_bind_demo(xs: List[Int]) -> Option[Int]:
	a: Int ?= xs.get(0)
	b ?= xs.get(1)
	Some(a + b)


-- ============================================================================
-- Expressions: lambdas, dict literal, tuple, list, range
-- ============================================================================
func expressions() -> Int:
	filtered: List[Int] = filter(
		[1, 2, 3],
		func(x): x > 1,
	)
	doubled: List[Int] = map(filtered, func(x): x * 2)
	scores: Dict[String, Int] = {"alice" => 95, "bob" => 87}
	empty_scores: Dict[String, Int] = dict_new()
	pair: (Int, String) = (42, "answer")
	maybe: Option[Int] = O.Some(pair[0])
	_ = doubled
	_ = scores
	_ = empty_scores
	_ = maybe
	pair[0]


-- ============================================================================
-- Generics, bounds, @tail_recursive annotation
-- ============================================================================
@tail_recursive
pure func factorial(n: Int, acc: Int) -> Int:
	if n <= 1:
		acc
	else:
		factorial(n - 1, n * acc)


pure func max_val[T:Orderable](a: T, b: T) -> T:
	if a > b:
		a
	else:
		b


-- ============================================================================
-- Concurrency: concurrent, detach
-- ============================================================================
func concurrency(xs: List[Int]) -> Int:
	concurrent:
		a = sum_list(xs)
		b = sum_list(xs)
	detach print_side_effect()
	for n in xs concurrently(limit: 2):
		print(n)
	match a:
		Ok(av):
			match b:
				Ok(bv): av + bv
				Err(_): 0
		Err(_): 0


func sum_list(xs: List[Int]) -> Int:
	var total: Int = 0
	for n in xs:
		total += n
	total


func print_side_effect() -> Void:
	print("side effect")


-- ============================================================================
-- Resource scopes and channel selection
-- ============================================================================
func with_file_demo(path: String) -> Result[Int, IOError]:
	with reader ?= open_read(path):
		Ok(1)


func select_demo(ch: Channel[Int]) -> Int:
	var chosen: Int = 0
	select:
		value from ch:
			chosen = value
		_ after 1:
			chosen = 0
	chosen


-- ============================================================================
-- Pattern matching: wildcards, or-patterns, list patterns, literals
-- ============================================================================
pure func patterns(xs: List[Int]) -> Int:
	match xs:
		[]: 0
		[only]: only
		[first, ...rest]: first + sum_rest(rest)


pure func sum_rest(xs: List[Int]) -> Int:
	var total: Int = 0
	for n in xs:
		total += n
	total


pure func match_literals(n: Int) -> String:
	match n:
		0: "zero"
		1 | 2 | 3: "small"
		_: "other"


-- ============================================================================
-- Entry point
-- ============================================================================
func main(args: List[String]) -> Int:
	_ = numerics()
	_ = strings("world")
	_ = control_flow([1, 2, 3])
	_ = logic(True, False)
	_ = question_bind_demo([10, 20])
	_ = expressions()
	_ = factorial(5, 1)
	_ = max_val(3, 7)
	_ = concurrency([1, 2, 3])
	_ = patterns([1, 2, 3])
	_ = match_literals(2)
	0
