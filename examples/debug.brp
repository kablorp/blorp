import:
	debug: debug_string, info, is_heap, log, type_name


pure func adjusted_score(scores: List[Int], bonus: Int) -> Int:
	base = scores.fold_left(0, pure func(total: Int, score: Int): total + score)
	result = base + bonus
	debug:
		info("adjusted_score")
		log("scores=${debug_string(scores)}")
		log("base=${debug_string(base)}")
		log("result type=${type_name(result)}")
		log("scores stored on heap=${is_heap(scores).to_string()}")
	result


func main(args: List[String]):
	score = adjusted_score(
		[10, 20, 30],
		5,
	)
	print("score=" + score.to_string())
