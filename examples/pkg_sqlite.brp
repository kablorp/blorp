import:
	list as L
	pkg/sqlite as DB


func print_rows(rows: List[List[String]]) -> Void:
	for row in rows:
		print(row.join(" | "))


func main(args: List[String]) -> Int:
	match DB.open(":memory:"):
		Ok(db):
			var exit_code: Int = 0
			match DB.execute(db, "CREATE TABLE notes (id INTEGER, body TEXT)"):
				Ok(_): void
				Err(e):
					print("create failed: " + e)
					exit_code = 1
			match DB.execute_params(db, "INSERT INTO notes VALUES (?, ?)", ["1", "hello sqlite"]):
				Ok(_): void
				Err(e):
					print("insert failed: " + e)
					exit_code = 1
			match DB.columns(db, "SELECT id, body FROM notes"):
				Ok(cols): print("columns: " + cols.join(", "))
				Err(e):
					print("columns failed: " + e)
					exit_code = 1
			match DB.query_params(db, "SELECT id, body FROM notes WHERE id = ?", ["1"]):
				Ok(rows):
					row_count: String = L
						.length(rows)
						.to_string()
					print("rows: " + row_count)
					print_rows(rows)
				Err(e):
					print("query failed: " + e)
					exit_code = 1
			DB.close(db)
			exit_code
		Err(e):
			print("open failed: " + e)
			1
