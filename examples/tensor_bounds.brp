pure func back_plane_total(cube: Int[#2, #2, #2]) -> Int:
	-- Single-index access peels one dimension from a higher-rank tensor.
	plane: Int[#2, #2] = cube[1]
	plane[0, 0] + plane[0, 1] + plane[1, 0] + plane[1, 1]


func main(args: List[String]) -> Void:
	cube: Int[#2, #2, #2] = {
		{
			{1, 2},
			{3, 4},
		},
		{
			{5, 6},
			{7, 8},
		},
	}
	print("back plane total: ${back_plane_total(cube)}")
