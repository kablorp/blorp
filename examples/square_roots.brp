import:
	float: sqrt


pure func generate_numbers(low: Int, high: Int) -> List[Float]:
	-- var means we can mutate in this scope
	var nums: List[Float] = []

	for i in low..high:
		nums = nums.append(i.to_float())

	nums


pure func sum_square_roots(nums: List[Float]) -> Float:
	-- we can run pure functions in parallel and be certain they won't alter the global state
	roots: List[Float] = nums.parallel(pure func(items: ParallelList[Float]):
		items.map(sqrt)
	)
	roots.sum()


func main(args: List[String]):
	generate_numbers(1, 1000)
		.sum_square_roots()
		.print()
