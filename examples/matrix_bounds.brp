pure func diagonal_total(grid: Int[#2, #2]) -> Int:
	grid[0, 0] + grid[1, 1]


pure func second_row_total(grid: Int[#2, #2]) -> Int:
	row: Int[#2] = grid[1]
	row[0] + row[1]


func main(args: List[String]) -> Void:
	grid: Int[#2, #2] = {
		{1, 2},
		{3, 4},
	}
	print("diagonal total: ${diagonal_total(grid)}")
	print("second row total: ${second_row_total(grid)}")
