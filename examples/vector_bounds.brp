pure func at[#N](items: Int[#N], i: ..#N) -> Int:
	items[i]


pure func first_score(scores: Int[#3]) -> Int:
	-- scores[3] would be rejected at compile time.
	scores[0]


func main(args: List[String]) -> Void:
	scores: Int[#3] = {10, 20, 30}
	print("first score: ${first_score(scores)}")
	print("last score: ${at(scores, 2)}")
