import:
	bytes as B
	net/http: Header
	pkg/net/dns as DNS
	pkg/net/http_client as HTTP
	pkg/net/smtp as SMTP
	pkg/net/websocket as WS


func network_enabled(args: List[String]) -> Bool:
	match args.get(1):
		Some(flag): flag == "--network"
		None: False


func websocket_mask_preview() -> String:
	var mask: Bytes = B.bytes(4)
	mask = mask.set_index(0, 1)
	mask = mask.set_index(1, 2)
	mask = mask.set_index(2, 3)
	mask = mask.set_index(3, 4)
	masked: Bytes = WS.apply_mask("ping".to_bytes(), mask)
	B.to_hex(masked)


func main(args: List[String]) -> Int:
	message: String = SMTP.build_message(
		"noreply@example.com",
		"dev@example.com",
		"pkg smtp preview",
		"hello from pkg/net/smtp",
		"text/plain",
	)
	message_len: String = message
		.length()
		.to_string()
	print("smtp message bytes: " + message_len)
	print("masked websocket payload: " + websocket_mask_preview())
	if network_enabled(args):
		match DNS.resolve("localhost"):
			Ok(addresses): print("localhost addresses: " + addresses.join(", "))
			Err(e): print("dns error: " + DNS.message(e))
		agent: Header = {
			name = "User-Agent",
			value = "blorp-pkg-example"
		}
		match HTTP.request("GET", "http://example.com/", [agent], None):
			Ok(resp): print("http status: " + resp.status_code.to_string())
			Err(e): print("http error: " + e)
	else:
		print("pass --network to try DNS and HTTP requests")
	0
