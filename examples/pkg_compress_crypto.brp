import:
	bytes as B
	pkg/compress as Compress
	pkg/crypto as Crypto


func report_roundtrip(label: String, original: Bytes, compressed: Bytes) -> Void:
	original_len: String = original
		.length()
		.to_string()
	compressed_len: String = compressed
		.length()
		.to_string()
	print(label + ": " + original_len + " bytes -> " + compressed_len + " bytes")


func main(args: List[String]) -> Int:
	message: String = "package examples should be small, readable, and runnable"
	data: Bytes = message.to_bytes()
	var exit_code: Int = 0

	match Compress.gzip(data):
		Ok(gz):
			report_roundtrip("gzip", data, gz)

			match Compress.gunzip(gz):
				Ok(decoded):
					print("gunzip: " + B.to_string(decoded))
				Err(e):
					print("gunzip error: " + e)
					exit_code = 1
		Err(e):
			print("gzip error: " + e)
			exit_code = 1

	key: Bytes = Crypto.derive_key(
		"correct horse battery staple",
		"pkg example salt".to_bytes(),
		1000,
	)
	key_len: String = key
		.length()
		.to_string()
	print("derived key bytes: " + key_len)

	match Crypto.encrypt(data, key):
		Ok(ciphertext):
			ciphertext_len: String = ciphertext
				.length()
				.to_string()
			print("ciphertext bytes: " + ciphertext_len)

			match Crypto.decrypt(ciphertext, key):
				Ok(plaintext):
					print("decrypt: " + B.to_string(plaintext))
				Err(e):
					print("decrypt error: " + e)
					exit_code = 1
		Err(e):
			print("encrypt error: " + e)
			exit_code = 1

	exit_code
