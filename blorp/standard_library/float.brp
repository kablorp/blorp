-- Float is owned by _base.brp. Arithmetic, comparison, classification, sign copying
-- and formatting are concrete Float64 operations.
-- Zero divisors return positive zero under the pilot's parent arithmetic principle;
-- this deliberately differs from the referenced upstream IEEE behavior.
import:
    _base:
        Float,
        String,
        Bool(True, False),
        Orderable,
        Addable,
        Subtractable,
        Multipliable,
        Divisible,
        Modulable,
        Negatable,
    traits: Equatable


implements Addable for Float:
    pure func add(left: Self, right: Self) -> Self:
        builtin("float.add")


implements Subtractable for Float:
    pure func subtract(left: Self, right: Self) -> Self:
        builtin("float.subtract")


implements Multipliable for Float:
    pure func multiply(left: Self, right: Self) -> Self:
        builtin("float.multiply")


implements Divisible for Float:
    pure func divide(left: Self, right: Self) -> Self:
        builtin("float.divide")


implements Modulable for Float:
    pure func remainder(left: Self, right: Self) -> Self:
        builtin("float.remainder")


-- Multiplying by -1.0 is exact and flips the sign of zero, which subtracting
-- from 0.0 would not.
implements Negatable for Float:
    pure func negate(value: Self) -> Self:
        value.multiply(-1.0)


pure func to_string(value: Float) -> String:
    builtin("float.to_string")


pure func copysign(value: Float, sign: Float) -> Float:
    builtin("float.copysign")


implements Equatable for Float:
    pure func equals(left: Self, right: Self) -> Bool:
        builtin("float.equals")


-- Every comparison with NaN is false, so the non-strict members also ask equals
-- instead of negating the opposite strict comparison.
implements Orderable for Float:
    pure func less_than(left: Self, right: Self) -> Bool:
        builtin("float.less_than")
    pure func less_than_or_equal(left: Self, right: Self) -> Bool:
        match left.less_than(right):
            True: True
            False: left.equals(right)
    pure func greater_than_or_equal(left: Self, right: Self) -> Bool:
        match right.less_than(left):
            True: True
            False: left.equals(right)


pure func is_nan(value: Float) -> Bool:
    match value.equals(value):
        True: False
        False: True


pure func is_finite(value: Float) -> Bool:
    -- Finite self-subtraction is zero; infinity and NaN produce NaN.
    value
        .subtract(value)
        .equals(0.0)


pure func abs(value: Float) -> Float:
    match value.less_than(0.0):
        True: value.copysign(1.0)
        False: value
