-- The filesystem library. A native reports a failure as an Int code, and the
-- shared internal decoder supplies io.IOErrorKind; this module names the caller's path.
import:
    _base: Int, String, Void, List, Bool(True, False), Option(Some, None), Result(Ok, Err)
    _io_errors: decode_error
    bool: Bool methods
    int: Int methods
    io: IOError, IOErrorKind(NotFound)
    list: List methods
    option: Option methods
    result: Result methods
    string: String methods


-- What a path names without following a link.
fixed union EntryKind:
    File
    Directory
    Symlink
    Other


-- One entry of a directory: its name, and its own kind, so a link is Symlink
-- whatever it points at.
record Entry { name: String, kind: EntryKind }


-- The entry codes of FS_HELPERS_RUNTIME's second enum.
private ABSENT_ENTRY_CODE: Int = 0
private FILE_ENTRY_CODE: Int = 1
private DIRECTORY_ENTRY_CODE: Int = 2
private SYMLINK_ENTRY_CODE: Int = 3


-- Every code that is not a named kind is Other, because the C side sends
-- Other for each remaining st_mode type.
private pure func decode_entry_kind(code: Int) -> Option[EntryKind]:
    if code == ABSENT_ENTRY_CODE:
        None
    else if code == FILE_ENTRY_CODE:
        Some(File)
    else if code == DIRECTORY_ENTRY_CODE:
        Some(Directory)
    else if code == SYMLINK_ENTRY_CODE:
        Some(Symlink)
    else:
        Some(Other)


private pure func error_at(code: Int, path: String) -> IOError:
    { path = path, destination = None, kind = code.decode_error() }


private pure func at_path[T](result: Result[T, Int], path: String) -> Result[T, IOError]:
    match result:
        Ok(value): Ok(value)
        Err(code): Err(code.error_at(path))


-- A two-path operation reports both paths the caller passed.
private pure func between_paths[T](
    result: Result[T, Int],
    source: String,
    destination: String,
) -> Result[T, IOError]:
    match result:
        Ok(value):
            Ok(value)
        Err(code):
            Err({ path = source, destination = Some(destination), kind = code.decode_error() })


-- Each listing element is one entry code byte followed by the name (D17). A
-- mismatch between the two sides stays visible: an unknown code is Other, and
-- an element with no byte at all becomes an entry named by the whole element,
-- of kind Other. ABSENT_ENTRY_CODE is never sent for an entry, so it too reads
-- as Other. Every code is below 0x80, so the name starts on a character
-- boundary; the slice fallback only keeps a malformed element visible.
private ENTRY_CODE_BYTES: Int = 1


private pure func decoded_entry(element: String) -> Entry:
    match element.byte_at(0):
        Some(code):
            {
                name = element
                    .slice(ENTRY_CODE_BYTES, element.length())
                    .get_or(element),
                kind = code
                    .decode_entry_kind()
                    .get_or(Other),
            }
        None:
            { name = element, kind = Other }


private func native_read_text(path: String) -> Result[String, Int]:
    builtin("fs.read_text")


private func native_write_text(path: String, text: String) -> Result[Void, Int]:
    builtin("fs.write_text")


private func native_entry_kind(path: String) -> Result[Int, Int]:
    builtin("fs.entry_kind")


private func native_list_directory(path: String) -> Result[List[String], Int]:
    builtin("fs.list_directory")


private func native_create_directory(path: String) -> Result[Void, Int]:
    builtin("fs.create_directory")


private func native_create_directories(path: String) -> Result[Void, Int]:
    builtin("fs.create_directories")


private func native_remove_file(path: String) -> Result[Void, Int]:
    builtin("fs.remove_file")


private func native_remove_directory(path: String) -> Result[Void, Int]:
    builtin("fs.remove_directory")


private func native_remove_directory_tree(path: String) -> Result[Void, Int]:
    builtin("fs.remove_directory_tree")


private func native_rename(source: String, destination: String) -> Result[Void, Int]:
    builtin("fs.rename")


private func native_create_temporary_directory(
    parent: String,
    prefix: String,
) -> Result[String, Int]:
    builtin("fs.create_temporary_directory")


-- Private: no code outside this file can name or hold one, so no caller can
-- close one twice, read one after it is closed, or share its file offset.
private opaque type Descriptor = Int


private func native_open_read(path: String) -> Result[Int, Int]:
    builtin("fs.open_read")


private func native_next_lines(descriptor: Int, carried: String) -> Result[List[String], Int]:
    builtin("fs.next_lines")


private func native_close(descriptor: Int) -> Result[Void, Int]:
    builtin("fs.close")


-- The common idiom: a missing file means a default. Any other failure stays.
pure func default_if_not_found[T](result: Result[T, IOError], fallback: T) -> Result[T, IOError]:
    match result:
        Ok(value):
            Ok(value)
        Err(error):
            match error.kind:
                NotFound: Ok(fallback)
                _: Err(error)


-- Reads to end of file, so a file that changes size is read as it is, then
-- validates UTF-8. A directory is IsADirectory. A FIFO blocks until its writer
-- closes. There is no size limit: a file or device that never ends, such as
-- /dev/zero, exhausts memory and the allocation aborts.
func read_text(path: String) -> Result[String, IOError]:
    path
        .native_read_text()
        .at_path(path)


-- Replaces the file atomically: readers see the old contents or the new, never
-- a mix, even after a crash. A symlink is written through and stays a link; a
-- dangling link is NotFound and creates nothing. A new file gets mode 0666
-- narrowed by the umask, and a replaced file keeps its mode and, where the
-- operating system permits, its owner and group, or its group alone. An Err
-- before the rename leaves the target unchanged; an Err after it (only the
-- directory flush can fail there) means the target holds the old contents or
-- the new. A path ending in `/` names a directory, which is never written: it
-- is IsADirectory when it names one or a link to one, NotADirectory when it
-- names anything else, and NotFound when nothing is there; any other failure to look
-- it up is reported as for any path.
--
-- Limits: a hard link to the old file keeps the old contents; extended
-- attributes and ACLs are not copied; a link re-pointed between resolving it
-- and the rename is not detected. The new file is created beside the target,
-- so a writable file in a directory this process cannot write is
-- PermissionDenied, and a crash can leave a hidden `.blorp-tmp-*` file there.
-- A busy executable (ETXTBSY) or a bind-mounted target (EBUSY) is OtherOs. A
-- directory without read permission gives an Err after a rename that
-- succeeded. Writing past the file-size limit (RLIMIT_FSIZE) raises SIGXFSZ,
-- which ends the process unless the program ignores that signal; a library
-- does not change signal dispositions.
func write_text(path: String, text: String) -> Result[Void, IOError]:
    path
        .native_write_text(text)
        .at_path(path)


-- lstat: a link is not followed, so a symlink is Symlink even when dangling.
-- ENOENT, and ENOTDIR from a file used as a directory, give Ok(None).
func entry_kind(path: String) -> Result[Option[EntryKind], IOError]:
    code ?= path
        .native_entry_kind()
        .at_path(path)
    Ok(code.decode_entry_kind())


-- Lists a directory, sorted by name bytes, so the order does not depend on the
-- file system. `.` and `..` are omitted. A link given as the path is followed
-- and its target is listed, while each entry's kind is its own: a link in the
-- listing is Symlink, not followed. A name that is not valid UTF-8 fails the
-- whole listing with InvalidUtf8, since a String cannot hold it (D8). An entry
-- removed while the directory is read is left out. ELOOP, ENAMETOOLONG and
-- EMFILE are OtherOs.
func list_directory(path: String) -> Result[List[Entry], IOError]:
    elements ?= path
        .native_list_directory()
        .at_path(path)
    Ok(elements.map(decoded_entry))


-- Creates one directory whose parent exists. A path that already exists, of any
-- kind, is AlreadyExists; a missing parent is NotFound. A trailing slash is
-- accepted: `missing/` creates `missing`. `file/` for an existing file is
-- NotADirectory on macOS and AlreadyExists on Linux. ELOOP and ENAMETOOLONG are
-- OtherOs.
func create_directory(path: String) -> Result[Void, IOError]:
    path
        .native_create_directory()
        .at_path(path)


-- Creates each missing directory along the path. It succeeds when the path is
-- already a directory, or a link to one, and `/` succeeds. The empty path is
-- NotFound. A file where a directory is needed is NotADirectory; a file, or a
-- dangling link, at the end is AlreadyExists. Another process creating a
-- component first is no failure. Every failure is reported against the path
-- the caller passed, not the component that failed (D14).
func create_directories(path: String) -> Result[Void, IOError]:
    path
        .native_create_directories()
        .at_path(path)


-- Removes a file or a link, never what the link names. A directory is
-- IsADirectory on both platforms. EBUSY is OtherOs.
func remove_file(path: String) -> Result[Void, IOError]:
    path
        .native_remove_file()
        .at_path(path)


-- Removes an empty directory. One with entries is DirectoryNotEmpty, whether
-- the operating system says EEXIST or ENOTEMPTY. EINVAL (the path `.`) and EBUSY
-- are OtherOs.
func remove_directory(path: String) -> Result[Void, IOError]:
    path
        .native_remove_directory()
        .at_path(path)


-- Removes a directory and everything in it, never through a link and never
-- past the device it starts on.
--
-- * Only a real directory is a root: a file or a link, even to a directory, is
--   NotADirectory, and trailing slashes are stripped first (D20).
-- * A final `.` or `..` is OtherOs, refused before any system call (D21).
-- * A missing path is NotFound, although Go returns success (D9).
-- * A mount point inside the tree, a root that is a mount point, and `/` are
--   all CrossesDevices (D22). A bind mount of the same file system has the
--   same device, so it is entered and emptied, as `rm -rf` does.
-- * ChangedDuringRemoval means another process moved a directory while the walk
--   was inside it.
-- * The first failure stops the walk, and what it removed stays removed.
-- * An empty root that cannot be searched (mode 0400) is PermissionDenied,
--   because the mount-point check opens the root's `..`, where `rm -rf`
--   succeeds. A child that cannot be opened (mode 000) is removed only when it
--   is empty, and is otherwise PermissionDenied, since the walk cannot see
--   inside it.
func remove_directory_tree(path: String) -> Result[Void, IOError]:
    path
        .native_remove_directory_tree()
        .at_path(path)


-- Renames a file or directory. It replaces an existing file, or an empty
-- directory, at the destination; a destination directory with entries is
-- DirectoryNotEmpty. Both paths are in the error. A different device is
-- CrossesDevices. EINVAL (a directory moved into itself), EBUSY, ELOOP and
-- ENAMETOOLONG are OtherOs.
func rename(source: String, destination: String) -> Result[Void, IOError]:
    source
        .native_rename(destination)
        .between_paths(source, destination)


-- Makes a fresh, empty directory directly in `parent` (mode 0700, a name no
-- other process can predict), runs `body` with its path, and removes the
-- directory and everything in it before returning. `prefix` starts the name; a
-- `/` in it is OtherOs, and macOS replaces every trailing `X` of a prefix.
-- `io_error` turns this library's own failures into the body's error type E;
-- a program that keeps IOError passes `pure func(error: IOError) -> IOError: error`.
--
-- The result, in order of priority: the body's Err; otherwise the removal's
-- Err; otherwise the body's Ok. So a body Err hides a failed removal: the
-- directory may be left behind with nothing said. A failure to create the
-- directory names `parent`. A failure to remove it names the directory itself,
-- the one exception to the rule that an IOError carries the caller's path
-- (D34), because the body was given that path and nothing else says what was
-- left behind. A body that removes its own directory makes the removal NotFound.
--
-- Removal runs on every path the program controls, since Blorp has no return or
-- exception that could skip it. A signal, `abort()` or a stack overflow can
-- still leave the directory.
func with_temporary_directory[T, E](
    parent: String,
    prefix: String,
    body: (String) -> Result[T, E],
    io_error: pure (IOError) -> E,
) -> Result[T, E]:
    directory ?= parent
        .native_create_temporary_directory(prefix)
        .at_path(parent)
        .map_err(io_error)
    outcome = body(directory)
    removed = directory.remove_directory_tree()
    value ?= outcome
    _ ?= removed.map_err(io_error)
    Ok(value)


-- The only place a descriptor is opened and closed. Once the open succeeds,
-- nothing can leave before the close: Blorp has no return or exception, and
-- `use` cannot run this function's `?=`. A failed close is ignored (D38): the
-- descriptor was only read, so nothing is lost.
private func with_descriptor[T, E](
    path: String,
    use: (Descriptor) -> Result[T, E],
    io_error: pure (IOError) -> E,
) -> Result[T, E]:
    opened ?= path
        .native_open_read()
        .at_path(path)
        .map_err(io_error)
    outcome = use(into_opaque Descriptor(opened))
    -- Bound because only a Void call can stand alone as a statement.
    closed = native_close(opened)
    outcome


-- How many of a batch's elements are complete lines (D37): with two or more,
-- every element but the last, which is the line still unfinished; with fewer,
-- the file has ended, and the one element, if any, is its last line.
private pure func complete_lines(batch_length: Int) -> Int:
    if batch_length > 1:
        batch_length - 1
    else:
        batch_length


private func fold_descriptor[T, E](
    descriptor: Descriptor,
    path: String,
    initial: T,
    step: (T, String) -> Result[T, E],
    io_error: pure (IOError) -> E,
) -> Result[T, E]:
    var folded: Result[T, E] = Ok(initial)
    var carried = ""
    var reading: Bool = True
    while reading:
        match native_next_lines(from_opaque Descriptor(descriptor), carried):
            Ok(batch):
                batch_length = batch.length()
                -- At end of file the last element is the last line, and the
                -- loop ends before `carried` is read again.
                carried = batch
                    .last()
                    .get_or("")
                for line in batch.take(batch_length.complete_lines()):
                    match folded:
                        Ok(state): folded = step(state, line)
                        Err(_): break
                -- A step's Err stops the reading here; the break only skips the
                -- rest of this batch, and another read could replace that Err.
                -- Two or more elements mean the file has not ended (D37).
                reading = folded
                    .is_ok()
                    .and(batch_length > 1)
            Err(code):
                folded = Err(io_error(code.error_at(path)))
                reading = False
    folded


-- Folds `step` over the file's lines in order, a block at a time, so memory
-- follows the longest line, never the file. A line ends at LF, and a CR just
-- before the LF is removed; a last line without LF counts, and an empty file
-- has no lines. The file is opened as read_text opens it, and is closed before
-- fold_lines returns on every path the program controls.
--
-- The first Err from `step` stops reading and is the result, so a fold that
-- needs only the start of a file reads only that much. A failure to open or
-- read is the result, converted by `io_error` as in with_temporary_directory.
-- A line that is not UTF-8 is InvalidUtf8, and a directory is IsADirectory. A
-- failed read returns none of its block's lines, but the steps already taken
-- stay taken: an impure `step` that printed has printed. A FIFO blocks until a
-- line arrives or its writer closes.
--
-- `step` borrows its accumulator, so appending to a List in `step` copies that
-- List on every line, which is quadratic overall. To collect every line, read
-- the file with read_text.
func fold_lines[T, E](
    path: String,
    initial: T,
    step: (T, String) -> Result[T, E],
    io_error: pure (IOError) -> E,
) -> Result[T, E]:
    path.with_descriptor(
        func(descriptor: Descriptor) -> Result[T, E]: descriptor.fold_descriptor(
            path,
            initial,
            step,
            io_error,
        ),
        io_error,
    )
