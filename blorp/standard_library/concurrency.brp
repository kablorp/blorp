-- Pure work on the thread pool. A program imports `parallel_map`; check
-- rewrites each `concurrent:` block into calls of the private `join` and
-- `run`, and the loader reads this module for a program that uses a block,
-- even when nothing imports it.
import:
    _base: List


-- Runs both tasks, possibly at once on the thread pool, and returns both
-- results.
private pure func join[A, B](left: pure () -> A, right: pure () -> B) -> (A, B):
    builtin("concurrency.join")


-- Applies `transform` to each value, possibly at once on the thread pool,
-- and returns the results in the order of `values`.
pure func parallel_map[A, B](values: List[A], transform: pure (A) -> B) -> List[B]:
    builtin("concurrency.parallel_map")


-- Runs a block's one task in place, since it has nothing to run beside it.
private pure func run[A](task: pure () -> A) -> A:
    task()
