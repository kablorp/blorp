-- Immutable owned Lists; these wrappers preserve ordinary source call identity.
import:
    _base: Int, List, String, Bool(True, False), Option(Some, None), Orderable
    int: Int methods
    string: String methods
    traits: Equatable


pure func repeat[T](element: T, count: Int) -> List[T]:
    builtin("list.repeat")


pure func length[T](values: List[T]) -> Int:
    builtin("list.length")


pure func get[T](values: List[T], index: Int) -> Option[T]:
    builtin("list.get")


pure func append[T](values: List[T], value: T) -> List[T]:
    builtin("list.append")


pure func set[T](values: List[T], index: Int, value: T) -> List[T]:
    builtin("list.set")


pure func concat[T](left: List[T], right: List[T]) -> List[T]:
    builtin("list.concat")


pure func set_index[T](values: List[T], index: Int, value: T) -> Option[List[T]]:
    match values.get(index):
        Some(_): Some(values.set(index, value))
        None: None


pure func contains[Element: Equatable](values: List[Element], needle: Element) -> Bool:
    var found: Bool = False
    for element in values:
        if element == needle:
            found = True
            break
    found


implements Equatable for List[Element: Equatable]:
    pure func equals(left: Self, right: Self) -> Bool:
        count = left.length()
        match count.equals(right.length()):
            False: False
            True:
                var same: Bool = True
                for index in 0..count:
                    same = match left.get(index):
                        None: False
                        Some(element):
                            match right.get(index):
                                None: False
                                Some(other): element.equals(other)
                    match same:
                        False: break
                        True: void
                same


-- The first append to "" copies the shared literal; every later one extends the
-- dying accumulator in place.
pure func join(values: List[String], separator: String) -> String:
    var joined: String = ""
    var position = 0
    for value in values:
        if position > 0:
            joined = joined + separator
        joined = joined + value
        position = position + 1
    joined


pure func any[T](values: List[T], predicate: pure (T) -> Bool) -> Bool:
    var found: Bool = False
    for value in values:
        if predicate(value):
            found = True
            break
    found


pure func map[T, U](values: List[T], callback: pure (T) -> U) -> List[U]:
    var mapped: List[U] = []
    for value in values:
        mapped = mapped.append(callback(value))
    mapped


pure func filter[T](values: List[T], predicate: pure (T) -> Bool) -> List[T]:
    var kept: List[T] = []
    for value in values:
        if predicate(value):
            kept = kept.append(value)
    kept


pure func get_or[T](values: List[T], index: Int, default: T) -> T:
    match values.get(index):
        Some(value): value
        None: default


pure func is_empty[T](values: List[T]) -> Bool:
    values.length() == 0


pure func last[T](values: List[T]) -> Option[T]:
    values.get(values.length() - 1)


-- Private callers establish 0 <= start <= end <= length(values), so every
-- get succeeds and the None arm is unreachable.
private pure func copy_range[T](values: List[T], start: Int, end: Int) -> List[T]:
    var copied: List[T] = []
    for index in start..end:
        match values.get(index):
            Some(value): copied = copied.append(value)
            None: void
    copied


pure func take[T](values: List[T], count: Int) -> List[T]:
    values.copy_range(0, count.max(0).min(values.length()))


pure func remove[T](values: List[T], index: Int) -> Option[List[T]]:
    match index < 0:
        True: None
        False:
            size = values.length()
            match index < size:
                False: None
                True: Some(values.copy_range(0, index).concat(values.copy_range(index + 1, size)))


pure func drop[T](values: List[T], count: Int) -> List[T]:
    values.copy_range(count.max(0).min(values.length()), values.length())


-- Every index is below length(values), so the None arm is unreachable.
pure func reverse[T](values: List[T]) -> List[T]:
    count = values.length()
    var reversed: List[T] = []
    for offset in 1..(count + 1):
        match values.get(count - offset):
            Some(value): reversed = reversed.append(value)
            None: void
    reversed


pure func find[T](values: List[T], predicate: pure (T) -> Bool) -> Option[T]:
    var found: Option[T] = None
    for value in values:
        if predicate(value):
            found = Some(value)
            break
    found


pure func all[T](values: List[T], predicate: pure (T) -> Bool) -> Bool:
    var every: Bool = True
    for value in values:
        match predicate(value):
            True: void
            False:
                every = False
                break
    every


-- Whether the element at right sorts before the one at left. Equal keys keep
-- the left element first, which makes the sort stable. Callers pass indexes
-- below length(source), so the None arms are unreachable.
private pure func right_first[T, Key: Orderable](
    source: List[T],
    left: Int,
    right: Int,
    key: pure (T) -> Key,
) -> Bool:
    match source.get(left):
        None: False
        Some(left_value):
            match source.get(right):
                None: False
                Some(right_value): key(right_value) < key(left_value)


-- Merges the sorted runs source[start..middle] and source[middle..end] into the
-- same positions of target. target is the caller's dying buffer, so each set
-- writes it in place once it is uniquely owned. Every index read is below end,
-- so the None arm is unreachable.
private pure func merge_runs[T, Key: Orderable](
    source: List[T],
    target: List[T],
    start: Int,
    middle: Int,
    end: Int,
    key: pure (T) -> Key,
) -> List[T]:
    var merged = target
    var left = start
    var right = middle
    for position in start..end:
        -- The right run supplies the element when the left run is spent, never
        -- when the right run is spent, and otherwise only when strictly less.
        from_right: Bool = match right < end:
            False: False
            True:
                match left < middle:
                    False: True
                    True: source.right_first(left, right, key)
        index = match from_right:
            True: right
            False: left
        match source.get(index):
            Some(value): merged = merged.set(position, value)
            None: void
        match from_right:
            True: right = right + 1
            False: left = left + 1
    merged


-- Stable ascending sort by each element's Orderable key. Equal keys, those
-- where neither is less than the other, keep input order; key is pure and may
-- run more than once per element. A key order that is not total, such as Float
-- NaN, still yields a permutation of the input, in an unspecified order.
--
-- Bottom-up merge sort: each pass merges adjacent runs of width elements from
-- source into target, then the two buffers swap. Both start as values, so the
-- first write to each copies it while it is still shared; every later write
-- updates a uniquely owned buffer in place, and a sort allocates at most two
-- Lists whatever its length.
pure func sort_by[T, Key: Orderable](values: List[T], key: pure (T) -> Key) -> List[T]:
    count = values.length()
    var source = values
    var target = values
    var width = 1
    while width < count:
        var start = 0
        while start < count:
            middle = (start + width).min(count)
            end = (middle + width).min(count)
            target = source.merge_runs(target, start, middle, end, key)
            start = end
        written = target
        target = source
        source = written
        width = width * 2
    source
