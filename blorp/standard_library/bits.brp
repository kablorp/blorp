-- Bitwise operations on an Int's 64 two's-complement bits. They are named
-- functions, not operators, so that code reads as words; `bits: Int methods`
-- selects them as methods, as in `state.bit_xor(state.shift_right(30))`.
-- Every operand is defined: a shift by a count outside 0 to 63 gives 0, as
-- shifting every bit out would.
import:
    _base: Int


pure func bit_and(left: Int, right: Int) -> Int:
    builtin("int.bit_and")


pure func bit_or(left: Int, right: Int) -> Int:
    builtin("int.bit_or")


pure func bit_xor(left: Int, right: Int) -> Int:
    builtin("int.bit_xor")


-- Every bit flipped: -1 has every bit set, so this is a xor with it.
pure func bit_not(value: Int) -> Int:
    value.bit_xor(-1)


-- The bits moved toward the high end, zeros entering at the low end; a bit
-- moved past the top is lost, so `1.shift_left(63)` is INT_MIN.
pure func shift_left(value: Int, count: Int) -> Int:
    builtin("int.shift_left")


-- Logical: zeros enter at the high end whatever the sign, so
-- `(-1).shift_right(63)` is 1.
pure func shift_right(value: Int, count: Int) -> Int:
    builtin("int.shift_right")
