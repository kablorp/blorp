-- Float functions and the conversions between Int and Float, from C's math.h.
-- `math: Float methods` selects them as methods, as in `x.sqrt()`, and
-- `math: Int methods` gives `count.to_float()`.
--
-- They are here and not in float.brp because the pinned seed reads float.brp,
-- through the prelude, and rejects a builtin label it does not know. After the
-- seed knows these labels they can move into float.brp and the prelude.
--
-- sqrt, floor, ceil, round, trunc and both conversions are exact or correctly
-- rounded, so they agree on every platform. sin, cos, tan, atan2, exp, log and
-- pow are the platform libm's, which may differ in the last bit between macOS
-- and glibc.
import:
    _base: Int, Float


-- The Float nearest to the ratio of a circle's circumference to its diameter.
PI: Float = 3.141592653589793


-- NaN below zero, as IEEE 754 says; -0.0 is -0.0.
pure func sqrt(value: Float) -> Float:
    builtin("float.sqrt")


pure func floor(value: Float) -> Float:
    builtin("float.floor")


pure func ceil(value: Float) -> Float:
    builtin("float.ceil")


-- To the nearest whole number, with halves away from zero, as C's round:
-- 2.5 rounds to 3.0 and -2.5 to -3.0.
pure func round(value: Float) -> Float:
    builtin("float.round")


-- Toward zero.
pure func trunc(value: Float) -> Float:
    builtin("float.trunc")


-- In radians.
pure func sin(value: Float) -> Float:
    builtin("float.sin")


pure func cos(value: Float) -> Float:
    builtin("float.cos")


pure func tan(value: Float) -> Float:
    builtin("float.tan")


-- The angle of the point (x, y) from the positive x axis, in radians, from
-- -PI to PI. Note the order: y first, as in C and Python.
pure func atan2(y: Float, x: Float) -> Float:
    builtin("float.atan2")


-- e raised to `value`.
pure func exp(value: Float) -> Float:
    builtin("float.exp")


-- The natural logarithm: -inf at zero and NaN below zero.
pure func log(value: Float) -> Float:
    builtin("float.log")


-- C's pow, with its IEEE special cases: anything to the power 0.0 is 1.0, and a
-- negative base to a power that is not whole is NaN.
pure func pow(base: Float, exponent: Float) -> Float:
    builtin("float.pow")


-- Toward zero, as trunc rounds, then saturating at INT_MIN and INT_MAX: an
-- infinity is the nearer limit, and NaN is 0. Never undefined, although C's own
-- cast of an out-of-range double is.
pure func to_int(value: Float) -> Int:
    builtin("float.to_int")


-- The nearest Float: exact for every Int from -2^53 to 2^53, and rounded to
-- the nearest even beyond, so INT_MAX becomes 2^63.
pure func to_float(value: Int) -> Float:
    builtin("int.to_float")
