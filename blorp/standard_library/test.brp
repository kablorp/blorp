import:
    _base: Int, String, Bool(True, False), List
    int: Int methods
    string: String methods
    io: print

record TestSuite {
    description: String,
    tests: List[(String, () -> Bool)]
}

fixed record TestCounts {
    passed: Int,
    failed: Int
}

func run_suite_result(suite: TestSuite) -> TestCounts:
    print("")
    print(">> " + suite.description + " Tests")
    var passed: Int = 0
    var failed: Int = 0

    for (name, callback) in suite.tests:
        match callback():
            True:
                print("  [PASS] " + name)
                passed = passed + 1
            False:
                print("  [FAIL] " + name)
                failed = failed + 1

    print("")
    test_count: Int = passed + failed
    total: String = test_count.to_string()
    match failed.equals(0):
        True:
            print("All " + total + " tests passed")
        False:
            counts: String = failed.to_string() + " of " + total
            print(counts + " tests failed")

    { passed = passed, failed = failed }


-- 0 only when none of the suites already run had a failed case.
pure func suites_exit_status(results: List[TestCounts]) -> Int:
    var status: Int = 0
    for counts in results:
        if counts.failed > 0:
            status = 1
            break
    status


func run_suite(suite: TestSuite) -> Int:
    suites_exit_status([suite.run_suite_result()])
