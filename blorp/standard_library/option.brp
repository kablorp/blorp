import:
    _base: Bool(True, False), Option(Some, None), Result(Ok, Err)

pure func is_some[T](self: Option[T]) -> Bool:
    match self:
        Some(_): True
        None: False

pure func is_none[T](self: Option[T]) -> Bool:
    match self:
        Some(_): False
        None: True

pure func get_or[T](self: Option[T], default_val: T) -> T:
    match self:
        Some(value): value
        None: default_val

pure func to_result[T, E](self: Option[T], error: E) -> Result[T, E]:
    match self:
        Some(value): Ok(value)
        None: Err(error)

pure func map[T, U](self: Option[T], callback: pure (T) -> U) -> Option[U]:
    match self:
        Some(value): Some(callback(value))
        None: None
