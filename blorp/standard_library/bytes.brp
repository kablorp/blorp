-- Bytes is a List[UInt8] that only this module can open, so a byte sequence
-- and a list of small numbers are different types to the checker and to the
-- reader. Import it as `bytes: Bytes, from_list, String methods`.
import:
    _base: Int, UInt8, String, List, Bool, Option, Equatable, Addable, Hashable
    list: List methods
    string: String methods


-- Contents are bytes, not characters, so there is no boundary to cut: indexes
-- clamp as List's do and nothing fails.
opaque type Bytes = List[UInt8]


private pure func native_to_text(data: List[UInt8]) -> Option[String]:
    builtin("bytes.to_text")


private pure func native_to_bytes(text: String) -> List[UInt8]:
    builtin("string.to_bytes")


-- The list's elements in place: Bytes is erased, so this does not copy.
pure func from_list(values: List[UInt8]) -> Bytes:
    into_opaque Bytes(values)


pure func to_list(data: Bytes) -> List[UInt8]:
    from_opaque Bytes(data)


pure func length(data: Bytes) -> Int:
    from_opaque Bytes(data).length()


pure func is_empty(data: Bytes) -> Bool:
    from_opaque Bytes(data).is_empty()


pure func get(data: Bytes, index: Int) -> Option[UInt8]:
    from_opaque Bytes(data).get(index)


pure func get_or(data: Bytes, index: Int, fallback: UInt8) -> UInt8:
    from_opaque Bytes(data).get_or(index, fallback)


-- Keeps the bytes from start up to, not including, end. Both bounds clamp to
-- the data, and an end before start gives empty data, as List's take and drop
-- clamp their count: nothing fails.
pure func slice(data: Bytes, start: Int, end: Int) -> Bytes:
    into_opaque Bytes(from_opaque Bytes(data).slice(start, end))


-- Whether the first bytes of data equal prefix; every data starts with empty.
pure func starts_with(data: Bytes, prefix: Bytes) -> Bool:
    from_opaque Bytes(data).starts_with(from_opaque Bytes(prefix))


-- The text the bytes spell, or None unless they are valid UTF-8. The empty
-- data is the empty text.
pure func to_text(data: Bytes) -> Option[String]:
    from_opaque Bytes(data).native_to_text()


-- The UTF-8 bytes of the text, including any NUL it holds.
pure func to_bytes(text: String) -> Bytes:
    into_opaque Bytes(text.native_to_bytes())


implements Equatable for Bytes:
    pure func equals(left: Self, right: Self) -> Bool:
        from_opaque Bytes(left) == from_opaque Bytes(right)


-- Concatenation.
implements Addable for Bytes:
    pure func add(left: Self, right: Self) -> Self:
        into_opaque Bytes(from_opaque Bytes(left).concat(from_opaque Bytes(right)))


implements Hashable for Bytes:
    pure func hash(value: Self) -> Int:
        from_opaque Bytes(value).hash()
