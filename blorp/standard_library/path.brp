-- Pure logical paths; only ASCII '/' is a separator.
import:
    _base:
        Int,
        String,
        List,
        Bool(True, False),
        Option(Some, None),
        Result(Ok, Err),
        Addable,
        Equatable,
        Hashable,
        Stringable,
    bool: Bool methods, and, or
    int: Int methods
    list: List methods
    option: Option methods
    string: String methods


private PATH_SEPARATOR_BYTE: Int = 47

private DOT_BYTE: Int = 46

private NUL_BYTE: Int = 0


private pure func is_separator(path: String, position: Int) -> Bool:
    match path.byte_at(position):
        Some(byte): byte.equals(PATH_SEPARATOR_BYTE)
        None: False


-- The length of `text` without its trailing separators; 0 for an empty text or
-- one that is only separators.
private pure func length_without_trailing_separators(text: String) -> Int:
    var end = text.length()
    while end > 0:
        if text.is_separator(end - 1):
            end = end - 1
        else:
            break
    end


-- Callers supply one nonempty component cut at proved scalar boundaries.
-- Only ordinary components cancel; unresolved relative parents remain stacked.
private pure func normalized_component(
    components: List[String],
    component: String,
    absolute: Bool,
) -> List[String]:
    match component.equals("."):
        True:
            components
        False:
            match component.equals(".."):
                False:
                    components.append(component)
                True:
                    match components.last():
                        Some(previous):
                            match previous.equals(".."):
                                True: components.append(component)
                                False: components.take(components.length() - 1)
                        None:
                            match absolute:
                                True: components
                                False: components.append(component)


-- Pure logical normalization: no filesystem, symlink or Unicode normalization.
-- The byte scan/materialization is linear, and List.join builds its String in
-- one pass; List append copies only when its List is shared.
private pure func normalized_spelling(path: String) -> String:
    absolute = path.is_separator(0)
    size = path.length()
    var components: List[String] = []
    var start = 0
    var position = 0

    while position < size:
        if path.is_separator(position):
            if start < position:
                -- start is 0 or follows '/'; position points at ASCII '/'.
                -- 0 <= start < position < size; both are scalar boundaries.
                components = match path.slice(start, position):
                    Some(component): components.normalized_component(component, absolute)
                    None: components
            start = position + 1
        position = position + 1

    if start < size:
        -- start is 0 or follows '/', and size is the input's scalar boundary.
        -- 0 <= start < size; checked Slice cannot fail at these endpoints.
        components = match path.slice(start, size):
            Some(component): components.normalized_component(component, absolute)
            None: components

    joined = components.join("/")
    match absolute:
        True:
            "/" + joined
        False:
            match (
                components
                    .length()
                    .equals(0)
            ):
                True: "."
                False: joined


-- Never empty, never holding NUL: `to_path` is the only constructor.
opaque type Path = String


fixed union PathError:
    Empty
    ContainsNul


implements Stringable for PathError:
    pure func to_string(value: Self) -> String:
        match value:
            Empty: "a path cannot be empty"
            ContainsNul: "a path cannot contain a NUL byte"


implements Stringable for Path:
    pure func to_string(value: Self) -> String:
        from_opaque Path(value)


implements Equatable for Path:
    pure func equals(left: Self, right: Self) -> Bool:
        from_opaque Path(left) == from_opaque Path(right)


implements Addable for Path:
    pure func add(left: Self, right: Self) -> Self:
        into_opaque Path(from_opaque Path(left) + from_opaque Path(right))


implements Hashable for Path:
    pure func hash(value: Self) -> Int:
        from_opaque Path(value).hash()


private pure func has_byte(text: String, wanted: Int) -> Bool:
    var found: Bool = False
    for position in 0..text.length():
        match text.byte_at(position):
            Some(byte):
                if byte == wanted:
                    found = True
                    break
            None:
                void
    found


pure func to_path(text: String) -> Result[Path, PathError]:
    if text.length() == 0:
        Err(Empty)
    else if text.has_byte(NUL_BYTE):
        Err(ContainsNul)
    else:
        Ok(into_opaque Path(text))


-- `child` under `base`, even when `child` is absolute: `/a` and `/b` give
-- `/a/b`. Exactly one separator joins them; nothing else is cleaned, so `..`,
-- `.` and repeated separators inside either part are kept as written. Unlike
-- Rust's and Python's join, an absolute child does not replace the base. At
-- the junction the base's trailing separators (root stays `/`) and the child's
-- leading ones are dropped; a child that is only separators gives the base.
-- The `get_or` fallbacks below are unreachable: both slices lie inside the spelling.
pure func join(base: Path, child: Path) -> Path:
    base_text = from_opaque Path(base)
    child_text = from_opaque Path(child)
    var child_start = 0
    while child_start < child_text.length():
        if child_text.is_separator(child_start):
            child_start = child_start + 1
        else:
            break
    if child_start == child_text.length():
        base
    else:
        base_end = base_text.length_without_trailing_separators()
        below = child_text
            .slice(child_start, child_text.length())
            .get_or(child_text)
        if base_end == 0:
            -- Only separators: root.
            into_opaque Path("/" + below)
        else:
            into_opaque Path(
                base_text
                    .slice(0, base_end)
                    .get_or(base_text) + "/" + below
            )


private pure func is_dot(path: String, position: Int) -> Bool:
    match path.byte_at(position):
        Some(byte): byte.equals(DOT_BYTE)
        None: False


-- A component normalization keeps as written: nonempty, and neither `.` nor
-- `..`. Reads the bytes from `start` up to `end`; slices nothing.
private pure func is_ordinary_component(path: String, start: Int, end: Int) -> Bool:
    match end - start:
        0:
            False
        1:
            path
                .is_dot(start)
                .not()
        2:
            path
                .is_dot(start)
                .and(path.is_dot(start + 1))
                .not()
        _:
            True


-- Whether `normalized_spelling` would return `path` unchanged: after an
-- optional leading `/`, every component is ordinary, so there is no `//`, no
-- trailing `/` and no `.` or `..` (`/` alone is normal). A scan with no
-- slicing, so an already normal spelling costs nothing however many components
-- it has, and a compile's allocations do not depend on the checkout's depth.
-- It is narrower than "normalization leaves it unchanged": `../a` is stable
-- but takes the slow path.
private pure func is_normal_spelling(path: String) -> Bool:
    size = path.length()
    first = if path.is_separator(0):
        1
    else:
        0
    if first == size:
        first == 1
    else:
        var start = first
        var position = first
        var normal: Bool = True
        while position < size:
            if path.is_separator(position):
                normal = path.is_ordinary_component(start, position)
                if normal.not():
                    break
                start = position + 1
            position = position + 1
        normal.and(path.is_ordinary_component(start, size))


-- Lexical only: `.` components and cancelled `a/..` pairs are removed, and no
-- filesystem, symlink or Unicode normalization is consulted. It never gives an
-- empty spelling: an absolute path keeps its leading `/`, and a relative one
-- with no components left is `.`.
pure func normalize(path: Path) -> Path:
    spelling = from_opaque Path(path)
    if spelling.is_normal_spelling():
        path
    else:
        into_opaque Path(spelling.normalized_spelling())


-- The last component, ignoring trailing separators, split at its last dot that
-- does not begin it, `x.test.brp` is
-- `x.test` and `brp`, `.hidden` has no extension, `a.` has the empty one, `...`
-- is `..` and the empty one. `/`, `.` and `..` name no entry, so no parts.
private record NameParts {
    name: String,
    stem: String,
    extension: Option[String],
}


private pure func name_parts(spelling: String) -> Option[NameParts]:
    end = spelling.length_without_trailing_separators()
    var start = end
    while start > 0:
        if spelling.is_separator(start - 1):
            break
        else:
            start = start - 1
    text = spelling
        .slice(start, end)
        .get_or("")
    if or(text.length() == 0, or(text == ".", text == "..")):
        None
    else:
        var dot: Option[Int] = None
        for position in (start + 1)..end:
            if spelling.byte_at(position) == Some(DOT_BYTE):
                dot = Some(position)
        match dot:
            Some(index):
                before = spelling
                    .slice(start, index)
                    .get_or("")
                Some({ name = text, stem = before, extension = spelling.slice(index + 1, end) })
            None:
                Some({ name = text, stem = text, extension = None })


-- Total: a path with no parent component is `.`, and root is its own parent.
-- `.` and `..` are components like any other. Trailing separators are ignored,
-- and the final component and its separator run are removed; interior
-- components remain lexical.
pure func parent(path: Path) -> Path:
    spelling = from_opaque Path(path)
    var end = spelling.length_without_trailing_separators()

    while end > 0:
        if spelling.is_separator(end - 1):
            break
        else:
            end = end - 1

    while end > 0:
        if spelling.is_separator(end - 1):
            end = end - 1
        else:
            break

    if end == 0:
        if spelling.is_separator(0):
            into_opaque Path("/")
        else:
            into_opaque Path(".")
    else:
        -- 0 < end <= byte length, and byte[end] is ASCII '/'.
        -- Both endpoints are scalar boundaries; checked Slice cannot fail.
        into_opaque Path(
            spelling
                .slice(0, end)
                .get_or(".")
        )


-- The last component, ignoring trailing separators: `a/b/` is `b`.
pure func name(path: Path) -> Option[String]:
    match from_opaque Path(path).name_parts():
        Some(parts): Some(parts.name)
        None: None


-- The name up to its extension: `x.test.brp` is `x.test`, `.hidden` is itself.
pure func stem(path: Path) -> Option[String]:
    match from_opaque Path(path).name_parts():
        Some(parts): Some(parts.stem)
        None: None


-- The part after the name's last dot, without the dot: `x.brp` is `brp`, `a.`
-- is the empty String, `.hidden` and `a` are None.
pure func extension(path: Path) -> Option[String]:
    match from_opaque Path(path).name_parts():
        Some(parts): parts.extension
        None: None


-- Non-empty components, without `.`: it names the directory it is in, so
-- skipping it changes nothing lexically.
private pure func path_components(spelling: String) -> List[String]:
    var result: List[String] = []
    var start = 0
    for position in 0..(spelling.length() + 1):
        if or(spelling.is_separator(position), position == spelling.length()):
            component = spelling
                .slice(start, position)
                .get_or("")
            if and(start < position, component != "."):
                result = result.append(component)
            start = position + 1
    result


-- Whether the spelling starts with a separator, so it names the same place
-- from any working directory. `join` puts an absolute child under its base, so
-- a caller that wants Python's behaviour asks this first.
pure func is_absolute(path: Path) -> Bool:
    from_opaque Path(path).is_separator(0)


-- Whether the spelling ends in `/`: `a/` and `/` do, `a` does not. Such a path
-- names a directory, whatever precedes the separator.
pure func ends_in_separator(path: Path) -> Bool:
    spelling = from_opaque Path(path)
    spelling.is_separator(spelling.length() - 1)


-- Whether `path` is `root` or lies below it, comparing components, never
-- bytes: `a/b/c` is within `a/b`, `a/bc` is not. Both must be absolute or both
-- relative, and `.` components and repeated separators are ignored. Nothing is
-- resolved, so a `..` after the root's components could leave it and the
-- answer is False: `a/../b` is not within `a`, and `../a` is not within `.`.
-- Lexical only. It does not resolve symlinks, so it is not a sandbox check.
pure func is_within(path: Path, root: Path) -> Bool:
    path_text = from_opaque Path(path)
    root_text = from_opaque Path(root)
    path_parts = path_text.path_components()
    root_parts = root_text.path_components()
    below = path_parts.drop(root_parts.length())
    and(
        path_text.is_separator(0) == root_text.is_separator(0),
        and(
            path_parts.take(root_parts.length()) == root_parts,
            below
                .contains("..")
                .not(),
        ),
    )
