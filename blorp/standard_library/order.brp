import:
    _base: Bool(True, False), Orderable


-- The larger of two Orderable values; the first when neither is less.
pure func max[T: Orderable](first: T, second: T) -> T:
    match first < second:
        True: second
        False: first


-- The smaller of two Orderable values; the first when neither is less.
pure func min[T: Orderable](first: T, second: T) -> T:
    match second < first:
        True: second
        False: first
