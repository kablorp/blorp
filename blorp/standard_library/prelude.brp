-- The prelude is the only implicit import, and only user modules receive it.
-- Types, Equatable, Orderable, Hashable and the arithmetic traits come from _base.
-- Each operation module contributes its written receiver methods.
import:
    _base:
        Int,
        Float,
        String,
        List,
        Void,
        Bool(True, False),
        Option(Some, None),
        Result(Ok, Err),
        Equatable,
        Orderable,
        Hashable,
        Stringable,
        Addable,
        Subtractable,
        Multipliable,
        Divisible,
        Modulable,
        Negatable,
    dict: Dict
    float: Float methods
    int: Int methods
    list: List methods
    string: String methods
