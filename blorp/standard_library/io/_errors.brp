-- Shared native I/O error protocol, internal by convention. Positive kinds
-- use explicit wire values from runtime/fs.brp; an unnamed errno is negated.
-- Literal protocol tests independently bind this mirror to the native enum.
import:
    _base: Int, List, Option(Some, None)
    int: Int methods


fixed union NativeErrorKind:
    NotFound
    PermissionDenied
    AlreadyExists
    NotADirectory
    IsADirectory
    DirectoryNotEmpty
    NotARegularFile
    ReadOnlyFilesystem
    NoSpace
    FileTooLarge
    CrossesDevices
    PathContainsNul
    InvalidUtf8
    ChangedDuringRemoval
    Unreachable


-- Exhaustive and total: compiler variant tags never determine wire values.
pure func native_error_code(kind: NativeErrorKind) -> Int:
    match kind:
        NotFound: 1
        PermissionDenied: 2
        AlreadyExists: 3
        NotADirectory: 4
        IsADirectory: 5
        DirectoryNotEmpty: 6
        NotARegularFile: 7
        ReadOnlyFilesystem: 8
        NoSpace: 9
        FileTooLarge: 10
        CrossesDevices: 11
        PathContainsNul: 12
        InvalidUtf8: 13
        ChangedDuringRemoval: 14
        Unreachable: 15


-- An inventory, not a positional encoding. Reordering it preserves the ABI.
private NATIVE_ERROR_KINDS: List[NativeErrorKind] = [
    NotFound,
    PermissionDenied,
    AlreadyExists,
    NotADirectory,
    IsADirectory,
    DirectoryNotEmpty,
    NotARegularFile,
    ReadOnlyFilesystem,
    NoSpace,
    FileTooLarge,
    CrossesDevices,
    PathContainsNul,
    InvalidUtf8,
    ChangedDuringRemoval,
    Unreachable
]


pure func native_error_kind(code: Int) -> Option[NativeErrorKind]:
    var found: Option[NativeErrorKind] = None
    if code > 0:
        for kind in NATIVE_ERROR_KINDS:
            if native_error_code(kind) == code:
                found = Some(kind)
                break
    found


-- Unsupported positive kinds remain visible as negative mismatches. Negation
-- wraps for INT_MIN, preserving the protocol's existing fallback exactly.
pure func other_os_number(code: Int) -> Int:
    0 - code
