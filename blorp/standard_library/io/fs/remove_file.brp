-- Removing a file. A native reports a failure as an Int code, which the
-- decoder below turns into the error union of remove_file.
import:
    _base: Int, String, Void, Result(Ok, Err), Stringable
    int: Int methods
    io/_codes:
        NOT_FOUND_CODE,
        PERMISSION_DENIED_CODE,
        NOT_A_DIRECTORY_CODE,
        IS_A_DIRECTORY_CODE,
        READ_ONLY_FILESYSTEM_CODE,
    path: Path
    result: Result methods
    string: String methods


-- Why a file could not be removed.
fixed union RemoveFileError:
    NotFound
    PermissionDenied
    NotADirectory
    IsADirectory
    ReadOnlyFilesystem
    -- Any other errno, such as EBUSY.
    OtherOs(Int)


-- Public so that its test binds it to literal native codes; it is not API for
-- programs. A code this union does not name is OtherOs with the code negated,
-- as io/_codes does.
pure func decode_remove_file_error(code: Int) -> RemoveFileError:
    if code == NOT_FOUND_CODE:
        NotFound
    else if code == PERMISSION_DENIED_CODE:
        PermissionDenied
    else if code == NOT_A_DIRECTORY_CODE:
        NotADirectory
    else if code == IS_A_DIRECTORY_CODE:
        IsADirectory
    else if code == READ_ONLY_FILESYSTEM_CODE:
        ReadOnlyFilesystem
    else:
        OtherOs(0 - code)


implements Stringable for RemoveFileError:
    pure func to_string(value: Self) -> String:
        match value:
            NotFound: "no such file"
            PermissionDenied: "permission denied"
            NotADirectory: "not a directory"
            IsADirectory: "is a directory"
            ReadOnlyFilesystem: "read-only file system"
            OtherOs(number): "operating system error ${number}"


private func native_remove_file(path: String) -> Result[Void, Int]:
    builtin("fs.remove_file")


-- Removes a file or a link, never what the link names. A directory is
-- IsADirectory on both platforms. EBUSY is OtherOs.
func remove_file(path: Path) -> Result[Void, RemoveFileError]:
    path
        .to_string()
        .native_remove_file()
        .map_err(decode_remove_file_error)
