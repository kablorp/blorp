-- Renaming. A native reports a failure as an Int code, which the decoder
-- below turns into the error union of rename.
import:
    _base: Int, String, Void, Result(Ok, Err), Stringable
    int: Int methods
    io/_codes:
        NOT_FOUND_CODE,
        PERMISSION_DENIED_CODE,
        NOT_A_DIRECTORY_CODE,
        IS_A_DIRECTORY_CODE,
        DIRECTORY_NOT_EMPTY_CODE,
        READ_ONLY_FILESYSTEM_CODE,
        NO_SPACE_CODE,
        CROSSES_DEVICES_CODE,
    path: Path
    result: Result methods
    string: String methods


-- Why a rename failed. The error does not say which of the two paths is at
-- fault: the caller has both.
fixed union RenameError:
    NotFound
    PermissionDenied
    NotADirectory
    -- A file renamed onto a directory (EISDIR).
    IsADirectory
    DirectoryNotEmpty
    ReadOnlyFilesystem
    -- ENOSPC and EDQUOT.
    NoSpace
    -- EXDEV, so the caller can fall back to copying.
    CrossesDevices
    -- Any other errno, such as EINVAL, EBUSY, ELOOP or ENAMETOOLONG.
    OtherOs(Int)


-- Public so that its test binds it to literal native codes; it is not API for
-- programs. A code this union does not name is OtherOs with the code negated,
-- as io/_codes does.
pure func decode_rename_error(code: Int) -> RenameError:
    if code == NOT_FOUND_CODE:
        NotFound
    else if code == PERMISSION_DENIED_CODE:
        PermissionDenied
    else if code == NOT_A_DIRECTORY_CODE:
        NotADirectory
    else if code == IS_A_DIRECTORY_CODE:
        IsADirectory
    else if code == DIRECTORY_NOT_EMPTY_CODE:
        DirectoryNotEmpty
    else if code == READ_ONLY_FILESYSTEM_CODE:
        ReadOnlyFilesystem
    else if code == NO_SPACE_CODE:
        NoSpace
    else if code == CROSSES_DEVICES_CODE:
        CrossesDevices
    else:
        OtherOs(0 - code)


implements Stringable for RenameError:
    pure func to_string(value: Self) -> String:
        match value:
            NotFound: "no such file"
            PermissionDenied: "permission denied"
            NotADirectory: "not a directory"
            IsADirectory: "is a directory"
            DirectoryNotEmpty: "directory not empty"
            ReadOnlyFilesystem: "read-only file system"
            NoSpace: "no space left on device"
            CrossesDevices: "crosses devices"
            OtherOs(number): "operating system error ${number}"


private func native_rename(source: String, destination: String) -> Result[Void, Int]:
    builtin("fs.rename")


-- Renames a file or directory. It replaces an existing file, or an empty
-- directory, at the destination; a destination directory with entries is
-- DirectoryNotEmpty, and a file onto a directory is IsADirectory. A different
-- device is CrossesDevices. EINVAL (a directory moved into itself), EBUSY,
-- ELOOP and ENAMETOOLONG are OtherOs.
func rename(source: Path, destination: Path) -> Result[Void, RenameError]:
    source
        .to_string()
        .native_rename(destination.to_string())
        .map_err(decode_rename_error)
