-- Removing an empty directory. A native reports a failure as an Int code,
-- which the decoder below turns into the error union of remove_directory.
import:
    _base: Int, String, Void, Result(Ok, Err), Stringable
    int: Int methods
    io/_codes:
        NOT_FOUND_CODE,
        PERMISSION_DENIED_CODE,
        NOT_A_DIRECTORY_CODE,
        DIRECTORY_NOT_EMPTY_CODE,
        READ_ONLY_FILESYSTEM_CODE,
    path: Path
    result: Result methods
    string: String methods


-- Why a directory could not be removed.
fixed union RemoveDirectoryError:
    NotFound
    PermissionDenied
    NotADirectory
    DirectoryNotEmpty
    ReadOnlyFilesystem
    -- Any other errno, such as EINVAL or EBUSY.
    OtherOs(Int)


-- Public so that its test binds it to literal native codes; it is not API for
-- programs. A code this union does not name is OtherOs with the code negated,
-- as io/_codes does.
pure func decode_remove_directory_error(code: Int) -> RemoveDirectoryError:
    if code == NOT_FOUND_CODE:
        NotFound
    else if code == PERMISSION_DENIED_CODE:
        PermissionDenied
    else if code == NOT_A_DIRECTORY_CODE:
        NotADirectory
    else if code == DIRECTORY_NOT_EMPTY_CODE:
        DirectoryNotEmpty
    else if code == READ_ONLY_FILESYSTEM_CODE:
        ReadOnlyFilesystem
    else:
        OtherOs(0 - code)


implements Stringable for RemoveDirectoryError:
    pure func to_string(value: Self) -> String:
        match value:
            NotFound: "no such file"
            PermissionDenied: "permission denied"
            NotADirectory: "not a directory"
            DirectoryNotEmpty: "directory not empty"
            ReadOnlyFilesystem: "read-only file system"
            OtherOs(number): "operating system error ${number}"


private func native_remove_directory(path: String) -> Result[Void, Int]:
    builtin("fs.remove_directory")


-- Removes an empty directory. One with entries is DirectoryNotEmpty, whether
-- the operating system says EEXIST or ENOTEMPTY. EINVAL (the path `.`) and EBUSY
-- are OtherOs.
func remove_directory(path: Path) -> Result[Void, RemoveDirectoryError]:
    path
        .to_string()
        .native_remove_directory()
        .map_err(decode_remove_directory_error)
