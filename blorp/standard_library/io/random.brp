-- Seeds for random's generators, from the operating system: the only impure
-- part of randomness. Once a program has a seed, every draw is pure, so a run
-- replays from the seed it printed or saved.
import:
    _base: Int, Float, Result(Ok, Err)
    random: Random, seeded, next_below, next_float
    ./_errors: other_os_number
    ./_launch: fault


-- The operating system's error code on failure, as an OtherOs code.
private func native_random_seed() -> Result[Int, Int]:
    builtin("system.random_seed")


-- 64 bits from the operating system's entropy source, getentropy, so every Int
-- is equally likely. The source does not fail on a supported system; if it
-- ever did, the program stops with a message, as it does when memory runs out,
-- so that a seed needs no error handling.
func random_seed() -> Int:
    match native_random_seed():
        Ok(seed):
            seed
        Err(code):
            fault(
                "the operating system's entropy source failed with error ${other_os_number(code)}"
            )


func random_generator() -> Random:
    seeded(random_seed())


-- One Int from 0 up to, not including, `bound`, from a fresh seed; 0 when
-- `bound` is 0 or less. For many draws, make one generator and draw from it.
func random_below(bound: Int) -> Int:
    (value, _) = random_generator().next_below(bound)
    value


-- One Float from 0.0 up to, not including, 1.0, from a fresh seed.
func random_float() -> Float:
    (value, _) = random_generator().next_float()
    value
