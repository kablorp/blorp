-- Reading standard input a line at a time, as bytes. Standard input has one
-- buffer, which read_exact shares, so the two continue where the other stopped.
import:
    _base: Int, UInt8, String, List, Option(Some, None), Result(Ok, Err), Stringable
    bytes: Bytes, from_list
    io/_errors: NativeErrorKind, native_error_kind, other_os_number
    list: List methods


-- Why read_line could not read standard input.
fixed union ReadLineError:
    -- EISDIR: standard input is a directory.
    IsADirectory
    -- Any other errno, such as EIO or EBADF.
    OtherOs(Int)


-- Public so that its test binds it to literal native codes; it is not API for
-- programs. An unnamed errno arrives negated, so OtherOs keeps the platform's
-- number, as io/_errors does.
pure func decode_read_line_error(code: Int) -> ReadLineError:
    match native_error_kind(code):
        Some(NativeErrorKind.IsADirectory): IsADirectory
        _: OtherOs(other_os_number(code))


implements Stringable for ReadLineError:
    pure func to_string(value: Self) -> String:
        match value:
            IsADirectory: "standard input is a directory"
            OtherOs(number): "operating system error ${number}"


private LINE_FEED: UInt8 = 10
private CARRIAGE_RETURN: UInt8 = 13


private func native_read_line() -> Result[List[UInt8], Int]:
    builtin("console.read_line")


-- The bytes before the next LF, without it or a CR just before it (a lone CR
-- stays). A last line with no LF comes as it is; None once input has ended.
func read_line() -> Result[Option[Bytes], ReadLineError]:
    line ?= native_read_line().map_err(decode_read_line_error)
    if line.is_empty():
        Ok(None)
    else:
        Ok(Some(from_list(without_line_ending(line))))


-- The native keeps the LF, so that an empty line differs from the end of input.
private pure func without_line_ending(line: List[UInt8]) -> List[UInt8]:
    if line.last() == Some(LINE_FEED):
        unterminated = line.take(line.length() - 1)
        if unterminated.last() == Some(CARRIAGE_RETURN):
            unterminated.take(unterminated.length() - 1)
        else:
            unterminated
    else:
        line
