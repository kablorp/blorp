-- Standard output and standard error. print and print_error write a text line;
-- write and write_error write exactly the bytes given, for protocols that count
-- them. src/common/codegen/runtime/console.brp owns the C side.
import:
    _base: Int, UInt8, String, Void, List, Result
    bytes: Bytes, to_list


func print(value: String) -> Void:
    builtin("string.print")


func print_error(message: String) -> Void:
    builtin("string.print_error")


private func native_write(data: List[UInt8]) -> Result[Void, Int]:
    builtin("console.write")


private func native_write_error(data: List[UInt8]) -> Result[Void, Int]:
    builtin("console.write_error")


private func native_flush() -> Result[Void, Int]:
    builtin("console.flush")


-- The bytes exactly as given; no newline is added. print shares the buffer, so
-- the order of their output holds. Output a closed pipe refuses is dropped,
-- under the SIGPIPE guard, so a client that has gone does not end the program.
func write(data: Bytes) -> Void:
    ignored = native_write(to_list(data))
    void


-- Standard error is unbuffered, so the bytes go out at once.
func write_error(data: Bytes) -> Void:
    ignored = native_write_error(to_list(data))
    void


-- Sends buffered standard output now. Every read of standard input does this
-- first, so a prompt shows before the program waits.
func flush() -> Void:
    ignored = native_flush()
    void
