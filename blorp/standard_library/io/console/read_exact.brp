-- Reading an exact number of bytes from standard input, as a protocol that counts
-- its body does. Standard input has one buffer, which read_line shares.
import:
    _base: Int, UInt8, String, List, Option(Some, None), Result(Ok, Err), Stringable
    bytes: Bytes, from_list
    io/_errors: NativeErrorKind, native_error_kind, other_os_number
    list: List methods


-- Why read_exact did not return the bytes asked for.
fixed union ReadExactError:
    -- Input ended after this many of the bytes asked for.
    EndedEarly(Int)
    -- EISDIR: standard input is a directory.
    IsADirectory
    -- Any other errno, such as EIO or EBADF.
    OtherOs(Int)


-- Public so that its test binds it to literal native codes; it is not API for
-- programs. An unnamed errno arrives negated, so OtherOs keeps the platform's
-- number, as io/_errors does.
pure func decode_read_exact_error(code: Int) -> ReadExactError:
    match native_error_kind(code):
        Some(NativeErrorKind.IsADirectory): IsADirectory
        _: OtherOs(other_os_number(code))


implements Stringable for ReadExactError:
    pure func to_string(value: Self) -> String:
        match value:
            EndedEarly(count): "input ended after ${count} bytes"
            IsADirectory: "standard input is a directory"
            OtherOs(number): "operating system error ${number}"


private func native_read_exact(count: Int) -> Result[List[UInt8], Int]:
    builtin("console.read_exact")


-- Exactly `byte_count` bytes. A count of zero or less gives Some(empty) without
-- reading; None means input ended before the first byte. Bytes are held only as
-- they arrive, so a large count costs only the input received.
func read_exact(byte_count: Int) -> Result[Option[Bytes], ReadExactError]:
    data ?= native_read_exact(byte_count).map_err(decode_read_exact_error)
    if byte_count <= 0:
        Ok(Some(from_list(data)))
    else if data.is_empty():
        Ok(None)
    else if data.length() < byte_count:
        Err(EndedEarly(data.length()))
    else:
        Ok(Some(from_list(data)))
