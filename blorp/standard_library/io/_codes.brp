-- Shared native I/O error protocol. The codes are public so that each module's
-- decoder names the ones its error union can produce.
import:
    _base: Int


-- Codes from src/common/codegen/runtime/fs.brp's FS_HELPERS_RUNTIME enum. A named kind has a
-- positive code; any other errno arrives negated, so OtherOs keeps the
-- platform's number. The two sides agree only by the tests that name each
-- code as a literal.
NOT_FOUND_CODE: Int = 1
PERMISSION_DENIED_CODE: Int = 2
ALREADY_EXISTS_CODE: Int = 3
NOT_A_DIRECTORY_CODE: Int = 4
IS_A_DIRECTORY_CODE: Int = 5
DIRECTORY_NOT_EMPTY_CODE: Int = 6
NOT_A_REGULAR_FILE_CODE: Int = 7
READ_ONLY_FILESYSTEM_CODE: Int = 8
NO_SPACE_CODE: Int = 9
FILE_TOO_LARGE_CODE: Int = 10
CROSSES_DEVICES_CODE: Int = 11
PATH_CONTAINS_NUL_CODE: Int = 12
INVALID_UTF8_CODE: Int = 13
-- Nothing deterministic produces this code: it needs another process to move a
-- directory during a walk. The C remove_directory_tree test proves the runtime
-- sends it, and the decoder test of io/fs/remove_tree checks it independently.
CHANGED_DURING_REMOVAL_CODE: Int = 14
-- Only current_directory sends this: the system names no usable absolute path.
UNREACHABLE_CODE: Int = 15
