import:
    _base: Int, String, Bool(True, False), Hashable, Stringable


pure func not(value: Bool) -> Bool:
    match value:
        True: False
        False: True


pure func and(left: Bool, right: Bool) -> Bool:
    match left:
        True: right
        False: False


pure func or(left: Bool, right: Bool) -> Bool:
    match left:
        True: True
        False: right


implements Stringable for Bool:
    pure func to_string(value: Self) -> String:
        match value:
            True: "True"
            False: "False"


implements Hashable for Bool:
    pure func hash(value: Self) -> Int:
        match value:
            True: 1
            False: 0
