-- Int is owned by _base.brp and implements its ordering and arithmetic traits.
import:
    _base:
        Int,
        String,
        Bool(True, False),
        Result(Ok, Err),
        MathError(DivisionByZero, Overflow),
        Orderable,
        Hashable,
        Addable,
        Subtractable,
        Multipliable,
        Divisible,
        Modulable,
        Negatable,
    traits: Equatable


implements Equatable for Int:
    pure func equals(left: Self, right: Self) -> Bool:
        builtin("int.equals")


implements Hashable for Int:
    pure func hash(value: Self) -> Int:
        value


implements Orderable for Int:
    pure func less_than(left: Self, right: Self) -> Bool:
        builtin("int.less_than")


pure func min(a: Int, b: Int) -> Int:
    match a.less_than(b):
        True: a
        False: b


pure func max(a: Int, b: Int) -> Int:
    match b.less_than(a):
        True: a
        False: b


INT_MIN: Int = -9223372036854775808
INT_MAX: Int = 9223372036854775807


implements Addable for Int:
    pure func add(left: Self, right: Self) -> Self:
        builtin("int.add")


pure func to_string(value: Int) -> String:
    builtin("int.to_string")


implements Subtractable for Int:
    pure func subtract(left: Self, right: Self) -> Self:
        builtin("int.subtract")


implements Multipliable for Int:
    pure func multiply(left: Self, right: Self) -> Self:
        builtin("int.multiply")


implements Divisible for Int:
    pure func divide(left: Self, right: Self) -> Self:
        builtin("int.divide")


implements Modulable for Int:
    pure func remainder(left: Self, right: Self) -> Self:
        builtin("int.remainder")


-- Subtraction wraps, so the negation of INT_MIN is INT_MIN.
implements Negatable for Int:
    pure func negate(value: Self) -> Self:
        subtract(0, value)


-- The checked forms return Err where the operators above wrap or give 0.
-- add_checked and subtract_checked compare against bounds that stay in range,
-- so the test itself never wraps.
pure func add_checked(left: Int, right: Int) -> Result[Int, MathError]:
    if right > 0:
        if left > INT_MAX - right:
            Err(Overflow)
        else:
            Ok(left + right)
    else if left < INT_MIN - right:
        Err(Overflow)
    else:
        Ok(left + right)


pure func subtract_checked(left: Int, right: Int) -> Result[Int, MathError]:
    if right < 0:
        if left > INT_MAX + right:
            Err(Overflow)
        else:
            Ok(left - right)
    else if left < INT_MIN + right:
        Err(Overflow)
    else:
        Ok(left - right)


-- For left other than 0 and -1, a wrapped product never divides back to right.
-- Zero comes first because 0 / 0 is 0; -1 goes to negation because
-- INT_MIN / -1 wraps back to INT_MIN.
pure func multiply_checked(left: Int, right: Int) -> Result[Int, MathError]:
    if left == 0:
        Ok(0)
    else if left == -1:
        right.negate_checked()
    else:
        product = left * right
        if product / left == right:
            Ok(product)
        else:
            Err(Overflow)


-- Dividing by -1 is negation, the one quotient that can overflow.
pure func divide_checked(left: Int, right: Int) -> Result[Int, MathError]:
    if right == 0:
        Err(DivisionByZero)
    else if right == -1:
        left.negate_checked()
    else:
        Ok(left / right)


-- INT_MIN % -1 is exactly 0, so only a zero divisor fails.
pure func remainder_checked(left: Int, right: Int) -> Result[Int, MathError]:
    if right == 0:
        Err(DivisionByZero)
    else:
        Ok(left % right)


pure func negate_checked(value: Int) -> Result[Int, MathError]:
    if value == INT_MIN:
        Err(Overflow)
    else:
        Ok(-value)
