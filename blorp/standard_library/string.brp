-- ParseInt uses strict counted ASCII bytes and returns the designated Option.
import:
    _base:
        Int,
        UInt8,
        Float,
        String,
        Bool(True, False),
        Option(Some, None),
        Addable,
        Equatable,
        Hashable,
        Stringable,
        List,
    int: Int methods
    list: append
    option: Option methods


-- The hash starts from a fixed basis and folds each byte in order, wrapping.
-- It is unseeded: the same String hashes alike in every run.
private STRING_HASH_BASIS: Int = -3750763034362895579
private STRING_HASH_PRIME: Int = 1099511628211
private LINE_FEED: UInt8 = 10
private CARRIAGE_RETURN: UInt8 = 13


pure func parse_int(text: String) -> Option[Int]:
    builtin("string.parse_int")


pure func parse_float(text: String) -> Option[Float]:
    builtin("string.parse_float")


implements Equatable for String:
    pure func equals(left: Self, right: Self) -> Bool:
        builtin("string.equals")


pure func length(value: String) -> Int:
    builtin("string.length")


implements Stringable for String:
    pure func to_string(value: Self) -> String:
        value


implements Addable for String:
    pure func add(left: Self, right: Self) -> Self:
        builtin("string.add")


-- uint8 imports this module, so this module cannot import uint8's `to_int`; it
-- declares the same builtin for the one place it needs an Int from a byte.
private pure func byte_value(value: UInt8) -> Int:
    builtin("uint8.to_int")


pure func byte_at(value: String, index: Int) -> Option[UInt8]:
    builtin("string.byte_at_uint8")


pure func from_codepoint(value: Int) -> Option[String]:
    builtin("string.from_codepoint")


pure func append_int(self: String, value: Int) -> String:
    builtin("string.append_int")


-- Temporary: this walk uses native stack linear in the matching prefix.
-- Replace it only after scalar-loop support is accepted.
private pure func prefix_bytes_equal(value: String, prefix: String, position: Int) -> Bool:
    match prefix.byte_at(position):
        None:
            True
        Some(expected):
            match value.byte_at(position):
                None:
                    False
                Some(actual):
                    match actual.equals(expected):
                        False: False
                        True: value.prefix_bytes_equal(prefix, position + 1)


pure func starts_with(value: String, prefix: String) -> Bool:
    value.prefix_bytes_equal(prefix, 0)


-- Every position is below length(value), so the None arm is unreachable.
implements Hashable for String:
    pure func hash(value: Self) -> Int:
        var folded = STRING_HASH_BASIS
        for position in 0..value.length():
            match value.byte_at(position):
                Some(byte): folded = (folded + byte.byte_value()) * STRING_HASH_PRIME
                None: void
        folded


pure func slice(value: String, start: Int, end: Int) -> Option[String]:
    builtin("string.slice")


-- The line from start up to the LF at end, less a CR just before that LF. When
-- the line is empty the byte before end is the previous LF or nothing, never a
-- CR, so the CR is always inside the line. The None arm of slice is unreachable:
-- start is at most end, and end is at most length(text).
private pure func line_before(text: String, start: Int, end: Int) -> String:
    stop = if (
        text
            .byte_at(end - 1)
            .get_or(0)
        == CARRIAGE_RETURN
    ):
        end - 1
    else:
        end
    text
        .slice(start, stop)
        .get_or("")


-- Splits at each LF and drops it with a CR just before it, as fold_lines does.
-- A last line without an LF is kept as it is, and empty text has no lines. One
-- pass appends each line to a dying accumulator.
pure func lines(text: String) -> List[String]:
    var found: List[String] = []
    var start = 0
    for position in 0..text.length():
        if (
            text
                .byte_at(position)
                .get_or(0)
            == LINE_FEED
        ):
            found = found.append(text.line_before(start, position))
            start = position + 1
    if start < text.length():
        found = found.append(
            text
                .slice(start, text.length())
                .get_or(""),
        )
    found
