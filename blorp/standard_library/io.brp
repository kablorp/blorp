-- Concrete String output replaces the host generic Stringable APIs.
import:
    _base: Int, String, Void, Option(Some, None)
    int: Int methods


func print(value: String) -> Void:
    builtin("string.print")


func print_error(message: String) -> Void:
    builtin("string.print_error")


-- What went wrong. Every kind but OtherOs is a fact about the world that a
-- caller can act on; OtherOs keeps the operating system's own number, which
-- differs between macOS and Linux.
fixed union IOErrorKind:
    NotFound
    PermissionDenied
    AlreadyExists
    NotADirectory
    IsADirectory
    DirectoryNotEmpty
    NotARegularFile
    ReadOnlyFilesystem
    -- ENOSPC and EDQUOT.
    NoSpace
    -- EFBIG and EOVERFLOW, or contents beyond the String capacity.
    FileTooLarge
    -- EXDEV from rename, so the caller can fall back to copying, and a mount
    -- point or another device met by remove_directory_tree.
    CrossesDevices
    -- Found before any operating system call.
    PathContainsNul
    -- Found after reading bytes.
    InvalidUtf8
    -- Another process moved a directory while remove_directory_tree walked it.
    ChangedDuringRemoval
    -- Any other errno, such as ELOOP, ENAMETOOLONG or EMFILE.
    OtherOs(Int)


-- `path` is always the path the caller passed, even when the operating system
-- refused a parent directory, so "x: permission denied" does not say whether x
-- or one of its parents refused. The one exception is with_temporary_directory
-- failing to remove its directory, which names that directory: the body was
-- given the path, and nothing else says what was left behind. `destination` is
-- the second path of a two-path operation, and is None for every operation that
-- has one path.
record IOError { path: String, destination: Option[String], kind: IOErrorKind }


private pure func phrase(kind: IOErrorKind) -> String:
    match kind:
        NotFound: "no such file"
        PermissionDenied: "permission denied"
        AlreadyExists: "already exists"
        NotADirectory: "not a directory"
        IsADirectory: "is a directory"
        DirectoryNotEmpty: "directory not empty"
        NotARegularFile: "not a regular file"
        ReadOnlyFilesystem: "read-only file system"
        NoSpace: "no space left on device"
        FileTooLarge: "file too large"
        CrossesDevices: "crosses devices"
        PathContainsNul: "path contains a NUL byte"
        InvalidUtf8: "contents are not valid UTF-8"
        ChangedDuringRemoval: "changed during removal"
        OtherOs(number): "operating system error ${number.to_string()}"


-- "settings.conf: no such file"; "a -> b: crosses devices". The text is fixed
-- per kind, never the operating system's own wording.
pure func describe(error: IOError) -> String:
    match error.destination:
        Some(destination): "${error.path} -> ${destination}: ${error.kind.phrase()}"
        None: "${error.path}: ${error.kind.phrase()}"
