import:
	./check/check: check
	./check/render: render_failure
	./emit/emit: emit
	./format/format: first_changed_line, format_source
	fs: describe, read_text, write_text
	int: Int methods
	io: print, print_error
	list: List methods
	./load/load: LoadedProgram, LoadFailure, SourceFile, SourceInputs, load_program, load_test_program
	./lower/lower: lower
	./own/own: own
	./parse/assemble: ParsedProgram
	option: Option methods
	result: Result methods
	string: String methods
	./utils/source:
		SourceRole(CompilerRole, ModuleRole, InvalidRole), ModuleId, SourceId
	./specialize/specialize: specialize
	./utils/syntax:
		Diagnostic,
		DiagnosticNote(
			UnionPayloadDeclaration, RecordFieldDeclaration, PreviousField,
			PreviousDeclaration, CompetingDeclarations, Declaration, NoteLines,
		),
		Diagnostics, NoteLine, Span, singleton_diagnostic
	./utils/text: concat
	./verify/verify: verify


-- Source loading publishes complete syntax and identities. Every stage here is pure.
pure func compile(program: ParsedProgram) -> Result[String, Diagnostics]:
	checked ?= program.check().map_err(render_failure)
	specialized ?= checked.specialize().map_err(singleton_diagnostic)
	lowered ?= specialized.lower().map_err(singleton_diagnostic)
	owned ?= lowered.own().map_err(singleton_diagnostic)
	verified ?= owned.verify().map_err(singleton_diagnostic)
	verified.emit().map_err(singleton_diagnostic)


private LINE_FEED_BYTE: Int = 10


private pure func render_file_location(file: SourceFile, span: Span) -> String:
	var line: Int = 1
	var column: Int = 1
	var cursor: Int = 0

	while cursor < span.start:
		line_feed = match file.contents.byte_at(cursor):
			Some(byte): byte == LINE_FEED_BYTE
			None: False
		if line_feed:
			line = line + 1
			column = 1
		else:
			column = column + 1

		cursor = cursor + 1

	"${file.path}:${line.to_string()}:${column.to_string()}"


private pure func render_location(inputs: SourceInputs, span: Span) -> Result[String, String]:
	match span.source.source_role():
		CompilerRole:
			Ok("blorp")
		ModuleRole:
			match span.source.source_module().to_result("invalid module source identity in diagnostic"):
				Ok(id):
					match inputs.modules.get(id.module_number()).to_result("diagnostic references a missing module source"):
						Ok(file): Ok(file.render_file_location(span))
						Err(error): Err(error)
				Err(error): Err(error)
		InvalidRole:
			Err("invalid source identity in diagnostic")


private pure func note_lines(note: DiagnosticNote) -> List[NoteLine]:
	match note:
		NoteLines(lines): lines
		UnionPayloadDeclaration(span): [{ span = span, text = "union payload declared here" }]
		Declaration(span): [{ span = span, text = "declared here" }]
		RecordFieldDeclaration(span): [{ span = span, text = "record field declared here" }]
		PreviousField(span): [{ span = span, text = "previous field written here" }]
		PreviousDeclaration(span): [{ span = span, text = "previous declaration or import here" }]
		CompetingDeclarations(spans): spans.map(pure func(location: Span) -> NoteLine: { span = location, text = "candidate declaration or import here" })


-- Every rendered line is a source location followed by its text, so a diagnostic
-- and its notes render the same way.
private record LocatedText {
	span: Span,
	text: String
}


private pure func located_texts(diagnostic: Diagnostic) -> List[LocatedText]:
	headline = ": error: ${diagnostic.message}\nhelp: ${diagnostic.help}"
	var lines: List[LocatedText] = [{ span = diagnostic.span, text = headline }]
	match diagnostic.note:
		None: void
		Some(note):
			for note_line in note.note_lines():
				lines = lines.append({ span = note_line.span, text = ": note: ${note_line.text}" })
	lines


-- Recursion depth is the line count: each phase reports its first error, so a
-- compilation yields a handful. The host handles tens of thousands of frames
-- (30,000 ran, 50,000 overflowed the stack).
private pure func render_lines(inputs: SourceInputs, lines: List[LocatedText], rendered: List[String]) -> Result[List[String], String]:
	match lines.get(rendered.length()):
		None:
			Ok(rendered)
		Some(line):
			match inputs.render_location(line.span):
				Ok(location): inputs.render_lines(lines, rendered.append(location.concat(line.text)))
				Err(error): Err(error)


pure func render_diagnostics(inputs: SourceInputs, errors: Diagnostics) -> String:
	var lines: List[LocatedText] = []
	for error in [errors.first].concat(errors.remaining):
		lines = lines.concat(error.located_texts())
	match inputs.render_lines(lines, []):
		Ok(rendered):
			rendered.join("\n")
		Err(error):
			"blorp: error: ${error}\nhelp: report this compiler error with the input program"


func main(args: List[String]) -> Int:
	match args:
		-- The last path is the output; any paths before it are later suite roots.
		[_, "--library-root", library_root, "--test-suite", root_path, ...later_and_output]:
			match later_and_output.last():
				None: usage_error()
				Some(output_path): root_path.load_test_program(later_and_output.take(later_and_output.length() - 1), library_root).compile_loaded(output_path)
		[_, "--library-root", library_root, input_path, output_path]:
			input_path.load_program(library_root).compile_loaded(output_path)
		[_, "--format", ...paths]: paths.format_files(FormatInPlace)
		[_, "--check", ...paths]: paths.format_files(ReportUnformatted)
		_:
			usage_error()


private func usage_error() -> Int:
	print_error("blorp: error: expected a library root, input and output paths, or a formatting mode and source files\nhelp: run blorp --library-root DIRECTORY INPUT.brp OUTPUT.c, or --library-root DIRECTORY --test-suite SUITE.brp [SUITE.brp ...] OUTPUT.c; run blorp --format FILE.brp [FILE.brp ...] to rewrite files in the canonical layout, or --check FILE.brp [FILE.brp ...] to list the files it would change")
	1


-- What the formatter does with a file whose layout is not canonical.
private union FormatMode:
	FormatInPlace
	ReportUnformatted


-- Formats one source file: 0 when it needed nothing or was rewritten, 1 when it
-- could not be read, parsed or written, or `--check` found it unformatted. An
-- unparsable file prints the parser's diagnostic and is left untouched.
private func format_file(path: String, mode: FormatMode) -> Int:
	match path.read_text():
		Err(error):
			print_error("blorp: error: could not read ${error.describe()}\nhelp: pass each .brp source file to format by its path; directories are not searched")
			1
		Ok(original):
			match original.format_source():
				Err(diagnostic):
					sources: SourceInputs = { modules = [{ path = path, contents = original }] }
					sources.render_diagnostics(diagnostic.singleton_diagnostic()).print_error()
					1
				Ok(formatted):
					if formatted == original:
						0
					else:
						match mode:
							-- write_text replaces the file atomically, as `publish` does.
							FormatInPlace:
								match path.write_text(formatted):
									Err(error):
										print_error("blorp: error: could not write ${error.describe()}\nhelp: make the source file writable, then format it again")
										1
									Ok(_):
										0
							ReportUnformatted:
								print("${path}:${first_changed_line(original, formatted).to_string()}: would reformat")
								1


-- Every file is processed, whatever happens to the others.
private func format_files(paths: List[String], mode: FormatMode) -> Int:
	if paths.is_empty():
		usage_error()
	else:
		var status: Int = 0
		for path in paths:
			if path.format_file(mode) != 0:
				status = 1
		status


-- write_text replaces the output atomically, so a failed or interrupted
-- compile never leaves a truncated C file behind.
private func publish(path: String, generated_c: String) -> Int:
	match path.write_text(generated_c):
		Err(error):
			print_error("blorp: error: could not write ${error.describe()}\nhelp: provide a writable output path")
			1
		Ok(_):
			0


private func compile_loaded(input: Result[LoadedProgram, LoadFailure], output_path: String) -> Int:
	match input:
		Err(failure):
			failure.sources.render_diagnostics(failure.diagnostic.singleton_diagnostic()).print_error()
			1
		Ok(loaded):
			match loaded.program.compile():
				Err(errors):
					loaded.sources.render_diagnostics(errors).print_error()
					1
				Ok(generated_c):
					output_path.publish(generated_c)
