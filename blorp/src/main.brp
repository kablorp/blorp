private CLI_WRAPPER_ERROR_EXIT: Int = 1

private CLI_WRAPPER_SUCCESS_EXIT: Int = 0

private NO_BLORP_FILES_ERROR: String = "Error: no .brp files found"

private TOP_LEVEL_USAGE: String =
	|blorp - Blorp Compiler
	|
	|Usage: blorp <command> [options] [args]
	|
	|Commands:
	|  check      Parse, import, and type check .brp files
	|  compile    Compile a .brp file to C
	|  run        Compile and run a .brp file
	|  test       Run tests (file or directory)
	|  format     Format source files
	|  package    Validate source packages
	|  lsp        Start LSP server
	|  purify     Automatically mark pure functions
	|  lint       Report typed source design findings
	|
	|Flags:
	|  --version  Show version
	|  --help     Show this help
	|
	|Run 'blorp <command> --help' for details on a specific command.
	|
	|Project config:
	|  blorp.toml          Optional project config; [std].path sets std directory
	|
	|Environment:
	|  BLORP_STD=<path>      Use std directory (--std-dir overrides; beats blorp.toml)
	|  BLORP_TIMEOUT=N       Default timeout (CLI flag overrides)
	|  BLORP_TEST_TIMEOUT=N  Default test timeout (test --timeout overrides)
	|  BLORP_SANITIZE=1|address|undefined
	|                         Enable sanitizers (CLI flag overrides)
	|  BLORP_LEAK_CHECK=1    Enable leak reporting (CLI flag overrides)
	|  BLORP_TLS_BACKEND=unsupported|openssl
	|                         Select runtime TLS backend profile (default: unsupported)
	|  BLORP_THREADS=N       Runtime worker thread pool size (run --threads overrides)
	|  BLORP_NO_FORMAT=1     Skip auto-formatting (CLI flag overrides)

private CHECK_HELP: String =
	|Usage: blorp check [options] <file.brp|dir> [...]
	|
	|Options:
	|  --dump-ast                Print AST summary and continue checking
	|  --dump-typed-ast          Print typed AST and continue checking
	|  --capture-typecheck-request PATH
	|                            Write one replayable typecheck graph request and exit
	|  --debug                   Enable debug functions
	|  --no-format               Skip auto-formatting
	|  --std-dir <d>             Use std library from directory
	|
	|Accepts files or directories (recursively finds .brp files).

private COMPILE_HELP: String =
	|Usage: blorp compile [options] <file.brp>
	|
	|Options:
	|  --ast                     Print AST and exit (no typecheck, no emit)
	|  --profile                 Emit function-level profiling instrumentation
	|  --dump-ast                Print AST summary and continue compiling
	|  --dump-typed-ast          Print typed AST and continue compiling
	|  --dump-core               Dump Core IR at the final stage
	|  --dump-core-after=STAGE[,STAGE...]
	|                            Dump Core IR after the given stage(s);
	|                            repeatable and comma-separated both work
	|  --dump-core-file=PATH     Redirect --dump-core output to PATH
	|  --stop-after=STAGE        Stop after the given stage (implies no emit)
	|                            STAGE: lower, debug, desugar, mono, synth, match,
	|                                   trait_resolve, resolve, std_inline, tailrec, fusion,
	|                                   specialize, dce, perceus, reuse, closure, final
	|  --time-phases             Print per-phase compiler wall time to stderr
	|  --check-invariants        Run post-stage IR invariant checks (slower; use for debugging)
	|  --debug                   Enable debug functions
	|  --no-format               Skip auto-formatting
	|  --no-embed-runtime        Emit C that expects an external runtime declaration/header
	|  --std-dir <d>             Use std library from directory
	|  -o <file>                 Output C file path

private RUN_HELP: String =
	|Usage: blorp run [options] <file.brp> [-- args...]
	|
	|Options:
	|  --profile      Run with profiling
	|  --release      Compile generated C with -O2
	|  --debug        Enable debug functions
	|  --sanitize     Compile with AddressSanitizer + UBSan
	|  --sanitize=undefined
	|                 Compile with UBSan only (useful for fiber-heavy runs on Darwin)
	|  --leak-check   Report leaked objects on exit
	|  --no-format    Skip auto-formatting
	|  --timeout N    Kill after N seconds
	|  --threads N    Set max thread pool size
	|  --std-dir <d>  Use std library from directory

private TEST_HELP: String =
	|Usage: blorp test [options] <file.brp | directory> ...
	|
	|Options:
	|  --profile      Run with profiling
	|  --debug        Enable debug functions
	|  --sanitize     Run with AddressSanitizer + UBSan
	|  --sanitize=undefined
	|                 Run with UBSan only (useful for fiber-heavy tests on Darwin)
	|  --leak-check   Report leaked objects on exit
	|  --timeout N    Allow N seconds per generated test artifact (default: 30; 0 disables)
	|  --repeat N     Run selected tests N times
	|  --doc          Run only doctests
	|  --suite        Run only TestSuite tests
	|  --warmup-only  Populate the shared runtime cache, then exit
	|  --std-dir <d>  Use std library from directory

private PURIFY_HELP: String =
	|Usage: blorp purify [options] <file.brp|dir>
	|
	|Options:
	|  --dry-run      Show which functions would be purified without modifying the file
	|  --verbose, -v  Show detailed purification progress

private LINT_HELP: String =
	|Usage: blorp lint [options] <file.brp|dir> [...]
	|
	|Options:
	|  --format human|json  Select output format (default: human)
	|  --fail-on-findings   Exit nonzero when lint findings are reported
	|  --disable RULE_ID    Suppress one rule (repeatable)
	|
	|Lint is report-only. It typechecks the complete import graph but reports
	|findings only for explicitly selected files (or files selected by a directory).

private LSP_HELP: String =
	|Usage: blorp lsp
	|
	|Starts the Language Server Protocol server over stdin/stdout.
	|
	|Options:
	|  --help, -h   Show this help

private PACKAGE_HELP: String =
	|Usage: blorp package <command> [args]
	|
	|Commands:
	|  check <path>          Validate a portable source package directory
	|  hash <path>           Print a portable source package BLAKE3 hash
	|  pack <path> -o <file> Write a deterministic .blorpkg artifact
	|  fetch [hash-or-alias [from ...]] Cache verified package artifacts
	|  vendor [hash-or-alias [path]] Copy cached packages into vendor dirs
	|
	|A source package contains package.toml plus src/*.brp files.
	|Package code may import only std modules and modules from the same package.

private PACKAGE_CHECK_HELP: String =
	|Usage: blorp package check <path>
	|
	|Validates package.toml, exported source files, imports, and the
	|portable-source policy: no foreign declarations and no builtin use.

private PACKAGE_HASH_HELP: String =
	|Usage: blorp package hash <path>
	|
	|Validates a source package and prints its canonical BLAKE3 content hash.

private PACKAGE_PACK_HELP: String =
	|Usage: blorp package pack <path> -o <file>
	|
	|Validates a source package and writes a deterministic source artifact.

private PACKAGE_FETCH_HELP: String =
	|Usage: blorp package fetch
	|       blorp package fetch <alias>
	|       blorp package fetch <hash> <from>...
	|
	|Without arguments, fetches all downloadable packages from blorp.toml.
	|With explicit locations, installs the first matching artifact.
	|With an alias, reads hash and from from the nearest blorp.toml.
	|Locations may be local paths, file:// URLs, or HTTP(S) artifact URLs.

private PACKAGE_VENDOR_HELP: String =
	|Usage: blorp package vendor
	|       blorp package vendor <hash> <path>
	|       blorp package vendor <alias> [path]
	|
	|Without arguments, vendors cached packages from blorp.toml to vendor/<alias>.
	|With an alias, reads the nearest blorp.toml.
	|With a hash, pass an explicit destination path.


private pure func cli_result(status: Int, stdout: String, stderr: String) -> CliHandledResult:
	{
		status = status,
		stdout = stdout,
		stderr = stderr
	}


private pure func handled_error(message: String) -> CliRunPlan:
	CliRunHandled(cli_result(CLI_WRAPPER_ERROR_EXIT, "", message + "\n"))


private pure func handled_stdout(text: String) -> CliRunPlan:
	CliRunHandled(cli_result(CLI_WRAPPER_SUCCESS_EXIT, text + "\n", ""))


private pure func help_text_for_action(action: CliAction) -> Option[String]:
	match action:
		CliCheckHelp:
			Some(CHECK_HELP)
		CliCompileHelp:
			Some(COMPILE_HELP)
		CliRunHelp:
			Some(RUN_HELP)
		CliTestHelp:
			Some(TEST_HELP)
		CliPurifyHelp:
			Some(PURIFY_HELP)
		CliLintHelp:
			Some(LINT_HELP)
		CliLsp(CliLspHelp):
			Some(LSP_HELP)
		CliPackage(CliPackageHelp):
			Some(PACKAGE_HELP)
		CliPackage(CliPackageCheckHelp):
			Some(PACKAGE_CHECK_HELP)
		CliPackage(CliPackageHashHelp):
			Some(PACKAGE_HASH_HELP)
		CliPackage(CliPackagePackHelp):
			Some(PACKAGE_PACK_HELP)
		CliPackage(CliPackageFetchHelp):
			Some(PACKAGE_FETCH_HELP)
		CliPackage(CliPackageVendorHelp):
			Some(PACKAGE_VENDOR_HELP)
		_:
			None


private pure func is_path_under_dir(dir: String, path: String) -> Bool:
	normalized_dir: String = normalize(dir)
	normalized_path: String = normalize(path)
	normalized_path == normalized_dir or normalized_path.starts_with(normalized_dir + "/")


private func should_auto_format_cli_source(path: String) -> Bool:
	cwd: String = getcwd()
	std_dir: String = normalize(join(cwd, "std"))

	source_path: String = if path.starts_with("/"):
		normalize(path)
	else:
		normalize(join(cwd, path))

	not is_path_under_dir(std_dir, source_path)


private func action_uses_auto_format(action: CliAction) -> Bool:
	-- Test discovery is intentionally read-only. Test sources are parsed as-is;
	-- formatting remains an explicit command instead of a test side effect.
	if (
		getenv("BLORP_NO_FORMAT")
			.map(func(value): value == "1")
			.get_or(False)
	):
		False
	else:
		match action:
			CliCheck(args):
				not args.no_format
			CliCompile(args):
				not args.no_format
			CliRun(args):
				not args.no_format
			_:
				False


private pure func format_cli_source_error(
	path: String,
	format_result: FormatCommandResult,
) -> String:
	detail: String = if format_result.stderr != "":
		format_result.stderr.trim_right()
	else if format_result.stdout != "":
		format_result.stdout.trim_right()
	else:
		"failed to format source file `" + path + "`"

	if detail == "":
		"failed to format source file `" + path + "`"
	else:
		detail


private func auto_format_cli_source_if_needed(
	action: CliAction,
	path: String,
) -> Result[Void, String]:
	if action_uses_auto_format(action) and should_auto_format_cli_source(path):
		format_result: FormatCommandResult = run_format_command([path])

		if format_result.status == 0:
			Ok(void)
		else:
			Err(format_cli_source_error(path, format_result))
	else:
		Ok(void)


private func read_cli_source_file_for_action(
	action: CliAction,
	path: String,
) -> Result[CliSourceFile, String]:
	match auto_format_cli_source_if_needed(action, path):
		Ok(_):
			read_cli_source_file(path)
		Err(message):
			Err(message)


private func read_cli_sources_for_action(
	action: CliAction,
	paths: List[String],
) -> Result[List[CliSourceFile], String]:
	var sources: List[CliSourceFile] = []
	var error: Option[String] = None

	for path in paths:
		match error:
			Some(_):
				break
			None:
				match read_cli_source_file_for_action(action, path):
					Ok(source):
						sources = sources.append(source)
					Err(message):
						error = Some(message)

	match error:
		Some(message):
			Err(message)
		None:
			Ok(sources)


private func parsed_source_plan_for_action(
	user_args: List[String],
	action: CliAction,
	supplied_source: Option[CliSourceFile],
) -> Option[CliRunPlan]:
	match frontend_source_for_action(action):
		Some(path):
			setup = source_graph_setup_for_paths(action, [path])

			source_result: Result[CliSourceFile, String] = match supplied_source:
				Some(source):
					if source.path == path:
						Ok(source)
					else:
						Err(
							"payload source path `${source.path}` does not match CLI source `${path}`",
						)
				None:
					read_cli_source_file_for_action(action, path)

			parsed_source: Result[CliParsedSourceFile, String] = match source_result:
				Ok(source):
					parse_cli_source_with_setup(setup, source)
				Err(message):
					Err(message)

			match parsed_source:
				Ok(source):
					match frontend_module_graph_for_roots_with_setup(setup, [source]):
						Ok(graph):
							match action:
								CliCompile(options):
									Some(CliRunCompile({
										args = user_args,
										options = options,
										graph = graph,
									}))
								CliRun(options):
									match resolve_current_run_args_environment(options):
										Ok(resolved_options):
											Some(CliRunSource({
												args = user_args,
												options = resolved_options,
												graph = graph,
											}))
										Err(message):
											Some(handled_error(message))
								_:
									Some(
										handled_error(
											"internal error: frontend source action is not compile or run",
										),
									)
						Err(message):
							Some(handled_error(message))
				Err(message):
					Some(handled_error(message))
		None:
			None


private func check_plan_for_args(user_args: List[String], args: CliCheckArgs) -> CliRunPlan:
	match expand_check_targets(args.paths):
		Ok(expansion):
			match read_cli_sources_for_action(CliCheck(args), expansion.source_paths):
				Ok(sources):
					setup = source_graph_setup_for_paths(
						CliCheck(args),
						sources.map(func(source): source.path),
					)

					match single_explicit_check_source(expansion, sources):
						Some(source):
							match parse_cli_source_with_setup(setup, source):
								Ok(parsed):
									match frontend_module_graph_for_roots_with_setup(
										setup,
										[parsed],
									):
										Ok(graph):
											CliRunCheck({
												args = user_args,
												options = args,
												graph = graph,
											})
										Err(message):
											handled_error(message)
								Err(message):
									handled_error(message)
						None:
							if sources.length() == 0:
								handled_error(NO_BLORP_FILES_ERROR)
							else:
								match parse_cli_sources_with_setup(setup, sources):
									Ok(parsed_sources):
										match frontend_module_graph_for_roots_with_setup(
											setup,
											parsed_sources,
										):
											Ok(graph):
												CliRunCheck({
													args = user_args,
													options = args,
													graph = graph,
												})
											Err(message):
												handled_error(message)
									Err(message):
										handled_error(message)
				Err(message):
					handled_error(message)
		Err(message):
			handled_error(message)


private func purify_plan_for_args(user_args: List[String], args: CliPurifyArgs) -> CliRunPlan:
	match expand_check_targets(args.paths):
		Err(message):
			handled_error(message)
		Ok(expansion):
			source_paths: List[String] = expansion.source_paths.filter(
				func(path): path.ends_with(".brp"),
			)

			if source_paths.length() == 0:
				handled_error(NO_BLORP_FILES_ERROR)
			else:
				match read_cli_sources_for_action(CliPurify(args), source_paths):
					Err(message):
						handled_error(message)
					Ok(sources):
						setup = source_graph_setup_for_paths(
							CliPurify(args),
							sources.map(func(source): source.path),
						)

						match parse_cli_sources_with_setup(setup, sources):
							Err(message):
								handled_error(message)
							Ok(parsed_sources):
								match frontend_module_graph_for_roots_with_setup(
									setup,
									parsed_sources,
								):
									Err(message):
										handled_error(message)
									Ok(graph):
										CliRunPurify({
											args = user_args,
											options = args,
											graph = graph,
										})


private func lint_plan_for_args(user_args: List[String], args: CliLintArgs) -> CliRunPlan:
	match expand_check_targets(args.paths):
		Err(message):
			handled_error(message)
		Ok(expansion):
			source_paths: List[String] = expansion.source_paths.filter(
				func(path): path.ends_with(".brp"),
			)

			if source_paths.length() == 0:
				handled_error(NO_BLORP_FILES_ERROR)
			else:
				match read_cli_sources_for_action(CliLint(args), source_paths):
					Err(message):
						handled_error(message)
					Ok(read_sources):
						sources = read_sources.map(canonical_cli_source_for_graph)
						path_mappings: List[CliLintPathMapping] = read_sources.map(func(source):
							canonical = canonical_cli_source_for_graph(source)
							{
								graph_path = canonical.path,
								display_path = source.path
							}
						)
						setup = source_graph_setup_for_paths(
							CliLint(args),
							sources.map(func(source): source.path),
						)

						match parse_cli_sources_with_setup(setup, sources):
							Err(message):
								handled_error(message)
							Ok(parsed_sources):
								match frontend_module_graph_for_roots_with_setup(
									setup,
									parsed_sources,
								):
									Err(message):
										handled_error(message)
									Ok(graph):
										CliRunLint({
											args = user_args,
											options = args,
											path_mappings = path_mappings,
											graph = graph,
										})


private func run_cli_with_inputs(
	user_args: List[String],
	supplied_source: Option[CliSourceFile],
) -> CliRunPlan:
	action: CliAction = parse_cli_args(user_args)

	match action:
		CliError(message):
			handled_error(message)
		CliUsage(status):
			CliRunHandled(cli_result(status, TOP_LEVEL_USAGE + "\n", ""))
		CliVersion:
			handled_stdout(VERSION_DESCRIPTION)
		_:
			match help_text_for_action(action):
				Some(help_text):
					handled_stdout(help_text)
				None:
					match action:
						CliFormat(_):
							match user_args:
								["format", ...format_args]:
									format_result = run_format_command(format_args)
									CliRunHandled(
										cli_result(
											format_result.status,
											format_result.stdout,
											format_result.stderr,
										),
									)
								_:
									handled_error(
										"internal error: format command missing from CLI args",
									)
						CliTest(args):
							CliRunTest({
								args = user_args,
								command = CliTestExecute(args),
							})
						CliTestWarmupOnly:
							CliRunTest({
								args = user_args,
								command = CliTestWarmup,
							})
						CliPurify(args):
							purify_plan_for_args(user_args, args)
						CliLint(args):
							lint_plan_for_args(user_args, args)
						CliLsp(CliLspRun):
							CliRunLsp
						CliLsp(CliLspHelp):
							handled_stdout(LSP_HELP)
						CliPackage(package_action):
							match package_action:
								CliPackageHelp:
									handled_stdout(PACKAGE_HELP)
								CliPackageCheckHelp:
									handled_stdout(PACKAGE_CHECK_HELP)
								CliPackageCheck(path):
									CliRunPackage({
										args = user_args,
										command = CliPackageRunCheck(path),
									})
								CliPackageHashHelp:
									handled_stdout(PACKAGE_HASH_HELP)
								CliPackageHash(path):
									CliRunPackage({
										args = user_args,
										command = CliPackageRunHash(path),
									})
								CliPackagePackHelp:
									handled_stdout(PACKAGE_PACK_HELP)
								CliPackagePack(pack_args):
									CliRunPackage({
										args = user_args,
										command = CliPackageRunPack(
											pack_args.path,
											pack_args.output,
										),
									})
								CliPackageFetchHelp:
									handled_stdout(PACKAGE_FETCH_HELP)
								CliPackageFetchAll:
									CliRunPackage({
										args = user_args,
										command = CliPackageRunFetchAll,
									})
								CliPackageFetchTarget(target, locations):
									CliRunPackage({
										args = user_args,
										command = CliPackageRunFetchTarget(target, locations),
									})
								CliPackageVendorHelp:
									handled_stdout(PACKAGE_VENDOR_HELP)
								CliPackageVendorAll:
									CliRunPackage({
										args = user_args,
										command = CliPackageRunVendorAll,
									})
								CliPackageVendorTarget(target, dest):
									CliRunPackage({
										args = user_args,
										command = CliPackageRunVendorTarget(target, dest),
									})
						CliCheck(args):
							check_plan_for_args(user_args, args)
						CliCompile(_):
							match parsed_source_plan_for_action(user_args, action, supplied_source):
								Some(plan):
									plan
								None:
									handled_error(
										"internal error: compile action did not produce a source plan",
									)
						CliRun(_):
							match parsed_source_plan_for_action(user_args, action, supplied_source):
								Some(plan):
									plan
								None:
									handled_error(
										"internal error: run action did not produce a source plan",
									)
						CliUsage(_):
							handled_error("internal error: usage action escaped direct handling")
						CliVersion:
							handled_error("internal error: version action escaped direct handling")
						CliCheckHelp:
							handled_error("internal error: check help escaped direct handling")
						CliCompileHelp:
							handled_error("internal error: compile help escaped direct handling")
						CliRunHelp:
							handled_error("internal error: run help escaped direct handling")
						CliTestHelp:
							handled_error("internal error: test help escaped direct handling")
						CliPurifyHelp:
							handled_error("internal error: purify help escaped direct handling")
						CliLintHelp:
							handled_error("internal error: lint help escaped direct handling")
						CliError(_):
							handled_error("internal error: invalid action escaped direct handling")


func run_cli(user_args: List[String]) -> CliRunPlan:
	run_cli_with_inputs(user_args, None)


private BUILD_SYNTHETIC_EXECUTABLE_COMMAND: String = "__compiler-build-synthetic-executable"


private pure func run_plan_uses_raylib(plan: CliRunSourcePlan) -> Bool:
	graph_native_features(plan.graph).contains(BuildRaylib)


private func run_effect_configuration(
	discover_raylib: Bool,
) -> Result[CliRunEffectConfiguration, String]:
	match current_compiler_host_environment(discover_raylib, None, CLI_HOST_CAPTURE_LIMIT):
		Err(error):
			Err("host toolchain discovery failed: ${host_platform_error_message(error)}")
		Ok(host):
			Ok({
				runtime_sources = runtime_sources(),
				host = host,
				host_timeout = None,
				capture_limit = CLI_HOST_CAPTURE_LIMIT,
				temporary_root = temp_dir(),
			})


private func run_handled_result(result: CliHandledResult) -> Int:
	if result.stdout.length() != 0:
		print(result.stdout)

	if result.stderr.length() != 0:
		print_error(result.stderr)

	result.status


private func execute_internal_synthetic_build(host_args: List[String]) -> Option[Int]:
	match host_args:
		[command, source_text_path, logical_source_path, output_path, ...run_options]:
			if command != BUILD_SYNTHETIC_EXECUTABLE_COMMAND:
				None
			else:
				match read_file(source_text_path):
					Err(message):
						print_error("Error: cannot read synthetic source: " + message)
						Some(1)
					Ok(source_text):
						source: CliSourceFile = {
							path = logical_source_path,
							module_name = stem(logical_source_path),
							source_text = source_text
						}
						plan: CliRunPlan = run_cli_with_inputs(
							["run", "--no-format"]
								.concat(run_options)
								.append(logical_source_path),
							Some(source),
						)

						match plan:
							CliRunSource(run_plan):
								match run_effect_configuration(run_plan_uses_raylib(run_plan)):
									Err(message):
										print_error(message)
										Some(1)
									Ok(configuration):
										Some(
											run_handled_result(
												build_run_executable(
													run_plan,
													output_path,
													configuration,
												),
											),
										)
							CliRunHandled(result):
								Some(run_handled_result(result))
							_:
								print_error(
									"Internal error: synthetic source did not produce a run plan",
								)
								Some(1)
		[command, ..._]:
			if command == BUILD_SYNTHETIC_EXECUTABLE_COMMAND:
				print_error((
						"Usage: blorp __compiler-build-synthetic-executable <source-text-path> <logical-"
						+ "source-path> <output-path> [run-options]"
					))
				Some(1)
			else:
				None
		_:
			None


func main(args: List[String]) -> Int:
	host_args: List[String] = args.drop(1)

	match execute_internal_synthetic_build(host_args):
		Some(status):
			status
		None:
			match run_cli(host_args):
				CliRunCheck(check_plan):
					match check_plan.options.capture_typecheck_request:
						Some(path):
							run_handled_result(capture_check_typecheck_request(check_plan, path))
						None:
							run_handled_result(execute_check_plan(check_plan))
				CliRunHandled(result):
					run_handled_result(result)
				CliRunCompile(compile_plan):
					run_handled_result(execute_compile_command(compile_plan, runtime_sources()))
				CliRunSource(run_plan):
					match run_effect_configuration(run_plan_uses_raylib(run_plan)):
						Err(message):
							print_error(message)
							1
						Ok(configuration):
							run_handled_result(execute_run_command(run_plan, configuration))
				CliRunTest(test_plan):
					execute_test_command(test_plan)
				CliRunPurify(purify_plan):
					run_handled_result(execute_purify_plan(purify_plan))
				CliRunLint(lint_plan):
					run_handled_result(execute_lint_plan(lint_plan))
				CliRunLsp:
					run_native_lsp_server()
				CliRunPackage(package_plan):
					run_handled_result(execute_package_plan(package_plan))
