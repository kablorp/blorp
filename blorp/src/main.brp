private pure func cli_result(status: Int, stdout: String, stderr: String) -> CliHandledResult:
	{
		status = status,
		stdout = stdout,
		stderr = stderr
	}


private pure func handled_error(message: String) -> CliRunPlan:
	CliRunHandled(cli_result(CLI_WRAPPER_ERROR_EXIT, "", message + "\n"))


private pure func handled_stdout(text: String) -> CliRunPlan:
	CliRunHandled(cli_result(CLI_WRAPPER_SUCCESS_EXIT, text + "\n", ""))


private pure func help_text_for_action(action: CliAction) -> Option[String]:
	match action:
		CliCheckHelp:
			Some(CHECK_HELP)
		CliCompileHelp:
			Some(COMPILE_HELP)
		CliRunHelp:
			Some(RUN_HELP)
		CliTestHelp:
			Some(TEST_HELP)
		CliPurifyHelp:
			Some(PURIFY_HELP)
		CliLintHelp:
			Some(LINT_HELP)
		CliLsp(CliLspHelp):
			Some(LSP_HELP)
		CliPackage(CliPackageHelp):
			Some(PACKAGE_HELP)
		CliPackage(CliPackageCheckHelp):
			Some(PACKAGE_CHECK_HELP)
		CliPackage(CliPackageHashHelp):
			Some(PACKAGE_HASH_HELP)
		CliPackage(CliPackagePackHelp):
			Some(PACKAGE_PACK_HELP)
		CliPackage(CliPackageFetchHelp):
			Some(PACKAGE_FETCH_HELP)
		CliPackage(CliPackageVendorHelp):
			Some(PACKAGE_VENDOR_HELP)
		_:
			None


private pure func args_after_command(
	user_args: List[String],
	command: String,
) -> Option[List[String]]:
	match user_args:
		[head, ...rest]:
			if head == command:
				Some(rest)
			else:
				None
		[]:
			None


private pure func absolute_normalized_path(cwd: String, path: String) -> String:
	if path.starts_with("/"):
		normalize(path)
	else:
		normalize(join(cwd, path))


private pure func is_path_under_dir(dir: String, path: String) -> Bool:
	normalized_dir: String = normalize(dir)
	normalized_path: String = normalize(path)
	normalized_path == normalized_dir or normalized_path.starts_with(normalized_dir + "/")


private func should_auto_format_cli_source(path: String) -> Bool:
	cwd: String = getcwd()
	std_dir: String = normalize(join(cwd, "std"))
	source_path: String = absolute_normalized_path(cwd, path)

	not is_path_under_dir(std_dir, source_path)


private func action_uses_auto_format(action: CliAction) -> Bool:
	-- Test discovery is intentionally read-only. Test sources are parsed as-is;
	-- formatting remains an explicit command instead of a test side effect.
	if (
		getenv("BLORP_NO_FORMAT")
			.map(func(value): value == "1")
			.get_or(False)
	):
		False
	else:
		match action:
			CliCheck(args):
				not args.no_format
			CliCompile(args):
				not args.no_format
			CliRun(args):
				not args.no_format
			_:
				False


private pure func format_cli_source_error(
	path: String,
	format_result: FormatCommandResult,
) -> String:
	detail: String = if format_result.stderr != "":
		format_result.stderr.trim_right()
	else if format_result.stdout != "":
		format_result.stdout.trim_right()
	else:
		"failed to format source file `" + path + "`"

	if detail == "":
		"failed to format source file `" + path + "`"
	else:
		detail


private func auto_format_cli_source_if_needed(
	action: CliAction,
	path: String,
) -> Result[Void, String]:
	if action_uses_auto_format(action) and should_auto_format_cli_source(path):
		format_result: FormatCommandResult = run_format_command([path])

		if format_result.status == 0:
			Ok(void)
		else:
			Err(format_cli_source_error(path, format_result))
	else:
		Ok(void)


private func read_cli_source_file_for_action(
	action: CliAction,
	path: String,
) -> Result[CliSourceFile, String]:
	match auto_format_cli_source_if_needed(action, path):
		Ok(_):
			read_cli_source_file(path)
		Err(message):
			Err(message)


private func read_cli_sources_for_action(
	action: CliAction,
	paths: List[String],
) -> Result[List[CliSourceFile], String]:
	var sources: List[CliSourceFile] = []
	var error: Option[String] = None

	for path in paths:
		match error:
			Some(_):
				break
			None:
				match read_cli_source_file_for_action(action, path):
					Ok(source):
						sources = sources.append(source)
					Err(message):
						error = Some(message)

	match error:
		Some(message):
			Err(message)
		None:
			Ok(sources)


private func parsed_source_plan_for_action(
	user_args: List[String],
	action: CliAction,
	supplied_source: Option[CliSourceFile],
) -> Option[CliRunPlan]:
	match frontend_source_for_action(action):
		Some(path):
			setup = source_graph_setup_for_paths(action, [path])

			source_result: Result[CliSourceFile, String] = match supplied_source:
				Some(source):
					if source.path == path:
						Ok(source)
					else:
						Err(
							"payload source path `${source.path}` does not match CLI source `${path}`",
						)
				None:
					read_cli_source_file_for_action(action, path)

			parsed_source: Result[CliParsedSourceFile, String] = match source_result:
				Ok(source):
					parse_cli_source_with_setup(setup, source)
				Err(message):
					Err(message)

			match parsed_source:
				Ok(source):
					match frontend_module_graph_for_roots_with_setup(setup, [source]):
						Ok(graph):
							match action:
								CliCompile(options):
									Some(CliRunCompile({
										args = user_args,
										options = options,
										graph = graph,
									}))
								CliRun(options):
									match resolve_current_run_args_environment(options):
										Ok(resolved_options):
											Some(CliRunSource({
												args = user_args,
												options = resolved_options,
												graph = graph,
											}))
										Err(message):
											Some(handled_error(message))
								_:
									Some(
										handled_error(
											"internal error: frontend source action is not compile or run",
										),
									)
						Err(message):
							Some(handled_error(message))
				Err(message):
					Some(handled_error(message))
		None:
			None


private func check_plan_for_args(user_args: List[String], args: CliCheckArgs) -> CliRunPlan:
	match expand_check_targets(args.paths):
		Ok(expansion):
			match read_cli_sources_for_action(CliCheck(args), expansion.source_paths):
				Ok(sources):
					setup = source_graph_setup_for_paths(
						CliCheck(args),
						sources.map(func(source): source.path),
					)

					match single_explicit_check_source(expansion, sources):
						Some(source):
							match parse_cli_source_with_setup(setup, source):
								Ok(parsed):
									match frontend_module_graph_for_roots_with_setup(
										setup,
										[parsed],
									):
										Ok(graph):
											CliRunCheck({
												args = user_args,
												options = args,
												graph = graph,
											})
										Err(message):
											handled_error(message)
								Err(message):
									handled_error(message)
						None:
							if sources.length() == 0:
								handled_error(NO_BLORP_FILES_ERROR)
							else:
								match parse_cli_sources_with_setup(setup, sources):
									Ok(parsed_sources):
										match frontend_module_graph_for_roots_with_setup(
											setup,
											parsed_sources,
										):
											Ok(graph):
												CliRunCheck({
													args = user_args,
													options = args,
													graph = graph,
												})
											Err(message):
												handled_error(message)
									Err(message):
										handled_error(message)
				Err(message):
					handled_error(message)
		Err(message):
			handled_error(message)


private func purify_plan_for_args(user_args: List[String], args: CliPurifyArgs) -> CliRunPlan:
	match expand_check_targets(args.paths):
		Err(message):
			handled_error(message)
		Ok(expansion):
			source_paths: List[String] = expansion.source_paths.filter(
				func(path): path.ends_with(".brp"),
			)

			if source_paths.length() == 0:
				handled_error(NO_BLORP_FILES_ERROR)
			else:
				match read_cli_sources_for_action(CliPurify(args), source_paths):
					Err(message):
						handled_error(message)
					Ok(sources):
						setup = source_graph_setup_for_paths(
							CliPurify(args),
							sources.map(func(source): source.path),
						)

						match parse_cli_sources_with_setup(setup, sources):
							Err(message):
								handled_error(message)
							Ok(parsed_sources):
								match frontend_module_graph_for_roots_with_setup(
									setup,
									parsed_sources,
								):
									Err(message):
										handled_error(message)
									Ok(graph):
										CliRunPurify({
											args = user_args,
											options = args,
											graph = graph,
										})


private func lint_plan_for_args(user_args: List[String], args: CliLintArgs) -> CliRunPlan:
	match expand_check_targets(args.paths):
		Err(message):
			handled_error(message)
		Ok(expansion):
			source_paths: List[String] = expansion.source_paths.filter(
				func(path): path.ends_with(".brp"),
			)

			if source_paths.length() == 0:
				handled_error(NO_BLORP_FILES_ERROR)
			else:
				match read_cli_sources_for_action(CliLint(args), source_paths):
					Err(message):
						handled_error(message)
					Ok(read_sources):
						sources = read_sources.map(canonical_cli_source_for_graph)
						path_mappings: List[CliLintPathMapping] = read_sources.map(func(source):
							canonical = canonical_cli_source_for_graph(source)
							{
								graph_path = canonical.path,
								display_path = source.path
							}
						)
						setup = source_graph_setup_for_paths(
							CliLint(args),
							sources.map(func(source): source.path),
						)

						match parse_cli_sources_with_setup(setup, sources):
							Err(message):
								handled_error(message)
							Ok(parsed_sources):
								match frontend_module_graph_for_roots_with_setup(
									setup,
									parsed_sources,
								):
									Err(message):
										handled_error(message)
									Ok(graph):
										CliRunLint({
											args = user_args,
											options = args,
											path_mappings = path_mappings,
											graph = graph,
										})


private func run_cli_with_inputs(
	user_args: List[String],
	supplied_source: Option[CliSourceFile],
) -> CliRunPlan:
	action: CliAction = parse_cli_args(user_args)

	match action:
		CliError(message):
			handled_error(message)
		CliUsage(status):
			CliRunHandled(cli_result(status, TOP_LEVEL_USAGE + "\n", ""))
		CliVersion:
			handled_stdout(VERSION_DESCRIPTION)
		_:
			match help_text_for_action(action):
				Some(help_text):
					handled_stdout(help_text)
				None:
					match action:
						CliFormat(_):
							match args_after_command(user_args, "format"):
								Some(format_args):
									format_result = run_format_command(format_args)
									CliRunHandled(
										cli_result(
											format_result.status,
											format_result.stdout,
											format_result.stderr,
										),
									)
								None:
									handled_error(
										"internal error: format command missing from CLI args",
									)
						CliTest(args):
							CliRunTest({
								args = user_args,
								command = CliTestExecute(args),
							})
						CliTestWarmupOnly:
							CliRunTest({
								args = user_args,
								command = CliTestWarmup,
							})
						CliPurify(args):
							purify_plan_for_args(user_args, args)
						CliLint(args):
							lint_plan_for_args(user_args, args)
						CliLsp(CliLspRun):
							CliRunLsp
						CliLsp(CliLspHelp):
							handled_stdout(LSP_HELP)
						CliPackage(package_action):
							match package_action:
								CliPackageHelp:
									handled_stdout(PACKAGE_HELP)
								CliPackageCheckHelp:
									handled_stdout(PACKAGE_CHECK_HELP)
								CliPackageCheck(path):
									CliRunPackage({
										args = user_args,
										command = CliPackageRunCheck(path),
									})
								CliPackageHashHelp:
									handled_stdout(PACKAGE_HASH_HELP)
								CliPackageHash(path):
									CliRunPackage({
										args = user_args,
										command = CliPackageRunHash(path),
									})
								CliPackagePackHelp:
									handled_stdout(PACKAGE_PACK_HELP)
								CliPackagePack(pack_args):
									CliRunPackage({
										args = user_args,
										command = CliPackageRunPack(
											pack_args.path,
											pack_args.output,
										),
									})
								CliPackageFetchHelp:
									handled_stdout(PACKAGE_FETCH_HELP)
								CliPackageFetchAll:
									CliRunPackage({
										args = user_args,
										command = CliPackageRunFetchAll,
									})
								CliPackageFetchTarget(target, locations):
									CliRunPackage({
										args = user_args,
										command = CliPackageRunFetchTarget(target, locations),
									})
								CliPackageVendorHelp:
									handled_stdout(PACKAGE_VENDOR_HELP)
								CliPackageVendorAll:
									CliRunPackage({
										args = user_args,
										command = CliPackageRunVendorAll,
									})
								CliPackageVendorTarget(target, dest):
									CliRunPackage({
										args = user_args,
										command = CliPackageRunVendorTarget(target, dest),
									})
						CliCheck(args):
							check_plan_for_args(user_args, args)
						CliCompile(_):
							match parsed_source_plan_for_action(user_args, action, supplied_source):
								Some(plan):
									plan
								None:
									handled_error(
										"internal error: compile action did not produce a source plan",
									)
						CliRun(_):
							match parsed_source_plan_for_action(user_args, action, supplied_source):
								Some(plan):
									plan
								None:
									handled_error(
										"internal error: run action did not produce a source plan",
									)
						CliUsage(_):
							handled_error("internal error: usage action escaped direct handling")
						CliVersion:
							handled_error("internal error: version action escaped direct handling")
						CliCheckHelp:
							handled_error("internal error: check help escaped direct handling")
						CliCompileHelp:
							handled_error("internal error: compile help escaped direct handling")
						CliRunHelp:
							handled_error("internal error: run help escaped direct handling")
						CliTestHelp:
							handled_error("internal error: test help escaped direct handling")
						CliPurifyHelp:
							handled_error("internal error: purify help escaped direct handling")
						CliLintHelp:
							handled_error("internal error: lint help escaped direct handling")
						CliError(_):
							handled_error("internal error: invalid action escaped direct handling")


func run_cli(user_args: List[String]) -> CliRunPlan:
	run_cli_with_inputs(user_args, None)


func run_cli_with_source(user_args: List[String], source: CliSourceFile) -> CliRunPlan:
	run_cli_with_inputs(user_args, Some(source))


private BUILD_SYNTHETIC_EXECUTABLE_COMMAND: String = "__compiler-build-synthetic-executable"

private HOST_CAPTURE_MEBIBYTES: Int = 64


private union CliTestEffectConfiguration:
	CliTestEffectConfigurationReady(CliRunEffectConfiguration)
	CliTestEffectConfigurationInterrupted(Int, Bytes, Bytes)
	CliTestEffectConfigurationFailed(String)


private union CliTestCandidateProgress:
	CliTestCandidateContinue(CliTestArtifactResult)
	CliTestCandidateStop(Int)


private record CliTestExecutionSummary {
	status: Int,
	passed: Int,
	failed: Int,
	session_counters: Option[TestSessionCounters]
}


private record CliTestBatchSummary {
	passed: Int,
	failed: Int,
	terminal: Option[Int]
}


private EMPTY_TEST_SESSION_COUNTERS: TestSessionCounters = {
	discovered_runnable_files = 0,
	unique_discovered_runnable_source_identities = 0,
	retained_runnable_source_bytes = 0,
	declared_test_suites = 0,
	planned_aggregate_suite_harnesses = 0,
	planned_combined_suite_files = 0,
	planned_combined_native_executions = 0,
	planned_individual_source_files = 0
}


private func test_session_counters_requested() -> Bool:
	getenv("BLORP_TEST_TIMINGS")
		.map(func(value): value.trim() == "1")
		.get_or(False)


private pure func test_batch_retained_source_bytes(batch: CliBlorpTestBatchPlan) -> Int:
	var retained_bytes: Int = 0

	for source in batch.sources:
		for root in batch.graph.roots:
			if (
				root.path == source.source_target.path
				and root.module_name == source.source_target.module_name
			):
				retained_bytes += root.source_text
					.to_bytes()
					.length()
				break

	retained_bytes


private pure func test_batch_session_counters(
	mode: CliTestMode,
	batch: CliBlorpTestBatchPlan,
) -> TestSessionCounters:
	suite_files: Int = batch.sources.count(
		func(
			source,
		): (
			not source.is_leak_baseline_program
			and mode != CliTestDocOnly
			and source.features.has_tests_binding
		),
	)
	doctest_files: Int = batch.sources.count(
		func(
			source,
		): (
			not source.is_leak_baseline_program
			and mode != CliTestSuiteOnly
			and source.features.has_doctests
		),
	)
	individual_files: Int = batch.sources.count(func(source): source.is_leak_baseline_program)
	declared_suites: Int = batch.sources.count(func(source): source.features.has_tests_binding)

	aggregate_suite_harnesses: Int = if suite_files > 0:
		1
	else:
		0

	doctest_harnesses: Int = if doctest_files > 0:
		1
	else:
		0

	{
		discovered_runnable_files = batch.sources.length(),
		unique_discovered_runnable_source_identities = batch.sources.length(),
		retained_runnable_source_bytes = test_batch_retained_source_bytes(batch),
		declared_test_suites = declared_suites,
		planned_aggregate_suite_harnesses = aggregate_suite_harnesses,
		planned_combined_suite_files = suite_files,
		planned_combined_native_executions = aggregate_suite_harnesses + doctest_harnesses,
		planned_individual_source_files = individual_files
	}


private pure func add_test_session_counters(
	left: TestSessionCounters,
	right: TestSessionCounters,
) -> TestSessionCounters:
	{
		discovered_runnable_files = left.discovered_runnable_files + right.discovered_runnable_files,
		unique_discovered_runnable_source_identities = left.unique_discovered_runnable_source_identities + right.unique_discovered_runnable_source_identities,
		retained_runnable_source_bytes = left.retained_runnable_source_bytes + right.retained_runnable_source_bytes,
		declared_test_suites = left.declared_test_suites + right.declared_test_suites,
		planned_aggregate_suite_harnesses = left.planned_aggregate_suite_harnesses + right.planned_aggregate_suite_harnesses,
		planned_combined_suite_files = left.planned_combined_suite_files + right.planned_combined_suite_files,
		planned_combined_native_executions = left.planned_combined_native_executions + right.planned_combined_native_executions,
		planned_individual_source_files = left.planned_individual_source_files + right.planned_individual_source_files
	}


-- Keep byte forwarding below formatted I/O so embedded NULs remain intact.
private func write_stdout_bytes(output: Bytes) -> Bool:
	output.length() == 0 or write_cli_stdout(output)


private func write_stderr_bytes(output: Bytes) -> Bool:
	output.length() == 0 or write_cli_stderr(output)


private pure func run_plan_uses_raylib(plan: CliRunSourcePlan) -> Bool:
	graph_native_features(plan.graph).contains(BuildRaylib)


private func run_effect_configuration_for_host(
	host: HostEnvironment,
	capture_limit: DataSize,
) -> CliRunEffectConfiguration:
	{
		runtime_sources = runtime_sources(),
		host = host,
		host_timeout = None,
		capture_limit = capture_limit,
		temporary_root = temp_dir()
	}


private func run_effect_configuration(
	discover_raylib: Bool,
) -> Result[CliRunEffectConfiguration, String]:
	capture_limit = mebibytes(HOST_CAPTURE_MEBIBYTES)

	match current_compiler_host_environment(discover_raylib, None, capture_limit):
		Err(error):
			Err("host toolchain discovery failed: ${host_platform_error_message(error)}")
		Ok(host):
			Ok(run_effect_configuration_for_host(host, capture_limit))


private func test_run_effect_configuration_until(
	discover_raylib: Bool,
	interrupt_requested: () -> Option[Int],
) -> CliTestEffectConfiguration:
	capture_limit = mebibytes(HOST_CAPTURE_MEBIBYTES)
	discovered = current_compiler_host_environment_with_session(
		discover_raylib,
		None,
		capture_limit,
		interrupt_requested,
	)

	match discovered:
		Err(HostPlatformInterrupted(signal, stdout, stderr)):
			CliTestEffectConfigurationInterrupted(signal, stdout, stderr)
		Err(error):
			match interrupt_requested():
				Some(signal):
					CliTestEffectConfigurationInterrupted(signal, bytes(0), bytes(0))
				None:
					CliTestEffectConfigurationFailed(
						"host toolchain discovery failed: ${host_platform_error_message(error)}",
					)
		Ok(host):
			match interrupt_requested():
				Some(signal):
					CliTestEffectConfigurationInterrupted(signal, bytes(0), bytes(0))
				None:
					CliTestEffectConfigurationReady(
						run_effect_configuration_for_host(
							host,
							capture_limit,
						),
					)


private func run_handled_result(result: CliHandledResult) -> Int:
	if result.stdout.length() != 0:
		print(result.stdout)

	if result.stderr.length() != 0:
		print_error(result.stderr)

	result.status


private func write_test_output(stdout: Bytes, stderr: Bytes) -> Bool:
	stdout_written: Bool = write_stdout_bytes(stdout)
	stderr_written: Bool = write_stderr_bytes(stderr)

	if not stdout_written or not stderr_written:
		print_error("Error: cannot forward captured test output")

	stdout_written and stderr_written


private pure func completed_test_result(
	plan: CliBlorpTestSuitePlan,
	result: CliBlorpTestCandidateResult,
) -> CliTestArtifactResult:
	progress: Option[CliTestArtifactResult] = match parse_cli_test_artifact_result(
		result.stderr.to_string(),
	):
		Some(summary):
			Some(summary)
		None:
			parse_cli_test_artifact_result(result.stdout.to_string())

	match plan.kind:
		CliBlorpTestProgramArtifact:
			completed_cli_test_artifact_result(None, result.exit)
		CliBlorpTestSuiteArtifact:
			completed_cli_test_artifact_result(progress, result.exit)
		CliBlorpDoctestArtifact:
			completed_cli_test_artifact_result(progress, result.exit)


private func report_abnormal_test_exit(
	plan: CliBlorpTestSuitePlan,
	result: CliBlorpTestCandidateResult,
) -> Void:
	match result.exit:
		Exited(_):
			void
		Signaled(signal):
			print("FAIL: ${result.target.path} (exit code ${(128 + signal).to_string()})")
		Process.TimedOut:
			seconds: Int = plan.run_plan.options.timeout.get_or(0)
			print("FAIL: ${result.target.path} (timed out after ${seconds.to_string()}s)")


private pure func test_artifact_kind_label(kind: CliBlorpTestArtifactKind) -> String:
	match kind:
		CliBlorpTestSuiteArtifact:
			"suite"
		CliBlorpDoctestArtifact:
			"doctest"
		CliBlorpTestProgramArtifact:
			"program"


private func report_test_artifact_start(plan: CliBlorpTestSuitePlan) -> Int:
	if not plan.emit_artifact_progress:
		0
	else:
		started_at: Int = now_microseconds()
		kind: String = test_artifact_kind_label(plan.kind)
		timeout_seconds: Int = plan.run_plan.options.timeout.get_or(0)

		print_error(
			CLI_TEST_ARTIFACT_START_PREFIX + "kind=" + kind + " sources=" + plan.progress_source_paths
				.length()
				.to_string() + " timeout_seconds=" + timeout_seconds.to_string(),
		)

		for source_path in plan.progress_source_paths:
			print_error(CLI_TEST_ARTIFACT_SOURCE_PREFIX + source_path)

		started_at


private func report_test_artifact_end(plan: CliBlorpTestSuitePlan, started_at: Int) -> Void:
	if plan.emit_artifact_progress:
		duration_ms: Int = (now_microseconds() - started_at) / 1000
		print_error(
			CLI_TEST_ARTIFACT_END_PREFIX + "kind=" + test_artifact_kind_label(
				plan.kind,
			) + " sources=" + plan.progress_source_paths
				.length()
				.to_string() + " duration_ms=" + duration_ms.to_string(),
		)


private func run_materialized_blorp_test(
	plan: CliBlorpTestSuitePlan,
	configuration: CliRunEffectConfiguration,
	runtime: HostRuntimeInput,
	interrupt_requested: () -> Option[Int],
) -> CliTestCandidateProgress:
	started_at: Int = report_test_artifact_start(plan)
	execution: CliBlorpTestCandidateExecution = execute_blorp_test_suite_with_runtime_until(
		plan,
		configuration,
		runtime,
		interrupt_requested,
	)
	report_test_artifact_end(plan, started_at)

	match execution:
		CliBlorpTestCandidateCompleted(result):
			if write_test_output(result.stdout, result.stderr):
				report_abnormal_test_exit(plan, result)
				CliTestCandidateContinue(completed_test_result(plan, result))
			else:
				CliTestCandidateStop(1)
		CliBlorpTestCandidateInterrupted(signal, stdout, stderr):
			if write_test_output(stdout, stderr):
				CliTestCandidateStop(cli_signal_broker_exit_status(signal))
			else:
				CliTestCandidateStop(1)
		CliBlorpTestCandidateFailed(message):
			print_error(message)
			CliTestCandidateStop(1)


private func run_blorp_test_artifact(
	materialized: Result[CliBlorpTestSuitePlan, String],
	configuration: CliRunEffectConfiguration,
	runtime: HostRuntimeInput,
	interrupt_requested: () -> Option[Int],
) -> CliTestCandidateProgress:
	match materialized:
		Err(message):
			print_error(message)
			CliTestCandidateStop(1)
		Ok(artifact):
			run_materialized_blorp_test(artifact, configuration, runtime, interrupt_requested)


private func run_blorp_test_batch_until(
	plan: CliBlorpTestPlan,
	batch: CliBlorpTestBatchPlan,
	configuration: CliRunEffectConfiguration,
	runtime: HostRuntimeInput,
	interrupt_requested: () -> Option[Int],
) -> CliTestBatchSummary:
	var passed: Int = 0
	var failed: Int = 0
	var terminal: Option[Int] = None
	var suite_sources: List[CliBlorpTestSourcePlan] = []
	var doctest_sources: List[CliBlorpTestSourcePlan] = []

	for source in batch.sources:
		if source.is_leak_baseline_program:
			match run_blorp_test_artifact(
				materialize_blorp_test_program(plan, batch, source),
				configuration,
				runtime,
				interrupt_requested,
			):
				CliTestCandidateContinue(artifact_result):
					passed += artifact_result.passed
					failed += artifact_result.failed
				CliTestCandidateStop(exit_status):
					failed += 1
					terminal = Some(exit_status)
		else if plan.mode != CliTestDocOnly and source.features.has_tests_binding:
			suite_sources = suite_sources.append(source)

		if (
			not source.is_leak_baseline_program
			and plan.mode != CliTestSuiteOnly
			and source.features.has_doctests
		):
			doctest_sources = doctest_sources.append(source)

		if terminal.is_some():
			break

	if suite_sources.length() > 0 and terminal.is_none():
		match run_blorp_test_artifact(
			materialize_blorp_test_suites(plan, batch, suite_sources),
			configuration,
			runtime,
			interrupt_requested,
		):
			CliTestCandidateContinue(artifact_result):
				passed += artifact_result.passed
				failed += artifact_result.failed
			CliTestCandidateStop(exit_status):
				failed += 1
				terminal = Some(exit_status)

	if doctest_sources.length() > 0 and terminal.is_none():
		match run_blorp_test_artifact(
			materialize_blorp_doctest_batch(plan, batch, doctest_sources),
			configuration,
			runtime,
			interrupt_requested,
		):
			CliTestCandidateContinue(artifact_result):
				passed += artifact_result.passed
				failed += artifact_result.failed
			CliTestCandidateStop(exit_status):
				failed += 1
				terminal = Some(exit_status)

	{
		passed = passed,
		failed = failed,
		terminal = terminal
	}


private func run_blorp_tests_with_runtime_until(
	plan: CliBlorpTestPlan,
	configuration: CliRunEffectConfiguration,
	runtime: HostRuntimeInput,
	interrupt_requested: () -> Option[Int],
) -> CliTestExecutionSummary:
	var passed: Int = 0
	var failed: Int = 0
	var terminal: Option[Int] = None
	var iteration: Int = 0
	var found_runnable_source: Bool = False

	var session_counters: Option[TestSessionCounters] = if test_session_counters_requested():
		Some(EMPTY_TEST_SESSION_COUNTERS)
	else:
		None

	while iteration < plan.repeat and terminal.is_none():
		match build_blorp_test_batch(plan, plan.candidate_paths):
			Err(message):
				print_error(message)
				failed += 1
				terminal = Some(1)
			Ok(None):
				print_error("Error: no runnable tests found")
				failed += 1
				terminal = Some(1)
			Ok(Some(batch)):
				found_runnable_source = True

				if iteration == 0:
					match session_counters:
						Some(counters):
							session_counters = Some(
								add_test_session_counters(
									counters,
									test_batch_session_counters(plan.mode, batch),
								),
							)
						None:
							void

				batch_summary: CliTestBatchSummary = run_blorp_test_batch_until(
					plan,
					batch,
					configuration,
					runtime,
					interrupt_requested,
				)
				passed += batch_summary.passed
				failed += batch_summary.failed
				terminal = batch_summary.terminal

		iteration += 1

		-- Complete the compiled test corpus so failures are fully reported, but do
		-- not repeat a failed iteration.
		if failed > 0:
			break

	default_status: Int = if failed == 0:
		0
	else:
		1

	status: Int = terminal.get_or(default_status)

	reported_counters: Option[TestSessionCounters] = if found_runnable_source:
		session_counters
	else:
		None

	{
		status = status,
		passed = passed,
		failed = failed,
		session_counters = reported_counters
	}


private pure func failed_test_execution(status: Int) -> CliTestExecutionSummary:
	{
		status = status,
		passed = 0,
		failed = 1,
		session_counters = None
	}


private func run_blorp_tests_until(
	plan: CliBlorpTestPlan,
	interrupt_requested: () -> Option[Int],
) -> CliTestExecutionSummary:
	-- Batch graphs are built after host discovery so only one host probe is
	-- needed. Raylib discovery is best-effort and safely covers any later batch.
	match test_run_effect_configuration_until(True, interrupt_requested):
		CliTestEffectConfigurationFailed(message):
			print_error(message)
			failed_test_execution(1)
		CliTestEffectConfigurationInterrupted(signal, stdout, stderr):
			if write_test_output(stdout, stderr):
				failed_test_execution(cli_signal_broker_exit_status(signal))
			else:
				failed_test_execution(1)
		CliTestEffectConfigurationReady(configuration):
			match prepare_blorp_test_runtime_until(
				plan.run_options,
				configuration,
				interrupt_requested,
			):
				CliBlorpTestRuntimeInterrupted(signal, stdout, stderr):
					if write_test_output(stdout, stderr):
						failed_test_execution(cli_signal_broker_exit_status(signal))
					else:
						failed_test_execution(1)
				CliBlorpTestRuntimeReady(runtime):
					run_blorp_tests_with_runtime_until(
						plan,
						configuration,
						runtime,
						interrupt_requested,
					)


private func run_blorp_tests(plan: CliBlorpTestPlan) -> CliTestExecutionSummary:
	brokered = with_cli_signal_broker(
		func(interrupt_requested): run_blorp_tests_until(plan, interrupt_requested),
	)

	match brokered.trailing_signal:
		Some(signal):
			reported_failed: Int = if brokered.value.failed == 0:
				1
			else:
				brokered.value.failed

			{
				status = cli_signal_broker_exit_status(signal),
				passed = brokered.value.passed,
				failed = reported_failed,
				session_counters = brokered.value.session_counters
			}
		None:
			brokered.value


private TEST_WARMUP_OPTIONS: CliRunArgs = {
	profile = False,
	debug = True,
	sanitizer = None,
	leak_check = False,
	release = False,
	no_format = True,
	timeout = Some(30),
	threads = None,
	std_dir = None,
	files = [],
	user_args = []
}


private func run_blorp_test_warmup_until(interrupt_requested: () -> Option[Int]) -> Int:
	match test_run_effect_configuration_until(False, interrupt_requested):
		CliTestEffectConfigurationFailed(message):
			print_error(message)
			1
		CliTestEffectConfigurationInterrupted(signal, stdout, stderr):
			if write_test_output(stdout, stderr):
				cli_signal_broker_exit_status(signal)
			else:
				1
		CliTestEffectConfigurationReady(configuration):
			match prepare_blorp_test_runtime_until(
				TEST_WARMUP_OPTIONS,
				configuration,
				interrupt_requested,
			):
				CliBlorpTestRuntimeInterrupted(signal, stdout, stderr):
					if write_test_output(stdout, stderr):
						cli_signal_broker_exit_status(signal)
					else:
						1
				CliBlorpTestRuntimeReady(runtime):
					match runtime:
						HostPrecompiledRuntimeInput(_):
							0
						HostEmbeddedRuntime(_):
							print_error(
								"Error: test runtime warmup could not populate the runtime cache",
							)
							1


private func run_blorp_test_warmup() -> Int:
	brokered = with_cli_signal_broker(run_blorp_test_warmup_until)

	match brokered.trailing_signal:
		Some(signal):
			cli_signal_broker_exit_status(signal)
		None:
			brokered.value


private func report_test_gate_result(summary: CliTestExecutionSummary) -> Void:
	match getenv("BLORP_GATE_RESULT"):
		Some(gate):
			if (
				gate
					.trim()
					.length() > 0
			):
				status: String = if summary.status == 0:
					"PASS"
				else:
					"FAIL"

				total: Int = summary.passed + summary.failed
				print(
					"BLORP_GATE_RESULT gate=${gate.trim()} status=${status} passed=${summary.passed.to_string()} failed=${summary.failed.to_string()} tests=${total.to_string()}",
				)
		None:
			void


private func report_test_session_counters(summary: CliTestExecutionSummary) -> Void:
	match summary.session_counters:
		Some(counters):
			print_error(render_test_session_totals(counters))
		None:
			void


private func execute_test_plan(test_plan: CliTestRunPlan) -> Int:
	match test_plan.command:
		CliTestWarmup:
			run_blorp_test_warmup()
		CliTestExecute(_):
			summary: CliTestExecutionSummary = match plan_blorp_tests(test_plan):
				CliBlorpTestPlanningFailed(message):
					print_error(message)
					failed_test_execution(1)
				CliBlorpTestReady(plan):
					run_blorp_tests(plan)

			report_test_session_counters(summary)
			report_test_gate_result(summary)
			summary.status


private func execute_internal_synthetic_build(host_args: List[String]) -> Option[Int]:
	match host_args:
		[command, source_text_path, logical_source_path, output_path, ...run_options]:
			if command != BUILD_SYNTHETIC_EXECUTABLE_COMMAND:
				None
			else:
				match read_file(source_text_path):
					Err(message):
						print_error("Error: cannot read synthetic source: " + message)
						Some(1)
					Ok(source_text):
						source: CliSourceFile = {
							path = logical_source_path,
							module_name = stem(logical_source_path),
							source_text = source_text
						}
						plan: CliRunPlan = run_cli_with_source(
							["run", "--no-format"]
								.concat(run_options)
								.append(logical_source_path),
							source,
						)

						match plan:
							CliRunSource(run_plan):
								match run_effect_configuration(run_plan_uses_raylib(run_plan)):
									Err(message):
										print_error(message)
										Some(1)
									Ok(configuration):
										Some(
											run_handled_result(
												build_run_executable(
													run_plan,
													output_path,
													configuration,
												),
											),
										)
							CliRunHandled(result):
								Some(run_handled_result(result))
							_:
								print_error(
									"Internal error: synthetic source did not produce a run plan",
								)
								Some(1)
		[command, ..._]:
			if command == BUILD_SYNTHETIC_EXECUTABLE_COMMAND:
				print_error((
						"Usage: blorp __compiler-build-synthetic-executable <source-text-path> <logical-"
						+ "source-path> <output-path> [run-options]"
					))
				Some(1)
			else:
				None
		_:
			None


private func execute_cli_plan(plan: CliRunPlan) -> Int:
	match plan:
		CliRunCheck(check_plan):
			match check_plan.options.capture_typecheck_request:
				Some(path):
					run_handled_result(capture_check_typecheck_request(check_plan, path))
				None:
					run_handled_result(execute_check_plan(check_plan))
		CliRunHandled(result):
			run_handled_result(result)
		CliRunCompile(compile_plan):
			run_handled_result(execute_compile_command(compile_plan, runtime_sources()))
		CliRunSource(run_plan):
			match run_effect_configuration(run_plan_uses_raylib(run_plan)):
				Err(message):
					print_error(message)
					1
				Ok(configuration):
					run_handled_result(execute_run_command(run_plan, configuration))
		CliRunTest(test_plan):
			execute_test_plan(test_plan)
		CliRunPurify(purify_plan):
			run_handled_result(execute_purify_plan(purify_plan))
		CliRunLint(lint_plan):
			run_handled_result(execute_lint_plan(lint_plan))
		CliRunLsp:
			run_native_lsp_server()
		CliRunPackage(package_plan):
			run_handled_result(execute_package_plan(package_plan))


private func run_cli_main(args: List[String]) -> Int:
	host_args: List[String] = args.drop(1)

	match execute_internal_synthetic_build(host_args):
		Some(status):
			status
		None:
			execute_cli_plan(run_cli(host_args))


func main(args: List[String]) -> Int:
	run_cli_main(args)
