foreign(include: "main_output.h"):
	@no_copy func write_all_to_descriptor(
		descriptor: Int,
		output: Bytes,
	) -> Int = "blorp_compiler_cli_write_all"


private POSIX_STANDARD_OUTPUT_DESCRIPTOR: Int = 1

private POSIX_STANDARD_ERROR_DESCRIPTOR: Int = 2


func write_cli_stdout(output: Bytes) -> Bool:
	write_all_to_descriptor(POSIX_STANDARD_OUTPUT_DESCRIPTOR, output) != 0


func write_cli_stderr(output: Bytes) -> Bool:
	write_all_to_descriptor(POSIX_STANDARD_ERROR_DESCRIPTOR, output) != 0


-- A negative signal number is the runtime's private control encoding for
-- restoring the signal disposition that preceded this scope; public
-- `raise_signal` exposes only typed positive signals.
private func restore_signal_disposition_builtin(encoded_signal: Int) -> Void:
	builtin("blorp_signal_raise")


private SHELL_SIGNAL_STATUS_BASE: Int = 128


record CliSignalBrokerResult[T] {
	value: T,
	trailing_signal: Option[Int]
}


private func ignore_termination_signal() -> Void:
	void


private pure func interrupt_signal_number() -> Int:
	builtin("blorp_signal_interrupt")


private pure func terminate_signal_number() -> Int:
	builtin("blorp_signal_terminate")


private func cli_signal_broker_interrupt_requested() -> Option[Int]:
	if signal_received(Interrupt):
		Some(interrupt_signal_number())
	else if signal_received(Terminate):
		Some(terminate_signal_number())
	else:
		None


private func restore_signal_disposition(signal: Signal, signal_number: Int) -> Bool:
	pending_before_restore: Bool = signal_received(signal)
	restore_signal_disposition_builtin(0 - signal_number)
	pending_before_restore or signal_received(signal)


func with_cli_signal_broker[T](operation: (() -> Option[Int]) -> T) -> CliSignalBrokerResult[T]:
	on_interrupt(ignore_termination_signal)
	on_terminate(ignore_termination_signal)
	value: T = operation(cli_signal_broker_interrupt_requested)
	interrupt_pending: Bool = restore_signal_disposition(Interrupt, interrupt_signal_number())
	terminate_pending: Bool = restore_signal_disposition(Terminate, terminate_signal_number())

	trailing_signal: Option[Int] = if interrupt_pending:
		Some(interrupt_signal_number())
	else if terminate_pending:
		Some(terminate_signal_number())
	else:
		None

	{
		value = value,
		trailing_signal = trailing_signal
	}


pure func cli_signal_broker_exit_status(signal: Int) -> Int:
	SHELL_SIGNAL_STATUS_BASE + signal


private CLI_WRAPPER_ERROR_EXIT: Int = 1

private CLI_WRAPPER_SUCCESS_EXIT: Int = 0

private NO_BLORP_FILES_ERROR: String = "Error: no .brp files found"

private TOP_LEVEL_USAGE: String =
	|blorp - Blorp Compiler
	|
	|Usage: blorp <command> [options] [args]
	|
	|Commands:
	|  check      Parse, import, and type check .brp files
	|  compile    Compile a .brp file to C
	|  run        Compile and run a .brp file
	|  test       Run tests (file or directory)
	|  format     Format source files
	|  package    Validate source packages
	|  lsp        Start LSP server
	|  purify     Automatically mark pure functions
	|  lint       Report typed source design findings
	|
	|Flags:
	|  --version  Show version
	|  --help     Show this help
	|
	|Run 'blorp <command> --help' for details on a specific command.
	|
	|Project config:
	|  blorp.toml          Optional project config; [std].path sets std directory
	|
	|Environment:
	|  BLORP_STD=<path>      Use std directory (--std-dir overrides; beats blorp.toml)
	|  BLORP_TIMEOUT=N       Default timeout (CLI flag overrides)
	|  BLORP_TEST_TIMEOUT=N  Default test timeout (test --timeout overrides)
	|  BLORP_SANITIZE=1|address|undefined
	|                         Enable sanitizers (CLI flag overrides)
	|  BLORP_LEAK_CHECK=1    Enable leak reporting (CLI flag overrides)
	|  BLORP_TLS_BACKEND=unsupported|openssl
	|                         Select runtime TLS backend profile (default: unsupported)
	|  BLORP_THREADS=N       Runtime worker thread pool size (run --threads overrides)
	|  BLORP_NO_FORMAT=1     Skip auto-formatting (CLI flag overrides)

