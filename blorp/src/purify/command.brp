-- Blorp-owned `blorp purify` analysis and execution.
--
-- Purification is module-local. Resolved calls to other eligible functions in
-- the same file form dependencies; every other impure requirement is a
-- blocker. Computing the greatest supported candidate set allows direct and
-- mutual recursion without treating names as identities.
import:
	../compiler/pipeline: typecheck_frontend_root, typecheck_frontend_root_only
	../compiler/stage_03_parse/parsed_ast: parsed_function_body_is_builtin
	../compiler/stage_03_parse/source_ast_finalize: finalized_typecheck_program_ast
	../compiler/stage_04_modules/frontend_graph: FrontendModule, frontend_graph_root_modules
	../compiler/stage_05_types/semantic_type: SemanticType(SemanticFunctionType)
	../compiler/stage_06_typecheck/bridge: TypecheckedModule
	../compiler/stage_06_typecheck/decl:
		TypedDecl(TypedFunctionDecl, TypedPrivateDecl),
		TypedFunctionInfo,
	../compiler/stage_06_typecheck/infer:
		PurityRequirement(PurityKnownCallRequirement),
		typed_expr_module_assign_names,
		typed_expr_purity_requirements,
	../lib/cli_plan: CliHandledResult, CliPurifyRunPlan, CliSourceFile
	../lib/diagnostic: cli_error_message
	../lib/frontend_validation: typechecked_graph_errors
	../lib/source_graph:
		CliSourceGraphSetup,
		frontend_compilation_graph_for_roots_with_setup,
		parse_cli_source_with_setup,
	fs: message, write_text_atomic


record PurifyCandidate {
	callable_id: Int,
	name: String,
	keyword_offset: Int,
	dependencies: List[Int],
	has_external_blocker: Bool
}


record PurifyFileEdit {
	path: String,
	module_name: String,
	rewritten_source: String,
	function_names: List[String]
}


private record PurifyWriteFailure {
	message: String,
	written_paths: List[String]
}


private pure func append_output_line(output: String, line: String) -> String:
	if output.length() == 0:
		line
	else:
		output + "\n" + line


private pure func append_unique_int(values: List[Int], value: Int) -> List[Int]:
	if values.contains(value):
		values
	else:
		values.append(value)


private pure func top_level_function_info(decl: TypedDecl) -> List[TypedFunctionInfo]:
	match decl:
		TypedFunctionDecl(info):
			[info]
		TypedPrivateDecl(inner):
			top_level_function_info(inner)
		_:
			[]


private pure func function_name_counts(functions: List[TypedFunctionInfo]) -> Dict[String, Int]:
	var counts: Dict[String, Int] = {}

	for info in functions:
		name: String = info.decl.name.text
		counts = counts.set(name, counts.get_or(name, 0) + 1)

	counts


private pure func is_impure_callback_type(typ: SemanticType) -> Bool:
	match typ:
		SemanticFunctionType(is_pure, _, _):
			not is_pure
		_:
			False


private pure func function_can_be_purify_candidate(
	info: TypedFunctionInfo,
	name_counts: Dict[String, Int],
) -> Bool:
	(
		not info.decl.is_pure
		and info.callable_id.is_some()
		and info.body.is_some()
		and info.decl.keyword_span.is_some()
		and not parsed_function_body_is_builtin(info.decl.body)
		and name_counts.get_or(info.decl.name.text, 0) == 1
		and not info.param_types.any(is_impure_callback_type)
	)


private pure func purify_candidate_ids(
	functions: List[TypedFunctionInfo],
	name_counts: Dict[String, Int],
) -> List[Int]:
	functions.filter_map(func(info):
		if function_can_be_purify_candidate(info, name_counts):
			info.callable_id
		else:
			None
	)


private pure func classify_purity_requirements(
	requirements: List[PurityRequirement],
	candidate_ids: List[Int],
) -> (List[Int], Bool):
	var dependencies: List[Int] = []
	var has_external_blocker: Bool = False

	for requirement in requirements:
		match requirement:
			PurityKnownCallRequirement(_, callable_id):
				if candidate_ids.contains(callable_id):
					dependencies = append_unique_int(dependencies, callable_id)
				else:
					has_external_blocker = True
			_:
				has_external_blocker = True

	(dependencies, has_external_blocker)


private pure func purify_candidate(
	info: TypedFunctionInfo,
	candidate_ids: List[Int],
) -> Option[PurifyCandidate]:
	match (info.callable_id, info.body, info.decl.keyword_span):
		(Some(callable_id), Some(body), Some(keyword_span)):
			match classify_purity_requirements(typed_expr_purity_requirements(body), candidate_ids):
				(dependencies, has_external_requirement):
					Some({
						callable_id = callable_id,
						name = info.decl.name.text,
						keyword_offset = keyword_span.start_offset,
						dependencies = dependencies,
						has_external_blocker = (
							has_external_requirement
							or typed_expr_module_assign_names(body).length() > 0
						),
					})
		_:
			None


private pure func purify_candidates(module: TypecheckedModule) -> List[PurifyCandidate]:
	functions: List[TypedFunctionInfo] = module.typed_program.decls.flat_map(
		top_level_function_info,
	)
	name_counts: Dict[String, Int] = function_name_counts(functions)
	candidate_ids: List[Int] = purify_candidate_ids(functions, name_counts)

	functions.filter_map(func(info):
		if function_can_be_purify_candidate(info, name_counts):
			purify_candidate(info, candidate_ids)
		else:
			None
	)


private pure func candidate_dependencies_are_viable(
	candidate: PurifyCandidate,
	viable_ids: List[Int],
) -> Bool:
	var viable: Bool = True

	for dependency in candidate.dependencies:
		if not viable_ids.contains(dependency):
			viable = False
			break

	viable


private pure func greatest_viable_candidate_ids(candidates: List[PurifyCandidate]) -> List[Int]:
	var viable_ids: List[Int] = []

	for candidate in candidates:
		if not candidate.has_external_blocker:
			viable_ids = viable_ids.append(candidate.callable_id)

	var changed: Bool = True

	while changed:
		var next_ids: List[Int] = []

		for candidate in candidates:
			if (
				viable_ids.contains(candidate.callable_id)
				and candidate_dependencies_are_viable(candidate, viable_ids)
			):
				next_ids = next_ids.append(candidate.callable_id)

		changed = next_ids.length() != viable_ids.length()
		viable_ids = next_ids

	viable_ids


pure func purifiable_candidates(module: TypecheckedModule) -> List[PurifyCandidate]:
	candidates: List[PurifyCandidate] = purify_candidates(module)
	viable_ids: List[Int] = greatest_viable_candidate_ids(candidates)

	candidates.filter(func(candidate): viable_ids.contains(candidate.callable_id))


pure func purify_rewrite_source(source: String, candidates: List[PurifyCandidate]) -> String:
	ordered: List[PurifyCandidate] = candidates.sort_by(
		func(candidate: PurifyCandidate): candidate.keyword_offset,
	)
	var rewritten: String = source

	for candidate in ordered.reverse():
		rewritten = rewritten.insert(candidate.keyword_offset, "pure ")

	rewritten


private pure func purify_file_edit(
	root: FrontendModule,
	module: TypecheckedModule,
) -> PurifyFileEdit:
	candidates: List[PurifyCandidate] = purifiable_candidates(module)
	program = finalized_typecheck_program_ast(root.program)

	{
		path = program.source.path,
		module_name = program.source.module_name,
		rewritten_source = purify_rewrite_source(program.source.text, candidates),
		function_names = candidates.map(func(candidate): candidate.name)
	}


private func validation_errors(plan: CliPurifyRunPlan, edit: PurifyFileEdit) -> List[String]:
	setup: CliSourceGraphSetup = {
		context = plan.graph.context,
		diagnostics = []
	}
	source: CliSourceFile = {
		path = edit.path,
		module_name = edit.module_name,
		source_text = edit.rewritten_source
	}

	parsed = parse_cli_source_with_setup(setup, source)

	match frontend_compilation_graph_for_roots_with_setup(setup, [parsed]):
		Err(message):
			[message]
		Ok(graph):
			if graph.diagnostics.length() > 0:
				graph.diagnostics.map(cli_error_message)
			else:
				match frontend_graph_root_modules(graph.graph):
					[root, ..._]:
						typechecked_graph_errors(typecheck_frontend_root(graph, root, False))
					[]:
						["internal error: purify validation graph has no root"]


private func validate_edits(plan: CliPurifyRunPlan, edits: List[PurifyFileEdit]) -> List[String]:
	var errors: List[String] = []

	for edit in edits:
		errors = errors.concat(validation_errors(plan, edit))

	errors


private func write_edits(edits: List[PurifyFileEdit]) -> Result[Void, PurifyWriteFailure]:
	var error: Option[PurifyWriteFailure] = None
	var written_paths: List[String] = []

	for edit in edits:
		match write_text_atomic(edit.path, edit.rewritten_source):
			Ok(_):
				written_paths = written_paths.append(edit.path)
			Err(err):
				error = Some({
					message = "failed to write `${edit.path}`: ${message(err)}",
					written_paths = written_paths,
				})
				break

	match error:
		Some(failure):
			Err(failure)
		None:
			Ok(void)


private pure func purify_write_failure_message(failure: PurifyWriteFailure) -> String:
	if failure.written_paths.length() == 0:
		failure.message
	else:
		failure.message + "\nPurify already updated: " + failure.written_paths.join(", ")


private pure func purify_dry_run_output(edits: List[PurifyFileEdit], verbose: Bool) -> String:
	var output: String = ""

	for edit in edits:
		if edit.function_names.length() > 0:
			names: String = edit.function_names.join(", ")
			output = append_output_line(
				output,
				"[DRY-RUN] Functions that could be purified in ${edit.path}: ${names}",
			)
		else if verbose:
			output = append_output_line(output, "No functions to purify in ${edit.path}.")

	output


private pure func purify_write_output(
	all_edits: List[PurifyFileEdit],
	modified: List[PurifyFileEdit],
	verbose: Bool,
) -> String:
	var output: String = ""
	var total_functions: Int = 0

	for edit in all_edits:
		if edit.function_names.length() == 0:
			if verbose:
				output = append_output_line(output, "No functions to purify in ${edit.path}.")
		else:
			total_functions += edit.function_names.length()
			output = append_output_line(
				output,
				"Purified ${edit.function_names.length()} function(s) in ${edit.path}",
			)

	if modified.length() > 1 or modified.length() == 1 and all_edits.length() > 1:
		output = append_output_line(
			output,
			"Total: Purified ${total_functions} function(s) across ${modified.length()} file(s).",
		)

	output


func execute_purify_plan(plan: CliPurifyRunPlan) -> CliHandledResult:
	var edits: List[PurifyFileEdit] = []
	var errors: List[String] = plan.graph.diagnostics.map(cli_error_message)
	var dependencies_checked: Bool = False

	if errors.length() == 0:
		for root in frontend_graph_root_modules(plan.graph.graph):
			typechecked = if dependencies_checked:
				typecheck_frontend_root_only(plan.graph, root, False)
			else:
				typecheck_frontend_root(plan.graph, root, False)

			dependencies_checked = True
			root_errors: List[String] = typechecked_graph_errors(typechecked)

			if root_errors.length() == 0:
				edits = edits.append(purify_file_edit(root, typechecked.target))
			else:
				errors = errors.concat(root_errors)

	modified: List[PurifyFileEdit] = edits.filter(func(edit): edit.function_names.length() > 0)

	if errors.length() == 0 and not plan.options.dry_run:
		errors = validate_edits(plan, modified)

	if errors.length() > 0:
		{
			status = 1,
			stdout = "",
			stderr = errors.join("\n")
		}
	else if plan.options.dry_run:
		{
			status = 0,
			stdout = purify_dry_run_output(edits, plan.options.verbose),
			stderr = ""
		}
	else:
		match write_edits(modified):
			Err(failure):
				{
					status = 1,
					stdout = "",
					stderr = purify_write_failure_message(failure)
				}
			Ok(_):
				{
					status = 0,
					stdout = purify_write_output(edits, modified, plan.options.verbose),
					stderr = ""
				}
