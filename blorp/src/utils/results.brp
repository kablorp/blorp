---
Loops over a list of fallible steps that stop at the first failure, for every
phase that reports its first error. Both are generic over the error type
because the checker fails with a `CheckError` and later phases with a
`Diagnostic`.

A step cannot use `?=`, which a lambda body rejects; a loop whose step needs it,
or that carries other state, stays a hand loop.
---
import:
	list: List methods


-- Maps every value, stopping at and returning the first failure. Values after
-- the failing one are not translated.
pure func translated_list[T, U, E](values: List[T], translate: pure (T) -> Result[U, E]) -> Result[List[U], E]:
	var translated: List[U] = []
	var failure: Option[E] = None

	for value in values:
		match translate(value):
			Ok(translated_value):
				translated = translated.append(translated_value)
			Err(error):
				failure = Some(error)
				break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(translated)


-- Checks every value, stopping at and returning the first failure. Values after
-- the failing one are not checked.
pure func first_error[T, E](values: List[T], check: pure (T) -> Result[Void, E]) -> Result[Void, E]:
	var failure: Option[E] = None

	for value in values:
		match check(value):
			Ok(_): void
			Err(error):
				failure = Some(error)
				break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(void)
