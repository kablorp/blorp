-- Typed host-C compilation policy and effect boundary.
--
-- Argument construction is pure and preserves argv boundaries. The effect
-- runner delegates streaming and process-group cleanup to process.run_command.
import:
	build_artifact:
		BuildArtifact,
		BuildNativeFeature(BuildRaylib),
		BuildOptimization(BuildFast, BuildRelease),
		BuildPlatform(BuildLinux, BuildMacos),
		BuildRuntimeRequirement(BuildEmbeddedRuntime, BuildExternalRuntime),
		BuildSanitizer(BuildAddressUndefinedSanitizer, BuildNoSanitizer, BuildUndefinedSanitizer),
		BuildSourceIdentity,
		SCRATCH_SHARED_HEADER_NAME,
		build_c_invocation,
	channel: ConcurrencyError(Cancelled, TaskFailed, Timeout)
	fs: IOError, write_text_atomic
	function_profile: function_profile_runtime_c_prelude
	process as Process
	runtime_sources: RuntimeSources
	units: DataSize, Duration


enum HostCCompilerFamily:
	HostClang
	HostGcc
	HostOtherCompiler


record HostCCompiler {
	program: String,
	prefix_arguments: List[String],
	family: HostCCompilerFamily
}


enum HostTlsBackend:
	HostTlsUnsupported
	HostTlsOpenSsl


record HostTlsConfiguration {
	backend: HostTlsBackend,
	runtime_arguments: List[String],
	link_arguments: List[String]
}


record HostPrecompiledRuntime {
	object_path: String,
	declarations_path: String,
	tls_backend: HostTlsBackend
}


union HostRuntimeInput:
	HostEmbeddedRuntime(RuntimeSources)
	HostPrecompiledRuntimeInput(HostPrecompiledRuntime)


record HostCConfiguration {
	platform: BuildPlatform,
	compiler: HostCCompiler,
	tls: HostTlsConfiguration,
	raylib_prefix: Option[String],
	timeout: Option[Duration],
	capture_limit: DataSize
}


record HostCPreparedCompilation {
	command: Process.ProcessCommand,
	output_path: String,
	source: BuildSourceIdentity
}


union HostCPreparationError:
	HostEmbeddedRuntimeUnavailable
	HostRuntimeRequirementMismatch
	HostRuntimeTlsMismatch
	HostTranslationUnitShapeMismatch


union HostCCompileError:
	HostCProcessFailed(Process.ProcessError)
	HostCTranslationUnitTaskFailed(String)
	HostCCompilerRejected(Int, String)
	HostCCompilerSignaled(Int, String)
	HostCCompilerTimedOut(String)


pure func host_c_preparation_error_message(error: HostCPreparationError) -> String:
	match error:
		HostEmbeddedRuntimeUnavailable:
			"embedded compiler runtime source is unavailable"
		HostRuntimeRequirementMismatch:
			"build artifact and host runtime inputs are incompatible"
		HostRuntimeTlsMismatch:
			"cached runtime TLS configuration does not match the host configuration"
		HostTranslationUnitShapeMismatch:
			(
				"build artifact translation unit count does not match the requested host "
				+ "compilation"
			)


pure func host_c_compile_error_message(error: HostCCompileError) -> String:
	match error:
		HostCProcessFailed(process_error):
			"cannot start the C compiler: ${process_error.to_string()}"
		HostCTranslationUnitTaskFailed(detail):
			"cannot compile a C translation unit: ${detail}"
		HostCCompilerRejected(code, diagnostics):
			"C compiler exited with status ${code.to_string()}: ${diagnostics}"
		HostCCompilerSignaled(signal, diagnostics):
			"C compiler was terminated by signal ${signal.to_string()}: ${diagnostics}"
		HostCCompilerTimedOut(diagnostics):
			"C compiler timed out: ${diagnostics}"


private record HostRuntimePolicy {
	c_source_parts: List[String],
	runtime_feature_arguments: List[String],
	link_input_arguments: List[String]
}


pure func host_c_compiler_family_name(family: HostCCompilerFamily) -> String:
	match family:
		HostClang:
			"clang"
		HostGcc:
			"gcc"
		HostOtherCompiler:
			"other"


pure func host_tls_backend_name(backend: HostTlsBackend) -> String:
	match backend:
		HostTlsUnsupported:
			"unsupported"
		HostTlsOpenSsl:
			"openssl"


private pure func tls_backends_match(a: HostTlsBackend, b: HostTlsBackend) -> Bool:
	match a:
		HostTlsUnsupported:
			match b:
				HostTlsUnsupported:
					True
				HostTlsOpenSsl:
					False
		HostTlsOpenSsl:
			match b:
				HostTlsUnsupported:
					False
				HostTlsOpenSsl:
					True


private pure func host_runtime_policy(
	artifact: BuildArtifact,
	configuration: HostCConfiguration,
	runtime: HostRuntimeInput,
) -> Result[HostRuntimePolicy, HostCPreparationError]:
	runtime_requirement: BuildRuntimeRequirement = artifact.runtime_requirement

	-- A split artifact has no single C source stream to hand the compiler;
	-- `prepare_host_c_split_compilation` owns that shape instead.
	if artifact.extra_units.length() > 0:
		Err(HostTranslationUnitShapeMismatch)
	else:
		match runtime_requirement:
			BuildEmbeddedRuntime:
				match runtime:
					HostEmbeddedRuntime(sources):
						if sources.runtime.length() == 0:
							Err(HostEmbeddedRuntimeUnavailable)
						else:
							profile_prelude: String = function_profile_runtime_c_prelude(
								artifact.compatibility.profile_mode,
							)

							parts: List[String] = if profile_prelude.length() == 0:
								[sources.runtime, artifact.c_code]
							else:
								[profile_prelude, sources.runtime, artifact.c_code]

							Ok({
								c_source_parts = parts,
								runtime_feature_arguments = configuration.tls.runtime_arguments,
								link_input_arguments = [],
							})
					HostPrecompiledRuntimeInput(_):
						Err(HostRuntimeRequirementMismatch)
			BuildExternalRuntime:
				match runtime:
					HostEmbeddedRuntime(_):
						Err(HostRuntimeRequirementMismatch)
					HostPrecompiledRuntimeInput(precompiled):
						if not tls_backends_match(
							precompiled.tls_backend,
							configuration.tls.backend,
						):
							Err(HostRuntimeTlsMismatch)
						else:
							Ok({
								c_source_parts = [artifact.c_code],
								runtime_feature_arguments = [],
								link_input_arguments = [
									"-include",
									precompiled.declarations_path,
									precompiled.object_path,
								],
							})


pure func host_c_optimization_argument(
	optimization: BuildOptimization,
	sanitizer: BuildSanitizer,
) -> String:
	match sanitizer:
		BuildNoSanitizer:
			match optimization:
				BuildFast:
					"-O0"
				BuildRelease:
					"-O2"
		_:
			"-O0"


pure func host_c_sanitizer_arguments(sanitizer: BuildSanitizer) -> List[String]:
	match sanitizer:
		BuildNoSanitizer:
			[]
		BuildAddressUndefinedSanitizer:
			["-fsanitize=address,undefined", "-fno-omit-frame-pointer", "-g"]
		BuildUndefinedSanitizer:
			["-fsanitize=undefined", "-fno-omit-frame-pointer", "-g"]


pure func host_c_warning_arguments(sanitizer: BuildSanitizer) -> List[String]:
	match sanitizer:
		BuildNoSanitizer:
			["-w"]
		_:
			[]


private pure func platform_arguments(
	platform: BuildPlatform,
	compiler: HostCCompilerFamily,
) -> List[String]:
	match platform:
		BuildMacos:
			match compiler:
				HostClang:
					["-Wl,-stack_size,0x1000000"]
				_:
					[]
		BuildLinux:
			[]


private pure func raylib_arguments(platform: BuildPlatform, prefix: Option[String]) -> List[String]:
	match platform:
		BuildMacos:
			prefix_arguments: List[String] = match prefix:
				Some(path):
					["-L${path}/lib", "-I${path}/include"]
				None:
					[]

			prefix_arguments.concat([
				"-lraylib",
				"-framework",
				"IOKit",
				"-framework",
				"Cocoa",
				"-framework",
				"OpenGL",
				"-framework",
				"CoreVideo",
			])
		BuildLinux:
			["-lraylib", "-lGL", "-lm", "-lpthread", "-ldl", "-lrt", "-lX11"]


private pure func native_feature_arguments(
	artifact: BuildArtifact,
	configuration: HostCConfiguration,
) -> List[String]:
	if (
		artifact.native_features.any(func(feature: BuildNativeFeature):
			match feature:
				BuildRaylib:
					True
				_:
					False
		)
	):
		raylib_arguments(configuration.platform, configuration.raylib_prefix)
	else:
		[]


pure func prepare_host_c_compilation(
	artifact: BuildArtifact,
	output_path: String,
	configuration: HostCConfiguration,
	runtime: HostRuntimeInput,
) -> Result[HostCPreparedCompilation, HostCPreparationError]:
	runtime_policy ?= host_runtime_policy(artifact, configuration, runtime)
	invocation = build_c_invocation(artifact, configuration.platform)
	arguments: List[String] = ["-x", "c", "-", "-x", "none"]
		.append(
			host_c_optimization_argument(
				artifact.compatibility.optimization,
				artifact.compatibility.sanitizer,
			),
		)
		.concat(["-fwrapv", "-pipe"])
		.concat(platform_arguments(configuration.platform, configuration.compiler.family))
		.concat(host_c_warning_arguments(artifact.compatibility.sanitizer))
		.concat(runtime_policy.runtime_feature_arguments)
		.concat(invocation.include_arguments)
		.concat(runtime_policy.link_input_arguments)
		.concat(["-lm", "-lpthread"])
		.concat(host_c_sanitizer_arguments(artifact.compatibility.sanitizer))
		.concat(configuration.tls.link_arguments)
		.concat(native_feature_arguments(artifact, configuration))
		.concat(invocation.link_arguments)
		.concat(["-o", output_path])
	process_command = { Process.command(
		configuration.compiler.program,
		configuration.compiler.prefix_arguments.concat(arguments),
	) |
		stdin = Process.BytesPartsStdin(runtime_policy.c_source_parts.map(
			func(part): part.to_bytes(),
		)),
		timeout = configuration.timeout,
		capture_limit = Process.BoundedCapture(configuration.capture_limit)
	}

	Ok({
		command = process_command,
		output_path = output_path,
		source = artifact.source,
	})


private pure func compilation_diagnostics(stdout: String, stderr: String) -> String:
	if stdout.length() == 0:
		stderr
	else if stderr.length() == 0:
		stdout
	else:
		stdout + "\n" + stderr


--- Classify one completed C compiler process, reporting `output_path` as the
--- file it produced.
pure func classify_host_c_process_result(
	output_path: String,
	result: Process.ProcessResult,
) -> Result[String, HostCCompileError]:
	diagnostics: String = compilation_diagnostics(
		result.stdout.to_string(),
		result.stderr.to_string(),
	)

	match result.exit:
		Process.Exited(code):
			if code == 0:
				Ok(output_path)
			else:
				Err(HostCCompilerRejected(code, diagnostics))
		Process.Signaled(signal):
			Err(HostCCompilerSignaled(signal, diagnostics))
		Process.TimedOut:
			Err(HostCCompilerTimedOut(diagnostics))


pure func classify_host_c_compilation_result(
	prepared: HostCPreparedCompilation,
	result: Process.ProcessResult,
) -> Result[String, HostCCompileError]:
	classify_host_c_process_result(prepared.output_path, result)


func run_host_c_compilation(
	prepared: HostCPreparedCompilation,
) -> Result[String, HostCCompileError]:
	match Process.run_command(prepared.command):
		Err(error):
			Err(HostCProcessFailed(error))
		Ok(result):
			classify_host_c_compilation_result(prepared, result)


--- One file of a split artifact as it must exist on disk before the host C
--- compiler runs: the shared header, or one translation unit body.
record HostCSplitSourceFile {
	path: String,
	contents: String
}


--- One translation unit's compile step, paired with the object file it
--- produces so a failure can name the file it came from.
record HostCTranslationUnitCompile {
	command: Process.ProcessCommand,
	object_path: String
}


--- A split artifact's host compilation: the files to write, one compile per
--- translation unit (independent, so they can run concurrently), and the
--- single link step that turns their objects into the executable.
record HostCSplitCompilation {
	sources: List[HostCSplitSourceFile],
	units: List[HostCTranslationUnitCompile],
	link_command: Process.ProcessCommand,
	output_path: String,
	source: BuildSourceIdentity
}


private pure func split_unit_source_path(directory: String, unit_index: Int) -> String:
	"${directory}/unit_${unit_index.to_string()}.c"


private pure func split_unit_object_path(directory: String, unit_index: Int) -> String:
	"${directory}/unit_${unit_index.to_string()}.o"


private pure func split_source_files(
	artifact: BuildArtifact,
	directory: String,
) -> List[HostCSplitSourceFile]:
	var files: List[HostCSplitSourceFile] = [
		{
			path = "${directory}/${SCRATCH_SHARED_HEADER_NAME}",
			contents = artifact.c_code
		},
	]

	for unit_index in 0..artifact.extra_units.length():
		files = files.append({
			path = split_unit_source_path(directory, unit_index),
			contents = artifact.extra_units.get_or(unit_index, ""),
		})

	files


private pure func split_host_c_command(
	configuration: HostCConfiguration,
	arguments: List[String],
) -> Process.ProcessCommand:
	{ Process.command(
		configuration.compiler.program,
		configuration.compiler.prefix_arguments.concat(arguments),
	) |
		timeout = configuration.timeout,
		capture_limit = Process.BoundedCapture(configuration.capture_limit)
	}


private pure func split_translation_unit_compiles(
	artifact: BuildArtifact,
	configuration: HostCConfiguration,
	precompiled: HostPrecompiledRuntime,
	include_arguments: List[String],
	directory: String,
) -> List[HostCTranslationUnitCompile]:
	sanitizer: BuildSanitizer = artifact.compatibility.sanitizer
	shared_arguments: List[String] = ["-fwrapv", "-pipe"]
		.append(host_c_optimization_argument(artifact.compatibility.optimization, sanitizer))
		.concat(host_c_warning_arguments(sanitizer))
		.concat(include_arguments)
		.concat(host_c_sanitizer_arguments(sanitizer))
		.concat(["-include", precompiled.declarations_path])
	var compiles: List[HostCTranslationUnitCompile] = []

	for unit_index in 0..artifact.extra_units.length():
		object_path: String = split_unit_object_path(directory, unit_index)
		compiles = compiles.append({
			command = split_host_c_command(
				configuration,
				shared_arguments.concat([
					"-c",
					split_unit_source_path(directory, unit_index),
					"-o",
					object_path,
				]),
			),
			object_path = object_path,
		})

	compiles


private pure func split_link_command(
	artifact: BuildArtifact,
	configuration: HostCConfiguration,
	precompiled: HostPrecompiledRuntime,
	link_arguments: List[String],
	object_paths: List[String],
	output_path: String,
) -> Process.ProcessCommand:
	sanitizer: BuildSanitizer = artifact.compatibility.sanitizer
	arguments: List[String] = ["-pipe"]
		.append(host_c_optimization_argument(artifact.compatibility.optimization, sanitizer))
		.concat(platform_arguments(configuration.platform, configuration.compiler.family))
		.concat(object_paths)
		.append(precompiled.object_path)
		.concat(["-lm", "-lpthread"])
		.concat(host_c_sanitizer_arguments(sanitizer))
		.concat(configuration.tls.link_arguments)
		.concat(native_feature_arguments(artifact, configuration))
		.concat(link_arguments)
		.concat(["-o", output_path])

	split_host_c_command(configuration, arguments)


---
Plan the host compilation of a split artifact inside `directory`, a scratch
directory the caller owns. Only the external-runtime shape is supported: an
embedded runtime has no single source stream to prepend itself to, and the
CLI rejects that combination before emission.
---
pure func prepare_host_c_split_compilation(
	artifact: BuildArtifact,
	output_path: String,
	configuration: HostCConfiguration,
	runtime: HostRuntimeInput,
	directory: String,
) -> Result[HostCSplitCompilation, HostCPreparationError]:
	if artifact.extra_units.length() == 0:
		Err(HostTranslationUnitShapeMismatch)
	else:
		match runtime:
			HostEmbeddedRuntime(_):
				Err(HostRuntimeRequirementMismatch)
			HostPrecompiledRuntimeInput(precompiled):
				match artifact.runtime_requirement:
					BuildEmbeddedRuntime:
						Err(HostRuntimeRequirementMismatch)
					BuildExternalRuntime:
						if not tls_backends_match(
							precompiled.tls_backend,
							configuration.tls.backend,
						):
							Err(HostRuntimeTlsMismatch)
						else:
							invocation = build_c_invocation(artifact, configuration.platform)
							units: List[HostCTranslationUnitCompile] = split_translation_unit_compiles(
								artifact,
								configuration,
								precompiled,
								invocation.include_arguments,
								directory,
							)

							Ok({
								sources = split_source_files(artifact, directory),
								units = units,
								link_command = split_link_command(
									artifact,
									configuration,
									precompiled,
									invocation.link_arguments,
									units.map(
										func(unit: HostCTranslationUnitCompile): unit.object_path,
									),
									output_path,
								),
								output_path = output_path,
								source = artifact.source,
							})


func write_host_c_split_sources(prepared: HostCSplitCompilation) -> Result[Void, IOError]:
	var failure: Option[IOError] = None

	for file in prepared.sources:
		if failure.is_none():
			match write_text_atomic(file.path, file.contents):
				Ok(_):
					void
				Err(error):
					failure = Some(error)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(void)


private pure func concurrency_error_detail(error: ConcurrencyError) -> String:
	match error:
		Timeout:
			"the compile task timed out"
		TaskFailed(detail):
			detail
		Cancelled:
			"the compile task was cancelled"


private func run_translation_unit_compile(
	unit: HostCTranslationUnitCompile,
) -> Result[String, HostCCompileError]:
	match Process.run_command(unit.command):
		Err(error):
			Err(HostCProcessFailed(error))
		Ok(result):
			classify_host_c_process_result(unit.object_path, result)


---
Compile every translation unit concurrently. The units share nothing but the
header they read, so the host C compiler can work on them independently; the
first failure is reported and the remaining results are discarded.

The task limit is the unit count, not a core count: each task blocks in
`run_command` until its compiler exits, so the runtime's worker pool -- sized
to the host's processors -- is what actually bounds how many compilers run at
once.
---
func run_host_c_translation_units(
	prepared: HostCSplitCompilation,
) -> Result[Void, HostCCompileError]:
	outcomes: List[Result[Result[String, HostCCompileError], ConcurrencyError]] = prepared.units.concurrent(
		prepared.units.length(),
		func(unit: HostCTranslationUnitCompile): run_translation_unit_compile(unit),
	)
	var failure: Option[HostCCompileError] = None

	for outcome in outcomes:
		if failure.is_none():
			match outcome:
				Ok(unit_result):
					match unit_result:
						Ok(_):
							void
						Err(error):
							failure = Some(error)
				Err(concurrency_error):
					failure = Some(
						HostCTranslationUnitTaskFailed(
							concurrency_error_detail(concurrency_error),
						),
					)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(void)
