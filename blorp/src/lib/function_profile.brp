-- Typed function-profile configuration shared by CLI planning and C emission.
-- Selectors retain source-level module/function spellings; the backend resolves
-- them against compiler-owned Core identities before rendering C.
enum FunctionProfileMode:
	FunctionProfileOffMode
	FunctionProfileCallsMode
	FunctionProfileExactMode


union FunctionProfileSelector:
	ProfileModule(String)
	ProfileFunction(String, String)


union FunctionProfileConfiguration:
	FunctionProfileOff
	FunctionProfileCalls(List[FunctionProfileSelector])
	FunctionProfileExact(List[FunctionProfileSelector])


pure func function_profile_mode(configuration: FunctionProfileConfiguration) -> FunctionProfileMode:
	match configuration:
		FunctionProfileOff:
			FunctionProfileOffMode
		FunctionProfileCalls(_):
			FunctionProfileCallsMode
		FunctionProfileExact(_):
			FunctionProfileExactMode


pure func function_profile_selectors(
	configuration: FunctionProfileConfiguration,
) -> List[FunctionProfileSelector]:
	match configuration:
		FunctionProfileOff:
			[]
		FunctionProfileCalls(selectors) | FunctionProfileExact(selectors):
			selectors
