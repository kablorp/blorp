-- Complete, effect-free build boundary produced after Core-to-C emission.
--
-- CArtifact is the raw-emission shape. BuildArtifact is the durable boundary:
-- all later command policy is derived from its values without consulting
-- compiler-global module state.
record CArtifact {
	c_code: String,
	link_flags: List[String],
	include_dirs: List[String]
}


enum BuildPlatform:
	BuildLinux
	BuildMacos


record BuildLinkArgument {
	platform: Option[BuildPlatform],
	value: String
}


enum BuildRuntimeRequirement:
	BuildEmbeddedRuntime
	BuildExternalRuntime


enum BuildNativeFeature:
	BuildRaylib
	BuildTls


implements Equatable for BuildNativeFeature:
	pure func equals(a: BuildNativeFeature, b: BuildNativeFeature) -> Bool:
		match a:
			BuildRaylib:
				match b:
					BuildRaylib:
						True
					BuildTls:
						False
			BuildTls:
				match b:
					BuildRaylib:
						False
					BuildTls:
						True


record BuildSourceIdentity {
	path: String,
	module_name: String
}


enum BuildOptimization:
	BuildFast
	BuildRelease


enum BuildSanitizer:
	BuildNoSanitizer
	BuildAddressUndefinedSanitizer
	BuildUndefinedSanitizer


struct BuildCompatibility {
	debug: Bool,
	profile: Bool,
	optimization: BuildOptimization,
	sanitizer: BuildSanitizer,
	leak_check: Bool
}


record BuildArtifact {
	c_code: String,
	link_arguments: List[BuildLinkArgument],
	include_dirs: List[String],
	runtime_requirement: BuildRuntimeRequirement,
	native_features: List[BuildNativeFeature],
	source: BuildSourceIdentity,
	compatibility: BuildCompatibility
}


record BuildArtifactConfiguration {
	runtime_requirement: BuildRuntimeRequirement,
	native_features: List[BuildNativeFeature],
	include_dirs: List[String],
	source: BuildSourceIdentity,
	compatibility: BuildCompatibility
}


union BuildArtifactError:
	InvalidForeignLinkArguments(String)


-- The platform-filtered argv contribution for Checkpoint G's C compiler
-- process request. It deliberately contains no executable or output path:
-- those are effect-site choices, not properties of the emitted program.
record BuildCInvocation {
	c_code: String,
	include_arguments: List[String],
	link_arguments: List[String],
	runtime_requirement: BuildRuntimeRequirement,
	native_features: List[BuildNativeFeature],
	source: BuildSourceIdentity,
	compatibility: BuildCompatibility
}


private pure func link_argument_applies(
	argument: BuildLinkArgument,
	platform: BuildPlatform,
) -> Bool:
	match argument.platform:
		Some(required_platform):
			required_platform == platform
		None:
			True


pure func build_c_invocation(artifact: BuildArtifact, platform: BuildPlatform) -> BuildCInvocation:
	{
		c_code = artifact.c_code,
		include_arguments = artifact.include_dirs.map(func(include_dir): "-I${include_dir}"),
		link_arguments = artifact.link_arguments
			.filter(func(argument): link_argument_applies(argument, platform))
			.map(func(argument): argument.value),
		runtime_requirement = artifact.runtime_requirement,
		native_features = artifact.native_features,
		source = artifact.source,
		compatibility = artifact.compatibility
	}
