-- The one place that decides where the content-addressed package cache lives.
--
-- The CLI, the package commands and the language server must agree on this
-- directory, because `blorp package fetch` writes entries that compilation and
-- the editor later read. The decision is a pure function of an explicit
-- environment record so its precedence is unit tested without touching the
-- process environment; `package_cache_root` is the only reader of the process
-- environment.
import:
	path: join
	system: getenv, temp_dir


-- Process-environment values that influence the cache root, exactly as read.
-- An absent variable and one that is empty or only whitespace mean the same
-- thing: "not set".
record PackageCacheEnvironment {
	package_cache: Option[String],
	xdg_cache_home: Option[String],
	home: Option[String],
	temporary_root: String
}


private PACKAGE_CACHE_VARIABLE: String = "BLORP_PACKAGE_CACHE"

private XDG_CACHE_HOME_VARIABLE: String = "XDG_CACHE_HOME"

private HOME_VARIABLE: String = "HOME"

private HOME_CACHE_DIRECTORY: String = ".cache"

private BLORP_CACHE_DIRECTORY: String = "blorp"

private PACKAGE_CACHE_DIRECTORY: String = "packages"


private pure func configured(value: Option[String]) -> Option[String]:
	value.filter(func(text): text
			.trim()
			.length() > 0)


-- Precedence, first configured wins:
--   1. `BLORP_PACKAGE_CACHE`, used as the cache root itself.
--   2. `$XDG_CACHE_HOME/blorp/packages`.
--   3. `$HOME/.cache/blorp/packages`.
--   4. `<temporary directory>/.cache/blorp/packages`, so a missing home still
--      yields a usable absolute location instead of a failure.
pure func package_cache_root_from(environment: PackageCacheEnvironment) -> String:
	match configured(environment.package_cache):
		Some(root):
			root
		None:
			cache_base: String = match configured(environment.xdg_cache_home):
				Some(xdg_cache_home):
					xdg_cache_home
				None:
					match configured(environment.home):
						Some(home):
							join(home, HOME_CACHE_DIRECTORY)
						None:
							join(environment.temporary_root, HOME_CACHE_DIRECTORY)

			join(join(cache_base, BLORP_CACHE_DIRECTORY), PACKAGE_CACHE_DIRECTORY)


func package_cache_root() -> String:
	package_cache_root_from(
		{
			package_cache = getenv(PACKAGE_CACHE_VARIABLE),
			xdg_cache_home = getenv(XDG_CACHE_HOME_VARIABLE),
			home = getenv(HOME_VARIABLE),
			temporary_root = temp_dir()
		},
	)
