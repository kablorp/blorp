-- Application boundary around the compiler-owned pipeline. This module translates command
-- plans and options into pipeline requests and translates pipeline products
-- back into CLI results. Compiler stage order belongs only in pipeline.brp.
import:
	../compiler/frontend_output: parsed_source_summary
	../compiler/frontend_request: FrontendCompilationGraph
	../compiler/pipeline:
		ArtifactConstructionPhaseExecution(
			ArtifactConstructionPhaseFailed,
			ArtifactConstructionPhaseReady,
		),
		BackendEmissionCompilation,
		BackendEmissionPhaseExecution(BackendEmissionPhaseFailed, BackendEmissionPhaseReady),
		CompiledTypedGraph(CompiledTypedGraphReady, CompiledTypedGraphStopped),
		CoreCompilation,
		CoreObservation,
		EarlyCoreCompilation,
		EarlyCorePhaseExecution(EarlyCorePhaseFailed, EarlyCorePhaseReady, EarlyCorePhaseStopped),
		FinishedCompilerPipeline(
			CompilerPipelineArtifactFailed,
			CompilerPipelineArtifactReady,
			CompilerPipelineEmitFailed,
			CompilerPipelineInvariantFailed,
			CompilerPipelineStopped,
		),
		FrontendCompilePolicy,
		LateCoreExecution(LateCoreCompleted, LateCoreFailed, LateCoreStopped),
		LateCoreStageRequest,
		LoweredCoreCompilation,
		PreparedCoreLoweringRequest,
		RuntimeProjectedCompilation,
		RuntimeProjectionPhaseExecution(
			RuntimeProjectionPhaseFailed,
			RuntimeProjectionPhaseReady,
			RuntimeProjectionPhaseStopped,
		),
		TypedFrontendCompilation,
		compile_frontend_graph,
		compile_frontend_graph_with_typed_validation,
		construct_backend_artifact,
		emit_backend_c,
		execute_late_core_stages,
		finish_compiler_pipeline,
		lower_prepared_core_request,
		prepare_core_lowering_request,
		project_runtime_compilation,
		run_early_core_compilation,
		run_typed_frontend_compilation,
		runtime_projected_core_compilation,
		runtime_projected_include_dirs,
		runtime_projected_observations,
		runtime_projected_typed_summary,
	../compiler/stage_06_typecheck/bridge: TypecheckedGraph
	../compiler/stage_09_core/pass_runner: CorePassTiming
	../compiler/stage_09_core/pipeline: PreparedCoreProgram
	../lib/build_artifact:
		BuildArtifact,
		BuildArtifactConfiguration,
		BuildCompatibility,
		BuildNativeFeature,
		BuildOptimization(BuildFast, BuildRelease),
		BuildRuntimeRequirement(BuildEmbeddedRuntime, BuildExternalRuntime),
		BuildSanitizer(BuildAddressUndefinedSanitizer, BuildNoSanitizer, BuildUndefinedSanitizer),
	cli_args: CliCompileArgs, CliRunArgs
	cli_plan: CliCompilePlan, CliRunSourcePlan, compile_plan_source
	diagnostic: cli_error_message
	function_profile: FunctionProfileConfiguration, FunctionProfileMode, function_profile_mode
	native_features: graph_native_features
	stage_requests: CompileStageRequests, compile_stage_requests


record CompileArtifactOutput {
	c_code: String,
	embed_runtime: Bool,
	profile_mode: FunctionProfileMode
}


record CompileObservation {
	stage_name: String,
	rendered: String
}


pure func compile_plan_parsed_summary(plan: CliCompilePlan) -> Option[String]:
	match compile_plan_source(plan):
		Some(source):
			Some(parsed_source_summary(source.path, source.module_name, source.source_text))
		None:
			None


union CompileExecution:
	CompileFrontendFailed(List[String])
	CompileArtifact(String, CompileArtifactOutput, List[CompileObservation], Option[String])
	CompileStopped(String, String, String, List[CompileObservation])
	CompileCoreInvariantFailed(String)
	CompileEmitFailed(String)
	CompileBuildArtifactFailed(String)


private pure func compile_observation(observation: CoreObservation) -> CompileObservation:
	{
		stage_name = observation.stage_name,
		rendered = observation.rendered
	}


pure func compile_observations(observations: List[CoreObservation]) -> List[CompileObservation]:
	observations.map(compile_observation)


private pure func compile_artifact_output(artifact: BuildArtifact) -> CompileArtifactOutput:
	embed_runtime: Bool = match artifact.runtime_requirement:
		BuildEmbeddedRuntime:
			True
		BuildExternalRuntime:
			False

	{
		c_code = artifact.c_code,
		embed_runtime = embed_runtime,
		profile_mode = artifact.compatibility.profile_mode
	}


private pure func cli_error_messages(errors: List[String]) -> List[String]:
	errors.map(cli_error_message)


union RunArtifactExecution:
	RunArtifactReady(BuildArtifact)
	RunArtifactStopped
	RunArtifactFailed(String)


record PreparedCompileExecution {
	compilation: CoreCompilation,
	configuration: BuildArtifactConfiguration,
	late_stages: List[LateCoreStageRequest],
	typed_program_summary: Option[String],
	early_observations: List[CoreObservation]
}


union CompilePreparation:
	CompilePreparationReady(PreparedCompileExecution)
	CompilePreparationStopped(String, String, String, List[CoreObservation])


record TypedCompilePreparation {
	continuation: CompileContinuation,
	typed: TypedFrontendCompilation
}


record PreparedCoreCompilePreparation {
	continuation: CompileContinuation,
	request: PreparedCoreLoweringRequest
}


record LoweredCompilePreparation {
	continuation: CompileContinuation,
	lowered: LoweredCoreCompilation
}


record EarlyCoreCompilePreparation {
	continuation: CompileContinuation,
	early: EarlyCoreCompilation
}


record RuntimeProjectedCompilePreparation {
	continuation: CompileContinuation,
	projected: RuntimeProjectedCompilation
}


record CompileContinuation {
	runtime_requirement: BuildRuntimeRequirement,
	native_features: List[BuildNativeFeature],
	profile: FunctionProfileConfiguration,
	compatibility: BuildCompatibility,
	late_stages: List[LateCoreStageRequest]
}


record LateCoreCompileExecution {
	prepared: PreparedCompileExecution,
	prepared_core: PreparedCoreProgram,
	observations: List[CoreObservation]
}


union LateCoreCompilePhaseExecution:
	LateCoreCompilePhaseReady(LateCoreCompileExecution, List[CorePassTiming])
	LateCoreCompilePhaseStopped(String, String, List[CoreObservation], List[CorePassTiming])
	LateCoreCompilePhaseInvariantFailed(String, String, List[CorePassTiming])


record BackendEmissionCompileExecution {
	prepared: PreparedCompileExecution,
	emission: BackendEmissionCompilation,
	observations: List[CoreObservation]
}


union BackendEmissionCompilePhaseExecution:
	BackendEmissionCompilePhaseReady(BackendEmissionCompileExecution)
	BackendEmissionCompilePhaseFailed(String)


private pure func compile_runtime_requirement(options: CliCompileArgs) -> BuildRuntimeRequirement:
	if options.embed_runtime:
		BuildEmbeddedRuntime
	else:
		BuildExternalRuntime


private pure func run_sanitizer(options: CliRunArgs) -> BuildSanitizer:
	match options.sanitizer:
		Some(CliSanitizeAddressUndefined):
			BuildAddressUndefinedSanitizer
		Some(CliSanitizeUndefined):
			BuildUndefinedSanitizer
		Some(CliSanitizeOff):
			BuildNoSanitizer
		None:
			BuildNoSanitizer


private pure func compile_compatibility(options: CliCompileArgs) -> BuildCompatibility:
	{
		debug = options.debug,
		profile_mode = function_profile_mode(options.profile),
		optimization = BuildFast,
		sanitizer = BuildNoSanitizer,
		leak_check = False
	}


private pure func run_optimization(options: CliRunArgs) -> BuildOptimization:
	if options.release:
		BuildRelease
	else:
		BuildFast


pure func run_compatibility(options: CliRunArgs) -> BuildCompatibility:
	{
		debug = options.debug,
		profile_mode = function_profile_mode(options.profile),
		optimization = run_optimization(options),
		sanitizer = run_sanitizer(options),
		leak_check = options.leak_check
	}


private pure func artifact_configuration(
	compilation: CoreCompilation,
	native_features: List[BuildNativeFeature],
	include_dirs: List[String],
	runtime_requirement: BuildRuntimeRequirement,
	profile: FunctionProfileConfiguration,
	compatibility: BuildCompatibility,
) -> BuildArtifactConfiguration:
	{
		runtime_requirement = runtime_requirement,
		native_features = native_features,
		include_dirs = include_dirs,
		source = {
			path = compilation.target_path,
			module_name = compilation.target_module_name
		},
		profile = profile,
		compatibility = compatibility
	}


func run_late_core_compile_execution(
	prepared: PreparedCompileExecution,
	record_timings: Bool,
) -> LateCoreCompilePhaseExecution:
	match execute_late_core_stages(
		prepared.compilation.program,
		prepared.early_observations,
		prepared.late_stages,
		prepared.compilation.check_invariants,
		record_timings,
	):
		LateCoreCompleted(prepared_core, completed_observations, timings):
			LateCoreCompilePhaseReady(
				{
					prepared = prepared,
					prepared_core = prepared_core,
					observations = completed_observations
				},
				timings,
			)
		LateCoreStopped(stage_name, rendered, stopped_observations, timings):
			LateCoreCompilePhaseStopped(stage_name, rendered, stopped_observations, timings)
		LateCoreFailed(stage_name, detail, timings):
			LateCoreCompilePhaseInvariantFailed(stage_name, detail, timings)


pure func emit_backend_compile_execution(
	late: LateCoreCompileExecution,
) -> BackendEmissionCompilePhaseExecution:
	match emit_backend_c(late.prepared_core, late.prepared.configuration):
		BackendEmissionPhaseReady(emission):
			BackendEmissionCompilePhaseReady({
				prepared = late.prepared,
				emission = emission,
				observations = late.observations,
			})
		BackendEmissionPhaseFailed(message):
			BackendEmissionCompilePhaseFailed(message)


pure func construct_artifact_compile_execution(
	emitted: BackendEmissionCompileExecution,
) -> CompileExecution:
	match construct_backend_artifact(emitted.emission):
		ArtifactConstructionPhaseReady(artifact):
			CompileArtifact(
				emitted.prepared.compilation.target_path,
				compile_artifact_output(artifact),
				compile_observations(emitted.observations),
				emitted.prepared.typed_program_summary,
			)
		ArtifactConstructionPhaseFailed(message):
			CompileBuildArtifactFailed(message)


func finish_prepared_compile_execution(prepared: PreparedCompileExecution) -> CompileExecution:
	match run_late_core_compile_execution(prepared, False):
		LateCoreCompilePhaseStopped(stage_name, rendered, stopped_observations, _):
			CompileStopped(
				prepared.compilation.target_path,
				stage_name,
				rendered,
				compile_observations(stopped_observations),
			)
		LateCoreCompilePhaseInvariantFailed(stage_name, detail, _):
			CompileCoreInvariantFailed("${stage_name}: ${detail}")
		LateCoreCompilePhaseReady(late, _):
			match emit_backend_compile_execution(late):
				BackendEmissionCompilePhaseReady(emitted):
					construct_artifact_compile_execution(emitted)
				BackendEmissionCompilePhaseFailed(message):
					CompileEmitFailed(message)


func finish_prepared_run_artifact_execution(
	prepared: PreparedCompileExecution,
) -> RunArtifactExecution:
	match finish_compiler_pipeline(
		prepared.compilation.program,
		prepared.early_observations,
		prepared.late_stages,
		prepared.compilation.check_invariants,
		prepared.configuration,
	):
		CompilerPipelineArtifactReady(artifact, _):
			RunArtifactReady(artifact)
		CompilerPipelineStopped(_, _, _):
			RunArtifactStopped
		CompilerPipelineInvariantFailed(stage_name, detail):
			RunArtifactFailed("Core invariant failure: ${stage_name}: ${detail}")
		CompilerPipelineEmitFailed(message):
			RunArtifactFailed("internal C emission failure: ${message}")
		CompilerPipelineArtifactFailed(message):
			RunArtifactFailed("build artifact failure: ${message}")


private pure func compile_preparation_from_frontend(
	plan: CliCompilePlan,
	stage_requests: CompileStageRequests,
	frontend: CompiledTypedGraph,
) -> CompilePreparation:
	match frontend:
		CompiledTypedGraphStopped(target_path, stage_name, rendered, observations):
			CompilePreparationStopped(target_path, stage_name, rendered, observations)
		CompiledTypedGraphReady(compilation, typed_program_summary, include_dirs, early_observations):
			CompilePreparationReady({
				compilation = compilation,
				configuration = artifact_configuration(
					compilation,
					graph_native_features(plan.graph.graph),
					include_dirs,
					compile_runtime_requirement(plan.options),
					plan.options.profile,
					compile_compatibility(plan.options),
				),
				late_stages = stage_requests.late_stages,
				typed_program_summary = typed_program_summary,
				early_observations = early_observations,
			})


func prepare_compile_plan_with_typed_validation(
	plan: CliCompilePlan,
	frontend_policy: FrontendCompilePolicy,
	validate: pure (TypecheckedGraph) -> List[String],
) -> Result[CompilePreparation, List[String]]:
	stage_requests: CompileStageRequests = compile_stage_requests(
		plan.options.dump_core_after,
		plan.options.stop_after,
	)
	frontend ?= compile_frontend_graph_with_typed_validation(
		plan.graph,
		frontend_policy,
		validate,
		cli_error_messages,
		True,
		plan.options.check_invariants,
		stage_requests.early_observations,
		stage_requests.early_stop,
	)

	Ok(compile_preparation_from_frontend(plan, stage_requests, frontend))


func prepare_compile_plan_with_frontend_policy(
	plan: CliCompilePlan,
	frontend_policy: FrontendCompilePolicy,
) -> Result[CompilePreparation, List[String]]:
	prepare_compile_plan_with_typed_validation(
		plan,
		frontend_policy,
		pure func(_): [],
	)


private pure func compile_plan_frontend_policy(plan: CliCompilePlan) -> FrontendCompilePolicy:
	{
		allow_debug_only_calls = plan.options.debug,
		retain_debug_blocks = plan.options.debug,
		include_typed_summary = plan.options.dump_typed_ast
	}


private pure func compile_continuation(
	plan: CliCompilePlan,
	stage_requests: CompileStageRequests,
) -> CompileContinuation:
	{
		runtime_requirement = compile_runtime_requirement(plan.options),
		native_features = graph_native_features(plan.graph.graph),
		profile = plan.options.profile,
		compatibility = compile_compatibility(plan.options),
		late_stages = stage_requests.late_stages
	}


func typed_compile_preparation(
	plan: CliCompilePlan,
) -> Result[TypedCompilePreparation, List[String]]:
	stage_requests: CompileStageRequests = compile_stage_requests(
		plan.options.dump_core_after,
		plan.options.stop_after,
	)
	typed ?= run_typed_frontend_compilation(
		plan.graph,
		compile_plan_frontend_policy(plan),
		pure func(_): [],
		cli_error_messages,
		True,
		plan.options.check_invariants,
		stage_requests.early_observations,
		stage_requests.early_stop,
	)

	Ok({
		continuation = compile_continuation(plan, stage_requests),
		typed = typed,
	})


pure func prepare_core_compile_preparation(
	typed: TypedCompilePreparation,
) -> Result[PreparedCoreCompilePreparation, List[String]]:
	request ?= prepare_core_lowering_request(typed.typed)

	Ok({
		continuation = typed.continuation,
		request = request,
	})


func prepare_core_compile_plan(
	plan: CliCompilePlan,
) -> Result[PreparedCoreCompilePreparation, List[String]]:
	typed ?= typed_compile_preparation(plan)
	prepare_core_compile_preparation(typed)


pure func lower_compile_preparation(
	prepared: PreparedCoreCompilePreparation,
) -> Result[LoweredCompilePreparation, List[String]]:
	lowered ?= lower_prepared_core_request(prepared.request)

	Ok({
		continuation = prepared.continuation,
		lowered = lowered,
	})


func run_early_core_compile_preparation(
	lowered: LoweredCompilePreparation,
	record_timings: Bool,
) -> EarlyCorePhaseExecution:
	run_early_core_compilation(lowered.lowered, record_timings)


pure func early_core_compile_preparation_ready(
	lowered: LoweredCompilePreparation,
	early: EarlyCoreCompilation,
) -> EarlyCoreCompilePreparation:
	{
		continuation = lowered.continuation,
		early = early
	}


func project_runtime_compile_preparation(
	early: EarlyCoreCompilePreparation,
	record_timings: Bool,
) -> RuntimeProjectionPhaseExecution:
	project_runtime_compilation(early.early, record_timings)


pure func runtime_projected_compile_preparation_ready(
	early: EarlyCoreCompilePreparation,
	projected: RuntimeProjectedCompilation,
) -> RuntimeProjectedCompilePreparation:
	{
		continuation = early.continuation,
		projected = projected
	}


pure func prepared_compile_execution_from_projected(
	projected: RuntimeProjectedCompilePreparation,
) -> PreparedCompileExecution:
	compilation: CoreCompilation = runtime_projected_core_compilation(projected.projected)

	{
		compilation = compilation,
		configuration = artifact_configuration(
			compilation,
			projected.continuation.native_features,
			runtime_projected_include_dirs(projected.projected),
			projected.continuation.runtime_requirement,
			projected.continuation.profile,
			projected.continuation.compatibility,
		),
		late_stages = projected.continuation.late_stages,
		typed_program_summary = runtime_projected_typed_summary(projected.projected),
		early_observations = runtime_projected_observations(projected.projected)
	}


func prepare_compile_plan(plan: CliCompilePlan) -> Result[CompilePreparation, List[String]]:
	typed ?= typed_compile_preparation(plan)
	prepared_core ?= prepare_core_compile_preparation(typed)
	lowered ?= lower_compile_preparation(prepared_core)

	match run_early_core_compile_preparation(lowered, False):
		EarlyCorePhaseFailed(errors):
			Err(errors)
		EarlyCorePhaseStopped(target_path, stage_name, rendered, observations, _):
			Ok(CompilePreparationStopped(target_path, stage_name, rendered, observations))
		EarlyCorePhaseReady(early, _):
			early_preparation: EarlyCoreCompilePreparation = early_core_compile_preparation_ready(
				lowered,
				early,
			)

			match project_runtime_compile_preparation(early_preparation, False):
				RuntimeProjectionPhaseFailed(errors):
					Err(errors)
				RuntimeProjectionPhaseStopped(target_path, stage_name, rendered, observations, _):
					Ok(CompilePreparationStopped(target_path, stage_name, rendered, observations))
				RuntimeProjectionPhaseReady(projected, _):
					Ok(
						CompilePreparationReady(
							prepared_compile_execution_from_projected(
								runtime_projected_compile_preparation_ready(
									early_preparation,
									projected,
								),
							),
						),
					)


func prepare_run_plan(plan: CliRunSourcePlan) -> Result[CompilePreparation, List[String]]:
	frontend ?= compile_frontend_graph(
		plan.graph,
		{
			allow_debug_only_calls = plan.options.debug,
			retain_debug_blocks = plan.options.debug,
			include_typed_summary = False
		},
		cli_error_messages,
		True,
		False,
		[],
		None,
	)

	match frontend:
		CompiledTypedGraphStopped(target_path, stage_name, rendered, observations):
			Ok(CompilePreparationStopped(target_path, stage_name, rendered, observations))
		CompiledTypedGraphReady(compilation, typed_program_summary, include_dirs, early_observations):
			Ok(CompilePreparationReady({
				compilation = compilation,
				configuration = artifact_configuration(
					compilation,
					graph_native_features(plan.graph.graph),
					include_dirs,
					BuildExternalRuntime,
					plan.options.profile,
					run_compatibility(plan.options),
				),
				late_stages = [],
				typed_program_summary = typed_program_summary,
				early_observations = early_observations,
			}))


func execute_compile_plan(plan: CliCompilePlan) -> CompileExecution:
	match prepare_compile_plan(plan):
		Ok(CompilePreparationReady(prepared)):
			finish_prepared_compile_execution(prepared)
		Ok(CompilePreparationStopped(target_path, stage_name, rendered, observations)):
			CompileStopped(target_path, stage_name, rendered, compile_observations(observations))
		Err(errors):
			CompileFrontendFailed(errors)
