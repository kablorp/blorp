-- One-time discovery of host compilation policy from explicit inputs.
--
-- The production helper reads process environment only to construct the input
-- record. All downstream compilation receives the resulting typed context.
import:
	build_artifact: BuildPlatform(BuildLinux, BuildMacos)
	host_c:
		HostCCompiler,
		HostCCompilerFamily(HostOtherCompiler),
		HostTlsBackend(HostTlsOpenSsl, HostTlsUnsupported),
		HostTlsConfiguration,
	path: join
	platform:
		HostPlatformError(HostArgumentListInvalid, HostPlatformInterrupted),
		HostProcessExecution(HostProcessCompleted, HostProcessFailed),
		HostToolchain,
		HostToolchainProbe,
		discover_host_toolchain_with_runner,
		host_cache_root,
		host_tls_configuration,
		parse_host_arguments,
		parse_host_tls_backend,
		probe_host_arguments_with_runner,
	process as Process
	system: file_exists, getenv, temp_dir
	units: DataSize, Duration


private DEFAULT_HOST_PROGRAM_PATH: String = "/bin:/usr/bin"


record HostEnvironmentInput {
	tls_backend: Option[String],
	openssl_compile_arguments: Option[String],
	openssl_link_arguments: Option[String],
	runtime_cache_root: Option[String],
	xdg_cache_home: Option[String],
	home: Option[String],
	temporary_root: String,
	raylib_prefix: Option[String],
	discover_raylib_prefix: Bool
}


record HostEnvironmentProbe {
	input: HostEnvironmentInput,
	toolchain: HostToolchainProbe,
	pkg_config_program: String,
	brew_program: String
}


record HostEnvironment {
	toolchain: HostToolchain,
	tls: HostTlsConfiguration,
	cache_root: String,
	raylib_prefix: Option[String]
}


pure func host_program_candidates(program: String, executable_path: Option[String]) -> List[String]:
	if program.contains("/"):
		[program]
	else:
		executable_path
			.get_or(DEFAULT_HOST_PROGRAM_PATH)
			.split(":")
			.map(func(directory): join(directory, program))


pure func parse_host_compiler_command(
	command: Option[String],
) -> Result[HostCCompiler, HostPlatformError]:
	arguments ?= parse_host_arguments(command.get_or("cc"))

	match arguments.get(0):
		Some(program):
			Ok({
				program = program,
				prefix_arguments = arguments.drop(1),
				family = HostOtherCompiler,
			})
		None:
			Err(HostArgumentListInvalid("C compiler command is empty"))


private func resolve_host_program(program: String, executable_path: Option[String]) -> String:
	var resolved: Option[String] = None

	for candidate in host_program_candidates(program, executable_path):
		if file_exists(candidate):
			resolved = Some(candidate)
			break

	resolved.get_or(program)


private func configured_arguments(
	override: Option[String],
	label: String,
	pkg_config_program: String,
	pkg_config_option: String,
	timeout: Option[Duration],
	capture_limit: DataSize,
	runner: (Process.ProcessCommand) -> HostProcessExecution,
) -> Result[List[String], HostPlatformError]:
	match override:
		Some(arguments):
			parse_host_arguments(arguments)
		None:
			probe_host_arguments_with_runner(
				label,
				pkg_config_program,
				[pkg_config_option, "openssl"],
				timeout,
				capture_limit,
				runner,
			)


private func discover_tls_configuration(
	probe: HostEnvironmentProbe,
	runner: (Process.ProcessCommand) -> HostProcessExecution,
) -> Result[HostTlsConfiguration, HostPlatformError]:
	backend ?= parse_host_tls_backend(probe.input.tls_backend)
	tls_configuration_for_backend(backend, probe, runner)


private func tls_configuration_for_backend(
	backend: HostTlsBackend,
	probe: HostEnvironmentProbe,
	runner: (Process.ProcessCommand) -> HostProcessExecution,
) -> Result[HostTlsConfiguration, HostPlatformError]:
	match backend:
		HostTlsUnsupported:
			Ok(host_tls_configuration(HostTlsUnsupported, [], []))
		HostTlsOpenSsl:
			compile_arguments ?= configured_arguments(
				probe.input.openssl_compile_arguments,
				"OpenSSL compiler flags",
				probe.pkg_config_program,
				"--cflags",
				probe.toolchain.timeout,
				probe.toolchain.capture_limit,
				runner,
			)
			link_arguments ?= configured_arguments(
				probe.input.openssl_link_arguments,
				"OpenSSL linker flags",
				probe.pkg_config_program,
				"--libs",
				probe.toolchain.timeout,
				probe.toolchain.capture_limit,
				runner,
			)
			Ok(host_tls_configuration(HostTlsOpenSsl, compile_arguments, link_arguments))


private func discover_raylib_prefix(
	probe: HostEnvironmentProbe,
	platform: BuildPlatform,
	runner: (Process.ProcessCommand) -> HostProcessExecution,
) -> Result[Option[String], HostPlatformError]:
	match probe.input.raylib_prefix:
		Some(prefix):
			if (
				prefix
					.trim()
					.length() == 0
			):
				Ok(None)
			else:
				Ok(Some(prefix))
		None:
			if not probe.input.discover_raylib_prefix:
				Ok(None)
			else:
				match platform:
					BuildLinux:
						Ok(None)
					BuildMacos:
						match (
							probe_host_arguments_with_runner(
								"raylib Homebrew prefix",
								probe.brew_program,
								["--prefix", "raylib"],
								probe.toolchain.timeout,
								probe.toolchain.capture_limit,
								runner,
							)
						):
							Ok(prefixes):
								match prefixes:
									[prefix]:
										Ok(Some(prefix))
									_:
										Ok(None)
							Err(HostPlatformInterrupted(signal, stdout, stderr)):
								Err(HostPlatformInterrupted(signal, stdout, stderr))
							Err(_):
								Ok(None)


private func run_host_process(request: Process.ProcessCommand) -> HostProcessExecution:
	match Process.run_command(request):
		Ok(result):
			HostProcessCompleted(result)
		Err(error):
			HostProcessFailed(error)


func discover_compiler_host_environment_with_runner(
	probe: HostEnvironmentProbe,
	runner: (Process.ProcessCommand) -> HostProcessExecution,
) -> Result[HostEnvironment, HostPlatformError]:
	toolchain ?= discover_host_toolchain_with_runner(probe.toolchain, runner)
	tls ?= discover_tls_configuration(probe, runner)
	raylib_prefix ?= discover_raylib_prefix(probe, toolchain.platform, runner)

	Ok({
		toolchain = toolchain,
		tls = tls,
		cache_root = host_cache_root(
			probe.input.runtime_cache_root,
			probe.input.xdg_cache_home,
			probe.input.home,
			probe.input.temporary_root,
		),
		raylib_prefix = raylib_prefix,
	})


func discover_compiler_host_environment(
	probe: HostEnvironmentProbe,
) -> Result[HostEnvironment, HostPlatformError]:
	discover_compiler_host_environment_with_runner(probe, run_host_process)


func current_compiler_host_environment_with_runner(
	discover_raylib: Bool,
	timeout: Option[Duration],
	capture_limit: DataSize,
	runner: (Process.ProcessCommand) -> HostProcessExecution,
) -> Result[HostEnvironment, HostPlatformError]:
	executable_path: Option[String] = getenv("PATH")
	configured_compiler ?= parse_host_compiler_command(getenv("CC"))
	environment_input: HostEnvironmentInput = {
		tls_backend = getenv("BLORP_TLS_BACKEND"),
		openssl_compile_arguments = getenv("BLORP_OPENSSL_CFLAGS"),
		openssl_link_arguments = getenv("BLORP_OPENSSL_LIBS"),
		runtime_cache_root = getenv("BLORP_RUNTIME_CACHE"),
		xdg_cache_home = getenv("XDG_CACHE_HOME"),
		home = getenv("HOME"),
		temporary_root = temp_dir(),
		raylib_prefix = getenv("BLORP_RAYLIB_PREFIX"),
		discover_raylib_prefix = discover_raylib
	}
	toolchain: HostToolchainProbe = {
		compiler = { configured_compiler |
			program = resolve_host_program(configured_compiler.program, executable_path)
		},
		uname_program = resolve_host_program("uname", executable_path),
		timeout = timeout,
		capture_limit = capture_limit
	}

	discover_compiler_host_environment_with_runner(
		{
			input = environment_input,
			toolchain = toolchain,
			pkg_config_program = "pkg-config",
			brew_program = "brew"
		},
		runner,
	)


func current_compiler_host_environment(
	discover_raylib: Bool,
	timeout: Option[Duration],
	capture_limit: DataSize,
) -> Result[HostEnvironment, HostPlatformError]:
	current_compiler_host_environment_with_runner(
		discover_raylib,
		timeout,
		capture_limit,
		run_host_process,
	)
