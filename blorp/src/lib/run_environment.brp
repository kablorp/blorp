-- Resolve run-related environment variables before constructing a typed plan.
-- CLI options always win; downstream compilation never consults these values.
import:
	cli_args: CliRunArgs


record CliRunEnvironment {
	leak_check: Option[String],
	threads: Option[String]
}


private pure func integer_requirement_message(name: String, allow_zero: Bool) -> String:
	if allow_zero:
		"${name} must be a non-negative integer"
	else:
		"${name} must be a positive integer"


---
Range-checks a command-line integer, which the argument parser reads without
checking, so that `--timeout -1` is an error rather than a timeout.
---
private pure func checked_integer_option(
	name: String,
	value: Option[Int],
	allow_zero: Bool,
) -> Result[Option[Int], String]:
	match value:
		None:
			Ok(None)
		Some(number):
			if number > 0 or allow_zero and number == 0:
				Ok(Some(number))
			else:
				Err(integer_requirement_message(name, allow_zero))


private pure func environment_integer(
	name: String,
	value: Option[String],
	allow_zero: Bool,
) -> Result[Option[Int], String]:
	match value:
		None:
			Ok(None)
		Some(raw):
			match raw.parse_int():
				Some(parsed):
					checked_integer_option(name, Some(parsed), allow_zero)
				None:
					Err(integer_requirement_message(name, allow_zero))


---
The command-line integer when given, else the integer named by
`environment_value`. Either source is range-checked.
---
pure func resolved_integer_option(
	cli_value: Option[Int],
	name: String,
	environment_value: Option[String],
	allow_zero: Bool,
) -> Result[Option[Int], String]:
	match cli_value:
		Some(_):
			checked_integer_option(name, cli_value, allow_zero)
		None:
			environment_integer(name, environment_value, allow_zero)


pure func resolve_run_args_environment(
	options: CliRunArgs,
	environment: CliRunEnvironment,
) -> Result[CliRunArgs, String]:
	timeout ?= checked_integer_option("--timeout", options.timeout, True)
	threads ?= resolved_integer_option(
		options.threads,
		"BLORP_THREADS/--threads",
		environment.threads,
		False,
	)
	-- The compiler CLI owns leak configuration for its child. Any inherited
	-- leak mode needs a diagnostic child runtime, including strict/verbose.
	memory_diagnostics: Bool = options.memory_diagnostics or environment.leak_check != None

	Ok({ options |
			timeout = timeout,
			threads = threads,
			leak_check = options.leak_check or environment.leak_check == Some("1"),
			memory_diagnostics = memory_diagnostics
		})
