-- Native link requirements derived from one retained frontend graph. Keeping
-- this scan independent of compile execution lets planners inspect a graph
-- without importing the complete Core/backend pipeline.
import:
	../compiler/stage_04_modules/frontend_graph:
		FrontendGraph,
		FrontendModule,
		frontend_graph_dependency_modules,
		frontend_graph_root_modules,
	../compiler/stage_04_modules/loaded_module:
		ModuleOrigin(NativePackageModule, StdlibModule),
		resolved_module_canonical_path,
		resolved_module_origin,
	../lib/build_artifact: BuildNativeFeature(BuildRaylib, BuildTls)


private RAYLIB_PACKAGE_ID: String = "raylib"

private TLS_STD_MODULE: String = "net/tls"


private pure func module_native_features(module: FrontendModule) -> List[BuildNativeFeature]:
	origin = resolved_module_origin(module.identity)

	raylib_features: List[BuildNativeFeature] = match origin:
		NativePackageModule(package_id):
			if package_id == RAYLIB_PACKAGE_ID:
				[BuildRaylib]
			else:
				[]
		_:
			[]

	tls_features: List[BuildNativeFeature] = match origin:
		StdlibModule:
			if resolved_module_canonical_path(module.identity) == TLS_STD_MODULE:
				[BuildTls]
			else:
				[]
		_:
			[]

	raylib_features.concat(tls_features)


pure func graph_native_features(graph: FrontendGraph) -> List[BuildNativeFeature]:
	frontend_graph_root_modules(graph)
		.concat(frontend_graph_dependency_modules(graph))
		.flat_map(module_native_features)
		.unique()
