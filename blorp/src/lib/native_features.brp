-- Native link requirements derived from one retained frontend graph. Keeping
-- this scan independent of compile execution lets planners inspect a graph
-- without importing the complete Core/backend pipeline.
import:
	../compiler/frontend_request:
		FrontendGraphSource,
		FrontendModuleGraph,
		FrontendModuleOrigin(FrontendPkgModule, FrontendStdModule),
	../lib/build_artifact: BuildNativeFeature(BuildRaylib, BuildTls)


private RAYLIB_PACKAGE_ID: String = "raylib"

private TLS_STD_MODULE: String = "net/tls"


private pure func source_native_features(source: FrontendGraphSource) -> List[BuildNativeFeature]:
	raylib_features: List[BuildNativeFeature] = match source.origin:
		FrontendPkgModule(package_id):
			if package_id == RAYLIB_PACKAGE_ID:
				[BuildRaylib]
			else:
				[]
		_:
			[]

	tls_features: List[BuildNativeFeature] = match source.origin:
		FrontendStdModule:
			if source.module_name == TLS_STD_MODULE:
				[BuildTls]
			else:
				[]
		_:
			[]

	raylib_features.concat(tls_features)


pure func graph_native_features(graph: FrontendModuleGraph) -> List[BuildNativeFeature]:
	graph.roots
		.concat(graph.modules)
		.flat_map(source_native_features)
		.unique()
