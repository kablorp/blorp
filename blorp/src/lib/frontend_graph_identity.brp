-- Compact source identity shared by frontend graph ownership and test-session
-- planning. Physical filesystem identity remains owned by discovery; module
-- name is retained because one source can have multiple nominal identities.
record FrontendGraphSourceKey {
	path: String,
	module_name: String
}


pure func cli_frontend_graph_source_key(
	path: String,
	module_name: String,
) -> FrontendGraphSourceKey:
	{
		path = path,
		module_name = module_name
	}
