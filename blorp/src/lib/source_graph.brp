private TEST_RUNTIME_MODULE: String = "test"


private pure func finalized_program_for_source(
	path: String,
	module_name: String,
	text: String,
) -> FinalizedTypecheckProgram:
	finalized_typecheck_program(parse_compiler_source(source_file(path, module_name, text)))


private pure func is_path_under_dir(dir: String, path: String) -> Bool:
	normalized_dir: String = normalize(dir)
	normalized_path: String = normalize(path)
	normalized_path == normalized_dir or normalized_path.starts_with(normalized_dir + "/")


private pure func single_path(paths: List[String]) -> Option[String]:
	match paths:
		[path]:
			Some(path)
		_:
			None


func single_source_path_for_action(action: CliAction) -> Option[String]:
	match action:
		CliCompile(args):
			single_path(args.files)
		CliRun(args):
			single_path(args.files)
		_:
			None


private func expand_check_target(path: String) -> Result[CliCheckTargetExpansion, String]:
	if not file_exists(path):
		Err("failed to read source file `" + path + "`: not found: " + path)
	else if is_directory(path):
		source_paths ?= walk_files(path).map_err(func(error): message(error))
		Ok({
			targets = [CliSourceDirectoryTarget(path)],
			source_paths = source_paths.filter(func(source_path): source_path.ends_with(".brp")),
		})
	else:
		Ok({
			targets = [CliSourceFileTarget(path)],
			source_paths = [path],
		})


func expand_check_targets(paths: List[String]) -> Result[CliCheckTargetExpansion, String]:
	var targets: List[CliSourceTarget] = []
	var source_paths: List[String] = []
	var error: Option[String] = None

	for path in paths:
		match error:
			Some(_):
				break
			None:
				match expand_check_target(path):
					Ok(expansion):
						targets = targets.concat(expansion.targets)
						source_paths = source_paths.concat(expansion.source_paths)
					Err(message):
						error = Some(message)

	match error:
		Some(message):
			Err(message)
		None:
			Ok({
				targets = targets,
				source_paths = source_paths.sort(),
			})


private func read_text_file(path: String) -> Result[String, String]:
	with reader ?= open_read(path) on err => message(err):
		match reader.read_text():
			Ok(source):
				Ok(source)
			Err(err):
				Err(message(err))


func read_cli_source_file(path: String) -> Result[CliSourceFile, String]:
	source ?= read_text_file(
		path,
	).map_err(
		func(err): "failed to read source file `" + path + "`: " + err,
	)

	Ok({
		path = path,
		module_name = stem(path),
		source_text = source,
	})


pure func single_explicit_check_source(
	expansion: CliCheckTargetExpansion,
	sources: List[CliSourceFile],
) -> Option[CliSourceFile]:
	match expansion.targets:
		[CliSourceFileTarget(path)]:
			match sources:
				[source]:
					if source.path == path:
						Some(source)
					else:
						None
				_:
					None
		_:
			None


pure func parse_cli_source(source: CliSourceFile) -> CliParsedSourceFile:
	{
		path = source.path,
		module_name = source.module_name,
		source_text = source.source_text,
		typecheck_program = finalized_program_for_source(
			source.path,
			source.module_name,
			source.source_text,
		)
	}


pure func parsed_cli_source_from_program(program: ParsedProgram) -> CliParsedSourceFile:
	{
		path = program.source.path,
		module_name = program.source.module_name,
		source_text = program.source.text,
		typecheck_program = finalized_typecheck_program(program)
	}


union CliResolvedImportContents:
	CliFilesystemImport
	CliEmbeddedImport(String)


record CliResolvedImportSource {
	path: String,
	module_name: String,
	origin: ModuleOrigin,
	contents: CliResolvedImportContents
}


private pure func action_std_dir(action: CliAction) -> Option[String]:
	match action:
		CliCheck(args):
			args.std_dir
		CliCompile(args):
			args.std_dir
		CliRun(args):
			args.std_dir
		CliTest(args):
			args.std_dir
		_:
			None


private func action_or_env_std_dir(action: CliAction) -> Option[String]:
	match action_std_dir(action):
		Some(path):
			Some(path)
		None:
			match getenv("BLORP_STD"):
				Some(path):
					if path.trim() == "":
						None
					else:
						Some(path)
				None:
					None


private func default_package_cache_base() -> String:
	match getenv("HOME"):
		Some(home):
			if (
				home
					.trim()
					.length() > 0
			):
				join(home, ".cache")
			else:
				join(temp_dir(), ".cache")
		None:
			join(temp_dir(), ".cache")


private func package_cache_root_without_override() -> String:
	cache_base: String = match getenv("XDG_CACHE_HOME"):
		Some(path):
			if (
				path
					.trim()
					.length() > 0
			):
				path
			else:
				default_package_cache_base()
		None:
			default_package_cache_base()

	join(
		join(cache_base, "blorp"),
		"packages",
	)


private func cli_package_cache_root() -> String:
	match getenv("BLORP_PACKAGE_CACHE"):
		Some(path):
			if (
				path
					.trim()
					.length() > 0
			):
				path
			else:
				package_cache_root_without_override()
		None:
			package_cache_root_without_override()


private pure func strip_prefix(prefix: String, text: String) -> String:
	text.drop_left(prefix.length())


private pure func absolute_path_from(cwd: String, path: String) -> String:
	if path.starts_with("/"):
		normalize(path)
	else:
		normalize(join(cwd, path))


private func absolute_path(path: String) -> String:
	absolute_path_from(getcwd(), path)


private func source_identity_path(path: String) -> String:
	absolute: String = absolute_path(path)
	canonical_existing_path(absolute).get_or(absolute)


private func module_name_for_resolved_source_path(path: String) -> String:
	cwd: String = normalize(getcwd())
	absolute: String = absolute_path(path)

	relative: String = if is_path_under_dir(cwd, absolute):
		strip_prefix(cwd + "/", absolute)
	else:
		absolute

	if relative.ends_with(".brp"):
		relative.substring(0, relative.length() - 4)
	else:
		relative


-- Multi-root read-only tools need the same canonical path/module identity used
-- by import discovery. Basename-only root identities collide for distinct
-- modules such as the compiler's two type_resolution sources.
func canonical_cli_source_for_graph(source: CliSourceFile) -> CliSourceFile:
	canonical_path: String = source_identity_path(source.path)
	{ source |
		path = canonical_path,
		module_name = module_name_for_resolved_source_path(canonical_path)
	}


private pure func module_source_filename(module_path: String) -> String:
	if module_path.ends_with(".brp"):
		module_path
	else:
		module_path + ".brp"


record CliSourceGraphSetup {
	context: FrontendGraphContext,
	diagnostics: List[String]
}


private pure func cli_source_package(package: ProjectSourcePackage) -> FrontendSourcePackage:
	{
		package_alias = package.layout.package_alias,
		package_name = package.layout.package_name,
		package_root = package.package_root,
		source_dir = package.layout.source_dir,
		exports = package.layout.exports
	}


private pure func project_source_catalog_issue_diagnostic(
	issue: ProjectSourceCatalogIssue,
) -> String:
	match issue:
		ProjectConfigReadFailed(path, detail):
			"failed to read `${path}`: ${detail}"
		ProjectConfigParseFailed(path, detail):
			"failed to parse `${path}`: ${detail}"
		ProjectPackagePathEmpty(package_alias):
			"package alias `${package_alias}` has an empty path"
		ProjectPackageLocationMissing(package_alias):
			"package alias `${package_alias}` must define path or hash"
		ProjectPackageHashInvalid(package_alias, pin):
			"package alias `${package_alias}` has an invalid hash pin: ${pin}"
		ProjectPackageCacheUnavailable(package_alias, pin, locations):
			help: String = if locations.length() == 0:
				"Add from = [...] for package `${package_alias}` and run `blorp package fetch ${package_alias}`, or configure a local path."
			else:
				"Run `blorp package fetch ${package_alias}` from the project directory before compiling."

			"package alias `${package_alias}` cannot use hash ${pin} from the local package cache\nhelp: ${help}"
		ProjectInvalidSourcePackage(package_alias, package_root, _):
			"package alias `${package_alias}` does not resolve to a valid source package at `${package_root}`"
		ProjectStdDirectoryInvalid(path):
			"standard-library directory `${path}` does not exist or is not a directory"
		ProjectConflictingStdDirectories(selected, configured):
			"source roots require conflicting standard-library directories `${selected}` and `${configured}`"
		ProjectConflictingPackageAlias(package_alias, existing, conflicting):
			"package alias `${package_alias}` resolves to both `${existing}` and `${conflicting}`"


func source_graph_setup_for_paths(
	action: CliAction,
	root_paths: List[String],
) -> CliSourceGraphSetup:
	request: ProjectSourceCatalogRequest = {
		working_directory = getcwd(),
		roots = root_paths.map(func(path): ProjectSourceFileRoot(path)),
		std_override = action_or_env_std_dir(action),
		package_cache_root = cli_package_cache_root()
	}
	catalog = project_source_catalog(request)

	std_dir: Option[String] = match catalog.std_provider:
		ProjectEmbeddedStd:
			None
		ProjectFilesystemStd(path):
			Some(path)

	{
		context = {
			std_dir = std_dir,
			source_packages = catalog.source_packages.map(cli_source_package),
			package_roots = catalog.native_package_roots
		},
		diagnostics = catalog.issues.map(project_source_catalog_issue_diagnostic)
	}


private func source_graph_setup_for_sources(
	action: CliAction,
	roots: List[CliParsedSourceFile],
) -> CliSourceGraphSetup:
	source_graph_setup_for_paths(
		action,
		roots.map(func(root): root.path),
	)


private pure func split_module_ref(module_path: String) -> Option[(String, String)]:
	match module_path.split("/"):
		[]:
			None
		[""]:
			None
		[head]:
			if head.length() == 0:
				None
			else:
				Some((head, ""))
		[head, ...rest]:
			if head.length() == 0:
				None
			else:
				Some((head, rest.join("/")))


private func source_package_for_path(
	context: FrontendGraphContext,
	path: String,
) -> Option[FrontendSourcePackage]:
	if context.source_packages.length() == 0:
		None
	else:
		var result: Option[FrontendSourcePackage] = None
		absolute: String = source_identity_path(path)

		for package in context.source_packages:
			if is_path_under_dir(source_identity_path(package.source_dir), absolute):
				result = Some(package)
				break

		result


private func path_is_in_configured_std(context: FrontendGraphContext, path: String) -> Bool:
	match context.std_dir:
		Some(std_dir):
			is_path_under_dir(source_identity_path(std_dir), source_identity_path(path))
		None:
			False


private func configured_std_module_name(
	context: FrontendGraphContext,
	path: String,
) -> Option[String]:
	match context.std_dir:
		Some(std_dir):
			std_root: String = source_identity_path(std_dir)
			absolute: String = source_identity_path(path)

			if is_path_under_dir(std_root, absolute):
				relative: String = strip_prefix(std_root + "/", absolute)

				without_extension: String = if relative.ends_with(".brp"):
					relative.substring(0, relative.length() - 4)
				else:
					relative

				Some(without_extension)
			else:
				None
		None:
			None


private pure func parsed_source_with_module_name(
	source: CliParsedSourceFile,
	module_name: String,
) -> CliParsedSourceFile:
	{ source |
		module_name = module_name,
		typecheck_program = finalized_program_for_source(
			source.path,
			module_name,
			source.source_text,
		)
	}


private func parse_cli_source_with_context(
	context: FrontendGraphContext,
	source: CliSourceFile,
) -> CliParsedSourceFile:
	match configured_std_module_name(context, source.path):
		Some(module_name):
			if module_name == source.module_name:
				parse_cli_source(source)
			else:
				parse_cli_source({ source | module_name = module_name })
		None:
			parse_cli_source(source)


func parse_cli_source_with_setup(
	setup: CliSourceGraphSetup,
	source: CliSourceFile,
) -> CliParsedSourceFile:
	parse_cli_source_with_context(setup.context, source)


func parse_cli_sources_with_setup(
	setup: CliSourceGraphSetup,
	sources: List[CliSourceFile],
) -> List[CliParsedSourceFile]:
	var parsed_sources: List[CliParsedSourceFile] = []

	for source in sources:
		parsed_sources = parsed_sources.append(parse_cli_source_with_context(setup.context, source))

	parsed_sources


private func normalize_root_module_name(
	context: FrontendGraphContext,
	source: CliParsedSourceFile,
) -> CliParsedSourceFile:
	match configured_std_module_name(context, source.path):
		Some(module_name):
			if module_name == source.module_name:
				source
			else:
				parsed_source_with_module_name(source, module_name)
		None:
			source


private func normalize_root_module_names(
	context: FrontendGraphContext,
	roots: List[CliParsedSourceFile],
) -> List[CliParsedSourceFile]:
	roots.map(func(source): normalize_root_module_name(context, source))


private func compiler_module_origin_for_path(
	context: FrontendGraphContext,
	path: String,
	module_name: String,
) -> ModuleOrigin:
	if path_is_in_configured_std(context, path):
		StdlibModule
	else if module_name.starts_with("pkg/"):
		match split_module_ref(strip_prefix("pkg/", module_name)):
			Some((package_id, _)):
				NativePackageModule(package_id)
			None:
				NativePackageModule("pkg")
	else:
		match source_package_for_path(context, path):
			Some(package):
				SourcePackageModule(package.package_alias)
			None:
				UserModule


private pure func filesystem_import_source(
	path: String,
	module_name: String,
	origin: ModuleOrigin,
) -> CliResolvedImportSource:
	{
		path = normalize(path),
		module_name = module_name,
		origin = origin,
		contents = CliFilesystemImport
	}


private pure func embedded_std_import_source(
	module_name: String,
) -> Option[CliResolvedImportSource]:
	source_text ?= embedded_std_source(module_name)

	Some({
		path = "<embedded:${module_name}>",
		module_name = module_name,
		origin = StdlibModule,
		contents = CliEmbeddedImport(source_text),
	})


private pure func source_package_layout(package: FrontendSourcePackage) -> SourcePackageLayout:
	{
		package_alias = package.package_alias,
		package_name = package.package_name,
		source_dir = package.source_dir,
		exports = package.exports
	}


private func resolve_source_package_alias_import(
	context: FrontendGraphContext,
	module_path: String,
) -> Option[CliResolvedImportSource]:
	var result: Option[CliResolvedImportSource] = None

	for package in context.source_packages:
		if result.is_some():
			break

		layout = source_package_layout(package)

		match source_package_export_for_alias(layout, module_path):
			Some(package_module):
				path = source_package_path_for_module(layout, package_module)

				if file_exists(path):
					result = Some(
						filesystem_import_source(
							path,
							module_path,
							SourcePackageModule(package.package_alias),
						),
					)
			None:
				void

	result


private func resolve_source_package_internal_import(
	package: FrontendSourcePackage,
	module_path: String,
) -> Option[CliResolvedImportSource]:
	layout = source_package_layout(package)

	if source_package_contains_internal_module(layout, module_path):
		path = source_package_path_for_module(layout, module_path)

		if file_exists(path):
			Some(
				filesystem_import_source(
					path,
					module_path,
					SourcePackageModule(package.package_alias),
				),
			)
		else:
			None
	else:
		None


private func resolve_native_package_import(
	context: FrontendGraphContext,
	module_path: String,
) -> Option[CliResolvedImportSource]:
	rest: String = strip_prefix("pkg/", module_path)
	var result: Option[CliResolvedImportSource] = None

	for package_root in context.package_roots:
		if result.is_some():
			break

		candidate: String = join(package_root, module_source_filename(rest))

		if file_exists(candidate):
			package_id: String = split_module_ref(rest)
				.map(func(parts): parts[0])
				.get_or("pkg")
			result = Some(
				filesystem_import_source(
					candidate,
					module_path,
					NativePackageModule(package_id),
				),
			)

	result


private func resolve_standard_library_import(
	context: FrontendGraphContext,
	module_path: String,
) -> Option[CliResolvedImportSource]:
	match context.std_dir:
		Some(dir):
			path: String = join(dir, module_source_filename(module_path))

			if file_exists(path):
				Some(filesystem_import_source(path, module_path, StdlibModule))
			else:
				None
		None:
			embedded_std_import_source(module_path)


private pure func source_package_with_alias(
	context: FrontendGraphContext,
	package_alias: String,
) -> Option[FrontendSourcePackage]:
	context.source_packages.find(func(package): package.package_alias == package_alias)


private func resolve_path_import(
	path: String,
	confinement_origin: Option[ModuleOrigin],
	context: FrontendGraphContext,
) -> Option[CliResolvedImportSource]:
	allowed: Bool = match confinement_origin:
		Some(SourcePackageModule(package_alias)):
			match source_package_with_alias(context, package_alias):
				Some(package):
					is_path_under_dir(package.source_dir, path)
				None:
					False
		_:
			True

	if allowed and file_exists(path):
		origin: ModuleOrigin = confinement_origin.get_or(UserModule)
		Some(filesystem_import_source(path, module_name_for_resolved_source_path(path), origin))
	else:
		None


private func resolve_frontend_import_lookup(
	context: FrontendGraphContext,
	lookup: FrontendImportLookup,
) -> Option[CliResolvedImportSource]:
	match lookup:
		FrontendNativePackageLookup(module_path):
			resolve_native_package_import(context, module_path)
		FrontendStandardLibraryLookup(module_path):
			resolve_standard_library_import(context, module_path)
		FrontendRelativePathLookup(path, confinement_origin):
			resolve_path_import(path, Some(confinement_origin), context)
		FrontendSourcePackageAliasLookup(module_path):
			resolve_source_package_alias_import(context, module_path)
		FrontendSourcePackageInternalLookup(package_alias, module_path):
			match source_package_with_alias(context, package_alias):
				Some(package):
					resolve_source_package_internal_import(package, module_path)
				None:
					None
		FrontendLocalPathLookup(path):
			resolve_path_import(path, None, context)


private func read_cli_import_source(
	resolved: CliResolvedImportSource,
) -> Result[Option[CliSourceFile], String]:
	match resolved.contents:
		CliEmbeddedImport(source_text):
			Ok(Some({
				path = resolved.path,
				module_name = resolved.module_name,
				source_text = source_text,
			}))
		CliFilesystemImport:
			if not file_exists(resolved.path):
				Ok(None)
			else:
				source ?= read_text_file(
					resolved.path,
				).map_err(
					func(err): "failed to read source file `" + resolved.path + "`: " + err,
				)

				Ok(Some({
					path = resolved.path,
					module_name = resolved.module_name,
					source_text = source,
				}))


private pure func generated_import_binding(
	bindings: List[CliGeneratedModuleImport],
	module_path: String,
) -> Result[Option[CliGeneratedModuleImport], String]:
	var found: Option[CliGeneratedModuleImport] = None
	var count: Int = 0

	for binding in bindings:
		if binding.module_path == module_path:
			found = Some(binding)
			count += 1

	if count > 1:
		Err("generated module has duplicate binding for import `" + module_path + "`")
	else:
		Ok(found)


private pure func ambiguous_generated_import_module(
	bindings: List[CliGeneratedModuleImport],
) -> Option[String]:
	var seen: List[CliGeneratedModuleImport] = []
	var ambiguous: Option[String] = None

	for binding in bindings:
		if ambiguous.is_some():
			break

		if seen.any(
			func(
				existing,
			): (
				existing.source_module == binding.source_module
				and existing.source_path != binding.source_path
			),
		):
			ambiguous = Some(binding.source_module)
		else:
			seen = seen.append(binding)

	ambiguous


private func implicit_std_module_source(
	context: FrontendGraphContext,
	roots: List[CliParsedSourceFile],
	module_name: String,
) -> Result[List[CliSourceFile], String]:
	if roots.any(func(root): root.module_name == module_name):
		Ok([])
	else:
		match context.std_dir:
			Some(std_dir):
				path: String = normalize(join(std_dir, module_source_filename(module_name)))

				if roots.any(func(root): normalize(root.path) == path) or not file_exists(path):
					Ok([])
				else:
					source ?= read_text_file(
						path,
					).map_err(
						func(err): "failed to read implicit compiler module `${path}`: ${err}",
					)

					Ok(
						[
							{
								path = path,
								module_name = module_name,
								source_text = source
							},
						],
					)
			None:
				match embedded_std_source(module_name):
					Some(source):
						Ok(
							[
								{
									path = "<embedded:${module_name}>",
									module_name = module_name,
									source_text = source
								},
							],
						)
					None:
						Err("embedded standard library is missing `${module_name}`")


private func implicit_compiler_sources_from(
	context: FrontendGraphContext,
	roots: List[CliParsedSourceFile],
	module_paths: List[String],
	index: Int,
) -> Result[List[CliSourceFile], String]:
	if index >= module_paths.length():
		Ok([])
	else:
		module_path = module_paths.get_or(index, "")
		current ?= implicit_std_module_source(context, roots, module_path)
		rest ?= implicit_compiler_sources_from(context, roots, module_paths, index + 1)
		Ok(current.concat(rest))


private func implicit_compiler_sources(
	context: FrontendGraphContext,
	roots: List[CliParsedSourceFile],
) -> Result[List[CliSourceFile], String]:
	module_paths = COMPILER_FRONTEND_IMPLICIT_MODULE_PATHS

	implicit_compiler_sources_from(context, roots, module_paths, 0)


private func implicit_test_runtime_sources(
	context: FrontendGraphContext,
	roots: List[CliParsedSourceFile],
	enabled: Bool,
) -> Result[List[CliSourceFile], String]:
	if enabled:
		implicit_std_module_source(context, roots, TEST_RUNTIME_MODULE)
	else:
		Ok([])


private func implicit_compiler_sources_if_enabled(
	context: FrontendGraphContext,
	roots: List[CliParsedSourceFile],
	enabled: Bool,
) -> Result[List[CliSourceFile], String]:
	if enabled:
		implicit_compiler_sources(context, roots)
	else:
		Ok([])


private func source_candidate(
	context: FrontendGraphContext,
	source: CliSourceFile,
) -> FrontendSourceCandidate:
	origin = compiler_module_origin_for_path(context, source.path, source.module_name)
	source_candidate_with_origin(source, origin)


private pure func source_candidate_with_origin(
	source: CliSourceFile,
	origin: ModuleOrigin,
) -> FrontendSourceCandidate:
	{
		identity = resolved_module_identity_from_resolver(source.module_name, origin),
		source = source_file(source.path, source.module_name, source.source_text)
	}


private func parsed_source_candidate(
	context: FrontendGraphContext,
	source: CliParsedSourceFile,
) -> FrontendSourceCandidate:
	origin = compiler_module_origin_for_path(context, source.path, source.module_name)
	{
		identity = resolved_module_identity_from_resolver(source.module_name, origin),
		source = source_file(source.path, source.module_name, source.source_text)
	}


private func resolve_frontend_source_candidate(
	context: FrontendGraphContext,
	importer: FrontendSourceCandidate,
	requested_path: String,
) -> Result[FrontendSourceResolution, String]:
	var resolved: Option[CliResolvedImportSource] = None

	for lookup in frontend_import_lookup_plan(importer, requested_path):
		if resolved.is_none():
			resolved = resolve_frontend_import_lookup(context, lookup)

	match resolved:
		None:
			Ok(FrontendSourceUnresolved)
		Some(source):
			match read_cli_import_source(source):
				Err(message):
					Err(message)
				Ok(None):
					Ok(FrontendSourceUnresolved)
				Ok(Some(import_source)):
					Ok(
						FrontendSourceResolved(
							source_candidate_with_origin(
								import_source,
								source.origin,
							),
						),
					)


private pure func parsed_source_for_compiler_module(module: FrontendModule) -> CliParsedSourceFile:
	program = finalized_typecheck_program_ast(module.program)
	{
		path = program.source.path,
		module_name = program.source.module_name,
		source_text = program.source.text,
		typecheck_program = module.program
	}


private func compiler_frontend_graph_for_roots(
	context: FrontendGraphContext,
	roots: List[CliParsedSourceFile],
	include_implicit_compiler_sources: Bool,
	include_test_runtime: Bool,
) -> Result[FrontendGraph, String]:
	sources ?= implicit_compiler_sources_if_enabled(
		context,
		roots,
		include_implicit_compiler_sources,
	)
	test_runtime_sources ?= implicit_test_runtime_sources(context, roots, include_test_runtime)
	implicit_sources: List[CliSourceFile] = sources.concat(test_runtime_sources)
	root_candidates = roots.map(func(root): parsed_source_candidate(context, root))
	seed_candidates = implicit_sources.map(func(source):
		source_candidate_with_origin(source, StdlibModule)
	)
	frontend_graph_discover(root_candidates, seed_candidates, func(importer, requested_path):
		resolve_frontend_source_candidate(context, importer, requested_path)
	).map_err(frontend_discovery_error_message)


func frontend_compilation_graph_for_roots(
	action: CliAction,
	roots: List[CliParsedSourceFile],
) -> Result[FrontendCompilationGraph, String]:
	setup: CliSourceGraphSetup = source_graph_setup_for_sources(action, roots)

	include_test_runtime: Bool = match action:
		CliTest(_):
			True
		_:
			False

	frontend_compilation_graph_for_roots_with_setup_and_test_runtime(
		setup,
		roots,
		include_test_runtime,
	)


func frontend_compilation_graph_for_roots_with_setup(
	setup: CliSourceGraphSetup,
	roots: List[CliParsedSourceFile],
) -> Result[FrontendCompilationGraph, String]:
	frontend_compilation_graph_for_roots_with_setup_and_test_runtime(setup, roots, False)


private func frontend_compilation_graph_for_roots_with_setup_and_test_runtime(
	setup: CliSourceGraphSetup,
	roots: List[CliParsedSourceFile],
	include_test_runtime: Bool,
) -> Result[FrontendCompilationGraph, String]:
	context: FrontendGraphContext = setup.context
	normalized_roots: List[CliParsedSourceFile] = normalize_root_module_names(context, roots)
	graph ?= compiler_frontend_graph_for_roots(
		context,
		normalized_roots,
		True,
		include_test_runtime,
	)

	Ok({
		context = context,
		graph = graph,
		diagnostics = setup.diagnostics,
	})


private pure func frontend_graph_keys_contain(
	keys: List[FrontendGraphSourceKey],
	key: FrontendGraphSourceKey,
) -> Bool:
	var contains: Bool = False

	for existing in keys:
		if existing.path == key.path and existing.module_name == key.module_name:
			contains = True
			break

	contains


private pure func resolved_identity_list_contains(
	identities: List[ResolvedModuleIdentity],
	target: ResolvedModuleIdentity,
) -> Bool:
	identities.any(func(identity): resolved_module_identities_equal(identity, target))


-- Keep repeated loop publications as ordinary value copies. Passing the local
-- through a pure boundary prevents a later iteration from being mistaken for
-- the final consuming use of the same opaque identity.
private pure func copied_resolved_identity(
	identity: ResolvedModuleIdentity,
) -> ResolvedModuleIdentity:
	identity


-- Project one batch from an invocation-owned graph without reading or parsing
-- source again. Other invocation roots are retained as modules only when they
-- are reachable dependencies of the selected roots.
pure func frontend_compilation_graph_for_retained_roots(
	graph: FrontendCompilationGraph,
	root_keys: List[FrontendGraphSourceKey],
) -> Result[FrontendCompilationGraph, String]:
	if root_keys.length() == 0:
		Err("retained frontend graph projection requires at least one root")
	else:
		available_roots = frontend_graph_root_modules(graph.graph)
		var roots: List[FrontendModule] = []
		var seen: List[FrontendGraphSourceKey] = []
		var error: Option[String] = None

		for key in root_keys:
			if frontend_graph_keys_contain(seen, key):
				error = Some(
					"retained frontend graph projection repeats root `" + key.module_name + "` at `" + key.path + "`",
				)
				break
			else:
				matches = available_roots.filter(func(module):
					program = finalized_typecheck_program_ast(module.program)

					(
						program.source.path == key.path
						and program.source.module_name == key.module_name
					)
				)

				match matches:
					[]:
						error = Some(
							"retained frontend graph projection root `" + key.module_name + "` at `" + key.path + "` is absent",
						)
					[module]:
						roots = roots.append(module)
						seen = seen.append(key)
					_:
						error = Some(
							"retained frontend graph projection root `" + key.module_name + "` at `" + key.path + "` is ambiguous",
						)
						break

		match error:
			Some(message):
				Err(message)
			None:
				var closure = roots.map(func(module): module.identity)

				for module in frontend_graph_modules(graph.graph):
					origin = resolved_module_origin(module.identity)
					canonical_path = resolved_module_canonical_path(module.identity)

					is_implicit: Bool = match origin:
						StdlibModule:
							(
								COMPILER_FRONTEND_IMPLICIT_MODULE_PATHS.contains(canonical_path)
								or canonical_path == TEST_RUNTIME_MODULE
							)
						_:
							False

					if (
						is_implicit
						and not resolved_identity_list_contains(closure, module.identity)
					):
						closure = closure.append(module.identity)

				var changed = True

				while changed:
					changed = False

					for edge in frontend_graph_import_edges(graph.graph):
						if resolved_identity_list_contains(closure, edge.importer):
							match edge.resolution:
								FrontendResolvedImport(target):
									if not resolved_identity_list_contains(closure, target):
										closure = closure.append(target)
										changed = True
								FrontendUnresolvedImport:
									void

				var modules: List[FrontendModule] = []

				for module in frontend_graph_modules(graph.graph):
					if resolved_identity_list_contains(closure, module.identity):
						modules = modules.append(module)

				var edges: List[FrontendImportEdge] = []

				for edge in frontend_graph_import_edges(graph.graph):
					if resolved_identity_list_contains(closure, edge.importer):
						edges = edges.append(edge)

				root_identities = roots.map(func(module): module.identity)

				match validated_frontend_graph_for_modules(modules, root_identities, edges):
					Err(errors):
						Err(
							errors
								.map(frontend_graph_service_error_message)
								.join("\n"),
						)
					Ok(projected):
						Ok({ graph | graph = projected })


func frontend_compilation_graph_with_generated_root(
	graph: FrontendCompilationGraph,
	generated_module: CliGeneratedModule,
) -> Result[FrontendCompilationGraph, String]:
	existing_modules = frontend_graph_modules(graph.graph)
	collision: Option[FrontendModule] = existing_modules.find(func(module):
		program = finalized_typecheck_program_ast(module.program)

		(
			program.source.path == generated_module.source.path
			or program.source.module_name == generated_module.source.module_name
		)
	)

	match collision:
		Some(module):
			program = finalized_typecheck_program_ast(module.program)
			Err(
				"generated module identity collides with existing graph source `" + program.source.module_name + "` at `" + program.source.path + "`",
			)
		None:
			match ambiguous_generated_import_module(generated_module.imports):
				Some(module_name):
					Err(
						"generated imports target distinct sources with the same module identity `" + module_name + "`",
					)
				None:
					generated = parse_cli_source(generated_module.source)
					generated_identity = resolved_module_identity_from_resolver(
						generated.module_name,
						UserModule,
					)
					generated_surface = module_surface_for_program(
						finalized_typecheck_program_ast(generated.typecheck_program),
					)
					generated_root: FrontendModule = {
						identity = copied_resolved_identity(generated_identity),
						program = generated.typecheck_program,
						surface = generated_surface
					}
					var import_edges: List[FrontendImportEdge] = []
					var import_error: Option[String] = None

					for module_path in generated_surface.import_paths:
						if import_error.is_some():
							break

						match generated_import_binding(generated_module.imports, module_path):
							Err(message):
								import_error = Some(message)
							Ok(binding):
								matches = existing_modules.filter(func(module):
									program = finalized_typecheck_program_ast(module.program)

									match binding:
										Some(explicit):
											(
												program.source.path == explicit.source_path
												and program.source.module_name == explicit.source_module
											)
										None:
											program.source.module_name == module_path
								)

								match matches:
									[target]:
										import_edges = import_edges.append({
											importer = copied_resolved_identity(generated_identity),
											requested_path = module_path,
											resolution = FrontendResolvedImport(target.identity),
										})
									[]:
										message: String = match binding:
											Some(explicit):
												"generated import `" + module_path + "` targets an absent graph identity `" + explicit.source_module + "` at `" + explicit.source_path + "`"
											None:
												"generated import `" + module_path + "` is absent from the retained graph"

										import_error = Some(message)
									_:
										message: String = match binding:
											Some(_):
												"generated import `" + module_path + "` targets an ambiguous graph identity"
											None:
												"generated import `" + module_path + "` has an ambiguous retained graph identity"

										import_error = Some(message)

					match import_error:
						Some(message):
							Err(message)
						None:
							match validated_frontend_graph_for_modules(
								[generated_root].concat(existing_modules),
								[copied_resolved_identity(generated_identity)],
								frontend_graph_import_edges(graph.graph).concat(import_edges),
							):
								Err(errors):
									Err(
										errors
											.map(frontend_graph_service_error_message)
											.join("\n"),
									)
								Ok(combined):
									Ok({ graph | graph = combined })
