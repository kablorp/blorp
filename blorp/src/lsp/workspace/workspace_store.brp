-- Identity-coherent persistent stores for workspace-owned facts.
--
-- Keys are always derived from the stored value. The generic indexed store is
-- hidden behind these wrappers so source and dependency identities cannot be
-- paired with unrelated URI keys in a workspace snapshot.
import:
	../../compiler/stage_04_modules/frontend_graph:
		FrontendImportEdge,
		FrontendImportResolution(FrontendResolvedImport, FrontendUnresolvedImport),
	../../compiler/stage_04_modules/loaded_module:
		ResolvedModuleIdentity,
		resolved_module_identities_equal,
		resolved_module_identity_storage_key,
	../protocol/identity: DocumentUri
	indexed_store:
		UriStore,
		uri_store,
		uri_store_contains,
		uri_store_get,
		uri_store_is_empty,
		uri_store_length,
		uri_store_remove,
		uri_store_set,
		uri_store_values,
	workspace_model:
		ModuleDependencyState(ParsedDependencies, ResolvedDependencies, UnparsedModuleDependencies),
		SourceLayers,
		module_dependency_identity,
		module_dependency_uri,


opaque type SourceStore = UriStore[SourceLayers]


private record DependencyStoreEntry {
	identity: ResolvedModuleIdentity,
	value: ModuleDependencyState
}


opaque type DependencyStore = Dict[String, DependencyStoreEntry]


pure func source_store() -> SourceStore:
	into SourceStore(uri_store())


pure func source_store_from_values(values: List[SourceLayers]) -> Result[SourceStore, DocumentUri]:
	var store: SourceStore = source_store()
	var duplicate: Option[DocumentUri] = None

	for value in values:
		if duplicate.is_none():
			if source_store_contains(store, value.uri):
				duplicate = Some(value.uri)
			else:
				store = source_store_set(store, value)

	match duplicate:
		Some(uri):
			Err(uri)
		None:
			Ok(store)


pure func source_store_get(store: SourceStore, uri: DocumentUri) -> Option[SourceLayers]:
	uri_store_get(from SourceStore(store), uri)


pure func source_store_set(store: SourceStore, value: SourceLayers) -> SourceStore:
	underlying = from SourceStore(store)
	into SourceStore(uri_store_set(underlying, value.uri, value))


pure func source_store_remove(store: SourceStore, uri: DocumentUri) -> SourceStore:
	into SourceStore(uri_store_remove(from SourceStore(store), uri))


pure func source_store_contains(store: SourceStore, uri: DocumentUri) -> Bool:
	uri_store_contains(from SourceStore(store), uri)


pure func source_store_values(store: SourceStore) -> List[SourceLayers]:
	uri_store_values(from SourceStore(store))


pure func source_store_length(store: SourceStore) -> Int:
	uri_store_length(from SourceStore(store))


pure func source_store_is_empty(store: SourceStore) -> Bool:
	uri_store_is_empty(from SourceStore(store))


pure func dependency_store() -> DependencyStore:
	empty: Dict[String, DependencyStoreEntry] = {}
	into DependencyStore(empty)


private pure func dependency_store_entries(
	store: DependencyStore,
) -> Dict[String, DependencyStoreEntry]:
	from DependencyStore(store)


pure func dependency_store_from_values(
	values: List[ModuleDependencyState],
) -> Result[DependencyStore, DocumentUri]:
	var store: DependencyStore = dependency_store()
	var duplicate: Option[DocumentUri] = None

	for value in values:
		if duplicate.is_none():
			uri = module_dependency_uri(value)
			identity = module_dependency_identity(value)
			key = resolved_module_identity_storage_key(identity)

			if dependency_store_entries(store).contains(key):
				duplicate = Some(uri)
			else:
				store = dependency_store_set(store, value)

	match duplicate:
		Some(uri):
			Err(uri)
		None:
			Ok(store)


pure func dependency_store_get(
	store: DependencyStore,
	identity: ResolvedModuleIdentity,
) -> Option[ModuleDependencyState]:
	key = resolved_module_identity_storage_key(identity)
	entry ?= dependency_store_entries(store).get(key)

	if resolved_module_identities_equal(entry.identity, identity):
		Some(entry.value)
	else:
		None


pure func dependency_store_for_uri(
	store: DependencyStore,
	uri: DocumentUri,
) -> List[ModuleDependencyState]:
	dependency_store_values(store).filter(func(value):
		module_dependency_uri(value) == uri
	)


pure func dependency_store_set(
	store: DependencyStore,
	value: ModuleDependencyState,
) -> DependencyStore:
	identity = module_dependency_identity(value)
	key = resolved_module_identity_storage_key(identity)
	entry: DependencyStoreEntry = {
		identity = identity,
		value = value
	}
	into DependencyStore(dependency_store_entries(store).set(key, entry))


pure func dependency_store_remove(
	store: DependencyStore,
	identity: ResolvedModuleIdentity,
) -> DependencyStore:
	key = resolved_module_identity_storage_key(identity)

	match dependency_store_entries(store).get(key):
		Some(entry):
			if resolved_module_identities_equal(entry.identity, identity):
				into DependencyStore(dependency_store_entries(store).remove(key))
			else:
				store
		None:
			store


pure func dependency_store_remove_for_uri(
	store: DependencyStore,
	uri: DocumentUri,
) -> DependencyStore:
	var updated = store

	for value in dependency_store_for_uri(store, uri):
		updated = dependency_store_remove(updated, module_dependency_identity(value))

	updated


pure func dependency_store_values(store: DependencyStore) -> List[ModuleDependencyState]:
	dependency_store_entries(store)
		.values()
		.map(func(entry): entry.value)


pure func dependency_store_length(store: DependencyStore) -> Int:
	dependency_store_entries(store).length()


pure func dependency_store_is_empty(store: DependencyStore) -> Bool:
	dependency_store_entries(store).is_empty()


private pure func import_resolutions_equal(
	left: FrontendImportResolution,
	right: FrontendImportResolution,
) -> Bool:
	match (left, right):
		(FrontendUnresolvedImport, FrontendUnresolvedImport):
			True
		(FrontendResolvedImport(left_target), FrontendResolvedImport(right_target)):
			resolved_module_identities_equal(left_target, right_target)
		_:
			False


private pure func import_edges_equal(left: FrontendImportEdge, right: FrontendImportEdge) -> Bool:
	(
		resolved_module_identities_equal(left.importer, right.importer)
		and left.requested_path == right.requested_path
		and import_resolutions_equal(left.resolution, right.resolution)
	)


private pure func import_edge_lists_equal(
	left: List[FrontendImportEdge],
	right: List[FrontendImportEdge],
) -> Bool:
	(
		left.length() == right.length()
		and left
			.zip(right)
			.all(func(pair):
				import_edges_equal(pair[0], pair[1])
			)
	)


private pure func dependency_states_equal(
	left: ModuleDependencyState,
	right: ModuleDependencyState,
) -> Bool:
	match (left, right):
		(UnparsedModuleDependencies(left_uri, left_identity), UnparsedModuleDependencies(right_uri, right_identity)):
			(
				left_uri == right_uri
				and resolved_module_identities_equal(left_identity, right_identity)
			)
		(ParsedDependencies(left_parsed), ParsedDependencies(right_parsed)):
			(
				left_parsed.uri == right_parsed.uri
				and resolved_module_identities_equal(
					left_parsed.module_identity,
					right_parsed.module_identity,
				)
				and left_parsed.import_paths == right_parsed.import_paths
			)
		(ResolvedDependencies(left_resolved), ResolvedDependencies(right_resolved)):
			(
				left_resolved.uri == right_resolved.uri
				and resolved_module_identities_equal(
					left_resolved.module_identity,
					right_resolved.module_identity,
				)
				and import_edge_lists_equal(left_resolved.import_edges, right_resolved.import_edges)
			)
		_:
			False


pure func dependency_stores_equal(left: DependencyStore, right: DependencyStore) -> Bool:
	left_values = dependency_store_values(left)

	left_values.length() == dependency_store_length(right) and left_values.all(func(value):
		identity = module_dependency_identity(value)

		match dependency_store_get(right, identity):
			Some(other):
				dependency_states_equal(value, other)
			None:
				False
	)
