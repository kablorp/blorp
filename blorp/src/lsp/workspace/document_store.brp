-- Immutable editor-overlay ownership keyed by the exact document URI string.
--
-- The opaque Dict representation gives expected O(1) lookup while preventing
-- protocol handlers from bypassing balanced open/close invariants.
import:
	../protocol/identity: DocumentUri, document_uri_value
	document_model:
		DocumentChange,
		DocumentSave,
		DocumentVersion,
		OpenedDocument,
		VersionedDocumentText,
		document_version_value,


opaque type DocumentStore = Dict[String, OpenedDocument]


union DocumentStoreError:
	DocumentAlreadyOpen(DocumentUri)
	DocumentNotOpen(DocumentUri)
	DocumentVersionNotNewer(DocumentUri, DocumentVersion, DocumentVersion)


private pure func document_store_from_documents(
	documents: Dict[String, OpenedDocument],
) -> DocumentStore:
	into_opaque DocumentStore(documents)


private pure func document_store_documents(store: DocumentStore) -> Dict[String, OpenedDocument]:
	from_opaque DocumentStore(store)


DOCUMENT_STORE_EMPTY: DocumentStore = document_store_from_documents({})


pure func document_store_find(store: DocumentStore, uri: DocumentUri) -> Option[OpenedDocument]:
	document_store_documents(store).get(document_uri_value(uri))


pure func document_store_open(
	store: DocumentStore,
	opened: OpenedDocument,
) -> Result[DocumentStore, DocumentStoreError]:
	uri = opened.document.uri
	key = document_uri_value(uri)
	documents = document_store_documents(store)

	if documents.contains(key):
		Err(DocumentAlreadyOpen(uri))
	else:
		Ok(document_store_from_documents(documents.set(key, opened)))


pure func document_store_change(
	store: DocumentStore,
	changed: DocumentChange,
) -> Result[DocumentStore, DocumentStoreError]:
	key = document_uri_value(changed.uri)
	documents = document_store_documents(store)

	match documents.get(key):
		None:
			Err(DocumentNotOpen(changed.uri))
		Some(opened):
			current = opened.document.version

			if document_version_value(changed.version) <= document_version_value(current):
				Err(DocumentVersionNotNewer(changed.uri, current, changed.version))
			else:
				text: String = match changed.replacement_text:
					Some(replacement):
						replacement
					None:
						opened.document.text

				document: VersionedDocumentText = {
					uri = changed.uri,
					version = changed.version,
					text = text
				}

				Ok(
					document_store_from_documents(
						documents.set(
							key,
							{ opened | document = document },
						),
					),
				)


pure func document_store_save(
	store: DocumentStore,
	saved: DocumentSave,
) -> Result[DocumentStore, DocumentStoreError]:
	key = document_uri_value(saved.uri)
	documents = document_store_documents(store)

	match documents.get(key):
		None:
			Err(DocumentNotOpen(saved.uri))
		Some(_):
			-- didSave has no version. Its optional text can describe an older save
			-- than the current edit, so only didChange may replace overlay text.
			Ok(store)


pure func document_store_close(
	store: DocumentStore,
	uri: DocumentUri,
) -> Result[DocumentStore, DocumentStoreError]:
	key = document_uri_value(uri)
	documents = document_store_documents(store)

	if documents.contains(key):
		Ok(document_store_from_documents(documents.remove(key)))
	else:
		Err(DocumentNotOpen(uri))
