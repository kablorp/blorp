-- Canonical routing over the existing document synchronization codecs.
--
-- This module selects one codec from the JSON-RPC method and preserves its
-- notification/request response obligation. It neither reparses parameters nor
-- mutates document state; the server actor sends accepted values through the
-- workspace reducer.
import:
	../protocol/identity: DocumentUri
	../protocol/json_rpc: JsonRpcEnvelope, json_rpc_method
	../protocol/protocol:
		ProtocolError,
		ProtocolFailure,
		ProtocolInputOutcome(ProtocolInputAccepted, ProtocolInputIgnored, ProtocolInputRejected),
	did_change: DID_CHANGE_METHOD, decode_lsp_did_change_envelope
	did_close: DID_CLOSE_METHOD, decode_lsp_did_close_envelope
	did_open: DID_OPEN_METHOD, decode_lsp_did_open_envelope
	did_save: DID_SAVE_METHOD, decode_lsp_did_save_envelope
	document_model: DocumentChange, DocumentSave, OpenedDocument


union DocumentNotification:
	DecodedDocumentOpen(OpenedDocument)
	DecodedDocumentChange(DocumentChange)
	DecodedDocumentSave(DocumentSave)
	DecodedDocumentClose(DocumentUri)


union DocumentEnvelopeDispatch:
	DocumentEnvelopeAccepted(DocumentNotification)
	DocumentEnvelopeIgnored(ProtocolError)
	DocumentEnvelopeRejected(ProtocolFailure)
	DocumentEnvelopeUnhandled(JsonRpcEnvelope)


private pure func open_dispatch(envelope: JsonRpcEnvelope) -> DocumentEnvelopeDispatch:
	match decode_lsp_did_open_envelope(envelope):
		ProtocolInputAccepted(document):
			DocumentEnvelopeAccepted(DecodedDocumentOpen(document))
		ProtocolInputIgnored(error):
			DocumentEnvelopeIgnored(error)
		ProtocolInputRejected(failure):
			DocumentEnvelopeRejected(failure)


private pure func change_dispatch(envelope: JsonRpcEnvelope) -> DocumentEnvelopeDispatch:
	match decode_lsp_did_change_envelope(envelope):
		ProtocolInputAccepted(change):
			DocumentEnvelopeAccepted(DecodedDocumentChange(change))
		ProtocolInputIgnored(error):
			DocumentEnvelopeIgnored(error)
		ProtocolInputRejected(failure):
			DocumentEnvelopeRejected(failure)


private pure func save_dispatch(envelope: JsonRpcEnvelope) -> DocumentEnvelopeDispatch:
	match decode_lsp_did_save_envelope(envelope):
		ProtocolInputAccepted(save):
			DocumentEnvelopeAccepted(DecodedDocumentSave(save))
		ProtocolInputIgnored(error):
			DocumentEnvelopeIgnored(error)
		ProtocolInputRejected(failure):
			DocumentEnvelopeRejected(failure)


private pure func close_dispatch(envelope: JsonRpcEnvelope) -> DocumentEnvelopeDispatch:
	match decode_lsp_did_close_envelope(envelope):
		ProtocolInputAccepted(uri):
			DocumentEnvelopeAccepted(DecodedDocumentClose(uri))
		ProtocolInputIgnored(error):
			DocumentEnvelopeIgnored(error)
		ProtocolInputRejected(failure):
			DocumentEnvelopeRejected(failure)


pure func dispatch_lsp_document_envelope(envelope: JsonRpcEnvelope) -> DocumentEnvelopeDispatch:
	method = json_rpc_method(envelope)

	if method == DID_OPEN_METHOD:
		open_dispatch(envelope)
	else if method == DID_CHANGE_METHOD:
		change_dispatch(envelope)
	else if method == DID_SAVE_METHOD:
		save_dispatch(envelope)
	else if method == DID_CLOSE_METHOD:
		close_dispatch(envelope)
	else:
		DocumentEnvelopeUnhandled(envelope)
