-- Opaque proof that one immutable workspace source snapshot was fully accounted
-- for by its final semantic products.
--
-- The proof is snapshot-scoped: it says nothing about live filesystem freshness.
-- Construction re-derives targets from the complete compiler-owned SourceStore;
-- callers cannot substitute an arbitrary declared subset or a boolean flag.
import:
	../../compiler/stage_04_modules/loaded_module:
		ModuleIdentity,
		module_identities_equal,
		module_identity_from_resolved,
		module_identity_storage_key,
	../analysis/analysis_model:
		IndexCoverage(CompleteIndexCoverage, PartialIndexCoverageState),
		MissingIndexModule,
		ModuleSemanticIndex,
		ModuleSemanticIndexCoverage(CompleteModuleSemanticIndex, PartialModuleSemanticIndex),
		SemanticIndexSnapshot,
		module_semantic_index_coverage,
		module_semantic_index_module_identity,
		module_semantic_index_uri,
	../analysis/architecture: CompilationWorkspaceSnapshot
	../analysis/workspace_semantic_targets:
		DeclaredWorkspaceSemanticTarget,
		DeclaredWorkspaceSemanticTargetSet,
		DeclaredWorkspaceSemanticTargetSetError,
		declared_workspace_semantic_target_sets_equal,
		declared_workspace_semantic_targets,
		declared_workspace_semantic_targets_for_sources,
	../protocol/identity: DocumentUri
	./snapshot_model: WorkspaceRevision, workspace_revision_value


union WorkspaceSnapshotSemanticCompletenessError:
	WorkspaceCompletenessDeclaredTargetsInvalid(DeclaredWorkspaceSemanticTargetSetError)
	WorkspaceCompletenessRevisionMismatch(WorkspaceRevision, WorkspaceRevision)
	WorkspaceCompletenessPlannedTargetsMismatch
	WorkspaceCompletenessCoverageEncodingInvalid
	WorkspaceCompletenessUnknownIndexedTarget(DocumentUri)
	WorkspaceCompletenessUnknownMissingTarget(DocumentUri)
	WorkspaceCompletenessDuplicateIndexedTarget(DocumentUri)
	WorkspaceCompletenessDuplicateMissingTarget(DocumentUri)
	WorkspaceCompletenessIndexedUriMismatch(DocumentUri, DocumentUri)
	WorkspaceCompletenessMissingUriMismatch(DocumentUri, DocumentUri)
	WorkspaceCompletenessTargetOutcomeInvalid(DocumentUri)


private record WorkspaceSnapshotSemanticCompletenessRep {
	index: SemanticIndexSnapshot
}


opaque type WorkspaceSnapshotSemanticCompleteness = WorkspaceSnapshotSemanticCompletenessRep


private pure func missing_modules(index: SemanticIndexSnapshot) -> List[MissingIndexModule]:
	match index.coverage:
		CompleteIndexCoverage:
			[]
		PartialIndexCoverageState(partial):
			partial.missing_modules


private record WorkspaceOutcomeTables {
	indexes: Dict[String, ModuleSemanticIndex],
	missing: Dict[String, MissingIndexModule]
}


private pure func workspace_outcome_tables(
	targets: List[DeclaredWorkspaceSemanticTarget],
	modules: List[ModuleSemanticIndex],
	missing: List[MissingIndexModule],
) -> Result[WorkspaceOutcomeTables, WorkspaceSnapshotSemanticCompletenessError]:
	var target_table: Dict[String, DeclaredWorkspaceSemanticTarget] = {}
	var index_table: Dict[String, ModuleSemanticIndex] = {}
	var missing_table: Dict[String, MissingIndexModule] = {}
	var error: Option[WorkspaceSnapshotSemanticCompletenessError] = None

	for target in targets:
		identity = module_identity_from_resolved(target.resolved_module_identity)
		key = module_identity_storage_key(identity)
		target_table = target_table.set(key, target)

	for module in modules:
		if error.is_none():
			identity = module_semantic_index_module_identity(module)
			key = module_identity_storage_key(identity)

			match target_table.get(key):
				None:
					error = Some(
						WorkspaceCompletenessUnknownIndexedTarget(
							module_semantic_index_uri(module),
						),
					)
				Some(target):
					if not module_identities_equal(
						module_identity_from_resolved(target.resolved_module_identity),
						identity,
					):
						error = Some(
							WorkspaceCompletenessUnknownIndexedTarget(
								module_semantic_index_uri(module),
							),
						)
					else if module_semantic_index_uri(module) != target.uri:
						error = Some(
							WorkspaceCompletenessIndexedUriMismatch(
								target.uri,
								module_semantic_index_uri(module),
							),
						)
					else if index_table.contains(key):
						error = Some(WorkspaceCompletenessDuplicateIndexedTarget(target.uri))
					else:
						index_table = index_table.set(key, module)

	for module in missing:
		if error.is_none():
			key = module_identity_storage_key(module.module_identity)

			match target_table.get(key):
				None:
					error = Some(WorkspaceCompletenessUnknownMissingTarget(module.uri))
				Some(target):
					if not module_identities_equal(
						module_identity_from_resolved(target.resolved_module_identity),
						module.module_identity,
					):
						error = Some(WorkspaceCompletenessUnknownMissingTarget(module.uri))
					else if module.uri != target.uri:
						error = Some(
							WorkspaceCompletenessMissingUriMismatch(
								target.uri,
								module.uri,
							),
						)
					else if missing_table.contains(key):
						error = Some(WorkspaceCompletenessDuplicateMissingTarget(target.uri))
					else:
						missing_table = missing_table.set(key, module)

	match error:
		Some(found):
			Err(found)
		None:
			Ok({
				indexes = index_table,
				missing = missing_table,
			})


private pure func target_outcome_error(
	target: DeclaredWorkspaceSemanticTarget,
	tables: WorkspaceOutcomeTables,
) -> Option[WorkspaceSnapshotSemanticCompletenessError]:
	identity = module_identity_from_resolved(target.resolved_module_identity)
	key = module_identity_storage_key(identity)
	indexed = tables.indexes.get(key)
	missing = tables.missing.get(key)

	valid = match (indexed, missing):
		(Some(index), None):
			module_semantic_index_coverage(index) == CompleteModuleSemanticIndex
		(Some(index), Some(_)):
			module_semantic_index_coverage(index) == PartialModuleSemanticIndex
		(None, Some(_)):
			True
		(None, None):
			False

	if valid:
		None
	else:
		Some(WorkspaceCompletenessTargetOutcomeInvalid(target.uri))


-- The workspace calls this only after normal completion validation has produced
-- the final cache/index/coverage state. The constructor independently re-derives
-- the complete declared set from that same immutable compiler snapshot.
pure func workspace_snapshot_semantic_completeness(
	compiler: CompilationWorkspaceSnapshot,
	planned_targets: DeclaredWorkspaceSemanticTargetSet,
	index: SemanticIndexSnapshot,
) -> Result[WorkspaceSnapshotSemanticCompleteness, WorkspaceSnapshotSemanticCompletenessError]:
	authoritative_targets ?= declared_workspace_semantic_targets_for_sources(
		compiler.revision,
		compiler.sources,
	).map_err(
		func(error): WorkspaceCompletenessDeclaredTargetsInvalid(error),
	)

	if workspace_revision_value(
		index.workspace_revision,
	) != workspace_revision_value(compiler.revision):
		Err(WorkspaceCompletenessRevisionMismatch(compiler.revision, index.workspace_revision))
	else if not declared_workspace_semantic_target_sets_equal(
		planned_targets,
		authoritative_targets,
	):
		Err(WorkspaceCompletenessPlannedTargetsMismatch)
	else:
		missing = missing_modules(index)

		coverage_valid = match index.coverage:
			CompleteIndexCoverage:
				missing.is_empty()
			PartialIndexCoverageState(_):
				not missing.is_empty()

		if not coverage_valid:
			Err(WorkspaceCompletenessCoverageEncodingInvalid)
		else:
			targets = declared_workspace_semantic_targets(authoritative_targets)
			tables ?= workspace_outcome_tables(targets, index.modules, missing)
			var outcome_error: Option[WorkspaceSnapshotSemanticCompletenessError] = None

			for target in targets:
				if outcome_error.is_none():
					outcome_error = target_outcome_error(target, tables)

			match outcome_error:
				Some(error):
					Err(error)
				None:
					representation: WorkspaceSnapshotSemanticCompletenessRep = {index = index}
					Ok(into WorkspaceSnapshotSemanticCompleteness(representation))


-- The retained index is accessible only by presenting the opaque proof.
pure func workspace_snapshot_complete_semantic_index(
	proof: WorkspaceSnapshotSemanticCompleteness,
) -> SemanticIndexSnapshot:
	representation: WorkspaceSnapshotSemanticCompletenessRep = from WorkspaceSnapshotSemanticCompleteness(
		proof
	)
	representation.index
