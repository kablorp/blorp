-- Dependency-light document synchronization values shared by protocol codecs,
-- the overlay store, and the compiler-facing architecture.
import:
	../protocol/identity: DocumentUri


-- Document versions are protocol integers, but remain distinct from workspace
-- revisions and configuration epochs throughout the compiler pipeline.
opaque type DocumentVersion = Int

private DOCUMENT_VERSION_MIN: Int = -2147483648

private DOCUMENT_VERSION_MAX: Int = 2147483647


pure func document_version(value: Int) -> Option[DocumentVersion]:
	if value < DOCUMENT_VERSION_MIN or value > DOCUMENT_VERSION_MAX:
		None
	else:
		Some(into_opaque DocumentVersion(value))


pure func document_version_value(version: DocumentVersion) -> Int:
	from_opaque DocumentVersion(version)


record VersionedDocumentText {
	uri: DocumentUri,
	version: DocumentVersion,
	text: String
}


-- An empty contentChanges array still advances the protocol version but has no
-- replacement text. Keeping that distinct from_opaque Some("") prevents a no-op from
-- accidentally clearing the editor overlay.
record DocumentChange {
	uri: DocumentUri,
	version: DocumentVersion,
	replacement_text: Option[String]
}


-- Save notifications do not carry a document version, so included text remains
-- event metadata and must not replace the authoritative versioned overlay.
record DocumentSave {
	uri: DocumentUri,
	text: Option[String]
}


-- language_id belongs to the open lifecycle rather than every text revision.
-- A client changes it by closing and reopening the document.
record OpenedDocument {
	document: VersionedDocumentText,
	language_id: String
}


union DocumentEvent:
	DocumentOpened(OpenedDocument)
	DocumentChanged(DocumentChange)
	DocumentSaved(DocumentSave)
	DocumentClosed(DocumentUri)
