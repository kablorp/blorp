-- Identity facts that must still be current before an analysis result is used.
--
-- These wrappers prevent document versions, workspace revisions, and
-- configuration epochs from being interchanged merely because each is stored as
-- an Int. Revisions and epochs are non-negative monotonic counters owned by the
-- future workspace reducer.
import:
	../protocol/identity: DocumentUri
	document_model: DocumentVersion, document_version_value


opaque type WorkspaceRevision = Int

opaque type ConfigurationEpoch = Int

INITIAL_WORKSPACE_REVISION: WorkspaceRevision = into_opaque WorkspaceRevision(0)


pure func next_workspace_revision(revision: WorkspaceRevision) -> WorkspaceRevision:
	into_opaque WorkspaceRevision(from_opaque WorkspaceRevision(revision) + 1)


pure func workspace_revision(value: Int) -> Option[WorkspaceRevision]:
	if value < 0:
		None
	else:
		Some(into_opaque WorkspaceRevision(value))


pure func workspace_revision_value(revision: WorkspaceRevision) -> Int:
	from_opaque WorkspaceRevision(revision)


implements Equatable for WorkspaceRevision:
	pure func equals(left: WorkspaceRevision, right: WorkspaceRevision) -> Bool:
		workspace_revision_value(left) == workspace_revision_value(right)


pure func configuration_epoch(value: Int) -> Option[ConfigurationEpoch]:
	if value < 0:
		None
	else:
		Some(into_opaque ConfigurationEpoch(value))


INITIAL_CONFIGURATION_EPOCH: ConfigurationEpoch = into_opaque ConfigurationEpoch(0)


pure func next_configuration_epoch(epoch: ConfigurationEpoch) -> ConfigurationEpoch:
	into_opaque ConfigurationEpoch(from_opaque ConfigurationEpoch(epoch) + 1)


pure func configuration_epoch_value(epoch: ConfigurationEpoch) -> Int:
	from_opaque ConfigurationEpoch(epoch)


implements Equatable for ConfigurationEpoch:
	pure func equals(left: ConfigurationEpoch, right: ConfigurationEpoch) -> Bool:
		configuration_epoch_value(left) == configuration_epoch_value(right)


record SnapshotIdentity {
	uri: DocumentUri,
	document_version: Option[DocumentVersion],
	workspace_revision: WorkspaceRevision,
	configuration_epoch: ConfigurationEpoch
}


private pure func document_versions_equal(
	left: Option[DocumentVersion],
	right: Option[DocumentVersion],
) -> Bool:
	match (left, right):
		(None, None):
			True
		(Some(left_version), Some(right_version)):
			document_version_value(left_version) == document_version_value(right_version)
		_:
			False


pure func snapshot_identities_equal(left: SnapshotIdentity, right: SnapshotIdentity) -> Bool:
	(
		left.uri == right.uri
		and document_versions_equal(left.document_version, right.document_version)
		and left.workspace_revision == right.workspace_revision
		and left.configuration_epoch == right.configuration_epoch
	)


implements Equatable for SnapshotIdentity:
	pure func equals(left: SnapshotIdentity, right: SnapshotIdentity) -> Bool:
		snapshot_identities_equal(left, right)


pure func snapshot_identity(
	uri: DocumentUri,
	document_version: Option[DocumentVersion],
	workspace_revision: WorkspaceRevision,
	configuration_epoch: ConfigurationEpoch,
) -> SnapshotIdentity:
	{
		uri = uri,
		document_version = document_version,
		workspace_revision = workspace_revision,
		configuration_epoch = configuration_epoch
	}
