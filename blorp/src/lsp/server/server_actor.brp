-- Pure ownership boundary for workspace transitions and compiler scheduling.
-- The reducer returns effects as data; filesystem, compiler, transport, and
-- process effects are interpreted by the native server loops in later slices.
import:
	../analysis/analysis_planner: plan_analysis, plan_interactive_analysis
	../analysis/architecture:
		AnalysisCommit(AnalysisCommitted, CurrentAnalysisFailed, StaleAnalysisDropped),
		AnalysisCompletion,
		AnalysisPlan,
		AnalysisPlanningRequirement(AnalysisPlanRequired, NoAnalysisPlanRequired),
		AnalysisPurpose(InteractiveDocumentAnalysis, WorkspaceIndexAnalysis),
		AnalysisRequest,
		CancellationToken,
		ScheduledAnalysis,
		WorkspaceError(
			OutOfOrderDocumentVersion,
			WorkspaceDocumentAlreadyOpen,
			WorkspaceDocumentNotOpen,
		),
		WorkspaceTransition,
		cancellation_token,
		cancellation_token_value,
	../analysis/diagnostic_model: DiagnosticPublication
	../capabilities/definition: encode_lsp_definition_response
	../capabilities/definition_query: definition_query_snapshot
	../capabilities/document_highlight: encode_lsp_document_highlight_response
	../capabilities/document_highlight_query: document_highlights_query_snapshot
	../capabilities/document_symbol: encode_lsp_document_symbol_response
	../capabilities/document_symbol_query: document_symbols_query_snapshot
	../capabilities/hover: encode_lsp_hover_response
	../capabilities/hover_query: hover_query_snapshot
	../capabilities/query_dispatch:
		SemanticQueryDispatch(
			SemanticQueryAccepted,
			SemanticQueryIgnored,
			SemanticQueryRejected,
			SemanticQueryUnhandled,
		),
