			DefinitionSemanticQuery,
			DocumentSymbolSemanticQuery,
			DocumentHighlightSemanticQuery,
			HoverSemanticQuery,
			ReferencesSemanticQuery,
		),
		dispatch_lsp_semantic_query,
	../capabilities/references: encode_lsp_references_response
	../capabilities/references_query: references_query_snapshot
	../protocol/exit_notification: EXIT_METHOD
	../protocol/identity: DocumentUri, document_uri_value
	../protocol/initialize: INITIALIZE_METHOD, encode_lsp_initialize_success
	../protocol/initialize_model: InitializeSession
	../protocol/json_rpc:
		JsonRpcEnvelope,
		json_rpc_error_value,
		json_rpc_method,
		json_rpc_request_id,
	../protocol/lifecycle_dispatch:
		LifecycleAction(
			LifecycleContinue,
			LifecycleExit,
			LifecycleInitializeRequested,
