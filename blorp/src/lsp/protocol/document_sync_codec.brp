-- Shared field validation for document synchronization method codecs.
--
-- The method name remains an argument so diagnostics identify the protocol
-- operation that owns the malformed parameters.
import:
	../workspace/document_model: DocumentVersion, document_version
	json: JsonValue(JsonObject), as_string, get_field
	json_rpc: integer_from_json
	protocol: ProtocolError(InvalidMethodParameters)


pure func document_parameter_error(method: String, detail: String) -> ProtocolError:
	InvalidMethodParameters(method, detail)


pure func required_object_field(
	value: JsonValue,
	name: String,
	method: String,
) -> Result[JsonValue, ProtocolError]:
	match get_field(value, name):
		Some(JsonObject(fields)):
			Ok(JsonObject(fields))
		Some(_):
			Err(document_parameter_error(method, "`${name}` must be an object"))
		None:
			Err(document_parameter_error(method, "missing required `${name}` object"))


pure func required_string_field(
	value: JsonValue,
	name: String,
	method: String,
) -> Result[String, ProtocolError]:
	match get_field(value, name):
		Some(field):
			match as_string(field):
				Some(text):
					Ok(text)
				None:
					Err(document_parameter_error(method, "`${name}` must be a string"))
		None:
			Err(document_parameter_error(method, "missing required `${name}` string"))


pure func required_document_version(
	value: JsonValue,
	method: String,
) -> Result[DocumentVersion, ProtocolError]:
	match get_field(value, "version"):
		Some(version_value):
			match integer_from_json(version_value):
				Some(version):
					match document_version(version):
						Some(document_version):
							Ok(document_version)
						None:
							Err(
								document_parameter_error(
									method,
									"`version` must be a signed 32-bit integer",
								),
							)
				None:
					Err(
						document_parameter_error(
							method,
							"`version` must be a signed 32-bit integer",
						),
					)
		None:
			Err(document_parameter_error(method, "missing required `version` integer"))
