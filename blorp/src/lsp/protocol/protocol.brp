-- Dependency-light protocol model shared by JSON-RPC, routing, and LSP methods.
--
-- Keeping these primitives outside the compiler-facing architecture prevents a
-- low-level wire decoder from importing lexer, parser, and typechecker models.
-- JSON-RPC permits integer and string request IDs. Keeping the alternatives in
-- the type prevents lossy string conversion and guarantees an exact echo.
union RequestId:
	IntegerRequestId(Int)
	StringRequestId(String)


implements Equatable for RequestId:
	pure func equals(left: RequestId, right: RequestId) -> Bool:
		match (left, right):
			(IntegerRequestId(left_value), IntegerRequestId(right_value)):
				left_value == right_value
			(StringRequestId(left_value), StringRequestId(right_value)):
				left_value == right_value
			_:
				False

	pure func not_equals(left: RequestId, right: RequestId) -> Bool:
		not equals(left, right)


union ProtocolError:
	MalformedJson(String)
	InvalidProtocolEnvelope(String)
	UnsupportedProtocolVersion(String)
	UnknownMethod(String)
	MissingProtocolField(String)
	MissingRequestId(String)
	UnexpectedRequestId(String)
	InvalidLifecycle(String)
	ServerNotInitialized(String)
	InternalError(String)
	InvalidRequestId
	InvalidMethodParameters(String, String)


implements Equatable for ProtocolError:
	pure func equals(left: ProtocolError, right: ProtocolError) -> Bool:
		match (left, right):
			(MalformedJson(left_value), MalformedJson(right_value)):
				left_value == right_value
			(InvalidProtocolEnvelope(left_value), InvalidProtocolEnvelope(right_value)):
				left_value == right_value
			(UnsupportedProtocolVersion(left_value), UnsupportedProtocolVersion(right_value)):
				left_value == right_value
			(UnknownMethod(left_value), UnknownMethod(right_value)):
				left_value == right_value
			(MissingProtocolField(left_value), MissingProtocolField(right_value)):
				left_value == right_value
			(MissingRequestId(left_value), MissingRequestId(right_value)):
				left_value == right_value
			(UnexpectedRequestId(left_value), UnexpectedRequestId(right_value)):
				left_value == right_value
			(InvalidLifecycle(left_value), InvalidLifecycle(right_value)):
				left_value == right_value
			(ServerNotInitialized(left_value), ServerNotInitialized(right_value)):
				left_value == right_value
			(InternalError(left_value), InternalError(right_value)):
				left_value == right_value
			(InvalidRequestId, InvalidRequestId):
				True
			(InvalidMethodParameters(left_0, left_1), InvalidMethodParameters(right_0, right_1)):
				left_0 == right_0 and left_1 == right_1
			_:
				False

	pure func not_equals(left: ProtocolError, right: ProtocolError) -> Bool:
		not equals(left, right)


-- A protocol failure retains a valid request ID when one was decoded before a
-- later envelope or method validation failed. That is necessary to emit the
-- matching JSON-RPC error without reparsing the request body.
record ProtocolFailure {
	request_id: Option[RequestId],
	error: ProtocolError
}


-- Notifications and requests have different response obligations. Encoding
-- that distinction here prevents callers from replying to notifications or
-- dropping required JSON-RPC error responses.
union ProtocolInputOutcome[T]:
	ProtocolInputAccepted(T)
	ProtocolInputRejected(ProtocolFailure)
	ProtocolInputIgnored(ProtocolError)


-- The error payload owns its request-ID invariant: protocol failures may lack a
-- decoded ID, while semantic request failures use a type with a required ID.
union ProtocolResponse[T, E]:
	ProtocolSuccessResponse(RequestId, T)
	ProtocolErrorResponse(E)
