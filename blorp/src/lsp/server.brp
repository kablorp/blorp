---
The language server's state and its one step per message: the lifecycle, the
open documents, each root's last analysis and what it published, which roots a
change stales, and the replies each message earns: tokens, definitions and
references among them. Pure: the transport reads, analyses and writes.
---
import:
    bool: and, not, or
    bytes: Bytes
    json: Json(Null, Boolean, Number, Text, Array, Object), as_int, integer, parse
    path: Path, to_path
    ../common/analysis/check/check: Analysis, analyze, declaration_span, declarations, name_uses
    ../common/analysis/check/name_uses: NameUse, Referent
    ../common/analysis/check/render: render_failure
    ../common/analysis/load/load:
        LibraryLayout,
        LoadedProgram,
        SourceLoadFailure(
            DuplicateSourcePath,
            SourcePathContainsNul,
            SourcePathEmpty,
            LoadingFailed
        ),
        embedded_library_text,
        library_relative_path
    ../common/syntax/source:
        ModuleKind(
            UserModule,
            LibraryModule,
            ConcurrencyModule,
            FoundationTypesModule,
            FoundationPreludeModule,
            FoundationMethodsModule
        ),
        ModuleSource,
        SourceFile,
        SourceInputs,
        module_number,
        module_source,
        root_module_id,
        source_module
    ../common/syntax/syntax: Diagnostic, Diagnostics, Span, compiler_span, internal_error
    ./completion:
        Completion,
        CompletionPlan(Answered, Probing),
        Offered,
        ProbeOutcome,
        ProbedSite,
        completion_plan,
        offered_json,
        probed_completion
    ./line_map: LineMap, current_span, line_map, sealed_offset
    ./positions:
        LineIndex,
        Position,
        PositionEncoding(Utf8, Utf16),
        encoding_name,
        line_index,
        offset_of,
        position_of
    ./protocol:
        Call,
        ClientMessage(Request, Notification, ClientResponse, InvalidMessage),
        ErrorCode(ParseError, InvalidRequest, MethodNotFound, InvalidParams, ServerNotInitialized),
        LIBRARY_SCHEME_NAME,
        RequestId(NumberId),
        client_message,
        error_response,
        field,
        file_uri,
        library_uri,
        library_uri_file,
        notification,
        request,
        response,
        text_field,
        uri_path
    ./tokens: TokenClass, analysed_identifiers, semantic_tokens, token_legend


-- How far loading and analysing one root got.
union AnalysisOutcome:
    -- Loading stopped at its first error.
    LoadFailed(Diagnostic)
    -- The program loaded, and checking rejected it.
    CheckFailed(Diagnostics)
    -- The program loaded and checked.
    Analysed(Analysis)


-- What the transport hands back after it loads and analyses one root: the
-- files the load read, whose texts the diagnostics' spans index, and how far
-- it got.
record DocumentAnalysis {
    sources: SourceInputs,
    outcome: AnalysisOutcome
}


-- The server's paths are normalized and absolute, and so unique and free of
-- NUL, so only a defect in the server makes the loader refuse them.
pure func document_analysis(loaded: Result[LoadedProgram, SourceLoadFailure]) -> DocumentAnalysis:
    match loaded:
        Ok(program):
            outcome: AnalysisOutcome = match analyze(program.program):
                Ok(analysis): Analysed(analysis)
                Err(failure): CheckFailed(render_failure(failure))

            { sources = program.sources, outcome = outcome }
        Err(LoadingFailed(failure)):
            { sources = failure.sources, outcome = LoadFailed(failure.diagnostic) }
        Err(DuplicateSourcePath(_) | SourcePathContainsNul(_) | SourcePathEmpty):
            {
                sources = { modules = [] },
                outcome = LoadFailed(
                    internal_error(
                        compiler_span(),
                        "the language server gave the loader an unusable path"
                    )
                )
            }


-- A root's last analysis that succeeded, with the texts it read. Later
-- analyses of the root may fail while its files are served from it.
private record SealedAnalysis {
    analysis: Analysis,
    sources: SourceInputs,
    -- The files a change has been reported to since, without a later analysis
    -- having read them: their current text is unknown unless a document is open.
    -- The one place that records it.
    changed_since: List[Path]
}


-- A root's latest analysis, still holding: no file it read has changed since.
private union LatestAnalysis:
    -- It checked, and requests are answered from it.
    Checked(SealedAnalysis)
    -- It failed. Requests are served from the last analysis that checked, if
    -- there was one, and otherwise get the lexer's tokens alone.
    Failed(DocumentAnalysis, Option[SealedAnalysis])


-- Whether a root's latest analysis still holds.
private union RootAnalysis:
    Current(LatestAnalysis)
    -- A file it read has changed, or its load failed and some file has. The
    -- root's next request analyses it again. The last analysis that checked,
    -- if any, is kept.
    Stale(Option[SealedAnalysis])


-- A root's latest analysis, and what it published: the diagnostics of each
-- user file it reports in, so that when it stops reporting in a file another
-- root's can be shown there again.
private record AnalysedRoot {
    analysis: RootAnalysis,
    published: Dict[Path, List[Json]]
}


-- An open document: the URI the client named it by, which every publication to
-- it repeats so that the editor matches it, and its text.
private record OpenDocument {
    uri: String,
    text: String
}


private record Session {
    encoding: PositionEncoding,
    -- The embedded library's layout, which gives a library file's path below
    -- its root. Every analysis reads the embedded library, as `blorp compile`
    -- does.
    library: LibraryLayout,
    -- Each open document, by its normalized absolute path. An open document is
    -- the root of its own program (the v1 limitation), and every analysis
    -- reads these texts instead of the disk.
    documents: Dict[Path, OpenDocument],
    -- The text of each open library file the client fetched, by its path below
    -- the library root. They are neither roots nor snapshots: they get the
    -- lexer's tokens, no definition and no references. Edits to them, saved or
    -- not, are never read.
    library_documents: Dict[String, String],
    -- Each root's last analysis, current or stale, and what it published, in
    -- the order the roots were last analysed, so that a file several roots
    -- report in shows the latest analysis's diagnostics. Requests are answered
    -- from a current analysis. A root not yet analysed has no row.
    roots: Dict[Path, AnalysedRoot],
    -- Whether the server is still to register for changed files: the client
    -- can report them, and `initialized`, after which the server may ask, has
    -- not come yet.
    registers_watchers: Bool,
    -- Whether the client accepts `workspace/semanticTokens/refresh`, which asks
    -- it for the tokens of its visible files again.
    refreshes_tokens: Bool,
    -- Whether the client reads a completion's snippets.
    inserts_snippets: Bool,
    -- Whether the client fetches library files with
    -- `workspace/textDocumentContent`, so that a definition may lead into the
    -- library.
    serves_library_documents: Bool,
    -- How many requests the server has sent; each takes the next number as
    -- its id.
    requests_sent: Int
}


private union Lifecycle:
    -- Requests other than `initialize` get -32002, and notifications other
    -- than `exit` are dropped. The session starts with the library it serves.
    AwaitingInitialize(LibraryLayout)
    Serving(Session)
    -- After `shutdown`, requests get -32600 and `exit` ends with status 0.
    ShutDown
    -- `exit` has arrived; the process ends with this status.
    Exited(Int)


union Server:
    private Init(Lifecycle)


-- What a request asks of an open document, answered from its root's analysis.
union DocumentQuery:
    TokensQuery
    -- Where the name at the position is declared.
    DefinitionQuery(Position)
    -- Every use of the name at the position.
    ReferencesQuery(ReferencesAt)


fixed record ReferencesAt {
    position: Position,
    -- The client's `context.includeDeclaration`: the declaration is listed too.
    includes_declaration: Bool
}


-- A request that waits for its document's analysis.
record WaitingRequest {
    id: RequestId,
    query: DocumentQuery
}


-- An analysis for the transport to run and hand back to `analysed`: the root
-- to load and analyse, and the request that waits for it, if any. `didOpen`
-- asks for its own document and answers nothing.
record AnalysisRequest {
    root: Path,
    answering: Option[WaitingRequest]
}


-- What a step leaves the transport to do once its replies are written. The
-- server is pure, so the transport reads the disk for it and hands back what
-- it read.
union Followup:
    -- Nothing: the transport reads the next message.
    Idle
    -- Load and analyse a root, and hand the result to `analysed`.
    Analyse(AnalysisRequest)
    -- Read the saved text of the document at the path, which the client has
    -- closed, and hand it to `reverted`.
    ReadSaved(Path)
    -- Load an open root with a completion probe's hole in its text, every open
    -- document as it is, check it to the hole, and hand what it found to
    -- `probed`.
    Probe(ProbeRequest)


-- A completion request that waits for a probe of its root: the root, the
-- request and the site the probe answers.
record ProbeRequest {
    root: Path,
    id: RequestId,
    site: ProbedSite
}


record Step {
    server: Server,
    replies: List[Json],
    followup: Followup
}


-- The status the process ends with unless `exit` follows `shutdown`: an exit
-- without shutdown (the protocol's rule) or input that ends without exit.
EXIT_ABANDONED: Int = 1

private EXIT_AFTER_SHUTDOWN: Int = 0

-- TextDocumentSyncKind.Full: every change sends the whole text.
private FULL_SYNC: Int = 1


-- The character after which an editor asks for completion unprompted: the
-- dot before a member.
private MEMBER_TRIGGER: String = "."

-- DiagnosticSeverity.Error: every diagnostic stops compilation.
private ERROR_SEVERITY: Int = 1


pure func start_server(library: LibraryLayout) -> Server:
    Server.Init(AwaitingInitialize(library))


-- Some once `exit` has arrived.
pure func exit_status(server: Server) -> Option[Int]:
    lifecycle = match server:
        Server.Init(lifecycle): lifecycle

    match lifecycle:
        Exited(status): Some(status)
        AwaitingInitialize(_) | Serving(_) | ShutDown: None


-- The open documents, which an analysis reads instead of the disk.
pure func snapshots(server: Server) -> List[SourceFile]:
    lifecycle = match server:
        Server.Init(lifecycle): lifecycle

    match lifecycle:
        Serving(session):
            session.documents
                .entries()
                .map(
                    pure func(document: (Path, OpenDocument)) -> SourceFile: {
                        path = document[0].to_string(),
                        contents = document[1].text
                    }
                )
        AwaitingInitialize(_) | ShutDown | Exited(_):
            []


private pure func replying(lifecycle: Lifecycle, replies: List[Json]) -> Step:
    { server = Server.Init(lifecycle), replies = replies, followup = Idle }


-- A body that is not UTF-8 JSON gets -32700 with a null id in any state:
-- nothing in it says what was asked.
pure func receive_body(server: Server, body: Bytes) -> Step:
    match server:
        Server.Init(lifecycle):
            match body.to_text():
                None:
                    lifecycle.replying([
                        error_response(None, ParseError, "the message body is not UTF-8")
                    ])
                Some(text):
                    match parse(text):
                        Ok(message):
                            server.receive(message)
                        Err(error):
                            lifecycle.replying([
                                error_response(
                                    None,
                                    ParseError,
                                    "the message body is not JSON: ${error}"
                                )
                            ])


pure func receive(server: Server, message: Json) -> Step:
    match server:
        Server.Init(lifecycle):
            match (lifecycle, client_message(message)):
                (Exited(_), _) | (_, ClientResponse):
                    lifecycle.replying([])
                (_, InvalidMessage(id)):
                    lifecycle.replying([
                        error_response(
                            id,
                            InvalidRequest,
                            "the message is not a JSON-RPC request or notification"
                        )
                    ])
                (AwaitingInitialize(library), Request(id, call)):
                    if call.method == "initialize":
                        encoding = call.params.agreed_encoding()

                        session: Session = {
                            encoding = encoding,
                            library = library,
                            documents = {},
                            library_documents = {},
                            roots = {},
                            registers_watchers = call.params.watches_files(),
                            refreshes_tokens = call.params.refreshes_tokens(),
                            serves_library_documents = call.params.fetches_documents(),
                            inserts_snippets = call.params.reads_snippets(),
                            requests_sent = 0
                        }

                        replying(Serving(session), [
                            response(
                                id,
                                initialize_result(encoding, session.serves_library_documents)
                            )
                        ])
                    else:
                        lifecycle.replying([
                            error_response(
                                Some(id),
                                ServerNotInitialized,
                                "the server has not been initialized"
                            )
                        ])
                (ShutDown, Request(id, _)):
                    lifecycle.replying([
                        error_response(Some(id), InvalidRequest, "the server has shut down")
                    ])
                (Serving(session), Request(id, call)):
                    match call.method:
                        "shutdown":
                            replying(ShutDown, [response(id, Null)])
                        "workspace/textDocumentContent":
                            lifecycle.replying([content_response(id, call.params)])
                        "textDocument/semanticTokens/full":
                            session.document_requested(id, call.params, Some(TokensQuery))
                        "textDocument/definition":
                            session.document_requested(
                                id,
                                call.params,
                                call.params
                                    .requested_position()
                                    .map(
                                        pure func(at: Position) -> DocumentQuery: DefinitionQuery(
                                            at
                                        )
                                    )
                            )
                        "textDocument/references":
                            includes_declaration: Bool = match (
                                call.params
                                    .field("context")
                                    .field("includeDeclaration")
                            ):
                                Some(Boolean(True)): True
                                _: False

                            session.document_requested(
                                id,
                                call.params,
                                call.params
                                    .requested_position()
                                    .map(
                                        pure func(at: Position) -> DocumentQuery: ReferencesQuery({
                                            position = at,
                                            includes_declaration = includes_declaration
                                        })
                                    )
                            )
                        "textDocument/completion":
                            session.completion_requested(id, call.params)
                        "initialize":
                            lifecycle.replying([
                                error_response(
                                    Some(id),
                                    InvalidRequest,
                                    "the server is already initialized"
                                )
                            ])
                        _:
                            lifecycle.replying([
                                error_response(
                                    Some(id),
                                    MethodNotFound,
                                    "unknown method `${call.method}`"
                                )
                            ])
                (ShutDown, Notification(call)):
                    if call.method == "exit":
                        replying(Exited(EXIT_AFTER_SHUTDOWN), [])
                    else:
                        lifecycle.replying([])
                (AwaitingInitialize(_), Notification(call)):
                    if call.method == "exit":
                        replying(Exited(EXIT_ABANDONED), [])
                    else:
                        lifecycle.replying([])
                (Serving(session), Notification(call)):
                    session.notified(call)


-- UTF-8 when the client offers it, which saves converting; otherwise UTF-16,
-- which every client supports.
private pure func agreed_encoding(params: Option[Json]) -> PositionEncoding:
    match (
        params
            .field("capabilities")
            .field("general")
            .field("positionEncodings")
    ):
        Some(Array(offered)):
            utf8 = Utf8.encoding_name()

            offers_utf8 = offered.any(pure func(offer: Json) -> Bool:
                match offer:
                    Text(name): name == utf8
                    _: False
            )

            if offers_utf8:
                Utf8
            else:
                Utf16
        _:
            Utf16


-- Whether the client can tell the server of changed files that the server
-- registers for after `initialized`.
private pure func watches_files(params: Option[Json]) -> Bool:
    match (
        params
            .field("capabilities")
            .field("workspace")
            .field("didChangeWatchedFiles")
            .field("dynamicRegistration")
    ):
        Some(Boolean(True)): True
        _: False


-- Whether the client can be asked to refresh the tokens it holds.
private pure func refreshes_tokens(params: Option[Json]) -> Bool:
    match (
        params
            .field("capabilities")
            .field("workspace")
            .field("semanticTokens")
            .field("refreshSupport")
    ):
        Some(Boolean(True)): True
        _: False


-- Whether the client reads a completion item's snippet.
private pure func reads_snippets(params: Option[Json]) -> Bool:
    match (
        params
            .field("capabilities")
            .field("textDocument")
            .field("completion")
            .field("completionItem")
            .field("snippetSupport")
    ):
        Some(Boolean(True)): True
        _: False


-- Whether the client can fetch the text of a document by its URI, which is
-- LSP 3.18's `workspace/textDocumentContent`.
private pure func fetches_documents(params: Option[Json]) -> Bool:
    match (
        params
            .field("capabilities")
            .field("workspace")
            .field("textDocumentContent")
    ):
        Some(Object(_)): True
        _: False


-- The answer to `workspace/textDocumentContent`: the embedded text of the
-- library file the URI names, else -32602 saying why not.
private pure func content_response(id: RequestId, params: Option[Json]) -> Json:
    match params.text_field("uri"):
        None:
            error_response(Some(id), InvalidParams, "the request names no uri")
        Some(named):
            match named.library_uri_file():
                Some(relative):
                    match embedded_library_text(relative):
                        Some(text):
                            response(id, Object({ "text" => Text(text) }))
                        None:
                            error_response(
                                Some(id),
                                InvalidParams,
                                "the standard library has no file ${relative}"
                            )
                None:
                    error_response(
                        Some(id),
                        InvalidParams,
                        "${named} is not a ${LIBRARY_SCHEME_NAME}: URI"
                    )


-- What the server serves: the encoding chosen, the whole text on every
-- change, every token of a document at once, definitions and references.
private pure func initialize_result(encoding: PositionEncoding, serves_library: Bool) -> Json:
    base: Dict[String, Json] = {
        "positionEncoding" => Text(encoding.encoding_name()),
        "textDocumentSync" => Object(
            { "openClose" => Boolean(True), "change" => Number(integer(FULL_SYNC)) }
        ),
        "semanticTokensProvider" => Object({ "legend" => token_legend(), "full" => Boolean(True) }),
        "definitionProvider" => Boolean(True),
        "referencesProvider" => Boolean(True),
        "completionProvider" => Object({ "triggerCharacters" => Array([Text(MEMBER_TRIGGER)]) })
    }

    capabilities = if serves_library:
        base.set(
            "workspace",
            Object(
                {
                    "textDocumentContent" => Object(
                        { "schemes" => Array([Text(LIBRARY_SCHEME_NAME)]) }
                    )
                }
            )
        )
    else:
        base

    Object({ "capabilities" => Object(capabilities) })


-- The contents a load read for the file at `path`, if it read the file.
private pure func contents_read(sources: SourceInputs, path: Path) -> Option[String]:
    sources.modules
        .find(pure func(row: ModuleSource) -> Bool: row.is_at(path))
        .map(pure func(row: ModuleSource) -> String: row.contents)


private pure func is_at(row: ModuleSource, path: Path) -> Bool:
    match row.path.to_path():
        Ok(read): read == path
        Err(_): False


-- Whether a load read the file at `path` as a text other than `supplied`, the
-- file's text from now on when the change gives it: with None, whether it read
-- the file at all.
private pure func reads_otherwise(
    sources: SourceInputs,
    path: Path,
    supplied: Option[String]
) -> Bool:
    match (sources.contents_read(path), supplied):
        (Some(read), Some(text)): read != text
        (Some(_), None): True
        (None, _): False


-- Whether a change to `path`, whose text from now on is `supplied` when the
-- change gives it, can change what `result` found: its analysis read other
-- text for the file, or its load failed without reading the file, which may be
-- a module it could not find.
private pure func depends_on(
    result: DocumentAnalysis,
    path: Path,
    supplied: Option[String]
) -> Bool:
    reads_other_text = result.sources.reads_otherwise(path, supplied)

    match result.outcome:
        LoadFailed(_):
            or(
                result.sources
                    .contents_read(path)
                    .is_none(),
                reads_other_text
            )
        CheckFailed(_) | Analysed(_):
            reads_other_text


-- The last analysis that checked, which a root keeps through failures.
private pure func last_checked(analysis: RootAnalysis) -> Option[SealedAnalysis]:
    match analysis:
        Current(Checked(sealed)): Some(sealed)
        Current(Failed(_, sealed)) | Stale(sealed): sealed


-- `sealed`, told that a change to `path` has been reported if it read other
-- text for the file than `supplied`.
private pure func noted(
    sealed: Option[SealedAnalysis],
    path: Path,
    supplied: Option[String]
) -> Option[SealedAnalysis]:
    match sealed:
        Some(last):
            if and(
                last.sources.reads_otherwise(path, supplied),
                not(last.changed_since.contains(path))
            ):
                Some({ last | changed_since = last.changed_since.append(path) })
            else:
                sealed
        None:
            None


-- Every root whose analysis a change to `path` affects, marked stale, and
-- every sealed analysis that read the file told of the change. `supplied` is
-- the file's text from now on when the server compares it, as for an open or
-- a close: an analysis that read that very text is unaffected. With None, every
-- analysis that read the file is affected. A stale root keeps what it published
-- until its next request analyses it again, so a burst of edits costs one
-- analysis.
private pure func staled(
    roots: Dict[Path, AnalysedRoot],
    path: Path,
    supplied: Option[String]
) -> Dict[Path, AnalysedRoot]:
    var marked = roots

    for (root, row) in roots.entries():
        match row.analysis:
            Current(Checked(sealed)):
                if sealed.sources.reads_otherwise(path, supplied):
                    marked = marked.set(
                        root,
                        { row | analysis = Stale(Some(sealed).noted(path, supplied)) }
                    )
            Current(Failed(result, sealed)):
                if result.depends_on(path, supplied):
                    marked = marked.set(
                        root,
                        { row | analysis = Stale(sealed.noted(path, supplied)) }
                    )
                else if sealed.is_some():
                    marked = marked.set(
                        root,
                        { row | analysis = Current(Failed(result, sealed.noted(path, supplied))) }
                    )
            Stale(sealed):
                if sealed.is_some():
                    marked = marked.set(
                        root,
                        { row | analysis = Stale(sealed.noted(path, supplied)) }
                    )

    marked


-- Whether some root is current in `earlier` and stale in `later`: a change
-- has staled a program whose tokens the client holds. A root the change
-- itself edits is not in `earlier`, since the client asks for its tokens
-- anyway.
private pure func went_stale(
    earlier: Dict[Path, AnalysedRoot],
    later: Dict[Path, AnalysedRoot]
) -> Bool:
    later
        .entries()
        .any(pure func(row: (Path, AnalysedRoot)) -> Bool:
            match (
                row[1].analysis,
                earlier
                    .get(row[0])
                    .map(pure func(before: AnalysedRoot) -> RootAnalysis: before.analysis)
            ):
                (Stale(_), Some(Current(_))): True
                _: False
        )


-- Replies to a change that left the roots in `session`, and asks the client to
-- refresh its tokens when `went_stale` from `earlier` and it can, once however
-- many roots went stale. The client answers a request it is sent, and the
-- server ignores the answer.
private pure func replying_with_refresh(
    session: Session,
    earlier: Dict[Path, AnalysedRoot],
    replies: List[Json]
) -> Step:
    if and(session.refreshes_tokens, went_stale(earlier, session.roots)):
        id = session.requests_sent + 1

        replying(
            Serving({ session | requests_sent = id }),
            replies.append(request(NumberId(id), REFRESH_METHOD, None))
        )
    else:
        replying(Serving(session), replies)


-- The `position` a request's params give, or None for one that is missing or
-- not two integers.
private pure func requested_position(params: Option[Json]) -> Option[Position]:
    position = params.field("position")

    match (position.field("line"), position.field("character")):
        (Some(Number(line)), Some(Number(character))):
            match (line.as_int(), character.as_int()):
                (Some(row), Some(column)): Some({ line = row, character = column })
                _: None
        _:
            None


-- The answer to `query` about the open document `path`, whose root's analysis
-- `latest` still holds. While the root fails to analyse, the last analysis that
-- checked answers if there is one, its spans mapped through a line diff to the
-- text the editor shows; otherwise only the lexer's tokens are sent, a
-- definition is `null` and references are `[]`. `null` for a document that is
-- not open.
private pure func answer(
    session: Session,
    path: Path,
    latest: LatestAnalysis,
    query: DocumentQuery
) -> Json:
    match (session.documents.get(path), latest):
        (None, _):
            Null
        (Some(open), Checked(checked)):
            root: FileView = { index = line_index(open.text), map = None }
            session.served(path, open.text, root, checked, None, query)
        (Some(open), Failed(result, Some(last))):
            match last.sources.modules.get(root_module_id().module_number()):
                Some(before):
                    root: FileView = {
                        index = line_index(open.text),
                        map = Some(line_map(before.contents, open.text))
                    }

                    session.served(path, open.text, root, last, Some(result.sources), query)
                None:
                    -- A defect, not an expected case: every analysis that checked
                    -- read the root, which is open. Nothing is guessed.
                    Null
        (Some(open), Failed(_, None)):
            open.text.unanalysed_answer(query, session.encoding)


-- The answer to `query` about the root at `path`, whose text in the editor is
-- `text` and whose view is `root`, from the analysis `sealed`. When it is older
-- than the editor's text, `latest_sources` are the files the root's failed
-- latest analysis read: every offset into the text goes back through the root's
-- line diff, and every span comes forward through its file's.
private pure func served(
    session: Session,
    path: Path,
    text: String,
    root: FileView,
    sealed: SealedAnalysis,
    latest_sources: Option[SourceInputs],
    query: DocumentQuery
) -> Json:
    analysis = sealed.analysis
    sources = sealed.sources

    -- The name at a position in the editor's text: None when its line is not
    -- one the analysis read.
    named_at = pure func(at: Position) -> Option[NameAt]:
        shown = root.index.offset_of(at, session.encoding)

        offset_read: Option[Int] = match root.map:
            Some(map): map.sealed_offset(shown)
            None: Some(shown)

        match offset_read:
            Some(offset): analysis.name_at(offset)
            None: None

    match query:
        TokensQuery:
            identifiers = analysis.analysed_identifiers(sources, root_module_id())
            var shown: Dict[Int, TokenClass] = {}

            for (offset, name) in identifiers.entries():
                match root.map:
                    Some(map):
                        match map.current_offset(offset):
                            Some(moved): shown = shown.set(moved, name)
                            None: void
                    None:
                        shown = shown.set(offset, name)

            text.tokens_json(shown, session.encoding)
        DefinitionQuery(at):
            declared: List[Span] = match named_at(at):
                Some(name):
                    match analysis.declaration_span(name.referent):
                        Some(span): [name.span, span]
                        None: []
                None:
                    []

            -- A declaration has one target, which `targets` leaves out for a
            -- defect, for a span the editor's text has changed, or for a
            -- library file the client cannot fetch.
            match session.targets(sealed, latest_sources, { path => Some(root) }, declared):
                [origin, target]: target.location_json()
                _: Null
        ReferencesQuery(asked):
            match named_at(asked.position):
                Some(name):
                    Array(
                        session
                            .targets(
                                sealed,
                                latest_sources,
                                { path => Some(root) },
                                analysis.references(name.referent, asked.includes_declaration)
                            )
                            .map(location_json)
                    )
                None:
                    Array([])


-- The `textDocument/completion` result for the editor's `text`: a complete
-- list, which the client filters as the word grows.
private pure func completion_json(
    text: String,
    offering: Option[Completion],
    session: Session
) -> Json:
    items: List[Json] = match offering:
        Some(completion):
            range = line_index(text).range_json(completion.prefix, session.encoding)
            snippets = session.inserts_snippets

            completion.items.map(
                pure func(item: Offered) -> Json: item.offered_json(range, snippets)
            )
        None:
            []

    Object({ "isIncomplete" => Boolean(False), "items" => Array(items) })


-- A completion is answered from the root's latest analysis that checked,
-- current or stale, and never analyses the root: the module's names hold
-- everywhere in it, and the editor's own text gives the site. A name or a
-- value's member waits for a probe of that text. A library document gets an
-- empty list, and a document that is not open `null`.
private pure func completion_requested(
    session: Session,
    id: RequestId,
    params: Option[Json]
) -> Step:
    match (params.requested_document(), params.requested_position()):
        (Some(UserFile(path)), Some(at)):
            match session.documents.get(path):
                Some(open):
                    offset = line_index(open.text).offset_of(at, session.encoding)

                    match open.text.completion_plan(offset, session.checked_analysis(path)):
                        Answered(offering):
                            replying(Serving(session), [
                                response(id, open.text.completion_json(offering, session))
                            ])
                        Probing(site):
                            {
                                server = Server.Init(Serving(session)),
                                replies = [],
                                followup = Probe({ root = path, id = id, site = site })
                            }
                None:
                    replying(Serving(session), [response(id, Null)])
        (Some(LibraryFile(relative)), Some(_)):
            answered: Json = if session.library_documents.contains(relative):
                "".completion_json(None, session)
            else:
                Null

            replying(Serving(session), [response(id, answered)])
        _:
            replying(Serving(session), [response(id, Null)])


-- The root's latest analysis that checked, current or stale, if any.
private pure func checked_analysis(session: Session, root: Path) -> Option[Analysis]:
    match session.roots.get(root):
        Some(row):
            row.analysis
                .last_checked()
                .map(pure func(sealed: SealedAnalysis) -> Analysis: sealed.analysis)
        None:
            None


-- Answers the request that waited for a probe, from what the probe found,
-- and changes nothing else: the probe's text is not the document's, so the
-- root keeps its analysis, its staleness and its diagnostics.
pure func probed(server: Server, asked: ProbeRequest, outcome: ProbeOutcome) -> Step:
    lifecycle = match server:
        Server.Init(lifecycle): lifecycle

    match lifecycle:
        Serving(session):
            answered: Json = match session.documents.get(asked.root):
                Some(open):
                    completion = asked.site.probed_completion(
                        outcome,
                        session.checked_analysis(asked.root)
                    )

                    open.text.completion_json(Some(completion), session)
                None:
                    Null

            replying(lifecycle, [response(asked.id, answered)])
        AwaitingInitialize(_) | ShutDown | Exited(_):
            lifecycle.replying([])


-- The answer to `query` about a text with no analysis: the lexer's tokens, no
-- definition and no references.
private pure func unanalysed_answer(
    text: String,
    query: DocumentQuery,
    encoding: PositionEncoding
) -> Json:
    match query:
        TokensQuery: text.tokens_json({}, encoding)
        DefinitionQuery(_): Null
        ReferencesQuery(_): Array([])


-- The `semanticTokens/full` result for a document's text.
private pure func tokens_json(
    text: String,
    identifiers: Dict[Int, TokenClass],
    encoding: PositionEncoding
) -> Json:
    data = text.semantic_tokens(root_module_id(), identifiers, encoding)
    Object({ "data" => Array(data.map(pure func(value: Int) -> Json: Number(integer(value)))) })


-- A name written in the root: what it refers to, and where it is written.
private record NameAt {
    referent: Referent,
    span: Span
}


-- The name at `offset` of the root: the declaration written there, or else the
-- use. A position at a name's end counts as inside it.
private pure func name_at(analysis: Analysis, offset: Int) -> Option[NameAt]:
    root = module_source(root_module_id())

    covers = pure func(span: Span) -> Bool: and(
        span.source == root,
        and(span.start <= offset, offset <= span.end)
    )

    var declared: Option[NameAt] = None

    for referent in analysis.declarations():
        match analysis.declaration_span(referent):
            Some(span):
                if covers(span):
                    declared = Some({ referent = referent, span = span })
                    break
            None:
                void

    match declared:
        Some(_):
            declared
        None:
            analysis
                .name_uses()
                .find(pure func(use: NameUse) -> Bool: covers(use.span))
                .map(
                    pure func(use: NameUse) -> NameAt: { referent = use.referent, span = use.span }
                )


-- The spans of every use of `referent`: the uses of every referent declared
-- at the same span, so that an implementation method's type parameter, which
-- has an id per method, groups with its header's. Spans compare within this
-- one analysis; across analyses, whose ids differ, a comparison must use the
-- declaration's path and byte range instead. The declaration leads when it
-- is asked for. A referent declared nowhere is a defect, and has none.
private pure func references(
    analysis: Analysis,
    referent: Referent,
    includes_declaration: Bool
) -> List[Span]:
    match analysis.declaration_span(referent):
        None:
            []
        Some(declared):
            uses = analysis
                .name_uses()
                .filter(
                    pure func(use: NameUse) -> Bool: (
                        analysis.declaration_span(use.referent)
                        == Some(declared)
                    )
                )
                .map(pure func(use: NameUse) -> Span: use.span)

            if includes_declaration:
                [declared].concat(uses)
            else:
                uses


-- The row of the file `span` indexes, with the path an editor opens it by: a
-- user file's own, or a library file's path below the library's root. None for
-- a span in no file the load read, such as one about blorp itself. The loader builds each row's path normalized, so it
-- is always a Path.
private pure func span_file(
    sources: SourceInputs,
    library: LibraryLayout,
    span: Span
) -> Option[(Path, ModuleSource)]:
    row: Option[ModuleSource] = match span.source.source_module():
        Some(module): sources.modules.get(module.module_number())
        None: None

    match row:
        Some(file):
            match (file.role, file.path.to_path()):
                (UserModule, Ok(path)):
                    Some((path, file))
                (LibraryModule | ConcurrencyModule | FoundationTypesModule | FoundationPreludeModule | FoundationMethodsModule, Ok(path)):
                    match library.library_relative_path(path):
                        Some(relative): Some((relative, file))
                        None: None
                (_, Err(_)):
                    None
        None:
            None


-- Where a span is, in the terms of a protocol Location: the client's URI for an
-- open document and the server's encoding of its path otherwise, and the
-- range.
private record Target {
    uri: String,
    range: Json
}


private pure func location_json(target: Target) -> Json:
    Object({ "uri" => Text(target.uri), "range" => target.range })


-- A file as the editor shows it: its lines, and how the analysed text's spans
-- move into them, none when the analysis read the text shown.
private record FileView {
    index: LineIndex,
    map: Option[LineMap]
}


-- The view of the file `file`, which `sealed` read at `path`, or None when the
-- text the editor shows is unknown: an open document's, else the one the
-- latest analysis read, else the sealed text unless the file has been reported
-- changed since. A library file never changes.
private pure func file_view(
    session: Session,
    sealed: SealedAnalysis,
    latest_sources: Option[SourceInputs],
    path: Path,
    file: ModuleSource
) -> Option[FileView]:
    match (latest_sources, file.role):
        (Some(read), UserModule):
            shown: Option[String] = match (
                session.documents.get(path),
                read.modules.find(pure func(row: ModuleSource) -> Bool: row.is_at(path))
            ):
                (Some(open), _):
                    Some(open.text)
                (None, Some(row)):
                    Some(row.contents)
                (None, None):
                    if sealed.changed_since.contains(path):
                        None
                    else:
                        Some(file.contents)

            shown.map(
                pure func(text: String) -> FileView: {
                    index = line_index(text),
                    map = Some(line_map(file.contents, text))
                }
            )
        _:
            Some({ index = line_index(file.contents), map = None })


-- The targets of `spans`, with each file's view built once, but for those
-- already `known`. Every span comes from `sealed`'s analysis, which read
-- `sealed.sources`, so a span in no file it read is a defect in the analysis,
-- not an expected case: it is left out rather than guessed, as is a span that
-- is not on one unchanged line of the file as the editor shows it.
private pure func targets(
    session: Session,
    sealed: SealedAnalysis,
    latest_sources: Option[SourceInputs],
    known: Dict[Path, Option[FileView]],
    spans: List[Span]
) -> List[Target]:
    var views = known
    var found: List[Target] = []

    for span in spans:
        match sealed.sources.span_file(session.library, span):
            Some((path, file)):
                view = match views.get(path):
                    Some(built): built
                    None: session.file_view(sealed, latest_sources, path, file)

                views = views.set(path, view)

                match view:
                    Some(seen):
                        shown: Option[Span] = match seen.map:
                            Some(map): map.current_span(span)
                            None: Some(span)

                        match shown:
                            Some(at):
                                range = seen.index.range_json(at, session.encoding)

                                match file.role:
                                    UserModule:
                                        uri = match session.documents.get(path):
                                            Some(open): open.uri
                                            None: path.file_uri()

                                        found = found.append({ uri = uri, range = range })
                                    LibraryModule | ConcurrencyModule | FoundationTypesModule | FoundationPreludeModule | FoundationMethodsModule:
                                        if session.serves_library_documents:
                                            found = found.append({
                                                uri = path.library_uri(),
                                                range = range
                                            })
                            None:
                                void
                    None:
                        void
            None:
                void

    found


-- Answers from the root's current analysis. A stale root, or one not yet
-- analysed, is analysed first, and `analysed` answers. A request whose params
-- name no document, or lack a position it needs, gets `null`.
private pure func document_requested(
    session: Session,
    id: RequestId,
    params: Option[Json],
    query: Option[DocumentQuery]
) -> Step:
    match (params.requested_document(), query):
        (Some(LibraryFile(relative)), Some(asked)):
            match session.library_documents.get(relative):
                Some(text):
                    replying(Serving(session), [
                        response(id, text.unanalysed_answer(asked, session.encoding))
                    ])
                None:
                    replying(Serving(session), [response(id, Null)])
        (Some(UserFile(path)), Some(asked)):
            root: Option[RootAnalysis] = session.roots
                .get(path)
                .map(pure func(row: AnalysedRoot) -> RootAnalysis: row.analysis)

            match root:
                Some(Current(latest)):
                    replying(Serving(session), [response(id, session.answer(path, latest, asked))])
                Some(Stale(_)) | None:
                    if session.documents.contains(path):
                        {
                            server = Server.Init(Serving(session)),
                            replies = [],
                            followup = Analyse({
                                root = path,
                                answering = Some({ id = id, query = asked })
                            })
                        }
                    else:
                        replying(Serving(session), [response(id, Null)])
        _:
            replying(Serving(session), [response(id, Null)])


-- A document a client names, by the scheme of its URI. Open library files and
-- open user files are kept apart, so a library path, which is relative, is
-- never looked up among the user's absolute ones.
private union DocumentUri:
    -- A `file:` URI's normalized absolute path.
    UserFile(Path)
    -- A `blorp-library:` URI's file path below the library root, as text.
    LibraryFile(String)


-- The document a request's params name, if the server reads its URI's scheme.
private pure func requested_document(params: Option[Json]) -> Option[DocumentUri]:
    params
        .field("textDocument")
        .text_field("uri")
        .map(document_uri)
        .get_or(None)


-- None for a URI of another scheme.
private pure func document_uri(uri: String) -> Option[DocumentUri]:
    match uri.library_uri_file():
        Some(relative):
            Some(LibraryFile(relative))
        None:
            uri
                .uri_path()
                .map(pure func(path: Path) -> DocumentUri: UserFile(path))


-- Notifications the server does not serve, `$/cancelRequest` among them, are
-- dropped, as are those about documents that are neither `file:` nor
-- `blorp-library:` URIs, or are not open. Only `didOpen` analyses. An edit or a
-- change on disk stales the roots that read the file. An open, or a close once
-- the transport has read the saved text, stales those that read other text for
-- it than the text it now has. A stale root analyses again at its next request,
-- and when a root other than the document's own goes stale the client is asked
-- to refresh its tokens. A library file is kept only for its tokens, and its
-- editor is read-only, so a change to it is dropped.
private pure func notified(session: Session, call: Call) -> Step:
    document = call.params.field("textDocument")
    uri = document.text_field("uri")

    match (
        call.method,
        uri
            .map(document_uri)
            .get_or(None)
    ):
        ("exit", _):
            replying(Exited(EXIT_ABANDONED), [])
        ("initialized", _):
            session.registered()
        ("workspace/didChangeWatchedFiles", _):
            session.watched(call.params)
        ("textDocument/didOpen", Some(named)):
            match (uri, document.text_field("text"), named):
                (Some(_), Some(text), LibraryFile(relative)):
                    replying(
                        Serving(
                            { session |
                                library_documents = session.library_documents.set(relative, text)
                            }
                        ),
                        []
                    )
                (Some(written), Some(text), UserFile(path)):
                    opened = { session |
                        documents = session.documents.set(path, { uri = written, text = text }),
                        roots = session.roots.staled(path, Some(text))
                    }

                    refreshing = opened.replying_with_refresh(session.roots.remove(path), [])
                    { refreshing | followup = Analyse({ root = path, answering = None }) }
                _:
                    replying(Serving(session), [])
        ("textDocument/didChange", Some(UserFile(path))):
            -- With full sync each change holds the whole text, so the last one wins.
            changed: Option[String] = match call.params.field("contentChanges"):
                Some(Array(changes)):
                    changes
                        .last()
                        .text_field("text")
                _:
                    None

            match (session.documents.get(path), changed):
                (Some(open), Some(text)):
                    { session |
                        documents = session.documents.set(path, { open | text = text }),
                        roots = session.roots.staled(path, None)
                    }.replying_with_refresh(session.roots.remove(path), [])
                _:
                    replying(Serving(session), [])
        ("textDocument/didClose", Some(UserFile(path))):
            -- The document reverts to its saved text, which `reverted` compares
            -- with the text each root read.
            if session.documents.contains(path):
                { server = Server.Init(Serving(session)), replies = [], followup = ReadSaved(path) }
            else:
                replying(Serving(session), [])
        ("textDocument/didClose", Some(LibraryFile(relative))):
            replying(
                Serving(
                    { session | library_documents = session.library_documents.remove(relative) }
                ),
                []
            )
        (_, _):
            replying(Serving(session), [])


private REFRESH_METHOD: String = "workspace/semanticTokens/refresh"

-- The files the server watches: every Blorp source, wherever it is.
private WATCHED_FILES: String = "**/*.brp"

-- The name the registration goes by, which could unregister it.
private WATCHER_REGISTRATION: String = "blorp-source-files"


-- Asks the client, once, to send a notification when a Blorp file changes on
-- disk, if it can.
private pure func registered(session: Session) -> Step:
    if session.registers_watchers:
        watchers: Json = Object(
            { "watchers" => Array([Object({ "globPattern" => Text(WATCHED_FILES) })]) }
        )

        registration: Json = Object(
            {
                "id" => Text(WATCHER_REGISTRATION),
                "method" => Text("workspace/didChangeWatchedFiles"),
                "registerOptions" => watchers
            }
        )

        id = session.requests_sent + 1

        replying(Serving({ session | registers_watchers = False, requests_sent = id }), [
            request(
                NumberId(id),
                "client/registerCapability",
                Some(Object({ "registrations" => Array([registration]) }))
            )
        ])
    else:
        replying(Serving(session), [])


-- Files changed on disk. An open file's text is the editor's, so a change to
-- it on disk changes no analysis; any other file stales the roots it affects.
private pure func watched(session: Session, params: Option[Json]) -> Step:
    var roots = session.roots

    match params.field("changes"):
        Some(Array(changes)):
            for change in changes:
                match (
                    Some(change)
                        .text_field("uri")
                        .map(uri_path)
                        .get_or(None)
                ):
                    Some(path):
                        if not(session.documents.contains(path)):
                            roots = roots.staled(path, None)
                    None:
                        void
        _:
            void

    { session | roots = roots }.replying_with_refresh(session.roots, [])


private pure func diagnostics_notification(uri: String, diagnostics: List[Json]) -> Json:
    notification(
        "textDocument/publishDiagnostics",
        Object({ "uri" => Text(uri), "diagnostics" => Array(diagnostics) })
    )


-- The diagnostics of one file, to the client's own URI when the file is open
-- and to the server's encoding of its path otherwise.
private pure func published_diagnostics(
    session: Session,
    path: Path,
    diagnostics: List[Json]
) -> Json:
    uri = match session.documents.get(path):
        Some(open): open.uri
        None: path.file_uri()

    diagnostics_notification(uri, diagnostics)


-- What to publish to each of `files` once the root `leaving` no longer reports
-- in it: what the most recently analysed other root last published there, or
-- `[]` when no other root reports there.
private pure func handed_over(session: Session, leaving: Path, files: List[Path]) -> List[Json]:
    var replies: List[Json] = []

    for file in files:
        var latest: List[Json] = []

        for (root, last) in session.roots.entries():
            if root != leaving:
                match last.published.get(file):
                    Some(diagnostics): latest = diagnostics
                    None: void

        replies = replies.append(session.published_diagnostics(file, latest))

    replies


-- Closes the document at `path` once the transport has read the saved text
-- it reverts to, `saved`, which is None when the file could not be read.
pure func reverted(server: Server, path: Path, saved: Option[String]) -> Step:
    lifecycle = match server:
        Server.Init(lifecycle): lifecycle

    match lifecycle:
        Serving(session): session.closed(path, saved)
        -- Only a serving server asks for a read, and the transport hands it
        -- back before it reads another message, so no other state gets here.
        AwaitingInitialize(_) | ShutDown | Exited(_): lifecycle.replying([])


-- The file reverts to its saved text, `saved`, and stops being a root. The
-- roots that read other text for it are stale, which is every root that read
-- it when the file could not be read. Each file it reported in shows what
-- another root reports there, if any does. The server forgets the client's URI
-- for the file and publishes to it under its own from now on, so when the two
-- differ the client's is cleared, and what other roots report in the file is
-- published again under the server's.
private pure func closed(session: Session, path: Path, saved: Option[String]) -> Step:
    reported: List[Path] = match session.roots.get(path):
        Some(last): last.published.keys()
        None: []

    remaining = { session |
        documents = session.documents.remove(path),
        roots = session.roots
            .remove(path)
            .staled(path, saved)
    }

    respelled: Option[String] = match session.documents.get(path):
        Some(open):
            if open.uri != path.file_uri():
                Some(open.uri)
            else:
                None
        None:
            None

    earlier = session.roots.remove(path)

    match respelled:
        Some(uri):
            files = if reported.contains(path):
                reported
            else:
                reported.append(path)

            remaining.replying_with_refresh(
                earlier,
                [diagnostics_notification(uri, [])].concat(remaining.handed_over(path, files))
            )
        None:
            remaining.replying_with_refresh(earlier, remaining.handed_over(path, reported))


-- Publishes the analysis of the requested root, then answers the request that
-- waited for it, if any. A document that was closed before its
-- analysis came back is no longer a root: the result is dropped, and the
-- request gets `null`.
pure func analysed(server: Server, asked: AnalysisRequest, result: DocumentAnalysis) -> Step:
    lifecycle = match server:
        Server.Init(lifecycle): lifecycle

    root = asked.root

    match lifecycle:
        Serving(session):
            var current = session
            var replies: List[Json] = []

            -- A success is sealed; a failure keeps the last success.
            kept: Option[SealedAnalysis] = match session.roots.get(root):
                Some(last): last.analysis.last_checked()
                None: None

            latest: LatestAnalysis = match result.outcome:
                Analysed(analysis):
                    Checked({ analysis = analysis, sources = result.sources, changed_since = [] })
                LoadFailed(_) | CheckFailed(_):
                    Failed(result, kept)

            if session.documents.contains(root):
                published = result.publications(session.library, session.encoding, root)

                previous: List[Path] = match session.roots.get(root):
                    Some(last): last.published.keys()
                    None: []

                for (path, diagnostics) in published.entries():
                    replies = replies.append(session.published_diagnostics(path, diagnostics))

                stopped = previous.filter(pure func(path: Path): not(published.contains(path)))
                replies = replies.concat(session.handed_over(root, stopped))

                -- Removing the row first moves the root to the end, so the
                -- rows stay in analysis order.
                current = { session |
                    roots = session.roots
                        .remove(root)
                        .set(root, { analysis = Current(latest), published = published })
                }

            match asked.answering:
                Some(waiting):
                    replies = replies.append(
                        response(waiting.id, current.answer(root, latest, waiting.query))
                    )
                None:
                    void

            replying(Serving(current), replies)
        AwaitingInitialize(_) | ShutDown | Exited(_):
            lifecycle.replying([])


-- One file's diagnostics, with the text their spans index.
private record FileReport {
    text: String,
    diagnostics: List[Diagnostic]
}


-- Each user file the analysis reports in, with its diagnostics in report
-- order. A diagnostic no user file can show goes at the start of the root:
-- one about blorp itself, at no file; one in a file the load did not record;
-- and one in a library file, whose path below the library root then leads its
-- message, since library files are never published. Each file's lines are
-- indexed once.
private pure func publications(
    result: DocumentAnalysis,
    library: LibraryLayout,
    encoding: PositionEncoding,
    root: Path
) -> Dict[Path, List[Json]]:
    errors: List[Diagnostic] = match result.outcome:
        LoadFailed(error): [error]
        CheckFailed(rejected): [rejected.first].concat(rejected.remaining)
        Analysed(_): []

    root_text: String = match result.sources.modules.get(root_module_id().module_number()):
        Some(row): row.contents
        None: ""

    var reports: Dict[Path, FileReport] = {}

    for error in errors:
        at_root_start = { error | span = { error.span | start = 0, end = 0 } }

        (path, text, shown) = match result.sources.span_file(library, error.span):
            Some((path, file)):
                match file.role:
                    UserModule:
                        (path, file.contents, error)
                    LibraryModule | ConcurrencyModule | FoundationTypesModule | FoundationPreludeModule | FoundationMethodsModule:
                        -- Lines and columns count from 1, as `blorp compile` reports them.
                        at = line_index(file.contents).position_of(error.span.start, Utf8)
                        location = "${path}:${at.line + 1}:${at.character + 1}"

                        (
                            root,
                            root_text,
                            { at_root_start | message = "${location}: ${error.message}" }
                        )
            None:
                (root, root_text, at_root_start)

        report: FileReport = match reports.get(path):
            Some(earlier): { earlier | diagnostics = earlier.diagnostics.append(shown) }
            None: { text = text, diagnostics = [shown] }

        reports = reports.set(path, report)

    var published: Dict[Path, List[Json]] = {}

    for (path, report) in reports.entries():
        index = line_index(report.text)

        published = published.set(
            path,
            report.diagnostics.map(
                pure func(error: Diagnostic) -> Json: error.diagnostic_json(index, encoding)
            )
        )

    published


private pure func position_json(position: Position) -> Json:
    Object(
        {
            "line" => Number(integer(position.line)),
            "character" => Number(integer(position.character))
        }
    )


private pure func range_json(index: LineIndex, span: Span, encoding: PositionEncoding) -> Json:
    Object(
        {
            "start" => index
                .position_of(span.start, encoding)
                .position_json(),
            "end" => index
                .position_of(span.end, encoding)
                .position_json()
        }
    )


private pure func diagnostic_json(
    error: Diagnostic,
    index: LineIndex,
    encoding: PositionEncoding
) -> Json:
    Object(
        {
            "range" => index.range_json(error.span, encoding),
            "severity" => Number(integer(ERROR_SEVERITY)),
            "message" => Text("${error.message}\nhelp: ${error.help}")
        }
    )
