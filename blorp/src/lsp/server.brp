---
The language server's state and its one step per message: the lifecycle, the
open documents, each root's last analysis and what it published, which roots a
change stales, and the replies each message earns, token requests among them.
Pure: the transport reads, analyses and writes.
---
import:
    bool: not
    bytes: Bytes
    dict: Dict
    json: Json(Null, Boolean, Number, Text, Array, Object), integer, parse
    list: List methods
    option: Option methods
    path: Path, to_path
    string: String methods
    ../common/analysis/check/check: Analysis, analyze
    ../common/analysis/check/render: render_failure
    ../common/analysis/load/load:
        LoadedProgram,
        SourceLoadFailure(
            DuplicateSourcePath,
            SourcePathContainsNul,
            SourcePathEmpty,
            LoadingFailed
        )
    ../common/syntax/source:
        ModuleKind(UserModule, LibraryModule, FoundationTypesModule, FoundationPreludeModule),
        ModuleSource,
        SourceFile,
        SourceInputs,
        module_number,
        root_module_id,
        source_module
    ../common/syntax/syntax: Diagnostic, Diagnostics, compiler_span, internal_error
    ./positions:
        LineIndex,
        Position,
        PositionEncoding(Utf8, Utf16),
        encoding_name,
        line_index,
        position_of
    ./protocol:
        Call,
        ClientMessage(Request, Notification, ClientResponse, InvalidMessage),
        ErrorCode(ParseError, InvalidRequest, MethodNotFound, ServerNotInitialized),
        RequestId(NumberId),
        client_message,
        error_response,
        field,
        file_uri,
        notification,
        request,
        response,
        text_field,
        uri_path
    ./tokens: Classified, analysed_identifiers, semantic_tokens, token_legend


-- How far loading and analysing one root got.
union AnalysisOutcome:
    -- Loading stopped at its first error.
    LoadFailed(Diagnostic)
    -- The program loaded, and checking rejected it.
    CheckFailed(Diagnostics)
    -- The program loaded and checked.
    Analysed(Analysis)


-- What the transport hands back after it loads and analyses one root: the
-- files the load read, whose texts the diagnostics' spans index, and how far
-- it got.
record DocumentAnalysis {
    sources: SourceInputs,
    outcome: AnalysisOutcome
}


-- The server's paths are normalized and absolute, and so unique and free of
-- NUL, so only a defect in the server makes the loader refuse them.
pure func document_analysis(loaded: Result[LoadedProgram, SourceLoadFailure]) -> DocumentAnalysis:
    match loaded:
        Ok(program):
            outcome: AnalysisOutcome = match analyze(program.program):
                Ok(analysis): Analysed(analysis)
                Err(failure): CheckFailed(render_failure(failure))
            { sources = program.sources, outcome = outcome }
        Err(LoadingFailed(failure)):
            { sources = failure.sources, outcome = LoadFailed(failure.diagnostic) }
        Err(DuplicateSourcePath(_) | SourcePathContainsNul(_) | SourcePathEmpty):
            {
                sources = { modules = [] },
                outcome = LoadFailed(
                    internal_error(
                        compiler_span(),
                        "the language server gave the loader an unusable path"
                    )
                )
            }


-- Whether a root's last analysis still holds.
private union RootAnalysis:
    -- No file it read has changed since, so requests are answered from it.
    Current(DocumentAnalysis)
    -- A file it read has changed, or its load failed and some file has. The
    -- root's next request analyses it again.
    Stale


-- A root's last analysis, and what it published: the diagnostics of each user
-- file it reports in, so that when it stops reporting in a file another root's
-- can be shown there again.
private record AnalysedRoot {
    analysis: RootAnalysis,
    published: Dict[Path, List[Json]]
}


-- An open document: the URI the client named it by, which every publication to
-- it repeats so that the editor matches it, and its text.
private record OpenDocument {
    uri: String,
    text: String
}


private record Session {
    encoding: PositionEncoding,
    -- Each open document, by its normalized absolute path. An open document is
    -- the root of its own program (the v1 limitation), and every analysis
    -- reads these texts instead of the disk.
    documents: Dict[Path, OpenDocument],
    -- Each root's last analysis, current or stale, and what it published, in
    -- the order the roots were last analysed, so that a file several roots
    -- report in shows the latest analysis's diagnostics. Token requests are
    -- answered from a current analysis. A root not yet analysed has no row.
    roots: Dict[Path, AnalysedRoot],
    -- Whether the server is still to register for changed files: the client
    -- can report them, and `initialized`, after which the server may ask, has
    -- not come yet.
    registers_watchers: Bool,
    -- How many requests the server has sent; each takes the next number as
    -- its id.
    requests_sent: Int
}


private union Lifecycle:
    -- Requests other than `initialize` get -32002, and notifications other
    -- than `exit` are dropped.
    AwaitingInitialize
    Serving(Session)
    -- After `shutdown`, requests get -32600 and `exit` ends with status 0.
    ShutDown
    -- `exit` has arrived; the process ends with this status.
    Exited(Int)


opaque type Server = Lifecycle


-- An analysis for the transport to run and hand back to `analysed`: the root
-- to load and analyse, and the token request that waits for it, if any.
-- `didOpen` asks for its own document and answers nothing.
record AnalysisRequest {
    root: Path,
    answering: Option[RequestId]
}


record Step {
    server: Server,
    replies: List[Json],
    analyse: Option[AnalysisRequest]
}


-- The status the process ends with unless `exit` follows `shutdown`: an exit
-- without shutdown (the protocol's rule) or input that ends without exit.
EXIT_ABANDONED: Int = 1

private EXIT_AFTER_SHUTDOWN: Int = 0

-- TextDocumentSyncKind.Full: every change sends the whole text.
private FULL_SYNC: Int = 1

-- DiagnosticSeverity.Error: every diagnostic stops compilation.
private ERROR_SEVERITY: Int = 1


pure func start_server() -> Server:
    into_opaque Server(AwaitingInitialize)


-- Some once `exit` has arrived.
pure func exit_status(server: Server) -> Option[Int]:
    match from_opaque Server(server):
        Exited(status): Some(status)
        AwaitingInitialize | Serving(_) | ShutDown: None


-- The open documents, which an analysis reads instead of the disk.
pure func snapshots(server: Server) -> List[SourceFile]:
    match from_opaque Server(server):
        Serving(session):
            session.documents
                .entries()
                .map(
                    pure func(document: (Path, OpenDocument)) -> SourceFile: {
                        path = document[0].to_string(),
                        contents = document[1].text
                    }
                )
        AwaitingInitialize | ShutDown | Exited(_):
            []


private pure func replying(lifecycle: Lifecycle, replies: List[Json]) -> Step:
    { server = into_opaque Server(lifecycle), replies = replies, analyse = None }


-- A body that is not UTF-8 JSON gets -32700 with a null id in any state:
-- nothing in it says what was asked.
pure func receive_body(server: Server, body: Bytes) -> Step:
    lifecycle = from_opaque Server(server)
    match body.to_text():
        None:
            lifecycle.replying([error_response(None, ParseError, "the message body is not UTF-8")])
        Some(text):
            match parse(text):
                Ok(message):
                    server.receive(message)
                Err(error):
                    lifecycle.replying([
                        error_response(None, ParseError, "the message body is not JSON: ${error}")
                    ])


pure func receive(server: Server, message: Json) -> Step:
    lifecycle = from_opaque Server(server)
    match (lifecycle, client_message(message)):
        (Exited(_), _) | (_, ClientResponse):
            lifecycle.replying([])
        (_, InvalidMessage(id)):
            lifecycle.replying([
                error_response(
                    id,
                    InvalidRequest,
                    "the message is not a JSON-RPC request or notification"
                )
            ])
        (AwaitingInitialize, Request(id, call)):
            if call.method == "initialize":
                encoding = call.params.agreed_encoding()
                session: Session = {
                    encoding = encoding,
                    documents = {},
                    roots = {},
                    registers_watchers = call.params.watches_files(),
                    requests_sent = 0
                }
                replying(Serving(session), [response(id, initialize_result(encoding))])
            else:
                lifecycle.replying([
                    error_response(
                        Some(id),
                        ServerNotInitialized,
                        "the server has not been initialized"
                    )
                ])
        (ShutDown, Request(id, _)):
            lifecycle.replying([
                error_response(Some(id), InvalidRequest, "the server has shut down")
            ])
        (Serving(session), Request(id, call)):
            match call.method:
                "shutdown":
                    replying(ShutDown, [response(id, Null)])
                "textDocument/semanticTokens/full":
                    session.tokens_requested(id, call.params)
                "initialize":
                    lifecycle.replying([
                        error_response(
                            Some(id),
                            InvalidRequest,
                            "the server is already initialized"
                        )
                    ])
                _:
                    lifecycle.replying([
                        error_response(Some(id), MethodNotFound, "unknown method `${call.method}`")
                    ])
        (ShutDown, Notification(call)):
            if call.method == "exit":
                replying(Exited(EXIT_AFTER_SHUTDOWN), [])
            else:
                lifecycle.replying([])
        (AwaitingInitialize, Notification(call)):
            if call.method == "exit":
                replying(Exited(EXIT_ABANDONED), [])
            else:
                lifecycle.replying([])
        (Serving(session), Notification(call)):
            session.notified(call)


-- UTF-8 when the client offers it, which saves converting; otherwise UTF-16,
-- which every client supports.
private pure func agreed_encoding(params: Option[Json]) -> PositionEncoding:
    match (
        params
            .field("capabilities")
            .field("general")
            .field("positionEncodings")
    ):
        Some(Array(offered)):
            utf8 = Utf8.encoding_name()
            offers_utf8 = offered.any(pure func(offer: Json) -> Bool:
                match offer:
                    Text(name): name == utf8
                    _: False
            )
            if offers_utf8:
                Utf8
            else:
                Utf16
        _:
            Utf16


-- Whether the client can tell the server of changed files that the server
-- registers for after `initialized`.
private pure func watches_files(params: Option[Json]) -> Bool:
    match (
        params
            .field("capabilities")
            .field("workspace")
            .field("didChangeWatchedFiles")
            .field("dynamicRegistration")
    ):
        Some(Boolean(True)): True
        _: False


-- What the server serves: the encoding chosen, the whole text on every
-- change, and every token of a document at once.
private pure func initialize_result(encoding: PositionEncoding) -> Json:
    Object(
        {
            "capabilities" => Object(
                {
                    "positionEncoding" => Text(encoding.encoding_name()),
                    "textDocumentSync" => Object(
                        { "openClose" => Boolean(True), "change" => Number(integer(FULL_SYNC)) }
                    ),
                    "semanticTokensProvider" => Object(
                        { "legend" => token_legend(), "full" => Boolean(True) }
                    )
                }
            )
        }
    )


-- Whether a change to `path` can change what `result` found: its analysis read
-- the file, or its load failed, and a file it could not find may now exist.
private pure func depends_on(result: DocumentAnalysis, path: Path) -> Bool:
    match result.outcome:
        LoadFailed(_):
            True
        CheckFailed(_) | Analysed(_):
            result.sources.modules.any(pure func(row: ModuleSource) -> Bool:
                match row.path.to_path():
                    Ok(read): read == path
                    Err(_): False
            )


-- Every root whose analysis a change to `path` affects, marked stale. A stale
-- root keeps what it published until its next request analyses it again, so a
-- burst of edits costs one analysis.
private pure func staled(roots: Dict[Path, AnalysedRoot], path: Path) -> Dict[Path, AnalysedRoot]:
    var marked = roots
    for (root, row) in roots.entries():
        match row.analysis:
            Current(result):
                if result.depends_on(path):
                    marked = marked.set(root, { row | analysis = Stale })
            Stale:
                void
    marked


-- The `semanticTokens/full` result for the open document `path`, from its
-- root's current analysis. While the root fails to analyse, only the lexer's
-- tokens are sent. `null` for a document that is not open.
private pure func document_tokens(session: Session, path: Path, result: DocumentAnalysis) -> Json:
    match session.documents.get(path):
        None:
            Null
        Some(open):
            identifiers: Dict[Int, Classified] = match result.outcome:
                Analysed(analysis): analysis.analysed_identifiers(result.sources, root_module_id())
                LoadFailed(_) | CheckFailed(_): {}
            data = open.text.semantic_tokens(root_module_id(), identifiers, session.encoding)
            Object(
                {
                    "data" => Array(
                        data.map(pure func(value: Int) -> Json: Number(integer(value)))
                    )
                }
            )


-- Answers from the root's current analysis. A stale root, or one not yet
-- analysed, is analysed first, and `analysed` answers.
private pure func tokens_requested(session: Session, id: RequestId, params: Option[Json]) -> Step:
    document: Option[Path] = params
        .field("textDocument")
        .text_field("uri")
        .map(uri_path)
        .get_or(None)
    match document:
        Some(path):
            match (
                session.roots
                    .get(path)
                    .map(pure func(row: AnalysedRoot) -> RootAnalysis: row.analysis)
            ):
                Some(Current(result)):
                    replying(Serving(session), [
                        response(id, session.document_tokens(path, result))
                    ])
                Some(Stale) | None:
                    if session.documents.contains(path):
                        {
                            server = into_opaque Server(Serving(session)),
                            replies = [],
                            analyse = Some({ root = path, answering = Some(id) })
                        }
                    else:
                        replying(Serving(session), [response(id, Null)])
        None:
            replying(Serving(session), [response(id, Null)])


-- Notifications the server does not serve, `$/cancelRequest` among them, are
-- dropped, as are those about documents that are not `file://` URIs or are
-- not open. Only `didOpen` analyses; a change, a close or a change on disk
-- stales the roots it affects, which analyse again at their next request.
private pure func notified(session: Session, call: Call) -> Step:
    document = call.params.field("textDocument")
    uri = document.text_field("uri")
    match (
        call.method,
        uri
            .map(uri_path)
            .get_or(None)
    ):
        ("exit", _):
            replying(Exited(EXIT_ABANDONED), [])
        ("initialized", _):
            session.registered()
        ("workspace/didChangeWatchedFiles", _):
            session.watched(call.params)
        ("textDocument/didOpen", Some(path)):
            match (uri, document.text_field("text")):
                (Some(written), Some(text)):
                    opened: Lifecycle = Serving(
                        { session |
                            documents = session.documents.set(path, { uri = written, text = text }),
                            roots = session.roots.staled(path)
                        }
                    )
                    {
                        server = into_opaque Server(opened),
                        replies = [],
                        analyse = Some({ root = path, answering = None })
                    }
                _:
                    replying(Serving(session), [])
        ("textDocument/didChange", Some(path)):
            -- With full sync each change holds the whole text, so the last one wins.
            changed: Option[String] = match call.params.field("contentChanges"):
                Some(Array(changes)):
                    changes
                        .last()
                        .text_field("text")
                _:
                    None
            match (session.documents.get(path), changed):
                (Some(open), Some(text)):
                    replying(
                        Serving(
                            { session |
                                documents = session.documents.set(path, { open | text = text }),
                                roots = session.roots.staled(path)
                            }
                        ),
                        []
                    )
                _:
                    replying(Serving(session), [])
        ("textDocument/didClose", Some(path)):
            session.closed(path)
        (_, _):
            replying(Serving(session), [])


-- The files the server watches: every Blorp source, wherever it is.
private WATCHED_FILES: String = "**/*.brp"

-- The name the registration goes by, which could unregister it.
private WATCHER_REGISTRATION: String = "blorp-source-files"


-- Asks the client, once, to send a notification when a Blorp file changes on
-- disk, if it can.
private pure func registered(session: Session) -> Step:
    if session.registers_watchers:
        watchers: Json = Object(
            { "watchers" => Array([Object({ "globPattern" => Text(WATCHED_FILES) })]) }
        )
        registration: Json = Object(
            {
                "id" => Text(WATCHER_REGISTRATION),
                "method" => Text("workspace/didChangeWatchedFiles"),
                "registerOptions" => watchers
            }
        )
        id = session.requests_sent + 1
        replying(Serving({ session | registers_watchers = False, requests_sent = id }), [
            request(
                NumberId(id),
                "client/registerCapability",
                Object({ "registrations" => Array([registration]) })
            )
        ])
    else:
        replying(Serving(session), [])


-- Files changed on disk. An open file's text is the editor's, so a change to
-- it on disk changes no analysis; any other file stales the roots it affects.
private pure func watched(session: Session, params: Option[Json]) -> Step:
    var roots = session.roots
    match params.field("changes"):
        Some(Array(changes)):
            for change in changes:
                match (
                    Some(change)
                        .text_field("uri")
                        .map(uri_path)
                        .get_or(None)
                ):
                    Some(path):
                        if not(session.documents.contains(path)):
                            roots = roots.staled(path)
                    None:
                        void
        _:
            void
    replying(Serving({ session | roots = roots }), [])


private pure func diagnostics_notification(uri: String, diagnostics: List[Json]) -> Json:
    notification(
        "textDocument/publishDiagnostics",
        Object({ "uri" => Text(uri), "diagnostics" => Array(diagnostics) })
    )


-- The diagnostics of one file, to the client's own URI when the file is open
-- and to the server's encoding of its path otherwise.
private pure func published_diagnostics(
    session: Session,
    path: Path,
    diagnostics: List[Json]
) -> Json:
    uri = match session.documents.get(path):
        Some(open): open.uri
        None: path.file_uri()
    diagnostics_notification(uri, diagnostics)


-- What to publish to each of `files` once the root `leaving` no longer reports
-- in it: what the most recently analysed other root last published there, or
-- `[]` when no other root reports there.
private pure func handed_over(session: Session, leaving: Path, files: List[Path]) -> List[Json]:
    var replies: List[Json] = []
    for file in files:
        var latest: List[Json] = []
        for (root, last) in session.roots.entries():
            if root != leaving:
                match last.published.get(file):
                    Some(diagnostics): latest = diagnostics
                    None: void
        replies = replies.append(session.published_diagnostics(file, latest))
    replies


-- The file reverts to the disk and stops being a root, and every root that
-- read its unsaved text is stale. Each file it reported in shows what another
-- root reports there, if any does. The server forgets the client's URI for the
-- file and publishes to it under its own from now on, so when the two differ
-- the client's is cleared, and what other roots report in the file is
-- published again under the server's.
private pure func closed(session: Session, path: Path) -> Step:
    reported: List[Path] = match session.roots.get(path):
        Some(last): last.published.keys()
        None: []
    remaining = { session |
        documents = session.documents.remove(path),
        roots = session.roots
            .remove(path)
            .staled(path)
    }
    respelled: Option[String] = match session.documents.get(path):
        Some(open):
            if open.uri != path.file_uri():
                Some(open.uri)
            else:
                None
        None:
            None
    match respelled:
        Some(uri):
            files = if reported.contains(path):
                reported
            else:
                reported.append(path)
            replying(
                Serving(remaining),
                [diagnostics_notification(uri, [])].concat(remaining.handed_over(path, files))
            )
        None:
            replying(Serving(remaining), remaining.handed_over(path, reported))


-- Publishes the analysis of the requested root, then answers the token
-- request that waited for it, if any. A document that was closed before its
-- analysis came back is no longer a root: the result is dropped, and the
-- request gets `null`.
pure func analysed(server: Server, asked: AnalysisRequest, result: DocumentAnalysis) -> Step:
    lifecycle = from_opaque Server(server)
    root = asked.root
    match lifecycle:
        Serving(session):
            var current = session
            var replies: List[Json] = []
            if session.documents.contains(root):
                published = result.publications(session.encoding, root)
                previous: List[Path] = match session.roots.get(root):
                    Some(last): last.published.keys()
                    None: []
                for (path, diagnostics) in published.entries():
                    replies = replies.append(session.published_diagnostics(path, diagnostics))
                stopped = previous.filter(pure func(path: Path): not(published.contains(path)))
                replies = replies.concat(session.handed_over(root, stopped))
                -- Removing the row first moves the root to the end, so the
                -- rows stay in analysis order.
                current = { session |
                    roots = session.roots
                        .remove(root)
                        .set(root, { analysis = Current(result), published = published })
                }
            match asked.answering:
                Some(id):
                    replies = replies.append(response(id, current.document_tokens(root, result)))
                None:
                    void
            replying(Serving(current), replies)
        AwaitingInitialize | ShutDown | Exited(_):
            lifecycle.replying([])


-- One file's diagnostics, with the text their spans index.
private record FileReport {
    text: String,
    diagnostics: List[Diagnostic]
}


-- Each user file the analysis reports in, with its diagnostics in report
-- order. A diagnostic no user file can show goes at the start of the root:
-- one about blorp itself, at no file; one in a file the load did not record;
-- and one in a library file, whose location then leads its message, since an
-- editor has no library file to show it in. Each file's lines are indexed
-- once.
private pure func publications(
    result: DocumentAnalysis,
    encoding: PositionEncoding,
    root: Path
) -> Dict[Path, List[Json]]:
    errors: List[Diagnostic] = match result.outcome:
        LoadFailed(error): [error]
        CheckFailed(rejected): [rejected.first].concat(rejected.remaining)
        Analysed(_): []
    root_text: String = match result.sources.modules.get(root_module_id().module_number()):
        Some(row): row.contents
        None: ""
    var reports: Dict[Path, FileReport] = {}
    for error in errors:
        at_root_start = { error | span = { error.span | start = 0, end = 0 } }
        row: Option[ModuleSource] = match error.span.source.source_module():
            Some(module): result.sources.modules.get(module.module_number())
            None: None
        (path, text, shown) = match row:
            Some(file):
                match (file.role, file.path.to_path()):
                    (UserModule, Ok(path)):
                        (path, file.contents, error)
                    (UserModule, Err(_)):
                        (root, root_text, at_root_start)
                    (LibraryModule | FoundationTypesModule | FoundationPreludeModule, _):
                        -- Lines and columns count from 1, as `blorp compile` reports them.
                        at = line_index(file.contents).position_of(error.span.start, Utf8)
                        location = "${file.path}:${at.line + 1}:${at.character + 1}"
                        (
                            root,
                            root_text,
                            { at_root_start | message = "${location}: ${error.message}" }
                        )
            None:
                (root, root_text, at_root_start)
        report: FileReport = match reports.get(path):
            Some(earlier): { earlier | diagnostics = earlier.diagnostics.append(shown) }
            None: { text = text, diagnostics = [shown] }
        reports = reports.set(path, report)
    var published: Dict[Path, List[Json]] = {}
    for (path, report) in reports.entries():
        index = line_index(report.text)
        published = published.set(
            path,
            report.diagnostics.map(
                pure func(error: Diagnostic) -> Json: error.diagnostic_json(index, encoding)
            )
        )
    published


private pure func position_json(position: Position) -> Json:
    Object(
        {
            "line" => Number(integer(position.line)),
            "character" => Number(integer(position.character))
        }
    )


private pure func diagnostic_json(
    error: Diagnostic,
    index: LineIndex,
    encoding: PositionEncoding
) -> Json:
    Object(
        {
            "range" => Object(
                {
                    "start" => index
                        .position_of(error.span.start, encoding)
                        .position_json(),
                    "end" => index
                        .position_of(error.span.end, encoding)
                        .position_json()
                }
            ),
            "severity" => Number(integer(ERROR_SEVERITY)),
            "message" => Text("${error.message}\nhelp: ${error.help}")
        }
    )
