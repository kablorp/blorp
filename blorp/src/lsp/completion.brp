---
Completion: what may be written at a position of the root's text. The lexer's
tokens around the cursor say what is being written, and the analysis's
namespace says which names the module can write there. A value's members and
the locals come from a completion probe: the editor's text checked up to a
hole at the cursor. Pure: the transport runs the probe, and the server renders
the items' ranges.
---
import:
    bool: and, not, or
    json: Json(Number, Object, Text), integer
    ../common/analysis/assemble: parsed_contents
    ../common/analysis/check/check:
        Analysis,
        analysis_names,
        analysis_namespace,
        analyze_completion,
        variant_names
    ../common/analysis/check/completion_facts: CompletionFacts(NameFacts, MemberFacts)
    ../common/analysis/check/render: render_failure
    ../common/analysis/load/load: LoadedProgram, SourceLoadFailure(LoadingFailed)
    ../common/analysis/namespace/namespace:
        Entity(Alias, Constant, Constructor, Function, Method, Trait, Type),
        Entry,
        NamedType,
        NamedValue(NamedAlias),
        Origin(Declared, Imported, Implicit),
        TypeHead(ListHead, PrimitiveHead, RecordHead, UnionHead),
        module_names,
        named_type,
        named_value,
        offered_entries
    ../common/syntax/lex: lex, lex_with_completion_hole
    ../common/syntax/names: NameId, NameTable, name_number, name_spellings, program_names
    ../common/syntax/source: module_source, root_module_id
    ../common/syntax/syntax:
        Comment,
        CompletionHole,
        Diagnostic,
        DiagnosticKind(CompilerFault),
        Keyword(
            AsKeyword,
            ForKeyword,
            FunctionKeyword,
            ImportKeyword,
            RecordKeyword,
            TraitKeyword,
            TypeKeyword,
            UnionKeyword,
            VarKeyword
        ),
        LexedProgram,
        Span,
        Spacing(Adjacent),
        Symbol(Dedent, Dot, Indent, LeftParen, Newline),
        Token,
        TokenKind(
            IdentifierToken,
            KeywordToken,
            SymbolToken,
            IntegerLiteral,
            FloatLiteral,
            QuotedString,
            PipeString,
            StringStart,
            StringSegment,
            InterpolationClose,
            StringEnd,
            CharLiteral
        ),
        WrittenName,
        compiler_span,
        internal_error


-- What the editor's text says is being written at the cursor, read from its
-- tokens.
union CompletionSite:
    -- Nothing completes here: in a comment, a string, a number or an import
    -- block, after a word that declares a new name, or at or past where
    -- lexing stopped.
    NoCompletion
    NameSite(Prefix)
    -- A member, after a `.`.
    MemberSite(MemberAt)


-- The prefix an item replaces: the part before the cursor of the identifier
-- or keyword the cursor is in or ends, else empty at the cursor. A probe's
-- hole covers the whole word, to `word_end`, so no rest of it is left to parse.
fixed record Prefix {
    span: Span,
    word_end: Int
}


record MemberAt {
    -- The identifier written against the dot's left, if there is one: an
    -- alias, a union or a value, as the namespace says.
    qualifier: Option[WrittenName],
    prefix: Prefix,
    -- Whether an argument list already follows the word, as in `name.le()`.
    called: Bool
}


-- A site that a probe of the editor's text answers: a name, whose locals it
-- finds, or a value's member.
union ProbedSite:
    ProbedName(Prefix)
    ProbedMember(MemberAt)


-- What answers a completion: the analysis alone, or a probe.
union CompletionPlan:
    -- Nothing completes, or an alias's or a type's members, from the analysis.
    Answered(Option[Completion])
    Probing(ProbedSite)


-- What a site allows: the items, each replacing `prefix`.
record Completion {
    prefix: Span,
    items: List[Offered]
}


-- One item: the label it shows and inserts, its kind and its rank. A member
-- call inserts the call, since `x.f` without parentheses reads a field.
record Offered {
    label: String,
    kind: CompletionKind,
    rank: ItemRank,
    inserts_call: Bool
}


-- Where an offered name comes from, nearest first. An item's sortText leads
-- with its rank's digit, then its label, so the order is total.
union ItemRank:
    LocalRank
    DeclaredRank
    ImportedRank
    ProvidedRank
    KeywordRank


-- The protocol's InsertTextFormat.Snippet.
private SNIPPET_TEXT_FORMAT: Int = 2


private pure func rank_digit(rank: ItemRank) -> String:
    match rank:
        LocalRank: "0"
        DeclaredRank: "1"
        ImportedRank: "2"
        ProvidedRank: "3"
        KeywordRank: "4"


-- The protocol's CompletionItemKind of each item offered.
union CompletionKind:
    MethodItem
    FunctionItem
    FieldItem
    VariableItem
    ClassItem
    InterfaceItem
    ModuleItem
    EnumItem
    KeywordItem
    EnumMemberItem
    ConstantItem
    StructItem


-- Each kind's number in LSP 3.17.
private pure func kind_number(kind: CompletionKind) -> Int:
    match kind:
        MethodItem: 2
        FunctionItem: 3
        FieldItem: 5
        VariableItem: 6
        ClassItem: 7
        InterfaceItem: 8
        ModuleItem: 9
        EnumItem: 13
        KeywordItem: 14
        EnumMemberItem: 20
        ConstantItem: 21
        StructItem: 22


-- The keywords of the forms the compiler reads, as a writer spells them; not
-- `builtin`, which only the base writes, nor the words the lexer reserves for
-- forms it does not read. `word_kind` is the one spelling map: a test checks
-- that each lexes as a keyword. `fixed`, `methods` and `tail_recursive` are
-- names the parser recognises by seeded id, not keywords, and are not offered.
private OFFERED_KEYWORDS: List[String] = [
    "as",
    "break",
    "continue",
    "else",
    "for",
    "func",
    "if",
    "implements",
    "import",
    "in",
    "match",
    "private",
    "pure",
    "record",
    "resource",
    "scoped",
    "trait",
    "type",
    "union",
    "var",
    "void",
    "while"
]


-- What answers a completion at `offset` of `text`, the root as the editor
-- shows it, given `analysis`, the root's latest that checked, if any. A
-- qualifier the analysis names as an alias or a type is answered from it; a
-- name, and any other member, waits for a probe.
pure func completion_plan(text: String, offset: Int, analysis: Option[Analysis]) -> CompletionPlan:
    names = match analysis:
        Some(checked): checked.analysis_names()
        None: program_names().names

    match text.completion_site(names, offset):
        NoCompletion:
            Answered(None)
        NameSite(prefix):
            text.probing(names, ProbedName(prefix))
        MemberSite(member):
            qualified: Option[List[Offered]] = match (analysis, member.qualifier):
                (Some(checked), Some(qualifier)): checked.qualified_items(qualifier.id)
                _: None

            match qualified:
                Some(items): Answered(Some({ prefix = member.prefix.span, items = items }))
                None: text.probing(names, ProbedMember(member))


-- A probe of `site`, where the lexer places its hole: it is the one judge of
-- that. It reads a line's indentation, a symbol and a pipe String whole, so it
-- refuses a hole inside them, and nothing completes there.
private pure func probing(text: String, names: NameTable, site: ProbedSite) -> CompletionPlan:
    match lex_with_completion_hole(module_source(root_module_id()), text, names, site.probe_hole()):
        Err(refused):
            match refused.kind:
                CompilerFault: Answered(None)
                _: Probing(site)
        Ok(_):
            Probing(site)


-- What follows `alias.` or `Type.`: the names the module offers, a union's
-- variants, or nothing for another type. None for a qualifier that is neither.
private pure func qualified_items(analysis: Analysis, qualifier: NameId) -> Option[List[Offered]]:
    namespace = analysis.analysis_namespace()

    -- Spelled once: `name_spelling` copies the table's keys per call.
    spellings = analysis
        .analysis_names()
        .name_spellings()

    root = root_module_id()

    match namespace.named_value(root, qualifier):
        Some(NamedAlias(aliased)):
            Some(
                namespace
                    .offered_entries(aliased.target)
                    .scope_items(spellings)
            )
        _:
            match namespace.named_type(root, qualifier):
                Some(named):
                    match named.head:
                        UnionHead(id):
                            Some(
                                analysis
                                    .variant_names(id, root)
                                    .map(pure func(variant: WrittenName) -> NameId: variant.id)
                                    .named_items(spellings, EnumMemberItem, DeclaredRank, False)
                            )
                        _:
                            Some([])
                None:
                    None


-- The hole a probe of `site` lexes: the whole word at the cursor, or nothing.
pure func probe_hole(site: ProbedSite) -> CompletionHole:
    prefix = match site:
        ProbedName(written): written
        ProbedMember(member): member.prefix

    { start = prefix.span.start, end = prefix.word_end }


-- What a probe found. A probe stops at an error in the program and leaves the
-- fallbacks; a fault in blorp leaves them too, and the transport reports it.
union ProbeOutcome:
    -- The facts at the hole, and the probe's names that spell them.
    Reached(CompletionFacts, List[String])
    Stopped
    Faulted(Diagnostic)


-- What checking `loaded`, a probe, found at its hole.
pure func probe_outcome(loaded: Result[LoadedProgram, SourceLoadFailure]) -> ProbeOutcome:
    match loaded:
        Ok(probe):
            match analyze_completion(probe.program):
                Ok(facts):
                    names = probe.program.parsed_contents().names
                    Reached(facts, names.name_spellings())
                Err(failure):
                    render_failure(failure).first.stop_or_fault()
        Err(LoadingFailed(failure)):
            failure.diagnostic.stop_or_fault()
        -- The server names every path the probe loads.
        Err(_):
            Faulted(
                internal_error(
                    compiler_span(),
                    "the language server gave a probe an unusable path"
                )
            )


private pure func stop_or_fault(diagnostic: Diagnostic) -> ProbeOutcome:
    match diagnostic.kind:
        CompilerFault: Faulted(diagnostic)
        _: Stopped


-- The completion at a probed site from what the probe found and from
-- `analysis`, the root's latest that checked: a name offers the locals first,
-- then the module's names and the keywords; a member offers what follows the
-- value's dot. A probe that stopped before its hole leaves a name the rest and
-- a member nothing.
pure func probed_completion(
    site: ProbedSite,
    outcome: ProbeOutcome,
    analysis: Option[Analysis]
) -> Completion:
    probed: (Option[CompletionFacts], List[String]) = match outcome:
        Reached(found, names): (Some(found), names)
        Stopped | Faulted(_): (None, [])

    (facts, spellings) = probed

    match site:
        ProbedName(prefix):
            -- A probe at its hole has the module's names as the text has them;
            -- else they come from the last analysis that checked.
            named: (List[Offered], List[Offered]) = match facts:
                Some(NameFacts(found)):
                    (
                        found.locals.named_items(spellings, VariableItem, LocalRank, False),
                        found.namespace
                            .module_names(root_module_id())
                            .scope_items(spellings)
                    )
                _:
                    ([], analysis.checked_module_items())

            (locals, module_items) = named

            keywords = OFFERED_KEYWORDS.map(
                pure func(word: String) -> Offered: {
                    label = word,
                    kind = KeywordItem,
                    rank = KeywordRank,
                    inserts_call = False
                }
            )

            {
                prefix = prefix.span,
                items = locals
                    .concat(module_items)
                    .concat(keywords)
            }
        ProbedMember(member):
            -- A call inserts its parentheses unless they are written already.
            items: List[Offered] = match facts:
                Some(MemberFacts(members)):
                    members.fields
                        .named_items(spellings, FieldItem, DeclaredRank, False)
                        .concat(
                            members.calls.named_items(
                                spellings,
                                MethodItem,
                                DeclaredRank,
                                member.called.not()
                            )
                        )
                _:
                    []

            { prefix = member.prefix.span, items = items }


-- The module's names from `analysis`, the root's last that checked, if any.
private pure func checked_module_items(analysis: Option[Analysis]) -> List[Offered]:
    match analysis:
        Some(checked):
            checked
                .analysis_namespace()
                .module_names(root_module_id())
                .scope_items(
                    checked
                        .analysis_names()
                        .name_spellings()
                )
        None:
            []


-- The site at `offset`, from the tokens `names` lexes `text` to. `names` is
-- the analysis's table, so a qualifier the analysis knows keeps its id.
pure func completion_site(text: String, names: NameTable, offset: Int) -> CompletionSite:
    source = module_source(root_module_id())

    -- A text that does not lex keeps the tokens before its first error, which
    -- say nothing about what follows it.
    read: (LexedProgram, Option[Int]) = match lex(source, text, names):
        Ok(whole): (whole, None)
        Err(failure): (failure.prefix, Some(failure.error.span.start))

    (lexed, stopped) = read
    tokens = lexed.tokens
    -- How many tokens start before the cursor: the last of them is the one the
    -- cursor is in or follows.
    var reached = 0

    for token in tokens:
        if token.span.start >= offset:
            break

        reached = reached + 1

    beyond: Bool = match stopped:
        Some(start): offset >= start
        None: False

    -- Comments are not tokens; a comment's span stops before its LF.
    commented = lexed.comments.any(
        pure func(comment: Comment) -> Bool: and(
            comment.span.start < offset,
            offset <= comment.span.end
        )
    )

    if or(or(beyond, commented), tokens.in_import_block(reached)):
        NoCompletion
    else:
        empty: Span = { source = source, start = offset, end = offset }

        -- The whole word at the cursor, which a probe's hole covers: the one the
        -- cursor is in or ends, or one that starts at it; then what follows.
        starts_word: Bool = match tokens.get(reached):
            Some(next): and(next.span.start == offset, next.kind.is_word())
            None: False

        after = if starts_word:
            reached + 1
        else:
            reached

        word_end: Int = match tokens.get(after - 1):
            Some(word):
                if and(word.kind.is_word(), word.span.end >= offset):
                    word.span.end
                else:
                    offset
            None:
                offset

        called: Bool = match tokens.get(after):
            Some(next):
                match next.kind:
                    SymbolToken(LeftParen): True
                    _: False
            None:
                False

        -- The prefix when the cursor follows no word.
        at_cursor: Prefix = { span = empty, word_end = word_end }

        match tokens.get(reached - 1):
            None:
                NameSite(at_cursor)
            Some(last):
                if last.span.end < offset:
                    -- A space or a line break separates the cursor from `last`.
                    tokens.site_after(reached - 1, at_cursor, called)
                else:
                    match last.kind:
                        IdentifierToken(_, _) | KeywordToken(_):
                            tokens.site_after(
                                reached - 2,
                                { span = { last.span | end = offset }, word_end = word_end },
                                called
                            )
                        IntegerLiteral(_) | FloatLiteral(_):
                            NoCompletion
                        _:
                            if last.in_string(offset):
                                NoCompletion
                            else:
                                -- A symbol, such as `.`, `..` or `${`, or a closing
                                -- quote, ends at the cursor.
                                tokens.site_after(reached - 1, at_cursor, called)


-- The site whose prefix is `prefix`, when `tokens[index]` is written right
-- before it: a member after a dot, nothing after a word that declares a new
-- name, else a name. Newline, Indent and Dedent are tokens, so a dot that ends
-- the line above is not right before the prefix.
private pure func site_after(
    tokens: List[Token],
    index: Int,
    prefix: Prefix,
    called: Bool
) -> CompletionSite:
    match tokens.get(index):
        None:
            NameSite(prefix)
        Some(written):
            match written.kind:
                SymbolToken(Dot):
                    qualifier: Option[WrittenName] = match tokens.get(index - 1):
                        Some(left):
                            match (left.kind, written.spacing):
                                (IdentifierToken(id, _), Adjacent):
                                    Some({ id = id, span = left.span })
                                _:
                                    None
                        None:
                            None

                    MemberSite({ qualifier = qualifier, prefix = prefix, called = called })
                KeywordToken(FunctionKeyword | VarKeyword | ForKeyword | RecordKeyword | UnionKeyword | TraitKeyword | TypeKeyword | AsKeyword):
                    NoCompletion
                _:
                    NameSite(prefix)


private pure func is_word(kind: TokenKind) -> Bool:
    match kind:
        IdentifierToken(_, _) | KeywordToken(_): True
        _: False


-- Whether `offset` is inside the string `token` is a piece of. A piece that
-- closes its string ends before the cursor at its end; any other piece,
-- including a hole's closing brace, holds the cursor at its end.
private pure func in_string(token: Token, offset: Int) -> Bool:
    after_start = token.span.start < offset

    match token.kind:
        QuotedString(_) | StringEnd | CharLiteral:
            and(after_start, offset < token.span.end)
        PipeString(_) | StringStart(_) | StringSegment(_) | InterpolationClose:
            and(after_start, offset <= token.span.end)
        _:
            False


-- Whether the first `reached` tokens end inside an import block: after an
-- `import` at the margin, before the Dedent that closes its rows. Import
-- blocks come first (the grammar's `import_block` rule); a block the text
-- never closes runs to its end.
private pure func in_import_block(tokens: List[Token], reached: Int) -> Bool:
    var depth = 0
    var inside: Bool = False

    for position in 0..reached:
        match tokens.get(position):
            Some(token):
                match token.kind:
                    KeywordToken(ImportKeyword):
                        if depth == 0:
                            inside = True
                    SymbolToken(Indent):
                        depth = depth + 1
                    SymbolToken(Dedent):
                        depth = depth - 1

                        if depth == 0:
                            inside = False
                    _:
                        void
            None:
                void

    -- The Dedents that close the block are made at the next code line, which can
    -- be below blank lines. A cursor past the last row's line break, with
    -- enough Dedents next to bring the block back to its opening depth, is
    -- already outside it.
    var dedents = 0

    for token in tokens.drop(reached):
        match token.kind:
            SymbolToken(Dedent): dedents = dedents + 1
            _: break

    closing: Bool = match tokens.get(reached - 1):
        Some(previous):
            match previous.kind:
                SymbolToken(Newline): dedents >= depth
                _: False
        None:
            False

    and(inside, not(closing))


-- An item for each entry, spelled from `spellings`, the analysis's names by id.
-- `module_names` and `offered_entries` list each entity once, and each variant
-- spelling once however many of a module's variants share it, so each label
-- and kind is one item.
private pure func scope_items(entries: List[Entry], spellings: List[String]) -> List[Offered]:
    var items: List[Offered] = []

    for entry in entries:
        match spellings.get(entry.name.id.name_number()):
            Some(label):
                items = items.append({
                    label = label,
                    kind = entry.entity.entity_kind(),
                    rank = entry.origin.origin_rank(),
                    inserts_call = False
                })
            -- The table issued the id, so its spelling is there.
            None:
                void

    items


-- An item for each name, spelled from `spellings`: the probe's, or the
-- analysis's. A call inserts its parentheses.
private pure func named_items(
    names: List[NameId],
    spellings: List[String],
    kind: CompletionKind,
    rank: ItemRank,
    inserts_call: Bool
) -> List[Offered]:
    var items: List[Offered] = []

    for name in names:
        match spellings.get(name.name_number()):
            Some(label):
                items = items.append({
                    label = label,
                    kind = kind,
                    rank = rank,
                    inserts_call = inserts_call
                })
            -- The table issued the id, so its spelling is there.
            None:
                void

    items


private pure func entity_kind(entity: Entity) -> CompletionKind:
    match entity:
        Function(_): FunctionItem
        Method(_): MethodItem
        Constant(_): ConstantItem
        Constructor(_): EnumMemberItem
        Type(RecordHead(_)): StructItem
        Type(UnionHead(_)): EnumItem
        Type(PrimitiveHead(_) | ListHead): ClassItem
        Trait(_): InterfaceItem
        Alias(_): ModuleItem


private pure func origin_rank(origin: Origin) -> ItemRank:
    match origin:
        Declared(_): DeclaredRank
        Imported: ImportedRank
        Implicit: ProvidedRank


-- The protocol's CompletionItem for `item`, replacing the text at `range`. For
-- a client that reads `snippets`, a call is a snippet with the cursor between
-- its parentheses; otherwise the cursor ends after them.
pure func offered_json(item: Offered, range: Json, snippets: Bool) -> Json:
    snippet = and(item.inserts_call, snippets)

    inserted = if snippet:
        "${item.label}($0)"
    else if item.inserts_call:
        "${item.label}()"
    else:
        item.label

    fields: Dict[String, Json] = {
        "label" => Text(item.label),
        "kind" => Number(integer(item.kind.kind_number())),
        "sortText" => Text("${item.rank.rank_digit()}${item.label}"),
        "textEdit" => Object({ "range" => range, "newText" => Text(inserted) })
    }

    if snippet:
        Object(fields.set("insertTextFormat", Number(integer(SNIPPET_TEXT_FORMAT))))
    else:
        Object(fields)
