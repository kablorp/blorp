---
`blorp lsp`: its help text and the transport, the only impure code of the
language server. The transport writes the standard library to a folder of its
own for an editor to open, reads each message, steps the server, analyses a
root when the step asks for one, and writes every reply.
---
import:
    bool: and, not
    bytes: Bytes
    io/console/output: flush, write
    io/console/read_exact: ReadExactError(EndedEarly), read_exact
    io/console/read_line: read_line
    io/environment: get_current_directory
    io/files/create_directory: CreateDirectoryError, create_directories
    io/files/temporary_directory: TemporaryDirectoryError, with_temporary_directory
    io/files/write: WriteError, write_text
    list: List methods
    option: Option methods
    path: Path, PathError, join, parent, to_path
    result: Result methods
    string: String methods
    ../common/analysis/load/load:
        LibrarySource(EmbeddedLibrary, LibraryDirectory),
        LoadFailure,
        embedded_library_files,
        library_layout,
        load_program_with_sources,
        working_directory_result
    ../common/cli/report: kind_status
    ../common/cli/usage: error_message, unknown_option
    ../common/syntax/source: SourceFile
    ../common/syntax/syntax: Diagnostic, compiler_span, internal_error, path_error
    ./protocol:
        FramingError(HeaderUnfinished, LineUnreadable, BodyUnreadable),
        content_length,
        framed
    ./server:
        EXIT_ABANDONED,
        ServedLibrary,
        Server,
        Step,
        analysed,
        document_analysis,
        exit_status,
        receive_body,
        snapshots,
        start_server


LSP_HELP: String =
    |usage: blorp lsp
    |
    |Serves the Language Server Protocol on standard input and output, for an
    |editor to start. Each open .brp file is the root of its own program: the
    |file, the modules it imports and the standard library.
    |
    |options:
    |  -h, --help  show this help


-- `blorp lsp` takes no arguments: the editor sends everything else over the protocol.
pure func parse_lsp(words: List[String]) -> Result[Void, String]:
    match words:
        []:
            Ok(void)
        [word, ..._]:
            if word.starts_with("-"):
                Err(unknown_option(word, "lsp"))
            else:
                Err(
                    error_message(
                        "blorp lsp takes no arguments, but `${word}` was given",
                        "run blorp lsp alone; the editor sends the files it opens"
                    )
                )


-- The library every analysis reads: the copy built into blorp, as `blorp
-- compile` reads it. The folder the transport writes is a view of it for
-- editors, which nothing loads from.
private ANALYSED_LIBRARY: LibrarySource = EmbeddedLibrary

-- Where the server writes the standard library for its session, so that a
-- library declaration is a file an editor can open. Every supported platform
-- is POSIX, so /tmp exists.
private LIBRARY_PARENT: String = "/tmp"

private LIBRARY_FOLDER_PREFIX: String = "blorp-lsp-"


-- The header lines after `first`, up to the blank one, which is dropped.
private func header_lines(first: Bytes) -> Result[List[Bytes], FramingError]:
    var lines: List[Bytes] = []
    var line = first
    var ended: Option[FramingError] = None
    while and(ended.is_none(), not(line.is_empty())):
        lines = lines.append(line)
        match read_line():
            Ok(Some(next)): line = next
            Ok(None): ended = Some(HeaderUnfinished)
            Err(error): ended = Some(LineUnreadable(error))
    match ended:
        Some(error): Err(error)
        None: Ok(lines)


-- The body after a header whose first line is `first`: exactly the bytes its
-- Content-Length counts.
private func read_body(first: Bytes) -> Result[Bytes, FramingError]:
    header ?= header_lines(first)
    length ?= content_length(header)
    match read_exact(length):
        Ok(Some(body)): Ok(body)
        Ok(None): Err(BodyUnreadable(EndedEarly(0)))
        Err(error): Err(BodyUnreadable(error))


-- One message: header lines up to the blank one, then the body. None at end
-- of input between messages.
private func read_message() -> Result[Option[Bytes], FramingError]:
    match read_line():
        Err(error):
            Err(LineUnreadable(error))
        Ok(None):
            Ok(None)
        Ok(Some(first)):
            first
                .read_body()
                .map(pure func(body: Bytes): Some(body))


-- Writes the step's replies, then analyses the root it asks for, with the open
-- documents as snapshots, and performs the step that answers.
private func perform(step: Step) -> Server:
    for reply in step.replies:
        write(framed(reply))
        flush()
    match step.analyse:
        None:
            step.server
        Some(request):
            loaded = request.root
                .to_string()
                .load_program_with_sources(ANALYSED_LIBRARY, step.server.snapshots())
            step.server
                .analysed(request, document_analysis(loaded))
                .perform()


-- One library file at its place below `folder`, its folders made first.
private func write_library_file(folder: Path, file: SourceFile) -> Result[Void, String]:
    relative ?= file.path
        .to_path()
        .map_err(pure func(error: PathError) -> String: "${file.path}: ${error}")
    target = folder.join(relative)
    _ ?= create_directories(target.parent()).map_err(
        pure func(error: CreateDirectoryError) -> String: "${target.parent()}: ${error}"
    )
    write_text(target, file.contents).map_err(
        pure func(error: WriteError) -> String: "${target}: ${error}"
    )


-- A failure to make, fill or remove the library's folder in `temporary`.
private pure func folder_error(temporary: Path, message: String) -> Diagnostic:
    path_error(
        compiler_span(),
        "blorp lsp ${message}",
        "check that ${temporary} is a folder blorp can write to"
    )


-- Writes the library into `folder`, then serves until the session ends. The
-- server places library locations in the folder by the analysed library's
-- layout, and tells the library files a client opens by the folder's.
private func serve_in(folder: Path) -> Result[Int, Diagnostic]:
    directory ?= get_current_directory()
        .working_directory_result()
        .map_err(pure func(failure: LoadFailure) -> Diagnostic: failure.diagnostic)
    embedded ?= library_layout(ANALYSED_LIBRARY, directory).map_err(
        pure func(error: PathError) -> Diagnostic: internal_error(
            compiler_span(),
            "the embedded library's root is not a usable path: ${error}"
        )
    )
    view ?= library_layout(LibraryDirectory(folder.to_string()), directory).map_err(
        pure func(error: PathError) -> Diagnostic: internal_error(
            compiler_span(),
            "the library folder ${folder} is not a usable path: ${error}"
        )
    )
    files ?= embedded_library_files().map_err(
        pure func(problem: String) -> Diagnostic: internal_error(compiler_span(), problem)
    )
    var written: Result[Void, String] = Ok(void)
    for file in files:
        written = folder.write_library_file(file)
        if not(written.is_ok()):
            break
    _ ?= written.map_err(
        pure func(problem: String) -> Diagnostic: folder
            .parent()
            .folder_error("could not write the standard library: ${problem}")
    )
    Ok(serve_messages({ analysed = embedded, view = view }))


-- Serves with the library written to a fresh folder in `temporary`, which is
-- removed when the session ends, and returns the status the session ends
-- with. `serve` names LIBRARY_PARENT; a test names a folder that cannot hold
-- it.
func serve_in_new_folder(temporary: Path) -> Result[Int, Diagnostic]:
    with_temporary_directory(
        temporary,
        LIBRARY_FOLDER_PREFIX,
        serve_in,
        pure func(error: TemporaryDirectoryError) -> Diagnostic: temporary.folder_error(
            "could not make or remove its folder in ${temporary}: ${error}"
        )
    )


-- A failure to make, fill or remove the folder is a path problem; a library
-- that disagrees with itself is a fault in blorp.
func serve() -> Int:
    served: Result[Int, Diagnostic] = match LIBRARY_PARENT.to_path():
        Ok(temporary):
            serve_in_new_folder(temporary)
        Err(error):
            Err(internal_error(compiler_span(), "${LIBRARY_PARENT} is not a usable path: ${error}"))
    match served:
        Ok(status):
            status
        Err(error):
            print_error(error_message(error.message, error.help))
            error.kind.kind_status()


-- Answers messages until `exit` or the end of input, and returns the status
-- the process ends with.
private func serve_messages(library: ServedLibrary) -> Int:
    var server = start_server(library)
    var status = EXIT_ABANDONED
    while True:
        match read_message():
            Ok(Some(body)):
                server = server
                    .receive_body(body)
                    .perform()
                match server.exit_status():
                    Some(ended):
                        status = ended
                        break
                    None:
                        void
            Ok(None):
                break
            Err(error):
                print_error(
                    error_message(
                        "blorp lsp stopped: ${error}",
                        "start blorp lsp from a language client, which frames each message with a Content-Length header"
                    )
                )
                break
    status
