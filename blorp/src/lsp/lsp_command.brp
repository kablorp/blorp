---
`blorp lsp`: its help text and the transport, the only impure code of the
language server. The transport reads each message, steps the server, analyses a
root when the step asks for one, and writes every reply.
---
import:
    bool: and, not
    bytes: Bytes
    io/console/output: flush, write
    io/console/read_exact: ReadExactError(EndedEarly), read_exact
    io/console/read_line: read_line
    io/environment: get_current_directory
    io/files/read: read_text
    path: PathError
    ../common/analysis/load/load:
        LibraryLayout,
        LibrarySource(EmbeddedLibrary),
        LoadFailure,
        library_layout,
        load_program_with_sources,
        working_directory_result
    ../common/cli/report: kind_status
    ../common/cli/usage: error_message, unknown_option
    ../common/syntax/syntax: Diagnostic, compiler_span, internal_error
    ./completion: ProbeOutcome(Faulted, Reached, Stopped), probe_hole, probe_outcome
    ./protocol:
        FramingError(HeaderUnfinished, LineUnreadable, BodyUnreadable),
        content_length,
        framed
    ./server:
        EXIT_ABANDONED,
        Followup(Idle, Analyse, ReadSaved, Probe),
        Server,
        Step,
        analysed,
        document_analysis,
        exit_status,
        probed,
        receive_body,
        reverted,
        snapshots,
        start_server


LSP_HELP: String =
    |usage: blorp lsp
    |
    |Serves the Language Server Protocol on standard input and output, for an
    |editor to start. Each open .brp file is the root of its own program: the
    |file, the modules it imports and the standard library.
    |
    |options:
    |  -h, --help  show this help


-- `blorp lsp` takes no arguments: the editor sends everything else over the protocol.
pure func parse_lsp(words: List[String]) -> Result[Void, String]:
    match words:
        []:
            Ok(void)
        [word, ..._]:
            if word.starts_with("-"):
                Err(unknown_option(word, "lsp"))
            else:
                Err(
                    error_message(
                        "blorp lsp takes no arguments, but `${word}` was given",
                        "run blorp lsp alone; the editor sends the files it opens"
                    )
                )


-- The library every analysis reads: the copy built into blorp, as `blorp
-- compile` reads it. An editor fetches its files from the server.
private ANALYSED_LIBRARY: LibrarySource = EmbeddedLibrary


-- The header lines after `first`, up to the blank one, which is dropped.
private func header_lines(first: Bytes) -> Result[List[Bytes], FramingError]:
    var lines: List[Bytes] = []
    var line = first
    var ended: Option[FramingError] = None

    while and(ended.is_none(), not(line.is_empty())):
        lines = lines.append(line)

        match read_line():
            Ok(Some(next)): line = next
            Ok(None): ended = Some(HeaderUnfinished)
            Err(error): ended = Some(LineUnreadable(error))

    match ended:
        Some(error): Err(error)
        None: Ok(lines)


-- The body after a header whose first line is `first`: exactly the bytes its
-- Content-Length counts.
private func read_body(first: Bytes) -> Result[Bytes, FramingError]:
    header ?= header_lines(first)
    length ?= content_length(header)

    match read_exact(length):
        Ok(Some(body)): Ok(body)
        Ok(None): Err(BodyUnreadable(EndedEarly(0)))
        Err(error): Err(BodyUnreadable(error))


-- One message: header lines up to the blank one, then the body. None at end
-- of input between messages.
private func read_message() -> Result[Option[Bytes], FramingError]:
    match read_line():
        Err(error):
            Err(LineUnreadable(error))
        Ok(None):
            Ok(None)
        Ok(Some(first)):
            first
                .read_body()
                .map(pure func(body: Bytes): Some(body))


-- Writes the step's replies, then does what it asks: analyses a root, or probes
-- it for a completion, with the open documents as snapshots, or reads a closed
-- document's saved text, and performs the step that follows.
private func perform(step: Step) -> Server:
    for reply in step.replies:
        write(framed(reply))
        flush()

    match step.followup:
        Idle:
            step.server
        Analyse(request):
            loaded = request.root
                .to_string()
                .load_program_with_sources(ANALYSED_LIBRARY, step.server.snapshots(), None)

            step.server
                .analysed(request, document_analysis(loaded))
                .perform()
        ReadSaved(path):
            -- `read_text` is how a load reads a user module no snapshot
            -- supplies, so this is the text the next analysis would read.
            saved: Option[String] = match path.read_text():
                Ok(text): Some(text)
                Err(_): None

            step.server
                .reverted(path, saved)
                .perform()
        Probe(request):
            loaded = request.root
                .to_string()
                .load_program_with_sources(
                    ANALYSED_LIBRARY,
                    step.server.snapshots(),
                    Some(request.site.probe_hole())
                )

            outcome = loaded.probe_outcome()

            -- A fault in blorp is reported, as `serve` reports one; the editor
            -- still gets the fallback.
            match outcome:
                Faulted(fault): print_error(error_message(fault.message, fault.help))
                Reached(_, _) | Stopped: void

            step.server
                .probed(request, outcome)
                .perform()


-- A failure to lay out the embedded library is a fault in blorp, not in the
-- editor's request.
private func library_layout_for_session() -> Result[LibraryLayout, Diagnostic]:
    directory ?= get_current_directory()
        .working_directory_result()
        .map_err(pure func(failure: LoadFailure) -> Diagnostic: failure.diagnostic)

    library_layout(ANALYSED_LIBRARY, directory).map_err(
        pure func(error: PathError) -> Diagnostic: internal_error(
            compiler_span(),
            "the embedded library's root is not a usable path: ${error}"
        )
    )


-- Serves until `shutdown`, `exit` or the end of input, and returns the status
-- the process ends with.
func serve() -> Int:
    match library_layout_for_session():
        Ok(layout):
            serve_messages(start_server(layout))
                .exit_status()
                .get_or(EXIT_ABANDONED)
        Err(error):
            print_error(error_message(error.message, error.help))
            error.kind.kind_status()


-- Answers messages until `exit`, `shutdown` or the end of input, and returns
-- the server as it stopped.
private func serve_messages(started: Server) -> Server:
    var server = started

    while True:
        match read_message():
            Ok(Some(body)):
                server = server
                    .receive_body(body)
                    .perform()

                if (
                    server
                        .exit_status()
                        .is_some()
                ):
                    break
            Ok(None):
                break
            Err(error):
                print_error(
                    error_message(
                        "blorp lsp stopped: ${error}",
                        "start blorp lsp from a language client, which frames each message with a Content-Length header"
                    )
                )

                break

    server
