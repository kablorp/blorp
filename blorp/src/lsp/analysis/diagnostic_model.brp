-- Dependency-light diagnostic values and the final stale-publication guard.
-- Compiler analysis constructs these values, while the serialized server state
-- alone decides whether a completed publication still describes current text.
import:
	../protocol/identity: DocumentUri
	../protocol/position: ProtocolRange
	../workspace/document_model: DocumentVersion, document_version_value
	../workspace/document_store: DocumentStore, document_store_find
	../workspace/snapshot_model: ConfigurationEpoch, SnapshotIdentity, WorkspaceRevision


enum DiagnosticSeverity:
	ErrorDiagnostic
	WarningDiagnostic
	InformationDiagnostic
	HintDiagnostic


record Diagnostic {
	range: ProtocolRange,
	severity: DiagnosticSeverity,
	code: Option[String],
	message: String
}


record DiagnosticPublication {
	identity: SnapshotIdentity,
	diagnostics: List[Diagnostic]
}


record DiagnosticClearRequest {
	uri: DocumentUri
}


--- The version and diagnostics a client has already been sent for one URI.
--- This is exactly what a publication puts on the wire, so two records that
--- compare equal describe a message the client has already received.
record PublishedDiagnostics {
	document_version: Option[DocumentVersion],
	diagnostics: List[Diagnostic]
}


private pure func diagnostic_severity_key(severity: DiagnosticSeverity) -> String:
	match severity:
		ErrorDiagnostic:
			"1"
		WarningDiagnostic:
			"2"
		InformationDiagnostic:
			"3"
		HintDiagnostic:
			"4"


private pure func diagnostic_key(diagnostic: Diagnostic) -> String:
	range = diagnostic.range
	range.start.line.to_string() + ":" + range.start.utf16_character.to_string() + ":" + range.end.line.to_string() + ":" + range.end.utf16_character.to_string() + ":" + diagnostic_severity_key(
		diagnostic.severity,
	) + ":" + diagnostic.code.get_or("") + ":" + diagnostic.message


private pure func diagnostics_key(diagnostics: List[Diagnostic]) -> String:
	diagnostics
		.map(func(diagnostic): diagnostic_key(diagnostic))
		.join("\u{1}")


private pure func document_version_key(version: Option[DocumentVersion]) -> String:
	match version:
		None:
			"none"
		Some(value):
			document_version_value(value).to_string()


--- What a publication would put on the wire, stripped of the workspace
--- bookkeeping a client never sees.
pure func published_diagnostics_of(publication: DiagnosticPublication) -> PublishedDiagnostics:
	{
		document_version = publication.identity.document_version,
		diagnostics = publication.diagnostics
	}


--- Whether two publications would look identical to the client.
pure func published_diagnostics_equal(
	left: PublishedDiagnostics,
	right: PublishedDiagnostics,
) -> Bool:
	(
		document_version_key(left.document_version) == document_version_key(right.document_version)
		and diagnostics_key(left.diagnostics) == diagnostics_key(right.diagnostics)
	)


pure func diagnostic_publication_is_current(
	documents: DocumentStore,
	workspace_revision: WorkspaceRevision,
	configuration_epoch: ConfigurationEpoch,
	publication: DiagnosticPublication,
) -> Bool:
	identity = publication.identity

	if (
		identity.workspace_revision != workspace_revision
		or identity.configuration_epoch != configuration_epoch
	):
		False
	else:
		match (identity.document_version, document_store_find(documents, identity.uri)):
			(Some(published_version), Some(opened)):
				document_version_value(
					published_version,
				) == document_version_value(opened.document.version)
			_:
				False


pure func diagnostic_clear_is_current(
	documents: DocumentStore,
	request: DiagnosticClearRequest,
) -> Bool:
	document_store_find(documents, request.uri).is_none()
