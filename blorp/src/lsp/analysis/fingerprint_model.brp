-- Bounded immutable identities shared by workspace and analysis models.
--
-- The source/configuration text used to derive an identity is deliberately not
-- retained in these values. Exact source remains available in the selected
-- SourceSnapshot and compiler artifacts for collision-safe validation after a
-- hash match; cache keys only retain the fixed-size BLAKE3 hex digest.
import:
	../../compiler/stage_04_modules/package_hash: blake3_hash_bytes_hex


opaque type ContentFingerprint = String

opaque type ModuleSurfaceFingerprint = String

opaque type FrontendFingerprint = String

opaque type SemanticArtifactId = String


pure func content_fingerprint(value: String) -> ContentFingerprint:
	into_opaque ContentFingerprint(blake3_hash_bytes_hex(value.to_bytes()))


pure func content_fingerprint_value(fingerprint: ContentFingerprint) -> String:
	from_opaque ContentFingerprint(fingerprint)


pure func content_fingerprints_equal(left: ContentFingerprint, right: ContentFingerprint) -> Bool:
	content_fingerprint_value(left) == content_fingerprint_value(right)


pure func module_surface_fingerprint(value: String) -> ModuleSurfaceFingerprint:
	into_opaque ModuleSurfaceFingerprint(blake3_hash_bytes_hex(value.to_bytes()))


pure func frontend_fingerprint_from_value(value: String) -> FrontendFingerprint:
	into_opaque FrontendFingerprint(blake3_hash_bytes_hex(value.to_bytes()))


pure func frontend_fingerprint_value(fingerprint: FrontendFingerprint) -> String:
	from_opaque FrontendFingerprint(fingerprint)


pure func frontend_fingerprints_equal(
	left: FrontendFingerprint,
	right: FrontendFingerprint,
) -> Bool:
	frontend_fingerprint_value(left) == frontend_fingerprint_value(right)


pure func semantic_artifact_id_from_value(value: String) -> SemanticArtifactId:
	into_opaque SemanticArtifactId(blake3_hash_bytes_hex(value.to_bytes()))


pure func semantic_artifact_id_value(artifact_id: SemanticArtifactId) -> String:
	from_opaque SemanticArtifactId(artifact_id)


pure func semantic_artifact_ids_equal(left: SemanticArtifactId, right: SemanticArtifactId) -> Bool:
	semantic_artifact_id_value(left) == semantic_artifact_id_value(right)
