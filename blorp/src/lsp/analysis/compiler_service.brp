-- Production compiler adapter for one immutable LSP analysis plan.
--
-- Graph discovery, parsing, module loading, and typechecking are shared compiler
-- services. This module owns only LSP artifact stamping, diagnostic conversion,
-- and per-target graph views over one completed graph typecheck.
import:
	../../compiler/pipeline: typecheck_compiler_frontend_graph_with_context
	../../compiler/stage_03_parse/parsed_ast: ParsedProgram, parsed_program_has_errors
	../../compiler/stage_04_modules/frontend_graph:
		FrontendGraph,
		FrontendImportEdge,
		FrontendImportResolution(FrontendResolvedImport),
		frontend_graph_import_edges,
		frontend_graph_modules,
	../../compiler/stage_04_modules/loaded_module:
		ModuleIdentity,
		ResolvedModuleIdentity,
		module_identities_equal,
		module_identity_from_resolved,
		resolved_module_identities_equal,
		resolved_module_identity_storage_key,
	../../compiler/stage_06_typecheck/bridge: TypecheckedGraph, TypecheckedModule
	../workspace/workspace_model: SourceSnapshot, source_snapshot_source
	../workspace/workspace_source: selected_source
	../workspace/workspace_store: DEPENDENCY_STORE_EMPTY
	analysis_model:
		source_snapshot_matches_parsed_program,
		typecheck_graph_analysis_context,
		typed_index_from_compiler,
	architecture:
		AnalysisRequest,
		AnalysisResult,
		AnalysisTarget,
		AnalysisWaveFailure(AnalysisWorkerFailed),
		FailedAnalysisTarget,
		SuccessfulAnalysisTarget,
		TargetAnalysisFailure(
			TargetParseFailed,
			TargetSemanticIndexFailed,
			TargetSourceUnavailable,
			TargetTypecheckFailed,
		),
		TargetAnalysisOutcome(TargetAnalysisFailed, TargetAnalysisSucceeded),
		analysis_target_semantic_artifact_id,
	diagnostic:
		DiagnosticPhase(ParseDiagnosticPhase, TypecheckDiagnosticPhase),
		merge_diagnostic_fragments,
		parse_diagnostic_publication,
		typecheck_diagnostic_publication,
	diagnostic_model: DiagnosticPublication
	frontend_graph: frontend_graph_for_roots
	semantic_index: semantic_index_extraction_error_detail, semantic_index_for_target


private FRONTEND_GRAPH_FAILURE: String = "LSP compiler frontend graph discovery failed"

private TYPECHECK_GRAPH_FAILURE: String = "LSP compiler graph typecheck request failed"

private TARGET_GRAPH_MODULE_MISSING: String = "LSP compiler target is missing from typed graph"

private DIAGNOSTIC_CONVERSION_FAILURE: String = "LSP compiler diagnostic range conversion failed"

private TYPED_INDEX_MISMATCH: String = "LSP typed index identity does not match compiler output"


private pure func all_typechecked_modules(graph: TypecheckedGraph) -> List[TypecheckedModule]:
	[graph.target] + graph.modules


private pure func retain_imported_declared_root(
	root_keys: Dict[String, Bool],
	imported_root_keys: Dict[String, Bool],
	edge: FrontendImportEdge,
) -> Dict[String, Bool]:
	match edge.resolution:
		FrontendResolvedImport(target):
			target_key = resolved_module_identity_storage_key(target)

			if (
				root_keys.contains(target_key)
				and not resolved_module_identities_equal(edge.importer, target)
			):
				imported_root_keys.set(target_key, True)
			else:
				imported_root_keys
		_:
			imported_root_keys


-- The shared typechecker treats its root as the consumer of the remaining
-- modules. Selecting an imported provider as that root would make an importer
-- look like a dependency of its own provider. Prefer the first declared root
-- that no other graph module imports; planner ordering makes the choice stable.
private pure func typecheck_root_for_frontend(
	graph: FrontendGraph,
	roots: List[ResolvedModuleIdentity],
) -> Option[ResolvedModuleIdentity]:
	empty_root_keys: Dict[String, Bool] = {}
	root_keys = roots.fold_left(empty_root_keys, func(keys, root):
		keys.set(resolved_module_identity_storage_key(root), True)
	)
	empty_imported_root_keys: Dict[String, Bool] = {}
	imported = frontend_graph_import_edges(
		graph,
	).fold_left(empty_imported_root_keys, func(imported_root_keys, edge):
		retain_imported_declared_root(root_keys, imported_root_keys, edge)
	)
	roots.find(func(candidate):
		not imported.contains(resolved_module_identity_storage_key(candidate))
	)


private pure func graph_view_for_identity(
	graph: TypecheckedGraph,
	identity: ModuleIdentity,
) -> Option[TypecheckedGraph]:
	modules = all_typechecked_modules(graph)
	target ?= modules.find(func(module):
		module_identities_equal(module.module_identity, identity)
	)

	Some({
		target = target,
		modules = modules.filter(
			func(candidate): not module_identities_equal(candidate.module_identity, identity),
		),
		next_def_id = graph.next_def_id,
		analysis_context = graph.analysis_context,
	})


private pure func diagnostic_publications(
	target: AnalysisTarget,
	source: SourceSnapshot,
	program: ParsedProgram,
	module: TypecheckedModule,
) -> Option[List[DiagnosticPublication]]:
	input = source_snapshot_source(source)
	parse_publication ?= parse_diagnostic_publication(
		target.identity,
		input,
		program.diagnostics,
	).to_option()
	typecheck_publication ?= typecheck_diagnostic_publication(
		target.identity,
		input,
		module.diagnostics,
	).to_option()
	-- LSP replacement semantics require one complete publication for a snapshot.
	-- Sending phase fragments separately lets an empty parse result temporarily
	-- clear typecheck errors from the same analysis completion.
	Some([
		merge_diagnostic_fragments(
			target.identity,
			[
				{
					phase = ParseDiagnosticPhase,
					diagnostics = parse_publication.diagnostics
				},
				{
					phase = TypecheckDiagnosticPhase,
					diagnostics = typecheck_publication.diagnostics
				},
			],
		),
	])


private pure func analysis_context_for_targets(
	targets: List[AnalysisTarget],
) -> Result[String, AnalysisWaveFailure]:
	match targets.get(0):
		None:
			Err(AnalysisWorkerFailed(TYPECHECK_GRAPH_FAILURE))
		Some(target):
			Ok(
				typecheck_graph_analysis_context(
					target.fingerprint.frontend,
					target.fingerprint.configuration_epoch,
				),
			)


private pure func failed_target(
	target: AnalysisTarget,
	failure: TargetAnalysisFailure,
	diagnostics: List[DiagnosticPublication],
) -> TargetAnalysisOutcome:
	failed: FailedAnalysisTarget = {
		target = target,
		failure = failure,
		diagnostics = diagnostics
	}
	TargetAnalysisFailed(failed)


private pure func analyze_parsed_target(
	target: AnalysisTarget,
	source: SourceSnapshot,
	target_graph: TypecheckedGraph,
) -> Result[TargetAnalysisOutcome, String]:
	program = target_graph.target.parsed_program

	match diagnostic_publications(target, source, program, target_graph.target):
		None:
			Err(DIAGNOSTIC_CONVERSION_FAILURE)
		Some(publications):
			if parsed_program_has_errors(program):
				Ok(failed_target(target, TargetParseFailed, publications))
			else if target_graph.target.errors.length() > 0:
				Ok(failed_target(target, TargetTypecheckFailed, publications))
			else:
				artifact_id = analysis_target_semantic_artifact_id(target)

				match semantic_index_for_target(artifact_id, target.identity.uri, target_graph):
					Err(error):
						Ok(
							failed_target(
								target,
								TargetSemanticIndexFailed(
									semantic_index_extraction_error_detail(error),
								),
								publications,
							),
						)
					Ok(index):
						match typed_index_from_compiler(
							artifact_id,
							target.identity.uri,
							target.fingerprint,
							target_graph,
							index,
						):
							None:
								Err(TYPED_INDEX_MISMATCH)
							Some(checked_index):
								success: SuccessfulAnalysisTarget = {
									target = target,
									index = checked_index,
									diagnostics = publications
								}
								Ok(TargetAnalysisSucceeded(success))


private pure func analyze_target_with_consistent_identity(
	request: AnalysisRequest,
	graph: TypecheckedGraph,
	target: AnalysisTarget,
) -> Result[TargetAnalysisOutcome, String]:
	match selected_source(request.plan.workspace.sources, target.identity.uri):
		None:
			Ok(failed_target(target, TargetSourceUnavailable, []))
		Some(source):
			match graph_view_for_identity(graph, target.fingerprint.module_identity):
				None:
					Err(TARGET_GRAPH_MODULE_MISSING)
				Some(target_graph):
					if source_snapshot_matches_parsed_program(
						source,
						target_graph.target.parsed_program,
					):
						analyze_parsed_target(target, source, target_graph)
					else:
						Err(TYPED_INDEX_MISMATCH)


private pure func analyze_target(
	request: AnalysisRequest,
	graph: TypecheckedGraph,
	target: AnalysisTarget,
) -> Result[TargetAnalysisOutcome, String]:
	resolved_identity = module_identity_from_resolved(target.resolved_module_identity)

	if not module_identities_equal(resolved_identity, target.fingerprint.module_identity):
		Err(TYPED_INDEX_MISMATCH)
	else:
		analyze_target_with_consistent_identity(request, graph, target)


private pure func analyze_targets(
	request: AnalysisRequest,
	graph: TypecheckedGraph,
) -> Result[List[TargetAnalysisOutcome], String]:
	var outcomes: List[TargetAnalysisOutcome] = []
	var error: Option[String] = None

	for target in request.plan.targets:
		if error.is_none():
			match analyze_target(request, graph, target):
				Ok(outcome):
					outcomes = outcomes.append(outcome)
				Err(message):
					error = Some(message)

	match error:
		Some(message):
			Err(message)
		None:
			Ok(outcomes)


func run_compiler_analysis(request: AnalysisRequest) -> Result[AnalysisResult, AnalysisWaveFailure]:
	match request.plan.roots:
		[]:
			Ok({
				workspace_revision = request.plan.workspace_revision,
				dependencies = DEPENDENCY_STORE_EMPTY,
				outcomes = [],
			})
		[_, ..._]:
			match frontend_graph_for_roots(request.plan.workspace.sources, request.plan.roots):
				Err(_):
					Err(AnalysisWorkerFailed(FRONTEND_GRAPH_FAILURE))
				Ok(frontend):
					if request.plan.targets.is_empty():
						Ok({
							workspace_revision = request.plan.workspace_revision,
							dependencies = frontend.dependencies,
							outcomes = [],
						})
					else:
						root ?= typecheck_root_for_frontend(
							frontend.graph,
							request.plan.roots,
						).to_result(AnalysisWorkerFailed(TYPECHECK_GRAPH_FAILURE))
						analysis_context ?= analysis_context_for_targets(request.plan.targets)
						module_targets: List[ResolvedModuleIdentity] = frontend_graph_modules(
							frontend.graph,
						)
							.map(func(module): module.identity)
							.filter(func(identity):
								not resolved_module_identities_equal(identity, root)
							)

						match typecheck_compiler_frontend_graph_with_context(
							frontend.graph,
							root,
							module_targets,
							False,
							False,
							analysis_context,
						):
							Err(_):
								Err(AnalysisWorkerFailed(TYPECHECK_GRAPH_FAILURE))
							Ok(graph):
								match analyze_targets(request, graph):
									Err(message):
										Err(AnalysisWorkerFailed(message))
									Ok(outcomes):
										Ok({
											workspace_revision = request.plan.workspace_revision,
											dependencies = frontend.dependencies,
											outcomes = outcomes,
										})
