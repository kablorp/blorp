-- Foreign blocks (`docs/DISCOVERY_REDESIGN.md`, section 3.6).
import:
	../tables/row_kinds: Purity, Visibility
	../tables/span: Span
	declarations: Annotation, Parameter
	ids: DefinitionId
	names: WrittenName
	types: WrittenType


---
A `foreign:` or `foreign(include: "x.h", ...):` block and its functions.
---
record ForeignBlock {
	arguments: List[ForeignArgument],
	functions: List[ForeignFunction],
	span: Span
}


---
`name: "value"`, such as `include: "x.h"`.
---
record ForeignArgument {
	name: WrittenName,
	value: String,
	span: Span
}


---
A foreign function: always a return type, and the C name when written
(`= "c_name"`). Made only by `minted_foreign_function`.
---
record ForeignFunction {
	id: DefinitionId,
	visibility: Visibility,
	annotations: List[Annotation],
	purity: Purity,
	keyword: Span,
	name: WrittenName,
	parameters: List[Parameter],
	return_type: WrittenType,
	c_name: Option[ForeignCName],
	span: Span
}


record ForeignCName {
	name: String,
	span: Span
}
