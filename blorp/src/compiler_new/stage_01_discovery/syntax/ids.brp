---
Builds a trait declaration over its already-minted `methods`.
---
pure func minted_trait(
	mint: IdMint,
	visibility: Visibility,
	documentation: Option[Documentation],
	name: WrittenName,
	type_parameters: List[TypeParameter],
	supertraits: List[TraitReference],
	methods: List[TraitMethod],
	span: Span,
) -> (IdMint, TraitDeclaration):
	state: MintState = from_opaque IdMint(mint)
	declaration: TraitDeclaration = {
		id = into_opaque DefinitionId(state.next_definition_index()),
		visibility = visibility,
		documentation = documentation,
		name = name,
		type_parameters = type_parameters,
		supertraits = supertraits,
		methods = methods,
		span = span
	}
	(state.with_definition(TraitDefinition(declaration)), declaration)


---
Builds an implementation over its already-minted `methods`.
---
pure func minted_implementation(
	mint: IdMint,
	visibility: Visibility,
	documentation: Option[Documentation],
	keyword: Span,
	trait_name: NameUse,
	receiver: WrittenType,
	methods: List[ImplementationMethod],
	span: Span,
) -> (IdMint, ImplementationDeclaration):
	state: MintState = from_opaque IdMint(mint)
	declaration: ImplementationDeclaration = {
		id = into_opaque DefinitionId(state.next_definition_index()),
		visibility = visibility,
		documentation = documentation,
		keyword = keyword,
		trait_name = trait_name,
		receiver = receiver,
		methods = methods,
		span = span
	}
	(state.with_definition(ImplementationDefinition(declaration)), declaration)
