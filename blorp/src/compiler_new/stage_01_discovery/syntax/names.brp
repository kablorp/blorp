-- Names in the syntax, by role (`docs/DISCOVERY_REDESIGN.md`, section 3.2).
--
-- A name is its module's `SpellingId` and the span the source wrote it at. Its
-- role is its type: a `NameUse` is decided by a later stage and has one outcome,
-- a `Binder` or `TypeBinder` declares, and a bare `WrittenName` is nobody's to
-- decide (a declared name, a module alias, a path part).
import:
	../tables/span: Span
	ids: BinderId, NameUseId, TypeBinderId, SpellingId


---
A name as the source wrote it: which spelling, and where.
---
record WrittenName {
	spelling: SpellingId,
	span: Span
}


---
A name whose meaning a later stage decides, with its own id so that stage
keeps exactly one outcome per use:
- by scope (resolution): a value, a type, a trait, a module qualifier, a
  constructor, a dimension variable, an imported item, a name that either
  binds or refers (an assignment target, a name pattern);
- by type (typecheck), after resolution records that it is not its own: the
  member after a dot, a field name in a record
  literal or update.

Made only by `minted_name_use`.
---
record NameUse {
	name: WrittenName,
	use: NameUseId
}


---
A name that introduces a local value: a variable, a parameter, a loop
variable, a lambda parameter, a `with`, `select` or `on` binder, a
destructured name, a list spread. Made only by `minted_binder`.
---
record Binder {
	name: WrittenName,
	binder: BinderId
}


---
A name that introduces a type or dimension parameter of a declaration. Made
only by `minted_type_binder`.
---
record TypeBinder {
	name: WrittenName,
	binder: TypeBinderId
}


---
A binding position that may discard: a name, or `_`.
---
union BindingTarget:
	BindsName(Binder)
	DiscardsValue(Span)
