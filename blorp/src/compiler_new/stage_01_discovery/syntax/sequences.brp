-- Sequences whose length the grammar bounds, as shapes, so that a reader never
-- meets the out-of-bound case (`docs/DISCOVERY_REDESIGN.md`, section 3.1).
---
Two to four items: a tuple's elements, items, element types, or the names
of a tuple binder or tuple destructuring.
---
union SmallTuple[T]:
	Pair(T, T)
	Triple(T, T, T)
	Quadruple(T, T, T, T)


---
At least one item.
---
record AtLeastOne[T] {
	first: T,
	rest: List[T]
}


---
At least two items.
---
record AtLeastTwo[T] {
	first: T,
	second: T,
	rest: List[T]
}


---
The items of `tuple` in order.
---
pure func small_tuple_items[T](tuple: SmallTuple[T]) -> List[T]:
	match tuple:
		Pair(first, second):
			[first, second]
		Triple(first, second, third):
			[first, second, third]
		Quadruple(first, second, third, fourth):
			[first, second, third, fourth]


---
The first item of `tuple`, which always exists.
---
pure func small_tuple_first[T](tuple: SmallTuple[T]) -> T:
	match tuple:
		Pair(first, _):
			first
		Triple(first, _, _):
			first
		Quadruple(first, _, _, _):
			first


---
The items of `items` in order.
---
pure func at_least_one_items[T](items: AtLeastOne[T]) -> List[T]:
	[items.first].concat(items.rest)


---
The items of `items` in order.
---
pure func at_least_two_items[T](items: AtLeastTwo[T]) -> List[T]:
	[items.first, items.second].concat(items.rest)
