-- The id census of one module's syntax (`docs/DISCOVERY_REDESIGN.md`, section
-- 4.6): every id the module issued is held exactly once in its tree.
--
-- The mint makes an id without a node impossible, but two things it cannot
-- rule out: a node dropped after it was built, and an id minted twice by a
-- stale or second mint (Blorp has no linear types). The census finds both. It
-- walks the tree, collects each family's ids, and requires exactly
-- `0 ..< count` of the module: a gap is an id issued and not held, a duplicate
-- an id held twice. It runs as a corpus test, and at link in debug builds.
--
-- The walk follows section 3.14: a left spine and an `else if` chain are
-- walked by loops.
import:
	../tables/ids: ModuleId, module_id_index
	declarations:
		DimensionConstraint,
		FieldDeclaration,
		Function,
		Parameter,
		ParameterBinding(NamedParameter, TupleParameter, WildcardParameter),
		Signature,
		TraitReference,
		TypeParameter(DimensionVariable, TypeVariable, WildcardDimensionParameter),
	expressions:
		AssignmentTarget(AssignsDiscard, AssignsName),
		Block,
		Body(BlockBody, ExpressionBody),
		CaseBody(CaseBlock, CaseStatement),
		ElseBody(ElseBlock, ElseIf),
		ElseBranch,
		Expression,
		ExpressionKind(
			Binary, BooleanLiteral, Break, Call, CharacterLiteral, CompilerBuiltin, ConcurrentBlock,
			Continue, DebugBlock, Detach, DictLiteral, FieldAccess, FloatLiteral, If,
			IntegerLiteral, InterpolatedString, Lambda, ListLiteral, Match, NameReference,
			OpaqueConversion, RangeExpression, RecordLiteral, RecordUpdate, Select, ShortCircuit,
			StringLiteral, Subscript, TupleLiteral, Unary, VectorLiteral, VoidValue, With,
		),
		IfExpression,
		InterpolationPiece(InterpolationHole, InterpolationText),
		LoopBinder(LoopTuple, LoopVariable),
		NamedValue,
		SelectArm,
		SelectArmKind(AfterArm, ReceiveArm, SealedArm),
		Statement,
		StatementKind(
			Assignment, CompoundAssignment, ConcurrentForLoop, ExpressionStatement, ForLoop,
			LocalFunctionStatement, QuestionBinding, SubscriptAssignment, TupleDestructure,
			TypedBinding, VariableDeclaration, WhileLoop,
		),
		TimeoutParameter,
		WithAcquisition(WithTry, WithValue),
		WithExpression,
	foreign_blocks: ForeignFunction
	ids:
		BlockId,
		DefinitionId,
		DimensionId,
		ExpressionId,
		ImportId,
		PatternId,
		StatementId,
		TypeBinderId,
		WrittenTypeId,
		binder_local_index,
		binder_module,
		block_local_index,
		block_module,
		definition_local_index,
		definition_module,
		dimension_local_index,
		dimension_module,
		expression_local_index,
		expression_module,
		import_local_index,
		import_module,
		name_use_local_index,
		name_use_module,
		pattern_local_index,
		pattern_module,
		statement_local_index,
		statement_module,
		type_binder_local_index,
		type_binder_module,
		written_type_local_index,
		written_type_module,
	imports: Import
	module_syntax:
		ModuleItem(
			AliasItem, BuiltinTypeItem, ForeignBlockItem, FunctionItem, GlobalItem,
			ImplementationItem, ImportBlockItem, RecordItem, ResourceTypeItem,
			TraitItem, UnionItem,
		),
		ModuleSyntax,
	names: Binder, BindingTarget(BindsName, DiscardsValue), NameUse
	patterns:
		Pattern,
		PatternKind(
			AlternativePatterns, BooleanPattern, CharacterPattern, ConstructorPattern, FloatPattern,
			IntegerPattern, ListPattern, NamePattern, QualifiedConstructorPattern, StringPattern,
			TuplePattern, WildcardPattern,
		),
	sequences: at_least_one_items, at_least_two_items, small_tuple_items
	types:
		Dimension,
		DimensionKind(
			DimensionArithmetic, LiteralDimension, NamedDimension, VariadicNamedDimension,
			VariadicWildcardDimension, WildcardDimension,
		),
		TypeArgument(BoundedArgument, DimensionArgument, TypeArgumentType),
		WrittenType,
		WrittenTypeKind(
			ArrayType, BoundedType, DimensionType, FunctionType, NamedType, QualifiedType, RangeType, TupleType,
			VoidType,
		),


---
The id families of section 3.3.
---
fixed union IdFamily:
	DefinitionIds
	ImportIds
	StatementIds
	BlockIds
	ExpressionIds
	PatternIds
	WrittenTypeIds
	DimensionIds
	NameUseIds
	BinderIds
	TypeBinderIds


---
Every family, in the order the census reports them.
---
ID_FAMILIES: List[IdFamily] = [
	DefinitionIds,
	ImportIds,
	StatementIds,
	BlockIds,
	ExpressionIds,
	PatternIds,
	WrittenTypeIds,
	DimensionIds,
	NameUseIds,
	BinderIds,
	TypeBinderIds,
]


---
A way the tree breaks the minting discipline. Each names the family and the
module-local index of the id.
---
union CensusProblem:
	IdHeldTwice(IdFamily, Int) -- a stale or second mint issued it again
	IdNotHeld(IdFamily, Int) -- issued, then the node was dropped
	IdNotIssued(IdFamily, Int) -- held, but at or past the module's count
	IdOfAnotherModule(IdFamily, ModuleId, Int) -- held, but minted for another module


---
One id the tree holds: its family, module and local index.
---
private record HeldId {
	family: IdFamily,
	module: ModuleId,
	index: Int
}


---
What breaks the minting discipline in `syntax`, the syntax of `module`: empty
when every family's ids are exactly `0 ..< count` of `module`, each held once.
Problems are reported family by family, in `ID_FAMILIES` order.
---
pure func id_census(module: ModuleId, syntax: ModuleSyntax) -> List[CensusProblem]:
	var problems: List[CensusProblem] = []
	held: List[HeldId] = held_in_module(syntax)

	for family in ID_FAMILIES:
		count: Int = issued_count(syntax, family)
		var times_held: List[Int] = 0.repeat(count)

		for id in held:
			if id.family == family:
				if id.module.module_id_index() != module.module_id_index():
					problems = problems.append(IdOfAnotherModule(family, id.module, id.index))
				else if id.index >= count:
					problems = problems.append(IdNotIssued(family, id.index))
				else:
					times_held = times_held.set(id.index, times_held.get_or(id.index, 0) + 1)

		for index in 0..count:
			times: Int = times_held.get_or(index, 0)

			if times == 0:
				problems = problems.append(IdNotHeld(family, index))
			else if times > 1:
				problems = problems.append(IdHeldTwice(family, index))

	problems


---
How many ids of `family` the module issued: an index's length for
definitions and imports, the counts for the rest.
---
private pure func issued_count(syntax: ModuleSyntax, family: IdFamily) -> Int:
	match family:
		DefinitionIds:
			syntax.definitions.length()
		ImportIds:
			syntax.imports.length()
		StatementIds:
			syntax.counts.statements
		BlockIds:
			syntax.counts.blocks
		ExpressionIds:
			syntax.counts.expressions
		PatternIds:
			syntax.counts.patterns
		WrittenTypeIds:
			syntax.counts.written_types
		DimensionIds:
			syntax.counts.dimensions
		NameUseIds:
			syntax.counts.name_uses
		BinderIds:
			syntax.counts.binders
		TypeBinderIds:
			syntax.counts.type_binders


-- One `HeldId` per id type.
private pure func held_definition(id: DefinitionId) -> HeldId:
	{
		family = DefinitionIds,
		module = id.definition_module(),
		index = id.definition_local_index()
	}


private pure func held_import(id: ImportId) -> HeldId:
	{
		family = ImportIds,
		module = id.import_module(),
		index = id.import_local_index()
	}


private pure func held_statement(id: StatementId) -> HeldId:
	{
		family = StatementIds,
		module = id.statement_module(),
		index = id.statement_local_index()
	}


private pure func held_block(id: BlockId) -> HeldId:
	{
		family = BlockIds,
		module = id.block_module(),
		index = id.block_local_index()
	}


private pure func held_expression(id: ExpressionId) -> HeldId:
	{
		family = ExpressionIds,
		module = id.expression_module(),
		index = id.expression_local_index()
	}


private pure func held_pattern(id: PatternId) -> HeldId:
	{
		family = PatternIds,
		module = id.pattern_module(),
		index = id.pattern_local_index()
	}


private pure func held_written_type(id: WrittenTypeId) -> HeldId:
	{
		family = WrittenTypeIds,
		module = id.written_type_module(),
		index = id.written_type_local_index()
	}


private pure func held_dimension(id: DimensionId) -> HeldId:
	{
		family = DimensionIds,
		module = id.dimension_module(),
		index = id.dimension_local_index()
	}


private pure func held_name_use(use: NameUse) -> HeldId:
	{
		family = NameUseIds,
		module = use.use.name_use_module(),
		index = use.use.name_use_local_index()
	}


private pure func held_binder(binder: Binder) -> HeldId:
	{
		family = BinderIds,
		module = binder.binder.binder_module(),
		index = binder.binder.binder_local_index()
	}


private pure func held_type_binder(binder: TypeBinderId) -> HeldId:
	{
		family = TypeBinderIds,
		module = binder.type_binder_module(),
		index = binder.type_binder_local_index()
	}


---
The ids the walk has met so far, in walk order. A record rather than a bare
list: the compiler hands an owned record on to the next helper and updates it
in place, where a list passed to a helper that appends to it is copied at
every call, which made the walk quadratic in the size of the module.
---
private record HeldIds {
	ids: List[HeldId]
}


-- Records `id` as held; the one place the walk grows `ids`, so it stays in place.
private pure func hold(held: HeldIds, id: HeldId) -> HeldIds:
	{ held | ids = held.ids.append(id) }


-- The walk: every id-bearing field of section 3.3, once.
private pure func held_in_module(syntax: ModuleSyntax) -> List[HeldId]:
	var held: HeldIds = { ids = [] }

	for item in syntax.items:
		held = held.held_in_item(item)

	held.ids


private pure func held_in_item(held: HeldIds, item: ModuleItem) -> HeldIds:
	match item:
		FunctionItem(declaration):
			held
				.hold(held_definition(declaration.id))
				.held_in_function(declaration.function)
		GlobalItem(declaration):
			held
				.hold(held_definition(declaration.id))
				.held_in_optional_type(declaration.declared_type)
				.held_in_expression(declaration.value)
		RecordItem(declaration):
			held
				.hold(held_definition(declaration.id))
				.held_in_type_parameters(declaration.type_parameters)
				.held_in_fields(declaration.fields)
		UnionItem(declaration):
			var with_variants: HeldIds = held
				.hold(held_definition(declaration.id))
				.held_in_type_parameters(declaration.type_parameters)

			for variant in declaration.variants:
				with_variants = with_variants
					.hold(held_definition(variant.id))
					.held_in_types(variant.payload)

			with_variants
		AliasItem(declaration):
			held
				.hold(held_definition(declaration.id))
				.held_in_type_parameters(declaration.type_parameters)
				.held_in_type(declaration.target)
		BuiltinTypeItem(declaration):
			held
				.hold(held_definition(declaration.id))
				.held_in_type_parameters(declaration.type_parameters)
		ResourceTypeItem(declaration):
			held
				.hold(held_definition(declaration.id))
				.held_in_type_parameters(declaration.type_parameters)
		TraitItem(declaration):
			var with_methods: HeldIds = held
				.hold(held_definition(declaration.id))
				.held_in_type_parameters(declaration.type_parameters)
				.held_in_trait_references(declaration.supertraits)

			for method in declaration.methods:
				with_methods = with_methods
					.hold(held_definition(method.id))
					.held_in_signature(method.signature)
					.held_in_optional_body(method.default_body)

			with_methods
		ImplementationItem(declaration):
			var with_methods: HeldIds = held
				.hold(held_definition(declaration.id))
				.hold(held_name_use(declaration.trait_name))
				.held_in_type(declaration.receiver)

			for method in declaration.methods:
				with_methods = with_methods
					.hold(held_definition(method.id))
					.held_in_function(method.function)

			with_methods
		ImportBlockItem(block):
			var with_imports: HeldIds = held

			for import_row in block.imports:
				with_imports = with_imports.held_in_import(import_row)

			with_imports
		ForeignBlockItem(block):
			var with_functions: HeldIds = held

			for function in block.functions:
				with_functions = with_functions.held_in_foreign_function(function)

			with_functions


private pure func held_in_import(held: HeldIds, import_row: Import) -> HeldIds:
	var with_items: HeldIds = held.hold(held_import(import_row.id))

	for item in import_row.items:
		with_items = with_items.hold(held_name_use(item.name))

		for constructor in item.constructors:
			with_items = with_items.hold(held_name_use(constructor))

	with_items


private pure func held_in_foreign_function(
	held: HeldIds,
	function: ForeignFunction,
) -> HeldIds:
	held
		.hold(held_definition(function.id))
		.held_in_parameters(function.parameters)
		.held_in_type(function.return_type)


private pure func held_in_fields(
	held: HeldIds,
	fields: List[FieldDeclaration],
) -> HeldIds:
	var with_fields: HeldIds = held

	for field in fields:
		with_fields = with_fields
			.hold(held_definition(field.id))
			.held_in_type(field.field_type)

	with_fields


private pure func held_in_function(held: HeldIds, function: Function) -> HeldIds:
	var with_constraints: HeldIds = held
		.held_in_signature(function.signature)
		.held_in_type_parameters(function.type_parameters)

	for constraint in function.constraints:
		with_constraints = with_constraints.held_in_constraint(constraint)

	with_constraints.held_in_optional_body(function.body)


private pure func held_in_signature(held: HeldIds, signature: Signature) -> HeldIds:
	held
		.held_in_parameters(signature.parameters)
		.held_in_optional_type(signature.return_type)


private pure func held_in_parameters(
	held: HeldIds,
	parameters: List[Parameter],
) -> HeldIds:
	var with_parameters: HeldIds = held

	for parameter in parameters:
		match parameter.binding:
			NamedParameter(binder):
				with_parameters = with_parameters.hold(held_binder(binder))
			WildcardParameter(_):
				with_parameters = with_parameters
			TupleParameter(tuple):
				for binder in tuple.names.small_tuple_items():
					with_parameters = with_parameters.hold(held_binder(binder))

		with_parameters = with_parameters.held_in_optional_type(parameter.declared_type)

	with_parameters


private pure func held_in_type_parameters(
	held: HeldIds,
	parameters: List[TypeParameter],
) -> HeldIds:
	var with_parameters: HeldIds = held

	for parameter in parameters:
		match parameter:
			TypeVariable(variable):
				with_parameters = with_parameters
					.hold(held_type_binder(variable.binder.binder))
					.held_in_trait_references(variable.bounds)
			DimensionVariable(binder):
				with_parameters = with_parameters.hold(held_type_binder(binder.binder))
			WildcardDimensionParameter(_):
				with_parameters = with_parameters

	with_parameters


private pure func held_in_trait_references(
	held: HeldIds,
	references: List[TraitReference],
) -> HeldIds:
	var with_references: HeldIds = held

	for reference in references:
		match reference.qualifier:
			Some(qualifier):
				with_references = with_references.hold(held_name_use(qualifier))
			None:
				with_references = with_references

		with_references = with_references.hold(held_name_use(reference.trait_name))

	with_references


private pure func held_in_constraint(
	held: HeldIds,
	constraint: DimensionConstraint,
) -> HeldIds:
	held
		.held_in_dimension(constraint.left)
		.held_in_dimension(constraint.right)


-- Written types and dimensions.
private pure func held_in_optional_type(
	held: HeldIds,
	written_type: Option[WrittenType],
) -> HeldIds:
	match written_type:
		Some(present):
			held.held_in_type(present)
		None:
			held


private pure func held_in_types(held: HeldIds, types: List[WrittenType]) -> HeldIds:
	var with_types: HeldIds = held

	for written_type in types:
		with_types = with_types.held_in_type(written_type)

	with_types


private pure func held_in_type(held: HeldIds, written_type: WrittenType) -> HeldIds:
	with_type: HeldIds = held.hold(held_written_type(written_type.id))

	match written_type.kind:
		NamedType(name, arguments):
			with_type
				.hold(held_name_use(name))
				.held_in_type_arguments(arguments)
		QualifiedType(qualifier, name, arguments):
			with_type
				.hold(held_name_use(qualifier))
				.hold(held_name_use(name))
				.held_in_type_arguments(arguments)
		VoidType:
			with_type
		TupleType(elements):
			with_type.held_in_type_arguments(elements.small_tuple_items())
		FunctionType(_, parameters, result):
			with_type
				.held_in_type_arguments(parameters)
				.held_in_type(result)
		ArrayType(element, dimensions):
			var with_dimensions: HeldIds = with_type.held_in_type(element)

			for dimension in dimensions.at_least_one_items():
				with_dimensions = with_dimensions.held_in_dimension(dimension)

			with_dimensions
		RangeType(bound):
			with_type.held_in_dimension(bound)
		DimensionType(dimension):
			with_type.held_in_dimension(dimension)
		BoundedType(bounded):
			with_type
				.hold(held_name_use(bounded.parameter))
				.held_in_trait_references(bounded.bounds.at_least_one_items())


private pure func held_in_type_arguments(
	held: HeldIds,
	arguments: List[TypeArgument],
) -> HeldIds:
	var with_arguments: HeldIds = held

	for argument in arguments:
		match argument:
			TypeArgumentType(written_type):
				with_arguments = with_arguments.held_in_type(written_type)
			DimensionArgument(dimension):
				with_arguments = with_arguments.held_in_dimension(dimension)
			BoundedArgument(bounded):
				with_arguments = with_arguments
					.hold(held_name_use(bounded.parameter))
					.held_in_trait_references(bounded.bounds.at_least_one_items())

	with_arguments


private pure func held_in_dimension(held: HeldIds, dimension: Dimension) -> HeldIds:
	with_dimension: HeldIds = held.hold(held_dimension(dimension.id))

	match dimension.kind:
		NamedDimension(name):
			with_dimension.hold(held_name_use(name))
		VariadicNamedDimension(name):
			with_dimension.hold(held_name_use(name))
		WildcardDimension:
			with_dimension
		VariadicWildcardDimension:
			with_dimension
		LiteralDimension(_):
			with_dimension
		DimensionArithmetic(_, left, right):
			with_dimension
				.held_in_dimension(left)
				.held_in_dimension(right)


-- Patterns.
private pure func held_in_target(held: HeldIds, target: BindingTarget) -> HeldIds:
	match target:
		BindsName(binder):
			held.hold(held_binder(binder))
		DiscardsValue(_):
			held


private pure func held_in_patterns(held: HeldIds, patterns: List[Pattern]) -> HeldIds:
	var with_patterns: HeldIds = held

	for pattern in patterns:
		with_patterns = with_patterns.held_in_pattern(pattern)

	with_patterns


private pure func held_in_pattern(held: HeldIds, pattern: Pattern) -> HeldIds:
	with_pattern: HeldIds = held.hold(held_pattern(pattern.id))

	match pattern.kind:
		WildcardPattern:
			with_pattern
		NamePattern(name):
			with_pattern.hold(held_name_use(name))
		IntegerPattern(_, _):
			with_pattern
		FloatPattern(_, _):
			with_pattern
		StringPattern(_, _):
			with_pattern
		CharacterPattern(_):
			with_pattern
		BooleanPattern(_):
			with_pattern
		ConstructorPattern(constructor, arguments):
			with_pattern
				.hold(held_name_use(constructor))
				.held_in_patterns(arguments)
		QualifiedConstructorPattern(qualifier, constructor, arguments):
			with_pattern
				.hold(held_name_use(qualifier))
				.hold(held_name_use(constructor))
				.held_in_patterns(arguments)
		TuplePattern(elements):
			with_pattern.held_in_patterns(elements.small_tuple_items())
		ListPattern(elements, spread):
			with_elements: HeldIds = with_pattern.held_in_patterns(elements)

			match spread:
				Some(written):
					with_elements.held_in_target(written.target)
				None:
					with_elements
		AlternativePatterns(alternatives):
			with_pattern.held_in_patterns(alternatives.at_least_two_items())


-- Bodies, blocks and statements.
private pure func held_in_optional_body(held: HeldIds, body: Option[Body]) -> HeldIds:
	match body:
		Some(present):
			held.held_in_body(present)
		None:
			held


private pure func held_in_body(held: HeldIds, body: Body) -> HeldIds:
	match body:
		BlockBody(block):
			held.held_in_block(block)
		ExpressionBody(expression):
			held.held_in_expression(expression)


private pure func held_in_block(held: HeldIds, block: Block) -> HeldIds:
	var with_statements: HeldIds = held.hold(held_block(block.id))

	for statement in block.leading:
		with_statements = with_statements.held_in_statement(statement)

	with_statements.held_in_statement(block.last)


private pure func held_in_statement(held: HeldIds, statement: Statement) -> HeldIds:
	with_statement: HeldIds = held.hold(held_statement(statement.id))

	match statement.kind:
		ExpressionStatement(expression):
			with_statement.held_in_expression(expression)
		VariableDeclaration(declaration):
			with_statement
				.held_in_target(declaration.target)
				.held_in_optional_type(declaration.declared_type)
				.held_in_expression(declaration.value)
		TypedBinding(binding):
			with_statement
				.held_in_target(binding.target)
				.held_in_type(binding.declared_type)
				.held_in_expression(binding.value)
		Assignment(assignment):
			with_target: HeldIds = match assignment.target:
				AssignsName(use):
					with_statement.hold(held_name_use(use))
				AssignsDiscard(_):
					with_statement

			with_target.held_in_expression(assignment.value)
		QuestionBinding(binding):
			with_statement
				.hold(held_binder(binding.binder))
				.held_in_optional_type(binding.declared_type)
				.held_in_expression(binding.value)
		CompoundAssignment(assignment):
			with_statement
				.hold(held_name_use(assignment.target))
				.held_in_expression(assignment.value)
		SubscriptAssignment(assignment):
			with_statement
				.hold(held_expression(assignment.place.id))
				.held_in_expression(assignment.place.collection)
				.held_in_expressions(assignment.place.indices.at_least_one_items())
				.held_in_expression(assignment.value)
		TupleDestructure(destructure):
			var with_targets: HeldIds = with_statement

			for target in destructure.targets.small_tuple_items():
				with_targets = with_targets.held_in_target(target)

			with_targets.held_in_expression(destructure.value)
		WhileLoop(loop):
			with_statement
				.held_in_expression(loop.condition)
				.held_in_block(loop.body)
		ForLoop(loop):
			var with_binder: HeldIds = with_statement

			match loop.binder:
				LoopVariable(target):
					with_binder = with_binder.held_in_target(target)
				LoopTuple(targets, _):
					for target in targets.small_tuple_items():
						with_binder = with_binder.held_in_target(target)

			with_binder
				.held_in_expression(loop.iterable)
				.held_in_block(loop.body)
		ConcurrentForLoop(loop):
			with_statement
				.held_in_target(loop.binder)
				.held_in_expression(loop.iterable)
				.held_in_timeout(loop.timeout)
				.held_in_block(loop.body)
		LocalFunctionStatement(function):
			with_statement
				.hold(held_definition(function.id))
				.held_in_function(function.function)


private pure func held_in_timeout(
	held: HeldIds,
	timeout: Option[TimeoutParameter],
) -> HeldIds:
	match timeout:
		Some(parameter):
			held.held_in_expression(parameter.value)
		None:
			held


-- Expressions.
private pure func held_in_expressions(
	held: HeldIds,
	expressions: List[Expression],
) -> HeldIds:
	var with_expressions: HeldIds = held

	for expression in expressions:
		with_expressions = with_expressions.held_in_expression(expression)

	with_expressions


private pure func held_in_named_values(
	held: HeldIds,
	values: List[NamedValue],
) -> HeldIds:
	var with_values: HeldIds = held

	for named in values:
		with_values = with_values
			.hold(held_name_use(named.name))
			.held_in_expression(named.value)

	with_values


---
An expression's ids. Its left spine (operands, callees, receivers, the
subscripted collection) is walked by the loop, not by recursion.
---
private pure func held_in_expression(held: HeldIds, expression: Expression) -> HeldIds:
	var with_expression: HeldIds = held
	var current: Expression = expression
	var on_spine: Bool = True

	while on_spine:
		with_expression = with_expression.hold(held_expression(current.id))

		match current.kind:
			Binary(_, left, right):
				with_expression = with_expression.held_in_expression(right)
				current = left
			ShortCircuit(_, left, right):
				with_expression = with_expression.held_in_expression(right)
				current = left
			Call(callee, arguments):
				with_expression = with_expression.held_in_expressions(arguments)
				current = callee
			FieldAccess(receiver, member):
				with_expression = with_expression.hold(held_name_use(member))
				current = receiver
			Subscript(collection, indices):
				with_expression = with_expression.held_in_expressions(indices.at_least_one_items())
				current = collection
			NameReference(use):
				with_expression = with_expression.hold(held_name_use(use))
				on_spine = False
			IntegerLiteral(_):
				on_spine = False
			FloatLiteral(_):
				on_spine = False
			StringLiteral(_, _):
				on_spine = False
			InterpolatedString(_, pieces):
				for piece in pieces:
					match piece:
						InterpolationText(_):
							with_expression = with_expression
						InterpolationHole(hole):
							with_expression = with_expression
								.hold(held_expression(hole.id))
								.held_in_expression(hole.value)

				on_spine = False
			BooleanLiteral(_):
				on_spine = False
			CharacterLiteral(_):
				on_spine = False
			VoidValue:
				on_spine = False
			CompilerBuiltin(_):
				on_spine = False
			Unary(_, operand):
				with_expression = with_expression.held_in_expression(operand)
				on_spine = False
			RangeExpression(start, end):
				with_expression = with_expression
					.held_in_expression(start)
					.held_in_expression(end)
				on_spine = False
			ListLiteral(elements):
				with_expression = with_expression.held_in_expressions(elements)
				on_spine = False
			TupleLiteral(elements):
				with_expression = with_expression.held_in_expressions(elements.small_tuple_items())
				on_spine = False
			VectorLiteral(elements):
				with_expression = with_expression.held_in_expressions(elements)
				on_spine = False
			RecordLiteral(fields):
				with_expression = with_expression.held_in_named_values(fields)
				on_spine = False
			RecordUpdate(base, fields):
				with_expression = with_expression
					.held_in_expression(base)
					.held_in_named_values(fields)
				on_spine = False
			DictLiteral(entries):
				for entry in entries:
					with_expression = with_expression
						.held_in_expression(entry.key)
						.held_in_expression(entry.value)

				on_spine = False
			OpaqueConversion(_, opaque_type, value):
				with_expression = with_expression
					.held_in_type(opaque_type)
					.held_in_expression(value)
				on_spine = False
			If(conditional):
				with_expression = with_expression.held_in_if(conditional)
				on_spine = False
			Match(subject, cases):
				with_expression = with_expression.held_in_expression(subject)

				for match_case in cases:
					with_expression = with_expression.held_in_pattern(match_case.pattern)

					match match_case.body:
						CaseBlock(block):
							with_expression = with_expression.held_in_block(block)
						CaseStatement(statement):
							with_expression = with_expression.held_in_statement(statement)

				on_spine = False
			Select(arms):
				with_expression = with_expression.held_in_select(arms)
				on_spine = False
			With(with_expression_form):
				with_expression = with_expression.held_in_with(with_expression_form)
				on_spine = False
			DebugBlock(block):
				with_expression = with_expression.held_in_block(block)
				on_spine = False
			Lambda(lambda):
				for parameter in lambda.parameters:
					with_expression = with_expression
						.held_in_target(parameter.target)
						.held_in_optional_type(parameter.declared_type)

				with_expression = with_expression
					.held_in_optional_type(lambda.return_type)
					.held_in_body(lambda.body)
				on_spine = False
			ConcurrentBlock(concurrent_block):
				with_expression = with_expression
					.held_in_timeout(concurrent_block.timeout)
					.held_in_block(concurrent_block.body)
				on_spine = False
			Detach(value):
				with_expression = with_expression.held_in_expression(value)
				on_spine = False
			Break:
				on_spine = False
			Continue:
				on_spine = False

	with_expression


---
A `select`'s arms, each its binder and channel (or timeout) then its block.
---
private pure func held_in_select(held: HeldIds, arms: List[SelectArm]) -> HeldIds:
	var with_arms: HeldIds = held

	for arm in arms:
		match arm.kind:
			ReceiveArm(target, channel):
				with_arms = with_arms
					.held_in_target(target)
					.held_in_expression(channel)
			SealedArm(channel):
				with_arms = with_arms.held_in_expression(channel)
			AfterArm(timeout):
				with_arms = with_arms.held_in_expression(timeout)

		with_arms = with_arms.held_in_block(arm.body)

	with_arms


---
A `with`'s binder, optional type and value, its `on` clause when it has
one, then its block.
---
private pure func held_in_with(held: HeldIds, with_expression_form: WithExpression) -> HeldIds:
	var with_acquisition: HeldIds = held

	match with_expression_form.acquisition:
		WithValue(binding):
			with_acquisition = with_acquisition
				.held_in_target(binding.target)
				.held_in_optional_type(binding.declared_type)
				.held_in_expression(binding.value)
		WithTry(binding):
			with_acquisition = with_acquisition
				.held_in_target(binding.target)
				.held_in_optional_type(binding.declared_type)
				.held_in_expression(binding.value)

			match binding.on_error:
				Some(error_map):
					with_acquisition = with_acquisition
						.held_in_target(error_map.target)
						.held_in_expression(error_map.value)
				None:
					with_acquisition = with_acquisition

	with_acquisition.held_in_block(with_expression_form.body)


---
An `if` and its `else` chain, each `else if` walked by the loop.
---
private pure func held_in_if(held: HeldIds, conditional: IfExpression) -> HeldIds:
	var with_branches: HeldIds = held
		.held_in_expression(conditional.condition)
		.held_in_block(conditional.then_block)
	var branch: Option[ElseBranch] = conditional.else_branch

	while branch.is_some():
		match branch:
			Some(written):
				match written.body:
					ElseBlock(block):
						with_branches = with_branches.held_in_block(block)
						branch = None
					ElseIf(else_if):
						with_branches = with_branches
							.hold(held_expression(else_if.id))
							.held_in_expression(else_if.conditional.condition)
							.held_in_block(else_if.conditional.then_block)
						branch = else_if.conditional.else_branch
			None:
				branch = None

	with_branches
