-- Written types and dimensions (`docs/DISCOVERY_REDESIGN.md`, section 3.9).
--
-- The parsing rules are today's (`parse/type_parser.brp`): `Name[#3]`, whose
-- arguments are all dimensions, is `ArrayType(NamedType(Name, []), [#3])`;
-- `(T)` is `T` itself; and an array suffix holding a non-dimension is
-- reported, so an accepted module's `ArrayType` holds only dimensions. A
-- dimension where a type is required is the type of a dimension value
-- (`DimensionType`). A bound inside a type is rejected except in an
-- `implements` receiver. `BoundedType` holds a grouped single receiver bound;
-- `BoundedArgument` holds the same payload in a receiver argument list.
import:
	../tables/row_kinds: Purity
	../tables/span: Span
	declarations: TraitReference
	ids: DimensionId, WrittenTypeId
	names: NameUse
	sequences: AtLeastOne, SmallTuple


---
A type as the source wrote it. Made only by `minted_written_type`.
---
record WrittenType {
	id: WrittenTypeId,
	span: Span,
	kind: WrittenTypeKind
}


union WrittenTypeKind:
	NamedType(NameUse, List[TypeArgument]) -- `Int`, `List[T]`, `Self`, `void`
	QualifiedType(NameUse, NameUse, List[TypeArgument]) -- `m.Type[T]`: qualifier, then type
	VoidType -- `()`
	TupleType(SmallTuple[TypeArgument]) -- `(A, B)`
	FunctionType(Purity, List[TypeArgument], WrittenType) -- `(A) -> R`, `pure (A) -> R`
	ArrayType(WrittenType, AtLeastOne[Dimension]) -- `Float[#3]`, `Int[#N, #M]`
	RangeType(Dimension) -- `..#N`
	DimensionType(Dimension) -- `rows: #N`, `-> #M`: the type of a dimension value
	BoundedType(BoundedTypeArgument) -- `(T: Eq)` in receiver context, including a receiver function result


---
One argument in brackets or parentheses: a type, a dimension, or, in an
`implements` receiver only, a bounded type parameter.
---
union TypeArgument:
	TypeArgumentType(WrittenType)
	DimensionArgument(Dimension)
	BoundedArgument(BoundedTypeArgument)


---
`T: Eq + Hash` in an `implements` receiver, either as a grouped single form
or inside its arguments (`implements Show for Box[T: Eq]`): the type
parameter that impl introduces, with its bounds.
---
record BoundedTypeArgument {
	parameter: NameUse,
	bounds: AtLeastOne[TraitReference],
	span: Span
}


---
A dimension as the source wrote it. Made only by `minted_dimension`.
---
record Dimension {
	id: DimensionId,
	span: Span,
	kind: DimensionKind
}


union DimensionKind:
	NamedDimension(NameUse) -- `#N`; the spelling is `N`
	VariadicNamedDimension(NameUse) -- `#Ds...`
	WildcardDimension -- `#_`
	VariadicWildcardDimension -- `#_...`
	LiteralDimension(Int128) -- `#3`, or `3` inside dimension arithmetic
	DimensionArithmetic(DimensionOperator, Dimension, Dimension)


enum DimensionOperator:
	AddDimensions
	SubtractDimensions
	MultiplyDimensions
	DivideDimensions
