-- Syntax diagnostics refer to this module's spellings and syntax identities.
-- The argument-free vocabulary remains shared with the temporary table parser.
import:
	../tables/diagnostic_code: PlainSyntaxCode
	../tables/expected_token: ExpectedTokenDiagnostic
	../tables/span: Span
	ids: SpellingId, DefinitionId


union SyntaxDiagnostic:
	Plain(PlainSyntaxCode)
	ExpectedToken(ExpectedTokenDiagnostic)
	UnknownEscape(Char)
	IntegerLiteralOverflow(String)
	FloatLiteralOverflow(String)
	UnexpectedByte(Char)
	ReservedKeywordAsName(SpellingId)
	UnknownAnnotation(SpellingId)
	ConcurrentDuplicateParameter(SpellingId)
	ConcurrentUnknownParameter(SpellingId)
	ConcurrentForUnknownParameter(SpellingId)
	DuplicateField(DefinitionId)
	DuplicateFieldGiven(Span)


record SyntaxDiagnosticAt {
	span: Span,
	diagnostic: SyntaxDiagnostic
}
