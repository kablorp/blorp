-- Lines and columns of source offsets.
--
-- Spans store byte offsets only. Layout-sensitive parsing (a block belongs to
-- the header it is indented past) and the line tests of postfix
-- continuations need a token's line and column, which are computed here from
-- the admitted line starts and the source text.
import:
	discovery_builder: DiscoveryBuilder, SourceRow
	span: Span, span_end, span_source_index, span_start


---
Columns a tab advances to the next multiple of, as in the existing compiler.
---
TAB_WIDTH: Int = 4


---
Columns from `column` to the next tab stop.
---
pure func tab_advance(column: Int) -> Int:
	TAB_WIDTH - (column - 1) % TAB_WIDTH


---
The one-based, tab-expanded column of `offset` on the line starting at
`line_start`.
---
pure func column_at(text: String, line_start: Int, offset: Int) -> Int:
	var column: Int = 1
	var position: Int = line_start

	while position < offset:
		if text.get_or(position, ' ') == '\t':
			column += tab_advance(column)
		else:
			column += 1

		position += 1

	column


---
A line and a one-based, tab-expanded column; `line` is the index of the
line within its source.
---
struct LineColumn {
	line: Int,
	column: Int
}


---
The index of the line of source `source_index` that holds `offset`: a binary
search of the source's line starts.
---
pure func line_of_offset(builder: DiscoveryBuilder, source_index: Int, offset: Int) -> Int:
	match builder.sources.get(source_index):
		Some(source):
			builder.line_in_source(source, offset)
		None:
			0


private pure func line_in_source(builder: DiscoveryBuilder, source: SourceRow, offset: Int) -> Int:
	var lower: Int = 0
	var upper: Int = source.line_starts.count

	-- The last line whose start is at or before `offset`.
	while upper - lower > 1:
		middle: Int = (lower + upper) / 2

		if builder.line_starts.get_or(source.line_starts.first + middle, 0) <= offset:
			lower = middle
		else:
			upper = middle

	lower


---
The line and column of `offset` in source `source_index`.
---
pure func line_column_of_offset(
	builder: DiscoveryBuilder,
	source_index: Int,
	offset: Int,
) -> LineColumn:
	match builder.sources.get(source_index):
		Some(source):
			line: Int = builder.line_in_source(source, offset)
			line_start: Int = builder.line_starts.get_or(source.line_starts.first + line, 0)
			text: String = builder.source_texts
				.get(source_index)
				.get_or("")
			{
				line = line,
				column = column_at(text, line_start, offset)
			}
		None:
			{
				line = 0,
				column = 1
			}


---
The line and column where `span` starts.
---
pure func span_start_position(builder: DiscoveryBuilder, span: Span) -> LineColumn:
	builder.line_column_of_offset(span.span_source_index(), span.span_start())


---
The line holding the last byte of `span` (its start when it is empty).
---
pure func span_end_line(builder: DiscoveryBuilder, span: Span) -> Int:
	last: Int = if span.span_end() > span.span_start():
		span.span_end() - 1
	else:
		span.span_start()

	builder.line_of_offset(span.span_source_index(), last)


pure func span_start_line(builder: DiscoveryBuilder, span: Span) -> Int:
	builder.line_of_offset(span.span_source_index(), span.span_start())
