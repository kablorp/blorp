-- The module walker: discovery's only loop over modules.
--
-- Roots are loaded in the order given, then every import in the order its
-- module was loaded and, within a module, in source order (breadth first).
-- A module is loaded once per canonical path, whichever request reaches it
-- first, so ids depend only on the roots and the sources, never on the order
-- in which a provider happens to answer. An import that resolves to no source
-- is recorded as a diagnostic row and discovery goes on.
import:
	declaration_parser: parse_module_declarations
	discovery_builder:
		DiscoveryBuilder,
		ImportId,
		ImportRow,
		ModuleId,
		ModuleRow,
		NameId,
		PackageId,
		PathId,
		RootId,
		SourceId,
		append_diagnostic_argument,
		append_import_target,
		append_module,
		append_module_package,
		append_name,
		append_package,
		append_plain_resolution_diagnostic,
		append_resolution_diagnostic,
		append_resolution_diagnostic_with_argument,
		append_root,
		append_root_diagnostic,
		append_root_target,
		empty_discovery_builder,
		find_module_by_path,
		find_name_id,
		find_path_id,
		import_id_at_row,
		import_id_index,
		module_id_at_row,
		module_id_index,
		name_id_index,
		next_diagnostic_argument_row,
		next_module_id,
		next_name_id,
		next_package_id,
		next_root_id,
		next_source_id,
		package_id_at_row,
		path_id_index,
		replace_module_row,
	discovery_diagnostic_code:
		DiscoveryDiagnosticCode(
			ImportCaseMismatchDiagnostic,
			RootCaseMismatchDiagnostic,
			SourceTooLargeDiagnostic,
			TooManySourcesDiagnostic,
			UnreadableSourceDiagnostic,
			UnverifiableSpellingDiagnostic,
			UnresolvedImportDiagnostic,
			UnresolvedRootDiagnostic,
		),
	frontend_tables: FreezeOutcome, freeze
	fs:
		DirectoryListing,
		PathSpelling(ExactSpelling, SpellingUnverifiable, StoredSpelling),
		SpellingStep(SpellingKnown, SpellingNeedsListing),
		spelling_below,
	lexer: lex_source
	path: normalize
	row_kinds: ModuleReach(ImportedModule, RootModule), PackageKind(NativePackage)
	source_admission:
		SourceRejection(SourceTooLargeToSpan, TooManySourcesToSpan),
		admit_source,
		intern_path,
		interned_path_id,
		source_rejection,
	source_provider:
		ImportRequest,
		ImportRequester,
		PackageMembership(InNativePackage, NotInPackage),
		SourceCandidate,
		SourceLookupRoots,
		SourceProvider,
		SourceRead(SourceText, SourceUnreadable),
		directory_listing,
		import_candidates,
		read_source,
		root_candidate,
		source_exists,
	span: Span, pack_span


---
An import waiting to be resolved, with the facts of the module it came
from.
---
private record PendingImport {
	import_id: ImportId,
	request: ImportRequest
}


---
Where a module came from, for its module row and for resolving its imports.
---
private record LoadedModuleFacts {
	candidate: SourceCandidate,
	reach: ModuleReach
}


---
Discovers every module reachable from `roots` (source paths) through
`provider`, then freezes the tables. Directory listings the spelling checks
need are read through the provider once each and kept for the whole walk.
---
func discover[Provider:SourceProvider](
	provider: Provider,
	lookup: SourceLookupRoots,
	roots: List[String],
) -> FreezeOutcome:
	var listings: Dict[String, DirectoryListing] = {}
	var builder: DiscoveryBuilder = empty_discovery_builder()
	var pending: List[PendingImport] = []

	for root_path in roots:
		root: RootId = builder.next_root_id()
		candidate: SourceCandidate = root_candidate(root_path)
		request_path: PathId = builder.interned_path_id(root_path)
		builder = builder.intern_path(root_path)
		builder = builder.append_root({request_path = request_path})

		var root_lookup: CandidateLookup = CandidateFound(candidate)

		if (
			builder
				.loaded_module_at(candidate.path)
				.is_none()
		):
			(listed, looked_up) = look_up_candidates(provider, listings, [candidate])
			listings = listed
			root_lookup = looked_up

		match root_lookup:
			CandidateFound(found):
				modules_before: Int = builder.modules.length()
				builder = load_or_reuse(provider, builder, found, RootModule, RequestedByRoot(root))
				pending = pending.concat(builder.newly_loaded_imports(modules_before, found))
			CandidateSpelledDifferently(stored_names):
				builder = builder.report_root_case_mismatch(root, stored_names)
			CandidateSpellingUnverifiable:
				builder = builder.report_root(root, UnverifiableSpellingDiagnostic)
			CandidateNotFound:
				builder = builder.report_root(root, UnresolvedRootDiagnostic)

	var next_pending: Int = 0

	while next_pending < pending.length():
		match pending.get(next_pending):
			Some(entry):
				(listed, looked_up) = look_up_candidates(
					provider,
					listings,
					lookup.import_candidates(entry.request),
				)
				listings = listed

				match looked_up:
					CandidateFound(candidate):
						modules_before: Int = builder.modules.length()
						builder = load_or_reuse(
							provider,
							builder,
							candidate,
							ImportedModule,
							RequestedByImport(entry.import_id),
						)
						pending = pending.concat(
							builder.newly_loaded_imports(
								modules_before,
								candidate,
							),
						)
					CandidateSpelledDifferently(stored_names):
						builder = builder.report_import_case_mismatch(entry.import_id, stored_names)
					CandidateSpellingUnverifiable:
						builder = builder.report_import(
							entry.import_id,
							UnverifiableSpellingDiagnostic,
						)
					CandidateNotFound:
						builder = builder.report_import(entry.import_id, UnresolvedImportDiagnostic)
			None:
				void

		next_pending += 1

	builder.freeze()


---
What asked for a module: a root or an import. Its target or diagnostic
row is recorded against it.
---
private union ModuleRequester:
	RequestedByRoot(RootId)
	RequestedByImport(ImportId)


---
Loads `candidate` for `requester` unless a module was already loaded from
its path, and records the module as the requester's target; a source that
cannot be read or admitted is reported against the requester instead.
---
private func load_or_reuse[Provider:SourceProvider](
	provider: Provider,
	builder: DiscoveryBuilder,
	candidate: SourceCandidate,
	reach: ModuleReach,
	requester: ModuleRequester,
) -> DiscoveryBuilder:
	match builder.loaded_module_at(candidate.path):
		Some(module):
			builder.record_target(requester, module)
		None:
			match provider.read_source(candidate.path):
				SourceText(text):
					match builder.source_rejection(text.length()):
						Some(rejection):
							builder.report_rejected(requester, rejection, text.length())
						None:
							module: ModuleId = builder.next_module_id()
							loaded: DiscoveryBuilder = builder.load_module(candidate, reach, text)
							loaded.record_target(requester, module)
				SourceUnreadable:
					builder.report_requester(requester, UnreadableSourceDiagnostic)


---
The import requests of the module `load_or_reuse` loaded, if it loaded one
(the module count grew past `modules_before`).
---
private pure func newly_loaded_imports(
	builder: DiscoveryBuilder,
	modules_before: Int,
	candidate: SourceCandidate,
) -> List[PendingImport]:
	if builder.modules.length() > modules_before:
		builder.module_import_requests(module_id_at_row(modules_before), candidate)
	else:
		[]


private pure func record_target(
	builder: DiscoveryBuilder,
	requester: ModuleRequester,
	module: ModuleId,
) -> DiscoveryBuilder:
	match requester:
		RequestedByRoot(root):
			builder.append_root_target({
				root = root,
				target = module,
			})
		RequestedByImport(import_id):
			builder.append_import_target({
				owner_import = import_id,
				target = module,
			})


private pure func report_requester(
	builder: DiscoveryBuilder,
	requester: ModuleRequester,
	code: DiscoveryDiagnosticCode,
) -> DiscoveryBuilder:
	match requester:
		RequestedByRoot(root):
			builder.report_root(root, code)
		RequestedByImport(import_id):
			builder.report_import(import_id, code)


private pure func report_rejected(
	builder: DiscoveryBuilder,
	requester: ModuleRequester,
	rejection: SourceRejection,
	byte_length: Int,
) -> DiscoveryBuilder:
	match requester:
		RequestedByRoot(root):
			builder.report_rejected_root(root, rejection, byte_length)
		RequestedByImport(import_id):
			builder.report_rejected_import(import_id, rejection, byte_length)


---
The module already loaded from `path`, if any.
---
private pure func loaded_module_at(builder: DiscoveryBuilder, path: String) -> Option[ModuleId]:
	match builder.find_path_id(path):
		Some(path_id):
			builder.find_module_by_path(path_id)
		None:
			None


---
What looking a request's candidates up found.

- `CandidateFound(candidate)`: the first candidate, in lookup order, that exists
  with no component below its trusted directory known to be stored in
  different letter case.
- `CandidateSpelledDifferently(names)`: no candidate exists exactly, but the
  first candidate with a source under different letter case is stored as
  `names` (the components below its trusted directory).
- `CandidateSpellingUnverifiable`: a candidate exists but a directory on the way
  to it could not be listed, so its spelling is unknown; discovery says so
  rather than guess.
- `CandidateNotFound`: no candidate exists under any spelling.
---
private union CandidateLookup:
	CandidateFound(SourceCandidate)
	CandidateSpelledDifferently(List[String])
	CandidateSpellingUnverifiable
	CandidateNotFound


---
The spelling of `candidate`'s path below its trusted directory, listing each
directory the check needs that `listings` does not hold yet. Returns the
listings to keep.
---
private func candidate_spelling[Provider:SourceProvider](
	provider: Provider,
	listings: Dict[String, DirectoryListing],
	candidate: SourceCandidate,
) -> (Dict[String, DirectoryListing], PathSpelling):
	var kept: Dict[String, DirectoryListing] = listings
	var spelling: Option[PathSpelling] = None

	while spelling.is_none():
		match spelling_below(kept, candidate.trusted_directory, candidate.path):
			SpellingKnown(known):
				spelling = Some(known)
			SpellingNeedsListing(directory):
				kept = kept.set(
					directory,
					provider.directory_listing(directory),
				)

	(kept, spelling.get_or(ExactSpelling))


---
Looks `candidates` up in `provider`. Near misses are only searched for once
every candidate has failed, so a request that resolves never pays for the
search (and a missing candidate is never listed for).
---
private func look_up_candidates[Provider:SourceProvider](
	provider: Provider,
	listings: Dict[String, DirectoryListing],
	candidates: List[SourceCandidate],
) -> (Dict[String, DirectoryListing], CandidateLookup):
	var kept: Dict[String, DirectoryListing] = listings
	var found: CandidateLookup = CandidateNotFound

	for candidate in candidates:
		if provider.source_exists(candidate.path):
			(listed, spelling) = candidate_spelling(provider, kept, candidate)
			kept = listed

			match spelling:
				ExactSpelling:
					found = CandidateFound(candidate)
					break
				SpellingUnverifiable(_):
					found = CandidateSpellingUnverifiable
					break
				StoredSpelling(_, _):
					void

	match found:
		CandidateNotFound:
			for candidate in candidates:
				(listed, spelling) = candidate_spelling(provider, kept, candidate)
				kept = listed

				match spelling:
					StoredSpelling(stored_names, stored_path):
						if provider.source_exists(normalize(stored_path)):
							found = CandidateSpelledDifferently(stored_names)
							break
					_:
						void
		_:
			void

	(kept, found)


---
Admits `text` as a new module at `candidate`, lexes it and parses it, and
closes its row's ranges over the rows its parse appended.
---
pure func load_module(
	builder: DiscoveryBuilder,
	candidate: SourceCandidate,
	reach: ModuleReach,
	text: String,
) -> DiscoveryBuilder:
	module: ModuleId = builder.next_module_id()
	source: SourceId = builder.next_source_id()
	canonical_path: PathId = builder.interned_path_id(candidate.path)
	definitions_first: Int = builder.definitions.length()
	imports_first: Int = builder.imports.length()
	nodes_first: Int = builder.nodes.length()
	diagnostics_first: Int = builder.diagnostics.length()
	var out: DiscoveryBuilder = builder.admit_source(candidate.path, text)
	open_row: ModuleRow = {
		source = source,
		canonical_path = canonical_path,
		origin = candidate.origin,
		reach = reach,
		definitions = {
			first = definitions_first,
			count = 0
		},
		imports = {
			first = imports_first,
			count = 0
		},
		nodes = {
			first = nodes_first,
			count = 0
		},
		diagnostics = {
			first = diagnostics_first,
			count = 0
		}
	}
	out = out.append_module(open_row)
	out = out.record_module_package(module, candidate.package)
	out = out.lex_source(source)
	out = out.parse_module_declarations(module)
	definitions_end: Int = out.definitions.length()
	imports_end: Int = out.imports.length()
	nodes_end: Int = out.nodes.length()
	diagnostics_end: Int = out.diagnostics.length()
	closed_row: ModuleRow = { open_row |
		definitions = {
			first = definitions_first,
			count = definitions_end - definitions_first
		},
		imports = {
			first = imports_first,
			count = imports_end - imports_first
		},
		nodes = {
			first = nodes_first,
			count = nodes_end - nodes_first
		},
		diagnostics = {
			first = diagnostics_first,
			count = diagnostics_end - diagnostics_first
		}
	}
	out = out.replace_module_row(module, closed_row)
	out


---
Records `module`'s package, adding the package row the first time a module
of that package is loaded.
---
private pure func record_module_package(
	builder: DiscoveryBuilder,
	module: ModuleId,
	package: PackageMembership,
) -> DiscoveryBuilder:
	match package:
		InNativePackage(name):
			builder.record_native_module_package(module, name)
		NotInPackage:
			builder


---
Records that `module` belongs to the native package `name`. Each step is a
helper that returns its builder unchanged when there is nothing to add
(builder threading rule 1).
---
private pure func record_native_module_package(
	builder: DiscoveryBuilder,
	module: ModuleId,
	name: String,
) -> DiscoveryBuilder:
	package: PackageId = match builder.existing_package(name):
		Some(existing):
			existing
		None:
			builder.next_package_id()

	with_package: DiscoveryBuilder = builder.ensure_native_package(name)
	with_package.append_module_package({
		module = module,
		package = package,
	})


---
Adds the package row for `name` unless one exists.
---
private pure func ensure_native_package(
	builder: DiscoveryBuilder,
	name: String,
) -> DiscoveryBuilder:
	if (
		builder
			.existing_package(name)
			.is_some()
	):
		builder
	else:
		package_name: NameId = match builder.find_name_id(name):
			Some(existing_name):
				existing_name
			None:
				builder.next_name_id()

		with_name: DiscoveryBuilder = builder.ensure_name(name)
		with_name.append_package({
			name = package_name,
			kind = NativePackage,
		})


---
Interns `name` unless it is already interned.
---
private pure func ensure_name(builder: DiscoveryBuilder, name: String) -> DiscoveryBuilder:
	if (
		builder
			.find_name_id(name)
			.is_some()
	):
		builder
	else:
		builder.append_name(name)


---
The package already recorded under `name`, if any.
---
private pure func existing_package(builder: DiscoveryBuilder, name: String) -> Option[PackageId]:
	var found: Option[PackageId] = None
	var row: Int = 0

	for package in builder.packages:
		if builder.name_spellings.get(package.name.name_id_index()) == Some(name):
			found = Some(package_id_at_row(row))
			break

		row += 1

	found


---
The import requests of `module`'s import rows, in source order.
---
private pure func module_import_requests(
	builder: DiscoveryBuilder,
	module: ModuleId,
	candidate: SourceCandidate,
) -> List[PendingImport]:
	var requests: List[PendingImport] = []

	match builder.modules.get(module.module_id_index()):
		Some(module_row):
			requester: ImportRequester = {
				canonical_path = candidate.path,
				origin = candidate.origin,
				package = candidate.package
			}

			for index in module_row.imports.first..module_row.imports.first + module_row.imports.count:
				match builder.imports.get(index):
					Some(import_row):
						requests = requests.append({
							import_id = import_id_at_row(index),
							request = {
								kind = import_row.request_kind,
								text = builder.paths
									.get(import_row.request_path.path_id_index())
									.get_or(""),
								parts = builder.import_path_part_spellings(import_row),
								requester = requester
							},
						})
					None:
						void
		None:
			void

	requests


private pure func import_path_part_spellings(
	builder: DiscoveryBuilder,
	import_row: ImportRow,
) -> List[String]:
	var parts: List[String] = []

	for index in import_row.path_parts.first..import_row.path_parts.first + import_row.path_parts.count:
		match builder.import_path_parts.get(index):
			Some(part):
				parts = parts.append(
					builder.name_spellings
						.get(part.name_id_index())
						.get_or(""),
				)
			None:
				void

	parts


-- Diagnostics.
private pure func import_span(builder: DiscoveryBuilder, import_id: ImportId) -> Span:
	match builder.imports.get(import_id.import_id_index()):
		Some(import_row):
			import_row.span
		None:
			pack_span(0, 0, 0)


---
Reports that `import_id` loaded no module, with its id as the argument.
---
private pure func report_import(
	builder: DiscoveryBuilder,
	import_id: ImportId,
	code: DiscoveryDiagnosticCode,
) -> DiscoveryBuilder:
	span: Span = builder.import_span(import_id)
	builder.append_resolution_diagnostic_with_argument(code, span, import_id.import_id_index())


---
Reports that `import_id` names a module stored under different letter case:
its id, then the interned stored spelling (its names joined by `/`).
---
private pure func report_import_case_mismatch(
	builder: DiscoveryBuilder,
	import_id: ImportId,
	stored_names: List[String],
) -> DiscoveryBuilder:
	stored_path: String = stored_names.join("/")
	stored_path_id: PathId = builder.interned_path_id(stored_path)
	span: Span = builder.import_span(import_id)
	arguments_first: Int = builder.next_diagnostic_argument_row()
	var out: DiscoveryBuilder = builder.intern_path(stored_path)
	out = out.append_diagnostic_argument(import_id.import_id_index())
	out = out.append_diagnostic_argument(stored_path_id.path_id_index())
	out.append_resolution_diagnostic({
		code = ImportCaseMismatchDiagnostic,
		span = span,
		arguments = {
			first = arguments_first,
			count = 2
		},
	})


private pure func report_rejected_import(
	builder: DiscoveryBuilder,
	import_id: ImportId,
	rejection: SourceRejection,
	byte_length: Int,
) -> DiscoveryBuilder:
	span: Span = builder.import_span(import_id)

	match rejection:
		SourceTooLargeToSpan:
			builder.append_resolution_diagnostic_with_argument(
				SourceTooLargeDiagnostic,
				span,
				byte_length,
			)
		TooManySourcesToSpan:
			builder.append_plain_resolution_diagnostic(TooManySourcesDiagnostic, span)


private pure func report_root(
	builder: DiscoveryBuilder,
	root: RootId,
	code: DiscoveryDiagnosticCode,
) -> DiscoveryBuilder:
	arguments_first: Int = builder.next_diagnostic_argument_row()
	builder.append_root_diagnostic({
		root = root,
		code = code,
		arguments = {
			first = arguments_first,
			count = 0
		},
	})


---
Reports that `root` names a source stored under different letter case, with
the interned stored spelling as the argument.
---
private pure func report_root_case_mismatch(
	builder: DiscoveryBuilder,
	root: RootId,
	stored_names: List[String],
) -> DiscoveryBuilder:
	stored_path: String = stored_names.join("/")
	stored_path_id: PathId = builder.interned_path_id(stored_path)
	arguments_first: Int = builder.next_diagnostic_argument_row()
	var out: DiscoveryBuilder = builder.intern_path(stored_path)
	out = out.append_diagnostic_argument(stored_path_id.path_id_index())
	out.append_root_diagnostic({
		root = root,
		code = RootCaseMismatchDiagnostic,
		arguments = {
			first = arguments_first,
			count = 1
		},
	})


private pure func report_rejected_root(
	builder: DiscoveryBuilder,
	root: RootId,
	rejection: SourceRejection,
	byte_length: Int,
) -> DiscoveryBuilder:
	match rejection:
		SourceTooLargeToSpan:
			arguments_first: Int = builder.next_diagnostic_argument_row()
			var out: DiscoveryBuilder = builder.append_diagnostic_argument(byte_length)
			out = out.append_root_diagnostic({
				root = root,
				code = SourceTooLargeDiagnostic,
				arguments = {
					first = arguments_first,
					count = 1
				},
			})
			out
		TooManySourcesToSpan:
			builder.report_root(root, TooManySourcesDiagnostic)
