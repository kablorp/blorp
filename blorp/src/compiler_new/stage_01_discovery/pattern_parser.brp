-- Match patterns, parsed into the node table.
--
-- Patterns are appended post-order like every node: each routine appends its
-- root last. A routine collecting a variable number of child patterns pushes
-- each child's root on the builder's child stack and claims them with
-- `append_parent_node_from_stack`; the number of children is the stack depth
-- gained. Shapes, recovery and accepted forms follow the existing parser.
import:
	discovery_builder:
		DiscoveryBuilder,
		NameId,
		advance_token,
		append_codepoint_leaf_node,
		append_leaf_node,
		append_literal_leaf_node,
		append_name_leaf_node,
		append_named_parent_node_from_stack,
		append_parent_node_from_stack,
		append_plain_diagnostic,
		child_stack_depth,
		last_node_id,
		literal_id_at_row,
		name_id_at_row,
		push_last_node,
	discovery_diagnostic_code:
		DiscoveryDiagnosticCode(
			ExpectedCommaDiagnostic,
			InterpolatedStringPatternDiagnostic,
			ExpectedNumberAfterMinusDiagnostic,
			ExpectedPatternDiagnostic,
			ExpectedRightBracketDiagnostic,
			ExpectedRightParenDiagnostic,
			ExpectedSpreadTargetDiagnostic,
			ReservedKeywordAsNameDiagnostic,
			TupleArityDiagnostic,
		),
	parser_cursor:
		at,
		consume_referenced_name,
		current_name,
		current_span,
		current_token,
		expect_token,
		keyword_name_index,
		peek_kind,
		referenced_name_at_cursor,
		report_and_recover,
		report_at_current,
	row_kinds:
		NodeKind(
			CharPatternNode,
			ConstructorPatternNode,
			FalsePatternNode,
			FloatPatternNode,
			IntegerPatternNode,
			ListPatternNode,
			ListSpreadNameNode,
			ListSpreadWildcardNode,
			MissingPatternNode,
			NamePatternNode,
			NegativeFloatPatternNode,
			NegativeIntegerPatternNode,
			OrPatternNode,
			PatternQualifierNode,
			QualifiedConstructorPatternNode,
			StringPatternNode,
			TruePatternNode,
			TuplePatternNode,
			WildcardPatternNode,
		),
	span: Span, span_covering
	token:
		Token,
		TokenKind(
			CharLiteralToken,
			CommaSymbol,
			DotDotDotSymbol,
			DotSymbol,
			EndOfFileToken,
			FalseKeyword,
			FloatLiteralToken,
			IdentifierToken,
			InterpolatedPipeStringToken,
			InterpolatedStringToken,
			IntLiteralToken,
			LeftBracketSymbol,
			LeftParenSymbol,
			MinusSymbol,
			NormalStringToken,
			PipeStringToken,
			PipeSymbol,
			RawPipeStringToken,
			RawStringToken,
			RightBracketSymbol,
			RightParenSymbol,
			TrueKeyword,
			UnderscoreSymbol,
		),
	type_parser: node_span


---
The fewest and most elements a tuple pattern may have.
---
private MIN_TUPLE_PATTERN_ITEMS: Int = 2

private MAX_TUPLE_PATTERN_ITEMS: Int = 4


---
A pattern: a simple pattern, or simple patterns separated by `|`.
---
pure func parse_pattern(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = parse_simple_pattern(builder)

	if at(out, PipeSymbol):
		out = parse_or_pattern_alternatives(out)

	out


---
The alternatives after the first of an or-pattern, which the caller parsed.
---
private pure func parse_or_pattern_alternatives(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	first_span: Span = node_span(builder, last_node_id(builder))
	depth_before: Int = child_stack_depth(builder)
	var out: DiscoveryBuilder = push_last_node(builder)
	var end: Span = first_span

	while at(out, PipeSymbol) and not at(out, EndOfFileToken):
		out = advance_token(out)
		out = parse_simple_pattern(out)
		end = node_span(out, last_node_id(out))
		out = push_last_node(out)

	count: Int = child_stack_depth(out) - depth_before
	out = append_parent_node_from_stack(
		out,
		OrPatternNode,
		span_covering(first_span, end),
		count,
	)
	out


---
A pattern without `|` at the top.
---
private pure func parse_simple_pattern(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	token: Token = current_token(builder)

	match token.kind:
		IdentifierToken:
			parse_named_pattern(builder)
		TrueKeyword:
			advanced: DiscoveryBuilder = advance_token(builder)
			append_leaf_node(advanced, TruePatternNode, token.span)
		FalseKeyword:
			advanced: DiscoveryBuilder = advance_token(builder)
			append_leaf_node(advanced, FalsePatternNode, token.span)
		UnderscoreSymbol:
			advanced: DiscoveryBuilder = advance_token(builder)
			append_leaf_node(advanced, WildcardPatternNode, token.span)
		LeftParenSymbol:
			parse_tuple_pattern(builder)
		LeftBracketSymbol:
			parse_list_pattern(builder)
		MinusSymbol:
			parse_negative_number_pattern(builder)
		IntLiteralToken:
			advanced: DiscoveryBuilder = advance_token(builder)
			append_literal_leaf_node(
				advanced,
				IntegerPatternNode,
				token.span,
				literal_id_at_row(token.payload),
			)
		FloatLiteralToken:
			advanced: DiscoveryBuilder = advance_token(builder)
			append_literal_leaf_node(
				advanced,
				FloatPatternNode,
				token.span,
				literal_id_at_row(token.payload),
			)
		NormalStringToken | RawStringToken | PipeStringToken | RawPipeStringToken:
			advanced: DiscoveryBuilder = advance_token(builder)
			append_literal_leaf_node(
				advanced,
				StringPatternNode,
				token.span,
				literal_id_at_row(token.payload),
			)
		InterpolatedStringToken | InterpolatedPipeStringToken:
			-- A pattern compares with a fixed string; holes have no value there.
			reported: DiscoveryBuilder = report_at_current(
				builder,
				InterpolatedStringPatternDiagnostic,
			)
			advanced: DiscoveryBuilder = advance_token(reported)
			append_leaf_node(advanced, MissingPatternNode, token.span)
		CharLiteralToken:
			advanced: DiscoveryBuilder = advance_token(builder)
			append_codepoint_leaf_node(advanced, CharPatternNode, token.span, token.payload)
		_:
			parse_keyword_or_missing_pattern(builder)


---
A name pattern for a soft keyword; a reserved keyword is reported and taken
as the name; anything else is a missing pattern.
---
private pure func parse_keyword_or_missing_pattern(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	token: Token = current_token(builder)

	match current_name(builder):
		Some(name):
			advanced: DiscoveryBuilder = advance_token(builder)
			append_name_leaf_node(advanced, NamePatternNode, token.span, name)
		None:
			match keyword_name_index(token.kind):
				Some(index):
					reported: DiscoveryBuilder = report_at_current(
						builder,
						ReservedKeywordAsNameDiagnostic,
					)
					advanced: DiscoveryBuilder = advance_token(reported)
					append_name_leaf_node(
						advanced,
						NamePatternNode,
						token.span,
						name_id_at_row(index),
					)
				None:
					recovered: DiscoveryBuilder = report_and_recover(
						builder,
						ExpectedPatternDiagnostic,
					)
					append_leaf_node(recovered, MissingPatternNode, token.span)


---
`name`, `Name(p, ...)`, `Type.Name` or `Type.Name(p, ...)`.
---
private pure func parse_named_pattern(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	token: Token = current_token(builder)

	match peek_kind(builder, 1):
		DotSymbol:
			parse_qualified_constructor_pattern(builder)
		LeftParenSymbol:
			parse_constructor_pattern(builder)
		_:
			advanced: DiscoveryBuilder = advance_token(builder)
			append_name_leaf_node(
				advanced,
				NamePatternNode,
				token.span,
				name_id_at_row(token.payload),
			)


---
`Name(p, ...)`.
---
private pure func parse_constructor_pattern(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	token: Token = current_token(builder)
	depth_before: Int = child_stack_depth(builder)
	advanced: DiscoveryBuilder = advance_token(builder)
	var out: DiscoveryBuilder = parse_pattern_arguments(advanced)
	count: Int = child_stack_depth(out) - depth_before
	end: Span = closing_span_or(out, RightParenSymbol, token.span)
	out = expect_token(out, RightParenSymbol, ExpectedRightParenDiagnostic)
	out = append_named_parent_node_from_stack(
		out,
		ConstructorPatternNode,
		span_covering(token.span, end),
		name_id_at_row(token.payload),
		count,
	)
	out


---
`Type.Name` with optional arguments; the qualifier is a `PatternQualifierNode`
child ahead of the arguments.
---
private pure func parse_qualified_constructor_pattern(
	builder: DiscoveryBuilder,
) -> DiscoveryBuilder:
	token: Token = current_token(builder)
	depth_before: Int = child_stack_depth(builder)
	var out: DiscoveryBuilder = append_name_leaf_node(
		builder,
		PatternQualifierNode,
		token.span,
		name_id_at_row(token.payload),
	)
	out = push_last_node(out)
	-- The type name, then the `.`.
	out = advance_token(out)
	out = advance_token(out)
	constructor: NameId = referenced_name_at_cursor(out)
	constructor_span: Span = current_span(out)
	out = consume_referenced_name(out)
	var end: Span = constructor_span

	if at(out, LeftParenSymbol):
		out = parse_pattern_arguments(out)
		end = closing_span_or(out, RightParenSymbol, constructor_span)
		out = expect_token(out, RightParenSymbol, ExpectedRightParenDiagnostic)

	count: Int = child_stack_depth(out) - depth_before
	out = append_named_parent_node_from_stack(
		out,
		QualifiedConstructorPatternNode,
		span_covering(token.span, end),
		constructor,
		count,
	)
	out


---
The argument patterns after a constructor's `(`, which this consumes, each
pushed on the child stack; the `)` is left for the caller.
---
private pure func parse_pattern_arguments(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	advanced: DiscoveryBuilder = advance_token(builder)
	parse_pattern_list_until(advanced, RightParenSymbol)


---
Patterns separated by commas up to `end` (which is not consumed), each
pushed on the child stack; an empty list and a trailing comma are allowed.
---
private pure func parse_pattern_list_until(
	builder: DiscoveryBuilder,
	end: TokenKind,
) -> DiscoveryBuilder:
	if at(builder, end):
		builder
	else:
		parse_pattern_items(builder, end)


private pure func parse_pattern_items(
	builder: DiscoveryBuilder,
	end: TokenKind,
) -> DiscoveryBuilder:
	parsed: DiscoveryBuilder = parse_pattern(builder)
	var out: DiscoveryBuilder = push_last_node(parsed)
	var parsing: Bool = True

	while parsing:
		if at(out, CommaSymbol):
			out = advance_token(out)

			if at(out, end) or at(out, EndOfFileToken):
				parsing = False
			else:
				out = parse_pattern(out)
				out = push_last_node(out)
		else:
			parsing = False

	out


---
The span of the closing `kind` token at the cursor, or `fallback` when the
cursor is not at one (the caller then reports it).
---
private pure func closing_span_or(
	builder: DiscoveryBuilder,
	kind: TokenKind,
	fallback: Span,
) -> Span:
	if at(builder, kind):
		current_span(builder)
	else:
		fallback


---
`(p, q, ...)`: two to four elements.
---
private pure func parse_tuple_pattern(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	start: Span = current_span(builder)
	depth_before: Int = child_stack_depth(builder)
	advanced: DiscoveryBuilder = advance_token(builder)
	var out: DiscoveryBuilder = parse_pattern(advanced)
	var end: Span = node_span(out, last_node_id(out))
	out = push_last_node(out)

	if at(out, CommaSymbol):
		comma_span: Span = current_span(out)
		depth_before_rest: Int = child_stack_depth(out)
		out = advance_token(out)
		out = parse_pattern_list_until(out, RightParenSymbol)

		end = if child_stack_depth(out) > depth_before_rest:
			node_span(out, last_node_id(out))
		else:
			comma_span
	else:
		out = report_at_current(out, ExpectedCommaDiagnostic)

	if at(out, RightParenSymbol):
		end = current_span(out)

	out = expect_token(out, RightParenSymbol, ExpectedRightParenDiagnostic)
	count: Int = child_stack_depth(out) - depth_before
	span: Span = span_covering(start, end)

	if count < MIN_TUPLE_PATTERN_ITEMS or count > MAX_TUPLE_PATTERN_ITEMS:
		out = append_plain_diagnostic(out, TupleArityDiagnostic, span)

	out = append_parent_node_from_stack(out, TuplePatternNode, span, count)
	out


---
`[p, ...]`, optionally ending in a spread `...rest` or `..._`.
---
private pure func parse_list_pattern(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	start: Span = current_span(builder)
	depth_before: Int = child_stack_depth(builder)
	var out: DiscoveryBuilder = advance_token(builder)
	var end: Span = start

	if at(out, DotDotDotSymbol):
		out = parse_list_spread(out)
		end = node_span(out, last_node_id(out))
		out = push_last_node(out)
	else if not at(out, RightBracketSymbol):
		var parsing: Bool = True

		while parsing and not at(out, EndOfFileToken):
			out = parse_pattern(out)
			end = node_span(out, last_node_id(out))
			out = push_last_node(out)

			if at(out, CommaSymbol):
				out = advance_token(out)

				if at(out, DotDotDotSymbol):
					out = parse_list_spread(out)
					end = node_span(out, last_node_id(out))
					out = push_last_node(out)
					parsing = False
			else:
				parsing = False

	if at(out, RightBracketSymbol):
		end = current_span(out)

	out = expect_token(out, RightBracketSymbol, ExpectedRightBracketDiagnostic)
	count: Int = child_stack_depth(out) - depth_before
	out = append_parent_node_from_stack(
		out,
		ListPatternNode,
		span_covering(start, end),
		count,
	)
	out


---
`...name` or `..._` from the `...`. A missing target is reported and taken
as `..._`.
---
private pure func parse_list_spread(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	dots: Span = current_span(builder)
	var out: DiscoveryBuilder = advance_token(builder)
	target: Token = current_token(out)
	span: Span = span_covering(dots, target.span)

	match target.kind:
		IdentifierToken:
			out = advance_token(out)
			out = append_name_leaf_node(
				out,
				ListSpreadNameNode,
				span,
				name_id_at_row(target.payload),
			)
		UnderscoreSymbol:
			out = advance_token(out)
			out = append_leaf_node(out, ListSpreadWildcardNode, span)
		_:
			out = report_and_recover(out, ExpectedSpreadTargetDiagnostic)
			out = append_leaf_node(out, ListSpreadWildcardNode, span)

	out


---
`-3` or `-1.5`; a `-` before anything else is reported.
---
private pure func parse_negative_number_pattern(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	minus: Span = current_span(builder)
	var out: DiscoveryBuilder = advance_token(builder)
	number: Token = current_token(out)
	span: Span = span_covering(minus, number.span)

	match number.kind:
		IntLiteralToken:
			advanced: DiscoveryBuilder = advance_token(out)
			out = append_literal_leaf_node(
				advanced,
				NegativeIntegerPatternNode,
				span,
				literal_id_at_row(number.payload),
			)
		FloatLiteralToken:
			out = advance_token(out)
			out = append_literal_leaf_node(
				out,
				NegativeFloatPatternNode,
				span,
				literal_id_at_row(number.payload),
			)
		_:
			out = append_plain_diagnostic(out, ExpectedNumberAfterMinusDiagnostic, minus)
			out = append_leaf_node(out, MissingPatternNode, minus)

	out
