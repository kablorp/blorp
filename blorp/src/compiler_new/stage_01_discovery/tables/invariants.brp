---
What a violation breaks. The meaning of `TableInvariantViolation.value` and
`related_table` is given per kind.

- `DanglingReference`: A row stores an id with no row in `related_table`; `value` is the id's index.
- `RangeOutOfBounds`: A row's range runs outside `related_table`; `value` is the range's end.
- `ModuleRangesOverlap`: A module's block of `related_table` starts before the previous module's block ends; `value` is the previous module's index.
- `NodeChildNotBeforeParent`: A node's child was not appended before it; `value` is the child's index.
- `BodyRootOutsideModule`: A body's root node lies outside its definition's module's node block; `value` is the root's index.
- `SeededNameMoved`: The name at a pinned id is not the seeded spelling; the row is the id.
- `InternIndexMismatch`: An intern index disagrees with its table: the dictionary maps a row's text to another row, or has an entry with no row. `value` is the index the dictionary holds.
- `QualifierOutsideReference`: A bound's or supertrait's module qualifier span does not lie inside the span of the bound or supertrait it qualifies, which covers the whole written reference; `value` is the qualified row's index in `related_table`.
- `SpanOutsideSources`: A span names no source; `value` is the span's source index.
- `DuplicateSideRow`: A side table holds more than one row for an owner that may have at most one; the row is the owner's index in `related_table` and `value` the row count.
- `RootOutcomeMismatch`: A root has not exactly one of a target and a root diagnostic; `value` is how many it has.
- `ImplicitOutcomeMismatch`: An implicit module request has not exactly one of a target and an implicit diagnostic; `value` is how many it has.
- `SignatureCountMismatch`: A function-like definition has not exactly one signature row, or another definition has one; the row is the definition and `value` its signature count.
- `SideTableUnsorted`: A side table read by owner is not sorted by strictly increasing owner; `value` is the row's owner.
- `SpanPastSourceEnd`: A span ends past its source's text; `value` is the span's end.
- `ParallelTableMismatch`: Two parallel tables differ in length; `value` is `related_table`'s length.
- `PayloadOutOfRange`: A node's payload is outside what its kind allows: a codepoint that is no Unicode scalar value, or a payload on a kind that has none; `value` is the payload.
- `UnreferencedNode`: A node is neither any node's child nor a root a row names (a body, a parameter or definition type, a variant payload, a dimension constraint side); the row is the node.
- `NodeReferencedTwice`: A node is a child or root more than once; `value` is how many times.
- `ArgumentCountMismatch`: A diagnostic row stores another number of arguments than its code documents (`diagnostic_argument_kinds`); the table is the row's, `value` its argument count.
- `ArgumentOutOfRange`: A diagnostic argument is not what its code documents: a construct that decodes to none, or an id with no row in its table; `value` is the argument.
- `NameSpanOutsideItsSpan`: A row's name span does not lie inside the span of the row or node it names a part of; `value` is the name span's start.
- `NameSpanOnWrongNodeKind`: A `NodeNameSpanRow` names a node of a kind that has no separate name span; `value` is the node's index.
- `DimensionSigilNameMissing`: A dimension name has no `DimensionNameRow`; `value` is the plain name's index.
- `SigilSpellingMismatch`: A dimension name row's sigil name is not `#` followed by the plain name's spelling; `value` is the sigil name's index.
- `NodeNameSpanMissing`: A node of a kind whose name is narrower than the node (`needs_name_span_row`) has no `NodeNameSpanRow`; the row is the node.
- `ElseKeywordMismatch`: An `ElseKeywordRow` does not belong to an `IfNode` that has an else branch (a third child), an `IfNode` with an else branch has none, or the keyword lies outside its node; the row is the keyword row or, for a missing one, the node, and `value` is the node's index.
- `ConcurrencyCountMismatch`: A `ConcurrencyCountRow` does not belong to a concurrency parameter node, or its count is not positive; the row is the count row and `value` the node's index.
- `LocalFunctionNodeMismatch`: A `LocalFunctionNode` names a definition that is not a local function; `value` is the definition's index.
---
enum TableInvariantKind:
	DanglingReference
	RangeOutOfBounds
	ModuleRangesOverlap
	NodeChildNotBeforeParent
	BodyRootOutsideModule
	SeededNameMoved
	InternIndexMismatch
	ParallelTableMismatch
	SpanOutsideSources
	QualifierOutsideReference
	SpanPastSourceEnd
	DuplicateSideRow
	RootOutcomeMismatch
	ImplicitOutcomeMismatch
	SignatureCountMismatch
	SideTableUnsorted
	LocalFunctionNodeMismatch
	UnreferencedNode
	NodeReferencedTwice
	PayloadOutOfRange
	ArgumentCountMismatch
	ArgumentOutOfRange
	NameSpanOutsideItsSpan
	NameSpanOnWrongNodeKind
	DimensionSigilNameMissing
	SigilSpellingMismatch
	NodeNameSpanMissing
	ElseKeywordMismatch
	ConcurrencyCountMismatch


struct TableInvariantViolation {
	kind: TableInvariantKind,
	table: DiscoveryTable,
	row: Int,
	related_table: DiscoveryTable,
	value: Int
}


private pure func violation(
	kind: TableInvariantKind,
	table: DiscoveryTable,
	row: Int,
	related_table: DiscoveryTable,
	value: Int,
) -> TableInvariantViolation:
	{
		kind = kind,
		table = table,
		row = row,
		related_table = related_table,
		value = value
	}


private pure func index_in(index: Int, length: Int) -> Bool:
	index >= 0 and index < length


private pure func range_end(range: RowRange) -> Int:
	range.first + range.count


private pure func range_in(range: RowRange, length: Int) -> Bool:
	range.first >= 0 and range.count >= 0 and range.range_end() <= length


---
Appends a `DanglingReference` to `found` unless `index` names a row of a
table with `length` rows.
---
private pure func check_reference(
	found: List[TableInvariantViolation],
	table: DiscoveryTable,
	row: Int,
	related_table: DiscoveryTable,
	index: Int,
	length: Int,
) -> List[TableInvariantViolation]:
	if index_in(index, length):
		found
	else:
		found.append(violation(DanglingReference, table, row, related_table, index))


private pure func check_range(
	found: List[TableInvariantViolation],
	table: DiscoveryTable,
	row: Int,
	related_table: DiscoveryTable,
	range: RowRange,
	length: Int,
) -> List[TableInvariantViolation]:
	if range.range_in(length):
		found
	else:
		found.append(violation(RangeOutOfBounds, table, row, related_table, range.range_end()))


---
Every invariant violation in `builder`, checked against the vocabulary
`seeded_spellings` its name table must start with. Empty for a well-formed
builder.
---
pure func check_table_invariants(
	builder: DiscoveryBuilder,
	seeded_spellings: List[String],
) -> List[TableInvariantViolation]:
	builder
		.check_seeded_names(seeded_spellings)
		.concat(builder.check_intern_indexes())
		.concat(builder.check_source_rows())
		.concat(builder.check_module_rows())
		.concat(builder.check_module_ranges())
		.concat(builder.check_root_rows())
		.concat(builder.check_implicit_rows())
		.concat(builder.check_import_rows())
		.concat(builder.check_declaration_rows())
		.concat(builder.check_node_rows())
		.concat(builder.check_node_references())
		.concat(builder.check_cardinalities())
		.concat(builder.check_body_rows())
		.concat(builder.check_diagnostic_rows())
		.concat(builder.check_spans())
		.concat(builder.check_qualifier_spans())
		.concat(builder.check_name_spans())
		.concat(builder.check_dimension_names())
		.concat(builder.check_node_name_rows())
		.concat(builder.check_else_keywords())
		.concat(builder.check_concurrency_counts())


private pure func check_seeded_names(
	builder: DiscoveryBuilder,
	seeded_spellings: List[String],
) -> List[TableInvariantViolation]:
	var found: List[TableInvariantViolation] = []
	var pinned: Int = 0

	for seeded in seeded_spellings:
		matches: Bool = match builder.name_spellings.get(pinned):
			Some(spelling):
				spelling == seeded
			None:
				False

		if not matches:
			found = found.append(violation(SeededNameMoved, NameTable, pinned, NameTable, pinned))

		pinned += 1

	found


---
Checks that each intern index maps every row's text back to that row and
holds no other entries.
---
private pure func check_intern_indexes(builder: DiscoveryBuilder) -> List[TableInvariantViolation]:
	check_slot_intern_index(builder.name_spellings, builder.name_slots, NameTable)
		.concat(check_text_intern_index(builder.paths, builder.path_ids_by_text, PathTable))
		.concat(check_slot_intern_index(builder.literals, builder.literal_slots, LiteralTable))


---
The slot table finds every text at its own row and holds nothing else.
---
private pure func check_slot_intern_index(
	texts: List[String],
	slots: List[Int],
	table: DiscoveryTable,
) -> List[TableInvariantViolation]:
	var found: List[TableInvariantViolation] = []
	var row: Int = 0

	for text in texts:
		located: Int = find_slice(texts, slots, text, 0, text.length(), text_hash(text))

		if located != row:
			found = found.append(violation(InternIndexMismatch, table, row, table, located))

		row += 1

	occupied: Int = occupied_slot_count(slots)

	if occupied != texts.length():
		found = found.append(violation(InternIndexMismatch, table, texts.length(), table, occupied))

	found


private pure func check_text_intern_index(
	texts: List[String],
	ids_by_text: Dict[String, Int],
	table: DiscoveryTable,
) -> List[TableInvariantViolation]:
	var found: List[TableInvariantViolation] = []
	var row: Int = 0

	for text in texts:
		match ids_by_text.get(text):
			Some(index):
				if index != row:
					found = found.append(violation(InternIndexMismatch, table, row, table, index))
			None:
				found = found.append(violation(InternIndexMismatch, table, row, table, row))

		row += 1

	if ids_by_text.length() != texts.length():
		found = found.append(
			violation(
				InternIndexMismatch,
				table,
				texts.length(),
				table,
				ids_by_text.length(),
			),
		)

	found


private pure func check_source_rows(builder: DiscoveryBuilder) -> List[TableInvariantViolation]:
	var found: List[TableInvariantViolation] = []
	source_count: Int = builder.sources.length()
	path_count: Int = builder.paths.length()
	line_start_count: Int = builder.line_starts.length()

	if builder.source_texts.length() != source_count:
		found = found.append(
			violation(
				ParallelTableMismatch,
				SourceTable,
				source_count,
				SourceTextTable,
				builder.source_texts.length(),
			),
		)

	var row: Int = 0

	for source in builder.sources:
		found = check_reference(
			found,
			SourceTable,
			row,
			PathTable,
			source.path.path_id_index(),
			path_count,
		)
		found = check_range(
			found,
			SourceTable,
			row,
			LineStartTable,
			source.line_starts,
			line_start_count,
		)
		row += 1

	found


private pure func check_module_rows(builder: DiscoveryBuilder) -> List[TableInvariantViolation]:
	var found: List[TableInvariantViolation] = []
	module_count: Int = builder.modules.length()
	source_count: Int = builder.sources.length()
	path_count: Int = builder.paths.length()
	var row: Int = 0

	for module in builder.modules:
		found = check_reference(
			found,
			ModuleTable,
			row,
			SourceTable,
			module.source.source_id_index(),
			source_count,
		)
		found = check_reference(
			found,
			ModuleTable,
			row,
			PathTable,
			module.canonical_path.path_id_index(),
			path_count,
		)

		match builder.module_ids_by_path.get(module.canonical_path.path_id_index()):
			Some(indexed):
				if indexed != row:
					found = found.append(
						violation(
							InternIndexMismatch,
							ModuleTable,
							row,
							ModuleTable,
							indexed,
						),
					)
			None:
				found = found.append(
					violation(
						InternIndexMismatch,
						ModuleTable,
						row,
						ModuleTable,
						row,
					),
				)

		row += 1

	if builder.module_ids_by_path.length() != module_count:
		found = found.append(
			violation(
				InternIndexMismatch,
				ModuleTable,
				module_count,
				ModuleTable,
				builder.module_ids_by_path.length(),
			),
		)

	var package_row: Int = 0
	package_count: Int = builder.packages.length()

	for module_package in builder.module_packages:
		found = check_reference(
			found,
			ModulePackageTable,
			package_row,
			ModuleTable,
			module_package.module.module_id_index(),
			module_count,
		)
		found = check_reference(
			found,
			ModulePackageTable,
			package_row,
			PackageTable,
			module_package.package.package_id_index(),
			package_count,
		)
		package_row += 1

	var package_name_row: Int = 0
	name_count: Int = builder.name_spellings.length()

	for package in builder.packages:
		found = check_reference(
			found,
			PackageTable,
			package_name_row,
			NameTable,
			package.name.name_id_index(),
			name_count,
		)
		package_name_row += 1

	found


---
Each module's blocks lie inside their tables and start at or after the end
of the previous module's blocks: modules are parsed one after another, so
their blocks are disjoint and in module order.
---
private pure func check_module_ranges(builder: DiscoveryBuilder) -> List[TableInvariantViolation]:
	var found: List[TableInvariantViolation] = []
	definition_count: Int = builder.definitions.length()
	import_count: Int = builder.imports.length()
	node_count: Int = builder.nodes.length()
	diagnostic_count: Int = builder.diagnostics.length()
	var previous_definitions_end: Int = 0
	var previous_imports_end: Int = 0
	var previous_nodes_end: Int = 0
	var previous_diagnostics_end: Int = 0
	var row: Int = 0

	for module in builder.modules:
		previous: Int = row - 1
		found = check_range(
			found,
			ModuleTable,
			row,
			DefinitionTable,
			module.definitions,
			definition_count,
		)
		found = check_range(found, ModuleTable, row, ImportTable, module.imports, import_count)
		found = check_range(found, ModuleTable, row, NodeTable, module.nodes, node_count)
		found = check_range(
			found,
			ModuleTable,
			row,
			DiagnosticTable,
			module.diagnostics,
			diagnostic_count,
		)

		if module.definitions.first < previous_definitions_end:
			found = found.append(
				violation(
					ModuleRangesOverlap,
					ModuleTable,
					row,
					DefinitionTable,
					previous,
				),
			)

		if module.imports.first < previous_imports_end:
			found = found.append(
				violation(
					ModuleRangesOverlap,
					ModuleTable,
					row,
					ImportTable,
					previous,
				),
			)

		if module.nodes.first < previous_nodes_end:
			found = found.append(
				violation(
					ModuleRangesOverlap,
					ModuleTable,
					row,
					NodeTable,
					previous,
				),
			)

		if module.diagnostics.first < previous_diagnostics_end:
			found = found.append(
				violation(
					ModuleRangesOverlap,
					ModuleTable,
					row,
					DiagnosticTable,
					previous,
				),
			)

		previous_definitions_end = module.definitions.range_end()
		previous_imports_end = module.imports.range_end()
		previous_nodes_end = module.nodes.range_end()
		previous_diagnostics_end = module.diagnostics.range_end()
		row += 1

	found


private pure func check_root_rows(builder: DiscoveryBuilder) -> List[TableInvariantViolation]:
	var found: List[TableInvariantViolation] = []
	root_count: Int = builder.roots.length()
	module_count: Int = builder.modules.length()
	path_count: Int = builder.paths.length()
	argument_count: Int = builder.diagnostic_arguments.length()
	var row: Int = 0

	for root in builder.roots:
		found = check_reference(
			found,
			RootTable,
			row,
			PathTable,
			root.request_path.path_id_index(),
			path_count,
		)
		row += 1

	var target_row: Int = 0

	for target in builder.root_targets:
		found = check_reference(
			found,
			RootTargetTable,
			target_row,
			RootTable,
			target.root.root_id_index(),
			root_count,
		)
		found = check_reference(
			found,
			RootTargetTable,
			target_row,
			ModuleTable,
			target.target.module_id_index(),
			module_count,
		)
		target_row += 1

	var diagnostic_row: Int = 0

	for root_diagnostic in builder.root_diagnostics:
		found = check_reference(
			found,
			RootDiagnosticTable,
			diagnostic_row,
			RootTable,
			root_diagnostic.root.root_id_index(),
			root_count,
		)
		found = check_range(
			found,
			RootDiagnosticTable,
			diagnostic_row,
			DiagnosticArgumentTable,
			root_diagnostic.arguments,
			argument_count,
		)
		found = builder.check_row_arguments(
			found,
			RootDiagnosticTable,
			diagnostic_row,
			root_diagnostic.code,
			root_diagnostic.arguments,
		)
		diagnostic_row += 1

	found


private pure func check_implicit_rows(builder: DiscoveryBuilder) -> List[TableInvariantViolation]:
	var found: List[TableInvariantViolation] = []
	request_count: Int = builder.implicit_requests.length()
	module_count: Int = builder.modules.length()
	path_count: Int = builder.paths.length()
	argument_count: Int = builder.diagnostic_arguments.length()
	var row: Int = 0

	for request in builder.implicit_requests:
		found = check_reference(
			found,
			ImplicitRequestTable,
			row,
			PathTable,
			request.request_path.path_id_index(),
			path_count,
		)
		row += 1

	var target_row: Int = 0

	for target in builder.implicit_targets:
		found = check_reference(
			found,
			ImplicitTargetTable,
			target_row,
			ImplicitRequestTable,
			target.request.implicit_request_id_index(),
			request_count,
		)
		found = check_reference(
			found,
			ImplicitTargetTable,
			target_row,
			ModuleTable,
			target.target.module_id_index(),
			module_count,
		)
		target_row += 1

	var diagnostic_row: Int = 0

	for implicit_diagnostic in builder.implicit_diagnostics:
		found = check_reference(
			found,
			ImplicitDiagnosticTable,
			diagnostic_row,
			ImplicitRequestTable,
			implicit_diagnostic.request.implicit_request_id_index(),
			request_count,
		)
		found = check_range(
			found,
			ImplicitDiagnosticTable,
			diagnostic_row,
			DiagnosticArgumentTable,
			implicit_diagnostic.arguments,
			argument_count,
		)
		found = builder.check_row_arguments(
			found,
			ImplicitDiagnosticTable,
			diagnostic_row,
			implicit_diagnostic.code,
			implicit_diagnostic.arguments,
		)
		diagnostic_row += 1

	found


private pure func check_import_rows(builder: DiscoveryBuilder) -> List[TableInvariantViolation]:
	var found: List[TableInvariantViolation] = []
	import_count: Int = builder.imports.length()
	item_count: Int = builder.import_items.length()
	part_count: Int = builder.import_path_parts.length()
	variant_count: Int = builder.import_item_variants.length()
	module_count: Int = builder.modules.length()
	path_count: Int = builder.paths.length()
	name_count: Int = builder.name_spellings.length()
	var row: Int = 0

	for import_row in builder.imports:
		found = check_reference(
			found,
			ImportTable,
			row,
			ModuleTable,
			import_row.importer.module_id_index(),
			module_count,
		)
		found = check_reference(
			found,
			ImportTable,
			row,
			PathTable,
			import_row.request_path.path_id_index(),
			path_count,
		)
		found = check_range(found, ImportTable, row, ImportItemTable, import_row.items, item_count)
		found = check_range(
			found,
			ImportTable,
			row,
			ImportPathPartTable,
			import_row.path_parts,
			part_count,
		)
		row += 1

	var item_row: Int = 0

	for item in builder.import_items:
		found = check_reference(
			found,
			ImportItemTable,
			item_row,
			ImportTable,
			item.owner_import.import_id_index(),
			import_count,
		)
		found = check_reference(
			found,
			ImportItemTable,
			item_row,
			NameTable,
			item.name.name_id_index(),
			name_count,
		)
		found = check_range(
			found,
			ImportItemTable,
			item_row,
			ImportItemVariantTable,
			item.variants,
			variant_count,
		)
		item_row += 1

	var variant_row: Int = 0

	for variant in builder.import_item_variants:
		found = check_reference(
			found,
			ImportItemVariantTable,
			variant_row,
			ImportItemTable,
			variant.item.import_item_id_index(),
			item_count,
		)
		found = check_reference(
			found,
			ImportItemVariantTable,
			variant_row,
			NameTable,
			variant.name.name_id_index(),
			name_count,
		)
		variant_row += 1

	var part_row: Int = 0

	for part in builder.import_path_parts:
		found = check_reference(
			found,
			ImportPathPartTable,
			part_row,
			NameTable,
			part.name_id_index(),
			name_count,
		)
		part_row += 1

	var target_row: Int = 0

	for target in builder.import_targets:
		found = check_reference(
			found,
			ImportTargetTable,
			target_row,
			ImportTable,
			target.owner_import.import_id_index(),
			import_count,
		)
		found = check_reference(
			found,
			ImportTargetTable,
			target_row,
			ModuleTable,
			target.target.module_id_index(),
			module_count,
		)
		target_row += 1

	var alias_row: Int = 0

	for alias_entry in builder.import_aliases:
		found = check_reference(
			found,
			ImportAliasTable,
			alias_row,
			ImportTable,
			alias_entry.owner_import.import_id_index(),
			import_count,
		)
		found = check_reference(
			found,
			ImportAliasTable,
			alias_row,
			NameTable,
			alias_entry.alias_name.name_id_index(),
			name_count,
		)
		alias_row += 1

	var item_alias_row: Int = 0

	for item_alias in builder.import_item_aliases:
		found = check_reference(
			found,
			ImportItemAliasTable,
			item_alias_row,
			ImportItemTable,
			item_alias.item.import_item_id_index(),
			item_count,
		)
		found = check_reference(
			found,
			ImportItemAliasTable,
			item_alias_row,
			NameTable,
			item_alias.alias_name.name_id_index(),
			name_count,
		)
		item_alias_row += 1

	found


private pure func check_declaration_rows(
	builder: DiscoveryBuilder,
) -> List[TableInvariantViolation]:
	var found: List[TableInvariantViolation] = []
	definition_count: Int = builder.definitions.length()
	module_count: Int = builder.modules.length()
	name_count: Int = builder.name_spellings.length()
	literal_count: Int = builder.literals.length()
	node_count: Int = builder.nodes.length()
	import_count: Int = builder.imports.length()
	parameter_count: Int = builder.parameters.length()
	binder_name_count: Int = builder.binder_names.length()
	foreign_argument_count: Int = builder.foreign_arguments.length()
	foreign_block_count: Int = builder.foreign_blocks.length()
	var row: Int = 0

	for block in builder.import_blocks:
		found = check_reference(
			found,
			ImportBlockTable,
			row,
			ModuleTable,
			block.module.module_id_index(),
			module_count,
		)
		found = check_range(found, ImportBlockTable, row, ImportTable, block.imports, import_count)
		row += 1

	row = 0

	for definition in builder.definitions:
		found = check_reference(
			found,
			DefinitionTable,
			row,
			ModuleTable,
			definition.module.module_id_index(),
			module_count,
		)
		found = check_reference(
			found,
			DefinitionTable,
			row,
			NameTable,
			definition.name.name_id_index(),
			name_count,
		)
		row += 1

	row = 0

	for member in builder.members:
		found = check_reference(
			found,
			MemberTable,
			row,
			DefinitionTable,
			member.definition.definition_id_index(),
			definition_count,
		)
		found = check_reference(
			found,
			MemberTable,
			row,
			DefinitionTable,
			member.owner.definition_id_index(),
			definition_count,
		)
		row += 1

	row = 0

	for documentation in builder.documentation:
		found = check_reference(
			found,
			DocumentationTable,
			row,
			DefinitionTable,
			documentation.definition.definition_id_index(),
			definition_count,
		)
		found = check_reference(
			found,
			DocumentationTable,
			row,
			LiteralTable,
			documentation.text.literal_id_index(),
			literal_count,
		)
		row += 1

	row = 0

	for documentation in builder.module_documentation:
		found = check_reference(
			found,
			ModuleDocumentationTable,
			row,
			ModuleTable,
			documentation.module.module_id_index(),
			module_count,
		)
		found = check_reference(
			found,
			ModuleDocumentationTable,
			row,
			LiteralTable,
			documentation.text.literal_id_index(),
			literal_count,
		)
		row += 1

	row = 0

	for annotation in builder.annotations:
		found = check_reference(
			found,
			AnnotationTable,
			row,
			DefinitionTable,
			annotation.definition.definition_id_index(),
			definition_count,
		)
		row += 1

	row = 0

	for parameter in builder.type_parameters:
		found = check_reference(
			found,
			TypeParameterTable,
			row,
			DefinitionTable,
			parameter.owner.definition_id_index(),
			definition_count,
		)
		found = check_reference(
			found,
			TypeParameterTable,
			row,
			NameTable,
			parameter.name.name_id_index(),
			name_count,
		)
		row += 1

	row = 0

	for bound in builder.bounds:
		found = check_reference(
			found,
			BoundTable,
			row,
			DefinitionTable,
			bound.owner.definition_id_index(),
			definition_count,
		)
		found = check_reference(
			found,
			BoundTable,
			row,
			NameTable,
			bound.trait_name.name_id_index(),
			name_count,
		)
		row += 1

	row = 0

	for qualifier in builder.bound_qualifiers:
		found = check_reference(
			found,
			BoundQualifierTable,
			row,
			BoundTable,
			qualifier.bound.bound_id_index(),
			builder.bounds.length(),
		)
		found = check_reference(
			found,
			BoundQualifierTable,
			row,
			NameTable,
			qualifier.qualifier.name_id_index(),
			name_count,
		)
		row += 1

	row = 0

	for supertrait in builder.supertraits:
		found = check_reference(
			found,
			SupertraitTable,
			row,
			DefinitionTable,
			supertrait.trait_definition.definition_id_index(),
			definition_count,
		)
		found = check_reference(
			found,
			SupertraitTable,
			row,
			NameTable,
			supertrait.name.name_id_index(),
			name_count,
		)
		row += 1

	row = 0

	for qualifier in builder.supertrait_qualifiers:
		found = check_reference(
			found,
			SupertraitQualifierTable,
			row,
			SupertraitTable,
			qualifier.supertrait.supertrait_id_index(),
			builder.supertraits.length(),
		)
		found = check_reference(
			found,
			SupertraitQualifierTable,
			row,
			NameTable,
			qualifier.qualifier.name_id_index(),
			name_count,
		)
		row += 1

	row = 0

	for signature in builder.signatures:
		found = check_reference(
			found,
			SignatureTable,
			row,
			DefinitionTable,
			signature.definition.definition_id_index(),
			definition_count,
		)
		found = check_range(
			found,
			SignatureTable,
			row,
			ParameterTable,
			signature.parameters,
			parameter_count,
		)
		row += 1

	row = 0

	for parameter in builder.parameters:
		found = check_reference(
			found,
			ParameterTable,
			row,
			DefinitionTable,
			parameter.owner.definition_id_index(),
			definition_count,
		)
		found = check_range(
			found,
			ParameterTable,
			row,
			BinderNameTable,
			parameter.binder_names,
			binder_name_count,
		)
		row += 1

	row = 0

	for binder_name in builder.binder_names:
		found = check_reference(
			found,
			BinderNameTable,
			row,
			NameTable,
			binder_name.name.name_id_index(),
			name_count,
		)
		row += 1

	row = 0

	for parameter_type in builder.parameter_types:
		found = check_reference(
			found,
			ParameterTypeTable,
			row,
			ParameterTable,
			parameter_type.parameter.parameter_id_index(),
			parameter_count,
		)
		found = check_reference(
			found,
			ParameterTypeTable,
			row,
			NodeTable,
			parameter_type.type_root.node_id_index(),
			node_count,
		)
		row += 1

	row = 0

	for definition_type in builder.definition_types:
		found = check_reference(
			found,
			DefinitionTypeTable,
			row,
			DefinitionTable,
			definition_type.definition.definition_id_index(),
			definition_count,
		)
		found = check_reference(
			found,
			DefinitionTypeTable,
			row,
			NodeTable,
			definition_type.type_root.node_id_index(),
			node_count,
		)
		row += 1

	row = 0

	for payload in builder.variant_payloads:
		found = check_reference(
			found,
			VariantPayloadTable,
			row,
			DefinitionTable,
			payload.variant.definition_id_index(),
			definition_count,
		)
		found = check_reference(
			found,
			VariantPayloadTable,
			row,
			NodeTable,
			payload.type_root.node_id_index(),
			node_count,
		)
		row += 1

	row = 0

	for constraint in builder.dimension_constraints:
		found = check_reference(
			found,
			DimensionConstraintTable,
			row,
			DefinitionTable,
			constraint.owner.definition_id_index(),
			definition_count,
		)
		found = check_reference(
			found,
			DimensionConstraintTable,
			row,
			NodeTable,
			constraint.left.node_id_index(),
			node_count,
		)
		found = check_reference(
			found,
			DimensionConstraintTable,
			row,
			NodeTable,
			constraint.right.node_id_index(),
			node_count,
		)
		row += 1

	row = 0

	for block in builder.foreign_blocks:
		found = check_reference(
			found,
			ForeignBlockTable,
			row,
			ModuleTable,
			block.module.module_id_index(),
			module_count,
		)
		found = check_range(
			found,
			ForeignBlockTable,
			row,
			ForeignArgumentTable,
			block.arguments,
			foreign_argument_count,
		)
		row += 1

	row = 0

	for argument in builder.foreign_arguments:
		found = check_reference(
			found,
			ForeignArgumentTable,
			row,
			NameTable,
			argument.name.name_id_index(),
			name_count,
		)
		found = check_reference(
			found,
			ForeignArgumentTable,
			row,
			LiteralTable,
			argument.value.literal_id_index(),
			literal_count,
		)
		row += 1

	row = 0

	for binding in builder.foreign_bindings:
		found = check_reference(
			found,
			ForeignBindingTable,
			row,
			DefinitionTable,
			binding.definition.definition_id_index(),
			definition_count,
		)
		found = check_reference(
			found,
			ForeignBindingTable,
			row,
			ForeignBlockTable,
			binding.block.foreign_block_id_index(),
			foreign_block_count,
		)
		row += 1

	row = 0

	for c_name in builder.foreign_c_names:
		found = check_reference(
			found,
			ForeignCNameTable,
			row,
			DefinitionTable,
			c_name.definition.definition_id_index(),
			definition_count,
		)
		found = check_reference(
			found,
			ForeignCNameTable,
			row,
			LiteralTable,
			c_name.c_name.literal_id_index(),
			literal_count,
		)
		row += 1

	row = 0

	for cleanup in builder.resource_cleanups:
		found = check_reference(
			found,
			ResourceCleanupTable,
			row,
			DefinitionTable,
			cleanup.definition.definition_id_index(),
			definition_count,
		)
		found = check_reference(
			found,
			ResourceCleanupTable,
			row,
			LiteralTable,
			cleanup.builtin_name.literal_id_index(),
			literal_count,
		)
		row += 1

	found


---
Every node's child block lies inside the edge table, and every child is an
existing node appended before its parent (post-order).
---
private pure func check_node_rows(builder: DiscoveryBuilder) -> List[TableInvariantViolation]:
	var found: List[TableInvariantViolation] = []
	node_count: Int = builder.nodes.length()
	edge_count: Int = builder.node_children.length()
	var row: Int = 0

	for node in builder.nodes:
		if node.children.range_in(edge_count):
			for edge in node.children.first..range_end(node.children):
				match builder.node_children.get(edge):
					Some(child):
						child_index: Int = child.node_id_index()

						if not index_in(child_index, node_count):
							found = found.append(
								violation(
									DanglingReference,
									NodeTable,
									row,
									NodeTable,
									child_index,
								),
							)
						else if child_index >= row:
							found = found.append(
								violation(
									NodeChildNotBeforeParent,
									NodeTable,
									row,
									NodeTable,
									child_index,
								),
							)
					None:
						found = found.append(
							violation(
								RangeOutOfBounds,
								NodeTable,
								row,
								NodeChildTable,
								edge,
							),
						)
		else:
			found = found.append(
				violation(
					RangeOutOfBounds,
					NodeTable,
					row,
					NodeChildTable,
					node.children.range_end(),
				),
			)

		found = check_node_payload(found, builder, row, node)

		row += 1

	found


---
Every node is referenced exactly once: as one node's child, or as a root a
row names (a body root, a parameter or definition type, a variant payload,
either side of a dimension constraint). One pass counts the references.
---
private pure func check_node_references(builder: DiscoveryBuilder) -> List[TableInvariantViolation]:
	node_count: Int = builder.nodes.length()
	var references: List[Int] = repeat(0, node_count)

	for child in builder.node_children:
		references = counted(references, child.node_id_index())

	for body in builder.bodies:
		references = counted(references, body.root.node_id_index())

	for parameter_type in builder.parameter_types:
		references = counted(references, parameter_type.type_root.node_id_index())

	for definition_type in builder.definition_types:
		references = counted(references, definition_type.type_root.node_id_index())

	for payload in builder.variant_payloads:
		references = counted(references, payload.type_root.node_id_index())

	for constraint in builder.dimension_constraints:
		references = counted(references, constraint.left.node_id_index())
		references = counted(references, constraint.right.node_id_index())

	var found: List[TableInvariantViolation] = []
	var row: Int = 0

	for count in references:
		if count == 0:
			found = found.append(violation(UnreferencedNode, NodeTable, row, NodeTable, row))
		else if count > 1:
			found = found.append(violation(NodeReferencedTwice, NodeTable, row, NodeTable, count))

		row += 1

	found


---
Side tables that hold at most one row per owner do (including a bound's or
supertrait's module qualifier); each root has exactly
one outcome (a target or a root diagnostic); each function-like definition
has exactly one signature and no other definition has one.
---
private pure func check_cardinalities(builder: DiscoveryBuilder) -> List[TableInvariantViolation]:
	imports: Int = builder.imports.length()
	roots: Int = builder.roots.length()
	definitions: Int = builder.definitions.length()
	root_targets: List[Int] = owner_counts(
		roots,
		builder.root_targets.map(pure func(row): row.root.root_id_index()),
	)
	root_diagnostics: List[Int] = owner_counts(
		roots,
		builder.root_diagnostics.map(pure func(row): row.root.root_id_index()),
	)
	implicit_requests: Int = builder.implicit_requests.length()
	implicit_targets: List[Int] = owner_counts(
		implicit_requests,
		builder.implicit_targets.map(pure func(row): row.request.implicit_request_id_index()),
	)
	implicit_diagnostics: List[Int] = owner_counts(
		implicit_requests,
		builder.implicit_diagnostics.map(pure func(row): row.request.implicit_request_id_index()),
	)
	signatures: List[Int] = owner_counts(
		definitions,
		builder.signatures.map(pure func(row): row.definition.definition_id_index()),
	)
	var found: List[TableInvariantViolation] = at_most_one(
		[],
		ImportTargetTable,
		ImportTable,
		owner_counts(
			imports,
			builder.import_targets.map(pure func(row): row.owner_import.import_id_index()),
		),
	)
	found = at_most_one(
		found,
		ImportAliasTable,
		ImportTable,
		owner_counts(
			imports,
			builder.import_aliases.map(pure func(row): row.owner_import.import_id_index()),
		),
	)
	found = at_most_one(
		found,
		BoundQualifierTable,
		BoundTable,
		owner_counts(
			builder.bounds.length(),
			builder.bound_qualifiers.map(pure func(row): row.bound.bound_id_index()),
		),
	)
	found = at_most_one(
		found,
		SupertraitQualifierTable,
		SupertraitTable,
		owner_counts(
			builder.supertraits.length(),
			builder.supertrait_qualifiers.map(pure func(row): row.supertrait.supertrait_id_index()),
		),
	)
	found = at_most_one(found, RootTargetTable, RootTable, root_targets)
	found = at_most_one(found, ImplicitTargetTable, ImplicitRequestTable, implicit_targets)
	found = sorted_by_owner(
		found,
		ImplicitTargetTable,
		builder.implicit_targets.map(pure func(row): row.request.implicit_request_id_index()),
	)
	found = sorted_by_owner(
		found,
		ImportTargetTable,
		builder.import_targets.map(pure func(row): row.owner_import.import_id_index()),
	)
	found = sorted_by_owner(
		found,
		ImportAliasTable,
		builder.import_aliases.map(pure func(row): row.owner_import.import_id_index()),
	)
	found = sorted_by_owner(
		found,
		ImportItemAliasTable,
		builder.import_item_aliases.map(pure func(row): row.item.import_item_id_index()),
	)
	found = sorted_by_owner(
		found,
		BoundQualifierTable,
		builder.bound_qualifiers.map(pure func(row): row.bound.bound_id_index()),
	)
	found = sorted_by_owner(
		found,
		SupertraitQualifierTable,
		builder.supertrait_qualifiers.map(pure func(row): row.supertrait.supertrait_id_index()),
	)
	found = sorted_by_owner(
		found,
		RootTargetTable,
		builder.root_targets.map(pure func(row): row.root.root_id_index()),
	)
	found = sorted_by_owner(
		found,
		ModulePackageTable,
		builder.module_packages.map(pure func(row): row.module.module_id_index()),
	)
	found = at_most_one(
		found,
		ModulePackageTable,
		ModuleTable,
		owner_counts(
			builder.modules.length(),
			builder.module_packages.map(pure func(row): row.module.module_id_index()),
		),
	)
	found = at_most_one(
		found,
		DefinitionTypeTable,
		DefinitionTable,
		owner_counts(
			definitions,
			builder.definition_types.map(pure func(row): row.definition.definition_id_index()),
		),
	)
	found = at_most_one(
		found,
		ModuleDocumentationTable,
		ModuleTable,
		owner_counts(
			builder.modules.length(),
			builder.module_documentation.map(pure func(row): row.module.module_id_index()),
		),
	)
	found = at_most_one(
		found,
		BodyTable,
		DefinitionTable,
		owner_counts(
			definitions,
			builder.bodies.map(pure func(row): row.definition.definition_id_index()),
		),
	)
	var root: Int = 0

	while root < roots:
		outcomes: Int = root_targets.get_or(root, 0) + root_diagnostics.get_or(root, 0)

		if outcomes != 1:
			found = found.append(
				violation(
					RootOutcomeMismatch,
					RootTable,
					root,
					RootTargetTable,
					outcomes,
				),
			)

		root += 1

	var request: Int = 0

	while request < implicit_requests:
		outcomes: Int = implicit_targets.get_or(
			request,
			0,
		) + implicit_diagnostics.get_or(request, 0)

		if outcomes != 1:
			found = found.append(
				violation(
					ImplicitOutcomeMismatch,
					ImplicitRequestTable,
					request,
					ImplicitTargetTable,
					outcomes,
				),
			)

		request += 1

	var row: Int = 0

	for definition in builder.definitions:
		expected: Int = if definition.kind.has_signature():
			1
		else:
			0

		count: Int = signatures.get_or(row, 0)

		if count != expected:
			found = found.append(
				violation(
					SignatureCountMismatch,
					DefinitionTable,
					row,
					SignatureTable,
					count,
				),
			)

		row += 1

	found


---
Whether a definition of `kind` has a signature row.
---
private pure func has_signature(kind: DefinitionKind) -> Bool:
	match kind:
		FunctionDefinition | TraitMethodDefinition | ImplMethodDefinition | ForeignFunctionDefinition | LocalFunctionDefinition:
			True
		_:
			False


---
How many rows name each of `owner_count` owners, from the owner index of
each row; an index outside the owners is a dangling reference the row
checks report.
---
private pure func owner_counts(owner_count: Int, owners: List[Int]) -> List[Int]:
	var counts: List[Int] = repeat(0, owner_count)

	for owner in owners:
		counts = counted(counts, owner)

	counts


---
A `SideTableUnsorted` for each row whose owner is not greater than the
previous row's: the frozen tables find a side row by binary search.
---
private pure func sorted_by_owner(
	found: List[TableInvariantViolation],
	table: DiscoveryTable,
	owners: List[Int],
) -> List[TableInvariantViolation]:
	var out: List[TableInvariantViolation] = found
	var previous: Int = -1
	var row: Int = 0

	for owner in owners:
		if owner <= previous:
			out = out.append(violation(SideTableUnsorted, table, row, table, owner))

		previous = owner
		row += 1

	out


---
A `DuplicateSideRow` for each owner `counts` gives more than one row.
---
private pure func at_most_one(
	found: List[TableInvariantViolation],
	table: DiscoveryTable,
	owner_table: DiscoveryTable,
	counts: List[Int],
) -> List[TableInvariantViolation]:
	var out: List[TableInvariantViolation] = found
	var owner: Int = 0

	for count in counts:
		if count > 1:
			out = out.append(violation(DuplicateSideRow, table, owner, owner_table, count))

		owner += 1

	out


---
`references` with the count at `index` raised by one; an index outside the
node table is a dangling reference, which the row checks report.
---
private pure func counted(references: List[Int], index: Int) -> List[Int]:
	match references.get(index):
		Some(count):
			references.set(index, count + 1)
		None:
			references


---
A node's payload indexes the table its kind names (`node_payload_reference`):
a name, a literal, a Unicode scalar value, a local function's definition, or
nothing (`NO_NODE_PAYLOAD`).
---
private pure func check_node_payload(
	found: List[TableInvariantViolation],
	builder: DiscoveryBuilder,
	row: Int,
	node: NodeRow,
) -> List[TableInvariantViolation]:
	match node.kind.node_payload_reference():
		NamePayload:
			check_reference(
				found,
				NodeTable,
				row,
				NameTable,
				node.payload,
				builder.name_spellings.length(),
			)
		LiteralPayload:
			check_reference(
				found,
				NodeTable,
				row,
				LiteralTable,
				node.payload,
				builder.literals.length(),
			)
		CodepointPayload:
			if is_unicode_scalar(node.payload):
				found
			else:
				found.append(violation(PayloadOutOfRange, NodeTable, row, NodeTable, node.payload))
		DefinitionPayload:
			check_local_function_node(found, builder, row, node.payload)
		NoPayload:
			if node.payload == NO_NODE_PAYLOAD:
				found
			else:
				found.append(violation(PayloadOutOfRange, NodeTable, row, NodeTable, node.payload))


---
A `LocalFunctionNode` at `row` names an existing `LocalFunctionDefinition`.
---
private pure func check_local_function_node(
	found: List[TableInvariantViolation],
	builder: DiscoveryBuilder,
	row: Int,
	definition_index: Int,
) -> List[TableInvariantViolation]:
	match builder.definitions.get(definition_index):
		Some(definition):
			if definition.kind == LocalFunctionDefinition:
				found
			else:
				found.append(
					violation(
						LocalFunctionNodeMismatch,
						NodeTable,
						row,
						DefinitionTable,
						definition_index,
					),
				)
		None:
			found.append(
				violation(
					DanglingReference,
					NodeTable,
					row,
					DefinitionTable,
					definition_index,
				),
			)


---
Every body names an existing definition, and its root is a node inside the
node block of that definition's module.
---
private pure func check_body_rows(builder: DiscoveryBuilder) -> List[TableInvariantViolation]:
	var found: List[TableInvariantViolation] = []
	definition_count: Int = builder.definitions.length()
	var row: Int = 0

	for body in builder.bodies:
		definition_index: Int = body.definition.definition_id_index()
		root_index: Int = body.root.node_id_index()

		match builder.definitions.get(definition_index):
			Some(definition):
				match builder.modules.get(definition.module.module_id_index()):
					Some(module):
						if not index_in(root_index - module.nodes.first, module.nodes.count):
							found = found.append(
								violation(
									BodyRootOutsideModule,
									BodyTable,
									row,
									NodeTable,
									root_index,
								),
							)
					None:
						found = found.append(
							violation(
								DanglingReference,
								BodyTable,
								row,
								ModuleTable,
								definition.module.module_id_index(),
							),
						)
			None:
				found = found.append(
					violation(
						DanglingReference,
						BodyTable,
						row,
						DefinitionTable,
						definition_index,
					),
				)

		row += 1

	found


---
Whether `argument` is a valid `kind` of argument: a construct that decodes,
or an id of a row that exists.
---
private pure func argument_is_valid(
	builder: DiscoveryBuilder,
	kind: DiagnosticArgumentKind,
	argument: Int,
) -> Bool:
	match kind:
		ConstructArgument:
			parsed_construct_at_argument(argument).is_some()
		ImportArgument:
			index_in(argument, builder.imports.length())
		PathArgument:
			index_in(argument, builder.paths.length())
		LiteralArgument:
			index_in(argument, builder.literals.length())
		NameArgument:
			index_in(argument, builder.name_spellings.length())
		NumberArgument:
			True


---
A diagnostic row stores the arguments its code documents, each valid. A
row whose range runs outside the argument table is reported by
`check_range`, not here.
---
private pure func check_row_arguments(
	builder: DiscoveryBuilder,
	found: List[TableInvariantViolation],
	table: DiscoveryTable,
	row: Int,
	code: DiscoveryDiagnosticCode,
	arguments: RowRange,
) -> List[TableInvariantViolation]:
	kinds: List[DiagnosticArgumentKind] = diagnostic_argument_kinds(code)

	if arguments.count != kinds.length():
		found.append(
			violation(
				ArgumentCountMismatch,
				table,
				row,
				DiagnosticArgumentTable,
				arguments.count,
			),
		)
	else:
		var out: List[TableInvariantViolation] = found
		var ordinal: Int = 0

		for kind in kinds:
			match builder.diagnostic_arguments.get(arguments.first + ordinal):
				Some(argument):
					if not builder.argument_is_valid(kind, argument):
						out = out.append(
							violation(
								ArgumentOutOfRange,
								table,
								row,
								DiagnosticArgumentTable,
								argument,
							),
						)
				None:
					void

			ordinal += 1

		out


private pure func check_diagnostic_rows(builder: DiscoveryBuilder) -> List[TableInvariantViolation]:
	var found: List[TableInvariantViolation] = []
	argument_count: Int = builder.diagnostic_arguments.length()
	var row: Int = 0

	for diagnostic in builder.diagnostics:
		found = check_range(
			found,
			DiagnosticTable,
			row,
			DiagnosticArgumentTable,
			diagnostic.arguments,
			argument_count,
		)
		found = builder.check_row_arguments(
			found,
			DiagnosticTable,
			row,
			diagnostic.code,
			diagnostic.arguments,
		)
		row += 1

	row = 0

	for diagnostic in builder.resolution_diagnostics:
		found = check_range(
			found,
			ResolutionDiagnosticTable,
			row,
			DiagnosticArgumentTable,
			diagnostic.arguments,
			argument_count,
		)
		found = builder.check_row_arguments(
			found,
			ResolutionDiagnosticTable,
			row,
			diagnostic.code,
			diagnostic.arguments,
		)
		row += 1

	found


---
A `NameSpanOutsideItsSpan` for each name span that is not inside the span of
what it names a part of; and, for the node name span table, a dangling node, an
unsorted or repeated node, and a node of a kind with no separate name span.
---
private pure func check_name_spans(builder: DiscoveryBuilder) -> List[TableInvariantViolation]:
	var found: List[TableInvariantViolation] = []
	var row: Int = 0

	for parameter in builder.type_parameters:
		found = check_name_within(
			found,
			TypeParameterTable,
			row,
			parameter.name_span,
			parameter.span,
		)
		row += 1

	row = 0

	for bound in builder.bounds:
		found = check_name_within(found, BoundTable, row, bound.name_span, bound.span)
		row += 1

	row = 0

	for supertrait in builder.supertraits:
		found = check_name_within(
			found,
			SupertraitTable,
			row,
			supertrait.name_span,
			supertrait.span,
		)
		row += 1

	row = 0

	for item in builder.import_items:
		found = check_name_within(found, ImportItemTable, row, item.name_span, item.span)
		row += 1

	row = 0

	for argument in builder.foreign_arguments:
		found = check_name_within(
			found,
			ForeignArgumentTable,
			row,
			argument.name_span,
			argument.span,
		)
		row += 1

	row = 0

	for import_row in builder.imports:
		found = check_name_within(found, ImportTable, row, import_row.path_span, import_row.span)
		row += 1

	row = 0

	for alias_row in builder.import_aliases:
		match builder.imports.get(alias_row.owner_import.import_id_index()):
			Some(import_row):
				found = check_name_within(
					found,
					ImportAliasTable,
					row,
					alias_row.span,
					import_row.span,
				)
			None:
				void

		row += 1

	row = 0

	for alias_row in builder.import_item_aliases:
		match builder.import_items.get(alias_row.item.import_item_id_index()):
			Some(item):
				found = check_name_within(
					found,
					ImportItemAliasTable,
					row,
					alias_row.span,
					item.span,
				)
			None:
				void

		row += 1

	found


---
Whether a node of this kind can have a `NodeNameSpanRow`: its name can be
narrower than the node.
---
private pure func has_separate_name_span(kind: NodeKind, child_count: Int) -> Bool:
	match kind:
		NamedTypeNode | QualifiedTypeNode | BoundedTypeNode | QualifiedTypeBoundNode:
			True
		VariadicDimensionNameTypeNode | VariadicDimensionWildcardTypeNode:
			True
		FieldAccessNode | RecordFieldNode | SelectReceiveArmNode | WithBindingNode | WithTryBindingNode | WithErrorMapNode:
			True
		ConcurrentParameterNode | VarDeclarationNode | TypedBindingNode | AssignmentNode | QuestionBindNode:
			True
		LambdaParameterNode:
			child_count > 0
		AddAssignNode | SubtractAssignNode | MultiplyAssignNode | DivideAssignNode:
			True
		ConstructorPatternNode | QualifiedConstructorPatternNode | ListSpreadNameNode | ListSpreadWildcardNode:
			True
		_:
			False


---
Appends a `NameSpanOutsideItsSpan` unless `name` is inside `whole`.
---
private pure func check_name_within(
	found: List[TableInvariantViolation],
	table: DiscoveryTable,
	row: Int,
	name: Span,
	whole: Span,
) -> List[TableInvariantViolation]:
	if name.span_within(whole):
		found
	else:
		found.append(violation(NameSpanOutsideItsSpan, table, row, table, name.span_start()))


---
The dimension name rows and the names that need them. A `DanglingReference` for
a row naming no name; a `SigilSpellingMismatch` for a row whose sigil name is not
`#` and its plain name's spelling; a `DimensionSigilNameMissing` for each
dimension name, in a type or a type parameter, with no row (a parameter whose
name recovery left empty is reported by the parser instead).
---
private pure func check_dimension_names(
	builder: DiscoveryBuilder,
) -> List[TableInvariantViolation]:
	var found: List[TableInvariantViolation] = []
	name_count: Int = builder.name_spellings.length()
	var paired: Set[Int] = {}
	var row: Int = 0

	for pair in builder.dimension_names:
		found = check_reference(
			found,
			DimensionNameTable,
			row,
			NameTable,
			pair.name.name_id_index(),
			name_count,
		)
		found = check_reference(
			found,
			DimensionNameTable,
			row,
			NameTable,
			pair.sigil_name.name_id_index(),
			name_count,
		)
		paired = paired.add(pair.name.name_id_index())

		match (
			builder.name_spellings.get(pair.name.name_id_index()),
			builder.name_spellings.get(pair.sigil_name.name_id_index()),
		):
			(Some(plain), Some(sigiled)):
				if sigiled != DIMENSION_SIGIL + plain:
					found = found.append(
						violation(
							SigilSpellingMismatch,
							DimensionNameTable,
							row,
							NameTable,
							pair.sigil_name.name_id_index(),
						),
					)
			_:
				void

		row += 1

	row = 0

	for node in builder.nodes:
		match node.kind:
			DimensionNameTypeNode | VariadicDimensionNameTypeNode:
				if not paired.contains(node.payload):
					found = found.append(
						violation(DimensionSigilNameMissing, NodeTable, row, NameTable, node.payload),
					)
			_:
				void

		row += 1

	row = 0

	for parameter in builder.type_parameters:
		name: Int = parameter.name.name_id_index()

		if (
			parameter.kind == DimensionParameter
			and name != EMPTY_NAME_INDEX
			and not paired.contains(name)
		):
			found = found.append(
				violation(DimensionSigilNameMissing, TypeParameterTable, row, NameTable, name),
			)

		row += 1

	found


---
Else keyword rows: sorted by node, each naming an `IfNode` with an else branch
(a third child) and lying inside it, and every such `IfNode` having one. Rows
are sorted (checked here), so one walk over the nodes finds each node's row.
---
private pure func check_else_keywords(builder: DiscoveryBuilder) -> List[TableInvariantViolation]:
	var found: List[TableInvariantViolation] = []
	var row: Int = 0

	for keyword_row in builder.else_keywords:
		node: Int = keyword_row.node.node_id_index()

		match builder.nodes.get(node):
			Some(node_row):
				if node_row.kind != IfNode or node_row.children.count <= ELSE_BRANCH_ORDINAL:
					found = found.append(
						violation(
							ElseKeywordMismatch,
							ElseKeywordTable,
							row,
							NodeTable,
							node,
						),
					)
				else:
					found = check_name_within(
						found,
						ElseKeywordTable,
						row,
						keyword_row.keyword_span,
						node_row.span,
					)
			None:
				found = found.append(
					violation(
						DanglingReference,
						ElseKeywordTable,
						row,
						NodeTable,
						node,
					),
				)

		row += 1

	found = sorted_by_owner(
		found,
		ElseKeywordTable,
		builder.else_keywords.map(pure func(keyword_row): keyword_row.node.node_id_index()),
	)

	var next_row: Int = 0
	var node_index: Int = 0

	for node in builder.nodes:
		if node.kind == IfNode and node.children.count > ELSE_BRANCH_ORDINAL:
			has_row: Bool = match builder.else_keywords.get(next_row):
				Some(keyword_row):
					keyword_row.node.node_id_index() == node_index
				None:
					False

			if has_row:
				next_row += 1
			else:
				found = found.append(
					violation(
						ElseKeywordMismatch,
						NodeTable,
						node_index,
						ElseKeywordTable,
						node_index,
					),
				)

		node_index += 1

	found


---
Concurrency count rows: sorted by node, each naming a `ConcurrentParameterNode`
and positive.
---
private pure func check_concurrency_counts(
	builder: DiscoveryBuilder,
) -> List[TableInvariantViolation]:
	var found: List[TableInvariantViolation] = []
	var previous: Int = NO_NODE_ROW
	var row: Int = 0

	for count_row in builder.concurrency_counts:
		owner: Int = count_row.parameter.node_id_index()

		match builder.nodes.get(owner):
			Some(node):
				if node.kind != ConcurrentParameterNode or count_row.count <= 0:
					found = found.append(
						violation(
							ConcurrencyCountMismatch,
							ConcurrencyCountTable,
							row,
							NodeTable,
							owner,
						),
					)
			None:
				found = found.append(
					violation(DanglingReference, ConcurrencyCountTable, row, NodeTable, owner),
				)

		if owner <= previous:
			found = found.append(
				violation(
					SideTableUnsorted,
					ConcurrencyCountTable,
					row,
					ConcurrencyCountTable,
					owner,
				),
			)

		previous = owner
		row += 1

	found


---
The child ordinal of an `IfNode`'s else branch: after the condition and the
then block.
---
private ELSE_BRANCH_ORDINAL: Int = 2


---
The node name span rows. They are sorted by node (`SideTableUnsorted`), so one
walk over the nodes meets each node's row in turn: a row on a node whose kind has
no separate name span is a `NameSpanOnWrongNodeKind`, a name outside its node's
span a `NameSpanOutsideItsSpan`, and a node whose kind has a name always narrower
than the node but no row a `NodeNameSpanMissing`. A row naming no node is a
`DanglingReference`; a row the walk does not reach (a node's second row) is the
unsorted table already reported.
---
private pure func check_node_name_rows(
	builder: DiscoveryBuilder,
) -> List[TableInvariantViolation]:
	var found: List[TableInvariantViolation] = []
	var next_row: Int = 0
	var next_row_node: Int = builder.name_span_row_node(0)
	var row: Int = 0

	for node in builder.nodes:
		if next_row_node == row:
			name_span: Span = builder.node_name_spans.get_or(next_row, NO_NAME_SPAN_ROW).name_span
			found = check_name_within(found, NodeNameSpanTable, next_row, name_span, node.span)

			if not node.kind.has_separate_name_span(node.children.count):
				found = found.append(
					violation(
						NameSpanOnWrongNodeKind,
						NodeNameSpanTable,
						next_row,
						NodeTable,
						row,
					),
				)

			next_row += 1
			next_row_node = builder.name_span_row_node(next_row)
		else if node.kind.needs_name_span_row(node.children.count):
			found = found.append(
				violation(
					NodeNameSpanMissing,
					NodeTable,
					row,
					NodeNameSpanTable,
					row,
				),
			)

		row += 1

	row = 0
	node_count: Int = builder.nodes.length()
	var previous: Int = NO_NODE_ROW

	-- The sorted check is `sorted_by_owner`'s, written as a loop over the rows:
	-- mapping the 100k rows to their owners first allocates for each one.
	for name_row in builder.node_name_spans:
		owner: Int = name_row.node.node_id_index()

		if owner >= node_count:
			found = found.append(
				violation(
					DanglingReference,
					NodeNameSpanTable,
					row,
					NodeTable,
					owner,
				),
			)

		if owner <= previous:
			found = found.append(
				violation(
					SideTableUnsorted,
					NodeNameSpanTable,
					row,
					NodeNameSpanTable,
					owner,
				),
			)

		previous = owner
		row += 1

	found


---
The node name span row `row` belongs to, or `NO_NODE_ROW` when there is no such
row: read once per row, so the walk over the nodes compares integers.
---
private pure func name_span_row_node(builder: DiscoveryBuilder, row: Int) -> Int:
	builder.node_name_spans.get_or(row, NO_NAME_SPAN_ROW).node.node_id_index()


---
Stands for the node of a side table row past the table's end: no node has it.
---
private NO_NODE_ROW: Int = -1


---
Stands for a node name span row past the table's end. `get_or` reads it where a
`get` would allocate an `Option` for every row it finds.
---
private NO_NAME_SPAN_ROW: NodeNameSpanRow = {
	node = node_id_at_row(NO_NODE_ROW),
	name_span = pack_span(0, 0, 0)
}


---
Whether a node of this kind with `child_count` children must have a
`NodeNameSpanRow`: its name is always narrower than the node, or the parser
records the row whether or not it is. A body node's name is narrower because
something always comes with it: a receiver before a field, a value after a
binding target, a binder's header, a constructor's parentheses or qualifier, the
dots of a spread. Only an untyped lambda parameter is its name alone, and it has
no row.
---
pure func needs_name_span_row(kind: NodeKind, child_count: Int) -> Bool:
	match kind:
		QualifiedTypeNode | BoundedTypeNode | QualifiedTypeBoundNode:
			True
		VariadicDimensionNameTypeNode | VariadicDimensionWildcardTypeNode:
			True
		NamedTypeNode:
			child_count > 0
		FieldAccessNode | RecordFieldNode | SelectReceiveArmNode | WithBindingNode | WithTryBindingNode | WithErrorMapNode:
			True
		ConcurrentParameterNode | VarDeclarationNode | TypedBindingNode | AssignmentNode | QuestionBindNode:
			True
		AddAssignNode | SubtractAssignNode | MultiplyAssignNode | DivideAssignNode:
			True
		ConstructorPatternNode | QualifiedConstructorPatternNode | ListSpreadNameNode | ListSpreadWildcardNode:
			True
		LambdaParameterNode:
			child_count > 0
		_:
			False


---
A `QualifierOutsideReference` for each bound or supertrait qualifier whose span
is not inside its parent's. A qualifier naming no parent is a dangling
reference the row checks already report.
---
private pure func check_qualifier_spans(
	builder: DiscoveryBuilder,
) -> List[TableInvariantViolation]:
	var found: List[TableInvariantViolation] = []
	var row: Int = 0

	for qualifier in builder.bound_qualifiers:
		parent: Int = qualifier.bound.bound_id_index()

		match builder.bounds.get(parent):
			Some(bound):
				if not qualifier.span.span_within(bound.span):
					found = found.append(
						violation(
							QualifierOutsideReference,
							BoundQualifierTable,
							row,
							BoundTable,
							parent,
						),
					)
			None:
				void

		row += 1

	row = 0

	for qualifier in builder.supertrait_qualifiers:
		parent: Int = qualifier.supertrait.supertrait_id_index()

		match builder.supertraits.get(parent):
			Some(supertrait):
				if not qualifier.span.span_within(supertrait.span):
					found = found.append(
						violation(
							QualifierOutsideReference,
							SupertraitQualifierTable,
							row,
							SupertraitTable,
							parent,
						),
					)
			None:
				void

		row += 1

	found


---
Whether `inner` lies inside `outer`: the same source, starting no earlier and
ending no later.
---
private pure func span_within(inner: Span, outer: Span) -> Bool:
	(
		inner.span_source_index() == outer.span_source_index()
		and inner.span_start() >= outer.span_start()
		and inner.span_end() <= outer.span_end()
	)


---
Appends a `SpanOutsideSources` violation unless `span` names a source.
---
private pure func check_span(
	found: List[TableInvariantViolation],
	table: DiscoveryTable,
	row: Int,
	span: Span,
	source_lengths: List[Int],
) -> List[TableInvariantViolation]:
	source_index: Int = span.span_source_index()

	match source_lengths.get(source_index):
		Some(length):
			if span.span_end() <= length:
				found
			else:
				found.append(violation(SpanPastSourceEnd, table, row, SourceTable, span.span_end()))
		None:
			found.append(violation(SpanOutsideSources, table, row, SourceTable, source_index))


---
Every span stored in a row names a source and ends within its text.
---
private pure func check_spans(builder: DiscoveryBuilder) -> List[TableInvariantViolation]:
	var found: List[TableInvariantViolation] = []
	sources: List[Int] = builder.source_texts.map(pure func(text): text.length())
	var row: Int = 0

	for import_row in builder.imports:
		found = check_span(found, ImportTable, row, import_row.span, sources)
		found = check_span(found, ImportTable, row, import_row.path_span, sources)
		row += 1

	row = 0

	for item in builder.import_items:
		found = check_span(found, ImportItemTable, row, item.span, sources)
		found = check_span(found, ImportItemTable, row, item.name_span, sources)
		row += 1

	row = 0

	for alias_row in builder.import_aliases:
		found = check_span(found, ImportAliasTable, row, alias_row.span, sources)
		row += 1

	row = 0

	for alias_row in builder.import_item_aliases:
		found = check_span(found, ImportItemAliasTable, row, alias_row.span, sources)
		row += 1

	row = 0

	for variant in builder.import_item_variants:
		found = check_span(found, ImportItemVariantTable, row, variant.span, sources)
		row += 1

	row = 0

	for block in builder.import_blocks:
		found = check_span(found, ImportBlockTable, row, block.span, sources)
		row += 1

	row = 0

	for definition in builder.definitions:
		found = check_span(found, DefinitionTable, row, definition.span, sources)
		found = check_span(found, DefinitionTable, row, definition.name_span, sources)
		row += 1

	row = 0

	for documentation in builder.module_documentation:
		found = check_span(found, ModuleDocumentationTable, row, documentation.span, sources)
		row += 1

	row = 0

	for annotation in builder.annotations:
		found = check_span(found, AnnotationTable, row, annotation.span, sources)
		row += 1

	row = 0

	for parameter in builder.type_parameters:
		found = check_span(found, TypeParameterTable, row, parameter.span, sources)
		found = check_span(found, TypeParameterTable, row, parameter.name_span, sources)
		row += 1

	row = 0

	for bound in builder.bounds:
		found = check_span(found, BoundTable, row, bound.span, sources)
		found = check_span(found, BoundTable, row, bound.name_span, sources)
		row += 1

	row = 0

	for qualifier in builder.bound_qualifiers:
		found = check_span(found, BoundQualifierTable, row, qualifier.span, sources)
		row += 1

	row = 0

	for supertrait in builder.supertraits:
		found = check_span(found, SupertraitTable, row, supertrait.span, sources)
		found = check_span(found, SupertraitTable, row, supertrait.name_span, sources)
		row += 1

	row = 0

	for qualifier in builder.supertrait_qualifiers:
		found = check_span(found, SupertraitQualifierTable, row, qualifier.span, sources)
		row += 1

	row = 0

	for signature in builder.signatures:
		found = check_span(found, SignatureTable, row, signature.keyword_span, sources)
		row += 1

	row = 0

	for parameter in builder.parameters:
		found = check_span(found, ParameterTable, row, parameter.binder_span, sources)
		found = check_span(found, ParameterTable, row, parameter.span, sources)
		row += 1

	row = 0

	for binder_name in builder.binder_names:
		found = check_span(found, BinderNameTable, row, binder_name.span, sources)
		row += 1

	row = 0

	for constraint in builder.dimension_constraints:
		found = check_span(found, DimensionConstraintTable, row, constraint.span, sources)
		row += 1

	row = 0

	for block in builder.foreign_blocks:
		found = check_span(found, ForeignBlockTable, row, block.span, sources)
		row += 1

	row = 0

	for argument in builder.foreign_arguments:
		found = check_span(found, ForeignArgumentTable, row, argument.span, sources)
		found = check_span(found, ForeignArgumentTable, row, argument.name_span, sources)
		row += 1

	row = 0

	for c_name in builder.foreign_c_names:
		found = check_span(found, ForeignCNameTable, row, c_name.span, sources)
		row += 1

	row = 0

	for cleanup in builder.resource_cleanups:
		found = check_span(found, ResourceCleanupTable, row, cleanup.span, sources)
		row += 1

	row = 0

	for node in builder.nodes:
		found = check_span(found, NodeTable, row, node.span, sources)
		row += 1

	row = 0

	for name_row in builder.node_name_spans:
		found = check_span(found, NodeNameSpanTable, row, name_row.name_span, sources)
		row += 1

	row = 0

	for keyword_row in builder.else_keywords:
		found = check_span(found, ElseKeywordTable, row, keyword_row.keyword_span, sources)
		row += 1

	row = 0

	for diagnostic in builder.diagnostics:
		found = check_span(found, DiagnosticTable, row, diagnostic.span, sources)
		row += 1

	row = 0

	for diagnostic in builder.resolution_diagnostics:
		found = check_span(found, ResolutionDiagnosticTable, row, diagnostic.span, sources)
		row += 1

	found
