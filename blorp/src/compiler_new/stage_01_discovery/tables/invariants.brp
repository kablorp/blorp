		ImportPathPartTable:
			"ImportPathPartTable"
		ImportItemTable:
			"ImportItemTable"
		ImportItemVariantTable:
			"ImportItemVariantTable"
		ImportTargetTable:
			"ImportTargetTable"
		ImportAliasTable:
