-- The invariants every frozen set of discovery tables satisfies.
--
-- `check_table_invariants` reads each table once, so its cost is linear in
-- the total number of rows. Readers of frozen tables rely on these facts
-- instead of re-checking them: every stored id names a row of the right
-- table, every range lies inside its child table, each module's blocks are
-- disjoint from the previous module's, children precede their parents, body
-- roots lie in their definition's module, and the seeded names sit at their
-- pinned ids.
import:
	builder:
		DiscoveryBuilder,
		NO_NODE_PAYLOAD,
		NodeNameSpanRow,
		NodeRow,
		RowRange,
		bound_id_index,
		definition_id_index,
		find_name_id,
		foreign_block_id_index,
		implicit_request_id_index,
		import_id_index,
		import_item_id_index,
		literal_id_index,
		module_id_index,
		name_id_index,
		node_id_at_row,
		node_id_index,
		package_id_index,
		parameter_id_index,
		path_id_index,
		root_id_index,
		source_id_index,
		supertrait_id_index,
	name_vocabulary: DIMENSION_SIGIL, EMPTY_NAME_INDEX
	diagnostic_code:
		DiagnosticArgumentKind(
			ConstructArgument,
			ImportArgument,
			LiteralArgument,
			NameArgument,
			NumberArgument,
			PathArgument,
		),
		DiscoveryDiagnosticCode,
		diagnostic_argument_kinds,
	intern_index: find_slice, occupied_slot_count, text_hash
	list: repeat
	row_kinds:
		DefinitionKind(
			ForeignFunctionDefinition,
			FunctionDefinition,
			ImplMethodDefinition,
			LocalFunctionDefinition,
			TraitMethodDefinition,
		),
		NodeKind(
			AddAssignNode,
			AssignmentNode,
			BoundedTypeNode,
			ConcurrentParameterNode,
			ConstructorPatternNode,
			DimensionNameTypeNode,
			DivideAssignNode,
			FieldAccessNode,
			IfNode,
			LambdaParameterNode,
			ListSpreadNameNode,
			ListSpreadWildcardNode,
			MultiplyAssignNode,
			NamedTypeNode,
			QualifiedConstructorPatternNode,
			QualifiedTypeBoundNode,
			QualifiedTypeNode,
			QuestionBindNode,
			RecordFieldNode,
			SelectReceiveArmNode,
			SubtractAssignNode,
			TypedBindingNode,
			VarDeclarationNode,
			VariadicDimensionNameTypeNode,
			VariadicDimensionWildcardTypeNode,
			WithBindingNode,
			WithErrorMapNode,
			WithTryBindingNode,
		),
		NodePayloadReference(
			CodepointPayload,
			DefinitionPayload,
			LiteralPayload,
			NamePayload,
			NoPayload,
		),
		TypeParameterKind(DimensionParameter),
		node_payload_reference,
		parsed_construct_at_argument,
	span: Span, pack_span, span_end, span_source_index, span_start
	token: is_unicode_scalar


---
Every discovery table, for naming where a violation was found.
---
enum DiscoveryTable:
	NameTable
	PathTable
	SourceTextTable
	SourceTable
	LineStartTable
	PackageTable
	ModuleTable
	ModulePackageTable
	RootTable
	RootTargetTable
	RootDiagnosticTable
	ImplicitRequestTable
	ImplicitTargetTable
	ImplicitDiagnosticTable
	ImportTable
	ImportPathPartTable
	ImportItemTable
	ImportItemVariantTable
	ImportTargetTable
	ImportAliasTable
	ImportItemAliasTable
	ImportBlockTable
	DefinitionTable
	MemberTable
	DocumentationTable
	ModuleDocumentationTable
	AnnotationTable
	TypeParameterTable
	BoundTable
	BoundQualifierTable
	SupertraitTable
	SupertraitQualifierTable
	SignatureTable
	ParameterTable
	BinderNameTable
	ParameterTypeTable
	DefinitionTypeTable
	VariantPayloadTable
	DimensionConstraintTable
	ForeignBlockTable
	ForeignArgumentTable
	ForeignBindingTable
	ForeignCNameTable
	ResourceCleanupTable
	BodyTable
	NodeTable
	NodeChildTable
	NodeNameSpanTable
	ElseKeywordTable
	ConcurrencyCountTable
	DimensionNameTable
	LiteralTable
	DiagnosticTable
	ResolutionDiagnosticTable
	DiagnosticArgumentTable


