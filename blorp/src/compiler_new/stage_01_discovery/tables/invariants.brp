-- The invariants every frozen set of discovery tables satisfies.
--
-- `check_table_invariants` reads each table once, so its cost is linear in
-- the total number of rows. Readers of frozen tables rely on these facts
-- instead of re-checking them: every stored id names a row of the right
-- table, every range lies inside its child table, each module's blocks are
-- disjoint from the previous module's, children precede their parents, body
-- roots lie in their definition's module, and the seeded names sit at their
-- pinned ids.
--
-- This module runs the checks. They are grouped by what they verify, in
-- `invariants/`: `references` (stored ids and ranges of the rows that name
-- other rows), `cardinalities` (counts, contiguity and owner order),
-- `spans_and_names` (spans, name spans, node schema, interning), over
-- `violation`, which holds `TableInvariantViolation` and the primitive checks.
import:
	builder: DiscoveryBuilder
	invariants/cardinalities:
		check_cardinalities,
		check_concurrency_counts,
		check_module_ranges,
		check_node_references,
	invariants/references:
		check_body_rows,
		check_declaration_rows,
		check_diagnostic_rows,
		check_implicit_rows,
		check_import_rows,
		check_module_rows,
		check_root_rows,
		check_source_rows,
	invariants/spans_and_names:
		check_dimension_names,
		check_else_keywords,
		check_intern_indexes,
		check_name_spans,
		check_node_name_row_order,
		check_node_rows,
		check_qualifier_spans,
		check_seeded_names,
		check_spans,
	invariants/violation: TableInvariantViolation


---
Every invariant violation in `builder`, checked against the vocabulary
`seeded_spellings` its name table must start with. Empty for a well-formed
builder.
---
pure func check_table_invariants(
	builder: DiscoveryBuilder,
	seeded_spellings: List[String],
) -> List[TableInvariantViolation]:
	builder
		.check_seeded_names(seeded_spellings)
		.concat(builder.check_intern_indexes())
		.concat(builder.check_source_rows())
		.concat(builder.check_module_rows())
		.concat(builder.check_module_ranges())
		.concat(builder.check_root_rows())
		.concat(builder.check_implicit_rows())
		.concat(builder.check_import_rows())
		.concat(builder.check_declaration_rows())
		.concat(builder.check_node_rows())
		.concat(builder.check_node_references())
		.concat(builder.check_cardinalities())
		.concat(builder.check_body_rows())
		.concat(builder.check_diagnostic_rows())
		.concat(builder.check_spans())
		.concat(builder.check_qualifier_spans())
		.concat(builder.check_name_spans())
		.concat(builder.check_dimension_names())
		.concat(builder.check_node_name_row_order())
		.concat(builder.check_else_keywords())
		.concat(builder.check_concurrency_counts())
