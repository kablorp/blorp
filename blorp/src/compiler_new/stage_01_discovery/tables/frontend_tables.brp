---
The package of `module`, if it belongs to one.
---
pure func module_package(tables: FrontendTables, module: ModuleId) -> Option[PackageRow]:
	builder: DiscoveryTables = tables.tables_of()

	match (
		owned_row(
			builder.module_packages,
			module.module_id_index(),
			pure func(index): builder.module_package_owner(index),
		)
	):
		Some(membership):
			builder.packages.get(membership.package.package_id_index())
		None:
			None


private pure func module_package_owner(builder: DiscoveryTables, row: Int) -> Int:
	match builder.module_packages.get(row):
		Some(membership):
			membership.module.module_id_index()
		None:
			unreachable_owner(ModulePackageTable, row)


---
What an owner reader returns for a row outside its table: the search reads only
rows below the table's length, so it is never returned, and a debug build stops
if it is.
---
private pure func unreachable_owner(table: DiscoveryTable, row: Int) -> Int:
	report_unreachable_lookup(table, row, "the owner search reads rows below the table's length")
	0


---
The row of `rows`, a side table sorted by owner, whose owner is `wanted`, or
`None`: a binary search over its rows, the owner of row `index` read through
`owner_at`.
---
private pure func owned_row[Row](
	rows: List[Row],
	wanted: Int,
	owner_at: pure (Int) -> Int,
) -> Option[Row]:
	count: Int = rows.length()
	var lower: Int = 0
	var upper: Int = count

	while lower < upper:
		middle: Int = (lower + upper) / 2

		if owner_at(middle) < wanted:
			lower = middle + 1
		else:
			upper = middle

	if lower < count and owner_at(lower) == wanted:
		rows.get(lower)
	else:
		None


---
Row counts of every table, by table name, for dumps and measurements.
---
pure func table_row_counts(tables: FrontendTables) -> List[(DiscoveryTable, Int)]:
	builder: DiscoveryTables = tables.tables_of()
	[
		(NameTable, builder.name_spellings.length()),
		(PathTable, builder.paths.length()),
		(SourceTable, builder.sources.length()),
		(LineStartTable, builder.line_starts.length()),
		(PackageTable, builder.packages.length()),
		(ModuleTable, builder.modules.length()),
		(ModulePackageTable, builder.module_packages.length()),
		(RootTable, builder.roots.length()),
		(ImplicitRequestTable, builder.implicit_requests.length()),
		(ImportTable, builder.imports.length()),
		(ImportPathPartTable, builder.import_path_parts.length()),
		(ImportItemTable, builder.import_items.length()),
		(ImportItemVariantTable, builder.import_item_variants.length()),
		(ImportTargetTable, builder.import_targets.length()),
		(ImportAliasTable, builder.import_aliases.length()),
		(ImportItemAliasTable, builder.import_item_aliases.length()),
		(ImportBlockTable, builder.import_blocks.length()),
		(DefinitionTable, builder.definitions.length()),
		(MemberTable, builder.members.length()),
		(DocumentationTable, builder.documentation.length()),
		(ModuleDocumentationTable, builder.module_documentation.length()),
		(AnnotationTable, builder.annotations.length()),
		(TypeParameterTable, builder.type_parameters.length()),
		(BoundTable, builder.bounds.length()),
		(BoundQualifierTable, builder.bound_qualifiers.length()),
		(SupertraitTable, builder.supertraits.length()),
		(SupertraitQualifierTable, builder.supertrait_qualifiers.length()),
		(ImplTable, builder.impls.length()),
		(SignatureTable, builder.signatures.length()),
		(ParameterTable, builder.parameters.length()),
		(BinderNameTable, builder.binder_names.length()),
		(ParameterTypeTable, builder.parameter_types.length()),
		(DefinitionTypeTable, builder.definition_types.length()),
		(VariantPayloadTable, builder.variant_payloads.length()),
		(DimensionConstraintTable, builder.dimension_constraints.length()),
		(ForeignBlockTable, builder.foreign_blocks.length()),
		(ForeignArgumentTable, builder.foreign_arguments.length()),
		(ForeignBindingTable, builder.foreign_bindings.length()),
		(ForeignCNameTable, builder.foreign_c_names.length()),
		(ResourceCleanupTable, builder.resource_cleanups.length()),
		(BodyTable, builder.bodies.length()),
		(NodeTable, builder.nodes.length()),
		(NodeChildTable, builder.node_children.length()),
		(NodeNameSpanTable, builder.node_name_spans.length()),
		(ElseKeywordTable, builder.else_keywords.length()),
		(DimensionNameTable, builder.dimension_names.length()),
		(LiteralTable, builder.literals.length()),
		(DiagnosticTable, builder.diagnostics.length()),
		(ResolutionDiagnosticTable, builder.resolution_diagnostics.length()),
	]


pure func diagnostic_row_at(tables: FrontendTables, index: Int) -> Option[SyntaxDiagnosticRow]:
	tables.tables_of().diagnostics.get(index)


---
The module graph's diagnostics, outside every module's block: imports that loaded
no module and sources that could not be admitted. Their spans point at the
requesting import.
---
pure func resolution_diagnostic_count(tables: FrontendTables) -> Int:
	tables.tables_of().resolution_diagnostics.length()


pure func resolution_diagnostic_row_at(
	tables: FrontendTables,
	index: Int,
