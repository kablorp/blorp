The module root `root` loaded, or `None` when it loaded none.
---
pure func root_target(tables: FrontendTables, root: RootId) -> Option[ModuleId]:
	builder: DiscoveryBuilder = tables.tables_of()
	row: Int = owner_row(
		builder.root_targets.length(),
		root.root_id_index(),
		pure func(index): builder.root_target_owner(index),
	)

	match builder.root_targets.get(row):
		Some(target):
			Some(target.target)
		None:
			None


private pure func root_target_owner(builder: DiscoveryBuilder, row: Int) -> Int:
	match builder.root_targets.get(row):
		Some(target):
			target.root.root_id_index()
		None:
			NO_OWNER_ROW


---
The module loaded from `canonical_path`, if any.
---
pure func module_at_path(tables: FrontendTables, canonical_path: String) -> Option[ModuleId]:
	builder: DiscoveryBuilder = tables.tables_of()

	match builder.path_ids_by_text.get(canonical_path):
		Some(path_index):
			match builder.module_ids_by_path.get(path_index):
				Some(module_index):
					Some(module_id_at_row(module_index))
				None:
					None
		None:
			None


