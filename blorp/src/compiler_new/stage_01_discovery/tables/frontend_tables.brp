-- Frozen discovery tables and their read-only accessors.
--
-- `freeze` seals a builder once discovery is done. It first runs
-- `check_table_invariants` and refuses to freeze a builder that breaks them.
-- Readers rely on those invariants: an id they were handed names a row, so
-- the row accessors below never need an absent case. The fallback rows they
-- carry for an index outside a table are unreachable for ids read from
-- frozen tables; they exist because a list read is total.
import:
	builder:
		AnnotationRow,
		BinderNameRow,
		BodyRow,
		BoundId,
		BoundQualifierRow,
		BoundRow,
		DefinitionId,
		DefinitionRow,
		DefinitionTypeRow,
		DiagnosticRow,
		DimensionConstraintRow,
		DiscoveryBuilder,
		DocumentationRow,
		EMPTY_ROW_RANGE,
		ForeignArgumentRow,
		ForeignBindingRow,
		ForeignBlockRow,
		ForeignCNameRow,
		ImplicitDiagnosticRow,
		ImplicitRequestId,
		ImplicitRequestRow,
		ImportAliasRow,
		ImportBlockRow,
		ImportId,
		ImportItemAliasRow,
		ImportItemId,
		ImportItemRow,
		ImportItemVariantRow,
		ImportRow,
		LiteralId,
		DimensionNameRow,
		MemberRow,
		ModuleDocumentationRow,
		ModuleId,
		ModuleRow,
		NameId,
		NodeId,
		NodeNameSpanRow,
		NodeRow,
		PackageRow,
		ParameterRow,
		ParameterTypeRow,
		PathId,
		ResourceCleanupRow,
		RootDiagnosticRow,
		RootId,
		RootRow,
		RowRange,
		SignatureRow,
		SourceId,
		SourceRow,
		SupertraitId,
		SupertraitQualifierRow,
		SupertraitRow,
		TypeParameterRow,
		VariantPayloadRow,
		bound_id_index,
		definition_id_index,
		find_name_id,
		implicit_request_id_index,
		import_id_index,
		import_item_id_index,
		literal_id_index,
		module_id_at_row,
		module_id_index,
		name_id_at_row,
		name_id_index,
		node_id_index,
		package_id_index,
		path_id_at_row,
		path_id_index,
		root_id_index,
		source_id_at_row,
		source_id_index,
		supertrait_id_index,
		without_transient_tables,
	invariants: TableInvariantViolation, check_table_invariants
	name_vocabulary: ALL_SEEDED_NAME_SPELLINGS, WILDCARD_DIMENSION_NAME_INDEX
	row_kinds:
		DefinitionKind(FunctionDefinition),
		ImportRequestKind(BareModuleRequest),
		ModuleOriginKind(UserModule),
		ModuleReach(ImportedModule),
		NodeKind(MissingExpressionNode),
		Visibility(PublicVisibility),
	source_position: LineColumn, span_start_position
	span: Span, pack_span


---
The sealed discovery output. Only `freeze` makes one.
---
opaque type FrontendTables = DiscoveryBuilder


union FreezeOutcome:
	FrozenTables(FrontendTables)
	TableInvariantsViolated(List[TableInvariantViolation])


---
Seals `builder`, dropping its transient tables. A builder that breaks an
invariant is reported with every violation instead of being sealed; the
check reads each row a bounded number of times.
---
pure func freeze(builder: DiscoveryBuilder) -> FreezeOutcome:
	-- The transient tables are not part of the frozen output.
	sealed_tables: DiscoveryBuilder = builder.without_transient_tables()
	violations: List[TableInvariantViolation] = sealed_tables.check_table_invariants(
		ALL_SEEDED_NAME_SPELLINGS,
	)

	if violations.is_empty():
		FrozenTables(into_opaque FrontendTables(sealed_tables))
	else:
		TableInvariantsViolated(violations)


private pure func tables_of(tables: FrontendTables) -> DiscoveryBuilder:
	from_opaque FrontendTables(tables)


-- Unreachable fallback rows (see the module comment) are written inline in
-- each accessor's out-of-range arm because the backend cannot yet emit a
-- global struct constant whose initializer calls an opaque constructor
-- ("unsupported global initializer"); make them constants once it can.
---
Text read for an index outside a text table; unreachable for frozen ids.
---
private UNREACHABLE_TEXT_LITERAL: String = ""


-- Counts.
pure func module_count(tables: FrontendTables) -> Int:
	tables.tables_of().modules.length()


pure func definition_count(tables: FrontendTables) -> Int:
	tables.tables_of().definitions.length()


pure func node_count(tables: FrontendTables) -> Int:
	tables.tables_of().nodes.length()


pure func node_child_count(tables: FrontendTables) -> Int:
	tables.tables_of().node_children.length()


pure func name_count(tables: FrontendTables) -> Int:
	tables.tables_of().name_spellings.length()


pure func path_count(tables: FrontendTables) -> Int:
	tables.tables_of().paths.length()


pure func literal_count(tables: FrontendTables) -> Int:
	tables.tables_of().literals.length()


pure func source_count(tables: FrontendTables) -> Int:
	tables.tables_of().sources.length()


pure func root_count(tables: FrontendTables) -> Int:
	tables.tables_of().roots.length()


pure func implicit_request_count(tables: FrontendTables) -> Int:
	tables.tables_of().implicit_requests.length()


pure func implicit_diagnostic_count(tables: FrontendTables) -> Int:
	tables.tables_of().implicit_diagnostics.length()


pure func import_count(tables: FrontendTables) -> Int:
	tables.tables_of().imports.length()


pure func diagnostic_count(tables: FrontendTables) -> Int:
	tables.tables_of().diagnostics.length()


pure func root_diagnostic_count(tables: FrontendTables) -> Int:
	tables.tables_of().root_diagnostics.length()


-- Rows by id.
pure func module_row(tables: FrontendTables, id: ModuleId) -> ModuleRow:
	match tables.tables_of().modules.get(id.module_id_index()):
		Some(row):
			row
		None:
			{
				source = source_id_at_row(0),
				canonical_path = path_id_at_row(0),
				origin = UserModule,
				reach = ImportedModule,
				definitions = EMPTY_ROW_RANGE,
				imports = EMPTY_ROW_RANGE,
				nodes = EMPTY_ROW_RANGE,
				diagnostics = EMPTY_ROW_RANGE
			}


pure func definition_row(tables: FrontendTables, id: DefinitionId) -> DefinitionRow:
	match tables.tables_of().definitions.get(id.definition_id_index()):
		Some(row):
			row
		None:
			{
				module = module_id_at_row(0),
				kind = FunctionDefinition,
				name = name_id_at_row(0),
				name_span = pack_span(0, 0, 0),
				visibility = PublicVisibility,
				span = pack_span(0, 0, 0)
			}


pure func node_row(tables: FrontendTables, id: NodeId) -> NodeRow:
	match tables.tables_of().nodes.get(id.node_id_index()):
		Some(row):
			row
		None:
			{
				kind = MissingExpressionNode,
				span = pack_span(0, 0, 0),
				payload = 0,
				children = EMPTY_ROW_RANGE
			}


---
The definition, node or import at position `index`, or `None` past the end of
its table: for a reader that follows an id it did not issue itself.
---
pure func definition_row_at(tables: FrontendTables, index: Int) -> Option[DefinitionRow]:
	tables.tables_of().definitions.get(index)


pure func node_row_at(tables: FrontendTables, index: Int) -> Option[NodeRow]:
	tables.tables_of().nodes.get(index)


pure func import_row_at(tables: FrontendTables, index: Int) -> Option[ImportRow]:
	tables.tables_of().imports.get(index)


pure func import_row(tables: FrontendTables, id: ImportId) -> ImportRow:
	match tables.tables_of().imports.get(id.import_id_index()):
		Some(row):
			row
		None:
			{
				importer = module_id_at_row(0),
				request_kind = BareModuleRequest,
				request_path = path_id_at_row(0),
				parent_steps = 0,
				path_parts = EMPTY_ROW_RANGE,
				items = EMPTY_ROW_RANGE,
				path_span = pack_span(0, 0, 0),
				span = pack_span(0, 0, 0)
			}


pure func source_row(tables: FrontendTables, id: SourceId) -> SourceRow:
	match tables.tables_of().sources.get(id.source_id_index()):
		Some(row):
			row
		None:
			{
				path = path_id_at_row(0),
				line_starts = EMPTY_ROW_RANGE
			}


pure func root_row(tables: FrontendTables, id: RootId) -> RootRow:
	match tables.tables_of().roots.get(id.root_id_index()):
		Some(row):
			row
		None:
			{request_path = path_id_at_row(0)}


pure func implicit_request_row(tables: FrontendTables, id: ImplicitRequestId) -> ImplicitRequestRow:
	match tables.tables_of().implicit_requests.get(id.implicit_request_id_index()):
		Some(row):
			row
		None:
			{request_path = path_id_at_row(0)}


---
The module implicit request `request` loaded or found already loaded, or
`None` when it loaded none.
---
pure func implicit_target(tables: FrontendTables, request: ImplicitRequestId) -> Option[ModuleId]:
	builder: DiscoveryBuilder = tables.tables_of()
	row: Int = owner_row(
		builder.implicit_targets.length(),
		request.implicit_request_id_index(),
		pure func(index): builder.implicit_target_owner(index),
	)

	match builder.implicit_targets.get(row):
		Some(target):
			Some(target.target)
		None:
			None


private pure func implicit_target_owner(builder: DiscoveryBuilder, row: Int) -> Int:
	match builder.implicit_targets.get(row):
		Some(target):
			target.request.implicit_request_id_index()
		None:
			NO_OWNER_ROW


---
Child `ordinal` of `node`, or `None` when the node has fewer children.
---
pure func node_child(tables: FrontendTables, node: NodeId, ordinal: Int) -> Option[NodeId]:
	children: RowRange = tables.node_row(node).children

	if ordinal < children.count:
		tables.tables_of().node_children.get(children.first + ordinal)
	else:
		None


---
The child at row `index` of the node child table, or `None` past its end: for a
reader that has a node's `children` range and walks it itself.
---
pure func node_child_row_at(tables: FrontendTables, index: Int) -> Option[NodeId]:
	tables.tables_of().node_children.get(index)


