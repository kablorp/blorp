-- Frozen discovery tables and their read-only accessors.
--
-- `freeze` seals a builder once discovery is done. It first runs
-- `check_table_invariants` and refuses to freeze a builder that breaks them.
-- Readers rely on those invariants: an id they were handed names a row, so
-- the row accessors below never need an absent case. A list read is total, so
-- each accessor has an arm for a miss: it reports the miss under `debug:`
-- (`report_unreachable_lookup`) and returns the documented `UNREACHABLE_...`
-- row, which no id read from frozen tables reaches.
import:
	builder: DiscoveryBuilder, report_unreachable_lookup
	diagnostic_code: ImplicitDiagnostic, RootDiagnostic
	discovery_tables: DiscoveryTables
	ids:
		BoundId,
		DefinitionId,
		ImplicitRequestId,
		ImportId,
		ImportItemId,
		LiteralId,
		ModuleId,
		NameId,
		NodeId,
		PathId,
		RootId,
		SourceId,
		SupertraitId,
		bound_id_index,
		definition_id_index,
		implicit_request_id_index,
		import_id_index,
		import_item_id_index,
		literal_id_at_row,
		literal_id_index,
		module_id_at_row,
		module_id_index,
		name_id_at_row,
		name_id_index,
		node_id_index,
		package_id_index,
		path_id_at_row,
		path_id_index,
		root_id_index,
		source_id_at_row,
		source_id_index,
		supertrait_id_index,
	invariants/violation:
		DiscoveryTable(
			AnnotationTable, BinderNameTable, BodyTable, BoundQualifierTable, BoundTable,
			DefinitionTable, DefinitionTypeTable, DiagnosticTable, DimensionConstraintTable,
			DimensionNameTable, DocumentationTable, ElseKeywordTable, ForeignArgumentTable,
			ForeignBindingTable, ForeignBlockTable, ForeignCNameTable, ImplTable,
			ImplicitRequestTable, ImportAliasTable, ImportBlockTable, ImportItemAliasTable,
			ImportItemTable, ImportItemVariantTable, ImportPathPartTable, ImportTable,
			ImportTargetTable, LineStartTable, LiteralTable, MemberTable, ModuleDocumentationTable,
			ModulePackageTable, ModuleTable, NameTable, NodeChildTable, NodeNameSpanTable,
			NodeTable, PackageTable, ParameterTable, ParameterTypeTable, PathTable,
			ResolutionDiagnosticTable, ResourceCleanupTable, RootTable, SignatureTable, SourceTable,
			SourceTextTable, SupertraitQualifierTable, SupertraitTable, TypeParameterTable,
			VariantPayloadTable,
		),
		TableInvariantViolation,
	invariants: check_table_invariants
	name_vocabulary: ALL_SEEDED_NAME_SPELLINGS, WILDCARD_DIMENSION_NAME
	node_builder: UNREACHABLE_NODE_ROW
	row_kinds:
		DefinitionKind(FunctionDefinition),
		ModuleOriginKind(UserModule),
		ModuleReach(ImportedModule),
		NodeKind(IntegerLiteralNode, MissingExpressionNode),
		Visibility(PublicVisibility),
		bare_request,
		positive_count_of_literal,
		written_import_request,
	rows:
		AnnotationRow,
		BinderNameRow,
		BodyRow,
		BoundQualifierRow,
		BoundRow,
		DefinitionRow,
		DefinitionTypeRow,
		DimensionConstraintRow,
		DimensionNameRow,
		DocumentationRow,
		EMPTY_ROW_RANGE,
		ForeignArgumentRow,
		ForeignBindingRow,
		ForeignBlockRow,
		ForeignCNameRow,
		ImplRow,
		ImplicitOutcome(ImplicitLoaded, ImplicitRejected),
		ImplicitRequestRow,
		ImportAliasRow,
		ImportBlockRow,
		ImportItemAliasRow,
		ImportItemRow,
		ImportItemVariantRow,
		ImportRow,
		MemberRow,
		ModuleDocumentationRow,
		ModuleRow,
		NodeNameSpanRow,
		NodeRow,
		PackageRow,
		ParameterRow,
		ParameterTypeRow,
		ResolutionDiagnosticRow,
		ResourceCleanupRow,
		RootOutcome(RootLoaded, RootRejected),
		RootRow,
		RowRange,
		SignatureRow,
		SourceRow,
		SupertraitQualifierRow,
		SupertraitRow,
		SyntaxDiagnosticRow,
		TypeParameterRow,
		VariantPayloadRow,
	source_position: LineColumn, line_column_in_sources
	span: NO_SPAN, Span, pack_span


---
The sealed discovery output. Only `freeze` makes one.
---
opaque type FrontendTables = DiscoveryTables


union FreezeOutcome:
	FrozenTables(FrontendTables)
	TableInvariantsViolated(List[TableInvariantViolation])


---
Seals `builder`: its tables move into a `DiscoveryTables`, and its parse state
and intern indexes are dropped with it. A builder that breaks an invariant is
reported with every violation instead of being sealed; the check reads each
row a bounded number of times.
---
pure func freeze(builder: DiscoveryBuilder) -> FreezeOutcome:
	violations: List[TableInvariantViolation] = builder.check_table_invariants(
		ALL_SEEDED_NAME_SPELLINGS,
	)

	if violations.is_empty():
		FrozenTables(into_opaque FrontendTables(builder.sealed_tables()))
	else:
		TableInvariantsViolated(violations)


---
The output tables of `builder`, each list moved, not copied: `builder` is not
read after this.
---
private pure func sealed_tables(builder: DiscoveryBuilder) -> DiscoveryTables:
	{
		name_spellings = builder.name_spellings,
		paths = builder.paths,
		source_texts = builder.source_texts,
		sources = builder.sources,
		line_starts = builder.line_starts,
		packages = builder.packages,
		modules = builder.modules,
		module_packages = builder.module_packages,
		roots = builder.roots,
		implicit_requests = builder.implicit_requests,
		imports = builder.imports,
		import_path_parts = builder.import_path_parts,
		import_items = builder.import_items,
		import_item_variants = builder.import_item_variants,
		import_targets = builder.import_targets,
		import_aliases = builder.import_aliases,
		import_item_aliases = builder.import_item_aliases,
		import_blocks = builder.import_blocks,
		definitions = builder.definitions,
		members = builder.members,
		documentation = builder.documentation,
		module_documentation = builder.module_documentation,
		annotations = builder.annotations,
		type_parameters = builder.type_parameters,
		bounds = builder.bounds,
		bound_qualifiers = builder.bound_qualifiers,
		supertraits = builder.supertraits,
		supertrait_qualifiers = builder.supertrait_qualifiers,
		impls = builder.impls,
		signatures = builder.signatures,
		parameters = builder.parameters,
		binder_names = builder.binder_names,
		parameter_types = builder.parameter_types,
		definition_types = builder.definition_types,
		variant_payloads = builder.variant_payloads,
		dimension_constraints = builder.dimension_constraints,
		foreign_blocks = builder.foreign_blocks,
		foreign_arguments = builder.foreign_arguments,
		foreign_bindings = builder.foreign_bindings,
		foreign_c_names = builder.foreign_c_names,
		resource_cleanups = builder.resource_cleanups,
		bodies = builder.bodies,
		nodes = builder.nodes,
		node_children = builder.node_children,
		node_name_spans = builder.node_name_spans,
		else_keywords = builder.else_keywords,
		dimension_names = builder.dimension_names,
		literals = builder.literals,
		diagnostics = builder.diagnostics,
		resolution_diagnostics = builder.resolution_diagnostics
	}


private pure func tables_of(tables: FrontendTables) -> DiscoveryTables:
	from_opaque FrontendTables(tables)


---
Text read for an index outside a text table; unreachable for frozen ids.
---
private UNREACHABLE_TEXT_LITERAL: String = ""

---
The module row returned for a module id the tables did not issue.
---
private UNREACHABLE_MODULE_ROW: ModuleRow = {
	source = source_id_at_row(0),
	origin = UserModule,
	reach = ImportedModule,
	definitions = EMPTY_ROW_RANGE,
	imports = EMPTY_ROW_RANGE,
	nodes = EMPTY_ROW_RANGE,
	diagnostics = EMPTY_ROW_RANGE
}

---
The definition row returned for a definition id the tables did not issue.
---
private UNREACHABLE_DEFINITION_ROW: DefinitionRow = {
	module = module_id_at_row(0),
	kind = FunctionDefinition,
	name = name_id_at_row(0),
	name_span = NO_SPAN,
	visibility = PublicVisibility,
	span = NO_SPAN
}

---
The import row returned for an import id the tables did not issue.
---
private UNREACHABLE_IMPORT_ROW: ImportRow = {
	importer = module_id_at_row(0),
	request = bare_request(),
	path_parts = EMPTY_ROW_RANGE,
	items = EMPTY_ROW_RANGE,
	path_span = NO_SPAN,
	span = NO_SPAN
}

---
The source row returned for a source id the tables did not issue.
---
private UNREACHABLE_SOURCE_ROW: SourceRow = {
	path = path_id_at_row(0),
	line_starts = EMPTY_ROW_RANGE
}

---
The root row returned for a root id the tables did not issue.
---
private UNREACHABLE_ROOT_ROW: RootRow = {
	request_path = path_id_at_row(0),
	outcome = RootLoaded(module_id_at_row(0))
}

---
The implicit request row returned for a request id the tables did not issue.
---
private UNREACHABLE_IMPLICIT_REQUEST_ROW: ImplicitRequestRow = {
	request_path = path_id_at_row(0),
	outcome = ImplicitLoaded(module_id_at_row(0))
}

---
Why a row accessor's miss cannot happen: the id came from the frozen tables.
---
private FROZEN_ID_GUARANTEE: String = "the id was read from frozen tables, whose rows are checked complete"


-- Counts.
pure func module_count(tables: FrontendTables) -> Int:
	tables.tables_of().modules.length()


pure func definition_count(tables: FrontendTables) -> Int:
	tables.tables_of().definitions.length()


pure func node_count(tables: FrontendTables) -> Int:
	tables.tables_of().nodes.length()


pure func name_count(tables: FrontendTables) -> Int:
	tables.tables_of().name_spellings.length()


pure func path_count(tables: FrontendTables) -> Int:
	tables.tables_of().paths.length()


pure func literal_count(tables: FrontendTables) -> Int:
	tables.tables_of().literals.length()


pure func source_count(tables: FrontendTables) -> Int:
	tables.tables_of().sources.length()


pure func root_count(tables: FrontendTables) -> Int:
	tables.tables_of().roots.length()


pure func implicit_request_count(tables: FrontendTables) -> Int:
	tables.tables_of().implicit_requests.length()


pure func import_count(tables: FrontendTables) -> Int:
	tables.tables_of().imports.length()


pure func diagnostic_count(tables: FrontendTables) -> Int:
	tables.tables_of().diagnostics.length()


-- Rows by id.
pure func module_row(tables: FrontendTables, id: ModuleId) -> ModuleRow:
	match tables.tables_of().modules.get(id.module_id_index()):
		Some(row):
			row
		None:
			report_unreachable_lookup(ModuleTable, id.module_id_index(), FROZEN_ID_GUARANTEE)
			UNREACHABLE_MODULE_ROW


pure func definition_row(tables: FrontendTables, id: DefinitionId) -> DefinitionRow:
	match tables.tables_of().definitions.get(id.definition_id_index()):
		Some(row):
			row
		None:
			report_unreachable_lookup(
				DefinitionTable,
				id.definition_id_index(),
				FROZEN_ID_GUARANTEE,
			)
			UNREACHABLE_DEFINITION_ROW


pure func node_row(tables: FrontendTables, id: NodeId) -> NodeRow:
	match tables.tables_of().nodes.get(id.node_id_index()):
		Some(row):
			row
		None:
			report_unreachable_lookup(NodeTable, id.node_id_index(), FROZEN_ID_GUARANTEE)
			UNREACHABLE_NODE_ROW


---
The definition, node or import at position `index`, or `None` past the end of
its table: for a reader that follows an id it did not issue itself.
---
pure func definition_row_at(tables: FrontendTables, index: Int) -> Option[DefinitionRow]:
	tables.tables_of().definitions.get(index)


pure func node_row_at(tables: FrontendTables, index: Int) -> Option[NodeRow]:
	tables.tables_of().nodes.get(index)


pure func import_row_at(tables: FrontendTables, index: Int) -> Option[ImportRow]:
	tables.tables_of().imports.get(index)


pure func import_row(tables: FrontendTables, id: ImportId) -> ImportRow:
	match tables.tables_of().imports.get(id.import_id_index()):
		Some(row):
			row
		None:
			report_unreachable_lookup(ImportTable, id.import_id_index(), FROZEN_ID_GUARANTEE)
			UNREACHABLE_IMPORT_ROW


---
The canonical path of `module`: the path of the source it was parsed from, the
one place a module's path is stored.
---
pure func module_path(tables: FrontendTables, module: ModuleRow) -> PathId:
	tables.source_row(module.source).path


pure func source_row(tables: FrontendTables, id: SourceId) -> SourceRow:
	match tables.tables_of().sources.get(id.source_id_index()):
		Some(row):
			row
		None:
			report_unreachable_lookup(SourceTable, id.source_id_index(), FROZEN_ID_GUARANTEE)
			UNREACHABLE_SOURCE_ROW


pure func root_row(tables: FrontendTables, id: RootId) -> RootRow:
	match tables.tables_of().roots.get(id.root_id_index()):
		Some(row):
			row
		None:
			report_unreachable_lookup(RootTable, id.root_id_index(), FROZEN_ID_GUARANTEE)
			UNREACHABLE_ROOT_ROW


pure func implicit_request_row(tables: FrontendTables, id: ImplicitRequestId) -> ImplicitRequestRow:
	match tables.tables_of().implicit_requests.get(id.implicit_request_id_index()):
		Some(row):
			row
		None:
			report_unreachable_lookup(
				ImplicitRequestTable,
				id.implicit_request_id_index(),
				FROZEN_ID_GUARANTEE,
			)
			UNREACHABLE_IMPLICIT_REQUEST_ROW


---
The module implicit request `request` loaded or found already loaded, or
`None` when it loaded none.
---
pure func implicit_target(tables: FrontendTables, request: ImplicitRequestId) -> Option[ModuleId]:
	match tables.tables_of().implicit_requests.get(request.implicit_request_id_index()):
		Some(row):
			match row.outcome:
				ImplicitLoaded(module):
					Some(module)
				ImplicitRejected(_):
					None
		None:
			None


---
Why implicit module request `request` loaded no module, or `None` when it loaded
one.
---
pure func implicit_rejection(
	tables: FrontendTables,
	request: ImplicitRequestId,
) -> Option[ImplicitDiagnostic]:
	match tables.tables_of().implicit_requests.get(request.implicit_request_id_index()):
		Some(row):
			match row.outcome:
				ImplicitLoaded(_):
					None
				ImplicitRejected(diagnostic):
					Some(diagnostic)
		None:
			None


---
Child `ordinal` of `node`, or `None` when the node has fewer children.
---
pure func node_child(tables: FrontendTables, node: NodeId, ordinal: Int) -> Option[NodeId]:
	children: RowRange = tables.node_row(node).children

	if ordinal < children.count:
		tables.tables_of().node_children.get(children.first + ordinal)
	else:
		None


---
The child at row `index` of the node child table, or `None` past its end: for a
reader that has a node's `children` range and walks it itself.
---
pure func node_child_row_at(tables: FrontendTables, index: Int) -> Option[NodeId]:
	tables.tables_of().node_children.get(index)


-- Declaration rows. Counts and rows by position, for readers that derive
