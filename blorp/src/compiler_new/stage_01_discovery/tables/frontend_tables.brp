---
Row counts of every table, by table name, for dumps and measurements.
---
pure func table_row_counts(tables: FrontendTables) -> List[(String, Int)]:
	builder: DiscoveryBuilder = tables.tables_of()
	[
		("names", builder.name_spellings.length()),
		("paths", builder.paths.length()),
		("sources", builder.sources.length()),
		("line_starts", builder.line_starts.length()),
		("packages", builder.packages.length()),
		("modules", builder.modules.length()),
		("module_packages", builder.module_packages.length()),
		("roots", builder.roots.length()),
		("root_targets", builder.root_targets.length()),
		("root_diagnostics", builder.root_diagnostics.length()),
		("implicit_requests", builder.implicit_requests.length()),
		("implicit_targets", builder.implicit_targets.length()),
		("implicit_diagnostics", builder.implicit_diagnostics.length()),
		("imports", builder.imports.length()),
		("import_path_parts", builder.import_path_parts.length()),
		("import_items", builder.import_items.length()),
		("import_item_variants", builder.import_item_variants.length()),
		("import_targets", builder.import_targets.length()),
		("import_aliases", builder.import_aliases.length()),
		("import_item_aliases", builder.import_item_aliases.length()),
		("import_blocks", builder.import_blocks.length()),
		("definitions", builder.definitions.length()),
		("members", builder.members.length()),
		("documentation", builder.documentation.length()),
		("module_documentation", builder.module_documentation.length()),
		("annotations", builder.annotations.length()),
		("type_parameters", builder.type_parameters.length()),
		("bounds", builder.bounds.length()),
		("bound_qualifiers", builder.bound_qualifiers.length()),
		("supertraits", builder.supertraits.length()),
		("supertrait_qualifiers", builder.supertrait_qualifiers.length()),
		("signatures", builder.signatures.length()),
		("parameters", builder.parameters.length()),
		("binder_names", builder.binder_names.length()),
		("parameter_types", builder.parameter_types.length()),
		("definition_types", builder.definition_types.length()),
		("variant_payloads", builder.variant_payloads.length()),
		("dimension_constraints", builder.dimension_constraints.length()),
		("foreign_blocks", builder.foreign_blocks.length()),
		("foreign_arguments", builder.foreign_arguments.length()),
		("foreign_bindings", builder.foreign_bindings.length()),
		("foreign_c_names", builder.foreign_c_names.length()),
		("resource_cleanups", builder.resource_cleanups.length()),
		("bodies", builder.bodies.length()),
		("nodes", builder.nodes.length()),
		("node_children", builder.node_children.length()),
		("node_name_spans", builder.node_name_spans.length()),
		("else_keywords", builder.else_keywords.length()),
		("concurrency_counts", builder.concurrency_counts.length()),
		("dimension_names", builder.dimension_names.length()),
		("literals", builder.literals.length()),
		("diagnostics", builder.diagnostics.length()),
		("resolution_diagnostics", builder.resolution_diagnostics.length()),
		("diagnostic_arguments", builder.diagnostic_arguments.length()),
	]


pure func diagnostic_row_at(tables: FrontendTables, index: Int) -> Option[DiagnosticRow]:
	tables.tables_of().diagnostics.get(index)


---
The module graph's diagnostics, outside every module's block: imports that loaded
no module and sources that could not be admitted. Their spans point at the
requesting import.
---
pure func resolution_diagnostic_count(tables: FrontendTables) -> Int:
	tables.tables_of().resolution_diagnostics.length()


pure func resolution_diagnostic_row_at(tables: FrontendTables, index: Int) -> Option[DiagnosticRow]:
	tables.tables_of().resolution_diagnostics.get(index)


pure func diagnostic_argument(
	tables: FrontendTables,
	row: DiagnosticRow,
	ordinal: Int,
) -> Option[Int]:
	tables.tables_of().diagnostic_arguments.get(row.arguments.first + ordinal)


---
The line (zero-based) and tab-expanded column (one-based, counting bytes) where
`span` starts. A span of an admitted source always names a source of these
tables.
---
pure func span_line_column(tables: FrontendTables, span: Span) -> LineColumn:
	tables
		.tables_of()
		.span_start_position(span)
