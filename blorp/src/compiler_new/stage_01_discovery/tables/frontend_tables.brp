---
The span of the name `node` carries: its own span unless a row records a
narrower one (see `NodeNameSpanRow`).
---
pure func node_name_span(tables: FrontendTables, node: NodeId) -> Span:
	builder: DiscoveryTables = tables.tables_of()

	match (
		owned_row(
			builder.node_name_spans,
			node.node_id_index(),
			pure func(index): builder.node_name_span_owner(index),
		)
	):
		Some(name_row):
			name_row.name_span
		None:
			tables.node_row(node).span


---
The number of node name span rows.
---
pure func node_name_span_count(tables: FrontendTables) -> Int:
	tables.tables_of().node_name_spans.length()


---
The index of the node name span row `index` belongs to, for a reader that walks
the rows, which are sorted by node, alongside the nodes, and compares one
integer per node. `index` is below `node_name_span_count`: the reader checks it
before asking.
---
pure func node_name_span_row_node(tables: FrontendTables, index: Int) -> Int:
	match tables.tables_of().node_name_spans.get(index):
		Some(name_row):
			name_row.node.node_id_index()
		None:
			report_unreachable_lookup(
				NodeNameSpanTable,
				index,
				"the reader checks the row against node_name_span_count",
			)
			0


---
The span of node name span row `index`, or `None` past the last row.
---
pure func node_name_span_row_span(tables: FrontendTables, index: Int) -> Option[Span]:
	match tables.tables_of().node_name_spans.get(index):
		Some(name_row):
			Some(name_row.name_span)
		None:
			None


---
The count the concurrency parameter node `parameter` writes: the positive
integer its value is, as the checked integer the parser read from the literal
(a literal above `Int`'s range saturates, as `parse_int` does), or `None` when
its value is not a positive integer literal (a diagnostic reports that). Read
from the parameter's value node, so it cannot disagree with it; only a
`max_threads` or `limit` parameter has a meaningful count, but any parameter
whose value is such a literal reads as one.
---
pure func concurrency_count(tables: FrontendTables, parameter: NodeId) -> Option[Int]:
	match tables.node_child(parameter, 0):
		Some(value):
			value_row: NodeRow = tables.node_row(value)

			match value_row.kind:
				IntegerLiteralNode:
					text: String = tables.literal_text(literal_id_at_row(value_row.payload))
					text.positive_count_of_literal()
				_:
					None
		None:
			None


---
The span of the `else` keyword of the `IfNode` `node`, or `None` when it has no
else branch.
---
pure func else_keyword_span(tables: FrontendTables, node: NodeId) -> Option[Span]:
	builder: DiscoveryTables = tables.tables_of()

	match (
		owned_row(
			builder.else_keywords,
			node.node_id_index(),
			pure func(index): builder.else_keyword_owner(index),
		)
	):
		Some(keyword_row):
			Some(keyword_row.keyword_span)
		None:
			None


private pure func else_keyword_owner(builder: DiscoveryTables, row: Int) -> Int:
	match builder.else_keywords.get(row):
		Some(keyword_row):
			keyword_row.node.node_id_index()
		None:
			unreachable_owner(ElseKeywordTable, row)


private pure func node_name_span_owner(builder: DiscoveryTables, row: Int) -> Int:
	match builder.node_name_spans.get(row):
		Some(name_row):
			name_row.node.node_id_index()
		None:
			unreachable_owner(NodeNameSpanTable, row)


-- Text.
pure func name_spelling(tables: FrontendTables, id: NameId) -> String:
	tables.tables_of().name_spellings.text_at(NameTable, id.name_id_index())


pure func path_text(tables: FrontendTables, id: PathId) -> String:
	tables.tables_of().paths.text_at(PathTable, id.path_id_index())


pure func literal_text(tables: FrontendTables, id: LiteralId) -> String:
	tables.tables_of().literals.text_at(LiteralTable, id.literal_id_index())


pure func source_text(tables: FrontendTables, id: SourceId) -> String:
	tables.tables_of().source_texts.text_at(SourceTextTable, id.source_id_index())


---
Text `index` of `texts`, or `UNREACHABLE_TEXT_LITERAL` after a report. The bound
is checked before `get_or`, which does not allocate an `Option` per read.
---
private pure func text_at(texts: List[String], table: DiscoveryTable, index: Int) -> String:
	if index >= 0 and index < texts.length():
		texts.get_or(index, UNREACHABLE_TEXT_LITERAL)
	else:
		report_unreachable_lookup(table, index, FROZEN_ID_GUARANTEE)
		UNREACHABLE_TEXT_LITERAL


---
The dimension names and their `#` spellings, one row per distinct dimension
name; `freeze` checks every dimension name a node or type parameter records
has its row.
---
pure func dimension_name_count(tables: FrontendTables) -> Int:
	tables.tables_of().dimension_names.length()


pure func dimension_name_row_at(tables: FrontendTables, index: Int) -> Option[DimensionNameRow]:
	tables.tables_of().dimension_names.get(index)


---
The name the wildcard dimension `#_` records in a type, a seeded name. A
wildcard type parameter's row holds the same name.
---
pure func wildcard_dimension_name() -> NameId:
	WILDCARD_DIMENSION_NAME


---
Every spelling, in id order: the id of a spelling is its position.
---
pure func name_spellings(tables: FrontendTables) -> List[String]:
	tables.tables_of().name_spellings


-- Optional relationships (side tables).
---
The module `import_id` loaded, or `None` when it loaded none. Side tables
are sorted by owner (an invariant), so this and the other side-table lookups
are binary searches.
---
pure func import_target(tables: FrontendTables, import_id: ImportId) -> Option[ModuleId]:
	builder: DiscoveryTables = tables.tables_of()

	match (
		owned_row(
			builder.import_targets,
			import_id.import_id_index(),
			pure func(index): builder.import_target_owner(index),
		)
	):
		Some(target):
			Some(target.target)
		None:
			None


private pure func import_target_owner(builder: DiscoveryTables, row: Int) -> Int:
	match builder.import_targets.get(row):
		Some(target):
			target.owner_import.import_id_index()
		None:
			unreachable_owner(ImportTargetTable, row)


---
The module root `root` loaded, or `None` when it loaded none.
---
pure func root_target(tables: FrontendTables, root: RootId) -> Option[ModuleId]:
	match tables.tables_of().roots.get(root.root_id_index()):
		Some(row):
			match row.outcome:
				RootLoaded(module):
					Some(module)
				RootRejected(_):
					None
		None:
			None


---
How many roots loaded no module.
---
pure func rejected_root_count(tables: FrontendTables) -> Int:
	tables.tables_of().roots.count(pure func(row): row.outcome.is_rejected_root())


private pure func is_rejected_root(outcome: RootOutcome) -> Bool:
	match outcome:
		RootLoaded(_):
			False
		RootRejected(_):
			True


---
Why root `root` loaded no module, or `None` when it loaded one.
---
pure func root_rejection(tables: FrontendTables, root: RootId) -> Option[RootDiagnostic]:
	match tables.tables_of().roots.get(root.root_id_index()):
		Some(row):
			match row.outcome:
				RootLoaded(_):
					None
				RootRejected(diagnostic):
					Some(diagnostic)
		None:
			None


-- Import details.
pure func import_item_row_at(tables: FrontendTables, item: ImportItemId) -> Option[ImportItemRow]:
	tables.tables_of().import_items.get(item.import_item_id_index())


pure func import_item_variant_row_at(
	tables: FrontendTables,
	index: Int,
) -> Option[ImportItemVariantRow]:
	tables.tables_of().import_item_variants.get(index)


---
The `ordinal`th path part of an import.
---
pure func import_path_part(tables: FrontendTables, row: ImportRow, ordinal: Int) -> Option[NameId]:
	tables.tables_of().import_path_parts.get(row.path_parts.first + ordinal)


---
The text `row`'s request was written as: its structured form (kind, parent
steps and path parts) rendered by `import_request_text`.
---
pure func import_request_text(tables: FrontendTables, row: ImportRow) -> String:
	var parts: List[String] = []

	for ordinal in 0..row.path_parts.count:
		match tables.import_path_part(row, ordinal):
			Some(part):
				parts = parts.append(tables.name_spelling(part))
			None:
				-- The row's block lies inside `import_path_parts`, which the
				-- freeze check (`RangeOutOfBounds`) guarantees for a frozen table.
				void

	written_import_request(row.request, parts)


