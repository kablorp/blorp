---
The span of the name `node` carries: its own span unless a row records a
narrower one (see `NodeNameSpanRow`).
---
pure func node_name_span(tables: FrontendTables, node: NodeId) -> Span:
	builder: DiscoveryBuilder = tables.tables_of()
	row: Int = owner_row(
		builder.node_name_spans.length(),
		node.node_id_index(),
		pure func(index): builder.node_name_span_owner(index),
	)

	match builder.node_name_spans.get(row):
		Some(name_row):
			name_row.name_span
		None:
			tables.node_row(node).span


---
The number of node name span rows.
---
pure func node_name_span_count(tables: FrontendTables) -> Int:
	tables.tables_of().node_name_spans.length()


---
The index of the node name span row `index` belongs to, or `NO_NAME_SPAN_NODE`
past the last row: for a reader that walks the rows, which are sorted by node,
alongside the nodes, and compares one integer per node.
---
pure func node_name_span_row_node(tables: FrontendTables, index: Int) -> Int:
	match tables.tables_of().node_name_spans.get(index):
		Some(name_row):
			name_row.node.node_id_index()
		None:
			NO_NAME_SPAN_NODE


---
What `node_name_span_row_node` returns past the last row: no node has it.
---
NO_NAME_SPAN_NODE: Int = -1


---
The span of node name span row `index`, or `None` past the last row.
---
pure func node_name_span_row_span(tables: FrontendTables, index: Int) -> Option[Span]:
	match tables.tables_of().node_name_spans.get(index):
		Some(name_row):
			Some(name_row.name_span)
		None:
			None


---
The count the concurrency parameter node `parameter` wrote, or `None` when it
has none (see `ConcurrencyCountRow`).
---
pure func concurrency_count(tables: FrontendTables, parameter: NodeId) -> Option[Int]:
	builder: DiscoveryBuilder = tables.tables_of()
	row: Int = owner_row(
		builder.concurrency_counts.length(),
		parameter.node_id_index(),
		pure func(index): builder.concurrency_count_owner(index),
	)

	match builder.concurrency_counts.get(row):
		Some(count_row):
			Some(count_row.count)
		None:
			None


private pure func concurrency_count_owner(builder: DiscoveryBuilder, row: Int) -> Int:
	match builder.concurrency_counts.get(row):
		Some(count_row):
			count_row.parameter.node_id_index()
		None:
			NO_OWNER_ROW


