---
The package of `module`, if it belongs to one.
---
pure func module_package(tables: FrontendTables, module: ModuleId) -> Option[PackageRow]:
	builder: DiscoveryBuilder = tables.tables_of()
	row: Int = owner_row(
		builder.module_packages.length(),
		module.module_id_index(),
		pure func(index): builder.module_package_owner(index),
	)

	match builder.module_packages.get(row):
		Some(membership):
			builder.packages.get(membership.package.package_id_index())
		None:
			None


private pure func module_package_owner(builder: DiscoveryBuilder, row: Int) -> Int:
	match builder.module_packages.get(row):
		Some(membership):
			membership.module.module_id_index()
		None:
			NO_OWNER_ROW


---
What `owner_row` returns when no row has the owner, and what an owner
reader returns for a row outside its table.
---
private NO_OWNER_ROW: Int = -1


---
The row of a side table sorted by owner whose owner is `wanted`, or
`NO_OWNER_ROW`: a binary search over `count` rows read through `owner_at`.
---
private pure func owner_row(
	count: Int,
	wanted: Int,
	owner_at: pure (Int) -> Int,
) -> Int:
	var lower: Int = 0
	var upper: Int = count

	while lower < upper:
		middle: Int = (lower + upper) / 2

		if owner_at(middle) < wanted:
			lower = middle + 1
		else:
			upper = middle

	if lower < count and owner_at(lower) == wanted:
		lower
	else:
		NO_OWNER_ROW


-- Diagnostics.
