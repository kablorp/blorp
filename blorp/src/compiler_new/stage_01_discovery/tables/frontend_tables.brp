---
The name the wildcard dimension `#_` records, a seeded name.
---
pure func wildcard_dimension_name() -> NameId:
	name_id_at_row(WILDCARD_DIMENSION_NAME_INDEX)


---
Every spelling, in id order: the id of a spelling is its position.
---
pure func name_spellings(tables: FrontendTables) -> List[String]:
	tables.tables_of().name_spellings


---
The id `spelling` has in these tables, if any row holds it.
---
pure func lookup_name_id(tables: FrontendTables, spelling: String) -> Option[NameId]:
	find_name_id(tables.tables_of(), spelling)


-- Optional relationships (side tables).
---
The module `import_id` loaded, or `None` when it loaded none. Side tables
are sorted by owner (an invariant), so this and the other side-table lookups
are binary searches.
---
pure func import_target(tables: FrontendTables, import_id: ImportId) -> Option[ModuleId]:
	builder: DiscoveryBuilder = tables.tables_of()
	row: Int = owner_row(
		builder.import_targets.length(),
		import_id.import_id_index(),
		pure func(index): builder.import_target_owner(index),
	)

	match builder.import_targets.get(row):
		Some(target):
			Some(target.target)
		None:
			None


private pure func import_target_owner(builder: DiscoveryBuilder, row: Int) -> Int:
	match builder.import_targets.get(row):
		Some(target):
			target.owner_import.import_id_index()
		None:
			NO_OWNER_ROW


