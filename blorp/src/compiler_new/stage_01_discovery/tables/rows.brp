-- The row shapes of every discovery table: the struct each `List` in the
-- builder holds, `RowRange` (a block of rows in a child table) and the payload
-- of a row that has one. Pure data, no operations; `builder` owns the tables
-- and `node_builder` the body nodes.
import:
	diagnostic_code: ImplicitDiagnostic, ResolutionDiagnostic, RootDiagnostic, SyntaxDiagnostic
	ids:
		BoundId,
		DefinitionId,
		ForeignBlockId,
		ImplicitRequestId,
		ImportId,
		ImportItemId,
		LiteralId,
		ModuleId,
		NameId,
		NodeId,
		PackageId,
		ParameterId,
		PathId,
		RootId,
		SourceId,
		SupertraitId,
	row_kinds:
		DefinitionKind,
		FunctionAnnotation,
		ImportRequestShape,
		ModuleOriginKind,
		ModuleReach,
		NodeKind,
		PackageKind,
		ParameterBinder,
		Purity,
		TypeParameterKind,
		Visibility,
	span: Span


---
A contiguous block of rows in a child table: rows `first .. first + count`.
---
struct RowRange {
	first: Int,
	count: Int
}


---
The range with no rows, used for a parent row appended before its children
are known; the builder closes it once they are.
---
EMPTY_ROW_RANGE: RowRange = {
	first = 0,
	count = 0
}


---
The line starts of a source are rows `line_starts` of the `line_starts`
table; the text itself is `source_texts[source]`.
---
struct SourceRow {
	path: PathId,
	line_starts: RowRange
}


struct PackageRow {
	name: NameId,
	kind: PackageKind
}


---
One module. Its canonical path is its source's (`SourceRow.path`), stored
once there. Its rows in the definitions, imports, nodes and diagnostics
tables are the contiguous blocks named here, closed when its parse ends.
---
struct ModuleRow {
	source: SourceId,
	origin: ModuleOriginKind,
	reach: ModuleReach,
	definitions: RowRange,
	imports: RowRange,
	nodes: RowRange,
	diagnostics: RowRange
}


---
A package module's package; most modules have none.
---
struct ModulePackageRow {
	module: ModuleId,
	package: PackageId
}


---
What a root request came to: the module it loaded or found already loaded, or
the diagnostic that says why it loaded none. Exactly one, by construction.
---
union RootOutcome:
	RootLoaded(ModuleId)
	RootRejected(RootDiagnostic)


---
A root given to discovery: a source path, as given, and what resolving it came
to. Appended once, after it was resolved. A `record`, not a `struct`: a struct
field cannot hold a union, and roots are few.
---
record RootRow {
	request_path: PathId,
	outcome: RootOutcome
}


---
What an implicit module request came to, as `RootOutcome` is for a root.
---
union ImplicitOutcome:
	ImplicitLoaded(ModuleId)
	ImplicitRejected(ImplicitDiagnostic)


---
An implicit module request: the module's name as given (`prelude`), interned
as a path like an import request's text, and what resolving it came to.
Appended once, after it was resolved; a `record` for the reason `RootRow` is.
---
record ImplicitRequestRow {
	request_path: PathId,
	outcome: ImplicitOutcome
}


---
One import item of a module's import block. The request is its structured
form only: its shape (kind, and the `../` a relative request climbs), then the
path parts, a block of `import_path_parts`; the text it was written as is
built from these (`written_import_request`). `items` is a block of
`import_items`. `path_span` covers
the module path, `span` the path through its aliases and selections.
---
struct ImportRow {
	importer: ModuleId,
	request: ImportRequestShape,
	path_parts: RowRange,
	items: RowRange,
	path_span: Span,
	span: Span
}


---
One selected symbol; `variants` is a block of `import_item_variants` for
`name(Variant, ...)` selections. `name_span` covers the name alone, `span` the
whole selection.
---
struct ImportItemRow {
	owner_import: ImportId,
	name: NameId,
	variants: RowRange,
	name_span: Span,
	span: Span
}


struct ImportItemVariantRow {
	item: ImportItemId,
	name: NameId,
	span: Span
}


---
The module an import loaded; absent when it loaded none.
---
struct ImportTargetRow {
	owner_import: ImportId,
	target: ModuleId
}


---
The alias of an import (`module as alias`); `span` covers the alias name.
---
struct ImportAliasRow {
	owner_import: ImportId,
	alias_name: NameId,
	span: Span
}


---
The alias of an imported symbol (`name as alias`); `span` covers the alias
name.
---
struct ImportItemAliasRow {
	item: ImportItemId,
	alias_name: NameId,
	span: Span
}


---
One row per declared thing, including members. `span` covers the whole
declaration (from its docstring, annotations or `pure`, when present);
`name_span` covers the name. An impl has no name of its own: its name column
holds `IMPL_NAME`, which no declaration can be called, and the implemented
trait is in its `ImplRow`; its `name_span` is the span of its `implements`
keyword.
---
struct DefinitionRow {
	module: ModuleId,
	kind: DefinitionKind,
	name: NameId,
	name_span: Span,
	visibility: Visibility,
	span: Span
}


---
The trait an impl implements, written after `implements`. One row per impl, in
definition order; `trait_span` covers the name.
---
struct ImplRow {
	definition: DefinitionId,
	trait_name: NameId,
	trait_span: Span
}


---
A field, variant or method, with its owner and declaration order.
---
struct MemberRow {
	definition: DefinitionId,
	owner: DefinitionId,
	ordinal: Int
}


---
A declaration's docstring; most declarations have none.
---
struct DocumentationRow {
	definition: DefinitionId,
	text: LiteralId
}


---
A module's docstring: the one that opens the file directly before its first
`import:` block. At most one row per module; most modules have none.
---
struct ModuleDocumentationRow {
	module: ModuleId,
	text: LiteralId,
	span: Span
}


---
The two kinds of piece an interpolated string is made of.
---
enum InterpolationPart:
	TextPart
	HolePart


---
One piece of an interpolated string, in source order. `start .. end` are its
source bytes: the text as written, or a hole's expression between `${` and
its `}`. `text` is one row of `interpolation_texts` holding the decoded text
for a `TextPart`, and empty for a `HolePart`.
---
struct InterpolationPartRow {
	part: InterpolationPart,
	start: Int,
	end: Int,
	text: RowRange
}


---
An annotation read before the declaration it belongs to has a row: a
transient row the declaration copies into `annotations` once its
`DefinitionId` is known.
---
struct PendingAnnotationRow {
	annotation: FunctionAnnotation,
	span: Span
}


---
One `@annotation` of a function, in written order.
---
struct AnnotationRow {
	definition: DefinitionId,
	annotation: FunctionAnnotation,
	span: Span
}


---
A declared type or dimension parameter. `name_span` covers the name (with its
`#` for a dimension), `span` the name and its bounds.
---
struct TypeParameterRow {
	owner: DefinitionId,
	ordinal: Int,
	name: NameId,
	kind: TypeParameterKind,
	name_span: Span,
	span: Span
}


---
A written trait bound on the type parameter at `parameter_ordinal`,
unresolved; typecheck turns `trait_name` into a trait. `span` covers the whole
written reference, `module.Trait` included; the module alias, when written, is
the bound's `BoundQualifierRow`; `name_span` covers the trait's name alone.
---
struct BoundRow {
	owner: DefinitionId,
	parameter_ordinal: Int,
	trait_name: NameId,
	name_span: Span,
	span: Span
}


---
The module alias of a bound written `alias.Trait`; absent for `Trait`.
`span` covers the alias alone.
---
struct BoundQualifierRow {
	bound: BoundId,
	qualifier: NameId,
	span: Span
}


---
A supertrait a trait names, in written order. `span` covers the whole written
reference, as for `BoundRow`; `name_span` covers the supertrait's name alone.
---
struct SupertraitRow {
	trait_definition: DefinitionId,
	ordinal: Int,
	name: NameId,
	name_span: Span,
	span: Span
}


---
The module alias of a supertrait written `alias.Trait`; absent for `Trait`.
`span` covers the alias alone.
---
struct SupertraitQualifierRow {
	supertrait: SupertraitId,
	qualifier: NameId,
	span: Span
}


---
The signature of a function, method or foreign function: its purity, the
span of its `func` keyword, and its parameters, a block of `parameters`.
Every function-like definition has exactly one.
---
struct SignatureRow {
	definition: DefinitionId,
	purity: Purity,
	keyword_span: Span,
	parameters: RowRange
}


---
One parameter. `binder_names` is a block of `binder_names`: one name for a
named binder (`_` for a typed discard), none for a wildcard, two to four for
a tuple binder. `binder_span` covers the binder, `span` the whole parameter.
---
struct ParameterRow {
	owner: DefinitionId,
	ordinal: Int,
	binder: ParameterBinder,
	binder_names: RowRange,
	binder_span: Span,
	span: Span
}


struct BinderNameRow {
	name: NameId,
	span: Span
}


---
A parameter's written type; absent when the type is inferred.
---
struct ParameterTypeRow {
	parameter: ParameterId,
	type_root: NodeId
}


---
The one type a definition declares, whose role its kind fixes: a
function's, method's or foreign function's return type, a global's declared
type, an alias's or opaque type's target, an impl's receiver type, a field's
type. Absent when not written.
---
struct DefinitionTypeRow {
	definition: DefinitionId,
	type_root: NodeId
}


---
One payload type of a variant, in written order.
---
struct VariantPayloadRow {
	variant: DefinitionId,
	ordinal: Int,
	type_root: NodeId
}


---
One `where left == right` dimension constraint of a function.
---
struct DimensionConstraintRow {
	owner: DefinitionId,
	left: NodeId,
	right: NodeId,
	span: Span
}


---
One `import:` block; `imports` is its block of `imports`.
---
struct ImportBlockRow {
	module: ModuleId,
	imports: RowRange,
	span: Span
}


---
One `foreign:` block; `arguments` is its block of `foreign_arguments`.
---
struct ForeignBlockRow {
	module: ModuleId,
	arguments: RowRange,
	span: Span
}


---
One `name: "value"` argument of a foreign block, such as `include`.
`name_span` covers the name, `span` the name through the value.
---
struct ForeignArgumentRow {
	name: NameId,
	value: LiteralId,
	name_span: Span,
	span: Span
}


---
The foreign block a foreign function belongs to.
---
struct ForeignBindingRow {
	definition: DefinitionId,
	block: ForeignBlockId
}


---
A foreign function's explicit C name (`= "c_name"`); absent when the C name
is the Blorp name.
---
struct ForeignCNameRow {
	definition: DefinitionId,
	c_name: LiteralId,
	span: Span
}


---
A resource type's cleanup builtin (`= builtin("cleanup")`).
---
struct ResourceCleanupRow {
	definition: DefinitionId,
	builtin_name: LiteralId,
	span: Span
}


---
A function's, method's or global's body: the root of its nodes.
---
struct BodyRow {
	definition: DefinitionId,
	root: NodeId
}


---
One body node. `payload` is fixed by `kind`; `children` addresses a block of
the `node_children` edge table.
---
struct NodeRow {
	kind: NodeKind,
	span: Span,
	payload: Int,
	children: RowRange
}


---
A dimension name and the spelling it has with its sigil: `N` and `#N`. The
lexer interns both when it joins a `#` to a name, and writes one row per
distinct dimension name, so a reader that needs the sigil spelling (the legacy
adapter) reads this row instead of building a spelling and looking it up.
---
struct DimensionNameRow {
	name: NameId,
	sigil_name: NameId
}


---
The span of the name a node carries, for a node whose name does not span the
whole node. Types: a generic or module-qualified named type (`List[T]`,
`m.Type`), a bounded type (`T: Eq`), a trait bound written through a module
alias, and a variadic dimension (`#Ds...`). Bodies: the field of a field access
and of a record field, the name a binding, assignment, `?=`, `with`, `on`,
select arm, concurrency parameter or typed lambda parameter binds, the
constructor of a constructor pattern, and the target of a list pattern's spread
(`...rest`, `..._`). A node whose name is the whole node has no row. At most one
row per node, in node order.
---
struct NodeNameSpanRow {
	node: NodeId,
	name_span: Span
}


---
The span of the `else` keyword of an `IfNode` that has an else branch (its third
child). Neither branch's span covers the keyword, which the formatter places
comments around and the existing AST records. One row per such node, in node
order; an `IfNode` without an else branch has none.
---
struct ElseKeywordRow {
	node: NodeId,
	keyword_span: Span
}


---
A lexer or parser diagnostic at a source span. A `record`, not a `struct`: a
struct field cannot hold a union, so each row costs one allocation, which is
affordable because a program that compiles has no diagnostics.
---
record SyntaxDiagnosticRow {
	span: Span,
	diagnostic: SyntaxDiagnostic
}


---
A module graph diagnostic at a source span: the span of the import that loaded
no module. A `record` for the reason `SyntaxDiagnosticRow` is.
---
record ResolutionDiagnosticRow {
	span: Span,
	diagnostic: ResolutionDiagnostic
}
