---
Spellings the discovery parser compares by `NameId` that the existing
compiler does not synthesize: the function annotations, the removed
`into` conversion word, the `concurrent(max_threads: N)` parameter name and the
name an impl's definition row records. They are seeded after `SEEDED_NAME_SPELLINGS`, so
the shared vocabulary keeps its ids.
---
DISCOVERY_NAME_SPELLINGS: List[String] = [
	"tail_recursive",
	"no_copy",
	"debug_only",
	"resource_result_ordinary",
	"into",
	"max_threads",
	"<impl>",
]

---
Every spelling a discovery name table is seeded with, in id order.
---
ALL_SEEDED_NAME_SPELLINGS: List[String] = SEEDED_NAME_SPELLINGS.concat(DISCOVERY_NAME_SPELLINGS)

-- Each constant's id is the position of its spelling above;
-- `test_name_vocabulary` checks that each constant names its spelling.
---
The id of the empty spelling `""` in the seeded vocabulary: the name
recorded where a required name is missing (a diagnostic row reports it).
---
EMPTY_NAME: NameId = name_id_at_row(0)

-- Contextual declaration prefix; `fixed` remains an identifier elsewhere.
FIXED_NAME: NameId = name_id_at_row(235)

---
`_`: the name a discard binder records.
---
DISCARD_NAME: NameId = name_id_at_row(47)

---
`#_`: the name the wildcard dimension records.
---
WILDCARD_DIMENSION_NAME: NameId = name_id_at_row(49)

---
The sigil a dimension name is written with. The lexer interns the spelling
`#N` beside the plain `N` a dimension node records, so a reader that needs the
sigil spelling (the legacy adapter) finds it by lookup.
---
DIMENSION_SIGIL: String = "#"

---
`Void`: the name `()` records as a type.
---
VOID_NAME: NameId = name_id_at_row(71)

TAIL_RECURSIVE_NAME: NameId = name_id_at_row(236)

NO_COPY_NAME: NameId = name_id_at_row(237)

DEBUG_ONLY_NAME: NameId = name_id_at_row(238)

RESOURCE_RESULT_ORDINARY_NAME: NameId = name_id_at_row(239)

---
`<impl>`: the name an impl's definition row records. It is not an identifier,
so no declaration is called it and nothing resolves to it; the implemented
trait is in the impl's `ImplRow`.
---
IMPL_NAME: NameId = name_id_at_row(242)

---
`max_threads`, the `concurrent(...)` thread-count parameter.
---
MAX_THREADS_NAME: NameId = name_id_at_row(241)

---
`limit`, the `for ... concurrently(...)` in-flight item count parameter.
---
LIMIT_NAME: NameId = name_id_at_row(67)

---
`timeout`, the optional parameter of both concurrency constructs.
---
TIMEOUT_NAME: NameId = name_id_at_row(68)
