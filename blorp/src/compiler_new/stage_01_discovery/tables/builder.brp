-- The discovery builder: the one owner of every discovery table and every id.
--
-- Each table is a `List` of managed record rows, and an id is the index of its row, so
-- the only way to mint an id is to read `next_*_id` before the matching
-- `append_*`. The ids are in `ids`, the row shapes in `rows`, and the body
-- nodes and child stack in `node_builder`; this module holds the record, the
-- appenders of every other table, interning, and diagnostics.
--
-- Builder threading. Every table must stay uniquely referenced so each
-- append grows its list in place. The compiler hands a builder on without a
-- copy in the ordinary shapes (`b.f()`, `b.f().g()`, `out = out.f()`,
-- `out.f()` as a tail, a builder bound to a new name and used once), so
-- routines are written plainly. When it cannot see that a builder is handed
-- on at its last use it keeps a second reference, and the next update copies
-- the builder record and then every table appended to while the old record
-- lives: an O(n) copy per append. These shapes still do that, so routines
-- avoid them (`tools/builder_rule_probe.brp`
-- has one process per shape and a flat control for each):
--
-- 1. Read the builder before handing it on. A read after the builder went
--    into a call keeps the old record alive, whether it is a later statement
--    or the condition of an `if` after `var out = b`.
--        copies:  handed = b.append_node(row)   then   n = b.nodes.length()
--        flat:    n = b.nodes.length()   then   handed = b.append_node(row)
--
-- 2. Do not chain, return an `if` or `match` of calls, or bind a call result
--    (`x = out.f()`) on a `var` builder that is also reassigned under an
--    `if`, a `match` or a loop. Keep one call per statement and end with a
--    single tail call; chain from a parameter or from a binding that is never
--    reassigned.
--        copies:  out = out.f().g()      (in an arm, `out` used afterwards)
--        flat:    out = out.f()   then   out = out.g()
--
-- 3. Declare a `var` builder before a branch, not inside an `if` or `match`
--    arm whose other arm hands the builder on directly.
--        copies:  if c: b.f()   else: var out = b   then a loop of updates
--        flat:    var out = b   then branch on `out`
--
-- 4. A record update's new field value reads only that field of the record;
--    no other field of it, or list held from it, stays live across the
--    update. Read single values into locals first.
--        copies:  { b | nodes = b.nodes.append(row(b.nodes.length())) }
--        flat:    n = b.nodes.length()   then   { b | nodes = b.nodes.append(row(n)) }
--
-- 5. The builder is not captured by a closure or stored in a record or any
--    other value.
--
-- `tools/builder_append_probe.brp` and `tools/discovery_dump.brp` measure the
-- effect, and the compiler-new gate (`tables/test_allocation_budget.brp`)
-- fails when parsing a construct starts copying tables.
--
-- Text lives only in the names, paths, source texts and literals tables. An
-- optional relationship is a row in a side table; variable-length data is a
-- contiguous block of a child table addressed by a `RowRange`.
import:
	../lex/lexed_module: HoleScan
	../syntax/spellings: Spellings
	debug as dbg
	diagnostic_code: PlainSyntaxCode, ResolutionDiagnostic, SyntaxDiagnostic(Plain)
	ids:
		BoundId,
		DefinitionId,
		DiagnosticId,
		ForeignBlockId,
		ImportId,
		ImportItemId,
		LiteralId,
		ModuleId,
		NameId,
		NodeId,
		PackageId,
		ParameterId,
		PathId,
		SourceId,
		SupertraitId,
		bound_id_at_row,
		definition_id_at_row,
		definition_id_index,
		definition_ids_equal,
		diagnostic_id_at_row,
		foreign_block_id_at_row,
		foreign_block_id_index,
		import_id_at_row,
		import_id_index,
		import_item_id_at_row,
		import_item_id_index,
		literal_id_at_row,
		module_id_at_row,
		module_id_index,
		name_id_at_row,
		node_id_at_row,
		package_id_at_row,
		parameter_id_at_row,
		path_id_at_row,
		path_id_index,
		source_id_at_row,
		supertrait_id_at_row,
	intern_index:
		INITIAL_SLOT_COUNT,
		NO_ROW,
		empty_slots,
		find_slice,
		slice_hash,
		slots_for_texts,
		slots_with_row,
		text_hash,
	invariants/violation: DiscoveryTable(SourceTable, SourceTextTable), discovery_table_name
	name_vocabulary: ALL_SEEDED_NAME_SPELLINGS
	row_kinds:
		FunctionAnnotation(TailRecursiveAnnotation),
		ImportRequestShape,
		ModuleOriginKind,
		ModuleReach,
		ParameterBinder(NamedParameterBinder, TupleParameterBinder, WildcardParameterBinder),
		TypeParameterKind(TypeParameter),
	rows:
		AnnotationRow,
		BinderNameRow,
		BodyRow,
		BoundQualifierRow,
		BoundRow,
		DefinitionRow,
		DefinitionTypeRow,
		DimensionConstraintRow,
		DimensionNameRow,
		DocumentationRow,
		ElseKeywordRow,
		ForeignArgumentRow,
		ForeignBindingRow,
		ForeignBlockRow,
		ForeignCNameRow,
		ImplRow,
		ImplicitRequestRow,
		ImportAliasRow,
		ImportBlockRow,
		ImportItemAliasRow,
		ImportItemRow,
		ImportItemVariantRow,
		ImportRow,
		ImportTargetRow,
		MemberRow,
		ModuleDocumentationRow,
		ModulePackageRow,
		ModuleRow,
		NodeNameSpanRow,
		NodeRow,
		PackageRow,
		ParameterRow,
		ParameterTypeRow,
		PendingAnnotationRow,
		ResolutionDiagnosticRow,
		ResourceCleanupRow,
		RootRow,
		SignatureRow,
		SourceRow,
		SupertraitQualifierRow,
		SupertraitRow,
		SyntaxDiagnosticAt,
		TypeParameterRow,
		VariantPayloadRow,
	span: NO_SPAN, Span, span_covering
	token: Token


---
Every discovery table. Flat on purpose: each level of nesting is one more
uniqueness check a copy-on-write update has to pass.

`diagnostics` holds each module's lex and parse diagnostics, in the module's
contiguous block; `resolution_diagnostics` holds the module graph's: imports that
loaded no module, and sources that could not be admitted.

The fields after `resolution_diagnostics` are transient: the tokens of the
one module being parsed (and of its interpolation holes, appended after its
end-of-file token), the index of the parser's next token, the docstrings and
annotations read before their declaration's row exists, the module's lexing
state while holes are lexed (its spellings, and the name row each spelling was
interned as; `None` spellings while a hole is being lexed), the module's
interpolated strings, the roots of the child nodes a parent node has not yet
claimed. The lexer's product (`LexedModule`) enters them through the bridge
(`parse/lexed_bridge`), which interns its names and literals into this
builder's tables and rewrites the tokens' payloads to match;
`without_transient_tables` empties them when a module's lexing starts. They
live here because parsing appends rows while it consumes tokens, and the
builder is the only value threaded through that work.

`freeze` moves the tables into a `DiscoveryTables` (see `discovery_tables`) and
drops the transient fields and the four intern indexes with the builder, so
nothing that reads frozen tables can see them.
---
record DiscoveryBuilder {
	name_spellings: List[String],
	name_slots: List[Int],
	paths: List[String],
	path_ids_by_text: Dict[String, Int],
	source_texts: List[String],
	sources: List[SourceRow],
	line_starts: List[Int],
	packages: List[PackageRow],
	modules: List[ModuleRow],
	module_packages: List[ModulePackageRow],
	module_ids_by_path: Dict[Int, Int],
	roots: List[RootRow],
	implicit_requests: List[ImplicitRequestRow],
	imports: List[ImportRow],
	import_path_parts: List[NameId],
	import_items: List[ImportItemRow],
	import_item_variants: List[ImportItemVariantRow],
	import_targets: List[ImportTargetRow],
	import_aliases: List[ImportAliasRow],
	import_item_aliases: List[ImportItemAliasRow],
	import_blocks: List[ImportBlockRow],
	definitions: List[DefinitionRow],
	members: List[MemberRow],
	documentation: List[DocumentationRow],
	module_documentation: List[ModuleDocumentationRow],
	annotations: List[AnnotationRow],
	type_parameters: List[TypeParameterRow],
	bounds: List[BoundRow],
	bound_qualifiers: List[BoundQualifierRow],
	supertraits: List[SupertraitRow],
	supertrait_qualifiers: List[SupertraitQualifierRow],
	impls: List[ImplRow],
	signatures: List[SignatureRow],
	parameters: List[ParameterRow],
	binder_names: List[BinderNameRow],
	parameter_types: List[ParameterTypeRow],
	definition_types: List[DefinitionTypeRow],
	variant_payloads: List[VariantPayloadRow],
	dimension_constraints: List[DimensionConstraintRow],
	foreign_blocks: List[ForeignBlockRow],
	foreign_arguments: List[ForeignArgumentRow],
	foreign_bindings: List[ForeignBindingRow],
	foreign_c_names: List[ForeignCNameRow],
	resource_cleanups: List[ResourceCleanupRow],
	bodies: List[BodyRow],
	nodes: List[NodeRow],
	node_children: List[NodeId],
	node_name_spans: List[NodeNameSpanRow],
	else_keywords: List[ElseKeywordRow],
	dimension_names: List[DimensionNameRow],
	literals: List[String],
	literal_slots: List[Int],
	diagnostics: List[SyntaxDiagnosticAt],
	resolution_diagnostics: List[ResolutionDiagnosticRow],
	tokens: List[Token],
	token_cursor: Int,
	pending_docstrings: List[LiteralId],
	pending_annotations: List[PendingAnnotationRow],
	lexing_spellings: Option[Spellings],
	spelling_name_rows: List[Int],
	interpolations: List[BridgedInterpolation],
	child_stack: List[NodeId],
	child_stack_depth: Int
}


---
A builder whose name table holds `ALL_SEEDED_NAME_SPELLINGS` at their pinned ids
and whose other tables are empty.
---
pure func empty_discovery_builder() -> DiscoveryBuilder:
	{
		name_spellings = ALL_SEEDED_NAME_SPELLINGS,
		name_slots = slots_for_texts(ALL_SEEDED_NAME_SPELLINGS, INITIAL_SLOT_COUNT),
		paths = [],
		path_ids_by_text = {},
		source_texts = [],
		sources = [],
		line_starts = [],
		packages = [],
		modules = [],
		module_packages = [],
		module_ids_by_path = {},
		roots = [],
		implicit_requests = [],
		imports = [],
		import_path_parts = [],
		import_items = [],
		import_item_variants = [],
		import_targets = [],
		import_aliases = [],
		import_item_aliases = [],
		import_blocks = [],
		definitions = [],
		members = [],
		documentation = [],
		module_documentation = [],
		annotations = [],
		type_parameters = [],
		bounds = [],
		bound_qualifiers = [],
		supertraits = [],
		supertrait_qualifiers = [],
		impls = [],
		signatures = [],
		parameters = [],
		binder_names = [],
		parameter_types = [],
		definition_types = [],
		variant_payloads = [],
		dimension_constraints = [],
		foreign_blocks = [],
		foreign_arguments = [],
		foreign_bindings = [],
		foreign_c_names = [],
		resource_cleanups = [],
		bodies = [],
		nodes = [],
		node_children = [],
		node_name_spans = [],
		else_keywords = [],
		dimension_names = [],
		literals = [],
		literal_slots = empty_slots(INITIAL_SLOT_COUNT),
		diagnostics = [],
		resolution_diagnostics = [],
		tokens = [],
		token_cursor = 0,
		pending_docstrings = [],
		pending_annotations = [],
		lexing_spellings = None,
		spelling_name_rows = [],
		interpolations = [],
		child_stack = [],
		child_stack_depth = 0
	}


-- Names, paths and literals: interned text.
---
What the `interned_*_index` lookups return for text that is not interned:
never a row index. The hot lexer path uses these instead of `Option`
lookups, which allocate.
---
NOT_INTERNED: Int = NO_ROW


---
The row of `spelling` in the name table, or `NOT_INTERNED`.
---
pure func interned_name_index(builder: DiscoveryBuilder, spelling: String) -> Int:
	builder.interned_name_slice_index(spelling, 0, spelling.length())


---
The row of the name spelled by bytes `start .. end` of `source`, or
`NOT_INTERNED`; allocates nothing.
---
pure func interned_name_slice_index(
	builder: DiscoveryBuilder,
	source: String,
	start: Int,
	end: Int,
) -> Int:
	hash: Int = slice_hash(source, start, end)
	find_slice(builder.name_spellings, builder.name_slots, source, start, end, hash)


---
The row of `text` in the literal table, or `NOT_INTERNED`.
---
pure func interned_literal_index(builder: DiscoveryBuilder, text: String) -> Int:
	builder.interned_literal_slice_index(text, 0, text.length())


---
The row of the literal spelled by bytes `start .. end` of `source`, or
`NOT_INTERNED`; allocates nothing.
---
pure func interned_literal_slice_index(
	builder: DiscoveryBuilder,
	source: String,
	start: Int,
	end: Int,
) -> Int:
	hash: Int = slice_hash(source, start, end)
	find_slice(builder.literals, builder.literal_slots, source, start, end, hash)


---
The id `spelling` already has, if it was interned before.
---
pure func find_name_id(builder: DiscoveryBuilder, spelling: String) -> Option[NameId]:
	index: Int = builder.interned_name_index(spelling)

	if index == NOT_INTERNED:
		None
	else:
		Some(name_id_at_row(index))


---
The id the next appended name will receive.
---
pure func next_name_id(builder: DiscoveryBuilder) -> NameId:
	name_id_at_row(builder.name_spellings.length())


---
Appends a spelling that is not interned yet; callers check
`interned_name_index` or `interned_name_slice_index` first.
---
pure func append_name(builder: DiscoveryBuilder, spelling: String) -> DiscoveryBuilder:
	row: Int = builder.name_spellings.length()
	hash: Int = text_hash(spelling)
	-- One record update that reads only the fields it replaces (see the threading
	-- rules at the top of this file).
	{ builder |
		name_slots = slots_with_row(builder.name_slots, row, hash, row + 1),
		name_spellings = builder.name_spellings.append(spelling)
	}


pure func find_path_id(builder: DiscoveryBuilder, text: String) -> Option[PathId]:
	match builder.path_ids_by_text.get(text):
		Some(index):
			Some(path_id_at_row(index))
		None:
			None


pure func next_path_id(builder: DiscoveryBuilder) -> PathId:
	path_id_at_row(builder.paths.length())


---
Appends a path text that is not interned yet; callers check `find_path_id`
first.
---
pure func append_path(builder: DiscoveryBuilder, text: String) -> DiscoveryBuilder:
	index: Int = builder.paths.length()
	{ builder |
		paths = builder.paths.append(text),
		path_ids_by_text = builder.path_ids_by_text.set(text, index)
	}


---
Appends a literal text that is not interned yet; callers check
`interned_literal_index` or `interned_literal_slice_index` first.
---
pure func append_literal(builder: DiscoveryBuilder, text: String) -> DiscoveryBuilder:
	row: Int = builder.literals.length()
	hash: Int = text_hash(text)
	{ builder |
		literal_slots = slots_with_row(builder.literal_slots, row, hash, row + 1),
		literals = builder.literals.append(text)
	}


-- Sources, packages and modules.
pure func next_source_id(builder: DiscoveryBuilder) -> SourceId:
	source_id_at_row(builder.sources.length())


pure func next_line_start_row(builder: DiscoveryBuilder) -> Int:
	builder.line_starts.length()


pure func append_line_start(builder: DiscoveryBuilder, offset: Int) -> DiscoveryBuilder:
	{ builder | line_starts = builder.line_starts.append(offset) }


---
Appends a source's text and row; its line starts must already be the block
`row.line_starts` of the line-start table.
---
pure func append_source(
	builder: DiscoveryBuilder,
	text: String,
	row: SourceRow,
) -> DiscoveryBuilder:
	{ builder |
		source_texts = builder.source_texts.append(text),
		sources = builder.sources.append(row)
	}


pure func next_package_id(builder: DiscoveryBuilder) -> PackageId:
	package_id_at_row(builder.packages.length())


pure func append_package(builder: DiscoveryBuilder, row: PackageRow) -> DiscoveryBuilder:
	{ builder | packages = builder.packages.append(row) }


pure func next_module_id(builder: DiscoveryBuilder) -> ModuleId:
	module_id_at_row(builder.modules.length())


---
The module already loaded from `canonical_path`, if any.
---
pure func find_module_by_path(
	builder: DiscoveryBuilder,
	canonical_path: PathId,
) -> Option[ModuleId]:
	match builder.module_ids_by_path.get(canonical_path.path_id_index()):
		Some(index):
			Some(module_id_at_row(index))
		None:
			None


---
What `open_module` knows about a module when its parse begins: its identity
(the module id and the source admitted for it), and where each block of rows
that its parse appends starts. The opening is a managed record; its spelling
does not imply allocation-free storage.
---
private fixed record ModuleOpeningFields {
	module: ModuleId,
	source: SourceId,
	path: PathId,
	origin: ModuleOriginKind,
	reach: ModuleReach,
	definitions_first: Int,
	imports_first: Int,
	nodes_first: Int,
	diagnostics_first: Int
}


---
A module whose source is admitted and whose parse is under way. No row of it
is in the `modules` table yet: `close_module` appends the one complete row,
with its four row blocks ended where the parse left the tables, and it is the
only way a module row or the by-path index gains an entry. Only `open_module`
makes an opening, so the module, its source and where its blocks start
cannot be written by hand.
---
opaque type ModuleOpening = ModuleOpeningFields


---
Opens the module whose source `admit_source` appended last, whose canonical
path is that source's: each block of rows
the module's parse appends starts at the end of its table now. Modules load
one at a time, so the opening's module id is the next one, and nothing but this
module's own parse appends rows between `open_module` and `close_module`.
---
pure func open_module(
	builder: DiscoveryBuilder,
	origin: ModuleOriginKind,
	reach: ModuleReach,
) -> ModuleOpening:
	check_module_opens_in_turn(builder.sources.length(), builder.modules.length())
	source_index: Int = builder.sources.length() - 1
	fields: ModuleOpeningFields = {
		module = module_id_at_row(builder.modules.length()),
		source = source_id_at_row(source_index),
		path = builder.source_path_at(source_index),
		origin = origin,
		reach = reach,
		definitions_first = builder.definitions.length(),
		imports_first = builder.imports.length(),
		nodes_first = builder.nodes.length(),
		diagnostics_first = builder.diagnostics.length()
	}
	into_opaque ModuleOpening(fields)


---
The path of source row `source_index`, which an opening reads once, from the
source it was opened over. The row exists: `check_module_opens_in_turn` has
just required a source without a module.
---
private pure func source_path_at(builder: DiscoveryBuilder, source_index: Int) -> PathId:
	match builder.sources.get(source_index):
		Some(row):
			row.path
		None:
			report_unreachable_lookup(
				SourceTable,
				source_index,
				"a module opens over the source admitted for it",
			)
			path_id_at_row(0)


---
The id the opened module has.
---
pure func opened_module(opening: ModuleOpening) -> ModuleId:
	from_opaque ModuleOpening(opening).module


---
Modules load one at a time, each right after its source is admitted, so a
module opens when the sources outnumber the closed modules by exactly one. Any
other count means a module was opened twice, opened without its source, or
left open: a defect in the caller. A debug build stops with the message. A
function of two numbers, so the check holds no table.
---
private pure func check_module_opens_in_turn(source_count: Int, module_count: Int):
	debug:
		if source_count != module_count + 1:
			dbg.error(
				"a module was opened out of turn: its source is not the only one without a module",
			)


---
The number of rows a closing block holds, `block_end - block_first`, after a
debug-build guard of the one-close-per-opening rule: a row closes at the end of
its table, as the row its opening was made for (`next_row` is the table's length
now and `opened_as` the opening's id). Closed twice, or against a builder that
is not the one it was opened on, it does not, and the message says so. A
function of numbers that returns the count, because a bare guard call
statement in a close, even an empty one, made its record update copy.
---
private pure func block_count_closing_in_turn(
	block_end: Int,
	block_first: Int,
	next_row: Int,
	opened_as: Int,
) -> Int:
	debug:
		if next_row != opened_as:
			dbg.error("an opening was closed out of turn or twice")

	block_end - block_first


---
Appends the row of `opening`'s module, with every block ended over the rows
appended since it opened, and indexes it by its canonical path, the path of its source.
---
pure func close_module(builder: DiscoveryBuilder, opening: ModuleOpening) -> DiscoveryBuilder:
	fields: ModuleOpeningFields = from_opaque ModuleOpening(opening)
	index: Int = builder.modules.length()
	definitions_count: Int = block_count_closing_in_turn(
		builder.definitions.length(),
		fields.definitions_first,
		index,
		fields.module.module_id_index(),
	)
	imports_count: Int = builder.imports.length() - fields.imports_first
	nodes_count: Int = builder.nodes.length() - fields.nodes_first
	diagnostics_count: Int = builder.diagnostics.length() - fields.diagnostics_first
	path_index: Int = fields.path.path_id_index()

	row: ModuleRow = {
		source = fields.source,
		origin = fields.origin,
		reach = fields.reach,
		definitions = {
			first = fields.definitions_first,
			count = definitions_count
		},
		imports = {
			first = fields.imports_first,
			count = imports_count
		},
		nodes = {
			first = fields.nodes_first,
			count = nodes_count
		},
		diagnostics = {
			first = fields.diagnostics_first,
			count = diagnostics_count
		}
	}
	{ builder |
		modules = builder.modules.append(row),
		module_ids_by_path = builder.module_ids_by_path.set(path_index, index)
	}


pure func append_module_package(
	builder: DiscoveryBuilder,
	row: ModulePackageRow,
) -> DiscoveryBuilder:
	{ builder | module_packages = builder.module_packages.append(row) }


-- Roots and imports.
---
Appends a root with the outcome of resolving it. Written once, when the outcome
is known, so a root has its target or its rejection from the moment it exists.
---
pure func append_root(builder: DiscoveryBuilder, row: RootRow) -> DiscoveryBuilder:
	{ builder | roots = builder.roots.append(row) }


---
Appends an implicit request with the outcome of resolving it, as `append_root`.
---
pure func append_implicit_request(
	builder: DiscoveryBuilder,
	row: ImplicitRequestRow,
) -> DiscoveryBuilder:
	{ builder | implicit_requests = builder.implicit_requests.append(row) }


---
What `open_import` knows about an import that has begun: who imports, how it is
requested, and where its path parts and items start. Its path span
and end are known only when its parse ends.
---
private fixed record ImportOpeningFields {
	import_id: ImportId,
	importer: ModuleId,
	request: ImportRequestShape,
	path_parts_first: Int,
	items_first: Int,
	start: Span
}


---
An import whose path, alias and items are being parsed. No row of it is in
`imports` yet: `close_import` appends the one complete row, so a row never
holds a range or an end that is still to be decided. Only `open_import` makes
an opening, so the id and where the blocks start cannot be forged. Blorp has no
linear types, so closing an opening once is the caller's obligation; a debug
build reports a second close or a close against another builder state.
---
opaque type ImportOpening = ImportOpeningFields


---
Opens the import that starts at `start`. Its path parts and items start at the
end of `import_path_parts` and `import_items` now; the table is read here, so
no caller names where a block starts. Imports do not nest, so the opening's id
is the next row.
---
pure func open_import(
	builder: DiscoveryBuilder,
	importer: ModuleId,
	request: ImportRequestShape,
	start: Span,
) -> ImportOpening:
	fields: ImportOpeningFields = {
		import_id = import_id_at_row(builder.imports.length()),
		importer = importer,
		request = request,
		path_parts_first = builder.import_path_parts.length(),
		items_first = builder.import_items.length(),
		start = start
	}
	into_opaque ImportOpening(fields)


---
The id the opened import has: its alias and items name it before its row exists.
---
pure func opened_import(opening: ImportOpening) -> ImportId:
	from_opaque ImportOpening(opening).import_id


---
Appends the row of `opening`'s import. Its path parts and items are the rows
appended to `import_path_parts` and `import_items` since it opened; `path_span`
is the span of its path. It spans from its start to `end`.
---
pure func close_import(
	builder: DiscoveryBuilder,
	opening: ImportOpening,
	path_span: Span,
	end: Span,
) -> DiscoveryBuilder:
	fields: ImportOpeningFields = from_opaque ImportOpening(opening)
	parts_count: Int = builder.import_path_parts.length() - fields.path_parts_first
	items_count: Int = block_count_closing_in_turn(
		builder.import_items.length(),
		fields.items_first,
		builder.imports.length(),
		fields.import_id.import_id_index(),
	)
	row: ImportRow = {
		importer = fields.importer,
		request = fields.request,
		path_parts = {
			first = fields.path_parts_first,
			count = parts_count
		},
		items = {
			first = fields.items_first,
			count = items_count
		},
		path_span = path_span,
		span = fields.start.span_covering(end)
	}
	{ builder | imports = builder.imports.append(row) }


pure func next_import_path_part_row(builder: DiscoveryBuilder) -> Int:
	builder.import_path_parts.length()


pure func append_import_path_part(builder: DiscoveryBuilder, part: NameId) -> DiscoveryBuilder:
	{ builder | import_path_parts = builder.import_path_parts.append(part) }


---
What `open_import_item` knows about a selected symbol whose name is read: the
row's columns but its variants and its end.
---
private fixed record ImportItemOpeningFields {
	item: ImportItemId,
	owner_import: ImportId,
	name: NameId,
	variants_first: Int,
	start: Span
}


---
A selected symbol whose constructors and alias are being parsed. No row of it
is in `import_items` yet: `close_import_item` appends the one complete row.
---
opaque type ImportItemOpening = ImportItemOpeningFields


---
Opens the item `name` of `owner_import`, read at `start`; its variants start at
the end of `import_item_variants` now. Items do not nest, so the opening's id is
the next one.
---
pure func open_import_item(
	builder: DiscoveryBuilder,
	owner_import: ImportId,
	name: NameId,
	start: Span,
) -> ImportItemOpening:
	fields: ImportItemOpeningFields = {
		item = import_item_id_at_row(builder.import_items.length()),
		owner_import = owner_import,
		name = name,
		variants_first = builder.import_item_variants.length(),
		start = start
	}
	into_opaque ImportItemOpening(fields)


---
The id the opened item has: its variants and alias name it before its row
exists.
---
pure func opened_import_item(opening: ImportItemOpening) -> ImportItemId:
	from_opaque ImportItemOpening(opening).item


---
Appends the row of `opening`'s item: its variants are the rows appended to
`import_item_variants` since it opened, its name span is where it started, and it
spans through `end`.
---
pure func close_import_item(
	builder: DiscoveryBuilder,
	opening: ImportItemOpening,
	end: Span,
) -> DiscoveryBuilder:
	fields: ImportItemOpeningFields = from_opaque ImportItemOpening(opening)
	variants_count: Int = block_count_closing_in_turn(
		builder.import_item_variants.length(),
		fields.variants_first,
		builder.import_items.length(),
		fields.item.import_item_id_index(),
	)
	row: ImportItemRow = {
		owner_import = fields.owner_import,
		name = fields.name,
		variants = {
			first = fields.variants_first,
			count = variants_count
		},
		name_span = fields.start,
		span = fields.start.span_covering(end)
	}
	{ builder | import_items = builder.import_items.append(row) }


pure func next_import_item_variant_row(builder: DiscoveryBuilder) -> Int:
	builder.import_item_variants.length()


pure func append_import_item_variant(
	builder: DiscoveryBuilder,
	row: ImportItemVariantRow,
) -> DiscoveryBuilder:
	{ builder | import_item_variants = builder.import_item_variants.append(row) }


pure func append_import_target(builder: DiscoveryBuilder, row: ImportTargetRow) -> DiscoveryBuilder:
	{ builder | import_targets = builder.import_targets.append(row) }


pure func append_import_alias(builder: DiscoveryBuilder, row: ImportAliasRow) -> DiscoveryBuilder:
	{ builder | import_aliases = builder.import_aliases.append(row) }


pure func append_import_item_alias(
	builder: DiscoveryBuilder,
	row: ImportItemAliasRow,
) -> DiscoveryBuilder:
	{ builder | import_item_aliases = builder.import_item_aliases.append(row) }


-- Declarations.
---
The id the next appended definition will receive.
---
pure func next_definition_id(builder: DiscoveryBuilder) -> DefinitionId:
	definition_id_at_row(builder.definitions.length())


---
Where `type_parameters` stood when its owner opened: a bound is numbered by how
many parameters the table has gained since. Its own type, not an `Int`, so a
sink can carry the start directly.
---
opaque type TypeParametersStart = Int

---
Where `supertraits` stood when its trait opened.
---
opaque type SupertraitsStart = Int


---
A definition that owns ordered rows (members, type parameters, supertraits,
variant payloads, parameters), with where each of those tables stood when it
opened. Its rows are written while it is the one being parsed, so a row's
ordinal is how many rows its table has gained since: the table's length less
the start recorded here, never a count a caller keeps. The snapshot is a
managed record even though each field represents an integer.
---
fixed record OwnedRows {
	definition: DefinitionId,
	members_first: Int,
	type_parameters_first: TypeParametersStart,
	supertraits_first: SupertraitsStart,
	variant_payloads_first: Int,
	parameters_first: Int
}


---
The `OwnedRows` of `definition`, taken as it opens: every table starts at its
end now.
---
pure func owned_rows(builder: DiscoveryBuilder, definition: DefinitionId) -> OwnedRows:
	{
		definition = definition,
		members_first = builder.members.length(),
		type_parameters_first = into_opaque TypeParametersStart(builder.type_parameters.length()),
		supertraits_first = into_opaque SupertraitsStart(builder.supertraits.length()),
		variant_payloads_first = builder.variant_payloads.length(),
		parameters_first = builder.parameters.length()
	}


---
What a written type parameter holds apart from its owner and its place among
the owner's parameters, which the table gives it.
---
fixed record WrittenTypeParameter {
	name: NameId,
	kind: TypeParameterKind,
	name_span: Span,
	span: Span
}


---
Appends `parameter` as the next type parameter of `owner`.
---
pure func append_type_parameter(
	builder: DiscoveryBuilder,
	owner: OwnedRows,
	parameter: WrittenTypeParameter,
) -> DiscoveryBuilder:
	ordinal: Int = builder.type_parameters.length() - from_opaque TypeParametersStart(
		owner.type_parameters_first
	)
	{ builder | type_parameters = builder.type_parameters.append({
			owner = owner.definition,
			ordinal = ordinal,
			name = parameter.name,
			kind = parameter.kind,
			name_span = parameter.name_span,
			span = parameter.span,
		}) }


pure func next_bound_id(builder: DiscoveryBuilder) -> BoundId:
	bound_id_at_row(builder.bounds.length())


---
Appends a bound on the type parameter of `owner` that is being parsed, the one
the next `append_type_parameter` of `owner` will write.
---
pure func append_bound(
	builder: DiscoveryBuilder,
	owner: DefinitionId,
	parameters_start: TypeParametersStart,
	trait_name: NameId,
	name_span: Span,
	span: Span,
) -> DiscoveryBuilder:
	parameter_ordinal: Int = builder.type_parameters.length() - from_opaque TypeParametersStart(
		parameters_start
	)
	{ builder | bounds = builder.bounds.append({
			owner = owner,
			parameter_ordinal = parameter_ordinal,
			trait_name = trait_name,
			name_span = name_span,
			span = span,
		}) }


pure func append_bound_qualifier(
	builder: DiscoveryBuilder,
	row: BoundQualifierRow,
) -> DiscoveryBuilder:
	{ builder | bound_qualifiers = builder.bound_qualifiers.append(row) }


pure func append_foreign_binding(
	builder: DiscoveryBuilder,
	row: ForeignBindingRow,
) -> DiscoveryBuilder:
	{ builder | foreign_bindings = builder.foreign_bindings.append(row) }


pure func append_import_block(builder: DiscoveryBuilder, row: ImportBlockRow) -> DiscoveryBuilder:
	{ builder | import_blocks = builder.import_blocks.append(row) }


pure func append_module_documentation(
	builder: DiscoveryBuilder,
	row: ModuleDocumentationRow,
) -> DiscoveryBuilder:
	{ builder | module_documentation = builder.module_documentation.append(row) }


---
Closes the span of `definition`'s row. `opened` is the row as it was
appended, so the closing writes that row back with its span ended: no other
column can change, and the table is not read again. This assumes the
closing is the only writer of the row between its opening and now: nothing else
replaces a definition row, and `opened` is that opening's own row.
---
pure func set_definition_span(
	builder: DiscoveryBuilder,
	definition: DefinitionId,
	opened: DefinitionRow,
	span: Span,
) -> DiscoveryBuilder:
	index: Int = definition.definition_id_index()
	{ builder | definitions = builder.definitions.set(index, { opened | span = span }) }


pure func append_documentation(
	builder: DiscoveryBuilder,
	row: DocumentationRow,
) -> DiscoveryBuilder:
	{ builder | documentation = builder.documentation.append(row) }


pure func append_annotation(builder: DiscoveryBuilder, row: AnnotationRow) -> DiscoveryBuilder:
	{ builder | annotations = builder.annotations.append(row) }


pure func next_supertrait_id(builder: DiscoveryBuilder) -> SupertraitId:
	supertrait_id_at_row(builder.supertraits.length())


---
Appends a supertrait of `trait_definition`, the next in its declaration order.
---
pure func append_supertrait(
	builder: DiscoveryBuilder,
	trait_definition: DefinitionId,
	supertraits_start: SupertraitsStart,
	trait_name: NameId,
	name_span: Span,
	span: Span,
) -> DiscoveryBuilder:
	ordinal: Int = builder.supertraits.length() - from_opaque SupertraitsStart(supertraits_start)
	{ builder | supertraits = builder.supertraits.append({
			trait_definition = trait_definition,
			ordinal = ordinal,
			name = trait_name,
			name_span = name_span,
			span = span,
		}) }


pure func append_supertrait_qualifier(
	builder: DiscoveryBuilder,
	row: SupertraitQualifierRow,
) -> DiscoveryBuilder:
	{ builder | supertrait_qualifiers = builder.supertrait_qualifiers.append(row) }


pure func append_signature(builder: DiscoveryBuilder, row: SignatureRow) -> DiscoveryBuilder:
	{ builder | signatures = builder.signatures.append(row) }


pure func next_parameter_id(builder: DiscoveryBuilder) -> ParameterId:
	parameter_id_at_row(builder.parameters.length())


---
Appends a parameter with the named binder `binder` (`_` binds the discard
name): the one binder name and the row in one update, so the row's block is
exactly that name.
---
pure func append_named_parameter(
	builder: DiscoveryBuilder,
	owner: OwnedRows,
	binder: BinderNameRow,
	binder_span: Span,
	span: Span,
) -> DiscoveryBuilder:
	names_first: Int = builder.binder_names.length()
	ordinal: Int = builder.parameters.length() - owner.parameters_first
	{ builder |
		binder_names = builder.binder_names.append(binder),
		parameters = builder.parameters.append({
			owner = owner.definition,
			ordinal = ordinal,
			binder = NamedParameterBinder,
			binder_names = {
				first = names_first,
				count = 1
			},
			binder_span = binder_span,
			span = span,
		})
	}


---
Appends a parameter with a wildcard binder: no binder names, so the row's block
is empty.
---
pure func append_wildcard_parameter(
	builder: DiscoveryBuilder,
	owner: OwnedRows,
	binder_span: Span,
	span: Span,
) -> DiscoveryBuilder:
	names_first: Int = builder.binder_names.length()
	ordinal: Int = builder.parameters.length() - owner.parameters_first
	{ builder | parameters = builder.parameters.append({
			owner = owner.definition,
			ordinal = ordinal,
			binder = WildcardParameterBinder,
			binder_names = {
				first = names_first,
				count = 0
			},
			binder_span = binder_span,
			span = span,
		}) }


---
Appends a parameter with a tuple binder over `names`, in the order written: the
names and the row in one update, so the row's block is exactly them. A count
outside two to four is the parser's diagnostic to report, not a state the
tables rule out.
---
pure func append_tuple_parameter(
	builder: DiscoveryBuilder,
	owner: OwnedRows,
	names: List[BinderNameRow],
	binder_span: Span,
	span: Span,
) -> DiscoveryBuilder:
	names_first: Int = builder.binder_names.length()
	names_count: Int = names.length()
	ordinal: Int = builder.parameters.length() - owner.parameters_first
	{ builder |
		binder_names = builder.binder_names.concat(names),
		parameters = builder.parameters.append({
			owner = owner.definition,
			ordinal = ordinal,
			binder = TupleParameterBinder,
			binder_names = {
				first = names_first,
				count = names_count
			},
			binder_span = binder_span,
			span = span,
		})
	}


pure func append_parameter_type(
	builder: DiscoveryBuilder,
	row: ParameterTypeRow,
) -> DiscoveryBuilder:
	{ builder | parameter_types = builder.parameter_types.append(row) }


pure func append_dimension_constraint(
	builder: DiscoveryBuilder,
	row: DimensionConstraintRow,
) -> DiscoveryBuilder:
	{ builder | dimension_constraints = builder.dimension_constraints.append(row) }


---
What `open_foreign_block` knows about a `foreign:` block that has begun.
---
private fixed record ForeignBlockOpeningFields {
	block: ForeignBlockId,
	module: ModuleId,
	arguments_first: Int,
	start: Span
}


---
A `foreign:` block whose arguments and functions are being parsed. No row of
it is in `foreign_blocks` yet: `close_foreign_block` appends the one complete
row.
---
opaque type ForeignBlockOpening = ForeignBlockOpeningFields


---
Opens the block of `module` that starts at `start`; its arguments start at the
end of `foreign_arguments` now. Blocks do not nest, so the opening's id is the
next one.
---
pure func open_foreign_block(
	builder: DiscoveryBuilder,
	module: ModuleId,
	start: Span,
) -> ForeignBlockOpening:
	fields: ForeignBlockOpeningFields = {
		block = foreign_block_id_at_row(builder.foreign_blocks.length()),
		module = module,
		arguments_first = builder.foreign_arguments.length(),
		start = start
	}
	into_opaque ForeignBlockOpening(fields)


---
The id the opened block has: its functions name it before its row exists.
---
pure func opened_foreign_block(opening: ForeignBlockOpening) -> ForeignBlockId:
	from_opaque ForeignBlockOpening(opening).block


---
Appends the row of `opening`'s block: its arguments are the rows appended to
`foreign_arguments` since it opened, and it spans from its start to `end`.
---
pure func close_foreign_block(
	builder: DiscoveryBuilder,
	opening: ForeignBlockOpening,
	end: Span,
) -> DiscoveryBuilder:
	fields: ForeignBlockOpeningFields = from_opaque ForeignBlockOpening(opening)
	arguments_count: Int = block_count_closing_in_turn(
		builder.foreign_arguments.length(),
		fields.arguments_first,
		builder.foreign_blocks.length(),
		fields.block.foreign_block_id_index(),
	)
	row: ForeignBlockRow = {
		module = fields.module,
		arguments = {
			first = fields.arguments_first,
			count = arguments_count
		},
		span = fields.start.span_covering(end)
	}
	{ builder | foreign_blocks = builder.foreign_blocks.append(row) }


pure func append_foreign_argument(
	builder: DiscoveryBuilder,
	row: ForeignArgumentRow,
) -> DiscoveryBuilder:
	{ builder | foreign_arguments = builder.foreign_arguments.append(row) }


pure func append_foreign_c_name(
	builder: DiscoveryBuilder,
	row: ForeignCNameRow,
) -> DiscoveryBuilder:
	{ builder | foreign_c_names = builder.foreign_c_names.append(row) }


pure func append_resource_cleanup(
	builder: DiscoveryBuilder,
	row: ResourceCleanupRow,
) -> DiscoveryBuilder:
	{ builder | resource_cleanups = builder.resource_cleanups.append(row) }


---
The tables of the module being parsed that no frozen row or violation names.
---
fixed union TransientTable:
	PendingDocstringTable
	PendingAnnotationTable
	BridgedInterpolationTable
	LexingSpellingsTable
	LexedLiteralTable
	ChildStackTable


---
The name of a transient table in a report.
---
pure func transient_table_name(table: TransientTable) -> String:
	match table:
		PendingDocstringTable:
			"PendingDocstringTable"
		PendingAnnotationTable:
			"PendingAnnotationTable"
		BridgedInterpolationTable:
			"BridgedInterpolationTable"
		LexingSpellingsTable:
			"LexingSpellingsTable"
		LexedLiteralTable:
			"LexedLiteralTable"
		ChildStackTable:
			"ChildStackTable"


---
`report_unreachable_lookup` for a transient table of the module being parsed.
---
pure func report_unreachable_transient(table: TransientTable, index: Int, guarantee: String):
	debug:
		dbg.error("${table.transient_table_name()} row ${index} does not exist, but ${guarantee}")


---
The text an unreachable lookup of a source's text returns: none.
---
UNREACHABLE_SOURCE_TEXT: String = ""


---
The text of `source`, which discovery admitted before it lexed the source. A
miss is a defect in the caller: it is reported and `UNREACHABLE_SOURCE_TEXT`
returned.
---
pure func source_text_of(builder: DiscoveryBuilder, source: SourceId) -> String:
	match builder.source_texts.get(source.source_id_index()):
		Some(text):
			text
		None:
			report_unreachable_lookup(
				SourceTextTable,
				source.source_id_index(),
				"discovery admits a source's text before it lexes the source",
			)
			UNREACHABLE_SOURCE_TEXT


---
Reports a lookup that cannot miss: an id the table issued, or an index inside a
range the caller read from the same table. A debug build stops with the
message, so the broken caller is found where it read; a release build returns
the documented `UNREACHABLE_...` row and goes on, since a language-level
operation must not crash. `guarantee` says why the row exists.
---
pure func report_unreachable_lookup(table: DiscoveryTable, index: Int, guarantee: String):
	debug:
		dbg.error("${table.discovery_table_name()} row ${index} does not exist, but ${guarantee}")


-- Diagnostics.
---
Appends a lexer or parser diagnostic that has no argument.
---
pure func append_plain_diagnostic(
	builder: DiscoveryBuilder,
	code: PlainSyntaxCode,
	span: Span,
) -> DiscoveryBuilder:
	builder.append_syntax_diagnostic(span, Plain(code))


---
The id the next appended diagnostic will receive.
---
pure func next_diagnostic_id(builder: DiscoveryBuilder) -> DiagnosticId:
	diagnostic_id_at_row(builder.diagnostics.length())


---
Appends a lexer or parser diagnostic at `span`.
---
pure func append_syntax_diagnostic(
	builder: DiscoveryBuilder,
	span: Span,
	diagnostic: SyntaxDiagnostic,
) -> DiscoveryBuilder:
	{ builder | diagnostics = builder.diagnostics.append({
			span = span,
			diagnostic = diagnostic,
		}) }


-- Transient tables of the module being lexed and parsed.
---
`builder` with its transient tables empty: how a module's lexing starts.
---
pure func without_transient_tables(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	{ builder |
		tokens = [],
		token_cursor = 0,
		pending_docstrings = [],
		pending_annotations = [],
		lexing_spellings = None,
		spelling_name_rows = [],
		interpolations = [],
		child_stack = [],
		child_stack_depth = 0
	}


---
Appends a docstring read before its declaration's row exists.
---
pure func append_pending_docstring(builder: DiscoveryBuilder, text: LiteralId) -> DiscoveryBuilder:
	{ builder | pending_docstrings = builder.pending_docstrings.append(text) }


pure func pending_docstring_count(builder: DiscoveryBuilder) -> Int:
	builder.pending_docstrings.length()


---
The literal an unreachable lookup of a literal id returns: the first row.
---
UNREACHABLE_LITERAL_ID: LiteralId = literal_id_at_row(0)


---
The pending docstring at `index`; callers pass an index inside a docstring
range they read from the pending docstrings, so a miss is a defect in the
caller: it is reported and `UNREACHABLE_LITERAL_ID` returned.
---
pure func pending_docstring_at(builder: DiscoveryBuilder, index: Int) -> LiteralId:
	match builder.pending_docstrings.get(index):
		Some(text):
			text
		None:
			report_unreachable_transient(
				PendingDocstringTable,
				index,
				"callers pass an index inside a docstring range they read",
			)
			UNREACHABLE_LITERAL_ID


-- Interpolated strings (read from the bridged lexing).
---
One piece of an interpolated string as the parser reads it: a text piece whose
decoded text is a row of the literals table, or a hole.
---
union BridgedPiece:
	BridgedText(BridgedTextPiece)
	BridgedHole(HoleScan)


---
A text piece of an interpolated string: its literal and the source bytes it
was read from.
---
fixed record BridgedTextPiece {
	text: LiteralId,
	span: Span
}


---
The pieces of one interpolated string of the module being parsed.
---
record BridgedInterpolation {
	pieces: List[BridgedPiece]
}


---
Appends the pieces of an interpolated string; the string token's payload is
the index of this row, which `bridged_interpolation_at` reads back.
---
pure func append_bridged_interpolation(
	builder: DiscoveryBuilder,
	interpolation: BridgedInterpolation,
) -> DiscoveryBuilder:
	{ builder | interpolations = builder.interpolations.append(interpolation) }


---
The interpolation an unreachable lookup of a bridged interpolation returns:
one with no pieces.
---
UNREACHABLE_BRIDGED_INTERPOLATION: BridgedInterpolation = {pieces = []}


---
The interpolation `index` of the module being parsed: the payload of an
interpolated string token. A miss is a defect in the caller: it is reported
and `UNREACHABLE_BRIDGED_INTERPOLATION` returned.
---
pure func bridged_interpolation_at(builder: DiscoveryBuilder, index: Int) -> BridgedInterpolation:
	match builder.interpolations.get(index):
		Some(interpolation):
			interpolation
		None:
			report_unreachable_transient(
				BridgedInterpolationTable,
				index,
				"an interpolated string token's payload indexes the interpolations bridged for it",
			)
			UNREACHABLE_BRIDGED_INTERPOLATION


pure func append_pending_annotation(
	builder: DiscoveryBuilder,
	row: PendingAnnotationRow,
) -> DiscoveryBuilder:
	{ builder | pending_annotations = builder.pending_annotations.append(row) }


pure func pending_annotation_count(builder: DiscoveryBuilder) -> Int:
	builder.pending_annotations.length()


---
The row `pending_annotation_at` returns for an index the table does not hold.
---
UNREACHABLE_PENDING_ANNOTATION: PendingAnnotationRow = {
	annotation = TailRecursiveAnnotation,
	span = NO_SPAN
}


---
The pending annotation at `index`. Callers pass an index inside a range they
read from `pending_annotation_count`, so a miss is a defect in the caller: it is
reported and `UNREACHABLE_PENDING_ANNOTATION` returned.
---
pure func pending_annotation_at(builder: DiscoveryBuilder, index: Int) -> PendingAnnotationRow:
	match builder.pending_annotations.get(index):
		Some(row):
			row
		None:
			report_unreachable_transient(
				PendingAnnotationTable,
				index,
				"callers pass an index inside a range they read",
			)
			UNREACHABLE_PENDING_ANNOTATION


pure func append_token(builder: DiscoveryBuilder, token: Token) -> DiscoveryBuilder:
	{ builder | tokens = builder.tokens.append(token) }


pure func token_count(builder: DiscoveryBuilder) -> Int:
	builder.tokens.length()


---
Moves the parser to token `index`: how a routine that first scans ahead
without consuming (a run of newlines, a skipped body) then consumes the
scanned tokens in one update.
---
pure func move_token_cursor(builder: DiscoveryBuilder, index: Int) -> DiscoveryBuilder:
	{ builder | token_cursor = index }


---
Moves the parser to the next token.
---
pure func advance_token(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	next: Int = builder.token_cursor + 1
	{ builder | token_cursor = next }


---
Appends a module graph diagnostic (an import that loaded no module, a source
that could not be admitted) at `span`.
---
pure func append_resolution_diagnostic_at(
	builder: DiscoveryBuilder,
	span: Span,
	diagnostic: ResolutionDiagnostic,
) -> DiscoveryBuilder:
	{ builder | resolution_diagnostics = builder.resolution_diagnostics.append({
			span = span,
			diagnostic = diagnostic,
		}) }
