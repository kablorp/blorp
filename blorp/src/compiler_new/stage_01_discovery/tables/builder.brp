-- The discovery builder: the one owner of every discovery table and every id.
--
-- Each table is a `List` of struct rows, and an id is the index of its row, so
-- the only way to mint an id is to read `next_*_id` before the matching
-- `append_*`.
--
-- Builder threading. Every table must stay uniquely referenced so each
-- append grows its list in place. The compiler hands a builder on without a
-- copy in the ordinary shapes (`b.f()`, `b.f().g()`, `out = out.f()`,
-- `out.f()` as a tail, a builder bound to a new name and used once), so
-- routines are written plainly. When it cannot see that a builder is handed
-- on at its last use it keeps a second reference, and the next update copies
-- the builder record and then every table appended to while the old record
-- lives: an O(n) copy per append. These shapes still do that, so routines
-- avoid them (`tools/builder_rule_probe.brp`
-- has one process per shape and a flat control for each):
--
-- 1. Read the builder before handing it on. A read after the builder went
--    into a call keeps the old record alive, whether it is a later statement
--    or the condition of an `if` after `var out = b`.
--    Issues: `docs/issues/read-after-builder-handoff-copies.md`,
--    `docs/issues/alias-move-blocked-by-condition-read.md`.
--        copies:  handed = b.append_node(row)   then   n = b.nodes.length()
--        flat:    n = b.nodes.length()   then   handed = b.append_node(row)
--
-- 2. Do not chain, return an `if` or `match` of calls, or bind a call result
--    (`x = out.f()`) on a `var` builder that is also reassigned under an
--    `if`, a `match` or a loop. Keep one call per statement and end with a
--    single tail call; chain from a parameter or from a binding that is never
--    reassigned.
--    Issue: `docs/issues/chain-on-reassigned-builder-var-copies.md`.
--        copies:  out = out.f().g()      (in an arm, `out` used afterwards)
--        flat:    out = out.f()   then   out = out.g()
--
-- 3. Declare a `var` builder before a branch, not inside an `if` or `match`
--    arm whose other arm hands the builder on directly.
--    Issue: `docs/issues/read-after-builder-handoff-copies.md`.
--        copies:  if c: b.f()   else: var out = b   then a loop of updates
--        flat:    var out = b   then branch on `out`
--
-- 4. A record update's new field value reads only that field of the record;
--    no other field of it, or list held from it, stays live across the
--    update. Read single values into locals first.
--    Issue: `docs/issues/record-update-same-field-read-copies.md`.
--        copies:  { b | nodes = b.nodes.append(row(b.nodes.length())) }
--        flat:    n = b.nodes.length()   then   { b | nodes = b.nodes.append(row(n)) }
--
-- 5. The builder is not captured by a closure or stored in a record or any
--    other value.
--    Issue: `docs/issues/builder-captured-or-stored-copies.md`.
--
-- `tools/builder_append_probe.brp` and `tools/discovery_dump.brp` measure the
-- effect, and the compiler-new gate (`tables/test_allocation_budget.brp`)
-- fails when parsing a construct starts copying tables.
--
-- Text lives only in the names, paths, source texts and literals tables. An
-- optional relationship is a row in a side table; variable-length data is a
-- contiguous block of a child table addressed by a `RowRange`.
import:
	debug as dbg
	diagnostic_code: DiscoveryDiagnosticCode
	intern_index:
		INITIAL_SLOT_COUNT,
		NO_ROW,
		empty_slots,
		find_slice,
		slice_hash,
		slots_for_texts,
		slots_with_row,
		text_hash,
	name_vocabulary: ALL_SEEDED_NAME_SPELLINGS
	row_kinds:
		DefinitionKind,
		FunctionAnnotation(TailRecursiveAnnotation),
		ImportRequestKind,
		ModuleOriginKind,
		ModuleReach,
		NodeKind(MissingExpressionNode),
		PackageKind,
		ParameterBinder,
		Purity,
		TypeParameterKind,
		Visibility,
		arity_admits,
		node_schema,
	span: Span, pack_span
	token: Token


---
A spelling identity: two names with the same spelling share one id.
---
opaque type NameId = Int

---
One source text read by discovery.
---
opaque type SourceId = Int

---
One interned path: a canonical module path or an import request's text.
---
opaque type PathId = Int

opaque type PackageId = Int

opaque type ModuleId = Int

---
One root request given to discovery, in the order given.
---
opaque type RootId = Int

---
One implicit module request: a standard-library module every compilation
loads without an import (see `ImplicitModules` in `pipeline`).
---
opaque type ImplicitRequestId = Int

opaque type ImportId = Int

opaque type ImportItemId = Int

---
One written trait bound: a row of `bounds`, by its position.
---
opaque type BoundId = Int

---
One written supertrait: a row of `supertraits`, by its position.
---
opaque type SupertraitId = Int

---
A declared thing (function, type, member, ...), minted in discovery.
---
opaque type DefinitionId = Int

---
One syntax node of a function body in the flat node table.
---
opaque type NodeId = Int

---
One interned literal text (string or number spelling, or foreign C text).
---
opaque type LiteralId = Int

---
One parameter of a function, method or foreign function.
---
opaque type ParameterId = Int

---
One `foreign:` block, whose arguments apply to every function it declares.
---
opaque type ForeignBlockId = Int


---
A contiguous block of rows in a child table: rows `first .. first + count`.
---
struct RowRange {
	first: Int,
	count: Int
}


---
The range with no rows, used for a parent row appended before its children
are known; the builder closes it once they are.
---
EMPTY_ROW_RANGE: RowRange = {
	first = 0,
	count = 0
}


---
The line starts of a source are rows `line_starts` of the `line_starts`
table; the text itself is `source_texts[source]`.
---
struct SourceRow {
	path: PathId,
	line_starts: RowRange
}


struct PackageRow {
	name: NameId,
	kind: PackageKind
}


---
One module. Its rows in the definitions, imports, nodes and diagnostics
tables are the contiguous blocks named here, closed when its parse ends.
---
struct ModuleRow {
	source: SourceId,
	canonical_path: PathId,
	origin: ModuleOriginKind,
	reach: ModuleReach,
	definitions: RowRange,
	imports: RowRange,
	nodes: RowRange,
	diagnostics: RowRange
}


---
A package module's package; most modules have none.
---
struct ModulePackageRow {
	module: ModuleId,
	package: PackageId
}


---
A root given to discovery: a source path, as given.
---
struct RootRow {
	request_path: PathId
}


---
The module a root request loaded; absent when it loaded none.
---
struct RootTargetRow {
	root: RootId,
	target: ModuleId
}


---
A root request that loaded no module, with the reason as a code and its
arguments (a block of `diagnostic_arguments`).
---
struct RootDiagnosticRow {
	root: RootId,
	code: DiscoveryDiagnosticCode,
	arguments: RowRange
}


---
An implicit module request: the module's name as given (`prelude`), interned
as a path like an import request's text.
---
struct ImplicitRequestRow {
	request_path: PathId
}


---
The module an implicit request loaded or found already loaded; absent when
it loaded none.
---
struct ImplicitTargetRow {
	request: ImplicitRequestId,
	target: ModuleId
}


---
An implicit request that loaded no module, with the reason as a code and its
arguments (a block of `diagnostic_arguments`).
---
struct ImplicitDiagnosticRow {
	request: ImplicitRequestId,
	code: DiscoveryDiagnosticCode,
	arguments: RowRange
}


---
One import item of a module's import block. `request_path` is the import
syntax, kept as text on purpose (for diagnostics and the legacy adapter);
resolution reads the structured form: `parent_steps` leading `../` (0 for
`./` and for non-relative requests), then the path parts, a block of
`import_path_parts`. `items` is a block of `import_items`. `path_span` covers
the module path, `span` the path through its aliases and selections.
---
struct ImportRow {
	importer: ModuleId,
	request_kind: ImportRequestKind,
	request_path: PathId,
	parent_steps: Int,
	path_parts: RowRange,
	items: RowRange,
	path_span: Span,
	span: Span
}


---
One selected symbol; `variants` is a block of `import_item_variants` for
`name(Variant, ...)` selections. `name_span` covers the name alone, `span` the
whole selection.
---
struct ImportItemRow {
	owner_import: ImportId,
	name: NameId,
	variants: RowRange,
	name_span: Span,
	span: Span
}


struct ImportItemVariantRow {
	item: ImportItemId,
	name: NameId,
	span: Span
}


---
The module an import loaded; absent when it loaded none.
---
struct ImportTargetRow {
	owner_import: ImportId,
	target: ModuleId
}


---
The alias of an import (`module as alias`); `span` covers the alias name.
---
struct ImportAliasRow {
	owner_import: ImportId,
	alias_name: NameId,
	span: Span
}


---
The alias of an imported symbol (`name as alias`); `span` covers the alias
name.
---
struct ImportItemAliasRow {
	item: ImportItemId,
	alias_name: NameId,
	span: Span
}


---
One row per declared thing, including members. `span` covers the whole
declaration (from its docstring, annotations or `pure`, when present);
`name_span` covers the name. Impls have no name of their own, so their name
columns hold the implemented trait's name.
---
struct DefinitionRow {
	module: ModuleId,
	kind: DefinitionKind,
	name: NameId,
	name_span: Span,
	visibility: Visibility,
	span: Span
}


---
A field, variant or method, with its owner and declaration order.
---
struct MemberRow {
	definition: DefinitionId,
	owner: DefinitionId,
	ordinal: Int
}


---
A declaration's docstring; most declarations have none.
---
struct DocumentationRow {
	definition: DefinitionId,
	text: LiteralId
}


---
A module's docstring: the one that opens the file directly before its first
`import:` block. At most one row per module; most modules have none.
---
struct ModuleDocumentationRow {
	module: ModuleId,
	text: LiteralId,
	span: Span
}


---
The two kinds of piece an interpolated string is made of.
---
enum InterpolationPart:
	TextPart
	HolePart


---
One piece of an interpolated string, in source order. `start .. end` are its
source bytes: the text as written, or a hole's expression between `${` and
its `}`. `text` is one row of `interpolation_texts` holding the decoded text
for a `TextPart`, and empty for a `HolePart`.
---
struct InterpolationPartRow {
	part: InterpolationPart,
	start: Int,
	end: Int,
	text: RowRange
}


---
An annotation read before the declaration it belongs to has a row: a
transient row the declaration copies into `annotations` once its
`DefinitionId` is known.
---
struct PendingAnnotationRow {
	annotation: FunctionAnnotation,
	span: Span
}


---
One `@annotation` of a function, in written order.
---
struct AnnotationRow {
	definition: DefinitionId,
	annotation: FunctionAnnotation,
	span: Span
}


---
A declared type or dimension parameter. `name_span` covers the name (with its
`#` for a dimension), `span` the name and its bounds.
---
struct TypeParameterRow {
	owner: DefinitionId,
	ordinal: Int,
	name: NameId,
	kind: TypeParameterKind,
	name_span: Span,
	span: Span
}


---
A written trait bound on the type parameter at `parameter_ordinal`,
unresolved; typecheck turns `trait_name` into a trait. `span` covers the whole
written reference, `module.Trait` included; the module alias, when written, is
the bound's `BoundQualifierRow`; `name_span` covers the trait's name alone.
---
struct BoundRow {
	owner: DefinitionId,
	parameter_ordinal: Int,
	trait_name: NameId,
	name_span: Span,
	span: Span
}


---
The module alias of a bound written `alias.Trait`; absent for `Trait`.
`span` covers the alias alone.
---
struct BoundQualifierRow {
	bound: BoundId,
	qualifier: NameId,
	span: Span
}


---
A supertrait a trait names, in written order. `span` covers the whole written
reference, as for `BoundRow`; `name_span` covers the supertrait's name alone.
---
struct SupertraitRow {
	trait_definition: DefinitionId,
	ordinal: Int,
	name: NameId,
	name_span: Span,
	span: Span
}


---
The module alias of a supertrait written `alias.Trait`; absent for `Trait`.
`span` covers the alias alone.
---
struct SupertraitQualifierRow {
	supertrait: SupertraitId,
	qualifier: NameId,
	span: Span
}


---
The signature of a function, method or foreign function: its purity, the
span of its `func` keyword, and its parameters, a block of `parameters`.
Every function-like definition has exactly one.
---
struct SignatureRow {
	definition: DefinitionId,
	purity: Purity,
	keyword_span: Span,
	parameters: RowRange
}


---
One parameter. `binder_names` is a block of `binder_names`: one name for a
named binder (`_` for a typed discard), none for a wildcard, two to four for
a tuple binder. `binder_span` covers the binder, `span` the whole parameter.
---
struct ParameterRow {
	owner: DefinitionId,
	ordinal: Int,
	binder: ParameterBinder,
	binder_names: RowRange,
	binder_span: Span,
	span: Span
}


struct BinderNameRow {
	name: NameId,
	span: Span
}


---
A parameter's written type; absent when the type is inferred.
---
struct ParameterTypeRow {
	parameter: ParameterId,
	type_root: NodeId
}


---
The one type a definition declares, whose role its kind fixes: a
function's, method's or foreign function's return type, a global's declared
type, an alias's or opaque type's target, an impl's receiver type, a field's
type. Absent when not written.
---
struct DefinitionTypeRow {
	definition: DefinitionId,
	type_root: NodeId
}


---
One payload type of a variant, in written order.
---
struct VariantPayloadRow {
	variant: DefinitionId,
	ordinal: Int,
	type_root: NodeId
}


---
One `where left == right` dimension constraint of a function.
---
struct DimensionConstraintRow {
	owner: DefinitionId,
	left: NodeId,
	right: NodeId,
	span: Span
}


---
One `import:` block; `imports` is its block of `imports`.
---
struct ImportBlockRow {
	module: ModuleId,
	imports: RowRange,
	span: Span
}


---
One `foreign:` block; `arguments` is its block of `foreign_arguments`.
---
struct ForeignBlockRow {
	module: ModuleId,
	arguments: RowRange,
	span: Span
}


---
One `name: "value"` argument of a foreign block, such as `include`.
`name_span` covers the name, `span` the name through the value.
---
struct ForeignArgumentRow {
	name: NameId,
	value: LiteralId,
	name_span: Span,
	span: Span
}


---
The foreign block a foreign function belongs to.
---
struct ForeignBindingRow {
	definition: DefinitionId,
	block: ForeignBlockId
}


---
A foreign function's explicit C name (`= "c_name"`); absent when the C name
is the Blorp name.
---
struct ForeignCNameRow {
	definition: DefinitionId,
	c_name: LiteralId,
	span: Span
}


---
A resource type's cleanup builtin (`= builtin("cleanup")`).
---
struct ResourceCleanupRow {
	definition: DefinitionId,
	builtin_name: LiteralId,
	span: Span
}


---
A function's, method's or global's body: the root of its nodes.
---
struct BodyRow {
	definition: DefinitionId,
	root: NodeId
}


---
One body node. `payload` is fixed by `kind`; `children` addresses a block of
the `node_children` edge table.
---
struct NodeRow {
	kind: NodeKind,
	span: Span,
	payload: Int,
	children: RowRange
}


---
A dimension name and the spelling it has with its sigil: `N` and `#N`. The
lexer interns both when it joins a `#` to a name, and writes one row per
distinct dimension name, so a reader that needs the sigil spelling (the legacy
adapter) reads this row instead of building a spelling and looking it up.
---
struct DimensionNameRow {
	name: NameId,
	sigil_name: NameId
}


---
The span of the name a node carries, for a node whose name does not span the
whole node. Types: a generic or module-qualified named type (`List[T]`,
`m.Type`), a bounded type (`T: Eq`), a trait bound written through a module
alias, and a variadic dimension (`#Ds...`). Bodies: the field of a field access
and of a record field, the name a binding, assignment, `?=`, `with`, `on`,
select arm, concurrency parameter or typed lambda parameter binds, the
constructor of a constructor pattern, and the target of a list pattern's spread
(`...rest`, `..._`). A node whose name is the whole node has no row. At most one
row per node, in node order.
---
struct NodeNameSpanRow {
	node: NodeId,
	name_span: Span
}


---
The count a `concurrent(max_threads: n)` or `concurrently(limit: n)` parameter
wrote, as the checked integer the parser read from the literal (a positive
`Int`; a literal above its range saturates, as `parse_int` does). One row per
such parameter node, in node order; a parameter whose value is not a positive
integer literal (a diagnostic reports it) has none, and neither has `timeout`.
---
struct ConcurrencyCountRow {
	parameter: NodeId,
	count: Int
}


---
The span of the `else` keyword of an `IfNode` that has an else branch (its third
child). Neither branch's span covers the keyword, which the formatter places
comments around and the existing AST records. One row per such node, in node
order; an `IfNode` without an else branch has none.
---
struct ElseKeywordRow {
	node: NodeId,
	keyword_span: Span
}


---
A diagnostic at a source span; `arguments` is a block of
`diagnostic_arguments`, interpreted by `code`.
---
struct DiagnosticRow {
	code: DiscoveryDiagnosticCode,
	span: Span,
	arguments: RowRange
}


---
Whether the statement being parsed is inside a loop body. A function body
starts a new context (`NotInLoop`), and so does a lambda or `concurrent:` task
body: its `break` cannot leave the enclosing loop, and its `?=` returns from
the lambda or task, not the loop.
---
enum LoopContext:
	NotInLoop
	InLoopBody


---
Every discovery table. Flat on purpose: each level of nesting is one more
uniqueness check a copy-on-write update has to pass.

`diagnostics` holds each module's lex and parse diagnostics, in the module's
contiguous block; `resolution_diagnostics` holds the module graph's: imports that
loaded no module, and sources that could not be admitted.

The fields after `diagnostic_arguments` are transient: the tokens of the
one module being parsed (and of its interpolation holes, appended after its
end-of-file token), the index of the parser's next token, the docstrings and
annotations read before their declaration's row exists, the parts of the
module's interpolated strings, the roots of the child nodes a parent
node has not yet claimed, and the loop context of the body being parsed.
`without_transient_tables` empties them; lexing a module starts from it and
`freeze` drops them with it. They live here because lexing interns names and
literals into this builder while it produces tokens, and parsing appends
rows while it consumes them; the builder is the only value threaded through
that work.
---
record DiscoveryBuilder {
	name_spellings: List[String],
	name_slots: List[Int],
	paths: List[String],
	path_ids_by_text: Dict[String, Int],
	source_texts: List[String],
	sources: List[SourceRow],
	line_starts: List[Int],
	packages: List[PackageRow],
	modules: List[ModuleRow],
	module_packages: List[ModulePackageRow],
	module_ids_by_path: Dict[Int, Int],
	roots: List[RootRow],
	root_targets: List[RootTargetRow],
	root_diagnostics: List[RootDiagnosticRow],
	implicit_requests: List[ImplicitRequestRow],
	implicit_targets: List[ImplicitTargetRow],
	implicit_diagnostics: List[ImplicitDiagnosticRow],
	imports: List[ImportRow],
	import_path_parts: List[NameId],
	import_items: List[ImportItemRow],
	import_item_variants: List[ImportItemVariantRow],
	import_targets: List[ImportTargetRow],
	import_aliases: List[ImportAliasRow],
	import_item_aliases: List[ImportItemAliasRow],
	import_blocks: List[ImportBlockRow],
	definitions: List[DefinitionRow],
	members: List[MemberRow],
	documentation: List[DocumentationRow],
	module_documentation: List[ModuleDocumentationRow],
	annotations: List[AnnotationRow],
	type_parameters: List[TypeParameterRow],
	bounds: List[BoundRow],
	bound_qualifiers: List[BoundQualifierRow],
	supertraits: List[SupertraitRow],
	supertrait_qualifiers: List[SupertraitQualifierRow],
	signatures: List[SignatureRow],
	parameters: List[ParameterRow],
	binder_names: List[BinderNameRow],
	parameter_types: List[ParameterTypeRow],
	definition_types: List[DefinitionTypeRow],
	variant_payloads: List[VariantPayloadRow],
	dimension_constraints: List[DimensionConstraintRow],
	foreign_blocks: List[ForeignBlockRow],
	foreign_arguments: List[ForeignArgumentRow],
	foreign_bindings: List[ForeignBindingRow],
	foreign_c_names: List[ForeignCNameRow],
	resource_cleanups: List[ResourceCleanupRow],
	bodies: List[BodyRow],
	nodes: List[NodeRow],
	node_children: List[NodeId],
	node_name_spans: List[NodeNameSpanRow],
	else_keywords: List[ElseKeywordRow],
	concurrency_counts: List[ConcurrencyCountRow],
	dimension_names: List[DimensionNameRow],
	literals: List[String],
	literal_slots: List[Int],
	diagnostics: List[DiagnosticRow],
	resolution_diagnostics: List[DiagnosticRow],
	diagnostic_arguments: List[Int],
	tokens: List[Token],
	token_cursor: Int,
	pending_docstrings: List[LiteralId],
	pending_annotations: List[PendingAnnotationRow],
	interpolations: List[RowRange],
	interpolation_parts: List[InterpolationPartRow],
	interpolation_texts: List[LiteralId],
	child_stack: List[NodeId],
	child_stack_depth: Int,
	loop_context: LoopContext
}


---
A builder whose name table holds `ALL_SEEDED_NAME_SPELLINGS` at their pinned ids
and whose other tables are empty.
---
pure func empty_discovery_builder() -> DiscoveryBuilder:
	{
		name_spellings = ALL_SEEDED_NAME_SPELLINGS,
		name_slots = slots_for_texts(ALL_SEEDED_NAME_SPELLINGS, INITIAL_SLOT_COUNT),
		paths = [],
		path_ids_by_text = {},
		source_texts = [],
		sources = [],
		line_starts = [],
		packages = [],
		modules = [],
		module_packages = [],
		module_ids_by_path = {},
		roots = [],
		root_targets = [],
		root_diagnostics = [],
		implicit_requests = [],
		implicit_targets = [],
		implicit_diagnostics = [],
		imports = [],
		import_path_parts = [],
		import_items = [],
		import_item_variants = [],
		import_targets = [],
		import_aliases = [],
		import_item_aliases = [],
		import_blocks = [],
		definitions = [],
		members = [],
		documentation = [],
		module_documentation = [],
		annotations = [],
		type_parameters = [],
		bounds = [],
		bound_qualifiers = [],
		supertraits = [],
		supertrait_qualifiers = [],
		signatures = [],
		parameters = [],
		binder_names = [],
		parameter_types = [],
		definition_types = [],
		variant_payloads = [],
		dimension_constraints = [],
		foreign_blocks = [],
		foreign_arguments = [],
		foreign_bindings = [],
		foreign_c_names = [],
		resource_cleanups = [],
		bodies = [],
		nodes = [],
		node_children = [],
		node_name_spans = [],
		else_keywords = [],
		concurrency_counts = [],
		dimension_names = [],
		literals = [],
		literal_slots = empty_slots(INITIAL_SLOT_COUNT),
		diagnostics = [],
		resolution_diagnostics = [],
		diagnostic_arguments = [],
		tokens = [],
		token_cursor = 0,
		pending_docstrings = [],
		pending_annotations = [],
		interpolations = [],
		interpolation_parts = [],
		interpolation_texts = [],
		child_stack = [],
		child_stack_depth = 0,
		loop_context = NotInLoop
	}


-- Id readers. Every id is the index of its row.
pure func name_id_index(id: NameId) -> Int:
	from_opaque NameId(id)


pure func source_id_index(id: SourceId) -> Int:
	from_opaque SourceId(id)


pure func path_id_index(id: PathId) -> Int:
	from_opaque PathId(id)


pure func package_id_index(id: PackageId) -> Int:
	from_opaque PackageId(id)


pure func module_id_index(id: ModuleId) -> Int:
	from_opaque ModuleId(id)


pure func root_id_index(id: RootId) -> Int:
	from_opaque RootId(id)


pure func implicit_request_id_index(id: ImplicitRequestId) -> Int:
	from_opaque ImplicitRequestId(id)


pure func import_id_index(id: ImportId) -> Int:
	from_opaque ImportId(id)


pure func import_item_id_index(id: ImportItemId) -> Int:
	from_opaque ImportItemId(id)


pure func bound_id_index(id: BoundId) -> Int:
	from_opaque BoundId(id)


pure func supertrait_id_index(id: SupertraitId) -> Int:
	from_opaque SupertraitId(id)


pure func definition_id_index(id: DefinitionId) -> Int:
	from_opaque DefinitionId(id)


pure func node_id_index(id: NodeId) -> Int:
	from_opaque NodeId(id)


pure func literal_id_index(id: LiteralId) -> Int:
	from_opaque LiteralId(id)


pure func parameter_id_index(id: ParameterId) -> Int:
	from_opaque ParameterId(id)


pure func foreign_block_id_index(id: ForeignBlockId) -> Int:
	from_opaque ForeignBlockId(id)


pure func name_ids_equal(left: NameId, right: NameId) -> Bool:
	left.name_id_index() == right.name_id_index()


pure func module_ids_equal(left: ModuleId, right: ModuleId) -> Bool:
	left.module_id_index() == right.module_id_index()


pure func definition_ids_equal(left: DefinitionId, right: DefinitionId) -> Bool:
	left.definition_id_index() == right.definition_id_index()


---
Row-position conversions for readers walking a table or a `RowRange` that
freezing has validated. They are the read side of "an id is its row's
index"; only `next_*_id` mints an id for a row that does not exist yet.
---
pure func name_id_at_row(index: Int) -> NameId:
	into_opaque NameId(index)


pure func source_id_at_row(index: Int) -> SourceId:
	into_opaque SourceId(index)


pure func path_id_at_row(index: Int) -> PathId:
	into_opaque PathId(index)


pure func package_id_at_row(index: Int) -> PackageId:
	into_opaque PackageId(index)


pure func module_id_at_row(index: Int) -> ModuleId:
	into_opaque ModuleId(index)


pure func root_id_at_row(index: Int) -> RootId:
	into_opaque RootId(index)


pure func implicit_request_id_at_row(index: Int) -> ImplicitRequestId:
	into_opaque ImplicitRequestId(index)


pure func import_id_at_row(index: Int) -> ImportId:
	into_opaque ImportId(index)


pure func import_item_id_at_row(index: Int) -> ImportItemId:
	into_opaque ImportItemId(index)


pure func bound_id_at_row(index: Int) -> BoundId:
	into_opaque BoundId(index)


pure func supertrait_id_at_row(index: Int) -> SupertraitId:
	into_opaque SupertraitId(index)


pure func definition_id_at_row(index: Int) -> DefinitionId:
	into_opaque DefinitionId(index)


pure func node_id_at_row(index: Int) -> NodeId:
	into_opaque NodeId(index)


pure func literal_id_at_row(index: Int) -> LiteralId:
	into_opaque LiteralId(index)


-- Names, paths and literals: interned text.
---
What the `interned_*_index` lookups return for text that is not interned:
never a row index. The hot lexer path uses these instead of `Option`
lookups, which allocate.
---
NOT_INTERNED: Int = NO_ROW


---
The row of `spelling` in the name table, or `NOT_INTERNED`.
---
pure func interned_name_index(builder: DiscoveryBuilder, spelling: String) -> Int:
	builder.interned_name_slice_index(spelling, 0, spelling.length())


---
The row of the name spelled by bytes `start .. end` of `source`, or
`NOT_INTERNED`; allocates nothing.
---
pure func interned_name_slice_index(
	builder: DiscoveryBuilder,
	source: String,
	start: Int,
	end: Int,
) -> Int:
	hash: Int = slice_hash(source, start, end)
	find_slice(builder.name_spellings, builder.name_slots, source, start, end, hash)


---
The row of `text` in the literal table, or `NOT_INTERNED`.
---
pure func interned_literal_index(builder: DiscoveryBuilder, text: String) -> Int:
	builder.interned_literal_slice_index(text, 0, text.length())


---
The row of the literal spelled by bytes `start .. end` of `source`, or
`NOT_INTERNED`; allocates nothing.
---
pure func interned_literal_slice_index(
	builder: DiscoveryBuilder,
	source: String,
	start: Int,
	end: Int,
) -> Int:
	hash: Int = slice_hash(source, start, end)
	find_slice(builder.literals, builder.literal_slots, source, start, end, hash)


---
The id `spelling` already has, if it was interned before.
---
pure func find_name_id(builder: DiscoveryBuilder, spelling: String) -> Option[NameId]:
	index: Int = builder.interned_name_index(spelling)

	if index == NOT_INTERNED:
		None
	else:
		Some(into_opaque NameId(index))


---
The id the next appended name will receive.
---
pure func next_name_id(builder: DiscoveryBuilder) -> NameId:
	into_opaque NameId(builder.name_spellings.length())


---
Appends a spelling that is not interned yet; callers check
`interned_name_index` or `interned_name_slice_index` first.
---
pure func append_name(builder: DiscoveryBuilder, spelling: String) -> DiscoveryBuilder:
	row: Int = builder.name_spellings.length()
	hash: Int = text_hash(spelling)
	-- One record update that reads only the fields it replaces (see the threading
	-- rules at the top of this file).
	{ builder |
		name_slots = slots_with_row(builder.name_slots, row, hash, row + 1),
		name_spellings = builder.name_spellings.append(spelling)
	}


pure func find_path_id(builder: DiscoveryBuilder, text: String) -> Option[PathId]:
	match builder.path_ids_by_text.get(text):
		Some(index):
			Some(into_opaque PathId(index))
		None:
			None


pure func next_path_id(builder: DiscoveryBuilder) -> PathId:
	into_opaque PathId(builder.paths.length())


---
Appends a path text that is not interned yet; callers check `find_path_id`
first.
---
pure func append_path(builder: DiscoveryBuilder, text: String) -> DiscoveryBuilder:
	index: Int = builder.paths.length()
	{ builder |
		paths = builder.paths.append(text),
		path_ids_by_text = builder.path_ids_by_text.set(text, index)
	}


---
Appends a literal text that is not interned yet; callers check
`interned_literal_index` or `interned_literal_slice_index` first.
---
pure func append_literal(builder: DiscoveryBuilder, text: String) -> DiscoveryBuilder:
	row: Int = builder.literals.length()
	hash: Int = text_hash(text)
	{ builder |
		literal_slots = slots_with_row(builder.literal_slots, row, hash, row + 1),
		literals = builder.literals.append(text)
	}


-- Sources, packages and modules.
pure func next_source_id(builder: DiscoveryBuilder) -> SourceId:
	into_opaque SourceId(builder.sources.length())


pure func next_line_start_row(builder: DiscoveryBuilder) -> Int:
	builder.line_starts.length()


pure func append_line_start(builder: DiscoveryBuilder, offset: Int) -> DiscoveryBuilder:
	{ builder | line_starts = builder.line_starts.append(offset) }


---
Appends a source's text and row; its line starts must already be the block
`row.line_starts` of the line-start table.
---
pure func append_source(
	builder: DiscoveryBuilder,
	text: String,
	row: SourceRow,
) -> DiscoveryBuilder:
	{ builder |
		source_texts = builder.source_texts.append(text),
		sources = builder.sources.append(row)
	}


pure func next_package_id(builder: DiscoveryBuilder) -> PackageId:
	into_opaque PackageId(builder.packages.length())


pure func append_package(builder: DiscoveryBuilder, row: PackageRow) -> DiscoveryBuilder:
	{ builder | packages = builder.packages.append(row) }


pure func next_module_id(builder: DiscoveryBuilder) -> ModuleId:
	into_opaque ModuleId(builder.modules.length())


---
The module already loaded from `canonical_path`, if any.
---
pure func find_module_by_path(
	builder: DiscoveryBuilder,
	canonical_path: PathId,
) -> Option[ModuleId]:
	match builder.module_ids_by_path.get(canonical_path.path_id_index()):
		Some(index):
			Some(into_opaque ModuleId(index))
		None:
			None


---
Appends a module row and indexes it by its canonical path. Its ranges are
closed by `close_module_row` once its parse ends.
---
pure func append_module(builder: DiscoveryBuilder, row: ModuleRow) -> DiscoveryBuilder:
	index: Int = builder.modules.length()
	path_index: Int = row.canonical_path.path_id_index()
	{ builder |
		modules = builder.modules.append(row),
		module_ids_by_path = builder.module_ids_by_path.set(path_index, index)
	}


---
Replaces a module's row; a module is appended with empty ranges and its row
replaced with the closed ranges at the end of its parse.
---
pure func replace_module_row(
	builder: DiscoveryBuilder,
	module: ModuleId,
	row: ModuleRow,
) -> DiscoveryBuilder:
	index: Int = module.module_id_index()
	{ builder | modules = builder.modules.set(index, row) }


---
The row of the module about to be loaded, before any of its rows exist: each
range starts at the end of its table now and is empty. Append it with
`append_module` before lexing, and close it with `close_module_row` once the
parse ends.
---
pure func module_row_start(
	builder: DiscoveryBuilder,
	canonical_path: PathId,
	origin: ModuleOriginKind,
	reach: ModuleReach,
) -> ModuleRow:
	{
		source = builder.next_source_id(),
		canonical_path = canonical_path,
		origin = origin,
		reach = reach,
		definitions = {
			first = builder.definitions.length(),
			count = 0
		},
		imports = {
			first = builder.imports.length(),
			count = 0
		},
		nodes = {
			first = builder.nodes.length(),
			count = 0
		},
		diagnostics = {
			first = builder.diagnostics.length(),
			count = 0
		}
	}


---
Replaces `module`'s row with `opening` (the row `module_row_start` returned)
with every range closed over the rows appended since.
---
pure func close_module_row(
	builder: DiscoveryBuilder,
	module: ModuleId,
	opening: ModuleRow,
) -> DiscoveryBuilder:
	closed: ModuleRow = { opening |
		definitions = {
			first = opening.definitions.first,
			count = builder.definitions.length() - opening.definitions.first
		},
		imports = {
			first = opening.imports.first,
			count = builder.imports.length() - opening.imports.first
		},
		nodes = {
			first = opening.nodes.first,
			count = builder.nodes.length() - opening.nodes.first
		},
		diagnostics = {
			first = opening.diagnostics.first,
			count = builder.diagnostics.length() - opening.diagnostics.first
		}
	}
	builder.replace_module_row(module, closed)


pure func append_module_package(
	builder: DiscoveryBuilder,
	row: ModulePackageRow,
) -> DiscoveryBuilder:
	{ builder | module_packages = builder.module_packages.append(row) }


