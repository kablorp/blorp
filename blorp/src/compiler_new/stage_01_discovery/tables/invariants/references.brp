		found,
		table,
		row,
		ForeignBlockTable,
		id.foreign_block_id_index(),
		builder.foreign_blocks.length(),
	)


private pure func check_import_range(
	found: List[TableInvariantViolation],
	builder: DiscoveryBuilder,
	table: DiscoveryTable,
	row: Int,
	range: RowRange,
) -> List[TableInvariantViolation]:
	check_range(found, table, row, ImportTable, range, builder.imports.length())


private pure func check_parameter_range(
	found: List[TableInvariantViolation],
	builder: DiscoveryBuilder,
	table: DiscoveryTable,
	row: Int,
	range: RowRange,
) -> List[TableInvariantViolation]:
	check_range(found, table, row, ParameterTable, range, builder.parameters.length())


private pure func check_binder_name_range(
	found: List[TableInvariantViolation],
	builder: DiscoveryBuilder,
	table: DiscoveryTable,
	row: Int,
	range: RowRange,
) -> List[TableInvariantViolation]:
	check_range(found, table, row, BinderNameTable, range, builder.binder_names.length())


pure func check_declaration_rows(builder: DiscoveryBuilder) -> List[TableInvariantViolation]:
	var found: List[TableInvariantViolation] = []
	var row: Int = 0

	for block in builder.import_blocks:
		found = found.check_module_reference(builder, ImportBlockTable, row, block.module)
		found = found.check_import_range(builder, ImportBlockTable, row, block.imports)
		row += 1

	row = 0

	for definition in builder.definitions:
		found = found.check_module_reference(builder, DefinitionTable, row, definition.module)
		found = found.check_name_reference(builder, DefinitionTable, row, definition.name)
		row += 1

	row = 0

	for member in builder.members:
		found = found.check_definition_reference(builder, MemberTable, row, member.definition)
		found = found.check_definition_reference(builder, MemberTable, row, member.owner)
		row += 1

	row = 0

	for documentation in builder.documentation:
		found = found.check_definition_reference(
			builder,
			DocumentationTable,
			row,
			documentation.definition,
		)
		found = found.check_literal_reference(builder, DocumentationTable, row, documentation.text)
		row += 1

	row = 0

	for documentation in builder.module_documentation:
		found = found.check_module_reference(
			builder,
			ModuleDocumentationTable,
			row,
			documentation.module,
		)
		found = found.check_literal_reference(
			builder,
			ModuleDocumentationTable,
			row,
			documentation.text,
		)
		row += 1

	row = 0

	for annotation in builder.annotations:
		found = found.check_definition_reference(
			builder,
			AnnotationTable,
			row,
			annotation.definition,
		)
		row += 1

	row = 0

	for parameter in builder.type_parameters:
		found = found.check_definition_reference(builder, TypeParameterTable, row, parameter.owner)
		found = found.check_name_reference(builder, TypeParameterTable, row, parameter.name)
		row += 1

	row = 0

	for bound in builder.bounds:
		found = found.check_definition_reference(builder, BoundTable, row, bound.owner)
		found = found.check_name_reference(builder, BoundTable, row, bound.trait_name)
		row += 1

	row = 0

	for qualifier in builder.bound_qualifiers:
		found = found.check_bound_reference(builder, BoundQualifierTable, row, qualifier.bound)
		found = found.check_name_reference(builder, BoundQualifierTable, row, qualifier.qualifier)
		row += 1

	row = 0

	for supertrait in builder.supertraits:
		found = found.check_definition_reference(
			builder,
			SupertraitTable,
			row,
			supertrait.trait_definition,
		)
		found = found.check_name_reference(builder, SupertraitTable, row, supertrait.name)
		row += 1

	row = 0

	for qualifier in builder.supertrait_qualifiers:
		found = found.check_supertrait_reference(
			builder,
			SupertraitQualifierTable,
			row,
			qualifier.supertrait,
		)
		found = found.check_name_reference(
			builder,
			SupertraitQualifierTable,
			row,
			qualifier.qualifier,
		)
		row += 1

	row = 0
	name_count: Int = builder.name_spellings.length()

	for impl in builder.impls:
		found = found.check_definition_reference(builder, ImplTable, row, impl.definition)
		found = check_reference(
			found,
			ImplTable,
			row,
			NameTable,
			impl.trait_name.name_id_index(),
			name_count,
		)
		row += 1

	row = 0

	for signature in builder.signatures:
		found = found.check_definition_reference(builder, SignatureTable, row, signature.definition)
		found = found.check_parameter_range(builder, SignatureTable, row, signature.parameters)
		row += 1

	row = 0

	for parameter in builder.parameters:
		found = found.check_definition_reference(builder, ParameterTable, row, parameter.owner)
		found = found.check_binder_name_range(builder, ParameterTable, row, parameter.binder_names)
		row += 1

	row = 0

	for binder_name in builder.binder_names:
		found = found.check_name_reference(builder, BinderNameTable, row, binder_name.name)
		row += 1

	row = 0

	for parameter_type in builder.parameter_types:
		found = found.check_parameter_reference(
			builder,
			ParameterTypeTable,
			row,
			parameter_type.parameter,
		)
		found = found.check_node_reference(
			builder,
			ParameterTypeTable,
			row,
			parameter_type.type_root,
		)
		row += 1

	row = 0

	for definition_type in builder.definition_types:
		found = found.check_definition_reference(
			builder,
			DefinitionTypeTable,
			row,
			definition_type.definition,
		)
		found = found.check_node_reference(
			builder,
			DefinitionTypeTable,
			row,
			definition_type.type_root,
		)
		row += 1

	row = 0

	for payload in builder.variant_payloads:
		found = found.check_definition_reference(builder, VariantPayloadTable, row, payload.variant)
		found = found.check_node_reference(builder, VariantPayloadTable, row, payload.type_root)
		row += 1

	row = 0

	for constraint in builder.dimension_constraints:
		found = found.check_definition_reference(
			builder,
			DimensionConstraintTable,
			row,
			constraint.owner,
		)
		found = found.check_node_reference(builder, DimensionConstraintTable, row, constraint.left)
		found = found.check_node_reference(builder, DimensionConstraintTable, row, constraint.right)
		row += 1

	row = 0

	for block in builder.foreign_blocks:
		found = found.check_module_reference(builder, ForeignBlockTable, row, block.module)
		row += 1

	row = 0

	for argument in builder.foreign_arguments:
		found = found.check_name_reference(builder, ForeignArgumentTable, row, argument.name)
		found = found.check_literal_reference(builder, ForeignArgumentTable, row, argument.value)
		row += 1

	row = 0

	for binding in builder.foreign_bindings:
		found = found.check_definition_reference(
			builder,
			ForeignBindingTable,
			row,
			binding.definition,
		)
		found = found.check_foreign_block_reference(
			builder,
			ForeignBindingTable,
			row,
			binding.block,
		)
		row += 1

	row = 0

	for c_name in builder.foreign_c_names:
		found = found.check_definition_reference(builder, ForeignCNameTable, row, c_name.definition)
		found = found.check_literal_reference(builder, ForeignCNameTable, row, c_name.c_name)
		row += 1

	row = 0

	for cleanup in builder.resource_cleanups:
		found = found.check_definition_reference(
			builder,
			ResourceCleanupTable,
			row,
			cleanup.definition,
		)
		found = found.check_literal_reference(
			builder,
			ResourceCleanupTable,
			row,
			cleanup.builtin_name,
		)
		row += 1

	found


---
Every body names an existing definition, and its root is a node inside the
node block of that definition's module.
---
pure func check_body_rows(builder: DiscoveryBuilder) -> List[TableInvariantViolation]:
	var found: List[TableInvariantViolation] = []
	definition_count: Int = builder.definitions.length()
	var row: Int = 0

	for body in builder.bodies:
		definition_index: Int = body.definition.definition_id_index()
		root_index: Int = body.root.node_id_index()

		match builder.definitions.get(definition_index):
			Some(definition):
				match builder.modules.get(definition.module.module_id_index()):
					Some(module):
						if not index_in(root_index - module.nodes.first, module.nodes.count):
							found = found.append(
								violation(
									BodyRootOutsideModule,
									BodyTable,
									row,
									NodeTable,
									root_index,
								),
							)
					None:
						found = found.append(
							violation(
								DanglingReference,
								BodyTable,
								row,
								ModuleTable,
								definition.module.module_id_index(),
							),
						)
			None:
				found = found.append(
					violation(
						DanglingReference,
						BodyTable,
						row,
						DefinitionTable,
						definition_index,
					),
				)

		row += 1

	found


---
A lexer or parser diagnostic names only rows that exist: the literal or name
its variant carries. Every variant is listed, so a variant that gains an id
must be given its check here.
---
private pure func check_syntax_diagnostic_references(
	builder: DiscoveryBuilder,
	found: List[TableInvariantViolation],
	table: DiscoveryTable,
	row: Int,
	diagnostic: SyntaxDiagnostic,
) -> List[TableInvariantViolation]:
	match diagnostic:
		Plain(_):
			found
		ExpectedToken(_):
			found
		UnknownEscape(_):
			found
		UnexpectedByte(_):
			found
		IntegerLiteralOverflow(_):
			found
		FloatLiteralOverflow(_):
			found
		ReservedKeywordAsName(name):
			found.check_name_reference(builder, table, row, name)
		UnknownAnnotation(name):
			found.check_name_reference(builder, table, row, name)
		ConcurrentDuplicateParameter(name):
			found.check_name_reference(builder, table, row, name)
		ConcurrentUnknownParameter(name):
			found.check_name_reference(builder, table, row, name)
		ConcurrentForUnknownParameter(name):
			found.check_name_reference(builder, table, row, name)
		DuplicateField(first):
			found.check_definition_reference(builder, table, row, first)
		DuplicateFieldGiven(_):
			found


---
A module graph diagnostic names only rows that exist: the import and the
path its variant carries. Every variant is listed.
---
private pure func check_resolution_diagnostic_references(
	builder: DiscoveryBuilder,
	found: List[TableInvariantViolation],
	table: DiscoveryTable,
	row: Int,
	diagnostic: ResolutionDiagnostic,
) -> List[TableInvariantViolation]:
	match diagnostic:
		UnresolvedImport(import_id):
			builder.check_diagnostic_import(found, table, row, import_id)
		UnverifiableSpelling(import_id):
			builder.check_diagnostic_import(found, table, row, import_id)
		UnreadableSource(import_id):
			builder.check_diagnostic_import(found, table, row, import_id)
		ImportCaseMismatch(import_id, stored_path):
			with_import: List[TableInvariantViolation] = builder.check_diagnostic_import(
				found,
				table,
				row,
				import_id,
			)
			builder.check_diagnostic_path(with_import, table, row, stored_path)
		ImportSourceTooLarge(_):
			found
		ImportTooManySources:
			found


---
A root diagnostic names only rows that exist: the stored path its variant
carries. Every variant is listed.
---
private pure func check_root_diagnostic_references(
	builder: DiscoveryBuilder,
	found: List[TableInvariantViolation],
	table: DiscoveryTable,
	row: Int,
	diagnostic: RootDiagnostic,
) -> List[TableInvariantViolation]:
	match diagnostic:
		RootCaseMismatch(stored_path):
			builder.check_diagnostic_path(found, table, row, stored_path)
		UnresolvedRoot:
			found
		UnverifiableRootSpelling:
			found
		UnreadableRootSource:
			found
		RootSourceTooLarge(_):
			found
		RootTooManySources:
			found


---
An implicit module diagnostic names no row today. Every variant is listed, so
one that gains an id must be given its check here.
---
private pure func check_implicit_diagnostic_references(
	found: List[TableInvariantViolation],
	diagnostic: ImplicitDiagnostic,
) -> List[TableInvariantViolation]:
	match diagnostic:
		MissingImplicitModule:
			found
		UnverifiableImplicitSpelling:
			found
		UnreadableImplicitSource:
			found
		ImplicitSourceTooLarge(_):
			found
		ImplicitTooManySources:
			found


private pure func check_diagnostic_path(
	builder: DiscoveryBuilder,
	found: List[TableInvariantViolation],
	table: DiscoveryTable,
	row: Int,
	path: PathId,
) -> List[TableInvariantViolation]:
	check_reference(found, table, row, PathTable, path.path_id_index(), builder.paths.length())


private pure func check_diagnostic_import(
	builder: DiscoveryBuilder,
	found: List[TableInvariantViolation],
	table: DiscoveryTable,
	row: Int,
	import_id: ImportId,
) -> List[TableInvariantViolation]:
	check_reference(
		found,
		table,
		row,
		ImportTable,
		import_id.import_id_index(),
		builder.imports.length(),
	)


pure func check_diagnostic_rows(builder: DiscoveryBuilder) -> List[TableInvariantViolation]:
	var found: List[TableInvariantViolation] = []
	var row: Int = 0

	for diagnostic in builder.diagnostics:
		found = builder.check_syntax_diagnostic_references(
			found,
			DiagnosticTable,
			row,
			diagnostic.diagnostic,
		)
		row += 1

	row = 0

	for diagnostic in builder.resolution_diagnostics:
		found = builder.check_resolution_diagnostic_references(
			found,
			ResolutionDiagnosticTable,
			row,
			diagnostic.diagnostic,
		)
		row += 1

	found
