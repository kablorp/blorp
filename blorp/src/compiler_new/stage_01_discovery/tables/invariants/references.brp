-- Invariants of the rows that name other rows: module, source, root, import,
-- declaration, body and diagnostic rows, each stored id naming a row of the
-- right table and each range lying inside its child table.
import:
	../builder: DiscoveryBuilder
	../diagnostic_code:
		ImplicitDiagnostic(
			ImplicitSourceTooLarge, ImplicitTooManySources, MissingImplicitModule,
			UnreadableImplicitSource, UnverifiableImplicitSpelling,
		),
		ResolutionDiagnostic(
			ImportCaseMismatch, ImportSourceTooLarge, ImportTooManySources, UnreadableSource,
			UnresolvedImport, UnverifiableSpelling,
		),
		RootDiagnostic(
			RootCaseMismatch, RootSourceTooLarge, RootTooManySources, UnreadableRootSource,
			UnresolvedRoot, UnverifiableRootSpelling,
		),
		SyntaxDiagnostic(
			ConcurrentDuplicateParameter, ConcurrentForUnknownParameter, ConcurrentUnknownParameter,
			DuplicateField, ExpectedToken, FloatLiteralOverflow, IntegerLiteralOverflow, Plain, ReservedKeywordAsName,
			UnexpectedByte, UnknownAnnotation, UnknownEscape,
		),
	../ids:
		BoundId,
		DefinitionId,
		ForeignBlockId,
		ImportId,
		LiteralId,
		ModuleId,
		NameId,
		NodeId,
		ParameterId,
		PathId,
		SupertraitId,
		bound_id_index,
		definition_id_index,
		foreign_block_id_index,
		implicit_request_id_index,
		import_id_index,
		import_item_id_index,
		literal_id_index,
		module_id_index,
		name_id_index,
		node_id_index,
		package_id_index,
		parameter_id_index,
		path_id_index,
		root_id_index,
		source_id_index,
		supertrait_id_index,
	../rows:
		ImplicitOutcome(ImplicitLoaded, ImplicitRejected),
		RootOutcome(RootLoaded, RootRejected),
		RowRange,
	violation:
		DiscoveryTable(
			AnnotationTable, BinderNameTable, BodyTable, BoundQualifierTable, BoundTable,
			DefinitionTable, DefinitionTypeTable, DiagnosticTable, DimensionConstraintTable,
			DocumentationTable, ForeignArgumentTable, ForeignBindingTable, ForeignBlockTable,
			ForeignCNameTable, ImplTable, ImplicitRequestTable, ImportAliasTable, ImportBlockTable,
			ImportItemAliasTable, ImportItemTable, ImportItemVariantTable, ImportPathPartTable,
			ImportTable, ImportTargetTable, LineStartTable, LiteralTable, MemberTable,
			ModuleDocumentationTable, ModulePackageTable, ModuleTable, NameTable, NodeTable,
			PackageTable, ParameterTable, ParameterTypeTable, PathTable, ResolutionDiagnosticTable,
			ResourceCleanupTable, RootTable, SignatureTable, SourceTable, SourceTextTable,
			SupertraitQualifierTable, SupertraitTable, TypeParameterTable, VariantPayloadTable,
		),
		TableInvariantKind(
			BodyRootOutsideModule, DanglingReference, InternIndexMismatch, ParallelTableMismatch,
		),
		TableInvariantViolation,
		check_range,
		check_reference,
		index_in,
		violation,


pure func check_source_rows(builder: DiscoveryBuilder) -> List[TableInvariantViolation]:
	var found: List[TableInvariantViolation] = []
	source_count: Int = builder.sources.length()
	path_count: Int = builder.paths.length()
	line_start_count: Int = builder.line_starts.length()

	if builder.source_texts.length() != source_count:
		found = found.append(
			violation(
				ParallelTableMismatch,
				SourceTable,
				source_count,
				SourceTextTable,
				builder.source_texts.length(),
			),
		)

	var row: Int = 0

	for source in builder.sources:
		found = check_reference(
			found,
			SourceTable,
			row,
			PathTable,
			source.path.path_id_index(),
			path_count,
		)
		found = check_range(
			found,
			SourceTable,
			row,
			LineStartTable,
			source.line_starts,
			line_start_count,
		)
		row += 1

	found


pure func check_module_rows(builder: DiscoveryBuilder) -> List[TableInvariantViolation]:
	var found: List[TableInvariantViolation] = []
	module_count: Int = builder.modules.length()
	source_count: Int = builder.sources.length()
	var row: Int = 0

	for module in builder.modules:
		found = check_reference(
			found,
			ModuleTable,
			row,
			SourceTable,
			module.source.source_id_index(),
			source_count,
		)

		-- A module is indexed by its source's path; a module over no source is
		-- already reported by the reference check above.
		match builder.sources.get(module.source.source_id_index()):
			Some(source):
				match builder.module_ids_by_path.get(source.path.path_id_index()):
					Some(indexed):
						if indexed != row:
							found = found.append(
								violation(
									InternIndexMismatch,
									ModuleTable,
									row,
									ModuleTable,
									indexed,
								),
							)
					None:
						found = found.append(
							violation(
								InternIndexMismatch,
								ModuleTable,
								row,
								ModuleTable,
								row,
							),
						)
			None:
				found = found

		row += 1

	if builder.module_ids_by_path.length() != module_count:
		found = found.append(
			violation(
				InternIndexMismatch,
				ModuleTable,
				module_count,
				ModuleTable,
				builder.module_ids_by_path.length(),
			),
		)

	var package_row: Int = 0
	package_count: Int = builder.packages.length()

	for module_package in builder.module_packages:
		found = check_reference(
			found,
			ModulePackageTable,
			package_row,
			ModuleTable,
			module_package.module.module_id_index(),
			module_count,
		)
		found = check_reference(
			found,
			ModulePackageTable,
			package_row,
			PackageTable,
			module_package.package.package_id_index(),
			package_count,
		)
		package_row += 1

	var package_name_row: Int = 0
	name_count: Int = builder.name_spellings.length()

	for package in builder.packages:
		found = check_reference(
			found,
			PackageTable,
			package_name_row,
			NameTable,
			package.name.name_id_index(),
			name_count,
		)
		package_name_row += 1

	found


pure func check_root_rows(builder: DiscoveryBuilder) -> List[TableInvariantViolation]:
	var found: List[TableInvariantViolation] = []
	path_count: Int = builder.paths.length()
	module_count: Int = builder.modules.length()
	var row: Int = 0

	for root in builder.roots:
		found = check_reference(
			found,
			RootTable,
			row,
			PathTable,
			root.request_path.path_id_index(),
			path_count,
		)

		match root.outcome:
			RootLoaded(target):
				found = check_reference(
					found,
					RootTable,
					row,
					ModuleTable,
					target.module_id_index(),
					module_count,
				)
			RootRejected(diagnostic):
				found = builder.check_root_diagnostic_references(found, RootTable, row, diagnostic)

		row += 1

	found


pure func check_implicit_rows(builder: DiscoveryBuilder) -> List[TableInvariantViolation]:
	var found: List[TableInvariantViolation] = []
	path_count: Int = builder.paths.length()
	module_count: Int = builder.modules.length()
	var row: Int = 0

	for request in builder.implicit_requests:
		found = check_reference(
			found,
			ImplicitRequestTable,
			row,
			PathTable,
			request.request_path.path_id_index(),
			path_count,
		)

		match request.outcome:
			ImplicitLoaded(target):
				found = check_reference(
					found,
					ImplicitRequestTable,
					row,
					ModuleTable,
					target.module_id_index(),
					module_count,
				)
			ImplicitRejected(diagnostic):
				found = check_implicit_diagnostic_references(found, diagnostic)

		row += 1

	found


pure func check_import_rows(builder: DiscoveryBuilder) -> List[TableInvariantViolation]:
	var found: List[TableInvariantViolation] = []
	import_count: Int = builder.imports.length()
	item_count: Int = builder.import_items.length()
	module_count: Int = builder.modules.length()
	name_count: Int = builder.name_spellings.length()
	var row: Int = 0

	for import_row in builder.imports:
		found = check_reference(
			found,
			ImportTable,
			row,
			ModuleTable,
			import_row.importer.module_id_index(),
			module_count,
		)
		row += 1

	var item_row: Int = 0

	for item in builder.import_items:
		found = check_reference(
			found,
			ImportItemTable,
			item_row,
			ImportTable,
			item.owner_import.import_id_index(),
			import_count,
		)
		found = check_reference(
			found,
			ImportItemTable,
			item_row,
			NameTable,
			item.name.name_id_index(),
			name_count,
		)
		item_row += 1

	var variant_row: Int = 0

	for variant in builder.import_item_variants:
		found = check_reference(
			found,
			ImportItemVariantTable,
			variant_row,
			ImportItemTable,
			variant.item.import_item_id_index(),
			item_count,
		)
		found = check_reference(
			found,
			ImportItemVariantTable,
			variant_row,
			NameTable,
			variant.name.name_id_index(),
			name_count,
		)
		variant_row += 1

	var part_row: Int = 0

	for part in builder.import_path_parts:
		found = check_reference(
			found,
			ImportPathPartTable,
			part_row,
			NameTable,
			part.name_id_index(),
			name_count,
		)
		part_row += 1

	var target_row: Int = 0

	for target in builder.import_targets:
		found = check_reference(
			found,
			ImportTargetTable,
			target_row,
			ImportTable,
			target.owner_import.import_id_index(),
			import_count,
		)
		found = check_reference(
			found,
			ImportTargetTable,
			target_row,
			ModuleTable,
			target.target.module_id_index(),
			module_count,
		)
		target_row += 1

	var alias_row: Int = 0

	for alias_entry in builder.import_aliases:
		found = check_reference(
			found,
			ImportAliasTable,
			alias_row,
			ImportTable,
			alias_entry.owner_import.import_id_index(),
			import_count,
		)
		found = check_reference(
			found,
			ImportAliasTable,
			alias_row,
			NameTable,
			alias_entry.alias_name.name_id_index(),
			name_count,
		)
		alias_row += 1

	var item_alias_row: Int = 0

	for item_alias in builder.import_item_aliases:
		found = check_reference(
			found,
			ImportItemAliasTable,
			item_alias_row,
			ImportItemTable,
			item_alias.item.import_item_id_index(),
			item_count,
		)
		found = check_reference(
			found,
			ImportItemAliasTable,
			item_alias_row,
			NameTable,
			item_alias.alias_name.name_id_index(),
			name_count,
		)
		item_alias_row += 1

	found


---
Reference checks of one declaration row to a row of another table. Each reads
the target table's length from `builder`, so a check is one line at its row.
---
private pure func check_module_reference(
	found: List[TableInvariantViolation],
	builder: DiscoveryBuilder,
	table: DiscoveryTable,
	row: Int,
	id: ModuleId,
) -> List[TableInvariantViolation]:
	check_reference(found, table, row, ModuleTable, id.module_id_index(), builder.modules.length())


private pure func check_definition_reference(
	found: List[TableInvariantViolation],
	builder: DiscoveryBuilder,
	table: DiscoveryTable,
	row: Int,
	id: DefinitionId,
) -> List[TableInvariantViolation]:
	check_reference(
		found,
		table,
		row,
		DefinitionTable,
		id.definition_id_index(),
		builder.definitions.length(),
	)


private pure func check_name_reference(
	found: List[TableInvariantViolation],
	builder: DiscoveryBuilder,
	table: DiscoveryTable,
	row: Int,
	id: NameId,
) -> List[TableInvariantViolation]:
	check_reference(
		found,
		table,
		row,
		NameTable,
		id.name_id_index(),
		builder.name_spellings.length(),
	)


private pure func check_literal_reference(
	found: List[TableInvariantViolation],
	builder: DiscoveryBuilder,
	table: DiscoveryTable,
	row: Int,
	id: LiteralId,
) -> List[TableInvariantViolation]:
	check_reference(
		found,
		table,
		row,
		LiteralTable,
		id.literal_id_index(),
		builder.literals.length(),
	)


private pure func check_node_reference(
	found: List[TableInvariantViolation],
	builder: DiscoveryBuilder,
	table: DiscoveryTable,
	row: Int,
	id: NodeId,
) -> List[TableInvariantViolation]:
	check_reference(found, table, row, NodeTable, id.node_id_index(), builder.nodes.length())


private pure func check_parameter_reference(
	found: List[TableInvariantViolation],
	builder: DiscoveryBuilder,
	table: DiscoveryTable,
	row: Int,
	id: ParameterId,
) -> List[TableInvariantViolation]:
	check_reference(
		found,
		table,
		row,
		ParameterTable,
		id.parameter_id_index(),
		builder.parameters.length(),
	)


private pure func check_bound_reference(
	found: List[TableInvariantViolation],
	builder: DiscoveryBuilder,
	table: DiscoveryTable,
	row: Int,
	id: BoundId,
) -> List[TableInvariantViolation]:
	check_reference(found, table, row, BoundTable, id.bound_id_index(), builder.bounds.length())


private pure func check_supertrait_reference(
	found: List[TableInvariantViolation],
	builder: DiscoveryBuilder,
	table: DiscoveryTable,
	row: Int,
	id: SupertraitId,
) -> List[TableInvariantViolation]:
