	ResourceCleanupTable
	BodyTable
	NodeTable
	NodeChildTable
	NodeNameSpanTable
	ElseKeywordTable
	DimensionNameTable
	LiteralTable
	DiagnosticTable
	ResolutionDiagnosticTable


