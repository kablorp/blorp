-- What a table invariant violation is: the tables and kinds of violation, the
-- `TableInvariantViolation` row, and the two primitive checks (a stored id names
-- a row; a range lies inside its child table) every family of checks builds on.
-- Separate from `invariants` so the families can import it without importing
-- the module that runs them.
import:
	../rows: RowRange


---
Every frozen discovery table, for naming where a violation or a lookup that
cannot miss was found.
---
enum DiscoveryTable:
	NameTable
	PathTable
	SourceTextTable
	SourceTable
	LineStartTable
	PackageTable
	ModuleTable
	ModulePackageTable
	RootTable
	ImplicitRequestTable
	ImportTable
	ImportPathPartTable
	ImportItemTable
	ImportItemVariantTable
	ImportTargetTable
	ImportAliasTable
	ImportItemAliasTable
	ImportBlockTable
	DefinitionTable
	MemberTable
	DocumentationTable
	ModuleDocumentationTable
	AnnotationTable
	TypeParameterTable
	BoundTable
	BoundQualifierTable
	SupertraitTable
	SupertraitQualifierTable
	ImplTable
	SignatureTable
	ParameterTable
	BinderNameTable
	ParameterTypeTable
	DefinitionTypeTable
	VariantPayloadTable
	DimensionConstraintTable
	ForeignBlockTable
