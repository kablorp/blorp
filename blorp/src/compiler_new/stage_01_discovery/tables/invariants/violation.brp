---
What a violation breaks. The meaning of `TableInvariantViolation.value` and
`related_table` is given per kind.

- `DanglingReference`: A row stores an id with no row in `related_table`; `value` is the id's index.
- `RangeOutOfBounds`: A row's range runs outside `related_table`; `value` is the range's end.
- `ModuleRangesOverlap`: A module's block of `related_table` starts before the previous module's block ends; `value` is the previous module's index.
- `NodeChildNotBeforeParent`: A node's child was not appended before it; `value` is the child's index.
- `BodyRootOutsideModule`: A body's root node lies outside its definition's module's node block; `value` is the root's index.
- `SeededNameMoved`: The name at a pinned id is not the seeded spelling; the row is the id.
- `InternIndexMismatch`: An intern index disagrees with its table: the dictionary maps a row's text to another row, or has an entry with no row. `value` is the index the dictionary holds.
- `QualifierOutsideReference`: A bound's or supertrait's module qualifier span does not lie inside the span of the bound or supertrait it qualifies, which covers the whole written reference; `value` is the qualified row's index in `related_table`.
- `SpanOutsideSources`: A span names no source; `value` is the span's source index.
- `DuplicateSideRow`: A side table holds more than one row for an owner that may have at most one; the row is the owner's index in `related_table` and `value` the row count.
- `RootOutcomeMismatch`: A root has not exactly one of a target and a root diagnostic; `value` is how many it has.
- `ImplicitOutcomeMismatch`: An implicit module request has not exactly one of a target and an implicit diagnostic; `value` is how many it has.
- `SignatureCountMismatch`: A function-like definition has not exactly one signature row, or another definition has one; the row is the definition and `value` its signature count.
- `SideTableUnsorted`: A side table read by owner is not sorted by strictly increasing owner; `value` is the row's owner.
- `SpanPastSourceEnd`: A span ends past its source's text; `value` is the span's end.
- `ParallelTableMismatch`: Two parallel tables differ in length; `value` is `related_table`'s length.
- `PayloadOutOfRange`: A node's payload is outside what its kind allows: a codepoint that is no Unicode scalar value, or a payload on a kind that has none; `value` is the payload.
- `UnreferencedNode`: A node is neither any node's child nor a root a row names (a body, a parameter or definition type, a variant payload, a dimension constraint side); the row is the node.
- `NodeReferencedTwice`: A node is a child or root more than once; `value` is how many times.
- `ArgumentCountMismatch`: A diagnostic row stores another number of arguments than its code documents (`diagnostic_argument_kinds`); the table is the row's, `value` its argument count.
- `ArgumentOutOfRange`: A diagnostic argument is not what its code documents: a construct that decodes to none, or an id with no row in its table; `value` is the argument.
- `NameSpanOutsideItsSpan`: A row's name span does not lie inside the span of the row or node it names a part of; `value` is the name span's start.
- `NameSpanOnWrongNodeKind`: A `NodeNameSpanRow` names a node whose kind has no name span row (`needs_name_span_row`); `value` is the node's index.
- `DimensionSigilNameMissing`: A dimension name has no `DimensionNameRow`; `value` is the plain name's index.
- `SigilSpellingMismatch`: A dimension name row's sigil name is not `#` followed by the plain name's spelling; `value` is the sigil name's index.
- `NodeNameSpanMissing`: A node of a kind whose name is narrower than the node (`needs_name_span_row`) has no `NodeNameSpanRow`; the row is the node.
- `ElseKeywordMismatch`: An `ElseKeywordRow` does not belong to an `IfNode` that has an else branch (a third child), an `IfNode` with an else branch has none, or the keyword lies outside its node; the row is the keyword row or, for a missing one, the node, and `value` is the node's index.
- `ConcurrencyCountMismatch`: A `ConcurrencyCountRow` does not belong to a concurrency parameter node, or its count is not positive; the row is the count row and `value` the node's index.
- `NodeArityMismatch`: A node has a number of children its kind does not allow (`node_schema`); `value` is the child count.
- `LocalFunctionNodeMismatch`: A `LocalFunctionNode` names a definition that is not a local function; `value` is the definition's index.
---
enum TableInvariantKind:
	DanglingReference
	RangeOutOfBounds
	ModuleRangesOverlap
	NodeChildNotBeforeParent
	BodyRootOutsideModule
	SeededNameMoved
	InternIndexMismatch
	ParallelTableMismatch
	SpanOutsideSources
	QualifierOutsideReference
	SpanPastSourceEnd
	DuplicateSideRow
	RootOutcomeMismatch
	ImplicitOutcomeMismatch
	SignatureCountMismatch
	SideTableUnsorted
	LocalFunctionNodeMismatch
	UnreferencedNode
	NodeReferencedTwice
	PayloadOutOfRange
	ArgumentCountMismatch
	ArgumentOutOfRange
	NameSpanOutsideItsSpan
	NameSpanOnWrongNodeKind
	DimensionSigilNameMissing
	SigilSpellingMismatch
	NodeNameSpanMissing
	ElseKeywordMismatch
	ConcurrencyCountMismatch
	NodeArityMismatch


---
The name of a violation's kind, for a message that reports one.
---
pure func table_invariant_kind_name(kind: TableInvariantKind) -> String:
	match kind:
		DanglingReference:
			"DanglingReference"
		RangeOutOfBounds:
			"RangeOutOfBounds"
		ModuleRangesOverlap:
			"ModuleRangesOverlap"
		NodeChildNotBeforeParent:
			"NodeChildNotBeforeParent"
		BodyRootOutsideModule:
			"BodyRootOutsideModule"
		SeededNameMoved:
			"SeededNameMoved"
		InternIndexMismatch:
			"InternIndexMismatch"
		ParallelTableMismatch:
			"ParallelTableMismatch"
		SpanOutsideSources:
			"SpanOutsideSources"
		QualifierOutsideReference:
			"QualifierOutsideReference"
		SpanPastSourceEnd:
			"SpanPastSourceEnd"
		DuplicateSideRow:
			"DuplicateSideRow"
		RootOutcomeMismatch:
			"RootOutcomeMismatch"
		ImplicitOutcomeMismatch:
			"ImplicitOutcomeMismatch"
		SignatureCountMismatch:
			"SignatureCountMismatch"
		SideTableUnsorted:
			"SideTableUnsorted"
		LocalFunctionNodeMismatch:
			"LocalFunctionNodeMismatch"
		UnreferencedNode:
			"UnreferencedNode"
		NodeReferencedTwice:
			"NodeReferencedTwice"
		PayloadOutOfRange:
			"PayloadOutOfRange"
		ArgumentCountMismatch:
			"ArgumentCountMismatch"
		ArgumentOutOfRange:
			"ArgumentOutOfRange"
		NameSpanOutsideItsSpan:
			"NameSpanOutsideItsSpan"
		NameSpanOnWrongNodeKind:
			"NameSpanOnWrongNodeKind"
		DimensionSigilNameMissing:
			"DimensionSigilNameMissing"
		SigilSpellingMismatch:
			"SigilSpellingMismatch"
		NodeNameSpanMissing:
			"NodeNameSpanMissing"
		ElseKeywordMismatch:
			"ElseKeywordMismatch"
		ConcurrencyCountMismatch:
			"ConcurrencyCountMismatch"
		NodeArityMismatch:
			"NodeArityMismatch"


struct TableInvariantViolation {
	kind: TableInvariantKind,
	table: DiscoveryTable,
	row: Int,
	related_table: DiscoveryTable,
	value: Int
}


pure func violation(
	kind: TableInvariantKind,
	table: DiscoveryTable,
	row: Int,
	related_table: DiscoveryTable,
	value: Int,
) -> TableInvariantViolation:
	{
		kind = kind,
		table = table,
		row = row,
		related_table = related_table,
		value = value
	}


pure func index_in(index: Int, length: Int) -> Bool:
	index >= 0 and index < length


pure func range_end(range: RowRange) -> Int:
	range.first + range.count


pure func range_in(range: RowRange, length: Int) -> Bool:
	range.first >= 0 and range.count >= 0 and range.range_end() <= length


---
Appends a `DanglingReference` to `found` unless `index` names a row of a
table with `length` rows.
---
pure func check_reference(
	found: List[TableInvariantViolation],
	table: DiscoveryTable,
	row: Int,
	related_table: DiscoveryTable,
	index: Int,
	length: Int,
) -> List[TableInvariantViolation]:
	if index_in(index, length):
		found
	else:
		found.append(violation(DanglingReference, table, row, related_table, index))


pure func check_range(
	found: List[TableInvariantViolation],
	table: DiscoveryTable,
	row: Int,
	related_table: DiscoveryTable,
	range: RowRange,
	length: Int,
) -> List[TableInvariantViolation]:
	if range.range_in(length):
		found
	else:
		found.append(violation(RangeOutOfBounds, table, row, related_table, range.range_end()))
