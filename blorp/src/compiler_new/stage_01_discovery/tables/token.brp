---
One token. `payload` is fixed by `kind` (see `TokenKind`); it is
`NO_TOKEN_PAYLOAD` for kinds without one.
---
fixed record Token {
	kind: TokenKind,
	span: Span,
	payload: Int
}


---
The payload of a token kind that has none.
---
NO_TOKEN_PAYLOAD: Int = 0

---
The keyword kinds in the order their spellings are seeded into the name
table: the keyword spelled by seeded name `FIRST_KEYWORD_NAME_INDEX + i` is
`KEYWORD_KINDS_IN_SEEDED_ORDER[i]`. The lexer recognizes a keyword by the id
its spelling interns to, so a keyword costs no spelling comparison; a test
pins this list against the vocabulary.
---
KEYWORD_KINDS_IN_SEEDED_ORDER: List[TokenKind] = [
	FuncKeyword,
	PureKeyword,
	VarKeyword,
	UnionKeyword,
	RecordKeyword,
	VoidKeyword,
	WhileKeyword,
	ForKeyword,
	InKeyword,
	IfKeyword,
	ElseKeyword,
	AndKeyword,
	OrKeyword,
	NotKeyword,
	OnKeyword,
	MatchKeyword,
	TrueKeyword,
	FalseKeyword,
	BreakKeyword,
	ContinueKeyword,
	DebugKeyword,
	WithKeyword,
	ResourceKeyword,
	ForeignKeyword,
	PrivateKeyword,
	BuiltinKeyword,
	ConcurrentKeyword,
	ConcurrentlyKeyword,
	DetachKeyword,
	SelectKeyword,
	IntoOpaqueKeyword,
	FromKeyword,
	FromOpaqueKeyword,
	AfterKeyword,
	SealedKeyword,
	OpaqueKeyword,
	TryKeyword,
	ImportKeyword,
	AsKeyword,
	TraitKeyword,
	ImplementsKeyword,
	SelfKeyword,
	TypeKeyword,
	AliasKeyword,
	WhereKeyword,
]

---
The name index of the first keyword spelling in the seeded vocabulary.
---
FIRST_KEYWORD_NAME_INDEX: Int = 1


---
The source spelling of a keyword or symbol kind, or `None` for kinds whose
spelling is their payload's text.
---
pure func fixed_token_spelling(kind: TokenKind) -> Option[String]:
