-- Tokens: the lexer's transient output for one module.
--
-- Token kinds are flat: every keyword and every symbol is its own kind, so no
-- token carries an ordinal that a reader must decode. Only identifiers,
-- literals and character literals use `Token.payload`.
import:
	span: Span


---
The kind of a token. Keyword kinds are named `<Word>Keyword` and symbol kinds
`<Name>Symbol`; the remaining kinds document their payload:

- `IdentifierToken`: payload: the `NameId` of the identifier.
- `DimensionNameToken`: payload: the `NameId` of the name written directly after `#` (as in `#N`); the span covers both. A `#` followed by anything else is a `HashSymbol`.
- `IntLiteralToken`: payload: the `LiteralId` of the digits.
- `FloatLiteralToken`: payload: the `LiteralId` of the digits and dot.
- `NormalStringToken`: payload: the `LiteralId` of the text after escapes.
- `RawStringToken`: payload: the `LiteralId` of the text as written.
- `InterpolatedStringToken`: payload: the index of the string's row in the builder's transient `interpolations` table, whose parts are its text pieces and hole byte ranges.
- `PipeStringToken`: payload: the `LiteralId` of the joined lines.
- `RawPipeStringToken`: payload: the `LiteralId` of the joined lines as written.
- `InterpolatedPipeStringToken`: payload: as `InterpolatedStringToken`; its text pieces join the lines.
- `CharLiteralToken`: payload: the character's codepoint.
- `DocStringToken`: payload: the `LiteralId` of the docstring's lines.
- `NewlineToken`: no payload.
- `IndentToken`: no payload.
- `DedentToken`: no payload.
- `EndOfFileToken`: no payload.
---
enum TokenKind:
	FuncKeyword
	PureKeyword
	VarKeyword
	UnionKeyword
	RecordKeyword
	VoidKeyword
	WhileKeyword
	ForKeyword
	InKeyword
	IfKeyword
	ElseKeyword
	AndKeyword
	OrKeyword
	NotKeyword
	OnKeyword
	MatchKeyword
	TrueKeyword
	FalseKeyword
	BreakKeyword
	ContinueKeyword
	DebugKeyword
	StructKeyword
	EnumKeyword
	WithKeyword
	ResourceKeyword
	ForeignKeyword
	PrivateKeyword
	BuiltinKeyword
	ConcurrentKeyword
	ConcurrentlyKeyword
	DetachKeyword
	SelectKeyword
	IntoOpaqueKeyword
	FromKeyword
	FromOpaqueKeyword
	AfterKeyword
	SealedKeyword
	OpaqueKeyword
	TryKeyword
	ImportKeyword
	AsKeyword
	TraitKeyword
	ImplementsKeyword
	SelfKeyword
	TypeKeyword
	AliasKeyword
	WhereKeyword
	LeftParenSymbol
	RightParenSymbol
	LeftBracketSymbol
	RightBracketSymbol
	LeftBraceSymbol
	RightBraceSymbol
	CommaSymbol
	ColonSymbol
	DotSymbol
	DotDotSymbol
	DotDotDotSymbol
	ArrowSymbol
	FatArrowSymbol
	EqualSymbol
	QuestionEqualsSymbol
	PlusSymbol
	MinusSymbol
	StarSymbol
	SlashSymbol
	PlusEqualSymbol
	MinusEqualSymbol
	StarEqualSymbol
	SlashEqualSymbol
	UnderscoreSymbol
	PercentSymbol
	HashSymbol
	AtSymbol
	PipeSymbol
	EqualEqualSymbol
	NotEqualSymbol
	LessSymbol
	LessEqualSymbol
	GreaterSymbol
	GreaterEqualSymbol
	IdentifierToken
	DimensionNameToken
	IntLiteralToken
	FloatLiteralToken
	NormalStringToken
	RawStringToken
	InterpolatedStringToken
	PipeStringToken
	RawPipeStringToken
	InterpolatedPipeStringToken
	CharLiteralToken
	DocStringToken
	NewlineToken
	IndentToken
	DedentToken
	EndOfFileToken


---
One token. `payload` is fixed by `kind` (see `TokenKind`); it is
`NO_TOKEN_PAYLOAD` for kinds without one.
---
fixed record Token {
	kind: TokenKind,
	span: Span,
	payload: Int
}


---
The payload of a token kind that has none.
---
NO_TOKEN_PAYLOAD: Int = 0

---
The keyword kinds in the order their spellings are seeded into the name
table: the keyword spelled by seeded name `FIRST_KEYWORD_NAME_INDEX + i` is
`KEYWORD_KINDS_IN_SEEDED_ORDER[i]`. The lexer recognizes a keyword by the id
its spelling interns to, so a keyword costs no spelling comparison; a test
pins this list against the vocabulary.
---
KEYWORD_KINDS_IN_SEEDED_ORDER: List[TokenKind] = [
	FuncKeyword,
	PureKeyword,
	VarKeyword,
	UnionKeyword,
	RecordKeyword,
	VoidKeyword,
	WhileKeyword,
	ForKeyword,
	InKeyword,
	IfKeyword,
	ElseKeyword,
	AndKeyword,
	OrKeyword,
	NotKeyword,
	OnKeyword,
	MatchKeyword,
	TrueKeyword,
	FalseKeyword,
	BreakKeyword,
	ContinueKeyword,
	DebugKeyword,
	StructKeyword,
	EnumKeyword,
	WithKeyword,
	ResourceKeyword,
	ForeignKeyword,
	PrivateKeyword,
	BuiltinKeyword,
	ConcurrentKeyword,
	ConcurrentlyKeyword,
	DetachKeyword,
	SelectKeyword,
	IntoOpaqueKeyword,
	FromKeyword,
	FromOpaqueKeyword,
	AfterKeyword,
	SealedKeyword,
	OpaqueKeyword,
	TryKeyword,
	ImportKeyword,
	AsKeyword,
	TraitKeyword,
	ImplementsKeyword,
	SelfKeyword,
	TypeKeyword,
	AliasKeyword,
	WhereKeyword,
]

---
The name index of the first keyword spelling in the seeded vocabulary.
---
FIRST_KEYWORD_NAME_INDEX: Int = 1


---
The source spelling of a keyword or symbol kind, or `None` for kinds whose
spelling is their payload's text.
---
pure func fixed_token_spelling(kind: TokenKind) -> Option[String]:
	match kind:
		FuncKeyword:
			Some("func")
		PureKeyword:
			Some("pure")
