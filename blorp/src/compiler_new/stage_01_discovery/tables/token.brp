---
The largest Unicode scalar value.
---
private MAX_UNICODE_CODEPOINT: Int = 1114111

---
The UTF-16 surrogate range, which holds no Unicode scalar values.
---
private FIRST_SURROGATE_CODEPOINT: Int = 55296

private LAST_SURROGATE_CODEPOINT: Int = 57343


---
Whether `codepoint` is a Unicode scalar value: what a character literal's
payload holds.
---
pure func is_unicode_scalar(codepoint: Int) -> Bool:
	(
		codepoint >= 0
		and codepoint <= MAX_UNICODE_CODEPOINT
		and not (codepoint >= FIRST_SURROGATE_CODEPOINT and codepoint <= LAST_SURROGATE_CODEPOINT)
	)
