	LambdaBody
	TuplePatternItems
	ForeignBlockArguments
	TupleDestructuringNames
	TupleLoopVariables
	ConcurrentParameters
	FunctionName
	TraitMethodName
	ForeignFunctionName
	PureFunctionType
	ConcurrentlyHeader
	LambdaFunc
	OpaqueConversionType
	ConstructorPattern
	TuplePattern
	VariantFields
	ResourceCleanupBuiltinName
	GroupedType
	FunctionTypeParameters
	DimensionExpression
	FunctionParameters
	TupleParameterNames
	LambdaParameters
	CallArguments
	OpaqueConversionValue
	BuiltinName
	TupleExpression
	GroupedExpression
	ListPattern
	TypeArguments
	ArrayDimensions
	TypeParameters
	Subscript
	ListLiteral
	StructFields
	RecordFields
	RecordLiteral
	RecordUpdate
	DictLiteral
	VectorLiteral
	ForeignFunctionReturnType
	TopLevelVariable
	BuiltinTypeMarker
	TypeAliasTarget
