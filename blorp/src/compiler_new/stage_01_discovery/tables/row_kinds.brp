-- Payload-free enums stored in discovery rows.
enum PackageKind:
	NativePackage
	SourcePackage


---
Where a module's source came from.
---
enum ModuleOriginKind:
	StdlibModule
	PackageModule
	SourcePackageModule
	UserModule


---
How discovery reached a module: named as a root, loaded as an implicit
module (see `ImplicitModules` in `pipeline`), or only through imports. A
module an implicit request finds already loaded keeps the reach of whatever
loaded it first.
---
enum ModuleReach:
	RootModule
	ImplicitModule
	ImportedModule


---
The syntax of an import request, before any module exists. A bare path
(`heap`, `lib/source`) may resolve to a standard-library module, a source
package or a local file, in the order the source provider defines; a
relative path starts with `./` or `../`; a native package path starts with
`pkg/`. The design sketch called the bare form a "stdlib request"; the syntax
does not decide that, the provider does.
---
enum ImportRequestKind:
	BareModuleRequest
	RelativeModuleRequest
	NativePackageRequest


---
What a definition row declares. Members (fields, variants, trait and impl
methods) link to their owner with a `MemberRow`; a `LocalFunctionDefinition`
is a function declared inside a body, reached from its `LocalFunctionNode`.
---
enum DefinitionKind:
	FunctionDefinition
	RecordDefinition
	StructDefinition
	UnionDefinition
	EnumDefinition
	BuiltinTypeDefinition
	ResourceTypeDefinition
	TypeAliasDefinition
	OpaqueTypeDefinition
	TraitDefinition
	ImplDefinition
	ConstantDefinition
	MutableGlobalDefinition
	ForeignFunctionDefinition
	FieldDefinition
	VariantDefinition
	TraitMethodDefinition
	ImplMethodDefinition
	LocalFunctionDefinition


enum Visibility:
	PublicVisibility
	PrivateVisibility


---
A type parameter's kind: a type (`T`), a dimension (`#N`), or the wildcard
dimension `#_`, whose name column holds `_`.
---
enum TypeParameterKind:
	TypeParameter
	DimensionParameter
	WildcardDimensionParameter


enum Purity:
	PureFunction
	ImpureFunction


---
How a parameter binds its argument: `name` (or `_: Type`), `_`, or a tuple
`(a, b)`.
---
enum ParameterBinder:
	NamedParameterBinder
	WildcardParameterBinder
	TupleParameterBinder


---
The function annotations the language defines (`@tail_recursive`, ...).
---
enum FunctionAnnotation:
	TailRecursiveAnnotation
	NoCopyAnnotation
	DebugOnlyAnnotation
	ResourceResultOrdinaryAnnotation


---
The syntactic form of a node. Expressions, statements, patterns and written
types share the node table; `...TypeNode` kinds appear only where a type was
written and `...PatternNode` kinds only where a pattern was. The shape of every
kind (its payload table, how many children it has and whether it carries a name
span row) is declared once, in `node_schema`, beside a note on what its payload
and children are. A child documented there as "when written" is present only
when the source wrote it; it is recognized by its kind (a type child has a
`...TypeNode` kind), never by position alone.
---
enum NodeKind:
	IdentifierNode
	IntegerLiteralNode
	FloatLiteralNode
	StringLiteralNode
	RawStringLiteralNode
	PipeStringLiteralNode
	RawPipeStringLiteralNode
	InterpolatedStringNode
	InterpolationTextNode
	InterpolationHoleNode
	InterpolatedPipeStringNode
	TrueLiteralNode
	FalseLiteralNode
	CharLiteralNode
	NegateNode
	NotNode
	DetachNode
	AddNode
	SubtractNode
	MultiplyNode
	DivideNode
	ModuloNode
	EqualNode
	NotEqualNode
	LessNode
	LessEqualNode
	GreaterNode
	GreaterEqualNode
	AndNode
	OrNode
	RangeNode
	CallNode
	FieldAccessNode
	SubscriptNode
	ListLiteralNode
	TupleNode
	VectorLiteralNode
	RecordLiteralNode
	RecordUpdateNode
	RecordFieldNode
	DictLiteralNode
	DictEntryNode
	IntoOpaqueNode
	FromOpaqueNode
	BlockNode
	IfNode
	MatchNode
	MatchCaseNode
	SelectNode
	SelectReceiveArmNode
	SelectSealedArmNode
	SelectAfterArmNode
	WithNode
	WithBindingNode
	WithTryBindingNode
	WithErrorMapNode
	DebugBlockNode
	LambdaNode
	PureLambdaNode
	LambdaParameterNode
	LocalFunctionNode
	WhileNode
	ForNode
	LoopBinderNode
	TupleLoopBinderNode
	ConcurrentForNode
	ConcurrentBlockNode
	ConcurrentParameterNode
	BreakNode
	ContinueNode
	VoidNode
	BuiltinNode
	NamedBuiltinNode
	MissingExpressionNode
	VarDeclarationNode
	TypedBindingNode
	AssignmentNode
	QuestionBindNode
	AddAssignNode
	SubtractAssignNode
	MultiplyAssignNode
	DivideAssignNode
	SubscriptAssignmentNode
	TupleDestructureNode
	DestructureBinderNode
	WildcardPatternNode
	NamePatternNode
	IntegerPatternNode
	NegativeIntegerPatternNode
	FloatPatternNode
	NegativeFloatPatternNode
	StringPatternNode
	RawStringPatternNode
	PipeStringPatternNode
	RawPipeStringPatternNode
	CharPatternNode
	TruePatternNode
	FalsePatternNode
	ConstructorPatternNode
	QualifiedConstructorPatternNode
	PatternQualifierNode
	TuplePatternNode
	ListPatternNode
	ListSpreadNameNode
	ListSpreadWildcardNode
	OrPatternNode
	MissingPatternNode
	NamedTypeNode
	QualifiedTypeNode
	TypeQualifierNode
	BoundedTypeNode
	TypeBoundNode
	QualifiedTypeBoundNode
	DimensionNameTypeNode
	VariadicDimensionNameTypeNode
	DimensionWildcardTypeNode
	VariadicDimensionWildcardTypeNode
	DimensionLiteralTypeNode
	DimensionAddTypeNode
	DimensionSubtractTypeNode
	DimensionMultiplyTypeNode
	DimensionDivideTypeNode
	RangeTypeNode
	TupleTypeNode
	FunctionTypeNode
	PureFunctionTypeNode
	ArrayTypeNode
	MissingTypeNode


