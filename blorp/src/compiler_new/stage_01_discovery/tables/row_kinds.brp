---
The construct a diagnostic argument stands for, or `None` for a number no
construct has (`freeze` rejects such a row).
---
pure func parsed_construct_at_argument(argument: Int) -> Option[ParsedConstruct]:
	var found: Option[ParsedConstruct] = None

	for candidate in ALL_PARSED_CONSTRUCTS:
		if parsed_construct_argument(candidate) == argument:
			found = Some(candidate)
			break

	found
