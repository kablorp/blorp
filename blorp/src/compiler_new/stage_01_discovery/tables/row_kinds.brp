---
The table a node's payload indexes.
---
enum NodePayloadReference:
	NamePayload
	LiteralPayload
	CodepointPayload
	DefinitionPayload
	NoPayload


---
How many children a node kind has. The node table is post-order, so the
children are the kind's direct children, in source order. A kind whose child is
"when written" has a variant with the optional count. `AnyNumber` is for lists
whose length the source chooses, and for recovery nodes.
---
enum ChildArity:
	NoChildren
	ZeroOrOne
	ExactlyOne
	ExactlyTwo
	ExactlyThree
	OneOrTwo
	TwoOrThree
	OneToThree
	AtLeastOne
	AtLeastTwo
	AtLeastThree
	AnyNumber


---
Whether a node of a kind carries a `NodeNameSpanRow`: the span of its name
alone, where the name is narrower than the node. The row is present exactly
when the rule asks for it, so a consumer can rely on it.
---
enum NameSpanRule:
	NoNameSpanRow
	NameSpanRowRequired
	NameSpanRowWhenItHasChildren


---
Everything the tables fix about a node kind: the table its payload indexes,
how many children it has, and its name span row. `node_schema` is the only
place that declares them; the freeze checks read it.
---
struct NodeSchema {
	payload: NodePayloadReference,
	arity: ChildArity,
	name_span: NameSpanRule
}


private pure func shape(payload: NodePayloadReference, arity: ChildArity) -> NodeSchema:
	{
		payload = payload,
		arity = arity,
		name_span = NoNameSpanRow
	}


private pure func shape_with_name_span(
	payload: NodePayloadReference,
	arity: ChildArity,
	name_span: NameSpanRule,
) -> NodeSchema:
	{
		payload = payload,
		arity = arity,
		name_span = name_span
	}


---
The one place a node kind's shape is declared. Every kind is listed, with no
`_` arm, so a new kind does not compile until it is described here. Payloads of
kinds that have none are `NO_NODE_PAYLOAD`; a "when written" child is recognized
by its kind, never by position alone.
---
pure func node_schema(kind: NodeKind) -> NodeSchema:
	match kind:
		-- Literals. A literal payload is the `LiteralId` of the text: the digits
		-- of a number, the text of a string after escapes (as written for a raw
		-- string, joined lines for a pipe string).
		IntegerLiteralNode | FloatLiteralNode | StringLiteralNode | RawStringLiteralNode | PipeStringLiteralNode | RawPipeStringLiteralNode | InterpolationTextNode:
			shape(LiteralPayload, NoChildren)
		-- `InterpolationTextNode` pieces and `InterpolationHoleNode` holes in
		-- source order (a piece before, between and after holes when non-empty).
		InterpolatedStringNode | InterpolatedPipeStringNode:
			shape(NoPayload, AnyNumber)
		-- One `${...}` hole, spanning its `$` through its `}`. Child: the hole's
		-- expression.
		InterpolationHoleNode:
			shape(NoPayload, ExactlyOne)
		TrueLiteralNode | FalseLiteralNode | VoidNode | BuiltinNode | BreakNode | ContinueNode:
			shape(NoPayload, NoChildren)
		-- The payload is the codepoint.
		CharLiteralNode:
			shape(CodepointPayload, NoChildren)
		-- A name used as a value; the payload is its `NameId`.
		IdentifierNode:
			shape(NamePayload, NoChildren)
		-- Child: the operand.
		NegateNode | NotNode | DetachNode:
			shape(NoPayload, ExactlyOne)
		-- Children: the left and right operands (the start and end of a range).
		AddNode | SubtractNode | MultiplyNode | DivideNode | ModuloNode | EqualNode | NotEqualNode | LessNode | LessEqualNode | GreaterNode | GreaterEqualNode | AndNode | OrNode | RangeNode:
			shape(NoPayload, ExactlyTwo)
		-- Children: the callee, then the arguments in order.
		CallNode:
			shape(NoPayload, AtLeastOne)
		-- `x.f`. Payload: the `NameId` of the field; child: the receiver.
		FieldAccessNode:
			shape_with_name_span(NamePayload, ExactlyOne, NameSpanRowRequired)
		-- `x[i, ...]`. Children: the target, then the indices.
		SubscriptNode:
			shape(NoPayload, AtLeastOne)
		ListLiteralNode | TupleNode | VectorLiteralNode:
			shape(NoPayload, AnyNumber)
		-- `{f = v, ...}`: one `RecordFieldNode` per field.
		RecordLiteralNode:
			shape(NoPayload, AnyNumber)
		-- `{r | f = v}`. Children: the record, then one `RecordFieldNode` per field.
		RecordUpdateNode:
			shape(NoPayload, AtLeastOne)
		-- `f = v` in a record literal or update. Payload: the field's `NameId`;
		-- child: the value.
		RecordFieldNode:
			shape_with_name_span(NamePayload, ExactlyOne, NameSpanRowRequired)
		-- One `DictEntryNode` per entry.
		DictLiteralNode:
			shape(NoPayload, AnyNumber)
		-- Children: the key, then the value.
		DictEntryNode:
			shape(NoPayload, ExactlyTwo)
		-- `into_opaque T(x)` and `from_opaque T(x)`. Children: the type, then the value.
		IntoOpaqueNode | FromOpaqueNode:
			shape(NoPayload, ExactlyTwo)
		-- An indented block: its statements in order, the last its value. Empty
		-- only in recovery, where a diagnostic row reports the missing block.
		BlockNode:
			shape(NoPayload, AnyNumber)
		-- Children: the condition, the then block, and the else branch (a block
		-- or an `IfNode`) when written.
		IfNode:
			shape(NoPayload, TwoOrThree)
		-- Children: the scrutinee, then one `MatchCaseNode` per case.
		MatchNode:
			shape(NoPayload, AtLeastOne)
		-- Children: the pattern, then the body.
		MatchCaseNode:
			shape(NoPayload, ExactlyTwo)
		-- The arms.
		SelectNode:
			shape(NoPayload, AnyNumber)
		-- `name from channel:`. Payload: the binder's `NameId`; children: the
		-- channel, then the body.
		SelectReceiveArmNode:
			shape_with_name_span(NamePayload, ExactlyTwo, NameSpanRowRequired)
		-- `sealed channel:` and `_ after timeout:`. Children: the channel or
		-- timeout, then the body.
		SelectSealedArmNode | SelectAfterArmNode:
			shape(NoPayload, ExactlyTwo)
		-- Children: the binding (`WithBindingNode` or `WithTryBindingNode`), then the body.
		WithNode:
			shape(NoPayload, ExactlyTwo)
		-- `name [: T] = value`. Payload: the `NameId`; children: the type when
		-- written, then the value.
		WithBindingNode:
			shape_with_name_span(NamePayload, OneOrTwo, NameSpanRowRequired)
		-- `name [: T] ?= value [on e => mapped]`. Payload: the `NameId`;
		-- children: the type when written, the value, then a `WithErrorMapNode`
		-- when written.
		WithTryBindingNode:
			shape_with_name_span(NamePayload, OneToThree, NameSpanRowRequired)
		-- `on e => value`. Payload: the error binder's `NameId`; child: the value.
		WithErrorMapNode:
			shape_with_name_span(NamePayload, ExactlyOne, NameSpanRowRequired)
		-- `debug:` block. Child: the body.
		DebugBlockNode:
			shape(NoPayload, ExactlyOne)
		-- `func(params) [-> R]: body` and its `pure` form. Children: one
		-- `LambdaParameterNode` per parameter, the return type when written, then the body.
		LambdaNode | PureLambdaNode:
			shape(NoPayload, AtLeastOne)
		-- Payload: the `NameId`; child: the type when written. An untyped
		-- parameter is its name alone, so it has no name span row.
		LambdaParameterNode:
			shape_with_name_span(NamePayload, ZeroOrOne, NameSpanRowWhenItHasChildren)
		-- A function declared in a body. Payload: the `DefinitionId` of its
		-- `LocalFunctionDefinition` row, which carries its signature and body rows.
		LocalFunctionNode:
			shape(DefinitionPayload, NoChildren)
		-- Children: the condition, then the body.
		WhileNode:
			shape(NoPayload, ExactlyTwo)
		-- Children: the binder (`LoopBinderNode` or `TupleLoopBinderNode`), the
		-- iterable, then the body.
		ForNode:
			shape(NoPayload, ExactlyThree)
		-- Payload: the loop variable's `NameId`.
		LoopBinderNode:
			shape(NamePayload, NoChildren)
		-- `(a, b)` loop variables: one `LoopBinderNode` per name.
		TupleLoopBinderNode:
			shape(NoPayload, AnyNumber)
		-- `for x in xs concurrently(...)`. Children: the `LoopBinderNode`, the
		-- iterable, one `ConcurrentParameterNode` per parameter, then the body.
		ConcurrentForNode:
			shape(NoPayload, AtLeastThree)
		-- `concurrent[(...)]:`. Children: one `ConcurrentParameterNode` per
		-- parameter, then the body.
		ConcurrentBlockNode:
			shape(NoPayload, AtLeastOne)
		-- `name: value`. Payload: the `NameId`; child: the value.
		ConcurrentParameterNode:
			shape_with_name_span(NamePayload, ExactlyOne, NameSpanRowRequired)
		-- `builtin("name")`. Payload: the `LiteralId` of the name.
		NamedBuiltinNode:
			shape(LiteralPayload, NoChildren)
		-- Where an expression or statement could not be parsed; a diagnostic row
		-- reports it. Children: the parts that did parse, if any.
		MissingExpressionNode:
			shape(NoPayload, AnyNumber)
		-- `var name [: T] = value` and `name [: T] ?= value`. Payload: the
		-- `NameId`; children: the type when written, then the value.
		VarDeclarationNode | QuestionBindNode:
			shape_with_name_span(NamePayload, OneOrTwo, NameSpanRowRequired)
		-- `name: T = value`. Payload: the `NameId`; children: the type, then the value.
		TypedBindingNode:
			shape_with_name_span(NamePayload, ExactlyTwo, NameSpanRowRequired)
		-- `name = value`, as a statement or as a named argument inside a
		-- `CallNode`'s arguments; and `name += value` and its siblings.
		-- Payload: the `NameId`; child: the value.
		AssignmentNode | AddAssignNode | SubtractAssignNode | MultiplyAssignNode | DivideAssignNode:
			shape_with_name_span(NamePayload, ExactlyOne, NameSpanRowRequired)
		-- `x[i] = value`. Children: the `SubscriptNode`, then the value.
		SubscriptAssignmentNode:
			shape(NoPayload, ExactlyTwo)
		-- `(a, b) = value`. Children: one `DestructureBinderNode` per name, then the value.
		TupleDestructureNode:
			shape(NoPayload, AtLeastOne)
		-- Payload: the `NameId`.
		DestructureBinderNode:
			shape(NamePayload, NoChildren)
		WildcardPatternNode | TruePatternNode | FalsePatternNode | MissingPatternNode:
			shape(NoPayload, NoChildren)
		-- Payload: the `NameId` bound or matched.
		NamePatternNode:
			shape(NamePayload, NoChildren)
		-- Payload: the `LiteralId` of the digits (after the `-` of a negative number).
		IntegerPatternNode | NegativeIntegerPatternNode | FloatPatternNode | NegativeFloatPatternNode | StringPatternNode | RawStringPatternNode | PipeStringPatternNode | RawPipeStringPatternNode:
			shape(LiteralPayload, NoChildren)
		CharPatternNode:
			shape(CodepointPayload, NoChildren)
		-- `Name(p, ...)`. Payload: the constructor's `NameId`; children: the argument patterns.
		ConstructorPatternNode:
			shape_with_name_span(NamePayload, AnyNumber, NameSpanRowRequired)
		-- `Type.Name[(p, ...)]`. Payload: the constructor's `NameId`; children:
		-- one `PatternQualifierNode`, then the argument patterns.
		QualifiedConstructorPatternNode:
			shape_with_name_span(NamePayload, AtLeastOne, NameSpanRowRequired)
		-- Payload: the `NameId` of the qualifying type.
		PatternQualifierNode:
			shape(NamePayload, NoChildren)
		-- The element patterns.
		TuplePatternNode:
			shape(NoPayload, AnyNumber)
		-- `[p, ..., ...rest]`. Children: the element patterns, then a
		-- `ListSpreadNameNode` or `ListSpreadWildcardNode` when written.
		ListPatternNode:
			shape(NoPayload, AnyNumber)
		-- `...rest`. Payload: the `NameId`.
		ListSpreadNameNode:
			shape_with_name_span(NamePayload, NoChildren, NameSpanRowRequired)
		-- `..._`: no payload; its name span row holds the `_` after the dots.
		ListSpreadWildcardNode:
			shape_with_name_span(NoPayload, NoChildren, NameSpanRowRequired)
		-- `p | q`: the alternatives.
		OrPatternNode:
			shape(NoPayload, AtLeastTwo)
		-- A named type (`Int`, `List[T]`, `Self`, `()` as `Void`). Payload: the
		-- name's `NameId`; children: the type arguments. A name that is the
		-- whole node has no name span row.
		NamedTypeNode:
			shape_with_name_span(NamePayload, AnyNumber, NameSpanRowWhenItHasChildren)
		-- A module-qualified type (`M.Type[T]`). Payload: the type's `NameId`;
		-- children: one `TypeQualifierNode`, then the type arguments.
		QualifiedTypeNode:
			shape_with_name_span(NamePayload, AtLeastOne, NameSpanRowRequired)
		-- Payload: the `NameId` of the module alias.
		TypeQualifierNode:
			shape(NamePayload, NoChildren)
		-- A bounded type argument (`T: Eq + Hash`). Payload: the parameter's
		-- `NameId`; children: one `TypeBoundNode` or `QualifiedTypeBoundNode` per bound.
		BoundedTypeNode:
			shape_with_name_span(NamePayload, AnyNumber, NameSpanRowRequired)
		-- Payload: the trait's `NameId`.
		TypeBoundNode:
			shape(NamePayload, NoChildren)
		-- A trait bound written through a module alias (`T: M.Eq`). Payload: the
		-- trait's `NameId`; child: one `TypeQualifierNode`.
		QualifiedTypeBoundNode:
			shape_with_name_span(NamePayload, ExactlyOne, NameSpanRowRequired)
		-- A dimension variable (`#N`). Payload: the `NameId` of the plain name.
		DimensionNameTypeNode:
			shape(NamePayload, NoChildren)
		-- A variadic dimension variable (`#Ds...`). Payload: the plain name's `NameId`.
		VariadicDimensionNameTypeNode:
			shape_with_name_span(NamePayload, NoChildren, NameSpanRowRequired)
		-- The wildcard dimension `#_`.
		DimensionWildcardTypeNode:
			shape(NoPayload, NoChildren)
		-- The variadic wildcard dimension `#_...`.
		VariadicDimensionWildcardTypeNode:
			shape_with_name_span(NoPayload, NoChildren, NameSpanRowRequired)
		-- A dimension literal (`#3`, or `3` inside a dimension expression).
		-- Payload: the `LiteralId` of the digits.
		DimensionLiteralTypeNode:
			shape(LiteralPayload, NoChildren)
		-- Children: the left and right dimensions.
		DimensionAddTypeNode | DimensionSubtractTypeNode | DimensionMultiplyTypeNode | DimensionDivideTypeNode:
			shape(NoPayload, ExactlyTwo)
		-- A range type (`..#N`). Child: the dimension.
		RangeTypeNode:
			shape(NoPayload, ExactlyOne)
		TupleTypeNode:
			shape(NoPayload, AnyNumber)
		-- Children: the parameter types, then the return type last.
		FunctionTypeNode | PureFunctionTypeNode:
			shape(NoPayload, AtLeastOne)
		-- A fixed-size array type (`Float[#3]`). Children: the element type,
		-- then the dimensions.
		ArrayTypeNode:
			shape(NoPayload, AtLeastOne)
		MissingTypeNode:
			shape(NoPayload, NoChildren)


---
Whether `count` children fit `arity`.
---
pure func arity_admits(arity: ChildArity, count: Int) -> Bool:
	match arity:
		NoChildren:
			count == 0
		ZeroOrOne:
			count <= 1
		ExactlyOne:
			count == 1
		ExactlyTwo:
			count == 2
		ExactlyThree:
			count == 3
		OneOrTwo:
			count >= 1 and count <= 2
		TwoOrThree:
			count >= 2 and count <= 3
		OneToThree:
			count >= 1 and count <= 3
		AtLeastOne:
			count >= 1
		AtLeastTwo:
			count >= 2
		AtLeastThree:
			count >= 3
		AnyNumber:
			count >= 0


---
Which table the payload of a `kind` node indexes; `NoPayload` kinds store
`NO_NODE_PAYLOAD`.
---
pure func node_payload_reference(kind: NodeKind) -> NodePayloadReference:
	kind.node_schema().payload


---
Whether `kind` is a written dimension name (`#N`, `#Ds...`), whose spelling the
dimension name table pairs with its `#` form.
---
pure func names_a_dimension(kind: NodeKind) -> Bool:
	kind == DimensionNameTypeNode or kind == VariadicDimensionNameTypeNode


---
Whether `kind` is a two-operand operator written between its operands: the
arithmetic, comparison and logical operators (a range is not one).
---
pure func is_binary_operator_node(kind: NodeKind) -> Bool:
	match kind:
		AddNode | SubtractNode | MultiplyNode | DivideNode | ModuloNode | EqualNode | NotEqualNode | LessNode | LessEqualNode | GreaterNode | GreaterEqualNode | AndNode | OrNode:
			True
		IdentifierNode | IntegerLiteralNode | FloatLiteralNode | StringLiteralNode | RawStringLiteralNode | PipeStringLiteralNode | RawPipeStringLiteralNode | InterpolatedStringNode | InterpolationTextNode | InterpolationHoleNode | InterpolatedPipeStringNode | TrueLiteralNode | FalseLiteralNode | CharLiteralNode | NegateNode | NotNode | DetachNode | RangeNode | CallNode | FieldAccessNode | SubscriptNode | ListLiteralNode | TupleNode | VectorLiteralNode | RecordLiteralNode | RecordUpdateNode | RecordFieldNode | DictLiteralNode | DictEntryNode | IntoOpaqueNode | FromOpaqueNode | BlockNode | IfNode | MatchNode | MatchCaseNode | SelectNode | SelectReceiveArmNode | SelectSealedArmNode | SelectAfterArmNode | WithNode | WithBindingNode | WithTryBindingNode | WithErrorMapNode | DebugBlockNode | LambdaNode | PureLambdaNode | LambdaParameterNode | LocalFunctionNode | WhileNode | ForNode | LoopBinderNode | TupleLoopBinderNode | ConcurrentForNode | ConcurrentBlockNode | ConcurrentParameterNode | BreakNode | ContinueNode | VoidNode | BuiltinNode | NamedBuiltinNode | MissingExpressionNode | VarDeclarationNode | TypedBindingNode | AssignmentNode | QuestionBindNode | AddAssignNode | SubtractAssignNode | MultiplyAssignNode | DivideAssignNode | SubscriptAssignmentNode | TupleDestructureNode | DestructureBinderNode | WildcardPatternNode | NamePatternNode | IntegerPatternNode | NegativeIntegerPatternNode | FloatPatternNode | NegativeFloatPatternNode | StringPatternNode | RawStringPatternNode | PipeStringPatternNode | RawPipeStringPatternNode | CharPatternNode | TruePatternNode | FalsePatternNode | ConstructorPatternNode | QualifiedConstructorPatternNode | PatternQualifierNode | TuplePatternNode | ListPatternNode | ListSpreadNameNode | ListSpreadWildcardNode | OrPatternNode | MissingPatternNode | NamedTypeNode | QualifiedTypeNode | TypeQualifierNode | BoundedTypeNode | TypeBoundNode | QualifiedTypeBoundNode | DimensionNameTypeNode | VariadicDimensionNameTypeNode | DimensionWildcardTypeNode | VariadicDimensionWildcardTypeNode | DimensionLiteralTypeNode | DimensionAddTypeNode | DimensionSubtractTypeNode | DimensionMultiplyTypeNode | DimensionDivideTypeNode | RangeTypeNode | TupleTypeNode | FunctionTypeNode | PureFunctionTypeNode | ArrayTypeNode | MissingTypeNode:
			False


---
The construct a parser was in when it found a token missing: the argument of
the `Expected...` diagnostics (a colon, a closing bracket, a name, ...), so
the message can say "expected `:` after if condition" and not only that a
colon is missing. One variant per construct the existing parser names in such
a message; a variant is meaningful only with the codes that report it
(`diagnostics/render.brp` says what each combination reads as, and shows the
code's general text for any other).
---
enum ParsedConstruct:
	FunctionBody
	FieldName
	UnionVariants
	TraitName
	ImplementationMethods
	ForeignHeader
	ForeignBlockArgumentName
	WhileCondition
	IfCondition
	ElseBranch
	MatchExpression
	MatchPattern
	SelectHeader
	SelectReceiveChannel
	SealedSelectChannel
	SelectTimeout
	ForIterable
	ConcurrentNamedParameter
