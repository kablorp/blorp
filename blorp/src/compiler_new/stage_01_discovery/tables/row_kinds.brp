---
The table a node's payload indexes.
---
enum NodePayloadReference:
	NamePayload
	LiteralPayload
	CodepointPayload
	DefinitionPayload
	NoPayload


---
Which table the payload of a `kind` node indexes; `NoPayload` kinds store
`NO_NODE_PAYLOAD`.
---
pure func node_payload_reference(kind: NodeKind) -> NodePayloadReference:
	match kind:
		IdentifierNode | FieldAccessNode | RecordFieldNode | SelectReceiveArmNode | WithBindingNode | WithTryBindingNode | WithErrorMapNode | LambdaParameterNode | LoopBinderNode | ConcurrentParameterNode | VarDeclarationNode | TypedBindingNode | AssignmentNode | QuestionBindNode | AddAssignNode | SubtractAssignNode | MultiplyAssignNode | DivideAssignNode | DestructureBinderNode | NamePatternNode | ConstructorPatternNode | QualifiedConstructorPatternNode | PatternQualifierNode | ListSpreadNameNode | NamedTypeNode | QualifiedTypeNode | TypeQualifierNode | BoundedTypeNode | TypeBoundNode | DimensionNameTypeNode | VariadicDimensionNameTypeNode:
			NamePayload
		IntegerLiteralNode | FloatLiteralNode | StringLiteralNode | RawStringLiteralNode | PipeStringLiteralNode | RawPipeStringLiteralNode | InterpolationTextNode | NamedBuiltinNode | IntegerPatternNode | NegativeIntegerPatternNode | FloatPatternNode | NegativeFloatPatternNode | StringPatternNode | DimensionLiteralTypeNode:
			LiteralPayload
		CharLiteralNode | CharPatternNode:
			CodepointPayload
		LocalFunctionNode:
			DefinitionPayload
		_:
			NoPayload
