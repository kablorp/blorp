-- Payload-free enums stored in discovery rows.
import:
	debug as dbg


enum PackageKind:
	NativePackage
	SourcePackage


---
Where a module's source came from.
---
enum ModuleOriginKind:
	StdlibModule
	PackageModule
	SourcePackageModule
	UserModule


---
How discovery reached a module: named as a root, loaded as an implicit
module (see `ImplicitModules` in `pipeline`), or only through imports. A
module an implicit request finds already loaded keeps the reach of whatever
loaded it first.
---
enum ModuleReach:
	RootModule
	ImplicitModule
	ImportedModule


---
The syntax of an import request, before any module exists. A bare path
(`heap`, `lib/source`) may resolve to a standard-library module, a source
package or a local file, in the order the source provider defines; a
relative path starts with `./` or `../`; a native package path starts with
`pkg/`. The design sketch called the bare form a "stdlib request"; the syntax
does not decide that, the provider does.
---
enum ImportRequestKind:
	BareModuleRequest
	RelativeModuleRequest
	NativePackageRequest


---
An import request's kind together with, for a relative request, how many `../`
it climbs. One value, so a bare or native package request cannot carry parent
steps: it is built only by `bare_request`, `native_package_request` and
`relative_request`, and read by `request_kind` and `request_parent_steps`.
Struct rows cannot hold a union, so the three shapes share one `Int`
(`BARE_REQUEST_CODE`, `NATIVE_PACKAGE_REQUEST_CODE`, then
`FIRST_RELATIVE_REQUEST_CODE + parent_steps`), which only these functions see.
---
opaque type ImportRequestShape = Int

---
The code of a bare request.
---
BARE_REQUEST_CODE: Int = 0

---
The code of a native package request.
---
NATIVE_PACKAGE_REQUEST_CODE: Int = 1

---
The code of a relative request that climbs no parents (`./`); one more per
`../`.
---
FIRST_RELATIVE_REQUEST_CODE: Int = 2


---
A request that names a module by bare path.
---
pure func bare_request() -> ImportRequestShape:
	into_opaque ImportRequestShape(BARE_REQUEST_CODE)


---
A `pkg/...` request.
---
pure func native_package_request() -> ImportRequestShape:
	into_opaque ImportRequestShape(NATIVE_PACKAGE_REQUEST_CODE)


---
A request relative to the importer's directory: `./` for no parent steps, then
`../` once per step. A negative count is a defect in the caller: a debug build
stops with the message, and a release build takes it as no steps.
---
pure func relative_request(parent_steps: Int) -> ImportRequestShape:
	into_opaque ImportRequestShape(FIRST_RELATIVE_REQUEST_CODE + checked_steps(parent_steps))


---
`parent_steps`, or zero after a debug-build stop when it is negative.
---
private pure func checked_steps(parent_steps: Int) -> Int:
	debug:
		if parent_steps < 0:
			dbg.error("an import request cannot climb a negative number of parent directories")

	if parent_steps < 0:
		0
	else:
		parent_steps


pure func request_kind(shape: ImportRequestShape) -> ImportRequestKind:
	code: Int = from_opaque ImportRequestShape(shape)

	if code == BARE_REQUEST_CODE:
		BareModuleRequest
	else if code == NATIVE_PACKAGE_REQUEST_CODE:
		NativePackageRequest
	else:
		RelativeModuleRequest


---
How many `../` a relative request climbs; zero for every other request.
---
pure func request_parent_steps(shape: ImportRequestShape) -> Int:
	code: Int = from_opaque ImportRequestShape(shape)

	if code < FIRST_RELATIVE_REQUEST_CODE:
		0
	else:
		code - FIRST_RELATIVE_REQUEST_CODE


---
The text an import request is written as, built from its shape and path parts:
a relative request is `./` (no parent steps) or `../` once per step, then the
parts joined by `/`; a bare or native package request is its parts joined by
`/`.
---
pure func written_import_request(shape: ImportRequestShape, parts: List[String]) -> String:
	joined: String = parts.join("/")

	match shape.request_kind():
		RelativeModuleRequest:
			steps: Int = shape.request_parent_steps()

			if steps == 0:
				"./" + joined
			else:
				"../".repeat(steps) + joined
		BareModuleRequest:
			joined
		NativePackageRequest:
			joined


---
What a definition row declares. Members (fields, variants, trait and impl
methods) link to their owner with a `MemberRow`; a `LocalFunctionDefinition`
is a function declared inside a body, reached from its `LocalFunctionNode`.
---
enum DefinitionKind:
	FunctionDefinition
	RecordDefinition
	StructDefinition
	UnionDefinition
	EnumDefinition
	BuiltinTypeDefinition
	ResourceTypeDefinition
	TypeAliasDefinition
	OpaqueTypeDefinition
	TraitDefinition
	ImplDefinition
	ConstantDefinition
	MutableGlobalDefinition
	ForeignFunctionDefinition
	FieldDefinition
	VariantDefinition
	TraitMethodDefinition
	ImplMethodDefinition
	LocalFunctionDefinition


enum Visibility:
	PublicVisibility
	PrivateVisibility


---
A type parameter's kind: a type (`T`), a dimension (`#N`), or the wildcard
dimension `#_`, whose name column holds `_`.
---
enum TypeParameterKind:
	TypeParameter
	DimensionParameter
	WildcardDimensionParameter


enum Purity:
	PureFunction
	ImpureFunction


---
How a parameter binds its argument: `name` (or `_: Type`), `_`, or a tuple
`(a, b)`.
---
enum ParameterBinder:
	NamedParameterBinder
	WildcardParameterBinder
	TupleParameterBinder


---
The function annotations the language defines (`@tail_recursive`, ...).
---
enum FunctionAnnotation:
	TailRecursiveAnnotation
	NoCopyAnnotation
	DebugOnlyAnnotation
	ResourceResultOrdinaryAnnotation


---
The syntactic form of a node. Expressions, statements, patterns and written
types share the node table; `...TypeNode` kinds appear only where a type was
written and `...PatternNode` kinds only where a pattern was. The shape of every
kind (its payload table, how many children it has and whether it carries a name
span row) is declared once, in `node_schema`, beside a note on what its payload
and children are. A child documented there as "when written" is present only
when the source wrote it; it is recognized by its kind (a type child has a
`...TypeNode` kind), never by position alone.
---
enum NodeKind:
	IdentifierNode
	IntegerLiteralNode
	FloatLiteralNode
	StringLiteralNode
	RawStringLiteralNode
	PipeStringLiteralNode
	RawPipeStringLiteralNode
	InterpolatedStringNode
	InterpolationTextNode
	InterpolationHoleNode
	InterpolatedPipeStringNode
	TrueLiteralNode
	FalseLiteralNode
	CharLiteralNode
	NegateNode
	NotNode
	DetachNode
	AddNode
	SubtractNode
	MultiplyNode
	DivideNode
	ModuloNode
	EqualNode
	NotEqualNode
	LessNode
	LessEqualNode
	GreaterNode
	GreaterEqualNode
	AndNode
	OrNode
	RangeNode
	CallNode
	FieldAccessNode
	SubscriptNode
	ListLiteralNode
	TupleNode
	VectorLiteralNode
	RecordLiteralNode
	RecordUpdateNode
	RecordFieldNode
	DictLiteralNode
	DictEntryNode
	IntoOpaqueNode
	FromOpaqueNode
	BlockNode
	IfNode
	MatchNode
	MatchCaseNode
	SelectNode
	SelectReceiveArmNode
	SelectSealedArmNode
	SelectAfterArmNode
	WithNode
	WithBindingNode
	WithTryBindingNode
	WithErrorMapNode
	DebugBlockNode
	LambdaNode
	PureLambdaNode
	LambdaParameterNode
	LocalFunctionNode
	WhileNode
	ForNode
	LoopBinderNode
	TupleLoopBinderNode
	ConcurrentForNode
	ConcurrentBlockNode
	ConcurrentParameterNode
	BreakNode
	ContinueNode
	VoidNode
	BuiltinNode
	NamedBuiltinNode
	MissingExpressionNode
	VarDeclarationNode
	TypedBindingNode
	AssignmentNode
	QuestionBindNode
	AddAssignNode
	SubtractAssignNode
	MultiplyAssignNode
	DivideAssignNode
	SubscriptAssignmentNode
	TupleDestructureNode
	DestructureBinderNode
	WildcardPatternNode
	NamePatternNode
	IntegerPatternNode
	NegativeIntegerPatternNode
	FloatPatternNode
	NegativeFloatPatternNode
	StringPatternNode
	RawStringPatternNode
	PipeStringPatternNode
	RawPipeStringPatternNode
	CharPatternNode
	TruePatternNode
	FalsePatternNode
	ConstructorPatternNode
	QualifiedConstructorPatternNode
	PatternQualifierNode
	TuplePatternNode
	ListPatternNode
	ListSpreadNameNode
	ListSpreadWildcardNode
	OrPatternNode
	MissingPatternNode
	NamedTypeNode
	QualifiedTypeNode
	TypeQualifierNode
	BoundedTypeNode
	TypeBoundNode
	QualifiedTypeBoundNode
	DimensionNameTypeNode
	VariadicDimensionNameTypeNode
	DimensionWildcardTypeNode
	VariadicDimensionWildcardTypeNode
	DimensionLiteralTypeNode
	DimensionAddTypeNode
	DimensionSubtractTypeNode
	DimensionMultiplyTypeNode
	DimensionDivideTypeNode
	RangeTypeNode
	TupleTypeNode
	FunctionTypeNode
	PureFunctionTypeNode
	ArrayTypeNode
	MissingTypeNode


