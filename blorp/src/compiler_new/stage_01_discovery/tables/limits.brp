-- Limits of the language that discovery enforces and its diagnostics name.
--
-- They live apart from the lexer and parser that check them so the renderer
-- can read the number it shows, as it reads `SPAN_OFFSET_LIMIT`, and a
-- diagnostic carries no copy of a constant.
---
The most `${` holes an interpolated string may nest.
---
MAX_INTERPOLATION_DEPTH: Int = 64

---
The most payload fields a union variant may declare: a variant's ownership
bitmask has one bit per field.
---
MAX_UNION_VARIANT_FIELDS: Int = 64

---
The largest `Int`, in decimal digits: the most a `max_threads` or `limit` count
may be.
---
INT_MAX_DECIMAL: String = "9223372036854775807"
