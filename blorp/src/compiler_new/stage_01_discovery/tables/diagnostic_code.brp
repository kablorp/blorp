---
A stable name for each diagnostic, for dumps and fixtures.
---
pure func syntax_diagnostic_name(diagnostic: SyntaxDiagnostic) -> String:
	match diagnostic:
		Plain(code):
			plain_syntax_code_name(code)
		ExpectedToken(expected):
			expected_token_name(expected)
		UnknownEscape(_):
			"UnknownEscapeDiagnostic"
		IntegerLiteralOverflow(_):
			"IntegerLiteralOverflowDiagnostic"
		FloatLiteralOverflow(_):
			"FloatLiteralOverflowDiagnostic"
		UnexpectedByte(_):
			"UnexpectedByteDiagnostic"
		ReservedKeywordAsName(_):
			"ReservedKeywordAsNameDiagnostic"
		UnknownAnnotation(_):
			"UnknownAnnotationDiagnostic"
		ConcurrentDuplicateParameter(_):
			"ConcurrentDuplicateParameterDiagnostic"
		ConcurrentUnknownParameter(_):
			"ConcurrentUnknownParameterDiagnostic"
		ConcurrentForUnknownParameter(_):
			"ConcurrentForUnknownParameterDiagnostic"
		DuplicateField(_):
			"DuplicateFieldDiagnostic"
		DuplicateFieldGiven(_):
			"DuplicateFieldGivenDiagnostic"


---
The name of the code of a missing-token diagnostic, whatever construct it names.
---
private pure func expected_token_name(expected: ExpectedTokenDiagnostic) -> String:
	match expected:
		ExpectedName(_):
			"ExpectedNameDiagnostic"
		ExpectedColon(_):
			"ExpectedColonDiagnostic"
		ExpectedComma(_):
			"ExpectedCommaDiagnostic"
		ExpectedLeftParen(_):
			"ExpectedLeftParenDiagnostic"
		ExpectedRightParen(_):
			"ExpectedRightParenDiagnostic"
		ExpectedRightBracket(_):
			"ExpectedRightBracketDiagnostic"
		ExpectedLeftBrace(_):
			"ExpectedLeftBraceDiagnostic"
		ExpectedRightBrace(_):
			"ExpectedRightBraceDiagnostic"
		ExpectedArrow(_):
			"ExpectedArrowDiagnostic"
		ExpectedEqual(_):
			"ExpectedEqualDiagnostic"
		ExpectedNewline(_):
			"ExpectedNewlineDiagnostic"
		ExpectedIndent(_):
			"ExpectedIndentDiagnostic"
		ExpectedKeyword(_):
			"ExpectedKeywordDiagnostic"
		ExpectedFatArrow(_):
			"ExpectedFatArrowDiagnostic"


---
A stable name for each diagnostic, for dumps and fixtures.
---
pure func resolution_diagnostic_name(diagnostic: ResolutionDiagnostic) -> String:
	match diagnostic:
		UnresolvedImport(_):
			"UnresolvedImportDiagnostic"
		ImportCaseMismatch(_, _):
			"ImportCaseMismatchDiagnostic"
		UnverifiableSpelling(_):
			"UnverifiableSpellingDiagnostic"
		UnreadableSource(_):
			"UnreadableSourceDiagnostic"
		ImportSourceTooLarge(_):
			"ImportSourceTooLargeDiagnostic"
		ImportTooManySources:
			"ImportTooManySourcesDiagnostic"


---
A stable name for each diagnostic, for dumps and fixtures.
---
pure func root_diagnostic_name(diagnostic: RootDiagnostic) -> String:
	match diagnostic:
		UnresolvedRoot:
			"UnresolvedRootDiagnostic"
		RootCaseMismatch(_):
			"RootCaseMismatchDiagnostic"
		UnverifiableRootSpelling:
			"UnverifiableRootSpellingDiagnostic"
		UnreadableRootSource:
			"UnreadableRootSourceDiagnostic"
		RootSourceTooLarge(_):
			"RootSourceTooLargeDiagnostic"
		RootTooManySources:
			"RootTooManySourcesDiagnostic"


---
A stable name for each diagnostic, for dumps and fixtures.
---
pure func implicit_diagnostic_name(diagnostic: ImplicitDiagnostic) -> String:
	match diagnostic:
		MissingImplicitModule:
			"MissingImplicitModuleDiagnostic"
		UnverifiableImplicitSpelling:
			"UnverifiableImplicitSpellingDiagnostic"
		UnreadableImplicitSource:
			"UnreadableImplicitSourceDiagnostic"
		ImplicitSourceTooLarge(_):
			"ImplicitSourceTooLargeDiagnostic"
		ImplicitTooManySources:
			"ImplicitTooManySourcesDiagnostic"
