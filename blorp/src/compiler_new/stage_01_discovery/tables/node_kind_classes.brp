-- The node kinds an appender may write, by what the schema says of them.
--
-- `NodeKind` has every kind of body, pattern and type node; a leaf appender that
-- took any `NodeKind` could write a name kind with no name or a recovery kind with
-- no diagnostic. Each appender takes one of these fieldless enums instead, of
-- exactly the kinds whose `node_schema` has the payload, the children and the name
-- span row that appender writes, and `node_kind_of_*` maps each back to its
-- `NodeKind` through a total `match`. The recovery kinds (`MissingNodeKind`) and
-- `LocalFunctionNode` have appenders of their own. A test (`test_node_kind_classes`)
-- checks every variant against the schema and that each `NodeKind` is in exactly
-- one class. This file is written by hand; the test is what keeps it in step with
-- `node_schema`, so a change to the schema fails there until this file follows.
import:
	row_kinds:
		NodeKind(
			AddAssignNode, AddNode, AndNode, ArrayTypeNode, AssignmentNode, BlockNode,
			BoundedTypeNode, BreakNode, BuiltinNode, CallNode, CharLiteralNode, CharPatternNode,
			ConcurrentBlockNode, ConcurrentForNode, ConcurrentParameterNode, ConstructorPatternNode,
			ContinueNode, DebugBlockNode, DestructureBinderNode, DetachNode, DictEntryNode,
			DictLiteralNode, DimensionAddTypeNode, DimensionDivideTypeNode,
			DimensionLiteralTypeNode, DimensionMultiplyTypeNode, DimensionNameTypeNode,
			DimensionSubtractTypeNode, DimensionWildcardTypeNode, DivideAssignNode, DivideNode,
			EqualNode, FalseLiteralNode, FalsePatternNode, FieldAccessNode, FloatLiteralNode,
			FloatPatternNode, ForNode, FromOpaqueNode, FunctionTypeNode, GreaterEqualNode,
			GreaterNode, IdentifierNode, IfNode, IntegerLiteralNode, IntegerPatternNode,
			InterpolatedPipeStringNode, InterpolatedStringNode, InterpolationHoleNode,
			InterpolationTextNode, IntoOpaqueNode, LambdaNode, LambdaParameterNode, LessEqualNode,
			LessNode, ListLiteralNode, ListPatternNode, ListSpreadNameNode, ListSpreadWildcardNode,
			LoopBinderNode, MatchCaseNode, MatchNode, ModuloNode, MultiplyAssignNode, MultiplyNode,
			NamePatternNode, NamedBuiltinNode, NamedTypeNode, NegateNode, NegativeFloatPatternNode,
			NegativeIntegerPatternNode, NotEqualNode, NotNode, OrNode, OrPatternNode,
			PatternQualifierNode, PipeStringLiteralNode, PipeStringPatternNode,
			PureFunctionTypeNode, PureLambdaNode, QualifiedConstructorPatternNode,
			QualifiedTypeBoundNode, QualifiedTypeNode, QuestionBindNode, RangeNode, RangeTypeNode,
			RawPipeStringLiteralNode, RawPipeStringPatternNode, RawStringLiteralNode,
			RawStringPatternNode, RecordFieldNode, RecordLiteralNode, RecordUpdateNode,
			SelectAfterArmNode, SelectNode, SelectReceiveArmNode, SelectSealedArmNode,
			StringLiteralNode, StringPatternNode, SubscriptAssignmentNode, SubscriptNode,
			SubtractAssignNode, SubtractNode, TrueLiteralNode, TruePatternNode,
			TupleDestructureNode, TupleLoopBinderNode, TupleNode, TuplePatternNode, TupleTypeNode,
			TypeBoundNode, TypeQualifierNode, TypedBindingNode, VarDeclarationNode,
			VariadicDimensionNameTypeNode, VariadicDimensionWildcardTypeNode, VectorLiteralNode,
			VoidNode, WhileNode, WildcardPatternNode, WithBindingNode, WithErrorMapNode, WithNode,
			WithTryBindingNode,
		),


---
The kinds of a leaf with no payload and no children.
---
enum PlainLeafKind:
	TrueLiteralLeaf
	FalseLiteralLeaf
	VoidLeaf
	BuiltinLeaf
	BreakLeaf
	ContinueLeaf
	WildcardPatternLeaf
	TruePatternLeaf
	FalsePatternLeaf
	DimensionWildcardTypeLeaf


---
The `NodeKind` of a PlainLeaf kind.
---
pure func node_kind_of_plain_leaf(kind: PlainLeafKind) -> NodeKind:
	match kind:
		TrueLiteralLeaf:
			TrueLiteralNode
		FalseLiteralLeaf:
			FalseLiteralNode
		VoidLeaf:
			VoidNode
		BuiltinLeaf:
			BuiltinNode
		BreakLeaf:
			BreakNode
		ContinueLeaf:
			ContinueNode
		WildcardPatternLeaf:
			WildcardPatternNode
		TruePatternLeaf:
			TruePatternNode
		FalsePatternLeaf:
			FalsePatternNode
		DimensionWildcardTypeLeaf:
			DimensionWildcardTypeNode


---
Every PlainLeaf kind.
---
ALL_PLAIN_LEAF_KINDS: List[PlainLeafKind] = [
	TrueLiteralLeaf,
	FalseLiteralLeaf,
	VoidLeaf,
	BuiltinLeaf,
	BreakLeaf,
	ContinueLeaf,
	WildcardPatternLeaf,
	TruePatternLeaf,
	FalsePatternLeaf,
	DimensionWildcardTypeLeaf,
]


---
The kinds of a leaf with no payload whose name is narrower than the node (it has a `NodeNameSpanRow`).
---
enum SpannedLeafKind:
	ListSpreadWildcardLeaf
	VariadicDimensionWildcardTypeLeaf


---
The `NodeKind` of a SpannedLeaf kind.
---
pure func node_kind_of_spanned_leaf(kind: SpannedLeafKind) -> NodeKind:
	match kind:
		ListSpreadWildcardLeaf:
			ListSpreadWildcardNode
		VariadicDimensionWildcardTypeLeaf:
			VariadicDimensionWildcardTypeNode


---
Every SpannedLeaf kind.
---
ALL_SPANNED_LEAF_KINDS: List[SpannedLeafKind] = [
	ListSpreadWildcardLeaf,
	VariadicDimensionWildcardTypeLeaf,
]


