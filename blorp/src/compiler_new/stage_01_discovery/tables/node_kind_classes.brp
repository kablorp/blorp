		TypeQualifierLeaf:
			TypeQualifierNode
		TypeBoundLeaf:
			TypeBoundNode
		DimensionNameTypeLeaf:
			DimensionNameTypeNode


---
Every NameLeaf kind.
---
ALL_NAME_LEAF_KINDS: List[NameLeafKind] = [
	IdentifierLeaf,
	LoopBinderLeaf,
	DestructureBinderLeaf,
	NamePatternLeaf,
	PatternQualifierLeaf,
	NamedTypeLeaf,
	TypeQualifierLeaf,
	TypeBoundLeaf,
	DimensionNameTypeLeaf,
]


---
The kinds of a leaf whose payload is a name that is narrower than the node (it has a `NodeNameSpanRow`).
