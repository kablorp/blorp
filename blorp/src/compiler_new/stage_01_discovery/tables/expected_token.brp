-- The diagnostics for a token or layout the parser required and did not find.
--
-- Each code has an enum of the constructs the parser reports it in, listing
-- exactly those, so every `ExpectedTokenDiagnostic` that type-checks is one a
-- parser can report and `diagnostics/render.brp` has text for. A variant is
-- named `<Code>In<Construct>`: variant names are module-wide, so the code is
-- part of the name. Adding a call site that reports a new pair means adding a
-- variant here and an arm in the renderer; the compiler asks for both.
---
The constructs the parser reports a missing a name in.
---
enum NameConstruct:
	NameInFunctionName
	NameInParameterName
	NameInLambdaParameter
	NameInTypeParameterName
	NameInSelectReceiveBinding
	NameInWithErrorName
	NameInWithBindingName
	NameInVariableName
	NameInStatementName
	NameInRecordFieldName
	NameInFieldName
	NameInVariantName
	NameInTypeName
	NameInTypeAliasName
	NameInTraitMethodName
	NameInTraitName
	NameInForeignFunctionName
	NameInForeignBlockArgumentName
	NameInConstructorName
	NameInAnnotationName
	NameInConcurrentNamedParameter
	NameInTupleBinderName


---
The constructs the parser reports a missing `:` in.
---
enum ColonConstruct:
	ColonInFunctionBody
	ColonInFieldName
	ColonInUnionVariants
	ColonInTraitName
	ColonInImplementationMethods
	ColonInForeignHeader
	ColonInForeignBlockArgumentName
	ColonInWhileCondition
	ColonInIfCondition
	ColonInElseBranch
	ColonInMatchExpression
	ColonInMatchPattern
	ColonInSelectHeader
	ColonInSelectReceiveChannel
	ColonInSealedSelectChannel
	ColonInSelectTimeout
	ColonInForIterable
	ColonInConcurrentNamedParameter
	ColonInConcurrentBlock
	ColonInConcurrentlyParameters
	ColonInDebugBlock
	ColonInWithBinding
	ColonInLambdaBody


---
The constructs the parser reports a missing `,` in.
---
enum CommaConstruct:
	CommaInTuplePatternItems
	CommaInForeignBlockArguments
	CommaInTupleDestructuringNames
	CommaInTupleLoopVariables
	CommaInConcurrentParameters


---
The constructs the parser reports a missing `(` in.
---
enum LeftParenConstruct:
	LeftParenInFunctionName
	LeftParenInTraitMethodName
	LeftParenInForeignFunctionName
	LeftParenInPureFunctionType
	LeftParenInConcurrentlyHeader
	LeftParenInLambdaFunc
	LeftParenInOpaqueConversionType


---
The constructs the parser reports a missing `)` in.
---
enum RightParenConstruct:
	RightParenInConstructorPattern
	RightParenInTuplePattern
	RightParenInVariantFields
	RightParenInResourceCleanupBuiltinName
	RightParenInForeignBlockArguments
	RightParenInGroupedType
	RightParenInFunctionTypeParameters
	RightParenInDimensionExpression
	RightParenInFunctionParameters
	RightParenInTupleParameterNames
	RightParenInTupleDestructuringNames
	RightParenInTupleLoopVariables
	RightParenInConcurrentParameters
	RightParenInConcurrentlyParameters
	RightParenInLambdaParameters
	RightParenInCallArguments
	RightParenInOpaqueConversionValue
	RightParenInBuiltinName
	RightParenInTupleExpression
	RightParenInGroupedExpression


---
The constructs the parser reports a missing `]` in.
---
enum RightBracketConstruct:
	RightBracketInListPattern
	RightBracketInTypeArguments
	RightBracketInArrayDimensions
	RightBracketInTypeParameters
	RightBracketInSubscript
	RightBracketInListLiteral


---
The constructs the parser reports a missing `{` in.
---
enum LeftBraceConstruct:
	LeftBraceInStructFields
	LeftBraceInRecordFields


---
The constructs the parser reports a missing `}` in.
---
enum RightBraceConstruct:
	RightBraceInStructFields
	RightBraceInRecordFields
	RightBraceInRecordLiteral
	RightBraceInRecordUpdate
	RightBraceInDictLiteral
	RightBraceInVectorLiteral


---
The constructs the parser reports a missing `->` in.
---
enum ArrowConstruct:
	ArrowInForeignFunctionReturnType
	ArrowInFunctionTypeParameters


---
The constructs the parser reports a missing `=` in.
---
enum EqualConstruct:
	EqualInTopLevelVariable
	EqualInBuiltinTypeMarker
	EqualInTypeAliasTarget
	EqualInVariableDeclaration
	EqualInTupleDestructuring
	EqualInWithBinding
	EqualInRecordFieldName


---
The constructs the parser reports a missing a new line in.
---
enum NewlineConstruct:
	NewlineInIndentedBlock
	NewlineInMatchCases
	NewlineInSelectArms
	NewlineInUnionVariants
	NewlineInTraitMethods
	NewlineInImplementationMethods
	NewlineInForeignHeader


---
The constructs the parser reports a missing an indented block in.
---
enum IndentConstruct:
	IndentInBlock
	IndentInAssignmentValue
	IndentInUnionVariants
	IndentInTraitMethods
	IndentInImplementationMethods
	IndentInForeignBlock


---
The constructs the parser reports a missing a keyword in.
---
enum KeywordConstruct:
	KeywordInSelectReceiveBinding
	KeywordInForLoopVariable
	KeywordInLambdaFunc
	KeywordInBuiltinTypeDeclaration
	KeywordInBuiltinTypeMarker
	KeywordInTraitMethodName
	KeywordInImplementationTrait
	KeywordInForeignBlockItem
	KeywordInOpaqueType
	KeywordInTypeAliasKeyword


---
The constructs the parser reports a missing `=>` in.
---
enum FatArrowConstruct:
	FatArrowInWithErrorName
	FatArrowInDictEntry


---
A required token or layout that is missing, with the construct being parsed:

- `ExpectedName`: A name is required (a declaration, member, parameter, type parameter, trait, bound or supertrait name) and none is written.
- `ExpectedColon`: `:` is required here.
- `ExpectedComma`: `,` is required between two items.
- `ExpectedLeftParen`: `(` is required here.
- `ExpectedRightParen`: `)` is required here.
- `ExpectedRightBracket`: `]` is required here.
- `ExpectedLeftBrace`: `{` is required here.
- `ExpectedRightBrace`: `}` is required here.
- `ExpectedArrow`: `->` is required here.
- `ExpectedEqual`: `=` is required here.
- `ExpectedNewline`: A new line is required here.
- `ExpectedIndent`: An indented block is required here.
- `ExpectedKeyword`: A keyword (`func`, `type`, `alias`, `for`, `builtin`, `in` after a loop variable, or `from` after a select receive binding) is required here.
- `ExpectedFatArrow`: `=>` is required here.
---
union ExpectedTokenDiagnostic:
	ExpectedName(NameConstruct)
	ExpectedColon(ColonConstruct)
	ExpectedComma(CommaConstruct)
	ExpectedLeftParen(LeftParenConstruct)
	ExpectedRightParen(RightParenConstruct)
	ExpectedRightBracket(RightBracketConstruct)
	ExpectedLeftBrace(LeftBraceConstruct)
	ExpectedRightBrace(RightBraceConstruct)
	ExpectedArrow(ArrowConstruct)
	ExpectedEqual(EqualConstruct)
	ExpectedNewline(NewlineConstruct)
	ExpectedIndent(IndentConstruct)
	ExpectedKeyword(KeywordConstruct)
	ExpectedFatArrow(FatArrowConstruct)
