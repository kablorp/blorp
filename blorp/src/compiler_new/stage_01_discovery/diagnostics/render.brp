-- Rendered discovery diagnostics: the text a user sees for a coded row.
--
-- A diagnostic row stores the union of its own table (`SyntaxDiagnostic`,
-- `ResolutionDiagnostic`, `RootDiagnostic` or `ImplicitDiagnostic`): its code
-- and the arguments its code has (`tables/diagnostic_code.brp`). This module is
-- the one place that turns one into a message and a help line, so the
-- wording lives in one table: a `match` over the diagnostic, which fails to
-- compile for a code without text.
--
-- It sits beside `tables/`, not in it: the text for an import that differs
-- only in letter case reuses the source provider's `respelled_import_text`,
-- and `tables/` imports no other folder. Nothing in the stage imports this
-- module; it is read by whatever shows diagnostics.
--
-- The messages of the existing compiler are copied here, not referenced: the
-- stage must not import the old compiler. `docs/DISCOVERY_TABLES_DESIGN.md`
-- lists every code whose text differs from the existing compiler's, and why.
-- Names and numbers come from the diagnostic's arguments and the frozen tables; the few
-- diagnostics whose subject is only a stretch of source (the name of a
-- reserved keyword, an unexpected character) read that text from the row's
-- span.
import:
	../sources/source_provider: respelled_import_text
	../tables/diagnostic_code:
		ImplicitDiagnostic(
			ImplicitSourceTooLarge, ImplicitTooManySources, MissingImplicitModule,
			UnreadableImplicitSource, UnverifiableImplicitSpelling,
		),
		PlainSyntaxCode(
			AnnotationArgumentsDiagnostic, AnnotationWithoutFunctionDiagnostic,
			ArrayDimensionsExpectedDiagnostic, AssignmentInConditionDiagnostic,
			AssignmentInExpressionDiagnostic, BoundInTypeDiagnostic, BreakOutsideLoopDiagnostic,
			BuiltinTypeArgumentsDiagnostic, ConcurrentForMaxThreadsDiagnostic,
			ConcurrentForMissingLimitDiagnostic, ConcurrentForTupleBinderDiagnostic,
			ConcurrentLimitNotPositiveLiteralDiagnostic,
			ConcurrentMaxThreadsNotPositiveLiteralDiagnostic, ContinueOutsideLoopDiagnostic,
			DimensionParameterBoundsDiagnostic,
			DiscardedCompoundAssignmentDiagnostic,
			DiscardedQuestionBindDiagnostic, DocstringBeforeImportBlockDiagnostic,
			EnumCaseParenthesesDiagnostic,
			ExpectedAliasNameDiagnostic, ExpectedAssignmentOperatorDiagnostic,
			ExpectedBuiltinNameDiagnostic, ExpectedCleanupBuiltinNameDiagnostic,
			ExpectedClosingParenAfterConstructorsDiagnostic, ExpectedColonAfterImportDiagnostic,
			ExpectedCommaBetweenImportSymbolsDiagnostic, ExpectedConcurrentParameterDiagnostic,
			ExpectedConstructorNameDiagnostic, ExpectedDeclarationDiagnostic,
			ExpectedDimensionDiagnostic, ExpectedEqualEqualDiagnostic, ExpectedExpressionDiagnostic,
			ExpectedForeignArgumentDiagnostic, ExpectedForeignArgumentValueDiagnostic,
			ExpectedForeignCNameDiagnostic, ExpectedForeignFunctionDiagnostic,
			ExpectedHashDiagnostic, ExpectedImplMethodDiagnostic, ExpectedImportSymbolDiagnostic,
			ExpectedImportSymbolsAfterColonDiagnostic, ExpectedIndentedImportsDiagnostic,
			ExpectedModulePathDiagnostic, ExpectedNewlineAfterImportHeaderDiagnostic,
			ExpectedNumberAfterMinusDiagnostic, ExpectedPatternDiagnostic,
			ExpectedSpreadTargetDiagnostic, ExpectedSupertraitOrMethodsDiagnostic,
			ExpectedTypeDiagnostic, FieldAssignmentDiagnostic,
			ForeignFunctionOutsideBlockDiagnostic, ImportPathCurrentNotLeadingDiagnostic,
			ImportPathParentNotLeadingDiagnostic, InconsistentIndentationDiagnostic,
			InterpolatedEscapeAtEndDiagnostic, InterpolatedStringPatternDiagnostic,
			InterpolationHoleNotExpressionDiagnostic, InterpolationTooDeepDiagnostic,
			InvalidCharLiteralDiagnostic, MultilineInterpolatedStringDiagnostic,
			MissingFunctionBodyDiagnostic, MultilineRawStringDiagnostic, MultilineStringDiagnostic,
			UnpairedForwardDeclarationDiagnostic, QuestionBindInLoopDiagnostic,
			RemovedTypeAscriptionDiagnostic, TupleArityDiagnostic, UnexpectedCharacterDiagnostic,
			UnicodeCodepointOutOfRangeDiagnostic, UnicodeEscapeDigitCountDiagnostic,
			UnicodeEscapeNonHexDiagnostic, UnionVariantTooManyFieldsDiagnostic,
			UnterminatedCharLiteralDiagnostic, UnterminatedDocstringDiagnostic,
			UnterminatedEscapeDiagnostic, UnterminatedInterpolatedStringDiagnostic,
			UnterminatedRawStringDiagnostic, UnterminatedStringDiagnostic,
			UnterminatedUnicodeEscapeDiagnostic, WithMultipleBindingsDiagnostic,
		),
		ResolutionDiagnostic(
			ImportCaseMismatch, ImportSourceTooLarge, ImportTooManySources, UnreadableSource,
			UnresolvedImport, UnverifiableSpelling,
		),
		RootDiagnostic(
			RootCaseMismatch, RootSourceTooLarge, RootTooManySources, UnreadableRootSource,
			UnresolvedRoot, UnverifiableRootSpelling,
		),
		SyntaxDiagnostic(
			ConcurrentDuplicateParameter, ConcurrentForUnknownParameter, ConcurrentUnknownParameter,
			DuplicateField, DuplicateFieldGiven, ExpectedToken, IntegerLiteralOverflow, Plain,
			ReservedKeywordAsName, UnexpectedByte, UnknownAnnotation, UnknownEscape,
		),
	../tables/expected_token:
		ArrowConstruct(ArrowInForeignFunctionReturnType, ArrowInFunctionTypeParameters),
		ColonConstruct(
			ColonInFunctionBody, ColonInFieldName, ColonInUnionVariants, ColonInTraitName,
			ColonInImplementationMethods, ColonInForeignHeader, ColonInForeignBlockArgumentName,
			ColonInWhileCondition, ColonInIfCondition, ColonInElseBranch, ColonInMatchExpression,
			ColonInMatchPattern, ColonInSelectHeader, ColonInSelectReceiveChannel,
			ColonInSealedSelectChannel, ColonInSelectTimeout, ColonInForIterable,
			ColonInConcurrentNamedParameter, ColonInConcurrentBlock, ColonInConcurrentlyParameters,
			ColonInDebugBlock, ColonInWithBinding, ColonInLambdaBody,
		),
		CommaConstruct(
			CommaInTuplePatternItems, CommaInForeignBlockArguments, CommaInTupleDestructuringNames,
			CommaInTupleLoopVariables, CommaInConcurrentParameters,
		),
		EqualConstruct(
			EqualInTopLevelVariable, EqualInBuiltinTypeMarker, EqualInTypeAliasTarget,
			EqualInVariableDeclaration, EqualInTupleDestructuring, EqualInWithBinding,
			EqualInRecordFieldName,
		),
		ExpectedTokenDiagnostic(
			ExpectedName, ExpectedColon, ExpectedComma, ExpectedLeftParen, ExpectedRightParen,
			ExpectedRightBracket, ExpectedLeftBrace, ExpectedRightBrace, ExpectedArrow,
			ExpectedEqual, ExpectedNewline, ExpectedIndent, ExpectedKeyword, ExpectedFatArrow,
		),
		FatArrowConstruct(FatArrowInWithErrorName, FatArrowInDictEntry),
		IndentConstruct(
			IndentInBlock, IndentInAssignmentValue, IndentInUnionVariants, IndentInTraitMethods,
			IndentInImplementationMethods, IndentInForeignBlock,
		),
		KeywordConstruct(
			KeywordInSelectReceiveBinding, KeywordInForLoopVariable, KeywordInLambdaFunc,
			KeywordInBuiltinTypeDeclaration, KeywordInBuiltinTypeMarker, KeywordInTraitMethodName,
			KeywordInImplementationTrait, KeywordInForeignBlockItem, KeywordInOpaqueType,
			KeywordInTypeAliasKeyword,
		),
		LeftBraceConstruct(LeftBraceInStructFields, LeftBraceInRecordFields, LeftBraceInFixedRecordFields),
		LeftParenConstruct(
			LeftParenInFunctionName, LeftParenInTraitMethodName, LeftParenInForeignFunctionName,
			LeftParenInPureFunctionType, LeftParenInConcurrentlyHeader, LeftParenInLambdaFunc,
			LeftParenInOpaqueConversionType,
		),
		NameConstruct(
			NameInFunctionName, NameInParameterName, NameInLambdaParameter, NameInTypeParameterName,
			NameInSelectReceiveBinding, NameInWithErrorName, NameInWithBindingName,
			NameInVariableName, NameInStatementName, NameInRecordFieldName, NameInFieldName,
			NameInVariantName, NameInTypeName, NameInTypeAliasName, NameInTraitMethodName,
			NameInTraitName, NameInForeignFunctionName, NameInForeignBlockArgumentName,
			NameInConstructorName, NameInAnnotationName, NameInConcurrentNamedParameter,
			NameInTupleBinderName,
		),
		NewlineConstruct(
			NewlineInIndentedBlock, NewlineInMatchCases, NewlineInSelectArms,
			NewlineInUnionVariants, NewlineInTraitMethods, NewlineInImplementationMethods,
			NewlineInForeignHeader,
		),
		RightBraceConstruct(
			RightBraceInStructFields, RightBraceInRecordFields, RightBraceInFixedRecordFields,
			RightBraceInRecordLiteral,
			RightBraceInRecordUpdate, RightBraceInDictLiteral, RightBraceInVectorLiteral,
		),
		RightBracketConstruct(
			RightBracketInListPattern, RightBracketInTypeArguments, RightBracketInArrayDimensions,
			RightBracketInTypeParameters, RightBracketInSubscript, RightBracketInListLiteral,
		),
		RightParenConstruct(
			RightParenInConstructorPattern, RightParenInTuplePattern, RightParenInVariantFields,
			RightParenInResourceCleanupBuiltinName, RightParenInForeignBlockArguments,
			RightParenInGroupedType, RightParenInFunctionTypeParameters,
			RightParenInDimensionExpression, RightParenInFunctionParameters,
			RightParenInTupleParameterNames, RightParenInTupleDestructuringNames,
			RightParenInTupleLoopVariables, RightParenInConcurrentParameters,
			RightParenInConcurrentlyParameters, RightParenInLambdaParameters,
			RightParenInCallArguments, RightParenInOpaqueConversionValue, RightParenInBuiltinName,
			RightParenInTupleExpression, RightParenInGroupedExpression,
		),
	../tables/frontend_tables:
		FrontendTables,
		implicit_rejection,
		implicit_request_count,
		implicit_request_row,
		import_row,
		literal_text,
		module_row,
		name_spelling,
		path_text,
		root_count,
		root_rejection,
		root_row,
		root_target,
		source_row,
		source_text,
		span_line_column,
	../tables/ids:
		ImplicitRequestId,
		ImportId,
		PathId,
		RootId,
		SourceId,
		implicit_request_id_at_row,
		root_id_at_row,
		source_id_at_row,
		source_id_index,
	../tables/limits: INT_MAX_DECIMAL, MAX_INTERPOLATION_DEPTH, MAX_UNION_VARIANT_FIELDS
	../tables/rows: DefinitionRow, ResolutionDiagnosticRow, SyntaxDiagnosticRow
	../tables/source_position: LineColumn
	../tables/span: MAX_SOURCE_COUNT, SPAN_OFFSET_LIMIT, Span, span_length, span_source, span_start
	string: from_char, to_hex


---
The text a discovery diagnostic shows: its message and, when the error has a
correction to teach, a help line. Names and literals are spelled from the
frozen tables.
---
record RenderedDiagnostic {
	message: String,
	help: Option[String]
}


---
The printable ASCII range: a byte in it is quoted as itself.
---
private FIRST_PRINTABLE_ASCII: Int = 33

private LAST_PRINTABLE_ASCII: Int = 126

---
Codepoints a quoted character would hide: controls, no-break and zero-width
spaces, bidirectional controls, joiners and the byte order mark. They are
spelled `U+XXXX` instead. Each pair is an inclusive range.
---
private INVISIBLE_CODEPOINT_RANGES: List[(Int, Int)] = [
	(0, 32),
	(127, 160),
	(173, 173),
	(8192, 8207),
	(8232, 8238),
	(8288, 8303),
	(65279, 65279),
]

---
Hexadecimal digits a codepoint or a byte is padded to.
---
private CODEPOINT_HEX_WIDTH: Int = 4

private BYTE_HEX_WIDTH: Int = 2


---
The rendered text of a lexer or parser diagnostic row: its message and help,
without the position (see `diagnostic_display`).
---
pure func render_diagnostic(tables: FrontendTables, row: SyntaxDiagnosticRow) -> RenderedDiagnostic:
	tables.render_syntax(
		row.diagnostic,
		tables.span_text(row.span),
	)


---
The rendered text of a module graph diagnostic row about an import, without
the position (see `resolution_diagnostic_display`).
---
pure func render_resolution_diagnostic(
	tables: FrontendTables,
	row: ResolutionDiagnosticRow,
) -> RenderedDiagnostic:
	tables.render_resolution(row.diagnostic)


---
The rendered text of a root request that loaded no module. A root names its
source by path and its row has no span, so there is no position to show.
---
pure func render_root_diagnostic(
	tables: FrontendTables,
	root: RootId,
	diagnostic: RootDiagnostic,
) -> RenderedDiagnostic:
	tables.render_root(
		diagnostic,
		tables.path_text(tables.root_row(root).request_path),
	)


---
The rendered text of every root that loaded no module, in root order.
---
pure func render_root_rejections(tables: FrontendTables) -> List[RenderedDiagnostic]:
	var rendered: List[RenderedDiagnostic] = []

	for index in 0..tables.root_count():
		root: RootId = root_id_at_row(index)

		match tables.root_rejection(root):
			Some(diagnostic):
				rendered = rendered.append(tables.render_root_diagnostic(root, diagnostic))
			None:
				void

	rendered


---
The rendered text of every implicit module request that loaded no module, in
request order.
---
pure func render_implicit_rejections(tables: FrontendTables) -> List[RenderedDiagnostic]:
	var rendered: List[RenderedDiagnostic] = []

	for index in 0..tables.implicit_request_count():
		request: ImplicitRequestId = implicit_request_id_at_row(index)

		match tables.implicit_rejection(request):
			Some(diagnostic):
				rendered = rendered.append(tables.render_implicit_diagnostic(request, diagnostic))
			None:
				void

	rendered


---
The rendered text of an implicit module that loaded no module. Like a root,
its row has no span; it names the module by the name the compiler asks for.
---
pure func render_implicit_diagnostic(
	tables: FrontendTables,
	request: ImplicitRequestId,
	diagnostic: ImplicitDiagnostic,
) -> RenderedDiagnostic:
	render_implicit(
		diagnostic,
		tables.path_text(tables.implicit_request_row(request).request_path),
	)


---
The path a diagnostic names a source by: for the module a root loaded, the path
as the caller gave the root (the user wrote it, so they recognize it); for any
other module, its canonical path.
---
private pure func source_display_path(tables: FrontendTables, source: SourceId) -> String:
	var shown: String = tables.path_text(tables.source_row(source).path)

	for index in 0..tables.root_count():
		root = root_id_at_row(index)

		match tables.root_target(root):
			Some(module):
				if tables.module_row(module).source.source_id_index() == source.source_id_index():
					shown = tables.path_text(tables.root_row(root).request_path)
					break
			None:
				void

	shown


---
`path:line:column: error: message`, then `help: ...` on its own line: the
shape the existing compiler prints. The column counts bytes, with a tab
advancing to the next multiple of four, as the existing compiler's does.
---
pure func diagnostic_display(tables: FrontendTables, row: SyntaxDiagnosticRow) -> String:
	tables.displayed_at(
		row.span,
		tables.render_diagnostic(row),
	)


---
`diagnostic_display` for a module graph diagnostic about an import.
---
pure func resolution_diagnostic_display(
	tables: FrontendTables,
	row: ResolutionDiagnosticRow,
) -> String:
	tables.displayed_at(
		row.span,
		tables.render_resolution_diagnostic(row),
	)


private pure func displayed_at(
	tables: FrontendTables,
	span: Span,
	rendered: RenderedDiagnostic,
) -> String:
	source_path: String = tables.source_display_path(span.span_source())
	first_line: String = source_path + ":" + tables.position_text(
		span,
	) + ": error: " + rendered.message

	match rendered.help:
		Some(help):
			first_line + "\nhelp: " + help
		None:
			first_line


-- Reading arguments and spans.
---
`line:column` of where `span` starts, as a diagnostic's own position prints.
---
private pure func position_text(tables: FrontendTables, span: Span) -> String:
	position: LineColumn = tables.span_line_column(span)
	(position.line + 1).to_string() + ":" + position.column.to_string()


private pure func span_text(tables: FrontendTables, span: Span) -> String:
	tables
		.source_text(span.span_source())
		.substring(span.span_start(), span.span_length())


---
The path an import was written with.
---
private pure func import_written(tables: FrontendTables, import_id: ImportId) -> String:
	tables.import_request_text(tables.import_row(import_id))


private pure func respelled_import(
	tables: FrontendTables,
	import_id: ImportId,
	stored_path: PathId,
) -> String:
	respelled_import_text(
		tables.import_written(import_id),
		tables
			.path_text(stored_path)
			.split("/"),
	)


-- Spelling bytes and characters.
private pure func is_printable_ascii(value: Int) -> Bool:
	value >= FIRST_PRINTABLE_ASCII and value <= LAST_PRINTABLE_ASCII


private pure func hex_digits(value: Int, width: Int) -> String:
	value
		.to_hex()
		.upper()
		.pad_left(width, '0')


private pure func byte_hex(value: Int) -> String:
	"0x" + hex_digits(value, BYTE_HEX_WIDTH)


---
The character after a backslash that names no escape: itself when printable
ASCII, else its byte.
---
private pure func escaped_byte_text(value: Int) -> String:
	if is_printable_ascii(value):
		from_char(to_char(value))
	else:
		"x" + hex_digits(value, BYTE_HEX_WIDTH)


private pure func is_invisible(codepoint: Int) -> Bool:
	INVISIBLE_CODEPOINT_RANGES.any(
		pure func(range): codepoint >= range[0] and codepoint <= range[1],
	)


---
`'c'` for a visible character; `U+XXXX` for one a quote would hide.
---
private pure func character_text(text: String) -> String:
	codepoint: Int = text
		.codepoints()
		.get_or(0, 0)

	if is_invisible(codepoint):
		"U+" + hex_digits(codepoint, CODEPOINT_HEX_WIDTH)
	else:
		"'" + text + "'"


private pure func unexpected_character_help(text: String) -> String:
	match text:
		"&":
			"Blorp writes boolean operators as words: use `and`, `or` and `not`"
		"!":
			"Blorp writes boolean negation as `not`, and inequality as `!=`"
		_:
			"remove it, or put it inside a string literal if it is text"


private pure func with_help(message: String, help: String) -> RenderedDiagnostic:
	{
		message = message,
		help = Some(help)
	}


-- Text of the diagnostics that say which construct was being parsed.
---
The message when the parser was in `construct` (a name was required).
---
private pure func expected_name_text(construct: NameConstruct) -> String:
	match construct:
		NameInFunctionName:
			"expected function name"
		NameInParameterName:
			"expected parameter name"
		NameInLambdaParameter:
			"expected lambda parameter"
		NameInTypeParameterName:
			"expected type parameter"
		NameInSelectReceiveBinding:
			"expected select receive binding"
		NameInWithErrorName:
			"expected with error name"
		NameInWithBindingName:
			"expected with binding name"
		NameInVariableName:
			"expected variable name"
		NameInStatementName:
			"expected statement name"
		NameInRecordFieldName:
			"expected record field"
		NameInFieldName:
			"expected field name"
		NameInVariantName:
			"expected variant name"
		NameInTypeName:
			"expected type name"
		NameInTypeAliasName:
			"expected type alias name"
		NameInTraitMethodName:
			"expected trait method name"
		NameInTraitName:
			"expected trait name"
		NameInForeignFunctionName:
			"expected foreign function name"
		NameInForeignBlockArgumentName:
			"expected foreign block argument"
		NameInConstructorName:
			"expected constructor name"
		NameInAnnotationName:
			"expected function annotation"
		NameInConcurrentNamedParameter:
			"expected concurrent parameter"
		NameInTupleBinderName:
			"expected tuple binder name"


---
The message when the parser was in `construct` (`:` was required).
---
private pure func expected_colon_text(construct: ColonConstruct) -> String:
	match construct:
		ColonInFunctionBody:
			"expected `:` before function body"
		ColonInFieldName:
			"expected `:` after field name"
		ColonInUnionVariants:
			"expected `:` before variants"
		ColonInTraitName:
			"expected `:` after trait name"
		ColonInImplementationMethods:
			"expected `:` before implementation methods"
		ColonInForeignHeader:
			"expected `:` after foreign"
		ColonInForeignBlockArgumentName:
			"expected `:` after foreign block argument name"
		ColonInWhileCondition:
			"expected `:` after while condition"
		ColonInIfCondition:
			"expected `:` after if condition"
		ColonInElseBranch:
			"expected `:` after else"
		ColonInMatchExpression:
			"expected `:` after match expression"
		ColonInMatchPattern:
			"expected `:` after match pattern"
		ColonInSelectHeader:
			"expected `:` after select"
		ColonInSelectReceiveChannel:
			"expected `:` after select receive channel"
		ColonInSealedSelectChannel:
			"expected `:` after sealed select channel"
		ColonInSelectTimeout:
			"expected `:` after select timeout"
		ColonInForIterable:
			"expected `:` after for loop iterable"
		ColonInConcurrentNamedParameter:
			"expected `:` after concurrent parameter name"
		ColonInConcurrentBlock:
			"expected `:` after concurrent"
		ColonInConcurrentlyParameters:
			"expected `:` after concurrently parameters"
		ColonInDebugBlock:
			"expected `:` after debug"
		ColonInWithBinding:
			"expected `:` after with binding"
		ColonInLambdaBody:
			"expected `:` before lambda body"


---
The message when the parser was in `construct` (`,` was required).
---
private pure func expected_comma_text(construct: CommaConstruct) -> String:
	match construct:
		CommaInTuplePatternItems:
			"expected `, ` between tuple pattern items"
		CommaInForeignBlockArguments:
			"expected `, ` between foreign block arguments"
		CommaInTupleDestructuringNames:
			"expected `, ` between tuple destructuring names"
		CommaInTupleLoopVariables:
			"expected `, ` between tuple loop variables"
		CommaInConcurrentParameters:
			"expected `, ` between concurrent parameters"


---
The message when the parser was in `construct` (`(` was required).
---
private pure func expected_left_paren_text(construct: LeftParenConstruct) -> String:
