		RightParenInTuplePattern:
			"expected `)` after tuple pattern"
		RightParenInVariantFields:
			"expected `)` after variant fields"
		RightParenInResourceCleanupBuiltinName:
			"expected `)` after resource cleanup builtin name"
		RightParenInForeignBlockArguments:
			"expected `)` after foreign block arguments"
		RightParenInGroupedType:
			"expected `)` after type"
		RightParenInFunctionTypeParameters:
			"expected `)` after function type parameters"
		RightParenInDimensionExpression:
			"expected `)` after dimension expression"
		RightParenInFunctionParameters:
			"expected `)` after function parameters"
		RightParenInTupleParameterNames:
			"expected `)` after tuple parameter names"
		RightParenInTupleDestructuringNames:
			"expected `)` after tuple destructuring names"
		RightParenInTupleLoopVariables:
			"expected `)` after tuple loop variables"
		RightParenInConcurrentParameters:
			"expected `)` after concurrent parameters"
		RightParenInConcurrentlyParameters:
			"expected `)` after concurrently parameters"
		RightParenInLambdaParameters:
			"expected `)` after lambda parameters"
		RightParenInCallArguments:
			"expected `)` after call arguments"
		RightParenInOpaqueConversionValue:
			"expected `)` after opaque conversion value"
		RightParenInBuiltinName:
			"expected `)` after builtin name"
		RightParenInTupleExpression:
			"expected `)` after tuple expression"
		RightParenInGroupedExpression:
			"expected `)` after expression"


---
The message when the parser was in `construct` (`]` was required).
---
private pure func expected_right_bracket_text(construct: RightBracketConstruct) -> String:
	match construct:
		RightBracketInListPattern:
			"expected `]` after list pattern"
		RightBracketInTypeArguments:
			"expected `]` after type arguments"
		RightBracketInArrayDimensions:
			"expected `]` after array dimensions"
		RightBracketInTypeParameters:
			"expected `]` after type parameters"
		RightBracketInSubscript:
			"expected `]` after subscript"
