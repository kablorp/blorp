		RightBraceInRecordFields:
			"expected `}` after record fields"
		RightBraceInFixedRecordFields:
			"expected `}` after fixed record fields"
		RightBraceInRecordLiteral:
			"expected `}` after record literal"
		RightBraceInRecordUpdate:
			"expected `}` after record update"
		RightBraceInDictLiteral:
			"expected `}` after dict literal"
		RightBraceInVectorLiteral:
			"expected `}` after vector literal"


---
The message when the parser was in `construct` (`->` was required).
---
private pure func expected_arrow_text(construct: ArrowConstruct) -> String:
	match construct:
		ArrowInForeignFunctionReturnType:
			"expected `->` before foreign function return type"
		ArrowInFunctionTypeParameters:
			"expected `->` after function type parameters"


---
The message when the parser was in `construct` (`=` was required).
---
private pure func expected_equal_text(construct: EqualConstruct) -> String:
	match construct:
		EqualInTopLevelVariable:
			"expected `=` after top-level variable declaration"
		EqualInBuiltinTypeMarker:
			"expected `=` before builtin type marker"
		EqualInTypeAliasTarget:
			"expected `=` before type alias target"
		EqualInVariableDeclaration:
			"expected `=` after variable declaration"
		EqualInTupleDestructuring:
			"expected `=` after tuple destructuring"
		EqualInWithBinding:
			"expected `=` or `?=` after with binding"
		EqualInRecordFieldName:
			"expected `=` after record field name"


---
The message when the parser was in `construct` (a new line was required).
---
private pure func expected_newline_text(construct: NewlineConstruct) -> String:
	match construct:
		NewlineInIndentedBlock:
			"expected newline before indented block"
		NewlineInMatchCases:
			"expected newline before match cases"
		NewlineInSelectArms:
			"expected newline before select arms"
		NewlineInUnionVariants:
			"expected newline before variants"
		NewlineInTraitMethods:
			"expected newline before trait methods"
		NewlineInImplementationMethods:
			"expected newline before implementation methods"
		NewlineInForeignHeader:
			"expected newline after foreign header"


---
The message when the parser was in `construct` (an indented block was required).
---
private pure func expected_indent_text(construct: IndentConstruct) -> String:
	match construct:
		IndentInBlock:
			"expected an indented block"
		IndentInAssignmentValue:
			"expected indented assignment value"
		IndentInUnionVariants:
			"expected indented variants"
		IndentInTraitMethods:
			"expected indented trait methods"
		IndentInImplementationMethods:
			"expected indented implementation methods"
		IndentInForeignBlock:
			"expected indented foreign declarations"


---
The message when the parser was in `construct` (a keyword was required).
---
private pure func expected_keyword_text(construct: KeywordConstruct) -> String:
	match construct:
		KeywordInSelectReceiveBinding:
			"expected `from` after select receive binding"
		KeywordInForLoopVariable:
			"expected `in` after for loop variable"
		KeywordInLambdaFunc:
			"expected `func` before lambda"
		KeywordInBuiltinTypeDeclaration:
			"expected `type` in builtin type declaration"
		KeywordInBuiltinTypeMarker:
			"expected `builtin` after `=`"
		KeywordInTraitMethodName:
			"expected `func` before trait method"
		KeywordInImplementationTrait:
			"expected `for` after trait name"
		KeywordInForeignBlockItem:
			"expected `func` in foreign block item"
		KeywordInOpaqueType:
			"expected `type` after `opaque`"
		KeywordInTypeAliasKeyword:
			"expected `alias` after `type`"


---
The message when the parser was in `construct` (`=>` was required).
---
private pure func expected_fat_arrow_text(construct: FatArrowConstruct) -> String:
	match construct:
		FatArrowInWithErrorName:
			"expected `=>` after with error name"
		FatArrowInDictEntry:
			"expected `=>` between dict key and value"


private pure func left_paren_help(construct: LeftParenConstruct) -> String:
	match construct:
		LeftParenInFunctionName:
			"write the parameters or arguments inside parentheses"
		LeftParenInTraitMethodName:
			"write the parameters or arguments inside parentheses"
		LeftParenInForeignFunctionName:
			"write the parameters or arguments inside parentheses"
		LeftParenInPureFunctionType:
			"write the parameters or arguments inside parentheses"
		LeftParenInConcurrentlyHeader:
			"write `for x in xs concurrently(limit: N):`"
		LeftParenInLambdaFunc:
			"write the parameters or arguments inside parentheses"
		LeftParenInOpaqueConversionType:
			"write the parameters or arguments inside parentheses"


---
The text of a lexer or parser diagnostic. `span_text` is the source text under
its row's span, read only by the one code that has no token to name
(`UnexpectedCharacter`).
---
private pure func render_syntax(
	tables: FrontendTables,
	diagnostic: SyntaxDiagnostic,
	span_text: String,
) -> RenderedDiagnostic:
	match diagnostic:
		Plain(code):
			render_plain_syntax(code, span_text)
		ExpectedToken(expected):
			render_expected_token(expected)
		UnknownEscape(escaped):
			with_help(
				"unknown escape sequence '\\" + escaped_byte_text(to_int(escaped)) + "'",
				"write `\\n`, `\\t`, `\\r`, `\\0`, `\\\\`, `\\\"`, `\\'`, `\\{`, `\\}` or `\\u{...}`; to write a backslash, double it",
			)
		IntegerLiteralOverflow(digits):
			with_help(
				"Integer literal '" + tables.literal_text(digits) + "' exceeds Int128 range",
				"write a smaller number, or use a Float literal such as `1.0e40`",
			)
		UnexpectedByte(value):
			with_help(
				"unexpected byte " + byte_hex(to_int(value)) + ": the source is not valid UTF-8",
				"save the file as UTF-8, or remove the byte",
			)
		ReservedKeywordAsName(name):
			with_help(
				"`" + tables.name_spelling(
					name,
				) + "` is a reserved keyword and cannot be used as a name",
				"choose another identifier such as `" + tables.name_spelling(name) + "_name`",
			)
		UnknownAnnotation(name):
			with_help(
				"unknown function annotation `@" + tables.name_spelling(name) + "`",
				(
					"use one of @tail_recursive, @debug_only, @no_copy, @resource_result_ordinary, "
					+ "or remove the annotation"
				),
			)
		ConcurrentDuplicateParameter(name):
			with_help(
				"duplicate `" + tables.name_spelling(name) + "` parameter",
				"remove the second `" + tables.name_spelling(name) + "`",
			)
		DuplicateField(first):
			earlier: DefinitionRow = tables.definition_row(first)
			position: String = tables.position_text(earlier.name_span)

			with_help(
				"duplicate field `" + tables.name_spelling(earlier.name) + "`",
				"the field was already declared at " + position + "; remove one or give it another name",
			)
		DuplicateFieldGiven(first):
			with_help(
				"duplicate field `" + span_text + "`",
				"the field was already given at " + tables.position_text(first) + "; give it once",
			)
		ConcurrentUnknownParameter(name):
			with_help(
				"unknown concurrent parameter `" + tables.name_spelling(
					name,
				) + "` (expected `max_threads` or `timeout`)",
				"remove `" + tables.name_spelling(
					name,
				) + "`; `concurrent(...)` accepts `max_threads` and `timeout`",
			)
		ConcurrentForUnknownParameter(name):
			with_help(
				"unknown concurrently parameter `" + tables.name_spelling(
					name,
				) + "` (expected `limit` or `timeout`)",
				"remove `" + tables.name_spelling(
					name,
				) + "`; `concurrently(...)` accepts `limit` and `timeout`",
			)


---
The text of a module graph diagnostic about an import.
---
private pure func render_resolution(
	tables: FrontendTables,
	diagnostic: ResolutionDiagnostic,
) -> RenderedDiagnostic:
	match diagnostic:
		UnresolvedImport(import_id):
			with_help(
				"cannot find module `" + tables.import_written(import_id) + "`",
				(
					"check the spelling of the import path and that the module exists; relative "
					+ "paths start with `./` or `../`"
				),
			)
		ImportCaseMismatch(import_id, stored_path):
			with_help(
				"import `" + tables.import_written(
					import_id,
				) + "` does not match the file's name `" + tables.path_text(stored_path) + "`",
				"import paths are case-sensitive; write `" + tables.respelled_import(
					import_id,
					stored_path,
				) + "`",
			)
		UnverifiableSpelling(import_id):
			with_help(
				"cannot check the letter case of `" + tables.import_written(import_id) + "`",
				"a directory on the way to the file could not be listed; check its permissions",
			)
		UnreadableSource(import_id):
			with_help(
				"cannot read `" + tables.import_written(import_id) + "`",
				"check that the file exists and that you may read it",
			)
		ImportSourceTooLarge(byte_length):
			source_too_large(byte_length)
		ImportTooManySources:
			too_many_sources()


---
The text of a diagnostic about a root request. `root_request` is the path the
root was given.
---
private pure func render_root(
	tables: FrontendTables,
	diagnostic: RootDiagnostic,
	root_request: String,
) -> RenderedDiagnostic:
	match diagnostic:
		UnresolvedRoot:
			with_help(
				"cannot find source file `" + root_request + "`",
				"check the path and that the file exists",
			)
		RootCaseMismatch(stored_path):
			with_help(
				"`" + root_request + "` does not match the file's name `" + tables.path_text(
					stored_path,
				) + "`",
				"file names are case-sensitive; write `" + tables.path_text(stored_path) + "`",
			)
		UnverifiableRootSpelling:
			with_help(
				"cannot check the letter case of `" + root_request + "`",
				"a directory on the way to the file could not be listed; check its permissions",
			)
		UnreadableRootSource:
			with_help(
				"cannot read `" + root_request + "`",
				"check that the file exists and that you may read it",
			)
		RootSourceTooLarge(byte_length):
			source_too_large(byte_length)
		RootTooManySources:
			too_many_sources()


---
The text of a diagnostic about an implicit module request. `request_text` is
the name the compiler asks for.
---
private pure func render_implicit(
	diagnostic: ImplicitDiagnostic,
	root_request: String,
) -> RenderedDiagnostic:
	match diagnostic:
		MissingImplicitModule:
			with_help(
				"cannot find implicit module `" + root_request + "`",
				(
					"every compilation loads it from the standard library; check that the standard "
					+ "library is installed and its root is configured"
				),
			)
		UnverifiableImplicitSpelling:
			with_help(
				"cannot check the letter case of implicit module `" + root_request + "`",
				"a directory on the way to the file could not be listed; check its permissions",
			)
		UnreadableImplicitSource:
			with_help(
				"cannot read implicit module `" + root_request + "`",
				"check that the file exists and that you may read it",
			)
		ImplicitSourceTooLarge(byte_length):
			source_too_large(byte_length)
		ImplicitTooManySources:
			too_many_sources()


---
A source too large for its spans, rejected when `byte_length` bytes were read.
---
private pure func source_too_large(byte_length: Int) -> RenderedDiagnostic:
	with_help(
		"source is too large to compile (" + byte_length.to_string() + " bytes)",
		"split it into smaller modules; a source can be at most " + (SPAN_OFFSET_LIMIT - 1).to_string() + " bytes",
	)


---
More sources than a span can number.
---
private pure func too_many_sources() -> RenderedDiagnostic:
	with_help(
		"too many source files in one compilation",
		"a compilation can load at most " + MAX_SOURCE_COUNT.to_string() + " source files; remove unused imports or split the program into packages",
	)


---
The text of a lexer or parser diagnostic with no argument. `span_text` is as in
`render_syntax`.
---
private pure func render_plain_syntax(
	code: PlainSyntaxCode,
	span_text: String,
) -> RenderedDiagnostic:
	match code:
		UnterminatedDocstringDiagnostic:
			with_help(
				"Unterminated docstring: missing closing ---",
				"close the docstring with a line holding only `---`",
			)
		UnterminatedStringDiagnostic:
			with_help(
				"Unterminated string literal: missing closing '\"'",
				"add the closing `\"` before the end of the file",
			)
		MultilineStringDiagnostic:
			with_help(
				"Unterminated string literal. Use aligned pipe strings for multiline text",
				"close the string with `\"` on the same line, or start each line of multiline text with `|`",
			)
		UnterminatedEscapeDiagnostic:
			with_help(
				"unterminated escape sequence",
				"a backslash escapes the next character; write `\\\\` for a backslash",
			)
		UnicodeEscapeDigitCountDiagnostic:
			with_help(
				"Unicode escape \\u{} must contain 1-6 hex digits",
				"write the codepoint in one to six hex digits, as in `\\u{1F600}`",
			)
		UnicodeEscapeNonHexDiagnostic:
			with_help(
				"Unicode escape \\u{} must contain only hex digits",
				"use only the digits 0-9 and the letters a-f, as in `\\u{1F600}`",
			)
		UnterminatedUnicodeEscapeDiagnostic:
			with_help(
				"unterminated Unicode escape",
				"close the escape with `}`, as in `\\u{1F600}`",
			)
		UnicodeCodepointOutOfRangeDiagnostic:
			with_help(
				"Unicode codepoint is out of range or a surrogate",
				(
					"use a codepoint from U+0000 to U+10FFFF that is not a surrogate (U+D800 to "
					+ "U+DFFF)"
				),
			)
		MultilineRawStringDiagnostic:
			with_help(
				"Raw string cannot span multiple lines",
				"close the raw string with `\"` on the same line, or write multiline raw text as `raw` followed by lines starting with `|`",
			)
		UnterminatedRawStringDiagnostic:
			with_help(
				"Unterminated raw string literal: missing closing '\"'",
				"add the closing `\"` before the end of the file",
			)
		InterpolatedEscapeAtEndDiagnostic:
			with_help(
				"unterminated interpolated string",
				"a backslash escapes the next character, and the file ends after it; finish the string with `\"`",
			)
		MultilineInterpolatedStringDiagnostic:
			with_help(
				"Unterminated interpolated string. Use aligned pipe strings for multiline text",
				"close the string with `\"` on the same line, or start each line of multiline text with `|`",
			)
		UnterminatedInterpolatedStringDiagnostic:
			with_help(
				"Unterminated interpolated string: missing closing '\"'",
				"add the closing `\"` before the end of the file",
			)
		InvalidCharLiteralDiagnostic:
			with_help(
				"Invalid character literal: expected single character between quotes",
				(
					"a character literal holds exactly one character, as in `'a'`; use double quotes "
					+ "for a string"
				),
			)
		UnterminatedCharLiteralDiagnostic:
			with_help("unterminated character literal", "close the character literal with `'`")
		UnexpectedCharacterDiagnostic:
			with_help(
				"unexpected character " + character_text(span_text),
				unexpected_character_help(span_text),
			)
		InconsistentIndentationDiagnostic:
			with_help(
				"inconsistent indentation",
				(
					"indent every line of a block by the same amount, and dedent only to the "
					+ "indentation of an enclosing block (a tab counts as 4 columns)"
				),
			)
		ExpectedColonAfterImportDiagnostic:
			with_help(
				"expected `:` after import",
				"write `import:` and indent the imported modules under it",
			)
		ExpectedNewlineAfterImportHeaderDiagnostic:
			with_help(
				"expected newline after import header",
				"put each imported module on its own indented line below `import:`",
			)
		ExpectedIndentedImportsDiagnostic:
			with_help(
				"expected indented imports after `import:`",
				(
					"indent the modules under `import:`, one per line, as in `import:` then `list: "
					+ "List`"
				),
			)
		ExpectedModulePathDiagnostic:
			with_help("expected module path", "write a module path such as `list` or `./helpers`")
		ImportPathCurrentNotLeadingDiagnostic:
			with_help(
				"`.` may only begin an import path",
				"`./` may only start a path; write `./sub/Helper`, not `./sub/./Helper`",
			)
		ImportPathParentNotLeadingDiagnostic:
			with_help(
				"`..` may only begin an import path",
				(
					"`../` may only repeat at the start of a path; write `./shared/Helper`, not `./"
					+ "sub/../shared/Helper`"
				),
			)
		ExpectedImportSymbolDiagnostic:
			with_help(
				"expected import symbol",
				"write the name of a function or type to import; imports list names, not `*`",
			)
		ExpectedCommaBetweenImportSymbolsDiagnostic:
			with_help(
				"expected `, ` between imported symbols",
				"separate imported names with commas",
			)
		ExpectedConstructorNameDiagnostic:
			with_help(
				"expected constructor name",
				"list constructors inside the parentheses, as in `Option(Some, None)`",
			)
		ExpectedClosingParenAfterConstructorsDiagnostic:
			with_help(
				"expected `)` after imported constructors",
				"close the constructor list with `)`",
			)
		ExpectedAliasNameDiagnostic:
			with_help(
				"expected import symbol alias",
				"write the alias name after `as`, as in `list as items`",
			)
		ExpectedImportSymbolsAfterColonDiagnostic:
			with_help(
				"expected import symbols after `:`",
				"write the imported names after `:`, or on indented lines below the module path",
			)
		ExpectedDimensionDiagnostic:
			with_help(
				"expected dimension name or literal after `#`",
				"write a dimension such as `#N`, `#3` or `#_`",
			)
		ExpectedTypeDiagnostic:
			with_help("expected type", "write a type such as `Int` or `List[String]`")
		ArrayDimensionsExpectedDiagnostic:
			with_help(
				"expected array dimensions",
				"generic type arguments belong on the named type before array dimensions",
			)
		TupleArityDiagnostic:
			with_help(
				"Tuples support 2-4 elements",
				"group related values into a record with named fields",
			)
		ExpectedEqualEqualDiagnostic:
			with_help(
				"expected `==` in dimension constraint",
				"write a dimension constraint as `#A == #B`",
			)
		ExpectedHashDiagnostic:
			with_help("expected `#` dimension after `..`", "write a range type as `..#N`")
		AnnotationArgumentsDiagnostic:
			with_help(
				"function annotations do not take arguments",
				"remove the argument list from the function annotation",
			)
		AnnotationWithoutFunctionDiagnostic:
			with_help(
				"function annotations must be followed by a function declaration",
				"move the annotation onto a function declaration, or remove it",
			)
		DocstringBeforeImportBlockDiagnostic:
			with_help(
				"a docstring cannot document an import block",
				(
					"a module docstring must be the first thing in the file, directly before its "
					+ "first `import:` block; move it there or remove it"
				),
			)
		ExpectedDeclarationDiagnostic:
			with_help("expected declaration", "start a function declaration with `func`")
		ForeignFunctionOutsideBlockDiagnostic:
			with_help(
				(
					"foreign declarations must use a foreign: block; write `foreign:` and indent "
					+ "`func ...` inside it"
				),
				"write `foreign:` followed by an indented function signature",
			)
		ExpectedForeignArgumentDiagnostic:
			with_help(
				"expected foreign block argument",
				"omit the parentheses for a foreign block with no arguments",
			)
		ExpectedForeignArgumentValueDiagnostic:
			with_help(
				"expected foreign block argument value",
				"write foreign block arguments as name: \"value\"",
			)
		ExpectedForeignFunctionDiagnostic:
			with_help(
				"expected foreign function declaration",
				"write a bodyless function signature inside the foreign block",
			)
		ExpectedForeignCNameDiagnostic:
			with_help(
				"expected foreign C function name",
				"write = \"c_function_name\" or omit the C name to use the Blorp name",
			)
		ExpectedCleanupBuiltinNameDiagnostic:
			with_help(
				"expected resource cleanup builtin name",
				"write resource type Name = builtin(\"cleanup_function\")",
			)
		BuiltinTypeArgumentsDiagnostic:
			with_help(
				"builtin type declarations do not take arguments",
				"use `resource type Name = builtin(\"cleanup\")` for resource cleanup metadata",
			)
		ExpectedSupertraitOrMethodsDiagnostic:
			with_help(
				"expected supertrait or trait method block",
				(
					"indent the trait's methods under `trait Name:`, or name supertraits after the "
					+ "colon"
				),
			)
		ExpectedImplMethodDiagnostic:
			with_help(
				"expected implementation method",
				"write a function declaration inside the implements block",
			)
		ExpectedExpressionDiagnostic:
			with_help("expected expression", "write a value, a name or a call here")
		ExpectedPatternDiagnostic:
			with_help(
				"expected pattern",
				"write a pattern for the match arm: a name, a literal, `_` or a variant",
			)
		ExpectedNumberAfterMinusDiagnostic:
			with_help(
				"expected numeric literal after `-` in pattern",
				"write a number such as `-1`, or remove the `-`",
			)
		ExpectedSpreadTargetDiagnostic:
			with_help(
				"expected list pattern spread target",
				"write a name or `_` after `...`, as in `[first, ...rest]`",
			)
		ExpectedAssignmentOperatorDiagnostic:
			with_help(
				"expected assignment operator",
				"write `=`, `?=` or a compound assignment such as `+=` after the name",
			)
		DiscardedQuestionBindDiagnostic:
			with_help("`?=` cannot bind to `_`", "use a name for the unwrapped value")
		FieldAssignmentDiagnostic:
			with_help(
				"field assignment is not supported",
				"use record update syntax: { record | field = value }",
			)
		AssignmentInConditionDiagnostic:
			with_help(
				"a condition cannot be an assignment",
				"use `==` to compare, or assign on its own line before the condition",
			)
		AssignmentInExpressionDiagnostic:
			with_help(
				"an assignment is a statement, not an expression",
				"assign on its own line first, then use the name where the value is needed",
			)
		ExpectedBuiltinNameDiagnostic:
			with_help(
				"expected builtin name",
				"write builtin(\"runtime_helper_name\") or bare builtin",
			)
		RemovedTypeAscriptionDiagnostic:
			with_help(
				"type ascription with `as` was removed",
				(
					"annotate the binding instead: `total: Int32 = 3`, or pass the value where the "
					+ "parameter type fixes it"
				),
			)
		ExpectedConcurrentParameterDiagnostic:
			with_help(
				"expected concurrent parameter",
				"omit the parentheses for a concurrent block with no parameters",
			)
		ConcurrentForTupleBinderDiagnostic:
			with_help(
				"`for ... concurrently` requires a single loop variable",
				"write `for item in items concurrently(limit: N):`",
			)
		ConcurrentForMaxThreadsDiagnostic:
			with_help(
				"unknown concurrently parameter `max_threads` (expected `limit` or `timeout`)",
				(
					"use `limit: N` in `concurrently(...)`; `max_threads` is only valid on "
					+ "`concurrent(...)` blocks"
				),
			)
		ConcurrentMaxThreadsNotPositiveLiteralDiagnostic:
			with_help(
				"`max_threads` must be a positive integer literal, at most " + INT_MAX_DECIMAL,
				"write `concurrent(max_threads: 4):`",
			)
		ConcurrentLimitNotPositiveLiteralDiagnostic:
			with_help(
				"`limit` must be a positive integer literal, at most " + INT_MAX_DECIMAL,
				"write `concurrently(limit: 4)`",
			)
		ConcurrentForMissingLimitDiagnostic:
			with_help(
				"`for ... concurrently(...)` requires `limit: N`",
				"write `concurrently(limit: 4)`; `limit` is the maximum number of items in flight",
			)
		WithMultipleBindingsDiagnostic:
			with_help(
				(
					"Multiple resource bindings in one `with` header are not supported yet. Nested "
					+ "`with` blocks make resource close order explicit."
				),
				"use nested `with` blocks to make resource close order explicit",
			)
		InterpolationHoleNotExpressionDiagnostic:
			with_help(
				"an interpolation hole must hold exactly one expression",
				"write one expression between `$" + "{` and `}`; move other code out of the string",
			)
		InterpolatedStringPatternDiagnostic:
			with_help(
				"a string with `$" + "{...}` holes cannot be a match pattern",
				"match the plain string, or bind it and compare with `==` in the arm",
			)
		QuestionBindInLoopDiagnostic:
			with_help(
				"`?=` cannot be used inside a loop body",
				"bind it before the loop, or use `match` inside the loop",
			)
		BreakOutsideLoopDiagnostic:
			with_help(
				"`break` can only be used inside a loop",
				"move `break` into a `while` or `for` body, or remove it",
			)
		ContinueOutsideLoopDiagnostic:
			with_help(
				"`continue` can only be used inside a loop",
				"move `continue` into a `while` or `for` body, or remove it",
			)
		InterpolationTooDeepDiagnostic:
			with_help(
				"string interpolation nested too deeply",
				"interpolation holes can nest at most " + MAX_INTERPOLATION_DEPTH.to_string() + " deep; move the inner expression into a named binding",
			)
		MissingFunctionBodyDiagnostic:
			with_help(
				"function has no body",
				(
					"a function body must have at least one expression or statement, indented on the "
					+ "lines below the header; write `void` for a body that does nothing"
				),
			)
		UnpairedForwardDeclarationDiagnostic:
			with_help(
				"function has no body",
				(
					"a function body must have at least one expression or statement (`void` does "
					+ "nothing); a header with no body is a forward declaration, which needs a "
					+ "function of the same name with a body"
				),
			)
		UnionVariantTooManyFieldsDiagnostic:
			with_help(
				"Union variants support at most " + MAX_UNION_VARIANT_FIELDS.to_string() + " fields",
				"group related fields into a record and use the record as one field",
			)
		DiscardedCompoundAssignmentDiagnostic:
			with_help(
				"compound assignment cannot update `_`",
				"name the variable you are updating, such as `total += value`; `_` only discards a value",
			)
		EnumCaseParenthesesDiagnostic:
			with_help(
				"an `enum` case is only a name",
				"remove the parentheses, or write `union` instead of `enum` for cases that carry values",
			)
		BoundInTypeDiagnostic:
			with_help(
				"a bound cannot be written inside a type",
				"declare the type parameter with its bounds in brackets, such as `func show[T: Equatable](x: T)`",
			)
		DimensionParameterBoundsDiagnostic:
			with_help(
				"a dimension parameter cannot have trait bounds",
				"remove the bounds: a dimension is a number, so only type parameters such as `T: Equatable` take them",
			)


---
The text of a diagnostic that says which construct the parser was in.
---
private pure func render_expected_token(expected: ExpectedTokenDiagnostic) -> RenderedDiagnostic:
	match expected:
		ExpectedName(construct):
			with_help(
				expected_name_text(construct),
				(
					"write an identifier here; it starts with a letter or `_` and is not a reserved "
					+ "keyword"
				),
			)
		ExpectedColon(construct):
			with_help(
				expected_colon_text(construct),
				(
					"a block header ends with `:` before its indented body, as in `if condition:` or "
					+ "`func name() -> Type:`"
				),
			)
		ExpectedComma(construct):
			with_help(expected_comma_text(construct), "separate the items with commas")
		ExpectedLeftParen(construct):
			with_help(expected_left_paren_text(construct), left_paren_help(construct))
		ExpectedRightParen(construct):
			with_help(
				expected_right_paren_text(construct),
				"close the parenthesis opened earlier with `)`",
			)
		ExpectedRightBracket(construct):
			with_help(
				expected_right_bracket_text(construct),
				"close the bracket opened earlier with `]`",
			)
		ExpectedLeftBrace(construct):
			with_help(expected_left_brace_text(construct), "write the fields inside braces")
		ExpectedRightBrace(construct):
			with_help(
				expected_right_brace_text(construct),
				"close the brace opened earlier with `}`",
			)
		ExpectedArrow(construct):
			with_help(expected_arrow_text(construct), "write `->` before the return type")
		ExpectedEqual(construct):
			with_help(expected_equal_text(construct), "write `=` between the name and its value")
		ExpectedNewline(construct):
			with_help(
				expected_newline_text(construct),
				"start the next statement or item on its own line",
			)
		ExpectedIndent(construct):
			with_help(
				expected_indent_text(construct),
				"indent the lines of the block under its header",
			)
		ExpectedKeyword(construct):
			with_help(
				expected_keyword_text(construct),
				(
					"a keyword is missing or misspelled: `in` follows a loop variable, `from` "
					+ "follows a select receive binding and `func` starts a function"
				),
			)
		ExpectedFatArrow(construct):
			with_help(
				expected_fat_arrow_text(construct),
				"write `=>` between the pattern and its result",
			)
