---
The text a discovery diagnostic shows: its message and, when the error has a
correction to teach, a help line. Arguments are read from the row's argument
block per the code's documented meaning; names and literals are spelled from
the frozen tables.
---
record RenderedDiagnostic {
	message: String,
	help: Option[String]
}


---
The printable ASCII range: a byte in it is quoted as itself.
---
private FIRST_PRINTABLE_ASCII: Int = 33

private LAST_PRINTABLE_ASCII: Int = 126

---
Codepoints a quoted character would hide: controls, no-break and zero-width
spaces, bidirectional controls, joiners and the byte order mark. They are
spelled `U+XXXX` instead. Each pair is an inclusive range.
---
private INVISIBLE_CODEPOINT_RANGES: List[(Int, Int)] = [
	(0, 32),
	(127, 160),
	(173, 173),
	(8192, 8207),
	(8232, 8238),
	(8288, 8303),
	(65279, 65279),
]

---
Hexadecimal digits a codepoint or a byte is padded to.
---
private CODEPOINT_HEX_WIDTH: Int = 4

private BYTE_HEX_WIDTH: Int = 2


---
The rendered text of a diagnostic row: its message and help, without the
position (see `diagnostic_display`).
---
pure func render_diagnostic(tables: FrontendTables, row: DiagnosticRow) -> RenderedDiagnostic:
	tables.render_code(
		row.code,
		tables.diagnostic_arguments_of(row.arguments),
		"",
		tables.span_text(row.span),
	)


---
The rendered text of a root request that loaded no module. A root names its
source by path and its row has no span, so there is no position to show.
---
pure func render_root_diagnostic(
	tables: FrontendTables,
	row: RootDiagnosticRow,
) -> RenderedDiagnostic:
	tables.render_code(
		row.code,
		tables.diagnostic_arguments_of(row.arguments),
		tables.path_text(tables.root_row(row.root).request_path),
		"",
	)


---
The rendered text of an implicit module that loaded no module. Like a root,
its row has no span; it names the module by the name the compiler asks for.
---
pure func render_implicit_diagnostic(
	tables: FrontendTables,
	row: ImplicitDiagnosticRow,
) -> RenderedDiagnostic:
	tables.render_code(
		row.code,
		tables.diagnostic_arguments_of(row.arguments),
		tables.path_text(tables.implicit_request_row(row.request).request_path),
		"",
	)


---
The path a diagnostic names a source by: for the module a root loaded, the path
as the caller gave the root (the user wrote it, so they recognize it); for any
other module, its canonical path.
---
private pure func source_display_path(tables: FrontendTables, source: SourceId) -> String:
	var shown: String = tables.path_text(tables.source_row(source).path)

	for index in 0..tables.root_count():
		root = root_id_at_row(index)

		match tables.root_target(root):
			Some(module):
				if tables.module_row(module).source.source_id_index() == source.source_id_index():
					shown = tables.path_text(tables.root_row(root).request_path)
					break
			None:
				void

	shown


---
`path:line:column: error: message`, then `help: ...` on its own line: the
shape the existing compiler prints. The column counts bytes, with a tab
advancing to the next multiple of four, as the existing compiler's does.
---
pure func diagnostic_display(tables: FrontendTables, row: DiagnosticRow) -> String:
	rendered: RenderedDiagnostic = tables.render_diagnostic(row)
	position: LineColumn = tables.span_line_column(row.span)
	source_path: String = tables.source_display_path(source_id_at_row(row.span.span_source_index()))
	first_line: String = source_path + ":" + (position.line + 1).to_string() + ":" + position.column.to_string() + ": error: " + rendered.message

	match rendered.help:
		Some(help):
			first_line + "\nhelp: " + help
		None:
			first_line


-- Reading arguments and spans.
private pure func span_text(tables: FrontendTables, span: Span) -> String:
	tables
		.source_text(source_id_at_row(span.span_source_index()))
		.substring(span.span_start(), span.span_length())


---
Reading arguments. `freeze` rejects a row whose arguments differ in number
from `diagnostic_argument_count(code)` or name nothing, so rendering reads
exactly the documented ones: the `0` an absent ordinal would read as is never
seen.
---
private pure func argument_at(arguments: List[Int], ordinal: Int) -> Int:
	arguments.get_or(ordinal, 0)


private pure func argument_text(arguments: List[Int], ordinal: Int) -> String:
	argument_at(arguments, ordinal).to_string()


private pure func import_written(tables: FrontendTables, arguments: List[Int]) -> String:
	tables.path_text(tables.import_row(import_id_at_row(argument_at(arguments, 0))).request_path)


---
The spelling of the name the first argument indexes.
---
private pure func name_written(tables: FrontendTables, arguments: List[Int]) -> String:
	tables.name_spelling(name_id_at_row(argument_at(arguments, 0)))


private pure func stored_names_text(
	tables: FrontendTables,
	arguments: List[Int],
	ordinal: Int,
) -> String:
	tables.path_text(path_id_at_row(argument_at(arguments, ordinal)))


private pure func respelled_import(tables: FrontendTables, arguments: List[Int]) -> String:
	respelled_import_text(
		tables.import_written(arguments),
		tables
			.stored_names_text(arguments, 1)
			.split("/"),
	)


private pure func literal_digits(tables: FrontendTables, arguments: List[Int]) -> String:
	tables.literal_text(literal_id_at_row(argument_at(arguments, 0)))


-- Spelling bytes and characters.
---
The construct the first argument stands for. `freeze` rejects a row of an
`Expected...` code whose argument names none, and only those codes' arms call
this, so the fallback (the first variant) is never seen.
---
private pure func construct_argument(arguments: List[Int]) -> ParsedConstruct:
	match parsed_construct_at_argument(argument_at(arguments, 0)):
		Some(construct):
			construct
		None:
			FunctionBody


private pure func is_printable_ascii(value: Int) -> Bool:
	value >= FIRST_PRINTABLE_ASCII and value <= LAST_PRINTABLE_ASCII


private pure func hex_digits(value: Int, width: Int) -> String:
	value
		.to_hex()
		.upper()
		.pad_left(width, '0')


private pure func byte_hex(arguments: List[Int]) -> String:
	"0x" + hex_digits(
		arguments.get_or(0, 0),
		BYTE_HEX_WIDTH,
	)


---
The character after a backslash that names no escape: itself when printable
ASCII, else its byte.
---
private pure func escaped_byte_text(arguments: List[Int]) -> String:
	value: Int = arguments.get_or(0, 0)

	if is_printable_ascii(value):
		from_char(to_char(value))
	else:
		"x" + hex_digits(value, BYTE_HEX_WIDTH)


private pure func is_invisible(codepoint: Int) -> Bool:
	INVISIBLE_CODEPOINT_RANGES.any(
		pure func(range): codepoint >= range[0] and codepoint <= range[1],
	)


---
`'c'` for a visible character; `U+XXXX` for one a quote would hide.
---
private pure func character_text(text: String) -> String:
	codepoint: Int = text
		.codepoints()
		.get_or(0, 0)

	if is_invisible(codepoint):
		"U+" + hex_digits(codepoint, CODEPOINT_HEX_WIDTH)
	else:
		"'" + text + "'"


private pure func unexpected_character_help(text: String) -> String:
	match text:
		"&":
			"Blorp writes boolean operators as words: use `and`, `or` and `not`"
		"!":
			"Blorp writes boolean negation as `not`, and inequality as `!=`"
		_:
			"remove it, or put it inside a string literal if it is text"


private pure func with_help(message: String, help: String) -> RenderedDiagnostic:
	{
		message = message,
		help = Some(help)
	}


-- Text of the codes that say which construct was being parsed.
---
The message when the parser was in `construct`. A construct not listed reads
as the code's general text, which is the intended text for it.
---
private pure func expected_colon_text(construct: ParsedConstruct) -> String:
	match construct:
		FunctionBody:
			"expected `:` before function body"
		FieldName:
			"expected `:` after field name"
		UnionVariants:
			"expected `:` before variants"
		TraitName:
			"expected `:` after trait name"
		ImplementationMethods:
			"expected `:` before implementation methods"
		ForeignHeader:
			"expected `:` after foreign"
		ForeignBlockArgumentName:
			"expected `:` after foreign block argument name"
		WhileCondition:
			"expected `:` after while condition"
		IfCondition:
			"expected `:` after if condition"
		ElseBranch:
			"expected `:` after else"
		MatchExpression:
			"expected `:` after match expression"
		MatchPattern:
			"expected `:` after match pattern"
		SelectHeader:
			"expected `:` after select"
		SelectReceiveChannel:
			"expected `:` after select receive channel"
		SealedSelectChannel:
			"expected `:` after sealed select channel"
		SelectTimeout:
			"expected `:` after select timeout"
		ForIterable:
			"expected `:` after for loop iterable"
		ConcurrentNamedParameter:
			"expected `:` after concurrent parameter name"
		ConcurrentBlock:
			"expected `:` after concurrent"
		ConcurrentlyParameters:
			"expected `:` after concurrently parameters"
		DebugBlock:
			"expected `:` after debug"
		WithBinding:
			"expected `:` after with binding"
		LambdaBody:
			"expected `:` before lambda body"
		_:
			"expected `:`"


---
The message when the parser was in `construct`. A construct not listed reads
as the code's general text, which is the intended text for it.
---
private pure func expected_comma_text(construct: ParsedConstruct) -> String:
	match construct:
		TuplePatternItems:
			"expected `, ` between tuple pattern items"
		ForeignBlockArguments:
			"expected `, ` between foreign block arguments"
		TupleDestructuringNames:
			"expected `, ` between tuple destructuring names"
		TupleLoopVariables:
			"expected `, ` between tuple loop variables"
		ConcurrentParameters:
			"expected `, ` between concurrent parameters"
		_:
			"expected `,`"


---
The message when the parser was in `construct`. A construct not listed reads
as the code's general text, which is the intended text for it.
---
private pure func expected_left_paren_text(construct: ParsedConstruct) -> String:
	match construct:
		FunctionName:
			"expected `(` after function name"
		TraitMethodName:
			"expected `(` after trait method name"
		ForeignFunctionName:
			"expected `(` after foreign function name"
		PureFunctionType:
			"expected `(` after `pure` in function type"
		ConcurrentlyHeader:
			"expected `(` after concurrently"
		LambdaFunc:
			"expected `(` after lambda `func`"
		OpaqueConversionType:
			"expected `(` after opaque conversion type"
		_:
			"expected `(`"


---
The message when the parser was in `construct`. A construct not listed reads
as the code's general text, which is the intended text for it.
---
private pure func expected_right_paren_text(construct: ParsedConstruct) -> String:
	match construct:
		ConstructorPattern:
			"expected `)` after constructor pattern"
		TuplePattern:
			"expected `)` after tuple pattern"
		VariantFields:
			"expected `)` after variant fields"
		ResourceCleanupBuiltinName:
			"expected `)` after resource cleanup builtin name"
		ForeignBlockArguments:
			"expected `)` after foreign block arguments"
		GroupedType:
			"expected `)` after type"
		FunctionTypeParameters:
			"expected `)` after function type parameters"
		DimensionExpression:
			"expected `)` after dimension expression"
		FunctionParameters:
			"expected `)` after function parameters"
		TupleParameterNames:
			"expected `)` after tuple parameter names"
		TupleDestructuringNames:
			"expected `)` after tuple destructuring names"
		TupleLoopVariables:
			"expected `)` after tuple loop variables"
		ConcurrentParameters:
			"expected `)` after concurrent parameters"
		ConcurrentlyParameters:
			"expected `)` after concurrently parameters"
		LambdaParameters:
			"expected `)` after lambda parameters"
		CallArguments:
			"expected `)` after call arguments"
		OpaqueConversionValue:
			"expected `)` after opaque conversion value"
		BuiltinName:
			"expected `)` after builtin name"
		TupleExpression:
			"expected `)` after tuple expression"
		GroupedExpression:
			"expected `)` after expression"
		_:
			"expected `)`"


---
The message when the parser was in `construct`. A construct not listed reads
as the code's general text, which is the intended text for it.
---
