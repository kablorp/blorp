-- What the lexer produces: one module's tokens and everything its tokens refer
-- to, as plain values (`docs/DISCOVERY_REDESIGN.md`, section 2.3).
--
-- Nothing here is a builder row or a program-wide id. A token's payload is an
-- index into these lists, or a spelling's index in `LexedModule.spellings`,
-- so the lexed module of one text is the same whatever was lexed before it.
-- The builder-based parser still reads the builder's tables; `lexed_bridge`
-- (in `parse/`) copies a `LexedModule` into them, and goes when the parser
-- reads trees.
import:
	../syntax/checked_values: DecimalFloat
	../syntax/spellings: Spellings
	../tables/ids: ModuleId
	../tables/rows: SyntaxDiagnosticAt
	../tables/span: Span
	../tables/token: Token


---
The checked value of one literal token (`docs/DISCOVERY_REDESIGN.md`, section
5.2). A character literal has none: its token carries its codepoint.

- `IntegerValue`: the magnitude, at most the Int128 maximum. A leading `-` is
  a unary operator or a pattern's sign.
- `FloatValue`: the digits of a float literal that is finite as a `Float`.
- `TextValue`: a string literal's, raw string's, pipe string's or docstring's
  text, with escapes applied and lines joined.

An integer literal above the Int128 maximum, or a float literal that is not
finite, has no value: its token is `RejectedIntegerToken` or
`RejectedFloatToken` with no payload, and the lexer's diagnostic holds its
digits. So an `IntLiteralToken` always indexes an `IntegerValue` and a
`FloatLiteralToken` a `FloatValue`.
---
union LiteralValue:
	IntegerValue(Int128)
	FloatValue(DecimalFloat)
	TextValue(String)


---
A hole of an interpolated string: its bytes `expression_start ..
expression_end` between `${` and `}`, and `span`, which covers the `${` and
the `}` too.
---
record HoleScan {
	expression_start: Int,
	expression_end: Int,
	span: Span
}


---
A text piece of an interpolated string: its decoded text and the span of the
source bytes it was read from, which its syntax node keeps until the tree
parser replaces that node. The span goes in M4, with that node: the tree
parser reads the text only.
---
record TextScan {
	text: String,
	span: Span
}


---
One piece of an interpolated string, in source order.
---
union ScannedPiece:
	ScannedText(TextScan)
	ScannedHole(HoleScan)


---
The pieces of one interpolated string, scanned once by the lexer.
---
record InterpolationScan {
	pieces: List[ScannedPiece]
}


---
What the parser reads but never changes: the text (for hole lexing), the
literal values (by literal token) and the pieces of each interpolated string.
A literal token's payload is its index in `literals`; an interpolated string
token's is its index in `interpolations`.
---
record LexedSource {
	text: String,
	literals: List[LiteralValue],
	interpolations: List[InterpolationScan]
}


---
The lexer's product for one module: its tokens, its interned spellings, its
checked literal values, the pieces of each interpolated string, its line
starts and its lexer diagnostics. An identifier or dimension name token's
payload is the index of its spelling in `spellings`.
---
record LexedModule {
	module: ModuleId,
	source: LexedSource,
	tokens: List[Token],
	spellings: Spellings,
	line_starts: List[Int],
	diagnostics: List[SyntaxDiagnosticAt]
}


---
Tokens lexed from one range of a module's text, with what they refer to. A
module is one run over its whole text; an interpolation hole is another,
over the hole's bytes, ending in its own end-of-file token. `spellings` is
the module's spellings after the run, since the run may have added to them;
`literals` and `interpolations` belong to this run alone, so a literal
token's payload indexes the run's own list.
---
record LexedRun {
	spellings: Spellings,
	tokens: List[Token],
	literals: List[LiteralValue],
	interpolations: List[InterpolationScan],
	diagnostics: List[SyntaxDiagnosticAt]
}
