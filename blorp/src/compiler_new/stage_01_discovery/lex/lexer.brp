-- The discovery lexer: one module's text into a `LexedModule`, a pure function
-- of the module's id and text.
--
-- It reproduces the existing compiler's lexer token for token (kinds, spans,
-- indentation, newline and lambda-body rules), with these differences in what
-- it records rather than what it recognizes: a `#` directly followed by a
-- name is one `DimensionNameToken` over the plain name (the existing lexer
-- emits `#` and the name); comments are skipped instead of kept as trivia,
-- since nothing reads them; literals are checked values (`LiteralValue`) in
-- the module's own lists instead of texts in a shared table; names are
-- spellings of the module's own `Spellings`; and diagnostics are coded values
-- instead of rendered messages.
--
-- This module holds the scan loop, symbols and numbers; `layout` decides what
-- a new line does, and `string_literals`, `interpolation` and `char_literals`
-- scan the literals.
--
-- The source is scanned by byte offset. Columns are not tracked: only a pipe
-- string's margin needs one, and it is computed from the line start then.
import:
	../syntax/ids: spelling_index
	../tables/intern_index: INITIAL_SLOT_COUNT, find_slice, slice_hash, slots_for_texts
	../tables/name_vocabulary: SEEDED_NAME_SPELLINGS
	../syntax/checked_values: DecimalFloat, checked_integer, decimal_float
	../syntax/spellings:
		Spellings,
		interned_spelling,
		new_spellings,
	../tables/diagnostic_code:
		PlainSyntaxCode(InconsistentIndentationDiagnostic, UnexpectedCharacterDiagnostic),
		SyntaxDiagnostic(FloatLiteralOverflow, IntegerLiteralOverflow, Plain, UnexpectedByte),
	../tables/ids: ModuleId, SourceId, module_id_index, source_id_at_row
	../tables/rows: SyntaxDiagnosticAt
	../tables/source_position: column_at
	../tables/span: pack_span
	../tables/token:
		FIRST_KEYWORD_NAME_INDEX,
		GroupDelimiter(ClosesGroup, NotGroupDelimiter, OpensGroup),
		KEYWORD_KINDS_IN_SEEDED_ORDER,
		NO_TOKEN_PAYLOAD,
		Token,
		TokenKind(
			ArrowSymbol, AtSymbol, CharLiteralToken, ColonSymbol, CommaSymbol, DedentToken,
			DimensionNameToken, DocStringToken, DotDotDotSymbol, DotDotSymbol, DotSymbol,
			EndOfFileToken, EqualEqualSymbol, EqualSymbol, FatArrowSymbol, FloatLiteralToken,
			GreaterEqualSymbol, GreaterSymbol, HashSymbol, IdentifierToken, IndentToken,
			IntLiteralToken, InterpolatedStringToken, LeftBraceSymbol, LeftBracketSymbol,
			LeftParenSymbol, LessEqualSymbol, LessSymbol, MinusEqualSymbol, MinusSymbol,
			NewlineToken, NormalStringToken, NotEqualSymbol, PercentSymbol, PipeSymbol,
			PlusEqualSymbol, PlusSymbol, QuestionEqualsSymbol, RejectedFloatToken,
			RejectedIntegerToken, RightBraceSymbol, RightBracketSymbol, RightParenSymbol,
			SlashEqualSymbol, SlashSymbol, StarEqualSymbol, StarSymbol, UnderscoreSymbol,
		),
		group_delimiter,
	char_literals: scan_char_literal
	interpolation: InterpolationSegment, interpolation_scan, interpolation_segments
	layout:
		DedentOutcome(DedentedBetweenLevels),
		LayoutStacks,
		LineStartPlan,
		TOP_LEVEL_INDENT,
		initial_layout,
		newline_is_insignificant,
		opens_lambda_body,
		plan_line_start,
		top_indent,
		with_indent_popped,
		with_lambda_opened,
		with_line_start_applied,
	lexed_module:
		InterpolationScan,
		LexedModule,
		LexedRun,
		LiteralValue(FloatValue, IntegerValue, TextValue),
	scan_support:
		LiteralScan,
		ScanStop(StoppedAfterNewline),
		ScannedLiteral(CodepointLiteral, InterpolatedLiteral, NoLiteral, TextLiteral),
		after_blanks,
		byte_at,
		failed_scan,
		identifier_end,
		indent_width,
		is_digit_byte,
		is_identifier_continue,
		is_identifier_start,
		line_end,
		line_starts_of,
		text_at,
	string_literals:
		NO_PLAIN_STRING_CLOSE,
		docstring_fence_at,
		plain_string_close,
		raw_pipe_marker_after,
		raw_word_at,
		scan_docstring,
		scan_pipe_block,
		scan_raw_string_literal,
		scan_string_literal,


-- UTF-8 lead and continuation byte bounds: bytes below
-- `UTF8_FIRST_MULTIBYTE` are ASCII; two-, three- and four-byte leads start at
-- the named values (the leads RFC 3629 allows: overlong two-byte leads
-- 0xC0-0xC1 and leads above U+10FFFF are excluded); continuations lie in
-- 0x80-0xBF. As in the existing lexer, the second byte of a three- or
-- four-byte sequence is only checked to be a continuation byte, so the few
-- overlong and surrogate encodings RFC 3629 rules out there (E0 80-9F,
-- ED A0-BF, F0 80-8F, F4 90-BF) are taken as one character. Such a byte only
-- ever ends up in an unexpected-character diagnostic's span.
private UTF8_FIRST_MULTIBYTE: Int = 128

private UTF8_FIRST_TWO_BYTE_LEAD: Int = 194

private UTF8_LAST_TWO_BYTE_LEAD: Int = 223

private UTF8_FIRST_THREE_BYTE_LEAD: Int = 224

private UTF8_LAST_THREE_BYTE_LEAD: Int = 239

private UTF8_FIRST_FOUR_BYTE_LEAD: Int = 240

private UTF8_LAST_FOUR_BYTE_LEAD: Int = 244

private UTF8_FIRST_CONTINUATION: Int = 128

private UTF8_LAST_CONTINUATION: Int = 191


-- Numbers and symbols.
---
Digits with at most one `.` that is followed by a digit.
---
private fixed record NumberScan {
	end: Int,
	saw_dot: Bool
}


private pure func scan_number(text: String, offset: Int) -> NumberScan:
	length: Int = text.length()
	var position: Int = offset
	var saw_dot: Bool = False

	while position < length:
		c: Char = byte_at(text, position)

		if is_digit_byte(c):
			position += 1
		else if (
			c == '.'
			and not saw_dot
			and position + 1 < length
			and is_digit_byte(byte_at(text, position + 1))
		):
			saw_dot = True
			position += 1
		else:
			break

	{
		end = position,
		saw_dot = saw_dot
	}


---
What checking a scanned number found: a value within the language's range, or
the digits of a literal outside it (an integer above the Int128 maximum, a
float that is not finite).
---
private union CheckedNumber:
	AcceptedInteger(Int128)
	AcceptedFloat(DecimalFloat)
	RejectedInteger(String)
	RejectedFloat(String)


---
Checks the number `scan` found at `offset` of `text`.
---
private pure func checked_number(text: String, offset: Int, scan: NumberScan) -> CheckedNumber:
	if scan.saw_dot:
		digits: String = text.substring(offset, scan.end - offset)

		match decimal_float(digits):
			Some(value):
				AcceptedFloat(value)
			None:
				RejectedFloat(digits)
	else:
		match checked_integer(text, offset, scan.end):
			Some(value):
				AcceptedInteger(value)
			None:
				RejectedInteger(text.substring(offset, scan.end - offset))


private fixed record SymbolMatch {
	kind: TokenKind,
	width: Int
}


---
What `symbol_at` returns for a byte `starts_symbol` rejects; never used.
---
private UNREACHABLE_SYMBOL_MATCH: SymbolMatch = {
	kind = EndOfFileToken,
	width = 1
}


---
Whether a symbol starts at `offset`. Checked before `symbol_at` so the
matching result needs no additional `Option` wrapper.
---
private pure func starts_symbol(text: String, offset: Int) -> Bool:
	c: Char = byte_at(text, offset)

	if c == '!' or c == '?':
		offset + 1 < text.length() and byte_at(text, offset + 1) == '='
	else:
		match c:
			'-' | '=' | '<' | '>' | '.' | '+' | '*' | '/' | '(' | ')' | '[' | ']' | '{' | '}' | ':' | ',' | '_' | '%' | '#' | '@' | '|':
				True
			_:
				False


---
The symbol at `offset`, longest first. Only called where `starts_symbol`
holds; the fallback for any other byte is unreachable.
---
private pure func symbol_at(text: String, offset: Int) -> SymbolMatch:
	next: Char = byte_at(text, offset + 1)
	has_next: Bool = offset + 1 < text.length()
	next_is_equal: Bool = has_next and next == '='

	match byte_at(text, offset):
		'-':
			if has_next and next == '>':
				{
					kind = ArrowSymbol,
					width = 2
				}
			else if next_is_equal:
				{
					kind = MinusEqualSymbol,
					width = 2
				}
			else:
				{
					kind = MinusSymbol,
					width = 1
				}
		'=':
			if has_next and next == '>':
				{
					kind = FatArrowSymbol,
					width = 2
				}
			else if next_is_equal:
				{
					kind = EqualEqualSymbol,
					width = 2
				}
			else:
				{
					kind = EqualSymbol,
					width = 1
				}
		'<':
			if next_is_equal:
				{
					kind = LessEqualSymbol,
					width = 2
				}
			else:
				{
					kind = LessSymbol,
					width = 1
				}
		'>':
			if next_is_equal:
				{
					kind = GreaterEqualSymbol,
					width = 2
				}
			else:
				{
					kind = GreaterSymbol,
					width = 1
				}
		'!':
			if next_is_equal:
				{
					kind = NotEqualSymbol,
					width = 2
				}
			else:
				UNREACHABLE_SYMBOL_MATCH
		'?':
			if next_is_equal:
				{
					kind = QuestionEqualsSymbol,
					width = 2
				}
			else:
				UNREACHABLE_SYMBOL_MATCH
		'.':
			if text_at(text, offset, "..."):
				{
					kind = DotDotDotSymbol,
					width = 3
				}
			else if has_next and next == '.':
				{
					kind = DotDotSymbol,
					width = 2
				}
			else:
				{
					kind = DotSymbol,
					width = 1
				}
		'+':
			if next_is_equal:
				{
					kind = PlusEqualSymbol,
					width = 2
				}
			else:
				{
					kind = PlusSymbol,
					width = 1
				}
		'*':
			if next_is_equal:
				{
					kind = StarEqualSymbol,
					width = 2
				}
			else:
				{
					kind = StarSymbol,
					width = 1
				}
		'/':
			if next_is_equal:
				{
					kind = SlashEqualSymbol,
					width = 2
				}
			else:
				{
					kind = SlashSymbol,
					width = 1
				}
		'(':
			{
				kind = LeftParenSymbol,
				width = 1
			}
		')':
			{
				kind = RightParenSymbol,
				width = 1
			}
		'[':
			{
				kind = LeftBracketSymbol,
				width = 1
			}
		']':
			{
				kind = RightBracketSymbol,
				width = 1
			}
		'{':
			{
				kind = LeftBraceSymbol,
				width = 1
			}
		'}':
			{
				kind = RightBraceSymbol,
				width = 1
			}
		':':
			{
				kind = ColonSymbol,
				width = 1
			}
		',':
			{
				kind = CommaSymbol,
				width = 1
			}
		'_':
			{
				kind = UnderscoreSymbol,
				width = 1
			}
		'%':
			{
				kind = PercentSymbol,
				width = 1
			}
		'#':
			{
				kind = HashSymbol,
				width = 1
			}
		'@':
			{
				kind = AtSymbol,
				width = 1
			}
		'|':
			{
				kind = PipeSymbol,
				width = 1
			}
		_:
			UNREACHABLE_SYMBOL_MATCH


private pure func group_depth_after(depth: Int, kind: TokenKind) -> Int:
	match kind.group_delimiter():
		OpensGroup:
			depth + 1
		ClosesGroup:
			max(depth - 1, 0)
		NotGroupDelimiter:
			depth


---
Continuation bytes after a UTF-8 lead byte, or `None` for a byte that starts
no sequence.
---
private pure func utf8_continuation_count(lead: Int) -> Option[Int]:
	if lead < UTF8_FIRST_MULTIBYTE:
		Some(0)
	else if lead >= UTF8_FIRST_TWO_BYTE_LEAD and lead <= UTF8_LAST_TWO_BYTE_LEAD:
		Some(1)
	else if lead >= UTF8_FIRST_THREE_BYTE_LEAD and lead <= UTF8_LAST_THREE_BYTE_LEAD:
		Some(2)
	else if lead >= UTF8_FIRST_FOUR_BYTE_LEAD and lead <= UTF8_LAST_FOUR_BYTE_LEAD:
		Some(3)
	else:
		None


---
The byte width of the complete UTF-8 sequence at `offset`, or `None` when
the bytes there are not one.
---
private pure func utf8_sequence_width(text: String, offset: Int) -> Option[Int]:
	match utf8_continuation_count(to_int(byte_at(text, offset))):
		Some(continuations):
			var complete: Bool = offset + continuations < text.length()
			var index: Int = 1

			while complete and index <= continuations:
				value: Int = to_int(byte_at(text, offset + index))

				if value < UTF8_FIRST_CONTINUATION or value > UTF8_LAST_CONTINUATION:
					complete = False

				index += 1

			if complete:
				Some(continuations + 1)
			else:
				None
		None:
			None


-- Keywords.
-- Derived once per lexing run, then read immutably by keyword queries.
-- The bootstrap constant evaluator cannot build an index through library
-- calls, so this setup belongs to the invocation rather than a computed global.
private record KeywordIndex {
	texts: List[String],
	slots: List[Int]
}


private pure func keyword_kind(keywords: KeywordIndex, text: String, start: Int, end: Int) -> TokenKind:
	index: Int = find_slice(keywords.texts, keywords.slots, text, start, end, slice_hash(text, start, end))
	KEYWORD_KINDS_IN_SEEDED_ORDER.get_or(index - FIRST_KEYWORD_NAME_INDEX, IdentifierToken)


---
Whether a name follows the `#` directly: an identifier that is neither a
keyword nor the lone `_`. Otherwise the `#` stays a `HashSymbol`.
---
private pure func dimension_name_follows(keywords: KeywordIndex, text: String, offset: Int) -> Bool:
	if offset >= text.length() or not is_identifier_start(byte_at(text, offset)):
		False
	else:
		end: Int = identifier_end(text, offset)
		(
			not (end - offset == 1 and byte_at(text, offset) == '_')
			and keyword_kind(keywords, text, offset, end) == IdentifierToken
		)


-- Entry points.
---
The source a module's spans point into. A module is its source: discovery
admits one source for each module it opens, in the same order
(`tables/builder`, `open_module`), so the module's index is its source's.
---
private pure func source_of(module: ModuleId) -> SourceId:
	source_id_at_row(module.module_id_index())


---
Lexes the whole `text` of `module`. Every problem is a diagnostic in the
result and an unrecognized byte never stops the lexer; the same module and
text always give the same result, whatever was lexed before.
---
pure func lex_module(module: ModuleId, text: String) -> LexedModule:
	run: LexedRun = lex_text_range(
		source_of(module),
		text,
		new_spellings(module),
		{
			start = 0,
			end = text.length(),
			position = AtLineStart
		},
	)
	{
		module = module,
		source = {
			text = text,
			literals = run.literals,
			interpolations = run.interpolations
		},
		tokens = run.tokens,
		spellings = run.spellings,
		line_starts = line_starts_of(text),
		diagnostics = run.diagnostics
	}


---
Lexes the text of an interpolation hole, bytes `start .. end` of `module`'s
`text`, into a run of its own that ends in an end-of-file token. `spellings`
are the module's after the lexing before it; the run returns them with the
hole's names added. A hole lies within one line, so its tokens hold no layout.
---
pure func lex_hole(
	module: ModuleId,
	text: String,
	spellings: Spellings,
	start: Int,
	end: Int,
) -> LexedRun:
	lex_text_range(
		source_of(module),
		text,
		spellings,
		{
			start = start,
			end = end,
			position = WithinLine
		},
	)


---
Where a lexed range starts: at the start of a line, where indentation is
measured, or after other tokens of its line (an interpolation hole).
---
private enum RangeStart:
	AtLineStart
	WithinLine


---
The bytes a lexing run covers and where the first of them sits.
---
private fixed record LexRange {
	start: Int,
	end: Int,
	position: RangeStart
}


private pure func lex_text_range(
	source: SourceId,
	text: String,
	initial_spellings: Spellings,
	range: LexRange,
) -> LexedRun:
	keyword_texts: List[String] = SEEDED_NAME_SPELLINGS.take(
		FIRST_KEYWORD_NAME_INDEX + KEYWORD_KINDS_IN_SEEDED_ORDER.length(),
	)
	keywords: KeywordIndex = {
		texts = keyword_texts,
		slots = slots_for_texts(keyword_texts, INITIAL_SLOT_COUNT)
	}
	length: Int = text.length()
	end_offset: Int = range.end
	within_line: Bool = range.position == WithinLine
	var spellings: Spellings = initial_spellings
	var tokens: List[Token] = []
	var literals: List[LiteralValue] = []
	var interpolations: List[InterpolationScan] = []
	var diagnostics: List[SyntaxDiagnosticAt] = []
	var offset: Int = range.start
	var line_start: Int = line_start_before(text, range.start)
	var layout: LayoutStacks = initial_layout()
	var group_depth: Int = 0
	var pending_newline: Bool = False
	var at_line_start: Bool = not within_line
	var line_has_token: Bool = within_line

	-- The kind of the last token appended; a line start stands in before the
	-- first, since it is neither a `:` nor a `#`. Within a line, the string
	-- holding the hole stands in.
	var previous_kind: TokenKind = if within_line:
		InterpolatedStringToken
	else:
		NewlineToken

	while True:
		if at_line_start:
			indent_start: Int = offset
			indent: Int = indent_width(text, offset)
			offset = after_blanks(text, offset)
			plan: LineStartPlan = layout.plan_line_start(
				group_depth,
				indent,
				offset < end_offset and byte_at(text, offset) != '\n',
				pending_newline,
				previous_kind,
			)

			if plan.emits_newline:
				tokens = tokens.append({
					kind = NewlineToken,
					span = pack_span(source, offset, offset),
					payload = NO_TOKEN_PAYLOAD,
				})

			if plan.opens_indent:
				tokens = tokens.append({
					kind = IndentToken,
					span = pack_span(source, indent_start, offset),
					payload = NO_TOKEN_PAYLOAD,
				})

			for dedent in 0..plan.dedent_count:
				tokens = tokens.append({
					kind = DedentToken,
					span = pack_span(source, offset, offset),
					payload = NO_TOKEN_PAYLOAD,
				})

			if plan.dedent == DedentedBetweenLevels:
				diagnostics = diagnostics.append({
					span = pack_span(source, offset, offset),
					diagnostic = Plain(InconsistentIndentationDiagnostic),
				})

			layout = layout.with_line_start_applied(plan)
			pending_newline = plan.pending_newline
			at_line_start = plan.at_line_start
			previous_kind = plan.previous_kind

		if offset >= end_offset:
			break

		c: Char = byte_at(text, offset)
		token_start: Int = offset

		if c == '\n':
			if layout.opens_lambda_body(group_depth, previous_kind == ColonSymbol):
				layout = layout.with_lambda_opened(group_depth)
				pending_newline = True
			else if layout.newline_is_insignificant(group_depth):
				pending_newline = False
			else:
				pending_newline = pending_newline or line_has_token

			offset += 1
			line_start = offset
			at_line_start = True
			line_has_token = False
		else if c == ' ' or c == '\t':
			offset = after_blanks(text, offset)
		else if c == '\"' and plain_string_close(text, offset) != NO_PLAIN_STRING_CLOSE:
			-- The common string: no escape, hole or line break before its
			-- closing quote. Its text is the bytes between the quotes.
			close: Int = plain_string_close(text, offset)
			payload: Int = literals.length()
			literals = literals.append(TextValue(text.substring(offset + 1, close - offset - 1)))
			tokens = tokens.append({
				kind = NormalStringToken,
				span = pack_span(source, offset, close + 1),
				payload = payload,
			})
			previous_kind = NormalStringToken
			line_has_token = True
			offset = close + 1
		else if (
			c == '\"'
			or c == '\''
			or c == '-' and docstring_fence_at(text, offset)
			or c == '|' and not line_has_token
			or (
				c == 'r'
				and raw_word_at(text, offset)
				and ((
					text_at(text, offset, "raw\"")
					or raw_pipe_marker_after(text, offset).is_some()
				))
			)
		):
			scan: LiteralScan = if c == '\"':
				scan_string_literal(text, offset)
			else if c == '\'':
				scan_char_literal(text, offset, end_offset)
			else if c == '-':
				scan_docstring(text, offset)
			else if c == '|':
				scan_pipe_block(
					text,
					offset,
					column_at(text, line_start, offset),
					False,
				)
			else if text_at(text, offset, "raw\""):
				scan_raw_string_literal(text, offset)
			else:
				match raw_pipe_marker_after(text, offset):
					Some((marker, margin_column)):
						scan_pipe_block(text, marker, margin_column, True)
					None:
						failed_scan(offset, [])

			for pending in scan.diagnostics:
				diagnostics = diagnostics.append({
					span = pack_span(source, pending.start, pending.end),
					diagnostic = pending.diagnostic,
				})

			offset = scan.end
			line_start = line_start_after(text, token_start, offset, line_start)
			token_span = pack_span(source, token_start, scan.end)

			match scan.literal:
				TextLiteral(kind, literal_text):
					payload: Int = literals.length()
					literals = literals.append(TextValue(literal_text))
					tokens = tokens.append({
						kind = kind,
						span = token_span,
						payload = payload,
					})
					previous_kind = kind

					if kind == DocStringToken:
						pending_newline = False
						at_line_start = True
						line_has_token = False
					else:
						line_has_token = True

						if scan.stop == StoppedAfterNewline:
							pending_newline = True
							at_line_start = True
							line_has_token = False
				InterpolatedLiteral(kind):
					segments: List[InterpolationSegment] = interpolation_segments(
						text,
						kind,
						token_start,
						scan.end,
					)
					payload: Int = interpolations.length()
					interpolations = interpolations.append(
						interpolation_scan(
							source,
							text,
							segments,
						),
					)
					tokens = tokens.append({
						kind = kind,
						span = token_span,
						payload = payload,
					})
					previous_kind = kind
					line_has_token = True

					if scan.stop == StoppedAfterNewline:
						pending_newline = True
						at_line_start = True
						line_has_token = False
				CodepointLiteral(codepoint):
					tokens = tokens.append({
						kind = CharLiteralToken,
						span = token_span,
						payload = codepoint,
					})
					previous_kind = CharLiteralToken
					line_has_token = True
				NoLiteral:
					void
		else if (
			c == '-'
			and byte_at(text, offset + 1) == '-'
			and offset + 1 < length
		):
			-- A comment runs to the end of the line; it is not recorded.
			offset = line_end(text, offset)
		else if (
			c == '_'
			and not (offset + 1 < length and is_identifier_continue(byte_at(text, offset + 1)))
		):
			offset += 1
			tokens = tokens.append({
				kind = UnderscoreSymbol,
				span = pack_span(source, token_start, offset),
				payload = NO_TOKEN_PAYLOAD,
			})
			previous_kind = UnderscoreSymbol
			line_has_token = True
		else if (
			is_identifier_start(c)
			or c == '#' and dimension_name_follows(keywords, text, offset + 1)
		):
			-- A word, or a `#` and the name directly after it (one token over both).
			is_dimension_name: Bool = c == '#'

			name_start: Int = if is_dimension_name:
				offset + 1
			else:
				offset

			end: Int = identifier_end(text, name_start)
			word_span = pack_span(source, offset, end)

			kind: TokenKind = if is_dimension_name:
				DimensionNameToken
			else:
				keyword_kind(keywords, text, name_start, end)

			var payload: Int = NO_TOKEN_PAYLOAD

			if kind == IdentifierToken or kind == DimensionNameToken:
				(interned, name_spelling) = interned_spelling(spellings, text, name_start, end)
				spellings = interned
				payload = spelling_index(name_spelling)

			tokens = tokens.append({
				kind = kind,
				span = word_span,
				payload = payload,
			})
			offset = end
			previous_kind = kind

			line_has_token = True
		else if is_digit_byte(c):
			number: NumberScan = scan_number(text, offset)
			number_span = pack_span(source, offset, number.end)

			-- A literal the lexer rejects has a kind of its own with no payload,
			-- so a literal token always indexes a checked value, and the
			-- diagnostic is the one place its digits are kept.
			number_token: Token = match checked_number(text, offset, number):
				AcceptedInteger(value):
					literals = literals.append(IntegerValue(value))
					{
						kind = IntLiteralToken,
						span = number_span,
						payload = literals.length() - 1
					}
				AcceptedFloat(value):
					literals = literals.append(FloatValue(value))
					{
						kind = FloatLiteralToken,
						span = number_span,
						payload = literals.length() - 1
					}
				RejectedInteger(digits):
					diagnostics = diagnostics.append({
						span = number_span,
						diagnostic = IntegerLiteralOverflow(digits),
					})
					{
						kind = RejectedIntegerToken,
						span = number_span,
						payload = NO_TOKEN_PAYLOAD
					}
				RejectedFloat(digits):
					diagnostics = diagnostics.append({
						span = number_span,
						diagnostic = FloatLiteralOverflow(digits),
					})
					{
						kind = RejectedFloatToken,
						span = number_span,
						payload = NO_TOKEN_PAYLOAD
					}

			tokens = tokens.append(number_token)
			offset = number.end
			previous_kind = number_token.kind
			line_has_token = True
		else:
			if starts_symbol(text, offset):
				found: SymbolMatch = symbol_at(text, offset)
				offset += found.width
				tokens = tokens.append({
					kind = found.kind,
					span = pack_span(source, token_start, offset),
					payload = NO_TOKEN_PAYLOAD,
				})
				previous_kind = found.kind
				line_has_token = True
				group_depth = group_depth_after(group_depth, found.kind)
			else:
				-- Scanned by byte: quote a whole UTF-8 character once, and
				-- report a byte that starts none by value.
				match utf8_sequence_width(text, offset):
					Some(width):
						diagnostics = diagnostics.append({
							span = pack_span(source, offset, offset + width),
							diagnostic = Plain(UnexpectedCharacterDiagnostic),
						})
						offset += width
					None:
						diagnostics = diagnostics.append({
							span = pack_span(source, offset, offset),
							diagnostic = UnexpectedByte(c),
						})
						offset += 1

	while layout.top_indent() > TOP_LEVEL_INDENT:
		tokens = tokens.append({
			kind = DedentToken,
			span = pack_span(source, offset, offset),
			payload = NO_TOKEN_PAYLOAD,
		})
		layout = layout.with_indent_popped()

	tokens = tokens.append({
		kind = EndOfFileToken,
		span = pack_span(source, offset, offset),
		payload = NO_TOKEN_PAYLOAD,
	})
	{
		spellings = spellings,
		tokens = tokens,
		literals = literals,
		interpolations = interpolations,
		diagnostics = diagnostics
	}


---
The start of the line holding `offset`.
---
private pure func line_start_before(text: String, offset: Int) -> Int:
	var position: Int = offset

	while position > 0 and byte_at(text, position - 1) != '\n':
		position -= 1

	position


---
The start of the line holding `end`, given that a scan from `start` to `end`
may have crossed newlines; `current` when it crossed none.
---
private pure func line_start_after(text: String, start: Int, end: Int, current: Int) -> Int:
	var position: Int = end - 1
	var found: Int = current

	while position >= start:
		if byte_at(text, position) == '\n':
			found = position + 1
			break

		position -= 1

	found
