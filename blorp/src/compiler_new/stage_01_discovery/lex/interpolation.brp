-- Interpolated text: scanning a `${` hole to its closing brace, splitting a
-- literal's text into segments and decoded parts, and appending them to the
-- builder's interpolation tables. The lexer lexes a hole's own tokens in
-- `lexer` (`lex_interpolation_hole`), since that re-enters the lexer's main
-- loop and this module must not import it.
import:
	../tables/builder:
		DiscoveryBuilder,
		NOT_INTERNED,
		append_interpolation,
		append_interpolation_part,
		append_interpolation_text,
		append_literal,
		interned_literal_index,
		interned_literal_slice_index,
	../tables/diagnostic_code:
		PlainSyntaxCode(
			InterpolationTooDeepDiagnostic, InterpolatedEscapeAtEndDiagnostic,
			MultilineInterpolatedStringDiagnostic, UnterminatedInterpolatedStringDiagnostic,
		),
	../tables/ids: literal_id_at_row
	../tables/limits: MAX_INTERPOLATION_DEPTH
	../tables/rows: EMPTY_ROW_RANGE, InterpolationPart(HolePart, TextPart)
	../tables/token: TokenKind(InterpolatedStringToken)
	char_literals: UnicodeEscapeScan, escaped_char, scan_char_literal, scan_unicode_escape
	scan_support:
		LiteralScan,
		PendingDiagnostic,
		ScannedLiteral(InterpolatedLiteral),
		after_blanks,
		byte_at,
		failed_scan,
		line_end,
		pending,
		pending_at,
		text_at,
		with_source_segment,
	string: string


---
`${`, which opens an interpolation hole. Written as a concatenation because
the two characters together inside a string literal would open a hole there.
---
INTERPOLATION_OPENER: String = "$" + "{"


private pure func plain_interpolation_run_end(text: String, offset: Int) -> Int:
	length: Int = text.length()
	var position: Int = offset

	while position < length:
		c: Char = byte_at(text, position)

		if (
			c == '\"'
			or c == '$'
			or c == '{'
			or c == '}'
			or c == '\\'
			or c == '\n'
		):
			break

		position += 1

	position


---
The rest of an interpolated string after its first `${`: where it ends and
what went wrong. Its text pieces and holes are read from the source by
`interpolation_parts` once the string's extent is known.
---
pure func scan_interpolated_string_tail(text: String, offset: Int) -> LiteralScan:
	length: Int = text.length()
	var position: Int = offset
	var failure: Option[PendingDiagnostic] = None
	var closed: Bool = False

	-- `offset` is past the first `${`, so the first hole is read first.
	match hole_scan(text, position, length):
		HoleClosed(close):
			position = close + 1
		HoleFailed(failed_hole):
			failure = Some(hole_failure(failed_hole))
			position = hole_failure_end(failed_hole)

	while failure.is_none() and not closed:
		position = plain_interpolation_run_end(text, position)

		if position >= length:
			failure = Some(pending(UnterminatedInterpolatedStringDiagnostic, position, position))
		else:
			c: Char = byte_at(text, position)

			if c == '\"':
				position += 1
				closed = True
			else if c == '$' and text_at(text, position, INTERPOLATION_OPENER):
				match hole_scan(text, position + 2, length):
					HoleClosed(close):
						position = close + 1
					HoleFailed(failed_hole):
						failure = Some(hole_failure(failed_hole))
						position = hole_failure_end(failed_hole)
			else if c == '\\':
				position += 1

				if position >= length:
					failure = Some(pending(InterpolatedEscapeAtEndDiagnostic, position, position))
				else:
					position += 1
			else if c == '\n':
				failure = Some(pending(MultilineInterpolatedStringDiagnostic, position, position))
				position += 1
			else:
				-- A `$` that opens no hole, or a brace outside one: text.
				position += 1

	match failure:
		Some(diagnostic):
			failed_scan(position, [diagnostic])
		None:
			{
				end = position,
				literal = InterpolatedLiteral(InterpolatedStringToken),
				diagnostics = [],
				ended_with_newline = False
			}


---
How reading a hole's code ended: at the `}` that closes it, or why it did not.
`position` is where the problem is.
---
private union HoleScan:
	HoleClosed(Int)
	HoleFailed(HoleFailure)


---
Why reading a hole's code failed, and where.
---
private union HoleFailure:
	HoleUnterminated(Int)
	HoleCrossesLine(Int)
	HoleTooDeep(Int)


---
Where scanning resumes after a failed hole, as the existing lexer resumes: at the
problem, past a line break.
---
private pure func hole_failure_end(failed: HoleFailure) -> Int:
	match failed:
		HoleCrossesLine(position):
			position + 1
		HoleUnterminated(position):
			position
		HoleTooDeep(position):
			position


private pure func hole_failure(failed: HoleFailure) -> PendingDiagnostic:
	match failed:
		HoleUnterminated(position):
			pending(UnterminatedInterpolatedStringDiagnostic, position, position)
		HoleCrossesLine(position):
			pending(MultilineInterpolatedStringDiagnostic, position, position)
		HoleTooDeep(position):
			pending(InterpolationTooDeepDiagnostic, position, position)


---
What a frame of `hole_scan`'s stack holds for a string literal inside a hole;
a frame of code holds its count of open braces, at least one.
---
private STRING_FRAME: Int = -1


---
Reads the code of a hole from `start` (past its `${`) up to `end`. Holes and
strings nest to any depth while no more than `MAX_INTERPOLATION_DEPTH` braces
and holes are open: a stack of
frames says whether the scan is in code or in a string literal, so a quote
opens or closes the string it belongs to, and a `}` inside a string closes
nothing. A character literal in code is opaque too, as a string is. A
backslash skips the byte after it, in code and in strings.
---
private pure func hole_scan(text: String, start: Int, end: Int) -> HoleScan:
	var frames: List[Int] = [1]
	var open_braces: Int = 1
	var position: Int = start
	var result: Option[HoleScan] = None

	while result.is_none():
		if position >= end:
			result = Some(HoleFailed(HoleUnterminated(position)))
		else:
			c: Char = byte_at(text, position)

			-- The stack empties only when the hole closes, which ends the scan, so a
			-- frame is always there; without one the hole did not close.
			match frames.get(frames.length() - 1):
				None:
					result = Some(HoleFailed(HoleUnterminated(position)))
				Some(top):
					if c == '\n':
						result = Some(HoleFailed(HoleCrossesLine(position)))
					else if c == '\\':
						position += 2
					else if top == STRING_FRAME:
						if c == '\"':
							frames = frames.drop_last()
							position += 1
						else if c == '$' and text_at(text, position, INTERPOLATION_OPENER):
							frames = frames.append(1)
							open_braces += 1

							if open_braces > MAX_INTERPOLATION_DEPTH:
								result = Some(HoleFailed(HoleTooDeep(position)))

							position += 2
						else:
							position += 1
					else if c == '\"':
						frames = frames.append(STRING_FRAME)
						position += 1
					else if c == '\'':
						-- A character literal is one token of the hole's code, so a
						-- `}`, `"`, `$` or `\` inside it opens or closes nothing. Its
						-- extent comes from the lexer's own scan, bounded by `end`.
						position = scan_char_literal(text, position, end).end
					else if c == '$' and text_at(text, position, INTERPOLATION_OPENER):
						-- A `${` in code opens a brace, as the existing lexer counts it.
						frames = frames.set(frames.length() - 1, top + 1)
						open_braces += 1

						if open_braces > MAX_INTERPOLATION_DEPTH:
							result = Some(HoleFailed(HoleTooDeep(position)))

						position += 2
					else if c == '{':
						frames = frames.set(frames.length() - 1, top + 1)
						open_braces += 1
						position += 1
					else if c == '}':
						open_braces -= 1

						if top == 1:
							frames = frames.drop_last()

							if frames.is_empty():
								result = Some(HoleClosed(position))
						else:
							frames = frames.set(frames.length() - 1, top - 1)

						position += 1
					else:
						position += 1

	match result:
		Some(scanned):
			scanned
		None:
			HoleFailed(HoleUnterminated(position))


-- Interpolated string parts.
---
The source bytes an interpolated string's text is read from, and the text
that precedes them: nothing for a quoted string, and for each later line of
a pipe string the line break, plus a `|` when the line's marker is `||`.
---
record InterpolationSegment {
	start: Int,
	end: Int,
	lead: String
}


---
How a scanned text piece's text is held: as its source bytes, which are the
text itself when the piece has no escape and lies in one segment, or as the
decoded text otherwise.
---
private enum PieceText:
	SourceBytes
	DecodedText


---
A text piece or hole as `interpolation_parts` found it. `decoded` holds the
text when `text` is `DecodedText`; `start .. end` are the source bytes.
---
record ScannedPart {
	part: InterpolationPart,
	start: Int,
	end: Int,
	text: PieceText,
	decoded: String
}


---
The open text piece while `interpolation_parts` scans: where it starts,
the decoded text before `run_start` when it needed decoding, and whether it
did.
---
private record PieceScan {
	parts: List[ScannedPart],
	piece_start: Int,
	run_start: Int,
	decoded: String,
	text: PieceText
}


---
What `PieceScan.piece_start` holds while no text piece is open.
---
private NO_PIECE: Int = -1


---
The segments of an interpolated string token spanning `start .. end`: the
bytes between the quotes, or the content of each pipe-string line.
---
pure func interpolation_segments(
	text: String,
	kind: TokenKind,
	start: Int,
	end: Int,
) -> List[InterpolationSegment]:
	if kind == InterpolatedStringToken:
		[
			{
				start = start + 1,
				end = end - 1,
				lead = ""
			},
		]
	else:
		pipe_segments(text, start, end)


private pure func pipe_segments(text: String, start: Int, end: Int) -> List[InterpolationSegment]:
	var segments: List[InterpolationSegment] = []
	var marker: Int = start
	var lead: String = ""

	while marker < end:
		doubled: Bool = text_at(text, marker, "||")

		content: Int = if doubled:
			marker + 2
		else:
			marker + 1

		line_lead: String = if doubled:
			lead + "|"
		else:
			lead

		content_end: Int = line_end(text, content)

		segment_end: Int = if content_end < end:
			content_end
		else:
			end

		segments = segments.append({
			start = content,
			end = segment_end,
			lead = line_lead,
		})

		if content_end >= end:
			break

		marker = after_blanks(text, content_end + 1)
		lead = "\n"

	segments


---
The text pieces and holes of an interpolated string, in order. Escapes in
text are decoded as the existing compiler decodes them; a hole runs from
after its `${` to the `}` that closes it outside string literals. A `{` or
`}` outside a hole is text.
---
pure func interpolation_parts(
	text: String,
	segments: List[InterpolationSegment],
) -> List[ScannedPart]:
	var scan: PieceScan = {
		parts = [],
		piece_start = NO_PIECE,
		run_start = 0,
		decoded = "",
		text = SourceBytes
	}
	var index: Int = 0

	for segment in segments:
		scan = scan_segment(text, segment, scan, index + 1 < segments.length())
		index += 1

	close_piece(text, scan, last_segment_end(segments))


private pure func last_segment_end(segments: List[InterpolationSegment]) -> Int:
	match segments.get(segments.length() - 1):
		Some(segment):
			segment.end
		None:
			0


private pure func scan_segment(
	text: String,
	segment: InterpolationSegment,
	start_scan: PieceScan,
	more_follow: Bool,
) -> PieceScan:
	var scan: PieceScan = with_lead(text, segment, start_scan)
	var position: Int = segment.start

	while position < segment.end:
		c: Char = byte_at(text, position)

		if c == '\\':
			scan = decoded_through(
				text,
				scan.open_piece(position),
				position,
			)
			escape: EscapeDecode = decoded_escape(text, position, segment.end)
			scan = { scan |
				decoded = scan.decoded + escape.text,
				run_start = escape.end
			}
			position = escape.end
		else if (
			c == '$'
			and byte_at(text, position + 1) == '{'
			and position + 1 < segment.end
		):
			scan = close_piece_into(text, scan, position)
			hole_start: Int = position + 2
			hole_end: Int = hole_close(text, hole_start, segment.end)
			scan = { scan |
				parts = scan.parts.append({
					part = HolePart,
					start = hole_start,
					end = hole_end,
					text = SourceBytes,
					decoded = "",
				}),
				run_start = hole_end + 1
			}
			position = hole_end + 1
		else:
			scan = scan.open_piece(position)
			position += 1

	-- A piece that continues on the next line cannot be one source slice.
	if more_follow and scan.piece_start != NO_PIECE:
		scan = decoded_through(text, scan, segment.end)

	scan


---
Opens a text piece at `position` unless one is open.
---
private pure func open_piece(scan: PieceScan, position: Int) -> PieceScan:
	if scan.piece_start == NO_PIECE:
		{ scan |
			piece_start = position,
			run_start = position,
			decoded = "",
			text = SourceBytes
		}
	else:
		scan


---
The segment's lead text, which opens a piece and makes it decoded.
---
private pure func with_lead(
	text: String,
	segment: InterpolationSegment,
	scan: PieceScan,
) -> PieceScan:
	if segment.lead.is_empty():
		{ scan | run_start = segment.start }
	else:
		opened: PieceScan = scan.open_piece(segment.start)
		{ opened |
			decoded = opened.decoded + segment.lead,
			run_start = segment.start,
			text = DecodedText
		}


---
Moves the open piece's undecoded bytes up to `position` into its decoded
text, making it decoded.
---
private pure func decoded_through(text: String, scan: PieceScan, position: Int) -> PieceScan:
	prefix: String = if scan.text == DecodedText:
		scan.decoded
	else:
		""

	{ scan |
		decoded = with_source_segment(prefix, text, scan.run_start, position),
		run_start = position,
		text = DecodedText
	}


---
Closes the open piece, if any, at `position`, appending it to the parts.
---
private pure func close_piece_into(text: String, scan: PieceScan, position: Int) -> PieceScan:
	if scan.piece_start == NO_PIECE:
		scan
	else:
		closed: PieceScan = if scan.text == DecodedText:
			decoded_through(text, scan, position)
		else:
			scan

		{ closed |
			parts = closed.parts.append({
				part = TextPart,
				start = closed.piece_start,
				end = position,
				text = closed.text,
				decoded = closed.decoded,
			}),
			piece_start = NO_PIECE,
			decoded = "",
			text = SourceBytes
		}


private pure func close_piece(text: String, scan: PieceScan, position: Int) -> List[ScannedPart]:
	close_piece_into(text, scan, position).parts


---
A decoded escape: its text and where the scan resumes.
---
private record EscapeDecode {
	text: String,
	end: Int
}


---
Decodes the escape at `position` (a backslash): the named escapes, braces and
`\u{...}`. An unknown escape keeps its backslash and the byte after it as text
(as the existing compiler's lexer keeps the pair), so `\$` before a `{` does
not open a hole.
---
private pure func decoded_escape(text: String, position: Int, end: Int) -> EscapeDecode:
	if text_at(text, position, "\\u{"):
		escape: UnicodeEscapeScan = scan_unicode_escape(text, position, end)

		match escape.codepoint:
			Some(codepoint):
				{
					text = string(1).append_char(to_char(codepoint)),
					end = escape.end
				}
			None:
				{
					text = text.substring(position, escape.end - position),
					end = escape.end
				}
	else if position + 1 < end:
		match escaped_char(byte_at(text, position + 1)):
			Some(value):
				{
					text = string(1).append_char(value),
					end = position + 2
				}
			None:
				{
					text = "\\" + text.substring(position + 1, 1),
					end = position + 2
				}
	else:
		{
			text = "\\",
			end = position + 1
		}


---
The offset of the `}` closing a hole whose text starts at `start`, or `end` when
the hole does not close before it (the string's scan reports that).
---
private pure func hole_close(text: String, start: Int, end: Int) -> Int:
	match hole_scan(text, start, end):
		HoleClosed(close):
			close
		HoleFailed(_):
			end


---
Appends the parts of one interpolated string and its row; its index is the
string token's payload.
---
pure func append_scanned_interpolation(
	builder: DiscoveryBuilder,
	text: String,
	parts: List[ScannedPart],
) -> DiscoveryBuilder:
	parts_first: Int = builder.interpolation_parts.length()
	var out: DiscoveryBuilder = builder.append_interpolation({
		first = parts_first,
		count = parts.length(),
	})

	for part in parts:
		out = out.append_scanned_part(text, part)

	out


private pure func append_scanned_part(
	builder: DiscoveryBuilder,
	text: String,
	part: ScannedPart,
) -> DiscoveryBuilder:
	if part.part == HolePart:
		builder.append_interpolation_part({
			part = HolePart,
			start = part.start,
			end = part.end,
			text = EMPTY_ROW_RANGE,
		})
	else:
		builder.append_text_part(text, part)


---
A text piece: its text interned as a literal (found in place when it is its
source bytes), then its row.
---
private pure func append_text_part(
	builder: DiscoveryBuilder,
	text: String,
	part: ScannedPart,
) -> DiscoveryBuilder:
	existing: Int = if part.text == SourceBytes:
		builder.interned_literal_slice_index(text, part.start, part.end)
	else:
		builder.interned_literal_index(part.decoded)

	literal_row: Int = if existing == NOT_INTERNED:
		builder.literals.length()
	else:
		existing

	var out: DiscoveryBuilder = builder.with_part_literal(text, part, existing)
	text_row: Int = out.interpolation_texts.length()
	out = out.append_interpolation_text(literal_id_at_row(literal_row))
	out = out.append_interpolation_part({
		part = TextPart,
		start = part.start,
		end = part.end,
		text = {
			first = text_row,
			count = 1
		},
	})
	out


private pure func with_part_literal(
	builder: DiscoveryBuilder,
	text: String,
	part: ScannedPart,
	existing: Int,
) -> DiscoveryBuilder:
	if existing != NOT_INTERNED:
		builder
	else if part.text == SourceBytes:
		builder.append_literal(text.substring(part.start, part.end - part.start))
	else:
		builder.append_literal(part.decoded)
