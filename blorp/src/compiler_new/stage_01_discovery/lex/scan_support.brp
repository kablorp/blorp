-- The scanning vocabulary the lexer's modules share: byte and character
-- classes, line and offset helpers, and the result types of a literal scan
-- (`LiteralScan`, `ScannedLiteral`, `PendingDiagnostic`). It is separate so the
-- literal, interpolation and layout modules can each import it without
-- importing one another.
import:
	../tables/diagnostic_code: PlainSyntaxCode, SyntaxDiagnostic(Plain)
	../tables/source_position: tab_advance
	../tables/token: TokenKind


---
The byte `byte_at` returns past the end of the text. Scanners test the offset
against the length where the end must differ from a NUL byte in the source.
---
private PAST_END_BYTE: Char = '\0'


---
A diagnostic found by a literal scanner, appended by the lexer loop. A
`record`, not a `struct`: a struct field cannot hold a union, and a literal
that fails to scan is an error path.
---
record PendingDiagnostic {
	diagnostic: SyntaxDiagnostic,
	start: Int,
	end: Int
}


---
What a literal scanner found.
---
union ScannedLiteral:
	TextLiteral(TokenKind, String)
	InterpolatedLiteral(TokenKind)
	CodepointLiteral(Int)
	NoLiteral


---
Where a literal scan stopped: at the end of the token, or after the newline
that ended its last line, which only a pipe string consumes.
---
enum ScanStop:
	StoppedAtToken
	StoppedAfterNewline


---
A literal scanner's result: where the scan stopped, what it found, what went
wrong, and whether it consumed the newline ending its last line.
---
record LiteralScan {
	end: Int,
	literal: ScannedLiteral,
	diagnostics: List[PendingDiagnostic],
	stop: ScanStop
}


---
A diagnostic with no argument over `start` to `end`.
---
pure func pending(code: PlainSyntaxCode, start: Int, end: Int) -> PendingDiagnostic:
	{
		diagnostic = Plain(code),
		start = start,
		end = end
	}


---
A diagnostic with arguments, empty at `at`.
---
pure func pending_at(diagnostic: SyntaxDiagnostic, at: Int) -> PendingDiagnostic:
	{
		diagnostic = diagnostic,
		start = at,
		end = at
	}


pure func failed_scan(end: Int, diagnostics: List[PendingDiagnostic]) -> LiteralScan:
	{
		end = end,
		literal = NoLiteral,
		diagnostics = diagnostics,
		stop = StoppedAtToken
	}


-- Byte classes.
pure func byte_at(text: String, offset: Int) -> Char:
	text.get_or(offset, PAST_END_BYTE)


pure func is_digit_byte(c: Char) -> Bool:
	c >= '0' and c <= '9'


pure func is_identifier_start(c: Char) -> Bool:
	c >= 'a' and c <= 'z' or c >= 'A' and c <= 'Z' or c == '_'


pure func is_identifier_continue(c: Char) -> Bool:
	is_identifier_start(c) or is_digit_byte(c)


---
Whether `expected` occurs in `text` at `offset`.
---
pure func text_at(text: String, offset: Int, expected: String) -> Bool:
	expected_length: Int = expected.length()

	if offset + expected_length > text.length():
		False
	else:
		var index: Int = 0
		var matches: Bool = True

		while matches and index < expected_length:
			if byte_at(text, offset + index) == byte_at(expected, index):
				index += 1
			else:
				matches = False

		matches


---
Whether only spaces and tabs follow `offset` before the end of the line.
---
pure func rest_of_line_is_blank(text: String, offset: Int) -> Bool:
	length: Int = text.length()
	var position: Int = offset
	var blank: Bool = False

	while True:
		if position >= length:
			blank = True
			break

		c: Char = byte_at(text, position)

		if c == ' ' or c == '\t':
			position += 1
		else:
			blank = c == '\n'
			break

	blank


---
The offset of the newline ending the line containing `offset`, or the end.
---
pure func line_end(text: String, offset: Int) -> Int:
	length: Int = text.length()
	var position: Int = offset

	while position < length and byte_at(text, position) != '\n':
		position += 1

	position


pure func after_blanks(text: String, offset: Int) -> Int:
	length: Int = text.length()
	var position: Int = offset

	while position < length and (byte_at(text, position) == ' ' or byte_at(text, position) == '\t'):
		position += 1

	position


---
The tab-expanded indentation width of the blanks starting at `offset`.
---
pure func indent_width(text: String, offset: Int) -> Int:
	length: Int = text.length()
	var position: Int = offset
	var indent: Int = 0

	while position < length:
		c: Char = byte_at(text, position)

		if c == ' ':
			indent += 1
			position += 1
		else if c == '\t':
			indent += tab_advance(indent + 1)
			position += 1
		else:
			break

	indent


pure func identifier_end(text: String, offset: Int) -> Int:
	length: Int = text.length()
	var position: Int = offset

	while position < length and is_identifier_continue(byte_at(text, position)):
		position += 1

	position


pure func with_source_segment(
	text: String,
	source: String,
	start: Int,
	end: Int,
) -> String:
	if end > start:
		text + source.substring(start, end - start)
	else:
		text
