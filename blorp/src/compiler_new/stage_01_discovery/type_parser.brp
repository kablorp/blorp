-- Written types, type parameters and dimension constraints, parsed into the
-- node table and the declaration side tables.
--
-- A type is appended post-order like any node: each routine appends its root
-- last, so a caller reads the root with `last_node_id` after the call. The
-- shapes and spans follow the existing parser: `Name[#3]` whose arguments are
-- all dimensions is an array type, `()` is the named type `Void`, and `(T)` is
-- `T` itself.
import:
	discovery_builder:
		DefinitionId,
		DiscoveryBuilder,
		NameId,
		NodeId,
		advance_token,
		append_bound,
		append_dimension_constraint,
		append_leaf_node,
		append_literal_leaf_node,
		append_name_leaf_node,
		append_named_parent_node,
		append_parent_node,
		append_plain_diagnostic,
		append_type_parameter,
		last_node_id,
		literal_id_at_row,
		name_id_at_row,
		next_node_id,
		node_id_index,
	discovery_diagnostic_code:
		DiscoveryDiagnosticCode(
			ArrayDimensionsExpectedDiagnostic,
			ExpectedArrowDiagnostic,
			ExpectedDimensionDiagnostic,
			ExpectedEqualEqualDiagnostic,
			ExpectedHashDiagnostic,
			ExpectedLeftParenDiagnostic,
			ExpectedRightBracketDiagnostic,
			ExpectedRightParenDiagnostic,
			ExpectedTypeDiagnostic,
			TupleArityDiagnostic,
		),
	name_vocabulary: DISCARD_NAME_INDEX, VOID_NAME_INDEX
	parser_cursor:
		EMPTY_NAME_INDEX,
		at,
		consume_declared_name,
		consume_referenced_name,
		current_kind,
		current_span,
		current_token,
		declared_name_at_cursor,
		expect_token,
		keyword_name_index,
		peek_kind,
		referenced_name_at_cursor,
		report_and_recover,
		report_at_current,
	row_kinds:
		NodeKind(
			ArrayTypeNode,
			BoundedTypeNode,
			DimensionAddTypeNode,
			DimensionDivideTypeNode,
			DimensionLiteralTypeNode,
			DimensionMultiplyTypeNode,
			DimensionNameTypeNode,
			DimensionSubtractTypeNode,
			DimensionWildcardTypeNode,
			FunctionTypeNode,
			MissingTypeNode,
			NamedTypeNode,
			PureFunctionTypeNode,
			QualifiedTypeNode,
			RangeTypeNode,
			TupleTypeNode,
			TypeBoundNode,
			TypeQualifierNode,
			VariadicDimensionNameTypeNode,
			VariadicDimensionWildcardTypeNode,
		),
		TypeParameterKind(DimensionParameter, TypeParameter, WildcardDimensionParameter),
	span: Span, span_covering
	token:
		Token,
		TokenKind(
			ArrowSymbol,
			ColonSymbol,
			CommaSymbol,
			DimensionNameToken,
			DotDotDotSymbol,
			DotDotSymbol,
			DotSymbol,
			EndOfFileToken,
			EqualEqualSymbol,
			HashSymbol,
			IdentifierToken,
			IntLiteralToken,
			LeftBracketSymbol,
			LeftParenSymbol,
			MinusSymbol,
			PlusSymbol,
			PureKeyword,
			RightBracketSymbol,
			RightParenSymbol,
			SelfKeyword,
			SlashSymbol,
			StarSymbol,
			UnderscoreSymbol,
			VoidKeyword,
			WhereKeyword,
		),


---
The most elements a tuple type may have.
---
private MAX_TUPLE_ARITY: Int = 4


pure func node_span(builder: DiscoveryBuilder, node: NodeId) -> Span:
	match builder.nodes.get(node_id_index(node)):
		Some(row):
			row.span
		None:
			current_span(builder)


---
Whether `node` is a dimension: a dimension name, literal, wildcard or
dimension arithmetic.
---
pure func is_dimension_node(builder: DiscoveryBuilder, node: NodeId) -> Bool:
	match builder.nodes.get(node_id_index(node)):
		Some(row):
			match row.kind:
				DimensionNameTypeNode | VariadicDimensionNameTypeNode | DimensionWildcardTypeNode | VariadicDimensionWildcardTypeNode | DimensionLiteralTypeNode | DimensionAddTypeNode | DimensionSubtractTypeNode | DimensionMultiplyTypeNode | DimensionDivideTypeNode:
					True
				_:
					False
		None:
			False


private pure func all_dimensions(builder: DiscoveryBuilder, nodes: List[NodeId]) -> Bool:
	nodes.length() > 0 and nodes.all(pure func(node): is_dimension_node(builder, node))


-- Types.
---
A type expression; bounded arguments (`T: Eq`) are not allowed at the top.
---
pure func parse_type(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	parse_type_allowing_bounds(builder, False)


---
A type expression, with `Name: Bound + Bound` accepted when `allow_bounds`
(inside type argument lists).
---
pure func parse_type_allowing_bounds(
	builder: DiscoveryBuilder,
	allow_bounds: Bool,
) -> DiscoveryBuilder:
	match current_kind(builder):
		IdentifierToken | SelfKeyword | VoidKeyword:
			parse_named_type(builder, allow_bounds)
		PureKeyword:
			parse_pure_function_type(builder)
		DimensionNameToken | HashSymbol | IntLiteralToken:
			parse_dimension_expression(builder)
		DotDotSymbol:
			parse_range_type(builder)
		LeftParenSymbol:
			if starts_parenthesized_dimension(builder, 1):
				parse_dimension_expression(builder)
			else:
				parse_parenthesized_type(builder)
		_:
			parse_missing_type(builder)


---
Reports a missing type and appends a `MissingTypeNode` at the offending
token, which is skipped unless it is a soft boundary.
---
private pure func parse_missing_type(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	span: Span = current_span(builder)
	var out: DiscoveryBuilder = report_and_recover(builder, ExpectedTypeDiagnostic)
	out = append_leaf_node(out, MissingTypeNode, span)
	out


---
Whether the token `ahead` of the cursor starts a dimension atom, looking
through nested parentheses: `(#N + 1)` is a dimension, `(Int, #N)` is not.
---
private pure func starts_parenthesized_dimension(builder: DiscoveryBuilder, ahead: Int) -> Bool:
	match peek_kind(builder, ahead):
		HashSymbol | DimensionNameToken | IntLiteralToken:
			True
		LeftParenSymbol:
			starts_parenthesized_dimension(builder, ahead + 1)
		_:
			False


---
The name a type position records for the current token: an identifier, or
`Self` / `void` written as a type name.
---
private pure func type_name_at_cursor(builder: DiscoveryBuilder) -> NameId:
	kind: TokenKind = current_kind(builder)

	if kind == SelfKeyword or kind == VoidKeyword:
		match keyword_name_index(kind):
			Some(index):
				name_id_at_row(index)
			None:
				name_id_at_row(EMPTY_NAME_INDEX)
	else:
		referenced_name_at_cursor(builder)


private pure func consume_type_name(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	kind: TokenKind = current_kind(builder)

	if kind == SelfKeyword or kind == VoidKeyword:
		advance_token(builder)
	else:
		consume_referenced_name(builder)


---
`Name`, `Name[args]`, `Module.Name[args]`, or with `allow_bounds`
`Name: Bound + ...`; then any array suffixes.
---
private pure func parse_named_type(
	builder: DiscoveryBuilder,
	allow_bounds: Bool,
) -> DiscoveryBuilder:
	can_qualify: Bool = current_kind(builder) == IdentifierToken
	first_name: NameId = type_name_at_cursor(builder)
	first_span: Span = current_span(builder)
	var out: DiscoveryBuilder = consume_type_name(builder)

	if allow_bounds and at(out, ColonSymbol):
		out = advance_token(out)
		var bounds: List[NodeId] = []
		var end_span: Span = first_span
		var parsing: Bool = True

		while parsing:
			bound_name: NameId = referenced_name_at_cursor(out)
			bound_span: Span = current_span(out)
			out = consume_referenced_name(out)
			bound: NodeId = next_node_id(out)
			out = append_name_leaf_node(out, TypeBoundNode, bound_span, bound_name)
			bounds = bounds.append(bound)
			end_span = bound_span

			if at(out, PlusSymbol):
				out = advance_token(out)
			else:
				parsing = False

		out = append_named_parent_node(
			out,
			BoundedTypeNode,
			span_covering(first_span, end_span),
			first_name,
			bounds,
		)
		out
	else:
		var qualifier: Option[(NameId, Span)] = None
		var type_name: NameId = first_name
		var type_name_span: Span = first_span

		if can_qualify and at(out, DotSymbol):
			out = advance_token(out)
			qualifier = Some((first_name, first_span))
			type_name = referenced_name_at_cursor(out)
			type_name_span = current_span(out)
			out = consume_referenced_name(out)

		var arguments: List[NodeId] = []
		var end_span: Span = type_name_span

		if at(out, LeftBracketSymbol):
			out = advance_token(out)

			if not at(out, RightBracketSymbol):
				var parsing: Bool = True

				while parsing and not at_end_of_tokens(out):
					out = parse_type_allowing_bounds(out, True)
					argument: NodeId = last_node_id(out)
					arguments = arguments.append(argument)
					end_span = node_span(out, argument)

					if at(out, CommaSymbol):
						out = advance_token(out)

						if at(out, RightBracketSymbol):
							parsing = False
					else:
						parsing = False

			if at(out, RightBracketSymbol):
				end_span = current_span(out)
				out = advance_token(out)
			else:
				out = report_at_current(out, ExpectedRightBracketDiagnostic)

		name_start: Span = match qualifier:
			Some((_, qualifier_span)):
				qualifier_span
			None:
				type_name_span

		if all_dimensions(out, arguments):
			out = append_named_type(
				out,
				qualifier,
				type_name,
				type_name_span,
				span_covering(name_start, type_name_span),
				[],
			)
			base: NodeId = last_node_id(out)
			out = append_parent_node(
				out,
				ArrayTypeNode,
				span_covering(name_start, end_span),
				[base].concat(arguments),
			)
		else:
			out = append_named_type(
				out,
				qualifier,
				type_name,
				type_name_span,
				span_covering(name_start, end_span),
				arguments,
			)

		out = parse_array_suffixes(out)
		out


---
Appends a named or qualified type node over `arguments`.
---
private pure func append_named_type(
	builder: DiscoveryBuilder,
	qualifier: Option[(NameId, Span)],
	type_name: NameId,
	type_name_span: Span,
	span: Span,
	arguments: List[NodeId],
) -> DiscoveryBuilder:
	match qualifier:
		Some((module_name, module_span)):
			qualifier_node: NodeId = next_node_id(builder)
			var out: DiscoveryBuilder = append_name_leaf_node(
				builder,
				TypeQualifierNode,
				module_span,
				module_name,
			)
			out = append_named_parent_node(
				out,
				QualifiedTypeNode,
				span,
				type_name,
				[qualifier_node].concat(arguments),
			)
			out
		None:
			append_named_parent_node(builder, NamedTypeNode, span, type_name, arguments)


private pure func at_end_of_tokens(builder: DiscoveryBuilder) -> Bool:
	current_token(builder).kind == EndOfFileToken


---
Array suffixes after a type: each `[dims]` wraps the type so far.
---
private pure func parse_array_suffixes(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	if at(builder, LeftBracketSymbol):
		parse_array_suffix_chain(builder)
	else:
		builder


---
Array suffixes when there is at least one; the first is parsed before the
loop (builder threading rule 1).
---
private pure func parse_array_suffix_chain(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = parse_array_suffix(builder)

	while at(out, LeftBracketSymbol):
		out = parse_array_suffix(out)

	out


---
One `[dims]` suffix, from its `[`, wrapping the last node.
---
private pure func parse_array_suffix(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	element: NodeId = last_node_id(builder)
	element_span: Span = node_span(builder, element)
	var out: DiscoveryBuilder = advance_token(builder)
	var dimensions: List[NodeId] = []
	var end_span: Span = element_span
	var parsing: Bool = True

	while parsing and not at_end_of_tokens(out):
		out = parse_type_allowing_bounds(out, True)
		dimension: NodeId = last_node_id(out)
		dimensions = dimensions.append(dimension)
		end_span = node_span(out, dimension)

		if at(out, CommaSymbol):
			out = advance_token(out)

			if at(out, RightBracketSymbol):
				parsing = False
		else:
			parsing = False

	closed: Bool = at(out, RightBracketSymbol)

	if closed:
		closing_span: Span = current_span(out)
		out = advance_token(out)

		if not all_dimensions(out, dimensions):
			out = append_plain_diagnostic(out, ArrayDimensionsExpectedDiagnostic, end_span)

		end_span = closing_span
	else:
		out = report_at_current(out, ExpectedRightBracketDiagnostic)

		if not all_dimensions(out, dimensions):
			out = append_plain_diagnostic(out, ArrayDimensionsExpectedDiagnostic, end_span)

	out = append_parent_node(
		out,
		ArrayTypeNode,
		span_covering(element_span, end_span),
		[element].concat(dimensions),
	)
	out


---
`(...)`: `()` (the named type `Void`), a function type `(T, U) -> R`, a
grouping `(T)`, or a tuple `(T, U)`; then any array suffixes.
---
private pure func parse_parenthesized_type(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	start: Span = current_span(builder)
	var out: DiscoveryBuilder = advance_token(builder)

	if at(out, RightParenSymbol):
		close: Span = current_span(out)
		out = advance_token(out)

		if at(out, ArrowSymbol):
			out = advance_token(out)
			out = parse_type(out)
			return_type: NodeId = last_node_id(out)
			end_span: Span = node_span(out, return_type)
			out = append_parent_node(
				out,
				FunctionTypeNode,
				span_covering(start, end_span),
				[return_type],
			)
			out
		else:
			void_span: Span = span_covering(start, close)
			out = append_name_leaf_node(
				out,
				NamedTypeNode,
				void_span,
				name_id_at_row(VOID_NAME_INDEX),
			)
			out = parse_array_suffixes(out)
			out
	else:
		var items: List[NodeId] = []
		var parsing: Bool = True

		while parsing and not at_end_of_tokens(out):
			out = parse_type_allowing_bounds(out, True)
			items = items.append(last_node_id(out))

			if at(out, CommaSymbol):
				out = advance_token(out)

				if at(out, RightParenSymbol):
					parsing = False
			else:
				parsing = False

		close_span: Span = current_span(out)
		out = expect_right_paren(out)

		if at(out, ArrowSymbol):
			out = advance_token(out)
			out = parse_type(out)
			return_type: NodeId = last_node_id(out)
			end_span: Span = node_span(out, return_type)
			out = append_parent_node(
				out,
				FunctionTypeNode,
				span_covering(start, end_span),
				items.append(return_type),
			)
			out
		else:
			tuple_span: Span = span_covering(start, close_span)

			if items.length() > MAX_TUPLE_ARITY:
				out = append_plain_diagnostic(out, TupleArityDiagnostic, tuple_span)

			if items.length() != 1:
				out = append_parent_node(out, TupleTypeNode, tuple_span, items)

			out = parse_array_suffixes(out)
			out


private pure func expect_right_paren(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	expect_token(builder, RightParenSymbol, ExpectedRightParenDiagnostic)


---
`pure (T, ...) -> R`.
---
private pure func parse_pure_function_type(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	start: Span = current_span(builder)
	var out: DiscoveryBuilder = advance_token(builder)

	if at(out, LeftParenSymbol):
		out = advance_token(out)
	else:
		out = report_at_current(out, ExpectedLeftParenDiagnostic)

	var parameters: List[NodeId] = []

	if not at(out, RightParenSymbol):
		var parsing: Bool = True

		while parsing and not at_end_of_tokens(out):
			out = parse_type_allowing_bounds(out, True)
			parameters = parameters.append(last_node_id(out))

			if at(out, CommaSymbol):
				out = advance_token(out)

				if at(out, RightParenSymbol):
					parsing = False
			else:
				parsing = False

	out = expect_right_paren(out)

	if at(out, ArrowSymbol):
		out = advance_token(out)
	else:
		out = report_at_current(out, ExpectedArrowDiagnostic)

	out = parse_type(out)
	return_type: NodeId = last_node_id(out)
	end_span: Span = node_span(out, return_type)
	out = append_parent_node(
		out,
		PureFunctionTypeNode,
		span_covering(start, end_span),
		parameters.append(return_type),
	)
	out


---
`..#N`: a range over a dimension.
---
private pure func parse_range_type(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	start: Span = current_span(builder)
	var out: DiscoveryBuilder = advance_token(builder)
	kind: TokenKind = current_kind(out)

	if (
		kind != HashSymbol
		and kind != DimensionNameToken
		and kind != LeftParenSymbol
	):
		out = report_at_current(out, ExpectedHashDiagnostic)

	out = parse_dimension_expression(out)
	dimension: NodeId = last_node_id(out)
	end_span: Span = node_span(out, dimension)
	out = append_parent_node(
		out,
		RangeTypeNode,
		span_covering(start, end_span),
		[dimension],
	)
	out


-- Dimensions.
---
A dimension expression: `+` and `-` over `*` and `/` over atoms.
---
pure func parse_dimension_expression(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = parse_dimension_product(builder)

	while at(out, PlusSymbol) or at(out, MinusSymbol):
		kind: NodeKind = if at(out, PlusSymbol):
			DimensionAddTypeNode
		else:
			DimensionSubtractTypeNode

		left: NodeId = last_node_id(out)
		out = advance_token(out)
		out = parse_dimension_product(out)
		right: NodeId = last_node_id(out)
		span: Span = span_covering(
			node_span(out, left),
			node_span(out, right),
		)
		out = append_parent_node(
			out,
			kind,
			span,
			[left, right],
		)

	out


private pure func parse_dimension_product(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = parse_dimension_atom(builder)

	while at(out, StarSymbol) or at(out, SlashSymbol):
		kind: NodeKind = if at(out, StarSymbol):
			DimensionMultiplyTypeNode
		else:
			DimensionDivideTypeNode

		left: NodeId = last_node_id(out)
		out = advance_token(out)
		out = parse_dimension_atom(out)
		right: NodeId = last_node_id(out)
		span: Span = span_covering(
			node_span(out, left),
			node_span(out, right),
		)
		out = append_parent_node(
			out,
			kind,
			span,
			[left, right],
		)

	out


---
`#N`, `#N...`, `#3`, `#_`, `#_...`, a bare integer, or a parenthesized
dimension expression (which adds no node of its own).
---
private pure func parse_dimension_atom(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	token: Token = current_token(builder)

	match token.kind:
		DimensionNameToken:
			var out: DiscoveryBuilder = advance_token(builder)

			if at(out, DotDotDotSymbol):
				end: Span = current_span(out)
				out = advance_token(out)
				out = append_name_leaf_node(
					out,
					VariadicDimensionNameTypeNode,
					span_covering(token.span, end),
					name_id_at_row(token.payload),
				)
			else:
				out = append_name_leaf_node(
					out,
					DimensionNameTypeNode,
					token.span,
					name_id_at_row(token.payload),
				)

			-- Builder threading rule 2.
			out
		HashSymbol:
			advanced: DiscoveryBuilder = advance_token(builder)
			parse_hash_dimension(advanced, token.span)
		IntLiteralToken:
			advanced: DiscoveryBuilder = advance_token(builder)
			append_literal_leaf_node(
				advanced,
				DimensionLiteralTypeNode,
				token.span,
				literal_id_at_row(token.payload),
			)
		LeftParenSymbol:
			advanced: DiscoveryBuilder = advance_token(builder)
			var out: DiscoveryBuilder = parse_dimension_expression(advanced)
			out = expect_right_paren(out)
			out
		_:
			var out: DiscoveryBuilder = report_at_current(builder, ExpectedDimensionDiagnostic)
			out = append_leaf_node(out, MissingTypeNode, token.span)
			out


---
What follows a `#` that the lexer did not join to a name: a literal (`#3`)
or the wildcard (`#_`, `#_...`). Anything else, including a name after a
blank (`# N`), is reported.
---
private pure func parse_hash_dimension(
	builder: DiscoveryBuilder,
	hash_span: Span,
) -> DiscoveryBuilder:
	token: Token = current_token(builder)

	match token.kind:
		IntLiteralToken:
			advanced: DiscoveryBuilder = advance_token(builder)
			append_literal_leaf_node(
				advanced,
				DimensionLiteralTypeNode,
				span_covering(hash_span, token.span),
				literal_id_at_row(token.payload),
			)
		UnderscoreSymbol:
			var out: DiscoveryBuilder = advance_token(builder)

			if at(out, DotDotDotSymbol):
				end: Span = current_span(out)
				out = advance_token(out)
				out = append_leaf_node(
					out,
					VariadicDimensionWildcardTypeNode,
					span_covering(hash_span, end),
				)
			else:
				out = append_leaf_node(
					out,
					DimensionWildcardTypeNode,
					span_covering(hash_span, token.span),
				)

			-- Builder threading rule 2.
			out
		_:
			var out: DiscoveryBuilder = report_at_current(builder, ExpectedDimensionDiagnostic)
			out = append_leaf_node(out, MissingTypeNode, hash_span)
			out


---
`where left == right, ...` constraints of `owner`, if written.
---
pure func parse_dimension_constraints(
	builder: DiscoveryBuilder,
	owner: DefinitionId,
) -> DiscoveryBuilder:
	if not at(builder, WhereKeyword):
		builder
	else:
		var out: DiscoveryBuilder = advance_token(builder)
		var parsing: Bool = True

		while parsing and not at_end_of_tokens(out):
			out = parse_dimension_expression(out)
			left: NodeId = last_node_id(out)
			out = expect_token(out, EqualEqualSymbol, ExpectedEqualEqualDiagnostic)
			out = parse_dimension_expression(out)
			right: NodeId = last_node_id(out)
			span: Span = span_covering(
				node_span(out, left),
				node_span(out, right),
			)
			out = append_dimension_constraint(
				out,
				{
					owner = owner,
					left = left,
					right = right,
					span = span
				},
			)

			if at(out, CommaSymbol):
				out = advance_token(out)
			else:
				parsing = False

		out


-- Type parameters.
---
`[T, #N, #_, T: Bound + ...]` type parameters of `owner`, if written.
---
pure func parse_type_parameters(builder: DiscoveryBuilder, owner: DefinitionId) -> DiscoveryBuilder:
	if not at(builder, LeftBracketSymbol):
		builder
	else:
		var out: DiscoveryBuilder = advance_token(builder)
		var ordinal: Int = 0

		if not at(out, RightBracketSymbol):
			var parsing: Bool = True

			while parsing and not at_end_of_tokens(out):
				out = parse_type_parameter(out, owner, ordinal)
				ordinal += 1

				if at(out, CommaSymbol):
					out = advance_token(out)

					if at(out, RightBracketSymbol):
						parsing = False
				else:
					parsing = False

		out = expect_token(out, RightBracketSymbol, ExpectedRightBracketDiagnostic)
		out


---
The kind of the type parameter at the cursor: `#N` is a dimension, `#_` a
wildcard dimension, a `#` followed by anything else a (reported) dimension,
and a name a type parameter.
---
private pure func type_parameter_kind_at_cursor(builder: DiscoveryBuilder) -> TypeParameterKind:
	match current_kind(builder):
		DimensionNameToken:
			DimensionParameter
		HashSymbol:
			if peek_kind(builder, 1) == UnderscoreSymbol:
				WildcardDimensionParameter
			else:
				DimensionParameter
		_:
			TypeParameter


---
Consumes a type parameter's name; a `#` not followed by `_` is reported.
---
private pure func consume_type_parameter_name(
	builder: DiscoveryBuilder,
	kind: TypeParameterKind,
) -> DiscoveryBuilder:
	match kind:
		TypeParameter:
			consume_declared_name(builder)
		WildcardDimensionParameter:
			advanced: DiscoveryBuilder = advance_token(builder)
			advance_token(advanced)
		DimensionParameter:
			if at(builder, HashSymbol):
				advanced: DiscoveryBuilder = advance_token(builder)
				report_at_current(advanced, ExpectedDimensionDiagnostic)
			else:
				advance_token(builder)


private pure func token_span_at(builder: DiscoveryBuilder, index: Int) -> Span:
	match builder.tokens.get(index):
		Some(token):
			token.span
		None:
			current_span(builder)


private pure func parse_type_parameter(
	builder: DiscoveryBuilder,
	owner: DefinitionId,
	ordinal: Int,
) -> DiscoveryBuilder:
	token: Token = current_token(builder)
	kind: TypeParameterKind = type_parameter_kind_at_cursor(builder)

	name: NameId = match kind:
		TypeParameter:
			declared_name_at_cursor(builder)
		DimensionParameter:
			if token.kind == DimensionNameToken:
				name_id_at_row(token.payload)
			else:
				name_id_at_row(EMPTY_NAME_INDEX)
		WildcardDimensionParameter:
			name_id_at_row(DISCARD_NAME_INDEX)

	name_span: Span = if kind == WildcardDimensionParameter:
		span_covering(
			token.span,
			token_span_at(builder, builder.token_cursor + 1),
		)
	else:
		token.span

	var out: DiscoveryBuilder = consume_type_parameter_name(builder, kind)
	var end_span: Span = name_span

	if at(out, ColonSymbol):
		out = advance_token(out)
		var parsing: Bool = True

		while parsing and not at_end_of_tokens(out):
			bound_name: NameId = referenced_name_at_cursor(out)
			bound_span: Span = current_span(out)
			out = consume_referenced_name(out)
			out = append_bound(
				out,
				{
					owner = owner,
					parameter_ordinal = ordinal,
					trait_name = bound_name,
					span = bound_span
				},
			)
			end_span = bound_span

			if at(out, PlusSymbol):
				out = advance_token(out)
			else:
				parsing = False

	out = append_type_parameter(
		out,
		{
			owner = owner,
			ordinal = ordinal,
			name = name,
			kind = kind,
			span = span_covering(name_span, end_span)
		},
	)
	out
