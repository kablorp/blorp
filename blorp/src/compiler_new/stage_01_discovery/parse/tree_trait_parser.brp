-- A trait: its header, then each method read in full in source order (its
-- header, its default body, its definition), and the trait minted last, so
-- its ids are post-order without reading anything twice.
import:
	../syntax/declarations: TypeParameter, TraitReference, TraitDeclaration, TraitMethod
	../syntax/module_syntax: Documentation
	../syntax/names: WrittenName
	../tables/diagnostic_code: PlainSyntaxCode(ExpectedSupertraitOrMethodsDiagnostic)
	../tables/expected_token:
		NameConstruct(NameInTraitName), ExpectedTokenDiagnostic(ExpectedColon, ExpectedNewline, ExpectedIndent),
		ColonConstruct(ColonInTraitName), NewlineConstruct(NewlineInTraitMethods), IndentConstruct(IndentInTraitMethods)
	../tables/row_kinds: Visibility
	../tables/span: Span, span_covering
	../tables/token: TokenKind(ColonSymbol, PlusSymbol, NewlineToken, IndentToken, DedentToken, EndOfFileToken)
	parse_state:
		ParseState, current_kind, current_span, previous_span, position, advanced, diagnostic_count,
		consume_declared_name, expect_token, report_at_current, finished_trait, finished_trait_method
	stop_reason: StopPoint, Recognition(Recognized, Declined)
	tree_body_parser: complete_body
	tree_type_parameter_parser: TypeParametersParse(NoTypeParameters, ParsedTypeParameters, RejectedTypeParameters), parse_type_parameters
	tree_trait_reference_parser: parse_trait_reference
	tree_trait_method_header_parser:
		MethodBodyPresence(AbstractMethod, DefaultBodyFollows), TraitMethodHeadParse(ParsedTraitMethodHead, RejectedTraitMethodHead),
		parse_trait_method_head


---
A trait's header: everything before its methods. `span` runs from the
declaration's start through its name or last supertrait.
---
record TraitHeader {
	visibility: Visibility,
	documentation: Option[Documentation],
	name: WrittenName,
	type_parameters: List[TypeParameter],
	supertraits: List[TraitReference],
	span: Span
}


---
A trait read in full; a trait with a diagnostic; or the header of a trait
with a default body the tree parser does not read, and why.
---
union TraitParse:
	ParsedTrait(TraitDeclaration)
	RejectedTrait
	DeclinedTrait(TraitHeader, StopPoint)


-- One method: read and minted, rejected with its diagnostics (the trait reads
-- on), or a default body the tree parser does not read (the trait stops).
private union TraitMethodParse:
	ParsedMethod(TraitMethod)
	RejectedMethod
	DeclinedMethod(StopPoint)


-- The cursor is at `trait`; start includes caller-owned prefixes, if any. A
-- declined trait leaves the state after its header: the header's ids stay
-- issued and nothing of its methods does.
pure func parse_trait(state: ParseState, visibility: Visibility, documentation: Option[Documentation], start: Span) -> (ParseState, TraitParse):
	before: Int = state.diagnostic_count()
	name_position: Span = state.advanced().current_span()
	(after_name, name) = state.advanced().consume_declared_name(NameInTraitName)
	(after_parameters, parsed_parameters) = parse_type_parameters(after_name)
	parameters: Option[List[TypeParameter]] = match parsed_parameters:
		NoTypeParameters:
			Some([])
		ParsedTypeParameters(parameters, _):
			Some(parameters)
		RejectedTypeParameters:
			None

	var out: ParseState = after_parameters.expect_token(ColonSymbol, ExpectedColon(ColonInTraitName))
	var end: Span = name_position
	var supertraits: List[TraitReference] = []
	var methods: List[TraitMethod] = []
	var stopped: Option[StopPoint] = None
	var has_methods: Bool = False

	if out.current_kind() == NewlineToken:
		has_methods = True
	else if out.at_block_end():
		out = out.report_at_current(ExpectedSupertraitOrMethodsDiagnostic)
	else:
		var parsing: Bool = True

		-- EOF after a trailing plus intentionally ends this frozen loop.
		-- Header extent follows consumed reference tokens, not the plus.
		while parsing and out.current_kind() != EndOfFileToken:
			(after_supertrait, supertrait) = parse_trait_reference(out, NameInTraitName)
			out = after_supertrait
			supertraits = supertraits.append(supertrait)
			end = out.previous_span()

			if out.current_kind() == PlusSymbol:
				out = out.advanced()
			else:
				parsing = False

		if out.current_kind() == ColonSymbol:
			out = out.advanced()
			has_methods = True

	after_header: ParseState = out
	header_end: Span = end

	if has_methods:
		out = out
			.expect_token(NewlineToken, ExpectedNewline(NewlineInTraitMethods))
			.expect_token(IndentToken, ExpectedIndent(IndentInTraitMethods))
			.skip_newlines()

		-- Every token enters method recovery, including unsupported prefixes.
		-- Missing indentation does not create a source-column sibling guard.
		while not out.at_block_end() and stopped.is_none():
			method_start: Int = out.position()
			(after_method, parsed_method) = parse_trait_method(out)
			out = after_method.skip_newlines()

			match parsed_method:
				ParsedMethod(method):
					methods = methods.append(method)
				RejectedMethod:
					()
				DeclinedMethod(stop):
					stopped = Some(stop)

			if out.position() == method_start and not out.at_block_end():
				out = out.advanced()

		if out.current_kind() == DedentToken:
			end = out.current_span()
			out = out.advanced()

	if out.diagnostic_count() != before:
		-- A diagnostic before a default body the parser does not read rejects
		-- the trait. One after that body is not seen, since the trait stops
		-- reading there (`DISCOVERY_REDESIGN.md`, section 9, D10).
		(out, RejectedTrait)
	else:
		match (name, parameters, stopped):
			(Some(name), Some(parameters), Some(stop)):
				(after_header, DeclinedTrait({
					visibility = visibility, documentation = documentation, name = name,
					type_parameters = parameters, supertraits = supertraits, span = start.span_covering(header_end)
				}, stop))
			(Some(name), Some(parameters), None):
				(declared, declaration) = out.finished_trait(visibility, documentation, name, parameters, supertraits, methods, start.span_covering(end))
				(declared, ParsedTrait(declaration))
			_:
				(out, RejectedTrait)


-- A method's header, then its default body read in full, then its definition.
private pure func parse_trait_method(state: ParseState) -> (ParseState, TraitMethodParse):
	(after_header, parsed) = parse_trait_method_head(state)
	match parsed:
		RejectedTraitMethodHead:
			(after_header, RejectedMethod)
		ParsedTraitMethodHead(preview):
			match preview.body_presence:
				AbstractMethod:
					(declared, method) = after_header.finished_trait_method(preview.header.signature, None, preview.header.span)
					(declared, ParsedMethod(method))
				DefaultBodyFollows:
					(completed, body) = complete_body(after_header)
					match body:
						Recognized(read):
							(declared, method) = completed.finished_trait_method(
								preview.header.signature, Some(read.body), preview.header.span.span_covering(read.span)
							)
							(declared, ParsedMethod(method))
						Declined(stop):
							(after_header, DeclinedMethod(stop))


private pure func at_block_end(state: ParseState) -> Bool:
	state.current_kind() == DedentToken or state.current_kind() == EndOfFileToken


private pure func skip_newlines(state: ParseState) -> ParseState:
	var out: ParseState = state

	while out.current_kind() == NewlineToken:
		out = out.advanced()

	out
