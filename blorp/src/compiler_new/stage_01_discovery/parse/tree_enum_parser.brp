-- Enum cases are names; parentheses are parsed only to recover diagnostics.
import:
	../syntax/declarations: EnumDeclaration, EnumCase
	../syntax/module_syntax: Documentation
	../syntax/diagnostics: SyntaxDiagnostic(Plain)
	../tables/diagnostic_code: PlainSyntaxCode(EnumCaseParenthesesDiagnostic)
	../tables/expected_token:
		NameConstruct(NameInTypeName), ExpectedTokenDiagnostic(ExpectedColon, ExpectedNewline, ExpectedIndent),
		ColonConstruct(ColonInUnionVariants), NewlineConstruct(NewlineInUnionVariants), IndentConstruct(IndentInUnionVariants)
	../tables/row_kinds: Visibility
	../tables/span: Span, span_covering
	../tables/token: TokenKind(ColonSymbol, NewlineToken, IndentToken, DedentToken, EndOfFileToken, LeftParenSymbol)
	parse_state:
		ParseState, diagnostic_count, consume_ordinary_name, consume_variant_name, current_kind, current_span, position,
		advanced, expect_token, report_diagnostic, finished_enum_case, finished_enum
	tree_union_parser: parse_variant_fields


union EnumParse:
	ParsedEnum(EnumDeclaration)
	RejectedEnum


pure func parse_enum(state: ParseState, visibility: Visibility, documentation: Option[Documentation], start: Span) -> (ParseState, EnumParse):
	before: Int = state.diagnostic_count()
	(after_name, parsed_name) = state.consume_ordinary_name(NameInTypeName)

	match parsed_name:
		None:
			(after_name, RejectedEnum)
		Some(name):
			var out: ParseState = after_name
				.expect_token(ColonSymbol, ExpectedColon(ColonInUnionVariants))
				.expect_token(NewlineToken, ExpectedNewline(NewlineInUnionVariants))
				.expect_token(IndentToken, ExpectedIndent(IndentInUnionVariants))
			var cases: List[EnumCase] = []

			while out.current_kind() == NewlineToken:
				out = out.advanced()

			while out.current_kind() != DedentToken and out.current_kind() != EndOfFileToken:
				previous: Int = out.position()
				(after_case, parsed_case) = parse_case(out)
				out = after_case

				match parsed_case:
					Some(parsed_case):
						cases = cases.append(parsed_case)
					None:
						()

				while out.current_kind() == NewlineToken:
					out = out.advanced()

				if out.position() == previous and out.current_kind() != DedentToken and out.current_kind() != EndOfFileToken:
					out = out.advanced()

			var end: Span = name.span

			if out.current_kind() == DedentToken:
				end = out.current_span()
				out = out.advanced()

			if out.diagnostic_count() != before:
				(out, RejectedEnum)
			else:
				(finished, declaration) = out.finished_enum(visibility, documentation, name, cases, start.span_covering(end))
				(finished, ParsedEnum(declaration))


private pure func parse_case(state: ParseState) -> (ParseState, Option[EnumCase]):
	before: Int = state.diagnostic_count()
	name_span: Span = state.current_span()
	(after_name, name) = state.consume_variant_name()
	checked: ParseState = if after_name.current_kind() == LeftParenSymbol:
		after_name.report_diagnostic(name_span, Plain(EnumCaseParenthesesDiagnostic))
	else:
		after_name
	(after_fields, _, end) = parse_variant_fields(checked, name_span)

	match name:
		None:
			(after_fields, None)
		Some(name):
			if after_fields.diagnostic_count() != before:
				(after_fields, None)
			else:
				(finished, declaration) = after_fields.finished_enum_case(name, name.span.span_covering(end))
				(finished, Some(declaration))
