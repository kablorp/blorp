-- Top-level declarations, parsed into definition, member, signature and
-- type rows. Function declarations, bodies and global values are parsed by
-- the body parser.
--
-- Every declaration reads its `DefinitionId` before appending its row, appends
-- the row with the span known so far, appends its members and signature, and
-- replaces the row with its final span at the end.
import:
	../tables/builder:
		DiscoveryBuilder,
		ForeignBlockOpening,
		OwnedRows,
		advance_token,
		append_foreign_argument,
		append_foreign_binding,
		append_foreign_c_name,
		append_import_block,
		append_module_documentation,
		append_pending_docstring,
		append_plain_diagnostic,
		append_resource_cleanup,
		append_syntax_diagnostic,
		close_foreign_block,
		move_token_cursor,
		next_definition_id,
		open_foreign_block,
		opened_foreign_block,
		pending_annotation_count,
		pending_docstring_count,
	../tables/diagnostic_code:
		PlainSyntaxCode(
			UnionVariantTooManyFieldsDiagnostic, AnnotationWithoutFunctionDiagnostic,
			EnumCaseParenthesesDiagnostic,
			BuiltinTypeArgumentsDiagnostic, DocstringBeforeImportBlockDiagnostic,
			ExpectedCleanupBuiltinNameDiagnostic, ExpectedDeclarationDiagnostic,
			ExpectedForeignArgumentDiagnostic, ExpectedForeignArgumentValueDiagnostic,
			ExpectedForeignCNameDiagnostic, ExpectedForeignFunctionDiagnostic,
			ExpectedImplMethodDiagnostic, ExpectedSupertraitOrMethodsDiagnostic,
			ForeignFunctionOutsideBlockDiagnostic,
		),
		SyntaxDiagnostic(DuplicateField, FixedRecordParameters),
	../tables/expected_token:
		ArrowConstruct(ArrowInForeignFunctionReturnType),
		ColonConstruct(
			ColonInFieldName, ColonInForeignBlockArgumentName, ColonInForeignHeader,
			ColonInImplementationMethods, ColonInTraitName, ColonInUnionVariants,
		),
		CommaConstruct(CommaInForeignBlockArguments),
		EqualConstruct(EqualInBuiltinTypeMarker, EqualInTopLevelVariable, EqualInTypeAliasTarget),
		ExpectedTokenDiagnostic(ExpectedArrow, ExpectedComma, ExpectedRightParen),
		IndentConstruct(
			IndentInForeignBlock, IndentInImplementationMethods, IndentInTraitMethods,
			IndentInUnionVariants,
		),
		KeywordConstruct(
			KeywordInBuiltinTypeDeclaration, KeywordInBuiltinTypeMarker, KeywordInForeignBlockItem,
			KeywordInImplementationTrait, KeywordInOpaqueType, KeywordInTraitMethodName,
			KeywordInTypeAliasKeyword,
		),
		LeftBraceConstruct(LeftBraceInRecordFields, LeftBraceInStructFields, LeftBraceInFixedRecordFields),
		LeftParenConstruct(LeftParenInForeignFunctionName, LeftParenInTraitMethodName),
		NameConstruct(
			NameInFieldName, NameInForeignBlockArgumentName, NameInForeignFunctionName,
			NameInTraitMethodName, NameInTraitName, NameInTypeAliasName, NameInTypeName,
			NameInVariableName, NameInVariantName,
		),
		NewlineConstruct(
			NewlineInForeignHeader, NewlineInImplementationMethods, NewlineInTraitMethods,
			NewlineInUnionVariants,
		),
		RightBraceConstruct(RightBraceInRecordFields, RightBraceInStructFields, RightBraceInFixedRecordFields),
		RightParenConstruct(
			RightParenInForeignBlockArguments, RightParenInResourceCleanupBuiltinName,
