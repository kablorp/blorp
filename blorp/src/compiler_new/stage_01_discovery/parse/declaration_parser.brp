-- Module.
---
Parses one module's declarations, import blocks and foreign blocks.
---
pure func parse_module_declarations(
	builder: DiscoveryBuilder,
	module: ModuleId,
) -> DiscoveryBuilder:
	definitions_first: Int = builder.definitions.length()
	bodies_first: Int = builder.bodies.length()
	diagnostics_first: Int = builder.module_diagnostics_first()

	var out: DiscoveryBuilder = builder
		.skip_newlines()
		.parse_module_documentation(module)

	while not out.at(EndOfFileToken):
		before: Int = out.token_cursor
		out = out.parse_declaration(module)
		out = out.skip_newlines()

		if out.token_cursor == before and not out.at(EndOfFileToken):
			out = out.advance_token()

	out.report_unpaired_forward_declarations(definitions_first, bodies_first, diagnostics_first)


---
The module docstring: a docstring that opens the module and is followed
directly by `import:`. It is recorded in `module_documentation`; any other
leading docstring belongs to the declaration after it.
---
private pure func parse_module_documentation(
	builder: DiscoveryBuilder,
	module: ModuleId,
) -> DiscoveryBuilder:
	if builder.at(DocStringToken) and builder.docstring_opens_import_block():
		span: Span = builder.current_span()
		text: LiteralId = literal_id_at_row(builder.current_token().payload)
		after: Int = builder.run_end_after(builder.token_cursor + 1, NewlineToken)
		builder
			.move_token_cursor(after)
			.append_module_documentation({
				module = module,
				text = text,
				span = span,
			})
	else:
		builder


---
Whether the docstring at the cursor is followed, past its newlines, by `import`.
---
private pure func docstring_opens_import_block(builder: DiscoveryBuilder) -> Bool:
	after: Int = builder.run_end_after(builder.token_cursor + 1, NewlineToken)
	builder.token_kind_at(after) == ImportKeyword


---
One top-level item: a docstring, annotations and `pure` may precede it.
---
pure func parse_declaration(builder: DiscoveryBuilder, module: ModuleId) -> DiscoveryBuilder:
	var start: Span = builder.current_span()
	docstring_first: Int = builder.pending_docstring_count()
	var out: DiscoveryBuilder = builder.consume_docstring()
	docstring: RowRange = {
		first = docstring_first,
		count = out.pending_docstring_count() - docstring_first
	}
	documented: Bool = docstring.count > 0
	docstring_span: Span = start

	annotation_start: Span = out.current_span()
	annotations_first: Int = out.pending_annotation_count()
	out = out.consume_annotations(SkipNewlines)
	annotations: RowRange = out.annotations_since(annotations_first)

	if annotations.count > 0 and not documented:
		start = annotation_start

	var purity: Purity = ImpureFunction

	if out.at(PureKeyword):
		purity = PureFunction

		if not documented and annotations.count == 0:
			start = out.current_span()

		out = out.advance_token()

	if annotations.count > 0 and not out.at(FuncKeyword):
		out = out.report_at_current(AnnotationWithoutFunctionDiagnostic)

	-- After the annotation report, like the old parser: both are reported.
	if documented and out.at(ImportKeyword):
		out = out.append_plain_diagnostic(DocstringBeforeImportBlockDiagnostic, docstring_span)

	header: DeclarationHeader = {
		module = module,
		start = start,
		visibility = PublicVisibility,
		purity = purity,
		docstring = docstring,
		annotations = annotations
	}

	out.parse_declaration_introduced_by(header)


---
A docstring at the cursor and the newlines after it, recorded as a pending
docstring for the declaration that follows.
---
private pure func consume_docstring(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	if builder.at(DocStringToken):
		text: LiteralId = literal_id_at_row(builder.current_token().payload)
		after: Int = builder.run_end_after(builder.token_cursor + 1, NewlineToken)
		builder
			.move_token_cursor(after)
			.append_pending_docstring(text)
	else:
		builder


---
The item a header introduces.
---
private pure func parse_declaration_introduced_by(
	builder: DiscoveryBuilder,
	header: DeclarationHeader,
) -> DiscoveryBuilder:
	match builder.current_kind():
		PrivateKeyword:
			builder.parse_private_declaration(header)
		ImportKeyword:
			builder.parse_import_block_declaration(header.module)
		ForeignKeyword:
			builder.parse_foreign_block(header.module, header.start)
		_:
			builder.parse_declaration_after_header(header)


---
The declarations that may follow a header, with or without `private`.
---
private pure func parse_declaration_after_header(
	builder: DiscoveryBuilder,
	header: DeclarationHeader,
) -> DiscoveryBuilder:
	match builder.current_kind():
		FuncKeyword:
			builder.parse_function(header, TopLevelFunction)
		VarKeyword:
			builder
				.advance_token()
				.parse_global(header, MutableGlobal)
		RecordKeyword:
			builder.parse_record(header, RecordType)
		StructKeyword:
			builder.parse_record(header, StructType)
		UnionKeyword:
			builder.parse_union(header, UnionType)
		EnumKeyword:
			builder.parse_union(header, EnumType)
		TypeKeyword:
			if builder.peek_kind(1) == AliasKeyword:
				builder
					.advance_token()
					.parse_type_alias(header, AliasType, AliasKeyword)
			else:
				builder.parse_builtin_type(header, BuiltinType)
		OpaqueKeyword:
			builder
				.advance_token()
				.parse_type_alias(header, OpaqueType, TypeKeyword)
		ResourceKeyword:
			builder
				.advance_token()
				.parse_builtin_type(header, ResourceType)
		TraitKeyword:
			builder.parse_trait(header)
		ImplementsKeyword:
			builder.parse_impl(header)
		IdentifierToken:
			if builder.current_token().payload == name_id_index(FIXED_NAME) and builder.peek_kind(1) == RecordKeyword:
				builder.advance_token().parse_record(header, FixedRecordType)
			else:
				builder.parse_global(header, ConstantGlobal)
		UnderscoreSymbol:
			builder.parse_global(header, ConstantGlobal)
		_:
			if builder.reserved_keyword_starts_binding():
				builder.parse_global(header, ConstantGlobal)
			else:
				builder.parse_error_declaration()


---
A reserved keyword written where a global's name belongs (`type = 1`),
recognized so the global still parses after the reserved-name report.
---
private pure func reserved_keyword_starts_binding(builder: DiscoveryBuilder) -> Bool:
	kind: TokenKind = builder.current_kind()
	after: TokenKind = builder.peek_kind(1)
	(
		kind
			.keyword_name_index()
			.is_some()
		and (after == EqualSymbol or after == ColonSymbol)
	)


private pure func parse_error_declaration(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	end_of_source: Bool = builder.at(EndOfFileToken)
	out: DiscoveryBuilder = builder.report_at_current(ExpectedDeclarationDiagnostic)

	if not end_of_source:
		out.advance_token()
	else:
		out


---
`private` then any declaration but an import or foreign block; annotations
and `pure` may follow `private`.
---
private pure func parse_private_declaration(
	builder: DiscoveryBuilder,
	header: DeclarationHeader,
) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = builder.advance_token()
	annotations_first: Int = out.pending_annotation_count()
	out = out.consume_annotations(LeaveNewlines)
	added_annotations: Int = out.pending_annotation_count() - annotations_first
	var purity: Purity = header.purity

	if out.at(PureKeyword):
		purity = PureFunction
		out = out.advance_token()

	-- The header's annotations were the last pending rows before `private`,
	-- so they and the ones after it form one block.
	all_annotations: RowRange = out.annotations_since(header.annotations.first)

	if added_annotations > 0 and not out.at(FuncKeyword):
		out = out.report_at_current(AnnotationWithoutFunctionDiagnostic)

	private_header: DeclarationHeader = { header |
		visibility = PrivateVisibility,
		purity = purity,
		annotations = all_annotations
	}
	out.parse_declaration_after_header(private_header)


-- Globals.
---
`name [: T] = value` after `var` (the caller consumed it) or at the start.
---
private pure func parse_global(
	builder: DiscoveryBuilder,
	header: DeclarationHeader,
	form: GlobalForm,
) -> DiscoveryBuilder:
	name_span: Span = builder.current_span()
	name: NameId = builder.binder_name_at_cursor()
	var out: DiscoveryBuilder = builder.consume_binder_name(NameInVariableName)
	opening: GlobalOpening = out.global_opening(header, form, name, name_span)
	out = out.open_global(opening)

	if out.at(ColonSymbol):
		out = out.advance_token()
		out = out.parse_type()
		declared_type: NodeId = out.last_node_id()
		out = out.append_global_type(opening, declared_type)

	-- The value is parsed even when the `=` is missing, as the existing
	-- parser does.
	out = out.expect_equal(EqualInTopLevelVariable)
	out = out.parse_global_value(header.module, opening, header.start)
	end: Span = out.node_span(out.last_node_id())
	out.close_global(opening, end)


-- Records and structs.
---
`record Name[T] {fields}` or `struct Name {fields}`.
---
private pure func parse_record(
	builder: DiscoveryBuilder,
	header: DeclarationHeader,
	form: RecordForm,
) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = builder.advance_token()
	name: NameId = out.declared_name_at_cursor()
	name_span: Span = out.current_span()
	out = out.consume_declared_name(NameInTypeName)
	opening: RecordOpening = out.record_opening(header, form, name, name_span)
	out = out.open_record(opening)
	owned: OwnedRows = opening.record_rows()

	left_brace: LeftBraceConstruct = match form:
		RecordType:
			LeftBraceInRecordFields
		StructType:
			LeftBraceInStructFields
		FixedRecordType:
			LeftBraceInFixedRecordFields

	closing: RightBraceConstruct = match form:
		RecordType:
			RightBraceInRecordFields
		StructType:
			RightBraceInStructFields
		FixedRecordType:
			RightBraceInFixedRecordFields

	if form == RecordType:
		out = out.parse_type_parameters(owned)
	else if form == FixedRecordType and out.at(LeftBracketSymbol):
		parameter_span: Span = out.current_span()
		out = out.parse_type_parameters(owned)
		out = out.append_syntax_diagnostic(parameter_span, FixedRecordParameters(name))

	out = out.expect_left_brace(left_brace)

	if not out.at(RightBraceSymbol):
		var parsing: Bool = True

		while parsing and not out.at(EndOfFileToken):
			out = out.parse_field(header.module, opening)

			if out.at(CommaSymbol):
				out = out.advance_token()

				if out.at(RightBraceSymbol):
					parsing = False
			else:
				parsing = False

	end: Span = out.current_span()
	out = out.expect_right_brace(closing)
	out.close_record(opening, end)


private pure func parse_field(
	builder: DiscoveryBuilder,
	module: ModuleId,
	owner: RecordOpening,
) -> DiscoveryBuilder:
	name: NameId = builder.declared_name_at_cursor()
	name_span: Span = builder.current_span()
	header: DeclarationHeader = module.plain_header(name_span, builder.pending_annotation_count())
	opening: FieldOpening = builder.field_opening(header, owner, name, name_span)
	-- Read before the field's own row is appended, so it cannot find itself.
	earlier: Option[DefinitionId] = builder.earlier_field_named(owner, name)
	var out: DiscoveryBuilder = builder
		.consume_declared_name(NameInFieldName)
		.open_field(opening)
		.expect_colon(ColonInFieldName)
		.parse_type()
		.report_duplicate_field(earlier, name_span)
	field_type: NodeId = out.last_node_id()
	out = out.append_field_type(opening, field_type)
	end: Span = out.node_span(field_type)
	out.close_field(opening, end)


---
Reports at `name_span` that the field repeats `earlier`, a field of the same
declaration. The field names of a declaration are local to it, so the parser sees
the repeat first. It is reported after the field's type, as the existing parser
does, so both front ends order their diagnostics alike.
---
private pure func report_duplicate_field(
	builder: DiscoveryBuilder,
	earlier: Option[DefinitionId],
	name_span: Span,
) -> DiscoveryBuilder:
	match earlier:
		Some(first):
			builder.append_syntax_diagnostic(name_span, DuplicateField(first))
		None:
			builder


---
The first field of `owner` named `name`, found among the definition rows after the
record's own. A record is parsed before the next declaration begins, so every row
after its own is one of its fields. A missing name is no name, so it repeats
nothing.
---
private pure func earlier_field_named(
	builder: DiscoveryBuilder,
	owner: RecordOpening,
	name: NameId,
) -> Option[DefinitionId]:
	var found: Option[DefinitionId] = None
	var index: Int = owner
		.record_definition()
		.definition_id_index() + 1

	while (
		found.is_none()
		and index < builder.definitions.length()
		and not name.name_ids_equal(EMPTY_NAME)
	):
		match builder.definitions.get(index):
			Some(row):
				if row.kind == FieldDefinition and row.name.name_ids_equal(name):
					found = Some(definition_id_at_row(index))
			None:
				-- Unreachable: `index` is below the length.
				void

		index += 1

	found


-- Unions and enums.
---
`union Name[T]:` or `enum Name:` then an indented block of variants.
---
private pure func parse_union(
	builder: DiscoveryBuilder,
	header: DeclarationHeader,
	form: UnionForm,
) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = builder.advance_token()
	name: NameId = out.declared_name_at_cursor()
	name_span: Span = out.current_span()
	out = out.consume_declared_name(NameInTypeName)
	opening: UnionOpening = out.union_opening(header, form, name, name_span)
	out = out.open_union(opening)
	owned: OwnedRows = opening.union_rows()

	if form == UnionType:
		out = out.parse_type_parameters(owned)

	out = out.expect_colon(ColonInUnionVariants)
	out = out.expect_newline(NewlineInUnionVariants)
	out = out.expect_indent(IndentInUnionVariants)
	out = out.skip_newlines()

	while not out.at_block_end():
		before: Int = out.token_cursor
		out = out.parse_variant(header.module, opening, form)
		out = out.skip_newlines()

		if out.token_cursor == before and not out.at_block_end():
			out = out.advance_token()

	var end: Span = name_span

	if out.at(DedentToken):
		end = out.current_span()

	-- A dedent is missing here only after an earlier diagnostic has reported it.
	out = out.skip_optional_token(DedentToken)
	out.close_union(opening, end)


---
Consumes a variant's name; `True` and `False` are variant names too.
---
private pure func consume_variant_name(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	if builder.at(TrueKeyword) or builder.at(FalseKeyword):
		builder.advance_token()
	else:
		builder.consume_declared_name(NameInVariantName)


---
`Name` or `Name(T, ...)`; `True` and `False` are variant names too. An `enum`
case is only a name, so parentheses on one are reported, at the case's name.
---
private pure func parse_variant(
	builder: DiscoveryBuilder,
	module: ModuleId,
	owner: UnionOpening,
	form: UnionForm,
) -> DiscoveryBuilder:
	name_span: Span = builder.current_span()
	name: NameId = builder.declared_name_at_cursor()
	header: DeclarationHeader = module.plain_header(name_span, builder.pending_annotation_count())
	opening: VariantOpening = builder.variant_opening(header, owner, name, name_span)
	variant_rows: OwnedRows = opening.variant_rows()
	var out: DiscoveryBuilder = builder
		.consume_variant_name()
		.open_variant(opening)
	var end: Span = name_span

	if out.at(LeftParenSymbol):
		-- An `enum` case is only a name, so its parentheses are reported even
		-- when they are empty; they are still parsed so recovery skips them.
		if form == EnumType:
			out = out.append_plain_diagnostic(EnumCaseParenthesesDiagnostic, name_span)

		out = out.advance_token()

		if not out.at(RightParenSymbol):
			var parsing: Bool = True

			while parsing and not out.at(EndOfFileToken):
				out = out.parse_variant_payload_type()
				payload: NodeId = out.last_node_id()
				out = out.append_variant_payload(opening, payload)

				-- Reported once, at the field that passes the limit.
				if out.variant_payloads.length() - variant_rows.variant_payloads_first == MAX_UNION_VARIANT_FIELDS + 1:
					out = out.append_plain_diagnostic(
						UnionVariantTooManyFieldsDiagnostic,
						name_span,
					)

				if out.at(CommaSymbol):
					out = out.advance_token()

					if out.at(RightParenSymbol):
						parsing = False
				else:
					parsing = False

		if out.at(RightParenSymbol):
			end = out.current_span()
			out = out.advance_token()
		else:
			out = out.report_expected(ExpectedRightParen(RightParenInVariantFields))

	out.close_variant(opening, end)


-- Builtin types and aliases.
---
`type Name[T] = builtin`, or after `resource` (consumed by the caller)
`type Name[T] = builtin("cleanup")`.
---
private pure func parse_builtin_type(
	builder: DiscoveryBuilder,
	header: DeclarationHeader,
	form: BareTypeForm,
) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = builder.expect_keyword_token(
		TypeKeyword,
		KeywordInBuiltinTypeDeclaration,
	)
	name: NameId = out.declared_name_at_cursor()
	name_span: Span = out.current_span()
	out = out.consume_declared_name(NameInTypeName)
	opening: BareTypeOpening = out.bare_type_opening(header, form, name, name_span)
	out = out.open_bare_type(opening)
	definition: DefinitionId = opening.bare_type_definition()
	owned: OwnedRows = opening.bare_type_rows()
	out = out.parse_type_parameters(owned)
	out = out.expect_equal(EqualInBuiltinTypeMarker)
	var end: Span = out.current_span()
	out = out.expect_keyword_token(BuiltinKeyword, KeywordInBuiltinTypeMarker)

	if out.at(LeftParenSymbol):
		if form == ResourceType:
			out = out.advance_token()

			match out.string_literal_at_cursor():
				Some(builtin_name):
					cleanup_span: Span = out.current_span()
					out = out.advance_token()
					out = out.append_resource_cleanup({
						definition = definition,
						builtin_name = builtin_name,
						span = cleanup_span,
					})
					end = cleanup_span
				None:
					out = out.report_and_recover(ExpectedCleanupBuiltinNameDiagnostic)

			if out.at(RightParenSymbol):
				end = out.current_span()
				out = out.advance_token()
			else:
				out = out.report_expected(
					ExpectedRightParen(RightParenInResourceCleanupBuiltinName),
				)
		else:
			out = out.report_at_current(BuiltinTypeArgumentsDiagnostic)
			out = out.advance_token()

			while (
				not out.at(RightParenSymbol)
				and not out.at(NewlineToken)
				and not out.at(EndOfFileToken)
			):
				out = out.advance_token()

			if out.at(RightParenSymbol):
				out = out.advance_token()

	out.close_bare_type(opening, end)


---
The `LiteralId` of a plain, raw or pipe string literal at the cursor.
---
private pure func string_literal_at_cursor(builder: DiscoveryBuilder) -> Option[LiteralId]:
	token: Token = builder.current_token()

	match token.kind:
		NormalStringToken | RawStringToken | PipeStringToken | RawPipeStringToken:
			Some(literal_id_at_row(token.payload))
		_:
			None


---
After `type` (consumed by the caller), `alias Name[T] = Target`; after
`opaque`, `type Name[T] = Target`. `second_keyword` is the keyword expected
next.
---
private pure func parse_type_alias(
	builder: DiscoveryBuilder,
	header: DeclarationHeader,
	form: AliasForm,
	second_keyword: TokenKind,
) -> DiscoveryBuilder:
	second_construct: KeywordConstruct = if second_keyword == AliasKeyword:
		KeywordInTypeAliasKeyword
	else:
		KeywordInOpaqueType

	var out: DiscoveryBuilder = builder.expect_keyword_token(second_keyword, second_construct)
	name: NameId = out.declared_name_at_cursor()
	name_span: Span = out.current_span()
	out = out.consume_declared_name(NameInTypeAliasName)
	opening: AliasOpening = out.alias_opening(header, form, name, name_span)
	owned: OwnedRows = opening.alias_rows()
	out = out
		.open_alias(opening)
		.parse_type_parameters(owned)
		.expect_equal(EqualInTypeAliasTarget)
		.parse_type()
	target: NodeId = out.last_node_id()
	out = out.append_alias_target(opening, target)
	end: Span = out.node_span(target)
	out.close_alias(opening, end)


-- Traits and impls.
---
`trait Name[T]:` with a method block, `trait Name: Super + ...`, or both
(`trait Name: Super: methods`).
---
private pure func parse_trait(
	builder: DiscoveryBuilder,
	header: DeclarationHeader,
) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = builder.advance_token()
	name: NameId = out.declared_name_at_cursor()
	name_span: Span = out.current_span()
	out = out.consume_declared_name(NameInTraitName)
	opening: TraitOpening = out.trait_opening(header, name, name_span)
	out = out.open_trait(opening)
	definition: DefinitionId = opening.trait_definition()
	owned: OwnedRows = opening.trait_rows()
	out = out.parse_type_parameters(owned)
	out = out.expect_colon(ColonInTraitName)
	var end: Span = name_span
	var has_methods: Bool = False

	if out.at(NewlineToken):
		has_methods = True
	else if out.at_block_end():
		out = out.report_at_current(ExpectedSupertraitOrMethodsDiagnostic)
	else:
		var parsing: Bool = True

		while parsing and not out.at(EndOfFileToken):
			out = out.parse_trait_reference(SupertraitSink(definition, owned.supertraits_first))
			end = out.previous_span()

			if out.at(PlusSymbol):
				out = out.advance_token()
			else:
				parsing = False

		if out.at(ColonSymbol):
			out = out.advance_token()
			has_methods = True

	if has_methods:
		out = out.expect_newline(NewlineInTraitMethods)
		out = out.expect_indent(IndentInTraitMethods)
		out = out.skip_newlines()

		while not out.at_block_end():
			before: Int = out.token_cursor
			out = out.parse_trait_method(header.module, opening)
			out = out.skip_newlines()

			if out.token_cursor == before and not out.at_block_end():
				out = out.advance_token()

		if out.at(DedentToken):
			end = out.current_span()

		-- A dedent is missing here only after an earlier diagnostic has reported it.
		out = out.skip_optional_token(DedentToken)

	out.close_trait(opening, end)


---
`[pure] func name(params) [-> R] [: default body]`.
---
private pure func parse_trait_method(
	builder: DiscoveryBuilder,
	module: ModuleId,
	owner: TraitOpening,
) -> DiscoveryBuilder:
	start: Span = builder.current_span()

	purity: Purity = if builder.at(PureKeyword):
		PureFunction
	else:
		ImpureFunction

	var out: DiscoveryBuilder = builder.skip_optional_token(PureKeyword)
	keyword_span: Span = out.current_span()
	out = out.expect_keyword_token(FuncKeyword, KeywordInTraitMethodName)
	name: NameId = out.declared_name_at_cursor()
	name_span: Span = out.current_span()
	out = out.consume_declared_name(NameInTraitMethodName)
	header: DeclarationHeader = { module.plain_header(start, out.pending_annotation_count()) |
		purity = purity
	}
	opening: FunctionOpening = out.trait_method_opening(header, owner, name, name_span)
	out = out.open_function(opening)
	out = out.parse_signature(
		opening.function_rows(),
		purity,
		keyword_span,
		LeftParenInTraitMethodName,
	)
	var end: Span = name_span

	if out.at(ArrowSymbol):
		out = out.advance_token()
		out = out.parse_type()
		return_type: NodeId = out.last_node_id()
		out = out.append_function_return_type(opening, return_type)
		end = out.node_span(return_type)

	-- A `:` promises a default body; without a `:` the method is abstract.
	if out.at(ColonSymbol):
		colon_line: Int = out.span_start_line(out.current_span())
		out = out.advance_token()

		if out.function_body_follows(colon_line):
			out = out.parse_function_body(module, opening, start)
			end = out.node_span(out.last_node_id())
		else:
			out = out.report_missing_function_body(name_span)

	out.close_function(opening, end)


---
`implements Trait for Type:` then an indented block of methods.
---
private pure func parse_impl(
	builder: DiscoveryBuilder,
	header: DeclarationHeader,
) -> DiscoveryBuilder:
	keyword_span: Span = builder.current_span()
	var out: DiscoveryBuilder = builder.advance_token()
	trait_name: NameId = out.referenced_name_at_cursor()
	trait_span: Span = out.current_span()
	out = out.consume_referenced_name(NameInTraitName)
	opening: ImplOpening = out.impl_opening(header, IMPL_NAME, keyword_span, trait_name, trait_span)
	out = out.open_impl(opening)
	out = out.expect_keyword_token(ForKeyword, KeywordInImplementationTrait)
	out = out.parse_receiver_type()
	receiver: NodeId = out.last_node_id()
	out = out.append_receiver_type(opening, receiver)
	var end: Span = out.node_span(receiver)
	out = out.expect_colon(ColonInImplementationMethods)
	out = out.expect_newline(NewlineInImplementationMethods)
	out = out.expect_indent(IndentInImplementationMethods)
	out = out.skip_newlines()

	while not out.at_block_end():
		before: Int = out.token_cursor
		out = out.parse_impl_method(header.module, opening)
		out = out.skip_newlines()

		if out.token_cursor == before and not out.at_block_end():
			out = out.advance_token()

	if out.at(DedentToken):
		end = out.current_span()

	-- A dedent is missing here only after an earlier diagnostic has reported it.
	out = out.skip_optional_token(DedentToken)
	out.close_impl(opening, end)


---
One impl method: annotations, `pure`, then a full function declaration.
---
private pure func parse_impl_method(
	builder: DiscoveryBuilder,
	module: ModuleId,
	owner: ImplOpening,
) -> DiscoveryBuilder:
	-- The method starts at its first annotation, else at `pure`, else at
	-- `func`, as in the existing parser.
	var start: Span = builder.current_span()
	annotations_first: Int = builder.pending_annotation_count()
	var out: DiscoveryBuilder = builder.consume_annotations(SkipNewlines)
	annotations: RowRange = out.annotations_since(annotations_first)
	var purity: Purity = ImpureFunction

	if out.at(PureKeyword):
		purity = PureFunction

		if annotations.count == 0:
			start = out.current_span()

		out = out.advance_token()

	if out.at(FuncKeyword):
		header: DeclarationHeader = { module.plain_header(start, annotations.first) |
			purity = purity,
			annotations = annotations
		}
		out = out.parse_impl_method_function(header, owner)
		out
	else:
		block_end: Bool = out.at_block_end()
		out = out.report_at_current(ExpectedImplMethodDiagnostic)

		if not block_end:
			out = out.advance_token()

		out


-- Import and foreign blocks.
---
An import block, recorded with its span and its block of import rows.
---
private pure func parse_import_block_declaration(
	builder: DiscoveryBuilder,
	module: ModuleId,
) -> DiscoveryBuilder:
	start: Span = builder.current_span()
	imports_first: Int = builder.imports.length()
	out: DiscoveryBuilder = builder.parse_import_block(module)
	imports_count: Int = out.imports.length() - imports_first

	-- The block ends at its closing dedent, as in the existing parser; a block
	-- the parser left unclosed (already reported) ends at its `import`.
	end: Span = if out.token_kind_at(out.token_cursor - 1) == DedentToken:
		out.previous_span()
	else:
		start

	out.append_import_block({
		module = module,
		imports = {
			first = imports_first,
			count = imports_count
		},
		span = start.span_covering(end),
	})


---
`foreign [(name: "value", ...)]:` then an indented block of foreign function
signatures. `foreign func` without a block is reported.
---
private pure func parse_foreign_block(
	builder: DiscoveryBuilder,
	module: ModuleId,
	start: Span,
) -> DiscoveryBuilder:
	-- Read before the builder is handed on: the block opens where the `foreign`
	-- keyword is, and the keyword appends no row.
	opening: ForeignBlockOpening = builder.open_foreign_block(module, start)
	var out: DiscoveryBuilder = builder.advance_token()

	if out.at(PureKeyword) or out.at(FuncKeyword):
		out = out.append_plain_diagnostic(ForeignFunctionOutsideBlockDiagnostic, start)
		out = out.advance_token()
		out
	else:
		block: ForeignBlockId = opening.opened_foreign_block()

		if out.at(LeftParenSymbol):
			out = out.advance_token()
			out = out.parse_foreign_arguments()
			out = out.expect_right_paren(RightParenInForeignBlockArguments)

		out = out.expect_colon(ColonInForeignHeader)
		out = out.expect_newline(NewlineInForeignHeader)
		out = out.expect_indent(IndentInForeignBlock)
		out = out.skip_newlines()

		while not out.at_block_end():
			before: Int = out.token_cursor

			if out.starts_foreign_function():
				out = out.parse_foreign_function(module, block)
				out = out.skip_newlines()
			else:
				block_end: Bool = out.at_block_end()
				out = out.report_at_current(ExpectedForeignFunctionDiagnostic)

				if not block_end:
					out = out.advance_token()

				out = out.skip_newlines()

			if out.token_cursor == before and not out.at_block_end():
				out = out.advance_token()

		var end: Span = start

		if out.at(DedentToken):
			end = out.current_span()

		-- A dedent is missing here only after an earlier diagnostic has reported it.
		out = out.skip_optional_token(DedentToken)
		out = out.close_foreign_block(opening, end)
		out


private pure func starts_foreign_function(builder: DiscoveryBuilder) -> Bool:
	match builder.current_kind():
		PrivateKeyword | PureKeyword | FuncKeyword | AtSymbol:
			True
		_:
			False


---
`name: "value", ...` inside the foreign block's parentheses.
---
private pure func parse_foreign_arguments(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = builder

	if out.at(RightParenSymbol):
		out = out.report_at_current(ExpectedForeignArgumentDiagnostic)
	else:
		while not out.at(RightParenSymbol) and not out.at(EndOfFileToken):
			out = out.parse_foreign_argument()

	out


---
One `name: "value"` and the comma after it. It always moves the cursor unless
the cursor is at the `)`, so the list above ends.
---
private pure func parse_foreign_argument(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	before: Int = builder.token_cursor
	name: NameId = builder.referenced_name_at_cursor()
	name_span: Span = builder.current_span()
	var out: DiscoveryBuilder = builder
		.consume_referenced_name(NameInForeignBlockArgumentName)
		.expect_colon(ColonInForeignBlockArgumentName)

	match out.string_literal_at_cursor():
		Some(value):
			value_span: Span = out.current_span()
			out = out.advance_token()
			out = out.append_foreign_argument({
				name = name,
				value = value,
				name_span = name_span,
				span = name_span.span_covering(value_span),
			})
		None:
			out = out.report_and_recover(ExpectedForeignArgumentValueDiagnostic)

	if out.at(CommaSymbol):
		out = out.advance_token()
	else if not out.at(RightParenSymbol):
		out = out.report_expected(ExpectedComma(CommaInForeignBlockArguments))

	if out.token_cursor == before and not out.at(RightParenSymbol):
		out = out.advance_token()

	out


---
`[private] [@annotations] [pure] func name(params) -> R [= "c_name"]`.
---
private pure func parse_foreign_function(
	builder: DiscoveryBuilder,
	module: ModuleId,
	block: ForeignBlockId,
) -> DiscoveryBuilder:
	start: Span = builder.current_span()

	visibility: Visibility = if builder.at(PrivateKeyword):
		PrivateVisibility
	else:
		PublicVisibility

	var out: DiscoveryBuilder = builder.skip_optional_token(PrivateKeyword)
	annotations_first: Int = out.pending_annotation_count()
	out = out.consume_annotations(LeaveNewlines)
	annotations: RowRange = out.annotations_since(annotations_first)
	var purity: Purity = ImpureFunction

	if out.at(PureKeyword):
		purity = PureFunction
		out = out.advance_token()

	keyword_span: Span = out.current_span()
	out = out.expect_keyword_token(FuncKeyword, KeywordInForeignBlockItem)
	name: NameId = out.declared_name_at_cursor()
	name_span: Span = out.current_span()
	out = out.consume_declared_name(NameInForeignFunctionName)
	header: DeclarationHeader = { module.plain_header(start, annotations.first) |
		visibility = visibility,
		purity = purity,
		annotations = annotations
	}
	opening: ForeignFunctionOpening = out.foreign_function_opening(header, name, name_span)
	out = out.open_foreign_function(opening)
	definition: DefinitionId = opening.foreign_function_definition()
	out = out.append_foreign_binding({
		definition = definition,
		block = block,
	})
	out = out.parse_signature(
		opening.foreign_function_rows(),
		purity,
		keyword_span,
		LeftParenInForeignFunctionName,
	)
	var end: Span = name_span

	if out.at(ArrowSymbol):
		out = out.advance_token()
		out = out.parse_type()
		return_type: NodeId = out.last_node_id()
		out = out.append_foreign_return_type(opening, return_type)
		end = out.node_span(return_type)
	else:
		end = out.span_before_current()
		out = out.report_expected(ExpectedArrow(ArrowInForeignFunctionReturnType))

	if out.at(EqualSymbol):
		out = out.advance_token()

		match out.string_literal_at_cursor():
			Some(c_name):
				c_name_span: Span = out.current_span()
				out = out.advance_token()
				out = out.append_foreign_c_name({
					definition = definition,
					c_name = c_name,
					span = c_name_span,
				})
				end = c_name_span
			None:
				out = out.report_and_recover(ExpectedForeignCNameDiagnostic)

	out.close_foreign_function(opening, end)
