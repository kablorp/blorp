-- A direct written trait reference, shared by bounds and supertraits.
import:
	../syntax/declarations: TraitReference
	../tables/expected_token: NameConstruct
	../tables/span: span_covering
	../tables/token: TokenKind(DotSymbol)
	parse_state: ParseState, current_kind, advanced, consume_referenced_name, finished_name_use


pure func parse_trait_reference(state: ParseState, construct: NameConstruct) -> (ParseState, TraitReference):
	(after_name, name) = state.consume_referenced_name(construct)
	(after_first, first) = after_name.finished_name_use(name)

	if after_first.current_kind() == DotSymbol:
		(after_name, name) = after_first.advanced().consume_referenced_name(construct)
		(after_second, second) = after_name.finished_name_use(name)
		(after_second, {
			qualifier = Some(first),
			trait_name = second,
			span = first.name.span.span_covering(second.name.span)
		})
	else:
		(after_first, { qualifier = None, trait_name = first, span = first.name.span })
