-- Written types, type parameters and dimension constraints, parsed into the
-- node table and the declaration side tables.
--
-- A type is appended post-order like any node: each routine appends its root
-- last, so a caller reads the root with `last_node_id` after the call. The
-- shapes and spans follow the existing parser: `Name[#3]` whose arguments are
-- all dimensions is an array type, `()` is the named type `Void`, and `(T)` is
-- `T` itself.
import:
	../tables/builder:
		DefinitionId,
		DiscoveryBuilder,
		NameId,
		NodeId,
		advance_token,
		append_dimension_constraint,
		append_leaf_node,
		append_literal_leaf_node,
		append_name_leaf_node,
		append_named_parent_node,
		append_parent_node,
		append_plain_diagnostic,
		append_type_parameter,
		last_node_id,
		literal_id_at_row,
		name_id_at_row,
		next_node_id,
		node_id_index,
		record_name_span_of_last_node,
	../tables/diagnostic_code:
		DiscoveryDiagnosticCode(
			ArrayDimensionsExpectedDiagnostic, ExpectedArrowDiagnostic, ExpectedDimensionDiagnostic,
			ExpectedEqualEqualDiagnostic, ExpectedHashDiagnostic, ExpectedLeftParenDiagnostic,
			ExpectedRightBracketDiagnostic, ExpectedRightParenDiagnostic, ExpectedTypeDiagnostic,
			TupleArityDiagnostic,
		),
	../tables/name_vocabulary: DISCARD_NAME_INDEX, EMPTY_NAME_INDEX, VOID_NAME_INDEX
	../tables/row_kinds:
		NodeKind(
			ArrayTypeNode, BoundedTypeNode, DimensionAddTypeNode, DimensionDivideTypeNode,
			DimensionLiteralTypeNode, DimensionMultiplyTypeNode, DimensionNameTypeNode,
			DimensionSubtractTypeNode, DimensionWildcardTypeNode, FunctionTypeNode, MissingTypeNode,
			NamedTypeNode, PureFunctionTypeNode, QualifiedTypeNode, RangeTypeNode, TupleTypeNode,
			TypeQualifierNode, VariadicDimensionNameTypeNode, VariadicDimensionWildcardTypeNode,
		),
		ParsedConstruct(
			ArrayDimensions, DimensionExpression, FunctionTypeParameters, GroupedType,
			PureFunctionType, TraitName, TypeArguments, TypeName, TypeParameterName, TypeParameters,
		),
		TypeParameterKind(DimensionParameter, TypeParameter, WildcardDimensionParameter),
	../tables/span: Span, span_covering, spans_equal
	../tables/token:
		Token,
		TokenKind(
			ArrowSymbol, ColonSymbol, CommaSymbol, DimensionNameToken, DotDotDotSymbol,
			DotDotSymbol, DotSymbol, EndOfFileToken, EqualEqualSymbol, HashSymbol, IdentifierToken,
			IntLiteralToken, LeftBracketSymbol, LeftParenSymbol, MinusSymbol, PlusSymbol,
			PureKeyword, RightBracketSymbol, RightParenSymbol, SelfKeyword, SlashSymbol, StarSymbol,
			UnderscoreSymbol, VoidKeyword, WhereKeyword,
		),
	parser_cursor:
		at,
		consume_declared_name,
		consume_referenced_name,
		current_kind,
		current_span,
		current_token,
		declared_name_at_cursor,
		expect_token,
		expect_token_in,
		keyword_name_index,
		peek_kind,
		previous_span,
		referenced_name_at_cursor,
		report_and_recover,
		report_at_current,
		report_at_current_in,
	trait_reference_parser: TraitReferenceSink(BoundSink, InlineBoundSink), parse_trait_reference


---
The most elements a tuple type may have.
---
private MAX_TUPLE_ARITY: Int = 4


pure func node_span(builder: DiscoveryBuilder, node: NodeId) -> Span:
	match builder.nodes.get(node.node_id_index()):
		Some(row):
			row.span
		None:
			builder.current_span()


---
Whether `node` is a dimension: a dimension name, literal, wildcard or
dimension arithmetic.
---
pure func is_dimension_node(builder: DiscoveryBuilder, node: NodeId) -> Bool:
	match builder.nodes.get(node.node_id_index()):
		Some(row):
			match row.kind:
				DimensionNameTypeNode | VariadicDimensionNameTypeNode | DimensionWildcardTypeNode | VariadicDimensionWildcardTypeNode | DimensionLiteralTypeNode | DimensionAddTypeNode | DimensionSubtractTypeNode | DimensionMultiplyTypeNode | DimensionDivideTypeNode:
					True
				_:
					False
		None:
			False


private pure func all_dimensions(builder: DiscoveryBuilder, nodes: List[NodeId]) -> Bool:
	nodes.length() > 0 and nodes.all(pure func(node): builder.is_dimension_node(node))


-- Types.
---
A type expression; bounded arguments (`T: Eq`) are not allowed at the top.
---
pure func parse_type(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	builder.parse_type_allowing_bounds(False)


---
A type expression, with `Name: Bound + Bound` accepted when `allow_bounds`
(inside type argument lists).
---
pure func parse_type_allowing_bounds(
	builder: DiscoveryBuilder,
	allow_bounds: Bool,
) -> DiscoveryBuilder:
	match builder.current_kind():
		IdentifierToken | SelfKeyword | VoidKeyword:
			builder.parse_named_type(allow_bounds)
		PureKeyword:
			builder.parse_pure_function_type()
		DimensionNameToken | HashSymbol | IntLiteralToken:
			builder.parse_dimension_expression()
		DotDotSymbol:
			builder.parse_range_type()
		LeftParenSymbol:
			if builder.starts_parenthesized_dimension(1):
				builder.parse_dimension_expression()
			else:
				builder.parse_parenthesized_type()
		_:
			builder.parse_missing_type()


---
Reports a missing type and appends a `MissingTypeNode` at the offending
token, which is skipped unless it is a soft boundary.
---
private pure func parse_missing_type(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	span: Span = builder.current_span()
	builder
		.report_and_recover(ExpectedTypeDiagnostic)
		.append_leaf_node(MissingTypeNode, span)


---
Whether the token `ahead` of the cursor starts a dimension atom, looking
through nested parentheses: `(#N + 1)` is a dimension, `(Int, #N)` is not.
---
private pure func starts_parenthesized_dimension(builder: DiscoveryBuilder, ahead: Int) -> Bool:
	match builder.peek_kind(ahead):
		HashSymbol | DimensionNameToken | IntLiteralToken:
			True
		LeftParenSymbol:
			builder.starts_parenthesized_dimension(ahead + 1)
		_:
			False


---
The name a type position records for the current token: an identifier, or
`Self` / `void` written as a type name.
---
private pure func type_name_at_cursor(builder: DiscoveryBuilder) -> NameId:
	kind: TokenKind = builder.current_kind()

	if kind == SelfKeyword or kind == VoidKeyword:
		match kind.keyword_name_index():
			Some(index):
				name_id_at_row(index)
			None:
				name_id_at_row(EMPTY_NAME_INDEX)
	else:
		builder.referenced_name_at_cursor()


private pure func consume_type_name(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	kind: TokenKind = builder.current_kind()

	if kind == SelfKeyword or kind == VoidKeyword:
		builder.advance_token()
	else:
		builder.consume_referenced_name(TypeName)


---
`Name`, `Name[args]`, `Module.Name[args]`, or with `allow_bounds`
`Name: Bound + ...`; then any array suffixes.
---
private pure func parse_named_type(
	builder: DiscoveryBuilder,
	allow_bounds: Bool,
) -> DiscoveryBuilder:
	can_qualify: Bool = builder.current_kind() == IdentifierToken
	first_name: NameId = builder.type_name_at_cursor()
	first_span: Span = builder.current_span()
	var out: DiscoveryBuilder = builder.consume_type_name()

	if allow_bounds and out.at(ColonSymbol):
		out = out.advance_token()
		var bounds: List[NodeId] = []
		var end_span: Span = first_span
		var parsing: Bool = True

		while parsing:
			out = out.parse_trait_reference(InlineBoundSink)
			bound: NodeId = out.last_node_id()
			bounds = bounds.append(bound)
			end_span = out.node_span(bound)

			if out.at(PlusSymbol):
				out = out.advance_token()
			else:
				parsing = False

		out = out.append_named_parent_node(
			BoundedTypeNode,
			first_span.span_covering(end_span),
			first_name,
			bounds,
		)
		out = out.record_name_span_of_last_node(first_span)
		out
	else:
		var qualifier: Option[(NameId, Span)] = None
		var type_name: NameId = first_name
		var type_name_span: Span = first_span

		if can_qualify and out.at(DotSymbol):
			out = out.advance_token()
			qualifier = Some((first_name, first_span))
			type_name = out.referenced_name_at_cursor()
			type_name_span = out.current_span()
			out = out.consume_referenced_name(TypeName)

		var arguments: List[NodeId] = []
		var end_span: Span = type_name_span

		if out.at(LeftBracketSymbol):
			out = out.advance_token()

			if not out.at(RightBracketSymbol):
				var parsing: Bool = True

				while parsing and not out.at_end_of_tokens():
					out = out.parse_type_allowing_bounds(True)
					argument: NodeId = out.last_node_id()
					arguments = arguments.append(argument)
					end_span = out.node_span(argument)

					if out.at(CommaSymbol):
						out = out.advance_token()

						if out.at(RightBracketSymbol):
							parsing = False
					else:
						parsing = False

			if out.at(RightBracketSymbol):
				end_span = out.current_span()
				out = out.advance_token()
			else:
				out = out.report_at_current_in(ExpectedRightBracketDiagnostic, TypeArguments)

		name_start: Span = match qualifier:
			Some((_, qualifier_span)):
				qualifier_span
			None:
				type_name_span

		if out.all_dimensions(arguments):
			out = out.append_named_type(
				qualifier,
				type_name,
				type_name_span,
				name_start.span_covering(type_name_span),
				[],
			)
			base: NodeId = out.last_node_id()
			out = out.append_parent_node(
				ArrayTypeNode,
				name_start.span_covering(end_span),
				[base].concat(arguments),
			)
		else:
			out = out.append_named_type(
				qualifier,
				type_name,
				type_name_span,
				name_start.span_covering(end_span),
				arguments,
			)

		out = out.parse_array_suffixes()
		out


---
Appends a named or qualified type node over `arguments`.
---
private pure func append_named_type(
	builder: DiscoveryBuilder,
	qualifier: Option[(NameId, Span)],
	type_name: NameId,
	type_name_span: Span,
	span: Span,
	arguments: List[NodeId],
) -> DiscoveryBuilder:
	match qualifier:
		Some((module_name, module_span)):
			qualifier_node: NodeId = builder.next_node_id()
			builder
				.append_name_leaf_node(TypeQualifierNode, module_span, module_name)
				.append_named_parent_node(
					QualifiedTypeNode,
					span,
					type_name,
					[qualifier_node].concat(arguments),
				)
				.record_name_span_of_last_node(type_name_span)
		None:
			builder
				.append_named_parent_node(NamedTypeNode, span, type_name, arguments)
				.record_name_span_if_narrower(type_name_span, span)


---
Records the name span of the node appended last when it is narrower than the
node (`List[T]`'s `List`).
---
private pure func record_name_span_if_narrower(
	builder: DiscoveryBuilder,
	name_span: Span,
	node_span: Span,
) -> DiscoveryBuilder:
	if name_span.spans_equal(node_span):
		builder
	else:
		builder.record_name_span_of_last_node(name_span)


private pure func at_end_of_tokens(builder: DiscoveryBuilder) -> Bool:
	builder.current_token().kind == EndOfFileToken


---
Array suffixes after a type: each `[dims]` wraps the type so far.
---
private pure func parse_array_suffixes(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = builder

	while out.at(LeftBracketSymbol):
		out = out.parse_array_suffix()

	out


---
One `[dims]` suffix, from its `[`, wrapping the last node.
---
private pure func parse_array_suffix(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	element: NodeId = builder.last_node_id()
	element_span: Span = builder.node_span(element)
	var out: DiscoveryBuilder = builder.advance_token()
	var dimensions: List[NodeId] = []
	var end_span: Span = element_span
	var parsing: Bool = True

	while parsing and not out.at_end_of_tokens():
		out = out.parse_type_allowing_bounds(True)
		dimension: NodeId = out.last_node_id()
		dimensions = dimensions.append(dimension)
		end_span = out.node_span(dimension)

		if out.at(CommaSymbol):
			out = out.advance_token()

			if out.at(RightBracketSymbol):
				parsing = False
		else:
			parsing = False

	closed: Bool = out.at(RightBracketSymbol)

	if closed:
		closing_span: Span = out.current_span()
		out = out.advance_token()

		if not out.all_dimensions(dimensions):
			out = out.append_plain_diagnostic(ArrayDimensionsExpectedDiagnostic, end_span)

		end_span = closing_span
	else:
		out = out.report_at_current_in(ExpectedRightBracketDiagnostic, ArrayDimensions)

		if not out.all_dimensions(dimensions):
			out = out.append_plain_diagnostic(ArrayDimensionsExpectedDiagnostic, end_span)

	out.append_parent_node(
		ArrayTypeNode,
		element_span.span_covering(end_span),
		[element].concat(dimensions),
	)


---
`(...)`: `()` (the named type `Void`), a function type `(T, U) -> R`, a
grouping `(T)`, or a tuple `(T, U)`; then any array suffixes.
---
private pure func parse_parenthesized_type(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	start: Span = builder.current_span()
	var out: DiscoveryBuilder = builder.advance_token()

	if out.at(RightParenSymbol):
		close: Span = out.current_span()
		out = out.advance_token()

		if out.at(ArrowSymbol):
			out = out.advance_token()
			out = out.parse_type()
			return_type: NodeId = out.last_node_id()
			end_span: Span = out.node_span(return_type)
			out = out.append_parent_node(
				FunctionTypeNode,
				start.span_covering(end_span),
				[return_type],
			)
			out
		else:
			void_span: Span = start.span_covering(close)
			out = out.append_name_leaf_node(
				NamedTypeNode,
				void_span,
				name_id_at_row(VOID_NAME_INDEX),
			)
			out = out.parse_array_suffixes()
			out
	else:
		var items: List[NodeId] = []
		var parsing: Bool = True

		while parsing and not out.at_end_of_tokens():
			out = out.parse_type_allowing_bounds(True)
			items = items.append(out.last_node_id())

			if out.at(CommaSymbol):
				out = out.advance_token()

				if out.at(RightParenSymbol):
					parsing = False
			else:
				parsing = False

		close_span: Span = out.current_span()
		out = out.expect_right_paren(GroupedType)

		if out.at(ArrowSymbol):
			out = out.advance_token()
			out = out.parse_type()
			return_type: NodeId = out.last_node_id()
			end_span: Span = out.node_span(return_type)
			out = out.append_parent_node(
				FunctionTypeNode,
				start.span_covering(end_span),
				items.append(return_type),
			)
			out
		else:
			tuple_span: Span = start.span_covering(close_span)

			if items.length() > MAX_TUPLE_ARITY:
				out = out.append_plain_diagnostic(TupleArityDiagnostic, tuple_span)

			if items.length() != 1:
				out = out.append_parent_node(TupleTypeNode, tuple_span, items)

			out = out.parse_array_suffixes()
			out


private pure func expect_right_paren(
	builder: DiscoveryBuilder,
	construct: ParsedConstruct,
) -> DiscoveryBuilder:
	builder.expect_token_in(RightParenSymbol, ExpectedRightParenDiagnostic, construct)


---
`pure (T, ...) -> R`.
---
private pure func parse_pure_function_type(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	start: Span = builder.current_span()
	var out: DiscoveryBuilder = builder.advance_token()

	if out.at(LeftParenSymbol):
		out = out.advance_token()
	else:
		out = out.report_at_current_in(ExpectedLeftParenDiagnostic, PureFunctionType)

	var parameters: List[NodeId] = []

	if not out.at(RightParenSymbol):
		var parsing: Bool = True

		while parsing and not out.at_end_of_tokens():
			out = out.parse_type_allowing_bounds(True)
			parameters = parameters.append(out.last_node_id())

			if out.at(CommaSymbol):
				out = out.advance_token()

				if out.at(RightParenSymbol):
					parsing = False
			else:
				parsing = False

	out = out.expect_right_paren(FunctionTypeParameters)

	if out.at(ArrowSymbol):
		out = out.advance_token()
	else:
		out = out.report_at_current_in(ExpectedArrowDiagnostic, FunctionTypeParameters)

	out = out.parse_type()
	return_type: NodeId = out.last_node_id()
	end_span: Span = out.node_span(return_type)
	out.append_parent_node(
		PureFunctionTypeNode,
		start.span_covering(end_span),
		parameters.append(return_type),
	)


---
`..#N`: a range over a dimension.
---
private pure func parse_range_type(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	start: Span = builder.current_span()
	var out: DiscoveryBuilder = builder.advance_token()
	kind: TokenKind = out.current_kind()

	if (
		kind != HashSymbol
		and kind != DimensionNameToken
		and kind != LeftParenSymbol
	):
		out = out.report_at_current(ExpectedHashDiagnostic)

	out = out.parse_dimension_expression()
	dimension: NodeId = out.last_node_id()
	end_span: Span = out.node_span(dimension)
	out.append_parent_node(
		RangeTypeNode,
		start.span_covering(end_span),
		[dimension],
	)


-- Dimensions.
---
A dimension expression: `+` and `-` over `*` and `/` over atoms.
---
pure func parse_dimension_expression(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = builder.parse_dimension_product()

	while out.at(PlusSymbol) or out.at(MinusSymbol):
		kind: NodeKind = if out.at(PlusSymbol):
			DimensionAddTypeNode
		else:
			DimensionSubtractTypeNode

		left: NodeId = out.last_node_id()
		out = out.advance_token()
		out = out.parse_dimension_product()
		right: NodeId = out.last_node_id()
		span: Span = span_covering(
			out.node_span(left),
			out.node_span(right),
		)
		out = out.append_parent_node(
			kind,
			span,
			[left, right],
		)

	out


private pure func parse_dimension_product(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = builder.parse_dimension_atom()

	while out.at(StarSymbol) or out.at(SlashSymbol):
		kind: NodeKind = if out.at(StarSymbol):
			DimensionMultiplyTypeNode
		else:
			DimensionDivideTypeNode

		left: NodeId = out.last_node_id()
		out = out.advance_token()
		out = out.parse_dimension_atom()
		right: NodeId = out.last_node_id()
		span: Span = span_covering(
			out.node_span(left),
			out.node_span(right),
		)
		out = out.append_parent_node(
			kind,
			span,
			[left, right],
		)

	out


---
`#N`, `#N...`, `#3`, `#_`, `#_...`, a bare integer, or a parenthesized
dimension expression (which adds no node of its own).
---
private pure func parse_dimension_atom(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	token: Token = builder.current_token()

	match token.kind:
		DimensionNameToken:
			advanced: DiscoveryBuilder = builder.advance_token()

			if advanced.at(DotDotDotSymbol):
				end: Span = advanced.current_span()
				advanced
					.advance_token()
					.append_name_leaf_node(
						VariadicDimensionNameTypeNode,
						token.span.span_covering(end),
						name_id_at_row(token.payload),
					)
					.record_name_span_of_last_node(token.span)
			else:
				advanced.append_name_leaf_node(
					DimensionNameTypeNode,
					token.span,
					name_id_at_row(token.payload),
				)
		HashSymbol:
			builder
				.advance_token()
				.parse_hash_dimension(token.span)
		IntLiteralToken:
			builder
				.advance_token()
				.append_literal_leaf_node(
					DimensionLiteralTypeNode,
					token.span,
					literal_id_at_row(token.payload),
				)
		LeftParenSymbol:
			builder
				.advance_token()
				.parse_dimension_expression()
				.expect_right_paren(DimensionExpression)
		_:
			builder
				.report_at_current(ExpectedDimensionDiagnostic)
				.append_leaf_node(MissingTypeNode, token.span)


---
What follows a `#` that the lexer did not join to a name: a literal (`#3`)
or the wildcard (`#_`, `#_...`). Anything else, including a name after a
blank (`# N`), is reported.
---
private pure func parse_hash_dimension(
	builder: DiscoveryBuilder,
	hash_span: Span,
) -> DiscoveryBuilder:
	token: Token = builder.current_token()

	match token.kind:
		IntLiteralToken:
			builder
				.advance_token()
				.append_literal_leaf_node(
					DimensionLiteralTypeNode,
					hash_span.span_covering(token.span),
					literal_id_at_row(token.payload),
				)
		UnderscoreSymbol:
			advanced: DiscoveryBuilder = builder.advance_token()

			if advanced.at(DotDotDotSymbol):
				end: Span = advanced.current_span()
				advanced
					.advance_token()
					.append_leaf_node(
						VariadicDimensionWildcardTypeNode,
						hash_span.span_covering(end),
					)
					.record_name_span_of_last_node(hash_span.span_covering(token.span))
			else:
				advanced.append_leaf_node(
					DimensionWildcardTypeNode,
					hash_span.span_covering(token.span),
				)
		_:
			builder
				.report_at_current(ExpectedDimensionDiagnostic)
				.append_leaf_node(MissingTypeNode, hash_span)


---
`where left == right, ...` constraints of `owner`, if written.
---
pure func parse_dimension_constraints(
	builder: DiscoveryBuilder,
	owner: DefinitionId,
) -> DiscoveryBuilder:
	if not builder.at(WhereKeyword):
		builder
	else:
		var out: DiscoveryBuilder = builder.advance_token()
		var parsing: Bool = True

		while parsing and not out.at_end_of_tokens():
			out = out.parse_dimension_expression()
			left: NodeId = out.last_node_id()
			out = out.expect_token(EqualEqualSymbol, ExpectedEqualEqualDiagnostic)
			out = out.parse_dimension_expression()
			right: NodeId = out.last_node_id()
			span: Span = span_covering(
				out.node_span(left),
				out.node_span(right),
			)
			out = out.append_dimension_constraint({
				owner = owner,
				left = left,
				right = right,
				span = span,
			})

			if out.at(CommaSymbol):
				out = out.advance_token()
			else:
				parsing = False

		out


-- Type parameters.
---
`[T, #N, #_, T: Bound + ...]` type parameters of `owner`, if written.
---
pure func parse_type_parameters(builder: DiscoveryBuilder, owner: DefinitionId) -> DiscoveryBuilder:
	if not builder.at(LeftBracketSymbol):
		builder
	else:
		var out: DiscoveryBuilder = builder.advance_token()
		var ordinal: Int = 0

		if not out.at(RightBracketSymbol):
			var parsing: Bool = True

			while parsing and not out.at_end_of_tokens():
				out = out.parse_type_parameter(owner, ordinal)
				ordinal += 1

				if out.at(CommaSymbol):
					out = out.advance_token()

					if out.at(RightBracketSymbol):
						parsing = False
				else:
					parsing = False

		out = out.expect_token_in(
			RightBracketSymbol,
			ExpectedRightBracketDiagnostic,
			TypeParameters,
		)
		out


---
The kind of the type parameter at the cursor: `#N` is a dimension, `#_` a
wildcard dimension, a `#` followed by anything else a (reported) dimension,
and a name a type parameter.
---
private pure func type_parameter_kind_at_cursor(builder: DiscoveryBuilder) -> TypeParameterKind:
	match builder.current_kind():
		DimensionNameToken:
			DimensionParameter
		HashSymbol:
			if builder.peek_kind(1) == UnderscoreSymbol:
				WildcardDimensionParameter
			else:
				DimensionParameter
		_:
			TypeParameter


---
Consumes a type parameter's name; a `#` not followed by `_` is reported.
---
private pure func consume_type_parameter_name(
	builder: DiscoveryBuilder,
	kind: TypeParameterKind,
) -> DiscoveryBuilder:
	match kind:
		TypeParameter:
			builder.consume_declared_name(TypeParameterName)
		WildcardDimensionParameter:
			builder
				.advance_token()
				.advance_token()
		DimensionParameter:
			if builder.at(HashSymbol):
				builder
					.advance_token()
					.report_at_current(ExpectedDimensionDiagnostic)
			else:
				builder.advance_token()


private pure func token_span_at(builder: DiscoveryBuilder, index: Int) -> Span:
	match builder.tokens.get(index):
		Some(token):
			token.span
		None:
			builder.current_span()


private pure func parse_type_parameter(
	builder: DiscoveryBuilder,
	owner: DefinitionId,
	ordinal: Int,
) -> DiscoveryBuilder:
	token: Token = builder.current_token()
	kind: TypeParameterKind = builder.type_parameter_kind_at_cursor()

	name: NameId = match kind:
		TypeParameter:
			builder.declared_name_at_cursor()
		DimensionParameter:
			if token.kind == DimensionNameToken:
				name_id_at_row(token.payload)
			else:
				name_id_at_row(EMPTY_NAME_INDEX)
		WildcardDimensionParameter:
			name_id_at_row(DISCARD_NAME_INDEX)

	name_span: Span = if kind == WildcardDimensionParameter:
		token.span.span_covering(builder.token_span_at(builder.token_cursor + 1))
	else:
		token.span

	var out: DiscoveryBuilder = builder.consume_type_parameter_name(kind)
	var end_span: Span = name_span

	if out.at(ColonSymbol):
		out = out.advance_token()
		var parsing: Bool = True

		while parsing and not out.at_end_of_tokens():
			out = out.parse_trait_reference(BoundSink(owner, ordinal))
			end_span = out.previous_span()

			if out.at(PlusSymbol):
				out = out.advance_token()
			else:
				parsing = False

	out.append_type_parameter({
		owner = owner,
		ordinal = ordinal,
		name = name,
		kind = kind,
		name_span = name_span,
		span = name_span.span_covering(end_span),
	})
