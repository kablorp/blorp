-- Binary operators: which tokens are operators, their precedence levels (loosest
-- first) and the node kind each builds. Separate from the expression grammar so
-- the operator table can be read, and tested, without the recursive parser.
import:
	../tables/node_kind_classes:
		PlainParentKind(
			AddParent, AndParent, DivideParent, EqualParent, GreaterEqualParent, GreaterParent,
			LessEqualParent, LessParent, ModuloParent, MultiplyParent, NotEqualParent, OrParent,
			RangeParent, SubtractParent,
		),
	../tables/token:
		TokenKind(
			AndKeyword, DotDotSymbol, EqualEqualSymbol, GreaterEqualSymbol, GreaterSymbol,
			LessEqualSymbol, LessSymbol, MinusSymbol, NotEqualSymbol, OrKeyword, PercentSymbol,
			PlusSymbol, SlashSymbol, StarSymbol,
		),


-- Precedence levels of the binary operators, loosest first. A stray `as` is
-- reported only at the loosest level, so `a + b as T` reports once from the
-- outer loop instead of inside the tighter right operand.
LOWEST_PRECEDENCE: Int = 0

private OR_PRECEDENCE: Int = 1

private AND_PRECEDENCE: Int = 2

private COMPARISON_PRECEDENCE: Int = 3

private RANGE_PRECEDENCE: Int = 4

private ADDITIVE_PRECEDENCE: Int = 5

private MULTIPLICATIVE_PRECEDENCE: Int = 6


---
The binary operators. `binary_operator` reads one from its token, and
`operator_precedence` and `operator_node_kind` give its precedence and the
node it makes: each is one exhaustive match over this enum.
---
enum BinaryOperator:
	OrOperator
	AndOperator
	EqualOperator
	NotEqualOperator
	LessOperator
	LessEqualOperator
	GreaterOperator
	GreaterEqualOperator
	RangeOperator
	AddOperator
	SubtractOperator
	MultiplyOperator
	DivideOperator
	ModuloOperator


pure func binary_operator(kind: TokenKind) -> Option[BinaryOperator]:
	match kind:
		OrKeyword:
			Some(OrOperator)
		AndKeyword:
			Some(AndOperator)
		EqualEqualSymbol:
			Some(EqualOperator)
		NotEqualSymbol:
			Some(NotEqualOperator)
		LessSymbol:
			Some(LessOperator)
		LessEqualSymbol:
			Some(LessEqualOperator)
		GreaterSymbol:
			Some(GreaterOperator)
		GreaterEqualSymbol:
			Some(GreaterEqualOperator)
		DotDotSymbol:
			Some(RangeOperator)
		PlusSymbol:
			Some(AddOperator)
		MinusSymbol:
			Some(SubtractOperator)
		StarSymbol:
			Some(MultiplyOperator)
		SlashSymbol:
			Some(DivideOperator)
		PercentSymbol:
			Some(ModuloOperator)
		_:
			None


pure func operator_precedence(operator: BinaryOperator) -> Int:
	match operator:
		OrOperator:
			OR_PRECEDENCE
		AndOperator:
			AND_PRECEDENCE
		EqualOperator | NotEqualOperator | LessOperator | LessEqualOperator | GreaterOperator | GreaterEqualOperator:
			COMPARISON_PRECEDENCE
		RangeOperator:
			RANGE_PRECEDENCE
		AddOperator | SubtractOperator:
			ADDITIVE_PRECEDENCE
		MultiplyOperator | DivideOperator | ModuloOperator:
			MULTIPLICATIVE_PRECEDENCE


pure func operator_node_kind(operator: BinaryOperator) -> PlainParentKind:
	match operator:
		OrOperator:
			OrParent
		AndOperator:
			AndParent
		EqualOperator:
			EqualParent
		NotEqualOperator:
			NotEqualParent
		LessOperator:
			LessParent
		LessEqualOperator:
			LessEqualParent
		GreaterOperator:
			GreaterParent
		GreaterEqualOperator:
			GreaterEqualParent
		RangeOperator:
			RangeParent
		AddOperator:
			AddParent
		SubtractOperator:
			SubtractParent
		MultiplyOperator:
			MultiplyParent
		DivideOperator:
			DivideParent
		ModuloOperator:
			ModuloParent
