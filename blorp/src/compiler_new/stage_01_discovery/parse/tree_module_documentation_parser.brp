-- Module entry documentation only. The caller runs this once before the
-- declaration scan; other docstrings remain declaration-owned prefixes.
import:
	../lex/lexed_module: LiteralValue(TextValue)
	../syntax/module_syntax: Documentation
	../tables/token: TokenKind(DocStringToken, ImportKeyword, NewlineToken)
	parse_state: ParseState, current_kind, current_span, current_literal, advanced


pure func parse_module_preamble(state: ParseState) -> (ParseState, Option[Documentation]):
	entry: ParseState = state.skip_newlines()

	if entry.current_kind() == DocStringToken:
		after_doc: ParseState = entry.advanced().skip_newlines()
		if after_doc.current_kind() == ImportKeyword:
			match entry.current_literal():
				Some(TextValue(text)):
					(after_doc, Some({ text = text, span = entry.current_span() }))
				_:
					-- Checked ParseState inputs require text for a doc token.
					(entry, None)
		else:
			(entry, None)
	else:
		(entry, None)


private pure func skip_newlines(state: ParseState) -> ParseState:
	var out: ParseState = state
	while out.current_kind() == NewlineToken:
		out = out.advanced()
	out
