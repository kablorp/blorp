-- Direct ordinary alias declarations; the caller consumed `type` or `opaque`.
import:
	../syntax/declarations: AliasDeclaration, AliasForm(TransparentAlias, OpaqueAlias), TypeParameter
	../syntax/module_syntax: Documentation
	../tables/expected_token:
		NameConstruct(NameInTypeAliasName),
		ExpectedTokenDiagnostic(ExpectedKeyword, ExpectedEqual),
		KeywordConstruct(KeywordInTypeAliasKeyword, KeywordInOpaqueType),
		EqualConstruct(EqualInTypeAliasTarget),
	../tables/row_kinds: Visibility
	../tables/span: Span, span_covering
	../tables/token: TokenKind(AliasKeyword, TypeKeyword, EqualSymbol)
	parse_state: ParseState, diagnostic_count, expect_token, consume_ordinary_name, finished_alias
	tree_type_parameter_parser:
		TypeParametersParse(NoTypeParameters, ParsedTypeParameters, RejectedTypeParameters), parse_type_parameters
	tree_type_parser: parse_type


union AliasParse:
	ParsedAlias(AliasDeclaration)
	RejectedAlias


pure func parse_alias(
	state: ParseState, visibility: Visibility, documentation: Option[Documentation], start: Span, form: AliasForm,
) -> (ParseState, AliasParse):
	before: Int = state.diagnostic_count()
	after_keyword: ParseState = match form:
		TransparentAlias:
			state.expect_token(AliasKeyword, ExpectedKeyword(KeywordInTypeAliasKeyword))
		OpaqueAlias:
			state.expect_token(TypeKeyword, ExpectedKeyword(KeywordInOpaqueType))
	(after_name, parsed_name) = after_keyword.consume_ordinary_name(NameInTypeAliasName)

	match parsed_name:
		None:
			(after_name, RejectedAlias)
		Some(name):
			(after_parameters, parsed_parameters) = parse_type_parameters(after_name)
			parameters: Option[List[TypeParameter]] = match parsed_parameters:
				NoTypeParameters:
					Some([])
				ParsedTypeParameters(written, _):
					Some(written)
				RejectedTypeParameters:
					None

			match parameters:
				None:
					(after_parameters, RejectedAlias)
				Some(parameters):
					before_target: ParseState = after_parameters.expect_token(EqualSymbol, ExpectedEqual(EqualInTypeAliasTarget))
					(after_target, target) = parse_type(before_target)

					if after_target.diagnostic_count() != before:
						(after_target, RejectedAlias)
					else:
						(after_alias, declaration) = after_target.finished_alias(visibility, documentation, form, name, parameters, target, start.span_covering(target.span))
						(after_alias, ParsedAlias(declaration))
