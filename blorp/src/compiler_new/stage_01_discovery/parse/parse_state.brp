pure func spellings(state: ParseState) -> Spellings:
	from_opaque ParseState(state).spellings


-- A snapshot for the test-only declaration preview, never a completed module.
pure func issued_counts(state: ParseState) -> SyntaxCounts:
	issued(from_opaque ParseState(state).mint).counts


-- Rejection keeps the mint's authoritative immutable indexes even when no
-- declaration tree can be published.
pure func issued_ids(state: ParseState) -> IssuedIds:
	issued(from_opaque ParseState(state).mint)


pure func parse_module(state: ParseState) -> ModuleId:
	from_opaque ParseState(state).module


pure func parse_source(state: ParseState) -> LexedSource:
	from_opaque ParseState(state).source


pure func parse_line_starts(state: ParseState) -> List[Int]:
	from_opaque ParseState(state).line_starts


-- The parser's layout readers and diagnostic positions share this exact
-- lexical index. Validate every newline without allocating a second list.
private pure func valid_line_starts(text: String, starts: List[Int]) -> Bool:
	var valid: Bool = starts.get(0) == Some(0)
	var line: Int = 1
	var offset: Int = 0

	while valid and offset < text.length():
		if text.get(offset) == Some('\n'):
			valid = starts.get(line) == Some(offset + 1)
			line += 1

		offset += 1

	valid and starts.length() == line
