-- The direct parser's opaque construction boundary. Recovery values exist
-- only after a diagnostic, inside a rejected declaration preview. This module
-- exposes no AcceptedSource or ModuleSyntax constructor.
import:
	../lex/lexed_module: HoleScan, InterpolationScan, LexedModule, LexedSource, LiteralValue
	../lex/lexer: lex_hole
	../syntax/declarations:
		AliasDeclaration,
		AliasForm,
		Annotation,
		BuiltinTypeDeclaration,
		CleanupBuiltin,
		EnumCase,
		EnumDeclaration,
		FieldDeclaration,
		Function,
		FunctionDeclaration,
		ImplementationDeclaration,
		ImplementationMethod,
		Signature,
		TraitDeclaration,
		TraitMethod,
		TraitReference,
		GlobalDeclaration,
		LocalFunction,
		GlobalForm,
		Parameter,
		RecordDeclaration,
		ResourceTypeDeclaration,
		TypeParameter,
		UnionDeclaration,
		UnionDeclarationForm,
		RecordDeclarationForm,
		VariantDeclaration,
	../syntax/diagnostics:
		SyntaxDiagnostic(
			Plain, ExpectedToken, UnknownEscape, IntegerLiteralOverflow, FloatLiteralOverflow,
			UnexpectedByte, ReservedKeywordAsName, SyntaxNestingTooDeep,
		),
		SyntaxDiagnosticAt,
	../syntax/expressions:
		Block, Body, ElseIfExpression, Expression, ExpressionKind, Hole, IfExpression, Statement, StatementKind, SubscriptPlace
	../syntax/foreign_blocks: ForeignCName, ForeignFunction
	../syntax/ids:
		IdMint,
		IssuedIds,
		SpellingId,
		issued,
		minted_alias,
		minted_binder,
		minted_block,
		minted_builtin_type,
		minted_dimension,
		minted_else_if,
		minted_enum,
		minted_enum_case,
		minted_expression,
		minted_field,
		minted_foreign_function,
		minted_function,
		minted_local_function,
		minted_implementation,
		minted_implementation_method,
		minted_global,
		minted_hole,
		minted_import,
		minted_name_use,
		minted_pattern,
		minted_record,
		minted_resource_type,
		minted_statement,
		minted_subscript_place,
		minted_trait,
		minted_trait_method,
		minted_type_binder,
		minted_union,
		minted_variant,
		minted_written_type,
		new_id_mint,
	../syntax/imports: Import, ImportItem, ModulePath
	../syntax/module_syntax: Documentation, SyntaxCounts
	../syntax/names: Binder, NameUse, TypeBinder, WrittenName
	../syntax/sequences: AtLeastOne
	../syntax/patterns: Pattern, PatternKind
	../syntax/spellings: Spellings, interned_spelling
	../syntax/types: Dimension, DimensionKind, WrittenType, WrittenTypeKind
	../tables/diagnostic_code as TableDiagnostics
	../tables/expected_token:
		ExpectedTokenDiagnostic(ExpectedName),
		NameConstruct(NameInVariantName, NameInParameterName, NameInVariableName),
	../tables/ids: ModuleId
	debug as dbg
	../tables/row_kinds: Purity, Visibility
	../tables/source_position: column_at
	../tables/span: Span, pack_span, span_end, span_source, span_start
	../tables/token:
		KEYWORD_KINDS_IN_SEEDED_ORDER,
		Token,
		TokenKind(
			IdentifierToken, DimensionNameToken, SelfKeyword, VoidKeyword, TrueKeyword,
			FalseKeyword, IntLiteralToken, FloatLiteralToken, NormalStringToken, RawStringToken,
			PipeStringToken, RawPipeStringToken, DocStringToken, EndOfFileToken, NewlineToken,
			DedentToken, ColonSymbol, CommaSymbol, LeftParenSymbol, RightBracketSymbol,
			RightParenSymbol, LeftBracketSymbol, LeftBraceSymbol, RightBraceSymbol,
			UnderscoreSymbol, InterpolatedStringToken, InterpolatedPipeStringToken,
		),
		fixed_token_spelling,
	token_cursor:
		TokenCursor,
		TokenInputError,
		advanced as advanced_cursor,
		current_token as cursor_token,
		cursor_at,
		cursor_position,
		is_soft_keyword,
		new_token_cursor,
		peek_kind as cursor_peek,
		previous_content_span as cursor_previous_content_span,
		token_at,
		token_spelling,


union ParseInputError:
	EmptyRejection
	InvalidLineStarts
	InvalidTokenInput(TokenInputError)
	NonLexicalDiagnostic(Span, TableDiagnostics.SyntaxDiagnostic)


opaque type ParseState = ParseFields


private record ParseFields {
	module: ModuleId,
	source: LexedSource,
	line_starts: List[Int],
	cursor: TokenCursor,
	spellings: Spellings,
	mint: IdMint,
	diagnostics: List[SyntaxDiagnosticAt],
	previous: Span,
	hole_depth: Int,
	nesting: Int
}


enum NameRole:
	OrdinaryName
	TypeName
	VariantName


private RECOVERY_NAME: String = "_"

private DISCARD_NAME: String = "_"


pure func new_parse_state(lexed: LexedModule) -> Result[ParseState, ParseInputError]:
	if not valid_line_starts(lexed.source.text, lexed.line_starts):
		Err(InvalidLineStarts)
	else:
		match new_token_cursor(lexed):
			Err(error):
				Err(InvalidTokenInput(error))
			Ok(cursor):
				var diagnostics: List[SyntaxDiagnosticAt] = []
				var problem: Option[ParseInputError] = None

				for at in lexed.diagnostics:
					match lexical_diagnostic(at.diagnostic):
						Some(diagnostic):
							diagnostics = diagnostics.append({
								span = at.span,
								diagnostic = diagnostic,
							})
						None:
							problem = Some(NonLexicalDiagnostic(at.span, at.diagnostic))
							break

				match problem:
					Some(error):
						Err(error)
					None:
						Ok(into_opaque ParseState({
									module = lexed.module,
									source = lexed.source,
									line_starts = lexed.line_starts,
									cursor = cursor,
									spellings = lexed.spellings,
									mint = new_id_mint(lexed.module),
									diagnostics = diagnostics,
									previous = cursor_token(cursor).span,
									hole_depth = 0,
									nesting = 0
								}))


private pure func lexical_diagnostic(
	diagnostic: TableDiagnostics.SyntaxDiagnostic,
) -> Option[SyntaxDiagnostic]:
	match diagnostic:
		TableDiagnostics.Plain(code):
			if lexical_plain_code(code):
				Some(Plain(code))
			else:
				None
		TableDiagnostics.UnknownEscape(character):
			Some(UnknownEscape(character))
		TableDiagnostics.IntegerLiteralOverflow(digits):
			Some(IntegerLiteralOverflow(digits))
		TableDiagnostics.FloatLiteralOverflow(digits):
			Some(FloatLiteralOverflow(digits))
		TableDiagnostics.UnexpectedByte(character):
			Some(UnexpectedByte(character))
		_:
			None


private pure func lexical_plain_code(code: TableDiagnostics.PlainSyntaxCode) -> Bool:
	match code:
		TableDiagnostics.InconsistentIndentationDiagnostic | TableDiagnostics.UnexpectedCharacterDiagnostic:
			True
		TableDiagnostics.InvalidCharLiteralDiagnostic | TableDiagnostics.UnicodeCodepointOutOfRangeDiagnostic:
			True
		TableDiagnostics.UnicodeEscapeDigitCountDiagnostic | TableDiagnostics.UnicodeEscapeNonHexDiagnostic:
			True
		TableDiagnostics.UnterminatedCharLiteralDiagnostic | TableDiagnostics.UnterminatedUnicodeEscapeDiagnostic:
			True
		TableDiagnostics.MultilineRawStringDiagnostic | TableDiagnostics.MultilineStringDiagnostic:
			True
		TableDiagnostics.UnterminatedDocstringDiagnostic | TableDiagnostics.UnterminatedEscapeDiagnostic:
			True
		TableDiagnostics.UnterminatedRawStringDiagnostic | TableDiagnostics.UnterminatedStringDiagnostic:
			True
		TableDiagnostics.InterpolationTooDeepDiagnostic | TableDiagnostics.InterpolatedEscapeAtEndDiagnostic:
			True
		TableDiagnostics.MultilineInterpolatedStringDiagnostic | TableDiagnostics.UnterminatedInterpolatedStringDiagnostic:
			True
		_:
			False


pure func current_token(state: ParseState) -> Token:
	cursor_token(from_opaque ParseState(state).cursor)


pure func current_kind(state: ParseState) -> TokenKind:
	state.current_token().kind


pure func current_span(state: ParseState) -> Span:
	state.current_token().span


pure func span_before_current(state: ParseState) -> Span:
	span: Span = state.current_span()
	pack_span(span.span_source(), span.span_start(), span.span_start())


pure func at_soft_boundary(state: ParseState) -> Bool:
	match state.current_kind():
		EndOfFileToken | NewlineToken | DedentToken | ColonSymbol | CommaSymbol | LeftParenSymbol | RightBracketSymbol | RightParenSymbol:
			True
		_:
			False


pure func previous_span(state: ParseState) -> Span:
	from_opaque ParseState(state).previous


pure func position(state: ParseState) -> Int:
	from_opaque ParseState(state).cursor.cursor_position()


pure func peek_kind(state: ParseState, ahead: Int) -> TokenKind:
	cursor_peek(from_opaque ParseState(state).cursor, ahead)


pure func advanced(state: ParseState) -> ParseState:
	fields: ParseFields = from_opaque ParseState(state)
	into_opaque ParseState({ fields |
			previous = cursor_token(fields.cursor).span,
			cursor = advanced_cursor(fields.cursor)
		})


---
`state` with `position` as its current token and every other fact kept: the
mint, the spellings and the diagnostics. A body is first recognized without
ids and then replayed from where it began, so the replay's ids follow the
header's.
---
pure func resumed_at(state: ParseState, position: Int) -> ParseState:
	fields: ParseFields = from_opaque ParseState(state)
	cursor: TokenCursor = cursor_at(fields.cursor, position)
	before: Span = if cursor_position(cursor) > 0:
		cursor_token(cursor_at(cursor, cursor_position(cursor) - 1)).span
	else:
		cursor_token(cursor).span
	into_opaque ParseState({ fields | cursor = cursor, previous = before })


---
`state` moved to where `reached` stopped, issuing none of the ids `reached`
issued: `reached`'s cursor, spellings and diagnostics with `state`'s own mint.
A recognition pass uses it after parsing an id-bearing construct (a written
type or a pattern) only to learn where it ends, so that every id of the
accepted body is issued later, in source order, by its replay.
---
pure func resumed_after(state: ParseState, reached: ParseState) -> ParseState:
	own: ParseFields = from_opaque ParseState(state)
	other: ParseFields = from_opaque ParseState(reached)
	into_opaque ParseState({ other | mint = own.mint })


---
Reports an input the lexer and `new_parse_state` already validated as
impossible. A debug build stops with the message, so the broken caller is found
where it read; a release build goes on with the documented fallback, since a
language-level operation must not crash. `guarantee` says why it cannot occur.
---
pure func report_unreachable_input(guarantee: String):
	debug:
		dbg.error("the parser met an input that cannot occur: ${guarantee}")


---
How many levels of syntax nest inside one another before the parser refuses
the source. Every construct that recurses in the parser, and so in every walker
that reads its tree (the minter, the dump, the ID census and the legacy
projection), counts one level: a bracketed form, an indented block or lambda
body, a control expression read as an operand, a prefix operator and a nested
written type or pattern. A left spine and an `else if`, `match` arm or `select`
arm chain are loops everywhere and do not count (section 3.14).

The value is the largest depth every walker survives with margin on both
platforms at the declared 16 MB main stack, kept clear of what the rest of the
pipeline can take. The measurements are in
`benchmarks/results/discovery_syntax_nesting_limit_2026-10-06.md`:

- the deepest nesting in the repository's own sources is 23 levels, so the
  limit is more than five times anything written today;
- the generated C opens one C bracket per level of value `if`, and clang stops
  at `-fbracket-depth` 256 by default, so the limit stays at half of that;
- the compiler's older passes overflow the stack on nested value `if`s near 250
  levels, so the limit stays well below that too;
- the parser, minter, dump, census and projection each take a source nested to
  the limit with a margin of at least 4 (the weakest, the legacy projection of
  control-expression operands, passes 256 operands, 512 levels, on macOS).
---
MAX_SYNTAX_NESTING: Int = 128


---
`state` one level deeper, for `inner` to read the nested construct, or, when
that is more than `MAX_SYNTAX_NESTING` levels, the state with the diagnostic
reported at the current token and the caller's `too_deep` result for it. This
is the only way a parse function enters a nesting construct (with
`nested_recovering`, for constructs whose parser must return a value to go on):
the depth is restored when `inner` returns, whatever state it returns, so a
rollback to an earlier state needs no care. `too_deep` is the caller's own
rejection, which keeps the diagnostic (a rollback to the state before the
construct would lose it). It is a function so that nothing is built unless the
limit is hit.
---
pure func nested[T](
	state: ParseState,
	too_deep: pure (ParseState) -> T,
	inner: pure (ParseState) -> (ParseState, T),
) -> (ParseState, T):
	if state.at_nesting_limit():
		reported: ParseState = state.report_nesting_too_deep()
		(reported, too_deep(reported))
	else:
		state.one_level_deeper(inner)


---
`nested`, for a parser that always returns a value (a written type, a pattern):
`recover` makes one from the state after the diagnostic, which has moved past
the token it was reported at, so a loop around the construct still advances.
---
pure func nested_recovering[T](
	state: ParseState,
	recover: pure (ParseState) -> (ParseState, T),
	inner: pure (ParseState) -> (ParseState, T),
) -> (ParseState, T):
	if state.at_nesting_limit():
		recover(state.recovered_after(state.report_nesting_too_deep()))
	else:
		state.one_level_deeper(inner)


private pure func at_nesting_limit(state: ParseState) -> Bool:
	from_opaque ParseState(state).nesting >= MAX_SYNTAX_NESTING


-- `inner` run one level deeper, the depth restored on the state it returns.
private pure func one_level_deeper[T](
	state: ParseState,
	inner: pure (ParseState) -> (ParseState, T),
) -> (ParseState, T):
	fields: ParseFields = from_opaque ParseState(state)
	inside: ParseState = into_opaque ParseState({ fields | nesting = fields.nesting + 1 })
	(inner_state, result) = inner(inside)
	after_fields: ParseFields = from_opaque ParseState(inner_state)
	(into_opaque ParseState({ after_fields | nesting = fields.nesting }), result)


---
Whether a chain of `links` links, which the parser reads in a loop but the tree
holds nested one inside the next, fits under `MAX_SYNTAX_NESTING` at the depth
`state` stands at. This is for the chains whose walkers recurse on the nesting
(a dimension sum, a run of array suffixes); a left spine of expression operands
or calls needs no count, because every expression walker loops over it
(section 3.14).
---
pure func chain_fits(state: ParseState, links: Int) -> Bool:
	from_opaque ParseState(state).nesting + links <= MAX_SYNTAX_NESTING


---
`state` after a chain refused to grow past `MAX_SYNTAX_NESTING`: the nesting
diagnostic is reported at the current token and nothing is consumed.
---
pure func refused_chain(state: ParseState) -> ParseState:
	state.report_nesting_too_deep()


-- One diagnostic per parse, however many constructs then refuse to nest.
private pure func report_nesting_too_deep(state: ParseState) -> ParseState:
	if state.reported_nesting_too_deep():
		state
	else:
		state.report_diagnostic(state.current_span(), SyntaxNestingTooDeep)


---
Whether a construct has refused to nest in this parse, which is why a rejected
expression was rejected.
---
pure func reported_nesting_too_deep(state: ParseState) -> Bool:
	from_opaque ParseState(state).diagnostics.any(pure func(at):
		match at.diagnostic:
			SyntaxNestingTooDeep: True
			_: False
	)


---
Whether the cursor reads an interpolation hole's own token run. A token
position there indexes the hole's run, not the module's, so a construct that
replays from a recorded token position cannot be read inside a hole.
---
pure func inside_hole(state: ParseState) -> Bool:
	from_opaque ParseState(state).hole_depth > 0


---
The outer parse an interpolation hole replaced: its cursor and its source.
---
opaque type ParkedParse = ParkedFields

private record ParkedFields {
	cursor: TokenCursor,
	source: LexedSource
}


---
The interpolated string under the cursor: its text pieces and holes.
---
pure func current_interpolation(state: ParseState) -> Option[InterpolationScan]:
	fields: ParseFields = from_opaque ParseState(state)
	token: Token = cursor_token(fields.cursor)

	match token.kind:
		InterpolatedStringToken | InterpolatedPipeStringToken:
			fields.source.interpolations.get(token.payload)
		_:
			None


---
`state` reading one hole's expression: the hole's bytes lexed into a run of
its own, ending in its end-of-file token, with the module's spellings after
it and the module's own mint, diagnostics and line starts. The outer parse
is parked for `left_hole`. A hole whose bytes do not lex cleanly has no
entry, so the whole string stays outside the slice.
---
pure func entered_hole(state: ParseState, hole: HoleScan) -> Option[(ParseState, ParkedParse)]:
	fields: ParseFields = from_opaque ParseState(state)
	run = lex_hole(fields.module, fields.source.text, fields.spellings, hole.expression_start, hole.expression_end)
	inside: LexedSource = {
		text = fields.source.text,
		literals = run.literals,
		interpolations = run.interpolations
	}
	lexed: LexedModule = {
		module = fields.module,
		source = inside,
		tokens = run.tokens,
		spellings = run.spellings,
		line_starts = fields.line_starts,
		diagnostics = []
	}

	if not run.diagnostics.is_empty():
		None
	else:
		match new_token_cursor(lexed):
			Ok(cursor):
				Some((
					into_opaque ParseState({ fields | cursor = cursor, source = inside, spellings = run.spellings, hole_depth = fields.hole_depth + 1 }),
					into_opaque ParkedParse({ cursor = fields.cursor, source = fields.source })
				))
			Err(_):
				-- The hole's tokens come from the lexer run just made, whose own
				-- diagnostics were empty, so the cursor's payload checks cannot fail.
				report_unreachable_input("a cleanly lexed interpolation hole yields a valid token cursor")
				None


---
`state` back in the parse `parked` set aside, keeping what the hole added:
spellings, diagnostics and the mint.
---
pure func left_hole(state: ParseState, parked: ParkedParse) -> ParseState:
	fields: ParseFields = from_opaque ParseState(state)
	outer: ParkedFields = from_opaque ParkedParse(parked)
	into_opaque ParseState({ fields | cursor = outer.cursor, source = outer.source, hole_depth = fields.hole_depth - 1 })


pure func diagnostic_count(state: ParseState) -> Int:
	from_opaque ParseState(state).diagnostics.length()


pure func diagnostics(state: ParseState) -> List[SyntaxDiagnosticAt]:
	from_opaque ParseState(state).diagnostics


pure func report_diagnostic(
	state: ParseState,
	span: Span,
	diagnostic: SyntaxDiagnostic,
) -> ParseState:
	fields: ParseFields = from_opaque ParseState(state)
	into_opaque ParseState({ fields | diagnostics = fields.diagnostics.append({
				span = span,
				diagnostic = diagnostic,
			}) })


-- Plain missing-item diagnostics share the frozen parser's empty span.
pure func report_at_current(
	state: ParseState,
	code: TableDiagnostics.PlainSyntaxCode,
) -> ParseState:
	state.report_diagnostic(state.span_before_current(), Plain(code))


pure func report_and_recover(
	state: ParseState,
	code: TableDiagnostics.PlainSyntaxCode,
) -> ParseState:
	state.recovered_after(state.report_at_current(code))


-- `reported`, the state after a diagnostic at `state`'s token, moved past that
-- token unless it is one a construct's closer or layout needs to see.
private pure func recovered_after(state: ParseState, reported: ParseState) -> ParseState:
	if state.at_soft_boundary():
		reported
	else:
		reported.advanced()


pure func expect_token(
	state: ParseState,
	kind: TokenKind,
	diagnostic: ExpectedTokenDiagnostic,
) -> ParseState:
	if state.current_kind() == kind:
		state.advanced()
	else:
		state.report_diagnostic(state.span_before_current(), ExpectedToken(diagnostic))


-- Missing header punctuation follows authored content, skipping consumed layout.
pure func report_expected_after_previous_content(
	state: ParseState,
	diagnostic: ExpectedTokenDiagnostic,
) -> ParseState:
	previous: Span = cursor_previous_content_span(from_opaque ParseState(state).cursor)
	state.report_diagnostic(
		pack_span(previous.span_source(), previous.span_end(), previous.span_end()),
		ExpectedToken(diagnostic),
	)


-- Layout ownership uses the lexer's admitted line starts and tab-expanded columns.
pure func span_start_line(state: ParseState, span: Span) -> Int:
	fields: ParseFields = from_opaque ParseState(state)
	var lower: Int = 0
	var upper: Int = fields.line_starts.length()

	while upper - lower > 1:
		middle: Int = (lower + upper) / 2

		if fields.line_starts.get_or(middle, 0) <= span.span_start():
			lower = middle
		else:
			upper = middle

	lower


pure func span_start_column(state: ParseState, span: Span) -> Int:
	fields: ParseFields = from_opaque ParseState(state)
	line: Int = state.span_start_line(span)
	line_start: Int = fields.line_starts.get_or(line, 0)
	column_at(fields.source.text, line_start, span.span_start())


pure func current_literal(state: ParseState) -> Option[LiteralValue]:
	fields: ParseFields = from_opaque ParseState(state)
	token: Token = cursor_token(fields.cursor)

	match token.kind:
		IntLiteralToken | FloatLiteralToken | NormalStringToken | RawStringToken | PipeStringToken | RawPipeStringToken | DocStringToken:
			fields.source.literals.get(token.payload)
		_:
			None


pure func name_allowed(kind: TokenKind, role: NameRole) -> Bool:
	if kind == IdentifierToken or kind.is_soft_keyword():
		True
	else:
		match role:
			TypeName:
				kind == SelfKeyword or kind == VoidKeyword
			VariantName:
				kind == TrueKeyword or kind == FalseKeyword
			OrdinaryName:
				False


-- Capture the frozen declaration diagnostic payload without constructing a
-- recovery WrittenName. Only parameterized value-record recovery needs this.
pure func current_name_spelling_or_empty(state: ParseState) -> (ParseState, SpellingId):
	fields: ParseFields = from_opaque ParseState(state)
	token: Token = state.current_token()

	if token.kind == IdentifierToken:
		match token.token_spelling(fields.spellings):
			Some(spelling):
				(state, spelling)
			None:
				state.intern_diagnostic_name("")
	else if KEYWORD_KINDS_IN_SEEDED_ORDER.contains(token.kind):
		match token.kind.fixed_token_spelling():
			Some(text):
				state.intern_diagnostic_name(text)
			None:
				state.intern_diagnostic_name("")
	else:
		-- Invalid authored names use the frozen parser's empty name spelling.
		state.intern_diagnostic_name("")


private pure func intern_diagnostic_name(
	state: ParseState,
	text: String,
) -> (ParseState, SpellingId):
	fields: ParseFields = from_opaque ParseState(state)
	(spellings, spelling) = interned_spelling(fields.spellings, text, 0, text.length())
	(into_opaque ParseState({ fields | spellings = spellings }), spelling)


pure func consume_name(
	state: ParseState,
	role: NameRole,
	construct: NameConstruct,
) -> (ParseState, WrittenName):
	fields: ParseFields = from_opaque ParseState(state)
	token: Token = cursor_token(fields.cursor)

	match token.token_spelling(fields.spellings):
		Some(spelling):
			(state.advanced(), {
					spelling = spelling,
					span = token.span
				})
		None:
			match token.kind.fixed_token_spelling():
				Some(text):
					if KEYWORD_KINDS_IN_SEEDED_ORDER.contains(token.kind):
						(spellings, spelling) = interned_spelling(
							fields.spellings,
							text,
							0,
							text.length(),
						)
						interned: ParseState = into_opaque ParseState(
							{ fields | spellings = spellings }
						)

						checked: ParseState = if name_allowed(token.kind, role):
							interned
						else:
							interned.report_diagnostic(token.span, ReservedKeywordAsName(spelling))

						(checked.advanced(), {
								spelling = spelling,
								span = token.span
							})
					else:
						state.missing_name(token.span, construct)
				None:
					state.missing_name(token.span, construct)


pure func consume_referenced_name(
	state: ParseState,
	construct: NameConstruct,
) -> (ParseState, WrittenName):
	if name_allowed(state.current_kind(), OrdinaryName):
		state.consume_name(OrdinaryName, construct)
	else:
		span: Span = state.current_span()
		(reported, name) = state.missing_name(span, construct)

		if state.at_soft_boundary():
			(reported, name)
		else:
			(reported.advanced(), name)


-- Declaration leaves share the frozen grammar's name recovery: an invalid
-- token is skipped unless it is a soft boundary, and never mints a binder.
pure func consume_declared_name(
	state: ParseState,
	construct: NameConstruct,
) -> (ParseState, Option[WrittenName]):
	if name_allowed(state.current_kind(), OrdinaryName):
		(after_name, name) = state.consume_name(OrdinaryName, construct)
		(after_name, Some(name))
	else if KEYWORD_KINDS_IN_SEEDED_ORDER.contains(state.current_kind()):
		state.reject_reserved_declared_name(construct)
	else:
		reported: ParseState = state.report_diagnostic(
			state.span_before_current(),
			ExpectedToken(ExpectedName(construct)),
		)

		if state.at_soft_boundary():
			(reported, None)
		else:
			(reported.advanced(), None)


-- Boolean spellings are authored variant names; invalid names stay absent.
pure func consume_variant_name(state: ParseState) -> (ParseState, Option[WrittenName]):
	if name_allowed(state.current_kind(), VariantName):
		(after_name, name) = state.consume_name(VariantName, NameInVariantName)
		(after_name, Some(name))
	else:
		state.consume_declared_name(NameInVariantName)


-- A typed discard is a named parameter; bare discards bypass this constructor.
pure func consume_parameter_name(state: ParseState) -> (ParseState, Option[WrittenName]):
	state.consume_discard_or_declared_name(NameInParameterName)


-- Global discards remain written names, without allocating a BinderId.
pure func consume_global_name(state: ParseState) -> (ParseState, Option[WrittenName]):
	state.consume_discard_or_declared_name(NameInVariableName)


private pure func consume_discard_or_declared_name(
	state: ParseState,
	construct: NameConstruct,
) -> (ParseState, Option[WrittenName]):
	if state.current_kind() == UnderscoreSymbol:
		fields: ParseFields = from_opaque ParseState(state)
		(spellings, spelling) = interned_spelling(
			fields.spellings,
			DISCARD_NAME,
			0,
			DISCARD_NAME.length(),
		)
		written: WrittenName = {
			spelling = spelling,
			span = state.current_span()
		}
		(into_opaque ParseState({ fields | spellings = spellings }).advanced(), Some(written))
	else:
		state.consume_declared_name(construct)


-- A missing declaration name is absent, never a fabricated written name.
-- Keep delimiters for the owning grammar and consume an invalid name token
-- so its following annotation can still be parsed without a cascade.
pure func consume_ordinary_name(
	state: ParseState,
	construct: NameConstruct,
) -> (ParseState, Option[WrittenName]):
	if name_allowed(state.current_kind(), OrdinaryName):
		(after_name, name) = state.consume_name(OrdinaryName, construct)
		(after_name, Some(name))
	else if KEYWORD_KINDS_IN_SEEDED_ORDER.contains(state.current_kind()):
		state.reject_reserved_declared_name(construct)
	else:
		reported: ParseState = state.report_diagnostic(
			state.span_before_current(),
			ExpectedToken(ExpectedName(construct)),
		)

		match state.current_kind():
			LeftBracketSymbol | LeftBraceSymbol | RightBraceSymbol:
				(reported, None)
			_:
				if state.at_soft_boundary():
					(reported, None)
				else:
					(reported.advanced(), None)


-- Declared keywords share the frozen parser's empty diagnostic span, while
-- consume_name retains its distinct role-specific authored-name behavior.
private pure func reject_reserved_declared_name(
	state: ParseState,
	construct: NameConstruct,
) -> (ParseState, Option[WrittenName]):
	fields: ParseFields = from_opaque ParseState(state)

	match (
		state
			.current_kind()
			.fixed_token_spelling()
	):
		Some(text):
			(spellings, spelling) = interned_spelling(fields.spellings, text, 0, text.length())
			interned: ParseState = into_opaque ParseState({ fields | spellings = spellings })
			(
				interned
					.report_diagnostic(state.span_before_current(), ReservedKeywordAsName(spelling))
					.advanced(),
				None,
			)
		None:
			-- Seeded keywords have fixed spellings. If that table invariant
			-- changes, reject without fabricating an authored keyword name.
			(
				state
					.report_diagnostic(
						state.span_before_current(),
						ExpectedToken(ExpectedName(construct)),
					)
					.advanced(),
				None,
			)


private pure func missing_name(
	state: ParseState,
	span: Span,
	construct: NameConstruct,
) -> (ParseState, WrittenName):
	empty: Span = pack_span(span.span_source(), span.span_start(), span.span_start())
	fields: ParseFields = from_opaque ParseState(
		state.report_diagnostic(empty, ExpectedToken(ExpectedName(construct)))
	)
	(spellings, spelling) = interned_spelling(
		fields.spellings,
		RECOVERY_NAME,
		0,
		RECOVERY_NAME.length(),
	)
	(into_opaque ParseState({ fields | spellings = spellings }), {
			spelling = spelling,
			span = span
		})


