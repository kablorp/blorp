pure func finished_record(
	state: ParseState,
	visibility: Visibility,
	documentation: Option[Documentation],
	form: RecordDeclarationForm,
	name: WrittenName,
	type_parameters: List[TypeParameter],
	fields: List[FieldDeclaration],
	span: Span,
) -> (ParseState, RecordDeclaration):
	contents: ParseFields = from_opaque ParseState(state)
	(mint, declaration) = minted_record(
		contents.mint,
		visibility,
		documentation,
		form,
		name,
		type_parameters,
		fields,
		span,
	)
	(into_opaque ParseState({ contents | mint = mint }), declaration)


