pure func finished_resource_type(
	state: ParseState,
	visibility: Visibility,
	documentation: Option[Documentation],
	name: WrittenName,
	type_parameters: List[TypeParameter],
	cleanup: Option[CleanupBuiltin],
	span: Span,
) -> (ParseState, ResourceTypeDeclaration):
	contents: ParseFields = from_opaque ParseState(state)
	(mint, declaration) = minted_resource_type(
		contents.mint,
		visibility,
		documentation,
		name,
		type_parameters,
		cleanup,
		span,
	)
	(into_opaque ParseState({ contents | mint = mint }), declaration)


pure func finished_variant(
	state: ParseState,
	name: WrittenName,
	payload: List[WrittenType],
	span: Span,
) -> (ParseState, VariantDeclaration):
	contents: ParseFields = from_opaque ParseState(state)
	(mint, declaration) = minted_variant(contents.mint, name, payload, span)
	(into_opaque ParseState({ contents | mint = mint }), declaration)


