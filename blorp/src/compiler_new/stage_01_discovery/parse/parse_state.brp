pure func parse_line_starts(state: ParseState) -> List[Int]:
	from_opaque ParseState(state).line_starts


-- The parser's layout readers and diagnostic positions share this exact
-- lexical index. Validate every newline without allocating a second list.
private pure func valid_line_starts(text: String, starts: List[Int]) -> Bool:
	var valid: Bool = starts.get(0) == Some(0)
	var line: Int = 1
	var offset: Int = 0

	while valid and offset < text.length():
		if text.get(offset) == Some('\n'):
			valid = starts.get(line) == Some(offset + 1)
			line += 1

		offset += 1

	valid and starts.length() == line
