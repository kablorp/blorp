-- Import blocks, parsed into import, path part, item, variant and alias
-- rows.
import:
	../sources/source_admission: intern_path, interned_path_id
	../tables/builder:
		DiscoveryBuilder,
		advance_token,
		append_import,
		append_import_alias,
		append_import_item,
		append_import_item_alias,
		append_import_item_variant,
		append_import_path_part,
		move_token_cursor,
		next_import_id,
		next_import_item_id,
		next_import_item_variant_row,
		next_import_path_part_row,
		replace_import_item_row,
		replace_import_row,
	../tables/diagnostic_code:
		PlainSyntaxCode(
			ExpectedAliasNameDiagnostic, ExpectedClosingParenAfterConstructorsDiagnostic,
			ExpectedColonAfterImportDiagnostic, ExpectedCommaBetweenImportSymbolsDiagnostic,
			ExpectedConstructorNameDiagnostic, ExpectedImportSymbolDiagnostic,
			ExpectedImportSymbolsAfterColonDiagnostic, ExpectedIndentedImportsDiagnostic,
			ExpectedModulePathDiagnostic, ExpectedNewlineAfterImportHeaderDiagnostic,
			ImportPathCurrentNotLeadingDiagnostic, ImportPathParentNotLeadingDiagnostic,
		),
	../tables/ids: ImportId, ImportItemId, ModuleId, PathId
	../tables/row_kinds:
		ImportRequestKind(BareModuleRequest, NativePackageRequest, RelativeModuleRequest),
	../tables/rows: EMPTY_ROW_RANGE
	../tables/span: Span, span_covering, span_end, span_source_index, span_start
	../tables/token:
		Token,
		TokenKind(
			AsKeyword, ColonSymbol, CommaSymbol, DedentToken, DotDotSymbol, DotSymbol,
			IdentifierToken, IndentToken, LeftParenSymbol, NewlineToken, RightParenSymbol,
			SlashSymbol,
		),
	parser_cursor:
		at_block_end,
		current_kind,
		current_name,
		current_span,
		current_token,
		is_soft_keyword,
		keyword_name_index,
		peek_kind,
		previous_span,
		report_at_current,
		skip_newlines,
		skip_optional_token,
		skip_rest_of_line,
		token_kind_at,


---
Tokens in one module path prefix: `.` or `..`, then `/`.
---
private PATH_PREFIX_TOKENS: Int = 2

---
The first path part that makes an import request a native package request
(`pkg/...`): a rule of the import syntax, compared by spelling equality.
---
private NATIVE_PACKAGE_PATH_ROOT: String = "pkg"


-- Imports.
---
`import:` then an indented block of import items.
---
pure func parse_import_block(builder: DiscoveryBuilder, module: ModuleId) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = builder.advance_token()

	if out.current_kind() == ColonSymbol:
		out = out.advance_token()
	else:
		out = out.report_at_current(ExpectedColonAfterImportDiagnostic)

	if out.current_kind() == NewlineToken:
		out = out.advance_token()
	else:
		out = out.report_at_current(ExpectedNewlineAfterImportHeaderDiagnostic)

	if out.current_kind() == IndentToken:
		out = out.advance_token()
	else:
		out = out.report_at_current(ExpectedIndentedImportsDiagnostic)

	-- As in the existing parser, the items are parsed even when the block is
	-- not indented, up to the end of the enclosing block.
	out = out.skip_newlines()

	while not out.at_block_end():
		before: Int = out.token_cursor
		out = out.parse_import_item(module)
		out = out.skip_newlines()

		if out.token_cursor == before and not out.at_block_end():
			out = out.advance_token()

	-- A dedent is missing here only after an earlier diagnostic (an import block
	-- that was never indented), which has reported it.
	out.skip_optional_token(DedentToken)


---
The request kind a module path's leading tokens give it.
---
private pure func request_kind_at(builder: DiscoveryBuilder) -> ImportRequestKind:
	kind: TokenKind = builder.current_kind()

	if (kind == DotSymbol or kind == DotDotSymbol) and builder.peek_kind(1) == SlashSymbol:
		RelativeModuleRequest
	else if (
		builder.current_spelling_is(NATIVE_PACKAGE_PATH_ROOT)
		and builder.peek_kind(1) == SlashSymbol
	):
		NativePackageRequest
	else:
		BareModuleRequest


private pure func current_spelling_is(builder: DiscoveryBuilder, spelling: String) -> Bool:
	token: Token = builder.current_token()
	token.kind == IdentifierToken and builder.name_spellings.get(token.payload) == Some(spelling)


---
The source text of the tokens from `first` up to the cursor, token by token:
a module path as written, without any blanks between its tokens.
---
private pure func token_text_since(builder: DiscoveryBuilder, first: Int) -> String:
	token: Token = builder.current_token()
	source_text: String = builder.source_texts
		.get(token.span.span_source_index())
		.get_or("")
	var text: String = ""

	for index in first..builder.token_cursor:
		match builder.tokens.get(index):
			Some(part):
				text += source_text.substring(
					part.span.span_start(),
					part.span.span_end() - part.span.span_start(),
				)
			None:
				void

	text


---
One import item: a module path, an optional `as` alias, and optional
selected symbols on the same line or in an indented block.
---
pure func parse_import_item(builder: DiscoveryBuilder, module: ModuleId) -> DiscoveryBuilder:
	if builder.module_path_starts_at_cursor():
		builder.parse_import_item_with_path(module)
	else:
		-- A `.` or `..` after the `./` or `../` prefixes is the offender, not the
		-- prefix before it.
		prefix_end: Int = builder.module_path_prefix_end()

		at_offender: DiscoveryBuilder = match builder.token_kind_at(prefix_end):
			DotSymbol:
				builder.move_token_cursor(prefix_end)
			DotDotSymbol:
				builder.move_token_cursor(prefix_end)
			_:
				builder

		at_offender
			.report_malformed_path_segment()
			.skip_rest_of_line()


---
Whether a module path starts at the cursor: optional `./` or `../` pairs,
then a name.
---
private pure func module_path_starts_at_cursor(builder: DiscoveryBuilder) -> Bool:
	var ahead: Int = 0

	if builder.peek_kind(0) == DotSymbol and builder.peek_kind(1) == SlashSymbol:
		ahead = 2
	else:
		ahead = 2 * builder.leading_parent_steps()

	match builder.tokens.get(builder.token_cursor + ahead):
		Some(token):
			token.kind == IdentifierToken or token.kind.is_soft_keyword()
		None:
			False


---
An import item whose module path starts at the cursor.
---
private pure func parse_import_item_with_path(
	builder: DiscoveryBuilder,
	module: ModuleId,
) -> DiscoveryBuilder:
	import_id: ImportId = builder.next_import_id()
	request_kind: ImportRequestKind = builder.request_kind_at()
	path_start: Span = builder.current_span()
	path_first_token: Int = builder.token_cursor
	parent_steps: Int = builder.leading_parent_steps()
	parts_first: Int = builder.next_import_path_part_row()
	var out: DiscoveryBuilder = builder.parse_module_path()
	parts_count: Int = out.next_import_path_part_row() - parts_first
	path_span: Span = path_start.span_covering(out.previous_span())
	path_text: String = out.token_text_since(path_first_token)
	request_path: PathId = out.interned_path_id(path_text)
	out = out.intern_path(path_text)
	out = out.append_import({
		importer = module,
		request_kind = request_kind,
		request_path = request_path,
		parent_steps = parent_steps,
		path_parts = {
			first = parts_first,
			count = parts_count
		},
		items = EMPTY_ROW_RANGE,
		path_span = path_span,
		span = path_start,
	})

	var end_span: Span = path_span

	if out.current_kind() == AsKeyword:
		out = out.advance_token()
		alias_span: Span = out.current_span()

		match out.current_name():
			Some(alias_name):
				out = out.advance_token()
				end_span = alias_span
				out = out.append_import_alias({
					owner_import = import_id,
					alias_name = alias_name,
					span = alias_span,
				})
			None:
				out = out.report_missing_alias()

	items_first: Int = out.import_items.length()

	if out.current_kind() == ColonSymbol:
		out = out.advance_token()

		if out.current_kind() == NewlineToken:
			out = out.skip_newlines()

			if out.current_kind() == IndentToken:
				out = out.parse_import_symbol_block(import_id)
			else:
				out = out.report_at_current(ExpectedImportSymbolsAfterColonDiagnostic)
		else:
			out = out.parse_import_symbol_line(import_id)

	items_count: Int = out.import_items.length() - items_first

	-- The import ends at its last selected symbol, else at its alias or path,
	-- not at the layout tokens after it.
	if items_count > 0:
		match out.import_items.get(items_first + items_count - 1):
			Some(last_item):
				end_span = last_item.span
			None:
				void

	item_span: Span = path_start.span_covering(end_span)
	out.replace_import_row(
		import_id,
		{
			importer = module,
			request_kind = request_kind,
			request_path = request_path,
			parent_steps = parent_steps,
			path_parts = {
				first = parts_first,
				count = parts_count
			},
			items = {
				first = items_first,
				count = items_count
			},
			path_span = path_span,
			span = item_span
		},
	)


---
The number of `../` pairs starting at the cursor.
---
private pure func leading_parent_steps(builder: DiscoveryBuilder) -> Int:
	var steps: Int = 0

	while (
		builder.peek_kind(2 * steps) == DotDotSymbol
		and builder.peek_kind(2 * steps + 1) == SlashSymbol
	):
		steps += 1

	steps


---
`./` or `../`* prefixes, then parts separated by `/`; each part is appended
to `import_path_parts`.
---
pure func parse_module_path(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = builder.move_token_cursor(builder.module_path_prefix_end())

	match out.current_name():
		Some(first_part):
			out = out.advance_token()
			out = out.append_import_path_part(first_part)

			while out.current_kind() == SlashSymbol:
				out = out.advance_token()

				match out.current_name():
					Some(part):
						out = out.advance_token()
						out = out.append_import_path_part(part)
					None:
						out = out.report_malformed_path_segment()
		None:
			out = out.report_malformed_path_segment()

	out


---
Reports the token at the cursor where a module path segment belongs: a `.`
or `..` there is a separate mistake (only a path's start may have one), any
other token is a missing module path.
---
private pure func report_malformed_path_segment(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	match builder.current_kind():
		DotSymbol:
			builder.report_at_current(ImportPathCurrentNotLeadingDiagnostic)
		DotDotSymbol:
			builder.report_at_current(ImportPathParentNotLeadingDiagnostic)
		_:
			builder.report_at_current(ExpectedModulePathDiagnostic)


---
The index of the first token after a module path's `./` or `../` prefixes.
---
private pure func module_path_prefix_end(builder: DiscoveryBuilder) -> Int:
	var index: Int = builder.token_cursor

	if (
		builder.token_kind_at(index) == DotSymbol
		and builder.token_kind_at(index + 1) == SlashSymbol
	):
		index += PATH_PREFIX_TOKENS
	else:
		while (
			builder.token_kind_at(index) == DotDotSymbol
			and builder.token_kind_at(index + 1) == SlashSymbol
		):
			index += PATH_PREFIX_TOKENS

	index


---
Reports a missing alias name; a reserved keyword written as the alias is
consumed with the report, so the rest of the line parses normally.
---
private pure func report_missing_alias(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	kind: TokenKind = builder.current_kind()
	out: DiscoveryBuilder = builder.report_at_current(ExpectedAliasNameDiagnostic)

	if (
		kind
			.keyword_name_index()
			.is_some()
	):
		out.advance_token()
	else:
		out


---
Symbols up to the end of the line, separated by commas.
---
pure func parse_import_symbol_line(
	builder: DiscoveryBuilder,
	import_id: ImportId,
) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = builder

	while not out.at_import_symbol_line_end():
		out = out.parse_import_symbol_and_separator(import_id)

	out


private pure func at_import_symbol_line_end(builder: DiscoveryBuilder) -> Bool:
	builder.current_kind() == NewlineToken or builder.at_block_end()


---
One symbol and the comma after it; the cursor always moves unless the line
has ended.
---
private pure func parse_import_symbol_and_separator(
	builder: DiscoveryBuilder,
	import_id: ImportId,
) -> DiscoveryBuilder:
	before: Int = builder.token_cursor
	var out: DiscoveryBuilder = builder.parse_import_symbol(import_id)

	if out.current_kind() == CommaSymbol:
		out = out.advance_token()
	else if not out.at_import_symbol_line_end():
		out = out.report_at_current(ExpectedCommaBetweenImportSymbolsDiagnostic)

	if out.token_cursor == before and not out.at_import_symbol_line_end():
		out = out.advance_token()

	out


---
An indented block of symbol lines.
---
pure func parse_import_symbol_block(
	builder: DiscoveryBuilder,
	import_id: ImportId,
) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = builder
		.advance_token()
		.skip_newlines()

	while not out.at_block_end():
		before: Int = out.token_cursor
		out = out.parse_import_symbol_line(import_id)
		out = out.skip_newlines()

		if out.token_cursor == before and not out.at_block_end():
			out = out.advance_token()

	if out.current_kind() == DedentToken:
		out = out.advance_token()

	out


---
One selected symbol: a name, optionally `name(Constructor, ...)`, optionally
`as alias`.
---
pure func parse_import_symbol(builder: DiscoveryBuilder, import_id: ImportId) -> DiscoveryBuilder:
	item: ImportItemId = builder.next_import_item_id()
	start: Span = builder.current_span()

	match builder.current_name():
		Some(name):
			var out: DiscoveryBuilder = builder.advance_token()
			out = out.append_import_item({
				owner_import = import_id,
				name = name,
				variants = EMPTY_ROW_RANGE,
				name_span = start,
				span = start,
			})
			variants_first: Int = out.next_import_item_variant_row()

			if out.current_kind() == LeftParenSymbol:
				out = out.advance_token()
				out = out.parse_import_constructors(item)

			variants_count: Int = out.next_import_item_variant_row() - variants_first

			if out.current_kind() == AsKeyword:
				out = out.advance_token()
				alias_span: Span = out.current_span()

				match out.current_name():
					Some(alias_name):
						out = out.advance_token()
						out = out.append_import_item_alias({
							item = item,
							alias_name = alias_name,
							span = alias_span,
						})
					None:
						out = out.report_missing_alias()

			item_span: Span = start.span_covering(out.previous_span())
			out = out.replace_import_item_row(
				item,
				{
					owner_import = import_id,
					name = name,
					variants = {
						first = variants_first,
						count = variants_count
					},
					name_span = start,
					span = item_span
				},
			)
			out
		None:
			builder.report_at_current(ExpectedImportSymbolDiagnostic)


---
The constructors of a `name(...)` selection, after its `(`, through `)`.
---
pure func parse_import_constructors(
	builder: DiscoveryBuilder,
	item: ImportItemId,
) -> DiscoveryBuilder:
	variants_before: Int = builder.next_import_item_variant_row()
	var out: DiscoveryBuilder = builder.parse_import_constructor_names(item)

	if out.next_import_item_variant_row() == variants_before:
		out = out.report_at_current(ExpectedConstructorNameDiagnostic)

	if out.current_kind() == RightParenSymbol:
		out = out.advance_token()
	else:
		out = out.report_at_current(ExpectedClosingParenAfterConstructorsDiagnostic)

	out


private pure func at_import_constructors_end(builder: DiscoveryBuilder) -> Bool:
	(
		builder.current_kind() == RightParenSymbol
		or builder.current_kind() == NewlineToken
		or builder.at_block_end()
	)


---
The constructor names up to the `)` or the end of the line.
---
private pure func parse_import_constructor_names(
	builder: DiscoveryBuilder,
	item: ImportItemId,
) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = builder

	while not out.at_import_constructors_end():
		out = out.parse_import_constructor_name(item)

	out


---
One constructor name (or a report and a skipped token) and the comma after
it.
---
private pure func parse_import_constructor_name(
	builder: DiscoveryBuilder,
	item: ImportItemId,
) -> DiscoveryBuilder:
	out: DiscoveryBuilder = builder.consume_constructor_name(item)

	if out.current_kind() == CommaSymbol:
		out.advance_token()
	else:
		out


---
Consumes one constructor name into a variant row, or reports and skips the
token that stands in its place.
---
private pure func consume_constructor_name(
	builder: DiscoveryBuilder,
	item: ImportItemId,
) -> DiscoveryBuilder:
	span: Span = builder.current_span()

	match builder.current_name():
		Some(constructor):
			builder
				.advance_token()
				.append_import_item_variant({
					item = item,
					name = constructor,
					span = span,
				})
		None:
			builder
				.report_at_current(ExpectedConstructorNameDiagnostic)
				.advance_token()
