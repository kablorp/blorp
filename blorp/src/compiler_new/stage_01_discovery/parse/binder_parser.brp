-- Names that bind: parameters, lambda parameters, tuple binders (in parameters,
-- destructuring statements and `for` headers) and optional type annotations.
-- None of them re-enters the expression grammar, so they sit below `body_parser`.
import:
	../tables/builder:
		DiscoveryBuilder,
		OwnedRows,
		advance_token,
		append_named_parameter,
		append_parameter_type,
		append_plain_diagnostic,
		append_tuple_parameter,
		append_wildcard_parameter,
		next_parameter_id,
	../tables/diagnostic_code: PlainSyntaxCode(TupleArityDiagnostic)
	../tables/expected_token:
		CommaConstruct(CommaInTupleLoopVariables),
		ExpectedTokenDiagnostic(ExpectedComma, ExpectedName),
		NameConstruct(NameInLambdaParameter, NameInParameterName, NameInTupleBinderName),
		RightParenConstruct(
			RightParenInFunctionParameters, RightParenInLambdaParameters,
			RightParenInTupleLoopVariables, RightParenInTupleParameterNames,
		),
	../tables/ids: DefinitionId, NameId, NodeId, ParameterId
	../tables/name_vocabulary: DISCARD_NAME
	../tables/node_builder:
		ChildMark,
		append_name_leaf_node,
		append_name_only_parent_node_from_stack,
		append_named_parent_node_from_stack,
		append_plain_parent_node_since,
		child_count_since,
		last_node_id,
		mark_children,
		push_last_node,
	../tables/node_kind_classes:
		NameLeafKind(LoopBinderLeaf),
		NameOnlyParentKind(LambdaParameterBareParent),
		NamedParentKind(LambdaParameterParent),
		PlainParentKind(TupleLoopBinderParent),
	../tables/row_kinds:
		ParameterBinder(NamedParameterBinder, TupleParameterBinder, WildcardParameterBinder),
	../tables/rows: BinderNameRow
	../tables/span: Span, span_covering
	../tables/token:
		TokenKind(
			ColonSymbol, CommaSymbol, DedentToken, EndOfFileToken, IndentToken, LeftParenSymbol,
			RightParenSymbol, UnderscoreSymbol,
		),
	parser_cursor:
		at,
		binder_name_at_cursor,
		consume_binder_name,
		consume_declared_name,
		current_span,
		declared_name_at_cursor,
		expect_right_paren,
		peek_kind,
		report_expected,
		skip_newlines,
		token_at,
		token_kind_at,
	type_parser: node_span, parse_type


---
The fewest and most names a tuple binder may have.
---
private MIN_TUPLE_BINDER_NAMES: Int = 2

private MAX_TUPLE_BINDER_NAMES: Int = 4


---
Parameters after `(`, through `)`; they may continue on indented lines.
---
pure func parse_parameters(builder: DiscoveryBuilder, owner: OwnedRows) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = builder.skip_newlines()
	var opened_indent: Bool = False

	if out.at(IndentToken):
		opened_indent = True
		out = out.advance_token()
		out = out.skip_newlines()

	if not out.at(RightParenSymbol):
		var parsing: Bool = True

		while parsing and not out.at(EndOfFileToken):
			out = out.parse_parameter(owner)

			if out.at(CommaSymbol):
				out = out.advance_token()
				out = out.skip_newlines()

				if opened_indent and out.at(DedentToken):
					out = out.advance_token()
					out = out.skip_newlines()

				if out.at(RightParenSymbol):
					parsing = False
			else:
				parsing = False

	out = out.skip_newlines()

	if opened_indent and out.at(DedentToken):
		out = out.advance_token()
		out = out.skip_newlines()

	out.expect_right_paren(RightParenInFunctionParameters)


---
One parameter: `name`, `name: T`, `_`, `_: T`, or `(a, b): T`. Each binder form
has its own appender, which writes the binder names and the row together, so a
named binder always has one name, a wildcard none and a tuple the names it
listed.
---
private pure func parse_parameter(builder: DiscoveryBuilder, owner: OwnedRows) -> DiscoveryBuilder:
	parameter: ParameterId = builder.next_parameter_id()
	binder_start: Span = builder.current_span()

	match builder.parameter_binder_at_cursor():
		NamedParameterBinder:
			builder.parse_named_parameter(owner, parameter, binder_start)
		WildcardParameterBinder:
			builder.parse_wildcard_parameter(owner, parameter, binder_start)
		TupleParameterBinder:
			builder.parse_tuple_parameter(owner, parameter, binder_start)


---
`name` or `_: T`: a named binder, which binds the discard name for `_`.
---
private pure func parse_named_parameter(
	builder: DiscoveryBuilder,
	owner: OwnedRows,
	parameter: ParameterId,
	binder_start: Span,
) -> DiscoveryBuilder:
	binder: BinderNameRow = builder.named_binder_at_cursor(binder_start)
	consumed: DiscoveryBuilder = builder.consume_named_binder()
	typed: Bool = consumed.at(ColonSymbol)
	annotated: DiscoveryBuilder = consumed.parse_parameter_annotation(parameter)
	span: Span = annotated.parameter_span(binder_start, typed)
	annotated.append_named_parameter(owner, binder, binder_start, span)


---
`_`: a wildcard binder, which binds nothing.
---
private pure func parse_wildcard_parameter(
	builder: DiscoveryBuilder,
	owner: OwnedRows,
	parameter: ParameterId,
	binder_start: Span,
) -> DiscoveryBuilder:
	consumed: DiscoveryBuilder = builder.advance_token()
	typed: Bool = consumed.at(ColonSymbol)
	annotated: DiscoveryBuilder = consumed.parse_parameter_annotation(parameter)
	span: Span = annotated.parameter_span(binder_start, typed)
	annotated.append_wildcard_parameter(owner, binder_start, span)


---
`(a, b)`: a tuple binder; a count of names outside two to four is reported and
the row keeps the names that were written.
---
private pure func parse_tuple_parameter(
	builder: DiscoveryBuilder,
	owner: OwnedRows,
	parameter: ParameterId,
	binder_start: Span,
) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = builder.advance_token()
	var names: List[BinderNameRow] = []
	var parsing: Bool = not out.at(EndOfFileToken)

	while parsing:
		binder: BinderNameRow = out.declared_binder_at_cursor()
		out = out.consume_declared_name(NameInParameterName)
		names = names.append(binder)

		if out.at(CommaSymbol):
			out = out.advance_token()
			parsing = not (out.at(RightParenSymbol) or out.at(EndOfFileToken))
		else:
			parsing = False

	out = out.expect_right_paren(RightParenInTupleParameterNames)
	binder_span: Span = binder_start.span_covering(out.tuple_binder_close_span())

	if names.length() < MIN_TUPLE_BINDER_NAMES or names.length() > MAX_TUPLE_BINDER_NAMES:
		out = out.append_plain_diagnostic(TupleArityDiagnostic, binder_span)

	typed: Bool = out.at(ColonSymbol)
	annotated: DiscoveryBuilder = out.parse_parameter_annotation(parameter)
	span: Span = annotated.parameter_span(binder_span, typed)
	annotated.append_tuple_parameter(owner, names, binder_span, span)


---
`: T` after a parameter's binder when written, with its parameter type row.
---
private pure func parse_parameter_annotation(
	builder: DiscoveryBuilder,
	parameter: ParameterId,
) -> DiscoveryBuilder:
	if builder.at(ColonSymbol):
		out: DiscoveryBuilder = builder
			.advance_token()
			.parse_type()
		parameter_type: NodeId = out.last_node_id()
		out.append_parameter_type({
			parameter = parameter,
			type_root = parameter_type,
		})
	else:
		builder


---
The span of a parameter whose binder spans `binder_span`: through its type when
`typed`, whose root is the last node.
---
private pure func parameter_span(builder: DiscoveryBuilder, binder_span: Span, typed: Bool) -> Span:
	if typed:
		binder_span.span_covering(builder.node_span(builder.last_node_id()))
	else:
		binder_span


---
The binder form of the parameter at the cursor: `(a, b)` is a tuple, a lone
`_` a wildcard, and a name or `_: T` a named binder (`_` binds the discard
name).
---
private pure func parameter_binder_at_cursor(builder: DiscoveryBuilder) -> ParameterBinder:
	if builder.at(LeftParenSymbol):
		TupleParameterBinder
	else if builder.at(UnderscoreSymbol) and builder.peek_kind(1) != ColonSymbol:
		WildcardParameterBinder
	else:
		NamedParameterBinder


---
The binder name of a named parameter at the cursor: the discard name for `_`,
else the declared name there.
---
private pure func named_binder_at_cursor(builder: DiscoveryBuilder, start: Span) -> BinderNameRow:
	if builder.at(UnderscoreSymbol):
		{
			name = DISCARD_NAME,
			span = start
		}
	else:
		builder.declared_binder_at_cursor()


---
The declared name at the cursor with its span.
---
private pure func declared_binder_at_cursor(builder: DiscoveryBuilder) -> BinderNameRow:
	{
		name = builder.declared_name_at_cursor(),
		span = builder.current_span()
	}


---
Consumes a named parameter's binder: `_`, or a declared name.
---
private pure func consume_named_binder(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	if builder.at(UnderscoreSymbol):
		builder.advance_token()
	else:
		builder.consume_declared_name(NameInParameterName)


---
The token a tuple binder's span ends at: its `)` when `parse_tuple_binder_names`
consumed one, else the token that stood in its place. The names never consume
a `)` (it is a soft boundary), so a `)` just before the cursor is the close.
---
private pure func tuple_binder_close_span(builder: DiscoveryBuilder) -> Span:
	if builder.token_kind_at(builder.token_cursor - 1) == RightParenSymbol:
		builder.token_at(builder.token_cursor - 1).span
	else:
		builder.current_span()


---
`: T` when written, its root pushed on the child stack.
---
pure func parse_optional_type_annotation(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	if builder.at(ColonSymbol):
		builder
			.advance_token()
			.parse_type()
			.push_last_node()
	else:
		builder


---
The names of a tuple binder after its `(`, through the `)`, each a `kind`
leaf pushed on the child stack; `_` is allowed. Two to four names.
---
pure func parse_tuple_binder(
	builder: DiscoveryBuilder,
	start: Span,
	kind: NameLeafKind,
	comma: CommaConstruct,
	closing: RightParenConstruct,
) -> DiscoveryBuilder:
	mark: ChildMark = builder.mark_children()
	var out: DiscoveryBuilder = builder.push_binder_leaf(kind)
	var end: Span = out.node_span(out.last_node_id())

	if out.at(CommaSymbol):
		out = out.advance_token()
		var parsing: Bool = True

		while parsing and not out.at(EndOfFileToken):
			if out.at(RightParenSymbol):
				out = out.report_expected(ExpectedName(NameInTupleBinderName))
				parsing = False
			else:
				out = out.push_binder_leaf(kind)
				end = out.node_span(out.last_node_id())

				if out.at(CommaSymbol):
					out = out.advance_token()

					if out.at(RightParenSymbol):
						parsing = False
				else:
					parsing = False
	else:
		out = out.report_expected(ExpectedComma(comma))

	if out.at(RightParenSymbol):
		end = out.current_span()

	out = out.expect_right_paren(closing)
	count: Int = out.child_count_since(mark)

	if count < MIN_TUPLE_BINDER_NAMES or count > MAX_TUPLE_BINDER_NAMES:
		out = out.append_plain_diagnostic(
			TupleArityDiagnostic,
			start.span_covering(end),
		)

	out


---
A binder name (`_` allowed) as a `kind` leaf, pushed on the child stack.
---
private pure func push_binder_leaf(
	builder: DiscoveryBuilder,
	kind: NameLeafKind,
) -> DiscoveryBuilder:
	name: NameId = builder.binder_name_at_cursor()
	span: Span = builder.current_span()
	builder
		.consume_binder_name(NameInTupleBinderName)
		.append_name_leaf_node(kind, span, name)
		.push_last_node()


---
A loop variable, or `(a, b)` loop variables, pushed on the child stack.
---
pure func parse_loop_binder(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	if builder.at(LeftParenSymbol):
		builder.parse_tuple_loop_binder()
	else:
		builder.push_binder_leaf(LoopBinderLeaf)


private pure func parse_tuple_loop_binder(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	start: Span = builder.current_span()
	mark: ChildMark = builder.mark_children()
	names: DiscoveryBuilder = builder
		.advance_token()
		.parse_tuple_binder(
			start,
			LoopBinderLeaf,
			CommaInTupleLoopVariables,
			RightParenInTupleLoopVariables,
		)
	span: Span = start.span_covering(names.token_at(names.token_cursor - 1).span)
	names
		.append_plain_parent_node_since(mark, TupleLoopBinderParent, span)
		.push_last_node()


---
Lambda parameters after `(`, through `)`, each pushed; they may continue on
indented lines.
---
pure func parse_lambda_parameters(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = builder.skip_newlines()
	var opened_indent: Bool = False

	if out.at(IndentToken):
		opened_indent = True
		out = out.advance_token()
		out = out.skip_newlines()

	if not out.at(RightParenSymbol):
		var parsing: Bool = True

		while parsing and not out.at(EndOfFileToken):
			out = out.parse_lambda_parameter()
			out = out.push_last_node()

			if out.at(CommaSymbol):
				out = out.advance_token()
				out = out.skip_newlines()

				if opened_indent and out.at(DedentToken):
					out = out.advance_token()
					out = out.skip_newlines()

				if out.at(RightParenSymbol):
					parsing = False
			else:
				parsing = False

	out = out.skip_newlines()

	if opened_indent and out.at(DedentToken):
		out = out.advance_token()
		out = out.skip_newlines()

	out.expect_right_paren(RightParenInLambdaParameters)


private pure func parse_lambda_parameter(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	name: NameId = builder.binder_name_at_cursor()
	name_span: Span = builder.current_span()
	mark: ChildMark = builder.mark_children()
	annotated: DiscoveryBuilder = builder
		.consume_binder_name(NameInLambdaParameter)
		.parse_optional_type_annotation()
	count: Int = annotated.child_count_since(mark)

	span: Span = if count > 0:
		name_span.span_covering(annotated.node_span(annotated.last_node_id()))
	else:
		name_span

	annotated.append_lambda_parameter_node(span, name, name_span, count)


---
The lambda parameter node over its `count` written children (its type, or
none). A typed parameter's name is narrower than the node and has a name span
row; an untyped one is its name alone.
---
private pure func append_lambda_parameter_node(
	builder: DiscoveryBuilder,
	span: Span,
	name: NameId,
	name_span: Span,
	count: Int,
) -> DiscoveryBuilder:
	if count > 0:
		builder.append_named_parent_node_from_stack(
			LambdaParameterParent,
			span,
			name,
			name_span,
			count,
		)
	else:
		builder.append_name_only_parent_node_from_stack(
			LambdaParameterBareParent,
			span,
			name,
			count,
		)
