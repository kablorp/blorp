-- Precedence levels of the binary operators, loosest first. A stray `as` is
-- reported only at the loosest level, so `a + b as T` reports once from the
-- outer loop instead of inside the tighter right operand.
private LOWEST_PRECEDENCE: Int = 0

private OR_PRECEDENCE: Int = 1

private AND_PRECEDENCE: Int = 2

private COMPARISON_PRECEDENCE: Int = 3

private RANGE_PRECEDENCE: Int = 4

private ADDITIVE_PRECEDENCE: Int = 5

private MULTIPLICATIVE_PRECEDENCE: Int = 6

---
The most elements a tuple expression may have; the fewest and most names a
tuple binder may have.
---
private MAX_TUPLE_ITEMS: Int = 4

private MIN_TUPLE_BINDER_NAMES: Int = 2

private MAX_TUPLE_BINDER_NAMES: Int = 4


-- Function declarations.
---
`func name[T](params) -> R where ... : body` for a function, an impl method or
a local function (`kind`); the header carries what came before `func`.
---
pure func parse_function(
	builder: DiscoveryBuilder,
	header: DeclarationHeader,
	kind: DefinitionKind,
) -> DiscoveryBuilder:
	definition: DefinitionId = builder.next_definition_id()
	keyword_span: Span = builder.current_span()
	var out: DiscoveryBuilder = builder.advance_token()
	name: NameId = out.declared_name_at_cursor()
	name_span: Span = out.current_span()
	out = out.consume_declared_name(FunctionName)
	out = out.open_definition(header, kind, name, name_span)
	out = out.parse_type_parameters(definition)
	out = out.parse_signature(definition, header.purity, keyword_span, FunctionName)
	var end: Span = name_span

	if out.at(ArrowSymbol):
		out = out.advance_token()
		out = out.parse_type()
		return_type: NodeId = out.last_node_id()
		out = out.append_definition_type({
			definition = definition,
			type_root = return_type,
		})
		end = out.node_span(return_type)

	constraints_before: Int = out.dimension_constraints.length()
	out = out.parse_dimension_constraints(definition)

	if out.dimension_constraints.length() > constraints_before:
		end = out.constraint_end()

	var has_body: Bool = False

	if out.at(ColonSymbol):
		colon_line: Int = out.span_start_line(out.current_span())
		out = out.advance_token()

		if out.function_body_follows(colon_line):
			out = out.parse_function_body(definition, header.start)
			has_body = True
			end = out.node_span(out.last_node_id())
	else if not (out.at(NewlineToken) or out.at_block_end()):
		out = out.report_at_current_in(ExpectedColonDiagnostic, FunctionBody)

	if not has_body and end.spans_equal(name_span):
		end = keyword_span

	out = out.close_definition(definition, header, kind, name, name_span, end)
	out


---
The span a function's last dimension constraint ends with.
---
private pure func constraint_end(builder: DiscoveryBuilder) -> Span:
	match builder.dimension_constraints.get(builder.dimension_constraints.length() - 1):
		Some(constraint):
			constraint.span
		None:
			builder.current_span()


---
Whether a body follows a function's `:`: not at the end of a block, not a
new line without an indented block (a declaration without a body), and not
a token on a later line (which belongs to what follows).
---
private pure func function_body_follows(builder: DiscoveryBuilder, colon_line: Int) -> Bool:
	if builder.at_block_end():
		False
	else if builder.at(NewlineToken):
		builder.peek_kind(1) == IndentToken
	else:
		builder.span_start_line(builder.current_span()) <= colon_line


---
The body after a function's or trait method's `:`, with its body row. An
indented block on the next line, or an expression on the `:` line.
`anchor` is where the declaration starts.
---
pure func parse_function_body(
	builder: DiscoveryBuilder,
	definition: DefinitionId,
	anchor: Span,
) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = builder.parse_function_body_expression(anchor)
	root: NodeId = out.last_node_id()
	out = out.append_body({
		definition = definition,
		root = root,
	})
	out


---
A function body's expression, parsed outside every loop: a `break` in it cannot
leave a loop the function is declared in. The caller's loop context is saved
and restored as scalar reads and updates (builder threading rules 1 and 3).
---
private pure func parse_function_body_expression(
	builder: DiscoveryBuilder,
	anchor: Span,
) -> DiscoveryBuilder:
	saved: LoopContext = builder.loop_context
	entered: DiscoveryBuilder = builder.with_loop_context(NotInLoop)
	parsed: DiscoveryBuilder = entered.parse_body_expression(anchor)
	parsed.with_loop_context(saved)


---
A block after a `:`, parsed in `context`: `InLoopBody` for a loop's body,
`NotInLoop` for a `concurrent:` task body, whose tasks run apart from the loop
so their `break` cannot leave it and their `?=` returns from the task. The
caller's loop context is saved and restored as in `parse_function_body_expression`.
---
private pure func parse_block_in_loop_context(
	builder: DiscoveryBuilder,
	context: LoopContext,
	anchor: Span,
) -> DiscoveryBuilder:
	saved: LoopContext = builder.loop_context
	entered: DiscoveryBuilder = builder.with_loop_context(context)
	parsed: DiscoveryBuilder = entered.parse_block_after_colon(anchor)
	parsed.with_loop_context(saved)


private pure func parse_body_expression(
	builder: DiscoveryBuilder,
	anchor: Span,
) -> DiscoveryBuilder:
	if builder.at(NewlineToken):
		builder.parse_block_after_colon(anchor)
	else:
		builder.parse_expression()


---
A global's value after its `=` (or where the missing `=` was reported), with
its body row. `anchor` is where the declaration starts.
---
pure func parse_global_value(
	builder: DiscoveryBuilder,
	definition: DefinitionId,
	anchor: Span,
) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = builder.parse_assignment_value(anchor)
	root: NodeId = out.last_node_id()
	out = out.append_body({
		definition = definition,
		root = root,
	})
	out


---
`(params)` of `definition` and its signature row.
---
pure func parse_signature(
	builder: DiscoveryBuilder,
	definition: DefinitionId,
	purity: Purity,
	keyword_span: Span,
	construct: ParsedConstruct,
) -> DiscoveryBuilder:
	parameters_first: Int = builder.parameters.length()
	var out: DiscoveryBuilder = builder.parse_parenthesized_parameters(definition, construct)
	parameters_count: Int = out.parameters.length() - parameters_first
	out = out.append_signature({
		definition = definition,
		purity = purity,
		keyword_span = keyword_span,
		parameters = {
			first = parameters_first,
			count = parameters_count
		},
	})
	out


---
`(params)`, or a report that the `(` is missing.
---
pure func parse_parenthesized_parameters(
	builder: DiscoveryBuilder,
	owner: DefinitionId,
	construct: ParsedConstruct,
) -> DiscoveryBuilder:
	if builder.at(LeftParenSymbol):
		advanced: DiscoveryBuilder = builder.advance_token()
		advanced.parse_parameters(owner)
	else:
		builder.report_at_current_in(ExpectedLeftParenDiagnostic, construct)


---
Parameters after `(`, through `)`; they may continue on indented lines.
---
private pure func parse_parameters(
	builder: DiscoveryBuilder,
	owner: DefinitionId,
) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = builder.skip_newlines()
	var opened_indent: Bool = False
	var ordinal: Int = 0

	if out.at(IndentToken):
		opened_indent = True
		out = out.advance_token()
		out = out.skip_newlines()

	if not out.at(RightParenSymbol):
		var parsing: Bool = True

		while parsing and not out.at(EndOfFileToken):
			out = out.parse_parameter(owner, ordinal)
			ordinal += 1

			if out.at(CommaSymbol):
				out = out.advance_token()
				out = out.skip_newlines()

				if opened_indent and out.at(DedentToken):
					out = out.advance_token()
					out = out.skip_newlines()

				if out.at(RightParenSymbol):
					parsing = False
			else:
				parsing = False

	out = out.skip_newlines()

	if opened_indent and out.at(DedentToken):
		out = out.advance_token()
		out = out.skip_newlines()

	out = out.expect_token_in(RightParenSymbol, ExpectedRightParenDiagnostic, FunctionParameters)
	out


---
One parameter: `name`, `name: T`, `_`, `_: T`, or `(a, b): T`.
---
private pure func parse_parameter(
	builder: DiscoveryBuilder,
	owner: DefinitionId,
	ordinal: Int,
) -> DiscoveryBuilder:
	parameter: ParameterId = builder.next_parameter_id()
	names_first: Int = builder.next_binder_name_row()
	binder_start: Span = builder.current_span()
	binder: ParameterBinder = builder.parameter_binder_at_cursor()
	var out: DiscoveryBuilder = builder.parse_parameter_binder(binder)
	names_count: Int = out.next_binder_name_row() - names_first

	binder_span: Span = if binder == TupleParameterBinder:
		binder_start.span_covering(out.tuple_binder_close_span())
	else:
		binder_start

	if (
		binder == TupleParameterBinder
		and (names_count < MIN_TUPLE_BINDER_NAMES or names_count > MAX_TUPLE_BINDER_NAMES)
	):
		out = out.append_plain_diagnostic(TupleArityDiagnostic, binder_span)

	var span: Span = binder_span

	if out.at(ColonSymbol):
		out = out.advance_token()
		out = out.parse_type()
		parameter_type: NodeId = out.last_node_id()
		out = out.append_parameter_type({
			parameter = parameter,
			type_root = parameter_type,
		})
		span = binder_span.span_covering(out.node_span(parameter_type))

	out = out.append_parameter({
		owner = owner,
		ordinal = ordinal,
		binder = binder,
		binder_names = {
			first = names_first,
			count = names_count
		},
		binder_span = binder_span,
		span = span,
	})
	out


---
The binder form of the parameter at the cursor: `(a, b)` is a tuple, a lone
`_` a wildcard, and a name or `_: T` a named binder (`_` binds the discard
name).
---
private pure func parameter_binder_at_cursor(builder: DiscoveryBuilder) -> ParameterBinder:
	if builder.at(LeftParenSymbol):
		TupleParameterBinder
	else if builder.at(UnderscoreSymbol) and builder.peek_kind(1) != ColonSymbol:
		WildcardParameterBinder
	else:
		NamedParameterBinder


---
Consumes a parameter's binder and appends its binder names.
---
private pure func parse_parameter_binder(
	builder: DiscoveryBuilder,
	binder: ParameterBinder,
) -> DiscoveryBuilder:
	binder_start: Span = builder.current_span()

	match binder:
		TupleParameterBinder:
			advanced: DiscoveryBuilder = builder.advance_token()
			advanced.parse_tuple_binder_names()
		WildcardParameterBinder:
			builder.advance_token()
		NamedParameterBinder:
			if builder.at(UnderscoreSymbol):
				advanced: DiscoveryBuilder = builder.advance_token()
				advanced.append_binder_name({
					name = name_id_at_row(DISCARD_NAME_INDEX),
					span = binder_start,
				})
			else:
				builder.parse_binder_name()


---
One binder name, appended with its span.
---
private pure func parse_binder_name(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	name: NameId = builder.declared_name_at_cursor()
	name_span: Span = builder.current_span()
	out: DiscoveryBuilder = builder.consume_declared_name(ParameterName)
	out.append_binder_name({
		name = name,
		span = name_span,
	})


---
The names of a tuple binder after its `(`, through the `)`.
---
private pure func parse_tuple_binder_names(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	if builder.at(EndOfFileToken):
		builder.expect_token_in(RightParenSymbol, ExpectedRightParenDiagnostic, TupleParameterNames)
	else:
		builder.parse_tuple_binder_name_list()


private pure func parse_tuple_binder_name_list(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = builder.parse_binder_name()
	var parsing: Bool = True

	while parsing:
		if out.at(CommaSymbol):
			out = out.advance_token()

			if out.at(RightParenSymbol) or out.at(EndOfFileToken):
				parsing = False
			else:
				out = out.parse_binder_name()
		else:
			parsing = False

	out = out.expect_token_in(RightParenSymbol, ExpectedRightParenDiagnostic, TupleParameterNames)
	out


---
The token a tuple binder's span ends at: its `)` when `parse_tuple_binder_names`
consumed one, else the token that stood in its place. The names never consume
a `)` (it is a soft boundary), so a `)` just before the cursor is the close.
---
private pure func tuple_binder_close_span(builder: DiscoveryBuilder) -> Span:
	if builder.token_kind_at(builder.token_cursor - 1) == RightParenSymbol:
		builder.token_at(builder.token_cursor - 1).span
	else:
		builder.current_span()


-- Layout.
---
The line and column of the token at `index`.
---
private pure func token_position(builder: DiscoveryBuilder, index: Int) -> LineColumn:
	builder.span_start_position(builder.token_at(index).span)


---
Whether the token at `index` belongs to a block anchored at `anchor`: it is
not the end of a block and sits on a later line in a later column.
---
private pure func indented_past(builder: DiscoveryBuilder, index: Int, anchor: LineColumn) -> Bool:
	kind: TokenKind = builder.token_kind_at(index)

	if kind == EndOfFileToken or kind == DedentToken:
		False
	else:
		position: LineColumn = builder.token_position(index)
		position.line > anchor.line and position.column > anchor.column


---
A block after a `:`: a new line, then the indented statements.
---
private pure func parse_block_after_colon(
	builder: DiscoveryBuilder,
	anchor: Span,
) -> DiscoveryBuilder:
	expected: DiscoveryBuilder = builder.expect_token_in(
		NewlineToken,
		ExpectedNewlineDiagnostic,
		IndentedBlock,
	)
	expected.parse_indented_block(anchor)


---
The statements of a block anchored at `anchor`, with the block's indent and
dedent. A block written without an indent token is accepted when its first
token sits past the anchor.
---
private pure func parse_indented_block(builder: DiscoveryBuilder, anchor: Span) -> DiscoveryBuilder:
	anchor_position: LineColumn = builder.span_start_position(anchor)
	var out: DiscoveryBuilder = builder.consume_block_indent(anchor_position)
	out = out.skip_newlines()
	depth_before: Int = out.child_stack_depth()
	nodes_before: Int = out.nodes.length()
	out = out.parse_statement_list(anchor_position)
	count: Int = out.child_stack_depth() - depth_before
	span: Span = out.block_span(nodes_before, count, anchor)

	if out.at(DedentToken):
		out = out.advance_token()

	out = out.append_parent_node_from_stack(BlockNode, span, count)
	out


---
The span of a block's statements: from the first statement to the last, or
the anchor when the block is empty. The first statement's subtree starts at
node `nodes_before`; its root is the first child on the stack.
---
private pure func block_span(
	builder: DiscoveryBuilder,
	nodes_before: Int,
	count: Int,
	anchor: Span,
) -> Span:
	if count == 0:
		anchor
	else:
		first: NodeId = builder.child_stack
			.get(builder.child_stack_depth - count)
			.get_or(builder.last_node_id())
		span_covering(
			builder.node_span(first),
			builder.node_span(builder.last_node_id()),
		)


---
Consumes a block's indent: skips newlines, then an indent token, or nothing
when the first token already sits past the anchor; otherwise reports the
missing indent.
---
private pure func consume_block_indent(
	builder: DiscoveryBuilder,
	anchor: LineColumn,
) -> DiscoveryBuilder:
	start: Int = builder.run_end(NewlineToken)

	if builder.token_kind_at(start) == IndentToken:
		builder.move_token_cursor(start + 1)
	else if builder.indented_past(start, anchor):
		builder.move_token_cursor(start)
	else:
		moved: DiscoveryBuilder = builder.move_token_cursor(start)
		moved.report_at_current_in(ExpectedIndentDiagnostic, Block)


---
Statements while the tokens sit past the anchor, each pushed on the child
stack. A statement that consumes nothing is skipped past so the loop ends.
---
private pure func parse_statement_list(
	builder: DiscoveryBuilder,
	anchor: LineColumn,
) -> DiscoveryBuilder:
	if builder.at_block_end() or not builder.indented_past(builder.token_cursor, anchor):
		builder
	else:
		builder.parse_statements(anchor)


private pure func parse_statements(
	builder: DiscoveryBuilder,
	anchor: LineColumn,
) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = builder.parse_statement_and_push(anchor)

	while not out.at_block_end() and out.indented_past(out.token_cursor, anchor):
		out = out.parse_statement_and_push(anchor)

	out


private pure func parse_statement_and_push(
	builder: DiscoveryBuilder,
	anchor: LineColumn,
) -> DiscoveryBuilder:
	before: Int = builder.token_cursor
	parsed: DiscoveryBuilder = builder.parse_statement()
	var out: DiscoveryBuilder = parsed.push_last_node()
	out = out.skip_newlines()

	if (
		out.token_cursor == before
		and not out.at_block_end()
		and out.indented_past(out.token_cursor, anchor)
	):
		out = out.advance_token()

	out


-- Statements.
---
One statement, then the dedent that closes a leading-dot continuation
(`value\n\t.method()`) inside a binary expression.
---
private pure func parse_statement(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = builder.parse_statement_form()
	out = out.consume_continuation_dedent()
	out


private pure func parse_statement_form(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	match builder.current_kind():
		VarKeyword:
			builder.parse_var_declaration()
		WhileKeyword:
			builder.parse_while()
		ForKeyword:
			builder.parse_for_statement()
		FuncKeyword | PureKeyword:
			if builder.starts_local_function():
				builder.parse_local_function()
			else:
				builder.parse_named_statement_or_expression()
		LeftParenSymbol:
			if builder.starts_tuple_destructure():
				builder.parse_tuple_destructure()
			else:
				builder.parse_named_statement_or_expression()
		_:
			builder.parse_named_statement_or_expression()


---
A `for` statement, anchored at its own keyword.
---
private pure func parse_for_statement(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	-- Builder threading rule 3.
	anchor: Span = builder.current_span()
	builder.parse_for(anchor)


---
After a statement: when the tokens that follow are newlines and a dedent,
and the statement is a binary expression whose left side continued onto a
later line with a leading `.`, the dedent belongs to that continuation and
is consumed here.
---
private pure func consume_continuation_dedent(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	after: Int = builder.run_end(NewlineToken)

	if (
		builder.token_kind_at(after) == DedentToken
		and builder.needs_continuation_dedent(builder.last_node_id())
	):
		builder.move_token_cursor(after + 1)
	else:
		builder


---
Whether `node` is a binary expression whose left side holds
a leading-dot continuation, or whose right side needs one.
---
private pure func needs_continuation_dedent(builder: DiscoveryBuilder, node: NodeId) -> Bool:
	row: NodeRow = builder.node_row_at(node)

	match row.kind:
		AddNode | SubtractNode | MultiplyNode | DivideNode | ModuloNode | EqualNode | NotEqualNode | LessNode | LessEqualNode | GreaterNode | GreaterEqualNode | AndNode | OrNode:
			(
				builder.child_has_leading_dot_continuation(node, 0)
				or builder.child_needs_continuation_dedent(node, 1)
			)
		_:
			False


private pure func child_needs_continuation_dedent(
	builder: DiscoveryBuilder,
	node: NodeId,
	position: Int,
) -> Bool:
	match builder.node_child_at(node, position):
		Some(child):
			builder.needs_continuation_dedent(child)
		None:
			False


private pure func child_has_leading_dot_continuation(
	builder: DiscoveryBuilder,
	node: NodeId,
	position: Int,
) -> Bool:
	match builder.node_child_at(node, position):
		Some(child):
			builder.has_leading_dot_continuation(child)
		None:
			False


---
Whether `node` holds a field access whose field sits on a later line than
its receiver ends: a `.field` that continued the expression onto a new line.
---
private pure func has_leading_dot_continuation(builder: DiscoveryBuilder, node: NodeId) -> Bool:
	row: NodeRow = builder.node_row_at(node)

	match row.kind:
		FieldAccessNode:
			match builder.node_child_at(node, 0):
				Some(receiver):
					(
						builder.span_end_line(
							row.span,
						) > builder.span_end_line(builder.node_span(receiver))
						or builder.has_leading_dot_continuation(receiver)
					)
				None:
					False
		CallNode | SubscriptNode | AddNode | SubtractNode | MultiplyNode | DivideNode | ModuloNode | EqualNode | NotEqualNode | LessNode | LessEqualNode | GreaterNode | GreaterEqualNode | AndNode | OrNode:
			builder.any_child_has_leading_dot_continuation(row)
		_:
			False


private pure func any_child_has_leading_dot_continuation(
	builder: DiscoveryBuilder,
	row: NodeRow,
) -> Bool:
	var found: Bool = False
	var position: Int = 0

	while not found and position < row.children.count:
		match builder.node_children.get(row.children.first + position):
			Some(child):
				found = builder.has_leading_dot_continuation(child)
			None:
				void

		position += 1

	found


---
`func name(...)` or `pure func name(...)` in a body: a local function, as
opposed to a lambda (`func(...)`).
---
private pure func starts_local_function(builder: DiscoveryBuilder) -> Bool:
	if builder.at(FuncKeyword):
		builder.peek_kind(1) != LeftParenSymbol
	else:
		builder.peek_kind(1) == FuncKeyword and builder.peek_kind(2) != LeftParenSymbol


---
A local function declaration and its `LocalFunctionNode`.
---
private pure func parse_local_function(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	start: Span = builder.current_span()
	definition: DefinitionId = builder.next_definition_id()
	header: DeclarationHeader = { plain_header(
		builder.module_being_parsed(),
		start,
		builder.pending_annotation_count(),
	) |
		purity = builder.local_function_purity()
	}
	after_pure: DiscoveryBuilder = builder.skip_pure_keyword()
	var out: DiscoveryBuilder = after_pure.parse_function(header, LocalFunctionDefinition)
	span: Span = out.definition_span(definition)
	out = out.append_definition_leaf_node(LocalFunctionNode, span, definition)
	out


private pure func local_function_purity(builder: DiscoveryBuilder) -> Purity:
	if builder.at(PureKeyword):
		PureFunction
	else:
		ImpureFunction


private pure func skip_pure_keyword(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	if builder.at(PureKeyword):
		builder.advance_token()
	else:
		builder


private pure func definition_span(builder: DiscoveryBuilder, definition: DefinitionId) -> Span:
	match builder.definitions.get(definition.definition_id_index()):
		Some(row):
			row.span
		None:
			builder.current_span()


---
The module whose body is being parsed. `load_module` appends a module's row
before it lexes and parses the module's tokens, so it is the last module row;
this saves threading the module through every expression routine for the
one that needs it.
---
private pure func module_being_parsed(builder: DiscoveryBuilder) -> ModuleId:
	module_id_at_row(builder.modules.length() - 1)


---
`var name [: T] = value`.
---
private pure func parse_var_declaration(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	start: Span = builder.current_span()
	depth_before: Int = builder.child_stack_depth()
	var out: DiscoveryBuilder = builder.advance_token()
	name: NameId = out.binder_name_at_cursor()
	out = out.consume_binder_name(VariableName)
	out = out.parse_optional_type_annotation()
	out = out.expect_token_in(EqualSymbol, ExpectedEqualDiagnostic, VariableDeclaration)
	out = out.parse_assignment_value(start)
	value_span: Span = out.node_span(out.last_node_id())
	out = out.push_last_node()
	count: Int = out.child_stack_depth() - depth_before
	out = out.append_named_parent_node_from_stack(
		VarDeclarationNode,
		start.span_covering(value_span),
		name,
		count,
	)
	out


---
`: T` when written, its root pushed on the child stack.
---
private pure func parse_optional_type_annotation(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	if builder.at(ColonSymbol):
		advanced: DiscoveryBuilder = builder.advance_token()
		typed: DiscoveryBuilder = advanced.parse_type()
		typed.push_last_node()
	else:
		builder


---
A value after `=`: an expression on the same line, or an indented expression
on the next.
---
private pure func parse_assignment_value(
	builder: DiscoveryBuilder,
	anchor: Span,
) -> DiscoveryBuilder:
	if builder.at(NewlineToken):
		advanced: DiscoveryBuilder = builder.advance_token()
		advanced.parse_indented_assignment_value()
	else:
		with_item: DiscoveryBuilder = builder.parse_anchored_expression(anchor)
		with_item.consume_continuation_dedent()


private pure func parse_indented_assignment_value(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = builder.expect_token_in(
		IndentToken,
		ExpectedIndentDiagnostic,
		AssignmentValue,
	)
	out = out.parse_expression()
	after: Int = out.run_end(NewlineToken)

	if out.token_kind_at(after) == DedentToken:
		out = out.move_token_cursor(after + 1)
	else:
		out = out.move_token_cursor(after)

	out


---
A statement that starts with a name (a binding, an assignment) or any other
expression statement.
---
private pure func parse_named_statement_or_expression(
	builder: DiscoveryBuilder,
) -> DiscoveryBuilder:
	if builder.can_start_named_statement():
		after_name: Int = builder.token_cursor + 1

		if (
			builder.token_kind_at(after_name) == ColonSymbol
			and builder.colon_starts_typed_assignment(after_name)
		):
			builder.parse_typed_named_statement()
		else if starts_assignment_tail(builder.token_kind_at(after_name)):
			builder.parse_named_statement()
		else:
			parsed: DiscoveryBuilder = builder.parse_expression()
			parsed.assignment_after_expression()
	else if builder.at(UnderscoreSymbol):
		if starts_assignment_tail(builder.peek_kind(1)):
			builder.parse_named_statement()
		else:
			builder.parse_expression()
	else:
		parsed: DiscoveryBuilder = builder.parse_expression()
		parsed.assignment_after_expression()


---
Whether the token at the cursor can name a binding: a name, or a reserved
keyword followed by a binding tail (which is then reported once as a
reserved name).
---
private pure func can_start_named_statement(builder: DiscoveryBuilder) -> Bool:
	if (
		builder
			.current_name()
			.is_some()
	):
		True
	else if keyword_name_index(builder.current_kind()).is_some():
		after_name: Int = builder.token_cursor + 1
		(
			starts_assignment_tail(builder.token_kind_at(after_name))
			or (
				builder.token_kind_at(after_name) == ColonSymbol
				and builder.colon_starts_typed_assignment(after_name)
			)
		)
	else:
		False


private pure func starts_assignment_tail(kind: TokenKind) -> Bool:
	match kind:
		EqualSymbol | QuestionEqualsSymbol | PlusEqualSymbol | MinusEqualSymbol | StarEqualSymbol | SlashEqualSymbol:
			True
		_:
			False


---
Whether the `:` at `colon` starts a type annotation of a binding: an `=` or
`?=` follows at bracket depth zero before the end of the line, a `,`, a `:`
or an unmatched closing bracket.
---
private pure func colon_starts_typed_assignment(builder: DiscoveryBuilder, colon: Int) -> Bool:
	var index: Int = colon + 1
	var depth: Int = 0
	var found: Bool = False
	var scanning: Bool = True

	while scanning:
		match builder.token_kind_at(index):
			EndOfFileToken | NewlineToken | DedentToken:
				scanning = False
			EqualSymbol | QuestionEqualsSymbol:
				if depth == 0:
					found = True
					scanning = False
				else:
					index += 1
			LeftParenSymbol | LeftBracketSymbol | LeftBraceSymbol:
				depth += 1
				index += 1
			RightParenSymbol | RightBracketSymbol | RightBraceSymbol:
				if depth == 0:
					scanning = False
				else:
					depth -= 1
					index += 1
			CommaSymbol | ColonSymbol:
				if depth == 0:
					scanning = False
				else:
					index += 1
			_:
				index += 1

	found


---
`name: T = value` or `name: T ?= value`. A compound assignment never has a
type: `colon_starts_typed_assignment` looks for `=` or `?=` only.
---
private pure func parse_typed_named_statement(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	name: NameId = builder.binder_name_at_cursor()
	name_span: Span = builder.current_span()
	depth_before: Int = builder.child_stack_depth()
	var out: DiscoveryBuilder = builder.consume_binder_name(StatementName)
	out = out.parse_optional_type_annotation()
	out = out.parse_named_assignment_tail(name, name_span, depth_before)
	out


---
`name = value`, `name ?= value` or `name op= value`.
---
private pure func parse_named_statement(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	name: NameId = builder.binder_name_at_cursor()
	name_span: Span = builder.current_span()
	depth_before: Int = builder.child_stack_depth()
	var out: DiscoveryBuilder = builder.consume_binder_name(StatementName)
	out = out.parse_named_assignment_tail(name, name_span, depth_before)
	out


---
The operator and value of a binding or assignment to `name`. Children pushed
since `depth_before` (the type, when written) belong to the statement.
---
private pure func parse_named_assignment_tail(
	builder: DiscoveryBuilder,
	name: NameId,
	name_span: Span,
	depth_before: Int,
) -> DiscoveryBuilder:
	typed: Bool = builder.child_stack_depth() > depth_before

	match builder.current_kind():
		EqualSymbol:
			if typed:
				builder.parse_named_value(TypedBindingNode, name, name_span, depth_before)
			else:
				builder.parse_named_value(AssignmentNode, name, name_span, depth_before)
		QuestionEqualsSymbol:
			builder.parse_question_bind_value(name, name_span, depth_before)
		PlusEqualSymbol:
			builder.parse_named_value(AddAssignNode, name, name_span, depth_before)
		MinusEqualSymbol:
			builder.parse_named_value(SubtractAssignNode, name, name_span, depth_before)
		StarEqualSymbol:
			builder.parse_named_value(MultiplyAssignNode, name, name_span, depth_before)
		SlashEqualSymbol:
			builder.parse_named_value(DivideAssignNode, name, name_span, depth_before)
		_:
			reported: DiscoveryBuilder = builder.report_at_current(
				ExpectedAssignmentOperatorDiagnostic,
			)
			reported.missing_statement(name_span, depth_before)


---
The value after the operator at the cursor and the `kind` statement over it.
---
private pure func parse_named_value(
	builder: DiscoveryBuilder,
	kind: NodeKind,
	name: NameId,
	name_span: Span,
	depth_before: Int,
) -> DiscoveryBuilder:
	advanced: DiscoveryBuilder = builder.advance_token()
	valued: DiscoveryBuilder = advanced.parse_assignment_value(name_span)
	valued.finish_named_statement(kind, name, name_span, depth_before)


private pure func parse_question_bind_value(
	builder: DiscoveryBuilder,
	name: NameId,
	name_span: Span,
	depth_before: Int,
) -> DiscoveryBuilder:
	reported: DiscoveryBuilder = builder.report_question_bind_in_loop()
	advanced: DiscoveryBuilder = reported.advance_token()
	valued: DiscoveryBuilder = advanced.parse_assignment_value(name_span)
	valued.finish_question_bind(name, name_span, depth_before)


---
Reports the `?=` at the cursor when it is inside a loop body: each iteration
would have to return from the enclosing function. The carrier checks that need
types stay in typechecking.
---
private pure func report_question_bind_in_loop(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	operator_span: Span = builder.current_span()

	match builder.loop_context:
		InLoopBody:
			builder.append_plain_diagnostic(QuestionBindInLoopDiagnostic, operator_span)
		NotInLoop:
			builder


---
Appends a named statement over the children pushed since `depth_before`
and the value just parsed.
---
private pure func finish_named_statement(
	builder: DiscoveryBuilder,
	kind: NodeKind,
	name: NameId,
	name_span: Span,
	depth_before: Int,
) -> DiscoveryBuilder:
	value_span: Span = builder.node_span(builder.last_node_id())
	var out: DiscoveryBuilder = builder.push_last_node()
	count: Int = out.child_stack_depth() - depth_before
	out = out.append_named_parent_node_from_stack(
		kind,
		name_span.span_covering(value_span),
		name,
		count,
	)
	out


---
`name ?= value`; `_ ?= value` is reported, since the unwrapped value needs a
name.
---
private pure func finish_question_bind(
	builder: DiscoveryBuilder,
	name: NameId,
	name_span: Span,
	depth_before: Int,
) -> DiscoveryBuilder:
	if name.name_id_index() == DISCARD_NAME_INDEX:
		reported: DiscoveryBuilder = builder.append_plain_diagnostic(
			DiscardedQuestionBindDiagnostic,
			name_span,
		)
		reported.finish_named_statement(QuestionBindNode, name, name_span, depth_before)
	else:
		builder.finish_named_statement(QuestionBindNode, name, name_span, depth_before)


---
A statement that could not be parsed, over the children pushed since
`depth_before`.
---
private pure func missing_statement(
	builder: DiscoveryBuilder,
	span: Span,
	depth_before: Int,
) -> DiscoveryBuilder:
	count: Int = builder.child_stack_depth() - depth_before
	builder.append_parent_node_from_stack(MissingExpressionNode, span, count)


---
An `=` after a parsed expression: an assignment to a name, a subscript
assignment, or a reported field assignment. Any other expression is left as
it is and the `=` unconsumed.
---
private pure func assignment_after_expression(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	if builder.at(EqualSymbol):
		target: NodeRow = builder.node_row_at(builder.last_node_id())

		match target.kind:
			IdentifierNode:
				-- A named argument (`f(name = value)`): the assignment records the
				-- name itself, so the identifier node is discarded, not orphaned.
				depth: Int = builder.child_stack_depth()
				discarded: DiscoveryBuilder = builder.discard_last_leaf_node()
				advanced: DiscoveryBuilder = discarded.advance_token()
				valued: DiscoveryBuilder = advanced.parse_assignment_value(target.span)
				valued.finish_named_statement(
					AssignmentNode,
					name_id_at_row(target.payload),
					target.span,
					depth,
				)
			SubscriptNode:
				pushed: DiscoveryBuilder = builder.push_last_node()
				pushed.finish_target_assignment(SubscriptAssignmentNode, target.span)
			FieldAccessNode:
				pushed: DiscoveryBuilder = builder.push_last_node()
				reported: DiscoveryBuilder = pushed.append_plain_diagnostic(
					FieldAssignmentDiagnostic,
					target.span,
				)
				reported.finish_target_assignment(MissingExpressionNode, target.span)
			_:
				builder
	else:
		builder


---
The value after an `=` whose target the caller pushed, and the node over
both.
---
private pure func finish_target_assignment(
	builder: DiscoveryBuilder,
	kind: NodeKind,
	target_span: Span,
) -> DiscoveryBuilder:
	advanced: DiscoveryBuilder = builder.advance_token()
	var out: DiscoveryBuilder = advanced.parse_assignment_value(target_span)
	value_span: Span = out.node_span(out.last_node_id())
	out = out.push_last_node()
	out = out.append_parent_node_from_stack(
		kind,
		target_span.span_covering(value_span),
		2,
	)
	out


---
Whether `(` starts a tuple destructuring assignment: two or more binder
names (names, `_`, or reserved keywords, which are then reported) separated
by commas, a `)`, and `=`.
---
private pure func starts_tuple_destructure(builder: DiscoveryBuilder) -> Bool:
	var index: Int = builder.token_cursor + 1
	var saw_comma: Bool = False
	var expecting_name: Bool = True
	var closed: Bool = False
	var valid: Bool = True

	while valid and not closed:
		kind: TokenKind = builder.token_kind_at(index)

		if expecting_name:
			if (
				kind == IdentifierToken
				or kind == UnderscoreSymbol
				or kind.is_reserved_keyword()
			):
				index += 1
				expecting_name = False
			else:
				valid = False
		else if kind == CommaSymbol:
			saw_comma = True
			index += 1

			if builder.token_kind_at(index) == RightParenSymbol:
				closed = True
			else:
				expecting_name = True
		else if kind == RightParenSymbol:
			closed = True
		else:
			valid = False

	valid and closed and saw_comma and builder.token_kind_at(index + 1) == EqualSymbol


private pure func is_reserved_keyword(kind: TokenKind) -> Bool:
	(
		kind
			.keyword_name_index()
			.is_some()
		and not kind.is_soft_keyword()
	)


---
`(a, b) = value`.
---
private pure func parse_tuple_destructure(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	start: Span = builder.current_span()
	depth_before: Int = builder.child_stack_depth()
	advanced: DiscoveryBuilder = builder.advance_token()
	var out: DiscoveryBuilder = advanced.parse_tuple_binder(
		start,
		DestructureBinderNode,
		TupleDestructuringNames,
	)
	out = out.expect_token_in(EqualSymbol, ExpectedEqualDiagnostic, TupleDestructuring)
	out = out.parse_assignment_value(start)
	value_span: Span = out.node_span(out.last_node_id())
	out = out.push_last_node()
	count: Int = out.child_stack_depth() - depth_before
	out = out.append_parent_node_from_stack(
		TupleDestructureNode,
		start.span_covering(value_span),
		count,
	)
	out


---
The names of a tuple binder after its `(`, through the `)`, each a `kind`
leaf pushed on the child stack; `_` is allowed. Two to four names.
---
private pure func parse_tuple_binder(
	builder: DiscoveryBuilder,
	start: Span,
	kind: NodeKind,
	construct: ParsedConstruct,
) -> DiscoveryBuilder:
	depth_before: Int = builder.child_stack_depth()
	var out: DiscoveryBuilder = builder.push_binder_leaf(kind)
	var end: Span = out.node_span(out.last_node_id())

	if out.at(CommaSymbol):
		out = out.advance_token()
		var parsing: Bool = True

		while parsing and not out.at(EndOfFileToken):
			if out.at(RightParenSymbol):
				out = out.report_at_current_in(ExpectedNameDiagnostic, TupleBinderName)
				parsing = False
			else:
				out = out.push_binder_leaf(kind)
				end = out.node_span(out.last_node_id())

				if out.at(CommaSymbol):
					out = out.advance_token()

					if out.at(RightParenSymbol):
						parsing = False
				else:
					parsing = False
	else:
		out = out.report_at_current_in(ExpectedCommaDiagnostic, construct)

	if out.at(RightParenSymbol):
		end = out.current_span()

	out = out.expect_token_in(RightParenSymbol, ExpectedRightParenDiagnostic, construct)
	count: Int = out.child_stack_depth() - depth_before

	if count < MIN_TUPLE_BINDER_NAMES or count > MAX_TUPLE_BINDER_NAMES:
		out = out.append_plain_diagnostic(
			TupleArityDiagnostic,
			start.span_covering(end),
		)

	out


---
A binder name (`_` allowed) as a `kind` leaf, pushed on the child stack.
---
private pure func push_binder_leaf(builder: DiscoveryBuilder, kind: NodeKind) -> DiscoveryBuilder:
	name: NameId = builder.binder_name_at_cursor()
	span: Span = builder.current_span()
	after_name: DiscoveryBuilder = builder.consume_binder_name(TupleBinderName)
	with_leaf: DiscoveryBuilder = after_name.append_name_leaf_node(kind, span, name)
	with_leaf.push_last_node()


-- Control flow.
---
`while condition: body`.
---
private pure func parse_while(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	start: Span = builder.current_span()
	advanced: DiscoveryBuilder = builder.advance_token()
	parsed: DiscoveryBuilder = advanced.parse_expression()
	var out: DiscoveryBuilder = parsed.push_last_node()
	out = out.expect_token_in(ColonSymbol, ExpectedColonDiagnostic, WhileCondition)
	out = out.parse_block_in_loop_context(InLoopBody, start)
	out = out.finish_with_body(WhileNode, start, 2)
	out


---
Appends a `kind` node over `count` children, the last of which is the body
just parsed (and not yet pushed), spanning from `start` to the body.
---
private pure func finish_with_body(
	builder: DiscoveryBuilder,
	kind: NodeKind,
	start: Span,
	count: Int,
) -> DiscoveryBuilder:
	body_span: Span = builder.node_span(builder.last_node_id())
	var out: DiscoveryBuilder = builder.push_last_node()
	out = out.append_parent_node_from_stack(
		kind,
		start.span_covering(body_span),
		count,
	)
	out


---
`if condition: block [else if ... | else: block]`.
---
private pure func parse_if(builder: DiscoveryBuilder, anchor: Span) -> DiscoveryBuilder:
	start: Span = builder.current_span()
	depth_before: Int = builder.child_stack_depth()
	advanced: DiscoveryBuilder = builder.advance_token()
	parsed: DiscoveryBuilder = advanced.parse_expression()
	var out: DiscoveryBuilder = parsed.push_last_node()
	out = out.expect_token_in(ColonSymbol, ExpectedColonDiagnostic, IfCondition)
	out = out.parse_block_after_colon(anchor)
	var end: Span = out.node_span(out.last_node_id())
	out = out.push_last_node()

	if out.at(ElseKeyword):
		out = out.parse_else_branch()
		end = out.node_span(out.last_node_id())
		out = out.push_last_node()

	count: Int = out.child_stack_depth() - depth_before
	out = out.append_parent_node_from_stack(
		IfNode,
		start.span_covering(end),
		count,
	)
	out


private pure func parse_else_branch(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	else_span: Span = builder.current_span()
	out: DiscoveryBuilder = builder.advance_token()

	if out.at(IfKeyword):
		out.parse_if(else_span)
	else:
		expected: DiscoveryBuilder = out.expect_token_in(
			ColonSymbol,
			ExpectedColonDiagnostic,
			ElseBranch,
		)
		expected.parse_block_after_colon(else_span)


---
`match scrutinee:` then an indented block of cases.
---
private pure func parse_match(builder: DiscoveryBuilder, anchor: Span) -> DiscoveryBuilder:
	start: Span = builder.current_span()
	depth_before: Int = builder.child_stack_depth()
	advanced: DiscoveryBuilder = builder.advance_token()
	parsed: DiscoveryBuilder = advanced.parse_expression()
	var out: DiscoveryBuilder = parsed.push_last_node()
	out = out.expect_token_in(ColonSymbol, ExpectedColonDiagnostic, MatchExpression)
	out = out.expect_token_in(NewlineToken, ExpectedNewlineDiagnostic, MatchCases)
	anchor_position: LineColumn = out.span_start_position(anchor)
	out = out.consume_block_indent(anchor_position)
	out = out.skip_newlines()
	out = out.parse_match_cases(anchor_position)
	end: Span = out.arms_end_span(start)
	out = out.skip_dedent()
	count: Int = out.child_stack_depth() - depth_before
	out = out.append_parent_node_from_stack(
		MatchNode,
		start.span_covering(end),
		count,
	)
	out


---
Where a match or select ends: its closing dedent, or its keyword when the
arms end some other way.
---
private pure func arms_end_span(builder: DiscoveryBuilder, start: Span) -> Span:
	if builder.at(DedentToken):
		builder.current_span()
	else:
		start


private pure func skip_dedent(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	if builder.at(DedentToken):
		builder.advance_token()
	else:
		builder


---
Match cases while the tokens sit past the anchor, each pushed.
---
private pure func parse_match_cases(
	builder: DiscoveryBuilder,
	anchor: LineColumn,
) -> DiscoveryBuilder:
	if builder.at_block_end() or not builder.indented_past(builder.token_cursor, anchor):
		builder
	else:
		builder.parse_match_case_run(anchor)


private pure func parse_match_case_run(
	builder: DiscoveryBuilder,
	anchor: LineColumn,
) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = builder.parse_match_case_and_push(anchor)

	while not out.at_block_end() and out.indented_past(out.token_cursor, anchor):
		out = out.parse_match_case_and_push(anchor)

	out


private pure func parse_match_case_and_push(
	builder: DiscoveryBuilder,
	anchor: LineColumn,
) -> DiscoveryBuilder:
	before: Int = builder.token_cursor
	with_case: DiscoveryBuilder = builder.parse_match_case()
	var out: DiscoveryBuilder = with_case.push_last_node()
	out = out.skip_newlines()

	if (
		out.token_cursor == before
		and not out.at_block_end()
		and out.indented_past(out.token_cursor, anchor)
	):
		out = out.advance_token()

	out


---
`pattern: body`: a block on the next lines, a `match` or `if` on the same
line (anchored at the pattern), or a statement.
---
private pure func parse_match_case(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = builder.parse_pattern()
	pattern_span: Span = out.node_span(out.last_node_id())
	out = out.push_last_node()
	out = out.expect_token_in(ColonSymbol, ExpectedColonDiagnostic, MatchPattern)
	out = out.parse_case_body(pattern_span)
	out = out.finish_with_body(MatchCaseNode, pattern_span, 2)
	out


private pure func parse_case_body(
	builder: DiscoveryBuilder,
	pattern_span: Span,
) -> DiscoveryBuilder:
	match builder.current_kind():
		NewlineToken:
			builder.parse_block_after_colon(pattern_span)
		MatchKeyword:
			builder.parse_match(pattern_span)
		IfKeyword:
			builder.parse_if(pattern_span)
		_:
			builder.parse_statement()


---
`select:` then an indented block of arms.
---
private pure func parse_select(builder: DiscoveryBuilder, anchor: Span) -> DiscoveryBuilder:
	start: Span = builder.current_span()
	depth_before: Int = builder.child_stack_depth()
	var out: DiscoveryBuilder = builder.advance_token()
	out = out.expect_token_in(ColonSymbol, ExpectedColonDiagnostic, SelectHeader)
	out = out.expect_token_in(NewlineToken, ExpectedNewlineDiagnostic, SelectArms)
	anchor_position: LineColumn = out.span_start_position(anchor)
	out = out.consume_block_indent(anchor_position)
	out = out.skip_newlines()
	out = out.parse_select_arms(anchor_position)
	end: Span = out.arms_end_span(start)
	out = out.skip_dedent()
	count: Int = out.child_stack_depth() - depth_before
	out = out.append_parent_node_from_stack(
		SelectNode,
		start.span_covering(end),
		count,
	)
	out


private pure func parse_select_arms(
	builder: DiscoveryBuilder,
	anchor: LineColumn,
) -> DiscoveryBuilder:
	if builder.at_block_end() or not builder.indented_past(builder.token_cursor, anchor):
		builder
	else:
		builder.parse_select_arm_run(anchor)


private pure func parse_select_arm_run(
	builder: DiscoveryBuilder,
	anchor: LineColumn,
) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = builder.parse_select_arm_and_push(anchor)

	while not out.at_block_end() and out.indented_past(out.token_cursor, anchor):
		out = out.parse_select_arm_and_push(anchor)

	out


private pure func parse_select_arm_and_push(
	builder: DiscoveryBuilder,
	anchor: LineColumn,
) -> DiscoveryBuilder:
	before: Int = builder.token_cursor
	with_arm: DiscoveryBuilder = builder.parse_select_arm()
	var out: DiscoveryBuilder = with_arm.push_last_node()
	out = out.skip_newlines()

	if (
		out.token_cursor == before
		and not out.at_block_end()
		and out.indented_past(out.token_cursor, anchor)
	):
		out = out.advance_token()

	out


---
`sealed channel: body`, `_ after timeout: body`, or `name from channel: body`.
---
private pure func parse_select_arm(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	if builder.at(SealedKeyword):
		start: Span = builder.current_span()
		advanced: DiscoveryBuilder = builder.advance_token()
		advanced.parse_select_channel_arm(start, SelectSealedArmNode)
	else if builder.at(UnderscoreSymbol) and builder.peek_kind(1) == AfterKeyword:
		start: Span = builder.current_span()
		-- Past the `_` and the `after`.
		after_keyword_index: Int = builder.token_cursor + 2
		after_keyword: DiscoveryBuilder = builder.move_token_cursor(after_keyword_index)
		after_keyword.parse_select_channel_arm(start, SelectAfterArmNode)
	else:
		builder.parse_select_receive_arm()


---
The expression, `:` and body of a sealed or timeout arm, from after its
leading keyword.
---
private pure func parse_select_channel_arm(
	builder: DiscoveryBuilder,
	start: Span,
	kind: NodeKind,
) -> DiscoveryBuilder:
	construct: ParsedConstruct = if kind == SelectSealedArmNode:
		SealedSelectChannel
	else:
		SelectTimeout

	parsed: DiscoveryBuilder = builder.parse_expression()
	var out: DiscoveryBuilder = parsed.push_last_node()
	out = out.expect_token_in(ColonSymbol, ExpectedColonDiagnostic, construct)
	out = out.parse_block_after_colon(start)
	out = out.finish_with_body(kind, start, 2)
	out


---
`name from channel: body`; the binder may also be `_`, `after` or `from`.
---
private pure func parse_select_receive_arm(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	start: Span = builder.current_span()
	binder: NameId = builder.receive_binder_at_cursor()
	var out: DiscoveryBuilder = builder.consume_receive_binder()
	out = out.expect_token_in(FromKeyword, ExpectedKeywordDiagnostic, SelectReceiveBinding)
	out = out.parse_expression()
	out = out.push_last_node()
	out = out.expect_token_in(ColonSymbol, ExpectedColonDiagnostic, SelectReceiveChannel)
	out = out.parse_block_after_colon(start)
	body_span: Span = out.node_span(out.last_node_id())
	out = out.push_last_node()
	out = out.append_named_parent_node_from_stack(
		SelectReceiveArmNode,
		start.span_covering(body_span),
		binder,
		2,
	)
	out


private pure func receive_binder_at_cursor(builder: DiscoveryBuilder) -> NameId:
	if builder.at(FromKeyword):
		match keyword_name_index(FromKeyword):
			Some(index):
				name_id_at_row(index)
			None:
				builder.binder_name_at_cursor()
	else:
		builder.binder_name_at_cursor()


private pure func consume_receive_binder(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	if builder.at(FromKeyword):
		builder.advance_token()
	else:
		builder.consume_binder_name(SelectReceiveBinding)


---
`for binder in iterable: body`, or `for x in xs concurrently(...): body`.
---
private pure func parse_for(builder: DiscoveryBuilder, anchor: Span) -> DiscoveryBuilder:
	start: Span = builder.current_span()
	depth_before: Int = builder.child_stack_depth()
	var out: DiscoveryBuilder = builder.advance_token()
	tuple_binder: Bool = out.at(LeftParenSymbol)
	out = out.parse_loop_binder()
	out = out.expect_token_in(InKeyword, ExpectedKeywordDiagnostic, ForLoopVariable)
	out = out.parse_expression()
	out = out.push_last_node()

	if out.at(ConcurrentlyKeyword):
		if tuple_binder:
			out = out.report_at_current(ConcurrentForTupleBinderDiagnostic)

		out = out.advance_token()
		out = out.parse_concurrent_parameters_after_concurrently()
		out = out.expect_token_in(ColonSymbol, ExpectedColonDiagnostic, ConcurrentlyParameters)
		out = out.parse_block_in_loop_context(InLoopBody, anchor)
		count: Int = out.child_stack_depth() + 1 - depth_before
		out = out.finish_with_body(ConcurrentForNode, start, count)
	else:
		out = out.expect_token_in(ColonSymbol, ExpectedColonDiagnostic, ForIterable)
		out = out.parse_block_in_loop_context(InLoopBody, anchor)
		count: Int = out.child_stack_depth() + 1 - depth_before
		out = out.finish_with_body(ForNode, start, count)

	out


---
A loop variable, or `(a, b)` loop variables, pushed on the child stack.
---
private pure func parse_loop_binder(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	if builder.at(LeftParenSymbol):
		builder.parse_tuple_loop_binder()
	else:
		builder.push_binder_leaf(LoopBinderNode)


private pure func parse_tuple_loop_binder(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	start: Span = builder.current_span()
	depth_before: Int = builder.child_stack_depth()
	advanced: DiscoveryBuilder = builder.advance_token()
	var out: DiscoveryBuilder = advanced.parse_tuple_binder(
		start,
		LoopBinderNode,
		TupleLoopVariables,
	)
	count: Int = out.child_stack_depth() - depth_before
	span: Span = start.span_covering(out.token_at(out.token_cursor - 1).span)
	out = out.append_parent_node_from_stack(TupleLoopBinderNode, span, count)
	out = out.push_last_node()
	out


---
Which construct owns a concurrency parameter list; the two accept different
names (`max_threads` versus `limit`).
---
private enum ConcurrentParameterOwner:
	ConcurrentBlockOwner
	ConcurrentForOwner


---
Which parameter a name is, for the concurrency parameter rules. The spelling
is matched once, in `concurrent_parameter_name`.
---
private enum ConcurrentParameterName:
	MaxThreadsParameter
	LimitParameter
	TimeoutParameter
	UnknownParameter


---
The builder after a parameter list, plus the parameters seen so far (for
duplicate and missing-`limit` checks).
---
private record ConcurrentParameterRun {
	builder: DiscoveryBuilder,
	seen: List[ConcurrentParameterName],
	count_named: Bool
}


---
The `(name: value, ...)` after `concurrently`, each parameter pushed; a
missing `(` is reported.
---
private pure func parse_concurrent_parameters_after_concurrently(
	builder: DiscoveryBuilder,
) -> DiscoveryBuilder:
	if builder.at(LeftParenSymbol):
		advanced: DiscoveryBuilder = builder.advance_token()
		advanced.parse_concurrent_parameter_list(ConcurrentForOwner)
	else:
		builder.report_at_current_in(ExpectedLeftParenDiagnostic, ConcurrentlyHeader)


---
Concurrent parameters after `(`, through the `)`; at least one. The rules
match the existing parser: `concurrent` takes optional `max_threads` and
`timeout`; `concurrently` requires `limit` and takes optional `timeout`; a
count is a positive integer literal and every name appears once.
---
private pure func parse_concurrent_parameter_list(
	builder: DiscoveryBuilder,
	owner: ConcurrentParameterOwner,
) -> DiscoveryBuilder:
	run: ConcurrentParameterRun = builder.parse_concurrent_parameters(owner)
	var out: DiscoveryBuilder = run.builder

	if (
		owner == ConcurrentForOwner
		and run.seen.length() > 0
		and not run.count_named
	):
		out = out.report_at_current(ConcurrentForMissingLimitDiagnostic)

	construct: ParsedConstruct = if owner == ConcurrentForOwner:
		ConcurrentlyParameters
	else:
		ConcurrentParameters

	out = out.expect_token_in(RightParenSymbol, ExpectedRightParenDiagnostic, construct)
	out


private pure func parse_concurrent_parameters(
	builder: DiscoveryBuilder,
	owner: ConcurrentParameterOwner,
) -> ConcurrentParameterRun:
	if builder.at(RightParenSymbol):
		{
			builder = builder.report_at_current(ExpectedConcurrentParameterDiagnostic),
			seen = [],
			count_named = False
		}
	else if builder.at(EndOfFileToken):
		{
			builder = builder,
			seen = [],
			count_named = False
		}
	else:
		builder.parse_concurrent_parameter_run(owner)


private pure func parse_concurrent_parameter_run(
	builder: DiscoveryBuilder,
	owner: ConcurrentParameterOwner,
) -> ConcurrentParameterRun:
	var out: DiscoveryBuilder = builder
	var seen: List[ConcurrentParameterName] = []

	while not out.at(RightParenSymbol) and not out.at(EndOfFileToken):
		name: ConcurrentParameterName = out.concurrent_parameter_name()
		out = out.parse_concurrent_parameter(owner, name, seen)
		seen = seen.append(name)

	{
		builder = out,
		seen = seen,
		count_named = seen.concurrent_parameter_seen(owner.concurrent_count_parameter())
	}


private pure func concurrent_parameter_seen(
	seen: List[ConcurrentParameterName],
	name: ConcurrentParameterName,
) -> Bool:
	var found: Bool = False

	for earlier in seen:
		if earlier == name:
			found = True

	found


---
The count parameter `owner` requires or allows: `max_threads` for
`concurrent`, `limit` for `concurrently`.
---
private pure func concurrent_count_parameter(
	owner: ConcurrentParameterOwner,
) -> ConcurrentParameterName:
	match owner:
		ConcurrentBlockOwner:
			MaxThreadsParameter
		ConcurrentForOwner:
			LimitParameter


---
Which parameter the token at the cursor names; anything that is not one of
the three known identifiers is `UnknownParameter`.
---
private pure func concurrent_parameter_name(builder: DiscoveryBuilder) -> ConcurrentParameterName:
	if not builder.at(IdentifierToken):
		UnknownParameter
	else if builder.current_token().payload == MAX_THREADS_NAME_INDEX:
		MaxThreadsParameter
	else if builder.current_token().payload == LIMIT_NAME_INDEX:
		LimitParameter
	else if builder.current_token().payload == TIMEOUT_NAME_INDEX:
		TimeoutParameter
	else:
		UnknownParameter


---
Reports a parameter whose name `owner` does not accept, that repeats an
earlier name, or whose count is not a positive integer literal. Like the
existing parser, only the first occurrence of a name has its value checked.
`value` is the parameter's parsed value node.
---
private pure func check_concurrent_parameter(
	builder: DiscoveryBuilder,
	owner: ConcurrentParameterOwner,
	name: ConcurrentParameterName,
	name_id: NameId,
	seen: List[ConcurrentParameterName],
	name_span: Span,
	value: NodeId,
) -> DiscoveryBuilder:
	count: ConcurrentParameterName = owner.concurrent_count_parameter()

	if name == count or name == TimeoutParameter:
		if seen.concurrent_parameter_seen(name):
			builder.append_diagnostic_with_argument(
				ConcurrentDuplicateParameterDiagnostic,
				name_span,
				name_id.name_id_index(),
			)
		else if name == count and not builder.is_positive_integer_literal(value):
			code: DiscoveryDiagnosticCode = match owner:
				ConcurrentBlockOwner:
					ConcurrentMaxThreadsNotPositiveLiteralDiagnostic
				ConcurrentForOwner:
					ConcurrentLimitNotPositiveLiteralDiagnostic

			builder.append_plain_diagnostic(
				code,
				builder.node_span(value),
			)
		else:
			builder
	else:
		match owner:
			ConcurrentBlockOwner:
				builder.append_diagnostic_with_argument(
					ConcurrentUnknownParameterDiagnostic,
					name_span,
					name_id.name_id_index(),
				)
			ConcurrentForOwner:
				if name == MaxThreadsParameter:
					builder.append_plain_diagnostic(ConcurrentForMaxThreadsDiagnostic, name_span)
				else:
					builder.append_diagnostic_with_argument(
						ConcurrentForUnknownParameterDiagnostic,
						name_span,
						name_id.name_id_index(),
					)


---
True when `value` is an integer literal node that is positive. `2 + 2`, `-1`
and calls are other node kinds. Like the existing parser it accepts a
literal above `Int`'s range, which `parse_int` saturates; rejecting those is
a general typecheck rule, not a check here.
---
private pure func is_positive_integer_literal(builder: DiscoveryBuilder, value: NodeId) -> Bool:
	row: NodeRow = builder.node_row_at(value)

	match row.kind:
		IntegerLiteralNode:
			match builder.literals.get(row.payload):
				Some(text):
					match text.parse_int():
						Some(number):
							number > 0
						None:
							False
				None:
					False
		_:
			False


---
`name: value` and the comma after it, pushed, checked against `owner`'s
rules. It always moves the cursor unless the cursor is at the `)`, so the
list above ends.
---
private pure func parse_concurrent_parameter(
	builder: DiscoveryBuilder,
	owner: ConcurrentParameterOwner,
	parameter: ConcurrentParameterName,
	seen: List[ConcurrentParameterName],
) -> DiscoveryBuilder:
	before: Int = builder.token_cursor
	name: NameId = builder.referenced_name_at_cursor()
	name_span: Span = builder.current_span()
	var out: DiscoveryBuilder = builder.consume_referenced_name(ConcurrentNamedParameter)
	out = out.expect_token_in(ColonSymbol, ExpectedColonDiagnostic, ConcurrentNamedParameter)
	out = out.parse_expression()
	value: NodeId = out.last_node_id()
	value_span: Span = out.node_span(value)
	out = out.check_concurrent_parameter(owner, parameter, name, seen, name_span, value)
	out = out.push_last_node()
	out = out.append_named_parent_node_from_stack(
		ConcurrentParameterNode,
		name_span.span_covering(value_span),
		name,
		1,
	)
	out = out.push_last_node()

	if out.at(CommaSymbol):
		out = out.advance_token()
	else if not out.at(RightParenSymbol):
		out = out.report_at_current_in(ExpectedCommaDiagnostic, ConcurrentParameters)

	if out.token_cursor == before and not out.at(RightParenSymbol):
		out = out.advance_token()

	out


---
`concurrent[(params)]: body`.
---
private pure func parse_concurrent_block(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	start: Span = builder.current_span()
	depth_before: Int = builder.child_stack_depth()
	var out: DiscoveryBuilder = builder.advance_token()

	if out.at(LeftParenSymbol):
		out = out.advance_token()
		out = out.parse_concurrent_parameter_list(ConcurrentBlockOwner)

	out = out.expect_token_in(ColonSymbol, ExpectedColonDiagnostic, ConcurrentBlock)
	out = out.parse_block_in_loop_context(NotInLoop, start)
	count: Int = out.child_stack_depth() + 1 - depth_before
	out = out.finish_with_body(ConcurrentBlockNode, start, count)
	out


---
`debug: body`; `debug.name` is the name `debug` (see `parse_primary`).
---
private pure func parse_debug_block(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	start: Span = builder.current_span()
	advanced: DiscoveryBuilder = builder.advance_token()
	var out: DiscoveryBuilder = advanced.expect_token_in(
		ColonSymbol,
		ExpectedColonDiagnostic,
		DebugBlock,
	)
	out = out.parse_block_after_colon(start)
	out = out.finish_with_body(DebugBlockNode, start, 1)
	out


---
`with name [: T] = value: body` or `with name [: T] ?= value [on e =>
mapped]: body`.
---
private pure func parse_with(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	start: Span = builder.current_span()
	advanced: DiscoveryBuilder = builder.advance_token()
	with_binding: DiscoveryBuilder = advanced.parse_with_binding()
	var out: DiscoveryBuilder = with_binding.push_last_node()

	if out.at(CommaSymbol):
		out = out.report_at_current(WithMultipleBindingsDiagnostic)
		out = out.skip_to_header_colon()

	out = out.expect_token_in(ColonSymbol, ExpectedColonDiagnostic, WithBinding)
	out = out.parse_block_after_colon(start)
	out = out.finish_with_body(WithNode, start, 2)
	out


---
Skips the extra bindings of a reported multi-binding `with` header, up to
its `:` or the end of its line.
---
private pure func skip_to_header_colon(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	var index: Int = builder.token_cursor

	while (
		builder.token_kind_at(index) != EndOfFileToken
		and builder.token_kind_at(index) != NewlineToken
		and builder.token_kind_at(index) != ColonSymbol
	):
		index += 1

	builder.move_token_cursor(index)


private pure func parse_with_binding(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	name: NameId = builder.binder_name_at_cursor()
	name_span: Span = builder.current_span()
	depth_before: Int = builder.child_stack_depth()
	var out: DiscoveryBuilder = builder.consume_binder_name(WithBindingName)
	out = out.parse_optional_type_annotation()
	tried: Bool = out.at(QuestionEqualsSymbol)

	if tried:
		out = out.advance_token()
	else:
		out = out.expect_token_in(EqualSymbol, ExpectedEqualDiagnostic, WithBinding)

	out = out.parse_expression()
	var end: Span = out.node_span(out.last_node_id())
	out = out.push_last_node()

	if tried and out.at(OnKeyword):
		out = out.parse_with_error_map()
		end = out.node_span(out.last_node_id())
		out = out.push_last_node()

	kind: NodeKind = if tried:
		WithTryBindingNode
	else:
		WithBindingNode

	count: Int = out.child_stack_depth() - depth_before
	out = out.append_named_parent_node_from_stack(
		kind,
		name_span.span_covering(end),
		name,
		count,
	)
	out


---
`on name => value`.
---
private pure func parse_with_error_map(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = builder.advance_token()
	name: NameId = out.binder_name_at_cursor()
	name_span: Span = out.current_span()
	out = out.consume_binder_name(WithErrorName)
	out = out.expect_token_in(FatArrowSymbol, ExpectedFatArrowDiagnostic, WithErrorName)
	out = out.parse_expression()
	value_span: Span = out.node_span(out.last_node_id())
	out = out.push_last_node()
	out = out.append_named_parent_node_from_stack(
		WithErrorMapNode,
		name_span.span_covering(value_span),
		name,
		1,
	)
	out


-- Lambdas.
---
`func(params) [-> R]: body` or `pure func(...)`. The body is an expression
on the `:` line, a block on the next lines, or an indented block on a later
line reached without a newline token (inside brackets).
---
private pure func parse_lambda(builder: DiscoveryBuilder, anchor: Span) -> DiscoveryBuilder:
	start: Span = builder.current_span()
	depth_before: Int = builder.child_stack_depth()

	kind: NodeKind = if builder.at(PureKeyword):
		PureLambdaNode
	else:
		LambdaNode

	var out: DiscoveryBuilder = builder.skip_pure_keyword()
	out = out.expect_token_in(FuncKeyword, ExpectedKeywordDiagnostic, LambdaFunc)

	if out.at(LeftParenSymbol):
		out = out.advance_token()
		out = out.parse_lambda_parameters()
	else:
		out = out.report_at_current_in(ExpectedLeftParenDiagnostic, LambdaFunc)

	if out.at(ArrowSymbol):
		advanced: DiscoveryBuilder = out.advance_token()
		typed: DiscoveryBuilder = advanced.parse_type()
		out = typed.push_last_node()

	colon_line: Int = out.span_start_line(out.current_span())
	out = out.expect_token_in(ColonSymbol, ExpectedColonDiagnostic, LambdaBody)
	out = out.parse_lambda_body(colon_line, anchor)
	count: Int = out.child_stack_depth() + 1 - depth_before
	out = out.finish_with_body(kind, start, count)
	out


---
A lambda's body, parsed outside every loop: its `break` cannot leave the
enclosing loop, and its `?=` returns from the lambda. The caller's loop context
is saved and restored as in `parse_function_body_expression`.
---
private pure func parse_lambda_body(
	builder: DiscoveryBuilder,
	colon_line: Int,
	anchor: Span,
) -> DiscoveryBuilder:
	saved: LoopContext = builder.loop_context
	entered: DiscoveryBuilder = builder.with_loop_context(NotInLoop)
	parsed: DiscoveryBuilder = entered.parse_lambda_body_expression(colon_line, anchor)
	parsed.with_loop_context(saved)


private pure func parse_lambda_body_expression(
	builder: DiscoveryBuilder,
	colon_line: Int,
	anchor: Span,
) -> DiscoveryBuilder:
	if builder.at(NewlineToken):
		builder.parse_block_after_colon(anchor)
	else if builder.span_start_line(builder.current_span()) > colon_line and builder.indented_past(
		builder.token_cursor,
		builder.span_start_position(anchor),
	):
		builder.parse_indented_block(anchor)
	else:
		builder.parse_expression()


---
Lambda parameters after `(`, through `)`, each pushed; they may continue on
indented lines.
---
private pure func parse_lambda_parameters(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = builder.skip_newlines()
	var opened_indent: Bool = False

	if out.at(IndentToken):
		opened_indent = True
		out = out.advance_token()
		out = out.skip_newlines()

	if not out.at(RightParenSymbol):
		var parsing: Bool = True

		while parsing and not out.at(EndOfFileToken):
			out = out.parse_lambda_parameter()
			out = out.push_last_node()

			if out.at(CommaSymbol):
				out = out.advance_token()
				out = out.skip_newlines()

				if opened_indent and out.at(DedentToken):
					out = out.advance_token()
					out = out.skip_newlines()

				if out.at(RightParenSymbol):
					parsing = False
			else:
				parsing = False

	out = out.skip_newlines()

	if opened_indent and out.at(DedentToken):
		out = out.advance_token()
		out = out.skip_newlines()

	out = out.expect_token_in(RightParenSymbol, ExpectedRightParenDiagnostic, LambdaParameters)
	out


private pure func parse_lambda_parameter(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	name: NameId = builder.binder_name_at_cursor()
	name_span: Span = builder.current_span()
	depth_before: Int = builder.child_stack_depth()
	after_name: DiscoveryBuilder = builder.consume_binder_name(LambdaParameter)
	var out: DiscoveryBuilder = after_name.parse_optional_type_annotation()
	count: Int = out.child_stack_depth() - depth_before

	span: Span = if count > 0:
		name_span.span_covering(out.node_span(out.last_node_id()))
	else:
		name_span

	out = out.append_named_parent_node_from_stack(LambdaParameterNode, span, name, count)
	out


-- Expressions.
---
An expression at the lowest precedence, anchored at its own start.
---
pure func parse_expression(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	anchor: Span = builder.current_span()
	builder.parse_expression_at(LOWEST_PRECEDENCE, anchor)


---
An expression that may start a block-bearing construct (`if`, `match`,
`select`, `for`, a lambda) anchored at `anchor` rather than at itself.
---
private pure func parse_anchored_expression(
	builder: DiscoveryBuilder,
	anchor: Span,
) -> DiscoveryBuilder:
	match builder.current_kind():
		IfKeyword:
			builder.parse_if(anchor)
		MatchKeyword:
			builder.parse_match(anchor)
		SelectKeyword:
			builder.parse_select(anchor)
		ForKeyword:
			builder.parse_for(anchor)
		FuncKeyword | PureKeyword:
			builder.parse_lambda(anchor)
		_:
			builder.parse_expression_at(LOWEST_PRECEDENCE, anchor)


---
Binary operators of at least `min_precedence` over prefix expressions; at
the lowest precedence, also an assignment after the expression.
---
private pure func parse_expression_at(
	builder: DiscoveryBuilder,
	min_precedence: Int,
	anchor: Span,
) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = builder.parse_prefix(anchor)
	var parsing: Bool = True

	while parsing and not out.at(EndOfFileToken):
		kind: TokenKind = out.current_kind()

		if kind == AsKeyword:
			if LOWEST_PRECEDENCE < min_precedence:
				parsing = False
			else:
				out = out.report_removed_ascription()
		else:
			match kind.binary_operator():
				Some(operator):
					if operator.operator_precedence() < min_precedence:
						parsing = False
					else:
						out = out.parse_binary(operator, anchor)
				None:
					parsing = False

	if min_precedence <= LOWEST_PRECEDENCE:
		out = out.assignment_after_expression()

	out


---
Reports the removed `value as T` and skips `as T` without adding a node, so
the value stays the expression. The type is skipped by tokens, not parsed,
because a parsed type would leave nodes no parent refers to.

The old front end parses the type, so the two differ in diagnostic count only
where the type's end matters: `x as Int + 1` and `x as Int as Int` report one
diagnostic here, which skips to the end of the line, and more there.
---
private pure func report_removed_ascription(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	reported: DiscoveryBuilder = builder.append_plain_diagnostic(
		RemovedTypeAscriptionDiagnostic,
		builder.current_span(),
	)
	advanced: DiscoveryBuilder = reported.advance_token()
	var index: Int = advanced.token_cursor
	var open_delimiters: Int = 0

	while (
		open_delimiters > 0
		or not advanced
			.token_kind_at(index)
			.ends_ascribed_type()
	):
		kind: TokenKind = advanced.token_kind_at(index)

		if (
			kind == LeftBracketSymbol
			or kind == LeftParenSymbol
			or kind == LeftBraceSymbol
		):
			open_delimiters += 1
		else if (
			kind == RightBracketSymbol
			or kind == RightParenSymbol
			or kind == RightBraceSymbol
		):
			open_delimiters -= 1

		index += 1

	advanced.move_token_cursor(index)


---
Whether `kind` ends the type of a removed ascription when no delimiter the
type opened is still open: the end of a line or block, or a delimiter that
closes or separates the enclosing construct.
---
private pure func ends_ascribed_type(kind: TokenKind) -> Bool:
	match kind:
		EndOfFileToken | NewlineToken | DedentToken | ColonSymbol | CommaSymbol | RightBracketSymbol | RightParenSymbol | RightBraceSymbol:
			True
		_:
			False


---
`left op right`, the left operand parsed; the right operand binds tighter.
---
private pure func parse_binary(
	builder: DiscoveryBuilder,
	operator: BinaryOperator,
	anchor: Span,
) -> DiscoveryBuilder:
	precedence: Int = operator.operator_precedence()
	left_span: Span = builder.node_span(builder.last_node_id())
	pushed: DiscoveryBuilder = builder.push_last_node()
	advanced: DiscoveryBuilder = pushed.advance_token()
	var out: DiscoveryBuilder = advanced.skip_newlines()
	out = out.parse_expression_at(precedence + 1, anchor)
	right_span: Span = out.node_span(out.last_node_id())
	out = out.push_last_node()
	out = out.append_parent_node_from_stack(
		operator.operator_node_kind(),
		left_span.span_covering(right_span),
		2,
	)
	out


---
The binary operators. `binary_operator` reads one from its token, and
`operator_precedence` and `operator_node_kind` give its precedence and the
node it makes: each is one exhaustive match over this enum.
---
private enum BinaryOperator:
	OrOperator
	AndOperator
	EqualOperator
	NotEqualOperator
	LessOperator
	LessEqualOperator
	GreaterOperator
	GreaterEqualOperator
	RangeOperator
	AddOperator
	SubtractOperator
	MultiplyOperator
	DivideOperator
	ModuloOperator


private pure func binary_operator(kind: TokenKind) -> Option[BinaryOperator]:
	match kind:
		OrKeyword:
			Some(OrOperator)
		AndKeyword:
			Some(AndOperator)
		EqualEqualSymbol:
			Some(EqualOperator)
		NotEqualSymbol:
			Some(NotEqualOperator)
		LessSymbol:
			Some(LessOperator)
		LessEqualSymbol:
			Some(LessEqualOperator)
		GreaterSymbol:
			Some(GreaterOperator)
		GreaterEqualSymbol:
			Some(GreaterEqualOperator)
		DotDotSymbol:
			Some(RangeOperator)
		PlusSymbol:
			Some(AddOperator)
		MinusSymbol:
			Some(SubtractOperator)
		StarSymbol:
			Some(MultiplyOperator)
		SlashSymbol:
			Some(DivideOperator)
		PercentSymbol:
			Some(ModuloOperator)
		_:
			None


private pure func operator_precedence(operator: BinaryOperator) -> Int:
	match operator:
		OrOperator:
			OR_PRECEDENCE
		AndOperator:
			AND_PRECEDENCE
		EqualOperator | NotEqualOperator | LessOperator | LessEqualOperator | GreaterOperator | GreaterEqualOperator:
			COMPARISON_PRECEDENCE
		RangeOperator:
			RANGE_PRECEDENCE
		AddOperator | SubtractOperator:
			ADDITIVE_PRECEDENCE
		MultiplyOperator | DivideOperator | ModuloOperator:
			MULTIPLICATIVE_PRECEDENCE


private pure func operator_node_kind(operator: BinaryOperator) -> NodeKind:
	match operator:
		OrOperator:
			OrNode
		AndOperator:
			AndNode
		EqualOperator:
			EqualNode
		NotEqualOperator:
			NotEqualNode
		LessOperator:
			LessNode
		LessEqualOperator:
			LessEqualNode
		GreaterOperator:
			GreaterNode
		GreaterEqualOperator:
			GreaterEqualNode
		RangeOperator:
			RangeNode
		AddOperator:
			AddNode
		SubtractOperator:
			SubtractNode
		MultiplyOperator:
			MultiplyNode
		DivideOperator:
			DivideNode
		ModuloOperator:
			ModuloNode


---
`-x`, `not x`, `detach x`, the block-bearing constructs (anchored at
`anchor`), or a primary expression with its postfix operations.
---
private pure func parse_prefix(builder: DiscoveryBuilder, anchor: Span) -> DiscoveryBuilder:
	match builder.current_kind():
		MinusSymbol:
			builder.parse_unary(NegateNode, anchor)
		NotKeyword:
			builder.parse_unary(NotNode, anchor)
		DetachKeyword:
			builder.parse_unary(DetachNode, anchor)
		FuncKeyword | PureKeyword:
			builder.parse_lambda(anchor)
		IfKeyword:
			builder.parse_if(anchor)
		MatchKeyword:
			builder.parse_match(anchor)
		SelectKeyword:
			builder.parse_select(anchor)
		ForKeyword:
			builder.parse_for(anchor)
		_:
			with_primary: DiscoveryBuilder = builder.parse_primary()
			with_primary.parse_postfix(anchor)


private pure func parse_unary(
	builder: DiscoveryBuilder,
	kind: NodeKind,
	anchor: Span,
) -> DiscoveryBuilder:
	start: Span = builder.current_span()
	advanced: DiscoveryBuilder = builder.advance_token()
	var out: DiscoveryBuilder = advanced.parse_prefix(anchor)
	out = out.finish_with_body(kind, start, 1)
	out


---
Field accesses, calls and subscripts after a primary expression. A `.` may
start a continuation line (`value\n\t.method()`); each indent such a line
opens is closed by the dedent that ends the chain.
---
private pure func parse_postfix(builder: DiscoveryBuilder, anchor: Span) -> DiscoveryBuilder:
	-- Builder threading rule 1: a no-op move is the unconditional first update.
	cursor: Int = builder.token_cursor
	var out: DiscoveryBuilder = builder.move_token_cursor(cursor)
	var parsing: Bool = True
	var continuation_indents: Int = 0

	while parsing and not out.at(EndOfFileToken):
		if continuation_indents > 0 and out.at(DedentToken):
			out = out.advance_token()
			continuation_indents -= 1
			parsing = continuation_indents > 0
		else if continuation_indents > 0 and out.at(NewlineToken):
			after_newline: Int = out.token_cursor + 1

			if out.token_kind_at(after_newline) == DedentToken:
				out = out.move_token_cursor(after_newline + 1)
				continuation_indents -= 1
				parsing = continuation_indents > 0
			else:
				continuation: Int = out.continuation_start()

				if continuation == out.token_cursor:
					-- A new line that continues nothing ends the chain.
					parsing = False
				else:
					if out.token_kind_at(continuation - 1) == IndentToken:
						continuation_indents += 1

					out = out.move_token_cursor(continuation)
		else:
			continuation: Int = out.continuation_start()

			if continuation != out.token_cursor:
				if out.token_kind_at(continuation - 1) == IndentToken:
					continuation_indents += 1

				out = out.move_token_cursor(continuation)

			match out.current_kind():
				DotSymbol:
					out = out.parse_field_access()
				LeftParenSymbol:
					out = out.parse_call(anchor)
				LeftBracketSymbol:
					out = out.parse_subscript(anchor)
				_:
					parsing = False

	out


---
Where a postfix chain continues after a newline: the `.` on the next line
(after an indent, which the chain then owns), or the cursor itself when no
`.` continues it.
---
private pure func continuation_start(builder: DiscoveryBuilder) -> Int:
	cursor: Int = builder.token_cursor

	if builder.token_kind_at(cursor) != NewlineToken:
		cursor
	else if builder.token_kind_at(cursor + 1) == IndentToken:
		if builder.token_kind_at(cursor + 2) == DotSymbol:
			cursor + 2
		else:
			cursor
	else if builder.token_kind_at(cursor + 1) == DotSymbol:
		cursor + 1
	else:
		cursor


---
`.field` after a receiver.
---
private pure func parse_field_access(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	receiver_span: Span = builder.node_span(builder.last_node_id())
	pushed: DiscoveryBuilder = builder.push_last_node()
	var out: DiscoveryBuilder = pushed.advance_token()
	field: NameId = out.referenced_name_at_cursor()
	field_span: Span = out.current_span()
	out = out.consume_referenced_name(FieldName)
	out = out.append_named_parent_node_from_stack(
		FieldAccessNode,
		receiver_span.span_covering(field_span),
		field,
		1,
	)
	out


---
`(arguments)` after a callee.
---
private pure func parse_call(builder: DiscoveryBuilder, anchor: Span) -> DiscoveryBuilder:
	callee_span: Span = builder.node_span(builder.last_node_id())
	depth_before: Int = builder.child_stack_depth()
	pushed: DiscoveryBuilder = builder.push_last_node()
	var out: DiscoveryBuilder = pushed.advance_token()
	out = out.parse_expression_list(RightParenSymbol, True, anchor)
	end: Span = out.closing_span_or(RightParenSymbol, callee_span)
	out = out.expect_token_in(RightParenSymbol, ExpectedRightParenDiagnostic, CallArguments)
	count: Int = out.child_stack_depth() - depth_before
	out = out.append_parent_node_from_stack(
		CallNode,
		callee_span.span_covering(end),
		count,
	)
	out


---
`[indices]` after a target.
---
private pure func parse_subscript(builder: DiscoveryBuilder, anchor: Span) -> DiscoveryBuilder:
	target_span: Span = builder.node_span(builder.last_node_id())
	depth_before: Int = builder.child_stack_depth()
	pushed: DiscoveryBuilder = builder.push_last_node()
	var out: DiscoveryBuilder = pushed.advance_token()
	out = out.parse_expression_list(RightBracketSymbol, False, anchor)
	end: Span = out.closing_span_or(RightBracketSymbol, target_span)
	out = out.expect_token_in(RightBracketSymbol, ExpectedRightBracketDiagnostic, Subscript)
	count: Int = out.child_stack_depth() - depth_before
	out = out.append_parent_node_from_stack(
		SubscriptNode,
		target_span.span_covering(end),
		count,
	)
	out


---
The span of the closing `kind` token at the cursor, or `fallback` when the
cursor is not at one (the caller then reports it).
---
private pure func closing_span_or(
	builder: DiscoveryBuilder,
	kind: TokenKind,
	fallback: Span,
) -> Span:
	if builder.at(kind):
		builder.current_span()
	else:
		fallback


---
Expressions separated by commas up to `end` (not consumed), each pushed;
with `allow_empty` there may be none. After a comma, newlines and dedents
that lead only to `end` are consumed.
---
private pure func parse_expression_list(
	builder: DiscoveryBuilder,
	end: TokenKind,
	allow_empty: Bool,
	anchor: Span,
) -> DiscoveryBuilder:
	if allow_empty and builder.at(end):
		builder
	else if builder.at(EndOfFileToken):
		builder
	else:
		builder.parse_expression_items(end, anchor)


private pure func parse_expression_items(
	builder: DiscoveryBuilder,
	end: TokenKind,
	anchor: Span,
) -> DiscoveryBuilder:
	with_item: DiscoveryBuilder = builder.parse_anchored_expression(anchor)
	var out: DiscoveryBuilder = with_item.push_last_node()
	var parsing: Bool = True

	while parsing:
		if out.at(CommaSymbol):
			out = out.advance_token()
			layout_follows: Bool = out.at(NewlineToken) or out.at(DedentToken)
			out = out.skip_newlines()

			if layout_follows:
				out = out.consume_layout_before(end)

			if out.at(end) or out.at(EndOfFileToken):
				parsing = False
			else:
				out = out.parse_anchored_expression(anchor)
				out = out.push_last_node()
		else:
			parsing = False

	out


---
Consumes newlines and dedents when they lead only to `end`.
---
private pure func consume_layout_before(
	builder: DiscoveryBuilder,
	end: TokenKind,
) -> DiscoveryBuilder:
	var index: Int = builder.token_cursor

	while (
		builder.token_kind_at(index) == NewlineToken
		or builder.token_kind_at(index) == DedentToken
	):
		index += 1

	if builder.token_kind_at(index) == end:
		builder.move_token_cursor(index)
	else:
		builder


-- Primary expressions.
---
A name, literal, bracketed form, keyword expression, or a reported missing
expression.
---
private pure func parse_primary(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	token: Token = builder.current_token()

	match token.kind:
		IdentifierToken:
			builder.parse_identifier_expression()
		IntLiteralToken:
			builder.literal_leaf(IntegerLiteralNode)
		FloatLiteralToken:
			builder.literal_leaf(FloatLiteralNode)
		NormalStringToken:
			builder.literal_leaf(StringLiteralNode)
		RawStringToken:
			builder.literal_leaf(RawStringLiteralNode)
		PipeStringToken:
			builder.literal_leaf(PipeStringLiteralNode)
		RawPipeStringToken:
			builder.literal_leaf(RawPipeStringLiteralNode)
		InterpolatedStringToken:
			builder.parse_interpolated_string(InterpolatedStringNode)
		InterpolatedPipeStringToken:
			builder.parse_interpolated_string(InterpolatedPipeStringNode)
		CharLiteralToken:
			builder.char_leaf()
		TrueKeyword:
			builder.keyword_leaf(TrueLiteralNode)
		FalseKeyword:
			builder.keyword_leaf(FalseLiteralNode)
		BreakKeyword:
			builder.loop_keyword_leaf(BreakNode, BreakOutsideLoopDiagnostic)
		ContinueKeyword:
			builder.loop_keyword_leaf(ContinueNode, ContinueOutsideLoopDiagnostic)
		VoidKeyword | UnderscoreSymbol:
			builder.keyword_leaf(VoidNode)
		AfterKeyword | SealedKeyword:
			builder.keyword_name_leaf()
		BuiltinKeyword:
			builder.parse_builtin()
		IntoOpaqueKeyword:
			builder.parse_opaque_conversion(IntoOpaqueNode)
		FromOpaqueKeyword:
			builder.parse_opaque_conversion(FromOpaqueNode)
		FromKeyword:
			builder.parse_removed_conversion_or_name(
				FromOpaqueNode,
				RemovedFromConversionDiagnostic,
			)
		FuncKeyword | PureKeyword:
			builder.parse_lambda(token.span)
		IfKeyword:
			builder.parse_if(token.span)
		MatchKeyword:
			builder.parse_match(token.span)
		SelectKeyword:
			builder.parse_select(token.span)
		DebugKeyword:
			if builder.peek_kind(1) == DotSymbol:
				builder.keyword_name_leaf()
			else:
				builder.parse_debug_block()
		WithKeyword:
			builder.parse_with()
		ConcurrentKeyword:
			builder.parse_concurrent_block()
		LeftParenSymbol:
			builder.parse_parenthesized()
		LeftBracketSymbol:
			builder.parse_list_literal()
		LeftBraceSymbol:
			builder.parse_braced()
		_:
			builder.missing_expression()


---
Reports a missing expression and appends a `MissingExpressionNode`; the
offending token is skipped unless it is a soft boundary.
---
private pure func missing_expression(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	span: Span = builder.current_span()
	recovered: DiscoveryBuilder = builder.report_and_recover(ExpectedExpressionDiagnostic)
	recovered.append_leaf_node(MissingExpressionNode, span)


private pure func literal_leaf(builder: DiscoveryBuilder, kind: NodeKind) -> DiscoveryBuilder:
	token: Token = builder.current_token()
	advanced: DiscoveryBuilder = builder.advance_token()
	advanced.append_literal_leaf_node(kind, token.span, literal_id_at_row(token.payload))


private pure func char_leaf(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	token: Token = builder.current_token()
	advanced: DiscoveryBuilder = builder.advance_token()
	advanced.append_codepoint_leaf_node(CharLiteralNode, token.span, token.payload)


private pure func keyword_leaf(builder: DiscoveryBuilder, kind: NodeKind) -> DiscoveryBuilder:
	span: Span = builder.current_span()
	advanced: DiscoveryBuilder = builder.advance_token()
	advanced.append_leaf_node(kind, span)


---
A `break` or `continue` leaf, reported with `outside_loop` when it is not
inside a loop body.
---
private pure func loop_keyword_leaf(
	builder: DiscoveryBuilder,
	kind: NodeKind,
	outside_loop: DiscoveryDiagnosticCode,
) -> DiscoveryBuilder:
	keyword_span: Span = builder.current_span()

	match builder.loop_context:
		InLoopBody:
			builder.keyword_leaf(kind)
		NotInLoop:
			reported: DiscoveryBuilder = builder.append_plain_diagnostic(outside_loop, keyword_span)
			reported.keyword_leaf(kind)


---
A keyword used as a name (`after`, `sealed`, `from`, `debug`): an identifier
spelled as the keyword.
---
private pure func keyword_name_leaf(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	token: Token = builder.current_token()

	match token.kind.keyword_name_index():
		Some(index):
			advanced: DiscoveryBuilder = builder.advance_token()
			advanced.append_name_leaf_node(IdentifierNode, token.span, name_id_at_row(index))
		None:
			builder.missing_expression()


---
A name, or the removed `into Type(...)` conversion.
---
private pure func parse_identifier_expression(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	token: Token = builder.current_token()

	if token.is_removed_into_spelling():
		builder.parse_removed_conversion_or_name(IntoOpaqueNode, RemovedIntoConversionDiagnostic)
	else:
		advanced: DiscoveryBuilder = builder.advance_token()
		advanced.append_name_leaf_node(IdentifierNode, token.span, name_id_at_row(token.payload))


private pure func is_removed_into_spelling(token: Token) -> Bool:
	token.payload == REMOVED_INTO_NAME_INDEX


---
The removed spelling of a conversion (`into Type(...)`, `from Type(...)`)
when a type that parses cleanly and then `(` follow the word, reported and
parsed as its replacement; otherwise the word is a name. Decided by a
speculative parse of the type, rolled back either way.
---
private pure func parse_removed_conversion_or_name(
	builder: DiscoveryBuilder,
	kind: NodeKind,
	code: DiscoveryDiagnosticCode,
) -> DiscoveryBuilder:
	word: Token = builder.current_token()
	name_payload: Int = word.removed_conversion_word_name()
	checkpoint: ParseCheckpoint = builder.parse_checkpoint()
	advanced: DiscoveryBuilder = builder.advance_token()
	speculative: DiscoveryBuilder = advanced.parse_type()
	removed: Bool = (
		speculative.diagnostics.length() == checkpoint.diagnostics
		and speculative.at(LeftParenSymbol)
	)
	restored: DiscoveryBuilder = speculative.rollback_to(checkpoint)

	if removed:
		restored.report_removed_conversion(kind, code)
	else:
		name_advanced: DiscoveryBuilder = restored.advance_token()
		name_advanced.append_name_leaf_node(IdentifierNode, word.span, name_id_at_row(name_payload))


---
The name a conversion word stands for when it is not a conversion: the
identifier's name, or the keyword's spelling for `from`.
---
private pure func removed_conversion_word_name(word: Token) -> Int:
	if word.kind == IdentifierToken:
		word.payload
	else:
		match word.kind.keyword_name_index():
			Some(index):
				index
			None:
				word.payload


---
Parses the removed conversion as its replacement and reports the removal.
---
private pure func report_removed_conversion(
	builder: DiscoveryBuilder,
	kind: NodeKind,
	code: DiscoveryDiagnosticCode,
) -> DiscoveryBuilder:
	span: Span = builder.current_span()
	converted: DiscoveryBuilder = builder.parse_opaque_conversion(kind)
	converted.append_plain_diagnostic(code, span)


---
`into_opaque T(value)` or `from_opaque T(value)`.
---
private pure func parse_opaque_conversion(
	builder: DiscoveryBuilder,
	kind: NodeKind,
) -> DiscoveryBuilder:
	start: Span = builder.current_span()
	advanced: DiscoveryBuilder = builder.advance_token()
	typed: DiscoveryBuilder = advanced.parse_type()
	var out: DiscoveryBuilder = typed.push_last_node()
	out = out.expect_token_in(LeftParenSymbol, ExpectedLeftParenDiagnostic, OpaqueConversionType)
	out = out.parse_expression()
	var end: Span = out.node_span(out.last_node_id())
	out = out.push_last_node()

	if out.at(RightParenSymbol):
		end = out.current_span()

	out = out.expect_token_in(RightParenSymbol, ExpectedRightParenDiagnostic, OpaqueConversionValue)
	out = out.append_parent_node_from_stack(
		kind,
		start.span_covering(end),
		2,
	)
	out


---
`builtin` or `builtin("name")`.
---
private pure func parse_builtin(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	if builder.peek_kind(1) == LeftParenSymbol:
		builder.parse_named_builtin()
	else:
		builder.keyword_leaf(BuiltinNode)


private pure func parse_named_builtin(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	start: Span = builder.current_span()
	advanced: DiscoveryBuilder = builder.advance_token()
	var out: DiscoveryBuilder = advanced.advance_token()
	name: Token = out.current_token()
	named: Bool = name.kind.is_literal_string_token()

	if named:
		out = out.advance_token()
	else:
		out = out.report_and_recover(ExpectedBuiltinNameDiagnostic)

	end: Span = out.closing_span_or(RightParenSymbol, name.span)
	out = out.expect_token_in(RightParenSymbol, ExpectedRightParenDiagnostic, BuiltinName)

	if named:
		out = out.append_literal_leaf_node(
			NamedBuiltinNode,
			start.span_covering(end),
			literal_id_at_row(name.payload),
		)
	else:
		out = out.append_leaf_node(
			BuiltinNode,
			start.span_covering(end),
		)

	out


---
A string token whose payload is its text: any string but an interpolated
one, whose text is split around its holes.
---
private pure func is_literal_string_token(kind: TokenKind) -> Bool:
	match kind:
		NormalStringToken | RawStringToken | PipeStringToken | RawPipeStringToken:
			True
		_:
			False


---
`()` (void), `(expr)` (grouping, which widens the expression's span to the
parentheses), or a tuple `(a, b, ...)`.
---
private pure func parse_parenthesized(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	start: Span = builder.current_span()
	out: DiscoveryBuilder = builder.advance_token()

	if out.at(RightParenSymbol):
		close: Span = out.current_span()
		advanced: DiscoveryBuilder = out.advance_token()
		advanced.append_leaf_node(
			VoidNode,
			start.span_covering(close),
		)
	else:
		with_item: DiscoveryBuilder = out.parse_expression_at(LOWEST_PRECEDENCE, start)
		with_item.parse_grouping_or_tuple(start)


private pure func parse_grouping_or_tuple(
	builder: DiscoveryBuilder,
	start: Span,
) -> DiscoveryBuilder:
	if builder.at(CommaSymbol):
		builder.parse_tuple_rest(start)
	else if builder.at(RightParenSymbol):
		close: Span = builder.current_span()
		advanced: DiscoveryBuilder = builder.advance_token()
		advanced.replace_last_node_span(start.span_covering(close))
	else:
		builder.report_at_current_in(ExpectedRightParenDiagnostic, GroupedExpression)


---
The rest of a tuple after its first item, which the caller parsed.
---
private pure func parse_tuple_rest(builder: DiscoveryBuilder, start: Span) -> DiscoveryBuilder:
	first_span: Span = builder.node_span(builder.last_node_id())
	depth_before: Int = builder.child_stack_depth()
	var out: DiscoveryBuilder = builder.push_last_node()
	var parsing: Bool = True

	while parsing and not out.at(EndOfFileToken):
		if out.at(CommaSymbol):
			out = out.advance_token()

			if out.at(RightParenSymbol):
				parsing = False
			else:
				out = out.parse_expression_at(LOWEST_PRECEDENCE, start)
				out = out.push_last_node()
		else:
			parsing = False

	end: Span = out.closing_span_or(RightParenSymbol, first_span)
	out = out.expect_token_in(RightParenSymbol, ExpectedRightParenDiagnostic, TupleExpression)
	count: Int = out.child_stack_depth() - depth_before
	span: Span = start.span_covering(end)

	if count > MAX_TUPLE_ITEMS:
		out = out.append_plain_diagnostic(TupleArityDiagnostic, span)

	out = out.append_parent_node_from_stack(TupleNode, span, count)
	out


---
`[items]`.
---
private pure func parse_list_literal(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	start: Span = builder.current_span()
	depth_before: Int = builder.child_stack_depth()
	advanced: DiscoveryBuilder = builder.advance_token()
	var out: DiscoveryBuilder = advanced.parse_expression_list(RightBracketSymbol, True, start)
	end: Span = out.closing_span_or(RightBracketSymbol, start)
	out = out.expect_token_in(RightBracketSymbol, ExpectedRightBracketDiagnostic, ListLiteral)
	count: Int = out.child_stack_depth() - depth_before
	out = out.append_parent_node_from_stack(
		ListLiteralNode,
		start.span_covering(end),
		count,
	)
	out


---
`{...}`: a record literal (`{}` or `{name = ...}`), a dict literal
(`{key => value}`), a record update (`{record | name = ...}`), or a vector
literal (`{a, b}`).
---
private pure func parse_braced(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	start: Span = builder.current_span()
	out: DiscoveryBuilder = builder.advance_token()

	if out.at(RightBraceSymbol) or out.starts_record_field():
		out.parse_record_literal(start)
	else:
		parsed: DiscoveryBuilder = out.parse_expression()
		parsed.parse_braced_after_first(start)


private pure func starts_record_field(builder: DiscoveryBuilder) -> Bool:
	(
		builder
			.current_name()
			.is_some()
		and builder.peek_kind(1) == EqualSymbol
	)


private pure func parse_braced_after_first(
	builder: DiscoveryBuilder,
	start: Span,
) -> DiscoveryBuilder:
	match builder.current_kind():
		FatArrowSymbol:
			builder.parse_dict_rest(start)
		PipeSymbol:
			builder.parse_record_update_rest(start)
		_:
			builder.parse_vector_rest(start)


private pure func parse_record_literal(builder: DiscoveryBuilder, start: Span) -> DiscoveryBuilder:
	depth_before: Int = builder.child_stack_depth()
	var out: DiscoveryBuilder = builder.parse_record_fields(True)
	end: Span = out.closing_span_or(RightBraceSymbol, start)
	out = out.expect_token_in(RightBraceSymbol, ExpectedRightBraceDiagnostic, RecordLiteral)
	count: Int = out.child_stack_depth() - depth_before
	out = out.append_parent_node_from_stack(
		RecordLiteralNode,
		start.span_covering(end),
		count,
	)
	out


---
Record fields up to `}` (not consumed), each pushed; with `allow_empty`
there may be none.
---
private pure func parse_record_fields(
	builder: DiscoveryBuilder,
	allow_empty: Bool,
) -> DiscoveryBuilder:
	if allow_empty and builder.at(RightBraceSymbol):
		builder
	else if builder.at(EndOfFileToken):
		builder
	else:
		builder.parse_record_field_run()


private pure func parse_record_field_run(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	with_field: DiscoveryBuilder = builder.parse_record_field()
	var out: DiscoveryBuilder = with_field.push_last_node()
	var parsing: Bool = True

	while parsing:
		if out.at(CommaSymbol):
			out = out.advance_token()

			if out.at(RightBraceSymbol) or out.at(EndOfFileToken):
				parsing = False
			else:
				out = out.parse_record_field()
				out = out.push_last_node()
		else:
			parsing = False

	out


---
`name = value`.
---
private pure func parse_record_field(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	name: NameId = builder.referenced_name_at_cursor()
	name_span: Span = builder.current_span()
	var out: DiscoveryBuilder = builder.consume_referenced_name(RecordFieldName)
	out = out.expect_token_in(EqualSymbol, ExpectedEqualDiagnostic, RecordFieldName)
	out = out.parse_expression()
	value_span: Span = out.node_span(out.last_node_id())
	out = out.push_last_node()
	out = out.append_named_parent_node_from_stack(
		RecordFieldNode,
		name_span.span_covering(value_span),
		name,
		1,
	)
	out


---
`{record | fields}` after the record, which the caller parsed.
---
private pure func parse_record_update_rest(
	builder: DiscoveryBuilder,
	start: Span,
) -> DiscoveryBuilder:
	record_span: Span = builder.node_span(builder.last_node_id())
	depth_before: Int = builder.child_stack_depth()
	var out: DiscoveryBuilder = builder.push_last_node()
	-- The caller saw the `|`, so it is consumed, not expected.
	out = out.advance_token()
	out = out.parse_record_fields(False)
	end: Span = out.closing_span_or(RightBraceSymbol, record_span)
	out = out.expect_token_in(RightBraceSymbol, ExpectedRightBraceDiagnostic, RecordUpdate)
	count: Int = out.child_stack_depth() - depth_before
	out = out.append_parent_node_from_stack(
		RecordUpdateNode,
		start.span_covering(end),
		count,
	)
	out


---
`{key => value, ...}` after the first key, which the caller parsed.
---
private pure func parse_dict_rest(builder: DiscoveryBuilder, start: Span) -> DiscoveryBuilder:
	first_span: Span = builder.node_span(builder.last_node_id())
	depth_before: Int = builder.child_stack_depth()
	with_entry: DiscoveryBuilder = builder.parse_dict_entry_after_key()
	var out: DiscoveryBuilder = with_entry.push_last_node()
	var parsing: Bool = True

	while parsing and not out.at(EndOfFileToken):
		if out.at(CommaSymbol):
			out = out.advance_token()

			if out.at(RightBraceSymbol):
				parsing = False
			else:
				out = out.parse_expression()
				out = out.parse_dict_entry_after_key()
				out = out.push_last_node()
		else:
			parsing = False

	end: Span = out.closing_span_or(RightBraceSymbol, first_span)
	out = out.expect_token_in(RightBraceSymbol, ExpectedRightBraceDiagnostic, DictLiteral)
	count: Int = out.child_stack_depth() - depth_before
	out = out.append_parent_node_from_stack(
		DictLiteralNode,
		start.span_covering(end),
		count,
	)
	out


---
`=> value` after a dict key, which the caller parsed, and the entry node.
---
private pure func parse_dict_entry_after_key(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	key_span: Span = builder.node_span(builder.last_node_id())
	var out: DiscoveryBuilder = builder.push_last_node()
	out = out.expect_token_in(FatArrowSymbol, ExpectedFatArrowDiagnostic, DictEntry)
	out = out.parse_expression()
	out = out.finish_with_body(DictEntryNode, key_span, 2)
	out


---
`{a, b, ...}` after the first item, which the caller parsed.
---
private pure func parse_vector_rest(builder: DiscoveryBuilder, start: Span) -> DiscoveryBuilder:
	first_span: Span = builder.node_span(builder.last_node_id())
	depth_before: Int = builder.child_stack_depth()
	var out: DiscoveryBuilder = builder.push_last_node()
	var parsing: Bool = True

	while parsing and not out.at(EndOfFileToken):
		if out.at(CommaSymbol):
			out = out.advance_token()

			if out.at(RightBraceSymbol):
				parsing = False
			else:
				out = out.parse_expression()
				out = out.push_last_node()
		else:
			parsing = False

	end: Span = out.closing_span_or(RightBraceSymbol, first_span)
	out = out.expect_token_in(RightBraceSymbol, ExpectedRightBraceDiagnostic, VectorLiteral)
	count: Int = out.child_stack_depth() - depth_before
	out = out.append_parent_node_from_stack(
		VectorLiteralNode,
		start.span_covering(end),
		count,
	)
	out


-- Interpolated strings.
---
An interpolated string: its text pieces (`InterpolationTextNode`) and holes
in source order, each pushed. The lexer found the pieces and hole ranges;
each hole's source text is lexed into tokens appended after the module's
own and parsed there as one expression, and the cursor then returns to after
the string.
---
private pure func parse_interpolated_string(
	builder: DiscoveryBuilder,
	kind: NodeKind,
) -> DiscoveryBuilder:
	token: Token = builder.current_token()
	resume: Int = builder.token_cursor + 1
	depth_before: Int = builder.child_stack_depth()
	parts: RowRange = builder.interpolation_parts_of(token.payload)
	var out: DiscoveryBuilder = builder.parse_interpolation_parts(
		token.span.span_source_index(),
		parts,
	)
	count: Int = out.child_stack_depth() - depth_before
	out = out.move_token_cursor(resume)
	out = out.append_parent_node_from_stack(kind, token.span, count)
	out


private pure func parse_interpolation_parts(
	builder: DiscoveryBuilder,
	source_index: Int,
	parts: RowRange,
) -> DiscoveryBuilder:
	if parts.count == 0:
		builder
	else:
		builder.parse_interpolation_part_run(source_index, parts)


private pure func parse_interpolation_part_run(
	builder: DiscoveryBuilder,
	source_index: Int,
	parts: RowRange,
) -> DiscoveryBuilder:
	first: InterpolationPartRow = builder.interpolation_part_at(parts.first)
	var out: DiscoveryBuilder = builder.parse_interpolation_part(source_index, first)
	var index: Int = parts.first + 1

	while index < parts.first + parts.count:
		part: InterpolationPartRow = out.interpolation_part_at(index)
		out = out.parse_interpolation_part(source_index, part)
		index += 1

	out


---
One piece, pushed: a text node, or the hole's expression.
---
private pure func parse_interpolation_part(
	builder: DiscoveryBuilder,
	source_index: Int,
	part: InterpolationPartRow,
) -> DiscoveryBuilder:
	span: Span = pack_span(source_index, part.start, part.end)

	match part.part:
		TextPart:
			text: LiteralId = builder.interpolation_text_at(part.text.first)
			with_text: DiscoveryBuilder = builder.append_literal_leaf_node(
				InterpolationTextNode,
				span,
				text,
			)
			with_text.push_last_node()
		HolePart:
			builder.parse_interpolation_hole(source_index, part)


---
Lexes one hole, parses it as a single expression, and pushes it.
---
private pure func parse_interpolation_hole(
	builder: DiscoveryBuilder,
	source_index: Int,
	hole: InterpolationPartRow,
) -> DiscoveryBuilder:
	hole_start: Int = builder.token_count()
	anchor: Span = pack_span(source_index, hole.start, hole.start)
	var out: DiscoveryBuilder = builder.lex_interpolation_hole(
		source_id_at_row(source_index),
		hole.start,
		hole.end,
	)
	out = out.move_token_cursor(hole_start)
	out = out.parse_assignment_value(anchor)
	out = out.push_last_node()
	out = out.skip_newlines()

	if not out.at(EndOfFileToken):
		out = out.report_at_current(InterpolationHoleNotExpressionDiagnostic)

	out
