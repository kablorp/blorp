		FatArrowConstruct(FatArrowInDictEntry, FatArrowInWithErrorName),
		IndentConstruct(IndentInAssignmentValue),
		KeywordConstruct(
			KeywordInForLoopVariable, KeywordInLambdaFunc, KeywordInSelectReceiveBinding,
		),
		LeftParenConstruct(
			LeftParenInConcurrentlyHeader, LeftParenInFunctionName, LeftParenInLambdaFunc,
			LeftParenInOpaqueConversionType,
		),
		NameConstruct(
			NameInConcurrentNamedParameter, NameInFunctionName, NameInRecordFieldName,
			NameInStatementName, NameInVariableName, NameInWithBindingName, NameInWithErrorName,
