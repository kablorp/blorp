-- Function declarations and bodies: expressions, statements and blocks,
-- parsed into the node table.
--
-- Nodes are appended post-order: every routine appends the root of what it
-- parsed last, so a caller reads the root with `last_node_id`. A parent with
-- several children has each child's root pushed on the builder's child stack
-- as the child is finished and claims them with
-- `append_parent_node_since` (or `append_parent_node_from_stack` with a literal
-- count); no list of child ids is built per node.
--
-- Function declarations live here, not in the declaration parser, because a
-- body may declare a local function: the two recurse into each other, and a
-- module cannot import a module that imports it. For the same reason
-- expressions, statements and blocks stay together: an `if` is an expression
-- whose branches are blocks of statements, which hold expressions. This module
-- is that recursive core; what does not recurse sits below it in
-- `function_parser` (signatures and parameters), `binder_parser`,
-- `block_layout` (where blocks and continuations start and end),
-- `statement_forms` (which statement starts here, finishing a binding),
-- `concurrent_parameters`, `expression_atoms` (leaves) and `binary_operators`.
--
-- The grammar, its layout rules and its recovery follow the existing parser
-- (`language_parser.brp`) so that the same sources are accepted. Layout
-- decisions that depend on columns compare token positions with an anchor,
-- the span a construct's header starts at: a block belongs to a header when
-- its tokens sit on a later line and in a later column.
import:
	../lex/lexer: lex_interpolation_hole
	../tables/builder:
		DiscoveryBuilder,
		LoopContext(InLoopBody, NotInLoop),
		advance_token,
		append_definition_type,
		append_plain_diagnostic,
		interpolation_part_at,
		interpolation_parts_of,
		interpolation_text_at,
		move_token_cursor,
		next_definition_id,
		pending_annotation_count,
		token_count,
		with_loop_context,
	../tables/diagnostic_code:
		PlainSyntaxCode(
			BreakOutsideLoopDiagnostic, ConcurrentForMissingLimitDiagnostic,
			ConcurrentForTupleBinderDiagnostic, ContinueOutsideLoopDiagnostic,
			ExpectedAssignmentOperatorDiagnostic, ExpectedConcurrentParameterDiagnostic,
			FieldAssignmentDiagnostic, InterpolationHoleNotExpressionDiagnostic,
			TupleArityDiagnostic, WithMultipleBindingsDiagnostic,
		),
	../tables/expected_token:
		ColonConstruct(
			ColonInConcurrentBlock, ColonInConcurrentNamedParameter, ColonInConcurrentlyParameters,
			ColonInDebugBlock, ColonInElseBranch, ColonInForIterable, ColonInFunctionBody,
			ColonInIfCondition, ColonInLambdaBody, ColonInMatchExpression, ColonInMatchPattern,
			ColonInSealedSelectChannel, ColonInSelectHeader, ColonInSelectReceiveChannel,
			ColonInSelectTimeout, ColonInWhileCondition, ColonInWithBinding,
		),
		CommaConstruct(CommaInConcurrentParameters, CommaInTupleDestructuringNames),
		EqualConstruct(
			EqualInRecordFieldName, EqualInTupleDestructuring, EqualInVariableDeclaration,
			EqualInWithBinding,
		),
		ExpectedTokenDiagnostic(
			ExpectedColon, ExpectedComma, ExpectedLeftParen, ExpectedRightParen,
