---
The most elements a tuple expression may have.
---
private MAX_TUPLE_ITEMS: Int = 4

---
The widths of the `${` that opens an interpolation hole and the `}` that
closes it: a hole's part row covers only the code between them, and its
`InterpolationHoleNode` covers both.
---
private INTERPOLATION_HOLE_OPENER_WIDTH: Int = 2

private INTERPOLATION_HOLE_CLOSER_WIDTH: Int = 1


-- Function declarations.
---
Where a function that is no impl method is declared: at the top level or in a
body.
---
enum FunctionPlacement:
	TopLevelFunction
	LocalFunction


---
Whether a function header that ends with no body is an error where it is
written. A top-level function may be a forward declaration, whose body is
another function of the same name; that is checked once the whole module is
read (`forward_declarations`). Anywhere else the header must have its body.
---
private enum BodylessHeader:
	ForwardDeclarationAllowed
	BodyRequired


---
`func name[T](params) -> R where ... : body` for a function declared at
`placement`; the header carries what came before `func`.
---
pure func parse_function(
	builder: DiscoveryBuilder,
	header: DeclarationHeader,
	placement: FunctionPlacement,
) -> DiscoveryBuilder:
	keyword_span: Span = builder.current_span()
	var out: DiscoveryBuilder = builder.advance_token()
	name: NameId = out.declared_name_at_cursor()
	name_span: Span = out.current_span()
	out = out.consume_declared_name(NameInFunctionName)

	match placement:
		TopLevelFunction:
			opening: FunctionOpening = out.function_opening(header, name, name_span)
			out.parse_opened_function(
				header,
				opening,
				keyword_span,
				name_span,
				ForwardDeclarationAllowed,
			)
		LocalFunction:
			opening: FunctionOpening = out.local_function_opening(header, name, name_span)
			out.parse_opened_function(header, opening, keyword_span, name_span, BodyRequired)


---
`func name ...` of a method of the impl `owner`, which it joins when opened.
---
pure func parse_impl_method_function(
	builder: DiscoveryBuilder,
	header: DeclarationHeader,
	owner: ImplOpening,
) -> DiscoveryBuilder:
	keyword_span: Span = builder.current_span()
	var out: DiscoveryBuilder = builder.advance_token()
	name: NameId = out.declared_name_at_cursor()
	name_span: Span = out.current_span()
	out = out.consume_declared_name(NameInFunctionName)
	opening: FunctionOpening = out.impl_method_opening(header, owner, name, name_span)
	out.parse_opened_function(header, opening, keyword_span, name_span, BodyRequired)


---
A function whose `func name` is read: its signature, return type, constraints and body.
---
private pure func parse_opened_function(
	builder: DiscoveryBuilder,
	header: DeclarationHeader,
	opening: FunctionOpening,
	keyword_span: Span,
	name_span: Span,
	bodyless: BodylessHeader,
) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = builder
	out = out.open_function(opening)
	definition: DefinitionId = opening.function_definition()
	owned: OwnedRows = opening.function_rows()
	out = out.parse_type_parameters(owned)
	out = out.parse_signature(owned, header.purity, keyword_span, LeftParenInFunctionName)
	var end: Span = name_span

	if out.at(ArrowSymbol):
		out = out.advance_token()
		out = out.parse_type()
		return_type: NodeId = out.last_node_id()
		out = out.append_function_return_type(opening, return_type)
		end = out.node_span(return_type)

	constraints_before: Int = out.dimension_constraints.length()
	out = out.parse_dimension_constraints(definition)

	if out.dimension_constraints.length() > constraints_before:
		end = out.constraint_end()

	var has_body: Bool = False

	if out.at(ColonSymbol):
		colon_line: Int = out.span_start_line(out.current_span())
		out = out.advance_token()

		if out.function_body_follows(colon_line):
			out = out.parse_function_body(header.module, opening, header.start)
			has_body = True
			end = out.node_span(out.last_node_id())
		else:
			out = out.report_bodyless_header(bodyless, name_span)
	else if out.indented_block_follows():
		-- The body is there and only the `:` is missing: report that and read the body,
		-- so its lines are not each reported as stray declarations.
		out = out.report_expected_after_previous_content(ExpectedColon(ColonInFunctionBody))
		out = out.parse_function_body(header.module, opening, header.start)
		has_body = True
		end = out.node_span(out.last_node_id())
	else if out.at(NewlineToken) or out.at_block_end():
		out = out.report_colonless_header(bodyless, name_span)
	else:
		out = out.report_expected(ExpectedColon(ColonInFunctionBody))

	if not has_body and end.spans_equal(name_span):
		end = keyword_span

	out.close_function(opening, end)


---
Reports a header that ends its line with neither a `:` nor a body. A forward
declaration ends in `:`, so where one is allowed the missing `:` is the mistake;
elsewhere the missing body is.
---
private pure func report_colonless_header(
	builder: DiscoveryBuilder,
	bodyless: BodylessHeader,
	name_span: Span,
) -> DiscoveryBuilder:
	match bodyless:
		ForwardDeclarationAllowed:
			builder.report_expected_after_previous_content(ExpectedColon(ColonInFunctionBody))
		BodyRequired:
			builder.report_missing_function_body(name_span)


---
Reports a function header that ends in `:` with no body, unless it may be a forward
declaration.
---
private pure func report_bodyless_header(
	builder: DiscoveryBuilder,
	bodyless: BodylessHeader,
	name_span: Span,
) -> DiscoveryBuilder:
	match bodyless:
		ForwardDeclarationAllowed:
			builder
		BodyRequired:
			builder.report_missing_function_body(name_span)


---
The body after a function's or trait method's `:`, with its body row. An
indented block on the next line, or an expression on the `:` line.
`anchor` is where the declaration starts.
---
pure func parse_function_body(
	builder: DiscoveryBuilder,
	module: ModuleId,
	opening: FunctionOpening,
	anchor: Span,
) -> DiscoveryBuilder:
	out: DiscoveryBuilder = builder.parse_body_expression(body_scope(module), anchor)
	root: NodeId = out.last_node_id()
	out.append_function_body(opening, root)


private pure func parse_body_expression(
	builder: DiscoveryBuilder,
	scope: BodyScope,
	anchor: Span,
) -> DiscoveryBuilder:
	if builder.at(NewlineToken):
		builder.parse_block_after_colon(scope, anchor)
	else:
		builder.parse_expression(scope)


---
A global's value after its `=` (or where the missing `=` was reported), with
its body row. `anchor` is where the declaration starts.
---
pure func parse_global_value(
	builder: DiscoveryBuilder,
	module: ModuleId,
	opening: GlobalOpening,
	anchor: Span,
) -> DiscoveryBuilder:
	out: DiscoveryBuilder = builder.parse_assignment_value(body_scope(module), anchor)
	root: NodeId = out.last_node_id()
	out.append_global_value(opening, root)


---
A block after a `:`: a new line, then the indented statements.
---
private pure func parse_block_after_colon(
	builder: DiscoveryBuilder,
	scope: BodyScope,
	anchor: Span,
) -> DiscoveryBuilder:
	builder
		.expect_newline(NewlineInIndentedBlock)
		.parse_indented_block(scope, anchor)


---
The statements of a block anchored at `anchor`, with the block's indent and
dedent. A block written without an indent token is accepted when its first
token sits past the anchor.
---
private pure func parse_indented_block(
	builder: DiscoveryBuilder,
	scope: BodyScope,
	anchor: Span,
) -> DiscoveryBuilder:
	anchor_position: LineColumn = builder.span_start_position(anchor)
	mark: ChildMark = builder.mark_children()
	statements: DiscoveryBuilder = builder
		.consume_block_indent(anchor_position)
		.skip_newlines()
		.parse_block_items(scope, anchor_position, StatementItem)
	span: Span = statements.block_span(mark, anchor)

	statements
		.skip_optional_token(DedentToken)
		.append_plain_parent_node_since(mark, BlockParent, span)


---
Items of `item`'s kind while the tokens sit past the anchor, each pushed on
the child stack. An item that consumes nothing is skipped past so the loop
ends.
---
private pure func parse_block_items(
	builder: DiscoveryBuilder,
	scope: BodyScope,
	anchor: LineColumn,
	item: BlockItem,
) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = builder

	while not out.at_block_end() and out.indented_past(out.token_cursor, anchor):
		out = out.parse_block_item_and_push(scope, anchor, item)

	out


private pure func parse_block_item_and_push(
	builder: DiscoveryBuilder,
	scope: BodyScope,
	anchor: LineColumn,
	item: BlockItem,
) -> DiscoveryBuilder:
	before: Int = builder.token_cursor
	pushed: DiscoveryBuilder = builder
		.parse_block_item(scope, item)
		.push_last_node()
		.skip_newlines()

	if (
		pushed.token_cursor == before
		and not pushed.at_block_end()
		and pushed.indented_past(pushed.token_cursor, anchor)
	):
		pushed.advance_token()
	else:
		pushed


private pure func parse_block_item(
	builder: DiscoveryBuilder,
	scope: BodyScope,
	item: BlockItem,
) -> DiscoveryBuilder:
	match item:
		StatementItem:
			builder.parse_statement(scope)
		MatchCaseItem:
			builder.parse_match_case(scope)
		SelectArmItem:
			builder.parse_select_arm(scope)


-- Statements.
---
One statement, then the dedent that closes a leading-dot continuation
(`value\n\t.method()`) inside a binary expression.
---
private pure func parse_statement(builder: DiscoveryBuilder, scope: BodyScope) -> DiscoveryBuilder:
	builder
		.parse_statement_form(scope)
		.consume_continuation_dedent()


private pure func parse_statement_form(
	builder: DiscoveryBuilder,
	scope: BodyScope,
) -> DiscoveryBuilder:
	match builder.current_kind():
		VarKeyword:
			builder.parse_var_declaration(scope)
		WhileKeyword:
			builder.parse_while(scope)
		ForKeyword:
			builder.parse_for_statement(scope)
		FuncKeyword | PureKeyword:
			if builder.starts_local_function():
				builder.parse_local_function(scope)
			else:
				builder.parse_named_statement_or_expression(scope)
		LeftParenSymbol:
			if builder.starts_tuple_destructure():
				builder.parse_tuple_destructure(scope)
			else:
				builder.parse_named_statement_or_expression(scope)
		_:
			builder.parse_named_statement_or_expression(scope)


---
A `for` statement, anchored at its own keyword.
---
private pure func parse_for_statement(
	builder: DiscoveryBuilder,
	scope: BodyScope,
) -> DiscoveryBuilder:
	builder.parse_for(scope, builder.current_span())


---
A local function declaration and its `LocalFunctionNode`.
---
private pure func parse_local_function(
	builder: DiscoveryBuilder,
	scope: BodyScope,
) -> DiscoveryBuilder:
	start: Span = builder.current_span()
	definition: DefinitionId = builder.next_definition_id()
	header: DeclarationHeader = { plain_header(
		scope.module,
		start,
		builder.pending_annotation_count(),
	) |
		purity = builder.local_function_purity()
	}
	out: DiscoveryBuilder = builder
		.skip_pure_keyword()
		.parse_function(header, LocalFunction)
	span: Span = out.definition_span(definition)
	out.append_local_function_node(span, definition)


---
`var name [: T] = value`.
---
private pure func parse_var_declaration(
	builder: DiscoveryBuilder,
	scope: BodyScope,
) -> DiscoveryBuilder:
	start: Span = builder.current_span()
	mark: ChildMark = builder.mark_children()
	advanced: DiscoveryBuilder = builder.advance_token()
	name: NameId = advanced.binder_name_at_cursor()
	name_span: Span = advanced.current_span()
	valued: DiscoveryBuilder = advanced
		.consume_binder_name(NameInVariableName)
		.parse_optional_type_annotation()
		.expect_equal(EqualInVariableDeclaration)
		.parse_assignment_value(scope, start)
	value_span: Span = valued.node_span(valued.last_node_id())
	valued
		.push_last_node()
		.append_named_parent_node_since(
			mark,
			VarDeclarationParent,
			start.span_covering(value_span),
			name,
			name_span,
		)


---
A value after `=`: an expression on the same line, or an indented expression
on the next.
---
private pure func parse_assignment_value(
	builder: DiscoveryBuilder,
	scope: BodyScope,
	anchor: Span,
) -> DiscoveryBuilder:
	if builder.at(NewlineToken):
		builder
			.advance_token()
			.parse_indented_assignment_value(scope)
	else:
		builder
			.parse_anchored_expression(scope, anchor)
			.consume_continuation_dedent()


private pure func parse_indented_assignment_value(
	builder: DiscoveryBuilder,
	scope: BodyScope,
) -> DiscoveryBuilder:
	parsed: DiscoveryBuilder = builder
		.expect_indent(IndentInAssignmentValue)
		.parse_expression(scope)
	after: Int = parsed.run_end(NewlineToken)

	resume: Int = if parsed.token_kind_at(after) == DedentToken:
		after + 1
	else:
		after

	parsed.move_token_cursor(resume)


---
A statement that starts with a name (a binding, an assignment) or any other
expression statement.
---
private pure func parse_named_statement_or_expression(
	builder: DiscoveryBuilder,
	scope: BodyScope,
) -> DiscoveryBuilder:
	if builder.can_start_named_statement():
		after_name: Int = builder.token_cursor + 1

		if (
			builder.token_kind_at(after_name) == ColonSymbol
			and builder.colon_starts_typed_assignment(after_name)
		):
			builder.parse_typed_named_statement(scope)
		else if starts_assignment_tail(builder.token_kind_at(after_name)):
			builder.parse_named_statement(scope)
		else:
			builder.parse_expression_statement(scope)
	else if builder.at(UnderscoreSymbol):
		if starts_assignment_tail(builder.peek_kind(1)):
			builder.parse_named_statement(scope)
		else:
			builder.parse_expression(scope)
	else:
		builder.parse_expression_statement(scope)


---
`name: T = value` or `name: T ?= value`. A compound assignment never has a
type: `colon_starts_typed_assignment` looks for `=` or `?=` only.
---
private pure func parse_typed_named_statement(
	builder: DiscoveryBuilder,
	scope: BodyScope,
) -> DiscoveryBuilder:
	name: NameId = builder.binder_name_at_cursor()
	name_span: Span = builder.current_span()
	mark: ChildMark = builder.mark_children()
	builder
		.consume_binder_name(NameInStatementName)
		.parse_optional_type_annotation()
		.parse_named_assignment_tail(scope, name, name_span, mark)


---
`name = value`, `name ?= value` or `name op= value`.
---
private pure func parse_named_statement(
	builder: DiscoveryBuilder,
	scope: BodyScope,
) -> DiscoveryBuilder:
	name: NameId = builder.binder_name_at_cursor()
	name_span: Span = builder.current_span()
	mark: ChildMark = builder.mark_children()
	builder
		.consume_binder_name(NameInStatementName)
		.parse_named_assignment_tail(scope, name, name_span, mark)


---
The operator and value of a binding or assignment to `name`. Children pushed
since `mark` (the type, when written) belong to the statement.
---
private pure func parse_named_assignment_tail(
	builder: DiscoveryBuilder,
	scope: BodyScope,
	name: NameId,
	name_span: Span,
	mark: ChildMark,
) -> DiscoveryBuilder:
	typed: Bool = builder.child_count_since(mark) > 0

	match builder.current_kind():
		EqualSymbol:
			if typed:
				builder.parse_named_value(scope, TypedBindingParent, name, name_span, mark)
			else:
				builder.parse_named_value(scope, AssignmentParent, name, name_span, mark)
		QuestionEqualsSymbol:
			builder.parse_question_bind_value(scope, name, name_span, mark)
		PlusEqualSymbol:
			builder.parse_compound_assignment_value(scope, AddAssignParent, name, name_span, mark)
		MinusEqualSymbol:
			builder.parse_compound_assignment_value(scope, SubtractAssignParent, name, name_span, mark)
		StarEqualSymbol:
			builder.parse_compound_assignment_value(scope, MultiplyAssignParent, name, name_span, mark)
		SlashEqualSymbol:
			builder.parse_compound_assignment_value(scope, DivideAssignParent, name, name_span, mark)
		_:
			builder.missing_statement(name_span, mark, ExpectedAssignmentOperatorDiagnostic)


---
The value after the operator at the cursor and the `kind` statement over it.
---
private pure func parse_named_value(
	builder: DiscoveryBuilder,
	scope: BodyScope,
	kind: NamedParentKind,
	name: NameId,
	name_span: Span,
	mark: ChildMark,
) -> DiscoveryBuilder:
	builder
		.advance_token()
		.parse_assignment_value(scope, name_span)
		.finish_named_statement(kind, name, name_span, mark)


---
The value of `name op= value` and the `kind` statement over it. `_` holds no
value to update, so `_ += value` and its siblings are reported.
---
private pure func parse_compound_assignment_value(
	builder: DiscoveryBuilder,
	scope: BodyScope,
	kind: NamedParentKind,
	name: NameId,
	name_span: Span,
	mark: ChildMark,
) -> DiscoveryBuilder:
	if name.name_ids_equal(DISCARD_NAME):
		builder
			.append_plain_diagnostic(DiscardedCompoundAssignmentDiagnostic, name_span)
			.parse_named_value(scope, kind, name, name_span, mark)
	else:
		builder.parse_named_value(scope, kind, name, name_span, mark)


private pure func parse_question_bind_value(
	builder: DiscoveryBuilder,
	scope: BodyScope,
	name: NameId,
	name_span: Span,
	mark: ChildMark,
) -> DiscoveryBuilder:
	builder
		.report_question_bind_in_loop(scope)
		.advance_token()
		.parse_assignment_value(scope, name_span)
		.finish_question_bind(name, name_span, mark)


---
A statement that is an expression, or a subscript assignment
(`xs[i] = value`) or a reported field assignment (`p.x = value`) when an `=`
follows the target. A name's own statement form parses its assignment itself;
anywhere else an assignment operator is rejected by `reject_assignment`. Any
other expression is left as it is and the `=` unconsumed.
---
private pure func parse_expression_statement(
	builder: DiscoveryBuilder,
	scope: BodyScope,
) -> DiscoveryBuilder:
	anchor: Span = builder.current_span()
	parsed: DiscoveryBuilder = builder.parse_operators_at(scope, LOWEST_PRECEDENCE, anchor)

	if parsed.at(EqualSymbol):
		target: NodeRow = parsed.node_row(parsed.last_node_id())

		match target.kind:
			SubscriptNode:
				parsed
					.push_last_node()
					.finish_target_assignment(scope, SubscriptAssignment, target.span)
			FieldAccessNode:
				diagnostic: DiagnosticId = parsed.next_diagnostic_id()
				parsed
					.push_last_node()
					.append_plain_diagnostic(FieldAssignmentDiagnostic, target.span)
					.finish_target_assignment(
						scope,
						RejectedAssignment(diagnostic),
						target.span,
					)
			_:
				parsed
	else:
		parsed


---
Where an expression is parsed that an assignment operator after it must not
continue. A condition gets the advice for a mistyped comparison.
---
private enum AssignmentSite:
	ConditionSite
	ExpressionSite


---
An assignment operator after an expression that is not in statement
position: `if a = 1:`, `[a = 1]`, `f(xs[0] = 1)`, `(a = 1) + 2`. An assignment
is a statement, so it is reported at the operator and recovered as a missing
expression over the target and the value, as a rejected field assignment is.
Only an `=` in a condition is advised as a mistyped comparison.
---
private pure func reject_assignment(
	builder: DiscoveryBuilder,
	scope: BodyScope,
	site: AssignmentSite,
) -> DiscoveryBuilder:
	if starts_assignment_tail(builder.current_kind()):
		target: NodeRow = builder.node_row(builder.last_node_id())
		diagnostic: DiagnosticId = builder.next_diagnostic_id()

		code: PlainSyntaxCode = if site == ConditionSite and builder.at(EqualSymbol):
			AssignmentInConditionDiagnostic
		else:
			AssignmentInExpressionDiagnostic

		builder
			.push_last_node()
			.append_plain_diagnostic(code, builder.current_span())
			.finish_target_assignment(scope, RejectedAssignment(diagnostic), target.span)
	else:
		builder


---
What an `=` after a target that is not a name makes of the statement: a
subscript assignment, or a rejected assignment whose diagnostic is linked.
---
private union TargetAssignment:
	SubscriptAssignment
	RejectedAssignment(DiagnosticId)


---
The value after an `=` whose target the caller pushed, and the node over
both: a `SubscriptAssignmentNode`, or the recovery node of a rejected
assignment, linked to the diagnostic that rejected it.
---
private pure func finish_target_assignment(
	builder: DiscoveryBuilder,
	scope: BodyScope,
	assignment: TargetAssignment,
	target_span: Span,
) -> DiscoveryBuilder:
	out: DiscoveryBuilder = builder
		.advance_token()
		.parse_assignment_value(scope, target_span)
	value_span: Span = out.node_span(out.last_node_id())
	span: Span = target_span.span_covering(value_span)
	pushed: DiscoveryBuilder = out.push_last_node()

	match assignment:
		SubscriptAssignment:
			pushed.append_plain_parent_node_from_stack(SubscriptAssignmentParent, span, 2)
		RejectedAssignment(diagnostic):
			pushed.append_missing_parent_node_from_stack(span, diagnostic, 2)


---
`(a, b) = value`.
---
private pure func parse_tuple_destructure(
	builder: DiscoveryBuilder,
	scope: BodyScope,
) -> DiscoveryBuilder:
	start: Span = builder.current_span()
	mark: ChildMark = builder.mark_children()
	valued: DiscoveryBuilder = builder
		.advance_token()
		.parse_tuple_binder(
			start,
			DestructureBinderLeaf,
			CommaInTupleDestructuringNames,
			RightParenInTupleDestructuringNames,
		)
		.expect_equal(EqualInTupleDestructuring)
		.parse_assignment_value(scope, start)
	value_span: Span = valued.node_span(valued.last_node_id())
	valued
		.push_last_node()
		.append_plain_parent_node_since(
			mark,
			TupleDestructureParent,
			start.span_covering(value_span),
		)


-- Control flow.
---
`while condition: body`.
---
private pure func parse_while(builder: DiscoveryBuilder, scope: BodyScope) -> DiscoveryBuilder:
	start: Span = builder.current_span()
	mark: ChildMark = builder.mark_children()
	builder
		.advance_token()
		.parse_condition(scope)
		.push_last_node()
		.expect_colon(ColonInWhileCondition)
		.parse_block_after_colon(scope.in_loop_body(), start)
		.finish_with_body(WhileParent, start, mark)


---
`if condition: block [else if ... | else: block]`.
---
private pure func parse_if(
	builder: DiscoveryBuilder,
	scope: BodyScope,
	anchor: Span,
) -> DiscoveryBuilder:
	start: Span = builder.current_span()
	mark: ChildMark = builder.mark_children()
	then_branch: DiscoveryBuilder = builder
		.advance_token()
		.parse_condition(scope)
		.push_last_node()
		.expect_colon(ColonInIfCondition)
		.parse_block_after_colon(scope, anchor)
	then_end: Span = then_branch.node_span(then_branch.last_node_id())
	then_pushed: DiscoveryBuilder = then_branch.push_last_node()

	if then_pushed.at(ElseKeyword):
		else_keyword: Span = then_pushed.current_span()
		else_branch: DiscoveryBuilder = then_pushed.parse_else_branch(scope)
		else_end: Span = else_branch.node_span(else_branch.last_node_id())
		else_branch
			.push_last_node()
			.append_plain_parent_node_since(
				mark,
				IfParent,
				start.span_covering(else_end),
			)
			.record_else_keyword_of_last_node(else_keyword)
	else:
		then_pushed.append_plain_parent_node_since(
			mark,
			IfParent,
			start.span_covering(then_end),
		)


private pure func parse_else_branch(
	builder: DiscoveryBuilder,
	scope: BodyScope,
) -> DiscoveryBuilder:
	else_span: Span = builder.current_span()
	advanced: DiscoveryBuilder = builder.advance_token()

	if advanced.at(IfKeyword):
		advanced.parse_if(scope, else_span)
	else:
		advanced
			.expect_colon(ColonInElseBranch)
			.parse_block_after_colon(scope, else_span)


---
`match scrutinee:` then an indented block of cases.
---
private pure func parse_match(
	builder: DiscoveryBuilder,
	scope: BodyScope,
	anchor: Span,
) -> DiscoveryBuilder:
	start: Span = builder.current_span()
	mark: ChildMark = builder.mark_children()
	builder
		.advance_token()
		.parse_expression(scope)
		.push_last_node()
		.expect_colon(ColonInMatchExpression)
		.expect_newline(NewlineInMatchCases)
		.parse_arms_and_finish(scope, MatchParent, MatchCaseItem, start, anchor, mark)


---
The indented arms of a `match` or `select` after its header, the dedent that
closes them, and the `kind` node over everything pushed since `mark`.
---
private pure func parse_arms_and_finish(
	builder: DiscoveryBuilder,
	scope: BodyScope,
	kind: PlainParentKind,
	item: BlockItem,
	start: Span,
	anchor: Span,
	mark: ChildMark,
) -> DiscoveryBuilder:
	anchor_position: LineColumn = builder.span_start_position(anchor)
	arms: DiscoveryBuilder = builder
		.consume_block_indent(anchor_position)
		.skip_newlines()
		.parse_block_items(scope, anchor_position, item)
	end: Span = arms.arms_end_span(start)

	arms
		.skip_optional_token(DedentToken)
		.append_plain_parent_node_since(
			mark,
			kind,
			start.span_covering(end),
		)


---
`pattern: body`: a block on the next lines, a `match` or `if` on the same
line (anchored at the pattern), or a statement.
---
private pure func parse_match_case(builder: DiscoveryBuilder, scope: BodyScope) -> DiscoveryBuilder:
	mark: ChildMark = builder.mark_children()
	pattern: DiscoveryBuilder = builder.parse_pattern()
	pattern_span: Span = pattern.node_span(pattern.last_node_id())
	pattern
		.push_last_node()
		.expect_colon(ColonInMatchPattern)
		.parse_case_body(scope, pattern_span)
		.finish_with_body(MatchCaseParent, pattern_span, mark)


private pure func parse_case_body(
	builder: DiscoveryBuilder,
	scope: BodyScope,
	pattern_span: Span,
) -> DiscoveryBuilder:
	match builder.current_kind():
		NewlineToken:
			builder.parse_block_after_colon(scope, pattern_span)
		MatchKeyword:
			builder.parse_match(scope, pattern_span)
		IfKeyword:
			builder.parse_if(scope, pattern_span)
		_:
			builder.parse_statement(scope)


---
`select:` then an indented block of arms.
---
private pure func parse_select(
	builder: DiscoveryBuilder,
	scope: BodyScope,
	anchor: Span,
) -> DiscoveryBuilder:
	start: Span = builder.current_span()
	mark: ChildMark = builder.mark_children()
	builder
		.advance_token()
		.expect_colon(ColonInSelectHeader)
		.expect_newline(NewlineInSelectArms)
		.parse_arms_and_finish(scope, SelectParent, SelectArmItem, start, anchor, mark)


---
`sealed channel: body`, `_ after timeout: body`, or `name from channel: body`.
---
private pure func parse_select_arm(builder: DiscoveryBuilder, scope: BodyScope) -> DiscoveryBuilder:
	if builder.at(SealedKeyword):
		start: Span = builder.current_span()
		builder
			.advance_token()
			.parse_select_channel_arm(scope, start, SelectSealedArmParent)
	else if builder.at(UnderscoreSymbol) and builder.peek_kind(1) == AfterKeyword:
		start: Span = builder.current_span()
		-- Past the `_` and the `after`.
		after_keyword_index: Int = builder.token_cursor + 2
		builder
			.move_token_cursor(after_keyword_index)
			.parse_select_channel_arm(scope, start, SelectAfterArmParent)
	else:
		builder.parse_select_receive_arm(scope)


---
The expression, `:` and body of a sealed or timeout arm, from after its
leading keyword.
---
private pure func parse_select_channel_arm(
	builder: DiscoveryBuilder,
	scope: BodyScope,
	start: Span,
	kind: PlainParentKind,
) -> DiscoveryBuilder:
	construct: ColonConstruct = if kind == SelectSealedArmParent:
		ColonInSealedSelectChannel
	else:
		ColonInSelectTimeout

	mark: ChildMark = builder.mark_children()
	builder
		.parse_expression(scope)
		.push_last_node()
		.expect_colon(construct)
		.parse_block_after_colon(scope, start)
		.finish_with_body(kind, start, mark)


---
`name from channel: body`; the binder may also be `_`, `after` or `from`.
---
private pure func parse_select_receive_arm(
	builder: DiscoveryBuilder,
	scope: BodyScope,
) -> DiscoveryBuilder:
	start: Span = builder.current_span()
	binder: NameId = builder.receive_binder_at_cursor()
	mark: ChildMark = builder.mark_children()
	body: DiscoveryBuilder = builder
		.consume_receive_binder()
		.expect_keyword_token(FromKeyword, KeywordInSelectReceiveBinding)
		.parse_expression(scope)
		.push_last_node()
		.expect_colon(ColonInSelectReceiveChannel)
		.parse_block_after_colon(scope, start)
	body_span: Span = body.node_span(body.last_node_id())
	body
		.push_last_node()
		.append_named_parent_node_since(
			mark,
			SelectReceiveArmParent,
			start.span_covering(body_span),
			binder,
			start,
		)


---
`for binder in iterable: body`, or `for x in xs concurrently(...): body`.
---
private pure func parse_for(
	builder: DiscoveryBuilder,
	scope: BodyScope,
	anchor: Span,
) -> DiscoveryBuilder:
	start: Span = builder.current_span()
	mark: ChildMark = builder.mark_children()
	tuple_binder: Bool = builder.peek_kind(1) == LeftParenSymbol
	iterated: DiscoveryBuilder = builder
		.advance_token()
		.parse_loop_binder()
		.expect_keyword_token(InKeyword, KeywordInForLoopVariable)
		.parse_expression(scope)
		.push_last_node()
	is_concurrent: Bool = iterated.at(ConcurrentlyKeyword)

	header: DiscoveryBuilder = if is_concurrent:
		iterated.parse_concurrently_header(scope, tuple_binder)
	else:
		iterated

	kind: PlainParentKind = if is_concurrent:
		ConcurrentForParent
	else:
		ForParent

	colon_construct: ColonConstruct = if is_concurrent:
		ColonInConcurrentlyParameters
	else:
		ColonInForIterable

	header
		.expect_colon(colon_construct)
		.parse_block_after_colon(scope.in_loop_body(), anchor)
		.finish_with_body(kind, start, mark)


---
`concurrently(parameters)` after a `for` iterable; a tuple loop binder is
reported, since a concurrent loop binds one value.
---
private pure func parse_concurrently_header(
	builder: DiscoveryBuilder,
	scope: BodyScope,
	tuple_binder: Bool,
) -> DiscoveryBuilder:
	reported: DiscoveryBuilder = if tuple_binder:
		builder.report_at_current(ConcurrentForTupleBinderDiagnostic)
	else:
		builder

	reported
		.advance_token()
		.parse_concurrent_parameters_after_concurrently(scope)


---
The `(name: value, ...)` after `concurrently`, each parameter pushed; a
missing `(` is reported.
---
private pure func parse_concurrent_parameters_after_concurrently(
	builder: DiscoveryBuilder,
	scope: BodyScope,
) -> DiscoveryBuilder:
	if builder.at(LeftParenSymbol):
		builder
			.advance_token()
			.parse_concurrent_parameter_list(scope, ConcurrentForOwner)
	else:
		builder.report_expected(ExpectedLeftParen(LeftParenInConcurrentlyHeader))


---
Concurrent parameters after `(`, through the `)`; at least one. The rules
match the existing parser: `concurrent` takes optional `max_threads` and
`timeout`; `concurrently` requires `limit` and takes optional `timeout`; a
count is a positive integer literal and every name appears once.
---
private pure func parse_concurrent_parameter_list(
	builder: DiscoveryBuilder,
	scope: BodyScope,
	owner: ConcurrentParameterOwner,
) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = builder
	var seen: List[ConcurrentParameterName] = []

	if out.at(RightParenSymbol):
		out = out.report_at_current(ExpectedConcurrentParameterDiagnostic)

	while not out.at(RightParenSymbol) and not out.at(EndOfFileToken):
		name: ConcurrentParameterName = out.concurrent_parameter_name()
		out = out.parse_concurrent_parameter(scope, owner, name, seen)
		seen = seen.append(name)

	count_missing: Bool = (
		owner == ConcurrentForOwner
		and seen.length() > 0
		and not seen.concurrent_parameter_seen(owner.concurrent_count_parameter())
	)

	if count_missing:
		out = out.report_at_current(ConcurrentForMissingLimitDiagnostic)

	construct: RightParenConstruct = if owner == ConcurrentForOwner:
		RightParenInConcurrentlyParameters
	else:
		RightParenInConcurrentParameters

	out.expect_right_paren(construct)


---
`name: value` and the comma after it, pushed, checked against `owner`'s
rules. It always moves the cursor unless the cursor is at the `)`, so the
list above ends.
---
private pure func parse_concurrent_parameter(
	builder: DiscoveryBuilder,
	scope: BodyScope,
	owner: ConcurrentParameterOwner,
	parameter: ConcurrentParameterName,
	seen: List[ConcurrentParameterName],
) -> DiscoveryBuilder:
	before: Int = builder.token_cursor
	name: NameId = builder.referenced_name_at_cursor()
	name_span: Span = builder.current_span()
	valued: DiscoveryBuilder = builder
		.consume_referenced_name(NameInConcurrentNamedParameter)
		.expect_colon(ColonInConcurrentNamedParameter)
		.parse_expression(scope)
	value: NodeId = valued.last_node_id()
	value_span: Span = valued.node_span(value)

	pushed: DiscoveryBuilder = valued
		.check_concurrent_parameter(owner, parameter, name, seen, name_span, value)
		.push_last_node()
		.append_named_parent_node_from_stack(
			ConcurrentParameterParent,
			name_span.span_covering(value_span),
			name,
			name_span,
			1,
		)
		.push_last_node()

	separated: DiscoveryBuilder = if pushed.at(CommaSymbol):
		pushed.advance_token()
	else if not pushed.at(RightParenSymbol):
		pushed.report_expected(ExpectedComma(CommaInConcurrentParameters))
	else:
		pushed

	if separated.token_cursor == before and not separated.at(RightParenSymbol):
		separated.advance_token()
	else:
		separated


---
`concurrent[(params)]: body`.
---
private pure func parse_concurrent_block(
	builder: DiscoveryBuilder,
	scope: BodyScope,
) -> DiscoveryBuilder:
	start: Span = builder.current_span()
	mark: ChildMark = builder.mark_children()
	advanced: DiscoveryBuilder = builder.advance_token()

	parameters: DiscoveryBuilder = if advanced.at(LeftParenSymbol):
		advanced
			.advance_token()
			.parse_concurrent_parameter_list(scope, ConcurrentBlockOwner)
	else:
		advanced

	parameters
		.expect_colon(ColonInConcurrentBlock)
		.parse_block_after_colon(scope.outside_loops(), start)
		.finish_with_body(ConcurrentBlockParent, start, mark)


---
`debug: body`; `debug.name` is the name `debug` (see `parse_primary`).
---
private pure func parse_debug_block(
	builder: DiscoveryBuilder,
	scope: BodyScope,
) -> DiscoveryBuilder:
	start: Span = builder.current_span()
	mark: ChildMark = builder.mark_children()
	builder
		.advance_token()
		.expect_colon(ColonInDebugBlock)
		.parse_block_after_colon(scope, start)
		.finish_with_body(DebugBlockParent, start, mark)


---
`with name [: T] = value: body` or `with name [: T] ?= value [on e =>
mapped]: body`.
---
private pure func parse_with(builder: DiscoveryBuilder, scope: BodyScope) -> DiscoveryBuilder:
	start: Span = builder.current_span()
	mark: ChildMark = builder.mark_children()
	var out: DiscoveryBuilder = builder
		.advance_token()
		.parse_with_binding(scope)
		.push_last_node()

	if out.at(CommaSymbol):
		out = out.report_at_current(WithMultipleBindingsDiagnostic)
		out = out.skip_to_header_colon()

	out = out.expect_colon(ColonInWithBinding)
	out = out.parse_block_after_colon(scope, start)
	out.finish_with_body(WithParent, start, mark)


private pure func parse_with_binding(
	builder: DiscoveryBuilder,
	scope: BodyScope,
) -> DiscoveryBuilder:
	name: NameId = builder.binder_name_at_cursor()
	name_span: Span = builder.current_span()
	mark: ChildMark = builder.mark_children()
	typed: DiscoveryBuilder = builder
		.consume_binder_name(NameInWithBindingName)
		.parse_optional_type_annotation()
	tried: Bool = typed.at(QuestionEqualsSymbol)

	operator: DiscoveryBuilder = if tried:
		typed.advance_token()
	else:
		typed.expect_equal(EqualInWithBinding)

	kind: NamedParentKind = if tried:
		WithTryBindingParent
	else:
		WithBindingParent

	valued: DiscoveryBuilder = operator.parse_expression(scope)
	value_end: Span = valued.node_span(valued.last_node_id())
	pushed: DiscoveryBuilder = valued.push_last_node()

	if tried and pushed.at(OnKeyword):
		mapped: DiscoveryBuilder = pushed.parse_with_error_map(scope)
		mapped_end: Span = mapped.node_span(mapped.last_node_id())
		mapped
			.push_last_node()
			.append_named_parent_node_since(
				mark,
				kind,
				name_span.span_covering(mapped_end),
				name,
				name_span,
			)
	else:
		pushed.append_named_parent_node_since(
			mark,
			kind,
			name_span.span_covering(value_end),
			name,
			name_span,
		)


---
`on name => value`.
---
private pure func parse_with_error_map(
	builder: DiscoveryBuilder,
	scope: BodyScope,
) -> DiscoveryBuilder:
	mark: ChildMark = builder.mark_children()
	advanced: DiscoveryBuilder = builder.advance_token()
	name: NameId = advanced.binder_name_at_cursor()
	name_span: Span = advanced.current_span()
	valued: DiscoveryBuilder = advanced
		.consume_binder_name(NameInWithErrorName)
		.expect_fat_arrow(FatArrowInWithErrorName)
		.parse_expression(scope)
	value_span: Span = valued.node_span(valued.last_node_id())
	valued
		.push_last_node()
		.append_named_parent_node_since(
			mark,
			WithErrorMapParent,
			name_span.span_covering(value_span),
			name,
			name_span,
		)


-- Lambdas.
---
`func(params) [-> R]: body` or `pure func(...)`. The body is an expression
on the `:` line, a block on the next lines, or an indented block on a later
line reached without a newline token (inside brackets).
---
private pure func parse_lambda(
	builder: DiscoveryBuilder,
	scope: BodyScope,
	anchor: Span,
) -> DiscoveryBuilder:
	start: Span = builder.current_span()
	mark: ChildMark = builder.mark_children()

	kind: PlainParentKind = if builder.at(PureKeyword):
		PureLambdaParent
	else:
		LambdaParent

	opened: DiscoveryBuilder = builder
		.skip_pure_keyword()
		.expect_keyword_token(FuncKeyword, KeywordInLambdaFunc)

	parameters: DiscoveryBuilder = if opened.at(LeftParenSymbol):
		opened
			.advance_token()
			.parse_lambda_parameters()
	else:
		opened.report_expected(ExpectedLeftParen(LeftParenInLambdaFunc))

	returned: DiscoveryBuilder = if parameters.at(ArrowSymbol):
		parameters
			.advance_token()
			.parse_type()
			.push_last_node()
	else:
		parameters

	colon_line: Int = returned.span_start_line(returned.current_span())
	returned
		.expect_colon(ColonInLambdaBody)
		.parse_lambda_body(scope.outside_loops(), colon_line, anchor)
		.finish_with_body(kind, start, mark)


---
A lambda's body, parsed outside every loop: its `break` cannot leave the
enclosing loop, and its `?=` returns from the lambda.
---
private pure func parse_lambda_body(
	builder: DiscoveryBuilder,
	scope: BodyScope,
	colon_line: Int,
	anchor: Span,
) -> DiscoveryBuilder:
	if builder.at(NewlineToken):
		builder.parse_block_after_colon(scope, anchor)
	else if builder.span_start_line(builder.current_span()) > colon_line and builder.indented_past(
		builder.token_cursor,
		builder.span_start_position(anchor),
	):
		builder.parse_indented_block(scope, anchor)
	else:
		builder.parse_expression(scope)


-- Expressions.
---
An expression at the lowest precedence, anchored at its own start.
---
pure func parse_expression(builder: DiscoveryBuilder, scope: BodyScope) -> DiscoveryBuilder:
	anchor: Span = builder.current_span()
	builder.parse_expression_at(scope, anchor)


---
The condition of an `if` or `while`: an expression, where an `=` is advised
as a mistyped comparison.
---
private pure func parse_condition(builder: DiscoveryBuilder, scope: BodyScope) -> DiscoveryBuilder:
	anchor: Span = builder.current_span()
	builder
		.parse_operators_at(scope, LOWEST_PRECEDENCE, anchor)
		.reject_assignment(scope, ConditionSite)


---
An expression that may start a block-bearing construct (`if`, `match`,
`select`, `for`, a lambda) anchored at `anchor` rather than at itself.
---
private pure func parse_anchored_expression(
	builder: DiscoveryBuilder,
	scope: BodyScope,
	anchor: Span,
) -> DiscoveryBuilder:
	match builder.current_kind():
		IfKeyword:
			builder.parse_if(scope, anchor)
		MatchKeyword:
			builder.parse_match(scope, anchor)
		SelectKeyword:
			builder.parse_select(scope, anchor)
		ForKeyword:
			builder.parse_for(scope, anchor)
		FuncKeyword | PureKeyword:
			builder.parse_lambda(scope, anchor)
		_:
			builder.parse_expression_at(scope, anchor)


---
An expression at the lowest precedence, anchored at `anchor`. An assignment
operator after it is rejected: assignment is a statement, never a value.
---
private pure func parse_expression_at(
	builder: DiscoveryBuilder,
	scope: BodyScope,
	anchor: Span,
) -> DiscoveryBuilder:
	builder
		.parse_operators_at(scope, LOWEST_PRECEDENCE, anchor)
		.reject_assignment(scope, ExpressionSite)


---
Binary operators of at least `min_precedence` over prefix expressions. It
leaves an assignment operator after the expression unconsumed, for the
caller to parse (a statement) or reject.
---
private pure func parse_operators_at(
	builder: DiscoveryBuilder,
	scope: BodyScope,
	min_precedence: Int,
	anchor: Span,
) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = builder.parse_prefix(scope, anchor)
	var parsing: Bool = True

	while parsing and not out.at(EndOfFileToken):
		kind: TokenKind = out.current_kind()

		if kind == AsKeyword:
			if LOWEST_PRECEDENCE < min_precedence:
				parsing = False
			else:
				out = out.report_removed_ascription()
		else:
			match kind.binary_operator():
				Some(operator):
					if operator.operator_precedence() < min_precedence:
						parsing = False
					else:
						out = out.parse_binary(scope, operator, anchor)
				None:
					parsing = False

	out


---
`left op right`, the left operand parsed; the right operand binds tighter.
---
private pure func parse_binary(
	builder: DiscoveryBuilder,
	scope: BodyScope,
	operator: BinaryOperator,
	anchor: Span,
) -> DiscoveryBuilder:
	precedence: Int = operator.operator_precedence()
	left_span: Span = builder.node_span(builder.last_node_id())
	out: DiscoveryBuilder = builder
		.push_last_node()
		.advance_token()
		.skip_newlines()
		.parse_operators_at(scope, precedence + 1, anchor)
	right_span: Span = out.node_span(out.last_node_id())
	out
		.push_last_node()
		.append_plain_parent_node_from_stack(
			operator.operator_node_kind(),
			left_span.span_covering(right_span),
			2,
		)


---
`-x`, `not x`, `detach x`, the block-bearing constructs (anchored at
`anchor`), or a primary expression with its postfix operations.
---
private pure func parse_prefix(
	builder: DiscoveryBuilder,
	scope: BodyScope,
	anchor: Span,
) -> DiscoveryBuilder:
	match builder.current_kind():
		MinusSymbol:
			builder.parse_unary(scope, NegateParent, anchor)
		NotKeyword:
			builder.parse_unary(scope, NotParent, anchor)
		DetachKeyword:
			builder.parse_unary(scope, DetachParent, anchor)
		FuncKeyword | PureKeyword:
			builder.parse_lambda(scope, anchor)
		IfKeyword:
			builder.parse_if(scope, anchor)
		MatchKeyword:
			builder.parse_match(scope, anchor)
		SelectKeyword:
			builder.parse_select(scope, anchor)
		ForKeyword:
			builder.parse_for(scope, anchor)
		_:
			builder
				.parse_primary(scope)
				.parse_postfix(scope, anchor)


private pure func parse_unary(
	builder: DiscoveryBuilder,
	scope: BodyScope,
	kind: PlainParentKind,
	anchor: Span,
) -> DiscoveryBuilder:
	start: Span = builder.current_span()
	mark: ChildMark = builder.mark_children()
	builder
		.advance_token()
		.parse_prefix(scope, anchor)
		.finish_with_body(kind, start, mark)


---
Field accesses, calls and subscripts after a primary expression. A `.` may
start a continuation line (`value\n\t.method()`); each indent such a line
opens is closed by the dedent that ends the chain.
---
private pure func parse_postfix(
	builder: DiscoveryBuilder,
	scope: BodyScope,
	anchor: Span,
) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = builder
	var parsing: Bool = True
	var continuation_indents: Int = 0

	while parsing and not out.at(EndOfFileToken):
		if continuation_indents > 0 and out.at(DedentToken):
			out = out.advance_token()
			continuation_indents -= 1
			parsing = continuation_indents > 0
		else if continuation_indents > 0 and out.at(NewlineToken):
			after_newline: Int = out.token_cursor + 1

			if out.token_kind_at(after_newline) == DedentToken:
				out = out.move_token_cursor(after_newline + 1)
				continuation_indents -= 1
				parsing = continuation_indents > 0
			else:
				continuation: Int = out.continuation_start()

				if continuation == out.token_cursor:
					-- A new line that continues nothing ends the chain.
					parsing = False
				else:
					if out.token_kind_at(continuation - 1) == IndentToken:
						continuation_indents += 1

					out = out.move_token_cursor(continuation)
		else:
			continuation: Int = out.continuation_start()

			if continuation != out.token_cursor:
				if out.token_kind_at(continuation - 1) == IndentToken:
					continuation_indents += 1

				out = out.move_token_cursor(continuation)

			match out.current_kind():
				DotSymbol:
					out = out.parse_field_access()
				LeftParenSymbol:
					out = out.parse_call(scope, anchor)
				LeftBracketSymbol:
					out = out.parse_subscript(scope, anchor)
				_:
					parsing = False

	out


---
`(arguments)` after a callee.
---
private pure func parse_call(
	builder: DiscoveryBuilder,
	scope: BodyScope,
	anchor: Span,
) -> DiscoveryBuilder:
	callee_span: Span = builder.node_span(builder.last_node_id())
	mark: ChildMark = builder.mark_children()
	arguments: DiscoveryBuilder = builder
		.push_last_node()
		.advance_token()
		.parse_expression_list(scope, RightParenSymbol, MayBeEmpty, anchor)
	end: Span = arguments.closing_span_or(RightParenSymbol, callee_span)
	arguments
		.expect_right_paren(RightParenInCallArguments)
		.append_plain_parent_node_since(
			mark,
			CallParent,
			callee_span.span_covering(end),
		)


---
`[indices]` after a target.
---
private pure func parse_subscript(
	builder: DiscoveryBuilder,
	scope: BodyScope,
	anchor: Span,
) -> DiscoveryBuilder:
	target_span: Span = builder.node_span(builder.last_node_id())
	mark: ChildMark = builder.mark_children()
	indices: DiscoveryBuilder = builder
		.push_last_node()
		.advance_token()
		.parse_expression_list(scope, RightBracketSymbol, NeedsAnItem, anchor)
	end: Span = indices.closing_span_or(RightBracketSymbol, target_span)
	indices
		.expect_right_bracket(RightBracketInSubscript)
		.append_plain_parent_node_since(
			mark,
			SubscriptParent,
			target_span.span_covering(end),
		)


---
Whether a bracketed list of items may have none.
---
private enum ListItems:
	MayBeEmpty
	NeedsAnItem


---
Expressions separated by commas up to `end` (not consumed), each pushed;
with `MayBeEmpty` there may be none. After a comma, newlines and dedents
that lead only to `end` are consumed.
---
private pure func parse_expression_list(
	builder: DiscoveryBuilder,
	scope: BodyScope,
	end: TokenKind,
	items: ListItems,
	anchor: Span,
) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = builder
	var parsing: Bool = not (out.at(EndOfFileToken) or items == MayBeEmpty and out.at(end))

	while parsing:
		out = out.parse_anchored_expression(scope, anchor)
		out = out.push_last_node()

		if out.at(CommaSymbol):
			out = out.advance_token()
			layout_follows: Bool = out.at(NewlineToken) or out.at(DedentToken)
			out = out.skip_newlines()

			if layout_follows:
				out = out.consume_layout_before(end)

			parsing = not (out.at(end) or out.at(EndOfFileToken))
		else:
			parsing = False

	out


-- Primary expressions.
---
A name, literal, bracketed form, keyword expression, or a reported missing
expression.
---
private pure func parse_primary(builder: DiscoveryBuilder, scope: BodyScope) -> DiscoveryBuilder:
	token: Token = builder.current_token()

	match token.kind:
		IdentifierToken:
			builder.parse_identifier_expression()
		IntLiteralToken:
			builder.literal_leaf(IntegerLiteralLeaf)
		FloatLiteralToken:
			builder.literal_leaf(FloatLiteralLeaf)
		NormalStringToken:
			builder.literal_leaf(StringLiteralLeaf)
		RawStringToken:
			builder.literal_leaf(RawStringLiteralLeaf)
		PipeStringToken:
			builder.literal_leaf(PipeStringLiteralLeaf)
		RawPipeStringToken:
			builder.literal_leaf(RawPipeStringLiteralLeaf)
		InterpolatedStringToken:
			builder.parse_interpolated_string(scope, InterpolatedStringParent)
		InterpolatedPipeStringToken:
			builder.parse_interpolated_string(scope, InterpolatedPipeStringParent)
		CharLiteralToken:
			builder.char_leaf()
		TrueKeyword:
			builder.keyword_leaf(TrueLiteralLeaf)
		FalseKeyword:
			builder.keyword_leaf(FalseLiteralLeaf)
		BreakKeyword:
			builder.loop_keyword_leaf(scope, BreakLeaf, BreakOutsideLoopDiagnostic)
		ContinueKeyword:
			builder.loop_keyword_leaf(scope, ContinueLeaf, ContinueOutsideLoopDiagnostic)
		VoidKeyword | UnderscoreSymbol:
			builder.keyword_leaf(VoidLeaf)
		AfterKeyword | SealedKeyword:
			builder.keyword_name_leaf()
		BuiltinKeyword:
			builder.parse_builtin()
		IntoOpaqueKeyword:
			builder.parse_opaque_conversion(scope, IntoOpaqueParent)
		FromOpaqueKeyword:
			builder.parse_opaque_conversion(scope, FromOpaqueParent)
		FromKeyword:
			builder.keyword_name_leaf()
		FuncKeyword | PureKeyword:
			builder.parse_lambda(scope, token.span)
		IfKeyword:
			builder.parse_if(scope, token.span)
		MatchKeyword:
			builder.parse_match(scope, token.span)
		SelectKeyword:
			builder.parse_select(scope, token.span)
		DebugKeyword:
			if builder.peek_kind(1) == DotSymbol:
				builder.keyword_name_leaf()
			else:
				builder.parse_debug_block(scope)
		WithKeyword:
			builder.parse_with(scope)
		ConcurrentKeyword:
			builder.parse_concurrent_block(scope)
		LeftParenSymbol:
			builder.parse_parenthesized(scope)
		LeftBracketSymbol:
			builder.parse_list_literal(scope)
		LeftBraceSymbol:
			builder.parse_braced(scope)
		_:
			builder.missing_expression()


---
`into_opaque T(value)` or `from_opaque T(value)`.
---
private pure func parse_opaque_conversion(
	builder: DiscoveryBuilder,
	scope: BodyScope,
	kind: PlainParentKind,
) -> DiscoveryBuilder:
	start: Span = builder.current_span()
	valued: DiscoveryBuilder = builder
		.advance_token()
		.parse_type()
		.push_last_node()
		.expect_left_paren(LeftParenInOpaqueConversionType)
		.parse_expression(scope)
	value_end: Span = valued.node_span(valued.last_node_id())
	pushed: DiscoveryBuilder = valued.push_last_node()

	end: Span = if pushed.at(RightParenSymbol):
		pushed.current_span()
	else:
		value_end

	pushed
		.expect_right_paren(RightParenInOpaqueConversionValue)
		.append_plain_parent_node_from_stack(
			kind,
			start.span_covering(end),
			2,
		)


---
`()` (void), `(expr)` (grouping, which widens the expression's span to the
parentheses), or a tuple `(a, b, ...)`.
---
private pure func parse_parenthesized(
	builder: DiscoveryBuilder,
	scope: BodyScope,
) -> DiscoveryBuilder:
	start: Span = builder.current_span()
	out: DiscoveryBuilder = builder.advance_token()

	if out.at(RightParenSymbol):
		close: Span = out.current_span()
		out
			.advance_token()
			.append_plain_leaf_node(
				VoidLeaf,
				start.span_covering(close),
			)
	else:
		out
			.parse_expression_at(scope, start)
			.parse_grouping_or_tuple(scope, start)


private pure func parse_grouping_or_tuple(
	builder: DiscoveryBuilder,
	scope: BodyScope,
	start: Span,
) -> DiscoveryBuilder:
	if builder.at(CommaSymbol):
		builder.parse_tuple_rest(scope, start)
	else if builder.at(RightParenSymbol):
		close: Span = builder.current_span()
		grouped: NodeKind = builder.node_row(builder.last_node_id()).kind
		advanced: DiscoveryBuilder = builder.advance_token()

		if grouped.keeps_token_span():
			advanced
		else:
			advanced.replace_last_node_span(start.span_covering(close))
	else:
		builder.report_expected(ExpectedRightParen(RightParenInGroupedExpression))


---
The rest of a tuple after its first item, which the caller parsed.
---
private pure func parse_tuple_rest(
	builder: DiscoveryBuilder,
	scope: BodyScope,
	start: Span,
) -> DiscoveryBuilder:
	first_span: Span = builder.node_span(builder.last_node_id())
	mark: ChildMark = builder.mark_children()
	var out: DiscoveryBuilder = builder.push_last_node()
	var parsing: Bool = True

	while parsing and not out.at(EndOfFileToken):
		if out.at(CommaSymbol):
			out = out.advance_token()

			if out.at(RightParenSymbol):
				parsing = False
			else:
				out = out.parse_expression_at(scope, start)
				out = out.push_last_node()
		else:
			parsing = False

	end: Span = out.closing_span_or(RightParenSymbol, first_span)
	out = out.expect_right_paren(RightParenInTupleExpression)
	count: Int = out.child_count_since(mark)
	span: Span = start.span_covering(end)

	if count > MAX_TUPLE_ITEMS:
		out = out.append_plain_diagnostic(TupleArityDiagnostic, span)

	out.append_plain_parent_node_from_stack(TupleParent, span, count)


---
`[items]`.
---
private pure func parse_list_literal(
	builder: DiscoveryBuilder,
	scope: BodyScope,
) -> DiscoveryBuilder:
	start: Span = builder.current_span()
	mark: ChildMark = builder.mark_children()
	items: DiscoveryBuilder = builder
		.advance_token()
		.parse_expression_list(scope, RightBracketSymbol, MayBeEmpty, start)
	end: Span = items.closing_span_or(RightBracketSymbol, start)
	items
		.expect_right_bracket(RightBracketInListLiteral)
		.append_plain_parent_node_since(
			mark,
			ListLiteralParent,
			start.span_covering(end),
		)


---
`{...}`: a record literal (`{}` or `{name = ...}`), a dict literal
(`{key => value}`), a record update (`{record | name = ...}`), or a vector
literal (`{a, b}`).
---
private pure func parse_braced(builder: DiscoveryBuilder, scope: BodyScope) -> DiscoveryBuilder:
	start: Span = builder.current_span()
	out: DiscoveryBuilder = builder.advance_token()

	if out.at(RightBraceSymbol) or out.starts_record_field():
		out.parse_record_literal(scope, start)
	else:
		out
			.parse_expression(scope)
			.parse_braced_after_first(scope, start)


private pure func parse_braced_after_first(
	builder: DiscoveryBuilder,
	scope: BodyScope,
	start: Span,
) -> DiscoveryBuilder:
	match builder.current_kind():
		FatArrowSymbol:
			builder.parse_dict_rest(scope, start)
		PipeSymbol:
			builder.parse_record_update_rest(scope, start)
		_:
			builder.parse_vector_rest(scope, start)


private pure func parse_record_literal(
	builder: DiscoveryBuilder,
	scope: BodyScope,
	start: Span,
) -> DiscoveryBuilder:
	mark: ChildMark = builder.mark_children()
	fields: DiscoveryBuilder = builder.parse_record_fields(scope, MayBeEmpty)
	end: Span = fields.closing_span_or(RightBraceSymbol, start)
	fields
		.expect_right_brace(RightBraceInRecordLiteral)
		.append_plain_parent_node_since(
			mark,
			RecordLiteralParent,
			start.span_covering(end),
		)


---
Record fields up to `}` (not consumed), each pushed; with `allow_empty`
there may be none.
---
private pure func parse_record_fields(
	builder: DiscoveryBuilder,
	scope: BodyScope,
	items: ListItems,
) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = builder
	-- Taken from `out`: a later read of `builder` would keep it alive and make every
	-- update copy its tables.
	mark: ChildMark = out.mark_children()
	var parsing: Bool = not ((
		out.at(EndOfFileToken)
		or items == MayBeEmpty and out.at(RightBraceSymbol)
	))

	while parsing:
		out = out.parse_record_field(scope, mark)
		out = out.push_last_node()

		if out.at(CommaSymbol):
			out = out.advance_token()
			parsing = not (out.at(RightBraceSymbol) or out.at(EndOfFileToken))
		else:
			parsing = False

	out


---
The span of the field of the record literal or update being parsed (its fields are
the children pushed since `mark`) that is already named `name`, else `NO_SPAN`. A
missing name is no name, so it repeats nothing.
---
private pure func earlier_field_given(
	builder: DiscoveryBuilder,
	mark: ChildMark,
	name: NameId,
) -> Span:
	if name.name_ids_equal(EMPTY_NAME):
		NO_SPAN
	else:
		builder.span_of_child_named_since(mark, name)


---
Reports at `name_span` that the field was already given at `earlier`, unless
`earlier` is `NO_SPAN`.
---
private pure func report_field_given_twice(
	builder: DiscoveryBuilder,
	earlier: Span,
	name_span: Span,
) -> DiscoveryBuilder:
	if earlier.spans_equal(NO_SPAN):
		builder
	else:
		builder.append_syntax_diagnostic(name_span, DuplicateFieldGiven(earlier))


---
`name = value`, where `mark` is the start of the fields of the record literal or
update (a field already given under the name is reported).
---
private pure func parse_record_field(
	builder: DiscoveryBuilder,
	scope: BodyScope,
	mark: ChildMark,
) -> DiscoveryBuilder:
	name: NameId = builder.referenced_name_at_cursor()
	name_span: Span = builder.current_span()
	earlier: Span = builder.earlier_field_given(mark, name)
	out: DiscoveryBuilder = builder
		.consume_referenced_name(NameInRecordFieldName)
		.expect_equal(EqualInRecordFieldName)
		.parse_expression(scope)
	value_span: Span = out.node_span(out.last_node_id())
	out
		.report_field_given_twice(earlier, name_span)
		.push_last_node()
		.append_named_parent_node_from_stack(
			RecordFieldParent,
			name_span.span_covering(value_span),
			name,
			name_span,
			1,
		)


---
`{record | fields}` after the record, which the caller parsed.
---
private pure func parse_record_update_rest(
	builder: DiscoveryBuilder,
	scope: BodyScope,
	start: Span,
) -> DiscoveryBuilder:
	record_span: Span = builder.node_span(builder.last_node_id())
	mark: ChildMark = builder.mark_children()
	-- The caller saw the `|`, so it is consumed, not expected.
	fields: DiscoveryBuilder = builder
		.push_last_node()
		.advance_token()
		.parse_record_fields(scope, NeedsAnItem)
	end: Span = fields.closing_span_or(RightBraceSymbol, record_span)
	fields
		.expect_right_brace(RightBraceInRecordUpdate)
		.append_plain_parent_node_since(
			mark,
			RecordUpdateParent,
			start.span_covering(end),
		)


---
`{key => value, ...}` after the first key, which the caller parsed.
---
private pure func parse_dict_rest(
	builder: DiscoveryBuilder,
	scope: BodyScope,
	start: Span,
) -> DiscoveryBuilder:
	first_span: Span = builder.node_span(builder.last_node_id())
	mark: ChildMark = builder.mark_children()
	var out: DiscoveryBuilder = builder
		.parse_dict_entry_after_key(scope)
		.push_last_node()
	var parsing: Bool = True

	while parsing and not out.at(EndOfFileToken):
		if out.at(CommaSymbol):
			out = out.advance_token()

			if out.at(RightBraceSymbol):
				parsing = False
			else:
				out = out.parse_expression(scope)
				out = out.parse_dict_entry_after_key(scope)
				out = out.push_last_node()
		else:
			parsing = False

	end: Span = out.closing_span_or(RightBraceSymbol, first_span)
	out = out.expect_right_brace(RightBraceInDictLiteral)
	out.append_plain_parent_node_since(
		mark,
		DictLiteralParent,
		start.span_covering(end),
	)


---
`=> value` after a dict key, which the caller parsed, and the entry node.
---
private pure func parse_dict_entry_after_key(
	builder: DiscoveryBuilder,
	scope: BodyScope,
) -> DiscoveryBuilder:
	key_span: Span = builder.node_span(builder.last_node_id())
	mark: ChildMark = builder.mark_children()
	builder
		.push_last_node()
		.expect_fat_arrow(FatArrowInDictEntry)
		.parse_expression(scope)
		.finish_with_body(DictEntryParent, key_span, mark)


---
`{a, b, ...}` after the first item, which the caller parsed.
---
private pure func parse_vector_rest(
	builder: DiscoveryBuilder,
	scope: BodyScope,
	start: Span,
) -> DiscoveryBuilder:
	first_span: Span = builder.node_span(builder.last_node_id())
	mark: ChildMark = builder.mark_children()
	var out: DiscoveryBuilder = builder.push_last_node()
	var parsing: Bool = True

	while parsing and not out.at(EndOfFileToken):
		if out.at(CommaSymbol):
			out = out.advance_token()

			if out.at(RightBraceSymbol):
				parsing = False
			else:
				out = out.parse_expression(scope)
				out = out.push_last_node()
		else:
			parsing = False

	end: Span = out.closing_span_or(RightBraceSymbol, first_span)
	out = out.expect_right_brace(RightBraceInVectorLiteral)
	out.append_plain_parent_node_since(
		mark,
		VectorLiteralParent,
		start.span_covering(end),
	)


-- Interpolated strings.
---
An interpolated string: its text pieces (`InterpolationTextNode`) and holes
(`InterpolationHoleNode`) in source order, each pushed. The lexer found the
pieces and hole ranges; each hole's source text is lexed into tokens appended
after the module's own and parsed there as one expression, and the cursor
then returns to after the string.
---
private pure func parse_interpolated_string(
	builder: DiscoveryBuilder,
	scope: BodyScope,
	kind: PlainParentKind,
) -> DiscoveryBuilder:
	token: Token = builder.current_token()
	resume: Int = builder.token_cursor + 1
	mark: ChildMark = builder.mark_children()
	parts: RowRange = builder.interpolation_parts_of(token.payload)
	builder
		.parse_interpolation_parts(scope, token.span.span_source(), parts)
		.move_token_cursor(resume)
		.append_plain_parent_node_since(mark, kind, token.span)


private pure func parse_interpolation_parts(
	builder: DiscoveryBuilder,
	scope: BodyScope,
	source: SourceId,
	parts: RowRange,
) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = builder
	var index: Int = parts.first

	while index < parts.first + parts.count:
		part: InterpolationPartRow = out.interpolation_part_at(index)
		out = out.parse_interpolation_part(scope, source, part)
		index += 1

	out


---
One piece, pushed: a text node, or the hole's expression.
---
private pure func parse_interpolation_part(
	builder: DiscoveryBuilder,
	scope: BodyScope,
	source: SourceId,
	part: InterpolationPartRow,
) -> DiscoveryBuilder:
	span: Span = pack_span(source, part.start, part.end)

	match part.part:
		TextPart:
			text: LiteralId = builder.interpolation_text_at(part.text.first)
			builder
				.append_literal_leaf_node(InterpolationTextLeaf, span, text)
				.push_last_node()
		HolePart:
			builder.parse_interpolation_hole(scope, source, part)


---
Lexes one hole, parses it as a single expression, and pushes it under an
`InterpolationHoleNode` spanning the whole `${...}`. The hole node's extent is
the hole's identity apart from its expression's: Core lowering gives the call
that converts the value to text that location, which no other node shares.
---
private pure func parse_interpolation_hole(
	builder: DiscoveryBuilder,
	scope: BodyScope,
	source: SourceId,
	hole: InterpolationPartRow,
) -> DiscoveryBuilder:
	hole_start: Int = builder.token_count()
	anchor: Span = pack_span(source, hole.start, hole.start)
	out: DiscoveryBuilder = builder
		.lex_interpolation_hole(source, hole.start, hole.end)
		.move_token_cursor(hole_start)
		.parse_assignment_value(scope, anchor)
		.push_last_node()
		.skip_newlines()

	checked: DiscoveryBuilder = if not out.at(EndOfFileToken):
		out.report_at_current(InterpolationHoleNotExpressionDiagnostic)
	else:
		out

	hole_span: Span = pack_span(
		source,
		hole.start - INTERPOLATION_HOLE_OPENER_WIDTH,
		hole.end + INTERPOLATION_HOLE_CLOSER_WIDTH,
	)
	checked
		.append_plain_parent_node_from_stack(InterpolationHoleParent, hole_span, 1)
		.push_last_node()
