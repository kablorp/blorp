-- Trait method heads stop at their default-body entry. M4 owns
-- body trees and expression diagnostics; these previews mint no method IDs.
import:
	../syntax/declarations: Signature
	../syntax/diagnostics: SyntaxDiagnostic(Plain)
	../tables/diagnostic_code: PlainSyntaxCode(MissingFunctionBodyDiagnostic)
	../tables/expected_token:
		ExpectedTokenDiagnostic(ExpectedKeyword), KeywordConstruct(KeywordInTraitMethodName),
		NameConstruct(NameInTraitMethodName), LeftParenConstruct(LeftParenInTraitMethodName)
	../tables/row_kinds: Purity(PureFunction, ImpureFunction)
	../tables/span: Span, span_covering
	../tables/token: TokenKind(PureKeyword, FuncKeyword, ArrowSymbol, ColonSymbol)
	parse_state:
		ParseState, diagnostic_count, current_kind, current_span, advanced,
		expect_token, consume_declared_name, report_diagnostic
	tree_parameter_parser: ParametersParse(ParsedParameters), parse_parenthesized_parameters
	tree_type_parser: parse_type
	tree_function_header_parser:
		recover_rejected_function_body, function_body_follows


record TraitMethodHeader {
	signature: Signature,
	span: Span
}


fixed union MethodBodyPresence:
	AbstractMethod
	DefaultBodyFollows


record TraitMethodHead {
	header: TraitMethodHeader,
	body_presence: MethodBodyPresence
}


union TraitMethodHeadParse:
	ParsedTraitMethodHead(TraitMethodHead)
	RejectedTraitMethodHead


pure func parse_trait_method_head(state: ParseState) -> (ParseState, TraitMethodHeadParse):
	before: Int = state.diagnostic_count()
	start: Span = state.current_span()
	purity: Purity = if state.current_kind() == PureKeyword:
		PureFunction
	else:
		ImpureFunction
	before_keyword: ParseState = if purity == PureFunction:
		state.advanced()
	else:
		state
	keyword: Span = before_keyword.current_span()
	before_name: ParseState = before_keyword.expect_token(FuncKeyword, ExpectedKeyword(KeywordInTraitMethodName))
	name_position: Span = before_name.current_span()
	(after_name, name) = before_name.consume_declared_name(NameInTraitMethodName)
	(after_parameters, parameters) = parse_parenthesized_parameters(after_name, LeftParenInTraitMethodName)
	(after_return, return_type) = if after_parameters.current_kind() == ArrowSymbol:
		(parsed, written) = parse_type(after_parameters.advanced())
		(parsed, Some(written))
	else:
		(after_parameters, None)
	header_end: Span = match return_type:
		Some(written):
			written.span
		None:
			name_position

	var out: ParseState = after_return
	var body_presence: MethodBodyPresence = AbstractMethod

	-- An authored colon promises a body. The shared token predicate decides
	-- whether one follows; a successful head leaves its tokens unread.
	if out.current_kind() == ColonSymbol:
		out = out.advanced()
		if out.function_body_follows():
			body_presence = DefaultBodyFollows
		else:
			out = out.report_diagnostic(name_position, Plain(MissingFunctionBodyDiagnostic))

	if out.diagnostic_count() != before:
		recovered = if body_presence == DefaultBodyFollows:
			recover_rejected_function_body(out, start)
		else:
			out
		(recovered, RejectedTraitMethodHead)
	else:
		match (name, parameters):
			(Some(name), ParsedParameters(parameters, _)):
				(out, ParsedTraitMethodHead({
					header = {
						signature = { purity = purity, keyword = keyword, name = name, parameters = parameters, return_type = return_type },
						span = start.span_covering(header_end)
					},
					body_presence = body_presence
				}))
			_:
				(out, RejectedTraitMethodHead)
