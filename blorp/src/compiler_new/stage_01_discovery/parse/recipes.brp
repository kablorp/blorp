-- The ID-free recipes of the M4 expression and body grammars. Recognition
-- builds recipes only, and minting turns a complete recipe into syntax with
-- ids in source order. An expression may hold a control expression, which holds
-- blocks, which hold statements, which hold expressions, so these types are
-- mutually recursive and share one module.
import:
	../syntax/checked_values: DecimalFloat
	../syntax/expressions: CompoundOperator(AddAssign, SubtractAssign, MultiplyAssign, DivideAssign), CountParameter, InterpolationForm(QuotedInterpolation, PipeInterpolation), UnaryOperator(Negate, LogicalNot)
	../syntax/names: WrittenName
	../syntax/patterns: StringForm(QuotedString, RawString, PipeString, RawPipeString)
	../syntax/sequences: AtLeastOne, SmallTuple
	../tables/row_kinds: Purity
	../tables/span: Span
	binary_operators as Operators


-- Recipes retain only authored syntax and checked values, never parser IDs.
-- Statements, blocks and control expressions hold expression recipes and
-- expressions hold control recipes, so all of them live here: the two parsers
-- may then import each other for functions without a cycle in the types.
record ExpressionRecipe {
	span: Span,
	kind: RecipeKind
}


-- `name = value` in a record literal or update, before any ID exists.
record RecordFieldRecipe {
	name: WrittenName,
	value: ExpressionRecipe,
	span: Span
}


-- `key => value` in a dict literal, before any ID exists.
record EntryRecipe {
	key: ExpressionRecipe,
	value: ExpressionRecipe,
	span: Span
}


union RecipeKind:
	NameRecipe(WrittenName)
	IntegerRecipe(Int128)
	FloatRecipe(DecimalFloat)
	StringRecipe(StringForm, String)
	InterpolatedRecipe(InterpolationForm, List[InterpolationPieceRecipe])
	CharacterRecipe(Char)
	BooleanRecipe(Bool)
	VoidRecipe
	UnaryRecipe(UnaryOperator, ExpressionRecipe)
	BinaryRecipe(Operators.BinaryOperator, ExpressionRecipe, ExpressionRecipe)
	GroupingRecipe(ExpressionRecipe)
	CallRecipe(ExpressionRecipe, List[ExpressionRecipe])
	FieldRecipe(ExpressionRecipe, WrittenName)
	SubscriptRecipe(ExpressionRecipe, AtLeastOne[ExpressionRecipe])
	ListRecipe(List[ExpressionRecipe])
	TupleRecipe(SmallTuple[ExpressionRecipe])
	VectorRecipe(AtLeastOne[ExpressionRecipe])
	RecordRecipe(List[RecordFieldRecipe])
	UpdateRecipe(ExpressionRecipe, AtLeastOne[RecordFieldRecipe])
	DictRecipe(AtLeastOne[EntryRecipe])
	ControlValueRecipe(ControlRecipe)
	DetachRecipe(ExpressionRecipe)
	LambdaAtomRecipe(LambdaRecipe)


-- A text piece, or a hole whose expression is still a recipe.
union InterpolationPieceRecipe:
	TextPieceRecipe(String)
	HolePieceRecipe(Span, ExpressionRecipe)


-- An `if` or a `match` used as an expression. The frozen grammar has no
-- one-line form, so both are block-shaped and end on a dedent.
union ControlRecipe:
	ConditionalControl(ConditionalRecipe)
	MatchControl(MatchRecipe)
	SelectControl(SelectRecipe)


-- A written type, replayed at minting from the token it starts at.
record TypeRecipe {
	token: Int
}


-- A pattern, replayed at minting from its first token.
record PatternRecipe {
	token: Int
}


record StatementRecipe {
	span: Span,
	kind: StatementRecipeKind
}


union StatementRecipeKind:
	ExpressionStatementRecipe(ExpressionRecipe)
	LoopExitRecipe(LoopExit)
	ConditionalStatementRecipe(ConditionalRecipe)
	MatchStatementRecipe(MatchRecipe)
	SelectStatementRecipe(SelectRecipe)
	WithStatementRecipe(WithRecipe)
	ConcurrentStatementRecipe(ConcurrentRecipe)
	DebugStatementRecipe(DebugRecipe)
	VariableRecipe(WrittenName, Option[TypeRecipe], ExpressionRecipe)
	TypedBindingRecipe(WrittenName, TypeRecipe, ExpressionRecipe)
	QuestionBindingRecipe(WrittenName, Option[TypeRecipe], ExpressionRecipe)
	AssignmentRecipe(AssignmentTargetRecipe, ExpressionRecipe)
	CompoundAssignmentRecipe(WrittenName, CompoundOperator, ExpressionRecipe)
	SubscriptAssignmentRecipe(SubscriptPlaceRecipe, ExpressionRecipe)
	WhileRecipe(ExpressionRecipe, BlockRecipe)
	ForRecipe(LoopBindingRecipe, ExpressionRecipe, BlockRecipe)
	LocalFunctionRecipe(LocalFunctionBody)


enum LoopExit:
	ExitWithBreak
	ExitWithContinue


union AssignmentTargetRecipe:
	NamedTargetRecipe(WrittenName)
	DiscardedTargetRecipe(Span)


-- A binding position that may discard.
union BinderRecipe:
	BindsNameRecipe(WrittenName)
	DiscardsRecipe(Span)


-- `for x in` / `for _ in`, or `for (a, b) in` with the parenthesized span.
union LoopBindingRecipe:
	LoopVariableRecipe(BinderRecipe)
	LoopTupleRecipe(SmallTuple[BinderRecipe], Span)


record SubscriptPlaceRecipe {
	span: Span,
	collection: ExpressionRecipe,
	indices: AtLeastOne[ExpressionRecipe]
}


record BlockRecipe {
	statements: AtLeastOne[StatementRecipe]
}


-- An `if` and its `else` chain, flat: the chain's length is a list's length,
-- never a nesting of recipes.
record ConditionalRecipe {
	head: IfLink,
	else_ifs: List[ElseIfLink],
	final_else: Option[ElseBlockRecipe]
}


record IfLink {
	keyword: Span,
	condition: ExpressionRecipe,
	then_block: BlockRecipe
}


record ElseIfLink {
	else_keyword: Span,
	link: IfLink
}


record ElseBlockRecipe {
	keyword: Span,
	block: BlockRecipe
}


-- `end` is the closing dedent's span, which the expression's own span
-- reaches (the frozen parser's rule).
record MatchRecipe {
	keyword: Span,
	scrutinee: ExpressionRecipe,
	cases: AtLeastOne[CaseRecipe],
	end: Span
}


record CaseRecipe {
	pattern: PatternRecipe,
	body: CaseBodyRecipe
}


union CaseBodyRecipe:
	CaseBlockRecipe(BlockRecipe)
	CaseStatementRecipe(StatementRecipe)


-- A local function: its header is replayed from the token it starts at, so its
-- ids follow its neighbours', and its own body is a recipe read once.
record LocalFunctionBody {
	keyword_token: Int,
	start: Span,
	purity: Purity,
	body: BodyRecipe
}


-- A lambda before minting: parameters and return type replay from their
-- tokens, and the body is a recipe. `span` runs from `func` or `pure` to the
-- end of the body.
record LambdaRecipe {
	purity: Purity,
	parameters: List[LambdaParameterRecipe],
	return_type: Option[TypeRecipe],
	body: BodyRecipe,
	span: Span
}


record LambdaParameterRecipe {
	binder: BinderRecipe,
	declared_type: Option[TypeRecipe]
}


-- A body before minting: an indented block, or an expression on the `:` line.
union BodyRecipe:
	BlockBodyRecipe(BlockRecipe)
	ExpressionBodyRecipe(ExpressionRecipe)


-- An arm of a `select`: what it waits for, and the block it runs.
record SelectArmRecipe {
	kind: SelectArmRecipeKind,
	body: BlockRecipe,
	span: Span
}


union SelectArmRecipeKind:
	ReceiveArmRecipe(BinderRecipe, ExpressionRecipe)
	SealedArmRecipe(ExpressionRecipe)
	AfterArmRecipe(ExpressionRecipe)


-- `end` is the closing dedent's span, which the expression's own span reaches
-- (the frozen parser's rule, as for `match`).
record SelectRecipe {
	keyword: Span,
	arms: AtLeastOne[SelectArmRecipe],
	end: Span
}


-- `with r [: T] = v:` and `with r [: T] ?= v [on e => mapped]:`, before the block.
record WithHeader {
	binder: BinderRecipe,
	declared: Option[TypeRecipe],
	acquisition: AcquisitionRecipe
}


union AcquisitionRecipe:
	ValueAcquisitionRecipe(ExpressionRecipe)
	TryAcquisitionRecipe(ExpressionRecipe, Option[ErrorMapRecipe])


enum WithOperator:
	AcquireWithValue
	AcquireWithTry


-- `on e => mapped`: its span starts at the binder, as the frozen parser's does.
record ErrorMapRecipe {
	binder: BinderRecipe,
	value: ExpressionRecipe,
	span: Span
}


record WithRecipe {
	keyword: Span,
	header: WithHeader,
	body: BlockRecipe
}


-- A `timeout` parameter keeps its value as a recipe until minting.
record TimeoutRecipe {
	value: ExpressionRecipe,
	name_span: Span,
	span: Span
}


-- A count parameter holds only a checked literal, so it is already the syntax
-- node and mints no id.
record ConcurrentParameters {
	max_threads: Option[CountParameter],
	timeout: Option[TimeoutRecipe]
}


record ConcurrentRecipe {
	keyword: Span,
	parameters: ConcurrentParameters,
	body: BlockRecipe
}


record DebugRecipe {
	keyword: Span,
	body: BlockRecipe
}
