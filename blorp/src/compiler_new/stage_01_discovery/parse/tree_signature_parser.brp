-- Reusable callable signature grammar; callers own names and bodies.
import:
	../syntax/declarations: Signature
	../syntax/names: WrittenName
	../tables/expected_token: LeftParenConstruct
	../tables/row_kinds: Purity
	../tables/span: Span
	../tables/token: TokenKind(ArrowSymbol)
	parse_state: ParseState, diagnostic_count, current_kind, advanced
	tree_parameter_parser: ParametersParse(ParsedParameters, RejectedParameters), parse_parenthesized_parameters
	tree_type_parser: parse_type


union SignatureParse:
	ParsedSignature(Signature, Span)
	RejectedSignature


pure func parse_signature(state: ParseState, purity: Purity, keyword: Span, name: WrittenName, construct: LeftParenConstruct) -> (ParseState, SignatureParse):
	before: Int = state.diagnostic_count()
	(after_parameters, parameters) = parse_parenthesized_parameters(state, construct)

	match parameters:
		RejectedParameters:
			(after_parameters, RejectedSignature)
		ParsedParameters(parameters, closing):
			if after_parameters.current_kind() == ArrowSymbol:
				(after_return, return_type) = parse_type(after_parameters.advanced())

				if after_return.diagnostic_count() != before:
					(after_return, RejectedSignature)
				else:
					(after_return, ParsedSignature({ purity = purity, keyword = keyword, name = name, parameters = parameters, return_type = Some(return_type) }, return_type.span))
			else:
				(after_parameters, ParsedSignature({ purity = purity, keyword = keyword, name = name, parameters = parameters, return_type = None }, closing))
