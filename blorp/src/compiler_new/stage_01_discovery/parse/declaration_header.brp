-- What precedes a declaration, and the definition rows every declaration
-- opens and closes.
--
-- Shared by the declaration parser and the body parser, which declares local
-- functions with the same routines.
import:
	../tables/builder:
		DiscoveryBuilder,
		advance_token,
		append_annotation,
		append_definition,
		append_documentation,
		append_pending_annotation,
		append_plain_diagnostic,
		pending_annotation_at,
		pending_annotation_count,
		pending_docstring_at,
		replace_definition_row,
	../tables/diagnostic_code:
		PlainSyntaxCode(AnnotationArgumentsDiagnostic),
		SyntaxDiagnostic(UnknownAnnotation),
	../tables/expected_token: NameConstruct(NameInAnnotationName)
	../tables/ids: DefinitionId, LiteralId, ModuleId, NameId, name_id_index
	../tables/name_vocabulary:
		DEBUG_ONLY_NAME_INDEX,
		NO_COPY_NAME_INDEX,
		RESOURCE_RESULT_ORDINARY_NAME_INDEX,
		TAIL_RECURSIVE_NAME_INDEX,
	../tables/row_kinds:
		DefinitionKind(
			ForeignFunctionDefinition, FunctionDefinition, ImplMethodDefinition,
			LocalFunctionDefinition,
		),
		FunctionAnnotation(
			DebugOnlyAnnotation, NoCopyAnnotation, ResourceResultOrdinaryAnnotation,
			TailRecursiveAnnotation,
		),
		Purity(ImpureFunction),
		Visibility(PublicVisibility),
	../tables/rows: AnnotationRow, EMPTY_ROW_RANGE, PendingAnnotationRow, RowRange
	../tables/span: Span, span_covering
	../tables/token:
		TokenKind(AtSymbol, EndOfFileToken, LeftParenSymbol, NewlineToken, RightParenSymbol),
	parser_cursor:
		at,
		consume_referenced_name,
		current_name,
		current_span,
		report_at_current,
		skip_newlines,


---
What precedes a declaration's keyword: where the declaration starts, its
visibility and purity, its docstring, and its annotations as a block of the
builder's transient `pending_annotations`, and its docstring as a block of
at most one row of the transient `pending_docstrings`. A plain struct, so a
header costs no allocation.
---
struct DeclarationHeader {
	module: ModuleId,
	start: Span,
	visibility: Visibility,
	purity: Purity,
	docstring: RowRange,
	annotations: RowRange
}


---
A member's or local function's header: it starts at `start`, is public,
impure, and has no docstring or annotations of its own. `annotation_row` is
where an empty annotation block sits (the current pending count).
---
pure func plain_header(module: ModuleId, start: Span, annotation_row: Int) -> DeclarationHeader:
	{
		module = module,
		start = start,
		visibility = PublicVisibility,
		purity = ImpureFunction,
		docstring = EMPTY_ROW_RANGE,
		annotations = {
			first = annotation_row,
			count = 0
		}
	}


-- Annotations.
---
The annotation a name denotes, when the language defines one.
---
pure func annotation_named(name: NameId) -> Option[FunctionAnnotation]:
	index: Int = name.name_id_index()

	if index == TAIL_RECURSIVE_NAME_INDEX:
		Some(TailRecursiveAnnotation)
	else if index == NO_COPY_NAME_INDEX:
		Some(NoCopyAnnotation)
	else if index == DEBUG_ONLY_NAME_INDEX:
		Some(DebugOnlyAnnotation)
	else if index == RESOURCE_RESULT_ORDINARY_NAME_INDEX:
		Some(ResourceResultOrdinaryAnnotation)
	else:
		None


---
Consumes the annotations at the cursor, appending each one the language
defines to the transient `pending_annotations` and reporting unknown names and
argument lists. The annotations read are the pending rows from
`pending_annotation_count` before the call to the count after it.
---
pure func consume_annotations(builder: DiscoveryBuilder, allow_newlines: Bool) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = builder

	while out.at(AtSymbol):
		out = out.consume_annotation(allow_newlines)

	out


---
One `@name`, any argument list, and with `allow_newlines` the newlines after
it.
---
private pure func consume_annotation(
	builder: DiscoveryBuilder,
	allow_newlines: Bool,
) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = builder.advance_token()
	name: Option[NameId] = out.current_name()
	name_span: Span = out.current_span()
	out = out.consume_referenced_name(NameInAnnotationName)

	match name:
		Some(annotation_name):
			match annotation_name.annotation_named():
				Some(annotation):
					out = out.append_pending_annotation({
						annotation = annotation,
						span = name_span,
					})
				None:
					out = out.append_syntax_diagnostic(
						name_span,
						UnknownAnnotation(annotation_name),
					)
		None:
			void

	if out.at(LeftParenSymbol):
		out = out.report_at_current(AnnotationArgumentsDiagnostic)
		out = out.advance_token()

		while (
			not out.at(RightParenSymbol)
			and not out.at(NewlineToken)
			and not out.at(EndOfFileToken)
		):
			out = out.advance_token()

		if out.at(RightParenSymbol):
			out = out.advance_token()

	if allow_newlines:
		out = out.skip_newlines()

	out


---
The pending annotations from row `first` to the end of the table.
---
pure func annotations_since(builder: DiscoveryBuilder, first: Int) -> RowRange:
	{
		first = first,
		count = builder.pending_annotation_count() - first
	}


-- Definition rows.
---
Appends `definition`'s row with the span known so far; the parse routine
replaces it with the final span at the end.
---
pure func open_definition(
	builder: DiscoveryBuilder,
	header: DeclarationHeader,
	kind: DefinitionKind,
	name: NameId,
	name_span: Span,
) -> DiscoveryBuilder:
	builder.append_definition({
		module = header.module,
		kind = kind,
		name = name,
		name_span = name_span,
		visibility = header.visibility,
		span = header.start.span_covering(name_span),
	})


---
Closes `definition` with its final span and records the header's docstring
and annotations.
---
pure func close_definition(
	builder: DiscoveryBuilder,
	definition: DefinitionId,
	header: DeclarationHeader,
	kind: DefinitionKind,
	name: NameId,
	name_span: Span,
	end: Span,
) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = builder.replace_definition_row(
		definition,
		{
			module = header.module,
			kind = kind,
			name = name,
			name_span = name_span,
			visibility = header.visibility,
			span = header.start.span_covering(end)
		},
	)

	if header.docstring.count > 0:
		text: LiteralId = out.pending_docstring_at(header.docstring.first)
		out = out.append_documentation({
			definition = definition,
			text = text,
		})

	out.record_annotations(definition, header.annotations, kind)


---
Copies the header's pending annotations to `definition`. Only functions
carry annotations; on any other declaration they were reported
(`AnnotationWithoutFunctionDiagnostic`) and are dropped.
---
private pure func record_annotations(
	builder: DiscoveryBuilder,
	definition: DefinitionId,
	annotations: RowRange,
	kind: DefinitionKind,
) -> DiscoveryBuilder:
	if annotations.count == 0 or not kind.takes_annotations():
		builder
	else:
		builder.record_annotation_rows(definition, annotations)


---
The annotation rows of a non-empty block.
---
private pure func record_annotation_rows(
	builder: DiscoveryBuilder,
	definition: DefinitionId,
	annotations: RowRange,
) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = builder
	var index: Int = annotations.first

	while index < annotations.first + annotations.count:
		row: AnnotationRow = out.annotation_row(definition, index)
		out = out.append_annotation(row)
		index += 1

	out


private pure func annotation_row(
	builder: DiscoveryBuilder,
	definition: DefinitionId,
	pending_index: Int,
) -> AnnotationRow:
	pending: PendingAnnotationRow = builder.pending_annotation_at(pending_index)
	{
		definition = definition,
		annotation = pending.annotation,
		span = pending.span
	}


pure func takes_annotations(kind: DefinitionKind) -> Bool:
	match kind:
		FunctionDefinition | ImplMethodDefinition | ForeignFunctionDefinition | LocalFunctionDefinition:
			True
		_:
			False
