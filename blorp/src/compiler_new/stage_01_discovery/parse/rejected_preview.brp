-- A rejection owns all information referenced by its surviving diagnostics.
-- Definitions are the mint's original index, including fields of declarations
-- whose tree was rejected. Never reconstruct them from names or source text.
import:
	../lex/lexed_module: LexedSource
	../syntax/definitions: Definition
	../syntax/diagnostics: SyntaxDiagnosticAt
	../syntax/spellings: Spellings
	../tables/ids: ModuleId
	parse_state:
		ParseInputError(EmptyRejection),
		ParseState,
		diagnostics,
		issued_ids,
		parse_line_starts,
		parse_module,
		parse_source,
		spellings,


opaque type RejectedPreview = RejectedContents


private record RejectedContents {
	module: ModuleId,
	source: LexedSource,
	line_starts: List[Int],
	spellings: Spellings,
	definitions: List[Definition],
	diagnostics: List[SyntaxDiagnosticAt]
}


pure func reject_preview(state: ParseState) -> Result[RejectedPreview, ParseInputError]:
	if (
		state
			.diagnostics()
			.is_empty()
	):
		Err(EmptyRejection)
	else:
		Ok(into_opaque RejectedPreview({
					module = state.parse_module(),
					source = state.parse_source(),
					line_starts = state.parse_line_starts(),
					spellings = state.spellings(),
					definitions = state.issued_ids().definitions,
					diagnostics = state.diagnostics()
				}))


pure func rejected_diagnostics(rejected: RejectedPreview) -> List[SyntaxDiagnosticAt]:
	from_opaque RejectedPreview(rejected).diagnostics


pure func rejected_definitions(rejected: RejectedPreview) -> List[Definition]:
	from_opaque RejectedPreview(rejected).definitions


pure func rejected_spellings(rejected: RejectedPreview) -> Spellings:
	from_opaque RejectedPreview(rejected).spellings


pure func rejected_module(rejected: RejectedPreview) -> ModuleId:
	from_opaque RejectedPreview(rejected).module


pure func rejected_source(rejected: RejectedPreview) -> LexedSource:
	from_opaque RejectedPreview(rejected).source


pure func rejected_line_starts(rejected: RejectedPreview) -> List[Int]:
	from_opaque RejectedPreview(rejected).line_starts
