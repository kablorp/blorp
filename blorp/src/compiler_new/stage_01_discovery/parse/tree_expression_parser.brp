-- Direct post-order parsing. Unsupported input returns the saved persistent
-- entry; rejected expressions retain diagnostics but discard trial ids.
import:
	dict: dict, get, set
	../lex/lexed_module: LiteralValue(IntegerValue, FloatValue, TextValue), HoleScan, ScannedPiece(ScannedText, ScannedHole)
	../syntax/expressions:
		Expression, Hole, SubscriptPlace, Body(BlockBody), ExpressionKind(If, Match, Select, Lambda, NameReference, IntegerLiteral, FloatLiteral, StringLiteral, InterpolatedString, BooleanLiteral, CharacterLiteral, VoidValue, Unary, Binary, ShortCircuit, RangeExpression, Call, FieldAccess, Subscript, ListLiteral, TupleLiteral, VectorLiteral, RecordLiteral, RecordUpdate, DictLiteral, Detach, OpaqueConversion, CompilerBuiltin),
		InterpolationForm(QuotedInterpolation, PipeInterpolation), InterpolationPiece(InterpolationText, InterpolationHole),
		NamedValue, DictEntry,
		OpaqueDirection(IntoOpaque, FromOpaque),
		UnaryOperator(Negate, LogicalNot),
		BinaryOperator(Add, Subtract, Multiply, Divide, Modulo, Equal, NotEqual, Less, LessEqual, Greater, GreaterEqual),
		LogicalOperator(LogicalAnd, LogicalOr)
	-- Expressions and bodies call each other for controls and lambdas;
	-- their completed recursive syntax types belong to syntax/expressions.
	tree_body_parser: BodyContext(OutsideLoop, InsideLoop), LambdaParse(ParsedLambda, UnsupportedLambda), parse_lambda, parse_control
	../syntax/ids: SpellingId
	../syntax/sequences: AtLeastOne, SmallTuple(Pair, Triple, Quadruple), at_least_one_items
	../syntax/diagnostics: SyntaxDiagnostic(Plain, DuplicateFieldGiven)
	../syntax/patterns: StringForm(QuotedString, RawString, PipeString, RawPipeString)
	../tables/diagnostic_code: PlainSyntaxCode(ExpectedExpressionDiagnostic, SingletonTupleDiagnostic, TupleArityDiagnostic, ExpectedBuiltinNameDiagnostic)
	../tables/expected_token:
		NameConstruct(NameInStatementName, NameInFieldName, NameInRecordFieldName), ExpectedTokenDiagnostic(ExpectedLeftParen, ExpectedRightParen, ExpectedRightBracket, ExpectedRightBrace),
		RightParenConstruct(RightParenInGroupedExpression, RightParenInCallArguments, RightParenInTupleExpression, RightParenInOpaqueConversionValue, RightParenInBuiltinName),
		LeftParenConstruct(LeftParenInOpaqueConversionType),
		RightBracketConstruct(RightBracketInSubscript, RightBracketInListLiteral),
		RightBraceConstruct(RightBraceInRecordLiteral, RightBraceInRecordUpdate, RightBraceInDictLiteral, RightBraceInVectorLiteral)
	../tables/span: Span, span_covering
	../tables/token:
		TokenKind(IdentifierToken, FuncKeyword, PureKeyword, IntLiteralToken, FloatLiteralToken, NormalStringToken, RawStringToken, PipeStringToken, RawPipeStringToken,
			InterpolatedStringToken, InterpolatedPipeStringToken, CharLiteralToken, TrueKeyword, FalseKeyword, VoidKeyword, UnderscoreSymbol,
			MinusSymbol, NotKeyword, DetachKeyword, LeftParenSymbol, RightParenSymbol, LeftBracketSymbol, RightBracketSymbol, LeftBraceSymbol, RightBraceSymbol, FatArrowSymbol, PipeSymbol, EqualSymbol, CommaSymbol,
			EndOfFileToken, NewlineToken, IndentToken, DedentToken, DotSymbol, IfKeyword, MatchKeyword, AsKeyword, IntoOpaqueKeyword, FromOpaqueKeyword, BuiltinKeyword, AfterKeyword, SealedKeyword, FromKeyword, DebugKeyword)
	binary_operators as Operators
	stop_reason:
		StopPoint, rejected_stop, Recognition(Recognized, Declined), StopReason(NestingTooDeep, IndentedContinuation, OperandOnNextLine, MemberNameOnNextLine, UnexpectedTokenInBrackets, MissingDictArrow, TrailingCommaAtEndOfSource,
			InterpolationHoleNotLexed, InterpolationHoleTrailingTokens, InterpolationHoleRejected, MalformedTokenPayload),
		Boundary(AtBoundary, PastBoundary), stop_at, expression_boundary, expression_start_reason
	layout_quirks: BlockAnchor(PastExpressionAnchor), ExpressionAnchor, anchored_at
	tree_type_parser: parse_type
	token_cursor: is_soft_keyword
	parse_state:
		ParseState, rejected_trial, diagnostic_count, current_kind, current_token, current_span, current_literal, current_interpolation, current_builtin_marker_text, advanced, peek_kind,
		consume_referenced_name, consume_name, NameRole(ExpressionName), finished_name_use, finished_expression, finished_subscript_place, finished_hole, report_at_current, report_and_recover, report_diagnostic, report_unreachable_input, expect_token, entered_hole, left_hole, nested


union ExpressionParse:
	ParsedExpression(Expression)
	UnsupportedExpression(StopPoint)
	RejectedExpression


-- Completed syntax plus authored facts that grouping erases from the AST.
record ExpressionValue {
	expression: Expression,
	root: ExpressionRoot,
	tail: OperandEnding,
	keeps_name_span: Bool
}


fixed union ExpressionRoot:
	NameRoot
	SubscriptRoot
	TupleRoot
	FieldRoot
	GroupedRoot
	OtherRoot


fixed union OperandEnding:
	PlainOperand
	ControlOperand
	BlockLambdaOperand


union ValueParse:
	ParsedValue(ExpressionValue)
	UnsupportedValue(StopPoint)
	RejectedValue


-- Only the outer prefix/postfix of an expression statement may finish a
-- subscript as a place. Every nested expression uses ValueContext.
private fixed union ExpressionContext:
	ValueContext
	StatementContext


union StatementHeadParse:
	ParsedStatementValue(ExpressionValue)
	ParsedSubscriptPlace(SubscriptPlace)
	UnsupportedStatementHead(StopPoint)
	RejectedStatementHead


private union PostfixStep:
	ExtendedPostfix(ExpressionValue)
	CompletedPlace(SubscriptPlace)
	StoppedPostfix
	AbandonedPostfix(Abandonment)


-- The brackets of a postfix step: a list literal is an atom, never a step.
private fixed union PostfixDelimiter:
	CallDelimiter
	SubscriptDelimiter


-- The bracket pair around a comma-separated item list.
private union ItemDelimiter:
	PostfixItems(PostfixDelimiter)
	ListItems
	TupleItems
	BracedItems(BracedForm)


-- The four forms a `{` opens, each with its own missing-brace diagnostic.
private fixed union BracedForm:
	RecordForm
	UpdateForm
	DictForm
	VectorForm


-- A rejected or unsupported list is abandoned whole: only a list that read to
-- its end carries items.
private union ItemsParse[T]:
	ParsedItems(T)
	UnsupportedItems(StopPoint)
	RejectedItems


-- The closing bracket, consumed, with its span.
private union ClosingParse:
	ClosedAt(Span)
	NotClosed(Abandonment)


-- Why recognition gave up. An unsupported shape restores the caller's entry
-- state and says which shape it was; a rejected shape keeps the diagnostics it
-- reported.
private union Abandonment:
	UnsupportedShape(StopPoint)
	RejectedShape


-- One step of a left-to-right chain. Only an extending step carries a value,
-- so a chain that stops or is abandoned cannot also claim a longer result.
private union ChainStep[T]:
	Extended(T)
	Stopped
	Abandoned(Abandonment)


-- A consumed continuation dedent ends this expression even when its sibling
-- starts with an operator token. This is transient parse evidence.
fixed union ExpressionEnding:
	AtExpressionToken
	AfterContinuationDedent


private fixed union ContinuedField:
	NoContinuedField
	HasContinuedField


-- The frozen statement reader repairs one leaked chain indent for a binary
-- whose left contains a continued field, or whose right needs the same repair.
-- Unary wrapping deliberately does not carry this evidence.
private fixed union ContinuationRepair:
	NoContinuationRepair
	RepairOneContinuationDedent


private record ExpressionProgress {
	value: ExpressionValue,
	continuation_indents: Int,
	ending: ExpressionEnding,
	continued_field: ContinuedField,
	repair: ContinuationRepair
}


private union ExpressionRead:
	ReadExpression(ExpressionProgress)
	ReadPlace(SubscriptPlace)
	UnreadExpression(Abandonment)


-- Parse one value, leaving its caller to check the boundary.
pure func parse_expression(state: ParseState, anchor: ExpressionAnchor) -> (ParseState, ExpressionParse):
	(parsed, value, _) = parse_scoped_expression(state, anchor, OutsideLoop)
	match value:
		ParsedValue(read): (parsed, ParsedExpression(read.expression))
		UnsupportedValue(stop): (state, UnsupportedExpression(stop))
		RejectedValue: (state.rejected_trial(parsed), RejectedExpression)


pure func parse_scoped_expression(state: ParseState, anchor: ExpressionAnchor, loop_context: BodyContext) -> (ParseState, ValueParse, ExpressionEnding):
	(read, result) = read_operators(state, Operators.LOWEST_PRECEDENCE, anchor, ValueContext, loop_context)
	finish_expression_read(read, result)


pure func parse_statement_head(state: ParseState, anchor: ExpressionAnchor, loop_context: BodyContext) -> (ParseState, StatementHeadParse, ExpressionEnding):
	(read, result) = read_operators(state, Operators.LOWEST_PRECEDENCE, anchor, StatementContext, loop_context)
	match result:
		ReadPlace(place): (read, ParsedSubscriptPlace(place), AtExpressionToken)
		_:
			(parsed, value, ending) = finish_expression_read(read, result)
			match value:
				ParsedValue(value): (parsed, ParsedStatementValue(value), ending)
				UnsupportedValue(stop): (state, UnsupportedStatementHead(stop), ending)
				RejectedValue: (parsed, RejectedStatementHead, ending)


-- Prefix and binary parents retain the last operand's consumed block dedent;
-- grouping resets it. The syntax root cannot recover this authored boundary.
pure func ends_in_block_lambda(value: ExpressionValue) -> Bool:
	value.tail == BlockLambdaOperand


-- A completed block leaves the next statement/declaration token at the cursor.
-- Binary followers remain unsupported here; `as` and `=` are removed forms.
pure func block_expression_ends(kind: TokenKind) -> Bool:
	kind != AsKeyword and kind != EqualSymbol and Operators.binary_operator(kind).is_none()


pure func block_operand_ends(ending: ExpressionEnding, tail: OperandEnding, follower: TokenKind) -> Bool:
	ending == AfterContinuationDedent or tail == ControlOperand or (tail == BlockLambdaOperand and block_expression_ends(follower))


pure func parse_expression_to_boundary(state: ParseState, anchor: ExpressionAnchor) -> (ParseState, ExpressionParse):
	(parsed, result, ending) = parse_scoped_expression(state, anchor, OutsideLoop)
	match result:
		UnsupportedValue(stop): (state, UnsupportedExpression(stop))
		RejectedValue: (state.rejected_trial(parsed), RejectedExpression)
		ParsedValue(value):
			boundary: Boundary = if block_operand_ends(ending, value.tail, parsed.current_kind()):
				AtBoundary
			else:
				parsed.expression_boundary()
			match boundary:
				PastBoundary(stop): (state, UnsupportedExpression(stop))
				AtBoundary: (parsed, ParsedExpression(value.expression))


-- Finished children, not a recognition tree. Grouping changes authored facts
-- without creating another expression identity.
private pure func expression_value(expression: Expression) -> ExpressionValue:
	root: ExpressionRoot = match expression.kind:
		NameReference(_): NameRoot
		Subscript(_, _): SubscriptRoot
		TupleLiteral(_): TupleRoot
		FieldAccess(_, _): FieldRoot
		_: OtherRoot
	tail: OperandEnding = match expression.kind:
		If(_) | Match(_, _) | Select(_): ControlOperand
		Lambda(lambda):
			match lambda.body:
				BlockBody(_): BlockLambdaOperand
				_: PlainOperand
		_: PlainOperand
	{ expression = expression, root = root, tail = tail, keeps_name_span = root == NameRoot }


private pure func finished_value(state: ParseState, span: Span, kind: ExpressionKind) -> (ParseState, ValueParse):
	(minted, expression) = state.finished_expression(span, kind)
	(minted, ParsedValue(expression_value(expression)))


private pure func value_span(value: ExpressionValue) -> Span:
	value.expression.span


private pure func parse_operators(state: ParseState, minimum: Int, anchor: ExpressionAnchor, loop_context: BodyContext) -> (ParseState, ValueParse):
	(read, result) = read_operators(state, minimum, anchor, ValueContext, loop_context)
	(parsed, written, _) = finish_expression_read(read, result)
	(parsed, written)


-- Precedence climbing retains chain-owned indentation across binary tails.
-- The outer expression closes it after its right operand, never by inspecting
-- expression spans or reconstructing whether a field crossed a source line.
private pure func read_operators(state: ParseState, minimum: Int, anchor: ExpressionAnchor, context: ExpressionContext, loop_context: BodyContext) -> (ParseState, ExpressionRead):
	(parsed, prefix) = read_prefix(state, anchor, context, loop_context)
	match prefix:
		UnreadExpression(_) | ReadPlace(_): (parsed, prefix)
		ReadExpression(first): continue_operators(parsed, minimum, anchor, first, loop_context)


-- Resume only from completed syntax and its parse evidence. The same loop
-- owns every binary tail, including a control operand's tail at the caller's
-- minimum precedence; no accepted token is replayed.
private pure func continue_operators(state: ParseState, minimum: Int, anchor: ExpressionAnchor, first: ExpressionProgress, loop_context: BodyContext) -> (ParseState, ExpressionRead):
	var out = state
	var progress = first
	var abandoned: Option[Abandonment] = None
	var reading = True
	while reading and abandoned.is_none():
		if progress.ending == AfterContinuationDedent or progress.value.tail == BlockLambdaOperand:
			reading = False
		else:
			match Operators.binary_operator(out.current_kind()):
				None: reading = False
				Some(operator):
					precedence = Operators.operator_precedence(operator)
					if precedence < minimum:
						reading = False
					else:
						(after_right, right) = read_right_operand(out.advanced(), precedence + 1, anchor, loop_context)
						out = after_right
						match right:
							UnreadExpression(reason): abandoned = Some(reason)
							ReadPlace(_): report_unreachable_input("a binary right operand is a value")
							ReadExpression(operand):
								continued_field = if operator != Operators.RangeOperator and (progress.continued_field == HasContinuedField or operand.continued_field == HasContinuedField):
									HasContinuedField
								else:
									NoContinuedField
								repair = if operator != Operators.RangeOperator and (progress.continued_field == HasContinuedField or operand.repair == RepairOneContinuationDedent):
									RepairOneContinuationDedent
								else:
									NoContinuationRepair
								(minted, parent) = out.finished_expression(progress.value.value_span().span_covering(operand.value.value_span()), operator_expression_kind(operator, progress.value.expression, operand.value.expression))
								out = minted
								progress = {
									value = { expression = parent, root = OtherRoot, tail = operand.value.tail, keeps_name_span = False },
									continuation_indents = progress.continuation_indents + operand.continuation_indents,
									ending = operand.ending,
									continued_field = continued_field,
									repair = repair
								}
	match abandoned:
		Some(reason): (out, UnreadExpression(reason))
		None: (out, ReadExpression(progress))


-- Read a control directly to keep operator-precedence frames out of its
-- nested blocks, then resume its actual completed value at this RHS's minimum.
private pure func read_right_operand(state: ParseState, minimum: Int, anchor: ExpressionAnchor, loop_context: BodyContext) -> (ParseState, ExpressionRead):
	if state.current_kind() == IfKeyword or state.current_kind() == MatchKeyword:
		(read, written) = state.nested(refused_value, pure func(inside): parse_control_operand(inside, anchor, loop_context))
		match expression_read(written):
			ReadExpression(first): continue_operators(read, minimum, anchor, first, loop_context)
			other: (read, other)
	else:
		read_operators(state, minimum, anchor, ValueContext, loop_context)


-- A statement control has already been read with its enclosing loop context.
-- Resume its operator grammar without reparsing it as an out-of-loop operand.
pure func continue_control_expression(state: ParseState, expression: Expression, anchor: ExpressionAnchor, loop_context: BodyContext) -> (ParseState, ValueParse, ExpressionEnding):
	first: ExpressionProgress = { value = expression_value(expression), continuation_indents = 0, ending = AtExpressionToken, continued_field = NoContinuedField, repair = NoContinuationRepair }
	(read, written) = continue_operators(state, Operators.LOWEST_PRECEDENCE, anchor, first, loop_context)
	finish_expression_read(read, written)


private pure func expression_read(written: ValueParse) -> ExpressionRead:
	match written:
		ParsedValue(value): ReadExpression({ value = value, continuation_indents = 0, ending = AtExpressionToken, continued_field = NoContinuedField, repair = NoContinuationRepair })
		UnsupportedValue(stop): UnreadExpression(UnsupportedShape(stop))
		RejectedValue: UnreadExpression(RejectedShape)


private pure func read_prefix(state: ParseState, anchor: ExpressionAnchor, context: ExpressionContext, loop_context: BodyContext) -> (ParseState, ExpressionRead):
	if state.current_kind() == MinusSymbol or state.current_kind() == NotKeyword or state.current_kind() == DetachKeyword:
		state.nested(pure func(reported): UnreadExpression(RejectedShape), pure func(inside): read_prefix_operator(inside, anchor, loop_context))
	else:
		(parsed, atom) = parse_atom(state, anchor, loop_context)
		match atom:
			ParsedValue(first): read_postfix(parsed, anchor, first, context, loop_context)
			_: (parsed, expression_read(atom))


private pure func read_prefix_operator(state: ParseState, anchor: ExpressionAnchor, loop_context: BodyContext) -> (ParseState, ExpressionRead):
	(parsed, operand) = read_prefix(state.advanced(), anchor, ValueContext, loop_context)
	match operand:
		UnreadExpression(_): (parsed, operand)
		ReadPlace(_):
			report_unreachable_input("a prefix operand is a value")
			(parsed, UnreadExpression(RejectedShape))
		ReadExpression(progress):
			kind: ExpressionKind = if state.current_kind() == DetachKeyword:
				Detach(progress.value.expression)
			else:
				operator = if state.current_kind() == MinusSymbol:
					Negate
				else:
					LogicalNot
				Unary(operator, progress.value.expression)
			(minted, parent) = parsed.finished_expression(state.current_span().span_covering(progress.value.value_span()), kind)
			(minted, ReadExpression({ progress | value = { expression = parent, root = OtherRoot, tail = progress.value.tail, keeps_name_span = False }, continued_field = NoContinuedField, repair = NoContinuationRepair }))


-- Consume only an indent opened by NEWLINE INDENT DOT. A non-continuing
-- newline stops the loop, including while an owned indent remains open; that
-- case must make progress or stop, unlike the frozen parser's hanging branch.
private pure func read_postfix(state: ParseState, anchor: ExpressionAnchor, first: ExpressionValue, context: ExpressionContext, loop_context: BodyContext) -> (ParseState, ExpressionRead):
	var out = state
	var value = first
	var indents = 0
	var ending = AtExpressionToken
	var continued_field = NoContinuedField
	var place: Option[SubscriptPlace] = None
	var abandoned: Option[Abandonment] = None
	var reading = True
	while reading and abandoned.is_none():
		if value.ends_in_dedent():
			reading = False
		else if indents > 0 and (out.current_kind() == DedentToken or (out.current_kind() == NewlineToken and out.peek_kind(1) == DedentToken)):
			if out.current_kind() == NewlineToken:
				out = out.advanced()
			out = out.advanced()
			indents -= 1
			if indents == 0:
				ending = AfterContinuationDedent
				reading = False
		else:
			if out.current_kind() == NewlineToken and out.peek_kind(1) == IndentToken and out.peek_kind(2) == DotSymbol:
				out = out.advanced().advanced()
				indents += 1
				continued_field = HasContinuedField
			else if out.current_kind() == NewlineToken and out.peek_kind(1) == DotSymbol:
				out = out.advanced()
				continued_field = HasContinuedField
			step_context = if indents == 0:
				context
			else:
				ValueContext
			(after_step, step) = postfix_step(out, anchor, value, step_context, loop_context)
			out = after_step
			match step:
				ExtendedPostfix(next): value = next
				CompletedPlace(completed):
					place = Some(completed)
					reading = False
				StoppedPostfix: reading = False
				AbandonedPostfix(reason): abandoned = Some(reason)
	match place:
		Some(completed): (out, ReadPlace(completed))
		None:
			match abandoned:
				Some(reason): (out, UnreadExpression(reason))
				None: (out, ReadExpression({ value = value, continuation_indents = indents, ending = ending, continued_field = continued_field, repair = NoContinuationRepair }))


-- A binary tail can finish while its left postfix still owns indentation.
-- The frozen grammar repairs just one leaked level, and only for its binary
-- predicate. Any other still-open chain is unread, rather than losing its
-- ownership at a newline or broadening which malformed inputs can complete.
private pure func finish_expression_read(state: ParseState, read: ExpressionRead) -> (ParseState, ValueParse, ExpressionEnding):
	match read:
		ReadPlace(_):
			report_unreachable_input("a value boundary never receives a subscript place")
			(state, RejectedValue, AtExpressionToken)
		UnreadExpression(UnsupportedShape(stop)): (state, UnsupportedValue(stop), AtExpressionToken)
		UnreadExpression(RejectedShape): (state, RejectedValue, AtExpressionToken)
		ReadExpression(progress):
			var out = state
			var pending = progress.continuation_indents
			var ending = progress.ending
			if pending == 1 and progress.repair == RepairOneContinuationDedent and (out.current_kind() == DedentToken or (out.current_kind() == NewlineToken and out.peek_kind(1) == DedentToken)):
				if out.current_kind() == NewlineToken:
					out = out.advanced()
				out = out.advanced()
				pending -= 1
				ending = AfterContinuationDedent
			if pending > 0:
				(out, UnsupportedValue(out.stop_at(IndentedContinuation)), AtExpressionToken)
			else:
				(out, ParsedValue(progress.value), ending)


-- Grow a chain one step at a time, so authored chain length never becomes
-- native stack depth. The final value is the chain as far as it was read.
private pure func extend_chain[T](
	state: ParseState, first: T, next_step: pure (ParseState, T) -> (ParseState, ChainStep[T]),
) -> (ParseState, T, Option[Abandonment]):
	var out = state
	var current = first
	var abandoned: Option[Abandonment] = None
	var reading = True
	while reading:
		(after_step, step) = next_step(out, current)
		out = after_step
		match step:
			Extended(longer):
				current = longer
			Stopped:
				reading = False
			Abandoned(reason):
				abandoned = Some(reason)
				reading = False
	(out, current, abandoned)


-- Whether the expression's last token is the dedent that closes a block of its
-- own: a control expression or a lambda with an indented body. A call, a
-- subscript or member access after that dedent is not a continuation of it.
-- Binary operators may
-- resume a control operand through `continue_operators`. This is
-- `ControlOperand` widened by the block lambda, which the boundary rules treat
-- apart because only a lambda's follower needs `block_expression_ends`.
private pure func ends_in_dedent(value: ExpressionValue) -> Bool:
	value.tail != PlainOperand


-- One member access, call or subscript, or the end of the chain.
private pure func postfix_step(state: ParseState, anchor: ExpressionAnchor, receiver: ExpressionValue, context: ExpressionContext, loop_context: BodyContext) -> (ParseState, PostfixStep):
	if receiver.ends_in_dedent():
		(state, StoppedPostfix)
	else:
		match state.current_kind():
			DotSymbol: member_step(state, receiver)
			LeftParenSymbol: state.nested(refused_step, pure func(inside): delimited_step(inside, anchor, receiver, CallDelimiter, ValueContext, loop_context))
			LeftBracketSymbol: state.nested(refused_step, pure func(inside): delimited_step(inside, anchor, receiver, SubscriptDelimiter, context, loop_context))
			_: (state, StoppedPostfix)


private pure func refused_value(state: ParseState) -> ValueParse:
	RejectedValue


private pure func refused_step(state: ParseState) -> PostfixStep:
	AbandonedPostfix(RejectedShape)


private pure func member_step(state: ParseState, receiver: ExpressionValue) -> (ParseState, PostfixStep):
	member_entry = state.advanced()
	if member_entry.current_kind() == NewlineToken:
		(state, AbandonedPostfix(UnsupportedShape(member_entry.stop_at(MemberNameOnNextLine))))
	else:
		(after_name, name) = member_entry.consume_referenced_name(NameInFieldName)
		if after_name.diagnostic_count() != member_entry.diagnostic_count():
			(after_name, AbandonedPostfix(RejectedShape))
		else:
			(after_use, use) = after_name.finished_name_use(name)
			(minted, expression) = after_use.finished_expression(receiver.value_span().span_covering(name.span), FieldAccess(receiver.expression, use))
			(minted, ExtendedPostfix(expression_value(expression)))


private pure func delimited_step(state: ParseState, anchor: ExpressionAnchor, receiver: ExpressionValue, delimiter: PostfixDelimiter, context: ExpressionContext, loop_context: BodyContext) -> (ParseState, PostfixStep):
	opened = state.advanced()
	match delimiter:
		CallDelimiter:
			(after_items, items) = parse_optional_items(opened, PostfixItems(CallDelimiter), anchor, loop_context)
			(closed, closed_items) = after_items.closing_items(items, PostfixItems(CallDelimiter))
			match closed_items:
				ParsedItems((arguments, end_span)):
					(minted, expression) = closed.finished_expression(receiver.value_span().span_covering(end_span), Call(receiver.expression, arguments.map(pure func(value): value.expression)))
					(minted, ExtendedPostfix(expression_value(expression)))
				UnsupportedItems(stop): (closed, AbandonedPostfix(UnsupportedShape(stop)))
				RejectedItems: (closed, AbandonedPostfix(RejectedShape))
		SubscriptDelimiter:
			(after_items, items) = parse_nonempty_items(opened, PostfixItems(SubscriptDelimiter), anchor, loop_context)
			(closed, closed_items) = after_items.closing_items(items, PostfixItems(SubscriptDelimiter))
			match closed_items:
				ParsedItems((indices, end_span)):
					span = receiver.value_span().span_covering(end_span)
					values: AtLeastOne[Expression] = { first = indices.first.expression, rest = indices.rest.map(pure func(value): value.expression) }
					if context == StatementContext and closed.current_kind() == EqualSymbol:
						(minted, place) = closed.finished_subscript_place(span, receiver.expression, values)
						(minted, CompletedPlace(place))
					else:
						(minted, expression) = closed.finished_expression(span, Subscript(receiver.expression, values))
						(minted, ExtendedPostfix(expression_value(expression)))
				UnsupportedItems(stop): (closed, AbandonedPostfix(UnsupportedShape(stop)))
				RejectedItems: (closed, AbandonedPostfix(RejectedShape))


private pure func closing_token(delimiter: ItemDelimiter) -> TokenKind:
	match delimiter:
		PostfixItems(CallDelimiter): RightParenSymbol
		PostfixItems(SubscriptDelimiter) | ListItems: RightBracketSymbol
		TupleItems: RightParenSymbol
		BracedItems(_): RightBraceSymbol


private pure func unclosed_delimiter_diagnostic(delimiter: ItemDelimiter) -> ExpectedTokenDiagnostic:
	match delimiter:
		PostfixItems(CallDelimiter): ExpectedRightParen(RightParenInCallArguments)
		PostfixItems(SubscriptDelimiter): ExpectedRightBracket(RightBracketInSubscript)
		ListItems: ExpectedRightBracket(RightBracketInListLiteral)
		TupleItems: ExpectedRightParen(RightParenInTupleExpression)
		BracedItems(RecordForm): ExpectedRightBrace(RightBraceInRecordLiteral)
		BracedItems(UpdateForm): ExpectedRightBrace(RightBraceInRecordUpdate)
		BracedItems(DictForm): ExpectedRightBrace(RightBraceInDictLiteral)
		BracedItems(VectorForm): ExpectedRightBrace(RightBraceInVectorLiteral)


-- Pair parsed items with their consumed closing bracket. A failure to close
-- abandons the items whole, with the reason `close_items` gave.
private pure func closing_items[T](
	state: ParseState, items: ItemsParse[T], delimiter: ItemDelimiter,
) -> (ParseState, ItemsParse[(T, Span)]):
	match items:
		ParsedItems(values):
			(closed, closing) = state.close_items(delimiter)
			match closing:
				ClosedAt(end_span): (closed, ParsedItems((values, end_span)))
				NotClosed(UnsupportedShape(stop)): (closed, UnsupportedItems(stop))
				NotClosed(RejectedShape): (closed, RejectedItems)
		UnsupportedItems(stop):
			(state, UnsupportedItems(stop))
		RejectedItems:
			(state, RejectedItems)


-- Consume the closing bracket. At end of source the list is unclosed and
-- rejected; any other token (a layout token, a different bracket, a missing
-- comma) belongs to a shape this slice leaves unsupported.
private pure func close_items(state: ParseState, delimiter: ItemDelimiter) -> (ParseState, ClosingParse):
	end = closing_token(delimiter)
	if state.current_kind() == end:
		(state.advanced(), ClosedAt(state.current_span()))
	else if state.current_kind() == EndOfFileToken:
		(state.expect_token(end, unclosed_delimiter_diagnostic(delimiter)), NotClosed(RejectedShape))
	else:
		(state, NotClosed(UnsupportedShape(state.stop_at(UnexpectedTokenInBrackets))))


-- Call arguments and list items may be empty; subscript indices may not.
-- Recursion follows item bracket nesting, never the callee spine.
private pure func parse_optional_items(state: ParseState, delimiter: ItemDelimiter, anchor: ExpressionAnchor, loop_context: BodyContext) -> (ParseState, ItemsParse[List[ExpressionValue]]):
	if state.current_kind() == closing_token(delimiter):
		(state, ParsedItems([]))
	else:
		(after_items, items) = parse_nonempty_items(state, delimiter, anchor, loop_context)
		match items:
			ParsedItems(values):
				(after_items, ParsedItems(at_least_one_items(values)))
			UnsupportedItems(stop):
				(after_items, UnsupportedItems(stop))
			RejectedItems:
				(after_items, RejectedItems)


-- A missing first item reports `expected expression` at the closing bracket,
-- which is how an empty subscript is rejected.
private pure func parse_nonempty_items(
	state: ParseState, delimiter: ItemDelimiter, anchor: ExpressionAnchor,
	loop_context: BodyContext,
) -> (ParseState, ItemsParse[AtLeastOne[ExpressionValue]]):
	if state.current_kind() == EndOfFileToken:
		(state.expect_token(closing_token(delimiter), unclosed_delimiter_diagnostic(delimiter)), RejectedItems)
	else:
		-- Read directly, not through `expression_item`: this frame is on the stack
		-- once per level of bracket nesting.
		(first_state, first) = if state.current_kind() == IfKeyword or state.current_kind() == MatchKeyword:
			state.nested(refused_value, pure func(inside): parse_control_operand(inside, anchor, loop_context))
		else:
			parse_operators(state, Operators.LOWEST_PRECEDENCE, anchor, loop_context)
		match first:
			ParsedValue(value):
				items_after(first_state, delimiter, ReportsOnlyUnclosed, value, pure func(current):
					anchored_item(current, anchor, loop_context)
				)
			UnsupportedValue(stop):
				(first_state, UnsupportedItems(stop))
			RejectedValue:
				(first_state, RejectedItems)


-- Calls, subscripts and lists use the frozen header-anchored entry for each
-- item: a leading control is the whole item. A grouping, tuple or braced
-- value enters the operator grammar instead, as does a control on an RHS.
private pure func anchored_item(state: ParseState, anchor: ExpressionAnchor, loop_context: BodyContext) -> (ParseState, ItemsParse[ExpressionValue]):
	(after_item, item) = if state.current_kind() == IfKeyword or state.current_kind() == MatchKeyword:
		state.nested(refused_value, pure func(inside): parse_control_operand(inside, anchor, loop_context))
	else:
		parse_operators(state, Operators.LOWEST_PRECEDENCE, anchor, loop_context)
	match item:
		ParsedValue(value): (after_item, ParsedItems(value))
		UnsupportedValue(stop): (after_item, UnsupportedItems(stop))
		RejectedValue: (after_item, RejectedItems)


private pure func expression_item(state: ParseState, anchor: ExpressionAnchor, loop_context: BodyContext) -> (ParseState, ItemsParse[ExpressionValue]):
	(after_item, item) = parse_operators(state, Operators.LOWEST_PRECEDENCE, anchor, loop_context)
	match item:
		ParsedValue(value): (after_item, ParsedItems(value))
		UnsupportedValue(stop): (after_item, UnsupportedItems(stop))
		RejectedValue: (after_item, RejectedItems)


-- The items that follow `first` as comma-separated, with an optional trailing
-- comma before the closing bracket, each read by `read`.
private pure func items_after[T](
	state: ParseState, delimiter: ItemDelimiter, at_end_of_source: CommaBeforeEndOfSource, first: T,
	read: pure (ParseState) -> (ParseState, ItemsParse[T]),
) -> (ParseState, ItemsParse[AtLeastOne[T]]):
	no_items: List[T] = []
	(out, rest, abandoned) = extend_chain(state, no_items, pure func(current, items):
		next_item_step(current, delimiter, at_end_of_source, items, read)
	)
	match abandoned:
		None: (out, ParsedItems({ first = first, rest = rest }))
		Some(UnsupportedShape(stop)): (out, UnsupportedItems(stop))
		Some(RejectedShape): (out, RejectedItems)


-- What the frozen parser does with a comma that is followed by the end of
-- source. A call, subscript, list, record or update ignores it and reports
-- only the missing closing bracket. A tuple, vector or dict reads a missing
-- item there, reports it, and counts it, which this slice does not
-- reproduce, so it defers.
private fixed union CommaBeforeEndOfSource:
	ReportsOnlyUnclosed
	CountsAsMissingItem


-- A comma introduces the next item, or trails before the closing delimiter.
private pure func next_item_step[T](
	state: ParseState, delimiter: ItemDelimiter, at_end_of_source: CommaBeforeEndOfSource, items: List[T],
	read: pure (ParseState) -> (ParseState, ItemsParse[T]),
) -> (ParseState, ChainStep[List[T]]):
	if state.current_kind() != CommaSymbol:
		(state, Stopped)
	else:
		after_comma = state.advanced()
		if after_comma.current_kind() == closing_token(delimiter):
			(after_comma, Stopped)
		else if after_comma.current_kind() == EndOfFileToken:
			match at_end_of_source:
				ReportsOnlyUnclosed: (after_comma, Stopped)
				CountsAsMissingItem: (after_comma, Abandoned(UnsupportedShape(after_comma.stop_at(TrailingCommaAtEndOfSource))))
		else:
			(after_item, item) = read(after_comma)
			match item:
				ParsedItems(value):
					(after_item, Extended(items.append(value)))
				UnsupportedItems(stop):
					(after_item, Abandoned(UnsupportedShape(stop)))
				RejectedItems:
					(after_item, Abandoned(RejectedShape))


-- An interpolated string whose every hole is one clean expression. A hole is
-- lexed and read on its own; its expression and hole finish there. Any
-- hole outside the grammar leaves the whole string unsupported.
private pure func parse_interpolated_string(state: ParseState, span: Span, loop_context: BodyContext) -> (ParseState, ValueParse):
	form: InterpolationForm = if state.current_kind() == InterpolatedPipeStringToken:
		PipeInterpolation
	else:
		QuotedInterpolation
	match state.current_interpolation():
		None:
			-- The token cursor checked that an interpolated string token indexes a scan.
			report_unreachable_input("an interpolated string token indexes its scan")
			(state, UnsupportedValue(state.stop_at(MalformedTokenPayload)))
		Some(scan):
			no_pieces: List[InterpolationPiece] = []
			(out, pieces, abandoned) = extend_chain(state, no_pieces, pure func(current, read):
				interpolation_piece_step(current, scan.pieces, read, loop_context)
			)
			match abandoned:
				None:
					out.advanced().finished_value(span, InterpolatedString(form, pieces))
				Some(UnsupportedShape(stop)):
					(state, UnsupportedValue(stop))
				Some(RejectedShape):
					-- A hole is declined whole, never rejected: `parse_hole` has no rejected outcome.
					report_unreachable_input("an interpolation piece is abandoned only as unsupported")
					(state, UnsupportedValue(state.stop_at(MalformedTokenPayload)))


-- The next piece of the string, after the `read` ones: a text piece, a hole
-- finished on its own token run, or the end. An unread hole abandons the string.
private pure func interpolation_piece_step(
	state: ParseState, pieces: List[ScannedPiece], read: List[InterpolationPiece],
	loop_context: BodyContext,
) -> (ParseState, ChainStep[List[InterpolationPiece]]):
	match pieces.get(read.length()):
		None:
			(state, Stopped)
		Some(ScannedText(text)):
			(state, Extended(read.append(InterpolationText(text.text))))
		Some(ScannedHole(hole)):
			(after_hole, value) = state.parse_hole(hole, loop_context)
			match value:
				Recognized(written):
					(after_hole, Extended(read.append(InterpolationHole(written))))
				Declined(stop):
					(state, Abandoned(UnsupportedShape(stop)))


-- One hole's expression: the whole of the hole's own tokens, and nothing else.
-- A hole that is rejected or declined leaves the string declined; the reason
-- of a declined hole is the one the hole's own parse gave.
private pure func parse_hole(state: ParseState, hole: HoleScan, loop_context: BodyContext) -> (ParseState, Recognition[Hole]):
	match state.entered_hole(hole):
		None:
			(state, Declined(state.stop_at(InterpolationHoleNotLexed)))
		Some((inside, parked)):
			(read, parsed) = inside.nested(refused_value, pure func(deeper): parse_operators(deeper, Operators.LOWEST_PRECEDENCE, anchored_at(deeper.current_span()), loop_context))
			match parsed:
				ParsedValue(value):
					if read.current_kind() == EndOfFileToken:
						(minted, completed) = read.finished_hole(value.expression, hole.span)
						(minted.left_hole(parked), Recognized(completed))
					else:
						(state, Declined(read.stop_at(InterpolationHoleTrailingTokens)))
				UnsupportedValue(stop):
					(state, Declined(stop))
				RejectedValue:
					(state, Declined(inside.rejected_stop(read, InterpolationHoleRejected)))


private pure func parse_atom(state: ParseState, anchor: ExpressionAnchor, loop_context: BodyContext) -> (ParseState, ValueParse):
	span = state.current_span()
	match state.current_kind():
		IdentifierToken | AfterKeyword | SealedKeyword | FromKeyword:
			state.parse_name_atom(span)
		DebugKeyword:
			if state.peek_kind(1) == DotSymbol:
				state.parse_name_atom(span)
			else:
				match expression_start_reason(state):
					Some(reason): (state, UnsupportedValue(state.stop_at(reason)))
					None:
						report_unreachable_input("a non-dotted debug atom has a stop reason")
						(state, UnsupportedValue(state.stop_at(MalformedTokenPayload)))
		IntLiteralToken | FloatLiteralToken:
			match state.current_literal():
				Some(IntegerValue(magnitude)):
					state.advanced().finished_value(span, IntegerLiteral(magnitude))
				Some(FloatValue(value)):
					state.advanced().finished_value(span, FloatLiteral(value))
				_:
					(state, UnsupportedValue(state.stop_at(MalformedTokenPayload)))
		NormalStringToken | RawStringToken | PipeStringToken | RawPipeStringToken:
			match state.current_literal():
				Some(TextValue(text)):
					form: StringForm = match state.current_kind():
						RawStringToken: RawString
						PipeStringToken: PipeString
						RawPipeStringToken: RawPipeString
						_: QuotedString
					state.advanced().finished_value(span, StringLiteral(form, text))
				_:
					-- The token cursor checked that a string token's literal is text.
					report_unreachable_input("a string token indexes a text literal")
					(state, UnsupportedValue(state.stop_at(MalformedTokenPayload)))
		InterpolatedStringToken | InterpolatedPipeStringToken:
			state.parse_interpolated_string(span, loop_context)
		CharLiteralToken:
			-- The token cursor validated the payload as a Unicode scalar value.
			state.advanced().finished_value(span, CharacterLiteral(to_char(state.current_token().payload)))
		FuncKeyword | PureKeyword:
			state.nested(refused_value, pure func(inside): parse_lambda_atom(inside, anchor))
		TrueKeyword | FalseKeyword:
			state.advanced().finished_value(span, BooleanLiteral(state.current_kind() == TrueKeyword))
		VoidKeyword | UnderscoreSymbol:
			state.advanced().finished_value(span, VoidValue)
		LeftParenSymbol:
			state.nested(refused_value, pure func(inside): parse_parenthesized(inside, span, loop_context))
		LeftBracketSymbol:
			state.nested(refused_value, pure func(inside): parse_list_literal(inside, span, loop_context))
		LeftBraceSymbol:
			state.nested(refused_value, pure func(inside): parse_braced(inside, span, loop_context))
		BuiltinKeyword:
			state.parse_builtin(span)
		IntoOpaqueKeyword | FromOpaqueKeyword:
			state.nested(refused_value, pure func(inside): parse_opaque_conversion(inside, span, loop_context))
		IfKeyword | MatchKeyword:
			state.nested(refused_value, pure func(inside): parse_control_operand(inside, anchor, loop_context))
		EndOfFileToken | RightParenSymbol | RightBracketSymbol:
			(state.report_at_current(ExpectedExpressionDiagnostic), RejectedValue)
		_:
			match expression_start_reason(state):
				Some(reason):
					(state, UnsupportedValue(state.stop_at(reason)))
				None:
					-- Every kind the arms above read has no reason; the others are named in full.
					report_unreachable_input("an atom token the parser reads has an arm")
					(state, UnsupportedValue(state.stop_at(MalformedTokenPayload)))


-- Only the frozen primary-name arms call this role: `from` is a name here,
-- while it remains reserved in binder, field and member name positions.
private pure func parse_name_atom(state: ParseState, span: Span) -> (ParseState, ValueParse):
	(advanced, name) = state.consume_name(ExpressionName, NameInStatementName)
	(used, use) = advanced.finished_name_use(name)
	used.finished_value(span, NameReference(use))


-- Marker parentheses hold literal metadata, so they add no expression nesting.
private pure func parse_builtin(state: ParseState, span: Span) -> (ParseState, ValueParse):
	entry = state.advanced()
	if entry.current_kind() != LeftParenSymbol:
		entry.finished_value(span, CompilerBuiltin(None))
	else:
		marker_state = entry.advanced()
		marker: Option[String] = match marker_state.current_kind():
			NormalStringToken | RawStringToken | PipeStringToken | RawPipeStringToken:
				match marker_state.current_literal():
					Some(TextValue(text)): Some(text)
					_: None
			_: marker_state.current_builtin_marker_text()
		match marker:
			Some(text):
				after_marker = marker_state.advanced()
				if after_marker.current_kind() == RightParenSymbol:
					after_marker.advanced().finished_value(span.span_covering(after_marker.current_span()), CompilerBuiltin(Some(text)))
				else:
					(after_marker.expect_token(RightParenSymbol, ExpectedRightParen(RightParenInBuiltinName)), RejectedValue)
			None:
				after_error = marker_state.report_and_recover(ExpectedBuiltinNameDiagnostic)
				(after_error.expect_token(RightParenSymbol, ExpectedRightParen(RightParenInBuiltinName)), RejectedValue)


-- Types finish first, then the value at its own expression anchor. A type's
-- recovery syntax must not escape as an accepted conversion; public rejection
-- retains its diagnostics while restoring the caller's mint authority.
private pure func parse_opaque_conversion(state: ParseState, span: Span, loop_context: BodyContext) -> (ParseState, ValueParse):
	direction = if state.current_kind() == IntoOpaqueKeyword:
		IntoOpaque
	else:
		FromOpaque
	(after_type, written) = parse_type(state.advanced())
	if after_type.diagnostic_count() != state.diagnostic_count():
		(after_type, RejectedValue)
	else if after_type.current_kind() != LeftParenSymbol:
		(after_type.expect_token(LeftParenSymbol, ExpectedLeftParen(LeftParenInOpaqueConversionType)), RejectedValue)
	else:
		value_entry = after_type.advanced()
		(after_value, result) = parse_operators(value_entry, Operators.LOWEST_PRECEDENCE, anchored_at(value_entry.current_span()), loop_context)
		match result:
			ParsedValue(value):
				if after_value.current_kind() == RightParenSymbol:
					after_value.advanced().finished_value(span.span_covering(after_value.current_span()), OpaqueConversion(direction, written, value.expression))
				else if after_value.current_kind() == EndOfFileToken:
					(after_value.expect_token(RightParenSymbol, ExpectedRightParen(RightParenInOpaqueConversionValue)), RejectedValue)
				else:
					(after_value, UnsupportedValue(after_value.stop_at(UnexpectedTokenInBrackets)))
			_:
				(after_value, result)


-- The atoms that nest, counted once each by `parse_atom` (section 3.14).
private pure func parse_lambda_atom(state: ParseState, anchor: ExpressionAnchor) -> (ParseState, ValueParse):
	(remaining, lambda) = parse_lambda(state, anchor)
	match lambda:
		ParsedLambda(expression): (remaining, ParsedValue(expression_value(expression)))
		UnsupportedLambda(stop): (state, UnsupportedValue(stop))


-- An `if` or `match` as an operand. Its blocks end on dedents, so what the
-- expression may do afterwards is decided by the enclosing operator loop;
-- `ends_in_dedent` still stops postfix chains there. Its twin for a whole statement value is
-- `parse_value` in the body parser.
private pure func parse_control_operand(state: ParseState, anchor: ExpressionAnchor, loop_context: BodyContext) -> (ParseState, ValueParse):
	(remaining, control) = parse_control(state, PastExpressionAnchor(anchor), loop_context)
	match control:
		Recognized(expression): (remaining, ParsedValue(expression_value(expression)))
		Declined(stop): (state, UnsupportedValue(stop))


-- The arms below are functions of their own, not inline in `parse_atom`: that
-- frame is on the native stack once for every level of bracket nesting, and
-- the nesting limit (section 3.14) has to fit the Linux stack.
private pure func parse_parenthesized(state: ParseState, span: Span, loop_context: BodyContext) -> (ParseState, ValueParse):
	opened = state.advanced()
	if opened.current_kind() == RightParenSymbol:
		opened.advanced().finished_value(span.span_covering(opened.current_span()), VoidValue)
	else:
		(parsed, inner) = parse_operators(opened, Operators.LOWEST_PRECEDENCE, anchored_at(span), loop_context)
		match inner:
			ParsedValue(value):
				if parsed.current_kind() == CommaSymbol:
					parsed.parse_tuple_rest(span, value, loop_context)
				else if parsed.current_kind() == RightParenSymbol:
					-- Names retain their token span through every grouping layer.
					group_span = if value.keeps_name_span:
						value.value_span()
					else:
						span.span_covering(parsed.current_span())
					(parsed.advanced(), ParsedValue({ value | expression = { value.expression | span = group_span }, root = GroupedRoot, tail = PlainOperand }))
				else if parsed.current_kind() == EndOfFileToken:
					(parsed.expect_token(RightParenSymbol, ExpectedRightParen(RightParenInGroupedExpression)), RejectedValue)
				else:
					(parsed, UnsupportedValue(parsed.stop_at(UnexpectedTokenInBrackets)))
			_:
				(parsed, inner)


private pure func parse_list_literal(state: ParseState, span: Span, loop_context: BodyContext) -> (ParseState, ValueParse):
	(after_items, items) = parse_optional_items(state.advanced(), ListItems, anchored_at(span), loop_context)
	(closed, closed_items) = after_items.closing_items(items, ListItems)
	match closed_items:
		ParsedItems((elements, end_span)):
			closed.finished_value(span.span_covering(end_span), ListLiteral(elements.map(pure func(value): value.expression)))
		UnsupportedItems(stop):
			(closed, UnsupportedValue(stop))
		RejectedItems:
			(closed, RejectedValue)


-- A field name that is a soft keyword (`{on = 1}`) does not start a record
-- field here, because only an identifier token does, so such a record defers.
-- `{` opens a record literal (`{}` or `{name = value}`), a record update
-- (`{record | name = value}`), a dict literal (`{key => value}`) or a vector
-- literal (`{a, b}`), told apart as the frozen parser does: by a leading
-- `name =`, then by the token after the first expression.
private pure func parse_braced(state: ParseState, open_span: Span, loop_context: BodyContext) -> (ParseState, ValueParse):
	opened = state.advanced()
	if opened.current_kind() == RightBraceSymbol:
		opened.advanced().finished_value(open_span.span_covering(opened.current_span()), RecordLiteral([]))
	else if opened.starts_field():
		(after_items, items) = record_fields_from(opened, RecordForm, loop_context)
		parse_braced_items(after_items, items, RecordForm, open_span, pure func(fields):
			fields.without_repeats().map(pure func(distinct):
				RecordLiteral(at_least_one_items(distinct))
			)
		)
	else if opened.current_kind() == EndOfFileToken:
		-- The frozen parser reads a missing first item before the missing brace.
		missing = opened.report_at_current(ExpectedExpressionDiagnostic)
		(missing.expect_token(RightBraceSymbol, unclosed_delimiter_diagnostic(BracedItems(VectorForm))), RejectedValue)
	else:
		(after_first, first) = parse_operators(opened, Operators.LOWEST_PRECEDENCE, anchored_at(opened.current_span()), loop_context)
		match first:
			ParsedValue(value):
				parse_braced_after_first(after_first, open_span, value, loop_context)
			UnsupportedValue(stop):
				(after_first, UnsupportedValue(stop))
			RejectedValue:
				(after_first, RejectedValue)


-- The token after the first expression picks the form: `=>` a dict, `|` a
-- record update, anything else a vector.
private pure func parse_braced_after_first(
	state: ParseState, open_span: Span, first: ExpressionValue,
	loop_context: BodyContext,
) -> (ParseState, ValueParse):
	match state.current_kind():
		FatArrowSymbol:
			(after_items, items) = dict_entries_from(state, first, loop_context)
			parse_braced_items(after_items, items, DictForm, open_span, pure func(entries):
				Some(DictLiteral(at_least_one_items(entries)))
			)
		PipeSymbol:
			after_bar = state.advanced()
			if after_bar.current_kind() == EndOfFileToken:
				(after_bar.expect_token(RightBraceSymbol, unclosed_delimiter_diagnostic(BracedItems(UpdateForm))), RejectedValue)
			else:
				(after_items, items) = record_fields_from(after_bar, UpdateForm, loop_context)
				parse_braced_items(after_items, items, UpdateForm, open_span, pure func(fields):
					fields.without_repeats().map(pure func(distinct):
						RecordUpdate(first.expression, at_least_one_items(distinct))
					)
				)
		_:
			(after_items, items) = items_after(state, BracedItems(VectorForm), CountsAsMissingItem, first, pure func(current):
				expression_item(current, anchored_at(current.current_span()), loop_context)
			)
			parse_braced_items(after_items, items, VectorForm, open_span, pure func(elements):
				Some(VectorLiteral(at_least_one_items(elements).map(pure func(value): value.expression)))
			)


private pure func starts_field(state: ParseState) -> Bool:
	(state.current_kind() == IdentifierToken or state.current_kind().is_soft_keyword()) and state.peek_kind(1) == EqualSymbol


-- Close a braced form's items and wrap them. A form whose items were already
-- reported as a rejection (a repeated record field) has no accepted owner, and is
-- rejected after its closing brace, so the frozen parser's diagnostics keep
-- their order.
private pure func parse_braced_items[T](
	state: ParseState, items: ItemsParse[T], form: BracedForm, open_span: Span,
	expression_kind: pure (T) -> Option[ExpressionKind],
) -> (ParseState, ValueParse):
	(closed, closed_items) = state.closing_items(items, BracedItems(form))
	match closed_items:
		ParsedItems((values, end_span)):
			match expression_kind(values):
				Some(kind): closed.finished_value(open_span.span_covering(end_span), kind)
				None: (closed, RejectedValue)
		UnsupportedItems(stop):
			(closed, UnsupportedValue(stop))
		RejectedItems:
			(closed, RejectedValue)


-- Record fields, or fields that repeat a name. Repetition is reported where
-- the fields end, but the record is still read to its closing brace.
private union FieldList:
	DistinctFields(AtLeastOne[NamedValue])
	RepeatedFields


private pure func without_repeats(fields: FieldList) -> Option[AtLeastOne[NamedValue]]:
	match fields:
		DistinctFields(distinct): Some(distinct)
		RepeatedFields: None


private pure func record_fields_from(state: ParseState, form: BracedForm, loop_context: BodyContext) -> (ParseState, ItemsParse[FieldList]):
	(first_state, first) = field_item(state, loop_context)
	match first:
		ParsedItems(value):
			(after_fields, fields) = items_after(first_state, BracedItems(form), ReportsOnlyUnclosed, value, pure func(current):
				field_item(current, loop_context)
			)
			match fields:
				ParsedItems(read_fields):
					(reported, list) = after_fields.reported_repeated_fields(read_fields)
					(reported, ParsedItems(list))
				UnsupportedItems(stop):
					(after_fields, UnsupportedItems(stop))
				RejectedItems:
					(after_fields, RejectedItems)
		UnsupportedItems(stop):
			(first_state, UnsupportedItems(stop))
		RejectedItems:
			(first_state, RejectedItems)


-- Each later field that repeats an earlier name is reported at its own name,
-- pointing at the first field of that name.
private pure func reported_repeated_fields(state: ParseState, fields: AtLeastOne[NamedValue]) -> (ParseState, FieldList):
	var out = state
	-- The module interner gives equal written names the same spelling id.
	var first_span_by_spelling: Dict[SpellingId, Span] = dict()
	var repeated = False
	for field in at_least_one_items(fields):
		match first_span_by_spelling.get(field.name.name.spelling):
			Some(earlier):
				out = out.report_diagnostic(field.name.name.span, DuplicateFieldGiven(earlier))
				repeated = True
			None:
				first_span_by_spelling = first_span_by_spelling.set(field.name.name.spelling, field.name.name.span)
	if repeated:
		(out, RepeatedFields)
	else:
		(out, DistinctFields(fields))


private pure func field_item(state: ParseState, loop_context: BodyContext) -> (ParseState, ItemsParse[NamedValue]):
	if not state.starts_field():
		(state, UnsupportedItems(state.stop_at(UnexpectedTokenInBrackets)))
	else:
		(after_name, name) = state.consume_referenced_name(NameInRecordFieldName)
		(used, use) = after_name.finished_name_use(name)
		(after_value, value) = expression_item(used.advanced(), anchored_at(after_name.advanced().current_span()), loop_context)
		match value:
			ParsedItems(written):
				(after_value, ParsedItems({ name = use, value = written.expression, span = name.span.span_covering(written.value_span()) }))
			UnsupportedItems(stop):
				(after_value, UnsupportedItems(stop))
			RejectedItems:
				(after_value, RejectedItems)


-- Dict entries from the first key, which the caller read and which is
-- followed by `=>`.
private pure func dict_entries_from(state: ParseState, first_key: ExpressionValue, loop_context: BodyContext) -> (ParseState, ItemsParse[AtLeastOne[DictEntry]]):
	(first_state, first) = entry_after_key(state, first_key, loop_context)
	match first:
		ParsedItems(entry):
			items_after(first_state, BracedItems(DictForm), CountsAsMissingItem, entry, pure func(current):
				entry_item(current, loop_context)
			)
		UnsupportedItems(stop):
			(first_state, UnsupportedItems(stop))
		RejectedItems:
			(first_state, RejectedItems)


private pure func entry_item(state: ParseState, loop_context: BodyContext) -> (ParseState, ItemsParse[DictEntry]):
	(after_key, key) = expression_item(state, anchored_at(state.current_span()), loop_context)
	match key:
		ParsedItems(written):
			entry_after_key(after_key, written, loop_context)
		UnsupportedItems(stop):
			(after_key, UnsupportedItems(stop))
		RejectedItems:
			(after_key, RejectedItems)


-- `=> value` after a key. The frozen parser reports a missing arrow; this slice defers it.
private pure func entry_after_key(state: ParseState, key: ExpressionValue, loop_context: BodyContext) -> (ParseState, ItemsParse[DictEntry]):
	if state.current_kind() != FatArrowSymbol:
		(state, UnsupportedItems(state.stop_at(MissingDictArrow)))
	else:
		(after_value, value) = expression_item(state.advanced(), anchored_at(state.advanced().current_span()), loop_context)
		match value:
			ParsedItems(written):
				(after_value, ParsedItems({ key = key.expression, value = written.expression, span = key.value_span().span_covering(written.value_span()) }))
			UnsupportedItems(stop):
				(after_value, UnsupportedItems(stop))
			RejectedItems:
				(after_value, RejectedItems)


-- The rest of a tuple after its first item and the comma that proves it is not
-- a grouping. The frozen parser reads every item before judging arity, so an
-- out-of-range count is rejected only once the closing parenthesis (or the
-- end of source) is reached, with the same diagnostics and spans. Elements are
-- finished in source order. Rejection discards the entire trial mint; a
-- one-element `(x,)` or a longer tuple never finishes a TupleLiteral owner.
private pure func parse_tuple_rest(
	state: ParseState, open_span: Span, first: ExpressionValue,
	loop_context: BodyContext,
) -> (ParseState, ValueParse):
	(after_items, items) = items_after(state, TupleItems, CountsAsMissingItem, first, pure func(current):
		expression_item(current, anchored_at(open_span), loop_context)
	)
	match items:
		UnsupportedItems(stop):
			(after_items, UnsupportedValue(stop))
		RejectedItems:
			(after_items, RejectedValue)
		ParsedItems(read_items):
			rest = read_items.rest
			if after_items.current_kind() == RightParenSymbol:
				span = open_span.span_covering(after_items.current_span())
				(counted, tuple) = after_items.advanced().counted_tuple(span, first, rest)
				match tuple:
					Some(elements): counted.finished_value(span, TupleLiteral(elements))
					None: (counted, RejectedValue)
			else if after_items.current_kind() == EndOfFileToken:
				unclosed = after_items.expect_token(RightParenSymbol, ExpectedRightParen(RightParenInTupleExpression))
				(counted, _) = unclosed.counted_tuple(open_span.span_covering(first.value_span()), first, rest)
				(counted, RejectedValue)
			else:
				(after_items, UnsupportedValue(after_items.stop_at(UnexpectedTokenInBrackets)))


-- A tuple holds two to four elements. Any other count is reported over the
-- tuple's span, a single element as `(x,)` and a longer one as an arity error,
-- and has no tuple to return.
private pure func counted_tuple(
	state: ParseState, span: Span, first: ExpressionValue, rest: List[ExpressionValue],
) -> (ParseState, Option[SmallTuple[Expression]]):
	match rest:
		[]: (state.report_diagnostic(span, Plain(SingletonTupleDiagnostic)), None)
		[second]: (state, Some(Pair(first.expression, second.expression)))
		[second, third]: (state, Some(Triple(first.expression, second.expression, third.expression)))
		[second, third, fourth]: (state, Some(Quadruple(first.expression, second.expression, third.expression, fourth.expression)))
		_: (state.report_diagnostic(span, Plain(TupleArityDiagnostic)), None)


-- Mapping is exhaustive: logical and range forms never enter ordinary Binary.
private pure func operator_expression_kind(operator: Operators.BinaryOperator, left: Expression, right: Expression) -> ExpressionKind:
	match operator:
		Operators.OrOperator: ShortCircuit(LogicalOr, left, right)
		Operators.AndOperator: ShortCircuit(LogicalAnd, left, right)
		Operators.RangeOperator: RangeExpression(left, right)
		Operators.AddOperator: Binary(Add, left, right)
		Operators.SubtractOperator: Binary(Subtract, left, right)
		Operators.MultiplyOperator: Binary(Multiply, left, right)
		Operators.DivideOperator: Binary(Divide, left, right)
		Operators.ModuloOperator: Binary(Modulo, left, right)
		Operators.EqualOperator: Binary(Equal, left, right)
		Operators.NotEqualOperator: Binary(NotEqual, left, right)
		Operators.LessOperator: Binary(Less, left, right)
		Operators.LessEqualOperator: Binary(LessEqual, left, right)
		Operators.GreaterOperator: Binary(Greater, left, right)
		Operators.GreaterEqualOperator: Binary(GreaterEqual, left, right)


-- Standalone expressions start outside any enclosing loop. Body readers pass
-- their explicit loop context to parse_scoped_expression.
pure func parse_expression_with_ending(state: ParseState, anchor: ExpressionAnchor) -> (ParseState, ValueParse, ExpressionEnding):
	parse_scoped_expression(state, anchor, OutsideLoop)
