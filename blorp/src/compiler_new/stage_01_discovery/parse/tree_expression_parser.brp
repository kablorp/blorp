-- An explicitly bounded M4 operator grammar. Recognition builds only recipes:
-- no NameUse, Expression or declaration ID exists until the entire same-line
-- expression and its boundary have been accepted. Unsupported input returns
-- the caller's original state, including spellings and diagnostics.
import:
	../lex/lexed_module: LiteralValue(IntegerValue, FloatValue, TextValue), HoleScan, ScannedPiece(ScannedText, ScannedHole)
	../syntax/checked_values: DecimalFloat
	../syntax/expressions:
		Expression, ExpressionKind(NameReference, IntegerLiteral, FloatLiteral, StringLiteral, InterpolatedString, BooleanLiteral, CharacterLiteral, VoidValue, Unary, Binary, ShortCircuit, RangeExpression, Call, FieldAccess, Subscript, ListLiteral, TupleLiteral, VectorLiteral, RecordLiteral, RecordUpdate, DictLiteral),
		InterpolationForm(QuotedInterpolation, PipeInterpolation), InterpolationPiece(InterpolationText, InterpolationHole),
		NamedValue, DictEntry,
		UnaryOperator(Negate, LogicalNot),
		BinaryOperator(Add, Subtract, Multiply, Divide, Modulo, Equal, NotEqual, Less, LessEqual, Greater, GreaterEqual),
		LogicalOperator(LogicalAnd, LogicalOr)
	-- A lambda atom holds a statement recipe, so this module and the body parser import
	-- each other until the shared recipe types move to their own module.
	tree_body_parser: LambdaRecipe, BodyRecipe(BlockBodyRecipe), parse_lambda_recipe, mint_lambda_recipe
	../syntax/ids: spelling_index
	../syntax/sequences: AtLeastOne, SmallTuple(Pair, Triple, Quadruple), at_least_one_items
	../syntax/names: WrittenName
	../syntax/diagnostics: SyntaxDiagnostic(Plain, DuplicateFieldGiven)
	../syntax/patterns: StringForm(QuotedString, RawString, PipeString, RawPipeString)
	../tables/diagnostic_code: PlainSyntaxCode(ExpectedExpressionDiagnostic, SingletonTupleDiagnostic, TupleArityDiagnostic)
	../tables/expected_token:
		NameConstruct(NameInStatementName, NameInFieldName, NameInRecordFieldName), ExpectedTokenDiagnostic(ExpectedRightParen, ExpectedRightBracket, ExpectedRightBrace),
		RightParenConstruct(RightParenInGroupedExpression, RightParenInCallArguments, RightParenInTupleExpression),
		RightBracketConstruct(RightBracketInSubscript, RightBracketInListLiteral),
		RightBraceConstruct(RightBraceInRecordLiteral, RightBraceInRecordUpdate, RightBraceInDictLiteral, RightBraceInVectorLiteral)
	../tables/span: Span, span_covering
	../tables/token:
		TokenKind(IdentifierToken, FuncKeyword, PureKeyword, IntLiteralToken, FloatLiteralToken, NormalStringToken, RawStringToken, PipeStringToken, RawPipeStringToken,
			InterpolatedStringToken, InterpolatedPipeStringToken, CharLiteralToken, TrueKeyword, FalseKeyword, VoidKeyword, UnderscoreSymbol,
			MinusSymbol, NotKeyword, LeftParenSymbol, RightParenSymbol, LeftBracketSymbol, RightBracketSymbol, LeftBraceSymbol, RightBraceSymbol, FatArrowSymbol, PipeSymbol, EqualSymbol, CommaSymbol,
			EndOfFileToken, NewlineToken, DotSymbol, IndentToken)
	binary_operators as Operators
	parse_state:
		ParseState, resumed_at, position, diagnostic_count, current_kind, current_token, current_span, current_literal, current_interpolation, advanced, peek_kind, span_start_line,
		consume_referenced_name, finished_name_use, finished_expression, finished_hole, report_at_current, report_diagnostic, report_unreachable_input, expect_token, entered_hole, left_hole


union ExpressionParse:
	ParsedExpression(Expression)
	UnsupportedExpression
	RejectedExpression


-- Recipes retain only authored syntax and checked values, never parser IDs.
-- The statement parser keeps them inside its own recipes and mints them later.
record ExpressionRecipe {
	span: Span,
	kind: RecipeKind
}


-- `name = value` in a record literal or update, before any ID exists.
record RecordFieldRecipe {
	name: WrittenName,
	value: ExpressionRecipe,
	span: Span
}


-- `key => value` in a dict literal, before any ID exists.
record EntryRecipe {
	key: ExpressionRecipe,
	value: ExpressionRecipe,
	span: Span
}


union RecipeKind:
	NameRecipe(WrittenName)
	IntegerRecipe(Int128)
	FloatRecipe(DecimalFloat)
	StringRecipe(StringForm, String)
	InterpolatedRecipe(InterpolationForm, List[InterpolationPieceRecipe])
	CharacterRecipe(Char)
	BooleanRecipe(Bool)
	VoidRecipe
	UnaryRecipe(UnaryOperator, ExpressionRecipe)
	BinaryRecipe(Operators.BinaryOperator, ExpressionRecipe, ExpressionRecipe)
	GroupingRecipe(ExpressionRecipe)
	CallRecipe(ExpressionRecipe, List[ExpressionRecipe])
	FieldRecipe(ExpressionRecipe, WrittenName)
	SubscriptRecipe(ExpressionRecipe, AtLeastOne[ExpressionRecipe])
	ListRecipe(List[ExpressionRecipe])
	TupleRecipe(SmallTuple[ExpressionRecipe])
	VectorRecipe(AtLeastOne[ExpressionRecipe])
	RecordRecipe(List[RecordFieldRecipe])
	UpdateRecipe(ExpressionRecipe, AtLeastOne[RecordFieldRecipe])
	DictRecipe(AtLeastOne[EntryRecipe])
	LambdaAtomRecipe(LambdaRecipe)


-- A text piece, or a hole whose expression is still a recipe.
private union InterpolationPieceRecipe:
	TextPieceRecipe(String)
	HolePieceRecipe(Span, ExpressionRecipe)


union RecipeParse:
	ParsedRecipe(ExpressionRecipe)
	UnsupportedRecipe
	RejectedRecipe


-- Left-spine frames avoid recursion proportional to authored chain length.
private union SpineFrame:
	BinaryFrame(Span, Operators.BinaryOperator, ExpressionRecipe)
	CallFrame(Span, List[ExpressionRecipe])
	FieldFrame(Span, WrittenName)
	SubscriptFrame(Span, AtLeastOne[ExpressionRecipe])


-- The brackets of a postfix step: a list literal is an atom, never a step.
private enum PostfixDelimiter:
	CallDelimiter
	SubscriptDelimiter


-- The bracket pair around a comma-separated item list.
private union ItemDelimiter:
	PostfixItems(PostfixDelimiter)
	ListItems
	BracedItems(BracedForm)


-- The four forms a `{` opens, each with its own missing-brace diagnostic.
private enum BracedForm:
	RecordForm
	UpdateForm
	DictForm
	VectorForm


-- A rejected or unsupported list is abandoned whole: only a list that read to
-- its end carries items.
private union ItemsParse[T]:
	ParsedItems(T)
	UnsupportedItems
	RejectedItems


-- The closing bracket, consumed, with its span.
private union ClosingParse:
	ClosedAt(Span)
	NotClosed(Abandonment)


-- Why recognition gave up. An unsupported shape restores the caller's entry
-- state; a rejected shape keeps the diagnostics it reported.
private enum Abandonment:
	UnsupportedShape
	RejectedShape


-- One step of a left-to-right chain. Only an extending step carries a value,
-- so a chain that stops or is abandoned cannot also claim a longer result.
private union ChainStep[T]:
	Extended(T)
	Stopped
	Abandoned(Abandonment)


-- The collection and indices of a subscript recipe, so that a statement can
-- turn `xs[i] = v` into an assignment to that place. A grouped subscript is a
-- grouping recipe, not a subscript, and has none.
pure func subscript_parts(recipe: ExpressionRecipe) -> Option[(ExpressionRecipe, AtLeastOne[ExpressionRecipe])]:
	match recipe.kind:
		SubscriptRecipe(collection, indices):
			Some((collection, indices))
		_:
			None


-- Whether the expression is a lambda whose body is an indented block: it ends
-- at its block's dedent, where the next statement may already begin.
pure func is_block_lambda(recipe: ExpressionRecipe) -> Bool:
	match recipe.kind:
		LambdaAtomRecipe(lambda):
			match lambda.body:
				BlockBodyRecipe(_): True
				_: False
		_:
			False


-- Recognizes one same-line expression without issuing ids. The caller owns
-- the boundary after it: a value, a condition and a statement end differently.
pure func parse_expression_recipe(state: ParseState) -> (ParseState, RecipeParse):
	parse_operators(state, state.span_start_line(state.current_span()), Operators.LOWEST_PRECEDENCE)


pure func parse_same_line_expression(state: ParseState) -> (ParseState, ExpressionParse):
	(parsed, result) = parse_expression_recipe(state)
	match result:
		UnsupportedRecipe:
			(state, UnsupportedExpression)
		RejectedRecipe:
			(parsed, RejectedExpression)
		ParsedRecipe(recipe):
			if not parsed.has_expression_boundary():
				(state, UnsupportedExpression)
			else:
				(minted, expression) = parsed.mint_recipe(recipe)

				-- A replay (a lambda's parameter types) moves the cursor and may
				-- report; neither may reach the caller.
				if minted.diagnostic_count() != state.diagnostic_count():
					(state, UnsupportedExpression)
				else:
					(minted.resumed_at(parsed.position()), ParsedExpression(expression))


-- An unindented dot or any indented tail may continue the legacy expression.
-- Leave the newline unconsumed and defer those shapes in full.
private pure func has_expression_boundary(state: ParseState) -> Bool:
	if state.current_kind() == EndOfFileToken:
		True
	else if state.current_kind() == NewlineToken:
		var ahead = 1
		while state.peek_kind(ahead) == NewlineToken:
			ahead += 1
		state.peek_kind(ahead) != DotSymbol and state.peek_kind(ahead) != IndentToken
	else:
		False


private pure func parse_operators(state: ParseState, line: Int, minimum: Int) -> (ParseState, RecipeParse):
	(parsed, prefix) = parse_prefix(state, line)
	match prefix:
		ParsedRecipe(first):
			(out, chain, abandoned) = extend_chain(parsed, first, pure func(current, left):
				operator_step(current, line, minimum, left)
			)
			(out, chain_recipe(chain, abandoned))
		_:
			(parsed, prefix)


-- Precedence climbing: the right operand binds only operators above this one.
private pure func operator_step(
	state: ParseState, line: Int, minimum: Int, left: ExpressionRecipe,
) -> (ParseState, ChainStep[ExpressionRecipe]):
	match Operators.binary_operator(state.current_kind()):
		Some(operator):
			precedence = Operators.operator_precedence(operator)
			if precedence < minimum:
				(state, Stopped)
			else:
				(after_right, right_result) = parse_operators(state.advanced(), line, precedence + 1)
				match right_result:
					ParsedRecipe(right):
						(after_right, Extended({ span = left.span.span_covering(right.span), kind = BinaryRecipe(operator, left, right) }))
					UnsupportedRecipe:
						(after_right, Abandoned(UnsupportedShape))
					RejectedRecipe:
						(after_right, Abandoned(RejectedShape))
		None:
			(state, Stopped)


private pure func parse_prefix(state: ParseState, line: Int) -> (ParseState, RecipeParse):
	(parsed, atom) = parse_atom(state, line)
	match atom:
		ParsedRecipe(first):
			(out, chain, abandoned) = extend_chain(parsed, first, pure func(current, receiver):
				postfix_step(current, line, receiver)
			)
			(out, chain_recipe(chain, abandoned))
		_:
			(parsed, atom)


-- Grow a chain one step at a time, so authored chain length never becomes
-- native stack depth. The final value is the chain as far as it was read.
private pure func extend_chain[T](
	state: ParseState, first: T, next_step: pure (ParseState, T) -> (ParseState, ChainStep[T]),
) -> (ParseState, T, Option[Abandonment]):
	var out = state
	var current = first
	var abandoned: Option[Abandonment] = None
	var reading = True
	while reading:
		(after_step, step) = next_step(out, current)
		out = after_step
		match step:
			Extended(longer):
				current = longer
			Stopped:
				reading = False
			Abandoned(reason):
				abandoned = Some(reason)
				reading = False
	(out, current, abandoned)


private pure func chain_recipe(recipe: ExpressionRecipe, abandoned: Option[Abandonment]) -> RecipeParse:
	match abandoned:
		None: ParsedRecipe(recipe)
		Some(UnsupportedShape): UnsupportedRecipe
		Some(RejectedShape): RejectedRecipe


-- End of file counts as the current line, so its diagnostics stay on that line.
private pure func on_line(state: ParseState, line: Int) -> Bool:
	state.current_kind() == EndOfFileToken or state.span_start_line(state.current_span()) == line


-- One same-line member access, call or subscript, or the end of the chain.
private pure func postfix_step(
	state: ParseState, line: Int, receiver: ExpressionRecipe,
) -> (ParseState, ChainStep[ExpressionRecipe]):
	if not state.on_line(line):
		(state, Stopped)
	else:
		match state.current_kind():
			DotSymbol: member_step(state, line, receiver)
			LeftParenSymbol: delimited_step(state, line, receiver, CallDelimiter)
			LeftBracketSymbol: delimited_step(state, line, receiver, SubscriptDelimiter)
			_: (state, Stopped)


private pure func member_step(
	state: ParseState, line: Int, receiver: ExpressionRecipe,
) -> (ParseState, ChainStep[ExpressionRecipe]):
	member_entry = state.advanced()
	if not member_entry.on_line(line):
		(state, Abandoned(UnsupportedShape))
	else:
		(after_name, name) = member_entry.consume_referenced_name(NameInFieldName)
		if after_name.diagnostic_count() != member_entry.diagnostic_count():
			(after_name, Abandoned(RejectedShape))
		else:
			(after_name, Extended({ span = receiver.span.span_covering(name.span), kind = FieldRecipe(receiver, name) }))


private pure func delimited_step(
	state: ParseState, line: Int, receiver: ExpressionRecipe, delimiter: PostfixDelimiter,
) -> (ParseState, ChainStep[ExpressionRecipe]):
	opened = state.advanced()
	match delimiter:
		CallDelimiter:
			(after_items, items) = parse_optional_items(opened, line, PostfixItems(CallDelimiter))
			(closed, closed_items) = after_items.closing_items(items, line, PostfixItems(CallDelimiter))
			closed.postfix_items_step(receiver, closed_items, pure func(arguments):
				CallRecipe(receiver, arguments)
			)
		SubscriptDelimiter:
			(after_items, items) = parse_nonempty_items(opened, line, PostfixItems(SubscriptDelimiter))
			(closed, closed_items) = after_items.closing_items(items, line, PostfixItems(SubscriptDelimiter))
			closed.postfix_items_step(receiver, closed_items, pure func(indices):
				SubscriptRecipe(receiver, indices)
			)


private pure func postfix_items_step[T](
	state: ParseState, receiver: ExpressionRecipe, items: ItemsParse[(T, Span)], recipe_kind: pure (T) -> RecipeKind,
) -> (ParseState, ChainStep[ExpressionRecipe]):
	match items:
		ParsedItems((values, end_span)):
			(state, Extended({ span = receiver.span.span_covering(end_span), kind = recipe_kind(values) }))
		UnsupportedItems:
			(state, Abandoned(UnsupportedShape))
		RejectedItems:
			(state, Abandoned(RejectedShape))


private pure func closing_token(delimiter: ItemDelimiter) -> TokenKind:
	match delimiter:
		PostfixItems(CallDelimiter): RightParenSymbol
		PostfixItems(SubscriptDelimiter) | ListItems: RightBracketSymbol
		BracedItems(_): RightBraceSymbol


private pure func unclosed_delimiter_diagnostic(delimiter: ItemDelimiter) -> ExpectedTokenDiagnostic:
	match delimiter:
		PostfixItems(CallDelimiter): ExpectedRightParen(RightParenInCallArguments)
		PostfixItems(SubscriptDelimiter): ExpectedRightBracket(RightBracketInSubscript)
		ListItems: ExpectedRightBracket(RightBracketInListLiteral)
		BracedItems(RecordForm): ExpectedRightBrace(RightBraceInRecordLiteral)
		BracedItems(UpdateForm): ExpectedRightBrace(RightBraceInRecordUpdate)
		BracedItems(DictForm): ExpectedRightBrace(RightBraceInDictLiteral)
		BracedItems(VectorForm): ExpectedRightBrace(RightBraceInVectorLiteral)


-- Pair parsed items with their consumed closing bracket. A failure to close
-- abandons the items whole, with the reason `close_items` gave.
private pure func closing_items[T](
	state: ParseState, items: ItemsParse[T], line: Int, delimiter: ItemDelimiter,
) -> (ParseState, ItemsParse[(T, Span)]):
	match items:
		ParsedItems(values):
			(closed, closing) = state.close_items(line, delimiter)
			match closing:
				ClosedAt(end_span): (closed, ParsedItems((values, end_span)))
				NotClosed(UnsupportedShape): (closed, UnsupportedItems)
				NotClosed(RejectedShape): (closed, RejectedItems)
		UnsupportedItems:
			(state, UnsupportedItems)
		RejectedItems:
			(state, RejectedItems)


-- Consume the closing bracket on the opening line. At end of source the list
-- is unclosed and rejected; any other token (a newline, a different bracket,
-- a missing comma) belongs to a shape this slice leaves unsupported.
private pure func close_items(state: ParseState, line: Int, delimiter: ItemDelimiter) -> (ParseState, ClosingParse):
	end = closing_token(delimiter)
	if state.current_kind() == end and state.on_line(line):
		(state.advanced(), ClosedAt(state.current_span()))
	else if state.current_kind() == EndOfFileToken:
		(state.expect_token(end, unclosed_delimiter_diagnostic(delimiter)), NotClosed(RejectedShape))
	else:
		(state, NotClosed(UnsupportedShape))


-- Call arguments and list items may be empty; subscript indices may not.
-- Recursion follows item bracket nesting, never the callee spine.
private pure func parse_optional_items(state: ParseState, line: Int, delimiter: ItemDelimiter) -> (ParseState, ItemsParse[List[ExpressionRecipe]]):
	if state.current_kind() == closing_token(delimiter):
		(state, ParsedItems([]))
	else:
		(after_items, items) = parse_nonempty_items(state, line, delimiter)
		match items:
			ParsedItems(values):
				(after_items, ParsedItems(at_least_one_items(values)))
			UnsupportedItems:
				(after_items, UnsupportedItems)
			RejectedItems:
				(after_items, RejectedItems)


-- A missing first item reports `expected expression` at the closing bracket,
-- which is how an empty subscript is rejected.
private pure func parse_nonempty_items(
	state: ParseState, line: Int, delimiter: ItemDelimiter,
) -> (ParseState, ItemsParse[AtLeastOne[ExpressionRecipe]]):
	if state.current_kind() == EndOfFileToken:
		(state.expect_token(closing_token(delimiter), unclosed_delimiter_diagnostic(delimiter)), RejectedItems)
	else:
		-- Read directly, not through `expression_item`: this frame is on the stack
		-- once per level of bracket nesting.
		(first_state, first) = parse_operators(state, line, Operators.LOWEST_PRECEDENCE)
		match first:
			ParsedRecipe(value):
				items_after(first_state, closing_token(delimiter), ReportsOnlyUnclosed, value, pure func(current):
					expression_item(current, line)
				)
			UnsupportedRecipe:
				(first_state, UnsupportedItems)
			RejectedRecipe:
				(first_state, RejectedItems)


private pure func expression_item(state: ParseState, line: Int) -> (ParseState, ItemsParse[ExpressionRecipe]):
	(after_item, item) = parse_operators(state, line, Operators.LOWEST_PRECEDENCE)
	match item:
		ParsedRecipe(value): (after_item, ParsedItems(value))
		UnsupportedRecipe: (after_item, UnsupportedItems)
		RejectedRecipe: (after_item, RejectedItems)


-- The items that follow `first` as comma-separated, with an optional trailing
-- comma before `end`, each read by `read`.
private pure func items_after[T](
	state: ParseState, end: TokenKind, at_end_of_source: CommaBeforeEndOfSource, first: T,
	read: pure (ParseState) -> (ParseState, ItemsParse[T]),
) -> (ParseState, ItemsParse[AtLeastOne[T]]):
	no_items: List[T] = []
	(out, rest, abandoned) = extend_chain(state, no_items, pure func(current, items):
		next_item_step(current, end, at_end_of_source, items, read)
	)
	match abandoned:
		None: (out, ParsedItems({ first = first, rest = rest }))
		Some(UnsupportedShape): (out, UnsupportedItems)
		Some(RejectedShape): (out, RejectedItems)


-- What the frozen parser does with a comma that is followed by the end of
-- source. A call, subscript, list, record or update ignores it and reports
-- only the missing closing bracket. A tuple, vector or dict reads a missing
-- item there, reports it, and counts it, which this slice does not
-- reproduce, so it defers.
private enum CommaBeforeEndOfSource:
	ReportsOnlyUnclosed
	CountsAsMissingItem


-- A comma introduces the next item, or trails before the closing delimiter.
private pure func next_item_step[T](
	state: ParseState, end: TokenKind, at_end_of_source: CommaBeforeEndOfSource, items: List[T],
	read: pure (ParseState) -> (ParseState, ItemsParse[T]),
) -> (ParseState, ChainStep[List[T]]):
	if state.current_kind() != CommaSymbol:
		(state, Stopped)
	else:
		after_comma = state.advanced()
		if after_comma.current_kind() == end:
			(after_comma, Stopped)
		else if after_comma.current_kind() == EndOfFileToken:
			match at_end_of_source:
				ReportsOnlyUnclosed: (after_comma, Stopped)
				CountsAsMissingItem: (after_comma, Abandoned(UnsupportedShape))
		else:
			(after_item, item) = read(after_comma)
			match item:
				ParsedItems(value):
					(after_item, Extended(items.append(value)))
				UnsupportedItems:
					(after_item, Abandoned(UnsupportedShape))
				RejectedItems:
					(after_item, Abandoned(RejectedShape))


-- An interpolated string whose every hole is one clean expression. A hole is
-- lexed and read on its own, so the string's recipe holds hole recipes; any
-- hole outside the grammar leaves the whole string unsupported.
private pure func parse_interpolated_string(state: ParseState, span: Span) -> (ParseState, RecipeParse):
	form: InterpolationForm = if state.current_kind() == InterpolatedPipeStringToken:
		PipeInterpolation
	else:
		QuotedInterpolation
	match state.current_interpolation():
		None:
			-- The token cursor checked that an interpolated string token indexes a scan.
			report_unreachable_input("an interpolated string token indexes its scan")
			(state, UnsupportedRecipe)
		Some(scan):
			no_pieces: List[InterpolationPieceRecipe] = []
			(out, pieces, abandoned) = extend_chain(state, no_pieces, pure func(current, read):
				interpolation_piece_step(current, scan.pieces, read)
			)
			match abandoned:
				None:
					(out.advanced(), ParsedRecipe({ span = span, kind = InterpolatedRecipe(form, pieces) }))
				Some(_):
					(state, UnsupportedRecipe)


-- The next piece of the string, after the `read` ones: a text piece, a hole
-- read to a recipe, or the end. A hole outside the grammar abandons the string.
private pure func interpolation_piece_step(
	state: ParseState, pieces: List[ScannedPiece], read: List[InterpolationPieceRecipe],
) -> (ParseState, ChainStep[List[InterpolationPieceRecipe]]):
	match pieces.get(read.length()):
		None:
			(state, Stopped)
		Some(ScannedText(text)):
			(state, Extended(read.append(TextPieceRecipe(text.text))))
		Some(ScannedHole(hole)):
			(after_hole, value) = state.parse_hole(hole)
			match value:
				Some(recipe):
					(after_hole, Extended(read.append(HolePieceRecipe(hole.span, recipe))))
				None:
					(state, Abandoned(UnsupportedShape))


-- One hole's expression: the whole of the hole's own tokens, and nothing else.
private pure func parse_hole(state: ParseState, hole: HoleScan) -> (ParseState, Option[ExpressionRecipe]):
	match state.entered_hole(hole):
		None:
			(state, None)
		Some((inside, parked)):
			(read, parsed) = parse_expression_recipe(inside)
			match parsed:
				ParsedRecipe(value):
					if read.current_kind() == EndOfFileToken:
						(read.left_hole(parked), Some(value))
					else:
						(state, None)
				_:
					(state, None)


private pure func parse_atom(state: ParseState, line: Int) -> (ParseState, RecipeParse):
	if not state.on_line(line):
		(state, UnsupportedRecipe)
	else:
		span = state.current_span()
		match state.current_kind():
			IdentifierToken:
				(advanced, name) = state.consume_referenced_name(NameInStatementName)
				(advanced, ParsedRecipe({ span = span, kind = NameRecipe(name) }))
			IntLiteralToken | FloatLiteralToken:
				match state.current_literal():
					Some(IntegerValue(magnitude)):
						(state.advanced(), ParsedRecipe({ span = span, kind = IntegerRecipe(magnitude) }))
					Some(FloatValue(value)):
						(state.advanced(), ParsedRecipe({ span = span, kind = FloatRecipe(value) }))
					_:
						(state, UnsupportedRecipe)
			NormalStringToken | RawStringToken | PipeStringToken | RawPipeStringToken:
				match state.current_literal():
					Some(TextValue(text)):
						form: StringForm = match state.current_kind():
							RawStringToken: RawString
							PipeStringToken: PipeString
							RawPipeStringToken: RawPipeString
							_: QuotedString
						(state.advanced(), ParsedRecipe({ span = span, kind = StringRecipe(form, text) }))
					_:
						-- The token cursor checked that a string token's literal is text.
						report_unreachable_input("a string token indexes a text literal")
						(state, UnsupportedRecipe)
			InterpolatedStringToken | InterpolatedPipeStringToken:
				state.parse_interpolated_string(span)
			CharLiteralToken:
				-- The token cursor validated the payload as a Unicode scalar value.
				(state.advanced(), ParsedRecipe({ span = span, kind = CharacterRecipe(to_char(state.current_token().payload)) }))
			FuncKeyword | PureKeyword:
				(remaining, lambda) = parse_lambda_recipe(state)
				match lambda:
					Some(recipe):
						(remaining, ParsedRecipe({ span = recipe.span, kind = LambdaAtomRecipe(recipe) }))
					None:
						(state, UnsupportedRecipe)
			TrueKeyword | FalseKeyword:
				(state.advanced(), ParsedRecipe({ span = span, kind = BooleanRecipe(state.current_kind() == TrueKeyword) }))
			VoidKeyword | UnderscoreSymbol:
				(state.advanced(), ParsedRecipe({ span = span, kind = VoidRecipe }))
			MinusSymbol | NotKeyword:
				operator = if state.current_kind() == MinusSymbol:
					Negate
				else:
					LogicalNot
				(parsed, operand) = parse_prefix(state.advanced(), line)
				match operand:
					ParsedRecipe(value):
						(parsed, ParsedRecipe({ span = span.span_covering(value.span), kind = UnaryRecipe(operator, value) }))
					_:
						(parsed, operand)
			LeftParenSymbol:
				parse_parenthesized(state, line, span)
			LeftBracketSymbol:
				parse_list_literal(state, line, span)
			LeftBraceSymbol:
				parse_braced(state, line, span)
			EndOfFileToken | RightParenSymbol | RightBracketSymbol:
				(state.report_at_current(ExpectedExpressionDiagnostic), RejectedRecipe)
			_:
				(state, UnsupportedRecipe)


-- The arms below are functions of their own, not inline in `parse_atom`: that
-- frame is on the native stack once for every level of bracket nesting, and
-- the 1,000-deep proof of section 3.14 has to fit the Linux stack.
private pure func parse_parenthesized(state: ParseState, line: Int, span: Span) -> (ParseState, RecipeParse):
	opened = state.advanced()
	if opened.current_kind() == RightParenSymbol and opened.span_start_line(opened.current_span()) == line:
		(opened.advanced(), ParsedRecipe({ span = span.span_covering(opened.current_span()), kind = VoidRecipe }))
	else:
		(parsed, inner) = parse_operators(opened, line, Operators.LOWEST_PRECEDENCE)
		match inner:
			ParsedRecipe(value):
				if parsed.current_kind() == CommaSymbol:
					parsed.parse_tuple_rest(line, span, value)
				else if parsed.current_kind() == RightParenSymbol and parsed.span_start_line(parsed.current_span()) == line:
					-- Names retain their token span through every grouping layer.
					group_span = if value.keeps_token_span():
						value.span
					else:
						span.span_covering(parsed.current_span())
					(parsed.advanced(), ParsedRecipe({ span = group_span, kind = GroupingRecipe(value) }))
				else if parsed.current_kind() == EndOfFileToken:
					(parsed.expect_token(RightParenSymbol, ExpectedRightParen(RightParenInGroupedExpression)), RejectedRecipe)
				else:
					(parsed, UnsupportedRecipe)
			_:
				(parsed, inner)


private pure func parse_list_literal(state: ParseState, line: Int, span: Span) -> (ParseState, RecipeParse):
	(after_items, items) = parse_optional_items(state.advanced(), line, ListItems)
	(closed, closed_items) = after_items.closing_items(items, line, ListItems)
	match closed_items:
		ParsedItems((elements, end_span)):
			(closed, ParsedRecipe({ span = span.span_covering(end_span), kind = ListRecipe(elements) }))
		UnsupportedItems:
			(closed, UnsupportedRecipe)
		RejectedItems:
			(closed, RejectedRecipe)


-- A field name that is a soft keyword (`{on = 1}`) does not start a record
-- field here, because only an identifier token does, so such a record defers.
-- `{` opens a record literal (`{}` or `{name = value}`), a record update
-- (`{record | name = value}`), a dict literal (`{key => value}`) or a vector
-- literal (`{a, b}`), told apart as the frozen parser does: by a leading
-- `name =`, then by the token after the first expression.
private pure func parse_braced(state: ParseState, line: Int, open_span: Span) -> (ParseState, RecipeParse):
	opened = state.advanced()
	if opened.current_kind() == RightBraceSymbol and opened.on_line(line):
		(opened.advanced(), ParsedRecipe({ span = open_span.span_covering(opened.current_span()), kind = RecordRecipe([]) }))
	else if opened.starts_field():
		(after_items, items) = record_fields_from(opened, line)
		braced_recipe(after_items, items, line, RecordForm, open_span, pure func(fields):
			fields.without_repeats().map(pure func(distinct):
				RecordRecipe(at_least_one_items(distinct))
			)
		)
	else if opened.current_kind() == EndOfFileToken:
		-- The frozen parser reads a missing first item before the missing brace.
		missing = opened.report_at_current(ExpectedExpressionDiagnostic)
		(missing.expect_token(RightBraceSymbol, unclosed_delimiter_diagnostic(BracedItems(VectorForm))), RejectedRecipe)
	else:
		(after_first, first) = parse_operators(opened, line, Operators.LOWEST_PRECEDENCE)
		match first:
			ParsedRecipe(value):
				parse_braced_after_first(after_first, line, open_span, value)
			UnsupportedRecipe:
				(after_first, UnsupportedRecipe)
			RejectedRecipe:
				(after_first, RejectedRecipe)


-- The token after the first expression picks the form: `=>` a dict, `|` a
-- record update, anything else a vector.
private pure func parse_braced_after_first(
	state: ParseState, line: Int, open_span: Span, first: ExpressionRecipe,
) -> (ParseState, RecipeParse):
	match state.current_kind():
		FatArrowSymbol:
			(after_items, items) = dict_entries_from(state, line, first)
			braced_recipe(after_items, items, line, DictForm, open_span, pure func(entries):
				Some(DictRecipe(entries))
			)
		PipeSymbol:
			after_bar = state.advanced()
			if after_bar.current_kind() == EndOfFileToken:
				(after_bar.expect_token(RightBraceSymbol, unclosed_delimiter_diagnostic(BracedItems(UpdateForm))), RejectedRecipe)
			else:
				(after_items, items) = record_fields_from(after_bar, line)
				braced_recipe(after_items, items, line, UpdateForm, open_span, pure func(fields):
					fields.without_repeats().map(pure func(distinct):
						UpdateRecipe(first, distinct)
					)
				)
		_:
			(after_items, items) = items_after(state, RightBraceSymbol, CountsAsMissingItem, first, pure func(current):
				expression_item(current, line)
			)
			braced_recipe(after_items, items, line, VectorForm, open_span, pure func(elements):
				Some(VectorRecipe(elements))
			)


private pure func starts_field(state: ParseState) -> Bool:
	state.current_kind() == IdentifierToken and state.peek_kind(1) == EqualSymbol


-- Close a braced form's items and wrap them. A form whose items were already
-- reported as a rejection (a repeated record field) has no recipe, and is
-- rejected after its closing brace, so the frozen parser's diagnostics keep
-- their order.
private pure func braced_recipe[T](
	state: ParseState, items: ItemsParse[T], line: Int, form: BracedForm, open_span: Span,
	recipe_kind: pure (T) -> Option[RecipeKind],
) -> (ParseState, RecipeParse):
	(closed, closed_items) = state.closing_items(items, line, BracedItems(form))
	match closed_items:
		ParsedItems((values, end_span)):
			match recipe_kind(values):
				Some(kind): (closed, ParsedRecipe({ span = open_span.span_covering(end_span), kind = kind }))
				None: (closed, RejectedRecipe)
		UnsupportedItems:
			(closed, UnsupportedRecipe)
		RejectedItems:
			(closed, RejectedRecipe)


-- Record fields, or fields that repeat a name. Repetition is reported where
-- the fields end, but the record is still read to its closing brace.
private union FieldList:
	DistinctFields(AtLeastOne[RecordFieldRecipe])
	RepeatedFields


private pure func without_repeats(fields: FieldList) -> Option[AtLeastOne[RecordFieldRecipe]]:
	match fields:
		DistinctFields(distinct): Some(distinct)
		RepeatedFields: None


private pure func record_fields_from(state: ParseState, line: Int) -> (ParseState, ItemsParse[FieldList]):
	(first_state, first) = field_item(state, line)
	match first:
		ParsedItems(value):
			(after_fields, fields) = items_after(first_state, RightBraceSymbol, ReportsOnlyUnclosed, value, pure func(current):
				field_item(current, line)
			)
			match fields:
				ParsedItems(read_fields):
					(reported, list) = after_fields.reported_repeated_fields(read_fields)
					(reported, ParsedItems(list))
				UnsupportedItems:
					(after_fields, UnsupportedItems)
				RejectedItems:
					(after_fields, RejectedItems)
		UnsupportedItems:
			(first_state, UnsupportedItems)
		RejectedItems:
			(first_state, RejectedItems)


-- Each later field that repeats an earlier name is reported at its own name,
-- pointing at the first field of that name.
private pure func reported_repeated_fields(state: ParseState, fields: AtLeastOne[RecordFieldRecipe]) -> (ParseState, FieldList):
	var out = state
	var seen: List[RecordFieldRecipe] = []
	var repeated = False
	for field in at_least_one_items(fields):
		match seen.first_named(field.name):
			Some(earlier):
				out = out.report_diagnostic(field.name.span, DuplicateFieldGiven(earlier.name.span))
				repeated = True
			None:
				void
		seen = seen.append(field)
	if repeated:
		(out, RepeatedFields)
	else:
		(out, DistinctFields(fields))


-- Spellings are per module, and a parse covers one module, so the spelling
-- index identifies a name.
private pure func first_named(fields: List[RecordFieldRecipe], name: WrittenName) -> Option[RecordFieldRecipe]:
	var first: Option[RecordFieldRecipe] = None
	for field in fields:
		if first.is_none() and spelling_index(field.name.spelling) == spelling_index(name.spelling):
			first = Some(field)
	first


private pure func field_item(state: ParseState, line: Int) -> (ParseState, ItemsParse[RecordFieldRecipe]):
	if not (state.on_line(line) and state.starts_field()):
		(state, UnsupportedItems)
	else:
		(after_name, name) = state.consume_referenced_name(NameInRecordFieldName)
		(after_value, value) = expression_item(after_name.advanced(), line)
		match value:
			ParsedItems(recipe):
				(after_value, ParsedItems({ name = name, value = recipe, span = name.span.span_covering(recipe.span) }))
			UnsupportedItems:
				(after_value, UnsupportedItems)
			RejectedItems:
				(after_value, RejectedItems)


-- Dict entries from the first key, which the caller read and which is
-- followed by `=>`.
private pure func dict_entries_from(state: ParseState, line: Int, first_key: ExpressionRecipe) -> (ParseState, ItemsParse[AtLeastOne[EntryRecipe]]):
	(first_state, first) = entry_after_key(state, line, first_key)
	match first:
		ParsedItems(entry):
			items_after(first_state, RightBraceSymbol, CountsAsMissingItem, entry, pure func(current):
				entry_item(current, line)
			)
		UnsupportedItems:
			(first_state, UnsupportedItems)
		RejectedItems:
			(first_state, RejectedItems)


private pure func entry_item(state: ParseState, line: Int) -> (ParseState, ItemsParse[EntryRecipe]):
	(after_key, key) = expression_item(state, line)
	match key:
		ParsedItems(recipe):
			entry_after_key(after_key, line, recipe)
		UnsupportedItems:
			(after_key, UnsupportedItems)
		RejectedItems:
			(after_key, RejectedItems)


-- `=> value` after a key. The frozen parser reports a missing arrow; this slice defers it.
private pure func entry_after_key(state: ParseState, line: Int, key: ExpressionRecipe) -> (ParseState, ItemsParse[EntryRecipe]):
	if state.current_kind() != FatArrowSymbol or not state.on_line(line):
		(state, UnsupportedItems)
	else:
		(after_value, value) = expression_item(state.advanced(), line)
		match value:
			ParsedItems(recipe):
				(after_value, ParsedItems({ key = key, value = recipe, span = key.span.span_covering(recipe.span) }))
			UnsupportedItems:
				(after_value, UnsupportedItems)
			RejectedItems:
				(after_value, RejectedItems)


-- The rest of a tuple after its first item and the comma that proves it is not
-- a grouping. The frozen parser reads every item before judging arity, so an
-- out-of-range count is rejected only once the closing parenthesis (or the
-- end of source) is reached, with the same diagnostics and spans. Elements are
-- kept ID-free: a rejected tuple issues no IDs, and a one-element `(x,)` or a
-- tuple of more than four elements has no `TupleLiteral` to hold it.
private pure func parse_tuple_rest(
	state: ParseState, line: Int, open_span: Span, first: ExpressionRecipe,
) -> (ParseState, RecipeParse):
	(after_items, items) = items_after(state, RightParenSymbol, CountsAsMissingItem, first, pure func(current):
		expression_item(current, line)
	)
	match items:
		UnsupportedItems:
			(after_items, UnsupportedRecipe)
		RejectedItems:
			(after_items, RejectedRecipe)
		ParsedItems(read_items):
			rest = read_items.rest
			if after_items.current_kind() == RightParenSymbol and after_items.on_line(line):
				span = open_span.span_covering(after_items.current_span())
				(counted, tuple) = after_items.advanced().counted_tuple(span, first, rest)
				match tuple:
					Some(elements): (counted, ParsedRecipe({ span = span, kind = TupleRecipe(elements) }))
					None: (counted, RejectedRecipe)
			else if after_items.current_kind() == EndOfFileToken:
				unclosed = after_items.expect_token(RightParenSymbol, ExpectedRightParen(RightParenInTupleExpression))
				(counted, _) = unclosed.counted_tuple(open_span.span_covering(first.span), first, rest)
				(counted, RejectedRecipe)
			else:
				(after_items, UnsupportedRecipe)


-- A tuple holds two to four elements. Any other count is reported over the
-- tuple's span, a single element as `(x,)` and a longer one as an arity error,
-- and has no tuple to return.
private pure func counted_tuple(
	state: ParseState, span: Span, first: ExpressionRecipe, rest: List[ExpressionRecipe],
) -> (ParseState, Option[SmallTuple[ExpressionRecipe]]):
	match rest:
		[]: (state.report_diagnostic(span, Plain(SingletonTupleDiagnostic)), None)
		[second]: (state, Some(Pair(first, second)))
		[second, third]: (state, Some(Triple(first, second, third)))
		[second, third, fourth]: (state, Some(Quadruple(first, second, third, fourth)))
		_: (state.report_diagnostic(span, Plain(TupleArityDiagnostic)), None)


-- The parser and every later walker must loop over left spines: binary
-- operands and the receivers of member access, calls and subscripts. Frames
-- are folded inside out, preserving the frozen parser's postorder ID issuance.
pure func mint_recipe(state: ParseState, recipe: ExpressionRecipe) -> (ParseState, Expression):
	var base = recipe
	var frames: List[SpineFrame] = []
	var walking = True
	while walking:
		match base.kind:
			BinaryRecipe(operator, left, right):
				frames = frames.append(BinaryFrame(base.span, operator, right))
				base = left
			CallRecipe(callee, args):
				frames = frames.append(CallFrame(base.span, args))
				base = callee
			FieldRecipe(receiver, name):
				frames = frames.append(FieldFrame(base.span, name))
				base = receiver
			SubscriptRecipe(receiver, indices):
				frames = frames.append(SubscriptFrame(base.span, indices))
				base = receiver
			_:
				walking = False
	(parsed, value) = state.mint_nonbinary_recipe(base)
	var out = parsed
	var left = value
	for frame in frames.reverse():
		match frame:
			BinaryFrame(span, operator, right_recipe):
				(after_right, right) = out.mint_recipe(right_recipe)
				(minted, parent) = after_right.finished_expression(span, operator_expression_kind(operator, left, right))
				out = minted
				left = parent
			FieldFrame(span, name):
				(after_name, use) = out.finished_name_use(name)
				(minted, parent) = after_name.finished_expression(span, FieldAccess(left, use))
				out = minted
				left = parent
			CallFrame(span, args):
				var values: List[Expression] = []
				for argument in args:
					(after_arg, value) = out.mint_recipe(argument)
					out = after_arg
					values = values.append(value)
				(minted, parent) = out.finished_expression(span, Call(left, values))
				out = minted
				left = parent
			SubscriptFrame(span, indices):
				(after_first, first) = out.mint_recipe(indices.first)
				out = after_first
				var rest: List[Expression] = []
				for index in indices.rest:
					(after_index, value) = out.mint_recipe(index)
					out = after_index
					rest = rest.append(value)
				(minted, parent) = out.finished_expression(span, Subscript(left, { first = first, rest = rest }))
				out = minted
				left = parent
	(out, left)


private pure func mint_nonbinary_recipe(state: ParseState, recipe: ExpressionRecipe) -> (ParseState, Expression):
	match recipe.kind:
		NameRecipe(name):
			(after_use, use) = state.finished_name_use(name)
			after_use.finished_expression(recipe.span, NameReference(use))
		IntegerRecipe(magnitude): state.finished_expression(recipe.span, IntegerLiteral(magnitude))
		FloatRecipe(value): state.finished_expression(recipe.span, FloatLiteral(value))
		StringRecipe(form, text): state.finished_expression(recipe.span, StringLiteral(form, text))
		CharacterRecipe(character): state.finished_expression(recipe.span, CharacterLiteral(character))
		InterpolatedRecipe(form, pieces):
			var out: ParseState = state
			var minted: List[InterpolationPiece] = []
			for piece in pieces:
				match piece:
					TextPieceRecipe(text):
						minted = minted.append(InterpolationText(text))
					HolePieceRecipe(hole_span, value_recipe):
						(after_value, value) = mint_recipe(out, value_recipe)
						(after_hole, hole) = after_value.finished_hole(value, hole_span)
						out = after_hole
						minted = minted.append(InterpolationHole(hole))
			out.finished_expression(recipe.span, InterpolatedString(form, minted))
		LambdaAtomRecipe(lambda): mint_lambda_recipe(state, lambda)
		BooleanRecipe(value): state.finished_expression(recipe.span, BooleanLiteral(value))
		VoidRecipe: state.finished_expression(recipe.span, VoidValue)
		UnaryRecipe(operator, operand):
			(parsed, value) = state.mint_recipe(operand)
			parsed.finished_expression(recipe.span, Unary(operator, value))
		GroupingRecipe(inner):
			(parsed, value) = state.mint_recipe(inner)
			(parsed, { value | span = recipe.span })
		TupleRecipe(items): state.minted_tuple(recipe.span, items)
		VectorRecipe(items): state.minted_vector(recipe.span, items)
		RecordRecipe(fields): state.minted_record(recipe.span, fields)
		UpdateRecipe(base, fields): state.minted_update(recipe.span, base, fields)
		DictRecipe(entries): state.minted_dict(recipe.span, entries)
		ListRecipe(items): state.minted_list(recipe.span, items)
		BinaryRecipe(_, _, _) | CallRecipe(_, _) | FieldRecipe(_, _) | SubscriptRecipe(_, _):
			-- This recursion boundary is total; mint_recipe owns the left-spine loop.
			state.mint_recipe(recipe)


-- Each aggregate is minted by a function of its own, so the frame of
-- `mint_nonbinary_recipe`, which is on the native stack once per level of
-- bracket nesting, stays small enough for the 1,000-deep proof on Linux.
private pure func minted_tuple(state: ParseState, span: Span, items: SmallTuple[ExpressionRecipe]) -> (ParseState, Expression):
	match items:
		Pair(first, second):
			(after_first, first_value) = state.mint_recipe(first)
			(after_second, second_value) = after_first.mint_recipe(second)
			after_second.finished_expression(span, TupleLiteral(Pair(first_value, second_value)))
		Triple(first, second, third):
			(after_first, first_value) = state.mint_recipe(first)
			(after_second, second_value) = after_first.mint_recipe(second)
			(after_third, third_value) = after_second.mint_recipe(third)
			after_third.finished_expression(span, TupleLiteral(Triple(first_value, second_value, third_value)))
		Quadruple(first, second, third, fourth):
			(after_first, first_value) = state.mint_recipe(first)
			(after_second, second_value) = after_first.mint_recipe(second)
			(after_third, third_value) = after_second.mint_recipe(third)
			(after_fourth, fourth_value) = after_third.mint_recipe(fourth)
			after_fourth.finished_expression(span, TupleLiteral(Quadruple(first_value, second_value, third_value, fourth_value)))


private pure func minted_list(state: ParseState, span: Span, items: List[ExpressionRecipe]) -> (ParseState, Expression):
	(minted, elements) = state.minted_all(items)
	minted.finished_expression(span, ListLiteral(elements))


private pure func minted_vector(state: ParseState, span: Span, items: AtLeastOne[ExpressionRecipe]) -> (ParseState, Expression):
	(minted, elements) = state.minted_all(at_least_one_items(items))
	minted.finished_expression(span, VectorLiteral(elements))


private pure func minted_record(state: ParseState, span: Span, fields: List[RecordFieldRecipe]) -> (ParseState, Expression):
	(minted, values) = state.minted_fields(fields)
	minted.finished_expression(span, RecordLiteral(values))


private pure func minted_update(state: ParseState, span: Span, base: ExpressionRecipe, fields: AtLeastOne[RecordFieldRecipe]) -> (ParseState, Expression):
	(after_base, base_value) = state.mint_recipe(base)
	(minted, values) = after_base.minted_fields(at_least_one_items(fields))
	minted.finished_expression(span, RecordUpdate(base_value, values))


private pure func minted_dict(state: ParseState, span: Span, entries: AtLeastOne[EntryRecipe]) -> (ParseState, Expression):
	var out = state
	var dict_entries: List[DictEntry] = []
	for entry in at_least_one_items(entries):
		(after_key, key) = out.mint_recipe(entry.key)
		(after_value, value) = after_key.mint_recipe(entry.value)
		out = after_value
		dict_entries = dict_entries.append({ key = key, value = value, span = entry.span })
	out.finished_expression(span, DictLiteral(dict_entries))


private pure func minted_all(state: ParseState, recipes: List[ExpressionRecipe]) -> (ParseState, List[Expression]):
	var out = state
	var values: List[Expression] = []
	for recipe in recipes:
		(after_recipe, value) = out.mint_recipe(recipe)
		out = after_recipe
		values = values.append(value)
	(out, values)


-- A field's name is minted before its value, in written order.
private pure func minted_fields(state: ParseState, fields: List[RecordFieldRecipe]) -> (ParseState, List[NamedValue]):
	var out = state
	var values: List[NamedValue] = []
	for field in fields:
		(after_name, use) = out.finished_name_use(field.name)
		(after_value, value) = after_name.mint_recipe(field.value)
		out = after_value
		values = values.append({ name = use, value = value, span = field.span })
	(out, values)


-- Mapping is exhaustive: logical and range forms never enter ordinary Binary.
private pure func operator_expression_kind(operator: Operators.BinaryOperator, left: Expression, right: Expression) -> ExpressionKind:
	match operator:
		Operators.OrOperator: ShortCircuit(LogicalOr, left, right)
		Operators.AndOperator: ShortCircuit(LogicalAnd, left, right)
		Operators.RangeOperator: RangeExpression(left, right)
		Operators.AddOperator: Binary(Add, left, right)
		Operators.SubtractOperator: Binary(Subtract, left, right)
		Operators.MultiplyOperator: Binary(Multiply, left, right)
		Operators.DivideOperator: Binary(Divide, left, right)
		Operators.ModuloOperator: Binary(Modulo, left, right)
		Operators.EqualOperator: Binary(Equal, left, right)
		Operators.NotEqualOperator: Binary(NotEqual, left, right)
		Operators.LessOperator: Binary(Less, left, right)
		Operators.LessEqualOperator: Binary(LessEqual, left, right)
		Operators.GreaterOperator: Binary(Greater, left, right)
		Operators.GreaterEqualOperator: Binary(GreaterEqual, left, right)


private pure func keeps_token_span(recipe: ExpressionRecipe) -> Bool:
	var inner = recipe
	var walking = True
	var keeps = False
	while walking:
		match inner.kind:
			GroupingRecipe(grouped): inner = grouped
			NameRecipe(_):
				keeps = True
				walking = False
			_: walking = False
	keeps
