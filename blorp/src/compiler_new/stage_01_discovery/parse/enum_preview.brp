-- A standalone enum preview owns only its declaration and lexical
-- evidence. It does not publish a completed module or route production parsing.
import:
	../lex/lexed_module: LexedModule
	../syntax/declarations: EnumDeclaration
	../tables/row_kinds: Visibility(PublicVisibility)
	../tables/token: TokenKind(EnumKeyword, NewlineToken, EndOfFileToken)
	parse_state:
		ParseInputError,
		ParseState,
		advanced,
		current_kind,
		current_span,
		diagnostic_count,
		diagnostics,
		new_parse_state,
	preview_source: PreviewSource, preview_source
	rejected_preview: RejectedPreview, reject_preview
	tree_enum_parser: EnumParse(ParsedEnum, RejectedEnum), parse_enum


opaque type EnumPreview = PreviewContents


private record PreviewContents {
	declaration: EnumDeclaration,
	source: PreviewSource
}


union EnumPreviewOutcome:
	PreviewedEnum(EnumPreview)
	RejectedEnumPreview(RejectedPreview)
	UnsupportedEnumPreview


pure func enum_declaration(preview: EnumPreview) -> EnumDeclaration:
	from_opaque EnumPreview(preview).declaration


pure func enum_source(preview: EnumPreview) -> PreviewSource:
	from_opaque EnumPreview(preview).source


pure func preview_enum(lexed: LexedModule) -> Result[EnumPreviewOutcome, ParseInputError]:
	state ?= new_parse_state(lexed)

	if state.diagnostic_count() != 0:
		rejected ?= reject_preview(state)
		Ok(RejectedEnumPreview(rejected))
	else if state.current_kind() != EnumKeyword:
		Ok(UnsupportedEnumPreview)
	else:
		(parsed_state, result) = parse_enum(
			state.advanced(),
			PublicVisibility,
			None,
			state.current_span(),
		)

		match result:
			RejectedEnum:
				rejected ?= reject_preview(parsed_state)
				Ok(RejectedEnumPreview(rejected))
			ParsedEnum(declaration):
				var end: ParseState = parsed_state

				while end.current_kind() == NewlineToken:
					end = end.advanced()

				if end.current_kind() != EndOfFileToken:
					Ok(UnsupportedEnumPreview)
				else:
					Ok(PreviewedEnum(into_opaque EnumPreview({
									declaration = declaration,
									source = preview_source(lexed)
								})))
