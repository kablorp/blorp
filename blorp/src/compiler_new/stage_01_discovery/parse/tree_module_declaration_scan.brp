-- The declaration scan of one module: every declaration in source order, read
-- in full, until the first one the tree parser does not read. It is evidence,
-- not module acceptance, which belongs to `tree_module_assembly`.
--
-- The scan stops at the first declaration it cannot read in full: where a
-- body or initializer the parser does not read ends is known only by reading
-- it, so nothing after it can be read either.
import:
	../syntax/module_syntax:
		Documentation,
		ModuleItem(FunctionItem)
	../tables/token: TokenKind(NewlineToken, EndOfFileToken)
	parse_state: ParseState, current_kind, position, advanced
	tree_module_documentation_parser: parse_module_preamble
	tree_function_header_parser: FunctionHeader
	tree_global_header_parser: GlobalHeaderPreview, DeferredInitializerStart
	tree_implementation_parser: ImplementationHeader
	tree_trait_parser: TraitHeader
	stop_reason: StopPoint
	tree_declaration_preview_parser:
		DeclarationPreview(FunctionHeadRead, CompletedItem),
		DeclarationPreviewParse(
			ParsedDeclarationPreview, DeclinedGlobalInitializer, DeclinedTraitBodies, DeclinedImplementationBodies,
			RejectedGlobalInitializer, RejectedDeclarationPreview,
		),
		parse_declaration_preview
	tree_body_parser: FunctionCompletion(CompletedFunction, DeferredFunction), complete_function


---
The header of a declaration the scan read up to its body or initializer. A
function here always has a body: a forward declaration is read in full.
---
union UnreadHeader:
	UnreadFunction(FunctionHeader)
	UnreadTrait(TraitHeader)
	UnreadImplementation(ImplementationHeader)
	UnreadGlobalInitializer(GlobalHeaderPreview)


---
The declaration the scan stopped at, and why the tree parser did not read
the rest of it. `stop` is the rollback's own result, so the reason is not
worked out afterwards.
---
record UnreadDeclaration {
	header: UnreadHeader,
	stop: StopPoint
}


union ModuleDeclarationScanStop:
	ReachedEndOfSource
	StoppedAtUnreadDeclaration(UnreadDeclaration)
	StoppedAtRejectedGlobalInitializer(DeferredInitializerStart)
	StoppedAtRejectedDeclaration
	StoppedWithoutDeclarationProgress


---
The module documentation, every declaration read in full before the stop, in
source order, and the stop.
---
record ModuleDeclarationScan {
	documentation: Option[Documentation],
	items: List[ModuleItem],
	stop: ModuleDeclarationScanStop
}


-- One declaration's outcome: read in full, or where the scan stops.
private union DeclarationRead:
	ReadItem(ModuleItem)
	StopsScan(ModuleDeclarationScanStop)


pure func scan_module_declarations(state: ParseState) -> (ParseState, ModuleDeclarationScan):
	(after_preamble, documentation) = parse_module_preamble(state)
	var out: ParseState = after_preamble
	var items: List[ModuleItem] = []
	var stop: ModuleDeclarationScanStop = ReachedEndOfSource
	var scanning: Bool = True

	while scanning and out.current_kind() != EndOfFileToken:
		(read, outcome) = out.read_declaration()
		out = read
		match outcome:
			ReadItem(item):
				items = items.append(item)
				out = out.skip_newlines()
			StopsScan(reason):
				stop = reason
				scanning = False

	(out, { documentation = documentation, items = items, stop = stop })


private pure func read_declaration(state: ParseState) -> (ParseState, DeclarationRead):
	(parsed, result) = parse_declaration_preview(state)
	match result:
		ParsedDeclarationPreview(declaration):
			-- A successful leaf must consume declaration syntax. Do not hide
			-- an invariant violation by advancing or collecting stale evidence.
			if parsed.position() == state.position():
				(parsed, StopsScan(StoppedWithoutDeclarationProgress))
			else:
				parsed.completed_declaration(declaration)
		DeclinedGlobalInitializer(preview, stop):
			(parsed, StopsScan(StoppedAtUnreadDeclaration({ header = UnreadGlobalInitializer(preview), stop = stop })))
		DeclinedTraitBodies(header, stop):
			(parsed, StopsScan(StoppedAtUnreadDeclaration({ header = UnreadTrait(header), stop = stop })))
		DeclinedImplementationBodies(header, stop):
			(parsed, StopsScan(StoppedAtUnreadDeclaration({ header = UnreadImplementation(header), stop = stop })))
		RejectedGlobalInitializer(start):
			(parsed, StopsScan(StoppedAtRejectedGlobalInitializer(start)))
		RejectedDeclarationPreview:
			(parsed, StopsScan(StoppedAtRejectedDeclaration))


-- A declaration whose preview ended at `state`, as a module item: a function's
-- body is read at the head's returned cursor. One whose body the tree parser does
-- not read stops the scan, with why.
private pure func completed_declaration(state: ParseState, declaration: DeclarationPreview) -> (ParseState, DeclarationRead):
	match declaration:
		FunctionHeadRead(preview):
			(completed, completion) = complete_function(state, preview)
			match completion:
				CompletedFunction(function):
					(completed, ReadItem(FunctionItem(function)))
				DeferredFunction(stop):
					(state, StopsScan(StoppedAtUnreadDeclaration({ header = UnreadFunction(preview.header), stop = stop })))
		CompletedItem(item):
			(state, ReadItem(item))


private pure func skip_newlines(state: ParseState) -> ParseState:
	var out: ParseState = state
	while out.current_kind() == NewlineToken:
		out = out.advanced()
	out
