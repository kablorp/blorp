-- Bounded declaration evidence, not module acceptance. Globals and rejected
-- declarations stop the scan at their returned cursor. The explicit M4 opt-in
-- completes only its supported same-line globals; module acceptance belongs to
-- `tree_module_assembly`, which reads the body-completing scan.
import:
	../syntax/module_syntax: Documentation
	../tables/token: TokenKind(NewlineToken, EndOfFileToken)
	parse_state: ParseState, current_kind, position, advanced
	tree_module_documentation_parser: parse_module_preamble
	tree_global_header_parser: GlobalHeaderPreview, DeferredInitializerStart
	tree_global_parser:
		GlobalCompletion(CompletedGlobal, DeferredGlobal), complete_atomic_global,
		GlobalExpressionCompletion(CompletedExpressionGlobal, DeferredExpressionGlobal, RejectedExpressionGlobal), complete_expression_global
	stop_reason: StopPoint
	tree_declaration_preview_parser:
		DeclarationPreview(GlobalDeclarationPreview, FunctionDeclarationPreview, CompletedFunctionPreview, TraitDeclarationPreview, CompletedTraitPreview, ImplementationDeclarationPreview, CompletedImplementationPreview),
		DeclarationPreviewParse(ParsedDeclarationPreview, DeferredGlobalInitializer, RejectedGlobalInitializer, RejectedDeclarationPreview), parse_declaration_preview
	tree_body_parser: FunctionCompletion(CompletedFunction, DeferredFunction), complete_function
	tree_owner_completion:
		TraitCompletion(CompletedTrait, DeferredTrait), ImplementationCompletion(CompletedImplementation, DeferredImplementation),
		complete_trait, complete_implementation


union ModuleDeclarationScanStop:
	ReachedEndOfSource
	StoppedAtGlobalInitializer(GlobalHeaderPreview)
	StoppedAtRejectedGlobalInitializer(DeferredInitializerStart)
	StoppedAtRejectedDeclaration
	StoppedWithoutDeclarationProgress


-- What a completing scan tried to read in full and could not.
enum DeclinedKind:
	DeclinedFunction
	DeclinedTrait
	DeclinedImplementation
	DeclinedGlobalInitializer


-- A declaration the body policy tried to complete and left as it was: a
-- skipped-body preview, or the global initializer the scan stopped at. `stop`
-- is the rollback's own result, so the reason is not worked out afterwards.
record DeclinedDeclaration {
	kind: DeclinedKind,
	stop: StopPoint
}


-- `declined` lists, in source order, every declaration the completing policies
-- tried and could not read: the first is where the tree path first falls short.
-- It is empty for a scan that does not complete bodies.
record ModuleDeclarationPreviewScan {
	documentation: Option[Documentation],
	declarations: List[DeclarationPreview],
	declined: List[DeclinedDeclaration],
	stop: ModuleDeclarationScanStop
}


private enum GlobalCompletionPolicy:
	KeepDeferredInitializers
	CompleteSameLineAtomicInitializers
	CompleteSameLineExpressions
	CompleteExpressionsAndBodies


pure func scan_module_declaration_previews(state: ParseState) -> (ParseState, ModuleDeclarationPreviewScan):
	scan_module_declaration_prefix(state, KeepDeferredInitializers)


pure func scan_module_declaration_prefix_with_atomic_globals(state: ParseState) -> (ParseState, ModuleDeclarationPreviewScan):
	scan_module_declaration_prefix(state, CompleteSameLineAtomicInitializers)


pure func scan_module_declaration_prefix_with_expressions(state: ParseState) -> (ParseState, ModuleDeclarationPreviewScan):
	scan_module_declaration_prefix(state, CompleteSameLineExpressions)


-- The M4 statement slice: expression globals as above, and every function,
-- trait and implementation whose bodies the body parser reads in full. An
-- owner it leaves deferred stays a skipped-body preview, as in every other
-- scan.
pure func scan_module_declaration_prefix_with_bodies(state: ParseState) -> (ParseState, ModuleDeclarationPreviewScan):
	scan_module_declaration_prefix(state, CompleteExpressionsAndBodies)


private pure func scan_module_declaration_prefix(state: ParseState, globals: GlobalCompletionPolicy) -> (ParseState, ModuleDeclarationPreviewScan):
	(after_preamble, documentation) = parse_module_preamble(state)
	var out: ParseState = after_preamble
	var declarations: List[DeclarationPreview] = []
	var declined: List[DeclinedDeclaration] = []
	var stop: ModuleDeclarationScanStop = ReachedEndOfSource
	var scanning: Bool = True

	while scanning and out.current_kind() != EndOfFileToken:
		before: Int = out.position()
		entry: ParseState = out
		(parsed, result) = parse_declaration_preview(out)
		out = parsed
		match result:
			ParsedDeclarationPreview(declaration):
				-- A successful leaf must consume declaration syntax. Do not hide
				-- an invariant violation by advancing or collecting stale evidence.
				if out.position() == before:
					stop = StoppedWithoutDeclarationProgress
					scanning = False
				else:
					(completed, finished, left_over) = out.completed_declaration(entry, declaration, globals)
					out = completed
					declarations = declarations.append(finished)
					match left_over:
						Some(unread):
							declined = declined.append(unread)
						None:
							void
					out = out.skip_newlines()
			DeferredGlobalInitializer(preview):
				if globals == KeepDeferredInitializers:
					stop = StoppedAtGlobalInitializer(preview)
					scanning = False
				else if globals == CompleteSameLineExpressions or globals == CompleteExpressionsAndBodies:
					(completed, completion) = complete_expression_global(out, preview)
					out = completed

					match completion:
						CompletedExpressionGlobal(declaration):
							declarations = declarations.append(
								GlobalDeclarationPreview(declaration),
							)
							out = out.skip_newlines()
						DeferredExpressionGlobal(unread):
							declined = declined.append({ kind = DeclinedGlobalInitializer, stop = unread })
							stop = StoppedAtGlobalInitializer(preview)
							scanning = False
						RejectedExpressionGlobal:
							stop = StoppedAtRejectedGlobalInitializer(preview.initializer)
							scanning = False
				else:
					(completed, completion) = complete_atomic_global(out, preview)
					out = completed
					match completion:
						CompletedGlobal(declaration):
							declarations = declarations.append(GlobalDeclarationPreview(declaration))
							out = out.skip_newlines()
						DeferredGlobal:
							stop = StoppedAtGlobalInitializer(preview)
							scanning = False
			RejectedGlobalInitializer(start):
				stop = StoppedAtRejectedGlobalInitializer(start)
				scanning = False
			RejectedDeclarationPreview:
				stop = StoppedAtRejectedDeclaration
				scanning = False

	(out, { documentation = documentation, declarations = declarations, declined = declined, stop = stop })


-- Only the body policy replaces a skipped body by its tree. `state` is where
-- the declaration's preview ended and `entry` where its prefix began. A
-- declaration it could not complete stays as it was, with why.
private pure func completed_declaration(
	state: ParseState, entry: ParseState, declaration: DeclarationPreview, globals: GlobalCompletionPolicy,
) -> (ParseState, DeclarationPreview, Option[DeclinedDeclaration]):
	if globals != CompleteExpressionsAndBodies:
		(state, declaration, None)
	else:
		match declaration:
			FunctionDeclarationPreview(preview):
				(completed, completion) = complete_function(state, preview)
				match completion:
					CompletedFunction(function):
						(completed, CompletedFunctionPreview(function), None)
					DeferredFunction(stop):
						(state, declaration, Some({ kind = DeclinedFunction, stop = stop }))
			TraitDeclarationPreview(_):
				(completed, completion) = complete_trait(entry, state)
				match completion:
					CompletedTrait(trait_declaration):
						(completed, CompletedTraitPreview(trait_declaration), None)
					DeferredTrait(stop):
						(state, declaration, Some({ kind = DeclinedTrait, stop = stop }))
			ImplementationDeclarationPreview(_):
				(completed, completion) = complete_implementation(entry, state)
				match completion:
					CompletedImplementation(implementation_declaration):
						(completed, CompletedImplementationPreview(implementation_declaration), None)
					DeferredImplementation(stop):
						(state, declaration, Some({ kind = DeclinedImplementation, stop = stop }))
			_:
				(state, declaration, None)


private pure func skip_newlines(state: ParseState) -> ParseState:
	var out: ParseState = state
	while out.current_kind() == NewlineToken:
		out = out.advanced()
	out
