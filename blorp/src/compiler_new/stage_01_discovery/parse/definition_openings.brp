---
Copies the header's pending annotations to `definition`. Only functions
carry annotations; on any other declaration they were reported
(`AnnotationWithoutFunctionDiagnostic`) and are dropped.
---
private pure func record_annotations(
	builder: DiscoveryBuilder,
	definition: DefinitionId,
	annotations: RowRange,
	kind: DefinitionKind,
) -> DiscoveryBuilder:
	if annotations.count == 0 or not kind.takes_annotations():
		builder
	else:
		builder.record_annotation_rows(definition, annotations)


---
The annotation rows of a non-empty block.
---
private pure func record_annotation_rows(
	builder: DiscoveryBuilder,
	definition: DefinitionId,
	annotations: RowRange,
) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = builder
	var index: Int = annotations.first

	while index < annotations.first + annotations.count:
		row: AnnotationRow = out.annotation_row(definition, index)
		out = out.append_annotation(row)
		index += 1

	out


private pure func annotation_row(
	builder: DiscoveryBuilder,
	definition: DefinitionId,
	pending_index: Int,
) -> AnnotationRow:
	pending: PendingAnnotationRow = builder.pending_annotation_at(pending_index)
	{
		definition = definition,
		annotation = pending.annotation,
		span = pending.span
	}


pure func takes_annotations(kind: DefinitionKind) -> Bool:
	match kind:
		FunctionDefinition | ImplMethodDefinition | ForeignFunctionDefinition | LocalFunctionDefinition:
			True
		_:
			False


-- Openers.
---
The source form of a managed record declaration. Both forms take type parameters.
---
enum RecordForm:
	RecordType
	FixedRecordType


---
The form of a union-like type.
---
enum UnionForm:
	UnionType
	EnumType


---
The form of a global.
---
enum GlobalForm:
	ConstantGlobal
	MutableGlobal


---
The form of a type that stands for another.
---
enum AliasForm:
	AliasType
	OpaqueType


---
The form of a type the runtime provides.
---
enum BareTypeForm:
	BuiltinType
	ResourceType


pure func function_opening(
	builder: DiscoveryBuilder,
	header: DeclarationHeader,
	name: NameId,
	name_span: Span,
) -> FunctionOpening:
	fields: OpeningFields = builder.fields_of(header, FunctionDefinition, name, name_span)
	into_opaque FunctionOpening(fields)


pure func local_function_opening(
	builder: DiscoveryBuilder,
	header: DeclarationHeader,
	name: NameId,
	name_span: Span,
) -> FunctionOpening:
	fields: OpeningFields = builder.fields_of(header, LocalFunctionDefinition, name, name_span)
	into_opaque FunctionOpening(fields)


---
The opening of a method of the trait `owner`, which joins it when opened.
---
pure func trait_method_opening(
	builder: DiscoveryBuilder,
	header: DeclarationHeader,
	owner: TraitOpening,
	name: NameId,
	name_span: Span,
) -> FunctionOpening:
	fields: OpeningFields = builder.fields_of_member(
		header,
		from_opaque TraitOpening(owner).owned,
		TraitMethodDefinition,
		name,
		name_span,
	)
	into_opaque FunctionOpening(fields)


---
The opening of a method of the impl `owner`, which joins it when opened.
---
pure func impl_method_opening(
	builder: DiscoveryBuilder,
	header: DeclarationHeader,
	owner: ImplOpening,
	name: NameId,
	name_span: Span,
) -> FunctionOpening:
	fields: OpeningFields = builder.fields_of_member(
		header,
		from_opaque ImplOpening(owner).owned,
		ImplMethodDefinition,
		name,
		name_span,
	)
	into_opaque FunctionOpening(fields)


---
Appends the row of `opening` (and, for a trait or impl method, its member row).
---
pure func open_function(builder: DiscoveryBuilder, opening: FunctionOpening) -> DiscoveryBuilder:
	fields: OpeningFields = from_opaque FunctionOpening(opening)

	match fields.row.kind:
		TraitMethodDefinition | ImplMethodDefinition:
			builder.open_fields_as_member(fields)
		_:
			builder.open_fields(fields)


pure func foreign_function_opening(
	builder: DiscoveryBuilder,
	header: DeclarationHeader,
	name: NameId,
	name_span: Span,
) -> ForeignFunctionOpening:
	fields: OpeningFields = builder.fields_of(header, ForeignFunctionDefinition, name, name_span)
	into_opaque ForeignFunctionOpening(fields)


pure func open_foreign_function(
	builder: DiscoveryBuilder,
	opening: ForeignFunctionOpening,
) -> DiscoveryBuilder:
	builder.open_fields(from_opaque ForeignFunctionOpening(opening))


pure func global_opening(
	builder: DiscoveryBuilder,
	header: DeclarationHeader,
	form: GlobalForm,
	name: NameId,
	name_span: Span,
) -> GlobalOpening:
	kind: DefinitionKind = match form:
		ConstantGlobal:
			ConstantDefinition
		MutableGlobal:
			MutableGlobalDefinition

	into_opaque GlobalOpening(builder.fields_of(header, kind, name, name_span))


pure func open_global(builder: DiscoveryBuilder, opening: GlobalOpening) -> DiscoveryBuilder:
	builder.open_fields(from_opaque GlobalOpening(opening))


pure func record_opening(
	builder: DiscoveryBuilder,
	header: DeclarationHeader,
	form: RecordForm,
	name: NameId,
	name_span: Span,
) -> RecordOpening:
	kind: DefinitionKind = match form:
		RecordType:
			RecordDefinition
		FixedRecordType:
			FixedRecordDefinition

	into_opaque RecordOpening(builder.fields_of(header, kind, name, name_span))


pure func open_record(builder: DiscoveryBuilder, opening: RecordOpening) -> DiscoveryBuilder:
	builder.open_fields(from_opaque RecordOpening(opening))


---
The opening of a field of the record or struct `owner`, which joins it when opened.
---
pure func field_opening(
	builder: DiscoveryBuilder,
	header: DeclarationHeader,
	owner: RecordOpening,
	name: NameId,
	name_span: Span,
) -> FieldOpening:
	fields: OpeningFields = builder.fields_of_member(
		header,
		from_opaque RecordOpening(owner).owned,
		FieldDefinition,
		name,
		name_span,
	)
	into_opaque FieldOpening(fields)


pure func open_field(builder: DiscoveryBuilder, opening: FieldOpening) -> DiscoveryBuilder:
	builder.open_fields_as_member(from_opaque FieldOpening(opening))


pure func union_opening(
	builder: DiscoveryBuilder,
	header: DeclarationHeader,
	form: UnionForm,
	name: NameId,
	name_span: Span,
) -> UnionOpening:
	kind: DefinitionKind = match form:
		UnionType:
			UnionDefinition
		EnumType:
			EnumDefinition

	into_opaque UnionOpening(builder.fields_of(header, kind, name, name_span))


pure func open_union(builder: DiscoveryBuilder, opening: UnionOpening) -> DiscoveryBuilder:
	builder.open_fields(from_opaque UnionOpening(opening))


---
The opening of a variant of the union or enum `owner`, which joins it when opened.
---
pure func variant_opening(
	builder: DiscoveryBuilder,
	header: DeclarationHeader,
	owner: UnionOpening,
	name: NameId,
	name_span: Span,
) -> VariantOpening:
	fields: OpeningFields = builder.fields_of_member(
		header,
		from_opaque UnionOpening(owner).owned,
		VariantDefinition,
		name,
		name_span,
	)
	into_opaque VariantOpening(fields)


pure func open_variant(builder: DiscoveryBuilder, opening: VariantOpening) -> DiscoveryBuilder:
	builder.open_fields_as_member(from_opaque VariantOpening(opening))


pure func trait_opening(
	builder: DiscoveryBuilder,
	header: DeclarationHeader,
	name: NameId,
	name_span: Span,
) -> TraitOpening:
	into_opaque TraitOpening(builder.fields_of(header, TraitDefinition, name, name_span))


pure func open_trait(builder: DiscoveryBuilder, opening: TraitOpening) -> DiscoveryBuilder:
	builder.open_fields(from_opaque TraitOpening(opening))


---
The opening of an impl of `trait_name`, written at `trait_span`, after the
`implements` keyword at `keyword_span`. An impl has no name of its own: its
definition row holds `IMPL_NAME`, and opening it also appends its `ImplRow`.
---
pure func impl_opening(
	builder: DiscoveryBuilder,
	header: DeclarationHeader,
	impl_name: NameId,
	keyword_span: Span,
	trait_name: NameId,
	trait_span: Span,
) -> ImplOpening:
	definition: DefinitionId = builder.next_definition_id()
	owned: OwnedRows = builder.owned_rows(definition)
	fields: OpeningFields = fields_joining(
		definition,
		owned,
		owned,
		header,
		ImplDefinition,
		impl_name,
		keyword_span,
		trait_name,
		trait_span,
	)
	into_opaque ImplOpening(fields)


---
Appends the definition row of `opening` and its `ImplRow`, the only way an impl
row is written.
---
pure func open_impl(builder: DiscoveryBuilder, opening: ImplOpening) -> DiscoveryBuilder:
	impl: OpeningFields = from_opaque ImplOpening(opening)
	builder
		.open_fields(impl)
		.append_impl_row({
			definition = impl.definition,
			trait_name = impl.implemented_trait,
			trait_span = impl.implemented_trait_span,
		})


private pure func append_impl_row(builder: DiscoveryBuilder, row: ImplRow) -> DiscoveryBuilder:
	{ builder | impls = builder.impls.append(row) }


pure func alias_opening(
	builder: DiscoveryBuilder,
	header: DeclarationHeader,
	form: AliasForm,
	name: NameId,
	name_span: Span,
) -> AliasOpening:
	kind: DefinitionKind = match form:
		AliasType:
			TypeAliasDefinition
		OpaqueType:
			OpaqueTypeDefinition

	into_opaque AliasOpening(builder.fields_of(header, kind, name, name_span))


pure func open_alias(builder: DiscoveryBuilder, opening: AliasOpening) -> DiscoveryBuilder:
	builder.open_fields(from_opaque AliasOpening(opening))


pure func bare_type_opening(
	builder: DiscoveryBuilder,
	header: DeclarationHeader,
	form: BareTypeForm,
	name: NameId,
	name_span: Span,
) -> BareTypeOpening:
	kind: DefinitionKind = match form:
		BuiltinType:
			BuiltinTypeDefinition
		ResourceType:
			ResourceTypeDefinition

	into_opaque BareTypeOpening(builder.fields_of(header, kind, name, name_span))


pure func open_bare_type(builder: DiscoveryBuilder, opening: BareTypeOpening) -> DiscoveryBuilder:
	builder.open_fields(from_opaque BareTypeOpening(opening))


-- Appenders: what each class of definition may have.
---
Appends the body of the function `opening`, whose expression is `root`.
---
pure func append_function_body(
	builder: DiscoveryBuilder,
	opening: FunctionOpening,
	root: NodeId,
) -> DiscoveryBuilder:
	definition: DefinitionId = from_opaque FunctionOpening(opening).definition
	{ builder | bodies = builder.bodies.append({
			definition = definition,
			root = root,
		}) }


---
Appends the written return type of the function `opening`.
---
pure func append_function_return_type(
	builder: DiscoveryBuilder,
	opening: FunctionOpening,
	type_root: NodeId,
) -> DiscoveryBuilder:
	definition: DefinitionId = from_opaque FunctionOpening(opening).definition
	{ builder | definition_types = builder.definition_types.append({
			definition = definition,
			type_root = type_root,
		}) }


---
Appends the written return type of the foreign function `opening`.
---
pure func append_foreign_return_type(
	builder: DiscoveryBuilder,
	opening: ForeignFunctionOpening,
	type_root: NodeId,
) -> DiscoveryBuilder:
	definition: DefinitionId = from_opaque ForeignFunctionOpening(opening).definition
	{ builder | definition_types = builder.definition_types.append({
			definition = definition,
			type_root = type_root,
		}) }


---
Appends the declared type of the global `opening`.
---
pure func append_global_type(
	builder: DiscoveryBuilder,
	opening: GlobalOpening,
	type_root: NodeId,
) -> DiscoveryBuilder:
	definition: DefinitionId = from_opaque GlobalOpening(opening).definition
	{ builder | definition_types = builder.definition_types.append({
			definition = definition,
			type_root = type_root,
		}) }


---
Appends the value of the global `opening`, whose expression is `root`.
---
pure func append_global_value(
	builder: DiscoveryBuilder,
	opening: GlobalOpening,
	root: NodeId,
) -> DiscoveryBuilder:
	definition: DefinitionId = from_opaque GlobalOpening(opening).definition
	{ builder | bodies = builder.bodies.append({
			definition = definition,
			root = root,
		}) }


---
Appends the declared type of the field `opening`.
---
pure func append_field_type(
	builder: DiscoveryBuilder,
	opening: FieldOpening,
	type_root: NodeId,
) -> DiscoveryBuilder:
	definition: DefinitionId = from_opaque FieldOpening(opening).definition
	{ builder | definition_types = builder.definition_types.append({
			definition = definition,
			type_root = type_root,
		}) }


---
Appends the type the alias or opaque type `opening` stands for.
---
pure func append_alias_target(
	builder: DiscoveryBuilder,
	opening: AliasOpening,
	type_root: NodeId,
) -> DiscoveryBuilder:
	definition: DefinitionId = from_opaque AliasOpening(opening).definition
	{ builder | definition_types = builder.definition_types.append({
			definition = definition,
			type_root = type_root,
		}) }


---
Appends the type the impl `opening` is for.
---
pure func append_receiver_type(
	builder: DiscoveryBuilder,
	opening: ImplOpening,
	type_root: NodeId,
) -> DiscoveryBuilder:
	definition: DefinitionId = from_opaque ImplOpening(opening).definition
	{ builder | definition_types = builder.definition_types.append({
			definition = definition,
			type_root = type_root,
		}) }


---
Appends `type_root` as the next payload type of the variant `opening`, numbered
by the payloads the table has gained since the variant opened.
---
pure func append_variant_payload(
	builder: DiscoveryBuilder,
	opening: VariantOpening,
	type_root: NodeId,
) -> DiscoveryBuilder:
	fields: OpeningFields = from_opaque VariantOpening(opening)
	ordinal: Int = builder.variant_payloads.length() - fields.owned.variant_payloads_first
	{ builder | variant_payloads = builder.variant_payloads.append({
			variant = fields.definition,
			ordinal = ordinal,
			type_root = type_root,
		}) }
