-- The definition rows every declaration opens and closes, one opening type per
-- class of definition.
--
-- Which definitions may have a body, a written type or members is part of the
-- type of their opening: `FunctionOpening`, `GlobalOpening`, `FieldOpening` and
-- the rest are each minted only by their own opener, and the appenders for a
-- body, a written type or a member take the opening of the class that has it.
-- A record opening has no body appender, and a field opening cannot join a
-- trait: the combination does not compile. Members are appended by the opener
-- of the member, from the owner's opening, so a member's kind and its owner's
-- class agree by construction. No freeze check holds them to account.
--
-- Shared by the declaration parser and the body parser, which declares local
-- functions with the same routines.
import:
	../tables/builder:
		DiscoveryBuilder,
		OwnedRows,
		append_annotation,
		append_documentation,
		next_definition_id,
		owned_rows,
		pending_annotation_at,
		pending_docstring_at,
		set_definition_span,
	../tables/ids: DefinitionId, LiteralId, NameId, NodeId, definition_id_index
	../tables/row_kinds:
		DefinitionKind(
			BuiltinTypeDefinition, ConstantDefinition, EnumDefinition, FieldDefinition,
			ForeignFunctionDefinition, FunctionDefinition, ImplDefinition, ImplMethodDefinition,
			LocalFunctionDefinition, MutableGlobalDefinition, OpaqueTypeDefinition,
			RecordDefinition, ResourceTypeDefinition, FixedRecordDefinition, TraitDefinition,
			TraitMethodDefinition, TypeAliasDefinition, UnionDefinition, VariantDefinition,
		),
	../tables/rows: AnnotationRow, DefinitionRow, ImplRow, MemberRow, PendingAnnotationRow, RowRange
	../tables/span: Span, span_covering
	debug as dbg
	declaration_header: DeclarationHeader


---
What `definition_row` knows when a definition's name has been read: the row as
it is appended at the opening (its kind, name, module and visibility are final;
its span ends at the name for now), what the header gives the closing (where the
declaration starts, its docstring and its annotations), and, for a member, the
owner it joins. The opening preserves these facts until the owner is closed.
---
private fixed record OpeningFields {
	definition: DefinitionId,
	owned: OwnedRows,
	member_of: OwnedRows,
	row: DefinitionRow,
	start: Span,
	docstring: RowRange,
	annotations: RowRange,
	implemented_trait: NameId,
	implemented_trait_span: Span
}


---
The fields of an opening of a definition of `kind`. It is no member: it joins
its own rows.
---
private pure func fields_of(
	builder: DiscoveryBuilder,
	header: DeclarationHeader,
	kind: DefinitionKind,
	name: NameId,
	name_span: Span,
) -> OpeningFields:
	definition: DefinitionId = builder.next_definition_id()
	owned: OwnedRows = builder.owned_rows(definition)
	fields_joining(definition, owned, owned, header, kind, name, name_span, name, name_span)


---
The fields of an opening of a member definition of `kind`, which joins `owner`.
---
private pure func fields_of_member(
	builder: DiscoveryBuilder,
	header: DeclarationHeader,
	owner: OwnedRows,
	kind: DefinitionKind,
	name: NameId,
	name_span: Span,
) -> OpeningFields:
	definition: DefinitionId = builder.next_definition_id()
	owned: OwnedRows = builder.owned_rows(definition)
	fields_joining(definition, owned, owner, header, kind, name, name_span, name, name_span)


private pure func fields_joining(
	definition: DefinitionId,
	owned: OwnedRows,
	member_of: OwnedRows,
	header: DeclarationHeader,
	kind: DefinitionKind,
	name: NameId,
	name_span: Span,
	implemented_trait: NameId,
	implemented_trait_span: Span,
) -> OpeningFields:
	{
		definition = definition,
		owned = owned,
		member_of = member_of,
		row = {
			module = header.module,
			kind = kind,
			name = name,
			name_span = name_span,
			visibility = header.visibility,
			span = header.start.span_covering(name_span)
		},
		start = header.start,
		docstring = header.docstring,
		annotations = header.annotations,
		implemented_trait = implemented_trait,
		implemented_trait_span = implemented_trait_span
	}


---
Appends a definition row. Private: a definition row of any kind, with no opening,
is not something production code can write.
---
private pure func append_definition(builder: DiscoveryBuilder, row: DefinitionRow) -> DiscoveryBuilder:
	{ builder | definitions = builder.definitions.append(row) }


---
Appends the row of `fields`, with the span known so far.
---
private pure func open_fields(builder: DiscoveryBuilder, fields: OpeningFields) -> DiscoveryBuilder:
	check_definition_opens_in_turn(
		builder.definitions.length(),
		fields.definition.definition_id_index(),
	)
	builder.append_definition(fields.row)


---
Debug-build guard of the one-open-per-opening rule: the row appends where the
opening was made for. A function of two numbers, so it holds no table.
---
private pure func check_definition_opens_in_turn(next_row: Int, opened_as: Int):
	debug:
		if next_row != opened_as:
			dbg.error("a definition opening was opened out of turn or twice")


---
Appends the row of `fields` and, joined to `fields.member_of`, its member row,
numbered by the rows the owner's members table has gained since it opened.
---
private pure func open_fields_as_member(
	builder: DiscoveryBuilder,
	fields: OpeningFields,
) -> DiscoveryBuilder:
	ordinal: Int = builder.members.length() - fields.member_of.members_first
	builder
		.open_fields(fields)
		.append_member_row({
			definition = fields.definition,
			owner = fields.member_of.definition,
			ordinal = ordinal,
		})


private pure func append_member_row(builder: DiscoveryBuilder, row: MemberRow) -> DiscoveryBuilder:
	{ builder | members = builder.members.append(row) }


---
Closes `fields` with the declaration's final span, from its start through `end`,
and records the header's docstring and annotations. This changes the span only.
---
private pure func close_fields(
	builder: DiscoveryBuilder,
	fields: OpeningFields,
	end: Span,
) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = builder.set_definition_span(
		fields.definition,
		fields.row,
		fields.start.span_covering(end),
	)

	if fields.docstring.count > 0:
		text: LiteralId = out.pending_docstring_at(fields.docstring.first)
		out = out.append_documentation({
			definition = fields.definition,
			text = text,
		})

	out.record_annotations(fields.definition, fields.annotations, fields.row.kind)


---
An opening of a function, local function, trait method or impl method. Minted only by its opener below; no other class's
appender takes it.
---
opaque type FunctionOpening = OpeningFields


---
The id the opened function has.
---
pure func function_definition(opening: FunctionOpening) -> DefinitionId:
	from_opaque FunctionOpening(opening).definition


---
The ordered rows the opened function owns, which the parse routines write into by
passing this, never a count.
---
pure func function_rows(opening: FunctionOpening) -> OwnedRows:
	from_opaque FunctionOpening(opening).owned


---
Closes `opening` with its final span; the span is all this changes.
---
pure func close_function(
	builder: DiscoveryBuilder,
	opening: FunctionOpening,
	end: Span,
) -> DiscoveryBuilder:
	builder.close_fields(from_opaque FunctionOpening(opening), end)


