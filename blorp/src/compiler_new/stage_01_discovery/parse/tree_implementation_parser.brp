-- An implementation: its header, then each method read in full in source
-- order (its header, its body, its definition), and the implementation
-- minted last, so its ids are post-order without reading anything twice.
import:
	../syntax/declarations: ImplementationDeclaration, ImplementationMethod
	../syntax/module_syntax: Documentation
	../syntax/names: NameUse
	../syntax/types: WrittenType
	../tables/expected_token:
		NameConstruct(NameInTraitName), ExpectedTokenDiagnostic(ExpectedKeyword, ExpectedColon, ExpectedNewline, ExpectedIndent),
		KeywordConstruct(KeywordInImplementationTrait), ColonConstruct(ColonInImplementationMethods),
		NewlineConstruct(NewlineInImplementationMethods), IndentConstruct(IndentInImplementationMethods)
	../tables/row_kinds: Visibility
	../tables/span: Span, span_covering
	../tables/token: TokenKind(ForKeyword, ColonSymbol, NewlineToken, IndentToken, DedentToken, EndOfFileToken)
	parse_state:
		ParseState, current_kind, current_span, position, advanced, diagnostic_count,
		consume_referenced_name, finished_name_use, expect_token, finished_implementation, finished_implementation_method
	stop_reason: StopPoint, Recognition(Recognized, Declined)
	tree_body_parser: complete_body
	tree_type_parser: parse_receiver_type
	tree_implementation_method_header_parser:
		ImplementationMethodHeaderParse(ParsedImplementationMethodHeader, RejectedImplementationMethodHeader), parse_implementation_method_header


---
An implementation's header: everything before its methods. `span` runs from
the declaration's start through its receiver.
---
record ImplementationHeader {
	visibility: Visibility,
	documentation: Option[Documentation],
	keyword: Span,
	trait_name: NameUse,
	receiver: WrittenType,
	span: Span
}


---
An implementation read in full; one with a diagnostic; or the header of one
with a method body the tree parser does not read, and why.
---
union ImplementationParse:
	ParsedImplementation(ImplementationDeclaration)
	RejectedImplementation
	DeclinedImplementation(ImplementationHeader, StopPoint)


-- One method: read and minted, rejected with its diagnostics (the
-- implementation reads on), or a body the tree parser does not read (it stops).
private union ImplementationMethodParse:
	ParsedMethod(ImplementationMethod)
	RejectedMethod
	DeclinedMethod(StopPoint)


-- The cursor is at `implements`; the caller owns any declaration prefix. A
-- declined implementation leaves the state after its header: the header's
-- ids stay issued and nothing of its methods does.
pure func parse_implementation(state: ParseState, visibility: Visibility, documentation: Option[Documentation], start: Span) -> (ParseState, ImplementationParse):
	before: Int = state.diagnostic_count()
	keyword: Span = state.current_span()
	(after_name, name) = state.advanced().consume_referenced_name(NameInTraitName)
	(after_trait, trait_name) = after_name.finished_name_use(name)
	before_receiver: ParseState = after_trait.expect_token(ForKeyword, ExpectedKeyword(KeywordInImplementationTrait))
	(after_receiver, receiver) = parse_receiver_type(before_receiver)
	var end: Span = receiver.span
	var out: ParseState = after_receiver
		.expect_token(ColonSymbol, ExpectedColon(ColonInImplementationMethods))
		.expect_token(NewlineToken, ExpectedNewline(NewlineInImplementationMethods))
		.expect_token(IndentToken, ExpectedIndent(IndentInImplementationMethods))
		.skip_newlines()
	var methods: List[ImplementationMethod] = []
	var stopped: Option[StopPoint] = None

	-- Every token enters method recovery. Missing indentation deliberately
	-- does not create a source-column guard for unindented method siblings.
	while not out.at_block_end() and stopped.is_none():
		method_start: Int = out.position()
		(after_method, result) = parse_implementation_method(out)
		out = after_method.skip_newlines()
		match result:
			ParsedMethod(method):
				methods = methods.append(method)
			RejectedMethod:
				()
			DeclinedMethod(stop):
				stopped = Some(stop)

		if out.position() == method_start and not out.at_block_end():
			out = out.advanced()

	-- The frozen owner covers the closing dedent. At EOF, even after methods,
	-- its endpoint remains the receiver rather than the last method header.
	if out.current_kind() == DedentToken:
		end = out.current_span()
		out = out.advanced()

	if out.diagnostic_count() != before:
		-- A diagnostic before a body the parser does not read rejects the
		-- implementation. One after that body is not seen, since it stops
		-- reading there (`DISCOVERY_REDESIGN.md`, section 9, D10).
		(out, RejectedImplementation)
	else:
		match stopped:
			Some(stop):
				(after_receiver, DeclinedImplementation({
					visibility = visibility, documentation = documentation, keyword = keyword,
					trait_name = trait_name, receiver = receiver, span = start.span_covering(receiver.span)
				}, stop))
			None:
				(declared, declaration) = out.finished_implementation(
					visibility, documentation, keyword, trait_name, receiver, methods, start.span_covering(end)
				)
				(declared, ParsedImplementation(declaration))


-- A method's header, then its body read in full, then its definition.
private pure func parse_implementation_method(state: ParseState) -> (ParseState, ImplementationMethodParse):
	(after_header, parsed) = parse_implementation_method_header(state)
	match parsed:
		RejectedImplementationMethodHeader:
			(after_header, RejectedMethod)
		ParsedImplementationMethodHeader(preview):
			(completed, body) = complete_body(after_header, preview.body)
			match body:
				Recognized(read):
					header = preview.header
					(declared, method) = completed.finished_implementation_method(
						header.annotations,
						{ signature = header.signature, type_parameters = header.type_parameters, constraints = header.constraints, body = Some(read.body) },
						header.header_span.span_covering(read.span)
					)
					(declared, ParsedMethod(method))
				Declined(stop):
					(after_header, DeclinedMethod(stop))


private pure func at_block_end(state: ParseState) -> Bool:
	state.current_kind() == DedentToken or state.current_kind() == EndOfFileToken


private pure func skip_newlines(state: ParseState) -> ParseState:
	var out: ParseState = state
	while out.current_kind() == NewlineToken:
		out = out.advanced()
	out
