-- Written dimension constraints share the direct dimension expression parser.
import:
	../syntax/declarations: DimensionConstraint
	../tables/diagnostic_code: PlainSyntaxCode(ExpectedEqualEqualDiagnostic)
	../tables/span: Span, span_covering
	../tables/token: TokenKind(WhereKeyword, EqualEqualSymbol, CommaSymbol, EndOfFileToken)
	parse_state: ParseState, current_kind, current_span, advanced, diagnostic_count, report_at_current
	tree_type_parser: parse_dimension


union DimensionConstraintsParse:
	NoDimensionConstraints
	ParsedDimensionConstraints(List[DimensionConstraint], Span)
	RejectedDimensionConstraints


pure func parse_dimension_constraints(state: ParseState) -> (ParseState, DimensionConstraintsParse):
	if state.current_kind() != WhereKeyword:
		(state, NoDimensionConstraints)
	else:
		before: Int = state.diagnostic_count()
		var out: ParseState = state.advanced()
		var constraints: List[DimensionConstraint] = []
		var end: Span = state.current_span()
		var parsing: Bool = True

		while parsing and out.current_kind() != EndOfFileToken:
			(after_left, left) = parse_dimension(out)
			before_right: ParseState = if after_left.current_kind() == EqualEqualSymbol:
				after_left.advanced()
			else:
				after_left.report_at_current(ExpectedEqualEqualDiagnostic)
			(after_right, right) = parse_dimension(before_right)
			out = after_right
			end = left.span.span_covering(right.span)
			constraints = constraints.append({ left = left, right = right, span = end })

			if out.current_kind() == CommaSymbol:
				out = out.advanced()
			else:
				parsing = False

		if out.diagnostic_count() != before:
			(out, RejectedDimensionConstraints)
		else:
			(out, ParsedDimensionConstraints(constraints, end))
