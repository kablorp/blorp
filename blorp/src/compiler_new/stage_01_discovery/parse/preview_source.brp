-- Lexical evidence owned by standalone declaration previews. Authored spans
-- and token kinds supply exact bytes without reconstructing their spelling.
import:
	../lex/lexed_module: InterpolationScan, LexedModule, LexedSource, ScannedPiece(ScannedHole)
	../lex/lexer: lex_hole
	../tables/ids: source_id_index
	../tables/span: Span, span_start, span_end, span_source, pack_span
	../tables/token: Token, TokenKind(EndOfFileToken, InterpolatedStringToken, InterpolatedPipeStringToken, UnderscoreSymbol, IntLiteralToken, FloatLiteralToken, LeftParenSymbol, RightParenSymbol, NewlineToken, IndentToken, DedentToken)


-- `tokens` are the module's, addressed by token position. `hole_tokens` are
-- those of every interpolation hole, in source order: the lexer reads each
-- hole in a run of its own, but a hole's integer literal is authored text like
-- any other.
record PreviewSource {
	source: LexedSource,
	tokens: List[Token],
	hole_tokens: List[Token]
}


pure func preview_source(lexed: LexedModule) -> PreviewSource:
	{
		source = lexed.source, tokens = lexed.tokens,
		hole_tokens = hole_tokens(lexed).sort_by(pure func(token): span_start(token.span))
	}


-- Every hole's tokens, nested strings' holes included, found by a worklist of
-- token runs: the module's own, then each hole's. Each hole is lexed once per
-- preview source, which tooling builds once per module.
private pure func hole_tokens(lexed: LexedModule) -> List[Token]:
	var runs: List[(List[Token], List[InterpolationScan])] = [(lexed.tokens, lexed.source.interpolations)]
	var collected: List[Token] = []
	var next_run: Int = 0

	while next_run < runs.length():
		match runs.get(next_run):
			Some((tokens, scans)):
				for token in tokens:
					if token.kind == InterpolatedStringToken or token.kind == InterpolatedPipeStringToken:
						match scans.get(token.payload):
							Some(scan):
								for piece in scan.pieces:
									match piece:
										ScannedHole(hole):
											run = lex_hole(lexed.module, lexed.source.text, lexed.spellings, hole.expression_start, hole.expression_end)
											for inner in run.tokens:
												if inner.kind != EndOfFileToken:
													collected = collected.append(inner)
											runs = runs.append((run.tokens, run.interpolations))
										_:
											void
							None:
								void
			None:
				void

		next_run += 1

	collected


pure func preview_span_text(preview: PreviewSource, span: Span) -> String:
	preview.source.text.substring(span_start(span), span_end(span) - span_start(span))


private pure func is_layout_token(kind: TokenKind) -> Bool:
	kind == NewlineToken or kind == IndentToken or kind == DedentToken


-- Grouping widens a numeric expression's location without changing its literal.
-- Validate the exact lexical shape: opening groups, one integer, closing groups.
-- A lower-bound search avoids rescanning the module for every numeric leaf.
pure func preview_integer_literal_text(preview: PreviewSource, span: Span) -> Option[String]:
	match integer_literal_text_in(preview, preview.tokens, span):
		Some(digits):
			Some(digits)
		None:
			integer_literal_text_in(preview, preview.hole_tokens, span)


private pure func integer_literal_text_in(preview: PreviewSource, tokens: List[Token], span: Span) -> Option[String]:
	var lower: Int = 0
	var upper: Int = tokens.length()
	var valid: Bool = True

	while valid and lower < upper:
		middle: Int = (lower + upper) / 2

		match tokens.get(middle):
			Some(token):
				if span_start(token.span) < span_start(span):
					lower = middle + 1
				else:
					upper = middle
			None:
				valid = False

	var index: Int = lower
	var groups: Int = 0
	var literal: Option[Token] = None
	var last_end: Int = span_start(span)
	var closing: Bool = False

	-- A literal that starts a block follows layout tokens that begin where it
	-- does: they own no bytes of the literal's span.
	while valid and index < tokens.length():
		match tokens.get(index):
			Some(token):
				if is_layout_token(token.kind) and span_end(token.span) <= span_start(span):
					index += 1
				else:
					break
			None:
				valid = False
	lower = index

	while valid and index < tokens.length():
		match tokens.get(index):
			None:
				valid = False
			Some(token):
				if span_start(token.span) >= span_end(span):
					break

				if (
					span_source(token.span).source_id_index() != span_source(span).source_id_index()
					or span_end(token.span) > span_end(span)
					or index == lower and span_start(token.span) != span_start(span)
				):
					valid = False

				match token.kind:
					LeftParenSymbol:
						if literal.is_some() or closing:
							valid = False

						groups += 1
					IntLiteralToken:
						if literal.is_some() or closing:
							valid = False

						literal = Some(token)
					RightParenSymbol:
						if literal.is_none() or groups == 0:
							valid = False

						closing = True
						groups -= 1
					_:
						valid = False

				last_end = span_end(token.span)

		index += 1

	if (
		not valid
		or groups != 0
		or last_end != span_end(span)
	):
		None
	else:
		literal.map(pure func(token): preview_span_text(preview, token.span))


-- A literal dimension may start at a separate hash token with whitespace or
-- comments before its integer. Read the integer token's authored bytes, never
-- the intervening trivia or a formatted checked value.
pure func preview_dimension_literal_text(preview: PreviewSource, span: Span) -> Option[String]:
	contents: PreviewSource = preview
	var digits: Option[String] = None

	for token in contents.tokens:
		if (token.kind == IntLiteralToken and span_end(token.span) == span_end(span)
			and span_start(token.span) >= span_start(span)):
			digits = Some(contents.source.text.substring(span_start(token.span), span_end(token.span) - span_start(token.span)))
			break

	digits


-- A variadic wildcard's legacy identifier ends at its authored underscore,
-- before the ellipsis. Trivia between hash and underscore belongs to its span.
pure func preview_variadic_wildcard_span(preview: PreviewSource, span: Span) -> Option[Span]:
	contents: PreviewSource = preview
	var identifier_span: Option[Span] = None

	for token in contents.tokens:
		if (token.kind == UnderscoreSymbol and span_start(token.span) >= span_start(span)
			and span_end(token.span) <= span_end(span)):
			identifier_span = Some(pack_span(span_source(span), span_start(span), span_end(token.span)))
			break

	identifier_span


-- The authored digits of the numeric literal that ends `span`: the whole span
-- of an unsigned number pattern, or the token after a sign.
pure func preview_number_literal_text(preview: PreviewSource, span: Span) -> Option[String]:
	match number_literal_text_in(preview, preview.tokens, span):
		Some(digits):
			Some(digits)
		None:
			number_literal_text_in(preview, preview.hole_tokens, span)


private pure func number_literal_text_in(preview: PreviewSource, tokens: List[Token], span: Span) -> Option[String]:
	var lower: Int = 0
	var upper: Int = tokens.length()

	while lower < upper:
		middle: Int = (lower + upper) / 2

		match tokens.get(middle):
			Some(token):
				if span_start(token.span) < span_start(span):
					lower = middle + 1
				else:
					upper = middle
			None:
				upper = lower

	var index: Int = lower
	var literal: Option[Token] = None

	while index < tokens.length():
		match tokens.get(index):
			Some(token):
				if span_start(token.span) >= span_end(span):
					break

				if (token.kind == IntLiteralToken or token.kind == FloatLiteralToken) and span_end(token.span) == span_end(span):
					literal = Some(token)
			None:
				break

		index += 1

	literal.map(pure func(token): preview_span_text(preview, token.span))
