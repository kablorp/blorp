-- Direct ordinary record declarations for the test-only parser leaf.
import:
	../syntax/declarations: RecordDeclaration, TypeParameter, RecordDeclarationForm(OrdinaryRecord, FixedRecord)
	../syntax/module_syntax: Documentation
	../tables/expected_token: NameConstruct(NameInTypeName)
	../tables/row_kinds: Visibility
	../tables/span: Span, span_covering
	parse_state:
		ParseState, diagnostic_count, consume_ordinary_name, finished_record
	tree_record_fields_parser:
		RecordFieldsForm(OrdinaryRecordFields, FixedRecordFields),
		RecordFieldsParse(ParsedRecordFields, RejectedRecordFields), parse_record_fields
	tree_type_parameter_parser:
		TypeParametersParse(NoTypeParameters, ParsedTypeParameters, RejectedTypeParameters), parse_type_parameters


union RecordParse:
	ParsedRecord(RecordDeclaration)
	RejectedRecord


pure func parse_record(
	state: ParseState, visibility: Visibility, documentation: Option[Documentation], start: Span,
) -> (ParseState, RecordParse):
	parse_record_form(state, visibility, documentation, start, OrdinaryRecord)


pure func parse_record_form(
	state: ParseState, visibility: Visibility, documentation: Option[Documentation], start: Span, form: RecordDeclarationForm,
) -> (ParseState, RecordParse):
	before: Int = state.diagnostic_count()
	(after_name, parsed_name) = state.consume_ordinary_name(NameInTypeName)

	if after_name.diagnostic_count() != before:
		(after_name, RejectedRecord)
	else:
		match parsed_name:
			None:
				(after_name, RejectedRecord)
			Some(name):
				(after_parameters, parsed_parameters) = parse_type_parameters(after_name)
				parameters: Option[List[TypeParameter]] = match parsed_parameters:
					NoTypeParameters:
						Some([])
					ParsedTypeParameters(written, _):
						Some(written)
					RejectedTypeParameters:
						None

				match parameters:
					None:
						(after_parameters, RejectedRecord)
					Some(parameters):
						fields_form: RecordFieldsForm = match form:
							OrdinaryRecord: OrdinaryRecordFields
							FixedRecord: FixedRecordFields
						(after_fields, parsed_fields) = parse_record_fields(after_parameters, fields_form)

						match parsed_fields:
							RejectedRecordFields:
								(after_fields, RejectedRecord)
							ParsedRecordFields(fields, end):
								if after_fields.diagnostic_count() != before:
									(after_fields, RejectedRecord)
								else:
									(after_record, declaration) = after_fields.finished_record(visibility, documentation, form, name, parameters, fields, start.span_covering(end))
									(after_record, ParsedRecord(declaration))
