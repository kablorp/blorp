import:
	../tables/ids: ModuleId


---
Whether the statement being parsed is inside a loop body. A function body
starts a new context (`NotInLoop`), and so does a lambda or `concurrent:` task
body: its `break` cannot leave the enclosing loop, and its `?=` returns from
the lambda or task, not the loop.
---
fixed union LoopContext:
	NotInLoop
	InLoopBody


---
What a body's statements and expressions need from where they sit: the module
whose definitions they declare (a local function belongs to the module of the
function that holds it) and the loop they are inside. The body parser passes
it down as an argument, so a nested body starts its own scope by building one
and nothing is saved, restored or looked up by position afterwards.
---
fixed record BodyScope {
	module: ModuleId,
	loop_context: LoopContext
}


---
The scope of a function body, global value or default method body in
`module`: outside every loop.
---
pure func body_scope(module: ModuleId) -> BodyScope:
	{
		module = module,
		loop_context = NotInLoop
	}


---
`scope` for a loop's body.
---
pure func in_loop_body(scope: BodyScope) -> BodyScope:
	{ scope | loop_context = InLoopBody }


---
`scope` for a lambda or `concurrent:` task body: a `break` there cannot leave
the loop it sits in.
---
pure func outside_loops(scope: BodyScope) -> BodyScope:
	{ scope | loop_context = NotInLoop }
