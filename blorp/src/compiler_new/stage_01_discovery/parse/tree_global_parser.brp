-- A global's initializer, read by the expression parser right after the
-- global's header. An initializer the expression parser does not read leaves
-- the state at its first token, with why.
import:
	../syntax/declarations: GlobalDeclaration
	../tables/span: span_covering
	../tables/token: TokenKind(NewlineToken)
	parse_state: ParseState, current_kind, finished_global
	stop_reason: StopPoint, StopReason(ValueOnNextLine), stop_at
	layout_quirks: anchored_at
	tree_global_header_parser: GlobalHeaderPreview
	tree_expression_parser: parse_expression_to_boundary, ExpressionParse(ParsedExpression, UnsupportedExpression, RejectedExpression)


union GlobalInitializerParse:
	ParsedInitializer(GlobalDeclaration)
	DeclinedInitializer(StopPoint)
	RejectedInitializer


---
The global `preview` declares, with the initializer at `state`, where its
header parser left the cursor. A value written on the line after the `=` is
not read yet; the lexer says so with a NEWLINE token. A rejected initializer
keeps its diagnostics.
---
pure func parse_global_initializer(state: ParseState, preview: GlobalHeaderPreview) -> (ParseState, GlobalInitializerParse):
	if state.current_kind() == NewlineToken:
		(state, DeclinedInitializer(state.stop_at(ValueOnNextLine)))
	else:
		(parsed, result) = parse_expression_to_boundary(state, anchored_at(preview.initializer.anchor))
		match result:
			UnsupportedExpression(stop):
				(state, DeclinedInitializer(stop))
			RejectedExpression:
				(parsed, RejectedInitializer)
			ParsedExpression(value):
				header = preview.header
				(completed, global_value) = parsed.finished_global(
					header.visibility, header.documentation, header.form, header.name,
					header.declared_type, value, preview.initializer.anchor.span_covering(value.span)
				)
				(completed, ParsedInitializer(global_value))
