-- A standalone union preview owns only its declaration and lexical
-- evidence. It does not publish a completed module or route production parsing.
import:
	../lex/lexed_module: LexedModule
	../syntax/declarations: UnionDeclaration, UnionDeclarationForm(OrdinaryUnion, FixedUnion)
	../syntax/spellings: spelling_text
	../tables/row_kinds: Visibility(PublicVisibility)
	../tables/token: TokenKind(IdentifierToken, UnionKeyword, NewlineToken, EndOfFileToken)
	parse_state:
		ParseInputError,
		ParseState,
		advanced,
		current_kind,
		current_span,
		current_token,
		peek_kind,
		spellings,
		diagnostic_count,
		diagnostics,
		new_parse_state,
	preview_source: PreviewSource, preview_source
	rejected_preview: RejectedPreview, reject_preview
	token_cursor: token_spelling
	tree_union_parser: UnionParse(ParsedUnion, RejectedUnion), parse_union


opaque type UnionPreview = PreviewContents


private record PreviewContents {
	declaration: UnionDeclaration,
	source: PreviewSource
}


union UnionPreviewOutcome:
	PreviewedUnion(UnionPreview)
	RejectedUnionPreview(RejectedPreview)
	UnsupportedUnionPreview


pure func union_declaration(preview: UnionPreview) -> UnionDeclaration:
	from_opaque UnionPreview(preview).declaration


pure func union_source(preview: UnionPreview) -> PreviewSource:
	from_opaque UnionPreview(preview).source


pure func preview_union(lexed: LexedModule) -> Result[UnionPreviewOutcome, ParseInputError]:
	state ?= new_parse_state(lexed)

	if state.diagnostic_count() != 0:
		rejected ?= reject_preview(state)
		Ok(RejectedUnionPreview(rejected))
	else if state.current_kind() != UnionKeyword and not fixed_union_starts(state):
		Ok(UnsupportedUnionPreview)
	else:
		form: UnionDeclarationForm = if fixed_union_starts(state):
			FixedUnion
		else:
			OrdinaryUnion
		after_introducer: ParseState = match form:
			FixedUnion: state.advanced().advanced()
			OrdinaryUnion: state.advanced()
		(parsed_state, result) = parse_union(
			after_introducer,
			PublicVisibility,
			None,
			state.current_span(),
			form,
		)

		match result:
			RejectedUnion:
				rejected ?= reject_preview(parsed_state)
				Ok(RejectedUnionPreview(rejected))
			ParsedUnion(declaration):
				var end: ParseState = parsed_state

				while end.current_kind() == NewlineToken:
					end = end.advanced()

				if end.current_kind() != EndOfFileToken:
					Ok(UnsupportedUnionPreview)
				else:
					Ok(PreviewedUnion(into_opaque UnionPreview({
									declaration = declaration,
									source = preview_source(lexed)
								})))


private FIXED_UNION_MARKER: String = "fixed"


private pure func fixed_union_starts(state: ParseState) -> Bool:
	if state.current_kind() != IdentifierToken or state.peek_kind(1) != UnionKeyword:
		False
	else:
		match state.current_token().token_spelling(state.spellings()):
			Some(spelling): state.spellings().spelling_text(spelling) == Some(FIXED_UNION_MARKER)
			None: False
