-- Match patterns, parsed into the node table.
--
-- Patterns are appended post-order like every node: each routine appends its
-- root last. A routine collecting a variable number of child patterns pushes
-- each child's root on the builder's child stack and claims them with
-- `append_parent_node_from_stack`; the number of children is the stack depth
-- gained. Shapes, recovery and accepted forms follow the existing parser.
import:
	../tables/builder:
		DiscoveryBuilder,
		NameId,
		advance_token,
		append_codepoint_leaf_node,
		append_leaf_node,
		append_literal_leaf_node,
		append_name_leaf_node,
		append_named_parent_node_from_stack,
		append_parent_node_from_stack,
		append_plain_diagnostic,
		child_stack_depth,
		last_node_id,
		literal_id_at_row,
		name_id_at_row,
		push_last_node,
	../tables/diagnostic_code:
		DiscoveryDiagnosticCode(
			ExpectedCommaDiagnostic,
			InterpolatedStringPatternDiagnostic,
			ExpectedNumberAfterMinusDiagnostic,
			ExpectedPatternDiagnostic,
			ExpectedRightBracketDiagnostic,
			ExpectedRightParenDiagnostic,
			ExpectedSpreadTargetDiagnostic,
			ReservedKeywordAsNameDiagnostic,
			TupleArityDiagnostic,
		),
	../tables/row_kinds:
		NodeKind(
			CharPatternNode,
			ConstructorPatternNode,
			FalsePatternNode,
			FloatPatternNode,
			IntegerPatternNode,
			ListPatternNode,
			ListSpreadNameNode,
			ListSpreadWildcardNode,
			MissingPatternNode,
			NamePatternNode,
			NegativeFloatPatternNode,
			NegativeIntegerPatternNode,
			OrPatternNode,
			PatternQualifierNode,
			QualifiedConstructorPatternNode,
			StringPatternNode,
			TruePatternNode,
			TuplePatternNode,
			WildcardPatternNode,
		),
	../tables/span: Span, span_covering
	../tables/token:
		Token,
		TokenKind(
			CharLiteralToken,
			CommaSymbol,
			DotDotDotSymbol,
			DotSymbol,
			EndOfFileToken,
			FalseKeyword,
			FloatLiteralToken,
			IdentifierToken,
			InterpolatedPipeStringToken,
			InterpolatedStringToken,
			IntLiteralToken,
			LeftBracketSymbol,
			LeftParenSymbol,
			MinusSymbol,
			NormalStringToken,
			PipeStringToken,
			PipeSymbol,
			RawPipeStringToken,
			RawStringToken,
			RightBracketSymbol,
			RightParenSymbol,
			TrueKeyword,
			UnderscoreSymbol,
		),
	parser_cursor:
		at,
		consume_referenced_name,
		current_name,
		current_span,
		current_token,
		expect_token,
		keyword_name_index,
		peek_kind,
		referenced_name_at_cursor,
		report_and_recover,
		report_at_current,
	type_parser: node_span


---
The fewest and most elements a tuple pattern may have.
---
private MIN_TUPLE_PATTERN_ITEMS: Int = 2

private MAX_TUPLE_PATTERN_ITEMS: Int = 4


---
A pattern: a simple pattern, or simple patterns separated by `|`.
---
pure func parse_pattern(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = builder.parse_simple_pattern()

	if out.at(PipeSymbol):
		out = out.parse_or_pattern_alternatives()

	out


---
The alternatives after the first of an or-pattern, which the caller parsed.
---
private pure func parse_or_pattern_alternatives(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	first_span: Span = builder.node_span(builder.last_node_id())
	depth_before: Int = builder.child_stack_depth()
	var out: DiscoveryBuilder = builder.push_last_node()
	var end: Span = first_span

	while out.at(PipeSymbol) and not out.at(EndOfFileToken):
		out = out.advance_token()
		out = out.parse_simple_pattern()
		end = out.node_span(out.last_node_id())
		out = out.push_last_node()

	count: Int = out.child_stack_depth() - depth_before
	out = out.append_parent_node_from_stack(
		OrPatternNode,
		first_span.span_covering(end),
		count,
	)
	out


---
A pattern without `|` at the top.
---
private pure func parse_simple_pattern(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	token: Token = builder.current_token()

	match token.kind:
		IdentifierToken:
			builder.parse_named_pattern()
		TrueKeyword:
			advanced: DiscoveryBuilder = builder.advance_token()
			advanced.append_leaf_node(TruePatternNode, token.span)
		FalseKeyword:
			advanced: DiscoveryBuilder = builder.advance_token()
			advanced.append_leaf_node(FalsePatternNode, token.span)
		UnderscoreSymbol:
			advanced: DiscoveryBuilder = builder.advance_token()
			advanced.append_leaf_node(WildcardPatternNode, token.span)
		LeftParenSymbol:
			builder.parse_tuple_pattern()
		LeftBracketSymbol:
			builder.parse_list_pattern()
		MinusSymbol:
			builder.parse_negative_number_pattern()
		IntLiteralToken:
			advanced: DiscoveryBuilder = builder.advance_token()
			advanced.append_literal_leaf_node(
				IntegerPatternNode,
				token.span,
				literal_id_at_row(token.payload),
			)
		FloatLiteralToken:
			advanced: DiscoveryBuilder = builder.advance_token()
			advanced.append_literal_leaf_node(
				FloatPatternNode,
				token.span,
				literal_id_at_row(token.payload),
			)
		NormalStringToken | RawStringToken | PipeStringToken | RawPipeStringToken:
			advanced: DiscoveryBuilder = builder.advance_token()
			advanced.append_literal_leaf_node(
				StringPatternNode,
				token.span,
				literal_id_at_row(token.payload),
			)
		InterpolatedStringToken | InterpolatedPipeStringToken:
			-- A pattern compares with a fixed string; holes have no value there.
			reported: DiscoveryBuilder = builder.report_at_current(
				InterpolatedStringPatternDiagnostic,
			)
			advanced: DiscoveryBuilder = reported.advance_token()
			advanced.append_leaf_node(MissingPatternNode, token.span)
		CharLiteralToken:
			advanced: DiscoveryBuilder = builder.advance_token()
			advanced.append_codepoint_leaf_node(CharPatternNode, token.span, token.payload)
		_:
			builder.parse_keyword_or_missing_pattern()


---
A name pattern for a soft keyword; a reserved keyword is reported and taken
as the name; anything else is a missing pattern.
---
private pure func parse_keyword_or_missing_pattern(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	token: Token = builder.current_token()

	match builder.current_name():
		Some(name):
			advanced: DiscoveryBuilder = builder.advance_token()
			advanced.append_name_leaf_node(NamePatternNode, token.span, name)
		None:
			match token.kind.keyword_name_index():
				Some(index):
					reported: DiscoveryBuilder = builder.report_at_current(
						ReservedKeywordAsNameDiagnostic,
					)
					advanced: DiscoveryBuilder = reported.advance_token()
					advanced.append_name_leaf_node(
						NamePatternNode,
						token.span,
						name_id_at_row(index),
					)
				None:
					recovered: DiscoveryBuilder = builder.report_and_recover(
						ExpectedPatternDiagnostic,
					)
					recovered.append_leaf_node(MissingPatternNode, token.span)


---
`name`, `Name(p, ...)`, `Type.Name` or `Type.Name(p, ...)`.
---
private pure func parse_named_pattern(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	token: Token = builder.current_token()

	match builder.peek_kind(1):
		DotSymbol:
			builder.parse_qualified_constructor_pattern()
		LeftParenSymbol:
			builder.parse_constructor_pattern()
		_:
			advanced: DiscoveryBuilder = builder.advance_token()
			advanced.append_name_leaf_node(
				NamePatternNode,
				token.span,
				name_id_at_row(token.payload),
			)


---
`Name(p, ...)`.
---
private pure func parse_constructor_pattern(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	token: Token = builder.current_token()
	depth_before: Int = builder.child_stack_depth()
	advanced: DiscoveryBuilder = builder.advance_token()
	var out: DiscoveryBuilder = advanced.parse_pattern_arguments()
	count: Int = out.child_stack_depth() - depth_before
	end: Span = out.closing_span_or(RightParenSymbol, token.span)
	out = out.expect_token(RightParenSymbol, ExpectedRightParenDiagnostic)
	out = out.append_named_parent_node_from_stack(
		ConstructorPatternNode,
		token.span.span_covering(end),
		name_id_at_row(token.payload),
		count,
	)
	out


---
`Type.Name` with optional arguments; the qualifier is a `PatternQualifierNode`
child ahead of the arguments.
---
private pure func parse_qualified_constructor_pattern(
	builder: DiscoveryBuilder,
) -> DiscoveryBuilder:
	token: Token = builder.current_token()
	depth_before: Int = builder.child_stack_depth()
	var out: DiscoveryBuilder = builder.append_name_leaf_node(
		PatternQualifierNode,
		token.span,
		name_id_at_row(token.payload),
	)
	out = out.push_last_node()
	-- The type name, then the `.`.
	out = out.advance_token()
	out = out.advance_token()
	constructor: NameId = out.referenced_name_at_cursor()
	constructor_span: Span = out.current_span()
	out = out.consume_referenced_name()
	var end: Span = constructor_span

	if out.at(LeftParenSymbol):
		out = out.parse_pattern_arguments()
		end = out.closing_span_or(RightParenSymbol, constructor_span)
		out = out.expect_token(RightParenSymbol, ExpectedRightParenDiagnostic)

	count: Int = out.child_stack_depth() - depth_before
	out = out.append_named_parent_node_from_stack(
		QualifiedConstructorPatternNode,
		token.span.span_covering(end),
		constructor,
		count,
	)
	out


---
The argument patterns after a constructor's `(`, which this consumes, each
pushed on the child stack; the `)` is left for the caller.
---
private pure func parse_pattern_arguments(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	advanced: DiscoveryBuilder = builder.advance_token()
	advanced.parse_pattern_list_until(RightParenSymbol)


---
Patterns separated by commas up to `end` (which is not consumed), each
pushed on the child stack; an empty list and a trailing comma are allowed.
---
private pure func parse_pattern_list_until(
	builder: DiscoveryBuilder,
	end: TokenKind,
) -> DiscoveryBuilder:
	if builder.at(end):
		builder
	else:
		builder.parse_pattern_items(end)


private pure func parse_pattern_items(
	builder: DiscoveryBuilder,
	end: TokenKind,
) -> DiscoveryBuilder:
	parsed: DiscoveryBuilder = builder.parse_pattern()
	var out: DiscoveryBuilder = parsed.push_last_node()
	var parsing: Bool = True

	while parsing:
		if out.at(CommaSymbol):
			out = out.advance_token()

			if out.at(end) or out.at(EndOfFileToken):
				parsing = False
			else:
				out = out.parse_pattern()
				out = out.push_last_node()
		else:
			parsing = False

	out


---
The span of the closing `kind` token at the cursor, or `fallback` when the
cursor is not at one (the caller then reports it).
---
private pure func closing_span_or(
	builder: DiscoveryBuilder,
	kind: TokenKind,
	fallback: Span,
) -> Span:
	if builder.at(kind):
		builder.current_span()
	else:
		fallback


---
`(p, q, ...)`: two to four elements.
---
private pure func parse_tuple_pattern(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	start: Span = builder.current_span()
	depth_before: Int = builder.child_stack_depth()
	advanced: DiscoveryBuilder = builder.advance_token()
	var out: DiscoveryBuilder = advanced.parse_pattern()
	var end: Span = out.node_span(out.last_node_id())
	out = out.push_last_node()

	if out.at(CommaSymbol):
		comma_span: Span = out.current_span()
		depth_before_rest: Int = out.child_stack_depth()
		out = out.advance_token()
		out = out.parse_pattern_list_until(RightParenSymbol)

		end = if out.child_stack_depth() > depth_before_rest:
			out.node_span(out.last_node_id())
		else:
			comma_span
	else:
		out = out.report_at_current(ExpectedCommaDiagnostic)

	if out.at(RightParenSymbol):
		end = out.current_span()

	out = out.expect_token(RightParenSymbol, ExpectedRightParenDiagnostic)
	count: Int = out.child_stack_depth() - depth_before
	span: Span = start.span_covering(end)

	if count < MIN_TUPLE_PATTERN_ITEMS or count > MAX_TUPLE_PATTERN_ITEMS:
		out = out.append_plain_diagnostic(TupleArityDiagnostic, span)

	out = out.append_parent_node_from_stack(TuplePatternNode, span, count)
	out


---
`[p, ...]`, optionally ending in a spread `...rest` or `..._`.
---
private pure func parse_list_pattern(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	start: Span = builder.current_span()
	depth_before: Int = builder.child_stack_depth()
	var out: DiscoveryBuilder = builder.advance_token()
	var end: Span = start

	if out.at(DotDotDotSymbol):
		out = out.parse_list_spread()
		end = out.node_span(out.last_node_id())
		out = out.push_last_node()
	else if not out.at(RightBracketSymbol):
		var parsing: Bool = True

		while parsing and not out.at(EndOfFileToken):
			out = out.parse_pattern()
			end = out.node_span(out.last_node_id())
			out = out.push_last_node()

			if out.at(CommaSymbol):
				out = out.advance_token()

				if out.at(DotDotDotSymbol):
					out = out.parse_list_spread()
					end = out.node_span(out.last_node_id())
					out = out.push_last_node()
					parsing = False
			else:
				parsing = False

	if out.at(RightBracketSymbol):
		end = out.current_span()

	out = out.expect_token(RightBracketSymbol, ExpectedRightBracketDiagnostic)
	count: Int = out.child_stack_depth() - depth_before
	out = out.append_parent_node_from_stack(
		ListPatternNode,
		start.span_covering(end),
		count,
	)
	out


---
`...name` or `..._` from the `...`. A missing target is reported and taken
as `..._`.
---
private pure func parse_list_spread(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	dots: Span = builder.current_span()
	var out: DiscoveryBuilder = builder.advance_token()
	target: Token = out.current_token()
	span: Span = dots.span_covering(target.span)

	match target.kind:
		IdentifierToken:
			out = out.advance_token()
			out = out.append_name_leaf_node(
				ListSpreadNameNode,
				span,
				name_id_at_row(target.payload),
			)
		UnderscoreSymbol:
			out = out.advance_token()
			out = out.append_leaf_node(ListSpreadWildcardNode, span)
		_:
			out = out.report_and_recover(ExpectedSpreadTargetDiagnostic)
			out = out.append_leaf_node(ListSpreadWildcardNode, span)

	out


---
`-3` or `-1.5`; a `-` before anything else is reported.
---
private pure func parse_negative_number_pattern(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	minus: Span = builder.current_span()
	var out: DiscoveryBuilder = builder.advance_token()
	number: Token = out.current_token()
	span: Span = minus.span_covering(number.span)

	match number.kind:
		IntLiteralToken:
			advanced: DiscoveryBuilder = out.advance_token()
			out = advanced.append_literal_leaf_node(
				NegativeIntegerPatternNode,
				span,
				literal_id_at_row(number.payload),
			)
		FloatLiteralToken:
			out = out.advance_token()
			out = out.append_literal_leaf_node(
				NegativeFloatPatternNode,
				span,
				literal_id_at_row(number.payload),
			)
		_:
			out = out.append_plain_diagnostic(ExpectedNumberAfterMinusDiagnostic, minus)
			out = out.append_leaf_node(MissingPatternNode, minus)

	out
