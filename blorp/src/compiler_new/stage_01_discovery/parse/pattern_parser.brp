-- Match patterns, parsed into the node table.
--
-- Patterns are appended post-order like every node: each routine appends its
-- root last. A routine collecting a variable number of child patterns pushes
-- each child's root on the builder's child stack and claims them with
-- `append_parent_node_since`; the number of children is the children pushed
-- since a `ChildMark`. Shapes, recovery and accepted forms follow the existing parser.
import:
	../tables/builder: DiscoveryBuilder, advance_token, append_plain_diagnostic
	../tables/diagnostic_code:
		DiscoveryDiagnosticCode(
			ExpectedCommaDiagnostic, ExpectedNumberAfterMinusDiagnostic, ExpectedPatternDiagnostic,
			ExpectedRightBracketDiagnostic, ExpectedRightParenDiagnostic,
			ExpectedSpreadTargetDiagnostic, InterpolatedStringPatternDiagnostic,
			ReservedKeywordAsNameDiagnostic, TupleArityDiagnostic,
		),
	../tables/ids: NameId, literal_id_at_row, name_id_at_row
	../tables/node_builder:
		ChildMark,
		append_codepoint_leaf_node,
		append_leaf_node,
		append_literal_leaf_node,
		append_name_leaf_node,
		append_named_parent_node_since,
		append_parent_node_since,
		child_count_since,
		last_node_id,
		mark_children,
		push_last_node,
		record_name_span_of_last_node,
	../tables/row_kinds:
		NodeKind(
			CharPatternNode, ConstructorPatternNode, FalsePatternNode, FloatPatternNode,
			IntegerPatternNode, ListPatternNode, ListSpreadNameNode, ListSpreadWildcardNode,
			MissingPatternNode, NamePatternNode, NegativeFloatPatternNode,
			NegativeIntegerPatternNode, OrPatternNode, PatternQualifierNode, PipeStringPatternNode,
			QualifiedConstructorPatternNode, RawPipeStringPatternNode, RawStringPatternNode,
			StringPatternNode, TruePatternNode, TuplePatternNode, WildcardPatternNode,
		),
		ParsedConstruct(
			ConstructorName, ConstructorPattern, ListPattern, TuplePattern, TuplePatternItems,
		),
	../tables/span: Span, span_covering
	../tables/token:
		Token,
		TokenKind(
			CharLiteralToken, CommaSymbol, DotDotDotSymbol, DotSymbol, EndOfFileToken, FalseKeyword,
			FloatLiteralToken, IdentifierToken, IntLiteralToken, InterpolatedPipeStringToken,
			InterpolatedStringToken, LeftBracketSymbol, LeftParenSymbol, MinusSymbol,
			NormalStringToken, PipeStringToken, PipeSymbol, RawPipeStringToken, RawStringToken,
			RightBracketSymbol, RightParenSymbol, TrueKeyword, UnderscoreSymbol,
		),
	parser_cursor:
		at,
		consume_referenced_name,
		current_name,
		current_span,
		current_token,
		expect_token,
		expect_token_in,
		keyword_name_index,
		peek_kind,
		referenced_name_at_cursor,
		report_and_recover,
		report_at_current,
		report_at_current_in,
		report_at_current_with_argument,
	type_parser: node_span


---
The fewest and most elements a tuple pattern may have.
---
private MIN_TUPLE_PATTERN_ITEMS: Int = 2

private MAX_TUPLE_PATTERN_ITEMS: Int = 4


---
A pattern: a simple pattern, or simple patterns separated by `|`.
---
pure func parse_pattern(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	first: DiscoveryBuilder = builder.parse_simple_pattern()

	if first.at(PipeSymbol):
		first.parse_or_pattern_alternatives()
	else:
		first


---
The alternatives after the first of an or-pattern, which the caller parsed.
---
private pure func parse_or_pattern_alternatives(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	first_span: Span = builder.node_span(builder.last_node_id())
	mark: ChildMark = builder.mark_children()
	var out: DiscoveryBuilder = builder.push_last_node()
	var end: Span = first_span

	while out.at(PipeSymbol) and not out.at(EndOfFileToken):
		out = out.advance_token()
		out = out.parse_simple_pattern()
		end = out.node_span(out.last_node_id())
		out = out.push_last_node()

	out.append_parent_node_since(
		mark,
		OrPatternNode,
		first_span.span_covering(end),
	)


---
A pattern without `|` at the top.
---
private pure func parse_simple_pattern(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	token: Token = builder.current_token()

	match token.kind:
		IdentifierToken:
			builder.parse_named_pattern()
		TrueKeyword:
			builder
				.advance_token()
				.append_leaf_node(TruePatternNode, token.span)
		FalseKeyword:
			builder
				.advance_token()
				.append_leaf_node(FalsePatternNode, token.span)
		UnderscoreSymbol:
			builder
				.advance_token()
				.append_leaf_node(WildcardPatternNode, token.span)
		LeftParenSymbol:
			builder.parse_tuple_pattern()
		LeftBracketSymbol:
			builder.parse_list_pattern()
		MinusSymbol:
			builder.parse_negative_number_pattern()
		IntLiteralToken:
			builder
				.advance_token()
				.append_literal_leaf_node(
					IntegerPatternNode,
					token.span,
					literal_id_at_row(token.payload),
				)
		FloatLiteralToken:
			builder
				.advance_token()
				.append_literal_leaf_node(
					FloatPatternNode,
					token.span,
					literal_id_at_row(token.payload),
				)
		NormalStringToken | RawStringToken | PipeStringToken | RawPipeStringToken:
			builder
				.advance_token()
				.append_literal_leaf_node(
					string_pattern_kind(token.kind),
					token.span,
					literal_id_at_row(token.payload),
				)
		InterpolatedStringToken | InterpolatedPipeStringToken:
			-- A pattern compares with a fixed string; holes have no value there.
			builder
				.report_at_current(InterpolatedStringPatternDiagnostic)
				.advance_token()
				.append_leaf_node(MissingPatternNode, token.span)
		CharLiteralToken:
			builder
				.advance_token()
				.append_codepoint_leaf_node(CharPatternNode, token.span, token.payload)
		_:
			builder.parse_keyword_or_missing_pattern()


---
The node kind of a string pattern written as the string token `kind`: the form
the pattern was written in, which the existing AST records.
---
private pure func string_pattern_kind(kind: TokenKind) -> NodeKind:
	match kind:
		RawStringToken:
			RawStringPatternNode
		PipeStringToken:
			PipeStringPatternNode
		RawPipeStringToken:
			RawPipeStringPatternNode
		_:
			StringPatternNode


---
A name pattern for a soft keyword; a reserved keyword is reported and taken
as the name; anything else is a missing pattern.
---
private pure func parse_keyword_or_missing_pattern(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	token: Token = builder.current_token()

	match builder.current_name():
		Some(name):
			builder
				.advance_token()
				.append_name_leaf_node(NamePatternNode, token.span, name)
		None:
			match token.kind.keyword_name_index():
				Some(index):
					builder
						.report_at_current_with_argument(ReservedKeywordAsNameDiagnostic, index)
						.advance_token()
						.append_name_leaf_node(NamePatternNode, token.span, name_id_at_row(index))
				None:
					builder
						.report_and_recover(ExpectedPatternDiagnostic)
						.append_leaf_node(MissingPatternNode, token.span)


---
`name`, `Name(p, ...)`, `Type.Name` or `Type.Name(p, ...)`.
---
private pure func parse_named_pattern(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	token: Token = builder.current_token()

	match builder.peek_kind(1):
		DotSymbol:
			builder.parse_qualified_constructor_pattern()
		LeftParenSymbol:
			builder.parse_constructor_pattern()
		_:
			builder
				.advance_token()
				.append_name_leaf_node(NamePatternNode, token.span, name_id_at_row(token.payload))


---
`Name(p, ...)`.
---
private pure func parse_constructor_pattern(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	token: Token = builder.current_token()
	mark: ChildMark = builder.mark_children()
	arguments: DiscoveryBuilder = builder
		.advance_token()
		.parse_pattern_arguments()
	end: Span = arguments.closing_span_or(RightParenSymbol, token.span)
	arguments
		.expect_token_in(RightParenSymbol, ExpectedRightParenDiagnostic, ConstructorPattern)
		.append_named_parent_node_since(
			mark,
			ConstructorPatternNode,
			token.span.span_covering(end),
			name_id_at_row(token.payload),
			token.span,
		)


---
`Type.Name` with optional arguments; the qualifier is a `PatternQualifierNode`
child ahead of the arguments.
---
private pure func parse_qualified_constructor_pattern(
	builder: DiscoveryBuilder,
) -> DiscoveryBuilder:
	token: Token = builder.current_token()
	mark: ChildMark = builder.mark_children()
	-- The type name, then the `.`.
	qualified: DiscoveryBuilder = builder
		.append_name_leaf_node(PatternQualifierNode, token.span, name_id_at_row(token.payload))
		.push_last_node()
		.advance_token()
		.advance_token()
	constructor: NameId = qualified.referenced_name_at_cursor()
	constructor_span: Span = qualified.current_span()
	named: DiscoveryBuilder = qualified.consume_referenced_name(ConstructorName)

	if named.at(LeftParenSymbol):
		arguments: DiscoveryBuilder = named.parse_pattern_arguments()
		end: Span = arguments.closing_span_or(RightParenSymbol, constructor_span)
		arguments
			.expect_token_in(RightParenSymbol, ExpectedRightParenDiagnostic, ConstructorPattern)
			.append_named_parent_node_since(
				mark,
				QualifiedConstructorPatternNode,
				token.span.span_covering(end),
				constructor,
				constructor_span,
			)
	else:
		named.append_named_parent_node_since(
			mark,
			QualifiedConstructorPatternNode,
			token.span.span_covering(constructor_span),
			constructor,
			constructor_span,
		)


---
The argument patterns after a constructor's `(`, which this consumes, each
pushed on the child stack; the `)` is left for the caller.
---
private pure func parse_pattern_arguments(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	builder
		.advance_token()
		.parse_pattern_list_until(RightParenSymbol)


---
Patterns separated by commas up to `end` (which is not consumed), each
pushed on the child stack; an empty list and a trailing comma are allowed.
---
private pure func parse_pattern_list_until(
	builder: DiscoveryBuilder,
	end: TokenKind,
) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = builder
	var parsing: Bool = not out.at(end)

	while parsing:
		out = out.parse_pattern()
		out = out.push_last_node()

		if out.at(CommaSymbol):
			out = out.advance_token()
			parsing = not (out.at(end) or out.at(EndOfFileToken))
		else:
			parsing = False

	out


---
The span of the closing `kind` token at the cursor, or `fallback` when the
cursor is not at one (the caller then reports it).
---
private pure func closing_span_or(
	builder: DiscoveryBuilder,
	kind: TokenKind,
	fallback: Span,
) -> Span:
	if builder.at(kind):
		builder.current_span()
	else:
		fallback


---
`(p, q, ...)`: two to four elements.
---
private pure func parse_tuple_pattern(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	start: Span = builder.current_span()
	mark: ChildMark = builder.mark_children()
	var out: DiscoveryBuilder = builder
		.advance_token()
		.parse_pattern()
	var end: Span = out.node_span(out.last_node_id())
	out = out.push_last_node()

	if out.at(CommaSymbol):
		comma_span: Span = out.current_span()
		rest_mark: ChildMark = out.mark_children()
		out = out.advance_token()
		out = out.parse_pattern_list_until(RightParenSymbol)

		end = if out.child_count_since(rest_mark) > 0:
			out.node_span(out.last_node_id())
		else:
			comma_span
	else:
		out = out.report_at_current_in(ExpectedCommaDiagnostic, TuplePatternItems)

	if out.at(RightParenSymbol):
		end = out.current_span()

	out = out.expect_token_in(RightParenSymbol, ExpectedRightParenDiagnostic, TuplePattern)
	count: Int = out.child_count_since(mark)
	span: Span = start.span_covering(end)

	if count < MIN_TUPLE_PATTERN_ITEMS or count > MAX_TUPLE_PATTERN_ITEMS:
		out = out.append_plain_diagnostic(TupleArityDiagnostic, span)

	out.append_parent_node_since(mark, TuplePatternNode, span)


---
`[p, ...]`, optionally ending in a spread `...rest` or `..._`.
---
private pure func parse_list_pattern(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	start: Span = builder.current_span()
	mark: ChildMark = builder.mark_children()
	var out: DiscoveryBuilder = builder.advance_token()
	var end: Span = start

	if out.at(DotDotDotSymbol):
		out = out.parse_list_spread()
		end = out.node_span(out.last_node_id())
		out = out.push_last_node()
	else if not out.at(RightBracketSymbol):
		var parsing: Bool = True

		while parsing and not out.at(EndOfFileToken):
			out = out.parse_pattern()
			end = out.node_span(out.last_node_id())
			out = out.push_last_node()

			if out.at(CommaSymbol):
				out = out.advance_token()

				if out.at(DotDotDotSymbol):
					out = out.parse_list_spread()
					end = out.node_span(out.last_node_id())
					out = out.push_last_node()
					parsing = False
			else:
				parsing = False

	if out.at(RightBracketSymbol):
		end = out.current_span()

	out = out.expect_token_in(RightBracketSymbol, ExpectedRightBracketDiagnostic, ListPattern)
	out.append_parent_node_since(
		mark,
		ListPatternNode,
		start.span_covering(end),
	)


---
`...name` or `..._` from the `...`. A missing target is reported and taken
as `..._`.
---
private pure func parse_list_spread(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	dots: Span = builder.current_span()
	var out: DiscoveryBuilder = builder.advance_token()
	target: Token = out.current_token()
	span: Span = dots.span_covering(target.span)

	match target.kind:
		IdentifierToken:
			out = out.advance_token()
			out = out.append_name_leaf_node(
				ListSpreadNameNode,
				span,
				name_id_at_row(target.payload),
			)
			out = out.record_name_span_of_last_node(target.span)
		UnderscoreSymbol:
			out = out.advance_token()
			out = out.append_leaf_node(ListSpreadWildcardNode, span)
			out = out.record_name_span_of_last_node(target.span)
		_:
			out = out.report_and_recover(ExpectedSpreadTargetDiagnostic)
			out = out.append_leaf_node(ListSpreadWildcardNode, span)
			out = out.record_name_span_of_last_node(span)

	out


---
`-3` or `-1.5`; a `-` before anything else is reported.
---
private pure func parse_negative_number_pattern(builder: DiscoveryBuilder) -> DiscoveryBuilder:
	minus: Span = builder.current_span()
	var out: DiscoveryBuilder = builder.advance_token()
	number: Token = out.current_token()
	span: Span = minus.span_covering(number.span)

	match number.kind:
		IntLiteralToken:
			advanced: DiscoveryBuilder = out.advance_token()
			out = advanced.append_literal_leaf_node(
				NegativeIntegerPatternNode,
				span,
				literal_id_at_row(number.payload),
			)
		FloatLiteralToken:
			out = out.advance_token()
			out = out.append_literal_leaf_node(
				NegativeFloatPatternNode,
				span,
				literal_id_at_row(number.payload),
			)
		_:
			out = out.append_plain_diagnostic(ExpectedNumberAfterMinusDiagnostic, minus)
			out = out.append_leaf_node(MissingPatternNode, minus)

	out
