-- The statement-and-block slice of M4: indented blocks of the statements
-- below, and the top-level function bodies made of them. It follows the
-- expression slice's discipline. Recognition builds ID-free recipes and
-- accepts the whole body or none of it; only then does minting issue every
-- id, in source order, children before their owner.
--
-- Supported statements: an expression, `var`, `x: T = v`, `x = v`, `_ = v`,
-- `x [: T] ?= v` outside loops, `x op= v`, `xs[i] = v`, `if` / `else if` /
-- `else`, `match` with block or same-line cases, `while`, `for name in
-- iterable`, `for (a, b) in iterable`, `break` and `continue`.
-- `select:`, `with`, `concurrent:` and `debug:` blocks, each as a statement.
-- Anything else (tuple destructuring, a `with`, `concurrent` or `debug`
-- value, a value on the line after its operator, an expression the expression
-- slice does not read, a syntax error) is unsupported: the entry points return
-- the exact state they were given.
--
-- Recipes are walked by loops wherever the source can make them long: the
-- statements of a block and the links of an `else if` chain. Recursion
-- follows only the indentation the source itself nests.
--
-- A written type or a pattern issues ids of its own. Recognition parses one
-- only to learn where it ends and where it is valid, discards the ids it
-- issued (`resumed_after`), and records the token it started at; minting
-- parses it again from there, so its ids follow its neighbours' in source
-- order. The same replay restarts a function's skipped body.
import:
	../syntax/declarations: FunctionDeclaration, LocalFunction
	../syntax/expressions:
		AssignmentTarget(AssignsName, AssignsDiscard), Block, Body(BlockBody, ExpressionBody), CaseBody(CaseBlock, CaseStatement),
		CompoundOperator(AddAssign, SubtractAssign, MultiplyAssign, DivideAssign), ElseBody(ElseBlock, ElseIf), ElseBranch, Expression,
		CountParameter, ErrorMap, ExpressionKind(If, Match, Break, Continue, Lambda, VoidValue, Select, With, DebugBlock, ConcurrentBlock), LambdaParameter,
		LoopBinder(LoopVariable, LoopTuple), MatchCase, SelectArm, SelectArmKind(ReceiveArm, SealedArm, AfterArm), Statement, TimeoutParameter,
		WithAcquisition(WithValue, WithTry),
		StatementKind(ExpressionStatement, VariableDeclaration, TypedBinding, QuestionBinding, LocalFunctionStatement, Assignment, CompoundAssignment, SubscriptAssignment, WhileLoop, ForLoop)
	../syntax/checked_values: PositiveCount, positive_count
	../syntax/names: BindingTarget(BindsName, DiscardsValue), WrittenName
	../syntax/patterns: Pattern
	../syntax/sequences: AtLeastOne, SmallTuple(Pair, Triple, Quadruple), at_least_one_items
	../syntax/spellings: Spellings, spelling_text
	../syntax/types: WrittenType
	../tables/row_kinds: Purity(PureFunction, ImpureFunction), Visibility(PublicVisibility)
	../tables/expected_token: NameConstruct(NameInStatementName, NameInVariableName, NameInConcurrentNamedParameter)
	../tables/span: Span, span_covering
	../tables/token:
		TokenKind(IdentifierToken, UnderscoreSymbol, VarKeyword, WhileKeyword, ForKeyword, IfKeyword, ElseKeyword, MatchKeyword,
			BreakKeyword, ContinueKeyword, InKeyword, AsKeyword, ConcurrentlyKeyword, SelectKeyword, WithKeyword, ConcurrentKeyword, DebugKeyword, SealedKeyword, FromKeyword, OnKeyword, AfterKeyword, FatArrowSymbol, EqualSymbol, ColonSymbol, QuestionEqualsSymbol, PlusEqualSymbol, MinusEqualSymbol,
			StarEqualSymbol, SlashEqualSymbol, LeftParenSymbol, RightParenSymbol, CommaSymbol, FuncKeyword, PureKeyword, ArrowSymbol, NewlineToken, IndentToken, DedentToken, EndOfFileToken, DotSymbol)
	binary_operators: binary_operator
	parse_state:
		ParseState, current_kind, current_span, previous_span, peek_kind, position, advanced, diagnostic_count, span_start_line, spellings,
		consume_referenced_name, finished_expression, finished_statement, finished_block, finished_else_if,
		finished_subscript_place, finished_function, finished_local_function, inside_hole, report_unreachable_input, finished_name_use, finished_binder, resumed_at, resumed_after
	stop_reason:
		StopPoint, Recognition(Recognized, Declined), Boundary(AtBoundary, PastBoundary),
		StopReason(BodyReplayDisagrees, ReplayReported, BodylessFunction, BodyNotOnHeaderLine, BlockWithoutIndent, BlockNotClosed, LocalFunctionHeaderRejected,
			LambdaInInterpolationHole, MalformedLambdaHeader, ExpressionSyntaxError, ValueOnNextLine, TupleDestructuring, FieldAssignment, NonPlaceAssignmentTarget, AssignmentTargetRoutedElsewhere,
			LoopExitOutsideLoop, QuestionBindingInLoop, MalformedTypedBinding, VarWithoutName, VarWithoutInitializer, InvalidType, InvalidPattern,
			ConcurrentlyLoop, HeaderWithoutColon, ForWithoutIn, InvalidLoopBinding, MalformedElse, OperatorAfterBlock, MatchWithoutBlock, MatchNotClosed,
			CaseWithoutColon, NestedBlockInCaseLine, SelectWithoutArms, SelectNotClosed, SelectArmMalformed, WithBindingMalformed, WithHeaderWithoutColon,
			WithErrorMapMalformed, ConcurrentHeaderWithoutColon, ConcurrentParametersMalformed, ConcurrentParameterUnknown, ConcurrentParameterRepeated,
			ConcurrentCountNotLiteral),
		stop_at, statement_boundary, mapped, opens_block_form
	tree_expression_parser:
		ExpressionRecipe, RecipeKind(NameRecipe, IntegerRecipe, FloatRecipe, StringRecipe, InterpolatedRecipe, CharacterRecipe, BooleanRecipe, VoidRecipe, UnaryRecipe, BinaryRecipe, GroupingRecipe, CallRecipe, FieldRecipe, SubscriptRecipe, ListRecipe, TupleRecipe, VectorRecipe, RecordRecipe, UpdateRecipe, DictRecipe, DetachRecipe, LambdaAtomRecipe), RecipeParse(ParsedRecipe, UnsupportedRecipe, RejectedRecipe), parse_expression_recipe, mint_recipe, subscript_parts, is_block_lambda
	tree_function_header_parser:
		DeferredBody, FunctionHeaderPreview, FunctionHeaderParse(ParsedFunctionHeader, RejectedFunctionHeader), FunctionBodyExtent(ForwardDeclaration, SkippedBody),
		deferred_body_token_start, deferred_body_token_end, parse_function_header
	tree_pattern_parser: parse_pattern
	tree_type_parser: parse_type


-- Whether `break` and `continue` have a loop to leave. A parameter: a nested
-- loop body passes `InsideLoop` down and nothing saves or restores it.
private enum BodyContext:
	OutsideLoop
	InsideLoop


-- A written type, replayed at minting from the token it starts at.
record TypeRecipe {
	token: Int
}


-- A pattern, replayed at minting from its first token.
private record PatternRecipe {
	token: Int
}


private record StatementRecipe {
	span: Span,
	kind: StatementRecipeKind
}


-- What follows `=` or `op=`: an expression, or an `if`, `match` or `select`
-- whose blocks end on dedents. The frozen language has no one-line `if`, so a
-- control expression is always block-shaped, and it is a whole value: as an
-- operand, an argument or a global's initializer it stays unsupported. Giving
-- the whole-value position its own type keeps a control expression out of
-- `ExpressionRecipe`, whose boundary rules assume the expression ends on a
-- line. `with`, `concurrent` and `debug` are not values here: the frozen
-- parser indents their block past the keyword, not past the statement, so a
-- value written the usual way is rejected there and must not be read here.
private union ValueRecipe:
	PlainValue(ExpressionRecipe)
	ConditionalValue(ConditionalRecipe)
	MatchValue(MatchRecipe)
	SelectValue(SelectRecipe)


private union StatementRecipeKind:
	ExpressionStatementRecipe(ExpressionRecipe)
	LoopExitRecipe(LoopExit)
	ConditionalStatementRecipe(ConditionalRecipe)
	MatchStatementRecipe(MatchRecipe)
	SelectStatementRecipe(SelectRecipe)
	WithStatementRecipe(WithRecipe)
	ConcurrentStatementRecipe(ConcurrentRecipe)
	DebugStatementRecipe(DebugRecipe)
	VariableRecipe(WrittenName, Option[TypeRecipe], ValueRecipe)
	TypedBindingRecipe(WrittenName, TypeRecipe, ValueRecipe)
	QuestionBindingRecipe(WrittenName, Option[TypeRecipe], ValueRecipe)
	AssignmentRecipe(AssignmentTargetRecipe, ValueRecipe)
	CompoundAssignmentRecipe(WrittenName, CompoundOperator, ValueRecipe)
	SubscriptAssignmentRecipe(SubscriptPlaceRecipe, ValueRecipe)
	WhileRecipe(ExpressionRecipe, BlockRecipe)
	ForRecipe(LoopBindingRecipe, ExpressionRecipe, BlockRecipe)
	LocalFunctionRecipe(LocalFunctionBody)


private enum LoopExit:
	ExitWithBreak
	ExitWithContinue


private union AssignmentTargetRecipe:
	NamedTargetRecipe(WrittenName)
	DiscardedTargetRecipe(Span)


-- A local function: its header is replayed from the token it starts at, so its
-- ids follow its neighbours', and its own body is a recipe read once.
private record LocalFunctionBody {
	keyword_token: Int,
	start: Span,
	purity: Purity,
	body: BodyRecipe
}


-- A lambda before minting: parameters and return type replay from their
-- tokens, and the body is a recipe. `span` runs from `func` or `pure` to the
-- end of the body.
record LambdaRecipe {
	purity: Purity,
	parameters: List[LambdaParameterRecipe],
	return_type: Option[TypeRecipe],
	body: BodyRecipe,
	span: Span
}


record LambdaParameterRecipe {
	binder: BinderRecipe,
	declared_type: Option[TypeRecipe]
}


-- A binding position that may discard.
union BinderRecipe:
	BindsNameRecipe(WrittenName)
	DiscardsRecipe(Span)


-- `for x in` / `for _ in`, or `for (a, b) in` with the parenthesized span.
private union LoopBindingRecipe:
	LoopVariableRecipe(BinderRecipe)
	LoopTupleRecipe(SmallTuple[BinderRecipe], Span)


private record SubscriptPlaceRecipe {
	span: Span,
	collection: ExpressionRecipe,
	indices: AtLeastOne[ExpressionRecipe]
}


private record BlockRecipe {
	statements: AtLeastOne[StatementRecipe]
}


-- An `if` and its `else` chain, flat: the chain's length is a list's length,
-- never a nesting of recipes.
private record ConditionalRecipe {
	head: IfLink,
	else_ifs: List[ElseIfLink],
	final_else: Option[ElseBlockRecipe]
}


private record IfLink {
	keyword: Span,
	condition: ExpressionRecipe,
	then_block: BlockRecipe
}


private record ElseIfLink {
	else_keyword: Span,
	link: IfLink
}


private record ElseBlockRecipe {
	keyword: Span,
	block: BlockRecipe
}


-- `end` is the closing dedent's span, which the expression's own span
-- reaches (the frozen parser's rule).
private record MatchRecipe {
	keyword: Span,
	scrutinee: ExpressionRecipe,
	cases: AtLeastOne[CaseRecipe],
	end: Span
}


private record CaseRecipe {
	pattern: PatternRecipe,
	body: CaseBodyRecipe
}


private union CaseBodyRecipe:
	CaseBlockRecipe(BlockRecipe)
	CaseStatementRecipe(StatementRecipe)


-- The state of an unsupported result is meaningless: the public entry points
-- return their own entry state. What it carries is why recognition declined.
private union StatementParse:
	ParsedStatement(StatementRecipe)
	UnsupportedStatement(StopPoint)


private union BlockParse:
	ParsedBlock(BlockRecipe)
	UnsupportedBlock(StopPoint)


-- A body before minting: an indented block, or an expression on the `:` line.
union BodyRecipe:
	BlockBodyRecipe(BlockRecipe)
	ExpressionBodyRecipe(ExpressionRecipe)


union FunctionCompletion:
	CompletedFunction(FunctionDeclaration)
	DeferredFunction(StopPoint)


-- A body read in full, and the span its owner's span reaches.
record CompletedBody {
	body: Body,
	span: Span
}


-- `state` is where a header parser left the cursor, past the body it skipped.
-- The body is replayed from the recorded token; it must end where the skipped
-- extent ends, apart from newlines, so the two grammars agree on the extent.
-- The colon that promised the body is the token before it. A body this slice
-- does not read gets the stop that declined it and the state it was given; one
-- it does read gets the state back with the spellings the recognition added,
-- at the skipped end.
pure func recognize_skipped_body(state: ParseState, skipped: DeferredBody) -> (ParseState, Recognition[BodyRecipe]):
	skipped_end: Int = deferred_body_token_end(skipped)
	at_body: ParseState = state.resumed_at(deferred_body_token_start(skipped))
	(recognized, parsed) = parse_body_recipe(at_body, at_body.span_start_line(at_body.previous_span()))
	match parsed:
		Declined(stop):
			(state, Declined(stop))
		Recognized(recipe):
			if not recognized.replay_ends_with(state, skipped_end):
				(state, Declined(state.stop_at(BodyReplayDisagrees)))
			else:
				(state.resumed_after(recognized).resumed_at(skipped_end), Recognized(recipe))


-- A replay agrees with the skipped extent when it reported nothing the skip
-- did not and left only layout before the extent's end.
private pure func replay_ends_with(recognized: ParseState, skipped: ParseState, skipped_end: Int) -> Bool:
	skipped.position() == skipped_end and recognized.diagnostic_count() == skipped.diagnostic_count() and recognized.only_newlines_until(skipped_end)


-- Recognize, then mint. A replay that reports anything leaves the body unread.
pure func complete_body(state: ParseState, skipped: DeferredBody) -> (ParseState, Recognition[CompletedBody]):
	(recognized, recipe) = recognize_skipped_body(state, skipped)
	match recipe:
		Recognized(body):
			(minted, completed) = mint_body_recipe(recognized, body)
			if minted.diagnostic_count() != state.diagnostic_count():
				(state, Declined(minted.stop_at(ReplayReported)))
			else:
				(minted.resumed_at(deferred_body_token_end(skipped)), Recognized(completed))
		Declined(stop):
			(state, Declined(stop))


private pure func mint_body_recipe(state: ParseState, recipe: BodyRecipe) -> (ParseState, CompletedBody):
	match recipe:
		BlockBodyRecipe(block_recipe):
			(minted, block) = mint_block(state, block_recipe)
			(minted, { body = BlockBody(block), span = block.span })
		ExpressionBodyRecipe(expression_recipe):
			(minted, expression) = mint_recipe(state, expression_recipe)
			(minted, { body = ExpressionBody(expression), span = expression.span })


private pure func body_recipe_span(recipe: BodyRecipe) -> Span:
	match recipe:
		BlockBodyRecipe(block):
			block_span(block)
		ExpressionBodyRecipe(expression):
			expression.span


-- The function owns its header's ids and its body's, so it is minted last. A
-- forward declaration completes with no body: its span is its header, through
-- the colon that promised none, and module assembly pairs it.
pure func complete_function(state: ParseState, preview: FunctionHeaderPreview) -> (ParseState, FunctionCompletion):
	header = preview.header
	match preview.body_extent:
		ForwardDeclaration:
			(declared, declaration) = state.finished_function(
				header.visibility, header.documentation, header.annotations,
				{ signature = header.signature, type_parameters = header.type_parameters, constraints = header.constraints, body = None },
				header.header_span
			)
			(declared, CompletedFunction(declaration))
		SkippedBody(skipped):
			(completed, body) = complete_body(state, skipped)
			match body:
				Recognized(read):
					(declared, declaration) = completed.finished_function(
						header.visibility, header.documentation, header.annotations,
						{ signature = header.signature, type_parameters = header.type_parameters, constraints = header.constraints, body = Some(read.body) },
						header.header_span.span_covering(read.span)
					)
					(declared, CompletedFunction(declaration))
				Declined(stop):
					(state, DeferredFunction(stop))


private pure func only_newlines_until(state: ParseState, end: Int) -> Bool:
	var ahead: Int = 0
	var layout_only: Bool = state.position() <= end
	while layout_only and state.position() + ahead < end:
		layout_only = state.peek_kind(ahead) == NewlineToken
		ahead += 1
	layout_only


private pure func skip_newlines(state: ParseState) -> ParseState:
	var out: ParseState = state
	while out.current_kind() == NewlineToken:
		out = out.advanced()
	out


-- The statement after an `if` or `match` block starts where the dedent left
-- the cursor. The frozen parser would read a binary operator there as a
-- continuation of the block's expression.
private pure func block_statement_ends(state: ParseState) -> Bool:
	kind: TokenKind = state.current_kind()
	kind != AsKeyword and kind != EqualSymbol and binary_operator(kind).is_none()


private pure func is_on_line(state: ParseState, line: Int) -> Bool:
	state.span_start_line(state.current_span()) == line


-- Bodies.
private pure func parse_body_recipe(state: ParseState, colon_line: Int) -> (ParseState, Recognition[BodyRecipe]):
	if state.current_kind() == NewlineToken:
		(remaining, parsed) = parse_block_recipe(state, OutsideLoop)
		match parsed:
			ParsedBlock(block):
				(remaining, Recognized(BlockBodyRecipe(block)))
			UnsupportedBlock(stop):
				(remaining, Declined(stop))
	else if not state.is_on_line(colon_line):
		(state, Declined(state.stop_at(BodyNotOnHeaderLine)))
	else:
		(remaining, value) = parse_plain_value(state)
		(remaining, value.mapped(pure func(expression): ExpressionBodyRecipe(expression)))


-- Blocks.
private pure func parse_block_recipe(state: ParseState, context: BodyContext) -> (ParseState, BlockParse):
	opened: ParseState = state.skip_newlines()
	if state.current_kind() != NewlineToken or opened.current_kind() != IndentToken:
		(state, UnsupportedBlock(state.stop_at(BlockWithoutIndent)))
	else:
		var out: ParseState = opened.advanced().skip_newlines()
		var statements: List[StatementRecipe] = []
		var declined: Option[StopPoint] = None
		while declined.is_none() and out.current_kind() != DedentToken and out.current_kind() != EndOfFileToken:
			(remaining, parsed) = parse_statement_recipe(out, context)
			match parsed:
				ParsedStatement(statement):
					statements = statements.append(statement)
					out = remaining.skip_newlines()
				UnsupportedStatement(stop):
					declined = Some(stop)
		match declined:
			Some(stop):
				(state, UnsupportedBlock(stop))
			None:
				match statements:
					[first, ...rest]:
						if out.current_kind() == DedentToken:
							(out.advanced(), ParsedBlock({ statements = { first = first, rest = rest } }))
						else:
							(state, UnsupportedBlock(out.stop_at(BlockNotClosed)))
					_:
						(state, UnsupportedBlock(out.stop_at(BlockNotClosed)))


private pure func mint_block(state: ParseState, recipe: BlockRecipe) -> (ParseState, Block):
	(after_first, first) = mint_statement(state, recipe.statements.first)
	var out: ParseState = after_first
	var leading: List[Statement] = []
	var last: Statement = first
	for item in recipe.statements.rest:
		(after_item, statement) = mint_statement(out, item)
		out = after_item
		leading = leading.append(last)
		last = statement
	out.finished_block(leading, last, recipe.statements.first.span.span_covering(last.span))


-- Statements.
private pure func parse_statement_recipe(state: ParseState, context: BodyContext) -> (ParseState, StatementParse):
	match state.current_kind():
		VarKeyword:
			state.parse_variable_statement()
		WhileKeyword:
			state.parse_while_statement()
		ForKeyword:
			state.parse_for_statement()
		IfKeyword:
			state.parse_conditional_statement(context)
		MatchKeyword:
			state.parse_match_statement(context)
		SelectKeyword | WithKeyword | ConcurrentKeyword | DebugKeyword:
			-- The soft keyword is a block only with the shape of one; any other use is a name.
			if state.opens_block_form():
				state.parse_block_form_statement(context)
			else:
				state.parse_expression_statement()
		BreakKeyword | ContinueKeyword:
			state.parse_loop_exit(context)
		FuncKeyword | PureKeyword:
			-- `func name(...)` or `pure func name(...)`: a local function, not a lambda.
			if (state.current_kind() == PureKeyword and state.peek_kind(1) == FuncKeyword and state.peek_kind(2) == IdentifierToken) or (state.current_kind() == FuncKeyword and state.peek_kind(1) == IdentifierToken):
				state.parse_local_function()
			else:
				state.parse_expression_statement()
		IdentifierToken:
			match state.peek_kind(1):
				EqualSymbol:
					state.parse_name_assignment()
				PlusEqualSymbol | MinusEqualSymbol | StarEqualSymbol | SlashEqualSymbol:
					state.parse_compound_assignment()
				QuestionEqualsSymbol:
					state.parse_question_binding(context)
				ColonSymbol:
					state.parse_typed_binding(context)
				_:
					state.parse_expression_statement()
		UnderscoreSymbol:
			if state.peek_kind(1) == EqualSymbol:
				state.parse_discard_assignment()
			else:
				state.parse_expression_statement()
		_:
			state.parse_expression_statement()


-- A statement's `value` after its operator: an expression that starts on the
-- operator's line and ends the statement, or an `if` or `match` that does.
-- Its blocks read `break` and `continue` as outside any loop, so a loop exit
-- inside one defers.
private pure func parse_value(state: ParseState) -> (ParseState, Recognition[ValueRecipe]):
	match state.current_kind():
		IfKeyword:
			(remaining, chain) = parse_conditional_recipe(state, OutsideLoop)
			(remaining, chain.mapped(pure func(written): ConditionalValue(written)))
		MatchKeyword:
			(remaining, written) = parse_match_recipe(state, OutsideLoop)
			(remaining, written.mapped(pure func(recipe): MatchValue(recipe)))
		SelectKeyword:
			if state.opens_block_form():
				(remaining, written) = parse_select_recipe(state, OutsideLoop)
				(remaining, written.mapped(pure func(recipe): SelectValue(recipe)))
			else:
				(remaining, plain) = parse_plain_value(state)
				(remaining, plain.mapped(pure func(recipe): PlainValue(recipe)))
		_:
			(remaining, plain) = parse_plain_value(state)
			(remaining, plain.mapped(pure func(recipe): PlainValue(recipe)))


private pure func parse_plain_value(state: ParseState) -> (ParseState, Recognition[ExpressionRecipe]):
	(remaining, parsed) = parse_expression_recipe(state)
	match parsed:
		ParsedRecipe(value):
			-- A lambda with a block body ends at its block's dedent, where the
			-- next statement may already start.
			match remaining.statement_boundary():
				AtBoundary:
					(remaining, Recognized(value))
				PastBoundary(stop):
					if is_block_lambda(value) and remaining.block_statement_ends():
						(remaining, Recognized(value))
					else:
						(state, Declined(stop))
		UnsupportedRecipe(stop):
			(state, Declined(stop))
		RejectedRecipe:
			(state, Declined(remaining.stop_at(ExpressionSyntaxError)))


private pure func parse_value_after(state: ParseState, operator_line: Int) -> (ParseState, Recognition[ValueRecipe]):
	if state.is_on_line(operator_line):
		parse_value(state)
	else:
		(state, Declined(state.stop_at(ValueOnNextLine)))


private pure func value_span(value: ValueRecipe) -> Span:
	match value:
		PlainValue(expression): expression.span
		ConditionalValue(chain): conditional_span(chain)
		MatchValue(written): match_span(written)
		SelectValue(written): select_span(written)


-- A statement of `kind` over `start` and its value, or unsupported.
private pure func valued_statement(
	state: ParseState, start: Span, value: Recognition[ValueRecipe], kind: pure (ValueRecipe) -> StatementRecipeKind,
) -> (ParseState, StatementParse):
	match value:
		Recognized(recipe):
			(state, ParsedStatement({ span = start.span_covering(value_span(recipe)), kind = kind(recipe) }))
		Declined(stop):
			(state, UnsupportedStatement(stop))


private pure func parse_expression_statement(state: ParseState) -> (ParseState, StatementParse):
	(remaining, parsed) = parse_expression_recipe(state)
	match parsed:
		ParsedRecipe(target):
			if remaining.current_kind() == EqualSymbol:
				match subscript_parts(target):
					Some((collection, indices)):
						(after_value, value) = parse_value_after(remaining.advanced(), remaining.span_start_line(remaining.current_span()))
						place: SubscriptPlaceRecipe = { span = target.span, collection = collection, indices = indices }
						after_value.valued_statement(target.span, value, pure func(recipe): SubscriptAssignmentRecipe(place, recipe))
					None:
						(state, UnsupportedStatement(remaining.stop_at(unassignable_target_reason(target))))
			else:
				match remaining.statement_boundary():
					AtBoundary:
						(remaining, ParsedStatement({ span = target.span, kind = ExpressionStatementRecipe(target) }))
					PastBoundary(stop):
						(state, UnsupportedStatement(stop))
		UnsupportedRecipe(stop):
			(state, UnsupportedStatement(stop))
		RejectedRecipe:
			(state, UnsupportedStatement(remaining.stop_at(ExpressionSyntaxError)))


-- Why `target = value` is not an assignment this slice reads. A name and a
-- subscript target have statement forms of their own that the dispatcher
-- chooses first, so they do not reach here.
private pure func unassignable_target_reason(target: ExpressionRecipe) -> StopReason:
	match target.kind:
		TupleRecipe(_): TupleDestructuring
		FieldRecipe(_, _): FieldAssignment
		NameRecipe(_) | SubscriptRecipe(_, _): AssignmentTargetRoutedElsewhere
		IntegerRecipe(_) | FloatRecipe(_) | StringRecipe(_, _) | InterpolatedRecipe(_, _) | CharacterRecipe(_) | BooleanRecipe(_) | VoidRecipe: NonPlaceAssignmentTarget
		UnaryRecipe(_, _) | DetachRecipe(_) | BinaryRecipe(_, _, _) | GroupingRecipe(_) | CallRecipe(_, _) | ListRecipe(_) | VectorRecipe(_): NonPlaceAssignmentTarget
		RecordRecipe(_) | UpdateRecipe(_, _) | DictRecipe(_) | LambdaAtomRecipe(_): NonPlaceAssignmentTarget


private pure func parse_loop_exit(state: ParseState, context: BodyContext) -> (ParseState, StatementParse):
	remaining: ParseState = state.advanced()
	if context != InsideLoop:
		(state, UnsupportedStatement(state.stop_at(LoopExitOutsideLoop)))
	else:
		match remaining.statement_boundary():
			PastBoundary(stop):
				(state, UnsupportedStatement(stop))
			AtBoundary:
				exit: LoopExit = if state.current_kind() == BreakKeyword:
					ExitWithBreak
				else:
					ExitWithContinue
				(remaining, ParsedStatement({ span = state.current_span(), kind = LoopExitRecipe(exit) }))


-- `name = value`.
private pure func parse_name_assignment(state: ParseState) -> (ParseState, StatementParse):
	(named, name) = state.consume_referenced_name(NameInStatementName)
	(after_value, value) = parse_value_after(named.advanced(), named.span_start_line(named.current_span()))
	after_value.valued_statement(name.span, value, pure func(recipe): AssignmentRecipe(NamedTargetRecipe(name), recipe))


-- `_ = value`.
private pure func parse_discard_assignment(state: ParseState) -> (ParseState, StatementParse):
	target: Span = state.current_span()
	equal: ParseState = state.advanced()
	(after_value, value) = parse_value_after(equal.advanced(), equal.span_start_line(equal.current_span()))
	after_value.valued_statement(target, value, pure func(recipe): AssignmentRecipe(DiscardedTargetRecipe(target), recipe))


private pure func parse_compound_assignment(state: ParseState) -> (ParseState, StatementParse):
	(named, name) = state.consume_referenced_name(NameInStatementName)
	operator: CompoundOperator = match named.current_kind():
		PlusEqualSymbol: AddAssign
		MinusEqualSymbol: SubtractAssign
		StarEqualSymbol: MultiplyAssign
		_: DivideAssign
	(after_value, value) = parse_value_after(named.advanced(), named.span_start_line(named.current_span()))
	after_value.valued_statement(name.span, value, pure func(recipe): CompoundAssignmentRecipe(name, operator, recipe))


-- `x: T = value` or `x: T ?= value`. The colon is a type annotation only when
-- an `=` or `?=` follows the type; anything else is left to the frozen
-- grammar's diagnostics.
private pure func parse_typed_binding(state: ParseState, context: BodyContext) -> (ParseState, StatementParse):
	(named, name) = state.consume_referenced_name(NameInStatementName)
	(after_type, written) = named.advanced().recognize_type()
	match written:
		Recognized(declared):
			if after_type.current_kind() == EqualSymbol:
				(after_value, value) = parse_value_after(after_type.advanced(), after_type.span_start_line(after_type.current_span()))
				after_value.valued_statement(name.span, value, pure func(recipe): TypedBindingRecipe(name, declared, recipe))
			else if after_type.current_kind() == QuestionEqualsSymbol:
				match context:
					OutsideLoop:
						(after_value, value) = parse_value_after(after_type.advanced(), after_type.span_start_line(after_type.current_span()))
						after_value.valued_statement(name.span, value, pure func(recipe): QuestionBindingRecipe(name, Some(declared), recipe))
					InsideLoop:
						(state, UnsupportedStatement(after_type.stop_at(QuestionBindingInLoop)))
			else:
				(state, UnsupportedStatement(after_type.stop_at(MalformedTypedBinding)))
		Declined(stop):
			(state, UnsupportedStatement(stop))


-- `x ?= value`. Inside a loop it would return from the function on every
-- iteration, which the frozen grammar reports, so a loop body leaves it
-- unsupported.
private pure func parse_question_binding(state: ParseState, context: BodyContext) -> (ParseState, StatementParse):
	(named, name) = state.consume_referenced_name(NameInStatementName)
	if context == InsideLoop:
		(state, UnsupportedStatement(named.stop_at(QuestionBindingInLoop)))
	else:
		(after_value, value) = parse_value_after(named.advanced(), named.span_start_line(named.current_span()))
		after_value.valued_statement(name.span, value, pure func(recipe): QuestionBindingRecipe(name, None, recipe))


-- `var x [: T] = value`.
private pure func parse_variable_statement(state: ParseState) -> (ParseState, StatementParse):
	keyword: Span = state.current_span()
	if state.peek_kind(1) != IdentifierToken:
		(state, UnsupportedStatement(state.advanced().stop_at(VarWithoutName)))
	else:
		(named, name) = state.advanced().consume_referenced_name(NameInVariableName)
		(after_annotation, annotation) = named.parse_type_annotation()
		match annotation:
			InvalidAnnotation(stop):
				(state, UnsupportedStatement(stop))
			_:
				if after_annotation.current_kind() != EqualSymbol:
					(state, UnsupportedStatement(after_annotation.stop_at(VarWithoutInitializer)))
				else:
					(after_value, value) = parse_value_after(after_annotation.advanced(), after_annotation.span_start_line(after_annotation.current_span()))
					declared: Option[TypeRecipe] = match annotation:
						Annotated(recipe): Some(recipe)
						_: None
					after_value.valued_statement(keyword, value, pure func(recipe): VariableRecipe(name, declared, recipe))


private union TypeAnnotationParse:
	NoAnnotation
	Annotated(TypeRecipe)
	InvalidAnnotation(StopPoint)


-- An optional `: T`.
private pure func parse_type_annotation(state: ParseState) -> (ParseState, TypeAnnotationParse):
	if state.current_kind() != ColonSymbol:
		(state, NoAnnotation)
	else:
		(remaining, written) = state.advanced().recognize_type()
		match written:
			Recognized(recipe):
				(remaining, Annotated(recipe))
			Declined(stop):
				(state, InvalidAnnotation(stop))


-- A type is valid here when it parses without a diagnostic. Its ids are
-- discarded; minting parses it again.
private pure func recognize_type(state: ParseState) -> (ParseState, Recognition[TypeRecipe]):
	(remaining, _) = parse_type(state)
	if remaining.diagnostic_count() != state.diagnostic_count():
		(state, Declined(state.stop_at(InvalidType)))
	else:
		(state.resumed_after(remaining), Recognized({ token = state.position() }))


private pure func recognize_pattern(state: ParseState) -> (ParseState, Recognition[PatternRecipe]):
	(remaining, _) = parse_pattern(state)
	if remaining.diagnostic_count() != state.diagnostic_count():
		(state, Declined(state.stop_at(InvalidPattern)))
	else:
		(state.resumed_after(remaining), Recognized({ token = state.position() }))


-- `condition:` after a block keyword: an expression and a colon on its line.
-- `concurrently` after a `for` iterable is the one word that stands where the
-- colon should.
private pure func parse_header(state: ParseState) -> (ParseState, Recognition[ExpressionRecipe]):
	line: Int = state.span_start_line(state.current_span())
	(remaining, parsed) = parse_expression_recipe(state)
	match parsed:
		ParsedRecipe(condition):
			if remaining.current_kind() == ColonSymbol and remaining.is_on_line(line):
				(remaining.advanced(), Recognized(condition))
			else if remaining.current_kind() == ConcurrentlyKeyword:
				(state, Declined(remaining.stop_at(ConcurrentlyLoop)))
			else:
				(state, Declined(remaining.stop_at(HeaderWithoutColon)))
		UnsupportedRecipe(stop):
			(state, Declined(stop))
		RejectedRecipe:
			(state, Declined(remaining.stop_at(ExpressionSyntaxError)))


private pure func parse_while_statement(state: ParseState) -> (ParseState, StatementParse):
	keyword: Span = state.current_span()
	(after_header, condition) = parse_header(state.advanced())
	match condition:
		Recognized(recipe):
			(after_block, block) = parse_block_recipe(after_header, InsideLoop)
			match block:
				ParsedBlock(body):
					(after_block, ParsedStatement({ span = keyword.span_covering(block_span(body)), kind = WhileRecipe(recipe, body) }))
				UnsupportedBlock(stop):
					(state, UnsupportedStatement(stop))
		Declined(stop):
			(state, UnsupportedStatement(stop))


-- `for name in iterable:` or `for (a, b) in iterable:`. `concurrently` is
-- unsupported.
private pure func parse_for_statement(state: ParseState) -> (ParseState, StatementParse):
	keyword: Span = state.current_span()
	(after_binder, binding) = parse_loop_binding(state.advanced())
	match binding:
		Recognized(loop_binding):
			if after_binder.current_kind() != InKeyword:
				(state, UnsupportedStatement(after_binder.stop_at(ForWithoutIn)))
			else:
				(after_header, iterable) = parse_header(after_binder.advanced())
				match iterable:
					Recognized(recipe):
						(after_block, block) = parse_block_recipe(after_header, InsideLoop)
						match block:
							ParsedBlock(body):
								(after_block, ParsedStatement({ span = keyword.span_covering(block_span(body)), kind = ForRecipe(loop_binding, recipe, body) }))
							UnsupportedBlock(stop):
								(state, UnsupportedStatement(stop))
					Declined(stop):
						(state, UnsupportedStatement(stop))
		Declined(stop):
			(state, UnsupportedStatement(stop))


private pure func parse_loop_binding(state: ParseState) -> (ParseState, Recognition[LoopBindingRecipe]):
	if state.current_kind() == LeftParenSymbol:
		parse_tuple_binding(state)
	else:
		(after_binder, binder) = parse_binder_recipe(state)
		(after_binder, binder.mapped(pure func(single): LoopVariableRecipe(single)))


-- A name or `_`.
private pure func parse_binder_recipe(state: ParseState) -> (ParseState, Recognition[BinderRecipe]):
	match state.current_kind():
		IdentifierToken:
			(named, name) = state.consume_referenced_name(NameInStatementName)
			(named, Recognized(BindsNameRecipe(name)))
		UnderscoreSymbol:
			(state.advanced(), Recognized(DiscardsRecipe(state.current_span())))
		_:
			(state, Declined(state.stop_at(InvalidLoopBinding)))


-- `(a, _, c)`: two to four binders, a trailing comma allowed. Its span runs
-- from the opening to the closing parenthesis.
private pure func parse_tuple_binding(state: ParseState) -> (ParseState, Recognition[LoopBindingRecipe]):
	opening: Span = state.current_span()
	var out: ParseState = state.advanced()
	var binders: List[BinderRecipe] = []
	var reading: Bool = True
	var valid: Bool = True
	while reading and valid:
		(after_binder, binder) = parse_binder_recipe(out)
		match binder:
			Recognized(written):
				binders = binders.append(written)
				out = after_binder
				if out.current_kind() == CommaSymbol:
					out = out.advanced()
					reading = out.current_kind() != RightParenSymbol
				else:
					reading = False
			Declined(_):
				valid = False
	if not valid or out.current_kind() != RightParenSymbol:
		(state, Declined(out.stop_at(InvalidLoopBinding)))
	else:
		closing: Span = out.current_span()
		match binders:
			[first, second]:
				(out.advanced(), Recognized(LoopTupleRecipe(Pair(first, second), opening.span_covering(closing))))
			[first, second, third]:
				(out.advanced(), Recognized(LoopTupleRecipe(Triple(first, second, third), opening.span_covering(closing))))
			[first, second, third, fourth]:
				(out.advanced(), Recognized(LoopTupleRecipe(Quadruple(first, second, third, fourth), opening.span_covering(closing))))
			_:
				(state, Declined(out.stop_at(InvalidLoopBinding)))


private pure func block_span(recipe: BlockRecipe) -> Span:
	var last: StatementRecipe = recipe.statements.first
	for statement in recipe.statements.rest:
		last = statement
	recipe.statements.first.span.span_covering(last.span)


-- The chain is read by a loop: each `else if` appends a link.
private pure func parse_conditional_statement(state: ParseState, context: BodyContext) -> (ParseState, StatementParse):
	(remaining, chain) = parse_conditional_recipe(state, context)
	match chain:
		Recognized(written):
			(remaining, ParsedStatement({ span = conditional_span(written), kind = ConditionalStatementRecipe(written) }))
		Declined(stop):
			(state, UnsupportedStatement(stop))


private pure func conditional_span(chain: ConditionalRecipe) -> Span:
	chain.head.keyword.span_covering(conditional_end(chain))


private pure func parse_conditional_recipe(state: ParseState, context: BodyContext) -> (ParseState, Recognition[ConditionalRecipe]):
	(after_head, head) = parse_if_link(state, context)
	match head:
		Declined(stop):
			(state, Declined(stop))
		Recognized(first):
			var out: ParseState = after_head
			var else_ifs: List[ElseIfLink] = []
			var final_else: Option[ElseBlockRecipe] = None
			var declined: Option[StopPoint] = None
			var reading: Bool = out.current_kind() == ElseKeyword
			while reading and declined.is_none():
				else_keyword: Span = out.current_span()
				after_else: ParseState = out.advanced()
				if after_else.current_kind() == IfKeyword:
					(after_link, link) = parse_if_link(after_else, context)
					match link:
						Recognized(parsed):
							else_ifs = else_ifs.append({ else_keyword = else_keyword, link = parsed })
							out = after_link
							reading = out.current_kind() == ElseKeyword
						Declined(stop):
							declined = Some(stop)
				else if after_else.current_kind() == ColonSymbol:
					(after_block, block) = parse_block_recipe(after_else.advanced(), context)
					match block:
						ParsedBlock(recipe):
							final_else = Some({ keyword = else_keyword, block = recipe })
							out = after_block
							reading = False
						UnsupportedBlock(stop):
							declined = Some(stop)
				else:
					declined = Some(after_else.stop_at(MalformedElse))
			match declined:
				Some(stop):
					(state, Declined(stop))
				None:
					if not out.block_statement_ends():
						(state, Declined(out.stop_at(OperatorAfterBlock)))
					else:
						(out, Recognized({ head = first, else_ifs = else_ifs, final_else = final_else }))


-- `if condition:` and its block, for the head and for every `else if`.
private pure func parse_if_link(state: ParseState, context: BodyContext) -> (ParseState, Recognition[IfLink]):
	keyword: Span = state.current_span()
	(after_header, condition) = parse_header(state.advanced())
	match condition:
		Recognized(recipe):
			(after_block, block) = parse_block_recipe(after_header, context)
			match block:
				ParsedBlock(then_block):
					(after_block, Recognized({ keyword = keyword, condition = recipe, then_block = then_block }))
				UnsupportedBlock(stop):
					(state, Declined(stop))
		Declined(stop):
			(state, Declined(stop))


-- Where the whole `if` ends: the last block it holds.
private pure func conditional_end(chain: ConditionalRecipe) -> Span:
	match chain.final_else:
		Some(written):
			block_span(written.block)
		None:
			match chain.else_ifs.last():
				Some(link):
					block_span(link.link.then_block)
				None:
					block_span(chain.head.then_block)


-- `match scrutinee:` and its cases, each a block or one same-line statement.
private pure func parse_match_statement(state: ParseState, context: BodyContext) -> (ParseState, StatementParse):
	(remaining, written) = parse_match_recipe(state, context)
	match written:
		Recognized(recipe):
			(remaining, ParsedStatement({ span = match_span(recipe), kind = MatchStatementRecipe(recipe) }))
		Declined(stop):
			(state, UnsupportedStatement(stop))


private pure func match_span(recipe: MatchRecipe) -> Span:
	recipe.keyword.span_covering(recipe.end)


private pure func parse_match_recipe(state: ParseState, context: BodyContext) -> (ParseState, Recognition[MatchRecipe]):
	keyword: Span = state.current_span()
	(after_header, scrutinee) = parse_header(state.advanced())
	opened: ParseState = after_header.skip_newlines()
	match scrutinee:
		Declined(stop):
			(state, Declined(stop))
		Recognized(subject):
			if after_header.current_kind() != NewlineToken or opened.current_kind() != IndentToken:
				(state, Declined(after_header.stop_at(MatchWithoutBlock)))
			else:
				var out: ParseState = opened.advanced().skip_newlines()
				var cases: List[CaseRecipe] = []
				var declined: Option[StopPoint] = None
				while declined.is_none() and out.current_kind() != DedentToken and out.current_kind() != EndOfFileToken:
					(after_case, parsed) = parse_case_recipe(out, context)
					match parsed:
						Recognized(case_recipe):
							cases = cases.append(case_recipe)
							out = after_case.skip_newlines()
						Declined(stop):
							declined = Some(stop)
				match declined:
					Some(stop):
						(state, Declined(stop))
					None:
						match cases:
							[first, ...rest]:
								if out.current_kind() != DedentToken:
									(state, Declined(out.stop_at(MatchNotClosed)))
								else if not out.advanced().block_statement_ends():
									(state, Declined(out.advanced().stop_at(OperatorAfterBlock)))
								else:
									(out.advanced(), Recognized({ keyword = keyword, scrutinee = subject, cases = { first = first, rest = rest }, end = out.current_span() }))
							_:
								(state, Declined(out.stop_at(MatchNotClosed)))


private pure func parse_case_recipe(state: ParseState, context: BodyContext) -> (ParseState, Recognition[CaseRecipe]):
	(after_pattern, pattern) = recognize_pattern(state)
	match pattern:
		Declined(stop):
			(state, Declined(stop))
		Recognized(recipe):
			if after_pattern.current_kind() != ColonSymbol:
				(state, Declined(after_pattern.stop_at(CaseWithoutColon)))
			else:
				after_colon: ParseState = after_pattern.advanced()
				if after_colon.current_kind() == NewlineToken:
					(after_block, block) = parse_block_recipe(after_colon, context)
					match block:
						ParsedBlock(body):
							(after_block, Recognized({ pattern = recipe, body = CaseBlockRecipe(body) }))
						UnsupportedBlock(stop):
							(state, Declined(stop))
				else if after_colon.starts_nested_block():
					(state, Declined(after_colon.stop_at(NestedBlockInCaseLine)))
				else:
					(after_statement, statement) = parse_statement_recipe(after_colon, context)
					match statement:
						ParsedStatement(written):
							(after_statement, Recognized({ pattern = recipe, body = CaseStatementRecipe(written) }))
						UnsupportedStatement(stop):
							(state, Declined(stop))


-- A same-line case body is a simple statement. The frozen grammar anchors a
-- block-bearing one at the pattern, or at its own keyword, and compares
-- columns with that anchor, which this slice leaves unsupported.
private pure func starts_nested_block(state: ParseState) -> Bool:
	match state.current_kind():
		IfKeyword | MatchKeyword | WhileKeyword | ForKeyword:
			True
		SelectKeyword | WithKeyword | ConcurrentKeyword | DebugKeyword:
			state.opens_block_form()
		_:
			False


-- Lambdas. Recognized from the expression grammar, minted by it. The header
-- (everything through the colon) and the body are read apart: the header is
-- one line, the body is a recipe of its own.
pure func parse_lambda_recipe(state: ParseState) -> (ParseState, LambdaParse):
	(after_header, header) = parse_lambda_header(state)
	match header:
		Declined(stop):
			(state, UnsupportedLambda(stop))
		Recognized(read):
			(after_body, body) = parse_lambda_body(after_header, state.span_start_line(state.current_span()))
			match body:
				Recognized(recipe):
					(after_body, ParsedLambda({
						purity = read.purity, parameters = read.parameters, return_type = read.return_type, body = recipe,
						span = state.current_span().span_covering(body_recipe_span(recipe))
					}))
				Declined(stop):
					(state, UnsupportedLambda(stop))


-- A lambda recipe, or why it is not read. Concrete rather than `Recognition`:
-- the expression parser matches it across the import cycle with this module.
union LambdaParse:
	ParsedLambda(LambdaRecipe)
	UnsupportedLambda(StopPoint)


-- What a lambda's header holds before its body.
private record LambdaHeader {
	purity: Purity,
	parameters: List[LambdaParameterRecipe],
	return_type: Option[TypeRecipe]
}


-- `[pure] func(parameters) [-> R]:` on one line. A hole's token positions index
-- the hole's own run and parameter types replay from a recorded position, so
-- a lambda in a hole is not read.
private pure func parse_lambda_header(state: ParseState) -> (ParseState, Recognition[LambdaHeader]):
	after_pure: ParseState = if state.current_kind() == PureKeyword:
		state.advanced()
	else:
		state
	if state.inside_hole():
		(state, Declined(state.stop_at(LambdaInInterpolationHole)))
	else if after_pure.current_kind() != FuncKeyword or after_pure.peek_kind(1) != LeftParenSymbol:
		(state, Declined(state.stop_at(MalformedLambdaHeader)))
	else:
		line: Int = state.span_start_line(state.current_span())
		(after_parameters, parameters) = parse_lambda_parameters(after_pure.advanced().advanced())
		match parameters:
			Declined(stop):
				(state, Declined(stop))
			Recognized(read):
				after_close: ParseState = after_parameters.advanced()
				if after_close.current_kind() == ArrowSymbol:
					(after_type, written) = after_close.advanced().recognize_type()
					match written:
						Declined(stop):
							(state, Declined(stop))
						Recognized(declared):
							state.lambda_header_ending(line, after_parameters, after_type, read, Some(declared))
				else:
					state.lambda_header_ending(line, after_parameters, after_close, read, None)


-- The header's `)` and `:` must both be on its line.
private pure func lambda_header_ending(
	state: ParseState, line: Int, after_parameters: ParseState, after_return: ParseState,
	parameters: List[LambdaParameterRecipe], return_type: Option[TypeRecipe],
) -> (ParseState, Recognition[LambdaHeader]):
	if after_parameters.current_kind() != RightParenSymbol or not after_parameters.is_on_line(line) or after_return.current_kind() != ColonSymbol or not after_return.is_on_line(line):
		(state, Declined(after_return.stop_at(MalformedLambdaHeader)))
	else:
		purity: Purity = if state.current_kind() == PureKeyword:
			PureFunction
		else:
			ImpureFunction
		(after_return.advanced(), Recognized({ purity = purity, parameters = parameters, return_type = return_type }))


-- `name [: T]` items to the closing parenthesis, a trailing comma allowed.
private pure func parse_lambda_parameters(state: ParseState) -> (ParseState, Recognition[List[LambdaParameterRecipe]]):
	var out: ParseState = state
	var parameters: List[LambdaParameterRecipe] = []
	var reading: Bool = out.current_kind() != RightParenSymbol
	var declined: Option[StopPoint] = None
	while reading and declined.is_none():
		(after_binder, binder) = parse_binder_recipe(out)
		match binder:
			Recognized(written):
				(after_annotation, annotation) = after_binder.parse_type_annotation()
				match annotation:
					InvalidAnnotation(stop):
						declined = Some(stop)
					Annotated(declared):
						parameters = parameters.append({ binder = written, declared_type = Some(declared) })
						out = after_annotation
					NoAnnotation:
						parameters = parameters.append({ binder = written, declared_type = None })
						out = after_annotation
				if out.current_kind() == CommaSymbol:
					out = out.advanced()
					reading = out.current_kind() != RightParenSymbol
				else:
					reading = False
			Declined(stop):
				declined = Some(stop)
	match declined:
		Some(stop):
			(state, Declined(stop))
		None:
			(out, Recognized(parameters))


-- A block on the lines after the colon, or an expression on its line. An
-- expression body ends where the expression does: the enclosing construct
-- decides what may follow.
private pure func parse_lambda_body(state: ParseState, line: Int) -> (ParseState, Recognition[BodyRecipe]):
	if state.current_kind() == NewlineToken:
		(remaining, parsed) = parse_block_recipe(state, OutsideLoop)
		match parsed:
			ParsedBlock(block):
				(remaining, Recognized(BlockBodyRecipe(block)))
			UnsupportedBlock(stop):
				(state, Declined(stop))
	else if not state.is_on_line(line):
		(state, Declined(state.stop_at(BodyNotOnHeaderLine)))
	else:
		(remaining, parsed) = parse_expression_recipe(state)
		match parsed:
			ParsedRecipe(value):
				(remaining, Recognized(ExpressionBodyRecipe(value)))
			UnsupportedRecipe(stop):
				(state, Declined(stop))
			RejectedRecipe:
				(state, Declined(remaining.stop_at(ExpressionSyntaxError)))


pure func mint_lambda_recipe(state: ParseState, recipe: LambdaRecipe) -> (ParseState, Expression):
	var out: ParseState = state
	var parameters: List[LambdaParameter] = []
	for parameter in recipe.parameters:
		(after_target, target) = mint_binder_target(out, parameter.binder)
		(after_type, declared) = mint_optional_type(after_target, parameter.declared_type)
		name_span: Span = match parameter.binder:
			BindsNameRecipe(name): name.span
			DiscardsRecipe(discarded): discarded
		span: Span = match declared:
			Some(written): name_span.span_covering(written.span)
			None: name_span
		out = after_type
		parameters = parameters.append({ target = target, declared_type = declared, span = span })
	(after_return, return_type) = mint_optional_type(out, recipe.return_type)
	(after_body, completed) = mint_body_recipe(after_return, recipe.body)
	after_body.finished_expression(recipe.span, Lambda({ purity = recipe.purity, parameters = parameters, return_type = return_type, body = completed.body }))


-- Local functions: `func name(...)` or `pure func name(...)` as a statement.
-- The header is parsed to learn where it ends and that it is clean, its ids
-- discarded; minting parses it again from its keyword.
private pure func parse_local_function(state: ParseState) -> (ParseState, StatementParse):
	start: Span = state.current_span()
	purity: Purity = if state.current_kind() == PureKeyword:
		PureFunction
	else:
		ImpureFunction
	at_keyword: ParseState = if purity == PureFunction:
		state.advanced()
	else:
		state
	(after_header, parsed) = parse_function_header(at_keyword, PublicVisibility, None, [], purity, start)
	match parsed:
		RejectedFunctionHeader:
			(state, UnsupportedStatement(state.stop_at(LocalFunctionHeaderRejected)))
		ParsedFunctionHeader(preview):
			match preview.body_extent:
				SkippedBody(skipped):
					(after_body, body) = recognize_skipped_body(state.resumed_after(after_header), skipped)
					match body:
						Recognized(recipe):
							local: LocalFunctionBody = { keyword_token = at_keyword.position(), start = start, purity = purity, body = recipe }
							(after_body, ParsedStatement({ span = start.span_covering(body_recipe_span(recipe)), kind = LocalFunctionRecipe(local) }))
						Declined(stop):
							(state, UnsupportedStatement(stop))
				_:
					(state, UnsupportedStatement(state.stop_at(BodylessFunction)))


-- Minting. Every id is issued here, in source order.
-- Blocks nest by indentation, so the functions between a statement and the
-- statements of its blocks are on the native stack once per level. Each kind
-- is minted by a function of its own and this dispatcher stays thin, which
-- keeps the 1,000-deep proof of section 3.14 inside the Linux stack.
private pure func mint_statement(state: ParseState, recipe: StatementRecipe) -> (ParseState, Statement):
	match recipe.kind:
		ExpressionStatementRecipe(value):
			(remaining, expression) = mint_recipe(state, value)
			remaining.finished_statement(recipe.span, ExpressionStatement(expression))
		LoopExitRecipe(exit):
			kind: ExpressionKind = match exit:
				ExitWithBreak: Break
				ExitWithContinue: Continue
			(remaining, expression) = state.finished_expression(recipe.span, kind)
			remaining.finished_statement(recipe.span, ExpressionStatement(expression))
		ConditionalStatementRecipe(chain):
			(remaining, expression) = mint_conditional(state, chain, recipe.span)
			remaining.finished_statement(recipe.span, ExpressionStatement(expression))
		MatchStatementRecipe(written):
			(remaining, expression) = mint_match(state, written, recipe.span)
			remaining.finished_statement(recipe.span, ExpressionStatement(expression))
		SelectStatementRecipe(written):
			mint_select_statement(state, recipe.span, written)
		WithStatementRecipe(written):
			mint_with_statement(state, recipe.span, written)
		ConcurrentStatementRecipe(written):
			mint_concurrent_statement(state, recipe.span, written)
		DebugStatementRecipe(written):
			mint_debug_statement(state, recipe.span, written)
		VariableRecipe(name, declared, value):
			mint_variable(state, recipe.span, name, declared, value)
		TypedBindingRecipe(name, declared, value):
			mint_typed_binding(state, recipe.span, name, declared, value)
		QuestionBindingRecipe(name, declared, value):
			mint_question_binding(state, recipe.span, name, declared, value)
		AssignmentRecipe(target, value):
			mint_assignment(state, recipe.span, target, value)
		CompoundAssignmentRecipe(name, operator, value):
			(after_use, use) = state.finished_name_use(name)
			(after_value, expression) = mint_value(after_use, value)
			after_value.finished_statement(recipe.span, CompoundAssignment({ target = use, operator = operator, value = expression }))
		SubscriptAssignmentRecipe(place, value):
			mint_subscript_assignment(state, recipe.span, place, value)
		WhileRecipe(condition, body):
			(after_condition, expression) = mint_recipe(state, condition)
			(after_body, block) = mint_block(after_condition, body)
			after_body.finished_statement(recipe.span, WhileLoop({ condition = expression, body = block }))
		LocalFunctionRecipe(local):
			(after_header, parsed) = parse_function_header(state.resumed_at(local.keyword_token), PublicVisibility, None, [], local.purity, local.start)
			match parsed:
				ParsedFunctionHeader(preview):
					(after_body, completed) = mint_body_recipe(after_header, local.body)
					header = preview.header
					(declared, function) = after_body.finished_local_function(
						{ signature = header.signature, type_parameters = header.type_parameters, constraints = header.constraints, body = Some(completed.body) },
						header.header_span.span_covering(completed.span)
					)
					declared.finished_statement(recipe.span, LocalFunctionStatement(function))
				RejectedFunctionHeader:
					-- The dry run over the same tokens was clean, so the replay is too.
					-- If it is not, its diagnostics make the owner unread (`complete_body`
					-- compares them), so this void statement is a recovery placeholder
					-- that never leaves the parser (section 3.17).
					report_unreachable_input("a local function header that parsed cleanly is rejected when replayed")
					(placeholder, value) = after_header.finished_expression(recipe.span, VoidValue)
					placeholder.finished_statement(recipe.span, ExpressionStatement(value))
		ForRecipe(binding, iterable, body):
			mint_for_loop(state, recipe.span, binding, iterable, body)


private pure func mint_variable(
	state: ParseState, span: Span, name: WrittenName, declared: Option[TypeRecipe], value: ValueRecipe,
) -> (ParseState, Statement):
	(after_binder, binder) = state.finished_binder(name)
	(after_type, declared_type) = mint_optional_type(after_binder, declared)
	(after_value, expression) = mint_value(after_type, value)
	after_value.finished_statement(span, VariableDeclaration({ target = BindsName(binder), declared_type = declared_type, value = expression }))


private pure func mint_typed_binding(
	state: ParseState, span: Span, name: WrittenName, declared: TypeRecipe, value: ValueRecipe,
) -> (ParseState, Statement):
	(after_binder, binder) = state.finished_binder(name)
	(after_type, declared_type) = mint_type(after_binder, declared)
	(after_value, expression) = mint_value(after_type, value)
	after_value.finished_statement(span, TypedBinding({ target = BindsName(binder), declared_type = declared_type, value = expression }))


private pure func mint_assignment(
	state: ParseState, span: Span, target: AssignmentTargetRecipe, value: ValueRecipe,
) -> (ParseState, Statement):
	(after_target, written) = match target:
		NamedTargetRecipe(name):
			(after_use, use) = state.finished_name_use(name)
			(after_use, AssignsName(use))
		DiscardedTargetRecipe(discarded):
			(state, AssignsDiscard(discarded))
	(after_value, expression) = mint_value(after_target, value)
	after_value.finished_statement(span, Assignment({ target = written, value = expression }))


private pure func mint_subscript_assignment(
	state: ParseState, span: Span, place: SubscriptPlaceRecipe, value: ValueRecipe,
) -> (ParseState, Statement):
	(after_collection, collection) = mint_recipe(state, place.collection)
	(after_first, first) = mint_recipe(after_collection, place.indices.first)
	var out: ParseState = after_first
	var rest: List[Expression] = []
	for index in place.indices.rest:
		(after_index, written) = mint_recipe(out, index)
		out = after_index
		rest = rest.append(written)
	(after_place, minted_place) = out.finished_subscript_place(place.span, collection, { first = first, rest = rest })
	(after_value, expression) = mint_value(after_place, value)
	after_value.finished_statement(span, SubscriptAssignment({ place = minted_place, value = expression }))


private pure func mint_question_binding(
	state: ParseState, span: Span, name: WrittenName, declared: Option[TypeRecipe], value: ValueRecipe,
) -> (ParseState, Statement):
	(after_binder, binder) = state.finished_binder(name)
	(after_type, declared_type) = mint_optional_type(after_binder, declared)
	(after_value, expression) = mint_value(after_type, value)
	after_value.finished_statement(span, QuestionBinding({ binder = binder, declared_type = declared_type, value = expression }))


private pure func mint_for_loop(
	state: ParseState, span: Span, binding: LoopBindingRecipe, iterable: ExpressionRecipe, body: BlockRecipe,
) -> (ParseState, Statement):
	(after_binder, loop_binder) = mint_loop_binder(state, binding)
	(after_iterable, expression) = mint_recipe(after_binder, iterable)
	(after_body, block) = mint_block(after_iterable, body)
	after_body.finished_statement(span, ForLoop({ binder = loop_binder, iterable = expression, body = block }))


private pure func mint_value(state: ParseState, value: ValueRecipe) -> (ParseState, Expression):
	match value:
		PlainValue(expression): mint_recipe(state, expression)
		ConditionalValue(chain): mint_conditional(state, chain, conditional_span(chain))
		MatchValue(written): mint_match(state, written, match_span(written))
		SelectValue(written): mint_select(state, written, select_span(written))


private pure func mint_loop_binder(state: ParseState, binding: LoopBindingRecipe) -> (ParseState, LoopBinder):
	match binding:
		LoopVariableRecipe(single):
			(after_single, target) = mint_binder_target(state, single)
			(after_single, LoopVariable(target))
		LoopTupleRecipe(Pair(first, second), span):
			(after_first, first_target) = mint_binder_target(state, first)
			(after_second, second_target) = mint_binder_target(after_first, second)
			(after_second, LoopTuple(Pair(first_target, second_target), span))
		LoopTupleRecipe(Triple(first, second, third), span):
			(after_first, first_target) = mint_binder_target(state, first)
			(after_second, second_target) = mint_binder_target(after_first, second)
			(after_third, third_target) = mint_binder_target(after_second, third)
			(after_third, LoopTuple(Triple(first_target, second_target, third_target), span))
		LoopTupleRecipe(Quadruple(first, second, third, fourth), span):
			(after_first, first_target) = mint_binder_target(state, first)
			(after_second, second_target) = mint_binder_target(after_first, second)
			(after_third, third_target) = mint_binder_target(after_second, third)
			(after_fourth, fourth_target) = mint_binder_target(after_third, fourth)
			(after_fourth, LoopTuple(Quadruple(first_target, second_target, third_target, fourth_target), span))


private pure func mint_binder_target(state: ParseState, binder: BinderRecipe) -> (ParseState, BindingTarget):
	match binder:
		BindsNameRecipe(name):
			(after_name, minted) = state.finished_binder(name)
			(after_name, BindsName(minted))
		DiscardsRecipe(span):
			(state, DiscardsValue(span))


private pure func mint_type(state: ParseState, recipe: TypeRecipe) -> (ParseState, WrittenType):
	parse_type(state.resumed_at(recipe.token))


private pure func mint_optional_type(state: ParseState, recipe: Option[TypeRecipe]) -> (ParseState, Option[WrittenType]):
	match recipe:
		Some(written):
			(remaining, declared) = mint_type(state, written)
			(remaining, Some(declared))
		None:
			(state, None)


private pure func mint_pattern(state: ParseState, recipe: PatternRecipe) -> (ParseState, Pattern):
	parse_pattern(state.resumed_at(recipe.token))


-- A conditional frame waiting for the else-if links after it to be minted:
-- an `else if` is minted before the link that owns it.
private record PendingElseIf {
	else_keyword: Span,
	keyword: Span,
	condition: Expression,
	then_block: Block
}


-- What an `if` holds as its else branch, and where that branch ends.
private record ElseTail {
	branch: ElseBranch,
	end: Span
}


-- Source order first: every condition and block of the chain, then the
-- `else if` expressions from the innermost out, then the outermost `if`.
private pure func mint_conditional(state: ParseState, chain: ConditionalRecipe, span: Span) -> (ParseState, Expression):
	(after_condition, condition) = mint_recipe(state, chain.head.condition)
	(after_then, then_block) = mint_block(after_condition, chain.head.then_block)
	var out: ParseState = after_then
	var pending: List[PendingElseIf] = []
	for else_if in chain.else_ifs:
		(after_link_condition, link_condition) = mint_recipe(out, else_if.link.condition)
		(after_link_block, link_block) = mint_block(after_link_condition, else_if.link.then_block)
		out = after_link_block
		pending = pending.append({
			else_keyword = else_if.else_keyword, keyword = else_if.link.keyword,
			condition = link_condition, then_block = link_block
		})
	var tail: Option[ElseTail] = None
	match chain.final_else:
		Some(written):
			(after_else, else_block) = mint_block(out, written.block)
			out = after_else
			tail = Some({ branch = { keyword = written.keyword, body = ElseBlock(else_block) }, end = else_block.span })
		None:
			void
	for link in pending.reverse():
		end: Span = match tail:
			Some(written): written.end
			None: link.then_block.span
		link_span: Span = link.keyword.span_covering(end)
		(after_else_if, else_if) = out.finished_else_if(link_span, { condition = link.condition, then_block = link.then_block, else_branch = tail.map(pure func(written): written.branch) })
		out = after_else_if
		tail = Some({ branch = { keyword = link.else_keyword, body = ElseIf(else_if) }, end = link_span })
	out.finished_expression(span, If({ condition = condition, then_block = then_block, else_branch = tail.map(pure func(written): written.branch) }))


private pure func mint_match(state: ParseState, recipe: MatchRecipe, span: Span) -> (ParseState, Expression):
	(after_scrutinee, scrutinee) = mint_recipe(state, recipe.scrutinee)
	var out: ParseState = after_scrutinee
	var cases: List[MatchCase] = []
	for case_recipe in [recipe.cases.first].concat(recipe.cases.rest):
		(after_pattern, pattern) = mint_pattern(out, case_recipe.pattern)
		(after_body, body, body_span) = match case_recipe.body:
			CaseBlockRecipe(block_recipe):
				(after_block, block) = mint_block(after_pattern, block_recipe)
				(after_block, CaseBlock(block), block.span)
			CaseStatementRecipe(statement_recipe):
				(after_statement, statement) = mint_statement(after_pattern, statement_recipe)
				(after_statement, CaseStatement(statement), statement.span)
		out = after_body
		cases = cases.append({ pattern = pattern, body = body, span = pattern.span.span_covering(body_span) })
	out.finished_expression(span, Match(scrutinee, cases))


-- The statement the soft keyword at the cursor opens: it has the shape of
-- one of the four block forms. A function of its own, so that the frame of
-- the statement dispatcher, which is on the native stack once per level of
-- nesting, stays small (section 3.14).
private pure func parse_block_form_statement(state: ParseState, context: BodyContext) -> (ParseState, StatementParse):
	match state.current_kind():
		SelectKeyword:
			(remaining, written) = parse_select_recipe(state, context)
			match written:
				Recognized(recipe):
					(remaining, ParsedStatement({ span = select_span(recipe), kind = SelectStatementRecipe(recipe) }))
				Declined(stop):
					(state, UnsupportedStatement(stop))
		WithKeyword:
			(remaining, written) = parse_with_recipe(state, context)
			match written:
				Recognized(recipe):
					(remaining, ParsedStatement({ span = recipe.keyword.span_covering(block_span(recipe.body)), kind = WithStatementRecipe(recipe) }))
				Declined(stop):
					(state, UnsupportedStatement(stop))
		ConcurrentKeyword:
			(remaining, written) = parse_concurrent_recipe(state)
			match written:
				Recognized(recipe):
					(remaining, ParsedStatement({ span = recipe.keyword.span_covering(block_span(recipe.body)), kind = ConcurrentStatementRecipe(recipe) }))
				Declined(stop):
					(state, UnsupportedStatement(stop))
		DebugKeyword:
			(remaining, written) = parse_debug_recipe(state, context)
			match written:
				Recognized(recipe):
					(remaining, ParsedStatement({ span = recipe.keyword.span_covering(block_span(recipe.body)), kind = DebugStatementRecipe(recipe) }))
				Declined(stop):
					(state, UnsupportedStatement(stop))
		_:
			state.parse_expression_statement()


-- `select`, `with`, `concurrent` and `debug`. Each is a keyword, a header that
-- ends in a colon on its own line, and indented blocks closed by dedents, so
-- each ends where the next statement may already begin.

-- An arm of a `select`: what it waits for, and the block it runs.
private record SelectArmRecipe {
	kind: SelectArmRecipeKind,
	body: BlockRecipe,
	span: Span
}


private union SelectArmRecipeKind:
	ReceiveArmRecipe(BinderRecipe, ExpressionRecipe)
	SealedArmRecipe(ExpressionRecipe)
	AfterArmRecipe(ExpressionRecipe)


-- `end` is the closing dedent's span, which the expression's own span reaches
-- (the frozen parser's rule, as for `match`).
private record SelectRecipe {
	keyword: Span,
	arms: AtLeastOne[SelectArmRecipe],
	end: Span
}


-- `with r [: T] = v:` and `with r [: T] ?= v [on e => mapped]:`, before the block.
private record WithHeader {
	binder: BinderRecipe,
	declared: Option[TypeRecipe],
	acquisition: AcquisitionRecipe
}


private union AcquisitionRecipe:
	ValueAcquisitionRecipe(ExpressionRecipe)
	TryAcquisitionRecipe(ExpressionRecipe, Option[ErrorMapRecipe])


private enum WithOperator:
	AcquireWithValue
	AcquireWithTry


-- `on e => mapped`: its span starts at the binder, as the frozen parser's does.
private record ErrorMapRecipe {
	binder: BinderRecipe,
	value: ExpressionRecipe,
	span: Span
}


private record WithRecipe {
	keyword: Span,
	header: WithHeader,
	body: BlockRecipe
}


-- A `timeout` parameter keeps its value as a recipe until minting.
private record TimeoutRecipe {
	value: ExpressionRecipe,
	name_span: Span,
	span: Span
}


-- A count parameter holds only a checked literal, so it is already the syntax
-- node and mints no id.
private record ConcurrentParameters {
	max_threads: Option[CountParameter],
	timeout: Option[TimeoutRecipe]
}


private record ConcurrentRecipe {
	keyword: Span,
	parameters: ConcurrentParameters,
	body: BlockRecipe
}


private record DebugRecipe {
	keyword: Span,
	body: BlockRecipe
}


private enum ConcurrentParameterName:
	ConcurrentMaxThreads
	ConcurrentTimeout
	ConcurrentUnknown


---
The spelling of `concurrent`'s thread-count parameter. The frozen grammar
matches parameter names by text, so the recognizer does too.
---
private MAX_THREADS_PARAMETER: String = "max_threads"


---
The spelling of the parameter that bounds how long a `concurrent` block runs.
---
private TIMEOUT_PARAMETER: String = "timeout"


private pure func binder_span(binder: BinderRecipe) -> Span:
	match binder:
		BindsNameRecipe(name): name.span
		DiscardsRecipe(span): span


-- Whether the `:` that ends a header written on `line` is at the cursor.
private pure func at_header_colon(state: ParseState, line: Int) -> Bool:
	state.current_kind() == ColonSymbol and state.is_on_line(line)


-- The indented block after a header's colon.
private pure func parse_header_block(state: ParseState, context: BodyContext) -> (ParseState, Recognition[BlockRecipe]):
	(remaining, block) = parse_block_recipe(state, context)
	match block:
		ParsedBlock(recipe): (remaining, Recognized(recipe))
		UnsupportedBlock(stop): (state, Declined(stop))


-- The block that ends a `with`, `concurrent` or `debug`: the token after its
-- dedent must not continue it.
private pure func parse_closing_block(state: ParseState, context: BodyContext) -> (ParseState, Recognition[BlockRecipe]):
	(remaining, block) = parse_header_block(state, context)
	match block:
		Recognized(_):
			if remaining.block_statement_ends():
				(remaining, block)
			else:
				(state, Declined(remaining.stop_at(OperatorAfterBlock)))
		Declined(_):
			(state, block)


-- Select.
private pure func select_span(recipe: SelectRecipe) -> Span:
	recipe.keyword.span_covering(recipe.end)


-- `select:` and its arms, each a header and a block. The cursor is at a
-- `select` that opens a block form, so its colon follows.
private pure func parse_select_recipe(state: ParseState, context: BodyContext) -> (ParseState, Recognition[SelectRecipe]):
	keyword: Span = state.current_span()
	after_colon: ParseState = state.advanced().advanced()
	opened: ParseState = after_colon.skip_newlines()
	if after_colon.current_kind() != NewlineToken or opened.current_kind() != IndentToken:
		(state, Declined(after_colon.stop_at(SelectWithoutArms)))
	else:
		var out: ParseState = opened.advanced().skip_newlines()
		var arms: List[SelectArmRecipe] = []
		var declined: Option[StopPoint] = None
		while declined.is_none() and out.current_kind() != DedentToken and out.current_kind() != EndOfFileToken:
			(after_arm, parsed) = parse_select_arm_recipe(out, context)
			match parsed:
				Recognized(arm):
					arms = arms.append(arm)
					out = after_arm.skip_newlines()
				Declined(stop):
					declined = Some(stop)
		match declined:
			Some(stop):
				(state, Declined(stop))
			None:
				match arms:
					[first, ...rest]:
						if out.current_kind() != DedentToken:
							(state, Declined(out.stop_at(SelectNotClosed)))
						else if not out.advanced().block_statement_ends():
							(state, Declined(out.advanced().stop_at(OperatorAfterBlock)))
						else:
							(out.advanced(), Recognized({ keyword = keyword, arms = { first = first, rest = rest }, end = out.current_span() }))
					_:
						(state, Declined(out.stop_at(SelectNotClosed)))


private pure func parse_select_arm_recipe(state: ParseState, context: BodyContext) -> (ParseState, Recognition[SelectArmRecipe]):
	start: Span = state.current_span()
	(after_header, header) = parse_select_arm_header(state)
	match header:
		Recognized(kind):
			(after_body, body) = parse_header_block(after_header, context)
			match body:
				Recognized(block):
					(after_body, Recognized({ kind = kind, body = block, span = start.span_covering(block_span(block)) }))
				Declined(stop):
					(state, Declined(stop))
		Declined(stop):
			(state, Declined(stop))


-- `sealed channel:`, `_ after timeout:` or `name from channel:`. A binder
-- named `after` or `from` is a keyword here, which this slice leaves unsupported.
private pure func parse_select_arm_header(state: ParseState) -> (ParseState, Recognition[SelectArmRecipeKind]):
	match state.current_kind():
		SealedKeyword:
			(after_channel, channel) = parse_header(state.advanced())
			(after_channel, channel.mapped(pure func(written): SealedArmRecipe(written)))
		UnderscoreSymbol:
			if state.peek_kind(1) == AfterKeyword:
				(after_timeout, timeout) = parse_header(state.advanced().advanced())
				(after_timeout, timeout.mapped(pure func(written): AfterArmRecipe(written)))
			else:
				parse_receive_arm_header(state)
		IdentifierToken:
			parse_receive_arm_header(state)
		_:
			(state, Declined(state.stop_at(SelectArmMalformed)))


private pure func parse_receive_arm_header(state: ParseState) -> (ParseState, Recognition[SelectArmRecipeKind]):
	(after_binder, binder) = parse_binder_recipe(state)
	match binder:
		Recognized(target):
			if after_binder.current_kind() == FromKeyword:
				(after_channel, channel) = parse_header(after_binder.advanced())
				(after_channel, channel.mapped(pure func(written): ReceiveArmRecipe(target, written)))
			else:
				(state, Declined(after_binder.stop_at(SelectArmMalformed)))
		Declined(_):
			(state, Declined(state.stop_at(SelectArmMalformed)))


-- With.
private pure func parse_with_recipe(state: ParseState, context: BodyContext) -> (ParseState, Recognition[WithRecipe]):
	(after_header, header) = parse_with_header(state.advanced(), state.span_start_line(state.current_span()))
	match header:
		Recognized(written):
			(after_body, body) = parse_closing_block(after_header, context)
			match body:
				Recognized(block):
					(after_body, Recognized({ keyword = state.current_span(), header = written, body = block }))
				Declined(stop):
					(state, Declined(stop))
		Declined(stop):
			(state, Declined(stop))


-- Everything after `with` through the colon. A second binding, which the
-- frozen grammar reports, leaves the colon unmatched.
private pure func parse_with_header(state: ParseState, line: Int) -> (ParseState, Recognition[WithHeader]):
	(after_binder, binder) = parse_binder_recipe(state)
	(after_annotation, annotation) = after_binder.parse_type_annotation()
	operator: Option[WithOperator] = match after_annotation.current_kind():
		EqualSymbol: Some(AcquireWithValue)
		QuestionEqualsSymbol: Some(AcquireWithTry)
		_: None
	match binder:
		Recognized(target):
			match annotation:
				InvalidAnnotation(stop):
					(state, Declined(stop))
				NoAnnotation:
					after_annotation.parse_written_acquisition(line, target, None, operator)
				Annotated(declared):
					after_annotation.parse_written_acquisition(line, target, Some(declared), operator)
		Declined(_):
			(state, Declined(state.stop_at(WithBindingMalformed)))


-- The acquisition after a binder and its optional type, when an operator
-- follows them.
private pure func parse_written_acquisition(
	state: ParseState, line: Int, binder: BinderRecipe, declared: Option[TypeRecipe], operator: Option[WithOperator],
) -> (ParseState, Recognition[WithHeader]):
	match operator:
		Some(kind):
			state.parse_acquisition_header(line, binder, declared, kind)
		None:
			(state, Declined(state.stop_at(WithBindingMalformed)))


-- The value of the acquisition and, for `?=`, its optional `on` clause, then
-- the colon.
private pure func parse_acquisition_header(
	state: ParseState, line: Int, binder: BinderRecipe, declared: Option[TypeRecipe], operator: WithOperator,
) -> (ParseState, Recognition[WithHeader]):
	(after_value, parsed) = parse_expression_recipe(state.advanced())
	match parsed:
		ParsedRecipe(value):
			(after_acquisition, acquisition) = after_value.parse_acquisition(value, operator)
			match acquisition:
				Recognized(written):
					if after_acquisition.at_header_colon(line):
						(after_acquisition.advanced(), Recognized({ binder = binder, declared = declared, acquisition = written }))
					else:
						(state, Declined(after_acquisition.stop_at(WithHeaderWithoutColon)))
				Declined(stop):
					(state, Declined(stop))
		UnsupportedRecipe(stop):
			(state, Declined(stop))
		RejectedRecipe:
			(state, Declined(after_value.stop_at(ExpressionSyntaxError)))


private pure func parse_acquisition(state: ParseState, value: ExpressionRecipe, operator: WithOperator) -> (ParseState, Recognition[AcquisitionRecipe]):
	match operator:
		AcquireWithValue:
			(state, Recognized(ValueAcquisitionRecipe(value)))
		AcquireWithTry:
			state.parse_try_acquisition(value)


-- A `?=` acquisition and its optional `on e => mapped`, which a `=` acquisition
-- may not have.
private pure func parse_try_acquisition(state: ParseState, value: ExpressionRecipe) -> (ParseState, Recognition[AcquisitionRecipe]):
	if state.current_kind() != OnKeyword:
		(state, Recognized(TryAcquisitionRecipe(value, None)))
	else:
		(after_binder, binder) = parse_binder_recipe(state.advanced())
		match binder:
			Recognized(target):
				if after_binder.current_kind() != FatArrowSymbol:
					(state, Declined(after_binder.stop_at(WithErrorMapMalformed)))
				else:
					(after_value, parsed) = parse_expression_recipe(after_binder.advanced())
					match parsed:
						ParsedRecipe(mapped):
							error_map: ErrorMapRecipe = { binder = target, value = mapped, span = binder_span(target).span_covering(mapped.span) }
							(after_value, Recognized(TryAcquisitionRecipe(value, Some(error_map))))
						UnsupportedRecipe(stop):
							(state, Declined(stop))
						RejectedRecipe:
							(state, Declined(after_value.stop_at(ExpressionSyntaxError)))
			Declined(_):
				(state, Declined(state.advanced().stop_at(WithErrorMapMalformed)))


-- Concurrent.
-- `concurrent:` or `concurrent(max_threads: n, timeout: t):`. Its block is
-- outside every loop: a `break` in it cannot leave the enclosing loop.
private pure func parse_concurrent_recipe(state: ParseState) -> (ParseState, Recognition[ConcurrentRecipe]):
	line: Int = state.span_start_line(state.current_span())
	after_keyword: ParseState = state.advanced()
	(after_parameters, parameters) = after_keyword.parse_optional_concurrent_parameters(line)
	match parameters:
		Recognized(written):
			if after_parameters.at_header_colon(line):
				(after_body, body) = parse_closing_block(after_parameters.advanced(), OutsideLoop)
				match body:
					Recognized(block):
						(after_body, Recognized({ keyword = state.current_span(), parameters = written, body = block }))
					Declined(stop):
						(state, Declined(stop))
			else:
				(state, Declined(after_parameters.stop_at(ConcurrentHeaderWithoutColon)))
		Declined(stop):
			(state, Declined(stop))


-- The parameters after `concurrent`, or none when no parenthesis follows.
private pure func parse_optional_concurrent_parameters(state: ParseState, line: Int) -> (ParseState, Recognition[ConcurrentParameters]):
	if state.current_kind() == LeftParenSymbol and state.is_on_line(line):
		parse_concurrent_parameters(state, line)
	else:
		no_parameters: ConcurrentParameters = { max_threads = None, timeout = None }
		(state, Recognized(no_parameters))


-- `(name: value, ...)` from the opening parenthesis through the closing one:
-- at least one parameter, each of `max_threads` and `timeout` at most once, a
-- trailing comma allowed. The frozen grammar reports every other shape.
private pure func parse_concurrent_parameters(state: ParseState, line: Int) -> (ParseState, Recognition[ConcurrentParameters]):
	var out: ParseState = state.advanced()
	var max_threads: Option[CountParameter] = None
	var timeout: Option[TimeoutRecipe] = None
	var declined: Option[StopPoint] = None
	var reading: Bool = True
	if out.current_kind() == RightParenSymbol:
		declined = Some(out.stop_at(ConcurrentParametersMalformed))
		reading = False
	while reading and declined.is_none():
		(after_parameter, parameter) = parse_concurrent_parameter(out, line)
		match parameter:
			ParsedCountParameter(count):
				if max_threads.is_some():
					declined = Some(out.stop_at(ConcurrentParameterRepeated))
				max_threads = Some(count)
			ParsedTimeoutParameter(written):
				if timeout.is_some():
					declined = Some(out.stop_at(ConcurrentParameterRepeated))
				timeout = Some(written)
			DeclinedParameter(stop):
				declined = Some(stop)
		out = after_parameter
		if out.current_kind() == CommaSymbol:
			out = out.advanced()
			reading = out.current_kind() != RightParenSymbol
		else:
			reading = False
	match declined:
		Some(stop):
			(state, Declined(stop))
		None:
			if out.current_kind() == RightParenSymbol and out.is_on_line(line):
				(out.advanced(), Recognized({ max_threads = max_threads, timeout = timeout }))
			else:
				(state, Declined(out.stop_at(ConcurrentParametersMalformed)))


private union ConcurrentParameterParse:
	ParsedCountParameter(CountParameter)
	ParsedTimeoutParameter(TimeoutRecipe)
	DeclinedParameter(StopPoint)


private pure func parse_concurrent_parameter(state: ParseState, line: Int) -> (ParseState, ConcurrentParameterParse):
	if state.current_kind() != IdentifierToken:
		(state, DeclinedParameter(state.stop_at(ConcurrentParametersMalformed)))
	else:
		(after_name, name) = state.consume_referenced_name(NameInConcurrentNamedParameter)
		if after_name.current_kind() != ColonSymbol or not after_name.is_on_line(line):
			(state, DeclinedParameter(after_name.stop_at(ConcurrentParametersMalformed)))
		else:
			(after_value, parsed) = parse_expression_recipe(after_name.advanced())
			match parsed:
				ParsedRecipe(value):
					match concurrent_parameter_name(after_value.spellings(), name):
						ConcurrentMaxThreads:
							match count_of_literal(value):
								Some(count):
									(after_value, ParsedCountParameter({ count = count, name_span = name.span, span = name.span.span_covering(value.span) }))
								None:
									(state, DeclinedParameter(state.stop_at(ConcurrentCountNotLiteral)))
						ConcurrentTimeout:
							(after_value, ParsedTimeoutParameter({ value = value, name_span = name.span, span = name.span.span_covering(value.span) }))
						ConcurrentUnknown:
							(state, DeclinedParameter(state.stop_at(ConcurrentParameterUnknown)))
				UnsupportedRecipe(stop):
					(state, DeclinedParameter(stop))
				RejectedRecipe:
					(state, DeclinedParameter(after_value.stop_at(ExpressionSyntaxError)))


private pure func concurrent_parameter_name(spellings: Spellings, name: WrittenName) -> ConcurrentParameterName:
	text: Option[String] = spellings.spelling_text(name.spelling)
	if text == Some(MAX_THREADS_PARAMETER):
		ConcurrentMaxThreads
	else if text == Some(TIMEOUT_PARAMETER):
		ConcurrentTimeout
	else:
		ConcurrentUnknown


-- The count an integer literal writes, however many parentheses group it:
-- positive and within `Int`, or none. `-1` is a negation, not a literal.
private pure func count_of_literal(value: ExpressionRecipe) -> Option[PositiveCount]:
	var inner: ExpressionRecipe = value
	var walking: Bool = True
	var count: Option[PositiveCount] = None
	while walking:
		match inner.kind:
			GroupingRecipe(grouped):
				inner = grouped
			IntegerRecipe(magnitude):
				count = positive_count(magnitude)
				walking = False
			_:
				walking = False
	count


-- Debug.
-- `debug:` and its block. The cursor is at a `debug` that opens a block form,
-- so its colon follows.
private pure func parse_debug_recipe(state: ParseState, context: BodyContext) -> (ParseState, Recognition[DebugRecipe]):
	(after_body, body) = parse_closing_block(state.advanced().advanced(), context)
	match body:
		Recognized(block):
			(after_body, Recognized({ keyword = state.current_span(), body = block }))
		Declined(stop):
			(state, Declined(stop))


-- Minting for these forms is in written order: a header's binders, types and
-- values, then the blocks, then the expression, then its statement.
private pure func mint_select_statement(state: ParseState, span: Span, recipe: SelectRecipe) -> (ParseState, Statement):
	(remaining, expression) = mint_select(state, recipe, span)
	remaining.finished_statement(span, ExpressionStatement(expression))


private pure func mint_select(state: ParseState, recipe: SelectRecipe, span: Span) -> (ParseState, Expression):
	var out: ParseState = state
	var arms: List[SelectArm] = []
	for arm in at_least_one_items(recipe.arms):
		(after_arm, minted) = mint_select_arm(out, arm)
		out = after_arm
		arms = arms.append(minted)
	out.finished_expression(span, Select(arms))


private pure func mint_select_arm(state: ParseState, arm: SelectArmRecipe) -> (ParseState, SelectArm):
	(after_kind, kind) = mint_select_arm_kind(state, arm.kind)
	(after_body, block) = mint_block(after_kind, arm.body)
	(after_body, { kind = kind, body = block, span = arm.span })


private pure func mint_select_arm_kind(state: ParseState, kind: SelectArmRecipeKind) -> (ParseState, SelectArmKind):
	match kind:
		ReceiveArmRecipe(binder, channel):
			(after_binder, target) = mint_binder_target(state, binder)
			(after_channel, expression) = mint_recipe(after_binder, channel)
			(after_channel, ReceiveArm(target, expression))
		SealedArmRecipe(channel):
			(after_channel, expression) = mint_recipe(state, channel)
			(after_channel, SealedArm(expression))
		AfterArmRecipe(timeout):
			(after_timeout, expression) = mint_recipe(state, timeout)
			(after_timeout, AfterArm(expression))


private pure func mint_with_statement(state: ParseState, span: Span, recipe: WithRecipe) -> (ParseState, Statement):
	(after_acquisition, acquisition) = mint_acquisition(state, recipe.header)
	(after_body, block) = mint_block(after_acquisition, recipe.body)
	(after_expression, expression) = after_body.finished_expression(span, With({ acquisition = acquisition, body = block }))
	after_expression.finished_statement(span, ExpressionStatement(expression))


private pure func mint_acquisition(state: ParseState, header: WithHeader) -> (ParseState, WithAcquisition):
	(after_target, target) = mint_binder_target(state, header.binder)
	(after_type, declared_type) = mint_optional_type(after_target, header.declared)
	binder_start: Span = binder_span(header.binder)
	match header.acquisition:
		ValueAcquisitionRecipe(value):
			(after_value, expression) = mint_recipe(after_type, value)
			(after_value, WithValue({ target = target, declared_type = declared_type, value = expression, span = binder_start.span_covering(value.span) }))
		TryAcquisitionRecipe(value, error_map):
			(after_value, expression) = mint_recipe(after_type, value)
			match error_map:
				Some(written):
					(after_error_target, error_target) = mint_binder_target(after_value, written.binder)
					(after_error_value, error_value) = mint_recipe(after_error_target, written.value)
					on_error: ErrorMap = { target = error_target, value = error_value, span = written.span }
					(after_error_value, WithTry({ target = target, declared_type = declared_type, value = expression, on_error = Some(on_error), span = binder_start.span_covering(written.span) }))
				None:
					(after_value, WithTry({ target = target, declared_type = declared_type, value = expression, on_error = None, span = binder_start.span_covering(value.span) }))


private pure func mint_concurrent_statement(state: ParseState, span: Span, recipe: ConcurrentRecipe) -> (ParseState, Statement):
	(after_timeout, timeout) = match recipe.parameters.timeout:
		Some(written):
			(after_value, value) = mint_recipe(state, written.value)
			minted: TimeoutParameter = { value = value, name_span = written.name_span, span = written.span }
			(after_value, Some(minted))
		None:
			(state, None)
	(after_body, block) = mint_block(after_timeout, recipe.body)
	(after_expression, expression) = after_body.finished_expression(span, ConcurrentBlock({
		max_threads = recipe.parameters.max_threads, timeout = timeout, body = block
	}))
	after_expression.finished_statement(span, ExpressionStatement(expression))


private pure func mint_debug_statement(state: ParseState, span: Span, recipe: DebugRecipe) -> (ParseState, Statement):
	(after_body, block) = mint_block(state, recipe.body)
	(after_expression, expression) = after_body.finished_expression(span, DebugBlock(block))
	after_expression.finished_statement(span, ExpressionStatement(expression))
