-- Direct statements and bodies. Children finish in source order, owners
-- finish post-order, and an unsupported body returns its persistent entry.
import:
	../lex/lexed_module: LiteralValue(IntegerValue)
	../syntax/declarations: FunctionDeclaration
	../syntax/expressions:
		AssignmentTarget(AssignsName, AssignsDiscard), Block, Body(BlockBody, ExpressionBody), CaseBody(CaseBlock, CaseStatement),
		CompoundOperator(AddAssign, SubtractAssign, MultiplyAssign, DivideAssign), ElseBody(ElseBlock, ElseIf), ElseBranch, Expression,
		CountParameter, ErrorMap, ExpressionKind(If, Match, Break, Continue, Lambda, VoidValue, Select, With, DebugBlock, ConcurrentBlock), LambdaParameter,
		LoopBinder(LoopVariable, LoopTuple), MatchCase, SelectArm, SelectArmKind(ReceiveArm, SealedArm, AfterArm), Statement, TimeoutParameter,
		WithAcquisition(WithValue, WithTry),
		StatementKind(ExpressionStatement, VariableDeclaration, TypedBinding, QuestionBinding, LocalFunctionStatement, Assignment, CompoundAssignment, SubscriptAssignment, TupleDestructure, WhileLoop, ForLoop, ConcurrentForLoop)
	../syntax/checked_values: PositiveCount, positive_count
	../syntax/names: BindingTarget(BindsName, DiscardsValue), WrittenName
	../syntax/patterns: Pattern
	../syntax/sequences: SmallTuple(Pair, Triple, Quadruple)
	../syntax/spellings: Spellings, spelling_text
	../syntax/types: WrittenType
	../tables/row_kinds: Purity(PureFunction, ImpureFunction), Visibility(PublicVisibility)
	../tables/expected_token: NameConstruct(NameInStatementName, NameInVariableName, NameInConcurrentNamedParameter)
	../tables/span: Span, span_covering
	../tables/token:
		KEYWORD_KINDS_IN_SEEDED_ORDER,
		TokenKind(IdentifierToken, UnderscoreSymbol, VarKeyword, WhileKeyword, ForKeyword, IfKeyword, ElseKeyword, MatchKeyword,
			BreakKeyword, ContinueKeyword, InKeyword, ConcurrentlyKeyword, SelectKeyword, WithKeyword, ConcurrentKeyword, DebugKeyword, SealedKeyword, FromKeyword, OnKeyword, AfterKeyword, FatArrowSymbol, EqualSymbol, ColonSymbol, QuestionEqualsSymbol, PlusEqualSymbol, MinusEqualSymbol,
			StarEqualSymbol, SlashEqualSymbol, LeftParenSymbol, RightParenSymbol, LeftBracketSymbol, RightBracketSymbol, LeftBraceSymbol, RightBraceSymbol, CommaSymbol, FuncKeyword, PureKeyword, ArrowSymbol, NewlineToken, IndentToken, DedentToken, EndOfFileToken, DotSymbol, IntLiteralToken)
	token_cursor: is_soft_keyword
	binary_operators: binary_operator
	parse_state:
		ParseState, current_kind, current_span, current_literal, peek_kind, advanced, diagnostic_count, spellings,
		consume_referenced_name, finished_expression, finished_statement, finished_block, finished_else_if,
		finished_function, finished_local_function, report_unreachable_input, finished_name_use, finished_binder, nested
	layout_quirks: BlockAnchor(IndentedByLexer, PastExpressionAnchor), ExpressionAnchor, anchored_at, block_may_open
	stop_reason:
		StopPoint, rejected_stop, Recognition(Recognized, Declined), Boundary(AtBoundary, PastBoundary),
		StopReason(NestingTooDeep, BodylessFunction, BlockWithoutIndent, BlockNotClosed, LocalFunctionHeaderRejected,
			MalformedLambdaHeader, ExpressionSyntaxError, ValueOnNextLine, TupleDestructuring, FieldAssignment, NonPlaceAssignmentTarget, AssignmentTargetRoutedElsewhere,
			LoopExitOutsideLoop, QuestionBindingInLoop, MalformedTypedBinding, VarWithoutName, VarWithoutInitializer, InvalidType, InvalidPattern,
			ConcurrentlyLoop, HeaderWithoutColon, ForWithoutIn, InvalidLoopBinding, MalformedElse, OperatorAfterBlock, MatchWithoutBlock, MatchNotClosed,
			CaseWithoutColon, NestedBlockInCaseLine, SelectWithoutArms, SelectNotClosed, SelectArmMalformed, WithBindingMalformed, WithHeaderWithoutColon,
			WithErrorMapMalformed, ConcurrentHeaderWithoutColon, ConcurrentParametersMalformed, ConcurrentParameterUnknown, ConcurrentParameterRepeated,
			ConcurrentCountNotLiteral),
		stop_at, statement_boundary, mapped, opens_block_form
	tree_expression_parser:
		ValueParse(ParsedValue, UnsupportedValue, RejectedValue), ExpressionValue, ExpressionRoot(NameRoot, SubscriptRoot, TupleRoot, FieldRoot, GroupedRoot, OtherRoot), StatementHeadParse(ParsedStatementValue, ParsedSubscriptPlace, UnsupportedStatementHead, RejectedStatementHead), ExpressionEnding(AfterContinuationDedent), ends_in_control, parse_scoped_expression, parse_statement_head, ends_in_block_lambda, block_expression_ends, continue_control_expression
	tree_function_header_parser:
		FunctionHead, FunctionHeadParse(ParsedFunctionHead, RejectedFunctionHead), FunctionBodyPresence(ForwardDeclaration, BodyFollows), parse_function_head
	tree_value_layout: next_line_value_entry, close_next_line_value
	tree_pattern_parser: parse_pattern
	tree_type_parser: parse_type


-- Whether `break` and `continue` have a loop to leave. A parameter: a nested
-- loop body passes `InsideLoop` down and nothing saves or restores it.
fixed union BodyContext:
	OutsideLoop
	InsideLoop


-- Flat written binding targets shared by loops and destructuring statements.
private record TupleBinding {
	targets: SmallTuple[BindingTarget],
	span: Span
}


-- The state of an unsupported result is meaningless: the public entry points
-- return their own entry state. What it carries is why recognition declined.
private union StatementParse:
	ParsedStatement(Statement)
	UnsupportedStatement(StopPoint)


private union BlockParse:
	ParsedBlock(Block)
	UnsupportedBlock(StopPoint)


union FunctionCompletion:
	CompletedFunction(FunctionDeclaration)
	DeferredFunction(StopPoint)


-- A body read in full, and the span its owner's span reaches.
record CompletedBody {
	body: Body,
	span: Span
}


-- Successful heads leave the cursor at body entry. Children finish while
-- reading, and the saved persistent entry owns every unsupported rollback.
pure func complete_body(state: ParseState) -> (ParseState, Recognition[CompletedBody]):
	(parsed, result) = parse_body(state)
	match result:
		Recognized(body):
			if parsed.diagnostic_count() != state.diagnostic_count():
				-- The body error paths decline before this boundary. Keep
				-- the entry authority even if a future parser breaks that rule.
				report_unreachable_input("a completed direct body adds no diagnostics")
				(state, Declined(parsed.stop_at(ExpressionSyntaxError)))
			else:
				(parsed.skip_newlines(), Recognized({ body = body, span = body_span(body) }))
		Declined(stop): (state, Declined(stop))


private pure func body_span(body: Body) -> Span:
	match body:
		BlockBody(block): block.span
		ExpressionBody(expression): expression.span


-- The function owns its header's ids and its body's, so it is minted last. A
-- forward declaration completes with no body: its span is its header, through
-- the colon that promised none, and module assembly pairs it.
pure func complete_function(state: ParseState, preview: FunctionHead) -> (ParseState, FunctionCompletion):
	header = preview.header
	match preview.body_presence:
		ForwardDeclaration:
			(declared, declaration) = state.finished_function(
				header.visibility, header.documentation, header.annotations,
				{ signature = header.signature, type_parameters = header.type_parameters, constraints = header.constraints, body = None },
				header.header_span
			)
			(declared, CompletedFunction(declaration))
		BodyFollows:
			(completed, body) = complete_body(state)
			match body:
				Recognized(read):
					(declared, declaration) = completed.finished_function(
						header.visibility, header.documentation, header.annotations,
						{ signature = header.signature, type_parameters = header.type_parameters, constraints = header.constraints, body = Some(read.body) },
						header.header_span.span_covering(read.span)
					)
					(declared, CompletedFunction(declaration))
				Declined(stop):
					(state, DeferredFunction(stop))


private pure func skip_newlines(state: ParseState) -> ParseState:
	var out: ParseState = state
	while out.current_kind() == NewlineToken:
		out = out.advanced()
	out


-- A completed control can resume binary operators in an operand or statement
-- entry. `as` and `=` still decline: they are rejected by the frozen expression
-- grammar, and the transitional control boundary must not claim them complete.
private pure func control_operator_may_follow(state: ParseState) -> Bool:
	block_expression_ends(state.current_kind()) or binary_operator(state.current_kind()).is_some()


-- Bodies.
private pure func parse_body(state: ParseState) -> (ParseState, Recognition[Body]):
	if state.current_kind() == NewlineToken:
		(remaining, parsed) = parse_block(state, OutsideLoop, IndentedByLexer)
		match parsed:
			ParsedBlock(block):
				(remaining, Recognized(BlockBody(block)))
			UnsupportedBlock(stop):
				(remaining, Declined(stop))
	else:
		-- A body written on the header's line is anchored at its own first token,
		-- so a block it opens has to be indented past that column.
		(remaining, value) = parse_value(state, anchored_at(state.current_span()), OutsideLoop)
		(remaining, value.mapped(pure func(expression): ExpressionBody(expression)))


-- Blocks.
-- An indented block is one level of nesting (section 3.14).
private pure func parse_block(state: ParseState, context: BodyContext, anchor: BlockAnchor) -> (ParseState, BlockParse):
	state.nested(
		pure func(reported): UnsupportedBlock(state.stop_at(NestingTooDeep)),
		pure func(inside): parse_block_in(inside, context, anchor),
	)


private pure func parse_block_in(state: ParseState, context: BodyContext, anchor: BlockAnchor) -> (ParseState, BlockParse):
	match state.block_start(anchor):
		NoBlockStart:
			(state, UnsupportedBlock(state.stop_at(BlockWithoutIndent)))
		BlockStartsAt(at_first_statement):
			read_block(state, at_first_statement, context)


-- Where a block that may open after `state` starts reading statements.
private union BlockStart:
	BlockStartsAt(ParseState)
	NoBlockStart


-- The block after a header's colon: NEWLINE and INDENT, and a first statement
-- that the anchor allows (`layout_quirks.block_may_open`).
private pure func block_start(state: ParseState, anchor: BlockAnchor) -> BlockStart:
	opened: ParseState = state.skip_newlines()
	if state.current_kind() != NewlineToken or opened.current_kind() != IndentToken:
		NoBlockStart
	else:
		at_first_statement: ParseState = opened.advanced().skip_newlines()
		if at_first_statement.block_may_open(anchor):
			BlockStartsAt(at_first_statement)
		else:
			NoBlockStart


-- The statements of a block up to its dedent. `state` is the entry state that
-- an unsupported statement rolls back to.
private pure func read_block(state: ParseState, at_first_statement: ParseState, context: BodyContext) -> (ParseState, BlockParse):
	var out: ParseState = at_first_statement
	var statements: List[Statement] = []
	var declined: Option[StopPoint] = None
	while declined.is_none() and out.current_kind() != DedentToken and out.current_kind() != EndOfFileToken:
		(remaining, parsed) = parse_statement(out, context)
		match parsed:
			ParsedStatement(statement):
				statements = statements.append(statement)
				out = remaining.skip_newlines()
			UnsupportedStatement(stop):
				declined = Some(stop)
	match declined:
		Some(stop):
			(state, UnsupportedBlock(stop))
		None:
			match statements:
				[first, ...rest]:
					if out.current_kind() == DedentToken:
						var leading: List[Statement] = []
						var last = first
						for statement in rest:
							leading = leading.append(last)
							last = statement
						(minted, block) = out.advanced().finished_block(leading, last, first.span.span_covering(last.span))
						(minted, ParsedBlock(block))
					else:
						(state, UnsupportedBlock(out.stop_at(BlockNotClosed)))
				_:
					(state, UnsupportedBlock(out.stop_at(BlockNotClosed)))


-- Statements.
private pure func parse_statement(state: ParseState, context: BodyContext) -> (ParseState, StatementParse):
	if state.current_kind().is_soft_keyword() and state.starts_named_binding():
		state.parse_named_statement(context)
	else:
		state.parse_statement_form(context)


private pure func parse_statement_form(state: ParseState, context: BodyContext) -> (ParseState, StatementParse):
	match state.current_kind():
		VarKeyword:
			state.parse_variable_statement(context)
		WhileKeyword:
			state.parse_while_statement(context)
		ForKeyword:
			state.parse_for_statement(context)
		IfKeyword:
			state.parse_conditional_statement(context)
		MatchKeyword:
			state.parse_match_statement(context)
		SelectKeyword | WithKeyword | ConcurrentKeyword | DebugKeyword:
			-- Binding tails were selected first. Remaining block shapes keep
			-- their block readers; only frozen primary-name forms read as names.
			if state.opens_block_form():
				state.parse_block_form_statement(context)
			else:
				state.parse_expression_statement(context)
		BreakKeyword | ContinueKeyword:
			state.parse_loop_exit(context)
		FuncKeyword | PureKeyword:
			-- `func name(...)` or `pure func name(...)`: a local function, not a lambda.
			if (state.current_kind() == PureKeyword and state.peek_kind(1) == FuncKeyword and (state.peek_kind(2) == IdentifierToken or state.peek_kind(2).is_soft_keyword())) or (state.current_kind() == FuncKeyword and (state.peek_kind(1) == IdentifierToken or state.peek_kind(1).is_soft_keyword())):
				state.parse_local_function()
			else:
				state.parse_expression_statement(context)
		IdentifierToken:
			state.parse_named_statement(context)
		LeftParenSymbol:
			if state.starts_tuple_destructuring():
				state.parse_tuple_destructuring(context)
			else:
				state.parse_expression_statement(context)
		UnderscoreSymbol:
			if state.peek_kind(1) == EqualSymbol:
				state.parse_discard_assignment(context)
			else:
				state.parse_expression_statement(context)
		_:
			state.parse_expression_statement(context)


private pure func parse_named_statement(state: ParseState, context: BodyContext) -> (ParseState, StatementParse):
	match state.peek_kind(1):
		EqualSymbol: state.parse_name_assignment(context)
		PlusEqualSymbol | MinusEqualSymbol | StarEqualSymbol | SlashEqualSymbol: state.parse_compound_assignment(context)
		QuestionEqualsSymbol: state.parse_question_binding(context)
		ColonSymbol: state.parse_typed_binding(context)
		_: state.parse_expression_statement(context)


private pure func starts_named_binding(state: ParseState) -> Bool:
	match state.peek_kind(1):
		EqualSymbol | QuestionEqualsSymbol | PlusEqualSymbol | MinusEqualSymbol | StarEqualSymbol | SlashEqualSymbol: True
		ColonSymbol: state.colon_starts_typed_binding()
		_: False


-- Frozen statement selection: only a top-level `=` or `?=` before a line,
-- comma, colon or unmatched closer makes this a typed binding, not a block.
private pure func colon_starts_typed_binding(state: ParseState) -> Bool:
	var offset = 2
	var depth = 0
	var found = False
	var scanning = True
	while scanning:
		match state.peek_kind(offset):
			EndOfFileToken | NewlineToken | DedentToken: scanning = False
			EqualSymbol | QuestionEqualsSymbol:
				if depth == 0:
					found = True
					scanning = False
			LeftParenSymbol | LeftBracketSymbol | LeftBraceSymbol: depth += 1
			RightParenSymbol | RightBracketSymbol | RightBraceSymbol:
				if depth == 0:
					scanning = False
				else:
					depth -= 1
			CommaSymbol | ColonSymbol:
				if depth == 0:
					scanning = False
			_: void
		offset += 1
	found


-- A statement's `value` after its operator: an expression that starts on the
-- operator's line and ends the statement. It may be or contain an `if` or a
-- `match`, whose blocks end on dedents, and may be a `select`. `with`,
-- `concurrent` and `debug` are not values here: the frozen parser indents their
-- block past the keyword, not past the statement, so a value written the usual
-- way is rejected there and must not be read here.
private pure func parse_value(state: ParseState, anchor: ExpressionAnchor, context: BodyContext) -> (ParseState, Recognition[Expression]):
	match state.current_kind():
		IfKeyword | MatchKeyword:
			-- The whole value is the control expression. Reading it here, not
			-- through the expression grammar, keeps the frames between a
			-- statement and the statements of its blocks few (section 3.14).
			-- Its twin for an operand is `parse_control_operand` in the
			-- expression parser, which finishes the same syntax.
			(remaining, control) = parse_control(state, PastExpressionAnchor(anchor), context)
			(remaining, control)
		SelectKeyword:
			if state.opens_block_form():
				(remaining, control) = parse_control(state, PastExpressionAnchor(anchor), context)
				(remaining, control)
			else:
				parse_expression_value(state, anchor, context)
		_:
			parse_expression_value(state, anchor, context)


private pure func parse_expression_value(state: ParseState, anchor: ExpressionAnchor, context: BodyContext) -> (ParseState, Recognition[Expression]):
	(remaining, parsed, ending) = parse_scoped_expression(state, anchor, context)
	match parsed:
		ParsedValue(value):
			match remaining.statement_boundary():
				AtBoundary:
					(remaining, Recognized(value.expression))
				PastBoundary(stop):
					-- A control expression, or a lambda with a block body, ends at its
					-- block's dedent, where the next statement may already start.
					if ending == AfterContinuationDedent or value.ends_in_control() or (value.ends_in_block_lambda() and block_expression_ends(remaining.current_kind())):
						(remaining, Recognized(value.expression))
					else:
						(state, Declined(stop))
		UnsupportedValue(stop):
			(state, Declined(stop))
		RejectedValue:
			(state, Declined(remaining.rejected_stop(remaining, ExpressionSyntaxError)))


private pure func parse_value_after(state: ParseState, anchor: ExpressionAnchor, context: BodyContext) -> (ParseState, Recognition[Expression]):
	if state.current_kind() == NewlineToken:
		parse_next_line_value(state, context)
	else:
		parse_value(state, anchor, context)


private pure func parse_next_line_value(state: ParseState, context: BodyContext) -> (ParseState, Recognition[Expression]):
	match next_line_value_entry(state):
		None:
			(state, Declined(state.stop_at(ValueOnNextLine)))
		Some(entry):
			-- Unlike a same-line control value, this entry uses the operator
			-- grammar; the value's own DEDENT still belongs to its layout.
			(parsed, value) = parse_expression_value(entry, anchored_at(entry.current_span()), context)
			match value:
				Declined(stop): (state, Declined(stop))
				Recognized(expression):
					match close_next_line_value(parsed):
						Some(closed): (closed, Recognized(expression))
						None: (state, Declined(parsed.stop_at(ValueOnNextLine)))


-- A statement of `kind` over `start` and its value, or unsupported.
private pure func valued_statement(state: ParseState, start: Span, value: Recognition[Expression], kind: pure (Expression) -> StatementKind) -> (ParseState, StatementParse):
	match value:
		Recognized(expression): state.completed_statement(start.span_covering(expression.span), kind(expression))
		Declined(stop): (state, UnsupportedStatement(stop))


private pure func completed_statement(state: ParseState, span: Span, kind: StatementKind) -> (ParseState, StatementParse):
	(minted, statement) = state.finished_statement(span, kind)
	(minted, ParsedStatement(statement))


private pure func expression_statement(state: ParseState, expression: Expression) -> (ParseState, StatementParse):
	state.completed_statement(expression.span, ExpressionStatement(expression))


private pure func parse_expression_statement(state: ParseState, context: BodyContext) -> (ParseState, StatementParse):
	(remaining, parsed, ending) = parse_statement_head(state, anchored_at(state.current_span()), context)
	match parsed:
		ParsedSubscriptPlace(place):
			(after_value, value) = parse_value_after(remaining.advanced(), anchored_at(state.current_span()), context)
			after_value.valued_statement(place.span, value, pure func(expression): SubscriptAssignment({ place = place, value = expression }))
		ParsedStatementValue(value):
			if remaining.current_kind() == EqualSymbol:
				(state, UnsupportedStatement(remaining.stop_at(unassignable_target_reason(value))))
			else:
				match remaining.statement_boundary():
					AtBoundary: remaining.expression_statement(value.expression)
					PastBoundary(stop):
						if ending == AfterContinuationDedent or value.ends_in_control() or (value.ends_in_block_lambda() and block_expression_ends(remaining.current_kind())):
							remaining.expression_statement(value.expression)
						else:
							(state, UnsupportedStatement(stop))
		UnsupportedStatementHead(stop): (state, UnsupportedStatement(stop))
		RejectedStatementHead: (state, UnsupportedStatement(remaining.rejected_stop(remaining, ExpressionSyntaxError)))


-- Why `target = value` is not an assignment this slice reads. A name and a
-- subscript target have statement forms of their own that the dispatcher
-- chooses first, so they do not reach here.
private pure func unassignable_target_reason(target: ExpressionValue) -> StopReason:
	match target.root:
		TupleRoot: TupleDestructuring
		FieldRoot: FieldAssignment
		NameRoot | SubscriptRoot: AssignmentTargetRoutedElsewhere
		GroupedRoot | OtherRoot: NonPlaceAssignmentTarget


private pure func parse_loop_exit(state: ParseState, context: BodyContext) -> (ParseState, StatementParse):
	remaining = state.advanced()
	if context != InsideLoop:
		(state, UnsupportedStatement(state.stop_at(LoopExitOutsideLoop)))
	else:
		match remaining.statement_boundary():
			PastBoundary(stop): (state, UnsupportedStatement(stop))
			AtBoundary:
				kind: ExpressionKind = if state.current_kind() == BreakKeyword:
					Break
				else:
					Continue
				(minted, expression) = remaining.finished_expression(state.current_span(), kind)
				minted.expression_statement(expression)


-- `name = value`.
private pure func parse_name_assignment(state: ParseState, context: BodyContext) -> (ParseState, StatementParse):
	(named, name) = state.consume_referenced_name(NameInStatementName)
	(used, use) = named.finished_name_use(name)
	(after_value, value) = parse_value_after(used.advanced(), anchored_at(state.current_span()), context)
	after_value.valued_statement(name.span, value, pure func(expression): Assignment({ target = AssignsName(use), value = expression }))


-- Frozen tuple-assignment selection: a comma, flat binder tokens, closing
-- parenthesis and immediate `=`. Reserved keywords select the binder path;
-- soft keyword tokens do not. Arity is checked by the binding parser.
private pure func starts_tuple_destructuring(state: ParseState) -> Bool:
	var offset = 1
	var saw_comma = False
	var expecting_name = True
	var reading = True
	var selected = False
	while reading:
		kind = state.peek_kind(offset)
		if expecting_name:
			if kind.is_tuple_binder_token():
				offset += 1
				expecting_name = False
			else:
				reading = False
		else if kind == CommaSymbol:
			saw_comma = True
			offset += 1
			if state.peek_kind(offset) != RightParenSymbol:
				expecting_name = True
		else if kind == RightParenSymbol:
			selected = saw_comma and state.peek_kind(offset + 1) == EqualSymbol
			reading = False
		else:
			reading = False
	selected


private pure func is_tuple_binder_token(kind: TokenKind) -> Bool:
	(kind == IdentifierToken or kind == UnderscoreSymbol or
		(KEYWORD_KINDS_IN_SEEDED_ORDER.contains(kind) and not kind.is_soft_keyword()))


-- Binding targets finish before the value; there is no tuple expression or
-- target name-use to discard. Unsupported values return the body's entry.
private pure func parse_tuple_destructuring(state: ParseState, context: BodyContext) -> (ParseState, StatementParse):
	(after_targets, targets) = parse_tuple_binding(state)
	match targets:
		Recognized(tuple):
			(after_value, value) = parse_value_after(after_targets.advanced(), anchored_at(state.current_span()), context)
			after_value.valued_statement(tuple.span, value, pure func(expression): TupleDestructure({ targets = tuple.targets, value = expression }))
		Declined(stop):
			(state, UnsupportedStatement({ reason = TupleDestructuring, at = stop.at }))


-- `_ = value`.
private pure func parse_discard_assignment(state: ParseState, context: BodyContext) -> (ParseState, StatementParse):
	target: Span = state.current_span()
	equal: ParseState = state.advanced()
	(after_value, value) = parse_value_after(equal.advanced(), anchored_at(state.current_span()), context)
	after_value.valued_statement(target, value, pure func(written): Assignment({ target = AssignsDiscard(target), value = written }))


private pure func parse_compound_assignment(state: ParseState, context: BodyContext) -> (ParseState, StatementParse):
	(named, name) = state.consume_referenced_name(NameInStatementName)
	operator: CompoundOperator = match named.current_kind():
		PlusEqualSymbol: AddAssign
		MinusEqualSymbol: SubtractAssign
		StarEqualSymbol: MultiplyAssign
		_: DivideAssign
	(used, use) = named.finished_name_use(name)
	(after_value, value) = parse_value_after(used.advanced(), anchored_at(state.current_span()), context)
	after_value.valued_statement(name.span, value, pure func(written): CompoundAssignment({ target = use, operator = operator, value = written }))


-- `x: T = value` or `x: T ?= value`. The colon is a type annotation only when
-- an `=` or `?=` follows the type; anything else is left to the frozen
-- grammar's diagnostics.
private pure func parse_typed_binding(state: ParseState, context: BodyContext) -> (ParseState, StatementParse):
	(named, name) = state.consume_referenced_name(NameInStatementName)
	(bound, binder) = named.finished_binder(name)
	(after_type, written) = bound.advanced().read_type()
	match written:
		Recognized(declared):
			if after_type.current_kind() == EqualSymbol:
				(after_value, value) = parse_value_after(after_type.advanced(), anchored_at(state.current_span()), context)
				after_value.valued_statement(name.span, value, pure func(written): TypedBinding({ target = BindsName(binder), declared_type = declared, value = written }))
			else if after_type.current_kind() == QuestionEqualsSymbol:
				match context:
					OutsideLoop:
						(after_value, value) = parse_value_after(after_type.advanced(), anchored_at(state.current_span()), context)
						after_value.valued_statement(name.span, value, pure func(written): QuestionBinding({ binder = binder, declared_type = Some(declared), value = written }))
					InsideLoop:
						(state, UnsupportedStatement(after_type.stop_at(QuestionBindingInLoop)))
			else:
				(state, UnsupportedStatement(after_type.stop_at(MalformedTypedBinding)))
		Declined(stop):
			(state, UnsupportedStatement(stop))


-- `x ?= value`. Inside a loop it would return from the function on every
-- iteration, which the frozen grammar reports, so a loop body leaves it
-- unsupported.
private pure func parse_question_binding(state: ParseState, context: BodyContext) -> (ParseState, StatementParse):
	(named, name) = state.consume_referenced_name(NameInStatementName)
	if context == InsideLoop:
		(state, UnsupportedStatement(named.stop_at(QuestionBindingInLoop)))
	else:
		(bound, binder) = named.finished_binder(name)
		(after_value, value) = parse_value_after(bound.advanced(), anchored_at(state.current_span()), context)
		after_value.valued_statement(name.span, value, pure func(written): QuestionBinding({ binder = binder, declared_type = None, value = written }))


-- `var x [: T] = value`.
private pure func parse_variable_statement(state: ParseState, context: BodyContext) -> (ParseState, StatementParse):
	keyword: Span = state.current_span()
	if state.peek_kind(1) != IdentifierToken and not state.peek_kind(1).is_soft_keyword():
		(state, UnsupportedStatement(state.advanced().stop_at(VarWithoutName)))
	else:
		(named, name) = state.advanced().consume_referenced_name(NameInVariableName)
		(bound, binder) = named.finished_binder(name)
		(after_annotation, annotation) = bound.parse_type_annotation()
		match annotation:
			InvalidAnnotation(stop):
				(state, UnsupportedStatement(stop))
			_:
				if after_annotation.current_kind() != EqualSymbol:
					(state, UnsupportedStatement(after_annotation.stop_at(VarWithoutInitializer)))
				else:
					(after_value, value) = parse_value_after(after_annotation.advanced(), anchored_at(state.current_span()), context)
					declared: Option[WrittenType] = match annotation:
						Annotated(written): Some(written)
						_: None
					after_value.valued_statement(keyword, value, pure func(written): VariableDeclaration({ target = BindsName(binder), declared_type = declared, value = written }))


private union TypeAnnotationParse:
	NoAnnotation
	Annotated(WrittenType)
	InvalidAnnotation(StopPoint)


-- An optional `: T`.
private pure func parse_type_annotation(state: ParseState) -> (ParseState, TypeAnnotationParse):
	if state.current_kind() != ColonSymbol:
		(state, NoAnnotation)
	else:
		(remaining, written) = state.advanced().read_type()
		match written:
			Recognized(written):
				(remaining, Annotated(written))
			Declined(stop):
				(state, InvalidAnnotation(stop))


-- A type is valid here when its direct parse adds no diagnostic. Its ids
-- follow the binder before it; a later body failure restores the entry mint.
private pure func read_type(state: ParseState) -> (ParseState, Recognition[WrittenType]):
	(remaining, written) = parse_type(state)
	if remaining.diagnostic_count() != state.diagnostic_count():
		(state, Declined(state.rejected_stop(remaining, InvalidType)))
	else:
		(remaining, Recognized(written))


private pure func read_pattern(state: ParseState) -> (ParseState, Recognition[Pattern]):
	(remaining, written) = parse_pattern(state)
	if remaining.diagnostic_count() != state.diagnostic_count():
		(state, Declined(state.rejected_stop(remaining, InvalidPattern)))
	else:
		(remaining, Recognized(written))


-- An expression anchored at its own first token: a `with` value or error map,
-- a `concurrent` parameter, and every header expression.
private pure func parse_anchored_expression(state: ParseState, context: BodyContext) -> (ParseState, ValueParse):
	(parsed, value, _) = parse_scoped_expression(state, anchored_at(state.current_span()), context)
	(parsed, value)


-- `condition:` after a block keyword: an expression and its colon.
private pure func parse_header(state: ParseState, context: BodyContext) -> (ParseState, Recognition[Expression]):
	(remaining, parsed) = parse_anchored_expression(state, context)
	match parsed:
		ParsedValue(condition):
			if remaining.current_kind() == ColonSymbol:
				(remaining.advanced(), Recognized(condition.expression))
			else if remaining.current_kind() == ConcurrentlyKeyword:
				(state, Declined(remaining.stop_at(ConcurrentlyLoop)))
			else:
				(state, Declined(remaining.stop_at(HeaderWithoutColon)))
		UnsupportedValue(stop):
			(state, Declined(stop))
		RejectedValue:
			(state, Declined(remaining.rejected_stop(remaining, ExpressionSyntaxError)))


private pure func parse_while_statement(state: ParseState, context: BodyContext) -> (ParseState, StatementParse):
	keyword: Span = state.current_span()
	(after_header, condition) = parse_header(state.advanced(), context)
	match condition:
		Recognized(written):
			(after_block, block) = parse_block(after_header, InsideLoop, IndentedByLexer)
			match block:
				ParsedBlock(body):
					after_block.completed_statement(keyword.span_covering(body.span), WhileLoop({ condition = written, body = body }))
				UnsupportedBlock(stop):
					(state, UnsupportedStatement(stop))
		Declined(stop):
			(state, UnsupportedStatement(stop))


-- `for name in iterable:` or `for (a, b) in iterable:`. The iterable
-- stops before the ordinary colon or the explicitly written concurrent tail.
private pure func parse_for_statement(state: ParseState, context: BodyContext) -> (ParseState, StatementParse):
	keyword: Span = state.current_span()
	(after_binder, binding) = parse_loop_binding(state.advanced())
	match binding:
		Recognized(loop_binding):
			if after_binder.current_kind() != InKeyword:
				(state, UnsupportedStatement(after_binder.stop_at(ForWithoutIn)))
			else:
				(after_iterable, iterable) = parse_anchored_expression(after_binder.advanced(), context)
				match iterable:
					ParsedValue(written):
						match after_iterable.current_kind():
							ColonSymbol:
								(after_block, block) = parse_block(after_iterable.advanced(), InsideLoop, IndentedByLexer)
								match block:
									ParsedBlock(body):
										after_block.completed_statement(keyword.span_covering(body.span), ForLoop({ binder = loop_binding, iterable = written.expression, body = body }))
									UnsupportedBlock(stop): (state, UnsupportedStatement(stop))
							ConcurrentlyKeyword:
								parse_concurrent_for_statement(state, after_iterable, loop_binding, written.expression, context)
							_: (state, UnsupportedStatement(after_iterable.stop_at(HeaderWithoutColon)))
					UnsupportedValue(stop): (state, UnsupportedStatement(stop))
					RejectedValue: (state, UnsupportedStatement(after_iterable.rejected_stop(after_iterable, ExpressionSyntaxError)))
		Declined(stop): (state, UnsupportedStatement(stop))


-- The frozen grammar requires one binding target and a positive literal
-- limit. A discarded target owns no binder id, just its written span.
private pure func parse_concurrent_for_statement(state: ParseState, at_tail: ParseState, binding: LoopBinder, iterable: Expression, context: BodyContext) -> (ParseState, StatementParse):
	match binding:
		LoopTuple(_, _): (state, UnsupportedStatement(at_tail.stop_at(ConcurrentlyLoop)))
		LoopVariable(target):
			at_parameters = at_tail.advanced()
			if at_parameters.current_kind() != LeftParenSymbol:
				(state, UnsupportedStatement(at_parameters.stop_at(ConcurrentParametersMalformed)))
			else:
				(after_parameters, parameters) = parse_concurrent_parameters(at_parameters, ConcurrentForOwner, context)
				match parameters:
					Declined(stop): (state, UnsupportedStatement(stop))
					Recognized(written):
						match written.count:
							None: (state, UnsupportedStatement(after_parameters.stop_at(ConcurrentParametersMalformed)))
							Some(limit):
								if not after_parameters.at_header_colon():
									(state, UnsupportedStatement(after_parameters.stop_at(ConcurrentHeaderWithoutColon)))
								else:
									(after_block, block) = parse_block(after_parameters.advanced(), InsideLoop, IndentedByLexer)
									match block:
										ParsedBlock(body):
											after_block.completed_statement(state.current_span().span_covering(body.span), ConcurrentForLoop({ binder = target, iterable = iterable, limit = limit, timeout = written.timeout, body = body }))
										UnsupportedBlock(stop): (state, UnsupportedStatement(stop))


private pure func parse_loop_binding(state: ParseState) -> (ParseState, Recognition[LoopBinder]):
	if state.current_kind() == LeftParenSymbol:
		(after_targets, targets) = parse_tuple_binding(state)
		(after_targets, targets.mapped(pure func(tuple): LoopTuple(tuple.targets, tuple.span)))
	else:
		(after_binder, binder) = parse_binder(state)
		(after_binder, binder.mapped(pure func(single): LoopVariable(single)))


-- A name or `_`.
private pure func parse_binder(state: ParseState) -> (ParseState, Recognition[BindingTarget]):
	match state.current_kind():
		IdentifierToken | DebugKeyword | WithKeyword | ConcurrentKeyword | ConcurrentlyKeyword | SelectKeyword | AfterKeyword | SealedKeyword | OnKeyword:
			(named, name) = state.consume_referenced_name(NameInStatementName)
			(bound, binder) = named.finished_binder(name)
			(bound, Recognized(BindsName(binder)))
		UnderscoreSymbol:
			(state.advanced(), Recognized(DiscardsValue(state.current_span())))
		_:
			(state, Declined(state.stop_at(InvalidLoopBinding)))


-- `(a, _, c)`: two to four binders, a trailing comma allowed. Its span runs
-- from the opening to the closing parenthesis.
private pure func parse_tuple_binding(state: ParseState) -> (ParseState, Recognition[TupleBinding]):
	opening: Span = state.current_span()
	var out: ParseState = state.advanced()
	var binders: List[BindingTarget] = []
	var reading: Bool = True
	var valid: Bool = True
	while reading and valid:
		(after_binder, binder) = parse_binder(out)
		match binder:
			Recognized(written):
				binders = binders.append(written)
				out = after_binder
				if out.current_kind() == CommaSymbol:
					out = out.advanced()
					reading = out.current_kind() != RightParenSymbol
				else:
					reading = False
			Declined(_):
				valid = False
	if not valid or out.current_kind() != RightParenSymbol:
		(state, Declined(out.stop_at(InvalidLoopBinding)))
	else:
		closing: Span = out.current_span()
		match binders:
			[first, second]:
				(out.advanced(), Recognized({ targets = Pair(first, second), span = opening.span_covering(closing) }))
			[first, second, third]:
				(out.advanced(), Recognized({ targets = Triple(first, second, third), span = opening.span_covering(closing) }))
			[first, second, third, fourth]:
				(out.advanced(), Recognized({ targets = Quadruple(first, second, third, fourth), span = opening.span_covering(closing) }))
			_:
				(state, Declined(out.stop_at(InvalidLoopBinding)))


private pure func block_span(block: Block) -> Span:
	block.span


-- The chain is read by a loop: each `else if` appends a link.
-- An `if`, `match` or `select` read where an expression is expected. Its
-- blocks inherit the caller's loop context. A lambda or task body resets that
-- context at its boundary. The caller decides whether its value resumes operators. A
-- `select` is a whole value only: the expression grammar reads `if` and
-- `match` as operands but not `select`.
pure func parse_control(state: ParseState, anchor: BlockAnchor, context: BodyContext) -> (ParseState, Recognition[Expression]):
	match state.current_kind():
		IfKeyword: parse_conditional(state, context, anchor)
		MatchKeyword: parse_match(state, context, anchor)
		SelectKeyword: parse_select(state, context, anchor)
		_: (state, Declined(state.stop_at(ExpressionSyntaxError)))


private pure func parse_conditional_statement(state: ParseState, context: BodyContext) -> (ParseState, StatementParse):
	(remaining, parsed) = parse_conditional(state, context, IndentedByLexer)
	match parsed:
		Recognized(expression): continue_control_statement(state, remaining, expression, context)
		Declined(stop): (state, UnsupportedStatement(stop))


private pure func continue_control_statement(entry: ParseState, state: ParseState, expression: Expression, context: BodyContext) -> (ParseState, StatementParse):
	(remaining, written, ending) = continue_control_expression(state, expression, anchored_at(entry.current_span()), context)
	match written:
		ParsedValue(value):
			match remaining.statement_boundary():
				AtBoundary: remaining.expression_statement(value.expression)
				PastBoundary(stop):
					if ending == AfterContinuationDedent or value.ends_in_control() or (value.ends_in_block_lambda() and block_expression_ends(remaining.current_kind())):
						remaining.expression_statement(value.expression)
					else:
						(entry, UnsupportedStatement(stop))
		UnsupportedValue(stop): (entry, UnsupportedStatement(stop))
		RejectedValue: (entry, UnsupportedStatement(remaining.rejected_stop(remaining, ExpressionSyntaxError)))


private record IfHead {
	keyword: Span,
	condition: Expression,
	then_block: Block
}


private record PendingElseIf {
	else_keyword: Span,
	head: IfHead
}


private pure func parse_conditional(state: ParseState, context: BodyContext, anchor: BlockAnchor) -> (ParseState, Recognition[Expression]):
	(after_head, head) = parse_if_link(state, context, anchor)
	match head:
		Declined(stop): (state, Declined(stop))
		Recognized(first):
			var out = after_head
			var pending: List[PendingElseIf] = []
			var tail: Option[ElseBranch] = None
			var end = first.then_block.span
			var declined: Option[StopPoint] = None
			var reading = out.current_kind() == ElseKeyword
			while reading and declined.is_none():
				else_keyword = out.current_span()
				after_else = out.advanced()
				if after_else.current_kind() == IfKeyword:
					(after_link, parsed) = parse_if_link(after_else, context, IndentedByLexer)
					match parsed:
						Recognized(link):
							pending = pending.append({ else_keyword = else_keyword, head = link })
							end = link.then_block.span
							out = after_link
							reading = out.current_kind() == ElseKeyword
						Declined(stop): declined = Some(stop)
				else if after_else.current_kind() == ColonSymbol:
					(after_block, block) = parse_block(after_else.advanced(), context, IndentedByLexer)
					match block:
						ParsedBlock(block):
							tail = Some({ keyword = else_keyword, body = ElseBlock(block) })
							end = block.span
							out = after_block
							reading = False
						UnsupportedBlock(stop): declined = Some(stop)
				else:
					declined = Some(after_else.stop_at(MalformedElse))
			match declined:
				Some(stop): (state, Declined(stop))
				None:
					if not out.control_operator_may_follow():
						(state, Declined(out.stop_at(OperatorAfterBlock)))
					else:
						for link in pending.reverse():
							span = link.head.keyword.span_covering(end)
							(minted, expression) = out.finished_else_if(span, { condition = link.head.condition, then_block = link.head.then_block, else_branch = tail })
							out = minted
							tail = Some({ keyword = link.else_keyword, body = ElseIf(expression) })
						(minted, expression) = out.finished_expression(first.keyword.span_covering(end), If({ condition = first.condition, then_block = first.then_block, else_branch = tail }))
						(minted, Recognized(expression))


private pure func parse_if_link(state: ParseState, context: BodyContext, anchor: BlockAnchor) -> (ParseState, Recognition[IfHead]):
	keyword = state.current_span()
	(after_header, condition) = parse_header(state.advanced(), context)
	match condition:
		Recognized(expression):
			(after_block, block) = parse_block(after_header, context, anchor)
			match block:
				ParsedBlock(block): (after_block, Recognized({ keyword = keyword, condition = expression, then_block = block }))
				UnsupportedBlock(stop): (state, Declined(stop))
		Declined(stop): (state, Declined(stop))


-- `match scrutinee:` and its cases, each a block or one same-line statement.
private pure func parse_match_statement(state: ParseState, context: BodyContext) -> (ParseState, StatementParse):
	(remaining, parsed) = parse_match(state, context, IndentedByLexer)
	match parsed:
		Recognized(expression): continue_control_statement(state, remaining, expression, context)
		Declined(stop): (state, UnsupportedStatement(stop))


private pure func parse_match(state: ParseState, context: BodyContext, anchor: BlockAnchor) -> (ParseState, Recognition[Expression]):
	keyword: Span = state.current_span()
	(after_header, scrutinee) = parse_header(state.advanced(), context)
	match scrutinee:
		Declined(stop):
			(state, Declined(stop))
		Recognized(subject):
			match after_header.block_start(anchor):
				NoBlockStart:
					(state, Declined(after_header.stop_at(MatchWithoutBlock)))
				BlockStartsAt(at_first_case):
					read_match_cases(state, at_first_case, keyword, subject, context)


-- The cases of a `match` up to its dedent. `state` is the entry state that an
-- unsupported case rolls back to.
private pure func read_match_cases(
	state: ParseState, at_first_case: ParseState, keyword: Span, subject: Expression, context: BodyContext,
) -> (ParseState, Recognition[Expression]):
	var out: ParseState = at_first_case
	var cases: List[MatchCase] = []
	var declined: Option[StopPoint] = None
	while declined.is_none() and out.current_kind() != DedentToken and out.current_kind() != EndOfFileToken:
		(after_case, parsed) = parse_case(out, context)
		match parsed:
			Recognized(parsed_case):
				cases = cases.append(parsed_case)
				out = after_case.skip_newlines()
			Declined(stop):
				declined = Some(stop)
	match declined:
		Some(stop):
			(state, Declined(stop))
		None:
			match cases:
				[first, ...rest]:
					if out.current_kind() != DedentToken:
						(state, Declined(out.stop_at(MatchNotClosed)))
					else if not out.advanced().control_operator_may_follow():
						(state, Declined(out.advanced().stop_at(OperatorAfterBlock)))
					else:
						(minted, expression) = out.advanced().finished_expression(keyword.span_covering(out.current_span()), Match(subject, [first].concat(rest)))
						(minted, Recognized(expression))
				_:
					(state, Declined(out.stop_at(MatchNotClosed)))


private pure func parse_case(state: ParseState, context: BodyContext) -> (ParseState, Recognition[MatchCase]):
	(after_pattern, pattern) = read_pattern(state)
	match pattern:
		Declined(stop):
			(state, Declined(stop))
		Recognized(pattern):
			if after_pattern.current_kind() != ColonSymbol:
				(state, Declined(after_pattern.stop_at(CaseWithoutColon)))
			else:
				after_colon: ParseState = after_pattern.advanced()
				if after_colon.current_kind() == NewlineToken:
					(after_block, block) = parse_block(after_colon, context, IndentedByLexer)
					match block:
						ParsedBlock(body):
							(after_block, Recognized({ pattern = pattern, body = CaseBlock(body), span = pattern.span.span_covering(body.span) }))
						UnsupportedBlock(stop):
							(state, Declined(stop))
				-- The frozen case reader takes a leading control as the whole
				-- case body; its next token belongs to the next case, not a
				-- binary tail of this expression.
				else if after_colon.current_kind() == IfKeyword or after_colon.current_kind() == MatchKeyword:
					(after_control, control) = parse_control(after_colon, PastExpressionAnchor(anchored_at(pattern.span)), context)
					match control:
						Recognized(expression):
							(after_statement, statement) = after_control.expression_statement(expression)
							match statement:
								ParsedStatement(written): (after_statement, Recognized({ pattern = pattern, body = CaseStatement(written), span = pattern.span.span_covering(written.span) }))
								UnsupportedStatement(stop): (state, Declined(stop))
						Declined(stop): (state, Declined(stop))
				else if after_colon.starts_nested_block():
					(state, Declined(after_colon.stop_at(NestedBlockInCaseLine)))
				else:
					(after_statement, statement) = parse_statement(after_colon, context)
					match statement:
						ParsedStatement(written):
							(after_statement, Recognized({ pattern = pattern, body = CaseStatement(written), span = pattern.span.span_covering(written.span) }))
						UnsupportedStatement(stop):
							(state, Declined(stop))


-- Inline If and Match use the pattern anchor above. The other block forms
-- retain their own frozen keyword/layout rules and remain unsupported here.
private pure func starts_nested_block(state: ParseState) -> Bool:
	match state.current_kind():
		IfKeyword | MatchKeyword | WhileKeyword | ForKeyword:
			True
		SelectKeyword | WithKeyword | ConcurrentKeyword | DebugKeyword:
			state.opens_block_form()
		_:
			False


-- Lambda parameters/types finish before the body, then the lambda owner.
-- The expression grammar counts the lambda nesting once at its entry.
pure func parse_lambda(state: ParseState, anchor: ExpressionAnchor) -> (ParseState, LambdaParse):
	(after_header, header) = parse_lambda_header(state)
	match header:
		Declined(stop): (state, UnsupportedLambda(stop))
		Recognized(read):
			(after_body, body) = parse_lambda_body(after_header, anchor)
			match body:
				Recognized(body):
					(minted, expression) = after_body.finished_expression(state.current_span().span_covering(body_span(body)), Lambda({ purity = read.purity, parameters = read.parameters, return_type = read.return_type, body = body }))
					(minted, ParsedLambda(expression))
				Declined(stop): (state, UnsupportedLambda(stop))


-- A completed lambda, or why it is not read. Concrete rather than Recognition:
-- the expression parser matches it across the import cycle with this module.
union LambdaParse:
	ParsedLambda(Expression)
	UnsupportedLambda(StopPoint)


-- What a lambda's header holds before its body.
private record LambdaHeader {
	purity: Purity,
	parameters: List[LambdaParameter],
	return_type: Option[WrittenType]
}


-- [pure] func(parameters) [-> R]: on one line. Hole parsing already owns
-- the token-run switch and restores the outer string after this expression.
private pure func parse_lambda_header(state: ParseState) -> (ParseState, Recognition[LambdaHeader]):
	after_pure: ParseState = if state.current_kind() == PureKeyword:
		state.advanced()
	else:
		state
	if after_pure.current_kind() != FuncKeyword or after_pure.peek_kind(1) != LeftParenSymbol:
		(state, Declined(state.stop_at(MalformedLambdaHeader)))
	else:
		(after_parameters, parameters) = parse_lambda_parameters(after_pure.advanced().advanced())
		match parameters:
			Declined(stop):
				(state, Declined(stop))
			Recognized(read):
				after_close: ParseState = after_parameters.advanced()
				if after_close.current_kind() == ArrowSymbol:
					(after_type, written) = after_close.advanced().read_type()
					match written:
						Declined(stop):
							(state, Declined(stop))
						Recognized(declared):
							state.lambda_header_ending(after_parameters, after_type, read, Some(declared))
				else:
					state.lambda_header_ending(after_parameters, after_close, read, None)


-- The header ends in `)` and `:`.
private pure func lambda_header_ending(
	state: ParseState, after_parameters: ParseState, after_return: ParseState,
	parameters: List[LambdaParameter], return_type: Option[WrittenType],
) -> (ParseState, Recognition[LambdaHeader]):
	if after_parameters.current_kind() != RightParenSymbol or after_return.current_kind() != ColonSymbol:
		(state, Declined(after_return.stop_at(MalformedLambdaHeader)))
	else:
		purity: Purity = if state.current_kind() == PureKeyword:
			PureFunction
		else:
			ImpureFunction
		(after_return.advanced(), Recognized({ purity = purity, parameters = parameters, return_type = return_type }))


-- `name [: T]` items to the closing parenthesis, a trailing comma allowed.
private pure func parse_lambda_parameters(state: ParseState) -> (ParseState, Recognition[List[LambdaParameter]]):
	var out: ParseState = state
	var parameters: List[LambdaParameter] = []
	var reading: Bool = out.current_kind() != RightParenSymbol
	var declined: Option[StopPoint] = None
	while reading and declined.is_none():
		(after_binder, binder) = parse_binder(out)
		match binder:
			Recognized(written):
				(after_annotation, annotation) = after_binder.parse_type_annotation()
				match annotation:
					InvalidAnnotation(stop):
						declined = Some(stop)
					Annotated(declared):
						parameters = parameters.append({ target = written, declared_type = Some(declared), span = binder_span(written).span_covering(declared.span) })
						out = after_annotation
					NoAnnotation:
						parameters = parameters.append({ target = written, declared_type = None, span = binder_span(written) })
						out = after_annotation
				if out.current_kind() == CommaSymbol:
					out = out.advanced()
					reading = out.current_kind() != RightParenSymbol
				else:
					reading = False
			Declined(stop):
				declined = Some(stop)
	match declined:
		Some(stop):
			(state, Declined(stop))
		None:
			(out, Recognized(parameters))


-- A block on the lines after the colon, or an expression on its line. An
-- expression body ends where the expression does: the enclosing construct
-- decides what may follow.
private pure func parse_lambda_body(state: ParseState, anchor: ExpressionAnchor) -> (ParseState, Recognition[Body]):
	if state.current_kind() == NewlineToken:
		(remaining, parsed) = parse_block(state, OutsideLoop, PastExpressionAnchor(anchor))
		match parsed:
			ParsedBlock(block):
				(remaining, Recognized(BlockBody(block)))
			UnsupportedBlock(stop):
				(state, Declined(stop))
	else:
		(remaining, parsed) = parse_anchored_expression(state, OutsideLoop)
		match parsed:
			ParsedValue(value):
				(remaining, Recognized(ExpressionBody(value.expression)))
			UnsupportedValue(stop):
				(state, Declined(stop))
			RejectedValue:
				(state, Declined(remaining.rejected_stop(remaining, ExpressionSyntaxError)))


-- Local functions: `func name(...)` or `pure func name(...)` as a statement.
-- Header children finish once, then the body, local owner and statement.
private pure func parse_local_function(state: ParseState) -> (ParseState, StatementParse):
	start = state.current_span()
	purity: Purity = if state.current_kind() == PureKeyword:
		PureFunction
	else:
		ImpureFunction
	at_keyword = if purity == PureFunction:
		state.advanced()
	else:
		state
	(after_header, parsed) = parse_function_head(at_keyword, PublicVisibility, None, [], purity, start)
	match parsed:
		RejectedFunctionHead: (state, UnsupportedStatement(state.rejected_stop(after_header, LocalFunctionHeaderRejected)))
		ParsedFunctionHead(head):
			match head.body_presence:
				BodyFollows:
					(after_body, body) = complete_body(after_header)
					match body:
						Recognized(body):
							header = head.header
							span = header.header_span.span_covering(body.span)
							(declared, function) = after_body.finished_local_function({ signature = header.signature, type_parameters = header.type_parameters, constraints = header.constraints, body = Some(body.body) }, span)
							declared.completed_statement(span, LocalFunctionStatement(function))
						Declined(stop): (state, UnsupportedStatement(stop))
				_: (state, UnsupportedStatement(state.stop_at(BodylessFunction)))


-- The statement the soft keyword at the cursor opens: it has the shape of
-- one of the four block forms. A function of its own, so that the frame of
-- the statement dispatcher, which is on the native stack once per level of
-- nesting, stays small (section 3.14).
private pure func parse_block_form_statement(state: ParseState, context: BodyContext) -> (ParseState, StatementParse):
	(remaining, parsed) = match state.current_kind():
		SelectKeyword: parse_select(state, context, IndentedByLexer)
		WithKeyword: parse_with(state, context)
		ConcurrentKeyword: parse_concurrent(state, context)
		DebugKeyword: parse_debug(state, context)
		_: (state, Declined(state.stop_at(ExpressionSyntaxError)))
	match parsed:
		Recognized(expression): remaining.expression_statement(expression)
		Declined(stop): (state, UnsupportedStatement(stop))


-- `select`, `with`, `concurrent` and `debug`. Each is a keyword, a header that
-- ends in a colon on its own line, and indented blocks closed by dedents, so
-- each ends where the next statement may already begin.

private fixed union ConcurrentParameterOwner:
	ConcurrentBlockOwner
	ConcurrentForOwner


private fixed union ConcurrentParameterName:
	ConcurrentCount
	ConcurrentTimeout
	ConcurrentUnknown


---
The spelling of `concurrent`'s thread-count parameter. The frozen grammar
matches parameter names by text, so the recognizer does too.
---
private MAX_THREADS_PARAMETER: String = "max_threads"


-- The required width of a concurrently-for loop.
private LIMIT_PARAMETER: String = "limit"


---
The spelling of the parameter that bounds how long a `concurrent` block runs.
---
private TIMEOUT_PARAMETER: String = "timeout"


private pure func binder_span(binder: BindingTarget) -> Span:
	match binder:
		BindsName(name): name.name.span
		DiscardsValue(span): span


-- Whether the `:` that ends a header is at the cursor.
private pure func at_header_colon(state: ParseState) -> Bool:
	state.current_kind() == ColonSymbol


-- The indented block after a header's colon.
private pure func parse_header_block(state: ParseState, context: BodyContext) -> (ParseState, Recognition[Block]):
	(remaining, block) = parse_block(state, context, IndentedByLexer)
	match block:
		ParsedBlock(block): (remaining, Recognized(block))
		UnsupportedBlock(stop): (state, Declined(stop))


-- The block that ends a `with`, `concurrent` or `debug`: the token after its
-- dedent must not continue it.
private pure func parse_closing_block(state: ParseState, context: BodyContext) -> (ParseState, Recognition[Block]):
	(remaining, block) = parse_header_block(state, context)
	match block:
		Recognized(_):
			if block_expression_ends(remaining.current_kind()):
				(remaining, block)
			else:
				(state, Declined(remaining.stop_at(OperatorAfterBlock)))
		Declined(_):
			(state, block)


-- Select.


-- `select:` and its arms, each a header and a block. The cursor is at a
-- `select` that opens a block form, so its colon follows.
private pure func parse_select(state: ParseState, context: BodyContext, anchor: BlockAnchor) -> (ParseState, Recognition[Expression]):
	keyword: Span = state.current_span()
	after_colon: ParseState = state.advanced().advanced()
	match after_colon.block_start(anchor):
		NoBlockStart:
			(state, Declined(after_colon.stop_at(SelectWithoutArms)))
		BlockStartsAt(at_first_arm):
			read_select_arms(state, at_first_arm, keyword, context)


-- The arms of a `select` up to its dedent. `state` is the entry state that an
-- unsupported arm rolls back to.
private pure func read_select_arms(
	state: ParseState, at_first_arm: ParseState, keyword: Span, context: BodyContext,
) -> (ParseState, Recognition[Expression]):
	var out: ParseState = at_first_arm
	var arms: List[SelectArm] = []
	var declined: Option[StopPoint] = None
	while declined.is_none() and out.current_kind() != DedentToken and out.current_kind() != EndOfFileToken:
		(after_arm, parsed) = parse_select_arm(out, context)
		match parsed:
			Recognized(arm):
				arms = arms.append(arm)
				out = after_arm.skip_newlines()
			Declined(stop):
				declined = Some(stop)
	match declined:
		Some(stop):
			(state, Declined(stop))
		None:
			match arms:
				[first, ...rest]:
					if out.current_kind() != DedentToken:
						(state, Declined(out.stop_at(SelectNotClosed)))
					else if not block_expression_ends(out.advanced().current_kind()):
						(state, Declined(out.advanced().stop_at(OperatorAfterBlock)))
					else:
						(minted, expression) = out.advanced().finished_expression(keyword.span_covering(out.current_span()), Select([first].concat(rest)))
						(minted, Recognized(expression))
				_:
					(state, Declined(out.stop_at(SelectNotClosed)))


private pure func parse_select_arm(state: ParseState, context: BodyContext) -> (ParseState, Recognition[SelectArm]):
	start: Span = state.current_span()
	(after_header, header) = parse_select_arm_header(state, context)
	match header:
		Recognized(kind):
			(after_body, body) = parse_header_block(after_header, context)
			match body:
				Recognized(block):
					(after_body, Recognized({ kind = kind, body = block, span = start.span_covering(block_span(block)) }))
				Declined(stop):
					(state, Declined(stop))
		Declined(stop):
			(state, Declined(stop))


-- `sealed channel:`, `_ after timeout:` or `name from channel:`. A binder
-- named `sealed` starts its arm form; `_ after` starts a timeout arm.
-- Other soft words remain receive binders, while `from` stays reserved.
private pure func parse_select_arm_header(state: ParseState, context: BodyContext) -> (ParseState, Recognition[SelectArmKind]):
	match state.current_kind():
		SealedKeyword:
			(after_channel, channel) = parse_header(state.advanced(), context)
			(after_channel, channel.mapped(pure func(written): SealedArm(written)))
		UnderscoreSymbol:
			if state.peek_kind(1) == AfterKeyword:
				(after_timeout, timeout) = parse_header(state.advanced().advanced(), context)
				(after_timeout, timeout.mapped(pure func(written): AfterArm(written)))
			else:
				parse_receive_arm_header(state, context)
		IdentifierToken | DebugKeyword | WithKeyword | ConcurrentKeyword | ConcurrentlyKeyword | SelectKeyword | AfterKeyword | OnKeyword:
			parse_receive_arm_header(state, context)
		_:
			(state, Declined(state.stop_at(SelectArmMalformed)))


private pure func parse_receive_arm_header(state: ParseState, context: BodyContext) -> (ParseState, Recognition[SelectArmKind]):
	(after_binder, binder) = parse_binder(state)
	match binder:
		Recognized(target):
			if after_binder.current_kind() == FromKeyword:
				(after_channel, channel) = parse_header(after_binder.advanced(), context)
				(after_channel, channel.mapped(pure func(written): ReceiveArm(target, written)))
			else:
				(state, Declined(after_binder.stop_at(SelectArmMalformed)))
		Declined(_):
			(state, Declined(state.stop_at(SelectArmMalformed)))


-- A with header contains completed binder/type/value children.
private fixed union WithOperator:
	AcquireWithValue
	AcquireWithTry


private pure func parse_with(state: ParseState, context: BodyContext) -> (ParseState, Recognition[Expression]):
	(after_header, acquisition) = parse_with_header(state.advanced(), context)
	match acquisition:
		Recognized(acquisition):
			(after_body, body) = parse_closing_block(after_header, context)
			match body:
				Recognized(block):
					(minted, expression) = after_body.finished_expression(state.current_span().span_covering(block.span), With({ acquisition = acquisition, body = block }))
					(minted, Recognized(expression))
				Declined(stop): (state, Declined(stop))
		Declined(stop): (state, Declined(stop))


private pure func parse_with_header(state: ParseState, context: BodyContext) -> (ParseState, Recognition[WithAcquisition]):
	(after_binder, binder) = parse_binder(state)
	(after_annotation, annotation) = after_binder.parse_type_annotation()
	operator: Option[WithOperator] = match after_annotation.current_kind():
		EqualSymbol: Some(AcquireWithValue)
		QuestionEqualsSymbol: Some(AcquireWithTry)
		_: None
	match binder:
		Recognized(target):
			match annotation:
				InvalidAnnotation(stop): (state, Declined(stop))
				NoAnnotation: after_annotation.parse_written_acquisition(target, None, operator, context)
				Annotated(declared): after_annotation.parse_written_acquisition(target, Some(declared), operator, context)
		Declined(_): (state, Declined(state.stop_at(WithBindingMalformed)))


private pure func parse_written_acquisition(state: ParseState, target: BindingTarget, declared: Option[WrittenType], operator: Option[WithOperator], context: BodyContext) -> (ParseState, Recognition[WithAcquisition]):
	match operator:
		None: (state, Declined(state.stop_at(WithBindingMalformed)))
		Some(kind):
			(after_value, parsed) = parse_anchored_expression(state.advanced(), context)
			match parsed:
				ParsedValue(value):
					(after_error, on_error) = if kind == AcquireWithTry:
						parse_with_error_map(after_value, context)
					else:
						no_error_map: Recognition[Option[ErrorMap]] = Recognized(None)
						(after_value, no_error_map)
					match on_error:
						Declined(stop): (state, Declined(stop))
						Recognized(error_map):
							if not after_error.at_header_colon():
								(state, Declined(after_error.stop_at(WithHeaderWithoutColon)))
							else:
								end: Span = match error_map:
									Some(mapped): mapped.span
									None: value.expression.span
								span = binder_span(target).span_covering(end)
								acquisition: WithAcquisition = if kind == AcquireWithValue:
									WithValue({ target = target, declared_type = declared, value = value.expression, span = span })
								else:
									WithTry({ target = target, declared_type = declared, value = value.expression, on_error = error_map, span = span })
								(after_error.advanced(), Recognized(acquisition))
				UnsupportedValue(stop): (state, Declined(stop))
				RejectedValue: (state, Declined(after_value.rejected_stop(after_value, ExpressionSyntaxError)))


private pure func parse_with_error_map(state: ParseState, context: BodyContext) -> (ParseState, Recognition[Option[ErrorMap]]):
	if state.current_kind() != OnKeyword:
		no_error_map: Recognition[Option[ErrorMap]] = Recognized(None)
		(state, no_error_map)
	else:
		(after_binder, binder) = parse_binder(state.advanced())
		match binder:
			Recognized(target):
				if after_binder.current_kind() != FatArrowSymbol:
					(state, Declined(after_binder.stop_at(WithErrorMapMalformed)))
				else:
					(after_value, parsed) = parse_anchored_expression(after_binder.advanced(), context)
					match parsed:
						ParsedValue(value): (after_value, Recognized(Some({ target = target, value = value.expression, span = binder_span(target).span_covering(value.expression.span) })))
						UnsupportedValue(stop): (state, Declined(stop))
						RejectedValue: (state, Declined(after_value.rejected_stop(after_value, ExpressionSyntaxError)))
			Declined(_): (state, Declined(state.advanced().stop_at(WithErrorMapMalformed)))


-- Concurrent.
-- `concurrent:` or `concurrent(max_threads: n, timeout: t):`. Its block is
-- outside every loop: a `break` in it cannot leave the enclosing loop.
private pure func parse_concurrent(state: ParseState, context: BodyContext) -> (ParseState, Recognition[Expression]):
	after_keyword: ParseState = state.advanced()
	(after_parameters, parameters) = after_keyword.parse_optional_concurrent_parameters(context)
	match parameters:
		Recognized(written):
			if after_parameters.at_header_colon():
				(after_body, body) = parse_closing_block(after_parameters.advanced(), OutsideLoop)
				match body:
					Recognized(block):
						(minted, expression) = after_body.finished_expression(state.current_span().span_covering(block.span), ConcurrentBlock({ max_threads = written.count, timeout = written.timeout, body = block }))
						(minted, Recognized(expression))
					Declined(stop):
						(state, Declined(stop))
			else:
				(state, Declined(after_parameters.stop_at(ConcurrentHeaderWithoutColon)))
		Declined(stop):
			(state, Declined(stop))


-- The parameters after `concurrent`, or none when no parenthesis follows.
private record ConcurrentParameters {
	count: Option[CountParameter],
	timeout: Option[TimeoutParameter]
}


private pure func parse_optional_concurrent_parameters(state: ParseState, context: BodyContext) -> (ParseState, Recognition[ConcurrentParameters]):
	if state.current_kind() == LeftParenSymbol:
		parse_concurrent_parameters(state, ConcurrentBlockOwner, context)
	else:
		no_parameters: ConcurrentParameters = { count = None, timeout = None }
		(state, Recognized(no_parameters))


-- `(name: value, ...)` from opening through closing parenthesis: at least
-- one parameter, the owner's count and `timeout` each at most once, with an
-- optional trailing comma. Required loop limits are checked by the loop owner.
private pure func parse_concurrent_parameters(state: ParseState, owner: ConcurrentParameterOwner, context: BodyContext) -> (ParseState, Recognition[ConcurrentParameters]):
	var out: ParseState = state.advanced()
	var count_parameter: Option[CountParameter] = None
	var timeout: Option[TimeoutParameter] = None
	var declined: Option[StopPoint] = None
	var reading: Bool = True
	if out.current_kind() == RightParenSymbol:
		declined = Some(out.stop_at(ConcurrentParametersMalformed))
		reading = False
	while reading and declined.is_none():
		(after_parameter, parameter) = parse_concurrent_parameter(out, owner, context)
		match parameter:
			ParsedCountParameter(count):
				if count_parameter.is_some():
					declined = Some(out.stop_at(ConcurrentParameterRepeated))
				count_parameter = Some(count)
			ParsedTimeoutParameter(written):
				if timeout.is_some():
					declined = Some(out.stop_at(ConcurrentParameterRepeated))
				timeout = Some(written)
			DeclinedParameter(stop):
				declined = Some(stop)
		out = after_parameter
		if out.current_kind() == CommaSymbol:
			out = out.advanced()
			reading = out.current_kind() != RightParenSymbol
		else:
			reading = False
	match declined:
		Some(stop):
			(state, Declined(stop))
		None:
			if out.current_kind() == RightParenSymbol:
				(out.advanced(), Recognized({ count = count_parameter, timeout = timeout }))
			else:
				(state, Declined(out.stop_at(ConcurrentParametersMalformed)))


private union ConcurrentParameterParse:
	ParsedCountParameter(CountParameter)
	ParsedTimeoutParameter(TimeoutParameter)
	DeclinedParameter(StopPoint)


private pure func parse_concurrent_parameter(state: ParseState, owner: ConcurrentParameterOwner, context: BodyContext) -> (ParseState, ConcurrentParameterParse):
	if state.current_kind() != IdentifierToken:
		(state, DeclinedParameter(state.stop_at(ConcurrentParametersMalformed)))
	else:
		(after_name, name) = state.consume_referenced_name(NameInConcurrentNamedParameter)
		if after_name.current_kind() != ColonSymbol:
			(state, DeclinedParameter(after_name.stop_at(ConcurrentParametersMalformed)))
		else:
			match concurrent_parameter_name(after_name.spellings(), name, owner):
				ConcurrentCount: parse_count_parameter(state, after_name.advanced(), name, context)
				_:
					(after_value, parsed) = parse_anchored_expression(after_name.advanced(), context)
					match parsed:
						ParsedValue(value):
							if concurrent_parameter_name(after_value.spellings(), name, owner) == ConcurrentTimeout:
								(after_value, ParsedTimeoutParameter({ value = value.expression, name_span = name.span, span = name.span.span_covering(value.expression.span) }))
							else:
								(state, DeclinedParameter(state.stop_at(ConcurrentParameterUnknown)))
						UnsupportedValue(stop): (state, DeclinedParameter(stop))
						RejectedValue: (state, DeclinedParameter(after_value.stop_at(ExpressionSyntaxError)))


-- Counts are checked values, not expressions. Only the literal/grouping
-- grammar can accept; a generic trial supplies the existing stop for every
-- other shape and is discarded whole, never merged into the accepted state.
private union CountLiteralParse:
	ParsedCountLiteral(PositiveCount, Span)
	NotCountLiteral


private pure func parse_count_parameter(state: ParseState, at_value: ParseState, name: WrittenName, context: BodyContext) -> (ParseState, ConcurrentParameterParse):
	(after_literal, literal) = parse_count_literal(at_value)
	match literal:
		ParsedCountLiteral(count, span):
			if after_literal.current_kind() == CommaSymbol or after_literal.current_kind() == RightParenSymbol:
				(after_literal, ParsedCountParameter({ count = count, name_span = name.span, span = name.span.span_covering(span) }))
			else:
				state.declined_count_trial(at_value, context)
		NotCountLiteral: state.declined_count_trial(at_value, context)


private pure func declined_count_trial(state: ParseState, at_value: ParseState, context: BodyContext) -> (ParseState, ConcurrentParameterParse):
	(after_value, trial) = parse_anchored_expression(at_value, context)
	match trial:
		ParsedValue(_): (state, DeclinedParameter(state.stop_at(ConcurrentCountNotLiteral)))
		UnsupportedValue(stop): (state, DeclinedParameter(stop))
		RejectedValue: (state, DeclinedParameter(after_value.stop_at(ExpressionSyntaxError)))


private pure func refused_count(state: ParseState) -> CountLiteralParse:
	NotCountLiteral


private pure func parse_count_literal(state: ParseState) -> (ParseState, CountLiteralParse):
	if state.current_kind() == LeftParenSymbol:
		state.nested(refused_count, pure func(inside):
			(after_inner, inner) = parse_count_literal(inside.advanced())
			match inner:
				ParsedCountLiteral(count, span):
					if after_inner.current_kind() == RightParenSymbol:
						(after_inner.advanced(), ParsedCountLiteral(count, inside.current_span().span_covering(after_inner.current_span())))
					else:
						(state, NotCountLiteral)
				NotCountLiteral: (state, NotCountLiteral)
		)
	else if state.current_kind() == IntLiteralToken:
		match state.current_literal():
			Some(IntegerValue(magnitude)):
				match positive_count(magnitude):
					Some(count): (state.advanced(), ParsedCountLiteral(count, state.current_span()))
					None: (state, NotCountLiteral)
			_: (state, NotCountLiteral)
	else:
		(state, NotCountLiteral)


private pure func concurrent_parameter_name(spellings: Spellings, name: WrittenName, owner: ConcurrentParameterOwner) -> ConcurrentParameterName:
	text: Option[String] = spellings.spelling_text(name.spelling)
	count_name: String = match owner:
		ConcurrentBlockOwner: MAX_THREADS_PARAMETER
		ConcurrentForOwner: LIMIT_PARAMETER
	if text == Some(count_name):
		ConcurrentCount
	else if text == Some(TIMEOUT_PARAMETER):
		ConcurrentTimeout
	else:
		ConcurrentUnknown


-- Debug.
-- `debug:` and its block. The cursor is at a `debug` that opens a block form,
-- so its colon follows.
private pure func parse_debug(state: ParseState, context: BodyContext) -> (ParseState, Recognition[Expression]):
	(after_body, body) = parse_closing_block(state.advanced().advanced(), context)
	match body:
		Recognized(block):
			(minted, expression) = after_body.finished_expression(state.current_span().span_covering(block.span), DebugBlock(block))
			(minted, Recognized(expression))
		Declined(stop): (state, Declined(stop))
