---
pure func expect_newline(
	builder: DiscoveryBuilder,
	construct: NewlineConstruct,
) -> DiscoveryBuilder:
	if builder.current_kind() == NewlineToken:
		builder.advance_token()
	else:
		builder.report_expected(ExpectedNewline(construct))


