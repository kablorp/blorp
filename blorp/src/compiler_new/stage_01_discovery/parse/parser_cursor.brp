---
pure func expect_comma(builder: DiscoveryBuilder, construct: CommaConstruct) -> DiscoveryBuilder:
	if builder.current_kind() == CommaSymbol:
		builder.advance_token()
	else:
		builder.report_expected(ExpectedComma(construct))


