---
Advances past a `kind` keyword token, or reports a keyword missing in
`construct` without advancing.
---
pure func expect_keyword_token(
	builder: DiscoveryBuilder,
	kind: TokenKind,
	construct: KeywordConstruct,
) -> DiscoveryBuilder:
	if builder.current_kind() == kind:
		builder.advance_token()
	else:
		builder.report_expected(ExpectedKeyword(construct))


---
Reports `code` and, unless the cursor is at a soft boundary, skips the
offending token: the shared recovery for a missing required item.
---
pure func report_and_recover(builder: DiscoveryBuilder, code: PlainSyntaxCode) -> DiscoveryBuilder:
	boundary: Bool = builder.at_soft_boundary()
	out: DiscoveryBuilder = builder.report_at_current(code)

	if not boundary:
		out.advance_token()
	else:
		out


---
`report_and_recover` for a missing name in `construct`.
---
pure func report_name_and_recover(
	builder: DiscoveryBuilder,
	construct: NameConstruct,
) -> DiscoveryBuilder:
	boundary: Bool = builder.at_soft_boundary()
	out: DiscoveryBuilder = builder.report_expected(ExpectedName(construct))

	if not boundary:
		out.advance_token()
	else:
		out


-- Names.
---
The seeded name index of a keyword kind, or `None` for a kind that is not a
keyword.
---
pure func keyword_name_index(kind: TokenKind) -> Option[Int]:
	var found: Option[Int] = None
	var position: Int = 0

	for keyword in KEYWORD_KINDS_IN_SEEDED_ORDER:
		if keyword == kind:
			found = Some(FIRST_KEYWORD_NAME_INDEX + position)
			break

		position += 1

	found


---
Keywords that may be written where a name belongs; their name is their
seeded spelling.
---
pure func is_soft_keyword(kind: TokenKind) -> Bool:
	match kind:
		DebugKeyword | WithKeyword | ConcurrentKeyword | ConcurrentlyKeyword | SelectKeyword | AfterKeyword | SealedKeyword | OnKeyword:
			True
		_:
			False


---
The name of the current token when it is a name: an identifier, or a soft
keyword spelled as one.
---
pure func current_name(builder: DiscoveryBuilder) -> Option[NameId]:
	token: Token = builder.current_token()

	if token.kind == IdentifierToken:
		Some(name_id_at_row(token.payload))
	else if token.kind.is_soft_keyword():
		token.kind
			.keyword_name_index()
			.map(name_id_at_row)
	else:
		None


---
The name a name-expecting routine records for the current token: its name
when it is one, the keyword's spelling when it is a reserved keyword (which
`consume_declared_name` reports), else the empty name.
---
pure func declared_name_at_cursor(builder: DiscoveryBuilder) -> NameId:
	match builder.current_name():
		Some(name):
			name
		None:
			match keyword_name_index(builder.current_kind()):
				Some(index):
					name_id_at_row(index)
				None:
					name_id_at_row(EMPTY_NAME_INDEX)


---
Consumes a name that introduces a new binding or declaration, as `construct` (the thing named: a function, a field, ...). A reserved
keyword there is reported and consumed as if it were the name; anything else
that is not a name is reported and skipped unless it is a soft boundary.
Read the name first with `declared_name_at_cursor`.
---
pure func consume_declared_name(
	builder: DiscoveryBuilder,
	construct: NameConstruct,
) -> DiscoveryBuilder:
	if (
		builder
			.current_name()
			.is_some()
	):
		builder.advance_token()
	else:
		match keyword_name_index(builder.current_kind()):
			Some(keyword):
				builder
					.report_diagnostic_at_current(ReservedKeywordAsName(name_id_at_row(keyword)))
					.advance_token()
			None:
				builder.report_name_and_recover(construct)


---
The name a reference-position routine records: the current token's name, or
the empty name when it is not one (`consume_referenced_name` reports it).
---
pure func referenced_name_at_cursor(builder: DiscoveryBuilder) -> NameId:
	match builder.current_name():
		Some(name):
			name
		None:
			name_id_at_row(EMPTY_NAME_INDEX)


---
Consumes a name in a reference position (a trait, bound or supertrait name):
anything that is not a name, keywords included, is reported and skipped
unless it is a soft boundary.
---
pure func consume_referenced_name(
	builder: DiscoveryBuilder,
	construct: NameConstruct,
) -> DiscoveryBuilder:
	if (
		builder
			.current_name()
			.is_some()
	):
		builder.advance_token()
	else:
		builder.report_name_and_recover(construct)


---
The name a binder position records: `_` (the discard name) or a declared name.
---
pure func binder_name_at_cursor(builder: DiscoveryBuilder) -> NameId:
	if builder.at(UnderscoreSymbol):
		name_id_at_row(DISCARD_NAME_INDEX)
	else:
		builder.declared_name_at_cursor()


---
Consumes a binder: `_`, or a declared name (see `consume_declared_name`).
---
pure func consume_binder_name(
	builder: DiscoveryBuilder,
	construct: NameConstruct,
) -> DiscoveryBuilder:
	if builder.at(UnderscoreSymbol):
		builder.advance_token()
	else:
		builder.consume_declared_name(construct)
