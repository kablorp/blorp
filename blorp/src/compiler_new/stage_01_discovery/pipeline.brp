-- The discovery stage, in order:
--
--   1. roots, in the order given;
--   2. implicit modules, in the order given (the prelude set, and for tests
--      the test runtime), as the existing front end seeds them after the
--      roots;
--   3. imports, breadth first: every import of a module in the order the
--      module was loaded and, within a module, in source order; each module
--      is loaded once per canonical path;
--   4. freeze, behind the table invariants.
--
-- Each module is lexed, admitted and parsed into the builder as it is loaded.
-- Where a step's mechanics live: `sources/module_graph` (resolving requests
-- and the walk state), `sources/source_admission`, `lex/` (`lexer`
-- drives the scan into a `LexedModule`; `layout`, `string_literals`,
-- `interpolation`, `char_literals` and `scan_support` hold its parts),
-- `parse/lexed_bridge` (copies the lexed module into the builder),
-- `parse/declaration_parser` (with `parse/body_parser` and the modules under it
-- for function bodies), `tables/builder` (the tables, with `ids`, `rows`
-- and `node_builder`) and
-- `tables/invariants` and its folder (checked by `freeze`). The result is the
-- `tables/frontend_tables` value `freeze` returns; `diagnostics/render` turns
-- the diagnostic rows in it into text.
--
-- The builder is handed on from each step to the next and never travels
-- inside the import queue or any other value (see the builder threading rules
-- in `tables/builder`).
import:
	debug as dbg
	fs: DirectoryListing
	lex/lexed_module: LexedModule
	lex/lexer: lex_module
	parse/declaration_parser: parse_module_declarations
	parse/lexed_bridge: bridge_lexed_module
	sources/module_graph:
		ImportQueue,
		ModuleRequester(RequestedByImport, RequestedByRoot, RequestedImplicitly),
		RequestResolution(LoadSource, ModuleAlreadyLoaded, Unresolved),
		advance,
		empty_import_queue,
		enqueue_imports_of_loaded_module,
		next_pending_import,
		reach_of,
		record_module_package,
		record_target,
		report_failure,
		resolve_implicit,
		resolve_import,
		resolve_root,
	sources/source_admission: admit_source_with_line_starts, intern_path, interned_path_id
	sources/source_provider:
		RootRequest,
		SourceCandidate,
		SourceLookupRoots,
		SourceProvider,
		origin_kind,
		user_root,
	tables/builder:
		DiscoveryBuilder,
		ModuleOpening,
		close_module,
		empty_discovery_builder,
		next_module_id,
		open_module,
		opened_module,
	tables/frontend_tables: FreezeOutcome, freeze
	tables/ids: ModuleId, PathId, module_id_index
	tables/row_kinds: ModuleReach


---
The modules every compilation loads without an import.

The existing front end seeds `COMPILER_FRONTEND_IMPLICIT_MODULE_PATHS`
(`prelude` and `tuple`, in `stage_04_modules/frontend_graph_service`), and for
`blorp test` also `TEST_RUNTIME_MODULE` (`test`). This stage must not import
the old compiler, so `compiler_implicit_modules` and `test_implicit_modules`
restate them; the two must agree for as long as both front ends exist. Each is
a standard-library module name, loaded right after the roots and before any
import so module order matches the existing front end. Everything else the
prelude needs (`option`, `result`, ...) arrives through these modules' own
imports.
---
record ImplicitModules {
	module_names: List[String]
}


PRELUDE_MODULE_NAME: String = "prelude"

TUPLE_MODULE_NAME: String = "tuple"

TEST_RUNTIME_MODULE_NAME: String = "test"


---
The implicit modules of compiling or checking a program.
---
pure func compiler_implicit_modules() -> ImplicitModules:
	{module_names = [PRELUDE_MODULE_NAME, TUPLE_MODULE_NAME]}


---
The implicit modules of building a program's tests: the compiler's, then the
test runtime.
---
pure func test_implicit_modules() -> ImplicitModules:
	{module_names = [PRELUDE_MODULE_NAME, TUPLE_MODULE_NAME, TEST_RUNTIME_MODULE_NAME]}


---
Discovers every module reachable from `roots` (source paths of user modules)
and from the `implicit` modules through `provider`, then freezes the tables.
An implicit module that a root already is, or that an earlier request loaded,
is not loaded twice.
---
func discover[Provider:SourceProvider](
	provider: Provider,
	lookup: SourceLookupRoots,
	roots: List[String],
	implicit: ImplicitModules,
) -> FreezeOutcome:
	discover_placed_roots(
		provider,
		lookup,
		roots.map(pure func(path): user_root(path)),
		implicit,
	)


---
`discover` for roots whose placement the caller states: a root in the
standard library, a native package or a source package is recorded and
resolved as a module there.
---
func discover_placed_roots[Provider:SourceProvider](
	provider: Provider,
	lookup: SourceLookupRoots,
	roots: List[RootRequest],
	implicit: ImplicitModules,
) -> FreezeOutcome:
	var builder: DiscoveryBuilder = empty_discovery_builder()
	var listings: Dict[String, DirectoryListing] = {}
	var queue: ImportQueue = empty_import_queue()

	for root_request in roots:
		request_path: PathId = builder.interned_path_id(root_request.path)
		builder = builder.intern_path(root_request.path)
		(listed, resolution) = provider.resolve_root(builder, listings, root_request)
		listings = listed
		loaded: ModuleId = builder.next_module_id()
		builder = builder.settle_request(RequestedByRoot(request_path), loaded, resolution)
		queue = queue.enqueue_imports_of_loaded_module(builder, loaded, resolution)

	for module_name in implicit.module_names:
		request_path: PathId = builder.interned_path_id(module_name)
		builder = builder.intern_path(module_name)
		(listed, resolution) = provider.resolve_implicit(lookup, builder, listings, module_name)
		listings = listed
		loaded: ModuleId = builder.next_module_id()
		builder = builder.settle_request(RequestedImplicitly(request_path), loaded, resolution)
		queue = queue.enqueue_imports_of_loaded_module(builder, loaded, resolution)

	while True:
		match queue.next_pending_import():
			Some(entry):
				(listed, resolution) = provider.resolve_import(lookup, builder, listings, entry)
				listings = listed
				loaded: ModuleId = builder.next_module_id()
				builder = builder.settle_request(
					RequestedByImport(entry.import_id),
					loaded,
					resolution,
				)
				queue = queue.enqueue_imports_of_loaded_module(builder, loaded, resolution)
				queue = queue.advance()
			None:
				-- The queue is drained: every import found has been resolved.
				break

	builder.freeze()


---
Carries out what a request's resolution says: loads the source as module
`loaded` (the id `next_module_id` gave before this call), or records the
module already loaded as the request's target, or reports why none was found.
---
private pure func settle_request(
	builder: DiscoveryBuilder,
	requester: ModuleRequester,
	loaded: ModuleId,
	resolution: RequestResolution,
) -> DiscoveryBuilder:
	match resolution:
		LoadSource(candidate, text):
			builder
				.load_module(candidate, requester.reach_of(), text)
				.record_target(requester, loaded)
		ModuleAlreadyLoaded(module):
			builder.record_target(requester, module)
		Unresolved(failure):
			builder.report_failure(requester, failure)


---
One module: lex its text, admit its source, open the module, bridge the lexed
module into the builder, parse, and close it, which appends the module's row
with its blocks ended over the rows that lexing and parsing appended. The text
is lexed first, as the module `next_module_id` names, because its line starts
are part of admitting the source.
---
pure func load_module(
	builder: DiscoveryBuilder,
	candidate: SourceCandidate,
	reach: ModuleReach,
	text: String,
) -> DiscoveryBuilder:
	lexed: LexedModule = lex_module(builder.next_module_id(), text)
	admitted: DiscoveryBuilder = builder.admit_source_with_line_starts(
		candidate.path,
		text,
		lexed.line_starts,
	)
	opening: ModuleOpening = admitted.open_module(candidate.placement.origin_kind(), reach)
	module: ModuleId = module_opened_as_lexed(opening.opened_module(), lexed.module)
	admitted
		.record_module_package(module, candidate.placement)
		.bridge_lexed_module(lexed)
		.parse_module_declarations(module)
		.close_module(opening)


---
`opened`, the module `open_module` opened, after a debug-build check that it is
the module the text was lexed as: the lexer's spans and spellings name the id
`next_module_id` gave, so a module opened under another id would carry
another module's sources and spellings. A function of the two ids that
returns the opened one, so that no bare guard call sits in the load chain.
---
private pure func module_opened_as_lexed(opened: ModuleId, lexed: ModuleId) -> ModuleId:
	debug:
		if opened.module_id_index() != lexed.module_id_index():
			dbg.error("a module was opened under a different id than the one its text was lexed as")

	opened
