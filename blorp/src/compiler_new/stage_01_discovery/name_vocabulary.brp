---
Spellings the discovery parser compares by `NameId` that the existing
compiler does not synthesize: the function annotations, the removed
`into` conversion word and the `concurrent(max_threads: N)` parameter name. They are seeded after `SEEDED_NAME_SPELLINGS`, so
the shared vocabulary keeps its ids and the adapter's equality check covers
only that shared prefix.
---
DISCOVERY_NAME_SPELLINGS: List[String] = [
	"tail_recursive",
	"no_copy",
	"debug_only",
	"resource_result_ordinary",
	"into",
	"max_threads",
]

---
Every spelling a discovery name table is seeded with, in id order.
---
ALL_SEEDED_NAME_SPELLINGS: List[String] = SEEDED_NAME_SPELLINGS.concat(DISCOVERY_NAME_SPELLINGS)

-- Pinned ids; `test_name_vocabulary` checks each.
---
`_`: the name a discard binder records.
---
DISCARD_NAME_INDEX: Int = 48

---
`Void`: the name `()` records as a type.
---
VOID_NAME_INDEX: Int = 72

TAIL_RECURSIVE_NAME_INDEX: Int = 158

NO_COPY_NAME_INDEX: Int = 159

DEBUG_ONLY_NAME_INDEX: Int = 160

RESOURCE_RESULT_ORDINARY_NAME_INDEX: Int = 161

---
`into`, the removed spelling of `into_opaque`.
---
REMOVED_INTO_NAME_INDEX: Int = 162

---
`max_threads`, the `concurrent(...)` thread-count parameter.
---
MAX_THREADS_NAME_INDEX: Int = 163

---
`limit`, the `for ... concurrently(...)` in-flight item count parameter.
---
LIMIT_NAME_INDEX: Int = 68

---
`timeout`, the optional parameter of both concurrency constructs.
---
TIMEOUT_NAME_INDEX: Int = 69
