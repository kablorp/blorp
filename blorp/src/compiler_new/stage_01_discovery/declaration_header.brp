-- What precedes a declaration, and the definition rows every declaration
-- opens and closes.
--
-- Shared by the declaration parser and the body parser, which declares local
-- functions with the same routines.
import:
	discovery_builder:
		AnnotationRow,
		DefinitionId,
		DiscoveryBuilder,
		EMPTY_ROW_RANGE,
		LiteralId,
		ModuleId,
		NameId,
		PendingAnnotationRow,
		RowRange,
		advance_token,
		append_annotation,
		append_definition,
		append_documentation,
		append_pending_annotation,
		append_plain_diagnostic,
		name_id_index,
		pending_annotation_at,
		pending_annotation_count,
		pending_docstring_at,
		replace_definition_row,
	discovery_diagnostic_code:
		DiscoveryDiagnosticCode(AnnotationArgumentsDiagnostic, UnknownAnnotationDiagnostic),
	name_vocabulary:
		DEBUG_ONLY_NAME_INDEX,
		NO_COPY_NAME_INDEX,
		RESOURCE_RESULT_ORDINARY_NAME_INDEX,
		TAIL_RECURSIVE_NAME_INDEX,
	parser_cursor:
		at,
		consume_referenced_name,
		current_name,
		current_span,
		report_at_current,
		skip_newlines,
	row_kinds:
		DefinitionKind(
			ForeignFunctionDefinition,
			FunctionDefinition,
			ImplMethodDefinition,
			LocalFunctionDefinition,
		),
		FunctionAnnotation(
			DebugOnlyAnnotation,
			NoCopyAnnotation,
			ResourceResultOrdinaryAnnotation,
			TailRecursiveAnnotation,
		),
		Purity(ImpureFunction),
		Visibility(PublicVisibility),
	span: Span, span_covering
	token: TokenKind(AtSymbol, EndOfFileToken, LeftParenSymbol, NewlineToken, RightParenSymbol)


---
What precedes a declaration's keyword: where the declaration starts, its
visibility and purity, its docstring, and its annotations as a block of the
builder's transient `pending_annotations`, and its docstring as a block of
at most one row of the transient `pending_docstrings`. A plain struct, so a
header costs no allocation.
---
struct DeclarationHeader {
	module: ModuleId,
	start: Span,
	visibility: Visibility,
	purity: Purity,
	docstring: RowRange,
	annotations: RowRange
}


---
A member's or local function's header: it starts at `start`, is public,
impure, and has no docstring or annotations of its own. `annotation_row` is
where an empty annotation block sits (the current pending count).
---
pure func plain_header(module: ModuleId, start: Span, annotation_row: Int) -> DeclarationHeader:
	{
		module = module,
		start = start,
		visibility = PublicVisibility,
		purity = ImpureFunction,
		docstring = EMPTY_ROW_RANGE,
		annotations = {
			first = annotation_row,
			count = 0
		}
	}


-- Annotations.
---
The annotation a name denotes, when the language defines one.
---
pure func annotation_named(name: NameId) -> Option[FunctionAnnotation]:
	index: Int = name_id_index(name)

	if index == TAIL_RECURSIVE_NAME_INDEX:
		Some(TailRecursiveAnnotation)
	else if index == NO_COPY_NAME_INDEX:
		Some(NoCopyAnnotation)
	else if index == DEBUG_ONLY_NAME_INDEX:
		Some(DebugOnlyAnnotation)
	else if index == RESOURCE_RESULT_ORDINARY_NAME_INDEX:
		Some(ResourceResultOrdinaryAnnotation)
	else:
		None


---
Consumes the annotations at the cursor, appending each one the language
defines to the transient `pending_annotations` and reporting unknown names and
argument lists. The annotations read are the pending rows from
`pending_annotation_count` before the call to the count after it.
---
pure func consume_annotations(builder: DiscoveryBuilder, allow_newlines: Bool) -> DiscoveryBuilder:
	if at(builder, AtSymbol):
		consume_annotation_run(builder, allow_newlines)
	else:
		builder


---
`consume_annotations` from an `@` (builder threading rule 1).
---
private pure func consume_annotation_run(
	builder: DiscoveryBuilder,
	allow_newlines: Bool,
) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = consume_annotation(builder, allow_newlines)

	while at(out, AtSymbol):
		out = consume_annotation(out, allow_newlines)

	out


---
One `@name`, any argument list, and with `allow_newlines` the newlines after
it.
---
private pure func consume_annotation(
	builder: DiscoveryBuilder,
	allow_newlines: Bool,
) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = advance_token(builder)
	name: Option[NameId] = current_name(out)
	name_span: Span = current_span(out)
	out = consume_referenced_name(out)

	match name:
		Some(annotation_name):
			match annotation_named(annotation_name):
				Some(annotation):
					out = append_pending_annotation(
						out,
						{
							annotation = annotation,
							span = name_span
						},
					)
				None:
					out = append_plain_diagnostic(out, UnknownAnnotationDiagnostic, name_span)
		None:
			void

	if at(out, LeftParenSymbol):
		out = report_at_current(out, AnnotationArgumentsDiagnostic)
		out = advance_token(out)

		while (
			not at(out, RightParenSymbol)
			and not at(out, NewlineToken)
			and not at(out, EndOfFileToken)
		):
			out = advance_token(out)

		if at(out, RightParenSymbol):
			out = advance_token(out)

	if allow_newlines:
		out = skip_newlines(out)

	out


---
The pending annotations from row `first` to the end of the table.
---
pure func annotations_since(builder: DiscoveryBuilder, first: Int) -> RowRange:
	{
		first = first,
		count = pending_annotation_count(builder) - first
	}


-- Definition rows.
---
Appends `definition`'s row with the span known so far; the parse routine
replaces it with the final span at the end.
---
pure func open_definition(
	builder: DiscoveryBuilder,
	header: DeclarationHeader,
	kind: DefinitionKind,
	name: NameId,
	name_span: Span,
) -> DiscoveryBuilder:
	append_definition(
		builder,
		{
			module = header.module,
			kind = kind,
			name = name,
			name_span = name_span,
			visibility = header.visibility,
			span = span_covering(header.start, name_span)
		},
	)


---
Closes `definition` with its final span and records the header's docstring
and annotations.
---
pure func close_definition(
	builder: DiscoveryBuilder,
	definition: DefinitionId,
	header: DeclarationHeader,
	kind: DefinitionKind,
	name: NameId,
	name_span: Span,
	end: Span,
) -> DiscoveryBuilder:
	var out: DiscoveryBuilder = replace_definition_row(
		builder,
		definition,
		{
			module = header.module,
			kind = kind,
			name = name,
			name_span = name_span,
			visibility = header.visibility,
			span = span_covering(header.start, end)
		},
	)

	if header.docstring.count > 0:
		text: LiteralId = pending_docstring_at(out, header.docstring.first)
		out = append_documentation(
			out,
			{
				definition = definition,
				text = text
			},
		)

	out = record_annotations(out, definition, header.annotations, kind)
	out


---
Copies the header's pending annotations to `definition`. Only functions
carry annotations; on any other declaration they were reported
(`AnnotationWithoutFunctionDiagnostic`) and are dropped.
---
private pure func record_annotations(
	builder: DiscoveryBuilder,
	definition: DefinitionId,
	annotations: RowRange,
	kind: DefinitionKind,
) -> DiscoveryBuilder:
	if annotations.count == 0 or not takes_annotations(kind):
		builder
	else:
		record_annotation_rows(builder, definition, annotations)


---
The annotation rows of a non-empty block; the first is appended before the
loop (builder threading rule 1).
---
private pure func record_annotation_rows(
	builder: DiscoveryBuilder,
	definition: DefinitionId,
	annotations: RowRange,
) -> DiscoveryBuilder:
	-- Builder threading rule 3.
	first_row: AnnotationRow = annotation_row(builder, definition, annotations.first)
	var out: DiscoveryBuilder = append_annotation(builder, first_row)
	var index: Int = annotations.first + 1

	while index < annotations.first + annotations.count:
		row: AnnotationRow = annotation_row(out, definition, index)
		out = append_annotation(out, row)
		index += 1

	out


private pure func annotation_row(
	builder: DiscoveryBuilder,
	definition: DefinitionId,
	pending_index: Int,
) -> AnnotationRow:
	pending: PendingAnnotationRow = pending_annotation_at(builder, pending_index)
	{
		definition = definition,
		annotation = pending.annotation,
		span = pending.span
	}


pure func takes_annotations(kind: DefinitionKind) -> Bool:
	match kind:
		FunctionDefinition | ImplMethodDefinition | ForeignFunctionDefinition | LocalFunctionDefinition:
			True
		_:
			False
