-- Admitting a source text into the discovery tables.
import:
	../lex/scan_support: line_starts_of
	../tables/builder:
		DiscoveryBuilder,
		append_line_start,
		append_path,
		append_source,
		find_path_id,
		next_line_start_row,
		next_path_id,
	../tables/ids: PathId
	../tables/span: source_fits_span_limits, source_index_fits_span


---
Why a source text cannot be admitted.
---
enum SourceRejection:
	SourceTooLargeToSpan
	TooManySourcesToSpan


---
Whether `builder` can admit one more source of `byte_length` bytes: its spans
must fit, and so must its index. `None` when it can.
---
pure func source_rejection(builder: DiscoveryBuilder, byte_length: Int) -> Option[SourceRejection]:
	if not source_index_fits_span(builder.sources.length()):
		Some(TooManySourcesToSpan)
	else if not source_fits_span_limits(byte_length):
		Some(SourceTooLargeToSpan)
	else:
		None


---
The id `path_text` has, or the one `intern_path` will give it.
---
pure func interned_path_id(builder: DiscoveryBuilder, path_text: String) -> PathId:
	match builder.find_path_id(path_text):
		Some(existing):
			existing
		None:
			builder.next_path_id()


---
Interns `path_text` unless it is already interned; read its id first with
`interned_path_id`.
---
pure func intern_path(builder: DiscoveryBuilder, path_text: String) -> DiscoveryBuilder:
	if (
		builder
			.find_path_id(path_text)
			.is_some()
	):
		builder
	else:
		builder.append_path(path_text)


---
Appends the source `text` read from `path_text`, with its line starts; read
its id first with `next_source_id`. The caller has checked
`source_rejection`.
---
pure func admit_source(
	builder: DiscoveryBuilder,
	path_text: String,
	text: String,
) -> DiscoveryBuilder:
	builder.admit_source_with_line_starts(path_text, text, line_starts_of(text))


---
`admit_source` for a text whose `line_starts` the caller already has, as the
lexer finds them with the rest of its product.
---
pure func admit_source_with_line_starts(
	builder: DiscoveryBuilder,
	path_text: String,
	text: String,
	line_starts: List[Int],
) -> DiscoveryBuilder:
	path: PathId = builder.interned_path_id(path_text)
	var out: DiscoveryBuilder = builder.intern_path(path_text)
	first_line_start: Int = out.next_line_start_row()

	for line_start in line_starts:
		out = out.append_line_start(line_start)

	out.append_source(
		text,
		{
			path = path,
			line_starts = {
				first = first_line_start,
				count = line_starts.length()
			}
		},
	)
