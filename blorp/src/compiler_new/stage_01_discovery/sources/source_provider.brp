-- Where discovery's source texts come from.
--
-- Reading sources is discovery's only effect, and it sits behind
-- `SourceProvider`, which answers three questions: does a source exist at a
-- path, what is its text, and what does a directory hold (so the module graph can
-- check the spelling of a path; see `SourceProvider`). Everything else, including the order in
-- which an import request's candidate paths are tried, is the pure lookup
-- policy below, shared by every provider, so an editor serving unsaved
-- buffers resolves exactly like a build.
--
-- Providers here: the file system, and an in-memory map for tests and
-- overlays; `embedded_standard_library` adds the provider that answers for
-- the standard-library root from the compiler's embedded texts and delegates
-- everything else. The package catalog plugs in through `SourceLookupRoots`:
-- `native_package_roots` and `source_packages` (the `blorp.toml` source
-- packages), whose lookup rules are in `import_candidates`. The module graph
-- never changes for either.
import:
	../tables/row_kinds:
		ImportRequestKind(BareModuleRequest, NativePackageRequest, RelativeModuleRequest),
		ModuleOriginKind(PackageModule, SourcePackageModule, StdlibModule, UserModule),
	fs: DirectoryListing(DirectoryAbsent, DirectoryListed, DirectoryUnreadable), list_directory
	path: dirname, join, normalize
	system: file_exists, read_file


---
The file extension of a Blorp source; an import request names a module
without it.
---
SOURCE_FILE_EXTENSION: String = ".brp"


---
The text a provider read, or that it could not read a source it reported
as existing.
---
union SourceRead:
	SourceText(String)
	SourceUnreadable


---
Where sources and directory listings come from. The provider is stateless:
the module graph owns what it learns.

Import paths are case-sensitive on every platform: a case-insensitive file
system would otherwise resolve `./sub/helper` to `sub/Helper.brp`, load it as
a second module beside `./sub/Helper`, and resolve nothing at all on a
case-sensitive one. So the module graph accepts an existing source only when no
component below the candidate's `trusted_directory` is known to be stored in
different letter case, comparing each with a `directory_listing` it keeps for
the whole discovery (each directory is listed once).

- `source_exists`: whether a source exists at `path`, however spelled.
- `directory_listing`: the entry names of `directory`, as `fs.list_directory`.
- `read_source`: the text of the source at `path`.
---
trait SourceProvider:
	func source_exists(self: Self, path: String) -> Bool
	func directory_listing(self: Self, directory: String) -> DirectoryListing
	func read_source(self: Self, path: String) -> SourceRead


---
A source package of the project catalog (`blorp.toml`), as the lookup policy
sees it.

- `package_alias`: the name importers write before the first `/` of a request.
- `package_name`: the package's own name, the first part of every module path
  it exports and of its internal imports.
- `source_dir`: the directory its modules are stored under, with the same
  spelling the caller gives every other path (a package module's path is
  `source_dir` joined with its module path).
- `exports`: the module paths other code may import through the alias, each
  `package_name` or `package_name/<module>`.
---
record SourcePackageRoot {
	package_alias: String,
	package_name: String,
	source_dir: String,
	exports: List[String]
}


---
The directories and packages the lookup policy searches.
---
record SourceLookupRoots {
	standard_library_root: String,
	native_package_roots: List[String],
	source_packages: List[SourcePackageRoot]
}


---
Where a module lives, which decides where its own import requests may
resolve and what origin and package its row records. A native package's name
is its first path part after `pkg/`; a source package is named by its alias.
There is one source for both facts: `origin_kind` and the package row come
from this value, so a module cannot have a package without the matching
origin.
---
union ModulePlacement:
	InStandardLibrary
	InNativePackage(String)
	InSourcePackage(String)
	InUserCode


---
The origin a module in `placement` is recorded with.
---
pure func origin_kind(placement: ModulePlacement) -> ModuleOriginKind:
	match placement:
		InStandardLibrary:
			StdlibModule
		InNativePackage(_):
			PackageModule
		InSourcePackage(_):
			SourcePackageModule
		InUserCode:
			UserModule


---
The module an import request comes from: its canonical path and placement
decide where the request may resolve.
---
record ImportRequester {
	canonical_path: String,
	placement: ModulePlacement
}


---
An import request in structured form: its syntax kind, the text written,
and its path parts (without `./` and `../` prefixes).
---
record ImportRequest {
	kind: ImportRequestKind,
	text: String,
	parts: List[String],
	requester: ImportRequester
}


---
The import text to write instead of `request_text` when its source is stored
as `stored_names` (an `ImportCaseMismatchDiagnostic`'s spelling): the trailing
named components the provider spelled differently are replaced and the file
extension dropped, so `./sub/helper` with `["sub", "Helper.brp"]` is
`./sub/Helper`. The leading `.` and `..` are kept, and a provider spelling that reaches above
the request's named components (a native package root's own directory, say)
is cut to their number.
---
pure func respelled_import_text(request_text: String, stored_names: List[String]) -> String:
	written: List[String] = request_text.split("/")
	named: Int = written
		.filter(pure func(part): part != "." and part != "..")
		.length()
	replaced: Int = stored_names
		.length()
		.min(named)
	var stored_modules: List[String] = stored_names.drop(stored_names.length() - replaced)

	match stored_modules.last():
		Some(file_name):
			stored_modules = stored_modules
				.take(replaced - 1)
				.append(file_name.remove_suffix(SOURCE_FILE_EXTENSION))
		None:
			void

	written
		.take(written.length() - replaced)
		.concat(stored_modules)
		.join("/")


---
A path an import request may resolve to, with the placement the module there
would have.

`trusted_directory` is the directory the request is resolved against: the
importer's directory, the standard-library root, a native package root, or a
root's own directory. Only the components of `path` below it come from the
request's spelling, so only those are compared case-exactly.
---
record SourceCandidate {
	path: String,
	trusted_directory: String,
	placement: ModulePlacement
}


private pure func module_file(module_path: String) -> String:
	module_path + SOURCE_FILE_EXTENSION


private pure func standard_library_candidate(
	roots: SourceLookupRoots,
	module_path: String,
) -> SourceCandidate:
	{
		path = normalize(join(roots.standard_library_root, module_file(module_path))),
		trusted_directory = roots.standard_library_root,
		placement = InStandardLibrary
	}


---
The candidate for an implicit module: `module_name` under the
standard-library root, as a standard-library module.
---
pure func implicit_module_candidate(
	roots: SourceLookupRoots,
	module_name: String,
) -> SourceCandidate:
	roots.standard_library_candidate(module_name)


---
The package of `source_packages` named `package_alias`, if any.
---
private pure func source_package_with_alias(
	roots: SourceLookupRoots,
	package_alias: String,
) -> Option[SourcePackageRoot]:
	roots.source_packages.find(pure func(package): package.package_alias == package_alias)


private pure func source_package_candidate(
	package: SourcePackageRoot,
	module_path: String,
) -> SourceCandidate:
	{
		path = normalize(join(package.source_dir, module_file(module_path))),
		trusted_directory = package.source_dir,
		placement = InSourcePackage(package.package_alias)
	}


---
The module path `package` exports for the request `module_path`, if there is
one: `<alias>` is the package's own module, `<alias>/<rest>` its module
`<package_name>/<rest>`, and only a module the package lists in `exports`
resolves. This is `source_package_export_for_alias` in
`compiler/stage_04_modules/source_package_layout`, restated because the stage
must not import the existing compiler; the two must agree for as long as both
front ends exist.
---
private pure func exported_module_for_alias(
	package: SourcePackageRoot,
	module_path: String,
) -> Option[String]:
	match module_path.split("/"):
		[head, ...rest]:
			exported: String = if rest.length() == 0:
				package.package_name
			else:
				package.package_name + "/" + rest.join("/")

			if head == package.package_alias and package.exports.contains(exported):
				Some(exported)
			else:
				None
		[]:
			None


---
The source packages' exported modules that the request `module_path` names
through an alias, in catalog order.
---
private pure func alias_export_candidates(
	roots: SourceLookupRoots,
	module_path: String,
) -> List[SourceCandidate]:
	var found: List[SourceCandidate] = []

	for package in roots.source_packages:
		match package.exported_module_for_alias(module_path):
			Some(exported):
				found = found.append(package.source_package_candidate(exported))
			None:
				void

	found


---
Whether `module_path` is one of the package's own modules, which it may
import by bare name without exporting it (`source_package_contains_internal_module`
in the existing compiler; see `exported_module_for_alias`).
---
private pure func is_internal_module(package: SourcePackageRoot, module_path: String) -> Bool:
	module_path == package.package_name or module_path.starts_with(package.package_name + "/")


---
Whether a request from a module in `placement` may name a path outside its
own package. Only a source package module is confined: its relative imports
stay under the package's `source_dir`. A source package module whose alias is
not in `roots` is confined to nothing (`False`), as in the existing front end.
---
private pure func relative_request_stays_in_package(
	roots: SourceLookupRoots,
	placement: ModulePlacement,
	path: String,
) -> Bool:
	match placement:
		InSourcePackage(package_alias):
			match roots.source_package_with_alias(package_alias):
				Some(package):
					source_dir: String = normalize(package.source_dir)
					path == source_dir or path.starts_with(source_dir + "/")
				None:
					False
		InStandardLibrary:
			True
		InNativePackage(_):
			True
		InUserCode:
			True


---
The candidates of a `pkg/<package>/...` request: the module under each native
package root.
---
private pure func native_package_candidates(
	roots: SourceLookupRoots,
	request: ImportRequest,
) -> List[SourceCandidate]:
	package_parts: List[String] = request.parts.drop(1)
	package_name: String = package_parts
		.get(0)
		.get_or("")
	package_path: String = module_file(package_parts.join("/"))
	roots.native_package_roots.map(pure func(root): {
			path = normalize(join(root, package_path)),
			trusted_directory = root,
			placement = InNativePackage(package_name)
		})


---
The candidates of a bare request from code that resolves like user code (user
modules and native package modules): a source package alias, then the
standard library, then beside the importer as user code.
---
private pure func user_code_bare_candidates(
	roots: SourceLookupRoots,
	module_path: String,
	importer_directory: String,
) -> List[SourceCandidate]:
	roots
		.alias_export_candidates(module_path)
		.append(roots.standard_library_candidate(module_path))
		.append({
			path = normalize(join(importer_directory, module_file(module_path))),
			trusted_directory = importer_directory,
			placement = InUserCode,
		})


---
Candidate paths for `request`, in the order they are tried; the first that
exists wins. The order is language behavior, and it is the existing front
end's `frontend_import_lookup_plan` (`compiler/stage_04_modules/
frontend_import_plan`):

- a native package request (`pkg/<package>/...`) resolves under each native
  package root, from user modules and native package modules only (never
  from the standard library or a source package);
- a relative request resolves beside its importer and keeps the importer's
  placement, but a source package module's must stay under its package's
  `source_dir`;
- a bare request from a standard-library module resolves only in the
  standard library; from a source package module, first as one of its own
  modules (internal imports), then in the standard library; from user code
  or a native package module, first through a source package alias (only
  modules the package exports), then in the standard library, then beside
  the importer as user code.
---
pure func import_candidates(
	roots: SourceLookupRoots,
	request: ImportRequest,
) -> List[SourceCandidate]:
	importer_directory: String = dirname(request.requester.canonical_path)

	match request.kind:
		NativePackageRequest:
			match request.requester.placement:
				InStandardLibrary:
					[]
				InSourcePackage(_):
					[]
				InNativePackage(_):
					roots.native_package_candidates(request)
				InUserCode:
					roots.native_package_candidates(request)
		RelativeModuleRequest:
			path: String = normalize(join(importer_directory, module_file(request.text)))

			if roots.relative_request_stays_in_package(request.requester.placement, path):
				[
					{
						path = path,
						trusted_directory = importer_directory,
						placement = request.requester.placement
					},
				]
			else:
				[]
		BareModuleRequest:
			module_path: String = request.parts.join("/")

			match request.requester.placement:
				InStandardLibrary:
					[roots.standard_library_candidate(module_path)]
				InSourcePackage(package_alias):
					match roots.source_package_with_alias(package_alias):
						Some(package):
							if package.is_internal_module(module_path):
								[
									package.source_package_candidate(module_path),
									roots.standard_library_candidate(module_path),
								]
							else:
								[roots.standard_library_candidate(module_path)]
						None:
							[roots.standard_library_candidate(module_path)]
				InUserCode:
					roots.user_code_bare_candidates(module_path, importer_directory)
				InNativePackage(_):
					roots.user_code_bare_candidates(module_path, importer_directory)


---
A root of a compilation: the source path as the caller gives it, and where the
module there lives. Placement is the caller's to say because it depends on the
file system the caller knows (a root under the standard-library directory or a
package's source directory is a module of that library or package, and its own
imports resolve as such); the stage records it and applies the lookup rules
for it, as it does for every other module.
---
record RootRequest {
	path: String,
	placement: ModulePlacement
}


---
The root of a user module at `path`, the usual root.
---
pure func user_root(path: String) -> RootRequest:
	{
		path = path,
		placement = InUserCode
	}


---
The candidate for a root: the path as given, normalized, with the placement the
caller gave it. A root's directory is as the user wrote it or the working
directory supplied it, so only its file name is compared case-exactly.
---
pure func root_candidate(root: RootRequest) -> SourceCandidate:
	normalized: String = normalize(root.path)
	{
		path = normalized,
		trusted_directory = dirname(normalized),
		placement = root.placement
	}


---
Sources on the file system, with paths relative to the working directory.
---
record FileSystemSourceProvider {
	description: String
}


FILE_SYSTEM_SOURCE_PROVIDER: FileSystemSourceProvider = {description = "file system"}


implements SourceProvider for FileSystemSourceProvider:
	func source_exists(self: FileSystemSourceProvider, path: String) -> Bool:
		file_exists(path)

	func directory_listing(self: FileSystemSourceProvider, directory: String) -> DirectoryListing:
		list_directory(directory)

	func read_source(self: FileSystemSourceProvider, path: String) -> SourceRead:
		match read_file(path):
			Ok(text):
				SourceText(text)
			Err(_):
				SourceUnreadable


---
Sources held in memory, keyed by path: for tests and editor overlays.
---
record InMemorySourceProvider {
	sources: Dict[String, String]
}


---
The path parts of `directory`, normalized; empty for the working directory,
which the walk spells `.`.
---
private pure func directory_parts(directory: String) -> List[String]:
	normalize(directory)
		.split("/")
		.filter(pure func(part): part.length() > 0 and part != ".")


implements SourceProvider for InMemorySourceProvider:
	func source_exists(self: InMemorySourceProvider, path: String) -> Bool:
		self.sources.contains(path)

	func directory_listing(self: InMemorySourceProvider, directory: String) -> DirectoryListing:
		parts: List[String] = directory_parts(directory)
		var names: List[String] = []

		for key in self.sources.keys():
			key_parts: List[String] = key.split("/")

			if key_parts.length() > parts.length() and key_parts.take(parts.length()) == parts:
				name: String = key_parts.get_or(parts.length(), "")

				if not names.contains(name):
					names = names.append(name)

		if names.length() == 0:
			DirectoryAbsent
		else:
			DirectoryListed(names.sort())

	func read_source(self: InMemorySourceProvider, path: String) -> SourceRead:
		match self.sources.get(path):
			Some(text):
				SourceText(text)
			None:
				SourceUnreadable


---
Sources held in memory that take precedence over a provider: the text a
caller already holds for a path (an edited buffer, a generated module, a file
the command already read), over `inner` for everything else. `overlay` is keyed
by normalized path, as a root candidate's path is.

A directory lists what `inner` lists plus the overlay's files directly in it,
so an overlay file that is not on disk still passes the exact-case spelling
check beside its siblings. A directory `inner` cannot list stays unlistable.
---
record OverlaySourceProvider[Inner:SourceProvider] {
	overlay: Dict[String, String],
	inner: Inner
}


---
The names of the overlay files whose parent directory is `directory`.
---
private pure func overlay_names_in(overlay: Dict[String, String], directory: String) -> List[String]:
	wanted: String = normalize(directory)

	overlay
		.keys()
		.filter(pure func(path): normalize(dirname(path)) == wanted)
		.map(pure func(path): path.split("/").last().get_or(path))


---
`names` and `added`, sorted, each name once.
---
private pure func merged_sorted_names(names: List[String], added: List[String]) -> List[String]:
	var merged: List[String] = []

	for name in names.concat(added).sort():
		if merged.last() != Some(name):
			merged = merged.append(name)

	merged


implements SourceProvider for OverlaySourceProvider[Inner:SourceProvider]:
	func source_exists(self: OverlaySourceProvider[Inner], path: String) -> Bool:
		self.overlay.contains(path) or self.inner.source_exists(path)

	func directory_listing(
		self: OverlaySourceProvider[Inner],
		directory: String,
	) -> DirectoryListing:
		added: List[String] = self.overlay.overlay_names_in(directory)

		match self.inner.directory_listing(directory):
			DirectoryListed(names):
				DirectoryListed(merged_sorted_names(names, added))
			DirectoryAbsent:
				if added.is_empty():
					DirectoryAbsent
				else:
					DirectoryListed(merged_sorted_names([], added))
			DirectoryUnreadable:
				DirectoryUnreadable

	func read_source(self: OverlaySourceProvider[Inner], path: String) -> SourceRead:
		match self.overlay.get(path):
			Some(text):
				SourceText(text)
			None:
				self.inner.read_source(path)
