-- The module graph: how discovery turns a request for a module (a root, or an
-- import of a loaded module) into what to do about it.
--
-- `resolve_root` and `resolve_import` look a request's candidates up through
-- the provider and answer with a `RequestResolution`: load this source, reuse
-- the module already loaded from that path, or why nothing can be loaded.
-- `pipeline` carries the answer out (it owns loading a module) and records it
-- with `record_target` or `report_failure`. A module is loaded once per
-- canonical path, whichever request reaches it first, so ids depend only on
-- the roots and the sources, never on the order in which a provider happens
-- to answer. A request that resolves to no source is recorded as a diagnostic
-- row and discovery goes on.
--
-- The state discovery keeps while resolving (directory listings read so far,
-- and the `ImportQueue`) is handed in and returned as values of its own and
-- never holds the builder, so the builder threading rules in `tables/builder`
-- stay with the builder.
import:
	../tables/builder:
		DiscoveryBuilder,
		append_implicit_request,
		append_import_target,
		append_module_package,
		append_name,
		append_package,
		append_resolution_diagnostic_at,
		append_root,
		find_module_by_path,
		find_name_id,
		find_path_id,
		next_name_id,
		next_package_id,
	../tables/diagnostic_code:
		ImplicitDiagnostic(
			ImplicitSourceTooLarge, ImplicitTooManySources, MissingImplicitModule,
			UnreadableImplicitSource, UnverifiableImplicitSpelling,
		),
		ResolutionDiagnostic(
			ImportCaseMismatch, ImportSourceTooLarge, ImportTooManySources, UnreadableSource,
			UnresolvedImport, UnverifiableSpelling,
		),
		RootDiagnostic(
			RootCaseMismatch, RootSourceTooLarge, RootTooManySources, UnreadableRootSource,
			UnresolvedRoot, UnverifiableRootSpelling,
		),
	../tables/ids:
		ImportId,
		ModuleId,
		NameId,
		PackageId,
		PathId,
		import_id_at_row,
		import_id_index,
		module_id_at_row,
		module_id_index,
		name_id_index,
		package_id_at_row,
		path_id_index,
	../tables/row_kinds:
		ModuleReach(ImplicitModule, ImportedModule, RootModule),
		PackageKind(NativePackage, SourcePackage),
	../tables/rows:
		ImplicitOutcome(ImplicitLoaded, ImplicitRejected),
		ImportRow,
		RootOutcome(RootLoaded, RootRejected),
	../tables/span: NO_SPAN, Span
	fs:
		DirectoryListing,
		PathSpelling(ExactSpelling, SpellingUnverifiable, StoredSpelling),
		SpellingStep(SpellingKnown, SpellingNeedsListing),
		spelling_below,
	path: normalize
	source_admission:
		SourceRejection(SourceTooLargeToSpan, TooManySourcesToSpan),
		intern_path,
		interned_path_id,
		source_rejection,
	source_provider:
		ImportRequest,
		ImportRequester,
		ModulePlacement(InNativePackage, InSourcePackage, InStandardLibrary, InUserCode),
		RootRequest,
		SourceCandidate,
		SourceLookupRoots,
		SourceProvider,
		SourceRead(SourceText, SourceUnreadable),
		directory_listing,
		implicit_module_candidate,
		import_candidates,
		read_source,
		root_candidate,
		source_exists,


---
An import waiting to be resolved, with the facts of the module it came
from.
---
record PendingImport {
	import_id: ImportId,
	request: ImportRequest
}


---
The imports of loaded modules that are waiting to be resolved, in the order
they were found, and how many of them have been taken. The queue never holds
the builder.
---
record ImportQueue {
	pending: List[PendingImport],
	taken: Int
}


---
A queue with nothing waiting.
---
pure func empty_import_queue() -> ImportQueue:
	{
		pending = [],
		taken = 0
	}


---
What asked for a module: a root, an implicit module request or an import. Its
target or diagnostic row is recorded against it.
---
union ModuleRequester:
	RequestedByRoot(PathId)
	RequestedImplicitly(PathId)
	RequestedByImport(ImportId)


---
What a request for a module came to.

- `LoadSource(candidate, text)`: a source that exists, was read and fits the
  tables, and no module has been loaded from its path yet.
- `ModuleAlreadyLoaded(module)`: the request's source is a module already
  loaded.
- `Unresolved(failure)`: no module results; `failure` says why.
---
union RequestResolution:
	LoadSource(SourceCandidate, String)
	ModuleAlreadyLoaded(ModuleId)
	Unresolved(ResolutionFailure)


---
Why a request resolved to no module. Each failure is reported against the
requester by `report_failure`.

- `SourceMissing`: no candidate exists under any spelling.
- `SpellingUnknown`: a candidate exists but a directory on the way to it could
  not be listed, so its spelling is unknown; discovery says so rather than
  guess.
- `SpelledWithOtherCase(names)`: no candidate exists exactly, but one exists
  under different letter case, stored as `names` (the components below its
  trusted directory).
- `ReadFailed`: a candidate exists but its text could not be read.
- `SourceOverLimit(rejection, byte_length)`: the source cannot be admitted.
---
union ResolutionFailure:
	SourceMissing
	SpellingUnknown
	SpelledWithOtherCase(List[String])
	ReadFailed
	SourceOverLimit(SourceRejection, Int)


---
Resolves `root`. Directory listings the spelling checks need
are read through the provider once each: `listings` holds those read so far
and the listings to keep are returned with the resolution.
---
func resolve_root[Provider:SourceProvider](
	provider: Provider,
	builder: DiscoveryBuilder,
	listings: Dict[String, DirectoryListing],
	root: RootRequest,
) -> (Dict[String, DirectoryListing], RequestResolution):
	candidate: SourceCandidate = root_candidate(root)

	match builder.loaded_module_at(candidate.path):
		Some(module):
			(listings, ModuleAlreadyLoaded(module))
		None:
			look_up_candidates(provider, builder, listings, [candidate])


---
Resolves the implicit module `module_name`, a standard-library module. A
source already loaded from its path (a root that is that very module, or an
earlier implicit request) is reused; `listings` as for `resolve_root`.
---
func resolve_implicit[Provider:SourceProvider](
	provider: Provider,
	lookup: SourceLookupRoots,
	builder: DiscoveryBuilder,
	listings: Dict[String, DirectoryListing],
	module_name: String,
) -> (Dict[String, DirectoryListing], RequestResolution):
	look_up_candidates(provider, builder, listings, [lookup.implicit_module_candidate(module_name)])


---
Resolves the import `entry` through `lookup`; `listings` as for
`resolve_root`.
---
func resolve_import[Provider:SourceProvider](
	provider: Provider,
	lookup: SourceLookupRoots,
	builder: DiscoveryBuilder,
	listings: Dict[String, DirectoryListing],
	entry: PendingImport,
) -> (Dict[String, DirectoryListing], RequestResolution):
	look_up_candidates(
		provider,
		builder,
		listings,
		lookup.import_candidates(entry.request),
	)


---
The next waiting import, in the order the imports were found; `advance` moves
the queue past it.
---
pure func next_pending_import(queue: ImportQueue) -> Option[PendingImport]:
	queue.pending.get(queue.taken)


---
`queue` past the import `next_pending_import` returned.
---
pure func advance(queue: ImportQueue) -> ImportQueue:
	{ queue | taken = queue.taken + 1 }


---
Queues the import requests of the module `resolution` loaded. Only a
`LoadSource` resolution loads a module, and it is the one whose id was
`builder.next_module_id()` before the resolution was settled; read that id
first and pass it as `loaded_module_id`. Any other resolution loads nothing.
---
pure func enqueue_imports_of_loaded_module(
	queue: ImportQueue,
	builder: DiscoveryBuilder,
	loaded_module_id: ModuleId,
	resolution: RequestResolution,
) -> ImportQueue:
	match resolution:
		LoadSource(candidate, _):
			{ queue |
				pending = queue.pending.concat(
					builder.module_import_requests(
						loaded_module_id,
						candidate,
					),
				)
			}
		ModuleAlreadyLoaded(_) | Unresolved(_):
			queue


---
The reach a module requested by `requester` has: roots are reached as roots
and imports as imports, so the two cannot disagree.
---
pure func reach_of(requester: ModuleRequester) -> ModuleReach:
	match requester:
		RequestedByRoot(_):
			RootModule
		RequestedImplicitly(_):
			ImplicitModule
		RequestedByImport(_):
			ImportedModule


---
Records `module` as the target of `requester`: a root or implicit request is
appended with it as its outcome.
---
pure func record_target(
	builder: DiscoveryBuilder,
	requester: ModuleRequester,
	module: ModuleId,
) -> DiscoveryBuilder:
	match requester:
		RequestedByRoot(request_path):
			builder.append_root({
				request_path = request_path,
				outcome = RootLoaded(module),
			})
		RequestedImplicitly(request_path):
			builder.append_implicit_request({
				request_path = request_path,
				outcome = ImplicitLoaded(module),
			})
		RequestedByImport(import_id):
			builder.append_import_target({
				owner_import = import_id,
				target = module,
			})


---
Reports against `requester` why its request loaded no module.
---
pure func report_failure(
	builder: DiscoveryBuilder,
	requester: ModuleRequester,
	failure: ResolutionFailure,
) -> DiscoveryBuilder:
	match failure:
		SourceMissing:
			match requester:
				RequestedByRoot(request_path):
					builder.report_root(request_path, UnresolvedRoot)
				RequestedImplicitly(request_path):
					builder.report_implicit(request_path, MissingImplicitModule)
				RequestedByImport(import_id):
					builder.report_import(import_id, UnresolvedImport(import_id))
		SpellingUnknown:
			match requester:
				RequestedByRoot(request_path):
					builder.report_root(request_path, UnverifiableRootSpelling)
				RequestedImplicitly(request_path):
					builder.report_implicit(request_path, UnverifiableImplicitSpelling)
				RequestedByImport(import_id):
					builder.report_import(import_id, UnverifiableSpelling(import_id))
		SpelledWithOtherCase(stored_names):
			match requester:
				RequestedByRoot(request_path):
					builder.report_root_case_mismatch(request_path, stored_names)
				RequestedImplicitly(request_path):
					-- The name is the compiler's own constant, so the stored spelling
					-- teaches nothing: the module is simply not there.
					builder.report_implicit(request_path, MissingImplicitModule)
				RequestedByImport(import_id):
					builder.report_import_case_mismatch(import_id, stored_names)
		ReadFailed:
			match requester:
				RequestedByRoot(request_path):
					builder.report_root(request_path, UnreadableRootSource)
				RequestedImplicitly(request_path):
					builder.report_implicit(request_path, UnreadableImplicitSource)
				RequestedByImport(import_id):
					builder.report_import(import_id, UnreadableSource(import_id))
		SourceOverLimit(rejection, byte_length):
			match requester:
				RequestedByRoot(request_path):
					builder.report_rejected_root(request_path, rejection, byte_length)
				RequestedImplicitly(request_path):
					builder.report_rejected_implicit(request_path, rejection, byte_length)
				RequestedByImport(import_id):
					builder.report_rejected_import(import_id, rejection, byte_length)


---
The module already loaded from `path`, if any.
---
private pure func loaded_module_at(builder: DiscoveryBuilder, path: String) -> Option[ModuleId]:
	match builder.find_path_id(path):
		Some(path_id):
			builder.find_module_by_path(path_id)
		None:
			None


---
The spelling of `candidate`'s path below its trusted directory, listing each
directory the check needs that `listings` does not hold yet. Returns the
listings to keep.
---
private func candidate_spelling[Provider:SourceProvider](
	provider: Provider,
	listings: Dict[String, DirectoryListing],
	candidate: SourceCandidate,
) -> (Dict[String, DirectoryListing], PathSpelling):
	var kept: Dict[String, DirectoryListing] = listings
	var spelling: Option[PathSpelling] = None

	while spelling.is_none():
		match spelling_below(kept, candidate.trusted_directory, candidate.path):
			SpellingKnown(known):
				spelling = Some(known)
			SpellingNeedsListing(directory):
				kept = kept.set(
					directory,
					provider.directory_listing(directory),
				)

	(kept, spelling.get_or(ExactSpelling))


---
The resolution of a request none of whose candidates exists. Built once: a
union with a payload is allocated each time it is written, and every import
starts its look-up from this value.
---
private NO_CANDIDATE_FOUND: RequestResolution = Unresolved(SourceMissing)


---
Looks `candidates` up in `provider`: the first, in lookup order, that exists
with no component below its trusted directory known to be stored in different
letter case, read and checked against the tables' limits. Near misses are
only searched for once every candidate has failed, so a request that resolves
never pays for the search (and a missing candidate is never listed for).
---
private func look_up_candidates[Provider:SourceProvider](
	provider: Provider,
	builder: DiscoveryBuilder,
	listings: Dict[String, DirectoryListing],
	candidates: List[SourceCandidate],
) -> (Dict[String, DirectoryListing], RequestResolution):
	var kept: Dict[String, DirectoryListing] = listings
	var found: RequestResolution = NO_CANDIDATE_FOUND

	for candidate in candidates:
		if provider.source_exists(candidate.path):
			(listed, spelling) = candidate_spelling(provider, kept, candidate)
			kept = listed

			match spelling:
				ExactSpelling:
					found = resolution_of_existing_source(provider, builder, candidate)
					break
				SpellingUnverifiable(_):
					found = Unresolved(SpellingUnknown)
					break
				StoredSpelling(_, _):
					void

	match found:
		Unresolved(SourceMissing):
			for candidate in candidates:
				(listed, spelling) = candidate_spelling(provider, kept, candidate)
				kept = listed

				match spelling:
					StoredSpelling(stored_names, stored_path):
						if provider.source_exists(normalize(stored_path)):
							found = Unresolved(SpelledWithOtherCase(stored_names))
							break
					_:
						void
		_:
			void

	(kept, found)


---
What an existing source at `candidate` means for the request: the module
already loaded from its path, or a source that is read and checked against the
tables' limits.
---
private func resolution_of_existing_source[Provider:SourceProvider](
	provider: Provider,
	builder: DiscoveryBuilder,
	candidate: SourceCandidate,
) -> RequestResolution:
	match builder.loaded_module_at(candidate.path):
		Some(module):
			ModuleAlreadyLoaded(module)
		None:
			match provider.read_source(candidate.path):
				SourceText(text):
					match builder.source_rejection(text.length()):
						Some(rejection):
							Unresolved(SourceOverLimit(rejection, text.length()))
						None:
							LoadSource(candidate, text)
				SourceUnreadable:
					Unresolved(ReadFailed)


---
Records `module`'s package, adding the package row the first time a module
of that package is loaded. A module in the standard library or in user code
has none.
---
pure func record_module_package(
	builder: DiscoveryBuilder,
	module: ModuleId,
	placement: ModulePlacement,
) -> DiscoveryBuilder:
	match placement:
		InNativePackage(name):
			builder.record_module_in_package(module, NativePackage, name)
		InSourcePackage(package_alias):
			builder.record_module_in_package(module, SourcePackage, package_alias)
		InStandardLibrary:
			builder
		InUserCode:
			builder


---
Records that `module` belongs to the package of `kind` named `name`, adding
the package row first when it is the first module of that package.
---
private pure func record_module_in_package(
	builder: DiscoveryBuilder,
	module: ModuleId,
	kind: PackageKind,
	name: String,
) -> DiscoveryBuilder:
	package: PackageId = match builder.existing_package(kind, name):
		Some(existing):
			existing
		None:
			builder.next_package_id()

	builder
		.ensure_package(kind, name)
		.append_module_package({
			module = module,
			package = package,
		})


---
Adds the package row for `name` unless a package of `kind` with that name
exists. A native package and a source package may share a spelling; they are
different packages.
---
private pure func ensure_package(
	builder: DiscoveryBuilder,
	kind: PackageKind,
	name: String,
) -> DiscoveryBuilder:
	if (
		builder
			.existing_package(kind, name)
			.is_some()
	):
		builder
	else:
		package_name: NameId = match builder.find_name_id(name):
			Some(existing_name):
				existing_name
			None:
				builder.next_name_id()

		builder
			.ensure_name(name)
			.append_package({
				name = package_name,
				kind = kind,
			})


---
Interns `name` unless it is already interned.
---
private pure func ensure_name(builder: DiscoveryBuilder, name: String) -> DiscoveryBuilder:
	if (
		builder
			.find_name_id(name)
			.is_some()
	):
		builder
	else:
		builder.append_name(name)


---
The package of `kind` already recorded under `name`, if any.
---
private pure func existing_package(
	builder: DiscoveryBuilder,
	kind: PackageKind,
	name: String,
) -> Option[PackageId]:
	var found: Option[PackageId] = None
	var row: Int = 0

	for package in builder.packages:
		if (
			package.kind == kind
			and builder.name_spellings.get(package.name.name_id_index()) == Some(name)
		):
			found = Some(package_id_at_row(row))
			break

		row += 1

	found


---
The import requests of `module`'s import rows, in source order.
---
private pure func module_import_requests(
	builder: DiscoveryBuilder,
	module: ModuleId,
	candidate: SourceCandidate,
) -> List[PendingImport]:
	var requests: List[PendingImport] = []

	match builder.modules.get(module.module_id_index()):
		Some(module_row):
			requester: ImportRequester = {
				canonical_path = candidate.path,
				placement = candidate.placement
			}

			for index in module_row.imports.first..module_row.imports.first + module_row.imports.count:
				match builder.imports.get(index):
					Some(import_row):
						requests = requests.append({
							import_id = import_id_at_row(index),
							request = {
								shape = import_row.request,
								parts = builder.import_path_part_spellings(import_row),
								requester = requester
							},
						})
					None:
						void
		None:
			void

	requests


private pure func import_path_part_spellings(
	builder: DiscoveryBuilder,
	import_row: ImportRow,
) -> List[String]:
	var parts: List[String] = []

	for index in import_row.path_parts.first..import_row.path_parts.first + import_row.path_parts.count:
		match builder.import_path_parts.get(index):
			Some(part):
				parts = parts.append(
					builder.name_spellings
						.get(part.name_id_index())
						.get_or(""),
				)
			None:
				void

	parts


-- Diagnostics.
private pure func import_span(builder: DiscoveryBuilder, import_id: ImportId) -> Span:
	match builder.imports.get(import_id.import_id_index()):
		Some(import_row):
			import_row.span
		None:
			NO_SPAN


---
Reports that `import_id` loaded no module, as `diagnostic`.
---
private pure func report_import(
	builder: DiscoveryBuilder,
	import_id: ImportId,
	diagnostic: ResolutionDiagnostic,
) -> DiscoveryBuilder:
	span: Span = builder.import_span(import_id)
	builder.append_resolution_diagnostic_at(span, diagnostic)


---
Reports that `import_id` names a module stored under different letter case:
its id, then the interned stored spelling (its names joined by `/`).
---
private pure func report_import_case_mismatch(
	builder: DiscoveryBuilder,
	import_id: ImportId,
	stored_names: List[String],
) -> DiscoveryBuilder:
	stored_path: String = stored_names.join("/")
	stored_path_id: PathId = builder.interned_path_id(stored_path)
	span: Span = builder.import_span(import_id)
	builder
		.intern_path(stored_path)
		.append_resolution_diagnostic_at(
			span,
			ImportCaseMismatch(import_id, stored_path_id),
		)


private pure func report_rejected_import(
	builder: DiscoveryBuilder,
	import_id: ImportId,
	rejection: SourceRejection,
	byte_length: Int,
) -> DiscoveryBuilder:
	span: Span = builder.import_span(import_id)

	match rejection:
		SourceTooLargeToSpan:
			builder.append_resolution_diagnostic_at(span, ImportSourceTooLarge(byte_length))
		TooManySourcesToSpan:
			builder.append_resolution_diagnostic_at(span, ImportTooManySources)


private pure func report_root(
	builder: DiscoveryBuilder,
	request_path: PathId,
	diagnostic: RootDiagnostic,
) -> DiscoveryBuilder:
	builder.append_root({
		request_path = request_path,
		outcome = RootRejected(diagnostic),
	})


---
Reports that the root `request_path` names a source stored under different letter case, with
the interned stored spelling as the argument.
---
private pure func report_root_case_mismatch(
	builder: DiscoveryBuilder,
	request_path: PathId,
	stored_names: List[String],
) -> DiscoveryBuilder:
	stored_path: String = stored_names.join("/")
	stored_path_id: PathId = builder.interned_path_id(stored_path)
	builder
		.intern_path(stored_path)
		.append_root({
			request_path = request_path,
			outcome = RootRejected(RootCaseMismatch(stored_path_id)),
		})


private pure func report_rejected_root(
	builder: DiscoveryBuilder,
	request_path: PathId,
	rejection: SourceRejection,
	byte_length: Int,
) -> DiscoveryBuilder:
	match rejection:
		SourceTooLargeToSpan:
			builder.report_root(request_path, RootSourceTooLarge(byte_length))
		TooManySourcesToSpan:
			builder.report_root(request_path, RootTooManySources)


---
Reports that implicit module `request_path` loaded no module, as `diagnostic`.
---
private pure func report_implicit(
	builder: DiscoveryBuilder,
	request_path: PathId,
	diagnostic: ImplicitDiagnostic,
) -> DiscoveryBuilder:
	builder.append_implicit_request({
		request_path = request_path,
		outcome = ImplicitRejected(diagnostic),
	})


private pure func report_rejected_implicit(
	builder: DiscoveryBuilder,
	request_path: PathId,
	rejection: SourceRejection,
	byte_length: Int,
) -> DiscoveryBuilder:
	match rejection:
		SourceTooLargeToSpan:
			builder.report_implicit(request_path, ImplicitSourceTooLarge(byte_length))
		TooManySourcesToSpan:
			builder.report_implicit(request_path, ImplicitTooManySources)
