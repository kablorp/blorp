-- Resolve test-specific environment variables before building an execution
-- plan. CLI options win, and the test timeout precedes the generic timeout.
import:
	../lib/cli_args: CliRunArgs, CliSanitizerMode(CliSanitizeOff), CliTestArgs
	../lib/run_environment: CliRunEnvironment, resolve_run_args_environment
	system: getenv


private DEFAULT_TEST_TIMEOUT_SECONDS: Int = 30


record CliTestEnvironment {
	test_timeout: Option[String],
	timeout: Option[String],
	sanitizer: Option[String],
	leak_check: Option[String]
}


private pure func selected_timeout(environment: CliTestEnvironment) -> Option[String]:
	match environment.test_timeout:
		Some(value):
			Some(value)
		None:
			environment.timeout


private pure func test_run_options(options: CliTestArgs) -> CliRunArgs:
	{
		profile = options.profile,
		debug = True,
		sanitizer = options.sanitizer,
		leak_check = options.leak_check,
		release = False,
		no_format = True,
		timeout = options.timeout,
		threads = None,
		std_dir = options.std_dir,
		files = [],
		user_args = []
	}


private pure func sanitizer_is_active(sanitizer: Option[CliSanitizerMode]) -> Bool:
	match sanitizer:
		None:
			False
		Some(CliSanitizeOff):
			False
		Some(_):
			True


pure func resolve_test_args_environment(
	options: CliTestArgs,
	environment: CliTestEnvironment,
) -> Result[CliTestArgs, String]:
	resolved ?= resolve_run_args_environment(
		test_run_options(options),
		{
			timeout = selected_timeout(environment),
			sanitizer = environment.sanitizer,
			leak_check = environment.leak_check,
			threads = None,
			no_format = None
		},
	)

	resolved_options: CliTestArgs = { options |
		timeout = Some(resolved.timeout.get_or(DEFAULT_TEST_TIMEOUT_SECONDS)),
		sanitizer = resolved.sanitizer,
		leak_check = resolved.leak_check
	}

	if resolved_options.maximal_artifacts and sanitizer_is_active(resolved_options.sanitizer):
		Err("Error: --maximal-artifacts cannot be used with sanitizers")
	else:
		Ok(resolved_options)


func resolve_current_test_args_environment(options: CliTestArgs) -> Result[CliTestArgs, String]:
	resolve_test_args_environment(
		options,
		{
			test_timeout = getenv("BLORP_TEST_TIMEOUT"),
			timeout = getenv("BLORP_TIMEOUT"),
			sanitizer = getenv("BLORP_SANITIZE"),
			leak_check = getenv("BLORP_LEAK_CHECK")
		},
	)
