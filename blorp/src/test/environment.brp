-- Resolve test-command environment variables before building an execution
-- plan. CLI options win.
import:
	../lib/cli_args: CliRunArgs, CliTestArgs
	../lib/run_environment: resolve_run_args_environment, resolved_integer_option
	system: getenv


private DEFAULT_TEST_TIMEOUT_SECONDS: Int = 30


record CliTestEnvironment {
	test_timeout: Option[String],
	leak_check: Option[String]
}


private pure func test_run_options(options: CliTestArgs) -> CliRunArgs:
	{
		profile = options.profile,
		debug = True,
		sanitizer = options.sanitizer,
		leak_check = options.leak_check,
		memory_diagnostics = True,
		memory_stats = False,
		release = options.release,
		c_translation_units = options.c_translation_units,
		no_format = True,
		timeout = None,
		threads = None,
		std_dir = options.std_dir,
		files = [],
		user_args = []
	}


pure func resolve_test_args_environment(
	options: CliTestArgs,
	environment: CliTestEnvironment,
) -> Result[CliTestArgs, String]:
	timeout ?= resolved_integer_option(
		options.timeout,
		"BLORP_TEST_TIMEOUT/--timeout",
		environment.test_timeout,
		True,
	)
	resolved ?= resolve_run_args_environment(
		test_run_options(options),
		{
			leak_check = environment.leak_check,
			threads = None
		},
	)

	resolved_options: CliTestArgs = { options |
		timeout = Some(timeout.get_or(DEFAULT_TEST_TIMEOUT_SECONDS)),
		leak_check = resolved.leak_check
	}

	Ok(resolved_options)


func resolve_current_test_args_environment(options: CliTestArgs) -> Result[CliTestArgs, String]:
	resolve_test_args_environment(
		options,
		{
			test_timeout = getenv("BLORP_TEST_TIMEOUT"),
			leak_check = getenv("BLORP_LEAK_CHECK")
		},
	)
