-- Typed planning for the Blorp-owned test command.
import:
	../compiler/frontend_request: FrontendCompilationGraph
	../compiler/stage_02_lex/parse_diagnostic: parse_diagnostic_to_string
	../compiler/stage_03_parse/parsed_ast: ParsedProgram
	../lib/cli_args:
		CliAction(CliTest),
		CliRunArgs,
		CliTestArgs,
		CliTestMode(CliTestAll, CliTestDocOnly, CliTestSuiteOnly),
	../lib/cli_plan:
		CliParsedSourceFile,
		CliRunSourcePlan,
		CliTestRunCommand(CliTestExecute),
		CliTestRunPlan,
	../lib/frontend_graph_identity: FrontendGraphSourceKey
	../lib/source_graph:
		frontend_compilation_graph_for_retained_roots,
		frontend_compilation_graph_for_roots,
		frontend_compilation_graph_with_generated_root,
		parse_cli_source,
		parsed_cli_source_from_program,
		source_graph_setup_for_paths,
	discovery:
		CliDiscoveredTestSource,
		CliTestSourceFeatures,
		CliTestSourcePath,
		discover_test_source_paths,
		discover_test_sources_from_paths,
	doctest:
		cli_doctest_case_origin,
		extract_cli_doctests,
		generate_cli_doctest_source_with_artifact_result,
	environment: resolve_current_test_args_environment
	fs: message
	generated_test_harness:
		GeneratedTestSuiteTarget,
		generate_doctest_batch_module,
		generate_suite_batch_module,
		generated_test_target_for_path,
	path: basename, dirname, join, normalize
	system: getcwd, getenv


enum CliBlorpTestArtifactKind:
	CliBlorpTestSuiteArtifact
	CliBlorpDoctestArtifact
	CliBlorpTestProgramArtifact


record CliBlorpTestSuitePlan {
	run_plan: CliRunSourcePlan,
	target: GeneratedTestSuiteTarget,
	kind: CliBlorpTestArtifactKind,
	progress_source_paths: List[String],
	emit_artifact_progress: Bool,
	diagnostic_context: List[String]
}


-- Source facts retained after one graph load of the selected test corpus.
record CliBlorpTestSourcePlan {
	features: CliTestSourceFeatures,
	is_leak_baseline_program: Bool,
	source_target: GeneratedTestSuiteTarget,
	doctest_target: Option[GeneratedTestSuiteTarget],
	doctest_diagnostic_context: List[String]
}


private record CliPreparedBlorpTestSource {
	source: CliDiscoveredTestSource,
	source_root: CliParsedSourceFile,
	doctest_root: Option[CliParsedSourceFile],
	doctest_diagnostic_context: List[String]
}


record CliBlorpTestPlan {
	command_args: List[String],
	test_args: CliTestArgs,
	mode: CliTestMode,
	run_options: CliRunArgs,
	repeat: Int,
	emit_artifact_result: Bool,
	candidate_paths: List[CliTestSourcePath]
}


record CliBlorpTestBatchPlan {
	graph: FrontendCompilationGraph,
	sources: List[CliBlorpTestSourcePlan]
}


union CliBlorpTestPlanning:
	CliBlorpTestPlanningFailed(String)
	CliBlorpTestReady(CliBlorpTestPlan)


private pure func test_run_options(args: CliTestArgs) -> CliRunArgs:
	-- Production test harnesses always retain debug blocks. The public test
	-- flag is reporting policy, not a distinct compilation mode.
	{
		profile = args.profile,
		debug = True,
		sanitizer = args.sanitizer,
		leak_check = args.leak_check,
		release = False,
		no_format = True,
		timeout = args.timeout,
		threads = None,
		std_dir = args.std_dir,
		files = [],
		user_args = []
	}


private pure func run_options_for_harness(options: CliRunArgs, harness_path: String) -> CliRunArgs:
	{ options | files = [harness_path] }


private pure func source_is_requested_for_sequential_route(
	mode: CliTestMode,
	source: CliDiscoveredTestSource,
) -> Bool:
	match mode:
		CliTestAll:
			(
				source.features.has_tests_binding
				or source.features.has_doctests
				or source.is_leak_baseline_program
			)
		CliTestDocOnly:
			source.features.has_doctests
		CliTestSuiteOnly:
			source.features.has_tests_binding or source.is_leak_baseline_program


private pure func source_is_supported_for_sequential_route(
	mode: CliTestMode,
	source: CliBlorpTestSourcePlan,
) -> Bool:
	if not source.features.has_main or source.is_leak_baseline_program:
		True
	else:
		match mode:
			CliTestDocOnly:
				True
			CliTestSuiteOnly:
				False
			CliTestAll:
				not source.features.has_tests_binding and source.features.has_doctests


private pure func parse_error_messages(program: ParsedProgram) -> List[String]:
	program.diagnostics.map(parse_diagnostic_to_string)


private func prepare_blorp_doctest_root(
	mode: CliTestMode,
	source: CliDiscoveredTestSource,
	emit_artifact_result: Bool,
) -> Result[Option[CliParsedSourceFile], String]:
	if mode != CliTestSuiteOnly and source.features.has_doctests:
		canonical_program = { source.program |
			source = { source.program.source | path = source.canonical_path }
		}
		generated_source ?= generate_cli_doctest_source_with_artifact_result(
			canonical_program,
			emit_artifact_result,
			source.is_standard_library_source,
		)
		generated = { generated_source |
			path = normalize(join(dirname(source.canonical_path), basename(generated_source.path)))
		}
		parsed = parse_cli_source(generated)
		Ok(Some(parsed))
	else:
		Ok(None)


private func prepare_blorp_test_source(
	mode: CliTestMode,
	source: CliDiscoveredTestSource,
	emit_artifact_result: Bool,
) -> Result[CliPreparedBlorpTestSource, String]:
	canonical_program = { source.program |
		source = { source.program.source | path = source.canonical_path }
	}
	source_root: CliParsedSourceFile = parsed_cli_source_from_program(canonical_program)
	doctest_root ?= prepare_blorp_doctest_root(mode, source, emit_artifact_result)

	doctest_diagnostic_context: List[String] = if doctest_root.is_some():
		extract_cli_doctests(canonical_program).map(cli_doctest_case_origin)
	else:
		[]

	Ok({
		source = source,
		source_root = source_root,
		doctest_root = doctest_root,
		doctest_diagnostic_context = doctest_diagnostic_context,
	})


private func prepare_blorp_test_sources(
	mode: CliTestMode,
	sources: List[CliDiscoveredTestSource],
	emit_artifact_result: Bool,
) -> Result[List[CliPreparedBlorpTestSource], String]:
	var prepared: List[CliPreparedBlorpTestSource] = []
	var error: Option[String] = None

	for source in sources:
		match prepare_blorp_test_source(mode, source, emit_artifact_result):
			Ok(value):
				prepared = prepared.append(value)
			Err(message):
				error = Some(message)
				break

	match error:
		Some(message):
			Err(message)
		None:
			Ok(prepared)


private pure func prepared_test_roots(
	prepared: List[CliPreparedBlorpTestSource],
) -> List[CliParsedSourceFile]:
	var roots: List[CliParsedSourceFile] = []

	for source in prepared:
		roots = roots.append(source.source_root)

		match source.doctest_root:
			Some(root):
				roots = roots.append(root)
			None:
				void

	roots


private pure func planned_doctest_target(
	doctest_root: Option[CliParsedSourceFile],
	graph: FrontendCompilationGraph,
) -> Result[Option[GeneratedTestSuiteTarget], String]:
	match doctest_root:
		Some(root):
			target ?= generated_test_target_for_path(graph, root.path)
			Ok(Some(target))
		None:
			Ok(None)


private pure func planned_test_source(
	source: CliPreparedBlorpTestSource,
	graph: FrontendCompilationGraph,
) -> Result[CliBlorpTestSourcePlan, String]:
	source_target ?= generated_test_target_for_path(graph, source.source_root.path)
	doctest_target ?= planned_doctest_target(source.doctest_root, graph)

	-- The generated harness supplies the semantic TestSuite boundary. Keep
	-- discovery structural so aliases and re-exports are resolved once by
	-- the real typechecker instead of duplicated in CLI planning.
	Ok({
		features = source.source.features,
		is_leak_baseline_program = source.source.is_leak_baseline_program,
		source_target = source_target,
		doctest_target = doctest_target,
		doctest_diagnostic_context = source.doctest_diagnostic_context,
	})


private pure func planned_test_sources(
	prepared: List[CliPreparedBlorpTestSource],
	graph: FrontendCompilationGraph,
) -> Result[List[CliBlorpTestSourcePlan], String]:
	var sources: List[CliBlorpTestSourcePlan] = []
	var error: Option[String] = None

	for source in prepared:
		match planned_test_source(source, graph):
			Ok(value):
				sources = sources.append(value)
			Err(message):
				error = Some(message)
				break

	match error:
		Some(message):
			Err(message)
		None:
			Ok(sources)


private func build_blorp_test_plan(
	plan: CliTestRunPlan,
	args: CliTestArgs,
	candidate_paths: List[CliTestSourcePath],
) -> Result[CliBlorpTestPlan, String]:
	emit_artifact_result: Bool = getenv("BLORP_GATE_RESULT")
		.map(func(value): value
				.trim()
				.length() > 0)
		.get_or(False)

	Ok({
		command_args = plan.args,
		test_args = args,
		mode = args.mode,
		run_options = test_run_options(args),
		repeat = args.repeat,
		emit_artifact_result = emit_artifact_result,
		candidate_paths = candidate_paths,
	})


func build_blorp_test_batch(
	plan: CliBlorpTestPlan,
	candidate_paths: List[CliTestSourcePath],
) -> Result[Option[CliBlorpTestBatchPlan], String]:
	sources ?= discover_test_sources_from_paths(
		candidate_paths,
		plan.test_args.leak_check,
	).map_err(
		func(error): "test discovery failed: ${message(error)}",
	)
	parse_errors: List[String] = sources.flat_map(
		func(source): parse_error_messages(source.program),
	)

	if parse_errors.length() > 0:
		Err(parse_errors.join("\n"))
	else:
		requested_sources = sources.filter(
			func(source): source_is_requested_for_sequential_route(plan.mode, source),
		)

		if requested_sources.length() == 0:
			Ok(None)
		else:
			prepared ?= prepare_blorp_test_sources(
				plan.mode,
				requested_sources,
				plan.emit_artifact_result,
			)
			graph ?= frontend_compilation_graph_for_roots(
				CliTest(plan.test_args),
				prepared_test_roots(prepared),
			)
			runnable_sources ?= planned_test_sources(prepared, graph)

			if runnable_sources.length() == 0:
				Ok(None)
			else if not runnable_sources.all(
				func(source): source_is_supported_for_sequential_route(plan.mode, source),
			):
				Err("Error: TestSuite sources must not define `main`")
			else:
				Ok(Some({
					graph = graph,
					sources = runnable_sources,
				}))


func materialize_blorp_test_suites(
	plan: CliBlorpTestPlan,
	batch: CliBlorpTestBatchPlan,
	sources: List[CliBlorpTestSourcePlan],
) -> Result[CliBlorpTestSuitePlan, String]:
	if sources.length() == 0:
		Err("cannot materialize an empty TestSuite batch")
	else:
		targets: List[GeneratedTestSuiteTarget] = sources.map(func(source): source.source_target)
		root_keys: List[FrontendGraphSourceKey] = targets.map(func(target):
			key: FrontendGraphSourceKey = {
				path = target.path,
				module_name = target.module_name
			}
			key
		)
		base ?= frontend_compilation_graph_for_retained_roots(batch.graph, root_keys)
		generated = generate_suite_batch_module(
			targets,
			plan.run_options.leak_check,
			plan.emit_artifact_result,
		)
		graph ?= frontend_compilation_graph_with_generated_root(base, generated)

		Ok({
			run_plan = {
				args = plan.command_args,
				options = run_options_for_harness(plan.run_options, generated.source.path),
				graph = graph
			},
			target = {
				path = generated.source.path,
				module_name = generated.source.module_name
			},
			kind = CliBlorpTestSuiteArtifact,
			progress_source_paths = targets.map(func(target): target.path),
			emit_artifact_progress = plan.emit_artifact_result,
			diagnostic_context = [],
		})


private pure func planned_doctest_targets(
	sources: List[CliBlorpTestSourcePlan],
) -> Result[List[GeneratedTestSuiteTarget], String]:
	var targets: List[GeneratedTestSuiteTarget] = []
	var missing_target: Bool = False

	for source in sources:
		match source.doctest_target:
			Some(target):
				targets = targets.append(target)
			None:
				missing_target = True
				break

	if missing_target:
		Err("test source contains no planned doctest root")
	else:
		Ok(targets)


func materialize_blorp_doctest_batch(
	plan: CliBlorpTestPlan,
	batch: CliBlorpTestBatchPlan,
	sources: List[CliBlorpTestSourcePlan],
) -> Result[CliBlorpTestSuitePlan, String]:
	if sources.length() == 0:
		Err("cannot materialize an empty doctest batch")
	else:
		targets ?= planned_doctest_targets(sources)
		diagnostic_context: List[String] = sources.flat_map(
			func(source): source.doctest_diagnostic_context,
		)
		root_keys: List[FrontendGraphSourceKey] = targets.map(func(target):
			key: FrontendGraphSourceKey = {
				path = target.path,
				module_name = target.module_name
			}
			key
		)
		base ?= frontend_compilation_graph_for_retained_roots(batch.graph, root_keys)
		generated = generate_doctest_batch_module(targets, plan.emit_artifact_result)
		graph ?= frontend_compilation_graph_with_generated_root(base, generated)

		Ok({
			run_plan = {
				args = plan.command_args,
				options = run_options_for_harness(plan.run_options, generated.source.path),
				graph = graph
			},
			target = {
				path = generated.source.path,
				module_name = generated.source.module_name
			},
			kind = CliBlorpDoctestArtifact,
			progress_source_paths = sources.map(func(source): source.source_target.path),
			emit_artifact_progress = plan.emit_artifact_result,
			diagnostic_context = diagnostic_context,
		})


func materialize_blorp_test_program(
	plan: CliBlorpTestPlan,
	batch: CliBlorpTestBatchPlan,
	source: CliBlorpTestSourcePlan,
) -> Result[CliBlorpTestSuitePlan, String]:
	graph ?= frontend_compilation_graph_for_retained_roots(
		batch.graph,
		[
			{
				path = source.source_target.path,
				module_name = source.source_target.module_name
			},
		],
	)

	Ok({
		run_plan = {
			args = plan.command_args,
			options = run_options_for_harness(plan.run_options, source.source_target.path),
			graph = graph
		},
		target = source.source_target,
		kind = CliBlorpTestProgramArtifact,
		progress_source_paths = [source.source_target.path],
		emit_artifact_progress = plan.emit_artifact_result,
		diagnostic_context = [],
	})


func plan_blorp_tests(plan: CliTestRunPlan) -> CliBlorpTestPlanning:
	match plan.command:
		CliTestExecute(args):
			match resolve_current_test_args_environment(args):
				Err(message):
					CliBlorpTestPlanningFailed("Error: ${message}")
				Ok(resolved_args):
					source_graph_setup = source_graph_setup_for_paths(
						CliTest(resolved_args),
						resolved_args.paths,
					)

					match discover_test_source_paths(
						resolved_args.paths,
						getcwd(),
						source_graph_setup.context.std_dir,
					):
						Err(error):
							CliBlorpTestPlanningFailed("test discovery failed: ${message(error)}")
						Ok(candidate_paths):
							if candidate_paths.length() == 0:
								CliBlorpTestPlanningFailed("Error: no runnable tests found")
							else:
								match build_blorp_test_plan(plan, resolved_args, candidate_paths):
									Ok(test_plan):
										CliBlorpTestReady(test_plan)
									Err(message):
										CliBlorpTestPlanningFailed(message)
		_:
			CliBlorpTestPlanningFailed("internal error: expected a test execution plan")
