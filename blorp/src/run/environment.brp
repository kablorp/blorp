-- Run-command environment boundary. CLI options always win over process
-- environment values; the shared resolver remains pure for test planning.
import:
	../lib/cli_args: CliRunArgs
	../lib/run_environment: CliRunEnvironment, resolve_run_args_environment
	system: getenv


func resolve_current_run_args_environment(options: CliRunArgs) -> Result[CliRunArgs, String]:
	environment: CliRunEnvironment = {
		timeout = getenv("BLORP_TIMEOUT"),
		sanitizer = getenv("BLORP_SANITIZE"),
		leak_check = getenv("BLORP_LEAK_CHECK"),
		threads = getenv("BLORP_THREADS"),
		no_format = getenv("BLORP_NO_FORMAT")
	}

	resolve_run_args_environment(options, environment)
