-- Public run-command orchestration. Shared host preparation and captured
-- execution live in lib/run_effect because the test command uses them too.
import:
	../lib/cli_plan: CliHandledResult, CliRunSourcePlan
	../lib/compilation:
		RunArtifactExecution(RunArtifactFailed, RunArtifactReady, RunArtifactStopped),
	../lib/compile_plan_execute: execute_run_artifact_plan
	../lib/run_effect:
		CliRunEffectConfiguration,
		build_compiled_run_executable,
		execute_interactive_compiled_run,
		run_effect_error,


func execute_run_command(
	plan: CliRunSourcePlan,
	configuration: CliRunEffectConfiguration,
) -> CliHandledResult:
	match execute_run_artifact_plan(plan):
		RunArtifactReady(artifact):
			execute_interactive_compiled_run(plan, artifact, configuration)
		RunArtifactStopped:
			run_effect_error("internal error: run compilation stopped unexpectedly")
		RunArtifactFailed(message):
			run_effect_error(message)


func build_run_executable(
	plan: CliRunSourcePlan,
	output_path: String,
	configuration: CliRunEffectConfiguration,
) -> CliHandledResult:
	match execute_run_artifact_plan(plan):
		RunArtifactReady(artifact):
			build_compiled_run_executable(artifact, output_path, configuration)
		RunArtifactStopped:
			run_effect_error("internal error: executable compilation stopped unexpectedly")
		RunArtifactFailed(message):
			run_effect_error(message)
