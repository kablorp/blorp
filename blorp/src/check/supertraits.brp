---
Supertrait obligations. Every implementation of a trait comes with an
implementation of each direct supertrait for the same receiver head, and its
own receiver bounds entail the bounds that implementation requires. Specialize
relies on this when it selects a supertrait method for a grounded receiver.
The check takes FinalTraits, so it reads the implementations that remain after
finalization has removed any automatic equality it could not prove finite; a
use through an entailed bound is invisible to that removal.
---
import:
    bool: Bool methods
    list: List methods
    option: Option methods
    ../namespace/namespace: Namespace, TypeHead
    ../parse/assemble: ParsedContents
    ../utils/ids: TraitId, DeclarationInventory, ImplId
    ../utils/syntax: ParsedImplementationHeader, TypeSyntax
    ./errors:
        CheckError,
        checker_invariant,
        or_checker_invariant,
        CheckerInvariant(InvalidFunctionContract),
        trait_error,
        TraitError(SupertraitNotImplemented, SupertraitBoundNotEntailed),
        AbsentSupertrait(NeverImplemented, AutomaticEqualityRejected, AutomaticEqualityNotFinite),
    ./model: AcceptedTraits, AggregateId, ImplementationHeader, CanonicalEquality
    ./recursion: FinalTraits
    ./traits: TraitAvailability, entails


-- Why `head` has no implementation of `supertrait`.
private pure func absent_cause(
    traits: AcceptedTraits,
    availability: TraitAvailability,
    removed: List[AggregateId],
    supertrait: TraitId,
    head: TypeHead,
) -> AbsentSupertrait:
    automatic = match traits.canonical.equality:
        Some(contract): contract.canonical_owner() == supertrait
        None: False
    if automatic.not():
        NeverImplemented
    else if removed.any(pure func(aggregate): aggregate.aggregate_head() == head):
        AutomaticEqualityNotFinite
    else:
        match availability.unavailable_equality_member(head):
            Some(member): AutomaticEqualityRejected(member)
            None: NeverImplemented


-- Receivers are complete families of fresh parameters, so comparing bounds
-- position by position decides what proving the supertrait on the receiver
-- would, without minting parameter identities.
private pure func implementation_obligations(
    written: ParsedImplementationHeader,
    header: ImplementationHeader,
    implemented: TraitId,
    final: FinalTraits,
    availability: TraitAvailability,
) -> Result[Void, CheckError]:
    traits = final.final_traits()
    span = written.trait_name.type_span()
    declaration ?= traits.declarations
        .get(implemented.trait_number())
        .or_checker_invariant(span, InvalidFunctionContract)
    var failure: Option[CheckError] = None
    for supertrait in declaration.supertraits:
        if failure.is_none():
            match traits.family_for(supertrait.required_trait, header.receiver_head):
                None:
                    cause = traits.absent_cause(
                        availability,
                        final.removed_equalities(),
                        supertrait.required_trait,
                        header.receiver_head,
                    )
                    failure = Some(
                        trait_error(
                            span,
                            SupertraitNotImplemented(
                                implemented,
                                supertrait.required_trait,
                                written.receiver,
                                cause,
                            ),
                        ),
                    )
                Some(family):
                    var position = 0
                    for required in family.parameter_bounds:
                        if failure.is_none():
                            match (
                                header.parameter_bounds.get(position),
                                written.type_parameters.get(position),
                            ):
                                (Some(held), Some(parameter)):
                                    for bound in required:
                                        entailed = held.any(
                                            pure func(declared): traits.declarations.entails(
                                                declared.required_trait,
                                                bound.required_trait,
                                            ),
                                        )
                                        if failure.is_none().and(entailed.not()):
                                            failure = Some(
                                                trait_error(
                                                    span,
                                                    SupertraitBoundNotEntailed(
                                                        implemented,
                                                        bound.required_trait,
                                                        parameter.name,
                                                        written.receiver,
                                                    ),
                                                ),
                                            )
                                _: failure = Some(checker_invariant(span, InvalidFunctionContract))
                        position = position + 1
    match failure:
        Some(error): Err(error)
        None: Ok(void)


-- Automatic implementations are canonical Equatable's, which declares no
-- supertraits, so the authored implementation rows are every subtrait one.
pure func validate_supertrait_implementations(
    parsed: ParsedContents,
    namespace: Namespace,
    headers: List[ImplementationHeader],
    availability: TraitAvailability,
    final: FinalTraits,
) -> Result[Void, CheckError]:
    var failure: Option[CheckError] = None
    for row in parsed.declarations.inventory_implementations():
        if failure.is_none():
            match (
                namespace.implementation_trait(row.header.module, row.id),
                headers.get(row.id.impl_number()),
            ):
                (Some(implemented), Some(header)):
                    match row.header.implementation_obligations(
                        header,
                        implemented,
                        final,
                        availability,
                    ):
                        Ok(_): void
                        Err(error): failure = Some(error)
                _: failure = Some(checker_invariant(row.header.span, InvalidFunctionContract))
    match failure:
        Some(error): Err(error)
        None: Ok(void)
