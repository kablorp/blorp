-- Public check-command reporting and exit policy.
--
-- Frontend validation remains frontend-only through the shared application
-- boundary; this owner formats the resulting diagnostics and summaries.
import:
	../lib/cli_plan: CliCheckPlan, CliHandledResult
	../lib/diagnostic: cli_error_message
	../lib/frontend_validation: FrontendValidationReport, validate_frontend_graph


private pure func append_output(output: String, text: String) -> String:
	if text.length() == 0:
		output
	else if output.length() == 0:
		text
	else:
		output + "\n" + text


private pure func append_messages(output: String, messages: List[String]) -> String:
	var result = output

	for message in messages:
		result = append_output(result, message)

	result


pure func finish_check_command(report: FrontendValidationReport) -> CliHandledResult:
	var stdout: String = ""
	var stderr: String = append_messages("", report.graph_diagnostics.map(cli_error_message))
	var failed: Bool = report.graph_diagnostics.length() != 0
	multiple_roots: Bool = report.roots.length() > 1

	for root in report.roots:
		if multiple_roots:
			stdout = append_output(stdout, "Checking ${root.path}")

		stdout = append_output(stdout, root.parsed_summary.get_or(""))

		if root.errors.length() == 0:
			stdout = append_output(stdout, root.typed_summary.get_or(""))
			stdout = append_output(stdout, "Type checking succeeded.")
		else:
			failed = True
			stderr = append_messages(stderr, root.errors)

	status: Int = if failed:
		1
	else:
		0

	{
		status = status,
		stdout = stdout,
		stderr = stderr
	}


pure func execute_check_plan(plan: CliCheckPlan) -> CliHandledResult:
	finish_check_command(validate_frontend_graph(
		plan.graph,
		{
			allow_debug_only_calls = plan.options.debug,
			include_parsed_summary = plan.options.dump_ast,
			include_typed_summary = plan.options.dump_typed_ast,
		},
	))
