---
Admit complete receiver scopes before bodies are elaborated. Transient name-keyed
groups preserve rejection order and use introduction-route upper bounds. Each
unordered pair is checked once; only the exact inherited prelude subset reuses a proof.
---
import:
	option: Option methods
	bool: Bool methods
	./callables: accepted_function, Namespace methods, ReceiverFunction methods
	./errors: CheckError, CheckerInvariant(InvalidResolvedFunction, InvalidReceiverScope), MethodError(OverlappingReceivers), checker_invariant, method_error
	./inference: TypeRef methods
	./model: AcceptedTraits, ReceiverFunction, ReceiverLookup(VisibleMethod, VisibleFunctions), AdmittedReceiverScope, TypeRef
	./signatures: AcceptedFunction
	../namespace/namespace: Namespace, MethodImport, Entry, Entity(Method)
	../parse/assemble: ModuleImport, ParsedModuleRow
	../parse/parse: ImportSelection(NamedSelection)
	../utils/ids: FunctionId
	dict as D
	../utils/names: NameId
	../utils/source: ModuleId, ModuleKind(UserModule, FoundationPreludeModule)
	../utils/syntax: Span, WrittenName, compiler_span
	list: repeat, List methods
	int: Int methods


private fixed record IntroducedName {
	written: WrittenName,
	candidate_bound: Int
}


private pure func count_introduction(names: Dict[NameId, IntroducedName], written: WrittenName, inherited_count: Int) -> Dict[NameId, IntroducedName]:
	key = written.id
	match names.get(key):
		None: names.set(key, { written = written, candidate_bound = inherited_count + 1 })
		Some(previous): names.set(key, { previous | candidate_bound = previous.candidate_bound + 1 })


private pure func name_counts(signatures: List[AcceptedFunction]) -> Dict[NameId, Int]:
	var counts: Dict[NameId, Int] = D.dict(signatures.length())
	for accepted in signatures:
		if accepted.signature.parameters.is_empty().not():
			key = accepted.declaration.function_name.id
			counts = counts.set(key, counts.get(key).get_or(0) + 1)
	counts


-- Explicit function selections and the written suffix of the namespace's method
-- edges introduce candidates. The prelude prefix is already validated.
private pure func selected_receiver(request: ModuleImport, accepted: AcceptedFunction, methods: List[MethodImport], first_method: Int) -> Bool:
	var selected: Bool = False
	for selection in request.symbols:
		match selection:
			NamedSelection(written):
				if written.id == accepted.declaration.function_name.id:
					selected = True
			_: void
	match accepted.signature.parameters.get(0):
		None: void
		Some(parameter):
			match parameter.value_type.type_head():
				None: void
				Some(head):
					for position in first_method..methods.length():
						match methods.get(position):
							Some(edge):
								if (edge.target == request.target).and(edge.receiver == head):
									selected = True
							None: void
	selected


private pure func introduced_names(namespace: Namespace, signatures: List[AcceptedFunction], counts: Dict[NameId, Int], row: ParsedModuleRow, first_method: Int, inherited: Dict[NameId, List[FunctionId]]) -> Result[Dict[NameId, IntroducedName], CheckError]:
	var names: Dict[NameId, IntroducedName] = {}
	none: List[FunctionId] = []
	var failure: Option[CheckError] = None
	for own_entry in namespace.module_entries(row.module):
		match own_entry.declared_function():
			None: void
			Some(own_id):
				match signatures.get(own_id.function_number()):
					None: failure = Some(checker_invariant(row.end, InvalidResolvedFunction(own_id)))
					Some(accepted):
						key = accepted.declaration.function_name.id
						if accepted.signature.parameters.is_empty().not().and(counts.get(key).get_or(0) > 1):
							names = names.count_introduction(accepted.declaration.function_name, inherited.get(key).get_or(none).length())
	methods = namespace.method_imports(row.module)
	for request in row.imports:
		for provider_entry in namespace.module_entries(request.target):
			match provider_entry.offered_function():
				None: void
				Some(offered_id):
					match signatures.get(offered_id.function_number()):
						None: failure = Some(checker_invariant(request.span, InvalidResolvedFunction(offered_id)))
						Some(accepted):
							key = accepted.declaration.function_name.id
							if accepted.signature.parameters.is_empty().not().and(counts.get(key).get_or(0) > 1):
								provided_ids = inherited.get(key).get_or(none)
								receiver_selected = match accepted.id.is_inherited(provided_ids).not():
									True: request.selected_receiver(accepted, methods, first_method)
									False: False

								if receiver_selected:
									names = names.count_introduction(accepted.declaration.function_name, provided_ids.length())
	match failure:
		Some(invariant): Err(invariant)
		None: Ok(names)


private pure func is_inherited(id: FunctionId, inherited: List[FunctionId]) -> Bool:
	var found: Bool = False
	for supplied in inherited:
		if id == supplied:
			found = True
			break
	found


private pure func reject_pair(name: WrittenName, left: ReceiverFunction, right: ReceiverFunction, inherited: List[FunctionId], signatures: List[AcceptedFunction]) -> Result[Void, CheckError]:
	left_function ?= accepted_function(name.span, left.id, signatures)
	right_function ?= accepted_function(name.span, right.id, signatures)
	left_inherited = inherited.is_empty().not().and(left.id.is_inherited(inherited))
	right_inherited = inherited.is_empty().not().and(right.id.is_inherited(inherited))
	if left_inherited.and(right_inherited):
		Ok(void)
	else:
		introduced = if right_inherited:
			left
		else:
			right
		other = if right_inherited:
			right
		else:
			left
		introduced_function = if right_inherited:
			left_function
		else:
			right_function
		other_function = if right_inherited:
			right_function
		else:
			left_function
		span = introduced.candidate_span(introduced_function.declaration.function_name.span)
		match introduced_function.signature.parameters.get(0):
			None: Ok(void)
			Some(introduced_parameter):
				match other_function.signature.parameters.get(0):
					None: Ok(void)
					Some(other_parameter):
						match other_parameter.value_type.types_overlap(other_function.signature.type_parameters, introduced_parameter.value_type, introduced_function.signature.type_parameters, span):
							Err(invariant): Err(invariant)
							Ok(False): Ok(void)
							Ok(True): Err(method_error(span, OverlappingReceivers(name.id, {
								introduced = introduced.method_site(introduced_function.declaration.function_name.span), introduced_receiver = introduced_parameter.value_type,
								other = other.method_site(other_function.declaration.function_name.span), other_receiver = other_parameter.value_type
							})))


private pure func reject_group(name: WrittenName, candidates: List[ReceiverFunction], inherited: List[FunctionId], signatures: List[AcceptedFunction]) -> Result[Void, CheckError]:
	var failure: Option[CheckError] = None
	var right_position = 0
	for right_candidate in candidates:
		var left_position = 0
		for left_candidate in candidates:
			if left_position == right_position:
				break
			match reject_pair(name, left_candidate, right_candidate, inherited, signatures):
				Ok(_): void
				Err(clash): failure = Some(clash)
			if failure.is_some():
				break
			left_position = left_position + 1
		if failure.is_some():
			break
		right_position = right_position + 1
	match failure:
		Some(clash): Err(clash)
		None: Ok(void)


-- Dependency order proves inherited overlap pairs first; the published table
-- uses module ordinals, which need not follow that order.
pure func admit_receivers(namespace: Namespace, signatures: List[AcceptedFunction], module_count: Int, modules: List[ParsedModuleRow], traits: AcceptedTraits) -> Result[List[AdmittedReceiverScope], CheckError]:
	counts = signatures.name_counts()
	unprovided: Dict[NameId, List[FunctionId]] = {}
	var supplied = unprovided
	var supplied_methods = 0
	var pending: List[Option[AdmittedReceiverScope]] = repeat(None, module_count)
	var failure: Option[CheckError] = None
	for row in modules:
		position = row.module.module_number()
		match pending.get(position):
			Some(None): void
			_:
				failure = Some(checker_invariant(row.end, InvalidReceiverScope))
				break
		var admitted: Dict[NameId, ReceiverLookup] = {}
		match namespace.receiver_functions(signatures, row.module):
			Err(error): failure = Some(error)
			Ok(names): admitted = names
		if failure.is_some():
			break
		-- Preserve the existing family-before-overlap order and both name orders.
		if traits.declarations.is_empty().not():
			match namespace.admit_module_families(traits, signatures, row, admitted):
				Err(error): failure = Some(error)
				Ok(names): admitted = names
			if failure.is_some():
				break
		first_method = match row.role:
			UserModule: supplied_methods
			_: 0
		inherited_names = match row.role:
			UserModule: supplied
			_: unprovided
		match namespace.introduced_names(signatures, counts, row, first_method, inherited_names):
			Err(invariant): failure = Some(invariant)
			Ok(names):
				for introduction in names.values():
					publishes_prelude: Bool = match row.role:
						FoundationPreludeModule: True
						_: False
					if publishes_prelude.not().and(introduction.candidate_bound == 1):
						continue
					written = introduction.written
					key = written.id
					match admitted.get(key):
						Some(VisibleFunctions(candidates)):
							none: List[FunctionId] = []
							inherited = inherited_names.get(key).get_or(none)
							match reject_group(written, candidates, inherited, signatures):
								Err(clash): failure = Some(clash)
								Ok(_): void
							match row.role:
								FoundationPreludeModule:
									var provided_ids: List[FunctionId] = []
									for candidate in candidates:
										if candidate.import_site.is_some():
											provided_ids = provided_ids.append(candidate.id)
									supplied = supplied.set(key, provided_ids)
								_: void
						Some(VisibleMethod(_)) | None: void
					if failure.is_some():
						break
		if failure.is_some():
			break
		pending = pending.set(position, Some({ names = admitted }))
		match row.role:
			FoundationPreludeModule: supplied_methods = namespace.method_imports(row.module).length()
			_: void
		if failure.is_some():
			break
	var scopes: List[AdmittedReceiverScope] = []
	for scope in pending:
		if failure.is_some():
			break
		match scope:
			Some(admitted): scopes = scopes.append(admitted)
			None: failure = Some(checker_invariant(compiler_span(), InvalidReceiverScope))
	match failure:
		Some(clash): Err(clash)
		None: Ok(scopes)


-- `names` with `name`, unless it holds the name already: the first
-- occurrence keeps its place and span.
private pure func with_receiver_name(names: Dict[NameId, WrittenName], name: WrittenName) -> Dict[NameId, WrittenName]:
	match names.get(name.id):
		Some(_): names
		None: names.set(name.id, name)


-- Family clashes do not depend on a future receiver type or an actual call.
-- Query receiver visibility at admission, including type imports,
-- once per name: the answer depends only on the module and the name, and each
-- method edge to one target lists that target's names again.
private pure func admit_module_families(namespace: Namespace, traits: AcceptedTraits, signatures: List[AcceptedFunction], row: ParsedModuleRow, functions: Dict[NameId, ReceiverLookup]) -> Result[Dict[NameId, ReceiverLookup], CheckError]:
	var names: Dict[NameId, WrittenName] = {}
	for entry in namespace.module_entries(row.module):
		match entry.entity:
			Method(_): names = names.with_receiver_name(entry.name)
			_: void
	for imported in namespace.method_imports(row.module):
		for entry in namespace.module_entries(imported.target):
			match entry.entity:
				Method(_): names = names.with_receiver_name(entry.name)
				_: void
	var admitted = functions
	var failure: Option[CheckError] = None
	for name in names.values():
		ordinary: Result[List[ReceiverFunction], CheckError] = match admitted.get(name.id):
			Some(VisibleFunctions(candidates)): Ok(candidates)
			None: Ok([])
			Some(VisibleMethod(_)): Err(checker_invariant(name.span, InvalidReceiverScope))
		match ordinary:
			Err(error): failure = Some(error)
			Ok(candidates):
				match namespace.admit_method_family(traits, signatures, row.module, name, candidates):
					Err(error): failure = Some(error)
					Ok(VisibleFunctions(_)): void
					Ok(lookup): admitted = admitted.set(name.id, lookup)
		if failure.is_some():
			break
	match failure:
		Some(error): Err(error)
		None: Ok(admitted)
