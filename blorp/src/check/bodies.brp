---
Checks function bodies: parameter scope, ordered statements, match arms
and patterns, and the canonical Void tail.
---
import:
    bool: Bool methods
    int: Int methods
    list: repeat, List methods
    option: Option methods
    result: Result methods
    ../namespace/builtins: DesignatedResult, DesignatedBoolean, DesignatedOption, RuntimeOperation
    ../namespace/namespace: Namespace
    ../utils/ids: OpaqueRow, VariantId
    ../utils/source: ModuleId
    ../utils/syntax:
        ParsedBinding,
        ParsedPropagation,
        compiler_span,
        ExpressionBase(MatchExpression, IfExpression, VoidExpression, RangeExpression),
        ForBinder(SingleForBinder, TupleForBinder),
        ParsedBlock,
        ParsedIf,
        ParsedWhile,
        ParsedFor,
        ParsedBinder(NamedBinder, DiscardBinder),
        ElseBranch(ElseIf, ElseBlock),
        ParsedMatch,
        ParsedMatchArm,
        ParsedParameter,
        ParsedPattern(
            PatternName,
            PatternWildcard,
            PatternConstructor,
            PatternOr,
            PatternList,
            PatternLiteral,
            PatternChar,
        ),
        PatternHead(BareHead, QualifiedHead),
        ParsedStatement(
            TupleBinding,
            BindingStatement,
            PropagatingBinding,
            ExpressionStatement,
            WhileLoop,
            ForLoop,
            Break,
            Continue,
        ),
        Span,
        ValueExpression,
        WrittenName,
        TypeSyntax,
    ./callables: ResolutionContext
    ./constructors: VariantContract, ConstructionContext
    ./declarations: CheckedDeclarations
    ./errors:
        CheckError,
        RecursionError(
            CallableTailRecursionUnsupported,
            GenericTailRecursionUnsupported,
            PropagationTailRecursionUnsupported,
        ),
        recursion_error,
        ValueError(ExpressionTypeMismatch, MissingIfElse, IfBranchWithoutValue),
        value_error,
        CheckerInvariant(
            InvalidReceiverScope,
            InvalidInferenceWorklist,
            InvalidCheckedUnion,
            InvalidResolvedParameter,
            UnsupportedPatternReachedResolution,
            LoopControlOutsideLoop,
            NestedPropagation,
            JoinWithoutArms,
        ),
        ExpectedTypeSite(
            FirstArmValue,
            FirstIfBranchValue,
            InferredBindingDeclaration,
            SourceAnnotation,
            ForRangeBound,
        ),
        MatchError(
            ArmWithoutValue,
            InvalidMatchScrutinee,
            NonExhaustiveMatch,
            PatternFieldCountMismatch,
            BarePatternName,
            UnknownConstructorPattern,
            UnreachableArm,
            OrPatternBindingsDiffer,
            OrPatternBindingTypeMismatch,
        ),
        StatementError(
            CallableAssignment,
            ImmutableAssignment,
            CapturedAssignment,
            NonVoidMatchArm,
            NonVoidStatement,
            PropagationNeedsResultReturn,
            PropagationNeedsResultValue,
            NonBooleanCondition,
            NonIterableFor,
            TupleBindingRequiresTuple,
            TupleBindingArityMismatch,
        ),
        checker_invariant,
        match_error,
        statement_error,
        UnsupportedForm(CharPattern, IfValue),
        unsupported_form,
    ./expressions: check_value, synthesize_value
    ./model:
        BodyOwner(DeclaredBody),
        AdmittedReceiverScope,
        CheckedBodies,
        CheckedLambda,
        LambdaRow(CollectingLambda, CheckedLambdaRow),
        CheckedValueResult,
        ResolvedBody,
        CheckedConstant,
        BindingDefinition,
        BindingId,
        BindingOrigin(BodyLocal, MatchCapture, ParameterBinding),
        CallTarget(RuntimeFunction),
        CheckedArm,
        CheckedBody(CheckedMatchBody, CheckedValueBody),
        CheckedExit(RecurWith, ReturnExpression),
        CheckedJoin,
        CheckedJoinArm,
        CheckedExpr,
        CheckedForm(
            InvokeFunction,
            LiteralVoid,
            Match,
            ReadBinding,
            ConstructVariant,
            ReadTupleElement,
        ),
        CheckedCallOperand(ValueOperand),
        CheckedFunction,
        CheckedPatternPlace,
        CheckedPatternRoute(MatchRoot, UnionField),
        CheckedPatternArgument(BorrowPlace),
        CheckedSelection,
        CheckedDecisionNode(TestVariant, EnterArm),
        MatchArmId,
        DecisionNodeId,
        match_arm_id,
        decision_node_id,
        CheckedStatement(
            DiscardExpression,
            InitializeBinding,
            ReassignBinding,
            RunWhile,
            RunFor,
            BreakSourceLoop,
            ContinueSourceLoop,
        ),
        CheckedIteration(ListIteration, AscendingIntRange),
        TypeRef(CallableType, VoidType, IntType, ListType, NominalType, TupleType),
        AggregateId(UnionAggregate),
        NominalId(AggregateNominal),
        FunctionSignature,
        TypeUse,
        UnionOccurrence,
        callable_parameter,
        binding_id,
    ./patterns as Patterns: ParsedPattern methods, TypeRef methods
    ./recursion: check_execution
    ./scope:
        ScopedValue(DataLocal, CallableLocal),
        LocalBinding,
        bind_callable,
        bind_local,
        lookup_binding,
        CallableBinding,
    ./signatures: AcceptedBody(BuiltinBody, MatchBody, ValueBody), AcceptedFunction
    ./traits: TraitAvailability


private record MatchContext { subject: Patterns.PatternSubject, scope: List[ScopedValue] }


private record ResolvedMatch {
    lambdas: List[LambdaRow],
    body: CheckedJoin,
    bindings: List[BindingDefinition],
}


private record StartedMatch {
    lambdas: List[LambdaRow],
    scrutinee: CheckedExpr,
    match_context: MatchContext,
}


private pure func start_match(
    scope: List[ScopedValue],
    body: ParsedMatch,
    context: ResolutionContext,
    lambdas: List[LambdaRow],
) -> Result[StartedMatch, CheckError]:
    var unsupported: Option[CheckError] = None
    for arm in body.arms:
        if unsupported.is_none():
            unsupported = arm.pattern.unsupported_pattern_form()
    _: Void ?= match unsupported:
        Some(error): Err(error)
        None: Ok(void)
    scrutinee ?= scope.synthesize_value(
        body.scrutinee,
        None,
        context,
        lambdas,
        resolve_lambda_block,
    )
    _: Void ?= match scrutinee.value.value_type.supports_root():
        True: Ok(void)
        False:
            Err(match_error(body.scrutinee.span, InvalidMatchScrutinee(scrutinee.value.value_type)))
    subject ?= scrutinee.value.value_type.prepare_subject(context, body.scrutinee.span)
    Ok({
        lambdas = scrutinee.lambdas,
        scrutinee = scrutinee.value,
        match_context = { subject = subject, scope = scope },
    })


private record ResolvedArmPrefix {
    rows: List[Patterns.PatternRow],
    inputs: List[BindingId],
    block: ResolvedStatements,
}


private pure func resolve_arm_prefix(
    arm: ParsedMatchArm,
    match_context: MatchContext,
    previous: List[Patterns.PatternRow],
    id: MatchArmId,
    bindings: List[BindingDefinition],
    context: ResolutionContext,
    lambdas: List[LambdaRow],
) -> Result[ResolvedArmPrefix, CheckError]:
    pattern ?= arm.pattern.resolve_arm(
        match_context.subject,
        match_context.scope,
        bindings.length(),
        id,
        previous,
        context,
    )
    block ?= arm.block.statements.resolve_statements(
        {
            lambdas = lambdas,
            bindings = bindings.concat(pattern.bindings),
            scope = pattern.scope,
            statements = [],
            reassigned = [],
        },
        context,
    )
    Ok({ rows = pattern.rows, inputs = pattern.inputs, block = block })


-- Every arm must be useful, and together the arms must cover every variant.
private pure func resolve_match(
    return_type: TypeUse,
    scope: List[ScopedValue],
    body: ParsedMatch,
    bindings: List[BindingDefinition],
    context: ResolutionContext,
    lambdas: List[LambdaRow],
) -> Result[ResolvedMatch, CheckError]:
    started ?= scope.start_match(body, context, lambdas)
    resolved ?= body.arms.resolve_join_arms(
        started.match_context,
        {
            lambdas = started.lambdas,
            arms = [],
            cases = [],
            bindings = bindings,
            expectation = return_type.return_expectation(),
            reassigned = [],
        },
        context,
    )
    selected ?= Patterns.finish_selection(
        resolved.cases,
        started.match_context.subject,
        body.keyword_span,
        context,
    )
    Ok({
        body = {
            scrutinee = started.scrutinee,
            selection = selected,
            arms = resolved.arms,
            -- Only the function return follows this match.
            carried = [],
        },
        lambdas = resolved.lambdas,
        bindings = resolved.bindings,
    })


-- What a block's value, an initializer or an expression statement must
-- produce. A bare match's arms take the expectation of the position it
-- stands in: a known type checks every arm; a statement requires Void, and
-- its arms may end with a statement; a Void function's tail discards each
-- arm's value, as it does a plain tail value. Only a new binding, or the
-- first arm of a match under one, has no expectation: there the first arm's
-- type decides the later arms'.
private union ValueExpectation:
    UntypedValue
    -- A condition supplies the canonical constructor context; each leaf still
    -- validates its resulting nominal type before a Bool join can be published.
    ConditionValue(TypeRef)
    CheckedAgainst(TypeRef, ExpectedTypeSite)
    StatementValue
    -- Without else the then block must be Void, independent of its receiver.
    AbsentElseBranch(Span)
    -- An arm of a statement match, or of a match nested as one's value.
    StatementArm
    -- A Void function's tail. The match there is Void; its arms keep their
    -- values' own types only until normalize_void_body discards them, after
    -- tail-recursion analysis has seen them at the tail. Like any tail arm,
    -- each arm still needs a value.
    VoidTail


-- A checked value with the function's bindings after it: a match's arms
-- add their captures and locals.
private record ResolvedValue {
    lambdas: List[LambdaRow],
    value: CheckedExpr,
    bindings: List[BindingDefinition],
    reassigned: List[BindingId],
}


-- Arms resolved so far, the uncovered variants and what the next arm's
-- value must produce.
private record JoinProgress {
    lambdas: List[LambdaRow],
    arms: List[CheckedJoinArm],
    cases: List[Patterns.PatternRow],
    bindings: List[BindingDefinition],
    expectation: ValueExpectation,
    reassigned: List[BindingId],
}


private pure func return_expectation(return_type: TypeUse) -> ValueExpectation:
    -- Void tails have no expected value type: each expression is still fully
    -- checked, then its value is discarded after tail-recursion analysis.
    if return_type.value_type == VoidType:
        VoidTail
    else:
        CheckedAgainst(return_type.value_type, SourceAnnotation(return_type.span))


-- A bare match is the only expression resolved here rather than by the
-- expression planner, which rejects a match nested inside another expression.
private pure func bare_match(written: ValueExpression) -> Option[ParsedMatch]:
    match written.base:
        MatchExpression(matched):
            if written.applications.is_empty():
                Some(matched)
            else:
                None
        _: None


-- A block's final value, an initializer or an expression statement, in the
-- scope after `block`'s statements.
private pure func resolve_value(
    block: ResolvedStatements,
    written: ValueExpression,
    expectation: ValueExpectation,
    context: ResolutionContext,
) -> Result[ResolvedValue, CheckError]:
    match written.base:
        IfExpression(branch):
            if written.applications.is_empty():
                branch.resolve_if(block, expectation, context)
            else:
                Err(unsupported_form(written.base_span, IfValue))
        _:
            match written.bare_match():
                Some(matched): block.resolve_join(matched, expectation, context)
                None:
                    value_result: Result[CheckedValueResult, CheckError] = match expectation:
                        UntypedValue | VoidTail:
                            block.scope.synthesize_value(
                                written,
                                None,
                                context,
                                block.lambdas,
                                resolve_lambda_block,
                            )
                        ConditionValue(expected):
                            match block.scope.synthesize_value(
                                written,
                                Some(expected),
                                context,
                                block.lambdas,
                                resolve_lambda_block,
                            ):
                                Err(error): Err(error)
                                Ok(value):
                                    if value.value.value_type == expected:
                                        Ok(value)
                                    else:
                                        Err(
                                            statement_error(
                                                written.span,
                                                NonBooleanCondition(value.value.value_type),
                                            ),
                                        )
                        CheckedAgainst(expected, site):
                            block.scope.check_value(
                                written,
                                expected,
                                site,
                                context,
                                block.lambdas,
                                resolve_lambda_block,
                            )
                        StatementValue:
                            block.scope.statement_value(
                                written,
                                ExpressionStatementValue,
                                context,
                                block.lambdas,
                            )
                        AbsentElseBranch(origin):
                            block.scope.statement_value(
                                written,
                                IfThenWithoutElse(origin),
                                context,
                                block.lambdas,
                            )
                        StatementArm:
                            block.scope.statement_value(
                                written,
                                StatementMatchArmValue,
                                context,
                                block.lambdas,
                            )
                    match value_result:
                        Ok(value):
                            Ok({
                                value = value.value,
                                lambdas = value.lambdas,
                                bindings = block.bindings,
                                reassigned = block.reassigned,
                            })
                        Err(error): Err(error)


-- Non-final expression statements, and a statement match's arm values, must
-- have Void type.
-- Where a value must be Void: each position names its own rejection.
private union VoidPosition:
    ExpressionStatementValue
    StatementMatchArmValue
    IfThenWithoutElse(Span)


private pure func statement_value(
    scope: List[ScopedValue],
    written: ValueExpression,
    position: VoidPosition,
    context: ResolutionContext,
    lambdas: List[LambdaRow],
) -> Result[CheckedValueResult, CheckError]:
    value ?= scope.synthesize_value(written, None, context, lambdas, resolve_lambda_block)
    if value.value.value_type == VoidType:
        Ok(value)
    else:
        rejection: CheckError = match position:
            ExpressionStatementValue:
                statement_error(written.span, NonVoidStatement(value.value.value_type))
            StatementMatchArmValue:
                statement_error(written.span, NonVoidMatchArm(value.value.value_type))
            IfThenWithoutElse(origin): value_error(origin, MissingIfElse)
        Err(rejection)


-- A bound or statement match. Its arms resolve as a tail match's do, except
-- that each yields its value to the code after the match.
private pure func resolve_join(
    block: ResolvedStatements,
    body: ParsedMatch,
    expectation: ValueExpectation,
    context: ResolutionContext,
) -> Result[ResolvedValue, CheckError]:
    started ?= block.scope.start_match(body, context, block.lambdas)
    -- A statement match's arms, and those of matches nested as their values,
    -- are statement arms.
    arm_expectation: ValueExpectation = match expectation:
        StatementValue | StatementArm | AbsentElseBranch(_): StatementArm
        UntypedValue | ConditionValue(_) | CheckedAgainst(_, _) | VoidTail: expectation
    resolved ?= body.arms.resolve_join_arms(
        started.match_context,
        {
            lambdas = started.lambdas,
            arms = [],
            cases = [],
            bindings = block.bindings,
            expectation = arm_expectation,
            reassigned = [],
        },
        context,
    )
    selected ?= Patterns.finish_selection(
        resolved.cases,
        started.match_context.subject,
        body.keyword_span,
        context,
    )
    decided: Result[TypeRef, CheckError] = match resolved.expectation:
        ConditionValue(expected): Ok(expected)
        CheckedAgainst(expected, _): Ok(expected)
        StatementValue | StatementArm | AbsentElseBranch(_) | VoidTail: Ok(VoidType)
        -- Only a match without arms leaves its type undecided.
        UntypedValue: Err(checker_invariant(body.keyword_span, JoinWithoutArms))
    value_type ?= decided
    carried: List[BindingId] = if resolved.reassigned.is_empty():
        []
    else:
        block.carried_bindings(resolved.reassigned)
    Ok({
        value = {
            form = Match({
                scrutinee = started.scrutinee,
                selection = selected,
                arms = resolved.arms,
                carried = carried,
            }),
            value_type = value_type,
            span = body.span,
        },
        lambdas = resolved.lambdas,
        bindings = resolved.bindings,
        reassigned = block.reassigned.concat(carried),
    })


private pure func resolve_join_arms(
    written: List[ParsedMatchArm],
    match_context: MatchContext,
    progress: JoinProgress,
    context: ResolutionContext,
) -> Result[JoinProgress, CheckError]:
    match written.get(progress.arms.length()):
        None: Ok(progress)
        Some(arm):
            match arm.resolve_arm_prefix(
                match_context,
                progress.cases,
                match_arm_id(progress.arms.length()),
                progress.bindings,
                context,
                progress.lambdas,
            ):
                Ok(prefix):
                    resolved: Result[ResolvedValue, CheckError] = match arm.block.value:
                        Some(body): prefix.block.resolve_value(body, progress.expectation, context)
                        None:
                            match progress.expectation:
                                -- An arm of a statement match may end with a statement.
                                StatementValue | StatementArm | AbsentElseBranch(_):
                                    Ok({
                                        value = {
                                            form = LiteralVoid,
                                            value_type = VoidType,
                                            span = arm.span,
                                        },
                                        lambdas = prefix.block.lambdas,
                                        bindings = prefix.block.bindings,
                                        reassigned = prefix.block.reassigned,
                                    })
                                UntypedValue | ConditionValue(_) | CheckedAgainst(_, _) | VoidTail:
                                    Err(match_error(arm.span, ArmWithoutValue))
                    match resolved:
                        Ok(value):
                            expectation: ValueExpectation = match progress.expectation:
                                UntypedValue: CheckedAgainst(value.value.value_type, FirstArmValue)
                                ConditionValue(_) | CheckedAgainst(_, _) | StatementValue | StatementArm | AbsentElseBranch(_) | VoidTail:
                                    progress.expectation
                            written.resolve_join_arms(
                                match_context,
                                {
                                    arms = progress.arms.append({
                                        id = match_arm_id(progress.arms.length()),
                                        inputs = prefix.inputs,
                                        statements = prefix.block.statements,
                                        value = value.value,
                                    }),
                                    cases = progress.cases.concat(prefix.rows),
                                    lambdas = value.lambdas,
                                    bindings = value.bindings,
                                    expectation = expectation,
                                    reassigned = progress.reassigned.concat(value.reassigned),
                                },
                                context,
                            )
                        Err(error): Err(error)
                Err(error): Err(error)


-- The signature was resolved from these parameters, one type each.
private pure func parameter_scope(
    parameters: List[ParsedParameter],
    types: List[TypeUse],
    scope: List[ScopedValue],
    context: ResolutionContext,
) -> Result[List[ScopedValue], CheckError]:
    var resolved = scope
    var data_ordinal = 0
    var position = 0
    var failure: Option[CheckError] = None
    for parameter in parameters:
        match types.get(position):
            None:
                failure = Some(
                    checker_invariant(parameter.name.span, InvalidResolvedParameter(position)),
                )
            Some(value_type):
                binding_result = match value_type.value_type:
                    CallableType(_, _, _):
                        accepted = resolved.bind_callable(
                            context.namespace,
                            context.module,
                            parameter.name,
                            callable_parameter(context.root_function, position),
                            value_type,
                            context.caller.body,
                            binding_id(data_ordinal),
                        )
                        data_ordinal = data_ordinal + 1
                        accepted
                    _:
                        definition: BindingDefinition = {
                            origin = ParameterBinding(data_ordinal),
                            mutable = False,
                            value_type = value_type.value_type,
                            span = parameter.name.span,
                        }
                        data_ordinal = data_ordinal + 1
                        resolved.bind_local(
                            context.namespace,
                            context.module,
                            context.caller.body,
                            parameter.name,
                            binding_id(data_ordinal - 1),
                            definition,
                        )
                match binding_result:
                    Ok(binding): resolved = resolved.append(binding)
                    Err(error): failure = Some(error)
        if failure.is_some():
            break
        position = position + 1
    match failure:
        Some(error): Err(error)
        None: Ok(resolved)


-- A block's checked statements, the scope after them and the function's
-- bindings so far.
private record ResolvedStatements {
    lambdas: List[LambdaRow],
    bindings: List[BindingDefinition],
    scope: List[ScopedValue],
    statements: List[CheckedStatement],
    reassigned: List[BindingId],
}


private union JoinBindingState:
    OutsideJoinScope
    UntouchedJoinBinding
    ReassignedJoinBinding


-- Scope membership and write occurrences are already checked facts. This local
-- table filters arm locals and freezes each visible identity once, in ordinal
-- order even though the lexical lookup scope has most recent bindings first.
private pure func carried_bindings(
    entry: ResolvedStatements,
    written: List[BindingId],
) -> List[BindingId]:
    var states: List[JoinBindingState] = repeat(OutsideJoinScope, entry.bindings.length())
    for binding in entry.scope:
        match binding:
            DataLocal(data):
                states = states.set(data.local_binding_id().binding_number(), UntouchedJoinBinding)
            CallableLocal(_): void
    for id in written:
        position = id.binding_number()
        match states.get(position):
            Some(state):
                match state:
                    UntouchedJoinBinding | ReassignedJoinBinding:
                        states = states.set(position, ReassignedJoinBinding)
                    OutsideJoinScope: void
            None: void
    var carried: List[BindingId] = []
    var ordinal = 0
    for state in states:
        match state:
            ReassignedJoinBinding: carried = carried.append(binding_id(ordinal))
            OutsideJoinScope | UntouchedJoinBinding: void
        ordinal = ordinal + 1
    carried


-- New bindings are validated once after their initializer is checked.
private pure func resolve_statements(
    written: List[ParsedStatement],
    block: ResolvedStatements,
    context: ResolutionContext,
) -> Result[ResolvedStatements, CheckError]:
    written.resolve_statement_prefix(0, block, context)


-- One source destructuring statement expands to several ordinary bindings.
-- Track written position independently of the checked statement count.
private pure func resolve_statement_prefix(
    written: List[ParsedStatement],
    position: Int,
    block: ResolvedStatements,
    context: ResolutionContext,
) -> Result[ResolvedStatements, CheckError]:
    match written.get(position):
        None: Ok(block)
        Some(statement):
            match statement.resolve_statement(block, context):
                Ok(next): written.resolve_statement_prefix(position + 1, next, context)
                Err(error): Err(error)


private pure func resolve_loop_control(
    control: CheckedStatement,
    span: Span,
    block: ResolvedStatements,
    context: ResolutionContext,
) -> Result[ResolvedStatements, CheckError]:
    if context.in_source_loop:
        Ok({ block | statements = block.statements.append(control) })
    else:
        Err(checker_invariant(span, LoopControlOutsideLoop))


private pure func resolve_statement(
    statement: ParsedStatement,
    block: ResolvedStatements,
    context: ResolutionContext,
) -> Result[ResolvedStatements, CheckError]:
    match statement:
        TupleBinding(binders, initializer, span):
            binders.resolve_tuple_binding(initializer, span, block, context)
        BindingStatement(binding): binding.resolve_assignment(block, context)
        PropagatingBinding(propagation): Err(checker_invariant(propagation.span, NestedPropagation))
        WhileLoop(loop): loop.resolve_while(block, context)
        ForLoop(loop): loop.resolve_for(block, context)
        Break(span): resolve_loop_control(BreakSourceLoop(span), span, block, context)
        Continue(span): resolve_loop_control(ContinueSourceLoop(span), span, block, context)
        ExpressionStatement(expression):
            match block.resolve_value(expression, StatementValue, context):
                Ok(resolved):
                    Ok(
                        { block |
                            lambdas = resolved.lambdas,
                            bindings = resolved.bindings,
                            statements = block.statements.append(DiscardExpression(resolved.value)),
                            reassigned = resolved.reassigned,
                        },
                    )
                Err(error): Err(error)


private pure func resolve_condition(
    written: ValueExpression,
    block: ResolvedStatements,
    context: ResolutionContext,
) -> Result[ResolvedValue, CheckError]:
    expected: TypeRef = NominalType(
        AggregateNominal(UnionAggregate(context.boolean.true_variant.variant_owner())),
        [],
    )
    { block | reassigned = [] }.resolve_value(written, ConditionValue(expected), context)


-- Statement blocks may finish without a value. A written final expression
-- remains a statement and must be Void, just like each preceding expression.
private pure func resolve_statement_block(
    written: ParsedBlock,
    block: ResolvedStatements,
    context: ResolutionContext,
) -> Result[ResolvedStatements, CheckError]:
    prefix ?= written.statements.resolve_statements(block, context)
    match written.value:
        Some(value): resolve_statement(ExpressionStatement(value), prefix, context)
        None: Ok(prefix)


private record ResolvedIfBranch { block: ResolvedStatements, value: CheckedExpr }


private pure func resolve_if_branch(
    written: ParsedBlock,
    block: ResolvedStatements,
    expectation: ValueExpectation,
    context: ResolutionContext,
) -> Result[ResolvedIfBranch, CheckError]:
    prefix ?= match expectation:
        StatementValue | StatementArm: written.resolve_statement_block(block, context)
        _: written.statements.resolve_statements(block, context)
    resolved: ResolvedValue ?= match expectation:
        StatementValue | StatementArm:
            Ok({
                value = { form = LiteralVoid, value_type = VoidType, span = written.span },
                bindings = prefix.bindings,
                lambdas = prefix.lambdas,
                reassigned = prefix.reassigned,
            })
        _:
            match written.value:
                Some(body): prefix.resolve_value(body, expectation, context)
                None:
                    match expectation:
                        AbsentElseBranch(_):
                            Ok({
                                value = {
                                    form = LiteralVoid,
                                    value_type = VoidType,
                                    span = written.span,
                                },
                                bindings = prefix.bindings,
                                lambdas = prefix.lambdas,
                                reassigned = prefix.reassigned,
                            })
                        _: Err(value_error(written.span, IfBranchWithoutValue))
    Ok({
        block = { prefix |
            bindings = resolved.bindings,
            lambdas = resolved.lambdas,
            reassigned = resolved.reassigned,
        },
        value = resolved.value,
    })


private pure func resolve_if(
    written: ParsedIf,
    block: ResolvedStatements,
    expectation: ValueExpectation,
    context: ResolutionContext,
) -> Result[ResolvedValue, CheckError]:
    condition ?= written.condition.resolve_condition(block, context)
    entry: ResolvedStatements = {
        lambdas = condition.lambdas,
        bindings = condition.bindings,
        scope = block.scope,
        statements = [],
        reassigned = [],
    }
    arm_expectation = match written.else_branch:
        Some(_): expectation
        None: AbsentElseBranch(written.span)
    selected ?= written.then_block.resolve_if_branch(entry, arm_expectation, context)
    next_expectation: ValueExpectation = match expectation:
        UntypedValue: CheckedAgainst(selected.value.value_type, FirstIfBranchValue)
        _: expectation
    other_entry = { entry | bindings = selected.block.bindings, lambdas = selected.block.lambdas }
    other: ResolvedIfBranch ?= match written.else_branch:
        None:
            Ok({
                block = other_entry,
                value = { form = LiteralVoid, value_type = VoidType, span = written.span },
            })
        Some(branch):
            match branch:
                ElseBlock(body): body.resolve_if_branch(other_entry, next_expectation, context)
                ElseIf(body):
                    match body.resolve_if(other_entry, next_expectation, context):
                        Err(error): Err(error)
                        Ok(resolved):
                            Ok({
                                block = { other_entry |
                                    lambdas = resolved.lambdas,
                                    bindings = resolved.bindings,
                                    reassigned = resolved.reassigned,
                                },
                                value = resolved.value,
                            })
    value_type = match expectation:
        UntypedValue: selected.value.value_type
        CheckedAgainst(expected, _): expected
        ConditionValue(expected): expected
        StatementValue | StatementArm | AbsentElseBranch(_) | VoidTail: VoidType
    -- With no else, branches were checked without the receiving expectation.
    -- Validate its canonical Void result before publishing any join facts.
    _: Void ?= match written.else_branch:
        Some(_): Ok(void)
        None:
            match expectation:
                CheckedAgainst(expected, site):
                    if expected == VoidType:
                        Ok(void)
                    else:
                        Err(
                            value_error(
                                written.span,
                                ExpressionTypeMismatch({
                                    expected = expected,
                                    actual = { value_type = VoidType, span = written.span },
                                    expected_site = site,
                                }),
                            ),
                        )
                ConditionValue(_): Err(statement_error(written.span, NonBooleanCondition(VoidType)))
                _: Ok(void)
    carried = block.carried_bindings(
        condition.reassigned.concat(selected.block.reassigned).concat(other.block.reassigned),
    )
    matched_selection ?= Patterns.union_selection(
        [
            {
                arm = match_arm_id(0),
                variant = context.boolean.true_variant,
                fields = [],
                arguments = [],
            },
            {
                arm = match_arm_id(1),
                variant = context.boolean.false_variant,
                fields = [],
                arguments = [],
            },
        ],
        condition.value.value_type,
        written.span,
        context,
    )
    Ok({
        value = {
            form = Match({
                scrutinee = condition.value,
                selection = matched_selection,
                arms = [
                    {
                        id = match_arm_id(0),
                        inputs = [],
                        statements = selected.block.statements,
                        value = selected.value,
                    },
                    {
                        id = match_arm_id(1),
                        inputs = [],
                        statements = other.block.statements,
                        value = other.value,
                    },
                ],
                carried = carried,
            }),
            value_type = value_type,
            span = written.span,
        },
        lambdas = other.block.lambdas,
        bindings = other.block.bindings,
        reassigned = block.reassigned.concat(carried),
    })


private pure func resolve_while(
    written: ParsedWhile,
    block: ResolvedStatements,
    context: ResolutionContext,
) -> Result[ResolvedStatements, CheckError]:
    inside = { context | in_source_loop = True }
    condition ?= written.condition.resolve_condition(block, inside)
    body ?= written.body.resolve_statement_block(
        {
            lambdas = condition.lambdas,
            bindings = condition.bindings,
            scope = block.scope,
            statements = [],
            reassigned = [],
        },
        inside,
    )
    carried = block.carried_bindings(condition.reassigned.concat(body.reassigned))
    Ok(
        { block |
            lambdas = body.lambdas,
            bindings = body.bindings,
            statements = block.statements.append(
                RunWhile({
                    condition = condition.value,
                    body = body.statements,
                    carried = carried,
                    boolean = context.boolean,
                    span = written.span,
                }),
            ),
            reassigned = block.reassigned.concat(carried),
        },
    )


private record ResolvedIteration {
    iteration: CheckedIteration,
    element: TypeRef,
    block: ResolvedStatements,
}


-- Iterable expressions run before the loop. Their writes and LambdaRows flow
-- into the body's entry, but their locals do not escape their value scopes.
private pure func resolve_iteration(
    written: ValueExpression,
    block: ResolvedStatements,
    context: ResolutionContext,
) -> Result[ResolvedIteration, CheckError]:
    match written.base:
        RangeExpression(start, end):
            if written.applications.is_empty():
                start.resolve_range_iteration(end, block, context)
            else:
                written.resolve_list_iteration(block, context)
        _: written.resolve_list_iteration(block, context)


private pure func resolve_range_iteration(
    start: ValueExpression,
    end: ValueExpression,
    block: ResolvedStatements,
    context: ResolutionContext,
) -> Result[ResolvedIteration, CheckError]:
    first ?= block.resolve_value(start, CheckedAgainst(IntType, ForRangeBound), context)
    previous = { block |
        lambdas = first.lambdas,
        bindings = first.bindings,
        reassigned = first.reassigned,
    }
    last ?= previous.resolve_value(end, CheckedAgainst(IntType, ForRangeBound), context)
    Ok({
        iteration = AscendingIntRange(first.value, last.value, context.boolean),
        element = IntType,
        block = { previous |
            lambdas = last.lambdas,
            bindings = last.bindings,
            reassigned = last.reassigned,
        },
    })


private pure func resolve_list_iteration(
    written: ValueExpression,
    block: ResolvedStatements,
    context: ResolutionContext,
) -> Result[ResolvedIteration, CheckError]:
    resolved ?= block.resolve_value(written, UntypedValue, context)
    match resolved.value.value_type:
        ListType(element):
            Ok({
                iteration = ListIteration(resolved.value, element, context.option),
                element = element,
                block = { block |
                    lambdas = resolved.lambdas,
                    bindings = resolved.bindings,
                    reassigned = resolved.reassigned,
                },
            })
        _: Err(statement_error(written.span, NonIterableFor(resolved.value.value_type)))


private record ForItemScope { item: Option[BindingId], block: ResolvedStatements }


private pure func bind_for_item(
    binder: ParsedBinder,
    element: TypeRef,
    block: ResolvedStatements,
    context: ResolutionContext,
) -> Result[ForItemScope, CheckError]:
    match binder:
        DiscardBinder(_): Ok({ item = None, block = block })
        NamedBinder(name):
            id = binding_id(block.bindings.length())
            definition: BindingDefinition = {
                origin = BodyLocal,
                mutable = False,
                value_type = element,
                span = name.span,
            }
            match block.scope.bind_local(
                context.namespace,
                context.module,
                context.caller.body,
                name,
                id,
                definition,
            ):
                Err(error): Err(error)
                Ok(binding):
                    Ok({
                        item = Some(id),
                        block = { block |
                            bindings = block.bindings.append(definition),
                            scope = [binding].concat(block.scope),
                        },
                    })


private pure func tuple_binder_types(
    binders: List[ParsedBinder],
    value_type: TypeRef,
    span: Span,
) -> Result[List[TypeRef], CheckError]:
    selected: Result[List[TypeRef], CheckError] = match value_type:
        TupleType(elements): Ok(elements)
        _: Err(statement_error(span, TupleBindingRequiresTuple(value_type)))
    fields ?= selected
    if fields.length() == binders.length():
        Ok(fields)
    else:
        Err(statement_error(span, TupleBindingArityMismatch(fields.length(), binders.length())))


-- The unnamed subject owns the whole tuple. Named projections use ordinary
-- bindings, while '_' leaves its element owned only by that subject.
private pure func bind_tuple_elements(
    binders: List[ParsedBinder],
    fields: List[TypeRef],
    subject: CheckedExpr,
    block: ResolvedStatements,
    context: ResolutionContext,
) -> Result[ResolvedStatements, CheckError]:
    var resolved = block
    var position = 0
    var failure: Option[CheckError] = None
    for binder in binders:
        match binder:
            DiscardBinder(_): void
            NamedBinder(name):
                match fields.get(position):
                    None:
                        failure = Some(
                            checker_invariant(name.span, UnsupportedPatternReachedResolution),
                        )
                    Some(value_type):
                        id = binding_id(resolved.bindings.length())
                        definition: BindingDefinition = {
                            origin = BodyLocal,
                            mutable = False,
                            value_type = value_type,
                            span = name.span,
                        }
                        match resolved.scope.bind_local(
                            context.namespace,
                            context.module,
                            context.caller.body,
                            name,
                            id,
                            definition,
                        ):
                            Err(error): failure = Some(error)
                            Ok(binding):
                                projection: CheckedExpr = {
                                    form = ReadTupleElement(subject, position),
                                    value_type = value_type,
                                    span = name.span,
                                }
                                resolved = { resolved |
                                    bindings = resolved.bindings.append(definition),
                                    scope = [binding].concat(resolved.scope),
                                    statements = resolved.statements.append(
                                        InitializeBinding(id, projection),
                                    ),
                                }
        if failure.is_some():
            break
        position = position + 1
    match failure:
        Some(error): Err(error)
        None: Ok(resolved)


private pure func resolve_tuple_binding(
    binders: List[ParsedBinder],
    initializer: ValueExpression,
    span: Span,
    block: ResolvedStatements,
    context: ResolutionContext,
) -> Result[ResolvedStatements, CheckError]:
    resolved ?= block.resolve_value(initializer, UntypedValue, context)
    fields ?= binders.tuple_binder_types(resolved.value.value_type, span)
    id = binding_id(resolved.bindings.length())
    definition: BindingDefinition = {
        origin = BodyLocal,
        mutable = False,
        value_type = resolved.value.value_type,
        span = initializer.span,
    }
    subject: CheckedExpr = {
        form = ReadBinding(id),
        value_type = resolved.value.value_type,
        span = initializer.span,
    }
    binders.bind_tuple_elements(
        fields,
        subject,
        {
            lambdas = resolved.lambdas,
            bindings = resolved.bindings.append(definition),
            scope = block.scope,
            statements = block.statements.append(InitializeBinding(id, resolved.value)),
            reassigned = resolved.reassigned,
        },
        context,
    )


private pure func bind_for_binder(
    binder: ForBinder,
    element: TypeRef,
    block: ResolvedStatements,
    context: ResolutionContext,
) -> Result[ForItemScope, CheckError]:
    match binder:
        SingleForBinder(single): single.bind_for_item(element, block, context)
        TupleForBinder(binders, span): binders.bind_tuple_for_item(span, element, block, context)


private pure func bind_tuple_for_item(
    binders: List[ParsedBinder],
    span: Span,
    element: TypeRef,
    block: ResolvedStatements,
    context: ResolutionContext,
) -> Result[ForItemScope, CheckError]:
    fields ?= binders.tuple_binder_types(element, span)
    id = binding_id(block.bindings.length())
    definition: BindingDefinition = {
        origin = BodyLocal,
        mutable = False,
        value_type = element,
        span = span,
    }
    subject: CheckedExpr = { form = ReadBinding(id), value_type = element, span = span }
    resolved ?= binders.bind_tuple_elements(
        fields,
        subject,
        { block | bindings = block.bindings.append(definition) },
        context,
    )
    Ok({ item = Some(id), block = resolved })


private pure func resolve_for(
    written: ParsedFor,
    block: ResolvedStatements,
    context: ResolutionContext,
) -> Result[ResolvedStatements, CheckError]:
    iterated ?= written.iterable.resolve_iteration(block, context)
    item ?= written.binder.bind_for_binder(
        iterated.element,
        { iterated.block | statements = [], reassigned = [] },
        context,
    )
    body ?= written.body.resolve_statement_block(item.block, { context | in_source_loop = True })
    carried = iterated.block.carried_bindings(body.reassigned)
    Ok(
        { block |
            lambdas = body.lambdas,
            bindings = body.bindings,
            statements = block.statements.append(
                RunFor({
                    iteration = iterated.iteration,
                    item = item.item,
                    body = body.statements,
                    carried = carried,
                    span = written.span,
                }),
            ),
            reassigned = iterated.block.reassigned.concat(carried),
        },
    )


-- Resolve a declaration's annotation before its initializer. Propagation stays
-- at this function's top level, as required by the compiler's source subset.
private pure func resolve_initializer(
    written: ParsedBinding,
    block: ResolvedStatements,
    context: ResolutionContext,
) -> Result[ResolvedValue, CheckError]:
    expectation: ValueExpectation ?= match written.annotation:
        None: Ok(UntypedValue)
        Some(annotation):
            match context.resolve_body_type(annotation):
                Ok(value_type):
                    Ok(CheckedAgainst(value_type, SourceAnnotation(annotation.type_span())))
                Err(error): Err(error)
    block.resolve_value(written.initializer, expectation, context)


private pure func resolve_assignment(
    written: ParsedBinding,
    block: ResolvedStatements,
    context: ResolutionContext,
) -> Result[ResolvedStatements, CheckError]:
    -- An annotation or explicit var declares a binding. Plain assignment keeps
    -- its existing error priority before checking the RHS.
    decision: Result[Option[LocalBinding], CheckError] = match written.annotation:
        Some(_): Ok(None)
        None:
            if written.mutable:
                Ok(None)
            else:
                match block.scope.lookup_binding(written.name.id):
                    None: Ok(None)
                    Some(CallableLocal(binding)):
                        match binding.callable_parameter_contract():
                            Err(error): Err(error)
                            Ok(accepted):
                                Err(
                                    statement_error(
                                        written.name.span,
                                        CallableAssignment(accepted.parameter),
                                    ),
                                )
                    Some(DataLocal(binding)):
                        if binding.binding_site().binding.owner != context.caller.body:
                            Err(
                                statement_error(
                                    written.name.span,
                                    CapturedAssignment(binding.binding_site().binding),
                                ),
                            )
                        else:
                            if binding.binding_definition().mutable:
                                Ok(Some(binding))
                            else:
                                Err(
                                    statement_error(
                                        written.name.span,
                                        ImmutableAssignment(binding.binding_site()),
                                    ),
                                )

    reassign ?= decision

    match reassign:
        Some(binding):
            site: ExpectedTypeSite = InferredBindingDeclaration(binding.binding_site())
            match block.resolve_value(
                written.initializer,
                CheckedAgainst(binding.binding_definition().value_type, site),
                context,
            ):
                Ok(resolved):
                    Ok(
                        { block |
                            lambdas = resolved.lambdas,
                            bindings = resolved.bindings,
                            statements = block.statements.append(
                                ReassignBinding(binding.local_binding_id(), resolved.value),
                            ),
                            reassigned = resolved.reassigned.append(binding.local_binding_id()),
                        },
                    )
                Err(error): Err(error)
        None:
            match written.resolve_initializer(block, context):
                Ok(resolved):
                    value = resolved.value

                    definition: BindingDefinition = {
                        origin = BodyLocal,
                        mutable = written.mutable,
                        value_type = value.value_type,
                        span = written.name.span,
                    }
                    -- A match's arm captures and locals precede this binding's ordinal.
                    id = binding_id(resolved.bindings.length())
                    match block.scope.bind_local(
                        context.namespace,
                        context.module,
                        context.caller.body,
                        written.name,
                        id,
                        definition,
                    ):
                        Err(error): Err(error)
                        Ok(binding):
                            Ok({
                                lambdas = resolved.lambdas,
                                bindings = resolved.bindings.append(definition),
                                scope = [binding].concat(block.scope),
                                statements = block.statements.append(InitializeBinding(id, value)),
                                reassigned = resolved.reassigned,
                            })
                Err(error): Err(error)


private pure func resolve_body(
    accepted: AcceptedFunction,
    result: DesignatedResult[VariantId],
    context: ResolutionContext,
    lambdas: List[LambdaRow],
) -> Result[ResolvedBody, CheckError]:
    signature = accepted.signature
    tail_decision: Result[Void, CheckError] = match accepted.declaration.tail_annotation:
        None: Ok(void)
        Some(annotation):
            if signature.has_callable_parameters():
                if signature.type_parameters.is_empty():
                    Err(recursion_error(annotation, CallableTailRecursionUnsupported))
                else:
                    Err(recursion_error(annotation, GenericTailRecursionUnsupported))
            else:
                Ok(void)
    tail_contract ?= tail_decision
    initial ?= accepted.declaration.parameters.parameter_scope(signature.parameters, [], context)
    var parameter_bindings: List[BindingDefinition] = []
    for binding in initial:
        match binding:
            DataLocal(data):
                definition = data.binding_definition()
                parameter_bindings = parameter_bindings.append(definition)
            CallableLocal(callable):
                parameter_bindings = parameter_bindings.append(
                    callable.callable_local().binding_definition(),
                )
    block: ResolvedStatements = {
        lambdas = lambdas,
        bindings = parameter_bindings,
        scope = initial,
        statements = [],
        reassigned = [],
    }
    accepted.resolve_function_prefix(0, block, initial, result, context)


-- Ordinary functions keep their existing tail-body form. Only a propagation
-- statement switches to a Result-valued suffix inside its successful arm.
private pure func resolve_function_prefix(
    accepted: AcceptedFunction,
    position: Int,
    block: ResolvedStatements,
    initial: List[ScopedValue],
    result: DesignatedResult[VariantId],
    context: ResolutionContext,
) -> Result[ResolvedBody, CheckError]:
    match accepted.declaration.statements.get(position):
        None: accepted.finish_body(block, initial, context)
        Some(statement):
            match statement:
                PropagatingBinding(written):
                    match accepted.resolve_propagation(
                        position,
                        block,
                        initial,
                        written,
                        result,
                        context,
                    ):
                        Err(error): Err(error)
                        Ok(value):
                            match accepted.declaration.tail_annotation:
                                Some(annotation):
                                    if accepted.signature.type_parameters.is_empty():
                                        Err(
                                            recursion_error(
                                                written.span,
                                                PropagationTailRecursionUnsupported,
                                            ),
                                        )
                                    else:
                                        Err(
                                            recursion_error(
                                                annotation,
                                                GenericTailRecursionUnsupported,
                                            ),
                                        )
                                None:
                                    Ok({
                                        lambdas = value.lambdas,
                                        bindings = value.bindings,
                                        statements = value.statements,
                                        body = CheckedValueBody(ReturnExpression(value.value)),
                                    })
                _:
                    match statement.resolve_statement(block, context):
                        Ok(next):
                            accepted.resolve_function_prefix(
                                position + 1,
                                next,
                                initial,
                                result,
                                context,
                            )
                        Err(error): Err(error)


private pure func finish_body(
    accepted: AcceptedFunction,
    prefix: ResolvedStatements,
    initial: List[ScopedValue],
    context: ResolutionContext,
) -> Result[ResolvedBody, CheckError]:
    signature = accepted.signature

    match accepted.body:
        BuiltinBody(operation, span):
            Ok({
                lambdas = prefix.lambdas,
                bindings = prefix.bindings,
                statements = prefix.statements,
                body = CheckedValueBody(
                    ReturnExpression(signature.builtin_value(initial, operation, span)),
                ),
            })
        ValueBody(body):
            match prefix.resolve_value(body, signature.return_type.return_expectation(), context):
                Ok(value):
                    Ok({
                        lambdas = value.lambdas,
                        bindings = value.bindings,
                        statements = prefix.statements,
                        body = CheckedValueBody(ReturnExpression(value.value)),
                    })
                Err(error): Err(error)
        MatchBody(body):
            match signature.return_type.resolve_match(
                prefix.scope,
                body,
                prefix.bindings,
                context,
                prefix.lambdas,
            ):
                Ok(matched):
                    checked_body: CheckedBody = match accepted.declaration.tail_annotation:
                        None:
                            CheckedValueBody(
                                ReturnExpression({
                                    form = Match(matched.body),
                                    value_type = signature.return_type.value_type,
                                    span = body.span,
                                }),
                            )
                        Some(_):
                            var arms: List[CheckedArm] = []
                            for arm in matched.body.arms:
                                arms = arms.append({
                                    id = arm.id,
                                    inputs = arm.inputs,
                                    statements = arm.statements,
                                    body = ReturnExpression(arm.value),
                                })
                            CheckedMatchBody({
                                scrutinee = matched.body.scrutinee,
                                selection = matched.body.selection,
                                arms = arms,
                            })
                    Ok({
                        lambdas = matched.lambdas,
                        bindings = matched.bindings,
                        statements = prefix.statements,
                        body = checked_body,
                    })
                Err(error): Err(error)


private pure func builtin_value(
    signature: FunctionSignature,
    initial: List[ScopedValue],
    operation: RuntimeOperation[VariantId, TypeRef],
    span: Span,
) -> CheckedExpr:
    var operands: List[CheckedCallOperand] = []
    for binding in initial:
        match binding:
            DataLocal(data):
                definition = data.binding_definition()
                operands = operands.append(
                    ValueOperand({
                        form = ReadBinding(data.local_binding_id()),
                        value_type = definition.value_type,
                        span = definition.span,
                    }),
                )
            CallableLocal(_): void
    {
        form = InvokeFunction({
            target = RuntimeFunction(operation),
            operands = operands,
            span = span,
        }),
        value_type = signature.return_type.value_type,
        span = span,
    }


-- A Result-valued function suffix. It becomes the ordinary value of an Ok arm.
private record ResolvedFunctionValue {
    lambdas: List[LambdaRow],
    bindings: List[BindingDefinition],
    statements: List[CheckedStatement],
    value: CheckedExpr,
}


private pure func resolve_result_prefix(
    accepted: AcceptedFunction,
    position: Int,
    block: ResolvedStatements,
    initial: List[ScopedValue],
    result: DesignatedResult[VariantId],
    context: ResolutionContext,
) -> Result[ResolvedFunctionValue, CheckError]:
    match accepted.declaration.statements.get(position):
        Some(statement):
            match statement:
                PropagatingBinding(written):
                    accepted.resolve_propagation(position, block, initial, written, result, context)
                _:
                    match statement.resolve_statement(block, context):
                        Ok(next):
                            accepted.resolve_result_prefix(
                                position + 1,
                                next,
                                initial,
                                result,
                                context,
                            )
                        Err(error): Err(error)
        None:
            value: Result[ResolvedValue, CheckError] = match accepted.body:
                ValueBody(body):
                    block.resolve_value(
                        body,
                        accepted.signature.return_type.return_expectation(),
                        context,
                    )
                MatchBody(body):
                    block.resolve_join(
                        body,
                        accepted.signature.return_type.return_expectation(),
                        context,
                    )
                BuiltinBody(operation, span):
                    Ok({
                        value = accepted.signature.builtin_value(initial, operation, span),
                        lambdas = block.lambdas,
                        bindings = block.bindings,
                        reassigned = block.reassigned,
                    })
            match value:
                Ok(resolved):
                    Ok({
                        bindings = resolved.bindings,
                        statements = block.statements,
                        lambdas = resolved.lambdas,
                        value = resolved.value,
                    })
                Err(error): Err(error)


-- Canonical Result's checked parameter order is Value, Error.
private record ResultPayloads { value: TypeRef, error: TypeRef }


private pure func result_payloads(
    value: TypeRef,
    result: DesignatedResult[VariantId],
) -> Option[ResultPayloads]:
    match value.union_occurrence():
        Some(occurrence):
            if occurrence.owner == result.ok.variant_owner():
                match occurrence.arguments.get(0):
                    Some(success_type):
                        match occurrence.arguments.get(1):
                            Some(error): Some({ value = success_type, error = error })
                            None: None
                    None: None
            else:
                None
        None: None


private pure func propagation_source(
    written: ParsedPropagation,
    block: ResolvedStatements,
    error_type: TypeRef,
    result: DesignatedResult[VariantId],
    context: ResolutionContext,
) -> Result[ResolvedValue, CheckError]:
    expectation: ValueExpectation ?= match written.annotation:
        None: Ok(UntypedValue)
        Some(annotation):
            match context.resolve_body_type(annotation):
                Ok(value):
                    Ok(
                        CheckedAgainst(
                            NominalType(
                                AggregateNominal(UnionAggregate(result.ok.variant_owner())),
                                [value, error_type],
                            ),
                            SourceAnnotation(annotation.type_span()),
                        ),
                    )
                Err(error): Err(error)
    block.resolve_value(written.value, expectation, context)


private pure func resolve_propagation(
    accepted: AcceptedFunction,
    position: Int,
    block: ResolvedStatements,
    initial: List[ScopedValue],
    written: ParsedPropagation,
    result: DesignatedResult[VariantId],
    context: ResolutionContext,
) -> Result[ResolvedFunctionValue, CheckError]:
    returned = accepted.signature.return_type
    error_type: TypeRef ?= match returned.value_type.result_payloads(result):
        Some(payloads): Ok(payloads.error)
        _: Err(statement_error(written.span, PropagationNeedsResultReturn(returned.value_type)))
    source ?= written.propagation_source(block, error_type, result, context)
    success_type: TypeRef ?= match source.value.value_type.result_payloads(result):
        Some(payloads):
            if payloads.error == error_type:
                Ok(payloads.value)
            else:
                Err(
                    value_error(
                        written.value.span,
                        ExpressionTypeMismatch({
                            expected = NominalType(
                                AggregateNominal(UnionAggregate(result.ok.variant_owner())),
                                [payloads.value, error_type],
                            ),
                            actual = {
                                value_type = source.value.value_type,
                                span = source.value.span,
                            },
                            expected_site = SourceAnnotation(returned.span),
                        }),
                    ),
                )
        _:
            Err(
                statement_error(
                    written.value.span,
                    PropagationNeedsResultValue(source.value.value_type),
                ),
            )
    -- Keep RHS evaluation as a statement: its match may publish new versions
    -- of mutable prefix bindings before the success continuation reads them.
    source_id = binding_id(source.bindings.length())
    source_definition: BindingDefinition = {
        origin = BodyLocal,
        mutable = False,
        value_type = source.value.value_type,
        span = written.value.span,
    }
    bindings = source.bindings.append(source_definition)
    success = binding_id(bindings.length())
    binder_span = match written.binder:
        NamedBinder(name): name.span
        DiscardBinder(span): span
    definition: BindingDefinition = {
        origin = MatchCapture,
        mutable = False,
        value_type = success_type,
        span = binder_span,
    }
    -- Keep the internal capture for ownership; only named binders extend scope.
    scope: List[ScopedValue] ?= match written.binder:
        DiscardBinder(_): Ok(block.scope)
        NamedBinder(name):
            match block.scope.bind_local(
                context.namespace,
                context.module,
                context.caller.body,
                name,
                success,
                definition,
            ):
                Ok(binding): Ok([binding].concat(block.scope))
                Err(error): Err(error)
    continuation ?= accepted.resolve_result_prefix(
        position + 1,
        {
            lambdas = source.lambdas,
            bindings = bindings.append(definition),
            scope = scope,
            statements = [],
            reassigned = [],
        },
        initial,
        result,
        context,
    )
    failure = binding_id(continuation.bindings.length())
    error_definition: BindingDefinition = {
        origin = MatchCapture,
        mutable = False,
        value_type = error_type,
        span = written.value.span,
    }
    error_value: CheckedExpr = {
        form = ReadBinding(failure),
        value_type = error_type,
        span = written.value.span,
    }
    root: CheckedPatternPlace = { value_type = source.value.value_type, route = MatchRoot }
    matched_selection ?= Patterns.union_selection(
        [
            {
                arm = match_arm_id(0),
                variant = result.ok,
                fields = [success_type],
                arguments = [
                    BorrowPlace({
                        value_type = success_type,
                        route = UnionField(root, result.ok, 0),
                    }),
                ],
            },
            {
                arm = match_arm_id(1),
                variant = result.err,
                fields = [error_type],
                arguments = [
                    BorrowPlace({
                        value_type = error_type,
                        route = UnionField(root, result.err, 0),
                    }),
                ],
            },
        ],
        source.value.value_type,
        written.span,
        context,
    )
    -- The selected source Err and constructed return Err share a declaration,
    -- but their enclosing Result instantiations can differ after specialization.
    Ok({
        lambdas = continuation.lambdas,
        bindings = continuation.bindings.append(error_definition),
        statements = block.statements.append(InitializeBinding(source_id, source.value)),
        value = {
            form = Match({
                scrutinee = {
                    form = ReadBinding(source_id),
                    value_type = source.value.value_type,
                    span = written.value.span,
                },
                selection = matched_selection,
                carried = [],
                arms = [
                    {
                        id = match_arm_id(0),
                        inputs = [success],
                        statements = continuation.statements,
                        value = continuation.value,
                    },
                    {
                        id = match_arm_id(1),
                        inputs = [failure],
                        statements = [],
                        value = {
                            form = ConstructVariant(result.err, [error_value]),
                            value_type = returned.value_type,
                            span = written.span,
                        },
                    },
                ],
            }),
            value_type = returned.value_type,
            span = written.span,
        },
    })


-- Checks every function body in declaration order, including unreachable ones.
pure func resolve_functions(
    functions: List[AcceptedFunction],
    declarations: CheckedDeclarations,
    opaque_declarations: List[OpaqueRow],
    namespace: Namespace,
    receivers: List[AdmittedReceiverScope],
    constants: List[CheckedConstant],
    traits: TraitAvailability,
    result: DesignatedResult[VariantId],
    boolean: DesignatedBoolean[VariantId],
    option: DesignatedOption[VariantId],
) -> Result[CheckedBodies, CheckError]:
    var checked: List[CheckedFunction] = []
    var lambdas: List[LambdaRow] = []
    var failure: Option[CheckError] = None
    while failure.is_none():
        match functions.get(checked.length()):
            None: break
            Some(accepted):
                match receivers.get(accepted.body_types.module.module_number()):
                    None:
                        failure = Some(
                            checker_invariant(
                                accepted.declaration.function_name.span,
                                InvalidReceiverScope,
                            ),
                        )
                    Some(receiver_scope):
                        id = accepted.id
                        context: ResolutionContext = {
                            traits = traits,
                            caller = {
                                body = DeclaredBody(id),
                                purity = accepted.signature.purity,
                            },
                            root_function = id,
                            module = accepted.body_types.module,
                            namespace = accepted.body_types.namespace,
                            receiver_scope = receiver_scope,
                            body_types = accepted.body_types,
                            signatures = functions,
                            unions = declarations.unions,
                            records = declarations.records,
                            opaque_declarations = opaque_declarations,
                            opaques = declarations.opaques,
                            constants = constants,
                            boolean = boolean,
                            option = option,
                            in_source_loop = False,
                        }
                        signature = accepted.signature
                        match accepted.resolve_body(result, context, lambdas):
                            Ok(body):
                                match accepted.declaration.check_execution(
                                    accepted.signature.type_parameters,
                                    body.statements,
                                    body.body,
                                    id,
                                    traits.accepted_traits(),
                                ):
                                    Ok(execution):

                                        executed: ResolvedBody = { body | body = execution.body }

                                        published = if signature.return_type.value_type == VoidType:
                                            executed.normalize_void_body()
                                        else:
                                            executed

                                        checked = checked.append({
                                            id = id,
                                            label = accepted.label,
                                            execution = execution.execution,
                                            signature = signature,
                                            bindings = published.bindings,
                                            statements = published.statements,
                                            body = published.body,
                                        })
                                        lambdas = published.lambdas
                                    Err(error): failure = Some(error)
                            Err(error): failure = Some(error)
    match failure:
        Some(error): Err(error)
        None:
            match lambdas.seal_lambda_rows():
                Ok(rows): Ok({ functions = checked, lambdas = rows })
                Err(error): Err(error)


private record NormalizedVoidExit { statements: List[CheckedStatement], exit: CheckedExit }


private pure func normalize_void_exit(
    statements: List[CheckedStatement],
    exit: CheckedExit,
) -> NormalizedVoidExit:
    match exit:
        RecurWith(_, _): { statements = statements, exit = exit }
        ReturnExpression(value):
            discarded = statements.discard_tail_value(value)
            { statements = discarded.statements, exit = ReturnExpression(discarded.value) }


-- A Void tail value after discarding: statements, then canonical void.
private record DiscardedTail { statements: List[CheckedStatement], value: CheckedExpr }


-- A match at a Void tail was resolved with VoidTail, so it is Void and its
-- arm values are tail values too: each is discarded the same way first.
private pure func discard_tail_value(
    statements: List[CheckedStatement],
    value: CheckedExpr,
) -> DiscardedTail:
    match value.form:
        LiteralVoid: { statements = statements, value = value }
        _:
            {
                statements = statements.append(DiscardExpression(value.discard_arm_values())),
                value = { form = LiteralVoid, value_type = VoidType, span = value.span },
            }


private pure func discard_arm_values(value: CheckedExpr) -> CheckedExpr:
    match value.form:
        Match(join):
            var arms: List[CheckedJoinArm] = []
            for arm in join.arms:
                discarded = arm.statements.discard_tail_value(arm.value)
                arms = arms.append(
                    { arm | statements = discarded.statements, value = discarded.value },
                )
            { value | form = Match({ join | arms = arms }) }
        _: value


-- A Void body's tails return canonical void after discarding their values.
private pure func normalize_void_body(resolved: ResolvedBody) -> ResolvedBody:
    match resolved.body:
        CheckedValueBody(exit):
            normalized = resolved.statements.normalize_void_exit(exit)
            { resolved |
                statements = normalized.statements,
                body = CheckedValueBody(normalized.exit),
            }
        CheckedMatchBody(matched):
            arms = matched.arms.map(pure func(arm: CheckedArm) -> CheckedArm:
                normalized = arm.statements.normalize_void_exit(arm.body)
                { arm | statements = normalized.statements, body = normalized.exit }
            )
            { resolved | body = CheckedMatchBody({ matched | arms = arms }) }


-- Seal the single reserved inventory; a missing completion is a checker fault.
private pure func seal_lambda_rows(
    rows: List[LambdaRow],
) -> Result[List[CheckedLambda], CheckError]:
    var complete: List[CheckedLambda] = []
    var missing: Bool = False
    for row in rows:
        match row:
            CheckedLambdaRow(value): complete = complete.append(value)
            CollectingLambda(_):
                missing = True
                break
    if missing:
        Err(checker_invariant(compiler_span(), InvalidInferenceWorklist))
    else:
        Ok(complete)


-- Blocks reuse the root's accepted annotation scope and ordinary body rules.
pure func resolve_lambda_block(
    scope: List[ScopedValue],
    parameters: List[BindingDefinition],
    block: ParsedBlock,
    result: TypeUse,
    context: ResolutionContext,
    lambdas: List[LambdaRow],
) -> Result[ResolvedBody, CheckError]:
    prefix ?= block.statements.resolve_statements(
        {
            bindings = parameters,
            scope = scope,
            statements = [],
            reassigned = [],
            lambdas = lambdas,
        },
        context,
    )
    written: ValueExpression = block.value.get_or({
        base = VoidExpression,
        base_span = block.span,
        applications = [],
        parentheses = [],
        span = block.span,
    })
    value ?= prefix.resolve_value(written, result.return_expectation(), context)
    resolved: ResolvedBody = {
        bindings = value.bindings,
        statements = prefix.statements,
        body = CheckedValueBody(ReturnExpression(value.value)),
        lambdas = value.lambdas,
    }
    if result.value_type == VoidType:
        Ok(resolved.normalize_void_body())
    else:
        Ok(resolved)
