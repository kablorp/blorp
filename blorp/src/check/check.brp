---
Checking's public boundary: composes the phases in order and seals either a
CheckedProgram or a CheckFailure carrying the first error.
---
import:
	../namespace/builtins: CheckedFoundation, ParsedProgram methods
	./bodies: resolve_functions
	./constants: constant_annotations, validate_constants
	./errors: BuiltinError(BuiltinTypesRejected), CheckError, CheckErrors, builtin_error, namespace_rejection
	./traits: prepare_equality_availability, accept_trait_contracts, validate_implementations, TraitAvailability
	./well_formed: validate_written_bounds
	./model: CheckedFunctions
	./recursion: validate_recursive_instantiation, finalize_trait_instances, FinalTraits
	./supertraits: validate_supertrait_implementations
	./receiver_clashes: Namespace methods
	./signatures: AcceptedFunction, validate_signatures
	result: Result methods
	./declarations: validate_declarations, CheckedDeclarations
	../utils/ids: FunctionId, RecordId, UnionId, DeclarationInventory
	../namespace/namespace: Namespace, NamespaceProblem, ParsedProgram methods
	../parse/assemble: ParsedProgram


opaque type CheckedProgram = CheckedFunctions


pure func checked_functions(program: CheckedProgram) -> CheckedFunctions:
	from_opaque CheckedProgram(program)


-- The identity of the function at a declaration position, when one exists.
pure func declaration_id(program: CheckedProgram, position: Int) -> Option[FunctionId]:
	match from_opaque CheckedProgram(program).functions.get(position):
		Some(row):
			Some(row.id)
		None:
			None


-- The identity of the record at a declaration position, when one exists.
pure func record_declaration_id(program: CheckedProgram, position: Int) -> Option[RecordId]:
	match from_opaque CheckedProgram(program).records.get(position):
		Some(row): Some(row.id)
		None: None


-- The identity of the union at a declaration position, when one exists.
pure func union_declaration_id(program: CheckedProgram, position: Int) -> Option[UnionId]:
	match from_opaque CheckedProgram(program).unions.get(position):
		Some(row):
			Some(row.id)
		None:
			None


private record FailureContents {
	program: ParsedProgram,
	errors: CheckErrors,
	functions: List[AcceptedFunction]
}


opaque type CheckFailure = FailureContents


private pure func check_program(program: ParsedProgram) -> Result[CheckedProgram, CheckFailure]:
	parsed = program.parsed_contents()

	foundation_result: Result[CheckedFoundation, CheckError] = match program.check_builtin_types():
		Ok(accepted):
			Ok(accepted)
		Err(error):
			Err(builtin_error(error.span, BuiltinTypesRejected(error)))

	foundation ?= foundation_result.map_err(pure func(error): failed(program, error, []))
	namespace_result: Result[Namespace, CheckError] = match program.build_namespace():
		Ok(accepted): Ok(accepted)
		Err(problem): Err(namespace_rejection(problem.namespace_problem_span(), problem))
	namespace ?= namespace_result.map_err(pure func(error): failed(program, error, []))
	declarations ?= parsed.validate_declarations(namespace).map_err(pure func(error): failed(program, error, []))
	declarations_finite ?= declarations.validate_finite_declarations().map_err(pure func(error): failed(program, error, []))
	annotations ?= parsed.constant_annotations(namespace).map_err(pure func(error): failed(program, error, []))
	contracts ?= parsed.accept_trait_contracts(namespace, foundation.designated.boolean).map_err(pure func(error): failed(program, error, []))
	signatures ?= parsed.validate_signatures(namespace, foundation.designated, contracts.declarations).map_err(pure func(error): failed(program, error, []))
	authored ?= parsed.validate_implementations(namespace, signatures.implementation_headers, signatures.functions, contracts).map_err(pure func(error): failed(program, error, signatures.functions))
	availability ?= parsed.prepare_equality_availability(authored, declarations, foundation.designated.boolean).map_err(pure func(error): failed(program, error, signatures.functions))
	_: Void ?= parsed.validate_written_bounds(availability, declarations, signatures.functions, signatures.implementation_headers, annotations).map_err(pure func(error): failed(program, error, signatures.functions))
	traits = availability.accepted_traits()
	receivers ?= namespace.admit_receivers(signatures.functions, parsed.modules.length(), parsed.dependency_order, traits).map_err(pure func(error): failed(program, error, signatures.functions))
	constants ?= parsed.validate_constants(namespace, annotations, declarations.records, declarations.unions, signatures.functions, availability).map_err(pure func(error): failed(program, error, signatures.functions))
	functions ?= signatures.functions.resolve_functions(
		declarations, parsed.declarations.inventory_opaques(),
		namespace, receivers, constants, availability, foundation.designated.result, foundation.designated.boolean, foundation.designated.option,
	).map_err(pure func(error): failed(program, error, signatures.functions))
	unavailable ?= functions.functions.validate_recursive_instantiation(functions.lambdas, traits).map_err(pure func(error): failed(program, error, signatures.functions))
	final ?= constants.finalize_trait_instances(functions.functions, functions.lambdas, traits, unavailable).map_err(pure func(error): failed(program, error, signatures.functions))
	_: Void ?= parsed.validate_supertrait_implementations(namespace, signatures.implementation_headers, availability, final).map_err(pure func(error): failed(program, error, signatures.functions))
	Ok(into_opaque CheckedProgram({
				traits = final.final_traits(),
				unions = declarations.unions,
				records = declarations.records,
				opaques = declarations.opaques,
				functions = functions.functions,
				lambdas = functions.lambdas,
				entrypoint = signatures.entrypoint
			}))


private pure func failed(program: ParsedProgram, error: CheckError, functions: List[AcceptedFunction]) -> CheckFailure:
	into_opaque CheckFailure({ program = program, errors = { first = error, remaining = [] }, functions = functions })


pure func check(program: ParsedProgram) -> Result[CheckedProgram, CheckFailure]:
	program.check_program()


-- Only failed post-signature checking keeps this borrowed accepted view for
-- normalized binder spelling. Successful checked programs discard the scopes.
pure func failure_functions(failure: CheckFailure) -> List[AcceptedFunction]:
	from_opaque CheckFailure(failure).functions


pure func check_errors(failure: CheckFailure) -> CheckErrors:
	from_opaque CheckFailure(failure).errors


pure func failure_program(failure: CheckFailure) -> ParsedProgram:
	from_opaque CheckFailure(failure).program
