-- Nominal types imported by std/prelude that are not compiler primitives.
--
-- Their identity cannot depend on whether a compiler API happened to include
-- the providing std module's source. In particular, synthetic typecheck graph
-- requests still have the same prelude as ordinary source compilation. Keep
-- the provider, arity, and resource capability closed over this enum so later
-- phases never reconstruct those facts from strings.
enum PreludeType:
	PreludeDict
	PreludeDirectory
	PreludeDirectoryEntry
	PreludeDirectoryEntryKind
	PreludeFileAppender
	PreludeFileReadAppender
	PreludeFileReadWriter
	PreludeFileReader
	PreludeFileWriter
	PreludeIOError
	PreludeList
	PreludeParallelList
	PreludeParallelMatrix
	PreludeParallelVector
	PreludeRange
	PreludeSet


pure func prelude_type(name: String) -> Option[PreludeType]:
	match name:
		"Dict":
			Some(PreludeDict)
		"Directory":
			Some(PreludeDirectory)
		"DirectoryEntry":
			Some(PreludeDirectoryEntry)
		"DirectoryEntryKind":
			Some(PreludeDirectoryEntryKind)
		"FileAppender":
			Some(PreludeFileAppender)
		"FileReadAppender":
			Some(PreludeFileReadAppender)
		"FileReadWriter":
			Some(PreludeFileReadWriter)
		"FileReader":
			Some(PreludeFileReader)
		"FileWriter":
			Some(PreludeFileWriter)
		"IOError":
			Some(PreludeIOError)
		"List":
			Some(PreludeList)
		"ParallelList":
			Some(PreludeParallelList)
		"ParallelMatrix":
			Some(PreludeParallelMatrix)
		"ParallelVector":
			Some(PreludeParallelVector)
		"Range":
			Some(PreludeRange)
		"Set":
			Some(PreludeSet)
		_:
			None


pure func prelude_type_name(typ: PreludeType) -> String:
	match typ:
		PreludeDict:
			"Dict"
		PreludeDirectory:
			"Directory"
		PreludeDirectoryEntry:
			"DirectoryEntry"
		PreludeDirectoryEntryKind:
			"DirectoryEntryKind"
		PreludeFileAppender:
			"FileAppender"
		PreludeFileReadAppender:
			"FileReadAppender"
		PreludeFileReadWriter:
			"FileReadWriter"
		PreludeFileReader:
			"FileReader"
		PreludeFileWriter:
			"FileWriter"
		PreludeIOError:
			"IOError"
		PreludeList:
			"List"
		PreludeParallelList:
			"ParallelList"
		PreludeParallelMatrix:
			"ParallelMatrix"
		PreludeParallelVector:
			"ParallelVector"
		PreludeRange:
			"Range"
		PreludeSet:
			"Set"


pure func prelude_type_module_path(typ: PreludeType) -> String:
	match typ:
		PreludeDict:
			"dict"
		PreludeDirectory:
			"fs"
		PreludeDirectoryEntry:
			"fs"
		PreludeDirectoryEntryKind:
			"fs"
		PreludeFileAppender:
			"fs"
		PreludeFileReadAppender:
			"fs"
		PreludeFileReadWriter:
			"fs"
		PreludeFileReader:
			"fs"
		PreludeFileWriter:
			"fs"
		PreludeIOError:
			"fs"
		PreludeList:
			"list"
		PreludeParallelList:
			"list"
		PreludeParallelMatrix:
			"matrix"
		PreludeParallelVector:
			"vector"
		PreludeRange:
			"range"
		PreludeSet:
			"set"


pure func prelude_type_arity(typ: PreludeType) -> Int:
	match typ:
		PreludeDict:
			2
		PreludeList:
			1
		PreludeParallelList:
			1
		PreludeParallelMatrix:
			3
		PreludeParallelVector:
			2
		PreludeSet:
			1
		_:
			0


pure func prelude_type_is_resource(typ: PreludeType) -> Bool:
	match typ:
		PreludeDirectory:
			True
		PreludeFileAppender:
			True
		PreludeFileReadAppender:
			True
		PreludeFileReadWriter:
			True
		PreludeFileReader:
			True
		PreludeFileWriter:
			True
		_:
			False


-- Synthetic frontend graphs may resolve prelude names without loading their
-- declarations. Keep the inline-layout fact attached to the closed prelude
-- identity instead of recovering it from the source spelling.
pure func prelude_type_has_inline_value_storage(typ: PreludeType) -> Bool:
	match typ:
		PreludeDirectoryEntryKind | PreludeRange:
			True
		_:
			False


-- Source declarations whose unqualified names are part of the runtime ABI.
--
-- This identity is assigned from the canonical module path and declaration
-- name while the frontend still owns both facts. Core carries the accepted
-- identity explicitly; later phases must not infer ABI status from a name that
-- happens to match one of these declarations.
enum DeclaredAbiType:
	DeclaredAbiBool
	DeclaredAbiConcurrencyError
	DeclaredAbiDirectoryEntry
	DeclaredAbiInt64
	DeclaredAbiMemStats
	DeclaredAbiOption
	DeclaredAbiRange
	DeclaredAbiResult
	DeclaredAbiSchedulerStats


pure func declared_abi_type(module_path: String, type_name: String) -> Option[DeclaredAbiType]:
	match (module_path, type_name):
		("std/bool", "Bool"):
			Some(DeclaredAbiBool)
		("std/channel", "ConcurrencyError"):
			Some(DeclaredAbiConcurrencyError)
		("std/fs", "DirectoryEntry"):
			Some(DeclaredAbiDirectoryEntry)
		("std/int", "Int64"):
			Some(DeclaredAbiInt64)
		("std/instrumentation", "SchedulerStats"):
			Some(DeclaredAbiSchedulerStats)
		("std/memory", "MemStats"):
			Some(DeclaredAbiMemStats)
		("std/option", "Option"):
			Some(DeclaredAbiOption)
		("std/range", "Range"):
			Some(DeclaredAbiRange)
		("std/result", "Result"):
			Some(DeclaredAbiResult)
		_:
			None


pure func declared_abi_type_name(typ: DeclaredAbiType) -> String:
	match typ:
		DeclaredAbiBool:
			"Bool"
		DeclaredAbiConcurrencyError:
			"ConcurrencyError"
		DeclaredAbiDirectoryEntry:
			"DirectoryEntry"
		DeclaredAbiInt64:
			"Int64"
		DeclaredAbiMemStats:
			"MemStats"
		DeclaredAbiOption:
			"Option"
		DeclaredAbiRange:
			"Range"
		DeclaredAbiResult:
			"Result"
		DeclaredAbiSchedulerStats:
			"SchedulerStats"


-- `builtin` declarations are compiler ABI boundaries. Their representation is
-- determined by the canonical std module and declaration name together; a
-- same-named declaration in another module does not inherit this storage.
enum BuiltinValueStorage:
	BuiltinInlineScalar
	BuiltinManagedReference
	BuiltinNoValue


private INLINE_SCALAR_BUILTIN_TYPES: List[(String, String)] = [
	("std/int", "Int"),
	("std/int8", "Int8"),
	("std/int16", "Int16"),
	("std/int32", "Int32"),
	("std/int128", "Int128"),
	("std/uint8", "UInt8"),
	("std/uint16", "UInt16"),
	("std/uint32", "UInt32"),
	("std/uint64", "UInt64"),
	("std/uint128", "UInt128"),
	("std/float", "Float"),
	("std/float16", "Float16"),
	("std/float32", "Float32"),
	("std/char", "Char"),
	("std/ptr", "Ptr"),
	("std/net/tcp", "Port"),
]

private MANAGED_REFERENCE_BUILTIN_TYPES: List[(String, String)] = [
	("std/bytes", "Bytes"),
	("std/channel", "Channel"),
	("std/dict", "Dict"),
	("std/fixed", "Fixed"),
	("std/list", "List"),
	("std/list", "ParallelList"),
	("std/matrix", "ParallelMatrix"),
	("std/net/tcp", "DnsName"),
	("std/net/tcp", "InterfaceScope"),
	("std/net/tcp", "IpAddress"),
	("std/set", "Set"),
	("std/slice", "StringSlice"),
	("std/stream", "FallibleStream"),
	("std/stream", "ResourceSource"),
	("std/stream", "Stream"),
	("std/string", "String"),
	("std/vector", "ParallelVector"),
]


pure func builtin_value_storage(
	module_name: String,
	type_name: String,
) -> Option[BuiltinValueStorage]:
	identity = (module_name, type_name)

	if INLINE_SCALAR_BUILTIN_TYPES.contains(identity):
		Some(BuiltinInlineScalar)
	else if MANAGED_REFERENCE_BUILTIN_TYPES.contains(identity):
		Some(BuiltinManagedReference)
	else if identity == ("std/void", "Void"):
		Some(BuiltinNoValue)
	else:
		None


-- Tool-facing projection of prelude method type imports. Semantic typechecking
-- uses PreludeType above; keep these facts centralized so parser,
-- typechecking, and tooling agree.
PRELUDE_METHOD_TYPE_IMPORTS: List[(String, String)] = [
	("option", "Option"),
	("result", "Result"),
	("bool", "Bool"),
	("char", "Char"),
	("bytes", "Bytes"),
	("string", "String"),
	("list", "List"),
	("list", "ParallelList"),
	("parallel_list", "ParallelList"),
	("vector", "ParallelVector"),
	("parallel_vector", "ParallelVector"),
	("matrix", "ParallelMatrix"),
	("parallel_matrix", "ParallelMatrix"),
	("range", "Range"),
	("dict", "Dict"),
	("set", "Set"),
	("fs", "FileReader"),
	("fs", "FileWriter"),
	("fs", "FileAppender"),
	("fs", "FileReadWriter"),
	("fs", "FileReadAppender"),
]
