-- Immutable alias facts used by typechecking after graph declarations leave
-- lexical Env scopes. Construction is owned by the accepted declaration graph;
-- this module only defines the compact lookup and expansion behavior.
import:
	semantic_type:
		SemanticType(
			SemanticArrayType,
			SemanticDimOpType,
			SemanticFunctionType,
			SemanticNamedType,
			SemanticRangeType,
			SemanticTupleType,
			SemanticTypeVar,
		),
		SemanticTypeSubstEntry,
		TYPE_INT,
		apply_subst,
		type_subst_entry,


record TransparentTypeAlias {
	type_params: List[String],
	target: SemanticType
}


record OpaqueTypeAlias {
	type_params: List[String],
	target: SemanticType,
	home_module: Option[String]
}


private record TypeAliasIndexRep {
	transparent_by_name: Dict[String, TransparentTypeAlias],
	opaque_by_name: Dict[String, OpaqueTypeAlias],
	fallback_transparent_by_name: Dict[String, TransparentTypeAlias],
	fallback_opaque_by_name: Dict[String, OpaqueTypeAlias]
}


opaque type TypeAliasIndex = TypeAliasIndexRep


private pure func type_alias_index_rep(index: TypeAliasIndex) -> TypeAliasIndexRep:
	from TypeAliasIndex(index)


TYPE_ALIAS_INDEX_EMPTY: TypeAliasIndex = into TypeAliasIndex({
		transparent_by_name = {},
		opaque_by_name = {},
		fallback_transparent_by_name = {},
		fallback_opaque_by_name = {}
	})


-- Module-local source spellings remain the primary index. Canonical aliases
-- are shared by reference across every module lookup instead of copied into
-- each module's persistent dictionaries.
pure func type_alias_index_with_fallback(
	index: TypeAliasIndex,
	fallback: TypeAliasIndex,
) -> TypeAliasIndex:
	representation = type_alias_index_rep(index)
	fallback_representation = type_alias_index_rep(fallback)

	into TypeAliasIndex({ representation |
			fallback_transparent_by_name = fallback_representation.transparent_by_name,
			fallback_opaque_by_name = fallback_representation.opaque_by_name
		})


pure func type_alias_index_add_transparent(
	index: TypeAliasIndex,
	name: String,
	type_params: List[String],
	target: SemanticType,
) -> Option[TypeAliasIndex]:
	representation = type_alias_index_rep(index)

	if (
		representation.transparent_by_name.contains(name)
		or representation.opaque_by_name.contains(name)
	):
		None
	else:
		Some(
			into TypeAliasIndex(
				{ representation | transparent_by_name = representation.transparent_by_name.set(
						name,
						{
							type_params = type_params,
							target = target
						},
					) }
			),
		)


pure func type_alias_index_add_opaque(
	index: TypeAliasIndex,
	name: String,
	type_params: List[String],
	target: SemanticType,
	home_module: Option[String],
) -> Option[TypeAliasIndex]:
	representation = type_alias_index_rep(index)

	if (
		representation.transparent_by_name.contains(name)
		or representation.opaque_by_name.contains(name)
	):
		None
	else:
		Some(
			into TypeAliasIndex(
				{ representation | opaque_by_name = representation.opaque_by_name.set(
						name,
						{
							type_params = type_params,
							target = target,
							home_module = home_module
						},
					) }
			),
		)


-- Keep this as a factory: global semantic union construction is not yet
-- supported by C emission.
pure func type_alias_index_builtins() -> TypeAliasIndex:
	with_int64 = type_alias_index_add_transparent(
		TYPE_ALIAS_INDEX_EMPTY,
		"Int64",
		[],
		TYPE_INT,
	).get_or(TYPE_ALIAS_INDEX_EMPTY)

	type_alias_index_add_transparent(
		with_int64,
		"TaskResult",
		["T"],
		SemanticNamedType(
			"Result",
			[SemanticTypeVar("T"), SemanticNamedType("ConcurrencyError", [])],
		),
	).get_or(with_int64)


pure func type_alias_index_find_transparent(
	index: TypeAliasIndex,
	name: String,
) -> Option[TransparentTypeAlias]:
	representation = type_alias_index_rep(index)

	match representation.transparent_by_name.get(name):
		Some(alias_entry):
			Some(alias_entry)
		None:
			representation.fallback_transparent_by_name.get(name)


pure func type_alias_index_find_opaque(
	index: TypeAliasIndex,
	name: String,
) -> Option[OpaqueTypeAlias]:
	representation = type_alias_index_rep(index)

	match representation.opaque_by_name.get(name):
		Some(alias_entry):
			Some(alias_entry)
		None:
			representation.fallback_opaque_by_name.get(name)


pure func type_alias_index_contains(index: TypeAliasIndex, name: String) -> Bool:
	representation = type_alias_index_rep(index)

	(
		representation.transparent_by_name.contains(name)
		or representation.opaque_by_name.contains(name)
		or representation.fallback_transparent_by_name.contains(name)
		or representation.fallback_opaque_by_name.contains(name)
	)


pure func type_alias_index_entry_count(index: TypeAliasIndex) -> Int:
	representation = type_alias_index_rep(index)

	representation.transparent_by_name.length() + representation.opaque_by_name.length() + representation.fallback_transparent_by_name.length() + representation.fallback_opaque_by_name.length()


private pure func alias_substitution(
	type_params: List[String],
	args: List[SemanticType],
) -> List[SemanticTypeSubstEntry]:
	var substitutions: List[SemanticTypeSubstEntry] = []
	var index: Int = 0

	while index < type_params.length() and index < args.length():
		match (type_params.get(index), args.get(index)):
			(Some(type_param), Some(arg)):
				substitutions = substitutions.append(type_subst_entry(type_param, arg))
			_:
				void

		index += 1

	substitutions


private pure func resolve_alias_list(
	index: TypeAliasIndex,
	seen: List[String],
	types: List[SemanticType],
) -> List[SemanticType]:
	var resolved: List[SemanticType] = []

	for typ in types:
		resolved = resolved.append(resolve_alias_seen(index, seen, typ))

	resolved


private pure func resolve_alias_seen(
	index: TypeAliasIndex,
	seen: List[String],
	typ: SemanticType,
) -> SemanticType:
	match typ:
		SemanticNamedType(name, args):
			if seen.contains(name):
				typ
			else:
				resolved_args = resolve_alias_list(index, seen, args)

				match type_alias_index_find_transparent(index, name):
					Some(alias_entry):
						if alias_entry.type_params.length() == resolved_args.length():
							resolve_alias_seen(
								index,
								seen.append(name),
								apply_subst(
									alias_substitution(alias_entry.type_params, resolved_args),
									alias_entry.target,
								),
							)
						else:
							SemanticNamedType(name, resolved_args)
					None:
						SemanticNamedType(name, resolved_args)
		SemanticArrayType(element, dims):
			SemanticArrayType(
				resolve_alias_seen(index, seen, element),
				resolve_alias_list(index, seen, dims),
			)
		SemanticFunctionType(is_pure, params, return_type):
			SemanticFunctionType(
				is_pure,
				resolve_alias_list(index, seen, params),
				resolve_alias_seen(index, seen, return_type),
			)
		SemanticTupleType(elements):
			SemanticTupleType(resolve_alias_list(index, seen, elements))
		SemanticRangeType(inner):
			SemanticRangeType(resolve_alias_seen(index, seen, inner))
		SemanticDimOpType(op, left, right):
			SemanticDimOpType(
				op,
				resolve_alias_seen(index, seen, left),
				resolve_alias_seen(index, seen, right),
			)
		_:
			typ


pure func type_alias_index_resolve(index: TypeAliasIndex, typ: SemanticType) -> SemanticType:
	resolve_alias_seen(index, [], typ)


private pure func resolve_alias_head_seen(
	index: TypeAliasIndex,
	seen: List[String],
	typ: SemanticType,
) -> SemanticType:
	match typ:
		SemanticNamedType(name, args):
			if seen.contains(name):
				typ
			else:
				match type_alias_index_find_transparent(index, name):
					Some(alias_entry):
						if alias_entry.type_params.length() == args.length():
							resolve_alias_head_seen(
								index,
								seen.append(name),
								apply_subst(
									alias_substitution(alias_entry.type_params, args),
									alias_entry.target,
								),
							)
						else:
							typ
					None:
						typ
		_:
			typ


pure func type_alias_index_resolve_head(index: TypeAliasIndex, typ: SemanticType) -> SemanticType:
	resolve_alias_head_seen(index, [], typ)
