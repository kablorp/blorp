pure func is_stream_type_name(name: String) -> Bool:
	match name:
		"Stream":
			True
		"stream__Stream":
			True
		"stream::Stream":
			True
		_:
			False


pure func is_fallible_stream_type_name(name: String) -> Bool:
	match name:
		"FallibleStream":
			True
		"stream__FallibleStream":
			True
		"stream::FallibleStream":
			True
		_:
			False


pure func is_one_shot_stream_type_name(name: String) -> Bool:
	is_stream_type_name(name) or is_fallible_stream_type_name(name)


pure func is_resource_source_type_name(name: String) -> Bool:
	match name:
		"ResourceSource":
			True
		"stream__ResourceSource":
			True
		"stream::ResourceSource":
			True
		_:
			False


pure func is_runtime_erased_union_payload_type_name(name: String) -> Bool:
	match name:
		"RecvAttempt":
			True
		"channel__RecvAttempt":
			True
		"channel::RecvAttempt":
			True
		_:
			False
