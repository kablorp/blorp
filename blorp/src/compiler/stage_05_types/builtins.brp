enum BuiltinEffect:
	BuiltinImpure
	BuiltinParallelBoundary
	BuiltinCancellationPoint
	BuiltinFiberParking
	BuiltinOsWorkerBlocking


private PRELUDE_TRAITS_MODULE_PATH: String = "traits"

private PRELUDE_TRAITS_MODULE_NAME: String = "traits"


