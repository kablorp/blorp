private enum RuntimeEffect:
	NoRuntimeEffect
	ImpureNonWaiting
	CancellationCheckpoint
	FiberParkingWait
	OsWorkerBlockingWait


union SpecialInference:
	CheckedGetInference
	CheckedSetInference
	CheckedSliceInference
	MatrixCheckedGetInference
	MatrixCheckedSetInference
	TensorCheckedGetInference(Int)
	TensorCheckedSetInference(Int)
	AssertShapeInference
	LengthRefinedInference
	TypeNameInference
	IsHeapInference
	VectorCtorInference
	MatrixCtorInference
	TensorCtorInference(Int)
	BitwiseInference


pure func builtin_is_elementwise_tensor_function(name: String) -> Bool:
	["sqrt", "abs", "exp", "log"].contains(name)


-- Resource-producing builtins borrow their resource argument by default. Keep
-- the exceptional ownership contracts beside the other builtin metadata.
pure func builtin_resource_result_policy(name: String) -> ResourceResultPolicy:
	match name:
		"blorp_tcp_accept_raw":
			ResourceResultIndependent
		_:
			ResourceResultDependent


