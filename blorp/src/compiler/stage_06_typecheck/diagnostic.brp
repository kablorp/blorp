-- Structured typecheck failures retained for tooling and later rendering.
--
-- The CLI still consumes the existing message list. Keeping the source span as
-- compiler data prevents tools from recovering locations from display text.
import:
	../../lib/source: SourceLocation


record TypecheckDiagnostic {
	message: String,
	span: Option[SourceLocation]
}


pure func typecheck_diagnostic(
	message: String,
	span: Option[SourceLocation],
) -> TypecheckDiagnostic:
	{
		message = message,
		span = span
	}
