-- One opaque owner for the import facts visible while typechecking a module.
-- Ordered inventories preserve deterministic diagnostics and downstream
-- projection. Exact indexes serve semantic lookup. Construction operations
-- update both together or return a conflict without exposing a partial view.
import:
	../../stage_04_modules/module_table:
		ModuleId,
		ModuleTable,
		module_ids_equal,
		module_table_canonical_path,
		module_tables_are_compatible,
	../graph/definition_index:
		DefinitionId,
		DefinitionTable,
		definition_table_module_table,
		definition_table_selective_definition_name,
		definition_tables_share_provenance,
	../graph/source_name_table:
		GraphModuleNameScope,
		GraphSourceNameTable,
		SourceNameId,
		graph_module_name_scope_graph_names,
		graph_module_name_scope_module_id,
		graph_source_name_table_module_table,
		graph_source_name_table_source_names,
		source_name_id_table_index,
		source_name_table_find_id,
		source_name_table_id_at,
	../type_system/accepted_alias_authority:
		AcceptedAliasAuthority,
		accepted_alias_authority_without_visible_names,
	../type_system/accepted_callable_authority:
		AcceptedCallableAuthority,
		accepted_callable_authority_without_visible_names,
	../type_system/accepted_global_authority:
		AcceptedGlobalAuthority,
		accepted_global_authority_without_visible_names,
	../type_system/accepted_record_authority:
		AcceptedRecordAuthority,
		accepted_record_authority_without_visible_names,
	../type_system/accepted_trait_implementation_authority:
		AcceptedTraitImplementationAuthority,
		accepted_trait_implementation_authority_without_visible_names,
	../type_system/accepted_union_authority:
		AcceptedUnionAuthority,
		accepted_union_authority_without_visible_names,
	import_binding:
		ImportBinding(
			GraphQualifiedModuleBinding,
			GraphSelectiveDefinitionBinding,
			GraphSelectiveTraitMethodBinding,
			StandaloneQualifiedModuleBinding,
			StandaloneSelectiveDefinitionBinding,
		),
		MODULE_IMPORT_TARGET_INVALID_LABEL,


record ImportedNameBinding {
	local_name: String,
	module_path: String,
	original_name: String
}


record ImportedConstructorBinding {
	local_name: String,
	module_path: String,
	parent_local_name: String,
	parent_name: String,
	original_name: String
}


enum TopLevelNameKind:
	TopLevelType
	TopLevelConstructor
	TopLevelFunction
	TopLevelVariable
	TopLevelTrait


private enum ImportBindingDomain:
	NoImportBindings
	GraphImportBindings
	StandaloneImportBindings


private union LocalNameStorage:
	GraphLocalNameStorage(Int)
	StandaloneLocalNameStorage


-- One current-occupancy row per graph spelling. Alias and selective import
-- may coexist only when they target the same module; local names are exclusive.
private union BoundNameOccupancy:
	BoundModuleAlias(ModuleId)
	BoundSelectiveName(ImportedNameBinding)
	BoundAliasAndSelectiveName(ModuleId, ImportedNameBinding)
	BoundLocalName(TopLevelNameKind)


private record BoundVisibility {
	issuer: GraphModuleNameScope,
	-- Occupancy is one row per cataloged name; binding order belongs to the
	-- ordered import inventory, never to dictionary iteration order.
	rows_by_source_name_index: Dict[Int, BoundNameOccupancy]
}


private record ModuleViewRep {
	graph_visibility: Option[BoundVisibility],
	standalone_module_aliases_by_local_name: Dict[String, String],
	import_binding_domain: ImportBindingDomain,
	-- Graph selective names live in bound occupancy and the ordered binding
	-- log. Only standalone compatibility keeps this second source-facing list.
	imported_names: List[ImportedNameBinding],
	standalone_imported_names_by_local_name: Dict[String, ImportedNameBinding],
	imported_constructors: List[ImportedConstructorBinding],
	import_bindings: List[ImportBinding],
	standalone_local_names_by_local_name: Dict[String, TopLevelNameKind],
	accepted_alias_authority: Option[AcceptedAliasAuthority],
	accepted_record_authority: Option[AcceptedRecordAuthority],
	accepted_union_authority: Option[AcceptedUnionAuthority],
	accepted_global_authority: Option[AcceptedGlobalAuthority],
	accepted_callable_authority: Option[AcceptedCallableAuthority],
	accepted_trait_implementation_authority: Option[AcceptedTraitImplementationAuthority]
}


opaque type ModuleView = ModuleViewRep


union ModuleAliasRegistration:
	ModuleAliasAdded(ModuleView)
	ModuleAliasAlreadyPresent
	ModuleAliasConflictsWithAlias(String)
	ModuleAliasConflictsWithImportedName(ImportedNameBinding)
	ModuleAliasConflictsWithLocalName(TopLevelNameKind)
	ModuleAliasInvalidTarget


union SelectiveNameRegistration:
	SelectiveNameAdded(ModuleView)
	SelectiveNameConflictsWithAlias(String)
	SelectiveNameConflictsWithImportedName(ImportedNameBinding)
	SelectiveNameConflictsWithLocalName(TopLevelNameKind)
	SelectiveNameInvalidSourceName
	SelectiveNameInvalidTarget


union LocalNameRegistration:
	LocalNameAdded(ModuleView)
	LocalNameAlreadyPresent(TopLevelNameKind)
	LocalNameConflictsWithAlias(String)
	LocalNameConflictsWithImportedName(ImportedNameBinding)
	LocalNameInvalidSourceName


private pure func module_view_rep(view: ModuleView) -> ModuleViewRep:
	from_opaque ModuleView(view)


private pure func module_view_from_rep(representation: ModuleViewRep) -> ModuleView:
	into_opaque ModuleView(representation)


COMPILER_MODULE_VIEW_EMPTY: ModuleView = module_view_from_rep({
	graph_visibility = None,
	standalone_module_aliases_by_local_name = {},
	import_binding_domain = NoImportBindings,
	imported_names = [],
	standalone_imported_names_by_local_name = {},
	imported_constructors = [],
	import_bindings = [],
	standalone_local_names_by_local_name = {},
	accepted_alias_authority = None,
	accepted_record_authority = None,
	accepted_union_authority = None,
	accepted_global_authority = None,
	accepted_callable_authority = None,
	accepted_trait_implementation_authority = None,
})


-- Indexed graph states receive the one compilation-owned spelling table
-- before any visibility registration. Standalone source helpers deliberately
-- retain their source-oriented string maps.
pure func module_view_for_graph(issuer: GraphModuleNameScope) -> ModuleView:
	representation = module_view_rep(COMPILER_MODULE_VIEW_EMPTY)
	visibility: BoundVisibility = {
		issuer = issuer,
		rows_by_source_name_index = {}
	}
	module_view_from_rep({ representation | graph_visibility = Some(visibility) })


pure func module_view_has_graph_source_names(view: ModuleView) -> Bool:
	module_view_rep(view).graph_visibility.is_some()


pure func module_view_graph_bound_name_count(view: ModuleView) -> Int:
	match module_view_rep(view).graph_visibility:
		Some(visibility):
			visibility.rows_by_source_name_index.length()
		None:
			0


-- Prescan knows every graph-local spelling before import admission. Build the
-- initial occupancy with uniquely owned local collections, then publish one
-- immutable view. A non-fresh or foreign view must use ordinary registration;
-- callers can preserve its per-name diagnostics by falling back on None.
pure func module_view_bind_initial_graph_local_names(
	view: ModuleView,
	module_table: ModuleTable,
	current_module_id: ModuleId,
	local_names: List[(String, TopLevelNameKind)],
) -> Option[ModuleView]:
	if not module_view_graph_has_owner(view, module_table, current_module_id):
		None
	else:
		representation = module_view_rep(view)
		match representation.graph_visibility:
			None:
				None
			Some(visibility):
				if (
					not visibility.rows_by_source_name_index.is_empty()
					or representation.import_binding_domain != NoImportBindings
					or not representation.imported_names.is_empty()
					or not representation.imported_constructors.is_empty()
					or not representation.import_bindings.is_empty()
					or representation.accepted_alias_authority.is_some()
					or representation.accepted_record_authority.is_some()
					or representation.accepted_union_authority.is_some()
					or representation.accepted_global_authority.is_some()
					or representation.accepted_callable_authority.is_some()
					or representation.accepted_trait_implementation_authority.is_some()
				):
					None
				else if local_names.is_empty():
					Some(view)
				else:
					table = graph_source_name_table_source_names(
						graph_module_name_scope_graph_names(visibility.issuer),
					)
					var rows_by_source_name_index: Dict[Int, BoundNameOccupancy] = {}
					var all_cataloged = True

					for candidate in local_names:
						match source_name_table_find_id(table, candidate[0]):
							None:
								all_cataloged = False
							Some(source_name_id):
								source_name_index = source_name_id_table_index(source_name_id)
								if not rows_by_source_name_index.contains(source_name_index):
									rows_by_source_name_index = rows_by_source_name_index.set(
										source_name_index,
										BoundLocalName(candidate[1]),
									)

					if not all_cataloged:
						None
					else:
						Some(module_view_from_rep({ representation |
							graph_visibility = Some({ visibility |
								rows_by_source_name_index = rows_by_source_name_index
							})
						}))


pure func module_view_graph_has_owner(
	view: ModuleView,
	module_table: ModuleTable,
	module_id: ModuleId,
) -> Bool:
	match module_view_rep(view).graph_visibility:
		Some(visibility):
			(
				module_tables_are_compatible(
					graph_source_name_table_module_table(
						graph_module_name_scope_graph_names(visibility.issuer),
					),
					module_table,
				)
				and module_ids_equal(
					graph_module_name_scope_module_id(visibility.issuer),
					module_id,
				)
			)
		None:
			False


-- Standalone tooling may reuse a graph-reserved TypecheckState for its module
-- identity and definition allocation, but it must explicitly discard the
-- graph spelling capability before accepting source-only import bindings.
pure func module_view_for_standalone_source_bindings(view: ModuleView) -> Option[ModuleView]:
	representation = module_view_rep(view)

	match representation.import_binding_domain:
		GraphImportBindings:
			None
		_:
			match representation.graph_visibility:
				Some(visibility):
					if visibility.rows_by_source_name_index.is_empty():
						Some(module_view_from_rep({ representation | graph_visibility = None }))
					else:
						None
				None:
					Some(view)


pure func top_level_name_kind_label(kind: TopLevelNameKind) -> String:
	match kind:
		TopLevelType:
			"type"
		TopLevelConstructor:
			"constructor"
		TopLevelFunction:
			"function"
		TopLevelVariable:
			"variable"
		TopLevelTrait:
			"trait"


pure func top_level_name_kind_is_trait(kind: TopLevelNameKind) -> Bool:
	match kind:
		TopLevelTrait:
			True
		_:
			False


pure func module_view_has_standalone_import_bindings(view: ModuleView) -> Bool:
	match module_view_rep(view).import_binding_domain:
		StandaloneImportBindings:
			True
		_:
			False


pure func module_view_has_graph_import_bindings(view: ModuleView) -> Bool:
	match module_view_rep(view).import_binding_domain:
		GraphImportBindings:
			True
		_:
			False


pure func module_view_module_alias_count(view: ModuleView) -> Int:
	representation = module_view_rep(view)

	match representation.import_binding_domain:
		GraphImportBindings:
			var count: Int = 0
			for binding in representation.import_bindings:
				match binding:
					GraphQualifiedModuleBinding(_, _):
						count += 1
					_:
						void
			count
		StandaloneImportBindings:
			representation.standalone_module_aliases_by_local_name.length()
		NoImportBindings:
			0


-- Ordered graph projection is intentionally confined to compatibility
-- readers. Ordinary graph name resolution must use keyed occupancy instead.
private pure func graph_imported_names_from_bindings(
	view: ModuleView,
	bindings: List[ImportBinding],
) -> List[ImportedNameBinding]:
	var names: List[ImportedNameBinding] = []
	for binding in bindings:
		match binding:
			GraphSelectiveDefinitionBinding(local_name, _, _) | GraphSelectiveTraitMethodBinding(local_name, _, _, _):
				match module_view_find_imported_name(view, local_name):
					Some(name):
						names = names.append(name)
					None:
						void
			_:
				void
	names


pure func module_view_imported_names(view: ModuleView) -> List[ImportedNameBinding]:
	representation = module_view_rep(view)
	match representation.graph_visibility:
		Some(_):
			graph_imported_names_from_bindings(view, representation.import_bindings)
		None:
			representation.imported_names


pure func module_view_imported_constructors(view: ModuleView) -> List[ImportedConstructorBinding]:
	module_view_rep(view).imported_constructors


pure func module_view_record_imported_constructor(
	view: ModuleView,
	binding: ImportedConstructorBinding,
) -> ModuleView:
	representation = module_view_rep(view)
	module_view_from_rep(
		{ representation |
			imported_constructors = representation.imported_constructors.append(binding)
		},
	)


pure func module_view_import_bindings(view: ModuleView) -> List[ImportBinding]:
	module_view_rep(view).import_bindings


pure func module_view_accepted_alias_authority(view: ModuleView) -> Option[AcceptedAliasAuthority]:
	module_view_rep(view).accepted_alias_authority


pure func module_view_with_accepted_alias_authority(
	view: ModuleView,
	authority: AcceptedAliasAuthority,
) -> ModuleView:
	representation = module_view_rep(view)
	module_view_from_rep({ representation | accepted_alias_authority = Some(authority) })


pure func module_view_accepted_record_authority(
	view: ModuleView,
) -> Option[AcceptedRecordAuthority]:
	module_view_rep(view).accepted_record_authority


pure func module_view_with_accepted_record_authority(
	view: ModuleView,
	authority: AcceptedRecordAuthority,
) -> ModuleView:
	representation = module_view_rep(view)
	module_view_from_rep({ representation | accepted_record_authority = Some(authority) })


pure func module_view_accepted_union_authority(view: ModuleView) -> Option[AcceptedUnionAuthority]:
	module_view_rep(view).accepted_union_authority


pure func module_view_with_accepted_union_authority(
	view: ModuleView,
	index: AcceptedUnionAuthority,
) -> ModuleView:
	representation = module_view_rep(view)
	module_view_from_rep({ representation | accepted_union_authority = Some(index) })


pure func module_view_accepted_global_authority(
	view: ModuleView,
) -> Option[AcceptedGlobalAuthority]:
	module_view_rep(view).accepted_global_authority


pure func module_view_with_accepted_global_authority(
	view: ModuleView,
	authority: AcceptedGlobalAuthority,
) -> ModuleView:
	representation = module_view_rep(view)
	module_view_from_rep({ representation | accepted_global_authority = Some(authority) })


pure func module_view_accepted_callable_authority(
	view: ModuleView,
) -> Option[AcceptedCallableAuthority]:
	module_view_rep(view).accepted_callable_authority


pure func module_view_with_accepted_callable_authority(
	view: ModuleView,
	authority: AcceptedCallableAuthority,
) -> ModuleView:
	representation = module_view_rep(view)
	module_view_from_rep({ representation | accepted_callable_authority = Some(authority) })


pure func module_view_accepted_trait_implementation_authority(
	view: ModuleView,
) -> Option[AcceptedTraitImplementationAuthority]:
	module_view_rep(view).accepted_trait_implementation_authority


pure func module_view_with_accepted_trait_implementation_authority(
	view: ModuleView,
	authority: AcceptedTraitImplementationAuthority,
) -> ModuleView:
	representation = module_view_rep(view)
	module_view_from_rep(
		{ representation | accepted_trait_implementation_authority = Some(authority) },
	)


private pure func module_view_graph_source_name_index(
	representation: ModuleViewRep,
	local_name: String,
) -> Option[Int]:
	visibility ?= representation.graph_visibility
	table = graph_source_name_table_source_names(
		graph_module_name_scope_graph_names(visibility.issuer),
	)
	name_id ?= source_name_table_find_id(table, local_name)
	Some(source_name_id_table_index(name_id))


private pure func bound_visibility_occupancy(
	visibility: BoundVisibility,
	source_name_index: Int,
) -> Option[BoundNameOccupancy]:
	visibility.rows_by_source_name_index.get(source_name_index)


private pure func module_view_graph_occupancy(
	representation: ModuleViewRep,
	source_name_index: Int,
) -> Option[BoundNameOccupancy]:
	visibility ?= representation.graph_visibility
	bound_visibility_occupancy(visibility, source_name_index)


private pure func module_view_with_graph_occupancy(
	representation: ModuleViewRep,
	source_name_index: Int,
	occupancy: BoundNameOccupancy,
) -> ModuleViewRep:
	match representation.graph_visibility:
		None:
			representation
		Some(visibility):
			match visibility.rows_by_source_name_index.get(source_name_index):
				Some(_):
					next = { visibility |
						rows_by_source_name_index = visibility.rows_by_source_name_index.set(
							source_name_index,
							occupancy,
						)
					}
					{ representation | graph_visibility = Some(next) }
				None:
					table = graph_source_name_table_source_names(
						graph_module_name_scope_graph_names(visibility.issuer),
					)
					match source_name_table_id_at(table, source_name_index):
						Some(_):
							next = { visibility |
								rows_by_source_name_index = visibility.rows_by_source_name_index.set(
									source_name_index,
									occupancy,
								)
							}
							{ representation | graph_visibility = Some(next) }
						None:
							representation


private pure func bound_name_module_alias(
	occupancy: BoundNameOccupancy,
) -> Option[ModuleId]:
	match occupancy:
		BoundModuleAlias(module_id) | BoundAliasAndSelectiveName(module_id, _):
			Some(module_id)
		_:
			None


private pure func bound_name_imported_name(
	occupancy: BoundNameOccupancy,
) -> Option[ImportedNameBinding]:
	match occupancy:
		BoundSelectiveName(binding) | BoundAliasAndSelectiveName(_, binding):
			Some(binding)
		_:
			None


private pure func bound_name_local_kind(
	occupancy: BoundNameOccupancy,
) -> Option[TopLevelNameKind]:
	match occupancy:
		BoundLocalName(kind):
			Some(kind)
		_:
			None


private pure func module_view_graph_imported_name_at(
	representation: ModuleViewRep,
	source_name_index: Int,
) -> Option[ImportedNameBinding]:
	occupancy ?= module_view_graph_occupancy(representation, source_name_index)
	bound_name_imported_name(occupancy)


private pure func module_view_graph_local_kind_at(
	representation: ModuleViewRep,
	source_name_index: Int,
) -> Option[TopLevelNameKind]:
	occupancy ?= module_view_graph_occupancy(representation, source_name_index)
	bound_name_local_kind(occupancy)


private pure func module_view_graph_module_alias_at(
	representation: ModuleViewRep,
	source_name_index: Int,
) -> Option[ModuleId]:
	occupancy ?= module_view_graph_occupancy(representation, source_name_index)
	bound_name_module_alias(occupancy)


pure func module_view_find_graph_module_alias(
	view: ModuleView,
	local_name: String,
) -> Option[ModuleId]:
	representation = module_view_rep(view)
	name_index ?= module_view_graph_source_name_index(representation, local_name)
	occupancy ?= module_view_graph_occupancy(representation, name_index)
	bound_name_module_alias(occupancy)


-- This compatibility projection is for standalone source-oriented consumers.
-- Graph callers obtain the issuing ModuleTable from their scope or graph owner
-- and project a target only at an explicit diagnostic or serialization boundary.
pure func module_view_find_standalone_module_alias(
	view: ModuleView,
	local_name: String,
) -> Option[String]:
	module_view_rep(view).standalone_module_aliases_by_local_name.get(local_name)


private pure func module_view_graph_target_matches_path(
	module_table: Option[ModuleTable],
	module_id: ModuleId,
	module_path: String,
) -> Bool:
	match module_table:
		Some(table):
			module_table_canonical_path(table, module_id) == Some(module_path)
		None:
			False


private pure func module_view_graph_alias_label(
	module_table: Option[ModuleTable],
	module_id: ModuleId,
) -> String:
	match module_table:
		Some(table):
			module_table_canonical_path(table, module_id).get_or(MODULE_IMPORT_TARGET_INVALID_LABEL)
		None:
			MODULE_IMPORT_TARGET_INVALID_LABEL


private pure func module_view_rep_find_imported_name(
	representation: ModuleViewRep,
	local_name: String,
) -> Option[ImportedNameBinding]:
	match representation.graph_visibility:
		Some(_):
			name_index ?= module_view_graph_source_name_index(representation, local_name)
			occupancy ?= module_view_graph_occupancy(representation, name_index)
			bound_name_imported_name(occupancy)
		None:
			representation.standalone_imported_names_by_local_name.get(local_name)


pure func module_view_find_imported_name(
	view: ModuleView,
	local_name: String,
) -> Option[ImportedNameBinding]:
	module_view_rep_find_imported_name(module_view_rep(view), local_name)


private pure func module_view_rep_find_local_name(
	representation: ModuleViewRep,
	local_name: String,
) -> Option[TopLevelNameKind]:
	match representation.graph_visibility:
		Some(_):
			name_index ?= module_view_graph_source_name_index(representation, local_name)
			occupancy ?= module_view_graph_occupancy(representation, name_index)
			bound_name_local_kind(occupancy)
		None:
			representation.standalone_local_names_by_local_name.get(local_name)


pure func module_view_find_local_name(
	view: ModuleView,
	local_name: String,
) -> Option[TopLevelNameKind]:
	module_view_rep_find_local_name(module_view_rep(view), local_name)


pure func module_view_has_selective_binding(
	view: ModuleView,
	local_name: String,
	module_path: String,
	source_name: String,
) -> Bool:
	match module_view_find_imported_name(view, local_name):
		Some(binding):
			binding.module_path == module_path and binding.original_name == source_name
		None:
			False


private pure func module_view_register_graph_module_alias(
	view: ModuleView,
	module_table: ModuleTable,
	local_name: String,
	module_id: ModuleId,
) -> ModuleAliasRegistration:
	representation = module_view_rep(view)
	name_index = module_view_graph_source_name_index(representation, local_name)

	match name_index:
		None:
			ModuleAliasInvalidTarget
		Some(source_name_index):
			module_view_register_graph_module_alias_by_name_index(
				representation,
				module_table,
				local_name,
				source_name_index,
				module_id,
			)


private pure func module_view_register_graph_module_alias_by_name_index(
	representation: ModuleViewRep,
	module_table: ModuleTable,
	local_name: String,
	source_name_index: Int,
	module_id: ModuleId,
) -> ModuleAliasRegistration:
	match module_view_graph_occupancy(representation, source_name_index):
		Some(BoundModuleAlias(existing_module_id)) | Some(BoundAliasAndSelectiveName(existing_module_id, _)):
			if module_ids_equal(existing_module_id, module_id):
				ModuleAliasAlreadyPresent
			else:
				ModuleAliasConflictsWithAlias(
					module_view_graph_alias_label(
						Some(module_table),
						existing_module_id,
					),
				)
		Some(BoundSelectiveName(existing_binding)):
			if not module_view_graph_target_matches_path(
				Some(module_table),
				module_id,
				existing_binding.module_path,
			):
				ModuleAliasConflictsWithImportedName(existing_binding)
			else:
				module_view_add_graph_module_alias(
					representation,
					local_name,
					source_name_index,
					module_id,
				)
		Some(BoundLocalName(existing_kind)):
			ModuleAliasConflictsWithLocalName(existing_kind)
		None:
			module_view_add_graph_module_alias(
				representation,
				local_name,
				source_name_index,
				module_id,
			)


private pure func module_view_add_graph_module_alias(
	representation: ModuleViewRep,
	local_name: String,
	source_name_index: Int,
	module_id: ModuleId,
) -> ModuleAliasRegistration:
	occupancy = match module_view_graph_occupancy(representation, source_name_index):
		Some(BoundSelectiveName(binding)):
			BoundAliasAndSelectiveName(module_id, binding)
		_:
			BoundModuleAlias(module_id)
	next = module_view_with_graph_occupancy(representation, source_name_index, occupancy)
	ModuleAliasAdded(module_view_from_rep({ next |
				import_binding_domain = GraphImportBindings,
				import_bindings = next.import_bindings.append(
					GraphQualifiedModuleBinding(
						local_name,
						module_id,
					),
				)
			}))


private pure func module_view_register_standalone_module_alias_unchecked(
	view: ModuleView,
	local_name: String,
	module_path: String,
) -> ModuleAliasRegistration:
	representation = module_view_rep(view)

	match representation.standalone_module_aliases_by_local_name.get(local_name):
		Some(existing_module_path):
			if existing_module_path == module_path:
				ModuleAliasAlreadyPresent
			else:
				ModuleAliasConflictsWithAlias(existing_module_path)
		None:
			match representation.standalone_imported_names_by_local_name.get(local_name):
				Some(existing_binding):
					if existing_binding.module_path != module_path:
						ModuleAliasConflictsWithImportedName(existing_binding)
					else:
						module_view_add_standalone_module_alias(
							representation,
							local_name,
							module_path,
						)
				None:
					match module_view_rep_find_local_name(representation, local_name):
						Some(existing_kind):
							ModuleAliasConflictsWithLocalName(existing_kind)
						None:
							module_view_add_standalone_module_alias(
								representation,
								local_name,
								module_path,
							)


pure func module_view_register_standalone_module_alias(
	view: ModuleView,
	local_name: String,
	module_path: String,
) -> ModuleAliasRegistration:
	representation = module_view_rep(view)

	if representation.graph_visibility.is_some():
		ModuleAliasInvalidTarget
	else:
		match representation.import_binding_domain:
			GraphImportBindings:
				ModuleAliasInvalidTarget
			_:
				module_view_register_standalone_module_alias_unchecked(
					view,
					local_name,
					module_path,
				)


private pure func module_view_add_standalone_module_alias(
	representation: ModuleViewRep,
	local_name: String,
	module_path: String,
) -> ModuleAliasRegistration:
	ModuleAliasAdded(module_view_from_rep({ representation |
				import_binding_domain = StandaloneImportBindings,
				standalone_module_aliases_by_local_name = representation.standalone_module_aliases_by_local_name.set(
					local_name,
					module_path,
				),
				import_bindings = representation.import_bindings.append(
					StandaloneQualifiedModuleBinding(
						local_name,
						module_path,
					),
				)
			}))


pure func module_view_register_module_alias_target(
	view: ModuleView,
	current_table: ModuleTable,
	current_module_id: ModuleId,
	local_name: String,
	expected_module_path: String,
	issuing_table: ModuleTable,
	module_id: ModuleId,
) -> ModuleAliasRegistration:
	if (
		module_view_graph_has_owner(view, current_table, current_module_id)
		and
		module_tables_are_compatible(current_table, issuing_table)
		and module_table_canonical_path(issuing_table, module_id) == Some(expected_module_path)
		and not module_view_has_standalone_import_bindings(view)
	):
		module_view_register_graph_module_alias(view, current_table, local_name, module_id)
	else:
		ModuleAliasInvalidTarget


private pure func module_view_finish_add_selective_name(
	representation: ModuleViewRep,
	binding: ImportedNameBinding,
	import_binding: ImportBinding,
	domain: ImportBindingDomain,
) -> SelectiveNameRegistration:
	standalone_imported_names = match domain:
		StandaloneImportBindings:
			representation.imported_names.append(binding)
		GraphImportBindings | NoImportBindings:
			representation.imported_names
	SelectiveNameAdded(module_view_from_rep({ representation |
				import_binding_domain = domain,
				imported_names = standalone_imported_names,
				import_bindings = representation.import_bindings.append(import_binding)
			}))


private pure func module_view_add_graph_selective_name(
	representation: ModuleViewRep,
	source_name_index: Int,
	local_name: String,
	module_path: String,
	source_name: String,
	import_binding: ImportBinding,
) -> SelectiveNameRegistration:
	binding: ImportedNameBinding = {
		local_name = local_name,
		module_path = module_path,
		original_name = source_name
	}
	occupancy = match module_view_graph_occupancy(representation, source_name_index):
		Some(BoundModuleAlias(module_id)):
			BoundAliasAndSelectiveName(module_id, binding)
		_:
			BoundSelectiveName(binding)
	next = module_view_with_graph_occupancy(representation, source_name_index, occupancy)
	module_view_finish_add_selective_name(next, binding, import_binding, GraphImportBindings)


private pure func module_view_add_standalone_selective_name(
	representation: ModuleViewRep,
	local_name: String,
	module_path: String,
	source_name: String,
	import_binding: ImportBinding,
) -> SelectiveNameRegistration:
	binding: ImportedNameBinding = {
		local_name = local_name,
		module_path = module_path,
		original_name = source_name
	}
	next = { representation |
		standalone_imported_names_by_local_name = representation.standalone_imported_names_by_local_name.set(
			local_name,
			binding,
		)
	}
	module_view_finish_add_selective_name(next, binding, import_binding, StandaloneImportBindings)


private pure func module_view_register_graph_selective_name(
	representation: ModuleViewRep,
	module_table: ModuleTable,
	source_name_index: Int,
	local_name: String,
	module_path: String,
	source_name: String,
	import_binding: ImportBinding,
) -> SelectiveNameRegistration:
	match module_view_graph_occupancy(representation, source_name_index):
		Some(BoundSelectiveName(existing_binding)) | Some(BoundAliasAndSelectiveName(_, existing_binding)):
			SelectiveNameConflictsWithImportedName(existing_binding)
		Some(BoundModuleAlias(existing_module_id)):
			if module_table_canonical_path(module_table, existing_module_id) == Some(module_path):
				module_view_add_graph_selective_name(
					representation,
					source_name_index,
					local_name,
					module_path,
					source_name,
					import_binding,
				)
			else:
				SelectiveNameConflictsWithAlias(
					module_view_graph_alias_label(Some(module_table), existing_module_id),
				)
		Some(BoundLocalName(existing_kind)):
			SelectiveNameConflictsWithLocalName(existing_kind)
		None:
			module_view_add_graph_selective_name(
				representation,
				source_name_index,
				local_name,
				module_path,
				source_name,
				import_binding,
			)


private pure func module_view_register_standalone_selective_name(
	representation: ModuleViewRep,
	local_name: String,
	module_path: String,
	source_name: String,
	import_binding: ImportBinding,
) -> SelectiveNameRegistration:
	match representation.standalone_imported_names_by_local_name.get(local_name):
		Some(existing_binding):
			SelectiveNameConflictsWithImportedName(existing_binding)
		None:
			match representation.standalone_module_aliases_by_local_name.get(local_name):
				Some(existing_module_path):
					if existing_module_path == module_path:
						module_view_add_standalone_selective_name(
							representation,
							local_name,
							module_path,
							source_name,
							import_binding,
						)
					else:
						SelectiveNameConflictsWithAlias(existing_module_path)
				None:
					match representation.standalone_local_names_by_local_name.get(local_name):
						Some(existing_kind):
							SelectiveNameConflictsWithLocalName(existing_kind)
						None:
							module_view_add_standalone_selective_name(
								representation,
								local_name,
								module_path,
								source_name,
								import_binding,
							)


pure func module_view_register_selective_name_for_graph(
	view: ModuleView,
	current_module_id: ModuleId,
	active_definition_table: DefinitionTable,
	issuing_definition_table: DefinitionTable,
	local_name: String,
	module_path: String,
	source_name: String,
	module_id: ModuleId,
	definition_ids: List[DefinitionId],
) -> SelectiveNameRegistration:
	representation = module_view_rep(view)
	module_table = definition_table_module_table(issuing_definition_table)
	name_index = module_view_graph_source_name_index(representation, local_name)

	match name_index:
		None:
			SelectiveNameInvalidSourceName
		Some(source_name_index):
			if (
				module_view_graph_has_owner(
					view,
					definition_table_module_table(active_definition_table),
					current_module_id,
				)
				and
				definition_tables_share_provenance(
					active_definition_table,
					issuing_definition_table,
				)
				and not module_view_has_standalone_import_bindings(view)
				and module_table_canonical_path(module_table, module_id) == Some(module_path)
				and definition_table_selective_definition_name(
					issuing_definition_table,
					module_id,
					definition_ids,
				) == Some(source_name)
			):
				module_view_register_graph_selective_name(
					representation,
					module_table,
					source_name_index,
					local_name,
					module_path,
					source_name,
					GraphSelectiveDefinitionBinding(local_name, module_id, definition_ids),
				)
			else:
				SelectiveNameInvalidTarget


-- TraitMethodId is issued after this binding boundary. Preserve the public
-- method row explicitly without pretending its source spelling is a generic
-- DefinitionId. Exact overlapping definition targets remain attached for the
-- callable/global authorities that own those identity domains.
pure func module_view_register_graph_selective_trait_method(
	view: ModuleView,
	current_module_id: ModuleId,
	active_definition_table: DefinitionTable,
	issuing_definition_table: DefinitionTable,
	local_name: String,
	module_path: String,
	source_name: String,
	module_id: ModuleId,
	definition_ids: List[DefinitionId],
) -> SelectiveNameRegistration:
	representation = module_view_rep(view)
	module_table = definition_table_module_table(issuing_definition_table)
	name_index = module_view_graph_source_name_index(representation, local_name)

	match name_index:
		None:
			SelectiveNameInvalidSourceName
		Some(source_name_index):
			if (
				not module_view_graph_has_owner(
					view,
					definition_table_module_table(active_definition_table),
					current_module_id,
				)
				or not definition_tables_share_provenance(
					active_definition_table,
					issuing_definition_table,
				)
				or module_table_canonical_path(module_table, module_id) != Some(module_path)
				or module_view_has_standalone_import_bindings(view)
				or (
					not definition_ids.is_empty()
					and definition_table_selective_definition_name(
						issuing_definition_table,
						module_id,
						definition_ids,
					) != Some(source_name)
				)
			):
				SelectiveNameInvalidTarget
			else:
				module_view_register_graph_selective_name(
					representation,
					module_table,
					source_name_index,
					local_name,
					module_path,
					source_name,
					GraphSelectiveTraitMethodBinding(
						local_name,
						module_id,
						source_name,
						definition_ids,
					),
				)


pure func module_view_register_selective_name(
	view: ModuleView,
	local_name: String,
	module_path: String,
	source_name: String,
) -> SelectiveNameRegistration:
	if (
		module_view_rep(view).graph_visibility.is_some()
		or module_view_has_graph_import_bindings(view)
	):
		SelectiveNameInvalidTarget
	else:
		module_view_register_standalone_selective_name(
			module_view_rep(view),
			local_name,
			module_path,
			source_name,
			StandaloneSelectiveDefinitionBinding(local_name, module_path, source_name),
		)


private pure func module_view_add_local_name(
	representation: ModuleViewRep,
	local_name: String,
	kind: TopLevelNameKind,
	storage: LocalNameStorage,
) -> LocalNameRegistration:
	next = match storage:
		GraphLocalNameStorage(source_name_index):
			module_view_with_graph_occupancy(
				representation,
				source_name_index,
				BoundLocalName(kind),
			)
		StandaloneLocalNameStorage:
			{ representation |
				standalone_local_names_by_local_name = representation.standalone_local_names_by_local_name.set(
					local_name,
					kind,
				)
			}

	LocalNameAdded(module_view_from_rep(next))


private pure func module_view_add_local_name_without_alias_conflict(
	representation: ModuleViewRep,
	local_name: String,
	kind: TopLevelNameKind,
	storage: LocalNameStorage,
) -> LocalNameRegistration:
	existing_import = match storage:
		GraphLocalNameStorage(source_name_index):
			module_view_graph_imported_name_at(representation, source_name_index)
		StandaloneLocalNameStorage:
			representation.standalone_imported_names_by_local_name.get(local_name)

	match existing_import:
		Some(existing_binding):
			LocalNameConflictsWithImportedName(existing_binding)
		None:
			module_view_add_local_name(representation, local_name, kind, storage)


private pure func module_view_register_local_name_with_storage(
	view: ModuleView,
	module_table: Option[ModuleTable],
	local_name: String,
	kind: TopLevelNameKind,
	storage: LocalNameStorage,
) -> LocalNameRegistration:
	representation = module_view_rep(view)

	existing_local_name = match storage:
		GraphLocalNameStorage(source_name_index):
			module_view_graph_local_kind_at(representation, source_name_index)
		StandaloneLocalNameStorage:
			representation.standalone_local_names_by_local_name.get(local_name)

	match existing_local_name:
		Some(existing_kind):
			LocalNameAlreadyPresent(existing_kind)
		None:
			match storage:
				GraphLocalNameStorage(source_name_index):
					match module_view_graph_module_alias_at(
						representation,
						source_name_index,
					):
						Some(existing_module_id):
							LocalNameConflictsWithAlias(
								module_view_graph_alias_label(
									module_table,
									existing_module_id,
								),
							)
						None:
							module_view_add_local_name_without_alias_conflict(
								representation,
								local_name,
								kind,
								storage,
							)
				StandaloneLocalNameStorage:
					match representation.standalone_module_aliases_by_local_name.get(local_name):
						Some(existing_module_path):
							LocalNameConflictsWithAlias(existing_module_path)
						None:
							module_view_add_local_name_without_alias_conflict(
								representation,
								local_name,
								kind,
								storage,
							)


pure func module_view_register_local_name_for_graph(
	view: ModuleView,
	module_table: ModuleTable,
	current_module_id: ModuleId,
	local_name: String,
	kind: TopLevelNameKind,
) -> LocalNameRegistration:
	representation = module_view_rep(view)

	if not module_view_graph_has_owner(view, module_table, current_module_id):
		LocalNameInvalidSourceName
	else:
		match module_view_graph_source_name_index(representation, local_name):
			Some(source_name_index):
				module_view_register_local_name_with_storage(
					view,
					Some(module_table),
					local_name,
					kind,
					GraphLocalNameStorage(source_name_index),
				)
			None:
				LocalNameInvalidSourceName


pure func module_view_register_local_name(
	view: ModuleView,
	local_name: String,
	kind: TopLevelNameKind,
) -> LocalNameRegistration:
	if module_view_rep(view).graph_visibility.is_some():
		LocalNameInvalidSourceName
	else:
		module_view_register_local_name_with_storage(
			view,
			None,
			local_name,
			kind,
			StandaloneLocalNameStorage,
		)


private pure func bound_visibility_without_unqualified_names(
	visibility: BoundVisibility,
) -> BoundVisibility:
	var retained_rows: Dict[Int, BoundNameOccupancy] = {}

	for entry in visibility.rows_by_source_name_index.entries():
		module_alias_id = match entry[1]:
			BoundModuleAlias(module_id) | BoundAliasAndSelectiveName(module_id, _):
				Some(module_id)
			_:
				None

		match module_alias_id:
			Some(module_id):
				retained_rows = retained_rows.set(entry[0], BoundModuleAlias(module_id))
			None:
				void

	{ visibility |
		rows_by_source_name_index = retained_rows
	}


pure func module_view_without_unqualified_names(view: ModuleView) -> ModuleView:
	representation = module_view_rep(view)
	qualified_bindings = representation.import_bindings.filter(func(binding):
		match binding:
			GraphQualifiedModuleBinding(_, _) | StandaloneQualifiedModuleBinding(_, _):
				True
			GraphSelectiveDefinitionBinding(_, _, _) | GraphSelectiveTraitMethodBinding(_, _, _, _) | StandaloneSelectiveDefinitionBinding(_, _, _):
				False
	)
	module_view_from_rep({ representation |
			imported_names = [],
			graph_visibility = representation.graph_visibility.map(
				bound_visibility_without_unqualified_names,
			),
			standalone_imported_names_by_local_name = {},
			imported_constructors = [],
			import_bindings = qualified_bindings,
			standalone_local_names_by_local_name = {},
			accepted_alias_authority = representation.accepted_alias_authority.map(
				accepted_alias_authority_without_visible_names,
			),
			accepted_record_authority = representation.accepted_record_authority.map(
				accepted_record_authority_without_visible_names,
			),
			accepted_union_authority = representation.accepted_union_authority.map(
				accepted_union_authority_without_visible_names,
			),
			accepted_global_authority = representation.accepted_global_authority.map(
				accepted_global_authority_without_visible_names,
			),
			accepted_callable_authority = representation.accepted_callable_authority.map(
				accepted_callable_authority_without_visible_names,
			),
			accepted_trait_implementation_authority = representation.accepted_trait_implementation_authority.map(
				accepted_trait_implementation_authority_without_visible_names,
			)
		})
