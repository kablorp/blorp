		{ representation | accepted_trait_implementation_authority = Some(authority) },
	)


private pure func module_view_graph_source_name_index(
	representation: ModuleViewRep,
	local_name: String,
) -> Option[Int]:
	visibility ?= representation.graph_visibility
	table = graph_source_name_table_source_names(
		graph_module_name_scope_graph_names(visibility.issuer),
	)
	name_id ?= source_name_table_find_id(table, local_name)
	Some(source_name_id_table_index(name_id))


private pure func module_view_graph_occupancy(
	representation: ModuleViewRep,
	source_name_index: Int,
) -> Option[BoundNameOccupancy]:
	visibility ?= representation.graph_visibility
	visibility.rows_by_source_name_index.get(source_name_index)


private pure func bound_name_module_alias(occupancy: BoundNameOccupancy) -> Option[ModuleId]:
	match occupancy:
		BoundModuleAlias(_, module_id) | BoundAliasAndSelectiveName(_, module_id, _, _, _) | BoundAliasAndConstructorName(_, module_id, _, _, _, _, _):
			Some(module_id)
		_:
			None


private pure func bound_name_alias_row_id(
	occupancy: BoundNameOccupancy,
) -> Option[BoundCandidateRowId]:
	match occupancy:
		BoundModuleAlias(row_id, _) | BoundAliasAndSelectiveName(row_id, _, _, _, _) | BoundAliasAndConstructorName(row_id, _, _, _, _, _, _):
			Some(row_id)
		_:
			None


private pure func bound_name_selective_row_id(
	occupancy: BoundNameOccupancy,
) -> Option[BoundCandidateRowId]:
	match occupancy:
		BoundSelectiveName(row_id, _, _) | BoundConstructorName(row_id, _, _, _, _) | BoundAliasAndSelectiveName(_, _, row_id, _, _) | BoundAliasAndConstructorName(_, _, row_id, _, _, _, _):
			Some(row_id)
		_:
			None


private pure func bound_name_local_row_id(
	occupancy: BoundNameOccupancy,
) -> Option[BoundCandidateRowId]:
	match occupancy:
		BoundLocalName(row_id, _):
			Some(row_id)
		_:
			None


private pure func bound_imported_name_from_payload(
	visibility: BoundVisibility,
	local_source_name_index: Int,
	payload: BoundImportedNamePayload,
) -> Option[ImportedNameBinding]:
	graph_names = graph_module_name_scope_graph_names(visibility.issuer)
	name_table = graph_source_name_table_source_names(graph_names)
	module_table = graph_source_name_table_module_table(graph_names)
	local_id ?= source_name_table_id_at(name_table, local_source_name_index)
	original_id ?= source_name_table_id_at(name_table, payload.original_source_name_index)
	local_name ?= source_name_table_spelling(name_table, local_id)
	original_name ?= source_name_table_spelling(name_table, original_id)
	module_path ?= module_table_canonical_path(module_table, payload.module_id)
	Some({
		local_name = local_name,
		module_path = module_path,
		original_name = original_name,
	})


private pure func bound_name_imported_payload(
	occupancy: BoundNameOccupancy,
) -> Option[BoundImportedNamePayload]:
	match occupancy:
		BoundSelectiveName(_, module_id, original_index) | BoundConstructorName(_, module_id, original_index, _, _):
			Some({
				module_id = module_id,
				original_source_name_index = original_index,
			})
		BoundAliasAndSelectiveName(_, _, _, module_id, original_index) | BoundAliasAndConstructorName(_, _, _, module_id, original_index, _, _):
			Some({
				module_id = module_id,
				original_source_name_index = original_index,
			})
		_:
			None


private pure func bound_name_local_kind(occupancy: BoundNameOccupancy) -> Option[TopLevelNameKind]:
	match occupancy:
		BoundLocalName(_, kind):
			Some(kind)
		_:
			None


private pure func module_view_graph_imported_name_at(
	representation: ModuleViewRep,
	source_name_index: Int,
) -> Option[ImportedNameBinding]:
	visibility ?= representation.graph_visibility
	occupancy ?= module_view_graph_occupancy(representation, source_name_index)
	payload ?= bound_name_imported_payload(occupancy)
	bound_imported_name_from_payload(visibility, source_name_index, payload)


private pure func graph_import_admission_imported_name(
	build: GraphImportAdmissionRep,
	source_name_index: Int,
	payload: BoundImportedNamePayload,
) -> Option[ImportedNameBinding]:
	visibility ?= module_view_rep(build.initial_view).graph_visibility
	bound_imported_name_from_payload(visibility, source_name_index, payload)


private pure func module_view_graph_local_kind_at(
	representation: ModuleViewRep,
	source_name_index: Int,
) -> Option[TopLevelNameKind]:
	occupancy ?= module_view_graph_occupancy(representation, source_name_index)
	bound_name_local_kind(occupancy)


private pure func module_view_graph_module_alias_at(
	representation: ModuleViewRep,
	source_name_index: Int,
) -> Option[ModuleId]:
	occupancy ?= module_view_graph_occupancy(representation, source_name_index)
	bound_name_module_alias(occupancy)


pure func module_view_find_graph_module_alias(
	view: ModuleView,
	local_name: String,
) -> Option[ModuleId]:
	representation = module_view_rep(view)
	name_index ?= module_view_graph_source_name_index(representation, local_name)
	occupancy ?= module_view_graph_occupancy(representation, name_index)
	bound_name_module_alias(occupancy)


-- This compatibility projection is for standalone source-oriented consumers.
-- Graph callers obtain the issuing ModuleTable from their scope or graph owner
-- and project a target only at an explicit diagnostic or serialization boundary.
pure func module_view_find_standalone_module_alias(
	view: ModuleView,
	local_name: String,
) -> Option[String]:
	module_view_rep(view).standalone_module_aliases_by_local_name.get(local_name)


private pure func module_view_graph_target_matches_path(
	module_table: Option[ModuleTable],
	module_id: ModuleId,
	module_path: String,
) -> Bool:
	match module_table:
		Some(table):
			module_table_canonical_path(table, module_id) == Some(module_path)
		None:
			False


private pure func module_view_graph_alias_label(
	module_table: Option[ModuleTable],
	module_id: ModuleId,
) -> String:
	match module_table:
		Some(table):
			module_table_canonical_path(table, module_id).get_or(MODULE_IMPORT_TARGET_INVALID_LABEL)
		None:
			MODULE_IMPORT_TARGET_INVALID_LABEL


private pure func module_view_rep_find_imported_name(
	representation: ModuleViewRep,
	local_name: String,
) -> Option[ImportedNameBinding]:
	match representation.graph_visibility:
		Some(visibility):
			name_index ?= module_view_graph_source_name_index(representation, local_name)
			occupancy ?= module_view_graph_occupancy(representation, name_index)
			payload ?= bound_name_imported_payload(occupancy)
			bound_imported_name_from_payload(visibility, name_index, payload)
		None:
			representation.standalone_imported_names_by_local_name.get(local_name)


pure func module_view_find_imported_name(
	view: ModuleView,
	local_name: String,
) -> Option[ImportedNameBinding]:
	module_view_rep_find_imported_name(module_view_rep(view), local_name)


private pure func module_view_rep_find_local_name(
	representation: ModuleViewRep,
	local_name: String,
) -> Option[TopLevelNameKind]:
	match representation.graph_visibility:
		Some(_):
			name_index ?= module_view_graph_source_name_index(representation, local_name)
			occupancy ?= module_view_graph_occupancy(representation, name_index)
			bound_name_local_kind(occupancy)
		None:
			representation.standalone_local_names_by_local_name.get(local_name)


pure func module_view_find_local_name(
	view: ModuleView,
	local_name: String,
) -> Option[TopLevelNameKind]:
	module_view_rep_find_local_name(module_view_rep(view), local_name)


pure func module_view_has_selective_binding(
	view: ModuleView,
	local_name: String,
	module_path: String,
	source_name: String,
) -> Bool:
	match module_view_find_imported_name(view, local_name):
		Some(binding):
			binding.module_path == module_path and binding.original_name == source_name
		None:
			False


private pure func module_view_register_standalone_module_alias_unchecked(
	view: ModuleView,
	local_name: String,
	module_path: String,
) -> ModuleAliasRegistration:
	representation = module_view_rep(view)

	match representation.standalone_module_aliases_by_local_name.get(local_name):
		Some(existing_module_path):
			if existing_module_path == module_path:
				ModuleAliasAlreadyPresent
			else:
				ModuleAliasConflictsWithAlias(existing_module_path)
		None:
			match representation.standalone_imported_names_by_local_name.get(local_name):
				Some(existing_binding):
					if existing_binding.module_path != module_path:
						ModuleAliasConflictsWithImportedName(existing_binding)
					else:
						module_view_add_standalone_module_alias(
							representation,
							local_name,
							module_path,
						)
				None:
					match module_view_rep_find_local_name(representation, local_name):
						Some(existing_kind):
							ModuleAliasConflictsWithLocalName(existing_kind)
						None:
							module_view_add_standalone_module_alias(
								representation,
								local_name,
								module_path,
							)


pure func module_view_register_standalone_module_alias(
	view: ModuleView,
	local_name: String,
	module_path: String,
) -> ModuleAliasRegistration:
	representation = module_view_rep(view)

	if representation.graph_visibility.is_some():
		ModuleAliasInvalidTarget
	else:
		match representation.import_binding_domain:
			GraphImportBindings:
				ModuleAliasInvalidTarget
			_:
				module_view_register_standalone_module_alias_unchecked(
					view,
					local_name,
					module_path,
				)


private pure func module_view_add_standalone_module_alias(
	representation: ModuleViewRep,
	local_name: String,
	module_path: String,
) -> ModuleAliasRegistration:
	ModuleAliasAdded(module_view_from_rep({ representation |
				import_binding_domain = StandaloneImportBindings,
				standalone_module_aliases_by_local_name = representation.standalone_module_aliases_by_local_name.set(
					local_name,
					module_path,
				),
				standalone_import_bindings = representation.standalone_import_bindings.append(
					StandaloneQualifiedModuleBinding(
						local_name,
						module_path,
					),
				)
			}))


pure func module_view_register_module_alias_target(
	view: ModuleView,
	current_table: ModuleTable,
	current_module_id: ModuleId,
	local_name: String,
	expected_module_path: String,
	issuing_table: ModuleTable,
	module_id: ModuleId,
) -> ModuleAliasRegistration:
	match graph_import_admission_begin(view, current_table, current_module_id):
		None:
			ModuleAliasInvalidTarget
		Some(admission):
			match graph_import_admission_register_alias(
				admission,
				current_table,
				current_module_id,
				local_name,
				expected_module_path,
				issuing_table,
				module_id,
			):
				GraphModuleAliasAdded(next):
					ModuleAliasAdded(graph_import_admission_finish(next))
				GraphModuleAliasAlreadyPresent(_):
					ModuleAliasAlreadyPresent
				GraphModuleAliasConflictsWithAlias(_, existing):
					ModuleAliasConflictsWithAlias(existing)
				GraphModuleAliasConflictsWithImportedName(_, existing):
					ModuleAliasConflictsWithImportedName(existing)
				GraphModuleAliasConflictsWithLocalName(_, existing):
					ModuleAliasConflictsWithLocalName(existing)
				GraphModuleAliasInvalidTarget(_):
					ModuleAliasInvalidTarget


pure func graph_import_admission_register_alias(
	admission: GraphImportAdmission,
	current_table: ModuleTable,
	current_module_id: ModuleId,
	local_name: String,
	expected_module_path: String,
	issuing_table: ModuleTable,
	module_id: ModuleId,
) -> GraphModuleAliasAdmission:
	build = graph_import_admission_rep(admission)
	representation = module_view_rep(build.initial_view)
	name_index = module_view_graph_source_name_index(representation, local_name)
	request = bound_qualified_import_request(name_index, local_name, module_id)

	if (
		not module_view_graph_has_owner(build.initial_view, current_table, current_module_id)
		or not module_tables_are_compatible(current_table, issuing_table)
		or module_table_canonical_path(issuing_table, module_id) != Some(expected_module_path)
	):
		GraphModuleAliasInvalidTarget(
			graph_import_admission_append_import(
				build,
				request,
				BoundInvalidTargetOutcome,
				None,
			),
		)
	else:
		match name_index:
			None:
				GraphModuleAliasInvalidTarget(
					graph_import_admission_append_import(
						build,
						request,
						BoundInvalidSourceOutcome,
						None,
					),
				)
			Some(source_name_index):
				match build.rows_by_source_name_index.get(source_name_index):
					Some(BoundModuleAlias(existing_row_id, existing_id)) | Some(BoundAliasAndSelectiveName(existing_row_id, existing_id, _, _, _)) | Some(BoundAliasAndConstructorName(existing_row_id, existing_id, _, _, _, _, _)):
						if module_ids_equal(existing_id, module_id):
							GraphModuleAliasAlreadyPresent(
								graph_import_admission_append_import(
									build,
									request,
									BoundAlreadyPresentOutcome,
									Some(existing_row_id),
								),
							)
						else:
							GraphModuleAliasConflictsWithAlias(
								graph_import_admission_append_import(
									build,
									request,
									BoundAliasConflictOutcome,
									Some(existing_row_id),
								),
								module_view_graph_alias_label(Some(current_table), existing_id),
							)
					Some(BoundSelectiveName(existing_row_id, imported_module_id, original_index)):
						binding: BoundImportedNamePayload = {
							module_id = imported_module_id,
							original_source_name_index = original_index
						}

						if not module_ids_equal(imported_module_id, module_id):
							match graph_import_admission_imported_name(
								build,
								source_name_index,
								binding,
							):
								Some(existing_name):
									GraphModuleAliasConflictsWithImportedName(
										graph_import_admission_append_import(
											build,
											request,
											BoundSelectiveConflictOutcome,
											Some(existing_row_id),
										),
										existing_name,
									)
								None:
									GraphModuleAliasInvalidTarget(
										graph_import_admission_append_import(
											build,
											request,
											BoundInvalidSourceOutcome,
											None,
										),
									)
						else:
							graph_import_admission_add_alias(
								build,
								source_name_index,
								request,
								module_id,
								Some(
									BoundSelectiveName(
										existing_row_id,
										imported_module_id,
										original_index,
									),
								),
							)
					Some(BoundConstructorName(existing_row_id, imported_module_id, original_index, parent_local_index, parent_index)):
						binding: BoundImportedNamePayload = {
							module_id = imported_module_id,
							original_source_name_index = original_index
						}

						if not module_ids_equal(imported_module_id, module_id):
							match graph_import_admission_imported_name(
								build,
								source_name_index,
								binding,
							):
								Some(existing_name):
									GraphModuleAliasConflictsWithImportedName(
										graph_import_admission_append_import(
											build,
											request,
											BoundSelectiveConflictOutcome,
											Some(existing_row_id),
										),
										existing_name,
									)
								None:
									GraphModuleAliasInvalidTarget(
										graph_import_admission_append_import(
											build,
											request,
											BoundInvalidSourceOutcome,
											None,
										),
									)
						else:
							graph_import_admission_add_alias(
								build,
								source_name_index,
								request,
								module_id,
								Some(
									BoundConstructorName(
										existing_row_id,
										imported_module_id,
										original_index,
										parent_local_index,
										parent_index,
									),
								),
							)
					Some(BoundLocalName(existing_row_id, kind)):
						GraphModuleAliasConflictsWithLocalName(
							graph_import_admission_append_import(
								build,
								request,
								BoundLocalConflictOutcome,
								Some(existing_row_id),
							),
							kind,
						)
					None:
						graph_import_admission_add_alias(
							build,
							source_name_index,
							request,
							module_id,
							None,
						)


private pure func graph_import_admission_add_alias(
	build: GraphImportAdmissionRep,
	source_name_index: Int,
	request: BoundImportRequest,
	module_id: ModuleId,
	existing: Option[BoundNameOccupancy],
) -> GraphModuleAliasAdmission:
	alias_row_id = bound_candidate_row_id(build.candidate_count)

	occupancy = match existing:
		Some(BoundSelectiveName(selective_row_id, imported_module_id, original_index)):
			BoundAliasAndSelectiveName(
				alias_row_id,
				module_id,
				selective_row_id,
				imported_module_id,
				original_index,
			)
		Some(BoundConstructorName(selective_row_id, imported_module_id, original_index, parent_local_index, parent_index)):
			BoundAliasAndConstructorName(
				alias_row_id,
				module_id,
				selective_row_id,
				imported_module_id,
				original_index,
				parent_local_index,
				parent_index,
			)
		None:
			BoundModuleAlias(alias_row_id, module_id)
		_:
			BoundModuleAlias(alias_row_id, module_id)

	indexed = { build |
		rows_by_source_name_index = build.rows_by_source_name_index.set(
			source_name_index,
			occupancy,
		)
	}
	appended = graph_import_admission_rep_append_import(
		indexed,
		request,
		BoundAcceptedOutcome,
		None,
	)

	GraphModuleAliasAdded(
		graph_import_admission_from_rep(appended),
	)


private pure func module_view_finish_add_selective_name(
	representation: ModuleViewRep,
	binding: ImportedNameBinding,
	import_binding: ImportBinding,
	domain: ImportBindingDomain,
) -> SelectiveNameRegistration:
	next = { representation |
		import_binding_domain = domain,
		standalone_import_bindings = representation.standalone_import_bindings.append(
			import_binding,
		)
	}

	finished = match domain:
		StandaloneImportBindings:
			{ next | imported_names = next.imported_names.append(binding) }
		GraphImportBindings | NoImportBindings:
			next

	SelectiveNameAdded(module_view_from_rep(finished))


private pure func module_view_add_standalone_selective_name(
	representation: ModuleViewRep,
	local_name: String,
	module_path: String,
	source_name: String,
	import_binding: ImportBinding,
) -> SelectiveNameRegistration:
	binding: ImportedNameBinding = {
		local_name = local_name,
		module_path = module_path,
		original_name = source_name
	}
	next = { representation |
		standalone_imported_names_by_local_name = representation.standalone_imported_names_by_local_name.set(
			local_name,
			binding,
		)
	}
	module_view_finish_add_selective_name(next, binding, import_binding, StandaloneImportBindings)


private pure func module_view_register_standalone_selective_name(
	representation: ModuleViewRep,
	local_name: String,
	module_path: String,
	source_name: String,
	import_binding: ImportBinding,
) -> SelectiveNameRegistration:
	match representation.standalone_imported_names_by_local_name.get(local_name):
		Some(existing_binding):
			SelectiveNameConflictsWithImportedName(existing_binding)
		None:
			match representation.standalone_module_aliases_by_local_name.get(local_name):
				Some(existing_module_path):
					if existing_module_path == module_path:
						module_view_add_standalone_selective_name(
							representation,
							local_name,
							module_path,
							source_name,
							import_binding,
						)
					else:
						SelectiveNameConflictsWithAlias(existing_module_path)
				None:
					match representation.standalone_local_names_by_local_name.get(local_name):
						Some(existing_kind):
							SelectiveNameConflictsWithLocalName(existing_kind)
						None:
							module_view_add_standalone_selective_name(
								representation,
								local_name,
								module_path,
								source_name,
								import_binding,
							)


private pure func graph_selective_admission_to_registration(
	admission: GraphSelectiveAdmission,
) -> SelectiveNameRegistration:
	match admission:
		GraphSelectiveAdded(next):
			SelectiveNameAdded(graph_import_admission_finish(next))
		GraphSelectiveConflictsWithAlias(_, existing):
			SelectiveNameConflictsWithAlias(existing)
		GraphSelectiveConflictsWithImportedName(_, existing):
			SelectiveNameConflictsWithImportedName(existing)
		GraphSelectiveConflictsWithLocalName(_, existing):
			SelectiveNameConflictsWithLocalName(existing)
		GraphSelectiveInvalidSourceName(_):
			SelectiveNameInvalidSourceName
		GraphSelectiveInvalidTarget(_):
			SelectiveNameInvalidTarget


pure func module_view_register_selective_name_for_graph(
	view: ModuleView,
	current_module_id: ModuleId,
	active_definition_table: DefinitionTable,
	issuing_definition_table: DefinitionTable,
	local_name: String,
	module_path: String,
	source_name: String,
	module_id: ModuleId,
	definition_ids: List[DefinitionId],
) -> SelectiveNameRegistration:
	match graph_import_admission_begin(
		view,
		definition_table_module_table(active_definition_table),
		current_module_id,
	):
		None:
			SelectiveNameInvalidTarget
		Some(admission):
			graph_selective_admission_to_registration(
				graph_import_admission_register_selective_definition(
					admission,
					current_module_id,
					active_definition_table,
					issuing_definition_table,
					local_name,
					module_path,
					source_name,
					module_id,
					definition_ids,
				),
			)


-- TraitMethodId is issued after this binding boundary. Preserve the public
-- method row explicitly without pretending its source spelling is a generic
-- DefinitionId. Exact overlapping definition targets remain attached for the
-- callable/global authorities that own those identity domains.
pure func module_view_register_graph_selective_trait_method(
	view: ModuleView,
	current_module_id: ModuleId,
	active_definition_table: DefinitionTable,
	issuing_definition_table: DefinitionTable,
	local_name: String,
	module_path: String,
	source_name: String,
	module_id: ModuleId,
	definition_ids: List[DefinitionId],
) -> SelectiveNameRegistration:
	match graph_import_admission_begin(
		view,
		definition_table_module_table(active_definition_table),
		current_module_id,
	):
		None:
			SelectiveNameInvalidTarget
		Some(admission):
			graph_selective_admission_to_registration(
				graph_import_admission_register_selective_trait_method(
					admission,
					current_module_id,
					active_definition_table,
					issuing_definition_table,
					local_name,
					module_path,
					source_name,
					module_id,
					definition_ids,
				),
			)


pure func graph_import_admission_register_selective_definition(
	admission: GraphImportAdmission,
	current_module_id: ModuleId,
	active_definition_table: DefinitionTable,
	issuing_definition_table: DefinitionTable,
	local_name: String,
	module_path: String,
	source_name: String,
	module_id: ModuleId,
	definition_ids: List[DefinitionId],
) -> GraphSelectiveAdmission:
	graph_import_admission_register_selective(
		admission,
		current_module_id,
		active_definition_table,
		issuing_definition_table,
		local_name,
		module_path,
		source_name,
		module_id,
		definition_ids,
		DefinitionGraphSelectiveBinding,
		None,
	)


-- Register a validated constructor selection in one occupancy write. The
-- caller has already checked the parent/constructor export pair against the
-- active definition index; the shared admission boundary checks provenance,
-- source spelling, and conflicts before publishing the row.
pure func graph_import_admission_register_constructor(
	admission: GraphImportAdmission,
	current_module_id: ModuleId,
	active_definition_table: DefinitionTable,
	issuing_definition_table: DefinitionTable,
	binding: ImportedConstructorBinding,
	module_id: ModuleId,
	definition_ids: List[DefinitionId],
) -> GraphSelectiveAdmission:
	graph_import_admission_register_selective(
		admission,
		current_module_id,
		active_definition_table,
		issuing_definition_table,
		binding.local_name,
		binding.module_path,
		binding.original_name,
		module_id,
		definition_ids,
		DefinitionGraphSelectiveBinding,
		Some((binding.parent_local_name, binding.parent_name)),
	)


pure func graph_import_admission_register_selective_trait_method(
	admission: GraphImportAdmission,
	current_module_id: ModuleId,
	active_definition_table: DefinitionTable,
	issuing_definition_table: DefinitionTable,
	local_name: String,
	module_path: String,
	source_name: String,
	module_id: ModuleId,
	definition_ids: List[DefinitionId],
) -> GraphSelectiveAdmission:
	graph_import_admission_register_selective(
		admission,
		current_module_id,
		active_definition_table,
		issuing_definition_table,
		local_name,
		module_path,
		source_name,
		module_id,
		definition_ids,
		TraitMethodGraphSelectiveBinding,
		None,
	)


-- Ordinary definition/trait wrappers pass no parent; only the constructor
-- wrapper passes parent names after TypecheckState validates the export IDs.
-- Reject a trait-method/parent pair here so a future caller cannot create a
-- constructor occupancy invisible to the definition-binding projection.
private pure func graph_import_admission_register_selective(
	admission: GraphImportAdmission,
	current_module_id: ModuleId,
	active_definition_table: DefinitionTable,
	issuing_definition_table: DefinitionTable,
	local_name: String,
	module_path: String,
	source_name: String,
	module_id: ModuleId,
	definition_ids: List[DefinitionId],
	binding_kind: GraphSelectiveBindingKind,
	constructor_parent: Option[(String, String)],
) -> GraphSelectiveAdmission:
	build = graph_import_admission_rep(admission)
	representation = module_view_rep(build.initial_view)
	source_name_index = module_view_graph_source_name_index(representation, local_name)
	original_name_index = module_view_graph_source_name_index(representation, source_name)
	module_table = definition_table_module_table(issuing_definition_table)

	target_is_valid = match binding_kind:
		DefinitionGraphSelectiveBinding:
			definition_table_selective_definition_name(
				issuing_definition_table,
				module_id,
				definition_ids,
			) == Some(source_name)
		TraitMethodGraphSelectiveBinding:
			(
				constructor_parent.is_none()
				and ((
					definition_ids.is_empty()
					or definition_table_selective_definition_name(
						issuing_definition_table,
						module_id,
						definition_ids,
					) == Some(source_name)
				))
			)

	-- Validate against the issuing table before publishing the retained
	-- request, so later code can rely on its semantic IDs without reopening
	-- source-facing target resolution.
	uncataloged_local_name = if source_name_index.is_none():
		Some(local_name)
	else:
		None

	request = match binding_kind:
		DefinitionGraphSelectiveBinding:
			BoundSelectiveDefinitionRequest(
				source_name_index.get_or(BOUND_CANDIDATE_NO_SOURCE_NAME),
				module_id,
				definition_ids,
				uncataloged_local_name,
			)
		TraitMethodGraphSelectiveBinding:
			uncataloged_source_name = if original_name_index.is_none():
				Some(source_name)
			else:
				None

			BoundSelectiveTraitMethodRequest(
				source_name_index.get_or(BOUND_CANDIDATE_NO_SOURCE_NAME),
				module_id,
				original_name_index.get_or(BOUND_CANDIDATE_NO_SOURCE_NAME),
				definition_ids,
				uncataloged_local_name,
				uncataloged_source_name,
			)

	match source_name_index:
		None:
			GraphSelectiveInvalidSourceName(
				graph_import_admission_append_import(
					build,
					request,
					BoundInvalidSourceOutcome,
					None,
				),
			)
		Some(name_index):
			if (
				not module_view_graph_has_owner(
					build.initial_view,
					definition_table_module_table(active_definition_table),
					current_module_id,
				)
				or not definition_tables_share_provenance(
					active_definition_table,
					issuing_definition_table,
				)
				or module_table_canonical_path(module_table, module_id) != Some(module_path)
				or not target_is_valid
				or original_name_index.is_none()
				or constructor_parent
					.map(func(parent):
						(
							module_view_graph_source_name_index(representation, parent[0]).is_none()
							or module_view_graph_source_name_index(
								representation,
								parent[1],
							).is_none()
						)
					)
					.get_or(False)
			):
				GraphSelectiveInvalidTarget(
					graph_import_admission_append_import(
						build,
						request,
						BoundInvalidTargetOutcome,
						None,
					),
				)
			else:
				match build.rows_by_source_name_index.get(name_index):
					Some(BoundSelectiveName(existing_row_id, existing_module_id, original_index)) | Some(BoundAliasAndSelectiveName(_, _, existing_row_id, existing_module_id, original_index)):
						existing: BoundImportedNamePayload = {
							module_id = existing_module_id,
							original_source_name_index = original_index
						}

						match graph_import_admission_imported_name(build, name_index, existing):
							Some(existing_name):
								GraphSelectiveConflictsWithImportedName(
									graph_import_admission_append_import(
										build,
										request,
										BoundSelectiveConflictOutcome,
										Some(existing_row_id),
									),
									existing_name,
								)
							None:
								GraphSelectiveInvalidSourceName(
									graph_import_admission_append_import(
										build,
										request,
										BoundInvalidSourceOutcome,
										None,
									),
								)
					Some(BoundConstructorName(existing_row_id, existing_module_id, original_index, _, _)) | Some(BoundAliasAndConstructorName(_, _, existing_row_id, existing_module_id, original_index, _, _)):
						existing: BoundImportedNamePayload = {
							module_id = existing_module_id,
							original_source_name_index = original_index
						}

						match graph_import_admission_imported_name(build, name_index, existing):
							Some(existing_name):
								GraphSelectiveConflictsWithImportedName(
									graph_import_admission_append_import(
										build,
										request,
										BoundSelectiveConflictOutcome,
										Some(existing_row_id),
									),
									existing_name,
								)
							None:
								GraphSelectiveInvalidSourceName(
									graph_import_admission_append_import(
										build,
										request,
										BoundInvalidSourceOutcome,
										None,
									),
								)
					Some(BoundModuleAlias(alias_row_id, existing_id)):
						if module_table_canonical_path(
							module_table,
							existing_id,
						) == Some(module_path):
							graph_import_admission_add_selective(
								build,
								name_index,
								source_name,
								module_id,
								request,
								constructor_parent,
								Some((alias_row_id, existing_id)),
							)
						else:
							GraphSelectiveConflictsWithAlias(
								graph_import_admission_append_import(
									build,
									request,
									BoundAliasConflictOutcome,
									Some(alias_row_id),
								),
								module_view_graph_alias_label(Some(module_table), existing_id),
							)
					Some(BoundLocalName(local_row_id, kind)):
						GraphSelectiveConflictsWithLocalName(
							graph_import_admission_append_import(
								build,
								request,
								BoundLocalConflictOutcome,
								Some(local_row_id),
							),
							kind,
						)
					None:
						graph_import_admission_add_selective(
							build,
							name_index,
							source_name,
							module_id,
							request,
							constructor_parent,
							None,
						)


private pure func graph_import_admission_add_selective(
	build: GraphImportAdmissionRep,
	source_name_index: Int,
	source_name: String,
	module_id: ModuleId,
	request: BoundImportRequest,
	constructor_parent: Option[(String, String)],
	existing_alias: Option[(BoundCandidateRowId, ModuleId)],
) -> GraphSelectiveAdmission:
	selective_row_id = bound_candidate_row_id(build.candidate_count)
	representation = module_view_rep(build.initial_view)
	original_source_name_index = module_view_graph_source_name_index(
		representation,
		source_name,
	).get_or(BOUND_CANDIDATE_NO_SOURCE_NAME)

	occupancy = match existing_alias:
		Some((alias_row_id, alias_module_id)):
			match constructor_parent:
				Some(parent):
					BoundAliasAndConstructorName(
						alias_row_id,
						alias_module_id,
						selective_row_id,
						module_id,
						original_source_name_index,
						module_view_graph_source_name_index(
							representation,
							parent[0],
						).get_or(BOUND_CANDIDATE_NO_SOURCE_NAME),
						module_view_graph_source_name_index(
							representation,
							parent[1],
						).get_or(BOUND_CANDIDATE_NO_SOURCE_NAME),
					)
				None:
					BoundAliasAndSelectiveName(
						alias_row_id,
						alias_module_id,
						selective_row_id,
						module_id,
						original_source_name_index,
					)
		None:
			match constructor_parent:
				Some(parent):
					BoundConstructorName(
						selective_row_id,
						module_id,
						original_source_name_index,
						module_view_graph_source_name_index(
							representation,
							parent[0],
						).get_or(BOUND_CANDIDATE_NO_SOURCE_NAME),
						module_view_graph_source_name_index(
							representation,
							parent[1],
						).get_or(BOUND_CANDIDATE_NO_SOURCE_NAME),
					)
				None:
					BoundSelectiveName(selective_row_id, module_id, original_source_name_index)

	indexed = { build |
		rows_by_source_name_index = build.rows_by_source_name_index.set(
			source_name_index,
			occupancy,
		)
	}
	appended = graph_import_admission_rep_append_import(
		indexed,
		request,
		BoundAcceptedOutcome,
		None,
	)

	GraphSelectiveAdded(
		graph_import_admission_from_rep(appended),
	)


pure func module_view_register_selective_name(
	view: ModuleView,
	local_name: String,
	module_path: String,
	source_name: String,
) -> SelectiveNameRegistration:
	if (
		module_view_rep(view).graph_visibility.is_some()
		or module_view_has_graph_import_bindings(view)
	):
		SelectiveNameInvalidTarget
	else:
		module_view_register_standalone_selective_name(
			module_view_rep(view),
			local_name,
			module_path,
			source_name,
			StandaloneSelectiveDefinitionBinding(local_name, module_path, source_name),
		)


private pure func module_view_add_local_name(
	representation: ModuleViewRep,
	local_name: String,
	kind: TopLevelNameKind,
	storage: LocalNameStorage,
) -> LocalNameRegistration:
	next = match storage:
		GraphLocalNameStorage(source_name_index):
			match representation.graph_visibility:
				Some(visibility):
					table = bound_visibility_candidate_table(visibility)
					row_id = bound_candidate_row_id(table.candidate_count)
					candidates = bound_candidate_table_append_local(
						table,
						source_name_index,
						kind,
						BoundAcceptedOutcome,
						None,
					)
					next_visibility = bound_visibility_with_candidate_table(
						{ visibility |
							rows_by_source_name_index = visibility.rows_by_source_name_index.set(
								source_name_index,
								BoundLocalName(row_id, kind),
							)
						},
						candidates,
					)
					{ representation | graph_visibility = Some(next_visibility) }
				None:
					representation
		StandaloneLocalNameStorage:
			{ representation |
				standalone_local_names_by_local_name = representation.standalone_local_names_by_local_name.set(
					local_name,
					kind,
				)
			}

	LocalNameAdded(module_view_from_rep(next))


private pure func module_view_add_local_name_without_alias_conflict(
	representation: ModuleViewRep,
	local_name: String,
	kind: TopLevelNameKind,
	storage: LocalNameStorage,
) -> LocalNameRegistration:
	existing_import = match storage:
		GraphLocalNameStorage(source_name_index):
			module_view_graph_imported_name_at(representation, source_name_index)
		StandaloneLocalNameStorage:
			representation.standalone_imported_names_by_local_name.get(local_name)

	match existing_import:
		Some(existing_binding):
			LocalNameConflictsWithImportedName(existing_binding)
		None:
			module_view_add_local_name(representation, local_name, kind, storage)


private pure func module_view_register_local_name_with_storage(
	view: ModuleView,
	module_table: Option[ModuleTable],
	local_name: String,
	kind: TopLevelNameKind,
	storage: LocalNameStorage,
) -> LocalNameRegistration:
	representation = module_view_rep(view)

	existing_local_name = match storage:
		GraphLocalNameStorage(source_name_index):
			module_view_graph_local_kind_at(representation, source_name_index)
		StandaloneLocalNameStorage:
			representation.standalone_local_names_by_local_name.get(local_name)

	match existing_local_name:
		Some(existing_kind):
			LocalNameAlreadyPresent(existing_kind)
		None:
			match storage:
				GraphLocalNameStorage(source_name_index):
					match module_view_graph_module_alias_at(representation, source_name_index):
						Some(existing_module_id):
							LocalNameConflictsWithAlias(
								module_view_graph_alias_label(
									module_table,
									existing_module_id,
								),
							)
						None:
							module_view_add_local_name_without_alias_conflict(
								representation,
								local_name,
								kind,
								storage,
							)
				StandaloneLocalNameStorage:
					match representation.standalone_module_aliases_by_local_name.get(local_name):
						Some(existing_module_path):
							LocalNameConflictsWithAlias(existing_module_path)
						None:
							module_view_add_local_name_without_alias_conflict(
								representation,
								local_name,
								kind,
								storage,
							)


pure func module_view_register_local_name_for_graph(
	view: ModuleView,
	module_table: ModuleTable,
	current_module_id: ModuleId,
	local_name: String,
	kind: TopLevelNameKind,
) -> LocalNameRegistration:
	representation = module_view_rep(view)

	if not module_view_graph_has_owner(view, module_table, current_module_id):
		LocalNameInvalidSourceName
	else:
		match module_view_graph_source_name_index(representation, local_name):
			Some(source_name_index):
				module_view_register_local_name_with_storage(
					view,
					Some(module_table),
					local_name,
					kind,
					GraphLocalNameStorage(source_name_index),
				)
			None:
				LocalNameInvalidSourceName


pure func module_view_register_local_name(
	view: ModuleView,
	local_name: String,
	kind: TopLevelNameKind,
) -> LocalNameRegistration:
	if module_view_rep(view).graph_visibility.is_some():
		LocalNameInvalidSourceName
	else:
		module_view_register_local_name_with_storage(
			view,
			None,
			local_name,
			kind,
			StandaloneLocalNameStorage,
		)


private pure func bound_visibility_without_unqualified_names(
	visibility: BoundVisibility,
) -> BoundVisibility:
	var retained_rows: Dict[Int, BoundNameOccupancy] = {}
	var retained_row_ids: List[BoundCandidateRowId] = []
	var retained_imports: List[BoundImportRequest] = []

	for index in 0..visibility.candidate_accepted_imports.length():
		match (
			visibility.candidate_accepted_import_row_ids.get(index),
			visibility.candidate_accepted_imports.get(index),
		):
			(Some(row_id), Some(request)):
				match request:
					BoundQualifiedImportRequest(source_name_index, module_id, _):
						retained_row_ids = retained_row_ids.append(row_id)
						retained_imports = retained_imports.append(request)
						retained_rows = retained_rows.set(
							source_name_index,
							BoundModuleAlias(row_id, module_id),
						)
					_:
						void
			_:
				void

	retained_candidates: BoundCandidateTable = {
		rejected_local_rows = [],
		accepted_import_row_ids = retained_row_ids,
		accepted_imports = retained_imports,
		rejected_rows = [],
		rejected_imports = [],
		candidate_count = visibility.candidate_count
	}

	bound_visibility_with_candidate_table(
		{ visibility | rows_by_source_name_index = retained_rows },
		retained_candidates,
	)


pure func module_view_without_unqualified_names(view: ModuleView) -> ModuleView:
	representation = module_view_rep(view)

	qualified_bindings = if representation.graph_visibility.is_some():
		representation.standalone_import_bindings
	else:
		representation.standalone_import_bindings.filter(func(binding):
			match binding:
				GraphQualifiedModuleBinding(_, _) | StandaloneQualifiedModuleBinding(_, _):
					True
				GraphSelectiveDefinitionBinding(_, _, _) | GraphSelectiveTraitMethodBinding(_, _, _, _) | StandaloneSelectiveDefinitionBinding(_, _, _):
					False
		)

	module_view_from_rep({ representation |
			imported_names = [],
			graph_visibility = representation.graph_visibility.map(
				bound_visibility_without_unqualified_names,
			),
			standalone_imported_names_by_local_name = {},
			imported_constructors = [],
			standalone_import_bindings = qualified_bindings,
			standalone_local_names_by_local_name = {},
			accepted_alias_authority = representation.accepted_alias_authority.map(
				accepted_alias_authority_without_visible_names,
			),
			accepted_record_authority = representation.accepted_record_authority.map(
				accepted_record_authority_without_visible_names,
			),
			accepted_union_authority = representation.accepted_union_authority.map(
				accepted_union_authority_without_visible_names,
			),
			accepted_global_authority = representation.accepted_global_authority.map(
				accepted_global_authority_without_visible_names,
			),
			accepted_callable_authority = representation.accepted_callable_authority.map(
				accepted_callable_authority_without_visible_names,
			),
			accepted_trait_implementation_authority = representation.accepted_trait_implementation_authority.map(
				accepted_trait_implementation_authority_without_visible_names,
			)
		})
