-- Pure import registration substrate for the Blorp-owned typecheck pass.
--
-- This consumes parsed import declarations. The syntax-only collector records
-- source import bindings for single-source artifacts; the graph-aware
-- collector additionally validates against already-loaded module surfaces.
-- Both paths intentionally record only import bookkeeping here: imported
-- modules, aliases, imported-name bindings, imported type homes, and
-- diagnostics. The semantic env effects for imported declarations belong to
-- the declaration registration slice.
import:
	../../../lib/source: SourceLocation
	../../stage_03_parse/parsed_ast:
		ParsedDecl(
			BuiltinTypeParsedDecl,
			ForeignBlockParsedDecl,
			FunctionParsedDecl,
			ImplParsedDecl,
			ImportBlockParsedDecl,
			ParsedErrorDecl,
			PrivateParsedDecl,
			RecordParsedDecl,
			TraitParsedDecl,
			TypeAliasParsedDecl,
			UnionParsedDecl,
			VarParsedDecl,
		),
		ParsedForeignFunctionDecl,
		ParsedFunctionDecl,
		ParsedIdentifier,
		ParsedImplDecl,
		ParsedImportDecl,
		ParsedImportSymbol,
		ParsedProgram,
		ParsedTraitDecl,
		ParsedVarDecl,
		parsed_program_has_errors,
	../../stage_04_modules/loaded_module: ModuleOrigin
	../../stage_04_modules/module_surface:
		ModuleSurface,
		ModuleSurfaceSymbol,
		ModuleSurfaceSymbolKind(
			RecordSurfaceSymbol,
			TraitMethodSurfaceSymbol,
			TypeAliasSurfaceSymbol,
			TypeSurfaceSymbol,
		),
		module_surface_for_program,
	../../stage_04_modules/module_table:
		ModuleId,
		module_id_table_index,
		module_ids_equal,
		module_table_canonical_path,
	../../stage_04_modules/module_type_identity: local_type_names_from_decls
	../graph/definition_index:
		DefinitionId,
		DefinitionTable,
		EXPORTED_DEFINITION_TARGETS_EMPTY,
		ExportedDefinitionNameDemand,
		ExportedDefinitionTargets,
		definition_id_runtime_value,
		definition_index_definition_table,
		definition_index_exported_definition_targets,
		definition_table_module_table,
		definition_table_type_row,
		exported_definition_name_demand_empty,
		exported_definition_targets_find,
	../graph/indexed_graph:
		IndexedGraph,
		PreparedModuleScope,
		indexed_graph_module_scopes,
		indexed_graph_target_scope,
		prepared_module_canonical_path,
		prepared_module_origin,
		prepared_module_program,
		prepared_module_scope_conservative_selective_export_names,
		prepared_module_scope_definition_index,
		prepared_module_scope_id,
		prepared_module_scope_module,
		prepared_module_scope_module_table,
		prepared_module_scope_selective_export_names,
		prepared_module_scopes_are_compatible,
		prepared_module_surface,
	../graph/source_name_table: source_name_default_module_alias
	../state:
		TypecheckState,
		typecheck_state_add_error,
		typecheck_state_add_error_at,
		typecheck_state_add_known_type_name,
		typecheck_state_begin_graph_import_admission,
		typecheck_state_definition_table,
		typecheck_state_finish_graph_import_admission,
		typecheck_state_has_compatible_module_view,
		typecheck_state_is_stdlib,
		typecheck_state_record_imported_type_facts,
		typecheck_state_record_type_home,
		typecheck_state_register_graph_imported_constructor,
		typecheck_state_register_graph_imported_name,
		typecheck_state_register_graph_imported_trait_method,
		typecheck_state_register_graph_module_alias,
		typecheck_state_register_imported_constructor,
		typecheck_state_register_imported_name,
		typecheck_state_register_standalone_module_alias,
	../type_system/context: module_origin_is_package, module_origin_is_std
	import_binding: ImportBinding(GraphSelectiveDefinitionBinding)
	module_view: ModuleView, module_view_import_bindings
	set as Sets


---
Graph surfaces carry the table and ID together until the alias row is
validated. Standalone surfaces remain explicitly path-backed. Keeping the
distinction in this already-allocated row avoids a second target object per
import while making mixed provenance unrepresentable.
---
private union ImportableModuleSurfaceRep:
	GraphImportableModuleSurface(String, DefinitionTable, ModuleId, ModuleOrigin, ModuleSurface, ExportedDefinitionTargets)
	StandaloneImportableModuleSurface(String, ModuleOrigin, ModuleSurface)


opaque type ImportableModuleSurface = ImportableModuleSurfaceRep


private pure func importable_module_surface_rep(
	module: ImportableModuleSurface,
) -> ImportableModuleSurfaceRep:
	from_opaque ImportableModuleSurface(module)


---
Canonical source-import membership is transient binder output. Graph-aware
callers immediately normalize these paths to prepared modules and ModuleIds;
ModuleView does not retain a parallel string-keyed membership relation.
---
record ProgramImportRegistration {
	state: TypecheckState,
	accepted_canonical_module_paths: List[String]
}


union ImportableSignatureDecl:
	ImportableFunctionDecl(ParsedFunctionDecl)
	ImportableVarDecl(ParsedVarDecl)
	ImportableForeignFunctionDecl(ParsedForeignFunctionDecl)
	ImportableTraitDecl(ParsedTraitDecl)


private record AcceptedImportableModuleContents {
	surface: ModuleSurface,
	exported_definition_targets: ExportedDefinitionTargets,
	local_type_names: List[String],
	declared_imports: List[ParsedImportDecl],
	signature_decls: List[ImportableSignatureDecl],
	impl_decls: List[ParsedImplDecl],
	decls: List[ParsedDecl]
}


private union ImportableModuleContents:
	AcceptedImportableModuleContentsValue(AcceptedImportableModuleContents)
	RecoveryImportableModuleContents(ModuleSurface)


private record ImportableModuleRep {
	prepared_scope: PreparedModuleScope,
	module_path: String,
	origin: ModuleOrigin,
	contents: ImportableModuleContents
}


opaque type ImportableModule = ImportableModuleRep


private record ImportableModuleIndexRep {
	modules: List[ImportableModule],
	module_ordinals_by_path: Dict[String, Int],
	candidate_paths_by_request: Dict[String, List[String]],
	dependency_ordinals_by_module: List[List[Int]],
	prelude_path: Option[String]
}


opaque type ImportableModuleIndex = ImportableModuleIndexRep

private EMPTY_IMPORTABLE_MODULE_ADJACENCY: List[List[Int]] = []


private record ImportableModuleGraphRep {
	target_scope: PreparedModuleScope,
	dependency_index: ImportableModuleIndex,
	all_index: ImportableModuleIndex
}


opaque type ImportableModuleGraph = ImportableModuleGraphRep


private record ImportableDeclarationFacts {
	declared_imports: List[ParsedImportDecl],
	signature_decls: List[ImportableSignatureDecl],
	impl_decls: List[ParsedImplDecl]
}


pure func importable_module_surface(
	module_path: String,
	origin: ModuleOrigin,
	surface: ModuleSurface,
) -> ImportableModuleSurface:
	into_opaque ImportableModuleSurface(
		StandaloneImportableModuleSurface(module_path, origin, surface)
	)


pure func importable_module_surface_path(module: ImportableModuleSurface) -> String:
	match importable_module_surface_rep(module):
		GraphImportableModuleSurface(module_path, _, _, _, _, _):
			module_path
		StandaloneImportableModuleSurface(module_path, _, _):
			module_path


private pure func importable_module_surface_origin(module: ImportableModuleSurface) -> ModuleOrigin:
	match importable_module_surface_rep(module):
		GraphImportableModuleSurface(_, _, _, origin, _, _):
			origin
		StandaloneImportableModuleSurface(_, origin, _):
			origin


private pure func importable_surface_value(module: ImportableModuleSurface) -> ModuleSurface:
	match importable_module_surface_rep(module):
		GraphImportableModuleSurface(_, _, _, _, surface, _):
			surface
		StandaloneImportableModuleSurface(_, _, surface):
			surface


private pure func private_importable_imports(
	decl: ParsedDecl,
) -> Option[List[ParsedImportDecl]]:
	match decl:
		ImportBlockParsedDecl(imports, _):
			Some(imports)
		PrivateParsedDecl(inner, _):
			private_importable_imports(inner)
		FunctionParsedDecl(_):
			None
		VarParsedDecl(_):
			None
		ForeignBlockParsedDecl(_, _, _):
			None
		RecordParsedDecl(_):
			None
		UnionParsedDecl(_):
			None
		BuiltinTypeParsedDecl(_):
			None
		TypeAliasParsedDecl(_):
			None
		TraitParsedDecl(_):
			None
		ImplParsedDecl(_):
			None
		ParsedErrorDecl(_):
			None


private pure func importable_declaration_facts(
	decls: List[ParsedDecl],
) -> ImportableDeclarationFacts:
	var declared_imports: List[ParsedImportDecl] = []
	var signature_decls: List[ImportableSignatureDecl] = []
	var impl_decls: List[ParsedImplDecl] = []

	for decl in decls:
		match decl:
			FunctionParsedDecl(function_decl):
				signature_decls = signature_decls.append(ImportableFunctionDecl(function_decl))
			VarParsedDecl(var_decl):
				signature_decls = signature_decls.append(ImportableVarDecl(var_decl))
			ImportBlockParsedDecl(imports, _):
				declared_imports = declared_imports.concat(imports)
			ForeignBlockParsedDecl(_, functions, _):
				for function_decl in functions:
					if not function_decl.is_private:
						signature_decls = signature_decls.append(
							ImportableForeignFunctionDecl(function_decl),
						)
			RecordParsedDecl(_):
				void
			UnionParsedDecl(_):
				void
			BuiltinTypeParsedDecl(_):
				void
			TypeAliasParsedDecl(_):
				void
			TraitParsedDecl(trait_decl):
				signature_decls = signature_decls.append(ImportableTraitDecl(trait_decl))
			ImplParsedDecl(impl_decl):
				impl_decls = impl_decls.append(impl_decl)
			PrivateParsedDecl(inner, _):
				match private_importable_imports(inner):
					Some(imports):
						declared_imports = declared_imports.concat(imports)
					None:
						void
			ParsedErrorDecl(_):
				void

	{
		declared_imports = declared_imports,
		signature_decls = signature_decls,
		impl_decls = impl_decls
	}


private pure func recovery_module_surface(program: ParsedProgram) -> ModuleSurface:
	{
		module_name = program.source.module_name,
		import_paths = [],
		exports = [],
		private_names = [],
		private_traits = []
	}


private pure func importable_module_for_requested_names(
	prepared_scope: PreparedModuleScope,
	requested_names: Option[ExportedDefinitionNameDemand],
	conservative_requested_names: ExportedDefinitionNameDemand,
) -> ImportableModule:
	module = prepared_module_scope_module(prepared_scope)
	program = prepared_module_program(module)

	contents: ImportableModuleContents = if parsed_program_has_errors(program):
		RecoveryImportableModuleContents(recovery_module_surface(program))
	else:
		decls = program.decls
		facts = importable_declaration_facts(decls)

		surface = match prepared_module_surface(module):
			Some(retained):
				retained
			None:
				module_surface_for_program(program)

		exported_definition_targets = definition_index_exported_definition_targets(
			prepared_module_scope_definition_index(prepared_scope),
			prepared_module_scope_module_table(prepared_scope),
			prepared_module_scope_id(prepared_scope),
			program,
			surface,
			requested_names,
			conservative_requested_names,
		).get_or(EXPORTED_DEFINITION_TARGETS_EMPTY)

		AcceptedImportableModuleContentsValue({
			surface = surface,
			exported_definition_targets = exported_definition_targets,
			local_type_names = local_type_names_from_decls(decls),
			declared_imports = facts.declared_imports,
			signature_decls = facts.signature_decls,
			impl_decls = facts.impl_decls,
			decls = decls,
		})

	representation: ImportableModuleRep = {
		prepared_scope = prepared_scope,
		module_path = prepared_module_canonical_path(module),
		origin = prepared_module_origin(module),
		contents = contents
	}
	into_opaque ImportableModule(representation)


pure func importable_module(prepared_scope: PreparedModuleScope) -> ImportableModule:
	importable_module_for_requested_names(
		prepared_scope,
		None,
		exported_definition_name_demand_empty(),
	)


pure func importable_module_graph(indexed_graph: IndexedGraph) -> ImportableModuleGraph:
	target_scope = indexed_graph_target_scope(indexed_graph)
	dependency_scopes = indexed_graph_module_scopes(indexed_graph)
	var dependency_modules: List[ImportableModule] = []

	for scope in dependency_scopes:
		dependency_modules = dependency_modules.append(
			importable_module_for_requested_names(
				scope,
				Some(prepared_module_scope_selective_export_names(scope)),
				prepared_module_scope_conservative_selective_export_names(scope),
			),
		)

	target_module = importable_module_for_requested_names(
		target_scope,
		Some(prepared_module_scope_selective_export_names(target_scope)),
		prepared_module_scope_conservative_selective_export_names(target_scope),
	)
	all_modules = dependency_modules.append(target_module)
	all_index = importable_module_index(all_modules)
	representation: ImportableModuleGraphRep = {
		target_scope = target_scope,
		dependency_index = importable_module_index_without_target(
			all_index,
			dependency_modules,
			target_module,
		),
		all_index = all_index
	}
	into_opaque ImportableModuleGraph(representation)


private pure func importable_module_graph_rep(
	graph: ImportableModuleGraph,
) -> ImportableModuleGraphRep:
	from_opaque ImportableModuleGraph(graph)


pure func importable_module_graph_dependencies(
	graph: ImportableModuleGraph,
) -> List[ImportableModule]:
	importable_module_index_modules(importable_module_graph_rep(graph).dependency_index)


pure func importable_module_graph_all(graph: ImportableModuleGraph) -> List[ImportableModule]:
	importable_module_index_modules(importable_module_graph_rep(graph).all_index)


pure func importable_module_graph_dependency_index(
	graph: ImportableModuleGraph,
) -> ImportableModuleIndex:
	importable_module_graph_rep(graph).dependency_index


pure func importable_module_graph_all_index(graph: ImportableModuleGraph) -> ImportableModuleIndex:
	importable_module_graph_rep(graph).all_index


pure func importable_module_graph_matches_scope(
	graph: ImportableModuleGraph,
	scope: PreparedModuleScope,
) -> Bool:
	prepared_module_scopes_are_compatible(importable_module_graph_rep(graph).target_scope, scope)


private pure func importable_module_has_accepted_contents(module: ImportableModule) -> Bool:
	match importable_module_contents(module):
		AcceptedImportableModuleContentsValue(_):
			True
		RecoveryImportableModuleContents(_):
			False


---
Body checking is only valid for a parser-accepted module owned by this
graph. Recovery modules remain available for diagnostics but cannot be
refined into a semantic typecheck input.
---
pure func importable_module_graph_accepts_scope(
	graph: ImportableModuleGraph,
	scope: PreparedModuleScope,
) -> Bool:
	if not importable_module_graph_matches_scope(graph, scope):
		False
	else:
		module_id = prepared_module_scope_id(scope)
		module_path = prepared_module_canonical_path(prepared_module_scope_module(scope))

		match importable_module_index_find(importable_module_graph_all_index(graph), module_path):
			Some(module):
				(
					module_ids_equal(
						prepared_module_scope_id(importable_module_prepared_scope(module)),
						module_id,
					)
					and importable_module_has_accepted_contents(module)
				)
			None:
				False


pure func importable_module_path(module: ImportableModule) -> String:
	representation: ImportableModuleRep = from_opaque ImportableModule(module)
	representation.module_path


pure func importable_module_prepared_scope(module: ImportableModule) -> PreparedModuleScope:
	representation: ImportableModuleRep = from_opaque ImportableModule(module)
	representation.prepared_scope


pure func importable_module_origin(module: ImportableModule) -> ModuleOrigin:
	representation: ImportableModuleRep = from_opaque ImportableModule(module)
	representation.origin


private pure func importable_module_contents(module: ImportableModule) -> ImportableModuleContents:
	representation: ImportableModuleRep = from_opaque ImportableModule(module)
	representation.contents


pure func importable_module_surface_value(module: ImportableModule) -> ModuleSurface:
	match importable_module_contents(module):
		AcceptedImportableModuleContentsValue(contents):
			contents.surface
		RecoveryImportableModuleContents(surface):
			surface


private pure func importable_module_exported_definition_targets(
	module: ImportableModule,
) -> ExportedDefinitionTargets:
	match importable_module_contents(module):
		AcceptedImportableModuleContentsValue(contents):
			contents.exported_definition_targets
		RecoveryImportableModuleContents(_):
			EXPORTED_DEFINITION_TARGETS_EMPTY


pure func importable_module_local_type_names(module: ImportableModule) -> List[String]:
	match importable_module_contents(module):
		AcceptedImportableModuleContentsValue(contents):
			contents.local_type_names
		RecoveryImportableModuleContents(_):
			[]


pure func importable_module_declared_imports(module: ImportableModule) -> List[ParsedImportDecl]:
	match importable_module_contents(module):
		AcceptedImportableModuleContentsValue(contents):
			contents.declared_imports
		RecoveryImportableModuleContents(_):
			[]


pure func importable_module_signature_decls(
	module: ImportableModule,
) -> List[ImportableSignatureDecl]:
	match importable_module_contents(module):
		AcceptedImportableModuleContentsValue(contents):
			contents.signature_decls
		RecoveryImportableModuleContents(_):
			[]


pure func importable_module_impl_decls(module: ImportableModule) -> List[ParsedImplDecl]:
	match importable_module_contents(module):
		AcceptedImportableModuleContentsValue(contents):
			contents.impl_decls
		RecoveryImportableModuleContents(_):
			[]


pure func importable_module_decls(module: ImportableModule) -> List[ParsedDecl]:
	match importable_module_contents(module):
		AcceptedImportableModuleContentsValue(contents):
			contents.decls
		RecoveryImportableModuleContents(_):
			[]


pure func importable_module_to_surface(module: ImportableModule) -> ImportableModuleSurface:
	scope = importable_module_prepared_scope(module)
	into_opaque ImportableModuleSurface(
		GraphImportableModuleSurface(
			importable_module_path(module),
			definition_index_definition_table(prepared_module_scope_definition_index(scope)),
			prepared_module_scope_id(scope),
			importable_module_origin(module),
			importable_module_surface_value(module),
			importable_module_exported_definition_targets(module),
		)
	)


pure func import_default_alias(module_path: String) -> String:
	source_name_default_module_alias(module_path)


pure func importable_module_request_aliases(
	module_path: String,
	module_name: String,
) -> List[String]:
	var aliases: List[String] = []

	for identity in [module_path, module_name]:
		if not aliases.contains(identity):
			aliases = aliases.append(identity)

	aliases


pure func importable_module_identity_is_std_prelude(
	module_path: String,
	origin: ModuleOrigin,
	module_name: String,
) -> Bool:
	(
		module_origin_is_std(origin)
		and importable_module_request_aliases(module_path, module_name).contains("prelude")
	)


private pure func importable_module_index_rep(
	index: ImportableModuleIndex,
) -> ImportableModuleIndexRep:
	from_opaque ImportableModuleIndex(index)


pure func importable_module_index_modules(index: ImportableModuleIndex) -> List[ImportableModule]:
	importable_module_index_rep(index).modules


pure func importable_module_index_find(
	index: ImportableModuleIndex,
	canonical_path: String,
) -> Option[ImportableModule]:
	representation = importable_module_index_rep(index)
	ordinal ?= representation.module_ordinals_by_path.get(canonical_path)
	representation.modules.get(ordinal)


pure func importable_module_index_modules_for_paths(
	index: ImportableModuleIndex,
	canonical_paths: List[String],
) -> List[ImportableModule]:
	representation = importable_module_index_rep(index)
	var ordered: List[(Int, ImportableModule)] = []

	for canonical_path in canonical_paths:
		match representation.module_ordinals_by_path.get(canonical_path):
			Some(ordinal):
				match representation.modules.get(ordinal):
					Some(module):
						ordered = ordered.append((ordinal, module))
					None:
						void
			None:
				void

	ordered
		.sort_by(func(entry): entry[0])
		.map(func(entry): entry[1])


pure func importable_module_index_prelude(index: ImportableModuleIndex) -> Option[ImportableModule]:
	representation = importable_module_index_rep(index)

	match representation.prelude_path:
		Some(module_path):
			importable_module_index_find(index, module_path)
		None:
			None


pure func importable_module_index_matching_paths(
	index: ImportableModuleIndex,
	requested_path: String,
) -> List[String]:
	representation = importable_module_index_rep(index)

	match representation.module_ordinals_by_path.get(requested_path):
		Some(_):
			[requested_path]
		None:
			candidates = representation.candidate_paths_by_request.get_or(requested_path, [])

			if candidates.length() > 1:
				candidates.sort()
			else:
				candidates


private pure func importable_module_ordinal_is_current(
	module_ordinal: Int,
	current_module_ordinal: Option[Int],
) -> Bool:
	match current_module_ordinal:
		Some(current):
			module_ordinal == current
		None:
			False


pure func importable_module_index_dependency_closure(
	index: ImportableModuleIndex,
	roots: List[ImportableModule],
	current_module_path: Option[String],
) -> List[ImportableModule]:
	representation = importable_module_index_rep(index)

	if representation.dependency_ordinals_by_module.length() != representation.modules.length():
		[]
	else:
		current_module_ordinal = match current_module_path:
			Some(path):
				representation.module_ordinals_by_path.get(path)
			None:
				None

		var module_ordinals: List[Int] = []
		var seen: Set[Int] = Sets.set()
		var visit_index: Int = 0
		var traversal_valid: Bool = True

		for root in roots:
			match representation.module_ordinals_by_path.get(importable_module_path(root)):
				Some(root_ordinal):
					if not Sets.contains(seen, root_ordinal):
						module_ordinals = module_ordinals.append(root_ordinal)
						seen = Sets.add(seen, root_ordinal)
				None:
					void

		while visit_index < module_ordinals.length() and traversal_valid:
			match module_ordinals.get(visit_index):
				Some(module_ordinal):
					match representation.dependency_ordinals_by_module.get(module_ordinal):
						Some(dependencies):
							for dependency in dependencies:
								if (
									not Sets.contains(seen, dependency)
									and not importable_module_ordinal_is_current(
										dependency,
										current_module_ordinal,
									)
								):
									module_ordinals = module_ordinals.append(dependency)
									seen = Sets.add(seen, dependency)
						None:
							traversal_valid = False
				None:
					traversal_valid = False

			visit_index += 1

		var modules: List[ImportableModule] = []
		var projection_valid: Bool = True

		for module_ordinal in module_ordinals.sort():
			match representation.modules.get(module_ordinal):
				Some(module):
					modules = modules.append(module)
				None:
					projection_valid = False

		if traversal_valid and projection_valid:
			modules
		else:
			[]


private pure func importable_module_index_prelude_path(
	modules: List[ImportableModule],
	module_ordinals_by_path: Dict[String, Int],
) -> Option[String]:
	var prelude_path: Option[String] = None

	for canonical_path in ["prelude"]:
		match module_ordinals_by_path.get(canonical_path):
			Some(ordinal):
				match modules.get(ordinal):
					Some(module):
						if importable_module_identity_is_std_prelude(
							importable_module_path(module),
							importable_module_origin(module),
							importable_module_surface_value(module).module_name,
						):
							prelude_path = Some(canonical_path)
							break
					None:
						void
			None:
				void

	match prelude_path:
		Some(_):
			void
		None:
			for module in modules:
				module_name = importable_module_surface_value(module).module_name

				if importable_module_identity_is_std_prelude(
					importable_module_path(module),
					importable_module_origin(module),
					module_name,
				):
					prelude_path = Some(importable_module_path(module))
					break

	prelude_path


private pure func importable_module_index_with_adjacency(
	base_representation: ImportableModuleIndexRep,
) -> ImportableModuleIndex:
	modules = base_representation.modules
	module_ordinals_by_path = base_representation.module_ordinals_by_path

	base = into_opaque ImportableModuleIndex(base_representation)
	var dependency_ordinals_by_module: List[List[Int]] = []
	var adjacency_valid: Bool = True
	-- Reuse one dense epoch table across every module. This gives constant-time
	-- edge deduplication without allocating a Set or sorting each adjacency row.
	dependency_unseen_epoch: Int = 0
	var dependency_seen_epoch_by_ordinal: List[Int] = dependency_unseen_epoch.repeat(
		modules.length(),
	)
	var dependency_seen_epoch: Int = dependency_unseen_epoch + 1

	for module in modules:
		var dependencies: List[Int] = []

		for import_decl in importable_module_declared_imports(module):
			for dependency_path in importable_module_index_matching_paths(
				base,
				import_decl.module_path,
			):
				match module_ordinals_by_path.get(dependency_path):
					Some(dependency_ordinal):
						if dependency_seen_epoch_by_ordinal.get_or(
							dependency_ordinal,
							dependency_unseen_epoch,
						) != dependency_seen_epoch:
							dependencies = dependencies.append(dependency_ordinal)
							dependency_seen_epoch_by_ordinal = dependency_seen_epoch_by_ordinal.set(
								dependency_ordinal,
								dependency_seen_epoch,
							)
					None:
						adjacency_valid = False

		dependency_ordinals_by_module = dependency_ordinals_by_module.append(dependencies)
		dependency_seen_epoch += 1

	final_dependency_ordinals = if adjacency_valid:
		dependency_ordinals_by_module
	else:
		EMPTY_IMPORTABLE_MODULE_ADJACENCY

	indexed_representation = { base_representation |
		dependency_ordinals_by_module = final_dependency_ordinals
	}
	into_opaque ImportableModuleIndex(indexed_representation)


private pure func importable_module_index(modules: List[ImportableModule]) -> ImportableModuleIndex:
	var module_ordinals_by_path: Dict[String, Int] = {}
	var candidate_paths_by_request: Dict[String, List[String]] = {}
	var module_ordinal: Int = 0

	for module in modules:
		module_path = importable_module_path(module)
		module_ordinals_by_path = module_ordinals_by_path.set(module_path, module_ordinal)

		for request_alias in importable_module_request_aliases(
			module_path,
			importable_module_surface_value(module).module_name,
		):
			existing = candidate_paths_by_request.get_or(request_alias, [])
			-- Module paths are unique in IndexedGraph, and request_aliases
			-- de-duplicates aliases within one module. No second membership
			-- scan is needed before appending this module's path.
			candidate_paths_by_request = candidate_paths_by_request.set(
				request_alias,
				existing.append(module_path),
			)

		module_ordinal += 1

	importable_module_index_with_adjacency({
		modules = modules,
		module_ordinals_by_path = module_ordinals_by_path,
		candidate_paths_by_request = candidate_paths_by_request,
		dependency_ordinals_by_module = [],
		prelude_path = importable_module_index_prelude_path(modules, module_ordinals_by_path),
	})


---
The target is the final module in the all-module inventory. Excluding it
changes exact-path precedence and may change alias ambiguity, so only the
stable keyed catalog is shared; dependency adjacency is resolved again
against the narrower candidate set.
---
private pure func importable_module_index_without_target(
	all_index: ImportableModuleIndex,
	dependency_modules: List[ImportableModule],
	target: ImportableModule,
) -> ImportableModuleIndex:
	all = importable_module_index_rep(all_index)
	target_path = importable_module_path(target)
	module_ordinals_by_path = all.module_ordinals_by_path.remove(target_path)
	var candidate_paths_by_request = all.candidate_paths_by_request

	for request_alias in importable_module_request_aliases(
		target_path,
		importable_module_surface_value(target).module_name,
	):
		remaining = candidate_paths_by_request
			.get_or(request_alias, [])
			.filter(func(path): path != target_path)

		candidate_paths_by_request = if remaining.is_empty():
			candidate_paths_by_request.remove(request_alias)
		else:
			candidate_paths_by_request.set(request_alias, remaining)

	prelude_path = if all.prelude_path == Some(target_path):
		importable_module_index_prelude_path(dependency_modules, module_ordinals_by_path)
	else:
		all.prelude_path

	importable_module_index_with_adjacency({
		modules = dependency_modules,
		module_ordinals_by_path = module_ordinals_by_path,
		candidate_paths_by_request = candidate_paths_by_request,
		dependency_ordinals_by_module = [],
		prelude_path = prelude_path,
	})


---
A source declaration has one module-level decision before symbol/alias
registration mutates the typecheck state. The binder applies it immediately
in source order; the later candidate owner can retain this exact outcome
without first materializing a duplicate declaration plan.
---
private union ImportDeclDecision:
	ImportDeclMissing
	ImportDeclAmbiguous(List[String])
	ImportDeclForbiddenPackage
	ImportDeclDuplicateModule
	ImportDeclSelected(ImportableModuleSurface)


private record ImportModuleIndex {
	exact_by_path: Dict[String, List[ImportableModuleSurface]],
	candidates_by_request: Dict[String, List[ImportableModuleSurface]]
}


private pure func import_module_index(modules: List[ImportableModuleSurface]) -> ImportModuleIndex:
	var exact_by_path: Dict[String, List[ImportableModuleSurface]] = {}
	var candidates_by_request: Dict[String, List[ImportableModuleSurface]] = {}

	for module in modules:
		module_path = importable_module_surface_path(module)
		exact_by_path = exact_by_path.set(
			module_path,
			exact_by_path
				.get_or(module_path, [])
				.append(module),
		)

		for request_alias in importable_module_request_aliases(
			module_path,
			importable_surface_value(module).module_name,
		):
			candidates_by_request = candidates_by_request.set(
				request_alias,
				candidates_by_request
					.get_or(request_alias, [])
					.append(module),
			)

	{
		exact_by_path = exact_by_path,
		candidates_by_request = candidates_by_request
	}


private pure func decide_import_decl(
	index: ImportModuleIndex,
	decl: ParsedImportDecl,
	seen_module_paths: Dict[String, Bool],
	is_stdlib: Bool,
) -> ImportDeclDecision:
	exact_matches = index.exact_by_path.get_or(decl.module_path, [])

	matches = if exact_matches.length() > 0:
		exact_matches
	else:
		index.candidates_by_request.get_or(decl.module_path, [])

	match matches:
		[]:
			ImportDeclMissing
		[module]:
			module_path = importable_module_surface_path(module)

			if is_stdlib and module_origin_is_package(importable_module_surface_origin(module)):
				ImportDeclForbiddenPackage
			else if seen_module_paths.contains(module_path):
				ImportDeclDuplicateModule
			else:
				ImportDeclSelected(module)
		_:
			ImportDeclAmbiguous(
				matches
					.map(importable_module_surface_path)
					.sort(),
			)


private pure func find_surface_symbol(
	symbols: List[ModuleSurfaceSymbol],
	name: String,
) -> Option[ModuleSurfaceSymbol]:
	symbols.find(func(symbol): symbol.name == name)


private pure func import_symbol_kind_is_type_like(kind: ModuleSurfaceSymbolKind) -> Bool:
	match kind:
		TypeSurfaceSymbol:
			True
		RecordSurfaceSymbol:
			True
		TypeAliasSurfaceSymbol:
			True
		_:
			False


private pure func import_symbol_local_name(symbol: ParsedImportSymbol) -> String:
	match symbol.symbol_alias:
		Some(alias_name):
			alias_name.text
		None:
			symbol.name.text


private pure func import_decl_explicit_alias(decl: ParsedImportDecl) -> Option[String]:
	match decl.module_alias:
		Some(alias_name):
			Some(alias_name.text)
		None:
			None


private pure func register_import_symbol_syntax(
	state: TypecheckState,
	module_path: String,
	symbol: ParsedImportSymbol,
) -> TypecheckState:
	registration = typecheck_state_register_imported_name(
		state,
		import_symbol_local_name(symbol),
		module_path,
		symbol.name.text,
	)
	var next: TypecheckState = registration.state

	if registration.registered:
		for constructor in symbol.constructors:
			next = register_import_constructor(
				next,
				module_path,
				import_symbol_local_name(symbol),
				symbol.name.text,
				constructor,
			)

	next


private pure func register_import_constructor(
	state: TypecheckState,
	module_path: String,
	parent_local_name: String,
	parent_name: String,
	constructor: ParsedIdentifier,
) -> TypecheckState:
	registration = typecheck_state_register_imported_constructor(
		state,
		constructor.text,
		module_path,
		parent_local_name,
		parent_name,
		constructor.text,
	)
	registration.state


private pure func register_import_symbols_syntax(
	state: TypecheckState,
	module_path: String,
	symbols: List[ParsedImportSymbol],
) -> TypecheckState:
	var next: TypecheckState = state

	for symbol in symbols:
		next = register_import_symbol_syntax(next, module_path, symbol)

	next


pure func register_import_decl_syntax(
	state: TypecheckState,
	import_decl: ParsedImportDecl,
) -> TypecheckState:
	module_path: String = import_decl.module_path
	var next: TypecheckState = state

	match import_decl.symbols:
		Some(symbols):
			next = register_import_symbols_syntax(next, module_path, symbols)

			match import_decl_explicit_alias(import_decl):
				Some(alias_name):
					typecheck_state_register_standalone_module_alias(next, alias_name, module_path)
				None:
					next
		None:
			alias_name: String = import_decl_explicit_alias(
				import_decl,
			).get_or(import_default_alias(module_path))

			typecheck_state_register_standalone_module_alias(next, alias_name, module_path)


private pure func register_imports_decl_syntax(
	state: TypecheckState,
	decl: ParsedDecl,
) -> TypecheckState:
	match decl:
		ImportBlockParsedDecl(imports, _):
			var next: TypecheckState = state

			for import_decl in imports:
				next = register_import_decl_syntax(next, import_decl)

			next
		PrivateParsedDecl(inner, _):
			register_imports_decl_syntax(state, inner)
		_:
			state


pure func register_program_import_syntax(
	state: TypecheckState,
	program: ParsedProgram,
) -> TypecheckState:
	var current: TypecheckState = state

	for decl in program.decls:
		current = register_imports_decl_syntax(current, decl)

	current


private pure func import_not_loaded_error(
	state: TypecheckState,
	module_path: String,
	span: SourceLocation,
) -> TypecheckState:
	typecheck_state_add_error_at(
		state,
		span,
		"module '" + module_path + "' is not loaded for import registration",
	)


private pure func import_ambiguous_module_error(
	state: TypecheckState,
	module_path: String,
	canonical_paths: List[String],
	span: SourceLocation,
) -> TypecheckState:
	quoted_paths = canonical_paths.map(func(path): "'" + path + "'")
	typecheck_state_add_error_at(
		state,
		span,
		"module '" + module_path + "' is ambiguous; it matches " + quoted_paths.join(" and "),
	)


private pure func import_duplicate_module_error(
	state: TypecheckState,
	module_path: String,
	span: SourceLocation,
) -> TypecheckState:
	typecheck_state_add_error_at(
		state,
		span,
		"module '" + import_default_alias(module_path) + "' is already imported",
	)


private pure func import_std_package_error(
	state: TypecheckState,
	span: SourceLocation,
) -> TypecheckState:
	typecheck_state_add_error_at(
		state,
		span,
		"standard library modules cannot import package modules",
	)


private pure func import_private_symbol_error(
	state: TypecheckState,
	module_path: String,
	symbol_name: String,
) -> TypecheckState:
	typecheck_state_add_error(
		state,
		"'" + symbol_name + "' is private in module '" + module_path + "' and cannot be imported",
	)


private pure func import_missing_symbol_error(
	state: TypecheckState,
	module_path: String,
	symbol_name: String,
) -> TypecheckState:
	typecheck_state_add_error(
		state,
		"'" + symbol_name + "' is not exported by module '" + module_path + "'",
	)


private pure func record_imported_type_symbol(
	state: TypecheckState,
	module_path: String,
	local_name: String,
	symbol: ModuleSurfaceSymbol,
) -> TypecheckState:
	if import_symbol_kind_is_type_like(symbol.kind):
		typecheck_state_record_type_home(
			typecheck_state_add_known_type_name(state, local_name),
			local_name,
			module_path,
			True,
		)
	else:
		state


private pure func graph_import_binding_is_type(
	definition_table: DefinitionTable,
	module_id: ModuleId,
	definition_ids: List[DefinitionId],
) -> Bool:
	definition_ids.any(func(definition_id):
		match definition_table_type_row(
			definition_table,
			definition_id_runtime_value(definition_id),
		):
			Some(row):
				module_ids_equal(row.module_id, module_id)
			None:
				False
	)


---
Accepted graph views already retain exact module and definition IDs for
every selective import. Replay imported type facts from those IDs instead
of rebuilding a path map and rescanning source-facing module exports.
---
pure func register_module_view_type_facts(state: TypecheckState) -> TypecheckState:
	if not typecheck_state_has_compatible_module_view(state):
		state
	else:
		match typecheck_state_definition_table(state):
			None:
				state
			Some(definition_table):
				var type_facts: List[(String, String)] = []

				for binding in module_view_import_bindings(state.module_view):
					match binding:
						GraphSelectiveDefinitionBinding(local_name, module_id, definition_ids):
							if graph_import_binding_is_type(
								definition_table,
								module_id,
								definition_ids,
							):
								match module_table_canonical_path(
									definition_table_module_table(definition_table),
									module_id,
								):
									Some(module_path):
										type_facts = type_facts.append((local_name, module_path))
									None:
										void
						_:
							void

				typecheck_state_record_imported_type_facts(state, type_facts)


private pure func register_import_symbol(
	state: TypecheckState,
	imported_module: ImportableModuleSurface,
	symbol: ParsedImportSymbol,
) -> TypecheckState:
	module_path = importable_module_surface_path(imported_module)
	original_name: String = symbol.name.text
	local_name: String = import_symbol_local_name(symbol)

	exported_target = match importable_module_surface_rep(imported_module):
		GraphImportableModuleSurface(_, _, _, _, _, targets):
			exported_definition_targets_find(targets, original_name)
		StandaloneImportableModuleSurface(_, _, module_surface):
			match find_surface_symbol(module_surface.exports, original_name):
				Some(found_symbol):
					empty_definition_ids: List[DefinitionId] = []
					Some((found_symbol, empty_definition_ids))
				None:
					None

	match exported_target:
		Some(target):
			exported_symbol = target[0]
			definition_ids = target[1]

			registration = match importable_module_surface_rep(imported_module):
				GraphImportableModuleSurface(_, issuing_definition_table, module_id, _, _, _):
					match exported_symbol.kind:
						TraitMethodSurfaceSymbol:
							typecheck_state_register_graph_imported_trait_method(
								state,
								local_name,
								module_path,
								original_name,
								issuing_definition_table,
								module_id,
								definition_ids,
							)
						_:
							typecheck_state_register_graph_imported_name(
								state,
								local_name,
								module_path,
								original_name,
								issuing_definition_table,
								module_id,
								definition_ids,
							)
				StandaloneImportableModuleSurface(_, _, _):
					typecheck_state_register_imported_name(
						state,
						local_name,
						module_path,
						original_name,
					)

			if registration.registered:
				var next: TypecheckState = record_imported_type_symbol(
					registration.state,
					module_path,
					local_name,
					exported_symbol,
				)

				for constructor in symbol.constructors:
					next = register_import_constructor_for_module(
						next,
						imported_module,
						local_name,
						symbol.name.text,
						constructor,
					)

				next
			else:
				registration.state
		None:
			match find_surface_symbol(
				importable_surface_value(imported_module).private_names,
				original_name,
			):
				Some(_):
					import_private_symbol_error(state, module_path, original_name)
				None:
					import_missing_symbol_error(state, module_path, original_name)


private pure func register_import_constructor_for_module(
	state: TypecheckState,
	imported_module: ImportableModuleSurface,
	parent_local_name: String,
	parent_name: String,
	constructor: ParsedIdentifier,
) -> TypecheckState:
	module_path = importable_module_surface_path(imported_module)

	registration = match importable_module_surface_rep(imported_module):
		GraphImportableModuleSurface(_, issuing_definition_table, module_id, _, _, _):
			typecheck_state_register_graph_imported_constructor(
				state,
				constructor.text,
				module_path,
				parent_local_name,
				parent_name,
				constructor.text,
				issuing_definition_table,
				module_id,
			)
		StandaloneImportableModuleSurface(_, _, _):
			typecheck_state_register_imported_constructor(
				state,
				constructor.text,
				module_path,
				parent_local_name,
				parent_name,
				constructor.text,
			)

	registration.state


private pure func register_import_symbols(
	state: TypecheckState,
	imported_module: ImportableModuleSurface,
	symbols: List[ParsedImportSymbol],
) -> TypecheckState:
	var current: TypecheckState = state
	var seen_local_names: List[String] = []

	for symbol in symbols:
		local_name: String = import_symbol_local_name(symbol)

		if seen_local_names.contains(local_name):
			current = typecheck_state_add_error(current, "'" + local_name + "' is already imported from this module")
		else:
			seen_local_names = seen_local_names.append(local_name)
			current = register_import_symbol(current, imported_module, symbol)

	current


private pure func register_import_alias_if_present(
	state: TypecheckState,
	imported_module: ImportableModuleSurface,
	maybe_alias: Option[String],
) -> TypecheckState:
	match maybe_alias:
		Some(alias_name):
			register_import_module_alias(state, imported_module, alias_name)
		None:
			state


private pure func register_import_module_alias(
	state: TypecheckState,
	imported_module: ImportableModuleSurface,
	alias_name: String,
) -> TypecheckState:
	match importable_module_surface_rep(imported_module):
		GraphImportableModuleSurface(module_path, issuing_definition_table, module_id, _, _, _):
			typecheck_state_register_graph_module_alias(
				state,
				alias_name,
				module_path,
				definition_table_module_table(issuing_definition_table),
				module_id,
			)
		StandaloneImportableModuleSurface(module_path, _, _):
			typecheck_state_register_standalone_module_alias(state, alias_name, module_path)


private pure func apply_import_decl_decision(
	state: TypecheckState,
	decl: ParsedImportDecl,
	decision: ImportDeclDecision,
) -> TypecheckState:
	match decision:
		ImportDeclMissing:
			import_not_loaded_error(state, decl.module_path, decl.module_path_span)
		ImportDeclAmbiguous(canonical_paths):
			import_ambiguous_module_error(
				state,
				decl.module_path,
				canonical_paths,
				decl.module_path_span,
			)
		ImportDeclForbiddenPackage:
			import_std_package_error(state, decl.module_path_span)
		ImportDeclDuplicateModule:
			import_duplicate_module_error(state, decl.module_path, decl.module_path_span)
		ImportDeclSelected(imported_module):
			match decl.symbols:
				Some(symbols):
					with_symbols = register_import_symbols(state, imported_module, symbols)
					register_import_alias_if_present(
						with_symbols,
						imported_module,
						import_decl_explicit_alias(decl),
					)
				None:
					alias_name: String = match import_decl_explicit_alias(decl):
						Some(explicit_alias):
							explicit_alias
						None:
							import_default_alias(decl.module_path)

					register_import_module_alias(state, imported_module, alias_name)


pure func register_program_imports(
	state: TypecheckState,
	modules: List[ImportableModuleSurface],
	program: ParsedProgram,
) -> ProgramImportRegistration:
	var accepted_canonical_module_paths: List[String] = []
	index = import_module_index(modules)
	is_stdlib = typecheck_state_is_stdlib(state)
	var seen_module_paths: Dict[String, Bool] = {}
	var current = state
	var saw_import = False

	for parsed_decl in program.decls:
		match parsed_decl:
			ImportBlockParsedDecl(imports, _):
				for import_decl in imports:
					-- Begin only for a real import; empty blocks must not publish
					-- an unchanged graph view. Injected preludes count here.
					if not saw_import:
						current = typecheck_state_begin_graph_import_admission(current)
						saw_import = True

					decision = decide_import_decl(index, import_decl, seen_module_paths, is_stdlib)
					current = apply_import_decl_decision(current, import_decl, decision)

					match decision:
						ImportDeclSelected(imported_module):
							module_path = importable_module_surface_path(imported_module)
							seen_module_paths = seen_module_paths.set(module_path, True)
							accepted_canonical_module_paths = accepted_canonical_module_paths.append(
								module_path,
							)
						_:
							void
			_:
				void

	final_state = if saw_import:
		typecheck_state_finish_graph_import_admission(current)
	else:
		current

	{
		state = final_state,
		accepted_canonical_module_paths = accepted_canonical_module_paths
	}
