-- Graph alias rows retain only the exact ModuleId issued by their ModuleTable.
-- The transient import surface carries table provenance until registration;
-- accepted views do not duplicate that graph owner per alias.
import:
	../../stage_04_modules/module_table: ModuleId
	../graph/definition_index: DefinitionId


MODULE_IMPORT_TARGET_INVALID_LABEL: String = "<invalid module import target>"

-- Graph alias rows live in dense ordered lists. A named tuple keeps the row
-- inline in its owner instead of adding one heap record per alias.
type alias ModuleAliasBinding = (String, ModuleId)


pure func module_alias_binding(local_name: String, module_id: ModuleId) -> ModuleAliasBinding:
	(local_name, module_id)


pure func module_alias_binding_local_name(binding: ModuleAliasBinding) -> String:
	binding[0]


pure func module_alias_binding_module_id(binding: ModuleAliasBinding) -> ModuleId:
	binding[1]


-- A source import has exactly one binding kind. Qualified bindings expose a
-- module under a local name; selective bindings expose one source definition.
-- Keeping the cases distinct prevents an absent source name from being paired
-- with selective semantics, or a present source name with module semantics.
union ImportBinding:
	GraphQualifiedModuleBinding(String, ModuleId)
	StandaloneQualifiedModuleBinding(String, String)
	GraphSelectiveDefinitionBinding(String, ModuleId, List[DefinitionId])
	GraphSelectiveTraitMethodBinding(String, ModuleId, String)
	StandaloneSelectiveDefinitionBinding(String, String, String)
