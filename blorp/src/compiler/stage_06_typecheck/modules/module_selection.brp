-- Module-selection orchestration for Blorp-owned typechecking.
import:
	../../stage_03_parse/parsed_ast: ParsedProgram
	module_binding: ImportableModule, ImportableModuleIndex
	module_visibility:
		importable_module_dependency_closure,
		importable_modules_for_program,
		with_ambient_impl_modules,


pure func importable_module_selection_for_program(
	program_with_prelude: ParsedProgram,
	index: ImportableModuleIndex,
	current_module_path: Option[String],
) -> (List[ImportableModule], List[ImportableModule]):
	direct_import_modules = importable_modules_for_program(
		index,
		program_with_prelude,
		current_module_path,
	)
	visible_import_modules = with_ambient_impl_modules(
		importable_module_dependency_closure(index, direct_import_modules, current_module_path),
		index,
		current_module_path,
	)

	(
		visible_import_modules,
		with_ambient_impl_modules(direct_import_modules, index, current_module_path),
	)
