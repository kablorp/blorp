-- Module-selection orchestration for Blorp-owned typechecking.
import:
	module_binding:
		ImportableModule,
		ImportableModuleIndex,
		importable_module_index_modules_for_paths,
	module_visibility: importable_module_dependency_closure, with_ambient_impl_modules


-- Direct modules keep source imports as a stable prefix and append ambient
-- semantic evidence afterward. The explicit prefix length lets accepted
-- source-name consumers exclude ambient modules without another collection.
record ImportableModuleSelection {
	visible_import_modules: List[ImportableModule],
	direct_import_modules: List[ImportableModule],
	source_direct_import_count: Int
}


pure func importable_module_selection_for_accepted_imports(
	index: ImportableModuleIndex,
	accepted_canonical_module_paths: List[String],
	current_module_path: Option[String],
) -> ImportableModuleSelection:
	source_direct_import_modules = importable_module_index_modules_for_paths(
		index,
		accepted_canonical_module_paths,
	)
	visible_import_modules = with_ambient_impl_modules(
		importable_module_dependency_closure(
			index,
			source_direct_import_modules,
			current_module_path,
		),
		index,
		current_module_path,
	)

	{
		visible_import_modules = visible_import_modules,
		direct_import_modules = with_ambient_impl_modules(
			source_direct_import_modules,
			index,
			current_module_path,
		),
		source_direct_import_count = source_direct_import_modules.length()
	}
