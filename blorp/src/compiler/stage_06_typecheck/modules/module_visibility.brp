-- Module selection and dependency visibility for Blorp-owned typechecking.
--
-- This module decides which already-prepared modules are directly imported or
-- transitively visible. It does not register semantic declarations or mutate
-- a typechecking environment.
import:
	../../stage_03_parse/parsed_ast:
		ParsedDecl(ImportBlockParsedDecl, PrivateParsedDecl),
		ParsedProgram,
	module_binding:
		ImportableModule,
		ImportableModuleIndex,
		ImportableModuleSurface,
		importable_module_index_dependency_paths,
		importable_module_index_find,
		importable_module_index_matching_paths,
		importable_module_index_modules_for_paths,
		importable_module_path,
		importable_module_to_surface,
	set as Sets


private COMPILER_AMBIENT_TUPLE_IMPL_MODULE_PATH: String = "tuple"


union ImportIdentityResolution:
	ImportIdentityMissing
	ImportIdentityFound(String)
	ImportIdentityAmbiguous(List[String])


pure func importable_module_surfaces(
	modules: List[ImportableModule],
) -> List[ImportableModuleSurface]:
	modules.map(importable_module_to_surface)


pure func resolve_import_identity(
	index: ImportableModuleIndex,
	requested_path: String,
) -> ImportIdentityResolution:
	matches = importable_module_index_matching_paths(index, requested_path)

	match matches:
		[]:
			ImportIdentityMissing
		[identity]:
			ImportIdentityFound(identity)
		_:
			ImportIdentityAmbiguous(matches)


pure func matching_import_identities(
	index: ImportableModuleIndex,
	requested_path: String,
) -> List[String]:
	match resolve_import_identity(index, requested_path):
		ImportIdentityMissing:
			[]
		ImportIdentityFound(identity):
			[identity]
		ImportIdentityAmbiguous(identities):
			identities


private pure func decl_import_identities(
	index: ImportableModuleIndex,
	decls: List[ParsedDecl],
) -> List[String]:
	var identities: List[String] = []
	var seen: Set[String] = Sets.set()

	for decl in decls:
		match decl:
			ImportBlockParsedDecl(imports, _):
				for import_decl in imports:
					for module_identity in matching_import_identities(
						index,
						import_decl.module_path,
					):
						if not Sets.contains(seen, module_identity):
							identities = identities.append(module_identity)
							seen = Sets.add(seen, module_identity)
			PrivateParsedDecl(ImportBlockParsedDecl(imports, _), _):
				for import_decl in imports:
					for module_identity in matching_import_identities(
						index,
						import_decl.module_path,
					):
						if not Sets.contains(seen, module_identity):
							identities = identities.append(module_identity)
							seen = Sets.add(seen, module_identity)
			_:
				void

	identities


pure func program_import_identities(
	index: ImportableModuleIndex,
	program: ParsedProgram,
) -> List[String]:
	decl_import_identities(index, program.decls)


private pure func import_module_is_current(
	module_path: String,
	current_module_path: Option[String],
) -> Bool:
	match current_module_path:
		Some(current_path):
			module_path == current_path
		None:
			False


pure func importable_modules_for_program(
	index: ImportableModuleIndex,
	program: ParsedProgram,
	current_module_path: Option[String],
) -> List[ImportableModule]:
	var identities: List[String] = []

	for identity in program_import_identities(index, program):
		if not import_module_is_current(identity, current_module_path):
			identities = identities.append(identity)

	importable_module_index_modules_for_paths(index, identities)


pure func importable_module_dependency_closure(
	module_index: ImportableModuleIndex,
	roots: List[ImportableModule],
	current_module_path: Option[String],
) -> List[ImportableModule]:
	var identities: List[String] = []
	var seen: Set[String] = Sets.set()
	var index: Int = 0

	for root in roots:
		root_identity = importable_module_path(root)

		if not Sets.contains(seen, root_identity):
			identities = identities.append(root_identity)
			seen = Sets.add(seen, root_identity)

	while index < identities.length():
		current_identity = identities.get_or(index, "")

		for dependency in importable_module_index_dependency_paths(module_index, current_identity):
			if (
				not Sets.contains(seen, dependency)
				and not import_module_is_current(dependency, current_module_path)
			):
				identities = identities.append(dependency)
				seen = Sets.add(seen, dependency)

		index += 1

	importable_module_index_modules_for_paths(module_index, identities)


pure func reachable_importable_modules(
	program: ParsedProgram,
	index: ImportableModuleIndex,
	current_module_path: Option[String],
) -> List[ImportableModule]:
	direct_import_modules = importable_modules_for_program(index, program, current_module_path)
	importable_module_dependency_closure(index, direct_import_modules, current_module_path)


pure func with_ambient_impl_modules(
	modules: List[ImportableModule],
	index: ImportableModuleIndex,
	current_module_path: Option[String],
) -> List[ImportableModule]:
	match importable_module_index_find(index, COMPILER_AMBIENT_TUPLE_IMPL_MODULE_PATH):
		Some(module):
			if (
				not import_module_is_current(importable_module_path(module), current_module_path)
				and not modules.any(
					func(
						existing,
					): importable_module_path(existing) == importable_module_path(module),
				)
			):
				modules.append(module)
			else:
				modules
		None:
			modules
