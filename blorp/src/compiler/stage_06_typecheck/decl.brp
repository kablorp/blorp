	decls: List[TypedDecl],
	import_bindings: List[ImportBinding]
}


opaque type BodySubsetProgram = BodySubsetProgramRep


union BodySubsetProgramBuild:
	BodySubsetProgramReady(BodySubsetProgram)
	BodySubsetProgramRejected(List[String])


pure func body_subset_program_decls(subset: BodySubsetProgram) -> List[TypedDecl]:
	from_opaque BodySubsetProgram(subset).decls


pure func body_subset_program_import_bindings(subset: BodySubsetProgram) -> List[ImportBinding]:
	from_opaque BodySubsetProgram(subset).import_bindings


private record TypedForeignBlockResult {
	state: TypecheckState,
	decls: List[TypedDecl]
}


private pure func typed_program_from_decls(
	state: TypecheckState,
	program: ParsedProgram,
	decls: List[TypedDecl],
) -> TypedProgram:
	{
		source = program.source,
		decls = decls,
		diagnostics = program.diagnostics,
		type_definitions = typed_type_definitions(state, program),
		type_references = typed_type_references(state, program)
	}


private pure func typecheck_unfinalized_type_error(
	state: TypecheckState,
	label: String,
	typ: SemanticType,
) -> TypecheckState:
	if type_contains_meta(typ):
		typecheck_state_add_error(
			state,
			"internal typecheck error: typed program contains unfinalized inference meta in " + label + ": " + type_to_string(
				typ,
			),
		)
	else:
		state


private pure func typecheck_validate_optional_typed_type(
	state: TypecheckState,
	label: String,
	typ: Option[SemanticType],
) -> TypecheckState:
	match typ:
		Some(value):
			typecheck_unfinalized_type_error(state, label, value)
		None:
			state


private pure func typecheck_validate_typed_expr(
	state: TypecheckState,
	label: String,
	expr: TypedExpr,
) -> TypecheckState:
	if typed_expr_contains_meta(expr):
		typecheck_state_add_error(
			state,
			(
				"internal typecheck error: typed expression contains unfinalized inference meta "
				+ "in "
			) + label,
		)
	else:
		match typed_expr_type_error(expr):
			Some(message):
				typecheck_state_add_error(
					state,
					"internal typecheck error: typed expression has incoherent type info " + "in " + label + ": " + message,
				)
			None:
				state


private pure func typecheck_validate_typed_function_info(
	state: TypecheckState,
	label: String,
	info: TypedFunctionInfo,
) -> TypecheckState:
	var next = state
	var index: Int = 0

	for param_type in info.param_types:
		next = typecheck_unfinalized_type_error(
			next,
			label + " parameter " + index.to_string(),
			param_type,
		)
		index += 1

	next = typecheck_validate_optional_typed_type(
		next,
		label + " source return type",
		info.source_return_type,
	)
	next = typecheck_unfinalized_type_error(
		next,
		label + " semantic return type",
		info.semantic_return_type,
	)

	match info.body:
		Some(body):
			typecheck_validate_typed_expr(next, label + " body", body)
		None:
			next


private pure func typecheck_validate_typed_global_info(
	state: TypecheckState,
	label: String,
	info: TypedGlobalVarInfo,
) -> TypecheckState:
	with_binding = typecheck_unfinalized_type_error(
		state,
		label + " binding type",
		info.binding_type,
	)
	with_source = typecheck_validate_optional_typed_type(
		with_binding,
		label + " source type",
		info.source_type,
	)

	typecheck_validate_typed_expr(with_source, label + " value", info.value)


private pure func typecheck_validate_typed_record_info(
	state: TypecheckState,
	label: String,
	info: TypedRecordInfo,
) -> TypecheckState:
	var next = state

	for field in info.fields:
		next = typecheck_unfinalized_type_error(
			next,
			label + " field '" + field.name + "' source type",
			field.source_type,
		)
		next = typecheck_unfinalized_type_error(
			next,
			label + " field '" + field.name + "' semantic type",
			field.semantic_type,
		)

	next


private pure func typecheck_validate_typed_alias_info(
	state: TypecheckState,
	label: String,
	info: TypedTypeAliasInfo,
) -> TypecheckState:
	with_source = typecheck_unfinalized_type_error(
		state,
		label + " source target type",
		info.source_target_type,
	)

	typecheck_unfinalized_type_error(
		with_source,
		label + " semantic target type",
		info.semantic_target_type,
	)


private pure func typecheck_validate_typed_trait_info(
	state: TypecheckState,
	label: String,
	info: TypedTraitInfo,
) -> TypecheckState:
	var next = state

	for method in info.methods:
		var index: Int = 0

		for param_type in method.param_types:
			next = typecheck_unfinalized_type_error(
				next,
				label + " method '" + method.decl.name.text + "' parameter " + index.to_string(),
				param_type,
			)
			index += 1

		next = typecheck_unfinalized_type_error(
			next,
			label + " method '" + method.decl.name.text + "' return type",
			method.semantic_return_type,
		)

	next


private pure func typecheck_validate_typed_union_info(
	state: TypecheckState,
	label: String,
	info: TypedUnionInfo,
) -> TypecheckState:
	var next = state

	for variant in info.variants:
		var index: Int = 0

		for field in variant.fields:
			next = typecheck_unfinalized_type_error(
				next,
				label + " variant '" + variant.name + "' field " + index.to_string(),
				field,
			)
			index += 1

	next


private pure func typecheck_validate_typed_impl_info(
	state: TypecheckState,
	label: String,
	info: TypedImplInfo,
) -> TypecheckState:
	var next = typecheck_unfinalized_type_error(state, label + " target type", info.for_type)
	var index: Int = 0

	for method in info.methods:
		next = typecheck_validate_typed_function_info(
			next,
			label + " method " + index.to_string() + " '" + method.decl.name.text + "'",
			method,
		)
		index += 1

	next


private pure func typecheck_validate_typed_decl(
	state: TypecheckState,
	decl: TypedDecl,
) -> TypecheckState:
	match decl:
		TypedFunctionDecl(info):
			typecheck_validate_typed_function_info(
				state,
				"function '" + info.decl.name.text + "'",
				info,
			)
		TypedForeignFunctionDecl(info):
			var next = state
			var index: Int = 0

			for param_type in info.param_types:
				next = typecheck_unfinalized_type_error(
					next,
					"foreign function '" + info.decl.name.text + "' parameter " + index.to_string(),
					param_type,
				)
				index += 1

			typecheck_unfinalized_type_error(
				next,
				"foreign function '" + info.decl.name.text + "' return type",
				info.semantic_return_type,
			)
		TypedGlobalVarDecl(info):
			typecheck_validate_typed_global_info(
				state,
				"global '" + info.decl.name.text + "'",
				info,
			)
		TypedRecordDecl(info):
			typecheck_validate_typed_record_info(
				state,
				"record '" + info.decl.name.text + "'",
				info,
			)
		TypedTypeAliasDecl(info):
			typecheck_validate_typed_alias_info(
				state,
				"type alias '" + info.decl.name.text + "'",
				info,
			)
		TypedTraitDecl(info):
			typecheck_validate_typed_trait_info(state, "trait '" + info.decl.name.text + "'", info)
		TypedUnionDecl(info):
			typecheck_validate_typed_union_info(state, "union '" + info.decl.name.text + "'", info)
		TypedImplDecl(info):
			typecheck_validate_typed_impl_info(
				state,
				"impl '" + info.decl.trait_name.text + "'",
				info,
			)
		TypedPrivateDecl(inner):
			typecheck_validate_typed_decl(state, inner)
		TypedParsedDecl(_):
			state


pure func typecheck_validate_typed_program(
	result: TypecheckProgramResult,
) -> TypecheckProgramResult:
	var next_state = result.state

	for decl in result.program.decls:
		next_state = typecheck_validate_typed_decl(next_state, decl)

	{ result | state = next_state }


private pure func typed_record_field_from_parsed(
	state: TypecheckState,
	record_name: String,
	type_params: List[String],
	field: ParsedFieldDecl,
) -> TypedRecordFieldInfo:
	field_type = type_from_parsed_type_expr(field.type_expr)
	semantic_type = type_instantiate_type_params(
		type_params,
		canonical_annotation_type(state, field_type),
	)
	{
		name = field.name.text,
		source_type = field_type,
		semantic_type = semantic_type,
		definition_id = typecheck_state_find_source_definition_id(
			state,
			source_definition_key(
				typecheck_state_module_identity(state),
				FieldDefinition,
				field.name.text,
				Some(record_name),
				field.span,
			),
		),
		declaration_span = field.span,
		selection_span = field.name.span
	}


private pure func typed_record_from_parsed(
	state: TypecheckState,
	record_decl: ParsedRecordDecl,
) -> TypedRecordInfo:
	type_params = type_param_names(record_decl.type_params)
	{
		decl = record_decl,
		fields = record_decl.fields.map(
			func(
				field,
			): typed_record_field_from_parsed(state, record_decl.name.text, type_params, field),
		)
	}


private pure func typed_type_alias_from_parsed(
	state: TypecheckState,
	alias_decl: ParsedTypeAliasDecl,
) -> TypedTypeAliasInfo:
	source_target = type_from_parsed_type_expr(alias_decl.target)
	semantic_target = type_alias_semantic_target(state, alias_decl)
	{
		decl = alias_decl,
		source_target_type = source_target,
		semantic_target_type = semantic_target
	}


private pure func typed_trait_method_from_parsed(
	state: TypecheckState,
	type_params: List[String],
	method: ParsedTraitMethodDecl,
) -> TypedTraitMethodInfo:
	registered: TraitMethodSig = trait_method_from_parsed(method, type_params)
	{
		decl = method,
		param_types = registered.params.map(func(param_type): type_instantiate_type_params(
				type_params,
				canonical_annotation_type(state, param_type),
			)),
		semantic_return_type = type_instantiate_type_params(
			type_params,
			canonical_annotation_type(state, registered.return_type),
		)
	}


private pure func typed_trait_from_parsed(
	state: TypecheckState,
	trait_decl: ParsedTraitDecl,
) -> TypedTraitInfo:
	type_params = type_param_names(trait_decl.type_params)
	{
		decl = trait_decl,
		methods = trait_decl.methods.map(
			func(method): typed_trait_method_from_parsed(state, type_params, method),
		)
	}


private pure func typed_union_variant_from_parsed(
	state: TypecheckState,
	parent_type: String,
	type_params: List[String],
	variant: ParsedVariantDecl,
	fallback_tag: Int,
) -> TypedUnionVariantInfo:
	(fields, tag, def_id) = match module_view_accepted_union_authority(state.module_view):
		Some(index):
			match accepted_union_find_constructor_for_parent(index, parent_type, variant.name.text):
				Some(ctor):
					(ctor.field_types, ctor.tag, Some(ctor.constructor_id))
				None:
					(
						variant.fields.map(func(field):
							canonical_annotation_type(state, type_from_parsed_type_expr(field))
						),
						fallback_tag,
						None,
					)
		None:
			match env_get_constructor_for_parent(state.env, parent_type, variant.name.text):
				Some(ctor):
					(ctor.field_types, ctor.tag, Some(ctor.constructor_id))
				None:
					(
						variant.fields.map(func(field):
							canonical_annotation_type(state, type_from_parsed_type_expr(field))
						),
						fallback_tag,
						None,
					)

	{
		name = variant.name.text,
		fields = fields.map(func(field): type_instantiate_type_params(type_params, field)),
		tag = tag,
		def_id = def_id,
		declaration_span = variant.span,
		selection_span = variant.name.span
	}


private pure func typed_union_from_parsed(
	state: TypecheckState,
	union_decl: ParsedUnionDecl,
) -> TypedUnionInfo:
	type_params = type_param_names(union_decl.type_params)
	typed_variants: List[TypedUnionVariantInfo] = union_decl.variants
		.enumerate()
		.map(func(entry):
			typed_union_variant_from_parsed(
				state,
				union_decl.name.text,
				type_params,
				entry[1],
				entry[0],
			)
		)

	{
		decl = union_decl,
		variants = typed_variants
	}


private pure func type_from_optional_parsed_type_expr(
	type_expr: Option[ParsedTypeExpr],
) -> SemanticType:
	match type_expr:
		Some(typ):
			type_from_parsed_type_expr(typ)
		None:
			TYPE_VOID


private pure func param_name_from_parsed(param: ParsedParam) -> Option[String]:
	match param.binder:
		ParsedParamNameBinder(name):
			Some(name.text)
		ParsedParamWildcardBinder(_):
			None
		ParsedParamTupleBinder(_, _):
			None


private pure func dim_constraint_from_parsed(
	constraint: ParsedDimConstraint,
) -> (SemanticType, SemanticType):
	(type_from_parsed_type_expr(constraint.left), type_from_parsed_type_expr(constraint.right))


private pure func canonical_dim_constraint_from_parsed(
	state: TypecheckState,
	constraint: ParsedDimConstraint,
) -> (SemanticType, SemanticType):
	(
		canonical_annotation_type(state, type_from_parsed_type_expr(constraint.left)),
		canonical_annotation_type(state, type_from_parsed_type_expr(constraint.right)),
	)


private pure func purity_from_parsed(is_pure: Bool) -> Purity:
	if is_pure:
		Pure
	else:
		Impure


private pure func annotation_is_debug_only(annotation: ParsedFunctionAnnotation) -> Bool:
	match annotation:
		ParsedDebugOnlyAnnotation:
			True
		_:
			False


private pure func annotation_is_tail_recursive(annotation: ParsedFunctionAnnotation) -> Bool:
	match annotation:
		ParsedTailRecursiveAnnotation:
			True
		_:
			False


private pure func annotation_is_no_copy(annotation: ParsedFunctionAnnotation) -> Bool:
	match annotation:
		ParsedNoCopyAnnotation:
			True
		_:
			False


private pure func annotation_has_ordinary_resource_result(
	annotation: ParsedFunctionAnnotation,
) -> Bool:
	match annotation:
		ParsedResourceResultOrdinaryAnnotation:
			True
		_:
			False


private pure func function_builtin_resource_result_policy(
	body: Option[ParsedExpr],
) -> ResourceResultPolicy:
	match parsed_function_body_kind(body):
		ParsedFunctionBuiltinBody(Some(builtin_name)):
			builtin_resource_result_policy(builtin_name)
		_:
			ResourceResultDependent


private pure func type_contains_scoped_dependency_carrier(typ: SemanticType) -> Bool:
	match typ:
		SemanticNamedType(name, args):
			(
				is_one_shot_stream_type_name(name)
				or is_resource_source_type_name(name)
				or args.any(type_contains_scoped_dependency_carrier)
			)
		SemanticFunctionType(_, params, return_type):
			(
				params.any(type_contains_scoped_dependency_carrier)
				or type_contains_scoped_dependency_carrier(return_type)
			)
		SemanticArrayType(element, dims):
			(
				type_contains_scoped_dependency_carrier(element)
				or dims.any(type_contains_scoped_dependency_carrier)
			)
		SemanticTupleType(elements):
			elements.any(type_contains_scoped_dependency_carrier)
		SemanticRangeType(inner):
			type_contains_scoped_dependency_carrier(inner)
		SemanticDimOpType(_, left, right):
			(
				type_contains_scoped_dependency_carrier(left)
				or type_contains_scoped_dependency_carrier(right)
			)
		_:
			False


private pure func function_resource_arg_policy(
	state: TypecheckState,
	param_types: List[SemanticType],
	annotations: List[ParsedFunctionAnnotation],
	body: Option[ParsedExpr],
) -> ResourceArgPolicy:
	if not parsed_function_body_is_builtin(body):
		RejectResourceArgs
	else:
		var has_resource_param: Bool = False
		var has_scoped_dependency_param: Bool = False

		for param_type in param_types:
			if resource_type_scan_contains(
				resource_type_scan_context(state.env, state.known_type_index),
				param_type,
			):
				has_resource_param = True

			if type_contains_scoped_dependency_carrier(param_type):
				has_scoped_dependency_param = True

			if has_resource_param and has_scoped_dependency_param:
				break

		if has_resource_param or has_scoped_dependency_param:
			result_policy: ResourceResultPolicy = if annotations.any(
				annotation_has_ordinary_resource_result,
			):
				ResourceResultOrdinary
			else:
				function_builtin_resource_result_policy(body)

			AllowResourceArgs(result_policy)
		else:
			RejectResourceArgs


private pure func validate_resource_result_annotation(
	state: TypecheckState,
	name: String,
	param_types: List[SemanticType],
	return_type: SemanticType,
	annotations: List[ParsedFunctionAnnotation],
	body: Option[ParsedExpr],
) -> TypecheckState:
	if not annotations.any(annotation_has_ordinary_resource_result):
		state
	else if not parsed_function_body_is_builtin(body):
		typecheck_state_add_error(
			state,
			(
				"@resource_result_ordinary can only be used on builtin resource operation "
				+ "declarations"
			),
		)
	else if resource_type_scan_contains(
		resource_type_scan_context(state.env, state.known_type_index),
		return_type,
	):
		typecheck_state_add_error(
			state,
			"@resource_result_ordinary cannot be used on builtin '" + name + "' because its return type contains a resource",
		)
	else:
		var has_resource_param: Bool = False
		var has_scoped_dependency_param: Bool = False

		for param_type in param_types:
			if resource_type_scan_contains(
				resource_type_scan_context(state.env, state.known_type_index),
				param_type,
			):
				has_resource_param = True

			if type_contains_scoped_dependency_carrier(param_type):
				has_scoped_dependency_param = True

			if has_resource_param or has_scoped_dependency_param:
				break

		if not (has_resource_param or has_scoped_dependency_param):
			typecheck_state_add_error(
				state,
				"@resource_result_ordinary requires builtin '" + name + "' to have a direct resource or scoped dependency parameter",
			)
		else:
			state


private pure func validate_resource_signature_boundary(
	state: TypecheckState,
	name: String,
	params: List[ParsedParam],
	param_types: List[SemanticType],
	return_type: SemanticType,
	body: Option[ParsedExpr],
) -> TypecheckState:
	if params.length() != param_types.length():
		typecheck_state_add_error(
			state,
			(
				"internal typecheck error: semantic parameter count does not match parsed "
				+ "parameter count for function '"
			) + name + "'",
		)
	else if parsed_function_body_is_builtin(body):
		state
	else:
		var next = state
		var param_index: Int = 0

		for param_type in param_types:
			if resource_type_scan_contains(
				resource_type_scan_context(next.env, next.known_type_index),
				param_type,
			):
				param_name: String = match params.get(param_index):
					Some(param):
						param_name_from_parsed(param).get_or("_")
					None:
						"_"

				next = typecheck_state_add_error(
					next,
					"Function '" + name + "' parameter '" + param_name + "' cannot contain a resource type",
				)

			param_index += 1

		if resource_type_scan_contains(
			resource_type_scan_context(next.env, next.known_type_index),
			return_type,
		):
			typecheck_state_add_error(
				next,
				"Function '" + name + "' return type cannot contain a resource type",
			)
		else:
			next


private pure func callable_key_from_span(
	state: TypecheckState,
	name: String,
	span: SourceSpan,
) -> FuncCallableKey:
	func_callable_key(typecheck_state_module_identity(state), name, span)


private pure func trait_method_from_parsed(
	method: ParsedTraitMethodDecl,
	type_params: List[String],
) -> TraitMethodSig:
	name: String = method.name.text
	var params: List[SemanticType] = []

	for param in method.params:
		match param.type_expr.map(type_from_parsed_type_expr):
			Some(typ):
				params = params.append(type_instantiate_type_params(type_params, typ))
			None:
				void

	return_type: SemanticType = type_instantiate_type_params(
		type_params,
		type_from_optional_parsed_type_expr(method.return_type),
	)
	is_pure: Bool = method.is_pure
	has_default: Bool = method.body.is_some()
	param_names: List[Option[String]] = method.params.map(param_name_from_parsed)

	trait_method_sig_with_details(name, params, return_type, is_pure, has_default, param_names)


private pure func typecheck_prescan_decl_top_level_names(
	state: TypecheckState,
	decl: ParsedDecl,
) -> TypecheckState:
	match decl:
		RecordParsedDecl(record_decl):
			typecheck_state_remember_top_level_name(state, record_decl.name.text, TopLevelType)
		UnionParsedDecl(union_decl):
			var next = typecheck_state_remember_top_level_name(
				state,
				union_decl.name.text,
				TopLevelType,
			)

			for variant in union_decl.variants:
				next = typecheck_state_remember_top_level_name(
					next,
					variant.name.text,
					TopLevelConstructor,
				)

			next
		BuiltinTypeParsedDecl(type_decl):
			typecheck_state_remember_top_level_name(state, type_decl.name.text, TopLevelType)
		TypeAliasParsedDecl(alias_decl):
			typecheck_state_remember_top_level_name(state, alias_decl.name.text, TopLevelType)
		FunctionParsedDecl(function_decl):
			typecheck_state_remember_top_level_name(
				state,
				function_decl.name.text,
				TopLevelFunction,
			)
		VarParsedDecl(var_decl):
			typecheck_state_remember_top_level_name(state, var_decl.name.text, TopLevelVariable)
		TraitParsedDecl(trait_decl):
			typecheck_state_remember_top_level_name(state, trait_decl.name.text, TopLevelTrait)
		ForeignBlockParsedDecl(_, functions, _):
			var next = state

			for function_decl in functions:
				next = typecheck_state_remember_top_level_name(
					next,
					function_decl.name.text,
					TopLevelFunction,
				)

			next
		PrivateParsedDecl(inner, _):
			typecheck_prescan_decl_top_level_names(state, inner)
		ImportBlockParsedDecl(_, _):
			state
		ImplParsedDecl(_):
			state
		ParsedErrorDecl(_):
			state


pure func typecheck_prescan_decls(state: TypecheckState, decls: List[ParsedDecl]) -> TypecheckState:
	var next = state

	for decl in decls:
		next = typecheck_prescan_decl_known_type_names(next, decl)
		next = typecheck_prescan_decl_top_level_names(next, decl)

	next


pure func typecheck_prescan_program(
	state: TypecheckState,
	program: ParsedProgram,
) -> TypecheckState:
	typecheck_prescan_decls(
		typecheck_state_scope_to_program(state, program),
		program.decls,
	)


pure func typecheck_register_program_import_decls(
	state: TypecheckState,
	program: ParsedProgram,
) -> TypecheckState:
	register_program_import_syntax(
		typecheck_state_scope_to_program(state, program),
		program,
	)


private pure func claim_global_definition_id(
	state: TypecheckState,
	var_decl: ParsedVarDecl,
) -> (TypecheckState, Option[Int]):
	definition_key = source_definition_key(
		typecheck_state_module_identity(state),
		GlobalDefinition,
		var_decl.name.text,
		None,
		var_decl.span,
	)

	match typecheck_state_claim_source_definition_id(state, definition_key):
		DefinitionIdClaimed(next, found):
			(next, Some(found))
		DefinitionIdMissing(next):
			(next, None)


private pure func register_var_decl_with_type(
	state: TypecheckState,
	module_path: String,
	var_decl: ParsedVarDecl,
	var_type: SemanticType,
	source_type: Option[SemanticType],
	definition_id: Option[Int],
) -> TypecheckState:
	env: Env = env_add_var_with_module_details(
		state.env,
		var_decl.name.text,
		var_type,
		source_type,
		var_mutability(var_decl.is_mutable),
		LetBinding,
		UNREFINED_BINDING,
		Some(module_path),
		definition_id,
	)

	{ state | env = env }


private pure func register_var_decl(
	state: TypecheckState,
	module_path: String,
	var_decl: ParsedVarDecl,
) -> TypecheckState:
	(claimed_state, definition_id) = claim_global_definition_id(state, var_decl)

	source_type: Option[SemanticType] = match var_decl.type_expr:
		Some(type_expr):
			Some(type_from_parsed_type_expr(type_expr))
		None:
			None

	var_type: SemanticType = canonical_annotation_type(
		claimed_state,
		type_from_optional_parsed_type_expr(var_decl.type_expr),
	)

	register_var_decl_with_type(
		claimed_state,
		module_path,
		var_decl,
		var_type,
		source_type,
		definition_id,
	)


private pure func register_function_signature(
	state: TypecheckState,
	name: String,
	params: List[ParsedParam],
	return_type: SemanticType,
	type_params: List[ParsedTypeParamDecl],
	dim_constraints: List[ParsedDimConstraint],
	is_pure: Bool,
	annotations: List[ParsedFunctionAnnotation],
	body: Option[ParsedExpr],
	span: SourceSpan,
	module_path: Option[String],
	origin: FuncOrigin,
) -> TypecheckState:
	declared_type_param_names = type_param_names(type_params)
	param_types: List[SemanticType] = params
		.map(func(param): type_from_optional_parsed_type_expr(param.type_expr))
		.map(
			func(
				param_type,
			): canonical_function_annotation_type(state, declared_type_param_names, param_type),
		)
	resolved_return_type: SemanticType = canonical_function_annotation_type(
		state,
		declared_type_param_names,
		return_type,
	)
	semantic_dim_constraints: List[(SemanticType, SemanticType)] = dim_constraints.map(
		func(constraint): canonical_dim_constraint_from_parsed(state, constraint),
	)

	register_function_signature_with_semantic_types(
		state,
		name,
		params,
		param_types,
		resolved_return_type,
		type_params,
		semantic_dim_constraints,
		is_pure,
		annotations,
		body,
		span,
		module_path,
		origin,
	)


private pure func type_param_candidate_name_is_valid(name: String) -> Bool:
	if name == "#_":
		True
	else:
		base = if name.length() > 1 and name.get_or(0, ' ') == '#':
			name.substring(1, name.length())
		else:
			name

		if base.length() == 0:
			False
		else:
			first = base.get_or(0, ' ')
			var valid = first >= 'A' and first <= 'Z'
			var index: Int = 1

			while valid and index < base.length():
				ch = base.get_or(index, ' ')
				valid = (
					ch >= 'A' and ch <= 'Z'
					or ch >= 'a' and ch <= 'z'
					or ch >= '0' and ch <= '9'
				)

				index += 1

			valid


private pure func type_param_candidates_from_types(types: List[SemanticType]) -> List[String]:
	types.flat_map(type_param_candidates)


private pure func type_param_candidates(typ: SemanticType) -> List[String]:
	match typ:
		SemanticTypeVar(name):
			[name]
		SemanticNamedType(name, args):
			if args.length() == 0 and type_param_candidate_name_is_valid(name):
				[name]
			else:
				type_param_candidates_from_types(args)
		SemanticArrayType(element, dims):
			type_param_candidates(element).concat(type_param_candidates_from_types(dims))
		SemanticFunctionType(_, params, return_type):
			type_param_candidates_from_types(params).concat(type_param_candidates(return_type))
		SemanticTupleType(elements):
			type_param_candidates_from_types(elements)
		SemanticRangeType(inner):
			type_param_candidates(inner)
		SemanticDimOpType(_, left, right):
			type_param_candidates(left).concat(type_param_candidates(right))
		_:
			[]


private pure func state_has_type_name(state: TypecheckState, name: String) -> Bool:
	has_alias = match module_view_accepted_alias_authority(state.module_view):
		Some(authority):
			accepted_alias_contains(authority, name)
		None:
			(
				env_get_alias(state.env, name).is_some()
				or env_get_opaque_alias(state.env, name).is_some()
			)

	has_record = match module_view_accepted_record_authority(state.module_view):
		Some(authority):
			accepted_record_contains(authority, name)
		None:
			env_get_record(state.env, name).is_some()

	has_union = match module_view_accepted_union_authority(state.module_view):
		Some(index):
			accepted_union_contains(index, name)
		None:
			env_get_type_decl(state.env, name).is_some()

	(
		is_global_abi_type_name(name)
		or typecheck_state_has_known_type_name(state, name)
		or has_union
		or has_record
		or has_alias
	)


private pure func effective_bound_type_params(
	state: TypecheckState,
	declared: List[ParsedTypeParamDecl],
	func_type: SemanticType,
) -> List[BoundTypeParam]:
	var result = bound_type_params_from_parsed(declared)
	var seen = result.map(func(param): param.name)

	for name in type_param_candidates(func_type):
		if (
			name != "#_"
			and not seen.contains(name)
			and not state_has_type_name(state, name)
		):
			seen = seen.append(name)
			result = result.append(make_bound_type_param(name, []))

	result


private pure func effective_function_type_params(
	state: TypecheckState,
	function_decl: ParsedFunctionDecl,
) -> List[BoundTypeParam]:
	declared_type_param_names = type_param_names(function_decl.type_params)
	param_types = function_decl.params
		.map(func(param): type_from_optional_parsed_type_expr(param.type_expr))
		.map(
			func(
				param_type,
			): canonical_function_annotation_type(state, declared_type_param_names, param_type),
		)
	return_type = canonical_return_type(
		state,
		declared_type_param_names,
		function_decl.return_type,
	).get_or(TYPE_VOID)
	effective_bound_type_params(
		state,
		function_decl.type_params,
		SemanticFunctionType(function_decl.is_pure, param_types, return_type),
	)


private pure func function_body_signature_from_annotations(
	state: TypecheckState,
	function_decl: ParsedFunctionDecl,
	callable_id: Option[Int],
) -> FunctionBodySignature:
	effective_type_params = effective_function_type_params(state, function_decl)
	effective_type_param_names = effective_type_params.map(func(param): param.name)
	declared_type_param_names = type_param_names(function_decl.type_params)
	param_types = function_decl.params
		.map(func(param): type_from_optional_parsed_type_expr(param.type_expr))
		.map(func(param_type): type_instantiate_type_params(
				effective_type_param_names,
				canonical_function_annotation_type(state, declared_type_param_names, param_type),
			))

	semantic_return_type = match canonical_return_type(
		state,
		declared_type_param_names,
		function_decl.return_type,
	):
		Some(return_type):
			type_instantiate_type_params(effective_type_param_names, return_type)
		None:
			TYPE_VOID

	{
		callable_id = callable_id,
		effective_type_params = effective_type_params,
		param_types = param_types,
		semantic_return_type = semantic_return_type
	}


private pure func function_body_signature(
	state: TypecheckState,
	function_decl: ParsedFunctionDecl,
) -> FunctionBodySignature:
	callable_id = typecheck_state_find_func_callable_id(
		state,
		callable_key_from_span(state, function_decl.name.text, function_decl.span),
	)

	match callable_id:
		Some(def_id):
			entry = match module_view_accepted_callable_authority(state.module_view):
				Some(authority):
					accepted_callable_find_owner_definition_id(authority, def_id)
				None:
					var found: Option[OverloadEntry] = None

					-- Standalone tools construct provisional declarations without an
					-- accepted graph. Keep that path Env-backed, but do not expose an
					-- exact graph lookup API to ordinary accepted body checking.
					for symbol in env_symbols_named(state.env, function_decl.name.text):
						match symbol.kind:
							FuncSymbolKind(info):
								if info.callable_id == def_id and found.is_none():
									found = Some(overload_entry_from_func_symbol(info))
							_:
								void

					found

			match entry:
				Some(found):
					match found.func_type:
						SemanticFunctionType(_, param_types, return_type):
							{
								callable_id = callable_id,
								effective_type_params = found.type_params,
								param_types = param_types,
								semantic_return_type = return_type
							}
						_:
							function_body_signature_from_annotations(
								state,
								function_decl,
								callable_id,
							)
				None:
					function_body_signature_from_annotations(state, function_decl, callable_id)
		None:
			function_body_signature_from_annotations(state, function_decl, None)


private pure func loop_producer_from_expr(expr: ParsedExpr) -> Option[LoopProducer]:
	match expr:
		ParsedBuiltinExpr(Some("tensor.indices"), _):
			Some(LoopProducerIndices)
		ParsedBuiltinExpr(Some("tensor.enumerate"), _):
			Some(LoopProducerEnumerate)
		ParsedBuiltinExpr(Some("tensor.enumerate2"), _):
			Some(LoopProducerEnumerate2)
		ParsedBuiltinExpr(Some("tensor.windows"), _):
			Some(LoopProducerWindows)
		ParsedBlockExpr(items, _):
			if items.length() == 1:
				match items.get(0):
					Some(item):
						loop_producer_from_expr(item)
					None:
						None
			else:
				None
		_:
			None


private pure func loop_producer_from_body(body: Option[ParsedExpr]) -> Option[LoopProducer]:
	match body:
		Some(expr):
			loop_producer_from_expr(expr)
		None:
			None


private pure func register_function_signature_with_semantic_types(
	state: TypecheckState,
	name: String,
	params: List[ParsedParam],
	param_types: List[SemanticType],
	resolved_return_type: SemanticType,
	type_params: List[ParsedTypeParamDecl],
	dim_constraints: List[(SemanticType, SemanticType)],
	is_pure: Bool,
	annotations: List[ParsedFunctionAnnotation],
	body: Option[ParsedExpr],
	span: SourceSpan,
	module_path: Option[String],
	origin: FuncOrigin,
) -> TypecheckState:
	source_func_type: SemanticType = SemanticFunctionType(
		is_pure,
		param_types,
		resolved_return_type,
	)
	effective_type_params = effective_bound_type_params(state, type_params, source_func_type)
	type_param_names = effective_type_params.map(func(param): param.name)
	semantic_param_types = param_types.map(
		func(param): type_instantiate_type_params(type_param_names, param),
	)
	semantic_return_type = type_instantiate_type_params(type_param_names, resolved_return_type)
	func_type: SemanticType = SemanticFunctionType(
		is_pure,
		semantic_param_types,
		semantic_return_type,
	)
	semantic_dim_constraints = dim_constraints.map(
		func(
			constraint,
		): (
			type_instantiate_type_params(type_param_names, constraint[0]),
			type_instantiate_type_params(type_param_names, constraint[1]),
		),
	)
	with_resource_result = validate_resource_result_annotation(
		state,
		name,
		semantic_param_types,
		semantic_return_type,
		annotations,
		body,
	)
	with_resource_boundary = validate_resource_signature_boundary(
		with_resource_result,
		name,
		params,
		semantic_param_types,
		semantic_return_type,
		body,
	)
	resource_arg_policy = function_resource_arg_policy(
		with_resource_boundary,
		semantic_param_types,
		annotations,
		body,
	)
	loop_producer = loop_producer_from_body(body)

	callable_key = callable_key_from_span(with_resource_boundary, name, span)

	match typecheck_state_claim_func_callable_id(with_resource_boundary, callable_key):
		DefinitionIdClaimed(with_id, def_id):
			register_function_with_id(
				with_id,
				def_id,
				name,
				func_type,
				effective_type_params,
				params,
				is_pure,
				origin,
				resource_arg_policy,
				module_path,
				semantic_dim_constraints,
				loop_producer,
				annotations,
			)
		DefinitionIdMissing(with_error):
			with_error


private pure func register_function_with_id(
	state: TypecheckState,
	def_id: Int,
	name: String,
	func_type: SemanticType,
	effective_type_params: List[BoundTypeParam],
	params: List[ParsedParam],
	is_pure: Bool,
	origin: FuncOrigin,
	resource_arg_policy: ResourceArgPolicy,
	module_path: Option[String],
	dim_constraints: List[(SemanticType, SemanticType)],
	loop_producer: Option[LoopProducer],
	annotations: List[ParsedFunctionAnnotation],
) -> TypecheckState:
	env: Env = env_add_func_with_info(
		state.env,
		name,
		func_symbol(
			def_id,
			func_type,
			effective_type_params,
			params.map(param_name_from_parsed),
			purity_from_parsed(is_pure),
			origin,
			resource_arg_policy,
			module_path,
			dim_constraints,
			loop_producer,
			annotations.any(annotation_is_debug_only),
		),
	)
	with_env = { state | env = env }
	with_env


private union CallableHeaderRegistration:
	LocalCallableHeaderRegistration(String)
	ImportedCallableHeaderRegistration(String)


private record PreparedCallableHeader {
	state: TypecheckState,
	entry: Option[OverloadEntry]
}


-- These event values are mirrored by the profile-only runtime counter schema
-- in blorp/src/lib/runtime/native/runtime.c. They are intentionally local to callable header
-- registration so ordinary typechecking never receives a new state field.
private CALLABLE_HEADER_PROFILE_SOURCE_HEADERS: Int = 1

private CALLABLE_HEADER_PROFILE_FOREIGN_HEADERS: Int = 2

private CALLABLE_HEADER_PROFILE_PARAMETER_CONVERSIONS: Int = 3

private CALLABLE_HEADER_PROFILE_RETURN_CONVERSIONS: Int = 4

private CALLABLE_HEADER_PROFILE_DIMENSION_SIDE_CONVERSIONS: Int = 5

private CALLABLE_HEADER_PROFILE_TYPE_PARAMETER_CANDIDATE_TRAVERSALS: Int = 6

private CALLABLE_HEADER_PROFILE_RESOURCE_VALIDATIONS: Int = 7

private CALLABLE_HEADER_PROFILE_ID_CLAIMS: Int = 8


-- The existing black-box builtin is a profile-window marker here: the runtime
-- recognizes only these two private wrapper names while profiling is active.
-- Keeping the compiler-side calls on an established builtin also preserves
-- bootstrap compatibility.
private pure func profile_callable_header_event(event: Int) -> Int:
	builtin("blorp_black_box_int")


private pure func profile_callable_header_enter(definition_id: Int) -> Int:
	builtin("blorp_black_box_int")


private pure func callable_header_semantic_type(
	type_headers: TypeHeaderGraph,
	owner_identity: ModuleIdentity,
	registration: CallableHeaderRegistration,
	shape: ResolvedTypeShape,
) -> Option[SemanticType]:
	match registration:
		LocalCallableHeaderRegistration(module_path):
			local_semantic_type_from_resolved_shape(
				type_headers,
				owner_identity,
				module_path,
				shape,
			)
		ImportedCallableHeaderRegistration(module_path):
			imported_semantic_type_from_resolved_shape(
				type_headers,
				owner_identity,
				module_path,
				shape,
			)


private pure func callable_header_parameter_name(binder: CallableParameterBinder) -> Option[String]:
	match binder:
		NamedParameter(name):
			Some(name)
		WildcardParameter | TupleParameter(_):
			None


private pure func bound_trait_identity(id: TraitId) -> BoundTraitIdentity:
	{
		module_identity = trait_id_module_identity(id),
		definition_id = trait_id_definition_id(id),
		name = trait_id_name(id),
		span = trait_id_source_span(id),
		compiler_builtin = trait_id_is_compiler_builtin(id)
	}


private pure func callable_header_bound_type_params(
	header: CallableHeader,
	declared: List[ParsedTypeParamDecl],
	func_type: SemanticType,
	dim_constraints: List[(SemanticType, SemanticType)],
	count_profile_candidates: Bool,
) -> List[BoundTypeParam]:
	-- Named variadic dimensions preserve relationships inside a signature, but
	-- they are shape wildcards rather than parameters that callers specialize.
	var generic_names = declared.map(func(param): param.name.text)

	if count_profile_candidates:
		_ = profile_callable_header_event(
			CALLABLE_HEADER_PROFILE_TYPE_PARAMETER_CANDIDATE_TRAVERSALS,
		)

	for name in type_param_candidates(func_type):
		if not generic_names.contains(name):
			generic_names = generic_names.append(name)

	for constraint in dim_constraints:
		if count_profile_candidates:
			_ = profile_callable_header_event(
				CALLABLE_HEADER_PROFILE_TYPE_PARAMETER_CANDIDATE_TRAVERSALS,
			)
			_ = profile_callable_header_event(
				CALLABLE_HEADER_PROFILE_TYPE_PARAMETER_CANDIDATE_TRAVERSALS,
			)

		for name in type_param_candidates(
			constraint[0],
		).concat(type_param_candidates(constraint[1])):
			if not generic_names.contains(name):
				generic_names = generic_names.append(name)

	var result: List[BoundTypeParam] = []

	for parameter in callable_header_parameters(header):
		name = callable_type_parameter_id_name(callable_type_parameter_id(parameter))

		if generic_names.contains(name):
			result = result.append(
				make_resolved_bound_type_param(
					name,
					callable_type_parameter_bounds(parameter).map(bound_trait_identity),
				),
			)

	result


private pure func prepare_accepted_callable_header(
	state: TypecheckState,
	type_headers: TypeHeaderGraph,
	header: CallableHeader,
	registration: CallableHeaderRegistration,
) -> PreparedCallableHeader:
	id = callable_header_id(header)
	owner_identity = callable_id_module_identity(id)
	signature = callable_header_signature(header)
	profile_callable_header_enter(callable_id_definition_id(id))

	match callable_header_source(header):
		FunctionCallableHeaderSource(_):
			profile_callable_header_event(CALLABLE_HEADER_PROFILE_SOURCE_HEADERS)
		ForeignCallableHeaderSource(_):
			profile_callable_header_event(CALLABLE_HEADER_PROFILE_FOREIGN_HEADERS)

	var param_types: List[SemanticType] = []
	var param_names: List[Option[String]] = []
	var conversion_failed: Bool = False

	for parameter in callable_signature_parameters(signature):
		if not conversion_failed:
			profile_callable_header_event(CALLABLE_HEADER_PROFILE_PARAMETER_CONVERSIONS)

			match callable_header_semantic_type(
				type_headers,
				owner_identity,
				registration,
				parameter.typ,
			):
				Some(typ):
					param_types = param_types.append(typ)
					param_names = param_names.append(
						callable_header_parameter_name(parameter.binder),
					)
				None:
					conversion_failed = True

	profile_callable_header_event(CALLABLE_HEADER_PROFILE_RETURN_CONVERSIONS)
	return_type = callable_header_semantic_type(
		type_headers,
		owner_identity,
		registration,
		callable_signature_return_type(signature),
	)
	var dim_constraints: List[(SemanticType, SemanticType)] = []

	for constraint in callable_header_dimension_constraints(header):
		if not conversion_failed:
			profile_callable_header_event(CALLABLE_HEADER_PROFILE_DIMENSION_SIDE_CONVERSIONS)
			left = callable_header_semantic_type(
				type_headers,
				owner_identity,
				registration,
				constraint[0],
			)
			profile_callable_header_event(CALLABLE_HEADER_PROFILE_DIMENSION_SIDE_CONVERSIONS)
			right = callable_header_semantic_type(
				type_headers,
				owner_identity,
				registration,
				constraint[1],
			)

			match left:
				Some(left_type):
					match right:
						Some(right_type):
							dim_constraints = dim_constraints.append((left_type, right_type))
						None:
							conversion_failed = True
				None:
					conversion_failed = True

	match return_type:
		None:
			{
				state = typecheck_state_add_error(
					state,
					"internal typecheck error: accepted callable header could not be prepared",
				),
				entry = None
			}
		Some(resolved_return_type):
			if conversion_failed:
				{
					state = typecheck_state_add_error(
						state,
						"internal typecheck error: accepted callable header could not be prepared",
					),
					entry = None
				}
			else:
				match callable_header_source(header):
					FunctionCallableHeaderSource(decl):
						profile_callable_header_event(CALLABLE_HEADER_PROFILE_RESOURCE_VALIDATIONS)
						with_resource_result = validate_resource_result_annotation(
							state,
							decl.name.text,
							param_types,
							resolved_return_type,
							decl.annotations,
							decl.body,
						)
						profile_callable_header_event(CALLABLE_HEADER_PROFILE_RESOURCE_VALIDATIONS)
						with_resource_boundary = validate_resource_signature_boundary(
							with_resource_result,
							decl.name.text,
							decl.params,
							param_types,
							resolved_return_type,
							decl.body,
						)
						resource_arg_policy = function_resource_arg_policy(
							with_resource_boundary,
							param_types,
							decl.annotations,
							decl.body,
						)
						callable_key = callable_key_from_span(
							with_resource_boundary,
							decl.name.text,
							decl.span,
						)

						profile_callable_header_event(CALLABLE_HEADER_PROFILE_ID_CLAIMS)

						match typecheck_state_claim_func_callable_id(
							with_resource_boundary,
							callable_key,
						):
							DefinitionIdMissing(with_error):
								{
									state = with_error,
									entry = None
								}
							DefinitionIdClaimed(with_id, definition_id):
								if definition_id != callable_id_definition_id(id):
									{
										state = typecheck_state_add_error(
											with_id,
											(
												"internal typecheck error: callable header definition ID does not match its "
												+ "reserved module ID"
											),
										),
										entry = None
									}
								else:
									func_type = SemanticFunctionType(
										callable_signature_is_pure(signature),
										param_types,
										resolved_return_type,
									)
									{
										state = with_id,
										entry = Some({
											def_id = definition_id,
											func_type = func_type,
											type_params = callable_header_bound_type_params(
												header,
												decl.type_params,
												func_type,
												dim_constraints,
												True,
											),
											param_names = param_names,
											purity = purity_from_parsed(decl.is_pure),
											origin = UserDefinedFunc,
											resource_args = resource_arg_policy,
											module_path = None,
											dim_constraints = dim_constraints,
											loop_producer = loop_producer_from_body(decl.body),
											debug_only = decl.annotations.any(
												annotation_is_debug_only,
											),
										})
									}
					ForeignCallableHeaderSource(decl):
						next = if typecheck_state_allows_foreign(state):
							state
						else:
							message: String = if typecheck_state_is_stdlib(state):
								"'foreign' declarations cannot be used in the standard library"
							else:
								"'foreign' declarations cannot be used in source packages"

							typecheck_state_add_error(state, message)

						profile_callable_header_event(CALLABLE_HEADER_PROFILE_RESOURCE_VALIDATIONS)
						with_resource_result = validate_resource_result_annotation(
							next,
							decl.name.text,
							param_types,
							resolved_return_type,
							decl.annotations,
							None,
						)
						profile_callable_header_event(CALLABLE_HEADER_PROFILE_RESOURCE_VALIDATIONS)
						with_resource_boundary = validate_resource_signature_boundary(
							with_resource_result,
							decl.name.text,
							decl.params,
							param_types,
							resolved_return_type,
							None,
						)
						callable_key = callable_key_from_span(
							with_resource_boundary,
							decl.name.text,
							decl.span,
						)

						profile_callable_header_event(CALLABLE_HEADER_PROFILE_ID_CLAIMS)

						match typecheck_state_claim_func_callable_id(
							with_resource_boundary,
							callable_key,
						):
							DefinitionIdMissing(with_error):
								{
									state = with_error,
									entry = None
								}
							DefinitionIdClaimed(with_id, definition_id):
								if definition_id != callable_id_definition_id(id):
									{
										state = typecheck_state_add_error(
											with_id,
											(
												"internal typecheck error: foreign callable header definition ID does not match "
												+ "its reserved module ID"
											),
										),
										entry = None
									}
								else:
									func_type = SemanticFunctionType(
										callable_signature_is_pure(signature),
										param_types,
										resolved_return_type,
									)
									{
										state = with_id,
										entry = Some({
											def_id = definition_id,
											func_type = func_type,
											type_params = [],
											param_names = param_names,
											purity = purity_from_parsed(decl.is_pure),
											origin = ForeignFunc,
											resource_args = RejectResourceArgs,
											module_path = None,
											dim_constraints = dim_constraints,
											loop_producer = None,
											debug_only = decl.annotations.any(
												annotation_is_debug_only,
											),
										})
									}


private pure func register_function_decl(
	state: TypecheckState,
	function_decl: ParsedFunctionDecl,
) -> TypecheckState:
	register_function_signature(
		state,
		function_decl.name.text,
		function_decl.params,
		type_from_optional_parsed_type_expr(function_decl.return_type),
		function_decl.type_params,
		function_decl.dim_constraints,
		function_decl.is_pure,
		function_decl.annotations,
		function_decl.body,
		function_decl.span,
		None,
		UserDefinedFunc,
	)


private pure func register_foreign_function_decl(
	state: TypecheckState,
	function_decl: ParsedForeignFunctionDecl,
) -> TypecheckState:
	next = if typecheck_state_allows_foreign(state):
		state
	else:
		message: String = if typecheck_state_is_stdlib(state):
			"'foreign' declarations cannot be used in the standard library"
		else:
			"'foreign' declarations cannot be used in source packages"

		typecheck_state_add_error(state, message)

	register_function_signature(
		next,
		function_decl.name.text,
		function_decl.params,
		type_from_parsed_type_expr(function_decl.return_type),
		[],
		[],
		function_decl.is_pure,
		function_decl.annotations,
		None,
		function_decl.span,
		None,
		ForeignFunc,
	)


private pure func add_trait_function_checked(
	state: TypecheckState,
	func_name: String,
	trait_name: String,
) -> TypecheckState:
	match env_trait_function_collision(state.env, func_name, trait_name):
		Some(existing_trait):
			typecheck_state_add_error(
				state,
				"method '" + func_name + "' is already registered under trait '" + existing_trait + "'; cannot also register under '" + trait_name + "'",
			)
		None:
			if env_get_function_trait(state.env, func_name) == Some(trait_name):
				state
			else:
				{ state | env = env_add_trait_function(state.env, func_name, trait_name) }


private pure func validate_trait_method_param_types(
	state: TypecheckState,
	trait_decl: ParsedTraitDecl,
) -> TypecheckState:
	var next = state

	for method in trait_decl.methods:
		for param in method.params:
			if param.type_expr.is_none():
				param_name: String = param_name_from_parsed(param).get_or("_")
				next = typecheck_state_add_error(
					next,
					"trait " + trait_decl.name.text + " method '" + method.name.text + "': parameter '" + param_name + "' must have an explicit type",
				)

	next


private pure func register_trait_decl(
	state: TypecheckState,
	module_path: String,
	trait_decl: ParsedTraitDecl,
) -> TypecheckState:
	next = validate_trait_method_param_types(state, trait_decl)

	definition_key = source_definition_key(
		typecheck_state_module_identity(next),
		TraitDefinition,
		trait_decl.name.text,
		None,
		trait_decl.span,
	)

	match typecheck_state_claim_source_definition_id(next, definition_key):
		DefinitionIdClaimed(with_id, def_id):
			register_trait_with_id(with_id, module_path, trait_decl, def_id)
		DefinitionIdMissing(with_error):
			with_error


private pure func register_trait_with_id(
	state: TypecheckState,
	module_path: String,
	trait_decl: ParsedTraitDecl,
	def_id: Int,
) -> TypecheckState:
	type_params = type_param_names(trait_decl.type_params)
	trait_def = trait_def_with_details(
		def_id,
		trait_decl.name.text,
		type_params,
		trait_decl.supertraits.map(func(name): name.text),
		trait_decl.methods.map(func(method): trait_method_from_parsed(method, type_params)),
		Some(module_path),
	)
	env_with_trait = env_add_trait(state.env, trait_def)
	var with_trait = { state | env = env_with_trait }

	for method in trait_decl.methods:
		with_trait = add_trait_function_checked(with_trait, method.name.text, trait_decl.name.text)

	for pair in env_trait_methods_with_declaring_trait(with_trait.env, trait_decl.name.text):
		if pair[1] != trait_decl.name.text:
			with_trait = add_trait_function_checked(with_trait, pair[0], pair[1])

	with_trait


private union AcceptedTraitRecordClaim:
	AcceptedTraitRecordClaimed(TypecheckState, AcceptedTraitTableRecord)
	AcceptedTraitRecordMissing(TypecheckState)


-- Convert and claim an accepted trait without publishing it through Env. The
-- returned record is already canonicalized for the graph-owned table.
private pure func prepare_accepted_trait_header(
	state: TypecheckState,
	type_headers: TypeHeaderGraph,
	header: TraitTopologyHeader,
	module_path: String,
	local_type_names: List[String],
	compiler_builtin_id: Option[TraitId],
) -> AcceptedTraitRecordClaim:
	id = trait_topology_header_id(header)
	owner_identity = trait_id_module_identity(id)
	registration = LocalCallableHeaderRegistration(module_path)
	var methods: List[TraitMethodSig] = []
	var conversion_failed: Bool = False

	for slot in trait_topology_header_methods(header):
		if not conversion_failed:
			signature = trait_method_slot_signature(slot)
			var param_types: List[SemanticType] = []
			var param_names: List[Option[String]] = []

			for parameter in callable_signature_parameters(signature):
				if not conversion_failed:
					match callable_header_semantic_type(
						type_headers,
						owner_identity,
						registration,
						parameter.typ,
					):
						Some(typ):
							param_types = param_types.append(
								qualify_module_local_types(
									module_path,
									local_type_names,
									typ,
								),
							)
							param_names = param_names.append(
								callable_header_parameter_name(parameter.binder),
							)
						None:
							conversion_failed = True

			match callable_header_semantic_type(
				type_headers,
				owner_identity,
				registration,
				callable_signature_return_type(signature),
			):
				Some(return_type):
					if not conversion_failed:
						source = trait_method_slot_source(slot)
						methods = methods.append(
							trait_method_sig_with_details(
								trait_method_slot_name(slot),
								param_types,
								qualify_module_local_types(
									module_path,
									local_type_names,
									return_type,
								),
								callable_signature_is_pure(signature),
								source.body.is_some(),
								param_names,
							),
						)
				None:
					conversion_failed = True

	if conversion_failed:
		AcceptedTraitRecordMissing(
			typecheck_state_add_error(
				state,
				"internal typecheck error: accepted trait header could not be converted",
			),
		)
	else:
		definition_key = source_definition_key(
			typecheck_state_module_identity(state),
			TraitDefinition,
			trait_id_name(id),
			None,
			trait_id_source_span(id),
		)

		match typecheck_state_claim_source_definition_id(state, definition_key):
			DefinitionIdMissing(with_error):
				AcceptedTraitRecordMissing(with_error)
			DefinitionIdClaimed(with_id, definition_id):
				if definition_id != trait_id_definition_id(id):
					AcceptedTraitRecordMissing(
						typecheck_state_add_error(
							with_id,
							(
								"internal typecheck error: trait header definition ID does not match its "
								+ "reserved module ID"
							),
						),
					)
				else:
					AcceptedTraitRecordClaimed(
						with_id,
						{
							id = id,
							compiler_builtin_id = compiler_builtin_id,
							owner_module_path = module_path,
							visibility = trait_topology_header_visibility(header),
							supertraits = trait_topology_header_supertraits(header),
							method_ids = trait_topology_header_methods(
								header,
							).map(trait_method_slot_id),
							definition = trait_def_with_details(
								definition_id,
								trait_id_name(id),
								trait_topology_header_parameters(
									header,
								).map(trait_type_parameter_name),
								trait_topology_header_supertraits(header).map(trait_id_name),
								methods,
								Some(module_path),
							)
						},
					)


private pure func impl_type_head_name(for_type: SemanticType) -> Option[String]:
	match for_type:
		SemanticNamedType(name, _):
			Some(name)
		_:
			None


private pure func impl_target_label(for_type: SemanticType) -> String:
	impl_type_head_name(for_type).get_or("<non-named type>")


private pure func typecheck_find_trait(state: TypecheckState, name: String) -> Option[TraitDef]:
	match module_view_accepted_trait_implementation_authority(state.module_view):
		Some(authority):
			match accepted_trait_find(authority, name):
				Some(found):
					Some(found)
				None:
					env_get_trait(state.env, name)
		None:
			env_get_trait(state.env, name)


private pure func typecheck_trait_methods_with_declaring_trait(
	state: TypecheckState,
	trait_name: String,
) -> List[(String, String)]:
	match module_view_accepted_trait_implementation_authority(state.module_view):
		Some(authority):
			if accepted_trait_contains(authority, trait_name):
				accepted_trait_methods_with_declaring_trait(authority, trait_name)
			else:
				env_trait_methods_with_declaring_trait(state.env, trait_name)
		None:
			env_trait_methods_with_declaring_trait(state.env, trait_name)


private pure func typecheck_has_direct_trait_evidence(
	state: TypecheckState,
	obligation: TraitObligation,
) -> Bool:
	match module_view_accepted_trait_implementation_authority(state.module_view):
		Some(authority):
			accepted_has_direct_trait_evidence(authority, state.env, obligation)
		None:
			env_has_direct_trait_evidence(state.env, obligation)


private pure func typecheck_resolve_trait_obligation(
	state: TypecheckState,
	obligation: TraitObligation,
) -> TraitObligationResolution:
	match module_view_accepted_trait_implementation_authority(state.module_view):
		Some(authority):
			accepted_resolve_trait_obligation(authority, state.env, obligation)
		None:
			env_resolve_trait_obligation(state.env, obligation)


private pure func impl_orphan_error_message(
	state: TypecheckState,
	module_path: String,
	impl_decl: ParsedImplDecl,
	for_type: SemanticType,
) -> Option[String]:
	trait_home: Option[String] = match typecheck_find_trait(state, impl_decl.trait_name.text):
		Some(trait_def):
			trait_def.module_path
		None:
			None

	type_home: Option[String] = match impl_type_head_name(for_type):
		Some(type_name):
			typecheck_state_find_type_home(state, type_name)
		None:
			None

	match (trait_home, type_home):
		(Some(trait_module), Some(type_module)):
			if (
				trait_module == module_path
				or typecheck_state_type_home_matches(
					state,
					impl_target_label(for_type),
					module_path,
				)
			):
				None
			else:
				Some(
					"orphan impl: '" + impl_decl.trait_name.text + " for " + impl_target_label(
						for_type,
					) + "' is not in the trait's module '" + trait_module + "' or the type's module '" + type_module + "'",
				)
		_:
			None


private pure func impl_conflict_message(instance: ImplInstance) -> String:
	"conflicting implementation of trait '" + instance.trait_name + "' for type '" + impl_target_label(
		instance.for_type,
	) + "'"


private pure func add_source_impl_checked(
	state: TypecheckState,
	instance: ImplInstance,
) -> TypecheckState:
	match env_find_conflicting_impl(state.env, instance):
		Some(_):
			typecheck_state_add_error(state, impl_conflict_message(instance))
		None:
			{ state | env = env_add_impl(state.env, instance) }


private pure func add_private_impl_checked(
	state: TypecheckState,
	instance: ImplInstance,
) -> TypecheckState:
	match env_find_conflicting_impl(state.env, instance):
		Some(_):
			typecheck_state_add_error(state, impl_conflict_message(instance))
		None:
			match typecheck_state_find_private_impl_conflict(state, instance):
				Some(_):
					typecheck_state_add_error(state, impl_conflict_message(instance))
				None:
					typecheck_state_add_private_impl(state, instance)


private pure func impl_bound_name_is_candidate(state: TypecheckState, name: String) -> Bool:
	(
		name != "#_"
		and not name.starts_with("#")
		and not typecheck_state_has_known_type_name(state, name)
	)


private pure func impl_inline_bounds_from_type_exprs(
	type_exprs: List[ParsedTypeExpr],
) -> List[BoundTypeParam]:
	var result: List[BoundTypeParam] = []

	for type_expr in type_exprs:
		result = result.concat(impl_inline_bounds_from_type_expr(type_expr))

	result


private pure func impl_inline_bounds_from_type_expr(
	type_expr: ParsedTypeExpr,
) -> List[BoundTypeParam]:
	match type_expr:
		ParsedBoundedType(name, bounds, _):
			[make_bound_type_param(
					name.text,
					bounds.map(func(bound): bound.text),
				)]
		ParsedNamedType(_, args, _):
			impl_inline_bounds_from_type_exprs(args)
		ParsedQualifiedNamedType(_, _, args, _):
			impl_inline_bounds_from_type_exprs(args)
		ParsedTupleType(items, _):
			impl_inline_bounds_from_type_exprs(items)
		ParsedArrayType(element, dims, _):
			impl_inline_bounds_from_type_expr(
				element,
			).concat(impl_inline_bounds_from_type_exprs(dims))
		ParsedFunctionType(_, params, return_type, _):
			impl_inline_bounds_from_type_exprs(
				params,
			).concat(impl_inline_bounds_from_type_expr(return_type))
		ParsedRangeType(inner, _):
			impl_inline_bounds_from_type_expr(inner)
		ParsedDimBinaryType(_, left, right, _):
			impl_inline_bounds_from_type_expr(left).concat(impl_inline_bounds_from_type_expr(right))
		ParsedDimLiteralType(_, _):
			[]
		ParsedDimNameType(_, _, _):
			[]
		ParsedMissingType(_):
			[]


private pure func impl_bounds_for_type(
	state: TypecheckState,
	explicit_bounds: List[BoundTypeParam],
	for_type: SemanticType,
) -> List[BoundTypeParam]:
	var result: List[BoundTypeParam] = explicit_bounds
	var seen: List[String] = explicit_bounds.map(func(bound): bound.name)

	for name in collect_type_vars(for_type):
		if impl_bound_name_is_candidate(state, name) and not seen.contains(name):
			seen = seen.append(name)
			result = result.append(make_bound_type_param(name, []))

	result


private pure func impl_bounds_for_decl_type(
	state: TypecheckState,
	type_expr: ParsedTypeExpr,
	for_type: SemanticType,
) -> List[BoundTypeParam]:
	impl_bounds_for_type(state, impl_inline_bounds_from_type_expr(type_expr), for_type)


private pure func impl_parameterize_receiver_type(
	type_param_names: List[String],
	typ: SemanticType,
) -> SemanticType:
	match typ:
		SemanticNamedType(name, args):
			if args.length() == 0 and type_param_names.contains(name):
				SemanticTypeVar(name)
			else:
				SemanticNamedType(
					name,
					args.map(func(arg):
						impl_parameterize_receiver_type(type_param_names, arg)
					),
				)
		SemanticArrayType(element, dims):
			SemanticArrayType(
				impl_parameterize_receiver_type(
					type_param_names,
					element,
				),
				dims.map(func(dim):
					impl_parameterize_receiver_type(type_param_names, dim)
				),
			)
		SemanticFunctionType(is_pure, params, return_type):
			SemanticFunctionType(
				is_pure,
				params.map(func(param):
					impl_parameterize_receiver_type(type_param_names, param)
				),
				impl_parameterize_receiver_type(
					type_param_names,
					return_type,
				),
			)
		SemanticTupleType(items):
			SemanticTupleType(
				items.map(func(item):
					impl_parameterize_receiver_type(type_param_names, item)
				),
			)
		SemanticRangeType(inner):
			SemanticRangeType(impl_parameterize_receiver_type(type_param_names, inner))
		SemanticDimOpType(op, left, right):
			SemanticDimOpType(
				op,
				impl_parameterize_receiver_type(type_param_names, left),
				impl_parameterize_receiver_type(type_param_names, right),
			)
		SemanticTypeVar(name):
			SemanticTypeVar(name)
		SemanticConstIntType(value):
			SemanticConstIntType(value)
		SemanticSelfType:
			SemanticSelfType
		SemanticVarDimsType(name):
			SemanticVarDimsType(name)
		SemanticMetaType(id):
			SemanticMetaType(id)


private pure func impl_normalize_receiver_type(
	state: TypecheckState,
	type_expr: ParsedTypeExpr,
	for_type: SemanticType,
) -> SemanticType:
	type_param_names = impl_bounds_for_decl_type(
		state,
		type_expr,
		for_type,
	).map(
		func(bound): bound.name,
	)
	impl_parameterize_receiver_type(type_param_names, for_type)


private union ImplMethodInfoClaim:
	ImplMethodInfoClaimed(TypecheckState, ImplMethodInfo)
	ImplMethodInfoMissing(TypecheckState)


private union ImplMethodInfosClaim:
	ImplMethodInfosClaimed(TypecheckState, List[ImplMethodInfo])
	ImplMethodInfosMissing(TypecheckState)


private pure func impl_method_info_from_decl(
	state: TypecheckState,
	module_path: String,
	method: ParsedFunctionDecl,
) -> ImplMethodInfoClaim:
	declared_type_param_names = type_param_names(method.type_params)
	param_types: List[SemanticType] = method.params
		.map(func(param): type_from_optional_parsed_type_expr(param.type_expr))
		.map(
			func(
				param_type,
			): canonical_function_annotation_type(state, declared_type_param_names, param_type),
		)
	return_type: SemanticType = canonical_function_annotation_type(
		state,
		declared_type_param_names,
		type_from_optional_parsed_type_expr(method.return_type),
	)
	impl_method_info_from_semantic_types(state, module_path, method, param_types, return_type)


private pure func impl_method_info_from_semantic_types(
	state: TypecheckState,
	module_path: String,
	method: ParsedFunctionDecl,
	param_types: List[SemanticType],
	return_type: SemanticType,
) -> ImplMethodInfoClaim:
	func_type: SemanticType = SemanticFunctionType(method.is_pure, param_types, return_type)
	callable_key = callable_key_from_span(state, method.name.text, method.span)

	match typecheck_state_claim_func_callable_id(state, callable_key):
		DefinitionIdMissing(with_error):
			ImplMethodInfoMissing(with_error)
		DefinitionIdClaimed(with_id, callable_id):
			info = impl_method_info(
				method.name.text,
				Some({
					callable_id = callable_id,
					module_path = module_path,
				}),
				func_type,
				effective_bound_type_params(with_id, method.type_params, func_type),
				method.params.map(param_name_from_parsed),
				purity_from_parsed(method.is_pure),
				function_resource_arg_policy(with_id, param_types, method.annotations, method.body),
				method.dim_constraints.map(dim_constraint_from_parsed),
				method.annotations.any(annotation_is_debug_only),
			)
			ImplMethodInfoClaimed(with_id, info)


private pure func impl_method_infos_from_decl(
	state: TypecheckState,
	module_path: String,
	methods: List[ParsedFunctionDecl],
) -> ImplMethodInfosClaim:
	var result: ImplMethodInfosClaim = ImplMethodInfosClaimed(state, [])

	for method in methods:
		match result:
			ImplMethodInfosMissing(_):
				void
			ImplMethodInfosClaimed(next, infos):
				result = match impl_method_info_from_decl(next, module_path, method):
					ImplMethodInfoMissing(with_error):
						ImplMethodInfosMissing(with_error)
					ImplMethodInfoClaimed(with_method, info):
						ImplMethodInfosClaimed(
							with_method,
							infos.append(info),
						)

	result


private pure func implementation_bound_type_params(
	header: ImplementationHeader,
) -> List[BoundTypeParam]:
	implementation_header_parameters(header).map(func(parameter): make_resolved_bound_type_param(
			implementation_type_parameter_id_name(
				resolved_implementation_type_parameter_id(parameter),
			),
			resolved_implementation_type_parameter_bounds(parameter).map(bound_trait_identity),
		))


private pure func implementation_method_bound_type_params(
	header: ImplementationMethodHeader,
) -> List[BoundTypeParam]:
	explicit_implementation_method_parameters(
		header,
	).map(
		func(parameter): make_resolved_bound_type_param(
			callable_type_parameter_id_name(
				resolved_implementation_method_type_parameter_id(parameter),
			),
			resolved_implementation_method_type_parameter_bounds(
				parameter,
			).map(bound_trait_identity),
		),
	)


private pure func implementation_method_info_from_header(
	state: TypecheckState,
	type_headers: TypeHeaderGraph,
	method_header: ImplementationMethodHeader,
	owner_identity: ModuleIdentity,
	registration: CallableHeaderRegistration,
	module_path: String,
) -> ImplMethodInfoClaim:
	match (
		explicit_implementation_method_source(method_header),
		explicit_implementation_method_signature(method_header),
	):
		(Some(source), Some(signature)):
			var param_types: List[SemanticType] = []
			var param_names: List[Option[String]] = []
			var conversion_failed: Bool = False

			for parameter in callable_signature_parameters(signature):
				if not conversion_failed:
					match callable_header_semantic_type(
						type_headers,
						owner_identity,
						registration,
						parameter.typ,
					):
						Some(typ):
							param_types = param_types.append(typ)
							param_names = param_names.append(
								callable_header_parameter_name(parameter.binder),
							)
						None:
							conversion_failed = True

			return_type = callable_header_semantic_type(
				type_headers,
				owner_identity,
				registration,
				callable_signature_return_type(signature),
			)
			var dim_constraints: List[(SemanticType, SemanticType)] = []

			for constraint in explicit_implementation_method_dimension_constraints(method_header):
				if not conversion_failed:
					left = callable_header_semantic_type(
						type_headers,
						owner_identity,
						registration,
						constraint[0],
					)
					right = callable_header_semantic_type(
						type_headers,
						owner_identity,
						registration,
						constraint[1],
					)

					match left:
						Some(left_type):
							match right:
								Some(right_type):
									dim_constraints = dim_constraints.append(
										(left_type, right_type),
									)
								None:
									conversion_failed = True
						None:
							conversion_failed = True

			match return_type:
				None:
					ImplMethodInfoMissing(
						typecheck_state_add_error(
							state,
							(
								"internal typecheck error: accepted implementation method header could not be "
								+ "installed"
							),
						),
					)
				Some(resolved_return_type):
					if conversion_failed:
						ImplMethodInfoMissing(
							typecheck_state_add_error(
								state,
								(
									"internal typecheck error: accepted implementation method header could not be "
									+ "installed"
								),
							),
						)
					else:
						method_id = implementation_method_header_id(method_header)
						callable_key = callable_key_from_span(state, source.name.text, source.span)

						match typecheck_state_claim_func_callable_id(state, callable_key):
							DefinitionIdMissing(with_error):
								ImplMethodInfoMissing(with_error)
							DefinitionIdClaimed(with_id, callable_id):
								if callable_id != callable_id_definition_id(method_id):
									ImplMethodInfoMissing(
										typecheck_state_add_error(
											with_id,
											(
												"internal typecheck error: implementation method header definition ID does not "
												+ "match its reserved module ID"
											),
										),
									)
								else:
									func_type = SemanticFunctionType(
										callable_signature_is_pure(signature),
										param_types,
										resolved_return_type,
									)
									info = impl_method_info(
										source.name.text,
										Some({
											callable_id = callable_id,
											module_path = module_path,
										}),
										func_type,
										implementation_method_bound_type_params(method_header),
										param_names,
										purity_from_parsed(source.is_pure),
										function_resource_arg_policy(
											with_id,
											param_types,
											source.annotations,
											source.body,
										),
										dim_constraints,
										source.annotations.any(annotation_is_debug_only),
									)
									ImplMethodInfoClaimed(with_id, info)
		_:
			ImplMethodInfoMissing(
				typecheck_state_add_error(
					state,
					(
						"internal typecheck error: default implementation method cannot be installed as "
						+ "an explicit method"
					),
				),
			)


private pure func implementation_method_infos_from_header(
	state: TypecheckState,
	type_headers: TypeHeaderGraph,
	header: ImplementationHeader,
	registration: CallableHeaderRegistration,
	module_path: String,
) -> ImplMethodInfosClaim:
	owner_identity = impl_id_module_identity(implementation_header_id(header))
	var result: ImplMethodInfosClaim = ImplMethodInfosClaimed(state, [])

	for method_header in implementation_header_methods(header):
		match method_header:
			DefaultImplementationMethodHeaderValue(_):
				void
			ExplicitImplementationMethodHeaderValue(_):
				match result:
					ImplMethodInfosMissing(_):
						void
					ImplMethodInfosClaimed(next, infos):
						result = match implementation_method_info_from_header(
							next,
							type_headers,
							method_header,
							owner_identity,
							registration,
							module_path,
						):
							ImplMethodInfoMissing(with_error):
								ImplMethodInfosMissing(with_error)
							ImplMethodInfoClaimed(with_method, info):
								ImplMethodInfosClaimed(
									with_method,
									infos.append(info),
								)

	result


private union AcceptedImplementationRecordClaim:
	AcceptedImplementationRecordClaimed(TypecheckState, AcceptedImplementationTableRecord)
	AcceptedImplementationRecordMissing(TypecheckState)


-- Convert and claim an accepted implementation without installing it in Env.
-- Coherence is checked after the graph table can project the exact visible IDs.
private pure func prepare_accepted_implementation_header(
	state: TypecheckState,
	type_headers: TypeHeaderGraph,
	header: ImplementationHeader,
	module_path: String,
	local_type_names: List[String],
) -> AcceptedImplementationRecordClaim:
	id = implementation_header_id(header)
	trait_id = implementation_header_trait_id(header)
	registration = LocalCallableHeaderRegistration(module_path)

	match callable_header_semantic_type(
		type_headers,
		impl_id_module_identity(id),
		registration,
		implementation_header_receiver(header),
	):
		None:
			AcceptedImplementationRecordMissing(
				typecheck_state_add_error(
					state,
					(
						"internal typecheck error: accepted implementation receiver could not be "
						+ "converted"
					),
				),
			)
		Some(for_type):
			match implementation_method_infos_from_header(
				state,
				type_headers,
				header,
				registration,
				module_path,
			):
				ImplMethodInfosMissing(with_error):
					AcceptedImplementationRecordMissing(with_error)
				ImplMethodInfosClaimed(with_methods, method_infos):
					source = implementation_header_source(header)

					with_orphan = match impl_orphan_error_message(
						with_methods,
						module_path,
						source,
						for_type,
					):
						Some(message):
							typecheck_state_add_error(with_methods, message)
						None:
							with_methods

					definition_key = source_definition_key(
						typecheck_state_module_identity(with_orphan),
						ImplDefinition,
						source.trait_name.text,
						None,
						source.span,
					)

					match typecheck_state_claim_source_definition_id(with_orphan, definition_key):
						DefinitionIdMissing(with_error):
							AcceptedImplementationRecordMissing(with_error)
						DefinitionIdClaimed(with_id, definition_id):
							if definition_id != impl_id_definition_id(id):
								AcceptedImplementationRecordMissing(
									typecheck_state_add_error(
										with_id,
										(
											"internal typecheck error: implementation header definition ID does not match "
											+ "its reserved module ID"
										),
									),
								)
							else:
								canonical_for_type = qualify_module_local_types(
									module_path,
									local_type_names,
									for_type,
								)
								canonical_methods = method_infos.map(func(method): { method |
										func_type = qualify_module_local_types(
											module_path,
											local_type_names,
											method.func_type,
										),
										dim_constraints = method.dim_constraints.map(
											func(
												constraint,
											): (
												qualify_module_local_types(
													module_path,
													local_type_names,
													constraint[0],
												),
												qualify_module_local_types(
													module_path,
													local_type_names,
													constraint[1],
												),
											),
										)
									})
								AcceptedImplementationRecordClaimed(
									with_id,
									{
										id = id,
										trait_id = trait_id,
										owner_module_path = module_path,
										visibility = implementation_header_visibility(header),
										method_ids = implementation_header_methods(header)
											.filter(implementation_method_header_is_explicit)
											.map(implementation_method_header_id),
										instance = impl_instance_with_methods(
											definition_id,
											trait_id_name(trait_id),
											canonical_for_type,
											implementation_bound_type_params(header),
											canonical_methods,
											False,
										)
									},
								)


private pure func register_impl_decl_with_info(
	state: TypecheckState,
	module_path: String,
	impl_decl: ParsedImplDecl,
	for_type: SemanticType,
	method_infos: List[ImplMethodInfo],
	is_private: Bool,
) -> TypecheckState:
	var next = match impl_orphan_error_message(state, module_path, impl_decl, for_type):
		Some(message):
			typecheck_state_add_error(state, message)
		None:
			state

	definition_key = source_definition_key(
		typecheck_state_module_identity(next),
		ImplDefinition,
		impl_decl.trait_name.text,
		None,
		impl_decl.span,
	)

	match typecheck_state_claim_source_definition_id(next, definition_key):
		DefinitionIdClaimed(with_id, def_id):
			register_impl_with_id(with_id, impl_decl, for_type, method_infos, is_private, def_id)
		DefinitionIdMissing(with_error):
			with_error


private pure func register_impl_with_id(
	state: TypecheckState,
	impl_decl: ParsedImplDecl,
	for_type: SemanticType,
	method_infos: List[ImplMethodInfo],
	is_private: Bool,
	def_id: Int,
) -> TypecheckState:
	instance = impl_instance_with_methods(
		def_id,
		impl_decl.trait_name.text,
		for_type,
		impl_bounds_for_decl_type(state, impl_decl.for_type, for_type),
		method_infos,
		False,
	)

	if is_private:
		add_private_impl_checked(state, instance)
	else:
		add_source_impl_checked(state, instance)


private pure func register_impl_decl(
	state: TypecheckState,
	module_path: String,
	impl_decl: ParsedImplDecl,
	is_private: Bool,
) -> TypecheckState:
	raw_for_type: SemanticType = canonical_annotation_type(
		state,
		type_from_parsed_type_expr(impl_decl.for_type),
	)
	for_type: SemanticType = impl_normalize_receiver_type(state, impl_decl.for_type, raw_for_type)

	match impl_method_infos_from_decl(state, module_path, impl_decl.methods):
		ImplMethodInfosMissing(with_error):
			with_error
		ImplMethodInfosClaimed(with_methods, method_infos):
			register_impl_decl_with_info(
				with_methods,
				module_path,
				impl_decl,
				for_type,
				method_infos,
				is_private,
			)


pure func typecheck_register_signature_decl(
	state: TypecheckState,
	module_path: String,
	decl: ParsedDecl,
) -> TypecheckState:
	match decl:
		FunctionParsedDecl(function_decl):
			register_function_decl(state, function_decl)
		VarParsedDecl(var_decl):
			register_var_decl(state, module_path, var_decl)
		ForeignBlockParsedDecl(_, functions, _):
			var next = state

			for function_decl in functions:
				next = register_foreign_function_decl(next, function_decl)

			next
		TraitParsedDecl(trait_decl):
			register_trait_decl(state, module_path, trait_decl)
		PrivateParsedDecl(inner, _):
			typecheck_register_signature_decl(state, module_path, inner)
		_:
			state


pure func typecheck_register_signature_decls(
	state: TypecheckState,
	module_path: String,
	decls: List[ParsedDecl],
) -> TypecheckState:
	var next = state

	for decl in decls:
		next = typecheck_register_signature_decl(next, module_path, decl)

	next


pure func typecheck_register_program_signature_decls(
	state: TypecheckState,
	program: ParsedProgram,
) -> TypecheckState:
	typecheck_register_signature_decls(
		typecheck_state_scope_to_program(state, program),
		program.source.module_name,
		program.decls,
	)


pure func typecheck_register_impl_decl(
	state: TypecheckState,
	module_path: String,
	decl: ParsedDecl,
) -> TypecheckState:
	match decl:
		ImplParsedDecl(impl_decl):
			register_impl_decl(state, module_path, impl_decl, False)
		PrivateParsedDecl(inner, _):
			match inner:
				ImplParsedDecl(impl_decl):
					register_impl_decl(state, module_path, impl_decl, True)
				_:
					state
		_:
			state


pure func typecheck_register_impl_decls(
	state: TypecheckState,
	module_path: String,
	decls: List[ParsedDecl],
) -> TypecheckState:
	var next = state

	for decl in decls:
		next = typecheck_register_impl_decl(next, module_path, decl)

	next


pure func typecheck_register_program_impl_decls(
	state: TypecheckState,
	program: ParsedProgram,
) -> TypecheckState:
	typecheck_register_impl_decls(
		typecheck_state_scope_to_program(state, program),
		program.source.module_name,
		program.decls,
	)


private pure func typecheck_register_import_module_types(
	state: TypecheckState,
	module: ImportableModule,
	type_headers: TypeHeaderGraph,
) -> TypecheckState:
	target_scope = state
	module_state = typecheck_state_scope_to_imported_module(
		state,
		importable_module_prepared_scope(module),
	)

	if module_state.errors.length() > state.errors.length():
		module_state
	else:
		with_builtin_headers = typecheck_install_imported_builtin_headers(
			module_state,
			type_headers,
			importable_module_prepared_scope(module),
			importable_module_path(module),
		)
		with_record_headers = typecheck_install_imported_record_headers(
			with_builtin_headers,
			type_headers,
			importable_module_prepared_scope(module),
			importable_module_path(module),
		)
		with_union_headers = typecheck_install_imported_union_headers(
			with_record_headers,
			type_headers,
			importable_module_prepared_scope(module),
			importable_module_path(module),
		)
		with_types = typecheck_install_imported_alias_headers(
			with_union_headers,
			type_headers,
			importable_module_prepared_scope(module),
			importable_module_path(module),
		)

		typecheck_state_restore_definition_scope(with_types, target_scope)


private pure func typecheck_register_import_modules_from(
	state: TypecheckState,
	all_modules: List[ImportableModule],
	type_headers: TypeHeaderGraph,
) -> TypecheckState:
	var next = state
	var compatible_modules: List[ImportableModule] = []

	for module in all_modules:
		module_scope = importable_module_prepared_scope(module)

		if typecheck_state_accepts_imported_module_scope(state, module_scope):
			compatible_modules = compatible_modules.append(module)
		else:
			next = typecheck_state_scope_to_imported_module(next, module_scope)

	-- Canonical type declarations from the reachable dependency closure are
	-- graph metadata. Registering them does not
	-- introduce a bare source name; aliases are created only for actual import
	-- selective bindings in the module view. This lets a direct dependency expose a
	-- record/union from one of its dependencies without leaking unrelated values.
	for module in compatible_modules:
		next = typecheck_register_import_module_types(next, module, type_headers)

	next


private pure func body_check_param_label(param: ParsedParam) -> String:
	match param.binder:
		ParsedParamNameBinder(name):
			name.text
		ParsedParamWildcardBinder(_):
			"_"
		ParsedParamTupleBinder(_, _):
			"tuple parameter"


private pure func body_check_missing_param_type_error(
	state: TypecheckState,
	function_name: String,
	param: ParsedParam,
) -> TypecheckState:
	typecheck_state_add_error(
		state,
		"Function '" + function_name + "' parameter '" + body_check_param_label(
			param,
		) + "' must have an explicit type to check the body",
	)


private pure func add_function_param_binding(
	state: TypecheckState,
	name: ParsedIdentifier,
	param_type: SemanticType,
) -> TypecheckState:
	{ state |
		env = env_add_var_with_details(
			state.env,
			name.text,
			param_type,
			Some(param_type),
			ImmutableBinding,
			FuncParam,
			UNREFINED_BINDING,
		)
	}


private pure func add_tuple_function_param_bindings(
	state: TypecheckState,
	function_name: String,
	names: List[ParsedIdentifier],
	elements: List[SemanticType],
) -> TypecheckState:
	if names.length() != elements.length():
		typecheck_state_add_error(
			state,
			"Function '" + function_name + "' tuple parameter has " + names
				.length()
				.to_string() + " names but annotation has " + elements
				.length()
				.to_string() + " elements",
		)
	else:
		var next = state
		var index: Int = 0

		while index < names.length():
			match (names.get(index), elements.get(index)):
				(Some(name), Some(element_type)):
					next = add_function_param_binding(next, name, element_type)
				_:
					void

			index += 1

		next


private pure func prepare_function_param(
	state: TypecheckState,
	function_name: String,
	param: ParsedParam,
	param_type: SemanticType,
) -> TypecheckState:
	typed_state = match param.type_expr:
		Some(_):
			state
		None:
			body_check_missing_param_type_error(state, function_name, param)

	match param.binder:
		ParsedParamNameBinder(name):
			add_function_param_binding(typed_state, name, param_type)
		ParsedParamWildcardBinder(_):
			typed_state
		ParsedParamTupleBinder(names, _):
			match param_type:
				SemanticTupleType(elements):
					add_tuple_function_param_bindings(typed_state, function_name, names, elements)
				_:
					typecheck_state_add_error(
						typed_state,
						"Function '" + function_name + "' tuple parameter requires a tuple annotation",
					)


private pure func prepare_function_body_state(
	state: TypecheckState,
	function_decl: ParsedFunctionDecl,
	signature: FunctionBodySignature,
) -> TypecheckState:
	env_with_scope = env_push_scope(state.env)
	env_with_type_params = env_extend_type_param_bounds(
		env_with_scope,
		signature.effective_type_params,
	)
	var next = { state | env = env_with_type_params }
	var index: Int = 0

	while index < function_decl.params.length():
		match function_decl.params.get(index):
			Some(param):
				next = prepare_function_param(
					next,
					function_decl.name.text,
					param,
					signature.param_types.get_or(index, TYPE_VOID),
				)
			None:
				void

		index += 1

	next


private pure func body_check_context_with_expected_type(
	state: TypecheckState,
	return_type: Option[SemanticType],
) -> InferContext:
	context = infer_context(state)

	match return_type:
		Some(expected_type):
			infer_with_canonical_expected_value_slot(context, expected_type, ExpectedArgumentSlot)
		None:
			infer_without_expected(context)


private pure func function_return_type_mismatch_error(
	state: TypecheckState,
	span: SourceSpan,
	function_name: String,
	expected: SemanticType,
	found: SemanticType,
) -> TypecheckState:
	typecheck_state_add_error_at(
		state,
		span,
		"Function '" + function_name + "' returns wrong type\n    expected: " + type_to_string(
			expected,
		) + "  (declared return type)\n       found: " + type_to_string(
			found,
		) + "  (body expression)",
	)


private pure func function_missing_return_type_error(
	state: TypecheckState,
	span: SourceSpan,
	function_name: String,
	found: SemanticType,
) -> TypecheckState:
	typecheck_state_add_error_at(
		state,
		span,
		"Function '" + function_name + "' body has type " + type_to_string(
			found,
		) + " but no return type is declared\n    help: add '-> " + type_to_string(
			found,
		) + "' to the function signature, or use '-> Void' if discarding the result",
	)


-- Registered signatures and finalized expression slots are canonical at this
-- boundary. Keeping the comparison environment-free prevents redundant alias
-- reconstruction and makes that caller invariant explicit.
private pure func check_function_like_body_result(
	function_name: String,
	body_span: SourceSpan,
	return_type: Option[SemanticType],
	value_matches_declared_return: Bool,
	result: InferResult,
) -> TypecheckState:
	found_type = typed_expr_value_type(result.expr)
	found_semantic_type = typed_expr_semantic_type(result.expr)
	result_state = infer_context_typecheck_state(result.context)

	match return_type:
		Some(expected_type):
			if (
				value_matches_declared_return
				or types_compatible_with_params(
					env_get_type_params(result_state.env),
					expected_type,
					found_semantic_type,
				)
			):
				result_state
			else:
				function_return_type_mismatch_error(
					result_state,
					body_span,
					function_name,
					expected_type,
					found_type,
				)
		None:
			if types_equal(found_type, TYPE_VOID):
				result_state
			else:
				function_missing_return_type_error(
					result_state,
					body_span,
					function_name,
					found_type,
				)


private MAIN_SIGNATURE_MESSAGE: String = (
	"main must have one parameter of type List[String] and a concrete return type "
	+ "implementing ExitStatusAble"
)

private MAIN_GENERIC_MESSAGE: String = "main cannot be generic\n" + "help: Program entrypoint main must not declare type parameters"


enum MainValidationPolicy:
	ValidateProgramMain
	IgnoreMainName


private pure func main_param_type_valid(param: ParsedParam) -> Bool:
	match param.type_expr.map(type_from_parsed_type_expr):
		Some(typ):
			types_equal(typ, type_list(TYPE_STRING))
		None:
			False


private pure func check_main_signature(
	state: TypecheckState,
	function_decl: ParsedFunctionDecl,
	return_type: SemanticType,
	policy: MainValidationPolicy,
) -> TypecheckState:
	match policy:
		IgnoreMainName:
			state
		ValidateProgramMain:
			check_main_signature_for_program(state, function_decl, return_type)


private pure func check_main_signature_for_program(
	state: TypecheckState,
	function_decl: ParsedFunctionDecl,
	return_type: SemanticType,
) -> TypecheckState:
	if function_decl.name.text != "main":
		state
	else if function_decl.type_params.length() != 0:
		typecheck_state_add_error(state, MAIN_GENERIC_MESSAGE)
	else if function_decl.params.length() != 1:
		typecheck_state_add_error(state, MAIN_SIGNATURE_MESSAGE)
	else:
		match function_decl.params.get(0):
			Some(param):
				param_valid = main_param_type_valid(param)

				-- Int and Void are the two standard implementations. Keep this
				-- intrinsic fallback for graph clients that omit source-level std
				-- modules; custom return types still require real trait evidence.
				return_valid = if (
					types_equal(return_type, TYPE_INT)
					or types_equal(return_type, TYPE_VOID)
				):
					True
				else:
					return_resolution = typecheck_resolve_trait_obligation(
						state,
						trait_obligation(return_type, "ExitStatusAble"),
					)

					match return_resolution:
						TraitObligationSatisfied:
							True
						TraitObligationDeferred:
							False
						TraitObligationUnsatisfied:
							False

				if not param_valid and not return_valid:
					typecheck_state_add_error(state, MAIN_SIGNATURE_MESSAGE)
				else if not return_valid:
					typecheck_state_add_error(
						state,
						"main return type '" + type_to_string(
							return_type,
						) + "' does not implement ExitStatusAble\nhelp: Return Int or Void, or implement ExitStatusAble for a type owned by this module",
					)
				else if not param_valid:
					param_text = match param.type_expr.map(type_from_parsed_type_expr):
						Some(typ):
							type_to_string(typ)
						None:
							"untyped"

					typecheck_state_add_error(
						state,
						"main parameter must be List[String], got " + param_text,
					)
				else:
					state
			None:
				typecheck_state_add_error(state, MAIN_SIGNATURE_MESSAGE)


private pure func check_pure_function_like_body_calls(
	state: TypecheckState,
	function_name: String,
	is_pure: Bool,
	result: InferResult,
) -> TypecheckState:
	if not is_pure:
		state
	else:
		var next = state

		for call_name in typed_expr_impure_call_names(result.expr):
			next = typecheck_state_add_error(
				next,
				"Pure function '" + function_name + "' cannot call impure function '" + call_name + "'",
			)

		next


private pure func check_pure_function_like_module_assignments(
	state: TypecheckState,
	function_name: String,
	is_pure: Bool,
	result: InferResult,
) -> TypecheckState:
	if not is_pure:
		state
	else:
		var next = state

		for name in typed_expr_module_assign_names(result.expr):
			next = typecheck_state_add_error(
				next,
				"Pure function '" + function_name + "' cannot assign to module-level variable '" + name + "'",
			)

		next


private pure func check_debug_block_body(
	state: TypecheckState,
	result: InferResult,
) -> TypecheckState:
	with_assignments = if typed_expr_has_debug_block_assignment(result.expr):
		typecheck_state_add_error(state, "debug: blocks cannot assign")
	else:
		state

	var next = with_assignments

	for call_name in typed_expr_debug_block_impure_call_names(result.expr):
		next = typecheck_state_add_error(
			next,
			"debug: blocks cannot call impure function '" + call_name + "'",
		)

	next


private pure func type_is_impure_function_type(typ: SemanticType) -> Bool:
	match typ:
		SemanticFunctionType(is_pure, _, _):
			not is_pure
		_:
			False


private pure func check_pure_function_like_callback_params(
	state: TypecheckState,
	function_name: String,
	is_pure: Bool,
	params: List[ParsedParam],
	param_types: List[SemanticType],
) -> TypecheckState:
	if not is_pure:
		state
	else:
		var next = state
		var index: Int = 0

		while index < params.length():
			match (params.get(index), param_types.get(index)):
				(Some(param), Some(param_type)):
					if type_is_impure_function_type(param_type):
						next = typecheck_state_add_error(
							next,
							"Pure function '" + function_name + "' has impure callback parameter '" + body_check_param_label(
								param,
							) + "'",
						)
				_:
					void

			index += 1

		next


private pure func check_nested_pure_lambda_body_calls(
	state: TypecheckState,
	result: InferResult,
) -> TypecheckState:
	var next = state

	for call_name in typed_expr_pure_lambda_impure_call_names(result.expr):
		next = typecheck_state_add_error(
			next,
			"Pure function '<lambda>' cannot call impure function '" + call_name + "'",
		)

	next


private pure func check_tail_recursive_function_body(
	state: TypecheckState,
	function_decl: ParsedFunctionDecl,
	result: InferResult,
) -> TypecheckState:
	if not function_decl.annotations.any(annotation_is_tail_recursive):
		state
	else if typed_expr_has_non_tail_recursive_call(result.expr, function_decl.name.text):
		typecheck_state_add_error(
			state,
			"@tail_recursive function '" + function_decl.name.text + "' has recursive call not in tail position",
		)
	else:
		state


private pure func typed_function_info(
	function_decl: ParsedFunctionDecl,
	signature: FunctionBodySignature,
	body: Option[TypedExpr],
) -> TypedFunctionInfo:
	source_return_type: Option[SemanticType] = function_decl.return_type.map(
		type_from_parsed_type_expr,
	)

	{
		decl = function_decl,
		callable_id = signature.callable_id,
		effective_type_params = signature.effective_type_params,
		param_types = signature.param_types,
		source_return_type = source_return_type,
		semantic_return_type = signature.semantic_return_type,
		body = body
	}


private pure func materialize_declared_return_body(
	return_type: Option[SemanticType],
	body: TypedExpr,
	value_matches_declared_return: Bool,
) -> TypedExpr:
	match return_type:
		Some(expected):
			if value_matches_declared_return:
				typed_expr_with_slot(body, KeptValueSlot(expected))
			else:
				body
		None:
			body


private pure func typecheck_materialize_function_body_with_signature(
	state: TypecheckState,
	function_decl: ParsedFunctionDecl,
	signature: FunctionBodySignature,
	main_policy: MainValidationPolicy,
) -> TypecheckFunctionBodyResult:
	signature_state = check_main_signature(
		state,
		function_decl,
		signature.semantic_return_type,
		main_policy,
	)

	declared_return_type: Option[SemanticType] = if function_decl.return_type.is_some():
		Some(signature.semantic_return_type)
	else:
		None

	match function_decl.body:
		Some(body):
			if parsed_function_body_is_builtin(function_decl.body):
				builtin_state = if typecheck_state_is_source_package(signature_state):
					typecheck_state_add_error(
						signature_state,
						"builtin expressions cannot be used in source packages",
					)
				else:
					signature_state

				typed_info = typed_function_info(function_decl, signature, None)

				{
					state = builtin_state,
					typed = typed_info
				}
			else:
				body_state = prepare_function_body_state(signature_state, function_decl, signature)
				context = body_check_context_with_expected_type(body_state, declared_return_type)
				raw_result = infer_expr(context, body)
				result = finalize_infer_result(raw_result)
				result_state = infer_context_typecheck_state(result.context)

				value_matches_declared_return = match declared_return_type:
					Some(expected_type):
						types_compatible_with_params(
							env_get_type_params(result_state.env),
							expected_type,
							typed_expr_value_type(result.expr),
						)
					None:
						False

				checked_state = check_function_like_body_result(
					function_decl.name.text,
					parsed_expr_span(body),
					declared_return_type,
					value_matches_declared_return,
					result,
				)
				debug_checked_state = check_debug_block_body(checked_state, result)
				callback_checked_state = check_pure_function_like_callback_params(
					debug_checked_state,
					function_decl.name.text,
					function_decl.is_pure,
					function_decl.params,
					signature.param_types,
				)
				lambda_checked_state = check_nested_pure_lambda_body_calls(
					callback_checked_state,
					result,
				)
				purity_checked_state = check_pure_function_like_body_calls(
					lambda_checked_state,
					function_decl.name.text,
					function_decl.is_pure,
					result,
				)
				module_assign_checked_state = check_pure_function_like_module_assignments(
					purity_checked_state,
					function_decl.name.text,
					function_decl.is_pure,
					result,
				)
				tail_checked_state = check_tail_recursive_function_body(
					module_assign_checked_state,
					function_decl,
					result,
				)
				typed_body = materialize_declared_return_body(
					declared_return_type,
					result.expr,
					value_matches_declared_return,
				)
				final_state = typecheck_with_body_env(signature_state.env, tail_checked_state)
				typed_info = typed_function_info(function_decl, signature, Some(typed_body))

				{
					state = final_state,
					typed = typed_info
				}
		None:
			typed_info = typed_function_info(function_decl, signature, None)

			{
				state = signature_state,
				typed = typed_info
			}


private pure func typecheck_materialize_function_body_with_options(
	state: TypecheckState,
	function_decl: ParsedFunctionDecl,
	main_policy: MainValidationPolicy,
) -> TypecheckFunctionBodyResult:
	typecheck_materialize_function_body_with_signature(
		state,
		function_decl,
		function_body_signature(state, function_decl),
		main_policy,
	)


private pure func typecheck_check_function_body_with_options(
	state: TypecheckState,
	function_decl: ParsedFunctionDecl,
	main_policy: MainValidationPolicy,
) -> TypecheckState:
	typecheck_materialize_function_body_with_options(state, function_decl, main_policy).state


pure func typecheck_check_function_body(
	state: TypecheckState,
	function_decl: ParsedFunctionDecl,
) -> TypecheckState:
	typecheck_check_function_body_with_options(state, function_decl, ValidateProgramMain)


private pure func register_global_var_binding(
	state: TypecheckState,
	module_path: String,
	var_decl: ParsedVarDecl,
	inferred_type: SemanticType,
	source_type: Option[SemanticType],
	definition_id: Option[Int],
) -> TypecheckState:
	{ state |
		env = env_add_var_with_module_details(
			state.env,
			var_decl.name.text,
			inferred_type,
			source_type,
			var_mutability(var_decl.is_mutable),
			LetBinding,
			UNREFINED_BINDING,
			Some(module_path),
			definition_id,
		)
	}


private pure func check_mutable_global_startup_work(
	state: TypecheckState,
	var_decl: ParsedVarDecl,
	result: InferResult,
) -> TypecheckState:
	if not var_decl.is_mutable:
		state
	else:
		var next = state
		scan: TypedStartupWorkScan = typed_expr_startup_work_scan(result.expr)

		for call_name in scan.call_names:
			next = typecheck_state_add_error(
				next,
				"top-level initializer '" + var_decl.name.text + "' cannot call function '" + call_name + "'",
			)

		if scan.has_subscript:
			next = typecheck_state_add_error(
				next,
				"top-level initializer '" + var_decl.name.text + "' cannot use a subscript expression",
			)

		next


private pure func typed_global_var_info(
	var_decl: ParsedVarDecl,
	definition_id: Option[Int],
	binding_type: SemanticType,
	source_type: Option[SemanticType],
	value: TypedExpr,
) -> TypedGlobalVarInfo:
	{
		decl = var_decl,
		definition_id = definition_id,
		binding_type = binding_type,
		source_type = source_type,
		value = value
	}


private pure func typecheck_materialize_global_var_body_with_identity(
	state: TypecheckState,
	var_decl: ParsedVarDecl,
	identity: GlobalDefinitionIdentity,
) -> TypecheckGlobalVarBodyResult:
	declared_source_type: Option[SemanticType] = var_decl.type_expr.map(type_from_parsed_type_expr)

	type_expectation: GlobalTypeExpectation = match declared_source_type:
		Some(typ):
			DeclaredGlobalType(canonical_annotation_type(state, typ))
		None:
			InferredGlobalType

	context = match type_expectation:
		DeclaredGlobalType(expected):
			infer_with_canonical_expected_value_slot(
				infer_context(state),
				expected,
				ExpectedArgumentSlot,
			)
		InferredGlobalType:
			infer_context(state)

	raw_result = infer_expr(context, var_decl.value)
	result = finalize_infer_result(raw_result)
	result_state = infer_context_typecheck_state(result.context)
	found_type = typed_expr_value_type(result.expr)

	type_matches = match type_expectation:
		DeclaredGlobalType(expected):
			types_compatible_with_params(
				env_get_type_params(result_state.env),
				expected,
				found_type,
			)
		InferredGlobalType:
			True

	checked_state = match type_expectation:
		DeclaredGlobalType(_):
			if type_matches:
				result_state
			else:
				typecheck_state_add_error(
					result_state,
					"Global variable '" + var_decl.name.text + "' has wrong type",
				)
		InferredGlobalType:
			result_state

	startup_checked_state = if type_matches:
		check_mutable_global_startup_work(checked_state, var_decl, result)
	else:
		checked_state

	binding_type = match type_expectation:
		DeclaredGlobalType(expected):
			expected
		InferredGlobalType:
			typed_expr_semantic_type(result.expr)

	(definition_state, definition_id) = match identity:
		ClaimAndPublishGlobalDefinition(_):
			claim_global_definition_id(startup_checked_state, var_decl)
		ClaimGlobalDefinitionWithoutPublication:
			claim_global_definition_id(startup_checked_state, var_decl)

	final_state = match identity:
		ClaimAndPublishGlobalDefinition(module_path):
			register_global_var_binding(
				definition_state,
				module_path,
				var_decl,
				binding_type,
				declared_source_type,
				definition_id,
			)
		ClaimGlobalDefinitionWithoutPublication:
			definition_state

	{
		state = final_state,
		typed = typed_global_var_info(
			var_decl,
			definition_id,
			binding_type,
			declared_source_type,
			result.expr,
		)
	}


pure func typecheck_materialize_global_var_body(
	state: TypecheckState,
	module_path: String,
	var_decl: ParsedVarDecl,
) -> TypecheckGlobalVarBodyResult:
	typecheck_materialize_global_var_body_with_identity(
		state,
		var_decl,
		ClaimAndPublishGlobalDefinition(module_path),
	)


private pure func impl_error_message(
	impl_decl: ParsedImplDecl,
	for_type: SemanticType,
	message: String,
) -> String:
	"impl " + impl_decl.trait_name.text + " for " + type_to_string(for_type) + ": " + message


private pure func impl_has_method(methods: List[ParsedFunctionDecl], name: String) -> Bool:
	var found: Bool = False

	for method in methods:
		if method.name.text == name:
			found = True
			break

	found


private pure func find_trait_method(
	methods: List[TraitMethodSig],
	name: String,
) -> Option[TraitMethodSig]:
	var result: Option[TraitMethodSig] = None

	for method in methods:
		if method.name == name:
			result = Some(method)
			break

	result


private pure func resolve_impl_method_sig(
	for_type: SemanticType,
	method: TraitMethodSig,
) -> TraitMethodSig:
	{
		name = method.name,
		params = method.params.map(func(param): resolve_self(for_type, param)),
		return_type = resolve_self(for_type, method.return_type),
		is_pure = method.is_pure,
		has_default = method.has_default,
		param_names = method.param_names
	}


private pure func impl_validate_required_methods(
	state: TypecheckState,
	impl_decl: ParsedImplDecl,
	for_type: SemanticType,
	methods: List[TraitMethodSig],
) -> TypecheckState:
	var next = state

	for method in methods:
		if not method.has_default and not impl_has_method(impl_decl.methods, method.name):
			next = typecheck_state_add_error(
				next,
				impl_error_message(
					impl_decl,
					for_type,
					"missing required method '" + method.name + "'",
				),
			)

	next


private pure func impl_validate_supertraits(
	state: TypecheckState,
	impl_decl: ParsedImplDecl,
	for_type: SemanticType,
	supertraits: List[String],
) -> TypecheckState:
	var next = state

	for supertrait in supertraits:
		if not typecheck_has_direct_trait_evidence(
			next,
			trait_obligation(for_type, supertrait),
		):
			next = typecheck_state_add_error(
				next,
				impl_error_message(
					impl_decl,
					for_type,
					"supertrait '" + supertrait + "' is not implemented",
				),
			)

	next


private pure func impl_validate_method_params(
	state: TypecheckState,
	impl_decl: ParsedImplDecl,
	for_type: SemanticType,
	method: ParsedFunctionDecl,
	expected_params: List[SemanticType],
	type_params: List[String],
) -> TypecheckState:
	if method.params.length() != expected_params.length():
		typecheck_state_add_error(
			state,
			impl_error_message(
				impl_decl,
				for_type,
				"method '" + method.name.text + "' has " + method.params
					.length()
					.to_string() + " parameters, trait requires " + expected_params
					.length()
					.to_string(),
			),
		)
	else:
		var next = state
		var index: Int = 0

		while index < method.params.length():
			match (method.params.get(index), expected_params.get(index)):
				(Some(param), Some(expected_type)):
					impl_type = canonical_annotation_type(
						state,
						type_from_optional_parsed_type_expr(param.type_expr),
					)

					if not types_compatible_with_params(type_params, expected_type, impl_type):
						next = typecheck_state_add_error(
							next,
							impl_error_message(
								impl_decl,
								for_type,
								"method '" + method.name.text + "' parameter '" + param_name_from_parsed(
									param,
								).get_or(
									"_",
								) + "' has type " + type_to_string(
									impl_type,
								) + ", trait requires " + type_to_string(expected_type),
							),
						)
				_:
					void

			index += 1

		next


private pure func impl_validate_method_signature(
	state: TypecheckState,
	impl_decl: ParsedImplDecl,
	for_type: SemanticType,
	method: ParsedFunctionDecl,
	trait_method: TraitMethodSig,
) -> TypecheckState:
	resolved = resolve_impl_method_sig(for_type, trait_method)
	type_params = collect_type_vars(for_type).concat(type_param_names(method.type_params))

	purity_state = if resolved.is_pure and not method.is_pure:
		typecheck_state_add_error(
			state,
			impl_error_message(
				impl_decl,
				for_type,
				"method '" + method.name.text + "' must be pure",
			),
		)
	else:
		state

	return_state = match method.return_type:
		Some(return_type):
			impl_return = canonical_annotation_type(state, type_from_parsed_type_expr(return_type))

			if types_compatible_with_params(type_params, resolved.return_type, impl_return):
				purity_state
			else:
				typecheck_state_add_error(
					purity_state,
					impl_error_message(
						impl_decl,
						for_type,
						"method '" + method.name.text + "' returns " + type_to_string(
							impl_return,
						) + ", trait requires " + type_to_string(resolved.return_type),
					),
				)
		None:
			purity_state

	impl_validate_method_params(
		return_state,
		impl_decl,
		for_type,
		method,
		resolved.params,
		type_params,
	)


private pure func impl_validate_method_signatures(
	state: TypecheckState,
	impl_decl: ParsedImplDecl,
	for_type: SemanticType,
	methods: List[TraitMethodSig],
) -> TypecheckState:
	var next = state

	for method in impl_decl.methods:
		match find_trait_method(methods, method.name.text):
			Some(trait_method):
				next = impl_validate_method_signature(
					next,
					impl_decl,
					for_type,
					method,
					trait_method,
				)
			None:
				void

	next


private pure func find_trait_decl_in_decl(
	decl: ParsedDecl,
	trait_name: String,
) -> Option[ParsedTraitDecl]:
	match decl:
		TraitParsedDecl(trait_decl):
			if trait_decl.name.text == trait_name:
				Some(trait_decl)
			else:
				None
		PrivateParsedDecl(inner, _):
			find_trait_decl_in_decl(inner, trait_name)
		_:
			None


private pure func find_trait_decl(
	decls: List[ParsedDecl],
	trait_name: String,
) -> Option[ParsedTraitDecl]:
	var result: Option[ParsedTraitDecl] = None

	for decl in decls:
		match find_trait_decl_in_decl(decl, trait_name):
			Some(trait_decl):
				result = Some(trait_decl)
				break
			None:
				void

	result


private pure func resolve_self_parsed_type(
	replacement: ParsedTypeExpr,
	type_expr: ParsedTypeExpr,
) -> ParsedTypeExpr:
	match type_expr:
		ParsedNamedType(name, args, span):
			if name.text == "Self" and args.length() == 0:
				replacement
			else:
				ParsedNamedType(
					name,
					args.map(func(arg): resolve_self_parsed_type(replacement, arg)),
					span,
				)
		ParsedQualifiedNamedType(qualifier, name, args, span):
			ParsedQualifiedNamedType(
				qualifier,
				name,
				args.map(func(arg): resolve_self_parsed_type(replacement, arg)),
				span,
			)
		ParsedTupleType(items, span):
			ParsedTupleType(
				items.map(func(item): resolve_self_parsed_type(replacement, item)),
				span,
			)
		ParsedArrayType(element, dims, span):
			ParsedArrayType(
				resolve_self_parsed_type(replacement, element),
				dims.map(func(dim): resolve_self_parsed_type(replacement, dim)),
				span,
			)
		ParsedFunctionType(is_pure, params, return_type, span):
			ParsedFunctionType(
				is_pure,
				params.map(func(param): resolve_self_parsed_type(replacement, param)),
				resolve_self_parsed_type(replacement, return_type),
				span,
			)
		ParsedRangeType(inner, span):
			ParsedRangeType(
				resolve_self_parsed_type(replacement, inner),
				span,
			)
		ParsedDimBinaryType(op, left, right, span):
			ParsedDimBinaryType(
				op,
				resolve_self_parsed_type(replacement, left),
				resolve_self_parsed_type(replacement, right),
				span,
			)
		_:
			type_expr


private pure func resolve_self_optional_parsed_type(
	replacement: ParsedTypeExpr,
	type_expr: Option[ParsedTypeExpr],
) -> Option[ParsedTypeExpr]:
	type_expr.map(func(value): resolve_self_parsed_type(replacement, value))


private pure func resolve_self_parsed_param(
	replacement: ParsedTypeExpr,
	param: ParsedParam,
) -> ParsedParam:
	{ param | type_expr = resolve_self_optional_parsed_type(replacement, param.type_expr) }


private pure func resolve_self_parsed_function(
	replacement: ParsedTypeExpr,
	decl: ParsedFunctionDecl,
) -> ParsedFunctionDecl:
	{ decl |
		params = decl.params.map(func(param): resolve_self_parsed_param(replacement, param)),
		return_type = resolve_self_optional_parsed_type(replacement, decl.return_type),
		body = decl.body.map(func(body): resolve_self_parsed_expr(replacement, body))
	}


private pure func resolve_self_parsed_expr(
	replacement: ParsedTypeExpr,
	expr: ParsedExpr,
) -> ParsedExpr:
	with_children = map_parsed_expr_children(
		expr,
		func(child): resolve_self_parsed_expr(replacement, child),
	)

	match with_children:
		ParsedAscriptionExpr(value, type_expr, span):
			ParsedAscriptionExpr(
				value,
				resolve_self_parsed_type(replacement, type_expr),
				span,
			)
		ParsedOpaqueIntoExpr(type_expr, value, span):
			ParsedOpaqueIntoExpr(
				resolve_self_parsed_type(replacement, type_expr),
				value,
				span,
			)
		ParsedOpaqueFromExpr(type_expr, value, span):
			ParsedOpaqueFromExpr(
				resolve_self_parsed_type(replacement, type_expr),
				value,
				span,
			)
		ParsedWithExpr(binding, body, span):
			ParsedWithExpr(
				{ binding |
					type_expr = resolve_self_optional_parsed_type(replacement, binding.type_expr)
				},
				body,
				span,
			)
		ParsedLambdaExpr(is_pure, params, return_type, body, span):
			ParsedLambdaExpr(
				is_pure,
				params.map(
					func(
						param,
					): { param |
						type_expr = resolve_self_optional_parsed_type(replacement, param.type_expr)
					},
				),
				resolve_self_optional_parsed_type(replacement, return_type),
				body,
				span,
			)
		ParsedFunctionDeclExpr(decl):
			ParsedFunctionDeclExpr(resolve_self_parsed_function(replacement, decl))
		ParsedVarDeclExpr(name, type_expr, value, is_mutable, span):
			ParsedVarDeclExpr(
				name,
				resolve_self_optional_parsed_type(replacement, type_expr),
				value,
				is_mutable,
				span,
			)
		ParsedQuestionBindExpr(name, type_expr, value, span):
			ParsedQuestionBindExpr(
				name,
				resolve_self_optional_parsed_type(replacement, type_expr),
				value,
				span,
			)
		_:
			with_children


private pure func default_impl_method_decl(
	impl_decl: ParsedImplDecl,
	method: ParsedTraitMethodDecl,
) -> ParsedFunctionDecl:
	replacement: ParsedTypeExpr = impl_decl.for_type
	{
		name = method.name,
		keyword_span = None,
		type_params = [],
		params = method.params.map(func(param): resolve_self_parsed_param(replacement, param)),
		return_type = resolve_self_optional_parsed_type(replacement, method.return_type),
		dim_constraints = [],
		body = method.body.map(func(body): resolve_self_parsed_expr(replacement, body)),
		is_pure = method.is_pure,
		annotations = [],
		doc = None,
		span = impl_decl.span
	}


private pure func find_imported_trait_decl(
	import_modules: List[ImportableModule],
	module_path: String,
	trait_name: String,
) -> Option[ParsedTraitDecl]:
	var result: Option[ParsedTraitDecl] = None

	for module in import_modules:
		if importable_module_path(module) == module_path:
			result = find_trait_decl(importable_module_decls(module), trait_name)
			break

	result


private pure func find_prelude_trait_decl(
	import_modules: List[ImportableModule],
	trait_name: String,
) -> Option[ParsedTraitDecl]:
	var result: Option[ParsedTraitDecl] = None

	for module in import_modules:
		if prelude_traits_module_matches(
			importable_module_origin(module),
			importable_module_path(module),
			importable_module_surface_value(module).module_name,
		):
			result = find_trait_decl(importable_module_decls(module), trait_name)
			break

	result


private pure func find_impl_trait_decl(
	state: TypecheckState,
	decls: List[ParsedDecl],
	import_modules: List[ImportableModule],
	trait_name: String,
) -> Option[ParsedTraitDecl]:
	match find_trait_decl(decls, trait_name):
		Some(trait_decl):
			Some(trait_decl)
		None:
			match typecheck_state_find_imported_name(state, trait_name):
				Some(binding):
					find_imported_trait_decl(
						import_modules,
						binding.module_path,
						binding.original_name,
					)
				None:
					if builtin_trait_is_prelude(trait_name):
						find_prelude_trait_decl(import_modules, trait_name)
					else:
						None


private pure func add_impl_body_trait_functions(
	state: TypecheckState,
	trait_name: String,
) -> TypecheckState:
	var next = state

	for pair in typecheck_trait_methods_with_declaring_trait(state, trait_name):
		next = { next | env = env_add_trait_function(next.env, pair[0], pair[1]) }
		next = typecheck_state_add_scoped_trait_function(next, pair[0], pair[1])

	next


private pure func typecheck_validate_impl_decl(
	state: TypecheckState,
	impl_decl: ParsedImplDecl,
	for_type: SemanticType,
) -> TypecheckState:
	if not trait_visible_for_impl(state, impl_decl.trait_name.text):
		typecheck_state_add_error(
			state,
			impl_error_message(
				impl_decl,
				for_type,
				"unknown trait '" + impl_decl.trait_name.text + "'",
			),
		)
	else:
		typecheck_validate_visible_impl_decl(state, impl_decl, for_type)


private pure func trait_visible_for_impl(state: TypecheckState, trait_name: String) -> Bool:
	match typecheck_state_find_top_level_name(state, trait_name):
		Some(kind):
			kind == TopLevelTrait
		None:
			match typecheck_state_find_imported_name(state, trait_name):
				Some(_):
					True
				None:
					match typecheck_find_trait(state, trait_name):
						Some(trait_def):
							match trait_def.module_path:
								Some(module_path):
									module_path == "traits"
								None:
									True
						None:
							False


private pure func typecheck_validate_visible_impl_decl(
	state: TypecheckState,
	impl_decl: ParsedImplDecl,
	for_type: SemanticType,
) -> TypecheckState:
	match typecheck_find_trait(state, impl_decl.trait_name.text):
		Some(trait_def):
			with_required = impl_validate_required_methods(
				state,
				impl_decl,
				for_type,
				trait_def.methods,
			)
			with_supertraits = impl_validate_supertraits(
				with_required,
				impl_decl,
				for_type,
				trait_def.supertraits,
			)
			impl_validate_method_signatures(
				with_supertraits,
				impl_decl,
				for_type,
				trait_def.methods,
			)
		None:
			typecheck_state_add_error(
				state,
				impl_error_message(
					impl_decl,
					for_type,
					"unknown trait '" + impl_decl.trait_name.text + "'",
				),
			)


private pure func typecheck_materialize_impl_body(
	state: TypecheckState,
	decls: List[ParsedDecl],
	import_modules: List[ImportableModule],
	impl_decl: ParsedImplDecl,
	function_bodies: FunctionBodyMaterialization,
) -> TypecheckImplBodyResult:
	raw_for_type: SemanticType = canonical_annotation_type(
		state,
		type_from_parsed_type_expr(impl_decl.for_type),
	)
	for_type: SemanticType = impl_normalize_receiver_type(state, impl_decl.for_type, raw_for_type)
	bounds: List[BoundTypeParam] = impl_bounds_for_decl_type(state, impl_decl.for_type, for_type)

	state_with_bounds = if bounds.length() == 0:
		state
	else:
		{ state | env = env_extend_type_param_bounds(state.env, bounds) }

	validated = typecheck_validate_impl_decl(state_with_bounds, impl_decl, for_type)

	if validated.errors.length() > state.errors.length():
		{
			state = typecheck_with_body_env(state.env, validated),
			typed = {
				decl = impl_decl,
				for_type = for_type,
				type_params = bounds,
				methods = []
			}
		}
	else:
		body_state = add_impl_body_trait_functions(validated, impl_decl.trait_name.text)

		var next = body_state
		var typed_methods: List[TypedFunctionInfo] = []

		for method in impl_decl.methods:
			method_result = typecheck_materialize_function_from_body_policy(
				next,
				method,
				IgnoreMainName,
				function_bodies,
			)
			next = method_result.state
			typed_methods = typed_methods.append(method_result.typed)

		if collect_type_vars(for_type).length() == 0:
			match find_impl_trait_decl(next, decls, import_modules, impl_decl.trait_name.text):
				Some(trait_decl):
					for method in trait_decl.methods:
						if (
							method.body.is_some()
							and not impl_has_method(impl_decl.methods, method.name.text)
						):
							default_decl = default_impl_method_decl(impl_decl, method)
							callable_key = callable_key_from_span(
								next,
								default_decl.name.text,
								default_decl.span,
							)

							match typecheck_state_claim_func_callable_id(next, callable_key):
								DefinitionIdMissing(with_error):
									next = with_error
								DefinitionIdClaimed(with_id, _):
									method_result = typecheck_materialize_function_from_body_policy(
										with_id,
										default_decl,
										IgnoreMainName,
										function_bodies,
									)
									next = method_result.state
									typed_methods = typed_methods.append(method_result.typed)
				None:
					void

		{
			state = typecheck_state_with_scoped_trait_functions(
				typecheck_with_body_env(state.env, next),
				state.scoped_trait_functions,
			),
			typed = {
				decl = impl_decl,
				for_type = for_type,
				type_params = bounds,
				methods = typed_methods
			}
		}


private pure func typed_foreign_link_flag(arg: ParsedForeignBlockArg) -> List[TypedForeignLinkFlag]:
	match arg.name.text:
		"link":
			[
				{
					platform = None,
					flag = arg.value
				},
			]
		"link_linux":
			[
				{
					platform = Some(TypedForeignLinux),
					flag = arg.value
				},
			]
		"link_macos":
			[
				{
					platform = Some(TypedForeignMacos),
					flag = arg.value
				},
			]
		_:
			[]


private pure func typed_foreign_function_info(
	state: TypecheckState,
	block_args: List[ParsedForeignBlockArg],
	block_span: SourceSpan,
	decl: ParsedForeignFunctionDecl,
) -> TypedForeignFunctionInfo:
	name: String = decl.name.text
	param_types: List[SemanticType] = decl.params
		.map(func(param): type_from_optional_parsed_type_expr(param.type_expr))
		.map(func(param_type): canonical_annotation_type(state, param_type))
	return_type: SemanticType = canonical_annotation_type(
		state,
		type_from_parsed_type_expr(decl.return_type),
	)

	arg_passing: TypedForeignArgPassing = if (
		decl.is_pure
		or decl.annotations.any(annotation_is_no_copy)
	):
		TypedForeignBorrowArgs
	else:
		TypedForeignDefaultArgs

	includes: List[String] = block_args.filter_map(func(arg):
		if arg.name.text == "include":
			Some(arg.value)
		else:
			None
	)

	{
		decl = decl,
		callable_id = typecheck_state_find_func_callable_id(
			state,
			callable_key_from_span(state, name, decl.span),
		),
		param_types = param_types,
		semantic_return_type = return_type,
		c_name = decl.c_name.get_or(name),
		includes = includes,
		link_flags = block_args.flat_map(typed_foreign_link_flag),
		arg_passing = arg_passing,
		block_span = block_span
	}


private pure func typed_foreign_block(
	state: TypecheckState,
	block_args: List[ParsedForeignBlockArg],
	functions: List[ParsedForeignFunctionDecl],
	block_span: SourceSpan,
) -> TypedForeignBlockResult:
	var next_state: TypecheckState = state
	var typed_decls: List[TypedDecl] = []

	for function_decl in functions:
		info: TypedForeignFunctionInfo = typed_foreign_function_info(
			state,
			block_args,
			block_span,
			function_decl,
		)

		for error in validate_foreign_function(
			state.env,
			module_view_accepted_record_authority(state.module_view),
			module_view_accepted_union_authority(state.module_view),
			block_args,
			function_decl,
			info.param_types,
			info.semantic_return_type,
			typed_foreign_arg_passing_borrows(info.arg_passing),
		):
			next_state = typecheck_state_add_error(next_state, error)

		typed_decls = typed_decls.append(TypedForeignFunctionDecl(info))

	{
		state = next_state,
		decls = typed_decls
	}


private union GlobalBodyMaterialization:
	InferStandaloneGlobalBodies
	ReuseAcceptedGlobalBodies(CompletedGlobalHeaderGraph)


pure func body_check_outcome_callable_id(outcome: BodyCheckOutcome) -> CallableId:
	match outcome:
		BodyCheckAccepted(artifact):
			from_opaque CheckedBodyArtifact(artifact).id
		BodyCheckRejected(artifact):
			from_opaque RecoveredBodyArtifact(artifact).id


pure func body_check_outcome_typed_function(outcome: BodyCheckOutcome) -> TypedFunctionInfo:
	match outcome:
		BodyCheckAccepted(artifact):
			from_opaque CheckedBodyArtifact(artifact).typed
		BodyCheckRejected(artifact):
			from_opaque RecoveredBodyArtifact(artifact).typed


private pure func body_check_outcome_plan_provenance(
	outcome: BodyCheckOutcome,
) -> BodyPlanProvenance:
	match outcome:
		BodyCheckAccepted(artifact):
			from_opaque CheckedBodyArtifact(artifact).plan_provenance
		BodyCheckRejected(artifact):
			from_opaque RecoveredBodyArtifact(artifact).plan_provenance


private pure func body_check_outcome_main_policy(outcome: BodyCheckOutcome) -> MainValidationPolicy:
	match outcome:
		BodyCheckAccepted(artifact):
			from_opaque CheckedBodyArtifact(artifact).main_policy
		BodyCheckRejected(artifact):
			from_opaque RecoveredBodyArtifact(artifact).main_policy


pure func body_check_outcome_errors(outcome: BodyCheckOutcome) -> List[String]:
	match outcome:
		BodyCheckAccepted(_):
			[]
		BodyCheckRejected(artifact):
			from_opaque RecoveredBodyArtifact(artifact).errors


pure func body_check_outcome_diagnostics(outcome: BodyCheckOutcome) -> List[TypecheckDiagnostic]:
	match outcome:
		BodyCheckAccepted(_):
			[]
		BodyCheckRejected(artifact):
			from_opaque RecoveredBodyArtifact(artifact).diagnostics


private pure func body_outcome_index_find(
	index: BodyOutcomeIndex,
	id: CallableId,
) -> Option[BodyCheckOutcome]:
	representation = from_opaque BodyOutcomeIndex(index)

	if module_identities_equal(representation.owner, callable_id_module_identity(id)):
		representation.by_definition_id.get(callable_id_definition_id(id))
	else:
		None


private pure func body_outcome_index_find_definition_id(
	index: BodyOutcomeIndex,
	definition_id: Int,
) -> Option[BodyCheckOutcome]:
	representation = from_opaque BodyOutcomeIndex(index)
	representation.by_definition_id.get(definition_id)


private pure func apply_body_check_outcome_diagnostics(
	state: TypecheckState,
	outcome: BodyCheckOutcome,
) -> TypecheckState:
	match outcome:
		BodyCheckAccepted(_):
			state
		BodyCheckRejected(artifact):
			recovered = from_opaque RecoveredBodyArtifact(artifact)
			{ state |
				errors = state.errors.concat(recovered.errors),
				diagnostics = state.diagnostics.concat(recovered.diagnostics)
			}


private pure func body_outcome_for_function_decl(
	state: TypecheckState,
	function_decl: ParsedFunctionDecl,
	outcomes: BodyOutcomeIndex,
	callable_headers: CallableHeaderGraph,
) -> Option[BodyCheckOutcome]:
	match typecheck_state_find_func_callable_id(
		state,
		callable_key_from_span(state, function_decl.name.text, function_decl.span),
	):
		Some(definition_id):
			match callable_header_graph_find_definition_id(callable_headers, definition_id):
				Some(header):
					body_outcome_index_find(outcomes, callable_header_id(header))
				None:
					body_outcome_index_find_definition_id(outcomes, definition_id)
		None:
			None


private pure func typecheck_materialize_function_from_body_policy(
	state: TypecheckState,
	function_decl: ParsedFunctionDecl,
	main_policy: MainValidationPolicy,
	function_bodies: FunctionBodyMaterialization,
) -> TypecheckFunctionBodyResult:
	match function_bodies:
		InferStandaloneFunctionBodies:
			typecheck_materialize_function_body_with_options(state, function_decl, main_policy)
		ReuseIndependentFunctionBodies(outcomes, callable_headers):
			callable_id = typecheck_state_find_func_callable_id(
				state,
				callable_key_from_span(state, function_decl.name.text, function_decl.span),
			)
			outcome = body_outcome_for_function_decl(
				state,
				function_decl,
				outcomes,
				callable_headers,
			)

			match outcome:
				Some(found):
					{
						state = apply_body_check_outcome_diagnostics(state, found),
						typed = body_check_outcome_typed_function(found)
					}
				None:
					header: Option[CallableHeader] = match callable_id:
						Some(definition_id):
							callable_header_graph_find_definition_id(
								callable_headers,
								definition_id,
							)
						None:
							None

					match header:
						Some(found_header):
							if callable_header_body_category(found_header) != SourceCallableBody:
								typecheck_materialize_function_body_with_options(
									state,
									function_decl,
									main_policy,
								)
							else:
								missing_body_artifact_result(
									state,
									function_decl,
									"source callable",
								)
						None:
							missing_body_artifact_result(
								state,
								function_decl,
								"implementation method",
							)


private pure func missing_body_artifact_result(
	state: TypecheckState,
	function_decl: ParsedFunctionDecl,
	body_kind: String,
) -> TypecheckFunctionBodyResult:
	signature = function_body_signature(state, function_decl)
	{
		state = typecheck_state_add_error(
			state,
			"internal typecheck error: independently checked body artifact is missing for '" + function_decl.name.text + "' (" + body_kind + ")",
		),
		typed = typed_function_info(function_decl, signature, None)
	}


private pure func typecheck_materialize_decl_body(
	state: TypecheckState,
	module_path: String,
	decls: List[ParsedDecl],
	import_modules: List[ImportableModule],
	global_bodies: GlobalBodyMaterialization,
	function_bodies: FunctionBodyMaterialization,
	decl: ParsedDecl,
	main_policy: MainValidationPolicy,
) -> TypecheckDeclBodyResult:
	match decl:
		FunctionParsedDecl(function_decl):
			result = typecheck_materialize_function_from_body_policy(
				state,
				function_decl,
				main_policy,
				function_bodies,
			)
			{
				state = result.state,
				decl = TypedFunctionDecl(result.typed)
			}
		VarParsedDecl(var_decl):
			match global_bodies:
				InferStandaloneGlobalBodies:
					result = typecheck_materialize_global_var_body(state, module_path, var_decl)
					{
						state = result.state,
						decl = TypedGlobalVarDecl(result.typed)
					}
				ReuseAcceptedGlobalBodies(completed_globals):
					accepted = module_view_accepted_global_authority(state.module_view)
						.and_then(
							func(authority): accepted_global_find(authority, var_decl.name.text),
						)
						.and_then(
							func(
								binding,
							): completed_global_header_graph_find(completed_globals, binding.id),
						)

					match accepted:
						Some(completed):
							{
								state = state,
								decl = TypedGlobalVarDecl(completed_global_header_typed(completed))
							}
						None:
							{
								state = typecheck_state_add_error(
									state,
									(
										"internal typecheck error: accepted global initializer is absent from completed "
										+ "graph"
									),
								),
								decl = TypedParsedDecl(decl)
							}
		RecordParsedDecl(record_decl):
			{
				state = state,
				decl = TypedRecordDecl(typed_record_from_parsed(state, record_decl))
			}
		UnionParsedDecl(union_decl):
			typed_union = typed_union_from_parsed(state, union_decl)
			var next_state = state

			match module_view_accepted_union_authority(state.module_view):
				Some(_):
					for variant in typed_union.variants:
						if variant.def_id.is_none():
							next_state = typecheck_state_add_error_at(
								next_state,
								variant.selection_span,
								"internal typecheck error: accepted constructor '" + variant.name + "' is absent from the union authority",
							)
				None:
					void

			{
				state = next_state,
				decl = TypedUnionDecl(typed_union)
			}
		TypeAliasParsedDecl(alias_decl):
			{
				state = state,
				decl = TypedTypeAliasDecl(typed_type_alias_from_parsed(state, alias_decl))
			}
		TraitParsedDecl(trait_decl):
			{
				state = state,
				decl = TypedTraitDecl(typed_trait_from_parsed(state, trait_decl))
			}
		ImplParsedDecl(impl_decl):
			result = typecheck_materialize_impl_body(
				state,
				decls,
				import_modules,
				impl_decl,
				function_bodies,
			)
			{
				state = result.state,
				decl = TypedImplDecl(result.typed)
			}
		PrivateParsedDecl(inner, _):
			result = typecheck_materialize_decl_body(
				state,
				module_path,
				decls,
				import_modules,
				global_bodies,
				function_bodies,
				inner,
				main_policy,
			)
			{
				state = result.state,
				decl = TypedPrivateDecl(result.decl)
			}
		_:
			{
				state = state,
				decl = TypedParsedDecl(decl)
			}


pure func typecheck_check_standalone_program_bodies(
	state: TypecheckState,
	program: ParsedProgram,
) -> TypecheckState:
	typecheck_materialize_standalone_program_bodies(state, program).state


pure func typecheck_materialize_standalone_program_bodies(
	state: TypecheckState,
	program: ParsedProgram,
) -> TypecheckProgramResult:
	typecheck_materialize_standalone_program_bodies_with_import_modules(
		state,
		program,
		[],
		InferStandaloneGlobalBodies,
		InferStandaloneFunctionBodies,
		ValidateProgramMain,
	)


private pure func typecheck_materialize_standalone_program_bodies_with_import_modules(
	state: TypecheckState,
	program: ParsedProgram,
	import_modules: List[ImportableModule],
	global_bodies: GlobalBodyMaterialization,
	function_bodies: FunctionBodyMaterialization,
	main_policy: MainValidationPolicy,
) -> TypecheckProgramResult:
	var next_state = state
	var typed_decls: List[TypedDecl] = []

	for decl in program.decls:
		next_state = typecheck_state_reset_type_shape_memo(next_state)

		match decl:
			ForeignBlockParsedDecl(block_args, functions, block_span):
				foreign_result: TypedForeignBlockResult = typed_foreign_block(
					next_state,
					block_args,
					functions,
					block_span,
				)
				next_state = foreign_result.state
				typed_decls = typed_decls.concat(foreign_result.decls)
			_:
				result = typecheck_materialize_decl_body(
					next_state,
					program.source.module_name,
					program.decls,
					import_modules,
					global_bodies,
					function_bodies,
					decl,
					main_policy,
				)
				next_state = result.state
				typed_decls = typed_decls.append(result.decl)

	typecheck_validate_typed_program({
		state = typecheck_state_reset_type_shape_memo(next_state),
		program = typed_program_from_decls(next_state, program, typed_decls),
	})


private func typecheck_materialize_standalone_program_bodies_with_import_modules_with_trace(
	state: TypecheckState,
	program: ParsedProgram,
	import_modules: List[ImportableModule],
	global_bodies: GlobalBodyMaterialization,
	function_bodies: FunctionBodyMaterialization,
	trace: (TypecheckTracePhase, Int) -> Void,
	main_policy: MainValidationPolicy,
) -> TypecheckProgramResult:
	var next_state = state
	var typed_decls: List[TypedDecl] = []
	var decl_index: Int = 0

	for decl in program.decls:
		trace(BodyDeclStart, decl_index)
		next_state = typecheck_state_reset_type_shape_memo(next_state)

		match decl:
			ForeignBlockParsedDecl(block_args, functions, block_span):
				foreign_result: TypedForeignBlockResult = typed_foreign_block(
					next_state,
					block_args,
					functions,
					block_span,
				)
				next_state = foreign_result.state
				typed_decls = typed_decls.concat(foreign_result.decls)
			_:
				result = typecheck_materialize_decl_body(
					next_state,
					program.source.module_name,
					program.decls,
					import_modules,
					global_bodies,
					function_bodies,
					decl,
					main_policy,
				)
				next_state = result.state
				typed_decls = typed_decls.append(result.decl)

		trace(BodyDeclComplete, decl_index)
		decl_index += 1

	typecheck_validate_typed_program({
		state = typecheck_state_reset_type_shape_memo(next_state),
		program = typed_program_from_decls(next_state, program, typed_decls),
	})


private pure func replay_accepted_trait_definition_id(
	state: TypecheckState,
	id: TraitId,
) -> TypecheckState:
	definition_key = source_definition_key(
		typecheck_state_module_identity(state),
		TraitDefinition,
		trait_id_name(id),
		None,
		trait_id_source_span(id),
	)

	match typecheck_state_claim_source_definition_id(state, definition_key):
		DefinitionIdMissing(with_error):
			with_error
		DefinitionIdClaimed(with_id, definition_id):
			if definition_id == trait_id_definition_id(id):
				with_id
			else:
				typecheck_state_add_error(
					with_id,
					(
						"internal typecheck error: trait header definition ID does not match its "
						+ "reserved module ID"
					),
				)


private pure func replay_accepted_implementation_method_definition_id(
	state: TypecheckState,
	id: CallableId,
) -> TypecheckState:
	callable_key = callable_key_from_span(state, callable_id_name(id), callable_id_source_span(id))

	match typecheck_state_claim_func_callable_id(state, callable_key):
		DefinitionIdMissing(with_error):
			with_error
		DefinitionIdClaimed(with_id, definition_id):
			if definition_id == callable_id_definition_id(id):
				with_id
			else:
				typecheck_state_add_error(
					with_id,
					(
						"internal typecheck error: implementation method header definition ID does not "
						+ "match its reserved module ID"
					),
				)


private pure func replay_accepted_implementation_definition_ids(
	state: TypecheckState,
	definition_ids: AcceptedImplementationDefinitionIds,
) -> TypecheckState:
	var next = state

	for method_id in definition_ids.method_ids:
		next = replay_accepted_implementation_method_definition_id(next, method_id)

	id = definition_ids.id
	definition_key = source_definition_key(
		typecheck_state_module_identity(next),
		ImplDefinition,
		impl_id_name(id),
		None,
		impl_id_source_span(id),
	)

	match typecheck_state_claim_source_definition_id(next, definition_key):
		DefinitionIdMissing(with_error):
			with_error
		DefinitionIdClaimed(with_id, definition_id):
			if definition_id == impl_id_definition_id(id):
				with_id
			else:
				typecheck_state_add_error(
					with_id,
					(
						"internal typecheck error: implementation header definition ID does not match "
						+ "its reserved module ID"
					),
				)


private pure func typecheck_state_after_accepted_definition_id_replay(
	state: TypecheckState,
	bound_module: BoundModule,
	type_headers: TypeHeaderGraph,
	trait_implementation_table: AcceptedTraitImplementationTable,
	module_identity: ModuleIdentity,
	module_path: String,
) -> TypecheckState:
	with_builtin_headers = typecheck_install_local_builtin_headers(
		state,
		type_headers,
		bound_module_scope(bound_module),
		module_path,
	)
	with_record_headers = typecheck_install_local_record_headers(
		with_builtin_headers,
		type_headers,
		bound_module_scope(bound_module),
		module_path,
	)
	with_union_headers = typecheck_install_local_union_headers(
		with_record_headers,
		type_headers,
		bound_module_scope(bound_module),
		module_path,
	)
	with_types = typecheck_install_local_alias_headers(
		with_union_headers,
		type_headers,
		bound_module_scope(bound_module),
		module_path,
	)
	-- CTFE creates a fresh body-inference session, so it must replay the IDs reserved
	-- by header preparation. Accepted trait and implementation semantics remain owned
	-- by the graph table attached to ModuleView; replay must not republish them in Env.
	var with_definition_ids = with_types

	for id in accepted_trait_ids_for_owner(trait_implementation_table, module_identity):
		with_definition_ids = replay_accepted_trait_definition_id(with_definition_ids, id)

	for definition_ids in accepted_implementation_definition_ids_for_owner(
		trait_implementation_table,
		module_identity,
	):
		with_definition_ids = replay_accepted_implementation_definition_ids(
			with_definition_ids,
			definition_ids,
		)

	with_definition_ids


pure func typecheck_bind_program_module_view(
	state: TypecheckState,
	program: ParsedProgram,
	import_index: ImportableModuleIndex,
	current_module_path: String,
) -> BoundModuleViewBinding:
	module_state = typecheck_state_scope_to_program(state, program)
	program_with_prelude = program_with_prelude_imports(state, program, import_index)
	import_selection = importable_module_selection_for_program(
		program_with_prelude,
		import_index,
		Some(current_module_path),
	)
	type_import_modules = import_selection[0]
	import_surfaces = importable_module_surfaces(type_import_modules)
	direct_import_modules = import_selection[1]
	with_names = typecheck_prescan_program(module_state, program_with_prelude)
	with_imports = register_program_imports(with_names, import_surfaces, program_with_prelude)

	match with_imports.diagnostics:
		binding_diagnostics:
			match bound_module_visibility(type_import_modules, direct_import_modules):
				BoundModuleVisibilityReady(visibility):
					BoundModuleViewReady(
						with_imports.module_view,
						program_with_prelude,
						visibility,
						binding_diagnostics,
					)
				BoundModuleVisibilityDuplicateVisible(module_path):
					BoundModuleViewRejected(
						"internal typecheck error: duplicate visible module '" + module_path + "'",
						[],
					)
				BoundModuleVisibilityDuplicateDirect(module_path):
					BoundModuleViewRejected(
						"internal typecheck error: duplicate direct module '" + module_path + "'",
						[],
					)
				BoundModuleVisibilityDirectNotVisible(module_path):
					BoundModuleViewRejected(
						"internal typecheck error: direct module '" + module_path + "' is not visible",
						[],
					)


-- Standalone source tooling has no loaded module graph to validate against.
-- Preserve its syntax-level bindings explicitly rather than pretending an
-- absent module surface is a validated semantic import.
pure func typecheck_bind_standalone_program_module_view(
	state: TypecheckState,
	program: ParsedProgram,
) -> BoundModuleViewBinding:
	with_names = typecheck_prescan_program(state, program)
	with_imports = register_program_import_syntax(with_names, program)

	BoundModuleViewReady(
		with_imports.module_view,
		program,
		COMPILER_BOUND_MODULE_VISIBILITY_EMPTY,
		with_imports.diagnostics,
	)


private pure func accepted_global_binding_from_completed(
	header: CompletedGlobalHeader,
) -> AcceptedGlobalBinding:
	typed = completed_global_header_typed(header)
	canonical_type = completed_global_header_canonical_binding_type(header)

	canonical_source_type: Option[SemanticType] = if typed.source_type.is_some():
		Some(canonical_type)
	else:
		None

	{
		id = completed_global_header_id(header),
		binding_type = canonical_type,
		source_type = canonical_source_type,
		is_mutable = typed.decl.is_mutable,
		definition_id = typed.definition_id
	}


private pure func accepted_global_declared_binding(
	type_headers: TypeHeaderGraph,
	bound_module: BoundModule,
	header: GlobalHeader,
) -> Option[AcceptedGlobalBinding]:
	shape ?= annotated_global_header_type(header)
	id = global_header_id(header)
	canonical_path = bound_module_canonical_path(bound_module)
	typ ?= imported_semantic_type_from_resolved_shape(
		type_headers,
		global_id_module_identity(id),
		canonical_path,
		shape,
	)
	source = global_header_source(header)
	definition_key = source_definition_key(
		global_id_module_identity(id),
		GlobalDefinition,
		source.name.text,
		None,
		source.span,
	)

	Some({
		id = id,
		binding_type = typ,
		source_type = Some(typ),
		is_mutable = source.is_mutable,
		definition_id = definition_index_find_source_definition_id(
			prepared_module_scope_definition_index(bound_module_scope(bound_module)),
			definition_key,
		),
	})


private pure func accepted_global_table_build(
	type_headers: TypeHeaderGraph,
	callable_headers: CallableHeaderGraph,
	bound_graph: BoundModuleGraph,
) -> Result[AcceptedGlobalTable, List[String]]:
	var records: List[AcceptedGlobalTableRecord] = []
	var errors: List[String] = []

	for header in callable_header_graph_globals(callable_headers):
		id = global_header_id(header)

		match bound_module_graph_find(bound_graph, global_id_module_identity(id)):
			Some(bound_module):
				declared = accepted_global_declared_binding(type_headers, bound_module, header)

				if annotated_global_header_type(header).is_some() and declared.is_none():
					errors = errors.append(
						"accepted global table could not resolve annotated type for '" + global_id_name(
							id,
						) + "'",
					)
				else:
					records = records.append({
						id = id,
						owner_module_path = bound_module_canonical_path(bound_module),
						visibility = global_header_visibility(header),
						declared_binding = declared,
					})
			None:
				errors = errors.append(
					"accepted global table owner is absent for '" + global_id_name(id) + "'",
				)

	if not errors.is_empty():
		Err(errors)
	else:
		match accepted_global_table({globals = records}):
			Some(table):
				Ok(table)
			None:
				Err(["accepted global table rejected duplicate or mismatched identities"])


private pure func accepted_global_authority_for_module(
	table: AcceptedGlobalTable,
	bound_module: BoundModule,
) -> Result[AcceptedGlobalAuthority, String]:
	owner = bound_module_identity(bound_module)
	view = bound_module_view(bound_module)
	var bindings: List[AcceptedVisibleGlobalBinding] = []

	for imported in module_view_imported_names(view):
		bindings = bindings.append({
			source_name = imported.local_name,
			owner_module_path = imported.module_path,
			original_name = imported.original_name,
		})

	match accepted_global_authority(table, owner, bindings):
		Some(authority):
			Ok(authority)
		None:
			Err("accepted global module view rejected conflicting source bindings")


private pure func canonical_callable_entry(
	owner_entry: OverloadEntry,
	owner_module_path: String,
	local_type_names: List[String],
) -> OverloadEntry:
	{ owner_entry |
		func_type = qualify_module_local_types(
			owner_module_path,
			local_type_names,
			owner_entry.func_type,
		),
		module_path = Some(owner_module_path),
		dim_constraints = owner_entry.dim_constraints.map(
			func(
				constraint,
			): (
				qualify_module_local_types(owner_module_path, local_type_names, constraint[0]),
				qualify_module_local_types(owner_module_path, local_type_names, constraint[1]),
			),
		)
	}


private record PreparedModuleCallableBase {
	bound_module: BoundModule,
	module_path: String,
	local_type_names: List[String],
	callable_error_start: Int,
	state: TypecheckState,
	callables: List[AcceptedCallableTableRecord],
	callable_errors: List[String]
}


private pure func prepare_accepted_module_callable(
	base: PreparedModuleCallableBase,
	type_headers: TypeHeaderGraph,
	header: CallableHeader,
) -> PreparedModuleCallableBase:
	id = callable_header_id(header)
	prepared = prepare_accepted_callable_header(
		base.state,
		type_headers,
		header,
		LocalCallableHeaderRegistration(base.module_path),
	)

	match prepared.entry:
		Some(entry):
			{ base |
				state = prepared.state,
				callables = base.callables.append({
					id = id,
					owner_module_path = base.module_path,
					source_name = callable_id_name(id),
					visibility = callable_header_visibility(header),
					entry = canonical_callable_entry(
						entry,
						base.module_path,
						base.local_type_names,
					),
				})
			}
		None:
			{ base | state = prepared.state }


private pure func accepted_callable_authority_for_module(
	table: AcceptedCallableTable,
	bound_module: BoundModule,
) -> Result[AcceptedCallableAuthority, String]:
	view = bound_module_view(bound_module)
	var bindings: List[AcceptedVisibleCallableBinding] = []

	for imported in module_view_imported_names(view):
		bindings = bindings.append({
			source_name = imported.local_name,
			owner_module_path = imported.module_path,
			original_name = imported.original_name,
		})

	direct_module_paths = bound_module_direct_import_modules(
		bound_module,
	).map(importable_module_path)

	match accepted_callable_authority(
		table,
		bound_module_identity(bound_module),
		bindings,
		direct_module_paths,
	):
		Some(authority):
			Ok(authority)
		None:
			Err("accepted callable module view rejected conflicting source bindings")


private pure func accepted_trait_implementation_authority_for_module(
	table: AcceptedTraitImplementationTable,
	bound_module: BoundModule,
) -> AcceptedTraitImplementationAuthority:
	view = bound_module_view(bound_module)
	var bindings: List[AcceptedVisibleTraitBinding] = []

	for imported in module_view_imported_names(view):
		bindings = bindings.append({
			source_name = imported.local_name,
			owner_module_path = imported.module_path,
			original_name = imported.original_name,
		})

	accepted_trait_implementation_authority(
		table,
		bound_module_identity(bound_module),
		bindings,
		bound_module_direct_import_modules(
			bound_module,
		).map(
			func(
				module,
			): prepared_module_scope_identity(importable_module_prepared_scope(module)),
		),
	)


-- Immutable accepted module facts shared by initializer and ordinary body
-- sessions. Session-owned diagnostics, inference bindings, lexical scopes,
-- containment snapshots, and memo answers cannot be represented here.
private record PreparedCanonicalModuleEnvironment {
	bound_module: BoundModule,
	context_facts: PreparedInferContextFacts,
	declaration_env: PreparedModuleDeclarationEnv,
	module_facts: InferModuleFacts
}


-- Declaration-policy findings belong to graph completion, not to the reusable
-- module environment or any initializer/inference session.
private record PreparedModuleIssues {
	module_identity: ModuleIdentity,
	errors: List[String],
	diagnostics: List[TypecheckDiagnostic],
	callable_errors: List[String]
}


private record PreparedModuleEnvironmentCollection {
	environments: List[PreparedCanonicalModuleEnvironment],
	issues: List[PreparedModuleIssues],
	accepted_callable_table: Option[AcceptedCallableTable],
	accepted_trait_implementation_table: Option[AcceptedTraitImplementationTable]
}


private record InitializerCheckContext {
	module_environment: PreparedCanonicalModuleEnvironment,
	completed_dependencies: List[CompletedGlobalHeader]
}


-- Prepare immutable module facts once. Each initializer receives a value copy
-- of this state, so inference metas and diagnostics remain initializer-local.
private pure func prepared_module_environment_base_state(
	bound_module: BoundModule,
	type_headers: TypeHeaderGraph,
	accepted_global_table: AcceptedGlobalTable,
	accepted_alias_graph: AcceptedAliasGraph,
	accepted_record_graph: AcceptedRecordGraph,
	accepted_union_graph: AcceptedUnionGraph,
	allow_debug_only_calls: Bool,
) -> TypecheckState:
	program = bound_module_program(bound_module)
	view = bound_module_view(bound_module)
	visible_import_modules = bound_module_visible_import_modules(bound_module)
	import_surfaces = importable_module_surfaces(visible_import_modules)
	base = typecheck_state_for_prepared_module_scope(
		bound_module_scope(bound_module),
		allow_debug_only_calls,
	)
	with_known_types = typecheck_prescan_known_type_names(base, program)
	var with_view = { with_known_types | module_view = view }

	for diagnostic in bound_module_binding_diagnostics(bound_module):
		with_view = typecheck_state_add_diagnostic(with_view, diagnostic)

	type_alias_authority = prepare_type_alias_authority(
		accepted_alias_graph,
		type_headers,
		bound_module,
		with_view,
	)
	record_type_authority = prepare_record_type_authority(
		accepted_record_graph,
		type_headers,
		bound_module,
		type_alias_authority.state,
	)
	union_type_authority = prepare_union_type_authority(
		accepted_union_graph,
		type_headers,
		bound_module,
		record_type_authority.state,
	)
	with_type_authority = typecheck_state_with_accepted_type_authority(
		union_type_authority.state,
		type_alias_authority.authority,
		record_type_authority.authority,
		union_type_authority.authority,
	)
	global_authority = accepted_global_authority_for_module(accepted_global_table, bound_module)

	with_global_authority = match global_authority:
		Ok(authority):
			{ with_type_authority |
				module_view = module_view_with_accepted_global_authority(
					with_type_authority.module_view,
					authority,
				)
			}
		Err(message):
			typecheck_state_add_error(with_type_authority, "internal typecheck error: " + message)

	with_import_type_facts = register_module_view_type_facts(
		with_global_authority,
		import_surfaces,
		view,
	)
	with_import_decls = typecheck_register_import_modules_from(
		with_import_type_facts,
		visible_import_modules,
		type_headers,
	)
	canonical_path = bound_module_canonical_path(bound_module)
	with_builtin_headers = typecheck_install_local_builtin_headers(
		with_import_decls,
		type_headers,
		bound_module_scope(bound_module),
		canonical_path,
	)
	with_record_headers = typecheck_install_local_record_headers(
		with_builtin_headers,
		type_headers,
		bound_module_scope(bound_module),
		canonical_path,
	)
	with_union_headers = typecheck_install_local_union_headers(
		with_record_headers,
		type_headers,
		bound_module_scope(bound_module),
		canonical_path,
	)
	with_types = typecheck_install_local_alias_headers(
		with_union_headers,
		type_headers,
		bound_module_scope(bound_module),
		canonical_path,
	)
	with_types


private pure func prepared_canonical_module_environment(
	bound_module: BoundModule,
	base_state: TypecheckState,
) -> Option[PreparedCanonicalModuleEnvironment]:
	declaration_env ?= prepare_module_declaration_env(base_state.env)
	Some({
		bound_module = bound_module,
		context_facts = prepared_infer_context_facts(base_state.context),
		declaration_env = declaration_env,
		module_facts = infer_module_facts_from_typecheck_state(base_state),
	})


private pure func implementation_method_header_is_explicit(
	header: ImplementationMethodHeader,
) -> Bool:
	match header:
		DefaultImplementationMethodHeaderValue(_):
			False
		ExplicitImplementationMethodHeaderValue(_):
			True


private pure func prepared_module_environments(
	implementation_headers: ImplementationHeaderGraph,
	accepted_global_table: AcceptedGlobalTable,
	accepted_alias_graph: AcceptedAliasGraph,
	accepted_record_graph: AcceptedRecordGraph,
	accepted_union_graph: AcceptedUnionGraph,
	allow_debug_only_calls: Bool,
) -> PreparedModuleEnvironmentCollection:
	callable_headers = implementation_header_graph_callable_headers(implementation_headers)
	type_headers = trait_topology_graph_type_headers(
		callable_header_graph_trait_topology(callable_headers),
	)
	bound_graph = type_header_graph_bound_graph(type_headers)
	modules = [
		bound_module_graph_target(bound_graph),
	].concat(bound_module_graph_modules(bound_graph))
	var prepared: List[PreparedCanonicalModuleEnvironment] = []
	var issues: List[PreparedModuleIssues] = []
	var bases: List[PreparedModuleCallableBase] = []
	var base_indices_by_module: Dict[String, Int] = {}
	var callable_records: List[AcceptedCallableTableRecord] = []
	var callable_owner_missing: Bool = False
	var trait_records: List[AcceptedTraitTableRecord] = []
	var implementation_records: List[AcceptedImplementationTableRecord] = []
	var trait_implementation_owner_missing: Bool = False

	for bound_module in modules:
		base_state = prepared_module_environment_base_state(
			bound_module,
			type_headers,
			accepted_global_table,
			accepted_alias_graph,
			accepted_record_graph,
			accepted_union_graph,
			allow_debug_only_calls,
		)
		base_indices_by_module = base_indices_by_module.set(
			module_identity_storage_key(bound_module_identity(bound_module)),
			bases.length(),
		)
		bases = bases.append({
			bound_module = bound_module,
			module_path = bound_module_canonical_path(bound_module),
			local_type_names = local_type_names_from_decls(
				bound_module_program(bound_module).decls,
			),
			callable_error_start = base_state.errors.length(),
			state = base_state,
			callables = [],
			callable_errors = [],
		})

	for header in trait_topology_graph_headers(
		callable_header_graph_trait_topology(callable_headers),
	):
		module_key = module_identity_storage_key(
			trait_id_module_identity(trait_topology_header_id(header)),
		)

		match base_indices_by_module.get(module_key):
			Some(index):
				match bases.get(index):
					Some(base):
						program = bound_module_program(base.bound_module)
						is_prelude_traits = prelude_traits_module_matches(
							prepared_module_scope_origin(bound_module_scope(base.bound_module)),
							base.module_path,
							program.source.module_name,
						)

						compiler_builtin_id = if is_prelude_traits:
							builtin_trait_id(trait_id_name(trait_topology_header_id(header)))
						else:
							None

						match prepare_accepted_trait_header(
							base.state,
							type_headers,
							header,
							base.module_path,
							base.local_type_names,
							compiler_builtin_id,
						):
							AcceptedTraitRecordClaimed(with_trait, item):
								bases = bases.set(index, { base | state = with_trait })
								trait_records = trait_records.append(item)
							AcceptedTraitRecordMissing(with_error):
								bases = bases.set(index, { base | state = with_error })
								trait_implementation_owner_missing = True
					None:
						trait_implementation_owner_missing = True
			None:
				trait_implementation_owner_missing = True

	-- Callable and implementation annotation conversion can consult local and
	-- imported traits through a trait-only projection. Accepted traits never
	-- need a provisional Env publication.
	preliminary_trait_table = if trait_implementation_owner_missing:
		None
	else:
		accepted_trait_implementation_table({
			traits = trait_records,
			implementations = [],
		})

	var preliminary_base_index: Int = 0

	while preliminary_base_index < bases.length():
		match bases.get(preliminary_base_index):
			Some(base):
				var with_authority = base.state

				match preliminary_trait_table:
					Some(table):
						authority = accepted_trait_implementation_authority_for_module(
							table,
							base.bound_module,
						)
						with_authority = { with_authority |
							module_view = module_view_with_accepted_trait_implementation_authority(
								with_authority.module_view,
								authority,
							)
						}
					None:
						with_authority = typecheck_state_add_error(
							with_authority,
							"internal typecheck error: accepted trait table rejected prepared entries",
						)

				bases = bases.set(
					preliminary_base_index,
					{ base |
						state = with_authority,
						callable_error_start = with_authority.errors.length()
					},
				)
			None:
				trait_implementation_owner_missing = True

		preliminary_base_index += 1

	for header in callable_header_graph_callables(callable_headers):
		module_key = module_identity_storage_key(
			callable_id_module_identity(callable_header_id(header)),
		)

		match base_indices_by_module.get(module_key):
			Some(index):
				match bases.get(index):
					Some(base):
						bases = bases.set(
							index,
							prepare_accepted_module_callable(base, type_headers, header),
						)
					None:
						callable_owner_missing = True
			None:
				callable_owner_missing = True

	var base_index: Int = 0

	while base_index < bases.length():
		match bases.get(base_index):
			Some(with_callables):
				base = { with_callables |
					callable_errors = with_callables.state.errors.drop(
						with_callables.callable_error_start,
					)
				}
				bases = bases.set(base_index, base)
				callable_records = callable_records.concat(base.callables)
			None:
				callable_owner_missing = True

		base_index += 1

	callable_table = if callable_owner_missing:
		None
	else:
		accepted_callable_table({callables = callable_records})

	for header in implementation_header_graph_headers(implementation_headers):
		module_key = module_identity_storage_key(
			impl_id_module_identity(implementation_header_id(header)),
		)

		match base_indices_by_module.get(module_key):
			Some(index):
				match bases.get(index):
					Some(base):
						match prepare_accepted_implementation_header(
							base.state,
							type_headers,
							header,
							base.module_path,
							base.local_type_names,
						):
							AcceptedImplementationRecordClaimed(with_impl, item):
								bases = bases.set(index, { base | state = with_impl })
								implementation_records = implementation_records.append(item)
							AcceptedImplementationRecordMissing(with_error):
								bases = bases.set(index, { base | state = with_error })
								trait_implementation_owner_missing = True
					None:
						trait_implementation_owner_missing = True
			None:
				trait_implementation_owner_missing = True

	trait_implementation_input: AcceptedTraitImplementationTableInput = {
		traits = trait_records,
		implementations = implementation_records
	}

	trait_implementation_table = if trait_implementation_owner_missing:
		None
	else:
		accepted_trait_implementation_table(trait_implementation_input)

	for base in bases:
		var prepared_state = base.state

		match callable_table:
			Some(table):
				match accepted_callable_authority_for_module(table, base.bound_module):
					Ok(authority):
						prepared_state = { prepared_state |
							module_view = module_view_with_accepted_callable_authority(
								prepared_state.module_view,
								authority,
							)
						}
					Err(message):
						prepared_state = typecheck_state_add_error(
							prepared_state,
							"internal typecheck error: " + message,
						)
			None:
				prepared_state = typecheck_state_add_error(
					prepared_state,
					"internal typecheck error: accepted callable table rejected prepared entries",
				)

		match trait_implementation_table:
			Some(table):
				authority = accepted_trait_implementation_authority_for_module(
					table,
					base.bound_module,
				)

				for message in accepted_trait_implementation_authority_preparation_errors(
					authority,
				):
					prepared_state = typecheck_state_add_error(prepared_state, message)

				prepared_state = { prepared_state |
					module_view = module_view_with_accepted_trait_implementation_authority(
						prepared_state.module_view,
						authority,
					),
					private_impls = []
				}
			None:
				validation_errors = accepted_trait_implementation_table_validation_errors(
					trait_implementation_input,
				)

				if validation_errors.is_empty():
					prepared_state = typecheck_state_add_error(
						prepared_state,
						(
							"internal typecheck error: accepted trait/implementation table rejected prepared "
							+ "entries"
						),
					)
				else:
					for message in validation_errors:
						prepared_state = typecheck_state_add_error(
							prepared_state,
							"internal typecheck error: " + message,
						)

		match prepared_canonical_module_environment(base.bound_module, prepared_state):
			Some(environment):
				prepared = prepared.append(environment)
			None:
				void

		if not prepared_state.errors.is_empty() or not prepared_state.diagnostics.is_empty():
			issues = issues.append({
				module_identity = bound_module_identity(base.bound_module),
				errors = prepared_state.errors,
				diagnostics = prepared_state.diagnostics,
				callable_errors = base.callable_errors,
			})

	{
		environments = prepared,
		issues = issues,
		accepted_callable_table = callable_table,
		accepted_trait_implementation_table = trait_implementation_table
	}


private pure func typecheck_session_for_prepared_module(
	environment: PreparedCanonicalModuleEnvironment,
) -> TypecheckState:
	facts = environment.module_facts
	{
		context = context_from_prepared_infer_facts(environment.context_facts),
		env = env_from_prepared_module_declarations(environment.declaration_env),
		errors = [],
		diagnostics = [],
		module_view = facts.module_view,
		module_scope = facts.module_scope,
		allow_debug_only_calls = facts.allow_debug_only_calls,
		private_impls = facts.private_impls,
		known_type_index = facts.known_type_index,
		scoped_trait_functions = facts.scoped_trait_functions,
		type_homes = facts.type_homes,
		type_shape_memo = TYPE_SHAPE_MEMO_EMPTY
	}


private pure func initializer_check_state(context: InitializerCheckContext) -> TypecheckState:
	module_environment = context.module_environment
	base_state = typecheck_session_for_prepared_module(module_environment)

	match module_view_accepted_global_authority(base_state.module_view):
		Some(authority):
			initializer_authority = accepted_global_authority_for_initializer(
				authority,
				context.completed_dependencies.map(accepted_global_binding_from_completed),
			)
			{ base_state |
				module_view = module_view_with_accepted_global_authority(
					base_state.module_view,
					initializer_authority,
				)
			}
		None:
			typecheck_state_add_error(
				base_state,
				"internal typecheck error: prepared module has no accepted global authority",
			)


private pure func callable_id_for_definition(
	implementation_headers: ImplementationHeaderGraph,
	definition_id: Int,
) -> Option[CallableId]:
	callable_headers = implementation_header_graph_callable_headers(implementation_headers)

	match callable_header_graph_find_definition_id(callable_headers, definition_id):
		Some(header):
			Some(callable_header_id(header))
		None:
			var found: Option[CallableId] = None

			for implementation in implementation_header_graph_headers(implementation_headers):
				for method in implementation_header_methods(implementation):
					method_id = implementation_method_header_id(method)

					if found.is_none() and callable_id_definition_id(method_id) == definition_id:
						found = Some(method_id)

			found


private pure func append_unique_callable_id(
	ids: List[CallableId],
	id: CallableId,
) -> List[CallableId]:
	if ids.any(func(existing): callable_ids_equal(existing, id)):
		ids
	else:
		ids.append(id)


private pure func initializer_callable_dependencies_from_expr(
	implementation_headers: ImplementationHeaderGraph,
	expr: TypedExpr,
	initial: List[CallableId],
) -> List[CallableId]:
	var dependencies = initial

	match typed_expr_resolved_call(expr):
		Some(call):
			match resolved_call_callable_id(call):
				Some(definition_id):
					match callable_id_for_definition(implementation_headers, definition_id):
						Some(callable_id):
							dependencies = append_unique_callable_id(dependencies, callable_id)
						None:
							void
				None:
					void
		None:
			void

	match expr:
		TypedLambdaExpr(_, _, _, _, _, _):
			-- Creating a closure does not execute its body.
			dependencies
		_:
			var result = dependencies

			for child in typed_expr_children(expr):
				result = initializer_callable_dependencies_from_expr(
					implementation_headers,
					child,
					result,
				)

			result


private pure func complete_one_global_header(
	implementation_headers: ImplementationHeaderGraph,
	prepared_environments: List[PreparedCanonicalModuleEnvironment],
	plan: GlobalHeaderCompletionPlan,
	completed: List[CompletedGlobalHeader],
	header: GlobalHeader,
) -> Result[CompletedGlobalHeader, List[TypecheckDiagnostic]]:
	id = global_header_id(header)
	module_environment = prepared_environments.find(
		func(
			context,
		): module_identities_equal(
			bound_module_identity(context.bound_module),
			global_id_module_identity(id),
		),
	)

	match module_environment:
		None:
			Err(
				[
					typecheck_diagnostic(
						"internal typecheck error: global initializer owner is absent from bound graph",
						None,
					),
				],
			)
		Some(module_environment):
			bound_module = module_environment.bound_module
			planned_dependencies = global_header_completion_plan_dependencies(plan, id)
			completed_dependencies = completed.filter(func(candidate):
				planned_dependencies.any(func(dependency):
					global_ids_equal(dependency, completed_global_header_id(candidate))
				)
			)
			state = initializer_check_state({
				module_environment = module_environment,
				completed_dependencies = completed_dependencies,
			})
			initial_diagnostic_count = state.diagnostics.length()
			result = typecheck_materialize_global_var_body_with_identity(
				state,
				global_header_source(header),
				ClaimGlobalDefinitionWithoutPublication,
			)

			if result.state.diagnostics.length() > initial_diagnostic_count:
				Err(result.state.diagnostics.drop(initial_diagnostic_count))
			else:
				owner_program = bound_module_program(bound_module)
				canonical_binding_type = qualify_module_local_types(
					bound_module_canonical_path(bound_module),
					local_type_names_from_decls(owner_program.decls),
					result.typed.binding_type,
				)
				callable_dependencies = initializer_callable_dependencies_from_expr(
					implementation_headers,
					result.typed.value,
					[],
				)

				if annotated_global_header_type(header).is_some():
					Ok(
						CompletedAnnotatedGlobalHeader(
							id,
							global_header_visibility(header),
							result.typed,
							canonical_binding_type,
							planned_dependencies,
							callable_dependencies,
						),
					)
				else:
					Ok(
						CompletedInferredGlobalHeader(
							id,
							global_header_visibility(header),
							result.typed,
							canonical_binding_type,
							planned_dependencies,
							callable_dependencies,
						),
					)


private record GlobalHeaderCompletionFailure {
	module_identity: ModuleIdentity,
	diagnostics: List[TypecheckDiagnostic]
}


private record GlobalHeaderCompletionOutcome {
	completed: CompletedGlobalHeaderGraph,
	accepted_global_table: Option[AcceptedGlobalTable],
	accepted_callable_table: Option[AcceptedCallableTable],
	accepted_trait_implementation_table: Option[AcceptedTraitImplementationTable],
	failures: List[GlobalHeaderCompletionFailure],
	prepared_environments: List[PreparedCanonicalModuleEnvironment],
	module_preparation_issues: List[PreparedModuleIssues]
}


private pure func cycle_component_spans_modules(component: List[GlobalId]) -> Bool:
	match component.get(0):
		None:
			False
		Some(first):
			first_module = global_id_module_identity(first)
			component.any(func(id):
				not module_identities_equal(global_id_module_identity(id), first_module)
			)


private pure func cycle_component_member_name(id: GlobalId, qualify: Bool) -> String:
	if qualify:
		module_identity_display_name(global_id_module_identity(id)) + "::" + global_id_name(id)
	else:
		global_id_name(id)


private pure func cycle_component_diagnostic_owners(component: List[GlobalId]) -> List[GlobalId]:
	var owners: List[GlobalId] = []

	for id in component:
		module_identity = global_id_module_identity(id)

		if (
			not owners.any(func(owner):
				module_identities_equal(global_id_module_identity(owner), module_identity)
			)
		):
			owners = owners.append(id)

	owners


private pure func complete_planned_global_headers(
	implementation_headers: ImplementationHeaderGraph,
	initial_global_table: AcceptedGlobalTable,
	plan: GlobalHeaderCompletionPlan,
	cyclic_components: List[List[GlobalId]],
	blocked: List[GlobalId],
	accepted_alias_graph: AcceptedAliasGraph,
	accepted_record_graph: AcceptedRecordGraph,
	accepted_union_graph: AcceptedUnionGraph,
	allow_debug_only_calls: Bool,
) -> GlobalHeaderCompletionOutcome:
	prepared_modules = prepared_module_environments(
		implementation_headers,
		initial_global_table,
		accepted_alias_graph,
		accepted_record_graph,
		accepted_union_graph,
		allow_debug_only_calls,
	)
	prepared_environments = prepared_modules.environments
	callable_headers = implementation_header_graph_callable_headers(implementation_headers)
	type_headers = trait_topology_graph_type_headers(
		callable_header_graph_trait_topology(callable_headers),
	)
	var completed: List[CompletedGlobalHeader] = []
	var completed_indices_by_module_and_name: Dict[String, Dict[String, Int]] = {}
	var failures: List[GlobalHeaderCompletionFailure] = []
	var requested_by_module_and_name: Dict[String, Dict[String, Bool]] = {}
	var initializer_checks: Int = 0
	var duplicate_initializer_requests: Int = 0

	for environment in prepared_environments:
		binding_diagnostics = bound_module_binding_diagnostics(environment.bound_module)

		if not binding_diagnostics.is_empty():
			failures = failures.append({
				module_identity = bound_module_identity(environment.bound_module),
				diagnostics = binding_diagnostics,
			})

	for component in cyclic_components:
		qualify_names = cycle_component_spans_modules(component)
		names = component
			.map(func(id): cycle_component_member_name(id, qualify_names))
			.sort()
			.join(", ")
		failures = failures.concat(cycle_component_diagnostic_owners(component).map(
			func(id): {
				module_identity = global_id_module_identity(id),
				diagnostics = [
					typecheck_diagnostic(
						"Cannot infer global initializer types because these globals form a cycle: " + names,
						Some(global_id_source_span(id)),
					),
				]
			},
		))

	failures = failures.concat(blocked.map(
		func(id): {
			module_identity = global_id_module_identity(id),
			diagnostics = [
				typecheck_diagnostic(
					"Cannot infer global initializer type for '" + global_id_name(
						id,
					) + "' because it depends on a cyclic global",
					Some(global_id_source_span(id)),
				),
			]
		},
	))

	headers_to_check = global_header_completion_plan_pending(
		plan,
	).concat(global_header_completion_plan_annotated(plan))

	for header in headers_to_check:
		header_id = global_header_id(header)
		module_key = module_identity_storage_key(global_id_module_identity(header_id))
		requested_names = requested_by_module_and_name.get_or(module_key, {})
		initializer_checks += 1

		if requested_names.contains(global_id_name(header_id)):
			duplicate_initializer_requests += 1

		requested_by_module_and_name = requested_by_module_and_name.set(
			module_key,
			requested_names.set(global_id_name(header_id), True),
		)

		match complete_one_global_header(
			implementation_headers,
			prepared_environments,
			plan,
			completed,
			header,
		):
			Ok(found):
				completed_names: Dict[String, Int] = completed_indices_by_module_and_name.get_or(
					module_key,
					{},
				)
				completed_indices_by_module_and_name = completed_indices_by_module_and_name.set(
					module_key,
					completed_names.set(global_id_name(header_id), completed.length()),
				)
				completed = completed.append(found)
			Err(found_errors):
				failures = failures.append({
					module_identity = global_id_module_identity(global_header_id(header)),
					diagnostics = found_errors,
				})

	completed_table = accepted_global_table_complete(
		initial_global_table,
		completed.map(accepted_global_binding_from_completed),
	)

	{
		completed = into_opaque CompletedGlobalHeaderGraph({
				headers = completed,
				indices_by_module_and_name = completed_indices_by_module_and_name,
				metrics = {
					initializer_checks = initializer_checks,
					duplicate_initializer_requests = duplicate_initializer_requests
				}
			}),
		accepted_global_table = completed_table,
		accepted_callable_table = prepared_modules.accepted_callable_table,
		accepted_trait_implementation_table = prepared_modules.accepted_trait_implementation_table,
		failures = failures,
		prepared_environments = prepared_environments,
		module_preparation_issues = prepared_modules.issues
	}


private pure func complete_global_header_graph(
	implementation_headers: ImplementationHeaderGraph,
	initial_global_table: AcceptedGlobalTable,
	accepted_alias_graph: AcceptedAliasGraph,
	accepted_record_graph: AcceptedRecordGraph,
	accepted_union_graph: AcceptedUnionGraph,
	allow_debug_only_calls: Bool,
) -> GlobalHeaderCompletionOutcome:
	callable_headers = implementation_header_graph_callable_headers(implementation_headers)

	match global_header_completion_plan_build(callable_headers):
		GlobalHeaderCompletionPlanReady(plan):
			complete_planned_global_headers(
				implementation_headers,
				initial_global_table,
				plan,
				[],
				[],
				accepted_alias_graph,
				accepted_record_graph,
				accepted_union_graph,
				allow_debug_only_calls,
			)
		GlobalHeaderCompletionPlanBlocked(plan, cyclic_components, blocked):
			complete_planned_global_headers(
				implementation_headers,
				initial_global_table,
				plan,
				cyclic_components,
				blocked,
				accepted_alias_graph,
				accepted_record_graph,
				accepted_union_graph,
				allow_debug_only_calls,
			)


private pure func typecheck_diagnostics_equal(
	left: TypecheckDiagnostic,
	right: TypecheckDiagnostic,
) -> Bool:
	left.message == right.message and match (left.span, right.span):
		(None, None):
			True
		(Some(left_span), Some(right_span)):
			source_spans_equal(left_span, right_span)
		_:
			False


-- Type headers own definition-level facts only. This later phase product owns
-- the body-bearing import inventory needed to materialize declarations. Its
-- sole constructor verifies both products came from compatible indexed graphs,
-- so the complete inventory cannot be paired with unrelated headers.
private record TypecheckGraphFacts {
	implementation_headers: ImplementationHeaderGraph,
	importable_graph: ImportableModuleGraph,
	completed_globals: CompletedGlobalHeaderGraph,
	accepted_global_table: AcceptedGlobalTable,
	accepted_callable_table: AcceptedCallableTable,
	accepted_trait_implementation_table: AcceptedTraitImplementationTable,
	prepared_environments: List[PreparedCanonicalModuleEnvironment],
	module_preparation_issues: List[PreparedModuleIssues],
	accepted_alias_graph: AcceptedAliasGraph,
	accepted_record_graph: AcceptedRecordGraph,
	accepted_union_graph: AcceptedUnionGraph
}


private record AcceptedTypecheckGraphRep {
	facts: TypecheckGraphFacts
}


private record RecoverableTypecheckGraphRep {
	facts: TypecheckGraphFacts,
	global_completion_failures: List[GlobalHeaderCompletionFailure]
}


opaque type AcceptedTypecheckGraph = AcceptedTypecheckGraphRep

opaque type RecoverableTypecheckGraph = RecoverableTypecheckGraphRep


union TypecheckGraphCompletion:
	TypecheckGraphAccepted(AcceptedTypecheckGraph)
	TypecheckGraphRecoverable(RecoverableTypecheckGraph)
	TypecheckGraphCompletionRejected(List[String])


private pure func finish_typecheck_graph_completion(
	implementation_headers: ImplementationHeaderGraph,
	importable_graph: ImportableModuleGraph,
	accepted_alias_graph: AcceptedAliasGraph,
	accepted_record_graph: AcceptedRecordGraph,
	accepted_union_graph: AcceptedUnionGraph,
	expected_module_count: Int,
	completion: GlobalHeaderCompletionOutcome,
) -> TypecheckGraphCompletion:
	if completion.prepared_environments.length() != expected_module_count:
		TypecheckGraphCompletionRejected(
			[
				(
					"internal typecheck error: canonical module environment preparation was "
					+ "incomplete"
				),
			],
		)
	else:
		match (
			completion.accepted_global_table,
			completion.accepted_callable_table,
			completion.accepted_trait_implementation_table,
		):
			(None, _, _):
				TypecheckGraphCompletionRejected(
					[
						(
							"internal typecheck error: completed globals did not match the accepted global "
							+ "table"
						),
					],
				)
			(_, None, _):
				TypecheckGraphCompletionRejected(
					[
						"internal typecheck error: accepted callable table construction was incomplete",
					],
				)
			(_, _, None):
				preparation_errors = completion.module_preparation_issues.flat_map(
					func(issue): issue.errors,
				)
				var failure_errors = preparation_errors

				if failure_errors.is_empty():
					failure_errors = [
						(
							"internal typecheck error: accepted trait/implementation table construction was "
							+ "incomplete"
						),
					]

				TypecheckGraphCompletionRejected(failure_errors)
			(Some(accepted_global_table), Some(accepted_callable_table), Some(accepted_trait_implementation_table)):
				facts: TypecheckGraphFacts = {
					implementation_headers = implementation_headers,
					importable_graph = importable_graph,
					completed_globals = completion.completed,
					accepted_global_table = accepted_global_table,
					accepted_callable_table = accepted_callable_table,
					accepted_trait_implementation_table = accepted_trait_implementation_table,
					prepared_environments = completion.prepared_environments,
					module_preparation_issues = completion.module_preparation_issues,
					accepted_alias_graph = accepted_alias_graph,
					accepted_record_graph = accepted_record_graph,
					accepted_union_graph = accepted_union_graph
				}

				if completion.failures.is_empty():
					TypecheckGraphAccepted(into_opaque AcceptedTypecheckGraph({facts = facts}))
				else:
					TypecheckGraphRecoverable(into_opaque RecoverableTypecheckGraph({
								facts = facts,
								global_completion_failures = completion.failures
							}))


pure func complete_typecheck_graph(
	implementation_headers: ImplementationHeaderGraph,
	importable_graph: ImportableModuleGraph,
	allow_debug_only_calls: Bool,
) -> TypecheckGraphCompletion:
	callable_headers = implementation_header_graph_callable_headers(implementation_headers)
	trait_topology = callable_header_graph_trait_topology(callable_headers)
	type_headers = trait_topology_graph_type_headers(trait_topology)
	bound_graph = type_header_graph_bound_graph(type_headers)
	builtin_env = env_with_core_builtin_types(ENV_EMPTY)
	indexed_graph = bound_module_graph_indexed_graph(bound_graph)
	target_scope = indexed_graph_target_scope(indexed_graph)

	if importable_module_graph_matches_scope(importable_graph, target_scope):
		match accepted_alias_graph_build(type_headers, bound_graph):
			Err(errors):
				TypecheckGraphCompletionRejected(errors.map(
					func(
						message,
					): "internal typecheck error: type alias projection rejected accepted headers: " + message,
				))
			Ok(accepted_alias_graph):
				match accepted_record_graph_build(type_headers, bound_graph):
					Err(errors):
						TypecheckGraphCompletionRejected(errors.map(
							func(
								message,
							): "internal typecheck error: accepted record graph rejected accepted headers: " + message,
						))
					Ok(accepted_record_graph):
						match accepted_union_graph_build(
							type_headers,
							bound_graph,
							accepted_alias_graph_table(accepted_alias_graph),
							builtin_env,
							BUILTIN_UNION_TYPE_NAMES,
						):
							Err(errors):
								TypecheckGraphCompletionRejected(errors.map(
									func(
										message,
									): "internal typecheck error: accepted union graph rejected accepted headers: " + message,
								))
							Ok(accepted_union_graph):
								match accepted_global_table_build(
									type_headers,
									callable_headers,
									bound_graph,
								):
									Err(errors):
										TypecheckGraphCompletionRejected(errors.map(
											func(message): "internal typecheck error: " + message,
										))
									Ok(initial_global_table):
										completion = complete_global_header_graph(
											implementation_headers,
											initial_global_table,
											accepted_alias_graph,
											accepted_record_graph,
											accepted_union_graph,
											allow_debug_only_calls,
										)
										finish_typecheck_graph_completion(
											implementation_headers,
											importable_graph,
											accepted_alias_graph,
											accepted_record_graph,
											accepted_union_graph,
											1 + bound_module_graph_modules(bound_graph).length(),
											completion,
										)
	else:
		TypecheckGraphCompletionRejected(
			[
				(
					"internal typecheck error: accepted headers and import inventory have "
					+ "incompatible graph provenance"
				),
			],
		)


private pure func accepted_typecheck_graph_rep(
	graph: AcceptedTypecheckGraph,
) -> AcceptedTypecheckGraphRep:
	from_opaque AcceptedTypecheckGraph(graph)


private pure func recoverable_typecheck_graph_rep(
	graph: RecoverableTypecheckGraph,
) -> RecoverableTypecheckGraphRep:
	from_opaque RecoverableTypecheckGraph(graph)


private pure func accepted_typecheck_graph_trait_topology(
	facts: TypecheckGraphFacts,
) -> TraitTopologyGraph:
	callable_header_graph_trait_topology(
		implementation_header_graph_callable_headers(facts.implementation_headers),
	)


private pure func prepared_module_environment_find(
	facts: TypecheckGraphFacts,
	module_identity: ModuleIdentity,
) -> Option[PreparedCanonicalModuleEnvironment]:
	facts.prepared_environments.find(func(environment):
		module_identities_equal(bound_module_identity(environment.bound_module), module_identity)
	)


private pure func prepared_module_environment_accepts_request(
	environment: PreparedCanonicalModuleEnvironment,
	request_scope: PreparedModuleScope,
	allow_debug_only_calls: Bool,
) -> Bool:
	(
		prepared_module_scopes_are_compatible(
			request_scope,
			bound_module_scope(environment.bound_module),
		)
		and module_identities_equal(
			prepared_module_scope_identity(request_scope),
			bound_module_identity(environment.bound_module),
		)
		and allow_debug_only_calls == environment.module_facts.allow_debug_only_calls
	)


pure func recoverable_typecheck_graph_diagnostics(
	graph: RecoverableTypecheckGraph,
) -> List[TypecheckDiagnostic]:
	representation = recoverable_typecheck_graph_rep(graph)
	var diagnostics: List[TypecheckDiagnostic] = []

	for failure in representation.global_completion_failures:
		for diagnostic in failure.diagnostics:
			if not diagnostics.any(
				func(existing): typecheck_diagnostics_equal(existing, diagnostic),
			):
				diagnostics = diagnostics.append(diagnostic)

	diagnostics


pure func recoverable_typecheck_graph_diagnostics_for_module(
	graph: RecoverableTypecheckGraph,
	module_identity: ModuleIdentity,
) -> List[TypecheckDiagnostic]:
	representation = recoverable_typecheck_graph_rep(graph)
	var diagnostics: List[TypecheckDiagnostic] = []

	for failure in representation.global_completion_failures:
		if module_identities_equal(failure.module_identity, module_identity):
			for diagnostic in failure.diagnostics:
				if not diagnostics.any(
					func(existing): typecheck_diagnostics_equal(existing, diagnostic),
				):
					diagnostics = diagnostics.append(diagnostic)

	diagnostics


pure func recoverable_typecheck_graph_import_modules(
	graph: RecoverableTypecheckGraph,
) -> List[ImportableModule]:
	importable_module_graph_all(recoverable_typecheck_graph_rep(graph).facts.importable_graph)


pure func recoverable_typecheck_graph_declaration_skeleton_count(
	graph: RecoverableTypecheckGraph,
) -> Int:
	type_headers = trait_topology_graph_type_headers(
		accepted_typecheck_graph_trait_topology(recoverable_typecheck_graph_rep(graph).facts),
	)
	type_header_graph_declaration_skeleton_count(type_headers)


pure func accepted_typecheck_graph_declaration_skeleton_count(graph: AcceptedTypecheckGraph) -> Int:
	type_headers = trait_topology_graph_type_headers(
		accepted_typecheck_graph_trait_topology(accepted_typecheck_graph_rep(graph).facts),
	)
	type_header_graph_declaration_skeleton_count(type_headers)


pure func accepted_typecheck_graph_import_modules(
	graph: AcceptedTypecheckGraph,
) -> List[ImportableModule]:
	importable_module_graph_all(accepted_typecheck_graph_rep(graph).facts.importable_graph)


pure func accepted_typecheck_graph_implementation_headers(
	graph: AcceptedTypecheckGraph,
) -> ImplementationHeaderGraph:
	accepted_typecheck_graph_rep(graph).facts.implementation_headers


pure func accepted_typecheck_graph_importable_graph(
	graph: AcceptedTypecheckGraph,
) -> ImportableModuleGraph:
	accepted_typecheck_graph_rep(graph).facts.importable_graph


-- Completed initializer facts are immutable graph output. Phase 7 CTFE and
-- profiling may inspect them, but cannot construct or re-open the opaque graph.
pure func accepted_typecheck_graph_completed_globals(
	graph: AcceptedTypecheckGraph,
) -> List[CompletedGlobalHeader]:
	completed_global_header_graph_headers(
		accepted_typecheck_graph_rep(graph).facts.completed_globals,
	)


pure func accepted_typecheck_graph_completed_global_graph(
	graph: AcceptedTypecheckGraph,
) -> CompletedGlobalHeaderGraph:
	accepted_typecheck_graph_rep(graph).facts.completed_globals


pure func accepted_typecheck_graph_global_completion_metrics(
	graph: AcceptedTypecheckGraph,
) -> GlobalHeaderCompletionMetrics:
	completed_global_header_graph_metrics(
		accepted_typecheck_graph_rep(graph).facts.completed_globals,
	)


pure func accepted_typecheck_graph_global_authority_metrics(
	graph: AcceptedTypecheckGraph,
) -> AcceptedGlobalAuthorityMetrics:
	facts = accepted_typecheck_graph_rep(graph).facts
	accepted_global_authority_metrics(
		facts.accepted_global_table,
		facts.prepared_environments.length(),
	)


pure func accepted_typecheck_graph_callable_authority_metrics(
	graph: AcceptedTypecheckGraph,
) -> AcceptedCallableAuthorityMetrics:
	facts = accepted_typecheck_graph_rep(graph).facts
	var authorities: List[AcceptedCallableAuthority] = []

	for environment in facts.prepared_environments:
		match module_view_accepted_callable_authority(environment.module_facts.module_view):
			Some(authority):
				authorities = authorities.append(authority)
			None:
				void

	accepted_callable_authority_metrics(facts.accepted_callable_table, authorities)


pure func accepted_typecheck_graph_trait_implementation_authority_metrics(
	graph: AcceptedTypecheckGraph,
) -> AcceptedTraitImplementationAuthorityMetrics:
	facts = accepted_typecheck_graph_rep(graph).facts
	var authorities: List[AcceptedTraitImplementationAuthority] = []

	for environment in facts.prepared_environments:
		match module_view_accepted_trait_implementation_authority(
			environment.module_facts.module_view,
		):
			Some(authority):
				authorities = authorities.append(authority)
			None:
				void

	accepted_trait_implementation_authority_metrics(
		facts.accepted_trait_implementation_table,
		authorities,
	)


pure func accepted_typecheck_graph_alias_metrics(
	graph: AcceptedTypecheckGraph,
) -> AcceptedAliasGraphMetrics:
	facts = accepted_typecheck_graph_rep(graph).facts
	accepted_alias_graph_metrics(facts.accepted_alias_graph, facts.prepared_environments.length())


pure func accepted_typecheck_graph_record_metrics(
	graph: AcceptedTypecheckGraph,
) -> AcceptedRecordGraphMetrics:
	facts = accepted_typecheck_graph_rep(graph).facts
	-- Canonical authorities live in the prepared environments' module facts and
	-- are reused by ordinary body checking. CTFE prepares a distinct,
	-- dependency-only view rather than retaining a second canonical copy.
	accepted_record_graph_metrics(facts.accepted_record_graph, facts.prepared_environments.length())


pure func accepted_typecheck_graph_union_metrics(
	graph: AcceptedTypecheckGraph,
) -> AcceptedUnionGraphMetrics:
	facts = accepted_typecheck_graph_rep(graph).facts
	accepted_union_graph_metrics(facts.accepted_union_graph, facts.prepared_environments.length())


struct FrontendDeclarationPreparationObservation {
	accepted_modules_prepared: Int,
	unique_graph_declarations: Int,
	unique_type_declarations: Int,
	unique_constructors: Int,
	unique_callables: Int,
	unique_globals: Int,
	unique_traits: Int,
	unique_implementations: Int,
	visible_module_edges: Int,
	direct_module_edges: Int,
	module_view_projection_entries: Int,
	canonical_module_base_builds: Int,
	body_sessions_created: Int,
	body_contexts_created: Int,
	error_count: Int,
	checksum: Int
}


private pure func frontend_preparation_observation_empty(
	unique_graph_declarations: Int,
) -> FrontendDeclarationPreparationObservation:
	{
		accepted_modules_prepared = 0,
		unique_graph_declarations = unique_graph_declarations,
		unique_type_declarations = 0,
		unique_constructors = 0,
		unique_callables = 0,
		unique_globals = 0,
		unique_traits = 0,
		unique_implementations = 0,
		visible_module_edges = 0,
		direct_module_edges = 0,
		module_view_projection_entries = 0,
		canonical_module_base_builds = 0,
		body_sessions_created = 0,
		body_contexts_created = 0,
		error_count = 0,
		checksum = 0
	}


private pure func frontend_preparation_observation_finish(
	observation: FrontendDeclarationPreparationObservation,
) -> FrontendDeclarationPreparationObservation:
	unique_declarations = observation.unique_type_declarations + observation.unique_constructors + observation.unique_callables + observation.unique_globals + observation.unique_traits + observation.unique_implementations

	checksum = frontend_preparation_checksum(
		{ observation | unique_graph_declarations = unique_declarations },
	)

	{ observation |
		unique_graph_declarations = unique_declarations,
		checksum = checksum
	}


private pure func frontend_preparation_checksum_add(seed: Int, value: Int) -> Int:
	seed * 16777619 + value


private pure func frontend_preparation_checksum(
	observation: FrontendDeclarationPreparationObservation,
) -> Int:
	var checksum: Int = 216613626

	checksum = frontend_preparation_checksum_add(checksum, observation.accepted_modules_prepared)
	checksum = frontend_preparation_checksum_add(checksum, observation.unique_graph_declarations)
	checksum = frontend_preparation_checksum_add(checksum, observation.unique_type_declarations)
	checksum = frontend_preparation_checksum_add(checksum, observation.unique_constructors)
	checksum = frontend_preparation_checksum_add(checksum, observation.unique_callables)
	checksum = frontend_preparation_checksum_add(checksum, observation.unique_globals)
	checksum = frontend_preparation_checksum_add(checksum, observation.unique_traits)
	checksum = frontend_preparation_checksum_add(checksum, observation.unique_implementations)
	checksum = frontend_preparation_checksum_add(checksum, observation.visible_module_edges)
	checksum = frontend_preparation_checksum_add(checksum, observation.direct_module_edges)
	checksum = frontend_preparation_checksum_add(
		checksum,
		observation.module_view_projection_entries,
	)
	checksum = frontend_preparation_checksum_add(checksum, observation.canonical_module_base_builds)
	checksum = frontend_preparation_checksum_add(checksum, observation.body_sessions_created)
	checksum = frontend_preparation_checksum_add(checksum, observation.body_contexts_created)
	frontend_preparation_checksum_add(checksum, observation.error_count)


private pure func union_header_constructor_count(headers: List[AcceptedUnionHeader]) -> Int:
	var count: Int = 0

	for header in headers:
		count += union_type_header_variants(header).length()

	count


private pure func frontend_preparation_observation_add(
	left: FrontendDeclarationPreparationObservation,
	right: FrontendDeclarationPreparationObservation,
) -> FrontendDeclarationPreparationObservation:
	frontend_preparation_observation_finish({
		accepted_modules_prepared = left.accepted_modules_prepared + right.accepted_modules_prepared,
		unique_graph_declarations = 0,
		unique_type_declarations = left.unique_type_declarations + right.unique_type_declarations,
		unique_constructors = left.unique_constructors + right.unique_constructors,
		unique_callables = left.unique_callables + right.unique_callables,
		unique_globals = left.unique_globals + right.unique_globals,
		unique_traits = left.unique_traits + right.unique_traits,
		unique_implementations = left.unique_implementations + right.unique_implementations,
		visible_module_edges = left.visible_module_edges + right.visible_module_edges,
		direct_module_edges = left.direct_module_edges + right.direct_module_edges,
		module_view_projection_entries = left.module_view_projection_entries + right.module_view_projection_entries,
		canonical_module_base_builds = left.canonical_module_base_builds + right.canonical_module_base_builds,
		body_sessions_created = left.body_sessions_created + right.body_sessions_created,
		body_contexts_created = left.body_contexts_created + right.body_contexts_created,
		error_count = left.error_count + right.error_count,
		checksum = 0,
	})


private pure func frontend_preparation_module_view_projection_entries(view: ModuleView) -> Int:
	module_view_module_aliases(
		view,
	).length() + module_view_imported_names(
		view,
	).length() + module_view_imported_modules(
		view,
	).length() + module_view_import_bindings(view).length()


private pure func frontend_preparation_modules_include_identity(
	modules: List[BoundModule],
	module_identity: ModuleIdentity,
) -> Bool:
	modules.any(func(module):
		module_identities_equal(bound_module_identity(module), module_identity)
	)


private pure func frontend_preparation_unique_declaration_observation(
	type_headers: TypeHeaderGraph,
	callable_headers: CallableHeaderGraph,
	topology: TraitTopologyGraph,
	implementation_headers: ImplementationHeaderGraph,
	modules: List[BoundModule],
) -> FrontendDeclarationPreparationObservation:
	var type_count: Int = 0
	var constructor_count: Int = 0
	var callable_count: Int = 0
	var global_count: Int = 0
	var trait_count: Int = 0
	var implementation_count: Int = 0

	for module in modules:
		module_identity = bound_module_identity(module)
		union_headers = type_header_graph_local_union_headers(type_headers, module_identity)

		type_count += type_header_graph_local_builtin_headers(
			type_headers,
			module_identity,
		).length() + type_header_graph_local_record_headers(
			type_headers,
			module_identity,
		).length() + union_headers.length() + type_header_graph_local_alias_headers(
			type_headers,
			module_identity,
		).length()
		constructor_count += union_header_constructor_count(union_headers)

	for header in callable_header_graph_callables(callable_headers):
		if frontend_preparation_modules_include_identity(
			modules,
			callable_id_module_identity(callable_header_id(header)),
		):
			callable_count += 1

	for header in callable_header_graph_globals(callable_headers):
		if frontend_preparation_modules_include_identity(
			modules,
			global_id_module_identity(global_header_id(header)),
		):
			global_count += 1

	for header in trait_topology_graph_headers(topology):
		if frontend_preparation_modules_include_identity(
			modules,
			trait_id_module_identity(trait_topology_header_id(header)),
		):
			trait_count += 1

	for header in implementation_header_graph_headers(implementation_headers):
		if frontend_preparation_modules_include_identity(
			modules,
			impl_id_module_identity(implementation_header_id(header)),
		):
			implementation_count += 1

	frontend_preparation_observation_finish({ frontend_preparation_observation_empty(0) |
			unique_type_declarations = type_count,
			unique_constructors = constructor_count,
			unique_callables = callable_count,
			unique_globals = global_count,
			unique_traits = trait_count,
			unique_implementations = implementation_count
		})


private enum AcceptedTypecheckImportScope:
	CanonicalTypecheckImports
	CtfeArtifactTypecheckImports


-- Body checking starts from one accepted, immutable module base. Preparing it
-- here prevents per-body import/header registration and keeps every session
-- tied to the exact graph acceptance that produced it.
private record PreparedAcceptedBodyModule {
	session_seed: BodyInferSessionSeed,
	errors: List[String],
	diagnostics: List[TypecheckDiagnostic],
	import_modules: List[ImportableModule]
}


private pure func typecheck_state_with_accepted_type_authority(
	state: TypecheckState,
	accepted_alias_authority: AcceptedAliasAuthority,
	accepted_record_authority: AcceptedRecordAuthority,
	accepted_union_authority: AcceptedUnionAuthority,
) -> TypecheckState:
	view_with_aliases = module_view_with_accepted_alias_authority(
		state.module_view,
		accepted_alias_authority,
	)
	view_with_records = module_view_with_accepted_record_authority(
		view_with_aliases,
		accepted_record_authority,
	)

	{ state |
		module_view = module_view_with_accepted_union_authority(
			view_with_records,
			accepted_union_authority,
		)
	}


private pure func prepare_canonical_body_module(
	graph: TypecheckGraphFacts,
	environment: PreparedCanonicalModuleEnvironment,
) -> Option[PreparedAcceptedBodyModule]:
	base_state = typecheck_session_for_prepared_module(environment)
	module_identity = bound_module_identity(environment.bound_module)
	direct_module_identities = bound_module_direct_import_modules(
		environment.bound_module,
	).map(
		func(module): prepared_module_scope_identity(importable_module_prepared_scope(module)),
	)
	var errors: List[String] = []
	var diagnostics: List[TypecheckDiagnostic] = []

	for issues in graph.module_preparation_issues:
		if module_identities_equal(issues.module_identity, module_identity):
			errors = errors.concat(issues.errors)
			diagnostics = diagnostics.concat(issues.diagnostics)
		else if direct_module_identities.any(
			func(identity): module_identities_equal(issues.module_identity, identity),
		):
			errors = errors.concat(issues.callable_errors)

	state_with_issues = { base_state |
		errors = errors,
		diagnostics = diagnostics
	}

	with_completed_globals = match module_view_accepted_global_authority(
		state_with_issues.module_view,
	):
		Some(authority):
			{ state_with_issues | module_view = module_view_with_accepted_global_authority(
					state_with_issues.module_view,
					accepted_global_authority_with_completed_table(
						authority,
						graph.accepted_global_table,
					),
				) }
		None:
			typecheck_state_add_error(
				state_with_issues,
				"internal typecheck error: prepared module has no accepted global authority",
			)

	session_seed ?= body_infer_session_seed(with_completed_globals)

	Some({
		session_seed = session_seed,
		errors = with_completed_globals.errors,
		diagnostics = with_completed_globals.diagnostics,
		import_modules = importable_module_graph_all(graph.importable_graph),
	})


private record AcceptedTypecheckModuleRep {
	graph_facts: TypecheckGraphFacts,
	bound_module: BoundModule,
	prepared_body: PreparedAcceptedBodyModule
}


opaque type AcceptedTypecheckModule = AcceptedTypecheckModuleRep


private record PreparedTypeAliasAuthority {
	state: TypecheckState,
	authority: AcceptedAliasAuthority
}


private pure func prepare_type_alias_authority(
	graph: AcceptedAliasGraph,
	type_headers: TypeHeaderGraph,
	bound_module: BoundModule,
	state: TypecheckState,
) -> PreparedTypeAliasAuthority:
	match accepted_alias_graph_authority_for_module(graph, type_headers, bound_module):
		Ok(authority):
			{
				state = state,
				authority = authority
			}
		Err(message):
			{
				state = typecheck_state_add_error(
					state,
					"internal typecheck error: accepted module alias projection failed: " + message,
				),
				authority = accepted_alias_graph_canonical_authority(
					graph,
					bound_module_identity(bound_module),
				)
			}


private record PreparedRecordTypeAuthority {
	state: TypecheckState,
	authority: AcceptedRecordAuthority
}


private pure func prepare_record_type_authority(
	graph: AcceptedRecordGraph,
	type_headers: TypeHeaderGraph,
	bound_module: BoundModule,
	state: TypecheckState,
) -> PreparedRecordTypeAuthority:
	match accepted_record_graph_authority_for_module(graph, type_headers, bound_module):
		Ok(authority):
			{
				state = state,
				authority = authority
			}
		Err(message):
			{
				state = typecheck_state_add_error(
					state,
					"internal typecheck error: accepted module record projection failed: " + message,
				),
				authority = accepted_record_graph_canonical_authority(
					graph,
					bound_module_identity(bound_module),
				)
			}


private record PreparedUnionTypeAuthority {
	state: TypecheckState,
	authority: AcceptedUnionAuthority
}


private pure func prepare_union_type_authority(
	graph: AcceptedUnionGraph,
	type_headers: TypeHeaderGraph,
	bound_module: BoundModule,
	state: TypecheckState,
) -> PreparedUnionTypeAuthority:
	match accepted_union_graph_authority_for_module(
		graph,
		type_headers,
		bound_module,
		type_header_graph_bound_graph(type_headers),
	):
		Ok(authority):
			{
				state = state,
				authority = authority
			}
		Err(message):
			{
				state = typecheck_state_add_error(
					state,
					"internal typecheck error: accepted module union authority failed: " + message,
				),
				authority = accepted_union_graph_canonical_authority(
					graph,
					bound_module_identity(bound_module),
				)
			}


private pure func graph_facts_typecheck_module(
	graph_facts: TypecheckGraphFacts,
	module_identity: ModuleIdentity,
	request_scope: PreparedModuleScope,
	allow_debug_only_calls: Bool,
) -> Option[AcceptedTypecheckModule]:
	prepared_environment ?= prepared_module_environment_find(graph_facts, module_identity)
	bound_module = prepared_environment.bound_module
	bound_scope = bound_module_scope(bound_module)

	if (
		importable_module_graph_accepts_scope(graph_facts.importable_graph, bound_scope)
		and prepared_module_environment_accepts_request(
			prepared_environment,
			request_scope,
			allow_debug_only_calls,
		)
	):
		prepared_body ?= prepare_canonical_body_module(graph_facts, prepared_environment)
		Some(into_opaque AcceptedTypecheckModule({
					graph_facts = graph_facts,
					bound_module = bound_module,
					prepared_body = prepared_body
				}))
	else:
		None


pure func accepted_graph_typecheck_module(
	graph: AcceptedTypecheckGraph,
	module_identity: ModuleIdentity,
	scope: PreparedModuleScope,
	allow_debug_only_calls: Bool,
) -> Option[AcceptedTypecheckModule]:
	graph_facts_typecheck_module(
		accepted_typecheck_graph_rep(graph).facts,
		module_identity,
		scope,
		allow_debug_only_calls,
	)


private pure func completion_failed_for_module(
	failures: List[GlobalHeaderCompletionFailure],
	module_identity: ModuleIdentity,
) -> Bool:
	failures.any(func(failure):
		module_identities_equal(failure.module_identity, module_identity)
	)


pure func recoverable_graph_typecheck_module(
	graph: RecoverableTypecheckGraph,
	module_identity: ModuleIdentity,
	scope: PreparedModuleScope,
	allow_debug_only_calls: Bool,
) -> Option[AcceptedTypecheckModule]:
	representation = recoverable_typecheck_graph_rep(graph)

	if completion_failed_for_module(representation.global_completion_failures, module_identity):
		None
	else:
		graph_facts_typecheck_module(
			representation.facts,
			module_identity,
			scope,
			allow_debug_only_calls,
		)


-- Reusable CTFE artifacts use only dependency modules. Construct that narrower
-- binding here from the accepted graph so callers cannot supply a target-aware
-- or otherwise independently assembled binding.
private pure func graph_facts_ctfe_artifact_typecheck_module(
	graph_facts: TypecheckGraphFacts,
	scope: PreparedModuleScope,
	state: TypecheckState,
) -> Option[AcceptedTypecheckModule]:
	type_headers = trait_topology_graph_type_headers(
		accepted_typecheck_graph_trait_topology(graph_facts),
	)
	bound_graph = type_header_graph_bound_graph(type_headers)
	indexed_graph = bound_module_graph_indexed_graph(bound_graph)
	graph_scope = indexed_graph_target_scope(indexed_graph)
	module_identity = prepared_module_scope_identity(scope)
	module_identity_is_owned = bound_module_graph_find(bound_graph, module_identity).is_some()

	if (
		module_identity_is_owned
		and prepared_module_scopes_are_compatible(graph_scope, scope)
		and importable_module_graph_accepts_scope(graph_facts.importable_graph, scope)
		and typecheck_state_is_reserved_for_scope(state, scope)
	):
		artifact_index = importable_module_graph_dependency_index(graph_facts.importable_graph)
		bound_module ?= bound_module_build(
			scope,
			func(
				binding_scope,
			): typecheck_bind_program_module_view(
				state,
				prepared_module_program(prepared_module_scope_module(binding_scope)),
				artifact_index,
				prepared_module_scope_canonical_path(binding_scope),
			),
		).to_option()
		type_alias_authority = prepare_type_alias_authority(
			graph_facts.accepted_alias_graph,
			type_headers,
			bound_module,
			state,
		)
		record_type_authority = prepare_record_type_authority(
			graph_facts.accepted_record_graph,
			type_headers,
			bound_module,
			type_alias_authority.state,
		)
		union_type_authority = prepare_union_type_authority(
			graph_facts.accepted_union_graph,
			type_headers,
			bound_module,
			record_type_authority.state,
		)
		prepared_body ?= prepare_ctfe_artifact_body_module(
			graph_facts,
			bound_module,
			union_type_authority.state,
			type_alias_authority.authority,
			record_type_authority.authority,
			union_type_authority.authority,
		)

		Some(into_opaque AcceptedTypecheckModule({
					graph_facts = graph_facts,
					bound_module = bound_module,
					prepared_body = prepared_body
				}))
	else:
		None


pure func accepted_ctfe_artifact_typecheck_module(
	graph: AcceptedTypecheckGraph,
	scope: PreparedModuleScope,
	state: TypecheckState,
) -> Option[AcceptedTypecheckModule]:
	graph_facts_ctfe_artifact_typecheck_module(
		accepted_typecheck_graph_rep(graph).facts,
		scope,
		state,
	)


pure func recoverable_ctfe_artifact_typecheck_module(
	graph: RecoverableTypecheckGraph,
	scope: PreparedModuleScope,
	state: TypecheckState,
) -> Option[AcceptedTypecheckModule]:
	representation = recoverable_typecheck_graph_rep(graph)
	module_identity = prepared_module_scope_identity(scope)

	if completion_failed_for_module(representation.global_completion_failures, module_identity):
		None
	else:
		graph_facts_ctfe_artifact_typecheck_module(representation.facts, scope, state)


private pure func accepted_typecheck_module_rep(
	input: AcceptedTypecheckModule,
) -> AcceptedTypecheckModuleRep:
	from_opaque AcceptedTypecheckModule(input)


private record AcceptedBodyModuleBase {
	representation: AcceptedTypecheckModuleRep,
	state: TypecheckState,
	import_modules: List[ImportableModule],
	plan_provenance: BodyPlanProvenance
}


-- Reusable bodies are valid only for a compatible accepted indexed graph, the
-- same selected module, and the same body-check-affecting semantic options.
-- PreparedModuleScope retains resolved graph identity without serializing the
-- complete graph once per module.
private pure func body_plan_provenance(
	local_module: BoundModule,
	allow_debug_only_calls: Bool,
) -> BodyPlanProvenance:
	into_opaque BodyPlanProvenance({
			module_scope = bound_module_scope(local_module),
			allow_debug_only_calls = allow_debug_only_calls
		})


private pure func body_plan_provenances_equal(
	left: BodyPlanProvenance,
	right: BodyPlanProvenance,
) -> Bool:
	left_representation = from_opaque BodyPlanProvenance(left)
	right_representation = from_opaque BodyPlanProvenance(right)

	(
		prepared_module_scopes_are_compatible(
			left_representation.module_scope,
			right_representation.module_scope,
		)
		and module_identities_equal(
			prepared_module_scope_identity(left_representation.module_scope),
			prepared_module_scope_identity(right_representation.module_scope),
		)
		and left_representation.allow_debug_only_calls == right_representation.allow_debug_only_calls
	)


private record BodyCheckRegistryRep {
	base: AcceptedBodyModuleBase
}


-- An immutable exact-body lookup boundary for demand-driven consumers. The
-- registry retains the accepted module owner and constructs a fresh body
-- context only after resolving a graph-owned definition identity.
opaque type BodyCheckRegistry = BodyCheckRegistryRep


private pure func prepare_ctfe_artifact_body_module(
	graph: TypecheckGraphFacts,
	bound_module: BoundModule,
	state: TypecheckState,
	accepted_alias_authority: AcceptedAliasAuthority,
	accepted_record_authority: AcceptedRecordAuthority,
	accepted_union_authority: AcceptedUnionAuthority,
) -> Option[PreparedAcceptedBodyModule]:
	callable_headers = implementation_header_graph_callable_headers(graph.implementation_headers)
	type_headers = trait_topology_graph_type_headers(accepted_typecheck_graph_trait_topology(graph))

	program = bound_module_program(bound_module)
	view = bound_module_view(bound_module)
	visible_import_modules = bound_module_visible_import_modules(bound_module)
	import_surfaces = importable_module_surfaces(visible_import_modules)
	with_known_types = typecheck_prescan_known_type_names(state, program)
	var with_view = typecheck_state_with_accepted_type_authority(
		{ with_known_types | module_view = view },
		accepted_alias_authority,
		accepted_record_authority,
		accepted_union_authority,
	)
	global_authority = accepted_global_authority_for_module(
		graph.accepted_global_table,
		bound_module,
	)

	with_view = match global_authority:
		Ok(authority):
			{ with_view | module_view = module_view_with_accepted_global_authority(
					with_view.module_view,
					accepted_global_authority_with_completed_table(
						authority,
						graph.accepted_global_table,
					),
				) }
		Err(message):
			typecheck_state_add_error(with_view, "internal typecheck error: " + message)

	with_view = match accepted_callable_authority_for_module(
		graph.accepted_callable_table,
		bound_module,
	):
		Ok(authority):
			{ with_view |
				module_view = module_view_with_accepted_callable_authority(
					with_view.module_view,
					authority,
				)
			}
		Err(message):
			typecheck_state_add_error(with_view, "internal typecheck error: " + message)

	for diagnostic in bound_module_binding_diagnostics(bound_module):
		with_view = typecheck_state_add_diagnostic(with_view, diagnostic)

	with_import_type_facts = register_module_view_type_facts(with_view, import_surfaces, view)
	with_import_decls = typecheck_register_import_modules_from(
		with_import_type_facts,
		visible_import_modules,
		type_headers,
	)

	var base_state = typecheck_state_after_accepted_definition_id_replay(
		with_import_decls,
		bound_module,
		type_headers,
		graph.accepted_trait_implementation_table,
		bound_module_identity(bound_module),
		prepared_module_scope_canonical_path(bound_module_scope(bound_module)),
	)
	base_state = { base_state |
		module_view = module_view_with_accepted_trait_implementation_authority(
			base_state.module_view,
			accepted_trait_implementation_authority_for_module(
				graph.accepted_trait_implementation_table,
				bound_module,
			),
		),
		private_impls = []
	}
	session_seed ?= body_infer_session_seed(base_state)

	Some({
		session_seed = session_seed,
		errors = base_state.errors,
		diagnostics = base_state.diagnostics,
		import_modules = importable_module_graph_dependencies(graph.importable_graph),
	})


private pure func accepted_body_module_preparation_semantic_observation(
	bound_module: BoundModule,
	error_count: Int,
) -> FrontendDeclarationPreparationObservation:
	visible_import_modules = bound_module_visible_import_modules(bound_module)
	direct_import_modules = bound_module_direct_import_modules(bound_module)
	view = bound_module_view(bound_module)

	frontend_preparation_observation_finish({ frontend_preparation_observation_empty(0) |
			accepted_modules_prepared = 1,
			visible_module_edges = visible_import_modules.length(),
			direct_module_edges = direct_import_modules.length(),
			module_view_projection_entries = frontend_preparation_module_view_projection_entries(
				view,
			),
			body_contexts_created = 1,
			error_count = error_count
		})


private pure func observe_accepted_body_module_preparation(
	graph: TypecheckGraphFacts,
	bound_module: BoundModule,
	state: TypecheckState,
	import_scope: AcceptedTypecheckImportScope,
) -> FrontendDeclarationPreparationObservation:
	type_headers = trait_topology_graph_type_headers(accepted_typecheck_graph_trait_topology(graph))
	prepared_environment = prepared_module_environment_find(
		graph,
		bound_module_identity(bound_module),
	)

	prepared: Option[PreparedAcceptedBodyModule] = match (import_scope, prepared_environment):
		(CanonicalTypecheckImports, Some(environment)):
			prepare_canonical_body_module(graph, environment)
		(CanonicalTypecheckImports, None):
			None
		(CtfeArtifactTypecheckImports, _):
			type_alias_authority = prepare_type_alias_authority(
				graph.accepted_alias_graph,
				type_headers,
				bound_module,
				state,
			)
			record_type_authority = prepare_record_type_authority(
				graph.accepted_record_graph,
				type_headers,
				bound_module,
				type_alias_authority.state,
			)
			union_type_authority = prepare_union_type_authority(
				graph.accepted_union_graph,
				type_headers,
				bound_module,
				record_type_authority.state,
			)
			prepare_ctfe_artifact_body_module(
				graph,
				bound_module,
				union_type_authority.state,
				type_alias_authority.authority,
				record_type_authority.authority,
				union_type_authority.authority,
			)

	match prepared:
		None:
			frontend_preparation_observation_finish(
				{ frontend_preparation_observation_empty(0) | error_count = 1 },
			)
		Some(prepared):
			semantic_observation = match import_scope:
				CanonicalTypecheckImports:
					frontend_preparation_observation_finish(
						{ frontend_preparation_observation_empty(0) |
							accepted_modules_prepared = 1,
							body_contexts_created = 1,
							error_count = prepared.errors.length()
						},
					)
				CtfeArtifactTypecheckImports:
					accepted_body_module_preparation_semantic_observation(
						bound_module,
						prepared.errors.length(),
					)

			body_sessions_created = match import_scope:
				CanonicalTypecheckImports:
					representation: AcceptedTypecheckModuleRep = {
						graph_facts = graph,
						bound_module = bound_module,
						prepared_body = prepared
					}
					body_contexts_from_base(
						accepted_body_module_base(
							into_opaque AcceptedTypecheckModule(representation),
						),
						ValidateProgramMain,
					).contexts.length()
				CtfeArtifactTypecheckImports:
					0

			session_observation = frontend_preparation_observation_finish(
				{ frontend_preparation_observation_empty(0) |
					body_sessions_created = body_sessions_created
				},
			)

			frontend_preparation_observation_add(semantic_observation, session_observation)


pure func accepted_typecheck_graph_declaration_preparation_observation(
	graph: AcceptedTypecheckGraph,
) -> FrontendDeclarationPreparationObservation:
	facts = accepted_typecheck_graph_rep(graph).facts
	callable_headers = implementation_header_graph_callable_headers(facts.implementation_headers)
	trait_topology = callable_header_graph_trait_topology(callable_headers)
	type_headers = trait_topology_graph_type_headers(trait_topology)
	bound_graph = type_header_graph_bound_graph(type_headers)
	modules = [
		bound_module_graph_target(bound_graph),
	].concat(bound_module_graph_modules(bound_graph))
	var observation = frontend_preparation_unique_declaration_observation(
		type_headers,
		callable_headers,
		trait_topology,
		facts.implementation_headers,
		modules,
	)
	observation = frontend_preparation_observation_add(
		observation,
		frontend_preparation_observation_finish(
			{ frontend_preparation_observation_empty(0) |
				canonical_module_base_builds = facts.prepared_environments.length()
			},
		),
	)

	for module in modules:
		state = typecheck_state_for_prepared_module_scope(bound_module_scope(module), False)
		observation = frontend_preparation_observation_add(
			observation,
			observe_accepted_body_module_preparation(
				facts,
				module,
				state,
				CanonicalTypecheckImports,
			),
		)

	frontend_preparation_observation_finish(observation)


pure func accepted_typecheck_graph_initializer_preparation_observation(
	graph: AcceptedTypecheckGraph,
) -> FrontendDeclarationPreparationObservation:
	facts = accepted_typecheck_graph_rep(graph).facts
	callable_headers = implementation_header_graph_callable_headers(facts.implementation_headers)
	trait_topology = callable_header_graph_trait_topology(callable_headers)
	type_headers = trait_topology_graph_type_headers(trait_topology)
	bound_graph = type_header_graph_bound_graph(type_headers)
	modules = [
		bound_module_graph_target(bound_graph),
	].concat(bound_module_graph_modules(bound_graph))
	var observation = frontend_preparation_unique_declaration_observation(
		type_headers,
		callable_headers,
		trait_topology,
		facts.implementation_headers,
		modules,
	)
	observation = frontend_preparation_observation_add(
		observation,
		frontend_preparation_observation_finish(
			{ frontend_preparation_observation_empty(0) |
				canonical_module_base_builds = facts.prepared_environments.length()
			},
		),
	)

	for module in modules:
		environment = prepared_module_environment_find(facts, bound_module_identity(module))
		base_state = environment
			.map(typecheck_session_for_prepared_module)
			.get_or(
				typecheck_state_add_error(
					typecheck_state_for_prepared_module_scope(bound_module_scope(module), False),
					"internal typecheck error: accepted module has no prepared environment",
				),
			)

		installed_state = match environment:
			Some(found):
				match module_view_accepted_global_authority(base_state.module_view):
					Some(authority):
						{ base_state | module_view = module_view_with_accepted_global_authority(
								base_state.module_view,
								accepted_global_authority_with_completed_table(
									authority,
									facts.accepted_global_table,
								),
							) }
					None:
						typecheck_state_add_error(
							base_state,
							"internal typecheck error: prepared module has no accepted global authority",
						)
			None:
				base_state

		base_observation = accepted_body_module_preparation_semantic_observation(
			module,
			installed_state.errors.length(),
		)
		observation = frontend_preparation_observation_add(observation, base_observation)

	frontend_preparation_observation_finish(observation)


pure func accepted_typecheck_graph_ctfe_artifact_preparation_observation(
	graph: AcceptedTypecheckGraph,
) -> FrontendDeclarationPreparationObservation:
	facts = accepted_typecheck_graph_rep(graph).facts
	callable_headers = implementation_header_graph_callable_headers(facts.implementation_headers)
	trait_topology = callable_header_graph_trait_topology(callable_headers)
	type_headers = trait_topology_graph_type_headers(trait_topology)
	bound_graph = type_header_graph_bound_graph(type_headers)
	modules = bound_module_graph_modules(bound_graph)
	var observation = frontend_preparation_unique_declaration_observation(
		type_headers,
		callable_headers,
		trait_topology,
		facts.implementation_headers,
		modules,
	)

	for module in modules:
		state = typecheck_state_for_prepared_module_scope(bound_module_scope(module), False)

		match graph_facts_ctfe_artifact_typecheck_module(facts, bound_module_scope(module), state):
			Some(artifact_module):
				representation = accepted_typecheck_module_rep(artifact_module)
				observation = frontend_preparation_observation_add(
					observation,
					accepted_body_module_preparation_semantic_observation(
						representation.bound_module,
						representation.prepared_body.errors.length(),
					),
				)
			None:
				observation = frontend_preparation_observation_add(
					observation,
					frontend_preparation_observation_finish(
						{ frontend_preparation_observation_empty(0) | error_count = 1 },
					),
				)

	frontend_preparation_observation_finish(observation)


private pure func accepted_body_module_base(
	input: AcceptedTypecheckModule,
) -> AcceptedBodyModuleBase:
	representation = accepted_typecheck_module_rep(input)
	import_modules = representation.prepared_body.import_modules
	fresh_state = fresh_body_infer_session(representation.prepared_body.session_seed)
	state = { fresh_state |
		errors = representation.prepared_body.errors,
		diagnostics = representation.prepared_body.diagnostics
	}
	{
		representation = representation,
		state = state,
		import_modules = import_modules,
		plan_provenance = body_plan_provenance(
			representation.bound_module,
			state.allow_debug_only_calls,
		)
	}


private record BodyCheckContextRep {
	id: CallableId,
	plan_provenance: BodyPlanProvenance,
	session_seed: BodyInferSessionSeed,
	source: ParsedFunctionDecl,
	signature: FunctionBodySignature,
	main_policy: MainValidationPolicy,
	source_order: Int
}


opaque type BodyCheckContext = BodyCheckContextRep


union BodyCheckContextBuild:
	BodyContextReady(BodyCheckContext)
	BodyContextRejected(BodyCheckContextFailure)


private record BodyCheckPlanDraft {
	contexts: List[BodyCheckContext],
	failures: List[BodyCheckPlanningFailure],
	implementation_rejections: List[BodyImplementationPlanningFailure]
}


union BodyCheckPlan:
	BodyCheckPlanReady(List[BodyCheckContext], List[BodyImplementationPlanningFailure])
	BodyCheckPlanRejected(List[BodyCheckPlanningFailure])


-- A body context cannot carry diagnostics, solver substitutions, or memoized
-- results from another body. Only immutable module/header facts cross this
-- boundary; constructing the TypecheckState used by the inference kernel is a
-- private operation that always creates fresh body-local state.
private record BodyInferSessionSeed {
	context_facts: PreparedInferContextFacts,
	env_facts: PreparedInferSessionEnv,
	module_facts: InferModuleFacts
}


private pure func body_infer_session_seed(state: TypecheckState) -> Option[BodyInferSessionSeed]:
	env_facts ?= prepare_infer_session_env(state.env)
	Some({
		context_facts = prepared_infer_context_facts(state.context),
		env_facts = env_facts,
		module_facts = infer_module_facts_from_typecheck_state(state),
	})


private pure func fresh_body_infer_session(seed: BodyInferSessionSeed) -> TypecheckState:
	{
		context = context_from_prepared_infer_facts(seed.context_facts),
		env = env_from_prepared_infer_session(seed.env_facts),
		errors = [],
		diagnostics = [],
		module_view = seed.module_facts.module_view,
		module_scope = seed.module_facts.module_scope,
		allow_debug_only_calls = seed.module_facts.allow_debug_only_calls,
		private_impls = seed.module_facts.private_impls,
		known_type_index = seed.module_facts.known_type_index,
		scoped_trait_functions = seed.module_facts.scoped_trait_functions,
		type_homes = seed.module_facts.type_homes,
		type_shape_memo = TYPE_SHAPE_MEMO_EMPTY
	}


pure func body_check_context_callable_id(context: BodyCheckContext) -> CallableId:
	from_opaque BodyCheckContext(context).id


private pure func accepted_callable_body_ids(
	representation: AcceptedTypecheckModuleRep,
) -> List[CallableId]:
	callable_headers = implementation_header_graph_callable_headers(
		representation.graph_facts.implementation_headers,
	)
	module_identity = bound_module_identity(representation.bound_module)

	callable_header_graph_callables(callable_headers)
		.filter(func(header):
			(
				module_identities_equal(
					callable_id_module_identity(callable_header_id(header)),
					module_identity,
				)
				and callable_header_body_category(header) == SourceCallableBody
			)
		)
		.map(callable_header_id)


pure func accepted_typecheck_module_body_plan(input: AcceptedTypecheckModule) -> BodyCheckPlan:
	draft = body_contexts_from_base(accepted_body_module_base(input), ValidateProgramMain)

	if draft.failures.is_empty():
		BodyCheckPlanReady(draft.contexts, draft.implementation_rejections)
	else:
		BodyCheckPlanRejected(draft.failures)


private pure func body_signature_from_accepted_header(
	base: AcceptedBodyModuleBase,
	header: CallableHeader,
) -> Option[FunctionBodySignature]:
	id = callable_header_id(header)
	authority ?= module_view_accepted_callable_authority(base.state.module_view)
	entry ?= accepted_callable_find_exact(authority, id)

	match entry.func_type:
		SemanticFunctionType(_, param_types, return_type):
			Some({
				callable_id = Some(callable_id_definition_id(id)),
				effective_type_params = entry.type_params,
				param_types = param_types,
				semantic_return_type = return_type,
			})
		_:
			None


private pure func implementation_body_signature_from_accepted_header(
	base: AcceptedBodyModuleBase,
	implementation: ImplementationHeader,
	method_header: ImplementationMethodHeader,
	signature: CallableSignature,
) -> Option[FunctionBodySignature]:
	implementation_id = implementation_header_id(implementation)
	type_headers = trait_topology_graph_type_headers(
		accepted_typecheck_graph_trait_topology(base.representation.graph_facts),
	)
	registration = LocalCallableHeaderRegistration(
		prepared_module_scope_canonical_path(bound_module_scope(base.representation.bound_module)),
	)
	var param_types: List[SemanticType] = []
	var conversion_failed: Bool = False

	for parameter in callable_signature_parameters(signature):
		param_type = callable_header_semantic_type(
			type_headers,
			impl_id_module_identity(implementation_id),
			registration,
			parameter.typ,
		)

		match param_type:
			Some(resolved):
				param_types = param_types.append(resolved)
			None:
				conversion_failed = True

	return_type = callable_header_semantic_type(
		type_headers,
		impl_id_module_identity(implementation_id),
		registration,
		callable_signature_return_type(signature),
	)
	id = implementation_method_header_id(method_header)

	match return_type:
		Some(resolved_return_type):
			if conversion_failed:
				None
			else:
				Some({
					callable_id = Some(callable_id_definition_id(id)),
					effective_type_params = implementation_bound_type_params(
						implementation,
					).concat(implementation_method_bound_type_params(method_header)),
					param_types = param_types,
					semantic_return_type = resolved_return_type,
				})
		None:
			None


private pure func explicit_body_signature_from_accepted_header(
	base: AcceptedBodyModuleBase,
	implementation: ImplementationHeader,
	method_header: ImplementationMethodHeader,
) -> Option[FunctionBodySignature]:
	signature ?= explicit_implementation_method_signature(method_header)
	implementation_body_signature_from_accepted_header(
		base,
		implementation,
		method_header,
		signature,
	)


private pure func default_body_signature_from_accepted_header(
	base: AcceptedBodyModuleBase,
	implementation: ImplementationHeader,
	method_header: ImplementationMethodHeader,
) -> Option[FunctionBodySignature]:
	signature ?= default_implementation_method_signature(implementation, method_header)
	implementation_body_signature_from_accepted_header(
		base,
		implementation,
		method_header,
		signature,
	)


private record PreparedImplementationBody {
	state: TypecheckState,
	has_concrete_receiver: Bool
}


private union ImplementationBodyPreparation:
	ImplementationBodyPrepared(PreparedImplementationBody)
	ImplementationBodyRejected(List[String], List[TypecheckDiagnostic])


private pure func prepare_implementation_body(
	base: AcceptedBodyModuleBase,
	implementation: ImplementationHeader,
) -> ImplementationBodyPreparation:
	impl_decl = implementation_header_source(implementation)
	raw_for_type = canonical_annotation_type(
		base.state,
		type_from_parsed_type_expr(impl_decl.for_type),
	)
	for_type = impl_normalize_receiver_type(base.state, impl_decl.for_type, raw_for_type)
	bounds = impl_bounds_for_decl_type(base.state, impl_decl.for_type, for_type)

	with_bounds = if bounds.is_empty():
		base.state
	else:
		{ base.state | env = env_extend_type_param_bounds(base.state.env, bounds) }

	validated = typecheck_validate_impl_decl(with_bounds, impl_decl, for_type)

	if validated.errors.length() == with_bounds.errors.length():
		ImplementationBodyPrepared({
			state = add_impl_body_trait_functions(validated, impl_decl.trait_name.text),
			has_concrete_receiver = collect_type_vars(for_type).is_empty(),
		})
	else:
		ImplementationBodyRejected(
			validated.errors.drop(with_bounds.errors.length()),
			validated.diagnostics.drop(with_bounds.diagnostics.length()),
		)


private pure func implementation_method_body_context_from_base(
	base: AcceptedBodyModuleBase,
	implementation: ImplementationHeader,
	method_header: ImplementationMethodHeader,
	prepared: PreparedImplementationBody,
) -> BodyCheckContextBuild:
	impl_decl = implementation_header_source(implementation)

	method_source: Option[ParsedFunctionDecl] = match explicit_implementation_method_source(
		method_header,
	):
		Some(source):
			Some(source)
		None:
			if prepared.has_concrete_receiver:
				default_implementation_method_source(
					method_header,
				).map(
					func(method): default_impl_method_decl(impl_decl, method),
				)
			else:
				None

	match method_source:
		None:
			BodyContextRejected(BodyContextUnsupportedSource)
		Some(source):
			signature = match method_header:
				DefaultImplementationMethodHeaderValue(_):
					default_body_signature_from_accepted_header(base, implementation, method_header)
				ExplicitImplementationMethodHeaderValue(_):
					explicit_body_signature_from_accepted_header(
						base,
						implementation,
						method_header,
					)

			match signature:
				None:
					BodyContextRejected(BodyContextMissingAcceptedSignature)
				Some(accepted_signature):
					match body_infer_session_seed(prepared.state):
						None:
							BodyContextRejected(BodyContextInvalidPreparedEnvironment)
						Some(session_seed):
							BodyContextReady(into_opaque BodyCheckContext({
										id = implementation_method_header_id(method_header),
										plan_provenance = base.plan_provenance,
										session_seed = session_seed,
										source = source,
										signature = accepted_signature,
										main_policy = IgnoreMainName,
										source_order = impl_decl.span.start_offset
									}))


private union ImplementationBodyContextLookup:
	ImplementationBodyContextFound(BodyCheckContextBuild)
	ImplementationBodyContextMissing


private pure func implementation_body_context_for_id(
	base: AcceptedBodyModuleBase,
	id: CallableId,
) -> ImplementationBodyContextLookup:
	var result: ImplementationBodyContextLookup = ImplementationBodyContextMissing

	for implementation in implementation_header_graph_headers(
		base.representation.graph_facts.implementation_headers,
	):
		for method in implementation_header_methods(implementation):
			if callable_ids_equal(implementation_method_header_id(method), id):
				context = match prepare_implementation_body(base, implementation):
					ImplementationBodyRejected(_, _):
						BodyContextRejected(BodyContextInvalidImplementation)
					ImplementationBodyPrepared(prepared):
						implementation_method_body_context_from_base(
							base,
							implementation,
							method,
							prepared,
						)

				result = ImplementationBodyContextFound(context)
				break

		match result:
			ImplementationBodyContextFound(_):
				break
			ImplementationBodyContextMissing:
				void

	result


private pure func body_check_context_build_from_base(
	base: AcceptedBodyModuleBase,
	id: CallableId,
	main_policy: MainValidationPolicy,
) -> BodyCheckContextBuild:
	representation = base.representation

	if not module_identities_equal(
		callable_id_module_identity(id),
		bound_module_identity(representation.bound_module),
	):
		BodyContextRejected(BodyContextForeignOwner)
	else:
		callable_headers = implementation_header_graph_callable_headers(
			representation.graph_facts.implementation_headers,
		)

		match callable_header_graph_find(callable_headers, id):
			None:
				match implementation_body_context_for_id(base, id):
					ImplementationBodyContextMissing:
						BodyContextRejected(BodyContextUnknownIdentity)
					ImplementationBodyContextFound(result):
						result
			Some(header):
				if callable_header_body_category(header) != SourceCallableBody:
					BodyContextRejected(BodyContextNotSourceBody)
				else:
					match callable_header_source(header):
						ForeignCallableHeaderSource(_):
							BodyContextRejected(BodyContextUnsupportedSource)
						FunctionCallableHeaderSource(source):
							match body_signature_from_accepted_header(base, header):
								None:
									BodyContextRejected(BodyContextMissingAcceptedSignature)
								Some(signature):
									BodyContextReady(into_opaque BodyCheckContext({
												id = callable_header_id(header),
												plan_provenance = base.plan_provenance,
												session_seed = representation.prepared_body.session_seed,
												source = source,
												signature = signature,
												main_policy = main_policy,
												source_order = source.span.start_offset
											}))


pure func accepted_typecheck_module_body_registry(
	input: AcceptedTypecheckModule,
) -> BodyCheckRegistry:
	into_opaque BodyCheckRegistry({base = accepted_body_module_base(input)})


pure func body_check_registry_context_for_definition_id(
	registry: BodyCheckRegistry,
	definition_id: Int,
) -> Option[BodyCheckContextBuild]:
	base = from_opaque BodyCheckRegistry(registry).base
	id ?= callable_id_for_definition(
		base.representation.graph_facts.implementation_headers,
		definition_id,
	)

	if module_identities_equal(
		callable_id_module_identity(id),
		bound_module_identity(base.representation.bound_module),
	):
		Some(body_check_context_build_from_base(base, id, IgnoreMainName))
	else:
		None


private pure func implementation_body_contexts_from_base(
	base: AcceptedBodyModuleBase,
) -> BodyCheckPlanDraft:
	representation = base.representation
	graph = representation.graph_facts.implementation_headers
	module_identity = bound_module_identity(representation.bound_module)
	var contexts: List[BodyCheckContext] = []
	var failures: List[BodyCheckPlanningFailure] = []
	var implementation_rejections: List[BodyImplementationPlanningFailure] = []

	for implementation in implementation_header_graph_headers(graph):
		if module_identities_equal(
			impl_id_module_identity(implementation_header_id(implementation)),
			module_identity,
		):
			match prepare_implementation_body(base, implementation):
				ImplementationBodyRejected(errors, diagnostics):
					implementation_rejections = implementation_rejections.append({
						errors = errors,
						diagnostics = diagnostics,
					})
				ImplementationBodyPrepared(prepared):
					for method_header in implementation_header_methods(implementation):
						id = implementation_method_header_id(method_header)

						match implementation_method_body_context_from_base(
							base,
							implementation,
							method_header,
							prepared,
						):
							BodyContextReady(context):
								contexts = contexts.append(context)
							BodyContextRejected(reason):
								if prepared.has_concrete_receiver:
									failures = failures.append({
										id = id,
										reason = reason,
									})

	{
		contexts = contexts,
		failures = failures,
		implementation_rejections = implementation_rejections
	}


private pure func body_contexts_from_base(
	base: AcceptedBodyModuleBase,
	main_policy: MainValidationPolicy,
) -> BodyCheckPlanDraft:
	var contexts: List[BodyCheckContext] = []
	var failures: List[BodyCheckPlanningFailure] = []

	for id in accepted_callable_body_ids(base.representation):
		match body_check_context_build_from_base(base, id, main_policy):
			BodyContextReady(context):
				contexts = contexts.append(context)
			BodyContextRejected(reason):
				failures = failures.append({
					id = id,
					reason = reason,
				})

	implementation_plan = implementation_body_contexts_from_base(base)
	{
		contexts = contexts
			.concat(implementation_plan.contexts)
			.sort_by(func(context): from_opaque BodyCheckContext(context).source_order),
		failures = failures.concat(implementation_plan.failures),
		implementation_rejections = implementation_plan.implementation_rejections
	}


pure func accepted_typecheck_module_body_context(
	input: AcceptedTypecheckModule,
	id: CallableId,
) -> BodyCheckContextBuild:
	body_check_context_build_from_base(accepted_body_module_base(input), id, ValidateProgramMain)


private pure func check_function_body_artifact(
	session_seed: BodyInferSessionSeed,
	id: CallableId,
	plan_provenance: BodyPlanProvenance,
	source: ParsedFunctionDecl,
	signature: FunctionBodySignature,
	main_policy: MainValidationPolicy,
) -> BodyCheckOutcome:
	state = fresh_body_infer_session(session_seed)
	result = typecheck_materialize_function_body_with_signature(
		state,
		source,
		signature,
		main_policy,
	)
	validated_state = typecheck_validate_typed_function_info(
		result.state,
		"function '" + source.name.text + "'",
		result.typed,
	)

	if validated_state.errors.is_empty() and validated_state.diagnostics.is_empty():
		BodyCheckAccepted(into_opaque CheckedBodyArtifact({
					id = id,
					plan_provenance = plan_provenance,
					main_policy = main_policy,
					typed = result.typed
				}))
	else:
		BodyCheckRejected(into_opaque RecoveredBodyArtifact({
					id = id,
					plan_provenance = plan_provenance,
					main_policy = main_policy,
					typed = result.typed,
					errors = validated_state.errors,
					diagnostics = validated_state.diagnostics
				}))


pure func check_body_context(context: BodyCheckContext) -> BodyCheckOutcome:
	representation = from_opaque BodyCheckContext(context)
	check_function_body_artifact(
		representation.session_seed,
		representation.id,
		representation.plan_provenance,
		representation.source,
		representation.signature,
		representation.main_policy,
	)


private pure func ordered_body_contexts(
	contexts: List[BodyCheckContext],
	order: BodyCheckOrder,
) -> List[BodyCheckContext]:
	match order:
		SourceBodyOrder:
			contexts
		ReverseBodyOrder:
			contexts.reverse()
		DeterministicShuffledBodyOrder:
			if contexts.length() <= 1:
				contexts
			else:
				contexts
					.drop(1)
					.concat(contexts.take(1))


private pure func check_bodies_in_order(
	base: AcceptedBodyModuleBase,
	order: BodyCheckOrder,
	main_policy: MainValidationPolicy,
) -> (List[BodyCheckOutcome], BodyCheckMetrics):
	draft = body_contexts_from_base(base, main_policy)

	if not draft.failures.is_empty():
		([], {
				context_constructions = 0,
				infer_sessions = 0,
				checked_order = [],
				planning_failures = draft.failures,
				implementation_rejections = draft.implementation_rejections
			})
	else:
		contexts = ordered_body_contexts(draft.contexts, order)
		var outcomes: List[BodyCheckOutcome] = []

		for context in contexts:
			outcomes = outcomes.append(check_body_context(context))

		(outcomes, {
				context_constructions = contexts.length(),
				infer_sessions = contexts.length(),
				checked_order = outcomes.map(body_check_outcome_callable_id),
				planning_failures = [],
				implementation_rejections = draft.implementation_rejections
			})


private pure func body_context_failure_label(reason: BodyCheckContextFailure) -> String:
	match reason:
		BodyContextForeignOwner:
			"foreign body owner"
		BodyContextUnknownIdentity:
			"unknown body identity"
		BodyContextNotSourceBody:
			"non-source body category"
		BodyContextUnsupportedSource:
			"unsupported body source"
		BodyContextMissingAcceptedSignature:
			"missing accepted body signature"
		BodyContextInvalidImplementation:
			"invalid implementation body owner"
		BodyContextInvalidPreparedEnvironment:
			"non-root prepared body environment"


private pure func body_planning_failure_message(failure: BodyCheckPlanningFailure) -> String:
	"internal typecheck error: could not construct body context for definition " + callable_id_definition_id(
		failure.id,
	).to_string() + ": " + body_context_failure_label(failure.reason)


private pure func body_outcome_index(
	owner: ModuleIdentity,
	outcomes: List[BodyCheckOutcome],
) -> BodyOutcomeIndexBuild:
	var index: Dict[Int, BodyCheckOutcome] = {}
	var errors: List[String] = []

	for outcome in outcomes:
		id = body_check_outcome_callable_id(outcome)
		definition_id = callable_id_definition_id(id)

		if not module_identities_equal(owner, callable_id_module_identity(id)):
			errors = errors.append(
				"internal typecheck error: body outcome belongs to a foreign module",
			)
		else if (
			index
				.get(definition_id)
				.is_some()
		):
			errors = errors.append(
				"internal typecheck error: duplicate body outcome for definition " + definition_id.to_string(),
			)
		else:
			index = index.set(definition_id, outcome)

	if errors.is_empty():
		BodyOutcomeIndexAccepted(into_opaque BodyOutcomeIndex({
					owner = owner,
					by_definition_id = index
				}))
	else:
		BodyOutcomeIndexRejected(errors)


private pure func body_outcome_index_for_base(
	base: AcceptedBodyModuleBase,
	outcomes: List[BodyCheckOutcome],
) -> BodyOutcomeIndexBuild:
	provenance_errors = outcomes
		.filter(func(outcome):
			not body_plan_provenances_equal(
				body_check_outcome_plan_provenance(outcome),
				base.plan_provenance,
			)
		)
		.map(func(_):
			"internal typecheck error: seeded body outcome belongs to a different body plan"
		)

	if provenance_errors.is_empty():
		body_outcome_index(bound_module_identity(base.representation.bound_module), outcomes)
	else:
		BodyOutcomeIndexRejected(provenance_errors)


private record CtfeSubsetDeclMaterialization {
	state: TypecheckState,
	decl: Option[TypedDecl]
}


private pure func materialize_ctfe_subset_decl(
	state: TypecheckState,
	module_path: String,
	decls: List[ParsedDecl],
	import_modules: List[ImportableModule],
	completed_globals: CompletedGlobalHeaderGraph,
	outcomes: BodyOutcomeIndex,
	callable_headers: CallableHeaderGraph,
	decl: ParsedDecl,
) -> CtfeSubsetDeclMaterialization:
	match decl:
		FunctionParsedDecl(_):
			{
				state = state,
				decl = None
			}
		PrivateParsedDecl(inner, _):
			result = materialize_ctfe_subset_decl(
				state,
				module_path,
				decls,
				import_modules,
				completed_globals,
				outcomes,
				callable_headers,
				inner,
			)
			{
				state = result.state,
				decl = result.decl.map(func(typed): TypedPrivateDecl(typed))
			}
		ImplParsedDecl(_):
			{
				state = state,
				decl = None
			}
		_:
			result = typecheck_materialize_decl_body(
				state,
				module_path,
				decls,
				import_modules,
				ReuseAcceptedGlobalBodies(completed_globals),
				ReuseIndependentFunctionBodies(outcomes, callable_headers),
				decl,
				IgnoreMainName,
			)
			{
				state = result.state,
				decl = Some(result.decl)
			}


pure func body_check_registry_materialize_subset(
	registry: BodyCheckRegistry,
	outcomes: List[BodyCheckOutcome],
) -> BodySubsetProgramBuild:
	base = from_opaque BodyCheckRegistry(registry).base

	match body_outcome_index_for_base(base, outcomes):
		BodyOutcomeIndexRejected(errors):
			BodySubsetProgramRejected(errors)
		BodyOutcomeIndexAccepted(index):
			program = bound_module_program(base.representation.bound_module)
			callable_headers = implementation_header_graph_callable_headers(
				base.representation.graph_facts.implementation_headers,
			)
			var next_state = base.state
			var typed_decls: List[TypedDecl] = []

			for decl in program.decls:
				next_state = typecheck_state_reset_type_shape_memo(next_state)

				match decl:
					ForeignBlockParsedDecl(block_args, functions, block_span):
						foreign_result = typed_foreign_block(
							next_state,
							block_args,
							functions,
							block_span,
						)
						next_state = foreign_result.state
						typed_decls = typed_decls.concat(foreign_result.decls)
					_:
						result = materialize_ctfe_subset_decl(
							next_state,
							program.source.module_name,
							program.decls,
							base.import_modules,
							base.representation.graph_facts.completed_globals,
							index,
							callable_headers,
							decl,
						)
						next_state = result.state

						match result.decl:
							Some(typed):
								typed_decls = typed_decls.append(typed)
							None:
								void

			errors = next_state.errors.concat(next_state.diagnostics.map(
				func(diagnostic): diagnostic.message,
			))

			if errors.is_empty():
				BodySubsetProgramReady(into_opaque BodySubsetProgram({
							decls = typed_decls,
							import_bindings = module_view_import_bindings(next_state.module_view)
						}))
			else:
				BodySubsetProgramRejected(errors)


private pure func materialize_program_from_body_outcomes(
	base: AcceptedBodyModuleBase,
	outcomes: List[BodyCheckOutcome],
	planning_failures: List[BodyCheckPlanningFailure],
	main_policy: MainValidationPolicy,
) -> TypecheckProgramResult:
	program = bound_module_program(base.representation.bound_module)

	if not planning_failures.is_empty():
		rejected_typecheck_program(
			base.state,
			program,
			planning_failures
				.map(body_planning_failure_message)
				.join("; "),
		)
	else:
		match body_outcome_index_for_base(base, outcomes):
			BodyOutcomeIndexRejected(errors):
				rejected_typecheck_program(
					base.state,
					program,
					errors.join("; "),
				)
			BodyOutcomeIndexAccepted(index):
				typecheck_materialize_standalone_program_bodies_with_import_modules(
					base.state,
					program,
					base.import_modules,
					ReuseAcceptedGlobalBodies(base.representation.graph_facts.completed_globals),
					ReuseIndependentFunctionBodies(
						index,
						implementation_header_graph_callable_headers(
							base.representation.graph_facts.implementation_headers,
						),
					),
					main_policy,
				)


private pure func typecheck_program_from_body_base_in_order(
	base: AcceptedBodyModuleBase,
	order: BodyCheckOrder,
	main_policy: MainValidationPolicy,
) -> BodyCheckRun:
	(outcomes, metrics) = check_bodies_in_order(base, order, main_policy)
	result = materialize_program_from_body_outcomes(
		base,
		outcomes,
		metrics.planning_failures,
		main_policy,
	)

	{
		result = result,
		metrics = metrics
	}


private pure func seeded_body_context_errors(
	contexts: List[BodyCheckContext],
	seed_outcomes: List[BodyCheckOutcome],
) -> List[String]:
	var errors: List[String] = []

	for outcome in seed_outcomes:
		id = body_check_outcome_callable_id(outcome)
		matching_context = contexts.find(
			func(context): callable_ids_equal(body_check_context_callable_id(context), id),
		)

		match matching_context:
			None:
				errors = errors.append((
						"internal typecheck error: seeded body outcome is not part of the current body "
						+ "plan"
					))
			Some(_):
				void

	errors


private pure func body_check_outcome_reusable_for_context(
	outcome: BodyCheckOutcome,
	context: BodyCheckContext,
) -> Bool:
	id = body_check_context_callable_id(context)

	if callable_id_name(id) == "main":
		body_check_outcome_main_policy(outcome) == from_opaque BodyCheckContext(context).main_policy
	else:
		True


pure func body_check_registry_materialize_complete_with_seed(
	registry: BodyCheckRegistry,
	seed_outcomes: List[BodyCheckOutcome],
	main_policy: MainValidationPolicy,
) -> SeededBodyCheckRun:
	base = from_opaque BodyCheckRegistry(registry).base
	draft = body_contexts_from_base(base, main_policy)
	seed_errors = seeded_body_context_errors(draft.contexts, seed_outcomes)

	if not draft.failures.is_empty():
		{
			result = materialize_program_from_body_outcomes(base, [], draft.failures, main_policy),
			checked_bodies = 0,
			reused_bodies = 0
		}
	else if not seed_errors.is_empty():
		{
			result = rejected_typecheck_program(
				base.state,
				bound_module_program(base.representation.bound_module),
				seed_errors.join("; "),
			),
			checked_bodies = 0,
			reused_bodies = 0
		}
	else:
		match body_outcome_index_for_base(base, seed_outcomes):
			BodyOutcomeIndexRejected(errors):
				{
					result = rejected_typecheck_program(
						base.state,
						bound_module_program(base.representation.bound_module),
						errors.join("; "),
					),
					checked_bodies = 0,
					reused_bodies = 0
				}
			BodyOutcomeIndexAccepted(seed_index):
				var outcomes: List[BodyCheckOutcome] = []
				var checked_bodies: Int = 0
				var reused_bodies: Int = 0

				for context in draft.contexts:
					id = body_check_context_callable_id(context)

					match body_outcome_index_find(seed_index, id):
						Some(outcome):
							if body_check_outcome_reusable_for_context(outcome, context):
								outcomes = outcomes.append(outcome)
								reused_bodies += 1
							else:
								outcomes = outcomes.append(check_body_context(context))
								checked_bodies += 1
						None:
							outcomes = outcomes.append(check_body_context(context))
							checked_bodies += 1

				{
					result = materialize_program_from_body_outcomes(
						base,
						outcomes,
						[],
						main_policy,
					),
					checked_bodies = checked_bodies,
					reused_bodies = reused_bodies
				}


pure func typecheck_program_with_type_header_module_in_body_order(
	input: AcceptedTypecheckModule,
	order: BodyCheckOrder,
) -> BodyCheckRun:
	typecheck_program_with_type_header_module_in_body_order_for_policy(
		input,
		order,
		ValidateProgramMain,
	)


pure func typecheck_program_with_type_header_module_in_body_order_for_policy(
	input: AcceptedTypecheckModule,
	order: BodyCheckOrder,
	main_policy: MainValidationPolicy,
) -> BodyCheckRun:
	typecheck_program_from_body_base_in_order(accepted_body_module_base(input), order, main_policy)


private pure func typecheck_program_with_accepted_type_headers(
	input: AcceptedTypecheckModule,
	main_policy: MainValidationPolicy,
) -> TypecheckProgramResult:
	typecheck_program_from_body_base_in_order(
		accepted_body_module_base(input),
		SourceBodyOrder,
		main_policy,
	).result


pure func typecheck_program_with_type_header_module(
	input: AcceptedTypecheckModule,
) -> TypecheckProgramResult:
	typecheck_program_with_accepted_type_headers(input, ValidateProgramMain)


pure func typecheck_program_with_type_header_module_for_policy(
	input: AcceptedTypecheckModule,
	main_policy: MainValidationPolicy,
) -> TypecheckProgramResult:
	typecheck_program_with_accepted_type_headers(input, main_policy)


private func typecheck_program_with_accepted_type_headers_and_trace(
	input: AcceptedTypecheckModule,
	trace: (TypecheckTracePhase, Int) -> Void,
	main_policy: MainValidationPolicy,
) -> TypecheckProgramResult:
	representation = accepted_typecheck_module_rep(input)
	graph = representation.graph_facts
	bound_module = representation.bound_module
	callable_headers = implementation_header_graph_callable_headers(graph.implementation_headers)
	program = bound_module_program(bound_module)
	body_base = accepted_body_module_base(input)

	-- These phases completed when the accepted module prepared its immutable
	-- body base. Preserve the trace protocol without replaying registration.
	trace(PreludeComplete, TYPECHECK_TRACE_UNINDEXED)
	trace(ReachableImportsComplete, TYPECHECK_TRACE_UNINDEXED)
	trace(ImportSurfacesComplete, TYPECHECK_TRACE_UNINDEXED)
	trace(DirectImportsComplete, TYPECHECK_TRACE_UNINDEXED)
	trace(PrescanComplete, TYPECHECK_TRACE_UNINDEXED)
	trace(ImportSyntaxComplete, TYPECHECK_TRACE_UNINDEXED)
	trace(ImportDeclsComplete, TYPECHECK_TRACE_UNINDEXED)
	trace(LocalTypesComplete, TYPECHECK_TRACE_UNINDEXED)
	trace(LocalSignaturesComplete, TYPECHECK_TRACE_UNINDEXED)
	trace(LocalImplsComplete, TYPECHECK_TRACE_UNINDEXED)
	(outcomes, metrics) = check_bodies_in_order(body_base, SourceBodyOrder, main_policy)

	result = if not metrics.planning_failures.is_empty():
		rejected_typecheck_program(
			body_base.state,
			program,
			metrics.planning_failures
				.map(body_planning_failure_message)
				.join("; "),
		)
	else:
		match body_outcome_index(bound_module_identity(bound_module), outcomes):
			BodyOutcomeIndexRejected(errors):
				rejected_typecheck_program(
					body_base.state,
					program,
					errors.join("; "),
				)
			BodyOutcomeIndexAccepted(index):
				typecheck_materialize_standalone_program_bodies_with_import_modules_with_trace(
					body_base.state,
					program,
					body_base.import_modules,
					ReuseAcceptedGlobalBodies(graph.completed_globals),
					ReuseIndependentFunctionBodies(index, callable_headers),
					trace,
					main_policy,
				)

	trace(BodiesComplete, TYPECHECK_TRACE_UNINDEXED)

	result


func typecheck_program_with_type_header_module_and_trace(
	input: AcceptedTypecheckModule,
	trace: (TypecheckTracePhase, Int) -> Void,
) -> TypecheckProgramResult:
	typecheck_program_with_accepted_type_headers_and_trace(input, trace, ValidateProgramMain)


func typecheck_program_with_type_header_module_and_trace_for_policy(
	input: AcceptedTypecheckModule,
	trace: (TypecheckTracePhase, Int) -> Void,
	main_policy: MainValidationPolicy,
) -> TypecheckProgramResult:
	typecheck_program_with_accepted_type_headers_and_trace(input, trace, main_policy)


pure func rejected_typecheck_program(
	state: TypecheckState,
	program: ParsedProgram,
	message: String,
) -> TypecheckProgramResult:
	rejected_state = typecheck_state_add_error(state, message)
	{
		state = rejected_state,
		program = typed_program_from_decls(rejected_state, program, [])
	}


pure func rejected_typecheck_program_with_diagnostics(
	state: TypecheckState,
	program: ParsedProgram,
	diagnostics: List[TypecheckDiagnostic],
) -> TypecheckProgramResult:
	var rejected_state = state

	for diagnostic in diagnostics:
		rejected_state = typecheck_state_add_diagnostic(rejected_state, diagnostic)

	{
		state = rejected_state,
		program = typed_program_from_decls(rejected_state, program, [])
	}
