private record FunctionBodySignature {
	callable_id: Option[Int],
	effective_type_params: List[BoundTypeParam],
	param_types: List[SemanticType],
	semantic_return_type: SemanticType
}


private pure func typecheck_with_body_env(
	outer_env: Env,
	body_state: TypecheckState,
) -> TypecheckState:
	next_def_id = if body_state.env.next_def_id > outer_env.next_def_id:
		body_state.env.next_def_id
	else:
		outer_env.next_def_id

	env = { outer_env | next_def_id = next_def_id }
	{ body_state | env = env }


record TypedFunctionInfo {
	decl: ParsedFunctionDecl,
	callable_id: Option[Int],
	effective_type_params: List[BoundTypeParam],
	param_types: List[SemanticType],
	source_return_type: Option[SemanticType],
	semantic_return_type: SemanticType,
	body: Option[TypedExpr]
}


record TypedGlobalVarInfo {
	decl: ParsedVarDecl,
	definition_id: Option[Int],
	binding_type: SemanticType,
	source_type: Option[SemanticType],
	value: TypedExpr
}


union CompletedGlobalHeader:
	CompletedAnnotatedGlobalHeader(GlobalId, DeclarationVisibility, TypedGlobalVarInfo, SemanticType, List[GlobalId], List[CallableId])
	CompletedInferredGlobalHeader(GlobalId, DeclarationVisibility, TypedGlobalVarInfo, SemanticType, List[GlobalId], List[CallableId])


struct GlobalHeaderCompletionMetrics {
	initializer_checks: Int,
	duplicate_initializer_requests: Int
}


pure func completed_global_header_id(header: CompletedGlobalHeader) -> GlobalId:
	match header:
		CompletedAnnotatedGlobalHeader(id, _, _, _, _, _):
			id
		CompletedInferredGlobalHeader(id, _, _, _, _, _):
			id


pure func completed_global_header_visibility(
	header: CompletedGlobalHeader,
) -> DeclarationVisibility:
	match header:
		CompletedAnnotatedGlobalHeader(_, visibility, _, _, _, _):
			visibility
		CompletedInferredGlobalHeader(_, visibility, _, _, _, _):
			visibility


pure func completed_global_header_typed(header: CompletedGlobalHeader) -> TypedGlobalVarInfo:
	match header:
		CompletedAnnotatedGlobalHeader(_, _, typed, _, _, _):
			typed
		CompletedInferredGlobalHeader(_, _, typed, _, _, _):
			typed


pure func completed_global_header_canonical_binding_type(
	header: CompletedGlobalHeader,
) -> SemanticType:
	match header:
		CompletedAnnotatedGlobalHeader(_, _, _, typ, _, _):
			typ
		CompletedInferredGlobalHeader(_, _, _, typ, _, _):
			typ


pure func completed_global_header_global_dependencies(
	header: CompletedGlobalHeader,
) -> List[GlobalId]:
	match header:
		CompletedAnnotatedGlobalHeader(_, _, _, _, dependencies, _):
			dependencies
		CompletedInferredGlobalHeader(_, _, _, _, dependencies, _):
			dependencies


pure func completed_global_header_callable_dependencies(
	header: CompletedGlobalHeader,
) -> List[CallableId]:
	match header:
		CompletedAnnotatedGlobalHeader(_, _, _, _, _, dependencies):
			dependencies
		CompletedInferredGlobalHeader(_, _, _, _, _, dependencies):
			dependencies


private record CompletedGlobalHeaderGraphRep {
	headers: List[CompletedGlobalHeader],
	indices_by_module_and_name: Dict[String, Dict[String, Int]],
	metrics: GlobalHeaderCompletionMetrics
}


-- The sole representation contains only successfully inferred initializers.
-- Pending and rejected declarations live outside this type, so accepted body
-- entry cannot accidentally install a placeholder type.
opaque type CompletedGlobalHeaderGraph = CompletedGlobalHeaderGraphRep


pure func completed_global_header_graph_headers(
	graph: CompletedGlobalHeaderGraph,
) -> List[CompletedGlobalHeader]:
	from_opaque CompletedGlobalHeaderGraph(graph).headers


pure func completed_global_header_graph_metrics(
	graph: CompletedGlobalHeaderGraph,
) -> GlobalHeaderCompletionMetrics:
	from_opaque CompletedGlobalHeaderGraph(graph).metrics


pure func completed_global_header_graph_find(
	graph: CompletedGlobalHeaderGraph,
	id: GlobalId,
) -> Option[CompletedGlobalHeader]:
	representation = from_opaque CompletedGlobalHeaderGraph(graph)
	names ?= representation.indices_by_module_and_name.get(
		module_identity_storage_key(global_id_module_identity(id)),
	)
	index ?= names.get(global_id_name(id))
	header ?= representation.headers.get(index)

	if global_ids_equal(completed_global_header_id(header), id):
		Some(header)
	else:
		None


record TypedRecordFieldInfo {
	name: String,
	source_type: SemanticType,
	semantic_type: SemanticType,
	definition_id: Option[Int],
	declaration_span: SourceSpan,
	selection_span: SourceSpan
}


record TypedRecordInfo {
	decl: ParsedRecordDecl,
	fields: List[TypedRecordFieldInfo]
}


record TypedTypeAliasInfo {
	decl: ParsedTypeAliasDecl,
	source_target_type: SemanticType,
	semantic_target_type: SemanticType
}


record TypedTraitMethodInfo {
	decl: ParsedTraitMethodDecl,
	param_types: List[SemanticType],
	semantic_return_type: SemanticType
}


record TypedTraitInfo {
	decl: ParsedTraitDecl,
	methods: List[TypedTraitMethodInfo]
}


record TypedUnionVariantInfo {
	name: String,
	fields: List[SemanticType],
	tag: Int,
	def_id: Option[Int],
	declaration_span: SourceSpan,
	selection_span: SourceSpan
}


record TypedUnionInfo {
	decl: ParsedUnionDecl,
	variants: List[TypedUnionVariantInfo]
}


record TypedImplInfo {
	decl: ParsedImplDecl,
	for_type: SemanticType,
	type_params: List[BoundTypeParam],
	methods: List[TypedFunctionInfo]
}


enum TypedForeignLinkPlatform:
	TypedForeignLinux
	TypedForeignMacos


pure func typed_foreign_link_platform_to_string(platform: TypedForeignLinkPlatform) -> String:
	match platform:
		TypedForeignLinux:
			"linux"
		TypedForeignMacos:
			"macos"


record TypedForeignLinkFlag {
	platform: Option[TypedForeignLinkPlatform],
	flag: String
}


enum TypedForeignArgPassing:
	TypedForeignDefaultArgs
	TypedForeignBorrowArgs


pure func typed_foreign_arg_passing_borrows(arg_passing: TypedForeignArgPassing) -> Bool:
	match arg_passing:
		TypedForeignDefaultArgs:
			False
		TypedForeignBorrowArgs:
			True


record TypedForeignFunctionInfo {
	decl: ParsedForeignFunctionDecl,
	callable_id: Option[Int],
	param_types: List[SemanticType],
	semantic_return_type: SemanticType,
	c_name: String,
	includes: List[String],
	link_flags: List[TypedForeignLinkFlag],
	arg_passing: TypedForeignArgPassing,
	block_span: SourceSpan
}


union TypedDecl:
	TypedFunctionDecl(TypedFunctionInfo)
	TypedForeignFunctionDecl(TypedForeignFunctionInfo)
	TypedGlobalVarDecl(TypedGlobalVarInfo)
	TypedRecordDecl(TypedRecordInfo)
	TypedTypeAliasDecl(TypedTypeAliasInfo)
	TypedTraitDecl(TypedTraitInfo)
	TypedUnionDecl(TypedUnionInfo)
	TypedImplDecl(TypedImplInfo)
	TypedPrivateDecl(TypedDecl)
	TypedParsedDecl(ParsedDecl)


pure func typed_decl_function_infos(decl: TypedDecl) -> List[TypedFunctionInfo]:
	match decl:
		TypedFunctionDecl(info):
			[info]
		TypedImplDecl(info):
			info.methods
		TypedPrivateDecl(inner):
			typed_decl_function_infos(inner)
		_:
			[]


pure func typed_decls_function_infos(decls: List[TypedDecl]) -> List[TypedFunctionInfo]:
	decls.flat_map(typed_decl_function_infos)


record TypedProgram {
	source: SourceFile,
	decls: List[TypedDecl],
	diagnostics: List[ParseDiagnostic],
	type_definitions: List[TypedTypeDefinition],
	type_references: List[TypedTypeReference]
}


record TypecheckFunctionBodyResult {
	state: TypecheckState,
	typed: TypedFunctionInfo
}


record TypecheckGlobalVarBodyResult {
	state: TypecheckState,
	typed: TypedGlobalVarInfo
}


private union GlobalTypeExpectation:
	InferredGlobalType
	DeclaredGlobalType(SemanticType)


private union GlobalDefinitionIdentity:
	ClaimAndPublishGlobalDefinition(String)
	ClaimGlobalDefinitionWithoutPublication


record TypecheckImplBodyResult {
	state: TypecheckState,
	typed: TypedImplInfo
}


record TypecheckDeclBodyResult {
	state: TypecheckState,
