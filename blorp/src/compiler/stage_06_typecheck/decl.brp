}


opaque type RecoveredBodyArtifact = RecoveredBodyArtifactRep


union BodyCheckOutcome:
	BodyCheckAccepted(CheckedBodyArtifact)
	BodyCheckRejected(RecoveredBodyArtifact)


private record BodyOutcomeIndexRep {
	owner: ModuleIdentity,
	by_definition_id: Dict[Int, BodyCheckOutcome]
}


opaque type BodyOutcomeIndex = BodyOutcomeIndexRep


private union BodyOutcomeIndexBuild:
	BodyOutcomeIndexAccepted(BodyOutcomeIndex)
	BodyOutcomeIndexRejected(List[String])


