-- Compiler-owned display projections for typed declarations.
--
-- These strings are derived only from resolved semantic types. Frontends such
-- as the CLI and LSP may present them, but neither frontend is allowed to
-- reconstruct a type from source text or run a second inference pass.
import:
	type_system/semantic_type: SemanticType(SemanticFunctionType), type_to_string


pure func typed_callable_display(
	name: String,
	is_pure: Bool,
	param_types: List[SemanticType],
	return_type: SemanticType,
) -> String:
	callable_type: SemanticType = SemanticFunctionType(is_pure, param_types, return_type)
	name + ": " + type_to_string(callable_type)


pure func typed_named_value_display(name: String, typ: SemanticType) -> String:
	name + ": " + type_to_string(typ)


pure func typed_constructor_display(
	parent_name: String,
	name: String,
	fields: List[SemanticType],
) -> String:
	if fields.is_empty():
		parent_name + "." + name
	else:
		parent_name + "." + name + "(" + fields
			.map(type_to_string)
			.join(", ") + ")"


pure func typed_type_display(name: String) -> String:
	"type " + name
