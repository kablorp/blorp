-- Explicit state for the Blorp-owned typecheck first pass.
--
-- Declaration/indexing slices extend this value instead of growing separate
-- side tables.
import:
	../../lib/source: SourceSpan
	../stage_03_parse/parsed_ast: ParsedProgram
	../stage_04_modules/loaded_module:
		ANONYMOUS_IDENTITY,
		ModuleIdentity,
		ModuleOrigin(SourcePackageModule, StdlibModule, UserModule),
		module_identities_equal,
		module_identity_display_name,
		module_identity_for_program,
	../stage_05_types/context:
		CONTEXT_EMPTY,
		Context,
		module_origin_allows_builtin,
		module_origin_allows_foreign,
		module_origin_is_source_package,
		module_origin_is_std,
	../stage_05_types/env: ENV_EMPTY, Env, ImplInstance, env_mint_def_id
	../stage_05_types/semantic_type: SemanticType, types_equal
	diagnostic: TypecheckDiagnostic, typecheck_diagnostic
	graph/definition_identity:
		FuncCallableKey,
		SourceDefinitionKey,
		func_callable_key_description,
		func_callable_key_module_identity,
		source_definition_key_description,
		source_definition_key_module_identity,
	graph/definition_index:
		DefinitionIndex,
		definition_index_advance_to_env,
		definition_index_bootstrap_empty_index,
		definition_index_bootstrap_env,
		definition_index_bootstrap_from_base_env,
		definition_index_conflict_message,
		definition_index_find_func_callable_id,
		definition_index_find_source_definition_id,
		definition_index_func_callable_bindings,
		definition_index_insert_func_callable_id,
		definition_index_insert_source_definition_id,
		definition_index_next_def_id,
		definition_index_source_definition_bindings,
	graph/indexed_graph:
		PreparedModuleScope,
		prepared_module_scope_canonical_path,
		prepared_module_scope_definition_index,
		prepared_module_scope_find_module,
		prepared_module_scope_identity,
		prepared_module_scope_origin,
		prepared_module_scopes_are_compatible,
	modules/module_view:
		COMPILER_MODULE_VIEW_EMPTY,
		ImportedConstructorBinding,
		ImportedNameBinding,
		LocalNameRegistration(
			LocalNameAdded,
			LocalNameAlreadyPresent,
			LocalNameConflictsWithAlias,
			LocalNameConflictsWithImportedName,
		),
		ModuleAliasRegistration(
			ModuleAliasAdded,
			ModuleAliasAlreadyPresent,
			ModuleAliasConflictsWithAlias,
			ModuleAliasConflictsWithImportedName,
			ModuleAliasConflictsWithLocalName,
		),
		ModuleView,
		SelectiveNameRegistration(
			SelectiveNameAdded,
			SelectiveNameConflictsWithAlias,
			SelectiveNameConflictsWithImportedName,
			SelectiveNameConflictsWithLocalName,
		),
		TopLevelNameKind,
		module_view_add_imported_module,
		module_view_find_imported_name,
		module_view_find_local_name,
		module_view_find_module_alias,
		module_view_has_imported_module,
		module_view_has_qualified_binding,
		module_view_has_selective_binding,
		module_view_record_imported_constructor,
		module_view_register_local_name,
		module_view_register_module_alias,
		module_view_register_selective_name,
		module_view_without_unqualified_names,
		top_level_name_kind_is_trait,
		top_level_name_kind_label,


enum ResourceShapeTarget:
	OneShotStreamShape
	ResourceSourceShape


private union TypecheckModuleScopeRep:
	UnscopedModuleScope(ModuleOrigin, DefinitionIndex)
	ExtensibleModuleScope(ModuleOrigin, ModuleIdentity, DefinitionIndex)
	ReservedModuleScope(PreparedModuleScope)


opaque type TypecheckModuleScope = TypecheckModuleScopeRep


-- Transient provenance for a spelling installed into one module's Env. Exact
-- definition ownership remains on TypeId in TypeHeaderGraph;
-- these entries only disambiguate local, canonical, and selective names during
-- the transitional environment-backed body checker.
record TypecheckTypeHome {
	type_name: String,
	module_path: String,
	imported: Bool
}


private enum KnownTypeKind:
	KnownOrdinaryType
	KnownResourceType


opaque type KnownTypeIndex = Dict[String, KnownTypeKind]


-- One recursive scan computes both capability bits, so cache them together
-- rather than retaining duplicate type keys and entries per query target.
record ResourceCapabilityMemoEntry {
	typ: SemanticType,
	contains_one_shot_stream: Bool,
	contains_resource_source: Bool
}


record TypeShapeMemo {
	contains_target: List[ResourceCapabilityMemoEntry],
	function_carrier: List[ResourceCapabilityMemoEntry]
}


record TypecheckState {
	context: Context,
	env: Env,
	errors: List[String],
	diagnostics: List[TypecheckDiagnostic],
	module_view: ModuleView,
	module_scope: TypecheckModuleScope,
	allow_debug_only_calls: Bool,
	private_impls: List[ImplInstance],
	known_type_index: KnownTypeIndex,
	scoped_trait_functions: List[(String, String)],
	type_homes: List[TypecheckTypeHome],
	type_shape_memo: TypeShapeMemo
}


union DefinitionIdClaim:
	DefinitionIdClaimed(TypecheckState, Int)
	DefinitionIdMissing(TypecheckState)


record ImportedNameRegistration {
	state: TypecheckState,
	registered: Bool
}


TYPE_SHAPE_MEMO_EMPTY: TypeShapeMemo = {
	contains_target = [],
	function_carrier = []
}

TYPECHECK_USER_ORIGIN: ModuleOrigin = UserModule

TYPECHECK_STDLIB_ORIGIN: ModuleOrigin = StdlibModule

private KNOWN_TYPE_INDEX_EMPTY: KnownTypeIndex = into_opaque KnownTypeIndex({})


private pure func known_type_index_add_type(index: KnownTypeIndex, name: String) -> KnownTypeIndex:
	entries = from_opaque KnownTypeIndex(index)

	match entries.get(name):
		Some(_):
			index
		None:
			updated = entries.set(name, KnownOrdinaryType)
			into_opaque KnownTypeIndex(updated)


private pure func known_type_index_add_resource(
	index: KnownTypeIndex,
	name: String,
) -> KnownTypeIndex:
	entries = from_opaque KnownTypeIndex(index)
	updated = entries.set(name, KnownResourceType)
	into_opaque KnownTypeIndex(updated)


pure func known_type_index_has_resource(index: KnownTypeIndex, name: String) -> Bool:
	entries = from_opaque KnownTypeIndex(index)
	entries.get(name) == Some(KnownResourceType)


pure func typecheck_state_reset_type_shape_memo(state: TypecheckState) -> TypecheckState:
	{ state | type_shape_memo = TYPE_SHAPE_MEMO_EMPTY }


pure func typecheck_state_for_origin(origin: ModuleOrigin) -> TypecheckState:
	bootstrap = definition_index_bootstrap_from_base_env(ENV_EMPTY)
	env = definition_index_bootstrap_env(bootstrap)
	definition_index = definition_index_bootstrap_empty_index(bootstrap)
	{
		context = CONTEXT_EMPTY,
		env = env,
		errors = [],
		diagnostics = [],
		module_view = COMPILER_MODULE_VIEW_EMPTY,
		module_scope = typecheck_module_scope(UnscopedModuleScope(origin, definition_index)),
		allow_debug_only_calls = False,
		private_impls = [],
		known_type_index = KNOWN_TYPE_INDEX_EMPTY,
		scoped_trait_functions = [],
		type_homes = [],
		type_shape_memo = TYPE_SHAPE_MEMO_EMPTY
	}


private pure func typecheck_module_scope_index(scope: TypecheckModuleScope) -> DefinitionIndex:
	representation = typecheck_module_scope_rep(scope)

	match representation:
		UnscopedModuleScope(_, index):
			index
		ExtensibleModuleScope(_, _, index):
			index
		ReservedModuleScope(prepared_scope):
			prepared_module_scope_definition_index(prepared_scope)


private pure func typecheck_module_scope(
	representation: TypecheckModuleScopeRep,
) -> TypecheckModuleScope:
	into_opaque TypecheckModuleScope(representation)


private pure func typecheck_module_scope_rep(
	scope: TypecheckModuleScope,
) -> TypecheckModuleScopeRep:
	from_opaque TypecheckModuleScope(scope)


private pure func typecheck_state_with_definition_index(
	state: TypecheckState,
	definition_index: DefinitionIndex,
) -> TypecheckState:
	representation = typecheck_module_scope_rep(state.module_scope)

	module_scope = match representation:
		UnscopedModuleScope(origin, _):
			typecheck_module_scope(UnscopedModuleScope(origin, definition_index))
		ExtensibleModuleScope(origin, identity, _):
			typecheck_module_scope(ExtensibleModuleScope(origin, identity, definition_index))
		ReservedModuleScope(_):
			state.module_scope

	{ state | module_scope = module_scope }


pure func typecheck_state_scope_to_program(
	state: TypecheckState,
	program: ParsedProgram,
) -> TypecheckState:
	representation = typecheck_module_scope_rep(state.module_scope)

	match representation:
		ReservedModuleScope(_):
			state
		UnscopedModuleScope(origin, index):
			identity = module_identity_for_program(program)
			{ state |
				module_scope = typecheck_module_scope(
					ExtensibleModuleScope(
						origin,
						identity,
						index,
					),
				)
			}
		ExtensibleModuleScope(origin, _, index):
			identity = module_identity_for_program(program)
			{ state |
				module_scope = typecheck_module_scope(
					ExtensibleModuleScope(
						origin,
						identity,
						index,
					),
				)
			}


private pure func typecheck_state_scope_to_module(
	state: TypecheckState,
	module_identity: ModuleIdentity,
) -> TypecheckState:
	representation = typecheck_module_scope_rep(state.module_scope)

	match representation:
		UnscopedModuleScope(origin, index):
			{ state |
				module_scope = typecheck_module_scope(
					ExtensibleModuleScope(
						origin,
						module_identity,
						index,
					),
				)
			}
		ExtensibleModuleScope(origin, _, index):
			{ state |
				module_scope = typecheck_module_scope(
					ExtensibleModuleScope(
						origin,
						module_identity,
						index,
					),
				)
			}
		ReservedModuleScope(_):
			typecheck_state_add_error(
				state,
				(
					"internal typecheck error: canonical module scope requires a prepared module, "
					+ "not identity '"
				) + module_identity_display_name(module_identity) + "'",
			)


pure func typecheck_state_module_identity(state: TypecheckState) -> ModuleIdentity:
	representation = typecheck_module_scope_rep(state.module_scope)

	match representation:
		UnscopedModuleScope(_, _):
			ANONYMOUS_IDENTITY
		ExtensibleModuleScope(_, identity, _):
			identity
		ReservedModuleScope(prepared_scope):
			prepared_module_scope_identity(prepared_scope)


pure func typecheck_state_with_debug_calls(
	state: TypecheckState,
	allow_debug_only_calls: Bool,
) -> TypecheckState:
	{ state | allow_debug_only_calls = allow_debug_only_calls }


pure func typecheck_state_with_scoped_trait_functions(
	state: TypecheckState,
	functions: List[(String, String)],
) -> TypecheckState:
	{ state | scoped_trait_functions = functions }


pure func typecheck_state_allows_scoped_trait_function(
	state: TypecheckState,
	function_name: String,
	trait_name: String,
) -> Bool:
	var found: Bool = False

	for pair in state.scoped_trait_functions:
		if pair[0] == function_name and pair[1] == trait_name:
			found = True
			break

	found


pure func typecheck_state_find_scoped_trait_function(
	state: TypecheckState,
	function_name: String,
) -> Option[String]:
	var trait_name: Option[String] = None

	for pair in state.scoped_trait_functions:
		if pair[0] == function_name:
			trait_name = Some(pair[1])
			break

	trait_name


pure func typecheck_state_add_scoped_trait_function(
	state: TypecheckState,
	function_name: String,
	trait_name: String,
) -> TypecheckState:
	if typecheck_state_allows_scoped_trait_function(state, function_name, trait_name):
		state
	else:
		{ state |
			scoped_trait_functions = state.scoped_trait_functions.append(
				(function_name, trait_name),
			)
		}


pure func typecheck_state_add_error(state: TypecheckState, message: String) -> TypecheckState:
	typecheck_state_add_diagnostic(
		state,
		typecheck_diagnostic(message, None),
	)


pure func typecheck_state_add_diagnostic(
	state: TypecheckState,
	diagnostic: TypecheckDiagnostic,
) -> TypecheckState:
	{ state |
		errors = state.errors.append(diagnostic.message),
		diagnostics = state.diagnostics.append(diagnostic)
	}


pure func typecheck_state_add_error_at(
	state: TypecheckState,
	span: SourceSpan,
	message: String,
) -> TypecheckState:
	typecheck_state_add_diagnostic(
		state,
		typecheck_diagnostic(message, Some(span)),
	)


pure func typecheck_state_locate_diagnostics_since(
	state: TypecheckState,
	first_diagnostic: Int,
	span: SourceSpan,
) -> TypecheckState:
	var index: Int = 0
	var diagnostics: List[TypecheckDiagnostic] = []

	for diagnostic in state.diagnostics:
		located = if index >= first_diagnostic and diagnostic.span == None:
			{ diagnostic | span = Some(span) }
		else:
			diagnostic

		diagnostics = diagnostics.append(located)
		index += 1

	{ state | diagnostics = diagnostics }


private pure func typecheck_module_scope_origin(scope: TypecheckModuleScope) -> ModuleOrigin:
	representation = typecheck_module_scope_rep(scope)

	match representation:
		UnscopedModuleScope(origin, _):
			origin
		ExtensibleModuleScope(origin, _, _):
			origin
		ReservedModuleScope(prepared_scope):
			prepared_module_scope_origin(prepared_scope)


pure func typecheck_state_module_origin(state: TypecheckState) -> ModuleOrigin:
	typecheck_module_scope_origin(state.module_scope)


pure func typecheck_state_allows_builtin(state: TypecheckState) -> Bool:
	module_origin_allows_builtin(typecheck_state_module_origin(state))


pure func typecheck_state_allows_foreign(state: TypecheckState) -> Bool:
	module_origin_allows_foreign(typecheck_state_module_origin(state))


pure func typecheck_state_is_stdlib(state: TypecheckState) -> Bool:
	module_origin_is_std(typecheck_state_module_origin(state))


pure func typecheck_state_is_source_package(state: TypecheckState) -> Bool:
	module_origin_is_source_package(typecheck_state_module_origin(state))


pure func typecheck_state_add_imported_module(
	state: TypecheckState,
	module_path: String,
) -> TypecheckState:
	{ state | module_view = module_view_add_imported_module(state.module_view, module_path) }


pure func typecheck_state_has_imported_module(state: TypecheckState, module_path: String) -> Bool:
	module_view_has_imported_module(state.module_view, module_path)


pure func typecheck_state_find_module_alias(
	state: TypecheckState,
	alias_name: String,
) -> Option[String]:
	module_view_find_module_alias(state.module_view, alias_name)


pure func typecheck_state_find_imported_name(
	state: TypecheckState,
	local_name: String,
) -> Option[ImportedNameBinding]:
	module_view_find_imported_name(state.module_view, local_name)


pure func typecheck_state_find_top_level_name(
	state: TypecheckState,
	name: String,
) -> Option[TopLevelNameKind]:
	module_view_find_local_name(state.module_view, name)


pure func typecheck_state_has_qualified_module_binding(
	state: TypecheckState,
	local_name: String,
	module_path: String,
) -> Bool:
	module_view_has_qualified_binding(state.module_view, local_name, module_path)


pure func typecheck_state_has_selective_definition_binding(
	state: TypecheckState,
	local_name: String,
	module_path: String,
	source_name: String,
) -> Bool:
	module_view_has_selective_binding(state.module_view, local_name, module_path, source_name)


pure func typecheck_state_remember_top_level_name(
	state: TypecheckState,
	name: String,
	kind: TopLevelNameKind,
) -> TypecheckState:
	match module_view_register_local_name(state.module_view, name, kind):
		LocalNameAdded(view):
			{ state | module_view = view }
		LocalNameAlreadyPresent(_):
			state
		LocalNameConflictsWithAlias(module_path):
			typecheck_state_add_error(
				state,
				top_level_name_kind_label(
					kind,
				) + " '" + name + "' declared in this module conflicts with module alias for '" + module_path + "'",
			)
		LocalNameConflictsWithImportedName(binding):
			typecheck_state_add_error(
				state,
				top_level_name_kind_label(
					kind,
				) + " '" + name + "' declared in this module conflicts with imported name from '" + binding.module_path + "'",
			)


pure func typecheck_state_clear_module_name_indexes(state: TypecheckState) -> TypecheckState:
	{ state | module_view = module_view_without_unqualified_names(state.module_view) }


pure func typecheck_state_register_module_alias(
	state: TypecheckState,
	alias_name: String,
	canonical_name: String,
) -> TypecheckState:
	match module_view_register_module_alias(state.module_view, alias_name, canonical_name):
		ModuleAliasAlreadyPresent:
			state
		ModuleAliasConflictsWithAlias(existing_module):
			typecheck_state_add_error(
				state,
				"module alias '" + alias_name + "' already used for module '" + existing_module + "'",
			)
		ModuleAliasConflictsWithImportedName(binding):
			typecheck_state_add_error(
				state,
				"module alias '" + alias_name + "' conflicts with imported name from '" + binding.module_path + "'",
			)
		ModuleAliasConflictsWithLocalName(kind):
			typecheck_state_add_error(
				state,
				"module alias '" + alias_name + "' conflicts with " + top_level_name_kind_label(
					kind,
				) + " '" + alias_name + "' declared in this module",
			)
		ModuleAliasAdded(view):
			{ state | module_view = view }


pure func typecheck_state_register_imported_name(
	state: TypecheckState,
	local_name: String,
	module_path: String,
	original_name: String,
) -> ImportedNameRegistration:
	match module_view_register_selective_name(
		state.module_view,
		local_name,
		module_path,
		original_name,
	):
		SelectiveNameAdded(view):
			{
				state = { state | module_view = view },
				registered = True
			}
		SelectiveNameConflictsWithAlias(existing_module):
			{
				state = typecheck_state_add_error(
					state,
					"imported name '" + local_name + "' is already used as module alias for '" + existing_module + "'",
				),
				registered = False
			}
		SelectiveNameConflictsWithImportedName(binding):
			message = if (
				binding.original_name == local_name
				and original_name == local_name
				and binding.module_path != module_path
			):
				"Ambiguous import: '" + local_name + "' is already imported from '" + binding.module_path + "'"
			else:
				"imported name '" + local_name + "' is already imported from '" + binding.module_path + "'; use a distinct alias"

			{
				state = typecheck_state_add_error(state, message),
				registered = False
			}
		SelectiveNameConflictsWithLocalName(kind):
			{
				state = typecheck_state_add_error(
					state,
					"imported name '" + local_name + "' conflicts with " + top_level_name_kind_label(
						kind,
					) + " '" + local_name + "' declared in this module",
				),
				registered = False
			}


pure func typecheck_state_register_imported_constructor(
	state: TypecheckState,
	local_name: String,
	module_path: String,
	parent_local_name: String,
	parent_name: String,
	original_name: String,
) -> ImportedNameRegistration:
	registration = typecheck_state_register_imported_name(
		state,
		local_name,
		module_path,
		original_name,
	)

	if registration.registered:
		binding: ImportedConstructorBinding = {
			local_name = local_name,
			module_path = module_path,
			parent_local_name = parent_local_name,
			parent_name = parent_name,
			original_name = original_name
		}
		{
			state = { registration.state |
				module_view = module_view_record_imported_constructor(
					registration.state.module_view,
					binding,
				)
			},
			registered = True
		}
	else:
		registration


pure func typecheck_state_add_known_type_name(
	state: TypecheckState,
	name: String,
) -> TypecheckState:
	{ state | known_type_index = known_type_index_add_type(state.known_type_index, name) }


pure func typecheck_state_add_known_resource_type_name(
	state: TypecheckState,
	name: String,
) -> TypecheckState:
	{ state | known_type_index = known_type_index_add_resource(state.known_type_index, name) }


pure func typecheck_state_has_known_type_name(state: TypecheckState, name: String) -> Bool:
	entries = from_opaque KnownTypeIndex(state.known_type_index)
	entries.contains(name)


pure func typecheck_state_has_known_resource_type_name(state: TypecheckState, name: String) -> Bool:
	known_type_index_has_resource(state.known_type_index, name)


pure func typecheck_state_clear_known_type_index(state: TypecheckState) -> TypecheckState:
	{ state | known_type_index = KNOWN_TYPE_INDEX_EMPTY }


private pure func replace_type_home(
	homes: List[TypecheckTypeHome],
	replacement: TypecheckTypeHome,
) -> List[TypecheckTypeHome]:
	var result: List[TypecheckTypeHome] = []
	var replaced: Bool = False

	for home in homes:
		if home.type_name == replacement.type_name:
			result = result.append(replacement)
			replaced = True
		else:
			result = result.append(home)

	if replaced:
		result
	else:
		result.append(replacement)


private pure func find_type_home_entry(
	type_homes: List[TypecheckTypeHome],
	type_name: String,
) -> Option[TypecheckTypeHome]:
	var result: Option[TypecheckTypeHome] = None

	for home in type_homes:
		if home.type_name == type_name:
			result = Some(home)
			break

	result


pure func typecheck_state_find_type_home(
	state: TypecheckState,
	type_name: String,
) -> Option[String]:
	find_type_home_entry(state.type_homes, type_name).map(func(home): home.module_path)


pure func typecheck_state_type_home_is_imported(state: TypecheckState, type_name: String) -> Bool:
	match find_type_home_entry(state.type_homes, type_name):
		Some(home):
			home.imported
		None:
			False


pure func typecheck_state_type_home_matches(
	state: TypecheckState,
	type_name: String,
	module_path: String,
) -> Bool:
	typecheck_state_find_type_home(state, type_name) == Some(module_path)


pure func typecheck_state_record_type_home(
	state: TypecheckState,
	type_name: String,
	module_path: String,
	imported: Bool,
) -> TypecheckState:
	match typecheck_state_find_type_home(state, type_name):
		Some(_):
			if imported:
				state
			else:
				{ state | type_homes = replace_type_home(
						state.type_homes,
						{
							type_name = type_name,
							module_path = module_path,
							imported = False
						},
					) }
		None:
			{ state | type_homes = state.type_homes.append({
					type_name = type_name,
					module_path = module_path,
					imported = imported,
				}) }


private pure func typecheck_state_record_func_callable_id(
	state: TypecheckState,
	key: FuncCallableKey,
	def_id: Int,
) -> DefinitionIdClaim:
	current_index = typecheck_module_scope_index(state.module_scope)

	match definition_index_insert_func_callable_id(current_index, key, def_id):
		Ok(definition_index):
			aligned_index = definition_index_advance_to_env(definition_index, state.env)
			updated = typecheck_state_with_definition_index(
				{ state |
					env = { state.env | next_def_id = definition_index_next_def_id(aligned_index) }
				},
				aligned_index,
			)
			DefinitionIdClaimed(updated, def_id)
		Err(conflict):
			with_error = typecheck_state_add_error(
				typecheck_state_with_definition_index(
					state,
					definition_index_advance_to_env(current_index, state.env),
				),
				"internal typecheck error: " + definition_index_conflict_message(conflict),
			)
			DefinitionIdMissing(with_error)


pure func typecheck_state_find_func_callable_id(
	state: TypecheckState,
	key: FuncCallableKey,
) -> Option[Int]:
	definition_index_find_func_callable_id(typecheck_module_scope_index(state.module_scope), key)


pure func typecheck_state_func_callable_bindings(
	state: TypecheckState,
	name: String,
) -> List[(FuncCallableKey, Int)]:
	definition_index_func_callable_bindings(typecheck_module_scope_index(state.module_scope), name)


private pure func typecheck_state_record_source_definition_id(
	state: TypecheckState,
	key: SourceDefinitionKey,
	def_id: Int,
) -> DefinitionIdClaim:
	current_index = typecheck_module_scope_index(state.module_scope)

	match definition_index_insert_source_definition_id(current_index, key, def_id):
		Ok(definition_index):
			aligned_index = definition_index_advance_to_env(definition_index, state.env)
			updated = typecheck_state_with_definition_index(
				{ state |
					env = { state.env | next_def_id = definition_index_next_def_id(aligned_index) }
				},
				aligned_index,
			)
			DefinitionIdClaimed(updated, def_id)
		Err(conflict):
			with_error = typecheck_state_add_error(
				typecheck_state_with_definition_index(
					state,
					definition_index_advance_to_env(current_index, state.env),
				),
				"internal typecheck error: " + definition_index_conflict_message(conflict),
			)
			DefinitionIdMissing(with_error)


pure func typecheck_state_find_source_definition_id(
	state: TypecheckState,
	key: SourceDefinitionKey,
) -> Option[Int]:
	definition_index_find_source_definition_id(
		typecheck_module_scope_index(state.module_scope),
		key,
	)


pure func typecheck_state_definition_index(state: TypecheckState) -> DefinitionIndex:
	definition_index_advance_to_env(typecheck_module_scope_index(state.module_scope), state.env)


pure func typecheck_state_source_definition_bindings_for_name(
	state: TypecheckState,
	name: String,
) -> List[(SourceDefinitionKey, Int)]:
	definition_index_source_definition_bindings(
		typecheck_module_scope_index(state.module_scope),
		name,
	)


pure func typecheck_state_enter_prepared_module_scope(
	state: TypecheckState,
	prepared_scope: PreparedModuleScope,
) -> TypecheckState:
	representation = typecheck_module_scope_rep(state.module_scope)

	match representation:
		UnscopedModuleScope(_, _):
			definition_index = prepared_module_scope_definition_index(prepared_scope)
			aligned_index = definition_index_advance_to_env(definition_index, state.env)
			{ state |
				env = { state.env | next_def_id = definition_index_next_def_id(aligned_index) },
				module_scope = typecheck_module_scope(ReservedModuleScope(prepared_scope))
			}
		ExtensibleModuleScope(_, _, _):
			typecheck_state_add_error(
				state,
				(
					"internal typecheck error: cannot enter an indexed graph from an extensible "
					+ "module scope"
				),
			)
		ReservedModuleScope(_):
			typecheck_state_add_error(
				state,
				"internal typecheck error: cannot replace an indexed graph scope",
			)


-- Construct the canonical fresh state for binding one indexed module. Keeping
-- origin, debug policy, and reserved-scope installation together prevents
-- bridge and benchmark callers from drifting apart.
pure func typecheck_state_for_prepared_module_scope(
	prepared_scope: PreparedModuleScope,
	allow_debug_only_calls: Bool,
) -> TypecheckState:
	typecheck_state_enter_prepared_module_scope(
		typecheck_state_with_debug_calls(
			typecheck_state_for_origin(prepared_module_scope_origin(prepared_scope)),
			allow_debug_only_calls,
		),
		prepared_scope,
	)


pure func typecheck_state_scope_to_graph_module(
	state: TypecheckState,
	canonical_path: String,
) -> TypecheckState:
	representation = typecheck_module_scope_rep(state.module_scope)

	match representation:
		ReservedModuleScope(current_scope):
			match prepared_module_scope_find_module(current_scope, canonical_path):
				Some(prepared_scope):
					{ state |
						module_scope = typecheck_module_scope(ReservedModuleScope(prepared_scope))
					}
				None:
					typecheck_state_add_error(
						state,
						"internal typecheck error: module '" + canonical_path + "' is not in the indexed graph",
					)
		_:
			typecheck_state_add_error(
				state,
				"internal typecheck error: cannot select indexed graph module '" + canonical_path + "' before entering a graph scope",
			)


pure func typecheck_state_scope_to_imported_module(
	state: TypecheckState,
	imported_scope: PreparedModuleScope,
) -> TypecheckState:
	representation = typecheck_module_scope_rep(state.module_scope)

	match representation:
		UnscopedModuleScope(_, _):
			typecheck_state_add_error(
				state,
				(
					"internal typecheck error: cannot select an imported module before selecting the "
					+ "current module"
				),
			)
		ExtensibleModuleScope(_, _, index):
			{ state |
				module_scope = typecheck_module_scope(
					ExtensibleModuleScope(
						prepared_module_scope_origin(imported_scope),
						prepared_module_scope_identity(imported_scope),
						index,
					),
				)
			}
		ReservedModuleScope(current_scope):
			if prepared_module_scopes_are_compatible(current_scope, imported_scope):
				typecheck_state_scope_to_graph_module(
					state,
					prepared_module_scope_canonical_path(imported_scope),
				)
			else:
				typecheck_state_add_error(
					state,
					(
						"internal typecheck error: imported module scope is incompatible with the "
						+ "current indexed graph"
					),
				)


pure func typecheck_state_accepts_imported_module_scope(
	state: TypecheckState,
	imported_scope: PreparedModuleScope,
) -> Bool:
	representation = typecheck_module_scope_rep(state.module_scope)

	match representation:
		UnscopedModuleScope(_, _):
			False
		ExtensibleModuleScope(_, _, _):
			True
		ReservedModuleScope(current_scope):
			prepared_module_scopes_are_compatible(current_scope, imported_scope)


-- Accepted graph-backed typechecking requires both the same indexed graph and
-- the exact selected module. The broader imported-scope predicate above is
-- intentionally insufficient because extensible tooling states are not
-- graph-owned semantic inputs.
pure func typecheck_state_is_reserved_for_scope(
	state: TypecheckState,
	expected_scope: PreparedModuleScope,
) -> Bool:
	representation = typecheck_module_scope_rep(state.module_scope)

	match representation:
		ReservedModuleScope(current_scope):
			(
				prepared_module_scopes_are_compatible(current_scope, expected_scope)
				and module_identities_equal(
					prepared_module_scope_identity(current_scope),
					prepared_module_scope_identity(expected_scope),
				)
			)
		UnscopedModuleScope(_, _):
			False
		ExtensibleModuleScope(_, _, _):
			False


pure func typecheck_state_restore_definition_scope(
	state: TypecheckState,
	target_scope: TypecheckState,
) -> TypecheckState:
	target_representation = typecheck_module_scope_rep(target_scope.module_scope)

	match target_representation:
		UnscopedModuleScope(_, _):
			typecheck_state_add_error(
				state,
				"internal typecheck error: cannot restore an unscoped definition context",
			)
		ExtensibleModuleScope(origin, identity, _):
			restored = typecheck_state_scope_to_module(state, identity)
			representation = typecheck_module_scope_rep(restored.module_scope)

			match representation:
				ExtensibleModuleScope(_, restored_identity, index):
					{ restored |
						module_scope = typecheck_module_scope(
							ExtensibleModuleScope(
								origin,
								restored_identity,
								index,
							),
						)
					}
				_:
					restored
		ReservedModuleScope(prepared_scope):
			typecheck_state_scope_to_graph_module(
				state,
				prepared_module_scope_canonical_path(prepared_scope),
			)


private pure func typecheck_state_mint_definition_id(
	state: TypecheckState,
) -> (TypecheckState, Int):
	match env_mint_def_id(state.env):
		(next_env, def_id):
			({ state | env = next_env }, def_id)


pure func typecheck_state_claim_func_callable_id(
	state: TypecheckState,
	key: FuncCallableKey,
) -> DefinitionIdClaim:
	if not module_identities_equal(
		typecheck_state_module_identity(state),
		func_callable_key_module_identity(key),
	):
		DefinitionIdMissing(
			typecheck_state_add_error(
				state,
				(
					"internal typecheck error: cannot claim a callable definition ID owned by a "
					+ "different module"
				),
			),
		)
	else:
		match typecheck_state_find_func_callable_id(state, key):
			Some(def_id):
				DefinitionIdClaimed(state, def_id)
			None:
				representation = typecheck_module_scope_rep(state.module_scope)

				match representation:
					ReservedModuleScope(_):
						with_error = typecheck_state_add_error(
							state,
							"internal typecheck error: missing reserved definition ID for " + func_callable_key_description(
								key,
							),
						)
						DefinitionIdMissing(with_error)
					UnscopedModuleScope(_, _):
						with_error = typecheck_state_add_error(
							state,
							"internal typecheck error: cannot claim " + func_callable_key_description(
								key,
							) + " before selecting a module",
						)
						DefinitionIdMissing(with_error)
					ExtensibleModuleScope(_, _, _):
						match typecheck_state_mint_definition_id(state):
							(with_id, def_id):
								typecheck_state_record_func_callable_id(with_id, key, def_id)


pure func typecheck_state_claim_source_definition_id(
	state: TypecheckState,
	key: SourceDefinitionKey,
) -> DefinitionIdClaim:
	if not module_identities_equal(
		typecheck_state_module_identity(state),
		source_definition_key_module_identity(key),
	):
		DefinitionIdMissing(
			typecheck_state_add_error(
				state,
				(
					"internal typecheck error: cannot claim a source definition ID owned by a "
					+ "different module"
				),
			),
		)
	else:
		match typecheck_state_find_source_definition_id(state, key):
			Some(def_id):
				DefinitionIdClaimed(state, def_id)
			None:
				representation = typecheck_module_scope_rep(state.module_scope)

				match representation:
					ReservedModuleScope(_):
						with_error = typecheck_state_add_error(
							state,
							"internal typecheck error: missing reserved definition ID for " + source_definition_key_description(
								key,
							),
						)
						DefinitionIdMissing(with_error)
					UnscopedModuleScope(_, _):
						with_error = typecheck_state_add_error(
							state,
							"internal typecheck error: cannot claim " + source_definition_key_description(
								key,
							) + " before selecting a module",
						)
						DefinitionIdMissing(with_error)
					ExtensibleModuleScope(_, _, _):
						match typecheck_state_mint_definition_id(state):
							(with_id, def_id):
								typecheck_state_record_source_definition_id(with_id, key, def_id)


pure func typecheck_state_add_private_impl(
	state: TypecheckState,
	instance: ImplInstance,
) -> TypecheckState:
	{ state | private_impls = state.private_impls.append(instance) }


pure func typecheck_state_find_private_impl_conflict(
	state: TypecheckState,
	candidate: ImplInstance,
) -> Option[ImplInstance]:
	var result: Option[ImplInstance] = None

	for existing in state.private_impls:
		if (
			not existing.is_builtin
			and not candidate.is_builtin
			and existing.trait_name == candidate.trait_name
			and types_equal(existing.for_type, candidate.for_type)
		):
			result = Some(existing)
			break

	result


-- Module facts are immutable within one body check. Keeping them inside the
-- session gives InferContext one coherent state value while record updates to
-- body-local fields preserve the facts by construction.
record InferModuleFacts {
	module_view: ModuleView,
	module_scope: TypecheckModuleScope,
	allow_debug_only_calls: Bool,
	private_impls: List[ImplInstance],
	known_type_index: KnownTypeIndex,
	scoped_trait_functions: List[(String, String)],
	type_homes: List[TypecheckTypeHome]
}


record InferSession {
	context: Context,
	env: Env,
	errors: List[String],
	diagnostics: List[TypecheckDiagnostic],
	type_shape_memo: TypeShapeMemo,
	facts: InferModuleFacts
}


pure func infer_session_from_typecheck_state(state: TypecheckState) -> InferSession:
	{
		context = state.context,
		env = state.env,
		errors = state.errors,
		diagnostics = state.diagnostics,
		type_shape_memo = state.type_shape_memo,
		facts = infer_module_facts_from_typecheck_state(state)
	}


pure func infer_module_facts_from_typecheck_state(state: TypecheckState) -> InferModuleFacts:
	{
		module_view = state.module_view,
		module_scope = state.module_scope,
		allow_debug_only_calls = state.allow_debug_only_calls,
		private_impls = state.private_impls,
		known_type_index = state.known_type_index,
		scoped_trait_functions = state.scoped_trait_functions,
		type_homes = state.type_homes
	}


pure func typecheck_state_from_infer_session(session: InferSession) -> TypecheckState:
	{
		context = session.context,
		env = session.env,
		errors = session.errors,
		diagnostics = session.diagnostics,
		module_view = session.facts.module_view,
		module_scope = session.facts.module_scope,
		allow_debug_only_calls = session.facts.allow_debug_only_calls,
		private_impls = session.facts.private_impls,
		known_type_index = session.facts.known_type_index,
		scoped_trait_functions = session.facts.scoped_trait_functions,
		type_homes = session.facts.type_homes,
		type_shape_memo = session.type_shape_memo
	}


pure func typecheck_module_scope_is_source_package(scope: TypecheckModuleScope) -> Bool:
	module_origin_is_source_package(typecheck_module_scope_origin(scope))
