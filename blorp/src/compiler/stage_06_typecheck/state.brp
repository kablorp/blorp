enum ResourceShapeTarget:
	OneShotStreamShape
	ResourceSourceShape


private union TypecheckModuleScopeRep:
	UnscopedModuleScope(ModuleOrigin, DefinitionIndexSeed)
	ExtensibleModuleScope(ModuleOrigin, ModuleIdentity, ModuleId, DefinitionIndex)
	ReservedModuleScope(PreparedModuleScope)


opaque type TypecheckModuleScope = TypecheckModuleScopeRep


---
Transient provenance for a visible spelling installed into one module's Env.
Exact definition ownership remains on TypeId in TypeHeaderGraph; this index
only disambiguates local, canonical, and selective names during the
transitional environment-backed body checker.
---
private record TypeHomeEntry {
	module_path: String,
	imported: Bool
}


opaque type TypeHomeIndex = Dict[String, TypeHomeEntry]


private enum KnownTypeKind:
	KnownOrdinaryType
	KnownResourceType


opaque type KnownTypeIndex = Dict[String, KnownTypeKind]


---
One recursive scan computes both capability bits, so cache them together
rather than retaining duplicate type keys and entries per query target.
---
record ResourceCapabilityMemoEntry {
	typ: SemanticType,
	contains_one_shot_stream: Bool,
	contains_resource_source: Bool
}


record TypeShapeMemo {
	contains_target: List[ResourceCapabilityMemoEntry],
	function_carrier: List[ResourceCapabilityMemoEntry]
}


record TypecheckState {
	context: Context,
	env: Env,
	errors: List[String],
	diagnostics: List[TypecheckDiagnostic],
	module_view: ModuleView,
	graph_import_admission: Option[GraphImportAdmission],
	module_scope: TypecheckModuleScope,
	allow_debug_only_calls: Bool,
	private_impls: List[ImplInstance],
	known_type_index: KnownTypeIndex,
	scoped_trait_functions: List[(String, String)],
	type_homes: TypeHomeIndex,
	type_shape_memo: TypeShapeMemo,
	source_table: Option[SourceTable]
}


union DefinitionIdClaim:
	DefinitionIdClaimed(TypecheckState, Int)
	DefinitionIdMissing(TypecheckState)


record ImportedNameRegistration {
	state: TypecheckState,
	registered: Bool
}


TYPE_SHAPE_MEMO_EMPTY: TypeShapeMemo = {
	contains_target = [],
	function_carrier = []
}

TYPECHECK_USER_ORIGIN: ModuleOrigin = UserModule

TYPECHECK_STDLIB_ORIGIN: ModuleOrigin = StdlibModule

private KNOWN_TYPE_INDEX_EMPTY: KnownTypeIndex = into_opaque KnownTypeIndex({})

private TYPE_HOME_INDEX_EMPTY: TypeHomeIndex = into_opaque TypeHomeIndex({})


pure func type_home_index_empty() -> TypeHomeIndex:
	TYPE_HOME_INDEX_EMPTY


pure func known_type_index_empty() -> KnownTypeIndex:
	KNOWN_TYPE_INDEX_EMPTY


private pure func type_home_index_entry(
	index: TypeHomeIndex,
	type_name: String,
) -> Option[TypeHomeEntry]:
	entries = from_opaque TypeHomeIndex(index)
	entries.get(type_name)


pure func type_home_index_module_path(index: TypeHomeIndex, type_name: String) -> Option[String]:
	type_home_index_entry(index, type_name).map(func(entry): entry.module_path)


pure func type_home_index_is_imported(index: TypeHomeIndex, type_name: String) -> Bool:
	match type_home_index_entry(index, type_name):
		Some(entry):
			entry.imported
		None:
			False


pure func type_home_index_imported_module_path(
	index: TypeHomeIndex,
	type_name: String,
) -> Option[String]:
	match type_home_index_entry(index, type_name):
		Some(entry):
			if entry.imported:
				Some(entry.module_path)
			else:
				None
		None:
			None


pure func type_home_index_is_empty(index: TypeHomeIndex) -> Bool:
	entries = from_opaque TypeHomeIndex(index)
	entries.is_empty()


---
Records `type_name`'s home, keeping the first-recorded entry when an
import tries to overwrite one that already exists (an import never
overrides an existing entry; a local declaration always wins). This is
the single place that unwraps and rewraps the dict, and it always calls
`entries.set` -- even to re-affirm an unchanged entry -- so no arm
returns `index` unchanged. A bare `index` return here (as the previous
shape had, matching only `Some(_) and imported`) makes
`consume_specialize.brp`'s `function_is_cloneable` refuse a consuming
clone of this function: measured with `--dump-core-after=reuse`, that
shape left every call site's `consumed_args` covering only the `String`
arguments, never `index` (argument 0), so `entries.set` always ran on a
retained (non-unique) dict and copied it. Always constructing, with only
the value passed to `set` varying, keeps this function reachable through
the header-install loops' consuming calling convention so `entries.set`
can mutate in place when the dict is uniquely owned.
---
pure func type_home_index_record(
	index: TypeHomeIndex,
	type_name: String,
	module_path: String,
	imported: Bool,
) -> TypeHomeIndex:
	entries = from_opaque TypeHomeIndex(index)

	next_entry = match entries.get(type_name):
		Some(existing):
			if imported:
				existing
			else:
				{
					module_path = module_path,
					imported = False
				}
		None:
			{
				module_path = module_path,
				imported = imported
			}

	into_opaque TypeHomeIndex(entries.set(type_name, next_entry))


---
Same shape as `type_home_index_record` above: always calls `entries.set`,
keeping whichever `KnownTypeKind` was already recorded rather than
returning `index` unchanged, so this stays consume-specializable.
---
pure func known_type_index_record_type(index: KnownTypeIndex, name: String) -> KnownTypeIndex:
	entries = from_opaque KnownTypeIndex(index)

	next_kind = match entries.get(name):
		Some(existing):
			existing
		None:
			KnownOrdinaryType

	into_opaque KnownTypeIndex(entries.set(name, next_kind))


pure func known_type_index_record_resource(index: KnownTypeIndex, name: String) -> KnownTypeIndex:
	entries = from_opaque KnownTypeIndex(index)
	updated = entries.set(name, KnownResourceType)
	into_opaque KnownTypeIndex(updated)


pure func known_type_index_has_resource(index: KnownTypeIndex, name: String) -> Bool:
	entries = from_opaque KnownTypeIndex(index)
	entries.get(name) == Some(KnownResourceType)


pure func typecheck_state_reset_type_shape_memo(state: TypecheckState) -> TypecheckState:
	{ state | type_shape_memo = TYPE_SHAPE_MEMO_EMPTY }


pure func typecheck_state_for_origin(origin: ModuleOrigin) -> TypecheckState:
	bootstrap = definition_index_bootstrap_from_base_env(ENV_EMPTY)
	env = definition_index_bootstrap_env(bootstrap)
	seed = definition_index_bootstrap_seed(bootstrap)
	{
		context = context_empty(),
		env = env,
		errors = [],
		diagnostics = [],
		module_view = COMPILER_MODULE_VIEW_EMPTY,
		graph_import_admission = None,
		module_scope = typecheck_module_scope(UnscopedModuleScope(origin, seed)),
		allow_debug_only_calls = False,
		private_impls = [],
		known_type_index = KNOWN_TYPE_INDEX_EMPTY,
		scoped_trait_functions = [],
		type_homes = TYPE_HOME_INDEX_EMPTY,
		type_shape_memo = TYPE_SHAPE_MEMO_EMPTY,
		source_table = None
	}


pure func typecheck_state_begin_graph_import_admission(state: TypecheckState) -> TypecheckState:
	match state.graph_import_admission:
		Some(_):
			typecheck_state_add_error(
				state,
				"internal typecheck error: graph import admission is already active",
			)
		None:
			match (
				typecheck_module_scope_table(state.module_scope),
				typecheck_module_scope_id(state.module_scope),
			):
				(Some(module_table), Some(module_id)):
					match graph_import_admission_begin(state.module_view, module_table, module_id):
						Some(admission):
							{ state | graph_import_admission = Some(admission) }
						None:
							state
				_:
					state


pure func typecheck_state_finish_graph_import_admission(state: TypecheckState) -> TypecheckState:
	match state.graph_import_admission:
		Some(admission):
			{ state |
				module_view = graph_import_admission_finish(admission),
				graph_import_admission = None
			}
		None:
			state


private pure func typecheck_module_scope_index(
	scope: TypecheckModuleScope,
) -> Option[DefinitionIndex]:
	representation = typecheck_module_scope_rep(scope)

	match representation:
		UnscopedModuleScope(_, _):
			None
		ExtensibleModuleScope(_, _, _, index):
			Some(index)
		ReservedModuleScope(prepared_scope):
			Some(prepared_module_scope_definition_index(prepared_scope))


private pure func typecheck_module_scope_table(scope: TypecheckModuleScope) -> Option[ModuleTable]:
	match typecheck_module_scope_rep(scope):
		UnscopedModuleScope(_, _):
			None
		ExtensibleModuleScope(_, _, _, index):
			Some(definition_index_module_table(index))
		ReservedModuleScope(prepared_scope):
			Some(prepared_module_scope_module_table(prepared_scope))


pure func typecheck_state_module_table(state: TypecheckState) -> Option[ModuleTable]:
	typecheck_module_scope_table(state.module_scope)


---
Exact table authority for the state's current module scope. Callers that
replay graph-issued DefinitionIds should derive the table here instead of
accepting an independently supplied table with unproven provenance.
---
pure func typecheck_state_definition_table(state: TypecheckState) -> Option[DefinitionTable]:
	typecheck_module_scope_index(state.module_scope).map(definition_index_definition_table)


pure func typecheck_state_graph_source_name_table(
	state: TypecheckState,
) -> Option[GraphSourceNameTable]:
	match typecheck_module_scope_rep(state.module_scope):
		ReservedModuleScope(prepared_scope):
			Some(prepared_module_scope_graph_source_name_table(prepared_scope))
		_:
			None


private pure func typecheck_module_scope_id(scope: TypecheckModuleScope) -> Option[ModuleId]:
	match typecheck_module_scope_rep(scope):
		UnscopedModuleScope(_, _):
			None
		ExtensibleModuleScope(_, _, module_id, _):
			Some(module_id)
		ReservedModuleScope(prepared_scope):
			Some(prepared_module_scope_id(prepared_scope))


private pure func typecheck_module_scope(
	representation: TypecheckModuleScopeRep,
) -> TypecheckModuleScope:
	into_opaque TypecheckModuleScope(representation)


private pure func typecheck_module_scope_rep(
	scope: TypecheckModuleScope,
) -> TypecheckModuleScopeRep:
	from_opaque TypecheckModuleScope(scope)


private pure func typecheck_state_with_definition_index(
	state: TypecheckState,
	definition_index: DefinitionIndex,
) -> TypecheckState:
	representation = typecheck_module_scope_rep(state.module_scope)

	module_scope = match representation:
		UnscopedModuleScope(origin, _):
			typecheck_module_scope(
				UnscopedModuleScope(
					origin,
					definition_index_seed_from_index(definition_index),
				),
			)
		ExtensibleModuleScope(origin, identity, module_id, _):
			typecheck_module_scope(
				ExtensibleModuleScope(
					origin,
					identity,
					module_id,
					definition_index,
				),
			)
		ReservedModuleScope(_):
			state.module_scope

	{ state | module_scope = module_scope }


pure func typecheck_state_scope_to_program(
	state: TypecheckState,
	program: ParsedProgram,
) -> TypecheckState:
	representation = typecheck_module_scope_rep(state.module_scope)

	next = match representation:
		ReservedModuleScope(_):
			state
		UnscopedModuleScope(origin, seed):
			identity = module_identity_for_program(program)
			resolved = resolved_module_identity_from_resolver(
				module_identity_storage_key(identity),
				origin,
			)

			match module_table([resolved]):
				Err(_):
					typecheck_state_add_error(
						state,
						"internal typecheck error: direct module table construction failed",
					)
				Ok(table):
					match module_table_id_at(table, 0):
						None:
							typecheck_state_add_error(
								state,
								"internal typecheck error: direct module table is empty",
							)
						Some(module_id):
							index = definition_index_empty(seed, table)
							{ state |
								module_scope = typecheck_module_scope(
									ExtensibleModuleScope(
										origin,
										identity,
										module_id,
										index,
									),
								)
							}
		ExtensibleModuleScope(origin, _, _, index):
			identity = module_identity_for_program(program)
			identity_key = module_identity_storage_key(identity)
			table = definition_index_module_table(index)

			match module_table_find_id_by_canonical_path(table, identity_key):
				Some(module_id):
					{ state |
						module_scope = typecheck_module_scope(
							ExtensibleModuleScope(
								origin,
								identity,
								module_id,
								index,
							),
						)
					}
				None:
					var identities: List[ResolvedModuleIdentity] = []

					for table_index in 0..module_table_count(table):
						match module_table_id_at(table, table_index):
							Some(module_id):
								match module_table_resolved_identity(table, module_id):
									Some(existing):
										identities = identities.append(existing)
									None:
										void
							None:
								void

					next_resolved = resolved_module_identity_from_resolver(identity_key, origin)

					match module_table(identities.append(next_resolved)):
						Err(_):
							typecheck_state_add_error(
								state,
								"internal typecheck error: direct module table extension failed",
							)
						Ok(next_table):
							match (
								module_table_find_id_by_canonical_path(next_table, identity_key),
								definition_index_rebase_module_table(index, next_table),
							):
								(Some(module_id), Some(next_index)):
									{ state |
										module_scope = typecheck_module_scope(
											ExtensibleModuleScope(
												origin,
												identity,
												module_id,
												next_index,
											),
										)
									}
								_:
									typecheck_state_add_error(
										state,
										"internal typecheck error: direct definition index rebase failed",
									)

	{ next | source_table = Some(source_table_for_file(program.source)) }


pure func typecheck_state_module_identity(state: TypecheckState) -> ModuleIdentity:
	representation = typecheck_module_scope_rep(state.module_scope)

	match representation:
		UnscopedModuleScope(_, _):
			ANONYMOUS_IDENTITY
		ExtensibleModuleScope(_, identity, _, _):
			identity
		ReservedModuleScope(prepared_scope):
			prepared_module_scope_identity(prepared_scope)


pure func typecheck_state_module_id(state: TypecheckState) -> Option[ModuleId]:
	typecheck_module_scope_id(state.module_scope)


pure func typecheck_state_module_path_matches(state: TypecheckState, module_path: String) -> Bool:
	match typecheck_module_scope_rep(state.module_scope):
		UnscopedModuleScope(_, _):
			False
		ExtensibleModuleScope(_, identity, _, _):
			module_identity_matches_module_path(identity, module_path)
		ReservedModuleScope(prepared_scope):
			prepared_module_scope_canonical_path(prepared_scope) == module_path


private pure func typecheck_state_module_display_name(state: TypecheckState) -> String:
	module_identity_display_name(typecheck_state_module_identity(state))


pure func typecheck_state_with_debug_calls(
	state: TypecheckState,
	allow_debug_only_calls: Bool,
) -> TypecheckState:
	{ state | allow_debug_only_calls = allow_debug_only_calls }


pure func typecheck_state_with_scoped_trait_functions(
	state: TypecheckState,
	functions: List[(String, String)],
) -> TypecheckState:
	{ state | scoped_trait_functions = functions }


pure func typecheck_state_allows_scoped_trait_function(
	state: TypecheckState,
	function_name: String,
	trait_name: String,
) -> Bool:
	var found: Bool = False

	for pair in state.scoped_trait_functions:
		if pair[0] == function_name and pair[1] == trait_name:
			found = True
			break

	found


pure func typecheck_state_find_scoped_trait_function(
	state: TypecheckState,
	function_name: String,
) -> Option[String]:
	var trait_name: Option[String] = None

	for pair in state.scoped_trait_functions:
		if pair[0] == function_name:
			trait_name = Some(pair[1])
			break

	trait_name


pure func typecheck_state_add_scoped_trait_function(
	state: TypecheckState,
	function_name: String,
	trait_name: String,
) -> TypecheckState:
	if typecheck_state_allows_scoped_trait_function(state, function_name, trait_name):
		state
	else:
		{ state |
			scoped_trait_functions = state.scoped_trait_functions.append(
				(function_name, trait_name),
			)
		}


pure func typecheck_state_add_error(state: TypecheckState, message: String) -> TypecheckState:
	typecheck_state_add_diagnostic(
		state,
		typecheck_diagnostic(message, None),
	)


pure func typecheck_state_add_diagnostic(
	state: TypecheckState,
	diagnostic: TypecheckDiagnostic,
) -> TypecheckState:
	{ state |
		errors = state.errors.append(diagnostic.message),
		diagnostics = state.diagnostics.append(diagnostic)
	}


pure func typecheck_state_add_error_at(
	state: TypecheckState,
	span: SourceLocation,
	message: String,
) -> TypecheckState:
	typecheck_state_add_diagnostic(
		state,
		typecheck_diagnostic(message, Some(span)),
	)


pure func typecheck_state_locate_diagnostics_since(
	state: TypecheckState,
	first_diagnostic: Int,
	span: SourceLocation,
) -> TypecheckState:
	var index: Int = 0
	var diagnostics: List[TypecheckDiagnostic] = []

	for diagnostic in state.diagnostics:
		located = if index >= first_diagnostic and diagnostic.span == None:
			{ diagnostic | span = Some(span) }
		else:
			diagnostic

		diagnostics = diagnostics.append(located)
		index += 1

	{ state | diagnostics = diagnostics }


private pure func typecheck_module_scope_origin(scope: TypecheckModuleScope) -> ModuleOrigin:
	representation = typecheck_module_scope_rep(scope)

	match representation:
		UnscopedModuleScope(origin, _):
			origin
		ExtensibleModuleScope(origin, _, _, _):
			origin
		ReservedModuleScope(prepared_scope):
			prepared_module_scope_origin(prepared_scope)


pure func typecheck_state_module_origin(state: TypecheckState) -> ModuleOrigin:
	typecheck_module_scope_origin(state.module_scope)


pure func typecheck_state_allows_builtin(state: TypecheckState) -> Bool:
	module_origin_allows_builtin(typecheck_state_module_origin(state))


pure func typecheck_state_allows_foreign(state: TypecheckState) -> Bool:
	module_origin_allows_foreign(typecheck_state_module_origin(state))


pure func typecheck_state_is_stdlib(state: TypecheckState) -> Bool:
	module_origin_is_std(typecheck_state_module_origin(state))


pure func typecheck_state_is_source_package(state: TypecheckState) -> Bool:
	module_origin_is_source_package(typecheck_state_module_origin(state))


private pure func module_view_matches_module_scope(
	view: ModuleView,
	scope: TypecheckModuleScope,
) -> Bool:
	if not module_view_has_graph_source_names(view):
		True
	else:
		match typecheck_module_scope_rep(scope):
			ReservedModuleScope(prepared_scope):
				module_view_graph_has_exact_catalog(
					view,
					prepared_module_scope_graph_source_name_table(prepared_scope),
					prepared_module_scope_id(prepared_scope),
				)
			_:
				False


pure func typecheck_state_has_compatible_module_view(state: TypecheckState) -> Bool:
	module_view_matches_module_scope(state.module_view, state.module_scope)


pure func typecheck_state_find_module_alias(
	state: TypecheckState,
	alias_name: String,
) -> Option[String]:
	if not module_view_matches_module_scope(state.module_view, state.module_scope):
		None
	else:
		match module_view_find_graph_module_alias(state.module_view, alias_name):
			Some(module_id):
				table ?= typecheck_module_scope_table(state.module_scope)
				module_table_canonical_path(table, module_id)
			None:
				module_view_find_standalone_module_alias(state.module_view, alias_name)


pure func typecheck_state_find_imported_name(
	state: TypecheckState,
	local_name: String,
) -> Option[ImportedNameBinding]:
	if module_view_matches_module_scope(state.module_view, state.module_scope):
		module_view_find_imported_name(state.module_view, local_name)
	else:
		None


pure func typecheck_state_find_top_level_name(
	state: TypecheckState,
	name: String,
) -> Option[TopLevelNameKind]:
	if module_view_matches_module_scope(state.module_view, state.module_scope):
		module_view_find_local_name(state.module_view, name)
	else:
		None


pure func typecheck_state_remember_top_level_name(
	state: TypecheckState,
	name: String,
	kind: TopLevelNameKind,
) -> TypecheckState:
	registration = if module_view_has_graph_source_names(state.module_view):
		match typecheck_module_scope_id(state.module_scope):
			Some(current_module_id):
				match typecheck_module_scope_table(state.module_scope):
					Some(module_table):
						module_view_register_local_name_for_graph(
							state.module_view,
							module_table,
							current_module_id,
							name,
							kind,
						)
					None:
						LocalNameInvalidSourceName
			None:
				LocalNameInvalidSourceName
	else:
		module_view_register_local_name(state.module_view, name, kind)

	match registration:
		LocalNameAdded(view):
			{ state | module_view = view }
		LocalNameAlreadyPresent(_):
			state
		LocalNameConflictsWithAlias(module_path):
			typecheck_state_add_error(
				state,
				top_level_name_kind_label(
					kind,
				) + " '" + name + "' declared in this module conflicts with module alias for '" + module_path + "'",
			)
		LocalNameConflictsWithImportedName(binding):
			typecheck_state_add_error(
				state,
				top_level_name_kind_label(
					kind,
				) + " '" + name + "' declared in this module conflicts with imported name from '" + binding.module_path + "'",
			)
		LocalNameInvalidSourceName:
			typecheck_state_add_error(
				state,
				"internal typecheck error: top-level name '" + name + "' is not " + "cataloged by the active module graph",
			)


pure func typecheck_state_clear_module_name_indexes(state: TypecheckState) -> TypecheckState:
	{ state | module_view = module_view_without_unqualified_names(state.module_view) }


private pure func typecheck_state_apply_module_alias_registration(
	state: TypecheckState,
	alias_name: String,
	registration: ModuleAliasRegistration,
) -> TypecheckState:
	match registration:
		ModuleAliasAlreadyPresent:
			state
		ModuleAliasConflictsWithAlias(existing_module):
			typecheck_state_add_error(
				state,
				"module alias '" + alias_name + "' already used for module '" + existing_module + "'",
			)
		ModuleAliasConflictsWithImportedName(binding):
			typecheck_state_add_error(
				state,
				"module alias '" + alias_name + "' conflicts with imported name from '" + binding.module_path + "'",
			)
		ModuleAliasConflictsWithLocalName(kind):
			typecheck_state_add_error(
				state,
				"module alias '" + alias_name + "' conflicts with " + top_level_name_kind_label(
					kind,
				) + " '" + alias_name + "' declared in this module",
			)
		ModuleAliasInvalidTarget:
			typecheck_state_add_error(
				state,
				(
					"internal typecheck error: module alias target does not belong to the active "
					+ "module graph"
				),
			)
		ModuleAliasAdded(view):
			{ state | module_view = view }


pure func typecheck_state_register_graph_module_alias(
	state: TypecheckState,
	alias_name: String,
	module_path: String,
	issuing_table: ModuleTable,
	module_id: ModuleId,
) -> TypecheckState:
	match state.graph_import_admission:
		Some(admission):
			match (
				typecheck_module_scope_id(state.module_scope),
				typecheck_module_scope_table(state.module_scope),
			):
				(Some(current_module_id), Some(current_table)):
					match graph_import_admission_register_alias(
						admission,
						current_table,
						current_module_id,
						alias_name,
						module_path,
						issuing_table,
						module_id,
					):
						GraphModuleAliasAdded(next):
							{ state | graph_import_admission = Some(next) }
						GraphModuleAliasAlreadyPresent(next):
							{ state | graph_import_admission = Some(next) }
						GraphModuleAliasConflictsWithAlias(next, existing):
							typecheck_state_apply_module_alias_registration(
								{ state | graph_import_admission = Some(next) },
								alias_name,
								ModuleAliasConflictsWithAlias(existing),
							)
						GraphModuleAliasConflictsWithImportedName(next, existing):
							typecheck_state_apply_module_alias_registration(
								{ state | graph_import_admission = Some(next) },
								alias_name,
								ModuleAliasConflictsWithImportedName(existing),
							)
						GraphModuleAliasConflictsWithLocalName(next, existing):
							typecheck_state_apply_module_alias_registration(
								{ state | graph_import_admission = Some(next) },
								alias_name,
								ModuleAliasConflictsWithLocalName(existing),
							)
						GraphModuleAliasInvalidTarget(next):
							typecheck_state_apply_module_alias_registration(
								{ state | graph_import_admission = Some(next) },
								alias_name,
								ModuleAliasInvalidTarget,
							)
				_:
					typecheck_state_apply_module_alias_registration(
						state,
						alias_name,
						ModuleAliasInvalidTarget,
					)
		None:
			typecheck_state_register_graph_module_alias_without_admission(
				state,
				alias_name,
				module_path,
				issuing_table,
				module_id,
			)


private pure func typecheck_state_register_graph_module_alias_without_admission(
	state: TypecheckState,
	alias_name: String,
	module_path: String,
	issuing_table: ModuleTable,
	module_id: ModuleId,
) -> TypecheckState:
	match typecheck_module_scope_id(state.module_scope):
		Some(current_module_id):
			match typecheck_module_scope_table(state.module_scope):
				Some(current_table):
					typecheck_state_apply_module_alias_registration(
						state,
						alias_name,
						module_view_register_module_alias_target(
							state.module_view,
							current_table,
							current_module_id,
							alias_name,
							module_path,
							issuing_table,
							module_id,
						),
					)
				None:
					typecheck_state_add_error(
						state,
						(
							"internal typecheck error: module alias target does not belong to the active "
							+ "module graph"
						),
					)
		None:
			typecheck_state_add_error(
				state,
				(
					"internal typecheck error: module alias target does not belong to the active "
					+ "module graph"
				),
			)


pure func typecheck_state_register_standalone_module_alias(
	state: TypecheckState,
	alias_name: String,
	canonical_name: String,
) -> TypecheckState:
	typecheck_state_apply_module_alias_registration(
		state,
		alias_name,
		module_view_register_standalone_module_alias(state.module_view, alias_name, canonical_name),
	)


pure func typecheck_state_register_imported_name(
	state: TypecheckState,
	local_name: String,
	module_path: String,
	original_name: String,
) -> ImportedNameRegistration:
	registration = module_view_register_selective_name(
		state.module_view,
		local_name,
		module_path,
		original_name,
	)
	typecheck_state_apply_selective_name_registration(
		state,
		local_name,
		module_path,
		original_name,
		registration,
	)


pure func typecheck_state_register_graph_imported_name(
	state: TypecheckState,
	local_name: String,
	module_path: String,
	original_name: String,
	issuing_definition_table: DefinitionTable,
	module_id: ModuleId,
	definition_ids: List[DefinitionId],
) -> ImportedNameRegistration:
	match state.graph_import_admission:
		Some(admission):
			index = typecheck_module_scope_index(state.module_scope)

			match (
				index.map(definition_index_definition_table),
				typecheck_module_scope_id(state.module_scope),
			):
				(Some(table), Some(current_module_id)):
					typecheck_state_apply_graph_selective_admission(
						state,
						local_name,
						module_path,
						original_name,
						graph_import_admission_register_selective_definition(
							admission,
							current_module_id,
							table,
							issuing_definition_table,
							local_name,
							module_path,
							original_name,
							module_id,
							definition_ids,
						),
					)
				_:
					typecheck_state_apply_graph_selective_admission(
						state,
						local_name,
						module_path,
						original_name,
						GraphSelectiveInvalidTarget(admission),
					)
		None:
			typecheck_state_register_graph_imported_name_without_admission(
				state,
				local_name,
				module_path,
				original_name,
				issuing_definition_table,
				module_id,
				definition_ids,
			)


private pure func typecheck_state_register_graph_imported_name_without_admission(
	state: TypecheckState,
	local_name: String,
	module_path: String,
	original_name: String,
	issuing_definition_table: DefinitionTable,
	module_id: ModuleId,
	definition_ids: List[DefinitionId],
) -> ImportedNameRegistration:
	index = typecheck_module_scope_index(state.module_scope)
	definition_table = index.map(definition_index_definition_table)

	registration = match definition_table:
		Some(table):
			match typecheck_module_scope_id(state.module_scope):
				Some(current_module_id):
					module_view_register_selective_name_for_graph(
						state.module_view,
						current_module_id,
						table,
						issuing_definition_table,
						local_name,
						module_path,
						original_name,
						module_id,
						definition_ids,
					)
				None:
					SelectiveNameInvalidTarget
		_:
			SelectiveNameInvalidTarget

	typecheck_state_apply_selective_name_registration(
		state,
		local_name,
		module_path,
		original_name,
		registration,
	)


---
Trait methods are identified explicitly by their module-surface kind before
reaching this boundary. Their graph binding retains that kind and source
name until TraitMethodIds are available, plus any exact DefinitionIds owned
by overlapping callable/global symbols. Keeping both facts in one variant
lets each later authority consume only the identity domain it owns.
---
pure func typecheck_state_register_graph_imported_trait_method(
	state: TypecheckState,
	local_name: String,
	module_path: String,
	original_name: String,
	issuing_definition_table: DefinitionTable,
	module_id: ModuleId,
	definition_ids: List[DefinitionId],
) -> ImportedNameRegistration:
	match state.graph_import_admission:
		Some(admission):
			index = typecheck_module_scope_index(state.module_scope)

			match (
				index.map(definition_index_definition_table),
				typecheck_module_scope_id(state.module_scope),
			):
				(Some(table), Some(current_module_id)):
					typecheck_state_apply_graph_selective_admission(
						state,
						local_name,
						module_path,
						original_name,
						graph_import_admission_register_selective_trait_method(
							admission,
							current_module_id,
							table,
							issuing_definition_table,
							local_name,
							module_path,
							original_name,
							module_id,
							definition_ids,
						),
					)
				_:
					typecheck_state_apply_graph_selective_admission(
						state,
						local_name,
						module_path,
						original_name,
						GraphSelectiveInvalidTarget(admission),
					)
		None:
			typecheck_state_register_graph_imported_trait_method_without_admission(
				state,
				local_name,
				module_path,
				original_name,
				issuing_definition_table,
				module_id,
				definition_ids,
			)


private pure func typecheck_state_register_graph_imported_trait_method_without_admission(
	state: TypecheckState,
	local_name: String,
	module_path: String,
	original_name: String,
	issuing_definition_table: DefinitionTable,
	module_id: ModuleId,
	definition_ids: List[DefinitionId],
) -> ImportedNameRegistration:
	index = typecheck_module_scope_index(state.module_scope)
	definition_table = index.map(definition_index_definition_table)

	registration = match definition_table:
		Some(table):
			match typecheck_module_scope_id(state.module_scope):
				Some(current_module_id):
					module_view_register_graph_selective_trait_method(
						state.module_view,
						current_module_id,
						table,
						issuing_definition_table,
						local_name,
						module_path,
						original_name,
						module_id,
						definition_ids,
					)
				None:
					SelectiveNameInvalidTarget
		None:
			SelectiveNameInvalidTarget

	typecheck_state_apply_selective_name_registration(
		state,
		local_name,
		module_path,
		original_name,
		registration,
	)


private pure func typecheck_state_apply_selective_name_registration(
	state: TypecheckState,
	local_name: String,
	module_path: String,
	original_name: String,
	registration: SelectiveNameRegistration,
) -> ImportedNameRegistration:
	match registration:
		SelectiveNameAdded(view):
			{
				state = { state | module_view = view },
				registered = True
			}
		SelectiveNameConflictsWithAlias(existing_module):
			{
				state = typecheck_state_add_error(
					state,
					"imported name '" + local_name + "' is already used as module alias for '" + existing_module + "'",
				),
				registered = False
			}
		SelectiveNameConflictsWithImportedName(binding):
			message = if (
				binding.original_name == local_name
				and original_name == local_name
				and binding.module_path != module_path
			):
				"Ambiguous import: '" + local_name + "' is already imported from '" + binding.module_path + "'"
			else:
				"imported name '" + local_name + "' is already imported from '" + binding.module_path + "'; use a distinct alias"

			{
				state = typecheck_state_add_error(state, message),
				registered = False
			}
		SelectiveNameConflictsWithLocalName(kind):
			{
				state = typecheck_state_add_error(
					state,
					"imported name '" + local_name + "' conflicts with " + top_level_name_kind_label(
						kind,
					) + " '" + local_name + "' declared in this module",
				),
				registered = False
			}
		SelectiveNameInvalidSourceName:
			{
				state = typecheck_state_add_error(
					state,
					"internal typecheck error: selective import local name '" + local_name + "' is not cataloged by the active module graph",
				),
				registered = False
			}
		SelectiveNameInvalidTarget:
			{
				state = typecheck_state_add_error(
					state,
					"internal typecheck error: selective import target '" + original_name + "' from module '" + module_path + "' does not belong to the active module and definition graph",
				),
				registered = False
			}


private pure func typecheck_state_apply_graph_selective_admission(
	state: TypecheckState,
	local_name: String,
	module_path: String,
	original_name: String,
	decision: GraphSelectiveAdmission,
) -> ImportedNameRegistration:
	match decision:
		GraphSelectiveAdded(admission):
			{
				state = { state | graph_import_admission = Some(admission) },
				registered = True
			}
		GraphSelectiveConflictsWithAlias(admission, existing):
			typecheck_state_apply_selective_name_registration(
				{ state | graph_import_admission = Some(admission) },
				local_name,
				module_path,
				original_name,
				SelectiveNameConflictsWithAlias(existing),
			)
		GraphSelectiveConflictsWithImportedName(admission, existing):
			typecheck_state_apply_selective_name_registration(
				{ state | graph_import_admission = Some(admission) },
				local_name,
				module_path,
				original_name,
				SelectiveNameConflictsWithImportedName(existing),
			)
		GraphSelectiveConflictsWithLocalName(admission, existing):
			typecheck_state_apply_selective_name_registration(
				{ state | graph_import_admission = Some(admission) },
				local_name,
				module_path,
				original_name,
				SelectiveNameConflictsWithLocalName(existing),
			)
		GraphSelectiveInvalidSourceName(admission):
			typecheck_state_apply_selective_name_registration(
				{ state | graph_import_admission = Some(admission) },
				local_name,
				module_path,
				original_name,
				SelectiveNameInvalidSourceName,
			)
		GraphSelectiveInvalidTarget(admission):
			typecheck_state_apply_selective_name_registration(
				{ state | graph_import_admission = Some(admission) },
				local_name,
				module_path,
				original_name,
				SelectiveNameInvalidTarget,
			)


private pure func imported_constructor_annotation_failure(
	state: TypecheckState,
) -> ImportedNameRegistration:
	{
		state = typecheck_state_add_error(
			state,
			(
				"internal typecheck error: imported constructor has no matching admitted "
				+ "selective name"
			),
		),
		registered = False
	}


pure func typecheck_state_register_imported_constructor(
	state: TypecheckState,
	local_name: String,
	module_path: String,
	parent_local_name: String,
	parent_name: String,
	original_name: String,
) -> ImportedNameRegistration:
	registration = typecheck_state_register_imported_name(
		state,
		local_name,
		module_path,
		original_name,
	)

	if registration.registered:
		binding: ImportedConstructorBinding = {
			local_name = local_name,
			module_path = module_path,
			parent_local_name = parent_local_name,
			parent_name = parent_name,
			original_name = original_name
		}

		match module_view_record_imported_constructor(registration.state.module_view, binding):
			Some(view):
				{
					state = { registration.state | module_view = view },
					registered = True
				}
			None:
				imported_constructor_annotation_failure(state)
	else:
		registration


pure func typecheck_state_register_graph_imported_constructor(
	state: TypecheckState,
	local_name: String,
	module_path: String,
	parent_local_name: String,
	parent_name: String,
	original_name: String,
	issuing_definition_table: DefinitionTable,
	module_id: ModuleId,
) -> ImportedNameRegistration:
	binding: ImportedConstructorBinding = {
		local_name = local_name,
		module_path = module_path,
		parent_local_name = parent_local_name,
		parent_name = parent_name,
		original_name = original_name
	}
	index = typecheck_module_scope_index(state.module_scope)
	active_definition_table = index.map(definition_index_definition_table)

	registration_result = match (index, active_definition_table):
		(Some(active_index), Some(active_table)):
			current_module_id = typecheck_module_scope_id(state.module_scope)

			if (
				current_module_id.is_none()
				or not definition_tables_share_provenance(active_table, issuing_definition_table)
			):
				typecheck_state_apply_selective_name_registration(
					state,
					local_name,
					module_path,
					original_name,
					SelectiveNameInvalidTarget,
				)
			else:
				match definition_index_constructor_definition_ids_for_export(
					active_index,
					definition_table_module_table(issuing_definition_table),
					module_id,
					original_name,
					parent_name,
				):
					Some(ids):
						match current_module_id:
							Some(owner_id):
								match state.graph_import_admission:
									Some(admission):
										typecheck_state_apply_graph_selective_admission(
											state,
											local_name,
											module_path,
											original_name,
											graph_import_admission_register_constructor(
												admission,
												owner_id,
												active_table,
												issuing_definition_table,
												binding,
												module_id,
												ids,
											),
										)
									None:
										typecheck_state_apply_selective_name_registration(
											state,
											local_name,
											module_path,
											original_name,
											module_view_register_selective_name_for_graph(
												state.module_view,
												owner_id,
												active_table,
												issuing_definition_table,
												local_name,
												module_path,
												original_name,
												module_id,
												ids,
											),
										)
							None:
								typecheck_state_apply_selective_name_registration(
									state,
									local_name,
									module_path,
									original_name,
									SelectiveNameInvalidTarget,
								)
					None:
						{
							state = typecheck_state_add_error(
								state,
								"constructor '" + original_name + "' is not exported by type '" + parent_name + "' from module '" + module_path + "'",
							),
							registered = False
						}
		_:
			typecheck_state_apply_selective_name_registration(
				state,
				local_name,
				module_path,
				original_name,
				SelectiveNameInvalidTarget,
			)

	if registration_result.registered:
		match registration_result.state.graph_import_admission:
			Some(_):
				-- Builder admission publishes the constructor payload atomically.
				registration_result
			None:
				match module_view_record_imported_constructor(
					registration_result.state.module_view,
					binding,
				):
					Some(view):
						{
							state = { registration_result.state | module_view = view },
							registered = True
						}
					None:
						imported_constructor_annotation_failure(state)
	else:
		registration_result


---
`state.type_homes`'s sibling: `known_type_index_record_type` always
constructs and this update reads `state.known_type_index` exactly once,
in the field's own replacement expression, which is what lets the
record-update reuse this record's storage in place (see
`docs/MEMORY_MODEL.md`, "a collection field updated through its own
record keeps the fast path only... where the field's replacement is the
one place the update reads that field").
---
pure func typecheck_state_add_known_type_name(
	state: TypecheckState,
	name: String,
) -> TypecheckState:
	{ state | known_type_index = known_type_index_record_type(state.known_type_index, name) }


pure func typecheck_state_add_known_resource_type_name(
	state: TypecheckState,
	name: String,
) -> TypecheckState:
	{ state | known_type_index = known_type_index_record_resource(state.known_type_index, name) }


pure func typecheck_state_has_known_type_name(state: TypecheckState, name: String) -> Bool:
	entries = from_opaque KnownTypeIndex(state.known_type_index)
	entries.contains(name)


pure func typecheck_state_has_known_resource_type_name(state: TypecheckState, name: String) -> Bool:
	known_type_index_has_resource(state.known_type_index, name)


pure func typecheck_state_clear_known_type_index(state: TypecheckState) -> TypecheckState:
	{ state | known_type_index = KNOWN_TYPE_INDEX_EMPTY }


pure func typecheck_state_find_type_home(
	state: TypecheckState,
	type_name: String,
) -> Option[String]:
	type_home_index_module_path(state.type_homes, type_name)


pure func typecheck_state_type_home_is_imported(state: TypecheckState, type_name: String) -> Bool:
	type_home_index_is_imported(state.type_homes, type_name)


pure func typecheck_state_type_home_matches(
	state: TypecheckState,
	type_name: String,
	module_path: String,
) -> Bool:
	typecheck_state_find_type_home(state, type_name) == Some(module_path)


---
The "imported name that already has a home is a no-op" precedence rule
lives inside `type_home_index_record`, not here, and it never returns
`state.type_homes` (or `state`) unchanged from a bare-identifier arm --
it always finishes with `entries.set`. That matters for two independent
reasons documented at length here because both were tried and measured
with `--dump-core-after=reuse` before this shape:

1. `consume_specialize.brp`'s `function_is_cloneable` refuses a consuming
   clone of any function with a path that returns its own parameter
   unchanged (a bare `index` or bare `state` return). The original
   `type_home_index_record` had exactly that shape (`Some(_): if
   imported: index`), so it never got a `__consume_arg0` clone, and
   every call site's `consumed_args` covered only the `String`
   arguments, never `index`. A first attempt at this fix moved the same
   bare-return shape into `typecheck_state_record_type_home` itself
   (`if imported and has_entry: state else: {...}`); that reproduced the
   identical measurement (no clone, `state` never in `consumed_args`)
   because the bare return simply disqualified this function instead.
2. Even with no bare-parameter return, hoisting the choice into a local
   before the update (`next = if ...: state.type_homes else: ...; {
   state | type_homes = next }`) reads `state.type_homes` twice --
   once in the `if`'s condition/branches, once implicitly by referring
   back to it -- which `docs/MEMORY_MODEL.md`'s COW section calls out
   directly: the record-update fast path is proved only when "the
   field's replacement is the one place the update reads that field";
   every other shape, including one "that reads the field twice",
   still copies.

Folding the precedence check into `type_home_index_record` satisfies
both: this function reads `state.type_homes` exactly once, in the
update's own field-replacement expression, and reaches an insert
helper that always constructs. After this change `state` (argument 0)
appears in `consumed_args` at this function's call sites in the
header-install loops (`typecheck_install_imported_union_headers` and
siblings in `headers/type_header_install.brp`, each of which threads
`state` through a `var next = state; for ...: next = install_*(next,
...)` loop where `next` is genuinely last-used per call).
---
pure func typecheck_state_record_type_home(
	state: TypecheckState,
	type_name: String,
	module_path: String,
	imported: Bool,
) -> TypecheckState:
	{ state |
		type_homes = type_home_index_record(state.type_homes, type_name, module_path, imported)
	}


private pure func typecheck_state_record_func_callable_id(
	state: TypecheckState,
	key: FuncCallableKey,
	def_id: Int,
) -> DefinitionIdClaim:
	match (
		typecheck_module_scope_index(state.module_scope),
		typecheck_module_scope_table(state.module_scope),
	):
		(Some(current_index), Some(module_table)):
			match definition_index_insert_func_callable_id(
				current_index,
				module_table,
				key,
				def_id,
			):
				Ok(definition_index):
					aligned_index = definition_index_advance_to_env(definition_index, state.env)
					updated = typecheck_state_with_definition_index(
						{ state |
							env = { state.env |
								next_def_id = definition_index_next_def_id(aligned_index)
							}
						},
						aligned_index,
					)
					DefinitionIdClaimed(updated, def_id)
				Err(conflict):
					with_error = typecheck_state_add_error(
						typecheck_state_with_definition_index(
							state,
							definition_index_advance_to_env(current_index, state.env),
						),
						"internal typecheck error: " + definition_index_conflict_message_for_module(
							current_index,
							conflict,
							func_callable_key_module_id(key),
							module_identity_display_name(typecheck_state_module_identity(state)),
						),
					)
					DefinitionIdMissing(with_error)
		_:
			DefinitionIdMissing(
				typecheck_state_add_error(
					state,
					"internal typecheck error: cannot record a callable before selecting a module",
				),
			)


pure func typecheck_state_find_func_callable_id(
	state: TypecheckState,
	key: FuncCallableKey,
) -> Option[Int]:
	match (
		typecheck_module_scope_index(state.module_scope),
		typecheck_module_scope_table(state.module_scope),
	):
		(Some(index), Some(module_table)):
			definition_index_find_func_callable_id(index, module_table, key)
		_:
			None


pure func typecheck_state_func_callable_bindings(
	state: TypecheckState,
	name: String,
) -> List[(FuncCallableKey, Int)]:
	match typecheck_module_scope_index(state.module_scope):
		Some(index):
			definition_index_func_callable_bindings(index, name)
		None:
			[]


private pure func typecheck_state_record_source_definition_id(
	state: TypecheckState,
	key: SourceDefinitionKey,
	def_id: Int,
) -> DefinitionIdClaim:
	match (
		typecheck_module_scope_index(state.module_scope),
		typecheck_module_scope_table(state.module_scope),
	):
		(Some(current_index), Some(module_table)):
			match definition_index_insert_source_definition_id(
				current_index,
				module_table,
				key,
				def_id,
			):
				Ok(definition_index):
					aligned_index = definition_index_advance_to_env(definition_index, state.env)
					updated = typecheck_state_with_definition_index(
						{ state |
							env = { state.env |
								next_def_id = definition_index_next_def_id(aligned_index)
							}
						},
						aligned_index,
					)
					DefinitionIdClaimed(updated, def_id)
				Err(conflict):
					with_error = typecheck_state_add_error(
						typecheck_state_with_definition_index(
							state,
							definition_index_advance_to_env(current_index, state.env),
						),
						"internal typecheck error: " + definition_index_conflict_message_for_module(
							current_index,
							conflict,
							source_definition_key_module_id(key),
							module_identity_display_name(typecheck_state_module_identity(state)),
						),
					)
					DefinitionIdMissing(with_error)
		_:
			DefinitionIdMissing(
				typecheck_state_add_error(
					state,
					(
						"internal typecheck error: cannot record a source definition before selecting a "
						+ "module"
					),
				),
			)


pure func typecheck_state_find_source_definition_id(
	state: TypecheckState,
	key: SourceDefinitionKey,
) -> Option[Int]:
	match (
		typecheck_module_scope_index(state.module_scope),
		typecheck_module_scope_table(state.module_scope),
	):
		(Some(index), Some(module_table)):
			definition_index_find_source_definition_id(index, module_table, key)
		_:
			None


pure func typecheck_state_definition_index(state: TypecheckState) -> Option[DefinitionIndex]:
	match typecheck_module_scope_index(state.module_scope):
		Some(index):
			Some(definition_index_advance_to_env(index, state.env))
		None:
			None


pure func typecheck_state_enter_prepared_module_scope(
	state: TypecheckState,
	prepared_scope: PreparedModuleScope,
) -> TypecheckState:
	representation = typecheck_module_scope_rep(state.module_scope)

	match representation:
		UnscopedModuleScope(_, _):
			-- Metas allocated before the accepted table exists have no checked
			-- module session to bind to. Do not silently rehome that solver when
			-- installing the indexed scope.
			if meta_solver_allocated_count(state.context) != 0:
				typecheck_state_add_error(
					state,
					"internal typecheck error: inference metas issued before selecting a module",
				)
			else:
				definition_index = prepared_module_scope_definition_index(prepared_scope)
				aligned_index = definition_index_advance_to_env(definition_index, state.env)
				{ state |
					env = { state.env | next_def_id = definition_index_next_def_id(aligned_index) },
					module_view = module_view_for_graph(
						prepared_module_scope_graph_module_name_scope(prepared_scope),
					),
					module_scope = typecheck_module_scope(ReservedModuleScope(prepared_scope))
				}
		ExtensibleModuleScope(_, _, _, _):
			typecheck_state_add_error(
				state,
				(
					"internal typecheck error: cannot enter an indexed graph from an extensible "
					+ "module scope"
				),
			)
		ReservedModuleScope(_):
			typecheck_state_add_error(
				state,
				"internal typecheck error: cannot replace an indexed graph scope",
			)


---
Construct the canonical fresh state for binding one indexed module. Keeping
origin, debug policy, and reserved-scope installation together prevents
bridge and benchmark callers from drifting apart.
---
pure func typecheck_state_for_prepared_module_scope(
	prepared_scope: PreparedModuleScope,
	allow_debug_only_calls: Bool,
) -> TypecheckState:
	typecheck_state_enter_prepared_module_scope(
		typecheck_state_with_debug_calls(
			typecheck_state_for_origin(prepared_module_scope_origin(prepared_scope)),
			allow_debug_only_calls,
		),
		prepared_scope,
	)


pure func typecheck_state_scope_to_imported_module(
	state: TypecheckState,
	imported_scope: PreparedModuleScope,
) -> TypecheckState:
	representation = typecheck_module_scope_rep(state.module_scope)

	match representation:
		UnscopedModuleScope(_, _):
			typecheck_state_add_error(
				state,
				(
					"internal typecheck error: cannot select an imported module before selecting the "
					+ "current module"
				),
			)
		ExtensibleModuleScope(_, _, _, _):
			{ state | module_scope = typecheck_module_scope(ReservedModuleScope(imported_scope)) }
		ReservedModuleScope(current_scope):
			if prepared_module_scopes_are_compatible(current_scope, imported_scope):
				{ state |
					module_scope = typecheck_module_scope(ReservedModuleScope(imported_scope))
				}
			else:
				typecheck_state_add_error(
					state,
					(
						"internal typecheck error: imported module scope is incompatible with the "
						+ "current indexed graph"
					),
				)


pure func typecheck_state_accepts_imported_module_scope(
	state: TypecheckState,
	imported_scope: PreparedModuleScope,
) -> Bool:
	representation = typecheck_module_scope_rep(state.module_scope)

	match representation:
		UnscopedModuleScope(_, _):
			False
		ExtensibleModuleScope(_, _, _, _):
			True
		ReservedModuleScope(current_scope):
			prepared_module_scopes_are_compatible(current_scope, imported_scope)


---
Accepted graph-backed typechecking requires both the same indexed graph and
the exact selected module. The broader imported-scope predicate above is
intentionally insufficient because extensible tooling states are not
graph-owned semantic inputs.
---
pure func typecheck_state_is_reserved_for_scope(
	state: TypecheckState,
	expected_scope: PreparedModuleScope,
) -> Bool:
	representation = typecheck_module_scope_rep(state.module_scope)

	match representation:
		ReservedModuleScope(current_scope):
			prepared_module_scopes_select_same_module(current_scope, expected_scope)
		UnscopedModuleScope(_, _):
			False
		ExtensibleModuleScope(_, _, _, _):
			False


---
Exact graph admission is intentionally narrower than structural scope
compatibility: raw ModuleId values are meaningful only in the allocation
that issued them.
---
pure func typecheck_state_is_reserved_for_exact_scope(
	state: TypecheckState,
	expected_scope: PreparedModuleScope,
) -> Bool:
	representation = typecheck_module_scope_rep(state.module_scope)

	match representation:
		ReservedModuleScope(current_scope):
			(
				module_tables_are_compatible(
					prepared_module_scope_module_table(current_scope),
					prepared_module_scope_module_table(expected_scope),
				)
				and module_ids_equal(
					prepared_module_scope_id(current_scope),
					prepared_module_scope_id(expected_scope),
				)
			)
		UnscopedModuleScope(_, _):
			False
		ExtensibleModuleScope(_, _, _, _):
			False


---
Restores a saved definition scope without holding the whole state it came
from: an import edge saves only `state.module_scope` so the session record
it was read from stays uniquely owned through the header install.
---
pure func typecheck_state_restore_module_scope(
	state: TypecheckState,
	target_scope: TypecheckModuleScope,
) -> TypecheckState:
	target_representation = typecheck_module_scope_rep(target_scope)

	match target_representation:
		UnscopedModuleScope(_, _):
			typecheck_state_add_error(
				state,
				"internal typecheck error: cannot restore an unscoped definition context",
			)
		ExtensibleModuleScope(_, _, _, _):
			{ state | module_scope = target_scope }
		ReservedModuleScope(prepared_scope):
			current_representation = typecheck_module_scope_rep(state.module_scope)
			canonical_path = prepared_module_scope_canonical_path(prepared_scope)

			match current_representation:
				ReservedModuleScope(current_scope):
					if prepared_module_scopes_are_compatible(current_scope, prepared_scope):
						{ state |
							module_scope = typecheck_module_scope(
								ReservedModuleScope(prepared_scope),
							)
						}
					else:
						typecheck_state_add_error(
							state,
							"internal typecheck error: module '" + canonical_path + "' is not in the indexed graph",
						)
				_:
					typecheck_state_add_error(
						state,
						"internal typecheck error: cannot select indexed graph module '" + canonical_path + "' before entering a graph scope",
					)


private pure func typecheck_state_mint_definition_id(
	state: TypecheckState,
) -> (TypecheckState, Int):
	match env_mint_def_id(state.env):
		(next_env, def_id):
			({ state | env = next_env }, def_id)


pure func typecheck_state_claim_func_callable_id(
	state: TypecheckState,
	key: FuncCallableKey,
) -> DefinitionIdClaim:
	owner_matches = match typecheck_state_module_id(state):
		Some(module_id):
			module_ids_equal(module_id, func_callable_key_module_id(key))
		None:
			True

	if not owner_matches:
		DefinitionIdMissing(
			typecheck_state_add_error(
				state,
				(
					"internal typecheck error: cannot claim a callable definition ID owned by a "
					+ "different module"
				),
			),
		)
	else:
		match typecheck_state_find_func_callable_id(state, key):
			Some(def_id):
				DefinitionIdClaimed(state, def_id)
			None:
				representation = typecheck_module_scope_rep(state.module_scope)

				match representation:
					ReservedModuleScope(_):
						with_error = typecheck_state_add_error(
							state,
							"internal typecheck error: missing reserved definition ID for " + func_callable_key_description(
								key,
								typecheck_state_module_display_name(state),
							),
						)
						DefinitionIdMissing(with_error)
					UnscopedModuleScope(_, _):
						with_error = typecheck_state_add_error(
							state,
							"internal typecheck error: cannot claim " + func_callable_key_description(
								key,
								typecheck_state_module_display_name(
									state,
								),
							) + " before selecting a module",
						)
						DefinitionIdMissing(with_error)
					ExtensibleModuleScope(_, _, _, _):
						match typecheck_state_mint_definition_id(state):
							(with_id, def_id):
								typecheck_state_record_func_callable_id(with_id, key, def_id)


pure func typecheck_state_claim_source_definition_id(
	state: TypecheckState,
	key: SourceDefinitionKey,
) -> DefinitionIdClaim:
	owner_matches = match typecheck_state_module_id(state):
		Some(module_id):
			module_ids_equal(module_id, source_definition_key_module_id(key))
		None:
			True

	if not owner_matches:
		DefinitionIdMissing(
			typecheck_state_add_error(
				state,
				(
					"internal typecheck error: cannot claim a source definition ID owned by a "
					+ "different module"
				),
			),
		)
	else:
		match typecheck_state_find_source_definition_id(state, key):
			Some(def_id):
				DefinitionIdClaimed(state, def_id)
			None:
				representation = typecheck_module_scope_rep(state.module_scope)

				match representation:
					ReservedModuleScope(_):
						with_error = typecheck_state_add_error(
							state,
							"internal typecheck error: missing reserved definition ID for " + source_definition_key_description(
								key,
								typecheck_state_module_display_name(state),
							),
						)
						DefinitionIdMissing(with_error)
					UnscopedModuleScope(_, _):
						with_error = typecheck_state_add_error(
							state,
							"internal typecheck error: cannot claim " + source_definition_key_description(
								key,
								typecheck_state_module_display_name(
									state,
								),
							) + " before selecting a module",
						)
						DefinitionIdMissing(with_error)
					ExtensibleModuleScope(_, _, _, _):
						match typecheck_state_mint_definition_id(state):
							(with_id, def_id):
								typecheck_state_record_source_definition_id(with_id, key, def_id)


pure func typecheck_state_add_private_impl(
	state: TypecheckState,
	instance: ImplInstance,
) -> TypecheckState:
	{ state | private_impls = state.private_impls.append(instance) }


pure func typecheck_state_find_private_impl_conflict(
	state: TypecheckState,
	candidate: ImplInstance,
) -> Option[ImplInstance]:
	var result: Option[ImplInstance] = None

	for existing in state.private_impls:
		if (
			not existing.is_builtin
			and not candidate.is_builtin
			and existing.trait_name == candidate.trait_name
			and types_equal(existing.for_type, candidate.for_type)
		):
			result = Some(existing)
			break

	result


---
Module facts are immutable within one body check. Keeping them inside the
session gives InferContext one coherent state value while record updates to
body-local fields preserve the facts by construction.
---
enum InferDefinitionIdentityDomain:
	ReservedGraphDefinitionDomain
	UnindexedDefinitionDomain


record InferModuleFacts {
	module_view: ModuleView,
	module_scope: TypecheckModuleScope,
	definition_identity_domain: InferDefinitionIdentityDomain,
	allow_debug_only_calls: Bool,
	private_impls: List[ImplInstance],
	known_type_index: KnownTypeIndex,
	scoped_trait_functions: List[(String, String)],
	type_homes: TypeHomeIndex,
	source_table: Option[SourceTable]
}


record InferSession {
	context: Context,
	env: Env,
	errors: List[String],
	diagnostics: List[TypecheckDiagnostic],
	type_shape_memo: TypeShapeMemo,
	facts: InferModuleFacts
}


pure func infer_session_from_typecheck_state(state: TypecheckState) -> InferSession:
	{
		context = state.context,
		env = state.env,
		errors = state.errors,
		diagnostics = state.diagnostics,
		type_shape_memo = state.type_shape_memo,
		facts = infer_module_facts_from_typecheck_state(state)
	}


pure func infer_module_facts_from_typecheck_state(state: TypecheckState) -> InferModuleFacts:
	definition_identity_domain = match typecheck_module_scope_rep(state.module_scope):
		ReservedModuleScope(_):
			ReservedGraphDefinitionDomain
		UnscopedModuleScope(_, _) | ExtensibleModuleScope(_, _, _, _):
			UnindexedDefinitionDomain

	-- Body inference reads the admitted view directly and often. Discard a
	-- mismatched graph view once here so none of those reads can observe names
	-- or accepted authorities belonging to another module in the same graph.
	admitted_view = if module_view_matches_module_scope(state.module_view, state.module_scope):
		state.module_view
	else:
		COMPILER_MODULE_VIEW_EMPTY

	{
		module_view = admitted_view,
		module_scope = state.module_scope,
		definition_identity_domain = definition_identity_domain,
		allow_debug_only_calls = state.allow_debug_only_calls,
		private_impls = state.private_impls,
		known_type_index = state.known_type_index,
		scoped_trait_functions = state.scoped_trait_functions,
		type_homes = state.type_homes,
		source_table = state.source_table
	}


pure func infer_module_facts_definition_table(facts: InferModuleFacts) -> Option[DefinitionTable]:
	typecheck_module_scope_index(facts.module_scope).map(definition_index_definition_table)


pure func infer_module_facts_module_id(facts: InferModuleFacts) -> Option[ModuleId]:
	typecheck_module_scope_id(facts.module_scope)


pure func infer_module_facts_graph_source_name_table(
	facts: InferModuleFacts,
) -> Option[GraphSourceNameTable]:
	match typecheck_module_scope_rep(facts.module_scope):
		ReservedModuleScope(prepared_scope):
			Some(prepared_module_scope_graph_source_name_table(prepared_scope))
		_:
			None


pure func infer_module_facts_module_table(facts: InferModuleFacts) -> Option[ModuleTable]:
	typecheck_module_scope_table(facts.module_scope)


pure func infer_module_facts_find_module_alias(
	facts: InferModuleFacts,
	alias_name: String,
) -> Option[String]:
	if not module_view_matches_module_scope(facts.module_view, facts.module_scope):
		None
	else:
		match module_view_find_graph_module_alias(facts.module_view, alias_name):
			Some(module_id):
				table ?= typecheck_module_scope_table(facts.module_scope)
				module_table_canonical_path(table, module_id)
			None:
				module_view_find_standalone_module_alias(facts.module_view, alias_name)


pure func infer_module_facts_requires_graph_definition(facts: InferModuleFacts) -> Bool:
	facts.definition_identity_domain == ReservedGraphDefinitionDomain


pure func typecheck_state_from_infer_session(session: InferSession) -> TypecheckState:
	{
		context = session.context,
		env = session.env,
		errors = session.errors,
		diagnostics = session.diagnostics,
		module_view = session.facts.module_view,
		graph_import_admission = None,
		module_scope = session.facts.module_scope,
		allow_debug_only_calls = session.facts.allow_debug_only_calls,
		private_impls = session.facts.private_impls,
		known_type_index = session.facts.known_type_index,
		scoped_trait_functions = session.facts.scoped_trait_functions,
		type_homes = session.facts.type_homes,
		type_shape_memo = session.type_shape_memo,
		source_table = session.facts.source_table
	}


pure func typecheck_module_scope_is_source_package(scope: TypecheckModuleScope) -> Bool:
	module_origin_is_source_package(typecheck_module_scope_origin(scope))
