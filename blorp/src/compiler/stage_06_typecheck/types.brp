-- Source type-expression projection for the Blorp-owned typecheck pass.
--
-- This is the narrow boundary from parsed source syntax to the semantic
-- SemanticType model. Name resolution, alias expansion, and owner qualification
-- remain in type_resolution.brp.
import:
	../stage_02_lex/name_table: NAME_ID_SELF_TYPE, name_ids_equal
	../stage_03_parse/parsed_ast:
		ParsedDimBinaryOp(
			ParsedDimAddOp, ParsedDimDivideOp, ParsedDimMultiplyOp, ParsedDimSubtractOp,
		),
		ParsedTypeExpr(
			ParsedArrayType, ParsedBoundedType, ParsedDimBinaryType, ParsedDimLiteralType,
			ParsedDimNameType, ParsedFunctionType, ParsedMissingType, ParsedNamedType,
			ParsedQualifiedNamedType, ParsedRangeType, ParsedTupleType,
		),
		ParsedTypeParamDecl,
	type_system/semantic_type:
		SemanticDimOp(SemanticDimAdd, SemanticDimDivide, SemanticDimMultiply, SemanticDimSubtract),
		SemanticType(
			SemanticArrayType, SemanticConstIntType, SemanticDimOpType, SemanticFunctionType,
			SemanticNamedType, SemanticRangeType, SemanticSelfType, SemanticTupleType,
			SemanticTypeVar, SemanticVarDimsType,
		),
		SemanticTypeVarKind(SemanticDimensionParameter, SemanticTypeParameter),
		TYPE_VOID,
		qualified_type_name,


pure func type_param_name(param: ParsedTypeParamDecl) -> String:
	param.name.text


pure func type_param_names(params: List[ParsedTypeParamDecl]) -> List[String]:
	params.map(type_param_name)


private pure func dim_op_from_parsed(op: ParsedDimBinaryOp) -> SemanticDimOp:
	match op:
		ParsedDimAddOp:
			SemanticDimAdd
		ParsedDimSubtractOp:
			SemanticDimSubtract
		ParsedDimMultiplyOp:
			SemanticDimMultiply
		ParsedDimDivideOp:
			SemanticDimDivide


pure func type_from_parsed_type_expr(type_expr: ParsedTypeExpr) -> SemanticType:
	match type_expr:
		ParsedNamedType(name, args, _):
			if name_ids_equal(name.name, NAME_ID_SELF_TYPE) and args.length() == 0:
				SemanticSelfType
			else:
				SemanticNamedType(
					name.text,
					args.map(type_from_parsed_type_expr),
				)
		ParsedQualifiedNamedType(qualifier, name, args, _):
			SemanticNamedType(
				qualified_type_name(qualifier.text, name.text),
				args.map(type_from_parsed_type_expr),
			)
		ParsedBoundedType(name, _, _):
			SemanticTypeVar(name.text, SemanticTypeParameter)
		ParsedDimNameType(name, is_variadic, _):
			if is_variadic:
				SemanticVarDimsType(name.text)
			else:
				SemanticTypeVar(name.text, SemanticDimensionParameter)
		ParsedDimLiteralType(value, _):
			match value.parse_int():
				Some(number):
					SemanticConstIntType(number)
				None:
					SemanticConstIntType(0)
		ParsedDimBinaryType(op, left, right, _):
			SemanticDimOpType(
				dim_op_from_parsed(op),
				type_from_parsed_type_expr(left),
				type_from_parsed_type_expr(right),
			)
		ParsedRangeType(inner, _):
			SemanticRangeType(type_from_parsed_type_expr(inner))
		ParsedTupleType(items, _):
			SemanticTupleType(items.map(type_from_parsed_type_expr))
		ParsedFunctionType(is_pure, params, return_type, _):
			SemanticFunctionType(
				is_pure,
				params.map(type_from_parsed_type_expr),
				type_from_parsed_type_expr(return_type),
			)
		ParsedArrayType(element, dims, _):
			SemanticArrayType(
				type_from_parsed_type_expr(element),
				dims.map(type_from_parsed_type_expr),
			)
		ParsedMissingType(_):
			TYPE_VOID
