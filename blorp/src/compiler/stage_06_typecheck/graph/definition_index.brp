-- Canonical graph definition table with owner-directed name indexes.
--
-- DefinitionIndex owns the immutable table, ordered ID-only lookup buckets,
-- counts, and dense allocation frontier as one value. Callers can query or
-- append through operations that preserve those facts; they cannot construct
-- mismatched rows, maps, and counters directly.
import:
	../../../lib/source: SourceSpan, source_spans_equal
	../../stage_03_parse/parsed_ast:
		ParsedDecl(
			BuiltinTypeParsedDecl,
			ForeignBlockParsedDecl,
			FunctionParsedDecl,
			ImplParsedDecl,
			ImportBlockParsedDecl,
			PrivateParsedDecl,
			RecordParsedDecl,
			TraitParsedDecl,
			TypeAliasParsedDecl,
			UnionParsedDecl,
			VarParsedDecl,
		),
		ParsedForeignFunctionDecl,
		ParsedFunctionDecl,
		ParsedImplDecl,
		ParsedImportDecl,
		ParsedImportSymbol,
		ParsedProgram,
	../../stage_04_modules/loaded_module:
		LoadedModule,
		LoadedModuleSet,
		loaded_module_canonical_path,
		loaded_module_origin,
		loaded_module_program,
		loaded_module_set_modules,
		loaded_module_set_target,
	../../stage_04_modules/module_surface:
		ModuleSurface,
		ModuleSurfaceSymbol,
		ModuleSurfaceSymbolKind(
			FunctionSurfaceSymbol,
			ImplMethodSurfaceSymbol,
			RecordSurfaceSymbol,
			TraitMethodSurfaceSymbol,
			TraitSurfaceSymbol,
			TypeAliasSurfaceSymbol,
			TypeSurfaceSymbol,
			VariableSurfaceSymbol,
		),
		module_surface_symbols_with_spans,
	../../stage_04_modules/module_table:
		ModuleId,
		ModuleTable,
		module_id_table_index,
		module_ids_equal,
		module_table_canonical_path,
		module_table_count,
		module_table_find_id,
		module_table_find_id_by_canonical_path,
		module_table_id_at,
		module_table_resolved_identity,
		module_tables_are_compatible,
	../type_system/builtins:
		builtin_trait_is_prelude,
		env_with_builtins,
		prelude_traits_module_matches,
	../type_system/env: Env
	definition_identity:
		FuncCallableKey,
		SourceDefinitionKey,
		SourceDefinitionKind(
			ConstructorDefinition,
			FieldDefinition,
			GlobalDefinition,
			ImplDefinition,
			TraitDefinition,
			TypeDefinition,
		),
		func_callable_key,
		func_callable_key_description,
		func_callable_key_module_id,
		func_callable_key_name,
		func_callable_key_span,
		source_definition_key,
		source_definition_key_description,
		source_definition_key_kind,
		source_definition_key_module_id,
		source_definition_key_name,
		source_definition_key_owner,
		source_definition_key_span,
	list: repeat
	set: Set


opaque type DefinitionIndexSeed = Int

opaque type DefinitionId = Int

opaque type FieldId = Int

-- Typed nodes need to distinguish a graph field from tuple, module-qualified,
-- synthetic, and recovery selections. Keep that state in one checked scalar:
-- Option[FieldId] is aggregate-shaped inside records and union variants today,
-- so storing it directly would allocate a box for every field occurrence.
opaque type ResolvedFieldIdentity = Int

private MISSING_RESOLVED_FIELD_IDENTITY_VALUE: Int = -1

MISSING_RESOLVED_FIELD_IDENTITY: ResolvedFieldIdentity = into_opaque ResolvedFieldIdentity(
	MISSING_RESOLVED_FIELD_IDENTITY_VALUE
)


enum DefinitionKind:
	CallableDefinitionKind
	TypeDefinitionKind
	ConstructorDefinitionKind
	FieldDefinitionKind
	GlobalDefinitionKind
	TraitDefinitionKind
	ImplementationDefinitionKind


record DefinitionRow {
	module_id: ModuleId,
	kind: DefinitionKind,
	name: String,
	owner_name: Option[String],
	span: SourceSpan
}


private type alias FuncCallableNameBuckets = Dict[String, List[DefinitionId]]

private type alias SourceDefinitionNameBuckets = Dict[String, List[DefinitionId]]


private record ExportedDefinitionTarget {
	symbol: ModuleSurfaceSymbol,
	definition_ids: List[DefinitionId]
}


private type alias ExportedDefinitionTargetBuckets = Dict[String, ExportedDefinitionTarget]

opaque type ExportedDefinitionTargets = ExportedDefinitionTargetBuckets

EXPORTED_DEFINITION_TARGETS_EMPTY: ExportedDefinitionTargets = into_opaque ExportedDefinitionTargets(
	{}
)


pure func exported_definition_targets_find(
	targets: ExportedDefinitionTargets,
	name: String,
) -> Option[(ModuleSurfaceSymbol, List[DefinitionId])]:
	representation: ExportedDefinitionTargetBuckets = from_opaque ExportedDefinitionTargets(targets)
	representation
		.get(name)
		.map(func(target): (target.symbol, target.definition_ids))


private record DefinitionTableRep {
	module_table: ModuleTable,
	first_graph_definition_id: Int,
	rows: List[DefinitionRow]
}


opaque type DefinitionTable = DefinitionTableRep


foreign(include: "definition_index_ffi.h"):
	private pure func definition_tables_are_same_allocation(
		left: DefinitionTable,
		right: DefinitionTable,
	) -> Bool = "blorp_compiler_definition_tables_are_same_allocation"


union DefinitionIndexBindingKey:
	FuncCallableBindingKey(FuncCallableKey)
	SourceDefinitionBindingKey(SourceDefinitionKey)


union DefinitionIndexConflict:
	DefinitionKeyAlreadyAssigned(DefinitionIndexBindingKey, Int, Int)
	DefinitionIdBelowAllocationFrontier(Int, Int, DefinitionIndexBindingKey)
	DefinitionIdAboveAllocationFrontier(Int, Int, DefinitionIndexBindingKey)
	IncompatibleDefinitionModuleTable


private record DefinitionIndexRep {
	definition_table: DefinitionTable,
	func_callable_ids_by_module_and_name: List[FuncCallableNameBuckets],
	source_definition_ids_by_module_and_name: List[SourceDefinitionNameBuckets],
	func_callable_id_count: Int,
	source_definition_id_count: Int,
	next_def_id: Int
}


-- Construction owns the mutable-by-COW row and index accumulators until one
-- final DefinitionTable is frozen. No persistent index competes for the row
-- list while later modules append to it.
private record DefinitionIndexBuildState {
	module_table: ModuleTable,
	func_callable_ids_by_module_and_name: List[FuncCallableNameBuckets],
	source_definition_ids_by_module_and_name: List[SourceDefinitionNameBuckets],
	first_graph_definition_id: Int,
	definition_rows: List[DefinitionRow],
	func_callable_id_count: Int,
	source_definition_id_count: Int,
	next_def_id: Int
}


opaque type DefinitionIndex = DefinitionIndexRep


private record DefinitionIndexBootstrapRep {
	env: Env,
	seed: DefinitionIndexSeed
}


opaque type DefinitionIndexBootstrap = DefinitionIndexBootstrapRep


-- Defaults remain associated with the trait that declared them. Keeping this
-- catalog module-qualified prevents an unrelated trait from creating phantom
-- callable IDs at every implementation span.
private enum TraitDefaultsModuleKind:
	OrdinaryTraitDefaultsModule
	PreludeTraitDefaultsModule


private record TraitDefaultMethods {
	module_id: ModuleId,
	canonical_path: String,
	module_kind: TraitDefaultsModuleKind,
	trait_name: String,
	method_names: List[String]
}


private record ImportedTraitReference {
	canonical_path: String,
	trait_name: String
}


private pure func definition_index_bootstrap_rep(
	bootstrap: DefinitionIndexBootstrap,
) -> DefinitionIndexBootstrapRep:
	from_opaque DefinitionIndexBootstrap(bootstrap)


pure func definition_id_runtime_value(id: DefinitionId) -> Int:
	from_opaque DefinitionId(id)


pure func definition_ids_equal(left: DefinitionId, right: DefinitionId) -> Bool:
	definition_id_runtime_value(left) == definition_id_runtime_value(right)


private pure func definition_id(value: Int) -> DefinitionId:
	into_opaque DefinitionId(value)


-- Reserved graph authorities receive their IDs from this index after exact
-- key/category validation. This projection preserves that already-proved
-- identity without repeating a managed table lookup at every typed use.
pure func definition_id_from_reserved_graph(value: Int) -> DefinitionId:
	definition_id(value)


private pure func definition_kind_for_source(kind: SourceDefinitionKind) -> DefinitionKind:
	match kind:
		TypeDefinition:
			TypeDefinitionKind
		ConstructorDefinition:
			ConstructorDefinitionKind
		FieldDefinition:
			FieldDefinitionKind
		GlobalDefinition:
			GlobalDefinitionKind
		TraitDefinition:
			TraitDefinitionKind
		ImplDefinition:
			ImplementationDefinitionKind


private pure func definition_source_kind(kind: DefinitionKind) -> Option[SourceDefinitionKind]:
	match kind:
		CallableDefinitionKind:
			None
		TypeDefinitionKind:
			Some(TypeDefinition)
		ConstructorDefinitionKind:
			Some(ConstructorDefinition)
		FieldDefinitionKind:
			Some(FieldDefinition)
		GlobalDefinitionKind:
			Some(GlobalDefinition)
		TraitDefinitionKind:
			Some(TraitDefinition)
		ImplementationDefinitionKind:
			Some(ImplDefinition)


private pure func definition_row_for_func_callable_key(key: FuncCallableKey) -> DefinitionRow:
	{
		module_id = func_callable_key_module_id(key),
		kind = CallableDefinitionKind,
		name = func_callable_key_name(key),
		owner_name = None,
		span = func_callable_key_span(key)
	}


private pure func definition_row_for_source_key(key: SourceDefinitionKey) -> DefinitionRow:
	{
		module_id = source_definition_key_module_id(key),
		kind = definition_kind_for_source(source_definition_key_kind(key)),
		name = source_definition_key_name(key),
		owner_name = source_definition_key_owner(key),
		span = source_definition_key_span(key)
	}


private pure func definition_row_matches_func_callable_key(
	row: DefinitionRow,
	key: FuncCallableKey,
) -> Bool:
	(
		row.kind == CallableDefinitionKind
		and module_ids_equal(row.module_id, func_callable_key_module_id(key))
		and row.name == func_callable_key_name(key)
		and row.owner_name.is_none()
		and source_spans_equal(row.span, func_callable_key_span(key))
	)


private pure func definition_row_matches_source_key(
	row: DefinitionRow,
	key: SourceDefinitionKey,
) -> Bool:
	(
		row.kind == definition_kind_for_source(source_definition_key_kind(key))
		and module_ids_equal(row.module_id, source_definition_key_module_id(key))
		and row.name == source_definition_key_name(key)
		and row.owner_name == source_definition_key_owner(key)
		and source_spans_equal(row.span, source_definition_key_span(key))
	)


private pure func definition_source_key_for_row(row: DefinitionRow) -> Option[SourceDefinitionKey]:
	kind ?= definition_source_kind(row.kind)
	Some(source_definition_key(row.module_id, kind, row.name, row.owner_name, row.span))


private pure func definition_index_rep_row(
	index: DefinitionIndexRep,
	id: DefinitionId,
) -> Option[DefinitionRow]:
	definition_table_rep_row(definition_table_rep(index.definition_table), id)


private pure func definition_table_rep(table: DefinitionTable) -> DefinitionTableRep:
	from_opaque DefinitionTable(table)


private pure func definition_table_rep_row(
	table: DefinitionTableRep,
	id: DefinitionId,
) -> Option[DefinitionRow]:
	raw_id = definition_id_runtime_value(id)
	row_index = raw_id - table.first_graph_definition_id

	if row_index < 0:
		None
	else:
		table.rows.get(row_index)


pure func definition_index_definition_table(index: DefinitionIndex) -> DefinitionTable:
	representation: DefinitionIndexRep = from_opaque DefinitionIndex(index)
	representation.definition_table


pure func definition_table_definition_id(
	table: DefinitionTable,
	runtime_definition_id: Int,
) -> Option[DefinitionId]:
	representation = definition_table_rep(table)
	id = definition_id(runtime_definition_id)

	match definition_table_rep_row(representation, id):
		Some(_):
			Some(id)
		None:
			None


pure func definition_table_row(table: DefinitionTable, id: DefinitionId) -> Option[DefinitionRow]:
	definition_table_rep_row(definition_table_rep(table), id)


pure func definition_table_module_id(table: DefinitionTable, id: DefinitionId) -> Option[ModuleId]:
	definition_table_row(table, id).map(func(row): row.module_id)


private pure func definition_table_id_with_kind(
	table: DefinitionTable,
	runtime_definition_id: Int,
	expected_kind: DefinitionKind,
) -> Option[DefinitionId]:
	id = definition_id(runtime_definition_id)
	row ?= definition_table_rep_row(definition_table_rep(table), id)

	if row.kind == expected_kind:
		Some(id)
	else:
		None


private pure func definition_table_row_with_kind(
	table: DefinitionTable,
	runtime_definition_id: Int,
	expected_kind: DefinitionKind,
) -> Option[DefinitionRow]:
	id = definition_id(runtime_definition_id)
	row ?= definition_table_rep_row(definition_table_rep(table), id)

	if row.kind == expected_kind:
		Some(row)
	else:
		None


pure func definition_table_callable_definition_id(
	table: DefinitionTable,
	runtime_definition_id: Int,
) -> Option[DefinitionId]:
	definition_table_id_with_kind(table, runtime_definition_id, CallableDefinitionKind)


pure func definition_table_constructor_definition_id(
	table: DefinitionTable,
	runtime_definition_id: Int,
) -> Option[DefinitionId]:
	definition_table_id_with_kind(table, runtime_definition_id, ConstructorDefinitionKind)


pure func definition_table_type_definition_id(
	table: DefinitionTable,
	runtime_definition_id: Int,
) -> Option[DefinitionId]:
	definition_table_id_with_kind(table, runtime_definition_id, TypeDefinitionKind)


pure func definition_table_global_definition_id(
	table: DefinitionTable,
	runtime_definition_id: Int,
) -> Option[DefinitionId]:
	definition_table_id_with_kind(table, runtime_definition_id, GlobalDefinitionKind)


pure func definition_table_trait_definition_id(
	table: DefinitionTable,
	runtime_definition_id: Int,
) -> Option[DefinitionId]:
	definition_table_id_with_kind(table, runtime_definition_id, TraitDefinitionKind)


pure func definition_table_implementation_definition_id(
	table: DefinitionTable,
	runtime_definition_id: Int,
) -> Option[DefinitionId]:
	definition_table_id_with_kind(table, runtime_definition_id, ImplementationDefinitionKind)


pure func definition_table_field_id(
	table: DefinitionTable,
	runtime_definition_id: Int,
) -> Option[FieldId]:
	match definition_table_id_with_kind(table, runtime_definition_id, FieldDefinitionKind):
		Some(id):
			Some(into_opaque FieldId(definition_id_runtime_value(id)))
		None:
			None


pure func field_id_definition_id(id: FieldId) -> Int:
	from_opaque FieldId(id)


pure func field_ids_equal(left: FieldId, right: FieldId) -> Bool:
	field_id_definition_id(left) == field_id_definition_id(right)


pure func resolved_field_identity(id: FieldId) -> ResolvedFieldIdentity:
	into_opaque ResolvedFieldIdentity(field_id_definition_id(id))


pure func resolved_field_identity_from_optional_id(id: Option[FieldId]) -> ResolvedFieldIdentity:
	match id:
		Some(found):
			resolved_field_identity(found)
		None:
			MISSING_RESOLVED_FIELD_IDENTITY


pure func resolved_field_identity_field_id(identity: ResolvedFieldIdentity) -> Option[FieldId]:
	value = from_opaque ResolvedFieldIdentity(identity)

	if value == MISSING_RESOLVED_FIELD_IDENTITY_VALUE:
		None
	else:
		Some(into_opaque FieldId(value))


pure func definition_table_callable_row(
	table: DefinitionTable,
	runtime_definition_id: Int,
) -> Option[DefinitionRow]:
	definition_table_row_with_kind(table, runtime_definition_id, CallableDefinitionKind)


pure func definition_table_constructor_row(
	table: DefinitionTable,
	runtime_definition_id: Int,
) -> Option[DefinitionRow]:
	definition_table_row_with_kind(table, runtime_definition_id, ConstructorDefinitionKind)


pure func definition_table_type_row(
	table: DefinitionTable,
	runtime_definition_id: Int,
) -> Option[DefinitionRow]:
	definition_table_row_with_kind(table, runtime_definition_id, TypeDefinitionKind)


pure func definition_table_global_row(
	table: DefinitionTable,
	runtime_definition_id: Int,
) -> Option[DefinitionRow]:
	definition_table_row_with_kind(table, runtime_definition_id, GlobalDefinitionKind)


pure func definition_table_trait_row(
	table: DefinitionTable,
	runtime_definition_id: Int,
) -> Option[DefinitionRow]:
	definition_table_row_with_kind(table, runtime_definition_id, TraitDefinitionKind)


pure func definition_table_implementation_row(
	table: DefinitionTable,
	runtime_definition_id: Int,
) -> Option[DefinitionRow]:
	definition_table_row_with_kind(table, runtime_definition_id, ImplementationDefinitionKind)


pure func definition_table_field_row(table: DefinitionTable, id: FieldId) -> Option[DefinitionRow]:
	definition_table_row_with_kind(table, field_id_definition_id(id), FieldDefinitionKind)


pure func definition_table_module_table(table: DefinitionTable) -> ModuleTable:
	definition_table_rep(table).module_table


pure func definition_table_is_compatible_with_module_table(
	table: DefinitionTable,
	module_table: ModuleTable,
) -> Bool:
	module_tables_are_compatible(definition_table_module_table(table), module_table)


-- CTFE phase products must share the exact frozen definition authority. This
-- O(1) provenance check avoids rescanning all rows once per imported module.
pure func definition_tables_share_provenance(left: DefinitionTable, right: DefinitionTable) -> Bool:
	definition_tables_are_same_allocation(left, right)


pure func definition_tables_are_compatible(left: DefinitionTable, right: DefinitionTable) -> Bool:
	left_rep = definition_table_rep(left)
	right_rep = definition_table_rep(right)
	var compatible = (
		left_rep.first_graph_definition_id == right_rep.first_graph_definition_id
		and left_rep.rows.length() == right_rep.rows.length()
		and module_tables_are_compatible(left_rep.module_table, right_rep.module_table)
	)

	var index: Int = 0

	while compatible and index < left_rep.rows.length():
		match (left_rep.rows.get(index), right_rep.rows.get(index)):
			(Some(left_row), Some(right_row)):
				compatible = (
					module_ids_equal(left_row.module_id, right_row.module_id)
					and left_row.kind == right_row.kind
					and left_row.name == right_row.name
					and left_row.owner_name == right_row.owner_name
					and source_spans_equal(left_row.span, right_row.span)
				)
			_:
				compatible = False

		index += 1

	compatible


pure func definition_table_definition_count(table: DefinitionTable) -> Int:
	definition_table_rep(table).rows.length()


private pure func definition_index_seed_from_env(env: Env) -> DefinitionIndexSeed:
	into_opaque DefinitionIndexSeed(env.next_def_id)


pure func definition_index_initial_seed(base_env: Env) -> DefinitionIndexSeed:
	definition_index_seed_from_env(env_with_builtins(base_env))


pure func definition_index_seed_next_def_id(seed: DefinitionIndexSeed) -> Int:
	from_opaque DefinitionIndexSeed(seed)


private pure func definition_index_rep_empty(
	seed: DefinitionIndexSeed,
	module_table: ModuleTable,
) -> DefinitionIndexRep:
	module_count = module_table_count(module_table)
	empty_func_buckets: FuncCallableNameBuckets = {}
	empty_source_buckets: SourceDefinitionNameBuckets = {}
	first_graph_definition_id = definition_index_seed_next_def_id(seed)
	{
		definition_table = into_opaque DefinitionTable({
				module_table = module_table,
				first_graph_definition_id = first_graph_definition_id,
				rows = []
			}),
		func_callable_ids_by_module_and_name = empty_func_buckets.repeat(module_count),
		source_definition_ids_by_module_and_name = empty_source_buckets.repeat(module_count),
		func_callable_id_count = 0,
		source_definition_id_count = 0,
		next_def_id = first_graph_definition_id
	}


private pure func definition_index_build_empty(
	seed: DefinitionIndexSeed,
	module_table: ModuleTable,
) -> DefinitionIndexBuildState:
	module_count = module_table_count(module_table)
	empty_func_buckets: FuncCallableNameBuckets = {}
	empty_source_buckets: SourceDefinitionNameBuckets = {}
	first_graph_definition_id = definition_index_seed_next_def_id(seed)
	{
		module_table = module_table,
		func_callable_ids_by_module_and_name = empty_func_buckets.repeat(module_count),
		source_definition_ids_by_module_and_name = empty_source_buckets.repeat(module_count),
		first_graph_definition_id = first_graph_definition_id,
		definition_rows = [],
		func_callable_id_count = 0,
		source_definition_id_count = 0,
		next_def_id = first_graph_definition_id
	}


private pure func definition_index_from_build(build: DefinitionIndexBuildState) -> DefinitionIndex:
	representation: DefinitionIndexRep = {
		definition_table = into_opaque DefinitionTable({
				module_table = build.module_table,
				first_graph_definition_id = build.first_graph_definition_id,
				rows = build.definition_rows
			}),
		func_callable_ids_by_module_and_name = build.func_callable_ids_by_module_and_name,
		source_definition_ids_by_module_and_name = build.source_definition_ids_by_module_and_name,
		func_callable_id_count = build.func_callable_id_count,
		source_definition_id_count = build.source_definition_id_count,
		next_def_id = build.next_def_id
	}
	into_opaque DefinitionIndex(representation)


pure func definition_index_empty(
	seed: DefinitionIndexSeed,
	module_table: ModuleTable,
) -> DefinitionIndex:
	into_opaque DefinitionIndex(definition_index_rep_empty(seed, module_table))


pure func definition_index_bootstrap_from_base_env(base_env: Env) -> DefinitionIndexBootstrap:
	env = env_with_builtins(base_env)
	representation: DefinitionIndexBootstrapRep = {
		env = env,
		seed = definition_index_seed_from_env(env)
	}
	into_opaque DefinitionIndexBootstrap(representation)


pure func definition_index_bootstrap_env(bootstrap: DefinitionIndexBootstrap) -> Env:
	representation = definition_index_bootstrap_rep(bootstrap)
	representation.env


pure func definition_index_bootstrap_seed(
	bootstrap: DefinitionIndexBootstrap,
) -> DefinitionIndexSeed:
	representation = definition_index_bootstrap_rep(bootstrap)
	representation.seed


private pure func definition_index_module_name(
	index: DefinitionIndexRep,
	module_id: ModuleId,
) -> String:
	module_table_canonical_path(
		definition_table_module_table(index.definition_table),
		module_id,
	).get_or("<unknown-module>")


private pure func definition_index_rendered_module_name(
	index: DefinitionIndexRep,
	module_id: ModuleId,
	override: Option[(ModuleId, String)],
) -> String:
	match override:
		Some((override_id, name)):
			if module_ids_equal(module_id, override_id):
				name
			else:
				definition_index_module_name(index, module_id)
		None:
			definition_index_module_name(index, module_id)


private pure func definition_binding_key_description(
	index: DefinitionIndexRep,
	key: DefinitionIndexBindingKey,
	module_name_override: Option[(ModuleId, String)],
) -> String:
	match key:
		FuncCallableBindingKey(callable_key):
			func_callable_key_description(
				callable_key,
				definition_index_rendered_module_name(
					index,
					func_callable_key_module_id(callable_key),
					module_name_override,
				),
			)
		SourceDefinitionBindingKey(source_key):
			source_definition_key_description(
				source_key,
				definition_index_rendered_module_name(
					index,
					source_definition_key_module_id(source_key),
					module_name_override,
				),
			)


private pure func definition_index_conflict_message_with_override(
	index: DefinitionIndex,
	conflict: DefinitionIndexConflict,
	module_name_override: Option[(ModuleId, String)],
) -> String:
	representation: DefinitionIndexRep = from_opaque DefinitionIndex(index)

	match conflict:
		DefinitionKeyAlreadyAssigned(key, existing_id, requested_id):
			"definition index conflict: " + definition_binding_key_description(
				representation,
				key,
				module_name_override,
			) + " already maps to definition ID " + existing_id.to_string() + "; cannot remap it to definition ID " + requested_id.to_string()
		DefinitionIdBelowAllocationFrontier(def_id, frontier, requested_key):
			"definition index conflict: definition ID " + def_id.to_string() + " is below allocation frontier " + frontier.to_string() + "; cannot assign it to " + definition_binding_key_description(
				representation,
				requested_key,
				module_name_override,
			)
		DefinitionIdAboveAllocationFrontier(def_id, frontier, requested_key):
			"definition index conflict: definition ID " + def_id.to_string() + " is above allocation frontier " + frontier.to_string() + "; cannot assign it to " + definition_binding_key_description(
				representation,
				requested_key,
				module_name_override,
			)
		IncompatibleDefinitionModuleTable:
			"definition index conflict: module ID was issued by an incompatible module table"


pure func definition_index_conflict_message(
	index: DefinitionIndex,
	conflict: DefinitionIndexConflict,
) -> String:
	definition_index_conflict_message_with_override(index, conflict, None)


pure func definition_index_conflict_message_for_module(
	index: DefinitionIndex,
	conflict: DefinitionIndexConflict,
	module_id: ModuleId,
	module_name: String,
) -> String:
	definition_index_conflict_message_with_override(index, conflict, Some((module_id, module_name)))


private pure func definition_build_row(
	definition_rows: List[DefinitionRow],
	first_graph_definition_id: Int,
	module_rows: List[DefinitionRow],
	first_module_definition_id: Int,
	id: DefinitionId,
) -> Option[DefinitionRow]:
	raw_id = definition_id_runtime_value(id)

	if raw_id < first_module_definition_id:
		definition_rows.get(raw_id - first_graph_definition_id)
	else:
		module_rows.get(raw_id - first_module_definition_id)


private pure func definition_module_find_row_id(
	definition_rows: List[DefinitionRow],
	first_graph_definition_id: Int,
	module_rows: List[DefinitionRow],
	first_module_definition_id: Int,
	ids: List[DefinitionId],
	requested: DefinitionRow,
) -> Option[DefinitionId]:
	var result: Option[DefinitionId] = None

	for id in ids:
		match definition_build_row(
			definition_rows,
			first_graph_definition_id,
			module_rows,
			first_module_definition_id,
			id,
		):
			Some(row):
				if (
					row.kind == requested.kind
					and module_ids_equal(row.module_id, requested.module_id)
					and row.name == requested.name
					and row.owner_name == requested.owner_name
					and source_spans_equal(row.span, requested.span)
				):
					result = Some(id)
					break
			None:
				void

	result


private pure func definition_index_reserve_program_parts(
	module_table: ModuleTable,
	func_callable_ids_by_module_and_name: List[FuncCallableNameBuckets],
	source_definition_ids_by_module_and_name: List[SourceDefinitionNameBuckets],
	first_graph_definition_id: Int,
	definition_rows: List[DefinitionRow],
	func_callable_id_count: Int,
	source_definition_id_count: Int,
	next_def_id: Int,
	module_id: ModuleId,
	trait_defaults: List[TraitDefaultMethods],
	program: ParsedProgram,
) -> DefinitionIndexBuildState:
	module_index = module_id_table_index(module_id)
	var func_ids = func_callable_ids_by_module_and_name.get_or(module_index, {})
	var source_ids = source_definition_ids_by_module_and_name.get_or(module_index, {})
	var module_rows: List[DefinitionRow] = []
	var accepted_rows: List[DefinitionRow] = []
	var current_func_count = func_callable_id_count
	var current_source_count = source_definition_id_count
	var current_next_def_id = next_def_id

	for decl in program.decls:
		module_rows = definition_rows_for_decl(
			module_rows,
			module_id,
			trait_defaults,
			program,
			decl,
		)

	for row in module_rows:
		ids = if row.kind == CallableDefinitionKind:
			func_ids.get_or(row.name, [])
		else:
			source_ids.get_or(row.name, [])

		existing_id = definition_module_find_row_id(
			definition_rows,
			first_graph_definition_id,
			accepted_rows,
			next_def_id,
			ids,
			row,
		)

		if existing_id.is_none():
			id = definition_id(current_next_def_id)

			if row.kind == CallableDefinitionKind:
				func_ids = func_ids.set(
					row.name,
					ids.append(id),
				)
				current_func_count += 1
			else:
				source_ids = source_ids.set(
					row.name,
					ids.append(id),
				)
				current_source_count += 1

			accepted_rows = accepted_rows.append(row)
			current_next_def_id += 1

	{
		module_table = module_table,
		func_callable_ids_by_module_and_name = func_callable_ids_by_module_and_name.set(
			module_index,
			func_ids,
		),
		source_definition_ids_by_module_and_name = source_definition_ids_by_module_and_name.set(
			module_index,
			source_ids,
		),
		first_graph_definition_id = first_graph_definition_id,
		definition_rows = definition_rows.concat(accepted_rows),
		func_callable_id_count = current_func_count,
		source_definition_id_count = current_source_count,
		next_def_id = current_next_def_id
	}


private pure func definition_index_rep_find_func_callable_id(
	index: DefinitionIndexRep,
	key: FuncCallableKey,
) -> Option[Int]:
	var result: Option[Int] = None
	module_index = module_id_table_index(func_callable_key_module_id(key))
	name = func_callable_key_name(key)
	entries = index.func_callable_ids_by_module_and_name
		.get_or(module_index, {})
		.get_or(name, [])

	-- Display name and declaration name are only search accelerators. Exact
	-- equality keeps direct-module collisions and overloads distinct.
	for id in entries:
		match definition_index_rep_row(index, id):
			Some(row):
				if definition_row_matches_func_callable_key(row, key):
					result = Some(definition_id_runtime_value(id))
					break
			None:
				void

	result


private pure func definition_index_binding_conflict(
	index: DefinitionIndexRep,
	key: DefinitionIndexBindingKey,
	existing_id: Option[Int],
	def_id: Int,
) -> Option[DefinitionIndexConflict]:
	table = definition_table_rep(index.definition_table)
	row_frontier = table.first_graph_definition_id + table.rows.length()

	match existing_id:
		Some(existing_id):
			if existing_id == def_id:
				None
			else:
				Some(DefinitionKeyAlreadyAssigned(key, existing_id, def_id))
		None:
			if def_id < index.next_def_id:
				Some(DefinitionIdBelowAllocationFrontier(def_id, index.next_def_id, key))
			else if def_id > row_frontier:
				Some(DefinitionIdAboveAllocationFrontier(def_id, row_frontier, key))
			else:
				None


private pure func definition_index_add_func_callable_id(
	index: DefinitionIndexRep,
	key: FuncCallableKey,
	def_id: Int,
) -> DefinitionIndexRep:
	id = definition_id(def_id)
	table = definition_table_rep(index.definition_table)
	row = definition_row_for_func_callable_key(key)
	module_index = module_id_table_index(func_callable_key_module_id(key))
	name = func_callable_key_name(key)
	name_buckets = index.func_callable_ids_by_module_and_name.get_or(module_index, {})
	{ index |
		func_callable_ids_by_module_and_name = index.func_callable_ids_by_module_and_name.set(
			module_index,
			name_buckets.set(
				name,
				name_buckets
					.get_or(name, [])
					.append(id),
			),
		),
		definition_table = into_opaque DefinitionTable({ table | rows = table.rows.append(row) }),
		func_callable_id_count = index.func_callable_id_count + 1,
		next_def_id = def_id + 1
	}


pure func definition_index_insert_func_callable_id(
	index: DefinitionIndex,
	issuing_table: ModuleTable,
	key: FuncCallableKey,
	def_id: Int,
) -> Result[DefinitionIndex, DefinitionIndexConflict]:
	representation: DefinitionIndexRep = from_opaque DefinitionIndex(index)
	binding_key = FuncCallableBindingKey(key)

	if not module_tables_are_compatible(
		definition_table_module_table(representation.definition_table),
		issuing_table,
	):
		Err(IncompatibleDefinitionModuleTable)
	else:
		existing_id = definition_index_rep_find_func_callable_id(representation, key)

		match definition_index_binding_conflict(representation, binding_key, existing_id, def_id):
			Some(conflict):
				Err(conflict)
			None:
				match existing_id:
					Some(_):
						Ok(index)
					None:
						updated = definition_index_add_func_callable_id(representation, key, def_id)
						Ok(into_opaque DefinitionIndex(updated))


pure func definition_index_find_func_callable_id(
	index: DefinitionIndex,
	issuing_table: ModuleTable,
	key: FuncCallableKey,
) -> Option[Int]:
	representation: DefinitionIndexRep = from_opaque DefinitionIndex(index)

	if module_tables_are_compatible(
		definition_table_module_table(representation.definition_table),
		issuing_table,
	):
		definition_index_rep_find_func_callable_id(representation, key)
	else:
		None


-- Callable identity is published as the table-issued scalar. Raw integer
-- projections remain available to declaration categories that have not yet
-- migrated to DefinitionId-backed identities.
pure func definition_index_find_func_callable(
	index: DefinitionIndex,
	issuing_table: ModuleTable,
	key: FuncCallableKey,
) -> Option[DefinitionId]:
	runtime_id ?= definition_index_find_func_callable_id(index, issuing_table, key)
	definition_table_callable_definition_id(definition_index_definition_table(index), runtime_id)


pure func definition_index_func_callable_bindings(
	index: DefinitionIndex,
	name: String,
) -> List[(FuncCallableKey, Int)]:
	representation: DefinitionIndexRep = from_opaque DefinitionIndex(index)
	var bindings: List[(FuncCallableKey, Int)] = []

	for name_buckets in representation.func_callable_ids_by_module_and_name:
		for id in name_buckets.get_or(name, []):
			match definition_index_rep_row(representation, id):
				Some(row):
					bindings = bindings.append(
						(
							func_callable_key(row.module_id, row.name, row.span),
							definition_id_runtime_value(id),
						),
					)
				None:
					void

	bindings.sort_by(func(binding): binding[1])


-- Deterministic complete projection for validation, diagnostics, and tooling.
-- Semantic lookup remains encapsulated by DefinitionIndex.
pure func definition_index_all_func_callable_bindings(
	index: DefinitionIndex,
) -> List[(FuncCallableKey, Int)]:
	representation: DefinitionIndexRep = from_opaque DefinitionIndex(index)
	var bindings: List[(FuncCallableKey, Int)] = []

	for name_buckets in representation.func_callable_ids_by_module_and_name:
		for entries in name_buckets.values():
			for id in entries:
				match definition_index_rep_row(representation, id):
					Some(row):
						bindings = bindings.append(
							(
								func_callable_key(row.module_id, row.name, row.span),
								definition_id_runtime_value(id),
							),
						)
					None:
						void

	bindings.sort_by(func(binding): binding[1])


pure func definition_index_func_callables_at_span(
	index: DefinitionIndex,
	issuing_table: ModuleTable,
	module_id: ModuleId,
	span: SourceSpan,
) -> List[(FuncCallableKey, Int)]:
	representation: DefinitionIndexRep = from_opaque DefinitionIndex(index)
	var bindings: List[(FuncCallableKey, Int)] = []

	if module_tables_are_compatible(
		definition_table_module_table(representation.definition_table),
		issuing_table,
	):
		for entries in (
			representation.func_callable_ids_by_module_and_name
				.get_or(module_id_table_index(module_id), {})
				.values()
		):
			for id in entries:
				match definition_index_rep_row(representation, id):
					Some(row):
						if (
							module_ids_equal(row.module_id, module_id)
							and source_spans_equal(row.span, span)
						):
							bindings = bindings.append(
								(
									func_callable_key(row.module_id, row.name, row.span),
									definition_id_runtime_value(id),
								),
							)
					None:
						void

	bindings.sort_by(func(binding): binding[1])


pure func definition_index_callable_definition_ids_at_span(
	index: DefinitionIndex,
	issuing_table: ModuleTable,
	module_id: ModuleId,
	span: SourceSpan,
) -> List[DefinitionId]:
	representation: DefinitionIndexRep = from_opaque DefinitionIndex(index)
	var ids: List[DefinitionId] = []

	if module_tables_are_compatible(
		definition_table_module_table(representation.definition_table),
		issuing_table,
	):
		for entries in (
			representation.func_callable_ids_by_module_and_name
				.get_or(module_id_table_index(module_id), {})
				.values()
		):
			for id in entries:
				match definition_index_rep_row(representation, id):
					Some(row):
						if (
							module_ids_equal(row.module_id, module_id)
							and source_spans_equal(row.span, span)
						):
							ids = ids.append(id)
					None:
						void

	ids.sort_by(definition_id_runtime_value)


private pure func definition_index_rep_find_source_definition_id(
	index: DefinitionIndexRep,
	key: SourceDefinitionKey,
) -> Option[Int]:
	var result: Option[Int] = None
	module_index = module_id_table_index(source_definition_key_module_id(key))
	name = source_definition_key_name(key)
	entries = index.source_definition_ids_by_module_and_name
		.get_or(module_index, {})
		.get_or(name, [])

	for id in entries:
		match definition_index_rep_row(index, id):
			Some(row):
				if definition_row_matches_source_key(row, key):
					result = Some(definition_id_runtime_value(id))
					break
			None:
				void

	result


private pure func definition_index_add_source_definition_id(
	index: DefinitionIndexRep,
	key: SourceDefinitionKey,
	def_id: Int,
) -> DefinitionIndexRep:
	id = definition_id(def_id)
	table = definition_table_rep(index.definition_table)
	row = definition_row_for_source_key(key)
	module_index = module_id_table_index(source_definition_key_module_id(key))
	name = source_definition_key_name(key)
	name_buckets = index.source_definition_ids_by_module_and_name.get_or(module_index, {})
	{ index |
		source_definition_ids_by_module_and_name = index.source_definition_ids_by_module_and_name.set(
			module_index,
			name_buckets.set(
				name,
				name_buckets
					.get_or(name, [])
					.append(id),
			),
		),
		definition_table = into_opaque DefinitionTable({ table | rows = table.rows.append(row) }),
		source_definition_id_count = index.source_definition_id_count + 1,
		next_def_id = def_id + 1
	}


pure func definition_index_insert_source_definition_id(
	index: DefinitionIndex,
	issuing_table: ModuleTable,
	key: SourceDefinitionKey,
	def_id: Int,
) -> Result[DefinitionIndex, DefinitionIndexConflict]:
	representation: DefinitionIndexRep = from_opaque DefinitionIndex(index)
	binding_key = SourceDefinitionBindingKey(key)

	if not module_tables_are_compatible(
		definition_table_module_table(representation.definition_table),
		issuing_table,
	):
		Err(IncompatibleDefinitionModuleTable)
	else:
		existing_id = definition_index_rep_find_source_definition_id(representation, key)

		match definition_index_binding_conflict(representation, binding_key, existing_id, def_id):
			Some(conflict):
				Err(conflict)
			None:
				match existing_id:
					Some(_):
						Ok(index)
					None:
						updated = definition_index_add_source_definition_id(
							representation,
							key,
							def_id,
						)
						Ok(into_opaque DefinitionIndex(updated))


pure func definition_index_find_source_definition_id(
	index: DefinitionIndex,
	issuing_table: ModuleTable,
	key: SourceDefinitionKey,
) -> Option[Int]:
	representation: DefinitionIndexRep = from_opaque DefinitionIndex(index)

	if module_tables_are_compatible(
		definition_table_module_table(representation.definition_table),
		issuing_table,
	):
		definition_index_rep_find_source_definition_id(representation, key)
	else:
		None


private pure func definition_kind_for_surface_symbol(
	kind: ModuleSurfaceSymbolKind,
) -> Option[DefinitionKind]:
	match kind:
		FunctionSurfaceSymbol | ImplMethodSurfaceSymbol:
			Some(CallableDefinitionKind)
		VariableSurfaceSymbol:
			Some(GlobalDefinitionKind)
		TypeSurfaceSymbol | RecordSurfaceSymbol | TypeAliasSurfaceSymbol:
			Some(TypeDefinitionKind)
		TraitSurfaceSymbol:
			Some(TraitDefinitionKind)
		TraitMethodSurfaceSymbol:
			None


private pure func definition_index_ids_for_kind_and_name(
	index: DefinitionIndexRep,
	module_id: ModuleId,
	kind: DefinitionKind,
	name: String,
) -> List[DefinitionId]:
	if kind == CallableDefinitionKind:
		index.func_callable_ids_by_module_and_name
			.get_or(module_id_table_index(module_id), {})
			.get_or(name, [])
	else:
		index.source_definition_ids_by_module_and_name
			.get_or(module_id_table_index(module_id), {})
			.get_or(name, [])


private pure func exported_definition_targets_for_exports(
	representation: DefinitionIndexRep,
	module_id: ModuleId,
	program: ParsedProgram,
	surface: ModuleSurface,
	requested_exports: List[ModuleSurfaceSymbol],
) -> ExportedDefinitionTargets:
	var result: ExportedDefinitionTargetBuckets = {}

	for symbol in requested_exports:
		if not result.contains(symbol.name):
			result = result.set(
				symbol.name,
				{
					symbol = symbol,
					definition_ids = []
				},
			)

	requested_surface = { surface | exports = requested_exports }

	for pair in module_surface_symbols_with_spans(program, requested_surface):
		symbol = pair[0]
		expected_span = pair[1]

		match definition_kind_for_surface_symbol(symbol.kind):
			Some(expected_kind):
				for id in definition_index_ids_for_kind_and_name(
					representation,
					module_id,
					expected_kind,
					symbol.name,
				):
					match definition_index_rep_row(representation, id):
						Some(row):
							if (
								module_ids_equal(row.module_id, module_id)
								and row.kind == expected_kind
								and row.name == symbol.name
								and source_spans_equal(row.span, expected_span)
							):
								match result.get(symbol.name):
									Some(target):
										result = result.set(
											symbol.name,
											{ target |
												definition_ids = target.definition_ids.append(id)
											},
										)
									None:
										void
						None:
							void
			None:
				void

	into_opaque ExportedDefinitionTargets(result)


-- Build one public export bucket per prepared module. Binding then reuses the
-- bucket list for every selective import instead of rescanning declarations or
-- allocating a new overload list per importer. Qualified-only graphs reuse the
-- shared empty value and do no export scan or per-module map allocation.
pure func definition_index_exported_definition_targets(
	index: DefinitionIndex,
	issuing_table: ModuleTable,
	module_id: ModuleId,
	program: ParsedProgram,
	surface: ModuleSurface,
	requested_names: Option[Set[String]],
) -> Option[ExportedDefinitionTargets]:
	representation: DefinitionIndexRep = from_opaque DefinitionIndex(index)

	if not module_tables_are_compatible(
		definition_table_module_table(representation.definition_table),
		issuing_table,
	):
		None
	else:
		match requested_names:
			Some(names):
				if names.is_empty():
					Some(EXPORTED_DEFINITION_TARGETS_EMPTY)
				else:
					Some(
						exported_definition_targets_for_exports(
							representation,
							module_id,
							program,
							surface,
							surface.exports.filter(func(symbol): names.contains(symbol.name)),
						),
					)
			None:
				Some(
					exported_definition_targets_for_exports(
						representation,
						module_id,
						program,
						surface,
						surface.exports,
					),
				)


-- Constructor syntax is nested under an already-validated exported union.
-- Include the exact owner so a same-named field or constructor from another
-- union cannot be retained.
pure func definition_index_constructor_definition_ids_for_export(
	index: DefinitionIndex,
	issuing_table: ModuleTable,
	module_id: ModuleId,
	name: String,
	owner_name: String,
) -> Option[List[DefinitionId]]:
	representation: DefinitionIndexRep = from_opaque DefinitionIndex(index)

	if not module_tables_are_compatible(
		definition_table_module_table(representation.definition_table),
		issuing_table,
	):
		None
	else:
		candidates = definition_index_ids_for_kind_and_name(
			representation,
			module_id,
			ConstructorDefinitionKind,
			name,
		)
		var every_candidate_matches: Bool = not candidates.is_empty()

		for id in candidates:
			match definition_index_rep_row(representation, id):
				Some(row):
					if not ((
						module_ids_equal(row.module_id, module_id)
						and row.kind == ConstructorDefinitionKind
						and row.name == name
						and row.owner_name == Some(owner_name)
					)):
						every_candidate_matches = False
				None:
					every_candidate_matches = False

		if every_candidate_matches:
			Some(candidates)
		else:
			var result: List[DefinitionId] = []

			for id in candidates:
				match definition_index_rep_row(representation, id):
					Some(row):
						if (
							module_ids_equal(row.module_id, module_id)
							and row.kind == ConstructorDefinitionKind
							and row.name == name
							and row.owner_name == Some(owner_name)
						):
							result = result.append(id)
					None:
						void

			if result.is_empty():
				None
			else:
				Some(result.sort_by(definition_id_runtime_value))


-- Definition-bearing late products use this projection only at an external
-- or compatibility boundary. It also validates that an alleged overload set
-- belongs to one module/name pair in this table's provenance domain.
pure func definition_table_selective_definition_name(
	table: DefinitionTable,
	module_id: ModuleId,
	definition_ids: List[DefinitionId],
) -> Option[String]:
	var source_name: Option[String] = None
	var valid: Bool = not definition_ids.is_empty()

	for id in definition_ids:
		if valid:
			match definition_table_row(table, id):
				Some(row):
					if not module_ids_equal(row.module_id, module_id):
						valid = False
					else:
						match source_name:
							Some(expected):
								if row.name != expected:
									valid = False
							None:
								source_name = Some(row.name)
				None:
					valid = False

	if valid:
		source_name
	else:
		None


pure func definition_index_find_constructor_definition(
	index: DefinitionIndex,
	issuing_table: ModuleTable,
	key: SourceDefinitionKey,
) -> Option[DefinitionId]:
	runtime_id ?= definition_index_find_source_definition_id(index, issuing_table, key)
	definition_table_constructor_definition_id(definition_index_definition_table(index), runtime_id)


private pure func definition_index_source_entries(
	index: DefinitionIndexRep,
	module_id: ModuleId,
	name: String,
) -> List[DefinitionId]:
	index.source_definition_ids_by_module_and_name
		.get_or(module_id_table_index(module_id), {})
		.get_or(name, [])


pure func definition_index_find_type_definition_id(
	index: DefinitionIndex,
	issuing_table: ModuleTable,
	module_id: ModuleId,
	name: String,
) -> Option[Int]:
	representation: DefinitionIndexRep = from_opaque DefinitionIndex(index)
	var result: Option[Int] = None
	var match_count: Int = 0

	if module_tables_are_compatible(
		definition_table_module_table(representation.definition_table),
		issuing_table,
	):
		for id in definition_index_source_entries(representation, module_id, name):
			match definition_index_rep_row(representation, id):
				Some(row):
					if (
						row.kind == TypeDefinitionKind
						and row.owner_name.is_none()
						and module_ids_equal(row.module_id, module_id)
					):
						result = Some(definition_id_runtime_value(id))
						match_count += 1
				None:
					void

	if match_count == 1:
		result
	else:
		None


pure func definition_index_find_loaded_type_definition_id(
	index: DefinitionIndex,
	canonical_path: String,
	name: String,
) -> Option[Int]:
	representation: DefinitionIndexRep = from_opaque DefinitionIndex(index)
	module_id ?= module_table_find_id_by_canonical_path(
		definition_table_module_table(representation.definition_table),
		canonical_path,
	)
	var result: Option[Int] = None
	var match_count: Int = 0

	for id in definition_index_source_entries(representation, module_id, name):
		match definition_index_rep_row(representation, id):
			Some(row):
				if (
					row.kind == TypeDefinitionKind
					and row.owner_name.is_none()
					and module_ids_equal(row.module_id, module_id)
				):
					result = Some(definition_id_runtime_value(id))
					match_count += 1
			None:
				void

	if match_count == 1:
		result
	else:
		None


-- Deterministic graph-wide projection for diagnostics, tooling, and tests that
-- genuinely need every module. Semantic lookup should use owner-directed APIs.
pure func definition_index_source_definition_bindings(
	index: DefinitionIndex,
	name: String,
) -> List[(SourceDefinitionKey, Int)]:
	representation: DefinitionIndexRep = from_opaque DefinitionIndex(index)
	var bindings: List[(SourceDefinitionKey, Int)] = []

	for name_buckets in representation.source_definition_ids_by_module_and_name:
		for id in name_buckets.get_or(name, []):
			match definition_index_rep_row(representation, id):
				Some(row):
					match definition_source_key_for_row(row):
						Some(key):
							bindings = bindings.append((key, definition_id_runtime_value(id)))
						None:
							void
				None:
					void

	bindings.sort_by(func(binding): binding[1])


-- Deterministic complete projection for validation, diagnostics, and tooling.
-- Semantic lookup remains encapsulated by DefinitionIndex.
pure func definition_index_all_source_definition_bindings(
	index: DefinitionIndex,
) -> List[(SourceDefinitionKey, Int)]:
	representation: DefinitionIndexRep = from_opaque DefinitionIndex(index)
	var bindings: List[(SourceDefinitionKey, Int)] = []

	for name_buckets in representation.source_definition_ids_by_module_and_name:
		for entries in name_buckets.values():
			for id in entries:
				match definition_index_rep_row(representation, id):
					Some(row):
						match definition_source_key_for_row(row):
							Some(key):
								bindings = bindings.append((key, definition_id_runtime_value(id)))
							None:
								void
					None:
						void

	bindings.sort_by(func(binding): binding[1])


pure func definition_index_func_callable_id_count(index: DefinitionIndex) -> Int:
	representation: DefinitionIndexRep = from_opaque DefinitionIndex(index)
	representation.func_callable_id_count


pure func definition_index_source_definition_id_count(index: DefinitionIndex) -> Int:
	representation: DefinitionIndexRep = from_opaque DefinitionIndex(index)
	representation.source_definition_id_count


pure func definition_index_next_def_id(index: DefinitionIndex) -> Int:
	representation: DefinitionIndexRep = from_opaque DefinitionIndex(index)
	representation.next_def_id


pure func definition_index_seed_from_index(index: DefinitionIndex) -> DefinitionIndexSeed:
	representation: DefinitionIndexRep = from_opaque DefinitionIndex(index)
	into_opaque DefinitionIndexSeed(representation.next_def_id)


pure func definition_index_module_table(index: DefinitionIndex) -> ModuleTable:
	representation: DefinitionIndexRep = from_opaque DefinitionIndex(index)
	definition_table_module_table(representation.definition_table)


-- Direct-program checking can extend its graphless module domain between
-- source fragments. Existing rows must keep their numeric positions because
-- declaration keys already store those IDs.
pure func definition_index_rebase_module_table(
	index: DefinitionIndex,
	next_table: ModuleTable,
) -> Option[DefinitionIndex]:
	representation: DefinitionIndexRep = from_opaque DefinitionIndex(index)
	current_table = definition_table_module_table(representation.definition_table)

	if module_tables_are_compatible(current_table, next_table):
		Some(index)
	else:
		empty_callable_buckets: FuncCallableNameBuckets = {}
		empty_source_buckets: SourceDefinitionNameBuckets = {}
		var callable_buckets = repeat(empty_callable_buckets, module_table_count(next_table))
		var source_buckets = repeat(empty_source_buckets, module_table_count(next_table))
		var valid = module_table_count(next_table) >= module_table_count(current_table)

		for table_index in 0..module_table_count(current_table):
			old_id = module_table_id_at(current_table, table_index)

			new_id = match old_id:
				Some(module_id):
					match module_table_resolved_identity(current_table, module_id):
						Some(identity):
							module_table_find_id(next_table, identity)
						None:
							None
				None:
					None

			match new_id:
				Some(module_id):
					if module_id_table_index(module_id) == table_index:
						callable_buckets = callable_buckets.set(
							table_index,
							representation.func_callable_ids_by_module_and_name.get_or(
								table_index,
								{},
							),
						)
						source_buckets = source_buckets.set(
							table_index,
							representation.source_definition_ids_by_module_and_name.get_or(
								table_index,
								{},
							),
						)
					else:
						valid = False
				None:
					valid = False

		if valid:
			current_definition_table = definition_table_rep(representation.definition_table)
			Some(into_opaque DefinitionIndex({ representation |
						definition_table = into_opaque DefinitionTable(
							{ current_definition_table | module_table = next_table }
						),
						func_callable_ids_by_module_and_name = callable_buckets,
						source_definition_ids_by_module_and_name = source_buckets
					}))
		else:
			None


-- Body-local/generated IDs may advance Env beyond the source-row frontier.
-- Preserve that allocation frontier, but never synthesize table rows for it;
-- a later source insertion then fails closed in definition_index_binding_conflict.
pure func definition_index_advance_to_env(index: DefinitionIndex, env: Env) -> DefinitionIndex:
	representation: DefinitionIndexRep = from_opaque DefinitionIndex(index)

	if env.next_def_id <= representation.next_def_id:
		index
	else:
		into_opaque DefinitionIndex({ representation | next_def_id = env.next_def_id })


private pure func definition_rows_append_function(
	rows: List[DefinitionRow],
	module_id: ModuleId,
	name: String,
	span: SourceSpan,
) -> List[DefinitionRow]:
	rows.append({
		module_id = module_id,
		kind = CallableDefinitionKind,
		name = name,
		owner_name = None,
		span = span,
	})


private pure func definition_rows_append_source(
	rows: List[DefinitionRow],
	module_id: ModuleId,
	kind: SourceDefinitionKind,
	name: String,
	owner_name: Option[String],
	span: SourceSpan,
) -> List[DefinitionRow]:
	rows.append({
		module_id = module_id,
		kind = definition_kind_for_source(kind),
		name = name,
		owner_name = owner_name,
		span = span,
	})


private pure func graph_trait_defaults_in_decl(
	defaults: List[TraitDefaultMethods],
	module_id: ModuleId,
	canonical_path: String,
	module_kind: TraitDefaultsModuleKind,
	decl: ParsedDecl,
) -> List[TraitDefaultMethods]:
	match decl:
		TraitParsedDecl(trait_decl):
			defaults.append({
				module_id = module_id,
				canonical_path = canonical_path,
				module_kind = module_kind,
				trait_name = trait_decl.name.text,
				method_names = trait_decl.methods
					.filter(func(method): method.body.is_some())
					.map(func(method): method.name.text),
			})
		PrivateParsedDecl(inner, _):
			graph_trait_defaults_in_decl(defaults, module_id, canonical_path, module_kind, inner)
		_:
			defaults


private pure func graph_trait_defaults_in_module(
	defaults: List[TraitDefaultMethods],
	module_table: ModuleTable,
	module: LoadedModule,
) -> List[TraitDefaultMethods]:
	canonical_path = loaded_module_canonical_path(module)

	match module_table_find_id_by_canonical_path(module_table, canonical_path):
		None:
			defaults
		Some(module_id):
			program = loaded_module_program(module)

			module_kind = if prelude_traits_module_matches(
				loaded_module_origin(module),
				canonical_path,
				program.source.module_name,
			):
				PreludeTraitDefaultsModule
			else:
				OrdinaryTraitDefaultsModule

			var result = defaults

			for decl in program.decls:
				result = graph_trait_defaults_in_decl(
					result,
					module_id,
					canonical_path,
					module_kind,
					decl,
				)

			result


private pure func graph_trait_defaults_for_modules(
	module_table: ModuleTable,
	target: LoadedModule,
	modules: List[LoadedModule],
) -> List[TraitDefaultMethods]:
	var defaults = graph_trait_defaults_in_module([], module_table, target)

	for module in modules:
		defaults = graph_trait_defaults_in_module(defaults, module_table, module)

	defaults


private pure func graph_local_trait_default_methods(
	defaults: List[TraitDefaultMethods],
	module_id: ModuleId,
	trait_name: String,
) -> Option[List[String]]:
	var result: Option[List[String]] = None

	for trait_defaults in defaults:
		if (
			module_ids_equal(trait_defaults.module_id, module_id)
			and trait_defaults.trait_name == trait_name
		):
			result = Some(trait_defaults.method_names)
			break

	result


private pure func graph_import_symbol_local_name(symbol: ParsedImportSymbol) -> String:
	match symbol.symbol_alias:
		Some(alias_name):
			alias_name.text
		None:
			symbol.name.text


private pure func graph_imported_trait_reference_in_import(
	import_decl: ParsedImportDecl,
	visible_name: String,
) -> Option[ImportedTraitReference]:
	match import_decl.symbols:
		None:
			None
		Some(symbols):
			var result: Option[ImportedTraitReference] = None

			for symbol in symbols:
				if graph_import_symbol_local_name(symbol) == visible_name:
					result = Some({
						canonical_path = import_decl.module_path,
						trait_name = symbol.name.text,
					})
					break

			result


private pure func graph_imported_trait_reference_in_decl(
	decl: ParsedDecl,
	visible_name: String,
) -> Option[ImportedTraitReference]:
	match decl:
		ImportBlockParsedDecl(imports, _):
			var result: Option[ImportedTraitReference] = None

			for import_decl in imports:
				match graph_imported_trait_reference_in_import(import_decl, visible_name):
					Some(reference):
						result = Some(reference)
						break
					None:
						void

			result
		PrivateParsedDecl(inner, _):
			graph_imported_trait_reference_in_decl(inner, visible_name)
		_:
			None


private pure func graph_imported_trait_reference(
	program: ParsedProgram,
	visible_name: String,
) -> Option[ImportedTraitReference]:
	var result: Option[ImportedTraitReference] = None

	for decl in program.decls:
		match graph_imported_trait_reference_in_decl(decl, visible_name):
			Some(reference):
				result = Some(reference)
				break
			None:
				void

	result


private pure func graph_imported_trait_default_methods(
	defaults: List[TraitDefaultMethods],
	reference: ImportedTraitReference,
) -> Option[List[String]]:
	var result: Option[List[String]] = None

	for trait_defaults in defaults:
		if (
			trait_defaults.canonical_path == reference.canonical_path
			and trait_defaults.trait_name == reference.trait_name
		):
			result = Some(trait_defaults.method_names)
			break

	result


private pure func graph_prelude_trait_default_methods(
	defaults: List[TraitDefaultMethods],
	trait_name: String,
) -> Option[List[String]]:
	var result: Option[List[String]] = None

	if builtin_trait_is_prelude(trait_name):
		for trait_defaults in defaults:
			match trait_defaults.module_kind:
				PreludeTraitDefaultsModule:
					if trait_defaults.trait_name == trait_name:
						result = Some(trait_defaults.method_names)
						break
				OrdinaryTraitDefaultsModule:
					void

	result


private pure func graph_default_method_names_for_impl(
	defaults: List[TraitDefaultMethods],
	module_id: ModuleId,
	program: ParsedProgram,
	impl_decl: ParsedImplDecl,
) -> List[String]:
	trait_name = impl_decl.trait_name.text

	method_names = match graph_local_trait_default_methods(defaults, module_id, trait_name):
		Some(local_methods):
			local_methods
		None:
			match graph_imported_trait_reference(program, trait_name):
				Some(reference):
					graph_imported_trait_default_methods(defaults, reference).get_or([])
				None:
					graph_prelude_trait_default_methods(defaults, trait_name).get_or([])

	method_names.filter(
		func(
			method_name,
		): not impl_decl.methods.any(func(method): method.name.text == method_name),
	)


private pure func definition_rows_for_decl(
	rows: List[DefinitionRow],
	module_id: ModuleId,
	trait_defaults: List[TraitDefaultMethods],
	program: ParsedProgram,
	decl: ParsedDecl,
) -> List[DefinitionRow]:
	match decl:
		FunctionParsedDecl(function_decl):
			definition_rows_append_function(
				rows,
				module_id,
				function_decl.name.text,
				function_decl.span,
			)
		ForeignBlockParsedDecl(_, functions, _):
			var result = rows

			for function_decl in functions:
				result = definition_rows_append_function(
					result,
					module_id,
					function_decl.name.text,
					function_decl.span,
				)

			result
		UnionParsedDecl(union_decl):
			var with_variants = definition_rows_append_source(
				rows,
				module_id,
				TypeDefinition,
				union_decl.name.text,
				None,
				union_decl.span,
			)

			for variant in union_decl.variants:
				with_variants = definition_rows_append_source(
					with_variants,
					module_id,
					ConstructorDefinition,
					variant.name.text,
					Some(union_decl.name.text),
					variant.span,
				)

			with_variants
		RecordParsedDecl(record_decl):
			var result = definition_rows_append_source(
				rows,
				module_id,
				TypeDefinition,
				record_decl.name.text,
				None,
				record_decl.span,
			)

			for field in record_decl.fields:
				result = definition_rows_append_source(
					result,
					module_id,
					FieldDefinition,
					field.name.text,
					Some(record_decl.name.text),
					field.span,
				)

			result
		BuiltinTypeParsedDecl(type_decl):
			definition_rows_append_source(
				rows,
				module_id,
				TypeDefinition,
				type_decl.name.text,
				None,
				type_decl.span,
			)
		TypeAliasParsedDecl(alias_decl):
			definition_rows_append_source(
				rows,
				module_id,
				TypeDefinition,
				alias_decl.name.text,
				None,
				alias_decl.span,
			)
		TraitParsedDecl(trait_decl):
			definition_rows_append_source(
				rows,
				module_id,
				TraitDefinition,
				trait_decl.name.text,
				None,
				trait_decl.span,
			)
		ImplParsedDecl(impl_decl):
			with_impl = definition_rows_append_source(
				rows,
				module_id,
				ImplDefinition,
				impl_decl.trait_name.text,
				None,
				impl_decl.span,
			)
			var result = with_impl

			for method_name in graph_default_method_names_for_impl(
				trait_defaults,
				module_id,
				program,
				impl_decl,
			):
				result = definition_rows_append_function(
					result,
					module_id,
					method_name,
					impl_decl.span,
				)

			for method in impl_decl.methods:
				result = definition_rows_append_function(
					result,
					module_id,
					method.name.text,
					method.span,
				)

			result
		VarParsedDecl(var_decl):
			definition_rows_append_source(
				rows,
				module_id,
				GlobalDefinition,
				var_decl.name.text,
				None,
				var_decl.span,
			)
		PrivateParsedDecl(inner, _):
			definition_rows_for_decl(rows, module_id, trait_defaults, program, inner)
		_:
			rows


private pure func definition_index_reserve_program(
	index: DefinitionIndexBuildState,
	module_id: ModuleId,
	trait_defaults: List[TraitDefaultMethods],
	program: ParsedProgram,
) -> DefinitionIndexBuildState:
	definition_index_reserve_program_parts(
		index.module_table,
		index.func_callable_ids_by_module_and_name,
		index.source_definition_ids_by_module_and_name,
		index.first_graph_definition_id,
		index.definition_rows,
		index.func_callable_id_count,
		index.source_definition_id_count,
		index.next_def_id,
		module_id,
		trait_defaults,
		program,
	)


pure func definition_index_for_loaded_modules(
	seed: DefinitionIndexSeed,
	module_table: ModuleTable,
	loaded_modules: LoadedModuleSet,
) -> Option[DefinitionIndex]:
	target = loaded_module_set_target(loaded_modules)
	modules = loaded_module_set_modules(
		loaded_modules,
	).sort_by(
		func(module): loaded_module_canonical_path(module),
	)
	target_program = loaded_module_program(target)
	trait_defaults = graph_trait_defaults_for_modules(module_table, target, modules)
	var index = definition_index_build_empty(seed, module_table)
	var valid = True

	match module_table_find_id_by_canonical_path(
		module_table,
		loaded_module_canonical_path(target),
	):
		Some(target_id):
			index = definition_index_reserve_program(
				index,
				target_id,
				trait_defaults,
				target_program,
			)
		None:
			valid = False

	for module in modules:
		match module_table_find_id_by_canonical_path(
			module_table,
			loaded_module_canonical_path(module),
		):
			Some(module_id):
				index = definition_index_reserve_program(
					index,
					module_id,
					trait_defaults,
					loaded_module_program(module),
				)
			None:
				valid = False

	if valid:
		Some(definition_index_from_build(index))
	else:
		None
