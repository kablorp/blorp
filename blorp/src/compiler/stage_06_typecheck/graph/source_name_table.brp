-- Compilation-local source spelling identities.
--
-- SourceNameId is deliberately not semantic identity: it only replaces
-- repeated String keys while a compilation graph is active. Resolved products
-- must carry DefinitionId, ModuleId, or another semantic entity ID instead.
import:
	../../stage_03_parse/parsed_ast:
		ParsedDecl(
			BuiltinTypeParsedDecl,
			ForeignBlockParsedDecl,
			FunctionParsedDecl,
			ImplParsedDecl,
			ImportBlockParsedDecl,
			ParsedErrorDecl,
			PrivateParsedDecl,
			RecordParsedDecl,
			TraitParsedDecl,
			TypeAliasParsedDecl,
			UnionParsedDecl,
			VarParsedDecl,
		),
		ParsedImportDecl,
		ParsedImportSymbol,
		ParsedProgram,
	../../stage_04_modules/module_table:
		ModuleId,
		ModuleTable,
		module_ids_equal,
		module_tables_are_compatible,
	instrumentation: black_box_int


opaque type SourceNameId = Int


private record SourceNameTableRep {
	spellings: List[String],
	id_by_spelling: Dict[String, Int]
}


opaque type SourceNameTable = SourceNameTableRep

-- Dict iteration preserves insertion order, so one dictionary is sufficient
-- construction state. Finalization materializes the ordered key list once;
-- retaining a list beside the dictionary while building would either allocate
-- an aggregate wrapper or repeatedly trigger COW through borrowed fields.
private type alias SourceNameTableBuilder = Dict[String, Int]


-- Debug/profile builds expose deterministic construction work through the
-- ordinary function profiler. Release builds erase these markers.
private @debug_only pure func source_name_catalog_work_candidate_probes() -> Int:
	black_box_int(0)


private @debug_only pure func source_name_catalog_work_unique_insertions() -> Int:
	black_box_int(0)


private @debug_only pure func source_name_catalog_work_duplicate_probes() -> Int:
	black_box_int(0)


private @debug_only pure func source_name_catalog_work_finalizations() -> Int:
	black_box_int(0)


-- Register zero-valued markers in a measured profile window. Consumers
-- subtract this single registration call from each reported function count.
@debug_only
pure func register_source_name_catalog_work_counters() -> Int:
	debug:
		source_name_catalog_work_candidate_probes()
		source_name_catalog_work_unique_insertions()
		source_name_catalog_work_duplicate_probes()
		source_name_catalog_work_finalizations()

	0


private pure func source_name_table_builder_insert(
	builder: SourceNameTableBuilder,
	spelling: String,
) -> SourceNameTableBuilder:
	debug:
		source_name_catalog_work_unique_insertions()

	-- Compute the ID before the consuming set so the builder remains uniquely
	-- owned and Dict can update in place.
	next_id = builder.length()
	builder.set(spelling, next_id)


foreign(include: "source_name_table_ffi.h"):
	private pure func source_name_tables_are_same_allocation(
		left: SourceNameTable,
		right: SourceNameTable,
	) -> Bool = "blorp_compiler_source_name_tables_are_same_allocation"


-- Created as one graph-issued pair so graph visibility cannot combine a
-- spelling table from one compilation with a module table from another.
private record GraphSourceNameTableRep {
	source_names: SourceNameTable,
	module_table: ModuleTable
}


opaque type GraphSourceNameTable = GraphSourceNameTableRep


private pure func graph_source_name_table_from_source_names(
	module_table: ModuleTable,
	source_names: SourceNameTable,
) -> GraphSourceNameTable:
	into_opaque GraphSourceNameTable({
			source_names = source_names,
			module_table = module_table
		})


pure func graph_source_name_table(
	module_table: ModuleTable,
	candidates: List[String],
) -> GraphSourceNameTable:
	graph_source_name_table_from_source_names(module_table, source_name_table(candidates))


pure func graph_source_name_table_source_names(table: GraphSourceNameTable) -> SourceNameTable:
	from_opaque GraphSourceNameTable(table).source_names


pure func graph_source_name_table_module_table(table: GraphSourceNameTable) -> ModuleTable:
	from_opaque GraphSourceNameTable(table).module_table


-- A graph-wide spelling catalog is not a module visibility scope. The
-- selected module identity travels with it so one module's view cannot be
-- registered through a sibling scope of the same graph.
private record GraphModuleNameScopeRep {
	graph_names: GraphSourceNameTable,
	module_id: ModuleId
}


opaque type GraphModuleNameScope = GraphModuleNameScopeRep


pure func graph_module_name_scope(
	graph_names: GraphSourceNameTable,
	module_id: ModuleId,
) -> GraphModuleNameScope:
	into_opaque GraphModuleNameScope({
			graph_names = graph_names,
			module_id = module_id
		})


pure func graph_module_name_scope_graph_names(scope: GraphModuleNameScope) -> GraphSourceNameTable:
	from_opaque GraphModuleNameScope(scope).graph_names


pure func graph_module_name_scope_module_id(scope: GraphModuleNameScope) -> ModuleId:
	from_opaque GraphModuleNameScope(scope).module_id


-- Structural spelling equality does not prove provenance: a caller can
-- remint an equal-looking catalog over the same module table. Bound-row
-- references may cross phases only under the original graph-issued catalog.
pure func graph_module_name_scope_matches_catalog(
	scope: GraphModuleNameScope,
	graph_names: GraphSourceNameTable,
	module_id: ModuleId,
) -> Bool:
	issued_graph_names = graph_module_name_scope_graph_names(scope)

	(
		module_ids_equal(graph_module_name_scope_module_id(scope), module_id)
		and module_tables_are_compatible(
			graph_source_name_table_module_table(issued_graph_names),
			graph_source_name_table_module_table(graph_names),
		)
		and source_name_tables_are_same_allocation(
			graph_source_name_table_source_names(issued_graph_names),
			graph_source_name_table_source_names(graph_names),
		)
	)


private pure func source_name_id(index: Int) -> SourceNameId:
	into_opaque SourceNameId(index)


pure func source_name_id_table_index(id: SourceNameId) -> Int:
	from_opaque SourceNameId(id)


-- Reconstitute an ID only after proving that its raw table index belongs to
-- this source-name domain.
pure func source_name_table_id_at(table: SourceNameTable, index: Int) -> Option[SourceNameId]:
	representation: SourceNameTableRep = from_opaque SourceNameTable(table)

	match representation.spellings.get(index):
		Some(_):
			Some(source_name_id(index))
		None:
			None


pure func source_name_ids_equal(left: SourceNameId, right: SourceNameId) -> Bool:
	source_name_id_table_index(left) == source_name_id_table_index(right)


-- A qualified import without an explicit alias is visible through the final
-- path component, without the source extension. Keeping that spelling rule
-- beside the compilation source-name table prevents graph admission and
-- import binding from independently deriving different keys.
pure func source_name_default_module_alias(module_path: String) -> String:
	parts = module_path.split("/")
	raw_name = parts
		.last()
		.get_or(module_path)

	if raw_name.ends_with(".brp"):
		raw_name.substring(0, raw_name.length() - 4)
	else:
		raw_name


private pure func source_name_table_builder_add(
	builder: SourceNameTableBuilder,
	spelling: String,
) -> SourceNameTableBuilder:
	debug:
		source_name_catalog_work_candidate_probes()

	if builder.contains(spelling):
		debug:
			source_name_catalog_work_duplicate_probes()

		builder
	else:
		source_name_table_builder_insert(builder, spelling)


private pure func source_name_table_builder_add_import_symbol(
	builder: SourceNameTableBuilder,
	symbol: ParsedImportSymbol,
) -> SourceNameTableBuilder:
	var result = match symbol.symbol_alias:
		Some(alias_name):
			source_name_table_builder_add(builder, alias_name.text)
		None:
			source_name_table_builder_add(builder, symbol.name.text)

	for constructor in symbol.constructors:
		result = source_name_table_builder_add(result, constructor.text)

	result


private pure func source_name_table_builder_add_import_symbols(
	builder: SourceNameTableBuilder,
	symbols: List[ParsedImportSymbol],
) -> SourceNameTableBuilder:
	match symbols.get(0):
		None:
			builder
		Some(first_symbol):
			var result = source_name_table_builder_add_import_symbol(builder, first_symbol)
			var index: Int = 1

			while index < symbols.length():
				match symbols.get(index):
					Some(symbol):
						result = source_name_table_builder_add_import_symbol(result, symbol)
					None:
						void

				index += 1

			result


private pure func source_name_table_builder_add_import(
	builder: SourceNameTableBuilder,
	import_decl: ParsedImportDecl,
) -> SourceNameTableBuilder:
	match import_decl.module_alias:
		Some(alias_name):
			match import_decl.symbols:
				Some(symbols):
					source_name_table_builder_add_import_symbols(
						source_name_table_builder_add(builder, alias_name.text),
						symbols,
					)
				None:
					source_name_table_builder_add(builder, alias_name.text)
		None:
			match import_decl.symbols:
				Some(symbols):
					source_name_table_builder_add_import_symbols(builder, symbols)
				None:
					source_name_table_builder_add(
						builder,
						source_name_default_module_alias(import_decl.module_path),
					)


-- Catalog exactly the source-visible names admitted to migrated ModuleView
-- relations. Fields and parameters never enter these relations. Implementation
-- methods do not enter local-declaration visibility. Declared trait methods do:
-- they can be called bare in their owner module, while selected imported methods
-- are cataloged from their import declarations rather than from impl bodies.
private pure func source_name_table_builder_add_decl(
	builder: SourceNameTableBuilder,
	decl: ParsedDecl,
) -> SourceNameTableBuilder:
	match decl:
		RecordParsedDecl(record_decl):
			source_name_table_builder_add(builder, record_decl.name.text)
		UnionParsedDecl(union_decl):
			var result = source_name_table_builder_add(builder, union_decl.name.text)

			for variant in union_decl.variants:
				result = source_name_table_builder_add(result, variant.name.text)

			result
		BuiltinTypeParsedDecl(type_decl):
			source_name_table_builder_add(builder, type_decl.name.text)
		TypeAliasParsedDecl(alias_decl):
			source_name_table_builder_add(builder, alias_decl.name.text)
		FunctionParsedDecl(function_decl):
			source_name_table_builder_add(builder, function_decl.name.text)
		VarParsedDecl(var_decl):
			source_name_table_builder_add(builder, var_decl.name.text)
		TraitParsedDecl(trait_decl):
			var result = source_name_table_builder_add(builder, trait_decl.name.text)

			for method in trait_decl.methods:
				result = source_name_table_builder_add(result, method.name.text)

			result
		ForeignBlockParsedDecl(_, functions, _):
			match functions.get(0):
				None:
					builder
				Some(first_function):
					var result = source_name_table_builder_add(builder, first_function.name.text)
					var index: Int = 1

					while index < functions.length():
						match functions.get(index):
							Some(function_decl):
								result = source_name_table_builder_add(
									result,
									function_decl.name.text,
								)
							None:
								void

						index += 1

					result
		ImportBlockParsedDecl(imports, _):
			match imports.get(0):
				None:
					builder
				Some(first_import):
					var result = source_name_table_builder_add_import(builder, first_import)
					var index: Int = 1

					while index < imports.length():
						match imports.get(index):
							Some(import_decl):
								result = source_name_table_builder_add_import(result, import_decl)
							None:
								void

						index += 1

					result
		PrivateParsedDecl(inner, _):
			source_name_table_builder_add_decl(builder, inner)
		ImplParsedDecl(_) | ParsedErrorDecl(_):
			builder


private pure func source_name_table_from_builder(
	builder: SourceNameTableBuilder,
) -> SourceNameTable:
	debug:
		source_name_catalog_work_finalizations()

	into_opaque SourceNameTable({
			spellings = builder.keys(),
			id_by_spelling = builder
		})


pure func source_name_table(candidates: List[String]) -> SourceNameTable:
	var builder: SourceNameTableBuilder = {}

	for candidate in candidates:
		builder = source_name_table_builder_add(builder, candidate)

	source_name_table_from_builder(builder)


-- Indexed graph construction owns the program order. Cataloging directly from
-- that ordered input avoids retaining every candidate spelling and traversing
-- it a second time before the graph can be published.
pure func graph_source_name_table_for_programs(
	module_table: ModuleTable,
	programs: List[ParsedProgram],
) -> GraphSourceNameTable:
	var builder: SourceNameTableBuilder = {}

	for program in programs:
		for decl in program.decls:
			builder = source_name_table_builder_add_decl(builder, decl)

	graph_source_name_table_from_source_names(module_table, source_name_table_from_builder(builder))


pure func source_name_table_count(table: SourceNameTable) -> Int:
	from_opaque SourceNameTable(table).spellings.length()


pure func source_name_tables_are_compatible(left: SourceNameTable, right: SourceNameTable) -> Bool:
	left_representation: SourceNameTableRep = from_opaque SourceNameTable(left)
	right_representation: SourceNameTableRep = from_opaque SourceNameTable(right)
	left_representation.spellings == right_representation.spellings


pure func source_name_table_find_id(
	table: SourceNameTable,
	spelling: String,
) -> Option[SourceNameId]:
	from_opaque SourceNameTable(table).id_by_spelling
		.get(spelling)
		.map(source_name_id)


pure func source_name_table_spelling(table: SourceNameTable, id: SourceNameId) -> Option[String]:
	from_opaque SourceNameTable(table).spellings.get(source_name_id_table_index(id))
