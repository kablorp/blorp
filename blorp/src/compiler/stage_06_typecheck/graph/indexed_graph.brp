-- Completed graph-identity phase product for typechecking.
--
-- Load candidates retain source data for diagnostics but do not claim
-- canonical identity. Only an accepted IndexedGraph exposes prepared
-- modules backed by one validated loaded-module set and definition index.
import:
	../../stage_01_generated_inputs/embedded_std: embedded_std_contains_module
	../../stage_03_parse/parsed_ast: ParsedProgram
	../../stage_03_parse/parsed_ast_json: parsed_programs_are_equal
	../../stage_04_modules/loaded_module:
		LoadedModule,
		LoadedModuleSet,
		LoadedModuleSetError,
		ModuleIdentity,
		ModuleLoadCandidate,
		ModuleOrigin(StdlibModule),
		loaded_module_canonical_path,
		loaded_module_identity,
		loaded_module_origin,
		loaded_module_program,
		loaded_module_set,
		loaded_module_set_modules,
		loaded_module_set_target,
		loaded_module_surface,
		module_identities_equal,
		module_identity_display_name,
		module_load_candidate_canonical_path,
		module_load_candidate_origin,
		module_origins_equal,
	../../stage_04_modules/module_surface: ModuleSurface
	../type_system/env: ENV_EMPTY
	definition_index:
		DefinitionIndex,
		definition_index_for_loaded_modules,
		definition_index_initial_seed,


opaque type PreparedModule = LoadedModule


private pure func prepared_module_from_loaded(loaded_module: LoadedModule) -> PreparedModule:
	into_opaque PreparedModule(loaded_module)


pure func prepared_module_identity(module: PreparedModule) -> ModuleIdentity:
	loaded_module_identity(from_opaque PreparedModule(module))


pure func prepared_module_origin(module: PreparedModule) -> ModuleOrigin:
	loaded_module_origin(from_opaque PreparedModule(module))


pure func prepared_module_program(module: PreparedModule) -> ParsedProgram:
	loaded_module_program(from_opaque PreparedModule(module))


pure func prepared_module_canonical_path(module: PreparedModule) -> String:
	loaded_module_canonical_path(from_opaque PreparedModule(module))


pure func prepared_module_surface(module: PreparedModule) -> Option[ModuleSurface]:
	loaded_module_surface(from_opaque PreparedModule(module))


union IndexedGraphError:
	DuplicateCompilerModuleIdentity(ModuleIdentity, String, String)
	ConflictingCompilerModuleOrigins(String)
	ReservedCompilerStandardLibraryPath(String)
	DuplicateCompilerModuleTarget(String)
	UnknownCompilerModuleTarget(String)


private record IndexedGraphRep {
	target: PreparedModule,
	modules: List[PreparedModule],
	dependencies_by_path: Dict[String, PreparedModule],
	definition_index: DefinitionIndex
}


opaque type IndexedGraph = IndexedGraphRep


foreign(include: "indexed_graph_ffi.h"):
	private pure func indexed_graphs_are_same_allocation(
		left: IndexedGraph,
		right: IndexedGraph,
	) -> Bool = "blorp_compiler_indexed_graphs_are_same_allocation"


private record PreparedModuleScopeRep {
	graph: IndexedGraph,
	module: PreparedModule
}


opaque type PreparedModuleScope = PreparedModuleScopeRep


pure func indexed_graph_error_message(error: IndexedGraphError) -> String:
	match error:
		DuplicateCompilerModuleIdentity(identity, first_path, duplicate_path):
			"duplicate canonical module identity '" + module_identity_display_name(
				identity,
			) + "': '" + first_path + "' and '" + duplicate_path + "'"
		ConflictingCompilerModuleOrigins(canonical_path):
			"compiler module path '" + canonical_path + "' is claimed by multiple module origins"
		ReservedCompilerStandardLibraryPath(canonical_path):
			"standard-library module path '" + canonical_path + "' is reserved; rename the non-standard module"
		DuplicateCompilerModuleTarget(identity):
			"duplicate typecheck module target '" + identity + "'"
		UnknownCompilerModuleTarget(identity):
			"unknown typecheck module target '" + identity + "'"


private pure func indexed_graph_error_from_loaded_module_set_error(
	error: LoadedModuleSetError,
) -> IndexedGraphError:
	DuplicateCompilerModuleIdentity(error.identity, error.first_path, error.duplicate_path)


private pure func indexed_graph_from_loaded_modules(
	loaded_modules: LoadedModuleSet,
) -> IndexedGraph:
	definition_index = definition_index_for_loaded_modules(
		definition_index_initial_seed(ENV_EMPTY),
		loaded_modules,
	)
	target = prepared_module_from_loaded(loaded_module_set_target(loaded_modules))
	modules = loaded_module_set_modules(loaded_modules).map(func(module):
		prepared_module_from_loaded(module)
	)
	var dependencies_by_path: Dict[String, PreparedModule] = {}

	for module in modules:
		dependencies_by_path = dependencies_by_path.set(
			prepared_module_canonical_path(module),
			module,
		)

	representation: IndexedGraphRep = {
		target = target,
		modules = modules,
		dependencies_by_path = dependencies_by_path,
		definition_index = definition_index
	}
	into_opaque IndexedGraph(representation)


private pure func module_candidate_validation_errors(
	target_candidate: ModuleLoadCandidate,
	module_candidates: List[ModuleLoadCandidate],
) -> List[IndexedGraphError]:
	candidates = [target_candidate].concat(module_candidates)
	var first_origin_by_path: Dict[String, ModuleOrigin] = {}
	var conflicting_paths: Dict[String, Bool] = {}
	var errors: List[IndexedGraphError] = []

	for candidate in candidates:
		canonical_path = module_load_candidate_canonical_path(candidate)
		origin = module_load_candidate_origin(candidate)

		if embedded_std_contains_module(canonical_path):
			match origin:
				StdlibModule:
					void
				_:
					errors = errors.append(ReservedCompilerStandardLibraryPath(canonical_path))

		match first_origin_by_path.get(canonical_path):
			Some(first_origin):
				if (
					not module_origins_equal(first_origin, origin)
					and not conflicting_paths.contains(canonical_path)
				):
					conflicting_paths = conflicting_paths.set(canonical_path, True)
					errors = errors.append(ConflictingCompilerModuleOrigins(canonical_path))
			None:
				first_origin_by_path = first_origin_by_path.set(canonical_path, origin)

	errors


pure func indexed_graph_build(
	target_candidate: ModuleLoadCandidate,
	module_candidates: List[ModuleLoadCandidate],
) -> Result[IndexedGraph, List[IndexedGraphError]]:
	validation_errors = module_candidate_validation_errors(target_candidate, module_candidates)

	if validation_errors.length() > 0:
		Err(validation_errors)
	else:
		match loaded_module_set(target_candidate, module_candidates):
			Err(errors):
				Err(errors.map(indexed_graph_error_from_loaded_module_set_error))
			Ok(loaded_modules):
				Ok(indexed_graph_from_loaded_modules(loaded_modules))


pure func indexed_graph_target(graph: IndexedGraph) -> PreparedModule:
	representation: IndexedGraphRep = from_opaque IndexedGraph(graph)
	representation.target


pure func indexed_graph_modules(graph: IndexedGraph) -> List[PreparedModule]:
	representation: IndexedGraphRep = from_opaque IndexedGraph(graph)
	representation.modules


pure func indexed_graph_find_dependency(
	graph: IndexedGraph,
	canonical_path: String,
) -> Option[PreparedModule]:
	representation: IndexedGraphRep = from_opaque IndexedGraph(graph)
	representation.dependencies_by_path.get(canonical_path)


pure func indexed_graph_select_dependencies(
	graph: IndexedGraph,
	canonical_paths: List[String],
) -> Result[List[PreparedModule], List[IndexedGraphError]]:
	var selected: List[PreparedModule] = []
	var seen: Dict[String, Bool] = {}
	var errors: List[IndexedGraphError] = []

	for canonical_path in canonical_paths:
		if seen.contains(canonical_path):
			errors = errors.append(DuplicateCompilerModuleTarget(canonical_path))
		else:
			seen = seen.set(canonical_path, True)

			match indexed_graph_find_dependency(graph, canonical_path):
				Some(module):
					selected = selected.append(module)
				None:
					errors = errors.append(UnknownCompilerModuleTarget(canonical_path))

	if errors.length() == 0:
		Ok(selected)
	else:
		Err(errors)


pure func indexed_graph_definition_index(graph: IndexedGraph) -> DefinitionIndex:
	representation: IndexedGraphRep = from_opaque IndexedGraph(graph)
	representation.definition_index


pure func indexed_graph_module_scopes(graph: IndexedGraph) -> List[PreparedModuleScope]:
	indexed_graph_modules(graph).map(func(module): prepared_module_scope(graph, module))


private pure func prepared_module_scope(
	graph: IndexedGraph,
	module: PreparedModule,
) -> PreparedModuleScope:
	representation: PreparedModuleScopeRep = {
		graph = graph,
		module = module
	}
	into_opaque PreparedModuleScope(representation)


pure func indexed_graph_select_dependency_scopes(
	graph: IndexedGraph,
	canonical_paths: List[String],
) -> Result[List[PreparedModuleScope], List[IndexedGraphError]]:
	match indexed_graph_select_dependencies(graph, canonical_paths):
		Err(errors):
			Err(errors)
		Ok(modules):
			Ok(modules.map(
				func(module): prepared_module_scope(graph, module),
			))


pure func indexed_graph_target_scope(graph: IndexedGraph) -> PreparedModuleScope:
	prepared_module_scope(graph, indexed_graph_target(graph))


pure func indexed_graph_find_dependency_scope(
	graph: IndexedGraph,
	canonical_path: String,
) -> Option[PreparedModuleScope]:
	indexed_graph_find_dependency(
		graph,
		canonical_path,
	).map(
		func(module): prepared_module_scope(graph, module),
	)


pure func prepared_module_scope_find_module(
	scope: PreparedModuleScope,
	canonical_path: String,
) -> Option[PreparedModuleScope]:
	representation: PreparedModuleScopeRep = from_opaque PreparedModuleScope(scope)

	if prepared_module_canonical_path(indexed_graph_target(representation.graph)) == canonical_path:
		Some(indexed_graph_target_scope(representation.graph))
	else:
		indexed_graph_find_dependency_scope(representation.graph, canonical_path)


pure func prepared_module_scope_module(scope: PreparedModuleScope) -> PreparedModule:
	representation: PreparedModuleScopeRep = from_opaque PreparedModuleScope(scope)
	representation.module


pure func prepared_module_scope_definition_index(scope: PreparedModuleScope) -> DefinitionIndex:
	representation: PreparedModuleScopeRep = from_opaque PreparedModuleScope(scope)
	indexed_graph_definition_index(representation.graph)


pure func prepared_module_scope_identity(scope: PreparedModuleScope) -> ModuleIdentity:
	prepared_module_identity(prepared_module_scope_module(scope))


pure func prepared_module_scope_canonical_path(scope: PreparedModuleScope) -> String:
	prepared_module_canonical_path(prepared_module_scope_module(scope))


pure func prepared_module_scope_origin(scope: PreparedModuleScope) -> ModuleOrigin:
	prepared_module_origin(prepared_module_scope_module(scope))


private pure func prepared_modules_are_equal(left: PreparedModule, right: PreparedModule) -> Bool:
	(
		module_identities_equal(prepared_module_identity(left), prepared_module_identity(right))
		and module_origins_equal(prepared_module_origin(left), prepared_module_origin(right))
		and parsed_programs_are_equal(prepared_module_program(left), prepared_module_program(right))
	)


private pure func prepared_module_lists_are_equal(
	left: List[PreparedModule],
	right: List[PreparedModule],
) -> Bool:
	if left.length() != right.length():
		False
	else:
		var index: Int = 0
		var equal: Bool = True

		while index < left.length() and equal:
			match (left.get(index), right.get(index)):
				(Some(left_module), Some(right_module)):
					equal = prepared_modules_are_equal(left_module, right_module)
				_:
					equal = False

			index += 1

		equal


private pure func indexed_graphs_are_equal(left: IndexedGraph, right: IndexedGraph) -> Bool:
	left_representation: IndexedGraphRep = from_opaque IndexedGraph(left)
	right_representation: IndexedGraphRep = from_opaque IndexedGraph(right)

	(
		prepared_modules_are_equal(left_representation.target, right_representation.target)
		and prepared_module_lists_are_equal(
			left_representation.modules,
			right_representation.modules,
		)
	)


pure func prepared_module_scopes_are_compatible(
	left: PreparedModuleScope,
	right: PreparedModuleScope,
) -> Bool:
	left_representation: PreparedModuleScopeRep = from_opaque PreparedModuleScope(left)
	right_representation: PreparedModuleScopeRep = from_opaque PreparedModuleScope(right)

	(
		indexed_graphs_are_same_allocation(left_representation.graph, right_representation.graph)
		or indexed_graphs_are_equal(left_representation.graph, right_representation.graph)
	)
