		module_table_canonical_path,
		module_table_count,
		module_table_find_id,
		module_table_find_id_by_canonical_path,
		module_table_id_at,
		module_table_id_matches_identity,
		module_tables_are_compatible,
	../type_system/env: ENV_EMPTY
	definition_index:
		DefinitionIndex,
		ExportedDefinitionNameDemand,
		definition_index_for_loaded_modules,
		definition_index_initial_seed,
		exported_definition_name_demand_add,
		exported_definition_name_demand_empty,
	list: repeat
