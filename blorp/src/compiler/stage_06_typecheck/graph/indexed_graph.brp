opaque type PreparedModule = LoadedModule


private pure func prepared_module_from_loaded(loaded_module: LoadedModule) -> PreparedModule:
	into_opaque PreparedModule(loaded_module)


pure func prepared_module_identity(module: PreparedModule) -> ModuleIdentity:
	loaded_module_identity(from_opaque PreparedModule(module))


pure func prepared_module_origin(module: PreparedModule) -> ModuleOrigin:
	loaded_module_origin(from_opaque PreparedModule(module))


pure func prepared_module_program(module: PreparedModule) -> ParsedProgram:
	loaded_module_program(from_opaque PreparedModule(module))


pure func prepared_module_canonical_path(module: PreparedModule) -> String:
	loaded_module_canonical_path(from_opaque PreparedModule(module))


pure func prepared_module_surface(module: PreparedModule) -> Option[ModuleSurface]:
	loaded_module_surface(from_opaque PreparedModule(module))


union IndexedGraphError:
	DuplicateCompilerModuleIdentity(ModuleIdentity, String, String)
	ConflictingCompilerModuleOrigins(String)
	ReservedCompilerStandardLibraryPath(String)
	DuplicateCompilerModuleTarget(String)
	UnknownCompilerModuleTarget(String)
	UnknownCompilerModuleTableIndex(Int)
	IncompatibleCompilerModuleTable
	CompilerModuleTableLengthMismatch(Int, Int)
	CompilerModuleTableIdentityMismatch(Int, String, String)


private record IndexedGraphRep {
	target: PreparedModule,
	module_table: ModuleTable,
	prepared_modules: List[PreparedModule],
	target_id: ModuleId,
	definition_index: DefinitionIndex,
	graph_source_names: GraphSourceNameTable,
	selective_export_names_by_module: List[ExportedDefinitionNameDemand],
	conservative_selective_export_names: ExportedDefinitionNameDemand
}


opaque type IndexedGraph = IndexedGraphRep


foreign(include: "indexed_graph_ffi.h"):
	private pure func indexed_graphs_are_same_allocation(
		left: IndexedGraph,
		right: IndexedGraph,
	) -> Bool = "blorp_compiler_indexed_graphs_are_same_allocation"


private record PreparedModuleScopeRep {
	graph: IndexedGraph,
	module_id: ModuleId
}


opaque type PreparedModuleScope = PreparedModuleScopeRep


pure func indexed_graph_error_message(error: IndexedGraphError) -> String:
	match error:
		DuplicateCompilerModuleIdentity(identity, first_path, duplicate_path):
			"duplicate canonical module identity '" + module_identity_display_name(
				identity,
			) + "': '" + first_path + "' and '" + duplicate_path + "'"
		ConflictingCompilerModuleOrigins(canonical_path):
			"compiler module path '" + canonical_path + "' is claimed by multiple module origins"
		ReservedCompilerStandardLibraryPath(canonical_path):
			"standard-library module path '" + canonical_path + "' is reserved; rename the non-standard module"
		DuplicateCompilerModuleTarget(identity):
			"duplicate typecheck module target '" + identity + "'"
		UnknownCompilerModuleTarget(identity):
			"unknown typecheck module target '" + identity + "'"
		UnknownCompilerModuleTableIndex(index):
			"unknown typecheck module table index '" + index.to_string() + "'"
		IncompatibleCompilerModuleTable:
			"typecheck module IDs were issued by an incompatible module table"
		CompilerModuleTableLengthMismatch(expected, actual):
			"compiler module table has '" + expected.to_string() + "' rows but received '" + actual.to_string() + "' prepared module payloads"
		CompilerModuleTableIdentityMismatch(index, expected, actual):
			"compiler module table row '" + index.to_string() + "' names '" + expected + "' but its prepared module payload names '" + actual + "'"


private pure func indexed_graph_error_from_loaded_module_set_error(
	error: LoadedModuleSetError,
) -> IndexedGraphError:
	DuplicateCompilerModuleIdentity(error.identity, error.first_path, error.duplicate_path)


private pure func indexed_graph_error_from_module_table_error(
	error: ModuleTableError,
) -> IndexedGraphError:
	match error:
		DuplicateModuleTableIdentity(identity):
			canonical_path = resolved_module_canonical_path(identity)
			DuplicateCompilerModuleIdentity(
				module_identity_from_resolved(identity),
				canonical_path,
				canonical_path,
			)
		ConflictingModuleTableOrigins(first, _):
			ConflictingCompilerModuleOrigins(resolved_module_canonical_path(first))


private record GraphSelectiveExportDemand {
	names_by_module: List[ExportedDefinitionNameDemand],
	conservative_names: ExportedDefinitionNameDemand
}


private record GraphSelectiveExportScatter {
	next_write_by_module: List[Int],
	ordered_names: List[String]
}


-- Count and scatter traverse the same declarations, so every retained slot is
-- overwritten before publication. Naming the initializer keeps that private
-- construction invariant explicit; it is never used as a lookup sentinel.
private UNFILLED_SELECTIVE_EXPORT_NAME: String = ""


private pure func selective_export_request_module_index(
	module_table: ModuleTable,
	conservative_module_index: Int,
	import_decl: ParsedImportDecl,
) -> Int:
	match module_table_find_id_by_canonical_path(module_table, import_decl.module_path):
		Some(module_id):
			module_id_table_index(module_id)
		None:
			-- Finalized programs normally carry canonical import paths. Preserve
			-- correctness for recovery or direct compiler fixtures by applying an
			-- unresolved request conservatively instead of guessing an identity.
			conservative_module_index


private pure func selective_export_request_counts_for_import(
	request_count_by_module: List[Int],
	module_table: ModuleTable,
	conservative_module_index: Int,
	import_decl: ParsedImportDecl,
) -> List[Int]:
	match import_decl.symbols:
		None:
			request_count_by_module
		Some(symbols):
			module_index = selective_export_request_module_index(
				module_table,
				conservative_module_index,
				import_decl,
			)
			request_count_by_module.set(
				module_index,
				request_count_by_module.get_or(module_index, 0) + symbols.length(),
			)


private pure func selective_export_request_counts_for_decl(
	request_count_by_module: List[Int],
	module_table: ModuleTable,
	conservative_module_index: Int,
	decl: ParsedDecl,
) -> List[Int]:
	match decl:
		ImportBlockParsedDecl(imports, _):
			var counts = request_count_by_module

			for import_decl in imports:
				counts = selective_export_request_counts_for_import(
					counts,
					module_table,
					conservative_module_index,
					import_decl,
				)

			counts
		PrivateParsedDecl(inner, _):
			selective_export_request_counts_for_decl(
				request_count_by_module,
				module_table,
				conservative_module_index,
				inner,
			)
		_:
			request_count_by_module


private pure func selective_export_name_demand(
	module_table: ModuleTable,
	modules: List[PreparedModule],
) -> GraphSelectiveExportDemand:
	conservative_module_index = modules.length()
	bucket_count = conservative_module_index + 1
	var request_count_by_module: List[Int] = 0.repeat(bucket_count)

	for module in modules:
		for decl in prepared_module_program(module).decls:
			request_count_by_module = selective_export_request_counts_for_decl(
				request_count_by_module,
				module_table,
				conservative_module_index,
				decl,
			)

	var bucket_start_by_module: List[Int] = []
	var next_write_by_module: List[Int] = []
	var next_bucket_start: Int = 0

	for request_count in request_count_by_module:
		bucket_start_by_module = bucket_start_by_module.append(next_bucket_start)
		next_write_by_module = next_write_by_module.append(next_bucket_start)
		next_bucket_start += request_count

	var ordered_names = repeat(UNFILLED_SELECTIVE_EXPORT_NAME, next_bucket_start)

	-- Keep both scatter columns as local owners while they are updated. A
	-- GraphSelectiveExportScatter retained through this loop would keep the
	-- lists shared and turn every set into a full COW copy.
	for module in modules:
		for decl in prepared_module_program(module).decls:
			var scatter_decl = decl
			var scatter_decl_complete = False

			-- PrivateParsedDecl is a transparent wrapper here. Iteration keeps the
			-- owned scatter columns in this function instead of borrowing them
			-- through a recursive helper boundary.
			while not scatter_decl_complete:
				match scatter_decl:
					ImportBlockParsedDecl(imports, _):
						for import_decl in imports:
							match import_decl.symbols:
								None:
									void
								Some(symbols):
									module_index = selective_export_request_module_index(
										module_table,
										conservative_module_index,
										import_decl,
									)

									for symbol in symbols:
										write_index = next_write_by_module.get_or(module_index, 0)
										next_write_by_module = next_write_by_module.set(
											module_index,
											write_index + 1,
										)
										ordered_names = ordered_names.set(
											write_index,
											symbol.name.text,
										)

						scatter_decl_complete = True
					PrivateParsedDecl(inner, _):
						scatter_decl = inner
					_:
						scatter_decl_complete = True

	-- Publish the completed columns only after no later scatter update can
	-- observe the record as an alias.
	scatter: GraphSelectiveExportScatter = {
		next_write_by_module = next_write_by_module,
		ordered_names = ordered_names
	}

	var names_by_module: List[ExportedDefinitionNameDemand] = []
	var conservative_names = exported_definition_name_demand_empty()

	-- Count/offset/scatter groups requests in linear work without a sort. Each
	-- demand bucket remains uniquely owned while it grows and is published only
	-- after completion, avoiding a retained Set copy for every later name.
	for module_index in 0..bucket_count:
		start = bucket_start_by_module.get_or(module_index, 0)
		end = start + request_count_by_module.get_or(module_index, 0)
		var module_demand = exported_definition_name_demand_empty()

		for request_index in start..end:
			match scatter.ordered_names.get(request_index):
				Some(name):
					module_demand = exported_definition_name_demand_add(module_demand, name)
				None:
					void

		if module_index == conservative_module_index:
			conservative_names = module_demand
		else:
			names_by_module = names_by_module.append(module_demand)

	{
		names_by_module = names_by_module,
		conservative_names = conservative_names
	}


private pure func indexed_graph_from_loaded_modules(
	module_table: ModuleTable,
	loaded_modules: LoadedModuleSet,
	target_id: ModuleId,
) -> Option[IndexedGraph]:
	definition_index ?= definition_index_for_loaded_modules(
		definition_index_initial_seed(ENV_EMPTY),
		module_table,
		loaded_modules,
	)
	target = prepared_module_from_loaded(loaded_module_set_target(loaded_modules))
	loaded_dependencies = loaded_module_set_modules(loaded_modules)
	target_index = module_id_table_index(target_id)
	var prepared_modules: List[PreparedModule] = []
	var dependency_index: Int = 0
	var table_index: Int = 0

	while table_index < loaded_dependencies.length() + 1:
		if table_index == target_index:
			prepared_modules = prepared_modules.append(target)
		else:
			match loaded_dependencies.get(dependency_index):
				Some(module):
					prepared_modules = prepared_modules.append(prepared_module_from_loaded(module))
					dependency_index += 1
				None:
					void

		table_index += 1

	selective_export_names = selective_export_name_demand(module_table, prepared_modules)

	representation: IndexedGraphRep = {
		target = target,
		module_table = module_table,
		prepared_modules = prepared_modules,
		target_id = target_id,
		definition_index = definition_index,
		graph_source_names = graph_source_name_table_for_programs(
			module_table,
			prepared_modules.map(prepared_module_program),
		),
		selective_export_names_by_module = selective_export_names.names_by_module,
		conservative_selective_export_names = selective_export_names.conservative_names
	}
	Some(into_opaque IndexedGraph(representation))


private pure func module_candidate_validation_errors(
	target_candidate: ModuleLoadCandidate,
	module_candidates: List[ModuleLoadCandidate],
) -> List[IndexedGraphError]:
	candidates = [target_candidate].concat(module_candidates)
	var first_origin_by_path: Dict[String, ModuleOrigin] = {}
	var conflicting_paths: Dict[String, Bool] = {}
	var errors: List[IndexedGraphError] = []

	for candidate in candidates:
		canonical_path = module_load_candidate_canonical_path(candidate)
		origin = module_load_candidate_origin(candidate)

		if embedded_std_contains_module(canonical_path):
			match origin:
				StdlibModule:
					void
				_:
					errors = errors.append(ReservedCompilerStandardLibraryPath(canonical_path))

		match first_origin_by_path.get(canonical_path):
			Some(first_origin):
				if (
					not module_origins_equal(first_origin, origin)
					and not conflicting_paths.contains(canonical_path)
				):
					conflicting_paths = conflicting_paths.set(canonical_path, True)
					errors = errors.append(ConflictingCompilerModuleOrigins(canonical_path))
			None:
				first_origin_by_path = first_origin_by_path.set(canonical_path, origin)

	errors


private pure func module_table_alignment_errors(
	table: ModuleTable,
	module_candidates: List[ModuleLoadCandidate],
) -> List[IndexedGraphError]:
	var errors: List[IndexedGraphError] = []

	if module_table_count(table) != module_candidates.length():
		errors = errors.append(
			CompilerModuleTableLengthMismatch(
				module_table_count(table),
				module_candidates.length(),
			),
		)

	var index: Int = 0

	for candidate in module_candidates:
		match module_table_id_at(table, index):
			None:
				void
			Some(module_id):
				actual = module_load_candidate_resolved_identity(candidate)

				if not module_table_id_matches_identity(table, module_id, actual):
					match module_table_canonical_path(table, module_id):
						Some(expected_path):
							errors = errors.append(
								CompilerModuleTableIdentityMismatch(
									index,
									expected_path,
									resolved_module_canonical_path(actual),
								),
							)
						None:
							errors = errors.append(UnknownCompilerModuleTableIndex(index))

		index += 1

	errors


pure func indexed_graph_build(
	target_candidate: ModuleLoadCandidate,
	module_candidates: List[ModuleLoadCandidate],
) -> Result[IndexedGraph, List[IndexedGraphError]]:
	validation_errors = module_candidate_validation_errors(target_candidate, module_candidates)

	if validation_errors.length() > 0:
		Err(validation_errors)
	else:
		match loaded_module_set(target_candidate, module_candidates):
			Err(errors):
				Err(errors.map(indexed_graph_error_from_loaded_module_set_error))
			Ok(loaded_modules):
				identities = [target_candidate]
					.concat(module_candidates)
					.map(module_load_candidate_resolved_identity)

				match module_table(identities):
					Err(errors):
						Err(errors.map(indexed_graph_error_from_module_table_error))
					Ok(table):
						match module_table_id_at(table, 0):
							None:
								Err([UnknownCompilerModuleTableIndex(0)])
							Some(target_id):
								match indexed_graph_from_loaded_modules(
									table,
									loaded_modules,
									target_id,
								):
									Some(graph):
										Ok(graph)
									None:
										Err([IncompatibleCompilerModuleTable])


private pure func indexed_graph_build_for_module_table_id(
	module_table: ModuleTable,
	module_candidates: List[ModuleLoadCandidate],
	target_id: ModuleId,
) -> Result[IndexedGraph, List[IndexedGraphError]]:
	target_index = module_id_table_index(target_id)
	alignment_errors = module_table_alignment_errors(module_table, module_candidates)

	if alignment_errors.length() > 0:
		Err(alignment_errors)
	else:
		match module_candidates.get(target_index):
			None:
				Err([UnknownCompilerModuleTableIndex(target_index)])
			Some(target_candidate):
				var dependencies: List[ModuleLoadCandidate] = []
				var module_index: Int = 0

				for candidate in module_candidates:
					if module_index != target_index:
						dependencies = dependencies.append(candidate)

					module_index += 1

				validation_errors = module_candidate_validation_errors(
					target_candidate,
					dependencies,
				)

				if validation_errors.length() > 0:
					Err(validation_errors)
				else:
					match loaded_module_set(target_candidate, dependencies):
						Err(errors):
							Err(errors.map(indexed_graph_error_from_loaded_module_set_error))
						Ok(loaded_modules):
							match indexed_graph_from_loaded_modules(
								module_table,
								loaded_modules,
								target_id,
							):
								Some(graph):
									Ok(graph)
								None:
									Err([IncompatibleCompilerModuleTable])


pure func indexed_graph_build_for_module_table(
	module_table: ModuleTable,
	module_candidates: List[ModuleLoadCandidate],
	target_candidate: ModuleLoadCandidate,
) -> Result[IndexedGraph, List[IndexedGraphError]]:
	match module_table_find_id(
		module_table,
		module_load_candidate_resolved_identity(target_candidate),
	):
		None:
			Err(
				[
					UnknownCompilerModuleTarget(
						module_load_candidate_canonical_path(target_candidate),
					),
				],
			)
		Some(target_id):
			indexed_graph_build_for_module_table_id(module_table, module_candidates, target_id)


pure func indexed_graph_target(graph: IndexedGraph) -> PreparedModule:
	representation: IndexedGraphRep = from_opaque IndexedGraph(graph)
	representation.target


pure func indexed_graph_modules(graph: IndexedGraph) -> List[PreparedModule]:
	representation: IndexedGraphRep = from_opaque IndexedGraph(graph)
	var modules: List[PreparedModule] = []
	var module_index: Int = 0
	target_index = module_id_table_index(representation.target_id)

	for module in representation.prepared_modules:
		if module_index != target_index:
			modules = modules.append(module)

		module_index += 1

	modules


pure func indexed_graph_module_count(graph: IndexedGraph) -> Int:
	module_table_count(from_opaque IndexedGraph(graph).module_table)


pure func indexed_graph_module_table(graph: IndexedGraph) -> ModuleTable:
	from_opaque IndexedGraph(graph).module_table


pure func indexed_graph_source_name_table(graph: IndexedGraph) -> SourceNameTable:
	graph_source_name_table_source_names(from_opaque IndexedGraph(graph).graph_source_names)


---
Selective export demand is normalized once at graph construction, after
import-path finalization and ModuleId assignment. Repeated admission reads
the dense row through its graph-issued scope instead of accepting a raw ID.
---
pure func prepared_module_scope_selective_export_names(
	scope: PreparedModuleScope,
) -> ExportedDefinitionNameDemand:
	scope_representation: PreparedModuleScopeRep = from_opaque PreparedModuleScope(scope)
	graph_representation: IndexedGraphRep = from_opaque IndexedGraph(scope_representation.graph)

	match graph_representation.selective_export_names_by_module.get(
		module_id_table_index(scope_representation.module_id),
	):
		Some(found_demand):
			found_demand
		None:
			exported_definition_name_demand_empty()


pure func prepared_module_scope_conservative_selective_export_names(
	scope: PreparedModuleScope,
) -> ExportedDefinitionNameDemand:
	scope_representation: PreparedModuleScopeRep = from_opaque PreparedModuleScope(scope)
	graph_representation: IndexedGraphRep = from_opaque IndexedGraph(scope_representation.graph)
	graph_representation.conservative_selective_export_names


pure func indexed_graph_graph_source_name_table(graph: IndexedGraph) -> GraphSourceNameTable:
	from_opaque IndexedGraph(graph).graph_source_names


private pure func indexed_graph_module_for_id(
	graph: IndexedGraph,
	id: ModuleId,
) -> Option[PreparedModule]:
	from_opaque IndexedGraph(graph).prepared_modules.get(module_id_table_index(id))


pure func indexed_graph_find_dependency(
	graph: IndexedGraph,
	canonical_path: String,
) -> Option[PreparedModule]:
	representation: IndexedGraphRep = from_opaque IndexedGraph(graph)
	module_id ?= module_table_find_id_by_canonical_path(representation.module_table, canonical_path)

	if module_ids_equal(module_id, representation.target_id):
		None
	else:
		representation.prepared_modules.get(module_id_table_index(module_id))


pure func indexed_graph_select_dependencies(
	graph: IndexedGraph,
	canonical_paths: List[String],
) -> Result[List[PreparedModule], List[IndexedGraphError]]:
	var selected: List[PreparedModule] = []
	var seen: Dict[String, Bool] = {}
	var errors: List[IndexedGraphError] = []

	for canonical_path in canonical_paths:
		if seen.contains(canonical_path):
			errors = errors.append(DuplicateCompilerModuleTarget(canonical_path))
		else:
			seen = seen.set(canonical_path, True)

			match indexed_graph_find_dependency(graph, canonical_path):
				Some(module):
					selected = selected.append(module)
				None:
					errors = errors.append(UnknownCompilerModuleTarget(canonical_path))

	if errors.length() == 0:
		Ok(selected)
	else:
		Err(errors)


pure func indexed_graph_definition_index(graph: IndexedGraph) -> DefinitionIndex:
	representation: IndexedGraphRep = from_opaque IndexedGraph(graph)
	representation.definition_index


pure func indexed_graph_module_scopes(graph: IndexedGraph) -> List[PreparedModuleScope]:
	representation: IndexedGraphRep = from_opaque IndexedGraph(graph)
	var scopes: List[PreparedModuleScope] = []
	var module_index: Int = 0
	target_index = module_id_table_index(representation.target_id)

	for _module in representation.prepared_modules:
		if module_index != target_index:
			match module_table_id_at(representation.module_table, module_index):
				Some(module_id):
					scopes = scopes.append(prepared_module_scope(graph, module_id))
				None:
					void

		module_index += 1

	scopes


private pure func indexed_graph_select_dependency_scopes_for_table(
	graph: IndexedGraph,
	module_ids: List[ModuleId],
) -> Result[List[PreparedModuleScope], List[IndexedGraphError]]:
	representation: IndexedGraphRep = from_opaque IndexedGraph(graph)
	var scopes: List[PreparedModuleScope] = []
	var seen: Dict[Int, Bool] = {}
	var errors: List[IndexedGraphError] = []

	for module_id in module_ids:
		module_index = module_id_table_index(module_id)

		match representation.prepared_modules.get(module_index):
			None:
				errors = errors.append(UnknownCompilerModuleTableIndex(module_index))
			Some(module):
				canonical_path = prepared_module_canonical_path(module)

				if seen.contains(module_index):
					errors = errors.append(DuplicateCompilerModuleTarget(canonical_path))
				else:
					seen = seen.set(module_index, True)

					if module_ids_equal(module_id, representation.target_id):
						errors = errors.append(UnknownCompilerModuleTarget(canonical_path))
					else:
						scopes = scopes.append(prepared_module_scope(graph, module_id))

	if errors.is_empty():
		Ok(scopes)
	else:
		Err(errors)


pure func indexed_graph_select_dependency_scopes_by_id(
	graph: IndexedGraph,
	issuing_table: ModuleTable,
	module_ids: List[ModuleId],
) -> Result[List[PreparedModuleScope], List[IndexedGraphError]]:
	representation: IndexedGraphRep = from_opaque IndexedGraph(graph)

	if module_tables_are_compatible(representation.module_table, issuing_table):
		indexed_graph_select_dependency_scopes_for_table(graph, module_ids)
	else:
		Err([IncompatibleCompilerModuleTable])


private pure func prepared_module_scope(
	graph: IndexedGraph,
	module_id: ModuleId,
) -> PreparedModuleScope:
	representation: PreparedModuleScopeRep = {
		graph = graph,
		module_id = module_id
	}
	into_opaque PreparedModuleScope(representation)


pure func indexed_graph_select_dependency_scopes(
	graph: IndexedGraph,
	canonical_paths: List[String],
) -> Result[List[PreparedModuleScope], List[IndexedGraphError]]:
	match indexed_graph_select_dependencies(graph, canonical_paths):
		Err(errors):
			Err(errors)
		Ok(modules):
			var scopes: List[PreparedModuleScope] = []

			for module in modules:
				match indexed_graph_find_dependency_scope(
					graph,
					prepared_module_canonical_path(module),
				):
					Some(scope):
						scopes = scopes.append(scope)
					None:
						void

			Ok(scopes)


pure func indexed_graph_target_scope(graph: IndexedGraph) -> PreparedModuleScope:
	representation: IndexedGraphRep = from_opaque IndexedGraph(graph)
	prepared_module_scope(graph, representation.target_id)


pure func indexed_graph_find_dependency_scope(
	graph: IndexedGraph,
	canonical_path: String,
) -> Option[PreparedModuleScope]:
	representation: IndexedGraphRep = from_opaque IndexedGraph(graph)
	module_id ?= module_table_find_id_by_canonical_path(representation.module_table, canonical_path)

	if module_ids_equal(module_id, representation.target_id):
		None
	else:
		Some(prepared_module_scope(graph, module_id))


pure func prepared_module_scope_find_module(
	scope: PreparedModuleScope,
	canonical_path: String,
) -> Option[PreparedModuleScope]:
	representation: PreparedModuleScopeRep = from_opaque PreparedModuleScope(scope)

	if prepared_module_canonical_path(indexed_graph_target(representation.graph)) == canonical_path:
		Some(indexed_graph_target_scope(representation.graph))
	else:
		indexed_graph_find_dependency_scope(representation.graph, canonical_path)


pure func prepared_module_scope_module(scope: PreparedModuleScope) -> PreparedModule:
	representation: PreparedModuleScopeRep = from_opaque PreparedModuleScope(scope)
	graph_representation: IndexedGraphRep = from_opaque IndexedGraph(representation.graph)
	indexed_graph_module_for_id(
		representation.graph,
		representation.module_id,
	).get_or(graph_representation.target)


pure func prepared_module_scope_id(scope: PreparedModuleScope) -> ModuleId:
	from_opaque PreparedModuleScope(scope).module_id


pure func prepared_module_scope_definition_index(scope: PreparedModuleScope) -> DefinitionIndex:
	representation: PreparedModuleScopeRep = from_opaque PreparedModuleScope(scope)
	indexed_graph_definition_index(representation.graph)


pure func prepared_module_scope_module_table(scope: PreparedModuleScope) -> ModuleTable:
	representation: PreparedModuleScopeRep = from_opaque PreparedModuleScope(scope)
	indexed_graph_module_table(representation.graph)


pure func prepared_module_scope_source_name_table(scope: PreparedModuleScope) -> SourceNameTable:
	representation: PreparedModuleScopeRep = from_opaque PreparedModuleScope(scope)
	indexed_graph_source_name_table(representation.graph)


pure func prepared_module_scope_graph_source_name_table(
	scope: PreparedModuleScope,
) -> GraphSourceNameTable:
	representation: PreparedModuleScopeRep = from_opaque PreparedModuleScope(scope)
	indexed_graph_graph_source_name_table(representation.graph)


pure func prepared_module_scope_graph_module_name_scope(
	scope: PreparedModuleScope,
) -> GraphModuleNameScope:
	representation: PreparedModuleScopeRep = from_opaque PreparedModuleScope(scope)
	graph_module_name_scope(
		indexed_graph_graph_source_name_table(representation.graph),
		representation.module_id,
	)


pure func prepared_module_scope_identity(scope: PreparedModuleScope) -> ModuleIdentity:
	prepared_module_identity(prepared_module_scope_module(scope))


pure func prepared_module_scope_canonical_path(scope: PreparedModuleScope) -> String:
	prepared_module_canonical_path(prepared_module_scope_module(scope))


pure func prepared_module_scope_origin(scope: PreparedModuleScope) -> ModuleOrigin:
	prepared_module_origin(prepared_module_scope_module(scope))


private pure func prepared_module_surfaces_are_equal(
	left: PreparedModule,
	right: PreparedModule,
) -> Bool:
	match (prepared_module_surface(left), prepared_module_surface(right)):
		(None, None):
			True
		(Some(left_surface), Some(right_surface)):
			(
				module_surface_to_json(left_surface).to_string()
				== module_surface_to_json(right_surface).to_string()
			)
		_:
			False


private pure func prepared_modules_are_equal(left: PreparedModule, right: PreparedModule) -> Bool:
	(
		module_identities_equal(prepared_module_identity(left), prepared_module_identity(right))
		and module_origins_equal(prepared_module_origin(left), prepared_module_origin(right))
		and parsed_programs_are_equal(prepared_module_program(left), prepared_module_program(right))
		and prepared_module_surfaces_are_equal(left, right)
	)


private pure func prepared_module_lists_are_equal(
	left: List[PreparedModule],
	right: List[PreparedModule],
) -> Bool:
	if left.length() != right.length():
		False
	else:
		var index: Int = 0
		var equal: Bool = True

		while index < left.length() and equal:
			match (left.get(index), right.get(index)):
				(Some(left_module), Some(right_module)):
					equal = prepared_modules_are_equal(left_module, right_module)
				_:
					equal = False

			index += 1

		equal


private pure func indexed_graphs_are_equal(left: IndexedGraph, right: IndexedGraph) -> Bool:
	left_representation: IndexedGraphRep = from_opaque IndexedGraph(left)
	right_representation: IndexedGraphRep = from_opaque IndexedGraph(right)

	(
		prepared_modules_are_equal(left_representation.target, right_representation.target)
		and prepared_module_lists_are_equal(
			left_representation.prepared_modules,
			right_representation.prepared_modules,
		)
		and module_ids_equal(left_representation.target_id, right_representation.target_id)
	)


pure func prepared_module_scopes_are_compatible(
	left: PreparedModuleScope,
	right: PreparedModuleScope,
) -> Bool:
	left_representation: PreparedModuleScopeRep = from_opaque PreparedModuleScope(left)
	right_representation: PreparedModuleScopeRep = from_opaque PreparedModuleScope(right)

	(
		indexed_graphs_are_same_allocation(left_representation.graph, right_representation.graph)
		or indexed_graphs_are_equal(left_representation.graph, right_representation.graph)
	)


pure func prepared_module_scopes_select_same_module(
	left: PreparedModuleScope,
	right: PreparedModuleScope,
) -> Bool:
	(
		prepared_module_scopes_are_compatible(left, right)
		and module_ids_equal(prepared_module_scope_id(left), prepared_module_scope_id(right))
	)


---
Return the requested module's table position only when both scopes prove
the same complete graph and therefore the same issuing-table order.
---
pure func prepared_module_scope_compatible_index(
	owner: PreparedModuleScope,
	requested: PreparedModuleScope,
) -> Option[Int]:
	requested_representation: PreparedModuleScopeRep = from_opaque PreparedModuleScope(requested)
	graph_representation: IndexedGraphRep = from_opaque IndexedGraph(requested_representation.graph)
	module_index = module_id_table_index(requested_representation.module_id)
	module_count = module_table_count(graph_representation.module_table)

	if (
		prepared_module_scopes_are_compatible(owner, requested)
		and module_index >= 0
		and module_index < module_count
	):
		Some(module_index)
	else:
		None
