		LoadedModule,
		LoadedModuleSet,
		LoadedModuleSetError,
		ModuleIdentity,
		ModuleLoadCandidate,
		ModuleOrigin(StdlibModule),
		loaded_module_canonical_path,
		loaded_module_identity,
		loaded_module_origin,
		loaded_module_program,
		loaded_module_set,
		loaded_module_set_modules,
		loaded_module_set_target,
		loaded_module_surface,
		module_identities_equal,
		module_identity_display_name,
		module_identity_from_resolved,
		module_load_candidate_canonical_path,
		module_load_candidate_origin,
		module_load_candidate_resolved_identity,
		module_origins_equal,
		resolved_module_canonical_path,
	../../stage_04_modules/module_surface: ModuleSurface
	../../stage_04_modules/module_surface_json: module_surface_to_json
	../../stage_04_modules/module_table:
		ModuleId,
		ModuleTable,
		ModuleTableError(ConflictingModuleTableOrigins, DuplicateModuleTableIdentity),
		module_id_table_index,
		module_ids_equal,
