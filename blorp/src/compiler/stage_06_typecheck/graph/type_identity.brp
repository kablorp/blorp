-- Stable accepted type identity shared below the declaration-header layer.
--
-- A type's owner, source name, and defining span form its nominal identity.
-- Keeping this small type below declaration skeletons lets inference retain
-- graph-owned type authority without importing bound-module construction back
-- through the header layer.
import:
	../../../lib/source: SourceSpan, source_spans_equal
	indexed_graph: PreparedModuleId, prepared_module_id_table_index, prepared_module_ids_equal


private record TypeIdRep {
	module_id: PreparedModuleId,
	name: String,
	span: SourceSpan
}


opaque type TypeId = TypeIdRep


pure func type_id(module_id: PreparedModuleId, name: String, span: SourceSpan) -> TypeId:
	into_opaque TypeId({
			module_id = module_id,
			name = name,
			span = span
		})


pure func type_ids_equal(left: TypeId, right: TypeId) -> Bool:
	left_rep = from_opaque TypeId(left)
	right_rep = from_opaque TypeId(right)

	(
		prepared_module_ids_equal(left_rep.module_id, right_rep.module_id)
		and left_rep.name == right_rep.name
		and source_spans_equal(left_rep.span, right_rep.span)
	)


pure func type_id_name(id: TypeId) -> String:
	from_opaque TypeId(id).name


pure func type_id_module_id(id: TypeId) -> PreparedModuleId:
	from_opaque TypeId(id).module_id


pure func type_id_source_span(id: TypeId) -> SourceSpan:
	from_opaque TypeId(id).span


-- Dictionary lookup narrows candidates by stable owner and source name. Exact
-- query APIs still compare the complete TypeId, including the source span.
pure func type_id_storage_key(id: TypeId) -> String:
	prepared_module_id_table_index(type_id_module_id(id)).to_string() + "\n" + type_id_name(id)
