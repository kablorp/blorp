import:
	../../../lib/source: SourceSpan
	../../stage_04_modules/module_table: ModuleId
	definition_index:
		DefinitionId,
		DefinitionTable,
		definition_id_runtime_value,
		definition_ids_equal,
		definition_table_type_definition_id,
		definition_table_type_row,


opaque type TypeId = DefinitionId


pure func type_id_from_definition_table(
	table: DefinitionTable,
	runtime_definition_id: Int,
) -> Option[TypeId]:
	definition_table_type_definition_id(
		table,
		runtime_definition_id,
	).map(func(id): into_opaque TypeId(id))

pure func type_id_definition_id(id: TypeId) -> Int:
	definition_id_runtime_value(from_opaque TypeId(id))


pure func type_ids_equal(left: TypeId, right: TypeId) -> Bool:
	definition_ids_equal(from_opaque TypeId(left), from_opaque TypeId(right))


pure func type_id_name(table: DefinitionTable, id: TypeId) -> Option[String]:
	definition_table_type_row(table, type_id_definition_id(id)).map(func(row): row.name)


pure func type_id_module_id(table: DefinitionTable, id: TypeId) -> Option[ModuleId]:
	definition_table_type_row(
		table,
		type_id_definition_id(id),
	).map(func(row): row.module_id)


pure func type_id_source_span(table: DefinitionTable, id: TypeId) -> Option[SourceSpan]:
	definition_table_type_row(table, type_id_definition_id(id)).map(func(row): row.span)
