-- Phase-neutral storage and exact provenance for the frozen definition table.
-- Semantic meta identity may retain this table without importing the graph
-- index, which itself depends on semantic types through its bootstrap Env.
import:
	../../../lib/source: SourceLocation
	../../stage_04_modules/module_table: ModuleId, ModuleTable


enum DefinitionRowKind:
	CallableDefinitionKind
	TypeDefinitionKind
	ConstructorDefinitionKind
	FieldDefinitionKind
	GlobalDefinitionKind
	TraitDefinitionKind
	ImplementationDefinitionKind


record DefinitionTableRow {
	module_id: ModuleId,
	kind: DefinitionRowKind,
	name: String,
	owner_name: Option[String],
	span: SourceLocation
}


private record DefinitionTableRep {
	module_table: ModuleTable,
	first_graph_definition_id: Int,
	rows: List[DefinitionTableRow]
}


opaque type DefinitionTable = DefinitionTableRep


foreign(include: "definition_index_ffi.h"):
	private pure func definition_tables_are_same_allocation(
		left: DefinitionTable,
		right: DefinitionTable,
	) -> Bool = "blorp_compiler_definition_tables_are_same_allocation"


pure func definition_table_from_rows(
	module_table: ModuleTable,
	first_graph_definition_id: Int,
	rows: List[DefinitionTableRow],
) -> DefinitionTable:
	into_opaque DefinitionTable({
			module_table = module_table,
			first_graph_definition_id = first_graph_definition_id,
			rows = rows
		})


pure func definition_table_append_row(
	table: DefinitionTable,
	row: DefinitionTableRow,
) -> DefinitionTable:
	representation = from_opaque DefinitionTable(table)
	into_opaque DefinitionTable({ representation | rows = representation.rows.append(row) })


pure func definition_table_with_module_table(
	table: DefinitionTable,
	module_table: ModuleTable,
) -> DefinitionTable:
	representation = from_opaque DefinitionTable(table)
	into_opaque DefinitionTable({ representation | module_table = module_table })


pure func definition_table_storage_module_table(table: DefinitionTable) -> ModuleTable:
	from_opaque DefinitionTable(table).module_table


pure func definition_table_first_graph_definition_id(table: DefinitionTable) -> Int:
	from_opaque DefinitionTable(table).first_graph_definition_id


pure func definition_table_rows(table: DefinitionTable) -> List[DefinitionTableRow]:
	from_opaque DefinitionTable(table).rows


-- Allocation identity, not structural equality: two source-identical graphs
-- issue different definition authorities while copies preserve provenance.
pure func definition_tables_share_provenance(left: DefinitionTable, right: DefinitionTable) -> Bool:
	definition_tables_are_same_allocation(left, right)
