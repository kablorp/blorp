-- Stable source identities shared by graph indexing and typechecking.
--
-- These keys describe source declarations, not mutable typecheck state. Keeping
-- them graph-owned prevents the definition index from depending on the broad
-- state record that later phases consume.
import:
	../../../lib/source: SourceSpan, source_spans_equal
	../../stage_04_modules/loaded_module:
		ModuleIdentity,
		module_identities_equal,
		module_identity_display_name,
		module_identity_storage_key,
	../../stage_05_types/generic_params: BoundTypeParam
	../../stage_05_types/semantic_type:
		SemanticDimOp(SemanticDimAdd, SemanticDimDivide, SemanticDimMultiply, SemanticDimSubtract),
		SemanticType(
			SemanticArrayType,
			SemanticConstIntType,
			SemanticDimOpType,
			SemanticFunctionType,
			SemanticMetaType,
			SemanticNamedType,
			SemanticRangeType,
			SemanticSelfType,
			SemanticTupleType,
			SemanticTypeVar,
			SemanticVarDimsType,
		),


private record FuncCallableKeyRep {
	module_identity: ModuleIdentity,
	name: String,
	span: SourceSpan
}


opaque type FuncCallableKey = FuncCallableKeyRep


enum SourceDefinitionKind:
	ConstructorDefinition
	TraitDefinition
	ImplDefinition
	GlobalDefinition
	TypeDefinition
	FieldDefinition


private record SourceDefinitionKeyRep {
	module_identity: ModuleIdentity,
	kind: SourceDefinitionKind,
	name: String,
	owner: Option[String],
	span: SourceSpan
}


opaque type SourceDefinitionKey = SourceDefinitionKeyRep


enum ExportedSymbolKind:
	ExportedFunction
	ExportedGlobal
	ExportedType
	ExportedConstructor
	ExportedTrait
	ExportedMethod
	ExportedField


-- Artifact-local semantic identities need the same category precision as
-- exported keys. Definition integers are unique today, but carrying kind here
-- lets downstream capability boundaries reject structurally valid symbols
-- from the wrong category without trusting the extractor that produced them.
enum SemanticSymbolKind:
	SemanticFunction
	SemanticForeignFunction
	SemanticMethod
	SemanticGlobal
	SemanticTypeSymbol
	SemanticConstructor
	SemanticTrait
	SemanticField
	SemanticParameter
	SemanticLocal


enum ExportedCallableKind:
	ExportedCallableFunction
	ExportedCallableMethod


enum ExportedNamedKind:
	ExportedNamedGlobal
	ExportedNamedType
	ExportedNamedConstructor
	ExportedNamedTrait
	ExportedNamedField


private union ExportedTypeShape:
	ExportedNamedTypeShape(String, List[ExportedTypeShape])
	ExportedArrayTypeShape(ExportedTypeShape, List[ExportedTypeShape])
	ExportedFunctionTypeShape(Bool, List[ExportedTypeShape], ExportedTypeShape)
	ExportedTypeParameterShape(Int)
	ExportedConstIntTypeShape(Int)
	ExportedTupleTypeShape(List[ExportedTypeShape])
	ExportedSelfTypeShape
	ExportedDimParameterShape(Int)
	ExportedRangeTypeShape(ExportedTypeShape)
	ExportedDimOpTypeShape(SemanticDimOp, ExportedTypeShape, ExportedTypeShape)


private record ExportedCallableSignature {
	type_parameter_bounds: List[List[String]],
	function_type: ExportedTypeShape
}


-- Cross-artifact identity uses only declaration-owned semantic facts.
-- Callable signatures are structured and alpha-normalized; implementation
-- text, source position, declaration order, and artifact-local IDs are absent.
private record ExportedSymbolKeyRep {
	module_identity: ModuleIdentity,
	kind: ExportedSymbolKind,
	owner: Option[String],
	name: String,
	callable_signature: Option[ExportedCallableSignature]
}


opaque type ExportedSymbolKey = ExportedSymbolKeyRep


pure func func_callable_key(
	module_identity: ModuleIdentity,
	name: String,
	span: SourceSpan,
) -> FuncCallableKey:
	representation: FuncCallableKeyRep = {
		module_identity = module_identity,
		name = name,
		span = span
	}
	into FuncCallableKey(representation)


pure func source_definition_key(
	module_identity: ModuleIdentity,
	kind: SourceDefinitionKind,
	name: String,
	owner: Option[String],
	span: SourceSpan,
) -> SourceDefinitionKey:
	representation: SourceDefinitionKeyRep = {
		module_identity = module_identity,
		kind = kind,
		name = name,
		owner = owner,
		span = span
	}
	into SourceDefinitionKey(representation)


private pure func exported_type_shape_list(
	types: List[SemanticType],
	type_parameter_indexes: Dict[String, Int],
) -> Option[List[ExportedTypeShape]]:
	var shapes: List[ExportedTypeShape] = []
	var valid: Bool = True

	for typ in types:
		if valid:
			match exported_type_shape(typ, type_parameter_indexes):
				Some(shape):
					shapes = shapes.append(shape)
				None:
					valid = False

	if valid:
		Some(shapes)
	else:
		None


private pure func exported_type_shape(
	typ: SemanticType,
	type_parameter_indexes: Dict[String, Int],
) -> Option[ExportedTypeShape]:
	match typ:
		SemanticNamedType(name, args):
			match (type_parameter_indexes.get(name), args):
				(Some(index), []):
					Some(ExportedTypeParameterShape(index))
				_:
					shapes ?= exported_type_shape_list(args, type_parameter_indexes)
					Some(ExportedNamedTypeShape(name, shapes))
		SemanticArrayType(element, dims):
			element_shape ?= exported_type_shape(element, type_parameter_indexes)
			dim_shapes ?= exported_type_shape_list(dims, type_parameter_indexes)
			Some(ExportedArrayTypeShape(element_shape, dim_shapes))
		SemanticFunctionType(is_pure, params, return_type):
			param_shapes ?= exported_type_shape_list(params, type_parameter_indexes)
			return_shape ?= exported_type_shape(return_type, type_parameter_indexes)
			Some(ExportedFunctionTypeShape(is_pure, param_shapes, return_shape))
		SemanticTypeVar(name):
			type_parameter_indexes
				.get(name)
				.map(func(index): ExportedTypeParameterShape(index))
		SemanticConstIntType(value):
			Some(ExportedConstIntTypeShape(value))
		SemanticTupleType(elements):
			shapes ?= exported_type_shape_list(elements, type_parameter_indexes)
			Some(ExportedTupleTypeShape(shapes))
		SemanticSelfType:
			Some(ExportedSelfTypeShape)
		SemanticVarDimsType(name):
			type_parameter_indexes
				.get(name)
				.map(func(index): ExportedDimParameterShape(index))
		SemanticRangeType(inner):
			inner_shape ?= exported_type_shape(inner, type_parameter_indexes)
			Some(ExportedRangeTypeShape(inner_shape))
		SemanticDimOpType(op, left, right):
			left_shape ?= exported_type_shape(left, type_parameter_indexes)
			right_shape ?= exported_type_shape(right, type_parameter_indexes)
			Some(ExportedDimOpTypeShape(op, left_shape, right_shape))
		SemanticMetaType(_):
			None


private pure func exported_callable_signature(
	type_parameters: List[BoundTypeParam],
	function_type: SemanticType,
) -> Option[ExportedCallableSignature]:
	var indexes: Dict[String, Int] = {}
	var bounds: List[List[String]] = []
	var valid: Bool = True

	for entry in type_parameters.enumerate():
		parameter = entry[1]

		if indexes.contains(parameter.name):
			valid = False
		else:
			indexes = indexes.set(parameter.name, entry[0])
			bounds = bounds.append(parameter.bounds.sort())

	if not valid:
		None
	else:
		shape ?= exported_type_shape(function_type, indexes)

		match shape:
			ExportedFunctionTypeShape(_, _, _):
				Some({
					type_parameter_bounds = bounds,
					function_type = shape,
				})
			_:
				None


private pure func exported_symbol_key(
	module_identity: ModuleIdentity,
	kind: ExportedSymbolKind,
	owner: Option[String],
	name: String,
	callable_signature: Option[ExportedCallableSignature],
) -> ExportedSymbolKey:
	representation: ExportedSymbolKeyRep = {
		module_identity = module_identity,
		kind = kind,
		owner = owner,
		name = name,
		callable_signature = callable_signature
	}
	into ExportedSymbolKey(representation)


pure func exported_callable_symbol_key(
	module_identity: ModuleIdentity,
	kind: ExportedCallableKind,
	owner: Option[String],
	name: String,
	type_parameters: List[BoundTypeParam],
	function_type: SemanticType,
) -> Option[ExportedSymbolKey]:
	signature ?= exported_callable_signature(type_parameters, function_type)

	exported_kind = match kind:
		ExportedCallableFunction:
			ExportedFunction
		ExportedCallableMethod:
			ExportedMethod

	Some(exported_symbol_key(module_identity, exported_kind, owner, name, Some(signature)))


pure func exported_named_symbol_key(
	module_identity: ModuleIdentity,
	kind: ExportedNamedKind,
	owner: Option[String],
	name: String,
) -> ExportedSymbolKey:
	exported_kind = match kind:
		ExportedNamedGlobal:
			ExportedGlobal
		ExportedNamedType:
			ExportedType
		ExportedNamedConstructor:
			ExportedConstructor
		ExportedNamedTrait:
			ExportedTrait
		ExportedNamedField:
			ExportedField

	exported_symbol_key(module_identity, exported_kind, owner, name, None)


pure func exported_symbol_key_module_identity(key: ExportedSymbolKey) -> ModuleIdentity:
	representation: ExportedSymbolKeyRep = from ExportedSymbolKey(key)
	representation.module_identity


pure func exported_symbol_key_kind(key: ExportedSymbolKey) -> ExportedSymbolKind:
	representation: ExportedSymbolKeyRep = from ExportedSymbolKey(key)
	representation.kind


pure func exported_symbol_key_owner(key: ExportedSymbolKey) -> Option[String]:
	representation: ExportedSymbolKeyRep = from ExportedSymbolKey(key)
	representation.owner


pure func exported_symbol_key_name(key: ExportedSymbolKey) -> String:
	representation: ExportedSymbolKeyRep = from ExportedSymbolKey(key)
	representation.name


private pure func exported_identity_component(value: String) -> String:
	value
		.length()
		.to_string() + ":" + value


private pure func exported_dim_op_storage_key(op: SemanticDimOp) -> String:
	match op:
		SemanticDimAdd:
			"add"
		SemanticDimSubtract:
			"subtract"
		SemanticDimMultiply:
			"multiply"
		SemanticDimDivide:
			"divide"


private pure func exported_type_shape_list_storage_key(shapes: List[ExportedTypeShape]) -> String:
	var result: String = shapes
		.length()
		.to_string() + ":"

	for shape in shapes:
		result += exported_identity_component(exported_type_shape_storage_key(shape))

	result


private pure func exported_type_shape_storage_key(shape: ExportedTypeShape) -> String:
	match shape:
		ExportedNamedTypeShape(name, args):
			"named:" + exported_identity_component(
				name,
			) + exported_type_shape_list_storage_key(args)
		ExportedArrayTypeShape(element, dims):
			"array:" + exported_identity_component(
				exported_type_shape_storage_key(
					element,
				),
			) + exported_type_shape_list_storage_key(dims)
		ExportedFunctionTypeShape(is_pure, params, return_type):
			purity = if is_pure:
				"pure"
			else:
				"impure"

			"function:" + purity + exported_type_shape_list_storage_key(
				params,
			) + exported_identity_component(exported_type_shape_storage_key(return_type))
		ExportedTypeParameterShape(index):
			"type-parameter:" + index.to_string()
		ExportedConstIntTypeShape(value):
			"const-int:" + value.to_string()
		ExportedTupleTypeShape(elements):
			"tuple:" + exported_type_shape_list_storage_key(elements)
		ExportedSelfTypeShape:
			"self"
		ExportedDimParameterShape(index):
			"dim-parameter:" + index.to_string()
		ExportedRangeTypeShape(inner):
			"range:" + exported_identity_component(exported_type_shape_storage_key(inner))
		ExportedDimOpTypeShape(op, left, right):
			"dim-op:" + exported_dim_op_storage_key(
				op,
			) + exported_identity_component(
				exported_type_shape_storage_key(
					left,
				),
			) + exported_identity_component(exported_type_shape_storage_key(right))


private pure func exported_bound_list_storage_key(bounds: List[List[String]]) -> String:
	var result: String = bounds
		.length()
		.to_string() + ":"

	for parameter_bounds in bounds:
		var parameter_key: String = parameter_bounds
			.length()
			.to_string() + ":"

		for bound in parameter_bounds:
			parameter_key += exported_identity_component(bound)

		result += exported_identity_component(parameter_key)

	result


private pure func exported_signature_storage_key(
	signature: Option[ExportedCallableSignature],
) -> String:
	match signature:
		None:
			"not-callable"
		Some(found):
			"callable:" + exported_bound_list_storage_key(
				found.type_parameter_bounds,
			) + exported_identity_component(exported_type_shape_storage_key(found.function_type))


private pure func exported_symbol_kind_storage_key(kind: ExportedSymbolKind) -> String:
	match kind:
		ExportedFunction:
			"function"
		ExportedGlobal:
			"global"
		ExportedType:
			"type"
		ExportedConstructor:
			"constructor"
		ExportedTrait:
			"trait"
		ExportedMethod:
			"method"
		ExportedField:
			"field"


pure func exported_symbol_key_storage_key(key: ExportedSymbolKey) -> String:
	representation: ExportedSymbolKeyRep = from ExportedSymbolKey(key)

	owner_key = match representation.owner:
		None:
			"no-owner"
		Some(owner):
			"owner:" + exported_identity_component(owner)

	"exported-symbol:" + exported_identity_component(
		module_identity_storage_key(
			representation.module_identity,
		),
	) + exported_identity_component(
		exported_symbol_kind_storage_key(
			representation.kind,
		),
	) + exported_identity_component(
		owner_key,
	) + exported_identity_component(
		representation.name,
	) + exported_identity_component(
		exported_signature_storage_key(representation.callable_signature),
	)


private pure func exported_type_shape_lists_equal(
	left: List[ExportedTypeShape],
	right: List[ExportedTypeShape],
) -> Bool:
	(
		left.length() == right.length()
		and left
			.zip(right)
			.all(func(pair): exported_type_shapes_equal(pair[0], pair[1]))
	)


private pure func exported_type_shapes_equal(
	left: ExportedTypeShape,
	right: ExportedTypeShape,
) -> Bool:
	match (left, right):
		(ExportedNamedTypeShape(left_name, left_args), ExportedNamedTypeShape(right_name, right_args)):
			left_name == right_name and exported_type_shape_lists_equal(left_args, right_args)
		(ExportedArrayTypeShape(left_element, left_dims), ExportedArrayTypeShape(right_element, right_dims)):
			(
				exported_type_shapes_equal(left_element, right_element)
				and exported_type_shape_lists_equal(left_dims, right_dims)
			)
		(ExportedFunctionTypeShape(left_pure, left_params, left_return), ExportedFunctionTypeShape(right_pure, right_params, right_return)):
			(
				left_pure == right_pure
				and exported_type_shape_lists_equal(left_params, right_params)
				and exported_type_shapes_equal(left_return, right_return)
			)
		(ExportedTypeParameterShape(left_index), ExportedTypeParameterShape(right_index)):
			left_index == right_index
		(ExportedConstIntTypeShape(left_value), ExportedConstIntTypeShape(right_value)):
			left_value == right_value
		(ExportedTupleTypeShape(left_elements), ExportedTupleTypeShape(right_elements)):
			exported_type_shape_lists_equal(left_elements, right_elements)
		(ExportedSelfTypeShape, ExportedSelfTypeShape):
			True
		(ExportedDimParameterShape(left_index), ExportedDimParameterShape(right_index)):
			left_index == right_index
		(ExportedRangeTypeShape(left_inner), ExportedRangeTypeShape(right_inner)):
			exported_type_shapes_equal(left_inner, right_inner)
		(ExportedDimOpTypeShape(left_op, left_a, left_b), ExportedDimOpTypeShape(right_op, right_a, right_b)):
			(
				left_op == right_op
				and exported_type_shapes_equal(left_a, right_a)
				and exported_type_shapes_equal(left_b, right_b)
			)
		_:
			False


private pure func exported_callable_signatures_equal(
	left: Option[ExportedCallableSignature],
	right: Option[ExportedCallableSignature],
) -> Bool:
	match (left, right):
		(None, None):
			True
		(Some(left_signature), Some(right_signature)):
			(
				exported_bound_lists_equal(
					left_signature.type_parameter_bounds,
					right_signature.type_parameter_bounds,
				)
				and exported_type_shapes_equal(
					left_signature.function_type,
					right_signature.function_type,
				)
			)
		_:
			False


private pure func exported_bound_lists_equal(
	left: List[List[String]],
	right: List[List[String]],
) -> Bool:
	(
		left.length() == right.length()
		and left
			.zip(right)
			.all(func(bound_pair):
				(
					bound_pair[0].length() == bound_pair[1].length()
					and bound_pair[0]
						.zip(bound_pair[1])
						.all(func(name_pair):
							name_pair[0] == name_pair[1]
						)
				)
			)
	)


pure func exported_symbol_keys_equal(left: ExportedSymbolKey, right: ExportedSymbolKey) -> Bool:
	left_representation: ExportedSymbolKeyRep = from ExportedSymbolKey(left)
	right_representation: ExportedSymbolKeyRep = from ExportedSymbolKey(right)

	(
		module_identities_equal(
			left_representation.module_identity,
			right_representation.module_identity,
		)
		and left_representation.kind == right_representation.kind
		and left_representation.owner == right_representation.owner
		and left_representation.name == right_representation.name
		and exported_callable_signatures_equal(
			left_representation.callable_signature,
			right_representation.callable_signature,
		)
	)


pure func func_callable_key_module_identity(key: FuncCallableKey) -> ModuleIdentity:
	representation: FuncCallableKeyRep = from FuncCallableKey(key)
	representation.module_identity


pure func func_callable_key_name(key: FuncCallableKey) -> String:
	representation: FuncCallableKeyRep = from FuncCallableKey(key)
	representation.name


pure func func_callable_key_span(key: FuncCallableKey) -> SourceSpan:
	representation: FuncCallableKeyRep = from FuncCallableKey(key)
	representation.span


pure func source_definition_key_module_identity(key: SourceDefinitionKey) -> ModuleIdentity:
	representation: SourceDefinitionKeyRep = from SourceDefinitionKey(key)
	representation.module_identity


pure func source_definition_key_name(key: SourceDefinitionKey) -> String:
	representation: SourceDefinitionKeyRep = from SourceDefinitionKey(key)
	representation.name


pure func source_definition_key_kind(key: SourceDefinitionKey) -> SourceDefinitionKind:
	representation: SourceDefinitionKeyRep = from SourceDefinitionKey(key)
	representation.kind


pure func source_definition_key_owner(key: SourceDefinitionKey) -> Option[String]:
	representation: SourceDefinitionKeyRep = from SourceDefinitionKey(key)
	representation.owner


pure func source_definition_key_span(key: SourceDefinitionKey) -> SourceSpan:
	representation: SourceDefinitionKeyRep = from SourceDefinitionKey(key)
	representation.span


pure func func_callable_keys_equal(left: FuncCallableKey, right: FuncCallableKey) -> Bool:
	left_representation: FuncCallableKeyRep = from FuncCallableKey(left)
	right_representation: FuncCallableKeyRep = from FuncCallableKey(right)

	(
		module_identities_equal(
			left_representation.module_identity,
			right_representation.module_identity,
		)
		and left_representation.name == right_representation.name
		and source_spans_equal(left_representation.span, right_representation.span)
	)


pure func source_definition_keys_equal(
	left: SourceDefinitionKey,
	right: SourceDefinitionKey,
) -> Bool:
	left_representation: SourceDefinitionKeyRep = from SourceDefinitionKey(left)
	right_representation: SourceDefinitionKeyRep = from SourceDefinitionKey(right)

	(
		module_identities_equal(
			left_representation.module_identity,
			right_representation.module_identity,
		)
		and left_representation.kind == right_representation.kind
		and left_representation.name == right_representation.name
		and left_representation.owner == right_representation.owner
		and source_spans_equal(left_representation.span, right_representation.span)
	)


pure func func_callable_key_description(key: FuncCallableKey) -> String:
	representation: FuncCallableKeyRep = from FuncCallableKey(key)
	"callable '" + representation.name + "' in module '" + module_identity_display_name(
		representation.module_identity,
	) + "'"


private pure func source_definition_kind_description(kind: SourceDefinitionKind) -> String:
	match kind:
		ConstructorDefinition:
			"constructor"
		TraitDefinition:
			"trait"
		ImplDefinition:
			"implementation"
		GlobalDefinition:
			"global"
		TypeDefinition:
			"type"
		FieldDefinition:
			"field"


pure func source_definition_key_description(key: SourceDefinitionKey) -> String:
	representation: SourceDefinitionKeyRep = from SourceDefinitionKey(key)
	source_definition_kind_description(
		representation.kind,
	) + " '" + representation.name + "' in module '" + module_identity_display_name(
		representation.module_identity,
	) + "'"
