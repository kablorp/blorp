-- Range syntax constructs the standard nominal record. This witness preserves
-- its accepted provider and field identities through inference and CTFE, even
-- when a local declaration shadows the source name `Range`.
import:
	definition_index: FieldId
	type_identity: TypeId
	../type_system/language_surface_manifest:
		PreludeType(PreludeRange), prelude_type_module_path, prelude_type_name
	../type_system/semantic_type: canonical_module_type_name


record ResolvedRangeFields {
	record_id: TypeId,
	start: FieldId,
	end: FieldId
}


-- These are fields in the standard Range declaration, not C layout members.
RANGE_START_FIELD: String = "start"

RANGE_END_FIELD: String = "end"

STANDARD_RANGE_RECORD_TYPE_NAME: String = canonical_module_type_name(
	prelude_type_module_path(PreludeRange),
	prelude_type_name(PreludeRange),
)
