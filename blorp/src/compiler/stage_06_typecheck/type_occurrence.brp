-- Compiler-owned source identities for type definitions and type annotations.
--
-- SemanticType intentionally omits source spans and definition IDs. Navigation
-- needs both, so typechecking records this compact side table while parsed
-- names, import bindings, and the graph-wide definition index are all present.
import:
	../../lib/source: SourceSpan
	../stage_03_parse/parsed_ast:
		ParsedDecl(
			BuiltinTypeParsedDecl,
			ForeignBlockParsedDecl,
			FunctionParsedDecl,
			ImplParsedDecl,
			PrivateParsedDecl,
			RecordParsedDecl,
			TraitParsedDecl,
			TypeAliasParsedDecl,
			UnionParsedDecl,
			VarParsedDecl,
		),
		ParsedExpr(
			ParsedAscriptionExpr,
			ParsedFunctionDeclExpr,
			ParsedLambdaExpr,
			ParsedOpaqueFromExpr,
			ParsedOpaqueIntoExpr,
			ParsedQuestionBindExpr,
			ParsedVarDeclExpr,
			ParsedWithExpr,
		),
		ParsedForeignFunctionDecl,
		ParsedFunctionDecl,
		ParsedIdentifier,
		ParsedLambdaParam,
		ParsedParam,
		ParsedProgram,
		ParsedTraitMethodDecl,
		ParsedTypeExpr(
			ParsedArrayType,
			ParsedBoundedType,
			ParsedDimBinaryType,
			ParsedFunctionType,
			ParsedNamedType,
			ParsedQualifiedNamedType,
			ParsedRangeType,
			ParsedTupleType,
		),
	../stage_03_parse/parsed_ast_traverse: fold_parsed_expr_children
	../stage_04_modules/loaded_module:
		ModuleIdentity,
	graph/definition_identity:
		SourceDefinitionKey,
		SourceDefinitionKind(TypeDefinition),
		source_definition_key,
	graph/definition_index:
		DefinitionIndex,
		definition_index_find_loaded_type_definition_id,
		definition_index_find_type_definition_id,
	state:
		TypecheckState,
		typecheck_state_definition_index,
		typecheck_state_find_imported_name,
		typecheck_state_find_module_alias,
		typecheck_state_find_source_definition_id,
		typecheck_state_module_identity,


record TypedTypeDefinition {
	definition_id: Option[Int],
	name: String,
	declaration_span: SourceSpan,
	selection_span: SourceSpan,
	is_private: Bool
}


record TypedTypeReference {
	definition_id: Int,
	span: SourceSpan
}


-- The state accessor aligns the allocation frontier and may reconstruct the
-- opaque index. Snapshot it once for the complete read-only occurrence walk.
private record TypeOccurrenceLookup {
	state: TypecheckState,
	definition_index: DefinitionIndex
}


private pure func type_definition_id(
	state: TypecheckState,
	name: String,
	span: SourceSpan,
) -> Option[Int]:
	key: SourceDefinitionKey = source_definition_key(
		typecheck_state_module_identity(state),
		TypeDefinition,
		name,
		None,
		span,
	)
	typecheck_state_find_source_definition_id(state, key)


private pure func typed_type_definition(
	state: TypecheckState,
	name: String,
	declaration_span: SourceSpan,
	selection_span: SourceSpan,
	is_private: Bool,
) -> TypedTypeDefinition:
	{
		definition_id = type_definition_id(state, name, declaration_span),
		name = name,
		declaration_span = declaration_span,
		selection_span = selection_span,
		is_private = is_private
	}


private pure func type_definitions_in_decl(
	state: TypecheckState,
	decl: ParsedDecl,
	is_private: Bool,
) -> List[TypedTypeDefinition]:
	match decl:
		RecordParsedDecl(record_decl):
			[
				typed_type_definition(
					state,
					record_decl.name.text,
					record_decl.span,
					record_decl.name.span,
					is_private,
				),
			]
		UnionParsedDecl(union_decl):
			[
				typed_type_definition(
					state,
					union_decl.name.text,
					union_decl.span,
					union_decl.name.span,
					is_private,
				),
			]
		BuiltinTypeParsedDecl(type_decl):
			[
				typed_type_definition(
					state,
					type_decl.name.text,
					type_decl.span,
					type_decl.name.span,
					is_private,
				),
			]
		TypeAliasParsedDecl(alias_decl):
			[
				typed_type_definition(
					state,
					alias_decl.name.text,
					alias_decl.span,
					alias_decl.name.span,
					is_private,
				),
			]
		PrivateParsedDecl(inner, _):
			type_definitions_in_decl(state, inner, True)
		_:
			[]


private pure func resolved_type_definition_id(
	lookup: TypeOccurrenceLookup,
	visible_name: String,
	qualified_module: Option[String],
) -> Option[Int]:
	match qualified_module:
		Some(module_alias):
			match typecheck_state_find_module_alias(lookup.state, module_alias):
				Some(module_path):
					definition_index_find_loaded_type_definition_id(
						lookup.definition_index,
						module_path,
						visible_name,
					)
				None:
					None
		None:
			match typecheck_state_find_imported_name(lookup.state, visible_name):
				Some(imported):
					definition_index_find_loaded_type_definition_id(
						lookup.definition_index,
						imported.module_path,
						imported.original_name,
					)
				None:
					definition_index_find_type_definition_id(
						lookup.definition_index,
						typecheck_state_module_identity(lookup.state),
						visible_name,
					)


private pure func append_resolved_type_reference(
	references: List[TypedTypeReference],
	lookup: TypeOccurrenceLookup,
	name: ParsedIdentifier,
	module_name: Option[String],
) -> List[TypedTypeReference]:
	match resolved_type_definition_id(lookup, name.text, module_name):
		Some(definition_id):
			references.append({
				definition_id = definition_id,
				span = name.span,
			})
		None:
			references


private pure func collect_type_references(
	lookup: TypeOccurrenceLookup,
	type_expr: ParsedTypeExpr,
	references: List[TypedTypeReference],
) -> List[TypedTypeReference]:
	match type_expr:
		ParsedNamedType(name, args, _):
			var result = append_resolved_type_reference(references, lookup, name, None)

			for arg in args:
				result = collect_type_references(lookup, arg, result)

			result
		ParsedQualifiedNamedType(module_name, name, args, _):
			var result = append_resolved_type_reference(
				references,
				lookup,
				name,
				Some(module_name.text),
			)

			for arg in args:
				result = collect_type_references(lookup, arg, result)

			result
		ParsedDimBinaryType(_, left, right, _):
			collect_type_references(
				lookup,
				right,
				collect_type_references(lookup, left, references),
			)
		ParsedRangeType(inner, _):
			collect_type_references(lookup, inner, references)
		ParsedTupleType(items, _):
			var result = references

			for item in items:
				result = collect_type_references(lookup, item, result)

			result
		ParsedFunctionType(_, params, return_type, _):
			var result = references

			for param in params:
				result = collect_type_references(lookup, param, result)

			collect_type_references(lookup, return_type, result)
		ParsedArrayType(element, dims, _):
			var result = collect_type_references(lookup, element, references)

			for dim in dims:
				result = collect_type_references(lookup, dim, result)

			result
		ParsedBoundedType(_, _, _):
			references
		_:
			references


private pure func collect_optional_type_references(
	lookup: TypeOccurrenceLookup,
	type_expr: Option[ParsedTypeExpr],
	references: List[TypedTypeReference],
) -> List[TypedTypeReference]:
	match type_expr:
		Some(found):
			collect_type_references(lookup, found, references)
		None:
			references


private pure func collect_param_type_references(
	lookup: TypeOccurrenceLookup,
	params: List[ParsedParam],
	references: List[TypedTypeReference],
) -> List[TypedTypeReference]:
	var result = references

	for param in params:
		result = collect_optional_type_references(lookup, param.type_expr, result)

	result


private pure func collect_lambda_param_type_references(
	lookup: TypeOccurrenceLookup,
	params: List[ParsedLambdaParam],
	references: List[TypedTypeReference],
) -> List[TypedTypeReference]:
	var result = references

	for param in params:
		result = collect_optional_type_references(lookup, param.type_expr, result)

	result


private pure func collect_function_signature_type_references(
	lookup: TypeOccurrenceLookup,
	function_decl: ParsedFunctionDecl,
	references: List[TypedTypeReference],
) -> List[TypedTypeReference]:
	collect_optional_type_references(
		lookup,
		function_decl.return_type,
		collect_param_type_references(lookup, function_decl.params, references),
	)


private pure func collect_foreign_signature_type_references(
	lookup: TypeOccurrenceLookup,
	function_decl: ParsedForeignFunctionDecl,
	references: List[TypedTypeReference],
) -> List[TypedTypeReference]:
	collect_type_references(
		lookup,
		function_decl.return_type,
		collect_param_type_references(lookup, function_decl.params, references),
	)


private pure func collect_trait_method_type_references(
	lookup: TypeOccurrenceLookup,
	method: ParsedTraitMethodDecl,
	references: List[TypedTypeReference],
) -> List[TypedTypeReference]:
	collect_optional_expr_type_references(
		lookup,
		method.body,
		collect_optional_type_references(
			lookup,
			method.return_type,
			collect_param_type_references(lookup, method.params, references),
		),
	)


private pure func collect_optional_expr_type_references(
	lookup: TypeOccurrenceLookup,
	expr: Option[ParsedExpr],
	references: List[TypedTypeReference],
) -> List[TypedTypeReference]:
	match expr:
		Some(found):
			collect_expr_type_references(lookup, found, references)
		None:
			references


private pure func collect_expr_immediate_type_references(
	lookup: TypeOccurrenceLookup,
	expr: ParsedExpr,
	references: List[TypedTypeReference],
) -> List[TypedTypeReference]:
	match expr:
		ParsedAscriptionExpr(_, type_expr, _):
			collect_type_references(lookup, type_expr, references)
		ParsedOpaqueIntoExpr(type_expr, _, _):
			collect_type_references(lookup, type_expr, references)
		ParsedOpaqueFromExpr(type_expr, _, _):
			collect_type_references(lookup, type_expr, references)
		ParsedWithExpr(binding, _, _):
			collect_optional_type_references(lookup, binding.type_expr, references)
		ParsedLambdaExpr(_, params, return_type, _, _):
			collect_optional_type_references(
				lookup,
				return_type,
				collect_lambda_param_type_references(lookup, params, references),
			)
		ParsedFunctionDeclExpr(function_decl):
			collect_function_signature_type_references(lookup, function_decl, references)
		ParsedVarDeclExpr(_, type_expr, _, _, _):
			collect_optional_type_references(lookup, type_expr, references)
		ParsedQuestionBindExpr(_, type_expr, _, _):
			collect_optional_type_references(lookup, type_expr, references)
		_:
			references


private pure func collect_expr_type_references(
	lookup: TypeOccurrenceLookup,
	expr: ParsedExpr,
	references: List[TypedTypeReference],
) -> List[TypedTypeReference]:
	fold_parsed_expr_children(
		expr,
		collect_expr_immediate_type_references(
			lookup,
			expr,
			references,
		),
		func(result, child): collect_expr_type_references(lookup, child, result),
	)


private pure func collect_decl_type_references(
	lookup: TypeOccurrenceLookup,
	decl: ParsedDecl,
	references: List[TypedTypeReference],
) -> List[TypedTypeReference]:
	match decl:
		FunctionParsedDecl(function_decl):
			collect_optional_expr_type_references(
				lookup,
				function_decl.body,
				collect_function_signature_type_references(lookup, function_decl, references),
			)
		ForeignBlockParsedDecl(_, functions, _):
			var result = references

			for function_decl in functions:
				result = collect_foreign_signature_type_references(lookup, function_decl, result)

			result
		VarParsedDecl(var_decl):
			collect_expr_type_references(
				lookup,
				var_decl.value,
				collect_optional_type_references(lookup, var_decl.type_expr, references),
			)
		RecordParsedDecl(record_decl):
			var result = references

			for field in record_decl.fields:
				result = collect_type_references(lookup, field.type_expr, result)

			result
		UnionParsedDecl(union_decl):
			var result = references

			for variant in union_decl.variants:
				for field in variant.fields:
					result = collect_type_references(lookup, field, result)

			result
		TypeAliasParsedDecl(alias_decl):
			collect_type_references(lookup, alias_decl.target, references)
		TraitParsedDecl(trait_decl):
			var result = references

			for method in trait_decl.methods:
				result = collect_trait_method_type_references(lookup, method, result)

			result
		ImplParsedDecl(impl_decl):
			var result = collect_type_references(lookup, impl_decl.for_type, references)

			for method in impl_decl.methods:
				result = collect_optional_expr_type_references(
					lookup,
					method.body,
					collect_function_signature_type_references(lookup, method, result),
				)

			result
		PrivateParsedDecl(inner, _):
			collect_decl_type_references(lookup, inner, references)
		_:
			references


pure func typed_type_definitions(
	state: TypecheckState,
	program: ParsedProgram,
) -> List[TypedTypeDefinition]:
	program.decls.flat_map(func(decl): type_definitions_in_decl(state, decl, False))


pure func typed_type_references(
	state: TypecheckState,
	program: ParsedProgram,
) -> List[TypedTypeReference]:
	lookup: TypeOccurrenceLookup = {
		state = state,
		definition_index = typecheck_state_definition_index(state)
	}
	var result: List[TypedTypeReference] = []

	for decl in program.decls:
		result = collect_decl_type_references(lookup, decl, result)

	result
