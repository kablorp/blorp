-- Compiler-owned source identities for type definitions and type annotations.
--
-- SemanticType intentionally omits source spans and definition IDs. Navigation
-- needs both, so typechecking records this compact side table while parsed
-- names, import bindings, and the graph-wide definition index are all present.
import:
	../stage_01_file_io/source: SourceSpan
	../stage_03_parse/parsed_ast:
		ParsedDecl(
			BuiltinTypeParsedDecl,
			ForeignBlockParsedDecl,
			FunctionParsedDecl,
			ImplParsedDecl,
			PrivateParsedDecl,
			RecordParsedDecl,
			TraitParsedDecl,
			TypeAliasParsedDecl,
			UnionParsedDecl,
			VarParsedDecl,
		),
		ParsedExpr(
			ParsedAscriptionExpr,
			ParsedFunctionDeclExpr,
			ParsedLambdaExpr,
			ParsedOpaqueFromExpr,
			ParsedOpaqueIntoExpr,
			ParsedQuestionBindExpr,
			ParsedVarDeclExpr,
			ParsedWithExpr,
		),
		ParsedForeignFunctionDecl,
		ParsedFunctionDecl,
		ParsedIdentifier,
		ParsedLambdaParam,
		ParsedParam,
		ParsedProgram,
		ParsedTraitMethodDecl,
		ParsedTypeExpr(
			ParsedArrayType,
			ParsedBoundedType,
			ParsedDimBinaryType,
			ParsedFunctionType,
			ParsedNamedType,
			ParsedQualifiedNamedType,
			ParsedRangeType,
			ParsedTupleType,
		),
	../stage_03_parse/parsed_ast_traverse: fold_parsed_expr_children
	../stage_04_modules/loaded_module:
		ModuleIdentity,
		module_identities_equal,
		module_identity_matches_canonical_path,
	graph/definition_identity:
		SourceDefinitionKey,
		SourceDefinitionKind(TypeDefinition),
		source_definition_key,
		source_definition_key_kind,
		source_definition_key_module_identity,
	state:
		TypecheckState,
		typecheck_state_find_imported_name,
		typecheck_state_find_module_alias,
		typecheck_state_find_source_definition_id,
		typecheck_state_module_identity,
		typecheck_state_source_definition_bindings_for_name,


record TypedTypeDefinition {
	definition_id: Option[Int],
	name: String,
	declaration_span: SourceSpan,
	selection_span: SourceSpan,
	is_private: Bool
}


record TypedTypeReference {
	definition_id: Int,
	span: SourceSpan
}


private pure func type_definition_id(
	state: TypecheckState,
	name: String,
	span: SourceSpan,
) -> Option[Int]:
	key: SourceDefinitionKey = source_definition_key(
		typecheck_state_module_identity(state),
		TypeDefinition,
		name,
		None,
		span,
	)
	typecheck_state_find_source_definition_id(state, key)


private pure func typed_type_definition(
	state: TypecheckState,
	name: String,
	declaration_span: SourceSpan,
	selection_span: SourceSpan,
	is_private: Bool,
) -> TypedTypeDefinition:
	{
		definition_id = type_definition_id(state, name, declaration_span),
		name = name,
		declaration_span = declaration_span,
		selection_span = selection_span,
		is_private = is_private
	}


private pure func type_definitions_in_decl(
	state: TypecheckState,
	decl: ParsedDecl,
	is_private: Bool,
) -> List[TypedTypeDefinition]:
	match decl:
		RecordParsedDecl(record_decl):
			[
				typed_type_definition(
					state,
					record_decl.name.text,
					record_decl.span,
					record_decl.name.span,
					is_private,
				),
			]
		UnionParsedDecl(union_decl):
			[
				typed_type_definition(
					state,
					union_decl.name.text,
					union_decl.span,
					union_decl.name.span,
					is_private,
				),
			]
		BuiltinTypeParsedDecl(type_decl):
			[
				typed_type_definition(
					state,
					type_decl.name.text,
					type_decl.span,
					type_decl.name.span,
					is_private,
				),
			]
		TypeAliasParsedDecl(alias_decl):
			[
				typed_type_definition(
					state,
					alias_decl.name.text,
					alias_decl.span,
					alias_decl.name.span,
					is_private,
				),
			]
		PrivateParsedDecl(inner, _):
			type_definitions_in_decl(state, inner, True)
		_:
			[]


private pure func local_type_binding_matches(
	key: SourceDefinitionKey,
	module_identity: ModuleIdentity,
) -> Bool:
	(
		source_definition_key_kind(key) == TypeDefinition
		and module_identities_equal(source_definition_key_module_identity(key), module_identity)
	)


private pure func imported_type_binding_matches(
	key: SourceDefinitionKey,
	module_path: String,
) -> Bool:
	(
		source_definition_key_kind(key) == TypeDefinition
		and module_identity_matches_canonical_path(
			source_definition_key_module_identity(key),
			module_path,
		)
	)


private pure func type_definition_id_for_owner(
	state: TypecheckState,
	name: String,
	local_module: Option[ModuleIdentity],
	imported_path: Option[String],
) -> Option[Int]:
	var result: Option[Int] = None
	var matches: Int = 0

	for binding in typecheck_state_source_definition_bindings_for_name(state, name):
		owned = match (local_module, imported_path):
			(Some(module_identity), None):
				local_type_binding_matches(binding[0], module_identity)
			(None, Some(module_path)):
				imported_type_binding_matches(binding[0], module_path)
			_:
				False

		if owned:
			result = Some(binding[1])
			matches += 1

	if matches == 1:
		result
	else:
		None


private pure func resolved_type_definition_id(
	state: TypecheckState,
	visible_name: String,
	qualified_module: Option[String],
) -> Option[Int]:
	match qualified_module:
		Some(module_alias):
			match typecheck_state_find_module_alias(state, module_alias):
				Some(module_path):
					type_definition_id_for_owner(state, visible_name, None, Some(module_path))
				None:
					None
		None:
			match typecheck_state_find_imported_name(state, visible_name):
				Some(imported):
					type_definition_id_for_owner(
						state,
						imported.original_name,
						None,
						Some(imported.module_path),
					)
				None:
					type_definition_id_for_owner(
						state,
						visible_name,
						Some(typecheck_state_module_identity(state)),
						None,
					)


private pure func append_resolved_type_reference(
	references: List[TypedTypeReference],
	state: TypecheckState,
	name: ParsedIdentifier,
	module_name: Option[String],
) -> List[TypedTypeReference]:
	match resolved_type_definition_id(state, name.text, module_name):
		Some(definition_id):
			references.append({
				definition_id = definition_id,
				span = name.span,
			})
		None:
			references


private pure func collect_type_references(
	state: TypecheckState,
	type_expr: ParsedTypeExpr,
	references: List[TypedTypeReference],
) -> List[TypedTypeReference]:
	match type_expr:
		ParsedNamedType(name, args, _):
			var result = append_resolved_type_reference(references, state, name, None)

			for arg in args:
				result = collect_type_references(state, arg, result)

			result
		ParsedQualifiedNamedType(module_name, name, args, _):
			var result = append_resolved_type_reference(
				references,
				state,
				name,
				Some(module_name.text),
			)

			for arg in args:
				result = collect_type_references(state, arg, result)

			result
		ParsedDimBinaryType(_, left, right, _):
			collect_type_references(
				state,
				right,
				collect_type_references(state, left, references),
			)
		ParsedRangeType(inner, _):
			collect_type_references(state, inner, references)
		ParsedTupleType(items, _):
			var result = references

			for item in items:
				result = collect_type_references(state, item, result)

			result
		ParsedFunctionType(_, params, return_type, _):
			var result = references

			for param in params:
				result = collect_type_references(state, param, result)

			collect_type_references(state, return_type, result)
		ParsedArrayType(element, dims, _):
			var result = collect_type_references(state, element, references)

			for dim in dims:
				result = collect_type_references(state, dim, result)

			result
		ParsedBoundedType(_, _, _):
			references
		_:
			references


private pure func collect_optional_type_references(
	state: TypecheckState,
	type_expr: Option[ParsedTypeExpr],
	references: List[TypedTypeReference],
) -> List[TypedTypeReference]:
	match type_expr:
		Some(found):
			collect_type_references(state, found, references)
		None:
			references


private pure func collect_param_type_references(
	state: TypecheckState,
	params: List[ParsedParam],
	references: List[TypedTypeReference],
) -> List[TypedTypeReference]:
	var result = references

	for param in params:
		result = collect_optional_type_references(state, param.type_expr, result)

	result


private pure func collect_lambda_param_type_references(
	state: TypecheckState,
	params: List[ParsedLambdaParam],
	references: List[TypedTypeReference],
) -> List[TypedTypeReference]:
	var result = references

	for param in params:
		result = collect_optional_type_references(state, param.type_expr, result)

	result


private pure func collect_function_signature_type_references(
	state: TypecheckState,
	function_decl: ParsedFunctionDecl,
	references: List[TypedTypeReference],
) -> List[TypedTypeReference]:
	collect_optional_type_references(
		state,
		function_decl.return_type,
		collect_param_type_references(state, function_decl.params, references),
	)


private pure func collect_foreign_signature_type_references(
	state: TypecheckState,
	function_decl: ParsedForeignFunctionDecl,
	references: List[TypedTypeReference],
) -> List[TypedTypeReference]:
	collect_type_references(
		state,
		function_decl.return_type,
		collect_param_type_references(state, function_decl.params, references),
	)


private pure func collect_trait_method_type_references(
	state: TypecheckState,
	method: ParsedTraitMethodDecl,
	references: List[TypedTypeReference],
) -> List[TypedTypeReference]:
	collect_optional_expr_type_references(
		state,
		method.body,
		collect_optional_type_references(
			state,
			method.return_type,
			collect_param_type_references(state, method.params, references),
		),
	)


private pure func collect_optional_expr_type_references(
	state: TypecheckState,
	expr: Option[ParsedExpr],
	references: List[TypedTypeReference],
) -> List[TypedTypeReference]:
	match expr:
		Some(found):
			collect_expr_type_references(state, found, references)
		None:
			references


private pure func collect_expr_immediate_type_references(
	state: TypecheckState,
	expr: ParsedExpr,
	references: List[TypedTypeReference],
) -> List[TypedTypeReference]:
	match expr:
		ParsedAscriptionExpr(_, type_expr, _):
			collect_type_references(state, type_expr, references)
		ParsedOpaqueIntoExpr(type_expr, _, _):
			collect_type_references(state, type_expr, references)
		ParsedOpaqueFromExpr(type_expr, _, _):
			collect_type_references(state, type_expr, references)
		ParsedWithExpr(binding, _, _):
			collect_optional_type_references(state, binding.type_expr, references)
		ParsedLambdaExpr(_, params, return_type, _, _):
			collect_optional_type_references(
				state,
				return_type,
				collect_lambda_param_type_references(state, params, references),
			)
		ParsedFunctionDeclExpr(function_decl):
			collect_function_signature_type_references(state, function_decl, references)
		ParsedVarDeclExpr(_, type_expr, _, _, _):
			collect_optional_type_references(state, type_expr, references)
		ParsedQuestionBindExpr(_, type_expr, _, _):
			collect_optional_type_references(state, type_expr, references)
		_:
			references


private pure func collect_expr_type_references(
	state: TypecheckState,
	expr: ParsedExpr,
	references: List[TypedTypeReference],
) -> List[TypedTypeReference]:
	fold_parsed_expr_children(
		expr,
		collect_expr_immediate_type_references(
			state,
			expr,
			references,
		),
		func(result, child): collect_expr_type_references(state, child, result),
	)


private pure func collect_decl_type_references(
	state: TypecheckState,
	decl: ParsedDecl,
	references: List[TypedTypeReference],
) -> List[TypedTypeReference]:
	match decl:
		FunctionParsedDecl(function_decl):
			collect_optional_expr_type_references(
				state,
				function_decl.body,
				collect_function_signature_type_references(state, function_decl, references),
			)
		ForeignBlockParsedDecl(_, functions, _):
			var result = references

			for function_decl in functions:
				result = collect_foreign_signature_type_references(state, function_decl, result)

			result
		VarParsedDecl(var_decl):
			collect_expr_type_references(
				state,
				var_decl.value,
				collect_optional_type_references(state, var_decl.type_expr, references),
			)
		RecordParsedDecl(record_decl):
			var result = references

			for field in record_decl.fields:
				result = collect_type_references(state, field.type_expr, result)

			result
		UnionParsedDecl(union_decl):
			var result = references

			for variant in union_decl.variants:
				for field in variant.fields:
					result = collect_type_references(state, field, result)

			result
		TypeAliasParsedDecl(alias_decl):
			collect_type_references(state, alias_decl.target, references)
		TraitParsedDecl(trait_decl):
			var result = references

			for method in trait_decl.methods:
				result = collect_trait_method_type_references(state, method, result)

			result
		ImplParsedDecl(impl_decl):
			var result = collect_type_references(state, impl_decl.for_type, references)

			for method in impl_decl.methods:
				result = collect_optional_expr_type_references(
					state,
					method.body,
					collect_function_signature_type_references(state, method, result),
				)

			result
		PrivateParsedDecl(inner, _):
			collect_decl_type_references(state, inner, references)
		_:
			references


pure func typed_type_definitions(
	state: TypecheckState,
	program: ParsedProgram,
) -> List[TypedTypeDefinition]:
	program.decls.flat_map(func(decl): type_definitions_in_decl(state, decl, False))


pure func typed_type_references(
	state: TypecheckState,
	program: ParsedProgram,
) -> List[TypedTypeReference]:
	var result: List[TypedTypeReference] = []

	for decl in program.decls:
		result = collect_decl_type_references(state, decl, result)

	result
