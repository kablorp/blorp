-- Exact, definition-owned implementation headers and conservative lookup.
--
-- The candidate index is deliberately a superset: it buckets by exact trait
-- definition ID and receiver head category, then validates both exact trait
-- identity and category on lookup. Hash collisions can add work but cannot
-- hide a legal implementation.
import:
	../../stage_01_file_io/source: SourceSpan
	../../stage_03_parse/parsed_ast:
		ParsedDimConstraint,
		ParsedFunctionDecl,
		ParsedIdentifier,
		ParsedImplDecl,
		ParsedParam,
		ParsedTraitMethodDecl,
		ParsedTypeExpr,
		ParsedTypeParamDecl,
	../../stage_04_modules/loaded_module: module_identity_display_name
	../modules/bound_module_graph: BoundModule, bound_module_graph_find
	callable_headers: CallableHeaderGraph, callable_header_graph_trait_topology
	callable_signature:
		CallableParameter,
		CallableSignature,
		callable_parameter_binder_from_parsed,
		callable_signature,
		callable_signature_is_pure,
		callable_signature_parameters,
		callable_signature_return_type,
	declaration_skeleton:
		CallableDeclarationSource(
			DefaultImplementationMethodCallableSource,
			ForeignCallableSource,
			FunctionCallableSource,
			ImplementationMethodCallableSource,
		),
		CallableId,
		DeclarationVisibility,
		ImplId,
		ImplementationDeclarationSkeletonInfo,
		TraitId,
		TraitMethodId,
		callable_id_name,
		callable_id_source_span,
		callable_ids_equal,
		declaration_skeleton_graph_callable_skeletons,
		declaration_skeleton_graph_implementation_skeletons,
		impl_id_definition_id,
		impl_id_module_identity,
		impl_id_name,
		impl_id_source_span,
		impl_ids_equal,
		trait_id_definition_id,
		trait_id_name,
		trait_ids_equal,
		trait_method_id_name,
	trait_headers:
		TraitMethodCategory(DefaultTraitMethod, RequiredTraitMethod),
		TraitMethodSlot,
		TraitTopologyGraph,
		trait_method_slot_category,
		trait_method_slot_id,
		trait_method_slot_name,
		trait_method_slot_owner,
		trait_method_slot_signature,
		trait_method_slot_source,
		trait_topology_graph_find,
		trait_topology_graph_transitive_supertraits,
		trait_topology_graph_type_headers,
		trait_topology_header_methods,
	trait_reference_resolution: resolve_visible_trait_id
	type_header_graph:
		CallableTypeParameterId,
		ImplementationTypeParameterId,
		IntrinsicType(IntrinsicVoid),
		ResolvedTypeShape(
			ArrayTypeShape,
			DeclaredTypeShape,
			DimensionBinaryShape,
			DimensionLiteralShape,
			DimensionParameterShape,
			FunctionTypeShape,
			ImplementationDimensionParameterShape,
			ImplementationTypeParameterShape,
			IntrinsicTypeShape,
			PreludeTypeShape,
			RangeTypeShape,
			SelfTypeShape,
			TraitDimensionParameterShape,
			TraitSelfTypeShape,
			TraitTypeParameterShape,
			TupleTypeShape,
			TypeParameterShape,
			WildcardDimensionShape,
			CallableDimensionParameterShape,
			CallableTypeParameterShape,
		),
		TypeHeaderGraph,
		TypeShapeResolutionError,
		callable_type_parameter_id_name,
		callable_type_parameter_ids,
		implementation_type_parameter_id_name,
		implementation_type_parameter_ids,
		resolve_implementation_method_type_shape,
		resolve_implementation_type_shape,
		type_header_graph_bound_graph,
		type_header_graph_declaration_graph,
		type_header_graph_has_unqualified_type_name,
		type_shape_resolution_error_message,
		type_shape_resolution_error_span,
	type_parameter_discovery: discover_implicit_type_parameters_in_type


private record ResolvedImplementationTypeParameterRep {
	id: ImplementationTypeParameterId,
	bounds: List[TraitId]
}


opaque type ResolvedImplementationTypeParameter = ResolvedImplementationTypeParameterRep


private record ResolvedImplementationMethodTypeParameterRep {
	id: CallableTypeParameterId,
	bounds: List[TraitId]
}


opaque type ResolvedImplementationMethodTypeParameter = ResolvedImplementationMethodTypeParameterRep


private record ExplicitImplementationMethodHeaderRep {
	id: CallableId,
	source: ParsedFunctionDecl,
	parameters: List[ResolvedImplementationMethodTypeParameter],
	signature: CallableSignature,
	dimension_constraints: List[(ResolvedTypeShape, ResolvedTypeShape)]
}


opaque type ExplicitImplementationMethodHeader = ExplicitImplementationMethodHeaderRep


private record DefaultImplementationMethodHeaderRep {
	id: CallableId,
	owner: ImplId,
	trait_method: TraitMethodSlot
}


opaque type DefaultImplementationMethodHeader = DefaultImplementationMethodHeaderRep


union ImplementationMethodHeader:
	ExplicitImplementationMethodHeaderValue(ExplicitImplementationMethodHeader)
	DefaultImplementationMethodHeaderValue(DefaultImplementationMethodHeader)


enum ImplementationReceiverHeadCategory:
	DeclaredReceiverHead
	IntrinsicReceiverHead
	PreludeReceiverHead
	ArrayReceiverHead
	TupleReceiverHead
	FunctionReceiverHead
	RangeReceiverHead
	ParameterReceiverHead
	DimensionReceiverHead


private record ImplementationHeaderRep {
	id: ImplId,
	visibility: DeclarationVisibility,
	source: ParsedImplDecl,
	trait_id: TraitId,
	parameters: List[ResolvedImplementationTypeParameter],
	receiver: ResolvedTypeShape,
	receiver_head: ImplementationReceiverHeadCategory,
	methods: List[ImplementationMethodHeader]
}


opaque type ImplementationHeader = ImplementationHeaderRep


private record ImplementationHeaderGraphRep {
	callable_headers: CallableHeaderGraph,
	headers: List[ImplementationHeader],
	header_index_by_definition_id: Dict[Int, Int],
	index_by_trait_definition_id: Dict[Int, Dict[Int, List[Int]]]
}


opaque type ImplementationHeaderGraph = ImplementationHeaderGraphRep


union ImplementationHeaderGraphError:
	ImplementationOwnerModuleMissing(ImplId)
	ImplementationUnknownTrait(ImplId, ParsedIdentifier)
	ImplementationDuplicateTypeParameter(ImplId, ParsedIdentifier)
	ImplementationTypeParameterUnknownBound(ImplId, ParsedIdentifier, ParsedIdentifier)
	ImplementationMethodDuplicateTypeParameter(CallableId, ParsedIdentifier)
	ImplementationMethodShadowsImplementationTypeParameter(CallableId, ParsedIdentifier)
	ImplementationMethodTypeParameterUnknownBound(CallableId, ParsedIdentifier, ParsedIdentifier)
	ImplementationMethodMissingParameterType(CallableId, Int, SourceSpan)
	ImplementationDefaultMethodMissing(ImplId, String)
	ImplementationMissingRequiredMethod(ImplId, TraitMethodId, SourceSpan)
	ImplementationTypeResolutionError(TypeShapeResolutionError)


private record ImplementationParameterResolution {
	parameters: List[ResolvedImplementationTypeParameter],
	errors: List[ImplementationHeaderGraphError]
}


private record ImplementationMethodParameterResolution {
	parameters: List[ResolvedImplementationMethodTypeParameter],
	errors: List[ImplementationHeaderGraphError]
}


private record ImplementationMethodSignatureResolution {
	signature: CallableSignature,
	dimension_constraints: List[(ResolvedTypeShape, ResolvedTypeShape)],
	errors: List[ImplementationHeaderGraphError]
}


private record ImplementationMethodsResolution {
	methods: List[ImplementationMethodHeader],
	errors: List[ImplementationHeaderGraphError]
}


private record ImplementationHeaderBuildState {
	headers: List[ImplementationHeader],
	header_index_by_definition_id: Dict[Int, Int],
	index_by_trait_definition_id: Dict[Int, Dict[Int, List[Int]]],
	errors: List[ImplementationHeaderGraphError]
}


pure func resolved_implementation_type_parameter_id(
	parameter: ResolvedImplementationTypeParameter,
) -> ImplementationTypeParameterId:
	from ResolvedImplementationTypeParameter(parameter).id


pure func resolved_implementation_type_parameter_bounds(
	parameter: ResolvedImplementationTypeParameter,
) -> List[TraitId]:
	from ResolvedImplementationTypeParameter(parameter).bounds


pure func resolved_implementation_method_type_parameter_id(
	parameter: ResolvedImplementationMethodTypeParameter,
) -> CallableTypeParameterId:
	from ResolvedImplementationMethodTypeParameter(parameter).id


pure func resolved_implementation_method_type_parameter_bounds(
	parameter: ResolvedImplementationMethodTypeParameter,
) -> List[TraitId]:
	from ResolvedImplementationMethodTypeParameter(parameter).bounds


private pure func implementation_header_rep(
	header: ImplementationHeader,
) -> ImplementationHeaderRep:
	from ImplementationHeader(header)


pure func implementation_header_id(header: ImplementationHeader) -> ImplId:
	implementation_header_rep(header).id


pure func implementation_header_trait_id(header: ImplementationHeader) -> TraitId:
	implementation_header_rep(header).trait_id


pure func implementation_header_source(header: ImplementationHeader) -> ParsedImplDecl:
	implementation_header_rep(header).source


pure func implementation_header_visibility(header: ImplementationHeader) -> DeclarationVisibility:
	implementation_header_rep(header).visibility


pure func implementation_header_parameters(
	header: ImplementationHeader,
) -> List[ResolvedImplementationTypeParameter]:
	implementation_header_rep(header).parameters


pure func implementation_header_receiver(header: ImplementationHeader) -> ResolvedTypeShape:
	implementation_header_rep(header).receiver


pure func implementation_header_receiver_head(
	header: ImplementationHeader,
) -> ImplementationReceiverHeadCategory:
	implementation_header_rep(header).receiver_head


pure func implementation_header_method_ids(header: ImplementationHeader) -> List[CallableId]:
	implementation_header_rep(header).methods.map(implementation_method_header_id)


pure func implementation_header_methods(
	header: ImplementationHeader,
) -> List[ImplementationMethodHeader]:
	implementation_header_rep(header).methods


pure func implementation_method_header_id(header: ImplementationMethodHeader) -> CallableId:
	match header:
		ExplicitImplementationMethodHeaderValue(explicit):
			from ExplicitImplementationMethodHeader(explicit).id
		DefaultImplementationMethodHeaderValue(default_method):
			from DefaultImplementationMethodHeader(default_method).id


pure func explicit_implementation_method_signature(
	header: ImplementationMethodHeader,
) -> Option[CallableSignature]:
	match header:
		ExplicitImplementationMethodHeaderValue(explicit):
			Some(from ExplicitImplementationMethodHeader(explicit).signature)
		DefaultImplementationMethodHeaderValue(_):
			None


pure func explicit_implementation_method_source(
	header: ImplementationMethodHeader,
) -> Option[ParsedFunctionDecl]:
	match header:
		ExplicitImplementationMethodHeaderValue(explicit):
			Some(from ExplicitImplementationMethodHeader(explicit).source)
		DefaultImplementationMethodHeaderValue(_):
			None


pure func default_implementation_method_source(
	header: ImplementationMethodHeader,
) -> Option[ParsedTraitMethodDecl]:
	match header:
		ExplicitImplementationMethodHeaderValue(_):
			None
		DefaultImplementationMethodHeaderValue(default_method):
			Some(
				trait_method_slot_source(
					from DefaultImplementationMethodHeader(default_method).trait_method,
				),
			)


pure func default_implementation_method_signature(
	implementation: ImplementationHeader,
	header: ImplementationMethodHeader,
) -> Option[CallableSignature]:
	match header:
		ExplicitImplementationMethodHeaderValue(_):
			None
		DefaultImplementationMethodHeaderValue(default_method):
			representation = from DefaultImplementationMethodHeader(default_method)

			if impl_ids_equal(representation.owner, implementation_header_id(implementation)):
				Some(
					implementation_default_signature(
						representation.trait_method,
						trait_method_slot_owner(representation.trait_method),
						implementation_header_receiver(implementation),
					),
				)
			else:
				None


pure func explicit_implementation_method_parameters(
	header: ImplementationMethodHeader,
) -> List[ResolvedImplementationMethodTypeParameter]:
	match header:
		ExplicitImplementationMethodHeaderValue(explicit):
			from ExplicitImplementationMethodHeader(explicit).parameters
		DefaultImplementationMethodHeaderValue(_):
			[]


pure func explicit_implementation_method_dimension_constraints(
	header: ImplementationMethodHeader,
) -> List[(ResolvedTypeShape, ResolvedTypeShape)]:
	match header:
		ExplicitImplementationMethodHeaderValue(explicit):
			from ExplicitImplementationMethodHeader(explicit).dimension_constraints
		DefaultImplementationMethodHeaderValue(_):
			[]


private pure func receiver_head_category(
	shape: ResolvedTypeShape,
) -> ImplementationReceiverHeadCategory:
	match shape:
		DeclaredTypeShape(_, _):
			DeclaredReceiverHead
		IntrinsicTypeShape(_, _):
			IntrinsicReceiverHead
		PreludeTypeShape(_, _):
			PreludeReceiverHead
		ArrayTypeShape(_, _):
			ArrayReceiverHead
		TupleTypeShape(_):
			TupleReceiverHead
		FunctionTypeShape(_, _, _):
			FunctionReceiverHead
		RangeTypeShape(_):
			RangeReceiverHead
		TypeParameterShape(_) | SelfTypeShape(_) | TraitTypeParameterShape(_) | TraitSelfTypeShape(_) | CallableTypeParameterShape(_) | ImplementationTypeParameterShape(_):
			ParameterReceiverHead
		DimensionParameterShape(_, _) | TraitDimensionParameterShape(_, _) | CallableDimensionParameterShape(_, _) | ImplementationDimensionParameterShape(_, _) | WildcardDimensionShape(_) | DimensionLiteralShape(_) | DimensionBinaryShape(_, _, _):
			DimensionReceiverHead


private pure func receiver_head_key(category: ImplementationReceiverHeadCategory) -> Int:
	match category:
		DeclaredReceiverHead:
			0
		IntrinsicReceiverHead:
			1
		PreludeReceiverHead:
			2
		ArrayReceiverHead:
			3
		TupleReceiverHead:
			4
		FunctionReceiverHead:
			5
		RangeReceiverHead:
			6
		ParameterReceiverHead:
			7
		DimensionReceiverHead:
			8


private pure func effective_implementation_type_parameters(
	type_headers: TypeHeaderGraph,
	module: BoundModule,
	skeleton: ImplementationDeclarationSkeletonInfo,
) -> List[ParsedTypeParamDecl]:
	candidates = discover_implicit_type_parameters_in_type(skeleton.source.for_type)
	var result: List[ParsedTypeParamDecl] = []
	var names: Dict[String, Bool] = {}

	for candidate in candidates:
		name = candidate.name.text

		if (
			not names.contains(name)
			and ((
				name.starts_with("#")
				or not type_header_graph_has_unqualified_type_name(type_headers, module, name)
			))
		):
			names = names.set(name, True)
			result = result.append(candidate)

	result


private pure func resolve_implementation_parameters(
	type_headers: TypeHeaderGraph,
	module: BoundModule,
	skeleton: ImplementationDeclarationSkeletonInfo,
) -> ImplementationParameterResolution:
	parsed = effective_implementation_type_parameters(type_headers, module, skeleton)
	ids = implementation_type_parameter_ids(
		skeleton.id,
		parsed.map(func(parameter): parameter.name.text),
	)
	declaration_graph = type_header_graph_declaration_graph(type_headers)
	bound_graph = type_header_graph_bound_graph(type_headers)
	var parameters: List[ResolvedImplementationTypeParameter] = []
	var names: Dict[String, Bool] = {}
	var errors: List[ImplementationHeaderGraphError] = []

	for pair in parsed.zip(ids):
		parameter = pair[0]
		id = pair[1]
		var bounds: List[TraitId] = []

		if names.contains(parameter.name.text):
			errors = errors.append(
				ImplementationDuplicateTypeParameter(
					skeleton.id,
					parameter.name,
				),
			)
		else:
			names = names.set(parameter.name.text, True)

		for bound in parameter.bounds:
			match resolve_visible_trait_id(declaration_graph, bound_graph, module, bound.text):
				None:
					errors = errors.append(
						ImplementationTypeParameterUnknownBound(
							skeleton.id,
							parameter.name,
							bound,
						),
					)
				Some(trait_id):
					if not bounds.any(func(existing): trait_ids_equal(existing, trait_id)):
						bounds = bounds.append(trait_id)

		resolved: ResolvedImplementationTypeParameter = into ResolvedImplementationTypeParameter({
				id = id,
				bounds = bounds
			})
		parameters = parameters.append(resolved)

	{
		parameters = parameters,
		errors = errors
	}


private pure func effective_method_type_parameters(
	type_headers: TypeHeaderGraph,
	module: BoundModule,
	implementation_parameters: List[ResolvedImplementationTypeParameter],
	decl: ParsedFunctionDecl,
) -> List[ParsedTypeParamDecl]:
	var candidates: List[ParsedTypeParamDecl] = []

	for param in decl.params:
		match param.type_expr:
			Some(type_expr):
				candidates = candidates.concat(discover_implicit_type_parameters_in_type(type_expr))
			None:
				void

	match decl.return_type:
		Some(type_expr):
			candidates = candidates.concat(discover_implicit_type_parameters_in_type(type_expr))
		None:
			void

	for constraint in decl.dim_constraints:
		candidates = candidates.concat(discover_implicit_type_parameters_in_type(constraint.left))
		candidates = candidates.concat(discover_implicit_type_parameters_in_type(constraint.right))

	var result = decl.type_params
	var names: Dict[String, Bool] = {}

	for parameter in implementation_parameters:
		names = names.set(
			implementation_type_parameter_id_name(
				resolved_implementation_type_parameter_id(parameter),
			),
			True,
		)

	for parameter in decl.type_params:
		names = names.set(parameter.name.text, True)

	for candidate in candidates:
		name = candidate.name.text

		if (
			not names.contains(name)
			and ((
				name.starts_with("#")
				or not type_header_graph_has_unqualified_type_name(type_headers, module, name)
			))
		):
			names = names.set(name, True)
			result = result.append(candidate)

	result


private pure func resolve_method_type_parameters(
	type_headers: TypeHeaderGraph,
	module: BoundModule,
	callable_id: CallableId,
	implementation_parameters: List[ResolvedImplementationTypeParameter],
	decl: ParsedFunctionDecl,
) -> ImplementationMethodParameterResolution:
	parsed = effective_method_type_parameters(type_headers, module, implementation_parameters, decl)
	ids = callable_type_parameter_ids(
		callable_id,
		parsed.map(func(parameter): parameter.name.text),
	)
	declaration_graph = type_header_graph_declaration_graph(type_headers)
	bound_graph = type_header_graph_bound_graph(type_headers)
	var parameters: List[ResolvedImplementationMethodTypeParameter] = []
	var names: Dict[String, Bool] = {}
	var implementation_names: Dict[String, Bool] = {}
	var errors: List[ImplementationHeaderGraphError] = []

	for parameter in implementation_parameters:
		implementation_names = implementation_names.set(
			implementation_type_parameter_id_name(
				resolved_implementation_type_parameter_id(parameter),
			),
			True,
		)

	for pair in parsed.zip(ids):
		parameter = pair[0]
		id = pair[1]
		var bounds: List[TraitId] = []

		if names.contains(parameter.name.text):
			errors = errors.append(
				ImplementationMethodDuplicateTypeParameter(
					callable_id,
					parameter.name,
				),
			)
		else:
			names = names.set(parameter.name.text, True)

		if implementation_names.contains(parameter.name.text):
			errors = errors.append(
				ImplementationMethodShadowsImplementationTypeParameter(
					callable_id,
					parameter.name,
				),
			)

		for bound in parameter.bounds:
			match resolve_visible_trait_id(declaration_graph, bound_graph, module, bound.text):
				Some(trait_id):
					if not bounds.any(func(existing): trait_ids_equal(existing, trait_id)):
						bounds = bounds.append(trait_id)
				None:
					errors = errors.append(
						ImplementationMethodTypeParameterUnknownBound(
							callable_id,
							parameter.name,
							bound,
						),
					)

		resolved: ResolvedImplementationMethodTypeParameter = into ResolvedImplementationMethodTypeParameter(
			{
				id = id,
				bounds = bounds
			}
		)
		parameters = parameters.append(resolved)

	{
		parameters = parameters,
		errors = errors
	}


private pure func resolved_method_parameter_id(
	parameter: ResolvedImplementationMethodTypeParameter,
) -> CallableTypeParameterId:
	from ResolvedImplementationMethodTypeParameter(parameter).id


private pure func append_method_type_errors(
	errors: List[ImplementationHeaderGraphError],
	resolution_errors: List[TypeShapeResolutionError],
) -> List[ImplementationHeaderGraphError]:
	var result = errors

	for error in resolution_errors:
		result = result.append(ImplementationTypeResolutionError(error))

	result


private pure func resolve_method_signature(
	type_headers: TypeHeaderGraph,
	implementation_id: ImplId,
	implementation_parameters: List[ResolvedImplementationTypeParameter],
	callable_id: CallableId,
	method_parameters: List[ResolvedImplementationMethodTypeParameter],
	receiver: ResolvedTypeShape,
	decl: ParsedFunctionDecl,
) -> ImplementationMethodSignatureResolution:
	implementation_parameter_ids = implementation_parameters.map(
		resolved_implementation_type_parameter_id,
	)
	method_parameter_ids = method_parameters.map(resolved_method_parameter_id)
	var resolved_params: List[CallableParameter] = []
	var resolved_constraints: List[(ResolvedTypeShape, ResolvedTypeShape)] = []
	var errors: List[ImplementationHeaderGraphError] = []
	var parameter_index: Int = 0

	for param in decl.params:
		match param.type_expr:
			None:
				errors = errors.append(
					ImplementationMethodMissingParameterType(
						callable_id,
						parameter_index,
						param.span,
					),
				)
			Some(type_expr):
				match resolve_implementation_method_type_shape(
					type_headers,
					implementation_id,
					implementation_parameter_ids,
					callable_id,
					method_parameter_ids,
					receiver,
					type_expr,
				):
					Ok(typ):
						resolved_params = resolved_params.append({
							binder = callable_parameter_binder_from_parsed(param),
							typ = typ,
						})
					Err(type_errors):
						errors = append_method_type_errors(errors, type_errors)

		parameter_index += 1

	var return_type: ResolvedTypeShape = IntrinsicTypeShape(IntrinsicVoid, [])

	match decl.return_type:
		None:
			void
		Some(type_expr):
			match resolve_implementation_method_type_shape(
				type_headers,
				implementation_id,
				implementation_parameter_ids,
				callable_id,
				method_parameter_ids,
				receiver,
				type_expr,
			):
				Ok(typ):
					return_type = typ
				Err(type_errors):
					errors = append_method_type_errors(errors, type_errors)

	for constraint in decl.dim_constraints:
		left = resolve_implementation_method_type_shape(
			type_headers,
			implementation_id,
			implementation_parameter_ids,
			callable_id,
			method_parameter_ids,
			receiver,
			constraint.left,
		)
		right = resolve_implementation_method_type_shape(
			type_headers,
			implementation_id,
			implementation_parameter_ids,
			callable_id,
			method_parameter_ids,
			receiver,
			constraint.right,
		)

		match left:
			Ok(left_shape):
				match right:
					Ok(right_shape):
						resolved_constraints = resolved_constraints.append(
							(left_shape, right_shape),
						)
					Err(right_errors):
						errors = append_method_type_errors(errors, right_errors)
			Err(left_errors):
				errors = append_method_type_errors(errors, left_errors)

				match right:
					Err(right_errors):
						errors = append_method_type_errors(errors, right_errors)
					Ok(_):
						void

	{
		signature = callable_signature(resolved_params, return_type, decl.is_pure),
		dimension_constraints = resolved_constraints,
		errors = errors
	}


private pure func find_default_trait_method(
	topology: TraitTopologyGraph,
	trait_id: TraitId,
	name: String,
) -> Option[TraitMethodSlot]:
	trait_ids = [
		trait_id,
	].concat(trait_topology_graph_transitive_supertraits(topology, trait_id).get_or([]))
	var result: Option[TraitMethodSlot] = None

	for current_trait_id in trait_ids:
		match trait_topology_graph_find(topology, current_trait_id):
			Some(header):
				match trait_topology_header_methods(
					header,
				).find(
					func(
						method,
					): (
						trait_method_slot_name(method) == name
						and trait_method_slot_category(method) == DefaultTraitMethod
					),
				):
					Some(method):
						result = Some(method)
						break
					None:
						void
			None:
				void

	result


private pure func substitute_default_receiver_shape(
	shape: ResolvedTypeShape,
	trait_id: TraitId,
	receiver: ResolvedTypeShape,
) -> ResolvedTypeShape:
	match shape:
		DeclaredTypeShape(id, args):
			DeclaredTypeShape(
				id,
				args.map(func(arg): substitute_default_receiver_shape(arg, trait_id, receiver)),
			)
		IntrinsicTypeShape(intrinsic, args):
			IntrinsicTypeShape(
				intrinsic,
				args.map(func(arg): substitute_default_receiver_shape(arg, trait_id, receiver)),
			)
		PreludeTypeShape(prelude, args):
			PreludeTypeShape(
				prelude,
				args.map(func(arg): substitute_default_receiver_shape(arg, trait_id, receiver)),
			)
		TraitSelfTypeShape(owner):
			if trait_ids_equal(owner, trait_id):
				receiver
			else:
				shape
		DimensionBinaryShape(operator, left, right):
			DimensionBinaryShape(
				operator,
				substitute_default_receiver_shape(left, trait_id, receiver),
				substitute_default_receiver_shape(right, trait_id, receiver),
			)
		RangeTypeShape(inner):
			RangeTypeShape(substitute_default_receiver_shape(inner, trait_id, receiver))
		TupleTypeShape(elements):
			TupleTypeShape(elements.map(
				func(element): substitute_default_receiver_shape(element, trait_id, receiver),
			))
		FunctionTypeShape(is_pure, parameters, return_type):
			FunctionTypeShape(
				is_pure,
				parameters.map(
					func(
						parameter,
					): substitute_default_receiver_shape(parameter, trait_id, receiver),
				),
				substitute_default_receiver_shape(return_type, trait_id, receiver),
			)
		ArrayTypeShape(element, dimensions):
			ArrayTypeShape(
				substitute_default_receiver_shape(element, trait_id, receiver),
				dimensions.map(
					func(
						dimension,
					): substitute_default_receiver_shape(dimension, trait_id, receiver),
				),
			)
		_:
			shape


private pure func implementation_default_signature(
	method: TraitMethodSlot,
	trait_id: TraitId,
	receiver: ResolvedTypeShape,
) -> CallableSignature:
	signature = trait_method_slot_signature(method)
	callable_signature(
		callable_signature_parameters(signature).map(func(parameter): {
				binder = parameter.binder,
				typ = substitute_default_receiver_shape(parameter.typ, trait_id, receiver)
			}),
		substitute_default_receiver_shape(
			callable_signature_return_type(signature),
			trait_id,
			receiver,
		),
		callable_signature_is_pure(signature),
	)


private pure func implementation_methods(
	topology: TraitTopologyGraph,
	module: BoundModule,
	implementation_id: ImplId,
	trait_id: TraitId,
	implementation_parameters: List[ResolvedImplementationTypeParameter],
	receiver: ResolvedTypeShape,
) -> ImplementationMethodsResolution:
	type_headers = trait_topology_graph_type_headers(topology)
	declaration_graph = type_header_graph_declaration_graph(type_headers)
	var methods: List[ImplementationMethodHeader] = []
	var errors: List[ImplementationHeaderGraphError] = []

	for skeleton in declaration_skeleton_graph_callable_skeletons(declaration_graph):
		match skeleton.source:
			ImplementationMethodCallableSource(owner, decl):
				if impl_ids_equal(owner, implementation_id):
					parameter_resolution = resolve_method_type_parameters(
						type_headers,
						module,
						skeleton.id,
						implementation_parameters,
						decl,
					)
					signature_resolution = resolve_method_signature(
						type_headers,
						implementation_id,
						implementation_parameters,
						skeleton.id,
						parameter_resolution.parameters,
						receiver,
						decl,
					)
					all_errors = parameter_resolution.errors.concat(signature_resolution.errors)

					if all_errors.is_empty():
						explicit: ExplicitImplementationMethodHeader = into ExplicitImplementationMethodHeader(
							{
								id = skeleton.id,
								source = decl,
								parameters = parameter_resolution.parameters,
								signature = signature_resolution.signature,
								dimension_constraints = signature_resolution.dimension_constraints
							}
						)
						methods = methods.append(ExplicitImplementationMethodHeaderValue(explicit))
					else:
						errors = errors.concat(all_errors)
			DefaultImplementationMethodCallableSource(owner, method_name, _):
				if impl_ids_equal(owner, implementation_id):
					match find_default_trait_method(topology, trait_id, method_name):
						Some(trait_method):
							default_method: DefaultImplementationMethodHeader = into DefaultImplementationMethodHeader(
								{
									id = skeleton.id,
									owner = implementation_id,
									trait_method = trait_method
								}
							)
							methods = methods.append(
								DefaultImplementationMethodHeaderValue(default_method),
							)
						None:
							errors = errors.append(
								ImplementationDefaultMethodMissing(
									implementation_id,
									method_name,
								),
							)
			FunctionCallableSource(_) | ForeignCallableSource(_):
				void

	{
		methods = methods,
		errors = errors
	}


private pure func missing_required_method_errors(
	topology: TraitTopologyGraph,
	implementation_id: ImplId,
	trait_id: TraitId,
	methods: List[ImplementationMethodHeader],
) -> List[ImplementationHeaderGraphError]:
	var provided_names: Dict[String, Bool] = {}

	for method in methods:
		provided_names = provided_names.set(
			callable_id_name(implementation_method_header_id(method)),
			True,
		)

	trait_ids = [trait_id]
	var errors: List[ImplementationHeaderGraphError] = []
	var checked_names: Dict[String, Bool] = {}

	for current_trait_id in trait_ids:
		match trait_topology_graph_find(topology, current_trait_id):
			Some(header):
				for slot in trait_topology_header_methods(header):
					name = trait_method_slot_name(slot)

					if not checked_names.contains(name):
						checked_names = checked_names.set(name, True)

						if (
							trait_method_slot_category(slot) == RequiredTraitMethod
							and not provided_names.contains(name)
						):
							errors = errors.append(
								ImplementationMissingRequiredMethod(
									implementation_id,
									trait_method_slot_id(slot),
									trait_method_slot_source(slot).span,
								),
							)
			None:
				void

	errors


private pure func append_candidate_index(
	index: Dict[Int, Dict[Int, List[Int]]],
	trait_id: TraitId,
	receiver_head: ImplementationReceiverHeadCategory,
	header_index: Int,
) -> Dict[Int, Dict[Int, List[Int]]]:
	trait_key = trait_id_definition_id(trait_id)
	head_key = receiver_head_key(receiver_head)
	trait_bucket = index
		.get(trait_key)
		.get_or({})
	head_bucket = trait_bucket
		.get(head_key)
		.get_or([])
		.append(header_index)
	index.set(
		trait_key,
		trait_bucket.set(head_key, head_bucket),
	)


pure func implementation_header_graph_build(
	callable_headers: CallableHeaderGraph,
) -> Result[ImplementationHeaderGraph, List[ImplementationHeaderGraphError]]:
	topology = callable_header_graph_trait_topology(callable_headers)
	type_headers = trait_topology_graph_type_headers(topology)
	declaration_graph = type_header_graph_declaration_graph(type_headers)
	bound_graph = type_header_graph_bound_graph(type_headers)
	var state: ImplementationHeaderBuildState = {
		headers = [],
		header_index_by_definition_id = {},
		index_by_trait_definition_id = {},
		errors = []
	}

	for skeleton in declaration_skeleton_graph_implementation_skeletons(declaration_graph):
		match bound_module_graph_find(bound_graph, impl_id_module_identity(skeleton.id)):
			None:
				state = { state |
					errors = state.errors.append(ImplementationOwnerModuleMissing(skeleton.id))
				}
			Some(module):
				match resolve_visible_trait_id(
					declaration_graph,
					bound_graph,
					module,
					skeleton.source.trait_name.text,
				):
					None:
						state = { state |
							errors = state.errors.append(
								ImplementationUnknownTrait(
									skeleton.id,
									skeleton.source.trait_name,
								),
							)
						}
					Some(trait_id):
						parameter_resolution = resolve_implementation_parameters(
							type_headers,
							module,
							skeleton,
						)
						parameter_ids = parameter_resolution.parameters.map(
							resolved_implementation_type_parameter_id,
						)

						match resolve_implementation_type_shape(
							type_headers,
							skeleton.id,
							parameter_ids,
							skeleton.source.for_type,
						):
							Err(resolution_errors):
								var errors = state.errors.concat(parameter_resolution.errors)

								for error in resolution_errors:
									errors = errors.append(ImplementationTypeResolutionError(error))

								state = { state | errors = errors }
							Ok(receiver):
								method_resolution = implementation_methods(
									topology,
									module,
									skeleton.id,
									trait_id,
									parameter_resolution.parameters,
									receiver,
								)
								all_errors = parameter_resolution.errors
									.concat(method_resolution.errors)
									.concat(
										missing_required_method_errors(
											topology,
											skeleton.id,
											trait_id,
											method_resolution.methods,
										),
									)

								if all_errors.is_empty():
									receiver_head = receiver_head_category(receiver)
									header: ImplementationHeader = into ImplementationHeader({
											id = skeleton.id,
											visibility = skeleton.visibility,
											source = skeleton.source,
											trait_id = trait_id,
											parameters = parameter_resolution.parameters,
											receiver = receiver,
											receiver_head = receiver_head,
											methods = method_resolution.methods
										})
									header_index = state.headers.length()
									state = {
										headers = state.headers.append(header),
										header_index_by_definition_id = state.header_index_by_definition_id.set(
											impl_id_definition_id(skeleton.id),
											header_index,
										),
										index_by_trait_definition_id = append_candidate_index(
											state.index_by_trait_definition_id,
											trait_id,
											receiver_head,
											header_index,
										),
										errors = state.errors
									}
								else:
									state = { state | errors = state.errors.concat(all_errors) }

	if state.errors.is_empty():
		Ok(into ImplementationHeaderGraph({
					callable_headers = callable_headers,
					headers = state.headers,
					header_index_by_definition_id = state.header_index_by_definition_id,
					index_by_trait_definition_id = state.index_by_trait_definition_id
				}))
	else:
		Err(state.errors)


private pure func implementation_header_graph_rep(
	graph: ImplementationHeaderGraph,
) -> ImplementationHeaderGraphRep:
	from ImplementationHeaderGraph(graph)


pure func implementation_header_graph_headers(
	graph: ImplementationHeaderGraph,
) -> List[ImplementationHeader]:
	implementation_header_graph_rep(graph).headers


pure func implementation_header_graph_find_definition_id(
	graph: ImplementationHeaderGraph,
	definition_id: Int,
) -> Option[ImplementationHeader]:
	representation = implementation_header_graph_rep(graph)
	index ?= representation.header_index_by_definition_id.get(definition_id)
	header ?= representation.headers.get(index)

	if impl_id_definition_id(implementation_header_id(header)) == definition_id:
		Some(header)
	else:
		None


pure func implementation_header_graph_callable_headers(
	graph: ImplementationHeaderGraph,
) -> CallableHeaderGraph:
	implementation_header_graph_rep(graph).callable_headers


pure func implementation_header_graph_candidates(
	graph: ImplementationHeaderGraph,
	trait_id: TraitId,
	receiver_head: ImplementationReceiverHeadCategory,
) -> List[ImplementationHeader]:
	representation = implementation_header_graph_rep(graph)

	indices: List[Int] = match representation.index_by_trait_definition_id.get(
		trait_id_definition_id(trait_id),
	):
		Some(bucket):
			bucket
				.get(receiver_head_key(receiver_head))
				.get_or([])
		None:
			[]

	var result: List[ImplementationHeader] = []

	for index in indices:
		match representation.headers.get(index):
			Some(header):
				if (
					trait_ids_equal(implementation_header_trait_id(header), trait_id)
					and implementation_header_receiver_head(header) == receiver_head
				):
					result = result.append(header)
			None:
				void

	result


pure func implementation_header_graph_error_message(
	error: ImplementationHeaderGraphError,
) -> String:
	match error:
		ImplementationOwnerModuleMissing(id):
			"implementation of '" + impl_id_name(
				id,
			) + "' has no bound owner module '" + module_identity_display_name(
				impl_id_module_identity(id),
			) + "'"
		ImplementationUnknownTrait(id, trait_name):
			"implementation '" + impl_id_name(
				id,
			) + "' refers to unknown trait '" + trait_name.text + "'"
		ImplementationDuplicateTypeParameter(id, parameter):
			"implementation of '" + impl_id_name(
				id,
			) + "' declares type parameter '" + parameter.text + "' more than once"
		ImplementationTypeParameterUnknownBound(id, parameter, bound):
			"implementation of '" + impl_id_name(
				id,
			) + "' type parameter '" + parameter.text + "' has unknown bound '" + bound.text + "'"
		ImplementationMethodDuplicateTypeParameter(id, parameter):
			"implementation method '" + callable_id_name(
				id,
			) + "' declares type parameter '" + parameter.text + "' more than once"
		ImplementationMethodShadowsImplementationTypeParameter(id, parameter):
			"implementation method '" + callable_id_name(
				id,
			) + "' redeclares implementation type parameter '" + parameter.text + ((
				"'; remove it from the method's type parameter list because implementation "
				+ "parameters are already in scope"
			))
		ImplementationMethodTypeParameterUnknownBound(id, parameter, bound):
			"implementation method '" + callable_id_name(
				id,
			) + "' type parameter '" + parameter.text + "' has unknown bound '" + bound.text + "'"
		ImplementationMethodMissingParameterType(id, parameter_index, _):
			"implementation method '" + callable_id_name(
				id,
			) + "' parameter " + (parameter_index + 1).to_string() + " must have an explicit type"
		ImplementationDefaultMethodMissing(id, method_name):
			"implementation of '" + impl_id_name(
				id,
			) + "' references missing default method '" + method_name + "'"
		ImplementationMissingRequiredMethod(id, method_id, _):
			"implementation of '" + impl_id_name(
				id,
			) + "' is missing required method '" + trait_method_id_name(method_id) + "'"
		ImplementationTypeResolutionError(resolution_error):
			type_shape_resolution_error_message(resolution_error)


pure func implementation_header_graph_error_span(
	error: ImplementationHeaderGraphError,
) -> SourceSpan:
	match error:
		ImplementationOwnerModuleMissing(id):
			impl_id_source_span(id)
		ImplementationUnknownTrait(_, trait_name):
			trait_name.span
		ImplementationDuplicateTypeParameter(_, parameter):
			parameter.span
		ImplementationTypeParameterUnknownBound(_, _, bound):
			bound.span
		ImplementationMethodDuplicateTypeParameter(_, parameter):
			parameter.span
		ImplementationMethodShadowsImplementationTypeParameter(_, parameter):
			parameter.span
		ImplementationMethodTypeParameterUnknownBound(_, _, bound):
			bound.span
		ImplementationMethodMissingParameterType(_, _, span):
			span
		ImplementationDefaultMethodMissing(id, _):
			impl_id_source_span(id)
		ImplementationMissingRequiredMethod(_, _, span):
			span
		ImplementationTypeResolutionError(resolution_error):
			type_shape_resolution_error_span(resolution_error)
