-- Accepted callable signature facts shared by trait, function, and foreign
-- declaration headers. Source binders are retained for diagnostics and named
-- argument behavior; semantic types are already resolved exact shapes.
import:
	../../stage_03_parse/parsed_ast:
		ParsedParam,
		ParsedParamBinder(ParsedParamNameBinder, ParsedParamTupleBinder, ParsedParamWildcardBinder),
	type_header_graph: ResolvedTypeShape


union CallableParameterBinder:
	NamedParameter(String)
	WildcardParameter
	TupleParameter(List[String])


record CallableParameter {
	binder: CallableParameterBinder,
	typ: ResolvedTypeShape
}


private record CallableSignatureRep {
	parameters: List[CallableParameter],
	return_type: ResolvedTypeShape,
	is_pure: Bool
}


opaque type CallableSignature = CallableSignatureRep


pure func callable_parameter_binder_from_parsed(param: ParsedParam) -> CallableParameterBinder:
	match param.binder:
		ParsedParamNameBinder(name):
			NamedParameter(name.text)
		ParsedParamWildcardBinder(_):
			WildcardParameter
		ParsedParamTupleBinder(names, _):
			TupleParameter(names.map(
				func(name): name.text,
			))


pure func callable_signature(
	parameters: List[CallableParameter],
	return_type: ResolvedTypeShape,
	is_pure: Bool,
) -> CallableSignature:
	into_opaque CallableSignature({
			parameters = parameters,
			return_type = return_type,
			is_pure = is_pure
		})


pure func callable_signature_parameters(signature: CallableSignature) -> List[CallableParameter]:
	from_opaque CallableSignature(signature).parameters


pure func callable_signature_return_type(signature: CallableSignature) -> ResolvedTypeShape:
	from_opaque CallableSignature(signature).return_type


pure func callable_signature_is_pure(signature: CallableSignature) -> Bool:
	from_opaque CallableSignature(signature).is_pure
