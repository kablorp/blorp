-- Build the graph-owned accepted union table and compact per-module views.
--
-- Every union and variant payload is canonicalized once. Preparing a module
-- then records only exact type identities and scalar constructor locators for
-- the source spellings visible in that module.
import:
	../graph/definition_index: definition_index_definition_table, definition_tables_share_provenance
	../graph/indexed_graph:
		PreparedModuleScope,
		indexed_graph_definition_index,
		prepared_module_scope_id,
	../graph/type_identity: type_id_definition_id
	../modules/bound_module_graph:
		BoundModule,
		BoundModuleGraph,
		bound_module_canonical_path,
		bound_module_graph_find_canonical_path,
		bound_module_graph_indexed_graph,
		bound_module_graph_modules,
		bound_module_graph_target,
		bound_module_scope,
		bound_module_view,
	../modules/module_view:
		ImportedConstructorBinding,
		ImportedNameBinding,
		module_view_imported_constructors,
		module_view_imported_names,
	../type_system/accepted_alias_authority: AcceptedAliasTable
	../type_system/accepted_union_authority:
		AcceptedUnionAuthority,
		AcceptedUnionEntry,
		AcceptedUnionTable,
		AcceptedUnionTableInput,
		AcceptedUnionTableRecord,
		AcceptedUnionVariantEntry,
		AcceptedVisibleConstructorBinding,
		AcceptedVisibleUnionBinding,
		accepted_union_authority,
		accepted_union_empty_module_view,
		accepted_union_module_view,
		accepted_union_table,
		accepted_union_table_entry_count,
	../type_system/env: Env, VariantDef
	../type_system/semantic_type: canonical_module_type_name
	declaration_skeleton: constructor_id_definition_id
	type_header_graph:
		AcceptedUnionHeader,
		TypeContainmentFacts,
		TypeHeaderGraph,
		UnionLayout(FieldlessEnum, TaggedUnion),
		type_header_graph_definition_table,
		type_header_graph_local_union_headers_for_scope,
		type_header_graph_public_union_headers_for_scope,
		union_type_header_containment_facts,
		union_type_header_contains_resource,
		union_type_header_id,
		union_type_header_layout,
		union_type_header_parameters,
		union_type_header_source_name,
		union_type_header_variants,
	type_header_install: imported_union_header_variants
	type_parameter_headers: type_parameter_id_name


opaque type AcceptedUnionGraph = AcceptedUnionTable


pure func accepted_union_graph_table(graph: AcceptedUnionGraph) -> AcceptedUnionTable:
	from_opaque AcceptedUnionGraph(graph)


struct AcceptedUnionGraphMetrics {
	accepted_union_table_builds: Int,
	union_entries: Int,
	canonical_module_views_built: Int
}


private record UnionInputCollection {
	unions: List[AcceptedUnionTableRecord],
	errors: List[String]
}


private pure func union_variant_entry(
	variant: VariantDef,
	constructor_id: Int,
) -> AcceptedUnionVariantEntry:
	{
		name = variant.name,
		constructor_id = constructor_id,
		fields = variant.fields,
		tag = variant.tag
	}


private pure func union_entry(
	variants: List[VariantDef],
	header: AcceptedUnionHeader,
) -> AcceptedUnionEntry:
	containment: TypeContainmentFacts = union_type_header_containment_facts(header)

	is_enum = match union_type_header_layout(header):
		FieldlessEnum:
			True
		TaggedUnion:
			False

	{
		type_params = union_type_header_parameters(
			header,
		).map(
			func(parameter): type_parameter_id_name(parameter.id),
		),
		variants = variants
			.zip(union_type_header_variants(header))
			.map(
				func(
					pair,
				): union_variant_entry(pair[0], constructor_id_definition_id(pair[1].id)),
			),
		is_enum = is_enum,
		contains_resource = union_type_header_contains_resource(header),
		may_contain_function = containment.may_contain_function,
		may_contain_one_shot_stream = containment.may_contain_one_shot_stream,
		may_contain_resource_source = containment.may_contain_resource_source
	}


private pure func public_union_ids(
	type_headers: TypeHeaderGraph,
	module_scope: PreparedModuleScope,
) -> Dict[Int, Bool]:
	var result: Dict[Int, Bool] = {}

	for header in type_header_graph_public_union_headers_for_scope(type_headers, module_scope):
		result = result.set(type_id_definition_id(union_type_header_id(header)), True)

	result


private pure func collect_module_inputs(
	collection: UnionInputCollection,
	type_headers: TypeHeaderGraph,
	module: BoundModule,
) -> UnionInputCollection:
	module_path = bound_module_canonical_path(module)
	module_scope = bound_module_scope(module)
	public_ids = public_union_ids(type_headers, module_scope)
	var unions = collection.unions
	var errors = collection.errors

	for header in type_header_graph_local_union_headers_for_scope(type_headers, module_scope):
		id = union_type_header_id(header)
		source_name = union_type_header_source_name(header)
		canonical_name = canonical_module_type_name(module_path, source_name)

		match imported_union_header_variants(type_headers, module_scope, module_path, header):
			Some(variants):
				unions = unions.append({
					id = id,
					canonical_name = canonical_name,
					canonical_visible = public_ids.contains(type_id_definition_id(id)),
					payload = union_entry(variants, header),
				})
			None:
				errors = errors.append(
					"accepted union table could not resolve canonical variants for '" + canonical_name + "'",
				)

	{
		unions = unions,
		errors = errors
	}


private pure func find_public_union_header(
	type_headers: TypeHeaderGraph,
	module_scope: PreparedModuleScope,
	name: String,
) -> Option[AcceptedUnionHeader]:
	var result: Option[AcceptedUnionHeader] = None

	for header in type_header_graph_public_union_headers_for_scope(type_headers, module_scope):
		if result.is_none() and union_type_header_source_name(header) == name:
			result = Some(header)

	result


private pure func local_union_bindings(
	type_headers: TypeHeaderGraph,
	module_scope: PreparedModuleScope,
) -> List[AcceptedVisibleUnionBinding]:
	var result: List[AcceptedVisibleUnionBinding] = []

	for header in type_header_graph_local_union_headers_for_scope(type_headers, module_scope):
		id = union_type_header_id(header)
		result = result.append({
			source_name = union_type_header_source_name(header),
			id = id,
			owner_local = True,
		})

	result


private pure func imported_union_binding(
	type_headers: TypeHeaderGraph,
	bound_graph: BoundModuleGraph,
	binding: ImportedNameBinding,
) -> Option[AcceptedVisibleUnionBinding]:
	module ?= bound_module_graph_find_canonical_path(bound_graph, binding.module_path)
	header ?= find_public_union_header(
		type_headers,
		bound_module_scope(module),
		binding.original_name,
	)
	Some({
		source_name = binding.local_name,
		id = union_type_header_id(header),
		owner_local = False,
	})


private pure func selected_constructor_binding(
	type_headers: TypeHeaderGraph,
	bound_graph: BoundModuleGraph,
	binding: ImportedConstructorBinding,
) -> Option[AcceptedVisibleConstructorBinding]:
	module ?= bound_module_graph_find_canonical_path(bound_graph, binding.module_path)
	header ?= find_public_union_header(
		type_headers,
		bound_module_scope(module),
		binding.parent_name,
	)
	var result: Option[AcceptedVisibleConstructorBinding] = None

	for variant in union_type_header_variants(header):
		if result.is_none() and variant.name == binding.original_name:
			result = Some({
				source_name = binding.local_name,
				parent_source_name = binding.parent_local_name,
				parent_id = union_type_header_id(header),
				constructor_id = constructor_id_definition_id(variant.id),
				owner_local = False,
			})

	result


pure func accepted_union_table_authority_for_module(
	table: AcceptedUnionTable,
	type_headers: TypeHeaderGraph,
	bound_module: BoundModule,
	bound_graph: BoundModuleGraph,
) -> Result[AcceptedUnionAuthority, String]:
	view = bound_module_view(bound_module)
	var union_bindings = local_union_bindings(type_headers, bound_module_scope(bound_module))
	var constructor_bindings: List[AcceptedVisibleConstructorBinding] = []

	-- Explicit constructor selections retain precedence because their scalar
	-- locators are appended before constructors exposed by imported unions.
	for binding in module_view_imported_constructors(view):
		match selected_constructor_binding(type_headers, bound_graph, binding):
			Some(visible):
				constructor_bindings = constructor_bindings.append(visible)
			None:
				void

	for binding in module_view_imported_names(view):
		match imported_union_binding(type_headers, bound_graph, binding):
			Some(visible):
				union_bindings = union_bindings.append(visible)
			None:
				void

	match accepted_union_module_view(
		table,
		prepared_module_scope_id(bound_module_scope(bound_module)),
		union_bindings,
		constructor_bindings,
	):
		Some(module_view):
			Ok(accepted_union_authority(table, module_view))
		None:
			Err("accepted union module view rejected conflicting source bindings")


pure func accepted_union_graph_build(
	type_headers: TypeHeaderGraph,
	bound_graph: BoundModuleGraph,
	type_identities: AcceptedAliasTable,
	builtin_env: Env,
	builtin_union_names: List[String],
) -> Result[AcceptedUnionGraph, List[String]]:
	definition_tables_match = definition_tables_share_provenance(
		type_header_graph_definition_table(type_headers),
		definition_index_definition_table(
			indexed_graph_definition_index(bound_module_graph_indexed_graph(bound_graph)),
		),
	)
	modules = [
		bound_module_graph_target(bound_graph),
	].concat(bound_module_graph_modules(bound_graph))

	initial_errors: List[String] = if definition_tables_match:
		[]
	else:
		["accepted union graph inputs have different definition origins"]

	var collection: UnionInputCollection = {
		unions = [],
		errors = initial_errors
	}

	for module in modules:
		collection = collect_module_inputs(collection, type_headers, module)

	if not collection.errors.is_empty():
		Err(collection.errors)
	else:
		input: AcceptedUnionTableInput = {
			definition_table = type_header_graph_definition_table(type_headers),
			unions = collection.unions
		}

		match accepted_union_table(input, type_identities, builtin_env, builtin_union_names):
			Ok(table):
				Ok(into_opaque AcceptedUnionGraph(table))
			Err(errors):
				Err(errors)


pure func accepted_union_table_canonical_authority(
	table: AcceptedUnionTable,
	owner_scope: PreparedModuleScope,
) -> AcceptedUnionAuthority:
	accepted_union_authority(table, accepted_union_empty_module_view())
