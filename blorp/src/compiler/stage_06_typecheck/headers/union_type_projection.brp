-- Accepted union metadata and every module-local overlay are built once from
-- resolved type headers. Exact canonical lookups share one public fallback;
-- constructor visibility is resolved through ModuleView and these indexes.
import:
	../../stage_04_modules/loaded_module: ModuleIdentity, module_identity_storage_key
	../graph/type_identity: type_id_name
	../modules/bound_module_graph:
		BoundModule,
		BoundModuleGraph,
		bound_module_canonical_path,
		bound_module_graph_find_canonical_path,
		bound_module_graph_modules,
		bound_module_graph_target,
		bound_module_identity,
		bound_module_view,
	../modules/module_view: module_view_imported_constructors, module_view_imported_names
	../type_system/env: Env, Symbol, VariantDef
	../type_system/semantic_type: canonical_module_type_name
	../type_system/union_type_index:
		AcceptedUnionEntry,
		AcceptedUnionVariantEntry,
		UnionTypeIndex,
		union_type_index_build,
		union_type_index_find,
		union_type_index_find_module_constructor_symbol_for_parent,
		union_type_index_with_builtins_from_env,
		union_type_index_with_fallback,
		union_type_index_with_visible_constructor_bindings,
	declaration_skeleton: constructor_id_definition_id
	type_header_graph:
		AcceptedUnionHeader,
		TypeContainmentFacts,
		TypeHeaderGraph,
		UnionLayout(FieldlessEnum, TaggedUnion),
		type_header_graph_local_union_headers,
		type_header_graph_public_union_headers,
		union_type_header_containment_facts,
		union_type_header_contains_resource,
		union_type_header_id,
		union_type_header_layout,
		union_type_header_parameters,
		union_type_header_variants,
	type_header_install: imported_union_header_variants, local_union_header_variants
	type_parameter_headers: type_parameter_id_name


private record UnionTypeProjectionRep {
	canonical_index: UnionTypeIndex,
	indexes_by_module_identity_key: Dict[String, UnionTypeIndex]
}


opaque type UnionTypeProjection = UnionTypeProjectionRep


private pure func union_type_projection_rep(
	projection: UnionTypeProjection,
) -> UnionTypeProjectionRep:
	from_opaque UnionTypeProjection(projection)


pure func union_type_projection_canonical_index(projection: UnionTypeProjection) -> UnionTypeIndex:
	union_type_projection_rep(projection).canonical_index


pure func union_type_projection_find(
	projection: UnionTypeProjection,
	module_identity: ModuleIdentity,
) -> Result[UnionTypeIndex, String]:
	union_type_projection_rep(projection).indexes_by_module_identity_key
		.get(module_identity_storage_key(module_identity))
		.to_result("accepted union projection is missing a module identity")


private pure func projected_variant(
	variant: VariantDef,
	constructor_id: Int,
) -> AcceptedUnionVariantEntry:
	{
		name = variant.name,
		constructor_id = constructor_id,
		fields = variant.fields,
		tag = variant.tag
	}


private pure func projected_entry(
	variants: List[VariantDef],
	header: AcceptedUnionHeader,
) -> AcceptedUnionEntry:
	containment: TypeContainmentFacts = union_type_header_containment_facts(header)

	is_enum = match union_type_header_layout(header):
		FieldlessEnum:
			True
		TaggedUnion:
			False

	{
		type_params = union_type_header_parameters(
			header,
		).map(
			func(parameter): type_parameter_id_name(parameter.id),
		),
		variants = variants
			.zip(union_type_header_variants(header))
			.map(func(pair): projected_variant(pair[0], constructor_id_definition_id(pair[1].id))),
		is_enum = is_enum,
		contains_resource = union_type_header_contains_resource(header),
		may_contain_function = containment.may_contain_function,
		may_contain_one_shot_stream = containment.may_contain_one_shot_stream,
		may_contain_resource_source = containment.may_contain_resource_source
	}


private pure func canonical_index(
	type_headers: TypeHeaderGraph,
	modules: List[BoundModule],
	builtin_env: Env,
	builtin_union_names: List[String],
) -> Result[UnionTypeIndex, List[String]]:
	var entries: List[(String, Option[String], AcceptedUnionEntry)] = []
	var errors: List[String] = []

	for module in modules:
		module_identity = bound_module_identity(module)
		module_path = bound_module_canonical_path(module)

		for header in type_header_graph_public_union_headers(type_headers, module_identity):
			canonical_name = canonical_module_type_name(
				module_path,
				type_id_name(union_type_header_id(header)),
			)

			match imported_union_header_variants(
				type_headers,
				module_identity,
				module_path,
				header,
			):
				Some(variants):
					entries = entries.append(
						(canonical_name, Some(module_path), projected_entry(variants, header)),
					)
				None:
					errors = errors.append(
						"accepted union projection could not resolve canonical variants for '" + canonical_name + "'",
					)

	if not errors.is_empty():
		Err(errors)
	else:
		match union_type_index_build(entries):
			Ok(index):
				match union_type_index_with_builtins_from_env(
					index,
					builtin_env,
					builtin_union_names,
				):
					Ok(with_builtins):
						Ok(with_builtins)
					Err(message):
						Err([message])
			Err(message):
				Err([message])


private pure func module_index(
	type_headers: TypeHeaderGraph,
	module: BoundModule,
	canonical: UnionTypeIndex,
) -> Result[UnionTypeIndex, String]:
	module_identity = bound_module_identity(module)
	module_path = bound_module_canonical_path(module)
	var entries: List[(String, Option[String], AcceptedUnionEntry)] = []
	var issue: Option[String] = None

	for header in type_header_graph_local_union_headers(type_headers, module_identity):
		if issue.is_none():
			match local_union_header_variants(type_headers, module_identity, module_path, header):
				Some(variants):
					entries = entries.append(
						(
							type_id_name(union_type_header_id(header)),
							None,
							projected_entry(variants, header),
						),
					)
				None:
					issue = Some("accepted union projection could not resolve local variants")

	match issue:
		Some(message):
			Err(message)
		None:
			match union_type_index_build(entries):
				Ok(index):
					Ok(union_type_index_with_fallback(index, canonical))
				Err(message):
					Err(message)


private pure func module_index_with_visible_constructors(
	index: UnionTypeIndex,
	module: BoundModule,
	bound_graph: BoundModuleGraph,
	canonical: UnionTypeIndex,
) -> UnionTypeIndex:
	var bindings: List[(String, String, Symbol)] = []

	-- Explicitly selected constructors retain their parent provenance and take
	-- precedence over same-named constructors exposed by imported unions.
	for binding in module_view_imported_constructors(bound_module_view(module)):
		match bound_module_graph_find_canonical_path(bound_graph, binding.module_path):
			Some(imported_module):
				imported_module_path = bound_module_canonical_path(imported_module)
				canonical_parent_name = canonical_module_type_name(
					imported_module_path,
					binding.parent_name,
				)

				match union_type_index_find_module_constructor_symbol_for_parent(
					canonical,
					imported_module_path,
					canonical_parent_name,
					binding.original_name,
				):
					Some(symbol):
						bindings = bindings.append(
							(binding.local_name, binding.parent_local_name, symbol),
						)
					None:
						void
			None:
				void

	-- Importing a union type makes its constructors available under their
	-- source spellings. Resolve that established language behavior from the
	-- graph-owned canonical index after explicit constructor selections, so an
	-- explicit same-named import keeps precedence without a body-time Env scan.
	for binding in module_view_imported_names(bound_module_view(module)):
		match bound_module_graph_find_canonical_path(bound_graph, binding.module_path):
			Some(imported_module):
				imported_module_path = bound_module_canonical_path(imported_module)
				canonical_parent_name = canonical_module_type_name(
					imported_module_path,
					binding.original_name,
				)

				match union_type_index_find(canonical, canonical_parent_name):
					Some(entry):
						for variant in entry.variants:
							match union_type_index_find_module_constructor_symbol_for_parent(
								canonical,
								imported_module_path,
								canonical_parent_name,
								variant.name,
							):
								Some(symbol):
									bindings = bindings.append(
										(variant.name, binding.local_name, symbol),
									)
								None:
									void
					None:
						void
			None:
				void

	union_type_index_with_visible_constructor_bindings(index, bindings)


pure func union_type_projection_build(
	type_headers: TypeHeaderGraph,
	bound_graph: BoundModuleGraph,
	builtin_env: Env,
	builtin_union_names: List[String],
) -> Result[UnionTypeProjection, List[String]]:
	modules = [
		bound_module_graph_target(bound_graph),
	].concat(bound_module_graph_modules(bound_graph))
	canonical ?= canonical_index(type_headers, modules, builtin_env, builtin_union_names)
	var indexes_by_module_identity_key: Dict[String, UnionTypeIndex] = {}
	var errors: List[String] = []

	for module in modules:
		module_identity = bound_module_identity(module)
		module_key = module_identity_storage_key(module_identity)

		if indexes_by_module_identity_key.contains(module_key):
			errors = errors.append("duplicate accepted union module projection")
		else:
			match module_index(type_headers, module, canonical):
				Ok(index):
					indexes_by_module_identity_key = indexes_by_module_identity_key.set(
						module_key,
						index,
					)
				Err(message):
					errors = errors.append(message)

	if errors.is_empty():
		for module in modules:
			module_key = module_identity_storage_key(bound_module_identity(module))

			match indexes_by_module_identity_key.get(module_key):
				Some(index):
					indexes_by_module_identity_key = indexes_by_module_identity_key.set(
						module_key,
						module_index_with_visible_constructors(
							index,
							module,
							bound_graph,
							canonical,
						),
					)
				None:
					void

		Ok(into_opaque UnionTypeProjection({
					canonical_index = canonical,
					indexes_by_module_identity_key = indexes_by_module_identity_key
				}))
	else:
		Err(errors)
