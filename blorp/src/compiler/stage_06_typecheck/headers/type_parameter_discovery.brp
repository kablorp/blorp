-- Structural discovery of the type and dimension parameters an `implements`
-- receiver introduces (`Labeled[T: Stringable]`, `Box[T]`, `Vector[#N]`).
--
-- Only a receiver introduces parameters in a type: a callable, record or union
-- declares them in its bracket list, and auto-generalization is gone. This
-- phase does not decide whether a named leaf is a declared type; the
-- implementation header applies its module's semantic name index after
-- discovery.
import:
	../../stage_03_parse/parsed_ast:
		ParsedTypeExpr(
			ParsedArrayType, ParsedBoundedType, ParsedDimBinaryType, ParsedDimLiteralType,
			ParsedDimNameType, ParsedFunctionType, ParsedMissingType, ParsedNamedType,
			ParsedQualifiedNamedType, ParsedRangeType, ParsedTupleType,
		),
		ParsedTypeParamDecl,
		ParsedTypeParamKind(ParsedDimensionParameter, ParsedTypeParameter),
	../type_system/semantic_type: DIM_VAR_SIGIL_LENGTH


---
A name may be a type parameter's when it is one identifier starting with an
uppercase letter. A dimension parameter's spelling starts with the `#` sigil,
which is not part of that identifier, so validation starts after it.
---
pure func type_parameter_name_is_valid(name: String, kind: ParsedTypeParamKind) -> Bool:
	body_start: Int = match kind:
		ParsedDimensionParameter:
			DIM_VAR_SIGIL_LENGTH
		ParsedTypeParameter:
			0

	if name == "#_" or name.length() <= body_start:
		False
	else:
		first = name.get_or(body_start, ' ')
		var valid = first >= 'A' and first <= 'Z'
		var index: Int = body_start + 1

		while valid and index < name.length():
			ch = name.get_or(index, ' ')
			valid = ch >= 'A' and ch <= 'Z' or ch >= 'a' and ch <= 'z' or ch >= '0' and ch <= '9'

			index += 1

		valid


pure func discover_receiver_type_parameters(
	types: List[ParsedTypeExpr],
) -> List[ParsedTypeParamDecl]:
	types.flat_map(discover_receiver_type_parameters_in_type)


pure func discover_receiver_type_parameters_in_type(
	type_expr: ParsedTypeExpr,
) -> List[ParsedTypeParamDecl]:
	match type_expr:
		ParsedNamedType(name, args, span):
			children = discover_receiver_type_parameters(args)

			if args.is_empty() and type_parameter_name_is_valid(name.text, ParsedTypeParameter):
				[
					{
						name = name,
						kind = ParsedTypeParameter,
						bounds = [],
						span = span
					},
				].concat(children)
			else:
				children
		ParsedQualifiedNamedType(_, _, args, _):
			discover_receiver_type_parameters(args)
		ParsedBoundedType(name, bounds, span):
			[
				{
					name = name,
					kind = ParsedTypeParameter,
					bounds = bounds,
					span = span
				},
			]
		ParsedDimNameType(name, _, span):
			if type_parameter_name_is_valid(name.text, ParsedDimensionParameter):
				[
					{
						name = name,
						kind = ParsedDimensionParameter,
						bounds = [],
						span = span
					},
				]
			else:
				[]
		ParsedDimLiteralType(_, _) | ParsedMissingType(_):
			[]
		ParsedDimBinaryType(_, left, right, _):
			discover_receiver_type_parameters_in_type(
				left,
			).concat(discover_receiver_type_parameters_in_type(right))
		ParsedRangeType(inner, _):
			discover_receiver_type_parameters_in_type(inner)
		ParsedTupleType(elements, _):
			discover_receiver_type_parameters(elements)
		ParsedFunctionType(_, params, return_type, _):
			discover_receiver_type_parameters(
				params,
			).concat(discover_receiver_type_parameters_in_type(return_type))
		ParsedArrayType(element, dimensions, _):
			discover_receiver_type_parameters_in_type(
				element,
			).concat(discover_receiver_type_parameters(dimensions))
