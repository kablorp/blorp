-- Build the graph-owned accepted record table and compact per-module views.
--
-- Every record field payload is canonicalized once. Preparing a module then
-- records only the established record identities needed for local lookup and
-- record-literal field-shape inference.
import:
	../../stage_04_modules/loaded_module: ModuleIdentity
	../graph/indexed_graph: PreparedModuleScope
	../graph/type_identity: TypeId, type_id_name, type_id_storage_key
	../modules/bound_module_graph:
		BoundModule,
		BoundModuleGraph,
		bound_module_canonical_path,
		bound_module_direct_import_modules,
		bound_module_graph_modules,
		bound_module_graph_target,
		bound_module_identity,
		bound_module_scope,
		bound_module_view,
	../modules/module_binding:
		ImportableModule,
		importable_module_path,
		importable_module_prepared_scope,
	../modules/module_view: module_view_has_imported_module
	../type_system/accepted_record_authority:
		AcceptedRecordAuthority,
		AcceptedRecordEntry,
		AcceptedRecordTable,
		AcceptedRecordTableInput,
		AcceptedRecordTableRecord,
		AcceptedVisibleRecordBinding,
		accepted_record_authority,
		accepted_record_empty_module_view,
		accepted_record_module_view,
		accepted_record_table,
		accepted_record_table_entry_count,
	../type_system/env: FieldDecl
	../type_system/semantic_type: canonical_module_type_name
	type_header_graph:
		AcceptedRecordHeader,
		RecordLayout(HeapRecord, ValueStruct),
		TypeContainmentFacts,
		TypeHeaderGraph,
		alias_type_header_id,
		builtin_type_header_id,
		record_type_header_containment_facts,
		record_type_header_contains_resource,
		record_type_header_id,
		record_type_header_layout,
		record_type_header_parameters,
		type_header_graph_local_alias_headers_for_scope,
		type_header_graph_local_builtin_headers_for_scope,
		type_header_graph_local_record_headers_for_scope,
		type_header_graph_local_union_headers_for_scope,
		type_header_graph_public_record_headers_for_scope,
		union_type_header_id,
	type_header_install: imported_record_header_fields
	type_parameter_headers: type_parameter_id_name


private record AcceptedRecordGraphRep {
	table: AcceptedRecordTable
}


opaque type AcceptedRecordGraph = AcceptedRecordGraphRep


struct AcceptedRecordGraphMetrics {
	accepted_record_table_builds: Int,
	record_entries: Int,
	canonical_module_views_built: Int
}


private record RecordInputCollection {
	known_type_ids: List[TypeId],
	records: List[AcceptedRecordTableRecord],
	errors: List[String]
}


private pure func graph_rep(graph: AcceptedRecordGraph) -> AcceptedRecordGraphRep:
	from_opaque AcceptedRecordGraph(graph)


private pure func append_known_type_ids(
	ids: List[TypeId],
	type_headers: TypeHeaderGraph,
	module_scope: PreparedModuleScope,
) -> List[TypeId]:
	var next = ids

	for header in type_header_graph_local_builtin_headers_for_scope(type_headers, module_scope):
		next = next.append(builtin_type_header_id(header))

	for header in type_header_graph_local_alias_headers_for_scope(type_headers, module_scope):
		next = next.append(alias_type_header_id(header))

	for header in type_header_graph_local_record_headers_for_scope(type_headers, module_scope):
		next = next.append(record_type_header_id(header))

	for header in type_header_graph_local_union_headers_for_scope(type_headers, module_scope):
		next = next.append(union_type_header_id(header))

	next


private pure func record_entry(
	fields: List[FieldDecl],
	header: AcceptedRecordHeader,
) -> AcceptedRecordEntry:
	containment: TypeContainmentFacts = record_type_header_containment_facts(header)

	is_value = match record_type_header_layout(header):
		ValueStruct:
			True
		HeapRecord:
			False

	{
		type_params = record_type_header_parameters(
			header,
		).map(
			func(parameter): type_parameter_id_name(parameter.id),
		),
		fields = fields,
		is_value = is_value,
		contains_resource = record_type_header_contains_resource(header),
		may_contain_function = containment.may_contain_function,
		may_contain_one_shot_stream = containment.may_contain_one_shot_stream,
		may_contain_resource_source = containment.may_contain_resource_source
	}


private pure func public_record_ids(
	type_headers: TypeHeaderGraph,
	module_scope: PreparedModuleScope,
) -> Dict[String, Bool]:
	var result: Dict[String, Bool] = {}

	for header in type_header_graph_public_record_headers_for_scope(type_headers, module_scope):
		result = result.set(type_id_storage_key(record_type_header_id(header)), True)

	result


private pure func collect_module_inputs(
	collection: RecordInputCollection,
	type_headers: TypeHeaderGraph,
	module: BoundModule,
) -> RecordInputCollection:
	module_identity = bound_module_identity(module)
	module_path = bound_module_canonical_path(module)
	module_scope = bound_module_scope(module)
	public_ids = public_record_ids(type_headers, module_scope)
	var records = collection.records
	var errors = collection.errors

	for header in type_header_graph_local_record_headers_for_scope(type_headers, module_scope):
		id = record_type_header_id(header)
		canonical_name = canonical_module_type_name(module_path, type_id_name(id))

		match imported_record_header_fields(type_headers, module_identity, module_path, header):
			Some(fields):
				records = records.append({
					id = id,
					owner_module_path = module_path,
					canonical_name = canonical_name,
					canonical_visible = public_ids.contains(type_id_storage_key(id)),
					payload = record_entry(fields, header),
				})
			None:
				errors = errors.append(
					"accepted record table could not resolve canonical fields for '" + canonical_name + "'",
				)

	{
		known_type_ids = append_known_type_ids(
			collection.known_type_ids,
			type_headers,
			module_scope,
		),
		records = records,
		errors = errors
	}


private pure func visible_binding(
	name: String,
	id: TypeId,
	owner_local: Bool,
	infer_from_fields: Bool,
) -> AcceptedVisibleRecordBinding:
	{
		source_name = name,
		id = id,
		owner_local = owner_local,
		infer_from_fields = infer_from_fields
	}


private pure func append_local_bindings(
	bindings: List[AcceptedVisibleRecordBinding],
	type_headers: TypeHeaderGraph,
	module_scope: PreparedModuleScope,
) -> List[AcceptedVisibleRecordBinding]:
	var next = bindings

	for header in type_header_graph_local_record_headers_for_scope(type_headers, module_scope):
		id = record_type_header_id(header)
		next = next.append(visible_binding(type_id_name(id), id, True, True))

	next


private pure func append_direct_import_bindings(
	bindings: List[AcceptedVisibleRecordBinding],
	type_headers: TypeHeaderGraph,
	module: ImportableModule,
) -> List[AcceptedVisibleRecordBinding]:
	module_scope = importable_module_prepared_scope(module)
	module_path = importable_module_path(module)
	var next = bindings

	for header in type_header_graph_public_record_headers_for_scope(type_headers, module_scope):
		id = record_type_header_id(header)
		next = next.append(
			visible_binding(
				canonical_module_type_name(module_path, type_id_name(id)),
				id,
				False,
				True,
			),
		)

	next


pure func accepted_record_graph_authority_for_module(
	graph: AcceptedRecordGraph,
	type_headers: TypeHeaderGraph,
	bound_module: BoundModule,
) -> Result[AcceptedRecordAuthority, String]:
	module_identity = bound_module_identity(bound_module)
	module_view = bound_module_view(bound_module)
	var bindings = append_local_bindings([], type_headers, bound_module_scope(bound_module))

	for imported_module in bound_module_direct_import_modules(bound_module):
		if module_view_has_imported_module(module_view, importable_module_path(imported_module)):
			bindings = append_direct_import_bindings(bindings, type_headers, imported_module)

	match accepted_record_module_view(graph_rep(graph).table, module_identity, bindings):
		Some(view):
			Ok(accepted_record_authority(graph_rep(graph).table, view))
		None:
			Err("accepted record module view rejected conflicting source bindings")


pure func accepted_record_graph_build(
	type_headers: TypeHeaderGraph,
	bound_graph: BoundModuleGraph,
) -> Result[AcceptedRecordGraph, List[String]]:
	modules = [
		bound_module_graph_target(bound_graph),
	].concat(bound_module_graph_modules(bound_graph))
	var collection: RecordInputCollection = {
		known_type_ids = [],
		records = [],
		errors = []
	}

	for module in modules:
		collection = collect_module_inputs(collection, type_headers, module)

	if not collection.errors.is_empty():
		Err(collection.errors)
	else:
		input: AcceptedRecordTableInput = {
			known_type_ids = collection.known_type_ids,
			records = collection.records
		}

		match accepted_record_table(input):
			Some(table):
				Ok(into_opaque AcceptedRecordGraph({table = table}))
			None:
				Err(["accepted record table rejected duplicate or mismatched identities"])


pure func accepted_record_graph_canonical_authority(
	graph: AcceptedRecordGraph,
	owner: ModuleIdentity,
) -> AcceptedRecordAuthority:
	accepted_record_authority(graph_rep(graph).table, accepted_record_empty_module_view(owner))


pure func accepted_record_graph_metrics(
	graph: AcceptedRecordGraph,
	canonical_module_views_built: Int,
) -> AcceptedRecordGraphMetrics:
	{
		accepted_record_table_builds = 1,
		record_entries = accepted_record_table_entry_count(graph_rep(graph).table),
		canonical_module_views_built = canonical_module_views_built
	}
