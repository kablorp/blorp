		bound_module_graph_indexed_graph,
		bound_module_graph_modules,
		bound_module_graph_target,
		bound_module_scope,
		bound_module_view,
	../modules/module_view: BoundAcceptedDefinitionBinding, module_view_accepted_definition_bindings
	../type_system/accepted_alias_authority:
		AcceptedAliasAuthority,
		AcceptedAliasModuleView,
		AcceptedAliasTable,
		AcceptedAliasTableInput,
		AcceptedOpaqueAlias,
		AcceptedTransparentAlias,
		AcceptedTypeIdentity,
		AcceptedVisibleTypeBinding,
		accepted_alias_authority,
		accepted_alias_empty_module_view,
		accepted_alias_module_view,
		accepted_alias_table,
		accepted_alias_table_alias_count,
		accepted_alias_table_definition_table,
		accepted_alias_table_find_type_identity,
	../type_system/semantic_type: canonical_module_type_name
	type_header_graph:
		AcceptedAliasHeader,
		AcceptedBuiltinHeader,
		AcceptedRecordHeader,
		AcceptedUnionHeader,
		AliasLayout(OpaqueAlias, TransparentAlias),
		TypeHeaderGraph,
		alias_type_header_id,
		alias_type_header_layout,
		alias_type_header_parameters,
		alias_type_header_source_name,
		alias_type_header_target,
		builtin_type_header_id,
		builtin_type_header_parameters,
