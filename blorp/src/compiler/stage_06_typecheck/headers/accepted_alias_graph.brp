-- A zero-cost, sealed proof that this table came from the complete accepted
-- alias-header projection. Unlike the former one-field record wrapper, this
-- opaque alias adds no allocation or retained owner.
opaque type AcceptedAliasGraph = AcceptedAliasTable


pure func accepted_alias_graph_table(graph: AcceptedAliasGraph) -> AcceptedAliasTable:
	from_opaque AcceptedAliasGraph(graph)


struct AcceptedAliasGraphMetrics {
	accepted_alias_table_builds: Int,
	alias_entries: Int,
	canonical_module_views_built: Int
}


private pure func accepted_type_identity(
	module_path: String,
	id: TypeId,
	source_name: String,
	parameters: List[ResolvedTypeParameter],
) -> AcceptedTypeIdentity:
	{
		id = id,
		canonical_name = canonical_module_type_name(module_path, source_name),
		type_params = parameters.map(func(parameter): type_parameter_id_name(parameter.id))
	}


private pure func append_builtin_identities(
	identities: List[AcceptedTypeIdentity],
	module_path: String,
	headers: List[AcceptedBuiltinHeader],
) -> List[AcceptedTypeIdentity]:
	var next = identities

	for header in headers:
		next = next.append(
			accepted_type_identity(
				module_path,
				builtin_type_header_id(header),
				builtin_type_header_source_name(header),
				builtin_type_header_parameters(header),
			),
		)

	next


private pure func append_record_identities(
	identities: List[AcceptedTypeIdentity],
	module_path: String,
	headers: List[AcceptedRecordHeader],
) -> List[AcceptedTypeIdentity]:
	var next = identities

	for header in headers:
		next = next.append(
			accepted_type_identity(
				module_path,
				record_type_header_id(header),
				record_type_header_source_name(header),
				record_type_header_parameters(header),
			),
		)

	next


private pure func append_union_identities(
	identities: List[AcceptedTypeIdentity],
	module_path: String,
	headers: List[AcceptedUnionHeader],
) -> List[AcceptedTypeIdentity]:
	var next = identities

	for header in headers:
		next = next.append(
			accepted_type_identity(
				module_path,
				union_type_header_id(header),
				union_type_header_source_name(header),
				union_type_header_parameters(header),
			),
		)

	next


private record AliasInputCollection {
	identities: List[AcceptedTypeIdentity],
	transparent: List[AcceptedTransparentAlias],
	opaque_entries: List[AcceptedOpaqueAlias],
	errors: List[String]
}


private pure func append_alias_inputs(
	collection: AliasInputCollection,
	type_headers: TypeHeaderGraph,
	module_scope: PreparedModuleScope,
	module_path: String,
	headers: List[AcceptedAliasHeader],
	public_alias_ids: Dict[Int, Bool],
) -> AliasInputCollection:
	var identities = collection.identities
	var transparent = collection.transparent
	var opaque_entries = collection.opaque_entries
	var errors = collection.errors

	for header in headers:
		id = alias_type_header_id(header)
		parameters = alias_type_header_parameters(header)
		identity = accepted_type_identity(
			module_path,
			id,
			alias_type_header_source_name(header),
			parameters,
		)
		canonical_visible = public_alias_ids.contains(type_id_definition_id(id))
		identities = identities.append(identity)

		match imported_semantic_type_from_resolved_shape(
			type_headers,
			module_scope,
			module_path,
			alias_type_header_target(header),
		):
			Some(target):
				match alias_type_header_layout(header):
					TransparentAlias:
						transparent = transparent.append({
							id = id,
							canonical_name = identity.canonical_name,
							canonical_visible = canonical_visible,
							payload = {
								type_params = identity.type_params,
								target = target
							},
						})
					OpaqueAlias:
						opaque_entries = opaque_entries.append({
							id = id,
							canonical_name = identity.canonical_name,
							canonical_visible = canonical_visible,
							payload = {
								canonical_name = identity.canonical_name,
								type_params = identity.type_params,
								target = target,
								home_module = module_path
							},
						})
			None:
				errors = errors.append(
					"accepted alias table could not resolve canonical target for '" + identity.canonical_name + "'",
				)

	{
		identities = identities,
		transparent = transparent,
		opaque_entries = opaque_entries,
		errors = errors
	}


private pure func collect_module_inputs(
	collection: AliasInputCollection,
	type_headers: TypeHeaderGraph,
	module: BoundModule,
) -> AliasInputCollection:
	module_path = bound_module_canonical_path(module)
	module_scope = bound_module_scope(module)
	var public_alias_ids: Dict[Int, Bool] = {}

	for header in type_header_graph_public_alias_headers_for_scope(type_headers, module_scope):
		public_alias_ids = public_alias_ids.set(
			type_id_definition_id(alias_type_header_id(header)),
			True,
		)

	with_builtins = append_builtin_identities(
		collection.identities,
		module_path,
		type_header_graph_local_builtin_headers_for_scope(type_headers, module_scope),
	)
	with_records = append_record_identities(
		with_builtins,
		module_path,
		type_header_graph_local_record_headers_for_scope(type_headers, module_scope),
	)
	with_unions = append_union_identities(
		with_records,
		module_path,
		type_header_graph_local_union_headers_for_scope(type_headers, module_scope),
	)
	append_alias_inputs(
		{ collection | identities = with_unions },
		type_headers,
		module_scope,
		module_path,
		type_header_graph_local_alias_headers_for_scope(type_headers, module_scope),
		public_alias_ids,
	)


pure func accepted_alias_graph_build(
	type_headers: TypeHeaderGraph,
	bound_graph: BoundModuleGraph,
) -> Result[AcceptedAliasGraph, List[String]]:
	definition_tables_match = definition_tables_share_provenance(
		type_header_graph_definition_table(type_headers),
		definition_index_definition_table(
			indexed_graph_definition_index(bound_module_graph_indexed_graph(bound_graph)),
		),
	)
	modules = [
		bound_module_graph_target(bound_graph),
	].concat(bound_module_graph_modules(bound_graph))

	initial_errors: List[String] = if definition_tables_match:
		[]
	else:
		["accepted alias graph inputs have different definition origins"]

	var collection: AliasInputCollection = {
		identities = [],
		transparent = [],
		opaque_entries = [],
		errors = initial_errors
	}

	for module in modules:
		collection = collect_module_inputs(collection, type_headers, module)

	if not collection.errors.is_empty():
		Err(collection.errors)
	else:
		input: AcceptedAliasTableInput = {
			definition_table = type_header_graph_definition_table(type_headers),
			type_identities = collection.identities,
			transparent_aliases = collection.transparent,
			opaque_aliases = collection.opaque_entries
		}

		match accepted_alias_table(input):
			Some(table):
				Ok(into_opaque AcceptedAliasGraph(table))
			None:
				Err(["accepted alias table rejected duplicate or mismatched identities"])


private pure func append_visible_binding(
	bindings: List[AcceptedVisibleTypeBinding],
	name: String,
	id: TypeId,
	owner_local: Bool,
) -> List[AcceptedVisibleTypeBinding]:
	bindings.append({
		source_name = name,
		id = id,
		owner_local = owner_local,
	})


private pure func append_local_bindings(
	bindings: List[AcceptedVisibleTypeBinding],
	type_headers: TypeHeaderGraph,
	module_scope: PreparedModuleScope,
) -> List[AcceptedVisibleTypeBinding]:
	var next = bindings

	for header in type_header_graph_local_alias_headers_for_scope(type_headers, module_scope):
		id = alias_type_header_id(header)
		next = append_visible_binding(next, alias_type_header_source_name(header), id, True)

	next


private pure func append_imported_candidate_bindings(
	bindings: List[AcceptedVisibleTypeBinding],
	table: AcceptedAliasTable,
	candidates: List[BoundAcceptedDefinitionBinding],
) -> List[AcceptedVisibleTypeBinding]:
	definition_table = accepted_alias_table_definition_table(table)
	var next = bindings

	for candidate in candidates:
		for definition_id in candidate.definition_ids:
			match type_id_from_definition_table(
				definition_table,
				definition_id_runtime_value(definition_id),
			):
				Some(type_id):
					identity = accepted_alias_table_find_type_identity(table, type_id)
					owner_matches = type_id_module_id(definition_table, type_id)
						.map(func(owner): module_ids_equal(owner, candidate.module_id))
						.get_or(False)

					match identity:
						Some(found):
							if owner_matches and candidate.local_name != found.canonical_name:
								next = append_visible_binding(
									next,
									candidate.local_name,
									type_id,
									False,
								)
						None:
							void
				None:
					void

	next


pure func accepted_alias_table_authority_for_module(
	table: AcceptedAliasTable,
	type_headers: TypeHeaderGraph,
	bound_module: BoundModule,
) -> Result[AcceptedAliasAuthority, String]:
	table_definition_table = accepted_alias_table_definition_table(table)
	header_definition_table = type_header_graph_definition_table(type_headers)
	graph_definition_table = definition_index_definition_table(
		indexed_graph_definition_index(
			bound_module_graph_indexed_graph(type_header_graph_bound_graph(type_headers)),
		),
	)
	bound_graph = type_header_graph_bound_graph(type_headers)
	bound_scope_matches = bound_module_graph_find_for_scope(
		bound_graph,
		bound_module_scope(bound_module),
	).is_some()

	if (
		not definition_tables_share_provenance(table_definition_table, header_definition_table)
		or not definition_tables_share_provenance(header_definition_table, graph_definition_table)
		or not bound_scope_matches
	):
		Err("accepted alias authority rejected mismatched definition-table provenance")
	else:
		var bindings = append_local_bindings([], type_headers, bound_module_scope(bound_module))
		bindings = append_imported_candidate_bindings(
			bindings,
			table,
			module_view_accepted_definition_bindings(bound_module_view(bound_module)),
		)

		match accepted_alias_module_view(
			table,
			prepared_module_scope_id(bound_module_scope(bound_module)),
			bindings,
		):
			Some(view):
				Ok(accepted_alias_authority(table, view))
			None:
				Err("accepted alias module view rejected conflicting source bindings")


pure func accepted_alias_table_canonical_authority(
	table: AcceptedAliasTable,
) -> AcceptedAliasAuthority:
	view = accepted_alias_empty_module_view()
	accepted_alias_authority(table, view)
