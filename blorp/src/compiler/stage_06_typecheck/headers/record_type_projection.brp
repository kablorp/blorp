-- Canonical accepted record metadata and every module-visible overlay are
-- built once from type headers. Module preparation performs an identity-keyed
-- lookup and shares the graph-wide exact-lookup dictionaries as fallback.
import:
	../../stage_04_modules/loaded_module: ModuleIdentity, module_identity_storage_key
	../graph/indexed_graph: prepared_module_scope_identity
	../graph/type_identity: type_id_name
	../modules/bound_module_graph:
		BoundModule,
		BoundModuleGraph,
		bound_module_canonical_path,
		bound_module_direct_import_modules,
		bound_module_graph_modules,
		bound_module_graph_target,
		bound_module_identity,
		bound_module_view,
	../modules/module_binding:
		ImportableModule,
		importable_module_path,
		importable_module_prepared_scope,
	../modules/module_view: module_view_has_imported_module
	../type_system/env: FieldDecl
	../type_system/record_type_index:
		AcceptedRecordEntry,
		RECORD_TYPE_INDEX_EMPTY,
		RecordTypeIndex,
		record_type_index_add,
		record_type_index_find,
		record_type_index_with_fallback,
	../type_system/semantic_type: canonical_module_type_name
	type_header_graph:
		AcceptedRecordHeader,
		RecordLayout(HeapRecord, ValueStruct),
		TypeContainmentFacts,
		TypeHeaderGraph,
		record_type_header_containment_facts,
		record_type_header_contains_resource,
		record_type_header_id,
		record_type_header_layout,
		record_type_header_parameters,
		type_header_graph_local_record_headers,
		type_header_graph_public_record_headers,
	type_header_install: imported_record_header_fields, local_record_header_fields
	type_parameter_headers: type_parameter_id_name


private record RecordTypeProjectionRep {
	canonical_index: RecordTypeIndex,
	indexes_by_module_identity_key: Dict[String, RecordTypeIndex]
}


opaque type RecordTypeProjection = RecordTypeProjectionRep


private pure func record_type_projection_rep(
	projection: RecordTypeProjection,
) -> RecordTypeProjectionRep:
	from_opaque RecordTypeProjection(projection)


pure func record_type_projection_canonical_index(
	projection: RecordTypeProjection,
) -> RecordTypeIndex:
	record_type_projection_rep(projection).canonical_index


private pure func add_record_entry(
	index: RecordTypeIndex,
	name: String,
	entry: AcceptedRecordEntry,
) -> Result[RecordTypeIndex, String]:
	match record_type_index_add(index, name, entry):
		Some(next):
			Ok(next)
		None:
			Err("duplicate accepted record projection for '" + name + "'")


private pure func record_entry(
	fields: List[FieldDecl],
	header: AcceptedRecordHeader,
) -> AcceptedRecordEntry:
	containment: TypeContainmentFacts = record_type_header_containment_facts(header)

	is_value = match record_type_header_layout(header):
		ValueStruct:
			True
		HeapRecord:
			False

	{
		type_params = record_type_header_parameters(
			header,
		).map(
			func(parameter): type_parameter_id_name(parameter.id),
		),
		fields = fields,
		is_value = is_value,
		contains_resource = record_type_header_contains_resource(header),
		may_contain_function = containment.may_contain_function,
		may_contain_one_shot_stream = containment.may_contain_one_shot_stream,
		may_contain_resource_source = containment.may_contain_resource_source
	}


private pure func add_local_record_header(
	index: RecordTypeIndex,
	type_headers: TypeHeaderGraph,
	module_identity: ModuleIdentity,
	module_path: String,
	header: AcceptedRecordHeader,
) -> Result[RecordTypeIndex, String]:
	match local_record_header_fields(type_headers, module_identity, module_path, header):
		Some(fields):
			add_record_entry(
				index,
				type_id_name(record_type_header_id(header)),
				record_entry(fields, header),
			)
		None:
			Err("accepted record projection could not resolve local fields")


private pure func add_visible_import_record(
	index: RecordTypeIndex,
	canonical_index: RecordTypeIndex,
	module_path: String,
	header: AcceptedRecordHeader,
) -> Result[RecordTypeIndex, String]:
	source_name = type_id_name(record_type_header_id(header))
	canonical_name = canonical_module_type_name(module_path, source_name)

	match record_type_index_find(canonical_index, canonical_name):
		None:
			Err("accepted record projection is missing canonical record '" + canonical_name + "'")
		Some(entry):
			add_record_entry(index, canonical_name, entry)


private pure func record_type_index_for_module(
	type_headers: TypeHeaderGraph,
	bound_module: BoundModule,
	canonical_index: RecordTypeIndex,
) -> Result[RecordTypeIndex, String]:
	module_identity = bound_module_identity(bound_module)
	module_path = bound_module_canonical_path(bound_module)
	module_view = bound_module_view(bound_module)
	var index = RECORD_TYPE_INDEX_EMPTY
	var issue: Option[String] = None

	for header in type_header_graph_local_record_headers(type_headers, module_identity):
		if issue.is_none():
			match add_local_record_header(
				index,
				type_headers,
				module_identity,
				module_path,
				header,
			):
				Ok(next):
					index = next
				Err(message):
					issue = Some(message)

	-- Canonical fallback serves exact metadata for transitive accepted types.
	-- Only explicit direct imports participate in source-level record literal
	-- inference; ambient implementation modules are not source imports.
	for imported_module in bound_module_direct_import_modules(bound_module):
		imported_identity = prepared_module_scope_identity(
			importable_module_prepared_scope(imported_module),
		)
		imported_path = importable_module_path(imported_module)

		if module_view_has_imported_module(module_view, imported_path):
			for header in type_header_graph_public_record_headers(type_headers, imported_identity):
				if issue.is_none():
					match add_visible_import_record(index, canonical_index, imported_path, header):
						Ok(next):
							index = next
						Err(message):
							issue = Some(message)

	match issue:
		Some(message):
			Err(message)
		None:
			Ok(record_type_index_with_fallback(index, canonical_index))


pure func record_type_projection_find(
	projection: RecordTypeProjection,
	module_identity: ModuleIdentity,
) -> Result[RecordTypeIndex, String]:
	record_type_projection_rep(projection).indexes_by_module_identity_key
		.get(module_identity_storage_key(module_identity))
		.to_result("accepted record projection is missing a module identity")


private pure func canonical_record_type_index(
	type_headers: TypeHeaderGraph,
	modules: List[BoundModule],
) -> Result[RecordTypeIndex, List[String]]:
	var index = RECORD_TYPE_INDEX_EMPTY
	var errors: List[String] = []

	for module in modules:
		module_identity = bound_module_identity(module)
		module_path = bound_module_canonical_path(module)

		for header in type_header_graph_public_record_headers(type_headers, module_identity):
			canonical_name = canonical_module_type_name(
				module_path,
				type_id_name(record_type_header_id(header)),
			)

			match imported_record_header_fields(type_headers, module_identity, module_path, header):
				Some(fields):
					match add_record_entry(
						index,
						canonical_name,
						record_entry(fields, header),
					):
						Ok(next):
							index = next
						Err(message):
							errors = errors.append(message)
				None:
					errors = errors.append(
						"accepted record projection could not resolve canonical fields for '" + canonical_name + "'",
					)

	if errors.is_empty():
		Ok(index)
	else:
		Err(errors)


pure func record_type_projection_build(
	type_headers: TypeHeaderGraph,
	bound_graph: BoundModuleGraph,
) -> Result[RecordTypeProjection, List[String]]:
	modules = [
		bound_module_graph_target(bound_graph),
	].concat(bound_module_graph_modules(bound_graph))
	canonical_index ?= canonical_record_type_index(type_headers, modules)
	var indexes_by_module_identity_key: Dict[String, RecordTypeIndex] = {}
	var errors: List[String] = []

	for module in modules:
		module_identity = bound_module_identity(module)
		module_key = module_identity_storage_key(module_identity)

		if indexes_by_module_identity_key.contains(module_key):
			errors = errors.append("duplicate accepted record module projection")
		else:
			match record_type_index_for_module(type_headers, module, canonical_index):
				Ok(index):
					indexes_by_module_identity_key = indexes_by_module_identity_key.set(
						module_key,
						index,
					)
				Err(message):
					errors = errors.append(message)

	if errors.is_empty():
		Ok(into_opaque RecordTypeProjection({
					canonical_index = canonical_index,
					indexes_by_module_identity_key = indexes_by_module_identity_key
				}))
	else:
		Err(errors)
