private pure func declaration_skeleton_graph_find_module_name_kind(
	graph: DeclarationSkeletonGraph,
	module_scope: PreparedModuleScope,
	name: String,
	kind: DeclarationSkeletonKind,
) -> Option[DeclarationSkeleton]:
	representation = declaration_skeleton_graph_rep(graph)
	owned_module ?= bound_module_graph_find_for_scope(representation.bound_graph, module_scope)
	module_id = prepared_module_scope_id(bound_module_scope(owned_module))
	var result: Option[DeclarationSkeleton] = None
	var index = representation.latest_skeleton_index_by_name.get_or(name, -1)

	while index >= 0 and result.is_none():
		match (
			representation.skeletons.get(index),
			representation.module_ids_by_skeleton.get(index),
		):
			(Some(skeleton), Some(skeleton_module_id)):
				if (
					module_ids_equal(skeleton_module_id, module_id)
					and declaration_skeleton_kind(skeleton) == kind
				):
					result = Some(skeleton)
					break
			_:
				void

		index = representation.previous_same_name_index_by_skeleton.get_or(index, -1)

	result


pure func declaration_skeleton_graph_find_type(
	graph: DeclarationSkeletonGraph,
	module_scope: PreparedModuleScope,
	name: String,
) -> Option[TypeDeclarationSkeletonInfo]:
	match declaration_skeleton_graph_find_module_name_kind(
		graph,
		module_scope,
		name,
		TypeSkeletonKind,
	):
		Some(TypeDeclarationSkeleton(id, visibility, source)):
			Some({
				id = id,
				visibility = visibility,
				source = source,
			})
		_:
			None


pure func declaration_skeleton_graph_find_trait(
	graph: DeclarationSkeletonGraph,
	module_scope: PreparedModuleScope,
	name: String,
) -> Option[TraitDeclarationSkeletonInfo]:
	match declaration_skeleton_graph_find_module_name_kind(
		graph,
		module_scope,
		name,
		TraitSkeletonKind,
	):
		Some(TraitDeclarationSkeleton(id, visibility, source)):
			Some({
				id = id,
				visibility = visibility,
				source = source,
			})
		_:
			None


pure func declaration_skeleton_graph_error_message(error: DeclarationSkeletonGraphError) -> String:
	match error:
		CallableSkeletonMissingDefinition(module_path, name, _):
			"declaration skeleton is missing callable definition '" + name + "' in module '" + module_path + "'"
		ConstructorSkeletonMissingDefinition(module_path, owner, name, _):
			"declaration skeleton is missing constructor definition '" + owner + "." + name + "' in module '" + module_path + "'"
		TraitSkeletonMissingDefinition(module_path, name, _):
			"declaration skeleton is missing trait definition '" + name + "' in module '" + module_path + "'"
		ImplementationSkeletonMissingDefinition(module_path, name, _):
			"declaration skeleton is missing implementation definition for '" + name + "' in module '" + module_path + "'"
		DuplicateTypeDeclaration(module_path, name, _):
			"duplicate type declaration '" + name + "' in module '" + module_path + "'"
		DuplicateTraitDeclaration(module_path, name, _):
			"duplicate trait declaration '" + name + "' in module '" + module_path + "'"
		DuplicateConstructorDeclaration(module_path, parent_type_id, name, _):
			"duplicate constructor '" + name + "' in union '" + type_id_name(
				parent_type_id,
			) + "' in module '" + module_path + "'"
		DuplicateDeclarationSkeleton(_):
			"duplicate declaration skeleton identity"
