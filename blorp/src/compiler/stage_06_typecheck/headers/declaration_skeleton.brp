enum DeclarationVisibility:
	PublicDeclaration
	PrivateDeclaration


enum DeclarationSkeletonKind:
	TypeSkeletonKind
	ConstructorSkeletonKind
	CallableSkeletonKind
	TraitSkeletonKind
	TraitMethodSkeletonKind
	GlobalSkeletonKind
	ImplementationSkeletonKind


opaque type GlobalId = DefinitionId

opaque type ConstructorId = Int

opaque type CallableId = DefinitionId

opaque type ImplId = DefinitionId

-- Graph trait IDs are their non-negative DefinitionId. Compiler builtins use
-- `-(registry_id + 1)`, keeping the domains explicit in one unboxed scalar.
-- A graph ID is meaningful only with the DefinitionTable that issued it;
-- graph products validate table compatibility before exchanging IDs.
opaque type TraitId = Int


private struct TraitMethodIdRep {
	owner: TraitId,
	index: Int
}


opaque type TraitMethodId = TraitMethodIdRep

private COMPILER_PRELUDE_TRAIT_DEFINITION_ID: Int = 0

private BUILTIN_TRAIT_ENCODING_OFFSET: Int = 1

private COMPILER_PRELUDE_SOURCE_SPAN: SourceSpan = {
	path = "<compiler-prelude>",
	module_name = "<compiler-prelude>",
	start_offset = 0,
	start_line = 1,
	start_column = 1,
	end_offset = 0,
	end_line = 1,
	end_column = 1
}


union DeclarationId:
	TypeDeclarationId(TypeId)
	ConstructorDeclarationId(ConstructorId)
	CallableDeclarationId(CallableId)
	TraitDeclarationId(TraitId)
	TraitMethodDeclarationId(TraitId, Int)
	GlobalDeclarationId(GlobalId)
	ImplementationDeclarationId(ImplId)


union TypeDeclarationSource:
	RecordTypeSource(ParsedRecordDecl)
	UnionTypeSource(ParsedUnionDecl)
	BuiltinTypeSource(ParsedBuiltinTypeDecl)
	AliasTypeSource(ParsedTypeAliasDecl)


union CallableDeclarationSource:
	FunctionCallableSource(ParsedFunctionDecl)
	ForeignCallableSource(ParsedForeignFunctionDecl)
	ImplementationMethodCallableSource(ImplId, ParsedFunctionDecl)
	DefaultImplementationMethodCallableSource(ImplId, String, ParsedImplDecl)


union DeclarationSource:
	TypeDeclarationSourceValue(TypeDeclarationSource)
	ConstructorDeclarationSourceValue(TypeId, ParsedVariantDecl)
	CallableDeclarationSourceValue(CallableDeclarationSource)
	TraitDeclarationSourceValue(ParsedTraitDecl)
	TraitMethodDeclarationSourceValue(ParsedTraitMethodDecl)
	GlobalDeclarationSourceValue(ParsedVarDecl)
	ImplementationDeclarationSourceValue(ParsedImplDecl)


union DeclarationSkeleton:
	TypeDeclarationSkeleton(TypeId, DeclarationVisibility, TypeDeclarationSource)
	ConstructorDeclarationSkeleton(ConstructorId, DeclarationVisibility, TypeId, ParsedVariantDecl)
	CallableDeclarationSkeleton(CallableId, DeclarationVisibility, CallableDeclarationSource)
	TraitDeclarationSkeleton(TraitId, DeclarationVisibility, ParsedTraitDecl)
	TraitMethodDeclarationSkeleton(TraitId, Int, DeclarationVisibility, ParsedTraitMethodDecl)
	GlobalDeclarationSkeleton(GlobalId, DeclarationVisibility, ParsedVarDecl)
	ImplementationDeclarationSkeleton(ImplId, DeclarationVisibility, ParsedImplDecl)


record TypeDeclarationSkeletonInfo {
	id: TypeId,
	module_id: ModuleId,
	visibility: DeclarationVisibility,
	source: TypeDeclarationSource
}


record ConstructorDeclarationSkeletonInfo {
	id: ConstructorId,
	visibility: DeclarationVisibility,
	parent_type_id: TypeId,
	source: ParsedVariantDecl
}


record TraitDeclarationSkeletonInfo {
	id: TraitId,
	visibility: DeclarationVisibility,
	source: ParsedTraitDecl
}


record TraitMethodDeclarationSkeletonInfo {
	id: TraitMethodId,
	source: ParsedTraitMethodDecl
}


record CallableDeclarationSkeletonInfo {
	id: CallableId,
	visibility: DeclarationVisibility,
	source: CallableDeclarationSource
}


record GlobalDeclarationSkeletonInfo {
	id: GlobalId,
	visibility: DeclarationVisibility,
	source: ParsedVarDecl
}


record ImplementationDeclarationSkeletonInfo {
	id: ImplId,
	visibility: DeclarationVisibility,
	source: ParsedImplDecl
}


union DeclarationSkeletonGraphError:
	TypeSkeletonMissingDefinition(String, String, SourceSpan)
	CallableSkeletonMissingDefinition(String, String, SourceSpan)
	ConstructorSkeletonMissingDefinition(String, String, String, SourceSpan)
	GlobalSkeletonMissingDefinition(String, String, SourceSpan)
	TraitSkeletonMissingDefinition(String, String, SourceSpan)
	ImplementationSkeletonMissingDefinition(String, String, SourceSpan)
	DuplicateTypeDeclaration(String, String, SourceSpan)
	DuplicateTraitDeclaration(String, String, SourceSpan)
	DuplicateConstructorDeclaration(String, String, String, SourceSpan)
	DuplicateDeclarationSkeleton(DeclarationId)


-- Exact declaration identity includes source location. Namespace identity does
-- not: it describes the semantic slots whose occupants must be unique before
-- name-indexed header resolution can begin. Callable overloads deliberately do
-- not have a key here.
private union DeclarationNamespaceKey:
	TypeNamespaceKey(String)
	TraitNamespaceKey(String)
	ConstructorNamespaceKey(TypeId, String)


private record DeclarationSkeletonGraphRep {
	bound_graph: BoundModuleGraph,
	skeletons: List[DeclarationSkeleton],
	module_ids_by_skeleton: List[ModuleId],
	previous_same_name_index_by_skeleton: List[Int],
	latest_skeleton_index_by_name: Dict[String, Int]
}


opaque type DeclarationSkeletonGraph = DeclarationSkeletonGraphRep


-- The collection pass preserves source order without constructing a partially
-- valid graph. Validation consumes these items in order and is the only phase
-- that owns the graph indexes.
private union DeclarationSkeletonBuildItem:
	DeclarationSkeletonCandidate(DeclarationSkeleton)
	DeclarationSkeletonBuildError(DeclarationSkeletonGraphError)


private record DeclarationSkeletonBuildContext {
	module_id: ModuleId,
	module_path: String,
	module_table: ModuleTable,
	definition_index: DefinitionIndex
}


pure func type_declaration_source_name(source: TypeDeclarationSource) -> String:
	match source:
		RecordTypeSource(decl):
			decl.name.text
		UnionTypeSource(decl):
			decl.name.text
		BuiltinTypeSource(decl):
			decl.name.text
		AliasTypeSource(decl):
			decl.name.text


pure func type_declaration_source_span(source: TypeDeclarationSource) -> SourceSpan:
	match source:
		RecordTypeSource(decl):
			decl.span
		UnionTypeSource(decl):
			decl.span
		BuiltinTypeSource(decl):
			decl.span
		AliasTypeSource(decl):
			decl.span


pure func trait_method_ids_equal(left: TraitMethodId, right: TraitMethodId) -> Bool:
	left_rep = from_opaque TraitMethodId(left)
	right_rep = from_opaque TraitMethodId(right)

	trait_ids_equal(left_rep.owner, right_rep.owner) and left_rep.index == right_rep.index


private pure func declaration_ids_equal(left: DeclarationId, right: DeclarationId) -> Bool:
	match (left, right):
		(TypeDeclarationId(left_id), TypeDeclarationId(right_id)):
			type_ids_equal(left_id, right_id)
		(GlobalDeclarationId(left_id), GlobalDeclarationId(right_id)):
			global_ids_equal(left_id, right_id)
		(TraitMethodDeclarationId(left_owner, left_index), TraitMethodDeclarationId(right_owner, right_index)):
			trait_ids_equal(left_owner, right_owner) and left_index == right_index
		(ConstructorDeclarationId(left_id), ConstructorDeclarationId(right_id)):
			constructor_ids_equal(left_id, right_id)
		(CallableDeclarationId(left_id), CallableDeclarationId(right_id)):
			callable_ids_equal(left_id, right_id)
		(TraitDeclarationId(left_id), TraitDeclarationId(right_id)):
			trait_ids_equal(left_id, right_id)
		(ImplementationDeclarationId(left_id), ImplementationDeclarationId(right_id)):
			impl_ids_equal(left_id, right_id)
		_:
			False


pure func constructor_id_definition_id(id: ConstructorId) -> Int:
	from_opaque ConstructorId(id)


pure func constructor_id_from_definition_table(
	table: DefinitionTable,
	runtime_definition_id: Int,
) -> Option[ConstructorId]:
	definition_table_constructor_definition_id(
		table,
		runtime_definition_id,
	).map(
		func(_): into_opaque ConstructorId(runtime_definition_id),
	)


-- Reserved graph construction has already category-checked this ID while
-- building the canonical declaration skeleton. This conversion avoids
-- repeating the table probe during hot typed-call construction.
pure func constructor_id_from_reserved_graph_definition(
	runtime_definition_id: Int,
) -> ConstructorId:
	into_opaque ConstructorId(runtime_definition_id)


private pure func constructor_ids_equal(left: ConstructorId, right: ConstructorId) -> Bool:
	constructor_id_definition_id(left) == constructor_id_definition_id(right)


pure func constructor_id_module_id(table: DefinitionTable, id: ConstructorId) -> Option[ModuleId]:
	definition_table_constructor_row(
		table,
		constructor_id_definition_id(id),
	).map(
		func(row): row.module_id,
	)


pure func callable_ids_equal(left: CallableId, right: CallableId) -> Bool:
	definition_ids_equal(from_opaque CallableId(left), from_opaque CallableId(right))


pure func callable_id_from_definition_table(
	table: DefinitionTable,
	runtime_definition_id: Int,
) -> Option[CallableId]:
	definition_table_callable_definition_id(
		table,
		runtime_definition_id,
	).map(
		func(id): into_opaque CallableId(id),
	)


-- See constructor_id_from_reserved_graph_definition. This constructor is for
-- IDs issued by graph-owned callable authorities, never provisional/builtin
-- IDs from an extensible or graphless environment.
pure func callable_id_from_reserved_graph_definition(runtime_definition_id: Int) -> CallableId:
	into_opaque CallableId(definition_id_from_reserved_graph(runtime_definition_id))


pure func callable_id_name(table: DefinitionTable, id: CallableId) -> Option[String]:
	definition_table_callable_row(table, callable_id_definition_id(id)).map(func(row): row.name)


pure func callable_id_module_id(table: DefinitionTable, id: CallableId) -> Option[ModuleId]:
	definition_table_callable_row(
		table,
		callable_id_definition_id(id),
	).map(
		func(row): row.module_id,
	)


pure func callable_id_definition_id(id: CallableId) -> Int:
	definition_id_runtime_value(from_opaque CallableId(id))


pure func callable_id_source_span(table: DefinitionTable, id: CallableId) -> Option[SourceSpan]:
	definition_table_callable_row(table, callable_id_definition_id(id)).map(func(row): row.span)


pure func global_ids_equal(left: GlobalId, right: GlobalId) -> Bool:
	definition_ids_equal(from_opaque GlobalId(left), from_opaque GlobalId(right))


pure func global_id_from_definition_table(
	table: DefinitionTable,
	runtime_definition_id: Int,
) -> Option[GlobalId]:
	definition_table_global_definition_id(
		table,
		runtime_definition_id,
	).map(
		func(id): into_opaque GlobalId(id),
	)


pure func global_id_definition_id(id: GlobalId) -> Int:
	definition_id_runtime_value(from_opaque GlobalId(id))


pure func global_id_name(table: DefinitionTable, id: GlobalId) -> Option[String]:
	definition_table_global_row(table, global_id_definition_id(id)).map(func(row): row.name)


pure func global_id_module_id(table: DefinitionTable, id: GlobalId) -> Option[ModuleId]:
	definition_table_global_row(table, global_id_definition_id(id)).map(func(row): row.module_id)


pure func global_id_source_span(table: DefinitionTable, id: GlobalId) -> Option[SourceSpan]:
	definition_table_global_row(table, global_id_definition_id(id)).map(func(row): row.span)


pure func impl_ids_equal(left: ImplId, right: ImplId) -> Bool:
	definition_ids_equal(from_opaque ImplId(left), from_opaque ImplId(right))


pure func impl_id_from_definition_table(
	table: DefinitionTable,
	runtime_definition_id: Int,
) -> Option[ImplId]:
	definition_table_implementation_definition_id(
		table,
		runtime_definition_id,
	).map(
		func(id): into_opaque ImplId(id),
	)


pure func impl_id_module_id(table: DefinitionTable, id: ImplId) -> Option[ModuleId]:
	definition_table_implementation_row(
		table,
		impl_id_definition_id(id),
	).map(
		func(row): row.module_id,
	)


pure func impl_id_definition_id(id: ImplId) -> Int:
	definition_id_runtime_value(from_opaque ImplId(id))


pure func impl_id_name(table: DefinitionTable, id: ImplId) -> String:
	definition_table_implementation_row(table, impl_id_definition_id(id))
		.map(func(row): row.name)
		.get_or("<unknown implementation>")


pure func impl_id_source_span(table: DefinitionTable, id: ImplId) -> SourceSpan:
	definition_table_implementation_row(table, impl_id_definition_id(id))
		.map(func(row): row.span)
		.get_or(COMPILER_PRELUDE_SOURCE_SPAN)


pure func trait_ids_equal(left: TraitId, right: TraitId) -> Bool:
	from_opaque TraitId(left) == from_opaque TraitId(right)


pure func trait_id_from_definition_table(
	table: DefinitionTable,
	runtime_definition_id: Int,
) -> Option[TraitId]:
	definition_table_trait_definition_id(
		table,
		runtime_definition_id,
	).map(
		func(id): into_opaque TraitId(definition_id_runtime_value(id)),
	)


pure func trait_id_storage_key(id: TraitId) -> Int:
	from_opaque TraitId(id)


pure func builtin_trait_id_name(id: TraitId) -> Option[String]:
	raw = trait_id_storage_key(id)

	if raw < 0:
		builtin_trait_registry_id_from_value(
			0 - raw - BUILTIN_TRAIT_ENCODING_OFFSET,
		).and_then(builtin_trait_registry_name)
	else:
		None


-- Accepted targets may contain compiler-prelude traits or graph traits. Validate
-- either domain before a phase projects the opaque ID back to descriptive data.
pure func trait_id_is_valid(table: DefinitionTable, id: TraitId) -> Bool:
	raw = trait_id_storage_key(id)

	if raw < 0:
		builtin_trait_id_name(id).is_some()
	else:
		definition_table_trait_definition_id(table, raw).is_some()


pure func trait_id_name(table: DefinitionTable, id: TraitId) -> String:
	raw = trait_id_storage_key(id)

	if raw < 0:
		builtin_trait_id_name(id).get_or("<unknown builtin trait>")
	else:
		definition_table_trait_row(table, raw)
			.map(func(row): row.name)
			.get_or("<unknown trait>")


pure func trait_id_module_id(table: DefinitionTable, id: TraitId) -> Option[ModuleId]:
	raw = trait_id_storage_key(id)

	if raw < 0:
		None
	else:
		definition_table_trait_row(table, raw).map(func(row): row.module_id)


pure func trait_id_definition_id(id: TraitId) -> Int:
	raw = trait_id_storage_key(id)

	if raw < 0:
		COMPILER_PRELUDE_TRAIT_DEFINITION_ID
	else:
		raw


pure func trait_id_source_span(table: DefinitionTable, id: TraitId) -> SourceSpan:
	raw = trait_id_storage_key(id)

	if raw < 0:
		COMPILER_PRELUDE_SOURCE_SPAN
	else:
		definition_table_trait_row(table, raw)
			.map(func(row): row.span)
			.get_or(COMPILER_PRELUDE_SOURCE_SPAN)


pure func prelude_trait_id(name: String) -> Option[TraitId]:
	if builtin_trait_is_prelude(name):
		builtin_trait_id(name)
	else:
		None


pure func builtin_trait_id(name: String) -> Option[TraitId]:
	builtin_trait_registry_id(name).map(func(registry_id):
		into_opaque TraitId(
			0 - builtin_trait_registry_id_value(registry_id) - BUILTIN_TRAIT_ENCODING_OFFSET
		)
	)


pure func trait_id_is_compiler_builtin(id: TraitId) -> Bool:
	trait_id_storage_key(id) < 0


pure func trait_method_id_owner(id: TraitMethodId) -> TraitId:
	from_opaque TraitMethodId(id).owner


pure func trait_method_id_index(id: TraitMethodId) -> Int:
	from_opaque TraitMethodId(id).index


private pure func trait_method_id(owner: TraitId, index: Int) -> TraitMethodId:
	into_opaque TraitMethodId({
			owner = owner,
			index = index
		})


pure func declaration_skeleton_id(skeleton: DeclarationSkeleton) -> DeclarationId:
	match skeleton:
		TypeDeclarationSkeleton(id, _, _):
			TypeDeclarationId(id)
		ConstructorDeclarationSkeleton(id, _, _, _):
			ConstructorDeclarationId(id)
		CallableDeclarationSkeleton(id, _, _):
			CallableDeclarationId(id)
		TraitDeclarationSkeleton(id, _, _):
			TraitDeclarationId(id)
		TraitMethodDeclarationSkeleton(owner, index, _, _):
			TraitMethodDeclarationId(owner, index)
		GlobalDeclarationSkeleton(id, _, _):
			GlobalDeclarationId(id)
		ImplementationDeclarationSkeleton(id, _, _):
			ImplementationDeclarationId(id)


pure func declaration_skeleton_kind(skeleton: DeclarationSkeleton) -> DeclarationSkeletonKind:
	match skeleton:
		TypeDeclarationSkeleton(_, _, _):
			TypeSkeletonKind
		ConstructorDeclarationSkeleton(_, _, _, _):
			ConstructorSkeletonKind
		CallableDeclarationSkeleton(_, _, _):
			CallableSkeletonKind
		TraitDeclarationSkeleton(_, _, _):
			TraitSkeletonKind
		TraitMethodDeclarationSkeleton(_, _, _, _):
			TraitMethodSkeletonKind
		GlobalDeclarationSkeleton(_, _, _):
			GlobalSkeletonKind
		ImplementationDeclarationSkeleton(_, _, _):
			ImplementationSkeletonKind


pure func declaration_skeleton_name(skeleton: DeclarationSkeleton) -> String:
	match skeleton:
		TypeDeclarationSkeleton(_, _, source):
			type_declaration_source_name(source)
		ConstructorDeclarationSkeleton(_, _, _, source):
			source.name.text
		CallableDeclarationSkeleton(_, _, source):
			match source:
				FunctionCallableSource(decl):
					decl.name.text
				ForeignCallableSource(decl):
					decl.name.text
				ImplementationMethodCallableSource(_, decl):
					decl.name.text
				DefaultImplementationMethodCallableSource(_, method_name, _):
					method_name
		TraitDeclarationSkeleton(_, _, source):
			source.name.text
		TraitMethodDeclarationSkeleton(_, _, _, source):
			source.name.text
		GlobalDeclarationSkeleton(_, _, source):
			source.name.text
		ImplementationDeclarationSkeleton(_, _, source):
			source.trait_name.text


pure func declaration_skeleton_visibility(skeleton: DeclarationSkeleton) -> DeclarationVisibility:
	match skeleton:
		TypeDeclarationSkeleton(_, visibility, _):
			visibility
		ConstructorDeclarationSkeleton(_, visibility, _, _):
			visibility
		CallableDeclarationSkeleton(_, visibility, _):
			visibility
		TraitDeclarationSkeleton(_, visibility, _):
			visibility
		TraitMethodDeclarationSkeleton(_, _, visibility, _):
			visibility
		GlobalDeclarationSkeleton(_, visibility, _):
			visibility
		ImplementationDeclarationSkeleton(_, visibility, _):
			visibility


pure func declaration_skeleton_source(skeleton: DeclarationSkeleton) -> DeclarationSource:
	match skeleton:
		TypeDeclarationSkeleton(_, _, source):
			TypeDeclarationSourceValue(source)
		ConstructorDeclarationSkeleton(_, _, parent_type_id, source):
			ConstructorDeclarationSourceValue(parent_type_id, source)
		CallableDeclarationSkeleton(_, _, source):
			CallableDeclarationSourceValue(source)
		TraitDeclarationSkeleton(_, _, source):
			TraitDeclarationSourceValue(source)
		TraitMethodDeclarationSkeleton(_, _, _, source):
			TraitMethodDeclarationSourceValue(source)
		GlobalDeclarationSkeleton(_, _, source):
			GlobalDeclarationSourceValue(source)
		ImplementationDeclarationSkeleton(_, _, source):
			ImplementationDeclarationSourceValue(source)


private pure func declaration_namespace_key(
	skeleton: DeclarationSkeleton,
) -> Option[DeclarationNamespaceKey]:
	match skeleton:
		TypeDeclarationSkeleton(_, _, source):
			Some(TypeNamespaceKey(type_declaration_source_name(source)))
		TraitDeclarationSkeleton(_, _, source):
			Some(TraitNamespaceKey(source.name.text))
		ConstructorDeclarationSkeleton(_, _, parent_type_id, source):
			Some(ConstructorNamespaceKey(parent_type_id, source.name.text))
		_:
			None


private pure func declaration_namespace_keys_equal(
	left: DeclarationNamespaceKey,
	right: DeclarationNamespaceKey,
) -> Bool:
	match (left, right):
		(TypeNamespaceKey(left_name), TypeNamespaceKey(right_name)):
			left_name == right_name
		(TraitNamespaceKey(left_name), TraitNamespaceKey(right_name)):
			left_name == right_name
		(ConstructorNamespaceKey(left_parent, left_name), ConstructorNamespaceKey(right_parent, right_name)):
			left_name == right_name and type_ids_equal(left_parent, right_parent)
		_:
			False


private pure func type_declaration_name_for_id(
	skeletons: List[DeclarationSkeleton],
	type_id: TypeId,
) -> Option[String]:
	var result: Option[String] = None
	var index: Int = 0

	while index < skeletons.length() and result.is_none():
		match skeletons.get(index):
			Some(TypeDeclarationSkeleton(id, _, source)):
				if type_ids_equal(id, type_id):
					result = Some(type_declaration_source_name(source))
			_:
				void

		index += 1

	result


private pure func duplicate_namespace_error(
	module_path: String,
	existing_skeletons: List[DeclarationSkeleton],
	skeleton: DeclarationSkeleton,
) -> DeclarationSkeletonGraphError:
	match skeleton:
		TypeDeclarationSkeleton(_, _, source):
			DuplicateTypeDeclaration(
				module_path,
				type_declaration_source_name(source),
				type_declaration_source_span(source),
			)
		TraitDeclarationSkeleton(_, _, source):
			DuplicateTraitDeclaration(module_path, source.name.text, source.span)
		ConstructorDeclarationSkeleton(_, _, parent_type_id, source):
			parent_name = type_declaration_name_for_id(existing_skeletons, parent_type_id)

			match parent_name:
				Some(name):
					DuplicateConstructorDeclaration(
						module_path,
						name,
						source.name.text,
						source.span,
					)
				None:
					DuplicateDeclarationSkeleton(declaration_skeleton_id(skeleton))
		_:
			DuplicateDeclarationSkeleton(declaration_skeleton_id(skeleton))


private pure func function_skeleton_build_items(
	context: DeclarationSkeletonBuildContext,
	visibility: DeclarationVisibility,
	function_decl: ParsedFunctionDecl,
	source: CallableDeclarationSource,
) -> List[DeclarationSkeletonBuildItem]:
	key = func_callable_key(context.module_id, function_decl.name.text, function_decl.span)

	match definition_index_find_func_callable(context.definition_index, context.module_table, key):
		None:
			[
				DeclarationSkeletonBuildError(
					CallableSkeletonMissingDefinition(
						context.module_path,
						function_decl.name.text,
						function_decl.span,
					),
				),
			]
		Some(definition_id):
			id = into_opaque CallableId(definition_id)
			[DeclarationSkeletonCandidate(CallableDeclarationSkeleton(id, visibility, source))]


private pure func foreign_function_skeleton_build_items(
	context: DeclarationSkeletonBuildContext,
	visibility: DeclarationVisibility,
	function_decl: ParsedForeignFunctionDecl,
) -> List[DeclarationSkeletonBuildItem]:
	key = func_callable_key(context.module_id, function_decl.name.text, function_decl.span)

	match definition_index_find_func_callable(context.definition_index, context.module_table, key):
		None:
			[
				DeclarationSkeletonBuildError(
					CallableSkeletonMissingDefinition(
						context.module_path,
						function_decl.name.text,
						function_decl.span,
					),
				),
			]
		Some(definition_id):
			id = into_opaque CallableId(definition_id)
			[
				DeclarationSkeletonCandidate(
					CallableDeclarationSkeleton(
						id,
						visibility,
						ForeignCallableSource(function_decl),
					),
				),
			]


private pure func union_skeleton_build_items_for_id(
	context: DeclarationSkeletonBuildContext,
	visibility: DeclarationVisibility,
	union_decl: ParsedUnionDecl,
	resolved_type_id: TypeId,
) -> List[DeclarationSkeletonBuildItem]:
	var items: List[DeclarationSkeletonBuildItem] = [
		DeclarationSkeletonCandidate(
			TypeDeclarationSkeleton(
				resolved_type_id,
				visibility,
				UnionTypeSource(union_decl),
			),
		),
	]

	for variant in union_decl.variants:
		key = source_definition_key(
			context.module_id,
			ConstructorDefinition,
			variant.name.text,
			Some(union_decl.name.text),
			variant.span,
		)

		match definition_index_find_constructor_definition(
			context.definition_index,
			context.module_table,
			key,
		):
			None:
				items = items.append(
					DeclarationSkeletonBuildError(
						ConstructorSkeletonMissingDefinition(
							context.module_path,
							union_decl.name.text,
							variant.name.text,
							variant.span,
						),
					),
				)
			Some(definition_id):
				id = into_opaque ConstructorId(definition_id_runtime_value(definition_id))
				items = items.append(
					DeclarationSkeletonCandidate(
						ConstructorDeclarationSkeleton(
							id,
							visibility,
							resolved_type_id,
							variant,
						),
					),
				)

	items


private pure func union_skeleton_build_items(
	context: DeclarationSkeletonBuildContext,
	visibility: DeclarationVisibility,
	union_decl: ParsedUnionDecl,
) -> List[DeclarationSkeletonBuildItem]:
	type_key = source_definition_key(
		context.module_id,
		TypeDefinition,
		union_decl.name.text,
		None,
		union_decl.span,
	)
	type_runtime_id = definition_index_find_source_definition_id(
		context.definition_index,
		context.module_table,
		type_key,
	)

	type_id = match type_runtime_id:
		Some(runtime_id):
			type_id_from_definition_table(
				definition_index_definition_table(context.definition_index),
				runtime_id,
			)
		None:
			None

	match type_id:
		Some(resolved_type_id):
			union_skeleton_build_items_for_id(context, visibility, union_decl, resolved_type_id)
		None:
			[
				DeclarationSkeletonBuildError(
					TypeSkeletonMissingDefinition(
						context.module_path,
						union_decl.name.text,
						union_decl.span,
					),
				),
			]


private pure func trait_skeleton_build_items(
	context: DeclarationSkeletonBuildContext,
	visibility: DeclarationVisibility,
	trait_decl: ParsedTraitDecl,
) -> List[DeclarationSkeletonBuildItem]:
	key = source_definition_key(
		context.module_id,
		TraitDefinition,
		trait_decl.name.text,
		None,
		trait_decl.span,
	)

	match definition_index_find_source_definition_id(
		context.definition_index,
		context.module_table,
		key,
	):
		None:
			[
				DeclarationSkeletonBuildError(
					TraitSkeletonMissingDefinition(
						context.module_path,
						trait_decl.name.text,
						trait_decl.span,
					),
				),
			]
		Some(definition_id):
			definition_table = definition_index_definition_table(context.definition_index)

			match trait_id_from_definition_table(definition_table, definition_id):
				None:
					[
						DeclarationSkeletonBuildError(
							TraitSkeletonMissingDefinition(
								context.module_path,
								trait_decl.name.text,
								trait_decl.span,
							),
						),
					]
				Some(trait_id):
					var items: List[DeclarationSkeletonBuildItem] = [
						DeclarationSkeletonCandidate(
							TraitDeclarationSkeleton(
								trait_id,
								visibility,
								trait_decl,
							),
						),
					]
					var method_index: Int = 0

					for method in trait_decl.methods:
						items = items.append(
							DeclarationSkeletonCandidate(
								TraitMethodDeclarationSkeleton(
									trait_id,
									method_index,
									visibility,
									method,
								),
							),
						)
						method_index += 1

					items


private pure func implementation_skeleton_build_items(
	context: DeclarationSkeletonBuildContext,
	visibility: DeclarationVisibility,
	impl_decl: ParsedImplDecl,
) -> List[DeclarationSkeletonBuildItem]:
	key = source_definition_key(
		context.module_id,
		ImplDefinition,
		impl_decl.trait_name.text,
		None,
		impl_decl.span,
	)

	match definition_index_find_source_definition_id(
		context.definition_index,
		context.module_table,
		key,
	):
		None:
			[
				DeclarationSkeletonBuildError(
					ImplementationSkeletonMissingDefinition(
						context.module_path,
						impl_decl.trait_name.text,
						impl_decl.span,
					),
				),
			]
		Some(definition_id):
			definition_table = definition_index_definition_table(context.definition_index)

			match impl_id_from_definition_table(definition_table, definition_id):
				None:
					[
						DeclarationSkeletonBuildError(
							ImplementationSkeletonMissingDefinition(
								context.module_path,
								impl_decl.trait_name.text,
								impl_decl.span,
							),
						),
					]
				Some(impl_id):
					var items: List[DeclarationSkeletonBuildItem] = [
						DeclarationSkeletonCandidate(
							ImplementationDeclarationSkeleton(
								impl_id,
								visibility,
								impl_decl,
							),
						),
					]

					for default_definition_id in definition_index_callable_definition_ids_at_span(
						context.definition_index,
						context.module_table,
						context.module_id,
						impl_decl.span,
					):
						match definition_table_row(definition_table, default_definition_id):
							Some(default_row):
								method_name = default_row.name
								default_id = into_opaque CallableId(default_definition_id)
								items = items.append(
									DeclarationSkeletonCandidate(
										CallableDeclarationSkeleton(
											default_id,
											visibility,
											DefaultImplementationMethodCallableSource(
												impl_id,
												method_name,
												impl_decl,
											),
										),
									),
								)
							None:
								void

					for method in impl_decl.methods:
						items = items.concat(
							function_skeleton_build_items(
								context,
								visibility,
								method,
								ImplementationMethodCallableSource(impl_id, method),
							),
						)

					items


private pure func type_skeleton_build_items(
	context: DeclarationSkeletonBuildContext,
	visibility: DeclarationVisibility,
	name: String,
	span: SourceSpan,
	source: TypeDeclarationSource,
) -> List[DeclarationSkeletonBuildItem]:
	key = source_definition_key(context.module_id, TypeDefinition, name, None, span)

	match definition_index_find_source_definition_id(
		context.definition_index,
		context.module_table,
		key,
	):
		None:
			[
				DeclarationSkeletonBuildError(
					TypeSkeletonMissingDefinition(
						context.module_path,
						name,
						span,
					),
				),
			]
		Some(runtime_id):
			match type_id_from_definition_table(
				definition_index_definition_table(context.definition_index),
				runtime_id,
			):
				Some(id):
					[DeclarationSkeletonCandidate(TypeDeclarationSkeleton(id, visibility, source))]
				None:
					[
						DeclarationSkeletonBuildError(
							TypeSkeletonMissingDefinition(
								context.module_path,
								name,
								span,
							),
						),
					]


private pure func declaration_skeleton_build_items(
	context: DeclarationSkeletonBuildContext,
	visibility: DeclarationVisibility,
	decl: ParsedDecl,
) -> List[DeclarationSkeletonBuildItem]:
	match decl:
		RecordParsedDecl(record_decl):
			type_skeleton_build_items(
				context,
				visibility,
				record_decl.name.text,
				record_decl.span,
				RecordTypeSource(record_decl),
			)
		UnionParsedDecl(union_decl):
			union_skeleton_build_items(context, visibility, union_decl)
		BuiltinTypeParsedDecl(type_decl):
			type_skeleton_build_items(
				context,
				visibility,
				type_decl.name.text,
				type_decl.span,
				BuiltinTypeSource(type_decl),
			)
		TypeAliasParsedDecl(alias_decl):
			type_skeleton_build_items(
				context,
				visibility,
				alias_decl.name.text,
				alias_decl.span,
				AliasTypeSource(alias_decl),
			)
		FunctionParsedDecl(function_decl):
			function_skeleton_build_items(
				context,
				visibility,
				function_decl,
				FunctionCallableSource(function_decl),
			)
		ForeignBlockParsedDecl(_, functions, _):
			var items: List[DeclarationSkeletonBuildItem] = []

			for function_decl in functions:
				function_visibility = if (
					visibility == PrivateDeclaration
					or function_decl.is_private
				):
					PrivateDeclaration
				else:
					PublicDeclaration

				items = items.concat(
					foreign_function_skeleton_build_items(
						context,
						function_visibility,
						function_decl,
					),
				)

			items
		VarParsedDecl(var_decl):
			key = source_definition_key(
				context.module_id,
				GlobalDefinition,
				var_decl.name.text,
				None,
				var_decl.span,
			)

			match definition_index_find_source_definition_id(
				context.definition_index,
				context.module_table,
				key,
			):
				Some(runtime_id):
					match global_id_from_definition_table(
						definition_index_definition_table(context.definition_index),
						runtime_id,
					):
						Some(id):
							[
								DeclarationSkeletonCandidate(
									GlobalDeclarationSkeleton(
										id,
										visibility,
										var_decl,
									),
								),
							]
						None:
							[
								DeclarationSkeletonBuildError(
									GlobalSkeletonMissingDefinition(
										context.module_path,
										var_decl.name.text,
										var_decl.span,
									),
								),
							]
				None:
					[
						DeclarationSkeletonBuildError(
							GlobalSkeletonMissingDefinition(
								context.module_path,
								var_decl.name.text,
								var_decl.span,
							),
						),
					]
		TraitParsedDecl(trait_decl):
			trait_skeleton_build_items(context, visibility, trait_decl)
		ImplParsedDecl(impl_decl):
			implementation_skeleton_build_items(context, visibility, impl_decl)
		PrivateParsedDecl(inner, _):
			declaration_skeleton_build_items(context, PrivateDeclaration, inner)
		ImportBlockParsedDecl(_, _):
			[]
		ParsedErrorDecl(_):
			[]


private pure func module_skeleton_build_items(
	bound_graph: BoundModuleGraph,
	definition_index: DefinitionIndex,
	module: BoundModule,
) -> List[DeclarationSkeletonBuildItem]:
	program = bound_module_program(module)

	-- Parser recovery nodes preserve enough shape for diagnostics and tooling,
	-- but they are not valid semantic declarations. Excluding the whole invalid
	-- module here prevents later header phases from manufacturing secondary
	-- type errors from a syntax-recovery AST while independent modules continue.
	if parsed_program_has_errors(program):
		[]
	else:
		indexed_graph = bound_module_graph_indexed_graph(bound_graph)
		context: DeclarationSkeletonBuildContext = {
			module_id = prepared_module_scope_id(bound_module_scope(module)),
			module_path = bound_module_canonical_path(module),
			module_table = indexed_graph_module_table(indexed_graph),
			definition_index = definition_index
		}
		program.decls.flat_map(func(decl):
			declaration_skeleton_build_items(context, PublicDeclaration, decl)
		)


private pure func validate_skeleton_build_items(
	bound_graph: BoundModuleGraph,
	definition_index: DefinitionIndex,
) -> Result[DeclarationSkeletonGraph, List[DeclarationSkeletonGraphError]]:
	var skeletons: List[DeclarationSkeleton] = []
	var module_ids_by_skeleton: List[ModuleId] = []
	var previous_same_name_index_by_skeleton: List[Int] = []
	var latest_skeleton_index_by_name: Dict[String, Int] = {}
	var errors: List[DeclarationSkeletonGraphError] = []
	target = bound_module_graph_target(bound_graph)
	modules = bound_module_graph_modules(bound_graph)
	var module_position: Int = -1

	while module_position < modules.length():
		module = if module_position < 0:
			target
		else:
			modules.get_or(module_position, target)

		module_id = prepared_module_scope_id(bound_module_scope(module))

		for item in module_skeleton_build_items(bound_graph, definition_index, module):
			match item:
				DeclarationSkeletonBuildError(error):
					errors = errors.append(error)
				DeclarationSkeletonCandidate(skeleton):
					id = declaration_skeleton_id(skeleton)
					name = declaration_skeleton_name(skeleton)
					namespace_key = declaration_namespace_key(skeleton)
					var exact_duplicate: Bool = False
					var namespace_duplicate: Bool = False
					var existing_index = latest_skeleton_index_by_name.get_or(name, -1)

					while existing_index >= 0 and not (exact_duplicate or namespace_duplicate):
						match (
							skeletons.get(existing_index),
							module_ids_by_skeleton.get(existing_index),
						):
							(Some(existing), Some(existing_module_id)):
								if module_ids_equal(existing_module_id, module_id):
									exact_duplicate = declaration_ids_equal(
										declaration_skeleton_id(existing),
										id,
									)

									match (namespace_key, declaration_namespace_key(existing)):
										(Some(key), Some(existing_key)):
											namespace_duplicate = declaration_namespace_keys_equal(
												existing_key,
												key,
											)
										_:
											void
							_:
								void

						existing_index = previous_same_name_index_by_skeleton.get_or(
							existing_index,
							-1,
						)

					if namespace_duplicate:
						errors = errors.append(
							duplicate_namespace_error(
								bound_module_canonical_path(module),
								skeletons,
								skeleton,
							),
						)
					else if exact_duplicate:
						errors = errors.append(DuplicateDeclarationSkeleton(id))
					else:
						skeleton_index = skeletons.length()
						skeletons = skeletons.append(skeleton)
						module_ids_by_skeleton = module_ids_by_skeleton.append(module_id)
						previous_same_name_index_by_skeleton = previous_same_name_index_by_skeleton.append(
							latest_skeleton_index_by_name.get_or(
								name,
								-1,
							),
						)

						latest_skeleton_index_by_name = latest_skeleton_index_by_name.set(
							name,
							skeleton_index,
						)

		module_position += 1

	if errors.length() > 0:
		Err(errors)
	else:
		representation: DeclarationSkeletonGraphRep = {
			bound_graph = bound_graph,
			skeletons = skeletons,
			module_ids_by_skeleton = module_ids_by_skeleton,
			previous_same_name_index_by_skeleton = previous_same_name_index_by_skeleton,
			latest_skeleton_index_by_name = latest_skeleton_index_by_name
		}
		Ok(into_opaque DeclarationSkeletonGraph(representation))


pure func declaration_skeleton_graph_build(
	bound_graph: BoundModuleGraph,
) -> Result[DeclarationSkeletonGraph, List[DeclarationSkeletonGraphError]]:
	definition_index = indexed_graph_definition_index(bound_module_graph_indexed_graph(bound_graph))
	validate_skeleton_build_items(bound_graph, definition_index)


private pure func declaration_skeleton_graph_rep(
	graph: DeclarationSkeletonGraph,
) -> DeclarationSkeletonGraphRep:
	from_opaque DeclarationSkeletonGraph(graph)


pure func declaration_skeleton_graph_bound_graph(
	graph: DeclarationSkeletonGraph,
) -> BoundModuleGraph:
	declaration_skeleton_graph_rep(graph).bound_graph


pure func declaration_skeleton_graph_definition_table(
	graph: DeclarationSkeletonGraph,
) -> DefinitionTable:
	definition_index_definition_table(
		indexed_graph_definition_index(
			bound_module_graph_indexed_graph(declaration_skeleton_graph_bound_graph(graph)),
		),
	)


pure func declaration_skeleton_graph_skeletons(
	graph: DeclarationSkeletonGraph,
) -> List[DeclarationSkeleton]:
	declaration_skeleton_graph_rep(graph).skeletons


pure func declaration_skeleton_graph_type_skeletons(
	graph: DeclarationSkeletonGraph,
) -> List[TypeDeclarationSkeletonInfo]:
	representation = declaration_skeleton_graph_rep(graph)
	var type_skeletons: List[TypeDeclarationSkeletonInfo] = []

	for indexed in representation.skeletons.enumerate():
		skeleton_index = indexed[0]
		skeleton = indexed[1]

		match skeleton:
			TypeDeclarationSkeleton(id, visibility, source):
				match representation.module_ids_by_skeleton.get(skeleton_index):
					Some(module_id):
						type_skeletons = type_skeletons.append({
							id = id,
							module_id = module_id,
							visibility = visibility,
							source = source,
						})
					None:
						void
			_:
				void

	type_skeletons


pure func declaration_skeleton_graph_find_constructor(
	graph: DeclarationSkeletonGraph,
	parent_type_id: TypeId,
	name: String,
	span: SourceSpan,
) -> Option[ConstructorDeclarationSkeletonInfo]:
	representation = declaration_skeleton_graph_rep(graph)
	var index = representation.latest_skeleton_index_by_name.get_or(name, -1)
	var result: Option[ConstructorDeclarationSkeletonInfo] = None
	var index_is_consistent: Bool = True

	while (
		index >= 0
		and result.is_none()
		and index_is_consistent
	):
		match representation.skeletons.get(index):
			Some(ConstructorDeclarationSkeleton(id, visibility, parent, source)):
				if (
					source.name.text == name
					and type_ids_equal(parent, parent_type_id)
					and source_spans_equal(source.span, span)
				):
					result = Some({
						id = id,
						visibility = visibility,
						parent_type_id = parent,
						source = source,
					})
			Some(_):
				void
			None:
				index_is_consistent = False

		if result.is_none() and index_is_consistent:
			match representation.previous_same_name_index_by_skeleton.get(index):
				Some(previous_index):
					index = previous_index
				None:
					index_is_consistent = False

	if index_is_consistent:
		result
	else:
		None


-- Test and benchmark work observation over the same name-chain index. The
-- production query above remains allocation-free beyond its returned payload.
pure func declaration_skeleton_graph_constructor_lookup_candidate_count(
	graph: DeclarationSkeletonGraph,
	parent_type_id: TypeId,
	name: String,
	span: SourceSpan,
) -> Int:
	representation = declaration_skeleton_graph_rep(graph)
	var index = representation.latest_skeleton_index_by_name.get_or(name, -1)
	var candidates_visited: Int = 0
	var index_is_consistent: Bool = True
	var found: Bool = False

	while (
		index >= 0
		and not found
		and index_is_consistent
	):
		match representation.skeletons.get(index):
			Some(ConstructorDeclarationSkeleton(_, _, parent, source)):
				candidates_visited += 1
				found = (
					source.name.text == name
					and type_ids_equal(parent, parent_type_id)
					and source_spans_equal(source.span, span)
				)
			Some(_):
				candidates_visited += 1
			None:
				index_is_consistent = False

		if not found and index_is_consistent:
			match representation.previous_same_name_index_by_skeleton.get(index):
				Some(previous_index):
					index = previous_index
				None:
					index_is_consistent = False

	if index_is_consistent:
		candidates_visited
	else:
		0


pure func declaration_skeleton_graph_trait_skeletons(
	graph: DeclarationSkeletonGraph,
) -> List[TraitDeclarationSkeletonInfo]:
	var trait_skeletons: List[TraitDeclarationSkeletonInfo] = []

	for skeleton in declaration_skeleton_graph_rep(graph).skeletons:
		match skeleton:
			TraitDeclarationSkeleton(id, visibility, source):
				trait_skeletons = trait_skeletons.append({
					id = id,
					visibility = visibility,
					source = source,
				})
			_:
				void

	trait_skeletons


pure func declaration_skeleton_graph_trait_method_skeletons(
	graph: DeclarationSkeletonGraph,
) -> List[TraitMethodDeclarationSkeletonInfo]:
	var method_skeletons: List[TraitMethodDeclarationSkeletonInfo] = []

	for skeleton in declaration_skeleton_graph_rep(graph).skeletons:
		match skeleton:
			TraitMethodDeclarationSkeleton(owner, index, _, source):
				method_skeletons = method_skeletons.append({
					id = trait_method_id(owner, index),
					source = source,
				})
			_:
				void

	method_skeletons


pure func declaration_skeleton_graph_callable_skeletons(
	graph: DeclarationSkeletonGraph,
) -> List[CallableDeclarationSkeletonInfo]:
	var callable_skeletons: List[CallableDeclarationSkeletonInfo] = []

	for skeleton in declaration_skeleton_graph_rep(graph).skeletons:
		match skeleton:
			CallableDeclarationSkeleton(id, visibility, source):
				callable_skeletons = callable_skeletons.append({
					id = id,
					visibility = visibility,
					source = source,
				})
			_:
				void

	callable_skeletons


pure func declaration_skeleton_graph_global_skeletons(
	graph: DeclarationSkeletonGraph,
) -> List[GlobalDeclarationSkeletonInfo]:
	var global_skeletons: List[GlobalDeclarationSkeletonInfo] = []

	for skeleton in declaration_skeleton_graph_rep(graph).skeletons:
		match skeleton:
			GlobalDeclarationSkeleton(id, visibility, source):
				global_skeletons = global_skeletons.append({
					id = id,
					visibility = visibility,
					source = source,
				})
			_:
				void

	global_skeletons


pure func declaration_skeleton_graph_implementation_skeletons(
	graph: DeclarationSkeletonGraph,
) -> List[ImplementationDeclarationSkeletonInfo]:
	var implementation_skeletons: List[ImplementationDeclarationSkeletonInfo] = []

	for skeleton in declaration_skeleton_graph_rep(graph).skeletons:
		match skeleton:
			ImplementationDeclarationSkeleton(id, visibility, source):
				implementation_skeletons = implementation_skeletons.append({
					id = id,
					visibility = visibility,
					source = source,
				})
			_:
				void

	implementation_skeletons


private pure func declaration_skeleton_graph_find_module_name_kind(
	graph: DeclarationSkeletonGraph,
	module_scope: PreparedModuleScope,
	name: String,
	kind: DeclarationSkeletonKind,
) -> Option[DeclarationSkeleton]:
	representation = declaration_skeleton_graph_rep(graph)
	owned_module ?= bound_module_graph_find_for_scope(representation.bound_graph, module_scope)
	module_id = prepared_module_scope_id(bound_module_scope(owned_module))
	var result: Option[DeclarationSkeleton] = None
	var index = representation.latest_skeleton_index_by_name.get_or(name, -1)

	while index >= 0 and result.is_none():
		match (
			representation.skeletons.get(index),
			representation.module_ids_by_skeleton.get(index),
		):
			(Some(skeleton), Some(skeleton_module_id)):
				if (
					module_ids_equal(skeleton_module_id, module_id)
					and declaration_skeleton_kind(skeleton) == kind
				):
					result = Some(skeleton)
					break
			_:
				void

		index = representation.previous_same_name_index_by_skeleton.get_or(index, -1)

	result


pure func declaration_skeleton_graph_find_type(
	graph: DeclarationSkeletonGraph,
	module_scope: PreparedModuleScope,
	name: String,
) -> Option[TypeDeclarationSkeletonInfo]:
	match declaration_skeleton_graph_find_module_name_kind(
		graph,
		module_scope,
		name,
		TypeSkeletonKind,
	):
		Some(TypeDeclarationSkeleton(id, visibility, source)):
			Some({
				id = id,
				module_id = prepared_module_scope_id(module_scope),
				visibility = visibility,
				source = source,
			})
		_:
			None


pure func declaration_skeleton_graph_find_trait(
	graph: DeclarationSkeletonGraph,
	module_scope: PreparedModuleScope,
	name: String,
) -> Option[TraitDeclarationSkeletonInfo]:
	match declaration_skeleton_graph_find_module_name_kind(
		graph,
		module_scope,
		name,
		TraitSkeletonKind,
	):
		Some(TraitDeclarationSkeleton(id, visibility, source)):
			Some({
				id = id,
				visibility = visibility,
				source = source,
			})
		_:
			None


pure func declaration_skeleton_graph_error_message(error: DeclarationSkeletonGraphError) -> String:
	match error:
		TypeSkeletonMissingDefinition(module_path, name, _):
			"declaration skeleton is missing type definition '" + name + "' in module '" + module_path + "'"
		CallableSkeletonMissingDefinition(module_path, name, _):
			"declaration skeleton is missing callable definition '" + name + "' in module '" + module_path + "'"
		ConstructorSkeletonMissingDefinition(module_path, owner, name, _):
			"declaration skeleton is missing constructor definition '" + owner + "." + name + "' in module '" + module_path + "'"
		GlobalSkeletonMissingDefinition(module_path, name, _):
			"declaration skeleton is missing global definition '" + name + "' in module '" + module_path + "'"
		TraitSkeletonMissingDefinition(module_path, name, _):
			"declaration skeleton is missing trait definition '" + name + "' in module '" + module_path + "'"
		ImplementationSkeletonMissingDefinition(module_path, name, _):
			"declaration skeleton is missing implementation definition for '" + name + "' in module '" + module_path + "'"
		DuplicateTypeDeclaration(module_path, name, _):
			"duplicate type declaration '" + name + "' in module '" + module_path + "'"
		DuplicateTraitDeclaration(module_path, name, _):
			"duplicate trait declaration '" + name + "' in module '" + module_path + "'"
		DuplicateConstructorDeclaration(module_path, parent_name, name, _):
			"duplicate constructor '" + name + "' in union '" + parent_name + "' in module '" + module_path + "'"
		DuplicateDeclarationSkeleton(_):
			"duplicate declaration skeleton identity"
