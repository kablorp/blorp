-- Checked, compact declaration catalog projected from accepted graph products.
--
-- Issue 36 keeps this product out of production graph state while making its
-- inputs independent of accepted-graph assembly. Completed globals cross this
-- boundary as a catalog-owned semantic projection, not as decl-owned bodies.
-- The implementation graph derives the callable, trait, and type graphs
-- through the existing ownership chain:
--
--   ImplementationHeaderGraph
--     -> CallableHeaderGraph
--     -> TraitTopologyGraph
--     -> TypeHeaderGraph
--
-- Construction does not rely on source spellings as declaration authority.
import:
	../graph/indexed_graph:
		indexed_graph_module_count,
		prepared_module_id_table_index,
		prepared_module_scope_id,
	../graph/type_identity: TypeId, type_id_module_id, type_id_name, type_ids_equal
	../modules/bound_module_graph:
		BoundModuleGraph,
		bound_module_graph_find,
		bound_module_graph_find_for_id,
		bound_module_graph_indexed_graph,
		bound_module_graph_target,
		bound_module_scope,
	../modules/module_binding: ImportableModuleGraph, importable_module_graph_matches_scope
	../type_system/semantic_type: SemanticType
	callable_headers:
		CallableBodyCategory,
		CallableHeader,
		CallableHeaderCategory,
		CallableHeaderGraph,
		ResolvedCallableTypeParameter,
		callable_header_body_category,
		callable_header_category,
		callable_header_dimension_constraints,
		callable_header_graph_callables,
		callable_header_graph_trait_topology,
		callable_header_id,
		callable_header_parameters,
		callable_header_signature,
		callable_header_visibility,
	callable_signature: CallableSignature
	declaration_skeleton:
		CallableId,
		ConstructorId,
		DeclarationSkeleton(
			ConstructorDeclarationSkeleton,
			GlobalDeclarationSkeleton,
			TypeDeclarationSkeleton,
		),
		DeclarationSkeletonGraph,
		DeclarationVisibility(PublicDeclaration),
		GlobalId,
		ImplId,
		TraitId,
		TraitMethodId,
		callable_id_definition_id,
		callable_ids_equal,
		constructor_id_definition_id,
		constructor_id_module_identity,
		constructor_ids_equal,
		declaration_skeleton_graph_bound_graph,
		declaration_skeleton_graph_skeletons,
		global_id_module_identity,
		global_id_name,
		global_ids_equal,
		impl_id_definition_id,
		impl_ids_equal,
		trait_id_definition_id,
		trait_ids_equal,
		trait_method_id_index,
		trait_method_id_owner,
		trait_method_ids_equal,
	implementation_headers:
		ImplementationHeader,
		ImplementationHeaderGraph,
		ImplementationMethodHeader(
			DefaultImplementationMethodHeaderValue,
			ExplicitImplementationMethodHeaderValue,
		),
		ImplementationReceiverHeadCategory,
		ResolvedImplementationMethodTypeParameter,
		ResolvedImplementationTypeParameter,
		default_implementation_method_signature,
		explicit_implementation_method_dimension_constraints,
		explicit_implementation_method_parameters,
		explicit_implementation_method_signature,
		implementation_header_graph_callable_headers,
		implementation_header_graph_headers,
		implementation_header_id,
		implementation_header_methods,
		implementation_header_parameters,
		implementation_header_receiver,
		implementation_header_receiver_head,
		implementation_header_trait_id,
		implementation_header_visibility,
		implementation_method_header_id,
	trait_headers:
		ResolvedTraitTypeParameter,
		TraitMethodCategory,
		TraitMethodSlot,
		TraitTopologyGraph,
		trait_method_slot_category,
		trait_method_slot_id,
		trait_method_slot_signature,
		trait_topology_graph_headers,
		trait_topology_graph_type_headers,
		trait_topology_header_id,
		trait_topology_header_methods,
		trait_topology_header_parameters,
		trait_topology_header_supertraits,
		trait_topology_header_visibility,
	type_header_graph:
		ResolvedTypeShape,
		TypeContainmentFacts,
		TypeHeaderGraph,
		TypeHeaderShape(UnionTypeHeader),
		TypeHeaderVariant,
		type_header_graph_bound_graph,
		type_header_graph_declaration_graph,
		type_header_graph_headers,
	type_parameter_headers: ResolvedTypeParameter


enum DeclarationCatalogCategory:
	CatalogTypeDeclaration
	CatalogConstructorDeclaration
	CatalogCallableDeclaration
	CatalogGlobalDeclaration
	CatalogTraitDeclaration
	CatalogTraitMethodDeclaration
	CatalogImplementationDeclaration
	CatalogImplementationMethodDeclaration


record AcceptedCatalogTypeEntry {
	id: TypeId,
	parameters: List[ResolvedTypeParameter],
	shape: TypeHeaderShape,
	visibility: DeclarationVisibility,
	containment: TypeContainmentFacts
}


record AcceptedCatalogConstructorEntry {
	id: ConstructorId,
	owner_type: TypeId,
	variant: TypeHeaderVariant,
	visibility: DeclarationVisibility
}


record AcceptedCatalogCallableEntry {
	id: CallableId,
	parameters: List[ResolvedCallableTypeParameter],
	signature: CallableSignature,
	visibility: DeclarationVisibility,
	category: CallableHeaderCategory,
	body_category: CallableBodyCategory,
	dimension_constraints: List[(ResolvedTypeShape, ResolvedTypeShape)]
}


record AcceptedCatalogGlobalEntry {
	id: GlobalId,
	canonical_type: SemanticType,
	visibility: DeclarationVisibility,
	global_dependencies: List[GlobalId],
	callable_dependencies: List[CallableId]
}


-- This is the only completed-global shape understood by catalog construction.
-- Body-bearing completion details remain owned by decl.brp and are projected
-- at the graph-assembly boundary.
record AcceptedDeclarationCatalogGlobalInput {
	id: GlobalId,
	canonical_type: SemanticType,
	visibility: DeclarationVisibility,
	global_dependencies: List[GlobalId],
	callable_dependencies: List[CallableId]
}


record AcceptedDeclarationCatalogInput {
	implementation_headers: ImplementationHeaderGraph,
	importable_graph: ImportableModuleGraph,
	completed_globals: List[AcceptedDeclarationCatalogGlobalInput]
}


record AcceptedCatalogTraitEntry {
	id: TraitId,
	parameters: List[ResolvedTraitTypeParameter],
	supertraits: List[TraitId],
	visibility: DeclarationVisibility
}


record AcceptedCatalogTraitMethodEntry {
	id: TraitMethodId,
	owner_trait: TraitId,
	category: TraitMethodCategory,
	signature: CallableSignature
}


record AcceptedCatalogImplementationEntry {
	id: ImplId,
	trait_id: TraitId,
	parameters: List[ResolvedImplementationTypeParameter],
	receiver: ResolvedTypeShape,
	receiver_head: ImplementationReceiverHeadCategory,
	visibility: DeclarationVisibility
}


enum AcceptedCatalogImplementationMethodCategory:
	ExplicitCatalogImplementationMethod
	DefaultCatalogImplementationMethod


record AcceptedCatalogImplementationMethodEntry {
	owner: ImplId,
	id: CallableId,
	category: AcceptedCatalogImplementationMethodCategory,
	parameters: List[ResolvedImplementationMethodTypeParameter],
	signature: CallableSignature,
	dimension_constraints: List[(ResolvedTypeShape, ResolvedTypeShape)]
}


struct AcceptedDeclarationCatalogMetrics {
	type_entries: Int,
	constructor_entries: Int,
	callable_entries: Int,
	global_entries: Int,
	trait_entries: Int,
	trait_method_entries: Int,
	implementation_entries: Int,
	implementation_method_entries: Int,
	total_entries: Int,
	builder_visits: Int,
	duplicate_checks: Int,
	checksum: Int
}


union DeclarationCatalogError:
	DeclarationCatalogProductProvenanceMismatch
	DeclarationCatalogDuplicateConstructorIdentity(ConstructorId)
	DeclarationCatalogDuplicateCallableIdentity(CallableId)
	DeclarationCatalogDuplicateTraitIdentity(TraitId)
	DeclarationCatalogDuplicateTraitMethodIdentity(TraitMethodId)
	DeclarationCatalogDuplicateImplementationIdentity(ImplId)
	DeclarationCatalogDuplicateImplementationMethodIdentity(ImplId, CallableId)
	DeclarationCatalogDuplicateTypeKey(TypeId)
	DeclarationCatalogDuplicateGlobalKey(GlobalId)
	DeclarationCatalogMissingTypeSkeleton(TypeId)
	DeclarationCatalogMissingConstructorSkeleton(ConstructorId)
	DeclarationCatalogImplementationMethodSignatureMissing(ImplId, CallableId)
	DeclarationCatalogRuntimeDefinitionIdCategoryReuse(Int, DeclarationCatalogCategory, DeclarationCatalogCategory)


private record AcceptedDeclarationCatalogRep {
	bound_graph: BoundModuleGraph,
	type_entries: List[AcceptedCatalogTypeEntry],
	type_index_by_module_and_name: List[Dict[String, Int]],
	constructor_entries: List[AcceptedCatalogConstructorEntry],
	constructor_index_by_definition_id: Dict[Int, Int],
	callable_entries: List[AcceptedCatalogCallableEntry],
	callable_index_by_definition_id: Dict[Int, Int],
	global_entries: List[AcceptedCatalogGlobalEntry],
	global_index_by_module_and_name: List[Dict[String, Int]],
	trait_entries: List[AcceptedCatalogTraitEntry],
	trait_index_by_definition_id: Dict[Int, Int],
	trait_method_entries: List[AcceptedCatalogTraitMethodEntry],
	trait_method_index_by_owner_and_slot: Dict[Int, Dict[Int, Int]],
	implementation_entries: List[AcceptedCatalogImplementationEntry],
	implementation_index_by_definition_id: Dict[Int, Int],
	implementation_method_entries: List[AcceptedCatalogImplementationMethodEntry],
	implementation_method_index_by_owner_and_callable: Dict[Int, Dict[Int, Int]],
	metrics: AcceptedDeclarationCatalogMetrics
}


opaque type AcceptedDeclarationCatalog = AcceptedDeclarationCatalogRep


private pure func declaration_catalog_rep(
	catalog: AcceptedDeclarationCatalog,
) -> AcceptedDeclarationCatalogRep:
	from_opaque AcceptedDeclarationCatalog(catalog)


private pure func checksum_step(current: Int, value: Int) -> Int:
	current * 33 + value + 17


private pure func declaration_catalog_type_module_index(
	bound_graph: BoundModuleGraph,
	id: TypeId,
) -> Option[Int]:
	module ?= bound_module_graph_find_for_id(bound_graph, type_id_module_id(id))
	Some(prepared_module_id_table_index(prepared_module_scope_id(bound_module_scope(module))))


private pure func declaration_catalog_constructor_module_index(
	bound_graph: BoundModuleGraph,
	id: ConstructorId,
) -> Option[Int]:
	module ?= bound_module_graph_find(bound_graph, constructor_id_module_identity(id))
	Some(prepared_module_id_table_index(prepared_module_scope_id(bound_module_scope(module))))


private pure func declaration_catalog_global_module_index(
	bound_graph: BoundModuleGraph,
	id: GlobalId,
) -> Option[Int]:
	module ?= bound_module_graph_find(bound_graph, global_id_module_identity(id))
	Some(prepared_module_id_table_index(prepared_module_scope_id(bound_module_scope(module))))


private pure func add_runtime_definition_category(
	categories_by_definition_id: Dict[Int, DeclarationCatalogCategory],
	definition_id: Int,
	category: DeclarationCatalogCategory,
	errors: List[DeclarationCatalogError],
) -> (Dict[Int, DeclarationCatalogCategory], List[DeclarationCatalogError]):
	match categories_by_definition_id.get(definition_id):
		None:
			(categories_by_definition_id.set(definition_id, category), errors)
		Some(existing):
			if existing == category:
				(categories_by_definition_id, errors)
			else:
				(
					categories_by_definition_id,
					errors.append(
						DeclarationCatalogRuntimeDefinitionIdCategoryReuse(
							definition_id,
							existing,
							category,
						),
					),
				)


private pure func add_single_name_index(
	index_by_module_and_name: List[Dict[String, Int]],
	module_index: Option[Int],
	name: String,
	index: Int,
) -> Result[List[Dict[String, Int]], Bool]:
	match module_index:
		None:
			Err(False)
		Some(module_index):
			names = index_by_module_and_name.get_or(module_index, {})

			if names.contains(name):
				Err(True)
			else:
				Ok(index_by_module_and_name.set(module_index, names.set(name, index)))


private pure func add_runtime_definition_index(
	index_by_definition_id: Dict[Int, Int],
	definition_id: Int,
	entry_index: Int,
) -> Result[Dict[Int, Int], Bool]:
	if index_by_definition_id.contains(definition_id):
		Err(True)
	else:
		Ok(index_by_definition_id.set(definition_id, entry_index))


private pure func runtime_definition_index(
	index_by_definition_id: Dict[Int, Int],
	definition_id: Int,
) -> Option[Int]:
	index_by_definition_id.get(definition_id)


private record DeclarationVisibilityIndexes {
	types: List[Dict[String, DeclarationVisibility]],
	constructors: List[Dict[Int, DeclarationVisibility]],
	globals: List[Dict[String, (GlobalId, DeclarationVisibility)]]
}


private pure func declaration_visibility_indexes(
	declaration_graph: DeclarationSkeletonGraph,
) -> DeclarationVisibilityIndexes:
	bound_graph = declaration_skeleton_graph_bound_graph(declaration_graph)
	module_count = indexed_graph_module_count(bound_module_graph_indexed_graph(bound_graph))
	var types: List[Dict[String, DeclarationVisibility]] = []
	var constructors: List[Dict[Int, DeclarationVisibility]] = []
	var globals: List[Dict[String, (GlobalId, DeclarationVisibility)]] = []
	var module_index: Int = 0

	while module_index < module_count:
		types = types.append({})
		constructors = constructors.append({})
		globals = globals.append({})
		module_index += 1

	for skeleton in declaration_skeleton_graph_skeletons(declaration_graph):
		match skeleton:
			TypeDeclarationSkeleton(id, visibility, _):
				match declaration_catalog_type_module_index(bound_graph, id):
					Some(owner_index):
						module_visibilities = types.get_or(owner_index, {})
						types = types.set(
							owner_index,
							module_visibilities.set(type_id_name(id), visibility),
						)
					None:
						void
			ConstructorDeclarationSkeleton(id, visibility, _, _):
				match declaration_catalog_constructor_module_index(bound_graph, id):
					Some(owner_index):
						module_visibilities = constructors.get_or(owner_index, {})
						constructors = constructors.set(
							owner_index,
							module_visibilities.set(constructor_id_definition_id(id), visibility),
						)
					None:
						void
			GlobalDeclarationSkeleton(id, visibility, _):
				match declaration_catalog_global_module_index(bound_graph, id):
					Some(owner_index):
						module_globals = globals.get_or(owner_index, {})
						globals = globals.set(
							owner_index,
							module_globals.set(global_id_name(id), (id, visibility)),
						)
					None:
						void
			_:
				void

	{
		types = types,
		constructors = constructors,
		globals = globals
	}


private pure func type_visibility(
	index: List[Dict[String, DeclarationVisibility]],
	bound_graph: BoundModuleGraph,
	id: TypeId,
) -> Option[DeclarationVisibility]:
	module_index ?= declaration_catalog_type_module_index(bound_graph, id)

	match index.get(module_index):
		Some(module_visibilities):
			module_visibilities.get(type_id_name(id))
		None:
			None


private pure func constructor_visibility(
	index: List[Dict[Int, DeclarationVisibility]],
	bound_graph: BoundModuleGraph,
	id: ConstructorId,
) -> Option[DeclarationVisibility]:
	module_index ?= declaration_catalog_constructor_module_index(bound_graph, id)

	match index.get(module_index):
		Some(module_visibilities):
			module_visibilities.get(constructor_id_definition_id(id))
		None:
			None


private pure func completed_global_matches_declaration(
	index: List[Dict[String, (GlobalId, DeclarationVisibility)]],
	bound_graph: BoundModuleGraph,
	global: AcceptedDeclarationCatalogGlobalInput,
) -> Bool:
	module_index = declaration_catalog_global_module_index(bound_graph, global.id)

	match module_index:
		None:
			False
		Some(index_value):
			match index.get(index_value):
				None:
					False
				Some(module_globals):
					match module_globals.get(global_id_name(global.id)):
						Some((id, visibility)):
							global_ids_equal(id, global.id) and visibility == global.visibility
						None:
							False


pure func accepted_declaration_catalog_build(
	input: AcceptedDeclarationCatalogInput,
) -> Result[AcceptedDeclarationCatalog, List[DeclarationCatalogError]]:
	implementation_headers = input.implementation_headers
	importable_modules = input.importable_graph
	callable_headers = implementation_header_graph_callable_headers(implementation_headers)
	trait_topology = callable_header_graph_trait_topology(callable_headers)
	type_headers = trait_topology_graph_type_headers(trait_topology)
	declaration_graph = type_header_graph_declaration_graph(type_headers)
	bound_graph = type_header_graph_bound_graph(type_headers)

	if not importable_module_graph_matches_scope(
		importable_modules,
		bound_module_scope(bound_module_graph_target(bound_graph)),
	):
		Err([DeclarationCatalogProductProvenanceMismatch])
	else:
		module_count = indexed_graph_module_count(bound_module_graph_indexed_graph(bound_graph))
		var type_entries: List[AcceptedCatalogTypeEntry] = []
		var type_index_by_module_and_name: List[Dict[String, Int]] = []
		var constructor_entries: List[AcceptedCatalogConstructorEntry] = []
		var constructor_index_by_definition_id: Dict[Int, Int] = {}
		var callable_entries: List[AcceptedCatalogCallableEntry] = []
		var callable_index_by_definition_id: Dict[Int, Int] = {}
		var global_entries: List[AcceptedCatalogGlobalEntry] = []
		var global_index_by_module_and_name: List[Dict[String, Int]] = []
		var trait_entries: List[AcceptedCatalogTraitEntry] = []
		var trait_index_by_definition_id: Dict[Int, Int] = {}
		var trait_method_entries: List[AcceptedCatalogTraitMethodEntry] = []
		var trait_method_index_by_owner_and_slot: Dict[Int, Dict[Int, Int]] = {}
		var implementation_entries: List[AcceptedCatalogImplementationEntry] = []
		var implementation_index_by_definition_id: Dict[Int, Int] = {}
		var implementation_method_entries: List[AcceptedCatalogImplementationMethodEntry] = []
		var implementation_method_index_by_owner_and_callable: Dict[Int, Dict[Int, Int]] = {}
		var module_index: Int = 0

		while module_index < module_count:
			type_index_by_module_and_name = type_index_by_module_and_name.append({})
			global_index_by_module_and_name = global_index_by_module_and_name.append({})
			module_index += 1

		var runtime_categories_by_definition_id: Dict[Int, DeclarationCatalogCategory] = {}

		var errors: List[DeclarationCatalogError] = []
		var builder_visits: Int = 0
		var duplicate_checks: Int = 0
		var checksum: Int = 23
		visibility_indexes = declaration_visibility_indexes(declaration_graph)

		for header in type_header_graph_headers(type_headers):
			id = header.id
			builder_visits += 1
			duplicate_checks += 1

			match add_single_name_index(
				type_index_by_module_and_name,
				declaration_catalog_type_module_index(bound_graph, id),
				type_id_name(id),
				type_entries.length(),
			):
				Ok(next_index):
					type_index_by_module_and_name = next_index
				Err(duplicate):
					errors = errors.append(
						if duplicate:
							DeclarationCatalogDuplicateTypeKey(id)
						else:
							DeclarationCatalogProductProvenanceMismatch
					)

			visibility = type_visibility(visibility_indexes.types, bound_graph, id)

			if visibility.is_none():
				errors = errors.append(DeclarationCatalogMissingTypeSkeleton(id))

			type_entries = type_entries.append({
				id = id,
				parameters = header.parameters,
				shape = header.shape,
				visibility = visibility.get_or(PublicDeclaration),
				containment = header.containment,
			})
			checksum = checksum_step(checksum, builder_visits + header.parameters.length())

			match header.shape:
				UnionTypeHeader(_, variants):
					for variant in variants:
						constructor_id = variant.id
						builder_visits += 1
						duplicate_checks += 1
						constructor_runtime_category = add_runtime_definition_category(
							runtime_categories_by_definition_id,
							constructor_id_definition_id(constructor_id),
							CatalogConstructorDeclaration,
							errors,
						)
						runtime_categories_by_definition_id = constructor_runtime_category[0]
						errors = constructor_runtime_category[1]

						match add_runtime_definition_index(
							constructor_index_by_definition_id,
							constructor_id_definition_id(constructor_id),
							constructor_entries.length(),
						):
							Ok(next_index):
								constructor_index_by_definition_id = next_index
							Err(duplicate):
								errors = errors.append(
									if duplicate:
										DeclarationCatalogDuplicateConstructorIdentity(
											constructor_id,
										)
									else:
										DeclarationCatalogProductProvenanceMismatch
								)

						constructor_visibility = constructor_visibility(
							visibility_indexes.constructors,
							bound_graph,
							constructor_id,
						)

						if constructor_visibility.is_none():
							errors = errors.append(
								DeclarationCatalogMissingConstructorSkeleton(constructor_id),
							)

						constructor_entries = constructor_entries.append({
							id = constructor_id,
							owner_type = id,
							variant = variant,
							visibility = constructor_visibility.get_or(PublicDeclaration),
						})
						checksum = checksum_step(
							checksum,
							builder_visits + constructor_id_definition_id(constructor_id),
						)
				_:
					void

		for header in callable_header_graph_callables(callable_headers):
			id = callable_header_id(header)
			builder_visits += 1
			duplicate_checks += 1
			callable_runtime_category = add_runtime_definition_category(
				runtime_categories_by_definition_id,
				callable_id_definition_id(id),
				CatalogCallableDeclaration,
				errors,
			)
			runtime_categories_by_definition_id = callable_runtime_category[0]
			errors = callable_runtime_category[1]

			match add_runtime_definition_index(
				callable_index_by_definition_id,
				callable_id_definition_id(id),
				callable_entries.length(),
			):
				Ok(next_index):
					callable_index_by_definition_id = next_index
				Err(duplicate):
					errors = errors.append(
						if duplicate:
							DeclarationCatalogDuplicateCallableIdentity(id)
						else:
							DeclarationCatalogProductProvenanceMismatch
					)

			callable_entries = callable_entries.append({
				id = id,
				parameters = callable_header_parameters(header),
				signature = callable_header_signature(header),
				visibility = callable_header_visibility(header),
				category = callable_header_category(header),
				body_category = callable_header_body_category(header),
				dimension_constraints = callable_header_dimension_constraints(header),
			})
			checksum = checksum_step(checksum, builder_visits + callable_id_definition_id(id))

		for global in input.completed_globals:
			if completed_global_matches_declaration(
				visibility_indexes.globals,
				bound_graph,
				global,
			):
				id = global.id
				builder_visits += 1
				duplicate_checks += 1

				match add_single_name_index(
					global_index_by_module_and_name,
					declaration_catalog_global_module_index(bound_graph, id),
					global_id_name(id),
					global_entries.length(),
				):
					Ok(next_index):
						global_index_by_module_and_name = next_index
					Err(duplicate):
						errors = errors.append(
							if duplicate:
								DeclarationCatalogDuplicateGlobalKey(id)
							else:
								DeclarationCatalogProductProvenanceMismatch
						)

				global_entries = global_entries.append({
					id = id,
					canonical_type = global.canonical_type,
					visibility = global.visibility,
					global_dependencies = global.global_dependencies,
					callable_dependencies = global.callable_dependencies,
				})
				checksum = checksum_step(checksum, builder_visits)
			else:
				errors = errors.append(DeclarationCatalogProductProvenanceMismatch)

		for header in trait_topology_graph_headers(trait_topology):
			id = trait_topology_header_id(header)
			builder_visits += 1
			duplicate_checks += 1
			trait_runtime_category = add_runtime_definition_category(
				runtime_categories_by_definition_id,
				trait_id_definition_id(id),
				CatalogTraitDeclaration,
				errors,
			)
			runtime_categories_by_definition_id = trait_runtime_category[0]
			errors = trait_runtime_category[1]

			match add_runtime_definition_index(
				trait_index_by_definition_id,
				trait_id_definition_id(id),
				trait_entries.length(),
			):
				Ok(next_index):
					trait_index_by_definition_id = next_index
				Err(duplicate):
					errors = errors.append(
						if duplicate:
							DeclarationCatalogDuplicateTraitIdentity(id)
						else:
							DeclarationCatalogProductProvenanceMismatch
					)

			trait_entries = trait_entries.append({
				id = id,
				parameters = trait_topology_header_parameters(header),
				supertraits = trait_topology_header_supertraits(header),
				visibility = trait_topology_header_visibility(header),
			})
			checksum = checksum_step(checksum, builder_visits + trait_id_definition_id(id))

			for method in trait_topology_header_methods(header):
				method_id = trait_method_slot_id(method)
				builder_visits += 1
				duplicate_checks += 1

				owner_key = trait_id_definition_id(id)
				slots = trait_method_index_by_owner_and_slot.get_or(owner_key, {})

				if slots.contains(trait_method_id_index(method_id)):
					errors = errors.append(
						DeclarationCatalogDuplicateTraitMethodIdentity(method_id),
					)
				else:
					trait_method_index_by_owner_and_slot = trait_method_index_by_owner_and_slot.set(
						owner_key,
						slots.set(trait_method_id_index(method_id), trait_method_entries.length()),
					)

				trait_method_entries = trait_method_entries.append({
					id = method_id,
					owner_trait = id,
					category = trait_method_slot_category(method),
					signature = trait_method_slot_signature(method),
				})
				checksum = checksum_step(
					checksum,
					builder_visits + trait_method_id_index(method_id),
				)

		for header in implementation_header_graph_headers(implementation_headers):
			id = implementation_header_id(header)
			builder_visits += 1
			duplicate_checks += 1
			implementation_runtime_category = add_runtime_definition_category(
				runtime_categories_by_definition_id,
				impl_id_definition_id(id),
				CatalogImplementationDeclaration,
				errors,
			)
			runtime_categories_by_definition_id = implementation_runtime_category[0]
			errors = implementation_runtime_category[1]

			match add_runtime_definition_index(
				implementation_index_by_definition_id,
				impl_id_definition_id(id),
				implementation_entries.length(),
			):
				Ok(next_index):
					implementation_index_by_definition_id = next_index
				Err(duplicate):
					errors = errors.append(
						if duplicate:
							DeclarationCatalogDuplicateImplementationIdentity(id)
						else:
							DeclarationCatalogProductProvenanceMismatch
					)

			implementation_entries = implementation_entries.append({
				id = id,
				trait_id = implementation_header_trait_id(header),
				parameters = implementation_header_parameters(header),
				receiver = implementation_header_receiver(header),
				receiver_head = implementation_header_receiver_head(header),
				visibility = implementation_header_visibility(header),
			})
			checksum = checksum_step(checksum, builder_visits + impl_id_definition_id(id))

			for method in implementation_header_methods(header):
				method_id = implementation_method_header_id(method)
				builder_visits += 1
				duplicate_checks += 1
				method_runtime_category = add_runtime_definition_category(
					runtime_categories_by_definition_id,
					callable_id_definition_id(method_id),
					CatalogImplementationMethodDeclaration,
					errors,
				)
				runtime_categories_by_definition_id = method_runtime_category[0]
				errors = method_runtime_category[1]

				owner_key = impl_id_definition_id(id)
				methods = implementation_method_index_by_owner_and_callable.get_or(owner_key, {})

				if methods.contains(callable_id_definition_id(method_id)):
					errors = errors.append(
						DeclarationCatalogDuplicateImplementationMethodIdentity(
							id,
							method_id,
						),
					)
				else:
					implementation_method_index_by_owner_and_callable = implementation_method_index_by_owner_and_callable.set(
						owner_key,
						methods.set(
							callable_id_definition_id(method_id),
							implementation_method_entries.length(),
						),
					)

				method_category = match method:
					ExplicitImplementationMethodHeaderValue(_):
						ExplicitCatalogImplementationMethod
					DefaultImplementationMethodHeaderValue(_):
						DefaultCatalogImplementationMethod

				method_signature = match method:
					ExplicitImplementationMethodHeaderValue(_):
						explicit_implementation_method_signature(method)
					DefaultImplementationMethodHeaderValue(_):
						default_implementation_method_signature(header, method)

				match method_signature:
					Some(signature):
						implementation_method_entries = implementation_method_entries.append({
							owner = id,
							id = method_id,
							category = method_category,
							parameters = explicit_implementation_method_parameters(method),
							signature = signature,
							dimension_constraints = explicit_implementation_method_dimension_constraints(
								method,
							),
						})
					None:
						errors = errors.append(
							DeclarationCatalogImplementationMethodSignatureMissing(
								id,
								method_id,
							),
						)

				checksum = checksum_step(
					checksum,
					builder_visits + callable_id_definition_id(method_id),
				)

		if errors.is_empty():
			Ok(into_opaque AcceptedDeclarationCatalog({
						bound_graph = bound_graph,
						type_entries = type_entries,
						type_index_by_module_and_name = type_index_by_module_and_name,
						constructor_entries = constructor_entries,
						constructor_index_by_definition_id = constructor_index_by_definition_id,
						callable_entries = callable_entries,
						callable_index_by_definition_id = callable_index_by_definition_id,
						global_entries = global_entries,
						global_index_by_module_and_name = global_index_by_module_and_name,
						trait_entries = trait_entries,
						trait_index_by_definition_id = trait_index_by_definition_id,
						trait_method_entries = trait_method_entries,
						trait_method_index_by_owner_and_slot = trait_method_index_by_owner_and_slot,
						implementation_entries = implementation_entries,
						implementation_index_by_definition_id = implementation_index_by_definition_id,
						implementation_method_entries = implementation_method_entries,
						implementation_method_index_by_owner_and_callable = implementation_method_index_by_owner_and_callable,
						metrics = {
							type_entries = type_entries.length(),
							constructor_entries = constructor_entries.length(),
							callable_entries = callable_entries.length(),
							global_entries = global_entries.length(),
							trait_entries = trait_entries.length(),
							trait_method_entries = trait_method_entries.length(),
							implementation_entries = implementation_entries.length(),
							implementation_method_entries = implementation_method_entries.length(),
							total_entries = type_entries.length() + constructor_entries.length() + callable_entries.length() + global_entries.length() + trait_entries.length() + trait_method_entries.length() + implementation_entries.length() + implementation_method_entries.length(),
							builder_visits = builder_visits,
							duplicate_checks = duplicate_checks,
							checksum = checksum
						}
					}))
		else:
			Err(errors)


pure func accepted_declaration_catalog_metrics(
	catalog: AcceptedDeclarationCatalog,
) -> AcceptedDeclarationCatalogMetrics:
	declaration_catalog_rep(catalog).metrics


pure func accepted_declaration_catalog_type_entries(
	catalog: AcceptedDeclarationCatalog,
) -> List[AcceptedCatalogTypeEntry]:
	declaration_catalog_rep(catalog).type_entries


pure func accepted_declaration_catalog_constructor_entries(
	catalog: AcceptedDeclarationCatalog,
) -> List[AcceptedCatalogConstructorEntry]:
	declaration_catalog_rep(catalog).constructor_entries


pure func accepted_declaration_catalog_callable_entries(
	catalog: AcceptedDeclarationCatalog,
) -> List[AcceptedCatalogCallableEntry]:
	declaration_catalog_rep(catalog).callable_entries


pure func accepted_declaration_catalog_global_entries(
	catalog: AcceptedDeclarationCatalog,
) -> List[AcceptedCatalogGlobalEntry]:
	declaration_catalog_rep(catalog).global_entries


pure func accepted_declaration_catalog_trait_entries(
	catalog: AcceptedDeclarationCatalog,
) -> List[AcceptedCatalogTraitEntry]:
	declaration_catalog_rep(catalog).trait_entries


pure func accepted_declaration_catalog_trait_method_entries(
	catalog: AcceptedDeclarationCatalog,
) -> List[AcceptedCatalogTraitMethodEntry]:
	declaration_catalog_rep(catalog).trait_method_entries


pure func accepted_declaration_catalog_implementation_entries(
	catalog: AcceptedDeclarationCatalog,
) -> List[AcceptedCatalogImplementationEntry]:
	declaration_catalog_rep(catalog).implementation_entries


pure func accepted_declaration_catalog_implementation_method_entries(
	catalog: AcceptedDeclarationCatalog,
) -> List[AcceptedCatalogImplementationMethodEntry]:
	declaration_catalog_rep(catalog).implementation_method_entries


pure func accepted_declaration_catalog_find_type(
	catalog: AcceptedDeclarationCatalog,
	id: TypeId,
) -> Option[AcceptedCatalogTypeEntry]:
	representation = declaration_catalog_rep(catalog)
	module_index ?= declaration_catalog_type_module_index(representation.bound_graph, id)
	names ?= representation.type_index_by_module_and_name.get(module_index)
	index ?= names.get(type_id_name(id))
	entry ?= representation.type_entries.get(index)

	if type_ids_equal(entry.id, id):
		Some(entry)
	else:
		None


pure func accepted_declaration_catalog_find_global(
	catalog: AcceptedDeclarationCatalog,
	id: GlobalId,
) -> Option[AcceptedCatalogGlobalEntry]:
	representation = declaration_catalog_rep(catalog)
	module_index ?= declaration_catalog_global_module_index(representation.bound_graph, id)
	names ?= representation.global_index_by_module_and_name.get(module_index)
	index ?= names.get(global_id_name(id))
	entry ?= representation.global_entries.get(index)

	if global_ids_equal(entry.id, id):
		Some(entry)
	else:
		None


pure func accepted_declaration_catalog_find_constructor(
	catalog: AcceptedDeclarationCatalog,
	id: ConstructorId,
) -> Option[AcceptedCatalogConstructorEntry]:
	representation = declaration_catalog_rep(catalog)
	index ?= runtime_definition_index(
		representation.constructor_index_by_definition_id,
		constructor_id_definition_id(id),
	)
	entry ?= representation.constructor_entries.get(index)

	if constructor_ids_equal(entry.id, id):
		Some(entry)
	else:
		None


pure func accepted_declaration_catalog_find_callable(
	catalog: AcceptedDeclarationCatalog,
	id: CallableId,
) -> Option[AcceptedCatalogCallableEntry]:
	representation = declaration_catalog_rep(catalog)
	index ?= runtime_definition_index(
		representation.callable_index_by_definition_id,
		callable_id_definition_id(id),
	)
	entry ?= representation.callable_entries.get(index)

	if callable_ids_equal(entry.id, id):
		Some(entry)
	else:
		None


pure func accepted_declaration_catalog_find_trait(
	catalog: AcceptedDeclarationCatalog,
	id: TraitId,
) -> Option[AcceptedCatalogTraitEntry]:
	representation = declaration_catalog_rep(catalog)
	index ?= runtime_definition_index(
		representation.trait_index_by_definition_id,
		trait_id_definition_id(id),
	)
	entry ?= representation.trait_entries.get(index)

	if trait_ids_equal(entry.id, id):
		Some(entry)
	else:
		None


pure func accepted_declaration_catalog_find_trait_method(
	catalog: AcceptedDeclarationCatalog,
	id: TraitMethodId,
) -> Option[AcceptedCatalogTraitMethodEntry]:
	representation = declaration_catalog_rep(catalog)
	owner_key = trait_id_definition_id(trait_method_id_owner(id))
	slots ?= representation.trait_method_index_by_owner_and_slot.get(owner_key)
	index ?= slots.get(trait_method_id_index(id))
	entry ?= representation.trait_method_entries.get(index)

	if trait_method_ids_equal(entry.id, id):
		Some(entry)
	else:
		None


pure func accepted_declaration_catalog_find_implementation(
	catalog: AcceptedDeclarationCatalog,
	id: ImplId,
) -> Option[AcceptedCatalogImplementationEntry]:
	representation = declaration_catalog_rep(catalog)
	index ?= runtime_definition_index(
		representation.implementation_index_by_definition_id,
		impl_id_definition_id(id),
	)
	entry ?= representation.implementation_entries.get(index)

	if impl_ids_equal(entry.id, id):
		Some(entry)
	else:
		None


pure func accepted_declaration_catalog_find_implementation_method(
	catalog: AcceptedDeclarationCatalog,
	owner: ImplId,
	id: CallableId,
) -> Option[AcceptedCatalogImplementationMethodEntry]:
	representation = declaration_catalog_rep(catalog)
	methods ?= representation.implementation_method_index_by_owner_and_callable.get(
		impl_id_definition_id(owner),
	)
	index ?= methods.get(callable_id_definition_id(id))
	entry ?= representation.implementation_method_entries.get(index)

	if impl_ids_equal(entry.owner, owner) and callable_ids_equal(entry.id, id):
		Some(entry)
	else:
		None
