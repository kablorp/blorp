-- Projection boundary from immutable type headers into a typecheck session.
-- Accepted aliases, records, and unions already live in category authorities;
-- their authority-present paths record only known names and nominal homes.
-- Builtins and provisional pre-acceptance checks still install real Env payloads.
-- The installation target carries importer-local naming separately, so parsed
-- declarations are not replayed at this boundary.
import:
	../../stage_04_modules/module_table: ModuleId, module_id_table_index, module_ids_equal
	../graph/indexed_graph: PreparedModuleScope, prepared_module_scope_id
	../modules/module_view:
		module_view_accepted_alias_authority,
