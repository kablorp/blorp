private enum HeaderInstallCategory:
	BuiltinHeaderCategory
	RecordHeaderCategory
	UnionHeaderCategory
	AliasHeaderCategory


private union TypeHeaderInstallation:
	LocalTypeHeaderInstallation(PreparedModuleScope, String)
	ImportedTypeHeaderInstallation(PreparedModuleScope, String)


-- These installation values own managed compiler data and therefore cannot be
-- value structs; their generated destructors must release nested payloads.
private record SemanticTypeSubstitution {
	parameter: TypeParameterId,
	replacement: SemanticType
}


private record InstalledUnionVariant {
	definition: VariantDef,
	constructor_id: Int
}


private pure func type_header_installation_scope(
	installation: TypeHeaderInstallation,
) -> PreparedModuleScope:
	match installation:
		LocalTypeHeaderInstallation(scope, _):
			scope
		ImportedTypeHeaderInstallation(scope, _):
			scope


private pure func resolved_declared_type_name(
	graph: TypeHeaderGraph,
	owner_module_id: ModuleId,
	source_name: String,
	installation: TypeHeaderInstallation,
) -> Option[String]:
	if module_ids_equal(
		owner_module_id,
		prepared_module_scope_id(type_header_installation_scope(installation)),
	):
		match installation:
			LocalTypeHeaderInstallation(_, _):
				Some(source_name)
			ImportedTypeHeaderInstallation(_, path):
				Some(canonical_module_type_name(path, source_name))
	else:
		type_header_graph_module_path(
			graph,
			owner_module_id,
		).map(
			func(path): canonical_module_type_name(path, source_name),
		)


private pure func semantic_dim_op(op: ResolvedDimOp) -> SemanticDimOp:
	match op:
		ResolvedDimAdd:
			SemanticDimAdd
		ResolvedDimSubtract:
			SemanticDimSubtract
		ResolvedDimMultiply:
			SemanticDimMultiply
		ResolvedDimDivide:
			SemanticDimDivide


private pure func semantic_type_substitution_find(
	substitutions: List[SemanticTypeSubstitution],
	parameter: TypeParameterId,
) -> Option[SemanticType]:
	var result: Option[SemanticType] = None

	for substitution in substitutions:
		if type_parameter_ids_equal(substitution.parameter, parameter):
			result = Some(substitution.replacement)
			break

	result


private pure func semantic_types_from_resolved_shapes_with_substitutions(
	graph: TypeHeaderGraph,
	shapes: List[ResolvedTypeShape],
	installation: TypeHeaderInstallation,
	substitutions: List[SemanticTypeSubstitution],
) -> Option[List[SemanticType]]:
	var result: List[SemanticType] = []
	var valid: Bool = True

	for shape in shapes:
		if valid:
			match semantic_type_from_resolved_shape_with_substitutions(
				graph,
				shape,
				installation,
				substitutions,
			):
				Some(semantic_type):
					result = result.append(semantic_type)
				None:
					valid = False

	if valid:
		Some(result)
	else:
		None


private pure func semantic_type_from_resolved_shape_with_substitutions(
	graph: TypeHeaderGraph,
	shape: ResolvedTypeShape,
	installation: TypeHeaderInstallation,
	substitutions: List[SemanticTypeSubstitution],
) -> Option[SemanticType]:
	match shape:
		DeclaredTypeShape(id, args):
			semantic_args ?= semantic_types_from_resolved_shapes_with_substitutions(
				graph,
				args,
				installation,
				substitutions,
			)

			header ?= type_header_graph_find(graph, id)

			match header.shape:
				AliasTypeHeader(TransparentAlias, target):
					if header.parameters.length() != semantic_args.length():
						None
					else:
						var alias_substitutions = substitutions
						var index: Int = 0

						while index < header.parameters.length():
							match (header.parameters.get(index), semantic_args.get(index)):
								(Some(parameter), Some(replacement)):
									alias_substitutions = alias_substitutions.append({
										parameter = parameter.id,
										replacement = replacement,
									})
								_:
									void

							index += 1

						semantic_type_from_resolved_shape_with_substitutions(
							graph,
							target,
							installation,
							alias_substitutions,
						)
				_:
					name ?= resolved_declared_type_name(
						graph,
						header.owner_module_id,
						header.source_name,
						installation,
					)
					Some(SemanticNamedType(name, semantic_args))
		IntrinsicTypeShape(intrinsic, args):
			semantic_args ?= semantic_types_from_resolved_shapes_with_substitutions(
				graph,
				args,
				installation,
				substitutions,
			)

			match intrinsic:
				IntrinsicTaskResult:
					-- TaskResult is a source-level alias retained in header shapes for
					-- layout analysis. The semantic environment must receive its
					-- canonical Result type so Result constructors remain valid.
					match semantic_args:
						[ok_type]:
							Some(
								SemanticNamedType(
									"Result",
									[ok_type, SemanticNamedType("ConcurrencyError", [])],
								),
							)
						_:
							None
				_:
					Some(SemanticNamedType(intrinsic_type_name(intrinsic), semantic_args))
		PreludeTypeShape(prelude, args):
			semantic_args ?= semantic_types_from_resolved_shapes_with_substitutions(
				graph,
				args,
				installation,
				substitutions,
			)
			prelude_name = prelude_type_name(prelude)

			semantic_name = if type_header_graph_owner_provides_prelude_type(
				graph,
				type_header_installation_scope(installation),
				prelude,
			):
				match installation:
					LocalTypeHeaderInstallation(_, _):
						prelude_name
					ImportedTypeHeaderInstallation(_, path):
						canonical_module_type_name(path, prelude_name)
			else:
				prelude_name

			Some(SemanticNamedType(semantic_name, semantic_args))
		TypeParameterShape(id):
			Some(
				semantic_type_substitution_find(
					substitutions,
					id,
				).get_or(SemanticTypeVar(type_parameter_id_name(id))),
			)
		SelfTypeShape(_):
			Some(SemanticSelfType)
		TraitTypeParameterShape(id):
			Some(SemanticTypeVar(trait_type_parameter_id_name(id)))
		CallableTypeParameterShape(id):
			Some(SemanticTypeVar(callable_type_parameter_id_name(id)))
		ImplementationTypeParameterShape(id):
			Some(SemanticTypeVar(implementation_type_parameter_id_name(id)))
		TraitSelfTypeShape(_):
			Some(SemanticSelfType)
		DimensionParameterShape(id, is_variadic):
			name = type_parameter_id_name(id)

			match semantic_type_substitution_find(substitutions, id):
				Some(replacement):
					Some(replacement)
				None:
					if is_variadic:
						Some(SemanticVarDimsType(name))
					else:
						Some(SemanticTypeVar(name))
		TraitDimensionParameterShape(id, is_variadic):
			name = trait_type_parameter_id_name(id)

			if is_variadic:
				Some(SemanticVarDimsType(name))
			else:
				Some(SemanticTypeVar(name))
		CallableDimensionParameterShape(id, is_variadic):
			name = callable_type_parameter_id_name(id)

			if is_variadic:
				Some(SemanticVarDimsType(name))
			else:
				Some(SemanticTypeVar(name))
		ImplementationDimensionParameterShape(id, is_variadic):
			name = implementation_type_parameter_id_name(id)

			if is_variadic:
				Some(SemanticVarDimsType(name))
			else:
				Some(SemanticTypeVar(name))
		WildcardDimensionShape(is_variadic):
			if is_variadic:
				Some(SemanticVarDimsType("#_"))
			else:
				Some(SemanticTypeVar("#_"))
		DimensionLiteralShape(value):
			Some(SemanticConstIntType(value))
		DimensionBinaryShape(op, left, right):
			semantic_left ?= semantic_type_from_resolved_shape_with_substitutions(
				graph,
				left,
				installation,
				substitutions,
			)
			semantic_right ?= semantic_type_from_resolved_shape_with_substitutions(
				graph,
				right,
				installation,
				substitutions,
			)
			Some(SemanticDimOpType(semantic_dim_op(op), semantic_left, semantic_right))
		RangeTypeShape(inner):
			semantic_inner ?= semantic_type_from_resolved_shape_with_substitutions(
				graph,
				inner,
				installation,
				substitutions,
			)
			Some(SemanticRangeType(semantic_inner))
		TupleTypeShape(elements):
			semantic_elements ?= semantic_types_from_resolved_shapes_with_substitutions(
				graph,
				elements,
				installation,
				substitutions,
			)
			Some(SemanticTupleType(semantic_elements))
		FunctionTypeShape(is_pure, params, return_type):
			semantic_params ?= semantic_types_from_resolved_shapes_with_substitutions(
				graph,
				params,
				installation,
				substitutions,
			)
			semantic_return ?= semantic_type_from_resolved_shape_with_substitutions(
				graph,
				return_type,
				installation,
				substitutions,
			)
			Some(SemanticFunctionType(is_pure, semantic_params, semantic_return))
		ArrayTypeShape(element, dims):
			semantic_element ?= semantic_type_from_resolved_shape_with_substitutions(
				graph,
				element,
				installation,
				substitutions,
			)
			semantic_dims ?= semantic_types_from_resolved_shapes_with_substitutions(
				graph,
				dims,
				installation,
				substitutions,
			)
			Some(SemanticArrayType(semantic_element, semantic_dims))


private pure func semantic_type_from_resolved_shape(
	graph: TypeHeaderGraph,
	shape: ResolvedTypeShape,
	installation: TypeHeaderInstallation,
) -> Option[SemanticType]:
	semantic_type_from_resolved_shape_with_substitutions(graph, shape, installation, [])


-- Declaration-authority builders use these category-specific entry points so
-- importer-local naming cannot be confused with owner-local naming. The
-- resolved shape remains definition-owned; only its projected semantic spelling
-- depends on the installation site.
pure func local_semantic_type_from_resolved_shape(
	graph: TypeHeaderGraph,
	owner_scope: PreparedModuleScope,
	owner_path: String,
	shape: ResolvedTypeShape,
) -> Option[SemanticType]:
	semantic_type_from_resolved_shape(
		graph,
		shape,
		LocalTypeHeaderInstallation(owner_scope, owner_path),
	)


pure func imported_semantic_type_from_resolved_shape(
	graph: TypeHeaderGraph,
	owner_scope: PreparedModuleScope,
	owner_path: String,
	shape: ResolvedTypeShape,
) -> Option[SemanticType]:
	semantic_type_from_resolved_shape(
		graph,
		shape,
		ImportedTypeHeaderInstallation(owner_scope, owner_path),
	)


private pure func env_containment_summary(facts: TypeContainmentFacts) -> TypeContainmentSummary:
	{
		may_contain_function = facts.may_contain_function,
		may_contain_one_shot_stream = facts.may_contain_one_shot_stream,
		may_contain_resource_source = facts.may_contain_resource_source
	}


-- Per-module header facts, built once per module and read by every importer.
-- Everything here is a projection of the imported module's own headers: the
-- installed spelling, its type parameters, and the layout-derived kind. None
-- of it depends on the importing module, so the per-edge install reads these
-- instead of recomputing a canonical name and a parameter-name list for every
-- (importer, imported) pair.
record InstalledBuiltinHeaderFacts {
	accepted_header: AcceptedBuiltinHeader,
	source_name: String,
	type_name: String,
	type_parameters: List[String],
	type_kind: TypeKind,
	is_resource: Bool,
	cleanup: Option[String],
	containment: TypeContainmentSummary
}


record InstalledRecordHeaderFacts {
	accepted_header: AcceptedRecordHeader,
	source_name: String,
	type_name: String,
	type_parameters: List[String]
}


record InstalledUnionHeaderFacts {
	accepted_header: AcceptedUnionHeader,
	source_name: String,
	type_name: String,
	type_parameters: List[String]
}


record InstalledAliasHeaderFacts {
	accepted_header: AcceptedAliasHeader,
	source_name: String,
	type_name: String,
	type_parameters: List[String],
	layout: AliasLayout
}


-- One module's header product for one installation side. `imported` selects
-- both the header set (public versus local) and the installed spelling, and
-- is also the gate the per-edge install consults for imported-alias bindings.
record ModuleHeaderSection {
	module_scope: PreparedModuleScope,
	module_path: String,
	imported: Bool,
	builtins: List[InstalledBuiltinHeaderFacts],
	records: List[InstalledRecordHeaderFacts],
	unions: List[InstalledUnionHeaderFacts],
	aliases: List[InstalledAliasHeaderFacts]
}


record ModuleHeaderProduct {
	local: Option[ModuleHeaderSection],
	imported: Option[ModuleHeaderSection]
}


opaque type ModuleHeaderProductTable = List[ModuleHeaderProduct]

private EMPTY_MODULE_HEADER_PRODUCT: ModuleHeaderProduct = {
	local = None,
	imported = None
}


private pure func section_installation(section: ModuleHeaderSection) -> TypeHeaderInstallation:
	if section.imported:
		ImportedTypeHeaderInstallation(section.module_scope, section.module_path)
	else:
		LocalTypeHeaderInstallation(section.module_scope, section.module_path)


private pure func installed_header_name(
	source_name: String,
	module_path: String,
	imported: Bool,
) -> String:
	if imported:
		canonical_module_type_name(module_path, source_name)
	else:
		source_name


private pure func builtin_header_facts(
	header: AcceptedBuiltinHeader,
	module_path: String,
	imported: Bool,
) -> InstalledBuiltinHeaderFacts:
	source_name = builtin_type_header_source_name(header)
	layout = builtin_type_header_layout(header)

	is_resource = match layout:
		ScalarBuiltin | ManagedBuiltin | NoValueBuiltin | UnclassifiedBuiltin:
			False
		ResourceBuiltin(_):
			True

	type_kind = match layout:
		ScalarBuiltin:
			TypeScalarBuiltin
		ResourceBuiltin(_):
			TypeResource
		ManagedBuiltin | NoValueBuiltin | UnclassifiedBuiltin:
			TypeBuiltin

	cleanup = match layout:
		ResourceBuiltin(ResourceWithCleanup(cleanup_function)):
			Some(cleanup_function)
		ResourceBuiltin(ResourceWithoutCleanup):
			None
		ScalarBuiltin | ManagedBuiltin | NoValueBuiltin | UnclassifiedBuiltin:
			None

	{
		accepted_header = header,
		source_name = source_name,
		type_name = installed_header_name(source_name, module_path, imported),
		type_parameters = builtin_type_header_parameters(
			header,
		).map(
			func(parameter): type_parameter_id_name(parameter.id),
		),
		type_kind = type_kind,
		is_resource = is_resource,
		cleanup = cleanup,
		containment = env_containment_summary(builtin_type_header_containment_facts(header))
	}


private pure func record_header_facts(
	header: AcceptedRecordHeader,
	module_path: String,
	imported: Bool,
) -> InstalledRecordHeaderFacts:
	source_name = record_type_header_source_name(header)
	{
		accepted_header = header,
		source_name = source_name,
		type_name = installed_header_name(source_name, module_path, imported),
		type_parameters = record_type_header_parameters(
			header,
		).map(
			func(parameter): type_parameter_id_name(parameter.id),
		)
	}


private pure func union_header_facts(
	header: AcceptedUnionHeader,
	module_path: String,
	imported: Bool,
) -> InstalledUnionHeaderFacts:
	source_name = union_type_header_source_name(header)
	{
		accepted_header = header,
		source_name = source_name,
		type_name = installed_header_name(source_name, module_path, imported),
		type_parameters = union_type_header_parameters(
			header,
		).map(
			func(parameter): type_parameter_id_name(parameter.id),
		)
	}


private pure func alias_header_facts(
	header: AcceptedAliasHeader,
	module_path: String,
	imported: Bool,
) -> InstalledAliasHeaderFacts:
	source_name = alias_type_header_source_name(header)
	{
		accepted_header = header,
		source_name = source_name,
		type_name = installed_header_name(source_name, module_path, imported),
		type_parameters = alias_type_header_parameters(
			header,
		).map(
			func(parameter): type_parameter_id_name(parameter.id),
		),
		layout = alias_type_header_layout(header)
	}


-- The header product builder: local `var` accumulators, one published
-- immutable section. Category order here is the install order every importer
-- replays, so diagnostics keep the order they had when each category re-ran
-- its own loop.
pure func module_header_section_build(
	graph: TypeHeaderGraph,
	module_scope: PreparedModuleScope,
	module_path: String,
	imported: Bool,
) -> ModuleHeaderSection:
	var builtins: List[InstalledBuiltinHeaderFacts] = []
	var records: List[InstalledRecordHeaderFacts] = []
	var unions: List[InstalledUnionHeaderFacts] = []
	var aliases: List[InstalledAliasHeaderFacts] = []

	builtin_headers = if imported:
		type_header_graph_public_builtin_headers_for_scope(graph, module_scope)
	else:
		type_header_graph_local_builtin_headers_for_scope(graph, module_scope)

	for header in builtin_headers:
		builtins = builtins.append(builtin_header_facts(header, module_path, imported))

	record_headers = if imported:
		type_header_graph_public_record_headers_for_scope(graph, module_scope)
	else:
		type_header_graph_local_record_headers_for_scope(graph, module_scope)

	for header in record_headers:
		records = records.append(record_header_facts(header, module_path, imported))

	union_headers = if imported:
		type_header_graph_public_union_headers_for_scope(graph, module_scope)
	else:
		type_header_graph_local_union_headers_for_scope(graph, module_scope)

	for header in union_headers:
		unions = unions.append(union_header_facts(header, module_path, imported))

	alias_headers = if imported:
		type_header_graph_public_alias_headers_for_scope(graph, module_scope)
	else:
		type_header_graph_local_alias_headers_for_scope(graph, module_scope)

	for header in alias_headers:
		aliases = aliases.append(alias_header_facts(header, module_path, imported))

	{
		module_scope = module_scope,
		module_path = module_path,
		imported = imported,
		builtins = builtins,
		records = records,
		unions = unions,
		aliases = aliases
	}


pure func module_header_product_table_empty(module_count: Int) -> ModuleHeaderProductTable:
	into_opaque ModuleHeaderProductTable(EMPTY_MODULE_HEADER_PRODUCT.repeat(module_count))


private pure func module_header_product_at(
	table: ModuleHeaderProductTable,
	module_scope: PreparedModuleScope,
) -> Option[ModuleHeaderProduct]:
	products = from_opaque ModuleHeaderProductTable(table)
	products.get(module_id_table_index(prepared_module_scope_id(module_scope)))


private pure func module_header_section_matches(
	section: ModuleHeaderSection,
	module_path: String,
	imported: Bool,
) -> Bool:
	section.imported == imported and section.module_path == module_path


-- Memoization is a whole-table rebuild on a miss and a read on a hit; misses
-- happen once per module, hits once per importer edge.
pure func module_header_product_table_ensure(
	table: ModuleHeaderProductTable,
	graph: TypeHeaderGraph,
	module_scope: PreparedModuleScope,
	module_path: String,
	imported: Bool,
) -> ModuleHeaderProductTable:
	index = module_id_table_index(prepared_module_scope_id(module_scope))
	products = from_opaque ModuleHeaderProductTable(table)

	current = match products.get(index):
		Some(product):
			product
		None:
			EMPTY_MODULE_HEADER_PRODUCT

	existing = if imported:
		current.imported
	else:
		current.local

	already_present = match existing:
		Some(section):
			module_header_section_matches(section, module_path, imported)
		None:
			False

	if already_present:
		into_opaque ModuleHeaderProductTable(products)
	else:
		section = module_header_section_build(graph, module_scope, module_path, imported)

		next_product = if imported:
			{ current | imported = Some(section) }
		else:
			{ current | local = Some(section) }

		into_opaque ModuleHeaderProductTable(products.set(index, next_product))


pure func module_header_product_table_section(
	table: ModuleHeaderProductTable,
	graph: TypeHeaderGraph,
	module_scope: PreparedModuleScope,
	module_path: String,
	imported: Bool,
) -> ModuleHeaderSection:
	cached = match module_header_product_at(table, module_scope):
		Some(product):
			if imported:
				product.imported
			else:
				product.local
		None:
			None

	match cached:
		Some(section):
			if module_header_section_matches(section, module_path, imported):
				section
			else:
				module_header_section_build(graph, module_scope, module_path, imported)
		None:
			module_header_section_build(graph, module_scope, module_path, imported)


private pure func record_header_fields(
	graph: TypeHeaderGraph,
	header: AcceptedRecordHeader,
	installation: TypeHeaderInstallation,
) -> Option[List[FieldDecl]]:
	var result: List[FieldDecl] = []
	var valid: Bool = True

	for field in record_type_header_fields(header):
		if valid:
			match semantic_type_from_resolved_shape(graph, field.typ, installation):
				Some(field_type):
					result = result.append({
						name = field.name,
						field_type = field_type,
					})
				None:
					valid = False

	if valid:
		Some(result)
	else:
		None


pure func imported_record_header_fields(
	graph: TypeHeaderGraph,
	module_scope: PreparedModuleScope,
	module_path: String,
	header: AcceptedRecordHeader,
) -> Option[List[FieldDecl]]:
	record_header_fields(
		graph,
		header,
		ImportedTypeHeaderInstallation(module_scope, module_path),
	)


private pure func installed_union_variant(
	graph: TypeHeaderGraph,
	variant: TypeHeaderVariant,
	installation: TypeHeaderInstallation,
) -> Option[InstalledUnionVariant]:
	fields ?= semantic_types_from_resolved_shapes_with_substitutions(
		graph,
		variant.fields,
		installation,
		[],
	)
	Some({
		definition = {
			name = variant.name,
			fields = fields,
			tag = variant.tag
		},
		constructor_id = constructor_id_definition_id(variant.id),
	})


private pure func installed_union_variants(
	graph: TypeHeaderGraph,
	header: AcceptedUnionHeader,
	installation: TypeHeaderInstallation,
) -> Option[List[InstalledUnionVariant]]:
	var result: List[InstalledUnionVariant] = []
	var valid: Bool = True

	for variant in union_type_header_variants(header):
		if valid:
			match installed_union_variant(graph, variant, installation):
				Some(installed):
					result = result.append(installed)
				None:
					valid = False

	if valid:
		Some(result)
	else:
		None


private pure func union_header_variant_definitions(
	graph: TypeHeaderGraph,
	header: AcceptedUnionHeader,
	installation: TypeHeaderInstallation,
) -> Option[List[VariantDef]]:
	installed_union_variants(
		graph,
		header,
		installation,
	).map(
		func(variants): variants.map(func(variant): variant.definition),
	)


pure func imported_union_header_variants(
	graph: TypeHeaderGraph,
	module_scope: PreparedModuleScope,
	module_path: String,
	header: AcceptedUnionHeader,
) -> Option[List[VariantDef]]:
	union_header_variant_definitions(
		graph,
		header,
		ImportedTypeHeaderInstallation(module_scope, module_path),
	)


-- The header installer: one builder over a published section, with the
-- session state as a single `var` accumulator that every write updates in
-- place. Helpers above compute values; none of them takes or returns the
-- session, which is what keeps the type-home and known-type dictionaries and
-- the environment uniquely owned across the whole section instead of copying
-- once per inserted name.
pure func typecheck_install_module_header_section(
	state: TypecheckState,
	graph: TypeHeaderGraph,
	section: ModuleHeaderSection,
) -> TypecheckState:
	module_path = section.module_path
	imported = section.imported
	installation = section_installation(section)
	record_authority = module_view_accepted_record_authority(state.module_view)
	union_authority = module_view_accepted_union_authority(state.module_view)
	alias_authority = module_view_accepted_alias_authority(state.module_view)
	has_alias_authority = alias_authority.is_some()
	binds_imported_aliases = imported and not has_alias_authority
	allows_builtin = typecheck_state_allows_builtin(state)
	var acc = state
	-- The two fact tables this builder writes are hoisted into their own
	-- local owners and folded back once at the end, the pattern
	-- `docs/MEMORY_MODEL.md` prescribes for a collection field updated in a
	-- loop. Left on the session they are reachable from two places at every
	-- insert, and the opaque unwrap inside the index helper retains its
	-- borrowed argument, so `Dict.set` copied the whole table on every
	-- installed name.
	var type_homes: TypeHomeIndex = acc.type_homes
	var known_types: KnownTypeIndex = acc.known_type_index
	acc = { acc |
		type_homes = type_home_index_empty(),
		known_type_index = known_type_index_empty()
	}

	for facts in section.builtins:
		if not imported and not allows_builtin:
			prefix = if facts.is_resource:
				"resource type "
			else:
				"type "

			acc = typecheck_state_add_error(
				acc,
				"'" + prefix + facts.source_name + " = builtin' can only be used in the standard library",
			)

		if facts.is_resource:
			known_types = known_type_index_record_resource(known_types, facts.type_name)
		else:
			if not imported:
				known_types = known_type_index_record_type(known_types, facts.type_name)

		acc = { acc |
			env = env_add_accepted_type(
				acc.env,
				facts.type_name,
				facts.type_parameters,
				[],
				facts.type_kind,
				facts.is_resource,
				False,
				facts.containment,
			)
		}

		match facts.cleanup:
			Some(cleanup_function):
				acc = { acc |
					context = register_resource_cleanup(
						acc.context,
						facts.type_name,
						cleanup_function,
					)
				}
			None:
				void

		type_homes = type_home_index_record(type_homes, facts.type_name, module_path, imported)

		if binds_imported_aliases:
			acc = add_imported_accepted_type_aliases(
				acc,
				module_path,
				facts.source_name,
				facts.type_name,
				facts.type_parameters,
			)

	for facts in section.records:
		match record_authority:
			Some(authority):
				if accepted_record_contains(authority, facts.type_name):
					type_homes = type_home_index_record(
						type_homes,
						facts.type_name,
						module_path,
						imported,
					)

					if binds_imported_aliases:
						acc = add_imported_accepted_type_aliases(
							acc,
							module_path,
							facts.source_name,
							facts.type_name,
							facts.type_parameters,
						)
				else:
					acc = typecheck_state_add_error(
						acc,
						"internal typecheck error: accepted record authority is missing '" + facts.type_name + "'",
					)
			None:
				match record_header_fields(graph, facts.accepted_header, installation):
					None:
						acc = typecheck_state_add_error(
							acc,
							"internal typecheck error: accepted record header '" + facts.type_name + "' refers to a module absent from its type-header graph",
						)
					Some(fields):
						is_value = match record_type_header_layout(facts.accepted_header):
							HeapRecord:
								False
							ValueStruct:
								True

						acc = { acc |
							env = env_add_accepted_record(
								acc.env,
								facts.type_name,
								facts.type_parameters,
								fields,
								is_value,
								record_type_header_contains_resource(facts.accepted_header),
								env_containment_summary(
									record_type_header_containment_facts(facts.accepted_header),
								),
							)
						}
						type_homes = type_home_index_record(
							type_homes,
							facts.type_name,
							module_path,
							imported,
						)

						if binds_imported_aliases:
							acc = add_imported_accepted_type_aliases(
								acc,
								module_path,
								facts.source_name,
								facts.type_name,
								facts.type_parameters,
							)

	for facts in section.unions:
		match union_authority:
			Some(_):
				-- Graph completion constructed this authority from these exact headers.
				-- Accepted installation retains only spelling provenance; union payload,
				-- constructors, and containment remain authority-owned.
				type_homes = type_home_index_record(
					type_homes,
					facts.type_name,
					module_path,
					imported,
				)
			None:
				match installed_union_variants(graph, facts.accepted_header, installation):
					None:
						acc = typecheck_state_add_error(
							acc,
							"internal typecheck error: accepted union header '" + facts.type_name + "' refers to a module absent from its type-header graph",
						)
					Some(installed_variants):
						type_kind = match union_type_header_layout(facts.accepted_header):
							TaggedUnion:
								TypeUnion
							FieldlessEnum:
								TypeEnum

						acc = { acc | env = env_add_accepted_type_with_constructor_ids(
								acc.env,
								facts.type_name,
								facts.type_parameters,
								installed_variants.map(func(variant): variant.definition),
								type_kind,
								union_type_header_contains_resource(facts.accepted_header),
								True,
								installed_variants.map(func(variant): Some(variant.constructor_id)),
								env_containment_summary(
									union_type_header_containment_facts(facts.accepted_header),
								),
							) }
						type_homes = type_home_index_record(
							type_homes,
							facts.type_name,
							module_path,
							imported,
						)

						if binds_imported_aliases:
							acc = add_imported_accepted_type_aliases(
								acc,
								module_path,
								facts.source_name,
								facts.type_name,
								facts.type_parameters,
							)

	for facts in section.aliases:
		match alias_authority:
			Some(authority):
				if accepted_alias_contains(authority, facts.type_name):
					known_types = known_type_index_record_type(known_types, facts.type_name)

					match facts.layout:
						TransparentAlias:
							void
						OpaqueAlias:
							type_homes = type_home_index_record(
								type_homes,
								facts.type_name,
								module_path,
								imported,
							)
				else:
					acc = typecheck_state_add_error(
						acc,
						"internal typecheck error: accepted alias authority is missing '" + facts.type_name + "'",
					)
			None:
				match semantic_type_from_resolved_shape(
					graph,
					alias_type_header_target(facts.accepted_header),
					installation,
				):
					None:
						acc = typecheck_state_add_error(
							acc,
							"internal typecheck error: accepted alias header '" + facts.type_name + "' refers to a module absent from its type-header graph",
						)
					Some(target):
						containment = alias_type_header_containment_facts(facts.accepted_header)
						env_summary = env_containment_summary(containment)

						-- Cold path: only reached when this importer has no accepted
						-- alias authority, so the extra environment read here costs
						-- nothing on the graph-backed install.
						next_env: Env = match facts.layout:
							TransparentAlias:
								env_add_accepted_alias_with_containment(
									acc.env,
									facts.type_name,
									facts.type_parameters,
									target,
									containment.contains_resource,
									env_summary,
								)
							OpaqueAlias:
								env_add_accepted_opaque_alias(
									acc.env,
									facts.type_name,
									facts.type_parameters,
									target,
									Some(module_path),
									containment.contains_resource,
									env_summary,
								)

						acc = { acc | env = next_env }
						known_types = known_type_index_record_type(known_types, facts.type_name)

						match facts.layout:
							TransparentAlias:
								void
							OpaqueAlias:
								type_homes = type_home_index_record(
									type_homes,
									facts.type_name,
									module_path,
									imported,
								)

						if imported:
							acc = add_imported_accepted_type_aliases(
								acc,
								module_path,
								facts.source_name,
								facts.type_name,
								facts.type_parameters,
							)

	-- Publish the fact tables this builder wrote, once, as the result. The
	-- update is also what makes `acc` the builder's own owner of the session:
	-- `stage_09_core/consume_specialize.brp`'s `result_aliases_var` reports a
	-- bare `acc` return (bound from `state`) as aliasing argument 0 and
	-- refuses the consuming clone, so every importer edge would hand this
	-- function a borrowed session and copy the type-home dictionary on its
	-- first insert. A record update result is reported as non-aliasing, the
	-- clone is generated, and `acc` stays uniquely owned across the whole
	-- section.
	{ acc |
		known_type_index = known_types,
		type_homes = type_homes
	}


private pure func single_category_section(
	base: ModuleHeaderSection,
	builtins: List[InstalledBuiltinHeaderFacts],
	records: List[InstalledRecordHeaderFacts],
	unions: List[InstalledUnionHeaderFacts],
	aliases: List[InstalledAliasHeaderFacts],
) -> ModuleHeaderSection:
	{ base |
		builtins = builtins,
		records = records,
		unions = unions,
		aliases = aliases
	}


-- Category entry points. Tools and tests install one category at a time; the
-- graph driver installs a whole section. Both run the same builder.
private pure func typecheck_install_header_category(
	state: TypecheckState,
	graph: TypeHeaderGraph,
	module_scope: PreparedModuleScope,
	module_path: String,
	imported: Bool,
	category: HeaderInstallCategory,
) -> TypecheckState:
	section = module_header_section_build(graph, module_scope, module_path, imported)

	selected = match category:
		BuiltinHeaderCategory:
			single_category_section(section, section.builtins, [], [], [])
		RecordHeaderCategory:
			single_category_section(section, [], section.records, [], [])
		UnionHeaderCategory:
			single_category_section(section, [], [], section.unions, [])
		AliasHeaderCategory:
			single_category_section(section, [], [], [], section.aliases)

	typecheck_install_module_header_section(state, graph, selected)


pure func typecheck_install_local_builtin_headers(
	state: TypecheckState,
	graph: TypeHeaderGraph,
	module_scope: PreparedModuleScope,
	module_path: String,
) -> TypecheckState:
	typecheck_install_header_category(
		state,
		graph,
		module_scope,
		module_path,
		False,
		BuiltinHeaderCategory,
	)


pure func typecheck_install_imported_builtin_headers(
	state: TypecheckState,
	graph: TypeHeaderGraph,
	module_scope: PreparedModuleScope,
	module_path: String,
) -> TypecheckState:
	typecheck_install_header_category(
		state,
		graph,
		module_scope,
		module_path,
		True,
		BuiltinHeaderCategory,
	)


pure func typecheck_install_local_record_headers(
	state: TypecheckState,
	graph: TypeHeaderGraph,
	module_scope: PreparedModuleScope,
