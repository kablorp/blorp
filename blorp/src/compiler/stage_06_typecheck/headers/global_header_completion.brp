-- Definition-owned ordering for global initializer header completion.
--
-- This phase plans only type availability. It does not evaluate constants or
-- impose CTFE source-order rules. Annotated globals already publish a type, so
-- only dependencies between unannotated globals constrain completion order.
import:
	../../stage_03_parse/source_ast_finalize:
		IdentifierReference,
		parsed_expr_free_identifier_references,
	../../stage_04_modules/module_table: module_id_table_index
	../graph/indexed_graph: indexed_graph_module_count, prepared_module_scope_id
	../modules/bound_module_graph:
		BoundModule,
		BoundModuleGraph,
		bound_module_graph_find_canonical_path,
		bound_module_graph_find_for_id,
		bound_module_graph_indexed_graph,
		bound_module_graph_module_table,
		bound_module_scope,
		bound_module_view,
	../modules/module_view: module_view_find_imported_name, module_view_find_module_alias
	callable_headers:
		CallableHeaderGraph,
		GlobalHeader,
		annotated_global_header_type,
		callable_header_graph_globals,
		callable_header_graph_trait_topology,
		global_header_id,
		global_header_source,
	declaration_skeleton: GlobalId, global_id_module_id, global_id_name
	heap: Heap, heap
	trait_headers: trait_topology_graph_type_headers
	type_header_graph: type_header_graph_bound_graph


private record GlobalHeaderIndex {
	headers: List[GlobalHeader],
	rows_by_module_and_name: List[Dict[String, Int]],
	module_indexes_by_header_row: List[Int]
}


private type alias GlobalDependenciesByHeaderRow = List[List[Int]]

private GLOBAL_HEADER_MODULE_INDEX_MISSING: Int = -1


private record GlobalHeaderCompletionPlanRep {
	pending_in_dependency_order: List[GlobalHeader],
	pending_dependencies_in_order: List[List[GlobalId]],
	annotated_in_stable_order: List[GlobalHeader],
	annotated_dependencies_in_stable_order: List[List[GlobalId]]
}


opaque type GlobalHeaderCompletionPlan = GlobalHeaderCompletionPlanRep


union GlobalHeaderCompletionPlanBuild:
	GlobalHeaderCompletionPlanReady(GlobalHeaderCompletionPlan)
	GlobalHeaderCompletionPlanBlocked(GlobalHeaderCompletionPlan, List[List[GlobalId]], List[GlobalId])


private record GlobalDependencyAdjacency {
	pending_rows: List[Int],
	outgoing: Dict[Int, List[Int]],
	incoming: Dict[Int, List[Int]]
}


private struct GlobalDependencyDfsFrame {
	vertex: Int,
	next_dependency: Int
}


private record PendingGlobalOrder {
	ordered_rows: List[Int],
	remaining_rows: List[Int]
}


private pure func global_header_index(
	bound_graph: BoundModuleGraph,
	headers: List[GlobalHeader],
) -> GlobalHeaderIndex:
	empty_module_rows: Dict[String, Int] = {}
	var rows_by_module_and_name = empty_module_rows.repeat(
		indexed_graph_module_count(bound_module_graph_indexed_graph(bound_graph)),
	)
	var module_indexes_by_header_row = GLOBAL_HEADER_MODULE_INDEX_MISSING.repeat(headers.length())
	var header_row: Int = 0

	for header in headers:
		id = global_header_id(header)

		match bound_module_graph_find_for_id(
			bound_graph,
			bound_module_graph_module_table(bound_graph),
			global_id_module_id(id),
		):
			Some(module):
				module_index = module_id_table_index(
					prepared_module_scope_id(bound_module_scope(module)),
				)
				module_indexes_by_header_row = module_indexes_by_header_row.set(
					header_row,
					module_index,
				)
				module_rows = rows_by_module_and_name.get_or(module_index, {})
				rows_by_module_and_name = rows_by_module_and_name.set(
					module_index,
					module_rows.set(global_id_name(id), header_row),
				)
			None:
				void

		header_row += 1

	{
		headers = headers,
		rows_by_module_and_name = rows_by_module_and_name,
		module_indexes_by_header_row = module_indexes_by_header_row
	}


private pure func global_header_module_index(
	index: GlobalHeaderIndex,
	header_row: Int,
) -> Option[Int]:
	module_index = index.module_indexes_by_header_row.get_or(
		header_row,
		GLOBAL_HEADER_MODULE_INDEX_MISSING,
	)

	if module_index == GLOBAL_HEADER_MODULE_INDEX_MISSING:
		None
	else:
		Some(module_index)


private pure func global_header_row_for_module_and_name(
	index: GlobalHeaderIndex,
	module: BoundModule,
	name: String,
) -> Option[Int]:
	module_index = module_id_table_index(prepared_module_scope_id(bound_module_scope(module)))
	module_rows ?= index.rows_by_module_and_name.get(module_index)
	module_rows.get(name)


private pure func resolved_global_reference(
	bound_graph: BoundModuleGraph,
	index: GlobalHeaderIndex,
	owner_module: BoundModule,
	reference: IdentifierReference,
) -> Option[Int]:
	view = bound_module_view(owner_module)

	match reference.qualified_member:
		Some(member_name):
			match module_view_find_module_alias(view, reference.name):
				Some(module_path):
					imported_module ?= bound_module_graph_find_canonical_path(
						bound_graph,
						module_path,
					)
					global_header_row_for_module_and_name(index, imported_module, member_name)
				None:
					-- Ordinary field access depends on its receiver, not on the
					-- field spelling.
					global_header_row_for_module_and_name(index, owner_module, reference.name)
		None:
			match module_view_find_imported_name(view, reference.name):
				Some(binding):
					imported_module ?= bound_module_graph_find_canonical_path(
						bound_graph,
						binding.module_path,
					)
					global_header_row_for_module_and_name(
						index,
						imported_module,
						binding.original_name,
					)
				None:
					global_header_row_for_module_and_name(index, owner_module, reference.name)


private pure func append_unique_global_row(rows: List[Int], row: Int) -> List[Int]:
	if rows.contains(row):
		rows
	else:
		rows.append(row)


private pure func global_initializer_dependencies(
	bound_graph: BoundModuleGraph,
	index: GlobalHeaderIndex,
	header_row: Int,
) -> List[Int]:
	match index.headers.get(header_row):
		None:
			[]
		Some(header):
			owner = global_header_id(header)
			owner_module = bound_module_graph_find_for_id(
				bound_graph,
				bound_module_graph_module_table(bound_graph),
				global_id_module_id(owner),
			)
			var dependencies: List[Int] = []

			match owner_module:
				Some(module):
					for reference in parsed_expr_free_identifier_references(
						global_header_source(header).value,
					):
						match resolved_global_reference(bound_graph, index, module, reference):
							Some(dependency_row):
								dependencies = append_unique_global_row(
									dependencies,
									dependency_row,
								)
							None:
								void
				None:
					void

			dependencies


private pure func global_dependency_rows(
	bound_graph: BoundModuleGraph,
	index: GlobalHeaderIndex,
) -> GlobalDependenciesByHeaderRow:
	var dependencies: GlobalDependenciesByHeaderRow = []

	for header_row in 0..index.headers.length():
		dependencies = dependencies.append(
			global_initializer_dependencies(
				bound_graph,
				index,
				header_row,
			),
		)

	dependencies


private pure func global_dependency_adjacency(
	index: GlobalHeaderIndex,
	pending_rows: List[Int],
	dependencies_by_header_row: GlobalDependenciesByHeaderRow,
) -> GlobalDependencyAdjacency:
	empty_module_vertices: Dict[String, Int] = {}
	var pending_vertex_by_module_and_name = empty_module_vertices.repeat(
		index.rows_by_module_and_name.length(),
	)

	for vertex in 0..pending_rows.length():
		match pending_rows.get(vertex):
			Some(header_row):
				match (
					global_header_module_index(index, header_row),
					index.headers.get(header_row),
				):
					(Some(module_index), Some(header)):
						module_vertices = pending_vertex_by_module_and_name.get_or(module_index, {})
						pending_vertex_by_module_and_name = pending_vertex_by_module_and_name.set(
							module_index,
							module_vertices.set(global_id_name(global_header_id(header)), vertex),
						)
					_:
						void
			None:
				void

	var outgoing: Dict[Int, List[Int]] = {}
	var incoming: Dict[Int, List[Int]] = {}

	for owner_vertex in 0..pending_rows.length():
		match pending_rows.get(owner_vertex):
			Some(owner_row):
				for dependency_row in dependencies_by_header_row.get_or(owner_row, []):
					match (
						global_header_module_index(index, dependency_row),
						index.headers.get(dependency_row),
					):
						(Some(module_index), Some(dependency)):
							dependency_vertex = pending_vertex_by_module_and_name
								.get_or(module_index, {})
								.get(global_id_name(global_header_id(dependency)))

							match dependency_vertex:
								Some(vertex):
									outgoing = outgoing.set(
										owner_vertex,
										outgoing
											.get_or(owner_vertex, [])
											.append(vertex),
									)
									incoming = incoming.set(
										vertex,
										incoming
											.get_or(vertex, [])
											.append(owner_vertex),
									)
								None:
									void
						_:
							void
			None:
				void

	{
		pending_rows = pending_rows,
		outgoing = outgoing,
		incoming = incoming
	}


-- The first Kosaraju pass is iterative so a long malformed dependency chain
-- cannot exhaust a compiler fiber stack.
private pure func global_dependency_finish_order(adjacency: GlobalDependencyAdjacency) -> List[Int]:
	var visited: Dict[Int, Bool] = {}
	var finished: List[Int] = []

	for root in 0..adjacency.pending_rows.length():
		if not visited.contains(root):
			visited = visited.set(root, True)
			var stack: List[GlobalDependencyDfsFrame] = [
				{
					vertex = root,
					next_dependency = 0
				},
			]

			while not stack.is_empty():
				frame_index = stack.length() - 1

				match stack.get(frame_index):
					None:
						stack = stack.take(frame_index)
					Some(frame):
						dependencies = adjacency.outgoing.get_or(frame.vertex, [])

						match dependencies.get(frame.next_dependency):
							Some(dependency):
								stack = stack.set(
									frame_index,
									{
										vertex = frame.vertex,
										next_dependency = frame.next_dependency + 1
									},
								)

								if not visited.contains(dependency):
									visited = visited.set(dependency, True)
									stack = stack.append({
										vertex = dependency,
										next_dependency = 0,
									})
							None:
								finished = finished.append(frame.vertex)
								stack = stack.take(frame_index)

	finished


private pure func global_dependency_component_assignments(
	adjacency: GlobalDependencyAdjacency,
	finish_order: List[Int],
) -> Dict[Int, Int]:
	var component_by_vertex: Dict[Int, Int] = {}
	var next_component: Int = 0

	for root in finish_order.reverse():
		if not component_by_vertex.contains(root):
			component_by_vertex = component_by_vertex.set(root, next_component)
			var stack: List[Int] = [root]

			while not stack.is_empty():
				stack_index = stack.length() - 1

				match stack.get(stack_index):
					None:
						stack = stack.take(stack_index)
					Some(vertex):
						stack = stack.take(stack_index)

						for dependency in adjacency.incoming.get_or(vertex, []):
							if not component_by_vertex.contains(dependency):
								component_by_vertex = component_by_vertex.set(
									dependency,
									next_component,
								)
								stack = stack.append(dependency)

			next_component += 1

	component_by_vertex


private pure func cyclic_pending_components(
	index: GlobalHeaderIndex,
	pending_rows: List[Int],
	dependencies_by_header_row: GlobalDependenciesByHeaderRow,
) -> List[List[Int]]:
	adjacency = global_dependency_adjacency(index, pending_rows, dependencies_by_header_row)
	component_by_vertex = global_dependency_component_assignments(
		adjacency,
		global_dependency_finish_order(adjacency),
	)
	var members_by_component: Dict[Int, List[Int]] = {}

	for vertex in 0..adjacency.pending_rows.length():
		match (component_by_vertex.get(vertex), adjacency.pending_rows.get(vertex)):
			(Some(component), Some(header_row)):
				members_by_component = members_by_component.set(
					component,
					members_by_component
						.get_or(component, [])
						.append(header_row),
				)
			_:
				void

	var emitted: Dict[Int, Bool] = {}
	var cyclic: List[List[Int]] = []

	-- Emit components in stable source/global order rather than DFS order.
	for vertex in 0..adjacency.pending_rows.length():
		match component_by_vertex.get(vertex):
			Some(component):
				if not emitted.contains(component):
					emitted = emitted.set(component, True)
					members = members_by_component.get_or(component, [])
					self_cycle = adjacency.outgoing
						.get_or(vertex, [])
						.contains(vertex)

					if members.length() > 1 or self_cycle:
						cyclic = cyclic.append(members)
			None:
				void

	cyclic


private pure func pending_global_dependency_order(
	pending_rows: List[Int],
	adjacency: GlobalDependencyAdjacency,
) -> PendingGlobalOrder:
	var unresolved_dependency_counts: Dict[Int, Int] = {}
	var ready: Heap[Int] = heap()

	for vertex in 0..pending_rows.length():
		dependency_count = adjacency.outgoing
			.get_or(vertex, [])
			.length()
		unresolved_dependency_counts = unresolved_dependency_counts.set(vertex, dependency_count)

		if dependency_count == 0:
			ready = ready.push(vertex)

	var ordered_rows: List[Int] = []
	var complete: Dict[Int, Bool] = {}
	var searching: Bool = True

	while searching:
		match ready.pop():
			None:
				searching = False
			Some(next):
				vertex = next[0]
				ready = next[1]
				complete = complete.set(vertex, True)

				match pending_rows.get(vertex):
					Some(header_row):
						ordered_rows = ordered_rows.append(header_row)
					None:
						void

				for dependent in adjacency.incoming.get_or(vertex, []):
					remaining_count = unresolved_dependency_counts.get_or(dependent, 0) - 1
					unresolved_dependency_counts = unresolved_dependency_counts.set(
						dependent,
						remaining_count,
					)

					if remaining_count == 0:
						ready = ready.push(dependent)

	var remaining_rows: List[Int] = []

	for vertex in 0..pending_rows.length():
		if not complete.contains(vertex):
			match pending_rows.get(vertex):
				Some(header_row):
					remaining_rows = remaining_rows.append(header_row)
				None:
					void

	{
		ordered_rows = ordered_rows,
		remaining_rows = remaining_rows
	}


private pure func global_headers_for_rows(
	index: GlobalHeaderIndex,
	rows: List[Int],
) -> List[GlobalHeader]:
	var headers: List[GlobalHeader] = []

	for row in rows:
		match index.headers.get(row):
			Some(header):
				headers = headers.append(header)
			None:
				void

	headers


private pure func global_ids_for_rows(index: GlobalHeaderIndex, rows: List[Int]) -> List[GlobalId]:
	var ids: List[GlobalId] = []

	for row in rows:
		match index.headers.get(row):
			Some(header):
				ids = ids.append(global_header_id(header))
			None:
				void

	ids


private pure func global_name_membership_for_rows(
	index: GlobalHeaderIndex,
	rows: List[Int],
) -> List[Dict[String, Bool]]:
	empty_module_membership: Dict[String, Bool] = {}
	var membership = empty_module_membership.repeat(index.rows_by_module_and_name.length())

	for row in rows:
		match (global_header_module_index(index, row), index.headers.get(row)):
			(Some(module_index), Some(header)):
				module_membership = membership.get_or(module_index, {})
				membership = membership.set(
					module_index,
					module_membership.set(global_id_name(global_header_id(header)), True),
				)
			_:
				void

	membership


private pure func global_name_membership_contains_row(
	index: GlobalHeaderIndex,
	membership: List[Dict[String, Bool]],
	row: Int,
) -> Bool:
	match (global_header_module_index(index, row), index.headers.get(row)):
		(Some(module_index), Some(header)):
			membership
				.get_or(module_index, {})
				.contains(global_id_name(global_header_id(header)))
		_:
			False


private pure func global_dependency_ids_for_row(
	index: GlobalHeaderIndex,
	dependencies_by_header_row: GlobalDependenciesByHeaderRow,
	header_row: Int,
) -> List[GlobalId]:
	global_ids_for_rows(
		index,
		dependencies_by_header_row.get_or(header_row, []),
	)


private pure func global_dependency_ids_for_rows(
	index: GlobalHeaderIndex,
	dependencies_by_header_row: GlobalDependenciesByHeaderRow,
	rows: List[Int],
) -> List[List[GlobalId]]:
	var dependencies: List[List[GlobalId]] = []

	for row in rows:
		dependencies = dependencies.append(
			global_dependency_ids_for_row(
				index,
				dependencies_by_header_row,
				row,
			),
		)

	dependencies


pure func global_header_completion_plan_build(
	callable_headers: CallableHeaderGraph,
) -> GlobalHeaderCompletionPlanBuild:
	headers = callable_header_graph_globals(callable_headers)
	bound_graph = type_header_graph_bound_graph(
		trait_topology_graph_type_headers(callable_header_graph_trait_topology(callable_headers)),
	)
	index = global_header_index(bound_graph, headers)
	dependencies_by_header_row = global_dependency_rows(bound_graph, index)
	var pending_rows: List[Int] = []
	var annotated_rows: List[Int] = []

	for header_row in 0..headers.length():
		match headers.get(header_row):
			Some(header):
				if annotated_global_header_type(header).is_none():
					pending_rows = pending_rows.append(header_row)
				else:
					annotated_rows = annotated_rows.append(header_row)
			None:
				void

	adjacency = global_dependency_adjacency(index, pending_rows, dependencies_by_header_row)
	order = pending_global_dependency_order(pending_rows, adjacency)

	plan = into_opaque GlobalHeaderCompletionPlan({
			pending_in_dependency_order = global_headers_for_rows(index, order.ordered_rows),
			pending_dependencies_in_order = global_dependency_ids_for_rows(
				index,
				dependencies_by_header_row,
				order.ordered_rows,
			),
			annotated_in_stable_order = global_headers_for_rows(index, annotated_rows),
			annotated_dependencies_in_stable_order = global_dependency_ids_for_rows(
				index,
				dependencies_by_header_row,
				annotated_rows,
			)
		})

	if not order.remaining_rows.is_empty():
		cyclic_row_components = cyclic_pending_components(
			index,
			order.remaining_rows,
			dependencies_by_header_row,
		)
		cyclic_rows = cyclic_row_components.flat_map(func(component): component)
		cyclic_membership = global_name_membership_for_rows(index, cyclic_rows)

		var blocked_rows: List[Int] = []

		for row in order.remaining_rows:
			if not global_name_membership_contains_row(index, cyclic_membership, row):
				blocked_rows = blocked_rows.append(row)

		cyclic_components = cyclic_row_components.map(
			func(component): global_ids_for_rows(index, component),
		)
		GlobalHeaderCompletionPlanBlocked(
			plan,
			cyclic_components,
			global_ids_for_rows(index, blocked_rows),
		)
	else:
		GlobalHeaderCompletionPlanReady(plan)


pure func global_header_completion_plan_pending(
	plan: GlobalHeaderCompletionPlan,
) -> List[GlobalHeader]:
	from_opaque GlobalHeaderCompletionPlan(plan).pending_in_dependency_order


pure func global_header_completion_plan_annotated(
	plan: GlobalHeaderCompletionPlan,
) -> List[GlobalHeader]:
	from_opaque GlobalHeaderCompletionPlan(plan).annotated_in_stable_order


pure func global_header_completion_plan_pending_dependencies(
	plan: GlobalHeaderCompletionPlan,
) -> List[List[GlobalId]]:
	from_opaque GlobalHeaderCompletionPlan(plan).pending_dependencies_in_order


pure func global_header_completion_plan_annotated_dependencies(
	plan: GlobalHeaderCompletionPlan,
) -> List[List[GlobalId]]:
	from_opaque GlobalHeaderCompletionPlan(plan).annotated_dependencies_in_stable_order
