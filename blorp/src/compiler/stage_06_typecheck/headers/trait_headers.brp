-- Exact-ID trait topology accepted before callable signatures are resolved.
--
-- The graph owns trait inheritance, trait type-parameter bounds, and method
-- slots. Parsed spellings remain only as source provenance; every semantic
-- edge is an exact skeleton identity, and construction rejects unresolved or
-- cyclic topology atomically.
import:
	../../../lib/source: SourceSpan
	../../stage_03_parse/parsed_ast: ParsedIdentifier, ParsedTraitMethodDecl, ParsedTypeParamDecl
	../../stage_04_modules/loaded_module: module_identity_display_name
	../type_system/builtins: builtin_trait_supertraits, builtin_trait_topology_is_acyclic
	../modules/bound_module_graph:
		BoundModule,
		BoundModuleGraph,
		bound_module_graph_find,
		bound_module_identity,
	callable_signature:
		CallableParameter,
		CallableSignature,
		callable_parameter_binder_from_parsed,
		callable_signature,
	declaration_skeleton:
		DeclarationSkeletonGraph,
		DeclarationVisibility,
		TraitDeclarationSkeletonInfo,
		TraitId,
		TraitMethodDeclarationSkeletonInfo,
		TraitMethodId,
		builtin_trait_id,
		declaration_skeleton_graph_trait_method_skeletons,
		declaration_skeleton_graph_trait_skeletons,
		trait_id_definition_id,
		trait_id_is_compiler_builtin,
		trait_id_module_identity,
		trait_id_name,
		trait_id_source_span,
		trait_ids_equal,
		trait_method_id_index,
		trait_method_id_name,
		trait_method_id_owner,
		trait_method_ids_equal,
	trait_reference_resolution: resolve_visible_trait_id
	type_header_graph:
		IntrinsicType(IntrinsicVoid),
		ResolvedTypeShape(IntrinsicTypeShape),
		TraitTypeParameterId,
		TypeHeaderGraph,
		TypeShapeResolutionError,
		resolve_trait_method_type_shape,
		trait_type_parameter_id_name,
		trait_type_parameter_id_owner,
		trait_type_parameter_ids,
		type_header_graph_bound_graph,
		type_header_graph_declaration_graph,
		type_shape_resolution_error_message,
		type_shape_resolution_error_span,


enum TraitMethodCategory:
	RequiredTraitMethod
	DefaultTraitMethod


private record ResolvedTraitTypeParameterRep {
	id: TraitTypeParameterId,
	bounds: List[TraitId]
}


opaque type ResolvedTraitTypeParameter = ResolvedTraitTypeParameterRep


private record TraitMethodSlotRep {
	id: TraitMethodId,
	category: TraitMethodCategory,
	signature: CallableSignature,
	source: ParsedTraitMethodDecl
}


opaque type TraitMethodSlot = TraitMethodSlotRep


private record ResolvedSupertrait {
	id: TraitId,
	source: ParsedIdentifier
}


private record TraitTopologyHeaderRep {
	id: TraitId,
	visibility: DeclarationVisibility,
	parameters: List[ResolvedTraitTypeParameter],
	supertraits: List[ResolvedSupertrait],
	methods: List[TraitMethodSlot]
}


opaque type TraitTopologyHeader = TraitTopologyHeaderRep


-- Source skeleton IDs share the definition index's graph-wide allocation
-- frontier. Exact identity comparison still validates every indexed read.
private record TraitTopologyTable {
	headers: List[TraitTopologyHeader],
	header_index_by_definition_id: Dict[Int, Int]
}


private record TraitTopologyGraphRep {
	type_header_graph: TypeHeaderGraph,
	table: TraitTopologyTable
}


opaque type TraitTopologyGraph = TraitTopologyGraphRep


union TraitTopologyGraphError:
	BuiltinTraitTopologyCycle
	TraitOwnerModuleMissing(TraitId)
	TraitUnknownSupertrait(TraitId, ParsedIdentifier)
	TraitDuplicateSupertrait(TraitId, TraitId, ParsedIdentifier)
	TraitDuplicateTypeParameter(TraitId, ParsedIdentifier)
	TraitTypeParameterUnknownBound(TraitId, ParsedIdentifier, ParsedIdentifier)
	TraitMethodMissingParameterType(TraitMethodId, Int, SourceSpan)
	TraitMethodTypeResolutionError(TypeShapeResolutionError)
	TraitDuplicateMethod(TraitId, ParsedIdentifier)
	TraitInheritanceCycle(List[TraitId], ParsedIdentifier)


private record TraitTopologyBuildState {
	headers: List[TraitTopologyHeader],
	header_index_by_definition_id: Dict[Int, Int],
	errors: List[TraitTopologyGraphError]
}


private type alias TraitMethodSkeletonBuckets = Dict[Int, List[TraitMethodDeclarationSkeletonInfo]]


private enum TraitVisitState:
	TraitUnvisited
	TraitVisiting
	TraitComplete


private struct TraitVisitFrame {
	header_index: Int,
	next_supertrait_index: Int
}


pure func trait_type_parameter_owner(parameter: ResolvedTraitTypeParameter) -> TraitId:
	trait_type_parameter_id_owner(from_opaque ResolvedTraitTypeParameter(parameter).id)


pure func trait_type_parameter_name(parameter: ResolvedTraitTypeParameter) -> String:
	trait_type_parameter_id_name(from_opaque ResolvedTraitTypeParameter(parameter).id)


pure func trait_type_parameter_bounds(parameter: ResolvedTraitTypeParameter) -> List[TraitId]:
	from_opaque ResolvedTraitTypeParameter(parameter).bounds


pure func trait_method_slot_owner(slot: TraitMethodSlot) -> TraitId:
	trait_method_id_owner(from_opaque TraitMethodSlot(slot).id)


pure func trait_method_slot_id(slot: TraitMethodSlot) -> TraitMethodId:
	from_opaque TraitMethodSlot(slot).id


pure func trait_method_slot_name(slot: TraitMethodSlot) -> String:
	trait_method_id_name(from_opaque TraitMethodSlot(slot).id)


pure func trait_method_slot_category(slot: TraitMethodSlot) -> TraitMethodCategory:
	from_opaque TraitMethodSlot(slot).category


pure func trait_method_slot_signature(slot: TraitMethodSlot) -> CallableSignature:
	from_opaque TraitMethodSlot(slot).signature


pure func trait_method_slot_source(slot: TraitMethodSlot) -> ParsedTraitMethodDecl:
	from_opaque TraitMethodSlot(slot).source


pure func trait_topology_header_id(header: TraitTopologyHeader) -> TraitId:
	from_opaque TraitTopologyHeader(header).id


pure func trait_topology_header_visibility(header: TraitTopologyHeader) -> DeclarationVisibility:
	from_opaque TraitTopologyHeader(header).visibility


pure func trait_topology_header_parameters(
	header: TraitTopologyHeader,
) -> List[ResolvedTraitTypeParameter]:
	from_opaque TraitTopologyHeader(header).parameters


pure func trait_topology_header_supertraits(header: TraitTopologyHeader) -> List[TraitId]:
	from_opaque TraitTopologyHeader(header).supertraits.map(func(edge): edge.id)


private pure func trait_topology_header_supertrait_edges(
	header: TraitTopologyHeader,
) -> List[ResolvedSupertrait]:
	from_opaque TraitTopologyHeader(header).supertraits


pure func trait_topology_header_methods(header: TraitTopologyHeader) -> List[TraitMethodSlot]:
	from_opaque TraitTopologyHeader(header).methods


private pure func trait_topology_table_find(
	table: TraitTopologyTable,
	id: TraitId,
) -> Option[TraitTopologyHeader]:
	index ?= table.header_index_by_definition_id.get(trait_id_definition_id(id))
	header ?= table.headers.get(index)

	if trait_ids_equal(trait_topology_header_id(header), id):
		Some(header)
	else:
		None


private pure func trait_topology_table_find_index(
	table: TraitTopologyTable,
	id: TraitId,
) -> Option[Int]:
	index ?= table.header_index_by_definition_id.get(trait_id_definition_id(id))
	header ?= table.headers.get(index)

	if trait_ids_equal(trait_topology_header_id(header), id):
		Some(index)
	else:
		None


private pure func resolve_trait_id_list(
	state: TraitTopologyBuildState,
	declaration_graph: DeclarationSkeletonGraph,
	bound_graph: BoundModuleGraph,
	module: BoundModule,
	owner: TraitId,
	names: List[ParsedIdentifier],
) -> (TraitTopologyBuildState, List[ResolvedSupertrait]):
	var next = state
	var edges: List[ResolvedSupertrait] = []

	for name in names:
		match resolve_visible_trait_id(declaration_graph, bound_graph, module, name.text):
			None:
				next = { next | errors = next.errors.append(TraitUnknownSupertrait(owner, name)) }
			Some(id):
				if edges.any(func(edge): trait_ids_equal(edge.id, id)):
					next = { next |
						errors = next.errors.append(TraitDuplicateSupertrait(owner, id, name))
					}
				else:
					edges = edges.append({
						id = id,
						source = name,
					})

	(next, edges)


private pure func resolve_trait_type_parameters(
	declaration_graph: DeclarationSkeletonGraph,
	bound_graph: BoundModuleGraph,
	module: BoundModule,
	owner: TraitId,
	parsed_parameters: List[ParsedTypeParamDecl],
) -> Result[List[ResolvedTraitTypeParameter], List[TraitTopologyGraphError]]:
	var parameters: List[ResolvedTraitTypeParameter] = []
	var errors: List[TraitTopologyGraphError] = []
	parameter_ids = trait_type_parameter_ids(
		owner,
		parsed_parameters.map(func(parameter): parameter.name.text),
	)

	for parameter_pair in parsed_parameters.zip(parameter_ids):
		parsed_parameter = parameter_pair[0]
		parameter_id = parameter_pair[1]
		var bounds: List[TraitId] = []

		if parameters.any(
			func(parameter): trait_type_parameter_name(parameter) == parsed_parameter.name.text,
		):
			errors = errors.append(TraitDuplicateTypeParameter(owner, parsed_parameter.name))

		for parsed_bound in parsed_parameter.bounds:
			match resolve_visible_trait_id(
				declaration_graph,
				bound_graph,
				module,
				parsed_bound.text,
			):
				None:
					errors = errors.append(
						TraitTypeParameterUnknownBound(
							owner,
							parsed_parameter.name,
							parsed_bound,
						),
					)
				Some(bound_id):
					if not bounds.any(func(existing): trait_ids_equal(existing, bound_id)):
						bounds = bounds.append(bound_id)

		parameter: ResolvedTraitTypeParameter = into_opaque ResolvedTraitTypeParameter({
				id = parameter_id,
				bounds = bounds
			})
		parameters = parameters.append(parameter)

	if errors.is_empty():
		Ok(parameters)
	else:
		Err(errors)


private pure func method_skeleton_buckets(
	method_skeletons: List[TraitMethodDeclarationSkeletonInfo],
) -> TraitMethodSkeletonBuckets:
	var buckets: TraitMethodSkeletonBuckets = {}

	for method in method_skeletons:
		key = trait_id_definition_id(trait_method_id_owner(method.id))
		buckets = buckets.set(
			key,
			buckets
				.get_or(key, [])
				.append(method),
		)

	buckets


private pure func method_skeletons_for_owner(
	method_skeletons_by_owner_id: TraitMethodSkeletonBuckets,
	owner: TraitId,
) -> List[TraitMethodDeclarationSkeletonInfo]:
	method_skeletons_by_owner_id
		.get_or(trait_id_definition_id(owner), [])
		.filter(func(method): trait_ids_equal(trait_method_id_owner(method.id), owner))


private pure func resolved_trait_type_parameter_id(
	parameter: ResolvedTraitTypeParameter,
) -> TraitTypeParameterId:
	from_opaque ResolvedTraitTypeParameter(parameter).id


private pure func resolve_trait_method_signature(
	type_header_graph: TypeHeaderGraph,
	parameters: List[ResolvedTraitTypeParameter],
	method: TraitMethodDeclarationSkeletonInfo,
) -> Result[CallableSignature, List[TraitTopologyGraphError]]:
	parameter_ids = parameters.map(resolved_trait_type_parameter_id)
	var resolved_parameters: List[CallableParameter] = []
	var errors: List[TraitTopologyGraphError] = []
	var parameter_index: Int = 0

	for param in method.source.params:
		match param.type_expr:
			None:
				errors = errors.append(
					TraitMethodMissingParameterType(
						method.id,
						parameter_index,
						param.span,
					),
				)
			Some(type_expr):
				match resolve_trait_method_type_shape(
					type_header_graph,
					method.id,
					parameter_ids,
					type_expr,
				):
					Ok(typ):
						resolved_parameter = {
							binder = callable_parameter_binder_from_parsed(param),
							typ = typ
						}
						resolved_parameters = resolved_parameters.append(resolved_parameter)
					Err(resolution_errors):
						for error in resolution_errors:
							method_error: TraitTopologyGraphError = TraitMethodTypeResolutionError(
								error,
							)
							errors = errors.append(method_error)

		parameter_index += 1

	var return_type: ResolvedTypeShape = IntrinsicTypeShape(IntrinsicVoid, [])

	match method.source.return_type:
		None:
			void
		Some(type_expr):
			match resolve_trait_method_type_shape(
				type_header_graph,
				method.id,
				parameter_ids,
				type_expr,
			):
				Ok(typ):
					return_type = typ
				Err(resolution_errors):
					for error in resolution_errors:
						method_error: TraitTopologyGraphError = TraitMethodTypeResolutionError(
							error,
						)
						errors = errors.append(method_error)

	if errors.is_empty():
		Ok(callable_signature(resolved_parameters, return_type, method.source.is_pure))
	else:
		Err(errors)


private pure func resolve_trait_method_slots(
	state: TraitTopologyBuildState,
	type_header_graph: TypeHeaderGraph,
	owner: TraitId,
	parameters: List[ResolvedTraitTypeParameter],
	method_skeletons_by_owner_id: TraitMethodSkeletonBuckets,
) -> (TraitTopologyBuildState, List[TraitMethodSlot]):
	var next = state
	var names: List[String] = []
	var slots: List[TraitMethodSlot] = []

	for method in method_skeletons_for_owner(method_skeletons_by_owner_id, owner):
		name = method.source.name.text

		if names.contains(name):
			next = { next |
				errors = next.errors.append(TraitDuplicateMethod(owner, method.source.name))
			}
		else:
			names = names.append(name)

		category = if method.source.body.is_some():
			DefaultTraitMethod
		else:
			RequiredTraitMethod

		match resolve_trait_method_signature(type_header_graph, parameters, method):
			Ok(signature):
				slot: TraitMethodSlot = into_opaque TraitMethodSlot({
						id = method.id,
						category = category,
						signature = signature,
						source = method.source
					})
				slots = slots.append(slot)
			Err(signature_errors):
				next = { next | errors = next.errors.concat(signature_errors) }

	(next, slots)


private pure func append_trait_topology_header(
	state: TraitTopologyBuildState,
	type_header_graph: TypeHeaderGraph,
	declaration_graph: DeclarationSkeletonGraph,
	bound_graph: BoundModuleGraph,
	method_skeletons_by_owner_id: TraitMethodSkeletonBuckets,
	skeleton: TraitDeclarationSkeletonInfo,
) -> TraitTopologyBuildState:
	match bound_module_graph_find(bound_graph, trait_id_module_identity(skeleton.id)):
		None:
			{ state | errors = state.errors.append(TraitOwnerModuleMissing(skeleton.id)) }
		Some(module):
			(with_supertraits, supertraits) = resolve_trait_id_list(
				state,
				declaration_graph,
				bound_graph,
				module,
				skeleton.id,
				skeleton.source.supertraits,
			)
			parameter_resolution = resolve_trait_type_parameters(
				declaration_graph,
				bound_graph,
				module,
				skeleton.id,
				skeleton.source.type_params,
			)
			var with_parameters = with_supertraits
			var parameters: List[ResolvedTraitTypeParameter] = []

			match parameter_resolution:
				Ok(resolved_parameters):
					parameters = resolved_parameters
				Err(parameter_errors):
					with_parameters = { with_parameters |
						errors = with_parameters.errors.concat(parameter_errors)
					}

			(with_methods, methods) = resolve_trait_method_slots(
				with_parameters,
				type_header_graph,
				skeleton.id,
				parameters,
				method_skeletons_by_owner_id,
			)
			header: TraitTopologyHeader = into_opaque TraitTopologyHeader({
					id = skeleton.id,
					visibility = skeleton.visibility,
					parameters = parameters,
					supertraits = supertraits,
					methods = methods
				})
			header_index = with_methods.headers.length()
			definition_id = trait_id_definition_id(skeleton.id)
			{ with_methods |
				headers = with_methods.headers.append(header),
				header_index_by_definition_id = with_methods.header_index_by_definition_id.set(
					definition_id,
					header_index,
				)
			}


private pure func trait_cycle_from_stack(
	table: TraitTopologyTable,
	stack: List[TraitVisitFrame],
	target_index: Int,
) -> List[TraitId]:
	var cycle: List[TraitId] = []
	var inside_cycle: Bool = False

	for frame in stack:
		if frame.header_index == target_index:
			inside_cycle = True

		if inside_cycle:
			match table.headers.get(frame.header_index):
				Some(header):
					cycle = cycle.append(trait_topology_header_id(header))
				None:
					void

	match table.headers.get(target_index):
		Some(header):
			cycle.append(trait_topology_header_id(header))
		None:
			cycle


private pure func trait_topology_cycle(
	table: TraitTopologyTable,
) -> Option[(List[TraitId], ParsedIdentifier)]:
	var states: List[TraitVisitState] = []
	var cycle: Option[(List[TraitId], ParsedIdentifier)] = None

	for _ in table.headers:
		states = states.append(TraitUnvisited)

	for start_index in 0..table.headers.length():
		if states.get(start_index) == Some(TraitUnvisited):
			states = states.set(start_index, TraitVisiting)
			var stack: List[TraitVisitFrame] = [
				{
					header_index = start_index,
					next_supertrait_index = 0
				},
			]

			while not stack.is_empty() and cycle.is_none():
				frame_index = stack.length() - 1

				match stack.get(frame_index):
					Some(frame):
						match table.headers.get(frame.header_index):
							Some(header):
								supertraits = trait_topology_header_supertrait_edges(header)

								match supertraits.get(frame.next_supertrait_index):
									Some(supertrait):
										stack = stack.set(
											frame_index,
											{
												header_index = frame.header_index,
												next_supertrait_index = frame.next_supertrait_index + 1
											},
										)

										match trait_topology_table_find_index(table, supertrait.id):
											None:
												void
											Some(target_index):
												match states.get(target_index):
													Some(TraitVisiting):
														cycle = Some(
															(
																trait_cycle_from_stack(
																	table,
																	stack,
																	target_index,
																),
																supertrait.source,
															),
														)
													Some(TraitUnvisited):
														states = states.set(
															target_index,
															TraitVisiting,
														)
														stack = stack.append({
															header_index = target_index,
															next_supertrait_index = 0,
														})
													_:
														void
									None:
										states = states.set(frame.header_index, TraitComplete)
										stack = stack.drop_last()
							None:
								stack = stack.drop_last()
					None:
						stack = stack.drop_last()

		if cycle.is_some():
			break

	cycle


pure func trait_topology_graph_build(
	type_header_graph: TypeHeaderGraph,
) -> Result[TraitTopologyGraph, List[TraitTopologyGraphError]]:
	declaration_graph = type_header_graph_declaration_graph(type_header_graph)
	bound_graph = type_header_graph_bound_graph(type_header_graph)
	method_skeletons_by_owner_id = method_skeleton_buckets(
		declaration_skeleton_graph_trait_method_skeletons(declaration_graph),
	)

	initial_errors: List[TraitTopologyGraphError] = if builtin_trait_topology_is_acyclic():
		[]
	else:
		[BuiltinTraitTopologyCycle]

	var state: TraitTopologyBuildState = {
		headers = [],
		header_index_by_definition_id = {},
		errors = initial_errors
	}

	for skeleton in declaration_skeleton_graph_trait_skeletons(declaration_graph):
		state = append_trait_topology_header(
			state,
			type_header_graph,
			declaration_graph,
			bound_graph,
			method_skeletons_by_owner_id,
			skeleton,
		)

	if not state.errors.is_empty():
		Err(state.errors)
	else:
		table: TraitTopologyTable = {
			headers = state.headers,
			header_index_by_definition_id = state.header_index_by_definition_id
		}

		match trait_topology_cycle(table):
			Some((cycle, closing_reference)):
				Err([TraitInheritanceCycle(cycle, closing_reference)])
			None:
				representation: TraitTopologyGraphRep = {
					type_header_graph = type_header_graph,
					table = table
				}
				Ok(into_opaque TraitTopologyGraph(representation))


private pure func trait_topology_graph_rep(graph: TraitTopologyGraph) -> TraitTopologyGraphRep:
	from_opaque TraitTopologyGraph(graph)


pure func trait_topology_graph_type_headers(graph: TraitTopologyGraph) -> TypeHeaderGraph:
	trait_topology_graph_rep(graph).type_header_graph


pure func trait_topology_graph_headers(graph: TraitTopologyGraph) -> List[TraitTopologyHeader]:
	trait_topology_graph_rep(graph).table.headers


pure func trait_topology_graph_find(
	graph: TraitTopologyGraph,
	id: TraitId,
) -> Option[TraitTopologyHeader]:
	trait_topology_table_find(trait_topology_graph_rep(graph).table, id)


pure func trait_topology_graph_find_definition_id(
	graph: TraitTopologyGraph,
	definition_id: Int,
) -> Option[TraitTopologyHeader]:
	table = trait_topology_graph_rep(graph).table
	index ?= table.header_index_by_definition_id.get(definition_id)
	header ?= table.headers.get(index)

	if trait_id_definition_id(trait_topology_header_id(header)) == definition_id:
		Some(header)
	else:
		None


pure func trait_topology_graph_find_method(
	graph: TraitTopologyGraph,
	id: TraitMethodId,
) -> Option[TraitMethodSlot]:
	header ?= trait_topology_graph_find(graph, trait_method_id_owner(id))
	method ?= trait_topology_header_methods(header).get(trait_method_id_index(id))

	if trait_method_ids_equal(trait_method_slot_id(method), id):
		Some(method)
	else:
		None


private pure func builtin_supertrait_ids(id: TraitId) -> Option[List[TraitId]]:
	if not trait_id_is_compiler_builtin(id):
		None
	else:
		names ?= builtin_trait_supertraits(trait_id_name(id))
		var ids: List[TraitId] = []
		var complete: Bool = True

		for name in names:
			match builtin_trait_id(name):
				Some(supertrait_id):
					ids = ids.append(supertrait_id)
				None:
					complete = False

		if complete:
			Some(ids)
		else:
			None


private pure func trait_topology_graph_direct_supertraits(
	graph: TraitTopologyGraph,
	id: TraitId,
) -> Option[List[TraitId]]:
	match trait_topology_graph_find(graph, id):
		Some(header):
			Some(trait_topology_header_supertraits(header))
		None:
			builtin_supertrait_ids(id)


pure func trait_topology_graph_transitive_supertraits(
	graph: TraitTopologyGraph,
	id: TraitId,
) -> Option[List[TraitId]]:
	direct_supertraits ?= trait_topology_graph_direct_supertraits(graph, id)
	var result: List[TraitId] = []
	var pending: List[TraitId] = direct_supertraits.reverse()
	var complete: Bool = True

	while not pending.is_empty() and complete:
		match pending.last():
			Some(next_id):
				pending = pending.drop_last()

				if trait_ids_equal(next_id, id):
					complete = False
				else if not result.any(func(existing): trait_ids_equal(existing, next_id)):
					result = result.append(next_id)

					match trait_topology_graph_direct_supertraits(graph, next_id):
						Some(supertraits):
							for supertrait in supertraits.reverse():
								pending = pending.append(supertrait)
						None:
							complete = False
			None:
				void

	if complete:
		Some(result)
	else:
		None


pure func trait_topology_graph_error_message(error: TraitTopologyGraphError) -> String:
	match error:
		BuiltinTraitTopologyCycle:
			"compiler builtin trait inheritance contains a cycle"
		TraitOwnerModuleMissing(id):
			"trait '" + trait_id_name(
				id,
			) + "' has no bound owner module '" + module_identity_display_name(
				trait_id_module_identity(id),
			) + "'"
		TraitUnknownSupertrait(id, name):
			"trait '" + trait_id_name(id) + "' has unknown supertrait '" + name.text + "'"
		TraitDuplicateSupertrait(id, supertrait_id, _):
			"trait '" + trait_id_name(
				id,
			) + "' names supertrait '" + trait_id_name(supertrait_id) + "' more than once"
		TraitDuplicateTypeParameter(id, name):
			"trait '" + trait_id_name(
				id,
			) + "' declares type parameter '" + name.text + "' more than once"
		TraitTypeParameterUnknownBound(id, parameter_name, bound_name):
			"trait '" + trait_id_name(
				id,
			) + "' type parameter '" + parameter_name.text + "' has unknown bound '" + bound_name.text + "'"
		TraitMethodMissingParameterType(method_id, parameter_index, _):
			"trait method '" + trait_method_id_name(
				method_id,
			) + "' parameter " + (parameter_index + 1).to_string() + " must have an explicit type"
		TraitMethodTypeResolutionError(resolution_error):
			type_shape_resolution_error_message(resolution_error)
		TraitDuplicateMethod(id, name):
			"trait '" + trait_id_name(id) + "' declares method '" + name.text + "' more than once"
		TraitInheritanceCycle(cycle, _):
			"trait inheritance cycle: " + cycle
				.map(trait_id_name)
				.join(" -> ")


pure func trait_topology_graph_error_span(error: TraitTopologyGraphError) -> Option[SourceSpan]:
	match error:
		BuiltinTraitTopologyCycle:
			None
		TraitOwnerModuleMissing(id):
			Some(trait_id_source_span(id))
		TraitUnknownSupertrait(_, name):
			Some(name.span)
		TraitDuplicateSupertrait(_, _, name):
			Some(name.span)
		TraitDuplicateTypeParameter(_, name):
			Some(name.span)
		TraitTypeParameterUnknownBound(_, _, bound_name):
			Some(bound_name.span)
		TraitMethodMissingParameterType(_, _, span):
			Some(span)
		TraitMethodTypeResolutionError(resolution_error):
			Some(type_shape_resolution_error_span(resolution_error))
		TraitDuplicateMethod(_, name):
			Some(name.span)
		TraitInheritanceCycle(_, closing_reference):
			Some(closing_reference.span)
