-- Definition-local dependencies needed before semantic type headers resolve.
-- The graph resolves local, selective, and qualified alias references to exact
-- type identities, then exposes a distinct acyclic product to header building.
import:
	../../stage_03_parse/parsed_ast:
		ParsedDecl(PrivateParsedDecl, TypeAliasParsedDecl),
		ParsedTypeAliasDecl,
		ParsedTypeExpr(
			ParsedArrayType,
			ParsedBoundedType,
			ParsedDimBinaryType,
			ParsedDimLiteralType,
			ParsedDimNameType,
			ParsedFunctionType,
			ParsedMissingType,
			ParsedNamedType,
			ParsedQualifiedNamedType,
			ParsedRangeType,
			ParsedTupleType,
		),
	../../stage_04_modules/loaded_module:
		ModuleIdentity,
		module_identities_equal,
		module_identity_display_name,
	../modules/bound_module_graph:
		BoundModule,
		BoundModuleGraph,
		bound_module_graph_find,
		bound_module_graph_find_canonical_path,
		bound_module_identity,
		bound_module_view,
	../modules/module_view:
		ModuleView,
		module_view_find_imported_name,
		module_view_find_module_alias,
	../types: type_param_names
	declaration_skeleton:
		DeclarationSkeletonGraph,
		TypeDeclarationSkeletonInfo,
		TypeDeclarationSource(AliasTypeSource),
		TypeId,
		declaration_skeleton_graph_bound_graph,
		declaration_skeleton_graph_find_type,
		declaration_skeleton_graph_type_skeletons,
		type_id_module_identity,
		type_id_name,
		type_ids_equal,


record LocalTypeAliasDependency {
	name: String,
	dependencies: List[String]
}


private record LocalTypeAliasDependencyGraphRep {
	nodes: List[LocalTypeAliasDependency],
	node_indices_by_name: Dict[String, Int]
}


opaque type LocalTypeAliasDependencyGraph = LocalTypeAliasDependencyGraphRep


private enum TypeAliasVisitState:
	TypeAliasUnvisited
	TypeAliasVisiting
	TypeAliasComplete


private record TypeAliasCycleSearchState {
	visit_states: List[TypeAliasVisitState],
	path: List[String]
}


private union TypeAliasCycleSearchResult:
	TypeAliasSearchContinues(TypeAliasCycleSearchState)
	TypeAliasCycleFound(List[String])


private union ParsedTypeReference:
	UnqualifiedTypeReference(String)
	QualifiedTypeReference(String, String)


union TypeAliasCycleCheck:
	TypeAliasesAcyclic
	TypeAliasCycle(List[String])


private pure func append_unique_names(existing: List[String], names: List[String]) -> List[String]:
	var result = existing

	for name in names:
		if not result.contains(name):
			result = result.append(name)

	result


private pure func parsed_type_references_equal(
	left: ParsedTypeReference,
	right: ParsedTypeReference,
) -> Bool:
	match (left, right):
		(UnqualifiedTypeReference(left_name), UnqualifiedTypeReference(right_name)):
			left_name == right_name
		(QualifiedTypeReference(left_qualifier, left_name), QualifiedTypeReference(right_qualifier, right_name)):
			left_qualifier == right_qualifier and left_name == right_name
		_:
			False


private pure func append_unique_type_reference(
	existing: List[ParsedTypeReference],
	reference: ParsedTypeReference,
) -> List[ParsedTypeReference]:
	if existing.any(func(item): parsed_type_references_equal(item, reference)):
		existing
	else:
		existing.append(reference)


private pure func append_unique_type_references(
	existing: List[ParsedTypeReference],
	references: List[ParsedTypeReference],
) -> List[ParsedTypeReference]:
	var result = existing

	for reference in references:
		result = append_unique_type_reference(result, reference)

	result


private pure func type_expr_references(type_expr: ParsedTypeExpr) -> List[ParsedTypeReference]:
	match type_expr:
		ParsedNamedType(name, args, _):
			var references: List[ParsedTypeReference] = [UnqualifiedTypeReference(name.text)]

			for arg in args:
				references = append_unique_type_references(references, type_expr_references(arg))

			references
		ParsedQualifiedNamedType(qualifier, name, args, _):
			var references: List[ParsedTypeReference] = [
				QualifiedTypeReference(qualifier.text, name.text),
			]

			for arg in args:
				references = append_unique_type_references(references, type_expr_references(arg))

			references
		ParsedDimBinaryType(_, left, right, _):
			append_unique_type_references(type_expr_references(left), type_expr_references(right))
		ParsedRangeType(inner, _):
			type_expr_references(inner)
		ParsedTupleType(elements, _):
			var references: List[ParsedTypeReference] = []

			for element in elements:
				references = append_unique_type_references(
					references,
					type_expr_references(element),
				)

			references
		ParsedFunctionType(_, params, return_type, _):
			var references: List[ParsedTypeReference] = []

			for param in params:
				references = append_unique_type_references(references, type_expr_references(param))

			append_unique_type_references(references, type_expr_references(return_type))
		ParsedArrayType(element, dims, _):
			var references = type_expr_references(element)

			for dim in dims:
				references = append_unique_type_references(references, type_expr_references(dim))

			references
		ParsedBoundedType(_, _, _):
			[]
		ParsedDimNameType(_, _, _):
			[]
		ParsedDimLiteralType(_, _):
			[]
		ParsedMissingType(_):
			[]


private pure func local_alias_dependencies(
	type_expr: ParsedTypeExpr,
	alias_names: Dict[String, Bool],
	type_param_names: List[String],
) -> List[String]:
	var dependencies: List[String] = []

	for reference in type_expr_references(type_expr):
		match reference:
			UnqualifiedTypeReference(name):
				if alias_names.contains(name) and not type_param_names.contains(name):
					dependencies = append_unique_names(dependencies, [name])
			QualifiedTypeReference(_, _):
				void

	dependencies


private pure func alias_decls_in_decl(decl: ParsedDecl) -> List[ParsedTypeAliasDecl]:
	match decl:
		TypeAliasParsedDecl(alias_decl):
			[alias_decl]
		PrivateParsedDecl(inner, _):
			alias_decls_in_decl(inner)
		_:
			[]


pure func local_type_alias_dependency_graph_build(
	decls: List[ParsedDecl],
) -> LocalTypeAliasDependencyGraph:
	alias_decls = decls.flat_map(alias_decls_in_decl)
	var alias_names: Dict[String, Bool] = {}

	for alias_decl in alias_decls:
		alias_names = alias_names.set(alias_decl.name.text, True)

	var nodes: List[LocalTypeAliasDependency] = []
	var node_indices_by_name: Dict[String, Int] = {}

	for alias_decl in alias_decls:
		name = alias_decl.name.text

		if not node_indices_by_name.contains(name):
			node_indices_by_name = node_indices_by_name.set(name, nodes.length())
			nodes = nodes.append({
				name = name,
				dependencies = local_alias_dependencies(
					alias_decl.target,
					alias_names,
					type_param_names(alias_decl.type_params),
				),
			})

	representation: LocalTypeAliasDependencyGraphRep = {
		nodes = nodes,
		node_indices_by_name = node_indices_by_name
	}
	into LocalTypeAliasDependencyGraph(representation)


private pure func local_type_alias_dependency_graph_rep(
	graph: LocalTypeAliasDependencyGraph,
) -> LocalTypeAliasDependencyGraphRep:
	from LocalTypeAliasDependencyGraph(graph)


pure func local_type_alias_dependency_graph_nodes(
	graph: LocalTypeAliasDependencyGraph,
) -> List[LocalTypeAliasDependency]:
	local_type_alias_dependency_graph_rep(graph).nodes


private pure func alias_cycle_from_path(path: List[String], repeated_name: String) -> List[String]:
	start_index = path
		.index_of(repeated_name)
		.get_or(0)
	var cycle: List[String] = []
	var index = start_index

	while index < path.length():
		cycle = cycle.append(path.get_or(index, repeated_name))
		index += 1

	cycle.append(repeated_name)


private pure func search_alias_cycle_from(
	graph: LocalTypeAliasDependencyGraphRep,
	node_index: Int,
	state: TypeAliasCycleSearchState,
) -> TypeAliasCycleSearchResult:
	node = graph.nodes.get_or(
		node_index,
		{
			name = "",
			dependencies = []
		},
	)
	var next: TypeAliasCycleSearchState = {
		visit_states = state.visit_states.set(node_index, TypeAliasVisiting),
		path = state.path.append(node.name)
	}
	var found_cycle: Option[List[String]] = None

	for dependency in node.dependencies:
		if found_cycle.is_none():
			match graph.node_indices_by_name.get(dependency):
				None:
					void
				Some(dependency_index):
					match next.visit_states.get_or(dependency_index, TypeAliasUnvisited):
						TypeAliasVisiting:
							found_cycle = Some(alias_cycle_from_path(next.path, dependency))
						TypeAliasUnvisited:
							match search_alias_cycle_from(graph, dependency_index, next):
								TypeAliasCycleFound(cycle):
									found_cycle = Some(cycle)
								TypeAliasSearchContinues(updated):
									next = updated
						TypeAliasComplete:
							void

	match found_cycle:
		Some(cycle):
			TypeAliasCycleFound(cycle)
		None:
			TypeAliasSearchContinues({
				visit_states = next.visit_states.set(node_index, TypeAliasComplete),
				path = next.path.take(next.path.length() - 1),
			})


pure func local_type_alias_dependency_graph_check_cycles(
	graph: LocalTypeAliasDependencyGraph,
) -> TypeAliasCycleCheck:
	representation = local_type_alias_dependency_graph_rep(graph)
	var visit_states: List[TypeAliasVisitState] = []

	for _ in representation.nodes:
		visit_states = visit_states.append(TypeAliasUnvisited)

	var state: TypeAliasCycleSearchState = {
		visit_states = visit_states,
		path = []
	}
	var node_index: Int = 0
	var found_cycle: Option[List[String]] = None

	while node_index < representation.nodes.length() and found_cycle.is_none():
		if state.visit_states.get_or(node_index, TypeAliasUnvisited) == TypeAliasUnvisited:
			match search_alias_cycle_from(representation, node_index, state):
				TypeAliasCycleFound(cycle):
					found_cycle = Some(cycle)
				TypeAliasSearchContinues(updated):
					state = updated

		node_index += 1

	match found_cycle:
		Some(cycle):
			TypeAliasCycle(cycle)
		None:
			TypeAliasesAcyclic


record TypeAliasDependency {
	id: TypeId,
	dependencies: List[TypeId]
}


private record TypeAliasDependencyGraphRep {
	declaration_graph: DeclarationSkeletonGraph,
	nodes: List[TypeAliasDependency],
	node_indices_by_name: Dict[String, List[Int]]
}


opaque type TypeAliasDependencyGraph = TypeAliasDependencyGraphRep


private record AcyclicTypeAliasDependencyGraphRep {
	graph: TypeAliasDependencyGraph
}


opaque type AcyclicTypeAliasDependencyGraph = AcyclicTypeAliasDependencyGraphRep


union TypeAliasDependencyGraphError:
	TypeAliasDependencyModuleMissing(ModuleIdentity)


union TypeAliasIdentityCycleCheck:
	TypeAliasIdentitiesAcyclic
	TypeAliasIdentityCycle(List[TypeId])


private record TypeAliasIdentityCycleSearchState {
	visit_states: List[TypeAliasVisitState],
	path: List[TypeId]
}


private union TypeAliasIdentityCycleSearchResult:
	TypeAliasIdentitySearchContinues(TypeAliasIdentityCycleSearchState)
	TypeAliasIdentityCycleFound(List[TypeId])


private pure func type_skeleton_is_alias(info: TypeDeclarationSkeletonInfo) -> Bool:
	match info.source:
		AliasTypeSource(_):
			True
		_:
			False


private pure func find_alias_type_id(
	declaration_graph: DeclarationSkeletonGraph,
	module_identity: ModuleIdentity,
	name: String,
) -> Option[TypeId]:
	match declaration_skeleton_graph_find_type(declaration_graph, module_identity, name):
		Some(info):
			if type_skeleton_is_alias(info):
				Some(info.id)
			else:
				None
		None:
			None


private pure func find_alias_type_id_at_path(
	declaration_graph: DeclarationSkeletonGraph,
	bound_graph: BoundModuleGraph,
	module_path: String,
	name: String,
) -> Option[TypeId]:
	match bound_module_graph_find_canonical_path(bound_graph, module_path):
		Some(module):
			find_alias_type_id(declaration_graph, bound_module_identity(module), name)
		None:
			None


private pure func resolve_alias_reference(
	declaration_graph: DeclarationSkeletonGraph,
	bound_graph: BoundModuleGraph,
	module: BoundModule,
	type_param_names: List[String],
	reference: ParsedTypeReference,
) -> Option[TypeId]:
	view: ModuleView = bound_module_view(module)

	match reference:
		UnqualifiedTypeReference(name):
			if type_param_names.contains(name):
				None
			else:
				match declaration_skeleton_graph_find_type(
					declaration_graph,
					bound_module_identity(module),
					name,
				):
					Some(local_type):
						if type_skeleton_is_alias(local_type):
							Some(local_type.id)
						else:
							None
					None:
						match module_view_find_imported_name(view, name):
							Some(binding):
								find_alias_type_id_at_path(
									declaration_graph,
									bound_graph,
									binding.module_path,
									binding.original_name,
								)
							None:
								None
		QualifiedTypeReference(qualifier, name):
			match module_view_find_module_alias(view, qualifier):
				Some(module_path):
					find_alias_type_id_at_path(declaration_graph, bound_graph, module_path, name)
				None:
					None


private pure func append_unique_type_id(ids: List[TypeId], id: TypeId) -> List[TypeId]:
	if ids.any(func(existing): type_ids_equal(existing, id)):
		ids
	else:
		ids.append(id)


private pure func resolved_alias_dependencies(
	declaration_graph: DeclarationSkeletonGraph,
	bound_graph: BoundModuleGraph,
	module: BoundModule,
	alias_decl: ParsedTypeAliasDecl,
) -> List[TypeId]:
	type_param_names = type_param_names(alias_decl.type_params)
	var dependencies: List[TypeId] = []

	for reference in type_expr_references(alias_decl.target):
		match resolve_alias_reference(
			declaration_graph,
			bound_graph,
			module,
			type_param_names,
			reference,
		):
			Some(dependency):
				dependencies = append_unique_type_id(dependencies, dependency)
			None:
				void

	dependencies


pure func type_alias_dependency_graph_build(
	declaration_graph: DeclarationSkeletonGraph,
) -> Result[TypeAliasDependencyGraph, List[TypeAliasDependencyGraphError]]:
	bound_graph = declaration_skeleton_graph_bound_graph(declaration_graph)
	var nodes: List[TypeAliasDependency] = []
	var node_indices_by_name: Dict[String, List[Int]] = {}
	var errors: List[TypeAliasDependencyGraphError] = []

	for type_skeleton in declaration_skeleton_graph_type_skeletons(declaration_graph):
		match type_skeleton.source:
			AliasTypeSource(alias_decl):
				module_identity = type_id_module_identity(type_skeleton.id)

				match bound_module_graph_find(bound_graph, module_identity):
					Some(module):
						name = type_id_name(type_skeleton.id)
						node_index = nodes.length()
						nodes = nodes.append({
							id = type_skeleton.id,
							dependencies = resolved_alias_dependencies(
								declaration_graph,
								bound_graph,
								module,
								alias_decl,
							),
						})
						node_indices_by_name = node_indices_by_name.set(
							name,
							node_indices_by_name
								.get_or(name, [])
								.append(node_index),
						)
					None:
						errors = errors.append(TypeAliasDependencyModuleMissing(module_identity))
			_:
				void

	if errors.length() > 0:
		Err(errors)
	else:
		representation: TypeAliasDependencyGraphRep = {
			declaration_graph = declaration_graph,
			nodes = nodes,
			node_indices_by_name = node_indices_by_name
		}
		Ok(into TypeAliasDependencyGraph(representation))


private pure func type_alias_dependency_graph_rep(
	graph: TypeAliasDependencyGraph,
) -> TypeAliasDependencyGraphRep:
	from TypeAliasDependencyGraph(graph)


pure func type_alias_dependency_graph_nodes(
	graph: TypeAliasDependencyGraph,
) -> List[TypeAliasDependency]:
	type_alias_dependency_graph_rep(graph).nodes


private pure func type_alias_dependency_node_index(
	graph: TypeAliasDependencyGraphRep,
	id: TypeId,
) -> Option[Int]:
	name = type_id_name(id)
	var result: Option[Int] = None

	for node_index in graph.node_indices_by_name.get_or(name, []):
		match graph.nodes.get(node_index):
			Some(node):
				if type_ids_equal(node.id, id):
					result = Some(node_index)
					break
			None:
				void

	result


private pure func alias_identity_cycle_from_path(
	path: List[TypeId],
	repeated_id: TypeId,
) -> List[TypeId]:
	var start_index: Int = 0
	var found_start: Bool = False
	var index: Int = 0

	while index < path.length() and not found_start:
		match path.get(index):
			Some(id):
				if type_ids_equal(id, repeated_id):
					start_index = index
					found_start = True
			None:
				void

		index += 1

	var cycle: List[TypeId] = []
	index = start_index

	while index < path.length():
		match path.get(index):
			Some(id):
				cycle = cycle.append(id)
			None:
				void

		index += 1

	cycle.append(repeated_id)


private pure func search_alias_identity_cycle_from(
	graph: TypeAliasDependencyGraphRep,
	node_index: Int,
	state: TypeAliasIdentityCycleSearchState,
) -> TypeAliasIdentityCycleSearchResult:
	match graph.nodes.get(node_index):
		None:
			TypeAliasIdentitySearchContinues(state)
		Some(node):
			var next: TypeAliasIdentityCycleSearchState = {
				visit_states = state.visit_states.set(node_index, TypeAliasVisiting),
				path = state.path.append(node.id)
			}
			var found_cycle: Option[List[TypeId]] = None

			for dependency in node.dependencies:
				if found_cycle.is_none():
					match type_alias_dependency_node_index(graph, dependency):
						None:
							void
						Some(dependency_index):
							match next.visit_states.get_or(dependency_index, TypeAliasUnvisited):
								TypeAliasVisiting:
									found_cycle = Some(
										alias_identity_cycle_from_path(
											next.path,
											dependency,
										),
									)
								TypeAliasUnvisited:
									match search_alias_identity_cycle_from(
										graph,
										dependency_index,
										next,
									):
										TypeAliasIdentityCycleFound(cycle):
											found_cycle = Some(cycle)
										TypeAliasIdentitySearchContinues(updated):
											next = updated
								TypeAliasComplete:
									void

			match found_cycle:
				Some(cycle):
					TypeAliasIdentityCycleFound(cycle)
				None:
					TypeAliasIdentitySearchContinues({
						visit_states = next.visit_states.set(node_index, TypeAliasComplete),
						path = next.path.take(next.path.length() - 1),
					})


pure func type_alias_dependency_graph_check_cycles(
	graph: TypeAliasDependencyGraph,
) -> TypeAliasIdentityCycleCheck:
	representation = type_alias_dependency_graph_rep(graph)
	var visit_states: List[TypeAliasVisitState] = []

	for _ in representation.nodes:
		visit_states = visit_states.append(TypeAliasUnvisited)

	var state: TypeAliasIdentityCycleSearchState = {
		visit_states = visit_states,
		path = []
	}
	var node_index: Int = 0
	var found_cycle: Option[List[TypeId]] = None

	while node_index < representation.nodes.length() and found_cycle.is_none():
		if state.visit_states.get_or(node_index, TypeAliasUnvisited) == TypeAliasUnvisited:
			match search_alias_identity_cycle_from(representation, node_index, state):
				TypeAliasIdentityCycleFound(cycle):
					found_cycle = Some(cycle)
				TypeAliasIdentitySearchContinues(updated):
					state = updated

		node_index += 1

	match found_cycle:
		Some(cycle):
			TypeAliasIdentityCycle(cycle)
		None:
			TypeAliasIdentitiesAcyclic


pure func type_alias_identity_display_name(id: TypeId) -> String:
	module_identity_display_name(type_id_module_identity(id)) + "." + type_id_name(id)


pure func type_alias_dependency_graph_error_message(error: TypeAliasDependencyGraphError) -> String:
	match error:
		TypeAliasDependencyModuleMissing(module_identity):
			"type alias dependency graph is missing bound module '" + module_identity_display_name(
				module_identity,
			) + "'"


private pure func type_alias_cycle_display_names(cycle: List[TypeId]) -> List[String]:
	match cycle.get(0):
		None:
			[]
		Some(first):
			first_module = type_id_module_identity(first)
			is_local_cycle = cycle.all(
				func(id): module_identities_equal(type_id_module_identity(id), first_module),
			)

			if is_local_cycle:
				cycle.map(type_id_name)
			else:
				cycle.map(type_alias_identity_display_name)


pure func type_alias_dependency_graph_validation_errors(
	declaration_graph: DeclarationSkeletonGraph,
) -> List[String]:
	match type_alias_dependency_graph_validate(declaration_graph):
		Ok(_):
			[]
		Err(errors):
			errors


pure func type_alias_dependency_graph_validate(
	declaration_graph: DeclarationSkeletonGraph,
) -> Result[AcyclicTypeAliasDependencyGraph, List[String]]:
	match type_alias_dependency_graph_build(declaration_graph):
		Err(errors):
			Err(errors.map(type_alias_dependency_graph_error_message))
		Ok(graph):
			match type_alias_dependency_graph_check_cycles(graph):
				TypeAliasIdentitiesAcyclic:
					representation: AcyclicTypeAliasDependencyGraphRep = {graph = graph}
					Ok(into AcyclicTypeAliasDependencyGraph(representation))
				TypeAliasIdentityCycle(cycle):
					Err(["Type alias cycle: " + type_alias_cycle_display_names(cycle).join(" -> ")])


private pure func acyclic_type_alias_dependency_graph_rep(
	graph: AcyclicTypeAliasDependencyGraph,
) -> AcyclicTypeAliasDependencyGraphRep:
	from AcyclicTypeAliasDependencyGraph(graph)


pure func acyclic_type_alias_dependency_graph_declaration_graph(
	graph: AcyclicTypeAliasDependencyGraph,
) -> DeclarationSkeletonGraph:
	type_alias_dependency_graph_rep(
		acyclic_type_alias_dependency_graph_rep(graph).graph,
	).declaration_graph


pure func acyclic_type_alias_dependency_graph_nodes(
	graph: AcyclicTypeAliasDependencyGraph,
) -> List[TypeAliasDependency]:
	type_alias_dependency_graph_nodes(acyclic_type_alias_dependency_graph_rep(graph).graph)
