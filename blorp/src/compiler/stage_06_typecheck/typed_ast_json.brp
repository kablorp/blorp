-- JSON projection for Blorp-owned typed AST metadata.
--
-- Explicit benchmark and diagnostic protocols use this transfer shape. Keep
-- these encoders structural:
-- display strings are useful for diagnostics, not for compiler boundaries.
import:
	../../lib/source: SourceFile, SourceSpan
	../stage_03_parse/parsed_ast:
		ParsedBinaryOp(
			ParsedAddOp,
			ParsedDivideOp,
			ParsedEqualOp,
			ParsedGreaterEqualOp,
			ParsedGreaterOp,
			ParsedLessEqualOp,
			ParsedLessOp,
			ParsedModuloOp,
			ParsedMultiplyOp,
			ParsedNotEqualOp,
			ParsedSubtractOp,
		),
		ParsedDecl(ForeignBlockParsedDecl, TraitParsedDecl),
		ParsedForBinder(ParsedForNameBinder, ParsedForTupleBinder),
		ParsedForeignBlockArg,
		ParsedFunctionDecl,
		ParsedIdentifier,
		ParsedImplDecl,
		ParsedListPatternSpread(ParsedListSpreadName, ParsedListSpreadWildcard),
		ParsedLogicalOp(ParsedAndOp, ParsedOrOp),
		ParsedRecordDecl,
		ParsedTypeAliasDecl,
		ParsedUnaryOp(ParsedNegateOp, ParsedNotOp),
		ParsedUnionDecl,
		ParsedVarDecl,
		ParsedWithBindingKind(ParsedWithPlainBinding, ParsedWithTryBinding),
	../stage_03_parse/parsed_ast_json:
		parse_diagnostic_to_json,
		parsed_decl_to_json,
		parsed_function_decl_to_json,
		parsed_identifier_to_json,
		parsed_impl_decl_to_json,
		parsed_record_decl_to_json,
		parsed_source_file_to_json,
		parsed_source_span_to_json,
		parsed_type_alias_decl_to_json,
		parsed_union_decl_to_json,
		parsed_var_decl_to_json,
	type_system/env:
		ImplMethodTarget,
		Purity(Impure, Pure),
		ResourceArgPolicy(AllowResourceArgs, RejectResourceArgs),
		ResourceResultPolicy(
			ResourceResultDependent,
			ResourceResultIndependent,
			ResourceResultOrdinary,
		),
	type_system/generic_params: BoundTypeParam
	type_system/refinement:
		CollectionIdentity,
		DimensionIdentity,
		ProofSource(
			ProofSourceCondition,
			ProofSourceLoopEnumerate,
			ProofSourceLoopIndices,
			ProofSourceLoopRange,
			ProofSourceRangeTypeFallback,
			ProofSourceUnknown,
		),
		ProvenCollection(CollDim, CollSubscript, CollVar),
		RangeProof,
		RangeUpper(
			RangeUpperAtMostLength,
			RangeUpperDimension,
			RangeUpperLengthMinus,
			RangeUpperLit,
		),
		SubscriptProof,
		ValueProofs,
		binding_range_proof,
		binding_subscript_proof,
		collection_identity_name,
		dimension_identity_name,
	type_system/semantic_type: SemanticType
	type_system/type_json: optional_type_to_json, type_list_to_json, type_to_json
	type_system/type_widening:
		CollectionKind(DictLiteral, ListLiteral, SetLiteral, VectorLiteral),
		TypeWideningDecision(TypeKeep, TypeWiden),
		TypeWideningReason(
			ArgumentSlot,
			BitwiseOperator,
			CollectionElement,
			MethodReceiver,
			MutableBindingWidening,
			NumericOperator,
			RangeProofErasure,
			TupleLiteral,
		),
		ValueSlot,
		widening_decision,
		widening_semantic_type,
	decl:
		TypedDecl(
			TypedFunctionDecl,
			TypedForeignFunctionDecl,
			TypedGlobalVarDecl,
			TypedImplDecl,
			TypedParsedDecl,
			TypedPrivateDecl,
			TypedRecordDecl,
			TypedTraitDecl,
			TypedTypeAliasDecl,
			TypedUnionDecl,
		),
		TypedForeignFunctionInfo,
		TypedForeignLinkFlag,
		TypedFunctionInfo,
		TypedGlobalVarInfo,
		TypedImplInfo,
		TypedProgram,
		TypedRecordFieldInfo,
		TypedRecordInfo,
		TypedTypeAliasInfo,
		TypedUnionInfo,
		TypedUnionVariantInfo,
		typed_foreign_link_platform_to_string,
	infer:
		CallableOrigin(
			CallableBuiltin,
			CallableConstructor,
			CallableForeign,
			CallableImported,
			CallableImplMethod,
			CallableLocal,
		),
		ExprTypeOrigin(ExplicitAnnotationOrigin, InferredOrigin, SynthesizedOrigin),
		ResolvedCallInfo,
		ResolvedCallTarget(
			ResolvedClosureCall,
			ResolvedDirectCall,
			ResolvedIntrinsicCall,
			ResolvedTraitMethodCall,
		),
		TypedAssignScope(LocalAssignScope, ModuleAssignScope),
		TypedAssignTarget,
		TypedConcurrentBinding,
		TypedConcurrentParam,
		TypedDictEntry,
		TypedExpr(
			TypedAscriptionExpr,
			TypedAssignExpr,
			TypedBinaryExpr,
			TypedBlockExpr,
			TypedBoolLiteralExpr,
			TypedBreakExpr,
			TypedBuiltinExpr,
			TypedCallExpr,
			TypedCharLiteralExpr,
			TypedConcurrentBlockExpr,
			TypedConcurrentForExpr,
			TypedContinueExpr,
			TypedDebugBlockExpr,
			TypedDetachExpr,
			TypedDictExpr,
			TypedFieldAccessExpr,
			TypedFloatLiteralExpr,
			TypedForExpr,
			TypedIfExpr,
			TypedIntLiteralExpr,
			TypedLambdaExpr,
			TypedListExpr,
			TypedLogicalExpr,
			TypedMatchExpr,
			TypedMissingExpr,
			TypedNameExpr,
			TypedOpaqueFromExpr,
			TypedOpaqueIntoExpr,
			TypedQuestionBindExpr,
			TypedRangeExpr,
			TypedRecordExpr,
			TypedRecordUpdateExpr,
			TypedSelectExpr,
			TypedStringInterpolationExpr,
			TypedStringInterpolationPartsExpr,
			TypedStringLiteralExpr,
			TypedSubscriptAssignExpr,
			TypedSubscriptExpr,
			TypedTupleDestructExpr,
			TypedTupleExpr,
			TypedUnaryExpr,
			TypedUnsupportedExpr,
			TypedVarDeclExpr,
			TypedVectorExpr,
			TypedVoidExpr,
			TypedWhileExpr,
			TypedWithExpr,
		),
		TypedExprInfo,
		TypedLambdaParam,
		TypedLoopView(
			TypedEnumerate2LoopView,
			TypedEnumerateLoopView,
			TypedIndicesLoopView,
			TypedWindowsLoopView,
		),
		TypedMatchCase,
		TypedPattern(
			TypedBoolPattern,
			TypedCharPattern,
			TypedConstructorPattern,
			TypedFloatPattern,
			TypedIntPattern,
			TypedListPattern,
			TypedNamePattern,
			TypedOrPattern,
			TypedQualifiedConstructorPattern,
			TypedStringPattern,
			TypedTuplePattern,
			TypedUnsupportedPattern,
			TypedWildcardPattern,
		),
		TypedRecordField,
		TypedSelectArm,
		TypedSelectArmKind(TypedSelectAfterArm, TypedSelectReceiveArm, TypedSelectSealedArm),
		TypedStringInterpolationPart(TypedInterpolationExpr, TypedInterpolationLiteral),
		TypedVarDeclPayload,
		TypedWithBinding,
		TypedWithErrorMap,
		typed_expr_info_semantic_type,
		typed_expr_info_value_type,
	json:
		JsonValue(JsonBool, JsonNull, JsonNumber, JsonObject, JsonString, JsonVector),
		emit_json_chunks,


private KIND_FIELD: String = "kind"


private pure func json_int(value: Int) -> JsonValue:
	JsonNumber(to_float(value))


private pure func option_int_to_json(value: Option[Int]) -> JsonValue:
	match value:
		Some(n):
			json_int(n)
		None:
			JsonNull


private pure func parsed_binary_op_to_json(op: ParsedBinaryOp) -> JsonValue:
	match op:
		ParsedAddOp:
			JsonString("add")
		ParsedSubtractOp:
			JsonString("subtract")
		ParsedMultiplyOp:
			JsonString("multiply")
		ParsedDivideOp:
			JsonString("divide")
		ParsedModuloOp:
			JsonString("modulo")
		ParsedEqualOp:
			JsonString("equal")
		ParsedNotEqualOp:
			JsonString("not_equal")
		ParsedLessOp:
			JsonString("less")
		ParsedLessEqualOp:
			JsonString("less_equal")
		ParsedGreaterOp:
			JsonString("greater")
		ParsedGreaterEqualOp:
			JsonString("greater_equal")


pure func collection_kind_to_json(kind: CollectionKind) -> JsonValue:
	match kind:
		ListLiteral:
			JsonString("list")
		VectorLiteral:
			JsonString("vector")
		DictLiteral:
			JsonString("dict")
		SetLiteral:
			JsonString("set")


pure func widening_reason_to_json(reason: TypeWideningReason) -> JsonValue:
	match reason:
		MutableBindingWidening:
			JsonObject([(KIND_FIELD, JsonString("mutable_binding"))])
		ArgumentSlot:
			JsonObject([(KIND_FIELD, JsonString("argument_slot"))])
		CollectionElement(kind):
			JsonObject([
				(KIND_FIELD, JsonString("collection_element")),
				("collection", collection_kind_to_json(kind)),
			])
		BitwiseOperator:
			JsonObject([(KIND_FIELD, JsonString("bitwise_operator"))])
		MethodReceiver:
			JsonObject([(KIND_FIELD, JsonString("method_receiver"))])
		RangeProofErasure:
			JsonObject([(KIND_FIELD, JsonString("range_proof_erasure"))])
		TupleLiteral:
			JsonObject([(KIND_FIELD, JsonString("tuple_literal"))])
		NumericOperator(op):
			JsonObject([
				(KIND_FIELD, JsonString("numeric_operator")),
				("op", parsed_binary_op_to_json(op)),
			])


pure func widening_decision_to_json(decision: TypeWideningDecision) -> JsonValue:
	match decision:
		TypeKeep(typ):
			JsonObject([
				(KIND_FIELD, JsonString("keep")),
				("type", type_to_json(typ)),
			])
		TypeWiden(from_type, to_type, reason):
			JsonObject([
				(KIND_FIELD, JsonString("widen")),
				("from_type", type_to_json(from_type)),
				("to_type", type_to_json(to_type)),
				("reason", widening_reason_to_json(reason)),
			])


pure func value_slot_to_json(slot: ValueSlot) -> JsonValue:
	JsonObject([
		("semantic_type", type_to_json(widening_semantic_type(slot))),
		("decision", widening_decision_to_json(widening_decision(slot))),
	])


pure func expr_type_origin_to_json(origin: ExprTypeOrigin) -> JsonValue:
	match origin:
		InferredOrigin:
			JsonObject([(KIND_FIELD, JsonString("inferred"))])
		ExplicitAnnotationOrigin(typ):
			JsonObject([
				(KIND_FIELD, JsonString("explicit_annotation")),
				("type", type_to_json(typ)),
			])
		SynthesizedOrigin(label):
			JsonObject([
				(KIND_FIELD, JsonString("synthesized")),
				("label", JsonString(label)),
			])


private pure func purity_to_json(purity: Purity) -> JsonValue:
	match purity:
		Pure:
			JsonString("pure")
		Impure:
			JsonString("impure")


private pure func resource_result_policy_to_json(policy: ResourceResultPolicy) -> JsonValue:
	match policy:
		ResourceResultDependent:
			JsonString("dependent")
		ResourceResultIndependent:
			JsonString("independent")
		ResourceResultOrdinary:
			JsonString("ordinary")


private pure func resource_arg_policy_to_json(policy: ResourceArgPolicy) -> JsonValue:
	match policy:
		RejectResourceArgs:
			JsonObject([(KIND_FIELD, JsonString("reject"))])
		AllowResourceArgs(result_policy):
			JsonObject([
				(KIND_FIELD, JsonString("allow")),
				("result_policy", resource_result_policy_to_json(result_policy)),
			])


private pure func dim_constraint_to_json(constraint: (SemanticType, SemanticType)) -> JsonValue:
	JsonObject([
		("left", type_to_json(constraint[0])),
		("right", type_to_json(constraint[1])),
	])


private pure func callable_origin_to_json(origin: CallableOrigin) -> JsonValue:
	match origin:
		CallableLocal:
			JsonObject([(KIND_FIELD, JsonString("local"))])
		CallableImported(module_path):
			JsonObject([
				(KIND_FIELD, JsonString("imported")),
				("module", JsonString(module_path)),
			])
		CallableBuiltin:
			JsonObject([(KIND_FIELD, JsonString("builtin"))])
		CallableForeign:
			JsonObject([(KIND_FIELD, JsonString("foreign"))])
		CallableConstructor(parent_type):
			JsonObject([
				(KIND_FIELD, JsonString("constructor")),
				("parent_type", JsonString(parent_type)),
			])
		CallableImplMethod:
			JsonObject([(KIND_FIELD, JsonString("impl_method"))])


private pure func resolved_call_target_to_json(target: ResolvedCallTarget) -> JsonValue:
	match target:
		ResolvedDirectCall(callable_id, origin):
			JsonObject([
				(KIND_FIELD, JsonString("direct")),
				("callable_id", json_int(callable_id)),
				("origin", callable_origin_to_json(origin)),
			])
		ResolvedTraitMethodCall(trait_name, impl_target):
			JsonObject([
				(KIND_FIELD, JsonString("trait_method")),
				("trait_name", JsonString(trait_name)),
				("impl_target", resolved_trait_method_target_to_json(impl_target)),
			])
		ResolvedIntrinsicCall:
			JsonObject([(KIND_FIELD, JsonString("intrinsic"))])
		ResolvedClosureCall:
			JsonObject([(KIND_FIELD, JsonString("closure"))])


private pure func resolved_trait_method_target_to_json(
	target: Option[ImplMethodTarget],
) -> JsonValue:
	match target:
		Some(value):
			JsonObject([
				("callable_id", json_int(value.callable_id)),
				("module_path", JsonString(value.module_path)),
			])
		None:
			JsonNull


pure func resolved_call_to_json(info: ResolvedCallInfo) -> JsonValue:
	JsonObject([
		("callee_name", JsonString(info.callee_name)),
		("source_name", JsonString(info.source_name)),
		("purity", purity_to_json(info.purity)),
		("target", resolved_call_target_to_json(info.target)),
		("instantiated_params", type_list_to_json(info.instantiated_params)),
		("instantiated_return", type_to_json(info.instantiated_return)),
		("resource_args", resource_arg_policy_to_json(info.resource_args)),
		("dim_constraints", JsonVector(info.dim_constraints.map(dim_constraint_to_json))),
	])


private pure func optional_resolved_call_to_json(info: Option[ResolvedCallInfo]) -> JsonValue:
	match info:
		Some(value):
			resolved_call_to_json(value)
		None:
			JsonNull


private pure func collection_identity_to_json(identity: CollectionIdentity) -> JsonValue:
	JsonObject([("name", JsonString(collection_identity_name(identity)))])


private pure func proof_source_to_json(source: ProofSource) -> JsonValue:
	match source:
		ProofSourceUnknown:
			JsonString("unknown")
		ProofSourceLoopRange:
			JsonString("loop_range")
		ProofSourceLoopIndices:
			JsonString("loop_indices")
		ProofSourceLoopEnumerate:
			JsonString("loop_enumerate")
		ProofSourceCondition:
			JsonString("condition")
		ProofSourceRangeTypeFallback:
			JsonString("range_type_fallback")


private pure func proven_collection_to_json(collection: ProvenCollection) -> JsonValue:
	match collection:
		CollVar(identity):
			JsonObject([
				(KIND_FIELD, JsonString("var")),
				("identity", collection_identity_to_json(identity)),
			])
		CollSubscript(parent, identity):
			JsonObject([
				(KIND_FIELD, JsonString("subscript")),
				("parent", proven_collection_to_json(parent)),
				("identity", collection_identity_to_json(identity)),
			])
		CollDim(value):
			JsonObject([
				(KIND_FIELD, JsonString("dim")),
				("value", json_int(value)),
			])


private pure func range_upper_to_json(upper: RangeUpper) -> JsonValue:
	match upper:
		RangeUpperLit(value):
			JsonObject([
				(KIND_FIELD, JsonString("literal")),
				("value", json_int(value)),
			])
		RangeUpperDimension(identity):
			JsonObject([
				(KIND_FIELD, JsonString("dimension")),
				("identity", JsonObject([("name", JsonString(dimension_identity_name(identity)))])),
			])
		RangeUpperLengthMinus(identity, offset):
			JsonObject([
				(KIND_FIELD, JsonString("length_minus")),
				("identity", collection_identity_to_json(identity)),
				("offset", json_int(offset)),
			])
		RangeUpperAtMostLength(identity):
			JsonObject([
				(KIND_FIELD, JsonString("at_most_length")),
				("identity", collection_identity_to_json(identity)),
			])


private pure func range_proof_to_json(proof: RangeProof) -> JsonValue:
	JsonObject([
		("start", json_int(proof.range_start)),
		("upper", range_upper_to_json(proof.range_upper)),
		("source", proof_source_to_json(proof.range_source)),
	])


private pure func optional_range_proof_to_json(proof: Option[RangeProof]) -> JsonValue:
	match proof:
		Some(value):
			range_proof_to_json(value)
		None:
			JsonNull


private pure func subscript_proof_to_json(proof: SubscriptProof) -> JsonValue:
	JsonObject([
		("collection", proven_collection_to_json(proof.subscript_collection)),
		("source", proof_source_to_json(proof.subscript_source)),
	])


private pure func optional_subscript_proof_to_json(proof: Option[SubscriptProof]) -> JsonValue:
	match proof:
		Some(value):
			subscript_proof_to_json(value)
		None:
			JsonNull


private pure func optional_definition_id_to_json(definition_id: Option[Int]) -> JsonValue:
	match definition_id:
		Some(value):
			JsonNumber(to_float(value))
		None:
			JsonNull


pure func value_proofs_to_json(proofs: ValueProofs) -> JsonValue:
	JsonObject([
		("range", optional_range_proof_to_json(binding_range_proof(proofs))),
		("subscript", optional_subscript_proof_to_json(binding_subscript_proof(proofs))),
	])


pure func typed_expr_info_to_json(info: TypedExprInfo) -> JsonValue:
	JsonObject([
		("source_type", optional_type_to_json(info.source_type)),
		("semantic_type", type_to_json(typed_expr_info_semantic_type(info))),
		("value_type", type_to_json(typed_expr_info_value_type(info))),
		("origin", expr_type_origin_to_json(info.origin)),
		("value_slot", value_slot_to_json(info.value_slot)),
		("proofs", value_proofs_to_json(info.proofs)),
		("resolved_call", optional_resolved_call_to_json(info.resolved_call)),
		("resolved_definition_id", optional_definition_id_to_json(info.resolved_definition_id)),
		("resource_dependencies", JsonVector(info.resource_dependencies.map(
				func(item: String): JsonString(item),
			))),
	])


private pure func optional_string_to_json(value: Option[String]) -> JsonValue:
	match value:
		Some(text):
			JsonString(text)
		None:
			JsonNull


private pure func typed_expr_json(
	kind: String,
	span: SourceSpan,
	info: TypedExprInfo,
	fields: List[(String, JsonValue)],
) -> JsonValue:
	var result: List[(String, JsonValue)] = [
		(KIND_FIELD, JsonString(kind)),
		("span", parsed_source_span_to_json(span)),
		("info", typed_expr_info_to_json(info)),
	]

	for field in fields:
		result = result.append(field)

	JsonObject(result)


private pure func optional_typed_expr_to_json(expr: Option[TypedExpr]) -> JsonValue:
	match expr:
		Some(value):
			typed_expr_to_json(value)
		None:
			JsonNull


private pure func typed_loop_view_to_json(
	loop_view: Option[TypedLoopView],
	iterable: TypedExpr,
) -> JsonValue:
	match (loop_view, iterable):
		(Some(view), TypedCallExpr(_, args, _, _)):
			match (view, args.get(0)):
				(TypedIndicesLoopView(element_type), Some(source)):
					JsonObject([
						(KIND_FIELD, JsonString("indices")),
						("source", typed_expr_to_json(source)),
						("element_type", type_to_json(element_type)),
					])
				(TypedEnumerateLoopView(element_type), Some(source)):
					JsonObject([
						(KIND_FIELD, JsonString("enumerate")),
						("source", typed_expr_to_json(source)),
						("element_type", type_to_json(element_type)),
					])
				(TypedEnumerate2LoopView(element_type), Some(source)):
					JsonObject([
						(KIND_FIELD, JsonString("enumerate2")),
						("source", typed_expr_to_json(source)),
						("element_type", type_to_json(element_type)),
					])
				(TypedWindowsLoopView(size, element_type), Some(source)):
					match args.get(1):
						Some(size_arg):
							JsonObject([
								(KIND_FIELD, JsonString("windows")),
								("source", typed_expr_to_json(source)),
								("size_arg", typed_expr_to_json(size_arg)),
								("size", json_int(size)),
								("element_type", type_to_json(element_type)),
							])
						None:
							JsonNull
				_:
					JsonNull
		_:
			JsonNull


private pure func identifiers_to_json(items: List[ParsedIdentifier]) -> JsonValue:
	JsonVector(items.map(parsed_identifier_to_json))


private pure func parsed_unary_op_to_json(op: ParsedUnaryOp) -> JsonValue:
	match op:
		ParsedNegateOp:
			JsonString("negate")
		ParsedNotOp:
			JsonString("not")


private pure func parsed_logical_op_to_json(op: ParsedLogicalOp) -> JsonValue:
	match op:
		ParsedAndOp:
			JsonString("and")
		ParsedOrOp:
			JsonString("or")


private pure func parsed_for_binder_to_json(binder: ParsedForBinder) -> JsonValue:
	match binder:
		ParsedForNameBinder(name):
			JsonObject([
				(KIND_FIELD, JsonString("name")),
				("name", parsed_identifier_to_json(name)),
			])
		ParsedForTupleBinder(names, span):
			JsonObject([
				(KIND_FIELD, JsonString("tuple")),
				("names", identifiers_to_json(names)),
				("span", parsed_source_span_to_json(span)),
			])


private pure func parsed_list_pattern_spread_to_json(spread: ParsedListPatternSpread) -> JsonValue:
	match spread:
		ParsedListSpreadName(name):
			JsonObject([
				(KIND_FIELD, JsonString("name")),
				("name", parsed_identifier_to_json(name)),
			])
		ParsedListSpreadWildcard(span):
			JsonObject([
				(KIND_FIELD, JsonString("wildcard")),
				("span", parsed_source_span_to_json(span)),
			])


private pure func optional_list_pattern_spread_to_json(
	spread: Option[ParsedListPatternSpread],
) -> JsonValue:
	match spread:
		Some(value):
			parsed_list_pattern_spread_to_json(value)
		None:
			JsonNull


private pure func typed_patterns_to_json(patterns: List[TypedPattern]) -> JsonValue:
	JsonVector(patterns.map(typed_pattern_to_json))


pure func typed_pattern_to_json(pattern: TypedPattern) -> JsonValue:
	match pattern:
		TypedWildcardPattern(span):
			JsonObject([
				(KIND_FIELD, JsonString("wildcard")),
				("span", parsed_source_span_to_json(span)),
			])
		TypedNamePattern(name, typ):
			JsonObject([
				(KIND_FIELD, JsonString("name")),
				("name", parsed_identifier_to_json(name)),
				("type", type_to_json(typ)),
			])
		TypedBoolPattern(value, span):
			JsonObject([
				(KIND_FIELD, JsonString("bool")),
				("value", JsonBool(value)),
				("span", parsed_source_span_to_json(span)),
			])
		TypedIntPattern(value, span):
			JsonObject([
				(KIND_FIELD, JsonString("int")),
				("value", JsonString(value)),
				("span", parsed_source_span_to_json(span)),
			])
		TypedFloatPattern(value, span):
			JsonObject([
				(KIND_FIELD, JsonString("float")),
				("value", JsonString(value)),
				("span", parsed_source_span_to_json(span)),
			])
		TypedStringPattern(value, span):
			JsonObject([
				(KIND_FIELD, JsonString("string")),
				("value", JsonString(value)),
				("span", parsed_source_span_to_json(span)),
			])
		TypedCharPattern(value, span):
			JsonObject([
				(KIND_FIELD, JsonString("char")),
				("value", json_int(value)),
				("span", parsed_source_span_to_json(span)),
			])
		TypedConstructorPattern(name, args, span, definition_id):
			JsonObject([
				(KIND_FIELD, JsonString("constructor")),
				("name", parsed_identifier_to_json(name)),
				("args", typed_patterns_to_json(args)),
				("span", parsed_source_span_to_json(span)),
				("definition_id", json_int(definition_id)),
			])
		TypedQualifiedConstructorPattern(module_name, name, args, span, definition_id):
			JsonObject([
				(KIND_FIELD, JsonString("qualified_constructor")),
				("module", parsed_identifier_to_json(module_name)),
				("name", parsed_identifier_to_json(name)),
				("args", typed_patterns_to_json(args)),
				("span", parsed_source_span_to_json(span)),
				("definition_id", json_int(definition_id)),
			])
		TypedTuplePattern(items, span):
			JsonObject([
				(KIND_FIELD, JsonString("tuple")),
				("items", typed_patterns_to_json(items)),
				("span", parsed_source_span_to_json(span)),
			])
		TypedListPattern(items, spread, span):
			JsonObject([
				(KIND_FIELD, JsonString("list")),
				("items", typed_patterns_to_json(items)),
				("spread", optional_list_pattern_spread_to_json(spread)),
				("span", parsed_source_span_to_json(span)),
			])
		TypedOrPattern(items, span):
			JsonObject([
				(KIND_FIELD, JsonString("or")),
				("items", typed_patterns_to_json(items)),
				("span", parsed_source_span_to_json(span)),
			])
		TypedUnsupportedPattern(label, span):
			JsonObject([
				(KIND_FIELD, JsonString("unsupported")),
				("label", JsonString(label)),
				("span", parsed_source_span_to_json(span)),
			])


private pure func typed_match_case_to_json(case: TypedMatchCase) -> JsonValue:
	JsonObject([
		("pattern", typed_pattern_to_json(case.pattern)),
		("body", typed_expr_to_json(case.body)),
		("span", parsed_source_span_to_json(case.span)),
	])


private pure func typed_dict_entry_to_json(entry: TypedDictEntry) -> JsonValue:
	JsonObject([
		("key", typed_expr_to_json(entry.key)),
		("value", typed_expr_to_json(entry.value)),
	])


private pure func typed_record_field_to_json(field: TypedRecordField) -> JsonValue:
	JsonObject([
		("name", parsed_identifier_to_json(field.name)),
		("value", typed_expr_to_json(field.value)),
		("span", parsed_source_span_to_json(field.span)),
		("definition_id", optional_definition_id_to_json(field.definition_id)),
	])


private pure func typed_record_fields_to_json(fields: List[TypedRecordField]) -> JsonValue:
	JsonVector(fields.map(typed_record_field_to_json))


private pure func typed_lambda_param_to_json(param: TypedLambdaParam) -> JsonValue:
	JsonObject([
		("name", parsed_identifier_to_json(param.name)),
		("source_type", optional_type_to_json(param.source_type)),
		("param_type", type_to_json(param.param_type)),
	])


private pure func typed_select_arm_kind_to_json(kind: TypedSelectArmKind) -> JsonValue:
	match kind:
		TypedSelectReceiveArm(name, elem_type, channel):
			JsonObject([
				(KIND_FIELD, JsonString("receive")),
				("name", parsed_identifier_to_json(name)),
				("elem_type", type_to_json(elem_type)),
				("channel", typed_expr_to_json(channel)),
			])
		TypedSelectSealedArm(elem_type, channel):
			JsonObject([
				(KIND_FIELD, JsonString("sealed")),
				("elem_type", type_to_json(elem_type)),
				("channel", typed_expr_to_json(channel)),
			])
		TypedSelectAfterArm(timeout):
			JsonObject([
				(KIND_FIELD, JsonString("after")),
				("timeout", typed_expr_to_json(timeout)),
			])


private pure func typed_select_arm_to_json(arm: TypedSelectArm) -> JsonValue:
	JsonObject([
		("kind", typed_select_arm_kind_to_json(arm.kind)),
		("body", typed_expr_to_json(arm.body)),
		("span", parsed_source_span_to_json(arm.span)),
	])


private pure func typed_assign_scope_to_json(scope: TypedAssignScope) -> JsonValue:
	match scope:
		LocalAssignScope:
			JsonString("local")
		ModuleAssignScope:
			JsonString("module")


private pure func typed_assign_target_to_json(target: TypedAssignTarget) -> JsonValue:
	JsonObject([
		("name", JsonString(target.name)),
		("scope", typed_assign_scope_to_json(target.scope)),
	])


private pure func optional_typed_assign_target_to_json(
	target: Option[TypedAssignTarget],
) -> JsonValue:
	match target:
		Some(value):
			typed_assign_target_to_json(value)
		None:
			JsonNull


private pure func typed_concurrent_param_to_json(param: TypedConcurrentParam) -> JsonValue:
	JsonObject([
		("name", parsed_identifier_to_json(param.name)),
		("value", typed_expr_to_json(param.value)),
		("span", parsed_source_span_to_json(param.span)),
	])


private pure func typed_concurrent_params_to_json(params: List[TypedConcurrentParam]) -> JsonValue:
	JsonVector(params.map(typed_concurrent_param_to_json))


private pure func typed_concurrent_binding_to_json(binding: TypedConcurrentBinding) -> JsonValue:
	typed_expr_json(
		"concurrent_bind",
		binding.span,
		binding.info,
		[
			("name", parsed_identifier_to_json(binding.name)),
			("annotation", optional_type_to_json(binding.annotation)),
			("value", typed_expr_to_json(binding.value)),
		],
	)


private pure func typed_with_binding_kind_to_json(kind: ParsedWithBindingKind) -> JsonValue:
	match kind:
		ParsedWithPlainBinding:
			JsonString("plain")
		ParsedWithTryBinding:
			JsonString("try")


private pure func typed_with_error_map_to_json(error_map: TypedWithErrorMap) -> JsonValue:
	JsonObject([
		("name", parsed_identifier_to_json(error_map.name)),
		("value", typed_expr_to_json(error_map.value)),
		("span", parsed_source_span_to_json(error_map.span)),
	])


private pure func optional_typed_with_error_map_to_json(
	error_map: Option[TypedWithErrorMap],
) -> JsonValue:
	match error_map:
		Some(value):
			typed_with_error_map_to_json(value)
		None:
			JsonNull


private pure func typed_with_binding_to_json(binding: TypedWithBinding) -> JsonValue:
	JsonObject([
		("name", parsed_identifier_to_json(binding.name)),
		("annotation", optional_type_to_json(binding.annotation)),
		("value", typed_expr_to_json(binding.value)),
		("kind", typed_with_binding_kind_to_json(binding.kind)),
		("error_map", optional_typed_with_error_map_to_json(binding.error_map)),
		("cleanup_function", optional_string_to_json(binding.cleanup_function)),
		("span", parsed_source_span_to_json(binding.span)),
	])


private pure func typed_string_interpolation_part_to_json(
	part: TypedStringInterpolationPart,
) -> JsonValue:
	match part:
		TypedInterpolationLiteral(text):
			JsonObject([
				(KIND_FIELD, JsonString("literal")),
				("text", JsonString(text)),
			])
		TypedInterpolationExpr(expr):
			JsonObject([
				(KIND_FIELD, JsonString("expr")),
				("expr", typed_expr_to_json(expr)),
			])


private pure func typed_var_decl_payload_to_json(payload: TypedVarDeclPayload) -> JsonValue:
	JsonObject([
		("name", parsed_identifier_to_json(payload.name)),
		("annotation", optional_type_to_json(payload.annotation)),
		("initializer", typed_expr_to_json(payload.initializer)),
		("is_mutable", JsonBool(payload.is_mutable)),
		("span", parsed_source_span_to_json(payload.span)),
	])


private pure func typed_for_expr_to_json(
	binder: ParsedForBinder,
	iterable: TypedExpr,
	loop_view: Option[TypedLoopView],
	body: TypedExpr,
	span: SourceSpan,
	info: TypedExprInfo,
) -> JsonValue:
	typed_expr_json(
		"for",
		span,
		info,
		[
			("binder", parsed_for_binder_to_json(binder)),
			("iterable", typed_expr_to_json(iterable)),
			("loop_view", typed_loop_view_to_json(loop_view, iterable)),
			("body", typed_expr_to_json(body)),
		],
	)


private pure func typed_concurrent_for_expr_to_json(
	name: ParsedIdentifier,
	iterable: TypedExpr,
	params: List[TypedConcurrentParam],
	body: TypedExpr,
	span: SourceSpan,
	info: TypedExprInfo,
) -> JsonValue:
	typed_expr_json(
		"concurrent_for",
		span,
		info,
		[
			("name", parsed_identifier_to_json(name)),
			("iterable", typed_expr_to_json(iterable)),
			("params", typed_concurrent_params_to_json(params)),
			("body", typed_expr_to_json(body)),
		],
	)


pure func typed_expr_to_json(expr: TypedExpr) -> JsonValue:
	match expr:
		TypedNameExpr(name, info):
			JsonObject([
				(KIND_FIELD, JsonString("name")),
				("name", parsed_identifier_to_json(name)),
				("info", typed_expr_info_to_json(info)),
			])
		TypedIntLiteralExpr(value, span, info):
			typed_expr_json("int_literal", span, info, [("value", JsonString(value))])
		TypedFloatLiteralExpr(value, span, info):
			typed_expr_json("float_literal", span, info, [("value", JsonString(value))])
		TypedStringLiteralExpr(value, span, info):
			typed_expr_json("string_literal", span, info, [("value", JsonString(value))])
		TypedStringInterpolationExpr(value, raw, span, info):
			typed_expr_json(
				"string_interpolation_raw",
				span,
				info,
				[("value", JsonString(value)), ("raw", JsonBool(raw))],
			)
		TypedStringInterpolationPartsExpr(parts, multiline, span, info):
			typed_expr_json(
				"string_interpolation",
				span,
				info,
				[
					("parts", JsonVector(parts.map(typed_string_interpolation_part_to_json))),
					("multiline", JsonBool(multiline)),
				],
			)
		TypedBoolLiteralExpr(value, span, info):
			typed_expr_json("bool_literal", span, info, [("value", JsonBool(value))])
		TypedCharLiteralExpr(value, span, info):
			typed_expr_json("char_literal", span, info, [("value", json_int(value))])
		TypedUnaryExpr(op, inner, span, info):
			typed_expr_json(
				"unary",
				span,
				info,
				[("op", parsed_unary_op_to_json(op)), ("inner", typed_expr_to_json(inner))],
			)
		TypedBinaryExpr(op, left, right, span, info):
			typed_expr_json(
				"binary",
				span,
				info,
				[
					("op", parsed_binary_op_to_json(op)),
					("left", typed_expr_to_json(left)),
					("right", typed_expr_to_json(right)),
				],
			)
		TypedLogicalExpr(op, left, right, span, info):
			typed_expr_json(
				"logical",
				span,
				info,
				[
					("op", parsed_logical_op_to_json(op)),
					("left", typed_expr_to_json(left)),
					("right", typed_expr_to_json(right)),
				],
			)
		TypedCallExpr(callee, args, span, info):
			typed_expr_json(
				"call",
				span,
				info,
				[
					("callee", typed_expr_to_json(callee)),
					("args", JsonVector(args.map(typed_expr_to_json))),
				],
			)
		TypedTupleExpr(items, span, info):
			typed_expr_json(
				"tuple",
				span,
				info,
				[("items", JsonVector(items.map(typed_expr_to_json)))],
			)
		TypedTupleDestructExpr(names, value, span, info):
			typed_expr_json(
				"tuple_destruct",
				span,
				info,
				[("names", identifiers_to_json(names)), ("value", typed_expr_to_json(value))],
			)
		TypedAssignExpr(name, scope, value, span, info):
			typed_expr_json(
				"assign",
				span,
				info,
				[
					("name", parsed_identifier_to_json(name)),
					("scope", typed_assign_scope_to_json(scope)),
					("value", typed_expr_to_json(value)),
				],
			)
		TypedSubscriptExpr(receiver, indices, span, info):
			typed_expr_json(
				"subscript",
				span,
				info,
				[
					("receiver", typed_expr_to_json(receiver)),
					("indices", JsonVector(indices.map(typed_expr_to_json))),
				],
			)
		TypedSubscriptAssignExpr(target, receiver, indices, value, span, info):
			typed_expr_json(
				"subscript_assign",
				span,
				info,
				[
					("target", optional_typed_assign_target_to_json(target)),
					("receiver", typed_expr_to_json(receiver)),
					("indices", JsonVector(indices.map(typed_expr_to_json))),
					("value", typed_expr_to_json(value)),
				],
			)
		TypedListExpr(items, span, info):
			typed_expr_json(
				"list",
				span,
				info,
				[("items", JsonVector(items.map(typed_expr_to_json)))],
			)
		TypedVectorExpr(items, span, info):
			typed_expr_json(
				"vector",
				span,
				info,
				[("items", JsonVector(items.map(typed_expr_to_json)))],
			)
		TypedDictExpr(entries, span, info):
			typed_expr_json(
				"dict",
				span,
				info,
				[("entries", JsonVector(entries.map(typed_dict_entry_to_json)))],
			)
		TypedOpaqueIntoExpr(target_type, inner, span, info):
			typed_expr_json(
				"opaque_into",
				span,
				info,
				[("target_type", type_to_json(target_type)), ("inner", typed_expr_to_json(inner))],
			)
		TypedOpaqueFromExpr(source_type, inner, span, info):
			typed_expr_json(
				"opaque_from",
				span,
				info,
				[("source_type", type_to_json(source_type)), ("inner", typed_expr_to_json(inner))],
			)
		TypedRecordExpr(fields, span, info):
			typed_expr_json("record", span, info, [("fields", typed_record_fields_to_json(fields))])
		TypedRecordUpdateExpr(receiver, fields, _, span, info):
			typed_expr_json(
				"record_update",
				span,
				info,
				[
					("receiver", typed_expr_to_json(receiver)),
					("fields", typed_record_fields_to_json(fields)),
				],
			)
		TypedFieldAccessExpr(receiver, field, span, info):
			typed_expr_json(
				"field_access",
				span,
				info,
				[
					("receiver", typed_expr_to_json(receiver)),
					("field", parsed_identifier_to_json(field)),
				],
			)
		TypedLambdaExpr(is_pure, params, return_annotation, body, span, info):
			typed_expr_json(
				"lambda",
				span,
				info,
				[
					("is_pure", JsonBool(is_pure)),
					("params", JsonVector(params.map(typed_lambda_param_to_json))),
					("return_annotation", optional_type_to_json(return_annotation)),
					("body", typed_expr_to_json(body)),
				],
			)
		TypedRangeExpr(start_expr, end_expr, span, info):
			typed_expr_json(
				"range",
				span,
				info,
				[("start", typed_expr_to_json(start_expr)), ("end", typed_expr_to_json(end_expr))],
			)
		TypedIfExpr(condition, then_branch, else_branch, span, info):
			typed_expr_json(
				"if",
				span,
				info,
				[
					("condition", typed_expr_to_json(condition)),
					("then", typed_expr_to_json(then_branch)),
					("else", optional_typed_expr_to_json(else_branch)),
				],
			)
		TypedMatchExpr(scrutinee, cases, span, info):
			typed_expr_json(
				"match",
				span,
				info,
				[
					("scrutinee", typed_expr_to_json(scrutinee)),
					("cases", JsonVector(cases.map(typed_match_case_to_json))),
				],
			)
		TypedSelectExpr(arms, span, info):
			typed_expr_json(
				"select",
				span,
				info,
				[("arms", JsonVector(arms.map(typed_select_arm_to_json)))],
			)
		TypedWhileExpr(condition, body, span, info):
			typed_expr_json(
				"while",
				span,
				info,
				[("condition", typed_expr_to_json(condition)), ("body", typed_expr_to_json(body))],
			)
		TypedForExpr(binder, iterable, loop_view, body, span, info):
			match (binder, body):
				(ParsedForNameBinder(item_name), TypedWithExpr(binding, scoped_body, _, _)):
					match binding.resource_loop_item_name:
						Some(resource_item_name):
							if resource_item_name == item_name.text:
								typed_expr_json(
									"for",
									span,
									info,
									[
										(
											"binder",
											parsed_for_binder_to_json(
												ParsedForNameBinder(binding.name),
											),
										),
										("iterable", typed_expr_to_json(iterable)),
										("loop_view", typed_loop_view_to_json(loop_view, iterable)),
										("body", typed_expr_to_json(scoped_body)),
									],
								)
							else:
								typed_for_expr_to_json(
									binder,
									iterable,
									loop_view,
									body,
									span,
									info,
								)
						None:
							typed_for_expr_to_json(binder, iterable, loop_view, body, span, info)
				_:
					typed_for_expr_to_json(binder, iterable, loop_view, body, span, info)
		TypedConcurrentBlockExpr(params, bindings, span, info):
			typed_expr_json(
				"concurrent_block",
				span,
				info,
				[
					("params", typed_concurrent_params_to_json(params)),
					("bindings", JsonVector(bindings.map(typed_concurrent_binding_to_json))),
				],
			)
		TypedConcurrentForExpr(name, iterable, params, body, span, info):
			match body:
				TypedWithExpr(binding, scoped_body, _, _):
					match binding.resource_loop_item_name:
						Some(resource_item_name):
							if resource_item_name == name.text:
								typed_concurrent_for_expr_to_json(
									binding.name,
									iterable,
									params,
									scoped_body,
									span,
									info,
								)
							else:
								typed_concurrent_for_expr_to_json(
									name,
									iterable,
									params,
									body,
									span,
									info,
								)
						None:
							typed_concurrent_for_expr_to_json(
								name,
								iterable,
								params,
								body,
								span,
								info,
							)
				_:
					typed_concurrent_for_expr_to_json(name, iterable, params, body, span, info)
		TypedDetachExpr(body, span, info):
			typed_expr_json("detach", span, info, [("body", typed_expr_to_json(body))])
		TypedAscriptionExpr(inner, target_type, span, info):
			typed_expr_json(
				"ascription",
				span,
				info,
				[("inner", typed_expr_to_json(inner)), ("target_type", type_to_json(target_type))],
			)
		TypedBlockExpr(items, span, info):
			typed_expr_json(
				"block",
				span,
				info,
				[("items", JsonVector(items.map(typed_expr_to_json)))],
			)
		TypedWithExpr(binding, body, span, info):
			typed_expr_json(
				"with",
				span,
				info,
				[
					("binding", typed_with_binding_to_json(binding)),
					("body", typed_expr_to_json(body)),
				],
			)
		TypedDebugBlockExpr(body, span, info):
			typed_expr_json("debug_block", span, info, [("body", typed_expr_to_json(body))])
		TypedVarDeclExpr(payload, info):
			typed_expr_json(
				"var_decl",
				payload.span,
				info,
				[("payload", typed_var_decl_payload_to_json(payload))],
			)
		TypedQuestionBindExpr(name, annotation, value, span, info):
			typed_expr_json(
				"question_bind",
				span,
				info,
				[
					("name", parsed_identifier_to_json(name)),
					("annotation", optional_type_to_json(annotation)),
					("value", typed_expr_to_json(value)),
				],
			)
		TypedBreakExpr(span, info):
			typed_expr_json("break", span, info, [])
		TypedContinueExpr(span, info):
			typed_expr_json("continue", span, info, [])
		TypedVoidExpr(span, info):
			typed_expr_json("void", span, info, [])
		TypedBuiltinExpr(name, span, info):
			typed_expr_json("builtin", span, info, [("name", optional_string_to_json(name))])
		TypedMissingExpr(span, info):
			typed_expr_json("missing", span, info, [])
		TypedUnsupportedExpr(label, span, info):
			typed_expr_json("unsupported", span, info, [("label", JsonString(label))])


private pure func bound_type_param_to_json(param: BoundTypeParam) -> JsonValue:
	JsonObject([
		("name", JsonString(param.name)),
		("bounds", JsonVector(param.bounds.map(
				func(bound): JsonString(bound),
			))),
	])


pure func typed_function_info_to_json(info: TypedFunctionInfo) -> JsonValue:
	JsonObject([
		("decl", parsed_function_decl_to_json(info.decl)),
		("callable_id", option_int_to_json(info.callable_id)),
		(
			"effective_type_params",
			JsonVector(info.effective_type_params.map(bound_type_param_to_json)),
		),
		("param_types", type_list_to_json(info.param_types)),
		("source_return_type", optional_type_to_json(info.source_return_type)),
		("semantic_return_type", type_to_json(info.semantic_return_type)),
		("body", optional_typed_expr_to_json(info.body)),
	])


private pure func typed_foreign_link_arg_name(link_flag: TypedForeignLinkFlag) -> String:
	match link_flag.platform:
		None:
			"link"
		Some(platform):
			"link_" + typed_foreign_link_platform_to_string(platform)


private pure func typed_foreign_function_to_bridge_json(
	info: TypedForeignFunctionInfo,
) -> JsonValue:
	include_args: List[ParsedForeignBlockArg] = info.includes.map(
		func(include_path: String) -> ParsedForeignBlockArg: {
			name = {
				text = "include",
				span = info.block_span
			},
			value = include_path,
			span = info.block_span
		},
	)
	link_args: List[ParsedForeignBlockArg] = info.link_flags.map(
		func(link_flag: TypedForeignLinkFlag) -> ParsedForeignBlockArg: {
			name = {
				text = typed_foreign_link_arg_name(link_flag),
				span = info.block_span
			},
			value = link_flag.flag,
			span = info.block_span
		},
	)

	JsonObject([
		(KIND_FIELD, JsonString("parsed")),
		(
			"decl",
			parsed_decl_to_json(
				ForeignBlockParsedDecl(
					include_args.concat(link_args),
					[info.decl],
					info.block_span,
				),
			),
		),
	])


pure func typed_global_var_info_to_json(info: TypedGlobalVarInfo) -> JsonValue:
	JsonObject([
		("decl", parsed_var_decl_to_json(info.decl)),
		("definition_id", optional_definition_id_to_json(info.definition_id)),
		("binding_type", type_to_json(info.binding_type)),
		("source_type", optional_type_to_json(info.source_type)),
		("value", typed_expr_to_json(info.value)),
	])


pure func typed_record_field_info_to_json(info: TypedRecordFieldInfo) -> JsonValue:
	JsonObject([
		("name", JsonString(info.name)),
		("source_type", type_to_json(info.source_type)),
		("semantic_type", type_to_json(info.semantic_type)),
		("definition_id", optional_definition_id_to_json(info.definition_id)),
		("declaration_span", parsed_source_span_to_json(info.declaration_span)),
		("selection_span", parsed_source_span_to_json(info.selection_span)),
	])


pure func typed_record_info_to_json(info: TypedRecordInfo) -> JsonValue:
	JsonObject([
		("decl", parsed_record_decl_to_json(info.decl)),
		("fields", JsonVector(info.fields.map(typed_record_field_info_to_json))),
	])


pure func typed_type_alias_info_to_json(info: TypedTypeAliasInfo) -> JsonValue:
	JsonObject([
		("decl", parsed_type_alias_decl_to_json(info.decl)),
		("source_target_type", type_to_json(info.source_target_type)),
		("semantic_target_type", type_to_json(info.semantic_target_type)),
	])


pure func typed_union_variant_info_to_json(info: TypedUnionVariantInfo) -> JsonValue:
	JsonObject([
		("name", JsonString(info.name)),
		("fields", type_list_to_json(info.fields)),
		("tag", json_int(info.tag)),
		("def_id", option_int_to_json(info.def_id)),
		("declaration_span", parsed_source_span_to_json(info.declaration_span)),
		("selection_span", parsed_source_span_to_json(info.selection_span)),
	])


pure func typed_union_info_to_json(info: TypedUnionInfo) -> JsonValue:
	JsonObject([
		("decl", parsed_union_decl_to_json(info.decl)),
		("variants", JsonVector(info.variants.map(typed_union_variant_info_to_json))),
	])


pure func typed_impl_info_to_json(info: TypedImplInfo) -> JsonValue:
	JsonObject([
		("decl", parsed_impl_decl_to_json(info.decl)),
		("for_type", type_to_json(info.for_type)),
		("type_params", JsonVector(info.type_params.map(bound_type_param_to_json))),
		("methods", JsonVector(info.methods.map(typed_function_info_to_json))),
	])


pure func typed_decl_to_json(decl: TypedDecl) -> JsonValue:
	match decl:
		TypedFunctionDecl(info):
			JsonObject([
				(KIND_FIELD, JsonString("function")),
				("info", typed_function_info_to_json(info)),
			])
		TypedForeignFunctionDecl(info):
			typed_foreign_function_to_bridge_json(info)
		TypedGlobalVarDecl(info):
			JsonObject([
				(KIND_FIELD, JsonString("global_var")),
				("info", typed_global_var_info_to_json(info)),
			])
		TypedRecordDecl(info):
			JsonObject([
				(KIND_FIELD, JsonString("record")),
				("info", typed_record_info_to_json(info)),
			])
		TypedTypeAliasDecl(info):
			JsonObject([
				(KIND_FIELD, JsonString("type_alias")),
				("info", typed_type_alias_info_to_json(info)),
			])
		TypedTraitDecl(info):
			-- The protocol preserves traits as parsed declarations because it has no
			-- separate trait-signature variant.
			JsonObject([
				(KIND_FIELD, JsonString("parsed")),
				("decl", parsed_decl_to_json(TraitParsedDecl(info.decl))),
			])
		TypedUnionDecl(info):
			JsonObject([
				(KIND_FIELD, JsonString("union")),
				("info", typed_union_info_to_json(info)),
			])
		TypedImplDecl(info):
			JsonObject([
				(KIND_FIELD, JsonString("impl")),
				("info", typed_impl_info_to_json(info)),
			])
		TypedPrivateDecl(inner):
			JsonObject([
				(KIND_FIELD, JsonString("private")),
				("inner", typed_decl_to_json(inner)),
			])
		TypedParsedDecl(parsed):
			JsonObject([
				(KIND_FIELD, JsonString("parsed")),
				("decl", parsed_decl_to_json(parsed)),
			])


pure func typed_program_to_json(program: TypedProgram) -> JsonValue:
	JsonObject([
		(KIND_FIELD, JsonString("typed_program")),
		("source", parsed_source_file_to_json(program.source)),
		("decls", JsonVector(program.decls.map(typed_decl_to_json))),
		("diagnostics", JsonVector(program.diagnostics.map(parse_diagnostic_to_json))),
	])


---
Emit the typed-program bridge shape one declaration at a time. This keeps the
schema owned by the existing declaration encoders while avoiding a second
program-sized JsonValue tree.
---
func emit_compiler_typed_program_json_chunks(
	program: TypedProgram,
	emit: (String) -> Void,
) -> Void:
	emit("{\"kind\":\"typed_program\",\"source\":")
	emit_json_chunks(parsed_source_file_to_json(program.source), emit)
	emit(",\"decls\":[")
	var first: Bool = True

	for decl in program.decls:
		if first:
			first = False
		else:
			emit(",")

		emit_json_chunks(typed_decl_to_json(decl), emit)

	emit("],\"diagnostics\":[")
	first = True

	for diagnostic in program.diagnostics:
		if first:
			first = False
		else:
			emit(",")

		emit_json_chunks(parse_diagnostic_to_json(diagnostic), emit)

	emit("]}")
