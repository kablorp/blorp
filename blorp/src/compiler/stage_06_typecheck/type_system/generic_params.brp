import:
	../../../lib/source: SourceSpan, source_spans_equal
	../../stage_04_modules/loaded_module: ModuleIdentity, module_identities_equal


type alias TraitRef = String


-- Generic-bound diagnostics and source rendering use `name`; accepted compiler
-- headers additionally retain this nominal identity so same-named traits from
-- different modules cannot be interchanged during obligation checking.
record BoundTraitIdentity {
	module_identity: ModuleIdentity,
	definition_id: Int,
	name: String,
	span: SourceSpan,
	compiler_builtin: Bool
}


pure func bound_trait_identities_equal(left: BoundTraitIdentity, right: BoundTraitIdentity) -> Bool:
	(
		module_identities_equal(left.module_identity, right.module_identity)
		and left.definition_id == right.definition_id
		and left.name == right.name
		and source_spans_equal(left.span, right.span)
		and left.compiler_builtin == right.compiler_builtin
	)


record BoundTypeParam {
	name: String,
	bounds: List[TraitRef],
	bound_identities: List[BoundTraitIdentity]
}


pure func bound_type_param_name(param: BoundTypeParam) -> String:
	param.name


pure func make_bound_type_param(name: String, bounds: List[String]) -> BoundTypeParam:
	{
		name = name,
		bounds = bounds,
		bound_identities = []
	}


pure func make_resolved_bound_type_param(
	name: String,
	bound_identities: List[BoundTraitIdentity],
) -> BoundTypeParam:
	{
		name = name,
		bounds = bound_identities.map(func(bound): bound.name),
		bound_identities = bound_identities
	}


pure func bound_type_param_to_parser_string(param: BoundTypeParam) -> String:
	if param.bounds.length() == 0:
		param.name
	else:
		param.name + ":" + param.bounds.join("+")
