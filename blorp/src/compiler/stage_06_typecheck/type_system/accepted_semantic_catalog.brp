-- One graph-owned capability for accepted semantic entity tables.
--
-- Category table constructors remain responsible for row kind, uniqueness,
-- and order. This boundary proves that every accepted table was issued from
-- the exact same module and definition authority. Global initializer
-- completion remains a later graph outcome owned by the existing Phase 5
-- product. Constructor and field tables are zero-copy logical views over
-- the union and record allocations that canonically own their payloads.
import:
	../../stage_04_modules/module_table: ModuleTable
	../graph/definition_index:
		DefinitionTable,
		definition_table_is_compatible_with_module_table,
		definition_table_module_table,
		definition_tables_share_provenance,
	../graph/type_identity: TypeId
	../headers/accepted_alias_graph: AcceptedAliasGraph, accepted_alias_graph_table
	../headers/accepted_record_graph: AcceptedRecordGraph, accepted_record_graph_table
	../headers/accepted_union_graph: AcceptedUnionGraph, accepted_union_graph_table
	../headers/callable_headers:
		callable_header_graph_callables,
		callable_header_graph_globals,
		callable_header_graph_trait_topology,
	../headers/implementation_headers:
		ImplementationHeaderGraph,
		implementation_header_graph_callable_headers,
		implementation_header_graph_definition_table,
		implementation_header_graph_headers,
	../headers/trait_headers: trait_topology_graph_headers, trait_topology_graph_type_headers
	../headers/type_header_graph: type_header_graph_semantic_counts
	accepted_alias_authority:
		AcceptedAliasTable,
		accepted_alias_table_alias_count,
		accepted_alias_table_definition_table,
		accepted_alias_table_type_identity_count,
	accepted_callable_authority:
		AcceptedCallableTable,
		accepted_callable_table_definition_table,
		accepted_callable_table_entry_count,
	accepted_global_authority:
		AcceptedGlobalTable,
		accepted_global_table_completed_count,
		accepted_global_table_definition_table,
		accepted_global_table_entry_count,
		accepted_global_table_is_complete,
	accepted_record_authority:
		AcceptedFieldRow,
		AcceptedRecordTable,
		accepted_record_table_definition_table,
		accepted_record_table_entry_count,
		accepted_record_table_field_count,
		accepted_record_table_fields,
	accepted_trait_implementation_authority:
		AcceptedTraitImplementationTable,
		accepted_trait_implementation_table_definition_table,
		accepted_trait_implementation_table_implementation_count,
		accepted_trait_implementation_table_trait_count,
	accepted_union_authority:
		AcceptedUnionTable,
		AcceptedUnionVariantEntry,
		accepted_union_table_constructor_count,
		accepted_union_table_definition_table,
		accepted_union_table_entry_count,
		accepted_union_table_graph_constructor_count,
		accepted_union_table_graph_entry_count,
		accepted_union_table_variants,


opaque type AcceptedConstructorTable = AcceptedUnionTable

opaque type AcceptedFieldTable = AcceptedRecordTable


record AcceptedSemanticCatalogInput {
	implementation_headers: ImplementationHeaderGraph,
	aliases: AcceptedAliasGraph,
	records: AcceptedRecordGraph,
	unions: AcceptedUnionGraph,
	callables: AcceptedCallableTable,
	globals: AcceptedGlobalTable,
	traits_and_implementations: AcceptedTraitImplementationTable
}


private record AcceptedSemanticCatalogRep {
	module_table: ModuleTable,
	definition_table: DefinitionTable,
	aliases: AcceptedAliasGraph,
	records: AcceptedRecordGraph,
	unions: AcceptedUnionGraph,
	callables: AcceptedCallableTable,
	globals: AcceptedGlobalTable,
	traits_and_implementations: AcceptedTraitImplementationTable
}


opaque type AcceptedSemanticCatalog = AcceptedSemanticCatalogRep


struct AcceptedSemanticCatalogTableCounts {
	type_identities: Int,
	aliases: Int,
	records: Int,
	fields: Int,
	unions: Int,
	constructors: Int,
	callables: Int,
	completed_globals: Int,
	traits: Int,
	implementations: Int
}


private pure func catalog_rep(catalog: AcceptedSemanticCatalog) -> AcceptedSemanticCatalogRep:
	from_opaque AcceptedSemanticCatalog(catalog)


private pure func shares_definition_table(
	expected: DefinitionTable,
	actual: DefinitionTable,
) -> Bool:
	definition_tables_share_provenance(expected, actual)


pure func accepted_semantic_catalog_expected_table_counts(
	implementation_headers: ImplementationHeaderGraph,
) -> AcceptedSemanticCatalogTableCounts:
	callable_headers = implementation_header_graph_callable_headers(implementation_headers)
	topology = callable_header_graph_trait_topology(callable_headers)
	type_headers = trait_topology_graph_type_headers(topology)
	type_counts = type_header_graph_semantic_counts(type_headers)

	{
		aliases = type_counts.aliases,
		records = type_counts.records,
		fields = type_counts.fields,
		unions = type_counts.unions,
		constructors = type_counts.constructors,
		callables = callable_header_graph_callables(callable_headers).length(),
		completed_globals = callable_header_graph_globals(callable_headers).length(),
		traits = trait_topology_graph_headers(topology).length(),
		implementations = implementation_header_graph_headers(implementation_headers).length(),
		type_identities = type_counts.type_identities
	}


private pure func semantic_table_counts_equal(
	left: AcceptedSemanticCatalogTableCounts,
	right: AcceptedSemanticCatalogTableCounts,
) -> Bool:
	(
		left.type_identities == right.type_identities
		and left.aliases == right.aliases
		and left.records == right.records
		and left.fields == right.fields
		and left.unions == right.unions
		and left.constructors == right.constructors
		and left.callables == right.callables
		and left.completed_globals == right.completed_globals
		and left.traits == right.traits
		and left.implementations == right.implementations
	)


pure func accepted_semantic_catalog_table_counts_description(
	counts: AcceptedSemanticCatalogTableCounts,
) -> String:
	"types=" + counts.type_identities.to_string() + ", aliases=" + counts.aliases.to_string() + ", records=" + counts.records.to_string() + ", fields=" + counts.fields.to_string() + ", unions=" + counts.unions.to_string() + ", constructors=" + counts.constructors.to_string() + ", callables=" + counts.callables.to_string() + ", globals=" + counts.completed_globals.to_string() + ", traits=" + counts.traits.to_string() + ", implementations=" + counts.implementations.to_string()


pure func accepted_semantic_catalog_input_table_counts(
	input: AcceptedSemanticCatalogInput,
) -> AcceptedSemanticCatalogTableCounts:
	aliases = accepted_alias_graph_table(input.aliases)
	records = accepted_record_graph_table(input.records)
	unions = accepted_union_graph_table(input.unions)
	{
		type_identities = accepted_alias_table_type_identity_count(aliases),
		aliases = accepted_alias_table_alias_count(aliases),
		records = accepted_record_table_entry_count(records),
		fields = accepted_record_table_field_count(records),
		unions = accepted_union_table_graph_entry_count(unions),
		constructors = accepted_union_table_graph_constructor_count(unions),
		callables = accepted_callable_table_entry_count(input.callables),
		completed_globals = accepted_global_table_completed_count(input.globals),
		traits = accepted_trait_implementation_table_trait_count(input.traits_and_implementations),
		implementations = accepted_trait_implementation_table_implementation_count(
			input.traits_and_implementations,
		)
	}


pure func accepted_semantic_catalog(
	input: AcceptedSemanticCatalogInput,
) -> Option[AcceptedSemanticCatalog]:
	definition_table = implementation_header_graph_definition_table(input.implementation_headers)
	module_table = definition_table_module_table(definition_table)
	aliases = accepted_alias_graph_table(input.aliases)
	records = accepted_record_graph_table(input.records)
	unions = accepted_union_graph_table(input.unions)
	valid = (
		definition_table_is_compatible_with_module_table(definition_table, module_table)
		and shares_definition_table(
			definition_table,
			accepted_alias_table_definition_table(aliases),
		)
		and shares_definition_table(
			definition_table,
			accepted_record_table_definition_table(records),
		)
		and shares_definition_table(definition_table, accepted_union_table_definition_table(unions))
		and shares_definition_table(
			definition_table,
			accepted_callable_table_definition_table(input.callables),
		)
		and shares_definition_table(
			definition_table,
			accepted_global_table_definition_table(input.globals),
		)
		and accepted_global_table_is_complete(input.globals)
		and accepted_global_table_entry_count(
			input.globals,
		) == accepted_global_table_completed_count(input.globals)
		and shares_definition_table(
			definition_table,
			accepted_trait_implementation_table_definition_table(input.traits_and_implementations),
		)
		and semantic_table_counts_equal(
			accepted_semantic_catalog_input_table_counts(input),
			accepted_semantic_catalog_expected_table_counts(input.implementation_headers),
		)
	)

	if valid:
		Some(into_opaque AcceptedSemanticCatalog({
					module_table = module_table,
					definition_table = definition_table,
					aliases = input.aliases,
					records = input.records,
					unions = input.unions,
					callables = input.callables,
					globals = input.globals,
					traits_and_implementations = input.traits_and_implementations
				}))
	else:
		None


pure func accepted_semantic_catalog_module_table(catalog: AcceptedSemanticCatalog) -> ModuleTable:
	catalog_rep(catalog).module_table


pure func accepted_semantic_catalog_definition_table(
	catalog: AcceptedSemanticCatalog,
) -> DefinitionTable:
	catalog_rep(catalog).definition_table


pure func accepted_semantic_catalog_alias_table(
	catalog: AcceptedSemanticCatalog,
) -> AcceptedAliasTable:
	accepted_alias_graph_table(catalog_rep(catalog).aliases)


pure func accepted_semantic_catalog_record_table(
	catalog: AcceptedSemanticCatalog,
) -> AcceptedRecordTable:
	accepted_record_graph_table(catalog_rep(catalog).records)


pure func accepted_semantic_catalog_union_table(
	catalog: AcceptedSemanticCatalog,
) -> AcceptedUnionTable:
	accepted_union_graph_table(catalog_rep(catalog).unions)


pure func accepted_semantic_catalog_alias_graph(
	catalog: AcceptedSemanticCatalog,
) -> AcceptedAliasGraph:
	catalog_rep(catalog).aliases


pure func accepted_semantic_catalog_record_graph(
	catalog: AcceptedSemanticCatalog,
) -> AcceptedRecordGraph:
	catalog_rep(catalog).records


pure func accepted_semantic_catalog_union_graph(
	catalog: AcceptedSemanticCatalog,
) -> AcceptedUnionGraph:
	catalog_rep(catalog).unions


pure func accepted_semantic_catalog_callable_table(
	catalog: AcceptedSemanticCatalog,
) -> AcceptedCallableTable:
	catalog_rep(catalog).callables


pure func accepted_semantic_catalog_global_table(
	catalog: AcceptedSemanticCatalog,
) -> AcceptedGlobalTable:
	catalog_rep(catalog).globals


pure func accepted_semantic_catalog_trait_implementation_table(
	catalog: AcceptedSemanticCatalog,
) -> AcceptedTraitImplementationTable:
	catalog_rep(catalog).traits_and_implementations


pure func accepted_semantic_catalog_constructor_table(
	catalog: AcceptedSemanticCatalog,
) -> AcceptedConstructorTable:
	into_opaque AcceptedConstructorTable(accepted_semantic_catalog_union_table(catalog))


pure func accepted_semantic_catalog_field_table(
	catalog: AcceptedSemanticCatalog,
) -> AcceptedFieldTable:
	into_opaque AcceptedFieldTable(accepted_semantic_catalog_record_table(catalog))


pure func accepted_constructor_table_entry_count(table: AcceptedConstructorTable) -> Int:
	accepted_union_table_constructor_count(from_opaque AcceptedConstructorTable(table))


pure func accepted_field_table_entry_count(table: AcceptedFieldTable) -> Int:
	accepted_record_table_field_count(from_opaque AcceptedFieldTable(table))


pure func accepted_constructor_table_variants(
	table: AcceptedConstructorTable,
	issuing_table: DefinitionTable,
	parent: TypeId,
) -> Option[List[AcceptedUnionVariantEntry]]:
	accepted_union_table_variants(
		from_opaque AcceptedConstructorTable(table),
		issuing_table,
		parent,
	)


pure func accepted_field_table_fields(
	table: AcceptedFieldTable,
	issuing_table: DefinitionTable,
	parent: TypeId,
) -> Option[List[AcceptedFieldRow]]:
	accepted_record_table_fields(from_opaque AcceptedFieldTable(table), issuing_table, parent)


pure func accepted_semantic_catalog_table_counts(
	catalog: AcceptedSemanticCatalog,
) -> AcceptedSemanticCatalogTableCounts:
	representation = catalog_rep(catalog)
	aliases = accepted_alias_graph_table(representation.aliases)
	records = accepted_record_graph_table(representation.records)
	unions = accepted_union_graph_table(representation.unions)
	{
		type_identities = accepted_alias_table_type_identity_count(aliases),
		aliases = accepted_alias_table_alias_count(aliases),
		records = accepted_record_table_entry_count(records),
		fields = accepted_record_table_field_count(records),
		unions = accepted_union_table_entry_count(unions),
		constructors = accepted_union_table_constructor_count(unions),
		callables = accepted_callable_table_entry_count(representation.callables),
		completed_globals = accepted_global_table_completed_count(representation.globals),
		traits = accepted_trait_implementation_table_trait_count(
			representation.traits_and_implementations,
		),
		implementations = accepted_trait_implementation_table_implementation_count(
			representation.traits_and_implementations,
		)
	}
