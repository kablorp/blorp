-- Explicit type widening decisions for frontend inference.
--
-- Widening changes the runtime value slot type, not the semantic type. Keeping
-- those two facts together lets later inference explain why singleton
-- dimensions, ranges, or target-typed literals were intentionally represented
-- by a broader runtime type.
import:
	../../stage_03_parse/parsed_ast:
		ParsedBinaryOp(
			ParsedAddOp,
			ParsedDivideOp,
			ParsedEqualOp,
			ParsedGreaterEqualOp,
			ParsedGreaterOp,
			ParsedLessEqualOp,
			ParsedLessOp,
			ParsedModuloOp,
			ParsedMultiplyOp,
			ParsedNotEqualOp,
			ParsedSubtractOp,
		),
	context: Context, meta_origin_name
	semantic_type:
		SemanticType(
			SemanticConstIntType,
			SemanticMetaType,
			SemanticNamedType,
			SemanticRangeType,
			SemanticSelfType,
			SemanticTypeVar,
			SemanticVarDimsType,
		),
		collect_type_vars,
		is_any_float_type,
		is_any_integer_type,
		is_dim_var_name,
		is_scalar_int_value_type as type_is_scalar_int_value_type,
		scalar_int_value_type as type_scalar_int_value_type,
		types_equal,


enum CollectionKind:
	ListLiteral
	VectorLiteral
	DictLiteral
	SetLiteral


union TypeWideningReason:
	MutableBindingWidening
	ArgumentSlot
	CollectionElement(CollectionKind)
	BitwiseOperator
	MethodReceiver
	RangeProofErasure
	TupleLiteral
	NumericOperator(ParsedBinaryOp)


union TypeWideningDecision:
	TypeKeep(SemanticType)
	TypeWiden(SemanticType, SemanticType, TypeWideningReason)


union ValueSlot:
	KeptValueSlot(SemanticType)
	WidenedValueSlot(SemanticType, SemanticType, TypeWideningReason)


private pure func collection_kinds_equal(left: CollectionKind, right: CollectionKind) -> Bool:
	match left:
		ListLiteral:
			match right:
				ListLiteral:
					True
				_:
					False
		VectorLiteral:
			match right:
				VectorLiteral:
					True
				_:
					False
		DictLiteral:
			match right:
				DictLiteral:
					True
				_:
					False
		SetLiteral:
			match right:
				SetLiteral:
					True
				_:
					False


private pure func binary_ops_equal(left: ParsedBinaryOp, right: ParsedBinaryOp) -> Bool:
	match left:
		ParsedAddOp:
			match right:
				ParsedAddOp:
					True
				_:
					False
		ParsedSubtractOp:
			match right:
				ParsedSubtractOp:
					True
				_:
					False
		ParsedMultiplyOp:
			match right:
				ParsedMultiplyOp:
					True
				_:
					False
		ParsedDivideOp:
			match right:
				ParsedDivideOp:
					True
				_:
					False
		ParsedModuloOp:
			match right:
				ParsedModuloOp:
					True
				_:
					False
		ParsedEqualOp:
			match right:
				ParsedEqualOp:
					True
				_:
					False
		ParsedNotEqualOp:
			match right:
				ParsedNotEqualOp:
					True
				_:
					False
		ParsedLessOp:
			match right:
				ParsedLessOp:
					True
				_:
					False
		ParsedLessEqualOp:
			match right:
				ParsedLessEqualOp:
					True
				_:
					False
		ParsedGreaterOp:
			match right:
				ParsedGreaterOp:
					True
				_:
					False
		ParsedGreaterEqualOp:
			match right:
				ParsedGreaterEqualOp:
					True
				_:
					False


pure func widening_reasons_equal(left: TypeWideningReason, right: TypeWideningReason) -> Bool:
	match left:
		MutableBindingWidening:
			match right:
				MutableBindingWidening:
					True
				_:
					False
		ArgumentSlot:
			match right:
				ArgumentSlot:
					True
				_:
					False
		CollectionElement(left_kind):
			match right:
				CollectionElement(right_kind):
					collection_kinds_equal(left_kind, right_kind)
				_:
					False
		BitwiseOperator:
			match right:
				BitwiseOperator:
					True
				_:
					False
		MethodReceiver:
			match right:
				MethodReceiver:
					True
				_:
					False
		RangeProofErasure:
			match right:
				RangeProofErasure:
					True
				_:
					False
		TupleLiteral:
			match right:
				TupleLiteral:
					True
				_:
					False
		NumericOperator(left_op):
			match right:
				NumericOperator(right_op):
					binary_ops_equal(left_op, right_op)
				_:
					False


pure func widening_semantic_type(slot: ValueSlot) -> SemanticType:
	match slot:
		KeptValueSlot(typ):
			typ
		WidenedValueSlot(semantic_type, _, _):
			semantic_type


pure func widening_decision(slot: ValueSlot) -> TypeWideningDecision:
	match slot:
		KeptValueSlot(typ):
			TypeKeep(typ)
		WidenedValueSlot(semantic_type, value_type, reason):
			TypeWiden(semantic_type, value_type, reason)


pure func widening_value_type(slot: ValueSlot) -> SemanticType:
	match slot:
		KeptValueSlot(typ):
			typ
		WidenedValueSlot(_, value_type, _):
			value_type


pure func widening_reason(slot: ValueSlot) -> Option[TypeWideningReason]:
	match slot:
		KeptValueSlot(_):
			None
		WidenedValueSlot(_, _, reason):
			Some(reason)


pure func scalar_int_value_type(typ: SemanticType) -> SemanticType:
	type_scalar_int_value_type(typ)


pure func is_scalar_int_value_type(typ: SemanticType) -> Bool:
	type_is_scalar_int_value_type(typ)


private pure func target_slot(
	reason: TypeWideningReason,
	semantic_type: SemanticType,
	value_type: SemanticType,
) -> ValueSlot:
	if types_equal(semantic_type, value_type):
		KeptValueSlot(semantic_type)
	else:
		WidenedValueSlot(semantic_type, value_type, reason)


private pure func singleton_int_slot(
	reason: TypeWideningReason,
	semantic_type: SemanticType,
) -> ValueSlot:
	target_slot(reason, semantic_type, scalar_int_value_type(semantic_type))


private pure func param_accepts_singleton_argument_widening(
	context: Context,
	param_type: SemanticType,
) -> Bool:
	match param_type:
		SemanticMetaType(meta_id):
			not is_dim_var_name(meta_origin_name(context, meta_id))
		SemanticSelfType:
			True
		_:
			False


private pure func can_use_concrete_argument_target(
	target_type: SemanticType,
	semantic_type: SemanticType,
) -> Bool:
	match target_type:
		SemanticNamedType(name, args):
			(
				args.length() == 0
				and ((
					is_any_integer_type(target_type) and is_scalar_int_value_type(semantic_type)
					or is_any_float_type(target_type) and types_equal(
						semantic_type,
						SemanticNamedType("Float", []),
					)
					or name == "String" and match semantic_type:
						SemanticNamedType(semantic_name, semantic_args):
							semantic_name == "LiteralString" and semantic_args.length() == 0
						_:
							False
				))
			)
		SemanticRangeType(bound):
			match semantic_type:
				SemanticConstIntType(value):
					if value < 0:
						False
					else:
						match bound:
							SemanticConstIntType(size):
								value < size
							SemanticTypeVar(name):
								is_dim_var_name(name) and value == 0
							_:
								False
				_:
					False
		_:
			False


private pure func target_keeps_semantic_slot(target_type: SemanticType) -> Bool:
	if collect_type_vars(target_type).length() != 0:
		True
	else if is_scalar_int_value_type(target_type):
		True
	else:
		match target_type:
			SemanticVarDimsType(_):
				True
			_:
				False


pure func mutable_binding_slot(semantic_type: SemanticType) -> ValueSlot:
	singleton_int_slot(MutableBindingWidening, semantic_type)


pure func argument_slot(
	context: Context,
	param_type: SemanticType,
	arg_type: SemanticType,
) -> ValueSlot:
	if param_accepts_singleton_argument_widening(context, param_type):
		singleton_int_slot(ArgumentSlot, arg_type)
	else:
		KeptValueSlot(arg_type)


pure func argument_target_slot(
	context: Context,
	param_type: SemanticType,
	semantic_type: SemanticType,
) -> ValueSlot:
	if param_accepts_singleton_argument_widening(context, param_type):
		singleton_int_slot(ArgumentSlot, semantic_type)
	else if can_use_concrete_argument_target(param_type, semantic_type):
		target_slot(ArgumentSlot, semantic_type, param_type)
	else if target_keeps_semantic_slot(param_type):
		KeptValueSlot(semantic_type)
	else:
		KeptValueSlot(semantic_type)


pure func collection_element_slot(kind: CollectionKind, semantic_type: SemanticType) -> ValueSlot:
	singleton_int_slot(CollectionElement(kind), semantic_type)


pure func collection_element_target_slot(
	kind: CollectionKind,
	target_type: SemanticType,
	semantic_type: SemanticType,
) -> ValueSlot:
	target_slot(CollectionElement(kind), semantic_type, target_type)


pure func bitwise_operand_target_slot(
	target_type: SemanticType,
	semantic_type: SemanticType,
) -> ValueSlot:
	target_slot(BitwiseOperator, semantic_type, target_type)


pure func method_receiver_slot(semantic_type: SemanticType) -> ValueSlot:
	singleton_int_slot(MethodReceiver, semantic_type)


pure func range_proof_slot(semantic_type: SemanticType) -> ValueSlot:
	target_slot(RangeProofErasure, semantic_type, scalar_int_value_type(semantic_type))


pure func tuple_literal_slot(semantic_type: SemanticType, value_type: SemanticType) -> ValueSlot:
	target_slot(TupleLiteral, semantic_type, value_type)


pure func numeric_operand_slot(op: ParsedBinaryOp, semantic_type: SemanticType) -> ValueSlot:
	singleton_int_slot(NumericOperator(op), semantic_type)


pure func numeric_operand_type(op: ParsedBinaryOp, typ: SemanticType) -> SemanticType:
	widening_value_type(numeric_operand_slot(op, typ))
