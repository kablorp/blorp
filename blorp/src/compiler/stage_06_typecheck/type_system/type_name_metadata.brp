---
`ResourceSource` is not on the ABI list, so every importing module sees it as
`stream::ResourceSource` (the `stream` module declares it but never names it in
a signature, so no module sees it bare). The bare spelling is deliberately not
accepted: a bare `ResourceSource` is a type the current module declared
itself, never the stdlib type.
---
private RESOURCE_SOURCE_SEMANTIC_TYPE_NAME: String = "stream::ResourceSource"


---
Type names as the typechecker spells them (`SemanticNamedType`): the bare
name for a type declared in the current module or listed by
`is_global_abi_type_name`, otherwise the canonical `module::Type` from
`canonical_module_type_name`. `Stream` and `FallibleStream` are ABI-listed, so
they are always bare here; `ResourceSource` is not, so importers see
`stream::ResourceSource`. The flattened `module__Type` spelling only exists
after Core lowering and is read by the Core-side predicates in
`stage_09_core/type_policy.brp`.
---
pure func is_stream_type_name(name: String) -> Bool:
	name == "Stream"


pure func is_fallible_stream_type_name(name: String) -> Bool:
	name == "FallibleStream"


pure func is_one_shot_stream_type_name(name: String) -> Bool:
	is_stream_type_name(name) or is_fallible_stream_type_name(name)


pure func type_name_has_compiler_structural_equality(name: String) -> Bool:
	match name:
		"String" | "Bytes" | "Dict" | "Set":
			True
		_:
			False


---
Generic types whose stdlib Equatable and Hashable implementations work
component-wise, so they are Equatable (or Hashable) exactly when all their
type arguments are.
---
pure func type_name_has_componentwise_equality(name: String) -> Bool:
	match name:
		"List" | "Option" | "Result":
			True
		_:
			False


pure func is_resource_source_type_name(name: String) -> Bool:
	name == RESOURCE_SOURCE_SEMANTIC_TYPE_NAME
