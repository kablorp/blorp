-- Native snapshots are boundary values, never a second language product model.
-- The canonical declaration identity selects this schema; names on user records
-- cannot select a native layout. Field order matches runtime_decl.c/runtime.c.
import:
	language_surface_manifest:
		DeclaredAbiType(DeclaredAbiMemStats, DeclaredAbiSchedulerStats),
	semantic_type: SemanticType(SemanticNamedType),


enum NativeSnapshotKind:
	MemorySnapshot
	SchedulerSnapshot


pure func native_snapshot_kind(identity: DeclaredAbiType) -> Option[NativeSnapshotKind]:
	match identity:
		DeclaredAbiMemStats: Some(MemorySnapshot)
		DeclaredAbiSchedulerStats: Some(SchedulerSnapshot)
		_: None


pure func native_snapshot_fields(abi: NativeSnapshotKind) -> List[String]:
	match abi:
		MemorySnapshot:
			[
				"total_allocations", "total_releases", "current_objects", "bytes_allocated",
				"bytes_available", "allocator_bytes_in_use", "allocator_bytes_available",
				"backing_libc_malloc_events", "raw_buffer_malloc_events", "raw_buffer_calloc_events",
				"raw_buffer_realloc_events", "raw_buffer_aligned_events", "cleanup_scratch_events",
				"fiber_mmap_events", "oracle_stats_active", "memory_stats_active",
			]
		SchedulerSnapshot:
			[
				"tasks_spawned", "tasks_cancelled", "task_timeouts", "fibers_created", "fibers_reused",
				"fibers_completed", "fiber_resumes", "fiber_parks", "fiber_schedule_transitions",
				"cooperative_yields", "channel_send_parks", "channel_recv_parks", "runnable_enqueues",
				"run_queue_pops", "timer_inserts", "timer_expirations", "reactor_control_wakes",
				"reactor_poll_wakes", "reactor_ready_events", "reactor_waiter_wakes", "stack_allocations",
				"stack_reuses", "work_steals", "run_queue_lock_contentions", "timer_lock_contentions",
				"tracked_active_tasks", "tracked_parked_fibers", "worker_count", "runnable_count",
				"timers_pending",
			]


pure func native_snapshot_c_type(abi: NativeSnapshotKind) -> String:
	match abi:
		MemorySnapshot: "blorp_MemStats"
		SchedulerSnapshot: "blorp_SchedulerStats"


pure func native_snapshot_c_function(abi: NativeSnapshotKind) -> String:
	match abi:
		MemorySnapshot: "blorp_get_mem_stats"
		SchedulerSnapshot: "blorp_get_scheduler_stats"


-- Run after source types have resolved, before any native adapter is admitted.
pure func native_snapshot_field_error(
	abi: NativeSnapshotKind,
	fields: List[(String, SemanticType)],
) -> Option[String]:
	expected = native_snapshot_fields(abi)
	if fields.length() != expected.length():
		Some("native snapshot fields must match the declared runtime schema; restore its ordered Int fields")
	else:
		var error: Option[String] = None
		for entry in fields.enumerate():
			if expected.get(entry[0]) != Some(entry[1][0]):
				error = Some("native snapshot field order must match the declared runtime schema; restore its ordered Int fields")
				break
			match entry[1][1]:
				SemanticNamedType("Int", []): void
				_:
					error = Some("native snapshot fields must have type Int; use a separate record for other data")
					break
		error
