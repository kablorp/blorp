-- The identity of a trait: one scalar that names either a graph trait or a
-- compiler builtin, without depending on the module graph or the builtin
-- registry, so the environment, the header graph and Core can all hold it.
--
-- Encoding: a graph trait is its non-negative `DefinitionId` (the runtime
-- value); a compiler builtin is `-(registry_id + 1)`. A graph id is meaningful
-- only with the `DefinitionTable` that issued it. This module owns the
-- encoding; `declaration_skeleton.brp` layers the table-backed accessors
-- (`trait_id_name`, `trait_id_module_id`, ...) on top.
---
One scalar naming a graph trait or a compiler builtin.

Invariants of the encoded key (see `trait_id_storage_key`):
- a graph trait's key is its `DefinitionId` runtime value, so it is `>= 0`;
  `graph_trait_id` rejects a negative value;
- a builtin's key is `-(registry_index + 1)`, so it lies in
  `-1 .. -BUILTIN_TRAIT_NAMES.length()`; only registry indexes build one.
---
opaque type TraitId = Int

private BUILTIN_TRAIT_ENCODING_OFFSET: Int = 1


---
The graph trait whose `DefinitionId` has the runtime value `definition_id`, or
`None` for a negative value, which would otherwise alias a builtin's encoding.
Callers hold the value from a definition table row or a claimed definition id;
a builtin is never built this way.
---
pure func graph_trait_id(definition_id: Int) -> Option[TraitId]:
	if definition_id < 0:
		None
	else:
		Some(into_opaque TraitId(definition_id))


---
The builtin trait at position `registry_index` of the builtin registry
(`builtins.brp`'s `BUILTIN_TRAITS` order). `trait_identity` tests pin every
constant below against `builtin_trait_registry_id`, so a reordered registry
fails the test instead of renumbering traits.
---
pure func builtin_trait_id_at_registry_index(registry_index: Int) -> TraitId:
	into_opaque TraitId(0 - registry_index - BUILTIN_TRAIT_ENCODING_OFFSET)


---
The encoded scalar, for hashing, ordering and `trait_id_definition_id`.
---
pure func trait_id_storage_key(id: TraitId) -> Int:
	from_opaque TraitId(id)


---
Whether two identities name the same trait: their encoded keys are equal.
---
pure func trait_ids_equal(left: TraitId, right: TraitId) -> Bool:
	trait_id_storage_key(left) == trait_id_storage_key(right)


implements Equatable for TraitId:
	pure func equals(left: TraitId, right: TraitId) -> Bool:
		trait_ids_equal(left, right)


---
Whether the trait is a compiler builtin (a negative key) rather than a graph trait.
---
pure func trait_id_is_compiler_builtin(id: TraitId) -> Bool:
	trait_id_storage_key(id) < 0


---
The registry position of a builtin trait id, `None` for a graph trait.
---
pure func trait_id_registry_index(id: TraitId) -> Option[Int]:
	key = trait_id_storage_key(id)

	if key < 0:
		Some(0 - key - BUILTIN_TRAIT_ENCODING_OFFSET)
	else:
		None


---
Pinned identities of the builtin traits the compiler names in code. The
position is the trait's index in the builtin registry.
---
TRAIT_ID_STRINGABLE: TraitId = builtin_trait_id_at_registry_index(0)

TRAIT_ID_EQUATABLE: TraitId = builtin_trait_id_at_registry_index(1)

TRAIT_ID_ORDERABLE: TraitId = builtin_trait_id_at_registry_index(2)

TRAIT_ID_HAS_LENGTH: TraitId = builtin_trait_id_at_registry_index(3)

TRAIT_ID_INTEGER: TraitId = builtin_trait_id_at_registry_index(4)

TRAIT_ID_FLOATING_POINT: TraitId = builtin_trait_id_at_registry_index(5)

TRAIT_ID_ADDABLE: TraitId = builtin_trait_id_at_registry_index(6)

TRAIT_ID_SUBTRACTABLE: TraitId = builtin_trait_id_at_registry_index(7)

TRAIT_ID_MULTIPLIABLE: TraitId = builtin_trait_id_at_registry_index(8)

TRAIT_ID_DIVISIBLE: TraitId = builtin_trait_id_at_registry_index(9)

TRAIT_ID_MODULABLE: TraitId = builtin_trait_id_at_registry_index(10)

TRAIT_ID_NEGATABLE: TraitId = builtin_trait_id_at_registry_index(11)

TRAIT_ID_HAS_ZERO: TraitId = builtin_trait_id_at_registry_index(12)

TRAIT_ID_HAS_ONE: TraitId = builtin_trait_id_at_registry_index(13)

TRAIT_ID_ABSOLUTE: TraitId = builtin_trait_id_at_registry_index(14)

TRAIT_ID_BOUNDED: TraitId = builtin_trait_id_at_registry_index(15)

TRAIT_ID_HASHABLE: TraitId = builtin_trait_id_at_registry_index(16)

TRAIT_ID_TO_BOOL: TraitId = builtin_trait_id_at_registry_index(17)

TRAIT_ID_LOGICAL: TraitId = builtin_trait_id_at_registry_index(18)

TRAIT_ID_TO_INT: TraitId = builtin_trait_id_at_registry_index(19)

TRAIT_ID_TO_FLOAT: TraitId = builtin_trait_id_at_registry_index(20)

TRAIT_ID_TO_FIXED: TraitId = builtin_trait_id_at_registry_index(21)

TRAIT_ID_TO_CHAR: TraitId = builtin_trait_id_at_registry_index(22)

TRAIT_ID_SIGNED_INTEGER: TraitId = builtin_trait_id_at_registry_index(23)

TRAIT_ID_UNSIGNED_INTEGER: TraitId = builtin_trait_id_at_registry_index(24)

TRAIT_ID_NUMERIC: TraitId = builtin_trait_id_at_registry_index(25)

TRAIT_ID_FIXED_POINT: TraitId = builtin_trait_id_at_registry_index(26)

TRAIT_ID_COPYABLE: TraitId = builtin_trait_id_at_registry_index(27)

TRAIT_ID_CLONEABLE: TraitId = builtin_trait_id_at_registry_index(28)
