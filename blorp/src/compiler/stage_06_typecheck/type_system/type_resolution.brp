import:
	../../stage_04_modules/module_table: ModuleId, ModuleTable, module_table_canonical_path
	../graph/source_name_table: GraphSourceNameTable, graph_source_name_table_module_table
	../modules/module_view:
		ModuleView,
		module_view_find_graph_module_alias,
		module_view_find_standalone_module_alias,
		module_view_graph_has_exact_catalog,
		module_view_has_graph_source_names,
		module_view_import_binding_count,
		module_view_accepted_alias_authority,
		module_view_accepted_record_authority,
		module_view_accepted_union_authority,
	accepted_alias_authority: accepted_alias_find_type_params
	accepted_record_authority: accepted_record_find_type_params
	accepted_union_authority: accepted_union_find_type_params
	env:
		Env, env_disambiguate_nominal_dim_application, env_resolve_alias,
		env_get_record, env_get_type_decl, env_get_alias, env_get_opaque_alias
	semantic_type:
		SemanticType(
			SemanticArrayType, SemanticConstIntType, SemanticDimOpType, SemanticFunctionType,
			SemanticMetaType, SemanticNamedType, SemanticRangeType, SemanticSelfType,
			SemanticTupleType, SemanticTypeVar, SemanticVarDimsType,
		),
		canonical_module_type_name,
		is_dimension_parameter_name,
		split_qualified_type_name,


private pure func accepted_nominal_parameters(
	view: ModuleView,
	env: Env,
	name: String,
) -> Option[List[String]]:
	record_parameters = match module_view_accepted_record_authority(view):
		Some(authority):
			accepted_record_find_type_params(authority, name)
		None:
			match env_get_record(env, name):
				Some((parameters, _)): Some(parameters)
				None: None
	if record_parameters.is_some():
		record_parameters
	else:
		union_parameters = match module_view_accepted_union_authority(view):
			Some(authority): accepted_union_find_type_params(authority, name)
			None:
				match env_get_type_decl(env, name):
					Some((parameters, _)): Some(parameters)
					None: None
		if union_parameters.is_some():
			union_parameters
		else:
			match module_view_accepted_alias_authority(view):
				Some(authority):
					accepted_alias_find_type_params(authority, name)
				None:
					match env_get_alias(env, name):
						Some((parameters, _)): Some(parameters)
						None:
							match env_get_opaque_alias(env, name):
								Some((parameters, _, _)): Some(parameters)
								None: None


private pure func nominal_dimension_list_if_changed(
	view: ModuleView,
	env: Env,
	types: List[SemanticType],
) -> Option[List[SemanticType]]:
	var resolved = types
	var changed: Bool = False
	var index: Int = 0
	for typ in types:
		match nominal_dimensions_if_changed(view, env, typ):
			Some(next):
				resolved = resolved.set(index, next)
				changed = True
			None: void
		index += 1
	if changed:
		Some(resolved)
	else:
		None


private pure func nominal_dimensions_if_changed(
	view: ModuleView,
	env: Env,
	typ: SemanticType,
) -> Option[SemanticType]:
	match typ:
		SemanticArrayType(element, dims):
			dimensions = nominal_dimension_list_if_changed(view, env, dims)
			nominal = match element:
				SemanticNamedType(name, []):
					match accepted_nominal_parameters(view, env, name):
						Some(parameters):
							if (
								parameters.length() > 0
								and parameters.all(is_dimension_parameter_name)
								and parameters.length() == dims.length()
							):
								Some(SemanticNamedType(name, dimensions.get_or(dims)))
							else:
								None
						None: None
				_: None
			match nominal:
				Some(_): nominal
				None:
					resolved_element = nominal_dimensions_if_changed(view, env, element)
					if resolved_element.is_some() or dimensions.is_some():
						Some(SemanticArrayType(
							resolved_element.get_or(element),
							dimensions.get_or(dims),
						))
					else:
						None
		SemanticNamedType(name, args):
			match nominal_dimension_list_if_changed(view, env, args):
				Some(next): Some(SemanticNamedType(name, next))
				None: None
		SemanticFunctionType(is_pure, params, result):
			next_params = nominal_dimension_list_if_changed(view, env, params)
			next_result = nominal_dimensions_if_changed(view, env, result)
			if next_params.is_some() or next_result.is_some():
				Some(SemanticFunctionType(
					is_pure,
					next_params.get_or(params),
					next_result.get_or(result),
				))
			else:
				None
		SemanticTupleType(elements):
			match nominal_dimension_list_if_changed(view, env, elements):
				Some(next): Some(SemanticTupleType(next))
				None: None
		SemanticRangeType(inner):
			match nominal_dimensions_if_changed(view, env, inner):
				Some(next): Some(SemanticRangeType(next))
				None: None
		SemanticDimOpType(op, left, right):
			next_left = nominal_dimensions_if_changed(view, env, left)
			next_right = nominal_dimensions_if_changed(view, env, right)
			if next_left.is_some() or next_right.is_some():
				Some(SemanticDimOpType(op, next_left.get_or(left), next_right.get_or(right)))
			else:
				None
		_: None


-- Headers resolve against declaration skeletons; body annotations must use
-- their installed accepted authority instead. An authority miss cannot revive
-- an obsolete environment declaration. Preserve unchanged type trees and lists.
pure func resolve_nominal_dimension_applications(
	view: ModuleView,
	env: Env,
	typ: SemanticType,
) -> SemanticType:
	if (
		module_view_accepted_record_authority(view).is_none()
		and module_view_accepted_union_authority(view).is_none()
		and module_view_accepted_alias_authority(view).is_none()
	):
		env_disambiguate_nominal_dim_application(env, typ)
	else:
		nominal_dimensions_if_changed(view, env, typ).get_or(typ)


fixed union AliasPolicy:
	ExpandAliases
	PreserveAliasSource


record TypeResolutionContext {
	env: Env,
	module_aliases: List[(String, String)],
	alias_policy: AliasPolicy
}


record ResolvedType {
	source: SemanticType,
	canonical: SemanticType
}


private union ModuleAliasLookup:
	StandaloneModuleAliasLookup(List[(String, String)])
	GraphModuleAliasLookup(Option[ModuleTable], ModuleView)


pure func type_resolution_context(
	env: Env,
	module_aliases: List[(String, String)],
) -> TypeResolutionContext:
	{
		env = env,
		module_aliases = module_aliases,
		alias_policy = ExpandAliases
	}


pure func type_resolution_context_with_alias_policy(
	env: Env,
	module_aliases: List[(String, String)],
	alias_policy: AliasPolicy,
) -> TypeResolutionContext:
	{
		env = env,
		module_aliases = module_aliases,
		alias_policy = alias_policy
	}


private pure func find_module_alias(
	lookup: ModuleAliasLookup,
	alias_name: String,
) -> Option[String]:
	match lookup:
		StandaloneModuleAliasLookup(module_aliases):
			var result: Option[String] = None

			for pair in module_aliases:
				if pair[0] == alias_name:
					result = Some(pair[1])
					break

			result
		GraphModuleAliasLookup(module_table, view):
			graph_target = match module_table:
				Some(table):
					match module_view_find_graph_module_alias(view, alias_name):
						Some(module_id):
							module_table_canonical_path(table, module_id)
						None:
							None
				None:
					None

			match graph_target:
				Some(path):
					Some(path)
				None:
					module_view_find_standalone_module_alias(view, alias_name)


private pure func resolve_qualified_type_name_if_changed(
	module_aliases: ModuleAliasLookup,
	name: String,
) -> Option[String]:
	match split_qualified_type_name(name):
		Some(split):
			alias_name: String = name.substring(0, split.alias_end)

			match find_module_alias(module_aliases, alias_name):
				Some(module_path):
					local_name: String = name.substring(
						split.local_name_start,
						name.length() - split.local_name_start,
					)

					Some(canonical_module_type_name(module_path, local_name))
				None:
					None
		None:
			None


---
List.set clones shared storage on the first changed element, then updates
that unique list in place. A fully unchanged list retains its original tree.
---
private pure func resolve_qualified_type_list_if_changed(
	module_aliases: ModuleAliasLookup,
	types: List[SemanticType],
) -> Option[List[SemanticType]]:
	var resolved: List[SemanticType] = types
	var changed: Bool = False
	var index: Int = 0

	for typ in types:
		match resolve_qualified_type_names_if_changed(module_aliases, typ):
			Some(resolved_type):
				resolved = resolved.set(index, resolved_type)
				changed = True
			None:
				void

		index += 1

	if changed:
		Some(resolved)
	else:
		None


private pure func resolve_qualified_type_names_if_changed(
	module_aliases: ModuleAliasLookup,
	typ: SemanticType,
) -> Option[SemanticType]:
	match typ:
		SemanticNamedType(name, args):
			name_result = resolve_qualified_type_name_if_changed(module_aliases, name)
			args_result = resolve_qualified_type_list_if_changed(module_aliases, args)

			if name_result.is_some() or args_result.is_some():
				Some(SemanticNamedType(name_result.get_or(name), args_result.get_or(args)))
			else:
				None
		SemanticArrayType(element, dims):
			element_result = resolve_qualified_type_names_if_changed(module_aliases, element)
			dims_result = resolve_qualified_type_list_if_changed(module_aliases, dims)

			if element_result.is_some() or dims_result.is_some():
				Some(SemanticArrayType(element_result.get_or(element), dims_result.get_or(dims)))
			else:
				None
		SemanticFunctionType(is_pure, params, return_type):
			params_result = resolve_qualified_type_list_if_changed(module_aliases, params)
			return_result = resolve_qualified_type_names_if_changed(module_aliases, return_type)

			if params_result.is_some() or return_result.is_some():
				Some(
					SemanticFunctionType(
						is_pure,
						params_result.get_or(params),
						return_result.get_or(return_type),
					),
				)
			else:
				None
		SemanticTupleType(elements):
			match resolve_qualified_type_list_if_changed(module_aliases, elements):
				Some(resolved_elements):
					Some(SemanticTupleType(resolved_elements))
				None:
					None
		SemanticRangeType(inner):
			match resolve_qualified_type_names_if_changed(module_aliases, inner):
				Some(resolved_inner):
					Some(SemanticRangeType(resolved_inner))
				None:
					None
		SemanticDimOpType(op, left, right):
			left_result = resolve_qualified_type_names_if_changed(module_aliases, left)
			right_result = resolve_qualified_type_names_if_changed(module_aliases, right)

			if left_result.is_some() or right_result.is_some():
				Some(SemanticDimOpType(op, left_result.get_or(left), right_result.get_or(right)))
			else:
				None
		SemanticTypeVar(_, _):
			None
		SemanticConstIntType(_):
			None
		SemanticSelfType:
			None
		SemanticVarDimsType(_):
			None
		SemanticMetaType(_, _):
			None


pure func resolve_qualified_type_names(
	module_aliases: List[(String, String)],
	typ: SemanticType,
) -> SemanticType:
	if module_aliases.is_empty():
		typ
	else:
		match resolve_qualified_type_names_if_changed(
			StandaloneModuleAliasLookup(module_aliases),
			typ,
		):
			Some(resolved):
				resolved
			None:
				typ


---
A graph view can carry valid ModuleIds from another selected module or
compilation. Check its exact owner once before traversing a type tree;
individual dotted-name lookups can then use the keyed occupancy directly.
---
pure func resolve_graph_qualified_type_names(
	graph_names: Option[GraphSourceNameTable],
	current_module_id: Option[ModuleId],
	view: ModuleView,
	typ: SemanticType,
) -> SemanticType:
	module_table = graph_names.map(graph_source_name_table_module_table)

	if module_view_import_binding_count(view) == 0:
		typ
	else if (
		module_view_has_graph_source_names(view)
		and not graph_alias_view_matches_owner(view, graph_names, current_module_id)
	):
		typ
	else:
		match resolve_qualified_type_names_if_changed(
			GraphModuleAliasLookup(module_table, view),
			typ,
		):
			Some(resolved):
				resolved
			None:
				typ


private pure func graph_alias_view_matches_owner(
	view: ModuleView,
	graph_names: Option[GraphSourceNameTable],
	current_module_id: Option[ModuleId],
) -> Bool:
	match (graph_names, current_module_id):
		(Some(names), Some(module_id)):
			module_view_graph_has_exact_catalog(view, names, module_id)
		_:
			False


private pure func apply_alias_policy(
	context: TypeResolutionContext,
	typ: SemanticType,
) -> SemanticType:
	match context.alias_policy:
		ExpandAliases:
			env_resolve_alias(context.env, typ)
		PreserveAliasSource:
			typ


pure func resolve_type(
	context: TypeResolutionContext,
	source: SemanticType,
	qualify_owner: pure (SemanticType) -> SemanticType,
) -> ResolvedType:
	qualified: SemanticType = resolve_qualified_type_names(context.module_aliases, source)
	owned: SemanticType = qualify_owner(qualified)
	nominal: SemanticType = env_disambiguate_nominal_dim_application(context.env, owned)
	aliased: SemanticType = apply_alias_policy(context, nominal)
	canonical: SemanticType = resolve_qualified_type_names(context.module_aliases, aliased)

	{
		source = source,
		canonical = canonical
	}


pure func resolve_type_default(
	context: TypeResolutionContext,
	source: SemanticType,
) -> ResolvedType:
	resolve_type(
		context,
		source,
		pure func(typ): typ,
	)


pure func resolved_type_source(resolved: ResolvedType) -> SemanticType:
	resolved.source


pure func resolved_type_canonical(resolved: ResolvedType) -> SemanticType:
	resolved.canonical


pure func function_parameter_annotation(
	context: TypeResolutionContext,
	source: SemanticType,
	qualify_owner: pure (SemanticType) -> SemanticType,
) -> ResolvedType:
	resolve_type(context, source, qualify_owner)


pure func function_return_annotation(
	context: TypeResolutionContext,
	source: SemanticType,
	qualify_owner: pure (SemanticType) -> SemanticType,
) -> ResolvedType:
	resolve_type(context, source, qualify_owner)


pure func imported_signature(context: TypeResolutionContext, source: SemanticType) -> ResolvedType:
	resolve_type_default(context, source)


pure func imported_signature_canonical(
	context: TypeResolutionContext,
	source: SemanticType,
) -> SemanticType:
	imported_signature(context, source).canonical


pure func record_field_type(context: TypeResolutionContext, source: SemanticType) -> ResolvedType:
	resolve_type_default(context, source)


pure func record_field_type_canonical(
	context: TypeResolutionContext,
	source: SemanticType,
) -> SemanticType:
	record_field_type(context, source).canonical
