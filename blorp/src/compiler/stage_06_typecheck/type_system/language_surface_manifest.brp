-- Blorp-owned source-language surface tables shared by parser-adjacent
-- tooling, typecheck, and LSP.
import:
	../../stage_02_lex/name_table:
		NAME_ID_PRELUDE_TYPE_DICT,
		NAME_ID_PRELUDE_TYPE_DIRECTORY,
		NAME_ID_PRELUDE_TYPE_DIRECTORY_ENTRY,
		NAME_ID_PRELUDE_TYPE_DIRECTORY_ENTRY_KIND,
		NAME_ID_PRELUDE_TYPE_FILE_APPENDER,
		NAME_ID_PRELUDE_TYPE_FILE_READER,
		NAME_ID_PRELUDE_TYPE_FILE_READ_APPENDER,
		NAME_ID_PRELUDE_TYPE_FILE_READ_WRITER,
		NAME_ID_PRELUDE_TYPE_FILE_WRITER,
		NAME_ID_PRELUDE_TYPE_IOERROR,
		NAME_ID_PRELUDE_TYPE_LIST,
		NAME_ID_PRELUDE_TYPE_PARALLEL_LIST,
		NAME_ID_PRELUDE_TYPE_PARALLEL_MATRIX,
		NAME_ID_PRELUDE_TYPE_PARALLEL_VECTOR,
		NAME_ID_PRELUDE_TYPE_RANGE,
		NAME_ID_PRELUDE_TYPE_SET,
		NameId,
		name_ids_equal,


---
Nominal types imported by prelude that are not compiler primitives.

Their identity cannot depend on whether a compiler API happened to include
the providing std module's source. In particular, synthetic typecheck graph
requests still have the same prelude as ordinary source compilation. Keep
the provider, arity, and resource capability closed over this enum so later
phases never reconstruct those facts from strings.
---
fixed union PreludeType:
	PreludeDict
	PreludeDirectory
	PreludeDirectoryEntry
	PreludeDirectoryEntryKind
	PreludeFileAppender
	PreludeFileReadAppender
	PreludeFileReadWriter
	PreludeFileReader
	PreludeFileWriter
	PreludeIOError
	PreludeList
	PreludeParallelList
	PreludeParallelMatrix
	PreludeParallelVector
	PreludeRange
	PreludeSet


pure func prelude_type(name: NameId) -> Option[PreludeType]:
	if name_ids_equal(name, NAME_ID_PRELUDE_TYPE_DICT):
		Some(PreludeDict)
	else if name_ids_equal(name, NAME_ID_PRELUDE_TYPE_DIRECTORY):
		Some(PreludeDirectory)
	else if name_ids_equal(name, NAME_ID_PRELUDE_TYPE_DIRECTORY_ENTRY):
		Some(PreludeDirectoryEntry)
	else if name_ids_equal(name, NAME_ID_PRELUDE_TYPE_DIRECTORY_ENTRY_KIND):
		Some(PreludeDirectoryEntryKind)
	else if name_ids_equal(name, NAME_ID_PRELUDE_TYPE_FILE_APPENDER):
		Some(PreludeFileAppender)
	else if name_ids_equal(name, NAME_ID_PRELUDE_TYPE_FILE_READ_APPENDER):
		Some(PreludeFileReadAppender)
	else if name_ids_equal(name, NAME_ID_PRELUDE_TYPE_FILE_READ_WRITER):
		Some(PreludeFileReadWriter)
	else if name_ids_equal(name, NAME_ID_PRELUDE_TYPE_FILE_READER):
		Some(PreludeFileReader)
	else if name_ids_equal(name, NAME_ID_PRELUDE_TYPE_FILE_WRITER):
		Some(PreludeFileWriter)
	else if name_ids_equal(name, NAME_ID_PRELUDE_TYPE_IOERROR):
		Some(PreludeIOError)
	else if name_ids_equal(name, NAME_ID_PRELUDE_TYPE_LIST):
		Some(PreludeList)
	else if name_ids_equal(name, NAME_ID_PRELUDE_TYPE_PARALLEL_LIST):
		Some(PreludeParallelList)
	else if name_ids_equal(name, NAME_ID_PRELUDE_TYPE_PARALLEL_MATRIX):
		Some(PreludeParallelMatrix)
	else if name_ids_equal(name, NAME_ID_PRELUDE_TYPE_PARALLEL_VECTOR):
		Some(PreludeParallelVector)
	else if name_ids_equal(name, NAME_ID_PRELUDE_TYPE_RANGE):
		Some(PreludeRange)
	else if name_ids_equal(name, NAME_ID_PRELUDE_TYPE_SET):
		Some(PreludeSet)
	else:
		None

pure func prelude_type_name(typ: PreludeType) -> String:
	match typ:
		PreludeDict:
			"Dict"
		PreludeDirectory:
			"Directory"
		PreludeDirectoryEntry:
			"DirectoryEntry"
		PreludeDirectoryEntryKind:
			"DirectoryEntryKind"
		PreludeFileAppender:
			"FileAppender"
		PreludeFileReadAppender:
			"FileReadAppender"
		PreludeFileReadWriter:
			"FileReadWriter"
		PreludeFileReader:
			"FileReader"
		PreludeFileWriter:
			"FileWriter"
		PreludeIOError:
			"IOError"
		PreludeList:
			"List"
		PreludeParallelList:
			"ParallelList"
		PreludeParallelMatrix:
			"ParallelMatrix"
		PreludeParallelVector:
			"ParallelVector"
		PreludeRange:
			"Range"
		PreludeSet:
			"Set"


pure func prelude_type_module_path(typ: PreludeType) -> String:
	match typ:
		PreludeDict:
			"dict"
		PreludeDirectory:
			"fs"
		PreludeDirectoryEntry:
			"fs"
		PreludeDirectoryEntryKind:
			"fs"
		PreludeFileAppender:
			"fs"
		PreludeFileReadAppender:
			"fs"
		PreludeFileReadWriter:
			"fs"
		PreludeFileReader:
			"fs"
		PreludeFileWriter:
			"fs"
		PreludeIOError:
			"fs"
		PreludeList:
			"list"
		PreludeParallelList:
			"list"
		PreludeParallelMatrix:
			"matrix"
		PreludeParallelVector:
			"vector"
		PreludeRange:
			"range"
		PreludeSet:
			"set"


pure func prelude_type_arity(typ: PreludeType) -> Int:
	match typ:
		PreludeDict:
			2
		PreludeList:
			1
		PreludeParallelList:
			1
		PreludeParallelMatrix:
			3
		PreludeParallelVector:
			2
		PreludeSet:
			1
		_:
			0


pure func prelude_type_is_resource(typ: PreludeType) -> Bool:
	match typ:
		PreludeDirectory:
			True
		PreludeFileAppender:
			True
		PreludeFileReadAppender:
			True
		PreludeFileReadWriter:
			True
		PreludeFileReader:
			True
		PreludeFileWriter:
			True
		_:
			False


---
Synthetic frontend graphs may resolve prelude names without loading their
declarations. Keep the inline-layout fact attached to the closed prelude
identity instead of recovering it from the source spelling.
---
pure func prelude_type_has_inline_value_storage(typ: PreludeType) -> Bool:
	match typ:
		PreludeDirectoryEntryKind:
			True
		_:
			False


---
Source declarations whose unqualified names are part of the runtime ABI.

This identity is assigned from the canonical module path and declaration
name while the frontend still owns both facts. Core carries the accepted
identity explicitly; later phases must not infer ABI status from a name that
happens to match one of these declarations.
---
fixed union DeclaredAbiType:
	DeclaredAbiBool
	DeclaredAbiConcurrencyError
	DeclaredAbiDirectoryEntry
	DeclaredAbiInt64
	DeclaredAbiMemStats
	DeclaredAbiOption
	DeclaredAbiResult
	DeclaredAbiSchedulerStats


pure func declared_abi_type(module_path: String, type_name: String) -> Option[DeclaredAbiType]:
	match (module_path, type_name):
		("bool", "Bool"):
			Some(DeclaredAbiBool)
		("channel", "ConcurrencyError"):
			Some(DeclaredAbiConcurrencyError)
		("fs", "DirectoryEntry"):
			Some(DeclaredAbiDirectoryEntry)
		("int", "Int64"):
			Some(DeclaredAbiInt64)
		("instrumentation", "SchedulerStats"):
			Some(DeclaredAbiSchedulerStats)
		("memory", "MemStats"):
			Some(DeclaredAbiMemStats)
		("option", "Option"):
			Some(DeclaredAbiOption)
		("result", "Result"):
			Some(DeclaredAbiResult)
		_:
			None


pure func declared_abi_type_name(typ: DeclaredAbiType) -> String:
	match typ:
		DeclaredAbiBool:
			"Bool"
		DeclaredAbiConcurrencyError:
			"ConcurrencyError"
		DeclaredAbiDirectoryEntry:
			"DirectoryEntry"
		DeclaredAbiInt64:
			"Int64"
		DeclaredAbiMemStats:
			"MemStats"
		DeclaredAbiOption:
			"Option"
		DeclaredAbiResult:
			"Result"
		DeclaredAbiSchedulerStats:
			"SchedulerStats"


---
`builtin` declarations are compiler ABI boundaries. Their representation is
determined by the canonical std module and declaration name together; a
same-named declaration in another module does not inherit this storage.
---
fixed union BuiltinValueStorage:
	BuiltinInlineScalar
	BuiltinManagedReference
	BuiltinNoValue


---
Closed native nominal contracts whose values are managed String-shaped
pointers, but whose semantic identities are not String aliases. Only the
accepted builtin-header boundary classifies a source declaration by this
manifest; later phases transport the resulting fact instead of guessing.
---
fixed union NativeManagedBuiltin:
	NativeIpAddress
	NativeDnsName
	NativeInterfaceScope


pure func native_managed_builtin(
	module_name: String,
	type_name: String,
) -> Option[NativeManagedBuiltin]:
	match (module_name, type_name):
		("net/tcp", "IpAddress"): Some(NativeIpAddress)
		("net/tcp", "DnsName"): Some(NativeDnsName)
		("net/tcp", "InterfaceScope"): Some(NativeInterfaceScope)
		_: None


---
Existing Core spelling of each manifest-issued identity. Construction must
also compare this with the shared module/member projection; this is not a
classifier for an arbitrary Core name.
---
pure func native_managed_builtin_canonical_name(kind: NativeManagedBuiltin) -> String:
	match kind:
		NativeIpAddress: "net_tcp__IpAddress"
		NativeDnsName: "net_tcp__DnsName"
		NativeInterfaceScope: "net_tcp__InterfaceScope"


private INLINE_SCALAR_BUILTIN_TYPES: List[(String, String)] = [
	("int", "Int"),
	("int8", "Int8"),
	("int16", "Int16"),
	("int32", "Int32"),
	("int128", "Int128"),
	("uint8", "UInt8"),
	("uint16", "UInt16"),
	("uint32", "UInt32"),
	("uint64", "UInt64"),
	("uint128", "UInt128"),
	("float", "Float"),
	("float16", "Float16"),
	("float32", "Float32"),
	("char", "Char"),
	("ptr", "Ptr"),
	("net/tcp", "Port"),
]

private MANAGED_REFERENCE_BUILTIN_TYPES: List[(String, String)] = [
	("bytes", "Bytes"),
	("channel", "Channel"),
	("dict", "Dict"),
	("fixed_point", "FixedPoint"),
	("list", "List"),
	("list", "ParallelList"),
	("matrix", "ParallelMatrix"),
	("net/tcp", "DnsName"),
	("net/tcp", "InterfaceScope"),
	("net/tcp", "IpAddress"),
	("set", "Set"),
	("slice", "StringSlice"),
	("stream", "FallibleStream"),
	("stream", "ResourceSource"),
	("stream", "Stream"),
	("string", "String"),
	("vector", "ParallelVector"),
]


pure func builtin_value_storage(
	module_name: String,
	type_name: String,
) -> Option[BuiltinValueStorage]:
	identity = (module_name, type_name)

	if INLINE_SCALAR_BUILTIN_TYPES.contains(identity):
		Some(BuiltinInlineScalar)
	else if MANAGED_REFERENCE_BUILTIN_TYPES.contains(identity):
		Some(BuiltinManagedReference)
	else if identity == ("void", "Void"):
		Some(BuiltinNoValue)
	else:
		None
