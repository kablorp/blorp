-- Explicit per-compilation context for the Blorp-owned frontend.
--
-- Model compilation state as an ordinary value so typechecking and environment
-- operations thread state explicitly instead of growing ambient session state.
import:
	../../stage_04_modules/loaded_module:
		ModuleOrigin(NativePackageModule, SourcePackageModule, StdlibModule, UserModule),
	dim_solver:
		DimSolveResult(DimBindMeta, DimBindVar, DimContradiction, DimSolved, DimStuck),
		dim_solve,
	semantic_type:
		SemanticType(
			SemanticArrayType,
			SemanticConstIntType,
			SemanticDimOpType,
			SemanticFunctionType,
			SemanticMetaType,
			SemanticNamedType,
			SemanticRangeType,
			SemanticSelfType,
			SemanticTupleType,
			SemanticTypeVar,
			SemanticVarDimsType,
		),
		SemanticTypeSubstEntry,
		array_type_parts,
		is_dim_var_name,
		normalize_dim,
		normalize_type_name,
		occurs_in,
		strip_type_param_bounds,
		type_subst_entry,
		types_equal,


record SourcePackage {
	package_alias: String,
	package_name: String,
	package_root: String,
	source_dir: String,
	exports: List[String]
}


record ResourceCleanupEntry {
	type_name: String,
	cleanup_function: String
}


private record MetaSolverStateRep {
	origins: List[String],
	bindings: List[Option[SemanticType]]
}


opaque type MetaSolverState = MetaSolverStateRep

private META_SOLVER_EMPTY: MetaSolverState = into_opaque MetaSolverState({
		origins = [],
		bindings = []
	})


record Context {
	package_roots: List[String],
	source_packages: List[SourcePackage],
	resource_cleanups: List[ResourceCleanupEntry],
	solver: MetaSolverState,
	def_id_counter: Int,
	lower_destruct_counter: Int,
	lower_param_counter: Int,
	lower_question_bind_counter: Int,
	lower_resource_counter: Int,
	lower_task_scope_counter: Int,
	lower_current_task_scope_id: Int,
	desugar_counter: Int,
	ssa_mut_counter: Int
}


-- The only Context fact that survives between independent inference sessions.
-- Solver bindings and all allocation/lowering counters are session-owned.
opaque type PreparedInferContextFacts = List[ResourceCleanupEntry]


record DefIdStep {
	context: Context,
	def_id: Int
}


record FreshMetaStep {
	context: Context,
	meta_type: SemanticType
}


record UnifyStep {
	context: Context,
	subst: List[SemanticTypeSubstEntry]
}


private record UnifyOptions {
	symmetric: Bool,
	type_params: List[String],
	rigid_vars: List[String]
}


private enum MetaReferenceCheck:
	FindTargetMeta
	ValidateBindingGraph
	ValidateIssuedReferences


-- ValidateIssuedReferences has no target. Use an out-of-range value only for
-- that private mode; the check never compares a meta to this value.
private META_REFERENCE_NO_TARGET: Int = -1

CONTEXT_EMPTY: Context = {
	package_roots = [],
	source_packages = [],
	resource_cleanups = [],
	solver = META_SOLVER_EMPTY,
	def_id_counter = 0,
	lower_destruct_counter = 0,
	lower_param_counter = 0,
	lower_question_bind_counter = 0,
	lower_resource_counter = 0,
	lower_task_scope_counter = 1,
	lower_current_task_scope_id = 0,
	desugar_counter = 0,
	ssa_mut_counter = 0
}


-- A body owns its solver state. Module-level cleanup and package facts are
-- immutable inputs, while metas and their allocation order must never leak
-- from one independently checked body into another.
pure func context_for_fresh_infer_session(context: Context) -> Context:
	{ context | solver = META_SOLVER_EMPTY }


pure func prepared_infer_context_facts(context: Context) -> PreparedInferContextFacts:
	into_opaque PreparedInferContextFacts(context.resource_cleanups)


pure func context_from_prepared_infer_facts(facts: PreparedInferContextFacts) -> Context:
	{ CONTEXT_EMPTY | resource_cleanups = from_opaque PreparedInferContextFacts(facts) }


pure func source_package_origin(name: String) -> Option[ModuleOrigin]:
	trimmed: String = name.trim()

	if trimmed.length() == 0:
		None
	else:
		Some(SourcePackageModule(trimmed))


pure func native_package_origin(name: String) -> Option[ModuleOrigin]:
	trimmed: String = name.trim()

	if trimmed.length() == 0:
		None
	else:
		Some(NativePackageModule(trimmed))


pure func module_origin_is_std(origin: ModuleOrigin) -> Bool:
	match origin:
		StdlibModule:
			True
		_:
			False


pure func module_origin_is_package(origin: ModuleOrigin) -> Bool:
	match origin:
		NativePackageModule(_):
			True
		SourcePackageModule(_):
			True
		_:
			False


pure func module_origin_is_source_package(origin: ModuleOrigin) -> Bool:
	match origin:
		SourcePackageModule(_):
			True
		_:
			False


pure func module_origin_allows_builtin(origin: ModuleOrigin) -> Bool:
	match origin:
		StdlibModule:
			True
		_:
			False


pure func module_origin_allows_foreign(origin: ModuleOrigin) -> Bool:
	match origin:
		NativePackageModule(_):
			True
		UserModule:
			True
		_:
			False


pure func module_origin_label(origin: ModuleOrigin) -> String:
	match origin:
		StdlibModule:
			"standard library"
		UserModule:
			"user module"
		NativePackageModule(package_id):
			"native package '" + package_id + "'"
		SourcePackageModule(package_id):
			"source package '" + package_id + "'"


private pure func replace_resource_cleanup_entry(
	entries: List[ResourceCleanupEntry],
	replacement: ResourceCleanupEntry,
) -> List[ResourceCleanupEntry]:
	var result: List[ResourceCleanupEntry] = []
	var replaced: Bool = False

	for entry in entries:
		if entry.type_name == replacement.type_name:
			result = result.append(replacement)
			replaced = True
		else:
			result = result.append(entry)

	if replaced:
		result
	else:
		result.append(replacement)


pure func register_resource_cleanup(
	context: Context,
	type_name: String,
	cleanup_function: String,
) -> Context:
	entry: ResourceCleanupEntry = {
		type_name = type_name,
		cleanup_function = cleanup_function
	}
	{ context |
		resource_cleanups = replace_resource_cleanup_entry(context.resource_cleanups, entry)
	}


pure func find_resource_cleanup(context: Context, type_name: String) -> Option[String]:
	var result: Option[String] = None

	for entry in context.resource_cleanups:
		if entry.type_name == type_name:
			result = Some(entry.cleanup_function)
			break

	result


pure func meta_origin_name(context: Context, meta_id: Int) -> String:
	match from_opaque MetaSolverState(context.solver).origins.get(meta_id):
		Some(origin):
			origin
		None:
			"?m" + meta_id.to_string()


pure func lookup_meta(context: Context, meta_id: Int) -> Option[SemanticType]:
	from_opaque MetaSolverState(context.solver).bindings.get_or(meta_id, None)


pure func meta_solver_allocated_count(context: Context) -> Int:
	from_opaque MetaSolverState(context.solver).origins.length()


pure func meta_solver_bound_count(context: Context) -> Int:
	var count: Int = 0

	for binding in from_opaque MetaSolverState(context.solver).bindings:
		if binding.is_some():
			count += 1

	count


pure func meta_solver_states_equal(left: Context, right: Context) -> Bool:
	left_solver = from_opaque MetaSolverState(left.solver)
	right_solver = from_opaque MetaSolverState(right.solver)
	left_solver.origins == right_solver.origins and left_solver.bindings == right_solver.bindings


-- A solver may bind only metas issued by this session. An out-of-range ID
-- fails closed instead of growing a sparse table or silently inventing a meta.
pure func bind_meta(context: Context, meta_id: Int, typ: SemanticType) -> Option[Context]:
	solver = from_opaque MetaSolverState(context.solver)

	if (
		meta_id < 0
		or meta_id >= solver.bindings.length()
		or meta_reference_conflicts(context, meta_id, typ, ValidateBindingGraph)
	):
		None
	else:
		Some(
			{ context |
				solver = into_opaque MetaSolverState(
					{ solver | bindings = solver.bindings.set(meta_id, Some(typ)) }
				)
			},
		)


pure func head_resolve(context: Context, typ: SemanticType) -> SemanticType:
	-- bind_meta is the only binding constructor and rejects cycles. Head
	-- resolution can follow the chain without rebuilding a visited-ID list.
	var resolved: SemanticType = typ
	var searching: Bool = True

	while searching:
		match resolved:
			SemanticMetaType(meta_id):
				match lookup_meta(context, meta_id):
					Some(binding):
						resolved = binding
					None:
						searching = False
			_:
				searching = False

	resolved


private pure func meta_reference_conflicts_in_list(
	context: Context,
	target_meta_id: Int,
	types: List[SemanticType],
	check: MetaReferenceCheck,
) -> Bool:
	var result: Bool = False

	for typ in types:
		if meta_reference_conflicts(context, target_meta_id, typ, check):
			result = True
			break

	result


private pure func meta_reference_conflicts(
	context: Context,
	target_meta_id: Int,
	typ: SemanticType,
	check: MetaReferenceCheck,
) -> Bool:
	-- bind_meta is the sole binding writer and rejects self/transitive cycles.
	-- Following existing bindings therefore needs no per-path visited-ID list.
	match typ:
		SemanticMetaType(meta_id):
			unissued = match check:
				FindTargetMeta:
					False
				ValidateBindingGraph:
					meta_id < 0 or meta_id >= meta_solver_allocated_count(context)
				ValidateIssuedReferences:
					meta_id < 0 or meta_id >= meta_solver_allocated_count(context)

			target_matches = match check:
				FindTargetMeta:
					meta_id == target_meta_id
				ValidateBindingGraph:
					meta_id == target_meta_id
				ValidateIssuedReferences:
					False

			if target_matches:
				True
			else if unissued:
				True
			else:
				match lookup_meta(context, meta_id):
					Some(binding):
						meta_reference_conflicts(context, target_meta_id, binding, check)
					None:
						False
		SemanticNamedType(_, args):
			meta_reference_conflicts_in_list(context, target_meta_id, args, check)
		SemanticArrayType(element, dims):
			(
				meta_reference_conflicts(context, target_meta_id, element, check)
				or meta_reference_conflicts_in_list(context, target_meta_id, dims, check)
			)
		SemanticFunctionType(_, params, return_type):
			(
				meta_reference_conflicts_in_list(context, target_meta_id, params, check)
				or meta_reference_conflicts(context, target_meta_id, return_type, check)
			)
		SemanticTupleType(elements):
			meta_reference_conflicts_in_list(context, target_meta_id, elements, check)
		SemanticRangeType(inner):
			meta_reference_conflicts(context, target_meta_id, inner, check)
		SemanticDimOpType(_, left, right):
			(
				meta_reference_conflicts(context, target_meta_id, left, check)
				or meta_reference_conflicts(context, target_meta_id, right, check)
			)
		_:
			False


pure func occurs_meta(context: Context, target_meta_id: Int, typ: SemanticType) -> Bool:
	meta_reference_conflicts(context, target_meta_id, typ, FindTargetMeta)


private pure func meta_references_are_issued(context: Context, typ: SemanticType) -> Bool:
	not meta_reference_conflicts(context, META_REFERENCE_NO_TARGET, typ, ValidateIssuedReferences)


-- None means this subtree is unchanged, not that an unbound meta failed to
-- resolve. List.set clones shared storage on the first changed child only.
private pure func resolve_type_meta_list_if_changed(
	context: Context,
	types: List[SemanticType],
	finalize_unbound: Bool,
) -> Option[List[SemanticType]]:
	var resolved: List[SemanticType] = types
	var changed: Bool = False
	var index: Int = 0

	for typ in types:
		match resolve_type_metas_if_changed(context, typ, finalize_unbound):
			Some(next_type):
				resolved = resolved.set(index, next_type)
				changed = True
			None:
				void

		index += 1

	if changed:
		Some(resolved)
	else:
		None


private pure func unbound_meta_type_if_changed(
	context: Context,
	meta_id: Int,
	finalize_unbound: Bool,
) -> Option[SemanticType]:
	if finalize_unbound:
		-- An issued but unbound meta becomes its generic origin. An unissued
		-- index must remain a meta so the solved-body guard can reject it.
		match from_opaque MetaSolverState(context.solver).origins.get(meta_id):
			Some(origin):
				Some(SemanticTypeVar(origin))
			None:
				None
	else:
		None


private pure func resolve_type_metas_if_changed(
	context: Context,
	typ: SemanticType,
	finalize_unbound: Bool,
) -> Option[SemanticType]:
	match typ:
		SemanticMetaType(meta_id):
			-- bind_meta is the sole binding constructor and rejects transitive
			-- cycles, so full resolution needs no per-hop visited-ID list.
			match lookup_meta(context, meta_id):
				Some(binding):
					Some(resolve_type_metas_recursive(context, binding, finalize_unbound))
				None:
					unbound_meta_type_if_changed(context, meta_id, finalize_unbound)
		SemanticNamedType(name, args):
			match resolve_type_meta_list_if_changed(context, args, finalize_unbound):
				Some(resolved_args):
					Some(SemanticNamedType(name, resolved_args))
				None:
					None
		SemanticArrayType(element, dims):
			element_result = resolve_type_metas_if_changed(context, element, finalize_unbound)
			dims_result = resolve_type_meta_list_if_changed(context, dims, finalize_unbound)

			if element_result.is_some() or dims_result.is_some():
				Some(SemanticArrayType(element_result.get_or(element), dims_result.get_or(dims)))
			else:
				None
		SemanticFunctionType(is_pure, params, return_type):
			params_result = resolve_type_meta_list_if_changed(context, params, finalize_unbound)
			return_result = resolve_type_metas_if_changed(context, return_type, finalize_unbound)

			if params_result.is_some() or return_result.is_some():
				Some(
					SemanticFunctionType(
						is_pure,
						params_result.get_or(params),
						return_result.get_or(return_type),
					),
				)
			else:
				None
		SemanticTupleType(elements):
			match resolve_type_meta_list_if_changed(context, elements, finalize_unbound):
				Some(resolved_elements):
					Some(SemanticTupleType(resolved_elements))
				None:
					None
		SemanticRangeType(inner):
			match resolve_type_metas_if_changed(context, inner, finalize_unbound):
				Some(resolved_inner):
					Some(SemanticRangeType(resolved_inner))
				None:
					None
		SemanticDimOpType(op, left, right):
			left_result = resolve_type_metas_if_changed(context, left, finalize_unbound)
			right_result = resolve_type_metas_if_changed(context, right, finalize_unbound)

			if left_result.is_some() or right_result.is_some():
				Some(SemanticDimOpType(op, left_result.get_or(left), right_result.get_or(right)))
			else:
				None
		_:
			None


private pure func resolve_type_metas_recursive(
	context: Context,
	typ: SemanticType,
	finalize_unbound: Bool,
) -> SemanticType:
	match resolve_type_metas_if_changed(context, typ, finalize_unbound):
		Some(resolved):
			resolved
		None:
			typ


pure func resolve_type_metas(context: Context, typ: SemanticType) -> SemanticType:
	resolve_type_metas_recursive(context, typ, False)


pure func zonk_type(context: Context, typ: SemanticType) -> SemanticType:
	resolve_type_metas_recursive(context, typ, True)


private pure func unify_options(
	symmetric: Bool,
	type_params: List[String],
	rigid_vars: List[String],
) -> UnifyOptions:
	{
		symmetric = symmetric,
		type_params = type_params,
		rigid_vars = rigid_vars
	}


private pure func unify_subst_list_lookup(
	subst: List[SemanticTypeSubstEntry],
	name: String,
) -> Option[SemanticType]:
	var result: Option[SemanticType] = None

	for entry in subst:
		if entry.var_name == name:
			result = Some(entry.concrete_type)
			break

	result


pure func unify_subst_lookup(step: UnifyStep, name: String) -> Option[SemanticType]:
	unify_subst_list_lookup(step.subst, name)


private pure func unify_param_name_is_var(options: UnifyOptions, name: String) -> Bool:
	stripped_name: String = strip_type_param_bounds(name)
	var found: Bool = False

	for param in options.type_params:
		stripped_param: String = strip_type_param_bounds(param)

		if stripped_param == stripped_name:
			found = True
			break

	found


private pure func unify_name_is_rigid(options: UnifyOptions, name: String) -> Bool:
	stripped_name: String = strip_type_param_bounds(name)
	var found: Bool = False

	for rigid in options.rigid_vars:
		stripped_rigid: String = strip_type_param_bounds(rigid)

		if rigid == name or stripped_rigid == stripped_name:
			found = True
			break

	found


private pure func unify_is_int_type(typ: SemanticType) -> Bool:
	match typ:
		SemanticNamedType(name, args):
			name == "Int" and args.length() == 0
		_:
			False


private pure func unify_is_literal_string_type(typ: SemanticType) -> Bool:
	match typ:
		SemanticNamedType(name, args):
			name == "LiteralString" and args.length() == 0
		_:
			False


private pure func unify_is_string_type(typ: SemanticType) -> Bool:
	match typ:
		SemanticNamedType(name, args):
			name == "String" and args.length() == 0
		_:
			False


private pure func unify_is_variadic_dims(typ: SemanticType) -> Bool:
	match typ:
		SemanticVarDimsType(_):
			True
		_:
			False


private pure func unify_try_bind(
	step: UnifyStep,
	name: String,
	typ: SemanticType,
) -> Option[UnifyStep]:
	-- A substitution can carry a meta without calling bind_meta.
	if not meta_references_are_issued(step.context, typ):
		None
	else:
		match unify_subst_list_lookup(step.subst, name):
			Some(existing):
				if types_equal(existing, typ):
					Some(step)
				else:
					None
			None:
				if occurs_in(name, typ):
					None
				else:
					Some({ step | subst = step.subst.append(type_subst_entry(name, typ)) })


private pure func unify_bind_meta(
	step: UnifyStep,
	meta_id: Int,
	typ: SemanticType,
) -> Option[UnifyStep]:
	match bind_meta(step.context, meta_id, typ):
		Some(bound_context):
			Some({ step | context = bound_context })
		None:
			None


private pure func unify_accept_if_metas_issued(
	step: UnifyStep,
	left: SemanticType,
	right: SemanticType,
) -> Option[UnifyStep]:
	if (
		meta_references_are_issued(step.context, left)
		and meta_references_are_issued(step.context, right)
	):
		Some(step)
	else:
		None


private pure func meta_tail_references_are_issued(
	context: Context,
	types: List[SemanticType],
	start_index: Int,
) -> Bool:
	-- Variadic matching accepts the rest of this list without visiting it.
	var index: Int = start_index
	var issued: Bool = True

	while index < types.length() and issued:
		match types.get(index):
			Some(typ):
				issued = meta_references_are_issued(context, typ)
			None:
				issued = False

		index += 1

	issued


private pure func unify_args_at(
	options: UnifyOptions,
	step: UnifyStep,
	left_args: List[SemanticType],
	right_args: List[SemanticType],
	left_index: Int,
	right_index: Int,
) -> Option[UnifyStep]:
	if left_index == left_args.length() and right_index == right_args.length():
		Some(step)
	else if left_index < left_args.length():
		match left_args.get(left_index):
			Some(left):
				if unify_is_variadic_dims(left) and left_index == left_args.length() - 1:
					if meta_tail_references_are_issued(step.context, right_args, right_index):
						Some(step)
					else:
						None
				else if right_index < right_args.length():
					match right_args.get(right_index):
						Some(right):
							if (
								options.symmetric
								and unify_is_variadic_dims(right)
								and right_index == right_args.length() - 1
							):
								if meta_tail_references_are_issued(
									step.context,
									left_args,
									left_index,
								):
									Some(step)
								else:
									None
							else:
								match unify_go(options, step, left, right):
									Some(next_step):
										unify_args_at(
											options,
											next_step,
											left_args,
											right_args,
											left_index + 1,
											right_index + 1,
										)
									None:
										None
						None:
							None
				else:
					None
			None:
				None
	else if options.symmetric and right_index < right_args.length():
		match right_args.get(right_index):
			Some(right):
				if unify_is_variadic_dims(right) and right_index == right_args.length() - 1:
					Some(step)
				else:
					None
			None:
				None
	else:
		None


private pure func unify_args(
	options: UnifyOptions,
	step: UnifyStep,
	left_args: List[SemanticType],
	right_args: List[SemanticType],
) -> Option[UnifyStep]:
	unify_args_at(options, step, left_args, right_args, 0, 0)


private pure func unify_arrays(
	options: UnifyOptions,
	step: UnifyStep,
	left: SemanticType,
	right: SemanticType,
) -> Option[UnifyStep]:
	match (array_type_parts(left), array_type_parts(right)):
		(Some(left_parts), Some(right_parts)):
			match unify_go(options, step, left_parts[0], right_parts[0]):
				Some(element_step):
					unify_args(options, element_step, left_parts[1], right_parts[1])
				None:
					None
		_:
			None


private pure func unify_range_types(
	options: UnifyOptions,
	step: UnifyStep,
	left: SemanticType,
	right: SemanticType,
) -> Option[UnifyStep]:
	match (left, right):
		(SemanticRangeType(SemanticConstIntType(left_value)), SemanticRangeType(SemanticConstIntType(right_value))):
			if right_value <= left_value:
				Some(step)
			else:
				None
		(SemanticRangeType(left_inner), SemanticRangeType(right_inner)):
			unify_go(options, step, left_inner, right_inner)
		_:
			None


private pure func unify_named_types(
	options: UnifyOptions,
	step: UnifyStep,
	left_name: String,
	left_args: List[SemanticType],
	right_name: String,
	right_args: List[SemanticType],
) -> Option[UnifyStep]:
	if normalize_type_name(left_name) != normalize_type_name(right_name):
		None
	else:
		unify_args(options, step, left_args, right_args)


private pure func unify_tuples(
	options: UnifyOptions,
	step: UnifyStep,
	left_elements: List[SemanticType],
	right_elements: List[SemanticType],
) -> Option[UnifyStep]:
	if left_elements.length() != right_elements.length():
		None
	else:
		unify_args(options, step, left_elements, right_elements)


private pure func unify_functions(
	options: UnifyOptions,
	step: UnifyStep,
	left_is_pure: Bool,
	left_params: List[SemanticType],
	left_return: SemanticType,
	right_is_pure: Bool,
	right_params: List[SemanticType],
	right_return: SemanticType,
) -> Option[UnifyStep]:
	if left_is_pure and not right_is_pure:
		None
	else if left_params.length() != right_params.length():
		None
	else:
		match unify_args(options, step, left_params, right_params):
			Some(params_step):
				unify_go(options, params_step, left_return, right_return)
			None:
				None


private pure func unify_dim_arithmetic(
	options: UnifyOptions,
	step: UnifyStep,
	left: SemanticType,
	right: SemanticType,
) -> Option[UnifyStep]:
	match dim_solve(from_opaque MetaSolverState(step.context.solver).bindings, left, right):
		DimSolved:
			Some(step)
		DimBindMeta(meta_id, value):
			unify_bind_meta(step, meta_id, value)
		DimBindVar(name, value):
			unify_try_bind(step, name, value)
		DimContradiction:
			None
		DimStuck:
			normalized_left: SemanticType = normalize_dim(left)
			normalized_right: SemanticType = normalize_dim(right)

			if types_equal(normalized_left, normalized_right):
				Some(step)
			else if (
				not types_equal(normalized_left, left)
				or not types_equal(normalized_right, right)
			):
				unify_go(options, step, normalized_left, normalized_right)
			else:
				None


private pure func unify_left_named(
	options: UnifyOptions,
	step: UnifyStep,
	left: SemanticType,
	left_name: String,
	left_args: List[SemanticType],
	other: SemanticType,
) -> Option[UnifyStep]:
	if left_args.length() == 0 and unify_param_name_is_var(options, left_name):
		unify_try_bind(step, left_name, other)
	else if left_args.length() == 0 and unify_name_is_rigid(options, left_name):
		None
	else:
		match other:
			SemanticNamedType(right_name, right_args):
				if (
					options.symmetric
					and right_args.length() == 0
					and unify_param_name_is_var(options, right_name)
				):
					unify_try_bind(step, right_name, left)
				else if right_args.length() == 0 and unify_name_is_rigid(options, right_name):
					None
				else:
					unify_named_types(options, step, left_name, left_args, right_name, right_args)
			SemanticTupleType(right_elements):
				if left_name == "Tuple":
					unify_tuples(options, step, left_args, right_elements)
				else:
					unify_arrays(options, step, left, other)
			SemanticRangeType(_):
				if unify_is_int_type(left):
					unify_accept_if_metas_issued(step, left, other)
				else:
					unify_arrays(options, step, left, other)
			_:
				unify_arrays(options, step, left, other)


private pure func unify_right_named(
	options: UnifyOptions,
	step: UnifyStep,
	other: SemanticType,
	right: SemanticType,
	right_name: String,
	right_args: List[SemanticType],
) -> Option[UnifyStep]:
	if (
		options.symmetric
		and right_args.length() == 0
		and unify_param_name_is_var(options, right_name)
	):
		unify_try_bind(step, right_name, other)
	else if right_args.length() == 0 and unify_name_is_rigid(options, right_name):
		None
	else:
		match other:
			SemanticRangeType(_):
				if options.symmetric and unify_is_int_type(right):
					unify_accept_if_metas_issued(step, other, right)
				else:
					unify_arrays(options, step, other, right)
			SemanticTupleType(left_elements):
				if right_name == "Tuple":
					unify_tuples(options, step, left_elements, right_args)
				else:
					unify_arrays(options, step, other, right)
			_:
				unify_arrays(options, step, other, right)


private pure func unify_structural(
	options: UnifyOptions,
	step: UnifyStep,
	left: SemanticType,
	right: SemanticType,
) -> Option[UnifyStep]:
	match left:
		SemanticNamedType(left_name, left_args):
			unify_left_named(options, step, left, left_name, left_args, right)
		_:
			match right:
				SemanticNamedType(right_name, right_args):
					unify_right_named(options, step, left, right, right_name, right_args)
				_:
					match (left, right):
						(SemanticArrayType(_, _), SemanticArrayType(_, _)):
							unify_arrays(options, step, left, right)
						(SemanticFunctionType(left_is_pure, left_params, left_return), SemanticFunctionType(right_is_pure, right_params, right_return)):
							unify_functions(
								options,
								step,
								left_is_pure,
								left_params,
								left_return,
								right_is_pure,
								right_params,
								right_return,
							)
						(SemanticTupleType(left_elements), SemanticTupleType(right_elements)):
							unify_tuples(options, step, left_elements, right_elements)
						(SemanticRangeType(_), SemanticRangeType(_)):
							unify_range_types(options, step, left, right)
						(_, SemanticRangeType(_)):
							if unify_is_int_type(left):
								unify_accept_if_metas_issued(step, left, right)
							else:
								None
						(SemanticRangeType(_), _):
							if options.symmetric and unify_is_int_type(right):
								unify_accept_if_metas_issued(step, left, right)
							else:
								None
						(SemanticSelfType, SemanticSelfType):
							Some(step)
						_:
							None


private pure func unify_right_or_structural(
	options: UnifyOptions,
	step: UnifyStep,
	left: SemanticType,
	right: SemanticType,
) -> Option[UnifyStep]:
	match right:
		SemanticMetaType(meta_id):
			unify_bind_meta(step, meta_id, left)
		SemanticTypeVar(name):
			if unify_name_is_rigid(options, name):
				if is_dim_var_name(name) and unify_is_int_type(left):
					Some(step)
				else:
					None
			else:
				if options.symmetric:
					unify_try_bind(step, name, left)
				else:
					None
		_:
			unify_structural(options, step, left, right)


private pure func unify_go(
	options: UnifyOptions,
	step: UnifyStep,
	raw_left: SemanticType,
	raw_right: SemanticType,
) -> Option[UnifyStep]:
	left: SemanticType = head_resolve(step.context, raw_left)
	right: SemanticType = head_resolve(step.context, raw_right)

	if types_equal(left, right):
		if meta_reference_conflicts(
			step.context,
			META_REFERENCE_NO_TARGET,
			left,
			ValidateIssuedReferences,
		):
			None
		else:
			Some(step)
	else if unify_is_string_type(left) and unify_is_literal_string_type(right):
		Some(step)
	else if (
		options.symmetric
		and unify_is_literal_string_type(left)
		and unify_is_string_type(right)
	):
		Some(step)
	else if unify_is_int_type(left) and unify_is_dim_var_type(right):
		Some(step)
	else if (
		options.symmetric
		and unify_is_dim_var_type(left)
		and unify_is_int_type(right)
	):
		Some(step)
	else if unify_is_int_type(left) and unify_is_const_int_type(right):
		Some(step)
	else if (
		options.symmetric
		and unify_is_const_int_type(left)
		and unify_is_int_type(right)
	):
		Some(step)
	else if unify_is_dim_expr_type(left) or unify_is_dim_expr_type(right):
		-- Canonicalization can cancel an invalid meta before reporting DimSolved.
		if (
			meta_references_are_issued(step.context, left)
			and meta_references_are_issued(step.context, right)
		):
			unify_dim_arithmetic(options, step, left, right)
		else:
			None
	else:
		match left:
			SemanticMetaType(meta_id):
				unify_bind_meta(step, meta_id, right)
			SemanticTypeVar(name):
				if unify_name_is_rigid(options, name):
					if is_dim_var_name(name) and unify_is_int_type(right):
						Some(step)
					else:
						None
				else:
					unify_try_bind(step, name, right)
			_:
				unify_right_or_structural(options, step, left, right)


private pure func unify_is_dim_var_type(typ: SemanticType) -> Bool:
	match typ:
		SemanticTypeVar(name):
			is_dim_var_name(name)
		SemanticNamedType(name, args):
			args.length() == 0 and is_dim_var_name(name)
		_:
			False


private pure func unify_is_const_int_type(typ: SemanticType) -> Bool:
	match typ:
		SemanticConstIntType(_):
			True
		_:
			False


private pure func unify_is_dim_expr_type(typ: SemanticType) -> Bool:
	match typ:
		SemanticDimOpType(_, _, _):
			True
		_:
			False


private pure func unify_with_options(
	context: Context,
	options: UnifyOptions,
	left: SemanticType,
	right: SemanticType,
) -> Option[UnifyStep]:
	unify_go(
		options,
		{
			context = context,
			subst = []
		},
		left,
		right,
	)


pure func unify(context: Context, left: SemanticType, right: SemanticType) -> Option[UnifyStep]:
	unify_with_options(
		context,
		unify_options(False, [], []),
		left,
		right,
	)


pure func unify_symmetric(
	context: Context,
	left: SemanticType,
	right: SemanticType,
) -> Option[UnifyStep]:
	unify_with_options(
		context,
		unify_options(True, [], []),
		left,
		right,
	)


pure func unify_with_type_params(
	context: Context,
	type_params: List[String],
	left: SemanticType,
	right: SemanticType,
) -> Option[UnifyStep]:
	unify_with_options(
		context,
		unify_options(False, type_params, []),
		left,
		right,
	)


pure func unify_symmetric_with_type_params(
	context: Context,
	type_params: List[String],
	left: SemanticType,
	right: SemanticType,
) -> Option[UnifyStep]:
	unify_with_options(
		context,
		unify_options(True, type_params, []),
		left,
		right,
	)


pure func types_compatible_in_context(
	context: Context,
	expected: SemanticType,
	actual: SemanticType,
) -> Bool:
	unify(context, expected, actual).is_some()


pure func types_compatible_with_params_in_context(
	context: Context,
	type_params: List[String],
	expected: SemanticType,
	actual: SemanticType,
) -> Bool:
	unify_with_type_params(context, type_params, expected, actual).is_some()


pure func types_bidirectional_in_context(
	context: Context,
	left: SemanticType,
	right: SemanticType,
) -> Bool:
	unify_symmetric(context, left, right).is_some()


pure func types_compatible_rigid_in_context(
	context: Context,
	rigid_vars: List[String],
	expected: SemanticType,
	actual: SemanticType,
) -> Bool:
	unify_with_options(
		context,
		unify_options(False, [], rigid_vars),
		expected,
		actual,
	).is_some()


pure func mint_def_id(context: Context) -> DefIdStep:
	{
		context = { context | def_id_counter = context.def_id_counter + 1 },
		def_id = context.def_id_counter
	}


pure func fresh_meta_with_origin(context: Context, origin: String) -> FreshMetaStep:
	solver = from_opaque MetaSolverState(context.solver)
	meta_id: Int = solver.origins.length()

	meta_origin: String = if origin.length() == 0:
		"?"
	else:
		origin

	{
		context = { context | solver = into_opaque MetaSolverState({ solver |
					origins = solver.origins.append(meta_origin),
					bindings = solver.bindings.append(None)
				}) },
		meta_type = SemanticMetaType(meta_id)
	}


pure func fresh_meta(context: Context) -> FreshMetaStep:
	fresh_meta_with_origin(context, "?")


pure func reset_meta(context: Context) -> Context:
	{ context | solver = META_SOLVER_EMPTY }


pure func reset_core_counters(context: Context) -> Context:
	{ context |
		def_id_counter = 0,
		lower_destruct_counter = 0,
		lower_param_counter = 0,
		lower_question_bind_counter = 0,
		lower_resource_counter = 0,
		lower_task_scope_counter = 1,
		lower_current_task_scope_id = 0,
		desugar_counter = 0,
		ssa_mut_counter = 0
	}
