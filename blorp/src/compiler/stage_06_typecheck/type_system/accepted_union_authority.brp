-- Category-specific accepted union storage and compact constructor visibility.
-- Union and variant payloads live once in the graph-owned table. Constructor
-- symbols are projected there for canonical lookups and in each module view
-- for owner-local source spellings and localized field types. Visible-name
-- lookup still uses scalar locators, preserving its precedence order.
import:
	../../stage_04_modules/module_table:
		ModuleId,
		module_id_table_index,
		module_table_canonical_path,
		module_table_count,
		module_table_find_id_by_canonical_path,
	../graph/definition_index:
		DefinitionTable,
		definition_table_module_table,
		definition_tables_share_provenance,
	../graph/type_identity: TypeId, type_id_definition_id, type_id_module_id, type_ids_equal
	accepted_alias_authority:
		AcceptedAliasTable,
		accepted_alias_table_definition_table,
		accepted_alias_table_find_type_identity,
	env:
		ConstructorIdentityDomain(GraphConstructorIdentity, UnindexedConstructorIdentity),
		ConstructorSymbol,
		Env,
		Symbol,
		SymbolKind(ConstructorSymbolKind),
		TypeKind(TypeBuiltin),
		env_get_constructor_for_parent,
		env_get_type_decl,
		env_get_type_kind,
		env_type_contains_resource_if_valid,
		env_type_may_contain_function,
		env_type_may_contain_one_shot_stream,
		env_type_may_contain_resource_source,
	list: repeat
	memory: same_object
	semantic_type: SemanticType(SemanticNamedType), localize_module_types, localize_module_types_list, types_equal
	union_layout: UnionLayout(ScalarTagUnion, TaggedUnion)


record AcceptedUnionVariantEntry {
	name: String,
	constructor_id: Int,
	fields: List[SemanticType],
	tag: Int
}


record AcceptedUnionEntry {
	type_params: List[String],
	variants: List[AcceptedUnionVariantEntry],
	layout: UnionLayout,
	contains_resource: Bool,
	may_contain_function: Bool,
	may_contain_one_shot_stream: Bool,
	may_contain_resource_source: Bool
}


record AcceptedUnionTableRecord {
	id: TypeId,
	canonical_name: String,
	canonical_visible: Bool,
	payload: AcceptedUnionEntry
}


record AcceptedUnionTableInput {
	definition_table: DefinitionTable,
	unions: List[AcceptedUnionTableRecord]
}


fixed record AcceptedUnionConstructorLocator {
	union_index: Int,
	variant_index: Int,
	owner_local: Bool
}


private record AcceptedUnionTableRep {
	definition_table: DefinitionTable,
	unions: List[AcceptedUnionEntry],
	graph_type_ids_by_union_index: Dict[Int, TypeId],
	canonical_names: List[String],
	canonical_constructor_symbols: List[List[Symbol]],
	canonical_visibility: List[Bool],
	graph_union_indices_by_definition_id: Dict[Int, Int],
	canonical_graph_union_indices_by_name: Dict[String, Int],
	builtin_union_indices_by_name: Dict[String, Int],
	canonical_constructors_by_module: List[Dict[String, List[AcceptedUnionConstructorLocator]]],
	builtin_constructors_by_name: Dict[String, List[AcceptedUnionConstructorLocator]]
}


opaque type AcceptedUnionTable = AcceptedUnionTableRep


record AcceptedVisibleUnionBinding {
	source_name: String,
	id: TypeId,
	owner_local: Bool
}


record AcceptedVisibleConstructorBinding {
	source_name: String,
	parent_source_name: String,
	parent_id: TypeId,
	constructor_id: Int,
	owner_local: Bool
}


private record AcceptedUnionModuleViewRep {
	owner_module_path: Option[String],
	visible_union_indices_by_source_name: Dict[String, Int],
	visible_constructors_by_source_name: Dict[String, List[AcceptedUnionConstructorLocator]],
	constructor_parent_aliases: Dict[String, String],
	local_constructor_symbols_by_union_index: Dict[Int, List[Symbol]]
}


opaque type AcceptedUnionModuleView = AcceptedUnionModuleViewRep


private record AcceptedUnionAuthorityRep {
	table: AcceptedUnionTable,
	owner_module_path: Option[String],
	visible_union_indices_by_source_name: Dict[String, Int],
	visible_constructors_by_source_name: Dict[String, List[AcceptedUnionConstructorLocator]],
	constructor_parent_aliases: Dict[String, String],
	local_constructor_symbols_by_union_index: Dict[Int, List[Symbol]]
}


opaque type AcceptedUnionAuthority = AcceptedUnionAuthorityRep


union AcceptedUnionExactLookup:
	AcceptedUnionExactFound(AcceptedUnionEntry)
	AcceptedUnionExactMissing
	AcceptedUnionExactWrongKind(TypeId)


record AcceptedUnionExactProbe {
	lookup: AcceptedUnionExactLookup,
	candidates_visited: Int
}


private pure func table_rep(table: AcceptedUnionTable) -> AcceptedUnionTableRep:
	from_opaque AcceptedUnionTable(table)


private pure func module_view_rep(view: AcceptedUnionModuleView) -> AcceptedUnionModuleViewRep:
	from_opaque AcceptedUnionModuleView(view)


private pure func authority_rep(authority: AcceptedUnionAuthority) -> AcceptedUnionAuthorityRep:
	from_opaque AcceptedUnionAuthority(authority)


private pure func union_id_at(
	graph_type_ids_by_union_index: Dict[Int, TypeId],
	index: Int,
) -> Option[TypeId]:
	graph_type_ids_by_union_index.get(index)


private pure func semantic_type_lists_equal(
	left: List[SemanticType],
	right: List[SemanticType],
) -> Bool:
	if left.length() != right.length():
		False
	else:
		var equal: Bool = True
		var index: Int = 0

		while equal and index < left.length():
			equal = match (left.get(index), right.get(index)):
				(Some(left_type), Some(right_type)):
					types_equal(left_type, right_type)
				_:
					False

			index += 1

		equal


private pure func accepted_union_entries_equal(
	left: AcceptedUnionEntry,
	right: AcceptedUnionEntry,
) -> Bool:
	var variants_equal = left.variants.length() == right.variants.length()
	var index: Int = 0

	while variants_equal and index < left.variants.length():
		variants_equal = match (left.variants.get(index), right.variants.get(index)):
			(Some(left_variant), Some(right_variant)):
				(
					left_variant.name == right_variant.name
					and semantic_type_lists_equal(left_variant.fields, right_variant.fields)
					and left_variant.tag == right_variant.tag
				)
			_:
				False

		index += 1

	(
		left.type_params == right.type_params
		and left.layout == right.layout
		and left.contains_resource == right.contains_resource
		and left.may_contain_function == right.may_contain_function
		and left.may_contain_one_shot_stream == right.may_contain_one_shot_stream
		and left.may_contain_resource_source == right.may_contain_resource_source
		and variants_equal
	)


private pure func builtin_union_entry_from_env(
	env: Env,
	name: String,
) -> Result[AcceptedUnionEntry, String]:
	if env_get_type_kind(env, name) != Some(TypeBuiltin):
		Err("bootstrap union '" + name + "' is missing its builtin type declaration")
	else:
		match env_get_type_decl(env, name):
			Some((type_params, variants)):
				containment = (
					env_type_contains_resource_if_valid(env, name),
					env_type_may_contain_function(env, name),
					env_type_may_contain_one_shot_stream(env, name),
					env_type_may_contain_resource_source(env, name),
				)

				match containment:
					(Some(contains_resource), Some(may_contain_function), Some(may_contain_one_shot_stream), Some(may_contain_resource_source)):
						var projected: List[AcceptedUnionVariantEntry] = []
						var issue: Option[String] = None

						for variant in variants:
							if issue.is_none():
								match env_get_constructor_for_parent(env, name, variant.name):
									Some(constructor):
										if (
											constructor.parent_type == name
											and constructor.type_params == type_params
											and semantic_type_lists_equal(
												constructor.field_types,
												variant.fields,
											)
											and constructor.tag == variant.tag
										):
											projected = projected.append({
												name = variant.name,
												constructor_id = constructor.constructor_id,
												fields = variant.fields,
												tag = variant.tag,
											})
										else:
											issue = Some(
												"bootstrap constructor '" + name + "." + variant.name + "' does not match its type declaration",
											)
									None:
										issue = Some(
											"bootstrap union '" + name + "' is missing constructor '" + variant.name + "'",
										)

						match issue:
							Some(message):
								Err(message)
							None:
								Ok({
									type_params = type_params,
									variants = projected,
									-- The validated TypeBuiltin projection keeps its existing
									-- managed union layout; source layouts come from headers.
									layout = TaggedUnion,
									contains_resource = contains_resource,
									may_contain_function = may_contain_function,
									may_contain_one_shot_stream = may_contain_one_shot_stream,
									may_contain_resource_source = may_contain_resource_source,
								})
					_:
						Err("bootstrap union '" + name + "' has incomplete containment metadata")
			None:
				Err("bootstrap union '" + name + "' is missing its type metadata")


private pure func append_constructor_locators(
	constructors: Dict[String, List[AcceptedUnionConstructorLocator]],
	entry: AcceptedUnionEntry,
	union_index: Int,
	owner_local: Bool,
) -> Dict[String, List[AcceptedUnionConstructorLocator]]:
	var result = constructors
	var variant_index: Int = 0

	for variant in entry.variants:
		result = result.set(
			variant.name,
			result
				.get_or(variant.name, [])
				.append({
					union_index = union_index,
					variant_index = variant_index,
					owner_local = owner_local,
				}),
		)
		variant_index += 1

	result


private pure func prepend_constructor_locators(
	constructors: Dict[String, List[AcceptedUnionConstructorLocator]],
	entry: AcceptedUnionEntry,
	union_index: Int,
	owner_local: Bool,
) -> Dict[String, List[AcceptedUnionConstructorLocator]]:
	var result = constructors
	var variant_index: Int = 0

	for variant in entry.variants:
		result = result.set(
			variant.name,
			[
				{
					union_index = union_index,
					variant_index = variant_index,
					owner_local = owner_local
				},
			].concat(result.get_or(variant.name, [])),
		)
		variant_index += 1

	result


private pure func append_module_constructor_locators(
	constructors: List[Dict[String, List[AcceptedUnionConstructorLocator]]],
	module_id: ModuleId,
	entry: AcceptedUnionEntry,
	union_index: Int,
) -> List[Dict[String, List[AcceptedUnionConstructorLocator]]]:
	module_index = module_id_table_index(module_id)
	module_constructors = constructors.get_or(module_index, {})
	constructors.set(
		module_index,
		prepend_constructor_locators(module_constructors, entry, union_index, False),
	)


private pure func constructor_symbols_for_union(
	entry: AcceptedUnionEntry,
	parent_type: String,
	identity_domain: ConstructorIdentityDomain,
	owner_module_path: Option[String],
) -> List[Symbol]:
	entry.variants.map(func(variant):
		fields = match owner_module_path:
			Some(path):
				variant.fields.map(func(field): localize_module_types(path, field))
			None:
				variant.fields

		symbol: Symbol = {
			name = variant.name,
			kind = ConstructorSymbolKind({
				parent_type = parent_type,
				constructor_id = variant.constructor_id,
				identity_domain = identity_domain,
				type_params = entry.type_params,
				field_types = fields,
				tag = variant.tag,
			})
		}
		symbol
	)


pure func accepted_union_table(
	input: AcceptedUnionTableInput,
	type_identities: AcceptedAliasTable,
	builtin_env: Env,
	builtin_union_names: List[String],
) -> Result[AcceptedUnionTable, List[String]]:
	definition_table = accepted_alias_table_definition_table(type_identities)
	module_table = definition_table_module_table(definition_table)
	var unions: List[AcceptedUnionEntry] = []
	var graph_type_ids_by_union_index: Dict[Int, TypeId] = {}
	var canonical_names: List[String] = []
	var canonical_visibility: List[Bool] = []
	var graph_union_indices_by_definition_id: Dict[Int, Int] = {}
	var canonical_graph_union_indices_by_name: Dict[String, Int] = {}
	var builtin_union_indices_by_name: Dict[String, Int] = {}
	empty_constructors: Dict[String, List[AcceptedUnionConstructorLocator]] = {}
	var canonical_constructors_by_module: List[Dict[String, List[AcceptedUnionConstructorLocator]]] = repeat(
		empty_constructors,
		module_table_count(module_table),
	)
	var builtin_constructors_by_name: Dict[String, List[AcceptedUnionConstructorLocator]] = {}
	var errors: List[String] = []
	var index: Int = 0

	if not definition_tables_share_provenance(input.definition_table, definition_table):
		errors = errors.append("accepted union and type identity tables have different origins")

	for union_record in input.unions:
		key = type_id_definition_id(union_record.id)
		owner_id = type_id_module_id(input.definition_table, union_record.id)

		identity_matches = match accepted_alias_table_find_type_identity(
			type_identities,
			union_record.id,
		):
			Some(identity):
				identity.canonical_name == union_record.canonical_name
			None:
				False

		if (
			not identity_matches
			or owner_id.is_none()
			or graph_union_indices_by_definition_id.contains(key)
			or (
				union_record.canonical_visible
				and canonical_graph_union_indices_by_name.contains(union_record.canonical_name)
			)
		):
			errors = errors.append("duplicate or mismatched accepted union identity")
		else:
			unions = unions.append(union_record.payload)
			graph_type_ids_by_union_index = graph_type_ids_by_union_index.set(
				index,
				union_record.id,
			)
			canonical_names = canonical_names.append(union_record.canonical_name)
			canonical_visibility = canonical_visibility.append(union_record.canonical_visible)
			graph_union_indices_by_definition_id = graph_union_indices_by_definition_id.set(
				key,
				index,
			)

			if union_record.canonical_visible:
				canonical_graph_union_indices_by_name = canonical_graph_union_indices_by_name.set(
					union_record.canonical_name,
					index,
				)

				match owner_id:
					Some(id):
						canonical_constructors_by_module = append_module_constructor_locators(
							canonical_constructors_by_module,
							id,
							union_record.payload,
							index,
						)
					None:
						void

		index += 1

	for name in builtin_union_names:
		match builtin_union_entry_from_env(builtin_env, name):
			Err(message):
				errors = errors.append(message)
			Ok(entry):
				match canonical_graph_union_indices_by_name.get(name):
					Some(existing_index):
						match unions.get(existing_index):
							Some(existing):
								if accepted_union_entries_equal(existing, entry):
									builtin_union_indices_by_name = builtin_union_indices_by_name.set(
										name,
										existing_index,
									)
									builtin_constructors_by_name = prepend_constructor_locators(
										builtin_constructors_by_name,
										existing,
										existing_index,
										False,
									)
								else:
									errors = errors.append(
										"bootstrap union '" + name + "' does not match accepted graph metadata",
									)
							None:
								errors = errors.append("bootstrap union index is invalid")
					None:
						builtin_index = unions.length()
						unions = unions.append(entry)
						canonical_names = canonical_names.append(name)
						canonical_visibility = canonical_visibility.append(True)
						builtin_union_indices_by_name = builtin_union_indices_by_name.set(
							name,
							builtin_index,
						)
						builtin_constructors_by_name = prepend_constructor_locators(
							builtin_constructors_by_name,
							entry,
							builtin_index,
							False,
						)

	if errors.is_empty():
		var canonical_constructor_symbols: List[List[Symbol]] = []
		var union_index: Int = 0

		for entry in unions:
			match canonical_names.get(union_index):
				Some(parent_type):
					identity_domain: ConstructorIdentityDomain = if graph_type_ids_by_union_index.contains(
						union_index,
					):
						GraphConstructorIdentity
					else:
						UnindexedConstructorIdentity

					canonical_constructor_symbols = canonical_constructor_symbols.append(
						constructor_symbols_for_union(
							entry,
							parent_type,
							identity_domain,
							None,
						),
					)
				None:
					canonical_constructor_symbols = canonical_constructor_symbols.append([])

			union_index += 1

		Ok(into_opaque AcceptedUnionTable({
					definition_table = definition_table,
					unions = unions,
					graph_type_ids_by_union_index = graph_type_ids_by_union_index,
					canonical_names = canonical_names,
					canonical_constructor_symbols = canonical_constructor_symbols,
					canonical_visibility = canonical_visibility,
					graph_union_indices_by_definition_id = graph_union_indices_by_definition_id,
					canonical_graph_union_indices_by_name = canonical_graph_union_indices_by_name,
					builtin_union_indices_by_name = builtin_union_indices_by_name,
					canonical_constructors_by_module = canonical_constructors_by_module,
					builtin_constructors_by_name = builtin_constructors_by_name
				}))
	else:
		Err(errors)


private pure func union_index_for_id(table: AcceptedUnionTableRep, id: TypeId) -> Option[Int]:
	index ?= table.graph_union_indices_by_definition_id.get(type_id_definition_id(id))
	stored_id ?= union_id_at(table.graph_type_ids_by_union_index, index)

	if type_ids_equal(stored_id, id):
		Some(index)
	else:
		None


private pure func constructor_locator(
	table: AcceptedUnionTableRep,
	binding: AcceptedVisibleConstructorBinding,
) -> Option[AcceptedUnionConstructorLocator]:
	union_index ?= union_index_for_id(table, binding.parent_id)
	entry ?= table.unions.get(union_index)
	var result: Option[AcceptedUnionConstructorLocator] = None
	var variant_index: Int = 0

	for variant in entry.variants:
		if result.is_none() and variant.constructor_id == binding.constructor_id:
			result = Some({
				union_index = union_index,
				variant_index = variant_index,
				owner_local = binding.owner_local,
			})

		variant_index += 1

	result


private pure func locator_constructor_id(
	table: AcceptedUnionTableRep,
	locator: AcceptedUnionConstructorLocator,
) -> Option[Int]:
	table.unions
		.get(locator.union_index)
		.and_then(func(entry): entry.variants.get(locator.variant_index))
		.map(func(variant): variant.constructor_id)


private pure func locators_contain_constructor(
	table: AcceptedUnionTableRep,
	locators: List[AcceptedUnionConstructorLocator],
	candidate: AcceptedUnionConstructorLocator,
) -> Bool:
	candidate_id = locator_constructor_id(table, candidate)
	locators.any(func(locator): locator_constructor_id(table, locator) == candidate_id)


private pure func append_visible_union_constructors(
	table: AcceptedUnionTableRep,
	constructors: Dict[String, List[AcceptedUnionConstructorLocator]],
	union_index: Int,
	owner_local: Bool,
) -> Dict[String, List[AcceptedUnionConstructorLocator]]:
	match table.unions.get(union_index):
		Some(entry):
			append_constructor_locators(constructors, entry, union_index, owner_local)
		None:
			constructors


private pure func prepend_visible_union_constructors(
	table: AcceptedUnionTableRep,
	constructors: Dict[String, List[AcceptedUnionConstructorLocator]],
	union_index: Int,
) -> Dict[String, List[AcceptedUnionConstructorLocator]]:
	match table.unions.get(union_index):
		Some(entry):
			prepend_constructor_locators(constructors, entry, union_index, True)
		None:
			constructors


pure func accepted_union_module_view(
	table: AcceptedUnionTable,
	owner: ModuleId,
	union_bindings: List[AcceptedVisibleUnionBinding],
	constructor_bindings: List[AcceptedVisibleConstructorBinding],
) -> Option[AcceptedUnionModuleView]:
	representation = table_rep(table)
	var visible_union_indices: Dict[String, Int] = {}
	var visible_constructors: Dict[String, List[AcceptedUnionConstructorLocator]] = {}
	var parent_aliases: Dict[String, String] = {}
	var local_constructor_symbols_by_union_index: Dict[Int, List[Symbol]] = {}
	var valid: Bool = True

	for binding in union_bindings:
		index = union_index_for_id(representation, binding.id)
		owner_matches = binding.owner_local == (type_id_module_id(
			representation.definition_table,
			binding.id,
		) == Some(owner))

		match index:
			Some(found_index):
				visible = (
					binding.owner_local
					or representation.canonical_visibility
						.get(found_index)
						.get_or(False)
				)

				if (
					not owner_matches
					or not visible
					or visible_union_indices.contains(binding.source_name)
				):
					valid = False
				else:
					visible_union_indices = visible_union_indices.set(
						binding.source_name,
						found_index,
					)
			None:
				valid = False

	-- Owner-local constructors precede explicit imports. Namespace binding has
	-- already rejected a real local/import collision, but retaining this order
	-- also makes the authority deterministic for synthetic test views.
	for binding in union_bindings:
		if binding.owner_local:
			match visible_union_indices.get(binding.source_name):
				Some(union_index):
					visible_constructors = prepend_visible_union_constructors(
						representation,
						visible_constructors,
						union_index,
					)
				None:
					valid = False

	for binding in constructor_bindings:
		locator = constructor_locator(representation, binding)
		owner_matches = binding.owner_local == (type_id_module_id(
			representation.definition_table,
			binding.parent_id,
		) == Some(owner))

		match locator:
			Some(found):
				visible = (
					binding.owner_local
					or representation.canonical_visibility
						.get(found.union_index)
						.get_or(False)
				)

				if not owner_matches or not visible:
					valid = False
				else:
					prior = visible_constructors.get_or(binding.source_name, [])

					if not locators_contain_constructor(representation, prior, found):
						visible_constructors = visible_constructors.set(
							binding.source_name,
							prior.append(found),
						)

					if (
						not binding.owner_local
						and not parent_aliases.contains(binding.parent_source_name)
					):
						match representation.canonical_names.get(found.union_index):
							Some(canonical_name):
								parent_aliases = parent_aliases.set(
									binding.parent_source_name,
									canonical_name,
								)
							None:
								valid = False
			None:
				valid = False

	-- Importing a union exposes all its constructors, after explicitly selected
	-- constructors so the established explicit-import precedence is retained.
	for binding in union_bindings:
		if not binding.owner_local:
			match visible_union_indices.get(binding.source_name):
				Some(union_index):
					visible_constructors = append_visible_union_constructors(
						representation,
						visible_constructors,
						union_index,
						False,
					)

					if not parent_aliases.contains(binding.source_name):
						match representation.canonical_names.get(union_index):
							Some(canonical_name):
								parent_aliases = parent_aliases.set(
									binding.source_name,
									canonical_name,
								)
							None:
								valid = False
				None:
					valid = False

	if valid:
		owner_module_path = module_table_canonical_path(
			definition_table_module_table(representation.definition_table),
			owner,
		)

		for binding in union_bindings:
			if binding.owner_local:
				match (union_index_for_id(representation, binding.id), owner_module_path):
					(Some(union_index), Some(path)):
						match representation.unions.get(union_index):
							Some(entry):
								identity_domain: ConstructorIdentityDomain = if representation.graph_type_ids_by_union_index.contains(
									union_index,
								):
									GraphConstructorIdentity
								else:
									UnindexedConstructorIdentity

								local_constructor_symbols_by_union_index = local_constructor_symbols_by_union_index.set(
									union_index,
									constructor_symbols_for_union(
										entry,
										binding.source_name,
										identity_domain,
										Some(path),
									),
								)
							None:
								void
					_:
						void

		Some(into_opaque AcceptedUnionModuleView({
					owner_module_path = owner_module_path,
					visible_union_indices_by_source_name = visible_union_indices,
					visible_constructors_by_source_name = visible_constructors,
					constructor_parent_aliases = parent_aliases,
					local_constructor_symbols_by_union_index = local_constructor_symbols_by_union_index
				}))
	else:
		None


pure func accepted_union_empty_module_view() -> AcceptedUnionModuleView:
	into_opaque AcceptedUnionModuleView({
			owner_module_path = None,
			visible_union_indices_by_source_name = {},
			visible_constructors_by_source_name = {},
			constructor_parent_aliases = {},
			local_constructor_symbols_by_union_index = {}
		})


pure func accepted_union_authority(
	table: AcceptedUnionTable,
	view: AcceptedUnionModuleView,
) -> AcceptedUnionAuthority:
	representation = module_view_rep(view)
	into_opaque AcceptedUnionAuthority({
			table = table,
			owner_module_path = representation.owner_module_path,
			visible_union_indices_by_source_name = representation.visible_union_indices_by_source_name,
			visible_constructors_by_source_name = representation.visible_constructors_by_source_name,
			constructor_parent_aliases = representation.constructor_parent_aliases,
			local_constructor_symbols_by_union_index = representation.local_constructor_symbols_by_union_index
		})


pure func accepted_union_authority_without_visible_names(
	authority: AcceptedUnionAuthority,
) -> AcceptedUnionAuthority:
	representation = authority_rep(authority)
	into_opaque AcceptedUnionAuthority({ representation |
			visible_union_indices_by_source_name = {},
			visible_constructors_by_source_name = {},
			constructor_parent_aliases = {}
		})


pure func accepted_union_authority_definition_table(authority: AcceptedUnionAuthority) -> DefinitionTable:
	table_rep(authority_rep(authority).table).definition_table


pure func accepted_union_authority_owner_module_id(authority: AcceptedUnionAuthority) -> Option[ModuleId]:
	representation = authority_rep(authority)
	path ?= representation.owner_module_path
	module_table_find_id_by_canonical_path(
		definition_table_module_table(table_rep(representation.table).definition_table), path,
	)


---
Current scalar-family capability for the shared accepted non-generic,
payload-free union layout, independent of declaration spelling.
Resolve the semantic receiver through this accepted view, then retain its
exact issued type identity rather than a display-name capability.
---
pure func accepted_union_scalar_tag_identity(
	authority: AcceptedUnionAuthority,
	issuer: DefinitionTable,
	receiver: SemanticType,
) -> Result[Option[TypeId], String]:
	representation = authority_rep(authority)
	table = table_rep(representation.table)
	if not definition_tables_share_provenance(table.definition_table, issuer):
		Err("compiler scalar union evidence issuer does not match accepted authority")
	else:
		match receiver:
			SemanticNamedType(name, []):
				match union_index_for_name(representation, table, name):
					None: Ok(None)
					Some(index):
						entry ?= table.unions.get(index).to_result("compiler scalar union evidence union row is absent")
						if entry.layout == ScalarTagUnion and entry.type_params.is_empty():
							id ?= union_id_at(table.graph_type_ids_by_union_index, index)
								.to_result("compiler scalar union evidence requires an issued union type identity")
							Ok(Some(id))
						else:
							Ok(None)
			_: Ok(None)


private pure func union_index_for_name(
	representation: AcceptedUnionAuthorityRep,
	table: AcceptedUnionTableRep,
	name: String,
) -> Option[Int]:
	match representation.visible_union_indices_by_source_name.get(name):
		Some(union_index):
			Some(union_index)
		None:
			match table.canonical_graph_union_indices_by_name.get(name):
				Some(found):
					Some(found)
				None:
					table.builtin_union_indices_by_name.get(name)


---
Variant payloads in the viewing module's spelling, whoever owns the union: a
union imported from a cycle partner can carry the viewer's own types. The
same entry comes back when no payload changes.
---
private pure func localized_entry(
	table: AcceptedUnionTableRep,
	index: Int,
	owner_module_path: Option[String],
) -> Option[AcceptedUnionEntry]:
	entry ?= table.unions.get(index)

	match owner_module_path:
		Some(owner_path):
			var variants = entry.variants
			var variant_index: Int = 0

			for variant in entry.variants:
				match localize_module_types_list(owner_path, variant.fields):
					Some(fields):
						variants = variants.set(variant_index, { variant | fields = fields })
					None:
						void

				variant_index += 1

			if same_object(variants, entry.variants):
				Some(entry)
			else:
				Some({ entry | variants = variants })
		None:
			Some(entry)


---
A constructor symbol in the viewing module's spelling. Owner-local symbols
are localized when the module view is built; this covers constructors owned
by other modules, which mention the viewer's types only inside an import
cycle.
---
private pure func localized_constructor_symbol(
	owner_module_path: Option[String],
	symbol: Symbol,
) -> Symbol:
	match (owner_module_path, symbol.kind):
		(Some(owner_path), ConstructorSymbolKind(constructor)):
			match localize_module_types_list(owner_path, constructor.field_types):
				Some(field_types):
					{ symbol |
						kind = ConstructorSymbolKind({ constructor | field_types = field_types })
					}
				None:
					symbol
		_:
			symbol


---
Scalar union facts must not localize or copy the variant payload. Most body
checking asks only about category or resource capability; reserving
localization for callers that consume fields keeps those queries O(lookup).
---
private pure func accepted_union_entry_raw(
	authority: AcceptedUnionAuthority,
	name: String,
) -> Option[AcceptedUnionEntry]:
	representation = authority_rep(authority)
	table = table_rep(representation.table)
	union_index ?= union_index_for_name(representation, table, name)
	table.unions.get(union_index)


pure func accepted_union_find(
	authority: AcceptedUnionAuthority,
	name: String,
) -> Option[AcceptedUnionEntry]:
	representation = authority_rep(authority)
	table = table_rep(representation.table)
	union_index ?= union_index_for_name(representation, table, name)

	localized_entry(table, union_index, representation.owner_module_path)


pure func accepted_union_find_type_params(
	authority: AcceptedUnionAuthority,
	name: String,
) -> Option[List[String]]:
	representation = authority_rep(authority)
	table = table_rep(representation.table)
	index ?= union_index_for_name(representation, table, name)
	entry ?= table.unions.get(index)
	Some(entry.type_params)


pure func accepted_union_contains(authority: AcceptedUnionAuthority, name: String) -> Bool:
	representation = authority_rep(authority)
	union_index_for_name(representation, table_rep(representation.table), name).is_some()


private pure func constructor_symbol_from_locator(
	table: AcceptedUnionTableRep,
	locator: AcceptedUnionConstructorLocator,
	representation: AcceptedUnionAuthorityRep,
) -> Option[Symbol]:
	match locator.owner_local:
		True:
			representation.local_constructor_symbols_by_union_index
				.get(locator.union_index)
				.and_then(func(symbols): symbols.get(locator.variant_index))
		False:
			found = table.canonical_constructor_symbols
				.get(locator.union_index)
				.and_then(func(symbols): symbols.get(locator.variant_index))

			-- Matched rather than mapped so an unchanged symbol allocates nothing.
			match found:
				Some(symbol):
					localized = localized_constructor_symbol(
						representation.owner_module_path,
						symbol,
					)

					if same_object(localized, symbol):
						found
					else:
						Some(localized)
				None:
					None


private pure func first_constructor_symbol(
	table: AcceptedUnionTableRep,
	locators: Option[List[AcceptedUnionConstructorLocator]],
	representation: AcceptedUnionAuthorityRep,
) -> Option[Symbol]:
	locator ?= locators.and_then(func(entries): entries.get(0))
	constructor_symbol_from_locator(table, locator, representation)


pure func accepted_union_find_constructor_symbol(
	authority: AcceptedUnionAuthority,
	name: String,
) -> Option[Symbol]:
	representation = authority_rep(authority)
	table = table_rep(representation.table)

	match first_constructor_symbol(
		table,
		representation.visible_constructors_by_source_name.get(name),
		representation,
	):
		Some(symbol):
			Some(symbol)
		None:
			first_constructor_symbol(
				table,
				table.builtin_constructors_by_name.get(name),
				representation,
			)


private pure func constructor_symbol_for_parent(
	table: AcceptedUnionTableRep,
	locators: Option[List[AcceptedUnionConstructorLocator]],
	parent_type: String,
	representation: AcceptedUnionAuthorityRep,
) -> Option[Symbol]:
	var result: Option[Symbol] = None

	match locators:
		Some(entries):
			for locator in entries:
				if result.is_none():
					match constructor_symbol_from_locator(table, locator, representation):
						Some(symbol):
							match symbol.kind:
								ConstructorSymbolKind(constructor):
									if constructor.parent_type == parent_type:
										result = Some(symbol)
								_:
									void
						None:
							void
		None:
			void

	result


pure func accepted_union_find_constructor_symbol_for_parent(
	authority: AcceptedUnionAuthority,
	parent_type: String,
	name: String,
) -> Option[Symbol]:
	representation = authority_rep(authority)
	table = table_rep(representation.table)
	resolved_parent = representation.constructor_parent_aliases.get_or(parent_type, parent_type)

	match constructor_symbol_for_parent(
		table,
		representation.visible_constructors_by_source_name.get(name),
		resolved_parent,
		representation,
	):
		Some(symbol):
			Some(symbol)
		None:
			constructor_symbol_for_parent(
				table,
				table.builtin_constructors_by_name.get(name),
				resolved_parent,
				representation,
			)


private pure func constructor_from_symbol(symbol: Symbol) -> Option[ConstructorSymbol]:
	match symbol.kind:
		ConstructorSymbolKind(constructor):
			Some(constructor)
		_:
			None


pure func accepted_union_find_constructor(
	authority: AcceptedUnionAuthority,
	name: String,
) -> Option[ConstructorSymbol]:
	accepted_union_find_constructor_symbol(authority, name).and_then(constructor_from_symbol)


pure func accepted_union_find_constructor_for_parent(
	authority: AcceptedUnionAuthority,
	parent_type: String,
	name: String,
) -> Option[ConstructorSymbol]:
	accepted_union_find_constructor_symbol_for_parent(
		authority,
		parent_type,
		name,
	).and_then(constructor_from_symbol)


private pure func module_constructor_locators(
	table: AcceptedUnionTableRep,
	module_path: String,
	name: String,
) -> Option[List[AcceptedUnionConstructorLocator]]:
	module_id ?= module_table_find_id_by_canonical_path(
		definition_table_module_table(table.definition_table),
		module_path,
	)
	table.canonical_constructors_by_module
		.get(module_id_table_index(module_id))
		.and_then(func(constructors): constructors.get(name))


private pure func accepted_union_find_module_constructor_symbol(
	authority: AcceptedUnionAuthority,
	module_path: String,
	name: String,
) -> Option[Symbol]:
	representation = authority_rep(authority)
	table = table_rep(representation.table)
	first_constructor_symbol(
		table,
		module_constructor_locators(table, module_path, name),
		representation,
	)


pure func accepted_union_find_module_constructor_for_parent(
	authority: AcceptedUnionAuthority,
	module_path: String,
	parent_type: String,
	name: String,
) -> Option[ConstructorSymbol]:
	representation = authority_rep(authority)
	table = table_rep(representation.table)
	resolved_parent = representation.constructor_parent_aliases.get_or(parent_type, parent_type)
	constructor_symbol_for_parent(
		table,
		module_constructor_locators(table, module_path, name),
		resolved_parent,
		representation,
	).and_then(constructor_from_symbol)


pure func accepted_union_find_module_constructor(
	authority: AcceptedUnionAuthority,
	module_path: String,
	name: String,
) -> Option[ConstructorSymbol]:
	accepted_union_find_module_constructor_symbol(
		authority,
		module_path,
		name,
	).and_then(constructor_from_symbol)


pure func accepted_union_entry_count(authority: AcceptedUnionAuthority) -> Int:
	table_rep(authority_rep(authority).table).unions.length()


pure func accepted_union_table_entry_count(table: AcceptedUnionTable) -> Int:
	table_rep(table).unions.length()


pure func accepted_union_table_constructor_count(table: AcceptedUnionTable) -> Int:
	var count: Int = 0

	for union_entry in table_rep(table).unions:
		count += union_entry.variants.length()

	count


---
Bootstrap-only unions may share this table without owning DefinitionIds.
Catalog completeness compares the graph-backed prefix against accepted
headers so those explicit runtime rows neither hide nor impersonate a
missing source union.
---
pure func accepted_union_table_graph_entry_count(table: AcceptedUnionTable) -> Int:
	table_rep(table).graph_type_ids_by_union_index.length()


pure func accepted_union_table_graph_constructor_count(table: AcceptedUnionTable) -> Int:
	representation = table_rep(table)
	graph_union_count = representation.graph_type_ids_by_union_index.length()
	var count: Int = 0
	var index: Int = 0

	while index < graph_union_count:
		match representation.unions.get(index):
			Some(entry):
				count += entry.variants.length()
			None:
				void

		index += 1

	count


---
Zero-copy parent projection for the catalog's logical constructor table.
Variants retain their canonical source order in the union-owned allocation.
---
pure func accepted_union_table_variants(
	table: AcceptedUnionTable,
	issuing_table: DefinitionTable,
	parent: TypeId,
) -> Option[List[AcceptedUnionVariantEntry]]:
	representation = table_rep(table)

	if definition_tables_share_provenance(representation.definition_table, issuing_table):
		index ?= union_index_for_id(representation, parent)
		entry ?= representation.unions.get(index)
		Some(entry.variants)
	else:
		None


pure func accepted_union_table_definition_table(table: AcceptedUnionTable) -> DefinitionTable:
	table_rep(table).definition_table


pure func accepted_union_is_scalar_tag(authority: AcceptedUnionAuthority, name: String) -> Option[Bool]:
	-- Physical scalar-tag projection of the header-owned non-generic,
	-- payload-free scalar shape. All union source spellings share this fact;
	-- existing trait and foreign scalar policies consume the same authority.
	accepted_union_entry_raw(authority, name).map(func(entry):
		match entry.layout:
			ScalarTagUnion:
				True
			TaggedUnion:
				False
	)


pure func accepted_union_contains_resource(
	authority: AcceptedUnionAuthority,
	name: String,
) -> Option[Bool]:
	accepted_union_entry_raw(authority, name).map(func(entry): entry.contains_resource)


pure func accepted_union_resource_scan_is_proven_unnecessary(
	authority: AcceptedUnionAuthority,
	name: String,
) -> Option[Bool]:
	accepted_union_entry_raw(
		authority,
		name,
	).map(
		func(
			entry,
		): (
			not entry.may_contain_function
			and not entry.may_contain_one_shot_stream
			and not entry.may_contain_resource_source
		),
	)


pure func accepted_union_may_contain_function(
	authority: AcceptedUnionAuthority,
	name: String,
) -> Option[Bool]:
	accepted_union_entry_raw(authority, name).map(func(entry): entry.may_contain_function)


pure func accepted_union_may_contain_one_shot_stream(
	authority: AcceptedUnionAuthority,
	name: String,
) -> Option[Bool]:
	accepted_union_entry_raw(authority, name).map(func(entry): entry.may_contain_one_shot_stream)


pure func accepted_union_may_contain_resource_source(
	authority: AcceptedUnionAuthority,
	name: String,
) -> Option[Bool]:
	accepted_union_entry_raw(authority, name).map(func(entry): entry.may_contain_resource_source)


pure func accepted_union_exact(
	table: AcceptedUnionTable,
	type_identities: AcceptedAliasTable,
	id: TypeId,
) -> AcceptedUnionExactProbe:
	representation = table_rep(table)
	key = type_id_definition_id(id)

	match representation.graph_union_indices_by_definition_id.get(key):
		Some(index):
			match (
				union_id_at(representation.graph_type_ids_by_union_index, index),
				representation.unions.get(index),
			):
				(Some(stored_id), Some(entry)):
					if type_ids_equal(stored_id, id):
						{
							lookup = AcceptedUnionExactFound(entry),
							candidates_visited = 1
						}
					else:
						{
							lookup = AcceptedUnionExactMissing,
							candidates_visited = 1
						}
				_:
					{
						lookup = AcceptedUnionExactMissing,
						candidates_visited = 1
					}
		None:
			match accepted_alias_table_find_type_identity(type_identities, id):
				Some(identity):
					{
						lookup = AcceptedUnionExactWrongKind(identity.id),
						candidates_visited = 1
					}
				None:
					{
						lookup = AcceptedUnionExactMissing,
						candidates_visited = 0
					}
