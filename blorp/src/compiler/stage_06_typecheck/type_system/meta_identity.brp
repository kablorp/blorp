-- A compiler-host capability for one compilation invocation. Session IDs
-- cannot be safely minted by copying a pure value-state counter; the later
-- solver migration must assign explicit work-item keys within this run.
import:
	../graph/definition_table_storage: DefinitionTable, definition_tables_share_provenance


private record CompilationRunTokenRep {
	allocation_anchor: Int
}


opaque type CompilationRunToken = CompilationRunTokenRep


---
Selective CTFE can abandon a checked body and check it again through eager
fallback. Those are separate fresh solvers even for the same callable.
A repeated check within one purpose needs a distinct explicit invocation.
---
enum BodyMetaSessionPurpose:
	NormalBodyMetaSession
	CtfeSelectiveBodyMetaSession
	CtfeEagerBodyMetaSession


---
The dense index lives in different table domains for modules and definitions.
Keep the distinction inside the opaque session even when the two indices
happen to have the same integer value.
---
private enum MetaSessionKind:
	ModulePreparationMetaSession
	GlobalInitializerMetaSession
	NormalBodyMetaSessionKind
	CtfeSelectiveBodyMetaSessionKind
	CtfeEagerBodyMetaSessionKind


private union MetaSessionIdRep:
	UnissuedMetaSessionId(Int)
	IssuedMetaSessionId(CompilationRunToken, DefinitionTable, Int, MetaSessionKind, Int)


opaque type MetaSessionId = MetaSessionIdRep

private UNISSUED_META_SESSION_REP: MetaSessionIdRep = UnissuedMetaSessionId(0)


---
Contexts used before inference carry this non-issuing sentinel. A real
scheduling boundary replaces it before minting metas.
---
pure func unissued_meta_session() -> MetaSessionId:
	into_opaque MetaSessionId(UNISSUED_META_SESSION_REP)


foreign(include: "meta_identity_ffi.h"):
	private pure func compilation_run_tokens_are_same_allocation(
		left: CompilationRunToken,
		right: CompilationRunToken,
	) -> Bool = "blorp_compiler_run_tokens_are_same_allocation"
	private pure func meta_sessions_are_same_allocation(
		left: MetaSessionId,
		right: MetaSessionId,
	) -> Bool = "blorp_compiler_meta_sessions_are_same_allocation"


---
This is deliberately impure: run issuance must not happen inside a pure
same-input graph or solver constructor. The compiler host must call it once
per compilation and pass the retained capability into pure phases.
---
func new_compilation_run_token() -> CompilationRunToken:
	into_opaque CompilationRunToken({allocation_anchor = 0})


pure func compilation_run_tokens_equal(
	left: CompilationRunToken,
	right: CompilationRunToken,
) -> Bool:
	compilation_run_tokens_are_same_allocation(left, right)


private pure func meta_session_from_validated_key(
	run: CompilationRunToken,
	definition_table: DefinitionTable,
	owner_index: Int,
	kind: MetaSessionKind,
	invocation: Int,
) -> MetaSessionId:
	representation: MetaSessionIdRep = IssuedMetaSessionId(
		run,
		definition_table,
		owner_index,
		kind,
		invocation,
	)
	into_opaque MetaSessionId(representation)


private pure func meta_session_for_key(
	run: CompilationRunToken,
	definition_table: DefinitionTable,
	owner_index: Int,
	kind: MetaSessionKind,
	invocation: Int,
) -> Option[MetaSessionId]:
	if owner_index < 0 or invocation < 0:
		None
	else:
		Some(meta_session_from_validated_key(run, definition_table, owner_index, kind, invocation))


---
Low-level mappers receive only already-validated table-local indices.
Production callers must project them through the checked owner boundary.
---
pure func meta_module_session(
	run: CompilationRunToken,
	definition_table: DefinitionTable,
	module_index: Int,
	invocation: Int,
) -> Option[MetaSessionId]:
	meta_session_for_key(
		run,
		definition_table,
		module_index,
		ModulePreparationMetaSession,
		invocation,
	)


pure func meta_global_session(
	run: CompilationRunToken,
	definition_table: DefinitionTable,
	definition_index: Int,
	invocation: Int,
) -> Option[MetaSessionId]:
	meta_session_for_key(
		run,
		definition_table,
		definition_index,
		GlobalInitializerMetaSession,
		invocation,
	)


pure func meta_body_session(
	run: CompilationRunToken,
	definition_table: DefinitionTable,
	definition_index: Int,
	purpose: BodyMetaSessionPurpose,
	invocation: Int,
) -> Option[MetaSessionId]:
	kind = match purpose:
		NormalBodyMetaSession:
			NormalBodyMetaSessionKind
		CtfeSelectiveBodyMetaSession:
			CtfeSelectiveBodyMetaSessionKind
		CtfeEagerBodyMetaSession:
			CtfeEagerBodyMetaSessionKind

	meta_session_for_key(run, definition_table, definition_index, kind, invocation)


---
Body planning validates the table owner and non-negative key without
allocating a session for every candidate body. Its single checked consumer
uses this constructor only when the body actually enters inference.
---
pure func meta_body_session_from_validated_key(
	run: CompilationRunToken,
	definition_table: DefinitionTable,
	definition_index: Int,
	purpose: BodyMetaSessionPurpose,
	invocation: Int,
) -> MetaSessionId:
	kind = match purpose:
		NormalBodyMetaSession:
			NormalBodyMetaSessionKind
		CtfeSelectiveBodyMetaSession:
			CtfeSelectiveBodyMetaSessionKind
		CtfeEagerBodyMetaSession:
			CtfeEagerBodyMetaSessionKind

	meta_session_from_validated_key(run, definition_table, definition_index, kind, invocation)


pure func meta_session_ids_equal(left: MetaSessionId, right: MetaSessionId) -> Bool:
	-- The hot solver path carries copies of one issued session. Keep the
	-- exact-key comparison for separately reconstructed but equal sessions.
	if meta_sessions_are_same_allocation(left, right):
		True
	else:
		match (from_opaque MetaSessionId(left), from_opaque MetaSessionId(right)):
			(IssuedMetaSessionId(left_run, left_table, left_owner, left_kind, left_invocation), IssuedMetaSessionId(right_run, right_table, right_owner, right_kind, right_invocation)):
				(
					compilation_run_tokens_equal(left_run, right_run)
					and definition_tables_share_provenance(left_table, right_table)
					and left_owner == right_owner
					and left_kind == right_kind
					and left_invocation == right_invocation
				)
			(UnissuedMetaSessionId(_), UnissuedMetaSessionId(_)):
				True
			_:
				False


pure func meta_session_is_issued(session: MetaSessionId) -> Bool:
	match from_opaque MetaSessionId(session):
		IssuedMetaSessionId(_, _, _, _, _):
			True
		UnissuedMetaSessionId(_):
			False
