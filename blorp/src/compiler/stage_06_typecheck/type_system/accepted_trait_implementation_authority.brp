		TraitObligationResolution(
			TraitObligationDeferred,
			TraitObligationSatisfied,
			TraitObligationUnsatisfied,
		),
		env_get_type_param_bound_identities,
		env_get_type_param_bounds,
		env_resolve_trait_obligation,
		impl_instances_may_overlap,
		implementation_pattern_matches_with,
		trait_obligation,
	generic_params:
		BoundTraitIdentity,
		BoundTraitOwner(CompilerBuiltinBoundTraitOwner, GraphBoundTraitOwner),
		BoundTypeParam,
		bound_trait_identities_equal,
	list: repeat
