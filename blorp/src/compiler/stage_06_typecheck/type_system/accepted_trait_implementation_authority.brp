	../../../lib/source: source_spans_equal
	../../stage_04_modules/module_table:
		ModuleId,
		ModuleTable,
		module_id_table_index,
		module_ids_equal,
		module_table_canonical_path,
		module_table_count,
		module_table_find_id_by_canonical_path,
		module_tables_are_compatible,
	../graph/definition_index:
		DefinitionTable,
		definition_table_is_compatible_with_module_table,
