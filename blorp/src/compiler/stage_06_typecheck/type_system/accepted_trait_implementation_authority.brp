record AcceptedTraitTableRecord {
	id: TraitId,
	compiler_builtin_id: Option[TraitId],
	visibility: DeclarationVisibility,
	supertraits: List[TraitId],
	method_ids: List[TraitMethodId],
	definition: TraitDef
}


record AcceptedImplementationTableRecord {
	id: ImplId,
	trait_id: TraitId,
	visibility: DeclarationVisibility,
	method_ids: List[CallableId],
	instance: ImplInstance
}


record AcceptedTraitImplementationTableInput {
	module_table: ModuleTable,
	definition_table: DefinitionTable,
	traits: List[AcceptedTraitTableRecord],
	implementations: List[AcceptedImplementationTableRecord]
}


record AcceptedImplementationDefinitionIds {
	id: ImplId,
	method_ids: List[CallableId]
}


private union AcceptedVisibleTraitBinding:
	AcceptedVisibleTraitDefinitionBinding(SourceNameId, TraitId)
	AcceptedVisibleTraitMethodBinding(SourceNameId, TraitMethodId)


private record AcceptedTraitImplementationTableRep {
	module_table: ModuleTable,
	definition_table: DefinitionTable,
	traits: List[AcceptedTraitTableRecord],
	implementations: List[AcceptedImplementationTableRecord],
	implementation_trait_method_ids: List[List[Option[TraitMethodId]]],
	qualified_implementation_indices_by_module_and_method: Dict[String, Dict[String, List[Int]]],
	qualified_implementation_method_row_count: Int,
	compiler_trait_id_by_implementation: List[Option[TraitId]],
	satisfied_trait_indices_by_implementation: List[List[Int]],
	conflicting_implementation_indices_by_implementation: List[List[Int]],
	trait_index_by_definition_id: Dict[Int, Int],
	trait_index_by_compiler_identity: Dict[Int, Int],
	implementation_index_by_definition_id: Dict[Int, Int],
	trait_indices_by_module: List[List[Int]],
	implementation_indices_by_module: List[List[Int]]
}


opaque type AcceptedTraitImplementationTable = AcceptedTraitImplementationTableRep


private record AcceptedTraitVisibilityRep {
	table: AcceptedTraitImplementationTable,
	source_name_table: SourceNameTable,
	bindings: List[AcceptedVisibleTraitBinding]
}


opaque type AcceptedTraitVisibility = AcceptedTraitVisibilityRep


private record AcceptedVisibleTraitRow {
	source_name_id: SourceNameId,
	trait_id: TraitId
}


private record AcceptedVisibleTraitMethodRow {
	source_name_id: SourceNameId,
	method_id: TraitMethodId
}


private record AcceptedCompilerImplementationBucket {
	trait_id: TraitId,
	implementation_indices: List[Int]
}


private record AcceptedTraitImplementationAuthorityRep {
	table: AcceptedTraitImplementationTable,
	owner_module_path: String,
	source_name_table: SourceNameTable,
	visible_trait_indices: List[Int],
	trait_indices_by_semantic_name: Dict[String, Int],
	visible_traits: List[AcceptedVisibleTraitRow],
	visible_implementation_indices: List[Int],
	implementation_indices_by_satisfied_trait_index: Dict[Int, List[Int]],
	implementation_indices_by_trait_name: Dict[String, List[Int]],
	compiler_implementations_by_trait_identity: Dict[Int, AcceptedCompilerImplementationBucket],
	visible_implementation_rank_by_index: List[Int],
	visible_trait_methods: List[AcceptedVisibleTraitMethodRow],
	preparation_errors: List[String]
}


opaque type AcceptedTraitImplementationAuthority = AcceptedTraitImplementationAuthorityRep


---
The trait half of an authority: names, visible traits, and visible trait
methods, with no implementation-side fields. Callable and implementation
header conversion resolve trait names and orphan checks from this alone,
so header conversion never needs to materialize a full authority (with an
empty implementation half) before implementations are known.
---
private record AcceptedTraitProjectionFields {
	table: AcceptedTraitImplementationTable,
	owner_module_path: String,
	source_name_table: SourceNameTable,
	direct_module_paths: List[String],
	visible_trait_indices: List[Int],
	trait_indices_by_semantic_name: Dict[String, Int],
	visible_traits: List[AcceptedVisibleTraitRow],
	visible_trait_methods: List[AcceptedVisibleTraitMethodRow],
	preparation_errors: List[String]
}


opaque type AcceptedTraitOnlyProjection = AcceptedTraitProjectionFields


struct AcceptedTraitImplementationAuthorityMetrics {
	accepted_trait_table_entries: Int,
	accepted_implementation_table_entries: Int,
	accepted_trait_semantic_conversions: Int,
	accepted_implementation_semantic_conversions: Int,
	accepted_qualified_implementation_method_rows: Int,
	accepted_compiler_implementation_links: Int,
	module_view_trait_indices: Int,
	module_view_implementation_indices: Int
}


private pure func table_rep(
	table: AcceptedTraitImplementationTable,
) -> AcceptedTraitImplementationTableRep:
	from_opaque AcceptedTraitImplementationTable(table)


private pure func projection_fields(
	projection: AcceptedTraitOnlyProjection,
) -> AcceptedTraitProjectionFields:
	from_opaque AcceptedTraitOnlyProjection(projection)


pure func accepted_trait_implementation_table_definition_table(
	table: AcceptedTraitImplementationTable,
) -> DefinitionTable:
	table_rep(table).definition_table


private pure func accepted_trait_visibility_rep(
	visibility: AcceptedTraitVisibility,
) -> AcceptedTraitVisibilityRep:
	from_opaque AcceptedTraitVisibility(visibility)


private pure func accepted_trait_table_source_name_table(
	table: AcceptedTraitImplementationTable,
) -> SourceNameTable:
	var candidates: List[String] = []

	for item in table_rep(table).traits:
		candidates = candidates.append(item.definition.name)

		for method in item.definition.methods:
			candidates = candidates.append(method.name)

	source_name_table(candidates)


pure func accepted_trait_empty_visibility(
	table: AcceptedTraitImplementationTable,
) -> AcceptedTraitVisibility:
	into_opaque AcceptedTraitVisibility({
			table = table,
			source_name_table = accepted_trait_table_source_name_table(table),
			bindings = []
		})


---
Convert graph import rows into a table-bound visibility product once. Raw
DefinitionId integers never cross into authority construction: applicable
trait definitions become exact TraitIds under the issuing table, and the
aggregate retains the accepted table capability that must consume them.
Standalone syntax bindings carry no graph-issued identity, so they confer no
accepted authority and remain on the compatibility path.
---
pure func accepted_visible_trait_bindings(
	table: AcceptedTraitImplementationTable,
	issuing_table: DefinitionTable,
	source_names: SourceNameTable,
	import_bindings: List[ImportBinding],
) -> Option[AcceptedTraitVisibility]:
	representation = table_rep(table)
	var bindings: List[AcceptedVisibleTraitBinding] = []
	var valid = definition_tables_share_provenance(representation.definition_table, issuing_table)

	for binding in import_bindings:
		match binding:
			GraphSelectiveDefinitionBinding(local_name, module_id, definition_ids):
				for definition_id in definition_ids:
					match trait_id_from_definition_table(
						issuing_table,
						definition_id_runtime_value(definition_id),
					):
						Some(trait_id):
							if (
								trait_id_module_id(issuing_table, trait_id)
									.map(func(owner_id): module_ids_equal(owner_id, module_id))
									.get_or(False)
							):
								match source_name_table_find_id(source_names, local_name):
									Some(source_name_id):
										bindings = bindings.append(
											AcceptedVisibleTraitDefinitionBinding(
												source_name_id,
												trait_id,
											),
										)
									None:
										valid = False
							else:
								valid = False
						None:
							void
			GraphSelectiveTraitMethodBinding(local_name, module_id, original_name, _):
				match source_name_table_find_id(source_names, local_name):
					Some(source_name_id):
						var found: Bool = False

						match representation.trait_indices_by_module.get(
							module_id_table_index(module_id),
						):
							Some(indices):
								for index in indices:
									match representation.traits.get(index):
										Some(item):
											if item.visibility == PublicDeclaration:
												for pair in table_trait_methods_seen(
													representation,
													[],
													index,
												):
													if pair[0] == original_name:
														bindings = bindings.append(
															AcceptedVisibleTraitMethodBinding(
																source_name_id,
																pair[1],
															),
														)
														found = True
										None:
											valid = False
							None:
								valid = False

						if not found:
							valid = False
					None:
						valid = False
			GraphQualifiedModuleBinding(_, _):
				void
			StandaloneQualifiedModuleBinding(_, _) | StandaloneSelectiveDefinitionBinding(_, _, _):
				void

	if valid:
		Some(into_opaque AcceptedTraitVisibility({
					table = table,
					source_name_table = source_names,
					bindings = bindings
				}))
	else:
		None


pure func accepted_trait_implementation_table_trait_count(
	table: AcceptedTraitImplementationTable,
) -> Int:
	table_rep(table).traits.length()


pure func accepted_trait_implementation_table_implementation_count(
	table: AcceptedTraitImplementationTable,
) -> Int:
	table_rep(table).implementations.length()


private pure func authority_rep(
	authority: AcceptedTraitImplementationAuthority,
) -> AcceptedTraitImplementationAuthorityRep:
	from_opaque AcceptedTraitImplementationAuthority(authority)


private pure func trait_owner_module_path(
	definition_table: DefinitionTable,
	module_table: ModuleTable,
	item: AcceptedTraitTableRecord,
) -> Option[String]:
	trait_id_module_id(
		definition_table,
		item.id,
	).and_then(
		func(module_id): module_table_canonical_path(module_table, module_id),
	)


private pure func implementation_owner_module_path(
	definition_table: DefinitionTable,
	module_table: ModuleTable,
	item: AcceptedImplementationTableRecord,
) -> Option[String]:
	impl_id_module_id(
		definition_table,
		item.id,
	).and_then(
		func(module_id): module_table_canonical_path(module_table, module_id),
	)


private pure func trait_indices_for_module_path(
	table: AcceptedTraitImplementationTableRep,
	module_path: String,
) -> List[Int]:
	module_table_find_id_by_canonical_path(table.module_table, module_path)
		.and_then(func(module_id):
			table.trait_indices_by_module.get(module_id_table_index(module_id))
		)
		.get_or([])


private pure func implementation_indices_for_module_path(
	table: AcceptedTraitImplementationTableRep,
	module_path: String,
) -> List[Int]:
	module_table_find_id_by_canonical_path(table.module_table, module_path)
		.and_then(func(module_id):
			table.implementation_indices_by_module.get(module_id_table_index(module_id))
		)
		.get_or([])


private pure func bound_trait_identity_matches_id(
	definition_table: DefinitionTable,
	identity: BoundTraitIdentity,
	id: TraitId,
) -> Bool:
	owner_matches = match (trait_id_module_id(definition_table, id), identity.owner):
		(Some(module_id), GraphBoundTraitOwner(bound_module_id)):
			module_ids_equal(module_id, bound_module_id)
		(None, CompilerBuiltinBoundTraitOwner):
			True
		_:
			False

	(
		owner_matches
		and trait_id_definition_id(id) == identity.definition_id
		and trait_id_name(definition_table, id) == identity.name
		and source_locations_equal(
			trait_id_source_span(definition_table, id),
			identity.span,
		)
	)


private pure func trait_method_ids_are_valid(item: AcceptedTraitTableRecord) -> Bool:
	if item.method_ids.length() != item.definition.methods.length():
		False
	else:
		var valid: Bool = True

		for indexed in item.method_ids.enumerate():
			method = item.definition.methods.get(indexed[0])

			if (
				method.is_none()
				or not trait_ids_equal(trait_method_id_owner(indexed[1]), item.id)
				or trait_method_id_index(indexed[1]) != indexed[0]
			):
				valid = False
				break

		valid


private pure func implementation_method_ids_are_valid(
	definition_table: DefinitionTable,
	module_table: ModuleTable,
	item: AcceptedImplementationTableRecord,
) -> Bool:
	owner_module_path = implementation_owner_module_path(definition_table, module_table, item)

	if item.method_ids.length() != item.instance.methods.length() or owner_module_path.is_none():
		False
	else:
		var valid: Bool = True
		var seen_method_definition_ids: Dict[Int, Bool] = {}

		for pair in item.method_ids.zip(item.instance.methods):
			definition_id = callable_id_definition_id(pair[0])

			if (
				seen_method_definition_ids.contains(definition_id)
				or callable_id_module_id(
					definition_table,
					pair[0],
				) != impl_id_module_id(definition_table, item.id)
				or callable_id_name(definition_table, pair[0]) != Some(pair[1].name)
				or match pair[1].target:
					Some(target):
						target.callable_id != callable_id_definition_id(pair[0])
					None:
						True
			):
				valid = False
				break
			else:
				seen_method_definition_ids = seen_method_definition_ids.set(definition_id, True)

		valid


private pure func trait_record_is_valid(
	definition_table: DefinitionTable,
	module_table: ModuleTable,
	item: AcceptedTraitTableRecord,
) -> Bool:
	owner_module_path = trait_owner_module_path(definition_table, module_table, item)

	(
		item.definition.def_id == trait_id_definition_id(item.id)
		and item.definition.name == trait_id_name(definition_table, item.id)
		and item.definition.module_path == owner_module_path
		and owner_module_path.is_some()
		and match item.compiler_builtin_id:
			Some(id):
				(
					trait_id_is_compiler_builtin(id)
					and trait_id_name(
						definition_table,
						id,
					) == trait_id_name(definition_table, item.id)
				)
			None:
				True
		and trait_method_ids_are_valid(item)
	)


private pure func implementation_record_is_valid(
	definition_table: DefinitionTable,
	module_table: ModuleTable,
	item: AcceptedImplementationTableRecord,
) -> Bool:
	owner_module_path = implementation_owner_module_path(definition_table, module_table, item)

	(
		item.instance.def_id == impl_id_definition_id(item.id)
		and impl_id_name(
			definition_table,
			item.id,
		) == trait_id_name(definition_table, item.trait_id)
		and item.instance.trait_name == trait_id_name(definition_table, item.trait_id)
		and owner_module_path.is_some()
		and implementation_method_ids_are_valid(definition_table, module_table, item)
	)


private pure func implementation_method_ids_conflict_with_index(
	definition_table: DefinitionTable,
	indices: List[Dict[Int, Bool]],
	item: AcceptedImplementationTableRecord,
) -> Bool:
	var conflict: Bool = False

	for id in item.method_ids:
		module_key = callable_id_module_id(definition_table, id)
			.map(module_id_table_index)
			.get_or(-1)
		module_ids = indices
			.get(module_key)
			.get_or({})

		if module_ids.contains(callable_id_definition_id(id)):
			conflict = True
			break

	conflict


private pure func index_implementation_method_ids(
	definition_table: DefinitionTable,
	indices: List[Dict[Int, Bool]],
	item: AcceptedImplementationTableRecord,
) -> List[Dict[Int, Bool]]:
	var result = indices

	for id in item.method_ids:
		module_key = callable_id_module_id(definition_table, id)
			.map(module_id_table_index)
			.get_or(-1)
		result = result.set(
			module_key,
			result.get_or(module_key, {}).set(
				callable_id_definition_id(id),
				True,
			),
		)

	result


private pure func trait_index_from_indices(
	traits: List[AcceptedTraitTableRecord],
	indices: Dict[Int, Int],
	id: TraitId,
) -> Option[Int]:
	index ?= indices.get(trait_id_definition_id(id))
	item ?= traits.get(index)

	if trait_ids_equal(item.id, id):
		Some(index)
	else:
		None


private pure func append_unique_index(indices: List[Int], index: Int) -> List[Int]:
	if indices.contains(index):
		indices
	else:
		indices.append(index)


private pure func compiler_trait_index_from_indices(
	traits: List[AcceptedTraitTableRecord],
	indices: Dict[Int, Int],
	id: TraitId,
) -> Option[Int]:
	index ?= indices.get(trait_id_storage_key(id))
	item ?= traits.get(index)
	linked ?= item.compiler_builtin_id

	if trait_ids_equal(linked, id):
		Some(index)
	else:
		None


private pure func trait_compiler_link_from_indices(
	traits: List[AcceptedTraitTableRecord],
	trait_indices: Dict[Int, Int],
	id: TraitId,
) -> Option[TraitId]:
	if trait_id_is_compiler_builtin(id):
		Some(id)
	else:
		trait_index_from_indices(traits, trait_indices, id)
			.and_then(func(index): traits.get(index))
			.and_then(func(item): item.compiler_builtin_id)


private pure func append_conflicting_implementation_index(
	conflicts: List[List[Int]],
	implementation_index: Int,
	conflicting_index: Int,
) -> List[List[Int]]:
	match conflicts.get(implementation_index):
		Some(indices):
			conflicts.set(
				implementation_index,
				indices.append(conflicting_index),
			)
		None:
			conflicts


private pure func satisfied_trait_indices_seen(
	traits: List[AcceptedTraitTableRecord],
	trait_indices: Dict[Int, Int],
	trait_indices_by_compiler_identity: Dict[Int, Int],
	seen: List[Int],
	trait_id: TraitId,
) -> List[Int]:
	trait_index = match trait_index_from_indices(traits, trait_indices, trait_id):
		Some(index):
			Some(index)
		None:
			if trait_id_is_compiler_builtin(trait_id):
				compiler_trait_index_from_indices(
					traits,
					trait_indices_by_compiler_identity,
					trait_id,
				)
			else:
				None

	match trait_index:
		Some(index):
			if seen.contains(index):
				[]
			else:
				var result: List[Int] = [index]

				match traits.get(index):
					Some(item):
						for supertrait in item.supertraits:
							for satisfied_index in satisfied_trait_indices_seen(
								traits,
								trait_indices,
								trait_indices_by_compiler_identity,
								seen.append(index),
								supertrait,
							):
								result = append_unique_index(result, satisfied_index)
					None:
						void

				result
		None:
			[]


private pure func trait_method_id_for_name_seen(
	traits: List[AcceptedTraitTableRecord],
	indices: Dict[Int, Int],
	indices_by_compiler_identity: Dict[Int, Int],
	seen: List[Int],
	trait_id: TraitId,
	method_name: String,
) -> Option[TraitMethodId]:
	trait_index ?= match trait_index_from_indices(traits, indices, trait_id):
		Some(index):
			Some(index)
		None:
			if trait_id_is_compiler_builtin(trait_id):
				compiler_trait_index_from_indices(traits, indices_by_compiler_identity, trait_id)
			else:
				None

	if seen.contains(trait_index):
		None
	else:
		item ?= traits.get(trait_index)
		var result: Option[TraitMethodId] = None
		var method_index: Int = 0

		for method in item.definition.methods:
			match item.method_ids.get(method_index):
				Some(method_id):
					if method.name == method_name:
						result = Some(method_id)
				None:
					void

			if result.is_some():
				break

			method_index += 1

		if result.is_none():
			for supertrait in item.supertraits:
				match trait_method_id_for_name_seen(
					traits,
					indices,
					indices_by_compiler_identity,
					seen.append(trait_index),
					supertrait,
					method_name,
				):
					Some(method_id):
						result = Some(method_id)
					None:
						void

				if result.is_some():
					break

		result


pure func accepted_trait_implementation_table_validation_errors(
	input: AcceptedTraitImplementationTableInput,
) -> List[String]:
	var errors: List[String] = []

	if not definition_table_is_compatible_with_module_table(
		input.definition_table,
		input.module_table,
	):
		errors = errors.append("accepted declaration tables have incompatible module domains")

	var trait_indices: Dict[Int, Int] = {}

	for indexed in input.traits.enumerate():
		item = indexed[1]
		module_id = trait_id_module_id(input.definition_table, item.id)
		module_key = module_id.map(module_id_table_index)

		definition_id = trait_id_definition_id(item.id)

		if module_key.is_none() or trait_indices.contains(definition_id):
			errors = errors.append(
				"duplicate accepted trait ID for '" + trait_id_name(
					input.definition_table,
					item.id,
				) + "'",
			)
		else if not trait_record_is_valid(input.definition_table, input.module_table, item):
			errors = errors.append(
				"invalid accepted trait record for '" + trait_id_name(
					input.definition_table,
					item.id,
				) + "'",
			)
		else:
			trait_indices = trait_indices.set(definition_id, indexed[0])

	empty_implementation_definitions: Dict[Int, Bool] = {}
	var implementation_ids: Dict[Int, Bool] = {}
	var implementation_method_ids: List[Dict[Int, Bool]] = repeat(
		empty_implementation_definitions,
		module_table_count(input.module_table),
	)

	for item in input.implementations:
		module_key = impl_id_module_id(input.definition_table, item.id).map(module_id_table_index)
		definition_id = impl_id_definition_id(item.id)

		if module_key.is_none() or implementation_ids.contains(definition_id):
			errors = errors.append(
				"duplicate accepted implementation ID for trait '" + trait_id_name(
					input.definition_table,
					item.trait_id,
				) + "'",
			)
		else if not implementation_record_is_valid(
			input.definition_table,
			input.module_table,
			item,
		):
			errors = errors.append(
				"invalid accepted implementation record for trait '" + trait_id_name(
					input.definition_table,
					item.trait_id,
				) + "'",
			)
		else if (
			not trait_id_is_compiler_builtin(item.trait_id)
			and trait_index_from_indices(input.traits, trait_indices, item.trait_id).is_none()
		):
			owner_path = trait_id_module_id(input.definition_table, item.trait_id)
				.and_then(func(module_id):
					module_table_canonical_path(input.module_table, module_id)
				)
				.get_or("<compiler builtin>")
			errors = errors.append(
				"accepted implementation trait ID is absent for '" + trait_id_name(
					input.definition_table,
					item.trait_id,
				) + "' owner=" + owner_path + " definition=" + trait_id_definition_id(
					item.trait_id,
				).to_string(),
			)
		else if implementation_method_ids_conflict_with_index(
			input.definition_table,
			implementation_method_ids,
			item,
		):
			errors = errors.append(
				"duplicate accepted implementation method ID for trait '" + trait_id_name(
					input.definition_table,
					item.trait_id,
				) + "'",
			)
		else:
			implementation_ids = implementation_ids.set(definition_id, True)
			implementation_method_ids = index_implementation_method_ids(
				input.definition_table,
				implementation_method_ids,
				item,
			)

	errors


pure func accepted_trait_implementation_table(
	input: AcceptedTraitImplementationTableInput,
) -> Option[AcceptedTraitImplementationTable]:
	empty_method_definitions: Dict[Int, Bool] = {}
	empty_indices: List[Int] = []
	var trait_indices: Dict[Int, Int] = {}
	var implementation_indices: Dict[Int, Int] = {}
	var implementation_method_ids: List[Dict[Int, Bool]] = repeat(
		empty_method_definitions,
		module_table_count(input.module_table),
	)
	var trait_indices_by_module: List[List[Int]] = repeat(
		empty_indices,
		module_table_count(input.module_table),
	)
	var implementation_indices_by_module: List[List[Int]] = repeat(
		empty_indices,
		module_table_count(input.module_table),
	)
	var implementation_trait_method_ids: List[List[Option[TraitMethodId]]] = []
	var qualified_implementation_indices_by_module_and_method: Dict[String, Dict[String, List[Int]]] = {

	}
	var qualified_implementation_method_row_count: Int = 0
	var compiler_trait_id_by_implementation: List[Option[TraitId]] = []
	var satisfied_trait_indices_by_implementation: List[List[Int]] = []
	var conflicting_implementation_indices_by_implementation: List[List[Int]] = []
	var trait_index_by_compiler_identity: Dict[Int, Int] = {}
	var valid: Bool = True
	var trait_index: Int = 0

	if not definition_table_is_compatible_with_module_table(
		input.definition_table,
		input.module_table,
	):
		valid = False

	for item in input.traits:
		module_id = trait_id_module_id(input.definition_table, item.id)
		module_key = module_id.map(module_id_table_index)

		definition_id = trait_id_definition_id(item.id)

		if (
			module_key.is_none()
			or trait_indices.contains(definition_id)
			or not trait_record_is_valid(input.definition_table, input.module_table, item)
		):
			valid = False
		else:
			trait_indices = trait_indices.set(definition_id, trait_index)
			trait_indices_by_module = trait_indices_by_module.set(
				module_key.get_or(0),
				trait_indices_by_module
					.get(module_key.get_or(0))
					.get_or([])
					.append(trait_index),
			)

			match item.compiler_builtin_id:
				Some(id):
					identity_key = trait_id_storage_key(id)

					if trait_index_by_compiler_identity.contains(identity_key):
						valid = False
					else:
						trait_index_by_compiler_identity = trait_index_by_compiler_identity.set(
							identity_key,
							trait_index,
						)
				None:
					void

		trait_index += 1

	var implementation_index: Int = 0

	var qualified_implementation_index: Int = 0

	for item in input.implementations:
		module_key = impl_id_module_id(input.definition_table, item.id).map(module_id_table_index)
		definition_id = impl_id_definition_id(item.id)

		if (
			module_key.is_none()
			or implementation_indices.contains(definition_id)
			or not implementation_record_is_valid(input.definition_table, input.module_table, item)
			or implementation_method_ids_conflict_with_index(
				input.definition_table,
				implementation_method_ids,
				item,
			)
			or (
				not trait_id_is_compiler_builtin(item.trait_id)
				and trait_index_from_indices(input.traits, trait_indices, item.trait_id).is_none()
			)
		):
			valid = False
		else:
			implementation_indices = implementation_indices.set(definition_id, implementation_index)
			implementation_indices_by_module = implementation_indices_by_module.set(
				module_key.get_or(0),
				implementation_indices_by_module
					.get(module_key.get_or(0))
					.get_or([])
					.append(implementation_index),
			)
			implementation_method_ids = index_implementation_method_ids(
				input.definition_table,
				implementation_method_ids,
				item,
			)

		implementation_index += 1

	for item in input.implementations:
		conflicting_implementation_indices_by_implementation = conflicting_implementation_indices_by_implementation.append(
			[],
		)
		satisfied_trait_indices_by_implementation = satisfied_trait_indices_by_implementation.append(
			satisfied_trait_indices_seen(
				input.traits,
				trait_indices,
				trait_index_by_compiler_identity,
				[],
				item.trait_id,
			),
		)
		var method_traits: List[Option[TraitMethodId]] = []

		for method_id in item.method_ids:
			trait_method_id = trait_method_id_for_name_seen(
				input.traits,
				trait_indices,
				trait_index_by_compiler_identity,
				[],
				item.trait_id,
				callable_id_name(input.definition_table, method_id).get_or(""),
			)
			method_traits = method_traits.append(trait_method_id)

			match trait_method_id:
				Some(id):
					trait_item = trait_index_from_indices(
						input.traits,
						trait_indices,
						trait_method_id_owner(id),
					).and_then(
						func(index): input.traits.get(index),
					)
					method_name = trait_item
						.and_then(func(value):
							value.definition.methods.get(trait_method_id_index(id))
						)
						.map(func(method): method.name)
						.get_or("<unknown method>")

					var owner_paths: List[String] = match implementation_owner_module_path(
						input.definition_table,
						input.module_table,
						item,
					):
						Some(path):
							[path]
						None:
							[]

					trait_owner_path = match trait_item:
						Some(value):
							trait_owner_module_path(
								input.definition_table,
								input.module_table,
								value,
							)
						None:
							None

					match trait_owner_path:
						Some(path):
							if not owner_paths.contains(path):
								owner_paths = owner_paths.append(path)
						None:
							void

					for module_path in owner_paths:
						methods = qualified_implementation_indices_by_module_and_method.get_or(
							module_path,
							{},
						)
						indices = methods.get_or(method_name, [])
						qualified_implementation_indices_by_module_and_method = qualified_implementation_indices_by_module_and_method.set(
							module_path,
							methods.set(
								method_name,
								append_unique_index(indices, qualified_implementation_index),
							),
						)
						qualified_implementation_method_row_count += 1
				None:
					void

		implementation_trait_method_ids = implementation_trait_method_ids.append(method_traits)
		compiler_trait_id_by_implementation = compiler_trait_id_by_implementation.append(
			trait_compiler_link_from_indices(
				input.traits,
				trait_indices,
				item.trait_id,
			),
		)
		qualified_implementation_index += 1

	-- Coherence relationships depend only on canonical table entries. Compute
	-- them once within exact/compiler-linked trait buckets so unrelated traits
	-- are never overlap candidates and module projections only test indices.
	var coherence_buckets: Dict[Int, List[Int]] = {}

	for indexed in input.implementations.enumerate():
		current_index = indexed[0]
		current = indexed[1]
		bucket_key = trait_id_storage_key(
			trait_compiler_link_from_indices(
				input.traits,
				trait_indices,
				current.trait_id,
			).get_or(current.trait_id),
		)
		prior_indices = coherence_buckets.get_or(bucket_key, [])

		for prior_index in prior_indices:
			match input.implementations.get(prior_index):
				Some(prior):
					match (prior.visibility, current.visibility):
						(PublicDeclaration, PublicDeclaration):
							if impl_instances_may_overlap(prior.instance, current.instance):
								conflicting_implementation_indices_by_implementation = append_conflicting_implementation_index(
									conflicting_implementation_indices_by_implementation,
									prior_index,
									current_index,
								)
								conflicting_implementation_indices_by_implementation = append_conflicting_implementation_index(
									conflicting_implementation_indices_by_implementation,
									current_index,
									prior_index,
								)
						(PublicDeclaration, PrivateDeclaration):
							if impl_instances_may_overlap(prior.instance, current.instance):
								conflicting_implementation_indices_by_implementation = append_conflicting_implementation_index(
									conflicting_implementation_indices_by_implementation,
									current_index,
									prior_index,
								)
						(PrivateDeclaration, PublicDeclaration):
							if impl_instances_may_overlap(prior.instance, current.instance):
								conflicting_implementation_indices_by_implementation = append_conflicting_implementation_index(
									conflicting_implementation_indices_by_implementation,
									prior_index,
									current_index,
								)
						(PrivateDeclaration, PrivateDeclaration):
							if types_equal(prior.instance.for_type, current.instance.for_type):
								conflicting_implementation_indices_by_implementation = append_conflicting_implementation_index(
									conflicting_implementation_indices_by_implementation,
									prior_index,
									current_index,
								)
								conflicting_implementation_indices_by_implementation = append_conflicting_implementation_index(
									conflicting_implementation_indices_by_implementation,
									current_index,
									prior_index,
								)
				None:
					void

		coherence_buckets = coherence_buckets.set(
			bucket_key,
			prior_indices.append(current_index),
		)

	if valid:
		Some(into_opaque AcceptedTraitImplementationTable({
					module_table = input.module_table,
					definition_table = input.definition_table,
					traits = input.traits,
					implementations = input.implementations,
					implementation_trait_method_ids = implementation_trait_method_ids,
					qualified_implementation_indices_by_module_and_method = qualified_implementation_indices_by_module_and_method,
					qualified_implementation_method_row_count = qualified_implementation_method_row_count,
					compiler_trait_id_by_implementation = compiler_trait_id_by_implementation,
					satisfied_trait_indices_by_implementation = satisfied_trait_indices_by_implementation,
					conflicting_implementation_indices_by_implementation = conflicting_implementation_indices_by_implementation,
					trait_index_by_definition_id = trait_indices,
					trait_index_by_compiler_identity = trait_index_by_compiler_identity,
					implementation_index_by_definition_id = implementation_indices,
					trait_indices_by_module = trait_indices_by_module,
					implementation_indices_by_module = implementation_indices_by_module
				}))
	else:
		None


pure func accepted_trait_ids_for_owner(
	table: AcceptedTraitImplementationTable,
	owner_module_path: String,
) -> List[TraitId]:
	representation = table_rep(table)
	var result: List[TraitId] = []
	owner_id = module_table_find_id_by_canonical_path(
		representation.module_table,
		owner_module_path,
	)
	owner_indices = owner_id
		.and_then(func(module_id):
			representation.trait_indices_by_module.get(module_id_table_index(module_id))
		)
		.get_or([])

	for index in owner_indices:
		match representation.traits.get(index):
			Some(item):
				result = result.append(item.id)
			None:
				void

	result


pure func accepted_implementation_definition_ids_for_owner(
	table: AcceptedTraitImplementationTable,
	owner_module_path: String,
) -> List[AcceptedImplementationDefinitionIds]:
	representation = table_rep(table)
	var result: List[AcceptedImplementationDefinitionIds] = []
	owner_id = module_table_find_id_by_canonical_path(
		representation.module_table,
		owner_module_path,
	)
	owner_indices = owner_id
		.and_then(func(module_id):
			representation.implementation_indices_by_module.get(module_id_table_index(module_id))
		)
		.get_or([])

	for index in owner_indices:
		match representation.implementations.get(index):
			Some(item):
				result = result.append({
					id = item.id,
					method_ids = item.method_ids,
				})
			None:
				void

	result


private pure func table_find_trait_index(
	table: AcceptedTraitImplementationTableRep,
	id: TraitId,
) -> Option[Int]:
	index ?= table.trait_index_by_definition_id.get(trait_id_definition_id(id))
	item ?= table.traits.get(index)

	if trait_ids_equal(item.id, id):
		Some(index)
	else:
		None


private pure func table_find_trait_identity_index(
	table: AcceptedTraitImplementationTableRep,
	issuing_table: DefinitionTable,
	id: TraitId,
) -> Option[Int]:
	if not definition_tables_share_provenance(table.definition_table, issuing_table):
		None
	else if trait_id_is_compiler_builtin(id):
		index ?= table.trait_index_by_compiler_identity.get(trait_id_storage_key(id))
		item ?= table.traits.get(index)
		linked ?= item.compiler_builtin_id

		if trait_ids_equal(linked, id):
			Some(index)
		else:
			None
	else:
		table_find_trait_index(table, id)


private pure func table_find_bound_trait_index(
	table: AcceptedTraitImplementationTableRep,
	identity: BoundTraitIdentity,
) -> Option[Int]:
	if identity.owner == CompilerBuiltinBoundTraitOwner:
		builtin_id ?= builtin_trait_id(identity.name)
		index ?= table.trait_index_by_compiler_identity.get(trait_id_storage_key(builtin_id))
		item ?= table.traits.get(index)
		linked ?= item.compiler_builtin_id

		if bound_trait_identity_matches_id(table.definition_table, identity, linked):
			Some(index)
		else:
			None
	else:
		index ?= table.trait_index_by_definition_id.get(identity.definition_id)
		item ?= table.traits.get(index)

		if bound_trait_identity_matches_id(table.definition_table, identity, item.id):
			Some(index)
		else:
			None


private pure func table_find_implementation_index(
	table: AcceptedTraitImplementationTableRep,
	id: ImplId,
) -> Option[Int]:
	index ?= table.implementation_index_by_definition_id.get(impl_id_definition_id(id))
	item ?= table.implementations.get(index)

	if impl_ids_equal(item.id, id):
		Some(index)
	else:
		None


private pure func table_trait_has_supertrait_seen(
	table: AcceptedTraitImplementationTableRep,
	seen: List[Int],
	trait_index: Int,
	target: TraitId,
) -> Bool:
	if seen.contains(trait_index):
		False
	else:
		match table.traits.get(trait_index):
			None:
				False
			Some(item):
				var found: Bool = False

				for supertrait in item.supertraits:
					if trait_ids_equal(supertrait, target):
						found = True
					else:
						match table_find_trait_index(table, supertrait):
							Some(supertrait_index):
								if table_trait_has_supertrait_seen(
									table,
									seen.append(trait_index),
									supertrait_index,
									target,
								):
									found = True
							None:
								void

					if found:
						break

				found


private pure func table_trait_compiler_link(
	table: AcceptedTraitImplementationTableRep,
	id: TraitId,
) -> Option[TraitId]:
	if trait_id_is_compiler_builtin(id):
		Some(id)
	else:
		table_find_trait_index(table, id)
			.and_then(func(index): table.traits.get(index))
			.and_then(func(item): item.compiler_builtin_id)


private pure func table_trait_ids_semantically_equivalent(
	table: AcceptedTraitImplementationTableRep,
	left: TraitId,
	right: TraitId,
) -> Bool:
	(
		trait_ids_equal(left, right)
		or match (table_trait_compiler_link(table, left), table_trait_compiler_link(table, right)):
			(Some(left_compiler), Some(right_compiler)):
				trait_ids_equal(left_compiler, right_compiler)
			_:
				False
	)


---
Accepted inference policies compare the exact selected trait with a
compiler-owned semantic identity. Source declarations only match when the
accepted table explicitly linked them to that compiler trait; equal
spellings alone are never evidence.
---
pure func accepted_trait_matches_compiler_identity(
	authority: AcceptedTraitImplementationAuthority,
	issuing_table: DefinitionTable,
	trait_id: TraitId,
	compiler_trait_id: TraitId,
) -> Bool:
	representation = authority_rep(authority)
	table = table_rep(representation.table)

	if not trait_id_is_compiler_builtin(compiler_trait_id):
		False
	else:
		match table_find_trait_identity_index(table, issuing_table, trait_id):
			Some(index):
				match table.traits.get(index):
					Some(item):
						match item.compiler_builtin_id:
							Some(linked):
								trait_ids_equal(linked, compiler_trait_id)
							None:
								False
					None:
						False
			None:
				False


private pure func implementation_type_label(
	definition_table: DefinitionTable,
	module_table: ModuleTable,
	owner_module_path: String,
	item: AcceptedImplementationTableRecord,
) -> String:
	item_owner_module_path = implementation_owner_module_path(
		definition_table,
		module_table,
		item,
	).get_or(owner_module_path)

	for_type = if item_owner_module_path == owner_module_path:
		localize_module_types(item_owner_module_path, item.instance.for_type)
	else:
		item.instance.for_type

	match for_type:
		SemanticNamedType(name, _):
			name
		_:
			"<non-named type>"


private pure func visible_trait_method_source_index(row: AcceptedVisibleTraitMethodRow) -> Int:
	source_name_id_table_index(row.source_name_id)


private pure func visible_trait_source_index(row: AcceptedVisibleTraitRow) -> Int:
	source_name_id_table_index(row.source_name_id)


---
Preserve the former map's last-writer-wins behavior for duplicate local or
selective source names. Sorting moves identity comparisons off managed text.
---
private pure func normalized_visible_traits(
	candidates: List[AcceptedVisibleTraitRow],
) -> List[AcceptedVisibleTraitRow]:
	var rows: List[AcceptedVisibleTraitRow] = []

	for candidate in candidates.sort_by(visible_trait_source_index):
		match rows.last():
			Some(existing):
				if source_name_ids_equal(existing.source_name_id, candidate.source_name_id):
					rows = rows.set(rows.length() - 1, candidate)
				else:
					rows = rows.append(candidate)
			None:
				rows = rows.append(candidate)

	rows


private pure func visible_trait_for_source_name(
	rows: List[AcceptedVisibleTraitRow],
	source_name_id: SourceNameId,
) -> Option[AcceptedVisibleTraitRow]:
	target_index = source_name_id_table_index(source_name_id)
	var low: Int = 0
	var high: Int = rows.length()
	var valid: Bool = True

	while low < high and valid:
		middle = low + (high - low) / 2

		match rows.get(middle):
			Some(row):
				if visible_trait_source_index(row) < target_index:
					low = middle + 1
				else:
					high = middle
			None:
				valid = False

	if valid:
		match rows.get(low):
			Some(row):
				if source_name_ids_equal(row.source_name_id, source_name_id):
					Some(row)
				else:
					None
			None:
				None
	else:
		None


private pure func normalized_visible_trait_methods(
	definition_table: DefinitionTable,
	source_names: SourceNameTable,
	candidates: List[AcceptedVisibleTraitMethodRow],
	initial_errors: List[String],
) -> (List[AcceptedVisibleTraitMethodRow], List[String]):
	var rows: List[AcceptedVisibleTraitMethodRow] = []
	var errors = initial_errors

	for candidate in candidates.sort_by(visible_trait_method_source_index):
		match rows.last():
			Some(existing):
				if source_name_ids_equal(existing.source_name_id, candidate.source_name_id):
					if not trait_method_ids_equal(existing.method_id, candidate.method_id):
						method_name = source_name_table_spelling(
							source_names,
							candidate.source_name_id,
						).get_or("<unknown method>")
						existing_trait = trait_id_name(
							definition_table,
							trait_method_id_owner(existing.method_id),
						)
						incoming_trait = trait_id_name(
							definition_table,
							trait_method_id_owner(candidate.method_id),
						)
						errors = errors.append(
							"method '" + method_name + "' is already registered under trait '" + existing_trait + "'; cannot also register under '" + incoming_trait + "'",
						)
				else:
					rows = rows.append(candidate)
			None:
				rows = rows.append(candidate)

	(rows, errors)


private pure func visible_trait_method_for_source_name(
	rows: List[AcceptedVisibleTraitMethodRow],
	source_name_id: SourceNameId,
) -> Option[AcceptedVisibleTraitMethodRow]:
	target_index = source_name_id_table_index(source_name_id)
	var low: Int = 0
	var high: Int = rows.length()
	var valid: Bool = True

	while low < high and valid:
		middle = low + (high - low) / 2

		match rows.get(middle):
			Some(row):
				if visible_trait_method_source_index(row) < target_index:
					low = middle + 1
				else:
					high = middle
			None:
				valid = False

	if valid:
		match rows.get(low):
			Some(row):
				if source_name_ids_equal(row.source_name_id, source_name_id):
					Some(row)
				else:
					None
			None:
				None
	else:
		None


---
The trait half of an accepted authority: visibility, name resolution, and
trait methods. Identical whether computed against a table with or without
implementations, since none of it reads implementation-side table fields.
Callers that need a full authority pass the result to
`accepted_trait_implementation_authority_from_fields`; callers that only
need trait names (header conversion) keep this value instead.
---
private pure func accepted_trait_projection_fields(
	table: AcceptedTraitImplementationTable,
	owner_module_path: String,
	visibility: AcceptedTraitVisibility,
	direct_module_paths: List[String],
) -> AcceptedTraitProjectionFields:
	representation = table_rep(table)
	visibility_representation = accepted_trait_visibility_rep(visibility)
	source_names = visibility_representation.source_name_table
	visibility_is_valid = definition_tables_share_provenance(
		representation.definition_table,
		table_rep(visibility_representation.table).definition_table,
	)

	bindings: List[AcceptedVisibleTraitBinding] = if visibility_is_valid:
		visibility_representation.bindings
	else:
		[]

	var visible_trait_candidates: List[AcceptedVisibleTraitRow] = []
	var visible_trait_indices: List[Int] = []
	var unqualified_trait_indices: List[Int] = []
	var visible_trait_method_candidates: List[AcceptedVisibleTraitMethodRow] = []

	var preparation_errors: List[String] = if visibility_is_valid:
		[]
	else:
		["accepted trait visibility belongs to a different definition table"]

	for module_path in direct_module_paths:
		for index in trait_indices_for_module_path(representation, module_path):
			match representation.traits.get(index):
				Some(item):
					if item.visibility == PublicDeclaration:
						visible_trait_indices = append_unique_index(visible_trait_indices, index)
				None:
					void

	for index in trait_indices_for_module_path(representation, owner_module_path):
		visible_trait_indices = append_unique_index(visible_trait_indices, index)

	for index in trait_indices_for_module_path(representation, owner_module_path):
		match representation.traits.get(index):
			Some(item):
				match source_name_table_find_id(source_names, item.definition.name):
					Some(source_name_id):
						visible_trait_candidates = visible_trait_candidates.append({
							source_name_id = source_name_id,
							trait_id = item.id,
						})
					None:
						preparation_errors = preparation_errors.append(
							"accepted source-name table is missing trait '" + item.definition.name + "'",
						)

				unqualified_trait_indices = append_unique_index(unqualified_trait_indices, index)
			None:
				void

	for binding in bindings:
		match binding:
			AcceptedVisibleTraitDefinitionBinding(source_name_id, trait_id):
				match table_find_trait_index(representation, trait_id):
					Some(index):
						match representation.traits.get(index):
							Some(item):
								if item.visibility == PublicDeclaration:
									visible_trait_candidates = visible_trait_candidates.append({
										source_name_id = source_name_id,
										trait_id = trait_id,
									})
									unqualified_trait_indices = append_unique_index(
										unqualified_trait_indices,
										index,
									)
							None:
								void
					None:
						void
			AcceptedVisibleTraitMethodBinding(_, _):
				void

	-- Compiler-linked prelude traits are intentionally available without an
	-- explicit source binding. User-defined traits, including qualified-only
	-- namesakes, never enter the bare-name map through this path.
	for index in visible_trait_indices:
		match representation.traits.get(index):
			Some(item):
				if item.compiler_builtin_id.is_some():
					match source_name_table_find_id(source_names, item.definition.name):
						Some(source_name_id):
							if (
								not visible_trait_candidates.any(func(row):
									source_name_ids_equal(row.source_name_id, source_name_id)
								)
							):
								visible_trait_candidates = visible_trait_candidates.append({
									source_name_id = source_name_id,
									trait_id = item.id,
								})
								unqualified_trait_indices = append_unique_index(
									unqualified_trait_indices,
									index,
								)
						None:
							preparation_errors = preparation_errors.append(
								"accepted source-name table is missing trait '" + item.definition.name + "'",
							)
			None:
				void

	-- Semantic trait-method and obligation resolution also sees ambient direct
	-- implementation modules. Resolved source bindings win, so adding a
	-- qualified-only namesake cannot replace a selective or local trait.
	visible_traits = normalized_visible_traits(visible_trait_candidates)
	var semantic_traits: Dict[String, Int] = {}

	for row in visible_traits:
		match (
			source_name_table_spelling(source_names, row.source_name_id),
			table_find_trait_index(representation, row.trait_id),
		):
			(Some(name), Some(index)):
				semantic_traits = semantic_traits.set(name, index)
			_:
				preparation_errors = preparation_errors.append(
					"accepted visible trait row has invalid source or semantic identity",
				)

	for index in visible_trait_indices:
		match representation.traits.get(index):
			Some(item):
				if not semantic_traits.contains(item.definition.name):
					semantic_traits = semantic_traits.set(item.definition.name, index)
			None:
				void

	for index in unqualified_trait_indices:
		match representation.traits.get(index):
			Some(_):
				for pair in table_trait_methods_seen(representation, [], index):
					match source_name_table_find_id(source_names, pair[0]):
						Some(source_name_id):
							visible_trait_method_candidates = visible_trait_method_candidates.append({
								source_name_id = source_name_id,
								method_id = pair[1],
							})
						None:
							preparation_errors = preparation_errors.append(
								"accepted source-name table is missing trait method '" + pair[0] + "'",
							)
			None:
				void

	-- A selectively imported method is an unqualified binding even when its
	-- declaring trait name is not imported. Qualified-only and merely direct
	-- modules do not contribute entries to this source-name relation.
	for binding in bindings:
		match binding:
			AcceptedVisibleTraitMethodBinding(source_name_id, method_id):
				visible_trait_method_candidates = visible_trait_method_candidates.append({
					source_name_id = source_name_id,
					method_id = method_id,
				})
			AcceptedVisibleTraitDefinitionBinding(_, _):
				void

	normalized_trait_methods = normalized_visible_trait_methods(
		representation.definition_table,
		source_names,
		visible_trait_method_candidates,
		preparation_errors,
	)

	{
		table = table,
		owner_module_path = owner_module_path,
		source_name_table = source_names,
		direct_module_paths = direct_module_paths,
		visible_trait_indices = visible_trait_indices,
		trait_indices_by_semantic_name = semantic_traits,
		visible_traits = visible_traits,
		visible_trait_methods = normalized_trait_methods[0],
		preparation_errors = normalized_trait_methods[1]
	}


---
Build a full authority from trait-projection fields (already resolved, and
possibly shared with an earlier header-conversion projection) and a table
that carries the real implementation records. Never called with a table
whose implementation half does not yet exist; use
`accepted_trait_projection_fields` alone for that.
---
private pure func accepted_trait_implementation_authority_from_fields(
	table: AcceptedTraitImplementationTable,
	fields: AcceptedTraitProjectionFields,
) -> AcceptedTraitImplementationAuthority:
	representation = table_rep(table)
	var visible_implementations: List[Int] = []
	var implementation_indices_by_satisfied_trait_index: Dict[Int, List[Int]] = {}
	var implementation_indices_by_trait_name: Dict[String, List[Int]] = {}
	var compiler_implementations_by_trait_identity: Dict[Int, AcceptedCompilerImplementationBucket] = {

	}
	var preparation_errors: List[String] = fields.preparation_errors
	var visible_trait_index_set: Dict[Int, Bool] = {}

	for index in fields.visible_trait_indices:
		visible_trait_index_set = visible_trait_index_set.set(index, True)

	for module_path in fields.direct_module_paths:
		for index in implementation_indices_for_module_path(representation, module_path):
			match representation.implementations.get(index):
				Some(item):
					if item.visibility == PublicDeclaration:
						visible_implementations = append_unique_index(
							visible_implementations,
							index,
						)
				None:
					void

	for index in implementation_indices_for_module_path(representation, fields.owner_module_path):
		visible_implementations = append_unique_index(visible_implementations, index)

	var prior_visible_implementation_indices: Dict[Int, Bool] = {}
	var accepted_visible_implementation_indices: List[Int] = []

	for index in visible_implementations:
		match representation.implementations.get(index):
			Some(item):
				var conflict: Bool = False

				for conflicting_index in representation.conflicting_implementation_indices_by_implementation.get_or(
					index,
					[],
				):
					if prior_visible_implementation_indices.contains(conflicting_index):
						conflict = True
						break

				if conflict:
					preparation_errors = preparation_errors.append(
						"conflicting implementation of trait '" + item.instance.trait_name + "' for type '" + implementation_type_label(
							representation.definition_table,
							representation.module_table,
							fields.owner_module_path,
							item,
						) + "'",
					)
				else:
					prior_visible_implementation_indices = prior_visible_implementation_indices.set(
						index,
						True,
					)
					accepted_visible_implementation_indices = accepted_visible_implementation_indices.append(
						index,
					)
			None:
				void

	visible_implementations = accepted_visible_implementation_indices
	var visible_implementation_rank_by_index = 0.repeat(representation.implementations.length())

	for ranked in visible_implementations.enumerate():
		visible_implementation_rank_by_index = visible_implementation_rank_by_index.set(
			ranked[1],
			ranked[0] + 1,
		)

	for index in visible_implementations:
		match representation.implementations.get(index):
			Some(item):
				implementation_indices_by_trait_name = implementation_indices_by_trait_name.set(
					item.instance.trait_name,
					implementation_indices_by_trait_name
						.get_or(item.instance.trait_name, [])
						.append(index),
				)

				for trait_index in representation.satisfied_trait_indices_by_implementation.get_or(
					index,
					[],
				):
					if visible_trait_index_set.contains(trait_index):
						implementation_indices_by_satisfied_trait_index = implementation_indices_by_satisfied_trait_index.set(
							trait_index,
							implementation_indices_by_satisfied_trait_index
								.get_or(trait_index, [])
								.append(index),
						)

				match representation.compiler_trait_id_by_implementation.get(index):
					Some(Some(id)):
						identity_key = trait_id_storage_key(id)
						bucket = compiler_implementations_by_trait_identity.get_or(
							identity_key,
							{
								trait_id = id,
								implementation_indices = []
							},
						)
						compiler_implementations_by_trait_identity = compiler_implementations_by_trait_identity.set(
							identity_key,
							{ bucket |
								implementation_indices = bucket.implementation_indices.append(index)
							},
						)
					_:
						void
			None:
				void

	into_opaque AcceptedTraitImplementationAuthority({
			table = table,
			owner_module_path = fields.owner_module_path,
			source_name_table = fields.source_name_table,
			visible_trait_indices = fields.visible_trait_indices,
			trait_indices_by_semantic_name = fields.trait_indices_by_semantic_name,
			visible_traits = fields.visible_traits,
			visible_implementation_indices = visible_implementations,
			implementation_indices_by_satisfied_trait_index = implementation_indices_by_satisfied_trait_index,
			implementation_indices_by_trait_name = implementation_indices_by_trait_name,
			compiler_implementations_by_trait_identity = compiler_implementations_by_trait_identity,
			visible_implementation_rank_by_index = visible_implementation_rank_by_index,
			visible_trait_methods = fields.visible_trait_methods,
			preparation_errors = preparation_errors
		})


pure func accepted_trait_implementation_authority(
	table: AcceptedTraitImplementationTable,
	owner_module_path: String,
	visibility: AcceptedTraitVisibility,
	direct_module_paths: List[String],
) -> AcceptedTraitImplementationAuthority:
	accepted_trait_implementation_authority_from_fields(
		table,
		accepted_trait_projection_fields(table, owner_module_path, visibility, direct_module_paths),
	)


---
Build a full authority from a trait-only projection computed earlier
(typically during header conversion) instead of recomputing the trait
half. `table` must be the table whose implementation records are now
known; the projection's own table is not read here.
---
pure func accepted_trait_implementation_authority_from_projection(
	table: AcceptedTraitImplementationTable,
	projection: AcceptedTraitOnlyProjection,
) -> AcceptedTraitImplementationAuthority:
	accepted_trait_implementation_authority_from_fields(table, projection_fields(projection))


pure func accepted_trait_implementation_authority_without_visible_names(
	authority: AcceptedTraitImplementationAuthority,
) -> AcceptedTraitImplementationAuthority:
	representation = authority_rep(authority)
	into_opaque AcceptedTraitImplementationAuthority({ representation |
			visible_trait_indices = [],
			visible_traits = [],
			visible_trait_methods = [],
			preparation_errors = []
		})


pure func accepted_trait_implementation_authority_preparation_errors(
	authority: AcceptedTraitImplementationAuthority,
) -> List[String]:
	authority_rep(authority).preparation_errors


---
Preserve visibility projection failure as an authority preparation error.
Callers must not turn a rejected graph/table pairing into an ordinary empty
namespace, because that would hide a broken compiler invariant.
---
pure func accepted_trait_implementation_authority_from_visibility(
	table: AcceptedTraitImplementationTable,
	owner_module_path: String,
	visibility: Option[AcceptedTraitVisibility],
	direct_module_paths: List[String],
) -> AcceptedTraitImplementationAuthority:
	match visibility:
		Some(accepted_visibility):
			accepted_trait_implementation_authority(
				table,
				owner_module_path,
				accepted_visibility,
				direct_module_paths,
			)
		None:
			fallback = accepted_trait_implementation_authority(
				table,
				owner_module_path,
				accepted_trait_empty_visibility(table),
				direct_module_paths,
			)
			representation = authority_rep(fallback)
			into_opaque AcceptedTraitImplementationAuthority(
				{ representation |
					preparation_errors = representation.preparation_errors.append(
						"accepted trait visibility rejected its graph definition table",
					)
				}
			)


---
Same visibility-projection fallback as
`accepted_trait_implementation_authority_from_visibility`, but for the
trait-only projection header conversion uses. Never materializes the
implementation half.
---
pure func accepted_trait_only_projection_from_visibility(
	table: AcceptedTraitImplementationTable,
	owner_module_path: String,
	visibility: Option[AcceptedTraitVisibility],
	direct_module_paths: List[String],
) -> AcceptedTraitOnlyProjection:
	match visibility:
		Some(accepted_visibility):
			fields = accepted_trait_projection_fields(
				table,
				owner_module_path,
				accepted_visibility,
				direct_module_paths,
			)
			into_opaque AcceptedTraitOnlyProjection(fields)
		None:
			fields = accepted_trait_projection_fields(
				table,
				owner_module_path,
				accepted_trait_empty_visibility(table),
				direct_module_paths,
			)
			into_opaque AcceptedTraitOnlyProjection(
				{ fields |
					preparation_errors = fields.preparation_errors.append(
						"accepted trait visibility rejected its graph definition table",
					)
				}
			)


private pure func localized_trait_method(
	module_path: String,
	method: TraitMethodSig,
) -> TraitMethodSig:
	{ method |
		params = method.params.map(func(parameter): localize_module_types(module_path, parameter)),
		return_type = localize_module_types(module_path, method.return_type)
	}


private pure func trait_for_owner(
	table: AcceptedTraitImplementationTable,
	owner_module_path: String,
	item: AcceptedTraitTableRecord,
) -> TraitDef:
	table_representation = table_rep(table)
	resolved_owner_module_path = trait_owner_module_path(
		table_representation.definition_table,
		table_representation.module_table,
		item,
	).get_or(owner_module_path)

	if resolved_owner_module_path == owner_module_path:
		{ item.definition |
			methods = item.definition.methods.map(
				func(method): localized_trait_method(resolved_owner_module_path, method),
			)
		}
	else:
		item.definition


private pure func trait_for_authority(
	authority: AcceptedTraitImplementationAuthorityRep,
	item: AcceptedTraitTableRecord,
) -> TraitDef:
	trait_for_owner(authority.table, authority.owner_module_path, item)


private pure func visible_trait_index_for_name(
	representation: AcceptedTraitImplementationAuthorityRep,
	name: String,
) -> Option[Int]:
	source_name_id ?= source_name_table_find_id(representation.source_name_table, name)
	row ?= visible_trait_for_source_name(representation.visible_traits, source_name_id)
	table_find_trait_index(table_rep(representation.table), row.trait_id)


pure func accepted_trait_find(
	authority: AcceptedTraitImplementationAuthority,
	name: String,
) -> Option[TraitDef]:
	representation = authority_rep(authority)
	index ?= visible_trait_index_for_name(representation, name)
	table_rep(representation.table).traits
		.get(index)
		.map(func(item): trait_for_authority(representation, item))


---
Trait-name resolution for header conversion, from the trait-only
projection instead of a full authority. Orphan checks during callable and
implementation header conversion need exactly this: no implementation
data exists yet at that point in module preparation.
---
pure func accepted_trait_only_projection_find(
	projection: AcceptedTraitOnlyProjection,
	name: String,
) -> Option[TraitDef]:
	fields = projection_fields(projection)
	source_name_id ?= source_name_table_find_id(fields.source_name_table, name)
	row ?= visible_trait_for_source_name(fields.visible_traits, source_name_id)
	index ?= table_find_trait_index(table_rep(fields.table), row.trait_id)
	table_rep(fields.table).traits
		.get(index)
		.map(func(item): trait_for_owner(fields.table, fields.owner_module_path, item))


pure func accepted_trait_contains(
	authority: AcceptedTraitImplementationAuthority,
	name: String,
) -> Bool:
	visible_trait_index_for_name(authority_rep(authority), name).is_some()


pure func accepted_trait_allows_compiler_fallback(
	authority: AcceptedTraitImplementationAuthority,
	name: String,
) -> Bool:
	representation = authority_rep(authority)
	table = table_rep(representation.table)

	match visible_trait_index_for_name(representation, name):
		Some(index):
			table.traits
				.get(index)
				.and_then(func(item): item.compiler_builtin_id)
				.is_some()
		None:
			builtin_trait_id(name).is_some()


pure func accepted_trait_module_path(
	authority: AcceptedTraitImplementationAuthority,
	name: String,
) -> Option[String]:
	representation = authority_rep(authority)
	index ?= visible_trait_index_for_name(representation, name)
	table = table_rep(representation.table)
	item ?= table.traits.get(index)
	trait_owner_module_path(table.definition_table, table.module_table, item)


pure func accepted_trait_has_supertrait(
	authority: AcceptedTraitImplementationAuthority,
	trait_name: String,
	target_name: String,
) -> Bool:
	if trait_name == target_name:
		False
	else:
		representation = authority_rep(authority)
		table = table_rep(representation.table)

		match (
			representation.trait_indices_by_semantic_name.get(trait_name),
			representation.trait_indices_by_semantic_name.get(target_name),
		):
			(Some(trait_index), Some(target_index)):
				match table.traits.get(target_index):
					Some(target):
						table_trait_has_supertrait_seen(table, [], trait_index, target.id)
					None:
						False
			_:
				False


private record AcceptedQualifiedTraitMethodInfoRep {
	trait_id: TraitId,
	trait_name: String,
	trait_identity: BoundTraitIdentity,
	method: TraitMethodSig,
	implementation_method: ImplMethodInfo
}


opaque type AcceptedQualifiedTraitMethodInfo = AcceptedQualifiedTraitMethodInfoRep


pure func accepted_qualified_trait_method_id(info: AcceptedQualifiedTraitMethodInfo) -> TraitId:
	from_opaque AcceptedQualifiedTraitMethodInfo(info).trait_id


pure func accepted_qualified_trait_method_declaring_trait_name(
	info: AcceptedQualifiedTraitMethodInfo,
) -> String:
	from_opaque AcceptedQualifiedTraitMethodInfo(info).trait_name


pure func accepted_qualified_trait_method_identity(
	info: AcceptedQualifiedTraitMethodInfo,
) -> BoundTraitIdentity:
	from_opaque AcceptedQualifiedTraitMethodInfo(info).trait_identity


pure func accepted_qualified_trait_method_signature(
	info: AcceptedQualifiedTraitMethodInfo,
) -> TraitMethodSig:
	from_opaque AcceptedQualifiedTraitMethodInfo(info).method


pure func accepted_qualified_trait_implementation_method(
	info: AcceptedQualifiedTraitMethodInfo,
) -> ImplMethodInfo:
	from_opaque AcceptedQualifiedTraitMethodInfo(info).implementation_method


private pure func bound_trait_identity_from_id(
	definition_table: DefinitionTable,
	id: TraitId,
) -> BoundTraitIdentity:
	owner = match trait_id_module_id(definition_table, id):
		Some(module_id):
			GraphBoundTraitOwner(module_id)
		None:
			CompilerBuiltinBoundTraitOwner

	{
		owner = owner,
		definition_id = trait_id_definition_id(id),
		name = trait_id_name(definition_table, id),
		span = trait_id_source_span(definition_table, id)
	}


private record AcceptedTraitMethodMatch {
	id: TraitMethodId,
	signature: TraitMethodSig,
	declaring_trait_name: String
}


opaque type AcceptedTraitMethodBinding = AcceptedTraitMethodMatch


union AcceptedTraitUfcsMethodLookup:
	AcceptedTraitUfcsMethodFound(AcceptedTraitMethodBinding)
	AcceptedTraitUfcsMethodNotFound
	AcceptedTraitUfcsMethodAmbiguous


pure func accepted_trait_method_binding_id(binding: AcceptedTraitMethodBinding) -> TraitMethodId:
	from_opaque AcceptedTraitMethodBinding(binding).id


pure func accepted_trait_method_binding_signature(
	binding: AcceptedTraitMethodBinding,
) -> TraitMethodSig:
	from_opaque AcceptedTraitMethodBinding(binding).signature


pure func accepted_trait_method_binding_declaring_trait_name(
	binding: AcceptedTraitMethodBinding,
) -> String:
	from_opaque AcceptedTraitMethodBinding(binding).declaring_trait_name


private pure func table_find_trait_method_seen(
	authority: AcceptedTraitImplementationAuthorityRep,
	seen: List[Int],
	trait_index: Int,
	method_name: String,
) -> Option[AcceptedTraitMethodMatch]:
	if seen.contains(trait_index):
		None
	else:
		table = table_rep(authority.table)
		item ?= table.traits.get(trait_index)
		var result: Option[AcceptedTraitMethodMatch] = None
		var method_index: Int = 0

		for method in item.definition.methods:
			match item.method_ids.get(method_index):
				Some(method_id):
					if method.name == method_name:
						owner_module_path = trait_owner_module_path(
							table.definition_table,
							table.module_table,
							item,
						).get_or(authority.owner_module_path)

						signature = if owner_module_path == authority.owner_module_path:
							localized_trait_method(owner_module_path, method)
						else:
							method

						result = Some({
							id = method_id,
							signature = signature,
							declaring_trait_name = item.definition.name,
						})
						break
				None:
					void

			method_index += 1

		if result.is_none():
			for supertrait in item.supertraits:
				match table_find_trait_index(table, supertrait):
					Some(supertrait_index):
						match table_find_trait_method_seen(
							authority,
							seen.append(trait_index),
							supertrait_index,
							method_name,
						):
							Some(found):
								result = Some(found)
							None:
								void
					None:
						void

				if result.is_some():
					break

		result


pure func accepted_trait_find_method(
	authority: AcceptedTraitImplementationAuthority,
	trait_name: String,
	method_name: String,
) -> Option[(TraitMethodSig, String)]:
	representation = authority_rep(authority)
	trait_index ?= representation.trait_indices_by_semantic_name.get(trait_name)
	table_find_trait_method_seen(
		representation,
		[],
		trait_index,
		method_name,
	).map(
		func(found): (found.signature, found.declaring_trait_name),
	)


private pure func append_unique_method_pair(
	values: List[(String, TraitMethodId)],
	value: (String, TraitMethodId),
) -> List[(String, TraitMethodId)]:
	var present = False

	for existing in values:
		if existing[0] == value[0] and trait_method_ids_equal(existing[1], value[1]):
			present = True
			break

	if present:
		values
	else:
		values.append(value)


private pure func table_trait_methods_seen(
	table: AcceptedTraitImplementationTableRep,
	seen: List[Int],
	trait_index: Int,
) -> List[(String, TraitMethodId)]:
	if seen.contains(trait_index):
		[]
	else:
		match table.traits.get(trait_index):
			None:
				[]
			Some(item):
				var methods: List[(String, TraitMethodId)] = []

				for indexed in item.definition.methods.enumerate():
					match item.method_ids.get(indexed[0]):
						Some(method_id):
							methods = append_unique_method_pair(
								methods,
								(indexed[1].name, method_id),
							)
						None:
							void

				for supertrait in item.supertraits:
					match table_find_trait_index(table, supertrait):
						Some(supertrait_index):
							for pair in table_trait_methods_seen(
								table,
								seen.append(trait_index),
								supertrait_index,
							):
								methods = append_unique_method_pair(methods, pair)
						None:
							void

				methods


pure func accepted_trait_methods_with_declaring_trait(
	authority: AcceptedTraitImplementationAuthority,
	trait_name: String,
) -> List[(String, String)]:
	representation = authority_rep(authority)

	match visible_trait_index_for_name(representation, trait_name):
		Some(index):
			table = table_rep(representation.table)
			table_trait_methods_seen(table, [], index).map(func(pair):
				(pair[0], trait_id_name(table.definition_table, trait_method_id_owner(pair[1])))
			)
		None:
			[]


private pure func table_find_trait_method_by_id(
	authority: AcceptedTraitImplementationAuthorityRep,
	id: TraitMethodId,
) -> Option[AcceptedTraitMethodMatch]:
	table = table_rep(authority.table)
	trait_index ?= table_find_trait_index(table, trait_method_id_owner(id))
	item ?= table.traits.get(trait_index)
	method_index = trait_method_id_index(id)
	method_id ?= item.method_ids.get(method_index)
	method ?= item.definition.methods.get(method_index)

	if not trait_method_ids_equal(method_id, id):
		None
	else:
		owner_module_path = trait_owner_module_path(
			table.definition_table,
			table.module_table,
			item,
		).get_or(authority.owner_module_path)

		signature = if owner_module_path == authority.owner_module_path:
			localized_trait_method(owner_module_path, method)
		else:
			method

		Some({
			id = id,
			signature = signature,
			declaring_trait_name = item.definition.name,
		})


pure func accepted_trait_find_function_method(
	authority: AcceptedTraitImplementationAuthority,
	method_name: String,
) -> Option[AcceptedTraitMethodBinding]:
	representation = authority_rep(authority)
	source_name_id ?= source_name_table_find_id(representation.source_name_table, method_name)
	row ?= visible_trait_method_for_source_name(
		representation.visible_trait_methods,
		source_name_id,
	)
	found ?= table_find_trait_method_by_id(representation, row.method_id)
	Some(into_opaque AcceptedTraitMethodBinding(found))


private pure func localized_implementation_method(
	module_path: String,
	method: ImplMethodInfo,
) -> ImplMethodInfo:
	{ method |
		func_type = localize_module_types(module_path, method.func_type),
		dim_constraints = method.dim_constraints.map(
			func(
				constraint,
			): (
				localize_module_types(module_path, constraint[0]),
				localize_module_types(module_path, constraint[1]),
			),
		)
	}


private pure func implementation_for_authority(
	authority: AcceptedTraitImplementationAuthorityRep,
	item: AcceptedImplementationTableRecord,
) -> ImplInstance:
	table = table_rep(authority.table)
	owner_module_path = implementation_owner_module_path(
		table.definition_table,
		table.module_table,
		item,
	).get_or(authority.owner_module_path)

	if owner_module_path == authority.owner_module_path:
		{ item.instance |
			for_type = localize_module_types(owner_module_path, item.instance.for_type),
			methods = item.instance.methods.map(
				func(method): localized_implementation_method(owner_module_path, method),
			)
		}
	else:
		item.instance


private pure func implementation_candidate_indices_for_trait(
	authority: AcceptedTraitImplementationAuthorityRep,
	trait_name: String,
) -> List[Int]:
	match authority.trait_indices_by_semantic_name.get(trait_name):
		Some(trait_index):
			authority.implementation_indices_by_satisfied_trait_index.get_or(trait_index, [])
		None:
			match builtin_trait_id(trait_name):
				Some(id):
					match authority.compiler_implementations_by_trait_identity.get(
						trait_id_storage_key(id),
					):
						Some(bucket):
							if trait_ids_equal(bucket.trait_id, id):
								bucket.implementation_indices
							else:
								[]
						None:
							[]
				None:
					authority.implementation_indices_by_trait_name.get_or(trait_name, [])


private pure func table_trait_represents_compiler_trait(
	table: AcceptedTraitImplementationTableRep,
	trait_id: TraitId,
	compiler_trait_id: TraitId,
) -> Bool:
	if trait_ids_equal(trait_id, compiler_trait_id):
		True
	else:
		match table_find_trait_index(table, trait_id):
			Some(index):
				match (
					table.traits
						.get(index)
						.and_then(func(item): item.compiler_builtin_id)
				):
					Some(linked):
						trait_ids_equal(linked, compiler_trait_id)
					None:
						False
			None:
				False


pure func accepted_implementation_candidate_count(
	authority: AcceptedTraitImplementationAuthority,
	trait_name: String,
) -> Int:
	representation = authority_rep(authority)
	implementation_candidate_indices_for_trait(representation, trait_name).length()


private pure func accepted_type_param_has_trait_bound(
	authority: AcceptedTraitImplementationAuthority,
	env: Env,
	param_name: String,
	trait_name: String,
) -> Bool:
	var found: Bool = False

	for bound in env_get_type_param_bounds(env, param_name):
		if bound == trait_name or accepted_trait_has_supertrait(authority, bound, trait_name):
			found = True
			break

	found


private pure func accepted_type_param_has_exact_trait_bound(
	authority: AcceptedTraitImplementationAuthority,
	env: Env,
	param_name: String,
	requested: BoundTraitIdentity,
) -> Bool:
	representation = authority_rep(authority)
	table = table_rep(representation.table)
	requested_index = table_find_bound_trait_index(table, requested)
	var found: Bool = False

	for bound in env_get_type_param_bound_identities(env, param_name):
		if bound_trait_identities_equal(bound, requested):
			found = True
		else:
			match (table_find_bound_trait_index(table, bound), requested_index):
				(Some(bound_index), Some(target_index)):
					match table.traits.get(target_index):
						Some(target):
							if table_trait_has_supertrait_seen(table, [], bound_index, target.id):
								found = True
						None:
							void
				_:
					void

		if found:
			break

	found


private pure func accepted_type_param_has_trait_id_bound(
	authority: AcceptedTraitImplementationAuthority,
	env: Env,
	param_name: String,
	trait_id: TraitId,
	target_index: Int,
) -> Bool:
	representation = authority_rep(authority)
	table = table_rep(representation.table)
	var found: Bool = False

	for bound in env_get_type_param_bound_identities(env, param_name):
		if bound_trait_identity_matches_id(table.definition_table, bound, trait_id):
			found = True
		else:
			match table_find_bound_trait_index(table, bound):
				Some(bound_index):
					match table.traits.get(target_index):
						Some(target):
							if table_trait_has_supertrait_seen(table, [], bound_index, target.id):
								found = True
						None:
							void
				None:
					void

		if found:
			break

	found


private pure func accepted_bound_obligation_is_satisfied(
	authority: AcceptedTraitImplementationAuthority,
	env: Env,
	obligation: TraitObligation,
	bound_identity: Option[BoundTraitIdentity],
) -> Bool:
	match bound_identity:
		Some(identity):
			accepted_resolve_exact_trait_obligation(
				authority,
				env,
				obligation.obligation_type,
				identity,
			) == TraitObligationSatisfied
		None:
			accepted_resolve_trait_obligation(
				authority,
				env,
				obligation,
			) == TraitObligationSatisfied


private pure func accepted_implementation_matches_type(
	authority: AcceptedTraitImplementationAuthority,
	env: Env,
	item: AcceptedImplementationTableRecord,
	typ: SemanticType,
) -> Bool:
	representation = authority_rep(authority)
	table = table_rep(representation.table)
	owner_module_path = implementation_owner_module_path(
		table.definition_table,
		table.module_table,
		item,
	).get_or(representation.owner_module_path)

	for_type = if owner_module_path == representation.owner_module_path:
		localize_module_types(owner_module_path, item.instance.for_type)
	else:
		item.instance.for_type

	implementation_pattern_matches_with(
		for_type,
		item.instance.bounds,
		typ,
		pure func(
			obligation,
			bound_identity,
		): accepted_bound_obligation_is_satisfied(authority, env, obligation, bound_identity),
	)


private pure func accepted_has_matching_implementation(
	authority: AcceptedTraitImplementationAuthority,
	env: Env,
	trait_name: String,
	typ: SemanticType,
) -> Bool:
	representation = authority_rep(authority)
	table = table_rep(representation.table)
	var found: Bool = False

	for index in implementation_candidate_indices_for_trait(representation, trait_name):
		match table.implementations.get(index):
			Some(item):
				if accepted_implementation_matches_type(authority, env, item, typ):
					found = True
			None:
				void

		if found:
			break

	found


private pure func implementation_candidate_indices_for_trait_index(
	authority: AcceptedTraitImplementationAuthorityRep,
	trait_index: Int,
) -> List[Int]:
	table = table_rep(authority.table)

	match (
		table.traits
			.get(trait_index)
			.and_then(func(item): item.compiler_builtin_id)
	):
		Some(compiler_id):
			match authority.compiler_implementations_by_trait_identity.get(
				trait_id_storage_key(compiler_id),
			):
				Some(bucket):
					if trait_ids_equal(compiler_id, bucket.trait_id):
						bucket.implementation_indices
					else:
						[]
				None:
					[]
		None:
			authority.implementation_indices_by_satisfied_trait_index.get_or(trait_index, [])


private pure func accepted_has_matching_exact_implementation(
	authority: AcceptedTraitImplementationAuthority,
	env: Env,
	trait_index: Int,
	typ: SemanticType,
) -> Bool:
	representation = authority_rep(authority)
	table = table_rep(representation.table)
	var found: Bool = False

	for index in implementation_candidate_indices_for_trait_index(representation, trait_index):
		match table.implementations.get(index):
			Some(item):
				if accepted_implementation_matches_type(authority, env, item, typ):
					found = True
			None:
				void

		if found:
			break

	found


pure func accepted_resolve_exact_trait_obligation(
	authority: AcceptedTraitImplementationAuthority,
	env: Env,
	typ: SemanticType,
	identity: BoundTraitIdentity,
) -> TraitObligationResolution:
	representation = authority_rep(authority)
	table = table_rep(representation.table)

	match table_find_bound_trait_index(table, identity):
		Some(trait_index):
			match typ:
				SemanticMetaType(_, _):
					TraitObligationDeferred
				SemanticTypeVar(name):
					if accepted_type_param_has_exact_trait_bound(authority, env, name, identity):
						TraitObligationSatisfied
					else:
						match (
							table.traits
								.get(trait_index)
								.and_then(func(item): item.compiler_builtin_id)
						):
							Some(_):
								env_resolve_trait_obligation(
									env,
									trait_obligation(typ, identity.name),
								)
							None:
								TraitObligationUnsatisfied
				_:
					if accepted_has_matching_exact_implementation(authority, env, trait_index, typ):
						TraitObligationSatisfied
					else:
						match (
							table.traits
								.get(trait_index)
								.and_then(func(item): item.compiler_builtin_id)
						):
							Some(_):
								env_resolve_trait_obligation(
									env,
									trait_obligation(typ, identity.name),
								)
							None:
								TraitObligationUnsatisfied
		None:
			if identity.owner == CompilerBuiltinBoundTraitOwner:
				env_resolve_trait_obligation(
					env,
					trait_obligation(typ, identity.name),
				)
			else:
				TraitObligationUnsatisfied


private pure func accepted_or_compiler_trait_id_obligation_resolution(
	authority: AcceptedTraitImplementationAuthority,
	env: Env,
	typ: SemanticType,
	trait_index: Int,
) -> TraitObligationResolution:
	representation = authority_rep(authority)
	table = table_rep(representation.table)

	match (
		table.traits
			.get(trait_index)
			.and_then(func(item): item.compiler_builtin_id)
	):
		Some(compiler_id):
			env_resolve_trait_obligation(
				env,
				trait_obligation(
					typ,
					trait_id_name(table.definition_table, compiler_id),
				),
			)
		None:
			TraitObligationUnsatisfied


---
Resolve an accepted call's exact trait without reconstructing a semantic
lookup key from its source spelling. A name is projected only when an
explicitly linked compiler trait must use the graphless Env compatibility
fallback.
---
pure func accepted_resolve_trait_id_obligation(
	authority: AcceptedTraitImplementationAuthority,
	issuing_table: DefinitionTable,
	env: Env,
	typ: SemanticType,
	trait_id: TraitId,
) -> TraitObligationResolution:
	representation = authority_rep(authority)
	table = table_rep(representation.table)

	match table_find_trait_identity_index(table, issuing_table, trait_id):
		Some(trait_index):
			match typ:
				SemanticMetaType(_, _):
					TraitObligationDeferred
				SemanticTypeVar(name):
					if accepted_type_param_has_trait_id_bound(
						authority,
						env,
						name,
						trait_id,
						trait_index,
					):
						TraitObligationSatisfied
					else:
						accepted_or_compiler_trait_id_obligation_resolution(
							authority,
							env,
							typ,
							trait_index,
						)
				_:
					if accepted_has_matching_exact_implementation(authority, env, trait_index, typ):
						TraitObligationSatisfied
					else:
						accepted_or_compiler_trait_id_obligation_resolution(
							authority,
							env,
							typ,
							trait_index,
						)
		None:
			TraitObligationUnsatisfied


pure func accepted_find_unsatisfied_bound_type_param(
	authority: AcceptedTraitImplementationAuthority,
	env: Env,
	param: BoundTypeParam,
	concrete_type: SemanticType,
) -> Option[TraitObligation]:
	var unsatisfied: Option[TraitObligation] = None

	for indexed_name in param.bounds.enumerate():
		name = indexed_name[1]

		resolution = match param.bound_identities.get(indexed_name[0]):
			Some(identity):
				accepted_resolve_exact_trait_obligation(authority, env, concrete_type, identity)
			None:
				accepted_resolve_trait_obligation(
					authority,
					env,
					trait_obligation(concrete_type, name),
				)

		if resolution == TraitObligationUnsatisfied:
			unsatisfied = Some(trait_obligation(concrete_type, name))
			break

	unsatisfied


private pure func accepted_or_compiler_trait_obligation_resolution(
	authority: AcceptedTraitImplementationAuthority,
	env: Env,
	obligation: TraitObligation,
) -> TraitObligationResolution:
	if accepted_trait_allows_compiler_fallback(authority, obligation.trait_name):
		env_resolve_trait_obligation(env, obligation)
	else:
		TraitObligationUnsatisfied


pure func accepted_resolve_trait_obligation(
	authority: AcceptedTraitImplementationAuthority,
	env: Env,
	obligation: TraitObligation,
) -> TraitObligationResolution:
	match obligation.obligation_type:
		SemanticMetaType(_, _):
			TraitObligationDeferred
		SemanticTypeVar(name):
			if accepted_type_param_has_trait_bound(authority, env, name, obligation.trait_name):
				TraitObligationSatisfied
			else:
				accepted_or_compiler_trait_obligation_resolution(authority, env, obligation)
		SemanticNamedType(name, args):
			if (
				args.length() == 0
				and accepted_type_param_has_trait_bound(authority, env, name, obligation.trait_name)
			):
				TraitObligationSatisfied
			else if accepted_has_matching_implementation(
				authority,
				env,
				obligation.trait_name,
				obligation.obligation_type,
			):
				TraitObligationSatisfied
			else:
				accepted_or_compiler_trait_obligation_resolution(authority, env, obligation)
		SemanticArrayType(_, _):
			if (
				obligation.trait_name == "HasLength"
				or obligation.trait_name == "Stringable"
				or accepted_has_matching_implementation(
					authority,
					env,
					obligation.trait_name,
					obligation.obligation_type,
				)
			):
				TraitObligationSatisfied
			else:
				accepted_or_compiler_trait_obligation_resolution(authority, env, obligation)
		_:
			if accepted_has_matching_implementation(
				authority,
				env,
				obligation.trait_name,
				obligation.obligation_type,
			):
				TraitObligationSatisfied
			else:
				accepted_or_compiler_trait_obligation_resolution(authority, env, obligation)


pure func accepted_find_unsatisfied_trait_obligation(
	authority: AcceptedTraitImplementationAuthority,
	env: Env,
	obligations: List[TraitObligation],
) -> Option[TraitObligation]:
	var result: Option[TraitObligation] = None

	for obligation in obligations:
		if accepted_resolve_trait_obligation(
			authority,
			env,
			obligation,
		) == TraitObligationUnsatisfied:
			result = Some(obligation)
			break

	result


private pure func accepted_find_impl_method_info_from_candidates(
	authority: AcceptedTraitImplementationAuthority,
	env: Env,
	trait_method: Option[AcceptedTraitMethodMatch],
	compiler_trait_id: Option[TraitId],
	implementation_indices: List[Int],
	method_name: String,
	receiver_type: SemanticType,
) -> Option[ImplMethodInfo]:
	representation = authority_rep(authority)
	table = table_rep(representation.table)
	var result: Option[ImplMethodInfo] = None

	for implementation_index in implementation_indices:
		match table.implementations.get(implementation_index):
			Some(item):
				if accepted_implementation_matches_type(authority, env, item, receiver_type):
					owner_module_path = implementation_owner_module_path(
						table.definition_table,
						table.module_table,
						item,
					).get_or(representation.owner_module_path)
					method_trait_ids = table.implementation_trait_method_ids.get_or(
						implementation_index,
						[],
					)

					for indexed in item.instance.methods.enumerate():
						implements_requested_slot = match trait_method:
							Some(requested):
								match method_trait_ids.get(indexed[0]):
									Some(Some(id)):
										trait_method_ids_equal(id, requested.id)
									_:
										False
							None:
								match compiler_trait_id:
									Some(id):
										(
											table_trait_represents_compiler_trait(
												table,
												item.trait_id,
												id,
											)
											and item.method_ids
												.get(indexed[0])
												.map(
													func(
														method_id,
													): callable_id_name(
														table.definition_table,
														method_id,
													) == Some(method_name),
												)
												.get_or(False)
										)
									None:
										False

						if implements_requested_slot:
							method = if owner_module_path == representation.owner_module_path:
								localized_implementation_method(owner_module_path, indexed[1])
							else:
								indexed[1]

							result = Some(method)
							break
			None:
				void

		if result.is_some():
			break

	result


pure func accepted_find_impl_method_info(
	authority: AcceptedTraitImplementationAuthority,
	env: Env,
	trait_name: String,
	method_name: String,
	receiver_type: SemanticType,
) -> Option[ImplMethodInfo]:
	representation = authority_rep(authority)
	trait_method = representation.trait_indices_by_semantic_name
		.get(trait_name)
		.and_then(
			func(
				trait_index,
			): table_find_trait_method_seen(representation, [], trait_index, method_name),
		)

	accepted_find_impl_method_info_from_candidates(
		authority,
		env,
		trait_method,
		builtin_trait_id(trait_name),
		implementation_candidate_indices_for_trait(representation, trait_name),
		method_name,
		receiver_type,
	)


---
Accepted calls already carry the declaring trait identity. Follow that ID
through the topology and implementation-slot relations instead of
projecting a name and entering the compatibility lookup.
---
pure func accepted_find_impl_method_info_by_trait_id(
	authority: AcceptedTraitImplementationAuthority,
	issuing_table: DefinitionTable,
	env: Env,
	trait_id: TraitId,
	method_name: String,
	receiver_type: SemanticType,
) -> Option[ImplMethodInfo]:
	representation = authority_rep(authority)
	table = table_rep(representation.table)
	trait_index ?= table_find_trait_identity_index(table, issuing_table, trait_id)
	trait_method ?= table_find_trait_method_seen(representation, [], trait_index, method_name)

	accepted_find_impl_method_info_from_candidates(
		authority,
		env,
		Some(trait_method),
		None,
		implementation_candidate_indices_for_trait_index(representation, trait_index),
		method_name,
		receiver_type,
	)


---
UFCS may use a public implementation from a directly imported module
without importing the trait or method into the bare namespace. Select from
the exact visible trait rows and require one applicable method identity;
same-spelled qualified-only traits remain ambiguous rather than acquiring
arbitrary bare-name precedence.
---
pure func accepted_trait_find_ufcs_method(
	authority: AcceptedTraitImplementationAuthority,
	env: Env,
	method_name: String,
	receiver_type: SemanticType,
) -> AcceptedTraitUfcsMethodLookup:
	representation = authority_rep(authority)
	table = table_rep(representation.table)
	var selected: Option[AcceptedTraitMethodMatch] = None
	var ambiguous: Bool = False

	for trait_index in representation.visible_trait_indices:
		match table_find_trait_method_seen(representation, [], trait_index, method_name):
			Some(method):
				method_owner_index = table_find_trait_index(table, trait_method_id_owner(method.id))
				implementation = method_owner_index.and_then(func(owner_index):
					accepted_find_impl_method_info_from_candidates(
						authority,
						env,
						Some(method),
						None,
						implementation_candidate_indices_for_trait_index(
							representation,
							owner_index,
						),
						method_name,
						receiver_type,
					)
				)

				if implementation.is_some():
					match selected:
						Some(existing):
							if not trait_method_ids_equal(existing.id, method.id):
								ambiguous = True
						None:
							selected = Some(method)
			None:
				void

		if ambiguous:
			break

	if ambiguous:
		AcceptedTraitUfcsMethodAmbiguous
	else:
		match selected:
			Some(method):
				AcceptedTraitUfcsMethodFound(into_opaque AcceptedTraitMethodBinding(method))
			None:
				AcceptedTraitUfcsMethodNotFound


private pure func accepted_qualified_trait_method_info_for_implementation(
	authority: AcceptedTraitImplementationAuthority,
	env: Env,
	module_path: String,
	method_name: String,
	receiver_type: SemanticType,
	implementation_index: Int,
) -> Option[AcceptedQualifiedTraitMethodInfo]:
	representation = authority_rep(authority)
	table = table_rep(representation.table)
	var result: Option[AcceptedQualifiedTraitMethodInfo] = None

	match table.implementations.get(implementation_index):
		Some(item):
			owner_module_path = implementation_owner_module_path(
				table.definition_table,
				table.module_table,
				item,
			).get_or(representation.owner_module_path)

			match table_find_trait_index(table, item.trait_id):
				Some(trait_index):
					match table_find_trait_method_seen(
						representation,
						[],
						trait_index,
						method_name,
					):
						Some(requested):
							requested_owner_path = trait_id_module_id(
								table.definition_table,
								trait_method_id_owner(requested.id),
							).and_then(func(module_id):
								module_table_canonical_path(table.module_table, module_id)
							)
							qualified_owner = (
								impl_id_module_id(
									table.definition_table,
									item.id,
								).and_then(
									func(
										module_id,
									): module_table_canonical_path(
										table.module_table,
										module_id,
									),
								) == Some(module_path)
								or requested_owner_path == Some(module_path)
							)

							if (
								qualified_owner
								and accepted_implementation_matches_type(
									authority,
									env,
									item,
									receiver_type,
								)
							):
								method_trait_ids = table.implementation_trait_method_ids.get_or(
									implementation_index,
									[],
								)

								for indexed in item.instance.methods.enumerate():
									implements_requested_slot = match method_trait_ids.get(
										indexed[0],
									):
										Some(Some(id)):
											trait_method_ids_equal(id, requested.id)
										_:
											False

									if implements_requested_slot:
										implementation_method = if owner_module_path == representation.owner_module_path:
											localized_implementation_method(
												owner_module_path,
												indexed[1],
											)
										else:
											indexed[1]

										result = Some(into_opaque AcceptedQualifiedTraitMethodInfo({
													trait_id = trait_method_id_owner(requested.id),
													trait_name = requested.declaring_trait_name,
													trait_identity = bound_trait_identity_from_id(
														table.definition_table,
														trait_method_id_owner(requested.id),
													),
													method = requested.signature,
													implementation_method = implementation_method
												}))
										break
						None:
							void
				None:
					void
		None:
			void

	result


pure func accepted_find_qualified_trait_method_info(
	authority: AcceptedTraitImplementationAuthority,
	env: Env,
	module_path: String,
	method_name: String,
	receiver_type: SemanticType,
) -> Option[AcceptedQualifiedTraitMethodInfo]:
	representation = authority_rep(authority)
	table = table_rep(representation.table)
	implementation_indices = table.qualified_implementation_indices_by_module_and_method
		.get_or(module_path, {})
		.get_or(method_name, [])
	var best_visible_rank = representation.visible_implementation_indices.length() + 1
	var result: Option[AcceptedQualifiedTraitMethodInfo] = None

	for implementation_index in implementation_indices:
		visible_rank = representation.visible_implementation_rank_by_index.get_or(
			implementation_index,
			0,
		)

		if visible_rank > 0 and visible_rank < best_visible_rank:
			match accepted_qualified_trait_method_info_for_implementation(
				authority,
				env,
				module_path,
				method_name,
				receiver_type,
				implementation_index,
			):
				Some(info):
					best_visible_rank = visible_rank
					result = Some(info)
				None:
					void

	result


pure func accepted_has_direct_trait_evidence(
	authority: AcceptedTraitImplementationAuthority,
	env: Env,
	obligation: TraitObligation,
) -> Bool:
	-- Direct evidence deliberately excludes implementations of subtraits. The
	-- canonical source-prelude declaration and its compiler builtin are the only
	-- distinct IDs that can represent the same trait.
	representation = authority_rep(authority)
	table = table_rep(representation.table)

	requested_trait_id = match representation.trait_indices_by_semantic_name.get(
		obligation.trait_name,
	):
		Some(index):
			table.traits
				.get(index)
				.map(func(item): item.id)
		None:
			builtin_trait_id(obligation.trait_name)

	var found: Bool = False

	match requested_trait_id:
		Some(requested):
			for index in implementation_candidate_indices_for_trait(
				representation,
				obligation.trait_name,
			):
				match table.implementations.get(index):
					Some(item):
						if (
							table_trait_ids_semantically_equivalent(table, item.trait_id, requested)
							and accepted_implementation_matches_type(
								authority,
								env,
								item,
								obligation.obligation_type,
							)
						):
							found = True
					None:
						void

				if found:
					break
		None:
			void

	if found:
		True
	else:
		match obligation.obligation_type:
			SemanticTypeVar(name):
				accepted_type_param_has_trait_bound(authority, env, name, obligation.trait_name)
			_:
				(
					accepted_trait_allows_compiler_fallback(authority, obligation.trait_name)
					and env_resolve_trait_obligation(env, obligation) == TraitObligationSatisfied
				)


pure func accepted_trait_implementation_authority_metrics(
	table: AcceptedTraitImplementationTable,
	authorities: List[AcceptedTraitImplementationAuthority],
) -> AcceptedTraitImplementationAuthorityMetrics:
	representation = table_rep(table)
	var trait_indices: Int = 0
	var implementation_indices: Int = 0
	var compiler_implementation_links: Int = 0

	for compiler_trait_id in representation.compiler_trait_id_by_implementation:
		if compiler_trait_id.is_some():
			compiler_implementation_links += 1

	for authority in authorities:
		view = authority_rep(authority)
		trait_indices += view.visible_traits.length()
		implementation_indices += view.visible_implementation_indices.length()

	{
		accepted_trait_table_entries = representation.traits.length(),
		accepted_implementation_table_entries = representation.implementations.length(),
		accepted_trait_semantic_conversions = representation.traits.length(),
		accepted_implementation_semantic_conversions = representation.implementations.length(),
		accepted_qualified_implementation_method_rows = representation.qualified_implementation_method_row_count,
		accepted_compiler_implementation_links = compiler_implementation_links,
		module_view_trait_indices = trait_indices,
		module_view_implementation_indices = implementation_indices
	}
