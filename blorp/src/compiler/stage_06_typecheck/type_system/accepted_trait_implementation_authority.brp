		builtin_trait_id,
		callable_id_definition_id,
		callable_id_module_id,
		callable_id_name,
		impl_id_definition_id,
		impl_id_module_id,
		impl_id_name,
		impl_ids_equal,
		trait_id_definition_id,
		trait_id_is_compiler_builtin,
		trait_id_module_id,
		trait_id_name,
		trait_id_source_span,
		trait_ids_equal,
		trait_method_id_index,
		trait_method_id_name,
		trait_method_id_owner,
		trait_method_ids_equal,
	env:
		Env,
		ImplInstance,
