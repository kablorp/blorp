-- Graph-owned global declarations and compact per-module visibility.
--
-- Annotated declarations carry an initializer-visible type from header
-- resolution. Inferred declarations become initializer-visible only when the
-- completion plan supplies their exact accepted identity. Ordinary body
-- queries expose only successfully completed entries.
import:
	../../stage_04_modules/module_table:
		ModuleId,
		ModuleTable,
		module_id_table_index,
		module_ids_equal,
		module_table_canonical_path,
		module_table_count,
		module_table_find_id_by_canonical_path,
	../graph/definition_index:
		DefinitionTable,
		definition_id_runtime_value,
		definition_index_definition_table,
		definition_table_global_row,
		definition_table_module_table,
		definition_tables_share_provenance,
	../graph/indexed_graph:
		PreparedModuleScope,
		prepared_module_scope_canonical_path,
		prepared_module_scope_definition_index,
		prepared_module_scope_id,
	../graph/source_name_table:
		SourceNameId,
		SourceNameTable,
		source_name_id_table_index,
		source_name_table_find_id,
		source_name_table_id_at,
		source_name_tables_are_compatible,
	../headers/declaration_skeleton:
		DeclarationId(GlobalDeclarationId),
		DeclarationVisibility(PublicDeclaration),
		GlobalId,
		global_id_definition_id,
		global_id_from_definition_table,
		global_id_module_id,
		global_ids_equal,
	../modules/import_binding:
		ImportBinding(
			GraphQualifiedModuleBinding,
			GraphSelectiveDefinitionBinding,
			GraphSelectiveTraitMethodBinding,
			StandaloneQualifiedModuleBinding,
			StandaloneSelectiveDefinitionBinding,
		),
	list: repeat
	semantic_type: SemanticType, localize_module_types


record AcceptedGlobalBinding {
	id: GlobalId,
	binding_type: SemanticType,
	source_type: Option[SemanticType],
	is_mutable: Bool
}


record AcceptedGlobalTableRecord {
	id: GlobalId,
	visibility: DeclarationVisibility,
	declared_binding: Option[AcceptedGlobalBinding]
}


record AcceptedGlobalTableInput {
	definition_table: DefinitionTable,
	source_name_table: SourceNameTable,
	globals: List[AcceptedGlobalTableRecord]
}


private record AcceptedGlobalSlot {
	id: GlobalId,
	visibility: DeclarationVisibility,
	declared_binding: Option[AcceptedGlobalBinding],
	owner_declared_binding: Option[AcceptedGlobalBinding],
	completed_binding: Option[AcceptedGlobalBinding],
	owner_completed_binding: Option[AcceptedGlobalBinding]
}


private record AcceptedGlobalTableRep {
	definition_table: DefinitionTable,
	source_name_table: SourceNameTable,
	slots: List[AcceptedGlobalSlot],
	completed_count: Int,
	index_by_global_definition_id: Dict[Int, Int],
	slot_indices_by_module_and_source_name_id: List[Dict[Int, Int]]
}


opaque type AcceptedGlobalTable = AcceptedGlobalTableRep


private record AcceptedVisibleGlobalBindingRep {
	source_name_id: SourceNameId,
	target: GlobalId
}


opaque type AcceptedVisibleGlobalBinding = AcceptedVisibleGlobalBindingRep


private record AcceptedGlobalVisibilityRep {
	table: AcceptedGlobalTable,
	owner_module_path: String,
	owner_module_id: ModuleId,
	bindings: List[AcceptedVisibleGlobalBinding]
}


opaque type AcceptedGlobalVisibility = AcceptedGlobalVisibilityRep

private type alias AcceptedGlobalLocator = Int


private pure func global_locator(definition_id: Int, owner_local: Bool) -> AcceptedGlobalLocator:
	if owner_local:
		definition_id * 2 + 1
	else:
		definition_id * 2


private pure func global_locator_definition_id(locator: AcceptedGlobalLocator) -> Int:
	locator / 2


private pure func global_locator_owner_local(locator: AcceptedGlobalLocator) -> Bool:
	locator % 2 == 1


private union AcceptedGlobalAvailability:
	CompletedGlobalAvailability
	InitializerGlobalAvailability(Dict[Int, AcceptedGlobalBinding])


private record AcceptedGlobalAuthorityRep {
	table: AcceptedGlobalTable,
	owner_module_path: String,
	owner_module_id: ModuleId,
	visible_locators_by_source_name_id: Dict[Int, AcceptedGlobalLocator],
	availability: AcceptedGlobalAvailability
}


opaque type AcceptedGlobalAuthority = AcceptedGlobalAuthorityRep


union AcceptedGlobalExactLookup:
	AcceptedGlobalExactFound(AcceptedGlobalBinding)
	AcceptedGlobalExactMissing
	AcceptedGlobalExactWrongKind(DeclarationId)


record AcceptedGlobalExactProbe {
	lookup: AcceptedGlobalExactLookup,
	candidates_visited: Int
}


struct AcceptedGlobalAuthorityMetrics {
	catalog_global_entries: Int,
	canonical_module_views_built: Int
}


private pure func table_rep(table: AcceptedGlobalTable) -> AcceptedGlobalTableRep:
	from_opaque AcceptedGlobalTable(table)


private pure func table_module_table(table: AcceptedGlobalTableRep) -> ModuleTable:
	definition_table_module_table(table.definition_table)


private pure func table_owner_module_path(
	table: AcceptedGlobalTableRep,
	id: GlobalId,
) -> Option[String]:
	row ?= definition_table_global_row(table.definition_table, global_id_definition_id(id))
	module_table_canonical_path(table_module_table(table), row.module_id)


private pure func authority_rep(authority: AcceptedGlobalAuthority) -> AcceptedGlobalAuthorityRep:
	from_opaque AcceptedGlobalAuthority(authority)


private pure func localize_binding(
	owner_module_path: String,
	binding: AcceptedGlobalBinding,
) -> AcceptedGlobalBinding:
	{ binding |
		binding_type = localize_module_types(owner_module_path, binding.binding_type),
		source_type = binding.source_type.map(
			func(typ): localize_module_types(owner_module_path, typ),
		)
	}


pure func accepted_global_table(input: AcceptedGlobalTableInput) -> Option[AcceptedGlobalTable]:
	module_table = definition_table_module_table(input.definition_table)
	var slots: List[AcceptedGlobalSlot] = []
	var index_by_global_definition_id: Dict[Int, Int] = {}
	empty_module_slots: Dict[Int, Int] = {}
	var slot_indices_by_module_and_source_name_id: List[Dict[Int, Int]] = repeat(
		empty_module_slots,
		module_table_count(module_table),
	)
	var valid: Bool = True

	for entry in input.globals:
		definition_id = global_id_definition_id(entry.id)

		match definition_table_global_row(input.definition_table, definition_id):
			Some(row):
				match source_name_table_find_id(input.source_name_table, row.name):
					Some(source_name_id):
						source_name_index = source_name_id_table_index(source_name_id)
						module_index = module_id_table_index(row.module_id)
						module_slot_indices = slot_indices_by_module_and_source_name_id
							.get(module_index)
							.get_or({})

						declared_matches = match entry.declared_binding:
							Some(binding):
								global_ids_equal(binding.id, entry.id)
							None:
								True

						owner_module_path = module_table_canonical_path(module_table, row.module_id)

						if (
							index_by_global_definition_id.contains(definition_id)
							or module_slot_indices.contains(source_name_index)
							or not declared_matches
							or slot_indices_by_module_and_source_name_id
								.get(module_index)
								.is_none()
							or owner_module_path.is_none()
						):
							valid = False
						else:
							index = slots.length()

							owner_declared_binding = match owner_module_path:
								Some(path):
									entry.declared_binding.map(
										func(binding): localize_binding(path, binding),
									)
								None:
									None

							slots = slots.append({
								id = entry.id,
								visibility = entry.visibility,
								declared_binding = entry.declared_binding,
								owner_declared_binding = owner_declared_binding,
								completed_binding = None,
								owner_completed_binding = None,
							})
							index_by_global_definition_id = index_by_global_definition_id.set(
								definition_id,
								index,
							)
							slot_indices_by_module_and_source_name_id = slot_indices_by_module_and_source_name_id.set(
								module_index,
								module_slot_indices.set(source_name_index, index),
							)
					None:
						valid = False
			None:
				valid = False

	if valid:
		Some(into_opaque AcceptedGlobalTable({
					definition_table = input.definition_table,
					source_name_table = input.source_name_table,
					slots = slots,
					completed_count = 0,
					index_by_global_definition_id = index_by_global_definition_id,
					slot_indices_by_module_and_source_name_id = slot_indices_by_module_and_source_name_id
				}))
	else:
		None


private pure func table_index_for_id(table: AcceptedGlobalTableRep, id: GlobalId) -> Option[Int]:
	table.index_by_global_definition_id.get(global_id_definition_id(id))


pure func accepted_global_table_complete(
	table: AcceptedGlobalTable,
	issuing_table: DefinitionTable,
	bindings: List[AcceptedGlobalBinding],
) -> Option[AcceptedGlobalTable]:
	representation = table_rep(table)
	var slots = representation.slots
	var valid: Bool = definition_tables_share_provenance(
		representation.definition_table,
		issuing_table,
	)

	for binding in bindings:
		match table_index_for_id(representation, binding.id):
			Some(index):
				match slots.get(index):
					Some(slot):
						if (
							not global_ids_equal(slot.id, binding.id)
							or slot.completed_binding.is_some()
						):
							valid = False
						else:
							match table_owner_module_path(representation, slot.id):
								Some(owner_module_path):
									owner_binding = localize_binding(owner_module_path, binding)
									slots = slots.set(
										index,
										{ slot |
											completed_binding = Some(binding),
											owner_completed_binding = Some(owner_binding)
										},
									)
								None:
									valid = False
					None:
						valid = False
			None:
				valid = False

	if valid:
		Some(into_opaque AcceptedGlobalTable({ representation |
					slots = slots,
					completed_count = representation.completed_count + bindings.length()
				}))
	else:
		None


pure func accepted_global_table_completed_count(table: AcceptedGlobalTable) -> Int:
	table_rep(table).completed_count


pure func accepted_global_table_entry_count(table: AcceptedGlobalTable) -> Int:
	table_rep(table).slots.length()


pure func accepted_global_table_is_complete(table: AcceptedGlobalTable) -> Bool:
	representation = table_rep(table)
	representation.completed_count == representation.slots.length()


pure func accepted_global_table_definition_table(table: AcceptedGlobalTable) -> DefinitionTable:
	table_rep(table).definition_table


pure func accepted_global_table_source_name_table(table: AcceptedGlobalTable) -> SourceNameTable:
	table_rep(table).source_name_table


pure func accepted_global_authority_metrics(
	table: AcceptedGlobalTable,
	canonical_module_views_built: Int,
) -> AcceptedGlobalAuthorityMetrics:
	{
		catalog_global_entries = accepted_global_table_completed_count(table),
		canonical_module_views_built = canonical_module_views_built
	}


private pure func accepted_visible_global_binding(
	source_name_id: SourceNameId,
	target: GlobalId,
) -> AcceptedVisibleGlobalBinding:
	into_opaque AcceptedVisibleGlobalBinding({
			source_name_id = source_name_id,
			target = target
		})


private pure func accepted_visible_global_binding_rep(
	binding: AcceptedVisibleGlobalBinding,
) -> AcceptedVisibleGlobalBindingRep:
	from_opaque AcceptedVisibleGlobalBinding(binding)


private pure func accepted_global_visibility_rep(
	visibility: AcceptedGlobalVisibility,
) -> AcceptedGlobalVisibilityRep:
	from_opaque AcceptedGlobalVisibility(visibility)


-- Construct the complete exact visibility input at the graph/table boundary.
-- Local globals enter by exact table slot; selective imports enter by their
-- admitted DefinitionIds. The opaque aggregate binds those rows to their
-- table and owner provenance, so the authority cannot reinterpret raw indexes
-- under an independent compilation context.
pure func accepted_global_visibility_bindings(
	table: AcceptedGlobalTable,
	owner_scope: PreparedModuleScope,
	issuing_table: DefinitionTable,
	import_bindings: List[ImportBinding],
) -> Option[AcceptedGlobalVisibility]:
	representation = table_rep(table)
	source_name_table = representation.source_name_table
	owner_module_id = prepared_module_scope_id(owner_scope)
	var result: List[AcceptedVisibleGlobalBinding] = []
	var valid: Bool = (
		definition_tables_share_provenance(
			representation.definition_table,
			definition_index_definition_table(prepared_module_scope_definition_index(owner_scope)),
		)
		and definition_tables_share_provenance(representation.definition_table, issuing_table)
	)

	local_indices = representation.slot_indices_by_module_and_source_name_id
		.get(module_id_table_index(owner_module_id))
		.get_or({})

	for (source_name_index, index) in local_indices:
		match source_name_table_id_at(source_name_table, source_name_index):
			Some(source_name_id):
				match representation.slots.get(index):
					Some(slot):
						match definition_table_global_row(
							representation.definition_table,
							global_id_definition_id(slot.id),
						):
							Some(row):
								if module_ids_equal(row.module_id, owner_module_id):
									result = result.append(
										accepted_visible_global_binding(
											source_name_id,
											slot.id,
										),
									)
								else:
									valid = False
							None:
								valid = False
					None:
						valid = False
			None:
				valid = False

	for binding in import_bindings:
		match binding:
			GraphSelectiveDefinitionBinding(local_name, module_id, definition_ids):
				match source_name_table_find_id(source_name_table, local_name):
					Some(source_name_id):
						for definition_id in definition_ids:
							match global_id_from_definition_table(
								issuing_table,
								definition_id_runtime_value(definition_id),
							):
								Some(global_id):
									match (
										global_id_module_id(issuing_table, global_id),
										table_index_for_id(representation, global_id),
									):
										(Some(global_module_id), Some(index)):
											match representation.slots.get(index):
												Some(slot):
													if (
														module_ids_equal(
															global_module_id,
															module_id,
														)
														and global_ids_equal(slot.id, global_id)
														and slot.visibility == PublicDeclaration
													):
														result = result.append(
															accepted_visible_global_binding(
																source_name_id,
																global_id,
															),
														)
													else:
														valid = False
												None:
													valid = False
										_:
											valid = False
								None:
									void
					None:
						valid = False
			GraphQualifiedModuleBinding(_, _) | GraphSelectiveTraitMethodBinding(_, _, _):
				void
			StandaloneQualifiedModuleBinding(_, _) | StandaloneSelectiveDefinitionBinding(_, _, _):
				valid = False

	if valid:
		Some(into_opaque AcceptedGlobalVisibility({
					table = table,
					owner_module_path = prepared_module_scope_canonical_path(owner_scope),
					owner_module_id = owner_module_id,
					bindings = result
				}))
	else:
		None


pure func accepted_global_authority(
	visibility: AcceptedGlobalVisibility,
) -> Option[AcceptedGlobalAuthority]:
	visibility_representation = accepted_global_visibility_rep(visibility)
	table = visibility_representation.table
	representation = table_rep(table)
	owner_module_path = visibility_representation.owner_module_path
	owner_module_id = visibility_representation.owner_module_id
	var visible_locators_by_source_name_id: Dict[Int, AcceptedGlobalLocator] = {}
	var valid: Bool = True

	for binding in visibility_representation.bindings:
		binding_representation = accepted_visible_global_binding_rep(binding)

		match table_index_for_id(representation, binding_representation.target):
			Some(index):
				match (
					representation.slots.get(index),
					global_id_module_id(
						representation.definition_table,
						binding_representation.target,
					),
				):
					(Some(slot), Some(target_module_id)):
						source_name_index = source_name_id_table_index(
							binding_representation.source_name_id,
						)
						owner_local = module_ids_equal(owner_module_id, target_module_id)

						if (
							not global_ids_equal(slot.id, binding_representation.target)
							or slot.visibility != PublicDeclaration and not owner_local
							or visible_locators_by_source_name_id.contains(source_name_index)
						):
							valid = False
						else:
							visible_locators_by_source_name_id = visible_locators_by_source_name_id.set(
								source_name_index,
								global_locator(global_id_definition_id(slot.id), owner_local),
							)
					_:
						valid = False
			None:
				valid = False

	if valid:
		Some(into_opaque AcceptedGlobalAuthority({
					table = table,
					owner_module_path = owner_module_path,
					owner_module_id = owner_module_id,
					visible_locators_by_source_name_id = visible_locators_by_source_name_id,
					availability = CompletedGlobalAvailability
				}))
	else:
		None


pure func accepted_global_authority_without_visible_names(
	authority: AcceptedGlobalAuthority,
) -> AcceptedGlobalAuthority:
	representation = authority_rep(authority)
	into_opaque AcceptedGlobalAuthority(
		{ representation | visible_locators_by_source_name_id = {} }
	)


pure func accepted_global_authority_with_completed_table(
	authority: AcceptedGlobalAuthority,
	table: AcceptedGlobalTable,
) -> Option[AcceptedGlobalAuthority]:
	representation = authority_rep(authority)
	completed_representation = table_rep(table)

	if (
		definition_tables_share_provenance(
			table_rep(representation.table).definition_table,
			completed_representation.definition_table,
		)
		and source_name_tables_are_compatible(
			table_rep(representation.table).source_name_table,
			completed_representation.source_name_table,
		)
	):
		Some(into_opaque AcceptedGlobalAuthority({ representation |
					table = table,
					availability = CompletedGlobalAvailability
				}))
	else:
		None


pure func accepted_global_authority_for_initializer(
	authority: AcceptedGlobalAuthority,
	issuing_table: DefinitionTable,
	completed_dependencies: List[AcceptedGlobalBinding],
) -> Option[AcceptedGlobalAuthority]:
	representation = authority_rep(authority)
	table_representation = table_rep(representation.table)
	var allowed: Dict[Int, AcceptedGlobalBinding] = {}
	valid = definition_tables_share_provenance(table_representation.definition_table, issuing_table)

	if valid:
		for binding in completed_dependencies:
			definition_id = global_id_definition_id(binding.id)

			match table_index_for_id(table_representation, binding.id):
				Some(index):
					match table_representation.slots.get(index):
						Some(slot):
							if global_ids_equal(slot.id, binding.id):
								available = if authority_owns_global(representation, binding.id):
									localize_binding(representation.owner_module_path, binding)
								else:
									binding

								allowed = allowed.set(definition_id, available)
						None:
							void
				None:
					void

	if valid:
		Some(
			into_opaque AcceptedGlobalAuthority(
				{ representation | availability = InitializerGlobalAvailability(allowed) }
			),
		)
	else:
		None


private pure func authority_owns_global(
	representation: AcceptedGlobalAuthorityRep,
	id: GlobalId,
) -> Bool:
	owner_module_id = global_id_module_id(table_rep(representation.table).definition_table, id)

	owner_module_id
		.map(func(global_module_id):
			module_ids_equal(representation.owner_module_id, global_module_id)
		)
		.get_or(False)


private pure func available_binding(
	representation: AcceptedGlobalAuthorityRep,
	slot: AcceptedGlobalSlot,
	definition_id: Int,
	owner_local: Bool,
) -> Option[AcceptedGlobalBinding]:
	match representation.availability:
		CompletedGlobalAvailability:
			if owner_local:
				slot.owner_completed_binding
			else:
				slot.completed_binding
		InitializerGlobalAvailability(allowed):
			match slot.declared_binding:
				Some(_):
					if owner_local:
						slot.owner_declared_binding
					else:
						slot.declared_binding
				None:
					allowed.get(definition_id)


private pure func binding_at(
	authority: AcceptedGlobalAuthority,
	locator: AcceptedGlobalLocator,
) -> Option[AcceptedGlobalBinding]:
	representation = authority_rep(authority)
	definition_id = global_locator_definition_id(locator)
	table = table_rep(representation.table)
	index ?= table.index_by_global_definition_id.get(definition_id)
	slot ?= table.slots.get(index)
	available_binding(representation, slot, definition_id, global_locator_owner_local(locator))


pure func accepted_global_find(
	authority: AcceptedGlobalAuthority,
	name: String,
) -> Option[AcceptedGlobalBinding]:
	representation = authority_rep(authority)
	source_name_id ?= source_name_table_find_id(
		table_rep(representation.table).source_name_table,
		name,
	)
	locator ?= representation.visible_locators_by_source_name_id.get(
		source_name_id_table_index(source_name_id),
	)
	binding_at(authority, locator)


pure func accepted_global_find_qualified(
	authority: AcceptedGlobalAuthority,
	module_path: String,
	name: String,
) -> Option[AcceptedGlobalBinding]:
	representation = authority_rep(authority)
	table = table_rep(representation.table)
	module_id ?= module_table_find_id_by_canonical_path(table_module_table(table), module_path)
	source_name_id ?= source_name_table_find_id(table.source_name_table, name)
	module_slot_indices ?= table.slot_indices_by_module_and_source_name_id.get(
		module_id_table_index(module_id),
	)
	index ?= module_slot_indices.get(source_name_id_table_index(source_name_id))
	slot ?= table.slots.get(index)

	owner_local = module_ids_equal(module_id, representation.owner_module_id)

	if slot.visibility == PublicDeclaration or owner_local:
		available_binding(representation, slot, global_id_definition_id(slot.id), owner_local)
	else:
		None


pure func accepted_global_exact(
	authority: AcceptedGlobalAuthority,
	issuing_table: DefinitionTable,
	declaration_id: DeclarationId,
) -> AcceptedGlobalExactProbe:
	representation = authority_rep(authority)
	table = table_rep(representation.table)

	match declaration_id:
		GlobalDeclarationId(id):
			exact_index = if definition_tables_share_provenance(
				table.definition_table,
				issuing_table,
			):
				table_index_for_id(table, id)
			else:
				None

			match exact_index:
				Some(index):
					match table.slots.get(index):
						Some(slot):
							if global_ids_equal(slot.id, id):
								definition_id = global_id_definition_id(id)

								match available_binding(
									representation,
									slot,
									definition_id,
									authority_owns_global(representation, id),
								):
									Some(binding):
										{
											lookup = AcceptedGlobalExactFound(binding),
											candidates_visited = 1
										}
									None:
										{
											lookup = AcceptedGlobalExactMissing,
											candidates_visited = 1
										}
							else:
								{
									lookup = AcceptedGlobalExactMissing,
									candidates_visited = 1
								}
						None:
							{
								lookup = AcceptedGlobalExactMissing,
								candidates_visited = 1
							}
				None:
					{
						lookup = AcceptedGlobalExactMissing,
						candidates_visited = 0
					}
		_:
			{
				lookup = AcceptedGlobalExactWrongKind(declaration_id),
				candidates_visited = 0
			}
