-- Canonical dimension constraint solving for the Blorp-owned frontend.
--
-- Dimension expressions are normalized to a sum-of-products form so
-- commutativity, associativity, distributivity, and exact constant division are
-- handled before type unification decides whether two dimensions are
-- compatible.
import:
	meta_identity: MetaSessionId, meta_session_ids_equal
	semantic_type:
		SemanticDimOp(SemanticDimAdd, SemanticDimDivide, SemanticDimMultiply, SemanticDimSubtract),
		SemanticType(SemanticConstIntType, SemanticDimOpType, SemanticMetaType, SemanticTypeVar),
		is_dim_var_name,
		types_equal,


-- Ordinary named factors stay on the existing String sort path. Metas and
-- opaque expressions carry their semantic identity instead of borrowing a
-- spelling that a type variable could also have.
private union DimSpecialFactor:
	DimMetaFactor(MetaSessionId, Int)
	DimOpaqueDivisionFactor(DimCanonical, DimCanonical)
	DimOpaqueTypeFactor(SemanticType)


private record DimMonomial {
	coeff: Int,
	vars: List[String],
	specials: List[DimSpecialFactor]
}


private record DimCanonical {
	const_value: Int,
	terms: List[DimMonomial]
}


private record DimMetaCandidate {
	meta_session: MetaSessionId,
	meta_slot: Int,
	term: DimMonomial
}


private record DimNamedCandidate {
	name: String,
	term: DimMonomial
}


union DimSolveResult:
	DimSolved
	DimBindMeta(MetaSessionId, Int, SemanticType)
	DimBindVar(String, SemanticType)
	DimContradiction
	DimStuck


private pure func dim_monomial(
	coeff: Int,
	vars: List[String],
	specials: List[DimSpecialFactor],
) -> DimMonomial:
	{
		coeff = coeff,
		vars = vars,
		specials = specials
	}


private pure func dim_const(value: Int) -> DimCanonical:
	{
		const_value = value,
		terms = []
	}


private pure func dim_var(name: String) -> DimCanonical:
	{
		const_value = 0,
		terms = [dim_monomial(1, [name], [])]
	}


private pure func dim_special(factor: DimSpecialFactor) -> DimCanonical:
	{
		const_value = 0,
		terms = [dim_monomial(1, [], [factor])]
	}


private pure func dim_compare_strings(left: String, right: String) -> Int:
	if left < right:
		-1
	else if left > right:
		1
	else:
		0


private pure func dim_compare_var_lists(left: List[String], right: List[String]) -> Int:
	var index: Int = 0
	var result: Int = 0

	while (
		index < left.length()
		and index < right.length()
		and result == 0
	):
		match (left.get(index), right.get(index)):
			(Some(left_var), Some(right_var)):
				result = dim_compare_strings(left_var, right_var)
			_:
				void

		index += 1

	if result != 0:
		result
	else if left.length() < right.length():
		-1
	else if left.length() > right.length():
		1
	else:
		0


private pure func dim_var_lists_equal(left: List[String], right: List[String]) -> Bool:
	dim_compare_var_lists(left, right) == 0


private pure func dim_special_equal(left: DimSpecialFactor, right: DimSpecialFactor) -> Bool:
	match left:
		DimMetaFactor(left_session, left_slot):
			match right:
				DimMetaFactor(right_session, right_slot):
					(
						left_slot == right_slot
						and meta_session_ids_equal(left_session, right_session)
					)
				_:
					False
		DimOpaqueDivisionFactor(left_num, left_den):
			match right:
				DimOpaqueDivisionFactor(right_num, right_den):
					(
						dim_canonical_equal(left_num, right_num)
						and dim_canonical_equal(left_den, right_den)
					)
				_:
					False
		DimOpaqueTypeFactor(left_type):
			match right:
				DimOpaqueTypeFactor(right_type):
					types_equal(left_type, right_type)
				_:
					False


private pure func dim_special_lists_equal(
	left: List[DimSpecialFactor],
	right: List[DimSpecialFactor],
) -> Bool:
	if left.length() != right.length():
		False
	else if left.length() == 1:
		match (left.get(0), right.get(0)):
			(Some(left_factor), Some(right_factor)):
				dim_special_equal(left_factor, right_factor)
			_:
				False
	else:
		-- Special factors are uncommon. Counting equal factors avoids a
		-- display-string ordering and does not allocate a sorted copy.
		var equal: Bool = True

		for candidate in left:
			if equal:
				var left_count: Int = 0
				var right_count: Int = 0

				for factor in left:
					if dim_special_equal(candidate, factor):
						left_count += 1

				for factor in right:
					if dim_special_equal(candidate, factor):
						right_count += 1

				equal = left_count == right_count

		equal


private pure func dim_monomial_key_equal(left: DimMonomial, right: DimMonomial) -> Bool:
	(
		dim_var_lists_equal(left.vars, right.vars)
		and dim_special_lists_equal(left.specials, right.specials)
	)


private pure func dim_insert_sorted_monomial(
	sorted: List[DimMonomial],
	term: DimMonomial,
) -> List[DimMonomial]:
	var result: List[DimMonomial] = []
	var inserted: Bool = False

	for existing in sorted:
		if not inserted and dim_compare_var_lists(term.vars, existing.vars) <= 0:
			result = result.append(term)
			inserted = True

		result = result.append(existing)

	if inserted:
		result
	else:
		result.append(term)


private pure func dim_sort_terms(terms: List[DimMonomial]) -> List[DimMonomial]:
	var result: List[DimMonomial] = []

	for term in terms:
		result = dim_insert_sorted_monomial(result, term)

	result


private pure func dim_append_nonzero(
	terms: List[DimMonomial],
	term: DimMonomial,
) -> List[DimMonomial]:
	if term.coeff == 0:
		terms
	else:
		terms.append(term)


private pure func dim_negate_monomial(term: DimMonomial) -> DimMonomial:
	{
		coeff = 0 - term.coeff,
		vars = term.vars,
		specials = term.specials
	}


private pure func dim_merge_plain_terms(terms: List[DimMonomial]) -> List[DimMonomial]:
	sorted: List[DimMonomial] = dim_sort_terms(terms)
	var result: List[DimMonomial] = []
	var current: Option[DimMonomial] = None

	for term in sorted:
		match current:
			Some(existing):
				if dim_var_lists_equal(existing.vars, term.vars):
					current = Some({ existing | coeff = existing.coeff + term.coeff })
				else:
					result = dim_append_nonzero(result, existing)
					current = Some(term)
			None:
				current = Some(term)

	match current:
		Some(term):
			result = dim_append_nonzero(result, term)
		None:
			void

	result


private pure func dim_merge_special_terms_general(terms: List[DimMonomial]) -> List[DimMonomial]:
	-- There is no display-string ordering for exceptional factors. Preserve
	-- encounter order when rebuilding a symbolic binding, but coalesce terms
	-- by semantic identity; canonical equality below is order-independent.
	var pending: List[DimMonomial] = terms
	var result: List[DimMonomial] = []

	while pending.length() > 0:
		match pending.get(0):
			Some(first):
				var combined: DimMonomial = first
				var remaining: List[DimMonomial] = []
				var index: Int = 0

				for term in pending:
					if index > 0:
						if dim_monomial_key_equal(first, term):
							combined = { combined | coeff = combined.coeff + term.coeff }
						else:
							remaining = remaining.append(term)

					index += 1

				result = dim_append_nonzero(result, combined)
				pending = remaining
			None:
				break

	result


private pure func dim_merge_special_terms(terms: List[DimMonomial]) -> List[DimMonomial]:
	if terms.length() == 1:
		match terms.get(0):
			Some(term):
				dim_append_nonzero([], term)
			None:
				[]
	else:
		dim_merge_special_terms_general(terms)


private pure func dim_terms_have_specials(terms: List[DimMonomial]) -> Bool:
	var found: Bool = False

	for term in terms:
		if term.specials.length() > 0:
			found = True
			break

	found


private pure func dim_merge_terms(terms: List[DimMonomial]) -> List[DimMonomial]:
	if dim_terms_have_specials(terms):
		dim_merge_special_terms(terms)
	else:
		dim_merge_plain_terms(terms)


private pure func dim_negate(canonical: DimCanonical) -> DimCanonical:
	{
		const_value = 0 - canonical.const_value,
		terms = canonical.terms.map(dim_negate_monomial)
	}


private pure func dim_add(left: DimCanonical, right: DimCanonical) -> DimCanonical:
	{
		const_value = left.const_value + right.const_value,
		terms = dim_merge_terms(left.terms.concat(right.terms))
	}


private pure func dim_subtract(left: DimCanonical, right: DimCanonical) -> DimCanonical:
	dim_add(left, dim_negate(right))


private pure func dim_multiply(left: DimCanonical, right: DimCanonical) -> DimCanonical:
	var cross_terms: List[DimMonomial] = []

	if right.const_value != 0:
		for term in left.terms:
			cross_terms = cross_terms.append({ term | coeff = term.coeff * right.const_value })

	if left.const_value != 0:
		for term in right.terms:
			cross_terms = cross_terms.append({ term | coeff = term.coeff * left.const_value })

	for left_term in left.terms:
		for right_term in right.terms:
			product_vars: List[String] = left_term.vars
				.concat(right_term.vars)
				.sort()

			product_specials: List[DimSpecialFactor] = if left_term.specials.length() == 0:
				right_term.specials
			else if right_term.specials.length() == 0:
				left_term.specials
			else:
				left_term.specials.concat(right_term.specials)

			cross_terms = cross_terms.append(
				dim_monomial(
					left_term.coeff * right_term.coeff,
					product_vars,
					product_specials,
				),
			)

	{
		const_value = left.const_value * right.const_value,
		terms = dim_merge_terms(cross_terms)
	}


private pure func dim_try_div_const(canonical: DimCanonical, divisor: Int) -> Option[DimCanonical]:
	if divisor == 0 or canonical.const_value % divisor != 0:
		None
	else:
		var divided_terms: List[DimMonomial] = []
		var divides_evenly: Bool = True

		for term in canonical.terms:
			if term.coeff % divisor != 0:
				divides_evenly = False
			else:
				divided_terms = divided_terms.append({ term | coeff = term.coeff / divisor })

		if divides_evenly:
			Some({
				const_value = canonical.const_value / divisor,
				terms = dim_merge_terms(divided_terms),
			})
		else:
			None


private pure func dim_lookup_meta(
	meta_bindings: List[Option[SemanticType]],
	solver_session: Option[MetaSessionId],
	meta_session: MetaSessionId,
	meta_slot: Int,
) -> Option[SemanticType]:
	match solver_session:
		Some(issued_session):
			if meta_session_ids_equal(issued_session, meta_session):
				meta_bindings.get_or(meta_slot, None)
			else:
				None
		None:
			None


private pure func dim_divide_to_canonical(
	meta_bindings: List[Option[SemanticType]],
	solver_session: Option[MetaSessionId],
	left: SemanticType,
	right: SemanticType,
) -> DimCanonical:
	left_canonical: DimCanonical = dim_to_canonical(meta_bindings, solver_session, left)
	right_canonical: DimCanonical = dim_to_canonical(meta_bindings, solver_session, right)

	if right_canonical.terms.length() == 0 and right_canonical.const_value > 0:
		match dim_try_div_const(left_canonical, right_canonical.const_value):
			Some(divided):
				divided
			None:
				dim_special(DimOpaqueDivisionFactor(left_canonical, right_canonical))
	else:
		dim_special(DimOpaqueDivisionFactor(left_canonical, right_canonical))


private pure func dim_to_canonical(
	meta_bindings: List[Option[SemanticType]],
	solver_session: Option[MetaSessionId],
	typ: SemanticType,
) -> DimCanonical:
	match typ:
		SemanticConstIntType(value):
			dim_const(value)
		SemanticTypeVar(name):
			dim_var(name)
		SemanticMetaType(meta_session, meta_slot):
			match dim_lookup_meta(meta_bindings, solver_session, meta_session, meta_slot):
				Some(binding):
					dim_to_canonical(meta_bindings, solver_session, binding)
				None:
					match solver_session:
						Some(issued_session):
							if meta_session_ids_equal(issued_session, meta_session):
								dim_special(DimMetaFactor(meta_session, meta_slot))
							else:
								dim_special(DimOpaqueTypeFactor(typ))
						None:
							dim_special(DimOpaqueTypeFactor(typ))
		SemanticDimOpType(op, left, right):
			match op:
				SemanticDimAdd:
					dim_add(
					dim_to_canonical(meta_bindings, solver_session, left),
					dim_to_canonical(meta_bindings, solver_session, right),
					)
				SemanticDimSubtract:
					dim_subtract(
					dim_to_canonical(meta_bindings, solver_session, left),
					dim_to_canonical(meta_bindings, solver_session, right),
					)
				SemanticDimMultiply:
					dim_multiply(
					dim_to_canonical(meta_bindings, solver_session, left),
					dim_to_canonical(meta_bindings, solver_session, right),
					)
				SemanticDimDivide:
					dim_divide_to_canonical(meta_bindings, solver_session, left, right)
		_:
			dim_special(DimOpaqueTypeFactor(typ))


private pure func dim_special_to_type(factor: DimSpecialFactor) -> SemanticType:
	match factor:
		DimMetaFactor(meta_session, meta_slot):
			SemanticMetaType(meta_session, meta_slot)
		DimOpaqueDivisionFactor(numerator, denominator):
			SemanticDimOpType(
				SemanticDimDivide,
				dim_from_canonical(numerator),
				dim_from_canonical(denominator),
			)
		DimOpaqueTypeFactor(typ):
			typ


private pure func dim_term_to_type(term: DimMonomial) -> SemanticType:
	var factors: List[SemanticType] = []

	for name in term.vars:
		factors = factors.append(SemanticTypeVar(name))

	for special in term.specials:
		factors = factors.append(dim_special_to_type(special))

	if factors.length() == 0:
		SemanticConstIntType(term.coeff)
	else:
		var result: SemanticType = factors.get_or(0, SemanticConstIntType(0))
		var index: Int = 1

		while index < factors.length():
			result = SemanticDimOpType(
				SemanticDimMultiply,
				result,
				factors.get_or(index, SemanticConstIntType(0)),
			)
			index += 1

		if term.coeff == 1:
			result
		else:
			SemanticDimOpType(SemanticDimMultiply, SemanticConstIntType(term.coeff), result)


private pure func dim_from_canonical(canonical: DimCanonical) -> SemanticType:
	var parts: List[SemanticType] = []

	if canonical.const_value != 0:
		parts = parts.append(SemanticConstIntType(canonical.const_value))

	for term in canonical.terms:
		parts = parts.append(dim_term_to_type(term))

	if parts.length() == 0:
		SemanticConstIntType(0)
	else:
		var result: SemanticType = parts.get_or(0, SemanticConstIntType(0))
		var index: Int = 1

		while index < parts.length():
			result = SemanticDimOpType(
				SemanticDimAdd,
				result,
				parts.get_or(index, SemanticConstIntType(0)),
			)
			index += 1

		result


private pure func dim_monomial_equal(left: DimMonomial, right: DimMonomial) -> Bool:
	left.coeff == right.coeff and dim_monomial_key_equal(left, right)


private pure func dim_special_monomial_lists_equal_general(
	left: List[DimMonomial],
	right: List[DimMonomial],
) -> Bool:
	var equal: Bool = True

	for candidate in left:
		if equal:
			var left_count: Int = 0
			var right_count: Int = 0

			for term in left:
				if dim_monomial_equal(candidate, term):
					left_count += 1

			for term in right:
				if dim_monomial_equal(candidate, term):
					right_count += 1

			equal = left_count == right_count

	equal


private pure func dim_special_monomial_lists_equal(
	left: List[DimMonomial],
	right: List[DimMonomial],
) -> Bool:
	if left.length() == 1:
		match (left.get(0), right.get(0)):
			(Some(left_term), Some(right_term)):
				dim_monomial_equal(left_term, right_term)
			_:
				False
	else:
		dim_special_monomial_lists_equal_general(left, right)


private pure func dim_monomial_lists_equal(
	left: List[DimMonomial],
	right: List[DimMonomial],
) -> Bool:
	if left.length() != right.length():
		False
	else if dim_terms_have_specials(left) or dim_terms_have_specials(right):
		dim_special_monomial_lists_equal(left, right)
	else:
		var index: Int = 0
		var equal: Bool = True

		while index < left.length() and equal:
			match (left.get(index), right.get(index)):
				(Some(left_item), Some(right_item)):
					equal = dim_monomial_equal(left_item, right_item)
				_:
					equal = False

			index += 1

		equal


private pure func dim_canonical_equal(left: DimCanonical, right: DimCanonical) -> Bool:
	left.const_value == right.const_value and dim_monomial_lists_equal(left.terms, right.terms)


private pure func dim_is_solvable_type(
	meta_bindings: List[Option[SemanticType]],
	solver_session: Option[MetaSessionId],
	typ: SemanticType,
) -> Bool:
	match typ:
		SemanticMetaType(meta_session, meta_slot):
			match solver_session:
				Some(issued_session):
					(
						meta_session_ids_equal(issued_session, meta_session)
						and dim_lookup_meta(
							meta_bindings,
							solver_session,
							meta_session,
							meta_slot,
						).is_none()
					)
				None:
					False
		SemanticTypeVar(name):
			is_dim_var_name(name)
		_:
			False


private pure func dim_bind_type(variable: SemanticType, value: SemanticType) -> DimSolveResult:
	match variable:
		SemanticMetaType(meta_session, meta_slot):
			DimBindMeta(meta_session, meta_slot, value)
		SemanticTypeVar(name):
			DimBindVar(name, value)
		_:
			DimStuck


private pure func dim_solvable_monomial_factor(term: DimMonomial) -> Option[SemanticType]:
	if term.vars.length() == 1 and term.specials.length() == 0:
		name: String = term.vars.get_or(0, "")

		if is_dim_var_name(name):
			Some(SemanticTypeVar(name))
		else:
			None
	else if term.vars.length() == 0 and term.specials.length() == 1:
		match term.specials.get(0):
			Some(DimMetaFactor(meta_session, meta_slot)):
				Some(SemanticMetaType(meta_session, meta_slot))
			_:
				None
	else:
		None


private pure func dim_rest_terms(
	terms: List[DimMonomial],
	candidate: DimMonomial,
) -> List[DimMonomial]:
	var result: List[DimMonomial] = []

	for term in terms:
		if not dim_monomial_equal(term, candidate):
			result = result.append(term)

	result


private pure func dim_try_isolate(
	diff_const: Int,
	candidate: DimMonomial,
	rest_terms: List[DimMonomial],
) -> Option[DimSolveResult]:
	if candidate.coeff == 0:
		None
	else:
		match dim_solvable_monomial_factor(candidate):
			Some(variable):
				rest_canonical: DimCanonical = {
					const_value = diff_const,
					terms = rest_terms
				}

				match dim_try_div_const(dim_negate(rest_canonical), candidate.coeff):
					Some(value):
						Some(dim_bind_type(variable, dim_from_canonical(value)))
					None:
						None
			None:
				None


private pure func dim_monomial_single_dim_name(term: DimMonomial) -> Option[String]:
	if term.vars.length() != 1 or term.specials.length() != 0:
		None
	else:
		match term.vars.get(0):
			Some(name):
				if is_dim_var_name(name):
					Some(name)
				else:
					None
			None:
				None


private pure func dim_solve_multiple_terms(diff: DimCanonical) -> DimSolveResult:
	var meta_candidates: List[DimMetaCandidate] = []
	var named_candidates: List[DimNamedCandidate] = []

	for term in diff.terms:
		var added_meta: Bool = False

		if term.vars.length() == 0 and term.specials.length() == 1:
			match term.specials.get(0):
				Some(DimMetaFactor(meta_session, meta_slot)):
					added_meta = True
					meta_candidates = meta_candidates.append({
						meta_session = meta_session,
						meta_slot = meta_slot,
						term = term,
					})
				_:
					void

		if not added_meta:
			match dim_monomial_single_dim_name(term):
				Some(name):
					named_candidates = named_candidates.append({
						name = name,
						term = term,
					})
				None:
					void

	var result: Option[DimSolveResult] = None

	-- Once special factors are typed, their source order is no longer a
	-- lexical key. Try isolatable lower-numbered metas first, as the old
	-- ?mN sort did; products containing metas cannot be isolated here.
	for candidate in meta_candidates.sort_by(func(entry): entry.meta_slot):
		if result.is_none():
			result = dim_try_isolate(
				diff.const_value,
				candidate.term,
				dim_rest_terms(diff.terms, candidate.term),
			)

	-- Named dimension variables retain their lexical binding priority even
	-- when an opaque term makes the reconstructed sum encounter-ordered.
	for candidate in named_candidates.sort_by(func(entry): entry.name):
		if result.is_none():
			result = dim_try_isolate(
				diff.const_value,
				candidate.term,
				dim_rest_terms(diff.terms, candidate.term),
			)

	match result:
		Some(solved):
			solved
		None:
			DimStuck


private pure func dim_solve_single_term(diff_const: Int, term: DimMonomial) -> DimSolveResult:
	match dim_solvable_monomial_factor(term):
		Some(variable):
			if term.coeff == 0:
				if diff_const == 0:
					DimSolved
				else:
					DimContradiction
			else if diff_const % term.coeff != 0:
				DimStuck
			else:
				value: Int = (0 - diff_const) / term.coeff

				if value <= 0:
					DimStuck
				else:
					dim_bind_type(variable, SemanticConstIntType(value))
		None:
			DimStuck


private pure func dim_solve_diff(diff: DimCanonical) -> DimSolveResult:
	if diff.terms.length() == 0:
		if diff.const_value == 0:
			DimSolved
		else:
			DimContradiction
	else if diff.terms.length() == 1:
		dim_solve_single_term(
			diff.const_value,
			diff.terms.get_or(
				0,
				dim_monomial(0, [], []),
			),
		)
	else:
		dim_solve_multiple_terms(diff)


private pure func dim_try_divisor_var_case(
	meta_bindings: List[Option[SemanticType]],
	solver_session: Option[MetaSessionId],
	dividend: SemanticType,
	divisor: SemanticType,
	rhs_expr: SemanticType,
) -> Option[DimSolveResult]:
	if not dim_is_solvable_type(meta_bindings, solver_session, divisor):
		None
	else:
		dividend_canonical: DimCanonical = dim_to_canonical(meta_bindings, solver_session, dividend)
		rhs_canonical: DimCanonical = dim_to_canonical(meta_bindings, solver_session, rhs_expr)

		if (
			dividend_canonical.terms.length() == 0
			and rhs_canonical.terms.length() == 0
			and rhs_canonical.const_value > 0
			and dividend_canonical.const_value % rhs_canonical.const_value == 0
		):
			Some(
				dim_bind_type(
					divisor,
					SemanticConstIntType(
						dividend_canonical.const_value / rhs_canonical.const_value,
					),
				),
			)
		else:
			None


private pure func dim_try_dividend_var_case(
	meta_bindings: List[Option[SemanticType]],
	solver_session: Option[MetaSessionId],
	dividend: SemanticType,
	divisor: SemanticType,
	rhs_expr: SemanticType,
) -> Option[DimSolveResult]:
	match divisor:
		SemanticConstIntType(divisor_value):
			if divisor_value <= 0:
				None
			else:
				rhs_canonical: DimCanonical = dim_to_canonical(meta_bindings, solver_session, rhs_expr)
				product: DimCanonical = dim_multiply(rhs_canonical, dim_const(divisor_value))
				dividend_canonical: DimCanonical = dim_to_canonical(meta_bindings, solver_session, dividend)

				Some(dim_solve_diff(dim_subtract(dividend_canonical, product)))
		_:
			None


private pure func dim_check_division_special(
	meta_bindings: List[Option[SemanticType]],
	solver_session: Option[MetaSessionId],
	dividend: SemanticType,
	divisor: SemanticType,
	rhs_expr: SemanticType,
) -> Option[DimSolveResult]:
	match dim_try_divisor_var_case(meta_bindings, solver_session, dividend, divisor, rhs_expr):
		Some(result):
			Some(result)
		None:
			dim_try_dividend_var_case(meta_bindings, solver_session, dividend, divisor, rhs_expr)


private pure func dim_try_division_special(
	meta_bindings: List[Option[SemanticType]],
	solver_session: Option[MetaSessionId],
	left: SemanticType,
	right: SemanticType,
) -> Option[DimSolveResult]:
	match left:
		SemanticDimOpType(left_op, dividend, divisor):
			if left_op == SemanticDimDivide:
				dim_check_division_special(meta_bindings, solver_session, dividend, divisor, right)
			else:
				None
		_:
			match right:
				SemanticDimOpType(right_op, dividend, divisor):
					if right_op == SemanticDimDivide:
						dim_check_division_special(meta_bindings, solver_session, dividend, divisor, left)
					else:
						None
				_:
					None


pure func dim_solve(
	solver_session: Option[MetaSessionId],
	meta_bindings: List[Option[SemanticType]],
	left: SemanticType,
	right: SemanticType,
) -> DimSolveResult:
	match dim_try_division_special(meta_bindings, solver_session, left, right):
		Some(result):
			result
		None:
			left_canonical: DimCanonical = dim_to_canonical(meta_bindings, solver_session, left)
			right_canonical: DimCanonical = dim_to_canonical(meta_bindings, solver_session, right)

			if dim_canonical_equal(left_canonical, right_canonical):
				DimSolved
			else:
				dim_solve_diff(dim_subtract(left_canonical, right_canonical))
