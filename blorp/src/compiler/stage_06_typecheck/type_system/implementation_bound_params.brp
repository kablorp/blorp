-- Body checking and lexical evidence share the same accepted header projection.
-- Enclosing implementation parameters precede explicit method parameters;
-- default methods have no explicit method parameters.
import:
	../graph/definition_index: DefinitionTable
	../headers/implementation_headers:
		ImplementationHeader, ImplementationMethodHeader,
		implementation_header_parameters, explicit_implementation_method_parameters,
		resolved_implementation_type_parameter_id, resolved_implementation_type_parameter_bounds,
		resolved_implementation_method_type_parameter_id, resolved_implementation_method_type_parameter_bounds
	../headers/type_header_graph: implementation_type_parameter_id_name, callable_type_parameter_id_name
	accepted_trait_implementation_authority: bound_trait_identity_from_id
	generic_params: BoundTypeParam, make_resolved_bound_type_param


pure func implementation_bound_type_params(
	definition_table: DefinitionTable,
	header: ImplementationHeader,
) -> List[BoundTypeParam]:
	implementation_header_parameters(header).map(func(parameter): make_resolved_bound_type_param(
			implementation_type_parameter_id_name(
				resolved_implementation_type_parameter_id(parameter),
			),
			resolved_implementation_type_parameter_bounds(
				parameter,
			).map(
				func(id): bound_trait_identity_from_id(definition_table, id),
			),
		))


pure func implementation_method_bound_type_params(
	definition_table: DefinitionTable,
	header: ImplementationMethodHeader,
) -> List[BoundTypeParam]:
	explicit_implementation_method_parameters(
		header,
	).map(
		func(parameter): make_resolved_bound_type_param(
			callable_type_parameter_id_name(
				resolved_implementation_method_type_parameter_id(parameter),
			),
			resolved_implementation_method_type_parameter_bounds(
				parameter,
			).map(
				func(id): bound_trait_identity_from_id(definition_table, id),
			),
		),
	)
