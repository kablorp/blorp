-- Conservative ownership classification shared by Core optimizations that
-- may duplicate or scalar-expand expressions only when no release is needed.
--
-- Unknown layouts are deliberately managed. This is an eligibility policy,
-- not a fallback ABI classifier: a false negative only preserves the original
-- Core shape, while a false positive could remove required ownership work.
import:
	../stage_08_core_lower/list_layout: CoreLayoutTypeIndex, resolve_layout_type_with_index
	ir:
		CoreType(
			BoxedResultType,
			EnumType,
			FunctionType,
			HeapRecordType,
			NamedType,
			RangeType,
			SelfType,
			StackResultType,
			TensorType,
			TupleType,
			TypeParameterType,
			UnionType,
			ValueRecordType,
			VoidType,
		),


private pure func named_type_is_known_unmanaged(name: String) -> Bool:
	(
		name == "Int"
		or name == "Int8"
		or name == "Int16"
		or name == "Int32"
		or name == "Int64"
		or name == "Int128"
		or name == "UInt8"
		or name == "UInt16"
		or name == "UInt32"
		or name == "UInt64"
		or name == "UInt128"
		or name == "Bool"
		or name == "Char"
		or name == "Float"
		or name == "Float32"
		or name == "Float16"
		or name == "Void"
		or name == "Ptr"
		or name == "Module"
		or name == "Port"
		or name == "FileReader"
		or name == "FileWriter"
		or name == "FileAppender"
		or name == "FileReadWriter"
		or name == "FileReadAppender"
		or name == "fs::FileReader"
		or name == "fs::FileWriter"
		or name == "fs::FileAppender"
		or name == "fs::FileReadWriter"
		or name == "fs::FileReadAppender"
		or name == "fs__FileReader"
		or name == "fs__FileWriter"
		or name == "fs__FileAppender"
		or name == "fs__FileReadWriter"
		or name == "fs__FileReadAppender"
		or name == "Directory"
		or name == "fs::Directory"
		or name == "fs__Directory"
		or name == "UdpSocket"
		or name == "net/udp::UdpSocket"
		or name == "net_udp__UdpSocket"
	)


private pure func named_type_is_stack_option_payload(name: String) -> Bool:
	(
		name == "Void"
		or name == "Int"
		or name == "Int8"
		or name == "Int16"
		or name == "Int32"
		or name == "Int64"
		or name == "Int128"
		or name == "UInt8"
		or name == "UInt16"
		or name == "UInt32"
		or name == "UInt64"
		or name == "UInt128"
		or name == "Float"
		or name == "Float32"
		or name == "Float16"
		or name == "Bool"
		or name == "Char"
	)


private pure func stack_option_payload_is_known_unmanaged(
	layout_types: CoreLayoutTypeIndex,
	payload: CoreType,
) -> Bool:
	match resolve_layout_type_with_index(layout_types, payload):
		NamedType(name, args):
			args.is_empty() and named_type_is_stack_option_payload(name)
		EnumType(_) | ValueRecordType(_) | RangeType:
			True
		_:
			False


pure func core_type_is_known_unmanaged(layout_types: CoreLayoutTypeIndex, typ: CoreType) -> Bool:
	match resolve_layout_type_with_index(layout_types, typ):
		NamedType("Option", [payload]):
			stack_option_payload_is_known_unmanaged(layout_types, payload)
		NamedType(name, args):
			args.is_empty() and named_type_is_known_unmanaged(name)
		StackResultType(ok_type, error_type):
			(
				core_type_is_known_unmanaged(layout_types, ok_type)
				and core_type_is_known_unmanaged(layout_types, error_type)
			)
		VoidType | EnumType(_) | ValueRecordType(_) | RangeType:
			True
		TypeParameterType(_) | SelfType:
			False
		BoxedResultType(_, _) | FunctionType(_, _, _) | HeapRecordType(_):
			False
		TensorType(_) | TupleType(_) | UnionType(_):
			False
