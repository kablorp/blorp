-- Dict and Set constructors whose keys name an opaque type.
--
-- An opaque type declares its own Equatable and Hashable impls, which may be
-- coarser than its representation's equality (a case-insensitive
-- `opaque type Tag = String`). Runtime projection resolves every type through
-- every alias, so after it `Dict[Tag, Int]` reads `Dict[String, Int]`, and
-- the later passes that choose a container's hashing would pick the string
-- hasher. Before it erases the types, runtime projection hands each Dict and
-- Set construction to `opaque_hash_key_pin`. A construction whose key names
-- an opaque type, at the top or inside a type argument (`Option[Tag]`), is
-- pinned to the key's impl methods (`ImplHashContainerConstructor`), and once
-- the node's types are canonical, `with_pinned_hash_constructor` rebuilds it
-- as an explicit construction that carries them. Backend projection
-- binds those to the slot adapters `hash_key_callbacks` mints, which unbox the
-- representation the key slots store.
--
-- Pinning happens in runtime projection's own expression walk, so it adds no
-- pass over the program.
import:
	../stage_08_core_lower/list_layout:
		resolve_layout_type_head_keeping_opaque_arguments,
		resolve_layout_type_keeping_opaque_aliases,
	ir:
		CoreCallKind(BuiltinCall, DictWithCapacityCall),
		CoreExpr(CallExpr, DictConstructExpr, DictExpr, SetAllocExpr),
		core_expr_source_loc,
		core_expr_type,
		CoreHashContainerConstructor(ImplHashContainerConstructor, TraitHashContainerConstructor),
		CoreProgram,
		CoreRuntimeCallbackRole(EquatableEqualsCallback, HashableHashCallback),
		CoreSourceLoc,
		CoreType(NamedType),
	prepare: lower_trait_keyed_dict_literal
	runtime_callbacks: CoreRuntimeCallbackTable, build_runtime_callback_table, find_runtime_callback
	specialize_layout:
		CoreSpecializeLayout,
		boxed_storage_needs_release,
		named_type_arguments,
		resolve_specialize_type


-- The runtime builtins that make an empty container from its type alone;
-- `builtin_registry` maps `dict()`, `with_capacity()` and `set()` to them.
private DICT_NEW_BUILTIN: String = "blorp_dict_new"

private DICT_WITH_CAPACITY_BUILTIN: String = "blorp_dict_with_capacity"

private SET_NEW_BUILTIN: String = "blorp_set_new"

private DICT_TYPE_NAME: String = "Dict"

private SET_TYPE_NAME: String = "Set"


---
What pinning reads: the program's layout, whose aliases are still declared,
and its impl methods by callback role, keyed by their unerased target type.
---
record OpaqueHashKeyPinning {
	layout: CoreSpecializeLayout,
	callbacks: CoreRuntimeCallbackTable
}


--- `program` must still declare its aliases; its impl methods must already be projected.
pure func opaque_hash_key_pinning(
	layout: CoreSpecializeLayout,
	program: CoreProgram,
) -> OpaqueHashKeyPinning:
	{
		layout = layout,
		callbacks = build_runtime_callback_table(program)
	}


--- A container's type arguments, with its own alias (opaque or not) resolved but opaque keys kept.
private pure func container_arguments(
	pinning: OpaqueHashKeyPinning,
	container_type: CoreType,
	container_name: String,
) -> Option[List[CoreType]]:
	match resolve_layout_type_head_keeping_opaque_arguments(pinning.layout.types, container_type):
		NamedType(name, args):
			if name == container_name:
				Some(args)
			else:
				None
		_:
			None


--- Which Dict or Set construction a pin rebuilds; read from the node before its types are resolved.
enum PinnedHashContainerShape:
	PinnedEmptyDict
	PinnedEmptySet
	PinnedDictWithCapacity
	PinnedDictLiteral


---
A construction to rebuild with `constructor` once its types are canonical.
`key` is the unerased key, named if the rebuild cannot happen.
---
record OpaqueHashKeyPin {
	shape: PinnedHashContainerShape,
	constructor: CoreHashContainerConstructor,
	key: CoreType
}


---
The pin for a container keyed by `key_type`, when erasing aliases would
change which impls hash it: `None` when the key names no opaque type. A key
whose impls are missing keeps its unerased name in an unbound trait
constructor, which C symbol projection reports as an internal error.
---
private pure func pin_for_key(
	pinning: OpaqueHashKeyPinning,
	shape: PinnedHashContainerShape,
	key_type: CoreType,
) -> Option[OpaqueHashKeyPin]:
	key: CoreType = resolve_layout_type_keeping_opaque_aliases(pinning.layout.types, key_type)

	if key == resolve_specialize_type(pinning.layout, key):
		None
	else:
		constructor: CoreHashContainerConstructor = match (
			find_runtime_callback(pinning.callbacks, HashableHashCallback, key),
			find_runtime_callback(pinning.callbacks, EquatableEqualsCallback, key),
		):
			(Some(hash_impl), Some(equals_impl)):
				ImplHashContainerConstructor(hash_impl, equals_impl)
			_:
				TraitHashContainerConstructor(key)

		Some({
			shape = shape,
			constructor = constructor,
			key = key
		})


private pure func dict_pin(
	pinning: OpaqueHashKeyPinning,
	shape: PinnedHashContainerShape,
	container_type: CoreType,
) -> Option[OpaqueHashKeyPin]:
	match container_arguments(pinning, container_type, DICT_TYPE_NAME):
		Some([key_type, _]):
			pin_for_key(pinning, shape, key_type)
		_:
			None


private pure func set_pin(pinning: OpaqueHashKeyPinning, container_type: CoreType) -> Option[OpaqueHashKeyPin]:
	match container_arguments(pinning, container_type, SET_TYPE_NAME):
		Some([element_type]):
			pin_for_key(pinning, PinnedEmptySet, element_type)
		_:
			None


---
The pin for `expr` when it makes a Dict or Set whose key names an opaque type,
or `None` to leave it for the later passes. Read from the node before runtime
projection resolves its types; `with_pinned_hash_constructor` rebuilds the
node after they are resolved.
---
pure func opaque_hash_key_pin(pinning: OpaqueHashKeyPinning, expr: CoreExpr) -> Option[OpaqueHashKeyPin]:
	match expr:
		CallExpr(BuiltinCall(name), _, args, typ, _):
			if name == DICT_NEW_BUILTIN and args.is_empty():
				dict_pin(pinning, PinnedEmptyDict, typ)
			else if name == SET_NEW_BUILTIN and args.is_empty():
				set_pin(pinning, typ)
			else if name == DICT_WITH_CAPACITY_BUILTIN and args.length() == 1:
				dict_pin(pinning, PinnedDictWithCapacity, typ)
			else:
				None
		DictExpr(entries, typ, _):
			if entries.is_empty():
				match set_pin(pinning, typ):
					Some(pin):
						Some(pin)
					None:
						dict_pin(pinning, PinnedEmptyDict, typ)
			else:
				dict_pin(pinning, PinnedDictLiteral, typ)
		_:
			None


---
Stands in for a pinned construction that cannot be rebuilt, which only an
inconsistency between the two halves of pinning can cause. Its unbound
constructor names the opaque key, so C symbol projection fails the compile
instead of letting the container hash by representation.
---
private pure func unrebuildable_pin(pin: OpaqueHashKeyPin, expr: CoreExpr) -> CoreExpr:
	SetAllocExpr(TraitHashContainerConstructor(pin.key), core_expr_type(expr), core_expr_source_loc(expr))


private pure func empty_dict(
	layout: CoreSpecializeLayout,
	pin: OpaqueHashKeyPin,
	expr: CoreExpr,
	typ: CoreType,
	loc: CoreSourceLoc,
) -> CoreExpr:
	match named_type_arguments(layout, typ, DICT_TYPE_NAME):
		Some([_, value_type]):
			DictConstructExpr(
				{
					constructor = pin.constructor,
					entries = [],
					value_needs_release = boxed_storage_needs_release(layout, value_type)
				},
				typ,
				loc,
			)
		_:
			unrebuildable_pin(pin, expr)


---
`expr`, the canonicalized node `opaque_hash_key_pin` pinned, rebuilt as the
construction that carries the pin's constructor. Entries and values are
boxed from canonical types, as backend projection boxes the literals it
lowers.
---
pure func with_pinned_hash_constructor(
	layout: CoreSpecializeLayout,
	pin: OpaqueHashKeyPin,
	expr: CoreExpr,
) -> CoreExpr:
	match (pin.shape, expr):
		(PinnedEmptySet, CallExpr(_, _, _, typ, loc)) | (PinnedEmptySet, DictExpr(_, typ, loc)):
			SetAllocExpr(pin.constructor, typ, loc)
		(PinnedEmptyDict, CallExpr(_, _, _, typ, loc)) | (PinnedEmptyDict, DictExpr(_, typ, loc)):
			empty_dict(layout, pin, expr, typ, loc)
		(PinnedDictWithCapacity, CallExpr(_, callee, args, typ, loc)):
			CallExpr(DictWithCapacityCall(pin.constructor), callee, args, typ, loc)
		(PinnedDictLiteral, DictExpr(entries, typ, loc)):
			match lower_trait_keyed_dict_literal(layout, pin.constructor, entries, typ, loc):
				Some(lowered):
					lowered
				None:
					unrebuildable_pin(pin, expr)
		_:
			unrebuildable_pin(pin, expr)
