-- The marker for key temporaries that synthesized Dict and Set bodies convert
-- into erased storage.
--
-- Hash-collection synthesis converts a typed key into the container's `void*`
-- key storage, but only specialization knows whether that conversion
-- allocates a fresh box: a stack option, stack result, value struct or
-- 128-bit integer key is boxed, a pointer-shaped or word key is not, and
-- `Result` only becomes a stack result after synthesis. Synthesis therefore
-- releases each key temporary through this marker, carrying the typed key
-- variable as a type witness, and specialization resolves it into the
-- release or into nothing (`specialize_collection`). No marker may survive
-- specialization (`late_invariants`).


--- The marker intrinsic synthesis emits: `[key_temporary, typed_key_source]`.
ERASED_KEY_TEMP_RELEASE_INTRINSIC: String = "release_erased_key_temp"

--- What the marker resolves to for a fresh box: the backend intrinsic that drops the operation's own reference to it (`intrinsic_renderer.brp`).
RELEASE_HASH_KEY_BOX: String = "release_hash_key_box"


--- True for the marker's intrinsic name.
pure func is_erased_key_temp_marker(name: String) -> Bool:
	name == ERASED_KEY_TEMP_RELEASE_INTRINSIC

