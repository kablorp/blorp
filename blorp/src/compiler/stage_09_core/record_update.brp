-- Preserve record-update intent until the ownership boundary, then classify
-- it immediately before ownership analysis. Mutable self-updates transfer the
-- target's old owner into RecordCowUpdateExpr or RecordReuseExpr. Nested self-update chains stage
-- their field values before that transfer so the intermediate record
-- allocations can be removed without exposing partial mutation. Branch
-- updates transfer the owner only when every path independently qualifies.
-- Every other update recovers the existing fresh-construction form.
import:
	ir:
		CoreConstructorLiteralMatch,
		CoreConstructorMatchBody(
			ConstructorMatchBodyExpr,
			ConstructorMatchBodyLength,
			ConstructorMatchBodyLiteral,
		),
		CoreConstructorMatchCase,
		CoreConstructorMatchFallback(
			ConstructorMatchFallbackBindings,
			ConstructorMatchFallbackBody,
			ConstructorMatchFallbackFail,
		),
		CoreDecl(FunctionDecl, GlobalDecl, HeapRecordDecl, ImplDecl),
		CoreExpr(
			AssignExpr,
			ConstructorMatchExpr,
			DropExpr,
			FieldExpr,
			IfExpr,
			LetExpr,
			LogicalExpr,
			RecordExpr,
			RecordCowUpdateExpr,
			RecordReuseExpr,
			RecordUpdateExpr,
			SeqExpr,
			VarExpr,
			LiteralMatchExpr,
		),
		CoreFunction,
		CoreHeapRecordDecl,
		CoreHeapRecordField,
		CoreLiteralMatchCase,
		CoreLiteralMatchFallback(
			LiteralMatchFallbackBindings,
			LiteralMatchFallbackBody,
			LiteralMatchFallbackFail,
		),
		CoreLogicalOp,
		CoreProgram,
		CoreRecordCowField,
		CoreRecordFieldValue,
		CoreReleasePolicy(ArcReleasePolicy),
		CoreSourceLoc,
		CoreType(HeapRecordType),
		CoreVar,
		core_expr_type,
		core_type_equal,
		core_var_equal,
	traverse as CoreTraverse


private COMPILER_LOCAL_PREFIX: String = "$blorp$record_update$"


record RecordUpdateLayer {
	base: CoreVar,
	binding_type: CoreType,
	fields: List[CoreRecordFieldValue],
	result_type: CoreType,
	loc: CoreSourceLoc
}


record RecordUpdateChain {
	source: CoreVar,
	source_type: CoreType,
	source_loc: CoreSourceLoc,
	layers: List[RecordUpdateLayer]
}


record RecordFieldEvaluation {
	variable: CoreVar,
	typ: CoreType,
	rhs: CoreExpr
}


record StagedRecordLayer {
	evaluations: List[RecordFieldEvaluation],
	fields: List[CoreRecordCowField]
}


record RecordCowFieldPlan {
	fields: List[CoreRecordCowField],
	replacement_count: Int
}


private union StagedFieldResolution:
	InheritedStagedField
	CarriedReplacementStagedField(CoreExpr)
	ReplacementStagedField(CoreExpr)
	InvalidStagedField


private union RecordUpdateLogicalTask:
	PrepareRecordUpdateLogicalNode(CoreExpr)
	RebuildPreparedRecordUpdateLogicalNode(CoreLogicalOp, CoreType, CoreSourceLoc)


private pure func same_heap_record_type(left: CoreType, right: CoreType) -> Bool:
	match (left, right):
		(HeapRecordType(left_name), HeapRecordType(right_name)):
			left_name == right_name
		_:
			False


private pure func replace_var(expr: CoreExpr, source: CoreVar, replacement: CoreVar) -> CoreExpr:
	match expr:
		SeqExpr(_, _):
			CoreTraverse.map_core_sequence_items(
				expr,
				func(item): replace_var(item, source, replacement),
			)
		_:
			mapped: CoreExpr = CoreTraverse.map_core_expr_children(
				expr,
				func(child): replace_var(child, source, replacement),
			)

			match mapped:
				VarExpr(variable, typ, loc):
					if core_var_equal(variable, source):
						VarExpr(replacement, typ, loc)
					else:
						mapped
				_:
					mapped


private pure func expr_assigns_var(expr: CoreExpr, target: CoreVar) -> Bool:
	match expr:
		AssignExpr(variable, _, _, _):
			if core_var_equal(variable, target):
				True
			else:
				CoreTraverse
					.immediate_core_expr_children(expr)
					.any(func(child): expr_assigns_var(child, target))
		SeqExpr(_, _):
			spine = CoreTraverse.split_core_sequence(expr)

			(
				spine.preceding_items.any(func(item): expr_assigns_var(item, target))
				or expr_assigns_var(spine.final_item, target)
			)
		_:
			CoreTraverse
				.immediate_core_expr_children(expr)
				.any(func(child): expr_assigns_var(child, target))


private pure func record_fields_assign_var(
	fields: List[CoreRecordFieldValue],
	target: CoreVar,
) -> Bool:
	fields.any(func(field): expr_assigns_var(field.value, target))


private pure func expr_touches_var(expr: CoreExpr, target: CoreVar) -> Bool:
	match expr:
		VarExpr(variable, typ, loc):
			core_var_equal(variable, target)
		SeqExpr(_, _):
			spine = CoreTraverse.split_core_sequence(expr)

			(
				spine.preceding_items.any(func(item): expr_touches_var(item, target))
				or expr_touches_var(spine.final_item, target)
			)
		_:
			CoreTraverse
				.immediate_core_expr_children(expr)
				.any(func(child): expr_touches_var(child, target))


private pure func declared_heap_record_decls(
	decls: List[CoreDecl],
) -> Dict[String, CoreHeapRecordDecl]:
	var records: Dict[String, CoreHeapRecordDecl] = {}

	for decl in decls:
		match decl:
			HeapRecordDecl(record_decl):
				records = records.set(record_decl.name, record_decl)
			_:
				void

	records


private pure func declared_heap_record_type(
	record_decls: Dict[String, CoreHeapRecordDecl],
	typ: CoreType,
) -> Bool:
	match typ:
		HeapRecordType(name):
			record_decls.contains(name)
		_:
			False


private pure func heap_record_decl_for_type(
	record_decls: Dict[String, CoreHeapRecordDecl],
	typ: CoreType,
) -> Option[CoreHeapRecordDecl]:
	match typ:
		HeapRecordType(name):
			record_decls.get(name)
		_:
			None


private pure func record_cow_field_plan(
	record_decl: CoreHeapRecordDecl,
	base: CoreVar,
	base_type: CoreType,
	original_fields: List[CoreRecordFieldValue],
	prepared_fields: List[CoreRecordFieldValue],
) -> Option[RecordCowFieldPlan]:
	if (
		original_fields.length() != record_decl.fields.length()
		or prepared_fields.length() != record_decl.fields.length()
	):
		None
	else:
		var cow_fields: List[CoreRecordCowField] = []
		var replacement_count: Int = 0
		var valid: Bool = True
		var index: Int = 0

		while valid and index < record_decl.fields.length():
			match (
				record_decl.fields.get(index),
				original_fields.get(index),
				prepared_fields.get(index),
			):
				(Some(field), Some(original), Some(prepared)):
					if field.name != original.name or field.name != prepared.name:
						valid = False
					else if (
						not core_type_equal(core_expr_type(original.value), field.typ)
						or not core_type_equal(core_expr_type(prepared.value), field.typ)
					):
						valid = False
					else if (
						record_field_references_itself(original, base)
						and not inherited_record_field(original, base, base_type, field)
					):
						valid = False
					else if inherited_record_field(original, base, base_type, field):
						cow_fields = cow_fields.append({
							field = field,
							replacement = None,
						})
					else:
						replacement_count += 1
						cow_fields = cow_fields.append({
							field = field,
							replacement = Some(prepared.value),
						})
				_:
					valid = False

			index += 1

		if valid:
			Some({
				fields = cow_fields,
				replacement_count = replacement_count,
			})
		else:
			None


private pure func prepared_record_reuse_expr(
	source: CoreExpr,
	complete_fields: List[CoreRecordFieldValue],
	cow_plan: RecordCowFieldPlan,
	typ: CoreType,
	loc: CoreSourceLoc,
) -> CoreExpr:
	if cow_plan.replacement_count == 0:
		source
	else if cow_plan.replacement_count == cow_plan.fields.length():
		RecordReuseExpr(source, complete_fields, typ, loc)
	else:
		RecordCowUpdateExpr(source, cow_plan.fields, typ, loc)


private pure func complete_record_cow_fields(
	fields: List[CoreRecordCowField],
) -> Option[List[CoreRecordFieldValue]]:
	var complete: List[CoreRecordFieldValue] = []
	var valid: Bool = True

	for field in fields:
		match field.replacement:
			Some(replacement):
				complete = complete.append({
					name = field.field.name,
					value = replacement,
				})
			None:
				valid = False
				break

	if valid:
		Some(complete)
	else:
		None


private pure func prepared_nested_record_expr(
	source: CoreExpr,
	fields: List[CoreRecordCowField],
	typ: CoreType,
	loc: CoreSourceLoc,
) -> Option[CoreExpr]:
	replacement_count: Int = fields.count(pure func(field) -> Bool:
		match field.replacement:
			Some(_):
				True
			None:
				False
	)

	if replacement_count == 0:
		Some(source)
	else if replacement_count == fields.length():
		complete_record_cow_fields(
			fields,
		).map(
			pure func(complete): RecordReuseExpr(source, complete, typ, loc),
		)
	else:
		Some(RecordCowUpdateExpr(source, fields, typ, loc))


private pure func materialize_record_update(expr: CoreExpr) -> CoreExpr:
	match expr:
		RecordUpdateExpr(base, fields, typ, loc):
			RecordExpr(fields, typ, loc)
		_:
			expr


private pure func materialize_mapped_record_update(
	record_decls: Dict[String, CoreHeapRecordDecl],
	expr: CoreExpr,
) -> CoreExpr:
	materialize_record_update(CoreTraverse.map_core_expr_children(
			expr,
			func(child): prepare_record_update_expr(record_decls, child),
		))


private pure func record_update_chain(expr: CoreExpr) -> Option[RecordUpdateChain]:
	match expr:
		LetExpr(base, False, binding_type, initial, body):
			match body:
				RecordUpdateExpr(carrier, fields, result_type, loc):
					match carrier:
						VarExpr(carrier_base, carrier_type, _):
							if (
								core_var_equal(base, carrier_base)
								and same_heap_record_type(binding_type, carrier_type)
								and same_heap_record_type(binding_type, result_type)
							):
								layer: RecordUpdateLayer = {
									base = base,
									binding_type = binding_type,
									fields = fields,
									result_type = result_type,
									loc = loc
								}

								match initial:
									VarExpr(source, source_type, source_loc):
										if same_heap_record_type(source_type, binding_type):
											Some({
												source = source,
												source_type = source_type,
												source_loc = source_loc,
												layers = [layer],
											})
										else:
											None
									_:
										match record_update_chain(initial):
											Some(chain):
												match chain.layers.last():
													Some(previous_layer):
														if same_heap_record_type(
															previous_layer.result_type,
															binding_type,
														):
															Some(
																{ chain |
																	layers = chain.layers.append(
																		layer,
																	)
																},
															)
														else:
															None
													None:
														None
											None:
												None
							else:
								None
						_:
							None
				_:
					None
		_:
			None


private pure func chain_uses_declared_heap_record(
	record_decls: Dict[String, CoreHeapRecordDecl],
	chain: RecordUpdateChain,
) -> Bool:
	(
		declared_heap_record_type(record_decls, chain.source_type)
		and chain.layers.all(
			func(
				layer,
			): (
				same_heap_record_type(chain.source_type, layer.binding_type)
				and same_heap_record_type(chain.source_type, layer.result_type)
			),
		)
	)


private pure func record_field_references_itself(
	field: CoreRecordFieldValue,
	base: CoreVar,
) -> Bool:
	match field.value:
		FieldExpr(VarExpr(variable, owner_type, owner_loc), projected_field, field_type, field_loc):
			core_var_equal(variable, base) and projected_field == field.name
		_:
			False


private pure func inherited_record_field(
	field: CoreRecordFieldValue,
	base: CoreVar,
	base_type: CoreType,
	declared_field: CoreHeapRecordField,
) -> Bool:
	match field.value:
		FieldExpr(VarExpr(variable, owner_type, owner_loc), projected_field, field_type, field_loc):
			(
				core_var_equal(variable, base)
				and projected_field == field.name
				and field.name == declared_field.name
				and core_type_equal(owner_type, base_type)
				and core_type_equal(field_type, declared_field.typ)
			)
		_:
			False


private pure func staged_field_variable(base: CoreVar, field_index: Int) -> CoreVar:
	{
		name = COMPILER_LOCAL_PREFIX + "field$" + base.name + "$" + base.uniq.to_string() + "$" + field_index.to_string(),
		uniq = base.uniq,
		def_id = None
	}


private pure func staged_field_with_value(
	layer: RecordUpdateLayer,
	field: CoreHeapRecordField,
	field_index: Int,
	value: CoreExpr,
) -> StagedRecordLayer:
	field_type: CoreType = core_expr_type(value)
	variable: CoreVar = staged_field_variable(layer.base, field_index)
	{
		evaluations = [
			{
				variable = variable,
				typ = field_type,
				rhs = value
			},
		],
		fields = [
			{
				field = field,
				replacement = Some(VarExpr(variable, field_type, layer.loc))
			},
		]
	}


private pure func previous_staged_field(
	fields: List[CoreRecordCowField],
	name: String,
) -> Option[CoreRecordCowField]:
	fields.find(func(field): field.field.name == name)


private pure func resolve_staged_field(
	record_decls: Dict[String, CoreHeapRecordDecl],
	target: CoreVar,
	layer: RecordUpdateLayer,
	previous_fields: Option[List[CoreRecordCowField]],
	field: CoreRecordFieldValue,
	declared_field: CoreHeapRecordField,
) -> StagedFieldResolution:
	if not core_type_equal(core_expr_type(field.value), declared_field.typ):
		InvalidStagedField
	else if (
		record_field_references_itself(field, layer.base)
		and not inherited_record_field(field, layer.base, layer.binding_type, declared_field)
	):
		InvalidStagedField
	else:
		resolve_typed_staged_field(
			record_decls,
			target,
			layer,
			previous_fields,
			field,
			declared_field,
		)


private pure func resolve_typed_staged_field(
	record_decls: Dict[String, CoreHeapRecordDecl],
	target: CoreVar,
	layer: RecordUpdateLayer,
	previous_fields: Option[List[CoreRecordCowField]],
	field: CoreRecordFieldValue,
	declared_field: CoreHeapRecordField,
) -> StagedFieldResolution:
	match previous_fields:
		None:
			if inherited_record_field(field, layer.base, layer.binding_type, declared_field):
				InheritedStagedField
			else:
				ReplacementStagedField(
					replace_var(
						prepare_record_update_expr(record_decls, field.value),
						layer.base,
						target,
					),
				)
		Some(fields):
			if inherited_record_field(field, layer.base, layer.binding_type, declared_field):
				match previous_staged_field(fields, field.name):
					Some(previous):
						match previous.replacement:
							Some(replacement):
								CarriedReplacementStagedField(replacement)
							None:
								InheritedStagedField
					None:
						InvalidStagedField
			else:
				prepared: CoreExpr = prepare_record_update_expr(record_decls, field.value)

				if expr_touches_var(prepared, layer.base):
					InvalidStagedField
				else:
					ReplacementStagedField(prepared)


private pure func stage_record_layer(
	record_decls: Dict[String, CoreHeapRecordDecl],
	target: CoreVar,
	record_decl: CoreHeapRecordDecl,
	layer: RecordUpdateLayer,
	previous_fields: Option[List[CoreRecordCowField]],
) -> Option[StagedRecordLayer]:
	var evaluations: List[RecordFieldEvaluation] = []
	var staged_fields: List[CoreRecordCowField] = []
	var failed: Bool = False
	var field_index: Int = 0

	for field in layer.fields:
		match record_decl.fields.get(field_index):
			Some(declared_field):
				if declared_field.name != field.name:
					failed = True
					break
				else:
					match resolve_staged_field(
						record_decls,
						target,
						layer,
						previous_fields,
						field,
						declared_field,
					):
						ReplacementStagedField(value):
							staged: StagedRecordLayer = staged_field_with_value(
								layer,
								declared_field,
								field_index,
								value,
							)
							evaluations = evaluations.concat(staged.evaluations)
							staged_fields = staged_fields.concat(staged.fields)
						CarriedReplacementStagedField(value):
							staged_fields = staged_fields.append({
								field = declared_field,
								replacement = Some(value),
							})
						InheritedStagedField:
							staged_fields = staged_fields.append({
								field = declared_field,
								replacement = None,
							})
						InvalidStagedField:
							failed = True
							break
			None:
				failed = True
				break

		field_index += 1

	if failed or field_index != record_decl.fields.length():
		None
	else:
		Some({
			evaluations = evaluations,
			fields = staged_fields,
		})


private pure func wrap_record_field_evaluations(
	evaluations: List[RecordFieldEvaluation],
	body: CoreExpr,
) -> CoreExpr:
	var wrapped: CoreExpr = body

	for evaluation in evaluations.reverse():
		wrapped = LetExpr(evaluation.variable, False, evaluation.typ, evaluation.rhs, wrapped)

	wrapped


private pure func prepare_nested_record_reuse_value(
	record_decls: Dict[String, CoreHeapRecordDecl],
	target: CoreVar,
	rhs: CoreExpr,
) -> Option[CoreExpr]:
	match record_update_chain(rhs):
		Some(chain):
			if (
				chain.layers.length() > 1
				and core_var_equal(target, chain.source)
				and chain_uses_declared_heap_record(record_decls, chain)
				and not chain.layers.any(
					func(layer): record_fields_assign_var(layer.fields, target),
				)
			):
				match heap_record_decl_for_type(record_decls, chain.source_type):
					Some(record_decl):
						var evaluations: List[RecordFieldEvaluation] = []
						var previous_fields: Option[List[CoreRecordCowField]] = None
						var final_type: CoreType = chain.source_type
						var final_loc: CoreSourceLoc = chain.source_loc
						var failed: Bool = False

						for layer in chain.layers:
							match stage_record_layer(
								record_decls,
								target,
								record_decl,
								layer,
								previous_fields,
							):
								Some(staged):
									evaluations = evaluations.concat(staged.evaluations)
									previous_fields = Some(staged.fields)
									final_type = layer.result_type
									final_loc = layer.loc
								None:
									failed = True
									break

						if failed:
							None
						else:
							match previous_fields:
								Some(fields):
									match prepared_nested_record_expr(
										VarExpr(target, chain.source_type, chain.source_loc),
										fields,
										final_type,
										final_loc,
									):
										Some(reuse):
											Some(wrap_record_field_evaluations(evaluations, reuse))
										None:
											None
								None:
									None
					None:
						None
			else:
				None
		None:
			None


private pure func prepare_canonical_record_reuse_value(
	record_decls: Dict[String, CoreHeapRecordDecl],
	target: CoreVar,
	update_base: CoreVar,
	binding_type: CoreType,
	source: CoreVar,
	source_type: CoreType,
	source_loc: CoreSourceLoc,
	body: CoreExpr,
) -> Option[CoreExpr]:
	match body:
		RecordUpdateExpr(base, fields, result_type, update_loc):
			match base:
				VarExpr(carrier_base, carrier_base_type, _):
					if (
						core_var_equal(target, source)
						and core_var_equal(update_base, carrier_base)
						and same_heap_record_type(binding_type, source_type)
						and same_heap_record_type(binding_type, carrier_base_type)
						and same_heap_record_type(binding_type, result_type)
						and declared_heap_record_type(record_decls, result_type)
						and not record_fields_assign_var(fields, target)
					):
						prepared_fields: List[CoreRecordFieldValue] = fields.map(
							func(
								field,
							): { field |
								value = prepare_record_update_expr(record_decls, field.value)
							},
						)
						reused_fields: List[CoreRecordFieldValue] = prepared_fields.map(
							func(
								field,
							): { field | value = replace_var(field.value, update_base, target) },
						)

						match heap_record_decl_for_type(record_decls, result_type):
							Some(record_decl):
								match record_cow_field_plan(
									record_decl,
									update_base,
									result_type,
									fields,
									reused_fields,
								):
									Some(cow_plan):
										Some(
											prepared_record_reuse_expr(
												VarExpr(target, source_type, source_loc),
												reused_fields,
												cow_plan,
												result_type,
												update_loc,
											),
										)
									None:
										None
							None:
								None
					else:
						None
				_:
					None
		_:
			None


private pure func prepare_typed_record_reuse_value(
	record_decls: Dict[String, CoreHeapRecordDecl],
	target: CoreVar,
	expected_type: CoreType,
	result: CoreExpr,
) -> Option[CoreExpr]:
	match prepare_record_reuse_value(record_decls, target, result):
		Some(prepared):
			if same_heap_record_type(expected_type, core_expr_type(prepared)):
				Some(prepared)
			else:
				None
		None:
			None


private pure func prepare_constructor_match_body_reuse(
	record_decls: Dict[String, CoreHeapRecordDecl],
	target: CoreVar,
	expected_type: CoreType,
	body: CoreConstructorMatchBody,
) -> Option[CoreConstructorMatchBody]:
	match body:
		ConstructorMatchBodyExpr(result):
			prepare_typed_record_reuse_value(
				record_decls,
				target,
				expected_type,
				result,
			).map(
				func(prepared): ConstructorMatchBodyExpr(prepared),
			)
		ConstructorMatchBodyLiteral(match_expr):
			if same_heap_record_type(expected_type, match_expr.result_type):
				prepare_constructor_literal_match_reuse(
					record_decls,
					target,
					match_expr,
				).map(
					func(prepared): ConstructorMatchBodyLiteral(prepared),
				)
			else:
				None
		ConstructorMatchBodyLength(_):
			None


private pure func prepare_constructor_match_cases_reuse(
	record_decls: Dict[String, CoreHeapRecordDecl],
	target: CoreVar,
	expected_type: CoreType,
	cases: List[CoreConstructorMatchCase],
) -> Option[List[CoreConstructorMatchCase]]:
	var prepared_cases: List[CoreConstructorMatchCase] = []
	var failed: Bool = False

	for match_case in cases:
		match prepare_constructor_match_body_reuse(
			record_decls,
			target,
			expected_type,
			match_case.body,
		):
			Some(body):
				prepared_cases = prepared_cases.append({ match_case | body = body })
			None:
				failed = True
				break

	if failed:
		None
	else:
		Some(prepared_cases)


private pure func prepare_constructor_match_fallback_reuse(
	record_decls: Dict[String, CoreHeapRecordDecl],
	target: CoreVar,
	expected_type: CoreType,
	fallback: CoreConstructorMatchFallback,
) -> Option[CoreConstructorMatchFallback]:
	match fallback:
		ConstructorMatchFallbackBody(body):
			prepare_typed_record_reuse_value(
				record_decls,
				target,
				expected_type,
				body,
			).map(
				func(prepared): ConstructorMatchFallbackBody(prepared),
			)
		ConstructorMatchFallbackBindings(bindings, body):
			prepare_typed_record_reuse_value(
				record_decls,
				target,
				expected_type,
				body,
			).map(
				func(prepared): ConstructorMatchFallbackBindings(bindings, prepared),
			)
		ConstructorMatchFallbackFail:
			Some(ConstructorMatchFallbackFail)


private pure func prepare_constructor_match_reuse_value(
	record_decls: Dict[String, CoreHeapRecordDecl],
	target: CoreVar,
	scrutinee: CoreExpr,
	release_policy: CoreReleasePolicy,
	cases: List[CoreConstructorMatchCase],
	fallback: CoreConstructorMatchFallback,
	typ: CoreType,
	loc: CoreSourceLoc,
) -> Option[CoreExpr]:
	if expr_touches_var(scrutinee, target):
		None
	else:
		match (
			prepare_constructor_match_cases_reuse(record_decls, target, typ, cases),
			prepare_constructor_match_fallback_reuse(record_decls, target, typ, fallback),
		):
			(Some(prepared_cases), Some(prepared_fallback)):
				Some(
					ConstructorMatchExpr(
						prepare_record_update_expr(record_decls, scrutinee),
						release_policy,
						prepared_cases,
						prepared_fallback,
						typ,
						loc,
					),
				)
			_:
				None


private pure func prepare_literal_match_cases_reuse(
	record_decls: Dict[String, CoreHeapRecordDecl],
	target: CoreVar,
	expected_type: CoreType,
	cases: List[CoreLiteralMatchCase],
) -> Option[List[CoreLiteralMatchCase]]:
	var prepared_cases: List[CoreLiteralMatchCase] = []
	var failed: Bool = False

	for match_case in cases:
		match prepare_typed_record_reuse_value(
			record_decls,
			target,
			expected_type,
			match_case.body,
		):
			Some(body):
				prepared_cases = prepared_cases.append({ match_case | body = body })
			None:
				failed = True
				break

	if failed:
		None
	else:
		Some(prepared_cases)


private pure func prepare_literal_match_fallback_reuse(
	record_decls: Dict[String, CoreHeapRecordDecl],
	target: CoreVar,
	expected_type: CoreType,
	fallback: CoreLiteralMatchFallback,
) -> Option[CoreLiteralMatchFallback]:
	match fallback:
		LiteralMatchFallbackBody(body):
			prepare_typed_record_reuse_value(
				record_decls,
				target,
				expected_type,
				body,
			).map(
				func(prepared): LiteralMatchFallbackBody(prepared),
			)
		LiteralMatchFallbackBindings(bindings, body):
			prepare_typed_record_reuse_value(
				record_decls,
				target,
				expected_type,
				body,
			).map(
				func(prepared): LiteralMatchFallbackBindings(bindings, prepared),
			)
		LiteralMatchFallbackFail:
			Some(LiteralMatchFallbackFail)


private pure func prepare_constructor_literal_match_reuse(
	record_decls: Dict[String, CoreHeapRecordDecl],
	target: CoreVar,
	match_expr: CoreConstructorLiteralMatch,
) -> Option[CoreConstructorLiteralMatch]:
	match (
		prepare_literal_match_cases_reuse(
			record_decls,
			target,
			match_expr.result_type,
			match_expr.cases,
		),
		prepare_literal_match_fallback_reuse(
			record_decls,
			target,
			match_expr.result_type,
			match_expr.fallback,
		),
	):
		(Some(prepared_cases), Some(prepared_fallback)):
			Some({ match_expr |
					cases = prepared_cases,
					fallback = prepared_fallback
				})
		_:
			None


private pure func prepare_literal_match_reuse_value(
	record_decls: Dict[String, CoreHeapRecordDecl],
	target: CoreVar,
	scrutinee: CoreExpr,
	cases: List[CoreLiteralMatchCase],
	fallback: CoreLiteralMatchFallback,
	typ: CoreType,
	loc: CoreSourceLoc,
) -> Option[CoreExpr]:
	if expr_touches_var(scrutinee, target):
		None
	else:
		match (
			prepare_literal_match_cases_reuse(record_decls, target, typ, cases),
			prepare_literal_match_fallback_reuse(record_decls, target, typ, fallback),
		):
			(Some(prepared_cases), Some(prepared_fallback)):
				Some(
					LiteralMatchExpr(
						prepare_record_update_expr(record_decls, scrutinee),
						prepared_cases,
						prepared_fallback,
						typ,
						loc,
					),
				)
			_:
				None


private pure func prepare_immutable_let_reuse_value(
	record_decls: Dict[String, CoreHeapRecordDecl],
	target: CoreVar,
	variable: CoreVar,
	binding_type: CoreType,
	initial: CoreExpr,
	body: CoreExpr,
) -> Option[CoreExpr]:
	canonical: Option[CoreExpr] = match initial:
		VarExpr(source, source_type, source_loc):
			prepare_canonical_record_reuse_value(
				record_decls,
				target,
				variable,
				binding_type,
				source,
				source_type,
				source_loc,
				body,
			)
		_:
			None

	match canonical:
		Some(prepared):
			Some(prepared)
		None:
			if core_var_equal(variable, target) or expr_touches_var(initial, target):
				None
			else:
				prepare_record_reuse_value(
					record_decls,
					target,
					body,
				).map(
					func(prepared_body): LetExpr(
						variable,
						False,
						binding_type,
						prepare_record_update_expr(record_decls, initial),
						prepared_body,
					),
				)


private pure func prepare_record_reuse_value(
	record_decls: Dict[String, CoreHeapRecordDecl],
	target: CoreVar,
	rhs: CoreExpr,
) -> Option[CoreExpr]:
	match rhs:
		IfExpr(cond, then_expr, else_expr, typ, loc):
			if expr_assigns_var(cond, target):
				None
			else:
				match (
					prepare_record_reuse_value(record_decls, target, then_expr),
					prepare_record_reuse_value(record_decls, target, else_expr),
				):
					(Some(prepared_then), Some(prepared_else)):
						if (
							same_heap_record_type(typ, core_expr_type(prepared_then))
							and same_heap_record_type(typ, core_expr_type(prepared_else))
						):
							Some(
								IfExpr(
									prepare_record_update_expr(record_decls, cond),
									prepared_then,
									prepared_else,
									typ,
									loc,
								),
							)
						else:
							None
					_:
						None
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			prepare_constructor_match_reuse_value(
				record_decls,
				target,
				scrutinee,
				release_policy,
				cases,
				fallback,
				typ,
				loc,
			)
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			prepare_literal_match_reuse_value(
				record_decls,
				target,
				scrutinee,
				cases,
				fallback,
				typ,
				loc,
			)
		_:
			match prepare_nested_record_reuse_value(record_decls, target, rhs):
				Some(prepared):
					Some(prepared)
				None:
					match rhs:
						LetExpr(update_base, False, binding_type, initial, body):
							prepare_immutable_let_reuse_value(
								record_decls,
								target,
								update_base,
								binding_type,
								initial,
								body,
							)
						_:
							None


private pure func prepare_consumed_record_result(
	record_decls: Dict[String, CoreHeapRecordDecl],
	result: CoreVar,
	result_type: CoreType,
	rhs: CoreExpr,
	body: CoreExpr,
) -> Option[CoreExpr]:
	match body:
		DropExpr(owner, owner_type, release_policy, drop_body, drop_result_type, drop_loc):
			if release_policy != ArcReleasePolicy:
				None
			else:
				match drop_body:
					VarExpr(returned, returned_type, return_loc):
						if (
							core_var_equal(result, returned)
							and not core_var_equal(result, owner)
							and same_heap_record_type(result_type, returned_type)
							and same_heap_record_type(result_type, owner_type)
							and same_heap_record_type(result_type, drop_result_type)
						):
							prepare_typed_record_reuse_value(record_decls, owner, result_type, rhs)
						else:
							None
					_:
						None
		_:
			None


private pure func prepare_record_update_expr(
	record_decls: Dict[String, CoreHeapRecordDecl],
	expr: CoreExpr,
) -> CoreExpr:
	match expr:
		SeqExpr(_, _):
			CoreTraverse.map_core_sequence_items(
				expr,
				func(item): prepare_record_update_expr(record_decls, item),
			)
		AssignExpr(target, rhs, typ, loc):
			match prepare_record_reuse_value(record_decls, target, rhs):
				Some(prepared_rhs):
					AssignExpr(target, prepared_rhs, typ, loc)
				None:
					materialize_mapped_record_update(record_decls, expr)
		LetExpr(result, False, result_type, rhs, body):
			match prepare_consumed_record_result(record_decls, result, result_type, rhs, body):
				Some(prepared):
					prepared
				None:
					materialize_mapped_record_update(record_decls, expr)
		LogicalExpr(_, _, _, _, _):
			prepare_record_update_logical_expr(record_decls, expr)
		_:
			materialize_mapped_record_update(record_decls, expr)


private pure func prepare_record_update_logical_expr(
	record_decls: Dict[String, CoreHeapRecordDecl],
	expr: CoreExpr,
) -> CoreExpr:
	var tasks: List[RecordUpdateLogicalTask] = [PrepareRecordUpdateLogicalNode(expr)]
	var task_count: Int = 1
	var prepared: List[CoreExpr] = []
	var prepared_count: Int = 0
	var valid: Bool = True

	while valid and task_count > 0:
		task_count -= 1

		match tasks.get(task_count):
			Some(task):
				match task:
					PrepareRecordUpdateLogicalNode(current_expr):
						match current_expr:
							LogicalExpr(op, left, right, typ, loc):
								rebuild_task: RecordUpdateLogicalTask = RebuildPreparedRecordUpdateLogicalNode(
									op,
									typ,
									loc,
								)

								tasks = if task_count < tasks.length():
									tasks.set(task_count, rebuild_task)
								else:
									tasks.append(rebuild_task)

								task_count += 1

								right_task: RecordUpdateLogicalTask = PrepareRecordUpdateLogicalNode(
									right,
								)

								tasks = if task_count < tasks.length():
									tasks.set(task_count, right_task)
								else:
									tasks.append(right_task)

								task_count += 1

								left_task: RecordUpdateLogicalTask = PrepareRecordUpdateLogicalNode(
									left,
								)

								tasks = if task_count < tasks.length():
									tasks.set(task_count, left_task)
								else:
									tasks.append(left_task)

								task_count += 1
							_:
								prepared_expr: CoreExpr = prepare_record_update_expr(
									record_decls,
									current_expr,
								)

								prepared = if prepared_count < prepared.length():
									prepared.set(prepared_count, prepared_expr)
								else:
									prepared.append(prepared_expr)

								prepared_count += 1
					RebuildPreparedRecordUpdateLogicalNode(op, typ, loc):
						match (prepared.get(prepared_count - 2), prepared.get(prepared_count - 1)):
							(Some(left), Some(right)):
								prepared = prepared.set(
									prepared_count - 2,
									LogicalExpr(op, left, right, typ, loc),
								)
								prepared_count -= 1
							_:
								valid = False
			None:
				valid = False

	if valid and prepared_count == 1:
		prepared.get_or(0, expr)
	else:
		expr


private pure func lower_record_update_function(
	record_decls: Dict[String, CoreHeapRecordDecl],
	function_info: CoreFunction,
) -> CoreFunction:
	body: Option[CoreExpr] = match function_info.body:
		Some(expr):
			Some(prepare_record_update_expr(record_decls, expr))
		None:
			None

	{ function_info | body = body }


private pure func lower_record_update_decl(
	record_decls: Dict[String, CoreHeapRecordDecl],
	decl: CoreDecl,
) -> CoreDecl:
	match decl:
		FunctionDecl(function_info):
			FunctionDecl(lower_record_update_function(record_decls, function_info))
		GlobalDecl(global):
			GlobalDecl({ global | init = prepare_record_update_expr(record_decls, global.init) })
		ImplDecl(impl):
			ImplDecl(
				{ impl |
					methods = impl.methods.map(
						func(method): lower_record_update_function(record_decls, method),
					)
				},
			)
		_:
			decl


pure func lower_record_updates_for_ownership(program: CoreProgram) -> CoreProgram:
	record_decls: Dict[String, CoreHeapRecordDecl] = declared_heap_record_decls(program.decls)
	{ program |
		decls = program.decls.map(func(decl): lower_record_update_decl(record_decls, decl))
	}


private pure func expr_contains_record_update(expr: CoreExpr) -> Bool:
	match expr:
		RecordUpdateExpr(_, _, _, _):
			True
		SeqExpr(_, _):
			spine = CoreTraverse.split_core_sequence(expr)

			(
				spine.preceding_items.any(expr_contains_record_update)
				or expr_contains_record_update(spine.final_item)
			)
		_:
			CoreTraverse
				.immediate_core_expr_children(expr)
				.any(expr_contains_record_update)


private pure func function_contains_record_update(function_info: CoreFunction) -> Bool:
	match function_info.body:
		Some(body):
			expr_contains_record_update(body)
		None:
			False


private pure func decl_contains_record_update(decl: CoreDecl) -> Bool:
	match decl:
		FunctionDecl(function_info):
			function_contains_record_update(function_info)
		GlobalDecl(global):
			expr_contains_record_update(global.init)
		ImplDecl(impl):
			impl.methods.any(function_contains_record_update)
		_:
			False


pure func record_update_carrier_survives(program: CoreProgram) -> Bool:
	program.decls.any(decl_contains_record_update)
