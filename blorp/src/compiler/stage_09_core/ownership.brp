			)
		"set_alloc_entry":
			fixed_contract(arity, [TransferArg], ReturnOwned)
		"set_set_bucket":
			borrowed_contract(arity, 3, ReturnVoid)
		"set_entry_set_next":
			borrowed_contract(arity, 2, ReturnVoid)
		"set_entry_set_prev_order":
			borrowed_contract(arity, 2, ReturnVoid)
		"set_entry_set_next_order":
			borrowed_contract(arity, 2, ReturnVoid)
		"set_set_first":
			borrowed_contract(arity, 2, ReturnVoid)
		"set_set_last":
			borrowed_contract(arity, 2, ReturnVoid)
		"set_set_len":
			borrowed_contract(arity, 2, ReturnVoid)
		"set_resize":
			borrowed_contract(arity, 2, ReturnVoid)
		"set_reserve_for_len":
