	"blorp_matrix_checked_set",
	"blorp_matrix_set_opt",
	"blorp_matrix_set_opt_nullable",
]


pure func runtime_builtin_uses_erased_argument(name: String, index: Int) -> Bool:
	if index == 0:
		BUILTIN_ERASED_ARGUMENT_ZERO.contains(name)
	else if index == 1:
		BUILTIN_ERASED_ARGUMENT_ONE.contains(name)
	else if index == 2:
		BUILTIN_ERASED_ARGUMENT_TWO.contains(name)
	else if index == 3:
		BUILTIN_ERASED_ARGUMENT_THREE.contains(name)
	else if index == 4:
		name == "blorp_tensor3_checked_set"
	else if index == 5:
		name == "blorp_tensor4_checked_set"
	else if index == 6:
		name == "blorp_tensor5_checked_set"
	else:
		False


pure func runtime_builtin_has_erased_arguments(name: String) -> Bool:
	(
		BUILTIN_ERASED_ARGUMENT_ZERO.contains(name)
		or BUILTIN_ERASED_ARGUMENT_ONE.contains(name)
		or BUILTIN_ERASED_ARGUMENT_TWO.contains(name)
		or BUILTIN_ERASED_ARGUMENT_THREE.contains(name)
		or name == "blorp_tensor3_checked_set"
		or name == "blorp_tensor4_checked_set"
		or name == "blorp_tensor5_checked_set"
	)


private pure func builtin_name_in(names: List[String], name: String) -> Bool:
	names.any(func(candidate): candidate == name)


private pure func grouped_builtin_contract(
	name: String,
	arity: Int,
) -> Option[OwnershipCallContract]:
	if builtin_name_in(BUILTIN_NO_ARGS_OWNED, name):
		fixed_contract(arity, [], ReturnOwned)
	else if builtin_name_in(BUILTIN_NO_ARGS_PRIMITIVE, name):
		fixed_contract(arity, [], ReturnPrimitive)
	else if builtin_name_in(BUILTIN_NO_ARGS_VOID, name):
		fixed_contract(arity, [], ReturnVoid)
	else if builtin_name_in(BUILTIN_BORROW_ONE_OWNED, name):
		fixed_contract(arity, [BorrowArg], ReturnOwned)
	else if builtin_name_in(BUILTIN_BORROW_ONE_PRIMITIVE, name):
		fixed_contract(arity, [BorrowArg], ReturnPrimitive)
	else if builtin_name_in(BUILTIN_BORROW_ONE_VOID, name):
		fixed_contract(arity, [BorrowArg], ReturnVoid)
	else if builtin_name_in(BUILTIN_BORROW_TWO_OWNED, name):
		fixed_contract(
			arity,
			[BorrowArg, BorrowArg],
			ReturnOwned,
		)
	else if builtin_name_in(BUILTIN_BORROW_TWO_PRIMITIVE, name):
		fixed_contract(
			arity,
			[BorrowArg, BorrowArg],
			ReturnPrimitive,
		)
	else if builtin_name_in(BUILTIN_BORROW_THREE_OWNED, name):
		fixed_contract(
			arity,
			[BorrowArg, BorrowArg, BorrowArg],
			ReturnOwned,
		)
	else if builtin_name_in(BUILTIN_BORROW_THREE_PRIMITIVE, name):
		fixed_contract(
			arity,
			[BorrowArg, BorrowArg, BorrowArg],
			ReturnPrimitive,
		)
	else if builtin_name_in(BUILTIN_COW_BORROW_BORROW_OWNED, name):
		fixed_contract(
			arity,
			[CowConsumeArg, BorrowArg, BorrowArg],
			ReturnOwned,
		)
	else if builtin_name_in(BUILTIN_BORROW_COW_BORROW_OWNED, name):
		fixed_contract(
			arity,
			[BorrowArg, CowConsumeArg, BorrowArg],
			ReturnOwned,
		)
	else if builtin_name_in(BUILTIN_RETAIN_RETAIN_OWNED, name):
		fixed_contract(
			arity,
			[RetainArg, RetainArg],
			ReturnOwned,
		)
	else if builtin_name_in(BUILTIN_BORROW_FOUR_OWNED, name):
		fixed_contract(
			arity,
			[BorrowArg, BorrowArg, BorrowArg, BorrowArg],
			ReturnOwned,
		)
	else if builtin_name_in(BUILTIN_COW_BORROW_THREE_OWNED, name):
		fixed_contract(
			arity,
			[CowConsumeArg, BorrowArg, BorrowArg, BorrowArg],
			ReturnOwned,
		)
	else if (
		name == "blorp_option_some"
		or name == "blorp_result_ok"
		or name == "blorp_result_err"
	):
		fixed_contract(arity, [TransferArg], ReturnOwned)
	else if name == "blorp_stream_from_list" or name == "blorp_stream_enumerate":
		fixed_contract(arity, [RetainArg], ReturnOwned)
	else if name == "blorp_stream_for_each":
		fixed_contract(
			arity,
			[BorrowArg, BorrowArg],
			ReturnVoid,
		)
	else if name == "blorp_channel_try_send_attempt":
		fixed_contract(
			arity,
			[BorrowArg, RetainArg],
			ReturnOwned,
		)
	else if (
		name == "blorp_channel_send"
		or name == "blorp_channel_try_send"
		or name == "blorp_channel_try_send_status"
	):
		fixed_contract(
			arity,
			[BorrowArg, RetainArg],
			ReturnPrimitive,
		)
	else if name == "blorp_signal_on":
		fixed_contract(
			arity,
			[BorrowArg, RetainArg],
			ReturnVoid,
		)
	else if (
		name == "blorp_dict_remove"
		or name == "blorp_set_remove"
		or name == "blorp_string_append"
		or name == "blorp_string_append_int"
	):
		fixed_contract(
			arity,
			[CowConsumeArg, BorrowArg],
			ReturnOwned,
		)
	else if name == "blorp_set_add":
		fixed_contract(
			arity,
			[CowConsumeArg, RetainArg],
			ReturnOwned,
		)
	else if (
		name == "blorp_stream_repeat"
		or name == "blorp_stream_take"
		or name == "blorp_stream_drop"
		or name == "blorp_vector_new_fill"
		or name == "blorp_vector_new_fill_f64"
		or name == "blorp_vector_new_fill_f32"
	):
		fixed_contract(
			arity,
			[RetainArg, BorrowArg],
			ReturnOwned,
		)
	else if name == "blorp_vector_get_or":
		fixed_contract(
			arity,
			[BorrowArg, BorrowArg, BorrowArg],
			ReturnBorrowed,
		)
	else if name == "blorp_vector_set":
		fixed_contract(
			arity,
			[BorrowArg, BorrowArg, BorrowArg],
			ReturnVoid,
		)
	else if name == "blorp_channel_send_timeout_attempt":
		fixed_contract(
			arity,
			[BorrowArg, RetainArg, BorrowArg],
			ReturnOwned,
		)
	else if name == "blorp_channel_send_timeout" or name == "blorp_channel_send_timeout_status":
		fixed_contract(
			arity,
			[BorrowArg, RetainArg, BorrowArg],
			ReturnPrimitive,
		)
	else if name == "blorp_dict_insert":
		fixed_contract(
			arity,
			[CowConsumeArg, RetainArg, RetainArg],
			ReturnOwned,
		)
	else if (
		name == "blorp_matrix_new_fill"
		or name == "blorp_matrix_new_fill_f64"
		or name == "blorp_matrix_new_fill_f32"
	):
		fixed_contract(
			arity,
			[RetainArg, BorrowArg, BorrowArg],
			ReturnOwned,
		)
	else if name == "blorp_stream_map":
		fixed_contract(
			arity,
			[RetainArg, RetainArg, BorrowArg],
			ReturnOwned,
		)
	else if name == "blorp_vector_op_cow":
		fixed_contract(
			arity,
			[BorrowArg, BorrowArg, CowConsumeArg, BorrowArg],
			ReturnOwned,
		)
	else if name == "blorp_stream_unfold":
		fixed_contract(
			arity,
			[RetainArg, RetainArg, BorrowArg, BorrowArg],
			ReturnOwned,
		)
	else if name == "blorp_stream_fold" or name == "blorp_fallible_stream_fold_raw":
		fixed_contract(
			arity,
			[BorrowArg, ConsumeArg, BorrowArg, BorrowArg],
			ReturnOwned,
		)
	else if name == "blorp_time_from_parts":
		fixed_contract(
			arity,
			[BorrowArg, BorrowArg, BorrowArg, BorrowArg, BorrowArg, BorrowArg],
			ReturnPrimitive,
		)
	else:
		high_arity_builtin_contract(name, arity)


private pure func borrowed_args_contract(
	arity: Int,
	expected_arity: Int,
	result: OwnershipResultMode,
) -> Option[OwnershipCallContract]:
	if arity == expected_arity:
		fixed_contract(arity, borrow_all(expected_arity), result)
	else:
		None


private pure func high_arity_builtin_contract(
	name: String,
	arity: Int,
) -> Option[OwnershipCallContract]:
	if name == "blorp_checked_get":
		fixed_contract(
			arity,
			[BorrowArg, BorrowArg],
			ReturnAliasOfArg(0),
		)
	else if name == "blorp_checked_slice":
		borrowed_args_contract(arity, 3, ReturnOwned)
	else if name == "blorp_matrix_checked_get":
		fixed_contract(
			arity,
			[BorrowArg, BorrowArg, BorrowArg],
			ReturnAliasOfArg(0),
		)
	else if name == "blorp_tensor3_checked_get":
		fixed_contract(arity, borrow_all(4), ReturnAliasOfArg(0))
	else if name == "blorp_tensor4_checked_get":
		fixed_contract(arity, borrow_all(5), ReturnAliasOfArg(0))
	else if name == "blorp_tensor5_checked_get":
		fixed_contract(arity, borrow_all(6), ReturnAliasOfArg(0))
	else if name == "blorp_tensor3_checked_get_shape":
		fixed_contract(arity, borrow_all(7), ReturnAliasOfArg(0))
	else if name == "blorp_tensor4_checked_get_shape":
		fixed_contract(arity, borrow_all(9), ReturnAliasOfArg(0))
	else if name == "blorp_tensor5_checked_get_shape":
		fixed_contract(arity, borrow_all(11), ReturnAliasOfArg(0))
	else if (
		name == "blorp_tensor3_checked_get_shape_f64"
		or name == "blorp_tensor3_checked_get_shape_f32"
	):
		borrowed_args_contract(arity, 7, ReturnPrimitive)
	else if (
		name == "blorp_tensor4_checked_get_shape_f64"
		or name == "blorp_tensor4_checked_get_shape_f32"
	):
		borrowed_args_contract(arity, 9, ReturnPrimitive)
	else if (
		name == "blorp_tensor5_checked_get_shape_f64"
		or name == "blorp_tensor5_checked_get_shape_f32"
	):
		borrowed_args_contract(arity, 11, ReturnPrimitive)
	else if (
		name == "blorp_tensor_matrix_multiply_float"
		or name == "blorp_tensor_matrix_multiply_float16"
		or name == "blorp_tensor_matrix_multiply_float32"
		or name == "blorp_tensor_matrix_multiply_int"
	):
		borrowed_args_contract(arity, 5, ReturnOwned)
	else if name == "blorp_tensor3_checked_set":
		fixed_contract(
			arity,
			[CowConsumeArg, BorrowArg, BorrowArg, BorrowArg, BorrowArg],
			ReturnOwned,
		)
	else if name == "blorp_tensor4_checked_set":
		fixed_contract(
			arity,
			[CowConsumeArg, BorrowArg, BorrowArg, BorrowArg, BorrowArg, BorrowArg],
			ReturnOwned,
		)
	else if name == "blorp_tensor5_checked_set":
		fixed_contract(
			arity,
			[CowConsumeArg, BorrowArg, BorrowArg, BorrowArg, BorrowArg, BorrowArg, BorrowArg],
			ReturnOwned,
		)
	else if name == "blorp_tensor3_new":
		fixed_contract(
			arity,
			[RetainArg, BorrowArg, BorrowArg, BorrowArg],
			ReturnOwned,
		)
	else if name == "blorp_tensor4_new":
		fixed_contract(
			arity,
			[RetainArg, BorrowArg, BorrowArg, BorrowArg, BorrowArg],
			ReturnOwned,
		)
	else if name == "blorp_tensor5_new":
		fixed_contract(
			arity,
			[RetainArg, BorrowArg, BorrowArg, BorrowArg, BorrowArg, BorrowArg],
			ReturnOwned,
		)
	else:
		polymorphic_builtin_contract(name, arity)


private pure func borrowed_owned_case(
	arity: Int,
	first_arity: Int,
	second_arity: Int,
) -> Option[OwnershipCallContract]:
	if arity == first_arity or arity == second_arity:
		fixed_contract(arity, borrow_all(arity), ReturnOwned)
	else:
		None


private pure func channel_stack_option_contract(
	name: String,
	arity: Int,
) -> Option[OwnershipCallContract]:
	var found: Option[OwnershipCallContract] = None

	for suffix in CHANNEL_STACK_OPTION_SUFFIXES:
		if name == "blorp_channel_recv_${suffix}" or name == "blorp_channel_try_recv_${suffix}":
			found = fixed_contract(arity, [BorrowArg], ReturnPrimitive)
			break
		else if name == "blorp_channel_recv_timeout_${suffix}":
			found = fixed_contract(
				arity,
				[BorrowArg, BorrowArg],
				ReturnPrimitive,
			)
			break
		else:
			void

	found


private pure func fold_contract(arity: Int, base_arity: Int) -> Option[OwnershipCallContract]:
	if arity == base_arity:
		fixed_contract(
			arity,
			[BorrowArg, ConsumeArg, BorrowArg],
			ReturnOwned,
		)
	else if arity == base_arity + 1:
		fixed_contract(
			arity,
			[BorrowArg, ConsumeArg, BorrowArg, BorrowArg],
			ReturnOwned,
		)
	else:
		None


private pure func fold_with_contract(arity: Int, base_arity: Int) -> Option[OwnershipCallContract]:
	if arity == base_arity:
		fixed_contract(
			arity,
			[BorrowArg, ConsumeArg, BorrowArg, BorrowArg],
			ReturnOwned,
		)
	else if arity == base_arity + 1:
		fixed_contract(
			arity,
			[BorrowArg, ConsumeArg, BorrowArg, BorrowArg, BorrowArg],
			ReturnOwned,
		)
	else:
		None


private pure func polymorphic_builtin_contract(
	name: String,
	arity: Int,
) -> Option[OwnershipCallContract]:
	if (
		name == "blorp_map_parallel"
		or name == "blorp_vector_map"
		or name == "blorp_matrix_map"
		or name == "blorp_matrix_map_indexed"
		or name == "blorp_vmap_parallel"
		or name == "blorp_vmap_indexed_parallel"
		or name == "blorp_mmap_parallel"
		or name == "blorp_mmap_indexed_parallel"
		or name == "blorp_mmap_flat_indexed_parallel"
	):
		borrowed_owned_case(arity, 2, 3)
	else if name == "blorp_map_parallel_with":
		borrowed_owned_case(arity, 3, 4)
	else if (
		name == "blorp_zip_parallel"
		or name == "blorp_matrix_zip_map"
		or name == "blorp_vzip_parallel"
		or name == "blorp_mzip_parallel"
		or name == "blorp_mzip_indexed_parallel"
	):
		borrowed_owned_case(arity, 3, 4)
	else if name == "blorp_zip_parallel_with":
		borrowed_owned_case(arity, 4, 5)
	else if name == "blorp_fold_parallel" or name == "blorp_fold_parallel_ordered":
		fold_contract(arity, 3)
	else if name == "blorp_fold_parallel_with" or name == "blorp_fold_parallel_ordered_with":
		fold_with_contract(arity, 4)
	else if name.starts_with("blorp_vector_to_string_"):
		fixed_contract(arity, [BorrowArg], ReturnOwned)
	else:
		channel_stack_option_contract(name, arity)


pure func builtin_contract(name: String, arity: Int) -> Option[OwnershipCallContract]:
	match finalizer_contract(name, arity):
		Some(contract):
			Some(contract)
		None:
			match name:
				"blorp_list_new":
					fixed_contract(arity, [BorrowArg], ReturnOwned)
				"blorp_list_append":
					fixed_contract(
						arity,
						[CowConsumeArg, RetainArg],
						ReturnOwned,
					)
				"blorp_list_append_owned":
					fixed_contract(
						arity,
						[CowConsumeArg, TransferArg],
						ReturnOwned,
					)
				"blorp_channel_new":
					fixed_contract(arity, [BorrowArg], ReturnOwned)
				"blorp_channel_try_send_status":
					fixed_contract(
						arity,
						[BorrowArg, RetainArg],
						ReturnPrimitive,
					)
				"blorp_channel_send_timeout_status":
					fixed_contract(
						arity,
						[BorrowArg, RetainArg, BorrowArg],
						ReturnPrimitive,
					)
				"blorp_channel_try_send_attempt":
					fixed_contract(
						arity,
						[BorrowArg, RetainArg],
						ReturnOwned,
					)
				"blorp_channel_send_timeout_attempt":
					fixed_contract(
						arity,
						[BorrowArg, RetainArg, BorrowArg],
						ReturnOwned,
					)
				"blorp_channel_try_recv_attempt":
					fixed_contract(arity, [BorrowArg], ReturnOwned)
				"blorp_channel_recv_timeout_attempt":
					fixed_contract(
						arity,
						[BorrowArg, BorrowArg],
						ReturnOwned,
					)
				"blorp_tcp_ipv4_raw":
					fixed_contract(
						arity,
						[BorrowArg, BorrowArg, BorrowArg, BorrowArg],
						ReturnOwned,
					)
				"blorp_tcp_port_value_raw":
					fixed_contract(arity, [BorrowArg], ReturnPrimitive)
				"blorp_tls_native_available_raw":
					fixed_contract(arity, [], ReturnPrimitive)
				"blorp_websocket_native_available_raw":
					fixed_contract(arity, [], ReturnPrimitive)
				"blorp_sleep":
					fixed_contract(arity, [BorrowArg], ReturnVoid)
				"blorp_yield_now":
					fixed_contract(arity, [], ReturnVoid)
				"blorp_test_cancel_after_parked":
					fixed_contract(arity, [BorrowArg], ReturnPrimitive)
				"blorp_string_concat":
					fixed_contract(
						arity,
						[BorrowArg, BorrowArg],
						ReturnOwned,
					)
				"blorp_string_concat_consume":
					fixed_contract(
						arity,
						[CowConsumeArg, ConsumeArg],
						ReturnOwned,
					)
				"blorp_string_concat_many":
					variadic_contract(1, string_concat_many_arg, ReturnOwned, arity)
				"blorp_string_eq":
					fixed_contract(
						arity,
						[BorrowArg, BorrowArg],
						ReturnPrimitive,
					)
				_:
					grouped_builtin_contract(name, arity)


pure func builtin_ownership_coverage(name: String, arity: Int) -> Option[BuiltinOwnershipCoverage]:
	match builtin_contract(name, arity):
		Some(contract):
			Some(CoveredByContract)
		None:
			if name == "blorp_eq_dispatch":
				Some(PrePerceusSentinel("type-dispatched equality is specialized before Perceus"))
			else if (
				name == "blorp_tensor_matrix_multiply"
				or name == "blorp_tensor_matrix_vector_multiply"
				or name == "blorp_tensor_transposed_matrix_vector_multiply"
				or name == "blorp_tensor_outer"
				or name == "blorp_tensor_peel"
			):
				Some(PrePerceusSentinel("generic tensor dispatch is specialized before Perceus"))
			else:
				None
