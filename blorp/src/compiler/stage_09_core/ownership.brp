		"dict_order_set":
			borrowed_contract(arity, 3, ReturnVoid)
		"dict_order_index_set":
			borrowed_contract(arity, 3, ReturnVoid)
		"dict_set_len":
			borrowed_contract(arity, 2, ReturnVoid)
		"dict_set_order_len":
			borrowed_contract(arity, 2, ReturnVoid)
		"dict_resize":
			borrowed_contract(arity, 2, ReturnVoid)
		"dict_alloc":
			borrowed_contract(arity, 1, ReturnOwned)
		"dict_cow":
			fixed_contract(arity, [CowConsumeArg], ReturnOwned)
		"dict_reuse_alloc":
			fixed_contract(
				arity,
