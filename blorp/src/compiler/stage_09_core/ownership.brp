]

-- Runtime operations with generic value slots erase those arguments to void*.
-- Keep this contract beside ownership: storage representation and ownership
-- transfer must describe the same concrete runtime ABI.
private BUILTIN_ERASED_ARGUMENT_ZERO: List[String] = [
	"blorp_option_some",
	"blorp_result_ok",
	"blorp_result_err",
	"blorp_vector_new_fill",
	"blorp_matrix_new_fill",
