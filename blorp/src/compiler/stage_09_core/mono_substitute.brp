-- Whole-tree type substitution for Core monomorphization.
--
-- This pass rebuilds each expression node once through the shared exhaustive
-- traversal. Keeping child traversal and type-slot rewriting in the same match
-- avoids sharing managed Core fields between an intermediate reconstruction
-- and the final owning expression.
import:
	ir:
		CoreClosureCapture,
		CoreDecl(
			EnumDecl,
			FunctionDecl,
			GlobalDecl,
			HeapRecordDecl,
			ImplDecl,
			TraitDecl,
			TypeAliasDecl,
			UnionDecl,
			ValueRecordDecl,
		),
		CoreExpr(LogicalExpr, SeqExpr),
		CoreFunction,
		CoreFunctionKind(ClosureBodyFunction),
		CoreHeapRecordField,
		CoreParam,
		CoreTraitMethod,
		CoreType,
		CoreUnionField,
		CoreUnionVariant,
		CoreValueRecordField,
	mono: CoreMonoSubstitution, apply_type_substitution
	traverse as CoreTraverse


private pure func substitute_sequence_types(
	substitution: CoreMonoSubstitution,
	expr: CoreExpr,
) -> CoreExpr:
	spine = CoreTraverse.split_core_sequence(expr)
	var preceding_items: List[CoreExpr] = []

	for item in spine.preceding_items:
		preceding_items = preceding_items.append(substitute_core_expr_types(substitution, item))

	CoreTraverse.rebuild_core_sequence({
		preceding_items = preceding_items,
		final_item = substitute_core_expr_types(substitution, spine.final_item),
	})


pure func substitute_core_expr_types(
	substitution: CoreMonoSubstitution,
	expr: CoreExpr,
) -> CoreExpr:
	match expr:
		SeqExpr(_, _):
			substitute_sequence_types(substitution, expr)
		LogicalExpr(_, _, _, _, _):
			CoreTraverse.map_core_logical_tree_and_types_with_context(
				expr,
				substitution,
				substitute_core_expr_types,
				apply_type_substitution,
			)
		_:
			CoreTraverse.map_core_expr_children_and_types_with_context(
				expr,
				substitution,
				substitute_core_expr_types,
				apply_type_substitution,
			)


private pure func substitute_core_params(
	substitution: CoreMonoSubstitution,
	params: List[CoreParam],
) -> List[CoreParam]:
	var substituted: List[CoreParam] = []

	for param in params:
		substituted = substituted.append(
			{ param | typ = apply_type_substitution(substitution, param.typ) },
		)

	substituted


private pure func substitute_closure_captures(
	substitution: CoreMonoSubstitution,
	captures: List[CoreClosureCapture],
) -> List[CoreClosureCapture]:
	var substituted: List[CoreClosureCapture] = []

	for capture in captures:
		substituted = substituted.append(
			{ capture | typ = apply_type_substitution(substitution, capture.typ) },
		)

	substituted


private pure func substitute_function_kind(
	substitution: CoreMonoSubstitution,
	function_kind: CoreFunctionKind,
) -> CoreFunctionKind:
	match function_kind:
		ClosureBodyFunction(abi):
			ClosureBodyFunction({ abi |
					params = substitute_core_params(substitution, abi.params),
					captures = substitute_closure_captures(substitution, abi.captures)
				})
		_:
			function_kind


private pure func substitute_optional_expr(
	substitution: CoreMonoSubstitution,
	body: Option[CoreExpr],
) -> Option[CoreExpr]:
	match body:
		Some(expr):
			Some(substitute_core_expr_types(substitution, expr))
		None:
			None


private pure func substitute_core_function(
	substitution: CoreMonoSubstitution,
	function: CoreFunction,
) -> CoreFunction:
	params: List[CoreParam] = substitute_core_params(substitution, function.params)
	return_type: CoreType = apply_type_substitution(substitution, function.return_type)
	function_kind: CoreFunctionKind = substitute_function_kind(substitution, function.function_kind)
	body: Option[CoreExpr] = substitute_optional_expr(substitution, function.body)

	{ function |
		params = params,
		return_type = return_type,
		body = body,
		function_kind = function_kind
	}


private pure func substitute_core_functions(
	substitution: CoreMonoSubstitution,
	functions: List[CoreFunction],
) -> List[CoreFunction]:
	var substituted: List[CoreFunction] = []

	for function in functions:
		substituted = substituted.append(substitute_core_function(substitution, function))

	substituted


private pure func substitute_union_fields(
	substitution: CoreMonoSubstitution,
	fields: List[CoreUnionField],
) -> List[CoreUnionField]:
	var substituted: List[CoreUnionField] = []

	for field in fields:
		substituted = substituted.append(
			{ field | typ = apply_type_substitution(substitution, field.typ) },
		)

	substituted


private pure func substitute_union_variants(
	substitution: CoreMonoSubstitution,
	variants: List[CoreUnionVariant],
) -> List[CoreUnionVariant]:
	var substituted: List[CoreUnionVariant] = []

	for variant in variants:
		substituted = substituted.append(
			{ variant | fields = substitute_union_fields(substitution, variant.fields) },
		)

	substituted


private pure func substitute_value_record_fields(
	substitution: CoreMonoSubstitution,
	fields: List[CoreValueRecordField],
) -> List[CoreValueRecordField]:
	var substituted: List[CoreValueRecordField] = []

	for field in fields:
		substituted = substituted.append(
			{ field | typ = apply_type_substitution(substitution, field.typ) },
		)

	substituted


private pure func substitute_heap_record_fields(
	substitution: CoreMonoSubstitution,
	fields: List[CoreHeapRecordField],
) -> List[CoreHeapRecordField]:
	var substituted: List[CoreHeapRecordField] = []

	for field in fields:
		substituted = substituted.append(
			{ field | typ = apply_type_substitution(substitution, field.typ) },
		)

	substituted


private pure func substitute_trait_methods(
	substitution: CoreMonoSubstitution,
	methods: List[CoreTraitMethod],
) -> List[CoreTraitMethod]:
	var substituted: List[CoreTraitMethod] = []

	for method in methods:
		substituted = substituted.append({ method |
				params = substitute_core_params(substitution, method.params),
				return_type = apply_type_substitution(substitution, method.return_type)
			})

	substituted


pure func substitute_core_decl_types(
	substitution: CoreMonoSubstitution,
	decl: CoreDecl,
) -> CoreDecl:
	match decl:
		FunctionDecl(function):
			FunctionDecl(substitute_core_function(substitution, function))
		GlobalDecl(global):
			typ: CoreType = apply_type_substitution(substitution, global.typ)
			init: CoreExpr = substitute_core_expr_types(substitution, global.init)

			GlobalDecl({ global |
					typ = typ,
					init = init
				})
		EnumDecl(enum_decl):
			EnumDecl(enum_decl)
		UnionDecl(union_decl):
			UnionDecl(
				{ union_decl |
					variants = substitute_union_variants(substitution, union_decl.variants)
				},
			)
		ValueRecordDecl(record_decl):
			ValueRecordDecl(
				{ record_decl |
					fields = substitute_value_record_fields(substitution, record_decl.fields)
				},
			)
		HeapRecordDecl(record_decl):
			HeapRecordDecl(
				{ record_decl |
					fields = substitute_heap_record_fields(substitution, record_decl.fields)
				},
			)
		TypeAliasDecl(alias_decl):
			TypeAliasDecl(
				{ alias_decl | target = apply_type_substitution(substitution, alias_decl.target) },
			)
		TraitDecl(trait_decl):
			TraitDecl(
				{ trait_decl |
					methods = substitute_trait_methods(substitution, trait_decl.methods)
				},
			)
		ImplDecl(impl_decl):
			for_type: CoreType = apply_type_substitution(substitution, impl_decl.for_type)
			methods: List[CoreFunction] = substitute_core_functions(substitution, impl_decl.methods)

			ImplDecl({ impl_decl |
					for_type = for_type,
					methods = methods
				})
