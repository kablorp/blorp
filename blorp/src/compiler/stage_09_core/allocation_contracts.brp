-- Canonical local allocation facts shared by final-Core analysis and backend
-- planning. These facts describe allocation risk only; they do not certify a
-- prepared program or discharge a source obligation.
import:
	c_type_layout: stack_option_c_type, type_requires_release
	ir:
		CoreBoxKind(
			Float16Box,
			Float32Box,
			FloatBox,
			Int128Box,
			PointerBox,
			PrimBox,
			StructBox,
			UInt128Box,
			VoidBox,
		),
		CoreBoxedStorageValue,
		CoreCallKind(
			BuiltinCall,
			ClosureCall,
			DeferredTraitCall,
			DirectRuntimeCall,
			DictWithCapacityCall,
			FallibleStreamTerminalCall,
			ForeignCall,
			IntrinsicCall,
			ListToStringCall,
			OperationResultCall,
			SelectedDirectCall,
			SelectedTraitCall,
			TensorParallelCall,
			UnknownCall,
			UserCall,
		),
		CoreClosureCapture,
		CoreDictConstruct,
		CoreExpr(
			AccessorLiteralMatchExpr,
			AssignExpr,
			BinaryExpr,
			BoxExpr,
			BreakExpr,
			BorrowLetExpr,
			CallExpr,
			CastExpr,
			ClosureCreateExpr,
			ConcurrentlyLoopExpr,
			ConcurrentExpr,
			ConstructorMatchExpr,
			CooperativeCheckpointExpr,
			ContinueExpr,
			DebugBlockExpr,
			DetachExpr,
			DictConstructExpr,
			DictExpr,
			DropExpr,
			DupExpr,
			FieldExpr,
			ForChannelExpr,
			ForDictExpr,
			ForListExpr,
			ForRangeExpr,
			ForResourceSourceExpr,
			ForSetExpr,
			ForStreamExpr,
			ForStringExpr,
			ForTensorExpr,
			IfExpr,
			LambdaExpr,
			LengthMatchExpr,
			LetExpr,
			ListAllocExpr,
			ListConstructExpr,
			ListGetExpr,
			ListHandoffExpr,
			ListHandoffSetOwnedExpr,
			ListHandoffSetSourceSlotExpr,
			ListRetainExpr,
			ListSetExpr,
			ListSwapExpr,
			LiteralExpr,
			LiteralMatchExpr,
			LogicalExpr,
			PreClosureConcurrentExpr,
			PreClosureConcurrentlyLoopExpr,
			PreClosureDetachExpr,
			RangeExpr,
			RawMatchExpr,
			RecordConstructExpr,
			RecordCowUpdateExpr,
			RecordExpr,
			RecordReuseExpr,
			RecordUpdateExpr,
			ResourceCleanupExitExpr,
			ResourceScopeExpr,
			SelectExpr,
			SemanticMatchExpr,
			SeqExpr,
			SetAllocExpr,
			StaticStringLiteralExpr,
			StringByteCopyExpr,
			StringByteReadExpr,
			StringByteWriteExpr,
			StringSetLenExpr,
			TailrecListSpreadLoopExpr,
			TailrecListSpreadRecurExpr,
			TailrecLoopExpr,
			TailrecRecurExpr,
			TensorBoxedLiteralExpr,
			TensorLiteralExpr,
			TensorPackedLiteralExpr,
			TensorRawFillExpr,
			TensorRawReadExpr,
			TensorRawViewLetExpr,
			TensorRawWriteExpr,
			TupleConstructExpr,
			TupleExpr,
			TupleFieldExpr,
			UnaryExpr,
			UnboxExpr,
			UnionConstructExpr,
			UnionReuseConstructExpr,
			VarExpr,
			VectorExpr,
			VoidExpr,
			WhileExpr,
		),
		CoreForeignArgPassing(ForeignBorrowArgs, ForeignDefaultArgs),
		CoreForeignDefaultArgPolicy(ForeignDefensiveCopy, ForeignScalarByValue),
		CoreHashContainerConstructor(CustomHashContainerConstructor),
		CoreListConstruct,
		CoreListStorageLayout(InlineListStorage, InlineStructListStorage, PointerListStorage),
		CoreReleasePolicy(
			ArcReleaseOnlyPolicy,
			ArcReleasePolicy,
			NoReleasePolicy,
			StackResultReleasePolicy,
		),
		CoreSelectArm,
		CoreSelectArmKind(SelectAfterArm, SelectRecvArm, SelectSealedArm),
		CoreTaskCapture,
		CoreTensorBoxedLiteral,
		CoreTensorForElementStorage(
			TensorForBoxedElement,
			TensorForInlineStructElement,
			TensorForRawScalarElement,
			TensorForRowSliceElement,
			TensorForRuntimeReadElement,
		),
		CoreTupleConstruct,
		CoreTupleElement(
			TupleFloat16Element,
			TupleFloat32Element,
			TupleFloatElement,
			TuplePointerElement,
			TuplePrimElement,
			TupleStackResultElement,
			TupleStructElement,
			TupleVoidElement,
		),
		CoreType(HeapRecordType, NamedType, StackResultType, TupleType, UnionType, ValueRecordType),
		CoreUnionConstruct,
		CoreUnionDecl,
		CoreUnionField,
		CoreUnionPayloadStorage(ErasedUnionPayloadStorage, TypedUnionPayloadStorage),
		CoreUnionRepresentation(
			BoxedOptionRepresentation,
			GenericUnionRepresentation,
			NullableOptionRepresentation,
			StackOptionRepresentation,
			StackResultRepresentation,
		),
		CoreUnionReuseConstruct,
		CoreUnionVariant,
		core_expr_type,
	type_policy: cleanup_release_policy_for_type


enum AllocationRiskReason:
	ManagedObjectAllocation
	RawBufferAllocation
	CapacityGrowthAllocation
	HeapBoxAllocation
	ClosureEnvironmentAllocation
	TupleStorageAllocation
	CowFallbackAllocation
	TaskAllocation
	CleanupScratchAllocation
	RuntimeOperationAllocation
	UnknownCallTarget
	ForeignCallBoundary
	RuntimeCallbackBoundary


record CoreLocalAllocationFacts {
	may_allocate: List[AllocationRiskReason],
	unknown: List[AllocationRiskReason]
}


enum AllocationCoverage:
	CoveredAllocationOperation
	UnsupportedFinalCoreOperation


enum AllocationOperationCategory:
	ScalarAllocationOperation
	ControlFlowAllocationOperation
	BoxAllocationOperation
	TupleAllocationOperation
	CollectionAllocationOperation
	RecordAllocationOperation
	UnionAllocationOperation
	ClosureAllocationOperation
	TaskAllocationOperation
	CleanupAllocationOperation
	CallAllocationOperation
	UnsupportedAllocationOperation


union AllocationDependency:
	DirectFunctionAllocationDependency(Int)
	CleanupAllocationDependency(CoreType, CoreReleasePolicy)
	UnknownCallAllocationDependency
	ForeignAllocationDependency
	RuntimeAllocationDependency
	ClosureAllocationDependency


record CoreAllocationContract {
	coverage: AllocationCoverage,
	category: AllocationOperationCategory,
	facts: CoreLocalAllocationFacts,
	dependencies: List[AllocationDependency]
}


record UnionCleanupDependency {
	typ: CoreType,
	release_policy: CoreReleasePolicy
}


enum UnionCleanupKind:
	NoUnionCleanup
	DirectUnionCleanup
	IterativeUnionCleanup


record UnionCleanupPlan {
	kind: UnionCleanupKind,
	facts: CoreLocalAllocationFacts,
	dependencies: List[UnionCleanupDependency]
}


private EMPTY_ALLOCATION_FACTS: CoreLocalAllocationFacts = {
	may_allocate = [],
	unknown = []
}


private pure func allocation_risk_reasons_equal(
	left: AllocationRiskReason,
	right: AllocationRiskReason,
) -> Bool:
	match (left, right):
		(ManagedObjectAllocation, ManagedObjectAllocation) | (RawBufferAllocation, RawBufferAllocation) | (CapacityGrowthAllocation, CapacityGrowthAllocation) | (HeapBoxAllocation, HeapBoxAllocation) | (ClosureEnvironmentAllocation, ClosureEnvironmentAllocation) | (TupleStorageAllocation, TupleStorageAllocation) | (CowFallbackAllocation, CowFallbackAllocation) | (TaskAllocation, TaskAllocation) | (CleanupScratchAllocation, CleanupScratchAllocation) | (RuntimeOperationAllocation, RuntimeOperationAllocation) | (UnknownCallTarget, UnknownCallTarget) | (ForeignCallBoundary, ForeignCallBoundary) | (RuntimeCallbackBoundary, RuntimeCallbackBoundary):
			True
		_:
			False


private pure func allocation_reasons_contain(
	reasons: List[AllocationRiskReason],
	target: AllocationRiskReason,
) -> Bool:
	var found: Bool = False

	for reason in reasons:
		if allocation_risk_reasons_equal(reason, target):
			found = True
			break
		else:
			void

	found


private pure func merge_allocation_reasons(
	left: List[AllocationRiskReason],
	right: List[AllocationRiskReason],
) -> List[AllocationRiskReason]:
	var merged: List[AllocationRiskReason] = left

	for reason in right:
		if not allocation_reasons_contain(merged, reason):
			merged = merged.append(reason)
		else:
			void

	merged


pure func merge_allocation_facts(
	left: CoreLocalAllocationFacts,
	right: CoreLocalAllocationFacts,
) -> CoreLocalAllocationFacts:
	{
		may_allocate = merge_allocation_reasons(left.may_allocate, right.may_allocate),
		unknown = merge_allocation_reasons(left.unknown, right.unknown)
	}


private pure func covered_allocation_contract(
	category: AllocationOperationCategory,
	facts: CoreLocalAllocationFacts,
	dependencies: List[AllocationDependency],
) -> CoreAllocationContract:
	{
		coverage = CoveredAllocationOperation,
		category = category,
		facts = facts,
		dependencies = dependencies
	}


private pure func free_allocation_contract(
	category: AllocationOperationCategory,
) -> CoreAllocationContract:
	covered_allocation_contract(category, EMPTY_ALLOCATION_FACTS, [])


private pure func may_allocate_contract(
	category: AllocationOperationCategory,
	reason: AllocationRiskReason,
) -> CoreAllocationContract:
	covered_allocation_contract(
		category,
		{
			may_allocate = [reason],
			unknown = []
		},
		[],
	)


private pure func unknown_allocation_contract(
	category: AllocationOperationCategory,
	reason: AllocationRiskReason,
	dependency: AllocationDependency,
) -> CoreAllocationContract:
	covered_allocation_contract(
		category,
		{
			may_allocate = [],
			unknown = [reason]
		},
		[dependency],
	)


private pure func unsupported_allocation_contract() -> CoreAllocationContract:
	{
		coverage = UnsupportedFinalCoreOperation,
		category = UnsupportedAllocationOperation,
		facts = EMPTY_ALLOCATION_FACTS,
		dependencies = []
	}


private pure func merge_contract_facts(
	contract: CoreAllocationContract,
	facts: CoreLocalAllocationFacts,
) -> CoreAllocationContract:
	{
		coverage = contract.coverage,
		category = contract.category,
		facts = merge_allocation_facts(contract.facts, facts),
		dependencies = contract.dependencies
	}


private pure func append_allocation_dependency(
	contract: CoreAllocationContract,
	dependency: AllocationDependency,
) -> CoreAllocationContract:
	{
		coverage = contract.coverage,
		category = contract.category,
		facts = contract.facts,
		dependencies = contract.dependencies.append(dependency)
	}


private pure func append_cleanup_dependency(
	contract: CoreAllocationContract,
	typ: CoreType,
	policy: CoreReleasePolicy,
) -> CoreAllocationContract:
	match policy:
		NoReleasePolicy | ArcReleaseOnlyPolicy:
			contract
		ArcReleasePolicy | StackResultReleasePolicy:
			append_allocation_dependency(
				contract,
				CleanupAllocationDependency(typ, policy),
			)


pure func allocation_facts_are_free(facts: CoreLocalAllocationFacts) -> Bool:
	facts.may_allocate.is_empty() and facts.unknown.is_empty()


pure func allocation_reason_code(reason: AllocationRiskReason) -> String:
	match reason:
		ManagedObjectAllocation:
			"managed_object"
		RawBufferAllocation:
			"raw_buffer"
		CapacityGrowthAllocation:
			"capacity_growth"
		HeapBoxAllocation:
			"heap_box"
		ClosureEnvironmentAllocation:
			"closure_environment"
		TupleStorageAllocation:
			"tuple_storage"
		CowFallbackAllocation:
			"cow_fallback"
		TaskAllocation:
			"task"
		CleanupScratchAllocation:
			"cleanup_scratch"
		RuntimeOperationAllocation:
			"runtime_operation"
		UnknownCallTarget:
			"unknown_call_target"
		ForeignCallBoundary:
			"foreign_call_boundary"
		RuntimeCallbackBoundary:
			"runtime_callback_boundary"


pure func box_allocation_facts(kind: CoreBoxKind) -> CoreLocalAllocationFacts:
	match kind:
		PrimBox | PointerBox | VoidBox | FloatBox | Float32Box | Float16Box:
			EMPTY_ALLOCATION_FACTS
		Int128Box | UInt128Box | StructBox(_):
			{
				may_allocate = [HeapBoxAllocation],
				unknown = []
			}


private pure func foreign_call_allocation_contract(
	passing: CoreForeignArgPassing,
) -> CoreAllocationContract:
	var may_copy: Bool = False

	match passing:
		ForeignBorrowArgs:
			void
		ForeignDefaultArgs(policies):
			for policy in policies:
				match policy:
					ForeignScalarByValue:
						void
					ForeignDefensiveCopy(_):
						may_copy = True

	copy_risks: List[AllocationRiskReason] = if may_copy:
		[RawBufferAllocation]
	else:
		[]

	covered_allocation_contract(
		CallAllocationOperation,
		{
			may_allocate = copy_risks,
			unknown = [ForeignCallBoundary]
		},
		[ForeignAllocationDependency],
	)


-- This is deliberately a closed exact-name catalog. A renderer entry or an
-- ownership contract is not an allocation proof; each admitted intrinsic was
-- audited at its final prepared rendering boundary.
private pure func audited_allocation_free_intrinsic(name: String) -> Bool:
	(
		name == "bit_and"
		or name == "bit_or"
		or name == "bit_xor"
		or name == "bit_not"
		or name == "shift_left"
		or name == "shift_right"
		or name == "list_len"
		or name == "list_capacity"
		or name == "string_len"
		or name == "bytes_len"
		or name == "dict_len"
		or name == "set_len"
		or name == "set_capacity"
		or name == "set_mask"
		or name == "dict_capacity"
		or name == "dict_mask"
		or name == "dict_grow_at"
		or name == "dict_order_len"
		or name == "slice_start"
		or name == "slice_len"
		or name == "memory_is_unique_heap"
		or name == "memory_is_unique_stack"
		or name == "memory_refcount_heap"
		or name == "memory_refcount_stack"
		or name == "memory_size_of_heap"
		or name == "memory_size_of_stack"
		or name == "memory_same_object_heap"
		or name == "memory_same_object_stack"
		or name == "tensor_len"
		or name == "tensor_capacity"
		or name == "fixed_value"
		or name == "fixed_scale"
		or name == "fixed_precision"
		or name == "fixed_pow10"
	)


private pure func intrinsic_allocation_contract(name: String) -> CoreAllocationContract:
	if audited_allocation_free_intrinsic(name):
		free_allocation_contract(CallAllocationOperation)
	else:
		unknown_allocation_contract(
			CallAllocationOperation,
			RuntimeOperationAllocation,
			RuntimeAllocationDependency,
		)


-- Runtime names are admitted only after auditing the exact native body. This
-- pilot intentionally keeps the rest of the runtime surface unknown.
private pure func direct_runtime_allocation_contract(name: String) -> CoreAllocationContract:
	if (
		name == "blorp_min"
		or name == "blorp_max"
		or name == "blorp_hash_combine"
		or name == "blorp_length"
		or name == "blorp_codepoint_length"
	):
		free_allocation_contract(CallAllocationOperation)
	else if name == "blorp_string_levenshtein":
		may_allocate_contract(CallAllocationOperation, RawBufferAllocation)
	else:
		unknown_allocation_contract(
			CallAllocationOperation,
			RuntimeOperationAllocation,
			RuntimeAllocationDependency,
		)


pure func core_call_allocation_contract(kind: CoreCallKind) -> CoreAllocationContract:
	match kind:
		UnknownCall | DeferredTraitCall(_, _):
			unknown_allocation_contract(
				CallAllocationOperation,
				UnknownCallTarget,
				UnknownCallAllocationDependency,
			)
		SelectedDirectCall(def_id) | SelectedTraitCall(_, _, _, def_id):
			covered_allocation_contract(
				CallAllocationOperation,
				EMPTY_ALLOCATION_FACTS,
				[DirectFunctionAllocationDependency(def_id)],
			)
		UserCall(_, Some(def_id), _):
			covered_allocation_contract(
				CallAllocationOperation,
				EMPTY_ALLOCATION_FACTS,
				[DirectFunctionAllocationDependency(def_id)],
			)
		UserCall(_, None, _):
			unknown_allocation_contract(
				CallAllocationOperation,
				UnknownCallTarget,
				UnknownCallAllocationDependency,
			)
		ForeignCall(_, passing):
			foreign_call_allocation_contract(passing)
		IntrinsicCall(name):
			intrinsic_allocation_contract(name)
		DirectRuntimeCall(call):
			direct_runtime_allocation_contract(call.name)
		BuiltinCall(_) | OperationResultCall(_) | FallibleStreamTerminalCall(_) | TensorParallelCall(_, _):
			unknown_allocation_contract(
				CallAllocationOperation,
				RuntimeOperationAllocation,
				RuntimeAllocationDependency,
			)
		DictWithCapacityCall(_):
			may_allocate_contract(CollectionAllocationOperation, ManagedObjectAllocation)
		ListToStringCall(_):
			append_allocation_dependency(
				covered_allocation_contract(
					CollectionAllocationOperation,
					{
						may_allocate = [RawBufferAllocation],
						unknown = [RuntimeCallbackBoundary]
					},
					[],
				),
				RuntimeAllocationDependency,
			)
		ClosureCall:
			unknown_allocation_contract(
				CallAllocationOperation,
				UnknownCallTarget,
				ClosureAllocationDependency,
			)


private pure func list_get_allocation_contract(
	layout: CoreListStorageLayout,
) -> CoreAllocationContract:
	match layout:
		PointerListStorage | InlineListStorage(_) | InlineStructListStorage(_):
			free_allocation_contract(CollectionAllocationOperation)


private pure func record_construct_allocation_contract(typ: CoreType) -> CoreAllocationContract:
	match typ:
		ValueRecordType(_):
			free_allocation_contract(RecordAllocationOperation)
		HeapRecordType(_):
			may_allocate_contract(RecordAllocationOperation, ManagedObjectAllocation)
		_:
			unknown_allocation_contract(
				RecordAllocationOperation,
				RuntimeOperationAllocation,
				RuntimeAllocationDependency,
			)


private pure func boxed_storage_values_allocation_facts(
	values: List[CoreBoxedStorageValue],
) -> CoreLocalAllocationFacts:
	var facts: CoreLocalAllocationFacts = EMPTY_ALLOCATION_FACTS

	for value in values:
		facts = merge_allocation_facts(facts, box_allocation_facts(value.kind))

	facts


private pure func list_construct_allocation_contract(
	construct: CoreListConstruct,
) -> CoreAllocationContract:
	merge_contract_facts(
		may_allocate_contract(CollectionAllocationOperation, RawBufferAllocation),
		boxed_storage_values_allocation_facts(construct.elements),
	)


private pure func tensor_boxed_literal_allocation_contract(
	literal: CoreTensorBoxedLiteral,
) -> CoreAllocationContract:
	merge_contract_facts(
		may_allocate_contract(CollectionAllocationOperation, RawBufferAllocation),
		boxed_storage_values_allocation_facts(literal.elements),
	)


private pure func union_construct_allocation_contract(
	construct: CoreUnionConstruct,
) -> CoreAllocationContract:
	base: CoreAllocationContract = match construct.representation:
		StackOptionRepresentation(_) | StackResultRepresentation(_) | NullableOptionRepresentation:
			free_allocation_contract(UnionAllocationOperation)
		GenericUnionRepresentation | BoxedOptionRepresentation:
			if construct.args.is_empty():
				free_allocation_contract(UnionAllocationOperation)
			else:
				may_allocate_contract(UnionAllocationOperation, ManagedObjectAllocation)

	box_facts: CoreLocalAllocationFacts = match construct.representation:
		StackResultRepresentation(_):
			boxed_storage_values_allocation_facts(construct.args)
		GenericUnionRepresentation | BoxedOptionRepresentation:
			match construct.payload_storage:
				ErasedUnionPayloadStorage:
					boxed_storage_values_allocation_facts(construct.args)
				TypedUnionPayloadStorage:
					EMPTY_ALLOCATION_FACTS
		StackOptionRepresentation(_) | NullableOptionRepresentation:
			EMPTY_ALLOCATION_FACTS

	merge_contract_facts(base, box_facts)


private pure func tuple_construct_allocation_contract(
	construct: CoreTupleConstruct,
) -> CoreAllocationContract:
	var facts: CoreLocalAllocationFacts = {
		may_allocate = [TupleStorageAllocation],
		unknown = []
	}

	for element in construct.elements:
		element_facts: CoreLocalAllocationFacts = match element:
			TupleStructElement(_, c_type):
				box_allocation_facts(StructBox(c_type))
			TupleStackResultElement(_):
				{
					may_allocate = [HeapBoxAllocation],
					unknown = []
				}
			TuplePrimElement(_) | TuplePointerElement(_) | TupleVoidElement | TupleFloatElement(_) | TupleFloat32Element(_) | TupleFloat16Element(_):
				EMPTY_ALLOCATION_FACTS

		facts = merge_allocation_facts(facts, element_facts)

	covered_allocation_contract(TupleAllocationOperation, facts, [])


private pure func drop_allocation_contract(
	value_type: CoreType,
	policy: CoreReleasePolicy,
) -> CoreAllocationContract:
	match policy:
		NoReleasePolicy | ArcReleaseOnlyPolicy:
			free_allocation_contract(CleanupAllocationOperation)
		ArcReleasePolicy | StackResultReleasePolicy:
			covered_allocation_contract(
				CleanupAllocationOperation,
				EMPTY_ALLOCATION_FACTS,
				[CleanupAllocationDependency(value_type, policy)],
			)


private pure func dict_iteration_allocation_contract(
	binder_type: CoreType,
) -> CoreAllocationContract:
	base: CoreAllocationContract = match binder_type:
		TupleType(_):
			may_allocate_contract(TupleAllocationOperation, TupleStorageAllocation)
		_:
			free_allocation_contract(ControlFlowAllocationOperation)

	if type_requires_release(binder_type):
		append_cleanup_dependency(base, binder_type, ArcReleasePolicy)
	else:
		base


private pure func dict_construct_allocation_contract(
	construct: CoreDictConstruct,
) -> CoreAllocationContract:
	var element_facts: CoreLocalAllocationFacts = EMPTY_ALLOCATION_FACTS

	for entry in construct.entries:
		element_facts = merge_allocation_facts(element_facts, box_allocation_facts(entry.key.kind))
		element_facts = merge_allocation_facts(
			element_facts,
			box_allocation_facts(entry.value.kind),
		)

	base: CoreAllocationContract = merge_contract_facts(
		may_allocate_contract(CollectionAllocationOperation, ManagedObjectAllocation),
		element_facts,
	)

	match construct.constructor:
		CustomHashContainerConstructor(_, _, _):
			if construct.entries.is_empty():
				base
			else:
				append_allocation_dependency(
					merge_contract_facts(
						base,
						{
							may_allocate = [],
							unknown = [RuntimeCallbackBoundary]
						},
					),
					RuntimeAllocationDependency,
				)
		_:
			base


private pure func tensor_iteration_allocation_contract(
	element_storage: CoreTensorForElementStorage,
) -> CoreAllocationContract:
	match element_storage:
		TensorForRowSliceElement(_):
			may_allocate_contract(CollectionAllocationOperation, ManagedObjectAllocation)
		TensorForInlineStructElement(_) | TensorForRawScalarElement(_) | TensorForRuntimeReadElement(_) | TensorForBoxedElement(_):
			free_allocation_contract(ControlFlowAllocationOperation)


private pure func capture_type_allocation_facts(typ: CoreType) -> CoreLocalAllocationFacts:
	requires_box: Bool = match typ:
		ValueRecordType(_) | StackResultType(_, _):
			True
		NamedType("Option", [payload]):
			stack_option_c_type(payload).is_some()
		_:
			False

	if requires_box:
		{
			may_allocate = [HeapBoxAllocation],
			unknown = []
		}
	else:
		EMPTY_ALLOCATION_FACTS


private pure func closure_capture_allocation_facts(
	captures: List[CoreClosureCapture],
) -> CoreLocalAllocationFacts:
	var facts: CoreLocalAllocationFacts = EMPTY_ALLOCATION_FACTS

	for capture in captures:
		facts = merge_allocation_facts(facts, capture_type_allocation_facts(capture.typ))

	facts


private pure func task_capture_allocation_facts(
	captures: List[CoreTaskCapture],
) -> CoreLocalAllocationFacts:
	var facts: CoreLocalAllocationFacts = EMPTY_ALLOCATION_FACTS

	for capture in captures:
		facts = merge_allocation_facts(facts, capture_type_allocation_facts(capture.typ))

	facts


private pure func select_allocation_contract(arms: List[CoreSelectArm]) -> CoreAllocationContract:
	var contract: CoreAllocationContract = unknown_allocation_contract(
		ControlFlowAllocationOperation,
		RuntimeCallbackBoundary,
		RuntimeAllocationDependency,
	)

	for arm in arms:
		match arm.kind:
			SelectRecvArm(recv):
				contract = append_cleanup_dependency(
					contract,
					recv.elem_type,
					cleanup_release_policy_for_type(recv.elem_type),
				)
			SelectSealedArm(_) | SelectAfterArm(_):
				void

	contract


private pure func union_reuse_allocation_contract(
	construct: CoreUnionReuseConstruct,
) -> CoreAllocationContract:
	box_facts: CoreLocalAllocationFacts = match construct.payload_storage:
		ErasedUnionPayloadStorage:
			boxed_storage_values_allocation_facts(construct.args)
		TypedUnionPayloadStorage:
			EMPTY_ALLOCATION_FACTS

	base: CoreAllocationContract = merge_contract_facts(
		may_allocate_contract(UnionAllocationOperation, CowFallbackAllocation),
		box_facts,
	)

	append_cleanup_dependency(base, UnionType(construct.type_name), ArcReleasePolicy)


-- This is intentionally one exhaustive match over CoreExpr. Adding a Core
-- variant therefore breaks compiler coverage until its local allocation
-- policy is chosen here. Child expressions are analyzed separately by the
-- later inventory walk; these facts describe only work introduced by this
-- node and its allocation-relevant payload mode.
pure func core_expr_allocation_contract(expr: CoreExpr) -> CoreAllocationContract:
	match expr:
		LiteralExpr(_, _, _) | StaticStringLiteralExpr(_, _, _, _) | VarExpr(_, _, _) | VoidExpr(_, _):
			free_allocation_contract(ScalarAllocationOperation)
		CooperativeCheckpointExpr(_, _):
			unknown_allocation_contract(
				ControlFlowAllocationOperation,
				RuntimeCallbackBoundary,
				RuntimeAllocationDependency,
			)
		BinaryExpr(_, _, _, _, _) | UnaryExpr(_, _, _, _) | LogicalExpr(_, _, _, _, _) | AssignExpr(_, _, _, _) | CastExpr(_, _, _) | UnboxExpr(_, _, _, _) | FieldExpr(_, _, _, _) | TupleFieldExpr(_, _, _, _):
			free_allocation_contract(ScalarAllocationOperation)
		CallExpr(kind, _, _, _, _):
			core_call_allocation_contract(kind)
		BoxExpr(box, _, _):
			covered_allocation_contract(BoxAllocationOperation, box_allocation_facts(box.kind), [])
		TupleConstructExpr(construct, _, _):
			tuple_construct_allocation_contract(construct)
		ClosureCreateExpr(closure, _, _):
			if closure.captures.is_empty():
				free_allocation_contract(ClosureAllocationOperation)
			else:
				merge_contract_facts(
					may_allocate_contract(ClosureAllocationOperation, ClosureEnvironmentAllocation),
					closure_capture_allocation_facts(closure.captures),
				)
		ListConstructExpr(construct, _, _):
			list_construct_allocation_contract(construct)
		ListAllocExpr(_, _, _):
			may_allocate_contract(CollectionAllocationOperation, RawBufferAllocation)
		ListGetExpr(get, _, _):
			list_get_allocation_contract(get.layout)
		ListHandoffExpr(_, _, _):
			may_allocate_contract(CollectionAllocationOperation, CapacityGrowthAllocation)
		ListHandoffSetOwnedExpr(set, _, _) | ListSetExpr(set, _, _):
			covered_allocation_contract(
				CollectionAllocationOperation,
				box_allocation_facts(set.value.kind),
				[],
			)
		ListRetainExpr(retain, _, _):
			covered_allocation_contract(
				CollectionAllocationOperation,
				box_allocation_facts(retain.value.kind),
				[],
			)
		ListHandoffSetSourceSlotExpr(_, _, _) | ListSwapExpr(_, _, _):
			free_allocation_contract(CollectionAllocationOperation)
		StringByteReadExpr(_, _, _) | StringByteWriteExpr(_, _, _) | StringByteCopyExpr(_, _, _) | StringSetLenExpr(_, _, _):
			free_allocation_contract(CollectionAllocationOperation)
		TensorBoxedLiteralExpr(literal, _, _):
			tensor_boxed_literal_allocation_contract(literal)
		TensorLiteralExpr(_, _, _) | TensorPackedLiteralExpr(_, _, _) | TensorRawFillExpr(_, _, _):
			may_allocate_contract(CollectionAllocationOperation, RawBufferAllocation)
		TensorRawReadExpr(_, _, _) | TensorRawWriteExpr(_, _, _) | TensorRawViewLetExpr(_, _, _, _):
			free_allocation_contract(CollectionAllocationOperation)
		DictConstructExpr(construct, _, _):
			dict_construct_allocation_contract(construct)
		SetAllocExpr(_, _, _):
			may_allocate_contract(CollectionAllocationOperation, ManagedObjectAllocation)
		RecordCowUpdateExpr(_, _, typ, _) | RecordReuseExpr(_, _, typ, _):
			append_cleanup_dependency(
				may_allocate_contract(RecordAllocationOperation, CowFallbackAllocation),
				typ,
				ArcReleasePolicy,
			)
		RecordConstructExpr(_, _, typ, _):
			record_construct_allocation_contract(typ)
		UnionConstructExpr(construct, _, _):
			union_construct_allocation_contract(construct)
		UnionReuseConstructExpr(construct, _, _):
			union_reuse_allocation_contract(construct)
		DetachExpr(task, _, _):
			merge_contract_facts(
				may_allocate_contract(TaskAllocationOperation, TaskAllocation),
				task_capture_allocation_facts(task.captures),
			)
		DupExpr(_, _, _, _, _, _):
			free_allocation_contract(CleanupAllocationOperation)
		DropExpr(_, value_type, policy, _, _, _):
			drop_allocation_contract(value_type, policy)
		LetExpr(_, _, _, _, _) | BorrowLetExpr(_, _, _, _) | SeqExpr(_, _) | WhileExpr(_, _, _, _) | BreakExpr(_, _) | ContinueExpr(_, _):
			free_allocation_contract(ControlFlowAllocationOperation)
		ResourceScopeExpr(_, _, _) | ResourceCleanupExitExpr(_, _, _) | TailrecLoopExpr(_, _, _, _) | TailrecRecurExpr(_, _, _) | TailrecListSpreadLoopExpr(_, _) | TailrecListSpreadRecurExpr(_, _, _, _):
			free_allocation_contract(ControlFlowAllocationOperation)
		ForRangeExpr(_, _, _, _, _, _):
			free_allocation_contract(ControlFlowAllocationOperation)
		ForListExpr(loop, _, _):
			append_cleanup_dependency(
				free_allocation_contract(ControlFlowAllocationOperation),
				core_expr_type(loop.iterable),
				loop.iterable_release_policy,
			)
		ForStringExpr(loop, _, _):
			append_cleanup_dependency(
				free_allocation_contract(ControlFlowAllocationOperation),
				core_expr_type(loop.iterable),
				loop.iterable_release_policy,
			)
		ForDictExpr(loop, _, _):
			append_cleanup_dependency(
				dict_iteration_allocation_contract(loop.binder.typ),
				core_expr_type(loop.iterable),
				loop.iterable_release_policy,
			)
		ForSetExpr(loop, _, _):
			append_cleanup_dependency(
				free_allocation_contract(ControlFlowAllocationOperation),
				core_expr_type(loop.iterable),
				loop.iterable_release_policy,
			)
		ForResourceSourceExpr(loop, _, _):
			append_cleanup_dependency(
				unknown_allocation_contract(
					ControlFlowAllocationOperation,
					RuntimeCallbackBoundary,
					RuntimeAllocationDependency,
				),
				core_expr_type(loop.iterable),
				loop.iterable_release_policy,
			)
		ForTensorExpr(loop, _, _):
			append_cleanup_dependency(
				tensor_iteration_allocation_contract(loop.element_storage),
				core_expr_type(loop.iterable),
				loop.iterable_release_policy,
			)
		ForChannelExpr(loop, _, _):
			append_cleanup_dependency(
				unknown_allocation_contract(
					ControlFlowAllocationOperation,
					RuntimeCallbackBoundary,
					RuntimeAllocationDependency,
				),
				loop.binder.typ,
				cleanup_release_policy_for_type(loop.binder.typ),
			)
		SelectExpr(arms, _, _):
			select_allocation_contract(arms)
		ForStreamExpr(loop, _, _):
			append_cleanup_dependency(
				unknown_allocation_contract(
					ControlFlowAllocationOperation,
					RuntimeCallbackBoundary,
					RuntimeAllocationDependency,
				),
				core_expr_type(loop.iterable),
				loop.iterable_release_policy,
			)
		ConcurrentlyLoopExpr(loop, _, _):
			merge_contract_facts(
				may_allocate_contract(TaskAllocationOperation, TaskAllocation),
				task_capture_allocation_facts(loop.task.captures),
			)
		ConcurrentExpr(block, _, _):
			var facts: CoreLocalAllocationFacts = EMPTY_ALLOCATION_FACTS

			for binding in block.bindings:
				facts = merge_allocation_facts(
					facts,
					task_capture_allocation_facts(binding.task.captures),
				)

			merge_contract_facts(
				may_allocate_contract(TaskAllocationOperation, TaskAllocation),
				facts,
			)
		RangeExpr(_, _, _, _) | LiteralMatchExpr(_, _, _, _, _) | IfExpr(_, _, _, _, _):
			free_allocation_contract(ControlFlowAllocationOperation)
		AccessorLiteralMatchExpr(scrutinee, policy, _, _, _) | LengthMatchExpr(scrutinee, policy, _, _, _) | ConstructorMatchExpr(scrutinee, policy, _, _, _, _):
			append_cleanup_dependency(
				free_allocation_contract(ControlFlowAllocationOperation),
				core_expr_type(scrutinee),
				policy,
			)
		DebugBlockExpr(_, _, _) | TupleExpr(_, _, _) | VectorExpr(_, _, _) | LambdaExpr(_, _, _, _, _, _) | DictExpr(_, _, _) | RecordExpr(_, _, _) | RecordUpdateExpr(_, _, _, _) | PreClosureConcurrentlyLoopExpr(_, _, _) | PreClosureConcurrentExpr(_, _, _) | PreClosureDetachExpr(_, _, _) | RawMatchExpr(_, _, _, _) | SemanticMatchExpr(_, _, _, _):
			unsupported_allocation_contract()


pure func release_policy_requires_cleanup(policy: CoreReleasePolicy) -> Bool:
	match policy:
		NoReleasePolicy:
			False
		ArcReleasePolicy | ArcReleaseOnlyPolicy | StackResultReleasePolicy:
			True


private pure func union_field_is_self_recursive(union_name: String, field: CoreUnionField) -> Bool:
	match field.typ:
		UnionType(name):
			name == union_name
		_:
			False


pure func union_field_uses_iterative_cleanup(
	union_decl: CoreUnionDecl,
	field: CoreUnionField,
) -> Bool:
	match field.release_policy:
		ArcReleasePolicy:
			union_field_is_self_recursive(union_decl.name, field)
		NoReleasePolicy | ArcReleaseOnlyPolicy | StackResultReleasePolicy:
			False


pure func union_variant_has_cleanup(variant: CoreUnionVariant) -> Bool:
	var has_cleanup: Bool = False

	for field in variant.fields:
		if release_policy_requires_cleanup(field.release_policy):
			has_cleanup = True
			break
		else:
			void

	has_cleanup


private pure func union_variant_uses_iterative_cleanup(
	union_decl: CoreUnionDecl,
	variant: CoreUnionVariant,
) -> Bool:
	var uses_iterative_cleanup: Bool = False

	for field in variant.fields:
		if union_field_uses_iterative_cleanup(union_decl, field):
			uses_iterative_cleanup = True
			break
		else:
			void

	uses_iterative_cleanup


pure func union_decl_has_cleanup(union_decl: CoreUnionDecl) -> Bool:
	var has_cleanup: Bool = False

	for variant in union_decl.variants:
		if union_variant_has_cleanup(variant):
			has_cleanup = True
			break
		else:
			void

	has_cleanup


pure func union_decl_uses_iterative_cleanup(union_decl: CoreUnionDecl) -> Bool:
	var uses_iterative_cleanup: Bool = False

	for variant in union_decl.variants:
		if union_variant_uses_iterative_cleanup(union_decl, variant):
			uses_iterative_cleanup = True
			break
		else:
			void

	uses_iterative_cleanup


-- The emitter consumes this payload-free enum. It performs the same
-- short-circuiting checks as the former emitter-local predicates and never
-- materializes dependency rows on the ordinary unannotated path.
pure func union_cleanup_kind(union_decl: CoreUnionDecl) -> UnionCleanupKind:
	if not union_decl_has_cleanup(union_decl):
		NoUnionCleanup
	else if union_decl_uses_iterative_cleanup(union_decl):
		IterativeUnionCleanup
	else:
		DirectUnionCleanup


pure func union_cleanup_plan(union_decl: CoreUnionDecl) -> UnionCleanupPlan:
	kind: UnionCleanupKind = union_cleanup_kind(union_decl)
	var dependencies: List[UnionCleanupDependency] = []

	for variant in union_decl.variants:
		for field in variant.fields:
			if release_policy_requires_cleanup(field.release_policy):
				dependencies = dependencies.append({
					typ = field.typ,
					release_policy = field.release_policy,
				})
			else:
				void

	facts: CoreLocalAllocationFacts = match kind:
		IterativeUnionCleanup:
			{
				may_allocate = [CleanupScratchAllocation],
				unknown = []
			}
		NoUnionCleanup | DirectUnionCleanup:
			EMPTY_ALLOCATION_FACTS

	{
		kind = kind,
		facts = facts,
		dependencies = dependencies
	}
