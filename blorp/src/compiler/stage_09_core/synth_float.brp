-- Core body synthesis for the concrete builtins in float.
--
-- These operations are backend intrinsics rather than C runtime builtins.
-- Keeping the bodies as ordinary Core calls lets each backend render its own
-- math instruction or library call.
import:
	ir:
		CoreCallKind(IntrinsicCall),
		CoreExpr(CallExpr, VarExpr, VoidExpr),
		CoreFunction,
		CoreParam,
		CoreSourceLoc(SyntheticSourceLoc),
		CoreType(NamedType, VoidType),
	synth_name: is_synthesis_candidate, synthesis_source_name


private FLOAT_MODULE: String = "float"

private FLOAT_TYPE: CoreType = NamedType("Float", [])

private BOOL_TYPE: CoreType = NamedType("Bool", [])


private pure func is_type(typ: CoreType, expected: String) -> Bool:
	match typ:
		NamedType(name, args):
			name == expected and args.is_empty()
		_:
			False


private pure func params_are_float(params: List[CoreParam], expected_arity: Int) -> Bool:
	if params.length() != expected_arity:
		False
	else:
		params.all(func(param): is_type(param.typ, "Float"))


private pure func param_exprs(params: List[CoreParam]) -> List[CoreExpr]:
	params.map(func(param):
		VarExpr(param.name, param.typ, SyntheticSourceLoc)
	)


private pure func intrinsic_body(
	name: String,
	params: List[CoreParam],
	return_type: CoreType,
) -> CoreExpr:
	CallExpr(
		IntrinsicCall("math_" + name),
		VoidExpr(VoidType, SyntheticSourceLoc),
		param_exprs(params),
		return_type,
		SyntheticSourceLoc,
	)


private pure func is_unary_float_name(name: String) -> Bool:
	(
		name == "sin"
		or name == "cos"
		or name == "tan"
		or name == "asin"
		or name == "acos"
		or name == "atan"
		or name == "sinh"
		or name == "cosh"
		or name == "tanh"
		or name == "asinh"
		or name == "acosh"
		or name == "atanh"
		or name == "exp"
		or name == "exp2"
		or name == "expm1"
		or name == "log"
		or name == "log2"
		or name == "log10"
		or name == "log1p"
		or name == "sqrt"
		or name == "cbrt"
		or name == "floor"
		or name == "ceil"
		or name == "round"
		or name == "trunc"
	)


pure func synthesize_float_body(function_info: CoreFunction) -> Option[CoreExpr]:
	if (
		not is_synthesis_candidate(function_info)
		or function_info.source_module != Some(FLOAT_MODULE)
	):
		None
	else:
		name ?= synthesis_source_name(function_info)
		binary_name = (
			name == "pow"
			or name == "atan2"
			or name == "hypot"
			or name == "fmod"
			or name == "copysign"
		)

		classification_name = name == "is_nan" or name == "is_inf" or name == "is_finite"

		if (
			is_unary_float_name(name)
			and params_are_float(function_info.params, 1)
			and is_type(function_info.return_type, "Float")
		):
			Some(intrinsic_body(name, function_info.params, FLOAT_TYPE))
		else if (
			binary_name
			and params_are_float(function_info.params, 2)
			and is_type(function_info.return_type, "Float")
		):
			Some(intrinsic_body(name, function_info.params, FLOAT_TYPE))
		else if (
			name == "fma"
			and params_are_float(function_info.params, 3)
			and is_type(function_info.return_type, "Float")
		):
			Some(intrinsic_body(name, function_info.params, FLOAT_TYPE))
		else if (
			classification_name
			and params_are_float(function_info.params, 1)
			and is_type(function_info.return_type, "Bool")
		):
			Some(intrinsic_body(name, function_info.params, BOOL_TYPE))
		else:
			None
