			TupleStackResultElement,
			TupleStructElement,
			TupleVoidElement,
		),
		CoreType,


private union CoreLogicalMapTask:
	MapCoreLogicalNode(CoreExpr)
	RebuildMappedCoreLogicalNode(CoreLogicalOp, CoreType, CoreSourceLoc)


pure func core_pattern_bound_names(pattern: CorePattern) -> List[String]:
	match pattern:
		NamePattern(name):
			[name]
		ConstructorPattern(_, args) | QualifiedConstructorPattern(_, _, args):
			args.flat_map(core_pattern_bound_names)
		TuplePattern(items) | OrPattern(items):
			items.flat_map(core_pattern_bound_names)
		ListPattern(items, spread):
			spread_names: List[String] = match spread:
				Some(spread_pattern):
					core_pattern_bound_names(spread_pattern)
				None:
					[]

			items
				.flat_map(core_pattern_bound_names)
				.concat(spread_names)
		WildcardPattern | LiteralPattern(_):
			[]


private pure func map_context_type(
	mapper: pure (CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (CoreType) -> CoreType],
	typ: CoreType,
) -> CoreType:
	match type_mapper:
		Some(mapper):
			mapper(typ)
		None:
			typ


private pure func map_context_exprs(
	items: List[CoreExpr],
	mapper: pure (CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (CoreType) -> CoreType],
) -> List[CoreExpr]:
	var mapped: List[CoreExpr] = []

	for item in items:
		mapped = mapped.append(mapper(item))

	mapped


private pure func map_context_params(
	params: List[CoreParam],
	mapper: pure (CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (CoreType) -> CoreType],
) -> List[CoreParam]:
	match type_mapper:
		None:
			params
		Some(_):
			var mapped: List[CoreParam] = []

			for param in params:
				mapped = mapped.append(
					{ param | typ = map_context_type(mapper, type_mapper, param.typ) },
				)

			mapped


private pure func map_context_loop_binder(
	binder: CoreLoopBinder,
	mapper: pure (CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (CoreType) -> CoreType],
) -> CoreLoopBinder:
	match type_mapper:
		None:
			binder
		Some(_):
			{ binder | typ = map_context_type(mapper, type_mapper, binder.typ) }


private pure func map_context_closure_captures(
	captures: List[CoreClosureCapture],
	mapper: pure (CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (CoreType) -> CoreType],
) -> List[CoreClosureCapture]:
	match type_mapper:
		None:
			captures
		Some(_):
			var mapped: List[CoreClosureCapture] = []

			for capture in captures:
				mapped = mapped.append(
					{ capture | typ = map_context_type(mapper, type_mapper, capture.typ) },
				)

			mapped


private pure func map_context_closure_create(
	closure: CoreClosureCreate,
	mapper: pure (CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (CoreType) -> CoreType],
) -> CoreClosureCreate:
	match type_mapper:
		None:
			closure
		Some(_):
			{ closure |
				captures = map_context_closure_captures(closure.captures, mapper, type_mapper)
			}


private pure func map_context_task_captures(
	captures: List[CoreTaskCapture],
	mapper: pure (CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (CoreType) -> CoreType],
) -> List[CoreTaskCapture]:
	match type_mapper:
		None:
			captures
		Some(_):
			var mapped: List[CoreTaskCapture] = []

			for capture in captures:
				mapped = mapped.append(
					{ capture | typ = map_context_type(mapper, type_mapper, capture.typ) },
				)

			mapped


private pure func map_context_task_closure(
	task: CoreTaskClosure,
	mapper: pure (CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (CoreType) -> CoreType],
) -> CoreTaskClosure:
	match type_mapper:
		None:
			task
		Some(_):
			{ task |
				captures = map_context_task_captures(task.captures, mapper, type_mapper),
				return_type = map_context_type(mapper, type_mapper, task.return_type)
			}


private pure func map_context_concurrently_loop_item_mode(
	item_mode: CoreConcurrentlyLoopItemMode,
	mapper: pure (CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (CoreType) -> CoreType],
) -> CoreConcurrentlyLoopItemMode:
	match type_mapper:
		None:
			item_mode
		Some(_):
			match item_mode:
				ConcurrentlyLoopCopyItem:
					ConcurrentlyLoopCopyItem
				ConcurrentlyLoopMoveResourceItem(move_item):
					ConcurrentlyLoopMoveResourceItem({ move_item |
							resource_type = map_context_type(
								mapper,
								type_mapper,
								move_item.resource_type,
							),
							error_type = map_context_type(mapper, type_mapper, move_item.error_type)
						})


private pure func map_context_accessor(
	accessor: CoreAccessor,
	mapper: pure (CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (CoreType) -> CoreType],
) -> CoreAccessor:
	match type_mapper:
		None:
			accessor
		Some(_):
			match accessor:
				RootAccessor:
					RootAccessor
				VariantFieldAccessor(parent, type_name, constructor_name, field_index):
					VariantFieldAccessor(
						map_context_accessor(parent, mapper, type_mapper),
						type_name,
						constructor_name,
						field_index,
					)
				ErasedVariantFieldAccessor(parent, type_name, constructor_name, field_index):
					ErasedVariantFieldAccessor(
						map_context_accessor(parent, mapper, type_mapper),
						type_name,
						constructor_name,
						field_index,
					)
				NullableOptionPayloadAccessor(parent):
					NullableOptionPayloadAccessor(map_context_accessor(parent, mapper, type_mapper))
				StackOptionPayloadAccessor(parent):
					StackOptionPayloadAccessor(map_context_accessor(parent, mapper, type_mapper))
				StackResultOkPayloadAccessor(parent):
					StackResultOkPayloadAccessor(map_context_accessor(parent, mapper, type_mapper))
				StackResultErrPayloadAccessor(parent):
					StackResultErrPayloadAccessor(map_context_accessor(parent, mapper, type_mapper))
				BoxedStackResultOkPayloadAccessor(parent, field_name):
					BoxedStackResultOkPayloadAccessor(
						map_context_accessor(parent, mapper, type_mapper),
						field_name,
					)
				BoxedStackResultErrPayloadAccessor(parent, field_name):
					BoxedStackResultErrPayloadAccessor(
						map_context_accessor(parent, mapper, type_mapper),
						field_name,
					)
				BoxedResultOkPayloadAccessor(parent):
					BoxedResultOkPayloadAccessor(map_context_accessor(parent, mapper, type_mapper))
				BoxedResultErrPayloadAccessor(parent):
					BoxedResultErrPayloadAccessor(map_context_accessor(parent, mapper, type_mapper))
				TupleFieldAccessor(parent, field_index, typ):
					TupleFieldAccessor(
						map_context_accessor(parent, mapper, type_mapper),
						field_index,
						map_context_type(mapper, type_mapper, typ),
					)
				ListElementAccessor(parent, index):
					ListElementAccessor(
						map_context_accessor(parent, mapper, type_mapper),
						index,
					)
				ListSpreadAccessor(parent, prefix_length):
					ListSpreadAccessor(
						map_context_accessor(parent, mapper, type_mapper),
						prefix_length,
					)


private pure func map_context_match_bindings(
	bindings: List[CoreMatchBinding],
	mapper: pure (CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (CoreType) -> CoreType],
) -> List[CoreMatchBinding]:
	match type_mapper:
		None:
			bindings
		Some(_):
			var mapped: List[CoreMatchBinding] = []

			for binding in bindings:
				mapped = mapped.append({ binding |
						typ = map_context_type(mapper, type_mapper, binding.typ),
						accessor = map_context_accessor(binding.accessor, mapper, type_mapper)
					})

			mapped


private pure func map_context_raw_match_cases(
	cases: List[CoreRawMatchCase],
	mapper: pure (CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (CoreType) -> CoreType],
) -> List[CoreRawMatchCase]:
	cases.map(func(match_case): {
			pattern = match_case.pattern,
			body = mapper(match_case.body)
		})


private pure func map_context_optional_expr(
	value: Option[CoreExpr],
	mapper: pure (CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (CoreType) -> CoreType],
) -> Option[CoreExpr]:
	match value:
		Some(expr):
			Some(mapper(expr))
		None:
			None


private pure func map_context_dict_literal_entry(
	mapper: pure (CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (CoreType) -> CoreType],
	entry: CoreDictLiteralEntry,
) -> CoreDictLiteralEntry:
	{
		key = mapper(entry.key),
		value = mapper(entry.value)
	}


private pure func map_context_boxed_storage_value(
	mapper: pure (CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (CoreType) -> CoreType],
	value: CoreBoxedStorageValue,
) -> CoreBoxedStorageValue:
	{ value | value = mapper(value.value) }


private pure func map_context_dict_entry(
	mapper: pure (CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (CoreType) -> CoreType],
	entry: CoreDictEntry,
) -> CoreDictEntry:
	{ entry |
		key = map_context_boxed_storage_value(mapper, type_mapper, entry.key),
		value = map_context_boxed_storage_value(mapper, type_mapper, entry.value)
	}


private pure func map_context_tuple_element(
	mapper: pure (CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (CoreType) -> CoreType],
	element: CoreTupleElement,
) -> CoreTupleElement:
	match element:
		TuplePrimElement(value):
			TuplePrimElement(mapper(value))
		TuplePointerElement(value):
			TuplePointerElement(mapper(value))
		TupleStructElement(value, c_type):
			TupleStructElement(mapper(value), c_type)
		TupleStackResultElement(value):
			TupleStackResultElement(mapper(value))
		TupleVoidElement:
			TupleVoidElement
		TupleFloatElement(value):
			TupleFloatElement(mapper(value))
		TupleFloat32Element(value):
			TupleFloat32Element(mapper(value))
		TupleFloat16Element(value):
			TupleFloat16Element(mapper(value))


private pure func map_context_literal_match_case(
	mapper: pure (CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (CoreType) -> CoreType],
	match_case: CoreLiteralMatchCase,
) -> CoreLiteralMatchCase:
	{ match_case |
		bindings = map_context_match_bindings(match_case.bindings, mapper, type_mapper),
		body = mapper(match_case.body)
	}


private pure func map_context_literal_match_fallback(
	fallback: CoreLiteralMatchFallback,
	mapper: pure (CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (CoreType) -> CoreType],
) -> CoreLiteralMatchFallback:
	match fallback:
		LiteralMatchFallbackBody(body):
			LiteralMatchFallbackBody(mapper(body))
		LiteralMatchFallbackBindings(bindings, body):
			LiteralMatchFallbackBindings(
				map_context_match_bindings(bindings, mapper, type_mapper),
				mapper(body),
			)
		LiteralMatchFallbackFail:
			LiteralMatchFallbackFail


private pure func map_context_constructor_literal_match(
	match_expr: CoreConstructorLiteralMatch,
	mapper: pure (CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (CoreType) -> CoreType],
) -> CoreConstructorLiteralMatch:
	{ match_expr |
		accessor = map_context_accessor(match_expr.accessor, mapper, type_mapper),
		scrutinee_type = map_context_type(mapper, type_mapper, match_expr.scrutinee_type),
		cases = map_context_literal_match_cases(match_expr.cases, mapper, type_mapper),
		fallback = map_context_literal_match_fallback(match_expr.fallback, mapper, type_mapper),
		result_type = map_context_type(mapper, type_mapper, match_expr.result_type)
	}


private pure func map_context_constructor_match_body(
	body: CoreConstructorMatchBody,
	mapper: pure (CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (CoreType) -> CoreType],
) -> CoreConstructorMatchBody:
	match body:
		ConstructorMatchBodyExpr(expr):
			ConstructorMatchBodyExpr(mapper(expr))
		ConstructorMatchBodyLiteral(match_expr):
			ConstructorMatchBodyLiteral(
				map_context_constructor_literal_match(
					match_expr,
					mapper,
					type_mapper,
				),
			)
		ConstructorMatchBodyLength(match_expr):
			ConstructorMatchBodyLength(
				map_context_constructor_length_match(
					match_expr,
					mapper,
					type_mapper,
				),
			)


private pure func map_context_constructor_length_branch(
	mapper: pure (CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (CoreType) -> CoreType],
	branch: CoreConstructorLengthMatchBranch,
) -> CoreConstructorLengthMatchBranch:
	{ branch |
		bindings = map_context_match_bindings(branch.bindings, mapper, type_mapper),
		body = map_context_constructor_match_body(branch.body, mapper, type_mapper)
	}


private pure func map_context_constructor_length_case(
	mapper: pure (CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (CoreType) -> CoreType],
	match_case: CoreConstructorLengthMatchCase,
) -> CoreConstructorLengthMatchCase:
	{ match_case |
		branch = map_context_constructor_length_branch(mapper, type_mapper, match_case.branch)
	}


private pure func map_context_constructor_length_match(
	match_expr: CoreConstructorLengthMatch,
	mapper: pure (CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (CoreType) -> CoreType],
) -> CoreConstructorLengthMatch:
	mapped_geq: Option[CoreConstructorLengthMatchGeq] = match match_expr.geq:
		Some(geq):
			Some(
				{ geq |
					branch = map_context_constructor_length_branch(mapper, type_mapper, geq.branch)
				},
			)
		None:
			None

	mapped_fallback: Option[CoreConstructorLengthMatchBranch] = match match_expr.fallback:
		Some(branch):
			Some(map_context_constructor_length_branch(mapper, type_mapper, branch))
		None:
			None

	{ match_expr |
		accessor = map_context_accessor(match_expr.accessor, mapper, type_mapper),
		cases = map_context_constructor_length_cases(match_expr.cases, mapper, type_mapper),
		geq = mapped_geq,
		fallback = mapped_fallback,
		result_type = map_context_type(mapper, type_mapper, match_expr.result_type)
	}


private pure func map_context_constructor_match_case(
	mapper: pure (CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (CoreType) -> CoreType],
	match_case: CoreConstructorMatchCase,
) -> CoreConstructorMatchCase:
	{ match_case |
		accessor = map_context_accessor(match_case.accessor, mapper, type_mapper),
		bindings = map_context_match_bindings(match_case.bindings, mapper, type_mapper),
		body = map_context_constructor_match_body(match_case.body, mapper, type_mapper)
	}


private pure func map_context_constructor_match_fallback(
	fallback: CoreConstructorMatchFallback,
	mapper: pure (CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (CoreType) -> CoreType],
) -> CoreConstructorMatchFallback:
	match fallback:
		ConstructorMatchFallbackBody(body):
			ConstructorMatchFallbackBody(mapper(body))
		ConstructorMatchFallbackBindings(bindings, body):
			ConstructorMatchFallbackBindings(
				map_context_match_bindings(bindings, mapper, type_mapper),
				mapper(body),
			)
		ConstructorMatchFallbackFail:
			ConstructorMatchFallbackFail


private pure func map_context_concurrent_binding(
	mapper: pure (CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (CoreType) -> CoreType],
	binding: CoreConcurrentBinding,
) -> CoreConcurrentBinding:
	{ binding |
		typ = map_context_type(mapper, type_mapper, binding.typ),
		rhs = mapper(binding.rhs),
		task = map_context_task_closure(binding.task, mapper, type_mapper)
	}


private pure func map_context_pre_closure_concurrent_binding(
	mapper: pure (CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (CoreType) -> CoreType],
	binding: CorePreClosureConcurrentBinding,
) -> CorePreClosureConcurrentBinding:
	{ binding |
		typ = map_context_type(mapper, type_mapper, binding.typ),
		rhs = mapper(binding.rhs)
	}


private pure func map_context_select_arm_kind(
	kind: CoreSelectArmKind,
	mapper: pure (CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (CoreType) -> CoreType],
) -> CoreSelectArmKind:
	match kind:
		SelectRecvArm(recv):
			SelectRecvArm({ recv |
					elem_type = map_context_type(mapper, type_mapper, recv.elem_type),
					channel = mapper(recv.channel)
				})
		SelectSealedArm(channel):
			SelectSealedArm(mapper(channel))
		SelectAfterArm(timeout):
			SelectAfterArm(mapper(timeout))


private pure func map_context_select_arm(
	mapper: pure (CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (CoreType) -> CoreType],
	arm: CoreSelectArm,
) -> CoreSelectArm:
	{ arm |
		kind = map_context_select_arm_kind(arm.kind, mapper, type_mapper),
		body = mapper(arm.body)
	}


private pure func map_context_dict_literal_entries(
	entries: List[CoreDictLiteralEntry],
	mapper: pure (CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (CoreType) -> CoreType],
) -> List[CoreDictLiteralEntry]:
	var mapped: List[CoreDictLiteralEntry] = []

	for entry in entries:
		mapped = mapped.append(map_context_dict_literal_entry(mapper, type_mapper, entry))

	mapped


private pure func map_context_boxed_storage_values(
	values: List[CoreBoxedStorageValue],
	mapper: pure (CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (CoreType) -> CoreType],
) -> List[CoreBoxedStorageValue]:
	var mapped: List[CoreBoxedStorageValue] = []

	for value in values:
		mapped = mapped.append(map_context_boxed_storage_value(mapper, type_mapper, value))

	mapped


private pure func map_context_dict_entries(
	entries: List[CoreDictEntry],
	mapper: pure (CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (CoreType) -> CoreType],
) -> List[CoreDictEntry]:
	var mapped: List[CoreDictEntry] = []

	for entry in entries:
		mapped = mapped.append(map_context_dict_entry(mapper, type_mapper, entry))

	mapped


private pure func map_context_tuple_elements(
	elements: List[CoreTupleElement],
	mapper: pure (CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (CoreType) -> CoreType],
) -> List[CoreTupleElement]:
	var mapped: List[CoreTupleElement] = []

	for element in elements:
		mapped = mapped.append(map_context_tuple_element(mapper, type_mapper, element))

	mapped


private pure func map_context_literal_match_cases(
	cases: List[CoreLiteralMatchCase],
	mapper: pure (CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (CoreType) -> CoreType],
) -> List[CoreLiteralMatchCase]:
	var mapped: List[CoreLiteralMatchCase] = []

	for match_case in cases:
		mapped = mapped.append(map_context_literal_match_case(mapper, type_mapper, match_case))

	mapped


private pure func map_context_constructor_length_cases(
	cases: List[CoreConstructorLengthMatchCase],
	mapper: pure (CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (CoreType) -> CoreType],
) -> List[CoreConstructorLengthMatchCase]:
	var mapped: List[CoreConstructorLengthMatchCase] = []

	for match_case in cases:
		mapped = mapped.append(map_context_constructor_length_case(mapper, type_mapper, match_case))

	mapped


private pure func map_context_constructor_match_cases(
	cases: List[CoreConstructorMatchCase],
	mapper: pure (CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (CoreType) -> CoreType],
) -> List[CoreConstructorMatchCase]:
	var mapped: List[CoreConstructorMatchCase] = []

	for match_case in cases:
		mapped = mapped.append(map_context_constructor_match_case(mapper, type_mapper, match_case))

	mapped


private pure func map_context_record_fields(
	fields: List[CoreRecordFieldValue],
	mapper: pure (CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (CoreType) -> CoreType],
) -> List[CoreRecordFieldValue]:
	var mapped: List[CoreRecordFieldValue] = []

	for field in fields:
		mapped = mapped.append({ field | value = mapper(field.value) })

	mapped


private pure func map_context_tailrec_rebinds(
	rebinds: List[CoreTailrecListSpreadRebind],
	mapper: pure (CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (CoreType) -> CoreType],
) -> List[CoreTailrecListSpreadRebind]:
	var mapped: List[CoreTailrecListSpreadRebind] = []

	for rebind in rebinds:
		mapped = mapped.append({ rebind | value = mapper(rebind.value) })

	mapped


private pure func map_context_concurrent_bindings(
	bindings: List[CoreConcurrentBinding],
	mapper: pure (CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (CoreType) -> CoreType],
) -> List[CoreConcurrentBinding]:
	var mapped: List[CoreConcurrentBinding] = []

	for binding in bindings:
		mapped = mapped.append(map_context_concurrent_binding(mapper, type_mapper, binding))

	mapped


private pure func map_context_pre_closure_concurrent_bindings(
	bindings: List[CorePreClosureConcurrentBinding],
	mapper: pure (CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (CoreType) -> CoreType],
) -> List[CorePreClosureConcurrentBinding]:
	var mapped: List[CorePreClosureConcurrentBinding] = []

	for binding in bindings:
		mapped = mapped.append(
			map_context_pre_closure_concurrent_binding(
				mapper,
				type_mapper,
				binding,
			),
		)

	mapped


private pure func map_context_select_arms(
	arms: List[CoreSelectArm],
	mapper: pure (CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (CoreType) -> CoreType],
) -> List[CoreSelectArm]:
	var mapped: List[CoreSelectArm] = []

	for arm in arms:
		mapped = mapped.append(map_context_select_arm(mapper, type_mapper, arm))

	mapped


pure func map_core_exprs(
	items: List[CoreExpr],
	mapper: pure (CoreExpr) -> CoreExpr,
) -> List[CoreExpr]:
	items.map(mapper)


pure func map_core_optional_expr(
	value: Option[CoreExpr],
	mapper: pure (CoreExpr) -> CoreExpr,
) -> Option[CoreExpr]:
	match value:
		Some(expr):
			Some(mapper(expr))
		None:
			None


pure func map_core_dict_literal_entry(
	entry: CoreDictLiteralEntry,
	mapper: pure (CoreExpr) -> CoreExpr,
) -> CoreDictLiteralEntry:
	{
		key = mapper(entry.key),
		value = mapper(entry.value)
	}


pure func map_core_dict_literal_entries(
	entries: List[CoreDictLiteralEntry],
	mapper: pure (CoreExpr) -> CoreExpr,
) -> List[CoreDictLiteralEntry]:
	entries.map(func(entry): map_core_dict_literal_entry(entry, mapper))


private record CoreMatchResultMapContext {
	mapper: pure (List[CoreMatchBinding], CoreExpr) -> CoreExpr
}


private record ScopedCoreMatchResultMapContext {
	result_context: CoreMatchResultMapContext,
	bindings: List[CoreMatchBinding]
}


private pure func map_context_match_result(
	context: CoreMatchResultMapContext,
	bindings: List[CoreMatchBinding],
	expr: CoreExpr,
) -> CoreExpr:
	context.mapper(bindings, expr)


private pure func map_context_scoped_literal_match_case(
	context: ScopedCoreMatchResultMapContext,
	match_case: CoreLiteralMatchCase,
) -> CoreLiteralMatchCase:
	scoped_bindings: List[CoreMatchBinding] = context.bindings.concat(match_case.bindings)
	{ match_case |
		body = map_context_match_result(context.result_context, scoped_bindings, match_case.body)
	}


private pure func map_context_scoped_literal_match_cases(
	context: ScopedCoreMatchResultMapContext,
	cases: List[CoreLiteralMatchCase],
) -> List[CoreLiteralMatchCase]:
	var mapped: List[CoreLiteralMatchCase] = []

	for match_case in cases:
		mapped = mapped.append(map_context_scoped_literal_match_case(context, match_case))

	mapped


private pure func map_context_scoped_literal_match_fallback(
	context: ScopedCoreMatchResultMapContext,
	fallback: CoreLiteralMatchFallback,
) -> CoreLiteralMatchFallback:
	match fallback:
		LiteralMatchFallbackBody(body):
			LiteralMatchFallbackBody(
				map_context_match_result(
					context.result_context,
					context.bindings,
					body,
				),
			)
		LiteralMatchFallbackBindings(fallback_bindings, body):
			LiteralMatchFallbackBindings(
				fallback_bindings,
				map_context_match_result(
					context.result_context,
					context.bindings.concat(fallback_bindings),
					body,
				),
			)
		LiteralMatchFallbackFail:
			LiteralMatchFallbackFail


private pure func map_context_scoped_constructor_literal_match(
	context: ScopedCoreMatchResultMapContext,
	match_expr: CoreConstructorLiteralMatch,
) -> CoreConstructorLiteralMatch:
	{ match_expr |
		cases = map_context_scoped_literal_match_cases(context, match_expr.cases),
		fallback = map_context_scoped_literal_match_fallback(context, match_expr.fallback)
	}


private pure func map_context_scoped_constructor_match_body(
	context: ScopedCoreMatchResultMapContext,
	body: CoreConstructorMatchBody,
) -> CoreConstructorMatchBody:
	match body:
		ConstructorMatchBodyExpr(expr):
			ConstructorMatchBodyExpr(
				map_context_match_result(
					context.result_context,
					context.bindings,
					expr,
				),
			)
		ConstructorMatchBodyLiteral(match_expr):
			ConstructorMatchBodyLiteral(
				map_context_scoped_constructor_literal_match(
					context,
					match_expr,
				),
			)
		ConstructorMatchBodyLength(match_expr):
			ConstructorMatchBodyLength(
				map_context_scoped_constructor_length_match(
					context,
					match_expr,
				),
			)


private pure func map_context_scoped_constructor_length_branch(
	context: ScopedCoreMatchResultMapContext,
	branch: CoreConstructorLengthMatchBranch,
) -> CoreConstructorLengthMatchBranch:
	scoped_context: ScopedCoreMatchResultMapContext = {
		result_context = context.result_context,
		bindings = context.bindings.concat(branch.bindings)
	}
	{ branch | body = map_context_scoped_constructor_match_body(scoped_context, branch.body) }


private pure func map_context_scoped_constructor_length_case(
	context: ScopedCoreMatchResultMapContext,
	match_case: CoreConstructorLengthMatchCase,
) -> CoreConstructorLengthMatchCase:
	{ match_case |
		branch = map_context_scoped_constructor_length_branch(context, match_case.branch)
	}


private pure func map_context_scoped_constructor_length_cases(
	context: ScopedCoreMatchResultMapContext,
	cases: List[CoreConstructorLengthMatchCase],
) -> List[CoreConstructorLengthMatchCase]:
	var mapped: List[CoreConstructorLengthMatchCase] = []

	for match_case in cases:
		mapped = mapped.append(map_context_scoped_constructor_length_case(context, match_case))

	mapped


private pure func map_context_scoped_constructor_length_match(
	context: ScopedCoreMatchResultMapContext,
	match_expr: CoreConstructorLengthMatch,
) -> CoreConstructorLengthMatch:
	mapped_geq: Option[CoreConstructorLengthMatchGeq] = match match_expr.geq:
		Some(geq):
			Some(
				{ geq |
					branch = map_context_scoped_constructor_length_branch(context, geq.branch)
				},
			)
		None:
			None

	mapped_fallback: Option[CoreConstructorLengthMatchBranch] = match match_expr.fallback:
		Some(branch):
			Some(map_context_scoped_constructor_length_branch(context, branch))
		None:
			None

	{ match_expr |
		cases = map_context_scoped_constructor_length_cases(context, match_expr.cases),
		geq = mapped_geq,
		fallback = mapped_fallback
	}


private pure func map_context_scoped_constructor_match_case(
	context: ScopedCoreMatchResultMapContext,
	match_case: CoreConstructorMatchCase,
) -> CoreConstructorMatchCase:
	scoped_context: ScopedCoreMatchResultMapContext = {
		result_context = context.result_context,
		bindings = context.bindings.concat(match_case.bindings)
	}
	{ match_case |
		body = map_context_scoped_constructor_match_body(scoped_context, match_case.body)
	}


private pure func map_context_scoped_constructor_match_cases(
	context: ScopedCoreMatchResultMapContext,
	cases: List[CoreConstructorMatchCase],
) -> List[CoreConstructorMatchCase]:
	var mapped: List[CoreConstructorMatchCase] = []

	for match_case in cases:
		mapped = mapped.append(map_context_scoped_constructor_match_case(context, match_case))

	mapped


private pure func map_context_scoped_constructor_match_fallback(
	context: ScopedCoreMatchResultMapContext,
	fallback: CoreConstructorMatchFallback,
) -> CoreConstructorMatchFallback:
	match fallback:
		ConstructorMatchFallbackBody(body):
			ConstructorMatchFallbackBody(
				map_context_match_result(
					context.result_context,
					context.bindings,
					body,
				),
			)
		ConstructorMatchFallbackBindings(fallback_bindings, body):
			ConstructorMatchFallbackBindings(
				fallback_bindings,
				map_context_match_result(
					context.result_context,
					context.bindings.concat(fallback_bindings),
					body,
				),
			)
		ConstructorMatchFallbackFail:
			ConstructorMatchFallbackFail


pure func map_core_match_results_with_context[C](
	expr: CoreExpr,
	context: C,
	mapper: pure (C, List[CoreMatchBinding], CoreExpr) -> CoreExpr,
) -> CoreExpr:
	contextual_mapper: pure (List[CoreMatchBinding], CoreExpr) -> CoreExpr = pure func(
		bindings: List[CoreMatchBinding],
		result: CoreExpr,
	): mapper(context, bindings, result)
	result_context: CoreMatchResultMapContext = {mapper = contextual_mapper}
	scoped_context: ScopedCoreMatchResultMapContext = {
		result_context = result_context,
		bindings = []
	}

	match expr:
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			LiteralMatchExpr(
				scrutinee,
				map_context_scoped_literal_match_cases(scoped_context, cases),
				map_context_scoped_literal_match_fallback(scoped_context, fallback),
				typ,
				loc,
			)
		AccessorLiteralMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			AccessorLiteralMatchExpr(
				scrutinee,
				release_policy,
				map_context_scoped_constructor_literal_match(scoped_context, match_expr),
				typ,
				loc,
			)
		LengthMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			LengthMatchExpr(
				scrutinee,
				release_policy,
				map_context_scoped_constructor_length_match(scoped_context, match_expr),
				typ,
				loc,
			)
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			ConstructorMatchExpr(
				scrutinee,
				release_policy,
				map_context_scoped_constructor_match_cases(scoped_context, cases),
				map_context_scoped_constructor_match_fallback(scoped_context, fallback),
				typ,
				loc,
			)
		_:
			expr


private pure func apply_core_match_result_mapper(
	mapper: pure (List[CoreMatchBinding], CoreExpr) -> CoreExpr,
	bindings: List[CoreMatchBinding],
	expr: CoreExpr,
) -> CoreExpr:
	mapper(bindings, expr)


pure func map_core_match_results(
	expr: CoreExpr,
	mapper: pure (List[CoreMatchBinding], CoreExpr) -> CoreExpr,
) -> CoreExpr:
	map_core_match_results_with_context(expr, mapper, apply_core_match_result_mapper)


private pure func map_context_semantic_match_tree(
	tree: CoreSemanticMatchTree,
	mapper: pure (CoreExpr) -> CoreExpr,
) -> CoreSemanticMatchTree:
	match tree:
		SemanticMatchLeaf(bindings, body):
			SemanticMatchLeaf(bindings, mapper(body))
		SemanticMatchFail:
			SemanticMatchFail
		SemanticConstructorMatch(accessor, cases, fallback):
			SemanticConstructorMatch(
				accessor,
				cases.map(
					func(
						match_case,
					): { match_case |
						body = map_context_semantic_match_tree(match_case.body, mapper)
					},
				),
				fallback.map(
					func(fallback_tree): map_context_semantic_match_tree(fallback_tree, mapper),
				),
			)
		SemanticLiteralMatch(accessor, cases, fallback):
			SemanticLiteralMatch(
				accessor,
				cases.map(
					func(
						match_case,
					): { match_case |
						body = map_context_semantic_match_tree(match_case.body, mapper)
					},
				),
				map_context_semantic_match_tree(fallback, mapper),
			)
		SemanticLengthMatch(accessor, cases, geq, fallback):
			SemanticLengthMatch(
				accessor,
				cases.map(
					func(
						match_case,
					): { match_case |
						body = map_context_semantic_match_tree(match_case.body, mapper)
					},
				),
				geq.map(
					func(
						geq_case,
					): { geq_case |
						body = map_context_semantic_match_tree(geq_case.body, mapper)
					},
				),
				fallback.map(
					func(fallback_tree): map_context_semantic_match_tree(fallback_tree, mapper),
				),
			)


private pure func map_core_expr_children_with_map_context(
	expr: CoreExpr,
	mapper: pure (CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (CoreType) -> CoreType],
) -> CoreExpr:
	-- Keep callbacks as borrowed parameters. A value struct cannot own captured
	-- closure environments, while an ARC record here would allocate per node.
	match expr:
		LiteralExpr(literal, typ, loc):
			LiteralExpr(
				literal,
				map_context_type(mapper, type_mapper, typ),
				loc,
			)
		VarExpr(variable, typ, loc):
			VarExpr(
				variable,
				map_context_type(mapper, type_mapper, typ),
				loc,
			)
		VoidExpr(typ, loc):
			VoidExpr(
				map_context_type(mapper, type_mapper, typ),
				loc,
			)
		DebugBlockExpr(body, typ, loc):
			DebugBlockExpr(
				mapper(body),
				map_context_type(mapper, type_mapper, typ),
				loc,
			)
		CooperativeCheckpointExpr(typ, loc):
			CooperativeCheckpointExpr(
				map_context_type(mapper, type_mapper, typ),
				loc,
			)
		CallExpr(kind, callee, args, typ, loc):
			CallExpr(
				kind,
				mapper(callee),
				map_context_exprs(args, mapper, type_mapper),
				map_context_type(mapper, type_mapper, typ),
				loc,
			)
		BinaryExpr(op, left, right, typ, loc):
			BinaryExpr(
				op,
				mapper(left),
				mapper(right),
				map_context_type(mapper, type_mapper, typ),
				loc,
			)
		UnaryExpr(op, value, typ, loc):
			UnaryExpr(
				op,
				mapper(value),
				map_context_type(mapper, type_mapper, typ),
				loc,
			)
		LogicalExpr(op, left, right, typ, loc):
			LogicalExpr(
				op,
				mapper(left),
				mapper(right),
				map_context_type(mapper, type_mapper, typ),
				loc,
			)
		AssignExpr(variable, rhs, typ, loc):
			AssignExpr(
				variable,
				mapper(rhs),
				map_context_type(mapper, type_mapper, typ),
				loc,
			)
		CastExpr(value, typ, loc):
			CastExpr(
				mapper(value),
				map_context_type(mapper, type_mapper, typ),
				loc,
			)
		BoxExpr(box, typ, loc):
			BoxExpr(
				{ box |
					value = mapper(box.value),
					source_type = map_context_type(mapper, type_mapper, box.source_type)
				},
				map_context_type(
					mapper,
					type_mapper,
					typ,
				),
				loc,
			)
		UnboxExpr(kind, value, typ, loc):
			UnboxExpr(
				kind,
				mapper(value),
				map_context_type(mapper, type_mapper, typ),
				loc,
			)
		FieldExpr(value, field_name, typ, loc):
			FieldExpr(
				mapper(value),
				field_name,
				map_context_type(mapper, type_mapper, typ),
				loc,
			)
		TupleFieldExpr(value, field_index, typ, loc):
			TupleFieldExpr(
				mapper(value),
				field_index,
				map_context_type(mapper, type_mapper, typ),
				loc,
			)
		TupleExpr(items, typ, loc):
			TupleExpr(
				map_context_exprs(items, mapper, type_mapper),
				map_context_type(mapper, type_mapper, typ),
				loc,
			)
		TupleConstructExpr(construct, typ, loc):
			TupleConstructExpr(
				{ construct |
					elements = map_context_tuple_elements(construct.elements, mapper, type_mapper)
				},
				map_context_type(mapper, type_mapper, typ),
				loc,
			)
		VectorExpr(items, typ, loc):
			VectorExpr(
				map_context_exprs(items, mapper, type_mapper),
				map_context_type(mapper, type_mapper, typ),
				loc,
			)
		LambdaExpr(params, return_type, body, is_pure, typ, loc):
			LambdaExpr(
				map_context_params(params, mapper, type_mapper),
				map_context_type(mapper, type_mapper, return_type),
				mapper(body),
				is_pure,
				map_context_type(mapper, type_mapper, typ),
				loc,
			)
		ClosureCreateExpr(closure, typ, loc):
			ClosureCreateExpr(
				map_context_closure_create(closure, mapper, type_mapper),
				map_context_type(mapper, type_mapper, typ),
				loc,
			)
		ListConstructExpr(construct, typ, loc):
			ListConstructExpr(
				{ construct |
					elements = map_context_boxed_storage_values(
						construct.elements,
						mapper,
						type_mapper,
					)
				},
				map_context_type(mapper, type_mapper, typ),
				loc,
			)
		ListAllocExpr(alloc, typ, loc):
			ListAllocExpr(
				{ alloc | capacity = mapper(alloc.capacity) },
				map_context_type(mapper, type_mapper, typ),
				loc,
			)
		ListGetExpr(get, typ, loc):
			ListGetExpr(
				{ get |
					list = mapper(get.list),
					index = mapper(get.index)
				},
				map_context_type(
					mapper,
					type_mapper,
					typ,
				),
				loc,
			)
		ListHandoffExpr(handoff, typ, loc):
			ListHandoffExpr(
				{ handoff |
					source = mapper(handoff.source),
					source_type = map_context_type(mapper, type_mapper, handoff.source_type),
					result_type = map_context_type(mapper, type_mapper, handoff.result_type),
					capacity = mapper(handoff.capacity),
					body = mapper(handoff.body)
				},
				map_context_type(
					mapper,
					type_mapper,
					typ,
				),
				loc,
			)
		ListHandoffSetOwnedExpr(set, typ, loc):
			ListHandoffSetOwnedExpr(
				{ set |
					list = mapper(set.list),
					index = mapper(set.index),
					value = map_context_boxed_storage_value(mapper, type_mapper, set.value)
				},
				map_context_type(
					mapper,
					type_mapper,
					typ,
				),
				loc,
			)
		ListHandoffSetSourceSlotExpr(slot, typ, loc):
			ListHandoffSetSourceSlotExpr(
				{ slot |
					result = mapper(slot.result),
					out_index = mapper(slot.out_index),
					source = mapper(slot.source),
					source_index = mapper(slot.source_index)
				},
				map_context_type(
					mapper,
					type_mapper,
					typ,
				),
				loc,
			)
		StringByteReadExpr(read, typ, loc):
			StringByteReadExpr(
				{ read |
					source = mapper(read.source),
					index = mapper(read.index)
				},
				map_context_type(
					mapper,
					type_mapper,
					typ,
				),
				loc,
			)
		StringByteWriteExpr(write, typ, loc):
			StringByteWriteExpr(
				{ write |
					target = mapper(write.target),
					index = mapper(write.index),
					byte = mapper(write.byte)
				},
				map_context_type(
					mapper,
					type_mapper,
					typ,
				),
				loc,
			)
		StringByteCopyExpr(copy, typ, loc):
			StringByteCopyExpr(
				{ copy |
					dst = mapper(copy.dst),
					dst_pos = mapper(copy.dst_pos),
					src = mapper(copy.src),
					src_pos = mapper(copy.src_pos),
					len = mapper(copy.len)
				},
				map_context_type(
					mapper,
					type_mapper,
					typ,
				),
				loc,
			)
		StringSetLenExpr(set_len, typ, loc):
			StringSetLenExpr(
				{ set_len |
					target = mapper(set_len.target),
					len = mapper(set_len.len)
				},
				map_context_type(
					mapper,
					type_mapper,
					typ,
				),
				loc,
			)
		TensorLiteralExpr(literal, typ, loc):
			mapped_payload: CoreTensorLiteralPayload = match literal.payload:
				TensorRawLiteralPayload(raw):
					TensorRawLiteralPayload(
						{ raw | elements = map_context_exprs(raw.elements, mapper, type_mapper) },
					)
				TensorInlineStructLiteralPayload(inline_struct):
					TensorInlineStructLiteralPayload(
						{ inline_struct |
							elements = map_context_exprs(
								inline_struct.elements,
								mapper,
								type_mapper,
							)
						},
					)

			TensorLiteralExpr(
				{ literal | payload = mapped_payload },
				map_context_type(mapper, type_mapper, typ),
				loc,
			)
		TensorBoxedLiteralExpr(literal, typ, loc):
			TensorBoxedLiteralExpr(
				{ literal |
					elements = map_context_boxed_storage_values(
						literal.elements,
						mapper,
						type_mapper,
					)
				},
				map_context_type(mapper, type_mapper, typ),
				loc,
			)
		TensorPackedLiteralExpr(literal, typ, loc):
			TensorPackedLiteralExpr(
				{ literal | elements = map_context_exprs(literal.elements, mapper, type_mapper) },
				map_context_type(mapper, type_mapper, typ),
				loc,
			)
		TensorRawFillExpr(fill, typ, loc):
			TensorRawFillExpr(
				{ fill |
					value = mapper(fill.value),
					dims = map_context_exprs(fill.dims, mapper, type_mapper)
				},
				map_context_type(
					mapper,
					type_mapper,
					typ,
