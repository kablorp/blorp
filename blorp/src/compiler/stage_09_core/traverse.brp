		None


private pure func map_context_record_cow_field[C](
	context: C,
	mapper: pure (C, CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (C, CoreType) -> CoreType],
	field: CoreRecordCowField,
) -> Option[CoreRecordCowField]:
	mapped_replacement: Option[CoreExpr] = map_context_optional_expr(
		field.replacement,
		context, mapper,
		type_mapper,
	)

	if (
		map_context_keeps_types(type_mapper)
		and same_optional_core_expr(mapped_replacement, field.replacement)
	):
		None
	else:
		Some({ field |
				field = { field.field |
					typ = map_context_type(context, mapper, type_mapper, field.field.typ)
				},
				replacement = mapped_replacement
			})


