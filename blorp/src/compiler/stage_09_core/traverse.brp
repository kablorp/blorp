-- Shared shallow traversal helpers for Core expression containers.
--
-- Passes still own their phase-specific traversal rules. These helpers keep
-- the complete shallow child mapping and recurring container mapping in one
-- place. Context-aware variants pass managed state as ordinary arguments;
-- non-context mappers adapt to the same canonical implementations.
import:
	c_type_layout: type_requires_release
	ir:
		CoreAccessor(
			BoxedResultErrPayloadAccessor,
			BoxedResultOkPayloadAccessor,
			BoxedStackResultErrPayloadAccessor,
			BoxedStackResultOkPayloadAccessor,
			ErasedVariantFieldAccessor,
			ListElementAccessor,
			ListSpreadAccessor,
			NullableOptionPayloadAccessor,
			RootAccessor,
			StackOptionPayloadAccessor,
			StackResultErrPayloadAccessor,
			StackResultOkPayloadAccessor,
			TupleFieldAccessor,
			VariantFieldAccessor,
		),
		CoreBoxedStorageValue,
		CoreClosureCapture,
		CoreClosureCreate,
		CoreConcurrentBinding,
		CoreConcurrentlyLoopItemMode(ConcurrentlyLoopCopyItem, ConcurrentlyLoopMoveResourceItem),
		CoreConstructorLengthMatch,
		CoreConstructorLengthMatchBranch,
		CoreConstructorLengthMatchCase,
		CoreConstructorLengthMatchGeq,
		CoreConstructorLiteralMatch,
		CoreConstructorMatchBody(
			ConstructorMatchBodyExpr,
			ConstructorMatchBodyLength,
			ConstructorMatchBodyLiteral,
		),
		CoreConstructorMatchCase,
		CoreConstructorMatchFallback(
			ConstructorMatchFallbackBindings,
			ConstructorMatchFallbackBody,
			ConstructorMatchFallbackFail,
		),
		CoreDictEntry,
		CoreDictLiteralEntry,
		CoreExpr(
			AccessorLiteralMatchExpr,
			AssignExpr,
			BinaryExpr,
			BorrowLetExpr,
			BoxExpr,
			BreakExpr,
			CallExpr,
			CastExpr,
			ClosureCreateExpr,
			ConcurrentExpr,
			ConcurrentlyLoopExpr,
			ConstructorMatchExpr,
			ContinueExpr,
			CooperativeCheckpointExpr,
			DebugBlockExpr,
			DetachExpr,
			DictConstructExpr,
			DictExpr,
			DropExpr,
			DupExpr,
			FieldExpr,
			ForChannelExpr,
			ForDictExpr,
			ForListExpr,
			ForRangeExpr,
			ForResourceSourceExpr,
			ForSetExpr,
			ForStreamExpr,
			ForStringExpr,
			ForTensorExpr,
			IfExpr,
			LambdaExpr,
			LengthMatchExpr,
			LetExpr,
			ListAllocExpr,
			ListConstructExpr,
			ListGetExpr,
			ListHandoffExpr,
			ListHandoffSetOwnedExpr,
			ListHandoffSetSourceSlotExpr,
			ListRetainExpr,
			ListSetExpr,
			ListSwapExpr,
			LiteralExpr,
			LiteralMatchExpr,
			LogicalExpr,
			PreClosureConcurrentExpr,
			PreClosureConcurrentlyLoopExpr,
			PreClosureDetachExpr,
			RangeExpr,
			RawMatchExpr,
			RecordConstructExpr,
			RecordCowUpdateExpr,
			RecordExpr,
			RecordReuseExpr,
			RecordUpdateExpr,
			ResourceCleanupExitExpr,
			ResourceScopeExpr,
			SemanticMatchExpr,
			SelectExpr,
			SeqExpr,
			SetAllocExpr,
			StaticStringLiteralExpr,
			StringByteCopyExpr,
			StringByteReadExpr,
			StringByteWriteExpr,
			StringSetLenExpr,
			TailrecListSpreadLoopExpr,
			TailrecListSpreadRecurExpr,
			TailrecLoopExpr,
			TailrecRecurExpr,
			TensorBoxedLiteralExpr,
			TensorLiteralExpr,
			TensorPackedLiteralExpr,
			TensorRawFillExpr,
			TensorRawReadExpr,
			TensorRawViewLetExpr,
			TensorRawWriteExpr,
			TupleConstructExpr,
			TupleExpr,
			TupleFieldExpr,
			UnaryExpr,
			UnboxExpr,
			UnionConstructExpr,
			UnionReuseConstructExpr,
			VarExpr,
			VectorExpr,
			VoidExpr,
			WhileExpr,
		),
		CoreLiteralMatchCase,
		CoreLiteralMatchFallback(
			LiteralMatchFallbackBindings,
			LiteralMatchFallbackBody,
			LiteralMatchFallbackFail,
		),
		CoreLogicalOp,
		CoreLoopBinder,
		CoreMatchBinding,
		CoreParam,
		CorePattern(
			ConstructorPattern,
			ListPattern,
			LiteralPattern,
			NamePattern,
			OrPattern,
			QualifiedConstructorPattern,
			TuplePattern,
			WildcardPattern,
		),
		CorePreClosureConcurrentBinding,
		CoreRawMatchCase,
		CoreRecordCowField,
		CoreRecordFieldValue,
		CoreSelectArm,
		CoreSelectArmKind(SelectAfterArm, SelectRecvArm, SelectSealedArm),
		CoreSemanticConstructorMatchCase,
		CoreSemanticLengthMatchCase,
		CoreSemanticLengthMatchGeq,
		CoreSemanticLiteralMatchCase,
		CoreSemanticMatchTree(
			SemanticConstructorMatch,
			SemanticLengthMatch,
			SemanticLiteralMatch,
			SemanticMatchFail,
			SemanticMatchLeaf,
		),
		CoreSourceLoc,
		CoreTailrecListSpreadRebind,
		CoreTaskCapture,
		CoreTaskClosure,
		CoreTensorLiteralPayload(TensorInlineStructLiteralPayload, TensorRawLiteralPayload),
		CoreTupleElement(
			TupleFloat16Element,
			TupleFloat32Element,
			TupleFloatElement,
			TuplePointerElement,
			TuplePrimElement,
			TupleStackResultElement,
			TupleStructElement,
			TupleVoidElement,
		),
		CoreType,


-- Allocation identity for Core values. The helpers below return the original
-- node, list, or container whenever every mapped child came back as the same
-- allocation, so a pass that rewrites a handful of nodes stops reallocating
-- the whole tree behind itself. Core is immutable value data, so sharing a
-- subtree between a pass's input and its output is safe.
--
-- These bind straight to the runtime primitive rather than calling the generic
-- `memory.same_object`, because the pinned bootstrap compiler
-- (dev-8341b419d990) cannot project a builtin name it has never seen. Once the
-- bootstrap pin moves past the commit that introduced `blorp_same_object`,
-- delete this block and import `memory: same_object` instead.
foreign:
	private pure func same_core_expr(left: CoreExpr, right: CoreExpr) -> Bool = "blorp_same_object"
	private pure func same_core_type(left: CoreType, right: CoreType) -> Bool = "blorp_same_object"


private union CoreLogicalMapTask:
	MapCoreLogicalNode(CoreExpr)
	RebuildMappedCoreLogicalNode(CoreExpr)


pure func core_pattern_binds_name(pattern: CorePattern, target: String) -> Bool:
	match pattern:
		NamePattern(name):
			name == target
		ConstructorPattern(_, args) | QualifiedConstructorPattern(_, _, args):
			args.any(func(arg): core_pattern_binds_name(arg, target))
		TuplePattern(items) | OrPattern(items):
			items.any(func(item): core_pattern_binds_name(item, target))
		ListPattern(items, spread):
			if items.any(func(item): core_pattern_binds_name(item, target)):
				True
			else:
				match spread:
					Some(spread_pattern):
						core_pattern_binds_name(spread_pattern, target)
					None:
						False
		WildcardPattern | LiteralPattern(_):
			False


pure func core_pattern_bound_names(pattern: CorePattern) -> List[String]:
	match pattern:
		NamePattern(name):
			[name]
		ConstructorPattern(_, args) | QualifiedConstructorPattern(_, _, args):
			args.flat_map(core_pattern_bound_names)
		TuplePattern(items) | OrPattern(items):
			items.flat_map(core_pattern_bound_names)
		ListPattern(items, spread):
			spread_names: List[String] = match spread:
				Some(spread_pattern):
					core_pattern_bound_names(spread_pattern)
				None:
					[]

			items
				.flat_map(core_pattern_bound_names)
				.concat(spread_names)
		WildcardPattern | LiteralPattern(_):
			[]


private pure func map_context_type[C](
	context: C,
	mapper: pure (C, CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (C, CoreType) -> CoreType],
	typ: CoreType,
) -> CoreType:
	match type_mapper:
		Some(type_mapper_fn):
			type_mapper_fn(context, typ)
		None:
			typ


-- True when no type mapper was supplied, so every type-only container
-- (parameters, loop binders, captures, accessors, match bindings) comes back
-- as the original allocation and cannot have changed. Under a type mapper the
-- traversal rebuilds those containers exactly as it always has.
private pure func map_context_keeps_types[C](type_mapper: Option[pure (C, CoreType) -> CoreType]) -> Bool:
	type_mapper.is_none()


-- The container mappers below answer `None` for "every child came back as the
-- same allocation", so a caller can keep its own input instead of allocating a
-- rebuilt container first. Lists copy the untouched prefix only once a child
-- actually changes.
private pure func map_context_exprs[C](
	items: List[CoreExpr],
	context: C,
	mapper: pure (C, CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (C, CoreType) -> CoreType],
) -> Option[List[CoreExpr]]:
	var mapped: List[CoreExpr] = []
	var changed: Bool = False
	var index: Int = 0

	for item in items:
		mapped_item: CoreExpr = mapper(context, item)

		if changed:
			mapped = mapped.append(mapped_item)
		else if not same_core_expr(mapped_item, item):
			mapped = items
				.take(index)
				.append(mapped_item)
			changed = True

		index += 1

	if changed:
		Some(mapped)
	else:
		None


private pure func map_context_params[C](
	params: List[CoreParam],
	context: C,
	mapper: pure (C, CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (C, CoreType) -> CoreType],
) -> List[CoreParam]:
	match type_mapper:
		None:
			params
		Some(_):
			var mapped: List[CoreParam] = []

			for param in params:
				mapped = mapped.append(
					{ param | typ = map_context_type(context, mapper, type_mapper, param.typ) },
				)

			mapped


private pure func map_context_loop_binder[C](
	binder: CoreLoopBinder,
	context: C,
	mapper: pure (C, CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (C, CoreType) -> CoreType],
) -> CoreLoopBinder:
	match type_mapper:
		None:
			binder
		Some(_):
			{ binder | typ = map_context_type(context, mapper, type_mapper, binder.typ) }


private pure func map_context_closure_captures[C](
	captures: List[CoreClosureCapture],
	context: C,
	mapper: pure (C, CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (C, CoreType) -> CoreType],
) -> List[CoreClosureCapture]:
	match type_mapper:
		None:
			captures
		Some(_):
			var mapped: List[CoreClosureCapture] = []

			for capture in captures:
				mapped = mapped.append(
					{ capture | typ = map_context_type(context, mapper, type_mapper, capture.typ) },
				)

			mapped


private pure func map_context_closure_create[C](
	closure: CoreClosureCreate,
	context: C,
	mapper: pure (C, CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (C, CoreType) -> CoreType],
) -> CoreClosureCreate:
	match type_mapper:
		None:
			closure
		Some(_):
			{ closure |
				captures = map_context_closure_captures(closure.captures, context, mapper, type_mapper)
			}


private pure func map_context_task_captures[C](
	captures: List[CoreTaskCapture],
	context: C,
	mapper: pure (C, CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (C, CoreType) -> CoreType],
) -> List[CoreTaskCapture]:
	match type_mapper:
		None:
			captures
		Some(_):
			var mapped: List[CoreTaskCapture] = []

			for capture in captures:
				mapped = mapped.append(
					{ capture | typ = map_context_type(context, mapper, type_mapper, capture.typ) },
				)

			mapped


private pure func map_context_task_closure[C](
	task: CoreTaskClosure,
	context: C,
	mapper: pure (C, CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (C, CoreType) -> CoreType],
) -> CoreTaskClosure:
	match type_mapper:
		None:
			task
		Some(_):
			{ task |
				captures = map_context_task_captures(task.captures, context, mapper, type_mapper),
				return_type = map_context_type(context, mapper, type_mapper, task.return_type)
			}


private pure func map_context_concurrently_loop_item_mode[C](
	item_mode: CoreConcurrentlyLoopItemMode,
	context: C,
	mapper: pure (C, CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (C, CoreType) -> CoreType],
) -> CoreConcurrentlyLoopItemMode:
	match type_mapper:
		None:
			item_mode
		Some(_):
			match item_mode:
				ConcurrentlyLoopCopyItem:
					ConcurrentlyLoopCopyItem
				ConcurrentlyLoopMoveResourceItem(move_item):
					ConcurrentlyLoopMoveResourceItem({ move_item |
							resource_type = map_context_type(
								context, mapper,
								type_mapper,
								move_item.resource_type,
							),
							error_type = map_context_type(context, mapper, type_mapper, move_item.error_type)
						})


private pure func map_context_accessor[C](
	accessor: CoreAccessor,
	context: C,
	mapper: pure (C, CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (C, CoreType) -> CoreType],
) -> CoreAccessor:
	match type_mapper:
		None:
			accessor
		Some(_):
			match accessor:
				RootAccessor:
					RootAccessor
				VariantFieldAccessor(parent, type_name, constructor_name, field_index):
					VariantFieldAccessor(
						map_context_accessor(parent, context, mapper, type_mapper),
						type_name,
						constructor_name,
						field_index,
					)
				ErasedVariantFieldAccessor(parent, type_name, constructor_name, field_index):
					ErasedVariantFieldAccessor(
						map_context_accessor(parent, context, mapper, type_mapper),
						type_name,
						constructor_name,
						field_index,
					)
				NullableOptionPayloadAccessor(parent):
					NullableOptionPayloadAccessor(map_context_accessor(parent, context, mapper, type_mapper))
				StackOptionPayloadAccessor(parent):
					StackOptionPayloadAccessor(map_context_accessor(parent, context, mapper, type_mapper))
				StackResultOkPayloadAccessor(parent):
					StackResultOkPayloadAccessor(map_context_accessor(parent, context, mapper, type_mapper))
				StackResultErrPayloadAccessor(parent):
					StackResultErrPayloadAccessor(map_context_accessor(parent, context, mapper, type_mapper))
				BoxedStackResultOkPayloadAccessor(parent, field_name):
					BoxedStackResultOkPayloadAccessor(
						map_context_accessor(parent, context, mapper, type_mapper),
						field_name,
					)
				BoxedStackResultErrPayloadAccessor(parent, field_name):
					BoxedStackResultErrPayloadAccessor(
						map_context_accessor(parent, context, mapper, type_mapper),
						field_name,
					)
				BoxedResultOkPayloadAccessor(parent):
					BoxedResultOkPayloadAccessor(map_context_accessor(parent, context, mapper, type_mapper))
				BoxedResultErrPayloadAccessor(parent):
					BoxedResultErrPayloadAccessor(map_context_accessor(parent, context, mapper, type_mapper))
				TupleFieldAccessor(parent, field_index, typ):
					TupleFieldAccessor(
						map_context_accessor(parent, context, mapper, type_mapper),
						field_index,
						map_context_type(context, mapper, type_mapper, typ),
					)
				ListElementAccessor(parent, index):
					ListElementAccessor(
						map_context_accessor(parent, context, mapper, type_mapper),
						index,
					)
				ListSpreadAccessor(parent, prefix_length):
					ListSpreadAccessor(
						map_context_accessor(parent, context, mapper, type_mapper),
						prefix_length,
					)


private pure func map_context_match_bindings[C](
	bindings: List[CoreMatchBinding],
	context: C,
	mapper: pure (C, CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (C, CoreType) -> CoreType],
) -> List[CoreMatchBinding]:
	match type_mapper:
		None:
			bindings
		Some(_):
			var mapped: List[CoreMatchBinding] = []

			for binding in bindings:
				mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, binding.typ)

				mapped = mapped.append({ binding |
						typ = mapped_typ,
						accessor = map_context_accessor(binding.accessor, context, mapper, type_mapper),
						needs_release = type_requires_release(mapped_typ)
					})

			mapped


private pure func map_context_raw_match_cases[C](
	cases: List[CoreRawMatchCase],
	context: C,
	mapper: pure (C, CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (C, CoreType) -> CoreType],
) -> Option[List[CoreRawMatchCase]]:
	var mapped: List[CoreRawMatchCase] = []
	var changed: Bool = False
	var index: Int = 0

	for match_case in cases:
		mapped_body: CoreExpr = mapper(context, match_case.body)

		if changed:
			mapped = mapped.append({
				pattern = match_case.pattern,
				body = mapped_body,
			})
		else if not same_core_expr(mapped_body, match_case.body):
			mapped = cases
				.take(index)
				.append({
					pattern = match_case.pattern,
					body = mapped_body,
				})
			changed = True

		index += 1

	if changed:
		Some(mapped)
	else:
		None


private pure func map_context_optional_expr[C](
	value: Option[CoreExpr],
	context: C,
	mapper: pure (C, CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (C, CoreType) -> CoreType],
) -> Option[CoreExpr]:
	match value:
		Some(expr):
			mapped: CoreExpr = mapper(context, expr)

			if same_core_expr(mapped, expr):
				value
			else:
				Some(mapped)
		None:
			value


private pure func same_optional_core_expr(left: Option[CoreExpr], right: Option[CoreExpr]) -> Bool:
	match left:
		Some(left_expr):
			match right:
				Some(right_expr):
					same_core_expr(left_expr, right_expr)
				None:
					False
		None:
			right.is_none()


private pure func map_context_dict_literal_entry[C](
	context: C,
	mapper: pure (C, CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (C, CoreType) -> CoreType],
	entry: CoreDictLiteralEntry,
) -> Option[CoreDictLiteralEntry]:
	mapped_key: CoreExpr = mapper(context, entry.key)
	mapped_value: CoreExpr = mapper(context, entry.value)

	if same_core_expr(mapped_key, entry.key) and same_core_expr(mapped_value, entry.value):
		None
	else:
		Some({
			key = mapped_key,
			value = mapped_value,
		})


private pure func map_context_boxed_storage_value[C](
	context: C,
	mapper: pure (C, CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (C, CoreType) -> CoreType],
	value: CoreBoxedStorageValue,
) -> Option[CoreBoxedStorageValue]:
	mapped_value: CoreExpr = mapper(context, value.value)

	if same_core_expr(mapped_value, value.value):
		None
	else:
		Some({ value | value = mapped_value })


private pure func map_context_dict_entry[C](
	context: C,
	mapper: pure (C, CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (C, CoreType) -> CoreType],
	entry: CoreDictEntry,
) -> Option[CoreDictEntry]:
	mapped_key: Option[CoreBoxedStorageValue] = map_context_boxed_storage_value(
		context, mapper,
		type_mapper,
		entry.key,
	)
	mapped_value: Option[CoreBoxedStorageValue] = map_context_boxed_storage_value(
		context, mapper,
		type_mapper,
		entry.value,
	)

	if mapped_key.is_none() and mapped_value.is_none():
		None
	else:
		Some({ entry |
				key = mapped_key.get_or(entry.key),
				value = mapped_value.get_or(entry.value)
			})


private pure func map_context_tuple_element[C](
	context: C,
	mapper: pure (C, CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (C, CoreType) -> CoreType],
	element: CoreTupleElement,
) -> Option[CoreTupleElement]:
	match element:
		TuplePrimElement(value):
			mapped: CoreExpr = mapper(context, value)

			if same_core_expr(mapped, value):
				None
			else:
				Some(TuplePrimElement(mapped))
		TuplePointerElement(value):
			mapped: CoreExpr = mapper(context, value)

			if same_core_expr(mapped, value):
				None
			else:
				Some(TuplePointerElement(mapped))
		TupleStructElement(value, c_type):
			mapped: CoreExpr = mapper(context, value)

			if same_core_expr(mapped, value):
				None
			else:
				Some(TupleStructElement(mapped, c_type))
		TupleStackResultElement(value):
			mapped: CoreExpr = mapper(context, value)

			if same_core_expr(mapped, value):
				None
			else:
				Some(TupleStackResultElement(mapped))
		TupleVoidElement:
			None
		TupleFloatElement(value):
			mapped: CoreExpr = mapper(context, value)

			if same_core_expr(mapped, value):
				None
			else:
				Some(TupleFloatElement(mapped))
		TupleFloat32Element(value):
			mapped: CoreExpr = mapper(context, value)

			if same_core_expr(mapped, value):
				None
			else:
				Some(TupleFloat32Element(mapped))
		TupleFloat16Element(value):
			mapped: CoreExpr = mapper(context, value)

			if same_core_expr(mapped, value):
				None
			else:
				Some(TupleFloat16Element(mapped))


private pure func map_context_literal_match_case[C](
	context: C,
	mapper: pure (C, CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (C, CoreType) -> CoreType],
	match_case: CoreLiteralMatchCase,
) -> Option[CoreLiteralMatchCase]:
	mapped_body: CoreExpr = mapper(context, match_case.body)

	if map_context_keeps_types(type_mapper) and same_core_expr(mapped_body, match_case.body):
		None
	else:
		Some({ match_case |
				bindings = map_context_match_bindings(match_case.bindings, context, mapper, type_mapper),
				body = mapped_body
			})


private pure func map_context_literal_match_fallback[C](
	fallback: CoreLiteralMatchFallback,
	context: C,
	mapper: pure (C, CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (C, CoreType) -> CoreType],
) -> Option[CoreLiteralMatchFallback]:
	match fallback:
		LiteralMatchFallbackBody(body):
			mapped: CoreExpr = mapper(context, body)

			if same_core_expr(mapped, body):
				None
			else:
				Some(LiteralMatchFallbackBody(mapped))
		LiteralMatchFallbackBindings(bindings, body):
			mapped: CoreExpr = mapper(context, body)

			if map_context_keeps_types(type_mapper) and same_core_expr(mapped, body):
				None
			else:
				Some(
					LiteralMatchFallbackBindings(
						map_context_match_bindings(bindings, context, mapper, type_mapper),
						mapped,
					),
				)
		LiteralMatchFallbackFail:
			None


private pure func map_context_constructor_literal_match[C](
	match_expr: CoreConstructorLiteralMatch,
	context: C,
	mapper: pure (C, CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (C, CoreType) -> CoreType],
) -> Option[CoreConstructorLiteralMatch]:
	mapped_cases: Option[List[CoreLiteralMatchCase]] = map_context_literal_match_cases(
		match_expr.cases,
		context, mapper,
		type_mapper,
	)
	mapped_fallback: Option[CoreLiteralMatchFallback] = map_context_literal_match_fallback(
		match_expr.fallback,
		context, mapper,
		type_mapper,
	)

	if (
		map_context_keeps_types(type_mapper)
		and mapped_cases.is_none()
		and mapped_fallback.is_none()
	):
		None
	else:
		Some({ match_expr |
				accessor = map_context_accessor(match_expr.accessor, context, mapper, type_mapper),
				scrutinee_type = map_context_type(context, mapper, type_mapper, match_expr.scrutinee_type),
				cases = mapped_cases.get_or(match_expr.cases),
				fallback = mapped_fallback.get_or(match_expr.fallback),
				result_type = map_context_type(context, mapper, type_mapper, match_expr.result_type)
			})


private pure func map_context_constructor_match_body[C](
	body: CoreConstructorMatchBody,
	context: C,
	mapper: pure (C, CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (C, CoreType) -> CoreType],
) -> Option[CoreConstructorMatchBody]:
	match body:
		ConstructorMatchBodyExpr(expr):
			mapped: CoreExpr = mapper(context, expr)

			if same_core_expr(mapped, expr):
				None
			else:
				Some(ConstructorMatchBodyExpr(mapped))
		ConstructorMatchBodyLiteral(match_expr):
			match map_context_constructor_literal_match(match_expr, context, mapper, type_mapper):
				Some(mapped_match):
					Some(ConstructorMatchBodyLiteral(mapped_match))
				None:
					None
		ConstructorMatchBodyLength(match_expr):
			match map_context_constructor_length_match(match_expr, context, mapper, type_mapper):
				Some(mapped_match):
					Some(ConstructorMatchBodyLength(mapped_match))
				None:
					None


private pure func map_context_constructor_length_branch[C](
	context: C,
	mapper: pure (C, CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (C, CoreType) -> CoreType],
	branch: CoreConstructorLengthMatchBranch,
) -> Option[CoreConstructorLengthMatchBranch]:
	mapped_body: Option[CoreConstructorMatchBody] = map_context_constructor_match_body(
		branch.body,
		context, mapper,
		type_mapper,
	)

	if map_context_keeps_types(type_mapper) and mapped_body.is_none():
		None
	else:
		Some({ branch |
				bindings = map_context_match_bindings(branch.bindings, context, mapper, type_mapper),
				body = mapped_body.get_or(branch.body)
			})


private pure func map_context_constructor_length_case[C](
	context: C,
	mapper: pure (C, CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (C, CoreType) -> CoreType],
	match_case: CoreConstructorLengthMatchCase,
) -> Option[CoreConstructorLengthMatchCase]:
	match map_context_constructor_length_branch(context, mapper, type_mapper, match_case.branch):
		Some(mapped_branch):
			Some({ match_case | branch = mapped_branch })
		None:
			None


private pure func map_context_constructor_length_match[C](
	match_expr: CoreConstructorLengthMatch,
	context: C,
	mapper: pure (C, CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (C, CoreType) -> CoreType],
) -> Option[CoreConstructorLengthMatch]:
	mapped_cases: Option[List[CoreConstructorLengthMatchCase]] = map_context_constructor_length_cases(
		match_expr.cases,
		context, mapper,
		type_mapper,
	)

	var geq_changed: Bool = False

	mapped_geq: Option[CoreConstructorLengthMatchGeq] = match match_expr.geq:
		Some(geq):
			match map_context_constructor_length_branch(context, mapper, type_mapper, geq.branch):
				Some(mapped_branch):
					geq_changed = True
					Some({ geq | branch = mapped_branch })
				None:
					match_expr.geq
		None:
			match_expr.geq

	var fallback_changed: Bool = False

	mapped_fallback: Option[CoreConstructorLengthMatchBranch] = match match_expr.fallback:
		Some(branch):
			match map_context_constructor_length_branch(context, mapper, type_mapper, branch):
				Some(mapped_branch):
					fallback_changed = True
					Some(mapped_branch)
				None:
					match_expr.fallback
		None:
			match_expr.fallback

	if (
		map_context_keeps_types(type_mapper)
		and mapped_cases.is_none()
		and not geq_changed
		and not fallback_changed
	):
		None
	else:
		Some({ match_expr |
				accessor = map_context_accessor(match_expr.accessor, context, mapper, type_mapper),
				cases = mapped_cases.get_or(match_expr.cases),
				geq = mapped_geq,
				fallback = mapped_fallback,
				result_type = map_context_type(context, mapper, type_mapper, match_expr.result_type)
			})


private pure func map_context_constructor_match_case[C](
	context: C,
	mapper: pure (C, CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (C, CoreType) -> CoreType],
	match_case: CoreConstructorMatchCase,
) -> Option[CoreConstructorMatchCase]:
	mapped_body: Option[CoreConstructorMatchBody] = map_context_constructor_match_body(
		match_case.body,
		context, mapper,
		type_mapper,
	)

	if map_context_keeps_types(type_mapper) and mapped_body.is_none():
		None
	else:
		Some({ match_case |
				accessor = map_context_accessor(match_case.accessor, context, mapper, type_mapper),
				bindings = map_context_match_bindings(match_case.bindings, context, mapper, type_mapper),
				body = mapped_body.get_or(match_case.body)
			})


private pure func map_context_constructor_match_fallback[C](
	fallback: CoreConstructorMatchFallback,
	context: C,
	mapper: pure (C, CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (C, CoreType) -> CoreType],
) -> Option[CoreConstructorMatchFallback]:
	match fallback:
		ConstructorMatchFallbackBody(body):
			mapped: CoreExpr = mapper(context, body)

			if same_core_expr(mapped, body):
				None
			else:
				Some(ConstructorMatchFallbackBody(mapped))
		ConstructorMatchFallbackBindings(bindings, body):
			mapped: CoreExpr = mapper(context, body)

			if map_context_keeps_types(type_mapper) and same_core_expr(mapped, body):
				None
			else:
				Some(
					ConstructorMatchFallbackBindings(
						map_context_match_bindings(bindings, context, mapper, type_mapper),
						mapped,
					),
				)
		ConstructorMatchFallbackFail:
			None


private pure func map_context_concurrent_binding[C](
	context: C,
	mapper: pure (C, CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (C, CoreType) -> CoreType],
	binding: CoreConcurrentBinding,
) -> Option[CoreConcurrentBinding]:
	mapped_rhs: CoreExpr = mapper(context, binding.rhs)

	if map_context_keeps_types(type_mapper) and same_core_expr(mapped_rhs, binding.rhs):
		None
	else:
		Some({ binding |
				typ = map_context_type(context, mapper, type_mapper, binding.typ),
				rhs = mapped_rhs,
				task = map_context_task_closure(binding.task, context, mapper, type_mapper)
			})


private pure func map_context_pre_closure_concurrent_binding[C](
	context: C,
	mapper: pure (C, CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (C, CoreType) -> CoreType],
	binding: CorePreClosureConcurrentBinding,
) -> Option[CorePreClosureConcurrentBinding]:
	mapped_rhs: CoreExpr = mapper(context, binding.rhs)
	mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, binding.typ)

	if same_core_expr(mapped_rhs, binding.rhs) and same_core_type(mapped_typ, binding.typ):
		None
	else:
		Some({ binding |
				typ = mapped_typ,
				rhs = mapped_rhs
			})


private pure func map_context_select_arm_kind[C](
	kind: CoreSelectArmKind,
	context: C,
	mapper: pure (C, CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (C, CoreType) -> CoreType],
) -> Option[CoreSelectArmKind]:
	match kind:
		SelectRecvArm(recv):
			mapped_channel: CoreExpr = mapper(context, recv.channel)
			mapped_elem_type: CoreType = map_context_type(context, mapper, type_mapper, recv.elem_type)

			if (
				same_core_expr(mapped_channel, recv.channel)
				and same_core_type(mapped_elem_type, recv.elem_type)
			):
				None
			else:
				Some(SelectRecvArm({ recv |
							elem_type = mapped_elem_type,
							channel = mapped_channel
						}))
		SelectSealedArm(channel):
			mapped: CoreExpr = mapper(context, channel)

			if same_core_expr(mapped, channel):
				None
			else:
				Some(SelectSealedArm(mapped))
		SelectAfterArm(timeout):
			mapped: CoreExpr = mapper(context, timeout)

			if same_core_expr(mapped, timeout):
				None
			else:
				Some(SelectAfterArm(mapped))


private pure func map_context_select_arm[C](
	context: C,
	mapper: pure (C, CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (C, CoreType) -> CoreType],
	arm: CoreSelectArm,
) -> Option[CoreSelectArm]:
	mapped_kind: Option[CoreSelectArmKind] = map_context_select_arm_kind(
		arm.kind,
		context, mapper,
		type_mapper,
	)
	mapped_body: CoreExpr = mapper(context, arm.body)

	if mapped_kind.is_none() and same_core_expr(mapped_body, arm.body):
		None
	else:
		Some({ arm |
				kind = mapped_kind.get_or(arm.kind),
				body = mapped_body
			})


private pure func map_context_dict_literal_entries[C](
	entries: List[CoreDictLiteralEntry],
	context: C,
	mapper: pure (C, CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (C, CoreType) -> CoreType],
) -> Option[List[CoreDictLiteralEntry]]:
	var mapped: List[CoreDictLiteralEntry] = []
	var changed: Bool = False
	var index: Int = 0

	for entry in entries:
		match map_context_dict_literal_entry(context, mapper, type_mapper, entry):
			Some(mapped_entry):
				mapped = if changed:
					mapped.append(mapped_entry)
				else:
					entries
						.take(index)
						.append(mapped_entry)

				changed = True
			None:
				if changed:
					mapped = mapped.append(entry)
				else:
					void

		index += 1

	if changed:
		Some(mapped)
	else:
		None


