	var changed: Bool = False
	var index: Int = 0

	for field in fields:
		mapped_value: CoreExpr = mapper(context, field.value)

		if changed:
			mapped = mapped.append({ field | value = mapped_value })
		else if not same_core_expr(mapped_value, field.value):
			mapped = fields
				.take(index)
				.append({ field | value = mapped_value })
			changed = True

		index += 1

	if changed:
