				if changed:
					mapped = mapped.append(match_case)
				else:
					void

		index += 1

	if changed:
		Some(mapped)
	else:
		None


private pure func map_context_semantic_length_cases[C](
	cases: List[CoreSemanticLengthMatchCase],
	context: C,
	mapper: pure (C, CoreExpr) -> CoreExpr,
) -> Option[List[CoreSemanticLengthMatchCase]]:
	var mapped: List[CoreSemanticLengthMatchCase] = []
	var changed: Bool = False
	var index: Int = 0

	for match_case in cases:
		match map_context_semantic_match_tree(match_case.body, context, mapper):
			Some(mapped_body):
				mapped = if changed:
					mapped.append({ match_case | body = mapped_body })
				else:
					cases
						.take(index)
						.append({ match_case | body = mapped_body })

				changed = True
			None:
				if changed:
					mapped = mapped.append(match_case)
				else:
					void

		index += 1

	if changed:
		Some(mapped)
	else:
		None


private pure func map_context_semantic_match_tree[C](
	tree: CoreSemanticMatchTree,
	context: C,
	mapper: pure (C, CoreExpr) -> CoreExpr,
) -> Option[CoreSemanticMatchTree]:
	match tree:
		SemanticMatchLeaf(bindings, body):
			mapped: CoreExpr = mapper(context, body)

			if same_core_expr(mapped, body):
				None
			else:
				Some(SemanticMatchLeaf(bindings, mapped))
		SemanticMatchFail:
			None
		SemanticConstructorMatch(accessor, cases, fallback):
			mapped_cases: Option[List[CoreSemanticConstructorMatchCase]] = map_context_semantic_constructor_cases(
				cases,
				context, mapper,
			)

			var fallback_changed: Bool = False

			mapped_fallback: Option[CoreSemanticMatchTree] = match fallback:
				Some(fallback_tree):
					match map_context_semantic_match_tree(fallback_tree, context, mapper):
						Some(mapped_tree):
							fallback_changed = True
							Some(mapped_tree)
						None:
							fallback
				None:
					fallback

			if mapped_cases.is_none() and not fallback_changed:
				None
			else:
				Some(
					SemanticConstructorMatch(
						accessor,
						mapped_cases.get_or(cases),
						mapped_fallback,
					),
				)
		SemanticLiteralMatch(accessor, cases, fallback):
			mapped_cases: Option[List[CoreSemanticLiteralMatchCase]] = map_context_semantic_literal_cases(
				cases,
				context, mapper,
			)

			mapped_fallback: Option[CoreSemanticMatchTree] = map_context_semantic_match_tree(
				fallback,
				context, mapper,
			)

			if mapped_cases.is_none() and mapped_fallback.is_none():
				None
			else:
				Some(
					SemanticLiteralMatch(
						accessor,
						mapped_cases.get_or(cases),
						mapped_fallback.get_or(fallback),
					),
				)
		SemanticLengthMatch(accessor, cases, geq, fallback):
			mapped_cases: Option[List[CoreSemanticLengthMatchCase]] = map_context_semantic_length_cases(
				cases,
				context, mapper,
			)

			var geq_changed: Bool = False

			mapped_geq: Option[CoreSemanticLengthMatchGeq] = match geq:
				Some(geq_case):
					match map_context_semantic_match_tree(geq_case.body, context, mapper):
						Some(mapped_body):
							geq_changed = True
							Some({ geq_case | body = mapped_body })
						None:
							geq
				None:
					geq

			var fallback_changed: Bool = False

			mapped_fallback: Option[CoreSemanticMatchTree] = match fallback:
				Some(fallback_tree):
					match map_context_semantic_match_tree(fallback_tree, context, mapper):
						Some(mapped_tree):
							fallback_changed = True
							Some(mapped_tree)
						None:
							fallback
				None:
					fallback

			if (
				mapped_cases.is_none()
				and not geq_changed
				and not fallback_changed
			):
				None
			else:
				Some(
					SemanticLengthMatch(
						accessor,
						mapped_cases.get_or(cases),
						mapped_geq,
						mapped_fallback,
					),
				)


-- Leaves, and nodes whose only mapped child is a type.
--
-- Split out of `map_core_expr_children_with_map_context` so the recursive
-- traversal keeps a shallow native frame: one match over every constructor
-- reserves stack for all of its arms at once.
private pure func map_core_leaf_children_with_map_context[C](
	expr: CoreExpr,
	context: C,
	mapper: pure (C, CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (C, CoreType) -> CoreType],
) -> CoreExpr:
	match expr:
		LiteralExpr(literal, typ, loc):
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if same_core_type(mapped_typ, typ):
				expr
			else:
				LiteralExpr(literal, mapped_typ, loc)
		StaticStringLiteralExpr(id, value, typ, loc):
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if same_core_type(mapped_typ, typ):
				expr
			else:
				StaticStringLiteralExpr(id, value, mapped_typ, loc)
		VarExpr(variable, typ, loc):
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if same_core_type(mapped_typ, typ):
				expr
			else:
				VarExpr(variable, mapped_typ, loc)
		VoidExpr(typ, loc):
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if same_core_type(mapped_typ, typ):
				expr
			else:
				VoidExpr(mapped_typ, loc)
		CooperativeCheckpointExpr(typ, loc):
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if same_core_type(mapped_typ, typ):
				expr
			else:
				CooperativeCheckpointExpr(mapped_typ, loc)
		BreakExpr(typ, loc):
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if same_core_type(mapped_typ, typ):
				expr
			else:
				BreakExpr(mapped_typ, loc)
		ContinueExpr(typ, loc):
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if same_core_type(mapped_typ, typ):
				expr
			else:
				ContinueExpr(mapped_typ, loc)
		SetAllocExpr(alloc, typ, loc):
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if same_core_type(mapped_typ, typ):
				expr
			else:
				SetAllocExpr(alloc, mapped_typ, loc)
		ClosureCreateExpr(closure, typ, loc):
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if map_context_keeps_types(type_mapper) and same_core_type(mapped_typ, typ):
				expr
			else:
				ClosureCreateExpr(
					map_context_closure_create(closure, context, mapper, type_mapper),
					mapped_typ,
					loc,
				)
		DetachExpr(detached, typ, loc):
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if map_context_keeps_types(type_mapper) and same_core_type(mapped_typ, typ):
				expr
			else:
				DetachExpr(
					map_context_task_closure(detached, context, mapper, type_mapper),
					mapped_typ,
					loc,
				)
		_:
			expr


-- Operators, casts, field reads, and the simple binding and control forms.
--
-- Split out of `map_core_expr_children_with_map_context` so the recursive
-- traversal keeps a shallow native frame: one match over every constructor
-- reserves stack for all of its arms at once.
private pure func map_core_operator_children_with_map_context[C](
	expr: CoreExpr,
	context: C,
	mapper: pure (C, CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (C, CoreType) -> CoreType],
) -> CoreExpr:
	match expr:
		DebugBlockExpr(body, typ, loc):
			mapped_body: CoreExpr = mapper(context, body)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if same_core_expr(mapped_body, body) and same_core_type(mapped_typ, typ):
				expr
			else:
				DebugBlockExpr(mapped_body, mapped_typ, loc)
		BinaryExpr(op, left, right, typ, loc):
			mapped_left: CoreExpr = mapper(context, left)
			mapped_right: CoreExpr = mapper(context, right)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if (
				same_core_expr(mapped_left, left)
				and same_core_expr(mapped_right, right)
				and same_core_type(mapped_typ, typ)
			):
				expr
			else:
				BinaryExpr(op, mapped_left, mapped_right, mapped_typ, loc)
		UnaryExpr(op, value, typ, loc):
			mapped_value: CoreExpr = mapper(context, value)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if same_core_expr(mapped_value, value) and same_core_type(mapped_typ, typ):
				expr
			else:
				UnaryExpr(op, mapped_value, mapped_typ, loc)
		LogicalExpr(op, left, right, typ, loc):
			mapped_left: CoreExpr = mapper(context, left)
			mapped_right: CoreExpr = mapper(context, right)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if (
				same_core_expr(mapped_left, left)
				and same_core_expr(mapped_right, right)
				and same_core_type(mapped_typ, typ)
			):
				expr
			else:
				LogicalExpr(op, mapped_left, mapped_right, mapped_typ, loc)
		AssignExpr(variable, rhs, typ, loc):
			mapped_rhs: CoreExpr = mapper(context, rhs)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if same_core_expr(mapped_rhs, rhs) and same_core_type(mapped_typ, typ):
				expr
			else:
				AssignExpr(variable, mapped_rhs, mapped_typ, loc)
		CastExpr(value, typ, loc):
			mapped_value: CoreExpr = mapper(context, value)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if same_core_expr(mapped_value, value) and same_core_type(mapped_typ, typ):
				expr
			else:
				CastExpr(mapped_value, mapped_typ, loc)
		UnboxExpr(kind, value, typ, loc):
			mapped_value: CoreExpr = mapper(context, value)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if same_core_expr(mapped_value, value) and same_core_type(mapped_typ, typ):
				expr
			else:
				UnboxExpr(kind, mapped_value, mapped_typ, loc)
		FieldExpr(value, field_name, typ, loc):
			mapped_value: CoreExpr = mapper(context, value)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if same_core_expr(mapped_value, value) and same_core_type(mapped_typ, typ):
				expr
			else:
				FieldExpr(mapped_value, field_name, mapped_typ, loc)
		TupleFieldExpr(value, field_index, typ, loc):
			mapped_value: CoreExpr = mapper(context, value)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if same_core_expr(mapped_value, value) and same_core_type(mapped_typ, typ):
				expr
			else:
				TupleFieldExpr(mapped_value, field_index, mapped_typ, loc)
		BoxExpr(box, typ, loc):
			mapped_value: CoreExpr = mapper(context, box.value)
			mapped_source_type: CoreType = map_context_type(context, mapper, type_mapper, box.source_type)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if (
				same_core_expr(mapped_value, box.value)
				and same_core_type(mapped_source_type, box.source_type)
				and same_core_type(mapped_typ, typ)
			):
				expr
			else:
				BoxExpr(
					{ box |
						value = mapped_value,
						source_type = mapped_source_type
					},
					mapped_typ,
					loc,
				)
		PreClosureDetachExpr(detached, typ, loc):
			mapped_detached: CoreExpr = mapper(context, detached)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if same_core_expr(mapped_detached, detached) and same_core_type(mapped_typ, typ):
				expr
			else:
				PreClosureDetachExpr(mapped_detached, mapped_typ, loc)
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			mapped_value_type: CoreType = map_context_type(context, mapper, type_mapper, value_type)
			mapped_body: CoreExpr = mapper(context, body)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if (
				same_core_type(mapped_value_type, value_type)
				and same_core_expr(mapped_body, body)
				and same_core_type(mapped_typ, typ)
			):
				expr
			else:
				DupExpr(variable, mapped_value_type, retain_policy, mapped_body, mapped_typ, loc)
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			mapped_value_type: CoreType = map_context_type(context, mapper, type_mapper, value_type)
			mapped_body: CoreExpr = mapper(context, body)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if (
				same_core_type(mapped_value_type, value_type)
				and same_core_expr(mapped_body, body)
				and same_core_type(mapped_typ, typ)
			):
				expr
			else:
				DropExpr(variable, mapped_value_type, release_policy, mapped_body, mapped_typ, loc)
		LetExpr(variable, is_mutable, typ, rhs, body):
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)
			mapped_rhs: CoreExpr = mapper(context, rhs)
			mapped_body: CoreExpr = mapper(context, body)

			if (
				same_core_type(mapped_typ, typ)
				and same_core_expr(mapped_rhs, rhs)
				and same_core_expr(mapped_body, body)
			):
				expr
			else:
				LetExpr(variable, is_mutable, mapped_typ, mapped_rhs, mapped_body)
		BorrowLetExpr(variable, typ, rhs, body):
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)
			mapped_rhs: CoreExpr = mapper(context, rhs)
			mapped_body: CoreExpr = mapper(context, body)

			if (
				same_core_type(mapped_typ, typ)
				and same_core_expr(mapped_rhs, rhs)
				and same_core_expr(mapped_body, body)
			):
				expr
			else:
				BorrowLetExpr(variable, mapped_typ, mapped_rhs, mapped_body)
		SeqExpr(first, second):
			mapped_first: CoreExpr = mapper(context, first)
			mapped_second: CoreExpr = mapper(context, second)

			if same_core_expr(mapped_first, first) and same_core_expr(mapped_second, second):
				expr
			else:
				SeqExpr(mapped_first, mapped_second)
		WhileExpr(cond, body, typ, loc):
			mapped_cond: CoreExpr = mapper(context, cond)
			mapped_body: CoreExpr = mapper(context, body)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if (
				same_core_expr(mapped_cond, cond)
				and same_core_expr(mapped_body, body)
				and same_core_type(mapped_typ, typ)
			):
				expr
			else:
				WhileExpr(mapped_cond, mapped_body, mapped_typ, loc)
		RangeExpr(start, end_value, typ, loc):
			mapped_start: CoreExpr = mapper(context, start)
			mapped_end_value: CoreExpr = mapper(context, end_value)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if (
				same_core_expr(mapped_start, start)
				and same_core_expr(mapped_end_value, end_value)
				and same_core_type(mapped_typ, typ)
			):
				expr
			else:
				RangeExpr(mapped_start, mapped_end_value, mapped_typ, loc)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			mapped_cond: CoreExpr = mapper(context, cond)
			mapped_then_expr: CoreExpr = mapper(context, then_expr)
			mapped_else_expr: CoreExpr = mapper(context, else_expr)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if (
				same_core_expr(mapped_cond, cond)
				and same_core_expr(mapped_then_expr, then_expr)
				and same_core_expr(mapped_else_expr, else_expr)
				and same_core_type(mapped_typ, typ)
			):
				expr
			else:
				IfExpr(mapped_cond, mapped_then_expr, mapped_else_expr, mapped_typ, loc)
		_:
			expr


-- Calls, tuples, records, unions, dictionaries, and select arms.
--
-- Split out of `map_core_expr_children_with_map_context` so the recursive
-- traversal keeps a shallow native frame: one match over every constructor
-- reserves stack for all of its arms at once.
private pure func map_core_aggregate_children_with_map_context[C](
	expr: CoreExpr,
	context: C,
	mapper: pure (C, CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (C, CoreType) -> CoreType],
) -> CoreExpr:
	match expr:
		CallExpr(kind, callee, args, typ, loc):
			mapped_callee: CoreExpr = mapper(context, callee)
			mapped_args: Option[List[CoreExpr]] = map_context_exprs(args, context, mapper, type_mapper)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if (
				same_core_expr(mapped_callee, callee)
				and mapped_args.is_none()
				and same_core_type(mapped_typ, typ)
			):
				expr
			else:
				CallExpr(
					kind,
					mapped_callee,
					mapped_args.get_or(args),
					mapped_typ,
					loc,
				)
		TupleExpr(items, typ, loc):
			mapped_items: Option[List[CoreExpr]] = map_context_exprs(items, context, mapper, type_mapper)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if mapped_items.is_none() and same_core_type(mapped_typ, typ):
				expr
			else:
				TupleExpr(
					mapped_items.get_or(items),
					mapped_typ,
					loc,
				)
		TupleConstructExpr(construct, typ, loc):
			mapped_elements: Option[List[CoreTupleElement]] = map_context_tuple_elements(
				construct.elements,
				context, mapper,
				type_mapper,
			)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if mapped_elements.is_none() and same_core_type(mapped_typ, typ):
				expr
			else:
				TupleConstructExpr(
					{ construct | elements = mapped_elements.get_or(construct.elements) },
					mapped_typ,
					loc,
				)
		VectorExpr(items, typ, loc):
			mapped_items: Option[List[CoreExpr]] = map_context_exprs(items, context, mapper, type_mapper)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if mapped_items.is_none() and same_core_type(mapped_typ, typ):
				expr
			else:
				VectorExpr(
					mapped_items.get_or(items),
					mapped_typ,
					loc,
				)
		ListConstructExpr(construct, typ, loc):
			mapped_elements: Option[List[CoreBoxedStorageValue]] = map_context_boxed_storage_values(
				construct.elements,
				context, mapper,
				type_mapper,
			)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if mapped_elements.is_none() and same_core_type(mapped_typ, typ):
				expr
			else:
				ListConstructExpr(
					{ construct | elements = mapped_elements.get_or(construct.elements) },
					mapped_typ,
					loc,
				)
		DictExpr(entries, typ, loc):
			mapped_entries: Option[List[CoreDictLiteralEntry]] = map_context_dict_literal_entries(
				entries,
				context, mapper,
				type_mapper,
			)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if mapped_entries.is_none() and same_core_type(mapped_typ, typ):
				expr
			else:
				DictExpr(
					mapped_entries.get_or(entries),
					mapped_typ,
					loc,
				)
		DictConstructExpr(construct, typ, loc):
			mapped_entries: Option[List[CoreDictEntry]] = map_context_dict_entries(
				construct.entries,
				context, mapper,
				type_mapper,
			)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if mapped_entries.is_none() and same_core_type(mapped_typ, typ):
				expr
			else:
				DictConstructExpr(
					{ construct | entries = mapped_entries.get_or(construct.entries) },
					mapped_typ,
					loc,
				)
		RecordExpr(fields, typ, loc):
			mapped_fields: Option[List[CoreRecordFieldValue]] = map_context_record_fields(
				fields,
				context, mapper,
				type_mapper,
			)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if mapped_fields.is_none() and same_core_type(mapped_typ, typ):
				expr
			else:
				RecordExpr(
					mapped_fields.get_or(fields),
					mapped_typ,
					loc,
				)
		RecordUpdateExpr(base, fields, typ, loc):
			mapped_base: CoreExpr = mapper(context, base)
			mapped_fields: Option[List[CoreRecordFieldValue]] = map_context_record_fields(
				fields,
				context, mapper,
				type_mapper,
			)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if (
				same_core_expr(mapped_base, base)
				and mapped_fields.is_none()
				and same_core_type(mapped_typ, typ)
			):
				expr
			else:
				RecordUpdateExpr(
					mapped_base,
					mapped_fields.get_or(fields),
					mapped_typ,
					loc,
				)
		RecordReuseExpr(source, fields, typ, loc):
			mapped_source: CoreExpr = mapper(context, source)
			mapped_fields: Option[List[CoreRecordFieldValue]] = map_context_record_fields(
				fields,
				context, mapper,
				type_mapper,
			)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if (
				same_core_expr(mapped_source, source)
				and mapped_fields.is_none()
				and same_core_type(mapped_typ, typ)
			):
				expr
			else:
				RecordReuseExpr(
					mapped_source,
					mapped_fields.get_or(fields),
					mapped_typ,
					loc,
				)
		RecordCowUpdateExpr(source, fields, typ, loc):
			mapped_fields: Option[List[CoreRecordCowField]] = map_context_record_cow_fields(
				fields,
				context, mapper,
				type_mapper,
			)
			mapped_source: CoreExpr = mapper(context, source)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if (
				mapped_fields.is_none()
				and same_core_expr(mapped_source, source)
				and same_core_type(mapped_typ, typ)
			):
				expr
			else:
				RecordCowUpdateExpr(
					mapped_source,
					mapped_fields.get_or(fields),
					mapped_typ,
					loc,
				)
		RecordConstructExpr(type_name, fields, typ, loc):
			mapped_fields: Option[List[CoreRecordFieldValue]] = map_context_record_fields(
				fields,
				context, mapper,
				type_mapper,
			)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if mapped_fields.is_none() and same_core_type(mapped_typ, typ):
				expr
			else:
				RecordConstructExpr(
					type_name,
					mapped_fields.get_or(fields),
					mapped_typ,
					loc,
				)
		UnionConstructExpr(construct, typ, loc):
			mapped_args: Option[List[CoreBoxedStorageValue]] = map_context_boxed_storage_values(
				construct.args,
				context, mapper,
				type_mapper,
			)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if mapped_args.is_none() and same_core_type(mapped_typ, typ):
				expr
			else:
				UnionConstructExpr(
					{ construct | args = mapped_args.get_or(construct.args) },
					mapped_typ,
					loc,
				)
		UnionReuseConstructExpr(construct, typ, loc):
			mapped_source: CoreExpr = mapper(context, construct.source)
			mapped_args: Option[List[CoreBoxedStorageValue]] = map_context_boxed_storage_values(
				construct.args,
				context, mapper,
				type_mapper,
			)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if (
				same_core_expr(mapped_source, construct.source)
				and mapped_args.is_none()
				and same_core_type(mapped_typ, typ)
			):
				expr
			else:
				UnionReuseConstructExpr(
					{ construct |
						source = mapped_source,
						args = mapped_args.get_or(construct.args)
					},
					mapped_typ,
					loc,
				)
		SelectExpr(select_expr, typ, loc):
			mapped_arms: Option[List[CoreSelectArm]] = map_context_select_arms(
				select_expr,
				context, mapper,
				type_mapper,
			)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if mapped_arms.is_none() and same_core_type(mapped_typ, typ):
				expr
			else:
				SelectExpr(
					mapped_arms.get_or(select_expr),
					mapped_typ,
					loc,
				)
		_:
			expr


-- List, string, and tensor storage primitives.
--
-- Split out of `map_core_expr_children_with_map_context` so the recursive
-- traversal keeps a shallow native frame: one match over every constructor
-- reserves stack for all of its arms at once.
private pure func map_core_storage_children_with_map_context[C](
	expr: CoreExpr,
	context: C,
	mapper: pure (C, CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (C, CoreType) -> CoreType],
) -> CoreExpr:
	match expr:
		ListAllocExpr(alloc, typ, loc):
			mapped_capacity: CoreExpr = mapper(context, alloc.capacity)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if same_core_expr(mapped_capacity, alloc.capacity) and same_core_type(mapped_typ, typ):
				expr
			else:
				ListAllocExpr({ alloc | capacity = mapped_capacity }, mapped_typ, loc)
		ListGetExpr(get, typ, loc):
			mapped_list: CoreExpr = mapper(context, get.list)
			mapped_index: CoreExpr = mapper(context, get.index)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if (
				same_core_expr(mapped_list, get.list)
				and same_core_expr(mapped_index, get.index)
				and same_core_type(mapped_typ, typ)
			):
				expr
			else:
				ListGetExpr(
					{ get |
						list = mapped_list,
						index = mapped_index
					},
					mapped_typ,
					loc,
				)
		ListHandoffExpr(handoff, typ, loc):
			mapped_source: CoreExpr = mapper(context, handoff.source)
			mapped_source_type: CoreType = map_context_type(
				context, mapper,
				type_mapper,
				handoff.source_type,
			)
			mapped_result_type: CoreType = map_context_type(
				context, mapper,
				type_mapper,
				handoff.result_type,
			)
			mapped_capacity: CoreExpr = mapper(context, handoff.capacity)
			mapped_body: CoreExpr = mapper(context, handoff.body)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if (
				same_core_expr(mapped_source, handoff.source)
				and same_core_type(mapped_source_type, handoff.source_type)
				and same_core_type(mapped_result_type, handoff.result_type)
				and same_core_expr(mapped_capacity, handoff.capacity)
				and same_core_expr(mapped_body, handoff.body)
				and same_core_type(mapped_typ, typ)
			):
				expr
			else:
				ListHandoffExpr(
					{ handoff |
						source = mapped_source,
						source_type = mapped_source_type,
						result_type = mapped_result_type,
						capacity = mapped_capacity,
						body = mapped_body
					},
					mapped_typ,
					loc,
				)
		ListHandoffSetOwnedExpr(set, typ, loc):
			mapped_list: CoreExpr = mapper(context, set.list)
			mapped_index: CoreExpr = mapper(context, set.index)
			mapped_value: Option[CoreBoxedStorageValue] = map_context_boxed_storage_value(
				context, mapper,
				type_mapper,
				set.value,
			)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if (
				same_core_expr(mapped_list, set.list)
				and same_core_expr(mapped_index, set.index)
				and mapped_value.is_none()
				and same_core_type(mapped_typ, typ)
			):
				expr
			else:
				ListHandoffSetOwnedExpr(
					{ set |
						list = mapped_list,
						index = mapped_index,
						value = mapped_value.get_or(set.value)
					},
					mapped_typ,
					loc,
				)
		ListHandoffSetSourceSlotExpr(slot, typ, loc):
			mapped_result: CoreExpr = mapper(context, slot.result)
			mapped_out_index: CoreExpr = mapper(context, slot.out_index)
			mapped_source: CoreExpr = mapper(context, slot.source)
			mapped_source_index: CoreExpr = mapper(context, slot.source_index)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if (
				same_core_expr(mapped_result, slot.result)
				and same_core_expr(mapped_out_index, slot.out_index)
				and same_core_expr(mapped_source, slot.source)
				and same_core_expr(mapped_source_index, slot.source_index)
				and same_core_type(mapped_typ, typ)
			):
				expr
			else:
				ListHandoffSetSourceSlotExpr(
					{ slot |
						result = mapped_result,
						out_index = mapped_out_index,
						source = mapped_source,
						source_index = mapped_source_index
					},
					mapped_typ,
					loc,
				)
		ListRetainExpr(retain, typ, loc):
			mapped_list: CoreExpr = mapper(context, retain.list)
			mapped_value: Option[CoreBoxedStorageValue] = map_context_boxed_storage_value(
				context, mapper,
				type_mapper,
				retain.value,
			)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if (
				same_core_expr(mapped_list, retain.list)
				and mapped_value.is_none()
				and same_core_type(mapped_typ, typ)
			):
				expr
			else:
				ListRetainExpr(
					{ retain |
						list = mapped_list,
						value = mapped_value.get_or(retain.value)
					},
					mapped_typ,
					loc,
				)
		ListSetExpr(set, typ, loc):
			mapped_list: CoreExpr = mapper(context, set.list)
			mapped_index: CoreExpr = mapper(context, set.index)
			mapped_value: Option[CoreBoxedStorageValue] = map_context_boxed_storage_value(
				context, mapper,
				type_mapper,
				set.value,
			)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if (
				same_core_expr(mapped_list, set.list)
				and same_core_expr(mapped_index, set.index)
				and mapped_value.is_none()
				and same_core_type(mapped_typ, typ)
			):
				expr
			else:
				ListSetExpr(
					{ set |
						list = mapped_list,
						index = mapped_index,
						value = mapped_value.get_or(set.value)
					},
					mapped_typ,
					loc,
				)
		ListSwapExpr(swap, typ, loc):
			mapped_list: CoreExpr = mapper(context, swap.list)
			mapped_left_index: CoreExpr = mapper(context, swap.left_index)
			mapped_right_index: CoreExpr = mapper(context, swap.right_index)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if (
				same_core_expr(mapped_list, swap.list)
				and same_core_expr(mapped_left_index, swap.left_index)
				and same_core_expr(mapped_right_index, swap.right_index)
				and same_core_type(mapped_typ, typ)
			):
				expr
			else:
				ListSwapExpr(
					{ swap |
						list = mapped_list,
						left_index = mapped_left_index,
						right_index = mapped_right_index
					},
					mapped_typ,
					loc,
				)
		StringByteReadExpr(read, typ, loc):
			mapped_source: CoreExpr = mapper(context, read.source)
			mapped_index: CoreExpr = mapper(context, read.index)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if (
				same_core_expr(mapped_source, read.source)
				and same_core_expr(mapped_index, read.index)
				and same_core_type(mapped_typ, typ)
			):
				expr
			else:
				StringByteReadExpr(
					{ read |
						source = mapped_source,
						index = mapped_index
					},
					mapped_typ,
					loc,
				)
		StringByteWriteExpr(write, typ, loc):
			mapped_target: CoreExpr = mapper(context, write.target)
			mapped_index: CoreExpr = mapper(context, write.index)
			mapped_byte: CoreExpr = mapper(context, write.byte)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if (
				same_core_expr(mapped_target, write.target)
				and same_core_expr(mapped_index, write.index)
				and same_core_expr(mapped_byte, write.byte)
				and same_core_type(mapped_typ, typ)
			):
				expr
			else:
				StringByteWriteExpr(
					{ write |
						target = mapped_target,
						index = mapped_index,
						byte = mapped_byte
					},
					mapped_typ,
					loc,
				)
		StringByteCopyExpr(copy, typ, loc):
			mapped_dst: CoreExpr = mapper(context, copy.dst)
			mapped_dst_pos: CoreExpr = mapper(context, copy.dst_pos)
			mapped_src: CoreExpr = mapper(context, copy.src)
			mapped_src_pos: CoreExpr = mapper(context, copy.src_pos)
			mapped_len: CoreExpr = mapper(context, copy.len)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if (
				same_core_expr(mapped_dst, copy.dst)
				and same_core_expr(mapped_dst_pos, copy.dst_pos)
				and same_core_expr(mapped_src, copy.src)
				and same_core_expr(mapped_src_pos, copy.src_pos)
				and same_core_expr(mapped_len, copy.len)
				and same_core_type(mapped_typ, typ)
			):
				expr
			else:
				StringByteCopyExpr(
					{ copy |
						dst = mapped_dst,
						dst_pos = mapped_dst_pos,
						src = mapped_src,
						src_pos = mapped_src_pos,
						len = mapped_len
					},
					mapped_typ,
					loc,
				)
		StringSetLenExpr(set_len, typ, loc):
			mapped_target: CoreExpr = mapper(context, set_len.target)
			mapped_len: CoreExpr = mapper(context, set_len.len)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if (
				same_core_expr(mapped_target, set_len.target)
				and same_core_expr(mapped_len, set_len.len)
				and same_core_type(mapped_typ, typ)
			):
				expr
			else:
				StringSetLenExpr(
					{ set_len |
						target = mapped_target,
						len = mapped_len
					},
					mapped_typ,
					loc,
				)
		TensorLiteralExpr(literal, typ, loc):
			var payload_changed: Bool = False

			mapped_payload: CoreTensorLiteralPayload = match literal.payload:
				TensorRawLiteralPayload(raw):
					match map_context_exprs(raw.elements, context, mapper, type_mapper):
						Some(mapped_elements):
							payload_changed = True
							TensorRawLiteralPayload({ raw | elements = mapped_elements })
						None:
							literal.payload
				TensorInlineStructLiteralPayload(inline_struct):
					match map_context_exprs(inline_struct.elements, context, mapper, type_mapper):
						Some(mapped_elements):
							payload_changed = True
							TensorInlineStructLiteralPayload(
								{ inline_struct | elements = mapped_elements },
							)
						None:
							literal.payload

			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if not payload_changed and same_core_type(mapped_typ, typ):
				expr
			else:
				TensorLiteralExpr({ literal | payload = mapped_payload }, mapped_typ, loc)
		TensorBoxedLiteralExpr(literal, typ, loc):
			mapped_elements: Option[List[CoreBoxedStorageValue]] = map_context_boxed_storage_values(
				literal.elements,
				context, mapper,
				type_mapper,
			)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if mapped_elements.is_none() and same_core_type(mapped_typ, typ):
				expr
			else:
				TensorBoxedLiteralExpr(
					{ literal | elements = mapped_elements.get_or(literal.elements) },
					mapped_typ,
					loc,
				)
		TensorPackedLiteralExpr(literal, typ, loc):
			mapped_elements: Option[List[CoreExpr]] = map_context_exprs(
				literal.elements,
				context, mapper,
				type_mapper,
			)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if mapped_elements.is_none() and same_core_type(mapped_typ, typ):
				expr
			else:
				TensorPackedLiteralExpr(
					{ literal | elements = mapped_elements.get_or(literal.elements) },
					mapped_typ,
					loc,
				)
		TensorRawFillExpr(fill, typ, loc):
			mapped_value: CoreExpr = mapper(context, fill.value)
			mapped_dims: Option[List[CoreExpr]] = map_context_exprs(fill.dims, context, mapper, type_mapper)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if (
				same_core_expr(mapped_value, fill.value)
				and mapped_dims.is_none()
				and same_core_type(mapped_typ, typ)
			):
				expr
			else:
				TensorRawFillExpr(
					{ fill |
						value = mapped_value,
						dims = mapped_dims.get_or(fill.dims)
					},
					mapped_typ,
					loc,
				)
		TensorRawReadExpr(read, typ, loc):
			mapped_index: CoreExpr = mapper(context, read.index)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if same_core_expr(mapped_index, read.index) and same_core_type(mapped_typ, typ):
				expr
			else:
				TensorRawReadExpr({ read | index = mapped_index }, mapped_typ, loc)
		TensorRawWriteExpr(write, typ, loc):
			mapped_index: CoreExpr = mapper(context, write.index)
			mapped_value: CoreExpr = mapper(context, write.value)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if (
				same_core_expr(mapped_index, write.index)
				and same_core_expr(mapped_value, write.value)
				and same_core_type(mapped_typ, typ)
			):
				expr
			else:
				TensorRawWriteExpr(
					{ write |
						index = mapped_index,
						value = mapped_value
					},
					mapped_typ,
					loc,
				)
		TensorRawViewLetExpr(binding, body, typ, loc):
			mapped_source: CoreExpr = mapper(context, binding.source)
			mapped_body: CoreExpr = mapper(context, body)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if (
				same_core_expr(mapped_source, binding.source)
				and same_core_expr(mapped_body, body)
				and same_core_type(mapped_typ, typ)
			):
				expr
			else:
				TensorRawViewLetExpr(
					{ binding | source = mapped_source },
					mapped_body,
					mapped_typ,
					loc,
				)
		_:
			expr


-- Lambdas, tail-recursive loops, for loops, and resource scopes.
--
-- Split out of `map_core_expr_children_with_map_context` so the recursive
-- traversal keeps a shallow native frame: one match over every constructor
-- reserves stack for all of its arms at once.
private pure func map_core_loop_children_with_map_context[C](
	expr: CoreExpr,
	context: C,
	mapper: pure (C, CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (C, CoreType) -> CoreType],
) -> CoreExpr:
	match expr:
		LambdaExpr(params, return_type, body, is_pure, typ, loc):
			mapped_body: CoreExpr = mapper(context, body)
			mapped_return_type: CoreType = map_context_type(context, mapper, type_mapper, return_type)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if (
				map_context_keeps_types(type_mapper)
				and same_core_expr(mapped_body, body)
				and same_core_type(mapped_return_type, return_type)
				and same_core_type(mapped_typ, typ)
			):
				expr
			else:
				LambdaExpr(
					map_context_params(params, context, mapper, type_mapper),
					mapped_return_type,
					mapped_body,
					is_pure,
					mapped_typ,
					loc,
				)
		TailrecLoopExpr(params, return_type, body, loc):
			mapped_return_type: CoreType = map_context_type(context, mapper, type_mapper, return_type)
			mapped_body: CoreExpr = mapper(context, body)

			if (
				map_context_keeps_types(type_mapper)
				and same_core_type(mapped_return_type, return_type)
				and same_core_expr(mapped_body, body)
			):
				expr
			else:
				TailrecLoopExpr(
					map_context_params(params, context, mapper, type_mapper),
					mapped_return_type,
					mapped_body,
					loc,
				)
		TailrecRecurExpr(args, typ, loc):
			mapped_args: Option[List[CoreExpr]] = map_context_exprs(args, context, mapper, type_mapper)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if mapped_args.is_none() and same_core_type(mapped_typ, typ):
				expr
			else:
				TailrecRecurExpr(
					mapped_args.get_or(args),
					mapped_typ,
					loc,
				)
		TailrecListSpreadLoopExpr(loop, loc):
			mapped_return_type: CoreType = map_context_type(context, mapper, type_mapper, loop.return_type)
			mapped_list_param_type: CoreType = map_context_type(
				context, mapper,
				type_mapper,
				loop.list_param.typ,
			)
			mapped_body: CoreExpr = mapper(context, loop.body)

			if (
				map_context_keeps_types(type_mapper)
				and same_core_type(mapped_return_type, loop.return_type)
				and same_core_type(mapped_list_param_type, loop.list_param.typ)
				and same_core_expr(mapped_body, loop.body)
			):
				expr
			else:
				TailrecListSpreadLoopExpr(
					{ loop |
						params = map_context_params(loop.params, context, mapper, type_mapper),
						return_type = mapped_return_type,
						list_param = { loop.list_param | typ = mapped_list_param_type },
						body = mapped_body
					},
					loc,
				)
		TailrecListSpreadRecurExpr(rebinds, cursor_advance, typ, loc):
			mapped_rebinds: Option[List[CoreTailrecListSpreadRebind]] = map_context_tailrec_rebinds(
				rebinds,
				context, mapper,
				type_mapper,
			)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if mapped_rebinds.is_none() and same_core_type(mapped_typ, typ):
				expr
			else:
				TailrecListSpreadRecurExpr(
					mapped_rebinds.get_or(rebinds),
					cursor_advance,
					mapped_typ,
					loc,
				)
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			mapped_start: CoreExpr = mapper(context, start)
			mapped_end_value: CoreExpr = mapper(context, end_value)
			mapped_body: CoreExpr = mapper(context, body)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if (
				map_context_keeps_types(type_mapper)
				and same_core_expr(mapped_start, start)
				and same_core_expr(mapped_end_value, end_value)
				and same_core_expr(mapped_body, body)
				and same_core_type(mapped_typ, typ)
			):
				expr
			else:
				ForRangeExpr(
					map_context_loop_binder(binder, context, mapper, type_mapper),
					mapped_start,
					mapped_end_value,
					mapped_body,
					mapped_typ,
					loc,
				)
		ForChannelExpr(loop, typ, loc):
			mapped_iterable: CoreExpr = mapper(context, loop.iterable)
			mapped_body: CoreExpr = mapper(context, loop.body)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if (
				map_context_keeps_types(type_mapper)
				and same_core_expr(mapped_iterable, loop.iterable)
				and same_core_expr(mapped_body, loop.body)
				and same_core_type(mapped_typ, typ)
			):
				expr
			else:
				ForChannelExpr(
					{ loop |
						binder = map_context_loop_binder(loop.binder, context, mapper, type_mapper),
						iterable = mapped_iterable,
						body = mapped_body
					},
					mapped_typ,
					loc,
				)
		ForListExpr(loop, typ, loc):
			mapped_iterable: CoreExpr = mapper(context, loop.iterable)
			mapped_body: CoreExpr = mapper(context, loop.body)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if (
				map_context_keeps_types(type_mapper)
				and same_core_expr(mapped_iterable, loop.iterable)
				and same_core_expr(mapped_body, loop.body)
				and same_core_type(mapped_typ, typ)
			):
				expr
			else:
				ForListExpr(
					{ loop |
						binder = map_context_loop_binder(loop.binder, context, mapper, type_mapper),
						iterable = mapped_iterable,
						body = mapped_body
					},
					mapped_typ,
					loc,
				)
		ForStringExpr(loop, typ, loc):
			mapped_iterable: CoreExpr = mapper(context, loop.iterable)
			mapped_body: CoreExpr = mapper(context, loop.body)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if (
				map_context_keeps_types(type_mapper)
				and same_core_expr(mapped_iterable, loop.iterable)
				and same_core_expr(mapped_body, loop.body)
				and same_core_type(mapped_typ, typ)
			):
				expr
			else:
				ForStringExpr(
					{ loop |
						binder = map_context_loop_binder(loop.binder, context, mapper, type_mapper),
						iterable = mapped_iterable,
						body = mapped_body
					},
					mapped_typ,
					loc,
				)
		ForDictExpr(loop, typ, loc):
			mapped_iterable: CoreExpr = mapper(context, loop.iterable)
			mapped_body: CoreExpr = mapper(context, loop.body)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if (
				map_context_keeps_types(type_mapper)
				and same_core_expr(mapped_iterable, loop.iterable)
				and same_core_expr(mapped_body, loop.body)
				and same_core_type(mapped_typ, typ)
			):
				expr
			else:
				ForDictExpr(
					{ loop |
						binder = map_context_loop_binder(loop.binder, context, mapper, type_mapper),
						iterable = mapped_iterable,
						body = mapped_body
					},
					mapped_typ,
					loc,
				)
		ForSetExpr(loop, typ, loc):
			mapped_iterable: CoreExpr = mapper(context, loop.iterable)
			mapped_body: CoreExpr = mapper(context, loop.body)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if (
				map_context_keeps_types(type_mapper)
				and same_core_expr(mapped_iterable, loop.iterable)
				and same_core_expr(mapped_body, loop.body)
				and same_core_type(mapped_typ, typ)
			):
				expr
			else:
				ForSetExpr(
					{ loop |
						binder = map_context_loop_binder(loop.binder, context, mapper, type_mapper),
						iterable = mapped_iterable,
						body = mapped_body
					},
					mapped_typ,
					loc,
				)
		ForStreamExpr(loop, typ, loc):
			mapped_iterable: CoreExpr = mapper(context, loop.iterable)
			mapped_body: CoreExpr = mapper(context, loop.body)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if (
				map_context_keeps_types(type_mapper)
				and same_core_expr(mapped_iterable, loop.iterable)
				and same_core_expr(mapped_body, loop.body)
				and same_core_type(mapped_typ, typ)
			):
				expr
			else:
				ForStreamExpr(
					{ loop |
						binder = map_context_loop_binder(loop.binder, context, mapper, type_mapper),
						iterable = mapped_iterable,
						body = mapped_body
					},
					mapped_typ,
					loc,
				)
		ForResourceSourceExpr(loop, typ, loc):
			mapped_iterable: CoreExpr = mapper(context, loop.iterable)
			mapped_body: CoreExpr = mapper(context, loop.body)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if (
				map_context_keeps_types(type_mapper)
				and same_core_expr(mapped_iterable, loop.iterable)
				and same_core_expr(mapped_body, loop.body)
				and same_core_type(mapped_typ, typ)
			):
				expr
			else:
				ForResourceSourceExpr(
					{ loop |
						binder = map_context_loop_binder(loop.binder, context, mapper, type_mapper),
						iterable = mapped_iterable,
						body = mapped_body
					},
					mapped_typ,
					loc,
				)
		ForTensorExpr(loop, typ, loc):
			mapped_iterable: CoreExpr = mapper(context, loop.iterable)
			mapped_body: CoreExpr = mapper(context, loop.body)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if (
				map_context_keeps_types(type_mapper)
				and same_core_expr(mapped_iterable, loop.iterable)
				and same_core_expr(mapped_body, loop.body)
				and same_core_type(mapped_typ, typ)
			):
				expr
			else:
				ForTensorExpr(
					{ loop |
						binder = map_context_loop_binder(loop.binder, context, mapper, type_mapper),
						iterable = mapped_iterable,
						body = mapped_body
					},
					mapped_typ,
					loc,
				)
		ResourceScopeExpr(scope, typ, loc):
			mapped_scope_type: CoreType = map_context_type(context, mapper, type_mapper, scope.typ)
			mapped_acquire: CoreExpr = mapper(context, scope.acquire)
			mapped_body: CoreExpr = mapper(context, scope.body)
			mapped_cleanup: CoreExpr = mapper(context, scope.cleanup)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if (
				same_core_type(mapped_scope_type, scope.typ)
				and same_core_expr(mapped_acquire, scope.acquire)
				and same_core_expr(mapped_body, scope.body)
				and same_core_expr(mapped_cleanup, scope.cleanup)
				and same_core_type(mapped_typ, typ)
			):
				expr
			else:
				ResourceScopeExpr(
					{ scope |
						typ = mapped_scope_type,
						acquire = mapped_acquire,
						body = mapped_body,
						cleanup = mapped_cleanup
					},
					mapped_typ,
					loc,
				)
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			mapped_cleanups: Option[List[CoreExpr]] = map_context_exprs(
				cleanup_exit.cleanups,
				context, mapper,
				type_mapper,
			)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if mapped_cleanups.is_none() and same_core_type(mapped_typ, typ):
				expr
			else:
				ResourceCleanupExitExpr(
					{ cleanup_exit | cleanups = mapped_cleanups.get_or(cleanup_exit.cleanups) },
					mapped_typ,
					loc,
				)
		_:
			expr


-- Concurrent blocks and concurrently loops.
--
-- Split out of `map_core_expr_children_with_map_context` so the recursive
-- traversal keeps a shallow native frame: one match over every constructor
-- reserves stack for all of its arms at once.
private pure func map_core_concurrency_children_with_map_context[C](
	expr: CoreExpr,
	context: C,
	mapper: pure (C, CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (C, CoreType) -> CoreType],
) -> CoreExpr:
	match expr:
		PreClosureConcurrentlyLoopExpr(loop, typ, loc):
			mapped_iterable: CoreExpr = mapper(context, loop.iterable)
			mapped_body: CoreExpr = mapper(context, loop.body)
			mapped_timeout: Option[CoreExpr] = map_context_optional_expr(
				loop.timeout,
				context, mapper,
				type_mapper,
			)
			mapped_limit: CoreExpr = mapper(context, loop.limit)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if (
				map_context_keeps_types(type_mapper)
				and same_core_expr(mapped_iterable, loop.iterable)
				and same_core_expr(mapped_body, loop.body)
				and same_optional_core_expr(mapped_timeout, loop.timeout)
				and same_core_expr(mapped_limit, loop.limit)
				and same_core_type(mapped_typ, typ)
			):
				expr
			else:
				PreClosureConcurrentlyLoopExpr(
					{ loop |
						item_type = map_context_type(context, mapper, type_mapper, loop.item_type),
						item_mode = map_context_concurrently_loop_item_mode(
							loop.item_mode,
							context, mapper,
							type_mapper,
						),
						iterable = mapped_iterable,
						body = mapped_body,
						timeout = mapped_timeout,
						limit = mapped_limit
					},
					mapped_typ,
					loc,
				)
		ConcurrentlyLoopExpr(loop, typ, loc):
			mapped_iterable: CoreExpr = mapper(context, loop.iterable)
			mapped_body: CoreExpr = mapper(context, loop.body)
			mapped_timeout: Option[CoreExpr] = map_context_optional_expr(
				loop.timeout,
				context, mapper,
				type_mapper,
			)
			mapped_limit: CoreExpr = mapper(context, loop.limit)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if (
				map_context_keeps_types(type_mapper)
				and same_core_expr(mapped_iterable, loop.iterable)
				and same_core_expr(mapped_body, loop.body)
				and same_optional_core_expr(mapped_timeout, loop.timeout)
				and same_core_expr(mapped_limit, loop.limit)
				and same_core_type(mapped_typ, typ)
			):
				expr
			else:
				ConcurrentlyLoopExpr(
					{ loop |
						item_type = map_context_type(context, mapper, type_mapper, loop.item_type),
						item_mode = map_context_concurrently_loop_item_mode(
							loop.item_mode,
							context, mapper,
							type_mapper,
						),
						iterable = mapped_iterable,
						body = mapped_body,
						timeout = mapped_timeout,
						limit = mapped_limit,
						task = map_context_task_closure(loop.task, context, mapper, type_mapper)
					},
					mapped_typ,
					loc,
				)
		PreClosureConcurrentExpr(block, typ, loc):
			mapped_bindings: Option[List[CorePreClosureConcurrentBinding]] = map_context_pre_closure_concurrent_bindings(
				block.bindings,
				context, mapper,
				type_mapper,
			)

			mapped_body: CoreExpr = mapper(context, block.body)
			mapped_timeout: Option[CoreExpr] = map_context_optional_expr(
				block.timeout,
				context, mapper,
				type_mapper,
			)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if (
				mapped_bindings.is_none()
				and same_core_expr(mapped_body, block.body)
				and same_optional_core_expr(mapped_timeout, block.timeout)
				and same_core_type(mapped_typ, typ)
			):
				expr
			else:
				PreClosureConcurrentExpr(
					{ block |
						bindings = mapped_bindings.get_or(block.bindings),
						body = mapped_body,
						timeout = mapped_timeout
					},
					mapped_typ,
					loc,
				)
		ConcurrentExpr(block, typ, loc):
			mapped_bindings: Option[List[CoreConcurrentBinding]] = map_context_concurrent_bindings(
				block.bindings,
				context, mapper,
				type_mapper,
			)
			mapped_body: CoreExpr = mapper(context, block.body)
			mapped_timeout: Option[CoreExpr] = map_context_optional_expr(
				block.timeout,
				context, mapper,
				type_mapper,
			)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if (
				mapped_bindings.is_none()
				and same_core_expr(mapped_body, block.body)
				and same_optional_core_expr(mapped_timeout, block.timeout)
				and same_core_type(mapped_typ, typ)
			):
				expr
			else:
				ConcurrentExpr(
					{ block |
						bindings = mapped_bindings.get_or(block.bindings),
						body = mapped_body,
						timeout = mapped_timeout
					},
					mapped_typ,
					loc,
				)
		_:
			expr


-- The compiled match forms.
--
-- Split out of `map_core_expr_children_with_map_context` so the recursive
-- traversal keeps a shallow native frame: one match over every constructor
-- reserves stack for all of its arms at once.
private pure func map_core_match_children_with_map_context[C](
	expr: CoreExpr,
	context: C,
	mapper: pure (C, CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (C, CoreType) -> CoreType],
) -> CoreExpr:
	match expr:
		RawMatchExpr(scrutinee, cases, typ, loc):
			mapped_scrutinee: CoreExpr = mapper(context, scrutinee)
			mapped_cases: Option[List[CoreRawMatchCase]] = map_context_raw_match_cases(
				cases,
				context, mapper,
				type_mapper,
			)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if (
				same_core_expr(mapped_scrutinee, scrutinee)
				and mapped_cases.is_none()
				and same_core_type(mapped_typ, typ)
			):
				expr
			else:
				RawMatchExpr(
					mapped_scrutinee,
					mapped_cases.get_or(cases),
					mapped_typ,
					loc,
				)
		SemanticMatchExpr(scrutinee, tree, typ, loc):
			mapped_scrutinee: CoreExpr = mapper(context, scrutinee)
			mapped_tree: Option[CoreSemanticMatchTree] = map_context_semantic_match_tree(
				tree,
				context, mapper,
			)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if (
				same_core_expr(mapped_scrutinee, scrutinee)
				and mapped_tree.is_none()
				and same_core_type(mapped_typ, typ)
			):
				expr
			else:
				SemanticMatchExpr(
					mapped_scrutinee,
					mapped_tree.get_or(tree),
					mapped_typ,
					loc,
				)
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			mapped_scrutinee: CoreExpr = mapper(context, scrutinee)
			mapped_cases: Option[List[CoreLiteralMatchCase]] = map_context_literal_match_cases(
				cases,
				context, mapper,
				type_mapper,
			)
			mapped_fallback: Option[CoreLiteralMatchFallback] = map_context_literal_match_fallback(
				fallback,
				context, mapper,
				type_mapper,
			)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if (
				same_core_expr(mapped_scrutinee, scrutinee)
				and mapped_cases.is_none()
				and mapped_fallback.is_none()
				and same_core_type(mapped_typ, typ)
			):
				expr
			else:
				LiteralMatchExpr(
					mapped_scrutinee,
					mapped_cases.get_or(cases),
					mapped_fallback.get_or(fallback),
					mapped_typ,
					loc,
				)
		AccessorLiteralMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			mapped_scrutinee: CoreExpr = mapper(context, scrutinee)
			mapped_match: Option[CoreConstructorLiteralMatch] = map_context_constructor_literal_match(
				match_expr,
				context, mapper,
				type_mapper,
			)

			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if (
				same_core_expr(mapped_scrutinee, scrutinee)
				and mapped_match.is_none()
				and same_core_type(mapped_typ, typ)
			):
				expr
			else:
				AccessorLiteralMatchExpr(
					mapped_scrutinee,
					release_policy,
					mapped_match.get_or(match_expr),
					mapped_typ,
					loc,
				)
		LengthMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			mapped_scrutinee: CoreExpr = mapper(context, scrutinee)
			mapped_match: Option[CoreConstructorLengthMatch] = map_context_constructor_length_match(
				match_expr,
				context, mapper,
				type_mapper,
			)
			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if (
				same_core_expr(mapped_scrutinee, scrutinee)
				and mapped_match.is_none()
				and same_core_type(mapped_typ, typ)
			):
				expr
			else:
				LengthMatchExpr(
					mapped_scrutinee,
					release_policy,
					mapped_match.get_or(match_expr),
					mapped_typ,
					loc,
				)
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			mapped_scrutinee: CoreExpr = mapper(context, scrutinee)
			mapped_cases: Option[List[CoreConstructorMatchCase]] = map_context_constructor_match_cases(
				cases,
				context, mapper,
				type_mapper,
			)

			mapped_fallback: Option[CoreConstructorMatchFallback] = map_context_constructor_match_fallback(
				fallback,
				context, mapper,
				type_mapper,
			)

			mapped_typ: CoreType = map_context_type(context, mapper, type_mapper, typ)

			if (
				same_core_expr(mapped_scrutinee, scrutinee)
				and mapped_cases.is_none()
				and mapped_fallback.is_none()
				and same_core_type(mapped_typ, typ)
			):
				expr
			else:
				ConstructorMatchExpr(
					mapped_scrutinee,
					release_policy,
					mapped_cases.get_or(cases),
					mapped_fallback.get_or(fallback),
					mapped_typ,
					loc,
				)
		_:
			expr


private pure func map_core_expr_children_with_map_context[C](
	expr: CoreExpr,
	context: C,
	mapper: pure (C, CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (C, CoreType) -> CoreType],
) -> CoreExpr:
	-- Keep callbacks as borrowed parameters. A value struct cannot own captured
	-- closure environments, while an ARC record here would allocate per node.
	--
	-- Every arm maps its children exactly as it always has, then answers `expr`
	-- itself when every mapped child, child container, and type came back as
	-- the same allocation. Type-only containers (parameters, loop binders,
	-- captures, accessors, match bindings) cannot change without a type mapper,
	-- so the arms that carry one gate reuse on `map_context_keeps_types`.
	--
	-- This dispatcher binds nothing and forwards to one small arm group, so a
	-- deep Core tree costs a shallow frame per level.
	match expr:
		LiteralExpr(_, _, _) | StaticStringLiteralExpr(_, _, _, _) | VarExpr(_, _, _) | VoidExpr(_, _) | CooperativeCheckpointExpr(_, _) | BreakExpr(_, _) | ContinueExpr(_, _) | SetAllocExpr(_, _, _) | ClosureCreateExpr(_, _, _) | DetachExpr(_, _, _):
			map_core_leaf_children_with_map_context(expr, context, mapper, type_mapper)
		DebugBlockExpr(_, _, _) | BinaryExpr(_, _, _, _, _) | UnaryExpr(_, _, _, _) | LogicalExpr(_, _, _, _, _) | AssignExpr(_, _, _, _) | CastExpr(_, _, _) | UnboxExpr(_, _, _, _) | FieldExpr(_, _, _, _) | TupleFieldExpr(_, _, _, _) | BoxExpr(_, _, _) | PreClosureDetachExpr(_, _, _) | DupExpr(_, _, _, _, _, _) | DropExpr(_, _, _, _, _, _) | LetExpr(_, _, _, _, _) | BorrowLetExpr(_, _, _, _) | SeqExpr(_, _) | WhileExpr(_, _, _, _) | RangeExpr(_, _, _, _) | IfExpr(_, _, _, _, _):
			map_core_operator_children_with_map_context(expr, context, mapper, type_mapper)
		CallExpr(_, _, _, _, _) | TupleExpr(_, _, _) | TupleConstructExpr(_, _, _) | VectorExpr(_, _, _) | ListConstructExpr(_, _, _) | DictExpr(_, _, _) | DictConstructExpr(_, _, _) | RecordExpr(_, _, _) | RecordUpdateExpr(_, _, _, _) | RecordReuseExpr(_, _, _, _) | RecordCowUpdateExpr(_, _, _, _) | RecordConstructExpr(_, _, _, _) | UnionConstructExpr(_, _, _) | UnionReuseConstructExpr(_, _, _) | SelectExpr(_, _, _):
			map_core_aggregate_children_with_map_context(expr, context, mapper, type_mapper)
		ListAllocExpr(_, _, _) | ListGetExpr(_, _, _) | ListHandoffExpr(_, _, _) | ListHandoffSetOwnedExpr(_, _, _) | ListHandoffSetSourceSlotExpr(_, _, _) | ListRetainExpr(_, _, _) | ListSetExpr(_, _, _) | ListSwapExpr(_, _, _) | StringByteReadExpr(_, _, _) | StringByteWriteExpr(_, _, _) | StringByteCopyExpr(_, _, _) | StringSetLenExpr(_, _, _) | TensorLiteralExpr(_, _, _) | TensorBoxedLiteralExpr(_, _, _) | TensorPackedLiteralExpr(_, _, _) | TensorRawFillExpr(_, _, _) | TensorRawReadExpr(_, _, _) | TensorRawWriteExpr(_, _, _) | TensorRawViewLetExpr(_, _, _, _):
			map_core_storage_children_with_map_context(expr, context, mapper, type_mapper)
		LambdaExpr(_, _, _, _, _, _) | TailrecLoopExpr(_, _, _, _) | TailrecRecurExpr(_, _, _) | TailrecListSpreadLoopExpr(_, _) | TailrecListSpreadRecurExpr(_, _, _, _) | ForRangeExpr(_, _, _, _, _, _) | ForChannelExpr(_, _, _) | ForListExpr(_, _, _) | ForStringExpr(_, _, _) | ForDictExpr(_, _, _) | ForSetExpr(_, _, _) | ForStreamExpr(_, _, _) | ForResourceSourceExpr(_, _, _) | ForTensorExpr(_, _, _) | ResourceScopeExpr(_, _, _) | ResourceCleanupExitExpr(_, _, _):
			map_core_loop_children_with_map_context(expr, context, mapper, type_mapper)
		PreClosureConcurrentlyLoopExpr(_, _, _) | ConcurrentlyLoopExpr(_, _, _) | PreClosureConcurrentExpr(_, _, _) | ConcurrentExpr(_, _, _):
			map_core_concurrency_children_with_map_context(expr, context, mapper, type_mapper)
		RawMatchExpr(_, _, _, _) | SemanticMatchExpr(_, _, _, _) | LiteralMatchExpr(_, _, _, _, _) | AccessorLiteralMatchExpr(_, _, _, _, _) | LengthMatchExpr(_, _, _, _, _) | ConstructorMatchExpr(_, _, _, _, _, _):
			map_core_match_children_with_map_context(expr, context, mapper, type_mapper)


pure func map_core_expr_children_with_context[C](
	expr: CoreExpr,
	context: C,
	mapper: pure (C, CoreExpr) -> CoreExpr,
) -> CoreExpr:
	map_core_expr_children_with_map_context(expr, context, mapper, None)


-- Long source-level `and`/`or` chains form deep Core trees. Map those trees
-- iteratively so phase-specific leaf mappers do not consume one native stack
-- frame per logical node.
private pure func map_core_logical_tree_with_map_context[C](
	expr: CoreExpr,
	context: C,
	mapper: pure (C, CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (C, CoreType) -> CoreType],
) -> CoreExpr:
	var tasks: List[CoreLogicalMapTask] = [MapCoreLogicalNode(expr)]
	var task_count: Int = 1
	var mapped: List[CoreExpr] = []
	var mapped_count: Int = 0
	var valid: Bool = True

	while valid and task_count > 0:
		task_count -= 1

		match tasks.get(task_count):
			Some(task):
				match task:
					MapCoreLogicalNode(current_expr):
						match current_expr:
							LogicalExpr(op, left, right, typ, loc):
								rebuild_task: CoreLogicalMapTask = RebuildMappedCoreLogicalNode(
									current_expr,
								)

								tasks = if task_count < tasks.length():
									tasks.set(task_count, rebuild_task)
								else:
									tasks.append(rebuild_task)

								task_count += 1

								right_task: CoreLogicalMapTask = MapCoreLogicalNode(right)

								tasks = if task_count < tasks.length():
									tasks.set(task_count, right_task)
								else:
									tasks.append(right_task)

								task_count += 1

								left_task: CoreLogicalMapTask = MapCoreLogicalNode(left)

								tasks = if task_count < tasks.length():
									tasks.set(task_count, left_task)
								else:
									tasks.append(left_task)

								task_count += 1
							_:
								mapped_expr: CoreExpr = mapper(context, current_expr)

								mapped = if mapped_count < mapped.length():
									mapped.set(mapped_count, mapped_expr)
								else:
									mapped.append(mapped_expr)

								mapped_count += 1
					RebuildMappedCoreLogicalNode(source_expr):
						match source_expr:
							LogicalExpr(op, left, right, typ, loc):
								match (mapped.get(mapped_count - 2), mapped.get(mapped_count - 1)):
									(Some(mapped_left), Some(mapped_right)):
										mapped_typ: CoreType = map_context_type(
											context, mapper,
											type_mapper,
											typ,
										)

										rebuilt: CoreExpr = if (
											same_core_expr(mapped_left, left)
											and same_core_expr(mapped_right, right)
											and same_core_type(mapped_typ, typ)
										):
											source_expr
										else:
											LogicalExpr(
												op,
												mapped_left,
												mapped_right,
												mapped_typ,
												loc,
											)

										mapped = mapped.set(mapped_count - 2, rebuilt)
										mapped_count -= 1
									_:
										valid = False
							_:
								valid = False
			None:
				valid = False

	if valid and mapped_count == 1:
		mapped.get_or(0, expr)
	else:
		expr


pure func map_core_logical_tree_with_context[C](
	expr: CoreExpr,
	context: C,
	mapper: pure (C, CoreExpr) -> CoreExpr,
) -> CoreExpr:
	map_core_logical_tree_with_map_context(expr, context, mapper, None)


pure func map_core_logical_tree_and_types_with_context[C](
	expr: CoreExpr,
	context: C,
	mapper: pure (C, CoreExpr) -> CoreExpr,
	type_mapper: pure (C, CoreType) -> CoreType,
) -> CoreExpr:
	map_core_logical_tree_with_map_context(expr, context, mapper, Some(type_mapper))


-- Adapts a plain unary mapper to the `(context, child)` shape the shared
-- context-carrying traversal expects, with the unary mapper itself standing
-- in as the context. A named top-level function, rather than a closure built
-- per call, so this costs a function reference and not an allocation: the
-- mapper travels down as an ordinary parameter exactly like `expr` does.
private pure func apply_unary_core_expr_mapper(
	mapper: pure (CoreExpr) -> CoreExpr,
	child: CoreExpr,
) -> CoreExpr:
	mapper(child)


pure func map_core_logical_tree(
	expr: CoreExpr,
	mapper: pure (CoreExpr) -> CoreExpr,
) -> CoreExpr:
	map_core_logical_tree_with_map_context(expr, mapper, apply_unary_core_expr_mapper, None)


pure func map_core_expr_children_and_types_with_context[C](
	expr: CoreExpr,
	context: C,
	mapper: pure (C, CoreExpr) -> CoreExpr,
	type_mapper: pure (C, CoreType) -> CoreType,
) -> CoreExpr:
	map_core_expr_children_with_map_context(expr, context, mapper, Some(type_mapper))


pure func map_core_expr_children(
	expr: CoreExpr,
	mapper: pure (CoreExpr) -> CoreExpr,
) -> CoreExpr:
	map_core_expr_children_with_map_context(expr, mapper, apply_unary_core_expr_mapper, None)


-- Core statement blocks lower to right-associated SeqExpr chains. Traversing
-- that spine recursively can exhaust the compiler stack on large generated
-- suites. Keep the sequence shape explicit so passes can map it iteratively
-- while retaining their own precisely typed recursion context.
record CoreSequenceSpine {
	preceding_items: List[CoreExpr],
	final_item: CoreExpr
}


pure func split_core_sequence(expr: CoreExpr) -> CoreSequenceSpine:
	var preceding_items: List[CoreExpr] = []
	var final_item: CoreExpr = expr

	while True:
		match final_item:
			SeqExpr(first, second):
				preceding_items = preceding_items.append(first)
				final_item = second
			_:
				break

	{
		preceding_items = preceding_items,
		final_item = final_item
	}


pure func rebuild_core_sequence(spine: CoreSequenceSpine) -> CoreExpr:
	var rebuilt: CoreExpr = spine.final_item
	var index: Int = spine.preceding_items.length() - 1

	while index >= 0:
		match spine.preceding_items.get(index):
			Some(item):
				rebuilt = SeqExpr(item, rebuilt)
			None:
				void

		index -= 1

	rebuilt


pure func map_core_sequence_items(
	expr: CoreExpr,
	mapper: pure (CoreExpr) -> CoreExpr,
) -> CoreExpr:
	spine: CoreSequenceSpine = split_core_sequence(expr)
	mapped_preceding: Option[List[CoreExpr]] = map_context_exprs(
		spine.preceding_items,
		mapper,
		apply_unary_core_expr_mapper,
		None,
	)
	mapped_final: CoreExpr = mapper(spine.final_item)

	if mapped_preceding.is_none() and same_core_expr(mapped_final, spine.final_item):
		expr
	else:
		rebuild_core_sequence({
			preceding_items = mapped_preceding.get_or(spine.preceding_items),
			final_item = mapped_final,
		})


pure func any_core_expr(
	items: List[CoreExpr],
	predicate: pure (CoreExpr) -> Bool,
) -> Bool:
	var found: Bool = False

	for item in items:
		if predicate(item):
			found = True
			break

	found


private pure func optional_expr_items(value: Option[CoreExpr]) -> List[CoreExpr]:
	match value:
		Some(expr):
			[expr]
		None:
			[]


private pure func boxed_storage_value_items(value: CoreBoxedStorageValue) -> List[CoreExpr]:
	[value.value]


private pure func tuple_element_items(element: CoreTupleElement) -> List[CoreExpr]:
	match element:
		TuplePrimElement(value):
			[value]
		TuplePointerElement(value):
			[value]
		TupleStructElement(value, _):
			[value]
		TupleStackResultElement(value):
			[value]
		TupleVoidElement:
			[]
		TupleFloatElement(value):
			[value]
		TupleFloat32Element(value):
			[value]
		TupleFloat16Element(value):
			[value]


private pure func literal_match_fallback_items(
	fallback: CoreLiteralMatchFallback,
) -> List[CoreExpr]:
	match fallback:
		LiteralMatchFallbackBody(body):
			[body]
		LiteralMatchFallbackBindings(_, body):
			[body]
		LiteralMatchFallbackFail:
			[]


private pure func semantic_match_tree_items(tree: CoreSemanticMatchTree) -> List[CoreExpr]:
	match tree:
		SemanticMatchLeaf(_, body):
			[body]
		SemanticMatchFail:
			[]
		SemanticConstructorMatch(_, cases, fallback):
			fallback_items: List[CoreExpr] = match fallback:
				Some(fallback_tree):
					semantic_match_tree_items(fallback_tree)
				None:
					[]

			cases
				.flat_map(func(match_case): semantic_match_tree_items(match_case.body))
				.concat(fallback_items)
		SemanticLiteralMatch(_, cases, fallback):
			cases
				.flat_map(func(match_case): semantic_match_tree_items(match_case.body))
				.concat(semantic_match_tree_items(fallback))
		SemanticLengthMatch(_, cases, geq, fallback):
			geq_items: List[CoreExpr] = match geq:
				Some(geq_case):
					semantic_match_tree_items(geq_case.body)
				None:
					[]

			fallback_items: List[CoreExpr] = match fallback:
				Some(fallback_tree):
					semantic_match_tree_items(fallback_tree)
				None:
					[]

			cases
				.flat_map(func(match_case): semantic_match_tree_items(match_case.body))
				.concat(geq_items)
				.concat(fallback_items)


private pure func constructor_match_body_items(body: CoreConstructorMatchBody) -> List[CoreExpr]:
	match body:
		ConstructorMatchBodyExpr(expr):
			[expr]
		ConstructorMatchBodyLiteral(match_expr):
			constructor_literal_match_items(match_expr)
		ConstructorMatchBodyLength(match_expr):
			constructor_length_match_items(match_expr)


private pure func constructor_literal_match_items(
	match_expr: CoreConstructorLiteralMatch,
) -> List[CoreExpr]:
	match_expr.cases
		.flat_map(func(match_case): [match_case.body])
		.concat(literal_match_fallback_items(match_expr.fallback))


private pure func constructor_length_branch_items(
	branch: CoreConstructorLengthMatchBranch,
) -> List[CoreExpr]:
	constructor_match_body_items(branch.body)


private pure func constructor_length_match_items(
	match_expr: CoreConstructorLengthMatch,
) -> List[CoreExpr]:
	case_items: List[CoreExpr] = match_expr.cases.flat_map(
		func(match_case): constructor_length_branch_items(match_case.branch),
	)

	geq_items: List[CoreExpr] = match match_expr.geq:
		Some(geq):
			constructor_length_branch_items(geq.branch)
		None:
			[]

	fallback_items: List[CoreExpr] = match match_expr.fallback:
		Some(branch):
			constructor_length_branch_items(branch)
		None:
			[]

	case_items
		.concat(geq_items)
		.concat(fallback_items)


private pure func constructor_match_fallback_items(
	fallback: CoreConstructorMatchFallback,
) -> List[CoreExpr]:
	match fallback:
		ConstructorMatchFallbackBody(body):
			[body]
		ConstructorMatchFallbackBindings(_, body):
			[body]
		ConstructorMatchFallbackFail:
			[]


private pure func select_arm_kind_items(kind: CoreSelectArmKind) -> List[CoreExpr]:
	match kind:
		SelectRecvArm(recv):
			[recv.channel]
		SelectSealedArm(channel):
			[channel]
		SelectAfterArm(timeout):
			[timeout]


-- Returns the direct expression children in source/evaluation order. Analyses
-- that need to aggregate facts should use this instead of reimplementing a
-- partial Core traversal beside the canonical child mapper above.
pure func immediate_core_expr_children(expr: CoreExpr) -> List[CoreExpr]:
	match expr:
		LiteralExpr(_, _, _):
			[]
		StaticStringLiteralExpr(_, _, _, _):
			[]
		VarExpr(_, _, _):
			[]
		VoidExpr(_, _):
			[]
		DebugBlockExpr(body, _, _):
			[body]
		CooperativeCheckpointExpr(_, _):
			[]
		CallExpr(_, callee, args, _, _):
			[callee].concat(args)
		BinaryExpr(_, left, right, _, _):
			[left, right]
		UnaryExpr(_, value, _, _):
			[value]
		LogicalExpr(_, left, right, _, _):
			[left, right]
		AssignExpr(_, rhs, _, _):
			[rhs]
		CastExpr(value, _, _):
			[value]
		BoxExpr(box, _, _):
			[box.value]
		UnboxExpr(_, value, _, _):
			[value]
		FieldExpr(value, _, _, _):
			[value]
		TupleFieldExpr(value, _, _, _):
			[value]
		TupleExpr(items, _, _):
			items
		TupleConstructExpr(construct, _, _):
			construct.elements.flat_map(tuple_element_items)
		VectorExpr(items, _, _):
			items
		LambdaExpr(_, _, body, _, _, _):
			[body]
		ClosureCreateExpr(_, _, _):
			[]
		ListConstructExpr(construct, _, _):
			construct.elements.flat_map(boxed_storage_value_items)
		ListAllocExpr(alloc, _, _):
			[alloc.capacity]
		ListGetExpr(get, _, _):
			[get.list, get.index]
		ListHandoffExpr(handoff, _, _):
			[handoff.source, handoff.capacity, handoff.body]
		ListHandoffSetOwnedExpr(set, _, _):
			[set.list, set.index, set.value.value]
		ListHandoffSetSourceSlotExpr(slot, _, _):
			[slot.result, slot.out_index, slot.source, slot.source_index]
		StringByteReadExpr(read, _, _):
			[read.source, read.index]
		StringByteWriteExpr(write, _, _):
			[write.target, write.index, write.byte]
		StringByteCopyExpr(copy, _, _):
			[copy.dst, copy.dst_pos, copy.src, copy.src_pos, copy.len]
		StringSetLenExpr(set_len, _, _):
			[set_len.target, set_len.len]
		TensorLiteralExpr(literal, _, _):
			match literal.payload:
				TensorRawLiteralPayload(raw):
					raw.elements
				TensorInlineStructLiteralPayload(inline_struct):
					inline_struct.elements
		TensorBoxedLiteralExpr(literal, _, _):
			literal.elements.flat_map(boxed_storage_value_items)
		TensorPackedLiteralExpr(literal, _, _):
			literal.elements
		TensorRawFillExpr(fill, _, _):
			[fill.value].concat(fill.dims)
		TensorRawReadExpr(read, _, _):
			[read.index]
		TensorRawWriteExpr(write, _, _):
			[write.index, write.value]
		TensorRawViewLetExpr(binding, body, _, _):
			[binding.source, body]
		DictExpr(entries, _, _):
			entries.flat_map(func(entry): [entry.key, entry.value])
		DictConstructExpr(construct, _, _):
			construct.entries.flat_map(func(entry): [entry.key.value, entry.value.value])
		SetAllocExpr(_, _, _):
			[]
		ListRetainExpr(retain, _, _):
			[retain.list, retain.value.value]
		ListSetExpr(set, _, _):
			[set.list, set.index, set.value.value]
		ListSwapExpr(swap, _, _):
			[swap.list, swap.left_index, swap.right_index]
		RecordExpr(fields, _, _):
			fields.map(func(field): field.value)
		RecordUpdateExpr(base, fields, _, _):
			[base].concat(fields.map(
				func(field): field.value,
			))
		RecordReuseExpr(source, fields, _, _):
			[source].concat(fields.map(
				func(field): field.value,
			))
		RecordCowUpdateExpr(source, fields, _, _):
			fields
				.flat_map(pure func(field) -> List[CoreExpr]:
					match field.replacement:
						Some(replacement):
							[replacement]
						None:
							[]
				)
				.concat([source])
		RecordConstructExpr(_, fields, _, _):
			fields.map(func(field): field.value)
		UnionConstructExpr(construct, _, _):
			construct.args.flat_map(boxed_storage_value_items)
		UnionReuseConstructExpr(construct, _, _):
			[construct.source].concat(construct.args.flat_map(boxed_storage_value_items))
		PreClosureDetachExpr(detached, _, _):
			[detached]
		DetachExpr(_, _, _):
			[]
		DupExpr(_, _, _, body, _, _):
			[body]
		DropExpr(_, _, _, body, _, _):
			[body]
		LetExpr(_, _, _, rhs, body):
			[rhs, body]
		BorrowLetExpr(_, _, rhs, body):
			[rhs, body]
		SeqExpr(first, second):
			[first, second]
		WhileExpr(cond, body, _, _):
			[cond, body]
		BreakExpr(_, _):
			[]
		ContinueExpr(_, _):
			[]
		ResourceScopeExpr(scope, _, _):
			[scope.acquire, scope.body, scope.cleanup]
		ResourceCleanupExitExpr(cleanup_exit, _, _):
			cleanup_exit.cleanups
		TailrecLoopExpr(_, _, body, _):
			[body]
		TailrecRecurExpr(args, _, _):
			args
		TailrecListSpreadLoopExpr(loop, _):
			[loop.body]
		TailrecListSpreadRecurExpr(rebinds, _, _, _):
			rebinds.map(func(rebind): rebind.value)
		ForRangeExpr(_, start, end_value, body, _, _):
			[start, end_value, body]
		ForChannelExpr(loop, _, _):
			[loop.iterable, loop.body]
		ForListExpr(loop, _, _):
			[loop.iterable, loop.body]
		ForStringExpr(loop, _, _):
			[loop.iterable, loop.body]
		ForDictExpr(loop, _, _):
			[loop.iterable, loop.body]
		ForSetExpr(loop, _, _):
			[loop.iterable, loop.body]
		ForStreamExpr(loop, _, _):
			[loop.iterable, loop.body]
		ForResourceSourceExpr(loop, _, _):
			[loop.iterable, loop.body]
		ForTensorExpr(loop, _, _):
			[loop.iterable, loop.body]
		PreClosureConcurrentlyLoopExpr(loop, _, _):
			[loop.iterable, loop.body]
				.concat(optional_expr_items(loop.timeout))
				.append(loop.limit)
		ConcurrentlyLoopExpr(loop, _, _):
			[loop.iterable, loop.body]
				.concat(optional_expr_items(loop.timeout))
				.append(loop.limit)
		PreClosureConcurrentExpr(block, _, _):
			block.bindings
				.map(func(binding): binding.rhs)
				.append(block.body)
				.concat(optional_expr_items(block.timeout))
		ConcurrentExpr(block, _, _):
			block.bindings
				.map(func(binding): binding.rhs)
				.append(block.body)
				.concat(optional_expr_items(block.timeout))
		SelectExpr(select_expr, _, _):
			select_expr.flat_map(func(arm): select_arm_kind_items(arm.kind).append(arm.body))
		RangeExpr(start, end_value, _, _):
			[start, end_value]
		RawMatchExpr(scrutinee, cases, _, _):
			[scrutinee].concat(cases.map(
				func(match_case): match_case.body,
			))
		SemanticMatchExpr(scrutinee, tree, _, _):
			[scrutinee].concat(semantic_match_tree_items(tree))
		LiteralMatchExpr(scrutinee, cases, fallback, _, _):
			[scrutinee]
				.concat(cases.map(
					func(match_case): match_case.body,
				))
				.concat(literal_match_fallback_items(fallback))
		AccessorLiteralMatchExpr(scrutinee, _, match_expr, _, _):
			[scrutinee].concat(constructor_literal_match_items(match_expr))
		LengthMatchExpr(scrutinee, _, match_expr, _, _):
			[scrutinee].concat(constructor_length_match_items(match_expr))
		ConstructorMatchExpr(scrutinee, _, cases, fallback, _, _):
			[scrutinee]
				.concat(cases.flat_map(
					func(match_case): constructor_match_body_items(match_case.body),
				))
				.concat(constructor_match_fallback_items(fallback))
		IfExpr(cond, then_expr, else_expr, _, _):
			[cond, then_expr, else_expr]


pure func any_core_dict_literal_entry_expr(
	entry: CoreDictLiteralEntry,
	predicate: pure (CoreExpr) -> Bool,
) -> Bool:
	predicate(entry.key) or predicate(entry.value)


pure func any_core_dict_literal_entry_exprs(
	entries: List[CoreDictLiteralEntry],
	predicate: pure (CoreExpr) -> Bool,
) -> Bool:
	var found: Bool = False

	for entry in entries:
		if any_core_dict_literal_entry_expr(entry, predicate):
			found = True
			break

	found
