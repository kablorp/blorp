pure func map_core_record_cow_fields(
	fields: List[CoreRecordCowField],
	mapper: pure (CoreExpr) -> CoreExpr,
) -> List[CoreRecordCowField]:
	map_context_record_cow_fields(fields, mapper, apply_unary_core_expr_mapper, None).get_or(fields)


-- Bundles the two independent unary mappers `map_core_record_cow_fields_with_types`
-- takes so they can travel together as one context value, rather than each
-- being closed over separately.
private record UnaryCoreMapperWithType {
	mapper: pure (CoreExpr) -> CoreExpr,
	type_mapper: pure (CoreType) -> CoreType
}


private pure func apply_unary_core_expr_mapper_with_type(
	context: UnaryCoreMapperWithType,
	child: CoreExpr,
) -> CoreExpr:
	context.mapper(child)


private pure func apply_unary_core_type_mapper_with_type(
	context: UnaryCoreMapperWithType,
	typ: CoreType,
) -> CoreType:
	context.type_mapper(typ)


pure func map_core_record_cow_fields_with_types(
	fields: List[CoreRecordCowField],
	mapper: pure (CoreExpr) -> CoreExpr,
	type_mapper: pure (CoreType) -> CoreType,
) -> List[CoreRecordCowField]:
	context: UnaryCoreMapperWithType = { mapper = mapper, type_mapper = type_mapper }
	map_context_record_cow_fields(
		fields,
		context,
		apply_unary_core_expr_mapper_with_type,
		Some(apply_unary_core_type_mapper_with_type),
	).get_or(fields)


private pure func map_context_tailrec_rebinds[C](
	rebinds: List[CoreTailrecListSpreadRebind],
	context: C,
	mapper: pure (C, CoreExpr) -> CoreExpr,
	type_mapper: Option[pure (C, CoreType) -> CoreType],
) -> Option[List[CoreTailrecListSpreadRebind]]:
	var mapped: List[CoreTailrecListSpreadRebind] = []
	var changed: Bool = False
	var index: Int = 0

	for rebind in rebinds:
		mapped_value: CoreExpr = mapper(context, rebind.value)

		if changed:
			mapped = mapped.append({ rebind | value = mapped_value })
		else if not same_core_expr(mapped_value, rebind.value):
			mapped = rebinds
				.take(index)
				.append({ rebind | value = mapped_value })
			changed = True

		index += 1

	if changed:
		Some(mapped)
	else:
		None


