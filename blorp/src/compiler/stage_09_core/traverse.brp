) -> CoreExpr:
	context.mapper(bindings, expr)


private pure func map_context_scoped_literal_match_case(
	context: ScopedCoreMatchResultMapContext,
	match_case: CoreLiteralMatchCase,
) -> Option[CoreLiteralMatchCase]:
	scoped_bindings: List[CoreMatchBinding] = context.bindings.concat(match_case.bindings)
	mapped_body: CoreExpr = map_context_match_result(
		context.result_context,
		scoped_bindings,
		match_case.body,
	)

	if same_core_expr(mapped_body, match_case.body):
		None
	else:
		Some({ match_case | body = mapped_body })


private pure func map_context_scoped_literal_match_cases(
	context: ScopedCoreMatchResultMapContext,
	cases: List[CoreLiteralMatchCase],
) -> Option[List[CoreLiteralMatchCase]]:
	var mapped: List[CoreLiteralMatchCase] = []
	var changed: Bool = False
	var index: Int = 0

	for match_case in cases:
		match map_context_scoped_literal_match_case(context, match_case):
			Some(mapped_case):
				mapped = if changed:
					mapped.append(mapped_case)
				else:
					cases
						.take(index)
						.append(mapped_case)

				changed = True
			None:
				if changed:
					mapped = mapped.append(match_case)
				else:
					void

		index += 1

	if changed:
		Some(mapped)
	else:
		None


private pure func map_context_scoped_literal_match_fallback(
	context: ScopedCoreMatchResultMapContext,
	fallback: CoreLiteralMatchFallback,
) -> Option[CoreLiteralMatchFallback]:
	match fallback:
		LiteralMatchFallbackBody(body):
			mapped: CoreExpr = map_context_match_result(
				context.result_context,
				context.bindings,
				body,
			)

			if same_core_expr(mapped, body):
				None
			else:
				Some(LiteralMatchFallbackBody(mapped))
		LiteralMatchFallbackBindings(fallback_bindings, body):
			mapped: CoreExpr = map_context_match_result(
				context.result_context,
				context.bindings.concat(fallback_bindings),
				body,
			)

			if same_core_expr(mapped, body):
				None
			else:
				Some(LiteralMatchFallbackBindings(fallback_bindings, mapped))
		LiteralMatchFallbackFail:
			None


private pure func map_context_scoped_constructor_literal_match(
	context: ScopedCoreMatchResultMapContext,
	match_expr: CoreConstructorLiteralMatch,
) -> Option[CoreConstructorLiteralMatch]:
	mapped_cases: Option[List[CoreLiteralMatchCase]] = map_context_scoped_literal_match_cases(
		context,
		match_expr.cases,
	)
	mapped_fallback: Option[CoreLiteralMatchFallback] = map_context_scoped_literal_match_fallback(
		context,
		match_expr.fallback,
	)

	if mapped_cases.is_none() and mapped_fallback.is_none():
		None
	else:
		Some({ match_expr |
				cases = mapped_cases.get_or(match_expr.cases),
				fallback = mapped_fallback.get_or(match_expr.fallback)
			})


private pure func map_context_scoped_constructor_match_body(
	context: ScopedCoreMatchResultMapContext,
	body: CoreConstructorMatchBody,
) -> Option[CoreConstructorMatchBody]:
	match body:
		ConstructorMatchBodyExpr(expr):
			mapped: CoreExpr = map_context_match_result(
				context.result_context,
				context.bindings,
				expr,
			)

			if same_core_expr(mapped, expr):
				None
			else:
				Some(ConstructorMatchBodyExpr(mapped))
		ConstructorMatchBodyLiteral(match_expr):
			match map_context_scoped_constructor_literal_match(context, match_expr):
				Some(mapped_match):
					Some(ConstructorMatchBodyLiteral(mapped_match))
				None:
					None
		ConstructorMatchBodyLength(match_expr):
			match map_context_scoped_constructor_length_match(context, match_expr):
				Some(mapped_match):
					Some(ConstructorMatchBodyLength(mapped_match))
				None:
					None


private pure func map_context_scoped_constructor_length_branch(
	context: ScopedCoreMatchResultMapContext,
	branch: CoreConstructorLengthMatchBranch,
) -> Option[CoreConstructorLengthMatchBranch]:
	scoped_context: ScopedCoreMatchResultMapContext = {
		result_context = context.result_context,
		bindings = context.bindings.concat(branch.bindings)
	}

	match map_context_scoped_constructor_match_body(scoped_context, branch.body):
		Some(mapped_body):
			Some({ branch | body = mapped_body })
		None:
			None


private pure func map_context_scoped_constructor_length_case(
	context: ScopedCoreMatchResultMapContext,
	match_case: CoreConstructorLengthMatchCase,
) -> Option[CoreConstructorLengthMatchCase]:
	match map_context_scoped_constructor_length_branch(context, match_case.branch):
		Some(mapped_branch):
			Some({ match_case | branch = mapped_branch })
		None:
			None


private pure func map_context_scoped_constructor_length_cases(
	context: ScopedCoreMatchResultMapContext,
	cases: List[CoreConstructorLengthMatchCase],
) -> Option[List[CoreConstructorLengthMatchCase]]:
	var mapped: List[CoreConstructorLengthMatchCase] = []
	var changed: Bool = False
	var index: Int = 0

	for match_case in cases:
		match map_context_scoped_constructor_length_case(context, match_case):
			Some(mapped_case):
				mapped = if changed:
					mapped.append(mapped_case)
				else:
					cases
						.take(index)
						.append(mapped_case)

				changed = True
			None:
				if changed:
					mapped = mapped.append(match_case)
				else:
					void

		index += 1

	if changed:
		Some(mapped)
	else:
		None


private pure func map_context_scoped_constructor_length_match(
	context: ScopedCoreMatchResultMapContext,
	match_expr: CoreConstructorLengthMatch,
) -> Option[CoreConstructorLengthMatch]:
	mapped_cases: Option[List[CoreConstructorLengthMatchCase]] = map_context_scoped_constructor_length_cases(
		context,
		match_expr.cases,
	)

	var geq_changed: Bool = False

	mapped_geq: Option[CoreConstructorLengthMatchGeq] = match match_expr.geq:
		Some(geq):
			match map_context_scoped_constructor_length_branch(context, geq.branch):
				Some(mapped_branch):
					geq_changed = True
					Some({ geq | branch = mapped_branch })
				None:
					match_expr.geq
		None:
			match_expr.geq

	var fallback_changed: Bool = False

	mapped_fallback: Option[CoreConstructorLengthMatchBranch] = match match_expr.fallback:
		Some(branch):
			match map_context_scoped_constructor_length_branch(context, branch):
				Some(mapped_branch):
					fallback_changed = True
					Some(mapped_branch)
				None:
					match_expr.fallback
		None:
			match_expr.fallback

	if (
		mapped_cases.is_none()
		and not geq_changed
		and not fallback_changed
	):
		None
	else:
		Some({ match_expr |
				cases = mapped_cases.get_or(match_expr.cases),
				geq = mapped_geq,
				fallback = mapped_fallback
			})


private pure func map_context_scoped_constructor_match_case(
	context: ScopedCoreMatchResultMapContext,
	match_case: CoreConstructorMatchCase,
) -> Option[CoreConstructorMatchCase]:
	scoped_context: ScopedCoreMatchResultMapContext = {
		result_context = context.result_context,
		bindings = context.bindings.concat(match_case.bindings)
	}

	match map_context_scoped_constructor_match_body(scoped_context, match_case.body):
		Some(mapped_body):
			Some({ match_case | body = mapped_body })
		None:
			None


private pure func map_context_scoped_constructor_match_cases(
	context: ScopedCoreMatchResultMapContext,
	cases: List[CoreConstructorMatchCase],
) -> Option[List[CoreConstructorMatchCase]]:
	var mapped: List[CoreConstructorMatchCase] = []
	var changed: Bool = False
	var index: Int = 0

	for match_case in cases:
		match map_context_scoped_constructor_match_case(context, match_case):
			Some(mapped_case):
				mapped = if changed:
					mapped.append(mapped_case)
				else:
					cases
						.take(index)
						.append(mapped_case)

				changed = True
			None:
				if changed:
					mapped = mapped.append(match_case)
				else:
					void

		index += 1

	if changed:
		Some(mapped)
	else:
		None


private pure func map_context_scoped_constructor_match_fallback(
	context: ScopedCoreMatchResultMapContext,
	fallback: CoreConstructorMatchFallback,
) -> Option[CoreConstructorMatchFallback]:
	match fallback:
		ConstructorMatchFallbackBody(body):
			mapped: CoreExpr = map_context_match_result(
				context.result_context,
				context.bindings,
				body,
			)

			if same_core_expr(mapped, body):
				None
			else:
				Some(ConstructorMatchFallbackBody(mapped))
		ConstructorMatchFallbackBindings(fallback_bindings, body):
			mapped: CoreExpr = map_context_match_result(
				context.result_context,
				context.bindings.concat(fallback_bindings),
				body,
			)

			if same_core_expr(mapped, body):
				None
			else:
				Some(ConstructorMatchFallbackBindings(fallback_bindings, mapped))
		ConstructorMatchFallbackFail:
			None


pure func map_core_match_results_with_context[C](
	expr: CoreExpr,
	context: C,
	mapper: pure (C, List[CoreMatchBinding], CoreExpr) -> CoreExpr,
) -> CoreExpr:
	contextual_mapper: pure (List[CoreMatchBinding], CoreExpr) -> CoreExpr = pure func(
		bindings: List[CoreMatchBinding],
		result: CoreExpr,
	): mapper(context, bindings, result)
	result_context: CoreMatchResultMapContext = {mapper = contextual_mapper}
	scoped_context: ScopedCoreMatchResultMapContext = {
		result_context = result_context,
		bindings = []
	}

	match expr:
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			mapped_cases: Option[List[CoreLiteralMatchCase]] = map_context_scoped_literal_match_cases(
				scoped_context,
				cases,
			)

			mapped_fallback: Option[CoreLiteralMatchFallback] = map_context_scoped_literal_match_fallback(
				scoped_context,
				fallback,
			)

			if mapped_cases.is_none() and mapped_fallback.is_none():
				expr
			else:
				LiteralMatchExpr(
					scrutinee,
					mapped_cases.get_or(cases),
					mapped_fallback.get_or(fallback),
					typ,
					loc,
				)
		AccessorLiteralMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			match map_context_scoped_constructor_literal_match(scoped_context, match_expr):
				Some(mapped_match):
					AccessorLiteralMatchExpr(scrutinee, release_policy, mapped_match, typ, loc)
				None:
					expr
		LengthMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			match map_context_scoped_constructor_length_match(scoped_context, match_expr):
				Some(mapped_match):
					LengthMatchExpr(scrutinee, release_policy, mapped_match, typ, loc)
				None:
					expr
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			mapped_cases: Option[List[CoreConstructorMatchCase]] = map_context_scoped_constructor_match_cases(
				scoped_context,
				cases,
			)

			mapped_fallback: Option[CoreConstructorMatchFallback] = map_context_scoped_constructor_match_fallback(
				scoped_context,
				fallback,
			)

			if mapped_cases.is_none() and mapped_fallback.is_none():
				expr
			else:
				ConstructorMatchExpr(
					scrutinee,
					release_policy,
					mapped_cases.get_or(cases),
					mapped_fallback.get_or(fallback),
					typ,
					loc,
				)
		_:
			expr


private pure func apply_core_match_result_mapper(
	mapper: pure (List[CoreMatchBinding], CoreExpr) -> CoreExpr,
	bindings: List[CoreMatchBinding],
	expr: CoreExpr,
) -> CoreExpr:
	mapper(bindings, expr)


pure func map_core_match_results(
	expr: CoreExpr,
	mapper: pure (List[CoreMatchBinding], CoreExpr) -> CoreExpr,
) -> CoreExpr:
	map_core_match_results_with_context(expr, mapper, apply_core_match_result_mapper)


private pure func map_context_semantic_constructor_cases[C](
	cases: List[CoreSemanticConstructorMatchCase],
	context: C,
	mapper: pure (C, CoreExpr) -> CoreExpr,
) -> Option[List[CoreSemanticConstructorMatchCase]]:
	var mapped: List[CoreSemanticConstructorMatchCase] = []
	var changed: Bool = False
	var index: Int = 0

	for match_case in cases:
		match map_context_semantic_match_tree(match_case.body, context, mapper):
			Some(mapped_body):
				mapped = if changed:
					mapped.append({ match_case | body = mapped_body })
				else:
					cases
						.take(index)
						.append({ match_case | body = mapped_body })

				changed = True
			None:
				if changed:
					mapped = mapped.append(match_case)
				else:
					void

		index += 1

	if changed:
		Some(mapped)
	else:
		None


private pure func map_context_semantic_literal_cases[C](
	cases: List[CoreSemanticLiteralMatchCase],
	context: C,
	mapper: pure (C, CoreExpr) -> CoreExpr,
) -> Option[List[CoreSemanticLiteralMatchCase]]:
	var mapped: List[CoreSemanticLiteralMatchCase] = []
	var changed: Bool = False
