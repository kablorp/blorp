-- Recognize resolved list producer-consumer chains as validated plans.
--
-- This is a structural port of Core_list_pipeline. Construction stays
-- centralized here so lowering never receives a plan without at least one
-- transformation stage.
import:
	ir:
		CoreCallKind(UnknownCall, UserCall),
		CoreDeclarationIndex,
		CoreExpr(CallExpr, VarExpr),
		CoreSourceLoc,
		synthetic_core_source_loc,
		CoreType(NamedType),
		core_known_callee,
		core_expr_type,
	known_functions: CoreKnownFunction(ListFilter, ListFilterMap, ListFoldLeft, ListLength, ListMap, ListRange)


private INT_TYPE: CoreType = NamedType("Int", [])


union CoreCollectionPipelineSource:
	CollectionListSource(CoreExpr, CoreType)
	CollectionRangeSource(CoreExpr, CoreExpr)


union CoreCollectionPipelineStage:
	CollectionFilterStage(CoreExpr, CoreType)
	CollectionMapStage(CoreExpr, CoreType, CoreType)
	CollectionFilterMapStage(CoreExpr, CoreType, CoreType, CoreType)


enum CoreCollectionPipelineCardinality:
	CollectionExactCardinality
	CollectionUpperBoundCardinality
	CollectionTerminalCardinality


union CoreCollectionPipelineSink:
	CollectionCollectSink(CoreType)
	CollectionFoldSink(CoreExpr, CoreExpr, CoreType)
	CollectionLengthSink


record CoreNonemptyCollectionPipelineStages {
	first: CoreCollectionPipelineStage,
	rest: List[CoreCollectionPipelineStage]
}


record CoreCollectionPipelinePlan {
	source: CoreCollectionPipelineSource,
	stage_chain: CoreNonemptyCollectionPipelineStages,
	sink: CoreCollectionPipelineSink,
	cardinality: CoreCollectionPipelineCardinality,
	result_type: CoreType,
	loc: CoreSourceLoc
}


private record CollectedCollectionPipeline {
	source: CoreCollectionPipelineSource,
	stages: List[CoreCollectionPipelineStage],
	cardinality: CoreCollectionPipelineCardinality,
	element_type: CoreType
}


record CoreCollectionPipelineCall {
	function: CoreKnownFunction,
	args: List[CoreExpr]
}


pure func collection_pipeline_stages(
	plan: CoreCollectionPipelinePlan,
) -> List[CoreCollectionPipelineStage]:
	[plan.stage_chain.first] + plan.stage_chain.rest


pure func fold_collection_pipeline_stages[A](
	plan: CoreCollectionPipelinePlan,
	initial: A,
	folder: pure (A, CoreCollectionPipelineStage) -> A,
) -> A:
	var result: A = folder(initial, plan.stage_chain.first)

	for stage in plan.stage_chain.rest:
		result = folder(result, stage)

	result


pure func collection_list_element_type(typ: CoreType) -> Option[CoreType]:
	match typ:
		NamedType(name, args):
			if name == "List" and args.length() == 1:
				args.get(0)
			else:
				None
		_:
			None


---
The list pipeline function a call reaches, by the callee's definition id: a
mono instance, pure variant or `HasLength` method of `list` is recognised
through the declaration it is (`CoreDeclarationIndex.known_functions`), so no
name is parsed.
---
pure func collection_pipeline_known_call(
	declarations: CoreDeclarationIndex,
	expr: CoreExpr,
) -> Option[CoreCollectionPipelineCall]:
	match expr:
		CallExpr(call_kind, callee, args, _, _):
			callee_def_id: Option[Int] = match call_kind:
				UserCall(_, user_def_id, _):
					user_def_id
				UnknownCall:
					match callee:
						VarExpr(variable, _, _):
							variable.def_id
						_:
							None
				_:
					None

			function ?= core_known_callee(declarations, callee_def_id)
			Some({
				function = function,
				args = args,
			})
		_:
			None


private pure func collection_expr_loc(expr: CoreExpr) -> CoreSourceLoc:
	match expr:
		CallExpr(_, _, _, _, loc):
			loc
		_:
			synthetic_core_source_loc()


private pure func update_collection_cardinality(
	cardinality: CoreCollectionPipelineCardinality,
	stage: CoreCollectionPipelineStage,
) -> CoreCollectionPipelineCardinality:
	match stage:
		CollectionMapStage(_, _, _):
			cardinality
		CollectionFilterStage(_, _) | CollectionFilterMapStage(_, _, _, _):
			match cardinality:
				CollectionExactCardinality | CollectionUpperBoundCardinality:
					CollectionUpperBoundCardinality
				CollectionTerminalCardinality:
					CollectionTerminalCardinality


private pure func append_collection_stage(
	collected: CollectedCollectionPipeline,
	stage: CoreCollectionPipelineStage,
	output_type: CoreType,
) -> CollectedCollectionPipeline:
	{
		source = collected.source,
		stages = collected.stages.append(stage),
		cardinality = update_collection_cardinality(collected.cardinality, stage),
		element_type = output_type
	}


private pure func collect_collection_pipeline(
	declarations: CoreDeclarationIndex,
	expr: CoreExpr,
) -> Option[CollectedCollectionPipeline]:
	match collection_pipeline_known_call(declarations, expr):
		Some(call):
			collect_collection_call(declarations, expr, call)
		None:
			element_type ?= collection_list_element_type(core_expr_type(expr))
			Some({
				source = CollectionListSource(expr, element_type),
				stages = [],
				cardinality = CollectionExactCardinality,
				element_type = element_type,
			})


private pure func collect_collection_call(
	declarations: CoreDeclarationIndex,
	expr: CoreExpr,
	call: CoreCollectionPipelineCall,
) -> Option[CollectedCollectionPipeline]:
	if call.function == ListRange and call.args.length() == 2:
		start ?= call.args.get(0)
		stop ?= call.args.get(1)
		Some({
			source = CollectionRangeSource(start, stop),
			stages = [],
			cardinality = CollectionExactCardinality,
			element_type = INT_TYPE,
		})
	else if call.function == ListFilter and call.args.length() == 2:
		source ?= call.args.get(0)
		callback ?= call.args.get(1)
		collected ?= collect_collection_pipeline(declarations, source)
		stage: CoreCollectionPipelineStage = CollectionFilterStage(callback, collected.element_type)
		Some(append_collection_stage(collected, stage, collected.element_type))
	else if call.function == ListFilterMap and call.args.length() == 2:
		source ?= call.args.get(0)
		callback ?= call.args.get(1)
		collected ?= collect_collection_pipeline(declarations, source)
		output_type ?= collection_list_element_type(core_expr_type(expr))
		option_type: CoreType = NamedType("Option", [output_type])
		stage: CoreCollectionPipelineStage = CollectionFilterMapStage(
			callback,
			collected.element_type,
			output_type,
			option_type,
		)
		Some(append_collection_stage(collected, stage, output_type))
	else if call.function == ListMap and call.args.length() == 2:
		source ?= call.args.get(0)
		callback ?= call.args.get(1)
		collected ?= collect_collection_pipeline(declarations, source)
		output_type ?= collection_list_element_type(core_expr_type(expr))
		stage: CoreCollectionPipelineStage = CollectionMapStage(
			callback,
			collected.element_type,
			output_type,
		)
		Some(append_collection_stage(collected, stage, output_type))
	else:
		element_type ?= collection_list_element_type(core_expr_type(expr))
		Some({
			source = CollectionListSource(expr, element_type),
			stages = [],
			cardinality = CollectionExactCardinality,
			element_type = element_type,
		})


private pure func nonempty_collection_stages(
	stages: List[CoreCollectionPipelineStage],
) -> Option[CoreNonemptyCollectionPipelineStages]:
	match stages:
		[first, ...rest]:
			Some({
				first = first,
				rest = rest,
			})
		[]:
			None


private pure func make_collection_pipeline_plan(
	source: CoreCollectionPipelineSource,
	stages: List[CoreCollectionPipelineStage],
	sink: CoreCollectionPipelineSink,
	cardinality: CoreCollectionPipelineCardinality,
	result_type: CoreType,
	loc: CoreSourceLoc,
) -> Option[CoreCollectionPipelinePlan]:
	stage_chain ?= nonempty_collection_stages(stages)
	Some({
		source = source,
		stage_chain = stage_chain,
		sink = sink,
		cardinality = cardinality,
		result_type = result_type,
		loc = loc,
	})


pure func collection_pipeline_plan(
	declarations: CoreDeclarationIndex,
	expr: CoreExpr,
) -> Option[CoreCollectionPipelinePlan]:
	match collection_pipeline_known_call(declarations, expr):
		Some(call):
			if call.function == ListFoldLeft and call.args.length() == 3:
				source ?= call.args.get(0)
				initial ?= call.args.get(1)
				reducer ?= call.args.get(2)
				collected ?= collect_collection_pipeline(declarations, source)
				make_collection_pipeline_plan(
					collected.source,
					collected.stages,
					CollectionFoldSink(initial, reducer, core_expr_type(expr)),
					CollectionTerminalCardinality,
					core_expr_type(expr),
					collection_expr_loc(expr),
				)
			else if call.function == ListLength and call.args.length() == 1:
				source ?= call.args.get(0)
				collected ?= collect_collection_pipeline(declarations, source)
				make_collection_pipeline_plan(
					collected.source,
					collected.stages,
					CollectionLengthSink,
					CollectionTerminalCardinality,
					core_expr_type(expr),
					collection_expr_loc(expr),
				)
			else:
				collection_collect_plan(declarations, expr)
		None:
			collection_collect_plan(declarations, expr)


private pure func collection_collect_plan(
	declarations: CoreDeclarationIndex,
	expr: CoreExpr,
) -> Option[CoreCollectionPipelinePlan]:
	collected ?= collect_collection_pipeline(declarations, expr)
	make_collection_pipeline_plan(
		collected.source,
		collected.stages,
		CollectionCollectSink(core_expr_type(expr)),
		collected.cardinality,
		core_expr_type(expr),
		collection_expr_loc(expr),
	)
