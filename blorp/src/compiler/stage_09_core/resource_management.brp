			ForStreamExpr,
			ForStringExpr,
			ForTensorExpr,
			IfExpr,
			LambdaExpr,
			LetExpr,
			ListAllocExpr,
			ListConstructExpr,
			ListGetExpr,
			ListHandoffExpr,
			ListHandoffSetOwnedExpr,
			ListHandoffSetSourceSlotExpr,
			ListRetainExpr,
			ListSetExpr,
			ListSwapExpr,
			LengthMatchExpr,
			LiteralExpr,
			LiteralMatchExpr,
			LogicalExpr,
			RangeExpr,
			RecordExpr,
			RecordConstructExpr,
			RecordCowUpdateExpr,
