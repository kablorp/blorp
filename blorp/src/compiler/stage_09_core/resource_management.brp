-- Allocation identity for the reuse rule this pass follows: a rewritten child
-- that is the same allocation as its input proves that the input node can be
-- handed back as is, so the rewrite allocates only along the spine to the
-- break or continue it actually replaced with a cleanup exit. Core is
-- immutable value data, so sharing subtrees between input and output is safe.
-- Bound straight to the runtime primitive for the same bootstrap reason as the
-- matching block in traverse.brp; delete the blocks together and import
-- `memory: same_object` instead.
foreign:
	private pure func same_core_expr(left: CoreExpr, right: CoreExpr) -> Bool = "blorp_same_object"
	private pure func same_core_exprs(
		left: List[CoreExpr],
		right: List[CoreExpr],
	) -> Bool = "blorp_same_object"


private pure func same_optional_core_expr(left: Option[CoreExpr], right: Option[CoreExpr]) -> Bool:
	match left:
		Some(left_expr):
			match right:
				Some(right_expr):
					same_core_expr(left_expr, right_expr)
				None:
					False
		None:
			right.is_none()


-- Payload helpers below answer `None` for "this value came back unchanged", so
-- a caller keeps its own input instead of allocating an equal copy first. This
-- maps a list with such a helper and answers `None` itself when no item
-- changed, copying the untouched prefix only once an item actually changes.
private pure func rewrite_list_items[T](
	items: List[T],
	rewrite_item: pure (T) -> Option[T],
) -> Option[List[T]]:
	var rewritten: List[T] = []
	var changed: Bool = False
	var index: Int = 0

	for item in items:
		match rewrite_item(item):
			Some(rewritten_item):
				rewritten = if changed:
					rewritten.append(rewritten_item)
				else:
					items
						.take(index)
						.append(rewritten_item)

				changed = True
			None:
				if changed:
					rewritten = rewritten.append(item)
				else:
					void

		index += 1

	if changed:
		Some(rewritten)
	else:
		None


private pure func prepend_cleanup(cleanup: CoreExpr, cleanups: List[CoreExpr]) -> List[CoreExpr]:
	var result: List[CoreExpr] = [cleanup]

	for existing_cleanup in cleanups:
		result = result.append(existing_cleanup)

	result


-- Perceus represents a managed local whose value is unused after a void body as
-- `SeqExpr(body, DropExpr(..., VoidExpr))`. The drop is correct on the normal
-- path, but a break or continue in `body` bypasses it. Treat that exact
-- post-body form as a lexical cleanup while rewriting the body.
private pure func post_body_drop_ends_in_void(expr: CoreExpr) -> Bool:
	match expr:
		DropExpr(_, _, _, body, _, _):
			match body:
				VoidExpr(_, _):
					True
				DropExpr(_, _, _, _, _, _):
					post_body_drop_ends_in_void(body)
				_:
					False
		_:
			False


private pure func post_body_drop_cleanup(expr: CoreExpr) -> Option[CoreExpr]:
	if post_body_drop_ends_in_void(expr):
		Some(expr)
	else:
		None


-- A value-producing managed let has the corresponding canonical form
-- `LetExpr(result, rhs, DropExpr(..., VarExpr(result)))`. Its exit cleanup must
-- release the managed locals without trying to produce the bypassed result.
private pure func rewrite_result_drop_cleanup(expr: CoreExpr, result: CoreVar) -> Option[CoreExpr]:
	match expr:
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			rewritten_body ?= rewrite_result_drop_cleanup(body, result)
			Some(DropExpr(variable, value_type, release_policy, rewritten_body, VoidType, loc))
		VarExpr(variable, _, loc):
			if core_var_equal(variable, result):
				Some(VoidExpr(VoidType, loc))
			else:
				None
		_:
			None


private pure func post_result_drop_cleanup(expr: CoreExpr, result: CoreVar) -> Option[CoreExpr]:
	match expr:
		DropExpr(_, _, _, _, _, _):
			rewrite_result_drop_cleanup(expr, result)
		_:
			None


private pure func match_branch_cleanups(
	scrutinee: CoreExpr,
	release_policy: CoreReleasePolicy,
	cleanups: List[CoreExpr],
) -> List[CoreExpr]:
	if release_policy == NoReleasePolicy:
		cleanups
	else:
		match scrutinee:
			VarExpr(variable, value_type, loc):
				prepend_cleanup(
					DropExpr(
						variable,
						value_type,
						release_policy,
						VoidExpr(VoidType, loc),
						VoidType,
						loc,
					),
					cleanups,
				)
			_:
				-- `project_backend_matches` must materialize every releasing scrutinee.
				-- There is no safe ResourceCleanupExit representation for this invalid
				-- Core shape, so do not invent a cleanup for an unrelated value here.
				cleanups


-- A break or continue with no active cleanup is the input node itself.
private pure func break_or_cleanup_exit(
	expr: CoreExpr,
	cleanups: List[CoreExpr],
	typ: CoreType,
	loc: CoreSourceLoc,
) -> CoreExpr:
	if cleanups.length() == 0:
		expr
	else:
		ResourceCleanupExitExpr(
			{
				cleanups = cleanups,
				exit = ResourceBreakExit
			},
			typ,
			loc,
		)


private pure func continue_or_cleanup_exit(
	expr: CoreExpr,
	cleanups: List[CoreExpr],
	typ: CoreType,
	loc: CoreSourceLoc,
) -> CoreExpr:
	if cleanups.length() == 0:
		expr
	else:
		ResourceCleanupExitExpr(
			{
				cleanups = cleanups,
				exit = ResourceContinueExit
			},
			typ,
			loc,
		)


private pure func rewrite_resource_expr_list_with_cleanups(
	exprs: List[CoreExpr],
	cleanups: List[CoreExpr],
) -> List[CoreExpr]:
	CoreTraverse.map_core_exprs(
		exprs,
		func(expr): rewrite_resource_expr_with_cleanups(expr, cleanups),
	)


private pure func rewrite_tuple_element_with_cleanups(
	element: CoreTupleElement,
	cleanups: List[CoreExpr],
) -> Option[CoreTupleElement]:
	match element:
		TuplePrimElement(value):
			rewritten: CoreExpr = rewrite_resource_expr_with_cleanups(value, cleanups)

			if same_core_expr(rewritten, value):
				None
			else:
				Some(TuplePrimElement(rewritten))
		TuplePointerElement(value):
			rewritten: CoreExpr = rewrite_resource_expr_with_cleanups(value, cleanups)

			if same_core_expr(rewritten, value):
				None
			else:
				Some(TuplePointerElement(rewritten))
		TupleStructElement(value, c_type):
			rewritten: CoreExpr = rewrite_resource_expr_with_cleanups(value, cleanups)

			if same_core_expr(rewritten, value):
				None
			else:
				Some(TupleStructElement(rewritten, c_type))
		TupleStackResultElement(value):
			rewritten: CoreExpr = rewrite_resource_expr_with_cleanups(value, cleanups)

			if same_core_expr(rewritten, value):
				None
			else:
				Some(TupleStackResultElement(rewritten))
		TupleVoidElement:
			None
		TupleFloatElement(value):
			rewritten: CoreExpr = rewrite_resource_expr_with_cleanups(value, cleanups)

			if same_core_expr(rewritten, value):
				None
			else:
				Some(TupleFloatElement(rewritten))
		TupleFloat32Element(value):
			rewritten: CoreExpr = rewrite_resource_expr_with_cleanups(value, cleanups)

			if same_core_expr(rewritten, value):
				None
			else:
				Some(TupleFloat32Element(rewritten))
		TupleFloat16Element(value):
			rewritten: CoreExpr = rewrite_resource_expr_with_cleanups(value, cleanups)

			if same_core_expr(rewritten, value):
				None
			else:
				Some(TupleFloat16Element(rewritten))


private pure func rewrite_tuple_elements_with_cleanups(
	elements: List[CoreTupleElement],
	cleanups: List[CoreExpr],
) -> Option[List[CoreTupleElement]]:
	rewrite_list_items(
		elements,
		func(element): rewrite_tuple_element_with_cleanups(element, cleanups),
	)


private pure func rewrite_tailrec_list_spread_rebind_with_cleanups(
	rebind: CoreTailrecListSpreadRebind,
	cleanups: List[CoreExpr],
) -> Option[CoreTailrecListSpreadRebind]:
	rewritten_value: CoreExpr = rewrite_resource_expr_with_cleanups(rebind.value, cleanups)

	if same_core_expr(rewritten_value, rebind.value):
		None
	else:
		Some({ rebind | value = rewritten_value })


private pure func rewrite_tailrec_list_spread_loop_with_cleanups(
	loop: CoreTailrecListSpreadLoop,
) -> Option[CoreTailrecListSpreadLoop]:
	rewritten_body: CoreExpr = rewrite_resource_expr_with_cleanups(loop.body, [])

	if same_core_expr(rewritten_body, loop.body):
		None
	else:
		Some({ loop | body = rewritten_body })


private pure func rewrite_boxed_storage_value_with_cleanups(
	value: CoreBoxedStorageValue,
	cleanups: List[CoreExpr],
) -> Option[CoreBoxedStorageValue]:
	rewritten_value: CoreExpr = rewrite_resource_expr_with_cleanups(value.value, cleanups)

	if same_core_expr(rewritten_value, value.value):
		None
	else:
		Some({ value | value = rewritten_value })


private pure func rewrite_box_op_with_cleanups(
	box: CoreBoxOp,
	cleanups: List[CoreExpr],
) -> Option[CoreBoxOp]:
	rewritten_value: CoreExpr = rewrite_resource_expr_with_cleanups(box.value, cleanups)

	if same_core_expr(rewritten_value, box.value):
		None
	else:
		Some({ box | value = rewritten_value })


private pure func rewrite_boxed_storage_values_with_cleanups(
	values: List[CoreBoxedStorageValue],
	cleanups: List[CoreExpr],
) -> Option[List[CoreBoxedStorageValue]]:
	rewrite_list_items(
		values,
		func(value): rewrite_boxed_storage_value_with_cleanups(value, cleanups),
	)


private pure func rewrite_dict_entry_with_cleanups(
	entry: CoreDictEntry,
	cleanups: List[CoreExpr],
) -> Option[CoreDictEntry]:
	rewritten_key: Option[CoreBoxedStorageValue] = rewrite_boxed_storage_value_with_cleanups(
		entry.key,
		cleanups,
	)
	rewritten_value: Option[CoreBoxedStorageValue] = rewrite_boxed_storage_value_with_cleanups(
		entry.value,
		cleanups,
	)

	if rewritten_key.is_none() and rewritten_value.is_none():
		None
	else:
		Some({
			key = rewritten_key.get_or(entry.key),
			value = rewritten_value.get_or(entry.value),
		})


private pure func rewrite_dict_construct_with_cleanups(
	construct: CoreDictConstruct,
	cleanups: List[CoreExpr],
) -> Option[CoreDictConstruct]:
	match rewrite_list_items(
		construct.entries,
		func(entry): rewrite_dict_entry_with_cleanups(entry, cleanups),
	):
		Some(entries):
			Some({ construct | entries = entries })
		None:
			None


private pure func rewrite_list_construct_with_cleanups(
	construct: CoreListConstruct,
	cleanups: List[CoreExpr],
) -> Option[CoreListConstruct]:
	match rewrite_boxed_storage_values_with_cleanups(construct.elements, cleanups):
		Some(elements):
			Some({ construct | elements = elements })
		None:
			None


private pure func rewrite_list_alloc_with_cleanups(
	alloc: CoreListAlloc,
	cleanups: List[CoreExpr],
) -> Option[CoreListAlloc]:
	rewritten_capacity: CoreExpr = rewrite_resource_expr_with_cleanups(alloc.capacity, cleanups)

	if same_core_expr(rewritten_capacity, alloc.capacity):
		None
	else:
		Some({ alloc | capacity = rewritten_capacity })


private pure func rewrite_list_get_with_cleanups(
	get: CoreListGet,
	cleanups: List[CoreExpr],
) -> Option[CoreListGet]:
	rewritten_list: CoreExpr = rewrite_resource_expr_with_cleanups(get.list, cleanups)
	rewritten_index: CoreExpr = rewrite_resource_expr_with_cleanups(get.index, cleanups)

	if same_core_expr(rewritten_list, get.list) and same_core_expr(rewritten_index, get.index):
		None
	else:
		Some({ get |
				list = rewritten_list,
				index = rewritten_index
			})


private pure func rewrite_list_handoff_with_cleanups(
	handoff: CoreListHandoff,
	cleanups: List[CoreExpr],
) -> Option[CoreListHandoff]:
	rewritten_source: CoreExpr = rewrite_resource_expr_with_cleanups(handoff.source, cleanups)
	rewritten_capacity: CoreExpr = rewrite_resource_expr_with_cleanups(handoff.capacity, cleanups)
	rewritten_body: CoreExpr = rewrite_resource_expr_with_cleanups(handoff.body, cleanups)

	if (
		same_core_expr(rewritten_source, handoff.source)
		and same_core_expr(rewritten_capacity, handoff.capacity)
		and same_core_expr(rewritten_body, handoff.body)
	):
		None
	else:
		Some({ handoff |
				source = rewritten_source,
				capacity = rewritten_capacity,
				body = rewritten_body
			})


private pure func rewrite_list_handoff_set_source_slot_with_cleanups(
	slot: CoreListHandoffSetSourceSlot,
	cleanups: List[CoreExpr],
) -> Option[CoreListHandoffSetSourceSlot]:
	rewritten_result: CoreExpr = rewrite_resource_expr_with_cleanups(slot.result, cleanups)
	rewritten_out_index: CoreExpr = rewrite_resource_expr_with_cleanups(slot.out_index, cleanups)
	rewritten_source: CoreExpr = rewrite_resource_expr_with_cleanups(slot.source, cleanups)
	rewritten_source_index: CoreExpr = rewrite_resource_expr_with_cleanups(
		slot.source_index,
		cleanups,
	)

	if (
		same_core_expr(rewritten_result, slot.result)
		and same_core_expr(rewritten_out_index, slot.out_index)
		and same_core_expr(rewritten_source, slot.source)
		and same_core_expr(rewritten_source_index, slot.source_index)
	):
		None
	else:
		Some({
			result = rewritten_result,
			out_index = rewritten_out_index,
			source = rewritten_source,
			source_index = rewritten_source_index,
		})


private pure func rewrite_string_byte_read_with_cleanups(
	read: CoreStringByteRead,
	cleanups: List[CoreExpr],
) -> Option[CoreStringByteRead]:
	rewritten_source: CoreExpr = rewrite_resource_expr_with_cleanups(read.source, cleanups)
	rewritten_index: CoreExpr = rewrite_resource_expr_with_cleanups(read.index, cleanups)

	if (
		same_core_expr(rewritten_source, read.source)
		and same_core_expr(rewritten_index, read.index)
	):
		None
	else:
		Some({
			source = rewritten_source,
			index = rewritten_index,
		})


private pure func rewrite_string_byte_write_with_cleanups(
	write: CoreStringByteWrite,
	cleanups: List[CoreExpr],
) -> Option[CoreStringByteWrite]:
	rewritten_target: CoreExpr = rewrite_resource_expr_with_cleanups(write.target, cleanups)
	rewritten_index: CoreExpr = rewrite_resource_expr_with_cleanups(write.index, cleanups)
	rewritten_byte: CoreExpr = rewrite_resource_expr_with_cleanups(write.byte, cleanups)

	if (
		same_core_expr(rewritten_target, write.target)
		and same_core_expr(rewritten_index, write.index)
		and same_core_expr(rewritten_byte, write.byte)
	):
		None
	else:
		Some({
			target = rewritten_target,
			index = rewritten_index,
			byte = rewritten_byte,
		})


private pure func rewrite_string_byte_copy_with_cleanups(
	copy: CoreStringByteCopy,
	cleanups: List[CoreExpr],
) -> Option[CoreStringByteCopy]:
	rewritten_dst: CoreExpr = rewrite_resource_expr_with_cleanups(copy.dst, cleanups)
	rewritten_dst_pos: CoreExpr = rewrite_resource_expr_with_cleanups(copy.dst_pos, cleanups)
	rewritten_src: CoreExpr = rewrite_resource_expr_with_cleanups(copy.src, cleanups)
	rewritten_src_pos: CoreExpr = rewrite_resource_expr_with_cleanups(copy.src_pos, cleanups)
	rewritten_len: CoreExpr = rewrite_resource_expr_with_cleanups(copy.len, cleanups)

	if (
		same_core_expr(rewritten_dst, copy.dst)
		and same_core_expr(rewritten_dst_pos, copy.dst_pos)
		and same_core_expr(rewritten_src, copy.src)
		and same_core_expr(rewritten_src_pos, copy.src_pos)
		and same_core_expr(rewritten_len, copy.len)
	):
		None
	else:
		Some({
			dst = rewritten_dst,
			dst_pos = rewritten_dst_pos,
			src = rewritten_src,
			src_pos = rewritten_src_pos,
			len = rewritten_len,
		})


private pure func rewrite_tensor_raw_read_with_cleanups(
	read: CoreTensorRawRead,
	cleanups: List[CoreExpr],
) -> Option[CoreTensorRawRead]:
	rewritten_index: CoreExpr = rewrite_resource_expr_with_cleanups(read.index, cleanups)

	if same_core_expr(rewritten_index, read.index):
		None
	else:
		Some({ read | index = rewritten_index })


private pure func rewrite_tensor_raw_write_with_cleanups(
	write: CoreTensorRawWrite,
	cleanups: List[CoreExpr],
) -> Option[CoreTensorRawWrite]:
	rewritten_index: CoreExpr = rewrite_resource_expr_with_cleanups(write.index, cleanups)
	rewritten_value: CoreExpr = rewrite_resource_expr_with_cleanups(write.value, cleanups)

	if (
		same_core_expr(rewritten_index, write.index)
		and same_core_expr(rewritten_value, write.value)
	):
		None
	else:
		Some({ write |
				index = rewritten_index,
				value = rewritten_value
			})


private pure func rewrite_tensor_raw_view_binding_with_cleanups(
	binding: CoreTensorRawViewBinding,
	cleanups: List[CoreExpr],
) -> Option[CoreTensorRawViewBinding]:
	rewritten_source: CoreExpr = rewrite_resource_expr_with_cleanups(binding.source, cleanups)

	if same_core_expr(rewritten_source, binding.source):
		None
	else:
		Some({ binding | source = rewritten_source })


private pure func rewrite_tensor_literal_with_cleanups(
	literal: CoreTensorLiteral,
	cleanups: List[CoreExpr],
) -> Option[CoreTensorLiteral]:
	match rewrite_tensor_literal_payload_with_cleanups(literal.payload, cleanups):
		Some(payload):
			Some({ literal | payload = payload })
		None:
			None


private pure func rewrite_tensor_literal_payload_with_cleanups(
	payload: CoreTensorLiteralPayload,
	cleanups: List[CoreExpr],
) -> Option[CoreTensorLiteralPayload]:
	match payload:
		TensorRawLiteralPayload(raw):
			rewritten_elements: List[CoreExpr] = rewrite_resource_expr_list_with_cleanups(
				raw.elements,
				cleanups,
			)

			if same_core_exprs(rewritten_elements, raw.elements):
				None
			else:
				Some(TensorRawLiteralPayload({ raw | elements = rewritten_elements }))
		TensorInlineStructLiteralPayload(inline_struct):
			rewritten_elements: List[CoreExpr] = rewrite_resource_expr_list_with_cleanups(
				inline_struct.elements,
				cleanups,
			)

			if same_core_exprs(rewritten_elements, inline_struct.elements):
				None
			else:
				Some(
					TensorInlineStructLiteralPayload(
						{ inline_struct | elements = rewritten_elements },
					),
				)


private pure func rewrite_tensor_boxed_literal_with_cleanups(
	literal: CoreTensorBoxedLiteral,
	cleanups: List[CoreExpr],
) -> Option[CoreTensorBoxedLiteral]:
	match rewrite_boxed_storage_values_with_cleanups(literal.elements, cleanups):
		Some(elements):
			Some({ literal | elements = elements })
		None:
			None


private pure func rewrite_tensor_packed_literal_with_cleanups(
	literal: CoreTensorPackedLiteral,
	cleanups: List[CoreExpr],
) -> Option[CoreTensorPackedLiteral]:
	rewritten_elements: List[CoreExpr] = rewrite_resource_expr_list_with_cleanups(
		literal.elements,
		cleanups,
	)

	if same_core_exprs(rewritten_elements, literal.elements):
		None
	else:
		Some({ literal | elements = rewritten_elements })


private pure func rewrite_tensor_raw_fill_with_cleanups(
	fill: CoreTensorRawFill,
	cleanups: List[CoreExpr],
) -> Option[CoreTensorRawFill]:
	rewritten_value: CoreExpr = rewrite_resource_expr_with_cleanups(fill.value, cleanups)
	rewritten_dims: List[CoreExpr] = rewrite_resource_expr_list_with_cleanups(fill.dims, cleanups)

	if same_core_expr(rewritten_value, fill.value) and same_core_exprs(rewritten_dims, fill.dims):
		None
	else:
		Some({ fill |
				value = rewritten_value,
				dims = rewritten_dims
			})


private pure func rewrite_string_set_len_with_cleanups(
	set_len: CoreStringSetLen,
	cleanups: List[CoreExpr],
) -> Option[CoreStringSetLen]:
	rewritten_target: CoreExpr = rewrite_resource_expr_with_cleanups(set_len.target, cleanups)
	rewritten_len: CoreExpr = rewrite_resource_expr_with_cleanups(set_len.len, cleanups)

	if (
		same_core_expr(rewritten_target, set_len.target)
		and same_core_expr(rewritten_len, set_len.len)
	):
		None
	else:
		Some({
			target = rewritten_target,
			len = rewritten_len,
		})


private pure func rewrite_list_set_with_cleanups(
	set: CoreListSet,
	cleanups: List[CoreExpr],
) -> Option[CoreListSet]:
	rewritten_list: CoreExpr = rewrite_resource_expr_with_cleanups(set.list, cleanups)
	rewritten_index: CoreExpr = rewrite_resource_expr_with_cleanups(set.index, cleanups)
	rewritten_value: Option[CoreBoxedStorageValue] = rewrite_boxed_storage_value_with_cleanups(
		set.value,
		cleanups,
	)

	if (
		same_core_expr(rewritten_list, set.list)
		and same_core_expr(rewritten_index, set.index)
		and rewritten_value.is_none()
	):
		None
	else:
		Some({ set |
				list = rewritten_list,
				index = rewritten_index,
				value = rewritten_value.get_or(set.value)
			})


private pure func rewrite_list_swap_with_cleanups(
	swap: CoreListSwap,
	cleanups: List[CoreExpr],
) -> Option[CoreListSwap]:
	rewritten_list: CoreExpr = rewrite_resource_expr_with_cleanups(swap.list, cleanups)
	rewritten_left_index: CoreExpr = rewrite_resource_expr_with_cleanups(swap.left_index, cleanups)
	rewritten_right_index: CoreExpr = rewrite_resource_expr_with_cleanups(
		swap.right_index,
		cleanups,
	)

	if (
		same_core_expr(rewritten_list, swap.list)
		and same_core_expr(rewritten_left_index, swap.left_index)
		and same_core_expr(rewritten_right_index, swap.right_index)
	):
		None
	else:
		Some({ swap |
				list = rewritten_list,
				left_index = rewritten_left_index,
				right_index = rewritten_right_index
			})


private pure func rewrite_list_retain_with_cleanups(
	retain: CoreListRetain,
	cleanups: List[CoreExpr],
) -> Option[CoreListRetain]:
	rewritten_list: CoreExpr = rewrite_resource_expr_with_cleanups(retain.list, cleanups)
	rewritten_value: Option[CoreBoxedStorageValue] = rewrite_boxed_storage_value_with_cleanups(
		retain.value,
		cleanups,
	)

	if same_core_expr(rewritten_list, retain.list) and rewritten_value.is_none():
		None
	else:
		Some({
			list = rewritten_list,
			value = rewritten_value.get_or(retain.value),
		})


private pure func rewrite_record_field_with_cleanups(
	field: CoreRecordFieldValue,
	cleanups: List[CoreExpr],
) -> Option[CoreRecordFieldValue]:
	rewritten_value: CoreExpr = rewrite_resource_expr_with_cleanups(field.value, cleanups)

	if same_core_expr(rewritten_value, field.value):
		None
	else:
		Some({ field | value = rewritten_value })


private pure func rewrite_record_fields_with_cleanups(
	fields: List[CoreRecordFieldValue],
	cleanups: List[CoreExpr],
) -> Option[List[CoreRecordFieldValue]]:
	rewrite_list_items(fields, func(field): rewrite_record_field_with_cleanups(field, cleanups))


private pure func rewrite_record_cow_field_with_cleanups(
	field: CoreRecordCowField,
	cleanups: List[CoreExpr],
) -> Option[CoreRecordCowField]:
	match field.replacement:
		Some(replacement):
			rewritten_replacement: CoreExpr = rewrite_resource_expr_with_cleanups(
				replacement,
				cleanups,
			)

			if same_core_expr(rewritten_replacement, replacement):
				None
			else:
				Some({ field | replacement = Some(rewritten_replacement) })
		None:
			None


private pure func rewrite_dict_literal_entry_with_cleanups(
	entry: CoreDictLiteralEntry,
	cleanups: List[CoreExpr],
) -> Option[CoreDictLiteralEntry]:
	rewritten_key: CoreExpr = rewrite_resource_expr_with_cleanups(entry.key, cleanups)
	rewritten_value: CoreExpr = rewrite_resource_expr_with_cleanups(entry.value, cleanups)

	if same_core_expr(rewritten_key, entry.key) and same_core_expr(rewritten_value, entry.value):
		None
	else:
		Some({
			key = rewritten_key,
			value = rewritten_value,
		})


private pure func rewrite_raw_match_case_with_cleanups(
	match_case: CoreRawMatchCase,
	cleanups: List[CoreExpr],
) -> Option[CoreRawMatchCase]:
	rewritten_body: CoreExpr = rewrite_resource_expr_with_cleanups(match_case.body, cleanups)

	if same_core_expr(rewritten_body, match_case.body):
		None
	else:
		Some({ match_case | body = rewritten_body })


-- A concurrent binding's right-hand side runs as its own task, so it never
-- inherits the enclosing cleanup stack.
private pure func rewrite_concurrent_binding_with_cleanups(
	binding: CoreConcurrentBinding,
) -> Option[CoreConcurrentBinding]:
	rewritten_rhs: CoreExpr = rewrite_resource_expr_with_cleanups(binding.rhs, [])

	if same_core_expr(rewritten_rhs, binding.rhs):
		None
	else:
		Some({ binding | rhs = rewritten_rhs })


private pure func rewrite_optional_expr_with_cleanups(
	expr: Option[CoreExpr],
	cleanups: List[CoreExpr],
) -> Option[CoreExpr]:
	CoreTraverse.map_core_optional_expr(
		expr,
		func(value): rewrite_resource_expr_with_cleanups(value, cleanups),
	)


private pure func rewrite_concurrently_loop_with_cleanups(
	loop: CoreConcurrentlyLoop,
	cleanups: List[CoreExpr],
) -> Option[CoreConcurrentlyLoop]:
	rewritten_iterable: CoreExpr = rewrite_resource_expr_with_cleanups(loop.iterable, cleanups)
	rewritten_body: CoreExpr = rewrite_resource_expr_with_cleanups(loop.body, [])
	rewritten_timeout: Option[CoreExpr] = rewrite_optional_expr_with_cleanups(
		loop.timeout,
		cleanups,
	)
	rewritten_limit: CoreExpr = rewrite_resource_expr_with_cleanups(loop.limit, cleanups)

	if (
		same_core_expr(rewritten_iterable, loop.iterable)
		and same_core_expr(rewritten_body, loop.body)
		and same_optional_core_expr(rewritten_timeout, loop.timeout)
		and same_core_expr(rewritten_limit, loop.limit)
	):
		None
	else:
		Some({ loop |
				iterable = rewritten_iterable,
				body = rewritten_body,
				timeout = rewritten_timeout,
				limit = rewritten_limit
			})


private pure func rewrite_concurrent_with_cleanups(
	block: CoreConcurrentBlock,
	cleanups: List[CoreExpr],
) -> Option[CoreConcurrentBlock]:
	rewritten_bindings: Option[List[CoreConcurrentBinding]] = rewrite_list_items(
		block.bindings,
		rewrite_concurrent_binding_with_cleanups,
	)
	rewritten_body: CoreExpr = rewrite_resource_expr_with_cleanups(block.body, cleanups)
	rewritten_timeout: Option[CoreExpr] = rewrite_optional_expr_with_cleanups(
		block.timeout,
		cleanups,
	)

	if (
		rewritten_bindings.is_none()
		and same_core_expr(rewritten_body, block.body)
		and same_optional_core_expr(rewritten_timeout, block.timeout)
	):
		None
	else:
		Some({ block |
				bindings = rewritten_bindings.get_or(block.bindings),
				body = rewritten_body,
				timeout = rewritten_timeout
			})


private pure func rewrite_select_recv_arm_with_cleanups(
	recv: CoreSelectRecvArm,
	cleanups: List[CoreExpr],
) -> Option[CoreSelectRecvArm]:
	rewritten_channel: CoreExpr = rewrite_resource_expr_with_cleanups(recv.channel, cleanups)

	if same_core_expr(rewritten_channel, recv.channel):
		None
	else:
		Some({ recv | channel = rewritten_channel })


private pure func rewrite_select_arm_kind_with_cleanups(
	kind: CoreSelectArmKind,
	cleanups: List[CoreExpr],
) -> Option[CoreSelectArmKind]:
	match kind:
		SelectRecvArm(recv):
			match rewrite_select_recv_arm_with_cleanups(recv, cleanups):
				Some(rewritten_recv):
					Some(SelectRecvArm(rewritten_recv))
				None:
					None
		SelectSealedArm(channel):
			rewritten_channel: CoreExpr = rewrite_resource_expr_with_cleanups(channel, cleanups)

			if same_core_expr(rewritten_channel, channel):
				None
			else:
				Some(SelectSealedArm(rewritten_channel))
		SelectAfterArm(timeout):
			rewritten_timeout: CoreExpr = rewrite_resource_expr_with_cleanups(timeout, cleanups)

			if same_core_expr(rewritten_timeout, timeout):
				None
			else:
				Some(SelectAfterArm(rewritten_timeout))


-- A select arm body is its own break/continue target and starts a fresh
-- cleanup stack.
private pure func rewrite_select_arm_with_cleanups(
	arm: CoreSelectArm,
	cleanups: List[CoreExpr],
) -> Option[CoreSelectArm]:
	rewritten_kind: Option[CoreSelectArmKind] = rewrite_select_arm_kind_with_cleanups(
		arm.kind,
		cleanups,
	)
	rewritten_body: CoreExpr = rewrite_resource_expr_with_cleanups(arm.body, [])

	if rewritten_kind.is_none() and same_core_expr(rewritten_body, arm.body):
		None
	else:
		Some({ arm |
				kind = rewritten_kind.get_or(arm.kind),
				body = rewritten_body
			})


private pure func rewrite_literal_match_case_with_cleanups(
	match_case: CoreLiteralMatchCase,
	cleanups: List[CoreExpr],
) -> Option[CoreLiteralMatchCase]:
	rewritten_body: CoreExpr = rewrite_resource_expr_with_cleanups(match_case.body, cleanups)

	if same_core_expr(rewritten_body, match_case.body):
		None
	else:
		Some({ match_case | body = rewritten_body })


private pure func rewrite_literal_match_cases_with_cleanups(
	cases: List[CoreLiteralMatchCase],
	cleanups: List[CoreExpr],
) -> Option[List[CoreLiteralMatchCase]]:
	rewrite_list_items(
		cases,
		func(match_case): rewrite_literal_match_case_with_cleanups(match_case, cleanups),
	)


private pure func rewrite_literal_match_fallback_with_cleanups(
	fallback: CoreLiteralMatchFallback,
	cleanups: List[CoreExpr],
) -> Option[CoreLiteralMatchFallback]:
	match fallback:
		LiteralMatchFallbackBody(body):
			rewritten_body: CoreExpr = rewrite_resource_expr_with_cleanups(body, cleanups)

			if same_core_expr(rewritten_body, body):
				None
			else:
				Some(LiteralMatchFallbackBody(rewritten_body))
		LiteralMatchFallbackBindings(bindings, body):
			rewritten_body: CoreExpr = rewrite_resource_expr_with_cleanups(body, cleanups)

			if same_core_expr(rewritten_body, body):
				None
			else:
				Some(LiteralMatchFallbackBindings(bindings, rewritten_body))
		LiteralMatchFallbackFail:
			None


private pure func rewrite_constructor_literal_match_with_cleanups(
	match_expr: CoreConstructorLiteralMatch,
	cleanups: List[CoreExpr],
) -> Option[CoreConstructorLiteralMatch]:
	rewritten_cases: Option[List[CoreLiteralMatchCase]] = rewrite_literal_match_cases_with_cleanups(
		match_expr.cases,
		cleanups,
	)
	rewritten_fallback: Option[CoreLiteralMatchFallback] = rewrite_literal_match_fallback_with_cleanups(
		match_expr.fallback,
		cleanups,
	)

	if rewritten_cases.is_none() and rewritten_fallback.is_none():
		None
	else:
		Some({ match_expr |
				cases = rewritten_cases.get_or(match_expr.cases),
				fallback = rewritten_fallback.get_or(match_expr.fallback)
			})


private pure func rewrite_constructor_length_match_branch_with_cleanups(
	branch: CoreConstructorLengthMatchBranch,
	cleanups: List[CoreExpr],
) -> Option[CoreConstructorLengthMatchBranch]:
	match rewrite_constructor_match_body_with_cleanups(branch.body, cleanups):
		Some(body):
			Some({ branch | body = body })
		None:
			None


private pure func rewrite_constructor_length_match_case_with_cleanups(
	match_case: CoreConstructorLengthMatchCase,
	cleanups: List[CoreExpr],
) -> Option[CoreConstructorLengthMatchCase]:
	match rewrite_constructor_length_match_branch_with_cleanups(match_case.branch, cleanups):
		Some(branch):
			Some({ match_case | branch = branch })
		None:
			None


-- `None` also covers an absent case, so the caller keeps its input either way.
private pure func rewrite_constructor_length_match_geq_with_cleanups(
	geq_case: Option[CoreConstructorLengthMatchGeq],
	cleanups: List[CoreExpr],
) -> Option[CoreConstructorLengthMatchGeq]:
	match geq_case:
		Some(existing_case):
			match rewrite_constructor_length_match_branch_with_cleanups(
				existing_case.branch,
				cleanups,
			):
				Some(branch):
					Some({ existing_case | branch = branch })
				None:
					None
		None:
			None


private pure func rewrite_constructor_length_match_fallback_with_cleanups(
	fallback: Option[CoreConstructorLengthMatchBranch],
	cleanups: List[CoreExpr],
) -> Option[CoreConstructorLengthMatchBranch]:
	match fallback:
		Some(branch):
			rewrite_constructor_length_match_branch_with_cleanups(branch, cleanups)
		None:
			None


private pure func rewrite_constructor_length_match_with_cleanups(
	match_expr: CoreConstructorLengthMatch,
	cleanups: List[CoreExpr],
) -> Option[CoreConstructorLengthMatch]:
	rewritten_cases: Option[List[CoreConstructorLengthMatchCase]] = rewrite_list_items(
		match_expr.cases,
		func(
			match_case,
		): rewrite_constructor_length_match_case_with_cleanups(match_case, cleanups),
	)
	rewritten_geq: Option[CoreConstructorLengthMatchGeq] = rewrite_constructor_length_match_geq_with_cleanups(
		match_expr.geq,
		cleanups,
	)
	rewritten_fallback: Option[CoreConstructorLengthMatchBranch] = rewrite_constructor_length_match_fallback_with_cleanups(
		match_expr.fallback,
		cleanups,
	)

	if (
		rewritten_cases.is_none()
		and rewritten_geq.is_none()
		and rewritten_fallback.is_none()
	):
		None
	else:
		geq: Option[CoreConstructorLengthMatchGeq] = if rewritten_geq.is_some():
			rewritten_geq
		else:
			match_expr.geq

		fallback: Option[CoreConstructorLengthMatchBranch] = if rewritten_fallback.is_some():
			rewritten_fallback
		else:
			match_expr.fallback

		Some({ match_expr |
				cases = rewritten_cases.get_or(match_expr.cases),
				geq = geq,
				fallback = fallback
			})


private pure func rewrite_constructor_match_body_with_cleanups(
	body: CoreConstructorMatchBody,
	cleanups: List[CoreExpr],
) -> Option[CoreConstructorMatchBody]:
	match body:
		ConstructorMatchBodyExpr(expr):
			rewritten: CoreExpr = rewrite_resource_expr_with_cleanups(expr, cleanups)

			if same_core_expr(rewritten, expr):
				None
			else:
				Some(ConstructorMatchBodyExpr(rewritten))
		ConstructorMatchBodyLiteral(match_expr):
			match rewrite_constructor_literal_match_with_cleanups(match_expr, cleanups):
				Some(rewritten):
					Some(ConstructorMatchBodyLiteral(rewritten))
				None:
					None
		ConstructorMatchBodyLength(match_expr):
			match rewrite_constructor_length_match_with_cleanups(match_expr, cleanups):
				Some(rewritten):
					Some(ConstructorMatchBodyLength(rewritten))
				None:
					None


private pure func rewrite_constructor_match_case_with_cleanups(
	match_case: CoreConstructorMatchCase,
	cleanups: List[CoreExpr],
) -> Option[CoreConstructorMatchCase]:
	match rewrite_constructor_match_body_with_cleanups(match_case.body, cleanups):
		Some(body):
			Some({ match_case | body = body })
		None:
			None


private pure func rewrite_constructor_match_cases_with_cleanups(
	cases: List[CoreConstructorMatchCase],
	cleanups: List[CoreExpr],
) -> Option[List[CoreConstructorMatchCase]]:
	rewrite_list_items(
		cases,
		func(match_case): rewrite_constructor_match_case_with_cleanups(match_case, cleanups),
	)


private pure func rewrite_constructor_match_fallback_with_cleanups(
	fallback: CoreConstructorMatchFallback,
	cleanups: List[CoreExpr],
) -> Option[CoreConstructorMatchFallback]:
	match fallback:
		ConstructorMatchFallbackBody(body):
			rewritten_body: CoreExpr = rewrite_resource_expr_with_cleanups(body, cleanups)

			if same_core_expr(rewritten_body, body):
				None
			else:
				Some(ConstructorMatchFallbackBody(rewritten_body))
		ConstructorMatchFallbackBindings(bindings, body):
			rewritten_body: CoreExpr = rewrite_resource_expr_with_cleanups(body, cleanups)

			if same_core_expr(rewritten_body, body):
				None
			else:
				Some(ConstructorMatchFallbackBindings(bindings, rewritten_body))
		ConstructorMatchFallbackFail:
			None


private union ResourceLogicalTask:
	RewriteResourceLogicalNode(CoreExpr)
	RebuildResourceLogicalNode(CoreExpr)


-- Long `and`/`or` chains form deep Core trees; walk them iteratively. The
-- rebuild task carries the source node so an unchanged pair of sides hands
-- that node back instead of an equal copy.
private pure func rewrite_resource_logical_expr_with_cleanups(
	expr: CoreExpr,
	cleanups: List[CoreExpr],
) -> CoreExpr:
	var tasks: List[ResourceLogicalTask] = [RewriteResourceLogicalNode(expr)]
	var task_count: Int = 1
	var rewritten: List[CoreExpr] = []
	var rewritten_count: Int = 0
	var valid: Bool = True

	while valid and task_count > 0:
		task_count -= 1

		match tasks.get(task_count):
			Some(task):
				match task:
					RewriteResourceLogicalNode(current_expr):
						match current_expr:
							LogicalExpr(op, left, right, typ, loc):
								rebuild_task: ResourceLogicalTask = RebuildResourceLogicalNode(
									current_expr,
								)

								tasks = if task_count < tasks.length():
									tasks.set(task_count, rebuild_task)
								else:
									tasks.append(rebuild_task)

								task_count += 1

								right_task: ResourceLogicalTask = RewriteResourceLogicalNode(right)

								tasks = if task_count < tasks.length():
									tasks.set(task_count, right_task)
								else:
									tasks.append(right_task)

								task_count += 1

								left_task: ResourceLogicalTask = RewriteResourceLogicalNode(left)

								tasks = if task_count < tasks.length():
									tasks.set(task_count, left_task)
								else:
									tasks.append(left_task)

								task_count += 1
							_:
								rewritten_expr: CoreExpr = rewrite_resource_expr_with_cleanups(
									current_expr,
									cleanups,
								)

								rewritten = if rewritten_count < rewritten.length():
									rewritten.set(rewritten_count, rewritten_expr)
								else:
									rewritten.append(rewritten_expr)

								rewritten_count += 1
					RebuildResourceLogicalNode(source_expr):
						match source_expr:
							LogicalExpr(op, left, right, typ, loc):
								match (
									rewritten.get(rewritten_count - 2),
									rewritten.get(rewritten_count - 1),
								):
									(Some(rewritten_left), Some(rewritten_right)):
										rebuilt: CoreExpr = if (
											same_core_expr(rewritten_left, left)
											and same_core_expr(rewritten_right, right)
										):
											source_expr
										else:
											LogicalExpr(
												op,
												rewritten_left,
												rewritten_right,
												typ,
												loc,
											)

										rewritten = rewritten.set(rewritten_count - 2, rebuilt)
										rewritten_count -= 1
									_:
										valid = False
							_:
								valid = False
			None:
				valid = False

	if valid and rewritten_count == 1:
		rewritten.get_or(0, expr)
	else:
		expr


-- Every arm rewrites its children exactly as it always has and answers `expr`
-- itself when every rewritten child and child container came back as the same
-- allocation; only a break or continue that gains a cleanup exit builds new
-- nodes, and only along the spine above it.
--
-- This dispatcher binds nothing and forwards to one small arm group, so a deep
-- Core tree costs a shallow native frame per level: one match over every
-- constructor would reserve stack for all of its arms' locals at once and
-- overflow the default stack at -O0 on large generated suites.
private pure func rewrite_resource_expr_with_cleanups(
	expr: CoreExpr,
	cleanups: List[CoreExpr],
) -> CoreExpr:
	match expr:
		LiteralExpr(_, _, _) | StaticStringLiteralExpr(_, _, _, _) | VarExpr(_, _, _) | VoidExpr(_, _) | CooperativeCheckpointExpr(_, _) | BreakExpr(_, _) | ContinueExpr(_, _) | SetAllocExpr(_, _, _) | ClosureCreateExpr(_, _, _) | DetachExpr(_, _, _):
			rewrite_resource_leaf_with_cleanups(expr, cleanups)
		DebugBlockExpr(_, _, _) | BinaryExpr(_, _, _, _, _) | UnaryExpr(_, _, _, _) | LogicalExpr(_, _, _, _, _) | AssignExpr(_, _, _, _) | CastExpr(_, _, _) | UnboxExpr(_, _, _, _) | FieldExpr(_, _, _, _) | TupleFieldExpr(_, _, _, _) | BoxExpr(_, _, _) | PreClosureDetachExpr(_, _, _) | DupExpr(_, _, _, _, _, _) | DropExpr(_, _, _, _, _, _) | LetExpr(_, _, _, _, _) | BorrowLetExpr(_, _, _, _) | SeqExpr(_, _) | WhileExpr(_, _, _, _) | RangeExpr(_, _, _, _) | IfExpr(_, _, _, _, _):
			rewrite_resource_operator_with_cleanups(expr, cleanups)
		CallExpr(_, _, _, _, _) | TupleExpr(_, _, _) | TupleConstructExpr(_, _, _) | VectorExpr(_, _, _) | ListConstructExpr(_, _, _) | DictExpr(_, _, _) | DictConstructExpr(_, _, _) | RecordExpr(_, _, _) | RecordUpdateExpr(_, _, _, _) | RecordReuseExpr(_, _, _, _) | RecordCowUpdateExpr(_, _, _, _) | RecordConstructExpr(_, _, _, _) | UnionConstructExpr(_, _, _) | UnionReuseConstructExpr(_, _, _) | SelectExpr(_, _, _):
			rewrite_resource_aggregate_with_cleanups(expr, cleanups)
		ListAllocExpr(_, _, _) | ListGetExpr(_, _, _) | ListHandoffExpr(_, _, _) | ListHandoffSetOwnedExpr(_, _, _) | ListHandoffSetSourceSlotExpr(_, _, _) | ListRetainExpr(_, _, _) | ListSetExpr(_, _, _) | ListSwapExpr(_, _, _) | StringByteReadExpr(_, _, _) | StringByteWriteExpr(_, _, _) | StringByteCopyExpr(_, _, _) | StringSetLenExpr(_, _, _) | TensorLiteralExpr(_, _, _) | TensorBoxedLiteralExpr(_, _, _) | TensorPackedLiteralExpr(_, _, _) | TensorRawFillExpr(_, _, _) | TensorRawReadExpr(_, _, _) | TensorRawWriteExpr(_, _, _) | TensorRawViewLetExpr(_, _, _, _):
			rewrite_resource_storage_with_cleanups(expr, cleanups)
		LambdaExpr(_, _, _, _, _, _) | TailrecLoopExpr(_, _, _, _) | TailrecRecurExpr(_, _, _) | TailrecListSpreadLoopExpr(_, _) | TailrecListSpreadRecurExpr(_, _, _, _) | ForRangeExpr(_, _, _, _, _, _) | ForChannelExpr(_, _, _) | ForListExpr(_, _, _) | ForStringExpr(_, _, _) | ForDictExpr(_, _, _) | ForSetExpr(_, _, _) | ForStreamExpr(_, _, _) | ForResourceSourceExpr(_, _, _) | ForTensorExpr(_, _, _) | ResourceScopeExpr(_, _, _) | ResourceCleanupExitExpr(_, _, _):
			rewrite_resource_loop_with_cleanups(expr, cleanups)
		PreClosureConcurrentlyLoopExpr(_, _, _) | ConcurrentlyLoopExpr(_, _, _) | PreClosureConcurrentExpr(_, _, _) | ConcurrentExpr(_, _, _):
			rewrite_resource_concurrency_with_cleanups(expr, cleanups)
		RawMatchExpr(_, _, _, _) | SemanticMatchExpr(_, _, _, _) | LiteralMatchExpr(_, _, _, _, _) | AccessorLiteralMatchExpr(_, _, _, _, _) | LengthMatchExpr(_, _, _, _, _) | ConstructorMatchExpr(_, _, _, _, _, _):
			rewrite_resource_match_with_cleanups(expr, cleanups)


-- Leaves. A break or continue under an active cleanup becomes a cleanup exit;
-- everything else is handed back as is.
private pure func rewrite_resource_leaf_with_cleanups(
	expr: CoreExpr,
	cleanups: List[CoreExpr],
) -> CoreExpr:
	match expr:
		BreakExpr(typ, loc):
			break_or_cleanup_exit(expr, cleanups, typ, loc)
		ContinueExpr(typ, loc):
			continue_or_cleanup_exit(expr, cleanups, typ, loc)
		_:
			expr


-- Operators, casts, field reads, and the simple binding and control forms.
-- Bindings whose canonical post-body drop a break would bypass add that drop to
-- the cleanup stack of the expression it guards.
private pure func rewrite_resource_operator_with_cleanups(
	expr: CoreExpr,
	cleanups: List[CoreExpr],
) -> CoreExpr:
	match expr:
		DebugBlockExpr(body, typ, loc):
			rewritten_body: CoreExpr = rewrite_resource_expr_with_cleanups(body, cleanups)

			if same_core_expr(rewritten_body, body):
				expr
			else:
				DebugBlockExpr(rewritten_body, typ, loc)
		BinaryExpr(op, left, right, typ, loc):
			rewritten_left: CoreExpr = rewrite_resource_expr_with_cleanups(left, cleanups)
			rewritten_right: CoreExpr = rewrite_resource_expr_with_cleanups(right, cleanups)

			if same_core_expr(rewritten_left, left) and same_core_expr(rewritten_right, right):
				expr
			else:
				BinaryExpr(op, rewritten_left, rewritten_right, typ, loc)
		UnaryExpr(op, expr_value, typ, loc):
			rewritten_value: CoreExpr = rewrite_resource_expr_with_cleanups(expr_value, cleanups)

			if same_core_expr(rewritten_value, expr_value):
				expr
			else:
				UnaryExpr(op, rewritten_value, typ, loc)
		LogicalExpr(op, left, right, typ, loc):
			rewrite_resource_logical_expr_with_cleanups(expr, cleanups)
		AssignExpr(variable, rhs, typ, loc):
			rewritten_rhs: CoreExpr = rewrite_resource_expr_with_cleanups(rhs, cleanups)

			if same_core_expr(rewritten_rhs, rhs):
				expr
			else:
				AssignExpr(variable, rewritten_rhs, typ, loc)
		CastExpr(expr_value, typ, loc):
			rewritten_value: CoreExpr = rewrite_resource_expr_with_cleanups(expr_value, cleanups)

			if same_core_expr(rewritten_value, expr_value):
				expr
			else:
				CastExpr(rewritten_value, typ, loc)
		UnboxExpr(unbox_kind, expr_value, typ, loc):
			rewritten_value: CoreExpr = rewrite_resource_expr_with_cleanups(expr_value, cleanups)

			if same_core_expr(rewritten_value, expr_value):
				expr
			else:
				UnboxExpr(unbox_kind, rewritten_value, typ, loc)
		FieldExpr(expr_value, field_name, typ, loc):
			rewritten_value: CoreExpr = rewrite_resource_expr_with_cleanups(expr_value, cleanups)

			if same_core_expr(rewritten_value, expr_value):
				expr
			else:
				FieldExpr(rewritten_value, field_name, typ, loc)
		TupleFieldExpr(expr_value, field_index, typ, loc):
			rewritten_value: CoreExpr = rewrite_resource_expr_with_cleanups(expr_value, cleanups)

			if same_core_expr(rewritten_value, expr_value):
				expr
			else:
				TupleFieldExpr(rewritten_value, field_index, typ, loc)
		BoxExpr(box, typ, loc):
			match rewrite_box_op_with_cleanups(box, cleanups):
				Some(rewritten_box):
					BoxExpr(rewritten_box, typ, loc)
				None:
					expr
		PreClosureDetachExpr(detached, typ, loc):
			rewritten_detached: CoreExpr = rewrite_resource_expr_with_cleanups(detached, [])

			if same_core_expr(rewritten_detached, detached):
				expr
			else:
				PreClosureDetachExpr(rewritten_detached, typ, loc)
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			rewritten_body: CoreExpr = rewrite_resource_expr_with_cleanups(body, cleanups)

			if same_core_expr(rewritten_body, body):
				expr
			else:
				DupExpr(variable, value_type, retain_policy, rewritten_body, typ, loc)
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			rewritten_body: CoreExpr = rewrite_resource_expr_with_cleanups(body, cleanups)

			if same_core_expr(rewritten_body, body):
				expr
			else:
				DropExpr(variable, value_type, release_policy, rewritten_body, typ, loc)
		LetExpr(name, is_mutable, typ, rhs, body):
			rhs_cleanups: List[CoreExpr] = match post_result_drop_cleanup(body, name):
				Some(cleanup):
					prepend_cleanup(cleanup, cleanups)
				None:
					cleanups

			rewritten_rhs: CoreExpr = rewrite_resource_expr_with_cleanups(rhs, rhs_cleanups)
			rewritten_body: CoreExpr = rewrite_resource_expr_with_cleanups(body, cleanups)

			if same_core_expr(rewritten_rhs, rhs) and same_core_expr(rewritten_body, body):
				expr
			else:
				LetExpr(name, is_mutable, typ, rewritten_rhs, rewritten_body)
		BorrowLetExpr(name, typ, rhs, body):
			rewritten_rhs: CoreExpr = rewrite_resource_expr_with_cleanups(rhs, cleanups)
			rewritten_body: CoreExpr = rewrite_resource_expr_with_cleanups(body, cleanups)

			if same_core_expr(rewritten_rhs, rhs) and same_core_expr(rewritten_body, body):
				expr
			else:
				BorrowLetExpr(name, typ, rewritten_rhs, rewritten_body)
		SeqExpr(first, second):
			first_cleanups: List[CoreExpr] = match post_body_drop_cleanup(second):
				Some(cleanup):
					prepend_cleanup(cleanup, cleanups)
				None:
					cleanups

			rewritten_first: CoreExpr = rewrite_resource_expr_with_cleanups(first, first_cleanups)
			rewritten_second: CoreExpr = rewrite_resource_expr_with_cleanups(second, cleanups)

			if same_core_expr(rewritten_first, first) and same_core_expr(rewritten_second, second):
				expr
			else:
				SeqExpr(rewritten_first, rewritten_second)
		WhileExpr(cond, body, typ, loc):
			rewritten_cond: CoreExpr = rewrite_resource_expr_with_cleanups(cond, cleanups)
			rewritten_body: CoreExpr = rewrite_resource_expr_with_cleanups(body, [])

			if same_core_expr(rewritten_cond, cond) and same_core_expr(rewritten_body, body):
				expr
			else:
				WhileExpr(rewritten_cond, rewritten_body, typ, loc)
		RangeExpr(start, end_value, typ, loc):
			rewritten_start: CoreExpr = rewrite_resource_expr_with_cleanups(start, cleanups)
			rewritten_end: CoreExpr = rewrite_resource_expr_with_cleanups(end_value, cleanups)

			if same_core_expr(rewritten_start, start) and same_core_expr(rewritten_end, end_value):
				expr
			else:
				RangeExpr(rewritten_start, rewritten_end, typ, loc)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			rewritten_cond: CoreExpr = rewrite_resource_expr_with_cleanups(cond, cleanups)
			rewritten_then: CoreExpr = rewrite_resource_expr_with_cleanups(then_expr, cleanups)
			rewritten_else: CoreExpr = rewrite_resource_expr_with_cleanups(else_expr, cleanups)

			if (
				same_core_expr(rewritten_cond, cond)
				and same_core_expr(rewritten_then, then_expr)
				and same_core_expr(rewritten_else, else_expr)
			):
				expr
			else:
				IfExpr(rewritten_cond, rewritten_then, rewritten_else, typ, loc)
		_:
			expr


-- Calls and the literal, record, union, and select aggregates.
private pure func rewrite_resource_aggregate_with_cleanups(
	expr: CoreExpr,
	cleanups: List[CoreExpr],
) -> CoreExpr:
	match expr:
		CallExpr(kind, callee, args, typ, loc):
			rewritten_callee: CoreExpr = rewrite_resource_expr_with_cleanups(callee, cleanups)
			rewritten_args: List[CoreExpr] = rewrite_resource_expr_list_with_cleanups(
				args,
				cleanups,
			)

			if same_core_expr(rewritten_callee, callee) and same_core_exprs(rewritten_args, args):
				expr
			else:
				CallExpr(kind, rewritten_callee, rewritten_args, typ, loc)
		TupleExpr(items, typ, loc):
			rewritten_items: List[CoreExpr] = rewrite_resource_expr_list_with_cleanups(
				items,
				cleanups,
			)

			if same_core_exprs(rewritten_items, items):
				expr
			else:
				TupleExpr(rewritten_items, typ, loc)
		TupleConstructExpr(tuple_construct, typ, loc):
			match rewrite_tuple_elements_with_cleanups(tuple_construct.elements, cleanups):
				Some(elements):
					TupleConstructExpr({ tuple_construct | elements = elements }, typ, loc)
				None:
					expr
		VectorExpr(items, typ, loc):
			rewritten_items: List[CoreExpr] = rewrite_resource_expr_list_with_cleanups(
				items,
				cleanups,
			)

			if same_core_exprs(rewritten_items, items):
				expr
			else:
				VectorExpr(rewritten_items, typ, loc)
		ListConstructExpr(construct, typ, loc):
			match rewrite_list_construct_with_cleanups(construct, cleanups):
				Some(rewritten_construct):
					ListConstructExpr(rewritten_construct, typ, loc)
				None:
					expr
		DictExpr(entries, typ, loc):
			match rewrite_list_items(
				entries,
				func(entry): rewrite_dict_literal_entry_with_cleanups(entry, cleanups),
			):
				Some(rewritten_entries):
					DictExpr(rewritten_entries, typ, loc)
				None:
					expr
		DictConstructExpr(construct, typ, loc):
			match rewrite_dict_construct_with_cleanups(construct, cleanups):
				Some(rewritten_construct):
					DictConstructExpr(rewritten_construct, typ, loc)
				None:
					expr
		RecordExpr(fields, typ, loc):
			match rewrite_record_fields_with_cleanups(fields, cleanups):
				Some(rewritten_fields):
					RecordExpr(rewritten_fields, typ, loc)
				None:
					expr
		RecordUpdateExpr(base, fields, typ, loc):
			rewritten_base: CoreExpr = rewrite_resource_expr_with_cleanups(base, cleanups)
			rewritten_fields: Option[List[CoreRecordFieldValue]] = rewrite_record_fields_with_cleanups(
				fields,
				cleanups,
			)

			if same_core_expr(rewritten_base, base) and rewritten_fields.is_none():
				expr
			else:
				RecordUpdateExpr(
					rewritten_base,
					rewritten_fields.get_or(fields),
					typ,
					loc,
				)
		RecordReuseExpr(source, fields, typ, loc):
			rewritten_source: CoreExpr = rewrite_resource_expr_with_cleanups(source, cleanups)
			rewritten_fields: Option[List[CoreRecordFieldValue]] = rewrite_record_fields_with_cleanups(
				fields,
				cleanups,
			)

			if same_core_expr(rewritten_source, source) and rewritten_fields.is_none():
				expr
			else:
				RecordReuseExpr(
					rewritten_source,
					rewritten_fields.get_or(fields),
					typ,
					loc,
				)
		RecordCowUpdateExpr(source, fields, typ, loc):
			rewritten_source: CoreExpr = rewrite_resource_expr_with_cleanups(source, cleanups)
			rewritten_fields: Option[List[CoreRecordCowField]] = rewrite_list_items(
				fields,
				func(field): rewrite_record_cow_field_with_cleanups(field, cleanups),
			)

			if same_core_expr(rewritten_source, source) and rewritten_fields.is_none():
				expr
			else:
				RecordCowUpdateExpr(
					rewritten_source,
					rewritten_fields.get_or(fields),
					typ,
					loc,
				)
		RecordConstructExpr(type_name, fields, typ, loc):
			match rewrite_record_fields_with_cleanups(fields, cleanups):
				Some(rewritten_fields):
					RecordConstructExpr(type_name, rewritten_fields, typ, loc)
				None:
					expr
		UnionConstructExpr(construct, typ, loc):
			match rewrite_boxed_storage_values_with_cleanups(construct.args, cleanups):
				Some(args):
					UnionConstructExpr({ construct | args = args }, typ, loc)
				None:
					expr
		UnionReuseConstructExpr(construct, typ, loc):
			rewritten_source: CoreExpr = rewrite_resource_expr_with_cleanups(
				construct.source,
				cleanups,
			)
			rewritten_args: Option[List[CoreBoxedStorageValue]] = rewrite_boxed_storage_values_with_cleanups(
				construct.args,
				cleanups,
			)

			if same_core_expr(rewritten_source, construct.source) and rewritten_args.is_none():
				expr
			else:
				UnionReuseConstructExpr(
					{ construct |
						source = rewritten_source,
						args = rewritten_args.get_or(construct.args)
					},
					typ,
					loc,
				)
		SelectExpr(select_expr, typ, loc):
			match rewrite_list_items(
				select_expr,
				func(arm): rewrite_select_arm_with_cleanups(arm, cleanups),
			):
				Some(arms):
					SelectExpr(arms, typ, loc)
				None:
					expr
		_:
			expr


-- List, string, and tensor storage operations whose children live in one
-- payload record.
private pure func rewrite_resource_storage_with_cleanups(
	expr: CoreExpr,
	cleanups: List[CoreExpr],
) -> CoreExpr:
	match expr:
		ListAllocExpr(alloc, typ, loc):
			match rewrite_list_alloc_with_cleanups(alloc, cleanups):
				Some(rewritten):
					ListAllocExpr(rewritten, typ, loc)
				None:
					expr
		ListGetExpr(get, typ, loc):
			match rewrite_list_get_with_cleanups(get, cleanups):
				Some(rewritten):
					ListGetExpr(rewritten, typ, loc)
				None:
					expr
		ListHandoffExpr(handoff, typ, loc):
			match rewrite_list_handoff_with_cleanups(handoff, cleanups):
				Some(rewritten):
					ListHandoffExpr(rewritten, typ, loc)
				None:
					expr
		ListHandoffSetOwnedExpr(set, typ, loc):
			match rewrite_list_set_with_cleanups(set, cleanups):
				Some(rewritten):
					ListHandoffSetOwnedExpr(rewritten, typ, loc)
				None:
					expr
		ListHandoffSetSourceSlotExpr(slot, typ, loc):
			match rewrite_list_handoff_set_source_slot_with_cleanups(slot, cleanups):
				Some(rewritten):
					ListHandoffSetSourceSlotExpr(rewritten, typ, loc)
				None:
					expr
		ListRetainExpr(retain, typ, loc):
			match rewrite_list_retain_with_cleanups(retain, cleanups):
				Some(rewritten):
					ListRetainExpr(rewritten, typ, loc)
				None:
					expr
		ListSetExpr(set, typ, loc):
			match rewrite_list_set_with_cleanups(set, cleanups):
				Some(rewritten):
					ListSetExpr(rewritten, typ, loc)
				None:
					expr
		ListSwapExpr(swap, typ, loc):
			match rewrite_list_swap_with_cleanups(swap, cleanups):
				Some(rewritten):
					ListSwapExpr(rewritten, typ, loc)
				None:
					expr
		StringByteReadExpr(read, typ, loc):
			match rewrite_string_byte_read_with_cleanups(read, cleanups):
				Some(rewritten):
					StringByteReadExpr(rewritten, typ, loc)
				None:
					expr
		StringByteWriteExpr(write, typ, loc):
			match rewrite_string_byte_write_with_cleanups(write, cleanups):
				Some(rewritten):
					StringByteWriteExpr(rewritten, typ, loc)
				None:
					expr
		StringByteCopyExpr(copy, typ, loc):
			match rewrite_string_byte_copy_with_cleanups(copy, cleanups):
				Some(rewritten):
					StringByteCopyExpr(rewritten, typ, loc)
				None:
					expr
		StringSetLenExpr(set_len, typ, loc):
			match rewrite_string_set_len_with_cleanups(set_len, cleanups):
				Some(rewritten):
					StringSetLenExpr(rewritten, typ, loc)
				None:
					expr
		TensorLiteralExpr(literal, typ, loc):
			match rewrite_tensor_literal_with_cleanups(literal, cleanups):
				Some(rewritten):
					TensorLiteralExpr(rewritten, typ, loc)
				None:
					expr
		TensorBoxedLiteralExpr(literal, typ, loc):
			match rewrite_tensor_boxed_literal_with_cleanups(literal, cleanups):
				Some(rewritten):
					TensorBoxedLiteralExpr(rewritten, typ, loc)
				None:
					expr
		TensorPackedLiteralExpr(literal, typ, loc):
			match rewrite_tensor_packed_literal_with_cleanups(literal, cleanups):
				Some(rewritten):
					TensorPackedLiteralExpr(rewritten, typ, loc)
				None:
					expr
		TensorRawFillExpr(fill, typ, loc):
			match rewrite_tensor_raw_fill_with_cleanups(fill, cleanups):
				Some(rewritten):
					TensorRawFillExpr(rewritten, typ, loc)
				None:
					expr
		TensorRawReadExpr(read, typ, loc):
			match rewrite_tensor_raw_read_with_cleanups(read, cleanups):
				Some(rewritten):
					TensorRawReadExpr(rewritten, typ, loc)
				None:
					expr
		TensorRawWriteExpr(write, typ, loc):
			match rewrite_tensor_raw_write_with_cleanups(write, cleanups):
				Some(rewritten):
					TensorRawWriteExpr(rewritten, typ, loc)
				None:
					expr
		TensorRawViewLetExpr(binding, body, typ, loc):
			rewritten_binding: Option[CoreTensorRawViewBinding] = rewrite_tensor_raw_view_binding_with_cleanups(
				binding,
				cleanups,
			)
			rewritten_body: CoreExpr = rewrite_resource_expr_with_cleanups(body, cleanups)

			if rewritten_binding.is_none() and same_core_expr(rewritten_body, body):
				expr
			else:
				TensorRawViewLetExpr(
					rewritten_binding.get_or(binding),
					rewritten_body,
					typ,
					loc,
				)
		_:
			expr


-- Rebuilds a `for` loop's payload record only when its iterable or body
-- changed. Loop bodies are their own break/continue targets and start a fresh
-- cleanup stack. Every `for` payload shares these two field names.
private pure func rewritten_for_loop_children(
	iterable: CoreExpr,
	body: CoreExpr,
	cleanups: List[CoreExpr],
) -> Option[(CoreExpr, CoreExpr)]:
	rewritten_iterable: CoreExpr = rewrite_resource_expr_with_cleanups(iterable, cleanups)
	rewritten_body: CoreExpr = rewrite_resource_expr_with_cleanups(body, [])

	if same_core_expr(rewritten_iterable, iterable) and same_core_expr(rewritten_body, body):
		None
	else:
		Some((rewritten_iterable, rewritten_body))


-- Lambdas, tail-recursive loops, `for` loops, and resource scopes. A scope's
-- cleanup joins the stack for its body; an already rewritten cleanup exit is
-- left alone.
private pure func rewrite_resource_loop_with_cleanups(
	expr: CoreExpr,
	cleanups: List[CoreExpr],
) -> CoreExpr:
	match expr:
		LambdaExpr(lambda_params, lambda_return_type, lambda_body, lambda_is_pure, typ, loc):
			rewritten_body: CoreExpr = rewrite_resource_expr_with_cleanups(lambda_body, [])

			if same_core_expr(rewritten_body, lambda_body):
				expr
			else:
				LambdaExpr(
					lambda_params,
					lambda_return_type,
					rewritten_body,
					lambda_is_pure,
					typ,
					loc,
				)
		TailrecLoopExpr(params, return_type, body, loc):
			rewritten_body: CoreExpr = rewrite_resource_expr_with_cleanups(body, [])

			if same_core_expr(rewritten_body, body):
				expr
			else:
				TailrecLoopExpr(params, return_type, rewritten_body, loc)
		TailrecRecurExpr(args, typ, loc):
			rewritten_args: List[CoreExpr] = rewrite_resource_expr_list_with_cleanups(
				args,
				cleanups,
			)

			if same_core_exprs(rewritten_args, args):
				expr
			else:
				TailrecRecurExpr(rewritten_args, typ, loc)
		TailrecListSpreadLoopExpr(loop, loc):
			match rewrite_tailrec_list_spread_loop_with_cleanups(loop):
				Some(rewritten_loop):
					TailrecListSpreadLoopExpr(rewritten_loop, loc)
				None:
					expr
		TailrecListSpreadRecurExpr(rebinds, cursor_advance, typ, loc):
			match rewrite_list_items(
				rebinds,
				func(rebind): rewrite_tailrec_list_spread_rebind_with_cleanups(rebind, cleanups),
			):
				Some(rewritten_rebinds):
					TailrecListSpreadRecurExpr(rewritten_rebinds, cursor_advance, typ, loc)
				None:
					expr
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			rewritten_start: CoreExpr = rewrite_resource_expr_with_cleanups(start, cleanups)
			rewritten_end: CoreExpr = rewrite_resource_expr_with_cleanups(end_value, cleanups)
			rewritten_body: CoreExpr = rewrite_resource_expr_with_cleanups(body, [])

			if (
				same_core_expr(rewritten_start, start)
				and same_core_expr(rewritten_end, end_value)
				and same_core_expr(rewritten_body, body)
			):
				expr
			else:
				ForRangeExpr(binder, rewritten_start, rewritten_end, rewritten_body, typ, loc)
		ForChannelExpr(for_channel, typ, loc):
			match rewritten_for_loop_children(for_channel.iterable, for_channel.body, cleanups):
				Some((iterable, body)):
					ForChannelExpr(
						{ for_channel |
							iterable = iterable,
							body = body
						},
						typ,
						loc,
					)
				None:
					expr
		ForListExpr(for_list, typ, loc):
			match rewritten_for_loop_children(for_list.iterable, for_list.body, cleanups):
				Some((iterable, body)):
					ForListExpr(
						{ for_list |
							iterable = iterable,
							body = body
						},
						typ,
						loc,
					)
				None:
					expr
		ForStringExpr(for_string, typ, loc):
			match rewritten_for_loop_children(for_string.iterable, for_string.body, cleanups):
				Some((iterable, body)):
					ForStringExpr(
						{ for_string |
							iterable = iterable,
							body = body
						},
						typ,
						loc,
					)
				None:
					expr
		ForDictExpr(for_dict, typ, loc):
			match rewritten_for_loop_children(for_dict.iterable, for_dict.body, cleanups):
				Some((iterable, body)):
					ForDictExpr(
						{ for_dict |
							iterable = iterable,
							body = body
						},
						typ,
						loc,
					)
				None:
					expr
		ForSetExpr(for_set, typ, loc):
			match rewritten_for_loop_children(for_set.iterable, for_set.body, cleanups):
				Some((iterable, body)):
					ForSetExpr(
						{ for_set |
							iterable = iterable,
							body = body
						},
						typ,
						loc,
					)
				None:
					expr
		ForResourceSourceExpr(for_resource_source, typ, loc):
			match rewritten_for_loop_children(
				for_resource_source.iterable,
				for_resource_source.body,
				cleanups,
			):
				Some((iterable, body)):
					ForResourceSourceExpr(
						{ for_resource_source |
							iterable = iterable,
							body = body
						},
						typ,
						loc,
					)
				None:
					expr
		ForStreamExpr(for_stream, typ, loc):
			match rewritten_for_loop_children(for_stream.iterable, for_stream.body, cleanups):
				Some((iterable, body)):
					ForStreamExpr(
						{ for_stream |
							iterable = iterable,
							body = body
						},
						typ,
						loc,
					)
				None:
					expr
		ForTensorExpr(for_tensor, typ, loc):
			match rewritten_for_loop_children(for_tensor.iterable, for_tensor.body, cleanups):
				Some((iterable, body)):
					ForTensorExpr(
						{ for_tensor |
							iterable = iterable,
							body = body
						},
						typ,
						loc,
					)
				None:
					expr
		ResourceScopeExpr(scope, typ, loc):
			active_cleanups: List[CoreExpr] = prepend_cleanup(scope.cleanup, cleanups)
			rewritten_acquire: CoreExpr = rewrite_resource_expr_with_cleanups(
				scope.acquire,
				cleanups,
			)
			rewritten_body: CoreExpr = rewrite_resource_expr_with_cleanups(
				scope.body,
				active_cleanups,
			)
			rewritten_cleanup: CoreExpr = rewrite_resource_expr_with_cleanups(
				scope.cleanup,
				cleanups,
			)

			if (
				same_core_expr(rewritten_acquire, scope.acquire)
				and same_core_expr(rewritten_body, scope.body)
				and same_core_expr(rewritten_cleanup, scope.cleanup)
			):
				expr
			else:
				ResourceScopeExpr(
					{ scope |
						acquire = rewritten_acquire,
						body = rewritten_body,
						cleanup = rewritten_cleanup
					},
					typ,
					loc,
				)
		_:
			expr


-- Structured-concurrency blocks and loops, before and after closure formation.
-- Task bodies never inherit the enclosing cleanup stack.
private pure func rewrite_resource_concurrency_with_cleanups(
	expr: CoreExpr,
	cleanups: List[CoreExpr],
) -> CoreExpr:
	match expr:
		PreClosureConcurrentlyLoopExpr(loop, typ, loc):
			rewritten_iterable: CoreExpr = rewrite_resource_expr_with_cleanups(
				loop.iterable,
				cleanups,
			)
			rewritten_body: CoreExpr = rewrite_resource_expr_with_cleanups(loop.body, [])
			rewritten_timeout: Option[CoreExpr] = rewrite_optional_expr_with_cleanups(
				loop.timeout,
				cleanups,
			)
			rewritten_limit: CoreExpr = rewrite_resource_expr_with_cleanups(loop.limit, cleanups)

			if (
				same_core_expr(rewritten_iterable, loop.iterable)
				and same_core_expr(rewritten_body, loop.body)
				and same_optional_core_expr(rewritten_timeout, loop.timeout)
				and same_core_expr(rewritten_limit, loop.limit)
			):
				expr
			else:
				PreClosureConcurrentlyLoopExpr(
					{ loop |
						iterable = rewritten_iterable,
						body = rewritten_body,
						timeout = rewritten_timeout,
						limit = rewritten_limit
					},
					typ,
					loc,
				)
		ConcurrentlyLoopExpr(loop, typ, loc):
			match rewrite_concurrently_loop_with_cleanups(loop, cleanups):
				Some(rewritten_loop):
					ConcurrentlyLoopExpr(rewritten_loop, typ, loc)
				None:
					expr
		PreClosureConcurrentExpr(block, typ, loc):
			rewritten_body: CoreExpr = rewrite_resource_expr_with_cleanups(block.body, cleanups)
			rewritten_timeout: Option[CoreExpr] = rewrite_optional_expr_with_cleanups(
				block.timeout,
				cleanups,
			)

			if (
				same_core_expr(rewritten_body, block.body)
				and same_optional_core_expr(rewritten_timeout, block.timeout)
			):
				expr
			else:
				PreClosureConcurrentExpr(
					{ block |
						body = rewritten_body,
						timeout = rewritten_timeout
					},
					typ,
					loc,
				)
		ConcurrentExpr(block, typ, loc):
			match rewrite_concurrent_with_cleanups(block, cleanups):
				Some(rewritten_block):
					ConcurrentExpr(rewritten_block, typ, loc)
				None:
					expr
		_:
			expr


-- The match forms. A releasing scrutinee's drop joins the cleanup stack for
-- the branches; semantic matches go through the shared traversal, which
-- applies the same reuse rule.
private pure func rewrite_resource_match_with_cleanups(
	expr: CoreExpr,
	cleanups: List[CoreExpr],
) -> CoreExpr:
	match expr:
		RawMatchExpr(scrutinee, cases, typ, loc):
			rewritten_scrutinee: CoreExpr = rewrite_resource_expr_with_cleanups(scrutinee, cleanups)
			rewritten_cases: Option[List[CoreRawMatchCase]] = rewrite_list_items(
				cases,
				func(match_case): rewrite_raw_match_case_with_cleanups(match_case, cleanups),
			)

			if same_core_expr(rewritten_scrutinee, scrutinee) and rewritten_cases.is_none():
				expr
			else:
				RawMatchExpr(
					rewritten_scrutinee,
					rewritten_cases.get_or(cases),
					typ,
					loc,
				)
		SemanticMatchExpr(scrutinee, tree, typ, loc):
			CoreTraverse.map_core_expr_children(
				expr,
				func(child): rewrite_resource_expr_with_cleanups(child, cleanups),
			)
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			rewritten_scrutinee: CoreExpr = rewrite_resource_expr_with_cleanups(scrutinee, cleanups)
			rewritten_cases: Option[List[CoreLiteralMatchCase]] = rewrite_literal_match_cases_with_cleanups(
				cases,
				cleanups,
			)
			rewritten_fallback: Option[CoreLiteralMatchFallback] = rewrite_literal_match_fallback_with_cleanups(
				fallback,
				cleanups,
			)

			if (
				same_core_expr(rewritten_scrutinee, scrutinee)
				and rewritten_cases.is_none()
				and rewritten_fallback.is_none()
			):
				expr
			else:
				LiteralMatchExpr(
					rewritten_scrutinee,
					rewritten_cases.get_or(cases),
					rewritten_fallback.get_or(fallback),
					typ,
					loc,
				)
		AccessorLiteralMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			branch_cleanups: List[CoreExpr] = match_branch_cleanups(
				scrutinee,
				scrutinee_release_policy,
				cleanups,
			)
			rewritten_scrutinee: CoreExpr = rewrite_resource_expr_with_cleanups(scrutinee, cleanups)
			rewritten_match: Option[CoreConstructorLiteralMatch] = rewrite_constructor_literal_match_with_cleanups(
				match_expr,
				branch_cleanups,
			)

			if same_core_expr(rewritten_scrutinee, scrutinee) and rewritten_match.is_none():
				expr
			else:
				AccessorLiteralMatchExpr(
					rewritten_scrutinee,
					scrutinee_release_policy,
					rewritten_match.get_or(match_expr),
					typ,
					loc,
				)
		LengthMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			branch_cleanups: List[CoreExpr] = match_branch_cleanups(
				scrutinee,
				scrutinee_release_policy,
				cleanups,
			)
			rewritten_scrutinee: CoreExpr = rewrite_resource_expr_with_cleanups(scrutinee, cleanups)
			rewritten_match: Option[CoreConstructorLengthMatch] = rewrite_constructor_length_match_with_cleanups(
				match_expr,
				branch_cleanups,
			)

			if same_core_expr(rewritten_scrutinee, scrutinee) and rewritten_match.is_none():
				expr
			else:
				LengthMatchExpr(
					rewritten_scrutinee,
					scrutinee_release_policy,
					rewritten_match.get_or(match_expr),
					typ,
					loc,
				)
		ConstructorMatchExpr(scrutinee, scrutinee_release_policy, cases, fallback, typ, loc):
			branch_cleanups: List[CoreExpr] = match_branch_cleanups(
				scrutinee,
				scrutinee_release_policy,
				cleanups,
			)
			rewritten_scrutinee: CoreExpr = rewrite_resource_expr_with_cleanups(scrutinee, cleanups)
			rewritten_cases: Option[List[CoreConstructorMatchCase]] = rewrite_constructor_match_cases_with_cleanups(
				cases,
				branch_cleanups,
			)
			rewritten_fallback: Option[CoreConstructorMatchFallback] = rewrite_constructor_match_fallback_with_cleanups(
				fallback,
				branch_cleanups,
			)

			if (
				same_core_expr(rewritten_scrutinee, scrutinee)
				and rewritten_cases.is_none()
				and rewritten_fallback.is_none()
			):
				expr
			else:
				ConstructorMatchExpr(
					rewritten_scrutinee,
					scrutinee_release_policy,
					rewritten_cases.get_or(cases),
					rewritten_fallback.get_or(fallback),
					typ,
					loc,
				)
		_:
			expr


pure func rewrite_resource_expr(expr: CoreExpr) -> CoreExpr:
	rewrite_resource_expr_with_cleanups(expr, [])


pure func rewrite_resource_function(func_info: CoreFunction) -> CoreFunction:
	match func_info.body:
		Some(body):
			rewritten_body: CoreExpr = rewrite_resource_expr(body)

			if same_core_expr(rewritten_body, body):
				func_info
			else:
				{ func_info | body = Some(rewritten_body) }
		None:
			func_info


pure func rewrite_resource_global(global: CoreGlobal) -> CoreGlobal:
	rewritten_init: CoreExpr = rewrite_resource_expr(global.init)

	if same_core_expr(rewritten_init, global.init):
		global
	else:
		{ global | init = rewritten_init }


pure func rewrite_resource_decl(decl: CoreDecl) -> CoreDecl:
	match decl:
		FunctionDecl(func_info):
			FunctionDecl(rewrite_resource_function(func_info))
		GlobalDecl(global):
			GlobalDecl(rewrite_resource_global(global))
		EnumDecl(enum_decl):
			decl
		UnionDecl(union_decl):
			decl
		ValueRecordDecl(record_decl):
			decl
		HeapRecordDecl(record_decl):
			decl
		TypeAliasDecl(alias_decl):
			decl
		TraitDecl(trait_decl):
			decl
		ImplDecl(impl_decl):
			ImplDecl({ impl_decl | methods = impl_decl.methods.map(rewrite_resource_function) })


pure func rewrite_resource_program(program: CoreProgram) -> CoreProgram:
	var decls: List[CoreDecl] = []

	for decl in program.decls:
		decls = decls.append(rewrite_resource_decl(decl))

	{
		decls = decls,
		foreign_includes = program.foreign_includes
	}
