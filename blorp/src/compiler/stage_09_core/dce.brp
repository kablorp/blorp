-- Dead emitted-function elimination for the projected Core boundary.
--
-- Earlier Core stages have already removed generic templates, aliases, traits,
-- imports, and impl containers. Impl methods are represented as
-- ordinary functions. This pass therefore reasons about emitted function
-- identities and the projected type graph. Backend artifacts are derived from
-- retained data declarations rather than modeled as separate DCE nodes.
-- Missing entrypoints and unresolved user calls fail closed by returning the
-- input program unchanged. Duplicate function IDs conservatively collect the
-- dependencies of every collided body before pruning unrelated declarations.
import:
	ir:
		CoreBoxedStorageValue,
		CoreCallKind(
			BuiltinCall,
			ClosureCall,
			DeferredTraitCall,
			DictWithCapacityCall,
			DirectRuntimeCall,
			FallibleStreamTerminalCall,
			ForeignCall,
			IntrinsicCall,
			ListToStringCall,
			OperationResultCall,
			SelectedDirectCall,
			SelectedTraitCall,
			TensorParallelCall,
			UnknownCall,
			UserCall,
		),
		CoreConstructorLengthMatch,
		CoreConstructorLiteralMatch,
		CoreConstructorMatchBody(
			ConstructorMatchBodyExpr,
			ConstructorMatchBodyLength,
			ConstructorMatchBodyLiteral,
		),
		CoreConstructorMatchFallback(
			ConstructorMatchFallbackBindings,
			ConstructorMatchFallbackBody,
			ConstructorMatchFallbackFail,
		),
		CoreDecl(
			EnumDecl,
			FunctionDecl,
			GlobalDecl,
			HeapRecordDecl,
			ImplDecl,
			TraitDecl,
			TypeAliasDecl,
			UnionDecl,
			ValueRecordDecl,
		),
		CoreExpr(
			AccessorLiteralMatchExpr,
			AssignExpr,
			BinaryExpr,
			BorrowLetExpr,
			BoxExpr,
			BreakExpr,
			CallExpr,
			CastExpr,
			ClosureCreateExpr,
			ConcurrentExpr,
			ConcurrentlyLoopExpr,
			ConstructorMatchExpr,
			ContinueExpr,
			CooperativeCheckpointExpr,
			DebugBlockExpr,
			DetachExpr,
			DictConstructExpr,
			DictExpr,
			DropExpr,
			DupExpr,
			FieldExpr,
			ForChannelExpr,
			ForDictExpr,
			ForListExpr,
			ForRangeExpr,
			ForResourceSourceExpr,
			ForSetExpr,
			ForStreamExpr,
			ForStringExpr,
			ForTensorExpr,
			IfExpr,
			LambdaExpr,
			LengthMatchExpr,
			LetExpr,
			ListAllocExpr,
			ListConstructExpr,
			ListGetExpr,
			ListHandoffExpr,
			ListHandoffSetOwnedExpr,
			ListHandoffSetSourceSlotExpr,
			ListRetainExpr,
			ListSetExpr,
			ListSwapExpr,
			LiteralExpr,
			LiteralMatchExpr,
			LogicalExpr,
			PreClosureConcurrentExpr,
			PreClosureConcurrentlyLoopExpr,
			PreClosureDetachExpr,
			RawMatchExpr,
			SemanticMatchExpr,
			RangeExpr,
			RecordConstructExpr,
			RecordExpr,
			RecordCowUpdateExpr,
			RecordReuseExpr,
			RecordUpdateExpr,
			ResourceCleanupExitExpr,
			ResourceScopeExpr,
			SelectExpr,
			SeqExpr,
			SetAllocExpr,
			StaticStringLiteralExpr,
			StringByteCopyExpr,
			StringByteReadExpr,
			StringByteWriteExpr,
			StringSetLenExpr,
			TailrecListSpreadLoopExpr,
			TailrecListSpreadRecurExpr,
			TailrecLoopExpr,
			TailrecRecurExpr,
			TensorBoxedLiteralExpr,
			TensorLiteralExpr,
			TensorPackedLiteralExpr,
			TensorRawFillExpr,
			TensorRawReadExpr,
			TensorRawViewLetExpr,
			TensorRawWriteExpr,
			TupleConstructExpr,
			TupleExpr,
			TupleFieldExpr,
			UnaryExpr,
			UnboxExpr,
			UnionConstructExpr,
			UnionReuseConstructExpr,
			VarExpr,
			VectorExpr,
			VoidExpr,
			WhileExpr,
		),
		CoreFunction,
		CoreFunctionKind(
			BuiltinFunction,
			ClosureBodyFunction,
			ForeignFunction,
			ProgramEntrypointFunction,
			UnresolvedBuiltinFunction,
			UserFunction,
		),
		CoreGlobal,
		CoreHashContainerConstructor(
			CustomHashContainerConstructor,
			FloatHashContainerConstructor,
			GenericHashContainerConstructor,
			StringHashContainerConstructor,
		),
		CoreLiteralMatchCase,
		CoreLiteralMatchFallback(
			LiteralMatchFallbackBindings,
			LiteralMatchFallbackBody,
			LiteralMatchFallbackFail,
		),
		CoreProgram,
		CoreRecordFieldValue,
		CoreSelectArmKind(SelectAfterArm, SelectRecvArm, SelectSealedArm),
		CoreTensorLiteralPayload(TensorInlineStructLiteralPayload, TensorRawLiteralPayload),
		CoreTupleElement(
			TupleFloat16Element,
			TupleFloat32Element,
			TupleFloatElement,
			TuplePointerElement,
			TuplePrimElement,
			TupleStackResultElement,
			TupleStructElement,
			TupleVoidElement,
		),
		CoreType(
			BoxedResultType,
			EnumType,
			FunctionType,
			HeapRecordType,
			NamedType,
			RangeType,
			SelfType,
			StackResultType,
			TensorType,
			TupleType,
			TypeParameterType,
			UnionType,
			ValueRecordType,
			VoidType,
		),
		CoreVar,
		core_expr_type,
	set as Sets
	traverse as CoreTraverse


private record DceConstructorReference {
	name: String,
	def_id: Int
}


private record DceConstructorIdentity {
	parent_type_name: String,
	def_id: Int
}


---
A trait call names its target through the trait and method rather than a
def_id. `selected_def_id` is the concrete target trait resolution already
chose, when it chose one.
---
private record DceTraitReference {
	trait_name: String,
	method_name: String,
	selected_def_id: Option[Int]
}


-- A body traversal publishes only the facts used by the reachability closure.
private record DceReachabilityDelta {
	function_ids: List[Int],
	function_names: List[String],
	constructor_references: List[DceConstructorReference],
	trait_references: List[DceTraitReference],
	global_names: List[String],
	type_names: List[String],
	fail_closed: Bool
}


record CoreValueReferences {
	names: List[String],
	resolved_reads: List[CoreVar],
	resolved_invalidations: List[CoreVar],
	resolved_occurrences: List[CoreVar]
}


private union DceExprStack:
	NoDceExpr
	MoreDceExpr(CoreExpr, DceExprStack)


-- Task IDs in ConcurrentExpr occur immediately before their binding RHS.
private union DceReachabilityWork:
	VisitDceExpr(CoreExpr)
	ReferenceDceTask(Int)


private pure func push_reachability_work(
	pending: List[DceReachabilityWork],
	cursor: Int,
	item: DceReachabilityWork,
) -> List[DceReachabilityWork]:
	if cursor < pending.length():
		pending.set(cursor, item)
	else:
		pending.append(item)


private pure func push_value_expr(
	pending: List[CoreExpr],
	cursor: Int,
	expr: CoreExpr,
) -> List[CoreExpr]:
	if cursor < pending.length():
		pending.set(cursor, expr)
	else:
		pending.append(expr)


private pure func resolved_value_index_contains(
	index: Dict[Int, Dict[Int, Bool]],
	variable: CoreVar,
) -> Bool:
	match variable.def_id:
		Some(def_id):
			match index.get(def_id):
				Some(ids):
					ids.contains(variable.id)
				None:
					False
		None:
			False


private pure func add_resolved_value_to_index(
	index: Dict[Int, Dict[Int, Bool]],
	variable: CoreVar,
) -> Dict[Int, Dict[Int, Bool]]:
	match variable.def_id:
		Some(def_id):
			ids: Dict[Int, Bool] = index.get_or(def_id, {})
			index.set(def_id, ids.set(variable.id, True))
		None:
			index


-- Collect type names in first-occurrence order, including nested type arguments.
-- This separate collector also serves signatures and declaration dependencies.
private pure func collect_type_names(
	initial_names: List[String],
	types: List[CoreType],
) -> List[String]:
	var names: List[String] = initial_names
	var seen: Set[String] = Sets.from_list(initial_names)
	var pending: List[CoreType] = []
	var cursor: Int = 0
	var index: Int = types.length() - 1

	while index >= 0:
		match types.get(index):
			Some(typ):
				pending = pending.append(typ)
				cursor += 1
			None:
				void
		index -= 1

	while cursor > 0:
		cursor -= 1
		match pending.get(cursor):
			Some(current):
				var children: List[CoreType] = []
				match current:
					VoidType | TypeParameterType(_) | SelfType | RangeType:
						void
					NamedType(name, args):
						if not Sets.contains(seen, name):
							names = names.append(name)
							seen = Sets.add(seen, name)
						children = args
					EnumType(name) | ValueRecordType(name) | HeapRecordType(name) | UnionType(name):
						if not Sets.contains(seen, name):
							names = names.append(name)
							seen = Sets.add(seen, name)
					StackResultType(ok_type, error_type) | BoxedResultType(ok_type, error_type):
						children = [ok_type, error_type]
					FunctionType(_, params, return_type):
						children = params.append(return_type)
					TensorType(info):
						children = [info.element_type]
					TupleType(items):
						children = items

				var child_index: Int = children.length() - 1
				while child_index >= 0:
					match children.get(child_index):
						Some(child):
							pending = if cursor < pending.length():
								pending.set(cursor, child)
							else:
								pending.append(child)
							cursor += 1
						None:
							void
					child_index -= 1
			None:
				void

	names


private pure func hash_constructor_callback_names(
	constructor: CoreHashContainerConstructor,
) -> List[String]:
	match constructor:
		CustomHashContainerConstructor(hash_name, equals_name, needs_release):
			[hash_name, equals_name]
		GenericHashContainerConstructor | StringHashContainerConstructor | FloatHashContainerConstructor:
			[]


---
Collect only the dependencies needed by DCE's reachability closure. The lists,
sets, and dictionaries stay locally owned throughout the expression walk; a
single narrow record is published after the last expression.
---
private pure func collect_reachability_exprs(exprs: List[CoreExpr]) -> DceReachabilityDelta:
	var function_ids: List[Int] = []
	var function_id_set: Set[Int] = Sets.set()
	var function_names: List[String] = []
	var function_name_set: Set[String] = Sets.set()
	var constructor_references: List[DceConstructorReference] = []
	var trait_references: List[DceTraitReference] = []
	var global_names: List[String] = []
	var global_names_seen: Dict[String, Bool] = {}
	var expr_types: List[CoreType] = []
	var fail_closed: Bool = False
	var pending: List[DceReachabilityWork] = []
	var cursor: Int = 0
	var index: Int = exprs.length() - 1

	while index >= 0:
		match exprs.get(index):
			Some(expr):
				pending = pending.append(VisitDceExpr(expr))
				cursor += 1
			None:
				void
		index -= 1

	while cursor > 0:
		cursor -= 1
		match pending.get(cursor):
			Some(work):
				var candidate_id: Option[Int] = None
				var candidate_name: Option[String] = None
				var global_name: Option[String] = None
				var callback_names: List[String] = []

				match work:
					ReferenceDceTask(def_id):
						candidate_id = Some(def_id)
					VisitDceExpr(current):
						expr_types = expr_types.append(core_expr_type(current))
						match current:
							CallExpr(kind, callee, args, typ, loc):
								match kind:
									DeferredTraitCall(trait_name, method_name):
										trait_references = trait_references.append({
											trait_name = trait_name,
											method_name = method_name,
											selected_def_id = None,
										})
									SelectedTraitCall(trait_name, method_name, module_path, def_id):
										candidate_id = Some(def_id)
										trait_references = trait_references.append({
											trait_name = trait_name,
											method_name = method_name,
											selected_def_id = Some(def_id),
										})
									SelectedDirectCall(def_id):
										candidate_id = Some(def_id)
									UserCall(name, Some(def_id), consumed_args):
										candidate_id = Some(def_id)
										constructor_references = constructor_references.append({
											name = name,
											def_id = def_id,
										})
									UserCall(_, None, _):
										fail_closed = True
									DictWithCapacityCall(constructor):
										callback_names = hash_constructor_callback_names(constructor)
									ListToStringCall(callback_name):
										candidate_name = Some(callback_name)
									_:
										void

								-- A resolved target rewritten as UnknownCall can retain
								-- only its function-typed callee's name.
								match (kind, callee):
									(UnknownCall, VarExpr(variable, FunctionType(_, _, _), _)):
										if variable.def_id.is_none():
											candidate_name = Some(variable.name)
									_:
										void
							VarExpr(variable, typ, _) | DupExpr(variable, typ, _, _, _, _):
								match typ:
									FunctionType(_, _, _):
										match variable.def_id:
											Some(def_id):
												candidate_id = Some(def_id)
											None:
												global_name = Some(variable.name)
									_:
										global_name = Some(variable.name)
							AssignExpr(variable, rhs, typ, loc):
								global_name = Some(variable.name)
							TensorRawReadExpr(read, typ, loc):
								global_name = Some(read.view.name)
							TensorRawWriteExpr(write, typ, loc):
								global_name = Some(write.view.name)
							ClosureCreateExpr(closure, typ, loc):
								candidate_id = Some(closure.def_id)
							DetachExpr(detached, typ, loc):
								candidate_id = Some(detached.def_id)
							ConcurrentlyLoopExpr(loop, typ, loc):
								candidate_id = Some(loop.task.def_id)
							DictConstructExpr(construct, typ, loc):
								callback_names = hash_constructor_callback_names(construct.constructor)
							SetAllocExpr(constructor, typ, loc):
								callback_names = hash_constructor_callback_names(constructor)
							_:
								void

						-- Put the following binding's task immediately before its RHS.
						match current:
							ConcurrentExpr(block, typ, loc):
								match block.timeout:
									Some(timeout):
										pending = push_reachability_work(pending, cursor, VisitDceExpr(timeout))
										cursor += 1
									None:
										void
								pending = push_reachability_work(pending, cursor, VisitDceExpr(block.body))
								cursor += 1
								var binding_index: Int = block.bindings.length() - 1
								while binding_index >= 0:
									match block.bindings.get(binding_index):
										Some(binding):
											pending = push_reachability_work(pending, cursor, VisitDceExpr(binding.rhs))
											cursor += 1
											pending = push_reachability_work(pending, cursor, ReferenceDceTask(binding.task.def_id))
											cursor += 1
										None:
											void
									binding_index -= 1
							LiteralExpr(_, _, _) | StaticStringLiteralExpr(_, _, _, _) | VarExpr(_, _, _) | VoidExpr(_, _) | CooperativeCheckpointExpr(_, _) | ClosureCreateExpr(_, _, _) | DetachExpr(_, _, _) | BreakExpr(_, _) | ContinueExpr(_, _) | SetAllocExpr(_, _, _):
								void
							LetExpr(_, _, _, first, second) | BorrowLetExpr(_, _, first, second) | SeqExpr(first, second) | BinaryExpr(_, first, second, _, _) | LogicalExpr(_, first, second, _, _) | WhileExpr(first, second, _, _):
								pending = push_reachability_work(pending, cursor, VisitDceExpr(second))
								cursor += 1
								pending = push_reachability_work(pending, cursor, VisitDceExpr(first))
								cursor += 1
							AssignExpr(_, rhs, _, _):
								pending = push_reachability_work(pending, cursor, VisitDceExpr(rhs))
								cursor += 1
							_:
								children: List[CoreExpr] = CoreTraverse.immediate_core_expr_children(current)
								var child_index: Int = children.length() - 1
								while child_index >= 0:
									match children.get(child_index):
										Some(child):
											pending = push_reachability_work(pending, cursor, VisitDceExpr(child))
											cursor += 1
										None:
											void
									child_index -= 1

				match candidate_id:
					Some(def_id):
						if not Sets.contains(function_id_set, def_id):
							function_ids = function_ids.append(def_id)
							function_id_set = Sets.add(function_id_set, def_id)
					None:
						void

				match candidate_name:
					Some(name):
						if not Sets.contains(function_name_set, name):
							function_names = function_names.append(name)
							function_name_set = Sets.add(function_name_set, name)
					None:
						void

				for name in callback_names:
					if not Sets.contains(function_name_set, name):
						function_names = function_names.append(name)
						function_name_set = Sets.add(function_name_set, name)

				match global_name:
					Some(name):
						if not global_names_seen.contains(name):
							global_names = global_names.append(name)
							global_names_seen = global_names_seen.set(name, True)
					None:
						void
			None:
				void

	{
		function_ids = function_ids,
		function_names = function_names,
		constructor_references = constructor_references,
		trait_references = trait_references,
		global_names = global_names,
		type_names = collect_type_names([], expr_types),
		fail_closed = fail_closed
	}


private pure func collect_reachability_expr(expr: CoreExpr) -> DceReachabilityDelta:
	collect_reachability_exprs([expr])


private pure func append_resolved_value_occurrence(
	occurrences: List[CoreVar],
	variable: CoreVar,
) -> List[CoreVar]:
	if variable.def_id.is_some():
		occurrences.append(variable)
	else:
		occurrences


private pure func push_value_occurrence_children(
	pending: DceExprStack,
	expr: CoreExpr,
) -> DceExprStack:
	match expr:
		LiteralExpr(_, _, _) | StaticStringLiteralExpr(_, _, _, _) | VarExpr(_, _, _) | VoidExpr(_, _) | CooperativeCheckpointExpr(_, _) | ClosureCreateExpr(_, _, _) | DetachExpr(_, _, _) | BreakExpr(_, _) | ContinueExpr(_, _) | SetAllocExpr(_, _, _):
			pending
		DebugBlockExpr(body, _, _) | UnaryExpr(_, body, _, _) | CastExpr(body, _, _) | UnboxExpr(_, body, _, _) | FieldExpr(body, _, _, _) | TupleFieldExpr(body, _, _, _) | PreClosureDetachExpr(body, _, _):
			MoreDceExpr(body, pending)
		BinaryExpr(_, left, right, _, _) | LogicalExpr(_, left, right, _, _) | SeqExpr(left, right):
			MoreDceExpr(
				left,
				MoreDceExpr(right, pending),
			)
		LetExpr(_, _, _, rhs, body) | BorrowLetExpr(_, _, rhs, body):
			MoreDceExpr(
				rhs,
				MoreDceExpr(body, pending),
			)
		AssignExpr(_, rhs, _, _):
			MoreDceExpr(rhs, pending)
		DupExpr(_, _, _, body, _, _) | DropExpr(_, _, _, body, _, _):
			MoreDceExpr(body, pending)
		_:
			children: List[CoreExpr] = CoreTraverse.immediate_core_expr_children(expr)
			var updated: DceExprStack = pending
			var index: Int = children.length() - 1

			while index >= 0:
				match children.get(index):
					Some(child):
						updated = MoreDceExpr(child, updated)
					None:
						void

				index -= 1

			updated


---
Perceus needs every exact occurrence, including effects, but not DCE's
deduplicated read sets or reachability facts. Keeping that narrower contract
explicit avoids allocating the full facts record and identity indexes while
preserving source-order occurrence counts.
---
pure func resolved_value_occurrences(expr: CoreExpr) -> List[CoreVar]:
	var pending: DceExprStack = MoreDceExpr(expr, NoDceExpr)
	var occurrences: List[CoreVar] = []
	var complete: Bool = False

	while not complete:
		match pending:
			NoDceExpr:
				complete = True
			MoreDceExpr(current, remaining):
				pending = remaining

				occurrences = match current:
					VarExpr(variable, _, _):
						append_resolved_value_occurrence(occurrences, variable)
					AssignExpr(variable, _, _, _):
						append_resolved_value_occurrence(occurrences, variable)
					TensorRawReadExpr(read, _, _):
						append_resolved_value_occurrence(occurrences, read.view)
					TensorRawWriteExpr(write, _, _):
						append_resolved_value_occurrence(occurrences, write.view)
					DupExpr(variable, _, _, _, _, _):
						append_resolved_value_occurrence(occurrences, variable)
					DropExpr(variable, _, _, _, _, _):
						append_resolved_value_occurrence(occurrences, variable)
					_:
						occurrences

				pending = push_value_occurrence_children(pending, current)

	occurrences


pure func value_references(expr: CoreExpr) -> CoreValueReferences:
	var names: List[String] = []
	var names_seen: Dict[String, Bool] = {}
	var resolved_reads: List[CoreVar] = []
	var read_ids_by_def_id: Dict[Int, Dict[Int, Bool]] = {}
	var resolved_invalidations: List[CoreVar] = []
	var invalidation_ids_by_def_id: Dict[Int, Dict[Int, Bool]] = {}
	var resolved_occurrences: List[CoreVar] = []
	var pending: List[CoreExpr] = [expr]
	var cursor: Int = 1

	while cursor > 0:
		cursor -= 1
		match pending.get(cursor):
			Some(current):
				var read: Option[CoreVar] = None
				var invalidation: Option[CoreVar] = None
				var assigned_name: Option[String] = None
				match current:
					VarExpr(variable, _, _) | DupExpr(variable, _, _, _, _, _):
						read = Some(variable)
					AssignExpr(variable, rhs, typ, loc):
						invalidation = Some(variable)
						assigned_name = Some(variable.name)
					TensorRawReadExpr(raw_read, typ, loc):
						read = Some(raw_read.view)
					TensorRawWriteExpr(raw_write, typ, loc):
						read = Some(raw_write.view)
					DropExpr(variable, _, _, _, _, _):
						invalidation = Some(variable)
					_:
						void

				match read:
					Some(variable):
						if not names_seen.contains(variable.name):
							names = names.append(variable.name)
							names_seen = names_seen.set(variable.name, True)
						match variable.def_id:
							Some(def_id):
								resolved_occurrences = resolved_occurrences.append(variable)
								if not resolved_value_index_contains(read_ids_by_def_id, variable):
									resolved_reads = resolved_reads.append(variable)
									read_ids_by_def_id = add_resolved_value_to_index(read_ids_by_def_id, variable)
							None:
								void
					None:
						void

				match invalidation:
					Some(variable):
						match variable.def_id:
							Some(def_id):
								resolved_occurrences = resolved_occurrences.append(variable)
								if not resolved_value_index_contains(invalidation_ids_by_def_id, variable):
									resolved_invalidations = resolved_invalidations.append(variable)
									invalidation_ids_by_def_id = add_resolved_value_to_index(
										invalidation_ids_by_def_id,
										variable,
									)
							None:
								void
					None:
						void

				match assigned_name:
					Some(name):
						if not names_seen.contains(name):
							names = names.append(name)
							names_seen = names_seen.set(name, True)
					None:
						void

				match current:
					LiteralExpr(_, _, _) | StaticStringLiteralExpr(_, _, _, _) | VarExpr(_, _, _) | VoidExpr(_, _) | CooperativeCheckpointExpr(_, _) | ClosureCreateExpr(_, _, _) | DetachExpr(_, _, _) | BreakExpr(_, _) | ContinueExpr(_, _) | SetAllocExpr(_, _, _):
						void
					LetExpr(_, _, _, first, second) | BorrowLetExpr(_, _, first, second) | SeqExpr(first, second) | BinaryExpr(_, first, second, _, _) | LogicalExpr(_, first, second, _, _) | WhileExpr(first, second, _, _):
						pending = push_value_expr(pending, cursor, second)
						cursor += 1
						pending = push_value_expr(pending, cursor, first)
						cursor += 1
					AssignExpr(_, rhs, _, _):
						pending = push_value_expr(pending, cursor, rhs)
						cursor += 1
					_:
						children: List[CoreExpr] = CoreTraverse.immediate_core_expr_children(current)
						var child_index: Int = children.length() - 1
						while child_index >= 0:
							match children.get(child_index):
								Some(child):
									pending = push_value_expr(pending, cursor, child)
									cursor += 1
								None:
									void
							child_index -= 1
			None:
				void

	{
		names = names,
		resolved_reads = resolved_reads,
		resolved_invalidations = resolved_invalidations,
		resolved_occurrences = resolved_occurrences
	}


private pure func function_is_prunable(function_kind: CoreFunctionKind) -> Bool:
	match function_kind:
		UserFunction:
			True
		ProgramEntrypointFunction:
			True
		ClosureBodyFunction(abi):
			True
		BuiltinFunction(c_name):
			False
		UnresolvedBuiltinFunction:
			False
		ForeignFunction(_):
			False


record DceReachabilityIndex {
	functions_by_id: Dict[Int, CoreFunction],
	function_collisions_by_id: Dict[Int, List[CoreFunction]],
	function_ids_by_name: Dict[String, List[Int]],
	impl_method_ids_by_trait_method: Dict[String, List[Int]],
	constructors_by_name: Dict[String, List[DceConstructorIdentity]],
	globals_by_name: Dict[String, CoreGlobal],
	type_decls_by_name: Dict[String, List[CoreDecl]]
}


---
Turns the trait references a body recorded into concrete roots. Every
implementation of the trait method is a possible target; a resolved
`selected_def_id` that the index knows is an exact target on its own. A trait
method with no implementation has no body in Core at all, so that reference
is genuinely unresolvable and the program has to survive intact.
---
private pure func apply_trait_references(
	index: DceReachabilityIndex,
	facts: DceReachabilityDelta,
) -> DceReachabilityDelta:
	var function_ids: List[Int] = facts.function_ids
	var function_id_set: Set[Int] = Sets.from_list(function_ids)
	var fail_closed: Bool = facts.fail_closed

	for reference in facts.trait_references:
		candidates: List[Int] = index.impl_method_ids_by_trait_method.get_or(
			trait_method_key(reference.trait_name, reference.method_name),
			[],
		)

		for candidate in candidates:
			if not Sets.contains(function_id_set, candidate):
				function_ids = function_ids.append(candidate)
				function_id_set = Sets.add(function_id_set, candidate)

		if candidates.is_empty():
			selected_is_known: Bool = match reference.selected_def_id:
				Some(selected):
					index.functions_by_id.contains(selected)
				None:
					False

			if not selected_is_known:
				fail_closed = True

	{ facts | function_ids = function_ids, fail_closed = fail_closed }


private pure func function_facts_for_id(
	index: DceReachabilityIndex,
	def_id: Int,
) -> Option[DceReachabilityDelta]:
	var bodies: List[CoreExpr] = []

	match index.function_collisions_by_id.get(def_id):
		Some(functions):
			for function_info in functions:
				match function_info.body:
					Some(body):
						bodies = bodies.append(body)
					None:
						void

			Some(apply_trait_references(index, collect_reachability_exprs(bodies)))
		None:
			match index.functions_by_id.get(def_id):
				Some(function_info):
					match function_info.body:
						Some(body):
							Some(apply_trait_references(index, collect_reachability_expr(body)))
						None:
							Some(collect_reachability_exprs([]))
				None:
					None


private pure func core_dce_type_decl_name(decl: CoreDecl) -> Option[String]:
	match decl:
		EnumDecl(enum_info):
			Some(enum_info.name)
		UnionDecl(union_info):
			Some(union_info.name)
		ValueRecordDecl(record_info):
			Some(record_info.name)
		HeapRecordDecl(record_info):
			Some(record_info.name)
		TypeAliasDecl(alias_info):
			Some(alias_info.name)
		_:
			None


private pure func add_constructor_identity(
	constructors_by_name: Dict[String, List[DceConstructorIdentity]],
	name: String,
	parent_type_name: String,
	def_id: Int,
) -> Dict[String, List[DceConstructorIdentity]]:
	constructors_by_name.set(
		name,
		constructors_by_name
			.get_or(name, [])
			.append({
				parent_type_name = parent_type_name,
				def_id = def_id,
			}),
	)


private pure func add_type_decl(
	type_decls_by_name: Dict[String, List[CoreDecl]],
	decl: CoreDecl,
) -> Dict[String, List[CoreDecl]]:
	match core_dce_type_decl_name(decl):
		Some(name):
			type_decls_by_name.set(
				name,
				type_decls_by_name
					.get_or(name, [])
					.append(decl),
			)
		None:
			type_decls_by_name


-- Trait and method names are separate fields, so they are joined with a
-- separator that cannot occur in either: Core spells both as identifiers.
private TRAIT_METHOD_KEY_SEPARATOR: String = " "


private pure func trait_method_key(trait_name: String, method_name: String) -> String:
	trait_name + TRAIT_METHOD_KEY_SEPARATOR + method_name


private pure func build_reachability_index(program_value: CoreProgram) -> DceReachabilityIndex:
	var functions_by_id: Dict[Int, CoreFunction] = {}
	var function_collisions_by_id: Dict[Int, List[CoreFunction]] = {}
	var function_ids_by_name: Dict[String, List[Int]] = {}
	var constructors_by_name: Dict[String, List[DceConstructorIdentity]] = {}
	var globals_by_name: Dict[String, CoreGlobal] = {}
	var type_decls_by_name: Dict[String, List[CoreDecl]] = {}
	var impl_method_ids_by_trait_method: Dict[String, List[Int]] = {}

	-- Top-level functions and impl methods are indexed identically, so the decl
	-- walk only gathers them and the indexing loop below owns the collision
	-- bookkeeping once.
	var indexed_functions: List[CoreFunction] = []

	for decl in program_value.decls:
		match decl:
			FunctionDecl(function_info):
				indexed_functions = indexed_functions.append(function_info)
			ImplDecl(impl_info):
				for method in impl_info.methods:
					indexed_functions = indexed_functions.append(method)
					key: String = trait_method_key(impl_info.trait_name, method.name)
					impl_method_ids_by_trait_method = impl_method_ids_by_trait_method.set(
						key,
						impl_method_ids_by_trait_method
							.get_or(key, [])
							.append(method.def_id),
					)
			GlobalDecl(global):
				-- Preserve the original first-declaration lookup behavior.
				if not globals_by_name.contains(global.name.name):
					globals_by_name = globals_by_name.set(global.name.name, global)
			EnumDecl(enum_info):
				for variant in enum_info.variants:
					match variant.def_id:
						Some(def_id):
							constructors_by_name = add_constructor_identity(
								constructors_by_name,
								variant.name,
								enum_info.name,
								def_id,
							)
						None:
							void

				type_decls_by_name = add_type_decl(type_decls_by_name, decl)
			UnionDecl(union_info):
				for variant in union_info.variants:
					match variant.def_id:
						Some(def_id):
							constructors_by_name = add_constructor_identity(
								constructors_by_name,
								variant.name,
								union_info.name,
								def_id,
							)
						None:
							void

				type_decls_by_name = add_type_decl(type_decls_by_name, decl)
			_:
				type_decls_by_name = add_type_decl(type_decls_by_name, decl)

	for function_info in indexed_functions:
		match functions_by_id.get(function_info.def_id):
			Some(existing):
				function_collisions_by_id = function_collisions_by_id.set(
					function_info.def_id,
					function_collisions_by_id
						.get_or(function_info.def_id, [existing])
						.append(function_info),
				)
			None:
				functions_by_id = functions_by_id.set(function_info.def_id, function_info)

		function_ids_by_name = function_ids_by_name.set(
			function_info.name,
			function_ids_by_name
				.get_or(function_info.name, [])
				.append(function_info.def_id),
		)

	{
		functions_by_id = functions_by_id,
		function_collisions_by_id = function_collisions_by_id,
		function_ids_by_name = function_ids_by_name,
		impl_method_ids_by_trait_method = impl_method_ids_by_trait_method,
		constructors_by_name = constructors_by_name,
		globals_by_name = globals_by_name,
		type_decls_by_name = type_decls_by_name
	}


private record DceRoots {
	reachable: List[Int],
	reachable_set: Set[Int],
	reachable_globals: List[String],
	reachable_global_set: Set[String],
	fail_closed: Bool,
	saw_main: Bool
}


private pure func collect_roots(
	index: DceReachabilityIndex,
	program_value: CoreProgram,
	functions: List[CoreFunction],
) -> DceRoots:
	var reachable: List[Int] = []
	var reachable_set: Set[Int] = Sets.set()
	var reachable_globals: List[String] = []
	var reachable_global_set: Set[String] = Sets.set()
	var fail_closed: Bool = False
	var saw_main: Bool = False
	var globals: List[CoreGlobal] = []
	var impl_methods: List[CoreFunction] = []

	for decl in program_value.decls:
		match decl:
			GlobalDecl(global):
				globals = globals.append(global)
			ImplDecl(impl_info):
				for method in impl_info.methods:
					impl_methods = impl_methods.append(method)
			_:
				void

	for function_info in functions:
		if function_info.function_kind == ProgramEntrypointFunction:
			saw_main = True

			if not Sets.contains(reachable_set, function_info.def_id):
				reachable = reachable.append(function_info.def_id)
				reachable_set = Sets.add(reachable_set, function_info.def_id)
		else if not function_is_prunable(function_info.function_kind):
			if not Sets.contains(reachable_set, function_info.def_id):
				reachable = reachable.append(function_info.def_id)
				reachable_set = Sets.add(reachable_set, function_info.def_id)

	-- `keep_decl` retains every impl declaration, so each surviving method is a
	-- root: whatever its body calls or names must survive with it.
	for method in impl_methods:
		if not Sets.contains(reachable_set, method.def_id):
			reachable = reachable.append(method.def_id)
			reachable_set = Sets.add(reachable_set, method.def_id)

	-- Global initializers are the one body whose facts the reachability walk
	-- collects without going through `function_facts_for_id`, so an unresolvable
	-- trait reference in one would otherwise go unnoticed. Rooting stays with
	-- the reachability walk, which already visits the initializer of every
	-- global it reaches; only the fail-closed decision is made here, and it is
	-- made for every global rather than only the reached ones because refusing
	-- to prune is always the safe answer.
	for global in globals:
		if not global.is_private and not Sets.contains(reachable_global_set, global.name.name):
			reachable_globals = reachable_globals.append(global.name.name)
			reachable_global_set = Sets.add(reachable_global_set, global.name.name)

		initializer_facts: DceReachabilityDelta = apply_trait_references(
			index,
			collect_reachability_expr(global.init),
		)

		if initializer_facts.fail_closed:
			fail_closed = True

	{
		reachable = reachable,
		reachable_set = reachable_set,
		reachable_globals = reachable_globals,
		reachable_global_set = reachable_global_set,
		fail_closed = fail_closed,
		saw_main = saw_main
	}


record DceClosure {
	reachable: List[Int],
	reachable_globals: List[String],
	reachable_types: List[String],
	fail_closed: Bool
}


private pure func close_reachability(index: DceReachabilityIndex, roots: DceRoots) -> DceClosure:
	-- The six closure collections stay as locals for the whole fixpoint instead
	-- of being carried through a state record. A record owner would give every
	-- collection a second reference, so each append would copy the whole
	-- collection once per worklist step rather than extend it in place. Each
	-- collection is copied at most once here, on its first append.
	var reachable: List[Int] = roots.reachable
	var reachable_set: Set[Int] = roots.reachable_set
	var reachable_globals: List[String] = roots.reachable_globals
	var reachable_global_set: Set[String] = roots.reachable_global_set
	var reachable_types: List[String] = []
	var reachable_type_set: Set[String] = Sets.set()
	var fail_closed: Bool = False
	var next_function_index: Int = 0
	var next_global_index: Int = 0

	while (
		not fail_closed
		and ((
			next_function_index < reachable.length()
			or next_global_index < reachable_globals.length()
		))
	):
		var pending: Option[DceReachabilityDelta] = None

		if next_function_index < reachable.length():
			match reachable.get(next_function_index):
				Some(def_id):
					next_function_index += 1
					pending = function_facts_for_id(index, def_id)
				None:
					next_function_index += 1
		else:
			match reachable_globals.get(next_global_index):
				Some(name):
					next_global_index += 1

					match index.globals_by_name.get(name):
						Some(global):
							pending = Some(collect_reachability_expr(global.init))
						None:
							void
				None:
					next_global_index += 1

		match pending:
			Some(facts):
				if facts.fail_closed:
					fail_closed = True
				else:
					for def_id in facts.function_ids:
						if not Sets.contains(reachable_set, def_id):
							reachable = reachable.append(def_id)
							reachable_set = Sets.add(reachable_set, def_id)

					for name in facts.function_names:
						for def_id in index.function_ids_by_name.get_or(name, []):
							if not Sets.contains(reachable_set, def_id):
								reachable = reachable.append(def_id)
								reachable_set = Sets.add(reachable_set, def_id)

					for reference in facts.constructor_references:
						for constructor in index.constructors_by_name.get_or(reference.name, []):
							if (
								constructor.def_id == reference.def_id
								and not Sets.contains(
									reachable_type_set,
									constructor.parent_type_name,
								)
							):
								reachable_types = reachable_types.append(
									constructor.parent_type_name,
								)
								reachable_type_set = Sets.add(
									reachable_type_set,
									constructor.parent_type_name,
								)
							else:
								void

					for name in facts.global_names:
						if (
							index.globals_by_name.contains(name)
							and not Sets.contains(reachable_global_set, name)
						):
							reachable_globals = reachable_globals.append(name)
							reachable_global_set = Sets.add(reachable_global_set, name)

					for name in facts.type_names:
						if not Sets.contains(reachable_type_set, name):
							reachable_types = reachable_types.append(name)
							reachable_type_set = Sets.add(reachable_type_set, name)
			None:
				void

	{
		reachable = reachable,
		reachable_globals = reachable_globals,
		reachable_types = reachable_types,
		fail_closed = fail_closed
	}


private pure func function_is_kept(reachable: Set[Int], function_info: CoreFunction) -> Bool:
	not function_is_prunable(function_info.function_kind) or Sets.contains(reachable, function_info.def_id)


private pure func collect_type_roots(
	program_value: CoreProgram,
	reachable: Set[Int],
	reachable_globals: Set[String],
	body_type_names: List[String],
) -> List[String]:
	var types: List[CoreType] = []

	for decl in program_value.decls:
		match decl:
			FunctionDecl(function_info):
				if function_is_kept(reachable, function_info):
					types = types.append(function_info.return_type)
					for param in function_info.params:
						types = types.append(param.typ)
			GlobalDecl(global):
				if not global.is_private or Sets.contains(reachable_globals, global.name.name):
					types = types.append(global.typ)
			ImplDecl(impl_info):
				-- Impl declarations are never pruned, so their signatures root types.
				types = types.append(impl_info.for_type)
				for method in impl_info.methods:
					types = types.append(method.return_type)
					for param in method.params:
						types = types.append(param.typ)
			_:
				void

	collect_type_names(body_type_names, types)


private pure func decl_type_dependencies(decl: CoreDecl) -> List[CoreType]:
	var types: List[CoreType] = []
	match decl:
		UnionDecl(union_info):
			for variant in union_info.variants:
				for field in variant.fields:
					types = types.append(field.typ)
		ValueRecordDecl(record_info):
			for field in record_info.fields:
				types = types.append(field.typ)
		HeapRecordDecl(record_info):
			for field in record_info.fields:
				types = types.append(field.typ)
		TypeAliasDecl(alias_info):
			types = types.append(alias_info.target)
		_:
			void
	types


private pure func close_type_reachability(
	index: DceReachabilityIndex,
	reachable: List[String],
) -> List[String]:
	var result = reachable
	var reachable_set: Set[String] = Sets.from_list(reachable)
	var next_index: Int = 0

	while next_index < result.length():
		match result.get(next_index):
			Some(name):
				next_index += 1
				var types: List[CoreType] = []

				for decl in index.type_decls_by_name.get_or(name, []):
					types = types.concat(decl_type_dependencies(decl))

				for dependency in collect_type_names([], types):
					if not Sets.contains(reachable_set, dependency):
						result = result.append(dependency)
						reachable_set = Sets.add(reachable_set, dependency)
			None:
				next_index += 1

	result


private pure func keep_decl(
	reachable_functions: Set[Int],
	reachable_globals: Set[String],
	reachable_types: Set[String],
	decl: CoreDecl,
) -> Bool:
	match decl:
		FunctionDecl(function_info):
			function_is_kept(reachable_functions, function_info)
		GlobalDecl(global):
			not global.is_private or Sets.contains(reachable_globals, global.name.name)
		EnumDecl(enum_info):
			Sets.contains(reachable_types, enum_info.name)
		UnionDecl(union_info):
			Sets.contains(reachable_types, union_info.name)
		ValueRecordDecl(record_info):
			Sets.contains(reachable_types, record_info.name)
		HeapRecordDecl(record_info):
			Sets.contains(reachable_types, record_info.name)
		TypeAliasDecl(alias_decl):
			True
		TraitDecl(trait_decl):
			True
		ImplDecl(impl_decl):
			True


pure func prune_program(program_value: CoreProgram) -> CoreProgram:
	functions: List[CoreFunction] = program_value.decls.filter_map(func(decl):
		match decl:
			FunctionDecl(function_info):
				Some(function_info)
			_:
				None
	)
	index: DceReachabilityIndex = build_reachability_index(program_value)
	roots: DceRoots = collect_roots(index, program_value, functions)

	if roots.fail_closed or not roots.saw_main:
		program_value
	else:
		closure: DceClosure = close_reachability(index, roots)

		if closure.fail_closed:
			program_value
		else:
			reachable_functions: Set[Int] = Sets.from_list(closure.reachable)
			reachable_globals: Set[String] = Sets.from_list(closure.reachable_globals)
			type_roots: List[String] = collect_type_roots(
				program_value,
				reachable_functions,
				reachable_globals,
				closure.reachable_types,
			)
			reachable_types: List[String] = close_type_reachability(index, type_roots)
			reachable_type_set: Set[String] = Sets.from_list(reachable_types)
			{ program_value |
				decls = program_value.decls.filter(
					func(
						decl,
					): keep_decl(reachable_functions, reachable_globals, reachable_type_set, decl),
				)
			}
