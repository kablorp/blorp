-- Reuse analysis and rewrites for the Blorp-owned Core tail.
--
-- The normal post-Perceus pass consumes explicit drops around compatible fresh
-- collection allocations or producer handoffs. The prepared-union pass rewrites
-- a prepared match result that immediately drops its source into a union reuse
-- construct, but only when every managed source field has been moved out and the
-- new payload cannot alias the source.
import:
	ir:
		CoreAccessor(
			BoxedInlineTaggedPayloadAccessor, BoxedResultErrPayloadAccessor,
			BoxedResultOkPayloadAccessor, BoxedStackResultErrPayloadAccessor,
			BoxedStackResultOkPayloadAccessor, ErasedVariantFieldAccessor, ListElementAccessor,
			ListSpreadAccessor, NullableOptionPayloadAccessor, RootAccessor,
			InlineTaggedPayloadAccessor, StackResultErrPayloadAccessor,
			StackResultOkPayloadAccessor, ProductFieldAccessor, VariantFieldAccessor,
		),
		CoreBinderOrigin(DerivedFrom, PassTemporary),
		DerivedTempKind(DropTemp),
		PassTempKind(ProductFieldTemp, RecordUpdateTemp),
		CoreBoxedStorageValue,
		CoreCallKind(
			BuiltinCall, ClosureCall, DeferredTraitCall, DictWithCapacityCall, DirectRuntimeCall,
			FallibleStreamTerminalCall, ForeignCall, IntrinsicCall, ListToStringCall,
			OperationResultCall, SelectedDirectCall, SelectedTraitCall, TensorParallelCall,
			UnknownCall, UserCall,
		),
		CoreConstructorLengthMatch,
		CoreConstructorLengthMatchBranch,
		CoreConstructorLengthMatchCase,
		CoreConstructorLengthMatchGeq,
		CoreConstructorLiteralMatch,
		CoreConstructorMatchBody(
			ConstructorMatchBodyExpr, ConstructorMatchBodyLength, ConstructorMatchBodyLiteral,
		),
		CoreConstructorMatchCase,
		CoreConstructorMatchFallback(
			ConstructorMatchFallbackBindings, ConstructorMatchFallbackBody,
			ConstructorMatchFallbackFail,
		),
		CoreDecl(GeneratedTupleRecordDecl, InlineRecordDecl, UnionDecl, FunctionDecl, GlobalDecl, HeapRecordDecl, ImplDecl, TraitDecl, TypeAliasDecl),
		CoreDictEntry,
		CoreDictLiteralEntry,
		CoreExpr(
			AccessorLiteralMatchExpr, AssignExpr, BinaryExpr, BorrowLetExpr, BoxExpr, BreakExpr,
			CastExpr, CallExpr, ClosureCreateExpr, ConcurrentExpr, ConcurrentlyLoopExpr,
			ConstructorMatchExpr, ContinueExpr, CooperativeCheckpointExpr, DebugBlockExpr,
			DetachExpr, DictConstructExpr, DictExpr, ProductFieldExpr, ModuleMemberExpr,
			ForChannelExpr, ForDictExpr,
			ForListExpr, ForRangeExpr, ForResourceSourceExpr, ForSetExpr, ForStreamExpr,
			ForStringExpr, ForTensorExpr, IfExpr, LambdaExpr, DropExpr, DupExpr, LetExpr,
			LengthMatchExpr, ListAllocExpr, ListConstructExpr, ListGetExpr, ListHandoffExpr,
			ListHandoffSetOwnedExpr, ListHandoffSetSourceSlotExpr, ListRetainExpr, ListSetExpr,
			ListSwapExpr, LiteralExpr, LiteralMatchExpr, LogicalExpr,
			ProductExpr, RecordCowUpdateExpr, RecordReuseExpr, RecordUpdateExpr,
			PreClosureConcurrentExpr, PreClosureConcurrentlyLoopExpr, PreClosureDetachExpr,
			RawMatchExpr, ResourceCleanupExitExpr, ResourceScopeExpr, SemanticMatchExpr, SelectExpr,
			SeqExpr, SetAllocExpr, StaticStringLiteralExpr, StringByteCopyExpr, StringByteReadExpr,
			StringByteWriteExpr, StringSetLenExpr, TailrecListSpreadLoopExpr,
			TailrecListSpreadRecurExpr, TailrecLoopExpr, TailrecRecurExpr, TensorBoxedLiteralExpr,
			TensorLiteralExpr, TensorPackedLiteralExpr, TensorRawFillExpr, TensorRawReadExpr,
			TensorRawViewLetExpr, TensorRawWriteExpr, TupleExpr,
			UnaryExpr, UnionConstructExpr, UnionReuseConstructExpr, UnboxExpr, VarExpr, VectorExpr,
			VoidExpr, WhileExpr,
		),
		CoreFieldOrdinal,
		CoreFunction,
		CoreGlobal,
		CoreListHandoffMode(BorrowFreshHandoff, ConsumeReuseHandoff),
		CoreLiteral(IntLiteral),
		CoreLiteralMatchCase,
		CoreLiteralMatchFallback(
			LiteralMatchFallbackBindings, LiteralMatchFallbackBody, LiteralMatchFallbackFail,
		),
		CoreMatchBinding,
		CoreMatchBindingMode(MatchBorrowBindingMode, MatchOwnBindingMode),
		CoreProductBuild,
		CoreProgram,
		CoreRecordCowField,
		CoreReleasePolicy(ArcReleasePolicy),
		CoreRetainPolicy(ArcRetainPolicy, CowFieldTakeRetainPolicy),
		CoreSourceLoc,
		CoreType(
			InlineRecordType, NativeManagedType, BoxedResultType, UnionType, FunctionType,
			HeapRecordType, NamedType, RangeType, SelfType, StackResultType, TensorType, TupleType,
			TypeParameterType, VoidType,
		),
		CoreUnionConstruct,
		CoreUnionDecl,
		CoreUnionField,
		CoreUnionRepresentation(
			BoxedOptionRepresentation, GenericUnionRepresentation, NullableOptionRepresentation,
			InlineTaggedRepresentation, StackResultRepresentation,
		),
		CoreUnionReuseConstruct,
		CoreUnionStorage(ScalarTagStorage, ManagedPayloadStorage),
		CoreUnionValueStorage(ScalarTagValue, ManagedUnionValue),
		CoreUnionVariant,
		CoreVar,
		CoreVariantRef(
			BuiltinOptionNone, BuiltinOptionSome, BuiltinResultErr, BuiltinResultOk, VariantById,
		),
		core_expr_type,
		core_field_ordinal,
		core_field_ordinal_index,
		core_field_ordinals_equal,
		core_type_equal,
		core_var_equal,
		map_product_build_fields,
		product_build_fields,
		product_build_values,
		synthetic_core_source_loc,
	memory: same_object
	product_type: core_product_of, interim_product_record
	traverse as CoreTraverse
	type_policy: release_policy_requires_release


record SourceAlias {
	name: String,
	aliases_source: Bool
}


private record PreparedReuseLayout {
	variants_by_union_name: Dict[String, List[CoreUnionVariant]]
}


private record HoistedFieldAlias {
	source_var: CoreVar,
	ordinal: CoreFieldOrdinal
}


pure func core_expr_is_var(expr: CoreExpr, expected: CoreVar) -> Bool:
	match expr:
		VarExpr(variable, typ, loc):
			core_var_equal(variable, expected)
		LiteralExpr(literal, typ, loc):
			False
		StaticStringLiteralExpr(id, value, typ, loc):
			False
		VoidExpr(typ, loc):
			False
		DebugBlockExpr(body, typ, loc):
			False
		CooperativeCheckpointExpr(typ, loc):
			False
		CallExpr(kind, callee, args, typ, loc):
			False
		BinaryExpr(op, left, right, typ, loc):
			False
		UnaryExpr(op, inner, typ, loc):
			False
		LogicalExpr(op, left, right, typ, loc):
			False
		AssignExpr(variable, rhs, typ, loc):
			False
		CastExpr(inner, typ, loc):
			False
		BoxExpr(box, typ, loc):
			False
		UnboxExpr(unbox_kind, inner, typ, loc):
			False
		ProductFieldExpr(inner, _, typ, loc):
			False
		ModuleMemberExpr(_, _, _, _):
			False
		TupleExpr(items, typ, loc):
			False
		VectorExpr(items, typ, loc):
			False
		LambdaExpr(lambda_params, lambda_return_type, lambda_body, lambda_is_pure, typ, loc):
			False
		ClosureCreateExpr(closure, typ, loc):
			False
		ListConstructExpr(construct, typ, loc):
			False
		ListAllocExpr(alloc, typ, loc):
			False
		ListGetExpr(get, typ, loc):
			False
		ListHandoffExpr(handoff, typ, loc):
			False
		ListHandoffSetOwnedExpr(set, typ, loc):
			False
		ListHandoffSetSourceSlotExpr(set, typ, loc):
			False
		StringByteReadExpr(read, typ, loc):
			False
		StringByteWriteExpr(write, typ, loc):
			False
		StringByteCopyExpr(copy, typ, loc):
			False
		StringSetLenExpr(set_len, typ, loc):
			False
		TensorLiteralExpr(literal, typ, loc):
			False
		TensorBoxedLiteralExpr(literal, typ, loc):
			False
		TensorPackedLiteralExpr(literal, typ, loc):
			False
		TensorRawFillExpr(fill, typ, loc):
			False
		TensorRawReadExpr(read, typ, loc):
			False
		TensorRawWriteExpr(write, typ, loc):
			False
		TensorRawViewLetExpr(binding, body, typ, loc):
			False
		DictExpr(entries, typ, loc):
			False
		DictConstructExpr(construct, typ, loc):
			False
		SetAllocExpr(alloc, typ, loc):
			False
		ListRetainExpr(retain, typ, loc):
			False
		ListSetExpr(set, typ, loc):
			False
		ListSwapExpr(swap, typ, loc):
			False
		ProductExpr(build, typ, loc):
			False
		RecordUpdateExpr(base, fields, typ, loc):
			False
		RecordReuseExpr(source, build, typ, loc):
			False
		RecordCowUpdateExpr(source, fields, typ, loc):
			False
		UnionConstructExpr(construct, typ, loc):
			False
		UnionReuseConstructExpr(construct, typ, loc):
			False
		PreClosureDetachExpr(detached, typ, loc):
			False
		DetachExpr(detached, typ, loc):
			False
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			False
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			False
		LetExpr(variable, is_mutable, value_type, rhs, body):
			False
		BorrowLetExpr(variable, value_type, rhs, body):
			False
		SeqExpr(first, second):
			False
		WhileExpr(cond, body, typ, loc):
			False
		BreakExpr(typ, loc):
			False
		ContinueExpr(typ, loc):
			False
		ResourceScopeExpr(scope, typ, loc):
			False
		ResourceCleanupExitExpr(exit, typ, loc):
			False
		TailrecLoopExpr(params, return_type, body, loc):
			False
		TailrecRecurExpr(args, typ, loc):
			False
		TailrecListSpreadLoopExpr(loop, loc):
			False
		TailrecListSpreadRecurExpr(rebinds, spread_index, typ, loc):
			False
		ForRangeExpr(binder, start, end, step, typ, loc):
			False
		ForChannelExpr(loop, typ, loc):
			False
		ForListExpr(loop, typ, loc):
			False
		ForStringExpr(loop, typ, loc):
			False
		ForDictExpr(loop, typ, loc):
			False
		ForSetExpr(loop, typ, loc):
			False
		ForStreamExpr(loop, typ, loc):
			False
		ForResourceSourceExpr(loop, typ, loc):
			False
		ForTensorExpr(loop, typ, loc):
			False
		PreClosureConcurrentlyLoopExpr(loop, typ, loc):
			False
		ConcurrentlyLoopExpr(loop, typ, loc):
			False
		PreClosureConcurrentExpr(block, typ, loc):
			False
		ConcurrentExpr(block, typ, loc):
			False
		SelectExpr(selection, typ, loc):
			False
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			False
		RawMatchExpr(scrutinee, cases, typ, loc):
			False
		SemanticMatchExpr(scrutinee, tree, typ, loc):
			False
		AccessorLiteralMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			False
		LengthMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			False
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			False
		IfExpr(cond, then_expr, else_expr, typ, loc):
			False


private pure func int_expr(value: Int, typ: CoreType) -> CoreExpr:
	LiteralExpr(IntLiteral(value), typ, synthetic_core_source_loc())


private pure func var_expr(variable: CoreVar, typ: CoreType) -> CoreExpr:
	VarExpr(variable, typ, synthetic_core_source_loc())


private VOID_EXPR: CoreExpr = VoidExpr(VoidType, synthetic_core_source_loc())


private pure func core_type_is_list(typ: CoreType) -> Bool:
	match typ:
		NamedType(name, args):
			name == "List" and args.length() == 1
		TypeParameterType(_) | SelfType:
			False
		NativeManagedType(_) | VoidType:
			False
		StackResultType(ok_type, err_type):
			False
		BoxedResultType(ok_type, err_type):
			False
		FunctionType(_, _, _):
			False
		HeapRecordType(name):
			False
		InlineRecordType(name):
			False
		UnionType(name, _):
			False
		RangeType:
			False
		TensorType(info):
			False
		TupleType(items):
			False


private pure func core_type_is_dict(typ: CoreType) -> Bool:
	match typ:
		NamedType(name, args):
			name == "Dict" and args.length() == 2
		TypeParameterType(_) | SelfType:
			False
		NativeManagedType(_) | VoidType:
			False
		StackResultType(ok_type, err_type):
			False
		BoxedResultType(ok_type, err_type):
			False
		FunctionType(_, _, _):
			False
		HeapRecordType(name):
			False
		InlineRecordType(name):
			False
		UnionType(name, _):
			False
		RangeType:
			False
		TensorType(info):
			False
		TupleType(items):
			False


private pure func core_type_is_set(typ: CoreType) -> Bool:
	match typ:
		NamedType(name, args):
			name == "Set" and args.length() == 1
		TypeParameterType(_) | SelfType:
			False
		NativeManagedType(_) | VoidType:
			False
		StackResultType(ok_type, err_type):
			False
		BoxedResultType(ok_type, err_type):
			False
		FunctionType(_, _, _):
			False
		HeapRecordType(name):
			False
		InlineRecordType(name):
			False
		UnionType(name, _):
			False
		RangeType:
			False
		TensorType(info):
			False
		TupleType(items):
			False


private pure func reuse_type_compatible(dropped_type: CoreType, allocation_type: CoreType) -> Bool:
	if core_type_is_list(dropped_type) and core_type_is_list(allocation_type):
		core_type_equal(dropped_type, allocation_type)
	else if core_type_is_dict(dropped_type) and core_type_is_dict(allocation_type):
		core_type_equal(dropped_type, allocation_type)
	else if core_type_is_set(dropped_type) and core_type_is_set(allocation_type):
		core_type_equal(dropped_type, allocation_type)
	else:
		False


private pure func boxed_value_touches_var(value: CoreBoxedStorageValue, target: CoreVar) -> Bool:
	owner_touched(target, value.value)


private pure func boxed_values_touch_var(
	values: List[CoreBoxedStorageValue],
	target: CoreVar,
) -> Bool:
	var touched: Bool = False

	for value in values:
		if boxed_value_touches_var(value, target):
			touched = True
			break

	touched


private pure func dict_entries_touch_var(entries: List[CoreDictEntry], target: CoreVar) -> Bool:
	var touched: Bool = False

	for entry in entries:
		if (
			boxed_value_touches_var(entry.key, target)
			or boxed_value_touches_var(entry.value, target)
		):
			touched = True
			break

	touched


private pure func record_cow_fields_touch_var(
	fields: List[CoreRecordCowField],
	target: CoreVar,
) -> Bool:
	fields.any(pure func(field) -> Bool:
		match field.replacement:
			Some(replacement):
				owner_touched(target, replacement)
			None:
				False
	)


private pure func exprs_assign_var(exprs: List[CoreExpr], target: CoreVar) -> Bool:
	exprs.any(func(expr): CoreTraverse.core_expr_assigns_var(expr, target))


private pure func exprs_touch_var(exprs: List[CoreExpr], target: CoreVar) -> Bool:
	CoreTraverse.any_core_expr(exprs, func(expr): owner_touched(target, expr))


private pure func owner_touched(target: CoreVar, expr: CoreExpr) -> Bool:
	match expr:
		VarExpr(variable, typ, loc):
			core_var_equal(variable, target)
		LiteralExpr(literal, typ, loc):
			False
		StaticStringLiteralExpr(id, value, typ, loc):
			False
		VoidExpr(typ, loc):
			False
		DebugBlockExpr(body, typ, loc):
			owner_touched(target, body)
		CooperativeCheckpointExpr(typ, loc):
			False
		CallExpr(kind, callee, args, typ, loc):
			owner_touched(target, callee) or exprs_touch_var(args, target)
		BinaryExpr(op, left, right, typ, loc):
			owner_touched(target, left) or owner_touched(target, right)
		UnaryExpr(op, inner, typ, loc):
			owner_touched(target, inner)
		LogicalExpr(op, left, right, typ, loc):
			owner_touched(target, left) or owner_touched(target, right)
		AssignExpr(variable, rhs, typ, loc):
			core_var_equal(variable, target) or owner_touched(target, rhs)
		CastExpr(inner, typ, loc):
			owner_touched(target, inner)
		BoxExpr(box, typ, loc):
			owner_touched(target, box.value)
		UnboxExpr(unbox_kind, inner, typ, loc):
			owner_touched(target, inner)
		ProductFieldExpr(inner, _, typ, loc):
			owner_touched(target, inner)
		ModuleMemberExpr(_, _, _, _):
			False
		TupleExpr(items, typ, loc):
			exprs_touch_var(items, target)
		VectorExpr(items, typ, loc):
			exprs_touch_var(items, target)
		LambdaExpr(lambda_params, lambda_return_type, lambda_body, lambda_is_pure, typ, loc):
			True
		ClosureCreateExpr(closure, typ, loc):
			False
		ListConstructExpr(construct, typ, loc):
			boxed_values_touch_var(construct.elements, target)
		ListAllocExpr(alloc, typ, loc):
			owner_touched(target, alloc.capacity)
		ListGetExpr(get, typ, loc):
			owner_touched(target, get.list) or owner_touched(target, get.index)
		ListHandoffExpr(handoff, typ, loc):
			(
				owner_touched(target, handoff.source)
				or owner_touched(target, handoff.capacity)
				or owner_touched(target, handoff.body)
			)
		ListHandoffSetOwnedExpr(set, typ, loc):
			(
				owner_touched(target, set.list)
				or owner_touched(target, set.index)
				or boxed_value_touches_var(set.value, target)
			)
		ListHandoffSetSourceSlotExpr(set, typ, loc):
			(
				owner_touched(target, set.result)
				or owner_touched(target, set.out_index)
				or owner_touched(target, set.source)
				or owner_touched(target, set.source_index)
			)
		StringByteReadExpr(read, typ, loc):
			owner_touched(target, read.source) or owner_touched(target, read.index)
		StringByteWriteExpr(write, typ, loc):
			(
				owner_touched(target, write.target)
				or owner_touched(target, write.index)
				or owner_touched(target, write.byte)
			)
		StringByteCopyExpr(copy, typ, loc):
			(
				owner_touched(target, copy.dst)
				or owner_touched(target, copy.dst_pos)
				or owner_touched(target, copy.src)
				or owner_touched(target, copy.src_pos)
				or owner_touched(target, copy.len)
			)
		StringSetLenExpr(set_len, typ, loc):
			owner_touched(target, set_len.target) or owner_touched(target, set_len.len)
		TensorLiteralExpr(literal, typ, loc):
			True
		TensorBoxedLiteralExpr(literal, typ, loc):
			boxed_values_touch_var(literal.elements, target)
		TensorPackedLiteralExpr(literal, typ, loc):
			True
		TensorRawFillExpr(fill, typ, loc):
			True
		TensorRawReadExpr(read, typ, loc):
			True
		TensorRawWriteExpr(write, typ, loc):
			True
		TensorRawViewLetExpr(binding, body, typ, loc):
			owner_touched(target, binding.source) or owner_touched(target, body)
		DictExpr(entries, typ, loc):
			CoreTraverse.any_core_dict_literal_entry_exprs(
				entries,
				func(expr): owner_touched(target, expr),
			)
		DictConstructExpr(construct, typ, loc):
			dict_entries_touch_var(construct.entries, target)
		SetAllocExpr(alloc, typ, loc):
			False
		ListRetainExpr(retain, typ, loc):
			owner_touched(target, retain.list) or boxed_value_touches_var(retain.value, target)
		ListSetExpr(set, typ, loc):
			(
				owner_touched(target, set.list)
				or owner_touched(target, set.index)
				or boxed_value_touches_var(set.value, target)
			)
		ListSwapExpr(swap, typ, loc):
			(
				owner_touched(target, swap.list)
				or owner_touched(target, swap.left_index)
				or owner_touched(target, swap.right_index)
			)
		ProductExpr(build, typ, loc):
			exprs_touch_var(product_build_values(build), target)
		RecordUpdateExpr(base, fields, typ, loc):
			owner_touched(target, base) or exprs_touch_var(fields.map(func(field): field.value), target)
		RecordReuseExpr(source, build, typ, loc):
			owner_touched(target, source) or exprs_touch_var(product_build_values(build), target)
		RecordCowUpdateExpr(source, fields, typ, loc):
			owner_touched(target, source) or record_cow_fields_touch_var(fields, target)
		UnionConstructExpr(construct, typ, loc):
			boxed_values_touch_var(construct.args, target)
		UnionReuseConstructExpr(construct, typ, loc):
			(
				owner_touched(target, construct.source)
				or boxed_values_touch_var(construct.args, target)
			)
		PreClosureDetachExpr(detached, typ, loc):
			True
		DetachExpr(detached, typ, loc):
			True
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			core_var_equal(variable, target) or owner_touched(target, body)
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			core_var_equal(variable, target) or owner_touched(target, body)
		LetExpr(variable, is_mutable, value_type, rhs, body):
			owner_touched(target, rhs) or owner_touched(target, body)
		BorrowLetExpr(variable, value_type, rhs, body):
			owner_touched(target, rhs) or owner_touched(target, body)
		SeqExpr(first, second):
			owner_touched(target, first) or owner_touched(target, second)
		WhileExpr(cond, body, typ, loc):
			True
		BreakExpr(typ, loc):
			False
		ContinueExpr(typ, loc):
			False
		ResourceScopeExpr(scope, typ, loc):
			True
		ResourceCleanupExitExpr(exit, typ, loc):
			False
		TailrecLoopExpr(params, return_type, body, loc):
			True
		TailrecRecurExpr(args, typ, loc):
			exprs_touch_var(args, target)
		TailrecListSpreadLoopExpr(loop, loc):
			True
		TailrecListSpreadRecurExpr(rebinds, spread_index, typ, loc):
			True
		ForRangeExpr(binder, start, end, step, typ, loc):
			(
				owner_touched(target, start)
				or owner_touched(target, end)
				or owner_touched(target, step)
			)
		ForChannelExpr(loop, typ, loc):
			True
		ForListExpr(loop, typ, loc):
			True
		ForStringExpr(loop, typ, loc):
			True
		ForDictExpr(loop, typ, loc):
			True
		ForSetExpr(loop, typ, loc):
			True
		ForStreamExpr(loop, typ, loc):
			True
		ForResourceSourceExpr(loop, typ, loc):
			True
		ForTensorExpr(loop, typ, loc):
			True
		PreClosureConcurrentlyLoopExpr(loop, typ, loc):
			True
		ConcurrentlyLoopExpr(loop, typ, loc):
			True
		PreClosureConcurrentExpr(block, typ, loc):
			True
		ConcurrentExpr(block, typ, loc):
			True
		SelectExpr(selection, typ, loc):
			True
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			True
		RawMatchExpr(scrutinee, cases, typ, loc):
			True
		SemanticMatchExpr(scrutinee, tree, typ, loc):
			True
		AccessorLiteralMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			True
		LengthMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			True
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			True
		IfExpr(cond, then_expr, else_expr, typ, loc):
			(
				owner_touched(target, cond)
				or owner_touched(target, then_expr)
				or owner_touched(target, else_expr)
			)


private pure func contains_resource_scope(expr: CoreExpr) -> Bool:
	match expr:
		ResourceScopeExpr(scope, typ, loc):
			True
		LetExpr(variable, is_mutable, value_type, rhs, body):
			contains_resource_scope(rhs) or contains_resource_scope(body)
		BorrowLetExpr(variable, value_type, rhs, body):
			contains_resource_scope(rhs) or contains_resource_scope(body)
		SeqExpr(first, second):
			contains_resource_scope(first) or contains_resource_scope(second)
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			contains_resource_scope(body)
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			contains_resource_scope(body)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			(
				contains_resource_scope(cond)
				or contains_resource_scope(then_expr)
				or contains_resource_scope(else_expr)
			)
		CallExpr(kind, callee, args, typ, loc):
			contains_resource_scope(callee) or exprs_contain_resource_scope(args)
		BinaryExpr(op, left, right, typ, loc):
			contains_resource_scope(left) or contains_resource_scope(right)
		UnaryExpr(op, inner, typ, loc):
			contains_resource_scope(inner)
		LogicalExpr(op, left, right, typ, loc):
			contains_resource_scope(left) or contains_resource_scope(right)
		AssignExpr(variable, rhs, typ, loc):
			contains_resource_scope(rhs)
		CastExpr(inner, typ, loc):
			contains_resource_scope(inner)
		UnboxExpr(unbox_kind, inner, typ, loc):
			contains_resource_scope(inner)
		ProductFieldExpr(inner, _, typ, loc):
			contains_resource_scope(inner)
		ModuleMemberExpr(_, _, _, _):
			False
		TupleExpr(items, typ, loc):
			exprs_contain_resource_scope(items)
		VectorExpr(items, typ, loc):
			exprs_contain_resource_scope(items)
		ListAllocExpr(alloc, typ, loc):
			contains_resource_scope(alloc.capacity)
		ListHandoffExpr(handoff, typ, loc):
			(
				contains_resource_scope(handoff.source)
				or contains_resource_scope(handoff.capacity)
				or contains_resource_scope(handoff.body)
			)
		LiteralExpr(literal, typ, loc):
			False
		StaticStringLiteralExpr(id, value, typ, loc):
			False
		VarExpr(variable, typ, loc):
			False
		VoidExpr(typ, loc):
			False
		DebugBlockExpr(body, typ, loc):
			contains_resource_scope(body)
		CooperativeCheckpointExpr(typ, loc):
			False
		BoxExpr(box, typ, loc):
			contains_resource_scope(box.value)
		LambdaExpr(lambda_params, lambda_return_type, lambda_body, lambda_is_pure, typ, loc):
			False
		ClosureCreateExpr(closure, typ, loc):
			False
		ListConstructExpr(construct, typ, loc):
			False
		ListGetExpr(get, typ, loc):
			contains_resource_scope(get.list) or contains_resource_scope(get.index)
		ListHandoffSetOwnedExpr(set, typ, loc):
			contains_resource_scope(set.list) or contains_resource_scope(set.index)
		ListHandoffSetSourceSlotExpr(set, typ, loc):
			contains_resource_scope(set.result) or contains_resource_scope(set.source)
		StringByteReadExpr(read, typ, loc):
			contains_resource_scope(read.source) or contains_resource_scope(read.index)
		StringByteWriteExpr(write, typ, loc):
			contains_resource_scope(write.target) or contains_resource_scope(write.index)
		StringByteCopyExpr(copy, typ, loc):
			contains_resource_scope(copy.dst) or contains_resource_scope(copy.src)
		StringSetLenExpr(set_len, typ, loc):
			contains_resource_scope(set_len.target) or contains_resource_scope(set_len.len)
		TensorLiteralExpr(literal, typ, loc):
			False
		TensorBoxedLiteralExpr(literal, typ, loc):
			False
		TensorPackedLiteralExpr(literal, typ, loc):
			False
		TensorRawFillExpr(fill, typ, loc):
			False
		TensorRawReadExpr(read, typ, loc):
			False
		TensorRawWriteExpr(write, typ, loc):
			False
		TensorRawViewLetExpr(binding, body, typ, loc):
			contains_resource_scope(binding.source) or contains_resource_scope(body)
		DictExpr(entries, typ, loc):
			CoreTraverse.any_core_dict_literal_entry_exprs(entries, contains_resource_scope)
		DictConstructExpr(construct, typ, loc):
			False
		SetAllocExpr(alloc, typ, loc):
			False
		ListRetainExpr(retain, typ, loc):
			contains_resource_scope(retain.list)
		ListSetExpr(set, typ, loc):
			contains_resource_scope(set.list) or contains_resource_scope(set.index)
		ListSwapExpr(swap, typ, loc):
			contains_resource_scope(swap.list)
		ProductExpr(build, typ, loc):
			False
		RecordUpdateExpr(base, fields, typ, loc):
			contains_resource_scope(base)
		RecordReuseExpr(source, build, typ, loc):
			contains_resource_scope(source)
		RecordCowUpdateExpr(source, fields, typ, loc):
			CoreTraverse
				.immediate_core_expr_children(expr)
				.any(contains_resource_scope)
		UnionConstructExpr(construct, typ, loc):
			False
		UnionReuseConstructExpr(construct, typ, loc):
			contains_resource_scope(construct.source)
		PreClosureDetachExpr(detached, typ, loc):
			True
		DetachExpr(detached, typ, loc):
			True
		WhileExpr(cond, body, typ, loc):
			True
		BreakExpr(typ, loc):
			False
		ContinueExpr(typ, loc):
			False
		ResourceCleanupExitExpr(exit, typ, loc):
			False
		TailrecLoopExpr(params, return_type, body, loc):
			True
		TailrecRecurExpr(args, typ, loc):
			exprs_contain_resource_scope(args)
		TailrecListSpreadLoopExpr(loop, loc):
			True
		TailrecListSpreadRecurExpr(rebinds, spread_index, typ, loc):
			True
		ForRangeExpr(binder, start, end, step, typ, loc):
			(
				contains_resource_scope(start)
				or contains_resource_scope(end)
				or contains_resource_scope(step)
			)
		ForChannelExpr(loop, typ, loc):
			True
		ForListExpr(loop, typ, loc):
			True
		ForStringExpr(loop, typ, loc):
			True
		ForDictExpr(loop, typ, loc):
			True
		ForSetExpr(loop, typ, loc):
			True
		ForStreamExpr(loop, typ, loc):
			True
		ForResourceSourceExpr(loop, typ, loc):
			True
		ForTensorExpr(loop, typ, loc):
			True
		PreClosureConcurrentlyLoopExpr(loop, typ, loc):
			True
		ConcurrentlyLoopExpr(loop, typ, loc):
			True
		PreClosureConcurrentExpr(block, typ, loc):
			True
		ConcurrentExpr(block, typ, loc):
			True
		SelectExpr(selection, typ, loc):
			True
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			True
		AccessorLiteralMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			True
		LengthMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			True
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			True
		RawMatchExpr(scrutinee, cases, typ, loc):
			True
		SemanticMatchExpr(scrutinee, tree, typ, loc):
			True


private pure func exprs_contain_resource_scope(exprs: List[CoreExpr]) -> Bool:
	CoreTraverse.any_core_expr(exprs, contains_resource_scope)


private pure func is_collection_allocation(expr: CoreExpr) -> Bool:
	match expr:
		ListAllocExpr(alloc, typ, loc):
			core_type_is_list(typ)
		SetAllocExpr(alloc, typ, loc):
			core_type_is_set(typ)
		DictConstructExpr(construct, typ, loc):
			core_type_is_dict(typ) and construct.entries.length() == 0
		CallExpr(kind, callee, args, typ, loc):
			match kind:
				IntrinsicCall(name):
					name == "list_alloc" or name == "set_alloc" or name == "dict_alloc"
				BuiltinCall(name):
					(
						name == "blorp_set_new"
						or name == "blorp_set_new_string"
						or name == "blorp_set_new_float"
						or name == "blorp_set_new_int128"
						or name == "blorp_set_new_custom"
						or name == "blorp_dict_new"
						or name == "blorp_dict_new_string"
						or name == "blorp_dict_new_float"
						or name == "blorp_dict_new_int128"
						or name == "blorp_dict_new_custom"
						or name == "blorp_dict_with_capacity"
						or name == "blorp_dict_with_capacity_string"
						or name == "blorp_dict_with_capacity_float"
						or name == "blorp_dict_with_capacity_int128"
						or name == "blorp_dict_with_capacity_custom"
					)
				UserCall(name, def_id, captured_def_ids):
					False
				ForeignCall(name, arg_passing):
					False
				DirectRuntimeCall(call):
					False
				OperationResultCall(call):
					False
				FallibleStreamTerminalCall(call):
					False
				TensorParallelCall(name, layout):
					False
				DictWithCapacityCall(constructor):
					False
				ListToStringCall(name, _):
					False
				ClosureCall:
					False
				UnknownCall:
					False
				DeferredTraitCall(trait_name, method_name):
					False
				SelectedTraitCall(trait_name, method_name, module_path, def_id):
					False
				SelectedDirectCall(def_id):
					False
		LiteralExpr(literal, typ, loc):
			False
		StaticStringLiteralExpr(id, value, typ, loc):
			False
		VarExpr(variable, typ, loc):
			False
		VoidExpr(typ, loc):
			False
		DebugBlockExpr(body, typ, loc):
			False
		CooperativeCheckpointExpr(typ, loc):
			False
		RawMatchExpr(scrutinee, cases, typ, loc):
			False
		SemanticMatchExpr(scrutinee, tree, typ, loc):
			False
		BinaryExpr(op, left, right, typ, loc):
			False
		UnaryExpr(op, inner, typ, loc):
			False
		LogicalExpr(op, left, right, typ, loc):
			False
		AssignExpr(variable, rhs, typ, loc):
			False
		CastExpr(inner, typ, loc):
			False
		BoxExpr(box, typ, loc):
			False
		UnboxExpr(unbox_kind, inner, typ, loc):
			False
		ProductFieldExpr(inner, _, typ, loc):
			False
		ModuleMemberExpr(_, _, _, _):
			False
		TupleExpr(items, typ, loc):
			False
		VectorExpr(items, typ, loc):
			False
		LambdaExpr(lambda_params, lambda_return_type, lambda_body, lambda_is_pure, typ, loc):
			False
		ClosureCreateExpr(closure, typ, loc):
			False
		ListConstructExpr(construct, typ, loc):
			False
		ListGetExpr(get, typ, loc):
			False
		ListHandoffExpr(handoff, typ, loc):
			False
		ListHandoffSetOwnedExpr(set, typ, loc):
			False
		ListHandoffSetSourceSlotExpr(set, typ, loc):
			False
		StringByteReadExpr(read, typ, loc):
			False
