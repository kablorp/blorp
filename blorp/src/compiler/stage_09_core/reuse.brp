private pure func reuse_boundary_call(
	dropped_var: CoreVar,
	dropped_type: CoreType,
	allocation_type: CoreType,
	capacity: CoreExpr,
	reuse_name: String,
) -> CoreExpr:
	CallExpr(
		IntrinsicCall(reuse_name),
		VOID_EXPR,
		[var_expr(dropped_var, dropped_type), capacity],
		allocation_type,
		synthetic_core_source_loc(),
	)


private pure func reuse_alloc_rhs(
	dropped_var: CoreVar,
	dropped_type: CoreType,
	bind_rhs: CoreExpr,
) -> Option[CoreExpr]:
	match bind_rhs:
		ListAllocExpr(alloc, allocation_type, loc):
			if reuse_type_compatible(dropped_type, allocation_type):
				Some(
					reuse_boundary_call(
						dropped_var,
						dropped_type,
						allocation_type,
						alloc.capacity,
						"list_reuse_alloc",
					),
				)
			else:
				None
		SetAllocExpr(alloc, allocation_type, loc):
			if reuse_type_compatible(dropped_type, allocation_type):
				Some(
					reuse_boundary_call(
						dropped_var,
						dropped_type,
						allocation_type,
						int_expr(
							0,
							NamedType("Int", []),
						),
						"set_reuse_alloc",
					),
				)
			else:
				None
		DictConstructExpr(construct, allocation_type, loc):
			if (
				construct.entries.length() == 0
				and reuse_type_compatible(dropped_type, allocation_type)
			):
				Some(
					reuse_boundary_call(
						dropped_var,
						dropped_type,
						allocation_type,
						int_expr(
							0,
							NamedType("Int", []),
						),
						"dict_reuse_alloc",
					),
				)
			else:
				None
		CallExpr(kind, callee, args, allocation_type, loc):
			None
		LiteralExpr(literal, typ, loc):
			None
		StaticStringLiteralExpr(id, value, typ, loc):
			None
		VarExpr(variable, typ, loc):
			None
		VoidExpr(typ, loc):
			None
		DebugBlockExpr(body, typ, loc):
			None
		CooperativeCheckpointExpr(typ, loc):
			None
		RawMatchExpr(scrutinee, cases, typ, loc):
			None
		SemanticMatchExpr(scrutinee, tree, typ, loc):
			None
		BinaryExpr(op, left, right, typ, loc):
			None
		UnaryExpr(op, inner, typ, loc):
			None
		LogicalExpr(op, left, right, typ, loc):
			None
		AssignExpr(variable, rhs, typ, loc):
			None
		CastExpr(inner, typ, loc):
			None
		BoxExpr(box, typ, loc):
			None
		UnboxExpr(unbox_kind, inner, typ, loc):
			None
		ProductFieldExpr(inner, _, typ, loc):
			None
		ModuleMemberExpr(_, _, _, _):
			None
		TupleExpr(items, typ, loc):
			None
		VectorExpr(items, typ, loc):
			None
		LambdaExpr(lambda_params, lambda_return_type, lambda_body, lambda_is_pure, typ, loc):
			None
		ClosureCreateExpr(closure, typ, loc):
			None
		ListConstructExpr(construct, typ, loc):
			None
		ListGetExpr(get, typ, loc):
			None
		ListHandoffExpr(handoff, typ, loc):
