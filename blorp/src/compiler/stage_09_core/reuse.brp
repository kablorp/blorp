		ForStringExpr(loop, typ, loc):
			None
		ForDictExpr(loop, typ, loc):
			None
		ForSetExpr(loop, typ, loc):
			None
		ForStreamExpr(loop, typ, loc):
			None
		ForResourceSourceExpr(loop, typ, loc):
			None
		ForTensorExpr(loop, typ, loc):
			None
		ConcurrentlyLoopExpr(loop, typ, loc):
			None
		ConcurrentExpr(block, typ, loc):
			None
		SelectExpr(selection, typ, loc):
			None
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			None
		AccessorLiteralMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			None
		LengthMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			None
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			None
		IfExpr(cond, then_expr, else_expr, typ, loc):
			None


private pure func rewrite_prepared_expr_with_layout(
	layout: PreparedReuseLayout,
	expr: CoreExpr,
) -> CoreExpr:
	match expr:
		RawMatchExpr(scrutinee, cases, typ, loc):
			RawMatchExpr(
				rewrite_prepared_expr_with_layout(layout, scrutinee),
				cases.map(
					func(
						case,
					): { case | body = rewrite_prepared_expr_with_layout(layout, case.body) },
				),
				typ,
				loc,
			)
		SemanticMatchExpr(scrutinee, tree, typ, loc):
			CoreTraverse.map_core_expr_children_with_context(
				expr,
				layout,
				rewrite_prepared_expr_with_layout,
			)
		LetExpr(variable, is_mutable, value_type, rhs, body):
			rewritten_rhs: CoreExpr = rewrite_prepared_expr_with_layout(layout, rhs)
			rewritten_body: CoreExpr = rewrite_prepared_expr_with_layout(layout, body)

			match rewrite_prepared_let_drop(layout, variable, rewritten_rhs, rewritten_body):
				Some(rewritten):
					rewritten
				None:
					LetExpr(variable, is_mutable, value_type, rewritten_rhs, rewritten_body)
		BorrowLetExpr(variable, value_type, rhs, body):
			BorrowLetExpr(
				variable,
				value_type,
				rewrite_prepared_expr_with_layout(layout, rhs),
				rewrite_prepared_expr_with_layout(layout, body),
			)
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			DropExpr(
				variable,
				value_type,
				release_policy,
				rewrite_prepared_expr_with_layout(layout, body),
				typ,
				loc,
			)
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			DupExpr(
				variable,
				value_type,
				retain_policy,
				rewrite_prepared_expr_with_layout(layout, body),
				typ,
				loc,
			)
		SeqExpr(first, second):
			SeqExpr(
				rewrite_prepared_expr_with_layout(layout, first),
				rewrite_prepared_expr_with_layout(layout, second),
			)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			IfExpr(
				rewrite_prepared_expr_with_layout(layout, cond),
				rewrite_prepared_expr_with_layout(layout, then_expr),
				rewrite_prepared_expr_with_layout(layout, else_expr),
				typ,
				loc,
			)
		ConstructorMatchExpr(scrutinee, scrutinee_release_policy, cases, fallback, typ, loc):
			ConstructorMatchExpr(
				rewrite_prepared_expr_with_layout(layout, scrutinee),
				scrutinee_release_policy,
				cases.map(
					func(
						match_case,
					): { match_case |
						body = rewrite_child_constructor_match_body(layout, match_case.body)
					},
				),
				rewrite_child_constructor_match_fallback(layout, fallback),
				typ,
				loc,
			)
		LiteralExpr(literal, typ, loc):
			expr
		StaticStringLiteralExpr(id, value, typ, loc):
			expr
		VarExpr(variable, typ, loc):
			expr
		VoidExpr(typ, loc):
			expr
		DebugBlockExpr(body, typ, loc):
			DebugBlockExpr(
				rewrite_prepared_expr_with_layout(layout, body),
				typ,
				loc,
			)
		CooperativeCheckpointExpr(typ, loc):
			expr
		CallExpr(kind, callee, args, typ, loc):
			expr
		BinaryExpr(op, left, right, typ, loc):
			expr
		UnaryExpr(op, inner, typ, loc):
			expr
		LogicalExpr(op, left, right, typ, loc):
			expr
		AssignExpr(variable, rhs, typ, loc):
			expr
		CastExpr(inner, typ, loc):
			expr
		BoxExpr(box, typ, loc):
			expr
		UnboxExpr(unbox_kind, inner, typ, loc):
			expr
		ProductFieldExpr(inner, _, typ, loc):
			expr
		ModuleMemberExpr(_, _, _, _):
			expr
		TupleExpr(items, typ, loc):
			expr
		VectorExpr(items, typ, loc):
			expr
		LambdaExpr(lambda_params, lambda_return_type, lambda_body, lambda_is_pure, typ, loc):
			expr
		ClosureCreateExpr(closure, typ, loc):
			expr
		ListConstructExpr(construct, typ, loc):
			expr
		ListAllocExpr(alloc, typ, loc):
			expr
		ListGetExpr(get, typ, loc):
			expr
		ListHandoffExpr(handoff, typ, loc):
			expr
		ListHandoffSetOwnedExpr(set, typ, loc):
			expr
		ListHandoffSetSourceSlotExpr(set, typ, loc):
			expr
		StringByteReadExpr(read, typ, loc):
			expr
		StringByteWriteExpr(write, typ, loc):
			expr
		StringByteCopyExpr(copy, typ, loc):
			expr
		StringSetLenExpr(set_len, typ, loc):
			expr
		TensorLiteralExpr(literal, typ, loc):
			expr
		TensorBoxedLiteralExpr(literal, typ, loc):
			expr
		TensorPackedLiteralExpr(literal, typ, loc):
			expr
		TensorRawFillExpr(fill, typ, loc):
			expr
		TensorRawReadExpr(read, typ, loc):
			expr
		TensorRawWriteExpr(write, typ, loc):
			expr
		TensorRawViewLetExpr(binding, body, typ, loc):
			expr
		DictConstructExpr(construct, typ, loc):
			expr
		DictExpr(entries, typ, loc):
			expr
		SetAllocExpr(alloc, typ, loc):
			expr
		ListRetainExpr(retain, typ, loc):
			expr
		ListSetExpr(set, typ, loc):
			expr
		ListSwapExpr(swap, typ, loc):
			expr
		ProductExpr(build, typ, loc):
			expr
		RecordUpdateExpr(base, fields, typ, loc):
			expr
		RecordReuseExpr(source, build, typ, loc):
			expr
		RecordCowUpdateExpr(source, fields, typ, loc):
			expr
		UnionConstructExpr(construct, typ, loc):
			expr
		UnionReuseConstructExpr(construct, typ, loc):
			expr
		PreClosureDetachExpr(detached, typ, loc):
			expr
		DetachExpr(detached, typ, loc):
			expr
		WhileExpr(cond, body, typ, loc):
			expr
		BreakExpr(typ, loc):
			expr
		ContinueExpr(typ, loc):
			expr
		ResourceScopeExpr(scope, typ, loc):
			expr
		ResourceCleanupExitExpr(exit, typ, loc):
			expr
		TailrecLoopExpr(params, return_type, body, loc):
			expr
		TailrecRecurExpr(args, typ, loc):
			expr
		TailrecListSpreadLoopExpr(loop, loc):
			expr
		TailrecListSpreadRecurExpr(rebinds, spread_index, typ, loc):
			expr
		ForRangeExpr(binder, start, end, step, typ, loc):
			expr
		ForChannelExpr(loop, typ, loc):
			expr
		ForListExpr(loop, typ, loc):
			expr
		ForStringExpr(loop, typ, loc):
			expr
		ForDictExpr(loop, typ, loc):
			expr
		ForSetExpr(loop, typ, loc):
			expr
		ForStreamExpr(loop, typ, loc):
			expr
		ForResourceSourceExpr(loop, typ, loc):
			expr
		ForTensorExpr(loop, typ, loc):
			expr
		PreClosureConcurrentlyLoopExpr(loop, typ, loc):
			expr
		ConcurrentlyLoopExpr(loop, typ, loc):
			expr
		PreClosureConcurrentExpr(block, typ, loc):
			expr
		ConcurrentExpr(block, typ, loc):
			expr
		SelectExpr(selection, typ, loc):
			expr
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			expr
		AccessorLiteralMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			expr
		LengthMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			expr


private pure func rewrite_child_constructor_match_body(
	layout: PreparedReuseLayout,
	body: CoreConstructorMatchBody,
) -> CoreConstructorMatchBody:
	match body:
		ConstructorMatchBodyExpr(expr):
			ConstructorMatchBodyExpr(rewrite_prepared_expr_with_layout(layout, expr))
		ConstructorMatchBodyLiteral(match_expr):
			ConstructorMatchBodyLiteral({ match_expr |
					cases = rewrite_child_literal_match_cases(layout, match_expr.cases),
					fallback = rewrite_child_literal_match_fallback(layout, match_expr.fallback)
				})
		ConstructorMatchBodyLength(match_expr):
			ConstructorMatchBodyLength({ match_expr |
					cases = rewrite_child_length_match_cases(layout, match_expr.cases),
					geq = rewrite_child_length_match_geq(layout, match_expr.geq),
					fallback = rewrite_child_length_match_fallback(layout, match_expr.fallback)
				})


private pure func rewrite_child_constructor_match_fallback(
	layout: PreparedReuseLayout,
	fallback: CoreConstructorMatchFallback,
) -> CoreConstructorMatchFallback:
	match fallback:
		ConstructorMatchFallbackBody(body):
			ConstructorMatchFallbackBody(rewrite_prepared_expr_with_layout(layout, body))
		ConstructorMatchFallbackBindings(bindings, body):
			ConstructorMatchFallbackBindings(
				bindings,
				rewrite_prepared_expr_with_layout(layout, body),
			)
		ConstructorMatchFallbackFail:
			ConstructorMatchFallbackFail


private pure func rewrite_child_literal_match_cases(
	layout: PreparedReuseLayout,
	cases: List[CoreLiteralMatchCase],
) -> List[CoreLiteralMatchCase]:
	cases.map(
		func(
			match_case,
		): { match_case | body = rewrite_prepared_expr_with_layout(layout, match_case.body) },
	)


private pure func rewrite_child_literal_match_fallback(
	layout: PreparedReuseLayout,
	fallback: CoreLiteralMatchFallback,
) -> CoreLiteralMatchFallback:
	match fallback:
		LiteralMatchFallbackBody(body):
			LiteralMatchFallbackBody(rewrite_prepared_expr_with_layout(layout, body))
		LiteralMatchFallbackBindings(bindings, body):
			LiteralMatchFallbackBindings(
				bindings,
				rewrite_prepared_expr_with_layout(layout, body),
			)
		LiteralMatchFallbackFail:
			LiteralMatchFallbackFail


private pure func rewrite_child_length_branch(
	layout: PreparedReuseLayout,
	branch: CoreConstructorLengthMatchBranch,
) -> CoreConstructorLengthMatchBranch:
	{ branch | body = rewrite_child_constructor_match_body(layout, branch.body) }


private pure func rewrite_child_length_match_cases(
	layout: PreparedReuseLayout,
	cases: List[CoreConstructorLengthMatchCase],
) -> List[CoreConstructorLengthMatchCase]:
	cases.map(
		func(
			match_case,
		): { match_case | branch = rewrite_child_length_branch(layout, match_case.branch) },
	)


private pure func rewrite_child_length_match_geq(
	layout: PreparedReuseLayout,
	geq: Option[CoreConstructorLengthMatchGeq],
) -> Option[CoreConstructorLengthMatchGeq]:
	match geq:
		Some(value):
			Some({ value | branch = rewrite_child_length_branch(layout, value.branch) })
		None:
			None


private pure func rewrite_child_length_match_fallback(
	layout: PreparedReuseLayout,
	fallback: Option[CoreConstructorLengthMatchBranch],
) -> Option[CoreConstructorLengthMatchBranch]:
	match fallback:
		Some(branch):
			Some(rewrite_child_length_branch(layout, branch))
		None:
			None


private pure func rewrite_prepared_function(
	layout: PreparedReuseLayout,
	func_info: CoreFunction,
) -> CoreFunction:
	match func_info.body:
		Some(body):
			{ func_info | body = Some(rewrite_prepared_expr_with_layout(layout, body)) }
		None:
			func_info


private pure func rewrite_prepared_decl(layout: PreparedReuseLayout, decl: CoreDecl) -> CoreDecl:
	match decl:
		GeneratedTupleRecordDecl(_):
			decl
		FunctionDecl(func_info):
			FunctionDecl(rewrite_prepared_function(layout, func_info))
		GlobalDecl(global):
			GlobalDecl({ global | init = rewrite_prepared_expr_with_layout(layout, global.init) })
		UnionDecl(union_decl):
			decl
		HeapRecordDecl(record_decl):
			decl
		InlineRecordDecl(record_decl):
			decl
		TypeAliasDecl(alias_decl):
			decl
		TraitDecl(trait_decl):
			decl
		ImplDecl(impl_decl):
			ImplDecl(
				{ impl_decl |
					methods = impl_decl.methods.map(
						pure func(method): rewrite_prepared_function(layout, method),
					)
				},
			)


pure func rewrite_prepared_expr(decls: List[CoreDecl], expr: CoreExpr) -> CoreExpr:
	layout: PreparedReuseLayout = build_prepared_reuse_layout({
		decls = decls,
		foreign_includes = [],
		source_files = [],
	})
	rewrite_prepared_expr_with_layout(layout, expr)


pure func rewrite_prepared_program(program: CoreProgram) -> CoreProgram:
	layout: PreparedReuseLayout = build_prepared_reuse_layout(program)
	var decls: List[CoreDecl] = []

	for decl in program.decls:
		decls = decls.append(rewrite_prepared_decl(layout, decl))

	{ program | decls = decls }
