private pure func consume_handoff_rhs(
	dropped_var: CoreVar,
	dropped_type: CoreType,
	bind_rhs: CoreExpr,
) -> Option[CoreExpr]:
	match bind_rhs:
		ListHandoffExpr(handoff, typ, loc):
			if (
				handoff.mode == BorrowFreshHandoff
				and core_expr_is_var(handoff.source, dropped_var)
				and reuse_type_compatible(dropped_type, handoff.source_type)
				and reuse_type_compatible(dropped_type, handoff.result_type)
				and not owner_touched(dropped_var, handoff.capacity)
				and not owner_touched(dropped_var, handoff.body)
			):
				Some(ListHandoffExpr({ handoff | mode = ConsumeReuseHandoff }, typ, loc))
			else:
				None
		RawMatchExpr(scrutinee, cases, typ, loc):
			None
		SemanticMatchExpr(scrutinee, tree, typ, loc):
			None
		LiteralExpr(literal, typ, loc):
			None
		StaticStringLiteralExpr(id, value, typ, loc):
			None
		VarExpr(variable, typ, loc):
			None
		VoidExpr(typ, loc):
			None
		DebugBlockExpr(body, typ, loc):
			None
		CooperativeCheckpointExpr(typ, loc):
			None
		CallExpr(kind, callee, args, typ, loc):
			None
		BinaryExpr(op, left, right, typ, loc):
			None
		UnaryExpr(op, inner, typ, loc):
			None
		LogicalExpr(op, left, right, typ, loc):
			None
		AssignExpr(variable, rhs, typ, loc):
			None
		CastExpr(inner, typ, loc):
			None
		BoxExpr(box, typ, loc):
			None
		UnboxExpr(unbox_kind, inner, typ, loc):
			None
		ProductFieldExpr(inner, _, typ, loc):
			None
		ModuleMemberExpr(_, _, _, _):
			None
		TupleExpr(items, typ, loc):
			None
		VectorExpr(items, typ, loc):
			None
		LambdaExpr(lambda_params, lambda_return_type, lambda_body, lambda_is_pure, typ, loc):
			None
		ClosureCreateExpr(closure, typ, loc):
			None
		ListConstructExpr(construct, typ, loc):
			None
		ListAllocExpr(alloc, typ, loc):
			None
		ListGetExpr(get, typ, loc):
			None
		ListHandoffSetOwnedExpr(set, typ, loc):
			None
		ListHandoffSetSourceSlotExpr(set, typ, loc):
			None
		StringByteReadExpr(read, typ, loc):
			None
		StringByteWriteExpr(write, typ, loc):
			None
		StringByteCopyExpr(copy, typ, loc):
			None
		StringSetLenExpr(set_len, typ, loc):
			None
		TensorLiteralExpr(literal, typ, loc):
			None
		TensorBoxedLiteralExpr(literal, typ, loc):
			None
		TensorPackedLiteralExpr(literal, typ, loc):
			None
		TensorRawFillExpr(fill, typ, loc):
			None
		TensorRawReadExpr(read, typ, loc):
			None
		TensorRawWriteExpr(write, typ, loc):
			None
		TensorRawViewLetExpr(binding, body, typ, loc):
			None
		DictConstructExpr(construct, typ, loc):
			None
		DictExpr(entries, typ, loc):
			None
		SetAllocExpr(alloc, typ, loc):
			None
		ListRetainExpr(retain, typ, loc):
			None
		ListSetExpr(set, typ, loc):
			None
		ListSwapExpr(swap, typ, loc):
			None
		ProductExpr(build, typ, loc):
			None
		RecordUpdateExpr(base, fields, typ, loc):
			None
		RecordReuseExpr(source, build, typ, loc):
			None
		RecordCowUpdateExpr(source, fields, typ, loc):
			None
		UnionConstructExpr(construct, typ, loc):
			None
		UnionReuseConstructExpr(construct, typ, loc):
			None
		PreClosureDetachExpr(detached, typ, loc):
			None
		DetachExpr(detached, typ, loc):
			None
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			None
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			None
		LetExpr(variable, is_mutable, value_type, rhs, body):
			None
		BorrowLetExpr(variable, value_type, rhs, body):
			None
		SeqExpr(first, second):
			None
		WhileExpr(cond, body, typ, loc):
			None
		BreakExpr(typ, loc):
			None
		ContinueExpr(typ, loc):
			None
		ResourceScopeExpr(scope, typ, loc):
			None
		ResourceCleanupExitExpr(exit, typ, loc):
			None
		TailrecLoopExpr(params, return_type, body, loc):
			None
		TailrecRecurExpr(args, typ, loc):
			None
		TailrecListSpreadLoopExpr(loop, loc):
			None
		TailrecListSpreadRecurExpr(rebinds, spread_index, typ, loc):
			None
		ForRangeExpr(binder, start, end, step, typ, loc):
			None
		ForChannelExpr(loop, typ, loc):
			None
		ForListExpr(loop, typ, loc):
			None
		ForStringExpr(loop, typ, loc):
			None
		ForDictExpr(loop, typ, loc):
			None
		ForSetExpr(loop, typ, loc):
			None
		ForStreamExpr(loop, typ, loc):
			None
		ForResourceSourceExpr(loop, typ, loc):
			None
		ForTensorExpr(loop, typ, loc):
			None
		PreClosureConcurrentlyLoopExpr(loop, typ, loc):
			None
		ConcurrentlyLoopExpr(loop, typ, loc):
			None
		PreClosureConcurrentExpr(block, typ, loc):
			None
		ConcurrentExpr(block, typ, loc):
			None
		SelectExpr(selection, typ, loc):
			None
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			None
		AccessorLiteralMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			None
		LengthMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			None
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			None
		IfExpr(cond, then_expr, else_expr, typ, loc):
			None


private pure func heap_record_reuse_compatible(
	dropped_type: CoreType,
	allocation_type: CoreType,
) -> Bool:
	match (dropped_type, allocation_type):
		(HeapRecordType(dropped_name), HeapRecordType(allocation_name)):
			dropped_name == allocation_name
		_:
			False


private pure func is_arc_release_policy(release_policy: CoreReleasePolicy) -> Bool:
	match release_policy:
		ArcReleasePolicy:
			True
		_:
			False


---
Let a record-reuse field that consumes itself move the field out of a unique
source instead of retaining it.

A replacement such as `items = s.items.append(x)` reads the field it replaces
through Perceus's owned-alias shape, `BorrowLetExpr(temp, s.items,
DupExpr(temp, ...))`, which retains the field while the source record still
holds it, so the consuming callee observes a shared value and copies. When the
source is a bare consumed variable and that alias is the only read that could
observe the field slot across every replacement, the dup's policy becomes
`CowFieldTakeRetainPolicy`, which keeps the runtime uniqueness test and the
ordinary retain for shared sources. The source is read only after every
replacement, so nothing can observe the emptied slot before the update writes
it back, provided every replacement runs to completion: a replacement that
can `break` or `continue` out would leave the slot empty in a record that
outlives the update, so no field of such an update is taken.
---
private pure func take_self_consumed_build_values(
	source: CoreExpr,
	build: CoreProductBuild,
) -> CoreProductBuild:
	match source:
		VarExpr(source_var, _, _):
			taken: CoreProductBuild = take_build_values_from(source_var, build)

			-- The exit check walks every replacement, so it runs only when a
			-- field was taken.
			if same_object(taken, build):
				build
			else if product_build_values(build).any(func(value): CoreTraverse.core_expr_may_exit_early(value)):
				build
			else:
				taken
		_:
			build


-- A reuse writes every slot by its ordinal, so a value taken from the source
-- slot it replaces moves back into that slot.
private pure func take_build_values_from(
	source_var: CoreVar,
	build: CoreProductBuild,
) -> CoreProductBuild:
	values: List[CoreExpr] = product_build_values(build)

	map_product_build_fields(
		build,
		source_var,
		pure func(source: CoreVar, ordinal: CoreFieldOrdinal, value: CoreExpr) -> CoreExpr:
			var touches: Int = 0

			for other in values:
				touches += var_touch_count(source, ordinal, other)

			if touches == 1:
				take_field_alias(source, ordinal, value).get_or(value)
			else:
				value
	).get_or(build)


private pure func same_cow_field_list(
	taken: List[CoreRecordCowField],
	fields: List[CoreRecordCowField],
) -> Bool:
	var same: Bool = taken.length() == fields.length()
	var index: Int = 0

	for field in fields:
		match taken.get(index):
			Some(taken_field):
				same = same and same_cow_replacement(field.replacement, taken_field.replacement)
			None:
				same = False

		index += 1

	same


-- One constructor per match: the pinned bootstrap compiler binds the payload
-- of a nested constructor in a tuple pattern without testing its tag.
private pure func same_cow_replacement(original: Option[CoreExpr], taken: Option[CoreExpr]) -> Bool:
	match original:
		Some(original_value):
			match taken:
				Some(taken_value):
					same_object(original_value, taken_value)
				None:
					False
		None:
			taken.is_none()


---
Whether some replacement among `fields` can leave the update early.
---
private pure func cow_replacement_may_exit_early(fields: List[CoreRecordCowField]) -> Bool:
	fields.any(pure func(field) -> Bool:
		match field.replacement:
			Some(replacement):
				CoreTraverse.core_expr_may_exit_early(replacement)
			None:
				False
	)


---
The `RecordCowUpdateExpr` counterpart of `take_self_consumed_record_fields`;
inherited fields have no replacement and are never read or taken.
---
private pure func take_self_consumed_cow_fields(
	source: CoreExpr,
	fields: List[CoreRecordCowField],
) -> List[CoreRecordCowField]:
	match source:
		VarExpr(source_var, _, _):
			taken: List[CoreRecordCowField] = take_cow_fields_from(source_var, fields)

			-- The exit check walks every replacement, so it runs only when a
			-- field was taken.
			if same_cow_field_list(taken, fields):
				fields
			else if cow_replacement_may_exit_early(fields):
				fields
			else:
				taken
		_:
			fields


private pure func take_cow_fields_from(
	source_var: CoreVar,
	fields: List[CoreRecordCowField],
) -> List[CoreRecordCowField]:
	-- Ownership lowering builds one entry per field in declaration order,
	-- so the position is the field's ordinal. A copy-on-write update keeps
	-- every inherited slot.
	fields
		.enumerate()
		.map(pure func(entry: (Int, CoreRecordCowField)) -> CoreRecordCowField:
			(index, field) = entry
			ordinal: CoreFieldOrdinal = core_field_ordinal(index)

			match field.replacement:
				Some(replacement):
					var touches: Int = 0

					for other in fields:
						match other.replacement:
							Some(other_replacement):
								touches += var_touch_count(source_var, ordinal, other_replacement)
							None:
								void

					if touches == 1 and is_arc_release_policy(field.field.release_policy):
						match take_field_alias(source_var, ordinal, replacement):
							Some(taken):
								{ field | replacement = Some(taken) }
							None:
								field
					else:
						field
				None:
					field
		)


---
Count reads of `target` in `expr` that could observe an emptied slot at
`ordinal`.

A direct read of a different field counts zero. A lambda, closure, or
assignment of the target counts two, so a caller can never prove a single
read through something that captures the target for later or rebinds it.
---
private pure func var_touch_count(
	target: CoreVar,
	ordinal: CoreFieldOrdinal,
	expr: CoreExpr,
) -> Int:
	match expr:
		VarExpr(variable, _, _):
			if core_var_equal(variable, target):
				1
			else:
				0
		ProductFieldExpr(VarExpr(variable, _, _), read_ordinal, _, _):
			if (
				core_var_equal(variable, target)
				and not core_field_ordinals_equal(read_ordinal, ordinal)
			):
				0
			else:
				var_touch_count(
					target,
					ordinal,
					VarExpr(variable, VoidType, synthetic_core_source_loc()),
				)
		LambdaExpr(_, _, _, _, _, _) | ClosureCreateExpr(_, _, _):
			2
		AssignExpr(variable, rhs, _, _):
			if core_var_equal(variable, target):
				2
			else:
				var_touch_count(target, ordinal, rhs)
		DupExpr(variable, _, _, body, _, _):
			if core_var_equal(variable, target):
				2
			else:
				var_touch_count(target, ordinal, body)
		DropExpr(variable, _, _, body, _, _):
			if core_var_equal(variable, target):
				2
			else:
				var_touch_count(target, ordinal, body)
		_:
			var total: Int = 0

			for child in CoreTraverse.immediate_core_expr_children(expr):
				if total < 2:
					total += var_touch_count(target, ordinal, child)

			total


---
Whether a field of this type is stored as one heap pointer that a take may
leave null; inline managed values such as stack results are excluded.
---
private pure func field_take_type_allowed(typ: CoreType) -> Bool:
	match typ:
		NativeManagedType(_):
			True
		HeapRecordType(_):
			True
		NamedType(name, args):
			(
				core_type_is_list(typ)
				or core_type_is_dict(typ)
				or core_type_is_set(typ)
				or name == "String" and args.length() == 0
			)
		_:
			False


---
The name of the heap record `typ` is, or `None`: only a heap record's field can be
taken out of a unique owner.
---
private pure func heap_record_type_name(typ: CoreType) -> Option[String]:
	match typ:
		HeapRecordType(name):
			Some(name)
		_:
			None


---
Rewrite the owned-alias read of field `ordinal` of `source_var` in `expr` to the
field-take retain policy, or return `None` when the read is not on the
straight-line evaluation spine or the field is not a single heap pointer.

Descends only through positions that evaluate exactly once, in order, before
the enclosing record update consumes its source; a read under a branch, loop,
or lambda is left alone.
---
private pure func take_field_alias(
	source_var: CoreVar,
	ordinal: CoreFieldOrdinal,
	expr: CoreExpr,
) -> Option[CoreExpr]:
	match expr:
		BorrowLetExpr(temp, temp_type, ProductFieldExpr(VarExpr(owner, owner_type, owner_loc), read_ordinal, read_type, read_loc), DupExpr(dup_var, dup_type, ArcRetainPolicy, VarExpr(body_var, body_type, body_loc), result_type, dup_loc)):
			if (
				core_var_equal(owner, source_var)
				and core_field_ordinals_equal(read_ordinal, ordinal)
				and core_var_equal(dup_var, temp)
				and core_var_equal(body_var, temp)
				and field_take_type_allowed(temp_type)
				and field_take_type_allowed(dup_type)
			):
				match heap_record_type_name(owner_type):
					Some(record_name):
						Some(
							BorrowLetExpr(
								temp,
								temp_type,
								ProductFieldExpr(
									VarExpr(owner, owner_type, owner_loc),
									read_ordinal,
									read_type,
									read_loc,
								),
								DupExpr(
									dup_var,
									dup_type,
									CowFieldTakeRetainPolicy(source_var, ordinal, record_name),
									VarExpr(body_var, body_type, body_loc),
									result_type,
									dup_loc,
								),
							),
						)
					None:
						None
			else:
				None
		BorrowLetExpr(variable, value_type, rhs, body):
			match take_field_alias(source_var, ordinal, rhs):
				Some(taken):
					Some(BorrowLetExpr(variable, value_type, taken, body))
				None:
					take_field_alias(
						source_var,
						ordinal,
						body,
					).map(
						func(taken): BorrowLetExpr(variable, value_type, rhs, taken),
					)
		LetExpr(variable, is_mutable, value_type, rhs, body):
			match take_field_alias(source_var, ordinal, rhs):
				Some(taken):
					Some(LetExpr(variable, is_mutable, value_type, taken, body))
				None:
					take_field_alias(
						source_var,
						ordinal,
						body,
					).map(
						func(taken): LetExpr(variable, is_mutable, value_type, rhs, taken),
					)
		SeqExpr(first, second):
			match take_field_alias(source_var, ordinal, first):
				Some(taken):
					Some(SeqExpr(taken, second))
				None:
					take_field_alias(
						source_var,
						ordinal,
						second,
					).map(
						func(taken): SeqExpr(first, taken),
					)
		CallExpr(kind, callee, args, typ, loc):
			var taken_args: List[CoreExpr] = []
			var found: Bool = False

			for arg in args:
				if found:
					taken_args = taken_args.append(arg)
				else:
					match take_field_alias(source_var, ordinal, arg):
						Some(taken):
							found = True
							taken_args = taken_args.append(taken)
						None:
							taken_args = taken_args.append(arg)

			if found:
				Some(CallExpr(kind, callee, taken_args, typ, loc))
			else:
				None
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			take_field_alias(
				source_var,
				ordinal,
				body,
			).map(
				func(taken): DupExpr(variable, value_type, retain_policy, taken, typ, loc),
			)
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			take_field_alias(
				source_var,
				ordinal,
				body,
			).map(
				func(taken): DropExpr(variable, value_type, release_policy, taken, typ, loc),
			)
		CastExpr(inner, typ, loc):
			take_field_alias(source_var, ordinal, inner).map(func(taken): CastExpr(taken, typ, loc))
		UnboxExpr(kind, inner, typ, loc):
			take_field_alias(
				source_var,
				ordinal,
				inner,
			).map(
				func(taken): UnboxExpr(kind, taken, typ, loc),
			)
		_:
			None


---
Identify the exact Perceus owned-field-alias shape before scanning a later
linear suffix. This is intentionally the same guaranteed-once expression
spine as `take_field_alias`; it never searches branches, loops, or lambdas.
---
private pure func find_hoisted_field_alias(expr: CoreExpr) -> Option[HoistedFieldAlias]:
	match expr:
		BorrowLetExpr(temp, temp_type, ProductFieldExpr(VarExpr(owner, owner_type, _), ordinal, _, _), DupExpr(dup_var, dup_type, ArcRetainPolicy, VarExpr(body_var, _, _), _, _)):
			-- Only a record field is taken; a tuple element read is not an alias
			-- to hoist.
			if (
				core_product_of(owner_type)
					.and_then(interim_product_record)
					.is_some()
				and core_var_equal(dup_var, temp)
				and core_var_equal(body_var, temp)
				and field_take_type_allowed(temp_type)
				and field_take_type_allowed(dup_type)
			):
				Some({
					source_var = owner,
					ordinal = ordinal,
				})
			else:
				None
		BorrowLetExpr(_, _, rhs, body):
			match find_hoisted_field_alias(rhs):
				Some(field_alias):
					Some(field_alias)
				None:
					find_hoisted_field_alias(body)
		LetExpr(_, _, _, rhs, body):
			match find_hoisted_field_alias(rhs):
				Some(field_alias):
					Some(field_alias)
				None:
					find_hoisted_field_alias(body)
		SeqExpr(first, second):
			match find_hoisted_field_alias(first):
				Some(field_alias):
					Some(field_alias)
				None:
					find_hoisted_field_alias(second)
		CallExpr(_, _, args, _, _):
			var found: Option[HoistedFieldAlias] = None

			for arg in args:
				match found:
					Some(_):
						void
					None:
						found = find_hoisted_field_alias(arg)

			found
		DupExpr(_, _, _, body, _, _):
			find_hoisted_field_alias(body)
		DropExpr(_, _, _, body, _, _):
			find_hoisted_field_alias(body)
		CastExpr(inner, _, _):
			find_hoisted_field_alias(inner)
		UnboxExpr(_, inner, _, _):
			find_hoisted_field_alias(inner)
		_:
			None


private pure func linear_prefix_exprs_complete_normally(exprs: List[CoreExpr]) -> Bool:
	exprs.all(linear_prefix_completes_normally)


private pure func non_cancelling_list_intrinsic(kind: CoreCallKind, arg_count: Int) -> Bool:
	-- These exact intrinsic contracts emit field reads/writes or synchronous
	-- capacity growth. Capacity growth moves unique storage or copies shared
	-- storage without invoking element destructors, user callbacks or checkpoints.
	match kind:
		IntrinsicCall(name):
			(
				(name == "list_len" and arg_count == 1)
					or ((name == "list_ensure_capacity" or name == "list_set_len") and arg_count == 2)
			)
		_:
			False


---
Whether an expression used before the terminal update must fall through to
the next expression. The allow-list is explicit so a new Core form fails
closed until its control-flow behavior is classified.
---
private pure func linear_prefix_completes_normally(expr: CoreExpr) -> Bool:
	match expr:
		LiteralExpr(_, _, _) | StaticStringLiteralExpr(_, _, _, _) | VarExpr(_, _, _) | VoidExpr(_, _):
			True
		CallExpr(kind, callee, args, _, _):
			(
				non_cancelling_list_intrinsic(kind, args.length())
					and linear_prefix_completes_normally(callee)
					and linear_prefix_exprs_complete_normally(args)
			)
		DebugBlockExpr(body, _, _):
			linear_prefix_completes_normally(body)
		BinaryExpr(_, left, right, _, _):
			linear_prefix_completes_normally(left) and linear_prefix_completes_normally(right)
		UnaryExpr(_, inner, _, _):
			linear_prefix_completes_normally(inner)
		CastExpr(inner, _, _):
			linear_prefix_completes_normally(inner)
		UnboxExpr(_, inner, _, _):
			linear_prefix_completes_normally(inner)
		ProductFieldExpr(inner, _, _, _):
			linear_prefix_completes_normally(inner)
		AssignExpr(_, rhs, _, _):
			linear_prefix_completes_normally(rhs)
		TupleExpr(items, _, _):
			linear_prefix_exprs_complete_normally(items)
		VectorExpr(items, _, _):
			linear_prefix_exprs_complete_normally(items)
		ProductExpr(build, _, _):
			linear_prefix_exprs_complete_normally(product_build_values(build))
		ListRetainExpr(retain, _, _):
			-- These storage operations only retain or write raw storage; neither
			-- invokes element destructors, user callbacks or checkpoints.
			linear_prefix_completes_normally(retain.list) and linear_prefix_completes_normally(retain.value.value)
		ListSetExpr(set, _, _):
			(
				linear_prefix_completes_normally(set.list)
					and linear_prefix_completes_normally(set.index)
					and linear_prefix_completes_normally(set.value.value)
			)
		LetExpr(_, _, _, rhs, body):
			linear_prefix_completes_normally(rhs) and linear_prefix_completes_normally(body)
		BorrowLetExpr(_, _, rhs, body):
			linear_prefix_completes_normally(rhs) and linear_prefix_completes_normally(body)
		SeqExpr(first, second):
			linear_prefix_completes_normally(first) and linear_prefix_completes_normally(second)
		DupExpr(_, _, _, body, _, _):
			linear_prefix_completes_normally(body)
		DropExpr(_, _, _, body, _, _):
			linear_prefix_completes_normally(body)
		_:
			False


private pure func record_reuse_transfers_hoisted_alias(
	binding: CoreVar,
	field_alias: HoistedFieldAlias,
	build: CoreProductBuild,
) -> Bool:
	var transfers: Int = 0
	var valid: Bool = True

	-- As in `take_build_values_from`: the alias moves back into the slot it
	-- was taken from.
	for field in product_build_fields(build):
		if (
			core_field_ordinals_equal(field.ordinal, field_alias.ordinal)
			and core_expr_is_var(field.value, binding)
		):
			transfers += 1
		else if owner_touched(binding, field.value):
			valid = False

		if var_touch_count(field_alias.source_var, field_alias.ordinal, field.value) > 0:
			valid = False

	valid and transfers == 1


private pure func record_cow_transfers_hoisted_alias(
	binding: CoreVar,
	field_alias: HoistedFieldAlias,
	fields: List[CoreRecordCowField],
) -> Bool:
	var transfers: Int = 0
	var valid: Bool = True

	for (index, field) in fields.enumerate():
		match field.replacement:
			Some(replacement):
				if (
					index == core_field_ordinal_index(field_alias.ordinal)
					and is_arc_release_policy(field.field.release_policy)
					and core_expr_is_var(replacement, binding)
				):
					transfers += 1
				else if owner_touched(binding, replacement):
					valid = False

				if var_touch_count(field_alias.source_var, field_alias.ordinal, replacement) > 0:
					valid = False
			None:
				void

	valid and transfers == 1


private pure func terminal_update_transfers_hoisted_alias(
	binding: CoreVar,
	field_alias: HoistedFieldAlias,
	expr: CoreExpr,
) -> Bool:
	match expr:
		RecordReuseExpr(VarExpr(source_var, _, _), build, _, _):
			(
				core_var_equal(source_var, field_alias.source_var)
				and record_reuse_transfers_hoisted_alias(binding, field_alias, build)
			)
		RecordCowUpdateExpr(VarExpr(source_var, _, _), fields, _, _):
			(
				core_var_equal(source_var, field_alias.source_var)
				and record_cow_transfers_hoisted_alias(binding, field_alias, fields)
			)
		_:
			False


private pure func terminal_assignment_transfers_hoisted_alias(
	binding: CoreVar,
	field_alias: HoistedFieldAlias,
	expr: CoreExpr,
) -> Bool:
	match expr:
		AssignExpr(assigned_var, rhs, _, _):
			(
				core_var_equal(assigned_var, field_alias.source_var)
				and terminal_update_transfers_hoisted_alias(binding, field_alias, rhs)
			)
		_:
			False


---
Prove that `binding` is transferred exactly once into the matching field of a
bare-source update, after only guaranteed-once frames. Prefix expressions may
read other fields, but cannot touch the source slot, use the binding, rebind
either owner, or exit before writeback.
---
private pure func linear_body_transfers_hoisted_alias(
	binding: CoreVar,
	field_alias: HoistedFieldAlias,
	expr: CoreExpr,
) -> Bool:
	match expr:
		LetExpr(variable, _, _, rhs, body):
			(
				not core_var_equal(variable, binding)
				and not core_var_equal(variable, field_alias.source_var)
				and linear_prefix_completes_normally(rhs)
				and not owner_touched(binding, rhs)
				and var_touch_count(field_alias.source_var, field_alias.ordinal, rhs) == 0
				and linear_body_transfers_hoisted_alias(binding, field_alias, body)
			)
		BorrowLetExpr(variable, _, rhs, body):
			(
				not core_var_equal(variable, binding)
				and not core_var_equal(variable, field_alias.source_var)
				and linear_prefix_completes_normally(rhs)
				and not owner_touched(binding, rhs)
				and var_touch_count(field_alias.source_var, field_alias.ordinal, rhs) == 0
				and linear_body_transfers_hoisted_alias(binding, field_alias, body)
			)
		SeqExpr(first, second):
			if terminal_assignment_transfers_hoisted_alias(binding, field_alias, first):
				not owner_touched(binding, second)
			else:
				(
					linear_prefix_completes_normally(first)
					and not owner_touched(binding, first)
					and var_touch_count(field_alias.source_var, field_alias.ordinal, first) == 0
					and linear_body_transfers_hoisted_alias(binding, field_alias, second)
				)
		AssignExpr(_, _, _, _):
			terminal_assignment_transfers_hoisted_alias(binding, field_alias, expr)
		_:
			terminal_update_transfers_hoisted_alias(binding, field_alias, expr)


private fixed union NormalizedAliasTransfer:
	MovedAliasTransfer
	RetainedAliasTransfer


private pure func typed_var_is(expr: CoreExpr, variable: CoreVar, typ: CoreType) -> Bool:
	match expr:
		VarExpr(actual, actual_type, _):
			core_var_equal(actual, variable) and core_type_equal(actual_type, typ)
		_:
			False


private pure func normalized_field_prefix_is_safe(
	binding: CoreVar,
	field_alias: HoistedFieldAlias,
	rhs: CoreExpr,
) -> Bool:
	(
		not owner_touched(binding, rhs)
		and not CoreTraverse.core_expr_assigns_var(rhs, field_alias.source_var)
		and var_touch_count(field_alias.source_var, field_alias.ordinal, rhs) == 0
		and not contains_resource_scope(rhs)
		and not CoreTraverse.core_expr_may_exit_early(rhs)
	)


---
Product evaluation introduces owned field binders before Perceus. Follow only
those explicit binders to the same source ordinal. Exact Perceus result
frames and sparse-update staging frames preserve that proof composition;
ordinary aliases retain the older conservative proof. A later field may call
or construct a value,
as the pre-normalization build did, provided it cannot observe the empty
source slot, replace either owner, or leave the update without a value.

The proof changes only the initial field retain policy. It preserves every
field Let and its RHS, including a self-Dup that owns the record's reference.
---
private pure func normalized_update_alias_transfer(
	binding: CoreVar,
	binding_type: CoreType,
	field_alias: HoistedFieldAlias,
	expr: CoreExpr,
) -> Option[NormalizedAliasTransfer]:
	match expr:
		LetExpr(variable, False, value_type, rhs, body):
			if (
				core_var_equal(variable, binding)
				or core_var_equal(variable, field_alias.source_var)
				or not core_type_equal(value_type, core_expr_type(rhs))
			):
				None
			else if is_drop_result_temporary(variable):
				-- Perceus may wrap each staged field's remaining update result.
				-- Its exact typed identity return neither copies nor consumes the
				-- alias. Prove the unchanged RHS and preserve its transfer kind.
				if typed_var_is(body, variable, value_type):
					normalized_update_alias_transfer(binding, binding_type, field_alias, rhs)
				else:
					None
			else if is_record_update_temporary(variable):
				-- Sparse updates stage other authored fields before the complete
				-- product. This is a prefix, never an alias relay: it must fall
				-- through without touching either owner or the vacated slot.
				if (
					linear_prefix_completes_normally(rhs)
					and normalized_field_prefix_is_safe(binding, field_alias, rhs)
				):
					normalized_update_alias_transfer(binding, binding_type, field_alias, body)
				else:
					None
			else if not is_product_field_temporary(variable):
				None
			else if typed_var_is(rhs, binding, binding_type):
				if (
					core_type_equal(value_type, binding_type)
					and not owner_touched(binding, body)
					and normalized_update_alias_transfer(variable, value_type, field_alias, body) == Some(MovedAliasTransfer)
				):
					Some(MovedAliasTransfer)
				else:
					None
			else:
				match rhs:
					DupExpr(dup_var, dup_type, ArcRetainPolicy, dup_body, dup_result_type, _):
						if (
							core_var_equal(dup_var, binding)
							and core_type_equal(dup_type, binding_type)
							and core_type_equal(dup_result_type, binding_type)
							and core_type_equal(value_type, binding_type)
							and typed_var_is(dup_body, binding, binding_type)
							and not owner_touched(binding, body)
							and normalized_update_alias_transfer(variable, value_type, field_alias, body) == Some(MovedAliasTransfer)
						):
							Some(RetainedAliasTransfer)
						else if normalized_field_prefix_is_safe(binding, field_alias, rhs):
							normalized_update_alias_transfer(binding, binding_type, field_alias, body)
						else:
							None
					_:
						if normalized_field_prefix_is_safe(binding, field_alias, rhs):
							normalized_update_alias_transfer(binding, binding_type, field_alias, body)
						else:
							None
		RecordReuseExpr(VarExpr(source_var, source_type, _), build, result_type, _):
			if (
				core_var_equal(source_var, field_alias.source_var)
				and heap_record_reuse_compatible(source_type, result_type)
				and record_reuse_transfers_hoisted_alias(binding, field_alias, build)
				and product_build_fields(build).any(func(field):
					(
						core_field_ordinals_equal(field.ordinal, field_alias.ordinal)
						and typed_var_is(field.value, binding, binding_type)
					)
				)
			):
				Some(MovedAliasTransfer)
			else:
				None
		_:
			None


---
A statement-valued source update can be followed by bookkeeping before
Perceus drops a retained original alias. The update must be first, every
following expression must fall through, and no following expression may
use or rebind that alias or replace the source again.
---
private pure func normalized_alias_assignment_prefix(
	binding: CoreVar,
	binding_type: CoreType,
	field_alias: HoistedFieldAlias,
	expr: CoreExpr,
) -> Option[NormalizedAliasTransfer]:
	match expr:
		AssignExpr(variable, rhs, _, _):
			if core_var_equal(variable, field_alias.source_var):
				normalized_update_alias_transfer(binding, binding_type, field_alias, rhs)
			else:
				None
		SeqExpr(first, second):
			if (
				linear_prefix_completes_normally(second)
				and not owner_touched(binding, second)
				and not CoreTraverse.core_expr_assigns_var(second, field_alias.source_var)
			):
				normalized_alias_assignment_prefix(binding, binding_type, field_alias, first)
			else:
				None
		_:
			None


private pure func normalized_body_transfers_hoisted_alias(
	binding: CoreVar,
	binding_type: CoreType,
	field_alias: HoistedFieldAlias,
	expr: CoreExpr,
) -> Bool:
	match expr:
		LetExpr(_, False, _, _, _):
			normalized_update_alias_transfer(binding, binding_type, field_alias, expr) == Some(MovedAliasTransfer)
		SeqExpr(first, DropExpr(dropped, dropped_type, ArcReleasePolicy, VoidExpr(VoidType, _), VoidType, _)):
			-- A retained relay gives the record a second unit. Only the exact
			-- trailing release of the original unit balances this live shape.
			(
				core_var_equal(dropped, binding)
				and core_type_equal(dropped_type, binding_type)
				and normalized_alias_assignment_prefix(binding, binding_type, field_alias, first) == Some(RetainedAliasTransfer)
			)
		SeqExpr(first, second):
			if normalized_alias_assignment_prefix(binding, binding_type, field_alias, first) == Some(MovedAliasTransfer):
				not owner_touched(binding, second)
			else:
				(
					linear_prefix_completes_normally(first)
					and not owner_touched(binding, first)
					and var_touch_count(field_alias.source_var, field_alias.ordinal, first) == 0
					and normalized_body_transfers_hoisted_alias(binding, binding_type, field_alias, second)
				)
		AssignExpr(_, _, _, _):
			normalized_alias_assignment_prefix(binding, binding_type, field_alias, expr) == Some(MovedAliasTransfer)
		_:
			False


private pure func take_hoisted_field_alias(
	binding: CoreVar,
	is_mutable: Bool,
	binding_type: CoreType,
	rhs: CoreExpr,
	body: CoreExpr,
) -> Option[CoreExpr]:
	if is_mutable or not field_take_type_allowed(binding_type):
		None
	else:
		match find_hoisted_field_alias(rhs):
			Some(field_alias):
				if (
					not core_var_equal(binding, field_alias.source_var)
					and var_touch_count(field_alias.source_var, field_alias.ordinal, rhs) == 1
					and not CoreTraverse.core_expr_may_exit_early(rhs)
					and (
						linear_body_transfers_hoisted_alias(binding, field_alias, body)
						or normalized_body_transfers_hoisted_alias(binding, binding_type, field_alias, body)
					)
				):
					take_field_alias(field_alias.source_var, field_alias.ordinal, rhs)
				else:
					None
			None:
				None


private pure func is_drop_result_temporary(variable: CoreVar) -> Bool:
	match variable.origin:
		DerivedFrom(_, DropTemp, _):
			True
		_:
			False


private pure func is_record_update_temporary(variable: CoreVar) -> Bool:
	match variable.origin:
		PassTemporary(RecordUpdateTemp, _):
			True
		_:
			False


private pure func is_product_field_temporary(variable: CoreVar) -> Bool:
	match variable.origin:
		PassTemporary(ProductFieldTemp, _):
			True
		_:
			False


---
This rewrite runs after Perceus, so the adjacent DropExpr proves that the
source owner survives every field evaluation and dies with the fresh result.
RecordReuseExpr preserves that order: fields first, source consumption last.
---
private pure func reuse_dropped_record_rhs(
	dropped_var: CoreVar,
	dropped_type: CoreType,
	release_policy: CoreReleasePolicy,
	rhs: CoreExpr,
) -> Option[CoreExpr]:
	match rhs:
		LetExpr(variable, is_mutable, value_type, field_rhs, rest):
			-- Product evaluation already named the fields in written order.
			-- Keep each evaluation in place and consume the dropped source only
			-- at the terminal construction, after every named field is owned.
			if (
				not is_mutable
				and is_product_field_temporary(variable)
				and not CoreTraverse.core_expr_assigns_var(field_rhs, dropped_var)
				and not contains_resource_scope(field_rhs)
				and not CoreTraverse.core_expr_may_exit_early(field_rhs)
			):
				match reuse_dropped_record_rhs(dropped_var, dropped_type, release_policy, rest):
					Some(rewritten_rest):
						Some(LetExpr(variable, False, value_type, field_rhs, rewritten_rest))
					None:
						None
			else:
				None
		ProductExpr(build, allocation_type, loc):
			if (
				heap_record_reuse_compatible(dropped_type, allocation_type)
				and is_arc_release_policy(release_policy)
				and not exprs_assign_var(product_build_values(build), dropped_var)
				and not contains_resource_scope(rhs)
			):
				Some(
					RecordReuseExpr(
						var_expr(dropped_var, dropped_type),
						build,
						allocation_type,
						loc,
					),
				)
			else:
				None
		_:
			None


private pure func rewrite_drop_body(
	dropped_var: CoreVar,
	dropped_type: CoreType,
	body: CoreExpr,
) -> Option[CoreExpr]:
	match body:
		RawMatchExpr(scrutinee, cases, typ, loc):
			None
		SemanticMatchExpr(scrutinee, tree, typ, loc):
			None
		LetExpr(variable, is_mutable, value_type, rhs, rest):
			if owner_touched(dropped_var, rhs) or contains_resource_scope(rhs):
				None
			else:
				match reuse_alloc_rhs(dropped_var, dropped_type, rhs):
					Some(rewritten_rhs):
						if owner_touched(dropped_var, rest):
							None
						else:
							Some(
								LetExpr(
									variable,
									is_mutable,
									value_type,
									rewritten_rhs,
									rewrite_post_perceus_expr(rest),
								),
							)
					None:
						if is_collection_allocation(rhs):
							None
						else:
							match rewrite_drop_body(dropped_var, dropped_type, rest):
								Some(rewritten_rest):
									Some(
										LetExpr(
											variable,
											is_mutable,
											value_type,
											rewrite_post_perceus_expr(rhs),
											rewritten_rest,
										),
									)
								None:
									None
		BorrowLetExpr(variable, value_type, rhs, rest):
			if owner_touched(dropped_var, rhs) or contains_resource_scope(rhs):
				None
			else:
				match rewrite_drop_body(dropped_var, dropped_type, rest):
					Some(rewritten_rest):
						Some(
							BorrowLetExpr(
								variable,
								value_type,
								rewrite_post_perceus_expr(rhs),
								rewritten_rest,
							),
						)
					None:
						None
		SeqExpr(first, second):
			if owner_touched(dropped_var, first) or contains_resource_scope(first):
				None
			else if is_collection_allocation(first):
				None
			else:
				match rewrite_drop_body(dropped_var, dropped_type, second):
					Some(rewritten_second):
						Some(SeqExpr(rewrite_post_perceus_expr(first), rewritten_second))
					None:
						None
		ResourceScopeExpr(scope, typ, loc):
			None
		LiteralExpr(literal, typ, loc):
			None
		StaticStringLiteralExpr(id, value, typ, loc):
			None
		VarExpr(variable, typ, loc):
			None
		VoidExpr(typ, loc):
			None
		DebugBlockExpr(body, typ, loc):
			None
		CooperativeCheckpointExpr(typ, loc):
			None
		CallExpr(kind, callee, args, typ, loc):
			None
		BinaryExpr(op, left, right, typ, loc):
			None
		UnaryExpr(op, inner, typ, loc):
			None
		LogicalExpr(op, left, right, typ, loc):
			None
		AssignExpr(variable, rhs, typ, loc):
			None
		CastExpr(inner, typ, loc):
			None
		BoxExpr(box, typ, loc):
			None
		UnboxExpr(unbox_kind, inner, typ, loc):
			None
		ProductFieldExpr(inner, _, typ, loc):
			None
		ModuleMemberExpr(_, _, _, _):
			None
		TupleExpr(items, typ, loc):
			None
		VectorExpr(items, typ, loc):
			None
		LambdaExpr(lambda_params, lambda_return_type, lambda_body, lambda_is_pure, typ, loc):
			None
		ClosureCreateExpr(closure, typ, loc):
			None
		ListConstructExpr(construct, typ, loc):
			None
		ListAllocExpr(alloc, typ, loc):
			None
		ListGetExpr(get, typ, loc):
			None
		ListHandoffExpr(handoff, typ, loc):
			None
		ListHandoffSetOwnedExpr(set, typ, loc):
			None
		ListHandoffSetSourceSlotExpr(set, typ, loc):
			None
		StringByteReadExpr(read, typ, loc):
			None
		StringByteWriteExpr(write, typ, loc):
			None
		StringByteCopyExpr(copy, typ, loc):
			None
		StringSetLenExpr(set_len, typ, loc):
			None
		TensorLiteralExpr(literal, typ, loc):
			None
		TensorBoxedLiteralExpr(literal, typ, loc):
			None
		TensorPackedLiteralExpr(literal, typ, loc):
			None
		TensorRawFillExpr(fill, typ, loc):
			None
		TensorRawReadExpr(read, typ, loc):
			None
		TensorRawWriteExpr(write, typ, loc):
			None
		TensorRawViewLetExpr(binding, tensor_body, typ, loc):
			None
		DictConstructExpr(construct, typ, loc):
			None
		DictExpr(entries, typ, loc):
			None
		SetAllocExpr(alloc, typ, loc):
			None
		ListRetainExpr(retain, typ, loc):
			None
		ListSetExpr(set, typ, loc):
			None
		ListSwapExpr(swap, typ, loc):
			None
		ProductExpr(build, typ, loc):
			None
		RecordUpdateExpr(base, fields, typ, loc):
			None
		RecordReuseExpr(source, build, typ, loc):
			None
		RecordCowUpdateExpr(source, fields, typ, loc):
			None
		UnionConstructExpr(construct, typ, loc):
			None
		UnionReuseConstructExpr(construct, typ, loc):
			None
		PreClosureDetachExpr(detached, typ, loc):
			None
		DetachExpr(detached, typ, loc):
			None
		DupExpr(variable, value_type, retain_policy, dup_body, typ, loc):
			None
		DropExpr(variable, value_type, release_policy, drop_body, typ, loc):
			None
		WhileExpr(cond, while_body, typ, loc):
			None
		BreakExpr(typ, loc):
			None
		ContinueExpr(typ, loc):
			None
		ResourceCleanupExitExpr(exit, typ, loc):
			None
		TailrecLoopExpr(params, return_type, tailrec_body, loc):
			None
		TailrecRecurExpr(args, typ, loc):
			None
		TailrecListSpreadLoopExpr(loop, loc):
			None
		TailrecListSpreadRecurExpr(rebinds, spread_index, typ, loc):
			None
		ForRangeExpr(binder, start, end, step, typ, loc):
			None
		ForChannelExpr(loop, typ, loc):
			None
		ForListExpr(loop, typ, loc):
			None
		ForStringExpr(loop, typ, loc):
			None
		ForDictExpr(loop, typ, loc):
			None
		ForSetExpr(loop, typ, loc):
			None
		ForStreamExpr(loop, typ, loc):
			None
		ForResourceSourceExpr(loop, typ, loc):
			None
		ForTensorExpr(loop, typ, loc):
			None
		PreClosureConcurrentlyLoopExpr(loop, typ, loc):
			None
		ConcurrentlyLoopExpr(loop, typ, loc):
			None
		PreClosureConcurrentExpr(block, typ, loc):
			None
		ConcurrentExpr(block, typ, loc):
			None
		SelectExpr(selection, typ, loc):
			None
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			None
		AccessorLiteralMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			None
		LengthMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			None
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			None
		IfExpr(cond, then_expr, else_expr, typ, loc):
