private pure func consume_handoff_in_linear_expr(
	dropped_var: CoreVar,
	dropped_type: CoreType,
	expr: CoreExpr,
) -> Option[CoreExpr]:
	match expr:
		RawMatchExpr(scrutinee, cases, typ, loc):
			None
		SemanticMatchExpr(scrutinee, tree, typ, loc):
			None
		LetExpr(variable, is_mutable, value_type, rhs, rest):
			match consume_handoff_rhs(dropped_var, dropped_type, rhs):
				Some(rewritten_rhs):
					if owner_touched(dropped_var, rest):
						match consume_handoff_in_linear_expr(dropped_var, dropped_type, rest):
							Some(rewritten_rest):
								Some(
									LetExpr(
										variable,
										is_mutable,
										value_type,
										rewrite_post_perceus_expr(rhs),
										rewritten_rest,
									),
								)
							None:
								None
					else:
						Some(
							LetExpr(
								variable,
								is_mutable,
								value_type,
								rewritten_rhs,
								rewrite_post_perceus_expr(rest),
							),
						)
				None:
					if owner_touched(dropped_var, rhs):
						if owner_touched(dropped_var, rest):
							None
						else:
							match consume_handoff_in_linear_expr(dropped_var, dropped_type, rhs):
								Some(rewritten_rhs):
									Some(
										LetExpr(
											variable,
											is_mutable,
											value_type,
											rewritten_rhs,
											rewrite_post_perceus_expr(rest),
										),
									)
								None:
									None
					else if contains_resource_scope(rhs):
						None
					else:
						match consume_handoff_in_linear_expr(dropped_var, dropped_type, rest):
							Some(rewritten_rest):
								Some(
									LetExpr(
										variable,
										is_mutable,
										value_type,
										rewrite_post_perceus_expr(rhs),
										rewritten_rest,
									),
								)
							None:
								None
		BorrowLetExpr(variable, value_type, rhs, rest):
			if owner_touched(dropped_var, rhs) or contains_resource_scope(rhs):
				None
			else:
				match consume_handoff_in_linear_expr(dropped_var, dropped_type, rest):
					Some(rewritten_rest):
						Some(
							BorrowLetExpr(
								variable,
								value_type,
								rewrite_post_perceus_expr(rhs),
								rewritten_rest,
							),
						)
					None:
						None
		SeqExpr(first, second):
			if owner_touched(dropped_var, first) or contains_resource_scope(first):
				None
			else:
				match consume_handoff_in_linear_expr(dropped_var, dropped_type, second):
					Some(rewritten_second):
						Some(SeqExpr(rewrite_post_perceus_expr(first), rewritten_second))
					None:
						None
		ResourceScopeExpr(scope, typ, loc):
			None
		LiteralExpr(literal, typ, loc):
			None
		StaticStringLiteralExpr(id, value, typ, loc):
			None
		VarExpr(variable, typ, loc):
			None
		VoidExpr(typ, loc):
			None
		DebugBlockExpr(body, typ, loc):
			None
		CooperativeCheckpointExpr(typ, loc):
			None
		CallExpr(kind, callee, args, typ, loc):
			None
		BinaryExpr(op, left, right, typ, loc):
			None
		UnaryExpr(op, inner, typ, loc):
			None
		LogicalExpr(op, left, right, typ, loc):
			None
		AssignExpr(variable, rhs, typ, loc):
			None
		CastExpr(inner, typ, loc):
			None
		BoxExpr(box, typ, loc):
			None
		UnboxExpr(unbox_kind, inner, typ, loc):
			None
		ProductFieldExpr(inner, _, typ, loc):
			None
		ModuleMemberExpr(_, _, _, _):
			None
		TupleExpr(items, typ, loc):
			None
		VectorExpr(items, typ, loc):
			None
