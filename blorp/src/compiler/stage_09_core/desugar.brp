-- Early Core desugaring for the Blorp-owned Core pipeline.
--
-- Blorp Core lowering already materializes record updates and string
-- interpolation as ordinary Core expressions. This pass removes the remaining
-- string operator sugar bottom-up from every Core expression container.
-- Exact `target = target + suffix` assignments use the COW-consuming string
-- append builtin so mutable accumulation can reuse uniquely owned storage.
-- Left-nested additions such as `target = target + a + b` remain unchanged
-- until a producer-chain lowering can preserve evaluation and ownership.
import:
	ir:
		CoreBinaryOp(AddOp, EqualOp, NotEqualOp),
		CoreCallKind(BuiltinCall),
		CoreDecl(FunctionDecl, GlobalDecl, ImplDecl),
		CoreExpr(AssignExpr, BinaryExpr, CallExpr, SeqExpr, UnaryExpr, VarExpr, VoidExpr),
		CoreFunction,
		CoreGlobal,
		CoreProgram,
		CoreSourceLoc,
		CoreType(NamedType, VoidType),
		CoreUnaryOp(NotOp),
		CoreVar,
		core_expr_type,
	traverse as CoreTraverse


private pure func named_type(name: String) -> CoreType:
	NamedType(name, [])


pure func core_type_is_string(typ: CoreType) -> Bool:
	match typ:
		NamedType(name, args):
			if args.length() == 0:
				(
					name == "String"
					or name == "LiteralString"
					or name == "string::String"
					or name == "string__String"
				)
			else:
				False
		_:
			False


pure func core_string_binary_requires_desugar(op: CoreBinaryOp, left_type: CoreType) -> Bool:
	if not core_type_is_string(left_type):
		False
	else:
		match op:
			AddOp | EqualOp | NotEqualOp:
				True
			_:
				False


private pure func core_vars_equal(left: CoreVar, right: CoreVar) -> Bool:
	left.name == right.name and left.uniq == right.uniq


private pure func builtin_call(
	name: String,
	args: List[CoreExpr],
	result_type: CoreType,
	loc: CoreSourceLoc,
) -> CoreExpr:
	CallExpr(
		BuiltinCall(name),
		VoidExpr(VoidType, loc),
		args,
		result_type,
		loc,
	)


private pure func desugar_string_binary(
	op: CoreBinaryOp,
	left: CoreExpr,
	right: CoreExpr,
	typ: CoreType,
	loc: CoreSourceLoc,
) -> CoreExpr:
	if core_string_binary_requires_desugar(op, core_expr_type(left)):
		match op:
			AddOp:
				builtin_call(
					"blorp_string_concat",
					[left, right],
					typ,
					loc,
				)
			EqualOp:
				builtin_call(
					"blorp_string_eq",
					[left, right],
					named_type("Bool"),
					loc,
				)
			NotEqualOp:
				eq = builtin_call(
					"blorp_string_eq",
					[left, right],
					named_type("Bool"),
					loc,
				)
				UnaryExpr(NotOp, eq, named_type("Bool"), loc)
			_:
				BinaryExpr(op, left, right, typ, loc)
	else:
		BinaryExpr(op, left, right, typ, loc)


-- The concat child has already been rewritten when this runs. Match that
-- post-desugar shape to preserve bottom-up traversal order.
private pure func desugar_accumulator_assignment(expr: CoreExpr) -> CoreExpr:
	match expr:
		AssignExpr(variable, rhs, typ, loc):
			match rhs:
				CallExpr(BuiltinCall(name), _, args, rhs_type, rhs_loc):
					if name == "blorp_string_concat" and core_type_is_string(rhs_type):
						match args.get(0):
							Some(VarExpr(source, source_type, source_loc)):
								match args.get(1):
									Some(suffix):
										if args.length() == 2 and core_vars_equal(variable, source):
											AssignExpr(
												variable,
												builtin_call(
													"blorp_string_append",
													[
														VarExpr(source, source_type, source_loc),
														suffix,
													],
													rhs_type,
													rhs_loc,
												),
												typ,
												loc,
											)
										else:
											expr
									None:
										expr
							Some(_):
								expr
							None:
								expr
					else:
						expr
				_:
					expr
		_:
			expr


private pure func rewrite_desugared_expr(expr: CoreExpr) -> CoreExpr:
	match expr:
		BinaryExpr(op, left, right, typ, loc):
			desugar_string_binary(op, left, right, typ, loc)
		_:
			desugar_accumulator_assignment(expr)


pure func desugar_expr(expr: CoreExpr) -> CoreExpr:
	match expr:
		SeqExpr(_, _):
			CoreTraverse.map_core_sequence_items(expr, desugar_expr)
		_:
			children_desugared = CoreTraverse.map_core_expr_children(expr, desugar_expr)
			rewrite_desugared_expr(children_desugared)


private pure func desugar_function(function: CoreFunction) -> CoreFunction:
	{ function | body = function.body.map(desugar_expr) }


private pure func desugar_decl(decl: CoreDecl) -> CoreDecl:
	match decl:
		FunctionDecl(function):
			FunctionDecl(desugar_function(function))
		GlobalDecl(global):
			GlobalDecl({ global | init = desugar_expr(global.init) })
		ImplDecl(impl_decl):
			ImplDecl({ impl_decl | methods = impl_decl.methods.map(desugar_function) })
		_:
			decl


pure func desugar_program(program: CoreProgram) -> CoreProgram:
	{
		decls = program.decls.map(desugar_decl),
		foreign_includes = program.foreign_includes
	}
