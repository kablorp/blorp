-- Closure formation for the Blorp-owned Core pipeline.
--
-- First-class function references are normalized before Perceus so ownership
-- insertion sees the eta-adapter body. Raw lambdas and task bodies are hoisted
-- separately at the post-reuse/pre-closure boundary.
import:
	ir:
		CoreBoxedStorageValue,
		CoreCallKind(
			BuiltinCall,
			ClosureCall,
			DeferredTraitCall,
			DictWithCapacityCall,
			DirectRuntimeCall,
			FallibleStreamTerminalCall,
			ForeignCall,
			IntrinsicCall,
			ListToStringCall,
			OperationResultCall,
			SelectedDirectCall,
			SelectedTraitCall,
			TensorParallelCall,
			UnknownCall,
			UserCall,
		),
		CoreClosureAbi,
		CoreClosureCapture,
		CoreClosureCreate,
		CoreConcurrentBinding,
		CoreConcurrentlyLoopItemMode(ConcurrentlyLoopCopyItem, ConcurrentlyLoopMoveResourceItem),
		CoreConstructorLengthMatch,
		CoreConstructorLengthMatchBranch,
		CoreConstructorLengthMatchCase,
		CoreConstructorLengthMatchGeq,
		CoreConstructorLiteralMatch,
		CoreConstructorMatchBody(
			ConstructorMatchBodyExpr,
			ConstructorMatchBodyLength,
			ConstructorMatchBodyLiteral,
		),
		CoreConstructorMatchCase,
		CoreConstructorMatchFallback(
			ConstructorMatchFallbackBindings,
			ConstructorMatchFallbackBody,
			ConstructorMatchFallbackFail,
		),
		CoreDecl(
			EnumDecl,
			FunctionDecl,
			GlobalDecl,
			HeapRecordDecl,
			ImplDecl,
			TraitDecl,
			TypeAliasDecl,
			UnionDecl,
			ValueRecordDecl,
		),
		CoreDefinitionIdentity,
		CoreDictEntry,
		CoreDictLiteralEntry,
		CoreEnumDecl,
		CoreExpr(
			AccessorLiteralMatchExpr,
			AssignExpr,
			BinaryExpr,
			BoxExpr,
			BreakExpr,
			BorrowLetExpr,
			CastExpr,
			CallExpr,
			ClosureCreateExpr,
			ConcurrentExpr,
			ConcurrentlyLoopExpr,
			ConstructorMatchExpr,
			ContinueExpr,
			CooperativeCheckpointExpr,
			DebugBlockExpr,
			DetachExpr,
			DictConstructExpr,
			DictExpr,
			DropExpr,
			DupExpr,
			FieldExpr,
			ForChannelExpr,
			ForDictExpr,
			ForListExpr,
			ForRangeExpr,
			ForResourceSourceExpr,
			ForSetExpr,
			ForStreamExpr,
			ForStringExpr,
			ForTensorExpr,
			IfExpr,
			LambdaExpr,
			LengthMatchExpr,
			LetExpr,
			ListAllocExpr,
			ListConstructExpr,
			ListGetExpr,
			ListHandoffExpr,
			ListHandoffSetOwnedExpr,
			ListHandoffSetSourceSlotExpr,
			ListRetainExpr,
			ListSetExpr,
			ListSwapExpr,
			LiteralExpr,
			LiteralMatchExpr,
			LogicalExpr,
			RangeExpr,
			RecordConstructExpr,
			RecordExpr,
			RecordCowUpdateExpr,
			RecordReuseExpr,
			RecordUpdateExpr,
			PreClosureConcurrentExpr,
			PreClosureConcurrentlyLoopExpr,
			PreClosureDetachExpr,
			RawMatchExpr,
			SemanticMatchExpr,
			ResourceCleanupExitExpr,
			ResourceScopeExpr,
			SelectExpr,
			SeqExpr,
			SetAllocExpr,
			StaticStringLiteralExpr,
			StringByteCopyExpr,
			StringByteReadExpr,
			StringByteWriteExpr,
			StringSetLenExpr,
			TailrecListSpreadLoopExpr,
			TailrecListSpreadRecurExpr,
			TailrecLoopExpr,
			TailrecRecurExpr,
			TensorBoxedLiteralExpr,
			TensorLiteralExpr,
			TensorPackedLiteralExpr,
			TensorRawFillExpr,
			TensorRawReadExpr,
			TensorRawViewLetExpr,
			TensorRawWriteExpr,
			TupleConstructExpr,
			TupleExpr,
			TupleFieldExpr,
			UnaryExpr,
			UnionConstructExpr,
			UnionReuseConstructExpr,
			UnboxExpr,
			VarExpr,
			VectorExpr,
			VoidExpr,
			WhileExpr,
		),
		CoreFunction,
		CoreFunctionKind(
			BuiltinFunction,
			ClosureBodyFunction,
			ForeignFunction,
			ProgramEntrypointFunction,
			UnresolvedBuiltinFunction,
			UserFunction,
		),
		CoreGlobal,
		CoreLiteralMatchCase,
		CoreLiteralMatchFallback(
			LiteralMatchFallbackBindings,
			LiteralMatchFallbackBody,
			LiteralMatchFallbackFail,
		),
		CoreLogicalOp,
		CoreMatchBinding,
		CoreParam,
		CorePreClosureConcurrentBinding,
		CoreProgram,
		CoreRawMatchCase,
		CoreRecordCowField,
		CoreRecordFieldValue,
		CoreReleasePolicy,
		CoreSelectArm,
		CoreSelectArmKind(SelectAfterArm, SelectRecvArm, SelectSealedArm),
		CoreSemanticConstructorMatchCase,
		CoreSemanticLengthMatchCase,
		CoreSemanticLengthMatchGeq,
		CoreSemanticLiteralMatchCase,
		CoreSemanticMatchBinding,
		CoreSemanticMatchTree(
			SemanticConstructorMatch,
			SemanticLengthMatch,
			SemanticLiteralMatch,
			SemanticMatchFail,
			SemanticMatchLeaf,
		),
		CoreSourceLoc,
		CoreTailrecListSpreadRebind,
		CoreTaskCapture,
		CoreTaskCaptureKind(TaskCopyCapture, TaskMoveResourceItem, TaskStructuredTaskBorrow),
		CoreTaskClosure,
		CoreTensorLiteralPayload(TensorInlineStructLiteralPayload, TensorRawLiteralPayload),
		CoreTupleElement(
			TupleFloat16Element,
			TupleFloat32Element,
			TupleFloatElement,
			TuplePointerElement,
			TuplePrimElement,
			TupleStackResultElement,
			TupleStructElement,
			TupleVoidElement,
		),
		CoreType,
		CoreUnionDecl,
		CoreVar,
	traverse: core_pattern_binds_name, core_pattern_bound_names, immediate_core_expr_children
	type_policy as CoreTypePolicy


LAMBDA_NAME_PREFIX: String = "_blorp_clambda_"

TASK_NAME_PREFIX: String = "_blorp_task_"

ETA_NAME_PREFIX: String = "_blorp_eta_"

MANGLED_DEF_ID_PREFIX: String = "__def_"

STATIC_CLOSURE_PREFIX: String = "__sc_"

CLOSURE_TYPE_NAME: String = "Closure"

VOID_TYPE: CoreType = VoidType


-- Allocation identity for the reuse rule closure conversion follows: a
-- converted child that is the same allocation as its input proves that the
-- input node can be handed back as is, so conversion allocates only along the
-- spine to nodes it actually rewrote (adapted references, hoisted lambdas and
-- tasks). Core is immutable value data, so sharing subtrees between input and
-- output is safe. Bound straight to the runtime primitive for the same
-- bootstrap reason as the matching block in traverse.brp; delete the blocks
-- together and import `memory: same_object` instead.
foreign:
	private pure func same_core_expr(left: CoreExpr, right: CoreExpr) -> Bool = "blorp_same_object"


record FreeVar {
	name: String,
	uniq: Int,
	typ: CoreType
}


record FunctionValueSignature {
	param_types: List[CoreType],
	return_type: CoreType,
	is_pure: Bool
}


enum ClosurePassMode:
	AdaptFunctionRefs
	ConvertClosures


private pure func call_kind_uses_runtime_callee(kind: CoreCallKind) -> Bool:
	match kind:
		UnknownCall:
			True
		DeferredTraitCall(trait_name, method_name):
			False
		SelectedTraitCall(trait_name, method_name, module_path, def_id):
			False
		SelectedDirectCall(def_id):
			False
		ClosureCall:
			True
		UserCall(name, def_id, consumed_args):
			False
		ForeignCall(name, arg_passing):
			False
		BuiltinCall(name):
			False
		DirectRuntimeCall(call):
			False
		OperationResultCall(bridge):
			False
		FallibleStreamTerminalCall(bridge):
			False
		TensorParallelCall(name, layout):
			False
		DictWithCapacityCall(constructor):
			False
		ListToStringCall(callback_name):
			False
		IntrinsicCall(name):
			False


-- Read-only facts about the program being closure-converted: the pass mode,
-- the enclosing module for freshly hoisted functions, and the lookup tables
-- built once from the whole program. Built by `closure_facts` via local
-- mutation, then borrowed through the walk -- it never changes during a
-- single function body's conversion, so it never needs to be copied into the
-- per-node results below.
record ClosureFacts {
	mode: ClosurePassMode,
	current_module: Option[String],
	functions_by_id: Dict[Int, CoreFunction],
	function_collisions_by_id: Dict[Int, List[CoreFunction]],
	functions_by_name: Dict[String, List[CoreFunction]],
	function_definitions: List[CoreDefinitionIdentity],
	constructor_definitions: List[CoreDefinitionIdentity]
}


-- Mutable accumulators that only grow across the walk: the fresh-name
-- counters and the hoisted functions collected so far. Threaded through the
-- node walk (unlike `ClosureFacts`, this does change), but carries none of
-- the read-only lookup tables anymore.
record ClosureState {
	next_eta_index: Int,
	next_lambda_index: Int,
	next_task_index: Int,
	next_def_id: Int,
	hoisted: List[CoreDecl]
}


record ConvertedExpr {
	state: ClosureState,
	expr: CoreExpr
}


-- Container results carry `changed`: False means the container is the caller's
-- own input allocation and every child came back unchanged, so the enclosing
-- node can be handed back as is. Lists copy their untouched prefix only once
-- a child actually changes.
record ConvertedExprs {
	state: ClosureState,
	exprs: List[CoreExpr],
	changed: Bool
}


-- Long `and`/`or` chains are converted iteratively. Continuation tasks carry
-- the source node so an unchanged pair of sides hands that node back.
private union ClosureLogicalTask:
	ConvertClosureLogicalNode(CoreExpr)
	ContinueClosureLogicalAfterLeft(CoreExpr)
	RebuildClosureLogicalNode(CoreExpr, CoreExpr)


record ConvertedSemanticMatchTree {
	state: ClosureState,
	tree: CoreSemanticMatchTree,
	changed: Bool
}


record ConvertedOptionalSemanticMatchTree {
	state: ClosureState,
	tree: Option[CoreSemanticMatchTree],
	changed: Bool
}


record ConvertedOptionalSemanticLengthGeq {
	state: ClosureState,
	geq: Option[CoreSemanticLengthMatchGeq],
	changed: Bool
}


record ConvertedOptionalExpr {
	state: ClosureState,
	expr: Option[CoreExpr],
	changed: Bool
}


record ConvertedBoxedStorageValue {
	state: ClosureState,
	value: CoreBoxedStorageValue,
	changed: Bool
}


record ConvertedBoxedStorageValues {
	state: ClosureState,
	values: List[CoreBoxedStorageValue],
	changed: Bool
}


record ConvertedTupleElement {
	state: ClosureState,
	element: CoreTupleElement,
	changed: Bool
}


record ConvertedTupleElements {
	state: ClosureState,
	elements: List[CoreTupleElement],
	changed: Bool
}


record ConvertedRecordFields {
	state: ClosureState,
	fields: List[CoreRecordFieldValue],
	changed: Bool
}


record ConvertedRecordCowFields {
	state: ClosureState,
	fields: List[CoreRecordCowField],
	changed: Bool
}


record ConvertedDictEntries {
	state: ClosureState,
	entries: List[CoreDictEntry],
	changed: Bool
}


record ConvertedDictLiteralEntries {
	state: ClosureState,
	entries: List[CoreDictLiteralEntry],
	changed: Bool
}


record ConvertedLiteralMatchCases {
	state: ClosureState,
	cases: List[CoreLiteralMatchCase],
	changed: Bool
}


record ConvertedRawMatchCases {
	state: ClosureState,
	cases: List[CoreRawMatchCase],
	changed: Bool
}


record ConvertedLiteralMatchFallback {
	state: ClosureState,
	fallback: CoreLiteralMatchFallback,
	changed: Bool
}


record ConvertedConstructorMatchBody {
	state: ClosureState,
	body: CoreConstructorMatchBody,
	changed: Bool
}


record ConvertedConstructorMatchCases {
	state: ClosureState,
	cases: List[CoreConstructorMatchCase],
	changed: Bool
}


record ConvertedConstructorMatchFallback {
	state: ClosureState,
	fallback: CoreConstructorMatchFallback,
	changed: Bool
}


record ConvertedConstructorLengthBranch {
	state: ClosureState,
	branch: CoreConstructorLengthMatchBranch,
	changed: Bool
}


record ConvertedConstructorLengthCases {
	state: ClosureState,
	cases: List[CoreConstructorLengthMatchCase],
	changed: Bool
}


record ConvertedConstructorLengthGeq {
	state: ClosureState,
	geq: Option[CoreConstructorLengthMatchGeq],
	changed: Bool
}


record ConvertedConstructorLengthFallback {
	state: ClosureState,
	fallback: Option[CoreConstructorLengthMatchBranch],
	changed: Bool
}


record ConvertedSelectArmKind {
	state: ClosureState,
	kind: CoreSelectArmKind,
	changed: Bool
}


record ConvertedSelectArms {
	state: ClosureState,
	arms: List[CoreSelectArm],
	changed: Bool
}


record ConvertedDecl {
	state: ClosureState,
	decl: CoreDecl
}


record ConvertedOptionalDecl {
	state: ClosureState,
	decl: Option[CoreDecl]
}


record ConvertedDecls {
	state: ClosureState,
	decls: List[CoreDecl]
}


record FreshHoistedName {
	state: ClosureState,
	name: String,
	def_id: Int,
	c_name: String,
	static_name: String
}


record HoistedClosureCreate {
	state: ClosureState,
	create: CoreClosureCreate
}


record HoistedTaskClosure {
	state: ClosureState,
	task: CoreTaskClosure
}


private record FunctionIndexes {
	by_id: Dict[Int, CoreFunction],
	collisions_by_id: Dict[Int, List[CoreFunction]],
	by_name: Dict[String, List[CoreFunction]]
}


record ClosureFunctionIndexDiagnosticSnapshot {
	by_id_count: Int,
	by_name_count: Int,
	collision_id_count: Int,
	total_collision_entries: Int,
	names: List[(String, List[(String, Int)])],
	ids: List[(Int, Option[(String, Int)], List[(String, Int)])]
}


private pure func mangle_by_def_id(def_id: Int, name: String) -> String:
	MANGLED_DEF_ID_PREFIX + def_id.to_string() + "_" + name


private pure func static_closure_name(c_name: String) -> String:
	STATIC_CLOSURE_PREFIX + c_name


private pure func var_from_name(name: String) -> CoreVar:
	{
		name = name,
		uniq = 0,
		def_id = None
	}


private pure func is_closure_value_type(typ: CoreType) -> Bool:
	match typ:
		FunctionType(is_pure, params, return_type):
			True
		NamedType(name, args):
			name == CLOSURE_TYPE_NAME and args.length() == 0
		_:
			False


private pure func function_value_signature(
	typ: CoreType,
	target: CoreFunction,
) -> FunctionValueSignature:
	match typ:
		FunctionType(is_pure, params, return_type):
			{
				param_types = params,
				return_type = return_type,
				is_pure = is_pure
			}
		_:
			{
				param_types = target.params.map(func(param): param.typ),
				return_type = target.return_type,
				is_pure = target.is_pure
			}


private pure func task_capture_moves_env_slot(capture: CoreTaskCapture) -> Bool:
	match capture.kind:
		TaskCopyCapture:
			True
		TaskMoveResourceItem:
			True
		TaskStructuredTaskBorrow:
			False


-- CoreTaskCapture has no identity yet (out of this step's scope: task
-- captures are keyed by name only, see `same_var_name`/`expr_consumes_var`
-- below); `uniq = 0` is a placeholder, not a real binder identity.
private pure func closure_capture_from_task_capture(capture: CoreTaskCapture) -> CoreClosureCapture:
	{
		name = capture.name,
		uniq = 0,
		typ = capture.typ
	}


private pure func definition_identity_exists(
	definitions: List[CoreDefinitionIdentity],
	name: String,
	def_id: Int,
) -> Bool:
	var found: Bool = False

	for definition in definitions:
		if definition.name == name and definition.def_id == def_id:
			found = True
			break

	found


private pure func variable_references_definition(
	variable: CoreVar,
	definitions: List[CoreDefinitionIdentity],
) -> Bool:
	match variable.def_id:
		Some(def_id):
			definition_identity_exists(definitions, variable.name, def_id)
		None:
			False


private pure func add_bound_name(bound: List[String], name: String) -> List[String]:
	result: List[String] = bound

	if result.contains(name):
		result
	else:
		result.append(name)


private pure func add_bound_var(bound: List[String], variable: CoreVar) -> List[String]:
	add_bound_name(bound, variable.name)


private pure func add_bound_param(bound: List[String], param: CoreParam) -> List[String]:
	add_bound_var(bound, param.name)


private pure func add_bound_params(bound: List[String], params: List[CoreParam]) -> List[String]:
	var result: List[String] = bound

	for param in params:
		result = add_bound_param(result, param)

	result


private pure func add_bound_match_bindings(
	bound: List[String],
	bindings: List[CoreMatchBinding],
) -> List[String]:
	var result: List[String] = bound

	for binding in bindings:
		result = add_bound_var(result, binding.variable)

	result


-- Identity dedup: name plus `uniq`, matching `core_var_equal`. Every `uniq`
-- is distinct per binder within a function (step 1), so two free
-- occurrences with equal name and `uniq` are always the same originating
-- variable; this can only be stricter than the old name-only dedup, never
-- looser, so it cannot introduce a new capture the old code would have
-- merged away.
private pure func add_free_var(vars: List[FreeVar], name: String, uniq: Int, typ: CoreType) -> List[FreeVar]:
	var exists: Bool = False

	for existing in vars:
		if existing.name == name and existing.uniq == uniq:
			exists = True
			break
		else:
			void

	if exists:
		vars
	else:
		free_var: FreeVar = {
			name = name,
			uniq = uniq,
			typ = typ
		}
		vars.append(free_var)


private pure func merge_free_vars(left: List[FreeVar], right: List[FreeVar]) -> List[FreeVar]:
	var result: List[FreeVar] = left

	for item in right:
		result = add_free_var(result, item.name, item.uniq, item.typ)

	result


private pure func free_vars_exprs(
	facts: ClosureFacts,
	bound: List[String],
	exprs: List[CoreExpr],
) -> List[FreeVar]:
	var result: List[FreeVar] = []

	for expr in exprs:
		result = merge_free_vars(
			result,
			free_vars_expr(facts, bound, expr),
		)

	result


private pure func free_vars_boxed_storage_value(
	facts: ClosureFacts,
	bound: List[String],
	value: CoreBoxedStorageValue,
) -> List[FreeVar]:
	free_vars_expr(facts, bound, value.value)


private pure func free_vars_boxed_storage_values(
	facts: ClosureFacts,
	bound: List[String],
	values: List[CoreBoxedStorageValue],
) -> List[FreeVar]:
	var result: List[FreeVar] = []

	for value in values:
		result = merge_free_vars(
			result,
			free_vars_boxed_storage_value(facts, bound, value),
		)

	result


private pure func free_vars_tuple_element(
	facts: ClosureFacts,
	bound: List[String],
	element: CoreTupleElement,
) -> List[FreeVar]:
	match element:
		TuplePrimElement(expr):
			free_vars_expr(facts, bound, expr)
		TuplePointerElement(expr):
			free_vars_expr(facts, bound, expr)
		TupleStructElement(expr, c_type):
			free_vars_expr(facts, bound, expr)
		TupleStackResultElement(expr):
			free_vars_expr(facts, bound, expr)
		TupleVoidElement:
			[]
		TupleFloatElement(expr):
			free_vars_expr(facts, bound, expr)
		TupleFloat32Element(expr):
			free_vars_expr(facts, bound, expr)
		TupleFloat16Element(expr):
			free_vars_expr(facts, bound, expr)


private pure func free_vars_tuple_elements(
	facts: ClosureFacts,
	bound: List[String],
	elements: List[CoreTupleElement],
) -> List[FreeVar]:
	var result: List[FreeVar] = []

	for element in elements:
		result = merge_free_vars(
			result,
			free_vars_tuple_element(facts, bound, element),
		)

	result


private pure func free_vars_record_fields(
	facts: ClosureFacts,
	bound: List[String],
	fields: List[CoreRecordFieldValue],
) -> List[FreeVar]:
	var result: List[FreeVar] = []

	for field in fields:
		result = merge_free_vars(
			result,
			free_vars_expr(facts, bound, field.value),
		)

	result


private pure func free_vars_record_cow_fields(
	facts: ClosureFacts,
	bound: List[String],
	fields: List[CoreRecordCowField],
) -> List[FreeVar]:
	var result: List[FreeVar] = []

	for field in fields:
		match field.replacement:
			Some(replacement):
				result = merge_free_vars(
					result,
					free_vars_expr(facts, bound, replacement),
				)
			None:
				void

	result


private pure func free_vars_dict_entries(
	facts: ClosureFacts,
	bound: List[String],
	entries: List[CoreDictEntry],
) -> List[FreeVar]:
	var result: List[FreeVar] = []

	for entry in entries:
		result = merge_free_vars(
			result,
			free_vars_boxed_storage_value(facts, bound, entry.key),
		)
		result = merge_free_vars(
			result,
			free_vars_boxed_storage_value(facts, bound, entry.value),
		)

	result


private pure func free_vars_dict_literal_entries(
	facts: ClosureFacts,
	bound: List[String],
	entries: List[CoreDictLiteralEntry],
) -> List[FreeVar]:
	var result: List[FreeVar] = []

	for entry in entries:
		result = merge_free_vars(
			result,
			free_vars_expr(facts, bound, entry.key),
		)
		result = merge_free_vars(
			result,
			free_vars_expr(facts, bound, entry.value),
		)

	result


private pure func free_vars_tensor_payload(
	facts: ClosureFacts,
	bound: List[String],
	payload: CoreTensorLiteralPayload,
) -> List[FreeVar]:
	match payload:
		TensorRawLiteralPayload(raw):
			free_vars_exprs(facts, bound, raw.elements)
		TensorInlineStructLiteralPayload(inline_struct):
			free_vars_exprs(facts, bound, inline_struct.elements)


private pure func free_vars_optional_expr(
	facts: ClosureFacts,
	bound: List[String],
	expr: Option[CoreExpr],
) -> List[FreeVar]:
	match expr:
		Some(found):
			free_vars_expr(facts, bound, found)
		None:
			[]


private pure func free_vars_literal_match_cases(
	facts: ClosureFacts,
	bound: List[String],
	cases: List[CoreLiteralMatchCase],
) -> List[FreeVar]:
	var result: List[FreeVar] = []

	for match_case in cases:
		case_bound: List[String] = add_bound_match_bindings(bound, match_case.bindings)
		result = merge_free_vars(
			result,
			free_vars_expr(facts, case_bound, match_case.body),
		)

	result


private pure func free_vars_literal_match_fallback(
	facts: ClosureFacts,
	bound: List[String],
	fallback: CoreLiteralMatchFallback,
) -> List[FreeVar]:
	match fallback:
		LiteralMatchFallbackBody(body):
			free_vars_expr(facts, bound, body)
		LiteralMatchFallbackBindings(bindings, body):
			free_vars_expr(
				facts,
				add_bound_match_bindings(bound, bindings),
				body,
			)
		LiteralMatchFallbackFail:
			[]


private pure func free_vars_constructor_match_body(
	facts: ClosureFacts,
	bound: List[String],
	body: CoreConstructorMatchBody,
) -> List[FreeVar]:
	match body:
		ConstructorMatchBodyExpr(expr):
			free_vars_expr(facts, bound, expr)
		ConstructorMatchBodyLiteral(literal_match):
			free_vars_constructor_literal_match(facts, bound, literal_match)
		ConstructorMatchBodyLength(length_match):
			free_vars_constructor_length_match(facts, bound, length_match)


private pure func free_vars_constructor_match_cases(
	facts: ClosureFacts,
	bound: List[String],
	cases: List[CoreConstructorMatchCase],
) -> List[FreeVar]:
	var result: List[FreeVar] = []

	for match_case in cases:
		case_bound: List[String] = add_bound_match_bindings(bound, match_case.bindings)
		result = merge_free_vars(
			result,
			free_vars_constructor_match_body(facts, case_bound, match_case.body),
		)

	result


private pure func free_vars_constructor_match_fallback(
	facts: ClosureFacts,
	bound: List[String],
	fallback: CoreConstructorMatchFallback,
) -> List[FreeVar]:
	match fallback:
		ConstructorMatchFallbackBody(body):
			free_vars_expr(facts, bound, body)
		ConstructorMatchFallbackBindings(bindings, body):
			free_vars_expr(
				facts,
				add_bound_match_bindings(bound, bindings),
				body,
			)
		ConstructorMatchFallbackFail:
			[]


private pure func free_vars_constructor_literal_match(
	facts: ClosureFacts,
	bound: List[String],
	match_expr: CoreConstructorLiteralMatch,
) -> List[FreeVar]:
	var result: List[FreeVar] = free_vars_literal_match_cases(facts, bound, match_expr.cases)
	merge_free_vars(
		result,
		free_vars_literal_match_fallback(facts, bound, match_expr.fallback),
	)


private pure func free_vars_constructor_length_branch(
	facts: ClosureFacts,
	bound: List[String],
	branch: CoreConstructorLengthMatchBranch,
) -> List[FreeVar]:
	free_vars_constructor_match_body(
		facts,
		add_bound_match_bindings(bound, branch.bindings),
		branch.body,
	)


private pure func free_vars_constructor_length_cases(
	facts: ClosureFacts,
	bound: List[String],
	cases: List[CoreConstructorLengthMatchCase],
) -> List[FreeVar]:
	var result: List[FreeVar] = []

	for match_case in cases:
		result = merge_free_vars(
			result,
			free_vars_constructor_length_branch(facts, bound, match_case.branch),
		)

	result


private pure func free_vars_constructor_length_geq(
	facts: ClosureFacts,
	bound: List[String],
	geq: Option[CoreConstructorLengthMatchGeq],
) -> List[FreeVar]:
	match geq:
		Some(found):
			free_vars_constructor_length_branch(facts, bound, found.branch)
		None:
			[]


private pure func free_vars_constructor_length_fallback(
	facts: ClosureFacts,
	bound: List[String],
	fallback: Option[CoreConstructorLengthMatchBranch],
) -> List[FreeVar]:
	match fallback:
		Some(branch):
			free_vars_constructor_length_branch(facts, bound, branch)
		None:
			[]


private pure func free_vars_constructor_length_match(
	facts: ClosureFacts,
	bound: List[String],
	match_expr: CoreConstructorLengthMatch,
) -> List[FreeVar]:
	var result: List[FreeVar] = free_vars_constructor_length_cases(facts, bound, match_expr.cases)
	result = merge_free_vars(
		result,
		free_vars_constructor_length_geq(facts, bound, match_expr.geq),
	)
	merge_free_vars(
		result,
		free_vars_constructor_length_fallback(facts, bound, match_expr.fallback),
	)


private pure func free_vars_select_arm_kind(
	facts: ClosureFacts,
	bound: List[String],
	kind: CoreSelectArmKind,
) -> List[FreeVar]:
	match kind:
		SelectRecvArm(recv):
			free_vars_expr(facts, bound, recv.channel)
		SelectSealedArm(channel):
			free_vars_expr(facts, bound, channel)
		SelectAfterArm(timeout):
			free_vars_expr(facts, bound, timeout)


private pure func free_vars_select_arm(
	facts: ClosureFacts,
	bound: List[String],
	arm: CoreSelectArm,
) -> List[FreeVar]:
	arm_bound: List[String] = match arm.kind:
		SelectRecvArm(recv):
			add_bound_var(bound, recv.binder)
		SelectSealedArm(channel):
			bound
		SelectAfterArm(timeout):
			bound

	merge_free_vars(
		free_vars_select_arm_kind(facts, bound, arm.kind),
		free_vars_expr(facts, arm_bound, arm.body),
	)


private pure func free_vars_select_arms(
	facts: ClosureFacts,
	bound: List[String],
	arms: List[CoreSelectArm],
) -> List[FreeVar]:
	var result: List[FreeVar] = []

	for arm in arms:
		result = merge_free_vars(
			result,
			free_vars_select_arm(facts, bound, arm),
		)

	result


private pure func free_vars_sequence(
	facts: ClosureFacts,
	bound: List[String],
	expr: CoreExpr,
) -> List[FreeVar]:
	var result: List[FreeVar] = []
	var final_item: CoreExpr = expr

	while True:
		match final_item:
			SeqExpr(first, second):
				result = merge_free_vars(
					result,
					free_vars_expr(facts, bound, first),
				)
				final_item = second
			_:
				break

	merge_free_vars(
		result,
		free_vars_expr(facts, bound, final_item),
	)


private pure func free_vars_expr(
	facts: ClosureFacts,
	bound: List[String],
	expr: CoreExpr,
) -> List[FreeVar]:
	match expr:
		VarExpr(variable, typ, loc):
			if bound.contains(variable.name):
				[]
			else if variable_references_definition(variable, facts.constructor_definitions):
				[]
			else if variable_references_definition(variable, facts.function_definitions):
				[]
			else:
				free_var: FreeVar = {
					name = variable.name,
					uniq = variable.uniq,
					typ = typ
				}
				[free_var]
		LiteralExpr(literal, typ, loc):
			[]
		StaticStringLiteralExpr(id, value, typ, loc):
			[]
		VoidExpr(typ, loc):
			[]
		DebugBlockExpr(body, typ, loc):
			free_vars_expr(facts, bound, body)
		CooperativeCheckpointExpr(typ, loc):
			[]
		CallExpr(kind, callee, args, typ, loc):
			callee_free_vars: List[FreeVar] = if call_kind_uses_runtime_callee(kind):
				free_vars_expr(facts, bound, callee)
			else:
				[]

			merge_free_vars(
				callee_free_vars,
				free_vars_exprs(facts, bound, args),
			)
		BinaryExpr(op, left, right, typ, loc):
			merge_free_vars(
				free_vars_expr(facts, bound, left),
				free_vars_expr(facts, bound, right),
			)
		UnaryExpr(op, expr_value, typ, loc):
			free_vars_expr(facts, bound, expr_value)
		LogicalExpr(op, left, right, typ, loc):
			merge_free_vars(
				free_vars_expr(facts, bound, left),
				free_vars_expr(facts, bound, right),
			)
		AssignExpr(variable, rhs, typ, loc):
			free_vars_expr(facts, bound, rhs)
		CastExpr(expr_value, typ, loc):
			free_vars_expr(facts, bound, expr_value)
		BoxExpr(box, typ, loc):
			free_vars_expr(facts, bound, box.value)
		UnboxExpr(unbox_kind, expr_value, typ, loc):
			free_vars_expr(facts, bound, expr_value)
		FieldExpr(expr_value, field_name, typ, loc):
			free_vars_expr(facts, bound, expr_value)
		TupleFieldExpr(expr_value, field_index, typ, loc):
			free_vars_expr(facts, bound, expr_value)
		TupleExpr(items, typ, loc):
			free_vars_exprs(facts, bound, items)
		TupleConstructExpr(tuple_construct, typ, loc):
			free_vars_tuple_elements(facts, bound, tuple_construct.elements)
		VectorExpr(items, typ, loc):
			free_vars_exprs(facts, bound, items)
		LambdaExpr(lambda_params, lambda_return_type, lambda_body, lambda_is_pure, typ, loc):
			free_vars_expr(
				facts,
				add_bound_params(bound, lambda_params),
				lambda_body,
			)
		ClosureCreateExpr(closure, typ, loc):
			var result: List[FreeVar] = []

			for capture in closure.captures:
				if bound.contains(capture.name):
					void
				else:
					result = add_free_var(result, capture.name, capture.uniq, capture.typ)

			result
		ListConstructExpr(construct, typ, loc):
			free_vars_boxed_storage_values(facts, bound, construct.elements)
		ListAllocExpr(alloc, typ, loc):
			free_vars_expr(facts, bound, alloc.capacity)
		ListGetExpr(get, typ, loc):
			merge_free_vars(
				free_vars_expr(facts, bound, get.list),
				free_vars_expr(facts, bound, get.index),
			)
		ListHandoffExpr(handoff, typ, loc):
			var result: List[FreeVar] = free_vars_expr(facts, bound, handoff.source)
			result = merge_free_vars(
				result,
				free_vars_expr(facts, bound, handoff.capacity),
			)
			inner_bound: List[String] = bound
				.add_bound_var(handoff.source_var)
				.add_bound_var(handoff.result_var)
				.add_bound_var(handoff.len_var)
				.add_bound_var(handoff.out_var)
			merge_free_vars(
				result,
				free_vars_expr(facts, inner_bound, handoff.body),
			)
		ListHandoffSetOwnedExpr(set, typ, loc):
			var result: List[FreeVar] = free_vars_expr(facts, bound, set.list)
			result = merge_free_vars(
				result,
				free_vars_expr(facts, bound, set.index),
			)
			merge_free_vars(
				result,
				free_vars_boxed_storage_value(facts, bound, set.value),
			)
		ListHandoffSetSourceSlotExpr(slot, typ, loc):
			var result: List[FreeVar] = free_vars_expr(facts, bound, slot.result)
			result = merge_free_vars(
				result,
				free_vars_expr(facts, bound, slot.out_index),
			)
			result = merge_free_vars(
				result,
				free_vars_expr(facts, bound, slot.source),
			)
			merge_free_vars(
				result,
				free_vars_expr(facts, bound, slot.source_index),
			)
		StringByteReadExpr(read, typ, loc):
			merge_free_vars(
				free_vars_expr(facts, bound, read.source),
				free_vars_expr(facts, bound, read.index),
			)
		StringByteWriteExpr(write, typ, loc):
			var result: List[FreeVar] = free_vars_expr(facts, bound, write.target)
			result = merge_free_vars(
				result,
				free_vars_expr(facts, bound, write.index),
			)
			merge_free_vars(
				result,
				free_vars_expr(facts, bound, write.byte),
			)
		StringByteCopyExpr(copy, typ, loc):
			var result: List[FreeVar] = free_vars_expr(facts, bound, copy.dst)
			result = merge_free_vars(
				result,
				free_vars_expr(facts, bound, copy.dst_pos),
			)
			result = merge_free_vars(
				result,
				free_vars_expr(facts, bound, copy.src),
			)
			result = merge_free_vars(
				result,
				free_vars_expr(facts, bound, copy.src_pos),
			)
			merge_free_vars(
				result,
				free_vars_expr(facts, bound, copy.len),
			)
		StringSetLenExpr(set_len, typ, loc):
			merge_free_vars(
				free_vars_expr(facts, bound, set_len.target),
				free_vars_expr(facts, bound, set_len.len),
			)
		TensorLiteralExpr(literal, typ, loc):
			free_vars_tensor_payload(facts, bound, literal.payload)
		TensorBoxedLiteralExpr(literal, typ, loc):
			free_vars_boxed_storage_values(facts, bound, literal.elements)
		TensorPackedLiteralExpr(literal, typ, loc):
			[]
		TensorRawFillExpr(fill, typ, loc):
			merge_free_vars(
				free_vars_expr(facts, bound, fill.value),
				free_vars_exprs(facts, bound, fill.dims),
			)
		TensorRawReadExpr(read, typ, loc):
			free_vars_expr(facts, bound, read.index)
		TensorRawWriteExpr(write, typ, loc):
			merge_free_vars(
				free_vars_expr(facts, bound, write.index),
				free_vars_expr(facts, bound, write.value),
			)
		TensorRawViewLetExpr(binding, body, typ, loc):
			var result: List[FreeVar] = free_vars_expr(facts, bound, binding.source)
			merge_free_vars(
				result,
				free_vars_expr(
					facts,
					add_bound_var(bound, binding.variable),
					body,
				),
			)
		DictExpr(entries, typ, loc):
			free_vars_dict_literal_entries(facts, bound, entries)
		DictConstructExpr(construct, typ, loc):
			free_vars_dict_entries(facts, bound, construct.entries)
		SetAllocExpr(alloc, typ, loc):
			[]
		ListRetainExpr(retain, typ, loc):
			var result: List[FreeVar] = free_vars_expr(facts, bound, retain.list)
			merge_free_vars(
				result,
				free_vars_boxed_storage_value(facts, bound, retain.value),
			)
		ListSetExpr(set, typ, loc):
			var result: List[FreeVar] = free_vars_expr(facts, bound, set.list)
			result = merge_free_vars(
				result,
				free_vars_expr(facts, bound, set.index),
			)
			merge_free_vars(
				result,
				free_vars_boxed_storage_value(facts, bound, set.value),
			)
		ListSwapExpr(swap, typ, loc):
			var result: List[FreeVar] = free_vars_expr(facts, bound, swap.list)
			result = merge_free_vars(
				result,
				free_vars_expr(facts, bound, swap.left_index),
			)
			merge_free_vars(
				result,
				free_vars_expr(facts, bound, swap.right_index),
			)
		RecordExpr(fields, typ, loc):
			free_vars_record_fields(facts, bound, fields)
		RecordUpdateExpr(base, fields, typ, loc):
			merge_free_vars(
				free_vars_expr(facts, bound, base),
				free_vars_record_fields(facts, bound, fields),
			)
		RecordReuseExpr(source, fields, typ, loc):
			merge_free_vars(
				free_vars_expr(facts, bound, source),
				free_vars_record_fields(facts, bound, fields),
			)
		RecordCowUpdateExpr(source, fields, typ, loc):
			merge_free_vars(
				free_vars_record_cow_fields(facts, bound, fields),
				free_vars_expr(facts, bound, source),
			)
		RecordConstructExpr(type_name, fields, typ, loc):
			free_vars_record_fields(facts, bound, fields)
		UnionConstructExpr(construct, typ, loc):
			free_vars_boxed_storage_values(facts, bound, construct.args)
		UnionReuseConstructExpr(construct, typ, loc):
			var result: List[FreeVar] = free_vars_expr(facts, bound, construct.source)
			merge_free_vars(
				result,
				free_vars_boxed_storage_values(facts, bound, construct.args),
			)
		PreClosureDetachExpr(detached, typ, loc):
			free_vars_expr(facts, bound, detached)
		DetachExpr(detached, typ, loc):
			var result: List[FreeVar] = []

			-- `detached.captures` is `List[CoreTaskCapture]`, which has no
			-- identity yet (out of this step's scope); 0 is a placeholder,
			-- matching `closure_capture_from_task_capture`.
			for capture in detached.captures:
				if bound.contains(capture.name):
					void
				else:
					result = add_free_var(result, capture.name, 0, capture.typ)

			result
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			free_vars_expr(facts, bound, body)
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			free_vars_expr(facts, bound, body)
		LetExpr(variable, is_mutable, value_type, rhs, body):
			var result: List[FreeVar] = free_vars_expr(facts, bound, rhs)
			merge_free_vars(
				result,
				free_vars_expr(
					facts,
					add_bound_var(bound, variable),
					body,
				),
			)
		BorrowLetExpr(variable, value_type, rhs, body):
			var result: List[FreeVar] = free_vars_expr(facts, bound, rhs)
			merge_free_vars(
				result,
				free_vars_expr(
					facts,
					add_bound_var(bound, variable),
					body,
				),
			)
		SeqExpr(first, second):
			free_vars_sequence(facts, bound, expr)
		WhileExpr(cond, body, typ, loc):
			merge_free_vars(
				free_vars_expr(facts, bound, cond),
				free_vars_expr(facts, bound, body),
			)
		BreakExpr(typ, loc):
			[]
		ContinueExpr(typ, loc):
			[]
		ResourceScopeExpr(scope, typ, loc):
			var result: List[FreeVar] = free_vars_expr(facts, bound, scope.acquire)
			scoped_bound: List[String] = add_bound_var(bound, scope.variable)
			result = merge_free_vars(
				result,
				free_vars_expr(facts, scoped_bound, scope.body),
			)
			merge_free_vars(
				result,
				free_vars_expr(facts, scoped_bound, scope.cleanup),
			)
		ResourceCleanupExitExpr(exit, typ, loc):
			free_vars_exprs(facts, bound, exit.cleanups)
		TailrecLoopExpr(params, return_type, body, loc):
			free_vars_expr(
				facts,
				add_bound_params(bound, params),
				body,
			)
		TailrecRecurExpr(args, typ, loc):
			free_vars_exprs(facts, bound, args)
		TailrecListSpreadLoopExpr(loop, loc):
			loop_bound: List[String] = bound
				.add_bound_param(loop.list_param)
				.add_bound_var(loop.cursor)
			free_vars_expr(facts, loop_bound, loop.body)
		TailrecListSpreadRecurExpr(rebinds, cursor_advance, typ, loc):
			var result: List[FreeVar] = []

			for rebind in rebinds:
				result = merge_free_vars(
					result,
					free_vars_expr(facts, bound, rebind.value),
				)

			result
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			var result: List[FreeVar] = free_vars_expr(facts, bound, start)
			result = merge_free_vars(
				result,
				free_vars_expr(facts, bound, end_value),
			)
			merge_free_vars(
				result,
				free_vars_expr(
					facts,
					add_bound_var(bound, binder.variable),
					body,
				),
			)
		ForChannelExpr(for_channel, typ, loc):
			var result: List[FreeVar] = free_vars_expr(facts, bound, for_channel.iterable)
			merge_free_vars(
				result,
				free_vars_expr(
					facts,
					add_bound_var(bound, for_channel.binder.variable),
					for_channel.body,
				),
			)
		ForListExpr(for_list, typ, loc):
			var result: List[FreeVar] = free_vars_expr(facts, bound, for_list.iterable)
			merge_free_vars(
				result,
				free_vars_expr(
					facts,
					add_bound_var(bound, for_list.binder.variable),
					for_list.body,
				),
			)
		ForStringExpr(for_string, typ, loc):
			var result: List[FreeVar] = free_vars_expr(facts, bound, for_string.iterable)
			merge_free_vars(
				result,
				free_vars_expr(
					facts,
					add_bound_var(bound, for_string.binder.variable),
					for_string.body,
				),
			)
		ForDictExpr(for_dict, typ, loc):
			var result: List[FreeVar] = free_vars_expr(facts, bound, for_dict.iterable)
			merge_free_vars(
				result,
				free_vars_expr(
					facts,
					add_bound_var(bound, for_dict.binder.variable),
					for_dict.body,
				),
			)
		ForSetExpr(for_set, typ, loc):
			var result: List[FreeVar] = free_vars_expr(facts, bound, for_set.iterable)
			merge_free_vars(
				result,
				free_vars_expr(
					facts,
					add_bound_var(bound, for_set.binder.variable),
					for_set.body,
				),
			)
		ForStreamExpr(for_stream, typ, loc):
			var result: List[FreeVar] = free_vars_expr(facts, bound, for_stream.iterable)
			merge_free_vars(
				result,
				free_vars_expr(
					facts,
					add_bound_var(bound, for_stream.binder.variable),
					for_stream.body,
				),
			)
		ForResourceSourceExpr(for_resource_source, typ, loc):
			var result: List[FreeVar] = free_vars_expr(facts, bound, for_resource_source.iterable)
			merge_free_vars(
				result,
				free_vars_expr(
					facts,
					add_bound_var(bound, for_resource_source.binder.variable),
					for_resource_source.body,
				),
			)
		ForTensorExpr(for_tensor, typ, loc):
			var result: List[FreeVar] = free_vars_expr(facts, bound, for_tensor.iterable)
			merge_free_vars(
				result,
				free_vars_expr(
					facts,
					add_bound_var(bound, for_tensor.binder.variable),
					for_tensor.body,
				),
			)
		PreClosureConcurrentlyLoopExpr(loop, typ, loc):
			var result: List[FreeVar] = free_vars_expr(facts, bound, loop.iterable)
			body_bound: List[String] = add_bound_var(bound, loop.variable)
			result = merge_free_vars(
				result,
				free_vars_expr(facts, body_bound, loop.body),
			)
			result = merge_free_vars(
				result,
				free_vars_optional_expr(facts, bound, loop.timeout),
			)
			merge_free_vars(
				result,
				free_vars_expr(facts, bound, loop.limit),
			)
		ConcurrentlyLoopExpr(loop, typ, loc):
			var result: List[FreeVar] = free_vars_expr(facts, bound, loop.iterable)
			body_bound: List[String] = add_bound_var(bound, loop.variable)
			result = merge_free_vars(
				result,
				free_vars_expr(facts, body_bound, loop.body),
			)
			result = merge_free_vars(
				result,
				free_vars_optional_expr(facts, bound, loop.timeout),
			)
			merge_free_vars(
				result,
				free_vars_expr(facts, bound, loop.limit),
			)
		PreClosureConcurrentExpr(block, typ, loc):
			var result: List[FreeVar] = []

			for binding in block.bindings:
				result = merge_free_vars(
					result,
					free_vars_expr(facts, bound, binding.rhs),
				)

			var body_bound: List[String] = bound

			for binding in block.bindings:
				body_bound = add_bound_var(body_bound, binding.variable)

			result = merge_free_vars(
				result,
				free_vars_expr(facts, body_bound, block.body),
			)
			merge_free_vars(
				result,
				free_vars_optional_expr(facts, bound, block.timeout),
			)
		ConcurrentExpr(block, typ, loc):
			var result: List[FreeVar] = []

			for binding in block.bindings:
				result = merge_free_vars(
					result,
					free_vars_expr(facts, bound, binding.rhs),
				)

			var body_bound: List[String] = bound

			for binding in block.bindings:
				body_bound = add_bound_var(body_bound, binding.variable)

			result = merge_free_vars(
				result,
				free_vars_expr(facts, body_bound, block.body),
			)
			merge_free_vars(
				result,
				free_vars_optional_expr(facts, bound, block.timeout),
			)
		SelectExpr(select_expr, typ, loc):
			free_vars_select_arms(facts, bound, select_expr)
		RangeExpr(start, end_value, typ, loc):
			merge_free_vars(
				free_vars_expr(facts, bound, start),
				free_vars_expr(facts, bound, end_value),
			)
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			var result: List[FreeVar] = free_vars_expr(facts, bound, scrutinee)
			result = merge_free_vars(
				result,
				free_vars_literal_match_cases(facts, bound, cases),
			)
			merge_free_vars(
				result,
				free_vars_literal_match_fallback(facts, bound, fallback),
			)
		RawMatchExpr(scrutinee, cases, typ, loc):
			var result: List[FreeVar] = free_vars_expr(facts, bound, scrutinee)

			for case in cases:
				case_bound: List[String] = bound
					.concat(core_pattern_bound_names(case.pattern))
					.unique()
				result = merge_free_vars(
					result,
					free_vars_expr(facts, case_bound, case.body),
				)

			result
		SemanticMatchExpr(scrutinee, tree, typ, loc):
			free_vars_exprs(facts, bound, immediate_core_expr_children(expr))
		AccessorLiteralMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			var result: List[FreeVar] = free_vars_expr(facts, bound, scrutinee)
			merge_free_vars(
				result,
				free_vars_constructor_literal_match(facts, bound, match_expr),
			)
		LengthMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			var result: List[FreeVar] = free_vars_expr(facts, bound, scrutinee)
			merge_free_vars(
				result,
				free_vars_constructor_length_match(facts, bound, match_expr),
			)
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			var result: List[FreeVar] = free_vars_expr(facts, bound, scrutinee)
			result = merge_free_vars(
				result,
				free_vars_constructor_match_cases(facts, bound, cases),
			)
			merge_free_vars(
				result,
				free_vars_constructor_match_fallback(facts, bound, fallback),
			)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			var result: List[FreeVar] = free_vars_expr(facts, bound, cond)
			result = merge_free_vars(
				result,
				free_vars_expr(facts, bound, then_expr),
			)
			merge_free_vars(
				result,
				free_vars_expr(facts, bound, else_expr),
			)


private pure func next_eta_name(state: ClosureState) -> FreshHoistedName:
	name: String = ETA_NAME_PREFIX + state.next_eta_index.to_string()
	def_id: Int = state.next_def_id
	c_name: String = mangle_by_def_id(def_id, name)
	new_state: ClosureState = { state |
		next_eta_index = state.next_eta_index + 1,
		next_def_id = state.next_def_id + 1
	}
	{
		state = new_state,
		name = name,
		def_id = def_id,
		c_name = c_name,
		static_name = static_closure_name(c_name)
	}


private pure func next_lambda_name(state: ClosureState) -> FreshHoistedName:
	name: String = LAMBDA_NAME_PREFIX + state.next_lambda_index.to_string()
	def_id: Int = state.next_def_id
	c_name: String = mangle_by_def_id(def_id, name)
	new_state: ClosureState = { state |
		next_lambda_index = state.next_lambda_index + 1,
		next_def_id = state.next_def_id + 1
	}
	{
		state = new_state,
		name = name,
		def_id = def_id,
		c_name = c_name,
		static_name = static_closure_name(c_name)
	}


private pure func next_task_name(state: ClosureState) -> FreshHoistedName:
	name: String = TASK_NAME_PREFIX + state.next_task_index.to_string()
	def_id: Int = state.next_def_id
	c_name: String = mangle_by_def_id(def_id, name)
	new_state: ClosureState = { state |
		next_task_index = state.next_task_index + 1,
		next_def_id = state.next_def_id + 1
	}
	{
		state = new_state,
		name = name,
		def_id = def_id,
		c_name = c_name,
		static_name = static_closure_name(c_name)
	}


private pure func captures_from_body(
	facts: ClosureFacts,
	local_bound: List[String],
	body: CoreExpr,
) -> List[FreeVar]:
	var result: List[FreeVar] = []

	for free_var in free_vars_expr(facts, local_bound, body):
		result = add_free_var(result, free_var.name, free_var.uniq, free_var.typ)

	result


pure func lambda_runtime_captures(
	function_definitions: List[CoreDefinitionIdentity],
	constructor_definitions: List[CoreDefinitionIdentity],
	params: List[CoreParam],
	body: CoreExpr,
) -> List[CoreClosureCapture]:
	facts: ClosureFacts = {
		mode = ConvertClosures,
		current_module = None,
		functions_by_id = {},
		function_collisions_by_id = {},
		functions_by_name = {},
		function_definitions = function_definitions,
		constructor_definitions = constructor_definitions
	}

	closure_captures_from_free_vars(captures_from_body(facts, add_bound_params([], params), body))


pure func lambda_has_runtime_captures(
	function_definitions: List[CoreDefinitionIdentity],
	constructor_definitions: List[CoreDefinitionIdentity],
	params: List[CoreParam],
	body: CoreExpr,
) -> Bool:
	lambda_runtime_captures(
		function_definitions,
		constructor_definitions,
		params,
		body,
	).length() > 0


private pure func core_sequence_type(expr: CoreExpr) -> CoreType:
	var final_item: CoreExpr = expr

	while True:
		match final_item:
			SeqExpr(first, second):
				final_item = second
			_:
				break

	core_expr_type(final_item)


private pure func core_expr_type(expr: CoreExpr) -> CoreType:
	match expr:
		LiteralExpr(literal, typ, loc):
			typ
		StaticStringLiteralExpr(id, value, typ, loc):
			typ
		VarExpr(variable, typ, loc):
			typ
		VoidExpr(typ, loc):
			typ
		DebugBlockExpr(body, typ, loc):
			typ
		CooperativeCheckpointExpr(typ, loc):
			typ
		CallExpr(kind, callee, args, typ, loc):
			typ
		BinaryExpr(op, left, right, typ, loc):
			typ
		UnaryExpr(op, expr_value, typ, loc):
			typ
		LogicalExpr(op, left, right, typ, loc):
			typ
		AssignExpr(variable, rhs, typ, loc):
			typ
		CastExpr(expr_value, typ, loc):
			typ
		BoxExpr(box, typ, loc):
			typ
		UnboxExpr(unbox_kind, expr_value, typ, loc):
			typ
		FieldExpr(expr_value, field_name, typ, loc):
			typ
		TupleFieldExpr(expr_value, field_index, typ, loc):
			typ
		TupleExpr(items, typ, loc):
			typ
		TupleConstructExpr(tuple_construct, typ, loc):
			typ
		VectorExpr(items, typ, loc):
			typ
		LambdaExpr(lambda_params, lambda_return_type, lambda_body, lambda_is_pure, typ, loc):
			typ
		ClosureCreateExpr(closure, typ, loc):
			typ
		ListConstructExpr(construct, typ, loc):
			typ
		ListAllocExpr(alloc, typ, loc):
			typ
		ListGetExpr(get, typ, loc):
			typ
		ListHandoffExpr(handoff, typ, loc):
			typ
		ListHandoffSetOwnedExpr(set, typ, loc):
			typ
		ListHandoffSetSourceSlotExpr(slot, typ, loc):
			typ
		StringByteReadExpr(read, typ, loc):
			typ
		StringByteWriteExpr(write, typ, loc):
			typ
		StringByteCopyExpr(copy, typ, loc):
			typ
		StringSetLenExpr(set_len, typ, loc):
			typ
		TensorLiteralExpr(literal, typ, loc):
			typ
		TensorBoxedLiteralExpr(literal, typ, loc):
			typ
		TensorPackedLiteralExpr(literal, typ, loc):
			typ
		TensorRawFillExpr(fill, typ, loc):
			typ
		TensorRawReadExpr(read, typ, loc):
			typ
		TensorRawWriteExpr(write, typ, loc):
			typ
		TensorRawViewLetExpr(binding, body, typ, loc):
			typ
		DictExpr(entries, typ, loc):
			typ
		DictConstructExpr(construct, typ, loc):
			typ
		SetAllocExpr(alloc, typ, loc):
			typ
		ListRetainExpr(retain, typ, loc):
			typ
		ListSetExpr(set, typ, loc):
			typ
		ListSwapExpr(swap, typ, loc):
			typ
		RecordExpr(fields, typ, loc):
			typ
		RecordUpdateExpr(base, fields, typ, loc):
			typ
		RecordReuseExpr(source, fields, typ, loc):
			typ
		RecordCowUpdateExpr(source, fields, typ, loc):
			typ
		RecordConstructExpr(type_name, fields, typ, loc):
			typ
		UnionConstructExpr(construct, typ, loc):
			typ
		UnionReuseConstructExpr(construct, typ, loc):
			typ
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			typ
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			typ
		LetExpr(name, is_mutable, typ, rhs, body):
			core_expr_type(body)
		BorrowLetExpr(name, typ, rhs, body):
			core_expr_type(body)
		SeqExpr(first, second):
			core_sequence_type(expr)
		WhileExpr(cond, body, typ, loc):
			typ
		BreakExpr(typ, loc):
			typ
		ContinueExpr(typ, loc):
			typ
		ResourceScopeExpr(scope, typ, loc):
			typ
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			typ
		TailrecLoopExpr(params, return_type, body, loc):
			return_type
		TailrecRecurExpr(args, typ, loc):
			typ
		TailrecListSpreadLoopExpr(loop, loc):
			loop.return_type
		TailrecListSpreadRecurExpr(rebinds, cursor_advance, typ, loc):
			typ
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			typ
		ForChannelExpr(for_channel, typ, loc):
			typ
		ForListExpr(for_list, typ, loc):
			typ
		ForStringExpr(for_string, typ, loc):
			typ
		ForDictExpr(for_dict, typ, loc):
			typ
		ForSetExpr(for_set, typ, loc):
			typ
		ForResourceSourceExpr(for_resource_source, typ, loc):
			typ
		ForStreamExpr(for_stream, typ, loc):
			typ
		ForTensorExpr(for_tensor, typ, loc):
			typ
		PreClosureDetachExpr(detached, typ, loc):
			typ
		DetachExpr(detached, typ, loc):
			typ
		PreClosureConcurrentlyLoopExpr(loop, typ, loc):
			typ
		ConcurrentlyLoopExpr(loop, typ, loc):
			typ
		PreClosureConcurrentExpr(block, typ, loc):
			typ
		ConcurrentExpr(block, typ, loc):
			typ
		SelectExpr(select_expr, typ, loc):
			typ
		RangeExpr(start, end_value, typ, loc):
			typ
		AccessorLiteralMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			typ
		LengthMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			typ
		LiteralMatchExpr(scrutinee, cases, default_body, typ, loc):
			typ
		RawMatchExpr(scrutinee, cases, typ, loc):
			typ
		SemanticMatchExpr(scrutinee, tree, typ, loc):
			typ
		ConstructorMatchExpr(scrutinee, scrutinee_release_policy, cases, default_body, typ, loc):
			typ
		IfExpr(cond, then_expr, else_expr, typ, loc):
			typ


private pure func closure_capture_from_free_var(free_var: FreeVar) -> CoreClosureCapture:
	{
		name = free_var.name,
		uniq = free_var.uniq,
		typ = free_var.typ
	}


private pure func closure_captures_from_free_vars(
	free_vars: List[FreeVar],
) -> List[CoreClosureCapture]:
	free_vars.map(closure_capture_from_free_var)


private pure func task_capture_from_free_var(
	free_var: FreeVar,
	kind: CoreTaskCaptureKind,
) -> CoreTaskCapture:
	{
		name = free_var.name,
		typ = free_var.typ,
		kind = kind
	}


private pure func task_captures_for_loop(
	free_vars: List[FreeVar],
	loop_variable: CoreVar,
	item_mode: CoreConcurrentlyLoopItemMode,
) -> List[CoreTaskCapture]:
	var result: List[CoreTaskCapture] = []

	for free_var in free_vars:
		kind: CoreTaskCaptureKind = match item_mode:
			ConcurrentlyLoopMoveResourceItem(move_item):
				if free_var.name == loop_variable.name:
					TaskMoveResourceItem
				else:
					TaskCopyCapture
			ConcurrentlyLoopCopyItem:
				TaskCopyCapture

		result = result.append(task_capture_from_free_var(free_var, kind))

	result


-- Deliberately name-only, not `core_var_equal` (which also requires equal
-- `uniq`). Every caller in this file (expr_is_var_ref, expr_consumes_var and
-- its match/select/loop helpers, match_bindings_shadow_var,
-- concurrent_bindings_shadow_var) is part of one free-variable/shadowing
-- walk: a nested binding always mints a fresh `uniq`, so a binding that
-- shadows the tracked free variable has the same name but a different uniq,
-- and `core_var_equal` would miss it. Callers rely on this: they call the
-- *_shadow_var helpers before recursing into a scope's body, and only then
-- call expr_consumes_var/expr_is_var_ref on that body, so by construction no
-- shadowing binding is still in scope when those name-only checks run.
private pure func same_var_name(left: CoreVar, right: CoreVar) -> Bool:
	left.name == right.name


private pure func expr_is_var_ref(expr: CoreExpr, variable: CoreVar) -> Bool:
	match expr:
		VarExpr(candidate, typ, loc):
			same_var_name(candidate, variable)
		LiteralExpr(literal, typ, loc):
			False
		StaticStringLiteralExpr(id, value, typ, loc):
			False
		VoidExpr(typ, loc):
			False
		DebugBlockExpr(body, typ, loc):
			False
		CooperativeCheckpointExpr(typ, loc):
			False
		CallExpr(kind, callee, args, typ, loc):
			False
		BinaryExpr(op, left, right, typ, loc):
			False
		UnaryExpr(op, expr_value, typ, loc):
			False
		LogicalExpr(op, left, right, typ, loc):
			False
		AssignExpr(assign_var, rhs, typ, loc):
			False
		CastExpr(expr_value, typ, loc):
			False
		BoxExpr(box, typ, loc):
			False
		UnboxExpr(unbox_kind, expr_value, typ, loc):
			False
		FieldExpr(expr_value, field_name, typ, loc):
			False
		TupleFieldExpr(expr_value, field_index, typ, loc):
			False
		TupleExpr(items, typ, loc):
			False
		TupleConstructExpr(tuple_construct, typ, loc):
			False
		VectorExpr(items, typ, loc):
			False
		LambdaExpr(lambda_params, lambda_return_type, lambda_body, lambda_is_pure, typ, loc):
			False
		ClosureCreateExpr(closure, typ, loc):
			False
		ListConstructExpr(construct, typ, loc):
			False
		ListAllocExpr(alloc, typ, loc):
			False
		ListGetExpr(get, typ, loc):
			False
		ListHandoffExpr(handoff, typ, loc):
			False
		ListHandoffSetOwnedExpr(set, typ, loc):
			False
		ListHandoffSetSourceSlotExpr(slot, typ, loc):
			False
		ListRetainExpr(retain, typ, loc):
			False
		ListSetExpr(set, typ, loc):
			False
		ListSwapExpr(swap, typ, loc):
			False
		StringByteReadExpr(read, typ, loc):
			False
		StringByteWriteExpr(write, typ, loc):
			False
		StringByteCopyExpr(copy, typ, loc):
			False
		StringSetLenExpr(set_len, typ, loc):
			False
		TensorLiteralExpr(literal, typ, loc):
			False
		TensorBoxedLiteralExpr(literal, typ, loc):
			False
		TensorPackedLiteralExpr(literal, typ, loc):
			False
		TensorRawFillExpr(fill, typ, loc):
			False
		TensorRawReadExpr(read, typ, loc):
			False
		TensorRawWriteExpr(write, typ, loc):
			False
		TensorRawViewLetExpr(binding, body, typ, loc):
			False
		DictExpr(entries, typ, loc):
			False
		DictConstructExpr(construct, typ, loc):
			False
		SetAllocExpr(alloc, typ, loc):
			False
		RecordExpr(fields, typ, loc):
			False
		RecordUpdateExpr(base, fields, typ, loc):
			False
		RecordReuseExpr(source, fields, typ, loc):
			False
		RecordCowUpdateExpr(source, fields, typ, loc):
			False
		RecordConstructExpr(type_name, fields, typ, loc):
			False
		UnionConstructExpr(construct, typ, loc):
			False
		UnionReuseConstructExpr(construct, typ, loc):
			False
		PreClosureDetachExpr(detached, typ, loc):
			False
		DetachExpr(detached, typ, loc):
			False
		DupExpr(dup_var, value_type, retain_policy, body, typ, loc):
			False
		DropExpr(drop_var, value_type, release_policy, body, typ, loc):
			False
		LetExpr(name, is_mutable, typ, rhs, body):
			False
		BorrowLetExpr(name, typ, rhs, body):
			False
		SeqExpr(first, second):
			False
		WhileExpr(cond, body, typ, loc):
			False
		BreakExpr(typ, loc):
			False
		ContinueExpr(typ, loc):
			False
		ResourceScopeExpr(scope, typ, loc):
			False
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			False
		TailrecLoopExpr(params, return_type, body, loc):
			False
		TailrecRecurExpr(args, typ, loc):
			False
		TailrecListSpreadLoopExpr(loop, loc):
			False
		TailrecListSpreadRecurExpr(rebinds, cursor_advance, typ, loc):
			False
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			False
		ForChannelExpr(for_channel, typ, loc):
			False
		ForListExpr(for_list, typ, loc):
			False
		ForStringExpr(for_string, typ, loc):
			False
		ForDictExpr(for_dict, typ, loc):
			False
		ForSetExpr(for_set, typ, loc):
			False
		ForResourceSourceExpr(for_resource_source, typ, loc):
			False
		ForStreamExpr(for_stream, typ, loc):
			False
		ForTensorExpr(for_tensor, typ, loc):
			False
		PreClosureConcurrentlyLoopExpr(loop, typ, loc):
			False
		ConcurrentlyLoopExpr(loop, typ, loc):
			False
		PreClosureConcurrentExpr(block, typ, loc):
			False
		ConcurrentExpr(block, typ, loc):
			False
		SelectExpr(select_expr, typ, loc):
			False
		RangeExpr(start, end_value, typ, loc):
			False
		AccessorLiteralMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			False
		LengthMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			False
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			False
		RawMatchExpr(scrutinee, cases, typ, loc):
			False
		SemanticMatchExpr(scrutinee, tree, typ, loc):
			False
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			False
		IfExpr(cond, then_expr, else_expr, typ, loc):
			False


private pure func consumed_arg_refs_var(
	consumed_args: List[Int],
	args: List[CoreExpr],
	variable: CoreVar,
) -> Bool:
	var found: Bool = False
	var index: Int = 0

	for arg in args:
		if consumed_args.contains(index) and expr_is_var_ref(arg, variable):
			found = True
			break
		else:
			void

		index += 1

	found


private pure func call_consumes_var(
	kind: CoreCallKind,
	args: List[CoreExpr],
	variable: CoreVar,
) -> Bool:
	match kind:
		UnknownCall:
			False
		DeferredTraitCall(trait_name, method_name):
			False
		SelectedTraitCall(trait_name, method_name, module_path, def_id):
			False
		SelectedDirectCall(def_id):
			False
		UserCall(name, def_id, consumed_args):
			consumed_arg_refs_var(consumed_args, args, variable)
		ClosureCall:
			False
		ForeignCall(name, arg_passing):
			False
		BuiltinCall(name):
			False
		DirectRuntimeCall(call):
			False
		OperationResultCall(bridge):
			False
		FallibleStreamTerminalCall(bridge):
			False
		TensorParallelCall(name, layout):
			False
		DictWithCapacityCall(constructor):
			False
		ListToStringCall(callback_name):
			False
		IntrinsicCall(name):
			False


private pure func exprs_consume_var(exprs: List[CoreExpr], variable: CoreVar) -> Bool:
	var found: Bool = False

	for expr in exprs:
		if expr_consumes_var(expr, variable):
			found = True
			break
		else:
			void

	found


private pure func boxed_storage_value_consumes_var(
	value: CoreBoxedStorageValue,
	variable: CoreVar,
) -> Bool:
	expr_consumes_var(value.value, variable)


private pure func boxed_storage_values_consume_var(
	values: List[CoreBoxedStorageValue],
	variable: CoreVar,
) -> Bool:
	var found: Bool = False

	for value in values:
		if boxed_storage_value_consumes_var(value, variable):
			found = True
			break
		else:
			void

	found


private pure func tuple_element_consumes_var(element: CoreTupleElement, variable: CoreVar) -> Bool:
	match element:
		TuplePrimElement(expr):
			expr_consumes_var(expr, variable)
		TuplePointerElement(expr):
			expr_consumes_var(expr, variable)
		TupleStructElement(expr, c_type):
			expr_consumes_var(expr, variable)
		TupleStackResultElement(expr):
			expr_consumes_var(expr, variable)
		TupleVoidElement:
			False
		TupleFloatElement(expr):
			expr_consumes_var(expr, variable)
		TupleFloat32Element(expr):
			expr_consumes_var(expr, variable)
		TupleFloat16Element(expr):
			expr_consumes_var(expr, variable)


private pure func tuple_elements_consume_var(
	elements: List[CoreTupleElement],
	variable: CoreVar,
) -> Bool:
	var found: Bool = False

	for element in elements:
		if tuple_element_consumes_var(element, variable):
			found = True
			break
		else:
			void

	found


private pure func record_fields_consume_var(
	fields: List[CoreRecordFieldValue],
	variable: CoreVar,
) -> Bool:
	var found: Bool = False

	for field in fields:
		if expr_consumes_var(field.value, variable):
			found = True
			break
		else:
			void

	found


private pure func record_cow_fields_consume_var(
	fields: List[CoreRecordCowField],
	variable: CoreVar,
) -> Bool:
	var found: Bool = False

	for field in fields:
		match field.replacement:
			Some(replacement):
				if expr_consumes_var(replacement, variable):
					found = True
					break
				else:
					void
			None:
				void

	found


private pure func dict_entries_consume_var(entries: List[CoreDictEntry], variable: CoreVar) -> Bool:
	var found: Bool = False

	for entry in entries:
		if boxed_storage_value_consumes_var(entry.key, variable):
			found = True
			break
		else if boxed_storage_value_consumes_var(entry.value, variable):
			found = True
			break
		else:
			void

	found


private pure func dict_literal_entries_consume_var(
	entries: List[CoreDictLiteralEntry],
	variable: CoreVar,
) -> Bool:
	var found: Bool = False

	for entry in entries:
		if expr_consumes_var(entry.key, variable):
			found = True
			break
		else if expr_consumes_var(entry.value, variable):
			found = True
			break
		else:
			void

	found


private pure func tensor_payload_consumes_var(
	payload: CoreTensorLiteralPayload,
	variable: CoreVar,
) -> Bool:
	match payload:
		TensorRawLiteralPayload(raw):
			exprs_consume_var(raw.elements, variable)
		TensorInlineStructLiteralPayload(inline_struct):
			exprs_consume_var(inline_struct.elements, variable)


private pure func optional_expr_consumes_var(expr: Option[CoreExpr], variable: CoreVar) -> Bool:
	match expr:
		Some(found):
			expr_consumes_var(found, variable)
		None:
			False


private pure func core_type_is_void(typ: CoreType) -> Bool:
	match typ:
		VoidType:
			True
		NamedType(name, args):
			False
		TypeParameterType(name):
			False
		SelfType:
			False
		StackResultType(ok_type, err_type):
			False
		BoxedResultType(ok_type, err_type):
			False
		FunctionType(_, _, _):
			False
		EnumType(name):
			False
		ValueRecordType(name):
			False
		HeapRecordType(name):
			False
		UnionType(name):
			False
		RangeType:
			False
		TensorType(info):
			False
		TupleType(items):
			False


private pure func match_bindings_shadow_var(
	bindings: List[CoreMatchBinding],
	variable: CoreVar,
) -> Bool:
	var found: Bool = False

	for binding in bindings:
		if same_var_name(binding.variable, variable):
			found = True
			break
		else:
			void

	found


private pure func literal_match_cases_consume_var(
	cases: List[CoreLiteralMatchCase],
	variable: CoreVar,
) -> Bool:
	var found: Bool = False

	for match_case in cases:
		if match_bindings_shadow_var(match_case.bindings, variable):
			void
		else if expr_consumes_var(match_case.body, variable):
			found = True
			break
		else:
			void

	found


private pure func literal_match_fallback_consumes_var(
	fallback: CoreLiteralMatchFallback,
	variable: CoreVar,
) -> Bool:
	match fallback:
		LiteralMatchFallbackBody(body):
			expr_consumes_var(body, variable)
		LiteralMatchFallbackBindings(bindings, body):
			if match_bindings_shadow_var(bindings, variable):
				False
			else:
				expr_consumes_var(body, variable)
		LiteralMatchFallbackFail:
			False


private pure func constructor_match_body_consumes_var(
	body: CoreConstructorMatchBody,
	variable: CoreVar,
) -> Bool:
	match body:
		ConstructorMatchBodyExpr(expr):
			expr_consumes_var(expr, variable)
		ConstructorMatchBodyLiteral(literal_match):
			constructor_literal_match_consumes_var(literal_match, variable)
		ConstructorMatchBodyLength(length_match):
			constructor_length_match_consumes_var(length_match, variable)


private pure func constructor_match_cases_consume_var(
	cases: List[CoreConstructorMatchCase],
	variable: CoreVar,
) -> Bool:
	var found: Bool = False

	for match_case in cases:
		if match_bindings_shadow_var(match_case.bindings, variable):
			void
		else if constructor_match_body_consumes_var(match_case.body, variable):
			found = True
			break
		else:
			void

	found


private pure func constructor_match_fallback_consumes_var(
	fallback: CoreConstructorMatchFallback,
	variable: CoreVar,
) -> Bool:
	match fallback:
		ConstructorMatchFallbackBody(body):
			expr_consumes_var(body, variable)
		ConstructorMatchFallbackBindings(bindings, body):
			if match_bindings_shadow_var(bindings, variable):
				False
			else:
				expr_consumes_var(body, variable)
		ConstructorMatchFallbackFail:
			False


private pure func constructor_literal_match_consumes_var(
	match_expr: CoreConstructorLiteralMatch,
	variable: CoreVar,
) -> Bool:
	(
		literal_match_cases_consume_var(match_expr.cases, variable)
		or literal_match_fallback_consumes_var(match_expr.fallback, variable)
	)


private pure func constructor_length_branch_consumes_var(
	branch: CoreConstructorLengthMatchBranch,
	variable: CoreVar,
) -> Bool:
	if match_bindings_shadow_var(branch.bindings, variable):
		False
	else:
		constructor_match_body_consumes_var(branch.body, variable)


private pure func constructor_length_cases_consume_var(
	cases: List[CoreConstructorLengthMatchCase],
	variable: CoreVar,
) -> Bool:
	var found: Bool = False

	for match_case in cases:
		if constructor_length_branch_consumes_var(match_case.branch, variable):
			found = True
			break
		else:
			void

	found


private pure func constructor_length_geq_consumes_var(
	geq: Option[CoreConstructorLengthMatchGeq],
	variable: CoreVar,
) -> Bool:
	match geq:
		Some(found):
			constructor_length_branch_consumes_var(found.branch, variable)
		None:
			False


private pure func constructor_length_fallback_consumes_var(
	fallback: Option[CoreConstructorLengthMatchBranch],
	variable: CoreVar,
) -> Bool:
	match fallback:
		Some(branch):
			constructor_length_branch_consumes_var(branch, variable)
		None:
			False


private pure func constructor_length_match_consumes_var(
	match_expr: CoreConstructorLengthMatch,
	variable: CoreVar,
) -> Bool:
	(
		constructor_length_cases_consume_var(match_expr.cases, variable)
		or constructor_length_geq_consumes_var(match_expr.geq, variable)
		or constructor_length_fallback_consumes_var(match_expr.fallback, variable)
	)


private pure func select_arm_kind_consumes_var(kind: CoreSelectArmKind, variable: CoreVar) -> Bool:
	match kind:
		SelectRecvArm(recv):
			expr_consumes_var(recv.channel, variable)
		SelectSealedArm(channel):
			expr_consumes_var(channel, variable)
		SelectAfterArm(timeout):
			expr_consumes_var(timeout, variable)


private pure func select_arm_consumes_var(arm: CoreSelectArm, variable: CoreVar) -> Bool:
	if select_arm_kind_consumes_var(arm.kind, variable):
		True
	else:
		match arm.kind:
			SelectRecvArm(recv):
				if same_var_name(recv.binder, variable):
					False
				else:
					expr_consumes_var(arm.body, variable)
			SelectSealedArm(channel):
				expr_consumes_var(arm.body, variable)
			SelectAfterArm(timeout):
				expr_consumes_var(arm.body, variable)


private pure func select_arms_consume_var(arms: List[CoreSelectArm], variable: CoreVar) -> Bool:
	var found: Bool = False

	for arm in arms:
		if select_arm_consumes_var(arm, variable):
			found = True
			break
		else:
			void

	found


private pure func pre_closure_concurrent_bindings_consume_var(
	bindings: List[CorePreClosureConcurrentBinding],
	variable: CoreVar,
) -> Bool:
	var found: Bool = False

	for binding in bindings:
		if expr_consumes_var(binding.rhs, variable):
			found = True
			break
		else:
			void

	found


private pure func concurrent_bindings_consume_var(
	bindings: List[CoreConcurrentBinding],
	variable: CoreVar,
) -> Bool:
	var found: Bool = False

	for binding in bindings:
		if expr_consumes_var(binding.rhs, variable):
			found = True
			break
		else:
			void

	found


private pure func pre_closure_concurrent_bindings_shadow_var(
	bindings: List[CorePreClosureConcurrentBinding],
	variable: CoreVar,
) -> Bool:
	var found: Bool = False

	for binding in bindings:
		if same_var_name(binding.variable, variable):
			found = True
			break
		else:
			void

	found


private pure func concurrent_bindings_shadow_var(
	bindings: List[CoreConcurrentBinding],
	variable: CoreVar,
) -> Bool:
	var found: Bool = False

	for binding in bindings:
		if same_var_name(binding.variable, variable):
			found = True
			break
		else:
			void

	found


private pure func pre_closure_concurrent_consumes_var(
	bindings: List[CorePreClosureConcurrentBinding],
	body: CoreExpr,
	timeout: Option[CoreExpr],
	variable: CoreVar,
) -> Bool:
	if pre_closure_concurrent_bindings_consume_var(bindings, variable):
		True
	else if optional_expr_consumes_var(timeout, variable):
		True
	else if pre_closure_concurrent_bindings_shadow_var(bindings, variable):
		False
	else:
		expr_consumes_var(body, variable)


private pure func concurrent_consumes_var(
	bindings: List[CoreConcurrentBinding],
	body: CoreExpr,
	timeout: Option[CoreExpr],
	variable: CoreVar,
) -> Bool:
	if concurrent_bindings_consume_var(bindings, variable):
		True
	else if optional_expr_consumes_var(timeout, variable):
		True
	else if concurrent_bindings_shadow_var(bindings, variable):
		False
	else:
		expr_consumes_var(body, variable)


private pure func sequence_consumes_var(expr: CoreExpr, variable: CoreVar) -> Bool:
	var final_item: CoreExpr = expr
	var found: Bool = False

	while not found:
		match final_item:
			SeqExpr(first, second):
				if expr_consumes_var(first, variable):
					found = True
				else:
					final_item = second
			_:
				found = expr_consumes_var(final_item, variable)
				break

	found


private pure func expr_consumes_var(expr: CoreExpr, variable: CoreVar) -> Bool:
	match expr:
		DebugBlockExpr(body, typ, loc):
			expr_consumes_var(body, variable)
		CallExpr(kind, callee, args, typ, loc):
			call_consumes_var(kind, args, variable) or exprs_consume_var(args, variable)
		DropExpr(drop_var, value_type, release_policy, body, typ, loc):
			if same_var_name(drop_var, variable):
				True
			else:
				expr_consumes_var(body, variable)
		DupExpr(dup_var, value_type, retain_policy, body, typ, loc):
			expr_consumes_var(body, variable)
		LetExpr(name, is_mutable, typ, rhs, body):
			if expr_consumes_var(rhs, variable):
				True
			else if same_var_name(name, variable):
				False
			else:
				expr_consumes_var(body, variable)
		BorrowLetExpr(name, typ, rhs, body):
			if expr_consumes_var(rhs, variable):
				True
			else if same_var_name(name, variable):
				False
			else:
				expr_consumes_var(body, variable)
		SeqExpr(first, second):
			sequence_consumes_var(expr, variable)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			(
				expr_consumes_var(cond, variable)
				or expr_consumes_var(then_expr, variable)
				or expr_consumes_var(else_expr, variable)
			)
		LambdaExpr(lambda_params, lambda_return_type, lambda_body, lambda_is_pure, typ, loc):
			if add_bound_params([], lambda_params).contains(variable.name):
				False
			else:
				expr_consumes_var(lambda_body, variable)
		ListHandoffExpr(handoff, typ, loc):
			if expr_consumes_var(handoff.source, variable):
				True
			else if expr_consumes_var(handoff.capacity, variable):
				True
			else if (
				same_var_name(handoff.source_var, variable)
				or same_var_name(handoff.result_var, variable)
				or same_var_name(handoff.len_var, variable)
				or same_var_name(handoff.out_var, variable)
			):
				False
			else:
				expr_consumes_var(handoff.body, variable)
		TensorRawViewLetExpr(binding, body, typ, loc):
			if expr_consumes_var(binding.source, variable):
				True
			else if same_var_name(binding.variable, variable):
				False
			else:
				expr_consumes_var(body, variable)
		WhileExpr(cond, body, typ, loc):
			expr_consumes_var(cond, variable) or expr_consumes_var(body, variable)
		ResourceScopeExpr(scope, typ, loc):
			if expr_consumes_var(scope.acquire, variable):
				True
			else if same_var_name(scope.variable, variable):
				False
			else:
				(
					expr_consumes_var(scope.body, variable)
					or expr_consumes_var(scope.cleanup, variable)
				)
		ResourceCleanupExitExpr(exit, typ, loc):
			exprs_consume_var(exit.cleanups, variable)
		TailrecLoopExpr(params, return_type, body, loc):
			if add_bound_params([], params).contains(variable.name):
				False
			else:
				expr_consumes_var(body, variable)
		TailrecRecurExpr(args, typ, loc):
			exprs_consume_var(args, variable)
		TailrecListSpreadLoopExpr(loop, loc):
			if (
				same_var_name(loop.list_param.name, variable)
				or same_var_name(loop.cursor, variable)
			):
				False
			else:
				expr_consumes_var(loop.body, variable)
		TailrecListSpreadRecurExpr(rebinds, cursor_advance, typ, loc):
			var found: Bool = False

			for rebind in rebinds:
				if expr_consumes_var(rebind.value, variable):
					found = True
					break
				else:
					void

			found
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			if expr_consumes_var(start, variable) or expr_consumes_var(end_value, variable):
				True
			else if same_var_name(binder.variable, variable):
				False
			else:
				expr_consumes_var(body, variable)
		ForChannelExpr(for_channel, typ, loc):
			if expr_consumes_var(for_channel.iterable, variable):
				True
			else if same_var_name(for_channel.binder.variable, variable):
				False
			else:
				expr_consumes_var(for_channel.body, variable)
		ForListExpr(for_list, typ, loc):
			if expr_consumes_var(for_list.iterable, variable):
				True
			else if same_var_name(for_list.binder.variable, variable):
				False
			else:
				expr_consumes_var(for_list.body, variable)
		ForStringExpr(for_string, typ, loc):
			if expr_consumes_var(for_string.iterable, variable):
				True
			else if same_var_name(for_string.binder.variable, variable):
				False
			else:
				expr_consumes_var(for_string.body, variable)
		ForDictExpr(for_dict, typ, loc):
			if expr_consumes_var(for_dict.iterable, variable):
				True
			else if same_var_name(for_dict.binder.variable, variable):
				False
			else:
				expr_consumes_var(for_dict.body, variable)
		ForSetExpr(for_set, typ, loc):
			if expr_consumes_var(for_set.iterable, variable):
				True
			else if same_var_name(for_set.binder.variable, variable):
				False
			else:
				expr_consumes_var(for_set.body, variable)
		ForResourceSourceExpr(for_resource_source, typ, loc):
			if expr_consumes_var(for_resource_source.iterable, variable):
				True
			else if same_var_name(for_resource_source.binder.variable, variable):
				False
			else:
				expr_consumes_var(for_resource_source.body, variable)
		ForStreamExpr(for_stream, typ, loc):
			if expr_consumes_var(for_stream.iterable, variable):
				True
			else if same_var_name(for_stream.binder.variable, variable):
				False
			else:
				expr_consumes_var(for_stream.body, variable)
		ForTensorExpr(for_tensor, typ, loc):
			if expr_consumes_var(for_tensor.iterable, variable):
				True
			else if same_var_name(for_tensor.binder.variable, variable):
				False
			else:
				expr_consumes_var(for_tensor.body, variable)
		PreClosureConcurrentlyLoopExpr(loop, typ, loc):
			if expr_consumes_var(loop.iterable, variable):
				True
			else if same_var_name(loop.variable, variable):
				False
			else:
				(
					expr_consumes_var(loop.body, variable)
					or optional_expr_consumes_var(loop.timeout, variable)
					or expr_consumes_var(loop.limit, variable)
				)
		ConcurrentlyLoopExpr(loop, typ, loc):
			if expr_consumes_var(loop.iterable, variable):
				True
			else if same_var_name(loop.variable, variable):
				False
			else:
				(
					expr_consumes_var(loop.body, variable)
					or optional_expr_consumes_var(loop.timeout, variable)
					or expr_consumes_var(loop.limit, variable)
				)
		PreClosureConcurrentExpr(block, typ, loc):
			pre_closure_concurrent_consumes_var(block.bindings, block.body, block.timeout, variable)
		ConcurrentExpr(block, typ, loc):
			concurrent_consumes_var(block.bindings, block.body, block.timeout, variable)
		SelectExpr(select_expr, typ, loc):
			select_arms_consume_var(select_expr, variable)
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			(
				expr_consumes_var(scrutinee, variable)
				or literal_match_cases_consume_var(cases, variable)
				or literal_match_fallback_consumes_var(fallback, variable)
			)
		RawMatchExpr(scrutinee, cases, typ, loc):
			var found: Bool = expr_consumes_var(scrutinee, variable)

			for case in cases:
				if not found and not core_pattern_binds_name(case.pattern, variable.name):
					found = expr_consumes_var(case.body, variable)
				else:
					void

			found
		SemanticMatchExpr(scrutinee, tree, typ, loc):
			exprs_consume_var(immediate_core_expr_children(expr), variable)
		AccessorLiteralMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			(
				expr_consumes_var(scrutinee, variable)
				or constructor_literal_match_consumes_var(match_expr, variable)
			)
		LengthMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			(
				expr_consumes_var(scrutinee, variable)
				or constructor_length_match_consumes_var(match_expr, variable)
			)
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			(
				expr_consumes_var(scrutinee, variable)
				or constructor_match_cases_consume_var(cases, variable)
				or constructor_match_fallback_consumes_var(fallback, variable)
			)
		LiteralExpr(literal, typ, loc):
			False
		StaticStringLiteralExpr(id, value, typ, loc):
			False
		VarExpr(found, typ, loc):
			False
		VoidExpr(typ, loc):
			False
		CooperativeCheckpointExpr(typ, loc):
			False
		BinaryExpr(op, left, right, typ, loc):
			expr_consumes_var(left, variable) or expr_consumes_var(right, variable)
		UnaryExpr(op, expr_value, typ, loc):
			expr_consumes_var(expr_value, variable)
		LogicalExpr(op, left, right, typ, loc):
			expr_consumes_var(left, variable) or expr_consumes_var(right, variable)
		AssignExpr(assign_var, rhs, typ, loc):
			expr_consumes_var(rhs, variable)
		CastExpr(expr_value, typ, loc):
			expr_consumes_var(expr_value, variable)
		BoxExpr(box, typ, loc):
			expr_consumes_var(box.value, variable)
		UnboxExpr(unbox_kind, expr_value, typ, loc):
			expr_consumes_var(expr_value, variable)
		FieldExpr(expr_value, field_name, typ, loc):
			expr_consumes_var(expr_value, variable)
		TupleFieldExpr(expr_value, field_index, typ, loc):
			expr_consumes_var(expr_value, variable)
		TupleExpr(items, typ, loc):
			exprs_consume_var(items, variable)
		TupleConstructExpr(tuple_construct, typ, loc):
			tuple_elements_consume_var(tuple_construct.elements, variable)
		VectorExpr(items, typ, loc):
			exprs_consume_var(items, variable)
		ClosureCreateExpr(closure, typ, loc):
			False
		ListConstructExpr(construct, typ, loc):
			boxed_storage_values_consume_var(construct.elements, variable)
		ListAllocExpr(alloc, typ, loc):
			expr_consumes_var(alloc.capacity, variable)
		ListGetExpr(get, typ, loc):
			expr_consumes_var(get.list, variable) or expr_consumes_var(get.index, variable)
		ListHandoffSetOwnedExpr(set, typ, loc):
			(
				expr_consumes_var(set.list, variable)
				or expr_consumes_var(set.index, variable)
				or boxed_storage_value_consumes_var(set.value, variable)
			)
		ListHandoffSetSourceSlotExpr(slot, typ, loc):
			(
				expr_consumes_var(slot.result, variable)
				or expr_consumes_var(slot.out_index, variable)
				or expr_consumes_var(slot.source, variable)
				or expr_consumes_var(slot.source_index, variable)
			)
		ListRetainExpr(retain, typ, loc):
			(
				expr_consumes_var(retain.list, variable)
				or boxed_storage_value_consumes_var(retain.value, variable)
			)
		ListSetExpr(set, typ, loc):
			(
				expr_consumes_var(set.list, variable)
				or expr_consumes_var(set.index, variable)
				or boxed_storage_value_consumes_var(set.value, variable)
			)
		ListSwapExpr(swap, typ, loc):
			(
				expr_consumes_var(swap.list, variable)
				or expr_consumes_var(swap.left_index, variable)
				or expr_consumes_var(swap.right_index, variable)
			)
		StringByteReadExpr(read, typ, loc):
			expr_consumes_var(read.source, variable) or expr_consumes_var(read.index, variable)
		StringByteWriteExpr(write, typ, loc):
			(
				expr_consumes_var(write.target, variable)
				or expr_consumes_var(write.index, variable)
				or expr_consumes_var(write.byte, variable)
			)
		StringByteCopyExpr(copy, typ, loc):
			(
				expr_consumes_var(copy.dst, variable)
				or expr_consumes_var(copy.dst_pos, variable)
				or expr_consumes_var(copy.src, variable)
				or expr_consumes_var(copy.src_pos, variable)
				or expr_consumes_var(copy.len, variable)
			)
		StringSetLenExpr(set_len, typ, loc):
			expr_consumes_var(set_len.target, variable) or expr_consumes_var(set_len.len, variable)
		TensorLiteralExpr(literal, typ, loc):
			tensor_payload_consumes_var(literal.payload, variable)
		TensorBoxedLiteralExpr(literal, typ, loc):
			boxed_storage_values_consume_var(literal.elements, variable)
		TensorPackedLiteralExpr(literal, typ, loc):
			False
		TensorRawFillExpr(fill, typ, loc):
			expr_consumes_var(fill.value, variable) or exprs_consume_var(fill.dims, variable)
		TensorRawReadExpr(read, typ, loc):
			expr_consumes_var(read.index, variable)
		TensorRawWriteExpr(write, typ, loc):
			expr_consumes_var(write.index, variable) or expr_consumes_var(write.value, variable)
		DictExpr(entries, typ, loc):
			dict_literal_entries_consume_var(entries, variable)
		DictConstructExpr(construct, typ, loc):
			dict_entries_consume_var(construct.entries, variable)
		SetAllocExpr(alloc, typ, loc):
			False
		RecordExpr(fields, typ, loc):
			record_fields_consume_var(fields, variable)
		RecordUpdateExpr(base, fields, typ, loc):
			expr_consumes_var(base, variable) or record_fields_consume_var(fields, variable)
		RecordReuseExpr(source, fields, typ, loc):
			expr_consumes_var(source, variable) or record_fields_consume_var(fields, variable)
		RecordCowUpdateExpr(source, fields, typ, loc):
			record_cow_fields_consume_var(fields, variable) or expr_consumes_var(source, variable)
		RecordConstructExpr(type_name, fields, typ, loc):
			record_fields_consume_var(fields, variable)
		UnionConstructExpr(construct, typ, loc):
			boxed_storage_values_consume_var(construct.args, variable)
		UnionReuseConstructExpr(construct, typ, loc):
			(
				expr_consumes_var(construct.source, variable)
				or boxed_storage_values_consume_var(construct.args, variable)
			)
		PreClosureDetachExpr(detached, typ, loc):
			expr_consumes_var(detached, variable)
		DetachExpr(detached, typ, loc):
			False
		BreakExpr(typ, loc):
			False
		ContinueExpr(typ, loc):
			False
		RangeExpr(start, end_value, typ, loc):
			expr_consumes_var(start, variable) or expr_consumes_var(end_value, variable)


private pure func drop_after_body(
	variable: CoreVar,
	value_type: CoreType,
	body: CoreExpr,
	loc: CoreSourceLoc,
) -> CoreExpr:
	release_policy: CoreReleasePolicy = CoreTypePolicy.cleanup_release_policy_for_type(value_type)

	if core_type_is_void(core_expr_type(body)):
		SeqExpr(
			body,
			DropExpr(
				variable,
				value_type,
				release_policy,
				VoidExpr(VoidType, loc),
				VoidType,
				loc,
			),
		)
	else:
		result_var: CoreVar = var_from_name("__cdrop_" + variable.name)
		result_type: CoreType = core_expr_type(body)
		LetExpr(
			result_var,
			False,
			result_type,
			body,
			DropExpr(
				variable,
				value_type,
				release_policy,
				VarExpr(result_var, result_type, loc),
				result_type,
				loc,
			),
		)


private pure func balance_task_copy_capture(
	body: CoreExpr,
	capture: CoreTaskCapture,
	loc: CoreSourceLoc,
) -> CoreExpr:
	match capture.kind:
		TaskCopyCapture:
			variable: CoreVar = var_from_name(capture.name)

			if expr_consumes_var(body, variable):
				body
			else:
				drop_after_body(variable, capture.typ, body, loc)
		TaskMoveResourceItem:
			body
		TaskStructuredTaskBorrow:
			body


private pure func balance_task_copy_captures(
	captures: List[CoreTaskCapture],
	body: CoreExpr,
	loc: CoreSourceLoc,
) -> CoreExpr:
	var balanced: CoreExpr = body
	var index: Int = captures.length() - 1

	while index >= 0:
		match captures.get(index):
			Some(capture):
				balanced = balance_task_copy_capture(balanced, capture, loc)
			None:
				void

		index -= 1

	balanced


private pure func add_hoisted_function(
	state: ClosureState,
	func_info: CoreFunction,
) -> ClosureState:
	{ state | hoisted = state.hoisted.append(FunctionDecl(func_info)) }


private pure func function_target_for_var(
	facts: ClosureFacts,
	variable: CoreVar,
) -> Option[CoreFunction]:
	by_name: Option[CoreFunction] = match facts.functions_by_name.get_or(variable.name, []):
		[only]:
			Some(only)
		_:
			None

	match variable.def_id:
		Some(def_id):
			match facts.function_collisions_by_id.get(def_id):
				Some(candidates):
					var exact: Option[CoreFunction] = None

					for candidate in candidates:
						if exact.is_none() and candidate.name == variable.name:
							exact = Some(candidate)
						else:
							void

					match exact:
						Some(target):
							Some(target)
						None:
							by_name
				None:
					match facts.functions_by_id.get(def_id):
						Some(target):
							Some(target)
						None:
							by_name
		None:
			by_name


private pure func function_ref_call_kind(target: CoreFunction) -> Option[CoreCallKind]:
	match target.body:
		Some(body):
			Some(UserCall(target.name, Some(target.def_id), []))
		None:
			match target.function_kind:
				BuiltinFunction(c_name):
					Some(BuiltinCall(c_name))
				ForeignFunction(foreign_info):
					Some(ForeignCall(foreign_info.c_name, foreign_info.arg_passing))
				UserFunction | ProgramEntrypointFunction:
					None
				UnresolvedBuiltinFunction:
					None
				ClosureBodyFunction(abi):
					None


private pure func adapt_var_expr(
	facts: ClosureFacts,
	state: ClosureState,
	bound: List[String],
	expr: CoreExpr,
	variable: CoreVar,
	typ: CoreType,
	loc: CoreSourceLoc,
) -> ConvertedExpr:
	if (
		facts.mode == ConvertClosures
		or not is_closure_value_type(typ)
		or bound.contains(variable.name)
		or variable_references_definition(variable, facts.constructor_definitions)
	):
		{
			state = state,
			expr = expr
		}
	else:
		match function_target_for_var(facts, variable):
			Some(target):
				match function_ref_call_kind(target):
					Some(call_kind):
						signature: FunctionValueSignature = function_value_signature(typ, target)
						var params: List[CoreParam] = []
						var args: List[CoreExpr] = []
						var index: Int = 0

						for param_type in signature.param_types:
							param_variable: CoreVar = var_from_name(
								"__eta_arg_" + index.to_string(),
							)
							params = params.append({
								name = param_variable,
								typ = param_type,
								loc = loc,
							})
							args = args.append(VarExpr(param_variable, param_type, loc))
							index += 1

						fresh: FreshHoistedName = next_eta_name(state)
						abi: CoreClosureAbi = {
							c_name = fresh.c_name,
							params = params,
							captures = [],
							moved_captures = [],
							task_abi = False
						}
						callee: CoreExpr = VarExpr(
							{
								name = target.name,
								uniq = variable.uniq,
								def_id = Some(target.def_id)
							},
							typ,
							loc,
						)
						adapter: CoreFunction = {
							name = fresh.name,
							source_module = facts.current_module,
							type_params = [],
							params = params,
							return_type = signature.return_type,
							body = Some(
								CallExpr(
									call_kind,
									callee,
									args,
									signature.return_type,
									loc,
								),
							),
							is_pure = signature.is_pure,
							function_kind = ClosureBodyFunction(abi),
							def_id = fresh.def_id,
							loc = loc
						}
						final_state: ClosureState = add_hoisted_function(fresh.state, adapter)
						{
							state = final_state,
							expr = ClosureCreateExpr(
								{
									function_name = fresh.name,
									def_id = fresh.def_id,
									c_name = fresh.c_name,
									static_name = fresh.static_name,
									captures = []
								},
								typ,
								loc,
							)
						}
					None:
						{
							state = state,
							expr = expr
						}
			None:
				{
					state = state,
					expr = expr
				}


private pure func hoist_lambda(
	facts: ClosureFacts,
	state: ClosureState,
	capturable: List[String],
	params: List[CoreParam],
	return_type: CoreType,
	body: CoreExpr,
	is_pure: Bool,
	loc: CoreSourceLoc,
) -> HoistedClosureCreate:
	free_vars: List[FreeVar] = captures_from_body(
		facts,
		add_bound_params([], params),
		body,
	)
	captures: List[CoreClosureCapture] = closure_captures_from_free_vars(free_vars)
	fresh: FreshHoistedName = next_lambda_name(state)
	abi: CoreClosureAbi = {
		c_name = fresh.c_name,
		params = params,
		captures = captures,
		moved_captures = [],
		task_abi = False
	}
	func_info: CoreFunction = {
		name = fresh.name,
		source_module = facts.current_module,
		type_params = [],
		params = [],
		return_type = return_type,
		body = Some(body),
		is_pure = is_pure,
		function_kind = ClosureBodyFunction(abi),
		def_id = fresh.def_id,
		loc = loc
	}
	final_state: ClosureState = add_hoisted_function(fresh.state, func_info)
	{
		state = final_state,
		create = {
			function_name = fresh.name,
			def_id = fresh.def_id,
			c_name = fresh.c_name,
			static_name = fresh.static_name,
			captures = captures
		}
	}


private pure func hoist_task(
	facts: ClosureFacts,
	state: ClosureState,
	capturable: List[String],
	local_bound: List[String],
	body: CoreExpr,
	return_type: CoreType,
	captures: List[CoreTaskCapture],
	loc: CoreSourceLoc,
) -> HoistedTaskClosure:
	closure_captures: List[CoreClosureCapture] = captures.map(closure_capture_from_task_capture)
	balanced_body: CoreExpr = balance_task_copy_captures(captures, body, loc)
	fresh: FreshHoistedName = next_task_name(state)
	moved_captures: List[String] = captures.filter_map(func(capture):
		if task_capture_moves_env_slot(capture):
			Some(capture.name)
		else:
			None
	)
	abi: CoreClosureAbi = {
		c_name = fresh.c_name,
		params = [],
		captures = closure_captures,
		moved_captures = moved_captures,
		task_abi = True
	}
	func_info: CoreFunction = {
		name = fresh.name,
		source_module = facts.current_module,
		type_params = [],
		params = [],
		return_type = return_type,
		body = Some(balanced_body),
		is_pure = False,
		function_kind = ClosureBodyFunction(abi),
		def_id = fresh.def_id,
		loc = loc
	}
	final_state: ClosureState = add_hoisted_function(fresh.state, func_info)
	{
		state = final_state,
		task = {
			function_name = fresh.name,
			def_id = fresh.def_id,
			c_name = fresh.c_name,
			static_name = fresh.static_name,
			captures = captures,
			return_type = return_type
		}
	}


private pure func hoist_copy_task(
	facts: ClosureFacts,
	state: ClosureState,
	capturable: List[String],
	local_bound: List[String],
	body: CoreExpr,
	return_type: CoreType,
	loc: CoreSourceLoc,
) -> HoistedTaskClosure:
	free_vars: List[FreeVar] = captures_from_body(facts, local_bound, body)
	captures: List[CoreTaskCapture] = free_vars.map(
		func(free_var): task_capture_from_free_var(free_var, TaskCopyCapture),
	)
	hoist_task(facts, state, capturable, local_bound, body, return_type, captures, loc)


private pure func hoist_loop_task(
	facts: ClosureFacts,
	state: ClosureState,
	capturable: List[String],
	local_bound: List[String],
	loop_variable: CoreVar,
	item_mode: CoreConcurrentlyLoopItemMode,
	body: CoreExpr,
	return_type: CoreType,
	loc: CoreSourceLoc,
) -> HoistedTaskClosure:
	free_vars: List[FreeVar] = captures_from_body(facts, local_bound, body)
	captures: List[CoreTaskCapture] = task_captures_for_loop(free_vars, loop_variable, item_mode)
	hoist_task(facts, state, capturable, local_bound, body, return_type, captures, loc)


private pure func convert_optional_expr(
	facts: ClosureFacts,
	state: ClosureState,
	bound: List[String],
	expr: Option[CoreExpr],
) -> ConvertedOptionalExpr:
	match expr:
		Some(found):
			converted: ConvertedExpr = convert_expr(facts, state, bound, found)

			if same_core_expr(converted.expr, found):
				{
					state = converted.state,
					expr = expr,
					changed = False
				}
			else:
				{
					state = converted.state,
					expr = Some(converted.expr),
					changed = True
				}
		None:
			{
				state = state,
				expr = None,
				changed = False
			}


private pure func convert_exprs(
	facts: ClosureFacts,
	state: ClosureState,
	bound: List[String],
	exprs: List[CoreExpr],
) -> ConvertedExprs:
	var current: ClosureState = state
	var result: List[CoreExpr] = exprs
	var changed: Bool = False
	var index: Int = 0

	for expr in exprs:
		converted: ConvertedExpr = convert_expr(facts, current, bound, expr)
		current = converted.state

		if changed:
			result = result.append(converted.expr)
		else if not same_core_expr(converted.expr, expr):
			result = exprs
				.take(index)
				.append(converted.expr)
			changed = True

		index += 1

	{
		state = current,
		exprs = result,
		changed = changed
	}


private pure func convert_boxed_storage_value(
	facts: ClosureFacts,
	state: ClosureState,
	bound: List[String],
	value: CoreBoxedStorageValue,
) -> ConvertedBoxedStorageValue:
	converted: ConvertedExpr = convert_expr(facts, state, bound, value.value)

	if same_core_expr(converted.expr, value.value):
		{
			state = converted.state,
			value = value,
			changed = False
		}
	else:
		{
			state = converted.state,
			value = { value | value = converted.expr },
			changed = True
		}


private pure func convert_boxed_storage_values(
	facts: ClosureFacts,
	state: ClosureState,
	bound: List[String],
	values: List[CoreBoxedStorageValue],
) -> ConvertedBoxedStorageValues:
	var current: ClosureState = state
	var result: List[CoreBoxedStorageValue] = values
	var changed: Bool = False
	var index: Int = 0

	for value in values:
		converted: ConvertedBoxedStorageValue = convert_boxed_storage_value(
			facts,
			current,
			bound,
			value,
		)
		current = converted.state

		if changed:
			result = result.append(converted.value)
		else if converted.changed:
			result = values
				.take(index)
				.append(converted.value)
			changed = True

		index += 1

	{
		state = current,
		values = result,
		changed = changed
	}


private pure func converted_tuple_element(
	converted: ConvertedExpr,
	value: CoreExpr,
	element: CoreTupleElement,
	rebuilt: CoreTupleElement,
) -> ConvertedTupleElement:
	if same_core_expr(converted.expr, value):
		{
			state = converted.state,
			element = element,
			changed = False
		}
	else:
		{
			state = converted.state,
			element = rebuilt,
			changed = True
		}


private pure func convert_tuple_element(
	facts: ClosureFacts,
	state: ClosureState,
	bound: List[String],
	element: CoreTupleElement,
) -> ConvertedTupleElement:
	match element:
		TuplePrimElement(expr):
			converted: ConvertedExpr = convert_expr(facts, state, bound, expr)
			converted_tuple_element(converted, expr, element, TuplePrimElement(converted.expr))
		TuplePointerElement(expr):
			converted: ConvertedExpr = convert_expr(facts, state, bound, expr)
			converted_tuple_element(converted, expr, element, TuplePointerElement(converted.expr))
		TupleStructElement(expr, c_type):
			converted: ConvertedExpr = convert_expr(facts, state, bound, expr)
			converted_tuple_element(
				converted,
				expr,
				element,
				TupleStructElement(converted.expr, c_type),
			)
		TupleStackResultElement(expr):
			converted: ConvertedExpr = convert_expr(facts, state, bound, expr)
			converted_tuple_element(
				converted,
				expr,
				element,
				TupleStackResultElement(converted.expr),
			)
		TupleVoidElement:
			{
				state = state,
				element = element,
				changed = False
			}
		TupleFloatElement(expr):
			converted: ConvertedExpr = convert_expr(facts, state, bound, expr)
			converted_tuple_element(converted, expr, element, TupleFloatElement(converted.expr))
		TupleFloat32Element(expr):
			converted: ConvertedExpr = convert_expr(facts, state, bound, expr)
			converted_tuple_element(converted, expr, element, TupleFloat32Element(converted.expr))
		TupleFloat16Element(expr):
			converted: ConvertedExpr = convert_expr(facts, state, bound, expr)
			converted_tuple_element(converted, expr, element, TupleFloat16Element(converted.expr))


private pure func convert_tuple_elements(
	facts: ClosureFacts,
	state: ClosureState,
	bound: List[String],
	elements: List[CoreTupleElement],
) -> ConvertedTupleElements:
	var current: ClosureState = state
	var result: List[CoreTupleElement] = elements
	var changed: Bool = False
	var index: Int = 0

	for element in elements:
		converted: ConvertedTupleElement = convert_tuple_element(facts, current, bound, element)
		current = converted.state

		if changed:
			result = result.append(converted.element)
		else if converted.changed:
			result = elements
				.take(index)
				.append(converted.element)
			changed = True

		index += 1

	{
		state = current,
		elements = result,
		changed = changed
	}


private pure func convert_record_fields(
	facts: ClosureFacts,
	state: ClosureState,
	bound: List[String],
	fields: List[CoreRecordFieldValue],
) -> ConvertedRecordFields:
	var current: ClosureState = state
	var result: List[CoreRecordFieldValue] = fields
	var changed: Bool = False
	var index: Int = 0

	for field in fields:
		converted: ConvertedExpr = convert_expr(facts, current, bound, field.value)
		current = converted.state
		field_changed: Bool = not same_core_expr(converted.expr, field.value)

		converted_field: CoreRecordFieldValue = if field_changed:
			{ field | value = converted.expr }
		else:
			field

		if changed:
			result = result.append(converted_field)
		else if field_changed:
			result = fields
				.take(index)
				.append(converted_field)
			changed = True

		index += 1

	{
		state = current,
		fields = result,
		changed = changed
	}


private pure func convert_record_cow_fields(
	facts: ClosureFacts,
	state: ClosureState,
	bound: List[String],
	fields: List[CoreRecordCowField],
) -> ConvertedRecordCowFields:
	var current: ClosureState = state
	var result: List[CoreRecordCowField] = fields
	var changed: Bool = False
	var index: Int = 0

	for field in fields:
		match field.replacement:
			Some(replacement):
				converted: ConvertedExpr = convert_expr(facts, current, bound, replacement)
				current = converted.state
				field_changed: Bool = not same_core_expr(converted.expr, replacement)

				converted_field: CoreRecordCowField = if field_changed:
					{ field | replacement = Some(converted.expr) }
				else:
					field

				if changed:
					result = result.append(converted_field)
				else if field_changed:
					result = fields
						.take(index)
						.append(converted_field)
					changed = True
			None:
				if changed:
					result = result.append(field)
				else:
					void

		index += 1

	{
		state = current,
		fields = result,
		changed = changed
	}


private pure func convert_dict_entries(
	facts: ClosureFacts,
	state: ClosureState,
	bound: List[String],
	entries: List[CoreDictEntry],
) -> ConvertedDictEntries:
	var current: ClosureState = state
	var result: List[CoreDictEntry] = entries
	var changed: Bool = False
	var index: Int = 0

	for entry in entries:
		key: ConvertedBoxedStorageValue = convert_boxed_storage_value(
			facts,
			current,
			bound,
			entry.key,
		)
		value: ConvertedBoxedStorageValue = convert_boxed_storage_value(
			facts,
			key.state,
			bound,
			entry.value,
		)
		current = value.state
		entry_changed: Bool = key.changed or value.changed

		converted_entry: CoreDictEntry = if entry_changed:
			{
				key = key.value,
				value = value.value
			}
		else:
			entry

		if changed:
			result = result.append(converted_entry)
		else if entry_changed:
			result = entries
				.take(index)
				.append(converted_entry)
			changed = True

		index += 1

	{
		state = current,
		entries = result,
		changed = changed
	}


private pure func convert_dict_literal_entries(
	facts: ClosureFacts,
	state: ClosureState,
	bound: List[String],
	entries: List[CoreDictLiteralEntry],
) -> ConvertedDictLiteralEntries:
	var current: ClosureState = state
	var result: List[CoreDictLiteralEntry] = entries
	var changed: Bool = False
	var index: Int = 0

	for entry in entries:
		key: ConvertedExpr = convert_expr(facts, current, bound, entry.key)
		value: ConvertedExpr = convert_expr(facts, key.state, bound, entry.value)
		current = value.state
		entry_changed: Bool = (
			not same_core_expr(key.expr, entry.key)
			or not same_core_expr(value.expr, entry.value)
		)

		converted_entry: CoreDictLiteralEntry = if entry_changed:
			{
				key = key.expr,
				value = value.expr
			}
		else:
			entry

		if changed:
			result = result.append(converted_entry)
		else if entry_changed:
			result = entries
				.take(index)
				.append(converted_entry)
			changed = True

		index += 1

	{
		state = current,
		entries = result,
		changed = changed
	}


private pure func convert_literal_match_cases(
	facts: ClosureFacts,
	state: ClosureState,
	bound: List[String],
	cases: List[CoreLiteralMatchCase],
) -> ConvertedLiteralMatchCases:
	var current: ClosureState = state
	var result: List[CoreLiteralMatchCase] = cases
	var changed: Bool = False
	var index: Int = 0

	for match_case in cases:
		case_bound: List[String] = add_bound_match_bindings(bound, match_case.bindings)
		converted: ConvertedExpr = convert_expr(facts, current, case_bound, match_case.body)
		current = converted.state
		case_changed: Bool = not same_core_expr(converted.expr, match_case.body)

		converted_case: CoreLiteralMatchCase = if case_changed:
			{ match_case | body = converted.expr }
		else:
			match_case

		if changed:
			result = result.append(converted_case)
		else if case_changed:
			result = cases
				.take(index)
				.append(converted_case)
			changed = True

		index += 1

	{
		state = current,
		cases = result,
		changed = changed
	}


private pure func convert_literal_match_fallback(
	facts: ClosureFacts,
	state: ClosureState,
	bound: List[String],
	fallback: CoreLiteralMatchFallback,
) -> ConvertedLiteralMatchFallback:
	match fallback:
		LiteralMatchFallbackBody(body):
			converted: ConvertedExpr = convert_expr(facts, state, bound, body)

			if same_core_expr(converted.expr, body):
				{
					state = converted.state,
					fallback = fallback,
					changed = False
				}
			else:
				{
					state = converted.state,
					fallback = LiteralMatchFallbackBody(converted.expr),
					changed = True
				}
		LiteralMatchFallbackBindings(bindings, body):
			converted: ConvertedExpr = convert_expr(
				facts,
				state,
				add_bound_match_bindings(bound, bindings),
				body,
			)

			if same_core_expr(converted.expr, body):
				{
					state = converted.state,
					fallback = fallback,
					changed = False
				}
			else:
				{
					state = converted.state,
					fallback = LiteralMatchFallbackBindings(bindings, converted.expr),
					changed = True
				}
		LiteralMatchFallbackFail:
			{
				state = state,
				fallback = fallback,
				changed = False
			}


private pure func convert_constructor_match_body(
	facts: ClosureFacts,
	state: ClosureState,
	bound: List[String],
	body: CoreConstructorMatchBody,
) -> ConvertedConstructorMatchBody:
	match body:
		ConstructorMatchBodyExpr(expr):
			converted: ConvertedExpr = convert_expr(facts, state, bound, expr)

			if same_core_expr(converted.expr, expr):
				{
					state = converted.state,
					body = body,
					changed = False
				}
			else:
				{
					state = converted.state,
					body = ConstructorMatchBodyExpr(converted.expr),
					changed = True
				}
		ConstructorMatchBodyLiteral(match_expr):
			converted: ConvertedConstructorLiteralMatch = convert_constructor_literal_match(
				facts,
				state,
				bound,
				match_expr,
			)

			if converted.changed:
				{
					state = converted.state,
					body = ConstructorMatchBodyLiteral(converted.match_expr),
					changed = True
				}
			else:
				{
					state = converted.state,
					body = body,
					changed = False
				}
		ConstructorMatchBodyLength(match_expr):
			converted: ConvertedConstructorLengthMatch = convert_constructor_length_match(
				facts,
				state,
				bound,
				match_expr,
			)

			if converted.changed:
				{
					state = converted.state,
					body = ConstructorMatchBodyLength(converted.match_expr),
					changed = True
				}
			else:
				{
					state = converted.state,
					body = body,
					changed = False
				}


record ConvertedConstructorLiteralMatch {
	state: ClosureState,
	match_expr: CoreConstructorLiteralMatch,
	changed: Bool
}


record ConvertedConstructorLengthMatch {
	state: ClosureState,
	match_expr: CoreConstructorLengthMatch,
	changed: Bool
}


private pure func convert_constructor_match_cases(
	facts: ClosureFacts,
	state: ClosureState,
	bound: List[String],
	cases: List[CoreConstructorMatchCase],
) -> ConvertedConstructorMatchCases:
	var current: ClosureState = state
	var result: List[CoreConstructorMatchCase] = cases
	var changed: Bool = False
	var index: Int = 0

	for match_case in cases:
		case_bound: List[String] = add_bound_match_bindings(bound, match_case.bindings)
		converted: ConvertedConstructorMatchBody = convert_constructor_match_body(
			facts,
			current,
			case_bound,
			match_case.body,
		)
		current = converted.state

		converted_case: CoreConstructorMatchCase = if converted.changed:
			{ match_case | body = converted.body }
		else:
			match_case

		if changed:
			result = result.append(converted_case)
		else if converted.changed:
			result = cases
				.take(index)
				.append(converted_case)
			changed = True

		index += 1

	{
		state = current,
		cases = result,
		changed = changed
	}


private pure func convert_constructor_match_fallback(
	facts: ClosureFacts,
	state: ClosureState,
	bound: List[String],
	fallback: CoreConstructorMatchFallback,
) -> ConvertedConstructorMatchFallback:
	match fallback:
		ConstructorMatchFallbackBody(body):
			converted: ConvertedExpr = convert_expr(facts, state, bound, body)

			if same_core_expr(converted.expr, body):
				{
					state = converted.state,
					fallback = fallback,
					changed = False
				}
			else:
				{
					state = converted.state,
					fallback = ConstructorMatchFallbackBody(converted.expr),
					changed = True
				}
		ConstructorMatchFallbackBindings(bindings, body):
			converted: ConvertedExpr = convert_expr(
				facts,
				state,
				add_bound_match_bindings(bound, bindings),
				body,
			)

			if same_core_expr(converted.expr, body):
				{
					state = converted.state,
					fallback = fallback,
					changed = False
				}
			else:
				{
					state = converted.state,
					fallback = ConstructorMatchFallbackBindings(bindings, converted.expr),
					changed = True
				}
		ConstructorMatchFallbackFail:
			{
				state = state,
				fallback = fallback,
				changed = False
			}


private pure func convert_constructor_literal_match(
	facts: ClosureFacts,
	state: ClosureState,
	bound: List[String],
	match_expr: CoreConstructorLiteralMatch,
) -> ConvertedConstructorLiteralMatch:
	cases: ConvertedLiteralMatchCases = convert_literal_match_cases(
		facts,
		state,
		bound,
		match_expr.cases,
	)
	fallback: ConvertedLiteralMatchFallback = convert_literal_match_fallback(
		facts,
		cases.state,
		bound,
		match_expr.fallback,
	)

	if cases.changed or fallback.changed:
		{
			state = fallback.state,
			match_expr = { match_expr |
				cases = cases.cases,
				fallback = fallback.fallback
			},
			changed = True
		}
	else:
		{
			state = fallback.state,
			match_expr = match_expr,
			changed = False
		}


private pure func convert_constructor_length_branch(
	facts: ClosureFacts,
	state: ClosureState,
	bound: List[String],
	branch: CoreConstructorLengthMatchBranch,
) -> ConvertedConstructorLengthBranch:
	branch_bound: List[String] = add_bound_match_bindings(bound, branch.bindings)
	converted: ConvertedConstructorMatchBody = convert_constructor_match_body(
		facts,
		state,
		branch_bound,
		branch.body,
	)

	if converted.changed:
		{
			state = converted.state,
			branch = { branch | body = converted.body },
			changed = True
		}
	else:
		{
			state = converted.state,
			branch = branch,
			changed = False
		}


private pure func convert_constructor_length_cases(
	facts: ClosureFacts,
	state: ClosureState,
	bound: List[String],
	cases: List[CoreConstructorLengthMatchCase],
) -> ConvertedConstructorLengthCases:
	var current: ClosureState = state
	var result: List[CoreConstructorLengthMatchCase] = cases
	var changed: Bool = False
	var index: Int = 0

	for match_case in cases:
		converted: ConvertedConstructorLengthBranch = convert_constructor_length_branch(
			facts,
			current,
			bound,
			match_case.branch,
		)
		current = converted.state

		converted_case: CoreConstructorLengthMatchCase = if converted.changed:
			{ match_case | branch = converted.branch }
		else:
			match_case

		if changed:
			result = result.append(converted_case)
		else if converted.changed:
			result = cases
				.take(index)
				.append(converted_case)
			changed = True

		index += 1

	{
		state = current,
		cases = result,
		changed = changed
	}


private pure func convert_constructor_length_geq(
	facts: ClosureFacts,
	state: ClosureState,
	bound: List[String],
	geq: Option[CoreConstructorLengthMatchGeq],
) -> ConvertedConstructorLengthGeq:
	match geq:
		Some(found):
			converted: ConvertedConstructorLengthBranch = convert_constructor_length_branch(
				facts,
				state,
				bound,
				found.branch,
			)

			if converted.changed:
				{
					state = converted.state,
					geq = Some({ found | branch = converted.branch }),
					changed = True
				}
			else:
				{
					state = converted.state,
					geq = geq,
					changed = False
				}
		None:
			{
				state = state,
				geq = None,
				changed = False
			}


private pure func convert_constructor_length_fallback(
	facts: ClosureFacts,
	state: ClosureState,
	bound: List[String],
	fallback: Option[CoreConstructorLengthMatchBranch],
) -> ConvertedConstructorLengthFallback:
	match fallback:
		Some(branch):
			converted: ConvertedConstructorLengthBranch = convert_constructor_length_branch(
				facts,
				state,
				bound,
				branch,
			)

			if converted.changed:
				{
					state = converted.state,
					fallback = Some(converted.branch),
					changed = True
				}
			else:
				{
					state = converted.state,
					fallback = fallback,
					changed = False
				}
		None:
			{
				state = state,
				fallback = None,
				changed = False
			}


private pure func convert_constructor_length_match(
	facts: ClosureFacts,
	state: ClosureState,
	bound: List[String],
	match_expr: CoreConstructorLengthMatch,
) -> ConvertedConstructorLengthMatch:
	cases: ConvertedConstructorLengthCases = convert_constructor_length_cases(
		facts,
		state,
		bound,
		match_expr.cases,
	)
	geq: ConvertedConstructorLengthGeq = convert_constructor_length_geq(
		facts,
		cases.state,
		bound,
		match_expr.geq,
	)
	fallback: ConvertedConstructorLengthFallback = convert_constructor_length_fallback(
		facts,
		geq.state,
		bound,
		match_expr.fallback,
	)

	if (
		cases.changed
		or geq.changed
		or fallback.changed
	):
		{
			state = fallback.state,
			match_expr = { match_expr |
				cases = cases.cases,
				geq = geq.geq,
				fallback = fallback.fallback
			},
			changed = True
		}
	else:
		{
			state = fallback.state,
			match_expr = match_expr,
			changed = False
		}


private pure func convert_select_arm_kind(
	facts: ClosureFacts,
	state: ClosureState,
	bound: List[String],
	kind: CoreSelectArmKind,
) -> ConvertedSelectArmKind:
	match kind:
		SelectRecvArm(recv):
			converted: ConvertedExpr = convert_expr(facts, state, bound, recv.channel)

			if same_core_expr(converted.expr, recv.channel):
				{
					state = converted.state,
					kind = kind,
					changed = False
				}
			else:
				{
					state = converted.state,
					kind = SelectRecvArm({ recv | channel = converted.expr }),
					changed = True
				}
		SelectSealedArm(channel):
			converted: ConvertedExpr = convert_expr(facts, state, bound, channel)

			if same_core_expr(converted.expr, channel):
				{
					state = converted.state,
					kind = kind,
					changed = False
				}
			else:
				{
					state = converted.state,
					kind = SelectSealedArm(converted.expr),
					changed = True
				}
		SelectAfterArm(timeout):
			converted: ConvertedExpr = convert_expr(facts, state, bound, timeout)

			if same_core_expr(converted.expr, timeout):
				{
					state = converted.state,
					kind = kind,
					changed = False
				}
			else:
				{
					state = converted.state,
					kind = SelectAfterArm(converted.expr),
					changed = True
				}


private pure func convert_select_arms(
	facts: ClosureFacts,
	state: ClosureState,
	bound: List[String],
	arms: List[CoreSelectArm],
) -> ConvertedSelectArms:
	var current: ClosureState = state
	var result: List[CoreSelectArm] = arms
	var changed: Bool = False
	var index: Int = 0

	for arm in arms:
		kind: ConvertedSelectArmKind = convert_select_arm_kind(facts, current, bound, arm.kind)
		body: ConvertedExpr = convert_expr(facts, kind.state, bound, arm.body)
		current = body.state
		arm_changed: Bool = kind.changed or not same_core_expr(body.expr, arm.body)

		converted_arm: CoreSelectArm = if arm_changed:
			{ arm |
				kind = kind.kind,
				body = body.expr
			}
		else:
			arm

		if changed:
			result = result.append(converted_arm)
		else if arm_changed:
			result = arms
				.take(index)
				.append(converted_arm)
			changed = True

		index += 1

	{
		state = current,
		arms = result,
		changed = changed
	}


-- Core blocks are represented as right-associated SeqExpr chains. Convert the
-- chain iteratively so large generated programs do not consume one native stack
-- frame per statement. State remains threaded in source order because closure
-- conversion can hoist declarations while visiting any sequence item. The
-- spine is rebuilt from the tail up and every SeqExpr whose item and tail came
-- back unchanged is the original node.
private pure func convert_sequence_expr(
	facts: ClosureFacts,
	state: ClosureState,
	bound: List[String],
	expr: CoreExpr,
) -> ConvertedExpr:
	var spine_nodes: List[CoreExpr] = []
	var preceding_items: List[CoreExpr] = []
	var final_item: CoreExpr = expr

	while True:
		match final_item:
			SeqExpr(first, second):
				spine_nodes = spine_nodes.append(final_item)
				preceding_items = preceding_items.append(first)
				final_item = second
			_:
				break

	var current: ClosureState = state
	var converted_items: List[CoreExpr] = []

	for item in preceding_items:
		converted: ConvertedExpr = convert_expr(facts, current, bound, item)
		current = converted.state
		converted_items = converted_items.append(converted.expr)

	final_converted: ConvertedExpr = convert_expr(facts, current, bound, final_item)
	var converted_expr: CoreExpr = final_converted.expr
	var index: Int = converted_items.length() - 1

	while index >= 0:
		match (converted_items.get(index), spine_nodes.get(index)):
			(Some(item), Some(source_node)):
				match source_node:
					SeqExpr(source_first, source_second):
						if (
							same_core_expr(item, source_first)
							and same_core_expr(converted_expr, source_second)
						):
							converted_expr = source_node
						else:
							converted_expr = SeqExpr(item, converted_expr)
					_:
						converted_expr = SeqExpr(item, converted_expr)
			_:
				void

		index -= 1

	{
		state = final_converted.state,
		expr = converted_expr
	}


private pure func convert_call_expr(
	facts: ClosureFacts,
	state: ClosureState,
	bound: List[String],
	expr: CoreExpr,
	kind: CoreCallKind,
	callee: CoreExpr,
	args: List[CoreExpr],
	typ: CoreType,
	loc: CoreSourceLoc,
) -> ConvertedExpr:
	callee_converted: ConvertedExpr = if (
		facts.mode == AdaptFunctionRefs
		and not call_kind_uses_runtime_callee(kind)
	):
		{
			state = state,
			expr = callee
		}
	else:
		convert_expr(facts, state, bound, callee)

	args_converted: ConvertedExprs = convert_exprs(facts, callee_converted.state, bound, args)

	if same_core_expr(callee_converted.expr, callee) and not args_converted.changed:
		{
			state = args_converted.state,
			expr = expr
		}
	else:
		{
			state = args_converted.state,
			expr = CallExpr(kind, callee_converted.expr, args_converted.exprs, typ, loc)
		}


private pure func convert_logical_expr(
	facts: ClosureFacts,
	state: ClosureState,
	bound: List[String],
	expr: CoreExpr,
) -> ConvertedExpr:
	var current: ClosureState = state
	var tasks: List[ClosureLogicalTask] = [ConvertClosureLogicalNode(expr)]
	var task_count: Int = 1
	var converted: List[CoreExpr] = []
	var converted_count: Int = 0
	var valid: Bool = True

	while valid and task_count > 0:
		task_count -= 1

		match tasks.get(task_count):
			Some(task):
				match task:
					ConvertClosureLogicalNode(current_expr):
						match current_expr:
							LogicalExpr(op, left, right, typ, loc):
								continuation: ClosureLogicalTask = ContinueClosureLogicalAfterLeft(
									current_expr,
								)

								tasks = if task_count < tasks.length():
									tasks.set(task_count, continuation)
								else:
									tasks.append(continuation)

								task_count += 1

								left_task: ClosureLogicalTask = ConvertClosureLogicalNode(left)

								tasks = if task_count < tasks.length():
									tasks.set(task_count, left_task)
								else:
									tasks.append(left_task)

								task_count += 1
							_:
								converted_expr: ConvertedExpr = convert_expr(
									facts,
									current,
									bound,
									current_expr,
								)
								current = converted_expr.state

								converted = if converted_count < converted.length():
									converted.set(converted_count, converted_expr.expr)
								else:
									converted.append(converted_expr.expr)

								converted_count += 1
					ContinueClosureLogicalAfterLeft(source_expr):
						match (converted.get(converted_count - 1), source_expr):
							(Some(left), LogicalExpr(op, source_left, right, typ, loc)):
								converted_count -= 1
								rebuild_task: ClosureLogicalTask = RebuildClosureLogicalNode(
									source_expr,
									left,
								)

								tasks = if task_count < tasks.length():
									tasks.set(task_count, rebuild_task)
								else:
									tasks.append(rebuild_task)

								task_count += 1

								right_task: ClosureLogicalTask = ConvertClosureLogicalNode(right)

								tasks = if task_count < tasks.length():
									tasks.set(task_count, right_task)
								else:
									tasks.append(right_task)

								task_count += 1
							_:
								valid = False
					RebuildClosureLogicalNode(source_expr, left):
						match (converted.get(converted_count - 1), source_expr):
							(Some(right), LogicalExpr(op, source_left, source_right, typ, loc)):
								converted_count -= 1

								rebuilt: CoreExpr = if (
									same_core_expr(left, source_left)
									and same_core_expr(right, source_right)
								):
									source_expr
								else:
									LogicalExpr(op, left, right, typ, loc)

								converted = if converted_count < converted.length():
									converted.set(converted_count, rebuilt)
								else:
									converted.append(rebuilt)

								converted_count += 1
							_:
								valid = False
			None:
				valid = False

	if valid and converted_count == 1:
		{
			state = current,
			expr = converted.get_or(0, expr)
		}
	else:
		{
			state = state,
			expr = expr
		}


private pure func convert_let_expr(
	facts: ClosureFacts,
	state: ClosureState,
	bound: List[String],
	expr: CoreExpr,
	variable: CoreVar,
	is_mutable: Bool,
	var_type: CoreType,
	rhs: CoreExpr,
	body: CoreExpr,
) -> ConvertedExpr:
	rhs_converted: ConvertedExpr = convert_expr(facts, state, bound, rhs)
	body_bound: List[String] = add_bound_var(bound, variable)
	body_converted: ConvertedExpr = convert_expr(facts, rhs_converted.state, body_bound, body)

	if same_core_expr(rhs_converted.expr, rhs) and same_core_expr(body_converted.expr, body):
		{
			state = body_converted.state,
			expr = expr
		}
	else:
		{
			state = body_converted.state,
			expr = LetExpr(variable, is_mutable, var_type, rhs_converted.expr, body_converted.expr)
		}


private pure func convert_borrow_let_expr(
	facts: ClosureFacts,
	state: ClosureState,
	bound: List[String],
	expr: CoreExpr,
	variable: CoreVar,
	var_type: CoreType,
	rhs: CoreExpr,
	body: CoreExpr,
) -> ConvertedExpr:
	rhs_converted: ConvertedExpr = convert_expr(facts, state, bound, rhs)
	body_bound: List[String] = add_bound_var(bound, variable)
	body_converted: ConvertedExpr = convert_expr(facts, rhs_converted.state, body_bound, body)

	if same_core_expr(rhs_converted.expr, rhs) and same_core_expr(body_converted.expr, body):
		{
			state = body_converted.state,
			expr = expr
		}
	else:
		{
			state = body_converted.state,
			expr = BorrowLetExpr(variable, var_type, rhs_converted.expr, body_converted.expr)
		}


private pure func convert_literal_match_expr(
	facts: ClosureFacts,
	state: ClosureState,
	bound: List[String],
	expr: CoreExpr,
	scrutinee: CoreExpr,
	cases: List[CoreLiteralMatchCase],
	fallback: CoreLiteralMatchFallback,
	typ: CoreType,
	loc: CoreSourceLoc,
) -> ConvertedExpr:
	scrutinee_converted: ConvertedExpr = convert_expr(facts, state, bound, scrutinee)
	cases_converted: ConvertedLiteralMatchCases = convert_literal_match_cases(
		facts,
		scrutinee_converted.state,
		bound,
		cases,
	)
	fallback_converted: ConvertedLiteralMatchFallback = convert_literal_match_fallback(
		facts,
		cases_converted.state,
		bound,
		fallback,
	)

	if (
		same_core_expr(scrutinee_converted.expr, scrutinee)
		and not cases_converted.changed
		and not fallback_converted.changed
	):
		{
			state = fallback_converted.state,
			expr = expr
		}
	else:
		{
			state = fallback_converted.state,
			expr = LiteralMatchExpr(
				scrutinee_converted.expr,
				cases_converted.cases,
				fallback_converted.fallback,
				typ,
				loc,
			)
		}


private pure func convert_raw_match_cases(
	facts: ClosureFacts,
	state: ClosureState,
	bound: List[String],
	cases: List[CoreRawMatchCase],
) -> ConvertedRawMatchCases:
	var current: ClosureState = state
	var result: List[CoreRawMatchCase] = cases
	var changed: Bool = False
	var index: Int = 0

	for case in cases:
		case_bound: List[String] = bound
			.concat(core_pattern_bound_names(case.pattern))
			.unique()
		converted: ConvertedExpr = convert_expr(facts, current, case_bound, case.body)
		current = converted.state
		case_changed: Bool = not same_core_expr(converted.expr, case.body)

		converted_case: CoreRawMatchCase = if case_changed:
			{ case | body = converted.expr }
		else:
			case

		if changed:
			result = result.append(converted_case)
		else if case_changed:
			result = cases
				.take(index)
				.append(converted_case)
			changed = True

		index += 1

	{
		state = current,
		cases = result,
		changed = changed
	}


private pure func convert_raw_match_expr(
	facts: ClosureFacts,
	state: ClosureState,
	bound: List[String],
	expr: CoreExpr,
	scrutinee: CoreExpr,
	cases: List[CoreRawMatchCase],
	typ: CoreType,
	loc: CoreSourceLoc,
) -> ConvertedExpr:
	scrutinee_converted: ConvertedExpr = convert_expr(facts, state, bound, scrutinee)
	cases_converted: ConvertedRawMatchCases = convert_raw_match_cases(
		facts,
		scrutinee_converted.state,
		bound,
		cases,
	)

	if same_core_expr(scrutinee_converted.expr, scrutinee) and not cases_converted.changed:
		{
			state = cases_converted.state,
			expr = expr
		}
	else:
		{
			state = cases_converted.state,
			expr = RawMatchExpr(scrutinee_converted.expr, cases_converted.cases, typ, loc)
		}


private pure func convert_accessor_literal_match_expr(
	facts: ClosureFacts,
	state: ClosureState,
	bound: List[String],
	expr: CoreExpr,
	scrutinee: CoreExpr,
	release_policy: CoreReleasePolicy,
	match_expr: CoreConstructorLiteralMatch,
	typ: CoreType,
	loc: CoreSourceLoc,
) -> ConvertedExpr:
	scrutinee_converted: ConvertedExpr = convert_expr(facts, state, bound, scrutinee)
	match_converted: ConvertedConstructorLiteralMatch = convert_constructor_literal_match(
		facts,
		scrutinee_converted.state,
		bound,
		match_expr,
	)

	if same_core_expr(scrutinee_converted.expr, scrutinee) and not match_converted.changed:
		{
			state = match_converted.state,
			expr = expr
		}
	else:
		{
			state = match_converted.state,
			expr = AccessorLiteralMatchExpr(
				scrutinee_converted.expr,
				release_policy,
				match_converted.match_expr,
				typ,
				loc,
			)
		}


private pure func add_bound_semantic_match_bindings(
	bound: List[String],
	bindings: List[CoreSemanticMatchBinding],
) -> List[String]:
	var result: List[String] = bound

	for binding in bindings:
		result = add_bound_var(result, binding.variable)

	result


private pure func convert_optional_semantic_match_tree(
	facts: ClosureFacts,
	state: ClosureState,
	bound: List[String],
	tree: Option[CoreSemanticMatchTree],
) -> ConvertedOptionalSemanticMatchTree:
	match tree:
		Some(value):
			converted: ConvertedSemanticMatchTree = convert_semantic_match_tree(
				facts,
				state,
				bound,
				value,
			)

			if converted.changed:
				{
					state = converted.state,
					tree = Some(converted.tree),
					changed = True
				}
			else:
				{
					state = converted.state,
					tree = tree,
					changed = False
				}
		None:
			{
				state = state,
				tree = None,
				changed = False
			}


private pure func convert_semantic_constructor_cases(
	facts: ClosureFacts,
	state: ClosureState,
	bound: List[String],
	cases: List[CoreSemanticConstructorMatchCase],
) -> (ClosureState, List[CoreSemanticConstructorMatchCase], Bool):
	var current: ClosureState = state
	var result: List[CoreSemanticConstructorMatchCase] = cases
	var changed: Bool = False
	var index: Int = 0

	for match_case in cases:
		converted: ConvertedSemanticMatchTree = convert_semantic_match_tree(
			facts,
			current,
			bound,
			match_case.body,
		)
		current = converted.state

		converted_case: CoreSemanticConstructorMatchCase = if converted.changed:
			{ match_case | body = converted.tree }
		else:
			match_case

		if changed:
			result = result.append(converted_case)
		else if converted.changed:
			result = cases
				.take(index)
				.append(converted_case)
			changed = True

		index += 1

	(current, result, changed)


private pure func convert_semantic_literal_cases(
	facts: ClosureFacts,
	state: ClosureState,
	bound: List[String],
	cases: List[CoreSemanticLiteralMatchCase],
) -> (ClosureState, List[CoreSemanticLiteralMatchCase], Bool):
	var current: ClosureState = state
	var result: List[CoreSemanticLiteralMatchCase] = cases
	var changed: Bool = False
	var index: Int = 0

	for match_case in cases:
		converted: ConvertedSemanticMatchTree = convert_semantic_match_tree(
			facts,
			current,
			bound,
			match_case.body,
		)
		current = converted.state

		converted_case: CoreSemanticLiteralMatchCase = if converted.changed:
			{ match_case | body = converted.tree }
		else:
			match_case

		if changed:
			result = result.append(converted_case)
		else if converted.changed:
			result = cases
				.take(index)
				.append(converted_case)
			changed = True

		index += 1

	(current, result, changed)


private pure func convert_semantic_length_cases(
	facts: ClosureFacts,
	state: ClosureState,
	bound: List[String],
	cases: List[CoreSemanticLengthMatchCase],
) -> (ClosureState, List[CoreSemanticLengthMatchCase], Bool):
	var current: ClosureState = state
	var result: List[CoreSemanticLengthMatchCase] = cases
	var changed: Bool = False
	var index: Int = 0

	for match_case in cases:
		converted: ConvertedSemanticMatchTree = convert_semantic_match_tree(
			facts,
			current,
			bound,
			match_case.body,
		)
		current = converted.state

		converted_case: CoreSemanticLengthMatchCase = if converted.changed:
			{ match_case | body = converted.tree }
		else:
			match_case

		if changed:
			result = result.append(converted_case)
		else if converted.changed:
			result = cases
				.take(index)
				.append(converted_case)
			changed = True

		index += 1

	(current, result, changed)


private pure func convert_optional_semantic_length_geq(
	facts: ClosureFacts,
	state: ClosureState,
	bound: List[String],
	geq: Option[CoreSemanticLengthMatchGeq],
) -> ConvertedOptionalSemanticLengthGeq:
	match geq:
		Some(value):
			converted: ConvertedSemanticMatchTree = convert_semantic_match_tree(
				facts,
				state,
				bound,
				value.body,
			)

			if converted.changed:
				{
					state = converted.state,
					geq = Some({ value | body = converted.tree }),
					changed = True
				}
			else:
				{
					state = converted.state,
					geq = geq,
					changed = False
				}
		None:
			{
				state = state,
				geq = None,
				changed = False
			}


private pure func convert_semantic_match_tree(
	facts: ClosureFacts,
	state: ClosureState,
	bound: List[String],
	tree: CoreSemanticMatchTree,
) -> ConvertedSemanticMatchTree:
	match tree:
		SemanticMatchLeaf(bindings, body):
			converted: ConvertedExpr = convert_expr(
				facts,
				state,
				add_bound_semantic_match_bindings(bound, bindings),
				body,
			)

			if same_core_expr(converted.expr, body):
				{
					state = converted.state,
					tree = tree,
					changed = False
				}
			else:
				{
					state = converted.state,
					tree = SemanticMatchLeaf(bindings, converted.expr),
					changed = True
				}
		SemanticMatchFail:
			{
				state = state,
				tree = tree,
				changed = False
			}
		SemanticConstructorMatch(accessor, cases, fallback):
			(cases_state, converted_cases, cases_changed) = convert_semantic_constructor_cases(
				facts,
				state,
				bound,
				cases,
			)
			converted_fallback: ConvertedOptionalSemanticMatchTree = convert_optional_semantic_match_tree(
				facts,
				cases_state,
				bound,
				fallback,
			)

			if cases_changed or converted_fallback.changed:
				{
					state = converted_fallback.state,
					tree = SemanticConstructorMatch(
						accessor,
						converted_cases,
						converted_fallback.tree,
					),
					changed = True
				}
			else:
				{
					state = converted_fallback.state,
					tree = tree,
					changed = False
				}
		SemanticLiteralMatch(accessor, cases, fallback):
			(cases_state, converted_cases, cases_changed) = convert_semantic_literal_cases(
				facts,
				state,
				bound,
				cases,
			)
			converted_fallback: ConvertedSemanticMatchTree = convert_semantic_match_tree(
				facts,
				cases_state,
				bound,
				fallback,
			)

			if cases_changed or converted_fallback.changed:
				{
					state = converted_fallback.state,
					tree = SemanticLiteralMatch(accessor, converted_cases, converted_fallback.tree),
					changed = True
				}
			else:
				{
					state = converted_fallback.state,
					tree = tree,
					changed = False
				}
		SemanticLengthMatch(accessor, cases, geq, fallback):
			(cases_state, converted_cases, cases_changed) = convert_semantic_length_cases(
				facts,
				state,
				bound,
				cases,
			)
			converted_geq: ConvertedOptionalSemanticLengthGeq = convert_optional_semantic_length_geq(
				facts,
				cases_state,
				bound,
				geq,
			)
			converted_fallback: ConvertedOptionalSemanticMatchTree = convert_optional_semantic_match_tree(
				facts,
				converted_geq.state,
				bound,
				fallback,
			)

			if (
				cases_changed
				or converted_geq.changed
				or converted_fallback.changed
			):
				{
					state = converted_fallback.state,
					tree = SemanticLengthMatch(
						accessor,
						converted_cases,
						converted_geq.geq,
						converted_fallback.tree,
					),
					changed = True
				}
			else:
				{
					state = converted_fallback.state,
					tree = tree,
					changed = False
				}


private pure func convert_semantic_match_expr(
	facts: ClosureFacts,
	state: ClosureState,
	bound: List[String],
	expr: CoreExpr,
	scrutinee: CoreExpr,
	tree: CoreSemanticMatchTree,
	typ: CoreType,
	loc: CoreSourceLoc,
) -> ConvertedExpr:
	scrutinee_converted: ConvertedExpr = convert_expr(facts, state, bound, scrutinee)
	tree_converted: ConvertedSemanticMatchTree = convert_semantic_match_tree(
		facts,
		scrutinee_converted.state,
		bound,
		tree,
	)

	if same_core_expr(scrutinee_converted.expr, scrutinee) and not tree_converted.changed:
		{
			state = tree_converted.state,
			expr = expr
		}
	else:
		{
			state = tree_converted.state,
			expr = SemanticMatchExpr(scrutinee_converted.expr, tree_converted.tree, typ, loc)
		}


private pure func convert_length_match_expr(
	facts: ClosureFacts,
	state: ClosureState,
	bound: List[String],
	expr: CoreExpr,
	scrutinee: CoreExpr,
	release_policy: CoreReleasePolicy,
	match_expr: CoreConstructorLengthMatch,
	typ: CoreType,
	loc: CoreSourceLoc,
) -> ConvertedExpr:
	scrutinee_converted: ConvertedExpr = convert_expr(facts, state, bound, scrutinee)
	match_converted: ConvertedConstructorLengthMatch = convert_constructor_length_match(
		facts,
		scrutinee_converted.state,
		bound,
		match_expr,
	)

	if same_core_expr(scrutinee_converted.expr, scrutinee) and not match_converted.changed:
		{
			state = match_converted.state,
			expr = expr
		}
	else:
		{
			state = match_converted.state,
			expr = LengthMatchExpr(
				scrutinee_converted.expr,
				release_policy,
				match_converted.match_expr,
				typ,
				loc,
			)
		}


private pure func convert_constructor_match_expr(
	facts: ClosureFacts,
	state: ClosureState,
	bound: List[String],
	expr: CoreExpr,
	scrutinee: CoreExpr,
	release_policy: CoreReleasePolicy,
	cases: List[CoreConstructorMatchCase],
	fallback: CoreConstructorMatchFallback,
	typ: CoreType,
	loc: CoreSourceLoc,
) -> ConvertedExpr:
	scrutinee_converted: ConvertedExpr = convert_expr(facts, state, bound, scrutinee)
	cases_converted: ConvertedConstructorMatchCases = convert_constructor_match_cases(
		facts,
		scrutinee_converted.state,
		bound,
		cases,
	)
	fallback_converted: ConvertedConstructorMatchFallback = convert_constructor_match_fallback(
		facts,
		cases_converted.state,
		bound,
		fallback,
	)

	if (
		same_core_expr(scrutinee_converted.expr, scrutinee)
		and not cases_converted.changed
		and not fallback_converted.changed
	):
		{
			state = fallback_converted.state,
			expr = expr
		}
	else:
		{
			state = fallback_converted.state,
			expr = ConstructorMatchExpr(
				scrutinee_converted.expr,
				release_policy,
				cases_converted.cases,
				fallback_converted.fallback,
				typ,
				loc,
			)
		}


private pure func convert_if_expr(
	facts: ClosureFacts,
	state: ClosureState,
	bound: List[String],
	expr: CoreExpr,
	cond: CoreExpr,
	then_expr: CoreExpr,
	else_expr: CoreExpr,
	typ: CoreType,
	loc: CoreSourceLoc,
) -> ConvertedExpr:
	cond_converted: ConvertedExpr = convert_expr(facts, state, bound, cond)
	then_converted: ConvertedExpr = convert_expr(facts, cond_converted.state, bound, then_expr)
	else_converted: ConvertedExpr = convert_expr(facts, then_converted.state, bound, else_expr)

	if (
		same_core_expr(cond_converted.expr, cond)
		and same_core_expr(then_converted.expr, then_expr)
		and same_core_expr(else_converted.expr, else_expr)
	):
		{
			state = else_converted.state,
			expr = expr
		}
	else:
		{
			state = else_converted.state,
			expr = IfExpr(cond_converted.expr, then_converted.expr, else_converted.expr, typ, loc)
		}


-- Every arm converts its children exactly as it always has and answers `expr`
-- itself when every converted child and child container came back as the same
-- allocation; only genuine rewrites (adapted function references, hoisted
-- lambdas and tasks) build new nodes.
--
-- This dispatcher binds nothing and forwards to one small arm group, so a deep
-- Core tree costs a shallow native frame per level: one exhaustive match over
-- every constructor reserves stack for all of its arms' locals at once and can
-- exhaust the default stack at -O0 before conversion reaches a leaf. The
-- sequence, logical, binding, call, match, and `if` spines keep their own
-- converters so the common recursive shapes stay out of any large frame.
private pure func convert_expr(
	facts: ClosureFacts,
	state: ClosureState,
	bound: List[String],
	expr: CoreExpr,
) -> ConvertedExpr:
	match expr:
		LiteralExpr(_, _, _) | StaticStringLiteralExpr(_, _, _, _) | VarExpr(_, _, _) | VoidExpr(_, _) | CooperativeCheckpointExpr(_, _) | BreakExpr(_, _) | ContinueExpr(_, _) | SetAllocExpr(_, _, _) | ClosureCreateExpr(_, _, _) | DetachExpr(_, _, _):
			convert_leaf_expr(facts, state, bound, expr)
		DebugBlockExpr(_, _, _) | BinaryExpr(_, _, _, _, _) | UnaryExpr(_, _, _, _) | LogicalExpr(_, _, _, _, _) | AssignExpr(_, _, _, _) | CastExpr(_, _, _) | UnboxExpr(_, _, _, _) | FieldExpr(_, _, _, _) | TupleFieldExpr(_, _, _, _) | BoxExpr(_, _, _) | PreClosureDetachExpr(_, _, _) | DupExpr(_, _, _, _, _, _) | DropExpr(_, _, _, _, _, _) | LetExpr(_, _, _, _, _) | BorrowLetExpr(_, _, _, _) | SeqExpr(_, _) | WhileExpr(_, _, _, _) | RangeExpr(_, _, _, _) | IfExpr(_, _, _, _, _):
			convert_operator_expr(facts, state, bound, expr)
		CallExpr(_, _, _, _, _) | TupleExpr(_, _, _) | TupleConstructExpr(_, _, _) | VectorExpr(_, _, _) | ListConstructExpr(_, _, _) | DictExpr(_, _, _) | DictConstructExpr(_, _, _) | RecordExpr(_, _, _) | RecordUpdateExpr(_, _, _, _) | RecordReuseExpr(_, _, _, _) | RecordCowUpdateExpr(_, _, _, _) | RecordConstructExpr(_, _, _, _) | UnionConstructExpr(_, _, _) | UnionReuseConstructExpr(_, _, _) | SelectExpr(_, _, _):
			convert_aggregate_expr(facts, state, bound, expr)
		ListAllocExpr(_, _, _) | ListGetExpr(_, _, _) | ListHandoffExpr(_, _, _) | ListHandoffSetOwnedExpr(_, _, _) | ListHandoffSetSourceSlotExpr(_, _, _) | ListRetainExpr(_, _, _) | ListSetExpr(_, _, _) | ListSwapExpr(_, _, _) | StringByteReadExpr(_, _, _) | StringByteWriteExpr(_, _, _) | StringByteCopyExpr(_, _, _) | StringSetLenExpr(_, _, _) | TensorLiteralExpr(_, _, _) | TensorBoxedLiteralExpr(_, _, _) | TensorPackedLiteralExpr(_, _, _) | TensorRawFillExpr(_, _, _) | TensorRawReadExpr(_, _, _) | TensorRawWriteExpr(_, _, _) | TensorRawViewLetExpr(_, _, _, _):
			convert_storage_expr(facts, state, bound, expr)
		LambdaExpr(_, _, _, _, _, _) | TailrecLoopExpr(_, _, _, _) | TailrecRecurExpr(_, _, _) | TailrecListSpreadLoopExpr(_, _) | TailrecListSpreadRecurExpr(_, _, _, _) | ForRangeExpr(_, _, _, _, _, _) | ForChannelExpr(_, _, _) | ForListExpr(_, _, _) | ForStringExpr(_, _, _) | ForDictExpr(_, _, _) | ForSetExpr(_, _, _) | ForStreamExpr(_, _, _) | ForResourceSourceExpr(_, _, _) | ForTensorExpr(_, _, _) | ResourceScopeExpr(_, _, _) | ResourceCleanupExitExpr(_, _, _):
			convert_loop_expr(facts, state, bound, expr)
		PreClosureConcurrentlyLoopExpr(_, _, _) | ConcurrentlyLoopExpr(_, _, _) | PreClosureConcurrentExpr(_, _, _) | ConcurrentExpr(_, _, _):
			convert_concurrency_expr(facts, state, bound, expr)
		RawMatchExpr(_, _, _, _) | SemanticMatchExpr(_, _, _, _) | LiteralMatchExpr(_, _, _, _, _) | AccessorLiteralMatchExpr(_, _, _, _, _) | LengthMatchExpr(_, _, _, _, _) | ConstructorMatchExpr(_, _, _, _, _, _):
			convert_match_expr(facts, state, bound, expr)


-- One converted child whose node is rebuilt only when that child changed.
private pure func converted_with_child(
	converted: ConvertedExpr,
	child: CoreExpr,
	expr: CoreExpr,
	rebuilt: CoreExpr,
) -> ConvertedExpr:
	if same_core_expr(converted.expr, child):
		{
			state = converted.state,
			expr = expr
		}
	else:
		{
			state = converted.state,
			expr = rebuilt
		}


-- Leaves and nodes conversion never looks inside. A bare function reference
-- may still become an eta closure.
private pure func convert_leaf_expr(
	facts: ClosureFacts,
	state: ClosureState,
	bound: List[String],
	expr: CoreExpr,
) -> ConvertedExpr:
	match expr:
		VarExpr(variable, typ, loc):
			adapt_var_expr(facts, state, bound, expr, variable, typ, loc)
		_:
			{
				state = state,
				expr = expr
			}


-- Operators, casts, field reads, and the simple binding and control forms.
private pure func convert_operator_expr(
	facts: ClosureFacts,
	state: ClosureState,
	bound: List[String],
	expr: CoreExpr,
) -> ConvertedExpr:
	match expr:
		DebugBlockExpr(body, typ, loc):
			converted: ConvertedExpr = convert_expr(facts, state, bound, body)
			converted_with_child(
				converted,
				body,
				expr,
				DebugBlockExpr(converted.expr, typ, loc),
			)
		BinaryExpr(op, left, right, typ, loc):
			left_converted: ConvertedExpr = convert_expr(facts, state, bound, left)
			right_converted: ConvertedExpr = convert_expr(facts, left_converted.state, bound, right)

			if (
				same_core_expr(left_converted.expr, left)
				and same_core_expr(right_converted.expr, right)
			):
				{
					state = right_converted.state,
					expr = expr
				}
			else:
				{
					state = right_converted.state,
					expr = BinaryExpr(op, left_converted.expr, right_converted.expr, typ, loc)
				}
		UnaryExpr(op, expr_value, typ, loc):
			converted: ConvertedExpr = convert_expr(facts, state, bound, expr_value)
			converted_with_child(
				converted,
				expr_value,
				expr,
				UnaryExpr(op, converted.expr, typ, loc),
			)
		LogicalExpr(op, left, right, typ, loc):
			convert_logical_expr(facts, state, bound, expr)
		AssignExpr(variable, rhs, typ, loc):
			converted: ConvertedExpr = convert_expr(facts, state, bound, rhs)
			converted_with_child(
				converted,
				rhs,
				expr,
				AssignExpr(variable, converted.expr, typ, loc),
			)
		CastExpr(expr_value, typ, loc):
			converted: ConvertedExpr = convert_expr(facts, state, bound, expr_value)
			converted_with_child(
				converted,
				expr_value,
				expr,
				CastExpr(converted.expr, typ, loc),
			)
		UnboxExpr(unbox_kind, expr_value, typ, loc):
			converted: ConvertedExpr = convert_expr(facts, state, bound, expr_value)
			converted_with_child(
				converted,
				expr_value,
				expr,
				UnboxExpr(unbox_kind, converted.expr, typ, loc),
			)
		FieldExpr(expr_value, field_name, typ, loc):
			converted: ConvertedExpr = convert_expr(facts, state, bound, expr_value)
			converted_with_child(
				converted,
				expr_value,
				expr,
				FieldExpr(converted.expr, field_name, typ, loc),
			)
		TupleFieldExpr(expr_value, field_index, typ, loc):
			converted: ConvertedExpr = convert_expr(facts, state, bound, expr_value)
			converted_with_child(
				converted,
				expr_value,
				expr,
				TupleFieldExpr(converted.expr, field_index, typ, loc),
			)
		BoxExpr(box, typ, loc):
			converted: ConvertedExpr = convert_expr(facts, state, bound, box.value)
			converted_with_child(
				converted,
				box.value,
				expr,
				BoxExpr({ box | value = converted.expr }, typ, loc),
			)
		PreClosureDetachExpr(detached, typ, loc):
			body: ConvertedExpr = convert_expr(facts, state, bound, detached)

			if facts.mode == AdaptFunctionRefs:
				converted_with_child(
					body,
					detached,
					expr,
					PreClosureDetachExpr(body.expr, typ, loc),
				)
			else:
				task: HoistedTaskClosure = hoist_copy_task(
					facts,
					body.state,
					bound,
					[],
					body.expr,
					VOID_TYPE,
					loc,
				)
				{
					state = task.state,
					expr = DetachExpr(task.task, typ, loc)
				}
		DupExpr(variable, var_type, retain_policy, body, typ, loc):
			body_converted: ConvertedExpr = convert_expr(facts, state, bound, body)
			converted_with_child(
				body_converted,
				body,
				expr,
				DupExpr(variable, var_type, retain_policy, body_converted.expr, typ, loc),
			)
		DropExpr(variable, var_type, release_policy, body, typ, loc):
			body_converted: ConvertedExpr = convert_expr(facts, state, bound, body)
			converted_with_child(
				body_converted,
				body,
				expr,
				DropExpr(variable, var_type, release_policy, body_converted.expr, typ, loc),
			)
		LetExpr(variable, is_mutable, var_type, rhs, body):
			convert_let_expr(facts, state, bound, expr, variable, is_mutable, var_type, rhs, body)
		BorrowLetExpr(variable, var_type, rhs, body):
			convert_borrow_let_expr(facts, state, bound, expr, variable, var_type, rhs, body)
		SeqExpr(first, second):
			convert_sequence_expr(facts, state, bound, expr)
		WhileExpr(cond, body, typ, loc):
			cond_converted: ConvertedExpr = convert_expr(facts, state, bound, cond)
			body_converted: ConvertedExpr = convert_expr(facts, cond_converted.state, bound, body)

			if (
				same_core_expr(cond_converted.expr, cond)
				and same_core_expr(body_converted.expr, body)
			):
				{
					state = body_converted.state,
					expr = expr
				}
			else:
				{
					state = body_converted.state,
					expr = WhileExpr(cond_converted.expr, body_converted.expr, typ, loc)
				}
		RangeExpr(start, end_value, typ, loc):
			start_converted: ConvertedExpr = convert_expr(facts, state, bound, start)
			end_converted: ConvertedExpr = convert_expr(
				facts,
				start_converted.state,
				bound,
				end_value,
			)

			if (
				same_core_expr(start_converted.expr, start)
				and same_core_expr(end_converted.expr, end_value)
			):
				{
					state = end_converted.state,
					expr = expr
				}
			else:
				{
					state = end_converted.state,
					expr = RangeExpr(start_converted.expr, end_converted.expr, typ, loc)
				}
		IfExpr(cond, then_expr, else_expr, typ, loc):
			convert_if_expr(facts, state, bound, expr, cond, then_expr, else_expr, typ, loc)
		_:
			{
				state = state,
				expr = expr
			}


-- Calls and the literal, record, union, and select aggregates.
private pure func convert_aggregate_expr(
	facts: ClosureFacts,
	state: ClosureState,
	bound: List[String],
	expr: CoreExpr,
) -> ConvertedExpr:
	match expr:
		CallExpr(kind, callee, args, typ, loc):
			convert_call_expr(facts, state, bound, expr, kind, callee, args, typ, loc)
		TupleExpr(items, typ, loc):
			converted: ConvertedExprs = convert_exprs(facts, state, bound, items)

			if converted.changed:
				{
					state = converted.state,
					expr = TupleExpr(converted.exprs, typ, loc)
				}
			else:
				{
					state = converted.state,
					expr = expr
				}
		TupleConstructExpr(tuple_construct, typ, loc):
			converted: ConvertedTupleElements = convert_tuple_elements(
				facts,
				state,
				bound,
				tuple_construct.elements,
			)

			if converted.changed:
				{
					state = converted.state,
					expr = TupleConstructExpr(
						{ tuple_construct | elements = converted.elements },
						typ,
						loc,
					)
				}
			else:
				{
					state = converted.state,
					expr = expr
				}
		VectorExpr(items, typ, loc):
			converted: ConvertedExprs = convert_exprs(facts, state, bound, items)

			if converted.changed:
				{
					state = converted.state,
					expr = VectorExpr(converted.exprs, typ, loc)
				}
			else:
				{
					state = converted.state,
					expr = expr
				}
		ListConstructExpr(construct, typ, loc):
			converted: ConvertedBoxedStorageValues = convert_boxed_storage_values(
				facts,
				state,
				bound,
				construct.elements,
			)

			if converted.changed:
				{
					state = converted.state,
					expr = ListConstructExpr({ construct | elements = converted.values }, typ, loc)
				}
			else:
				{
					state = converted.state,
					expr = expr
				}
		DictExpr(entries, typ, loc):
			converted: ConvertedDictLiteralEntries = convert_dict_literal_entries(
				facts,
				state,
				bound,
				entries,
			)

			if converted.changed:
				{
					state = converted.state,
					expr = DictExpr(converted.entries, typ, loc)
				}
			else:
				{
					state = converted.state,
					expr = expr
				}
		DictConstructExpr(construct, typ, loc):
			converted: ConvertedDictEntries = convert_dict_entries(
				facts,
				state,
				bound,
				construct.entries,
			)

			if converted.changed:
				{
					state = converted.state,
					expr = DictConstructExpr({ construct | entries = converted.entries }, typ, loc)
				}
			else:
				{
					state = converted.state,
					expr = expr
				}
		RecordExpr(fields, typ, loc):
			converted: ConvertedRecordFields = convert_record_fields(facts, state, bound, fields)

			if converted.changed:
				{
					state = converted.state,
					expr = RecordExpr(converted.fields, typ, loc)
				}
			else:
				{
					state = converted.state,
					expr = expr
				}
		RecordUpdateExpr(base, fields, typ, loc):
			converted_base: ConvertedExpr = convert_expr(facts, state, bound, base)
			converted: ConvertedRecordFields = convert_record_fields(
				facts,
				converted_base.state,
				bound,
				fields,
			)

			if same_core_expr(converted_base.expr, base) and not converted.changed:
				{
					state = converted.state,
					expr = expr
				}
			else:
				{
					state = converted.state,
					expr = RecordUpdateExpr(converted_base.expr, converted.fields, typ, loc)
				}
		RecordReuseExpr(source, fields, typ, loc):
			converted_source: ConvertedExpr = convert_expr(facts, state, bound, source)
			converted: ConvertedRecordFields = convert_record_fields(
				facts,
				converted_source.state,
				bound,
				fields,
			)

			if same_core_expr(converted_source.expr, source) and not converted.changed:
				{
					state = converted.state,
					expr = expr
				}
			else:
				{
					state = converted.state,
					expr = RecordReuseExpr(converted_source.expr, converted.fields, typ, loc)
				}
		RecordCowUpdateExpr(source, fields, typ, loc):
			-- Fields convert before the source so hoisted names keep their order.
			converted_fields: ConvertedRecordCowFields = convert_record_cow_fields(
				facts,
				state,
				bound,
				fields,
			)
			converted_source: ConvertedExpr = convert_expr(
				facts,
				converted_fields.state,
				bound,
				source,
			)

			if same_core_expr(converted_source.expr, source) and not converted_fields.changed:
				{
					state = converted_source.state,
					expr = expr
				}
			else:
				{
					state = converted_source.state,
					expr = RecordCowUpdateExpr(
						converted_source.expr,
						converted_fields.fields,
						typ,
						loc,
					)
				}
		RecordConstructExpr(type_name, fields, typ, loc):
			converted: ConvertedRecordFields = convert_record_fields(facts, state, bound, fields)

			if converted.changed:
				{
					state = converted.state,
					expr = RecordConstructExpr(type_name, converted.fields, typ, loc)
				}
			else:
				{
					state = converted.state,
					expr = expr
				}
		UnionConstructExpr(construct, typ, loc):
			converted: ConvertedBoxedStorageValues = convert_boxed_storage_values(
				facts,
				state,
				bound,
				construct.args,
			)

			if converted.changed:
				{
					state = converted.state,
					expr = UnionConstructExpr({ construct | args = converted.values }, typ, loc)
				}
			else:
				{
					state = converted.state,
					expr = expr
				}
		UnionReuseConstructExpr(construct, typ, loc):
			source: ConvertedExpr = convert_expr(facts, state, bound, construct.source)
			args: ConvertedBoxedStorageValues = convert_boxed_storage_values(
				facts,
				source.state,
				bound,
				construct.args,
			)

			if same_core_expr(source.expr, construct.source) and not args.changed:
				{
					state = args.state,
					expr = expr
				}
			else:
				{
					state = args.state,
					expr = UnionReuseConstructExpr(
						{ construct |
							source = source.expr,
							args = args.values
						},
						typ,
						loc,
					)
				}
		SelectExpr(select_expr, typ, loc):
			arms: ConvertedSelectArms = convert_select_arms(facts, state, bound, select_expr)

			if arms.changed:
				{
					state = arms.state,
					expr = SelectExpr(arms.arms, typ, loc)
				}
			else:
				{
					state = arms.state,
					expr = expr
				}
		_:
			{
				state = state,
				expr = expr
			}


-- List, string, and tensor storage operations whose children live in one
-- payload record.
private pure func convert_storage_expr(
	facts: ClosureFacts,
	state: ClosureState,
	bound: List[String],
	expr: CoreExpr,
) -> ConvertedExpr:
	match expr:
		ListAllocExpr(alloc, typ, loc):
			converted: ConvertedExpr = convert_expr(facts, state, bound, alloc.capacity)
			converted_with_child(
				converted,
				alloc.capacity,
				expr,
				ListAllocExpr({ alloc | capacity = converted.expr }, typ, loc),
			)
		ListGetExpr(get, typ, loc):
			list_converted: ConvertedExpr = convert_expr(facts, state, bound, get.list)
			index_converted: ConvertedExpr = convert_expr(
				facts,
				list_converted.state,
				bound,
				get.index,
			)

			if (
				same_core_expr(list_converted.expr, get.list)
				and same_core_expr(index_converted.expr, get.index)
			):
				{
					state = index_converted.state,
					expr = expr
				}
			else:
				{
					state = index_converted.state,
					expr = ListGetExpr(
						{ get |
							list = list_converted.expr,
							index = index_converted.expr
						},
						typ,
						loc,
					)
				}
		ListHandoffExpr(handoff, typ, loc):
			source: ConvertedExpr = convert_expr(facts, state, bound, handoff.source)
			capacity: ConvertedExpr = convert_expr(facts, source.state, bound, handoff.capacity)
			body_bound: List[String] = bound
				.add_bound_var(handoff.source_var)
				.add_bound_var(handoff.result_var)
				.add_bound_var(handoff.len_var)
				.add_bound_var(handoff.out_var)
			body: ConvertedExpr = convert_expr(facts, capacity.state, body_bound, handoff.body)

			if (
				same_core_expr(source.expr, handoff.source)
				and same_core_expr(capacity.expr, handoff.capacity)
				and same_core_expr(body.expr, handoff.body)
			):
				{
					state = body.state,
					expr = expr
				}
			else:
				{
					state = body.state,
					expr = ListHandoffExpr(
						{ handoff |
							source = source.expr,
							capacity = capacity.expr,
							body = body.expr
						},
						typ,
						loc,
					)
				}
		ListHandoffSetOwnedExpr(set, typ, loc):
			list: ConvertedExpr = convert_expr(facts, state, bound, set.list)
			index: ConvertedExpr = convert_expr(facts, list.state, bound, set.index)
			value: ConvertedBoxedStorageValue = convert_boxed_storage_value(
				facts,
				index.state,
				bound,
				set.value,
			)

			if (
				same_core_expr(list.expr, set.list)
				and same_core_expr(index.expr, set.index)
				and not value.changed
			):
				{
					state = value.state,
					expr = expr
				}
			else:
				{
					state = value.state,
					expr = ListHandoffSetOwnedExpr(
						{ set |
							list = list.expr,
							index = index.expr,
							value = value.value
						},
						typ,
						loc,
					)
				}
		ListHandoffSetSourceSlotExpr(slot, typ, loc):
			result: ConvertedExpr = convert_expr(facts, state, bound, slot.result)
			out_index: ConvertedExpr = convert_expr(facts, result.state, bound, slot.out_index)
			source: ConvertedExpr = convert_expr(facts, out_index.state, bound, slot.source)
			source_index: ConvertedExpr = convert_expr(
				facts,
				source.state,
				bound,
				slot.source_index,
			)

			if (
				same_core_expr(result.expr, slot.result)
				and same_core_expr(out_index.expr, slot.out_index)
				and same_core_expr(source.expr, slot.source)
				and same_core_expr(source_index.expr, slot.source_index)
			):
				{
					state = source_index.state,
					expr = expr
				}
			else:
				{
					state = source_index.state,
					expr = ListHandoffSetSourceSlotExpr(
						{ slot |
							result = result.expr,
							out_index = out_index.expr,
							source = source.expr,
							source_index = source_index.expr
						},
						typ,
						loc,
					)
				}
		StringByteReadExpr(read, typ, loc):
			source: ConvertedExpr = convert_expr(facts, state, bound, read.source)
			index: ConvertedExpr = convert_expr(facts, source.state, bound, read.index)

			if same_core_expr(source.expr, read.source) and same_core_expr(index.expr, read.index):
				{
					state = index.state,
					expr = expr
				}
			else:
				{
					state = index.state,
					expr = StringByteReadExpr(
						{ read |
							source = source.expr,
							index = index.expr
						},
						typ,
						loc,
					)
				}
		StringByteWriteExpr(write, typ, loc):
			target: ConvertedExpr = convert_expr(facts, state, bound, write.target)
			index: ConvertedExpr = convert_expr(facts, target.state, bound, write.index)
			byte: ConvertedExpr = convert_expr(facts, index.state, bound, write.byte)

			if (
				same_core_expr(target.expr, write.target)
				and same_core_expr(index.expr, write.index)
				and same_core_expr(byte.expr, write.byte)
			):
				{
					state = byte.state,
					expr = expr
				}
			else:
				{
					state = byte.state,
					expr = StringByteWriteExpr(
						{ write |
							target = target.expr,
							index = index.expr,
							byte = byte.expr
						},
						typ,
						loc,
					)
				}
		StringByteCopyExpr(copy, typ, loc):
			dst: ConvertedExpr = convert_expr(facts, state, bound, copy.dst)
			dst_pos: ConvertedExpr = convert_expr(facts, dst.state, bound, copy.dst_pos)
			src: ConvertedExpr = convert_expr(facts, dst_pos.state, bound, copy.src)
			src_pos: ConvertedExpr = convert_expr(facts, src.state, bound, copy.src_pos)
			len: ConvertedExpr = convert_expr(facts, src_pos.state, bound, copy.len)

			if (
				same_core_expr(dst.expr, copy.dst)
				and same_core_expr(dst_pos.expr, copy.dst_pos)
				and same_core_expr(src.expr, copy.src)
				and same_core_expr(src_pos.expr, copy.src_pos)
				and same_core_expr(len.expr, copy.len)
			):
				{
					state = len.state,
					expr = expr
				}
			else:
				{
					state = len.state,
					expr = StringByteCopyExpr(
						{ copy |
							dst = dst.expr,
							dst_pos = dst_pos.expr,
							src = src.expr,
							src_pos = src_pos.expr,
							len = len.expr
						},
						typ,
						loc,
					)
				}
		StringSetLenExpr(set_len, typ, loc):
			target: ConvertedExpr = convert_expr(facts, state, bound, set_len.target)
			len: ConvertedExpr = convert_expr(facts, target.state, bound, set_len.len)

			if (
				same_core_expr(target.expr, set_len.target)
				and same_core_expr(len.expr, set_len.len)
			):
				{
					state = len.state,
					expr = expr
				}
			else:
				{
					state = len.state,
					expr = StringSetLenExpr(
						{ set_len |
							target = target.expr,
							len = len.expr
						},
						typ,
						loc,
					)
				}
		TensorLiteralExpr(literal, typ, loc):
			match literal.payload:
				TensorRawLiteralPayload(raw):
					converted: ConvertedExprs = convert_exprs(facts, state, bound, raw.elements)

					if converted.changed:
						{
							state = converted.state,
							expr = TensorLiteralExpr(
								{ literal |
									payload = TensorRawLiteralPayload(
										{ raw | elements = converted.exprs },
									)
								},
								typ,
								loc,
							)
						}
					else:
						{
							state = converted.state,
							expr = expr
						}
				TensorInlineStructLiteralPayload(inline_struct):
					converted: ConvertedExprs = convert_exprs(
						facts,
						state,
						bound,
						inline_struct.elements,
					)

					if converted.changed:
						{
							state = converted.state,
							expr = TensorLiteralExpr(
								{ literal |
									payload = TensorInlineStructLiteralPayload(
										{ inline_struct | elements = converted.exprs },
									)
								},
								typ,
								loc,
							)
						}
					else:
						{
							state = converted.state,
							expr = expr
						}
		TensorBoxedLiteralExpr(literal, typ, loc):
			converted: ConvertedBoxedStorageValues = convert_boxed_storage_values(
				facts,
				state,
				bound,
				literal.elements,
			)

			if converted.changed:
				{
					state = converted.state,
					expr = TensorBoxedLiteralExpr(
						{ literal | elements = converted.values },
						typ,
						loc,
					)
				}
			else:
				{
					state = converted.state,
					expr = expr
				}
		TensorPackedLiteralExpr(literal, typ, loc):
			converted: ConvertedExprs = convert_exprs(facts, state, bound, literal.elements)

			if converted.changed:
				{
					state = converted.state,
					expr = TensorPackedLiteralExpr(
						{ literal | elements = converted.exprs },
						typ,
						loc,
					)
				}
			else:
				{
					state = converted.state,
					expr = expr
				}
		TensorRawFillExpr(fill, typ, loc):
			value: ConvertedExpr = convert_expr(facts, state, bound, fill.value)
			dims: ConvertedExprs = convert_exprs(facts, value.state, bound, fill.dims)

			if same_core_expr(value.expr, fill.value) and not dims.changed:
				{
					state = dims.state,
					expr = expr
				}
			else:
				{
					state = dims.state,
					expr = TensorRawFillExpr(
						{ fill |
							value = value.expr,
							dims = dims.exprs
						},
						typ,
						loc,
					)
				}
		TensorRawReadExpr(read, typ, loc):
			index: ConvertedExpr = convert_expr(facts, state, bound, read.index)
			converted_with_child(
				index,
				read.index,
				expr,
				TensorRawReadExpr({ read | index = index.expr }, typ, loc),
			)
		TensorRawWriteExpr(write, typ, loc):
			index: ConvertedExpr = convert_expr(facts, state, bound, write.index)
			value: ConvertedExpr = convert_expr(facts, index.state, bound, write.value)

			if same_core_expr(index.expr, write.index) and same_core_expr(value.expr, write.value):
				{
					state = value.state,
					expr = expr
				}
			else:
				{
					state = value.state,
					expr = TensorRawWriteExpr(
						{ write |
							index = index.expr,
							value = value.expr
						},
						typ,
						loc,
					)
				}
		TensorRawViewLetExpr(binding, body, typ, loc):
			source: ConvertedExpr = convert_expr(facts, state, bound, binding.source)
			body_bound: List[String] = add_bound_var(bound, binding.variable)
			body_converted: ConvertedExpr = convert_expr(facts, source.state, body_bound, body)

			if (
				same_core_expr(source.expr, binding.source)
				and same_core_expr(body_converted.expr, body)
			):
				{
					state = body_converted.state,
					expr = expr
				}
			else:
				{
					state = body_converted.state,
					expr = TensorRawViewLetExpr(
						{ binding | source = source.expr },
						body_converted.expr,
						typ,
						loc,
					)
				}
		_:
			{
				state = state,
				expr = expr
			}


-- Rebuilds a `for` loop's payload record only when its iterable or body changed.
-- Every `for` payload shares these two field names.
private pure func converted_for_loop(
	iterable: ConvertedExpr,
	body: ConvertedExpr,
	source_iterable: CoreExpr,
	source_body: CoreExpr,
	expr: CoreExpr,
	rebuilt: CoreExpr,
) -> ConvertedExpr:
	if same_core_expr(iterable.expr, source_iterable) and same_core_expr(body.expr, source_body):
		{
			state = body.state,
			expr = expr
		}
	else:
		{
			state = body.state,
			expr = rebuilt
		}


-- Lambdas, tail-recursive loops, `for` loops, and resource scopes.
private pure func convert_loop_expr(
	facts: ClosureFacts,
	state: ClosureState,
	bound: List[String],
	expr: CoreExpr,
) -> ConvertedExpr:
	match expr:
		LambdaExpr(params, return_type, body, is_pure, typ, loc):
			body_bound: List[String] = add_bound_params(bound, params)
			body_converted: ConvertedExpr = convert_expr(facts, state, body_bound, body)

			if facts.mode == AdaptFunctionRefs:
				converted_with_child(
					body_converted,
					body,
					expr,
					LambdaExpr(params, return_type, body_converted.expr, is_pure, typ, loc),
				)
			else:
				hoisted: HoistedClosureCreate = hoist_lambda(
					facts,
					body_converted.state,
					bound,
					params,
					return_type,
					body_converted.expr,
					is_pure,
					loc,
				)
				{
					state = hoisted.state,
					expr = ClosureCreateExpr(hoisted.create, typ, loc)
				}
		TailrecLoopExpr(params, return_type, body, loc):
			body_converted: ConvertedExpr = convert_expr(
				facts,
				state,
				add_bound_params(bound, params),
				body,
			)
			converted_with_child(
				body_converted,
				body,
				expr,
				TailrecLoopExpr(params, return_type, body_converted.expr, loc),
			)
		TailrecRecurExpr(args, typ, loc):
			converted: ConvertedExprs = convert_exprs(facts, state, bound, args)

			if converted.changed:
				{
					state = converted.state,
					expr = TailrecRecurExpr(converted.exprs, typ, loc)
				}
			else:
				{
					state = converted.state,
					expr = expr
				}
		TailrecListSpreadLoopExpr(loop, loc):
			body_bound: List[String] = add_bound_params(
				add_bound_var(bound, loop.cursor),
				loop.params,
			)
			body_converted: ConvertedExpr = convert_expr(facts, state, body_bound, loop.body)
			converted_with_child(
				body_converted,
				loop.body,
				expr,
				TailrecListSpreadLoopExpr({ loop | body = body_converted.expr }, loc),
			)
		TailrecListSpreadRecurExpr(rebinds, cursor_advance, typ, loc):
			var current: ClosureState = state
			var converted_rebinds: List[CoreTailrecListSpreadRebind] = rebinds
			var changed: Bool = False
			var index: Int = 0

			for rebind in rebinds:
				value: ConvertedExpr = convert_expr(facts, current, bound, rebind.value)
				current = value.state
				rebind_changed: Bool = not same_core_expr(value.expr, rebind.value)

				converted_rebind: CoreTailrecListSpreadRebind = if rebind_changed:
					{ rebind | value = value.expr }
				else:
					rebind

				if changed:
					converted_rebinds = converted_rebinds.append(converted_rebind)
				else if rebind_changed:
					converted_rebinds = rebinds
						.take(index)
						.append(converted_rebind)
					changed = True

				index += 1

			if changed:
				{
					state = current,
					expr = TailrecListSpreadRecurExpr(converted_rebinds, cursor_advance, typ, loc)
				}
			else:
				{
					state = current,
					expr = expr
				}
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			start_converted: ConvertedExpr = convert_expr(facts, state, bound, start)
			end_converted: ConvertedExpr = convert_expr(
				facts,
				start_converted.state,
				bound,
				end_value,
			)
			body_converted: ConvertedExpr = convert_expr(
				facts,
				end_converted.state,
				add_bound_var(bound, binder.variable),
				body,
			)

			if (
				same_core_expr(start_converted.expr, start)
				and same_core_expr(end_converted.expr, end_value)
				and same_core_expr(body_converted.expr, body)
			):
				{
					state = body_converted.state,
					expr = expr
				}
			else:
				{
					state = body_converted.state,
					expr = ForRangeExpr(
						binder,
						start_converted.expr,
						end_converted.expr,
						body_converted.expr,
						typ,
						loc,
					)
				}
		ForChannelExpr(for_channel, typ, loc):
			iterable: ConvertedExpr = convert_expr(facts, state, bound, for_channel.iterable)
			body: ConvertedExpr = convert_expr(
				facts,
				iterable.state,
				add_bound_var(bound, for_channel.binder.variable),
				for_channel.body,
			)
			converted_for_loop(
				iterable,
				body,
				for_channel.iterable,
				for_channel.body,
				expr,
				ForChannelExpr(
					{ for_channel |
						iterable = iterable.expr,
						body = body.expr
					},
					typ,
					loc,
				),
			)
		ForListExpr(for_list, typ, loc):
			iterable: ConvertedExpr = convert_expr(facts, state, bound, for_list.iterable)
			body: ConvertedExpr = convert_expr(
				facts,
				iterable.state,
				add_bound_var(bound, for_list.binder.variable),
				for_list.body,
			)
			converted_for_loop(
				iterable,
				body,
				for_list.iterable,
				for_list.body,
				expr,
				ForListExpr(
					{ for_list |
						iterable = iterable.expr,
						body = body.expr
					},
					typ,
					loc,
				),
			)
		ForStringExpr(for_string, typ, loc):
			iterable: ConvertedExpr = convert_expr(facts, state, bound, for_string.iterable)
			body: ConvertedExpr = convert_expr(
				facts,
				iterable.state,
				add_bound_var(bound, for_string.binder.variable),
				for_string.body,
			)
			converted_for_loop(
				iterable,
				body,
				for_string.iterable,
				for_string.body,
				expr,
				ForStringExpr(
					{ for_string |
						iterable = iterable.expr,
						body = body.expr
					},
					typ,
					loc,
				),
			)
		ForDictExpr(for_dict, typ, loc):
			iterable: ConvertedExpr = convert_expr(facts, state, bound, for_dict.iterable)
			body: ConvertedExpr = convert_expr(
				facts,
				iterable.state,
				add_bound_var(bound, for_dict.binder.variable),
				for_dict.body,
			)
			converted_for_loop(
				iterable,
				body,
				for_dict.iterable,
				for_dict.body,
				expr,
				ForDictExpr(
					{ for_dict |
						iterable = iterable.expr,
						body = body.expr
					},
					typ,
					loc,
				),
			)
		ForSetExpr(for_set, typ, loc):
			iterable: ConvertedExpr = convert_expr(facts, state, bound, for_set.iterable)
			body: ConvertedExpr = convert_expr(
				facts,
				iterable.state,
				add_bound_var(bound, for_set.binder.variable),
				for_set.body,
			)
			converted_for_loop(
				iterable,
				body,
				for_set.iterable,
				for_set.body,
				expr,
				ForSetExpr(
					{ for_set |
						iterable = iterable.expr,
						body = body.expr
					},
					typ,
					loc,
				),
			)
		ForResourceSourceExpr(for_resource_source, typ, loc):
			iterable: ConvertedExpr = convert_expr(
				facts,
				state,
				bound,
				for_resource_source.iterable,
			)
			body: ConvertedExpr = convert_expr(
				facts,
				iterable.state,
				add_bound_var(bound, for_resource_source.binder.variable),
				for_resource_source.body,
			)
			converted_for_loop(
				iterable,
				body,
				for_resource_source.iterable,
				for_resource_source.body,
				expr,
				ForResourceSourceExpr(
					{ for_resource_source |
						iterable = iterable.expr,
						body = body.expr
					},
					typ,
					loc,
				),
			)
		ForStreamExpr(for_stream, typ, loc):
			iterable: ConvertedExpr = convert_expr(facts, state, bound, for_stream.iterable)
			body: ConvertedExpr = convert_expr(
				facts,
				iterable.state,
				add_bound_var(bound, for_stream.binder.variable),
				for_stream.body,
			)
			converted_for_loop(
				iterable,
				body,
				for_stream.iterable,
				for_stream.body,
				expr,
				ForStreamExpr(
					{ for_stream |
						iterable = iterable.expr,
						body = body.expr
					},
					typ,
					loc,
				),
			)
		ForTensorExpr(for_tensor, typ, loc):
			iterable: ConvertedExpr = convert_expr(facts, state, bound, for_tensor.iterable)
			body: ConvertedExpr = convert_expr(
				facts,
				iterable.state,
				add_bound_var(bound, for_tensor.binder.variable),
				for_tensor.body,
			)
			converted_for_loop(
				iterable,
				body,
				for_tensor.iterable,
				for_tensor.body,
				expr,
				ForTensorExpr(
					{ for_tensor |
						iterable = iterable.expr,
						body = body.expr
					},
					typ,
					loc,
				),
			)
		ResourceScopeExpr(scope, typ, loc):
			acquire: ConvertedExpr = convert_expr(facts, state, bound, scope.acquire)
			scope_bound: List[String] = add_bound_var(bound, scope.variable)
			body: ConvertedExpr = convert_expr(facts, acquire.state, scope_bound, scope.body)
			cleanup: ConvertedExpr = convert_expr(facts, body.state, scope_bound, scope.cleanup)

			if (
				same_core_expr(acquire.expr, scope.acquire)
				and same_core_expr(body.expr, scope.body)
				and same_core_expr(cleanup.expr, scope.cleanup)
			):
				{
					state = cleanup.state,
					expr = expr
				}
			else:
				{
					state = cleanup.state,
					expr = ResourceScopeExpr(
						{ scope |
							acquire = acquire.expr,
							body = body.expr,
							cleanup = cleanup.expr
						},
						typ,
						loc,
					)
				}
		ResourceCleanupExitExpr(exit, typ, loc):
			cleanups: ConvertedExprs = convert_exprs(facts, state, bound, exit.cleanups)

			if cleanups.changed:
				{
					state = cleanups.state,
					expr = ResourceCleanupExitExpr({ exit | cleanups = cleanups.exprs }, typ, loc)
				}
			else:
				{
					state = cleanups.state,
					expr = expr
				}
		_:
			{
				state = state,
				expr = expr
			}


-- Structured-concurrency blocks and loops, before and after task hoisting.
private pure func convert_concurrency_expr(
	facts: ClosureFacts,
	state: ClosureState,
	bound: List[String],
	expr: CoreExpr,
) -> ConvertedExpr:
	match expr:
		PreClosureConcurrentlyLoopExpr(loop, typ, loc):
			iterable: ConvertedExpr = convert_expr(facts, state, bound, loop.iterable)
			body_bound: List[String] = add_bound_var(bound, loop.variable)
			body: ConvertedExpr = convert_expr(facts, iterable.state, body_bound, loop.body)
			timeout: ConvertedOptionalExpr = convert_optional_expr(
				facts,
				body.state,
				bound,
				loop.timeout,
			)
			limit: ConvertedExpr = convert_expr(facts, timeout.state, bound, loop.limit)

			if facts.mode == AdaptFunctionRefs:
				if (
					same_core_expr(iterable.expr, loop.iterable)
					and same_core_expr(body.expr, loop.body)
					and not timeout.changed
					and same_core_expr(limit.expr, loop.limit)
				):
					{
						state = limit.state,
						expr = expr
					}
				else:
					{
						state = limit.state,
						expr = PreClosureConcurrentlyLoopExpr(
							{ loop |
								iterable = iterable.expr,
								body = body.expr,
								timeout = timeout.expr,
								limit = limit.expr
							},
							typ,
							loc,
						)
					}
			else:
				task: HoistedTaskClosure = hoist_loop_task(
					facts,
					limit.state,
					body_bound,
					[],
					loop.variable,
					loop.item_mode,
					body.expr,
					core_expr_type(body.expr),
					loc,
				)
				{
					state = task.state,
					expr = ConcurrentlyLoopExpr(
						{
							variable = loop.variable,
							item_type = loop.item_type,
							item_mode = loop.item_mode,
							iterable = iterable.expr,
							body = body.expr,
							timeout = timeout.expr,
							limit = limit.expr,
							output = loop.output,
							task = task.task
						},
						typ,
						loc,
					)
				}
		ConcurrentlyLoopExpr(loop, typ, loc):
			iterable: ConvertedExpr = convert_expr(facts, state, bound, loop.iterable)
			body_bound: List[String] = add_bound_var(bound, loop.variable)
			body: ConvertedExpr = convert_expr(facts, iterable.state, body_bound, loop.body)
			timeout: ConvertedOptionalExpr = convert_optional_expr(
				facts,
				body.state,
				bound,
				loop.timeout,
			)
			limit: ConvertedExpr = convert_expr(facts, timeout.state, bound, loop.limit)

			if (
				same_core_expr(iterable.expr, loop.iterable)
				and same_core_expr(body.expr, loop.body)
				and not timeout.changed
				and same_core_expr(limit.expr, loop.limit)
			):
				{
					state = limit.state,
					expr = expr
				}
			else:
				{
					state = limit.state,
					expr = ConcurrentlyLoopExpr(
						{ loop |
							iterable = iterable.expr,
							body = body.expr,
							timeout = timeout.expr,
							limit = limit.expr
						},
						typ,
						loc,
					)
				}
		PreClosureConcurrentExpr(block, typ, loc):
			if facts.mode == AdaptFunctionRefs:
				var current: ClosureState = state
				var bindings: List[CorePreClosureConcurrentBinding] = block.bindings
				var bindings_changed: Bool = False
				var index: Int = 0

				for binding in block.bindings:
					rhs: ConvertedExpr = convert_expr(facts, current, bound, binding.rhs)
					current = rhs.state
					binding_changed: Bool = not same_core_expr(rhs.expr, binding.rhs)

					converted_binding: CorePreClosureConcurrentBinding = if binding_changed:
						{ binding | rhs = rhs.expr }
					else:
						binding

					if bindings_changed:
						bindings = bindings.append(converted_binding)
					else if binding_changed:
						bindings = block.bindings
							.take(index)
							.append(converted_binding)
						bindings_changed = True

					index += 1

				var body_bound: List[String] = bound

				for binding in block.bindings:
					body_bound = add_bound_var(body_bound, binding.variable)

				body: ConvertedExpr = convert_expr(facts, current, body_bound, block.body)
				timeout: ConvertedOptionalExpr = convert_optional_expr(
					facts,
					body.state,
					bound,
					block.timeout,
				)

				if (
					not bindings_changed
					and same_core_expr(body.expr, block.body)
					and not timeout.changed
				):
					{
						state = timeout.state,
						expr = expr
					}
				else:
					{
						state = timeout.state,
						expr = PreClosureConcurrentExpr(
							{ block |
								bindings = bindings,
								body = body.expr,
								timeout = timeout.expr
							},
							typ,
							loc,
						)
					}
			else:
				var current: ClosureState = state
				var bindings: List[CoreConcurrentBinding] = []

				for binding in block.bindings:
					rhs: ConvertedExpr = convert_expr(facts, current, bound, binding.rhs)
					task: HoistedTaskClosure = hoist_copy_task(
						facts,
						rhs.state,
						bound,
						[],
						rhs.expr,
						core_expr_type(rhs.expr),
						loc,
					)
					current = task.state
					bindings = bindings.append({
						variable = binding.variable,
						typ = binding.typ,
						rhs = rhs.expr,
						task = task.task,
					})

				var body_bound: List[String] = bound

				for binding in block.bindings:
					body_bound = add_bound_var(body_bound, binding.variable)

				body: ConvertedExpr = convert_expr(facts, current, body_bound, block.body)
				timeout: ConvertedOptionalExpr = convert_optional_expr(
					facts,
					body.state,
					bound,
					block.timeout,
				)
				{
					state = timeout.state,
					expr = ConcurrentExpr(
						{
							bindings = bindings,
							body = body.expr,
							timeout = timeout.expr,
							max_threads = block.max_threads
						},
						typ,
						loc,
					)
				}
		ConcurrentExpr(block, typ, loc):
			var current: ClosureState = state
			var bindings: List[CoreConcurrentBinding] = block.bindings
			var bindings_changed: Bool = False
			var index: Int = 0

			for binding in block.bindings:
				rhs: ConvertedExpr = convert_expr(facts, current, bound, binding.rhs)
				current = rhs.state
				binding_changed: Bool = not same_core_expr(rhs.expr, binding.rhs)

				converted_binding: CoreConcurrentBinding = if binding_changed:
					{ binding | rhs = rhs.expr }
				else:
					binding

				if bindings_changed:
					bindings = bindings.append(converted_binding)
				else if binding_changed:
					bindings = block.bindings
						.take(index)
						.append(converted_binding)
					bindings_changed = True

				index += 1

			var body_bound: List[String] = bound

			for binding in block.bindings:
				body_bound = add_bound_var(body_bound, binding.variable)

			body: ConvertedExpr = convert_expr(facts, current, body_bound, block.body)
			timeout: ConvertedOptionalExpr = convert_optional_expr(
				facts,
				body.state,
				bound,
				block.timeout,
			)

			if (
				not bindings_changed
				and same_core_expr(body.expr, block.body)
				and not timeout.changed
			):
				{
					state = timeout.state,
					expr = expr
				}
			else:
				{
					state = timeout.state,
					expr = ConcurrentExpr(
						{ block |
							bindings = bindings,
							body = body.expr,
							timeout = timeout.expr
						},
						typ,
						loc,
					)
				}
		_:
			{
				state = state,
				expr = expr
			}


-- The match forms, each with its own spine converter.
private pure func convert_match_expr(
	facts: ClosureFacts,
	state: ClosureState,
	bound: List[String],
	expr: CoreExpr,
) -> ConvertedExpr:
	match expr:
		RawMatchExpr(scrutinee, cases, typ, loc):
			convert_raw_match_expr(facts, state, bound, expr, scrutinee, cases, typ, loc)
		SemanticMatchExpr(scrutinee, tree, typ, loc):
			convert_semantic_match_expr(facts, state, bound, expr, scrutinee, tree, typ, loc)
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			convert_literal_match_expr(
				facts,
				state,
				bound,
				expr,
				scrutinee,
				cases,
				fallback,
				typ,
				loc,
			)
		AccessorLiteralMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			convert_accessor_literal_match_expr(
				facts,
				state,
				bound,
				expr,
				scrutinee,
				release_policy,
				match_expr,
				typ,
				loc,
			)
		LengthMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			convert_length_match_expr(
				facts,
				state,
				bound,
				expr,
				scrutinee,
				release_policy,
				match_expr,
				typ,
				loc,
			)
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			convert_constructor_match_expr(
				facts,
				state,
				bound,
				expr,
				scrutinee,
				release_policy,
				cases,
				fallback,
				typ,
				loc,
			)
		_:
			{
				state = state,
				expr = expr
			}


private pure func append_definition(
	definitions: List[CoreDefinitionIdentity],
	name: String,
	def_id: Option[Int],
) -> List[CoreDefinitionIdentity]:
	-- Declared IDs are unique in valid late Core. Duplicate exact identities do
	-- not affect membership checks, so avoid a quadratic scan while building.
	match def_id:
		Some(value):
			definitions.append({
				name = name,
				def_id = value,
			})
		None:
			definitions


private pure func add_constructor_definition_aliases(
	definitions: List[CoreDefinitionIdentity],
	name: String,
	c_name: String,
	def_id: Option[Int],
) -> List[CoreDefinitionIdentity]:
	-- Backend projection rewrites constructor values to c_name before closure conversion.
	with_source_name: List[CoreDefinitionIdentity] = append_definition(definitions, name, def_id)

	if c_name == name:
		with_source_name
	else:
		append_definition(with_source_name, c_name, def_id)


pure func capture_constructor_definitions(program: CoreProgram) -> List[CoreDefinitionIdentity]:
	var definitions: List[CoreDefinitionIdentity] = []

	for decl in program.decls:
		match decl:
			EnumDecl(enum_decl):
				for variant in enum_decl.variants:
					definitions = add_constructor_definition_aliases(
						definitions,
						variant.name,
						variant.c_name,
						variant.def_id,
					)
			UnionDecl(union_decl):
				for variant in union_decl.variants:
					definitions = add_constructor_definition_aliases(
						definitions,
						variant.name,
						variant.c_name,
						variant.def_id,
					)
			FunctionDecl(func_info):
				void
			GlobalDecl(global):
				void
			ValueRecordDecl(record_decl):
				void
			HeapRecordDecl(record_decl):
				void
			TypeAliasDecl(alias_decl):
				void
			TraitDecl(trait_decl):
				void
			ImplDecl(impl_decl):
				void

	definitions


pure func capture_function_definitions(program: CoreProgram) -> List[CoreDefinitionIdentity]:
	var definitions: List[CoreDefinitionIdentity] = []

	for decl in program.decls:
		match decl:
			FunctionDecl(func_info):
				definitions = append_definition(definitions, func_info.name, Some(func_info.def_id))
			GlobalDecl(global):
				void
			EnumDecl(enum_decl):
				void
			UnionDecl(union_decl):
				void
			ValueRecordDecl(record_decl):
				void
			HeapRecordDecl(record_decl):
				void
			TypeAliasDecl(alias_decl):
				void
			TraitDecl(trait_decl):
				void
			ImplDecl(impl_decl):
				for method in impl_decl.methods:
					definitions = append_definition(definitions, method.name, Some(method.def_id))

	definitions


private pure func index_functions(program: CoreProgram) -> FunctionIndexes:
	var by_id: Dict[Int, CoreFunction] = {}
	var collisions_by_id: Dict[Int, List[CoreFunction]] = {}
	var by_name: Dict[String, List[CoreFunction]] = {}

	for decl in program.decls:
		match decl:
			FunctionDecl(func_info):
				match by_id.get(func_info.def_id):
					Some(existing):
						collisions_by_id = collisions_by_id.set(
							func_info.def_id,
							collisions_by_id
								.get_or(func_info.def_id, [existing])
								.append(func_info),
						)
					None:
						by_id = by_id.set(func_info.def_id, func_info)

				by_name = by_name.set(
					func_info.name,
					by_name
						.get_or(func_info.name, [])
						.append(func_info),
				)
			ImplDecl(impl_info):
				for method in impl_info.methods:
					match by_id.get(method.def_id):
						Some(existing):
							collisions_by_id = collisions_by_id.set(
								method.def_id,
								collisions_by_id
									.get_or(method.def_id, [existing])
									.append(method),
							)
						None:
							by_id = by_id.set(method.def_id, method)

					by_name = by_name.set(
						method.name,
						by_name
							.get_or(method.name, [])
							.append(method),
					)
			_:
				void

	{
		by_id = by_id,
		collisions_by_id = collisions_by_id,
		by_name = by_name
	}


private pure func function_index_diagnostic_entry(func_info: CoreFunction) -> (String, Int):
	(func_info.name, func_info.def_id)


private pure func function_index_diagnostic_entries(
	functions: List[CoreFunction],
) -> List[(String, Int)]:
	var entries: List[(String, Int)] = []

	for func_info in functions:
		entries = entries.append(function_index_diagnostic_entry(func_info))

	entries


private pure func function_index_total_collision_entries(indexes: FunctionIndexes) -> Int:
	var total: Int = 0

	for (_, collisions) in indexes.collisions_by_id:
		total += collisions.length()

	total


private pure func function_index_name_diagnostics(
	indexes: FunctionIndexes,
	names: List[String],
) -> List[(String, List[(String, Int)])]:
	var diagnostics: List[(String, List[(String, Int)])] = []

	for name in names:
		diagnostics = diagnostics.append(
			(name, function_index_diagnostic_entries(indexes.by_name.get_or(name, []))),
		)

	diagnostics


private pure func function_index_id_diagnostics(
	indexes: FunctionIndexes,
	def_ids: List[Int],
) -> List[(Int, Option[(String, Int)], List[(String, Int)])]:
	var diagnostics: List[(Int, Option[(String, Int)], List[(String, Int)])] = []

	for def_id in def_ids:
		diagnostics = diagnostics.append(
			(
				def_id,
				indexes.by_id
					.get(def_id)
					.map(function_index_diagnostic_entry),
				function_index_diagnostic_entries(indexes.collisions_by_id.get_or(def_id, [])),
			),
		)

	diagnostics


pure func closure_function_index_diagnostic_snapshot(
	program: CoreProgram,
	names: List[String],
	def_ids: List[Int],
) -> ClosureFunctionIndexDiagnosticSnapshot:
	indexes: FunctionIndexes = index_functions(program)
	{
		by_id_count = indexes.by_id
			.keys()
			.length(),
		by_name_count = indexes.by_name
			.keys()
			.length(),
		collision_id_count = indexes.collisions_by_id
			.keys()
			.length(),
		total_collision_entries = function_index_total_collision_entries(indexes),
		names = function_index_name_diagnostics(indexes, names),
		ids = function_index_id_diagnostics(indexes, def_ids)
	}


-- Builds the read-only facts about `program` once: the pass mode and the
-- lookup tables used throughout the walk. Delegates to `index_functions`,
-- which already follows the local-mutation-then-publish builder shape.
private pure func closure_facts(program: CoreProgram, mode: ClosurePassMode) -> ClosureFacts:
	indexes: FunctionIndexes = index_functions(program)
	{
		mode = mode,
		current_module = None,
		functions_by_id = indexes.by_id,
		function_collisions_by_id = indexes.collisions_by_id,
		functions_by_name = indexes.by_name,
		function_definitions = capture_function_definitions(program),
		constructor_definitions = capture_constructor_definitions(program)
	}


-- The mutable counters and hoisted-function accumulator, seeded once per
-- program from the pass-state definition-id frontier. `hoisted` only ever
-- grows as the walk hoists lambdas/etas/tasks.
private pure func initial_counters(next_def_id: Int) -> ClosureState:
	{
		next_eta_index = 0,
		next_lambda_index = 0,
		next_task_index = 0,
		next_def_id = next_def_id,
		hoisted = []
	}


private pure func convert_function(
	facts: ClosureFacts,
	state: ClosureState,
	decl: CoreDecl,
	func_info: CoreFunction,
) -> ConvertedDecl:
	match func_info.body:
		Some(body):
			facts_with_module: ClosureFacts = { facts | current_module = func_info.source_module }
			body_bound: List[String] = add_bound_params([], func_info.params)
			converted: ConvertedExpr = convert_expr(facts_with_module, state, body_bound, body)

			if same_core_expr(converted.expr, body):
				{
					state = converted.state,
					decl = decl
				}
			else:
				{
					state = converted.state,
					decl = FunctionDecl({ func_info | body = Some(converted.expr) })
				}
		None:
			{
				state = state,
				decl = decl
			}


private pure func convert_global(
	facts: ClosureFacts,
	state: ClosureState,
	decl: CoreDecl,
	global: CoreGlobal,
) -> ConvertedDecl:
	converted: ConvertedExpr = convert_expr(facts, state, [], global.init)

	if same_core_expr(converted.expr, global.init):
		{
			state = converted.state,
			decl = decl
		}
	else:
		{
			state = converted.state,
			decl = GlobalDecl({ global | init = converted.expr })
		}


private pure func convert_decl(
	facts: ClosureFacts,
	state: ClosureState,
	decl: CoreDecl,
) -> ConvertedOptionalDecl:
	match decl:
		FunctionDecl(func_info):
			if func_info.type_params.length() == 0:
				converted: ConvertedDecl = convert_function(facts, state, decl, func_info)
				{
					state = converted.state,
					decl = Some(converted.decl)
				}
			else if facts.mode == AdaptFunctionRefs:
				{
					state = state,
					decl = Some(decl)
				}
			else:
				{
					state = state,
					decl = None
				}
		GlobalDecl(global):
			converted: ConvertedDecl = convert_global(facts, state, decl, global)
			{
				state = converted.state,
				decl = Some(converted.decl)
			}
		EnumDecl(enum_decl):
			{
				state = state,
				decl = Some(decl)
			}
		UnionDecl(union_decl):
			{
				state = state,
				decl = Some(decl)
			}
		ValueRecordDecl(record_decl):
			{
				state = state,
				decl = Some(decl)
			}
		HeapRecordDecl(record_decl):
			{
				state = state,
				decl = Some(decl)
			}
		TypeAliasDecl(alias_decl):
			{
				state = state,
				decl = Some(decl)
			}
		TraitDecl(trait_decl):
			{
				state = state,
				decl = Some(decl)
			}
		ImplDecl(impl_decl):
			{
				state = state,
				decl = Some(decl)
			}


private pure func convert_decls(
	facts: ClosureFacts,
	state: ClosureState,
	decls: List[CoreDecl],
) -> ConvertedDecls:
	var current: ClosureState = state
	var converted_decls: List[CoreDecl] = []

	for decl in decls:
		converted: ConvertedOptionalDecl = convert_decl(facts, current, decl)
		current = converted.state

		match converted.decl:
			Some(converted_decl):
				converted_decls = converted_decls.append(converted_decl)
			None:
				void

	{
		state = current,
		decls = converted_decls
	}


-- Carries the advanced definition-id frontier back out, alongside the
-- rewritten program, so the pass runner's `CorePassState.next_def_id` stays
-- the one authoritative counter instead of each pass reseeding its own by
-- rescanning the program.
record ClosurePassResult {
	program: CoreProgram,
	next_def_id: Int
}


private pure func run_closure_pass(
	program: CoreProgram,
	mode: ClosurePassMode,
	next_def_id: Int,
) -> ClosurePassResult:
	converted: ConvertedDecls = convert_decls(
		closure_facts(program, mode),
		initial_counters(next_def_id),
		program.decls,
	)
	{
		program = {
			decls = converted.decls.concat(converted.state.hoisted),
			foreign_includes = program.foreign_includes
		},
		next_def_id = converted.state.next_def_id
	}


-- Normalize bare global function values into explicit eta closures before
-- Perceus. Exact (name, def-id) identity wins; a raw def-id is accepted only
-- when it identifies one function in the projected program. A reference with
-- no def-id is accepted only when its name identifies one function.
pure func adapt_function_refs_program(
	program: CoreProgram,
	next_def_id: Int,
) -> ClosurePassResult:
	run_closure_pass(program, AdaptFunctionRefs, next_def_id)


pure func convert_program(program: CoreProgram, next_def_id: Int) -> ClosurePassResult:
	run_closure_pass(program, ConvertClosures, next_def_id)
