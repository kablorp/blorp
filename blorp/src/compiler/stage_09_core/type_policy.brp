-- Shared semantic type policy for Core stages.
--
-- These classifications affect lowering and ownership before backend
-- rendering, so they must not live in an emitter module.
import:
	../stage_06_typecheck/type_system/semantic_type: display_type_name
	../stage_06_typecheck/type_system/type_name_metadata as TypeNameMetadata
	ir:
		CoreDecl(HeapRecordDecl, UnionDecl),
		CoreDimOp(DimAdd, DimDivide, DimMultiply, DimSubtract),
		CoreImplDecl,
		CoreProgram,
		CoreReleasePolicy(
			ArcReleaseOnlyPolicy, ArcReleasePolicy, NoReleasePolicy, StackResultReleasePolicy,
		),
		CoreTensorDim(TensorDimOperation, TensorRuntimeDim, TensorStaticDim, TensorVariadicDim),
		CoreType(
			BoxedResultType, EnumType, FunctionType, HeapRecordType, NamedType, RangeType, SelfType,
			StackResultType, TensorType, TupleType, TypeParameterType, UnionType,
			VoidType,
		),
	set as Sets


CORE_MANAGED_TYPE_NAMES: List[String] = [
	"String",
	"Bytes",
	"List",
	"Dict",
	"Set",
	"Channel",
	"Fixed",
	"Tensor",
	"StringSlice",
	"Closure",
	"Regex",
	"Deque",
	"Heap",
	"Stream",
	"FallibleStream",
	"ResourceSource",
]

private RESOURCE_SOURCE_CORE_TYPE_NAME: String = "stream__ResourceSource"

private RECV_ATTEMPT_CORE_TYPE_NAME: String = "channel__RecvAttempt"

opaque type ManagedTypeIndex = Set[String]


pure func core_named_type_has_structural_equality(name: String) -> Bool:
	TypeNameMetadata.type_name_has_compiler_structural_equality(name)


pure func managed_type_index_from_names(names: List[String]) -> ManagedTypeIndex:
	var index: Set[String] = Sets.set()

	for name in names:
		index = Sets.add(index, name)

	into_opaque ManagedTypeIndex(index)


private pure func core_tensor_dim_has_unresolved_parameters(dim: CoreTensorDim) -> Bool:
	match dim:
		TensorRuntimeDim(_) | TensorVariadicDim(_):
			True
		TensorDimOperation(_, left, right):
			(
				core_tensor_dim_has_unresolved_parameters(left)
				or core_tensor_dim_has_unresolved_parameters(right)
			)
		TensorStaticDim(_):
			False


pure func core_type_has_unresolved_parameters(typ: CoreType) -> Bool:
	match typ:
		NamedType(_, args):
			args.any(core_type_has_unresolved_parameters)
		TypeParameterType(_) | SelfType:
			True
		FunctionType(_, params, return_type):
			(
				params.any(core_type_has_unresolved_parameters)
				or core_type_has_unresolved_parameters(return_type)
			)
		StackResultType(value_type, error_type) | BoxedResultType(value_type, error_type):
			(
				core_type_has_unresolved_parameters(value_type)
				or core_type_has_unresolved_parameters(error_type)
			)
		TensorType(info):
			(
				core_type_has_unresolved_parameters(info.element_type)
				or info.dims.any(core_tensor_dim_has_unresolved_parameters)
			)
		TupleType(items):
			items.any(core_type_has_unresolved_parameters)
		RangeType | VoidType | EnumType(_) | HeapRecordType(_) | UnionType(_):
			False


---
Post-monomorphization runtime tensor dimensions remain symbolic by design:
TensorRuntimeDim is the source `#_` wildcard and TensorVariadicDim is an
existential shape pack. Generic owner templates are excluded from the mono
invariant separately, so only element and ordinary type parameters are
unresolved at this boundary.
---
pure func core_type_has_unresolved_mono_parameters(typ: CoreType) -> Bool:
	match typ:
		NamedType(_, args):
			args.any(core_type_has_unresolved_mono_parameters)
		TypeParameterType(_) | SelfType:
			True
		FunctionType(_, params, return_type):
			(
				params.any(core_type_has_unresolved_mono_parameters)
				or core_type_has_unresolved_mono_parameters(return_type)
			)
		StackResultType(value_type, error_type) | BoxedResultType(value_type, error_type):
			(
				core_type_has_unresolved_mono_parameters(value_type)
				or core_type_has_unresolved_mono_parameters(error_type)
			)
		TensorType(info):
			core_type_has_unresolved_mono_parameters(info.element_type)
		TupleType(items):
			items.any(core_type_has_unresolved_mono_parameters)
		RangeType | VoidType | EnumType(_) | HeapRecordType(_) | UnionType(_):
			False


pure func core_impl_is_generic(implementation: CoreImplDecl) -> Bool:
	(
		not implementation.type_params.is_empty()
		or core_type_has_unresolved_parameters(implementation.for_type)
		or implementation.methods.any(pure func(method):
			not method.type_params.is_empty()
		)
	)


---
Type names as Core spells them (`NamedType`): bare for a type declared in
the module being lowered or listed by `is_global_abi_type_name`, otherwise the
flattened `module__Type` that `flatten_canonical_core_type_name` produces at
lowering. The `module::Type` spelling never reaches Core, so it is not
accepted here. `Stream` and `FallibleStream` are ABI-listed and always bare;
`ResourceSource` is not, so it is always the flattened spelling (a bare
`ResourceSource` is a type the module declared itself, never the stdlib one).
The typechecker-side spellings live in
`stage_06_typecheck/type_system/type_name_metadata.brp`.
---
pure func is_core_stream_type_name(name: String) -> Bool:
	name == "Stream"


pure func is_core_fallible_stream_type_name(name: String) -> Bool:
	name == "FallibleStream"


pure func is_core_one_shot_stream_type_name(name: String) -> Bool:
	is_core_stream_type_name(name) or is_core_fallible_stream_type_name(name)


pure func is_core_resource_source_type_name(name: String) -> Bool:
	name == RESOURCE_SOURCE_CORE_TYPE_NAME


---
`RecvAttempt` is read both as a lowered Core name (`channel__RecvAttempt`) and,
by union lowering, as the bare declaration name inside module `channel`.
---
pure func is_runtime_erased_union_payload_type_name(name: String) -> Bool:
	name == "RecvAttempt" or name == RECV_ATTEMPT_CORE_TYPE_NAME


pure func is_stack_result_type(typ: CoreType) -> Bool:
	match typ:
		NamedType(name, args):
			name == "Result" and args.length() == 2
		TypeParameterType(_) | SelfType:
			False
		StackResultType(_, _):
			True
		BoxedResultType(_, _):
			False
		FunctionType(_, _, _):
			False
		VoidType:
			False
		EnumType(_):
			False
		HeapRecordType(_):
			False
		UnionType(_):
			False
		RangeType:
			False
		TensorType(_):
			False
		TupleType(_):
			False


--- `name` spells a primitive type stored as an integer: the fixed-width integers,
--- `Bool` and `Char`.
pure func primitive_integer_type(name: String) -> Bool:
	(
		name == "Int"
		or name == "Int8"
		or name == "Int16"
		or name == "Int32"
		or name == "Int64"
		or name == "UInt8"
		or name == "UInt16"
		or name == "UInt32"
		or name == "UInt64"
		or name == "Bool"
		or name == "Char"
	)


--- `typ` is `Bool`, whether it is spelled as a named type or as the `Bool` enum.
pure func bool_type_is(typ: CoreType) -> Bool:
	match typ:
		NamedType("Bool", args):
			args.is_empty()
		EnumType("Bool"):
			True
		_:
			False


pure func managed_type_index(program: CoreProgram) -> ManagedTypeIndex:
	var names: Set[String] = Sets.from_list(CORE_MANAGED_TYPE_NAMES)

	for decl in program.decls:
		match decl:
			HeapRecordDecl(record_decl):
				names = Sets.add(names, record_decl.name)
			UnionDecl(union_decl):
				names = Sets.add(names, union_decl.name)
			_:
				void

	into_opaque ManagedTypeIndex(names)


private pure func is_managed_type_in_set(managed_names: Set[String], typ: CoreType) -> Bool:
	match typ:
		NamedType("Option", [payload_type]):
			match payload_type:
				NamedType("Option", _):
					True
				StackResultType(_, _):
					True
				BoxedResultType(_, _):
					True
				_:
					is_managed_type_in_set(managed_names, payload_type)
		NamedType(name, _):
			(
				Sets.contains(managed_names, name)
				or is_core_one_shot_stream_type_name(name)
				or is_core_resource_source_type_name(name)
			)
		TypeParameterType(_) | SelfType:
			False
		HeapRecordType(_) | UnionType(_) | BoxedResultType(_, _):
			True
		FunctionType(_, _, _) | TupleType(_) | TensorType(_):
			True
		StackResultType(ok_type, err_type):
			(
				is_managed_type_in_set(managed_names, ok_type)
				or is_managed_type_in_set(managed_names, err_type)
			)
		VoidType | EnumType(_) | RangeType:
			False


pure func is_managed_type(index: ManagedTypeIndex, typ: CoreType) -> Bool:
	managed_names = from_opaque ManagedTypeIndex(index)
	is_managed_type_in_set(managed_names, typ)


private pure func core_dim_op_to_string(op: CoreDimOp) -> String:
	match op:
		DimAdd:
			" + "
		DimSubtract:
			" - "
		DimMultiply:
			" * "
		DimDivide:
			" / "


private pure func core_tensor_dim_to_string(dim: CoreTensorDim) -> String:
	match dim:
		TensorStaticDim(value):
			"#" + value.to_string()
		TensorRuntimeDim(name):
			name
		TensorVariadicDim(name):
			name + "..."
		TensorDimOperation(op, left, right):
			core_tensor_dim_to_string(
				left,
			) + core_dim_op_to_string(op) + core_tensor_dim_to_string(right)


private pure func core_type_list_to_string(types: List[CoreType]) -> String:
	types
		.map(core_type_to_string)
		.join(", ")


pure func core_type_to_string(typ: CoreType) -> String:
	match typ:
		VoidType:
			"Void"
		NamedType(name, args):
			if args.is_empty():
				display_type_name(name)
			else if display_type_name(name) == "Tuple":
				"(" + core_type_list_to_string(args) + ")"
			else:
				display_type_name(name) + "[" + core_type_list_to_string(args) + "]"
		TypeParameterType(name):
			name
		SelfType:
			"Self"
		FunctionType(is_pure, params, return_type):
			prefix: String = if is_pure:
				"pure "
			else:
				""

			prefix + "(" + core_type_list_to_string(
				params,
			) + ") -> " + core_type_to_string(return_type)
		StackResultType(ok_type, err_type) | BoxedResultType(ok_type, err_type):
			"Result[" + core_type_to_string(ok_type) + ", " + core_type_to_string(err_type) + "]"
		EnumType(name) | HeapRecordType(name) | UnionType(name):
			display_type_name(name)
		RangeType:
			"Range"
		TensorType(info):
			core_type_to_string(info.element_type) + "[" + info.dims
				.map(core_tensor_dim_to_string)
				.join(", ") + "]"
		TupleType(items):
			"(" + core_type_list_to_string(items) + ")"


---
Nullable managed Options use the payload pointer directly for `Some` and
null for `None`. Keep their cleanup policy beside that representation fact
so heap-record fields and the C layout cannot disagree about ownership.
---
pure func nullable_managed_option_payload_release_policy(
	payload: CoreType,
) -> Option[CoreReleasePolicy]:
	match payload:
		NamedType(name, args):
			if (
				(name == "String" or name == "LiteralString" or name == "Bytes" or name == "Fixed")
				and args.is_empty()
			):
				Some(ArcReleaseOnlyPolicy)
			else if (
				name == "List" and args.length() == 1
				or name == "Dict" and args.length() == 2
				or name == "Set" and args.length() == 1
				or name == "Channel" and args.length() == 1
				or is_core_resource_source_type_name(name)
				or is_core_stream_type_name(name) and args.length() == 1
				or is_core_fallible_stream_type_name(name) and args.length() == 2
				or (
					(
						name == "TcpListener"
						or name == "TcpStream"
						-- `UdpSocket` is on `is_global_abi_type_name`, but `net/udp` is not a std
						-- module (it is a `pkg/` module), so ABI bareness does not apply: importers
						-- see `net/udp::UdpSocket`, which flattens to `net_udp__UdpSocket`, and the
						-- declaring module sees the bare name. `TlsSession` and `WebSocketSession`
						-- are not ABI-listed and behave the same way, so all three keep both spellings.
						or name == "TlsSession"
						or name == "net_tls__TlsSession"
						or name == "WebSocketSession"
						or name == "net_websocket__WebSocketSession"
						or name == "UdpSocket"
						or name == "net_udp__UdpSocket"
					)
					and args.is_empty()
				)
			):
				Some(ArcReleasePolicy)
			else:
				None
		HeapRecordType(_) | UnionType(_) | TensorType(_) | TupleType(_) | FunctionType(_, _, _):
			Some(ArcReleasePolicy)
		TypeParameterType(_) | SelfType | StackResultType(_, _) | BoxedResultType(_, _) | VoidType | EnumType(_) | RangeType:
			None


pure func cleanup_release_policy_for_type(typ: CoreType) -> CoreReleasePolicy:
	if is_stack_result_type(typ):
		StackResultReleasePolicy
	else:
		match typ:
			NamedType(name, args):
				if name == "Option":
					match args:
						[payload]:
							match nullable_managed_option_payload_release_policy(payload):
								Some(policy):
									policy
								None:
									NoReleasePolicy
						_:
							NoReleasePolicy
				else if (
					((
						name == "String"
						or name == "LiteralString"
						or name == "Bytes"
						or name == "Fixed"
					))
					and args.is_empty()
				):
					ArcReleaseOnlyPolicy
				else if (
					name == "List" and args.length() == 1
					or name == "Dict" and args.length() == 2
					or name == "Set" and args.length() == 1
					or name == "Channel" and args.length() == 1
					or name == "Closure" and args.is_empty()
					or is_core_resource_source_type_name(name)
					or is_core_stream_type_name(name) and args.length() == 1
					or is_core_fallible_stream_type_name(name) and args.length() == 2
					or (
						((
							name == "TcpListener"
							or name == "TcpStream"
							or name == "TlsSession"
							or name == "WebSocketSession"
						))
						and args.is_empty()
					)
				):
					ArcReleasePolicy
				else:
					NoReleasePolicy
			TypeParameterType(_) | SelfType:
				NoReleasePolicy
			StackResultType(_, _):
				StackResultReleasePolicy
			BoxedResultType(_, _):
				ArcReleasePolicy
			FunctionType(_, _, _):
				ArcReleasePolicy
			HeapRecordType(_):
				ArcReleasePolicy
			UnionType(_):
				ArcReleasePolicy
			TensorType(_):
				ArcReleasePolicy
			TupleType(_):
				ArcReleasePolicy
			VoidType:
				NoReleasePolicy
			EnumType(_):
				NoReleasePolicy
			RangeType:
				NoReleasePolicy


--- `policy` makes a value release something when it dies.
pure func release_policy_requires_release(policy: CoreReleasePolicy) -> Bool:
	match policy:
		NoReleasePolicy:
			False
		ArcReleasePolicy:
			True
		ArcReleaseOnlyPolicy:
			True
		StackResultReleasePolicy:
			True


---
Conservative ownership-work classification for today's Core value fields.
The three existing authorities are not identical: nullable payload policy
knows some flattened resource handle names omitted by the direct cleanup
policy, while the managed index knows declared heap records. This does not
select a release ABI for a future owned-inline field.
---
pure func core_type_requires_ownership(index: ManagedTypeIndex, typ: CoreType) -> Bool:
	if is_managed_type(index, typ) or release_policy_requires_release(cleanup_release_policy_for_type(typ)):
		True
	else:
		match nullable_managed_option_payload_release_policy(typ):
			Some(policy):
				release_policy_requires_release(policy)
			None:
				False
