@debug_only
pure func register_perceus_work_counters() -> Int:
	debug:
		perceus_work_counters_register()

	0


private record SimpleConsumedParameterCatalog {
	all_parameter_names: Dict[String, Bool],
	consumed_indices_by_name: Dict[String, Int],
	consumed_parameter_count: Int
}


private enum SimpleConsumedParameterBalance:
	UnsupportedSimpleConsumedParameterBalance
	UnchangedSimpleConsumedParameterBalance


private union SimpleConsumedParameterScanStack:
	SimpleConsumedParameterScanComplete
	SimpleConsumedParameterScanMore(CoreExpr, SimpleConsumedParameterScanStack)


private union TemporaryBindingContractPlan:
	BalancedTemporaryBindingContract(OwnershipCallContract)
	ExplicitDropTemporaryBindingContract(OwnershipCallContract)


private record PerceusManagedLetPlan {
	source: CoreExpr,
	variable: CoreVar,
	is_mutable: Bool,
	bind_type: CoreType,
	source_rhs: CoreExpr,
	source_body: CoreExpr,
	owned_rhs: CoreExpr,
	owned_rhs_reuses_source: Bool,
	branch_safe_body: CoreExpr,
	branch_safe_body_reuses_source: Bool
}


-- The iterative insertion traversal maintains one exact occurrence index for
-- all visited expressions. Keeping the index out of individual frame results
-- avoids retaining and merging a persistent map at every Core binding.
private record PerceusResolvedValueIndex {
	occurrences_by_def_id_by_uniq_by_name: Dict[String, Dict[Int, Dict[Int, Int]]]
}


private record PerceusDirectConsume {
	variable: CoreVar
}


-- Carry source identity in the result Perceus already needs for direct-consume
-- metadata. A separate Changed/Unchanged union would allocate another wrapper
-- at every visited node. `reuses_source` is intentionally exact: opaque helper
-- families report False even when their rebuilt value serializes identically.
private record PerceusInsertedExpr {
	expr: CoreExpr,
	direct_consume: Option[PerceusDirectConsume],
	reuses_source: Bool
}


-- Fieldless unchanged cases avoid allocating a result wrapper for the common
-- identity path. A changed case alone carries the replacement collection.
private union PerceusAggregateExprsRewrite:
	UnchangedPerceusAggregateExprs
	ChangedPerceusAggregateExprs(List[CoreExpr])


private union PerceusAggregateRecordFieldsRewrite:
	UnchangedPerceusAggregateRecordFields
	ChangedPerceusAggregateRecordFields(List[CoreRecordFieldValue])


private union PerceusAggregateCowFieldsRewrite:
	UnchangedPerceusAggregateCowFields
	ChangedPerceusAggregateCowFields(List[CoreRecordCowField])


private union PerceusAggregateBoxedValuesRewrite:
	UnchangedPerceusAggregateBoxedValues
	ChangedPerceusAggregateBoxedValues(List[CoreBoxedStorageValue])


private union PerceusAggregateDictEntriesRewrite:
	UnchangedPerceusAggregateDictEntries
	ChangedPerceusAggregateDictEntries(List[CoreDictEntry])


private union PerceusAggregateBoxedValueRewrite:
	UnchangedPerceusAggregateBoxedValue
	ChangedPerceusAggregateBoxedValue(CoreBoxedStorageValue)


-- The fieldless identity result lets fixed-arity normalization avoid allocating
-- a replacement root or a result payload on its common unchanged path.
private union PerceusOwnershipNormalization:
	UnchangedPerceusOwnershipNormalization
	ChangedPerceusOwnershipNormalization(CoreExpr)


--- The insertion walk's explicit stack of bindings it has descended through.
--- Each frame carries the rest of the stack as its last field rather than
--- sitting inside a separate cons cell, so a push costs one allocation.
private union PerceusInsertBindingFrameStack:
	PerceusInsertNoBindingFrame
	PerceusInsertManagedLetRhsFrame(PerceusManagedLetPlan, PerceusInsertBindingFrameStack)
	PerceusInsertManagedLetBodyFrame(PerceusManagedLetPlan, PerceusInsertedExpr, PerceusInsertBindingFrameStack)
	PerceusInsertLetRhsFrame(CoreExpr, CoreVar, Bool, CoreType, CoreExpr, PerceusInsertBindingFrameStack)
	PerceusInsertLetBodyFrame(CoreExpr, CoreVar, Bool, CoreType, PerceusInsertedExpr, PerceusInsertBindingFrameStack)
	PerceusInsertBorrowLetRhsFrame(CoreExpr, CoreVar, CoreType, CoreExpr, PerceusInsertBindingFrameStack)
	PerceusInsertBorrowLetBodyFrame(CoreExpr, CoreVar, CoreType, PerceusInsertedExpr, PerceusInsertBindingFrameStack)
	PerceusInsertSequenceFirstFrame(CoreExpr, CoreExpr, PerceusInsertBindingFrameStack)
	PerceusInsertSequenceSecondFrame(CoreExpr, PerceusInsertedExpr, PerceusInsertBindingFrameStack)
	PerceusInsertAssignRhsFrame(CoreVar, CoreType, CoreSourceLoc, PerceusInsertBindingFrameStack)


private PERCEUS_LOCAL_PREFIX: String = "$blorp$perceus$"

private OWNED_RESULT_TEMP_NAME: String = PERCEUS_LOCAL_PREFIX + "owned_result"


private record SyntheticOwnershipBinding {
	variable: CoreVar,
	typ: CoreType,
	rhs: CoreExpr
}


private record PreparedTemporaryCall {
	bindings: List[SyntheticOwnershipBinding],
	call: CoreExpr
}


private record PreparedBorrowedArgument {
	bindings: List[SyntheticOwnershipBinding],
	expr: CoreExpr
}


private record MaterializedBorrowedTemporary {
	expr: CoreExpr,
	is_owned: Bool
}


private pure func direct_field_alias(expr: CoreExpr) -> Bool:
	match expr:
		FieldExpr(VarExpr(variable, owner_type, owner_loc), field, typ, loc):
			True
		FieldExpr(owner, field, typ, loc):
			direct_field_alias(owner)
		TupleFieldExpr(VarExpr(variable, owner_type, owner_loc), field_index, typ, loc):
			True
		TupleFieldExpr(owner, field_index, typ, loc):
			direct_field_alias(owner)
		_:
			False


pure func synthetic_binding_var(prefix: String, index: Int, loc: CoreSourceLoc) -> CoreVar:
	location_suffix: String = match loc:
		KnownSourceLoc(_, line, column, _, _):
			"_${line}_${column}"
		SyntheticSourceLoc:
			""

	{
		name = "__${prefix}${location_suffix}_${index}",
		uniq = index,
		def_id = None
	}


private pure func wrap_synthetic_bindings(
	bindings: List[SyntheticOwnershipBinding],
	body: CoreExpr,
) -> CoreExpr:
	var result: CoreExpr = body
	var index: Int = bindings.length() - 1

	while index >= 0:
		match bindings.get(index):
			Some(binding):
				result = LetExpr(binding.variable, False, binding.typ, binding.rhs, result)
			None:
				void

		index -= 1

	result


private pure func wrap_borrowed_owned_temporary_bindings(
	bindings: List[SyntheticOwnershipBinding],
	body: CoreExpr,
) -> CoreExpr:
	var result: CoreExpr = body
	var index: Int = bindings.length() - 1

	while index >= 0:
		match bindings.get(index):
			Some(binding):
				borrowed_view: CoreVar = {
					name = "${binding.variable.name}_view",
					uniq = binding.variable.uniq,
					def_id = None
				}
				dropped_result: CoreExpr = drop_after_body(1, binding.variable, binding.typ, result)
				borrowed_scope: CoreExpr = BorrowLetExpr(
					borrowed_view,
					binding.typ,
					VarExpr(binding.variable, binding.typ, SyntheticSourceLoc),
					dropped_result,
				)
				result = LetExpr(binding.variable, False, binding.typ, binding.rhs, borrowed_scope)
			None:
				void

		index -= 1

	result


private pure func is_collection_type(typ: CoreType) -> Bool:
	match typ:
		NamedType(name, args):
			name == "List" or name == "Dict" or name == "Set"
		_:
			False


pure func is_consuming_collection_equality(
	op: CoreBinaryOp,
	left: CoreExpr,
	right: CoreExpr,
) -> Bool:
	match op:
		EqualOp:
			is_collection_type(core_expr_type(left)) or is_collection_type(core_expr_type(right))
		NotEqualOp:
			is_collection_type(core_expr_type(left)) or is_collection_type(core_expr_type(right))
		_:
			False


pure func binary_operands_are_borrowed(
	op: CoreBinaryOp,
	left: CoreExpr,
	right: CoreExpr,
) -> Bool:
	-- Core binary operators inspect their operands. Collection equality is the
	-- sole exception because its runtime helpers consume both collections.
	not is_consuming_collection_equality(op, left, right)


private pure func protect_consuming_call_field_aliases(env: PerceusEnv, expr: CoreExpr) -> CoreExpr:
	match expr:
		CallExpr(kind, callee, args, typ, loc):
			match contract_for_call(env, kind, args.length(), typ):
				Some(contract):
					var bindings: List[SyntheticOwnershipBinding] = []
					var rewritten_args: List[CoreExpr] = []
					var index: Int = 0

					for arg in args:
						match contract.args.get(index):
							Some(mode):
								arg_type: CoreType = core_expr_type(arg)

								if (
									arg_consumes_caller(mode)
									and is_managed_type(env, arg_type)
									and direct_field_alias(arg)
								):
									temp: CoreVar = synthetic_binding_var("cow_arg", index, loc)
									bindings = bindings.append({
										variable = temp,
										typ = arg_type,
										rhs = arg,
									})
									rewritten_args = rewritten_args.append(
										VarExpr(
											temp,
											arg_type,
											loc,
										),
									)
								else:
									rewritten_args = rewritten_args.append(arg)
							None:
								rewritten_args = rewritten_args.append(arg)

						index += 1

					wrap_synthetic_bindings(
						bindings,
						CallExpr(kind, callee, rewritten_args, typ, loc),
					)
				None:
					expr
		_:
			expr


private pure func call_result_is_owned(
	env: PerceusEnv,
	kind: CoreCallKind,
	args: List[CoreExpr],
	return_type: CoreType,
) -> Bool:
	match contract_for_call(env, kind, args.length(), return_type):
		Some(contract):
			match contract.result:
				ReturnOwned:
					True
				_:
					False
		None:
			is_managed_type(env, return_type)


private pure func is_closure_call(kind: CoreCallKind) -> Bool:
	match kind:
		ClosureCall:
			True
		_:
			False


private pure func owned_names_add(owned: List[String], name: String) -> List[String]:
	if owned.contains(name):
		owned
	else:
		owned.append(name)


private pure func owned_names_remove(owned: List[String], name: String) -> List[String]:
	var remaining: List[String] = []

	for item in owned:
		if item != name:
			remaining = remaining.append(item)
		else:
			void

	remaining


pure func retained_core_var_from_effect(expr: CoreExpr) -> Option[CoreVar]:
	match expr:
		ListRetainExpr(retain, typ, loc):
			if retain.value.needs_release:
				match retain.value.value:
					VarExpr(value, value_type, value_loc):
						Some(value)
					_:
						None
			else:
				None
		CallExpr(IntrinsicCall(name), callee, args, return_type, call_loc):
			match args.get(1):
				Some(VarExpr(value, typ, loc)):
					if (
						name == "list_retain_for"
						or name == "dict_retain_key_for"
						or name == "dict_retain_value_for"
						or name == "set_retain_key_for"
					):
						Some(value)
					else:
						None
				_:
					None
		_:
			None


private pure func retained_var_from_effect(expr: CoreExpr) -> Option[String]:
	match retained_core_var_from_effect(expr):
		Some(variable):
			Some(variable.name)
		None:
			None


private pure func is_owned_temporary_with_names(
	env: PerceusEnv,
	owned: List[String],
	expr: CoreExpr,
) -> Bool:
	typ: CoreType = core_expr_type(expr)

	var_is_owned: Bool = match expr:
		VarExpr(variable, var_type, loc):
			owned.contains(variable.name)
		_:
			False

	if var_is_owned:
		True
	else if not is_managed_type(env, typ):
		False
	else:
		match expr:
			VarExpr(variable, var_type, loc):
				False
			LiteralExpr(StringLiteral(value), literal_type, loc):
				True
			StaticStringLiteralExpr(id, value, literal_type, loc):
				False
			CallExpr(kind, callee, args, return_type, loc):
				call_result_is_owned(env, kind, args, return_type)
			CastExpr(inner, cast_type, loc):
				match inner:
					CallExpr(kind, callee, args, return_type, call_loc):
						(
							call_result_is_owned(env, kind, args, cast_type)
							or is_owned_temporary_with_names(env, owned, inner)
						)
					_:
						is_owned_temporary_with_names(env, owned, inner)
			UnboxExpr(kind, inner, unbox_type, loc):
				match inner:
					CallExpr(call_kind, callee, args, return_type, call_loc):
						(
							call_result_is_owned(env, call_kind, args, unbox_type)
							or is_owned_temporary_with_names(env, owned, inner)
						)
					_:
						is_owned_temporary_with_names(env, owned, inner)
			LetExpr(variable, is_mutable, bind_type, rhs, body):
				next_owned: List[String] = if not is_mutable and is_managed_type(env, bind_type):
					owned_names_add(owned, variable.name)
				else:
					owned_names_remove(owned, variable.name)

				is_owned_temporary_with_names(env, next_owned, body)
			BorrowLetExpr(variable, bind_type, rhs, body):
				is_owned_temporary_with_names(
					env,
					owned_names_remove(owned, variable.name),
					body,
				)
			SeqExpr(first, second):
				next_owned: List[String] = match retained_var_from_effect(first):
					Some(name):
						owned_names_add(owned, name)
					None:
						owned

				is_owned_temporary_with_names(env, next_owned, second)
			IfExpr(cond, then_expr, else_expr, result_type, loc):
				(
					is_owned_temporary_with_names(env, owned, then_expr)
					and is_owned_temporary_with_names(env, owned, else_expr)
				)
			DupExpr(variable, value_type, retain_policy, body, result_type, loc):
				next_owned: List[String] = if is_managed_type(env, value_type):
					owned_names_add(owned, variable.name)
				else:
					owned

				is_owned_temporary_with_names(env, next_owned, body)
			DropExpr(variable, value_type, release_policy, body, result_type, loc):
				is_owned_temporary_with_names(
					env,
					owned_names_remove(owned, variable.name),
					body,
				)
			ListConstructExpr(construct, result_type, loc):
				True
			TensorBoxedLiteralExpr(literal, result_type, loc):
				True
			DictConstructExpr(construct, result_type, loc):
				True
			TupleExpr(items, result_type, loc):
				True
			VectorExpr(items, result_type, loc):
				True
			RecordExpr(fields, result_type, loc):
				True
			RecordUpdateExpr(base, fields, result_type, loc):
				True
			RecordReuseExpr(source, fields, result_type, loc):
				True
			RecordCowUpdateExpr(source, fields, result_type, loc):
				True
			RecordConstructExpr(type_name, fields, result_type, loc):
				True
			UnionConstructExpr(construct, result_type, loc):
				True
			ListHandoffExpr(handoff, result_type, loc):
				True
			LambdaExpr(params, return_type, body, is_pure, result_type, loc):
				CoreClosure.lambda_has_runtime_captures(
					env.function_definitions,
					env.constructor_definitions,
					params,
					body,
				)
			ClosureCreateExpr(closure, result_type, loc):
				closure.captures.length() > 0
			_:
				False


private pure func is_owned_temporary_expr(env: PerceusEnv, expr: CoreExpr) -> Bool:
	is_owned_temporary_with_names(env, [], expr)


private pure func borrowed_temporary_result(
	env: PerceusEnv,
	owned: List[String],
	expr: CoreExpr,
) -> MaterializedBorrowedTemporary:
	{
		expr = expr,
		is_owned = is_owned_temporary_with_names(env, owned, expr)
	}


-- Call normalization visits a call before its argument expressions. Rewrite
-- only result-producing paths here so projections rooted in temporaries become
-- independent owners before the borrowing call. Lexical owned names are carried
-- through wrappers without changing the return-side temporary predicate. Depth
-- keeps nested synthetic owners distinct; sibling branches may safely reuse it.
private pure func materialize_borrowed_temporary_with_names(
	env: PerceusEnv,
	owned: List[String],
	depth: Int,
	expr: CoreExpr,
) -> MaterializedBorrowedTemporary:
	match expr:
		FieldExpr(owner, field, typ, loc):
			owner_result: MaterializedBorrowedTemporary = materialize_borrowed_temporary_with_names(
				env,
				owned,
				depth + 1,
				owner,
			)

			projection: CoreExpr = FieldExpr(owner_result.expr, field, typ, loc)

			if owner_result.is_owned:
				borrowed_temporary_result(
					env,
					owned,
					materialize_owned_temporary_field_projection(env, projection, depth),
				)
			else:
				borrowed_temporary_result(env, owned, projection)
		TupleFieldExpr(owner, field_index, typ, loc):
			owner_result: MaterializedBorrowedTemporary = materialize_borrowed_temporary_with_names(
				env,
				owned,
				depth + 1,
				owner,
			)

			projection: CoreExpr = TupleFieldExpr(owner_result.expr, field_index, typ, loc)

			if owner_result.is_owned:
				borrowed_temporary_result(
					env,
					owned,
					materialize_owned_temporary_field_projection(env, projection, depth),
				)
			else:
				borrowed_temporary_result(env, owned, projection)
		CastExpr(inner, typ, loc):
			inner_result: MaterializedBorrowedTemporary = materialize_borrowed_temporary_with_names(
				env,
				owned,
				depth + 1,
				inner,
			)

			if inner_result.is_owned and is_managed_type(env, typ):
				source_type: CoreType = core_expr_type(inner_result.expr)
				source: CoreVar = synthetic_binding_var("owned_cast_source", depth, loc)
				cast_result: CoreExpr = CastExpr(
					VarExpr(source, source_type, loc),
					typ,
					loc,
				)
				borrowed_temporary_result(
					env,
					owned,
					LetExpr(
						source,
						False,
						source_type,
						inner_result.expr,
						retain_alias_as_owned(cast_result),
					),
				)
			else:
				borrowed_temporary_result(
					env,
					owned,
					CastExpr(inner_result.expr, typ, loc),
				)
		UnboxExpr(kind, inner, typ, loc):
			inner_result: MaterializedBorrowedTemporary = materialize_borrowed_temporary_with_names(
				env,
				owned,
				depth + 1,
				inner,
			)

			borrowed_temporary_result(
				env,
				owned,
				UnboxExpr(kind, inner_result.expr, typ, loc),
			)
		LetExpr(variable, is_mutable, bind_type, rhs, body):
			next_owned: List[String] = if not is_mutable and is_managed_type(env, bind_type):
				owned_names_add(owned, variable.name)
			else:
				owned_names_remove(owned, variable.name)

			body_result: MaterializedBorrowedTemporary = materialize_borrowed_temporary_with_names(
				env,
				next_owned,
				depth + 1,
				body,
			)

			-- Result-preserving wrappers have the ownership of their result child.
			-- Preserve the recursive answer: reclassifying the rebuilt wrapper loses
			-- ownership for match forms that were normalized during this traversal.
			{
				expr = LetExpr(variable, is_mutable, bind_type, rhs, body_result.expr),
				is_owned = body_result.is_owned
			}
		BorrowLetExpr(variable, bind_type, rhs, body):
			body_result: MaterializedBorrowedTemporary = materialize_borrowed_temporary_with_names(
				env,
				owned_names_remove(owned, variable.name),
				depth + 1,
				body,
			)

			{
				expr = BorrowLetExpr(variable, bind_type, rhs, body_result.expr),
				is_owned = body_result.is_owned
			}
		SeqExpr(first, second):
			next_owned: List[String] = match retained_var_from_effect(first):
				Some(name):
					owned_names_add(owned, name)
				None:
					owned

			second_result: MaterializedBorrowedTemporary = materialize_borrowed_temporary_with_names(
				env,
				next_owned,
				depth + 1,
				second,
			)

			{
				expr = SeqExpr(first, second_result.expr),
				is_owned = second_result.is_owned
			}
		IfExpr(cond, then_expr, else_expr, typ, loc):
			then_result: MaterializedBorrowedTemporary = materialize_borrowed_temporary_with_names(
				env,
				owned,
				depth + 1,
				then_expr,
			)

			else_result: MaterializedBorrowedTemporary = materialize_borrowed_temporary_with_names(
				env,
				owned,
				depth + 1,
				else_expr,
			)

			if then_result.is_owned or else_result.is_owned:
				owned_then: CoreExpr = if then_result.is_owned:
					then_result.expr
				else:
					normalize_scoped_binding_alias_result(env, [], then_result.expr)

				owned_else: CoreExpr = if else_result.is_owned:
					else_result.expr
				else:
					normalize_scoped_binding_alias_result(env, [], else_result.expr)

				{
					expr = IfExpr(cond, owned_then, owned_else, typ, loc),
					is_owned = True
				}
			else:
				{
					expr = IfExpr(cond, then_result.expr, else_result.expr, typ, loc),
					is_owned = False
				}
		ListGetExpr(get, typ, loc):
			list_result: MaterializedBorrowedTemporary = materialize_borrowed_temporary_with_names(
				env,
				owned,
				depth + 1,
				get.list,
			)

			if list_result.is_owned:
				source_type: CoreType = core_expr_type(list_result.expr)
				source: CoreVar = synthetic_binding_var("owned_list_get_source", depth, loc)
				projected: CoreExpr = ListGetExpr(
					{ get | list = VarExpr(source, source_type, loc) },
					typ,
					loc,
				)

				owned_projection: CoreExpr = if is_managed_type(env, typ):
					retain_alias_as_owned(projected)
				else:
					projected

				borrowed_temporary_result(
					env,
					owned,
					LetExpr(source, False, source_type, list_result.expr, owned_projection),
				)
			else:
				borrowed_temporary_result(
					env,
					owned,
					ListGetExpr({ get | list = list_result.expr }, typ, loc),
				)
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			materialize_borrowed_match_temporary(env, expr, typ)
		AccessorLiteralMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			materialize_borrowed_match_temporary(env, expr, typ)
		LengthMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			materialize_borrowed_match_temporary(env, expr, typ)
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			materialize_borrowed_match_temporary(env, expr, typ)
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			next_owned: List[String] = if is_managed_type(env, value_type):
				owned_names_add(owned, variable.name)
			else:
				owned

			body_result: MaterializedBorrowedTemporary = materialize_borrowed_temporary_with_names(
				env,
				next_owned,
				depth + 1,
				body,
			)

			{
				expr = DupExpr(variable, value_type, retain_policy, body_result.expr, typ, loc),
				is_owned = body_result.is_owned
			}
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			body_result: MaterializedBorrowedTemporary = materialize_borrowed_temporary_with_names(
				env,
				owned_names_remove(owned, variable.name),
				depth + 1,
				body,
			)

			{
				expr = DropExpr(variable, value_type, release_policy, body_result.expr, typ, loc),
				is_owned = body_result.is_owned
			}
		_:
			borrowed_temporary_result(env, owned, expr)


private pure func materialize_borrowed_temporary(
	env: PerceusEnv,
	expr: CoreExpr,
) -> MaterializedBorrowedTemporary:
	materialize_borrowed_temporary_with_names(env, [], 0, expr)


private pure func materialize_borrowed_match_result(
	env: PerceusEnv,
	bindings: List[CoreMatchBinding],
	result: CoreExpr,
) -> CoreExpr:
	materialized: MaterializedBorrowedTemporary = materialize_borrowed_temporary(env, result)

	if materialized.is_owned:
		materialized.expr
	else:
		normalize_scoped_binding_alias_result(env, bindings, materialized.expr)


private pure func materialize_borrowed_match_temporary(
	env: PerceusEnv,
	expr: CoreExpr,
	typ: CoreType,
) -> MaterializedBorrowedTemporary:
	rewritten: CoreExpr = CoreTraverse.map_core_match_results_with_context(
		expr,
		env,
		materialize_borrowed_match_result,
	)

	if is_managed_type(env, typ):
		{
			expr = rewritten,
			is_owned = True
		}
	else:
		borrowed_temporary_result(env, [], rewritten)


private pure func is_immortal_value_expr(env: PerceusEnv, expr: CoreExpr) -> Bool:
	match expr:
		StaticStringLiteralExpr(id, value, typ, loc):
			True
		LambdaExpr(params, return_type, body, is_pure, typ, loc):
			not CoreClosure.lambda_has_runtime_captures(
				env.function_definitions,
				env.constructor_definitions,
				params,
				body,
			)
		ClosureCreateExpr(closure, typ, loc):
			closure.captures.length() == 0
		_:
			False


private pure func contract_for_temporary_binding(
	env: PerceusEnv,
	kind: CoreCallKind,
	arg_count: Int,
	return_type: CoreType,
) -> Option[TemporaryBindingContractPlan]:
	match contract_for_call(env, kind, arg_count, return_type):
		Some(contract):
			Some(BalancedTemporaryBindingContract(contract))
		None:
			match kind:
				UserCall(name, def_id, consumed_args):
					match lookup_user_call_contract(env, name, def_id, arg_count, return_type):
						Some(contract):
							Some(ExplicitDropTemporaryBindingContract(contract))
						None:
							None
				_:
					None


private pure func temporary_binding_plan_contract(
	plan: TemporaryBindingContractPlan,
) -> OwnershipCallContract:
	match plan:
		BalancedTemporaryBindingContract(contract):
			contract
		ExplicitDropTemporaryBindingContract(contract):
			contract


private pure func temporary_binding_plan_uses_explicit_drop(
	plan: TemporaryBindingContractPlan,
) -> Bool:
	match plan:
		BalancedTemporaryBindingContract(contract):
			False
		ExplicitDropTemporaryBindingContract(contract):
			True


private pure func borrowed_temporary_view_var(variable: CoreVar) -> CoreVar:
	{
		name = "${variable.name}_view",
		uniq = variable.uniq,
		def_id = None
	}


private pure func temporary_call_var(variable: CoreVar, use_borrowed_views: Bool) -> CoreVar:
	if use_borrowed_views:
		borrowed_temporary_view_var(variable)
	else:
		variable


private pure func prepare_materialized_borrowed_argument(
	arg: CoreExpr,
	index: Int,
	loc: CoreSourceLoc,
	use_borrowed_views: Bool,
	materialized: MaterializedBorrowedTemporary,
) -> PreparedBorrowedArgument:
	if materialized.is_owned:
		temp: CoreVar = synthetic_binding_var("borrow_arg", index, loc)
		arg_type: CoreType = core_expr_type(arg)
		{
			bindings = [
				{
					variable = temp,
					typ = arg_type,
					rhs = materialized.expr
				},
			],
			expr = VarExpr(
				temporary_call_var(temp, use_borrowed_views),
				arg_type,
				loc,
			)
		}
	else:
		-- An unmanaged projection can still carry a lexical binding that
		-- releases its managed source after copying the projected value.
		{
			bindings = [],
			expr = materialized.expr
		}


private pure func prepare_borrowed_argument(
	env: PerceusEnv,
	arg: CoreExpr,
	index: Int,
	loc: CoreSourceLoc,
	use_borrowed_views: Bool,
) -> PreparedBorrowedArgument:
	match arg:
		CastExpr(inner, cast_type, cast_loc):
			inner_result: MaterializedBorrowedTemporary = materialize_borrowed_temporary(env, inner)

			if inner_result.is_owned and not is_managed_type(env, cast_type):
				-- A raw cast is a view of its source. Keep the managed source
				-- outside the call so the view cannot outlive its owner during
				-- argument evaluation.
				source_type: CoreType = core_expr_type(inner_result.expr)
				source: CoreVar = synthetic_binding_var("borrow_cast_source", index, loc)
				{
					bindings = [
						{
							variable = source,
							typ = source_type,
							rhs = inner_result.expr
						},
					],
					expr = CastExpr(
						VarExpr(
							temporary_call_var(source, use_borrowed_views),
							source_type,
							cast_loc,
						),
						cast_type,
						cast_loc,
					)
				}
			else:
				prepare_materialized_borrowed_argument(
					arg,
					index,
					loc,
					use_borrowed_views,
					materialize_borrowed_temporary(env, arg),
				)
		_:
			prepare_materialized_borrowed_argument(
				arg,
				index,
				loc,
				use_borrowed_views,
				materialize_borrowed_temporary(env, arg),
			)


private pure func bind_borrowed_owned_temporary_binary_operands(
	env: PerceusEnv,
	expr: CoreExpr,
) -> CoreExpr:
	match expr:
		BinaryExpr(op, left, right, typ, loc):
			if binary_operands_are_borrowed(op, left, right):
				prepared_left: PreparedBorrowedArgument = prepare_borrowed_argument(
					env,
					left,
					0,
					loc,
					False,
				)
				prepared_right: PreparedBorrowedArgument = prepare_borrowed_argument(
					env,
					right,
					1,
					loc,
					False,
				)
				wrap_synthetic_bindings(
					prepared_left.bindings.concat(prepared_right.bindings),
					BinaryExpr(op, prepared_left.expr, prepared_right.expr, typ, loc),
				)
			else:
				expr
		_:
			expr


private pure func binary_operand_has_trivial_unmanaged_materialization(
	env: PerceusEnv,
	expr: CoreExpr,
) -> Bool:
	if is_managed_type(env, core_expr_type(expr)):
		False
	else:
		match expr:
			LiteralExpr(_, _, _) | StaticStringLiteralExpr(_, _, _, _) | VarExpr(_, _, _) | VoidExpr(_, _):
				True
			CallExpr(kind, _, args, return_type, _):
				match contract_for_call(env, kind, args.length(), return_type):
					Some(contract):
						match contract.result:
							ReturnPrimitive | ReturnVoid:
								True
							_:
								False
					None:
						False
			_:
				False


private pure func normalize_binary_ownership_change_aware(
	env: PerceusEnv,
	source: CoreExpr,
) -> PerceusOwnershipNormalization:
	match source:
		BinaryExpr(op, left, right, typ, loc):
			if is_consuming_collection_equality(op, left, right):
				left_type: CoreType = core_expr_type(left)
				right_type: CoreType = core_expr_type(right)
				left_needs_protection: Bool = (
					is_managed_type(env, left_type)
					and direct_field_alias(left)
				)
				right_needs_protection: Bool = (
					is_managed_type(env, right_type)
					and direct_field_alias(right)
				)

				if not left_needs_protection and not right_needs_protection:
					UnchangedPerceusOwnershipNormalization
				else:
					var bindings: List[SyntheticOwnershipBinding] = []
					var protected_left: CoreExpr = left
					var protected_right: CoreExpr = right

					if left_needs_protection:
						left_temp: CoreVar = synthetic_binding_var("equality_arg", 0, loc)
						bindings = bindings.append({
							variable = left_temp,
							typ = left_type,
							rhs = left,
						})
						protected_left = VarExpr(left_temp, left_type, loc)
					else:
						void

					if right_needs_protection:
						right_temp: CoreVar = synthetic_binding_var("equality_arg", 1, loc)
						bindings = bindings.append({
							variable = right_temp,
							typ = right_type,
							rhs = right,
						})
						protected_right = VarExpr(right_temp, right_type, loc)
					else:
						void

					ChangedPerceusOwnershipNormalization(
						wrap_synthetic_bindings(
							bindings,
							BinaryExpr(op, protected_left, protected_right, typ, loc),
						),
					)
			else if (
				binary_operand_has_trivial_unmanaged_materialization(env, left)
				and binary_operand_has_trivial_unmanaged_materialization(env, right)
			):
				UnchangedPerceusOwnershipNormalization
			else:
				ChangedPerceusOwnershipNormalization(
					bind_borrowed_owned_temporary_binary_operands(
						env,
						source,
					),
				)
		_:
			ChangedPerceusOwnershipNormalization(source)


private pure func prepare_borrowed_owned_temporary_call(
	env: PerceusEnv,
	kind: CoreCallKind,
	callee: CoreExpr,
	args: List[CoreExpr],
	typ: CoreType,
	loc: CoreSourceLoc,
	contract: OwnershipCallContract,
	use_borrowed_views: Bool,
) -> PreparedTemporaryCall:
	var bindings: List[SyntheticOwnershipBinding] = []
	var rewritten_args: List[CoreExpr] = []
	var index: Int = 0

	rewritten_callee: CoreExpr = if is_closure_call(kind) and is_owned_temporary_expr(env, callee):
		temp: CoreVar = synthetic_binding_var("borrow_callee", 0, loc)
		callee_type: CoreType = core_expr_type(callee)
		bindings = bindings.append({
			variable = temp,
			typ = callee_type,
			rhs = callee,
		})
		VarExpr(
			temporary_call_var(temp, use_borrowed_views),
			callee_type,
			loc,
		)
	else:
		callee

	for arg in args:
		match contract.args.get(index):
			Some(mode):
				if arg_preserves_caller(mode):
					prepared_arg: PreparedBorrowedArgument = prepare_borrowed_argument(
						env,
						arg,
						index,
						loc,
						use_borrowed_views,
					)
					bindings = bindings.concat(prepared_arg.bindings)
					rewritten_args = rewritten_args.append(prepared_arg.expr)
				else:
					rewritten_args = rewritten_args.append(arg)
			None:
				rewritten_args = rewritten_args.append(arg)

		index += 1

	{
		bindings = bindings,
		call = CallExpr(kind, rewritten_callee, rewritten_args, typ, loc)
	}


private pure func bind_borrowed_owned_temporary_args_at_call(
	env: PerceusEnv,
	expr: CoreExpr,
) -> CoreExpr:
	match expr:
		CallExpr(kind, callee, args, typ, loc):
			match contract_for_temporary_binding(env, kind, args.length(), typ):
				Some(plan):
					explicit_drop: Bool = temporary_binding_plan_uses_explicit_drop(plan)
					prepared: PreparedTemporaryCall = prepare_borrowed_owned_temporary_call(
						env,
						kind,
						callee,
						args,
						typ,
						loc,
						temporary_binding_plan_contract(plan),
						explicit_drop,
					)

					if explicit_drop:
						wrap_borrowed_owned_temporary_bindings(prepared.bindings, prepared.call)
					else:
						wrap_synthetic_bindings(prepared.bindings, prepared.call)
				None:
					expr
		_:
			expr


private pure func unbox_copies_alias(kind: CoreUnboxKind) -> Bool:
	match kind:
		PointerUnbox:
			False
		_:
			True


private pure func result_mode_may_alias_argument(mode: OwnershipResultMode) -> Bool:
	match mode:
		ReturnAliasOfArg(index):
			True
		ReturnBorrowed:
			True
		_:
			False


private pure func normalize_unbox_ownership_change_aware(
	env: PerceusEnv,
	source: CoreExpr,
) -> PerceusOwnershipNormalization:
	match source:
		UnboxExpr(unbox_kind, CastExpr(CallExpr(kind, callee, args, call_type, call_loc), cast_type, cast_loc), typ, loc):
			match contract_for_call(env, kind, args.length(), call_type):
				Some(contract):
					if (
						unbox_copies_alias(unbox_kind)
						and result_mode_may_alias_argument(contract.result)
					):
						prepared: PreparedTemporaryCall = prepare_borrowed_owned_temporary_call(
							env,
							kind,
							callee,
							args,
							call_type,
							call_loc,
							contract,
							True,
						)
						unboxed: CoreExpr = UnboxExpr(
							unbox_kind,
							CastExpr(prepared.call, cast_type, cast_loc),
							typ,
							loc,
						)
						ChangedPerceusOwnershipNormalization(
							wrap_borrowed_owned_temporary_bindings(
								prepared.bindings,
								unboxed,
							),
						)
					else:
						UnchangedPerceusOwnershipNormalization
				None:
					UnchangedPerceusOwnershipNormalization
		UnboxExpr(unbox_kind, CallExpr(kind, callee, args, call_type, call_loc), typ, loc):
			match contract_for_call(env, kind, args.length(), call_type):
				Some(contract):
					if (
						unbox_copies_alias(unbox_kind)
						and result_mode_may_alias_argument(contract.result)
					):
						prepared: PreparedTemporaryCall = prepare_borrowed_owned_temporary_call(
							env,
							kind,
							callee,
							args,
							call_type,
							call_loc,
							contract,
							True,
						)
						unboxed: CoreExpr = UnboxExpr(unbox_kind, prepared.call, typ, loc)
						ChangedPerceusOwnershipNormalization(
							wrap_borrowed_owned_temporary_bindings(
								prepared.bindings,
								unboxed,
							),
						)
					else:
						UnchangedPerceusOwnershipNormalization
				None:
					UnchangedPerceusOwnershipNormalization
		UnboxExpr(_, _, _, _):
			UnchangedPerceusOwnershipNormalization
		_:
			ChangedPerceusOwnershipNormalization(source)


pure func retain_alias_as_owned(expr: CoreExpr) -> CoreExpr:
	typ: CoreType = core_expr_type(expr)
	temp: CoreVar = {
		name = OWNED_RESULT_TEMP_NAME,
		uniq = 0,
		def_id = None
	}

	loc: CoreSourceLoc = match expr:
		VarExpr(variable, value_type, value_loc):
			value_loc
		FieldExpr(owner, field, value_type, value_loc):
			value_loc
		TupleFieldExpr(owner, field_index, value_type, value_loc):
			value_loc
		ListGetExpr(get, value_type, value_loc):
			value_loc
		CallExpr(kind, callee, args, value_type, value_loc):
			value_loc
		CastExpr(inner, value_type, value_loc):
			value_loc
		UnboxExpr(kind, inner, value_type, value_loc):
			value_loc
		_:
			SyntheticSourceLoc

	BorrowLetExpr(
		temp,
		typ,
		expr,
		DupExpr(
			temp,
			typ,
			retain_policy_for_type(typ),
			VarExpr(temp, typ, loc),
			typ,
			loc,
		),
	)


pure func managed_pointer_unbox_alias(
	env: PerceusEnv,
	kind: CoreUnboxKind,
	typ: CoreType,
) -> Bool:
	match kind:
		PointerUnbox:
			is_managed_type(env, typ)
		_:
			False


private pure func owned_result_is_alias(env: PerceusEnv, expr: CoreExpr) -> Bool:
	match expr:
		FieldExpr(owner, field, typ, loc):
			True
		TupleFieldExpr(owner, field_index, typ, loc):
			True
		ListGetExpr(get, typ, loc):
			True
		CastExpr(inner, typ, loc):
			owned_result_is_alias(env, inner)
		UnboxExpr(kind, inner, typ, loc):
			managed_pointer_unbox_alias(env, kind, typ) or owned_result_is_alias(env, inner)
		CallExpr(kind, callee, args, typ, loc):
			match contract_for_call(env, kind, args.length(), typ):
				Some(contract):
					match contract.result:
						ReturnBorrowed:
							True
						ReturnAliasOfArg(index):
							True
						_:
							False
				None:
					False
		_:
			False


-- Allocation identity for Core expressions. Core is immutable value data, so a
-- rewrite that hands back the same allocation changed nothing, and Perceus can
-- report the node as reusing its source.
--
-- This binds straight to the runtime primitive rather than calling the generic
-- `memory.same_object`, because the pinned bootstrap compiler
-- (dev-8341b419d990) cannot project a builtin name it has never seen. Once the
-- bootstrap pin moves past the commit that introduced `blorp_same_object`,
-- delete this block and import `memory: same_object` instead. `traverse.brp`
-- carries the same declaration for the same reason.
foreign:
	private pure func same_core_expr(left: CoreExpr, right: CoreExpr) -> Bool = "blorp_same_object"
	private pure func same_core_expr_list(
		left: List[CoreExpr],
		right: List[CoreExpr],
	) -> Bool = "blorp_same_object"


pure func same_core_var(left: CoreVar, right: CoreVar) -> Bool:
	left.name == right.name and left.uniq == right.uniq and left.def_id == right.def_id


pure func exact_owned_vars_add(
	variables: List[CoreVar],
	variable: CoreVar,
) -> List[CoreVar]:
	if variables.any(func(candidate): same_core_var(candidate, variable)):
		variables
	else:
		variables.append(variable)


pure func exact_owned_vars_remove(
	variables: List[CoreVar],
	variable: CoreVar,
) -> List[CoreVar]:
	if variables.is_empty():
		variables
	else:
		variables.filter(func(candidate): not same_core_var(candidate, variable))


pure func exact_owned_vars_contains(variables: List[CoreVar], variable: CoreVar) -> Bool:
	variables.any(func(candidate): same_core_var(candidate, variable))


private pure func add_transferable_result_var(
	variables: List[CoreVar],
	variable: CoreVar,
) -> List[CoreVar]:
	if variables.any(func(candidate): same_core_var(candidate, variable)):
		variables
	else:
		variables.append(variable)


private pure func result_transfers_existing_owner(env: PerceusEnv, expr: CoreExpr) -> Bool:
	match expr:
		VarExpr(variable, typ, loc):
			env.transferable_result_vars.any(
				func(transferable): same_core_var(transferable, variable),
			)
		_:
			False


private pure func normalize_owned_result_literal_cases(
	env: PerceusEnv,
	cases: List[CoreLiteralMatchCase],
) -> List[CoreLiteralMatchCase]:
	var normalized: List[CoreLiteralMatchCase] = []

	for match_case in cases:
		normalized = normalized.append(
			{ match_case | body = normalize_owned_result_aliases(env, match_case.body) },
		)

	normalized


private pure func normalize_owned_result_literal_fallback(
	env: PerceusEnv,
	fallback: CoreLiteralMatchFallback,
) -> CoreLiteralMatchFallback:
	match fallback:
		LiteralMatchFallbackBody(body):
			LiteralMatchFallbackBody(normalize_owned_result_aliases(env, body))
		LiteralMatchFallbackBindings(bindings, body):
			LiteralMatchFallbackBindings(
				bindings,
				normalize_owned_result_aliases(env, body),
			)
		LiteralMatchFallbackFail:
			LiteralMatchFallbackFail


private pure func normalize_owned_result_literal_match(
	env: PerceusEnv,
	match_expr: CoreConstructorLiteralMatch,
) -> CoreConstructorLiteralMatch:
	{ match_expr |
		cases = normalize_owned_result_literal_cases(env, match_expr.cases),
		fallback = normalize_owned_result_literal_fallback(env, match_expr.fallback)
	}


private pure func normalize_owned_result_constructor_body(
	env: PerceusEnv,
	body: CoreConstructorMatchBody,
) -> CoreConstructorMatchBody:
	match body:
		ConstructorMatchBodyExpr(expr):
			ConstructorMatchBodyExpr(normalize_owned_result_aliases(env, expr))
		ConstructorMatchBodyLiteral(match_expr):
			ConstructorMatchBodyLiteral(normalize_owned_result_literal_match(env, match_expr))
		ConstructorMatchBodyLength(match_expr):
			ConstructorMatchBodyLength(normalize_owned_result_length_match(env, match_expr))


private pure func normalize_owned_result_length_branch(
	env: PerceusEnv,
	branch: CoreConstructorLengthMatchBranch,
) -> CoreConstructorLengthMatchBranch:
	{ branch | body = normalize_owned_result_constructor_body(env, branch.body) }


private pure func normalize_owned_result_length_cases(
	env: PerceusEnv,
	cases: List[CoreConstructorLengthMatchCase],
) -> List[CoreConstructorLengthMatchCase]:
	var normalized: List[CoreConstructorLengthMatchCase] = []

	for match_case in cases:
		normalized = normalized.append(
			{ match_case | branch = normalize_owned_result_length_branch(env, match_case.branch) },
		)

	normalized


private pure func normalize_owned_result_length_geq(
	env: PerceusEnv,
	geq: Option[CoreConstructorLengthMatchGeq],
) -> Option[CoreConstructorLengthMatchGeq]:
	match geq:
		Some(match_case):
			Some(
				{ match_case |
					branch = normalize_owned_result_length_branch(env, match_case.branch)
				},
			)
		None:
			None


private pure func normalize_owned_result_length_fallback(
	env: PerceusEnv,
	fallback: Option[CoreConstructorLengthMatchBranch],
) -> Option[CoreConstructorLengthMatchBranch]:
	match fallback:
		Some(branch):
			Some(normalize_owned_result_length_branch(env, branch))
		None:
			None


private pure func normalize_owned_result_length_match(
	env: PerceusEnv,
	match_expr: CoreConstructorLengthMatch,
) -> CoreConstructorLengthMatch:
	{ match_expr |
		cases = normalize_owned_result_length_cases(env, match_expr.cases),
		geq = normalize_owned_result_length_geq(env, match_expr.geq),
		fallback = normalize_owned_result_length_fallback(env, match_expr.fallback)
	}


private pure func normalize_owned_result_constructor_cases(
	env: PerceusEnv,
	cases: List[CoreConstructorMatchCase],
) -> List[CoreConstructorMatchCase]:
	var normalized: List[CoreConstructorMatchCase] = []

	for match_case in cases:
		normalized = normalized.append(
			{ match_case | body = normalize_owned_result_constructor_body(env, match_case.body) },
		)

	normalized


private pure func normalize_owned_result_constructor_fallback(
	env: PerceusEnv,
	fallback: CoreConstructorMatchFallback,
) -> CoreConstructorMatchFallback:
	match fallback:
		ConstructorMatchFallbackBody(body):
			ConstructorMatchFallbackBody(normalize_owned_result_aliases(env, body))
		ConstructorMatchFallbackBindings(bindings, body):
			ConstructorMatchFallbackBindings(
				bindings,
				normalize_owned_result_aliases(env, body),
			)
		ConstructorMatchFallbackFail:
			ConstructorMatchFallbackFail


pure func normalize_owned_result_aliases(env: PerceusEnv, expr: CoreExpr) -> CoreExpr:
	owned_projection: MaterializedBorrowedTemporary = materialize_owned_temporary_projection(
		env,
		expr,
	)

	if owned_projection.is_owned:
		owned_projection.expr
	else if result_transfers_existing_owner(env, expr):
		expr
	else if is_owned_temporary_expr(env, expr):
		expr
	else if is_managed_type(env, core_expr_type(expr)) and owned_result_is_alias(env, expr):
		retain_alias_as_owned(expr)
	else:
		match expr:
			IfExpr(cond, then_expr, else_expr, typ, loc):
				IfExpr(
					cond,
					normalize_owned_result_aliases(env, then_expr),
					normalize_owned_result_aliases(env, else_expr),
					typ,
					loc,
				)
			LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
				LiteralMatchExpr(
					scrutinee,
					normalize_owned_result_literal_cases(env, cases),
					normalize_owned_result_literal_fallback(env, fallback),
					typ,
					loc,
				)
			AccessorLiteralMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
				AccessorLiteralMatchExpr(
					scrutinee,
					release_policy,
					normalize_owned_result_literal_match(env, match_expr),
					typ,
					loc,
				)
			LengthMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
				LengthMatchExpr(
					scrutinee,
					release_policy,
					normalize_owned_result_length_match(env, match_expr),
					typ,
					loc,
				)
			ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
				ConstructorMatchExpr(
					scrutinee,
					release_policy,
					normalize_owned_result_constructor_cases(env, cases),
					normalize_owned_result_constructor_fallback(env, fallback),
					typ,
					loc,
				)
			LetExpr(variable, is_mutable, typ, rhs, body):
				body_env: PerceusEnv = if is_managed_type(env, typ):
					{ env |
						transferable_result_vars = add_transferable_result_var(
							env.transferable_result_vars,
							variable,
						)
					}
				else:
					env

				LetExpr(
					variable,
					is_mutable,
					typ,
					rhs,
					normalize_owned_result_aliases(body_env, body),
				)
			BorrowLetExpr(variable, typ, rhs, body):
				body_env: PerceusEnv = { env |
					transferable_result_vars = env.transferable_result_vars.filter(
						func(candidate): not same_core_var(candidate, variable),
					)
				}
				BorrowLetExpr(
					variable,
					typ,
					rhs,
					normalize_owned_result_aliases(body_env, body),
				)
			SeqExpr(first, second):
				SeqExpr(
					first,
					normalize_owned_result_aliases(env, second),
				)
			DupExpr(variable, value_type, retain_policy, body, typ, loc):
				DupExpr(
					variable,
					value_type,
					retain_policy,
					normalize_owned_result_aliases(env, body),
					typ,
					loc,
				)
			DropExpr(variable, value_type, release_policy, body, typ, loc):
				DropExpr(
					variable,
					value_type,
					release_policy,
					normalize_owned_result_aliases(env, body),
					typ,
					loc,
				)
			ResourceScopeExpr(scope, typ, loc):
				ResourceScopeExpr(
					{ scope | body = normalize_owned_result_aliases(env, scope.body) },
					typ,
					loc,
				)
			TensorRawViewLetExpr(binding, body, typ, loc):
				TensorRawViewLetExpr(
					binding,
					normalize_owned_result_aliases(env, body),
					typ,
					loc,
				)
			ListHandoffExpr(handoff, typ, loc):
				ListHandoffExpr(
					{ handoff | body = normalize_owned_result_aliases(env, handoff.body) },
					typ,
					loc,
				)
			_:
				expr


private pure func retain_assignment_alias_rhs(env: PerceusEnv, expr: CoreExpr) -> CoreExpr:
	match expr:
		AssignExpr(variable, rhs, typ, loc):
			if variable.name != "_" and is_managed_type(env, core_expr_type(rhs)):
				AssignExpr(
					variable,
					normalize_assignment_alias_result(env, rhs),
					typ,
					loc,
				)
			else:
				expr
		_:
			expr


private pure func normalize_binding_alias_match_results(
	env: PerceusEnv,
	bindings: List[CoreMatchBinding],
	expr: CoreExpr,
) -> CoreExpr:
	CoreTraverse.map_core_match_results(
		expr,
		func(nested_bindings, result): normalize_scoped_binding_alias_result(
			env,
			bindings.concat(nested_bindings),
			result,
		),
	)


private pure func normalize_scoped_binding_alias_result(
	env: PerceusEnv,
	bindings: List[CoreMatchBinding],
	expr: CoreExpr,
) -> CoreExpr:
	normalize_scoped_binding_alias_result_with_owned_status(
		env,
		bindings,
		expr,
		is_owned_temporary_expr(env, expr),
	)


private pure func normalize_scoped_binding_alias_result_with_owned_status(
	env: PerceusEnv,
	bindings: List[CoreMatchBinding],
	expr: CoreExpr,
	is_owned_temporary: Bool,
) -> CoreExpr:
	if is_owned_temporary:
		expr
	else:
		match expr:
			IfExpr(cond, then_expr, else_expr, typ, loc):
				IfExpr(
					cond,
					normalize_scoped_binding_alias_result(env, bindings, then_expr),
					normalize_scoped_binding_alias_result(env, bindings, else_expr),
					typ,
					loc,
				)
			LetExpr(variable, is_mutable, typ, rhs, body):
				LetExpr(
					variable,
					is_mutable,
					typ,
					rhs,
					normalize_scoped_binding_alias_result(env, bindings, body),
				)
			BorrowLetExpr(variable, typ, rhs, body):
				BorrowLetExpr(
					variable,
					typ,
					rhs,
					normalize_scoped_binding_alias_result(env, bindings, body),
				)
			SeqExpr(first, second):
				SeqExpr(
					first,
					normalize_scoped_binding_alias_result(env, bindings, second),
				)
			LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
				normalize_binding_alias_match_results(env, bindings, expr)
			AccessorLiteralMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
				normalize_binding_alias_match_results(env, bindings, expr)
			LengthMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
				normalize_binding_alias_match_results(env, bindings, expr)
			ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
				normalize_binding_alias_match_results(env, bindings, expr)
			_:
				shadowed_match_binding: Bool = match expr:
					VarExpr(variable, typ, loc):
						match_bindings_shadow(variable.name, bindings)
					_:
						False

				if (
					not shadowed_match_binding
					and is_managed_type(env, core_expr_type(expr))
					and assignment_rhs_returns_alias(env, expr)
				):
					retain_alias_as_owned(expr)
				else:
					expr


private pure func binding_alias_rhs_is_owned_temporary(
	env: PerceusEnv,
	bind_type: CoreType,
	rhs: CoreExpr,
) -> Bool:
	if not is_managed_type(env, bind_type):
		False
	else:
		match rhs:
			VarExpr(variable, typ, loc):
				False
			FieldExpr(owner, field, typ, loc):
				False
			TupleFieldExpr(owner, field_index, typ, loc):
				False
			_:
				is_owned_temporary_expr(env, rhs)


private pure func normalize_binding_alias_rhs_with_owned_status(
	env: PerceusEnv,
	bind_type: CoreType,
	rhs: CoreExpr,
	rhs_is_owned_temporary: Bool,
) -> CoreExpr:
	if not is_managed_type(env, bind_type):
		rhs
	else:
		match rhs:
			VarExpr(variable, typ, loc):
				if is_nullary_constructor_reference(env, variable):
					rhs
				else:
					DupExpr(
						variable,
						bind_type,
						retain_policy_for_type(bind_type),
						rhs,
						bind_type,
						loc,
					)
			FieldExpr(owner, field, typ, loc):
				if is_owned_temporary_expr(env, owner):
					bind_owned_temporary_field_projection(env, rhs)
				else:
					retain_alias_as_owned(rhs)
			TupleFieldExpr(owner, field_index, typ, loc):
				if is_owned_temporary_expr(env, owner):
					bind_owned_temporary_field_projection(env, rhs)
				else:
					retain_alias_as_owned(rhs)
			_:
				normalize_scoped_binding_alias_result_with_owned_status(
					env,
					[],
					rhs,
					rhs_is_owned_temporary,
				)


private pure func normalize_binding_alias_rhs(
	env: PerceusEnv,
	bind_type: CoreType,
	rhs: CoreExpr,
) -> CoreExpr:
	normalize_binding_alias_rhs_with_owned_status(
		env,
		bind_type,
		rhs,
		binding_alias_rhs_is_owned_temporary(env, bind_type, rhs),
	)


-- This is the exact identity subset of `normalize_binding_alias_rhs`. Keep the
-- proof beside that normalizer so a new normalization case cannot silently
-- make a managed Let claim source reuse. Cases outside the subset remain
-- conservative even when their rebuilt output happens to serialize equally.
private pure func normalize_binding_alias_rhs_reuses_source(
	env: PerceusEnv,
	bind_type: CoreType,
	rhs: CoreExpr,
	rhs_is_owned_temporary: Bool,
) -> Bool:
	if not is_managed_type(env, bind_type):
		True
	else:
		match rhs:
			VarExpr(variable, typ, loc):
				is_nullary_constructor_reference(env, variable)
			FieldExpr(owner, field, typ, loc):
				False
			TupleFieldExpr(owner, field_index, typ, loc):
				False
			_:
				is_immortal_value_expr(env, rhs) or rhs_is_owned_temporary


private pure func body_starts_with_dup(name: String, body: CoreExpr) -> Bool:
	match body:
		DupExpr(variable, value_type, retain_policy, inner, typ, loc):
			variable.name == name
		_:
			False


private pure func retain_alias_source_in_body(
	env: PerceusEnv,
	variable: CoreVar,
	bind_type: CoreType,
	rhs: CoreExpr,
	body: CoreExpr,
) -> CoreExpr:
	if not is_managed_type(env, bind_type) or body_starts_with_dup(variable.name, body):
		body
	else:
		body_type: CoreType = core_expr_type(body)

		match rhs:
			VarExpr(source, source_type, source_loc):
				body
			FieldExpr(owner, field, field_type, field_loc):
				body
			TupleFieldExpr(owner, field_index, field_type, field_loc):
				body
			_:
				body


private pure func balance_concurrent_binding_body(
	env: PerceusEnv,
	variable: CoreVar,
	typ: CoreType,
	body: CoreExpr,
) -> CoreExpr:
	if not is_managed_type(env, typ):
		body
	else:
		balance_let_body_legacy(env, variable, typ, body)


private pure func aggregate_value_requires_direct_field_retain(
	env: PerceusEnv,
	value: CoreExpr,
) -> Bool:
	match value:
		FieldExpr(_, _, typ, _) | TupleFieldExpr(_, _, typ, _):
			is_managed_type(env, typ) and direct_field_alias(value)
		_:
			False


-- The caller proves the direct-alias condition once before entering here.
private pure func retain_proven_direct_field_alias_value(value: CoreExpr) -> CoreExpr:
	match value:
		FieldExpr(_, _, typ, loc) | TupleFieldExpr(_, _, typ, loc):
			temp: CoreVar = synthetic_binding_var("aggregate_field", 0, loc)
			BorrowLetExpr(
				temp,
				typ,
				value,
				DupExpr(
					temp,
					typ,
					retain_policy_for_type(typ),
					VarExpr(temp, typ, loc),
					typ,
					loc,
				),
			)
		_:
			value


private pure func insert_aggregate_child(
	env: PerceusEnv,
	value: CoreExpr,
	retains_direct_field_aliases: Bool,
) -> PerceusInsertedExpr:
	requires_retain: Bool = (
		retains_direct_field_aliases
		and aggregate_value_requires_direct_field_retain(env, value)
	)

	owned_value: CoreExpr = if requires_retain:
		retain_proven_direct_field_alias_value(value)
	else:
		value

	rewritten: PerceusInsertedExpr = insert_drops_expr_inner_result(env, owned_value)

	if requires_retain:
		{ rewritten | reuses_source = False }
	else:
		rewritten


private pure func rewrite_aggregate_exprs(
	env: PerceusEnv,
	values: List[CoreExpr],
) -> PerceusAggregateExprsRewrite:
	var rewritten: List[CoreExpr] = values
	var changed: Bool = False
	var index: Int = 0

	for value in values:
		result: PerceusInsertedExpr = insert_aggregate_child(env, value, True)

		if not result.reuses_source:
			rewritten = rewritten.set(index, result.expr)
			changed = True
		else:
			void

		index += 1

	if changed:
		ChangedPerceusAggregateExprs(rewritten)
	else:
		UnchangedPerceusAggregateExprs


private pure func rewrite_aggregate_record_fields(
	env: PerceusEnv,
	fields: List[CoreRecordFieldValue],
) -> PerceusAggregateRecordFieldsRewrite:
	var rewritten: List[CoreRecordFieldValue] = fields
	var changed: Bool = False
	var index: Int = 0

	for field in fields:
		result: PerceusInsertedExpr = insert_aggregate_child(env, field.value, True)

		if not result.reuses_source:
			rewritten = rewritten.set(index, { field | value = result.expr })
			changed = True
		else:
			void

		index += 1

	if changed:
		ChangedPerceusAggregateRecordFields(rewritten)
	else:
		UnchangedPerceusAggregateRecordFields


private pure func aggregate_value_can_transfer_without_retain(
	env: PerceusEnv,
	expr: CoreExpr,
) -> Bool:
	match expr:
		StaticStringLiteralExpr(id, value, typ, loc):
			True
		FieldExpr(owner, field, typ, loc):
			aggregate_value_can_transfer_without_retain(env, owner)
		TupleFieldExpr(owner, field_index, typ, loc):
			aggregate_value_can_transfer_without_retain(env, owner)
		_:
			is_owned_temporary_expr(env, expr)


private pure func rewrite_aggregate_boxed_value(
	env: PerceusEnv,
	value: CoreBoxedStorageValue,
) -> PerceusAggregateBoxedValueRewrite:
	needs_release: Bool = value.needs_release
	transfers_ownership: Bool = (
		value.transfers_ownership
		or needs_release and aggregate_value_can_transfer_without_retain(env, value.value)
	)

	rewritten_value: PerceusInsertedExpr = insert_aggregate_child(
		env,
		value.value,
		transfers_ownership,
	)

	if rewritten_value.reuses_source and transfers_ownership == value.transfers_ownership:
		UnchangedPerceusAggregateBoxedValue
	else:
		ChangedPerceusAggregateBoxedValue({ value |
				value = rewritten_value.expr,
				transfers_ownership = transfers_ownership
			})


private pure func rewrite_aggregate_boxed_values(
	env: PerceusEnv,
	values: List[CoreBoxedStorageValue],
) -> PerceusAggregateBoxedValuesRewrite:
	var rewritten: List[CoreBoxedStorageValue] = values
	var changed: Bool = False
	var index: Int = 0

	for value in values:
		match rewrite_aggregate_boxed_value(env, value):
			ChangedPerceusAggregateBoxedValue(rewritten_value):
				rewritten = rewritten.set(index, rewritten_value)
				changed = True
			UnchangedPerceusAggregateBoxedValue:
				void

		index += 1

	if changed:
		ChangedPerceusAggregateBoxedValues(rewritten)
	else:
		UnchangedPerceusAggregateBoxedValues


private pure func rewrite_aggregate_dict_entries(
	env: PerceusEnv,
	entries: List[CoreDictEntry],
) -> PerceusAggregateDictEntriesRewrite:
	var rewritten: List[CoreDictEntry] = entries
	var changed: Bool = False
	var index: Int = 0

	for entry in entries:
		var rewritten_key: CoreBoxedStorageValue = entry.key
		var rewritten_value: CoreBoxedStorageValue = entry.value
		var entry_changed: Bool = False

		match rewrite_aggregate_boxed_value(env, entry.key):
			ChangedPerceusAggregateBoxedValue(key):
				rewritten_key = key
				entry_changed = True
			UnchangedPerceusAggregateBoxedValue:
				void

		match rewrite_aggregate_boxed_value(env, entry.value):
			ChangedPerceusAggregateBoxedValue(value):
				rewritten_value = value
				entry_changed = True
			UnchangedPerceusAggregateBoxedValue:
				void

		if entry_changed:
			rewritten = rewritten.set(
				index,
				{
					key = rewritten_key,
					value = rewritten_value
				},
			)
			changed = True
		else:
			void

		index += 1

	if changed:
		ChangedPerceusAggregateDictEntries(rewritten)
	else:
		UnchangedPerceusAggregateDictEntries


private pure func rewrite_aggregate_cow_fields(
	env: PerceusEnv,
	fields: List[CoreRecordCowField],
) -> PerceusAggregateCowFieldsRewrite:
	var rewritten: List[CoreRecordCowField] = fields
	var changed: Bool = False
	var index: Int = 0

	for field in fields:
		match field.replacement:
			Some(replacement):
				result: PerceusInsertedExpr = insert_aggregate_child(env, replacement, True)

				if not result.reuses_source:
					rewritten = rewritten.set(index, { field | replacement = Some(result.expr) })
					changed = True
				else:
					void
			None:
				void

		index += 1

	if changed:
		ChangedPerceusAggregateCowFields(rewritten)
	else:
		UnchangedPerceusAggregateCowFields


private pure func insert_drops_change_aware_aggregate(
	env: PerceusEnv,
	source: CoreExpr,
) -> PerceusInsertedExpr:
	debug:
		perceus_work_insert_aggregate_visits()

	result: PerceusInsertedExpr = match source:
		TupleExpr(items, typ, loc):
			match rewrite_aggregate_exprs(env, items):
				UnchangedPerceusAggregateExprs:
					inserted_non_binding_expr(env, source, True)
				ChangedPerceusAggregateExprs(rewritten):
					inserted_non_binding_expr(
						env,
						TupleExpr(rewritten, typ, loc),
						False,
					)
		VectorExpr(items, typ, loc):
			match rewrite_aggregate_exprs(env, items):
				UnchangedPerceusAggregateExprs:
					inserted_non_binding_expr(env, source, True)
				ChangedPerceusAggregateExprs(rewritten):
					inserted_non_binding_expr(
						env,
						VectorExpr(rewritten, typ, loc),
						False,
					)
		RecordExpr(fields, typ, loc):
			match rewrite_aggregate_record_fields(env, fields):
				UnchangedPerceusAggregateRecordFields:
					inserted_non_binding_expr(env, source, True)
				ChangedPerceusAggregateRecordFields(rewritten):
					inserted_non_binding_expr(
						env,
						RecordExpr(rewritten, typ, loc),
						False,
					)
		RecordUpdateExpr(base, fields, typ, loc):
			rewritten_base: PerceusInsertedExpr = insert_drops_expr_inner_result(env, base)

			match rewrite_aggregate_record_fields(env, fields):
				UnchangedPerceusAggregateRecordFields:
					if rewritten_base.reuses_source:
						inserted_non_binding_expr(env, source, True)
					else:
						inserted_non_binding_expr(
							env,
							RecordUpdateExpr(rewritten_base.expr, fields, typ, loc),
							False,
						)
				ChangedPerceusAggregateRecordFields(rewritten):
					inserted_non_binding_expr(
						env,
						RecordUpdateExpr(rewritten_base.expr, rewritten, typ, loc),
						False,
					)
		RecordReuseExpr(record_source, fields, typ, loc):
			rewritten_source: PerceusInsertedExpr = insert_drops_expr_inner_result(
				env,
				record_source,
			)

			match rewrite_aggregate_record_fields(env, fields):
				UnchangedPerceusAggregateRecordFields:
					if rewritten_source.reuses_source:
						inserted_non_binding_expr(env, source, True)
					else:
						inserted_non_binding_expr(
							env,
							RecordReuseExpr(rewritten_source.expr, fields, typ, loc),
							False,
						)
				ChangedPerceusAggregateRecordFields(rewritten):
					inserted_non_binding_expr(
						env,
						RecordReuseExpr(rewritten_source.expr, rewritten, typ, loc),
						False,
					)
		RecordCowUpdateExpr(record_source, fields, typ, loc):
			rewritten_source: PerceusInsertedExpr = insert_drops_expr_inner_result(
				env,
				record_source,
			)

			match rewrite_aggregate_cow_fields(env, fields):
				UnchangedPerceusAggregateCowFields:
					if rewritten_source.reuses_source:
						inserted_non_binding_expr(env, source, True)
					else:
						inserted_non_binding_expr(
							env,
							RecordCowUpdateExpr(rewritten_source.expr, fields, typ, loc),
							False,
						)
				ChangedPerceusAggregateCowFields(rewritten):
					inserted_non_binding_expr(
						env,
						RecordCowUpdateExpr(rewritten_source.expr, rewritten, typ, loc),
						False,
					)
		RecordConstructExpr(type_name, fields, typ, loc):
			match rewrite_aggregate_record_fields(env, fields):
				UnchangedPerceusAggregateRecordFields:
					inserted_non_binding_expr(env, source, True)
				ChangedPerceusAggregateRecordFields(rewritten):
					inserted_non_binding_expr(
						env,
						RecordConstructExpr(type_name, rewritten, typ, loc),
						False,
					)
		ListConstructExpr(construct, typ, loc):
			match rewrite_aggregate_boxed_values(env, construct.elements):
				UnchangedPerceusAggregateBoxedValues:
					inserted_non_binding_expr(env, source, True)
				ChangedPerceusAggregateBoxedValues(rewritten):
					inserted_non_binding_expr(
						env,
						ListConstructExpr({ construct | elements = rewritten }, typ, loc),
						False,
					)
		TensorBoxedLiteralExpr(literal, typ, loc):
			match rewrite_aggregate_boxed_values(env, literal.elements):
				UnchangedPerceusAggregateBoxedValues:
					inserted_non_binding_expr(env, source, True)
				ChangedPerceusAggregateBoxedValues(rewritten):
					inserted_non_binding_expr(
						env,
						TensorBoxedLiteralExpr({ literal | elements = rewritten }, typ, loc),
						False,
					)
		DictConstructExpr(construct, typ, loc):
			match rewrite_aggregate_dict_entries(env, construct.entries):
				UnchangedPerceusAggregateDictEntries:
					inserted_non_binding_expr(env, source, True)
				ChangedPerceusAggregateDictEntries(rewritten):
					inserted_non_binding_expr(
						env,
						DictConstructExpr({ construct | entries = rewritten }, typ, loc),
						False,
					)
		UnionConstructExpr(construct, typ, loc):
			match rewrite_aggregate_boxed_values(env, construct.args):
				UnchangedPerceusAggregateBoxedValues:
					inserted_non_binding_expr(env, source, True)
				ChangedPerceusAggregateBoxedValues(rewritten):
					inserted_non_binding_expr(
						env,
						UnionConstructExpr({ construct | args = rewritten }, typ, loc),
						False,
					)
		_:
			opaque_inserted_non_binding_expr(
				env,
				insert_drops_normalized_expr(env, source),
			)

	debug:
		if result.reuses_source:
			perceus_work_insert_aggregate_original_nodes_reused()
		else:
			perceus_work_insert_aggregate_reconstructions()

	result


private pure func bind_owned_temporary_field_projection(
	env: PerceusEnv,
	expr: CoreExpr,
) -> CoreExpr:
	-- The immediate owner may be another borrowed projection. Inspect the full
	-- path so a call-rooted `make_outer().node.items` owns and drops both levels.
	materialized: MaterializedBorrowedTemporary = materialize_owned_temporary_projection(env, expr)
	-- The projected result may be unmanaged while its temporary owner still
	-- contains managed fields. Keep the lexical wrapper that releases that
	-- owner; `is_owned` describes the result value, not required cleanup.
	materialized.expr


private pure func normalize_projection_owner_ownership_change_aware(
	env: PerceusEnv,
	source: CoreExpr,
	owner: CoreExpr,
) -> PerceusOwnershipNormalization:
	proven_borrowed_owner: Bool = match owner:
		VarExpr(_, _, _):
			True
		CallExpr(kind, _, args, return_type, _):
			match contract_for_call(env, kind, args.length(), return_type):
				Some(contract):
					match contract.result:
						ReturnBorrowed | ReturnAliasOfArg(_):
							True
						_:
							False
				None:
					False
		_:
			False

	if proven_borrowed_owner:
		UnchangedPerceusOwnershipNormalization
	else:
		ChangedPerceusOwnershipNormalization(bind_owned_temporary_field_projection(env, source))


private pure func normalize_projection_ownership_change_aware(
	env: PerceusEnv,
	source: CoreExpr,
) -> PerceusOwnershipNormalization:
	match source:
		FieldExpr(owner, _, _, _) | TupleFieldExpr(owner, _, _, _):
			normalize_projection_owner_ownership_change_aware(env, source, owner)
		_:
			ChangedPerceusOwnershipNormalization(source)


private pure func materialize_owned_temporary_projection(
	env: PerceusEnv,
	expr: CoreExpr,
) -> MaterializedBorrowedTemporary:
	match expr:
		FieldExpr(owner, field, typ, loc):
			materialize_borrowed_temporary(env, expr)
		TupleFieldExpr(owner, field_index, typ, loc):
			materialize_borrowed_temporary(env, expr)
		_:
			{
				expr = expr,
				is_owned = False
			}


private pure func materialize_owned_temporary_field_projection(
	env: PerceusEnv,
	expr: CoreExpr,
	depth: Int,
) -> CoreExpr:
	match expr:
		FieldExpr(owner, field, typ, loc):
			owner_type: CoreType = core_expr_type(owner)
			owner_var: CoreVar = synthetic_binding_var("owned_field_owner", depth, loc)
			projection: CoreExpr = FieldExpr(
				VarExpr(owner_var, owner_type, loc),
				field,
				typ,
				loc,
			)

			owned_projection: CoreExpr = if is_managed_type(env, typ):
				retain_alias_as_owned(projection)
			else:
				projection

			LetExpr(owner_var, False, owner_type, owner, owned_projection)
		TupleFieldExpr(owner, field_index, typ, loc):
			owner_type: CoreType = core_expr_type(owner)
			owner_var: CoreVar = synthetic_binding_var("owned_field_owner", depth, loc)
			projection: CoreExpr = TupleFieldExpr(
				VarExpr(owner_var, owner_type, loc),
				field_index,
				typ,
				loc,
			)

			owned_projection: CoreExpr = if is_managed_type(env, typ):
				retain_alias_as_owned(projection)
			else:
				projection

			LetExpr(owner_var, False, owner_type, owner, owned_projection)
		_:
			expr


-- This deliberately small proof covers only argument forms for which
-- `materialize_borrowed_temporary` returns the exact input node. Complex
-- result-producing forms remain conservative until their own normalization
-- reports source identity.
private pure func simple_borrowed_argument_materialization_reuses_source(
	env: PerceusEnv,
	expr: CoreExpr,
) -> Bool:
	match expr:
		LiteralExpr(_, _, _) | StaticStringLiteralExpr(_, _, _, _) | VarExpr(_, _, _) | VoidExpr(_, _):
			not is_owned_temporary_expr(env, expr)
		_:
			False


private pure func call_field_alias_protection_reuses_source(
	env: PerceusEnv,
	kind: CoreCallKind,
	args: List[CoreExpr],
	return_type: CoreType,
) -> Bool:
	match contract_for_call(env, kind, args.length(), return_type):
		Some(contract):
			var reuses_source: Bool = True
			var index: Int = 0

			for arg in args:
				match contract.args.get(index):
					Some(mode):
						if (
							arg_consumes_caller(mode)
							and is_managed_type(env, core_expr_type(arg))
							and direct_field_alias(arg)
						):
							reuses_source = False
						else:
							void
					None:
						void

				index += 1

			reuses_source
		None:
			True


private pure func call_temporary_binding_reuses_source(
	env: PerceusEnv,
	kind: CoreCallKind,
	callee: CoreExpr,
	args: List[CoreExpr],
	return_type: CoreType,
) -> Bool:
	match contract_for_temporary_binding(env, kind, args.length(), return_type):
		Some(plan):
			contract: OwnershipCallContract = temporary_binding_plan_contract(plan)
			var reuses_source: Bool = not ((
				is_closure_call(kind)
				and is_owned_temporary_expr(env, callee)
			))

			var index: Int = 0

			for arg in args:
				match contract.args.get(index):
					Some(mode):
						if (
							arg_preserves_caller(mode)
							and not simple_borrowed_argument_materialization_reuses_source(env, arg)
						):
							reuses_source = False
						else:
							void
					None:
						void

				index += 1

			reuses_source
		None:
			True


private pure func call_ownership_normalization_reuses_source(
	env: PerceusEnv,
	kind: CoreCallKind,
	callee: CoreExpr,
	args: List[CoreExpr],
	return_type: CoreType,
) -> Bool:
	(
		call_field_alias_protection_reuses_source(env, kind, args, return_type)
		and call_temporary_binding_reuses_source(env, kind, callee, args, return_type)
	)


private pure func normalize_ownership_node(env: PerceusEnv, expr: CoreExpr) -> CoreExpr:
	match expr:
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			retain_borrowed_match_binding_results(env, expr)
		AccessorLiteralMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			retain_borrowed_match_binding_results(env, expr)
		LengthMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			retain_borrowed_match_binding_results(env, expr)
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			retain_borrowed_match_binding_results(env, expr)
		CallExpr(kind, callee, args, typ, loc):
			field_safe: CoreExpr = protect_consuming_call_field_aliases(env, expr)
			bind_borrowed_owned_temporary_args_at_call(env, field_safe)
		_:
			expr


-- Match cleanup can forward a branch result through a temporary, hiding the
-- fact that one branch returns a mutable slot directly. Retain those branch
-- results while the source result-position structure is still explicit.
private pure func retain_mutable_match_branch_results(
	env: PerceusEnv,
	param: CoreParam,
	expr: CoreExpr,
) -> CoreExpr:
	match expr:
		SeqExpr(first, second):
			SeqExpr(
				first,
				retain_mutable_match_branch_results(env, param, second),
			)
		LetExpr(variable, is_mutable, typ, rhs, body):
			if core_var_matches_param(variable, param):
				LetExpr(variable, is_mutable, typ, rhs, body)
			else:
				LetExpr(
					variable,
					is_mutable,
					typ,
					rhs,
					retain_mutable_match_branch_results(env, param, body),
				)
		BorrowLetExpr(variable, typ, rhs, body):
			if core_var_matches_param(variable, param):
				BorrowLetExpr(variable, typ, rhs, body)
			else:
				BorrowLetExpr(
					variable,
					typ,
					rhs,
					retain_mutable_match_branch_results(env, param, body),
				)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			IfExpr(
				cond,
				retain_mutable_match_branch_results(env, param, then_expr),
				retain_mutable_match_branch_results(env, param, else_expr),
				typ,
				loc,
			)
		LiteralMatchExpr(_, _, _, _, _):
			retain_borrowed_param_result(env, param, expr)
		AccessorLiteralMatchExpr(_, _, _, _, _):
			retain_borrowed_param_result(env, param, expr)
		LengthMatchExpr(_, _, _, _, _):
			retain_borrowed_param_result(env, param, expr)
		ConstructorMatchExpr(_, _, _, _, _, _):
			retain_borrowed_param_result(env, param, expr)
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			DupExpr(
				variable,
				value_type,
				retain_policy,
				retain_mutable_match_branch_results(env, param, body),
				typ,
				loc,
			)
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			DropExpr(
				variable,
				value_type,
				release_policy,
				retain_mutable_match_branch_results(env, param, body),
				typ,
				loc,
			)
		_:
			expr


private pure func plan_managed_let(
	env: PerceusEnv,
	source: CoreExpr,
	variable: CoreVar,
	is_mutable: Bool,
	bind_type: CoreType,
	rhs: CoreExpr,
	body: CoreExpr,
) -> PerceusManagedLetPlan:
	rhs_is_owned_temporary: Bool = binding_alias_rhs_is_owned_temporary(env, bind_type, rhs)
	owned_rhs_reuses_source: Bool = normalize_binding_alias_rhs_reuses_source(
		env,
		bind_type,
		rhs,
		rhs_is_owned_temporary,
	)

	owned_rhs: CoreExpr = if owned_rhs_reuses_source:
		rhs
	else:
		normalize_binding_alias_rhs_with_owned_status(env, bind_type, rhs, rhs_is_owned_temporary)

	branch_safe_body: CoreExpr = if is_mutable:
		retain_mutable_match_branch_results(
			env,
			{
				name = variable,
				typ = bind_type,
				loc = SyntheticSourceLoc
			},
			body,
		)
	else:
		body

	{
		source = source,
		variable = variable,
		is_mutable = is_mutable,
		bind_type = bind_type,
		source_rhs = rhs,
		source_body = body,
		owned_rhs = owned_rhs,
		owned_rhs_reuses_source = owned_rhs_reuses_source,
		branch_safe_body = branch_safe_body,
		branch_safe_body_reuses_source = not is_mutable
	}


-- Reusing the source Let requires identity through planning and both recursive
-- children. The caller separately proves that the selected ownership decision
-- inserts no Dup/Drop and performs no balancing rewrite.
private pure func managed_let_reuses_source(
	plan: PerceusManagedLetPlan,
	rewritten_rhs: PerceusInsertedExpr,
	rewritten_body: PerceusInsertedExpr,
) -> Bool:
	(
		plan.owned_rhs_reuses_source
		and plan.branch_safe_body_reuses_source
		and rewritten_rhs.reuses_source
		and rewritten_body.reuses_source
	)


private pure func rebuild_managed_let(
	env: PerceusEnv,
	plan: PerceusManagedLetPlan,
	rewritten_rhs: CoreExpr,
	rewritten_body: CoreExpr,
) -> CoreExpr:
	managed_binding: Bool = plan.is_mutable or not is_immortal_value_expr(env, plan.owned_rhs)

	balance_strategy: PerceusBalanceStrategy = if (
		managed_binding
		and balanced_path_has_divergent_constructor_match(env, plan.variable.name, rewritten_body)
	):
		BranchAwareOwnershipBalance
	else:
		LinearOwnershipBalance

	balance_env: PerceusEnv = { env | balance_strategy = balance_strategy }

	ownership_body: CoreExpr = if managed_binding:
		freshen_shadowed_match_bindings(plan.variable, rewritten_body)
	else:
		rewritten_body

	if not managed_binding:
		LetExpr(plan.variable, plan.is_mutable, plan.bind_type, rewritten_rhs, rewritten_body)
	else if plan.is_mutable:
		mutable_body: CoreExpr = rewrite_mutable_let_body(
			env,
			plan.variable,
			plan.bind_type,
			ownership_body,
		)
		LetExpr(
			plan.variable,
			True,
			plan.bind_type,
			rewritten_rhs,
			retain_alias_source_in_body(
				env,
				plan.variable,
				plan.bind_type,
				plan.source_rhs,
				mutable_body,
			),
		)
	else:
		protected_body: CoreExpr = protect_repeated_consumes(
			env,
			plan.variable,
			plan.bind_type,
			ownership_body,
			False,
		)

		balanced_body: CoreExpr = match protected_body:
			IfExpr(cond, then_expr, else_expr, typ, loc):
				transform_let_if_body(
					balance_env,
					plan.variable,
					plan.bind_type,
					cond,
					then_expr,
					else_expr,
					typ,
					loc,
				)
			ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
				if releasing_match_consumes_owner(plan.variable.name, scrutinee, release_policy):
					-- The backend match releases its root owner after the selected
					-- branch. Branch-local balancing would also discharge that owner
					-- in nested patterns. The linear summary models the release as the
					-- final consume and reserves any additional branch references.
					balance_let_body_legacy(
						balance_env,
						plan.variable,
						plan.bind_type,
						protected_body,
					)
				else:
					match transform_let_constructor_match_body(
						balance_env,
						plan.variable,
						plan.bind_type,
						scrutinee,
						release_policy,
						cases,
						fallback,
						typ,
						loc,
					):
						Some(balanced_match):
							balanced_match
						None:
							balance_let_body_legacy(
								balance_env,
								plan.variable,
								plan.bind_type,
								protected_body,
							)
			_:
				balance_let_body_legacy(balance_env, plan.variable, plan.bind_type, protected_body)

		alias_retained_body: CoreExpr = if body_starts_with_dup(
			plan.variable.name,
			plan.source_body,
		):
			balanced_body
		else:
			retain_alias_source_in_body(
				env,
				plan.variable,
				plan.bind_type,
				plan.source_rhs,
				balanced_body,
			)

		LetExpr(plan.variable, False, plan.bind_type, rewritten_rhs, alias_retained_body)


private pure func rewrite_constructor_literal_match_cases(
	env: PerceusEnv,
	cases: List[CoreLiteralMatchCase],
) -> List[CoreLiteralMatchCase]:
	var rewritten: List[CoreLiteralMatchCase] = []

	for match_case in cases:
		rewritten = rewritten.append(
			{ match_case | body = insert_drops_expr_inner(env, match_case.body) },
		)

	rewritten


private pure func rewrite_constructor_literal_match_fallback(
	env: PerceusEnv,
	fallback: CoreLiteralMatchFallback,
) -> CoreLiteralMatchFallback:
	match fallback:
		LiteralMatchFallbackBody(body):
			LiteralMatchFallbackBody(insert_drops_expr_inner(env, body))
		LiteralMatchFallbackBindings(bindings, body):
			LiteralMatchFallbackBindings(
				bindings,
				insert_drops_expr_inner(env, body),
			)
		LiteralMatchFallbackFail:
			LiteralMatchFallbackFail


private pure func rewrite_constructor_literal_match(
	env: PerceusEnv,
	match_expr: CoreConstructorLiteralMatch,
) -> CoreConstructorLiteralMatch:
	{ match_expr |
		cases = rewrite_constructor_literal_match_cases(env, match_expr.cases),
		fallback = rewrite_constructor_literal_match_fallback(env, match_expr.fallback)
	}


private pure func rewrite_constructor_match_body(
	env: PerceusEnv,
	body: CoreConstructorMatchBody,
) -> CoreConstructorMatchBody:
	match body:
		ConstructorMatchBodyExpr(expr):
			ConstructorMatchBodyExpr(insert_drops_expr_inner(env, expr))
		ConstructorMatchBodyLiteral(match_expr):
			ConstructorMatchBodyLiteral(rewrite_constructor_literal_match(env, match_expr))
		ConstructorMatchBodyLength(match_expr):
			ConstructorMatchBodyLength(rewrite_constructor_length_match(env, match_expr))


private pure func rewrite_constructor_length_branch(
	env: PerceusEnv,
	branch: CoreConstructorLengthMatchBranch,
) -> CoreConstructorLengthMatchBranch:
	{ branch | body = rewrite_constructor_match_body(env, branch.body) }


private pure func rewrite_constructor_length_case(
	env: PerceusEnv,
	match_case: CoreConstructorLengthMatchCase,
) -> CoreConstructorLengthMatchCase:
	{ match_case | branch = rewrite_constructor_length_branch(env, match_case.branch) }


private pure func rewrite_constructor_length_cases(
	env: PerceusEnv,
	cases: List[CoreConstructorLengthMatchCase],
) -> List[CoreConstructorLengthMatchCase]:
	var rewritten: List[CoreConstructorLengthMatchCase] = []

	for match_case in cases:
		rewritten = rewritten.append(rewrite_constructor_length_case(env, match_case))

	rewritten


private pure func rewrite_constructor_length_geq(
	env: PerceusEnv,
	geq: Option[CoreConstructorLengthMatchGeq],
) -> Option[CoreConstructorLengthMatchGeq]:
	match geq:
		Some(value):
			Some({ value | branch = rewrite_constructor_length_branch(env, value.branch) })
		None:
			None


private pure func rewrite_constructor_length_fallback(
	env: PerceusEnv,
	fallback: Option[CoreConstructorLengthMatchBranch],
) -> Option[CoreConstructorLengthMatchBranch]:
	match fallback:
		Some(branch):
			Some(rewrite_constructor_length_branch(env, branch))
		None:
			None


private pure func rewrite_constructor_length_match(
	env: PerceusEnv,
	match_expr: CoreConstructorLengthMatch,
) -> CoreConstructorLengthMatch:
	{ match_expr |
		cases = rewrite_constructor_length_cases(env, match_expr.cases),
		geq = rewrite_constructor_length_geq(env, match_expr.geq),
		fallback = rewrite_constructor_length_fallback(env, match_expr.fallback)
	}


private pure func rewrite_constructor_match_case(
	env: PerceusEnv,
	match_case: CoreConstructorMatchCase,
) -> CoreConstructorMatchCase:
	{ match_case | body = rewrite_constructor_match_body(env, match_case.body) }


private pure func rewrite_constructor_match_cases(
	env: PerceusEnv,
	cases: List[CoreConstructorMatchCase],
) -> List[CoreConstructorMatchCase]:
	var rewritten: List[CoreConstructorMatchCase] = []

	for match_case in cases:
		rewritten = rewritten.append(rewrite_constructor_match_case(env, match_case))

	rewritten


private pure func rewrite_constructor_match_fallback(
	env: PerceusEnv,
	fallback: CoreConstructorMatchFallback,
) -> CoreConstructorMatchFallback:
	match fallback:
		ConstructorMatchFallbackBody(body):
			ConstructorMatchFallbackBody(insert_drops_expr_inner(env, body))
		ConstructorMatchFallbackBindings(bindings, body):
			ConstructorMatchFallbackBindings(
				bindings,
				insert_drops_expr_inner(env, body),
			)
		ConstructorMatchFallbackFail:
			ConstructorMatchFallbackFail


private pure func rewrite_literal_match_case(
	env: PerceusEnv,
	match_case: CoreLiteralMatchCase,
) -> CoreLiteralMatchCase:
	{ match_case | body = insert_drops_expr_inner(env, match_case.body) }


private pure func rewrite_literal_match_cases(
	env: PerceusEnv,
	cases: List[CoreLiteralMatchCase],
) -> List[CoreLiteralMatchCase]:
	var rewritten: List[CoreLiteralMatchCase] = []

	for match_case in cases:
		rewritten = rewritten.append(rewrite_literal_match_case(env, match_case))

	rewritten


private pure func rewrite_literal_match_fallback(
	env: PerceusEnv,
	fallback: CoreLiteralMatchFallback,
) -> CoreLiteralMatchFallback:
	match fallback:
		LiteralMatchFallbackBody(body):
			LiteralMatchFallbackBody(insert_drops_expr_inner(env, body))
		LiteralMatchFallbackBindings(bindings, body):
			LiteralMatchFallbackBindings(
				bindings,
				insert_drops_expr_inner(env, body),
			)
		LiteralMatchFallbackFail:
			LiteralMatchFallbackFail


private pure func rewrite_boxed_values(
	env: PerceusEnv,
	values: List[CoreBoxedStorageValue],
) -> List[CoreBoxedStorageValue]:
	var rewritten: List[CoreBoxedStorageValue] = []

	for value in values:
		rewritten = rewritten.append({ value | value = insert_drops_expr_inner(env, value.value) })

	rewritten


private pure func rewrite_record_fields(
	env: PerceusEnv,
	fields: List[CoreRecordFieldValue],
) -> List[CoreRecordFieldValue]:
	var rewritten: List[CoreRecordFieldValue] = []

	for field in fields:
		rewritten = rewritten.append({ field | value = insert_drops_expr_inner(env, field.value) })

	rewritten


private pure func rewrite_dict_entries(
	env: PerceusEnv,
	entries: List[CoreDictEntry],
) -> List[CoreDictEntry]:
	var rewritten: List[CoreDictEntry] = []

	for entry in entries:
		rewritten = rewritten.append({ entry |
				key = { entry.key | value = insert_drops_expr_inner(env, entry.key.value) },
				value = { entry.value | value = insert_drops_expr_inner(env, entry.value.value) }
			})

	rewritten


private pure func rewrite_pre_closure_concurrent_bindings(
	env: PerceusEnv,
	bindings: List[CorePreClosureConcurrentBinding],
) -> List[CorePreClosureConcurrentBinding]:
	var rewritten: List[CorePreClosureConcurrentBinding] = []

	for binding in bindings:
		rewritten = rewritten.append({ binding | rhs = insert_drops_expr_inner(env, binding.rhs) })

	rewritten


private pure func retain_borrowed_loop_body(
	env: PerceusEnv,
	binder: CoreLoopBinder,
	body: CoreExpr,
) -> CoreExpr:
	if is_managed_type(env, binder.typ):
		retain_borrowed_owned_uses(
			env,
			{
				name = binder.variable,
				typ = binder.typ,
				loc = SyntheticSourceLoc
			},
			body,
		)
	else:
		body


private pure func rewrite_loop_body(
	env: PerceusEnv,
	binder: CoreLoopBinder,
	body: CoreExpr,
) -> CoreExpr:
	retained_body: CoreExpr = retain_borrowed_loop_body(env, binder, body)
	insert_drops_expr_inner(env, retained_body)


private pure func rewrite_loop_iterable(
	env: PerceusEnv,
	iterable: CoreExpr,
	release_policy: CoreReleasePolicy,
) -> CoreExpr:
	rewritten: CoreExpr = insert_drops_expr_inner(env, iterable)

	match release_policy:
		NoReleasePolicy:
			rewritten
		_:
			-- Loop emitters release managed iterable temporaries. Treat the
			-- temporary as an ordinary owned binding so borrowed variables,
			-- fields, and aliasing calls keep their source owner alive.
			normalize_binding_alias_rhs(env, core_expr_type(rewritten), rewritten)


--- Scope carried by the borrowed-iteration walk.
--- `scope` maps a name to `True` only when its binding provably owns the value
--- for longer than any loop inside that binding's body: a borrowed parameter or
--- an immutable `let`. Every other binder maps its name to `False`, and an
--- expression form the walk does not handle recurses with an empty scope, so a
--- binder the walk cannot see can never be mistaken for a borrowable source.
private record BorrowedLoopContext {
	env: PerceusEnv,
	scope: Dict[String, Bool]
}


--- A binder that is neither borrowable nor shadowing a name already in scope
--- changes no answer, so it costs no scope entry. A borrowable binder is
--- recorded only when its value is managed, which is the only way a list or
--- string loop can read it.
private pure func borrowed_loop_context_with_name(
	context: BorrowedLoopContext,
	name: String,
	typ: CoreType,
	borrowable: Bool,
) -> BorrowedLoopContext:
	record_binding: Bool = if borrowable:
		is_managed_type(context.env, typ)
	else:
		context.scope.contains(name)

	if not record_binding:
		context
	else:
		{ context | scope = context.scope.set(name, borrowable) }


private pure func borrowed_loop_context_with_binder(
	context: BorrowedLoopContext,
	binder: CoreLoopBinder,
) -> BorrowedLoopContext:
	borrowed_loop_context_with_name(context, binder.variable.name, binder.typ, False)


private pure func borrowed_loop_context_with_bindings(
	context: BorrowedLoopContext,
	bindings: List[CoreMatchBinding],
) -> BorrowedLoopContext:
	var scoped: BorrowedLoopContext = context

	for binding in bindings:
		scoped = borrowed_loop_context_with_name(scoped, binding.variable.name, binding.typ, False)

	scoped


--- A reassignment of the iterated variable installs a new owner and releases
--- the old one, which a borrowed loop would still be reading. Look through
--- every subtree, including lambdas and nested loops.
private pure func subtree_assigns_name(name: String, expr: CoreExpr) -> Bool:
	var pending: List[CoreExpr] = [expr]
	var index: Int = 0
	var found: Bool = False

	while not found and index < pending.length():
		match pending.get(index):
			Some(node):
				assigns: Bool = match node:
					AssignExpr(variable, rhs, typ, loc):
						variable.name == name
					_:
						False

				if assigns:
					found = True
				else:
					pending = pending.concat(CoreTraverse.immediate_core_expr_children(node))
			None:
				void

		index += 1

	found


--- Closure and task environments take their own ownership of a capture after
--- Perceus. Keep any loop whose body mentions the iterated variable inside a
--- lambda or closure on the owned path.
private pure func subtree_captures_name(name: String, expr: CoreExpr) -> Bool:
	var pending: List[CoreExpr] = [expr]
	var index: Int = 0
	var found: Bool = False

	while not found and index < pending.length():
		match pending.get(index):
			Some(node):
				captures: Bool = match node:
					LambdaExpr(params, return_type, body, is_pure, typ, loc):
						count_uses(name, body) > 0
					ClosureCreateExpr(closure, typ, loc):
						closure.captures.any(pure func(capture: CoreClosureCapture) -> Bool:
							capture.name == name
						)
					_:
						False

				if captures:
					found = True
				else:
					pending = pending.concat(CoreTraverse.immediate_core_expr_children(node))
			None:
				void

		index += 1

	found


--- The loop may iterate the source pointer without taking ownership when the
--- source outlives the loop and nothing in the body can release it.
private pure func loop_iterable_is_borrowed(
	context: BorrowedLoopContext,
	iterable: CoreExpr,
	body: CoreExpr,
) -> Bool:
	env: PerceusEnv = context.env

	match iterable:
		VarExpr(variable, typ, loc):
			if not is_managed_type(env, typ):
				False
			else if not context.scope.get_or(variable.name, False):
				False
			else if is_nullary_constructor_reference(env, variable):
				False
			else if exact_global_value(env, variable).is_some():
				-- A global slot can be reassigned by anything the body calls.
				False
			else if subtree_assigns_name(variable.name, body):
				False
			else if subtree_captures_name(variable.name, body):
				False
			else:
				summarize_linear_ownership_uses(env, variable.name, body).consumed_refs == 0
		_:
			False


private pure func borrowed_loop_release_policy(
	context: BorrowedLoopContext,
	iterable: CoreExpr,
	body: CoreExpr,
	release_policy: CoreReleasePolicy,
) -> CoreReleasePolicy:
	match release_policy:
		NoReleasePolicy:
			release_policy
		_:
			if loop_iterable_is_borrowed(context, iterable, body):
				NoReleasePolicy
			else:
				release_policy


private pure func mark_borrowed_loops_match_result(
	context: BorrowedLoopContext,
	bindings: List[CoreMatchBinding],
	result: CoreExpr,
) -> CoreExpr:
	mark_borrowed_loops_expr(
		borrowed_loop_context_with_bindings(context, bindings),
		result,
	)


--- Binding and branch spines are right-associated and can be thousands of
--- nodes deep in generated code, so the walk descends them iteratively. The
--- stack holds the source node and the scope that was current at it, both of
--- which already exist, so a spine node costs no new object.
--- Decide borrowed iteration before ownership insertion runs. Only the loop's
--- release policy changes; `rewrite_loop_iterable` then leaves a borrowed
--- iterable as the bare read it already is.
private pure func mark_borrowed_loops_expr(
	context: BorrowedLoopContext,
	expr: CoreExpr,
) -> CoreExpr:
	var spine: List[CoreExpr] = []
	var contexts: List[BorrowedLoopContext] = []
	var current: CoreExpr = expr
	var current_context: BorrowedLoopContext = context
	var descending: Bool = True

	while descending:
		match current:
			LetExpr(variable, is_mutable, typ, rhs, body):
				spine = spine.append(current)
				contexts = contexts.append(current_context)
				current_context = borrowed_loop_context_with_name(
					current_context,
					variable.name,
					typ,
					not is_mutable,
				)
				current = body
			BorrowLetExpr(variable, typ, rhs, body):
				spine = spine.append(current)
				contexts = contexts.append(current_context)
				current_context = borrowed_loop_context_with_name(
					current_context,
					variable.name,
					typ,
					False,
				)
				current = body
			SeqExpr(first, second):
				spine = spine.append(current)
				contexts = contexts.append(current_context)
				current = second
			IfExpr(cond, then_expr, else_expr, typ, loc):
				spine = spine.append(current)
				contexts = contexts.append(current_context)
				current = else_expr
			_:
				descending = False

	var result: CoreExpr = mark_borrowed_loops_node(current_context, current)
	var index: Int = spine.length() - 1

	while index >= 0:
		match spine.get(index):
			Some(source):
				match contexts.get(index):
					Some(frame_context):
						result = mark_borrowed_loops_spine_node(frame_context, source, result)
					None:
						void
			None:
				void

		index -= 1

	result


--- Rebuild one spine node around its already-marked trailing child, reusing the
--- source node when nothing under it changed.
private pure func mark_borrowed_loops_spine_node(
	context: BorrowedLoopContext,
	source: CoreExpr,
	trailing: CoreExpr,
) -> CoreExpr:
	match source:
		LetExpr(variable, is_mutable, typ, rhs, body):
			marked_rhs: CoreExpr = mark_borrowed_loops_expr(context, rhs)

			if same_core_expr(marked_rhs, rhs) and same_core_expr(trailing, body):
				source
			else:
				LetExpr(variable, is_mutable, typ, marked_rhs, trailing)
		BorrowLetExpr(variable, typ, rhs, body):
			marked_rhs: CoreExpr = mark_borrowed_loops_expr(context, rhs)

			if same_core_expr(marked_rhs, rhs) and same_core_expr(trailing, body):
				source
			else:
				BorrowLetExpr(variable, typ, marked_rhs, trailing)
		SeqExpr(first, second):
			marked_first: CoreExpr = mark_borrowed_loops_expr(context, first)

			if same_core_expr(marked_first, first) and same_core_expr(trailing, second):
				source
			else:
				SeqExpr(marked_first, trailing)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			marked_cond: CoreExpr = mark_borrowed_loops_expr(context, cond)
			marked_then: CoreExpr = mark_borrowed_loops_expr(context, then_expr)

			if (
				same_core_expr(marked_cond, cond)
				and same_core_expr(marked_then, then_expr)
				and same_core_expr(trailing, else_expr)
			):
				source
			else:
				IfExpr(marked_cond, marked_then, trailing, typ, loc)
		_:
			-- The descent pushes only the four forms above.
			source


--- Every form the spine descent does not consume. Sequence and logical spines
--- go through the iterative mappers for the same stack reason.
private pure func mark_borrowed_loops_node(
	context: BorrowedLoopContext,
	expr: CoreExpr,
) -> CoreExpr:
	match expr:
		LogicalExpr(op, left, right, typ, loc):
			CoreTraverse.map_core_logical_tree_with_context(expr, context, mark_borrowed_loops_expr)
		WhileExpr(cond, body, typ, loc):
			marked_cond: CoreExpr = mark_borrowed_loops_expr(context, cond)
			marked_body: CoreExpr = mark_borrowed_loops_expr(context, body)

			if same_core_expr(marked_cond, cond) and same_core_expr(marked_body, body):
				expr
			else:
				WhileExpr(marked_cond, marked_body, typ, loc)
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			marked_start: CoreExpr = mark_borrowed_loops_expr(context, start)
			marked_end: CoreExpr = mark_borrowed_loops_expr(context, end_value)
			marked_body: CoreExpr = mark_borrowed_loops_expr(
				borrowed_loop_context_with_binder(context, binder),
				body,
			)

			if (
				same_core_expr(marked_start, start)
				and same_core_expr(marked_end, end_value)
				and same_core_expr(marked_body, body)
			):
				expr
			else:
				ForRangeExpr(binder, marked_start, marked_end, marked_body, typ, loc)
		ForListExpr(loop, typ, loc):
			marked_iterable: CoreExpr = mark_borrowed_loops_expr(context, loop.iterable)
			marked_body: CoreExpr = mark_borrowed_loops_expr(
				borrowed_loop_context_with_binder(context, loop.binder),
				loop.body,
			)
			policy: CoreReleasePolicy = borrowed_loop_release_policy(
				context,
				loop.iterable,
				loop.body,
				loop.iterable_release_policy,
			)

			if (
				same_core_expr(marked_iterable, loop.iterable)
				and same_core_expr(marked_body, loop.body)
				and policy == loop.iterable_release_policy
			):
				expr
			else:
				ForListExpr(
					{ loop |
						iterable = marked_iterable,
						iterable_release_policy = policy,
						body = marked_body
					},
					typ,
					loc,
				)
		ForStringExpr(loop, typ, loc):
			marked_iterable: CoreExpr = mark_borrowed_loops_expr(context, loop.iterable)
			marked_body: CoreExpr = mark_borrowed_loops_expr(
				borrowed_loop_context_with_binder(context, loop.binder),
				loop.body,
			)
			policy: CoreReleasePolicy = borrowed_loop_release_policy(
				context,
				loop.iterable,
				loop.body,
				loop.iterable_release_policy,
			)

			if (
				same_core_expr(marked_iterable, loop.iterable)
				and same_core_expr(marked_body, loop.body)
				and policy == loop.iterable_release_policy
			):
				expr
			else:
				ForStringExpr(
					{ loop |
						iterable = marked_iterable,
						iterable_release_policy = policy,
						body = marked_body
					},
					typ,
					loc,
				)
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			CoreTraverse.map_core_match_results_with_context(
				expr,
				context,
				mark_borrowed_loops_match_result,
			)
		AccessorLiteralMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			CoreTraverse.map_core_match_results_with_context(
				expr,
				context,
				mark_borrowed_loops_match_result,
			)
		LengthMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			CoreTraverse.map_core_match_results_with_context(
				expr,
				context,
				mark_borrowed_loops_match_result,
			)
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			CoreTraverse.map_core_match_results_with_context(
				expr,
				context,
				mark_borrowed_loops_match_result,
			)
		_:
			-- Stop. Every remaining form loses the scope anyway, and descending
			-- through the generic child mapper costs one closure per node of the
			-- whole program to reach the few loops nested under one.
			expr


--- Classify every list and string loop in one function body before ownership
--- insertion. A consumed parameter is owned by this body and can be
--- transferred away, so only borrowed parameters seed the scope.
pure func mark_borrowed_loop_iterables(
	env: PerceusEnv,
	params: List[CoreParam],
	consumed_params: List[Int],
	body: CoreExpr,
) -> CoreExpr:
	var scope: Dict[String, Bool] = {}
	var index: Int = 0

	for param in params:
		scope = scope.set(param.name.name, not int_list_contains(consumed_params, index))
		index += 1

	mark_borrowed_loops_expr(
		{
			env = env,
			scope = scope
		},
		body,
	)


private pure func insert_drops_ownership_node(env: PerceusEnv, expr: CoreExpr) -> CoreExpr:
	normalized: CoreExpr = normalize_ownership_node(env, expr)
	insert_drops_normalized_expr(env, normalized)


private pure func rebuild_assignment(
	env: PerceusEnv,
	variable: CoreVar,
	rewritten_rhs: CoreExpr,
	typ: CoreType,
	loc: CoreSourceLoc,
) -> CoreExpr:
	match mutable_managed_global_for_target(env, variable):
		Some(global):
			rewrite_direct_mutable_assignment(
				env,
				global.name,
				global.typ,
				rewritten_rhs,
				typ,
				loc,
				0,
				False,
			).expr
		None:
			retain_assignment_alias_rhs(
				env,
				AssignExpr(variable, rewritten_rhs, typ, loc),
			)


private pure func resolved_value_occurrence_count(
	index: PerceusResolvedValueIndex,
	variable: CoreVar,
) -> Int:
	debug:
		perceus_work_resolved_value_queries()

	match (variable.def_id, index.occurrences_by_def_id_by_uniq_by_name.get(variable.name)):
		(Some(def_id), Some(occurrences_by_uniq)):
			match occurrences_by_uniq.get(variable.uniq):
				Some(occurrences_by_def_id):
					occurrences_by_def_id.get_or(def_id, 0)
				None:
					0
		_:
			0


private pure func add_resolved_value(
	index: PerceusResolvedValueIndex,
	variable: CoreVar,
) -> PerceusResolvedValueIndex:
	match variable.def_id:
		Some(def_id):
			occurrences_by_uniq: Dict[Int, Dict[Int, Int]] = index.occurrences_by_def_id_by_uniq_by_name.get_or(
				variable.name,
				{},
			)
			occurrences_by_def_id: Dict[Int, Int] = occurrences_by_uniq.get_or(variable.uniq, {})
			occurrences: Int = occurrences_by_def_id.get_or(def_id, 0)

			{
				occurrences_by_def_id_by_uniq_by_name = index.occurrences_by_def_id_by_uniq_by_name.set(
					variable.name,
					occurrences_by_uniq.set(
						variable.uniq,
						occurrences_by_def_id.set(def_id, occurrences + 1),
					),
				),
			}
		None:
			index


private pure func add_resolved_value_occurrences(
	index: PerceusResolvedValueIndex,
	expr: CoreExpr,
) -> PerceusResolvedValueIndex:
	var updated: PerceusResolvedValueIndex = index

	for variable in CoreDce.resolved_value_occurrences(expr):
		updated = add_resolved_value(updated, variable)

	updated


private pure func without_bound_value(
	index: PerceusResolvedValueIndex,
	variable: CoreVar,
) -> PerceusResolvedValueIndex:
	match (variable.def_id, index.occurrences_by_def_id_by_uniq_by_name.get(variable.name)):
		(Some(def_id), Some(occurrences_by_uniq)):
			match occurrences_by_uniq.get(variable.uniq):
				Some(occurrences_by_def_id):
					if not occurrences_by_def_id.contains(def_id):
						index
					else:
						remaining_by_def_id: Dict[Int, Int] = occurrences_by_def_id.remove(def_id)

						remaining_by_uniq: Dict[Int, Dict[Int, Int]] = if remaining_by_def_id.is_empty():
							occurrences_by_uniq.remove(variable.uniq)
						else:
							occurrences_by_uniq.set(variable.uniq, remaining_by_def_id)

						remaining_by_name: Dict[String, Dict[Int, Dict[Int, Int]]] = if remaining_by_uniq.is_empty():
							index.occurrences_by_def_id_by_uniq_by_name.remove(variable.name)
						else:
							index.occurrences_by_def_id_by_uniq_by_name.set(
								variable.name,
								remaining_by_uniq,
							)

						{occurrences_by_def_id_by_uniq_by_name = remaining_by_name}
				None:
					index
		_:
			index


private pure func inserted_expr(expr: CoreExpr, reuses_source: Bool) -> PerceusInsertedExpr:
	direct_consume: Option[PerceusDirectConsume] = match expr:
		VarExpr(variable, typ, loc):
			Some({variable = variable})
		_:
			None

	{
		expr = expr,
		direct_consume = direct_consume,
		reuses_source = reuses_source
	}


private pure func expr_references_exact_value(expr: CoreExpr, target: CoreVar) -> Bool:
	references = CoreDce.value_references(expr)

	(
		references.resolved_reads.any(func(variable): same_core_var(variable, target))
		or references.resolved_invalidations.any(func(variable): same_core_var(variable, target))
	)


private pure func call_single_direct_consume(env: PerceusEnv, expr: CoreExpr) -> Option[CoreVar]:
	match expr:
		CallExpr(kind, callee, args, typ, loc):
			match contract_for_call(env, kind, args.length(), typ):
				Some(contract):
					result_is_non_owner: Bool = match contract.result:
						ReturnVoid | ReturnPrimitive:
							True
						_:
							False

					var candidate: Option[CoreVar] = None
					var candidate_index: Option[Int] = None
					var valid: Bool = result_is_non_owner
					var index: Int = 0

					for arg in args:
						match contract.args.get(index):
							Some(mode):
								if arg_consumes_caller(mode):
									match (candidate, arg):
										(None, VarExpr(variable, _, _)):
											candidate = Some(variable)
											candidate_index = Some(index)
										_:
											valid = False
								else:
									void
							None:
								valid = False

						index += 1

					match (valid, candidate, candidate_index):
						(True, Some(variable), Some(consumed_index)):
							var has_other_reference: Bool = expr_references_exact_value(
								callee,
								variable,
							)
							index = 0

							for arg in args:
								if (
									index != consumed_index
									and expr_references_exact_value(arg, variable)
								):
									has_other_reference = True
								else:
									void

								index += 1

							if has_other_reference:
								None
							else:
								Some(variable)
						_:
							None
				None:
					None
		_:
			None


private pure func inserted_non_binding_expr(
	env: PerceusEnv,
	expr: CoreExpr,
	reuses_source: Bool,
) -> PerceusInsertedExpr:
	base: PerceusInsertedExpr = inserted_expr(expr, reuses_source)

	match call_single_direct_consume(env, expr):
		Some(variable):
			{ base | direct_consume = Some({variable = variable}) }
		None:
			base


private pure func inserted_sequence(
	source: CoreExpr,
	first: PerceusInsertedExpr,
	second: PerceusInsertedExpr,
) -> PerceusInsertedExpr:
	direct_consume: Option[PerceusDirectConsume] = match first.direct_consume:
		Some(consume):
			Some(consume)
		None:
			None

	reuses_source: Bool = first.reuses_source and second.reuses_source

	result_expr: CoreExpr = if reuses_source:
		source
	else:
		SeqExpr(first.expr, second.expr)

	{
		expr = result_expr,
		direct_consume = direct_consume,
		reuses_source = reuses_source
	}


-- A binding wrapper preserves a transfer performed by its body when the
-- wrapper binds a different hygienic variable. References in the RHS still
-- count as additional uses of that transferred value, regardless of whether
-- they occur before or after the final consume.
private pure func inserted_binding_expr(
	expr: CoreExpr,
	variable: CoreVar,
	body: PerceusInsertedExpr,
	reuses_source: Bool,
) -> PerceusInsertedExpr:
	direct_consume: Option[PerceusDirectConsume] = match body.direct_consume:
		Some(consume):
			if same_core_var(variable, consume.variable):
				None
			else:
				Some(consume)
		None:
			None

	{
		expr = expr,
		direct_consume = direct_consume,
		reuses_source = reuses_source
	}


private pure func managed_let_is_proven_unused(
	env: PerceusEnv,
	plan: PerceusManagedLetPlan,
	resolved_values: PerceusResolvedValueIndex,
) -> Bool:
	if plan.is_mutable or is_immortal_value_expr(env, plan.owned_rhs):
		False
	else:
		(
			plan.variable.def_id.is_some()
			and resolved_value_occurrence_count(resolved_values, plan.variable) == 0
		)


private pure func rebuild_proven_unused_managed_let(
	plan: PerceusManagedLetPlan,
	rewritten_rhs: CoreExpr,
	rewritten_body: CoreExpr,
) -> CoreExpr:
	LetExpr(
		plan.variable,
		False,
		plan.bind_type,
		rewritten_rhs,
		prepend_drops(1, plan.variable, plan.bind_type, rewritten_body),
	)


private pure func managed_let_has_single_direct_consume(
	env: PerceusEnv,
	plan: PerceusManagedLetPlan,
	body: PerceusInsertedExpr,
	resolved_values: PerceusResolvedValueIndex,
) -> Bool:
	if plan.is_mutable or is_immortal_value_expr(env, plan.owned_rhs):
		False
	else:
		match body.direct_consume:
			Some(consume):
				(
					plan.variable.def_id.is_some()
					and same_core_var(consume.variable, plan.variable)
					and resolved_value_occurrence_count(resolved_values, plan.variable) == 1
				)
			None:
				False


private pure func insert_drops_expr_inner_result(
	env: PerceusEnv,
	expr: CoreExpr,
) -> PerceusInsertedExpr:
	-- Blocks lower to long right-associated binding chains. Perceus is a
	-- post-order pass, so retain the exact RHS-before-body order in explicit
	-- frames instead of consuming one C stack frame per source binding.
	var frames: PerceusInsertBindingFrameStack = PerceusInsertNoBindingFrame
	var visiting: Bool = True
	var current_expr: CoreExpr = expr
	-- The loop can exit only from the rebuild branch. This seed keeps the
	-- function total if that state-machine invariant ever changes.
	var pending: PerceusInsertedExpr = inserted_expr(expr, True)
	var resolved_values: PerceusResolvedValueIndex = {occurrences_by_def_id_by_uniq_by_name = {}}
	var managed_binding_frame_count: Int = 0
	var complete: Bool = False

	while not complete:
		if visiting:
			current: CoreExpr = current_expr

			debug:
				perceus_work_insert_node_visits()

			match current:
				LetExpr(variable, is_mutable, bind_type, rhs, body):
					if is_managed_type(env, bind_type):
						debug:
							perceus_work_insert_managed_let_visits()

						plan: PerceusManagedLetPlan = plan_managed_let(
							env,
							current,
							variable,
							is_mutable,
							bind_type,
							rhs,
							body,
						)
						frames = PerceusInsertManagedLetRhsFrame(plan, frames)
						managed_binding_frame_count += 1
						visiting = True
						current_expr = plan.owned_rhs
					else:
						frames = PerceusInsertLetRhsFrame(
							current,
							variable,
							is_mutable,
							bind_type,
							body,
							frames,
						)
						visiting = True
						current_expr = rhs
				BorrowLetExpr(variable, bind_type, rhs, body):
					frames = PerceusInsertBorrowLetRhsFrame(
						current,
						variable,
						bind_type,
						body,
						frames,
					)
					visiting = True
					current_expr = rhs
				SeqExpr(first, second):
					frames = PerceusInsertSequenceFirstFrame(current, second, frames)
					visiting = True
					current_expr = first
				AssignExpr(variable, rhs, typ, loc):
					frames = PerceusInsertAssignRhsFrame(variable, typ, loc, frames)
					visiting = True
					current_expr = rhs
				_:
					-- A root non-binding expression has no outer binding decision to
					-- inform. Skipping its reference scan also prevents recursive child
					-- rewrites from duplicating whole-subtree collection.
					if managed_binding_frame_count > 0:
						resolved_values = add_resolved_value_occurrences(resolved_values, current)
					else:
						void

					visiting = False
					pending = insert_drops_non_binding_expr(env, current)
		else:
			rewritten: PerceusInsertedExpr = pending

			debug:
				perceus_work_insert_rebuild_actions()

				if rewritten.reuses_source:
					perceus_work_insert_original_nodes_reused()
				else:
					perceus_work_insert_node_reconstructions()

			match frames:
				PerceusInsertNoBindingFrame:
					complete = True
				PerceusInsertManagedLetRhsFrame(plan, remaining):
					frames = PerceusInsertManagedLetBodyFrame(plan, rewritten, remaining)
					visiting = True
					current_expr = plan.branch_safe_body
				PerceusInsertManagedLetBodyFrame(plan, rewritten_rhs, remaining):
					frames = remaining
					proven_unused: Bool = managed_let_is_proven_unused(env, plan, resolved_values)
					direct_consume: Bool = managed_let_has_single_direct_consume(
						env,
						plan,
						rewritten,
						resolved_values,
					)
					ownership_neutral: Bool = (
						direct_consume
						or not plan.is_mutable and is_immortal_value_expr(env, plan.owned_rhs)
					)

					reuses_source: Bool = (
						not proven_unused
						and ownership_neutral
						and managed_let_reuses_source(plan, rewritten_rhs, rewritten)
					)

					rebuilt: CoreExpr = if proven_unused:
						rebuild_proven_unused_managed_let(plan, rewritten_rhs.expr, rewritten.expr)
					else if reuses_source:
						plan.source
					else if direct_consume:
						LetExpr(
							plan.variable,
							False,
							plan.bind_type,
							rewritten_rhs.expr,
							rewritten.expr,
						)
					else:
						rebuild_managed_let(env, plan, rewritten_rhs.expr, rewritten.expr)

					debug:
						if reuses_source:
							perceus_work_insert_managed_let_original_nodes_reused()
						else:
							perceus_work_insert_managed_let_reconstructions()

					resolved_values = without_bound_value(resolved_values, plan.variable)
					managed_binding_frame_count -= 1
					visiting = False
					pending = inserted_binding_expr(
						rebuilt,
						plan.variable,
						rewritten,
						reuses_source,
					)
				PerceusInsertLetRhsFrame(source, variable, is_mutable, bind_type, body, remaining):
					frames = PerceusInsertLetBodyFrame(
						source,
						variable,
						is_mutable,
						bind_type,
						rewritten,
						remaining,
					)
					visiting = True
					current_expr = body
				PerceusInsertLetBodyFrame(source, variable, is_mutable, bind_type, rewritten_rhs, remaining):
					frames = remaining
					resolved_values = without_bound_value(resolved_values, variable)
					reuses_source: Bool = rewritten_rhs.reuses_source and rewritten.reuses_source

					rebuilt: CoreExpr = if reuses_source:
						source
					else:
						LetExpr(variable, is_mutable, bind_type, rewritten_rhs.expr, rewritten.expr)

					visiting = False
					pending = inserted_binding_expr(rebuilt, variable, rewritten, reuses_source)
				PerceusInsertBorrowLetRhsFrame(source, variable, bind_type, body, remaining):
					frames = PerceusInsertBorrowLetBodyFrame(
						source,
						variable,
						bind_type,
						rewritten,
						remaining,
					)
					visiting = True
					current_expr = body
				PerceusInsertBorrowLetBodyFrame(source, variable, bind_type, rewritten_rhs, remaining):
					frames = remaining
					resolved_values = without_bound_value(resolved_values, variable)
					reuses_source: Bool = rewritten_rhs.reuses_source and rewritten.reuses_source

					rebuilt: CoreExpr = if reuses_source:
						source
					else:
						BorrowLetExpr(variable, bind_type, rewritten_rhs.expr, rewritten.expr)

					visiting = False
					pending = inserted_binding_expr(rebuilt, variable, rewritten, reuses_source)
				PerceusInsertSequenceFirstFrame(source, second, remaining):
					frames = PerceusInsertSequenceSecondFrame(source, rewritten, remaining)
					visiting = True
					current_expr = second
				PerceusInsertSequenceSecondFrame(source, rewritten_first, remaining):
					frames = remaining
					visiting = False
					pending = inserted_sequence(source, rewritten_first, rewritten)
				PerceusInsertAssignRhsFrame(variable, typ, loc, remaining):
					frames = remaining
					resolved_values = add_resolved_value(resolved_values, variable)
					visiting = False
					pending = inserted_expr(
						rebuild_assignment(env, variable, rewritten.expr, typ, loc),
						False,
					)

	pending


private pure func insert_drops_expr_inner(env: PerceusEnv, expr: CoreExpr) -> CoreExpr:
	insert_drops_expr_inner_result(env, expr).expr


private pure func opaque_inserted_non_binding_expr(
	env: PerceusEnv,
	expr: CoreExpr,
) -> PerceusInsertedExpr:
	debug:
		perceus_work_insert_opaque_rewrite_results()

	inserted_non_binding_expr(env, expr, False)


private pure func insert_drops_change_aware_call(
	env: PerceusEnv,
	source: CoreExpr,
	kind: CoreCallKind,
	callee: CoreExpr,
	args: List[CoreExpr],
	typ: CoreType,
	loc: CoreSourceLoc,
) -> PerceusInsertedExpr:
	debug:
		perceus_work_insert_call_visits()

	normalization_reuses_source: Bool = call_ownership_normalization_reuses_source(
		env,
		kind,
		callee,
		args,
		typ,
	)

	result: PerceusInsertedExpr = if not normalization_reuses_source:
		opaque_inserted_non_binding_expr(
			env,
			insert_drops_ownership_node(env, source),
		)
	else:
		rewritten_callee: PerceusInsertedExpr = insert_drops_expr_inner_result(env, callee)
		var rewritten_args: List[CoreExpr] = args
		var reuses_source: Bool = rewritten_callee.reuses_source
		var index: Int = 0

		for arg in args:
			rewritten_arg: PerceusInsertedExpr = insert_drops_expr_inner_result(env, arg)

			if not rewritten_arg.reuses_source:
				rewritten_args = rewritten_args.set(index, rewritten_arg.expr)
				reuses_source = False
			else:
				void

			index += 1

		if reuses_source:
			inserted_non_binding_expr(env, source, True)
		else:
			inserted_non_binding_expr(
				env,
				CallExpr(kind, rewritten_callee.expr, rewritten_args, typ, loc),
				False,
			)

	debug:
		if result.reuses_source:
			perceus_work_insert_call_original_nodes_reused()
		else:
			perceus_work_insert_call_reconstructions()

	result


private pure func insert_drops_change_aware_fixed_ownership(
	env: PerceusEnv,
	source: CoreExpr,
) -> PerceusInsertedExpr:
	debug:
		perceus_work_insert_fixed_ownership_visits()

	normalization: PerceusOwnershipNormalization = match source:
		UnboxExpr(_, _, _, _):
			normalize_unbox_ownership_change_aware(env, source)
		BinaryExpr(_, _, _, _, _):
			normalize_binary_ownership_change_aware(env, source)
		FieldExpr(_, _, _, _) | TupleFieldExpr(_, _, _, _):
			normalize_projection_ownership_change_aware(env, source)
		_:
			ChangedPerceusOwnershipNormalization(source)

	result: PerceusInsertedExpr = match normalization:
		ChangedPerceusOwnershipNormalization(normalized):
			debug:
				perceus_work_insert_fixed_ownership_normalization_rewrites()

			opaque_inserted_non_binding_expr(
				env,
				insert_drops_normalized_expr(env, normalized),
			)
		UnchangedPerceusOwnershipNormalization:
			match source:
				UnboxExpr(kind, inner, typ, loc):
					rewritten_inner: PerceusInsertedExpr = insert_drops_expr_inner_result(
						env,
						inner,
					)

					if rewritten_inner.reuses_source:
						inserted_non_binding_expr(env, source, True)
					else:
						inserted_non_binding_expr(
							env,
							UnboxExpr(kind, rewritten_inner.expr, typ, loc),
							False,
						)
				BinaryExpr(op, left, right, typ, loc):
					rewritten_left: PerceusInsertedExpr = insert_drops_expr_inner_result(env, left)
					rewritten_right: PerceusInsertedExpr = insert_drops_expr_inner_result(
						env,
						right,
					)
					reuses_source: Bool = (
						rewritten_left.reuses_source
						and rewritten_right.reuses_source
					)

					if reuses_source:
						inserted_non_binding_expr(env, source, True)
					else:
						inserted_non_binding_expr(
							env,
							BinaryExpr(op, rewritten_left.expr, rewritten_right.expr, typ, loc),
							False,
						)
				FieldExpr(owner, field, typ, loc):
					rewritten_owner: PerceusInsertedExpr = insert_drops_expr_inner_result(
						env,
						owner,
					)

					if rewritten_owner.reuses_source:
						inserted_non_binding_expr(env, source, True)
					else:
						inserted_non_binding_expr(
							env,
							FieldExpr(rewritten_owner.expr, field, typ, loc),
							False,
						)
				TupleFieldExpr(owner, field_index, typ, loc):
					rewritten_owner: PerceusInsertedExpr = insert_drops_expr_inner_result(
						env,
						owner,
					)

					if rewritten_owner.reuses_source:
						inserted_non_binding_expr(env, source, True)
					else:
						inserted_non_binding_expr(
							env,
							TupleFieldExpr(rewritten_owner.expr, field_index, typ, loc),
							False,
						)
				_:
					opaque_inserted_non_binding_expr(
						env,
						insert_drops_normalized_expr(env, source),
					)

	debug:
		if result.reuses_source:
			perceus_work_insert_fixed_ownership_original_nodes_reused()
		else:
			perceus_work_insert_fixed_ownership_reconstructions()

	result


private pure func insert_drops_non_binding_expr(
	env: PerceusEnv,
	expr: CoreExpr,
) -> PerceusInsertedExpr:
	match expr:
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			opaque_inserted_non_binding_expr(
				env,
				insert_drops_ownership_node(env, expr),
			)
		AccessorLiteralMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			opaque_inserted_non_binding_expr(
				env,
				insert_drops_ownership_node(env, expr),
			)
		LengthMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			opaque_inserted_non_binding_expr(
				env,
				insert_drops_ownership_node(env, expr),
			)
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			opaque_inserted_non_binding_expr(
				env,
				insert_drops_ownership_node(env, expr),
			)
		TupleExpr(_, _, _) | VectorExpr(_, _, _) | RecordExpr(_, _, _) | RecordUpdateExpr(_, _, _, _) | RecordReuseExpr(_, _, _, _) | RecordCowUpdateExpr(_, _, _, _) | RecordConstructExpr(_, _, _, _) | ListConstructExpr(_, _, _) | TensorBoxedLiteralExpr(_, _, _) | DictConstructExpr(_, _, _) | UnionConstructExpr(_, _, _):
			insert_drops_change_aware_aggregate(env, expr)
		CallExpr(kind, callee, args, typ, loc):
			insert_drops_change_aware_call(env, expr, kind, callee, args, typ, loc)
		UnboxExpr(_, _, _, _) | BinaryExpr(_, _, _, _, _) | FieldExpr(_, _, _, _) | TupleFieldExpr(_, _, _, _):
			insert_drops_change_aware_fixed_ownership(env, expr)
		_:
			insert_drops_change_aware_normalized_expr(env, expr)


private pure func insert_drops_change_aware_normalized_expr(
	env: PerceusEnv,
	expr: CoreExpr,
) -> PerceusInsertedExpr:
	match expr:
		LiteralExpr(literal, typ, loc):
			inserted_expr(expr, True)
		StaticStringLiteralExpr(id, value, typ, loc):
			inserted_expr(expr, True)
		VarExpr(variable, typ, loc):
			inserted_expr(expr, True)
		VoidExpr(typ, loc):
			inserted_expr(expr, True)
		CooperativeCheckpointExpr(typ, loc):
			inserted_expr(expr, True)
		BreakExpr(typ, loc):
			inserted_expr(expr, True)
		ContinueExpr(typ, loc):
			inserted_expr(expr, True)
		SetAllocExpr(alloc, typ, loc):
			inserted_expr(expr, True)
		DebugBlockExpr(body, typ, loc):
			rewritten_body: PerceusInsertedExpr = insert_drops_expr_inner_result(env, body)

			if rewritten_body.reuses_source:
				inserted_expr(expr, True)
			else:
				inserted_expr(
					DebugBlockExpr(rewritten_body.expr, typ, loc),
					False,
				)
		UnaryExpr(op, value, typ, loc):
			rewritten_value: PerceusInsertedExpr = insert_drops_expr_inner_result(env, value)

			if rewritten_value.reuses_source:
				inserted_expr(expr, True)
			else:
				inserted_expr(
					UnaryExpr(op, rewritten_value.expr, typ, loc),
					False,
				)
		CastExpr(inner, typ, loc):
			rewritten_inner: PerceusInsertedExpr = insert_drops_expr_inner_result(env, inner)

			if rewritten_inner.reuses_source:
				inserted_expr(expr, True)
			else:
				inserted_expr(
					CastExpr(rewritten_inner.expr, typ, loc),
					False,
				)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			rewritten_cond: PerceusInsertedExpr = insert_drops_expr_inner_result(env, cond)
			rewritten_then: PerceusInsertedExpr = insert_drops_expr_inner_result(env, then_expr)
			rewritten_else: PerceusInsertedExpr = insert_drops_expr_inner_result(env, else_expr)
			reuses_source: Bool = (
				rewritten_cond.reuses_source
				and rewritten_then.reuses_source
				and rewritten_else.reuses_source
			)

			if reuses_source:
				inserted_expr(expr, True)
			else:
				inserted_expr(
					IfExpr(rewritten_cond.expr, rewritten_then.expr, rewritten_else.expr, typ, loc),
					False,
				)
		WhileExpr(cond, body, typ, loc):
			rewritten_cond: PerceusInsertedExpr = insert_drops_expr_inner_result(env, cond)
			rewritten_body: PerceusInsertedExpr = insert_drops_expr_inner_result(env, body)
			reuses_source: Bool = rewritten_cond.reuses_source and rewritten_body.reuses_source

			if reuses_source:
				inserted_expr(expr, True)
			else:
				inserted_expr(
					WhileExpr(rewritten_cond.expr, rewritten_body.expr, typ, loc),
					False,
				)
		RangeExpr(start, end_value, typ, loc):
			rewritten_start: PerceusInsertedExpr = insert_drops_expr_inner_result(env, start)
			rewritten_end: PerceusInsertedExpr = insert_drops_expr_inner_result(env, end_value)
			reuses_source: Bool = rewritten_start.reuses_source and rewritten_end.reuses_source

			if reuses_source:
				inserted_expr(expr, True)
			else:
				inserted_expr(
					RangeExpr(rewritten_start.expr, rewritten_end.expr, typ, loc),
					False,
				)
		PreClosureDetachExpr(detached, typ, loc):
			rewritten: PerceusInsertedExpr = insert_drops_expr_inner_result(env, detached)

			if rewritten.reuses_source:
				inserted_expr(expr, True)
			else:
				inserted_expr(
					PreClosureDetachExpr(rewritten.expr, typ, loc),
					False,
				)
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			rewritten_body: PerceusInsertedExpr = insert_drops_expr_inner_result(env, body)

			if rewritten_body.reuses_source:
				inserted_expr(expr, True)
			else:
				inserted_expr(
					DupExpr(variable, value_type, retain_policy, rewritten_body.expr, typ, loc),
					False,
				)
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			rewritten_body: PerceusInsertedExpr = insert_drops_expr_inner_result(env, body)

			if rewritten_body.reuses_source:
				inserted_expr(expr, True)
			else:
				inserted_expr(
					DropExpr(variable, value_type, release_policy, rewritten_body.expr, typ, loc),
					False,
				)
		_:
			-- The remaining families rebuild through the generic child map, which
			-- hands back the source allocation when no child moved. Recognising
			-- that identity is exact: the same allocation is the same expression,
			-- so no ownership decision above it can differ.
			rewritten: CoreExpr = insert_drops_normalized_expr(env, expr)

			if same_core_expr(rewritten, expr):
				inserted_non_binding_expr(env, expr, True)
			else:
				opaque_inserted_non_binding_expr(env, rewritten)


-- Every loop arm rebuilds an outer node and an inner loop record on each visit.
-- Return the source loop instead when the iterable and the rewritten body both
-- come back as the same allocation: `rewrite_loop_body` already folds in the
-- binder's retains, so an unchanged body means no dup or drop was inserted for
-- it and the whole subtree is unchanged.
private pure func insert_drops_for_loop_expr(env: PerceusEnv, expr: CoreExpr) -> CoreExpr:
	match expr:
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			rewritten_start: CoreExpr = insert_drops_expr_inner(env, start)
			rewritten_end: CoreExpr = insert_drops_expr_inner(env, end_value)
			rewritten_body: CoreExpr = rewrite_loop_body(env, binder, body)

			if (
				same_core_expr(rewritten_start, start)
				and same_core_expr(rewritten_end, end_value)
				and same_core_expr(rewritten_body, body)
			):
				expr
			else:
				ForRangeExpr(binder, rewritten_start, rewritten_end, rewritten_body, typ, loc)
		ForChannelExpr(loop, typ, loc):
			rewritten_iterable: CoreExpr = insert_drops_expr_inner(env, loop.iterable)
			rewritten_body: CoreExpr = rewrite_loop_body(env, loop.binder, loop.body)

			if (
				same_core_expr(rewritten_iterable, loop.iterable)
				and same_core_expr(rewritten_body, loop.body)
			):
				expr
			else:
				ForChannelExpr(
					{ loop |
						iterable = rewritten_iterable,
						body = rewritten_body
					},
					typ,
					loc,
				)
		ForListExpr(loop, typ, loc):
			rewritten_iterable: CoreExpr = rewrite_loop_iterable(
				env,
				loop.iterable,
				loop.iterable_release_policy,
			)
			rewritten_body: CoreExpr = rewrite_loop_body(env, loop.binder, loop.body)

			if (
				same_core_expr(rewritten_iterable, loop.iterable)
				and same_core_expr(rewritten_body, loop.body)
			):
				expr
			else:
				ForListExpr(
					{ loop |
						iterable = rewritten_iterable,
						body = rewritten_body
					},
					typ,
					loc,
				)
		ForStringExpr(loop, typ, loc):
			rewritten_iterable: CoreExpr = rewrite_loop_iterable(
				env,
				loop.iterable,
				loop.iterable_release_policy,
			)
			rewritten_body: CoreExpr = rewrite_loop_body(env, loop.binder, loop.body)

			if (
				same_core_expr(rewritten_iterable, loop.iterable)
				and same_core_expr(rewritten_body, loop.body)
			):
				expr
			else:
				ForStringExpr(
					{ loop |
						iterable = rewritten_iterable,
						body = rewritten_body
					},
					typ,
					loc,
				)
		ForDictExpr(loop, typ, loc):
			rewritten_iterable: CoreExpr = rewrite_loop_iterable(
				env,
				loop.iterable,
				loop.iterable_release_policy,
			)
			rewritten_body: CoreExpr = rewrite_loop_body(env, loop.binder, loop.body)

			if (
				same_core_expr(rewritten_iterable, loop.iterable)
				and same_core_expr(rewritten_body, loop.body)
			):
				expr
			else:
				ForDictExpr(
					{ loop |
						iterable = rewritten_iterable,
						body = rewritten_body
					},
					typ,
					loc,
				)
		ForSetExpr(loop, typ, loc):
			rewritten_iterable: CoreExpr = rewrite_loop_iterable(
				env,
				loop.iterable,
				loop.iterable_release_policy,
			)
			rewritten_body: CoreExpr = rewrite_loop_body(env, loop.binder, loop.body)

			if (
				same_core_expr(rewritten_iterable, loop.iterable)
				and same_core_expr(rewritten_body, loop.body)
			):
				expr
			else:
				ForSetExpr(
					{ loop |
						iterable = rewritten_iterable,
						body = rewritten_body
					},
					typ,
					loc,
				)
		ForStreamExpr(loop, typ, loc):
			rewritten_iterable: CoreExpr = rewrite_loop_iterable(
				env,
				loop.iterable,
				loop.iterable_release_policy,
			)
			rewritten_body: CoreExpr = rewrite_loop_body(env, loop.binder, loop.body)

			if (
				same_core_expr(rewritten_iterable, loop.iterable)
				and same_core_expr(rewritten_body, loop.body)
			):
				expr
			else:
				ForStreamExpr(
					{ loop |
						iterable = rewritten_iterable,
						body = rewritten_body
					},
					typ,
					loc,
				)
		ForResourceSourceExpr(loop, typ, loc):
			rewritten_iterable: CoreExpr = rewrite_loop_iterable(
				env,
				loop.iterable,
				loop.iterable_release_policy,
			)
			rewritten_body: CoreExpr = rewrite_loop_body(env, loop.binder, loop.body)

			if (
				same_core_expr(rewritten_iterable, loop.iterable)
				and same_core_expr(rewritten_body, loop.body)
			):
				expr
			else:
				ForResourceSourceExpr(
					{ loop |
						iterable = rewritten_iterable,
						body = rewritten_body
					},
					typ,
					loc,
				)
		ForTensorExpr(loop, typ, loc):
			rewritten_iterable: CoreExpr = rewrite_loop_iterable(
				env,
				loop.iterable,
				loop.iterable_release_policy,
			)
			rewritten_body: CoreExpr = rewrite_loop_body(env, loop.binder, loop.body)

			if (
				same_core_expr(rewritten_iterable, loop.iterable)
				and same_core_expr(rewritten_body, loop.body)
			):
				expr
			else:
				ForTensorExpr(
					{ loop |
						iterable = rewritten_iterable,
						body = rewritten_body
					},
					typ,
					loc,
				)
		_:
			-- The caller dispatches only loop nodes here. Stay total rather than
			-- assume that stays true.
			expr


private pure func insert_drops_normalized_expr(env: PerceusEnv, expr: CoreExpr) -> CoreExpr:
	match expr:
		LetExpr(variable, is_mutable, bind_type, rhs, body):
			insert_drops_expr_inner(env, expr)
		BorrowLetExpr(variable, bind_type, rhs, body):
			insert_drops_expr_inner(env, expr)
		SeqExpr(first, second):
			insert_drops_expr_inner(env, expr)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			IfExpr(
				insert_drops_expr_inner(env, cond),
				insert_drops_expr_inner(env, then_expr),
				insert_drops_expr_inner(env, else_expr),
				typ,
				loc,
			)
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			ConstructorMatchExpr(
				insert_drops_expr_inner(env, scrutinee),
				release_policy,
				rewrite_constructor_match_cases(env, cases),
				rewrite_constructor_match_fallback(env, fallback),
				typ,
				loc,
			)
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			-- `ConstructorMatchExpr` gets this same per-case treatment above; a
			-- `LiteralMatchExpr` (e.g. matching a `String`/`Int`/`Char` scrutinee)
			-- fell through to the generic child mapper at the bottom of this
			-- function instead. That mapper processes every branch as an
			-- unrelated child rather than as one of several mutually exclusive
			-- arms, so when two or more arms each call a function that consumes
			-- the same outer `var` (e.g. threading an owned record through a
			-- `while` loop, one call per arm), nothing marks the shared variable
			-- as needing a retain before the call: each arm's occurrence looks
			-- like an uncontested last use in isolation. That produced a bare
			-- move at the call plus an unconditional drop at the loop's
			-- `var = ...` reassignment afterward -- a double release.
			LiteralMatchExpr(
				insert_drops_expr_inner(env, scrutinee),
				rewrite_literal_match_cases(env, cases),
				rewrite_literal_match_fallback(env, fallback),
				typ,
				loc,
			)
		CallExpr(kind, callee, args, typ, loc):
			CallExpr(
				kind,
				insert_drops_expr_inner(env, callee),
				rewrite_exprs(env, args),
				typ,
				loc,
			)
		CastExpr(inner, typ, loc):
			CastExpr(
				insert_drops_expr_inner(env, inner),
				typ,
				loc,
			)
		BinaryExpr(op, left, right, typ, loc):
			BinaryExpr(
				op,
				insert_drops_expr_inner(env, left),
				insert_drops_expr_inner(env, right),
				typ,
				loc,
			)
		LogicalExpr(op, left, right, typ, loc):
			CoreTraverse.map_core_logical_tree_with_context(expr, env, insert_drops_expr_inner)
		TupleExpr(items, typ, loc):
			TupleExpr(
				rewrite_exprs(env, items),
				typ,
				loc,
			)
		VectorExpr(items, typ, loc):
			VectorExpr(
				rewrite_exprs(env, items),
				typ,
				loc,
			)
		RecordExpr(fields, typ, loc):
			RecordExpr(
				rewrite_record_fields(env, fields),
				typ,
				loc,
			)
		RecordUpdateExpr(base, fields, typ, loc):
			RecordUpdateExpr(
				insert_drops_expr_inner(env, base),
				rewrite_record_fields(env, fields),
				typ,
				loc,
			)
		RecordReuseExpr(source, fields, typ, loc):
			RecordReuseExpr(
				insert_drops_expr_inner(env, source),
				rewrite_record_fields(env, fields),
				typ,
				loc,
			)
		RecordCowUpdateExpr(source, fields, typ, loc):
			RecordCowUpdateExpr(
				insert_drops_expr_inner(env, source),
				CoreTraverse.map_core_record_cow_fields(
					fields,
					pure func(replacement): insert_drops_expr_inner(env, replacement),
				),
				typ,
				loc,
			)
		RecordConstructExpr(type_name, fields, typ, loc):
			RecordConstructExpr(
				type_name,
				rewrite_record_fields(env, fields),
				typ,
				loc,
			)
		ListConstructExpr(construct, typ, loc):
			ListConstructExpr(
				{ construct | elements = rewrite_boxed_values(env, construct.elements) },
				typ,
				loc,
			)
		TensorBoxedLiteralExpr(literal, typ, loc):
			TensorBoxedLiteralExpr(
				{ literal | elements = rewrite_boxed_values(env, literal.elements) },
				typ,
				loc,
			)
		DictConstructExpr(construct, typ, loc):
			DictConstructExpr(
				{ construct | entries = rewrite_dict_entries(env, construct.entries) },
				typ,
				loc,
			)
		AssignExpr(variable, rhs, typ, loc):
			insert_drops_expr_inner(env, expr)
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			DupExpr(
				variable,
				value_type,
				retain_policy,
				insert_drops_expr_inner(env, body),
				typ,
				loc,
			)
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			DropExpr(
				variable,
				value_type,
				release_policy,
				insert_drops_expr_inner(env, body),
				typ,
				loc,
			)
		ForRangeExpr(_, _, _, _, _, _) | ForChannelExpr(_, _, _) | ForListExpr(_, _, _) | ForStringExpr(_, _, _) | ForDictExpr(_, _, _) | ForSetExpr(_, _, _) | ForStreamExpr(_, _, _) | ForResourceSourceExpr(_, _, _) | ForTensorExpr(_, _, _):
			insert_drops_for_loop_expr(env, expr)
		PreClosureConcurrentExpr(block, typ, loc):
			rewritten_body: CoreExpr = insert_drops_expr_inner(env, block.body)
			var balanced_body: CoreExpr = rewritten_body

			for binding in block.bindings:
				balanced_body = balance_concurrent_binding_body(
					env,
					binding.variable,
					binding.typ,
					balanced_body,
				)

			rewritten_timeout: Option[CoreExpr] = match block.timeout:
				Some(timeout):
					Some(insert_drops_expr_inner(env, timeout))
				None:
					None

			PreClosureConcurrentExpr(
				{ block |
					bindings = rewrite_pre_closure_concurrent_bindings(env, block.bindings),
					body = balanced_body,
					timeout = rewritten_timeout
				},
				typ,
				loc,
			)
		_:
			CoreTraverse.map_core_expr_children_with_context(expr, env, insert_drops_expr_inner)


pure func insert_drops_expr(env: PerceusEnv, expr: CoreExpr) -> CoreExpr:
	normalized: CoreExpr = normalize_lambda_result_aliases(env, expr)
	insert_drops_expr_inner(env, normalized)


private pure func rewrite_exprs(env: PerceusEnv, exprs: List[CoreExpr]) -> List[CoreExpr]:
	var rewritten: List[CoreExpr] = []

	for expr in exprs:
		rewritten = rewritten.append(insert_drops_expr_inner(env, expr))

	rewritten


private pure func balance_consumed_param_body(
	env: PerceusEnv,
	param: CoreParam,
	body: CoreExpr,
) -> CoreExpr:
	variable: CoreVar = param.name
	value_type: CoreType = param.typ
	protected: CoreExpr = protect_repeated_consumes(env, variable, value_type, body, False)
	balance_env: PerceusEnv = { env | balance_strategy = BranchAwareOwnershipBalance }
	uses: OwnershipUseSummary = summarize_linear_ownership_uses(
		balance_env,
		variable.name,
		protected,
	)
	owned_refs: Int = max_int(1, uses.required_refs)
	balanced: CoreExpr = balance_branch_body(
		balance_env,
		variable,
		value_type,
		owned_refs,
		uses,
		protected,
	)

	prepend_dups(owned_refs - 1, variable, value_type, balanced)


-- The catalog-and-proof setup only repays its fixed cost for broad generated
-- signatures. Smaller functions retain the general balancing path.
private SIMPLE_CONSUMED_PARAMETER_BALANCE_MINIMUM: Int = 16


private pure func simple_consumed_parameter_catalog(
	env: PerceusEnv,
	params: List[CoreParam],
	return_type: CoreType,
	consumed_params: List[Int],
) -> Option[SimpleConsumedParameterCatalog]:
	if (
		is_managed_type(env, return_type)
		or consumed_params.length() < SIMPLE_CONSUMED_PARAMETER_BALANCE_MINIMUM
	):
		None
	else:
		var all_parameter_names: Dict[String, Bool] = {}
		var consumed_indices_by_name: Dict[String, Int] = {}
		var consumed_parameter_count: Int = 0
		var eligible: Bool = True
		var index: Int = 0

		for param in params:
			if all_parameter_names.contains(param.name.name):
				eligible = False
			else:
				all_parameter_names = all_parameter_names.set(param.name.name, True)

			if int_list_contains(consumed_params, index):
				if is_managed_type(env, param.typ) and param.name.uniq == 0:
					match param.name.def_id:
						None:
							consumed_indices_by_name = consumed_indices_by_name.set(
								param.name.name,
								index,
							)
							consumed_parameter_count += 1
						Some(def_id):
							eligible = False
				else:
					eligible = False
			else:
				void

			index += 1

		if eligible and consumed_parameter_count == consumed_params.length():
			Some({
				all_parameter_names = all_parameter_names,
				consumed_indices_by_name = consumed_indices_by_name,
				consumed_parameter_count = consumed_parameter_count,
			})
		else:
			None


-- This proof recognizes only a linear post-insertion body where balancing
-- every consumed parameter is an identity operation. A call is supported only
-- when its exact ownership contract directly consumes each referenced
-- candidate once. Borrowed arguments, branches, aliases, repetition,
-- shadowing, and ownership nodes for parameters all retain the established
-- parameter-by-parameter logic.
private pure func prove_simple_consumed_parameter_balance(
	env: PerceusEnv,
	catalog: SimpleConsumedParameterCatalog,
	body: CoreExpr,
) -> SimpleConsumedParameterBalance:
	var pending: SimpleConsumedParameterScanStack = SimpleConsumedParameterScanMore(
		body,
		SimpleConsumedParameterScanComplete,
	)
	var observed_indices: Dict[Int, Bool] = {}
	var observed_count: Int = 0
	var supported: Bool = True
	var complete: Bool = False

	while not complete:
		match pending:
			SimpleConsumedParameterScanComplete:
				complete = True
			SimpleConsumedParameterScanMore(expr, remaining):
				pending = remaining

				if supported:
					match expr:
						LiteralExpr(_, _, _) | StaticStringLiteralExpr(_, _, _, _) | VoidExpr(_, _):
							void
						VarExpr(variable, _, _):
							match catalog.consumed_indices_by_name.get(variable.name):
								Some(index):
									if (
										variable.uniq == 0
										and variable.def_id == None
										and not observed_indices.contains(index)
									):
										observed_indices = observed_indices.set(index, True)
										observed_count += 1
									else:
										supported = False
								None:
									supported = False
						SeqExpr(first, second):
							pending = SimpleConsumedParameterScanMore(
								first,
								SimpleConsumedParameterScanMore(second, pending),
							)
						LetExpr(variable, is_mutable, bind_type, rhs, let_body):
							rhs_is_literal: Bool = match rhs:
								LiteralExpr(_, _, _) | StaticStringLiteralExpr(_, _, _, _):
									True
								_:
									False

							if (
								not is_mutable
								and rhs_is_literal
								and not catalog.all_parameter_names.contains(variable.name)
							):
								pending = SimpleConsumedParameterScanMore(let_body, pending)
							else:
								supported = False
						CallExpr(kind, callee, args, typ, loc):
							callee_is_unrelated_function: Bool = match callee:
								VarExpr(variable, _, _):
									not catalog.all_parameter_names.contains(variable.name)
								_:
									False

							if not callee_is_unrelated_function:
								supported = False
							else:
								match contract_for_call(env, kind, args.length(), typ):
									Some(contract):
										var arg_index: Int = 0

										while supported and arg_index < args.length():
											match args.get(arg_index):
												Some(argument):
													match contract.args.get(arg_index):
														Some(mode):
															match argument:
																VarExpr(variable, _, _):
																	variable_name: String = variable.name

																	match catalog.consumed_indices_by_name.get(
																		variable_name,
																	):
																		Some(index):
																			if (
																				arg_consumes_caller(
																					mode,
																				)
																				and variable.uniq == 0
																				and variable.def_id == None
																				and not observed_indices.contains(
																					index,
																				)
																			):
																				observed_indices = observed_indices.set(
																					index,
																					True,
																				)
																				observed_count += 1
																			else:
																				supported = False
																		None:
																			supported = False
																LiteralExpr(_, _, _) | StaticStringLiteralExpr(_, _, _, _):
																	void
																_:
																	supported = False
														None:
															supported = False
												None:
													supported = False

											arg_index += 1
									None:
										supported = False
						CastExpr(inner, _, _):
							if (
								not is_managed_type(env, core_expr_type(inner))
								and not is_managed_type(env, core_expr_type(expr))
							):
								pending = SimpleConsumedParameterScanMore(inner, pending)
							else:
								supported = False
						DropExpr(variable, value_type, release_policy, drop_body, typ, loc):
							if catalog.all_parameter_names.contains(variable.name):
								supported = False
							else:
								pending = SimpleConsumedParameterScanMore(drop_body, pending)
						_:
							supported = False
				else:
					void

	if supported and observed_count == catalog.consumed_parameter_count:
		UnchangedSimpleConsumedParameterBalance
	else:
		UnsupportedSimpleConsumedParameterBalance


-- Kept callable so regression tests can assert the production fast-path
-- decision without relying on wall-clock timing.
pure func consumed_parameter_balancing_is_identity(
	env: PerceusEnv,
	func_info: CoreFunction,
	consumed_params: List[Int],
	body: CoreExpr,
) -> Bool:
	match simple_consumed_parameter_catalog(
		env,
		func_info.params,
		func_info.return_type,
		consumed_params,
	):
		Some(catalog):
			match prove_simple_consumed_parameter_balance(env, catalog, body):
				UnchangedSimpleConsumedParameterBalance:
					True
				UnsupportedSimpleConsumedParameterBalance:
					False
		None:
			False


private pure func balance_consumed_param_bodies(
	env: PerceusEnv,
	func_info: CoreFunction,
	consumed_params: List[Int],
	body: CoreExpr,
) -> CoreExpr:
	prebalanced: Bool = consumed_parameter_balancing_is_identity(
		env,
		func_info,
		consumed_params,
		body,
	)

	if prebalanced:
		body
	else:
		var result: CoreExpr = body
		var index: Int = func_info.params.length() - 1

		while index >= 0:
			match func_info.params.get(index):
				Some(param):
					if (
						is_managed_type(env, param.typ)
						and int_list_contains(consumed_params, index)
					):
						result = balance_consumed_param_body(env, param, result)
					else:
						void
				None:
					void

			index -= 1

		result


--- A reused depth-first worklist. Growing a pending list by concatenation
--- copies every entry already on it, which is quadratic in the node count, and
--- the largest generated body in a self-compile holds more than two hundred
--- thousand nodes. Overwrite the slot the pop just freed instead, exactly as
--- the logical-tree mapper does, so one allocation serves the whole walk.
private record ShortCircuitScanStack {
	nodes: List[CoreExpr],
	operand_flags: List[Bool],
	count: Int
}


private pure func push_short_circuit_scan(
	stack: ShortCircuitScanStack,
	node: CoreExpr,
	inside_operand: Bool,
) -> ShortCircuitScanStack:
	nodes: List[CoreExpr] = if stack.count < stack.nodes.length():
		stack.nodes.set(stack.count, node)
	else:
		stack.nodes.append(node)
	operand_flags: List[Bool] = if stack.count < stack.operand_flags.length():
		stack.operand_flags.set(stack.count, inside_operand)
	else:
		stack.operand_flags.append(inside_operand)

	{ stack |
		nodes = nodes,
		operand_flags = operand_flags,
		count = stack.count + 1
	}


private pure func push_short_circuit_scan_children(
	stack: ShortCircuitScanStack,
	node: CoreExpr,
	inside_operand: Bool,
) -> ShortCircuitScanStack:
	var result: ShortCircuitScanStack = stack

	for child in CoreTraverse.immediate_core_expr_children(node):
		result = push_short_circuit_scan(result, child, inside_operand)

	result


--- A logical operator only evaluates its right operand when the left operand
--- does not already decide the result, so that operand is a branch with no
--- expression to carry the other path. An ownership transfer inside it is
--- therefore unbalanceable: the enclosing region would count the transfer on
--- every path, and the short-circuited path would keep the reference alive
--- forever. Look for the only shape that can transfer, a call under a right
--- operand, before paying for the rewrite walk. Each pushed node carries
--- whether it already sits under a right operand, so a nested operator
--- inherits the answer instead of rescanning its subtree.
private pure func has_short_circuit_operand_call(expr: CoreExpr) -> Bool:
	var stack: ShortCircuitScanStack = push_short_circuit_scan(
		{
			nodes = [],
			operand_flags = [],
			count = 0
		},
		expr,
		False,
	)
	var found: Bool = False

	while not found and stack.count > 0:
		index: Int = stack.count - 1
		stack = { stack | count = index }

		match (stack.nodes.get(index), stack.operand_flags.get(index)):
			(Some(node), Some(inside_operand)):
				match node:
					LogicalExpr(op, left, right, typ, loc):
						stack = push_short_circuit_scan(stack, left, inside_operand)
						stack = push_short_circuit_scan(stack, right, True)
					CallExpr(kind, callee, args, typ, loc):
						if inside_operand:
							found = True
						else:
							stack = push_short_circuit_scan_children(stack, node, inside_operand)
					_:
						stack = push_short_circuit_scan_children(stack, node, inside_operand)
			_:
				void

	found


--- Every name the expression reads, collected in one walk. The owner loop
--- otherwise asks `count_uses` per owner, and owners accumulate with every
--- enclosing immutable binding, so that walks the operand once per owner.
private pure func short_circuit_operand_read_names(expr: CoreExpr) -> Dict[String, Bool]:
	var stack: ShortCircuitScanStack = push_short_circuit_scan(
		{
			nodes = [],
			operand_flags = [],
			count = 0
		},
		expr,
		False,
	)
	var names: Dict[String, Bool] = {}

	while stack.count > 0:
		index: Int = stack.count - 1
		stack = { stack | count = index }

		match stack.nodes.get(index):
			Some(node):
				match node:
					VarExpr(variable, typ, loc):
						names = names.set(variable.name, True)
					_:
						void

				stack = push_short_circuit_scan_children(stack, node, False)
			None:
				void

	names


--- The owners a short-circuit operand may take a reference from: the enclosing
--- function's managed parameters and the immutable managed bindings above the
--- operator. Their ownership belongs to the linear region this pass balances.
--- Match payloads, borrowed aliases, and referenced globals carry their own
--- owner normalization and must not receive a second reference here.
private record ShortCircuitContext {
	env: PerceusEnv,
	owners: List[CoreParam]
}


--- Give the operand its own reference for every transfer it performs, so the
--- operand neither requires nor consumes ownership from the region around the
--- logical operator. The skipped path then evaluates neither the dup nor the
--- transfer, and the taken path balances itself.
private pure func own_short_circuit_operand(
	context: ShortCircuitContext,
	operand: CoreExpr,
) -> CoreExpr:
	var result: CoreExpr = operand
	read_names: Dict[String, Bool] = short_circuit_operand_read_names(operand)

	for owner in context.owners:
		-- A name the operand never reads cannot transfer it. The summary stays
		-- the authority for the ones it does read.
		if read_names.contains(owner.name.name):
			consumed_refs: Int = summarize_linear_ownership_uses(
				context.env,
				owner.name.name,
				operand,
			).consumed_refs
			result = prepend_dups(consumed_refs, owner.name, owner.typ, result)
		else:
			void

	result


private record ShortCircuitOperandFrame {
	op: CoreLogicalOp,
	right: CoreExpr,
	typ: CoreType,
	loc: CoreSourceLoc
}


--- Long `and`/`or` chains nest to the left, so walk that spine with a frame
--- list instead of one native stack frame per operator.
private pure func normalize_logical_short_circuit(
	context: ShortCircuitContext,
	expr: CoreExpr,
) -> CoreExpr:
	var frames: List[ShortCircuitOperandFrame] = []
	var current: CoreExpr = expr
	var descending: Bool = True

	while descending:
		match current:
			LogicalExpr(op, left, right, typ, loc):
				frames = frames.append({
					op = op,
					right = right,
					typ = typ,
					loc = loc,
				})
				current = left
			_:
				descending = False

	var result: CoreExpr = normalize_short_circuit_operands(context, current)
	var index: Int = frames.length() - 1

	while index >= 0:
		match frames.get(index):
			Some(frame):
				result = LogicalExpr(
					frame.op,
					result,
					own_short_circuit_operand(
						context,
						normalize_short_circuit_operands(context, frame.right),
					),
					frame.typ,
					frame.loc,
				)
			None:
				void

		index -= 1

	result


private pure func normalize_short_circuit_operands(
	context: ShortCircuitContext,
	expr: CoreExpr,
) -> CoreExpr:
	match expr:
		LogicalExpr(op, left, right, typ, loc):
			normalize_logical_short_circuit(context, expr)
		LetExpr(variable, is_mutable, typ, rhs, body):
			-- An immutable managed binding owns its value for the rest of the
			-- region, exactly like a consumed parameter, so a transfer out of a
			-- short-circuit operand below it is unbalanceable in the same way.
			-- A mutable binding can be reassigned between the dup and the
			-- transfer, so it keeps the existing reassignment handling.
			body_context: ShortCircuitContext = if (
				is_mutable or not is_managed_type(context.env, typ)
			):
				context
			else:
				{ context |
					owners = context.owners.append({
						name = variable,
						typ = typ,
						loc = SyntheticSourceLoc,
					})
				}

			LetExpr(
				variable,
				is_mutable,
				typ,
				normalize_short_circuit_operands(context, rhs),
				normalize_short_circuit_operands(body_context, body),
			)
		_:
			CoreTraverse.map_core_expr_children_with_context(
				expr,
				context,
				normalize_short_circuit_operands,
			)


private pure func balance_short_circuit_operands(
	env: PerceusEnv,
	params: List[CoreParam],
	expr: CoreExpr,
) -> CoreExpr:
	var owners: List[CoreParam] = []

	for param in params:
		if is_managed_type(env, param.typ):
			owners = owners.append(param)
		else:
			void

	if has_short_circuit_operand_call(expr):
		normalize_short_circuit_operands({ env = env, owners = owners }, expr)
	else:
		expr


private pure func rewrite_function(env: PerceusEnv, func_info: CoreFunction) -> CoreFunction:
	debug:
		perceus_work_functions_rewritten()

	name: String = func_info.name
	source_module: Option[String] = func_info.source_module
	type_params: List[String] = func_info.type_params
	params: List[CoreParam] = func_info.params
	return_type: CoreType = func_info.return_type
	body: Option[CoreExpr] = func_info.body
	is_pure: Bool = func_info.is_pure
	function_kind = func_info.function_kind
	def_id: Int = func_info.def_id
	loc: CoreSourceLoc = func_info.loc

	match body:
		Some(body):
			analysis_function: CoreFunction = {
				name = name,
				source_module = source_module,
				type_params = type_params,
				params = params,
				return_type = return_type,
				body = None,
				is_pure = is_pure,
				function_kind = function_kind,
				def_id = def_id,
				loc = loc
			}
			contract_body: CoreExpr = balance_short_circuit_operands(
				env,
				params,
				annotate_user_call_contracts(env, body),
			)

			consumed_params: List[Int] = match lookup_ownership_callable_id(
				env.callables,
				name,
				Some(def_id),
			):
				Some(callable_id):
					env.user_call_contracts.consumed_args_by_callable_id.get_or(callable_id, [])
				None:
					[]

			var transferable_result_vars: List[CoreVar] = []
			var param_index: Int = 0

			for param in params:
				if consumed_params.contains(param_index):
					transferable_result_vars = transferable_result_vars.append(param.name)
				else:
					void

				param_index += 1

			result_env: PerceusEnv = { env | transferable_result_vars = transferable_result_vars }
			borrowed_entries: List[BorrowedOwnerEntry] = borrowed_parameter_owner_entries(
				env,
				params,
				consumed_params,
			)
			all_owner_entries: List[BorrowedOwnerEntry] = append_referenced_global_owner_entries(
				env,
				params,
				contract_body,
				FunctionOwnerRegion,
				borrowed_entries,
			)
			global_safe_body: CoreExpr = normalize_borrowed_owner_entries(
				env,
				all_owner_entries,
				FunctionOwnerRegion,
				return_type,
				contract_body,
			)

			owned_result_body: CoreExpr = if is_managed_type(env, return_type):
				normalize_owned_result_aliases(result_env, global_safe_body)
			else:
				global_safe_body

			borrowed_loop_body: CoreExpr = mark_borrowed_loop_iterables(
				result_env,
				params,
				consumed_params,
				owned_result_body,
			)
			rewritten_body: CoreExpr = insert_drops_expr(result_env, borrowed_loop_body)
			balanced_body: CoreExpr = balance_consumed_param_bodies(
				env,
				analysis_function,
				consumed_params,
				rewritten_body,
			)

			{
				name = name,
				source_module = source_module,
				type_params = type_params,
				params = params,
				return_type = return_type,
				body = Some(balanced_body),
				is_pure = is_pure,
				function_kind = function_kind,
				def_id = def_id,
				loc = loc
			}
		None:
			{
				name = name,
				source_module = source_module,
				type_params = type_params,
				params = params,
				return_type = return_type,
				body = None,
				is_pure = is_pure,
				function_kind = function_kind,
				def_id = def_id,
				loc = loc
			}


private pure func rewrite_global(env: PerceusEnv, global: CoreGlobal) -> CoreGlobal:
	debug:
		perceus_work_globals_rewritten()

	name: CoreVar = global.name
	typ: CoreType = global.typ
	init: CoreExpr = global.init
	is_mutable: Bool = global.is_mutable
	is_const: Bool = global.is_const
	is_private: Bool = global.is_private
	def_id: Int = global.def_id
	loc: CoreSourceLoc = global.loc
	contract_init: CoreExpr = annotate_user_call_contracts(env, init)
	global_value: CoreParam = {
		name = { name | def_id = Some(def_id) },
		typ = typ,
		loc = loc
	}
	global_entries: List[BorrowedOwnerEntry] = referenced_global_owner_entries(
		env,
		[global_value],
		contract_init,
		GlobalInitializerOwnerRegion,
	)
	owned_init: CoreExpr = normalize_global_initializer_owner_entries(
		env,
		global_entries,
		typ,
		contract_init,
	)
	rewritten_init: CoreExpr = insert_drops_expr(env, owned_init)

	{
		name = name,
		source_module = global.source_module,
		typ = typ,
		init = rewritten_init,
		is_mutable = is_mutable,
		is_const = is_const,
		is_private = is_private,
		def_id = def_id,
		loc = loc
	}


private pure func rewrite_decl(env: PerceusEnv, decl: CoreDecl) -> CoreDecl:
	debug:
		perceus_work_declarations_rewritten()

	match decl:
		FunctionDecl(func_info):
			FunctionDecl(rewrite_function(env, func_info))
		GlobalDecl(global):
			GlobalDecl(rewrite_global(env, global))
		UnionDecl(union_decl):
			decl
		HeapRecordDecl(record_decl):
			decl
		_:
			decl


pure func insert_drops_program(program: CoreProgram) -> CoreProgram:
	resolved_program: CoreProgram = CoreResolve.resolve_global_value_refs(program)
	foreign_includes: List[String] = resolved_program.foreign_includes
	env: PerceusEnv = infer_user_call_contracts(resolved_program, build_env(resolved_program))
	var decls: List[CoreDecl] = []

	for decl in resolved_program.decls:
		decls = decls.append(rewrite_decl(env, decl))

	{
		decls = decls,
		foreign_includes = foreign_includes
	}
