-- Temporary proof that `CoreFunction.origin` is right.
--
-- `origin` (docs/NAME_MANGLING_REMOVAL_ROADMAP.md step M1.1) is written at
-- every place a Core function is created, beside the mangled name that still
-- encodes the same fact. Before any reader moves from the name to `origin`
-- (Phase 2), this check derives the classification from the name with the
-- existing decoders and reports every function whose `origin` disagrees. It is
-- deleted in step M3.1, together with the markers it reads: it is the one
-- reader allowed to parse a name shape after M1.1, and only because it is the
-- proof that the parsers being retired and the field they are replaced by
-- agree.
import:
	../stage_02_lex/name_table: name_id_index, name_spelling, name_table_count
	../stage_04_modules/loaded_module: ModuleOrigin, module_origins_equal
	../stage_04_modules/module_table:
		ModuleId,
		ModuleTable,
		module_ids_equal,
		module_table_canonical_path,
		module_table_origin,
	../stage_08_core_lower/entrypoint: ENTRYPOINT_NAME, USER_MAIN_NAME_PREFIX
	../stage_08_core_lower/identity: CORE_PURE_OVERLOAD_SUFFIX, core_module_member_prefix
	closure: ETA_NAME_PREFIX, LAMBDA_NAME_PREFIX, TASK_NAME_PREFIX
	hash_key_callbacks: HASH_KEY_EQUALS_ADAPTER_NAME, HASH_KEY_HASH_ADAPTER_NAME
	ir:
		CoreCopyDeclarations,
		CoreDecl(FunctionDecl, ImplDecl, TraitDecl),
		CoreDeclarationIndex,
		CoreDeclaredOrigin(
			Entrypoint, EtaExpansion, HashKeySlotAdapter, HoistedLambda, HoistedTask, ImplMethod,
			MonoInstance, ProjectedImplMethod, PureVariant, SourceFunction,
		),
		CoreEntrypointKind(ProgramWrapperEntrypoint, UserMainEntrypoint),
		CoreFunction,
		CoreFunctionOrigin(ConsumingClone, Declared, Synthesized),
		CoreModuleOrigin(NoSourceModule, SourceModule),
		CoreProgram,
		core_declared_member,
		core_function_declared_origin,
	synth_name: MONO_NAME_MARKER


---
The parsers the name-reading proof needs, kept private here now that no pass
reads a name for these facts: the invariant is the one reader allowed to. They
are removed with this invariant and the markers in step M3.1 (docs/NAME_MANGLING_REMOVAL_ROADMAP.md).
---
private pure func last_index_of(value: String, needle: String) -> Int:
	var last_index: Int = -1
	var search_start: Int = 0

	while search_start < value.length():
		remaining: String = value.substring(search_start, value.length() - search_start)
		relative_index: Int = remaining.raw_index_of(needle)

		if relative_index < 0:
			break
		else:
			last_index = search_start + relative_index
			search_start = last_index + needle.length()

	last_index


---
The name before the last `MONO_NAME_MARKER`, or `name` unchanged when it carries
none. A name can carry the marker more than once (a mono of a mono), and only the
last marker delimits the outermost specialization's encoded suffix.
---
private pure func mono_name_base(name: String) -> String:
	index: Int = last_index_of(name, MONO_NAME_MARKER)

	if index < 0:
		name
	else:
		name.substring(0, index)


private pure func strip_pure_suffix(name: String) -> String:
	if name.ends_with(CORE_PURE_OVERLOAD_SUFFIX):
		name.substring(0, name.length() - CORE_PURE_OVERLOAD_SUFFIX.length())
	else:
		name


---
What a function's mangled name says it is. `Plain` is a name none of the
markers touch: a source function, an impl method not yet projected, or a
synthesized one of those.
---
private union NameShape:
	ProgramEntrypointName
	UserMainName
	LambdaName(Option[Int])
	TaskName(Option[Int])
	EtaName
	HashKeyAdapterName
	MonoName
	PureName
	TraitMethodName
	PlainName


---
Whether the module table is reachable for a check. Only the early passes hold
it (the caller has the lowering input); the late passes run with
`CheckWithoutModuleTable` and apply the table-free rules alone.
---
union ModuleCheckScope:
	CheckAgainstModuleTable(ModuleTable)
	CheckWithoutModuleTable


---
How many functions were checked, how many of them each origin case
accounts for (for the report line), and the disagreements found.
---
record OriginNameAgreement {
	checked: Int,
	case_counts: List[(String, Int)],
	violations: List[String]
}


private TRAIT_METHOD_SEPARATOR: String = "_"

private ORIGIN_CASE_NAMES: List[String] = [
	"SourceFunction",
	"ImplMethod",
	"PureVariant",
	"MonoInstance",
	"Synthesized",
	"ConsumingClone",
	"HoistedLambda",
	"HoistedTask",
	"EtaExpansion",
	"HashKeySlotAdapter",
	"Entrypoint",
]


private pure func declared_case_name(origin: CoreDeclaredOrigin) -> String:
	match origin:
		SourceFunction(_):
			"SourceFunction"
		ImplMethod(_, _, _) | ProjectedImplMethod(_, _, _, _):
			"ImplMethod"
		PureVariant(_):
			"PureVariant"
		MonoInstance(_, _):
			"MonoInstance"
		HoistedLambda(_, _):
			"HoistedLambda"
		HoistedTask(_, _):
			"HoistedTask"
		EtaExpansion(_):
			"EtaExpansion"
		HashKeySlotAdapter(_):
			"HashKeySlotAdapter"
		Entrypoint(_):
			"Entrypoint"


private pure func origin_case_name(origin: CoreFunctionOrigin) -> String:
	match origin:
		Declared(declared):
			declared_case_name(declared)
		Synthesized(_, _):
			"Synthesized"
		ConsumingClone(_, _):
			"ConsumingClone"


private pure func ordinal_after_prefix(name: String, prefix: String) -> Option[Int]:
	name
		.drop_left(prefix.length())
		.parse_int()


---
The mono marker `__mono_` also occurs, without meaning it, where a flattened
module prefix (`..._synth_name__`) meets a source member that starts with
`mono_`. A real mono marker sits after the whole `<module>__<member>` name, so
a marker inside the module prefix is not one. This is the ambiguity that
makes reading the marker from the name unsound and `origin` necessary.
---
private pure func has_mono_marker_after_module_prefix(
	function_info: CoreFunction,
	name: String,
) -> Bool:
	base: String = mono_name_base(name)

	if base == name:
		False
	else:
		match function_info.source_module:
			Some(module_name):
				base.length() >= core_module_member_prefix(module_name).length()
			None:
				True


private pure func name_shape(
	function_info: CoreFunction,
	trait_names: Dict[String, Bool],
) -> NameShape:
	name: String = function_info.name

	if name == ENTRYPOINT_NAME:
		ProgramEntrypointName
	else if name.starts_with(USER_MAIN_NAME_PREFIX):
		UserMainName
	else if name.starts_with(LAMBDA_NAME_PREFIX):
		LambdaName(ordinal_after_prefix(name, LAMBDA_NAME_PREFIX))
	else if name.starts_with(TASK_NAME_PREFIX):
		TaskName(ordinal_after_prefix(name, TASK_NAME_PREFIX))
	else if name.starts_with(ETA_NAME_PREFIX):
		EtaName
	else if name == HASH_KEY_HASH_ADAPTER_NAME or name == HASH_KEY_EQUALS_ADAPTER_NAME:
		HashKeyAdapterName
	else if has_mono_marker_after_module_prefix(function_info, name):
		MonoName
	else if strip_pure_suffix(name) != name:
		PureName
	else if is_trait_method_name(name, trait_names):
		TraitMethodName
	else:
		PlainName


private pure func is_trait_method_name(name: String, trait_names: Dict[String, Bool]) -> Bool:
	separator_index: Int = name.raw_index_of(TRAIT_METHOD_SEPARATOR)

	if separator_index <= 0:
		False
	else:
		trait_names.contains(name.substring(0, separator_index))


private pure func shape_and_origin_agree(shape: NameShape, origin: CoreDeclaredOrigin) -> Bool:
	match shape:
		ProgramEntrypointName:
			match origin:
				Entrypoint(ProgramWrapperEntrypoint):
					True
				_:
					False
		UserMainName:
			match origin:
				Entrypoint(UserMainEntrypoint):
					True
				_:
					False
		LambdaName(named_ordinal):
			match origin:
				HoistedLambda(_, ordinal):
					named_ordinal == Some(ordinal)
				_:
					False
		TaskName(named_ordinal):
			match origin:
				HoistedTask(_, ordinal):
					named_ordinal == Some(ordinal)
				_:
					False
		EtaName:
			match origin:
				EtaExpansion(_):
					True
				_:
					False
		HashKeyAdapterName:
			match origin:
				HashKeySlotAdapter(_):
					True
				_:
					False
		MonoName:
			match origin:
				MonoInstance(_, _):
					True
				_:
					False
		PureName:
			match origin:
				PureVariant(_):
					True
				_:
					False
		TraitMethodName:
			match origin:
				ImplMethod(_, _, _) | ProjectedImplMethod(_, _, _, _):
					True
				_:
					False
		PlainName:
			match origin:
				SourceFunction(_) | ImplMethod(_, _, _) | ProjectedImplMethod(_, _, _, _):
					True
				_:
					False


private pure func shape_label(shape: NameShape) -> String:
	match shape:
		ProgramEntrypointName:
			"the program entrypoint"
		UserMainName:
			"the user main"
		LambdaName(_):
			"a hoisted lambda"
		TaskName(_):
			"a hoisted task"
		EtaName:
			"an eta expansion"
		HashKeyAdapterName:
			"a hash-key slot adapter"
		MonoName:
			"a mono instance"
		PureName:
			"a pure variant"
		TraitMethodName:
			"a trait method"
		PlainName:
			"a plain source or impl function"


---
How a function's module facts disagree with each other, or with the module
table when one is reachable.

Table-free rules: a function with a path String must have a `SourceModule`
(the reverse does not hold: the target module's own functions have no path
String, which is how the entrypoint pass finds `main`).

Table rules, only under `CheckAgainstModuleTable`: the id's canonical path
equals the String when there is one, and the id's origin equals the recorded
origin.
---
private pure func module_disagreement(
	function_info: CoreFunction,
	modules: ModuleCheckScope,
) -> Option[String]:
	label: String = "function `${function_info.name}` (def ${function_info.def_id.to_string()})"

	match (function_info.module, function_info.source_module):
		(NoSourceModule, None):
			None
		(NoSourceModule, Some(path)):
			Some("${label} has source module `${path}` but module origin NoSourceModule")
		(SourceModule(module_id, origin), path):
			table_module_disagreement(modules, module_id, origin, path, label)


private pure func table_module_disagreement(
	modules: ModuleCheckScope,
	module_id: ModuleId,
	origin: ModuleOrigin,
	path: Option[String],
	label: String,
) -> Option[String]:
	match modules:
		CheckWithoutModuleTable:
			None
		CheckAgainstModuleTable(table):
			if path.is_some() and module_table_canonical_path(table, module_id) != path:
				Some(
					"${label} has source module `${path.get_or("")}` but its module id names another path in the table",
				)
			else if (
				not module_table_origin(table, module_id)
					.map(
						pure func(
							table_origin: ModuleOrigin,
						) -> Bool: module_origins_equal(table_origin, origin),
					)
					.get_or(False)
			):
				Some("${label} records a module origin the table does not give its module id")
			else:
				None


private pure func function_disagreement(
	function_info: CoreFunction,
	trait_names: Dict[String, Bool],
	modules: ModuleCheckScope,
) -> Option[String]:
	match module_disagreement(function_info, modules):
		Some(message):
			Some(message)
		None:
			name_disagreement(function_info, trait_names)


private pure func name_disagreement(
	function_info: CoreFunction,
	trait_names: Dict[String, Bool],
) -> Option[String]:
	declared: CoreDeclaredOrigin = core_function_declared_origin(function_info.origin)
	shape: NameShape = name_shape(function_info, trait_names)

	if shape_and_origin_agree(shape, declared):
		None
	else:
		Some(
			"function `${function_info.name}` (def ${function_info.def_id.to_string()}) is named as ${shape_label(shape)} but its origin is ${declared_case_name(declared)}",
		)


private pure func program_trait_names(program: CoreProgram) -> Dict[String, Bool]:
	var names: Dict[String, Bool] = {}

	for decl in program.decls:
		match decl:
			TraitDecl(trait_decl):
				names = names.set(trait_decl.name, True)
			ImplDecl(impl_decl):
				names = names.set(impl_decl.trait_name, True)
			_:
				void

	names


private pure func count_origin_case(
	counts: Dict[String, Int],
	function_info: CoreFunction,
) -> Dict[String, Int]:
	case_name: String = origin_case_name(function_info.origin)
	counts.set(case_name, counts.get_or(case_name, 0) + 1)


private pure func case_counts_in_order(counts: Dict[String, Int]) -> List[(String, Int)]:
	ORIGIN_CASE_NAMES.map(
		pure func(case_name: String) -> (String, Int): (case_name, counts.get_or(case_name, 0)),
	)


---
A mono instance or pure variant must have an entry in the recorded copy
declarations once mono has recorded them (`copy_declarations` is empty until then,
and before mono there is nothing to check). A missing entry means the declaration
was pruned before mono recorded the index, and every reader of the copy's source
declaration would then find none, silently.
---
private pure func unrecorded_copy_disagreement(
	copy_declarations: CoreCopyDeclarations,
	function_info: CoreFunction,
) -> Option[String]:
	if copy_declarations.is_empty() or copy_declarations.contains(function_info.def_id):
		None
	else:
		match core_function_declared_origin(function_info.origin):
			MonoInstance(_, _) | PureVariant(_):
				Some(
					"function `${function_info.name}` (def ${function_info.def_id.to_string()}) is a copy with no entry in the recorded copy declarations",
				)
			_:
				None


---
A function's source member must be a spelling in the compilation's name table once
the table is recorded (the table is empty before mono records the index, and a
single-file tool has none). `core_declared_member_spelling` and
`core_source_function_member_spelling` turn a table miss into `None`, so synthesis,
resolve and std inlining would silently skip the function; this reports it instead.
---
private pure func unresolved_member_disagreement(
	declarations: CoreDeclarationIndex,
	function_info: CoreFunction,
) -> Option[String]:
	if name_table_count(declarations.names) == 0:
		None
	else:
		member ?= core_declared_member(declarations, function_info)

		match name_spelling(declarations.names, member):
			Some(_):
				None
			None:
				Some(
					"function `${function_info.name}` (def ${function_info.def_id.to_string()}) declares member name id ${name_id_index(member).to_string()}, which is not in the name table",
				)


---
Every function the program declares, top level or as an impl method, checked
against its name. An impl method must also carry an impl-method origin: it is
declared inside an `impl`, whatever its name looks like.
---
pure func origin_name_agreement(
	declarations: CoreDeclarationIndex,
	program: CoreProgram,
	modules: ModuleCheckScope,
) -> OriginNameAgreement:
	trait_names: Dict[String, Bool] = program_trait_names(program)
	var checked: Int = 0
	var counts: Dict[String, Int] = {}
	var violations: List[String] = []

	for decl in program.decls:
		match decl:
			FunctionDecl(function_info):
				checked += 1
				counts = count_origin_case(counts, function_info)

				match function_disagreement(function_info, trait_names, modules):
					Some(message):
						violations = violations.append(message)
					None:
						void

				match unrecorded_copy_disagreement(declarations.copy_declarations, function_info):
					Some(message):
						violations = violations.append(message)
					None:
						void

				match unresolved_member_disagreement(declarations, function_info):
					Some(message):
						violations = violations.append(message)
					None:
						void
			ImplDecl(impl_decl):
				for method in impl_decl.methods:
					checked += 1
					counts = count_origin_case(counts, method)

					match module_disagreement(method, modules):
						Some(message):
							violations = violations.append(message)
						None:
							void

					match unresolved_member_disagreement(declarations, method):
						Some(message):
							violations = violations.append(message)
						None:
							void

					match core_function_declared_origin(method.origin):
						ImplMethod(_, _, _) | ProjectedImplMethod(_, _, _, _):
							void
						other:
							violations = violations.append(
								"impl method `${method.name}` (def ${method.def_id.to_string()}) has origin ${declared_case_name(other)}, not ImplMethod",
							)
			_:
				void

	{
		checked = checked,
		case_counts = case_counts_in_order(counts),
		violations = violations
	}


---
The report-mode summary line: how many functions were checked, the count per
origin case, and how many disagree.
---
pure func origin_name_agreement_summary(agreement: OriginNameAgreement) -> String:
	counts: String = agreement.case_counts
		.map(pure func(entry: (String, Int)) -> String: "${entry[0]}=${entry[1].to_string()}")
		.join(" ")

	"${agreement.checked.to_string()} functions, ${agreement.violations.length().to_string()} disagree; ${counts}"
