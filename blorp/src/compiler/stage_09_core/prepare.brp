private pure func prepare_concurrently_loop(
	decls: PrepareDecls,
	loop: CoreConcurrentlyLoop,
) -> Option[CoreConcurrentlyLoop]:
	prepared_iterable: CoreExpr = prepare_expr(decls, loop.iterable)
	prepared_body: CoreExpr = prepare_expr(decls, loop.body)
	prepared_timeout: Option[CoreExpr] = prepare_optional_expr(decls, loop.timeout)
	prepared_limit: CoreExpr = prepare_expr(decls, loop.limit)

	if (
		same_core_expr(prepared_iterable, loop.iterable)
		and same_core_expr(prepared_body, loop.body)
		and same_optional_core_expr(prepared_timeout, loop.timeout)
		and same_core_expr(prepared_limit, loop.limit)
	):
		None
	else:
		Some({ loop |
				iterable = prepared_iterable,
				body = prepared_body,
				timeout = prepared_timeout,
				limit = prepared_limit
			})


private pure func prepare_concurrent_block(
	decls: PrepareDecls,
	block: CoreConcurrentBlock,
) -> Option[CoreConcurrentBlock]:
	prepared_bindings: Option[List[CoreConcurrentBinding]] = prepare_list_items(
		block.bindings,
		func(binding): prepare_concurrent_binding(decls, binding),
	)
	prepared_body: CoreExpr = prepare_expr(decls, block.body)
	prepared_timeout: Option[CoreExpr] = prepare_optional_expr(decls, block.timeout)

	if (
		prepared_bindings.is_none()
		and same_core_expr(prepared_body, block.body)
		and same_optional_core_expr(prepared_timeout, block.timeout)
	):
		None
	else:
		Some({ block |
				bindings = prepared_bindings.get_or(block.bindings),
				body = prepared_body,
				timeout = prepared_timeout
			})


private pure func prepare_select_recv_arm(
	decls: PrepareDecls,
	recv: CoreSelectRecvArm,
) -> Option[CoreSelectRecvArm]:
	prepared_channel: CoreExpr = prepare_expr(decls, recv.channel)

	if same_core_expr(prepared_channel, recv.channel):
		None
	else:
		Some({ recv | channel = prepared_channel })


private pure func prepare_select_arm_kind(
	decls: PrepareDecls,
	kind: CoreSelectArmKind,
) -> Option[CoreSelectArmKind]:
	match kind:
		SelectRecvArm(recv):
			match prepare_select_recv_arm(decls, recv):
				Some(prepared_recv):
					Some(SelectRecvArm(prepared_recv))
				None:
					None
		SelectSealedArm(channel):
			prepared_channel: CoreExpr = prepare_expr(decls, channel)

			if same_core_expr(prepared_channel, channel):
				None
			else:
				Some(SelectSealedArm(prepared_channel))
		SelectAfterArm(timeout):
			prepared_timeout: CoreExpr = prepare_expr(decls, timeout)

			if same_core_expr(prepared_timeout, timeout):
				None
			else:
				Some(SelectAfterArm(prepared_timeout))


private pure func prepare_select_arm(
	decls: PrepareDecls,
	arm: CoreSelectArm,
) -> Option[CoreSelectArm]:
	prepared_kind: Option[CoreSelectArmKind] = prepare_select_arm_kind(decls, arm.kind)
	prepared_body: CoreExpr = prepare_expr(decls, arm.body)

	if prepared_kind.is_none() and same_core_expr(prepared_body, arm.body):
		None
	else:
		Some({ arm |
				kind = prepared_kind.get_or(arm.kind),
				body = prepared_body
			})


pure func is_primitive_tuple_slot_type(typ: CoreType) -> Bool:
	match typ:
		NamedType(name, args):
			if args.length() != 0:
				False
			else if name == "Int":
				True
			else if name == "Int8":
				True
			else if name == "Int16":
				True
			else if name == "Int32":
				True
			else if name == "Int64":
				True
			else if name == "UInt8":
				True
			else if name == "UInt16":
				True
			else if name == "UInt32":
				True
			else if name == "UInt64":
				True
			else if name == "Bool":
				True
			else:
				name == "Char"
		TypeParameterType(_) | SelfType:
			False
		VoidType:
			False
		EnumType(name):
			True
		ValueRecordType(name):
			False
		HeapRecordType(name):
			False
		UnionType(name):
			False
		StackResultType(ok_type, err_type):
			False
		BoxedResultType(ok_type, err_type):
			False
		FunctionType(_, _, _):
			False
		RangeType:
			True
		TensorType(info):
			False
		TupleType(items):
			False


private pure func is_managed_pointer_tuple_slot_type(typ: CoreType) -> Bool:
	match typ:
		NamedType(name, args):
			if name == "Option":
				match args:
					[payload]:
						match stack_option_c_type(payload):
							Some(option_type):
								False
							None:
								True
					[]:
						False
					[first, second, ...rest]:
						False
			else if name == "String" and args.length() == 0:
				True
			else if name == "Bytes" and args.length() == 0:
				True
			else if name == "Fixed" and args.length() == 0:
				True
			else if name == "Closure" and args.length() == 0:
				True
			else if name == "List" and args.length() == 1:
				True
			else if name == "Dict" and args.length() == 2:
				True
			else:
				name == "Set" and args.length() == 1
		TypeParameterType(_) | SelfType:
			False
		StackResultType(ok_type, err_type):
			False
		BoxedResultType(ok_type, err_type):
			True
		FunctionType(_, _, _):
			True
		HeapRecordType(name):
			False
		UnionType(name):
			False
		TupleType(items):
			True
		VoidType:
			False
		EnumType(name):
			False
		ValueRecordType(name):
			False
		RangeType:
			False
		TensorType(info):
			True


private pure func is_unmanaged_pointer_tuple_slot_type(typ: CoreType) -> Bool:
	match typ:
		NamedType(name, args):
			name == "Ptr" and args.length() == 0
		TypeParameterType(_) | SelfType:
			False
		StackResultType(ok_type, err_type):
			False
		BoxedResultType(ok_type, err_type):
			False
		FunctionType(_, _, _):
			False
		HeapRecordType(name):
			False
		UnionType(name):
			False
		TupleType(items):
			False
		VoidType:
			False
		EnumType(name):
			False
		ValueRecordType(name):
			False
		RangeType:
			False
		TensorType(info):
			False


private pure func is_pointer_tuple_slot_type(typ: CoreType) -> Bool:
	is_managed_pointer_tuple_slot_type(typ) or is_unmanaged_pointer_tuple_slot_type(typ)


private pure func stack_option_tuple_slot_c_type(typ: CoreType) -> Option[String]:
	match typ:
		NamedType(name, args):
			if name == "Option":
				match args:
					[payload]:
						stack_option_c_type(payload)
					[]:
						None
					[first, second, ...rest]:
						None
			else:
				None
		TypeParameterType(_) | SelfType:
			None
		VoidType:
			None
		EnumType(name):
			None
		ValueRecordType(name):
			None
		HeapRecordType(name):
			None
		UnionType(name):
			None
		StackResultType(ok_type, err_type):
			None
		BoxedResultType(ok_type, err_type):
			None
		FunctionType(_, _, _):
			None
		RangeType:
			None
		TensorType(info):
			None
		TupleType(items):
			None


private pure func is_nullable_option_payload_type(payload: CoreType) -> Bool:
	match payload:
		NamedType(name, args):
			if name == "Option" and args.length() == 1:
				False
			else:
				pointer_box_storage_needs_release_type(payload)
		TypeParameterType(_) | SelfType:
			False
		BoxedResultType(ok_type, err_type):
			True
		FunctionType(_, _, _):
			True
		HeapRecordType(name):
			True
		UnionType(name):
			True
		TupleType(items):
			True
		TensorType(info):
			True
		StackResultType(ok_type, err_type):
			False
		VoidType:
			False
		EnumType(name):
			False
		ValueRecordType(name):
			False
		RangeType:
			False


private pure func float_tuple_element(item: CoreExpr, typ: CoreType) -> Option[CoreTupleElement]:
	match typ:
		NamedType(name, args):
			if args.length() != 0:
				None
			else if name == "Float":
				Some(TupleFloatElement(item))
			else if name == "Float32":
				Some(TupleFloat32Element(item))
			else if name == "Float16":
				Some(TupleFloat16Element(item))
			else:
				None
		TypeParameterType(_) | SelfType:
			None
		VoidType:
			None
		EnumType(name):
			None
		ValueRecordType(name):
			None
		HeapRecordType(name):
			None
		UnionType(name):
			None
		StackResultType(ok_type, err_type):
			None
		BoxedResultType(ok_type, err_type):
			None
		FunctionType(_, _, _):
			None
		RangeType:
			None
		TensorType(info):
			None
		TupleType(items):
			None


private pure func release_policy_requires_release(policy: CoreReleasePolicy) -> Bool:
	match policy:
		NoReleasePolicy:
			False
		ArcReleasePolicy:
			True
		ArcReleaseOnlyPolicy:
			True
		StackResultReleasePolicy:
			True


--- Whether a union field's stored representation owns something its
--- destructor must release. Source cleanup policy covers ownership carried by
--- the source value; erased storage can add a separately owned box around an
--- otherwise unmanaged value (for example, a value-record struct). The shared
--- specialization layout classifier is authoritative for that storage box.
pure func union_field_needs_release_in_storage(
	layout: CoreSpecializeLayout,
	payload_storage: CoreUnionPayloadStorage,
	field: CoreUnionField,
) -> Bool:
	source_value_needs_release: Bool = release_policy_requires_release(field.release_policy)

	match payload_storage:
		TypedUnionPayloadStorage:
			source_value_needs_release
		ErasedUnionPayloadStorage:
			source_value_needs_release or boxed_storage_slot_needs_release(layout, field.typ)


pure func union_variant_has_effective_cleanup(
	layout: CoreSpecializeLayout,
	payload_storage: CoreUnionPayloadStorage,
	fields: List[CoreUnionField],
) -> Bool:
	var needs_release: Bool = False

	for field in fields:
		if union_field_needs_release_in_storage(layout, payload_storage, field):
			needs_release = True
			break

	needs_release


pure func union_variant_requires_release_mask(
	layout: CoreSpecializeLayout,
	payload_storage: CoreUnionPayloadStorage,
	fields: List[CoreUnionField],
) -> Bool:
	match payload_storage:
		TypedUnionPayloadStorage:
			False
		ErasedUnionPayloadStorage:
			union_variant_has_effective_cleanup(layout, payload_storage, fields)


private pure func release_mask_for_boxed_args(args: List[CoreBoxedStorageValue]) -> Int:
	var release_mask: Int = 0
	var index: Int = 0

	for arg in args:
		if arg.needs_release:
			release_mask += int_power_of_two(index)

		index += 1

	release_mask


private pure func int_power_of_two(exponent: Int) -> Int:
	var result: Int = 1
	var index: Int = 0

	while index < exponent:
		result *= 2
		index += 1

	result


record TensorStorageBinding {
	variable: CoreVar,
	raw_kind: CoreTensorRawScalarKind
}


private pure func tensor_storage_env_without(
	env: List[TensorStorageBinding],
	variable: CoreVar,
) -> List[TensorStorageBinding]:
	var result: List[TensorStorageBinding] = []

	for binding in env:
		if not core_var_equal(binding.variable, variable):
			result = result.append(binding)

	result


private pure func tensor_storage_env_lookup(
	env: List[TensorStorageBinding],
	variable: CoreVar,
) -> Option[CoreTensorRawScalarKind]:
	var result: Option[CoreTensorRawScalarKind] = None

	for binding in env:
		if core_var_equal(binding.variable, variable):
			result = Some(binding.raw_kind)

	result


private pure func tensor_storage_env_add(
	env: List[TensorStorageBinding],
	variable: CoreVar,
	raw_kind: CoreTensorRawScalarKind,
) -> List[TensorStorageBinding]:
	[
		{
			variable = variable,
			raw_kind = raw_kind
		},
	].concat(tensor_storage_env_without(env, variable))


private pure func tensor_fill_raw_kind(name: String) -> Option[CoreTensorRawScalarKind]:
	if name == "blorp_vector_new_fill_f64":
		Some(TensorFloat64Elements)
	else if name == "blorp_vector_new_fill_f32":
		Some(TensorFloat32Elements)
	else if name == "blorp_vector_new_fill_i64":
		Some(TensorInt64Elements)
	else:
		None


private pure func tensor_expr_raw_kind(
	env: List[TensorStorageBinding],
	expr: CoreExpr,
) -> Option[CoreTensorRawScalarKind]:
	match expr:
		VarExpr(variable, typ, loc):
			tensor_storage_env_lookup(env, variable)
		TensorLiteralExpr(literal, typ, loc):
			match literal.payload:
				TensorRawLiteralPayload(raw):
					Some(raw.raw_kind)
				TensorInlineStructLiteralPayload(inline_struct):
					None
		TensorRawFillExpr(fill, typ, loc):
			Some(fill.raw_kind)
		CallExpr(BuiltinCall(name), callee, args, typ, loc):
			tensor_fill_raw_kind(name)
		CallExpr(DirectRuntimeCall(call), callee, args, typ, loc):
			tensor_fill_raw_kind(call.name)
		DupExpr(_, _, _, body, _, _):
			tensor_expr_raw_kind(env, body)
		_:
			None


private pure func tensor_storage_guard_matches(
	intrinsic_name: String,
	raw_kind: CoreTensorRawScalarKind,
) -> Bool:
	match raw_kind:
		TensorFloat64Elements:
			intrinsic_name == "tensor_is_f64_storage"
		TensorFloat32Elements:
			intrinsic_name == "tensor_is_f32_storage"
		TensorInt64Elements:
			intrinsic_name == "tensor_is_i64_storage"


private pure func tensor_storage_guard_proven(
	env: List[TensorStorageBinding],
	cond: CoreExpr,
) -> Bool:
	match cond:
		CallExpr(IntrinsicCall(intrinsic_name), callee, args, typ, loc):
			match args:
				[source]:
					match tensor_expr_raw_kind(env, source):
						Some(raw_kind):
							tensor_storage_guard_matches(intrinsic_name, raw_kind)
						None:
							False
				[]:
					False
				[first, second, ...rest]:
					False
		_:
			False


private pure func tensor_storage_env_after_binding(
	env: List[TensorStorageBinding],
	variable: CoreVar,
	is_mutable: Bool,
	rhs: CoreExpr,
) -> List[TensorStorageBinding]:
	if is_mutable:
		tensor_storage_env_without(env, variable)
	else:
		match tensor_expr_raw_kind(env, rhs):
			Some(raw_kind):
				tensor_storage_env_add(env, variable, raw_kind)
			None:
				tensor_storage_env_without(env, variable)


private pure func raw_scalar_tensor_element_storage_or(
	env: List[TensorStorageBinding],
	iterable: CoreExpr,
	fallback: CoreTensorForElementStorage,
) -> CoreTensorForElementStorage:
	match tensor_expr_raw_kind(env, iterable):
		Some(raw_kind):
			TensorForRawScalarElement(raw_kind)
		None:
			clone_tensor_for_element_storage(fallback)


private pure func tensor_for_element_storage_after_raw_proof(
	env: List[TensorStorageBinding],
	iterable: CoreExpr,
	element_type: CoreType,
	storage: CoreTensorForElementStorage,
) -> CoreTensorForElementStorage:
	match storage:
		TensorForRowSliceElement(row_slice):
			TensorForRowSliceElement({
				row_size = row_slice.row_size,
				result_first_dim = row_slice.result_first_dim,
				runtime_derived = row_slice.runtime_derived,
			})
		TensorForInlineStructElement(_) | TensorForRawScalarElement(_) | TensorForRuntimeReadElement(_) | TensorForBoxedElement(_):
			raw_scalar_tensor_element_storage_or(
				env,
				iterable,
				tensor_for_element_storage_for_canonical_type(element_type),
			)


---
Rebinds `variable` for the body's storage environment and hands `expr` back
when neither the right-hand side nor the body was rewritten.
---
private pure func annotate_tensor_storage_let_expr(
	env: List[TensorStorageBinding],
	expr: CoreExpr,
	variable: CoreVar,
	is_mutable: Bool,
	value_type: CoreType,
	rhs: CoreExpr,
	annotated_rhs: CoreExpr,
	body: CoreExpr,
) -> CoreExpr:
	next_env: List[TensorStorageBinding] = tensor_storage_env_after_binding(
		env,
		variable,
		is_mutable,
		annotated_rhs,
	)
	annotated_body: CoreExpr = annotate_tensor_storage_expr(next_env, body)

	if same_core_expr(annotated_rhs, rhs) and same_core_expr(annotated_body, body):
		expr
	else:
		LetExpr(variable, is_mutable, value_type, annotated_rhs, annotated_body)


private pure func annotate_tensor_storage_expr(
	env: List[TensorStorageBinding],
	expr: CoreExpr,
) -> CoreExpr:
	match expr:
		LetExpr(variable, is_mutable, value_type, rhs, body):
			annotated_rhs: CoreExpr = annotate_tensor_storage_expr(env, rhs)

			match body:
				IfExpr(guard, then_expr, else_expr, typ, loc):
					match guard:
						VarExpr(guard_var, guard_type, guard_loc):
							if (
								core_var_equal(variable, guard_var)
								and tensor_storage_guard_proven(env, annotated_rhs)
							):
								annotate_tensor_storage_expr(env, then_expr)
							else:
								annotate_tensor_storage_let_expr(
									env,
									expr,
									variable,
									is_mutable,
									value_type,
									rhs,
									annotated_rhs,
									body,
								)
						_:
							annotate_tensor_storage_let_expr(
								env,
								expr,
								variable,
								is_mutable,
								value_type,
								rhs,
								annotated_rhs,
								body,
							)
				_:
					annotate_tensor_storage_let_expr(
						env,
						expr,
						variable,
						is_mutable,
						value_type,
						rhs,
						annotated_rhs,
						body,
					)
		BorrowLetExpr(variable, value_type, rhs, body):
			annotated_rhs: CoreExpr = annotate_tensor_storage_expr(env, rhs)
			next_env: List[TensorStorageBinding] = tensor_storage_env_after_binding(
				env,
				variable,
				False,
				annotated_rhs,
			)
			annotated_body: CoreExpr = annotate_tensor_storage_expr(next_env, body)

			if same_core_expr(annotated_rhs, rhs) and same_core_expr(annotated_body, body):
				expr
			else:
				BorrowLetExpr(variable, value_type, annotated_rhs, annotated_body)
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			annotated_body: CoreExpr = annotate_tensor_storage_expr(
				tensor_storage_env_without(env, variable),
				body,
			)

			if same_core_expr(annotated_body, body):
				expr
			else:
				DropExpr(variable, value_type, release_policy, annotated_body, typ, loc)
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			annotated_body: CoreExpr = annotate_tensor_storage_expr(env, body)

			if same_core_expr(annotated_body, body):
				expr
			else:
				DupExpr(variable, value_type, retain_policy, annotated_body, typ, loc)
		SeqExpr(first, second):
			annotated_first: CoreExpr = annotate_tensor_storage_expr(env, first)
			annotated_second: CoreExpr = annotate_tensor_storage_expr(env, second)

			if same_core_expr(annotated_first, first) and same_core_expr(annotated_second, second):
				expr
			else:
				SeqExpr(annotated_first, annotated_second)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			annotated_cond: CoreExpr = annotate_tensor_storage_expr(env, cond)

			if tensor_storage_guard_proven(env, annotated_cond):
				annotate_tensor_storage_expr(env, then_expr)
			else:
				annotated_then: CoreExpr = annotate_tensor_storage_expr(env, then_expr)
				annotated_else: CoreExpr = annotate_tensor_storage_expr(env, else_expr)

				if (
					same_core_expr(annotated_cond, cond)
					and same_core_expr(annotated_then, then_expr)
					and same_core_expr(annotated_else, else_expr)
				):
					expr
				else:
					IfExpr(annotated_cond, annotated_then, annotated_else, typ, loc)
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			annotated_start: CoreExpr = annotate_tensor_storage_expr(env, start)
			annotated_end: CoreExpr = annotate_tensor_storage_expr(env, end_value)
			annotated_body: CoreExpr = annotate_tensor_storage_expr(
				tensor_storage_env_without(env, binder.variable),
				body,
			)

			if (
				same_core_expr(annotated_start, start)
				and same_core_expr(annotated_end, end_value)
				and same_core_expr(annotated_body, body)
			):
				expr
			else:
				ForRangeExpr(binder, annotated_start, annotated_end, annotated_body, typ, loc)
		ForTensorExpr(for_tensor, typ, loc):
			-- The element storage is re-derived from the loop's proof state, so
			-- this node is always rebuilt.
			annotated_iterable: CoreExpr = annotate_tensor_storage_expr(env, for_tensor.iterable)
			element_storage: CoreTensorForElementStorage = tensor_for_element_storage_after_raw_proof(
				env,
				annotated_iterable,
				for_tensor.binder.typ,
				for_tensor.element_storage,
			)

			ForTensorExpr(
				{
					binder = for_tensor.binder,
					element_storage = element_storage,
					iterable = annotated_iterable,
					iterable_release_policy = for_tensor.iterable_release_policy,
					body = annotate_tensor_storage_expr(
						tensor_storage_env_without(env, for_tensor.binder.variable),
						for_tensor.body,
					)
				},
				typ,
				loc,
			)
		TensorRawViewLetExpr(binding, body, typ, loc):
			annotated_source: CoreExpr = annotate_tensor_storage_expr(env, binding.source)
			annotated_body: CoreExpr = annotate_tensor_storage_expr(
				tensor_storage_env_without(env, binding.variable),
				body,
			)

			if (
				same_core_expr(annotated_source, binding.source)
				and same_core_expr(annotated_body, body)
			):
				expr
			else:
				TensorRawViewLetExpr(
					{ binding | source = annotated_source },
					annotated_body,
					typ,
					loc,
				)
		WhileExpr(cond, body, typ, loc):
			annotated_cond: CoreExpr = annotate_tensor_storage_expr(env, cond)
			annotated_body: CoreExpr = annotate_tensor_storage_expr(env, body)

			if same_core_expr(annotated_cond, cond) and same_core_expr(annotated_body, body):
				expr
			else:
				WhileExpr(annotated_cond, annotated_body, typ, loc)
		_:
			expr


private pure func tuple_pointer_expr_needs_retain(expr: CoreExpr) -> Bool:
	match expr:
		LiteralExpr(literal, typ, loc):
			match literal:
				StringLiteral(value):
					False
				IntLiteral(value):
					False
				WideIntLiteral(value):
					False
				FloatLiteral(value):
					False
				FloatTextLiteral(value):
					False
				FloatInfinityLiteral:
					False
				FloatNegInfinityLiteral:
					False
				FloatNanLiteral:
					False
				BoolLiteral(value):
					False
				CharLiteral(value):
					False
		StaticStringLiteralExpr(id, value, typ, loc):
			False
