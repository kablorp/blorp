-- Allocation identity for the reuse rule this pass follows: a prepared child
-- that is the same allocation as its input proves that the input node can be
-- handed back as is, so preparation allocates only along the spine to nodes it
-- actually changed. Core is immutable value data, so sharing subtrees between
-- input and output is safe. These bind straight to the runtime primitive for
-- the same bootstrap reason as the matching block in traverse.brp; delete the
-- blocks together and import `memory: same_object` instead.
foreign:
	private pure func same_core_expr(left: CoreExpr, right: CoreExpr) -> Bool = "blorp_same_object"
	private pure func same_core_exprs(
		left: List[CoreExpr],
		right: List[CoreExpr],
	) -> Bool = "blorp_same_object"
	private pure func same_core_record_field(
		left: CoreRecordFieldValue,
		right: CoreRecordFieldValue,
	) -> Bool = "blorp_same_object"


private pure func same_optional_core_expr(left: Option[CoreExpr], right: Option[CoreExpr]) -> Bool:
	match left:
		Some(left_expr):
			match right:
				Some(right_expr):
					same_core_expr(left_expr, right_expr)
				None:
					False
		None:
			right.is_none()


---
Payload helpers below answer `None` for "this value came back unchanged", so
a caller keeps its own input instead of allocating an equal copy first. This
maps a list with such a helper and answers `None` itself when no item
changed, copying the untouched prefix only once an item actually changes.
---
private pure func prepare_list_items[T](
	items: List[T],
	prepare_item: pure (T) -> Option[T],
) -> Option[List[T]]:
	var prepared: List[T] = []
	var changed: Bool = False
	var index: Int = 0

	for item in items:
		match prepare_item(item):
			Some(prepared_item):
				prepared = if changed:
					prepared.append(prepared_item)
				else:
					items
						.take(index)
						.append(prepared_item)

				changed = True
			None:
				if changed:
					prepared = prepared.append(item)
				else:
					void

		index += 1

	if changed:
		Some(prepared)
	else:
		None


---
`==` on a payload-carrying union is allocation identity, not structure, so
box kinds compare arm by arm.
---
private pure func box_kinds_equal(left: CoreBoxKind, right: CoreBoxKind) -> Bool:
	match (left, right):
		(PrimBox, PrimBox):
			True
		(PointerBox, PointerBox):
			True
		(VoidBox, VoidBox):
			True
		(FloatBox, FloatBox):
			True
		(Float32Box, Float32Box):
			True
		(Float16Box, Float16Box):
			True
		(Int128Box, Int128Box):
			True
		(UInt128Box, UInt128Box):
			True
		(StructBox(left_c_type), StructBox(right_c_type)):
			left_c_type == right_c_type
		_:
			False


private pure func same_boxed_storage_value(
	left: CoreBoxedStorageValue,
	right: CoreBoxedStorageValue,
) -> Bool:
	(
		same_core_expr(left.value, right.value)
		and box_kinds_equal(left.kind, right.kind)
		and left.needs_release == right.needs_release
		and left.transfers_ownership == right.transfers_ownership
	)


record PreparedTupleLiteral {
	elements: List[CoreTupleElement],
	release_mask: Int,
	retain_mask: Int
}


private STACK_OPTION_SOME_TAG: Int = 0

private STACK_OPTION_NONE_TAG: Int = 1

private STACK_RESULT_OK_TAG: Int = 0

private STACK_RESULT_ERR_TAG: Int = 1


---
The declaration list a preparation pass looks facts up in, plus the indexes
that accelerate the lookups whose scans dominate a compiler-sized program.
An index is built once per public preparation call and never outlives it; it
is a lookup accelerator, never a second authority on declaration order.
---
private record PrepareDecls {
	decls: List[CoreDecl],
	unions_by_name: Dict[String, CoreUnionDecl],
	-- Present only for the later construction-preparation pass. The earlier
	-- dictionary-ownership traversal has its own mapper and never calls
	-- prepare_union_construct, so it intentionally has no layout index.
	specialize_layout: Option[CoreSpecializeLayout]
}


---
First declaration of a name wins, matching the first-match scan this index
replaces. Value-record, heap-record, enum, and union namespaces stay
distinct because only union declarations enter this dictionary.
---
private pure func prepare_decls(
	decls: List[CoreDecl],
	specialize_layout: Option[CoreSpecializeLayout],
) -> PrepareDecls:
	var unions_by_name: Dict[String, CoreUnionDecl] = {}

	for decl in decls:
		match decl:
			UnionDecl(union_decl):
				if unions_by_name.contains(union_decl.name):
					void
				else:
					unions_by_name = unions_by_name.set(union_decl.name, union_decl)
			_:
				void

	{
		decls = decls,
		unions_by_name = unions_by_name,
		specialize_layout = specialize_layout
	}


private pure func find_value_record_decl(
	decls: PrepareDecls,
	name: String,
) -> Option[CoreValueRecordDecl]:
	var result: Option[CoreValueRecordDecl] = None

	for decl in decls.decls:
		match decl:
			ValueRecordDecl(record_decl):
				if record_decl.name == name:
					result = Some(record_decl)
					break
			FunctionDecl(func_info):
				void
			GlobalDecl(global):
				void
			HeapRecordDecl(record_decl):
				void
			EnumDecl(enum_decl):
				void
			UnionDecl(union_decl):
				void
			TypeAliasDecl(alias_decl):
				void
			TraitDecl(trait_decl):
				void
			ImplDecl(impl_decl):
				void

	result


private pure func find_heap_record_decl(
	decls: PrepareDecls,
	name: String,
) -> Option[CoreHeapRecordDecl]:
	var result: Option[CoreHeapRecordDecl] = None

	for decl in decls.decls:
		match decl:
			HeapRecordDecl(record_decl):
				if record_decl.name == name:
					result = Some(record_decl)
					break
			ValueRecordDecl(record_decl):
				void
			FunctionDecl(func_info):
				void
			GlobalDecl(global):
				void
			EnumDecl(enum_decl):
				void
			UnionDecl(union_decl):
				void
			TypeAliasDecl(alias_decl):
				void
			TraitDecl(trait_decl):
				void
			ImplDecl(impl_decl):
				void

	result


private pure func find_union_decl(
	unions_by_name: Dict[String, CoreUnionDecl],
	name: String,
) -> Option[CoreUnionDecl]:
	unions_by_name.get(name)


private pure func union_variant_matches_reference(
	variant: CoreUnionVariant,
	constructor_name: String,
	def_id: Option[Int],
) -> Bool:
	if not (variant.name == constructor_name or variant.c_name == constructor_name):
		False
	else:
		match (def_id, variant.def_id):
			(Some(reference_id), Some(constructor_id)):
				reference_id == constructor_id
			_:
				False


private pure func find_union_variant_by_reference(
	variants: List[CoreUnionVariant],
	constructor_name: String,
	def_id: Option[Int],
) -> Option[CoreUnionVariant]:
	var result: Option[CoreUnionVariant] = None

	for variant in variants:
		if union_variant_matches_reference(variant, constructor_name, def_id):
			result = Some(variant)
			break

	result


private pure func canonical_union_constructor_name(
	decls: PrepareDecls,
	type_name: String,
	constructor_name: String,
	def_id: Option[Int],
) -> Option[String]:
	match find_union_decl(decls.unions_by_name, type_name):
		Some(union_decl):
			match find_union_variant_by_reference(union_decl.variants, constructor_name, def_id):
				Some(variant):
					Some(variant.name)
				None:
					None
		None:
			None


private pure func variable_is_union_constructor(
	decls: PrepareDecls,
	type_name: String,
	variable: CoreVar,
) -> Bool:
	match find_union_decl(decls.unions_by_name, type_name):
		Some(union_decl):
			match find_union_variant_by_reference(
				union_decl.variants,
				variable.name,
				variable.def_id,
			):
				Some(variant):
					variant.fields.is_empty()
				None:
					False
		None:
			False


private pure func find_record_field(
	fields: List[CoreRecordFieldValue],
	name: String,
) -> Option[CoreRecordFieldValue]:
	var result: Option[CoreRecordFieldValue] = None

	for field in fields:
		if field.name == name:
			result = Some(field)

	result


private pure func order_value_record_fields(
	record_decl: CoreValueRecordDecl,
	fields: List[CoreRecordFieldValue],
) -> Option[List[CoreRecordFieldValue]]:
	var ordered: List[CoreRecordFieldValue] = []
	var found_all_fields: Bool = True

	for field_decl in record_decl.fields:
		match find_record_field(fields, field_decl.name):
			Some(field):
				ordered = ordered.append(field)
			None:
				found_all_fields = False
				break

	if found_all_fields and ordered.length() == fields.length():
		Some(ordered)
	else:
		None


private pure func order_heap_record_fields(
	record_decl: CoreHeapRecordDecl,
	fields: List[CoreRecordFieldValue],
) -> Option[List[CoreRecordFieldValue]]:
	var ordered: List[CoreRecordFieldValue] = []
	var found_all_fields: Bool = True

	for field_decl in record_decl.fields:
		match find_record_field(fields, field_decl.name):
			Some(field):
				ordered = ordered.append(field)
			None:
				found_all_fields = False
				break

	if found_all_fields and ordered.length() == fields.length():
		Some(ordered)
	else:
		None


private pure func prepare_exprs(decls: PrepareDecls, exprs: List[CoreExpr]) -> List[CoreExpr]:
	CoreTraverse.map_core_exprs(exprs, func(expr): prepare_expr(decls, expr))


private pure func prepare_tailrec_list_spread_rebind(
	decls: PrepareDecls,
	rebind: CoreTailrecListSpreadRebind,
) -> Option[CoreTailrecListSpreadRebind]:
	prepared_value: CoreExpr = prepare_expr(decls, rebind.value)

	if same_core_expr(prepared_value, rebind.value):
		None
	else:
		Some({ rebind | value = prepared_value })


private pure func prepare_tailrec_list_spread_loop(
	decls: PrepareDecls,
	loop: CoreTailrecListSpreadLoop,
) -> Option[CoreTailrecListSpreadLoop]:
	prepared_body: CoreExpr = prepare_expr(decls, loop.body)

	if same_core_expr(prepared_body, loop.body):
		None
	else:
		Some({ loop | body = prepared_body })


private pure func expr_type(expr: CoreExpr) -> CoreType:
	match expr:
		LiteralExpr(literal, typ, loc):
			typ
		StaticStringLiteralExpr(id, value, typ, loc):
			typ
		VarExpr(variable, typ, loc):
			typ
		VoidExpr(typ, loc):
			typ
		DebugBlockExpr(body, typ, loc):
			typ
		CooperativeCheckpointExpr(typ, loc):
			typ
		CallExpr(kind, callee, args, typ, loc):
			typ
		BinaryExpr(op, left, right, typ, loc):
			typ
		UnaryExpr(op, expr_value, typ, loc):
			typ
		LogicalExpr(op, left, right, typ, loc):
			typ
		AssignExpr(variable, rhs, typ, loc):
			typ
		CastExpr(expr_value, typ, loc):
			typ
		BoxExpr(box, typ, loc):
			typ
		UnboxExpr(unbox_kind, expr_value, typ, loc):
			typ
		FieldExpr(expr_value, field_name, typ, loc):
			typ
		TupleFieldExpr(expr_value, field_index, typ, loc):
			typ
		TupleExpr(items, typ, loc):
			typ
		TupleConstructExpr(tuple_construct, typ, loc):
			typ
		VectorExpr(items, typ, loc):
			typ
		LambdaExpr(lambda_params, lambda_return_type, lambda_body, lambda_is_pure, typ, loc):
			typ
		ClosureCreateExpr(closure, typ, loc):
			typ
		ListConstructExpr(construct, typ, loc):
			typ
		ListAllocExpr(alloc, typ, loc):
			typ
		ListGetExpr(get, typ, loc):
			typ
		ListHandoffExpr(handoff, typ, loc):
			typ
		ListHandoffSetOwnedExpr(set, typ, loc):
			typ
		ListHandoffSetSourceSlotExpr(slot, typ, loc):
			typ
		ListRetainExpr(retain, typ, loc):
			typ
		ListSetExpr(set, typ, loc):
			typ
		ListSwapExpr(swap, typ, loc):
			typ
		StringByteReadExpr(read, typ, loc):
			typ
		StringByteWriteExpr(write, typ, loc):
			typ
		StringByteCopyExpr(copy, typ, loc):
			typ
		StringSetLenExpr(set_len, typ, loc):
			typ
		TensorLiteralExpr(literal, typ, loc):
			typ
		TensorBoxedLiteralExpr(literal, typ, loc):
			typ
		TensorPackedLiteralExpr(literal, typ, loc):
			typ
		TensorRawFillExpr(fill, typ, loc):
			typ
		TensorRawReadExpr(read, typ, loc):
			typ
		TensorRawWriteExpr(write, typ, loc):
			typ
		TensorRawViewLetExpr(binding, body, typ, loc):
			typ
		DictExpr(entries, typ, loc):
			typ
		DictConstructExpr(construct, typ, loc):
			typ
		SetAllocExpr(alloc, typ, loc):
			typ
		RecordExpr(fields, typ, loc):
			typ
		RecordUpdateExpr(base, fields, typ, loc):
			typ
		RecordReuseExpr(source, fields, typ, loc):
			typ
		RecordCowUpdateExpr(source, fields, typ, loc):
			typ
		RecordConstructExpr(type_name, fields, typ, loc):
			typ
		UnionConstructExpr(construct, typ, loc):
			typ
		UnionReuseConstructExpr(construct, typ, loc):
			typ
		PreClosureDetachExpr(detached, typ, loc):
			typ
		DetachExpr(detached, typ, loc):
			typ
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			typ
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			typ
		LetExpr(variable, is_mutable, value_type, rhs, body):
			expr_type(body)
		BorrowLetExpr(variable, value_type, rhs, body):
			expr_type(body)
		SeqExpr(first, second):
			expr_type(second)
		WhileExpr(cond, body, typ, loc):
			typ
		BreakExpr(typ, loc):
			typ
		ContinueExpr(typ, loc):
			typ
		ResourceScopeExpr(scope, typ, loc):
			typ
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			typ
		TailrecLoopExpr(params, return_type, body, loc):
			return_type
		TailrecRecurExpr(args, typ, loc):
			typ
		TailrecListSpreadLoopExpr(loop, loc):
			loop.return_type
		TailrecListSpreadRecurExpr(rebinds, cursor_advance, typ, loc):
			typ
		ForRangeExpr(binder, start, end, body, typ, loc):
			typ
		ForChannelExpr(loop, typ, loc):
			typ
		ForListExpr(loop, typ, loc):
			typ
		ForStringExpr(loop, typ, loc):
			typ
		ForDictExpr(loop, typ, loc):
			typ
		ForSetExpr(loop, typ, loc):
			typ
		ForResourceSourceExpr(loop, typ, loc):
			typ
		ForStreamExpr(loop, typ, loc):
			typ
		ForTensorExpr(loop, typ, loc):
			typ
		PreClosureConcurrentlyLoopExpr(loop, typ, loc):
			typ
		DetachExpr(detached, typ, loc):
			typ
		ConcurrentlyLoopExpr(loop, typ, loc):
			typ
		PreClosureConcurrentExpr(block, typ, loc):
			typ
		ConcurrentExpr(block, typ, loc):
			typ
		SelectExpr(select_expr, typ, loc):
			typ
		RangeExpr(start, end, typ, loc):
			typ
		AccessorLiteralMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			typ
		LengthMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			typ
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			typ
		RawMatchExpr(scrutinee, cases, typ, loc):
			typ
		SemanticMatchExpr(scrutinee, tree, typ, loc):
			typ
		ConstructorMatchExpr(scrutinee, scrutinee_release_policy, cases, fallback, typ, loc):
			typ
		IfExpr(cond, then_expr, else_expr, typ, loc):
			typ


private pure func primitive_box_type(typ: CoreType) -> Bool:
	match typ:
		NamedType(name, args):
			if args.length() != 0:
				False
			else if name == "Int":
				True
			else if name == "Int8":
				True
			else if name == "Int16":
				True
			else if name == "Int32":
				True
			else if name == "Int64":
				True
			else if name == "UInt8":
				True
			else if name == "UInt16":
				True
			else if name == "UInt32":
				True
			else if name == "UInt64":
				True
			else if name == "Bool":
				True
			else if name == "Char":
				True
			else:
				False
		TypeParameterType(_) | SelfType:
			False
		StackResultType(ok_type, err_type):
			False
		BoxedResultType(ok_type, err_type):
			False
		FunctionType(_, _, _):
			False
		EnumType(name):
			True
		RangeType:
			True
		VoidType:
			False
		ValueRecordType(name):
			False
		HeapRecordType(name):
			False
		UnionType(name):
			False
		TensorType(info):
			False
		TupleType(items):
			False


private pure func boxed_kind_for_type(typ: CoreType) -> CoreBoxKind:
	match typ:
		VoidType:
			VoidBox
		NamedType(name, args):
			if name == "Option":
				match args:
					[payload]:
						match stack_option_c_type(payload):
							Some(option_type):
								StructBox(option_type)
							None:
								PointerBox
					_:
						PointerBox
			else if name == "Result" and args.length() == 2:
				StructBox("blorp_StackResult")
			else if name == "Float" and args.length() == 0:
				FloatBox
			else if name == "Float32" and args.length() == 0:
				Float32Box
			else if name == "Float16" and args.length() == 0:
				Float16Box
			else if primitive_box_type(typ):
				PrimBox
			else:
				PointerBox
		ValueRecordType(name):
			StructBox(name)
		StackResultType(ok_type, err_type):
			StructBox("blorp_StackResult")
		_:
			if primitive_box_type(typ):
				PrimBox
			else:
				PointerBox


private pure func boxed_kind_for_expr(expr: CoreExpr) -> CoreBoxKind:
	match expr:
		UnionConstructExpr(construct, typ, loc):
			match construct.representation:
				StackOptionRepresentation(representation):
					StructBox(representation.option_type)
				StackResultRepresentation(representation):
					StructBox(representation.result_type)
				BoxedOptionRepresentation:
					boxed_kind_for_type(typ)
				NullableOptionRepresentation:
					boxed_kind_for_type(typ)
				GenericUnionRepresentation:
					boxed_kind_for_type(typ)
		UnionReuseConstructExpr(construct, typ, loc):
			boxed_kind_for_type(typ)
		_:
			boxed_kind_for_type(expr_type(expr))


private pure func pointer_box_storage_needs_release_type(typ: CoreType) -> Bool:
	match typ:
		NamedType(name, args):
			if is_managed_pointer_tuple_slot_type(typ):
				True
			else if name == "Channel" and args.length() == 1:
				True
			else if name == "ResourceSource" and args.length() == 1:
				True
			else if name == "stream::ResourceSource" and args.length() == 1:
				True
			else if name == "stream__ResourceSource" and args.length() == 1:
				True
			else if name == "Stream" and args.length() == 1:
				True
			else if name == "stream::Stream" and args.length() == 1:
				True
			else if name == "stream__Stream" and args.length() == 1:
				True
			else if name == "FallibleStream" and args.length() == 2:
				True
			else if name == "stream::FallibleStream" and args.length() == 2:
				True
			else if name == "stream__FallibleStream" and args.length() == 2:
				True
			else if name == "TcpListener" and args.length() == 0:
				True
			else if name == "TcpStream" and args.length() == 0:
				True
			else if name == "TlsSession" and args.length() == 0:
				True
			else if name == "WebSocketSession" and args.length() == 0:
				True
			else:
				name == "UdpSocket" and args.length() == 0
		TypeParameterType(_) | SelfType:
			False
		StackResultType(ok_type, err_type):
			True
		BoxedResultType(ok_type, err_type):
			True
		FunctionType(_, _, _):
			True
		HeapRecordType(name):
			True
		UnionType(name):
			True
		TupleType(items):
			True
		TensorType(info):
			True
		VoidType:
			False
		EnumType(name):
			False
		ValueRecordType(name):
			False
		RangeType:
			False


private pure func boxed_storage_type_needs_release(typ: CoreType, kind: CoreBoxKind) -> Bool:
	match kind:
		StructBox(c_type):
			True
		Int128Box:
			True
		UInt128Box:
			True
		PointerBox:
			pointer_box_storage_needs_release_type(typ)
		FloatBox:
			False
		Float32Box:
			False
		Float16Box:
			False
		PrimBox:
			False
		VoidBox:
			False


private pure func boxed_storage_value_needs_release(expr: CoreExpr, kind: CoreBoxKind) -> Bool:
	match expr:
		BoxExpr(box, _, _):
			boxed_storage_type_needs_release(box.source_type, box.kind)
		_:
			boxed_storage_type_needs_release(expr_type(expr), kind)


private pure func boxed_storage_value_for_expr(expr: CoreExpr) -> CoreBoxedStorageValue:
	kind: CoreBoxKind = boxed_kind_for_expr(expr)

	{
		kind = kind,
		value = expr,
		needs_release = boxed_storage_value_needs_release(expr, kind),
		transfers_ownership = False
	}


private pure func boxed_storage_values_for_exprs(
	exprs: List[CoreExpr],
) -> List[CoreBoxedStorageValue]:
	exprs.map(boxed_storage_value_for_expr)


private pure func boxed_storage_values_for_union_payload(
	layout: CoreSpecializeLayout,
	payload_storage: CoreUnionPayloadStorage,
	exprs: List[CoreExpr],
) -> List[CoreBoxedStorageValue]:
	match payload_storage:
		TypedUnionPayloadStorage:
			boxed_storage_values_for_exprs(exprs)
		ErasedUnionPayloadStorage:
			exprs.map(func(expr): boxed_storage_value(layout, expr, False))


private pure func prepare_tuple_element(
	decls: PrepareDecls,
	element: CoreTupleElement,
) -> Option[CoreTupleElement]:
	match element:
		TuplePrimElement(value):
			prepared: CoreExpr = prepare_expr(decls, value)

			if same_core_expr(prepared, value):
				None
			else:
				Some(TuplePrimElement(prepared))
		TuplePointerElement(value):
			prepared: CoreExpr = prepare_expr(decls, value)

			if same_core_expr(prepared, value):
				None
			else:
				Some(TuplePointerElement(prepared))
		TupleStructElement(value, c_type):
			prepared: CoreExpr = prepare_expr(decls, value)

			if same_core_expr(prepared, value):
				None
			else:
				Some(TupleStructElement(prepared, c_type))
		TupleStackResultElement(value):
			prepared: CoreExpr = prepare_expr(decls, value)

			if same_core_expr(prepared, value):
				None
			else:
				Some(TupleStackResultElement(prepared))
		TupleVoidElement:
			None
		TupleFloatElement(value):
			prepared: CoreExpr = prepare_expr(decls, value)

			if same_core_expr(prepared, value):
				None
			else:
				Some(TupleFloatElement(prepared))
		TupleFloat32Element(value):
			prepared: CoreExpr = prepare_expr(decls, value)

			if same_core_expr(prepared, value):
				None
			else:
				Some(TupleFloat32Element(prepared))
		TupleFloat16Element(value):
			prepared: CoreExpr = prepare_expr(decls, value)

			if same_core_expr(prepared, value):
				None
			else:
				Some(TupleFloat16Element(prepared))


---
Recomputes the box kind and release flag from the prepared value exactly as
before; the input is kept only when those come out equal as well.
---
private pure func prepare_boxed_storage_value(
	decls: PrepareDecls,
	value: CoreBoxedStorageValue,
) -> Option[CoreBoxedStorageValue]:
	prepared_value: CoreExpr = prepare_expr(decls, value.value)
	kind: CoreBoxKind = boxed_kind_for_expr(prepared_value)

	needs_release: Bool = if is_stack_result_type(expr_type(prepared_value)):
		True
	else:
		value.needs_release

	if (
		same_core_expr(prepared_value, value.value)
		and box_kinds_equal(kind, value.kind)
		and needs_release == value.needs_release
	):
		None
	else:
		Some({
			kind = kind,
			value = prepared_value,
			needs_release = needs_release,
			transfers_ownership = value.transfers_ownership,
		})


private pure func prepare_box_op(decls: PrepareDecls, box: CoreBoxOp) -> Option[CoreBoxOp]:
	prepared_value: CoreExpr = prepare_expr(decls, box.value)

	if same_core_expr(prepared_value, box.value):
		None
	else:
		Some({ box | value = prepared_value })


private pure func prepare_boxed_storage_values(
	decls: PrepareDecls,
	values: List[CoreBoxedStorageValue],
) -> Option[List[CoreBoxedStorageValue]]:
	prepare_list_items(values, func(value): prepare_boxed_storage_value(decls, value))


private pure func is_stack_result_value_type(typ: CoreType) -> Bool:
	match typ:
		NamedType(name, args):
			name == "Result" and args.length() == 2
		StackResultType(_, _):
			True
		_:
			False


private pure func prepare_list_storage_value(
	layout: CoreListStorageLayout,
	value: CoreBoxedStorageValue,
) -> CoreBoxedStorageValue:
	match layout:
		InlineStructListStorage(c_type):
			{ value |
				kind = StructBox(c_type),
				needs_release = False
			}
		InlineListStorage(_):
			kind: CoreBoxKind = match value.kind:
				PointerBox:
					PrimBox
				_:
					value.kind

			{ value |
				kind = kind,
				needs_release = False
			}
		PointerListStorage:
			if is_stack_result_value_type(expr_type(value.value)):
				-- Pointer-backed lists own a heap box. The box is created by
				-- emission, so transfer that fresh owner into the list.
				{ value |
					kind = StructBox("blorp_StackResult"),
					needs_release = True,
					transfers_ownership = True
				}
			else:
				value


private pure func prepare_dict_entry(
	decls: PrepareDecls,
	entry: CoreDictEntry,
) -> Option[CoreDictEntry]:
	prepared_key: Option[CoreBoxedStorageValue] = prepare_boxed_storage_value(decls, entry.key)
	prepared_value: Option[CoreBoxedStorageValue] = prepare_boxed_storage_value(decls, entry.value)

	if prepared_key.is_none() and prepared_value.is_none():
		None
	else:
		Some({
			key = prepared_key.get_or(entry.key),
			value = prepared_value.get_or(entry.value),
		})


private pure func prepare_dict_construct(
	decls: PrepareDecls,
	construct: CoreDictConstruct,
) -> Option[CoreDictConstruct]:
	match prepare_list_items(construct.entries, func(entry): prepare_dict_entry(decls, entry)):
		Some(entries):
			Some({ construct | entries = entries })
		None:
			None


---
Element preparation and storage-layout normalization used to run as two
full list rebuilds. Folding them per element keeps an element that comes
out field-for-field equal to its input instead of replacing it with a copy.
---
private pure func prepare_list_construct_element(
	decls: PrepareDecls,
	layout: CoreListStorageLayout,
	value: CoreBoxedStorageValue,
) -> Option[CoreBoxedStorageValue]:
	prepared: CoreBoxedStorageValue = prepare_boxed_storage_value(decls, value).get_or(value)
	stored: CoreBoxedStorageValue = prepare_list_storage_value(layout, prepared)

	if same_boxed_storage_value(stored, value):
		None
	else:
		Some(stored)


private pure func prepare_list_construct(
	decls: PrepareDecls,
	construct: CoreListConstruct,
) -> Option[CoreListConstruct]:
	match prepare_list_items(
		construct.elements,
		func(value): prepare_list_construct_element(decls, construct.layout, value),
	):
		Some(elements):
			Some({ construct | elements = elements })
		None:
			None


