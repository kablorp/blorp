private pure func prepared_tuple_literal(
	items: List[CoreExpr],
	item_types: List[CoreType],
) -> Option[PreparedTupleLiteral]:
	var elements: List[CoreTupleElement] = []
	var release_mask: Int = 0
	var retain_mask: Int = 0
	var failed: Bool = False
	var index: Int = 0

	for item in items:
		if not failed:
			match item_types.get(index):
				Some(item_type):
					match item_type:
						VoidType:
							elements = elements.append(TupleVoidElement)
						TypeParameterType(_) | SelfType:
							failed = True
							break
						NamedType(name, args):
							if is_primitive_tuple_slot_type(item_type):
								elements = elements.append(TuplePrimElement(item))
							else:
								match stack_option_tuple_slot_c_type(item_type):
									Some(c_type):
										elements = elements.append(TupleStructElement(item, c_type))
										release_mask += int_power_of_two(index)
									None:
										match float_tuple_element(item, item_type):
											Some(tuple_element):
												elements = elements.append(tuple_element)
											None:
												if is_pointer_tuple_slot_type(item_type):
													elements = elements.append(
														TuplePointerElement(item),
													)

													if is_managed_pointer_tuple_slot_type(
														item_type,
													):
														release_mask += int_power_of_two(index)

														if tuple_pointer_expr_needs_retain(item):
															retain_mask += int_power_of_two(index)
												else:
													failed = True
													break
						TupleType(items):
							if is_pointer_tuple_slot_type(item_type):
								elements = elements.append(TuplePointerElement(item))

								if is_managed_pointer_tuple_slot_type(item_type):
									release_mask += int_power_of_two(index)

									if tuple_pointer_expr_needs_retain(item):
										retain_mask += int_power_of_two(index)
							else:
								failed = True
								break
						BoxedResultType(ok_type, err_type):
							elements = elements.append(TuplePointerElement(item))
							release_mask += int_power_of_two(index)

							if tuple_pointer_expr_needs_retain(item):
								retain_mask += int_power_of_two(index)
						FunctionType(_, _, _):
							elements = elements.append(TuplePointerElement(item))
							release_mask += int_power_of_two(index)

							if tuple_pointer_expr_needs_retain(item):
								retain_mask += int_power_of_two(index)
						TensorType(info):
							elements = elements.append(TuplePointerElement(item))
							release_mask += int_power_of_two(index)

							if tuple_pointer_expr_needs_retain(item):
								retain_mask += int_power_of_two(index)
						StackResultType(ok_type, err_type):
							-- Perceus has already assigned this slot an owner. The
							-- backend transfers that owner into the stack-Result box.
							elements = elements.append(TupleStackResultElement(item))
							release_mask += int_power_of_two(index)
						HeapRecordType(name):
							elements = elements.append(TuplePointerElement(item))
							release_mask += int_power_of_two(index)

							if tuple_pointer_expr_needs_retain(item):
								retain_mask += int_power_of_two(index)
						UnionType(name):
							elements = elements.append(TuplePointerElement(item))
							release_mask += int_power_of_two(index)

							if tuple_pointer_expr_needs_retain(item):
								retain_mask += int_power_of_two(index)
						EnumType(name):
							elements = elements.append(TuplePrimElement(item))
						ValueRecordType(name):
							elements = elements.append(TupleStructElement(item, name))
							release_mask += int_power_of_two(index)
						RangeType:
							elements = elements.append(TuplePrimElement(item))
				None:
					failed = True
					break

		index += 1

	if failed or index != item_types.length():
		None
	else:
		Some({
			elements = elements,
			release_mask = release_mask,
			retain_mask = retain_mask,
		})


private pure func prepare_tuple_expr(
	decls: PrepareDecls,
	expr: CoreExpr,
	items: List[CoreExpr],
	typ: CoreType,
	loc: CoreSourceLoc,
) -> CoreExpr:
	prepared_items: List[CoreExpr] = prepare_exprs(decls, items)

	prepared_literal: Option[PreparedTupleLiteral] = match typ:
		TupleType(item_types):
			prepared_tuple_literal(prepared_items, item_types)
		_:
			None

	match prepared_literal:
		Some(prepared):
			TupleConstructExpr(
				{
					elements = prepared.elements,
					release_mask = prepared.release_mask,
					retain_mask = prepared.retain_mask
				},
				typ,
				loc,
			)
		None:
			if same_core_exprs(prepared_items, items):
				expr
			else:
				TupleExpr(prepared_items, typ, loc)


private pure func vector_element_type(typ: CoreType) -> Option[CoreType]:
	match typ:
		TensorType(info):
			Some(info.element_type)
		NamedType(name, args):
			if name == "Vector" or name == "Tensor":
				match args:
					[elem_type]:
						Some(elem_type)
					[elem_type, ...dims]:
						Some(elem_type)
					[]:
						None
			else:
				None
		_:
			None


private pure func static_tensor_dims(dims: List[CoreTensorDim]) -> Option[List[Int]]:
	var values: List[Int] = []
	var all_static: Bool = True

	for dim in dims:
		match dim:
			TensorStaticDim(value):
				values = values.append(value)
			TensorRuntimeDim(_) | TensorVariadicDim(_) | TensorDimOperation(_, _, _):
				all_static = False
				break

	if all_static:
		Some(values)
	else:
		None


private pure func tensor_static_shape_from_dims(dims: List[Int]) -> CoreTensorLiteralShape:
	match dims:
		[length]:
			TensorVectorLength(length)
		_:
			TensorStaticShape(dims)


private pure func vector_literal_shape(
	typ: CoreType,
	fallback_shape: CoreTensorLiteralShape,
) -> CoreTensorLiteralShape:
	match typ:
		TensorType(info):
			match static_tensor_dims(info.dims):
				Some(dims):
					tensor_static_shape_from_dims(dims)
				None:
					fallback_shape
		_:
			fallback_shape


private pure func raw_scalar_kind_for_tensor_element_type(
	elem_type: CoreType,
) -> Option[CoreTensorRawScalarKind]:
	match elem_type:
		NamedType(name, args):
			if name == "Float" and args.length() == 0:
				Some(TensorFloat64Elements)
			else if name == "Float32" and args.length() == 0:
				Some(TensorFloat32Elements)
			else if name == "Int" and args.length() == 0:
				Some(TensorInt64Elements)
			else:
				None
		_:
			None


private pure func boxed_values_need_release(values: List[CoreBoxedStorageValue]) -> Bool:
	var result: Bool = False

	for value in values:
		if value.needs_release:
			result = True
			break

	result


private record TensorLiteralRow {
	elements: List[CoreExpr],
	length: Int
}


private record FlattenedVectorItems {
	elements: List[CoreExpr],
	shape: CoreTensorLiteralShape
}


private pure func int_product_from_first(first: Int, rest: List[Int]) -> Int:
	var total: Int = first

	for value in rest:
		total *= value

	total


private pure func tensor_literal_shape_total_length(shape: CoreTensorLiteralShape) -> Option[Int]:
	match shape:
		TensorVectorLength(length):
			Some(length)
		TensorStaticShape(dims):
			match dims:
				[]:
					Some(0)
				[first, ...rest]:
					Some(int_product_from_first(first, rest))


private pure func tensor_literal_row(expr: CoreExpr) -> Option[TensorLiteralRow]:
	match expr:
		TensorLiteralExpr(literal, typ, loc):
			length ?= tensor_literal_shape_total_length(literal.shape)

			match literal.payload:
				TensorRawLiteralPayload(raw):
					Some({
						elements = raw.elements,
						length = length,
					})
				TensorInlineStructLiteralPayload(inline_struct):
					Some({
						elements = inline_struct.elements,
						length = length,
					})
		TensorBoxedLiteralExpr(literal, typ, loc):
			length ?= tensor_literal_shape_total_length(literal.shape)

			Some({
				elements = literal.elements.map(func(value): value.value),
				length = length,
			})
		TensorPackedLiteralExpr(literal, typ, loc):
			length ?= tensor_literal_shape_total_length(literal.shape)

			Some({
				elements = literal.elements,
				length = length,
			})
		_:
			None


private pure func append_exprs(target: List[CoreExpr], values: List[CoreExpr]) -> List[CoreExpr]:
	var result: List[CoreExpr] = target

	for value in values:
		result = result.append(value)

	result


private pure func flatten_vector_literal_items(items: List[CoreExpr]) -> FlattenedVectorItems:
	var flattened: List[CoreExpr] = []
	var expected_row_length: Option[Int] = None
	var is_ranked: Bool = items.length() > 0

	for item in items:
		if is_ranked:
			match tensor_literal_row(item):
				Some(row):
					match expected_row_length:
						Some(length):
							if length == row.length:
								flattened = append_exprs(flattened, row.elements)
							else:
								is_ranked = False
						None:
							expected_row_length = Some(row.length)
							flattened = append_exprs(flattened, row.elements)
				None:
					is_ranked = False

	if is_ranked:
		match expected_row_length:
			Some(row_length):
				{
					elements = flattened,
					shape = TensorStaticShape([items.length(), row_length])
				}
			None:
				{
					elements = items,
					shape = TensorVectorLength(items.length())
				}
	else:
		{
			elements = items,
			shape = TensorVectorLength(items.length())
		}


private pure func prepare_vector_expr(
	decls: PrepareDecls,
	expr: CoreExpr,
	items: List[CoreExpr],
	typ: CoreType,
	loc: CoreSourceLoc,
) -> CoreExpr:
	prepared_items: List[CoreExpr] = prepare_exprs(decls, items)
	flattened_items: FlattenedVectorItems = flatten_vector_literal_items(prepared_items)
	literal_shape: CoreTensorLiteralShape = vector_literal_shape(typ, flattened_items.shape)

	match vector_element_type(typ):
		Some(elem_type):
			match raw_scalar_kind_for_tensor_element_type(elem_type):
				Some(raw_kind):
					TensorLiteralExpr(
						{
							shape = literal_shape,
							payload = TensorRawLiteralPayload({
								raw_kind = raw_kind,
								elements = flattened_items.elements,
							})
						},
						typ,
						loc,
					)
				None:
					match elem_type:
						NamedType(name, args):
							if name == "Bool" and args.length() == 0:
								TensorPackedLiteralExpr(
									{
										shape = literal_shape,
										elem_size = 1,
										elements = flattened_items.elements
									},
									typ,
									loc,
								)
							else:
								boxed_values: List[CoreBoxedStorageValue] = boxed_storage_values_for_exprs(
									flattened_items.elements,
								)
								TensorBoxedLiteralExpr(
									{
										shape = literal_shape,
										elements = boxed_values,
										elem_needs_release = boxed_values_need_release(boxed_values)
									},
									typ,
									loc,
								)
						ValueRecordType(name):
							TensorLiteralExpr(
								{
									shape = literal_shape,
									payload = TensorInlineStructLiteralPayload({
										struct_c_type = name,
										elements = flattened_items.elements,
									})
								},
								typ,
								loc,
							)
						_:
							boxed_values: List[CoreBoxedStorageValue] = boxed_storage_values_for_exprs(
								flattened_items.elements,
							)
							TensorBoxedLiteralExpr(
								{
									shape = literal_shape,
									elements = boxed_values,
									elem_needs_release = boxed_values_need_release(boxed_values)
								},
								typ,
								loc,
							)
		None:
			if same_core_exprs(prepared_items, items):
				expr
			else:
				VectorExpr(prepared_items, typ, loc)


private record DictKeyValueTypes {
	key_type: CoreType,
	value_type: CoreType
}


private pure func dict_key_value_types(typ: CoreType) -> Option[DictKeyValueTypes]:
	match typ:
		NamedType(name, args):
			if name == "Dict":
				match args:
					[key_type, value_type]:
						Some({
							key_type = key_type,
							value_type = value_type,
						})
					_:
						None
			else:
				None
		_:
			None


private pure func enum_decl_name_matches(decl: CoreDecl, name: String) -> Bool:
	match decl:
		EnumDecl(enum_decl):
			enum_decl.name == name
		_:
			False


private pure func has_enum_decl(decls: PrepareDecls, name: String) -> Bool:
	var result: Bool = False

	for decl in decls.decls:
		if enum_decl_name_matches(decl, name):
			result = True
			break

	result


private pure func hash_container_constructor_for_key_type(
	decls: PrepareDecls,
	key_type: CoreType,
) -> CoreHashContainerConstructor:
	match key_type:
		NamedType(name, args):
			if name == "String" and args.length() == 0:
				StringHashContainerConstructor
			else if (
				(name == "Float" or name == "Float32" or name == "Float16")
				and args.length() == 0
			):
				FloatHashContainerConstructor
			else if has_enum_decl(decls, name) or generic_hash_container_type_name(name):
				GenericHashContainerConstructor
			else:
				CustomHashContainerConstructor(
					"Hashable_hash_" + name,
					"Equatable_equals_" + name,
					pointer_box_storage_needs_release_type(key_type),
				)
		EnumType(name):
			GenericHashContainerConstructor
		ValueRecordType(name):
			CustomHashContainerConstructor(
				"Hashable_hash_" + name,
				"Equatable_equals_" + name,
				False,
			)
		_:
			GenericHashContainerConstructor


private pure func box_dict_literal_entry(entry: CoreDictLiteralEntry) -> CoreDictEntry:
	{
		key = boxed_storage_value_for_expr(entry.key),
		value = boxed_storage_value_for_expr(entry.value)
	}


private pure func dict_literal_construct_expr(
	decls: PrepareDecls,
	entries: List[CoreDictLiteralEntry],
	types: DictKeyValueTypes,
	typ: CoreType,
	loc: CoreSourceLoc,
) -> CoreExpr:
	value_kind: CoreBoxKind = boxed_kind_for_type(types.value_type)
	DictConstructExpr(
		{
			constructor = hash_container_constructor_for_key_type(decls, types.key_type),
			entries = entries.map(box_dict_literal_entry),
			value_needs_release = boxed_storage_type_needs_release(types.value_type, value_kind)
		},
		typ,
		loc,
	)


---
Lowers the dict literal `expr` whose entries were already prepared.
`prepared_entries` is `None` when every entry came back unchanged, so a
literal whose type cannot be lowered yet is handed back as `expr` itself.
---
private pure func lower_dict_literal_expr(
	decls: PrepareDecls,
	expr: CoreExpr,
	entries: List[CoreDictLiteralEntry],
	prepared_entries: Option[List[CoreDictLiteralEntry]],
	typ: CoreType,
	loc: CoreSourceLoc,
) -> CoreExpr:
	match dict_key_value_types(typ):
		Some(types):
			dict_literal_construct_expr(
				decls,
				prepared_entries.get_or(entries),
				types,
				typ,
				loc,
			)
		None:
			match prepared_entries:
				Some(changed_entries):
					DictExpr(changed_entries, typ, loc)
				None:
					expr


private pure func prepare_dict_literal_entry(
	decls: PrepareDecls,
	entry: CoreDictLiteralEntry,
) -> Option[CoreDictLiteralEntry]:
	prepared_key: CoreExpr = prepare_expr(decls, entry.key)
	prepared_value: CoreExpr = prepare_expr(decls, entry.value)

	if same_core_expr(prepared_key, entry.key) and same_core_expr(prepared_value, entry.value):
		None
	else:
		Some({
			key = prepared_key,
			value = prepared_value,
		})


private pure func prepare_dict_expr(
	decls: PrepareDecls,
	expr: CoreExpr,
	entries: List[CoreDictLiteralEntry],
	typ: CoreType,
	loc: CoreSourceLoc,
) -> CoreExpr:
	lower_dict_literal_expr(
		decls,
		expr,
		entries,
		prepare_list_items(entries, func(entry): prepare_dict_literal_entry(decls, entry)),
		typ,
		loc,
	)


private pure func prepare_record_field(
	decls: PrepareDecls,
	field: CoreRecordFieldValue,
) -> Option[CoreRecordFieldValue]:
	prepared_value: CoreExpr = prepare_expr(decls, field.value)

	if same_core_expr(prepared_value, field.value):
		None
	else:
		Some({ field | value = prepared_value })


private pure func prepare_record_fields(
	decls: PrepareDecls,
	fields: List[CoreRecordFieldValue],
) -> Option[List[CoreRecordFieldValue]]:
	prepare_list_items(fields, func(field): prepare_record_field(decls, field))


private pure func prepare_record_cow_field(
	decls: PrepareDecls,
	field: CoreRecordCowField,
) -> Option[CoreRecordCowField]:
	match field.replacement:
		Some(replacement):
			prepared_replacement: CoreExpr = prepare_expr(decls, replacement)

			if same_core_expr(prepared_replacement, replacement):
				None
			else:
				Some({ field | replacement = Some(prepared_replacement) })
		None:
			None


---
The declaration-ordered fields of a record literal whose type names a
declared value or heap record, paired with that record's name. `None` when
the type is not such a record or the literal does not cover its fields.
---
private pure func declaration_ordered_record_fields(
	decls: PrepareDecls,
	typ: CoreType,
	fields: List[CoreRecordFieldValue],
) -> Option[(String, List[CoreRecordFieldValue])]:
	match typ:
		ValueRecordType(name):
			match find_value_record_decl(decls, name):
				Some(record_decl):
					match order_value_record_fields(record_decl, fields):
						Some(ordered_fields):
							Some((name, ordered_fields))
						None:
							None
				None:
					None
		HeapRecordType(name):
			match find_heap_record_decl(decls, name):
				Some(record_decl):
					match order_heap_record_fields(record_decl, fields):
						Some(ordered_fields):
							Some((name, ordered_fields))
						None:
							None
				None:
					None
		_:
			None


---
True when `ordered` lists exactly the allocations of `fields` in the same
order. Ordering always builds a fresh list, so this is what lets a construct
whose fields already follow declaration order keep its own field list.
---
private pure func same_record_field_order(
	ordered: List[CoreRecordFieldValue],
	fields: List[CoreRecordFieldValue],
) -> Bool:
	var same: Bool = ordered.length() == fields.length()
	var index: Int = 0

	for field in fields:
		if not same:
			break

		match ordered.get(index):
			Some(ordered_field):
				if not same_core_record_field(ordered_field, field):
					same = False
			None:
				same = False

		index += 1

	same


private pure func prepare_record_expr(
	decls: PrepareDecls,
	expr: CoreExpr,
	fields: List[CoreRecordFieldValue],
	typ: CoreType,
	loc: CoreSourceLoc,
) -> CoreExpr:
	prepared_fields: Option[List[CoreRecordFieldValue]] = prepare_record_fields(decls, fields)

	match declaration_ordered_record_fields(
		decls,
		typ,
		prepared_fields.get_or(fields),
	):
		Some((name, ordered_fields)):
			RecordConstructExpr(name, ordered_fields, typ, loc)
		None:
			match prepared_fields:
				Some(changed_fields):
					RecordExpr(changed_fields, typ, loc)
				None:
					expr


private pure func prepare_record_construct_expr(
	decls: PrepareDecls,
	expr: CoreExpr,
	type_name: String,
	fields: List[CoreRecordFieldValue],
	typ: CoreType,
	loc: CoreSourceLoc,
) -> CoreExpr:
	prepared_fields: Option[List[CoreRecordFieldValue]] = prepare_record_fields(decls, fields)

	match declaration_ordered_record_fields(
		decls,
		typ,
		prepared_fields.get_or(fields),
	):
		Some((_, ordered_fields)):
			if prepared_fields.is_none() and same_record_field_order(ordered_fields, fields):
				expr
			else:
				RecordConstructExpr(type_name, ordered_fields, typ, loc)
		None:
			match prepared_fields:
				Some(changed_fields):
					RecordConstructExpr(type_name, changed_fields, typ, loc)
				None:
					expr


private pure func stack_option_c_type(payload: CoreType) -> Option[String]:
	match payload:
		VoidType:
			Some("blorp_StackOption_Void")
		NamedType(name, args):
			match args:
				[]:
					if name == "Int":
						Some("blorp_StackOption_Int")
					else if name == "Int8":
						Some("blorp_StackOption_Int8")
					else if name == "Int16":
						Some("blorp_StackOption_Int16")
					else if name == "Int32":
						Some("blorp_StackOption_Int32")
					else if name == "Int64":
						Some("blorp_StackOption_Int64")
					else if name == "UInt8":
						Some("blorp_StackOption_UInt8")
					else if name == "UInt16":
						Some("blorp_StackOption_UInt16")
					else if name == "UInt32":
						Some("blorp_StackOption_UInt32")
					else if name == "UInt64":
						Some("blorp_StackOption_UInt64")
					else if name == "Float":
						Some("blorp_StackOption_Float")
					else if name == "Float32":
						Some("blorp_StackOption_Float32")
					else if name == "Float16":
						Some("blorp_StackOption_Float16")
					else if name == "Bool":
						Some("blorp_StackOption_Bool")
					else if name == "Char":
						Some("blorp_StackOption_Char")
					else if name == "Int128":
						Some("blorp_StackOption_Int128")
					else if name == "UInt128":
						Some("blorp_StackOption_UInt128")
					else:
						None
				[first, ...rest]:
					None
		TypeParameterType(_) | SelfType:
			None
		EnumType(name):
			Some("blorp_StackOption_" + name)
		ValueRecordType(name):
			if name == "Range":
				Some("blorp_StackOption_RangeValue")
			else:
				Some("blorp_StackOption_" + name)
		HeapRecordType(name):
			None
		UnionType(name):
			None
		StackResultType(ok_type, err_type):
			None
		FunctionType(_, _, _):
			None
		BoxedResultType(ok_type, err_type):
			None
		RangeType:
			Some("blorp_StackOption_Range")
		TensorType(info):
			None
		TupleType(items):
			None


private pure func stack_option_none_value(payload: CoreType) -> String:
	match payload:
		NamedType(name, args):
			match args:
				[]:
					if name == "Int":
						"0L"
					else:
						"0"
				[first, ...rest]:
					"0"
		TypeParameterType(_) | SelfType:
			"0"
		VoidType:
			"0"
		EnumType(name):
			"0"
		ValueRecordType(name):
			"{0}"
		HeapRecordType(name):
			"0"
		UnionType(name):
			"0"
		StackResultType(ok_type, err_type):
			"{0}"
		BoxedResultType(ok_type, err_type):
			"0"
		FunctionType(_, _, _):
			"0"
		RangeType:
			"0"
		TensorType(info):
			"0"
		TupleType(items):
			"0"


private pure func stack_option_representation(
	payload: CoreType,
	tag: Int,
) -> Option[CoreStackOptionRepresentation]:
	match stack_option_c_type(payload):
		Some(option_type):
			Some({
				option_type = option_type,
				tag = tag,
				none_value = stack_option_none_value(payload),
			})
		None:
			None


private pure func constructor_c_name(name: String, def_id: Option[Int]) -> String:
	match def_id:
		Some(id):
			"__def_" + id.to_string() + "_" + name
		None:
			name


private pure func stack_option_scalar_payload_type(typ: CoreType) -> Bool:
	match typ:
		NamedType(name, type_args):
			(
				type_args.is_empty()
				and ((
					name == "Int"
					or name == "Int8"
					or name == "Int16"
					or name == "Int32"
					or name == "Int64"
					or name == "UInt8"
					or name == "UInt16"
					or name == "UInt32"
					or name == "UInt64"
					or name == "Float"
					or name == "Float32"
					or name == "Float16"
					or name == "Bool"
					or name == "Char"
					or name == "Int128"
					or name == "UInt128"
				))
			)
		EnumType(_):
			True
		_:
			False


private pure func restore_stack_option_payload_type(
	payload: CoreType,
	value: CoreExpr,
	erased_value: CoreExpr,
	loc: CoreSourceLoc,
) -> CoreExpr:
	value_type: CoreType = expr_type(value)

	if core_mono_type_equal(value_type, payload):
		value
	else if (
		stack_option_scalar_payload_type(value_type)
		and stack_option_scalar_payload_type(payload)
	):
		CastExpr(value, payload, loc)
	else:
		erased_value


private pure func stack_option_payload_arg(payload: CoreType, arg: CoreExpr) -> CoreExpr:
	match arg:
		CastExpr(value, cast_type, loc):
			match cast_type:
				NamedType(name, type_args):
					if name == "Ptr" and type_args.is_empty():
						restore_stack_option_payload_type(payload, value, arg, loc)
					else:
						arg
				_:
					arg
		BoxExpr(box, _, loc):
			match box.kind:
				PrimBox:
					restore_stack_option_payload_type(payload, box.value, arg, loc)
				_:
					arg
		_:
			arg


private pure func prepare_stack_option_constructor(
	constructor_name: String,
	def_id: Option[Int],
	args: List[CoreExpr],
	payload: CoreType,
) -> Option[CoreUnionConstruct]:
	if constructor_name == "Some" and args.length() == 1:
		match stack_option_representation(payload, STACK_OPTION_SOME_TAG):
			Some(representation):
				Some({
					type_name = "Option",
					constructor_name = "Some",
					constructor_c_name = "Some",
					representation = StackOptionRepresentation(representation),
					payload_storage = TypedUnionPayloadStorage,
					uses_release_mask = False,
					release_mask = 0,
					args = args.map(func(arg): boxed_storage_value_for_expr(stack_option_payload_arg(payload, arg))),
				})
			None:
				if is_nullable_option_payload_type(payload):
					Some({
						type_name = "Option",
						constructor_name = "Some",
						constructor_c_name = "Some",
						representation = NullableOptionRepresentation,
						payload_storage = TypedUnionPayloadStorage,
						uses_release_mask = False,
						release_mask = 0,
						args = boxed_storage_values_for_exprs(args),
					})
				else:
					boxed_args: List[CoreBoxedStorageValue] = boxed_storage_values_for_exprs(args)

					Some({
						type_name = "Option",
						constructor_name = "Some",
						constructor_c_name = constructor_c_name(constructor_name, def_id),
						representation = BoxedOptionRepresentation,
						payload_storage = ErasedUnionPayloadStorage,
						uses_release_mask = True,
						release_mask = release_mask_for_boxed_args(boxed_args),
						args = boxed_args,
					})
	else if constructor_name == "None" and args.length() == 0:
		match stack_option_representation(payload, STACK_OPTION_NONE_TAG):
			Some(representation):
				Some({
					type_name = "Option",
					constructor_name = "None",
					constructor_c_name = "None",
					representation = StackOptionRepresentation(representation),
					payload_storage = TypedUnionPayloadStorage,
					uses_release_mask = False,
					release_mask = 0,
					args = [],
				})
			None:
				if is_nullable_option_payload_type(payload):
					Some({
						type_name = "Option",
						constructor_name = "None",
						constructor_c_name = "None",
						representation = NullableOptionRepresentation,
						payload_storage = TypedUnionPayloadStorage,
						uses_release_mask = False,
						release_mask = 0,
						args = [],
					})
				else:
					Some({
						type_name = "Option",
						constructor_name = "None",
						constructor_c_name = constructor_c_name(constructor_name, def_id),
						representation = BoxedOptionRepresentation,
						payload_storage = TypedUnionPayloadStorage,
						uses_release_mask = False,
						release_mask = 0,
						args = [],
					})
	else:
		None


private pure func prepare_stack_option_construct(
	decls: PrepareDecls,
	kind: CoreCallKind,
	args: List[CoreExpr],
	payload: CoreType,
) -> Option[CoreUnionConstruct]:
	match kind:
		UserCall(constructor_name, def_id, consumed_args):
			canonical_name ?= canonical_union_constructor_name(
				decls,
				"Option",
				constructor_name,
				def_id,
			)
			prepare_stack_option_constructor(canonical_name, def_id, args, payload)
		BuiltinCall(name):
			if name == "blorp_option_some":
				prepare_stack_option_constructor("Some", None, args, payload)
			else if name == "blorp_option_none":
				prepare_stack_option_constructor("None", None, args, payload)
			else:
				None
		ForeignCall(name, arg_passing):
			None
		DirectRuntimeCall(call):
			None
		TensorParallelCall(name, layout):
			None
		DictWithCapacityCall(constructor):
			None
		IntrinsicCall(name):
			None
		OperationResultCall(bridge):
			None
		FallibleStreamTerminalCall(bridge):
			None
		ListToStringCall(callback_name):
			None
		ClosureCall:
			None
		UnknownCall:
			None
		DeferredTraitCall(trait_name, method_name):
			None
		SelectedTraitCall(trait_name, method_name, module_path, def_id):
			None
		SelectedDirectCall(def_id):
			None


private pure func stack_result_tag(constructor_name: String) -> Option[Int]:
	match constructor_name:
		"Ok":
			Some(STACK_RESULT_OK_TAG)
		"Err":
			Some(STACK_RESULT_ERR_TAG)
		_:
			None


private pure func result_type_payloads(typ: CoreType) -> Option[(CoreType, CoreType)]:
	match typ:
		NamedType(name, args):
			if name == "Result":
				match args:
					[ok_type, err_type]:
						Some((ok_type, err_type))
					_:
						None
			else:
				None
		StackResultType(ok_type, err_type):
			Some((ok_type, err_type))
		BoxedResultType(ok_type, err_type):
			Some((ok_type, err_type))
		_:
			None


private pure func stack_result_payload_type(
	constructor_name: String,
	typ: CoreType,
) -> Option[CoreType]:
	payloads ?= result_type_payloads(typ)

	match constructor_name:
		"Ok":
			Some(payloads[0])
		"Err":
			Some(payloads[1])
		_:
			None


private pure func stack_result_payload_has_erased_storage(payload: CoreType) -> Bool:
	match payload:
		TypeParameterType(_) | SelfType:
			True
		NamedType(name, args):
			True
		ValueRecordType(name):
			True
		TupleType(items):
			True
		VoidType:
			True
		EnumType(name):
			True
		HeapRecordType(name):
			True
		UnionType(name):
			True
		RangeType:
			True
		TensorType(info):
			True
		StackResultType(ok_type, err_type):
			True
		BoxedResultType(ok_type, err_type):
			True
		FunctionType(_, _, _):
			True


private pure func prepare_stack_result_constructor(
	constructor_name: String,
	args: List[CoreExpr],
	typ: CoreType,
) -> Option[CoreUnionConstruct]:
	tag ?= stack_result_tag(constructor_name)
	payload_type ?= stack_result_payload_type(constructor_name, typ)

	if args.length() == 1 and stack_result_payload_has_erased_storage(payload_type):
		boxed_args: List[CoreBoxedStorageValue] = boxed_storage_values_for_exprs(args)

		release_mask: Int = match boxed_args:
			[payload]:
				if payload.needs_release:
					1
				else:
					0
			_:
				0

		Some({
			type_name = "Result",
			constructor_name = constructor_name,
			constructor_c_name = constructor_name,
			representation = StackResultRepresentation({
				result_type = "blorp_StackResult",
				tag = tag,
				release_mask = release_mask,
			}),
			payload_storage = TypedUnionPayloadStorage,
			uses_release_mask = False,
			release_mask = release_mask,
			args = boxed_args,
		})
	else:
		None


private pure func prepare_stack_result_construct(
	decls: PrepareDecls,
	kind: CoreCallKind,
	args: List[CoreExpr],
	typ: CoreType,
) -> Option[CoreUnionConstruct]:
	match kind:
		UserCall(constructor_name, def_id, consumed_args):
			canonical_name ?= canonical_union_constructor_name(
				decls,
				"Result",
				constructor_name,
				def_id,
			)
			prepare_stack_result_constructor(canonical_name, args, typ)
		BuiltinCall(name):
			if name == "blorp_result_ok":
				prepare_stack_result_constructor("Ok", args, typ)
			else if name == "blorp_result_err":
				prepare_stack_result_constructor("Err", args, typ)
			else:
				None
		ForeignCall(name, arg_passing):
			None
		DirectRuntimeCall(call):
			None
		TensorParallelCall(name, layout):
			None
		DictWithCapacityCall(constructor):
			None
		IntrinsicCall(name):
			None
		OperationResultCall(bridge):
			None
		FallibleStreamTerminalCall(bridge):
			None
		ListToStringCall(callback_name):
			None
		ClosureCall:
			None
		UnknownCall:
			None
		DeferredTraitCall(trait_name, method_name):
			None
		SelectedTraitCall(trait_name, method_name, module_path, def_id):
			None
		SelectedDirectCall(def_id):
			None


private pure func boxed_result_constructor_c_name(constructor_name: String) -> Option[String]:
	match constructor_name:
		"Ok":
			Some("blorp_result_ok")
		"Err":
			Some("blorp_result_err")
		_:
			None


private pure func prepare_boxed_result_constructor(
	constructor_name: String,
	args: List[CoreExpr],
) -> Option[CoreUnionConstruct]:
	constructor_c_name ?= boxed_result_constructor_c_name(constructor_name)

	if args.length() == 1:
		boxed_args: List[CoreBoxedStorageValue] = boxed_storage_values_for_exprs(args)

		Some({
			type_name = "Result",
			constructor_name = constructor_name,
			constructor_c_name = constructor_c_name,
			representation = GenericUnionRepresentation,
			payload_storage = ErasedUnionPayloadStorage,
			uses_release_mask = False,
			release_mask = release_mask_for_boxed_args(boxed_args),
			args = boxed_args,
		})
	else:
		None


private pure func prepare_boxed_result_construct(
	decls: PrepareDecls,
	kind: CoreCallKind,
	args: List[CoreExpr],
) -> Option[CoreUnionConstruct]:
	match kind:
		UserCall(constructor_name, def_id, consumed_args):
			canonical_name ?= canonical_union_constructor_name(
				decls,
				"Result",
				constructor_name,
				def_id,
			)
			prepare_boxed_result_constructor(canonical_name, args)
		BuiltinCall(name):
			if name == "blorp_result_ok":
				prepare_boxed_result_constructor("Ok", args)
			else if name == "blorp_result_err":
				prepare_boxed_result_constructor("Err", args)
			else:
				None
		ForeignCall(name, arg_passing):
			None
		DirectRuntimeCall(call):
			None
		TensorParallelCall(name, layout):
			None
		DictWithCapacityCall(constructor):
			None
		IntrinsicCall(name):
			None
		OperationResultCall(bridge):
			None
		FallibleStreamTerminalCall(bridge):
			None
		ListToStringCall(callback_name):
			None
		ClosureCall:
			None
		UnknownCall:
			None
		DeferredTraitCall(trait_name, method_name):
			None
		SelectedTraitCall(trait_name, method_name, module_path, def_id):
			None
		SelectedDirectCall(def_id):
			None


private pure func prepare_union_construct(
	decls: PrepareDecls,
	kind: CoreCallKind,
	args: List[CoreExpr],
	typ: CoreType,
) -> Option[CoreUnionConstruct]:
	layout ?= decls.specialize_layout

	match typ:
		UnionType(type_name):
			match kind:
				UserCall(constructor_name, def_id, consumed_args):
					match find_union_decl(decls.unions_by_name, type_name):
						Some(union_decl):
							match find_union_variant_by_reference(
								union_decl.variants,
								constructor_name,
								def_id,
							):
								Some(variant):
									if variant.fields.length() == args.length():
										boxed_args: List[CoreBoxedStorageValue] = boxed_storage_values_for_union_payload(
											layout,
											union_decl.payload_storage,
											args,
										)
										uses_release_mask: Bool = union_variant_requires_release_mask(
											layout,
											union_decl.payload_storage,
											variant.fields,
										)

										release_mask: Int = if uses_release_mask:
											release_mask_for_boxed_args(boxed_args)
										else:
											0

										Some({
											type_name = type_name,
											constructor_name = variant.name,
											constructor_c_name = variant.c_name,
											representation = GenericUnionRepresentation,
											payload_storage = union_decl.payload_storage,
											uses_release_mask = uses_release_mask,
											release_mask = release_mask,
											args = boxed_args,
										})
									else:
										None
								None:
									None
						None:
							None
				ForeignCall(name, arg_passing):
					None
				BuiltinCall(name):
					None
				DirectRuntimeCall(call):
					None
				TensorParallelCall(name, layout):
					None
				DictWithCapacityCall(constructor):
					None
				IntrinsicCall(name):
					None
				OperationResultCall(bridge):
					None
				FallibleStreamTerminalCall(bridge):
					None
				ListToStringCall(callback_name):
					None
				ClosureCall:
					None
				UnknownCall:
					None
				DeferredTraitCall(trait_name, method_name):
					None
				SelectedTraitCall(trait_name, method_name, module_path, def_id):
					None
				SelectedDirectCall(def_id):
					None
		NamedType(name, type_args):
			if name == "Option":
				match type_args:
					[payload]:
						prepare_stack_option_construct(decls, kind, args, payload)
					[]:
						None
					[first, second, ...rest]:
						None
			else if name == "Result":
				match type_args:
					[ok_type, err_type]:
						prepare_stack_result_construct(decls, kind, args, typ)
					[]:
						None
					[only]:
						None
					[first, second, third, ...rest]:
						None
			else:
				None
		TypeParameterType(_) | SelfType:
			None
		StackResultType(ok_type, err_type):
			prepare_stack_result_construct(decls, kind, args, typ)
		BoxedResultType(ok_type, err_type):
			prepare_boxed_result_construct(decls, kind, args)
		FunctionType(_, _, _):
			None
		EnumType(name):
			None
		ValueRecordType(name):
			None
		HeapRecordType(name):
			None
		RangeType:
			None
		TensorType(info):
			None
		TupleType(items):
			None
		VoidType:
			None


private pure func prepare_literal_match_case(
	decls: PrepareDecls,
	match_case: CoreLiteralMatchCase,
) -> Option[CoreLiteralMatchCase]:
	prepared_body: CoreExpr = prepare_expr(decls, match_case.body)

	if same_core_expr(prepared_body, match_case.body):
		None
	else:
		Some({ match_case | body = prepared_body })


private pure func prepare_literal_match_cases(
	decls: PrepareDecls,
	cases: List[CoreLiteralMatchCase],
) -> Option[List[CoreLiteralMatchCase]]:
	prepare_list_items(cases, func(match_case): prepare_literal_match_case(decls, match_case))


private pure func prepare_literal_match_fallback(
	decls: PrepareDecls,
	fallback: CoreLiteralMatchFallback,
) -> Option[CoreLiteralMatchFallback]:
	match fallback:
		LiteralMatchFallbackBody(body):
			prepared_body: CoreExpr = prepare_expr(decls, body)

			if same_core_expr(prepared_body, body):
				None
			else:
				Some(LiteralMatchFallbackBody(prepared_body))
		LiteralMatchFallbackBindings(bindings, body):
			prepared_body: CoreExpr = prepare_expr(decls, body)

			if same_core_expr(prepared_body, body):
				None
			else:
				Some(LiteralMatchFallbackBindings(bindings, prepared_body))
		LiteralMatchFallbackFail:
			None


private pure func prepare_constructor_literal_match(
	decls: PrepareDecls,
	match_expr: CoreConstructorLiteralMatch,
) -> Option[CoreConstructorLiteralMatch]:
	prepared_cases: Option[List[CoreLiteralMatchCase]] = prepare_literal_match_cases(
		decls,
		match_expr.cases,
	)
	prepared_fallback: Option[CoreLiteralMatchFallback] = prepare_literal_match_fallback(
		decls,
		match_expr.fallback,
	)

	if prepared_cases.is_none() and prepared_fallback.is_none():
		None
	else:
		Some({ match_expr |
				cases = prepared_cases.get_or(match_expr.cases),
				fallback = prepared_fallback.get_or(match_expr.fallback)
			})


private pure func prepare_constructor_length_match_branch(
	decls: PrepareDecls,
	branch: CoreConstructorLengthMatchBranch,
) -> Option[CoreConstructorLengthMatchBranch]:
	match prepare_constructor_match_body(decls, branch.body):
		Some(body):
			Some({ branch | body = body })
		None:
			None


private pure func prepare_constructor_length_match_case(
	decls: PrepareDecls,
	match_case: CoreConstructorLengthMatchCase,
) -> Option[CoreConstructorLengthMatchCase]:
	match prepare_constructor_length_match_branch(decls, match_case.branch):
		Some(branch):
			Some({ match_case | branch = branch })
		None:
			None


---
`None` also covers an absent case, so the caller keeps its input either way.
---
private pure func prepare_constructor_length_match_geq(
	decls: PrepareDecls,
	geq_case: Option[CoreConstructorLengthMatchGeq],
) -> Option[CoreConstructorLengthMatchGeq]:
	match geq_case:
		Some(existing_case):
			match prepare_constructor_length_match_branch(decls, existing_case.branch):
				Some(branch):
					Some({ existing_case | branch = branch })
				None:
					None
		None:
			None


private pure func prepare_constructor_length_match_fallback(
	decls: PrepareDecls,
	fallback: Option[CoreConstructorLengthMatchBranch],
) -> Option[CoreConstructorLengthMatchBranch]:
	match fallback:
		Some(branch):
			prepare_constructor_length_match_branch(decls, branch)
		None:
			None


private pure func prepare_constructor_length_match(
	decls: PrepareDecls,
	match_expr: CoreConstructorLengthMatch,
) -> Option[CoreConstructorLengthMatch]:
	prepared_cases: Option[List[CoreConstructorLengthMatchCase]] = prepare_list_items(
		match_expr.cases,
		func(match_case): prepare_constructor_length_match_case(decls, match_case),
	)
	prepared_geq: Option[CoreConstructorLengthMatchGeq] = prepare_constructor_length_match_geq(
		decls,
		match_expr.geq,
	)
	prepared_fallback: Option[CoreConstructorLengthMatchBranch] = prepare_constructor_length_match_fallback(
		decls,
		match_expr.fallback,
	)

	if (
		prepared_cases.is_none()
		and prepared_geq.is_none()
		and prepared_fallback.is_none()
	):
		None
	else:
		geq: Option[CoreConstructorLengthMatchGeq] = if prepared_geq.is_some():
			prepared_geq
		else:
			match_expr.geq

		fallback: Option[CoreConstructorLengthMatchBranch] = if prepared_fallback.is_some():
			prepared_fallback
		else:
			match_expr.fallback

		Some({ match_expr |
				cases = prepared_cases.get_or(match_expr.cases),
				geq = geq,
				fallback = fallback
			})


private pure func prepare_constructor_match_body(
	decls: PrepareDecls,
	body: CoreConstructorMatchBody,
) -> Option[CoreConstructorMatchBody]:
	match body:
		ConstructorMatchBodyExpr(expr):
			prepared: CoreExpr = prepare_expr(decls, expr)

			if same_core_expr(prepared, expr):
				None
			else:
				Some(ConstructorMatchBodyExpr(prepared))
		ConstructorMatchBodyLiteral(match_expr):
			match prepare_constructor_literal_match(decls, match_expr):
				Some(prepared):
					Some(ConstructorMatchBodyLiteral(prepared))
				None:
					None
		ConstructorMatchBodyLength(match_expr):
			match prepare_constructor_length_match(decls, match_expr):
				Some(prepared):
					Some(ConstructorMatchBodyLength(prepared))
				None:
					None


private pure func prepare_constructor_match_case(
	decls: PrepareDecls,
	match_case: CoreConstructorMatchCase,
) -> Option[CoreConstructorMatchCase]:
	match prepare_constructor_match_body(decls, match_case.body):
		Some(body):
			Some({ match_case | body = body })
		None:
			None


private pure func prepare_constructor_match_fallback(
	decls: PrepareDecls,
	fallback: CoreConstructorMatchFallback,
) -> Option[CoreConstructorMatchFallback]:
	match fallback:
		ConstructorMatchFallbackBody(body):
			prepared_body: CoreExpr = prepare_expr(decls, body)

			if same_core_expr(prepared_body, body):
				None
			else:
				Some(ConstructorMatchFallbackBody(prepared_body))
		ConstructorMatchFallbackBindings(bindings, body):
			prepared_body: CoreExpr = prepare_expr(decls, body)

			if same_core_expr(prepared_body, body):
				None
			else:
				Some(ConstructorMatchFallbackBindings(bindings, prepared_body))
		ConstructorMatchFallbackFail:
			None


private pure func prepare_raw_match_case(
	decls: PrepareDecls,
	match_case: CoreRawMatchCase,
) -> Option[CoreRawMatchCase]:
	prepared_body: CoreExpr = prepare_expr(decls, match_case.body)

	if same_core_expr(prepared_body, match_case.body):
		None
	else:
		Some({ match_case | body = prepared_body })


private union PrepareLogicalTask:
	PrepareLogicalNode(CoreExpr)
	RebuildPreparedLogicalNode(CoreExpr)


---
Long `and`/`or` chains form deep Core trees; walk them iteratively. The
rebuild task carries the source node so an unchanged pair of sides hands
that node back instead of an equal copy.
---
private pure func prepare_logical_expr(decls: PrepareDecls, expr: CoreExpr) -> CoreExpr:
	var tasks: List[PrepareLogicalTask] = [PrepareLogicalNode(expr)]
	var task_count: Int = 1
	var prepared: List[CoreExpr] = []
	var prepared_count: Int = 0
	var valid: Bool = True

	while valid and task_count > 0:
		task_count -= 1

		match tasks.get(task_count):
			Some(task):
				match task:
					PrepareLogicalNode(current_expr):
						match current_expr:
							LogicalExpr(op, left, right, typ, loc):
								rebuild_task: PrepareLogicalTask = RebuildPreparedLogicalNode(
									current_expr,
								)

								tasks = if task_count < tasks.length():
									tasks.set(task_count, rebuild_task)
								else:
									tasks.append(rebuild_task)

								task_count += 1

								right_task: PrepareLogicalTask = PrepareLogicalNode(right)

								tasks = if task_count < tasks.length():
									tasks.set(task_count, right_task)
								else:
									tasks.append(right_task)

								task_count += 1

								left_task: PrepareLogicalTask = PrepareLogicalNode(left)

								tasks = if task_count < tasks.length():
									tasks.set(task_count, left_task)
								else:
									tasks.append(left_task)

								task_count += 1
							_:
								prepared_expr: CoreExpr = prepare_expr(decls, current_expr)

								prepared = if prepared_count < prepared.length():
									prepared.set(prepared_count, prepared_expr)
								else:
									prepared.append(prepared_expr)

								prepared_count += 1
					RebuildPreparedLogicalNode(source_expr):
						match source_expr:
							LogicalExpr(op, left, right, typ, loc):
								match (
									prepared.get(prepared_count - 2),
									prepared.get(prepared_count - 1),
								):
									(Some(prepared_left), Some(prepared_right)):
										rebuilt: CoreExpr = if (
											same_core_expr(prepared_left, left)
											and same_core_expr(prepared_right, right)
										):
											source_expr
										else:
											LogicalExpr(op, prepared_left, prepared_right, typ, loc)

										prepared = prepared.set(prepared_count - 2, rebuilt)
										prepared_count -= 1
									_:
										valid = False
							_:
								valid = False
			None:
				valid = False

	if valid and prepared_count == 1:
		prepared.get_or(0, expr)
	else:
		expr


---
Every arm prepares its children exactly as it always has and answers `expr`
itself when every prepared child and child container came back as the same
allocation; only genuine shape changes (constructor calls, record and tuple
literals, dict literals, stack Option `None`) build new nodes.

This dispatcher binds nothing and forwards to one small arm group, so a deep
Core tree costs a shallow native frame per level: one match over every
constructor would reserve stack for all of its arms' locals at once and
overflow the default stack at -O0 on large generated suites.
---
private pure func prepare_expr(decls: PrepareDecls, expr: CoreExpr) -> CoreExpr:
	match expr:
		LiteralExpr(_, _, _) | StaticStringLiteralExpr(_, _, _, _) | VarExpr(_, _, _) | VoidExpr(_, _) | CooperativeCheckpointExpr(_, _) | BreakExpr(_, _) | ContinueExpr(_, _) | SetAllocExpr(_, _, _) | ClosureCreateExpr(_, _, _) | DetachExpr(_, _, _):
			prepare_leaf_expr(decls, expr)
		DebugBlockExpr(_, _, _) | BinaryExpr(_, _, _, _, _) | UnaryExpr(_, _, _, _) | LogicalExpr(_, _, _, _, _) | AssignExpr(_, _, _, _) | CastExpr(_, _, _) | UnboxExpr(_, _, _, _) | FieldExpr(_, _, _, _) | TupleFieldExpr(_, _, _, _) | BoxExpr(_, _, _) | PreClosureDetachExpr(_, _, _) | DupExpr(_, _, _, _, _, _) | DropExpr(_, _, _, _, _, _) | LetExpr(_, _, _, _, _) | BorrowLetExpr(_, _, _, _) | SeqExpr(_, _) | WhileExpr(_, _, _, _) | RangeExpr(_, _, _, _) | IfExpr(_, _, _, _, _):
			prepare_operator_expr(decls, expr)
		CallExpr(_, _, _, _, _) | TupleExpr(_, _, _) | TupleConstructExpr(_, _, _) | VectorExpr(_, _, _) | ListConstructExpr(_, _, _) | DictExpr(_, _, _) | DictConstructExpr(_, _, _) | RecordExpr(_, _, _) | RecordUpdateExpr(_, _, _, _) | RecordReuseExpr(_, _, _, _) | RecordCowUpdateExpr(_, _, _, _) | RecordConstructExpr(_, _, _, _) | UnionConstructExpr(_, _, _) | UnionReuseConstructExpr(_, _, _) | SelectExpr(_, _, _):
			prepare_aggregate_expr(decls, expr)
		ListAllocExpr(_, _, _) | ListGetExpr(_, _, _) | ListHandoffExpr(_, _, _) | ListHandoffSetOwnedExpr(_, _, _) | ListHandoffSetSourceSlotExpr(_, _, _) | ListRetainExpr(_, _, _) | ListSetExpr(_, _, _) | ListSwapExpr(_, _, _) | StringByteReadExpr(_, _, _) | StringByteWriteExpr(_, _, _) | StringByteCopyExpr(_, _, _) | StringSetLenExpr(_, _, _) | TensorLiteralExpr(_, _, _) | TensorBoxedLiteralExpr(_, _, _) | TensorPackedLiteralExpr(_, _, _) | TensorRawFillExpr(_, _, _) | TensorRawReadExpr(_, _, _) | TensorRawWriteExpr(_, _, _) | TensorRawViewLetExpr(_, _, _, _):
			prepare_storage_expr(decls, expr)
		LambdaExpr(_, _, _, _, _, _) | TailrecLoopExpr(_, _, _, _) | TailrecRecurExpr(_, _, _) | TailrecListSpreadLoopExpr(_, _) | TailrecListSpreadRecurExpr(_, _, _, _) | ForRangeExpr(_, _, _, _, _, _) | ForChannelExpr(_, _, _) | ForListExpr(_, _, _) | ForStringExpr(_, _, _) | ForDictExpr(_, _, _) | ForSetExpr(_, _, _) | ForStreamExpr(_, _, _) | ForResourceSourceExpr(_, _, _) | ForTensorExpr(_, _, _) | ResourceScopeExpr(_, _, _) | ResourceCleanupExitExpr(_, _, _):
			prepare_loop_expr(decls, expr)
		PreClosureConcurrentlyLoopExpr(_, _, _) | ConcurrentlyLoopExpr(_, _, _) | PreClosureConcurrentExpr(_, _, _) | ConcurrentExpr(_, _, _):
			prepare_concurrency_expr(decls, expr)
		RawMatchExpr(_, _, _, _) | SemanticMatchExpr(_, _, _, _) | LiteralMatchExpr(_, _, _, _, _) | AccessorLiteralMatchExpr(_, _, _, _, _) | LengthMatchExpr(_, _, _, _, _) | ConstructorMatchExpr(_, _, _, _, _, _):
			prepare_match_expr(decls, expr)


---
A bare `None` reference to a stack-represented Option becomes an explicit
construct; every other variable reference is handed back as is.
---
private pure func prepare_var_expr(
	decls: PrepareDecls,
	expr: CoreExpr,
	variable: CoreVar,
	typ: CoreType,
	loc: CoreSourceLoc,
) -> CoreExpr:
	match typ:
		NamedType(name, type_args):
			if name == "Option":
				match type_args:
					[payload]:
						if variable_is_union_constructor(decls, "Option", variable):
							match prepare_stack_option_construct(
								decls,
								UserCall("None", variable.def_id, []),
								[],
								payload,
							):
								Some(construct):
									UnionConstructExpr(construct, typ, loc)
								None:
									expr
						else:
							expr
					_:
						expr
			else:
				expr
		_:
			expr


---
Leaves and nodes preparation never looks inside.
---
private pure func prepare_leaf_expr(decls: PrepareDecls, expr: CoreExpr) -> CoreExpr:
	match expr:
		VarExpr(variable, typ, loc):
			prepare_var_expr(decls, expr, variable, typ, loc)
		_:
			expr


---
Operators, casts, field reads, and the simple binding and control forms.
---
private pure func prepare_operator_expr(decls: PrepareDecls, expr: CoreExpr) -> CoreExpr:
	match expr:
		DebugBlockExpr(body, typ, loc):
			prepared_body: CoreExpr = prepare_expr(decls, body)

			if same_core_expr(prepared_body, body):
				expr
			else:
				DebugBlockExpr(prepared_body, typ, loc)
		BinaryExpr(op, left, right, typ, loc):
			prepared_left: CoreExpr = prepare_expr(decls, left)
			prepared_right: CoreExpr = prepare_expr(decls, right)

			if same_core_expr(prepared_left, left) and same_core_expr(prepared_right, right):
				expr
			else:
				BinaryExpr(op, prepared_left, prepared_right, typ, loc)
		UnaryExpr(op, expr_value, typ, loc):
			prepared_value: CoreExpr = prepare_expr(decls, expr_value)

			if same_core_expr(prepared_value, expr_value):
				expr
			else:
				UnaryExpr(op, prepared_value, typ, loc)
		LogicalExpr(op, left, right, typ, loc):
			prepare_logical_expr(decls, expr)
		AssignExpr(variable, rhs, typ, loc):
			prepared_rhs: CoreExpr = prepare_expr(decls, rhs)

			if same_core_expr(prepared_rhs, rhs):
				expr
			else:
				AssignExpr(variable, prepared_rhs, typ, loc)
		CastExpr(expr_value, typ, loc):
			prepared_value: CoreExpr = prepare_expr(decls, expr_value)

			if same_core_expr(prepared_value, expr_value):
				expr
			else:
				CastExpr(prepared_value, typ, loc)
		UnboxExpr(unbox_kind, expr_value, typ, loc):
			prepared_value: CoreExpr = prepare_expr(decls, expr_value)

			if same_core_expr(prepared_value, expr_value):
				expr
			else:
				UnboxExpr(unbox_kind, prepared_value, typ, loc)
		FieldExpr(expr_value, field_name, typ, loc):
			prepared_value: CoreExpr = prepare_expr(decls, expr_value)

			if same_core_expr(prepared_value, expr_value):
				expr
			else:
				FieldExpr(prepared_value, field_name, typ, loc)
		TupleFieldExpr(expr_value, field_index, typ, loc):
			prepared_value: CoreExpr = prepare_expr(decls, expr_value)

			if same_core_expr(prepared_value, expr_value):
				expr
			else:
				TupleFieldExpr(prepared_value, field_index, typ, loc)
		BoxExpr(box, typ, loc):
			match prepare_box_op(decls, box):
				Some(prepared_box):
					BoxExpr(prepared_box, typ, loc)
				None:
					expr
		PreClosureDetachExpr(detached, typ, loc):
			prepared_detached: CoreExpr = prepare_expr(decls, detached)

			if same_core_expr(prepared_detached, detached):
				expr
			else:
				PreClosureDetachExpr(prepared_detached, typ, loc)
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			prepared_body: CoreExpr = prepare_expr(decls, body)

			if same_core_expr(prepared_body, body):
				expr
			else:
				DupExpr(variable, value_type, retain_policy, prepared_body, typ, loc)
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			prepared_body: CoreExpr = prepare_expr(decls, body)

			if same_core_expr(prepared_body, body):
				expr
			else:
				DropExpr(variable, value_type, release_policy, prepared_body, typ, loc)
		LetExpr(name, is_mutable, typ, rhs, body):
			prepared_rhs: CoreExpr = prepare_expr(decls, rhs)
			prepared_body: CoreExpr = prepare_expr(decls, body)

			if same_core_expr(prepared_rhs, rhs) and same_core_expr(prepared_body, body):
				expr
			else:
				LetExpr(name, is_mutable, typ, prepared_rhs, prepared_body)
		BorrowLetExpr(name, typ, rhs, body):
			prepared_rhs: CoreExpr = prepare_expr(decls, rhs)
			prepared_body: CoreExpr = prepare_expr(decls, body)

			if same_core_expr(prepared_rhs, rhs) and same_core_expr(prepared_body, body):
				expr
			else:
				BorrowLetExpr(name, typ, prepared_rhs, prepared_body)
		SeqExpr(first, second):
			prepared_first: CoreExpr = prepare_expr(decls, first)
			prepared_second: CoreExpr = prepare_expr(decls, second)

			if same_core_expr(prepared_first, first) and same_core_expr(prepared_second, second):
				expr
			else:
				SeqExpr(prepared_first, prepared_second)
		WhileExpr(cond, body, typ, loc):
			prepared_cond: CoreExpr = prepare_expr(decls, cond)
			prepared_body: CoreExpr = prepare_expr(decls, body)

			if same_core_expr(prepared_cond, cond) and same_core_expr(prepared_body, body):
				expr
			else:
				WhileExpr(prepared_cond, prepared_body, typ, loc)
		RangeExpr(start, end_value, typ, loc):
			prepared_start: CoreExpr = prepare_expr(decls, start)
			prepared_end: CoreExpr = prepare_expr(decls, end_value)

			if same_core_expr(prepared_start, start) and same_core_expr(prepared_end, end_value):
				expr
			else:
				RangeExpr(prepared_start, prepared_end, typ, loc)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			prepared_cond: CoreExpr = prepare_expr(decls, cond)
			prepared_then: CoreExpr = prepare_expr(decls, then_expr)
			prepared_else: CoreExpr = prepare_expr(decls, else_expr)

			if (
				same_core_expr(prepared_cond, cond)
				and same_core_expr(prepared_then, then_expr)
				and same_core_expr(prepared_else, else_expr)
			):
				expr
			else:
				IfExpr(prepared_cond, prepared_then, prepared_else, typ, loc)
		_:
			expr


---
Calls and the literal, record, union, and select aggregates.
---
private pure func prepare_aggregate_expr(decls: PrepareDecls, expr: CoreExpr) -> CoreExpr:
	match expr:
		CallExpr(kind, callee, args, typ, loc):
			prepared_callee: CoreExpr = prepare_expr(decls, callee)
			prepared_args: List[CoreExpr] = prepare_exprs(decls, args)

			match prepare_union_construct(decls, kind, prepared_args, typ):
				Some(construct):
					UnionConstructExpr(construct, typ, loc)
				None:
					if (
						same_core_expr(prepared_callee, callee)
						and same_core_exprs(prepared_args, args)
					):
						expr
					else:
						CallExpr(kind, prepared_callee, prepared_args, typ, loc)
		TupleExpr(items, typ, loc):
			prepare_tuple_expr(decls, expr, items, typ, loc)
		TupleConstructExpr(tuple_construct, typ, loc):
			match prepare_list_items(tuple_construct.elements, func(element): prepare_tuple_element(decls, element)):
				Some(elements):
					TupleConstructExpr({ tuple_construct | elements = elements }, typ, loc)
				None:
					expr
		VectorExpr(items, typ, loc):
			prepare_vector_expr(decls, expr, items, typ, loc)
		ListConstructExpr(construct, typ, loc):
			match prepare_list_construct(decls, construct):
				Some(prepared_construct):
					ListConstructExpr(prepared_construct, typ, loc)
				None:
					expr
		DictExpr(entries, typ, loc):
			prepare_dict_expr(decls, expr, entries, typ, loc)
		DictConstructExpr(construct, typ, loc):
			match prepare_dict_construct(decls, construct):
				Some(prepared_construct):
					DictConstructExpr(prepared_construct, typ, loc)
				None:
					expr
		RecordExpr(fields, typ, loc):
			prepare_record_expr(decls, expr, fields, typ, loc)
		RecordUpdateExpr(base, fields, typ, loc):
			prepared_base: CoreExpr = prepare_expr(decls, base)
			prepared_fields: Option[List[CoreRecordFieldValue]] = prepare_record_fields(
				decls,
				fields,
			)

			if same_core_expr(prepared_base, base) and prepared_fields.is_none():
				expr
			else:
				RecordUpdateExpr(
					prepared_base,
					prepared_fields.get_or(fields),
					typ,
					loc,
				)
		RecordReuseExpr(source, fields, typ, loc):
			prepared_source: CoreExpr = prepare_expr(decls, source)
			prepared_fields: Option[List[CoreRecordFieldValue]] = prepare_record_fields(
				decls,
				fields,
			)

			if same_core_expr(prepared_source, source) and prepared_fields.is_none():
				expr
			else:
				RecordReuseExpr(
					prepared_source,
					prepared_fields.get_or(fields),
					typ,
					loc,
				)
		RecordCowUpdateExpr(source, fields, typ, loc):
			prepared_source: CoreExpr = prepare_expr(decls, source)
			prepared_fields: Option[List[CoreRecordCowField]] = prepare_list_items(
				fields,
				func(field): prepare_record_cow_field(decls, field),
			)

			if same_core_expr(prepared_source, source) and prepared_fields.is_none():
				expr
			else:
				RecordCowUpdateExpr(
					prepared_source,
					prepared_fields.get_or(fields),
					typ,
					loc,
				)
		RecordConstructExpr(type_name, fields, typ, loc):
			prepare_record_construct_expr(decls, expr, type_name, fields, typ, loc)
		UnionConstructExpr(construct, typ, loc):
			match prepare_boxed_storage_values(decls, construct.args):
				Some(args):
					UnionConstructExpr({ construct | args = args }, typ, loc)
				None:
					expr
		UnionReuseConstructExpr(construct, typ, loc):
			prepared_source: CoreExpr = prepare_expr(decls, construct.source)
			prepared_args: Option[List[CoreBoxedStorageValue]] = prepare_boxed_storage_values(
				decls,
				construct.args,
			)

			if same_core_expr(prepared_source, construct.source) and prepared_args.is_none():
				expr
			else:
				UnionReuseConstructExpr(
					{ construct |
						source = prepared_source,
						args = prepared_args.get_or(construct.args)
					},
					typ,
					loc,
				)
		SelectExpr(select_expr, typ, loc):
			match prepare_list_items(select_expr, func(arm): prepare_select_arm(decls, arm)):
				Some(arms):
					SelectExpr(arms, typ, loc)
				None:
					expr
		_:
			expr


---
List, string, and tensor storage operations whose children live in one
payload record.
---
private pure func prepare_storage_expr(decls: PrepareDecls, expr: CoreExpr) -> CoreExpr:
	match expr:
		ListAllocExpr(alloc, typ, loc):
			match prepare_list_alloc(decls, alloc):
				Some(prepared):
					ListAllocExpr(prepared, typ, loc)
				None:
					expr
		ListGetExpr(get, typ, loc):
			match prepare_list_get(decls, get):
				Some(prepared):
					ListGetExpr(prepared, typ, loc)
				None:
					expr
		ListHandoffExpr(handoff, typ, loc):
			match prepare_list_handoff(decls, handoff):
				Some(prepared):
					ListHandoffExpr(prepared, typ, loc)
				None:
					expr
		ListHandoffSetOwnedExpr(set, typ, loc):
			match prepare_list_set(decls, set):
				Some(prepared):
					ListHandoffSetOwnedExpr(prepared, typ, loc)
				None:
					expr
		ListHandoffSetSourceSlotExpr(slot, typ, loc):
			match prepare_list_handoff_set_source_slot(decls, slot):
				Some(prepared):
					ListHandoffSetSourceSlotExpr(prepared, typ, loc)
				None:
					expr
		ListRetainExpr(retain, typ, loc):
			match prepare_list_retain(decls, retain):
				Some(prepared):
					ListRetainExpr(prepared, typ, loc)
				None:
					expr
		ListSetExpr(set, typ, loc):
			match prepare_list_set(decls, set):
				Some(prepared):
					ListSetExpr(prepared, typ, loc)
				None:
					expr
		ListSwapExpr(swap, typ, loc):
			match prepare_list_swap(decls, swap):
				Some(prepared):
					ListSwapExpr(prepared, typ, loc)
				None:
					expr
		StringByteReadExpr(read, typ, loc):
			match prepare_string_byte_read(decls, read):
				Some(prepared):
					StringByteReadExpr(prepared, typ, loc)
				None:
					expr
		StringByteWriteExpr(write, typ, loc):
			match prepare_string_byte_write(decls, write):
				Some(prepared):
					StringByteWriteExpr(prepared, typ, loc)
				None:
					expr
		StringByteCopyExpr(copy, typ, loc):
			match prepare_string_byte_copy(decls, copy):
				Some(prepared):
					StringByteCopyExpr(prepared, typ, loc)
				None:
					expr
		StringSetLenExpr(set_len, typ, loc):
			match prepare_string_set_len(decls, set_len):
				Some(prepared):
					StringSetLenExpr(prepared, typ, loc)
				None:
					expr
		TensorLiteralExpr(literal, typ, loc):
			match prepare_tensor_literal(decls, literal):
				Some(prepared):
					TensorLiteralExpr(prepared, typ, loc)
				None:
					expr
		TensorBoxedLiteralExpr(literal, typ, loc):
			match prepare_tensor_boxed_literal(decls, literal):
				Some(prepared):
					TensorBoxedLiteralExpr(prepared, typ, loc)
				None:
					expr
		TensorPackedLiteralExpr(literal, typ, loc):
			match prepare_tensor_packed_literal(decls, literal):
				Some(prepared):
					TensorPackedLiteralExpr(prepared, typ, loc)
				None:
					expr
		TensorRawFillExpr(fill, typ, loc):
			match prepare_tensor_raw_fill(decls, fill):
				Some(prepared):
					TensorRawFillExpr(prepared, typ, loc)
				None:
					expr
		TensorRawReadExpr(read, typ, loc):
			match prepare_tensor_raw_read(decls, read):
				Some(prepared):
					TensorRawReadExpr(prepared, typ, loc)
				None:
					expr
		TensorRawWriteExpr(write, typ, loc):
			match prepare_tensor_raw_write(decls, write):
				Some(prepared):
					TensorRawWriteExpr(prepared, typ, loc)
				None:
					expr
		TensorRawViewLetExpr(binding, body, typ, loc):
			prepared_binding: Option[CoreTensorRawViewBinding] = prepare_tensor_raw_view_binding(
				decls,
				binding,
			)
			prepared_body: CoreExpr = prepare_expr(decls, body)

			if prepared_binding.is_none() and same_core_expr(prepared_body, body):
				expr
			else:
				TensorRawViewLetExpr(
					prepared_binding.get_or(binding),
					prepared_body,
					typ,
					loc,
				)
		_:
			expr


---
Lambdas, tail-recursive loops, `for` loops, and resource scopes.
---
private pure func prepare_loop_expr(decls: PrepareDecls, expr: CoreExpr) -> CoreExpr:
	match expr:
		LambdaExpr(lambda_params, lambda_return_type, lambda_body, lambda_is_pure, typ, loc):
			prepared_body: CoreExpr = prepare_expr(decls, lambda_body)

			if same_core_expr(prepared_body, lambda_body):
				expr
			else:
				LambdaExpr(
					lambda_params,
					lambda_return_type,
					prepared_body,
					lambda_is_pure,
					typ,
					loc,
				)
		TailrecLoopExpr(params, return_type, body, loc):
			prepared_body: CoreExpr = prepare_expr(decls, body)

			if same_core_expr(prepared_body, body):
				expr
			else:
				TailrecLoopExpr(params, return_type, prepared_body, loc)
		TailrecRecurExpr(args, typ, loc):
			prepared_args: List[CoreExpr] = prepare_exprs(decls, args)

			if same_core_exprs(prepared_args, args):
				expr
			else:
				TailrecRecurExpr(prepared_args, typ, loc)
		TailrecListSpreadLoopExpr(loop, loc):
			match prepare_tailrec_list_spread_loop(decls, loop):
				Some(prepared_loop):
					TailrecListSpreadLoopExpr(prepared_loop, loc)
				None:
					expr
		TailrecListSpreadRecurExpr(rebinds, cursor_advance, typ, loc):
			match prepare_list_items(
				rebinds,
				func(rebind): prepare_tailrec_list_spread_rebind(decls, rebind),
			):
				Some(prepared_rebinds):
					TailrecListSpreadRecurExpr(prepared_rebinds, cursor_advance, typ, loc)
				None:
					expr
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			prepared_start: CoreExpr = prepare_expr(decls, start)
			prepared_end: CoreExpr = prepare_expr(decls, end_value)
			prepared_body: CoreExpr = prepare_expr(decls, body)

			if (
				same_core_expr(prepared_start, start)
				and same_core_expr(prepared_end, end_value)
				and same_core_expr(prepared_body, body)
			):
				expr
			else:
				ForRangeExpr(binder, prepared_start, prepared_end, prepared_body, typ, loc)
		ForChannelExpr(for_channel, typ, loc):
			prepared_iterable: CoreExpr = prepare_expr(decls, for_channel.iterable)
			prepared_body: CoreExpr = prepare_expr(decls, for_channel.body)

			if (
				same_core_expr(prepared_iterable, for_channel.iterable)
				and same_core_expr(prepared_body, for_channel.body)
			):
				expr
			else:
				ForChannelExpr(
					{ for_channel |
						iterable = prepared_iterable,
						body = prepared_body
					},
					typ,
					loc,
				)
		ForListExpr(for_list, typ, loc):
			prepared_iterable: CoreExpr = prepare_expr(decls, for_list.iterable)
			prepared_body: CoreExpr = prepare_expr(decls, for_list.body)

			if (
				same_core_expr(prepared_iterable, for_list.iterable)
				and same_core_expr(prepared_body, for_list.body)
			):
				expr
			else:
				ForListExpr(
					{ for_list |
						iterable = prepared_iterable,
						body = prepared_body
					},
					typ,
					loc,
				)
		ForStringExpr(for_string, typ, loc):
			prepared_iterable: CoreExpr = prepare_expr(decls, for_string.iterable)
			prepared_body: CoreExpr = prepare_expr(decls, for_string.body)

			if (
				same_core_expr(prepared_iterable, for_string.iterable)
				and same_core_expr(prepared_body, for_string.body)
			):
				expr
			else:
				ForStringExpr(
					{ for_string |
						iterable = prepared_iterable,
						body = prepared_body
					},
					typ,
					loc,
				)
		ForDictExpr(for_dict, typ, loc):
			prepared_iterable: CoreExpr = prepare_expr(decls, for_dict.iterable)
			prepared_body: CoreExpr = prepare_expr(decls, for_dict.body)

			if (
				same_core_expr(prepared_iterable, for_dict.iterable)
				and same_core_expr(prepared_body, for_dict.body)
			):
				expr
			else:
				ForDictExpr(
					{ for_dict |
						iterable = prepared_iterable,
						body = prepared_body
					},
					typ,
					loc,
				)
		ForSetExpr(for_set, typ, loc):
			prepared_iterable: CoreExpr = prepare_expr(decls, for_set.iterable)
			prepared_body: CoreExpr = prepare_expr(decls, for_set.body)

			if (
				same_core_expr(prepared_iterable, for_set.iterable)
				and same_core_expr(prepared_body, for_set.body)
			):
				expr
			else:
				ForSetExpr(
					{ for_set |
						iterable = prepared_iterable,
						body = prepared_body
					},
					typ,
					loc,
				)
		ForResourceSourceExpr(for_resource_source, typ, loc):
			prepared_iterable: CoreExpr = prepare_expr(decls, for_resource_source.iterable)
			prepared_body: CoreExpr = prepare_expr(decls, for_resource_source.body)

			if (
				same_core_expr(prepared_iterable, for_resource_source.iterable)
				and same_core_expr(prepared_body, for_resource_source.body)
			):
				expr
			else:
				ForResourceSourceExpr(
					{ for_resource_source |
						iterable = prepared_iterable,
						body = prepared_body
					},
					typ,
					loc,
				)
		ForStreamExpr(for_stream, typ, loc):
			prepared_iterable: CoreExpr = prepare_expr(decls, for_stream.iterable)
			prepared_body: CoreExpr = prepare_expr(decls, for_stream.body)

			if (
				same_core_expr(prepared_iterable, for_stream.iterable)
				and same_core_expr(prepared_body, for_stream.body)
			):
				expr
			else:
				ForStreamExpr(
					{ for_stream |
						iterable = prepared_iterable,
						body = prepared_body
					},
					typ,
					loc,
				)
		ForTensorExpr(for_tensor, typ, loc):
			prepared_iterable: CoreExpr = prepare_expr(decls, for_tensor.iterable)
			prepared_body: CoreExpr = prepare_expr(decls, for_tensor.body)

			if (
				same_core_expr(prepared_iterable, for_tensor.iterable)
				and same_core_expr(prepared_body, for_tensor.body)
			):
				expr
			else:
				ForTensorExpr(
					{ for_tensor |
						iterable = prepared_iterable,
						body = prepared_body
					},
					typ,
					loc,
				)
		ResourceScopeExpr(scope, typ, loc):
			prepared_acquire: CoreExpr = prepare_expr(decls, scope.acquire)
			prepared_body: CoreExpr = prepare_expr(decls, scope.body)
			prepared_cleanup: CoreExpr = prepare_expr(decls, scope.cleanup)

			if (
				same_core_expr(prepared_acquire, scope.acquire)
				and same_core_expr(prepared_body, scope.body)
				and same_core_expr(prepared_cleanup, scope.cleanup)
			):
				expr
			else:
				ResourceScopeExpr(
					{ scope |
						acquire = prepared_acquire,
						body = prepared_body,
						cleanup = prepared_cleanup
					},
					typ,
					loc,
				)
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			prepared_cleanups: List[CoreExpr] = prepare_exprs(decls, cleanup_exit.cleanups)

			if same_core_exprs(prepared_cleanups, cleanup_exit.cleanups):
				expr
			else:
				ResourceCleanupExitExpr({ cleanup_exit | cleanups = prepared_cleanups }, typ, loc)
		_:
			expr


---
Structured-concurrency blocks and loops, before and after closure formation.
---
private pure func prepare_concurrency_expr(decls: PrepareDecls, expr: CoreExpr) -> CoreExpr:
	match expr:
		PreClosureConcurrentlyLoopExpr(loop, typ, loc):
			prepared_iterable: CoreExpr = prepare_expr(decls, loop.iterable)
			prepared_body: CoreExpr = prepare_expr(decls, loop.body)
			prepared_timeout: Option[CoreExpr] = prepare_optional_expr(decls, loop.timeout)
			prepared_limit: CoreExpr = prepare_expr(decls, loop.limit)

			if (
				same_core_expr(prepared_iterable, loop.iterable)
				and same_core_expr(prepared_body, loop.body)
				and same_optional_core_expr(prepared_timeout, loop.timeout)
				and same_core_expr(prepared_limit, loop.limit)
			):
				expr
			else:
				PreClosureConcurrentlyLoopExpr(
					{ loop |
						iterable = prepared_iterable,
						body = prepared_body,
						timeout = prepared_timeout,
						limit = prepared_limit
					},
					typ,
					loc,
				)
		ConcurrentlyLoopExpr(loop, typ, loc):
			match prepare_concurrently_loop(decls, loop):
				Some(prepared_loop):
					ConcurrentlyLoopExpr(prepared_loop, typ, loc)
				None:
					expr
		PreClosureConcurrentExpr(block, typ, loc):
			prepared_body: CoreExpr = prepare_expr(decls, block.body)
			prepared_timeout: Option[CoreExpr] = prepare_optional_expr(decls, block.timeout)

			if (
				same_core_expr(prepared_body, block.body)
				and same_optional_core_expr(prepared_timeout, block.timeout)
			):
				expr
			else:
				PreClosureConcurrentExpr(
					{ block |
						body = prepared_body,
						timeout = prepared_timeout
					},
					typ,
					loc,
				)
		ConcurrentExpr(block, typ, loc):
			match prepare_concurrent_block(decls, block):
				Some(prepared_block):
					ConcurrentExpr(prepared_block, typ, loc)
				None:
					expr
		_:
			expr


---
The match forms. Semantic matches already go through the shared traversal,
which applies the same reuse rule.
---
private pure func prepare_match_expr(decls: PrepareDecls, expr: CoreExpr) -> CoreExpr:
	match expr:
		RawMatchExpr(scrutinee, cases, typ, loc):
			prepared_scrutinee: CoreExpr = prepare_expr(decls, scrutinee)
			prepared_cases: Option[List[CoreRawMatchCase]] = prepare_list_items(
				cases,
				func(match_case): prepare_raw_match_case(decls, match_case),
			)

			if same_core_expr(prepared_scrutinee, scrutinee) and prepared_cases.is_none():
				expr
			else:
				RawMatchExpr(
					prepared_scrutinee,
					prepared_cases.get_or(cases),
					typ,
					loc,
				)
		SemanticMatchExpr(scrutinee, tree, typ, loc):
			CoreTraverse.map_core_expr_children_with_context(expr, decls, prepare_expr)
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			prepared_scrutinee: CoreExpr = prepare_expr(decls, scrutinee)
			prepared_cases: Option[List[CoreLiteralMatchCase]] = prepare_literal_match_cases(
				decls,
				cases,
			)
			prepared_fallback: Option[CoreLiteralMatchFallback] = prepare_literal_match_fallback(
				decls,
				fallback,
			)

			if (
				same_core_expr(prepared_scrutinee, scrutinee)
				and prepared_cases.is_none()
				and prepared_fallback.is_none()
			):
				expr
			else:
				LiteralMatchExpr(
					prepared_scrutinee,
					prepared_cases.get_or(cases),
					prepared_fallback.get_or(fallback),
					typ,
					loc,
				)
		AccessorLiteralMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			prepared_scrutinee: CoreExpr = prepare_expr(decls, scrutinee)
			prepared_match: Option[CoreConstructorLiteralMatch] = prepare_constructor_literal_match(
				decls,
				match_expr,
			)

			if same_core_expr(prepared_scrutinee, scrutinee) and prepared_match.is_none():
				expr
			else:
				AccessorLiteralMatchExpr(
					prepared_scrutinee,
					scrutinee_release_policy,
					prepared_match.get_or(match_expr),
					typ,
					loc,
				)
		LengthMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			prepared_scrutinee: CoreExpr = prepare_expr(decls, scrutinee)
			prepared_match: Option[CoreConstructorLengthMatch] = prepare_constructor_length_match(
				decls,
				match_expr,
			)

			if same_core_expr(prepared_scrutinee, scrutinee) and prepared_match.is_none():
				expr
			else:
				LengthMatchExpr(
					prepared_scrutinee,
					scrutinee_release_policy,
					prepared_match.get_or(match_expr),
					typ,
					loc,
				)
		ConstructorMatchExpr(scrutinee, scrutinee_release_policy, cases, fallback, typ, loc):
			prepared_scrutinee: CoreExpr = prepare_expr(decls, scrutinee)
			prepared_cases: Option[List[CoreConstructorMatchCase]] = prepare_list_items(
				cases,
				func(match_case): prepare_constructor_match_case(decls, match_case),
			)
			prepared_fallback: Option[CoreConstructorMatchFallback] = prepare_constructor_match_fallback(
				decls,
				fallback,
			)

			if (
				same_core_expr(prepared_scrutinee, scrutinee)
				and prepared_cases.is_none()
				and prepared_fallback.is_none()
			):
				expr
			else:
				ConstructorMatchExpr(
					prepared_scrutinee,
					scrutinee_release_policy,
					prepared_cases.get_or(cases),
					prepared_fallback.get_or(fallback),
					typ,
					loc,
				)
		_:
			expr


private pure func prepare_dict_literal_entry_for_ownership(
	decls: PrepareDecls,
	entry: CoreDictLiteralEntry,
) -> Option[CoreDictLiteralEntry]:
	prepared_key: CoreExpr = prepare_dict_literals_for_ownership_expr(decls, entry.key)
	prepared_value: CoreExpr = prepare_dict_literals_for_ownership_expr(decls, entry.value)

	if same_core_expr(prepared_key, entry.key) and same_core_expr(prepared_value, entry.value):
		None
	else:
		Some({
			key = prepared_key,
			value = prepared_value,
		})


private union PrepareDictOwnershipLogicalTask:
	PrepareDictOwnershipLogicalNode(CoreExpr)
	RebuildPreparedDictOwnershipLogicalNode(CoreExpr)


private pure func prepare_dict_literals_for_ownership_expr(
	decls: PrepareDecls,
	expr: CoreExpr,
) -> CoreExpr:
	match expr:
		DictExpr(entries, typ, loc):
			lower_dict_literal_expr(
				decls,
				expr,
				entries,
				prepare_list_items(
					entries,
					func(entry): prepare_dict_literal_entry_for_ownership(decls, entry),
				),
				typ,
				loc,
			)
		LogicalExpr(_, _, _, _, _):
			prepare_dict_literals_for_ownership_logical_expr(decls, expr)
		_:
			CoreTraverse.map_core_expr_children_with_context(
				expr,
				decls,
				prepare_dict_literals_for_ownership_expr,
			)


private pure func prepare_dict_literals_for_ownership_logical_expr(
	decls: PrepareDecls,
	expr: CoreExpr,
) -> CoreExpr:
	var tasks: List[PrepareDictOwnershipLogicalTask] = [PrepareDictOwnershipLogicalNode(expr)]
	var task_count: Int = 1
	var prepared: List[CoreExpr] = []
	var prepared_count: Int = 0
	var valid: Bool = True

	while valid and task_count > 0:
		task_count -= 1

		match tasks.get(task_count):
			Some(task):
				match task:
					PrepareDictOwnershipLogicalNode(current_expr):
						match current_expr:
							LogicalExpr(op, left, right, typ, loc):
								rebuild_task: PrepareDictOwnershipLogicalTask = RebuildPreparedDictOwnershipLogicalNode(
									current_expr,
								)

								tasks = if task_count < tasks.length():
									tasks.set(task_count, rebuild_task)
								else:
									tasks.append(rebuild_task)

								task_count += 1

								right_task: PrepareDictOwnershipLogicalTask = PrepareDictOwnershipLogicalNode(
									right,
								)

								tasks = if task_count < tasks.length():
									tasks.set(task_count, right_task)
								else:
									tasks.append(right_task)

								task_count += 1

								left_task: PrepareDictOwnershipLogicalTask = PrepareDictOwnershipLogicalNode(
									left,
								)

								tasks = if task_count < tasks.length():
									tasks.set(task_count, left_task)
								else:
									tasks.append(left_task)

								task_count += 1
							_:
								prepared_expr: CoreExpr = prepare_dict_literals_for_ownership_expr(
									decls,
									current_expr,
								)

								prepared = if prepared_count < prepared.length():
									prepared.set(prepared_count, prepared_expr)
								else:
									prepared.append(prepared_expr)

								prepared_count += 1
					RebuildPreparedDictOwnershipLogicalNode(source_expr):
						match source_expr:
							LogicalExpr(op, left, right, typ, loc):
								match (
									prepared.get(prepared_count - 2),
									prepared.get(prepared_count - 1),
								):
									(Some(prepared_left), Some(prepared_right)):
										rebuilt: CoreExpr = if (
											same_core_expr(prepared_left, left)
											and same_core_expr(prepared_right, right)
										):
											source_expr
										else:
											LogicalExpr(op, prepared_left, prepared_right, typ, loc)

										prepared = prepared.set(prepared_count - 2, rebuilt)
										prepared_count -= 1
									_:
										valid = False
							_:
								valid = False
			None:
				valid = False

	if valid and prepared_count == 1:
		prepared.get_or(0, expr)
	else:
		expr


private pure func prepare_dict_literals_for_ownership_function(
	decls: PrepareDecls,
	func_info: CoreFunction,
) -> CoreFunction:
	match func_info.body:
		Some(body):
			{ func_info | body = Some(prepare_dict_literals_for_ownership_expr(decls, body)) }
		None:
			func_info


private pure func prepare_dict_literals_for_ownership_decl(
	decls: PrepareDecls,
	decl: CoreDecl,
) -> CoreDecl:
	match decl:
		FunctionDecl(func_info):
			FunctionDecl(prepare_dict_literals_for_ownership_function(decls, func_info))
		GlobalDecl(global):
			GlobalDecl(
				{ global | init = prepare_dict_literals_for_ownership_expr(decls, global.init) },
			)
		ImplDecl(impl_decl):
			ImplDecl(
				{ impl_decl |
					methods = impl_decl.methods.map(
						func(method): prepare_dict_literals_for_ownership_function(decls, method),
					)
				},
			)
		_:
			decl


pure func prepare_dict_literals_for_ownership(program: CoreProgram) -> CoreProgram:
	indexed: PrepareDecls = prepare_decls(program.decls, None)

	{ program |
		decls = program.decls.map(
			func(decl): prepare_dict_literals_for_ownership_decl(indexed, decl),
		)
	}


private pure func prepare_function(decls: PrepareDecls, func_info: CoreFunction) -> CoreFunction:
	match func_info.body:
		Some(body):
			prepared_body: CoreExpr = annotate_tensor_storage_expr(
				[],
				prepare_expr(decls, body),
			)

			if same_core_expr(prepared_body, body):
				func_info
			else:
				{ func_info | body = Some(prepared_body) }
		None:
			func_info


private pure func prepare_global(decls: PrepareDecls, global: CoreGlobal) -> CoreGlobal:
	prepared_init: CoreExpr = annotate_tensor_storage_expr(
		[],
		prepare_expr(decls, global.init),
	)

	if same_core_expr(prepared_init, global.init):
		global
	else:
		{ global | init = prepared_init }


private pure func prepare_decl(decls: PrepareDecls, decl: CoreDecl) -> CoreDecl:
	match decl:
		FunctionDecl(func_info):
			FunctionDecl(prepare_function(decls, func_info))
		GlobalDecl(global):
			GlobalDecl(prepare_global(decls, global))
		EnumDecl(enum_decl):
			EnumDecl(enum_decl)
		UnionDecl(union_decl):
			UnionDecl(union_decl)
		ValueRecordDecl(record_decl):
			ValueRecordDecl(record_decl)
		HeapRecordDecl(record_decl):
			HeapRecordDecl(record_decl)
		TypeAliasDecl(alias_decl):
			TypeAliasDecl(alias_decl)
		TraitDecl(trait_decl):
			TraitDecl(trait_decl)
		ImplDecl(impl_decl):
			ImplDecl(
				{ impl_decl |
					methods = impl_decl.methods.map(func(method): prepare_function(decls, method))
				},
			)


pure func prepare_program(program: CoreProgram) -> CoreProgram:
	layout: CoreSpecializeLayout = build_specialize_layout(program)
	indexed: PrepareDecls = prepare_decls(program.decls, Some(layout))
	var decls: List[CoreDecl] = []

	for decl in program.decls:
		decls = decls.append(prepare_decl(indexed, decl))

	{
		decls = decls,
		foreign_includes = program.foreign_includes,
		source_files = program.source_files
	}


---
Step 1 of the emitter-as-dumb-printer migration: the per-type cleanup
(destructor) plan.

Today `stage_10_backend/emit.brp` decides which destructor a heap record or
union gets by calling `allocation_contracts` policy predicates while it
prints, and recomputes the same per-field facts every time a type's
destructor is emitted. Nothing before emission records the outcome, so nothing
upstream (in particular the allocation analysis) can see that releasing a
self-recursive union may allocate scratch memory for the iterative destructor's
work stack.

`CleanupPlan` publishes that decision as data instead. There is one row per
declaration in a program's `decls`, in the same order, so the row's index is
its declaration's dense identity -- the only identity types have today; there
is no narrower type id than the position of the declaration in `decls`. Rows
for anything that is not a heap record or a union are `NotACleanupType`.

The plan is built once (see `build_cleanup_plan`) from the shared
`allocation_contracts` predicates for source-owned release and recursive
cleanup. CorePrepare adds one representation-specific fact for erased union
fields: boxing an otherwise unmanaged source value can create an owned storage
object. That fact uses the shared `specialize_layout` box-kind and slot-release
classifier. The emitter reads the prepared row instead of deriving either
source or erased-storage cleanup policy while printing.
---
enum CleanupStrategy:
	NoCleanup
	DirectCleanup
	IterativeCleanup


record CleanupFieldPlan {
	needs_release: Bool,
	uses_iterative_cleanup: Bool
}


record CleanupVariantPlan {
	has_cleanup: Bool,
	fields: List[CleanupFieldPlan]
}


record UnionCleanupTypePlan {
	strategy: CleanupStrategy,
	may_allocate_scratch: Bool,
	variants: List[CleanupVariantPlan]
}


record HeapRecordCleanupTypePlan {
	strategy: CleanupStrategy,
	fields: List[CleanupFieldPlan]
}


union CleanupTypePlan:
	UnionTypeCleanup(UnionCleanupTypePlan)
	HeapRecordTypeCleanup(HeapRecordCleanupTypePlan)
	NotACleanupType


---
One row per declaration, indexed exactly like `program.decls`.
---
record CleanupPlan {
	rows: List[CleanupTypePlan]
}


---
The row for the declaration at `decl_index`. An out-of-range index (which
should never happen for a plan built from the same `decls` it is queried
against) reads as `NotACleanupType` rather than failing.
---
pure func cleanup_plan_row(plan: CleanupPlan, decl_index: Int) -> CleanupTypePlan:
	match plan.rows.get(decl_index):
		Some(row):
			row
		None:
			NotACleanupType


---
The precomputed per-variant facts for one union variant, or `None` when
`type_plan` is not a union row or `variant_index` is out of range.
---
pure func union_cleanup_variant_plan(
	type_plan: CleanupTypePlan,
	variant_index: Int,
) -> Option[CleanupVariantPlan]:
	match type_plan:
		UnionTypeCleanup(union_plan):
			union_plan.variants.get(variant_index)
		HeapRecordTypeCleanup(_) | NotACleanupType:
			None


---
The precomputed per-field facts for one union field, or `None` when
`type_plan` is not a union row or the indices are out of range.
---
pure func union_cleanup_field_plan(
	type_plan: CleanupTypePlan,
	variant_index: Int,
	field_index: Int,
) -> Option[CleanupFieldPlan]:
	match type_plan:
		UnionTypeCleanup(union_plan):
			match union_plan.variants.get(variant_index):
				Some(variant_plan):
					variant_plan.fields.get(field_index)
				None:
					None
		HeapRecordTypeCleanup(_) | NotACleanupType:
			None


---
The precomputed per-field facts for one heap record field, or `None` when
`type_plan` is not a heap record row or the index is out of range.
---
pure func heap_record_cleanup_field_plan(
	type_plan: CleanupTypePlan,
	field_index: Int,
) -> Option[CleanupFieldPlan]:
	match type_plan:
		HeapRecordTypeCleanup(record_plan):
			record_plan.fields.get(field_index)
		UnionTypeCleanup(_) | NotACleanupType:
			None


private pure func cleanup_strategy_for_union(kind: UnionCleanupKind) -> CleanupStrategy:
	match kind:
		NoUnionCleanup:
			NoCleanup
		DirectUnionCleanup:
			DirectCleanup
		IterativeUnionCleanup:
			IterativeCleanup


private pure func cleanup_field_plan_for_union_field(
	layout: CoreSpecializeLayout,
	union_decl: CoreUnionDecl,
	field: CoreUnionField,
) -> CleanupFieldPlan:
	{
		needs_release = union_field_needs_release_in_storage(
			layout,
			union_decl.payload_storage,
			field,
		),
		uses_iterative_cleanup = union_field_uses_iterative_cleanup(union_decl, field)
	}


private pure func cleanup_variant_plan(
	layout: CoreSpecializeLayout,
	union_decl: CoreUnionDecl,
	variant: CoreUnionVariant,
) -> CleanupVariantPlan:
	var fields: List[CleanupFieldPlan] = []

	for field in variant.fields:
		fields = fields.append(cleanup_field_plan_for_union_field(layout, union_decl, field))

	{
		has_cleanup = union_variant_has_effective_cleanup(
			layout,
			union_decl.payload_storage,
			variant.fields,
		),
		fields = fields
	}


private pure func union_decl_requires_field_cleanup(
	layout: CoreSpecializeLayout,
	union_decl: CoreUnionDecl,
) -> Bool:
	var requires_cleanup: Bool = False

	for variant in union_decl.variants:
		if union_variant_has_effective_cleanup(
			layout,
			union_decl.payload_storage,
			variant.fields,
		):
			requires_cleanup = True
			break

	requires_cleanup


private pure func union_cleanup_strategy(
	layout: CoreSpecializeLayout,
	union_decl: CoreUnionDecl,
) -> CleanupStrategy:
	source_strategy: CleanupStrategy = cleanup_strategy_for_union(
		union_cleanup_kind(union_decl),
	)

	if source_strategy == IterativeCleanup:
		-- Keep the existing iterative path for recursive source-owned fields.
		IterativeCleanup
	else if union_decl_requires_field_cleanup(layout, union_decl):
		DirectCleanup
	else:
		NoCleanup


private pure func union_cleanup_type_plan(
	layout: CoreSpecializeLayout,
	union_decl: CoreUnionDecl,
) -> CleanupTypePlan:
	strategy: CleanupStrategy = union_cleanup_strategy(layout, union_decl)
	var variants: List[CleanupVariantPlan] = []

	for variant in union_decl.variants:
		variants = variants.append(cleanup_variant_plan(layout, union_decl, variant))

	UnionTypeCleanup({
		strategy = strategy,
		may_allocate_scratch = strategy == IterativeCleanup,
		variants = variants
	})


private pure func heap_record_cleanup_type_plan(record_decl: CoreHeapRecordDecl) -> CleanupTypePlan:
	var fields: List[CleanupFieldPlan] = []
	var has_destructor: Bool = False

	for field in record_decl.fields:
		needs_release: Bool = release_policy_requires_cleanup(field.release_policy)

		if needs_release:
			has_destructor = True
		else:
			void

		fields = fields.append({
			needs_release = needs_release,
			uses_iterative_cleanup = False
		})

	strategy: CleanupStrategy = if has_destructor:
		DirectCleanup
	else:
		NoCleanup

	HeapRecordTypeCleanup({
		strategy = strategy,
		fields = fields
	})


private pure func cleanup_type_plan_for_decl(
	layout: CoreSpecializeLayout,
	decl: CoreDecl,
) -> CleanupTypePlan:
	match decl:
		UnionDecl(union_decl):
			union_cleanup_type_plan(layout, union_decl)
		HeapRecordDecl(record_decl):
			heap_record_cleanup_type_plan(record_decl)
		FunctionDecl(_) | GlobalDecl(_) | EnumDecl(_) | ValueRecordDecl(_) | TypeAliasDecl(_) | TraitDecl(_) | ImplDecl(_):
			NotACleanupType


---
Builds the program's cleanup plan once. Heap record rows use shared
`allocation_contracts` policy; union rows combine that source-owned policy
with the erased-storage box ownership classifier. Every other declaration
gets `NotACleanupType`. Called once, from the single place a `CoreProgram`
becomes a `PreparedCoreProgram`
(`stage_09_core/pipeline.brp`), so the emitter never has to call the
policy predicates itself.
---
pure func build_cleanup_plan(program: CoreProgram) -> CleanupPlan:
	layout: CoreSpecializeLayout = build_specialize_layout(program)
	var rows: List[CleanupTypePlan] = []

	for decl in program.decls:
		rows = rows.append(cleanup_type_plan_for_decl(layout, decl))

	{ rows = rows }


---
Step 2 of the emitter-as-dumb-printer migration: the per-function/global
cancellation and cleanup plan.

`stage_10_backend/emit.brp` used to decide, while printing a function body or
a global initializer, which values need a cleanup frame and what runs on a
cancelled exit -- by calling `CancellationPlan.build_current_behavior_cancellation_plan`
/ `build_region_sensitive_cancellation_plan` itself, once per function, at
print time. `CancellationPlanTable` publishes that decision as data instead.

There is one row per declaration in a program's `decls`, indexed exactly like
`CleanupPlan.rows` and `program.decls` -- the same dense identity. A
`FunctionDecl` with a body and every `GlobalDecl` get `Some(plan)`; anything
else (a function with no body, and every other declaration kind) gets `None`.

The plan is built once (see `build_cancellation_plan_table`) by calling the
same `CancellationPlan` builders the emitter used to call; it does not
reimplement them. Whether a function's plan is the region-sensitive or the
current-behavior variant is itself a whole-program Core fact (whether the
function is in `CancellationProgramSummary`), computed here from
`analyze_program_cancellation`, so the emitter no longer needs the program
summary at all.
---
record CancellationPlanTable {
	rows: List[Option[CancellationProtectionPlan]]
}


---
The row for the declaration at `decl_index`, or `None` when that declaration
has no cancellation plan (not a callable, or a function with no body) or the
index is out of range.
---
pure func cancellation_plan_table_row(
	table: CancellationPlanTable,
	decl_index: Int,
) -> Option[CancellationProtectionPlan]:
	match table.rows.get(decl_index):
		Some(row):
			row
		None:
			None


---
A defensive default for a declaration whose row is unexpectedly missing --
never exercised when `decl_index` comes from the same `decls` the table was
built from, since prepare and the emitter walk them the same way. It is a
plain record literal, not a call into the builders, so this stays a reader,
never a planner, on the emitter's behalf.
---
pure func empty_cancellation_protection_plan(
	activation: CancellationActivationIdentity,
) -> CancellationProtectionPlan:
	{
		activation = activation,
		effect = CannotCancelCurrentTask,
		max_live_slots = 0,
		let_protections = [],
		let_protections_by_name = {},
		match_scrutinee_protections = [],
		match_scrutinee_protections_by_id = None,
		planned_owner_count = 0,
		expression_visits = 0
	}


private pure func function_cancellation_plan(
	func_info: CoreFunction,
	program_summary: CancellationProgramSummary,
) -> Option[CancellationProtectionPlan]:
	match func_info.body:
		Some(body):
			identity: CoreDefinitionIdentity = {
				name = func_info.name,
				def_id = func_info.def_id
			}
			activation: CancellationActivationIdentity = FunctionCancellationActivation(identity)

			plan: CancellationProtectionPlan = match cancellation_function_summary(
				program_summary,
				identity,
			):
				Some(_):
					build_region_sensitive_cancellation_plan(activation, body, program_summary)
				None:
					build_current_behavior_cancellation_plan(activation, body)

			Some(plan)
		None:
			None


private pure func global_cancellation_plan(
	global: CoreGlobal,
	program_summary: CancellationProgramSummary,
) -> Option[CancellationProtectionPlan]:
	identity: CoreDefinitionIdentity = {
		name = global.name.name,
		def_id = global.def_id
	}
	activation: CancellationActivationIdentity = GlobalInitializerCancellationActivation(identity)

	plan: CancellationProtectionPlan = match cancellation_global_initializer_summary(
		program_summary,
		identity,
	):
		Some(_):
			build_region_sensitive_cancellation_plan(activation, global.init, program_summary)
		None:
			build_current_behavior_cancellation_plan(activation, global.init)

	Some(plan)


private pure func cancellation_plan_for_decl(
	decl: CoreDecl,
	program_summary: CancellationProgramSummary,
) -> Option[CancellationProtectionPlan]:
	match decl:
		FunctionDecl(func_info):
			function_cancellation_plan(func_info, program_summary)
		GlobalDecl(global):
			global_cancellation_plan(global, program_summary)
		EnumDecl(_) | UnionDecl(_) | ValueRecordDecl(_) | HeapRecordDecl(_) | TypeAliasDecl(_) | TraitDecl(_) | ImplDecl(_):
			None


---
Builds the program's cancellation plan table once. Every function
declaration with a body and every global declaration get a row computed from
the shared `CancellationPlan` builders; every other declaration gets `None`.
Called once, from the single place a `CoreProgram` becomes a
`PreparedCoreProgram` (`stage_09_core/pipeline.brp`), so the emitter never
has to call `analyze_program_cancellation` or the plan builders itself.
---
pure func build_cancellation_plan_table(program: CoreProgram) -> CancellationPlanTable:
	program_summary: CancellationProgramSummary = analyze_program_cancellation(program)
	var rows: List[Option[CancellationProtectionPlan]] = []

	for decl in program.decls:
		rows = rows.append(cancellation_plan_for_decl(decl, program_summary))

	{ rows = rows }
