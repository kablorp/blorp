	decls: PrepareDecls,
	literal: CoreTensorBoxedLiteral,
) -> Option[CoreTensorBoxedLiteral]:
	match prepare_boxed_storage_values(decls, literal.elements):
		Some(elements):
			Some({ literal | elements = elements })
		None:
			None


