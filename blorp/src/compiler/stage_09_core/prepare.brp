	if (
		same_core_expr(prepared_source, handoff.source)
		and same_core_expr(prepared_capacity, handoff.capacity)
		and same_core_expr(prepared_body, handoff.body)
	):
		None
	else:
		Some({ handoff |
				source = prepared_source,
				capacity = prepared_capacity,
				body = prepared_body
			})


private pure func prepare_list_handoff_set_source_slot(
	decls: PrepareDecls,
	slot: CoreListHandoffSetSourceSlot,
) -> Option[CoreListHandoffSetSourceSlot]:
	prepared_result: CoreExpr = prepare_expr(decls, slot.result)
	prepared_out_index: CoreExpr = prepare_expr(decls, slot.out_index)
	prepared_source: CoreExpr = prepare_expr(decls, slot.source)
	prepared_source_index: CoreExpr = prepare_expr(decls, slot.source_index)

	if (
		same_core_expr(prepared_result, slot.result)
		and same_core_expr(prepared_out_index, slot.out_index)
		and same_core_expr(prepared_source, slot.source)
		and same_core_expr(prepared_source_index, slot.source_index)
	):
		None
	else:
		Some({
			result = prepared_result,
			out_index = prepared_out_index,
			source = prepared_source,
			source_index = prepared_source_index,
		})


