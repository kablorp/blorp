private pure func prepare_tensor_literal(
	decls: PrepareDecls,
	literal: CoreTensorLiteral,
) -> Option[CoreTensorLiteral]:
	match prepare_tensor_literal_payload(decls, literal.payload):
		Some(payload):
			Some({ literal | payload = payload })
		None:
			None


private pure func prepare_tensor_literal_payload(
	decls: PrepareDecls,
	payload: CoreTensorLiteralPayload,
) -> Option[CoreTensorLiteralPayload]:
	match payload:
		TensorRawLiteralPayload(raw):
			prepared_elements: List[CoreExpr] = prepare_exprs(decls, raw.elements)

			if same_core_exprs(prepared_elements, raw.elements):
				None
			else:
				Some(TensorRawLiteralPayload({ raw | elements = prepared_elements }))
		TensorInlineStructLiteralPayload(inline_struct):
			prepared_elements: List[CoreExpr] = prepare_exprs(decls, inline_struct.elements)

			if same_core_exprs(prepared_elements, inline_struct.elements):
				None
			else:
				Some(
					TensorInlineStructLiteralPayload(
						{ inline_struct | elements = prepared_elements },
					),
				)


