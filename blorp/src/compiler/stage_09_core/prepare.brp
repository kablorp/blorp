	prepared_len: CoreExpr = prepare_expr(decls, copy.len)

	if (
		same_core_expr(prepared_dst, copy.dst)
		and same_core_expr(prepared_dst_pos, copy.dst_pos)
		and same_core_expr(prepared_src, copy.src)
		and same_core_expr(prepared_src_pos, copy.src_pos)
		and same_core_expr(prepared_len, copy.len)
	):
		None
	else:
		Some({
			dst = prepared_dst,
			dst_pos = prepared_dst_pos,
			src = prepared_src,
			src_pos = prepared_src_pos,
			len = prepared_len,
		})


