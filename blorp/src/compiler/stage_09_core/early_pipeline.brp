-- The ordered early-Core pass list. Stage state, diagnostics, observations,
-- and stops belong to the shared runner in `pass_runner`; this module owns only
-- the order and the invariant each pass must leave behind.
import:
	collection_pipeline: fuse_collection_program
	dce: prune_program
	early_invariants:
		CoreEarlyInvariantViolation,
		check_debug_invariants,
		check_desugar_invariants,
		check_match_invariants,
		check_mono_invariants,
		check_resolve_invariants,
		check_std_inline_invariants,
		check_synth_invariants,
	early_stages as CoreEarlyStages
	ir: CoreProgram
	match_lowering: compile_program
	monomorphize: monomorphize_program
	parallel_tensor_pipeline: fuse_parallel_tensor_program
	pass_runner:
		CorePass,
		CorePassControl,
		CorePassDiagnostic(
			CoreEarlyInvariantDiagnostic,
			CoreEarlyMonoDiagnostic,
			CoreEarlySynthDiagnostic,
			CoreEarlyTraitResolveDiagnostic,
		),
		CorePassObservation,
		CorePassRun(CorePassesCompleted, CorePassesFailed, CorePassesStopped),
		CorePassState,
		CorePassTiming,
		core_pass,
		core_pass_state,
		core_program_pass,
		run_core_passes,
	resolve: CoreResolveImportBinding, CoreResolveModuleImports, resolve_core_program
	std_inline: inline_std_wrappers
	string_pipeline: fuse_string_program
	synth: synthesize_program
	tailrec: lower_tailrec_program
	tensor_fusion: fuse_tensor_update_program
	trait_resolve: resolve_core_traits
	tuple_sroa: rewrite_tuple_sroa_program


enum CoreEarlyPipelineStage:
	CoreEarlyLowerStage
	CoreEarlyDebugStage
	CoreEarlyDesugarStage
	CoreEarlyMonoStage
	CoreEarlySynthStage
	CoreEarlyMatchStage
	CoreEarlyTraitResolveStage
	CoreEarlyResolveStage
	CoreEarlyStdInlineStage
	CoreEarlyTailrecStage
	CoreEarlyFusionStage


LOWER_PASS: String = "lower"

DEBUG_PASS: String = "debug"

-- Lowering emits the whole embedded standard library, so a two-function program
-- reaches desugar carrying hundreds of declarations no entry point can reach.
-- Pruning here means every pass from desugar onward walks only the live program.
PRUNE_EARLY_PASS: String = "prune_early"

DESUGAR_PASS: String = "desugar"

MONO_PASS: String = "mono"

SYNTH_PASS: String = "synth"

MATCH_PASS: String = "match"

TRAIT_RESOLVE_PASS: String = "trait_resolve"

-- Trait resolution is the first point where every trait call names a target DCE
-- can see, so a program the pre-desugar prune had to leave whole becomes
-- prunable here.
PRUNE_AFTER_TRAIT_RESOLVE_PASS: String = "prune_after_trait_resolve"

RESOLVE_PASS: String = "resolve"

STD_INLINE_PASS: String = "std_inline"

TAILREC_PASS: String = "tailrec"

FUSE_STRING_PASS: String = "fuse_string"

FUSE_COLLECTION_PASS: String = "fuse_collection"

FUSE_PARALLEL_TENSOR_PASS: String = "fuse_parallel_tensor"

FUSE_TENSOR_UPDATE_PASS: String = "fuse_tensor_update"

-- Generic templates are projected out between tensor fusion and tuple SROA, so
-- the user-visible `fusion` snapshot is the one taken after tuple SROA.
TUPLE_SROA_PASS: String = "tuple_sroa"

FUSION_STAGE: String = "fusion"


record CoreEarlyPipelineConfiguration {
	debug: Bool,
	check_invariants: Bool,
	observations: List[CoreEarlyPipelineStage],
	stop_after: Option[CoreEarlyPipelineStage]
}


record CoreEarlyPipelineInput {
	program: CoreProgram,
	next_def_id: Int
}


record CoreEarlyPipelineObservation {
	stage_name: String,
	rendered: String
}


record CoreEarlyPipelineOutput {
	program: CoreProgram,
	next_def_id: Int,
	observations: List[CoreEarlyPipelineObservation],
	pass_timings: List[CorePassTiming]
}


union CoreEarlyPipelineExecution:
	CoreEarlyPipelineCompleted(CoreEarlyPipelineOutput)
	CoreEarlyPipelineStopped(String, String, List[CoreEarlyPipelineObservation], List[CorePassTiming])
	CoreEarlyPipelineFailed(CorePassDiagnostic)


pure func core_early_pipeline_stage_name(stage: CoreEarlyPipelineStage) -> String:
	match stage:
		CoreEarlyLowerStage:
			LOWER_PASS
		CoreEarlyDebugStage:
			DEBUG_PASS
		CoreEarlyDesugarStage:
			DESUGAR_PASS
		CoreEarlyMonoStage:
			MONO_PASS
		CoreEarlySynthStage:
			SYNTH_PASS
		CoreEarlyMatchStage:
			MATCH_PASS
		CoreEarlyTraitResolveStage:
			TRAIT_RESOLVE_PASS
		CoreEarlyResolveStage:
			RESOLVE_PASS
		CoreEarlyStdInlineStage:
			STD_INLINE_PASS
		CoreEarlyTailrecStage:
			TAILREC_PASS
		CoreEarlyFusionStage:
			FUSION_STAGE


-- User-visible stage names are aliases for the pass they end at. Only `fusion`
-- differs from its pass, because it names the post-tuple-SROA program.
pure func early_core_pass_name(stage: CoreEarlyPipelineStage) -> String:
	match stage:
		CoreEarlyFusionStage:
			TUPLE_SROA_PASS
		_:
			core_early_pipeline_stage_name(stage)


pure func early_core_pass_stage_name(pass_name: String) -> String:
	if pass_name == TUPLE_SROA_PASS:
		FUSION_STAGE
	else:
		pass_name


pure func parse_core_early_pipeline_stage(name: String) -> Option[CoreEarlyPipelineStage]:
	match name:
		"lower":
			Some(CoreEarlyLowerStage)
		"debug":
			Some(CoreEarlyDebugStage)
		"desugar":
			Some(CoreEarlyDesugarStage)
		"mono":
			Some(CoreEarlyMonoStage)
		"synth":
			Some(CoreEarlySynthStage)
		"match":
			Some(CoreEarlyMatchStage)
		"trait_resolve":
			Some(CoreEarlyTraitResolveStage)
		"resolve":
			Some(CoreEarlyResolveStage)
		"std_inline":
			Some(CoreEarlyStdInlineStage)
		"tailrec":
			Some(CoreEarlyTailrecStage)
		"fusion":
			Some(CoreEarlyFusionStage)
		_:
			None


private pure func first_early_violation(
	violations: List[CoreEarlyInvariantViolation],
) -> Option[CorePassDiagnostic]:
	match violations:
		[violation, ..._]:
			Some(CoreEarlyInvariantDiagnostic(violation))
		[]:
			None


private pure func debug_invariant(program: CoreProgram) -> Option[CorePassDiagnostic]:
	first_early_violation(check_debug_invariants(program))


private pure func desugar_invariant(program: CoreProgram) -> Option[CorePassDiagnostic]:
	first_early_violation(check_desugar_invariants(program))


private pure func mono_invariant(program: CoreProgram) -> Option[CorePassDiagnostic]:
	first_early_violation(check_mono_invariants(program))


private pure func synth_invariant(program: CoreProgram) -> Option[CorePassDiagnostic]:
	first_early_violation(check_synth_invariants(program))


private pure func match_invariant(program: CoreProgram) -> Option[CorePassDiagnostic]:
	first_early_violation(check_match_invariants(program))


-- Resolution invariants run on every compile, so they stay in `invariant` and
-- leave `checked_invariant` empty rather than walking the program twice under
-- `--check-invariants`.
private pure func resolve_invariant(program: CoreProgram) -> Option[CorePassDiagnostic]:
	first_early_violation(check_resolve_invariants(program))


private pure func std_inline_invariant(program: CoreProgram) -> Option[CorePassDiagnostic]:
	first_early_violation(
		check_resolve_invariants(program).concat(check_std_inline_invariants(program)),
	)


private pure func checked_early_pass(
	name: String,
	rewrite: pure (CoreProgram) -> CoreProgram,
	checked: pure (CoreProgram) -> Option[CorePassDiagnostic],
) -> CorePass:
	{ core_program_pass(name, rewrite) | checked_invariant = Some(checked) }


private pure func required_early_pass(
	name: String,
	rewrite: pure (CoreProgram) -> CoreProgram,
	required: pure (CoreProgram) -> Option[CorePassDiagnostic],
) -> CorePass:
	{ core_program_pass(name, rewrite) | invariant = Some(required) }


-- Lowering hands the pipeline a program that no early pass has touched yet;
-- `lower` exists so that program is observable under its own stage name.
private pure func keep_program(program: CoreProgram) -> CoreProgram:
	program


private pure func run_prune_early_pass(program: CoreProgram) -> CoreProgram:
	prune_program(program)


private pure func run_prune_after_trait_resolve_pass(program: CoreProgram) -> CoreProgram:
	prune_program(program)


private pure func run_desugar_pass(program: CoreProgram) -> CoreProgram:
	CoreEarlyStages.run_desugar_stage(program)


private pure func run_match_pass(program: CoreProgram) -> CoreProgram:
	compile_program(program)


private pure func run_std_inline_pass(program: CoreProgram) -> CoreProgram:
	inline_std_wrappers(program)


private pure func run_tailrec_pass(program: CoreProgram) -> CoreProgram:
	lower_tailrec_program(program)


private pure func run_fuse_string_pass(program: CoreProgram) -> CoreProgram:
	fuse_string_program(program)


private pure func run_fuse_collection_pass(program: CoreProgram) -> CoreProgram:
	fuse_collection_program(program)


private pure func run_fuse_parallel_tensor_pass(program: CoreProgram) -> CoreProgram:
	fuse_parallel_tensor_program(program)


private pure func run_fuse_tensor_update_pass(program: CoreProgram) -> CoreProgram:
	fuse_tensor_update_program(program)


private pure func run_tuple_sroa_pass(program: CoreProgram) -> CoreProgram:
	rewrite_tuple_sroa_program(program)


-- Monomorphization mints declarations, so it is the one pass that advances
-- `next_def_id`. List layout runs with it so the `mono` snapshot shows the
-- laid-out program, exactly as the nested stage chain did.
private pure func run_mono_pass(state: CorePassState) -> Result[CorePassState, CorePassDiagnostic]:
	match monomorphize_program(state.program, state.next_def_id):
		Err(diagnostic):
			Err(CoreEarlyMonoDiagnostic(diagnostic))
		Ok(specialized):
			Ok(
				core_pass_state(
					CoreEarlyStages.run_list_layout_stage(specialized.program),
					specialized.next_def_id,
				),
			)


private pure func run_synth_pass(state: CorePassState) -> Result[CorePassState, CorePassDiagnostic]:
	match synthesize_program(state.program):
		Err(error):
			Err(CoreEarlySynthDiagnostic(error))
		Ok(synthesized):
			Ok({ state | program = synthesized })


private pure func run_trait_resolve_pass(
	state: CorePassState,
) -> Result[CorePassState, CorePassDiagnostic]:
	match resolve_core_traits(state.program):
		Err(diagnostic):
			Err(CoreEarlyTraitResolveDiagnostic(diagnostic))
		Ok(resolved):
			Ok({ state | program = resolved })


-- The first half of the list: everything that runs before the compiler knows
-- which imports resolve to which definitions.
pure func early_core_lowering_passes(
	configuration: CoreEarlyPipelineConfiguration,
) -> List[CorePass]:
	lower_debug_blocks: pure (CoreProgram) -> CoreProgram = func(program):
		CoreEarlyStages.run_debug_stage(program, configuration.debug)

	[
		core_program_pass(LOWER_PASS, keep_program),
		checked_early_pass(DEBUG_PASS, lower_debug_blocks, debug_invariant),
		core_program_pass(PRUNE_EARLY_PASS, run_prune_early_pass),
		checked_early_pass(DESUGAR_PASS, run_desugar_pass, desugar_invariant),
		{ core_pass(MONO_PASS, run_mono_pass) | checked_invariant = Some(mono_invariant) },
		{ core_pass(SYNTH_PASS, run_synth_pass) | checked_invariant = Some(synth_invariant) },
		checked_early_pass(MATCH_PASS, run_match_pass, match_invariant),
		{ core_pass(TRAIT_RESOLVE_PASS, run_trait_resolve_pass) |
			checked_invariant = Some(match_invariant)
		},
		core_program_pass(PRUNE_AFTER_TRAIT_RESOLVE_PASS, run_prune_after_trait_resolve_pass),
	]


-- The second half: import resolution and the fusion set. Only `resolve`,
-- `std_inline`, and `tailrec` are user-visible stages; the fusion rewrites are
-- named so they get their own timing and allocation rows.
pure func early_core_resolution_passes(
	import_bindings: List[CoreResolveImportBinding],
	module_imports: List[CoreResolveModuleImports],
) -> List[CorePass]:
	resolve_imports: pure (CoreProgram) -> CoreProgram = func(program):
		resolve_core_program(program, import_bindings, module_imports)

	[
		required_early_pass(RESOLVE_PASS, resolve_imports, resolve_invariant),
		required_early_pass(STD_INLINE_PASS, run_std_inline_pass, std_inline_invariant),
		required_early_pass(TAILREC_PASS, run_tailrec_pass, std_inline_invariant),
		core_program_pass(FUSE_STRING_PASS, run_fuse_string_pass),
		core_program_pass(FUSE_COLLECTION_PASS, run_fuse_collection_pass),
		core_program_pass(FUSE_PARALLEL_TENSOR_PASS, run_fuse_parallel_tensor_pass),
		core_program_pass(FUSE_TENSOR_UPDATE_PASS, run_fuse_tensor_update_pass),
	]


-- Tuple SROA runs after the caller projects generic templates out, so it is its
-- own list segment rather than a tail of the one above.
pure func early_core_projection_passes() -> List[CorePass]:
	[required_early_pass(TUPLE_SROA_PASS, run_tuple_sroa_pass, std_inline_invariant)]


private pure func early_pass_control(
	configuration: CoreEarlyPipelineConfiguration,
	record_timings: Bool,
) -> CorePassControl:
	{
		observe = configuration.observations.map(early_core_pass_name),
		stop_after = configuration.stop_after.map(early_core_pass_name),
		check_invariants = configuration.check_invariants,
		record_timings = record_timings
	}


private pure func early_observations(
	observations: List[CoreEarlyPipelineObservation],
	pass_observations: List[CorePassObservation],
) -> List[CoreEarlyPipelineObservation]:
	var rendered: List[CoreEarlyPipelineObservation] = observations

	for observation in pass_observations:
		rendered = rendered.append({
			stage_name = early_core_pass_stage_name(observation.name),
			rendered = observation.rendered,
		})

	rendered


private func run_early_pass_segment(
	passes: List[CorePass],
	state: CorePassState,
	observations: List[CoreEarlyPipelineObservation],
	configuration: CoreEarlyPipelineConfiguration,
	record_timings: Bool,
) -> CoreEarlyPipelineExecution:
	match run_core_passes(
		passes,
		state,
		early_pass_control(configuration, record_timings),
	):
		CorePassesCompleted(completed, pass_observations, pass_timings):
			CoreEarlyPipelineCompleted({
				program = completed.program,
				next_def_id = completed.next_def_id,
				observations = early_observations(observations, pass_observations),
				pass_timings = pass_timings,
			})
		CorePassesStopped(pass_name, rendered, pass_observations, pass_timings):
			CoreEarlyPipelineStopped(
				early_core_pass_stage_name(pass_name),
				rendered,
				early_observations(observations, pass_observations),
				pass_timings,
			)
		CorePassesFailed(_, diagnostic, _):
			CoreEarlyPipelineFailed(diagnostic)


func run_early_core_pipeline(
	input: CoreEarlyPipelineInput,
	configuration: CoreEarlyPipelineConfiguration,
	record_timings: Bool,
) -> CoreEarlyPipelineExecution:
	run_early_pass_segment(
		early_core_lowering_passes(configuration),
		core_pass_state(input.program, input.next_def_id),
		[],
		configuration,
		record_timings,
	)


func run_early_core_pipeline_to_runtime_projection(
	input: CoreEarlyPipelineInput,
	configuration: CoreEarlyPipelineConfiguration,
	import_bindings: List[CoreResolveImportBinding],
	module_imports: List[CoreResolveModuleImports],
	record_timings: Bool,
) -> CoreEarlyPipelineExecution:
	passes: List[CorePass] = early_core_lowering_passes(
		configuration,
	).concat(early_core_resolution_passes(import_bindings, module_imports))

	run_early_pass_segment(
		passes,
		core_pass_state(input.program, input.next_def_id),
		[],
		configuration,
		record_timings,
	)


func finish_early_core_pipeline_after_projection(
	output: CoreEarlyPipelineOutput,
	configuration: CoreEarlyPipelineConfiguration,
	record_timings: Bool,
) -> CoreEarlyPipelineExecution:
	run_early_pass_segment(
		early_core_projection_passes(),
		core_pass_state(output.program, output.next_def_id),
		output.observations,
		configuration,
		record_timings,
	)
