-- Questions the body synthesizers (synth_bytes, synth_fixed_point, synth_list,
-- synth_slice, synth_string, synth_hash_collections, synth_float) ask about the
-- Core types and parameters of the function they synthesize. Each used to
-- redeclare a private copy of these; this module holds the byte-identical ones.
import:
	ir: CoreParam, CoreType(NamedType)


--- `typ` is the argument-free named type `expected`.
pure func type_is_named(typ: CoreType, expected: String) -> Bool:
	match typ:
		NamedType(name, args):
			name == expected and args.is_empty()
		_:
			False


--- Parameter `index` of `params` is the argument-free named type `expected`.
pure func param_is_named(params: List[CoreParam], index: Int, expected: String) -> Bool:
	match params.get(index):
		Some(param):
			type_is_named(param.typ, expected)
		None:
			False


--- The element type of a `List[T]`, or `None` for any other type.
pure func list_element_type(typ: CoreType) -> Option[CoreType]:
	match typ:
		NamedType(name, args):
			match args:
				[element_type]:
					if name == "List":
						Some(element_type)
					else:
						None
				_:
					None
		_:
			None
