-- Runtime representation policy for Result[T, E].
--
-- Concrete payloads with known layouts use the stack Result ABI. Generic or
-- otherwise unknown payloads retain the boxed union ABI until specialization
-- can make their storage explicit.
import:
	../stage_08_core_lower/list_layout: CoreLayoutTypeIndex
	c_type_layout: stack_option_runtime_suffix
	ir:
		CoreType(
			InlineRecordType, NativeManagedType, BoxedResultType, UnionType, FunctionType,
			HeapRecordType, NamedType, RangeType, SelfType, StackResultType, TensorType, TupleType,
			TypeParameterType, VoidType,
		),
		CoreUnionValueStorage(ScalarTagValue, ManagedUnionValue),
	specialize_layout: CoreSpecializeLayout, resolve_specialize_type, specialize_type_is_managed
	type_policy: core_type_has_unresolved_parameters


fixed union CoreResultRuntimeRepresentation:
	StackResultRepresentation
	BoxedResultRepresentation


private pure func declared_result_payload_has_known_layout(
	type_index: CoreLayoutTypeIndex,
	name: String,
) -> Bool:
	match type_index.declared_types.get(name):
		Some(UnionType(_, ScalarTagValue)):
			True
		Some(HeapRecordType(_)):
			True
		Some(InlineRecordType(_)):
			True
		Some(UnionType(_, ManagedUnionValue)):
			True
		_:
			False


private pure func result_payload_has_known_layout(
	layout: CoreSpecializeLayout,
	typ: CoreType,
) -> Bool:
	resolved: CoreType = resolve_specialize_type(layout, typ)

	if core_type_has_unresolved_parameters(resolved):
		False
	else:
		match resolved:
			NamedType(name, args):
				-- Result shares the runtime scalar catalog, excluding named Void;
				-- pointer/handle payloads additionally use its immediate slot ABI.
				if (
					args.is_empty()
					and ((
						name != "Void" and stack_option_runtime_suffix(name).is_some()
						or name == "Ptr"
						or name == "Port"
						or name == "ConcurrencyError"
					))
				):
					True
				else:
					(
						specialize_type_is_managed(layout, resolved)
						or declared_result_payload_has_known_layout(layout.types, name)
					)
			TypeParameterType(_) | SelfType:
				False
			NativeManagedType(_) | VoidType | UnionType(_, _) | HeapRecordType(_) | RangeType | InlineRecordType(_):
				True
			FunctionType(_, _, _) | StackResultType(_, _) | BoxedResultType(_, _) | TensorType(_) | TupleType(_):
				True


pure func result_runtime_representation(
	layout: CoreSpecializeLayout,
	ok_type: CoreType,
	err_type: CoreType,
) -> CoreResultRuntimeRepresentation:
	if (
		result_payload_has_known_layout(layout, ok_type)
		and result_payload_has_known_layout(layout, err_type)
	):
		StackResultRepresentation
	else:
		BoxedResultRepresentation
