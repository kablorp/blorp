-- Expression-local specialization for generic option helpers.
--
-- Strict and lazy defaults require explicit let bindings so each source
-- expression is evaluated exactly once and in source order. The caller owns
-- collision-free fusion IDs; this module only constructs one fused expression.
import:
	ir:
		CoreBinderOrigin(PassTemporary),
		CoreCallKind(UnknownCall),
		CoreExpr(CallExpr, LetExpr, LiteralExpr, RawMatchExpr, VarExpr),
		CoreFunction,
		CoreLiteral(BoolLiteral),
		CoreMonoSubstitution,
		CorePattern(ConstructorPattern, NamePattern, WildcardPattern),
		CoreRawMatchCase,
		CoreSourceLoc,
		CoreType(NamedType),
		CoreVar,
		OPTION_FUSION_TEMP_ORIGIN,
		PassTempKind(OptionFusionTemp),
		core_expr_type,
		core_own_source_function_member,
	known_functions:
		CoreKnownFunction(OptionGetOr, OptionGetOrElse, OptionIsNone, OptionIsSome),
		core_known_function,
	mono: apply_type_substitution
	mono_substitute: substitute_core_expr_types


---
The four `option` members this pass fuses: `CoreKnownFunction`'s Option cases,
narrowed to a closed type of their own. The rewriters below match every case with
no wildcard, so a new `option` known function cannot silently fall into a fusion
arm, and a variant of another module cannot reach them.
---
enum CoreMonoOptionFusionTarget:
	OptionFusionIsSome
	OptionFusionIsNone
	OptionFusionGetOr
	OptionFusionGetOrElse


---
Which fusible `option` member `function` is, if it is one. `function` is a
declaration (mono reads the generic templates), so its own origin says which
member it is; a pure variant or instance of one is a different function and is
not fused here.
---
pure func core_option_fusion_target(function: CoreFunction) -> Option[CoreMonoOptionFusionTarget]:
	module_path ?= function.source_module
	member ?= core_own_source_function_member(function)

	match core_known_function(module_path, member):
		Some(OptionIsSome):
			Some(OptionFusionIsSome)
		Some(OptionIsNone):
			Some(OptionFusionIsNone)
		Some(OptionGetOr):
			Some(OptionFusionGetOr)
		Some(OptionGetOrElse):
			Some(OptionFusionGetOrElse)
		_:
			None


private pure func option_payload_type(typ: CoreType) -> Option[CoreType]:
	match typ:
		NamedType(name, args):
			if name == "Option" and args.length() == 1:
				args.get(0)
			else:
				None
		_:
			None


pure func core_option_fusion_supported(
	target: CoreMonoOptionFusionTarget,
	args: List[CoreExpr],
) -> Bool:
	expected_arity: Int = match target:
		OptionFusionIsSome | OptionFusionIsNone:
			1
		OptionFusionGetOr | OptionFusionGetOrElse:
			2

	if args.length() != expected_arity:
		False
	else:
		match args.get(0):
			Some(arg):
				option_payload_type(core_expr_type(arg)).is_some()
			None:
				False


-- The seeded name is unique per fusion site within a function, so the binder
-- carries no id of its own (see `id` on `CoreVar`).
private pure func fusion_var(seed: String, label: String) -> CoreVar:
	{
		name = "__blorp_option_fusion_${seed}_${label}",
		id = 0,
		def_id = None,
		origin = OPTION_FUSION_TEMP_ORIGIN
	}


private pure func bool_literal(value: Bool, loc: CoreSourceLoc) -> CoreExpr:
	LiteralExpr(
		BoolLiteral(value),
		NamedType("Bool", []),
		loc,
	)


private pure func option_presence_match(
	opt: CoreExpr,
	some_value: Bool,
	none_value: Bool,
	loc: CoreSourceLoc,
) -> CoreExpr:
	RawMatchExpr(
		opt,
		[
			{
				pattern = ConstructorPattern("Some", [WildcardPattern]),
				body = bool_literal(some_value, loc)
			},
			{
				pattern = ConstructorPattern("None", []),
				body = bool_literal(none_value, loc)
			},
		],
		NamedType(
			"Bool",
			[],
		),
		loc,
	)


private pure func option_value_match(
	opt_var: CoreVar,
	opt_type: CoreType,
	default_var: CoreVar,
	default_binding_type: CoreType,
	result_type: CoreType,
	lazy_default: Bool,
	loc: CoreSourceLoc,
	fusion_seed: String,
) -> CoreExpr:
	-- Core patterns carry source names rather than CoreVar identities. Match
	-- lowering therefore materializes this binder with id 0; the seeded name
	-- itself provides collision-free identity for synthesized fusion sites.
	value_var: CoreVar = fusion_var(fusion_seed, "value")

	default_expr: CoreExpr = if lazy_default:
		CallExpr(
			UnknownCall,
			VarExpr(default_var, default_binding_type, loc),
			[],
			result_type,
			loc,
		)
	else:
		VarExpr(default_var, result_type, loc)

	RawMatchExpr(
		VarExpr(
			opt_var,
			opt_type,
			loc,
		),
		[
			{
				pattern = ConstructorPattern("Some", [NamePattern(value_var)]),
				body = VarExpr(value_var, result_type, loc)
			},
			{
				pattern = ConstructorPattern("None", []),
				body = default_expr
			},
		],
		result_type,
		loc,
	)


private pure func fuse_bound_option_value(
	opt: CoreExpr,
	default_value: CoreExpr,
	result_type: CoreType,
	lazy_default: Bool,
	loc: CoreSourceLoc,
	fusion_seed: String,
) -> CoreExpr:
	opt_type: CoreType = core_expr_type(opt)
	default_type: CoreType = core_expr_type(default_value)
	opt_var: CoreVar = fusion_var(fusion_seed, "opt")

	default_label: String = if lazy_default:
		"default_fn"
	else:
		"default"

	default_var: CoreVar = fusion_var(fusion_seed, default_label)
	match_expr: CoreExpr = option_value_match(
		opt_var,
		opt_type,
		default_var,
		default_type,
		result_type,
		lazy_default,
		loc,
		fusion_seed,
	)

	LetExpr(
		opt_var,
		False,
		opt_type,
		opt,
		LetExpr(default_var, False, default_type, default_value, match_expr),
	)


pure func fuse_core_option_call(
	target: CoreMonoOptionFusionTarget,
	substitution: CoreMonoSubstitution,
	args: List[CoreExpr],
	result_type: CoreType,
	loc: CoreSourceLoc,
	fusion_seed: String,
) -> Option[CoreExpr]:
	concrete_args: List[CoreExpr] = args.map(
		pure func(arg): substitute_core_expr_types(substitution, arg),
	)
	concrete_result: CoreType = apply_type_substitution(substitution, result_type)

	if not core_option_fusion_supported(target, concrete_args):
		None
	else:
		opt ?= concrete_args.get(0)

		match target:
			OptionFusionIsSome:
				Some(option_presence_match(opt, True, False, loc))
			OptionFusionIsNone:
				Some(option_presence_match(opt, False, True, loc))
			OptionFusionGetOr:
				default_value ?= concrete_args.get(1)
				Some(
					fuse_bound_option_value(
						opt,
						default_value,
						concrete_result,
						False,
						loc,
						fusion_seed,
					),
				)
			OptionFusionGetOrElse:
				default_fn ?= concrete_args.get(1)
				Some(
					fuse_bound_option_value(
						opt,
						default_fn,
						concrete_result,
						True,
						loc,
						fusion_seed,
					),
				)
