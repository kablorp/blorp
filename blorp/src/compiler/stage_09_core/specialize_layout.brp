-- Shared layout facts for post-monomorphization Core specialization.
--
-- Specialization runs after aliases and generic declarations have been
-- materialized. Build the declaration index once and keep representation
-- decisions here so builtin families do not infer layouts independently.
import:
	runtime_callbacks: CoreRuntimeCallbackTable, build_runtime_callback_table, scalar_hash_uses_callbacks
	../stage_08_core_lower/list_layout:
		CoreLayoutTypeIndex,
		build_layout_type_index,
		list_element_needs_release_with_index,
		list_layout_for_type_with_index,
		resolve_layout_type_with_index,
	ir:
		CoreBoxKind(
			Float16Box, Float32Box, FloatBox, Int128Box, PointerBox, PrimBox, StructBox, UInt128Box,
			VoidBox,
		),
		CoreBoxedStorageValue,
		CoreExpr,
		CoreHashContainerConstructor(
			FloatHashContainerConstructor, GenericHashContainerConstructor,
			Int128HashContainerConstructor, StringHashContainerConstructor,
			TraitHashContainerConstructor,
		),
		CoreListStorageLayout,
		CoreProgram,
		CoreTensorTypeInfo,
		CoreType(
			BoxedResultType, EnumType, FunctionType, HeapRecordType, NamedType, RangeType, SelfType,
			StackResultType, TensorType, TupleType, TypeParameterType, UnionType,
			VoidType,
		),
		CoreUnboxKind(
			Float16Unbox, Float32Unbox, FloatUnbox, Int128Unbox, PointerUnbox, PrimUnbox,
			StructUnbox, UInt128Unbox,
		),
		core_expr_type,
	type_policy: ManagedTypeIndex, is_managed_type, is_stack_result_type, managed_type_index


record CoreSpecializeLayout {
	program: CoreProgram,
	types: CoreLayoutTypeIndex,
	managed_types: ManagedTypeIndex,
	runtime_callbacks: CoreRuntimeCallbackTable
}


union CoreOptionRuntimeLayout:
	PrimitiveStackOptionLayout(String)
	NullableManagedOptionLayout
	BoxedOptionLayout
	UnspecializedOptionLayout


enum CoreStreamElementLayout:
	StreamImmediateLayout
	StreamOwnedArcLayout
	StreamBorrowedArcLayout


pure func build_specialize_layout(program: CoreProgram) -> CoreSpecializeLayout:
	{
		program = program,
		types = build_layout_type_index(program),
		managed_types = managed_type_index(program),
		runtime_callbacks = build_runtime_callback_table(program)
	}


pure func resolve_specialize_type(layout: CoreSpecializeLayout, typ: CoreType) -> CoreType:
	resolve_layout_type_with_index(layout.types, typ)


pure func named_type_arguments(
	layout: CoreSpecializeLayout,
	typ: CoreType,
	expected_name: String,
) -> Option[List[CoreType]]:
	match resolve_specialize_type(layout, typ):
		NamedType(name, args):
			if name == expected_name:
				Some(args)
			else:
				None
		_:
			None


pure func single_named_type_argument(
	layout: CoreSpecializeLayout,
	typ: CoreType,
	expected_name: String,
) -> Option[CoreType]:
	args ?= named_type_arguments(layout, typ, expected_name)

	if args.length() == 1:
		args.get(0)
	else:
		None


pure func two_named_type_arguments(
	layout: CoreSpecializeLayout,
	typ: CoreType,
	expected_name: String,
) -> Option[(CoreType, CoreType)]:
	args ?= named_type_arguments(layout, typ, expected_name)

	if args.length() != 2:
		None
	else:
		first ?= args.get(0)
		second ?= args.get(1)
		Some((first, second))


private pure func primitive_option_runtime_suffix(name: String) -> Option[String]:
	if name == "Void":
		Some("void")
	else if name == "Int":
		Some("int")
	else if name == "Int8":
		Some("int8")
	else if name == "Int16":
		Some("int16")
	else if name == "Int32":
		Some("int32")
	else if name == "Int64":
		Some("int64")
	else if name == "UInt8":
		Some("uint8")
	else if name == "UInt16":
		Some("uint16")
	else if name == "UInt32":
		Some("uint32")
	else if name == "UInt64":
		Some("uint64")
	else if name == "Float":
		Some("float")
	else if name == "Float32":
		Some("f32")
	else if name == "Float16":
		Some("f16")
	else if name == "Bool":
		Some("bool")
	else if name == "Char":
		Some("char")
	else:
		None


---
How a Dict or Set must hash and compare keys of one resolved type.

The runtime stores every key in a `void*` slot. Only keys whose slot holds
the value itself, and whose slot equality is value equality, can use the
runtime's word hash. Strings, floats, and 128-bit integers have dedicated
runtime hashers; a 128-bit key is a heap box that the runtime hashes and
compares by payload and owns.
Every other key is boxed or pointer-shaped, so pointer identity would treat
equal values as different keys; those keys hash and compare through the
type's Hashable and Equatable impls.
---
union CoreHashKeyStrategy:
	WordHashKeys
	StringHashKeys
	FloatHashKeys
	Int128HashKeys
	TraitHashKeys


private pure func word_hash_key_type_name(name: String) -> Bool:
	(
		name == "Int"
		or name == "Int8"
		or name == "Int16"
		or name == "Int32"
		or name == "Int64"
		or name == "UInt8"
		or name == "UInt16"
		or name == "UInt32"
		or name == "UInt64"
		or name == "Bool"
		or name == "Char"
		or name == "Ptr"
	)


pure func hash_key_strategy(
	layout: CoreSpecializeLayout,
	key_type: CoreType,
) -> CoreHashKeyStrategy:
	match resolve_specialize_type(layout, key_type):
		NamedType(name, args):
			if not args.is_empty():
				TraitHashKeys
			else if name == "String":
				StringHashKeys
			else if (
				name == "Float"
				or name == "Float32"
				or name == "Float16"
			):
				FloatHashKeys
			else if name == "Int128" or name == "UInt128":
				Int128HashKeys
			else if word_hash_key_type_name(name):
				WordHashKeys
			else:
				TraitHashKeys
		EnumType(name):
			if scalar_hash_uses_callbacks(layout.runtime_callbacks, EnumType(name)):
				TraitHashKeys
			else:
				WordHashKeys
		RangeType:
			WordHashKeys
		_:
			TraitHashKeys


---
The constructor strategy for `key_type`, with trait-hashed keys left unbound.
`hash_key_callbacks.bound_hash_container_constructor` binds them to minted
slot adapters.
---
pure func hash_container_constructor_for_key(
	layout: CoreSpecializeLayout,
	key_type: CoreType,
) -> CoreHashContainerConstructor:
	key: CoreType = resolve_specialize_type(layout, key_type)

	match hash_key_strategy(layout, key):
		WordHashKeys:
			GenericHashContainerConstructor
		StringHashKeys:
			StringHashContainerConstructor
		FloatHashKeys:
			FloatHashContainerConstructor
		Int128HashKeys:
			Int128HashContainerConstructor
		TraitHashKeys:
			TraitHashContainerConstructor(key)


pure func option_payload_runtime_layout(
	layout: CoreSpecializeLayout,
	payload_type: CoreType,
) -> CoreOptionRuntimeLayout:
	payload: CoreType = resolve_specialize_type(layout, payload_type)

	if is_stack_result_type(payload):
		BoxedOptionLayout
	else:
		match payload:
			NamedType("Option", _):
				BoxedOptionLayout
			NamedType("Ptr", []):
				BoxedOptionLayout
			NamedType(name, args):
				if args.is_empty():
					match primitive_option_runtime_suffix(name):
						Some(suffix):
							PrimitiveStackOptionLayout(suffix)
						None:
							if is_managed_type(layout.managed_types, payload):
								NullableManagedOptionLayout
							else:
								UnspecializedOptionLayout
				else if is_managed_type(layout.managed_types, payload):
					NullableManagedOptionLayout
				else:
					UnspecializedOptionLayout
			EnumType(name):
				if name == "Bool":
					PrimitiveStackOptionLayout("bool")
				else:
					UnspecializedOptionLayout
			RangeType:
				UnspecializedOptionLayout
			HeapRecordType(_) | UnionType(_) | TensorType(_) | TupleType(_) | FunctionType(_, _, _):
				NullableManagedOptionLayout
			TypeParameterType(_) | SelfType:
				BoxedOptionLayout
			StackResultType(_, _) | BoxedResultType(_, _):
				BoxedOptionLayout
			VoidType:
				PrimitiveStackOptionLayout("void")


pure func option_runtime_layout(
	layout: CoreSpecializeLayout,
	option_type: CoreType,
) -> Option[CoreOptionRuntimeLayout]:
	payload ?= single_named_type_argument(layout, option_type, "Option")
	Some(option_payload_runtime_layout(layout, payload))


pure func option_runtime_builtin(
	layout: CoreSpecializeLayout,
	option_type: CoreType,
	primitive_base: String,
	nullable_base: String,
	boxed_base: Option[String],
) -> Option[String]:
	match option_runtime_layout(layout, option_type):
		Some(PrimitiveStackOptionLayout(suffix)):
			Some(primitive_base + "_" + suffix)
		Some(NullableManagedOptionLayout):
			Some(nullable_base)
		Some(BoxedOptionLayout):
			boxed_base
		Some(UnspecializedOptionLayout) | None:
			None


pure func specialize_type_is_managed(layout: CoreSpecializeLayout, typ: CoreType) -> Bool:
	is_managed_type(
		layout.managed_types,
		resolve_specialize_type(layout, typ),
	)


pure func specialize_type_is_pointer(layout: CoreSpecializeLayout, typ: CoreType) -> Bool:
	resolved: CoreType = resolve_specialize_type(layout, typ)

	if is_stack_result_type(resolved):
		False
	else:
		match resolved:
			NamedType(name, args):
				if name == "Ptr" and args.is_empty():
					True
				else:
					specialize_type_is_managed(layout, resolved)
			_:
				specialize_type_is_managed(layout, resolved)


pure func boxed_storage_needs_release(layout: CoreSpecializeLayout, typ: CoreType) -> Bool:
	resolved: CoreType = resolve_specialize_type(layout, typ)

	if is_stack_result_type(resolved):
		True
	else:
		match resolved:
			NamedType("Int128", []) | NamedType("UInt128", []):
				True
			_:
				specialize_type_is_managed(layout, resolved)


private pure func stack_option_box_c_type(
	layout: CoreSpecializeLayout,
	payload: CoreType,
) -> Option[String]:
	match resolve_specialize_type(layout, payload):
		VoidType:
			Some("blorp_StackOption_Void")
		NamedType(name, args):
			if (
				args.is_empty()
				and ((
					primitive_option_runtime_suffix(name).is_some()
					or name == "Int128"
					or name == "UInt128"
				))
			):
				Some("blorp_StackOption_${name}")
			else:
				None
		EnumType(name):
			Some("blorp_StackOption_${name}")
		RangeType:
			Some("blorp_StackOption_Range")
		_:
			None


pure func boxed_storage_kind(layout: CoreSpecializeLayout, typ: CoreType) -> CoreBoxKind:
	resolved: CoreType = resolve_specialize_type(layout, typ)

	if is_stack_result_type(resolved):
		StructBox("blorp_StackResult")
	else:
		match resolved:
			VoidType:
				VoidBox
			NamedType("Float", []):
				FloatBox
			NamedType("Float32", []):
				Float32Box
			NamedType("Float16", []):
				Float16Box
			NamedType("Int128", []):
				Int128Box
			NamedType("UInt128", []):
				UInt128Box
			NamedType(name, args):
				match primitive_option_runtime_suffix(name):
					Some(_):
						if args.is_empty():
							PrimBox
						else:
							PointerBox
					None:
						if name == "Option" and args.length() == 1:
							match args.get(0):
								Some(payload):
									match stack_option_box_c_type(layout, payload):
										Some(c_type):
											StructBox(c_type)
										None:
											PointerBox
								None:
									PointerBox
						else:
							PointerBox
			EnumType(_):
				PrimBox
			StackResultType(_, _):
				StructBox("blorp_StackResult")
			BoxedResultType(_, _):
				PointerBox
			RangeType:
				PrimBox
			_:
				PointerBox


pure func boxed_storage_unbox_kind(layout: CoreSpecializeLayout, typ: CoreType) -> CoreUnboxKind:
	match boxed_storage_kind(layout, typ):
		FloatBox:
			FloatUnbox
		Float32Box:
			Float32Unbox
		Float16Box:
			Float16Unbox
		Int128Box:
			Int128Unbox
		UInt128Box:
			UInt128Unbox
		StructBox(c_type):
			StructUnbox(c_type)
		PointerBox:
			PointerUnbox
		PrimBox | VoidBox:
			PrimUnbox


---
True when boxing a value of `typ` into erased storage allocates a fresh
managed box (scalar stack options and results, 128-bit integers)
rather than reusing the value's own pointer or packing its bits into the slot.
The caller that made such a box owns it.
---
pure func boxed_storage_allocates(layout: CoreSpecializeLayout, typ: CoreType) -> Bool:
	match boxed_storage_kind(layout, typ):
		StructBox(_) | Int128Box | UInt128Box:
			True
		PointerBox | PrimBox | VoidBox | FloatBox | Float32Box | Float16Box:
			False


pure func boxed_storage_slot_needs_release(layout: CoreSpecializeLayout, typ: CoreType) -> Bool:
	match boxed_storage_kind(layout, typ):
		StructBox(_) | Int128Box | UInt128Box:
			True
		PointerBox:
			specialize_type_is_managed(layout, typ)
		_:
			False


pure func boxed_storage_value(
	layout: CoreSpecializeLayout,
	value: CoreExpr,
	transfers_ownership: Bool,
) -> CoreBoxedStorageValue:
	value_type: CoreType = core_expr_type(value)
	{
		kind = boxed_storage_kind(layout, value_type),
		value = value,
		needs_release = boxed_storage_slot_needs_release(layout, value_type),
		transfers_ownership = transfers_ownership
	}


pure func list_retain_storage_value(
	layout: CoreSpecializeLayout,
	value: CoreExpr,
) -> CoreBoxedStorageValue:
	value_type: CoreType = core_expr_type(value)
	kind: CoreBoxKind = boxed_storage_kind(layout, value_type)

	needs_release: Bool = match kind:
		PointerBox:
			True
		StructBox(_):
			is_stack_result_type(resolve_specialize_type(layout, value_type))
		_:
			False

	{
		kind = kind,
		value = value,
		needs_release = needs_release,
		transfers_ownership = False
	}


pure func specialize_list_layout(
	layout: CoreSpecializeLayout,
	list_type: CoreType,
) -> CoreListStorageLayout:
	list_layout_for_type_with_index(layout.types, list_type)


pure func specialize_list_element_needs_release(
	layout: CoreSpecializeLayout,
	element_type: CoreType,
) -> Bool:
	list_element_needs_release_with_index(layout.types, element_type)


pure func tensor_type_info(
	layout: CoreSpecializeLayout,
	typ: CoreType,
) -> Option[CoreTensorTypeInfo]:
	match resolve_specialize_type(layout, typ):
		TensorType(info):
			Some(info)
		_:
			None


pure func stream_element_layout_code(element_layout: CoreStreamElementLayout) -> Int:
	match element_layout:
		StreamImmediateLayout:
			0
		StreamBorrowedArcLayout:
			1
		StreamOwnedArcLayout:
			2
