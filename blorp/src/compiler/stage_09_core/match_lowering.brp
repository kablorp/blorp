-- Raw Core pattern-match compilation.
--
-- Direct constructor matches can be eliminated without constructing a decision tree:
-- constructor arguments are already evaluated values, so a matching arm only
-- needs to sequence discarded arguments and bind named arguments. General
-- matches are compiled by the decision-tree portion of this module.
import:
	ir:
		CORE_SYNTHETIC_ID_SEED,
		CoreDecl(UnionDecl, FunctionDecl, GlobalDecl, ImplDecl),
		CoreExpr(
			AssignExpr, BorrowLetExpr, CallExpr, ConcurrentExpr, ConcurrentlyLoopExpr, DropExpr,
			DupExpr, ModuleMemberExpr, ForChannelExpr, ForDictExpr, ForListExpr, ForRangeExpr,
			ForResourceSourceExpr, ForSetExpr, ForStreamExpr, ForStringExpr, ForTensorExpr,
			LambdaExpr, LetExpr, ListHandoffExpr, PreClosureConcurrentExpr,
			PreClosureConcurrentlyLoopExpr, RawMatchExpr, ResourceScopeExpr, SemanticMatchExpr,
			SelectExpr, SeqExpr, TailrecListSpreadLoopExpr, TailrecLoopExpr, TensorRawViewLetExpr,
			VarExpr,
		),
		CoreFunction,
		CoreGlobal,
		CoreImplDecl,
		CoreLiteral(
			BoolLiteral, CharLiteral, FloatInfinityLiteral, FloatLiteral, FloatNanLiteral,
			FloatNegInfinityLiteral, FloatTextLiteral, IntLiteral, StringLiteral, WideIntLiteral,
		),
		CoreMatchBindingMode(MatchBorrowBindingMode, MatchOwnBindingMode),
		CoreMapState,
		CoreParam,
		CorePattern(
			ConstructorPattern, ListPattern, NamePattern, OrPattern, QualifiedConstructorPattern,
			TuplePattern, WildcardPattern,
		),
		CoreProgram,
		CoreRawMatchCase,
		CoreSelectArmKind(SelectAfterArm, SelectRecvArm, SelectSealedArm),
		CoreSemanticConstructorMatchCase,
		CoreSemanticLengthMatchCase,
		CoreSemanticLengthMatchGeq,
		CoreSemanticLiteralMatchCase,
		CoreSemanticMatchAccessor(
			ListElementSemanticMatchAccessor, ListSpreadSemanticMatchAccessor,
			RootSemanticMatchAccessor, ProductFieldSemanticMatchAccessor,
			VariantFieldSemanticMatchAccessor,
		),
		CoreSemanticMatchBinding,
		CoreSemanticMatchTree(
			SemanticConstructorMatch, SemanticLengthMatch, SemanticLiteralMatch, SemanticMatchFail,
			SemanticMatchLeaf,
		),
		CoreVar,
		core_expr_type,
		core_field_ordinal,
		core_var_equal,
	set as Sets
	synth_nodes: core_var
	traverse as CoreTraverse


---
`original` is matched with `core_var_equal` (name and id), so a use is
only substituted once its own binder inside the same clone has already
been renamed -- exactly `std_inline.brp`'s `renamed_var`/`rename_binder`
pattern, scaled down to the binder shapes lowering itself can produce
(a raw match arm body predates every later pass that mints the rest,
e.g. `ListHandoffExpr`, so this does not need to cover them).
---
private record CoreMatchCloneRename {
	original: CoreVar,
	replacement: CoreVar
}


private record CoreMatchCloneState {
	next_id: Int,
	renames: List[CoreMatchCloneRename]
}


private pure func match_clone_lookup(
	renames: List[CoreMatchCloneRename],
	variable: CoreVar,
) -> CoreVar:
	var replacement: CoreVar = variable

	for rename in renames:
		if core_var_equal(rename.original, variable):
			replacement = rename.replacement
		else:
			void

	replacement


private pure func match_clone_bind(
	state: CoreMatchCloneState,
	variable: CoreVar,
) -> (CoreMatchCloneState, CoreVar):
	next: Int = state.next_id + 1
	fresh: CoreVar = { variable | id = next }
	({
			next_id = next,
			renames = [
				{
					original = variable,
					replacement = fresh
				},
			].concat(state.renames)
		}, fresh)


private pure func match_clone_expr(
	state: CoreMatchCloneState,
	expr: CoreExpr,
) -> CoreMapState[CoreMatchCloneState, CoreExpr]:
	match expr:
		VarExpr(variable, typ, loc):
			{
				state = state,
				value = VarExpr(
					match_clone_lookup(state.renames, variable),
					typ,
					loc,
				)
			}
		AssignExpr(variable, rhs, typ, loc):
			-- The target is a use of an earlier binder in this clone, so it
			-- follows that binder's fresh id like a `VarExpr` does.
			rhs_result: CoreMapState[CoreMatchCloneState, CoreExpr] = match_clone_expr(
				state,
				rhs,
			)
			{
				state = rhs_result.state,
				value = AssignExpr(
					match_clone_lookup(rhs_result.state.renames, variable),
					rhs_result.value,
					typ,
					loc,
				)
			}
		LetExpr(variable, is_mutable, typ, rhs, body):
			rhs_result: CoreMapState[CoreMatchCloneState, CoreExpr] = match_clone_expr(
				state,
				rhs,
			)
			bound: (CoreMatchCloneState, CoreVar) = match_clone_bind(rhs_result.state, variable)
			body_result: CoreMapState[CoreMatchCloneState, CoreExpr] = match_clone_expr(
				bound[0],
				body,
			)
			{
				state = body_result.state,
				value = LetExpr(bound[1], is_mutable, typ, rhs_result.value, body_result.value)
			}
		BorrowLetExpr(variable, typ, rhs, body):
			rhs_result: CoreMapState[CoreMatchCloneState, CoreExpr] = match_clone_expr(
				state,
				rhs,
			)
			bound: (CoreMatchCloneState, CoreVar) = match_clone_bind(rhs_result.state, variable)
			body_result: CoreMapState[CoreMatchCloneState, CoreExpr] = match_clone_expr(
				bound[0],
				body,
			)
			{
				state = body_result.state,
				value = BorrowLetExpr(bound[1], typ, rhs_result.value, body_result.value)
			}
		LambdaExpr(params, return_type, body, is_pure, typ, loc):
			var current_state: CoreMatchCloneState = state
			var renamed_params: List[CoreParam] = []

			for param in params:
				bound: (CoreMatchCloneState, CoreVar) = match_clone_bind(current_state, param.name)
				current_state = bound[0]
				renamed_params = renamed_params.append({ param | name = bound[1] })

			body_result: CoreMapState[CoreMatchCloneState, CoreExpr] = match_clone_expr(
				current_state,
				body,
			)
			{
				state = body_result.state,
				value = LambdaExpr(
					renamed_params,
					return_type,
					body_result.value,
					is_pure,
					typ,
					loc,
				)
			}
		ForRangeExpr(binder, start, finish, body, typ, loc):
			start_result: CoreMapState[CoreMatchCloneState, CoreExpr] = match_clone_expr(
				state,
				start,
			)
			finish_result: CoreMapState[CoreMatchCloneState, CoreExpr] = match_clone_expr(
				start_result.state,
				finish,
			)
			bound: (CoreMatchCloneState, CoreVar) = match_clone_bind(
				finish_result.state,
				binder.variable,
			)
			body_result: CoreMapState[CoreMatchCloneState, CoreExpr] = match_clone_expr(
				bound[0],
				body,
			)
			{
				state = body_result.state,
				value = ForRangeExpr(
					{ binder | variable = bound[1] },
					start_result.value,
					finish_result.value,
					body_result.value,
					typ,
					loc,
				)
			}
		ForListExpr(loop, typ, loc):
			iterable_result: CoreMapState[CoreMatchCloneState, CoreExpr] = match_clone_expr(
				state,
				loop.iterable,
			)
			bound: (CoreMatchCloneState, CoreVar) = match_clone_bind(
				iterable_result.state,
				loop.binder.variable,
			)
			body_result: CoreMapState[CoreMatchCloneState, CoreExpr] = match_clone_expr(
				bound[0],
				loop.body,
			)
			{
				state = body_result.state,
				value = ForListExpr(
					{ loop |
						binder = { loop.binder | variable = bound[1] },
						iterable = iterable_result.value,
						body = body_result.value
					},
					typ,
					loc,
				)
			}
		ForStringExpr(loop, typ, loc):
			iterable_result: CoreMapState[CoreMatchCloneState, CoreExpr] = match_clone_expr(
				state,
				loop.iterable,
			)
			bound: (CoreMatchCloneState, CoreVar) = match_clone_bind(
				iterable_result.state,
				loop.binder.variable,
			)
			body_result: CoreMapState[CoreMatchCloneState, CoreExpr] = match_clone_expr(
				bound[0],
				loop.body,
			)
			{
				state = body_result.state,
				value = ForStringExpr(
					{ loop |
						binder = { loop.binder | variable = bound[1] },
						iterable = iterable_result.value,
						body = body_result.value
					},
					typ,
					loc,
				)
			}
		ForDictExpr(loop, typ, loc):
			iterable_result: CoreMapState[CoreMatchCloneState, CoreExpr] = match_clone_expr(
				state,
				loop.iterable,
			)
			bound: (CoreMatchCloneState, CoreVar) = match_clone_bind(
				iterable_result.state,
				loop.binder.variable,
			)
			body_result: CoreMapState[CoreMatchCloneState, CoreExpr] = match_clone_expr(
				bound[0],
				loop.body,
			)
			{
				state = body_result.state,
				value = ForDictExpr(
					{ loop |
						binder = { loop.binder | variable = bound[1] },
						iterable = iterable_result.value,
						body = body_result.value
					},
					typ,
					loc,
				)
			}
		ForSetExpr(loop, typ, loc):
			iterable_result: CoreMapState[CoreMatchCloneState, CoreExpr] = match_clone_expr(
				state,
				loop.iterable,
			)
			bound: (CoreMatchCloneState, CoreVar) = match_clone_bind(
				iterable_result.state,
				loop.binder.variable,
			)
			body_result: CoreMapState[CoreMatchCloneState, CoreExpr] = match_clone_expr(
				bound[0],
				loop.body,
			)
			{
				state = body_result.state,
				value = ForSetExpr(
					{ loop |
						binder = { loop.binder | variable = bound[1] },
						iterable = iterable_result.value,
						body = body_result.value
					},
					typ,
					loc,
				)
			}
		ForStreamExpr(loop, typ, loc):
			iterable_result: CoreMapState[CoreMatchCloneState, CoreExpr] = match_clone_expr(
				state,
				loop.iterable,
			)
			bound: (CoreMatchCloneState, CoreVar) = match_clone_bind(
				iterable_result.state,
				loop.binder.variable,
			)
			body_result: CoreMapState[CoreMatchCloneState, CoreExpr] = match_clone_expr(
				bound[0],
				loop.body,
			)
			{
				state = body_result.state,
				value = ForStreamExpr(
					{ loop |
						binder = { loop.binder | variable = bound[1] },
						iterable = iterable_result.value,
						body = body_result.value
					},
					typ,
					loc,
				)
			}
		ForResourceSourceExpr(loop, typ, loc):
			iterable_result: CoreMapState[CoreMatchCloneState, CoreExpr] = match_clone_expr(
				state,
				loop.iterable,
			)
			bound: (CoreMatchCloneState, CoreVar) = match_clone_bind(
				iterable_result.state,
				loop.binder.variable,
			)
			body_result: CoreMapState[CoreMatchCloneState, CoreExpr] = match_clone_expr(
				bound[0],
				loop.body,
			)
			{
				state = body_result.state,
				value = ForResourceSourceExpr(
					{ loop |
						binder = { loop.binder | variable = bound[1] },
						iterable = iterable_result.value,
						body = body_result.value
					},
					typ,
					loc,
				)
			}
		ForTensorExpr(loop, typ, loc):
			iterable_result: CoreMapState[CoreMatchCloneState, CoreExpr] = match_clone_expr(
				state,
				loop.iterable,
			)
			bound: (CoreMatchCloneState, CoreVar) = match_clone_bind(
				iterable_result.state,
				loop.binder.variable,
			)
			body_result: CoreMapState[CoreMatchCloneState, CoreExpr] = match_clone_expr(
				bound[0],
				loop.body,
			)
			{
				state = body_result.state,
				value = ForTensorExpr(
					{ loop |
						binder = { loop.binder | variable = bound[1] },
						iterable = iterable_result.value,
						body = body_result.value
					},
					typ,
					loc,
				)
			}
		ResourceScopeExpr(scope, typ, loc):
			acquire_result: CoreMapState[CoreMatchCloneState, CoreExpr] = match_clone_expr(
				state,
				scope.acquire,
			)
			bound: (CoreMatchCloneState, CoreVar) = match_clone_bind(
				acquire_result.state,
				scope.variable,
			)
			body_result: CoreMapState[CoreMatchCloneState, CoreExpr] = match_clone_expr(
				bound[0],
				scope.body,
			)
			cleanup_result: CoreMapState[CoreMatchCloneState, CoreExpr] = match_clone_expr(
				body_result.state,
				scope.cleanup,
			)
			{
				state = cleanup_result.state,
				value = ResourceScopeExpr(
					{ scope |
						variable = bound[1],
						acquire = acquire_result.value,
						body = body_result.value,
						cleanup = cleanup_result.value
					},
					typ,
					loc,
				)
			}
		_:
			CoreTraverse.map_core_expr_children_with_state(state, match_clone_expr, expr)


---
Clones `body`, minting a fresh id (from the shared `next_id` allocator,
threaded from `compile_expr_at`) for every binder it introduces while
keeping every name exactly as it was, so generated C stays byte-identical.
---
private pure func clone_match_arm_body(next_id: Int, body: CoreExpr) -> (Int, CoreExpr):
	result: CoreMapState[CoreMatchCloneState, CoreExpr] = match_clone_expr(
		{
			next_id = next_id,
			renames = []
		},
		body,
	)
	(result.state.next_id, result.value)


private BUILTIN_CONSTRUCTOR_NAMES: List[String] = [
	"Some",
	"None",
	"Ok",
	"Err",
	"True",
	"False",
	"Timeout",
	"TaskFailed",
	"Cancelled",
]


private union DirectConstructorPayload:
	DiscardDirectConstructorPayload
	BindDirectConstructorPayload(CoreVar)


private fixed union MatchCaseShape:
	CatchallMatchCases
	LiteralMatchCases
	ConstructorMatchCases
	TupleMatchCases
	ListMatchCases
	UnsupportedMatchCases


private union PatternMatrixAccessorKind:
	TuplePatternMatrixAccessors
	ListPatternMatrixAccessors
	VariantPatternMatrixAccessors(String)
	ExplicitPatternMatrixAccessors(List[CoreSemanticMatchAccessor])


private record ConstructorCaseGroup {
	constructor: String,
	arms: List[PatternMatrixArm]
}


private record ConstructorCaseGroups {
	ordered: List[ConstructorCaseGroup],
	index_by_constructor: Dict[String, Int]
}


private record PatternMatrixArm {
	patterns: List[CorePattern],
	bindings: List[CoreSemanticMatchBinding],
	body: CoreSemanticMatchTree
}


private union ListPatternSequenceArm:
	ExactListPatternArm(PatternMatrixArm)
	SpreadListPatternArm(PatternMatrixArm)
	CatchallListPatternArm(List[CoreSemanticMatchBinding], CoreSemanticMatchTree)


private record ScopedCoreExpr {
	expr: CoreExpr,
	target_shadowed: Bool
}


private record SplitMatchCases {
	tested: List[CoreRawMatchCase],
	fallback: Option[CoreRawMatchCase]
}


pure func collect_match_constructor_names(program: CoreProgram) -> Set[String]:
	var names: Set[String] = Sets.from_list(BUILTIN_CONSTRUCTOR_NAMES)

	for decl in program.decls:
		match decl:
			UnionDecl(union_decl):
				for variant in union_decl.variants:
					names = Sets.add(names, variant.name)
			_:
				void

	names


pure func normalize_match_pattern(constructors: Set[String], pattern: CorePattern) -> CorePattern:
	match pattern:
		NamePattern(variable):
			if Sets.contains(constructors, variable.name):
				ConstructorPattern(variable.name, [])
			else:
				pattern
		ConstructorPattern(name, args):
			ConstructorPattern(
				name,
				args.map(func(arg): normalize_match_pattern(constructors, arg)),
			)
		QualifiedConstructorPattern(module_name, name, args):
			QualifiedConstructorPattern(
				module_name,
				name,
				args.map(func(arg): normalize_match_pattern(constructors, arg)),
			)
		TuplePattern(items):
			TuplePattern(items.map(
				func(item): normalize_match_pattern(constructors, item),
			))
		ListPattern(items, spread):
			ListPattern(
				items.map(func(item): normalize_match_pattern(constructors, item)),
				spread.map(func(item): normalize_match_pattern(constructors, item)),
			)
		OrPattern(items):
			OrPattern(items.map(
				func(item): normalize_match_pattern(constructors, item),
			))
		_:
			pattern


pure func normalize_match_cases(
	constructors: Set[String],
	cases: List[CoreRawMatchCase],
) -> List[CoreRawMatchCase]:
	cases.map(
		func(
			match_case,
		): { match_case | pattern = normalize_match_pattern(constructors, match_case.pattern) },
	)


private pure func expand_or_match_case(match_case: CoreRawMatchCase) -> List[CoreRawMatchCase]:
	match match_case.pattern:
		OrPattern(patterns):
			patterns.map(func(pattern): {
					pattern = pattern,
					body = match_case.body
				})
		_:
			[match_case]


private pure func expand_or_match_cases(cases: List[CoreRawMatchCase]) -> List[CoreRawMatchCase]:
	cases.flat_map(expand_or_match_case)


---
Same expansion as `expand_or_match_case`, except every alternative after
the first gets its own clone of `body` with fresh binder ids (see
`clone_match_arm_body`) instead of sharing the original's identity.
---
private pure func expand_or_match_case_at(
	next_id: Int,
	match_case: CoreRawMatchCase,
) -> (Int, List[CoreRawMatchCase]):
	match match_case.pattern:
		OrPattern(patterns):
			var current_id: Int = next_id
			var expanded: List[CoreRawMatchCase] = []
			var index: Int = 0

			for pattern in patterns:
				body: CoreExpr = if index == 0:
					match_case.body
				else:
					cloned: (Int, CoreExpr) = clone_match_arm_body(current_id, match_case.body)
					current_id = cloned[0]
					cloned[1]

				expanded = expanded.append({
					pattern = pattern,
					body = body,
				})
				index += 1

			(current_id, expanded)
		_:
			(next_id, [match_case])


private pure func expand_or_match_cases_at(
	next_id: Int,
	cases: List[CoreRawMatchCase],
) -> (Int, List[CoreRawMatchCase]):
	var current_id: Int = next_id
	var expanded: List[CoreRawMatchCase] = []

	for match_case in cases:
		result: (Int, List[CoreRawMatchCase]) = expand_or_match_case_at(current_id, match_case)
		current_id = result[0]
		expanded = expanded.concat(result[1])

	(current_id, expanded)


private pure func constructor_name_of_callee(
	constructors: Set[String],
	callee: CoreExpr,
) -> Option[String]:
	match callee:
		VarExpr(variable, _, _):
			if Sets.contains(constructors, variable.name):
				Some(variable.name)
			else:
				None
		ModuleMemberExpr(_, member, _, _):
			if Sets.contains(constructors, member):
				Some(member)
			else:
				None
		_:
			None


private pure func direct_constructor_scrutinee(
	constructors: Set[String],
	scrutinee: CoreExpr,
) -> Option[(String, List[CoreExpr])]:
	match scrutinee:
		CallExpr(_kind, callee, args, _typ, _loc):
			name ?= constructor_name_of_callee(constructors, callee)
			Some((name, args))
		_:
			None


private pure func direct_constructor_payload(
	pattern: CorePattern,
) -> Option[DirectConstructorPayload]:
	match pattern:
		WildcardPattern:
			Some(DiscardDirectConstructorPayload)
		NamePattern(variable):
			if variable.name == "_":
				Some(DiscardDirectConstructorPayload)
			else:
				Some(BindDirectConstructorPayload(variable))
		_:
			None


private pure func simple_constructor_payloads(
	constructor_name: String,
	args: List[CoreExpr],
	pattern: CorePattern,
) -> Option[List[DirectConstructorPayload]]:
	var patterns: List[CorePattern] = []
	var matching_constructor: Bool = False

	match pattern:
		ConstructorPattern(name, payload_patterns):
			if name == constructor_name:
				patterns = payload_patterns
				matching_constructor = True
		QualifiedConstructorPattern(_, name, payload_patterns):
			if name == constructor_name:
				patterns = payload_patterns
				matching_constructor = True
		_:
			void

	if not matching_constructor or patterns.length() != args.length():
		None
	else:
		var payloads: List[DirectConstructorPayload] = []
		var failed: Bool = False

		for payload_pattern in patterns:
			match direct_constructor_payload(payload_pattern):
				Some(payload):
					payloads = payloads.append(payload)
				None:
					failed = True
					break

		if failed:
			None
		else:
			Some(payloads)


private pure func sequence_constructor_args(
	args: List[CoreExpr],
	body: CoreExpr,
) -> Option[CoreExpr]:
	var result: CoreExpr = body
	var index: Int = args.length()
	var failed: Bool = False

	while index > 0:
		index -= 1

		match args.get(index):
			Some(arg):
				result = SeqExpr(arg, result)
			None:
				failed = True
				break

	if failed:
		None
	else:
		Some(result)


private pure func bind_constructor_payloads(
	payloads: List[DirectConstructorPayload],
	args: List[CoreExpr],
	body: CoreExpr,
) -> Option[CoreExpr]:
	if payloads.length() != args.length():
		None
	else:
		var result: CoreExpr = body
		var index: Int = args.length()
		var failed: Bool = False

		while index > 0:
			index -= 1

			match (payloads.get(index), args.get(index)):
				(Some(payload), Some(arg)):
					match payload:
						DiscardDirectConstructorPayload:
							result = SeqExpr(arg, result)
						BindDirectConstructorPayload(variable):
							result = LetExpr(variable, False, core_expr_type(arg), arg, result)
				_:
					failed = True
					break

		if failed:
			None
		else:
			Some(result)


private pure func pattern_constructor_name(pattern: CorePattern) -> Option[String]:
	match pattern:
		ConstructorPattern(name, _):
			Some(name)
		QualifiedConstructorPattern(_, name, _):
			Some(name)
		_:
			None


pure func try_fuse_direct_constructor_match(
	constructors: Set[String],
	scrutinee: CoreExpr,
	cases: List[CoreRawMatchCase],
) -> Option[CoreExpr]:
	scrutinee_info ?= direct_constructor_scrutinee(constructors, scrutinee)
	constructor_name: String = scrutinee_info[0]
	args: List[CoreExpr] = scrutinee_info[1]

	var result: Option[CoreExpr] = None
	var decided: Bool = False

	for match_case in expand_or_match_cases(cases):
		if not decided:
			match simple_constructor_payloads(constructor_name, args, match_case.pattern):
				Some(payloads):
					result = bind_constructor_payloads(payloads, args, match_case.body)
					decided = True
				None:
					match pattern_constructor_name(match_case.pattern):
						Some(name):
							if name == constructor_name:
								decided = True
						None:
							match match_case.pattern:
								WildcardPattern:
									result = sequence_constructor_args(args, match_case.body)
									decided = True
								_:
									void

	result


private pure func is_catchall_pattern(pattern: CorePattern) -> Bool:
	match pattern:
		NamePattern(_) | WildcardPattern:
			True
		_:
			False


private pure func catchall_binding(
	pattern: CorePattern,
	accessor: CoreSemanticMatchAccessor,
) -> List[CoreSemanticMatchBinding]:
	match pattern:
		NamePattern(variable):
			[
				{
					variable = variable,
					accessor = accessor,
					mode = MatchBorrowBindingMode
				},
			]
		_:
			[]


private pure func catchall_leaf(pattern: CorePattern, body: CoreExpr) -> CoreSemanticMatchTree:
	SemanticMatchLeaf(
		catchall_binding(pattern, RootSemanticMatchAccessor),
		body,
	)


private pure func semantic_binding(
	variable: CoreVar,
	accessor: CoreSemanticMatchAccessor,
) -> CoreSemanticMatchBinding:
	mode: CoreMatchBindingMode = match accessor:
		ListSpreadSemanticMatchAccessor(_, _):
			MatchOwnBindingMode
		_:
			MatchBorrowBindingMode

	{
		variable = variable,
		accessor = accessor,
		mode = mode
	}


private union PatternBindingSequence:
	NoPatternBindings
	PatternBindingThen(CoreSemanticMatchBinding, PatternBindingSequence)


private pure func prepend_pattern_bindings(
	bindings: PatternBindingSequence,
	accessor: CoreSemanticMatchAccessor,
	pattern: CorePattern,
) -> PatternBindingSequence:
	match pattern:
		NamePattern(variable):
			PatternBindingThen(
				semantic_binding(variable, accessor),
				bindings,
			)
		ConstructorPattern(constructor, patterns):
			var result: PatternBindingSequence = bindings
			var index: Int = patterns.length()

			while index > 0:
				index -= 1

				match patterns.get(index):
					Some(nested_pattern):
						result = prepend_pattern_bindings(
							result,
							VariantFieldSemanticMatchAccessor(accessor, constructor, index),
							nested_pattern,
						)
					None:
						void

			result
		QualifiedConstructorPattern(_, constructor, patterns):
			var result: PatternBindingSequence = bindings
			var index: Int = patterns.length()

			while index > 0:
				index -= 1

				match patterns.get(index):
					Some(nested_pattern):
						result = prepend_pattern_bindings(
							result,
							VariantFieldSemanticMatchAccessor(accessor, constructor, index),
							nested_pattern,
						)
					None:
						void

			result
		TuplePattern(patterns):
			var result: PatternBindingSequence = bindings
			var index: Int = patterns.length()

			while index > 0:
				index -= 1

				match patterns.get(index):
					Some(nested_pattern):
						result = prepend_pattern_bindings(
							result,
							ProductFieldSemanticMatchAccessor(accessor, core_field_ordinal(index)),
							nested_pattern,
						)
					None:
						void

			result
		ListPattern(patterns, spread):
			var result: PatternBindingSequence = match spread:
				Some(NamePattern(variable)):
					PatternBindingThen(
						semantic_binding(
							variable,
							ListSpreadSemanticMatchAccessor(accessor, patterns.length()),
						),
						bindings,
					)
				_:
					bindings

			var index: Int = patterns.length()

			while index > 0:
				index -= 1

				match patterns.get(index):
					Some(nested_pattern):
						result = prepend_pattern_bindings(
							result,
							ListElementSemanticMatchAccessor(accessor, index),
							nested_pattern,
						)
					None:
						void

			result
		WildcardPattern | LiteralPattern(_) | OrPattern(_):
			bindings


private pure func pattern_binding_sequence_to_list(
	sequence: PatternBindingSequence,
) -> List[CoreSemanticMatchBinding]:
	var bindings: List[CoreSemanticMatchBinding] = []
	var remaining: PatternBindingSequence = sequence
	var done: Bool = False

	while not done:
		match remaining:
			NoPatternBindings:
				done = True
			PatternBindingThen(binding, rest):
				bindings = bindings.append(binding)
				remaining = rest

	bindings


private pure func collect_pattern_bindings(
	accessor: CoreSemanticMatchAccessor,
	pattern: CorePattern,
) -> List[CoreSemanticMatchBinding]:
	pattern_binding_sequence_to_list(prepend_pattern_bindings(NoPatternBindings, accessor, pattern))


private pure func prepend_semantic_bindings(
	tree: CoreSemanticMatchTree,
	bindings: List[CoreSemanticMatchBinding],
) -> CoreSemanticMatchTree:
	if bindings.is_empty():
		tree
	else:
		match tree:
			SemanticMatchLeaf(existing, body):
				SemanticMatchLeaf(
					bindings.concat(existing),
					body,
				)
			SemanticMatchFail:
				SemanticMatchFail
			SemanticConstructorMatch(accessor, cases, fallback):
				SemanticConstructorMatch(
					accessor,
					cases.map(
						func(
							match_case,
						): { match_case |
							body = prepend_semantic_bindings(match_case.body, bindings)
						},
					),
					fallback.map(func(found): prepend_semantic_bindings(found, bindings)),
				)
			SemanticLiteralMatch(accessor, cases, fallback):
				SemanticLiteralMatch(
					accessor,
					cases.map(
						func(
							match_case,
						): { match_case |
							body = prepend_semantic_bindings(match_case.body, bindings)
						},
					),
					prepend_semantic_bindings(fallback, bindings),
				)
			SemanticLengthMatch(accessor, cases, geq, fallback):
				SemanticLengthMatch(
					accessor,
					cases.map(
						func(
							match_case,
						): { match_case |
							body = prepend_semantic_bindings(match_case.body, bindings)
						},
					),
					geq.map(
						func(
							found,
						): { found | body = prepend_semantic_bindings(found.body, bindings) },
					),
					fallback.map(func(found): prepend_semantic_bindings(found, bindings)),
				)


private pure func replace_semantic_match_fail(
	tree: CoreSemanticMatchTree,
	fallback: CoreSemanticMatchTree,
) -> CoreSemanticMatchTree:
	match tree:
		SemanticMatchLeaf(_, _):
			tree
		SemanticMatchFail:
			fallback
		SemanticConstructorMatch(accessor, cases, existing_fallback):
			SemanticConstructorMatch(
				accessor,
				cases.map(
					func(
						match_case,
					): { match_case |
						body = replace_semantic_match_fail(match_case.body, fallback)
					},
				),
				Some(
					existing_fallback
						.map(func(found): replace_semantic_match_fail(found, fallback))
						.get_or(fallback),
				),
			)
		SemanticLiteralMatch(accessor, cases, existing_fallback):
			SemanticLiteralMatch(
				accessor,
				cases.map(
					func(
						match_case,
					): { match_case |
						body = replace_semantic_match_fail(match_case.body, fallback)
					},
				),
				replace_semantic_match_fail(existing_fallback, fallback),
			)
		SemanticLengthMatch(accessor, cases, geq, existing_fallback):
			SemanticLengthMatch(
				accessor,
				cases.map(
					func(
						match_case,
					): { match_case |
						body = replace_semantic_match_fail(match_case.body, fallback)
					},
				),
				geq.map(
					func(
						found,
					): { found | body = replace_semantic_match_fail(found.body, fallback) },
				),
				Some(
					existing_fallback
						.map(func(found): replace_semantic_match_fail(found, fallback))
						.get_or(fallback),
				),
			)


private pure func semantic_match_tree_name_may_occur_free(
	tree: CoreSemanticMatchTree,
	name: String,
) -> Bool:
	match tree:
		SemanticMatchLeaf(bindings, body):
			if bindings.any(func(binding): binding.variable.name == name):
				False
			else:
				core_name_may_occur_free(name, body)
		SemanticMatchFail:
			False
		SemanticConstructorMatch(_, cases, fallback):
			(
				cases.any(
					func(
						match_case,
					): semantic_match_tree_name_may_occur_free(match_case.body, name),
				)
				or fallback
					.map(func(found): semantic_match_tree_name_may_occur_free(found, name))
					.get_or(False)
			)
		SemanticLiteralMatch(_, cases, fallback):
			(
				cases.any(
					func(
						match_case,
					): semantic_match_tree_name_may_occur_free(match_case.body, name),
				)
				or semantic_match_tree_name_may_occur_free(fallback, name)
			)
		SemanticLengthMatch(_, cases, geq, fallback):
			(
				cases.any(
					func(
						match_case,
					): semantic_match_tree_name_may_occur_free(match_case.body, name),
				)
				or geq
					.map(func(found): semantic_match_tree_name_may_occur_free(found.body, name))
					.get_or(False)
				or fallback
					.map(func(found): semantic_match_tree_name_may_occur_free(found, name))
					.get_or(False)
			)


private pure func match_case_shape(cases: List[CoreRawMatchCase]) -> MatchCaseShape:
	if cases.is_empty():
		UnsupportedMatchCases
	else:
		var single_catchall: Bool = False

		if cases.length() == 1:
			match cases.get(0):
				Some(match_case):
					single_catchall = is_catchall_pattern(match_case.pattern)
				None:
					void

		if single_catchall:
			CatchallMatchCases
		else:
			var tested_count: Int = cases.length()

			match cases.get(cases.length() - 1):
				Some(last_case):
					if is_catchall_pattern(last_case.pattern):
						tested_count -= 1
				None:
					void

			var all_literals: Bool = tested_count > 0
			var all_constructors: Bool = tested_count > 0
			var all_tuples: Bool = tested_count > 0
			var all_lists: Bool = tested_count > 0
			var index: Int = 0

			while index < tested_count:
				match cases.get(index):
					Some(match_case):
						match match_case.pattern:
							LiteralPattern(_):
								all_constructors = False
								all_tuples = False
								all_lists = False
							ConstructorPattern(_, _) | QualifiedConstructorPattern(_, _, _):
								all_literals = False
								all_tuples = False
								all_lists = False
							TuplePattern(_):
								all_literals = False
								all_constructors = False
								all_lists = False
							ListPattern(_, _):
								all_literals = False
								all_constructors = False
								all_tuples = False
							_:
								all_literals = False
								all_constructors = False
								all_tuples = False
								all_lists = False
					None:
						all_literals = False
						all_constructors = False
						all_tuples = False
						all_lists = False

				index += 1

			if all_literals:
				LiteralMatchCases
			else if all_constructors:
				ConstructorMatchCases
			else if all_tuples:
				TupleMatchCases
			else if all_lists:
				ListMatchCases
			else:
				UnsupportedMatchCases


private pure func split_trailing_catchall(cases: List[CoreRawMatchCase]) -> SplitMatchCases:
	if cases.is_empty():
		{
			tested = [],
			fallback = None
		}
	else:
		match cases.get(cases.length() - 1):
			Some(last_case):
				if is_catchall_pattern(last_case.pattern):
					{
						tested = cases.take(cases.length() - 1),
						fallback = Some(last_case)
					}
				else:
					{
						tested = cases,
						fallback = None
					}
			None:
				{
					tested = cases,
					fallback = None
				}


private pure func constructor_pattern_parts(
	pattern: CorePattern,
) -> Option[(String, List[CorePattern])]:
	match pattern:
		ConstructorPattern(name, patterns):
			Some((name, patterns))
		QualifiedConstructorPattern(_, name, patterns):
			Some((name, patterns))
		_:
			None


private pure func group_constructor_cases(
	cases: List[CoreRawMatchCase],
) -> Option[List[ConstructorCaseGroup]]:
	var groups: ConstructorCaseGroups = {
		ordered = [],
		index_by_constructor = {}
	}
	var failed: Bool = False

	for match_case in cases:
		match constructor_pattern_parts(match_case.pattern):
			Some(parts):
				constructor: String = parts[0]
				arm: PatternMatrixArm = {
					patterns = parts[1],
					bindings = [],
					body = SemanticMatchLeaf([], match_case.body)
				}

				match groups.index_by_constructor.get(constructor):
					Some(index):
						match groups.ordered.get(index):
							Some(group):
								groups = { groups |
									ordered = groups.ordered.set(
										index,
										{ group | arms = group.arms.append(arm) },
									)
								}
							None:
								failed = True
								break
					None:
						group_index: Int = groups.ordered.length()
						groups = {
							ordered = groups.ordered.append({
								constructor = constructor,
								arms = [arm],
							}),
							index_by_constructor = groups.index_by_constructor.set(
								constructor,
								group_index,
							)
						}
			None:
				failed = True
				break

	if failed:
		None
	else:
		Some(groups.ordered)


private pure func core_match_literals_equal(left: CoreLiteral, right: CoreLiteral) -> Bool:
	match left:
		IntLiteral(left_value):
			match right:
				IntLiteral(right_value):
					left_value == right_value
				_:
					False
		WideIntLiteral(left_value):
			match right:
				WideIntLiteral(right_value):
					left_value == right_value
				_:
					False
		FloatLiteral(left_value):
			match right:
				FloatLiteral(right_value):
					left_value == right_value
				_:
					False
		FloatTextLiteral(left_value):
			match right:
				FloatTextLiteral(right_value):
					left_value == right_value
				_:
					False
		FloatInfinityLiteral:
			match right:
				FloatInfinityLiteral:
					True
				_:
					False
		FloatNegInfinityLiteral:
			match right:
				FloatNegInfinityLiteral:
					True
				_:
					False
		FloatNanLiteral:
			match right:
				FloatNanLiteral:
					True
				_:
					False
		BoolLiteral(left_value):
			match right:
				BoolLiteral(right_value):
					left_value == right_value
				_:
					False
		CharLiteral(left_value):
			match right:
				CharLiteral(right_value):
					left_value == right_value
				_:
					False
		StringLiteral(left_value):
			match right:
				StringLiteral(right_value):
					left_value == right_value
				_:
					False


private pure func pattern_matrix_accessor(
	kind: PatternMatrixAccessorKind,
	base: CoreSemanticMatchAccessor,
	position: Int,
) -> Option[CoreSemanticMatchAccessor]:
	match kind:
		TuplePatternMatrixAccessors:
			Some(ProductFieldSemanticMatchAccessor(base, core_field_ordinal(position)))
		ListPatternMatrixAccessors:
			Some(ListElementSemanticMatchAccessor(base, position))
		VariantPatternMatrixAccessors(constructor):
			Some(VariantFieldSemanticMatchAccessor(base, constructor, position))
		ExplicitPatternMatrixAccessors(columns):
			columns.get(position)


private pure func pattern_matrix_bindings(
	kind: PatternMatrixAccessorKind,
	base: CoreSemanticMatchAccessor,
	patterns: List[CorePattern],
) -> Option[List[CoreSemanticMatchBinding]]:
	var sequence: PatternBindingSequence = NoPatternBindings
	var index: Int = patterns.length()
	var failed: Bool = False

	while index > 0:
		index -= 1

		match patterns.get(index):
			Some(pattern):
				match pattern_matrix_accessor(kind, base, index):
					Some(accessor):
						sequence = prepend_pattern_bindings(sequence, accessor, pattern)
					None:
						failed = True
						break
			None:
				failed = True
				break

	if failed:
		None
	else:
		Some(pattern_binding_sequence_to_list(sequence))


private pure func pattern_matrix_split_index(arms: List[PatternMatrixArm]) -> Option[Int]:
	match arms.get(0):
		Some(first_arm):
			var result: Option[Int] = None
			var index: Int = 0

			while index < first_arm.patterns.length():
				var non_trivial: Bool = False

				for arm in arms:
					match arm.patterns.get(index):
						Some(pattern):
							if not is_catchall_pattern(pattern):
								non_trivial = True
								break
						None:
							void

				if non_trivial:
					result = Some(index)
					break

				index += 1

			result
		None:
			None


private pure func catchall_pattern_matrix_arms(
	arms: List[PatternMatrixArm],
	position: Int,
) -> List[PatternMatrixArm]:
	var result: List[PatternMatrixArm] = []

	for arm in arms:
		match arm.patterns.get(position):
			Some(pattern):
				if is_catchall_pattern(pattern):
					result = result.append(arm)
			None:
				void

	result


private pure func distinct_literal_patterns(
	arms: List[PatternMatrixArm],
	position: Int,
) -> List[CoreLiteral]:
	var literals: List[CoreLiteral] = []

	for arm in arms:
		match arm.patterns.get(position):
			Some(LiteralPattern(literal)):
				if not literals.any(func(existing): core_match_literals_equal(existing, literal)):
					literals = literals.append(literal)
			_:
				void

	literals


private pure func distinct_constructor_patterns(
	arms: List[PatternMatrixArm],
	position: Int,
) -> List[String]:
	var constructors: List[String] = []

	for arm in arms:
		match arm.patterns.get(position):
			Some(ConstructorPattern(constructor, _)):
				if not constructors.contains(constructor):
					constructors = constructors.append(constructor)
			Some(QualifiedConstructorPattern(_, constructor, _)):
				if not constructors.contains(constructor):
					constructors = constructors.append(constructor)
			_:
				void

	constructors


private pure func pattern_matrix_arms_for_literal(
	arms: List[PatternMatrixArm],
	position: Int,
	literal: CoreLiteral,
) -> List[PatternMatrixArm]:
	var specialized: List[PatternMatrixArm] = []

	for arm in arms:
		match arm.patterns.get(position):
			Some(LiteralPattern(found)):
				if core_match_literals_equal(found, literal):
					specialized = specialized.append(
						{ arm | patterns = arm.patterns.set(position, WildcardPattern) },
					)
			Some(pattern):
				if is_catchall_pattern(pattern):
					specialized = specialized.append(arm)
			None:
				void

	specialized


private pure func pattern_matrix_column_has_literal(
	arms: List[PatternMatrixArm],
	position: Int,
) -> Bool:
	var found: Bool = False

	for arm in arms:
		match arm.patterns.get(position):
			Some(LiteralPattern(_)):
				found = True
				break
			_:
				void

	found


private pure func pattern_matrix_column_has_constructor(
	arms: List[PatternMatrixArm],
	position: Int,
) -> Bool:
	var found: Bool = False

	for arm in arms:
		match arm.patterns.get(position):
			Some(ConstructorPattern(_, _)) | Some(QualifiedConstructorPattern(_, _, _)):
				found = True
				break
			_:
				void

	found


private pure func pattern_matrix_column_has_tuple(
	arms: List[PatternMatrixArm],
	position: Int,
) -> Bool:
	var found: Bool = False

	for arm in arms:
		match arm.patterns.get(position):
			Some(TuplePattern(_)):
				found = True
				break
			_:
				void

	found


private pure func pattern_matrix_column_has_list(
	arms: List[PatternMatrixArm],
	position: Int,
) -> Bool:
	var found: Bool = False

	for arm in arms:
		match arm.patterns.get(position):
			Some(ListPattern(_, _)):
				found = True
				break
			_:
				void

	found


private pure func compile_pattern_matrix_literal_column(
	kind: PatternMatrixAccessorKind,
	base: CoreSemanticMatchAccessor,
	arms: List[PatternMatrixArm],
	position: Int,
	fallback: CoreSemanticMatchTree,
) -> Option[CoreSemanticMatchTree]:
	accessor ?= pattern_matrix_accessor(kind, base, position)
	default_arms: List[PatternMatrixArm] = catchall_pattern_matrix_arms(arms, position)
	var default_tree: CoreSemanticMatchTree = fallback
	var failed: Bool = False

	if not default_arms.is_empty():
		match compile_pattern_matrix(kind, base, default_arms, fallback):
			Some(found):
				default_tree = found
			None:
				failed = True

	var cases: List[CoreSemanticLiteralMatchCase] = []

	if not failed:
		for literal in distinct_literal_patterns(arms, position):
			specialized: List[PatternMatrixArm] = pattern_matrix_arms_for_literal(
				arms,
				position,
				literal,
			)

			match compile_pattern_matrix(kind, base, specialized, fallback):
				Some(body):
					cases = cases.append({
						literal = literal,
						body = body,
					})
				None:
					failed = True
					break

	if failed:
		None
	else:
		Some(SemanticLiteralMatch(accessor, cases, default_tree))


private pure func constructor_pattern_matrix_arms(
	arms: List[PatternMatrixArm],
	position: Int,
	accessor: CoreSemanticMatchAccessor,
	constructor: String,
	payload_width: Int,
) -> Option[List[PatternMatrixArm]]:
	var specialized: List[PatternMatrixArm] = []
	var payload_wildcards: List[CorePattern] = []
	var index: Int = 0
	var failed: Bool = False

	while index < payload_width:
		payload_wildcards = payload_wildcards.append(WildcardPattern)
		index += 1

	for arm in arms:
		match arm.patterns.get(position):
			Some(ConstructorPattern(found, patterns)):
				if found == constructor:
					-- Source typechecking requires declared payload arity;
					-- a mismatch here is malformed Core, not a tag-only pattern.
					if patterns.length() != payload_width:
						failed = True
						break

					specialized = specialized.append({ arm |
						patterns = arm.patterns.take(position).concat(patterns).concat(arm.patterns.drop(position + 1))
					})
			Some(QualifiedConstructorPattern(_, found, patterns)):
				if found == constructor:
					-- Source typechecking requires declared payload arity;
					-- a mismatch here is malformed Core, not a tag-only pattern.
					if patterns.length() != payload_width:
						failed = True
						break

					specialized = specialized.append({ arm |
						patterns = arm.patterns.take(position).concat(patterns).concat(arm.patterns.drop(position + 1))
					})
			Some(pattern):
				if is_catchall_pattern(pattern):
					specialized = specialized.append({ arm |
						patterns = arm.patterns.take(position).concat(payload_wildcards).concat(arm.patterns.drop(position + 1)),
						bindings = arm.bindings.concat(collect_pattern_bindings(accessor, pattern))
					})
				else:
					failed = True
					break
			None:
				failed = True
				break

	if failed:
		None
	else:
		Some(specialized)


private pure func compile_pattern_matrix_constructor_column(
	kind: PatternMatrixAccessorKind,
	base: CoreSemanticMatchAccessor,
	arms: List[PatternMatrixArm],
	position: Int,
	fallback: CoreSemanticMatchTree,
) -> Option[CoreSemanticMatchTree]:
	accessor ?= pattern_matrix_accessor(kind, base, position)
	first_arm ?= arms.get(0)
	default_arms: List[PatternMatrixArm] = catchall_pattern_matrix_arms(arms, position)
	default_tree ?= if default_arms.is_empty():
		Some(fallback)
	else:
		compile_pattern_matrix(kind, base, default_arms, fallback)

	var cases: List[CoreSemanticConstructorMatchCase] = []
	var failed: Bool = False

	for constructor in distinct_constructor_patterns(arms, position):
		var payload_width: Option[Int] = None

		for arm in arms:
			match arm.patterns.get(position):
				Some(ConstructorPattern(found, patterns)):
					if found == constructor:
						payload_width = Some(patterns.length())
						break
				Some(QualifiedConstructorPattern(_, found, patterns)):
					if found == constructor:
						payload_width = Some(patterns.length())
						break
				_:
					void

		match payload_width:
			Some(width):
				var columns: List[CoreSemanticMatchAccessor] = []
				var index: Int = 0

				-- Expand the payload in the same matrix as every remaining field.
				-- Compiling all source arms together preserves fallback order without
				-- copying a later arm into every failing path of an earlier arm.
				while index < first_arm.patterns.length():
					if index == position:
						var payload_index: Int = 0

						while payload_index < width:
							columns = columns.append(VariantFieldSemanticMatchAccessor(accessor, constructor, payload_index))
							payload_index += 1
					else:
						match pattern_matrix_accessor(kind, base, index):
							Some(column):
								columns = columns.append(column)
							None:
								failed = True
								break

					index += 1

				if failed:
					break

				match constructor_pattern_matrix_arms(arms, position, accessor, constructor, width):
					Some(specialized):
						match compile_pattern_matrix(ExplicitPatternMatrixAccessors(columns), base, specialized, fallback):
							Some(body):
								cases = cases.append({ constructor = constructor, body = body })
							None:
								failed = True
								break
					None:
						failed = True
						break
			None:
				failed = True
				break

	if failed:
		None
	else:
		Some(SemanticConstructorMatch(accessor, cases, Some(default_tree)))


private pure func tuple_pattern_matrix_arms(
	arms: List[PatternMatrixArm],
	position: Int,
	accessor: CoreSemanticMatchAccessor,
	tuple_width: Int,
) -> Option[List[PatternMatrixArm]]:
	var specialized: List[PatternMatrixArm] = []
	var field_wildcards: List[CorePattern] = []
	var index: Int = 0
	var failed: Bool = False

	while index < tuple_width:
		field_wildcards = field_wildcards.append(WildcardPattern)
		index += 1

	for arm in arms:
		match arm.patterns.get(position):
			Some(TuplePattern(patterns)):
				if patterns.length() != tuple_width:
					failed = True
					break

				specialized = specialized.append({ arm |
					patterns = arm.patterns.take(position).concat(patterns).concat(arm.patterns.drop(position + 1))
				})
			Some(pattern):
				if is_catchall_pattern(pattern):
					specialized = specialized.append({ arm |
						patterns = arm.patterns.take(position).concat(field_wildcards).concat(arm.patterns.drop(position + 1)),
						bindings = arm.bindings.concat(collect_pattern_bindings(accessor, pattern))
					})
				else:
					failed = True
					break
			None:
				failed = True
				break

	if failed:
		None
	else:
		Some(specialized)


private pure func compile_pattern_matrix_tuple_column(
	kind: PatternMatrixAccessorKind,
	base: CoreSemanticMatchAccessor,
	arms: List[PatternMatrixArm],
	position: Int,
	fallback: CoreSemanticMatchTree,
) -> Option[CoreSemanticMatchTree]:
	accessor ?= pattern_matrix_accessor(kind, base, position)
	first_arm ?= arms.get(0)
	var tuple_width: Option[Int] = None

	for arm in arms:
		match arm.patterns.get(position):
			Some(TuplePattern(patterns)):
				tuple_width = Some(patterns.length())
				break
			_:
				void

	match tuple_width:
		Some(width):
			var columns: List[CoreSemanticMatchAccessor] = []
			var index: Int = 0
			var failed: Bool = False

			-- Tuple fields share the remaining matrix columns too: independent
			-- arm continuations would copy later arms on each failed field.
			while index < first_arm.patterns.length():
				if index == position:
					var field_index: Int = 0

					while field_index < width:
						columns = columns.append(ProductFieldSemanticMatchAccessor(accessor, core_field_ordinal(field_index)))
						field_index += 1
				else:
					match pattern_matrix_accessor(kind, base, index):
						Some(column):
							columns = columns.append(column)
						None:
							failed = True
							break

				index += 1

			if failed:
				None
			else:
				match tuple_pattern_matrix_arms(arms, position, accessor, width):
					Some(specialized):
						compile_pattern_matrix(ExplicitPatternMatrixAccessors(columns), base, specialized, fallback)
					None:
						None
		None:
			None


private pure func list_spread_tree_binding(
	base: CoreSemanticMatchAccessor,
	fixed_length: Int,
	spread: Option[CorePattern],
	body: CoreSemanticMatchTree,
) -> List[CoreSemanticMatchBinding]:
	match spread:
		Some(NamePattern(variable)):
			if semantic_match_tree_name_may_occur_free(body, variable.name):
				[semantic_binding(
						variable,
						ListSpreadSemanticMatchAccessor(base, fixed_length),
					)]
			else:
				[]
		_:
			[]


private pure func compile_pattern_matrix_list_column(
	kind: PatternMatrixAccessorKind,
	base: CoreSemanticMatchAccessor,
	arms: List[PatternMatrixArm],
	position: Int,
	fallback: CoreSemanticMatchTree,
) -> Option[CoreSemanticMatchTree]:
	accessor ?= pattern_matrix_accessor(kind, base, position)
	var result: CoreSemanticMatchTree = fallback
	var index: Int = arms.length()
	var failed: Bool = False

	while index > 0:
		index -= 1

		match arms.get(index):
			Some(arm):
				match arm.patterns.get(position):
					Some(ListPattern(patterns, spread)):
						outer_arm: PatternMatrixArm = { arm |
							patterns = arm.patterns.set(position, WildcardPattern)
						}

						match compile_pattern_matrix(kind, base, [outer_arm], SemanticMatchFail):
							Some(continuation):
								list_arm: PatternMatrixArm = {
									patterns = patterns,
									bindings = list_spread_tree_binding(
										accessor,
										patterns.length(),
										spread,
										continuation,
									),
									body = continuation
								}

								match compile_pattern_matrix(
									ListPatternMatrixAccessors,
									accessor,
									[list_arm],
									SemanticMatchFail,
								):
									Some(body):
										arm_tree: CoreSemanticMatchTree = if spread.is_some():
											SemanticLengthMatch(accessor, [], Some({
													minimum_length = patterns.length(),
													body = body,
												}), Some(SemanticMatchFail))
										else:
											SemanticLengthMatch(
												accessor,
												[
													{
														length = patterns.length(),
														body = body
													},
												],
												None,
												Some(SemanticMatchFail),
											)

										result = replace_semantic_match_fail(arm_tree, result)
									None:
										failed = True
										break
							None:
								failed = True
								break
					Some(pattern):
						if is_catchall_pattern(pattern):
							outer_arm: PatternMatrixArm = { arm |
								patterns = arm.patterns.set(position, WildcardPattern),
								bindings = arm.bindings.concat(
									collect_pattern_bindings(
										accessor,
										pattern,
									),
								)
							}

							match compile_pattern_matrix(
								kind,
								base,
								[outer_arm],
								SemanticMatchFail,
							):
								Some(arm_tree):
									result = replace_semantic_match_fail(arm_tree, result)
								None:
									failed = True
									break
						else:
							failed = True
							break
					None:
						failed = True
						break
			None:
				failed = True
				break

	if failed:
		None
	else:
		Some(result)


private pure func compile_pattern_matrix(
	kind: PatternMatrixAccessorKind,
	base: CoreSemanticMatchAccessor,
	arms: List[PatternMatrixArm],
	fallback: CoreSemanticMatchTree,
) -> Option[CoreSemanticMatchTree]:
	match arms.get(0):
		Some(first_arm):
			width: Int = first_arm.patterns.length()
			columns_valid: Bool = match kind:
				ExplicitPatternMatrixAccessors(columns): columns.length() == width
				_: True

			if not columns_valid or arms.any(func(arm): arm.patterns.length() != width):
				None
			else:
				-- A complete first arm shadows every later arm. Do not inspect
				-- constraints that cannot influence its choice or its bindings.
				split_position: Option[Int] = if first_arm.patterns.all(is_catchall_pattern):
					None
				else:
					pattern_matrix_split_index(arms)

				match split_position:
					Some(position):
						if pattern_matrix_column_has_literal(arms, position):
							compile_pattern_matrix_literal_column(kind, base, arms, position, fallback)
						else if pattern_matrix_column_has_constructor(arms, position):
							compile_pattern_matrix_constructor_column(kind, base, arms, position, fallback)
						else if pattern_matrix_column_has_tuple(arms, position):
							compile_pattern_matrix_tuple_column(kind, base, arms, position, fallback)
						else if pattern_matrix_column_has_list(arms, position):
							compile_pattern_matrix_list_column(kind, base, arms, position, fallback)
						else:
							None
					None:
						bindings ?= pattern_matrix_bindings(kind, base, first_arm.patterns)
						Some(prepend_semantic_bindings(first_arm.body, first_arm.bindings.concat(bindings)))
		None:
			Some(fallback)


private pure func compile_tuple_match_cases(
	cases: List[CoreRawMatchCase],
) -> Option[CoreSemanticMatchTree]:
	split: SplitMatchCases = split_trailing_catchall(cases)

	fallback: CoreSemanticMatchTree = match split.fallback:
		Some(fallback_case):
			catchall_leaf(fallback_case.pattern, fallback_case.body)
		None:
			SemanticMatchFail

	var arms: List[PatternMatrixArm] = []
	var failed: Bool = False

	for match_case in split.tested:
		match match_case.pattern:
			TuplePattern(patterns):
				arms = arms.append({
					patterns = patterns,
					bindings = [],
					body = SemanticMatchLeaf([], match_case.body),
				})
			_:
				failed = True
				break

	if failed:
		None
	else:
		compile_pattern_matrix(
			TuplePatternMatrixAccessors,
			RootSemanticMatchAccessor,
			arms,
			fallback,
		)


private pure func params_shadow_name(params: List[CoreParam], name: String) -> Bool:
	var shadows: Bool = False

	for param in params:
		if param.name.name == name:
			shadows = True
			break

	shadows


private pure func append_scoped_core_exprs(
	work: List[ScopedCoreExpr],
	exprs: List[CoreExpr],
	target_shadowed: Bool,
) -> List[ScopedCoreExpr]:
	var result: List[ScopedCoreExpr] = work

	for expr in exprs:
		result = result.append({
			expr = expr,
			target_shadowed = target_shadowed,
		})

	result


---
This is deliberately conservative for already-compiled match forms: those
forms cannot appear at the post-synth input to this pass, and treating their
bindings as uses can only retain an otherwise avoidable spread allocation.
---
private pure func core_name_may_occur_free(name: String, root: CoreExpr) -> Bool:
	var work: List[ScopedCoreExpr] = [
		{
			expr = root,
			target_shadowed = False
		},
	]
	var work_index: Int = 0
	var found: Bool = False

	while work_index < work.length():
		match work.get(work_index):
			Some(item):
				work_index += 1

				match item.expr:
					VarExpr(variable, _, _):
						if not item.target_shadowed and variable.name == name:
							found = True
					AssignExpr(variable, rhs, _, _):
						if not item.target_shadowed and variable.name == name:
							found = True
						else:
							work = work.append({
								expr = rhs,
								target_shadowed = item.target_shadowed,
							})
					DupExpr(variable, _, _, body, _, _):
						if not item.target_shadowed and variable.name == name:
							found = True
						else:
							work = work.append({
								expr = body,
								target_shadowed = item.target_shadowed,
							})
					DropExpr(variable, _, _, body, _, _):
						if not item.target_shadowed and variable.name == name:
							found = True
						else:
							work = work.append({
								expr = body,
								target_shadowed = item.target_shadowed,
							})
					LetExpr(variable, _, _, rhs, body):
						work = work.append({
							expr = rhs,
							target_shadowed = item.target_shadowed,
						})
						work = work.append({
							expr = body,
							target_shadowed = item.target_shadowed or variable.name == name,
						})
					BorrowLetExpr(variable, _, rhs, body):
						work = work.append({
							expr = rhs,
							target_shadowed = item.target_shadowed,
						})
						work = work.append({
							expr = body,
							target_shadowed = item.target_shadowed or variable.name == name,
						})
					LambdaExpr(params, _, body, _, _, _):
						work = work.append({
							expr = body,
							target_shadowed = (
								item.target_shadowed
								or params_shadow_name(params, name)
							),
						})
					TensorRawViewLetExpr(binding, body, _, _):
						work = work.append({
							expr = binding.source,
							target_shadowed = item.target_shadowed,
						})
						work = work.append({
							expr = body,
							target_shadowed = item.target_shadowed or binding.variable.name == name,
						})
					ListHandoffExpr(handoff, _, _):
						work = work.append({
							expr = handoff.source,
							target_shadowed = item.target_shadowed,
						})
						work = work.append({
							expr = handoff.capacity,
							target_shadowed = item.target_shadowed,
						})
						handoff_shadows: Bool = (
							handoff.source_var.name == name
							or handoff.result_var.name == name
							or handoff.len_var.name == name
							or handoff.out_var.name == name
						)

						work = work.append({
							expr = handoff.body,
							target_shadowed = item.target_shadowed or handoff_shadows,
						})
					ResourceScopeExpr(scope, _, _):
						work = work.append({
							expr = scope.acquire,
							target_shadowed = item.target_shadowed,
						})
						scoped_shadowed: Bool = item.target_shadowed or scope.variable.name == name

						work = work.append({
							expr = scope.body,
							target_shadowed = scoped_shadowed,
						})
						work = work.append({
							expr = scope.cleanup,
							target_shadowed = scoped_shadowed,
						})
					TailrecLoopExpr(params, _, body, _):
						work = work.append({
							expr = body,
							target_shadowed = (
								item.target_shadowed
								or params_shadow_name(params, name)
							),
						})
					TailrecListSpreadLoopExpr(loop, _):
						work = work.append({
							expr = loop.body,
							target_shadowed = (
								item.target_shadowed
								or params_shadow_name(loop.params, name)
								or loop.cursor.name == name
							),
						})
					ForRangeExpr(binder, start, end_value, body, _, _):
						work = append_scoped_core_exprs(
							work,
							[start, end_value],
							item.target_shadowed,
						)
						work = work.append({
							expr = body,
							target_shadowed = item.target_shadowed or binder.variable.name == name,
						})
					ForChannelExpr(loop, _, _):
						work = work.append({
							expr = loop.iterable,
							target_shadowed = item.target_shadowed,
						})
						work = work.append({
							expr = loop.body,
							target_shadowed = (
								item.target_shadowed
								or loop.binder.variable.name == name
							),
						})
					ForListExpr(loop, _, _):
						work = work.append({
							expr = loop.iterable,
							target_shadowed = item.target_shadowed,
						})
						work = work.append({
							expr = loop.body,
							target_shadowed = (
								item.target_shadowed
								or loop.binder.variable.name == name
							),
						})
					ForStringExpr(loop, _, _):
						work = work.append({
							expr = loop.iterable,
							target_shadowed = item.target_shadowed,
						})
						work = work.append({
							expr = loop.body,
							target_shadowed = (
								item.target_shadowed
								or loop.binder.variable.name == name
							),
						})
					ForDictExpr(loop, _, _):
						work = work.append({
							expr = loop.iterable,
							target_shadowed = item.target_shadowed,
						})
						work = work.append({
							expr = loop.body,
							target_shadowed = (
								item.target_shadowed
								or loop.binder.variable.name == name
							),
						})
					ForSetExpr(loop, _, _):
						work = work.append({
							expr = loop.iterable,
							target_shadowed = item.target_shadowed,
						})
						work = work.append({
							expr = loop.body,
							target_shadowed = (
								item.target_shadowed
								or loop.binder.variable.name == name
							),
						})
					ForStreamExpr(loop, _, _):
						work = work.append({
							expr = loop.iterable,
							target_shadowed = item.target_shadowed,
						})
						work = work.append({
							expr = loop.body,
							target_shadowed = (
								item.target_shadowed
								or loop.binder.variable.name == name
							),
						})
					ForResourceSourceExpr(loop, _, _):
						work = work.append({
							expr = loop.iterable,
							target_shadowed = item.target_shadowed,
						})
						work = work.append({
							expr = loop.body,
							target_shadowed = (
								item.target_shadowed
								or loop.binder.variable.name == name
							),
						})
					ForTensorExpr(loop, _, _):
						work = work.append({
							expr = loop.iterable,
							target_shadowed = item.target_shadowed,
						})
						work = work.append({
							expr = loop.body,
							target_shadowed = (
								item.target_shadowed
								or loop.binder.variable.name == name
							),
						})
					PreClosureConcurrentlyLoopExpr(loop, _, _):
						work = append_scoped_core_exprs(
							work,
							[loop.iterable, loop.limit],
							item.target_shadowed,
						)

						match loop.timeout:
							Some(timeout):
								work = work.append({
									expr = timeout,
									target_shadowed = item.target_shadowed,
								})
							None:
								void

						work = work.append({
							expr = loop.body,
							target_shadowed = item.target_shadowed or loop.variable.name == name,
						})
					ConcurrentlyLoopExpr(loop, _, _):
						work = append_scoped_core_exprs(
							work,
							[loop.iterable, loop.limit],
							item.target_shadowed,
						)

						match loop.timeout:
							Some(timeout):
								work = work.append({
									expr = timeout,
									target_shadowed = item.target_shadowed,
								})
							None:
								void

						work = work.append({
							expr = loop.body,
							target_shadowed = item.target_shadowed or loop.variable.name == name,
						})
					PreClosureConcurrentExpr(block, _, _):
						var body_shadowed: Bool = item.target_shadowed

						for binding in block.bindings:
							work = work.append({
								expr = binding.rhs,
								target_shadowed = item.target_shadowed,
							})

							if binding.variable.name == name:
								body_shadowed = True

						work = work.append({
							expr = block.body,
							target_shadowed = body_shadowed,
						})

						match block.timeout:
							Some(timeout):
								work = work.append({
									expr = timeout,
									target_shadowed = item.target_shadowed,
								})
							None:
								void
					ConcurrentExpr(block, _, _):
						var body_shadowed: Bool = item.target_shadowed

						for binding in block.bindings:
							work = work.append({
								expr = binding.rhs,
								target_shadowed = item.target_shadowed,
							})

							if binding.variable.name == name:
								body_shadowed = True

						work = work.append({
							expr = block.body,
							target_shadowed = body_shadowed,
						})

						match block.timeout:
							Some(timeout):
								work = work.append({
									expr = timeout,
									target_shadowed = item.target_shadowed,
								})
							None:
								void
					SelectExpr(arms, _, _):
						for arm in arms:
							match arm.kind:
								SelectRecvArm(recv):
									work = work.append({
										expr = recv.channel,
										target_shadowed = item.target_shadowed,
									})
									work = work.append({
										expr = arm.body,
										target_shadowed = (
											item.target_shadowed
											or recv.binder.name == name
										),
									})
								SelectSealedArm(channel):
									work = append_scoped_core_exprs(
										work,
										[channel, arm.body],
										item.target_shadowed,
									)
								SelectAfterArm(timeout):
									work = append_scoped_core_exprs(
										work,
										[timeout, arm.body],
										item.target_shadowed,
									)
					RawMatchExpr(scrutinee, cases, _, _):
						work = work.append({
							expr = scrutinee,
							target_shadowed = item.target_shadowed,
						})

						for match_case in cases:
							work = work.append({
								expr = match_case.body,
								target_shadowed = (
									item.target_shadowed
									or CoreTraverse.core_pattern_binds_name(
										match_case.pattern,
										name,
									)
								),
							})
					_:
						work = append_scoped_core_exprs(
							work,
							CoreTraverse.immediate_core_expr_children(item.expr),
							item.target_shadowed,
						)
			None:
				break

		if found:
			break

	found


private pure func list_spread_binding(
	base: CoreSemanticMatchAccessor,
	fixed_length: Int,
	spread: Option[CorePattern],
	body: CoreExpr,
) -> List[CoreSemanticMatchBinding]:
	match spread:
		Some(NamePattern(variable)):
			if core_name_may_occur_free(variable.name, body):
				[semantic_binding(
						variable,
						ListSpreadSemanticMatchAccessor(base, fixed_length),
					)]
			else:
				[]
		_:
			[]


private pure func compile_list_pattern_sequence(
	base: CoreSemanticMatchAccessor,
	arms: List[ListPatternSequenceArm],
	fallback: CoreSemanticMatchTree,
) -> Option[CoreSemanticMatchTree]:
	var result: CoreSemanticMatchTree = fallback
	var index: Int = arms.length()
	var failed: Bool = False

	while index > 0:
		index -= 1

		match arms.get(index):
			Some(ExactListPatternArm(arm)):
				match compile_pattern_matrix(ListPatternMatrixAccessors, base, [arm], result):
					Some(body):
						result = SemanticLengthMatch(
							base,
							[
								{
									length = arm.patterns.length(),
									body = body
								},
							],
							None,
							Some(result),
						)
					None:
						failed = True
						break
			Some(SpreadListPatternArm(arm)):
				match compile_pattern_matrix(ListPatternMatrixAccessors, base, [arm], result):
					Some(body):
						result = SemanticLengthMatch(base, [], Some({
								minimum_length = arm.patterns.length(),
								body = body,
							}), Some(result))
					None:
						failed = True
						break
			Some(CatchallListPatternArm(bindings, body)):
				result = prepend_semantic_bindings(body, bindings)
			None:
				failed = True
				break

	if failed:
		None
	else:
		Some(result)


private pure func compile_list_match_cases(
	cases: List[CoreRawMatchCase],
) -> Option[CoreSemanticMatchTree]:
	split: SplitMatchCases = split_trailing_catchall(cases)

	fallback: CoreSemanticMatchTree = match split.fallback:
		Some(fallback_case):
			catchall_leaf(fallback_case.pattern, fallback_case.body)
		None:
			SemanticMatchFail

	var arms: List[ListPatternSequenceArm] = []
	var failed: Bool = False

	for match_case in split.tested:
		match match_case.pattern:
			ListPattern(patterns, None):
				arms = arms.append(ExactListPatternArm({
					patterns = patterns,
					bindings = [],
					body = SemanticMatchLeaf([], match_case.body),
				}))
			ListPattern(patterns, spread):
				arms = arms.append(SpreadListPatternArm({
					patterns = patterns,
					bindings = list_spread_binding(
						RootSemanticMatchAccessor,
						patterns.length(),
						spread,
						match_case.body,
					),
					body = SemanticMatchLeaf([], match_case.body),
				}))
			_:
				failed = True
				break

	if failed:
		None
	else:
		compile_list_pattern_sequence(RootSemanticMatchAccessor, arms, fallback)


private pure func compile_literal_match_cases(
	cases: List[CoreRawMatchCase],
) -> Option[CoreSemanticMatchTree]:
	split: SplitMatchCases = split_trailing_catchall(cases)

	fallback: CoreSemanticMatchTree = match split.fallback:
		Some(fallback_case):
			catchall_leaf(fallback_case.pattern, fallback_case.body)
		None:
			SemanticMatchFail

	var literal_cases: List[CoreSemanticLiteralMatchCase] = []
	var failed: Bool = False

	for match_case in split.tested:
		match match_case.pattern:
			LiteralPattern(literal):
				literal_cases = literal_cases.append({
					literal = literal,
					body = SemanticMatchLeaf([], match_case.body),
				})
			_:
				failed = True
				break

	if failed:
		None
	else:
		Some(SemanticLiteralMatch(RootSemanticMatchAccessor, literal_cases, fallback))


private pure func compile_constructor_match_cases(
	cases: List[CoreRawMatchCase],
) -> Option[CoreSemanticMatchTree]:
	split: SplitMatchCases = split_trailing_catchall(cases)
	fallback: Option[CoreSemanticMatchTree] = split.fallback.map(
		func(fallback_case): catchall_leaf(fallback_case.pattern, fallback_case.body),
	)
	groups ?= group_constructor_cases(split.tested)
	var constructor_cases: List[CoreSemanticConstructorMatchCase] = []
	var failed: Bool = False

	for group in groups:
		match compile_pattern_matrix(
			VariantPatternMatrixAccessors(group.constructor),
			RootSemanticMatchAccessor,
			group.arms,
			fallback.get_or(SemanticMatchFail),
		):
			Some(body):
				constructor_cases = constructor_cases.append({
					constructor = group.constructor,
					body = body,
				})
			None:
				failed = True
				break

	if failed:
		None
	else:
		Some(SemanticConstructorMatch(RootSemanticMatchAccessor, constructor_cases, fallback))


---
`next_id` threads the shared allocator through the or-pattern clones
`expand_or_match_cases_at` mints (see `clone_match_arm_body`); callers
that do not need identity to stay consistent across sibling matches (the
owning test suite exercises one match at a time) use `compile_match_cases`
below, which reseeds it per call.
---
pure func compile_match_cases_at(
	next_id: Int,
	constructors: Set[String],
	cases: List[CoreRawMatchCase],
) -> (Int, Option[CoreSemanticMatchTree]):
	expanded: (Int, List[CoreRawMatchCase]) = expand_or_match_cases_at(
		next_id,
		normalize_match_cases(constructors, cases),
	)
	normalized_cases: List[CoreRawMatchCase] = expanded[1]

	tree: Option[CoreSemanticMatchTree] = match match_case_shape(normalized_cases):
		CatchallMatchCases:
			match normalized_cases.get(0):
				Some(match_case):
					Some(catchall_leaf(match_case.pattern, match_case.body))
				None:
					None
		LiteralMatchCases:
			compile_literal_match_cases(normalized_cases)
		ConstructorMatchCases:
			compile_constructor_match_cases(normalized_cases)
		TupleMatchCases:
			compile_tuple_match_cases(normalized_cases)
		ListMatchCases:
			compile_list_match_cases(normalized_cases)
		UnsupportedMatchCases:
			None

	(expanded[0], tree)


pure func compile_match_cases(
	constructors: Set[String],
	cases: List[CoreRawMatchCase],
) -> Option[CoreSemanticMatchTree]:
	-- `expand_or_match_case` splices one `A | B: body` arm's exact body into a
	-- case per alternative, so the same binders can appear twice in the tree;
	-- synthetic ids from the seed cannot collide with authored binder ids.
	compile_match_cases_at(CORE_SYNTHETIC_ID_SEED, constructors, cases)[1]


---
Threads a `next_id` allocator across the whole function body (seeded once
per function by `compile_expr`, mirroring `std_inline.brp`'s
`rewrite_function`) so two `A | B: body` matches in the same function
never mint the same clone id -- see `compile_match_cases_at`.
---
private pure func compile_expr_at(
	constructors: Set[String],
	next_id: Int,
	expr: CoreExpr,
) -> CoreMapState[Int, CoreExpr]:
	mapped_children: CoreMapState[Int, CoreExpr] = CoreTraverse.map_core_expr_children_with_state(
		next_id,
		pure func(state: Int, child: CoreExpr): compile_expr_at(constructors, state, child),
		expr,
	)
	mapped_expr: CoreExpr = mapped_children.value
	after_children: Int = mapped_children.state

	match mapped_expr:
		RawMatchExpr(scrutinee, cases, typ, loc):
			normalized_cases: List[CoreRawMatchCase] = normalize_match_cases(constructors, cases)

			match try_fuse_direct_constructor_match(constructors, scrutinee, normalized_cases):
				Some(fused):
					{
						state = after_children,
						value = fused
					}
				None:
					compiled: (Int, Option[CoreSemanticMatchTree]) = compile_match_cases_at(
						after_children,
						constructors,
						normalized_cases,
					)

					match compiled[1]:
						Some(tree):
							{
								state = compiled[0],
								value = SemanticMatchExpr(scrutinee, tree, typ, loc)
							}
						None:
							{
								state = compiled[0],
								value = RawMatchExpr(scrutinee, normalized_cases, typ, loc)
							}
		_:
			{
				state = after_children,
				value = mapped_expr
			}


private pure func compile_expr(constructors: Set[String], expr: CoreExpr) -> CoreExpr:
	compile_expr_at(constructors, CORE_SYNTHETIC_ID_SEED, expr).value


private pure func compile_function(
	constructors: Set[String],
	function_info: CoreFunction,
) -> CoreFunction:
	{ function_info | body = function_info.body.map(func(body): compile_expr(constructors, body)) }


private pure func compile_decl(constructors: Set[String], decl: CoreDecl) -> CoreDecl:
	match decl:
		FunctionDecl(function_info):
			FunctionDecl(compile_function(constructors, function_info))
		GlobalDecl(global):
			GlobalDecl({ global | init = compile_expr(constructors, global.init) })
		ImplDecl(impl):
			ImplDecl(
				{ impl |
					methods = impl.methods.map(func(method): compile_function(constructors, method))
				},
			)
		_:
			decl


pure func compile_program(program: CoreProgram) -> CoreProgram:
	constructors: Set[String] = collect_match_constructor_names(program)

	{ program | decls = program.decls.map(func(decl): compile_decl(constructors, decl)) }
