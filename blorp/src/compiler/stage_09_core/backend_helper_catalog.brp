			}
		BackendDictIterPairBinding:
			-- prepared_backend_renderer.brp: BackendDictIterPairBinding -- blorp_tuple_new
			{
				allocates = [ManagedObjectAllocation],
				retains = False,
				releases = False,
				calls_user_code = False,
				cleanup_scratch = False
			}
		BackendDictConstructWithBody:
			-- prepared_backend_renderer.brp: BackendDictConstructWithBody -- no runtime call (pure C template over already-materialized values)
