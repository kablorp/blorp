-- Every BackendHelperKind variant, in declaration order. A coverage test
-- iterates this list and calls backend_helper_contract on each; the list's
-- length is checked against BACKEND_HELPER_KIND_COUNT so an added variant
-- that is missing here (as opposed to missing a match arm, which fails to
-- compile) still fails the test instead of silently under-counting.
ALL_BACKEND_HELPER_KINDS: List[BackendHelperKind] = [
	BackendDictCtorGeneric,
