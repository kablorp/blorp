-- Increment whenever a catalog row's contract changes meaning, a renderer
-- variant is added/removed, or a secondary-flag split changes. Reports
-- expose this alongside the variant count as the backend-plan identity.
BACKEND_HELPER_CATALOG_REVISION: Int = 2

BACKEND_HELPER_KIND_COUNT: Int = 383


pure func backend_helper_contract(kind: BackendHelperKind) -> BackendHelperContract:
	match kind:
		BackendDictCtorGeneric:
			-- prepared_backend_renderer.brp: BackendDictCtorGeneric -- blorp_dict_new
			{
				allocates = [ManagedObjectAllocation],
				retains = False,
				releases = False,
				calls_user_code = False,
				cleanup_scratch = False
			}
		BackendDictCtorString:
			-- prepared_backend_renderer.brp: BackendDictCtorString -- blorp_dict_new_string
			{
				allocates = [ManagedObjectAllocation],
				retains = False,
				releases = False,
				calls_user_code = False,
				cleanup_scratch = False
			}
		BackendDictCtorFloat:
			-- prepared_backend_renderer.brp: BackendDictCtorFloat -- blorp_dict_new_float
			{
				allocates = [ManagedObjectAllocation],
				retains = False,
				releases = False,
				calls_user_code = False,
				cleanup_scratch = False
			}
		BackendDictCtorCustomNoElemRelease:
			-- prepared_backend_renderer.brp: BackendDictCtorCustomNoElemRelease -- blorp_dict_new_custom, blorp_elem_release_fn
			{
				allocates = [ManagedObjectAllocation],
				retains = False,
				releases = False,
				calls_user_code = False,
				cleanup_scratch = False
			}
		BackendDictCtorCustomWithElemRelease:
			-- prepared_backend_renderer.brp: BackendDictCtorCustomWithElemRelease -- blorp_dict_new_custom, blorp_elem_release_fn
			{
				allocates = [ManagedObjectAllocation],
				retains = False,
				releases = False,
				calls_user_code = False,
				cleanup_scratch = False
			}
		BackendDictStackOptionValueRecordGetKeepKey:
			-- prepared_backend_renderer.brp: BackendDictStackOptionValueRecordGetKeepKey -- blorp_dict_get_raw, blorp_release, blorp_unbox_struct
			{
				allocates = [],
				retains = False,
				releases = True,
				calls_user_code = True,
				cleanup_scratch = False
			}
		BackendDictStackOptionValueRecordGetReleaseKey:
			-- prepared_backend_renderer.brp: BackendDictStackOptionValueRecordGetReleaseKey -- blorp_dict_get_raw, blorp_release, blorp_unbox_struct
			{
				allocates = [],
				retains = False,
				releases = True,
				calls_user_code = True,
				cleanup_scratch = False
			}
		BackendDictStackOptionLongGetKeepKey:
			-- prepared_backend_renderer.brp: BackendDictStackOptionLongGetKeepKey -- blorp_dict_get_raw, blorp_release
			{
				allocates = [],
				retains = False,
				releases = True,
				calls_user_code = True,
				cleanup_scratch = False
			}
		BackendDictStackOptionLongGetReleaseKey:
			-- prepared_backend_renderer.brp: BackendDictStackOptionLongGetReleaseKey -- blorp_dict_get_raw, blorp_release
			{
				allocates = [],
				retains = False,
				releases = True,
				calls_user_code = True,
				cleanup_scratch = False
			}
		BackendDictStackOptionInt128GetKeepKey:
			-- prepared_backend_renderer.brp: BackendDictStackOptionInt128GetKeepKey -- blorp_dict_get_raw, blorp_release, blorp_unbox_int128
			{
				allocates = [],
				retains = False,
				releases = True,
				calls_user_code = True,
				cleanup_scratch = False
			}
		BackendDictStackOptionInt128GetReleaseKey:
			-- prepared_backend_renderer.brp: BackendDictStackOptionInt128GetReleaseKey -- blorp_dict_get_raw, blorp_release, blorp_unbox_int128
			{
				allocates = [],
				retains = False,
				releases = True,
				calls_user_code = True,
				cleanup_scratch = False
			}
		BackendDictStackOptionUInt128GetKeepKey:
			-- prepared_backend_renderer.brp: BackendDictStackOptionUInt128GetKeepKey -- blorp_dict_get_raw, blorp_release, blorp_unbox_uint128
			{
				allocates = [],
				retains = False,
				releases = True,
				calls_user_code = True,
				cleanup_scratch = False
			}
		BackendDictStackOptionUInt128GetReleaseKey:
			-- prepared_backend_renderer.brp: BackendDictStackOptionUInt128GetReleaseKey -- blorp_dict_get_raw, blorp_release, blorp_unbox_uint128
			{
				allocates = [],
				retains = False,
				releases = True,
				calls_user_code = True,
				cleanup_scratch = False
			}
		BackendDictConstructEmpty:
			-- prepared_backend_renderer.brp: BackendDictConstructEmpty -- no runtime call (pure C template over already-materialized values)
			{
				allocates = [],
				retains = False,
				releases = False,
				calls_user_code = False,
				cleanup_scratch = False
			}
		BackendDictValueReleaseInit:
