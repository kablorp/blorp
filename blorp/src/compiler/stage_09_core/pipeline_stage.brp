-- Stage identity for the Blorp-owned Core tail.
--
-- Keep this separate from core_pipeline so CLI planning and protocol
-- tests do not need to compile every Core transformation just to classify a
-- stage name.
POST_PERCEUS_TAIL_STAGE: String = "post_perceus_tail"

POST_DCE_TAIL_STAGE: String = "post_dce_tail"

PRE_DCE_TAIL_STAGE: String = "pre_dce_tail"

PRE_CLOSURE_TAIL_STAGE: String = "pre_closure_tail"

POST_CLOSURE_TAIL_STAGE: String = "post_closure_tail"

CONSUME_SPECIALIZE_STAGE: String = "consume_specialize"

STATIC_STRING_LITERALS_STAGE: String = "static_string_literals"

DCE_STAGE: String = "dce"

PERCEUS_STAGE: String = "perceus"

REUSE_STAGE: String = "reuse"

CLOSURE_STAGE: String = "closure"

FINAL_STAGE: String = "final"

LIST_LAYOUT_STAGE: String = "list_layout"

SPECIALIZE_STAGE: String = "specialize"

DESUGAR_STAGE: String = "desugar"


enum CorePipelineStage:
	DesugarStage
	ListLayoutStage
	SpecializeStage
	PreDceTailStage
	PostDceTailStage
	PostPerceusTailStage
	PreClosureTailStage
	PostClosureTailStage
	ConsumeSpecializeStage
	StaticStringLiteralsStage
	DceStage
	PerceusStage
	ReuseStage
	ClosureStage
	FinalStage


pure func parse_core_pipeline_stage(name: String) -> Option[CorePipelineStage]:
	if name == DESUGAR_STAGE:
		Some(DesugarStage)
	else if name == LIST_LAYOUT_STAGE:
		Some(ListLayoutStage)
	else if name == SPECIALIZE_STAGE:
		Some(SpecializeStage)
	else if name == PRE_DCE_TAIL_STAGE:
		Some(PreDceTailStage)
	else if name == POST_DCE_TAIL_STAGE:
		Some(PostDceTailStage)
	else if name == POST_PERCEUS_TAIL_STAGE:
		Some(PostPerceusTailStage)
	else if name == PRE_CLOSURE_TAIL_STAGE:
		Some(PreClosureTailStage)
	else if name == POST_CLOSURE_TAIL_STAGE:
		Some(PostClosureTailStage)
	else if name == CONSUME_SPECIALIZE_STAGE:
		Some(ConsumeSpecializeStage)
	else if name == STATIC_STRING_LITERALS_STAGE:
		Some(StaticStringLiteralsStage)
	else if name == DCE_STAGE:
		Some(DceStage)
	else if name == PERCEUS_STAGE:
		Some(PerceusStage)
	else if name == REUSE_STAGE:
		Some(ReuseStage)
	else if name == CLOSURE_STAGE:
		Some(ClosureStage)
	else if name == FINAL_STAGE:
		Some(FinalStage)
	else:
		None
