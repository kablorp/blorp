-- Project semantic Core calls onto the concrete backend ABI.
--
-- Specialization decides which runtime operation a call needs. This pass
-- records how that operation crosses the C boundary. Keeping the projection
-- before DCE and ownership analysis lets those passes reason about callback
-- references and the same ownership contract that emission will use.
import:
	../stage_10_backend/c_naming: variant_constructor_symbol
	hash_key_callbacks:
		HashKeyAdapterTable,
		bound_hash_container_constructor,
		bound_pinned_hash_container_constructor,
		build_hash_key_adapter_table,
	ir:
		CoreUnionValueStorage(ScalarTagValue, ManagedUnionValue),
		CoreCallKind(
			BuiltinCall, DictWithCapacityCall, DirectRuntimeCall, IntrinsicCall, ListToStringCall,
			TensorParallelCall,
		),
		CoreDecl(UnionDecl, FunctionDecl, GlobalDecl),
		CoreDictLiteralEntry,
		CoreDirectRuntimeArgs(
			DirectRuntimeArgsAppendListParallelLayout, DirectRuntimeArgsAsWritten,
		),
		CoreDirectRuntimeResult(
			DirectRuntimeResultAsWritten, DirectRuntimeResultCast,
			DirectRuntimeResultStackResultFromBoxed,
		),
		CoreExpr(
			BoxExpr, CallExpr, DictConstructExpr, DictExpr, ListAllocExpr, ListGetExpr,
			ListHandoffSetOwnedExpr, ListHandoffSetSourceSlotExpr, ListRetainExpr, ListSetExpr,
			ListSwapExpr, LogicalExpr, SeqExpr, SetAllocExpr, StringByteCopyExpr,
			StringByteReadExpr, StringByteWriteExpr, StringSetLenExpr, TensorRawFillExpr, VarExpr,
		),
		CoreFunction,
		CoreHashContainerConstructor(ImplHashContainerConstructor),
		CoreListAccessBounds(CheckedListAccess, ProvenListAccess),
		CoreListStorageLayout(InlineListStorage, InlineStructListStorage, PointerListStorage),
		CoreListToStringElements(InlineRecordListToStringElements, PointerListToStringElements),
		CoreLogicalOp,
		CoreProgram,
		CoreRuntimeCallbackRole(StringableToStringCallback),
		CoreSourceLoc,
		CoreTensorParallelLayout(
			TensorParallelInlineStructLayout, TensorParallelPointerLayout,
			TensorParallelRawScalarLayout,
		),
		CoreTensorRawScalarKind(TensorFloat32Elements, TensorFloat64Elements, TensorInt64Elements),
		CoreType(InlineRecordType, BoxedResultType, UnionType, NamedType, StackResultType, TensorType, VoidType),
		CoreVar,
		core_expr_type,
		core_union_storage_value,
	operation_metadata:
		fallible_stream_terminal_builtin,
		fallible_stream_terminal_call_kind,
		operation_result_builtin,
		operation_result_call_kind,
	ownership:
		builtin_contract,
		runtime_builtin_has_erased_arguments,
		runtime_builtin_uses_erased_argument,
	prepare: lower_trait_keyed_dict_literal
	record_representation: object_identity_builtin
	runtime_callbacks: CoreRuntimeCallbackTable, build_runtime_callback_table, find_runtime_callback
	specialize_collection: is_list_filter_map_parallel_builtin
	specialize_layout:
		CoreHashKeyStrategy(
			FloatHashKeys, Int128HashKeys, StringHashKeys, TraitHashKeys, WordHashKeys,
		),
		CoreOptionRuntimeLayout(BoxedOptionLayout),
		CoreSpecializeLayout,
		boxed_storage_kind,
		boxed_storage_needs_release,
		boxed_storage_value,
		build_specialize_layout,
		hash_key_strategy,
		list_retain_storage_value,
		named_type_arguments,
		option_runtime_layout,
		resolve_specialize_type,
		single_named_type_argument,
		specialize_list_element_needs_release,
		specialize_list_layout,
		specialize_type_is_pointer,
	traverse as CoreTraverse


private POINTER_TYPE: CoreType = NamedType("Ptr", [])


private record NullaryConstructorProjection {
	source_name: String,
	c_name: String,
	storage: CoreUnionValueStorage
}


private type alias NullaryConstructorsByParentAndId = Dict[String, Dict[Int, List[NullaryConstructorProjection]]]


---
One union index preserves issued constructor identity and physical storage.
A requested Core type must agree with the declaring union's storage.
---
private record NullaryConstructorIndex {
	constructors: NullaryConstructorsByParentAndId
}


---
Exported (not `private`) so the resolve_callables/backend_projection/
match_projection fused walk (`match_projection.project_fused_late_core`)
can build one context once and thread it through the shared walk.
---
record BackendProjectionContext {
	layout: CoreSpecializeLayout,
	constructors: NullaryConstructorIndex,
	callbacks: CoreRuntimeCallbackTable,
	-- Hash-key slot adapters minted before this pass (`hash_key_callbacks`).
	hash_keys: HashKeyAdapterTable
}


private union BackendProjectionLogicalTask:
	ProjectBackendLogicalNode(CoreExpr)
	RebuildProjectedBackendLogicalNode(CoreLogicalOp, CoreType, CoreSourceLoc)


private pure func result_is_option(layout: CoreSpecializeLayout, typ: CoreType) -> Bool:
	match resolve_specialize_type(layout, typ):
		NamedType("Option", args):
			args.length() == 1
		_:
			False


private pure func result_is_result(layout: CoreSpecializeLayout, typ: CoreType) -> Bool:
	match resolve_specialize_type(layout, typ):
		NamedType("Result", args):
			args.length() == 2
		StackResultType(_, _) | BoxedResultType(_, _):
			True
		_:
			False


private pure func semantic_builtin(
	layout: CoreSpecializeLayout,
	name: String,
	result_type: CoreType,
) -> Bool:
	if name == "blorp_dict_get":
		result_is_option(layout, result_type)
	else if name == "blorp_option_some" or name == "blorp_option_none":
		result_is_option(layout, result_type)
	else if name == "blorp_result_ok" or name == "blorp_result_err":
		result_is_result(layout, result_type)
	else if (
		name == "blorp_vector_get_opt"
		or name == "blorp_matrix_get_opt"
		or name == "blorp_channel_new"
		or name == "blorp_channel_send"
		or name == "blorp_channel_try_send"
		or name == "blorp_channel_try_send_status"
		or name == "blorp_channel_send_timeout"
		or name == "blorp_channel_send_timeout_status"
		or name == "blorp_channel_try_send_attempt"
		or name == "blorp_channel_send_timeout_attempt"
		or name == "blorp_channel_try_recv_attempt"
		or name == "blorp_channel_recv_timeout_attempt"
	):
		True
	else:
		False


private pure func list_parallel_builtin(name: String) -> Bool:
	(
		name == "blorp_filter_parallel"
		or name == "blorp_filter_parallel_with"
		or name == "blorp_map_parallel"
		or name == "blorp_map_parallel_with"
		or name == "blorp_zip_parallel"
		or name == "blorp_zip_parallel_with"
		or is_list_filter_map_parallel_builtin(name)
	)


private pure func list_parallel_semantic_arity(name: String) -> Option[Int]:
	if name == "blorp_map_parallel":
		Some(3)
	else if name == "blorp_zip_parallel":
		Some(4)
	else if name == "blorp_map_parallel_with":
		Some(4)
	else if name == "blorp_zip_parallel_with":
		Some(5)
	else if is_list_filter_map_parallel_builtin(name):
		Some(3)
	else:
		None


private pure func list_parallel_args(
	layout: CoreSpecializeLayout,
	name: String,
	result_type: CoreType,
) -> CoreDirectRuntimeArgs:
	match list_parallel_semantic_arity(name):
		Some(semantic_arity):
			DirectRuntimeArgsAppendListParallelLayout({
				semantic_arity = semantic_arity,
				layout = specialize_list_layout(layout, result_type),
			})
		None:
			DirectRuntimeArgsAsWritten


private pure func direct_runtime_result(
	name: String,
	result_type: CoreType,
) -> CoreDirectRuntimeResult:
	match result_type:
		StackResultType(_, _):
			DirectRuntimeResultStackResultFromBoxed
		_:
			if list_parallel_builtin(name):
				DirectRuntimeResultCast("blorp_List*")
			else if (
				name == "blorp_tensor_add_scaled_f64_cow"
				or name == "blorp_tensor_add_scaled_f32_cow"
			):
				DirectRuntimeResultCast("blorp_Vector*")
			else:
				DirectRuntimeResultAsWritten


private pure func direct_runtime_call(
	layout: CoreSpecializeLayout,
	name: String,
	result_type: CoreType,
) -> CoreCallKind:
	DirectRuntimeCall({
		name = name,
		args = list_parallel_args(layout, name, result_type),
		result = direct_runtime_result(name, result_type),
	})


private pure func tensor_parallel_builtin(name: String) -> Bool:
	(
		name == "blorp_matrix_map"
		or name == "blorp_matrix_map_indexed"
		or name == "blorp_matrix_zip_map"
		or name == "blorp_mmap_flat_indexed_parallel"
		or name == "blorp_mmap_indexed_parallel"
		or name == "blorp_mmap_parallel"
		or name == "blorp_mzip_indexed_parallel"
		or name == "blorp_mzip_parallel"
		or name == "blorp_vmap_parallel"
		or name == "blorp_vmap_indexed_parallel"
		or name == "blorp_vzip_parallel"
	)


private pure func tensor_parallel_layout(
	layout: CoreSpecializeLayout,
	result_type: CoreType,
) -> CoreTensorParallelLayout:
	match resolve_specialize_type(layout, result_type):
		TensorType(info):
			match resolve_specialize_type(layout, info.element_type):
				NamedType("Float", []):
					TensorParallelRawScalarLayout(TensorFloat64Elements)
				NamedType("Float32", []):
					TensorParallelRawScalarLayout(TensorFloat32Elements)
				NamedType("Int", []):
					TensorParallelRawScalarLayout(TensorInt64Elements)
				InlineRecordType(name):
					TensorParallelInlineStructLayout(name)
				_:
					TensorParallelPointerLayout
		_:
			TensorParallelPointerLayout


private pure func tensor_raw_fill_kind(
	layout: CoreSpecializeLayout,
	result_type: CoreType,
) -> Option[CoreTensorRawScalarKind]:
	match resolve_specialize_type(layout, result_type):
		TensorType(info):
			match resolve_specialize_type(layout, info.element_type):
				NamedType("Int", []):
					Some(TensorInt64Elements)
				NamedType("Float", []):
					Some(TensorFloat64Elements)
				NamedType("Float32", []):
					Some(TensorFloat32Elements)
				_:
					None
		_:
			None


private pure func project_ranked_tensor_fill(
	layout: CoreSpecializeLayout,
	name: String,
	args: List[CoreExpr],
	result_type: CoreType,
	loc: CoreSourceLoc,
) -> Option[CoreExpr]:
	if not ((
		name == "blorp_tensor3_new"
		or name == "blorp_tensor4_new"
		or name == "blorp_tensor5_new"
	)):
		None
	else:
		match args:
			[value, ...dims]:
				raw_kind ?= tensor_raw_fill_kind(layout, result_type)
				Some(
					TensorRawFillExpr(
						{
							raw_kind = raw_kind,
							value = value,
							dims = dims
						},
						result_type,
						loc,
					),
				)
			[]:
				None


private pure func list_callback_call_kind(
	layout: CoreSpecializeLayout,
	callbacks: CoreRuntimeCallbackTable,
	args: List[CoreExpr],
) -> Option[CoreCallKind]:
	if args.length() != 1:
		None
	else:
		list_arg ?= args.get(0)

		element_type ?= match resolve_specialize_type(layout, core_expr_type(list_arg)):
			NamedType("List", element_types):
				if element_types.length() == 1:
					element_types.get(0)
				else:
					None
			_:
				None

		callback ?= find_runtime_callback(callbacks, StringableToStringCallback, element_type)
		elements: CoreListToStringElements = match element_type:
			InlineRecordType(record_name):
				InlineRecordListToStringElements(record_name)
			_:
				PointerListToStringElements
		Some(ListToStringCall(callback, elements))


private pure func dict_key_type(
	layout: CoreSpecializeLayout,
	result_type: CoreType,
) -> Option[CoreType]:
	dict_types ?= named_type_arguments(layout, result_type, "Dict")

	if dict_types.length() == 2:
		dict_types.get(0)
	else:
		None


private pure func dict_constructor(
	layout: CoreSpecializeLayout,
	hash_keys: HashKeyAdapterTable,
	result_type: CoreType,
) -> Option[CoreHashContainerConstructor]:
	key_type ?= dict_key_type(layout, result_type)
	Some(bound_hash_container_constructor(layout, hash_keys, key_type))


private pure func set_constructor(
	layout: CoreSpecializeLayout,
	hash_keys: HashKeyAdapterTable,
	result_type: CoreType,
) -> Option[CoreHashContainerConstructor]:
	set_types ?= named_type_arguments(layout, result_type, "Set")

	element_type ?= if set_types.length() == 1:
		set_types.get(0)
	else:
		None

	Some(bound_hash_container_constructor(layout, hash_keys, element_type))


---
A constructor runtime projection pinned to an opaque key's impls, bound to
their slot adapters; `container_type` is the Dict or Set it builds. Pinning
read the unerased key; here the key is already its representation, which is
what the adapters unbox, so a plain resolved lookup is the right one.
---
private pure func bound_pinned_constructor(
	layout: CoreSpecializeLayout,
	hash_keys: HashKeyAdapterTable,
	constructor: CoreHashContainerConstructor,
	container_type: CoreType,
) -> CoreHashContainerConstructor:
	key_type: Option[CoreType] = match dict_key_type(layout, container_type):
		Some(key):
			Some(key)
		None:
			single_named_type_argument(layout, container_type, "Set")

	match key_type:
		Some(key):
			bound_pinned_hash_container_constructor(
				layout,
				hash_keys,
				constructor,
				resolve_specialize_type(layout, key),
			)
		None:
			constructor


private pure func custom_dict_call_kind(
	layout: CoreSpecializeLayout,
	hash_keys: HashKeyAdapterTable,
	result_type: CoreType,
) -> Option[CoreCallKind]:
	constructor ?= dict_constructor(layout, hash_keys, result_type)
	Some(DictWithCapacityCall(constructor))


private pure func project_empty_custom_dict(
	layout: CoreSpecializeLayout,
	hash_keys: HashKeyAdapterTable,
	result_type: CoreType,
	loc: CoreSourceLoc,
) -> Option[CoreExpr]:
	dict_types ?= named_type_arguments(layout, result_type, "Dict")

	value_type ?= if dict_types.length() == 2:
		dict_types.get(1)
	else:
		None

	constructor ?= dict_constructor(layout, hash_keys, result_type)

	Some(
		DictConstructExpr(
			{
				constructor = constructor,
				entries = [],
				value_needs_release = boxed_storage_needs_release(
					layout,
					resolve_specialize_type(layout, value_type),
				)
			},
			result_type,
			loc,
		),
	)


private pure func project_empty_set(
	layout: CoreSpecializeLayout,
	hash_keys: HashKeyAdapterTable,
	result_type: CoreType,
	loc: CoreSourceLoc,
) -> Option[CoreExpr]:
	constructor ?= set_constructor(layout, hash_keys, result_type)
	Some(SetAllocExpr(constructor, result_type, loc))


---
Lowers a Dict literal whose keys hash through Hashable and Equatable here,
rather than in the later dict-literal ownership pass, so the literal names
its key callbacks before dead-code elimination runs. Other literals are left
for that pass.
---
private pure func project_trait_keyed_dict_literal(
	layout: CoreSpecializeLayout,
	hash_keys: HashKeyAdapterTable,
	entries: List[CoreDictLiteralEntry],
	typ: CoreType,
	loc: CoreSourceLoc,
) -> Option[CoreExpr]:
	key_type ?= dict_key_type(layout, typ)

	match hash_key_strategy(layout, key_type):
		TraitHashKeys:
			lower_trait_keyed_dict_literal(
				layout,
				bound_hash_container_constructor(layout, hash_keys, key_type),
				entries,
				typ,
				loc,
			)
		WordHashKeys | StringHashKeys | FloatHashKeys | Int128HashKeys:
			None


private pure func project_call_kind(
	layout: CoreSpecializeLayout,
	callbacks: CoreRuntimeCallbackTable,
	hash_keys: HashKeyAdapterTable,
	name: String,
	args: List[CoreExpr],
	result_type: CoreType,
) -> CoreCallKind:
	memory_intrinsic: Option[String] = match args:
		[arg]:
			storage: String = if boxed_storage_needs_release(layout, core_expr_type(arg)):
				"heap"
			else:
				"stack"

			if name == "blorp_is_unique":
				Some("memory_is_unique_${storage}")
			else if name == "blorp_refcount":
				Some("memory_refcount_${storage}")
			else if name == "blorp_size_of":
				Some("memory_size_of_${storage}")
			else:
				None
		[left, _right]:
			storage: String = if boxed_storage_needs_release(layout, core_expr_type(left)):
				"heap"
			else:
				"stack"

			if name == "blorp_same_object":
				Some("memory_same_object_${storage}")
			else:
				None
		_:
			None

	if identity_builtin_on_inline_record(name, args):
		-- Refused: an inline record has no object to compare or count, and the
		-- projected intrinsics would compare struct values as if they were
		-- objects. `record_representation` rejects these after monomorphization;
		-- one that gets here stays an unprojected builtin, which the late Core
		-- invariant `InlineRecordIdentityBuiltinSurvived` reports.
		BuiltinCall(name)
	else if memory_intrinsic.is_some():
		IntrinsicCall(memory_intrinsic.get_or(""))
	else if operation_result_builtin(name):
		operation_result_call_kind(layout, name, result_type).get_or(BuiltinCall(name))
	else if fallible_stream_terminal_builtin(name):
		fallible_stream_terminal_call_kind(layout, name, result_type).get_or(BuiltinCall(name))
	else if name == "blorp_list_to_string_cb":
		list_callback_call_kind(layout, callbacks, args).get_or(BuiltinCall(name))
	else if name == "blorp_dict_with_capacity_custom":
		custom_dict_call_kind(layout, hash_keys, result_type).get_or(BuiltinCall(name))
	else if tensor_parallel_builtin(name):
		TensorParallelCall(
			name,
			tensor_parallel_layout(layout, result_type),
		)
	else if semantic_builtin(layout, name, result_type):
		BuiltinCall(name)
	else if builtin_contract(name, args.length()).is_some():
		direct_runtime_call(layout, name, result_type)
	else:
		BuiltinCall(name)


private pure func identity_builtin_on_inline_record(name: String, args: List[CoreExpr]) -> Bool:
	match (object_identity_builtin(name), args):
		(Some(_), [first, ..._]):
			match core_expr_type(first):
				InlineRecordType(_):
					True
				_:
					False
		_:
			False


private pure func explicit_box(expr: CoreExpr) -> Bool:
	match expr:
		BoxExpr(_, _, _):
			True
		_:
			False


private pure func project_erased_runtime_argument(
	layout: CoreSpecializeLayout,
	arg: CoreExpr,
	loc: CoreSourceLoc,
) -> CoreExpr:
	source_type: CoreType = core_expr_type(arg)

	if explicit_box(arg) or specialize_type_is_pointer(layout, source_type):
		arg
	else:
		BoxExpr(
			{
				kind = boxed_storage_kind(layout, source_type),
				value = arg,
				source_type = source_type
			},
			POINTER_TYPE,
			loc,
		)


private pure func project_runtime_arguments(
	layout: CoreSpecializeLayout,
	name: String,
	args: List[CoreExpr],
	loc: CoreSourceLoc,
) -> List[CoreExpr]:
	if not runtime_builtin_has_erased_arguments(name):
		args
	else:
		var projected: List[CoreExpr] = []
		var index: Int = 0

		for arg in args:
			projected = projected.append(
				if runtime_builtin_uses_erased_argument(name, index):
					project_erased_runtime_argument(layout, arg, loc)
				else:
					arg
			)
			index += 1

		projected


private pure func index_nullary_constructor(
	index: NullaryConstructorsByParentAndId,
	parent_name: String,
	storage: CoreUnionValueStorage,
	source_name: String,
	c_name: String,
	constructor_id: Int,
) -> NullaryConstructorsByParentAndId:
	constructors_by_id: Dict[Int, List[NullaryConstructorProjection]] = index.get_or(
		parent_name,
		{},
	)
	constructors: List[NullaryConstructorProjection] = constructors_by_id.get_or(constructor_id, [])

	index.set(
		parent_name,
		constructors_by_id.set(
			constructor_id,
			constructors.append({
				source_name = source_name,
				c_name = c_name,
				storage = storage,
			}),
		),
	)


private pure func build_nullary_constructor_index(program: CoreProgram) -> NullaryConstructorIndex:
	var constructors: NullaryConstructorsByParentAndId = {}

	for decl in program.decls:
		match decl:
			UnionDecl(union_decl):
				for variant in union_decl.variants:
					if variant.fields.is_empty():
						match variant.def_id:
							Some(constructor_id):
								constructors = index_nullary_constructor(
									constructors,
									union_decl.name,
									core_union_storage_value(union_decl.storage),
									variant.name,
									variant_constructor_symbol(constructor_id),
									constructor_id,
								)
							None:
								void
			_:
				void

	{
		constructors = constructors
	}


private pure func indexed_constructor_c_name(
	index: NullaryConstructorsByParentAndId,
	parent_name: String,
	requested_storage: CoreUnionValueStorage,
	variable: CoreVar,
) -> Option[String]:
	constructor_id ?= variable.def_id
	constructors_by_id ?= index.get(parent_name)
	constructors ?= constructors_by_id.get(constructor_id)
	var result: Option[String] = None

	for constructor in constructors:
		if (
			constructor.storage == requested_storage
			and (variable.name == constructor.source_name or variable.name == constructor.c_name)
		):
			result = Some(constructor.c_name)
			break

	result


private pure func constructor_c_name(
	context: BackendProjectionContext,
	variable: CoreVar,
	typ: CoreType,
) -> Option[String]:
	match typ:
		UnionType(name, storage):
			indexed_constructor_c_name(context.constructors.constructors, name, storage, variable)
		NamedType(_, _):
			match option_runtime_layout(context.layout, typ):
				Some(BoxedOptionLayout):
					indexed_constructor_c_name(context.constructors.constructors, "Option", ManagedUnionValue, variable)
				_:
					None
		_:
			None


private pure func is_stack_result(layout: CoreSpecializeLayout, typ: CoreType) -> Bool:
	match resolve_specialize_type(layout, typ):
		StackResultType(_, _):
			True
		_:
			False


private pure func project_list_alloc(
	layout: CoreSpecializeLayout,
	capacity: CoreExpr,
	result_type: CoreType,
	loc: CoreSourceLoc,
) -> Option[CoreExpr]:
	element_type ?= match resolve_specialize_type(layout, result_type):
		NamedType(name, args):
			if (name == "List" or name == "ParallelList") and args.length() == 1:
				args.get(0)
			else:
				None
		_:
			None

	Some(
		ListAllocExpr(
			{
				layout = specialize_list_layout(layout, result_type),
				capacity = capacity,
				elem_needs_release = specialize_list_element_needs_release(layout, element_type)
			},
			result_type,
			loc,
		),
	)


private pure func tensor_alloc_runtime_name(
	layout: CoreSpecializeLayout,
	result_type: CoreType,
) -> Option[String]:
	match resolve_specialize_type(layout, result_type):
		TensorType(info):
			match resolve_specialize_type(layout, info.element_type):
				NamedType(name, args):
					if not args.is_empty():
						None
					else if name == "Int":
						Some("blorp_vector_new_i64")
					else if name == "Float":
						Some("blorp_vector_new_f64")
					else if name == "Float32":
						Some("blorp_vector_new_f32")
					else:
						None
				_:
					None
		_:
			None


private pure func project_tensor_alloc(
	layout: CoreSpecializeLayout,
	capacity: CoreExpr,
	result_type: CoreType,
	loc: CoreSourceLoc,
) -> Option[CoreExpr]:
	runtime_name ?= tensor_alloc_runtime_name(layout, result_type)
	Some(
		CallExpr(
			direct_runtime_call(layout, runtime_name, result_type),
			VoidExpr(VoidType, loc),
			[capacity],
			result_type,
			loc,
		),
	)


private pure func project_list_get(
	layout: CoreSpecializeLayout,
	list: CoreExpr,
	index: CoreExpr,
	bounds: CoreListAccessBounds,
	result_type: CoreType,
	loc: CoreSourceLoc,
) -> CoreExpr:
	ListGetExpr(
		{
			layout = specialize_list_layout(layout, core_expr_type(list)),
			list = list,
			index = index,
			bounds = bounds
		},
		result_type,
		loc,
	)


private pure func project_list_set(
	layout: CoreSpecializeLayout,
	list: CoreExpr,
	index: CoreExpr,
	value: CoreExpr,
	transfers_ownership: Bool,
	result_type: CoreType,
	loc: CoreSourceLoc,
) -> CoreExpr:
	ListSetExpr(
		{
			layout = specialize_list_layout(layout, core_expr_type(list)),
			list = list,
			index = index,
			value = boxed_storage_value(layout, value, transfers_ownership),
			value_is_stack_result = is_stack_result(layout, core_expr_type(value))
		},
		result_type,
		loc,
	)


private pure func project_intrinsic_expr(
	layout: CoreSpecializeLayout,
	name: String,
	args: List[CoreExpr],
	result_type: CoreType,
	loc: CoreSourceLoc,
) -> Option[CoreExpr]:
	if name == "list_retain_for":
		match args:
			[list, value]:
				Some(
					ListRetainExpr(
						{
							list = list,
							value = list_retain_storage_value(layout, value)
						},
						result_type,
						loc,
					),
				)
			_:
				None
	else if name == "list_set" or name == "list_set_owned":
		match args:
			[list, index, value]:
				Some(
					project_list_set(
						layout,
						list,
						index,
						value,
						name == "list_set_owned",
						result_type,
						loc,
					),
				)
			_:
				None
	else if name == "list_handoff_set_owned":
		match args:
			[list, index, value]:
				match project_list_set(layout, list, index, value, True, result_type, loc):
					ListSetExpr(set, _, _):
						Some(ListHandoffSetOwnedExpr(set, result_type, loc))
					_:
						None
			_:
				None
	else if name == "list_handoff_set_source_slot":
		match args:
			[result, out_index, source, source_index]:
				Some(
					ListHandoffSetSourceSlotExpr(
						{
							result = result,
							out_index = out_index,
							source = source,
							source_index = source_index
						},
						result_type,
						loc,
					),
				)
			_:
				None
	else if name == "list_swap_slots":
		match args:
			[list, left_index, right_index]:
				Some(
					ListSwapExpr(
						{
							layout = specialize_list_layout(layout, core_expr_type(list)),
							list = list,
							left_index = left_index,
							right_index = right_index
						},
						result_type,
						loc,
					),
				)
			_:
				None
	else if name == "list_alloc":
		match args:
			[capacity]:
				project_list_alloc(layout, capacity, result_type, loc)
			_:
				None
	else if name == "tensor_alloc":
		match args:
			[capacity]:
				project_tensor_alloc(layout, capacity, result_type, loc)
			_:
				None
	else if name == "list_get" or name == "list_get_unchecked":
		match args:
			[list, index]:
				bounds: CoreListAccessBounds = if name == "list_get":
					CheckedListAccess
				else:
					ProvenListAccess

				Some(project_list_get(layout, list, index, bounds, result_type, loc))
			_:
				None
	else if name == "string_get_byte":
		match args:
			[source, index]:
				Some(
					StringByteReadExpr(
						{
							source = source,
							index = index
						},
						result_type,
						loc,
					),
				)
			_:
				None
	else if name == "string_set_byte":
		match args:
			[target, index, byte]:
				Some(
					StringByteWriteExpr(
						{
							target = target,
							index = index,
							byte = byte
						},
						result_type,
						loc,
					),
				)
			_:
				None
	else if name == "string_copy_bytes":
		match args:
			[dst, dst_pos, src, src_pos, len]:
				Some(
					StringByteCopyExpr(
						{
							dst = dst,
							dst_pos = dst_pos,
							src = src,
							src_pos = src_pos,
							len = len
						},
						result_type,
						loc,
					),
				)
			_:
				None
	else if name == "string_set_len":
		match args:
			[target, len]:
				Some(
					StringSetLenExpr(
						{
							target = target,
							len = len
						},
						result_type,
						loc,
					),
				)
			_:
				None
	else:
		None


---
Exported so the fused walk can apply this node-only step directly (see
`resolve_current_expr`'s docstring); `project_backend_calls` below keeps
using it through its own unchanged recursive `project_expr`.
---
pure func project_current_expr(
	context: BackendProjectionContext,
	children_projected: CoreExpr,
) -> CoreExpr:
	match children_projected:
		CallExpr(IntrinsicCall(name), _, args, result_type, loc):
			project_intrinsic_expr(
				context.layout,
				name,
				args,
				result_type,
				loc,
			).get_or(children_projected)
		CallExpr(BuiltinCall(name), callee, args, result_type, loc):
			projected_args: List[CoreExpr] = project_runtime_arguments(
				context.layout,
				name,
				args,
				loc,
			)

			match project_ranked_tensor_fill(context.layout, name, args, result_type, loc):
				Some(projected):
					projected
				None:
					if name == "blorp_list_new":
						match args:
							[capacity]:
								project_list_alloc(
									context.layout,
									capacity,
									result_type,
									loc,
								).get_or(children_projected)
							_:
								children_projected
					else if name == "blorp_dict_new_custom" and args.is_empty():
						project_empty_custom_dict(
							context.layout,
							context.hash_keys,
							result_type,
							loc,
						).get_or(children_projected)
					else if name == "blorp_set_new_custom" and args.is_empty():
						project_empty_set(
							context.layout,
							context.hash_keys,
							result_type,
							loc,
						).get_or(children_projected)
					else:
						CallExpr(
							project_call_kind(
								context.layout,
								context.callbacks,
								context.hash_keys,
								name,
								projected_args,
								result_type,
							),
							callee,
							projected_args,
							result_type,
							loc,
						)
		DictConstructExpr(construct, typ, loc):
			match construct.constructor:
				ImplHashContainerConstructor(_, _):
					DictConstructExpr(
						{ construct |
							constructor = bound_pinned_constructor(
								context.layout,
								context.hash_keys,
								construct.constructor,
								typ,
							)
						},
						typ,
						loc,
					)
				_:
					children_projected
		SetAllocExpr(constructor, typ, loc):
			match constructor:
				ImplHashContainerConstructor(_, _):
					SetAllocExpr(
						bound_pinned_constructor(
							context.layout,
							context.hash_keys,
							constructor,
							typ,
						),
						typ,
						loc,
					)
				_:
					children_projected
		CallExpr(DictWithCapacityCall(constructor), callee, args, result_type, loc):
			match constructor:
				ImplHashContainerConstructor(_, _):
					CallExpr(
						DictWithCapacityCall(
							bound_pinned_constructor(
								context.layout,
								context.hash_keys,
								constructor,
								result_type,
							),
						),
						callee,
						args,
						result_type,
						loc,
					)
				_:
					children_projected
		DictExpr(entries, typ, loc):
			empty_set: Option[CoreExpr] = if entries.is_empty():
				project_empty_set(context.layout, context.hash_keys, typ, loc)
			else:
				None

			match empty_set:
				Some(projected):
					projected
				None:
					match children_projected:
						DictExpr(projected_entries, projected_type, projected_loc):
							project_trait_keyed_dict_literal(
								context.layout,
								context.hash_keys,
								projected_entries,
								projected_type,
								projected_loc,
							).get_or(children_projected)
						_:
							children_projected
		VarExpr(variable, typ, loc):
			match constructor_c_name(context, variable, typ):
				Some(c_name):
					VarExpr({ variable | name = c_name }, typ, loc)
				None:
					children_projected
		_:
			children_projected


private pure func project_logical_expr(
	context: BackendProjectionContext,
	expr: CoreExpr,
) -> CoreExpr:
	var tasks: List[BackendProjectionLogicalTask] = [ProjectBackendLogicalNode(expr)]
	var task_count: Int = 1
	var projected: List[CoreExpr] = []
	var projected_count: Int = 0
	var valid: Bool = True

	while valid and task_count > 0:
		task_count -= 1

		match tasks.get(task_count):
			Some(task):
				match task:
					ProjectBackendLogicalNode(current_expr):
						match current_expr:
							LogicalExpr(op, left, right, typ, loc):
								rebuild_task: BackendProjectionLogicalTask = RebuildProjectedBackendLogicalNode(
									op,
									typ,
									loc,
								)

								tasks = if task_count < tasks.length():
									tasks.set(task_count, rebuild_task)
								else:
									tasks.append(rebuild_task)

								task_count += 1

								right_task: BackendProjectionLogicalTask = ProjectBackendLogicalNode(
									right,
								)

								tasks = if task_count < tasks.length():
									tasks.set(task_count, right_task)
								else:
									tasks.append(right_task)

								task_count += 1

								left_task: BackendProjectionLogicalTask = ProjectBackendLogicalNode(
									left,
								)

								tasks = if task_count < tasks.length():
									tasks.set(task_count, left_task)
								else:
									tasks.append(left_task)

								task_count += 1
							_:
								projected_expr: CoreExpr = project_expr(context, current_expr)

								projected = if projected_count < projected.length():
									projected.set(projected_count, projected_expr)
								else:
									projected.append(projected_expr)

								projected_count += 1
					RebuildProjectedBackendLogicalNode(op, typ, loc):
						match (
							projected.get(projected_count - 2),
							projected.get(projected_count - 1),
						):
							(Some(left), Some(right)):
								projected = projected.set(
									projected_count - 2,
									project_current_expr(
										context,
										LogicalExpr(op, left, right, typ, loc),
									),
								)
								projected_count -= 1
							_:
								valid = False
			None:
				valid = False

	if valid and projected_count == 1:
		projected.get_or(0, expr)
	else:
		expr


private pure func project_expr(context: BackendProjectionContext, expr: CoreExpr) -> CoreExpr:
	children_projected: CoreExpr = match expr:
		SeqExpr(_, _):
			CoreTraverse.map_core_sequence_items(expr, func(item): project_expr(context, item))
		LogicalExpr(_, _, _, _, _):
			project_logical_expr(context, expr)
		_:
			CoreTraverse.map_core_expr_children(expr, func(child): project_expr(context, child))

	project_current_expr(context, children_projected)


private pure func project_decl(context: BackendProjectionContext, decl: CoreDecl) -> CoreDecl:
	match decl:
		FunctionDecl(function_info):
			FunctionDecl(
				{ function_info |
					body = function_info.body.map(func(body): project_expr(context, body))
				},
			)
		GlobalDecl(global):
			GlobalDecl({ global | init = project_expr(context, global.init) })
		_:
			decl


---
Exported so the fused walk can build this once from the pre-fusion program
(the layout/constructor/name scan only reads `program.decls`, unaffected by
resolve's or match's own node rewrites) and reuse it across the whole walk,
the same context `project_backend_calls` builds for its own standalone run.
---
pure func build_backend_projection_context(program: CoreProgram) -> BackendProjectionContext:
	layout: CoreSpecializeLayout = build_specialize_layout(program)
	callbacks: CoreRuntimeCallbackTable = build_runtime_callback_table(program)

	{
		layout = layout,
		constructors = build_nullary_constructor_index(program),
		callbacks = callbacks,
		hash_keys = build_hash_key_adapter_table(program, layout, callbacks)
	}


pure func project_backend_calls(program: CoreProgram) -> CoreProgram:
	context: BackendProjectionContext = build_backend_projection_context(program)

	{ program | decls = program.decls.map(func(decl): project_decl(context, decl)) }
