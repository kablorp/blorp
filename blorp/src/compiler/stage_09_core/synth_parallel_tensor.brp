-- Core body synthesis for scoped vector and matrix parallel adapters.
--
-- Core lowering normalizes both the ordinary tensor and its scoped parallel
-- view to the same shape-carrying TensorType. The source typechecker remains
-- responsible for restricting operations available through ParallelVector and
-- ParallelMatrix; after that boundary the adapter is exactly one closure call.
import:
	ir:
		CoreCallKind(ClosureCall),
		CoreExpr(CallExpr, VarExpr),
		CoreFunction,
		CoreParam,
		CoreSourceLoc(SyntheticSourceLoc),
		CoreTensorTypeInfo,
		CoreType(FunctionType, TensorType, VoidType),
	mono: core_mono_type_equal
	synth_name: is_synthesis_candidate, synthesis_source_name


private VECTOR_MODULE: String = "vector"

private MATRIX_MODULE: String = "matrix"


private pure func parameter_value(param: CoreParam) -> CoreExpr:
	VarExpr(param.name, param.typ, SyntheticSourceLoc)


private pure func tensor_info(typ: CoreType) -> Option[CoreTensorTypeInfo]:
	match typ:
		TensorType(info):
			Some(info)
		_:
			None


private pure func tensor_dims_equal(left: CoreTensorTypeInfo, right: CoreTensorTypeInfo) -> Bool:
	core_mono_type_equal(TensorType({
			element_type = VoidType,
			dims = left.dims,
		}), TensorType({
			element_type = VoidType,
			dims = right.dims,
		}))


private pure func callback_matches(
	typ: CoreType,
	input_type: CoreType,
	return_type: CoreType,
) -> Bool:
	match typ:
		FunctionType(is_pure, params, callback_return):
			match params:
				[callback_input]:
					(
						is_pure
						and core_mono_type_equal(callback_input, input_type)
						and core_mono_type_equal(callback_return, return_type)
					)
				_:
					False
		_:
			False


private pure func module_rank(module_name: String) -> Option[Int]:
	if module_name == VECTOR_MODULE:
		Some(1)
	else if module_name == MATRIX_MODULE:
		Some(2)
	else:
		None


pure func synthesize_parallel_tensor_body(function_info: CoreFunction) -> Option[CoreExpr]:
	if not is_synthesis_candidate(function_info):
		None
	else:
		module_name ?= function_info.source_module
		rank ?= module_rank(module_name)
		source_name ?= synthesis_source_name(function_info)

		if source_name != "parallel":
			None
		else:
			match function_info.params:
				[values, body]:
					match (tensor_info(values.typ), tensor_info(function_info.return_type)):
						(Some(value_info), Some(return_info)):
							if (
								value_info.dims.length() == rank
								and return_info.dims.length() == rank
								and tensor_dims_equal(value_info, return_info)
								and callback_matches(
									body.typ,
									values.typ,
									function_info.return_type,
								)
							):
								Some(
									CallExpr(
										ClosureCall,
										parameter_value(body),
										[parameter_value(values)],
										function_info.return_type,
										SyntheticSourceLoc,
									),
								)
							else:
								None
						_:
							None
				_:
					None
