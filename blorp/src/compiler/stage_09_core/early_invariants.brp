-- Invariants for the early Core stages. Later-stage ownership and
-- representation checks remain with their owning stages.
import:
	desugar: core_type_is_string
	ir:
		CoreBinaryOp(AddOp, EqualOp, NotEqualOp),
		CoreCallKind(SelectedDirectCall, UserCall),
		CoreDecl(FunctionDecl, GlobalDecl, ImplDecl),
		CoreExpr(BinaryExpr, BoxExpr, CallExpr, DebugBlockExpr, LetExpr, RawMatchExpr, UnboxExpr),
		CoreFunction,
		CoreProgram,
		CoreSourceLoc(SyntheticSourceLoc),
		CoreType,
		core_expr_type,
	ssa:
		CoreAssignmentShape(ControlFlowAssignment, NoAssignment, StraightLineAssignment),
		classify_assignment_shape,
	std_inline:
		StdInlineTargets,
		collect_targets,
		find_target,
		first_uninlined_std_wrapper_call,
		owned_module,
		target_is_function
	traverse as CoreTraverse
	type_policy as CoreTypePolicy


union CoreEarlyInvariantViolation:
	DebugBlockSurvived(CoreSourceLoc)
	StringOperatorSugarSurvived(String, CoreSourceLoc)
	MutableLocalWithoutAssignmentSurvived(CoreSourceLoc)
	StraightLineMutableAssignmentSurvived(CoreSourceLoc)
	MonoUserCallArgumentTypeUnresolved(String, CoreSourceLoc)
	MonoUserCallReturnTypeUnresolved(String, CoreSourceLoc)
	MonoBoxSourceTypeUnresolved(CoreSourceLoc)
	MonoUnboxTargetTypeUnresolved(CoreSourceLoc)
	RawMatchSurvived(CoreSourceLoc)
	SelectedDirectCallSurvived(Int, CoreSourceLoc)
	InlineableStdWrapperCallSurvived(String, CoreSourceLoc)


private enum CoreMonoInvariantEligibility:
	CheckMonoInvariants
	SkipMonoInvariants


private record CoreSynthInvariantRoots {
	expressions: List[CoreExpr],
	mono_eligibilities: List[CoreMonoInvariantEligibility]
}


pure func core_early_invariant_message(violation: CoreEarlyInvariantViolation) -> String:
	match violation:
		DebugBlockSurvived(_):
			"debug block survived Core debug lowering"
		StringOperatorSugarSurvived(op, _):
			"string operator `${op}` survived Core desugaring"
		MutableLocalWithoutAssignmentSurvived(_):
			"mutable local binding without assignment survived desugaring"
		StraightLineMutableAssignmentSurvived(_):
			"straight-line mutable assignment survived desugaring"
		MonoUserCallArgumentTypeUnresolved(_, _):
			"call-site argument contains an unresolved type variable"
		MonoUserCallReturnTypeUnresolved(_, _):
			"call-site return type contains an unresolved type variable"
		MonoBoxSourceTypeUnresolved(_):
			"box source-type annotation contains an unresolved type variable"
		MonoUnboxTargetTypeUnresolved(_):
			"unbox target-type annotation contains an unresolved type variable"
		RawMatchSurvived(_):
			"raw pattern match survived Core match compilation"
		SelectedDirectCallSurvived(_, _):
			"selected direct call survived Core call resolution"
		InlineableStdWrapperCallSurvived(name, _):
			"inlineable std wrapper `${name}` survived Core std inlining"


pure func core_early_invariant_hint(violation: CoreEarlyInvariantViolation) -> Option[String]:
	match violation:
		DebugBlockSurvived(_):
			Some("Core debug lowering must erase or unwrap every debug block before later passes")
		StringOperatorSugarSurvived(_, _):
			Some("Core desugaring must replace string operators with their explicit builtin calls")
		MutableLocalWithoutAssignmentSurvived(_):
			Some("Core SSA must convert an unassigned mutable binding into an immutable let")
		StraightLineMutableAssignmentSurvived(_):
			Some("Core SSA must rewrite straight-line assignment into versioned immutable lets")
		MonoUserCallArgumentTypeUnresolved(name, _):
			Some(
				"call to user function `${name}` has an argument type that monomorphization did not make concrete",
			)
		MonoUserCallReturnTypeUnresolved(name, _):
			Some(
				"call to user function `${name}` has a return type that monomorphization did not make concrete",
			)
		MonoBoxSourceTypeUnresolved(_):
			Some((
					"monomorphization must make a box source annotation concrete before layout "
					+ "selection"
				))
		MonoUnboxTargetTypeUnresolved(_):
			Some((
					"monomorphization must make an unbox target annotation concrete before layout "
					+ "selection"
				))
		RawMatchSurvived(_):
			Some("Core match compilation must lower every raw match to a semantic decision tree")
		SelectedDirectCallSurvived(def_id, _):
			Some(
				"Core call resolution must classify selected function identity `${def_id.to_string()}` before specialization",
			)
		InlineableStdWrapperCallSurvived(_, _):
			Some("Core std inlining must expand every allowlisted resolved wrapper call")


private pure func debug_violations(expr: CoreExpr) -> List[CoreEarlyInvariantViolation]:
	match expr:
		DebugBlockExpr(_, _, loc):
			[DebugBlockSurvived(loc)]
		_:
			[]


private pure func string_operator_name(op: CoreBinaryOp) -> String:
	match op:
		AddOp:
			"+"
		EqualOp:
			"=="
		NotEqualOp:
			"!="
		_:
			"string operator"


private pure func string_add_operator_violations(
	expr: CoreExpr,
) -> List[CoreEarlyInvariantViolation]:
	match expr:
		BinaryExpr(AddOp, left, _, _, loc):
			if core_type_is_string(core_expr_type(left)):
				[StringOperatorSugarSurvived("+", loc)]
			else:
				[]
		_:
			[]


private pure func string_equality_operator_violations(
	expr: CoreExpr,
) -> List[CoreEarlyInvariantViolation]:
	match expr:
		BinaryExpr(op, left, _, _, loc):
			if core_type_is_string(core_expr_type(left)) and (op == EqualOp or op == NotEqualOp):
				[StringOperatorSugarSurvived(string_operator_name(op), loc)]
			else:
				[]
		_:
			[]


private pure func mutable_local_violations(expr: CoreExpr) -> List[CoreEarlyInvariantViolation]:
	match expr:
		LetExpr(variable, True, _, _, body):
			match classify_assignment_shape(variable.name, body):
				NoAssignment:
					[MutableLocalWithoutAssignmentSurvived(SyntheticSourceLoc)]
				StraightLineAssignment:
					[StraightLineMutableAssignmentSurvived(SyntheticSourceLoc)]
				ControlFlowAssignment:
					[]
		_:
			[]


private pure func mono_violations(expr: CoreExpr) -> List[CoreEarlyInvariantViolation]:
	match expr:
		CallExpr(UserCall(name, _, _), _, args, result_type, loc):
			var violations: List[CoreEarlyInvariantViolation] = []

			for arg in args:
				if CoreTypePolicy.core_type_has_unresolved_mono_parameters(core_expr_type(arg)):
					violations = violations.append(MonoUserCallArgumentTypeUnresolved(name, loc))

			if CoreTypePolicy.core_type_has_unresolved_mono_parameters(result_type):
				violations = violations.append(MonoUserCallReturnTypeUnresolved(name, loc))

			violations
		BoxExpr(box, _, loc):
			if CoreTypePolicy.core_type_has_unresolved_mono_parameters(box.source_type):
				[MonoBoxSourceTypeUnresolved(loc)]
			else:
				[]
		UnboxExpr(_, _, result_type, loc):
			if CoreTypePolicy.core_type_has_unresolved_mono_parameters(result_type):
				[MonoUnboxTargetTypeUnresolved(loc)]
			else:
				[]
		_:
			[]


private pure func match_violations(expr: CoreExpr) -> List[CoreEarlyInvariantViolation]:
	match expr:
		RawMatchExpr(_, _, _, loc):
			[RawMatchSurvived(loc)]
		_:
			[]


private pure func resolve_violations(expr: CoreExpr) -> List[CoreEarlyInvariantViolation]:
	match expr:
		CallExpr(SelectedDirectCall(def_id), _, _, _, loc):
			[SelectedDirectCallSurvived(def_id, loc)]
		_:
			[]


private pure func program_expr_roots(program: CoreProgram) -> List[CoreExpr]:
	var roots: List[CoreExpr] = []

	for decl in program.decls:
		match decl:
			FunctionDecl(function):
				match function.body:
					Some(body):
						roots = roots.append(body)
					None:
						void
			GlobalDecl(global):
				roots = roots.append(global.init)
			ImplDecl(impl):
				for method in impl.methods:
					match method.body:
						Some(body):
							roots = roots.append(body)
						None:
							void
			_:
				void

	roots


private pure func program_monomorphic_expr_roots(program: CoreProgram) -> List[CoreExpr]:
	var roots: List[CoreExpr] = []

	for decl in program.decls:
		match decl:
			FunctionDecl(function):
				if function.type_params.is_empty():
					match function.body:
						Some(body):
							roots = roots.append(body)
						None:
							void
			GlobalDecl(global):
				roots = roots.append(global.init)
			ImplDecl(impl):
				if impl.type_params.is_empty():
					for method in impl.methods:
						if method.type_params.is_empty():
							match method.body:
								Some(body):
									roots = roots.append(body)
								None:
									void
			_:
				void

	roots


private pure func program_synth_invariant_roots(program: CoreProgram) -> CoreSynthInvariantRoots:
	var expressions: List[CoreExpr] = []
	var mono_eligibilities: List[CoreMonoInvariantEligibility] = []

	for decl in program.decls:
		match decl:
			FunctionDecl(function):
				match function.body:
					Some(body):
						eligibility: CoreMonoInvariantEligibility = if function.type_params.is_empty():
							CheckMonoInvariants
						else:
							SkipMonoInvariants

						expressions = expressions.append(body)
						mono_eligibilities = mono_eligibilities.append(eligibility)
					None:
						void
			GlobalDecl(global):
				expressions = expressions.append(global.init)
				mono_eligibilities = mono_eligibilities.append(CheckMonoInvariants)
			ImplDecl(impl):
				for method in impl.methods:
					match method.body:
						Some(body):
							eligibility: CoreMonoInvariantEligibility = if (
								impl.type_params.is_empty()
								and method.type_params.is_empty()
							):
								CheckMonoInvariants
							else:
								SkipMonoInvariants

							expressions = expressions.append(body)
							mono_eligibilities = mono_eligibilities.append(eligibility)
						None:
							void
			_:
				void

	{
		expressions = expressions,
		mono_eligibilities = mono_eligibilities
	}


private pure func check_expr_roots(
	roots: List[CoreExpr],
	check: pure (CoreExpr) -> List[CoreEarlyInvariantViolation],
) -> List[CoreEarlyInvariantViolation]:
	var violations: List[CoreEarlyInvariantViolation] = []
	var pending: List[CoreExpr] = roots
	var index: Int = 0

	while index < pending.length():
		match pending.get(index):
			Some(expr):
				violations = violations.concat(check(expr))

				for child in CoreTraverse.immediate_core_expr_children(expr):
					pending = pending.append(child)
			None:
				break

		index += 1

	violations


private pure func check_program_invariants(
	program: CoreProgram,
	check: pure (CoreExpr) -> List[CoreEarlyInvariantViolation],
) -> List[CoreEarlyInvariantViolation]:
	check_expr_roots(program_expr_roots(program), check)


pure func check_debug_invariants(program: CoreProgram) -> List[CoreEarlyInvariantViolation]:
	check_program_invariants(program, debug_violations)


pure func check_desugar_invariants(program: CoreProgram) -> List[CoreEarlyInvariantViolation]:
	check_program_invariants(
		program,
		func(expr): string_add_operator_violations(expr)
			.concat(string_equality_operator_violations(expr))
			.concat(mutable_local_violations(expr)),
	)


pure func check_mono_invariants(program: CoreProgram) -> List[CoreEarlyInvariantViolation]:
	check_expr_roots(program_monomorphic_expr_roots(program), mono_violations)


pure func check_synth_invariants(program: CoreProgram) -> List[CoreEarlyInvariantViolation]:
	roots: CoreSynthInvariantRoots = program_synth_invariant_roots(program)
	var debug_family: List[CoreEarlyInvariantViolation] = []
	var string_equality: List[CoreEarlyInvariantViolation] = []
	var mono: List[CoreEarlyInvariantViolation] = []
	var pending: List[CoreExpr] = roots.expressions
	var pending_mono_eligibilities: List[CoreMonoInvariantEligibility] = roots.mono_eligibilities
	var index: Int = 0

	while index < pending.length():
		match pending.get(index):
			Some(expr):
				eligibility: CoreMonoInvariantEligibility = pending_mono_eligibilities
					.get(index)
					.get_or(CheckMonoInvariants)

				for violation in debug_violations(expr):
					debug_family = debug_family.append(violation)

				for violation in string_equality_operator_violations(expr):
					string_equality = string_equality.append(violation)

				match eligibility:
					CheckMonoInvariants:
						for violation in mono_violations(expr):
							mono = mono.append(violation)
					SkipMonoInvariants:
						void

				for child in CoreTraverse.immediate_core_expr_children(expr):
					pending = pending.append(child)
					pending_mono_eligibilities = pending_mono_eligibilities.append(eligibility)
			None:
				break

		index += 1

	debug_family
		.concat(string_equality)
		.concat(mono)


pure func check_match_invariants(program: CoreProgram) -> List[CoreEarlyInvariantViolation]:
	check_program_invariants(program, match_violations)


---
`pending` is a stack (push children, pop the top) rather than an
append-only queue, so live memory tracks the traversal frontier instead of
growing to the size of the whole program before it is torn down.

`top` is the stack's logical length, separate from `pending.length()`.
Popping only decrements `top`; it never calls `drop_last`, which is
`self.take(self.length() - 1)` under the hood and copies the whole backing
array on every pop instead of truncating in place. Pushing reuses a slot
below `top` via `set` when one exists, or `append`s past it otherwise, so
`pending` only grows to the maximum depth ever reached and both push and pop
are O(1) on the list's own COW machinery (`pending` is a uniquely owned
`var` local reassigned on every step).
---
pure func check_resolve_invariants(program: CoreProgram) -> List[CoreEarlyInvariantViolation]:
	var resolve: List[CoreEarlyInvariantViolation] = []
	var string_add: List[CoreEarlyInvariantViolation] = []
	var pending: List[CoreExpr] = program_expr_roots(program)
	var top: Int = pending.length()

	while top > 0:
		match pending.get(top - 1):
			Some(expr):
				top -= 1

				for violation in resolve_violations(expr):
					resolve = resolve.append(violation)

				for violation in string_add_operator_violations(expr):
					string_add = string_add.append(violation)

				for child in CoreTraverse.immediate_core_expr_children(expr):
					pending = if top < pending.length():
						pending.set(top, child)
					else:
						pending.append(child)

					top += 1
			None:
				break

	resolve.concat(string_add)


pure func check_std_inline_invariants(program: CoreProgram) -> List[CoreEarlyInvariantViolation]:
	match first_uninlined_std_wrapper_call(program):
		Some((name, loc)):
			[InlineableStdWrapperCallSurvived(name, loc)]
		None:
			[]


private record CoreResolveInlineWalk {
	resolve: List[CoreEarlyInvariantViolation],
	string_add: List[CoreEarlyInvariantViolation],
	wrapper: Option[CoreEarlyInvariantViolation]
}

---
One traversal of `root` that gathers both the resolve-family violations
(`SelectedDirectCallSurvived`, `StringOperatorSugarSurvived`) and, when
`check_wrapper` is set, the first surviving inlineable std-wrapper call.
`check_wrapper` stops after the first wrapper hit (matching
`first_target_call`'s short-circuit in std_inline.brp) but the resolve
family keeps walking the whole subtree, since `check_resolve_invariants`
never short-circuits.

Like `check_resolve_invariants`, `top` is the stack's logical length and
popping only decrements it rather than calling `drop_last` (which copies
the whole backing array via `take` on every pop). Pushing reuses a slot
below `top` via `set` when one exists, or `append`s past it otherwise, so
`pending` only grows to the maximum depth ever reached.
---
private pure func walk_resolve_and_wrapper(
	root: CoreExpr,
	targets: StdInlineTargets,
	check_wrapper: Bool,
) -> CoreResolveInlineWalk:
	var resolve: List[CoreEarlyInvariantViolation] = []
	var string_add: List[CoreEarlyInvariantViolation] = []
	var wrapper: Option[CoreEarlyInvariantViolation] = None
	var pending: List[CoreExpr] = [root]
	var top: Int = pending.length()

	while top > 0:
		match pending.get(top - 1):
			Some(expr):
				top -= 1

				for violation in resolve_violations(expr):
					resolve = resolve.append(violation)

				for violation in string_add_operator_violations(expr):
					string_add = string_add.append(violation)

				if check_wrapper and wrapper.is_none():
					match expr:
						CallExpr(UserCall(name, Some(def_id), _), _, _, _, loc):
							if find_target(targets, name, def_id).is_some():
								wrapper = Some(InlineableStdWrapperCallSurvived(name, loc))
							else:
								void
						_:
							void
				else:
					void

				for child in CoreTraverse.immediate_core_expr_children(expr):
					pending = if top < pending.length():
						pending.set(top, child)
					else:
						pending.append(child)

					top += 1
			None:
				break

	{
		resolve = resolve,
		string_add = string_add,
		wrapper = wrapper
	}


private pure func resolve_inline_eligible(
	targets: StdInlineTargets,
	function_info: CoreFunction,
	wrapper_already_found: Bool,
) -> Bool:
	(
		not wrapper_already_found
		and not target_is_function(targets, function_info)
		and not owned_module(function_info.source_module)
	)


---
Fuses `check_resolve_invariants` and `check_std_inline_invariants` into a
single walk of the program so a production compile pays for one traversal
(plus the O(decls) target-collection scan `collect_targets` already does)
instead of the two-to-four separate walks the split predicates used to
cost when they were each wired onto several early-Core passes. Returns the
same violations, in the same resolve-then-string_add-then-wrapper family
order, as `check_resolve_invariants(program).concat(check_std_inline_invariants(program))`.
---
pure func check_resolve_and_std_inline_invariants(
	program: CoreProgram,
) -> List[CoreEarlyInvariantViolation]:
	targets: StdInlineTargets = collect_targets(program)
	var resolve: List[CoreEarlyInvariantViolation] = []
	var string_add: List[CoreEarlyInvariantViolation] = []
	var wrapper: Option[CoreEarlyInvariantViolation] = None

	for decl in program.decls:
		match decl:
			FunctionDecl(function_info):
				match function_info.body:
					Some(body):
						walk: CoreResolveInlineWalk = walk_resolve_and_wrapper(
							body,
							targets,
							resolve_inline_eligible(targets, function_info, wrapper.is_some()),
						)
						resolve = resolve.concat(walk.resolve)
						string_add = string_add.concat(walk.string_add)

						if wrapper.is_none():
							wrapper = walk.wrapper
						else:
							void
					None:
						void
			GlobalDecl(global):
				walk: CoreResolveInlineWalk = walk_resolve_and_wrapper(global.init, targets, False)
				resolve = resolve.concat(walk.resolve)
				string_add = string_add.concat(walk.string_add)
			ImplDecl(impl):
				for method in impl.methods:
					match method.body:
						Some(body):
							walk: CoreResolveInlineWalk = walk_resolve_and_wrapper(
								body,
								targets,
								resolve_inline_eligible(targets, method, wrapper.is_some()),
							)
							resolve = resolve.concat(walk.resolve)
							string_add = string_add.concat(walk.string_add)

							if wrapper.is_none():
								wrapper = walk.wrapper
							else:
								void
						None:
							void
			_:
				void

	wrapper_violations: List[CoreEarlyInvariantViolation] = match wrapper:
		Some(violation):
			[violation]
		None:
			[]

	resolve
		.concat(string_add)
		.concat(wrapper_violations)
