-- Consuming-call specialization before Perceus.
--
-- Detect safe `owned = f(owned, ...)` rewrites, clone the callee with a
-- terminal drop for the consumed parameter, and retarget the assignment call
-- to that clone. Clone identity includes name and definition id, compiled
-- match bodies are rewritten recursively, and recursive match fields become
-- owned only when every branch transfers them exactly once.
import:
	ir:
		CoreAccessor(RootAccessor, VariantFieldAccessor),
		CoreCallKind(UserCall),
		CoreConstructorLengthMatch,
		CoreConstructorLengthMatchBranch,
		CoreConstructorLiteralMatch,
		CoreConstructorMatchBody(
			ConstructorMatchBodyExpr,
			ConstructorMatchBodyLength,
			ConstructorMatchBodyLiteral,
		),
		CoreConstructorMatchCase,
		CoreConstructorMatchFallback(
			ConstructorMatchFallbackBindings,
			ConstructorMatchFallbackBody,
			ConstructorMatchFallbackFail,
		),
		CoreDecl(FunctionDecl, GlobalDecl, UnionDecl),
		CoreExpr(
			AssignExpr,
			BoxExpr,
			BorrowLetExpr,
			CallExpr,
			CastExpr,
			ConstructorMatchExpr,
			DropExpr,
			DupExpr,
			IfExpr,
			LetExpr,
			LogicalExpr,
			RecordConstructExpr,
			RecordExpr,
			RecordReuseExpr,
			RecordUpdateExpr,
			SeqExpr,
			UnboxExpr,
			VarExpr,
		),
		CoreFunction,
		CoreFunctionKind(
			BuiltinFunction,
			ClosureBodyFunction,
			ForeignFunction,
			ProgramEntrypointFunction,
			UnresolvedBuiltinFunction,
			UserFunction,
		),
		CoreGlobal,
		CoreLiteralMatchFallback(
			LiteralMatchFallbackBindings,
			LiteralMatchFallbackBody,
			LiteralMatchFallbackFail,
		),
		CoreMatchBinding,
		CoreMatchBindingMode(MatchBorrowBindingMode, MatchOwnBindingMode),
		CoreParam,
		CoreProgram,
		CoreReleasePolicy(ArcReleasePolicy),
		CoreSourceLoc(SyntheticSourceLoc),
		CoreType(
			BoxedResultType,
			EnumType,
			FunctionType,
			HeapRecordType,
			NamedType,
			RangeType,
			SelfType,
			StackResultType,
			TensorType,
			TupleType,
			TypeParameterType,
			UnionType,
			ValueRecordType,
			VoidType,
		),
		CoreUnionDecl,
		CoreUnionField,
		CoreUnionVariant,
		CoreVar,
		core_expr_type,
		core_program_max_declared_definition_id,
		core_var_equal,
	traverse as CoreTraverse


private record CloneKey {
	original_name: String,
	original_def_id: Int,
	arg_index: Int
}


private record CloneCandidate {
	key: CloneKey,
	param_type: CoreType,
	clone_name: String,
	clone_def_id: Int
}


private record ConsumeSpecializeState {
	unions: List[CoreUnionDecl],
	next_def_id: Int,
	candidates: List[CloneCandidate],
	used_clone_keys: List[CloneKey]
}


private record CloneTarget {
	key: CloneKey,
	clone_name: String,
	clone_def_id: Int
}


private struct OwnedUseAnalysis {
	safe: Bool,
	min_count: Int,
	max_count: Int
}


private EMPTY_OWNED_USE: OwnedUseAnalysis = {
	safe = True,
	min_count = 0,
	max_count = 0
}

private UNSAFE_OWNED_USE: OwnedUseAnalysis = {
	safe = False,
	min_count = 0,
	max_count = 0
}


private pure func core_type_lists_equal(left: List[CoreType], right: List[CoreType]) -> Bool:
	match left:
		[]:
			match right:
				[]:
					True
				[right_head, ...right_tail]:
					False
		[left_head, ...left_tail]:
			match right:
				[]:
					False
				[right_head, ...right_tail]:
					(
						core_type_equal(left_head, right_head)
						and core_type_lists_equal(left_tail, right_tail)
					)


private pure func core_type_equal(left: CoreType, right: CoreType) -> Bool:
	match left:
		VoidType:
			match right:
				VoidType:
					True
				_:
					False
		NamedType(left_name, left_args):
			match right:
				NamedType(right_name, right_args):
					left_name == right_name and core_type_lists_equal(left_args, right_args)
				_:
					False
		TypeParameterType(left_name):
			match right:
				TypeParameterType(right_name):
					left_name == right_name
				_:
					False
		SelfType:
			match right:
				SelfType:
					True
				_:
					False
		StackResultType(left_ok, left_err):
			match right:
				StackResultType(right_ok, right_err):
					core_type_equal(left_ok, right_ok) and core_type_equal(left_err, right_err)
				_:
					False
		BoxedResultType(left_ok, left_err):
			match right:
				BoxedResultType(right_ok, right_err):
					core_type_equal(left_ok, right_ok) and core_type_equal(left_err, right_err)
				_:
					False
		FunctionType(left_pure, left_params, left_return):
			match right:
				FunctionType(right_pure, right_params, right_return):
					(
						left_pure == right_pure
						and core_type_lists_equal(left_params, right_params)
						and core_type_equal(left_return, right_return)
					)
				_:
					False
		EnumType(left_name):
			match right:
				EnumType(right_name):
					left_name == right_name
				_:
					False
		ValueRecordType(left_name):
			match right:
				ValueRecordType(right_name):
					left_name == right_name
				_:
					False
		HeapRecordType(left_name):
			match right:
				HeapRecordType(right_name):
					left_name == right_name
				_:
					False
		UnionType(left_name):
			match right:
				UnionType(right_name):
					left_name == right_name
				_:
					False
		RangeType:
			match right:
				RangeType:
					True
				_:
					False
		TensorType(info):
			match right:
				TensorType(info):
					True
				_:
					False
		TupleType(left_items):
			match right:
				TupleType(right_items):
					core_type_lists_equal(left_items, right_items)
				_:
					False


private pure func direct_var(expr: CoreExpr) -> Option[CoreVar]:
	match expr:
		VarExpr(variable, typ, loc):
			Some(variable)
		CastExpr(inner, typ, loc):
			direct_var(inner)
		UnboxExpr(kind, inner, typ, loc):
			direct_var(inner)
		BoxExpr(box, typ, loc):
			direct_var(box.value)
		_:
			None


private pure func max_int(left: Int, right: Int) -> Int:
	if left > right:
		left
	else:
		right


private pure func min_int(left: Int, right: Int) -> Int:
	if left < right:
		left
	else:
		right


private pure func collect_unions(program: CoreProgram) -> List[CoreUnionDecl]:
	var unions: List[CoreUnionDecl] = []

	for decl in program.decls:
		match decl:
			UnionDecl(union_decl):
				unions = unions.append(union_decl)
			_:
				void

	unions


private pure func make_state(program: CoreProgram) -> ConsumeSpecializeState:
	var state: ConsumeSpecializeState = {
		unions = collect_unions(program),
		next_def_id = core_program_max_declared_definition_id(program) + 1,
		candidates = [],
		used_clone_keys = []
	}

	for decl in program.decls:
		match decl:
			FunctionDecl(func_info):
				state = collect_function_clone_candidates(state, func_info)
			_:
				void

	state


private pure func find_union(state: ConsumeSpecializeState, name: String) -> Option[CoreUnionDecl]:
	var found: Option[CoreUnionDecl] = None

	for union_decl in state.unions:
		if union_decl.name == name:
			found = Some(union_decl)
		else:
			void

	found


private pure func find_union_variant(
	state: ConsumeSpecializeState,
	type_name: String,
	constructor: String,
) -> Option[CoreUnionVariant]:
	match find_union(state, type_name):
		Some(union_decl):
			var found: Option[CoreUnionVariant] = None

			for variant in union_decl.variants:
				if variant.name == constructor:
					found = Some(variant)
				else:
					void

			found
		None:
			None


private pure func source_managed_type_name(
	state: ConsumeSpecializeState,
	typ: CoreType,
) -> Option[String]:
	match typ:
		UnionType(name):
			find_union(state, name).map(func(union_decl): union_decl.name)
		HeapRecordType(name):
			Some(name)
		NamedType(name, args):
			None
		_:
			None


private pure func direct_variant_field_type(
	state: ConsumeSpecializeState,
	scrutinee_type: CoreType,
	constructor: String,
	field_index: Int,
) -> Option[CoreType]:
	match scrutinee_type:
		UnionType(type_name):
			match find_union_variant(state, type_name, constructor):
				Some(variant):
					match variant.fields.get(field_index):
						Some(field):
							Some(field.typ)
						None:
							None
				None:
					None
		_:
			None


private pure func alias_get(aliases: List[(CoreVar, Bool)], variable: CoreVar) -> Bool:
	var found: Bool = False

	for entry in aliases:
		if core_var_equal(entry[0], variable):
			found = entry[1]
		else:
			void

	found


private pure func alias_set(
	aliases: List[(CoreVar, Bool)],
	variable: CoreVar,
	value: Bool,
) -> List[(CoreVar, Bool)]:
	var result: List[(CoreVar, Bool)] = [(variable, value)]

	for entry in aliases:
		if core_var_equal(entry[0], variable):
			void
		else:
			result = result.append(entry)

	result


private pure func result_aliases_var(
	state: ConsumeSpecializeState,
	target: CoreVar,
	aliases: List[(CoreVar, Bool)],
	expr: CoreExpr,
) -> Bool:
	match expr:
		VarExpr(variable, typ, loc):
			if core_var_equal(variable, target):
				True
			else:
				alias_get(aliases, variable)
		LetExpr(variable, is_mutable, typ, rhs, body):
			bind_aliases: Bool = result_aliases_var(state, target, aliases, rhs)
			result_aliases_var(
				state,
				target,
				alias_set(aliases, variable, bind_aliases),
				body,
			)
		BorrowLetExpr(variable, typ, rhs, body):
			bind_aliases: Bool = result_aliases_var(state, target, aliases, rhs)
			result_aliases_var(
				state,
				target,
				alias_set(aliases, variable, bind_aliases),
				body,
			)
		SeqExpr(first, second):
			result_aliases_var(state, target, aliases, second)
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			result_aliases_var(state, target, aliases, body)
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			result_aliases_var(state, target, aliases, body)
		CastExpr(inner, typ, loc):
			result_aliases_var(state, target, aliases, inner)
		BoxExpr(box, typ, loc):
			result_aliases_var(state, target, aliases, box.value)
		UnboxExpr(kind, inner, typ, loc):
			result_aliases_var(state, target, aliases, inner)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			(
				result_aliases_var(state, target, aliases, then_expr)
				or result_aliases_var(state, target, aliases, else_expr)
			)
		CallExpr(UserCall(constructor, def_id, consumed_args), callee, args, typ, loc):
			match typ:
				UnionType(type_name):
					match find_union_variant(state, type_name, constructor):
						Some(variant):
							var result: Bool = False

							for arg in args:
								if result_aliases_var(state, target, aliases, arg):
									result = True
									break
								else:
									void

							result
						None:
							False
				_:
					False
		CallExpr(kind, callee, args, typ, loc):
			var result: Bool = False

			for arg in args:
				if result_aliases_var(state, target, aliases, arg):
					result = True
					break
				else:
					void

			result
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			scrutinee_aliases: Bool = result_aliases_var(state, target, aliases, scrutinee)
			var result: Bool = False

			for match_case in cases:
				if constructor_match_case_result_aliases_var(
					state,
					target,
					aliases,
					scrutinee_aliases,
					match_case,
				):
					result = True
					break
				else:
					void

			(
				result
				or constructor_match_fallback_result_aliases_var(
					state,
					target,
					aliases,
					scrutinee_aliases,
					fallback,
				)
			)
		RecordExpr(fields, typ, loc) | RecordConstructExpr(_, fields, typ, loc) | RecordUpdateExpr(_, fields, typ, loc) | RecordReuseExpr(_, fields, typ, loc):
			False
		_:
			CoreTraverse
				.immediate_core_expr_children(expr)
				.any(func(child): result_aliases_var(state, target, aliases, child))


private pure func aliases_with_match_bindings(
	aliases: List[(CoreVar, Bool)],
	bindings: List[CoreMatchBinding],
	scrutinee_aliases: Bool,
) -> List[(CoreVar, Bool)]:
	var result: List[(CoreVar, Bool)] = aliases

	for binding in bindings:
		result = alias_set(result, binding.variable, scrutinee_aliases)

	result


private pure func constructor_match_case_result_aliases_var(
	state: ConsumeSpecializeState,
	target: CoreVar,
	aliases: List[(CoreVar, Bool)],
	scrutinee_aliases: Bool,
	match_case: CoreConstructorMatchCase,
) -> Bool:
	case_aliases: List[(CoreVar, Bool)] = aliases_with_match_bindings(
		aliases,
		match_case.bindings,
		scrutinee_aliases,
	)
	constructor_match_body_result_aliases_var(
		state,
		target,
		case_aliases,
		scrutinee_aliases,
		match_case.body,
	)


private pure func constructor_literal_match_result_aliases_var(
	state: ConsumeSpecializeState,
	target: CoreVar,
	aliases: List[(CoreVar, Bool)],
	scrutinee_aliases: Bool,
	match_expr: CoreConstructorLiteralMatch,
) -> Bool:
	var result: Bool = False

	for match_case in match_expr.cases:
		case_aliases: List[(CoreVar, Bool)] = aliases_with_match_bindings(
			aliases,
			match_case.bindings,
			scrutinee_aliases,
		)

		if result_aliases_var(state, target, case_aliases, match_case.body):
			result = True
			break
		else:
			void

	if result:
		True
	else:
		match match_expr.fallback:
			LiteralMatchFallbackBody(body):
				result_aliases_var(state, target, aliases, body)
			LiteralMatchFallbackBindings(bindings, body):
				fallback_aliases: List[(CoreVar, Bool)] = aliases_with_match_bindings(
					aliases,
					bindings,
					scrutinee_aliases,
				)
				result_aliases_var(state, target, fallback_aliases, body)
			LiteralMatchFallbackFail:
				False


private pure func constructor_length_branch_result_aliases_var(
	state: ConsumeSpecializeState,
	target: CoreVar,
	aliases: List[(CoreVar, Bool)],
	scrutinee_aliases: Bool,
	branch: CoreConstructorLengthMatchBranch,
) -> Bool:
	branch_aliases: List[(CoreVar, Bool)] = aliases_with_match_bindings(
		aliases,
		branch.bindings,
		scrutinee_aliases,
	)
	constructor_match_body_result_aliases_var(
		state,
		target,
		branch_aliases,
		scrutinee_aliases,
		branch.body,
	)


private pure func constructor_length_match_result_aliases_var(
	state: ConsumeSpecializeState,
	target: CoreVar,
	aliases: List[(CoreVar, Bool)],
	scrutinee_aliases: Bool,
	match_expr: CoreConstructorLengthMatch,
) -> Bool:
	var result: Bool = False

	for match_case in match_expr.cases:
		if constructor_length_branch_result_aliases_var(
			state,
			target,
			aliases,
			scrutinee_aliases,
			match_case.branch,
		):
			result = True
			break
		else:
			void

	if not result:
		match match_expr.geq:
			Some(geq):
				result = constructor_length_branch_result_aliases_var(
					state,
					target,
					aliases,
					scrutinee_aliases,
					geq.branch,
				)
			None:
				void
	else:
		void

	if not result:
		match match_expr.fallback:
			Some(fallback):
				result = constructor_length_branch_result_aliases_var(
					state,
					target,
					aliases,
					scrutinee_aliases,
					fallback,
				)
			None:
				void
	else:
		void

	result


private pure func constructor_match_body_result_aliases_var(
	state: ConsumeSpecializeState,
	target: CoreVar,
	aliases: List[(CoreVar, Bool)],
	scrutinee_aliases: Bool,
	body: CoreConstructorMatchBody,
) -> Bool:
	match body:
		ConstructorMatchBodyExpr(expr):
			result_aliases_var(state, target, aliases, expr)
		ConstructorMatchBodyLiteral(match_expr):
			constructor_literal_match_result_aliases_var(
				state,
				target,
				aliases,
				scrutinee_aliases,
				match_expr,
			)
		ConstructorMatchBodyLength(match_expr):
			constructor_length_match_result_aliases_var(
				state,
				target,
				aliases,
				scrutinee_aliases,
				match_expr,
			)


private pure func constructor_match_fallback_result_aliases_var(
	state: ConsumeSpecializeState,
	target: CoreVar,
	aliases: List[(CoreVar, Bool)],
	scrutinee_aliases: Bool,
	fallback: CoreConstructorMatchFallback,
) -> Bool:
	match fallback:
		ConstructorMatchFallbackBody(body):
			result_aliases_var(state, target, aliases, body)
		ConstructorMatchFallbackBindings(bindings, body):
			fallback_aliases: List[(CoreVar, Bool)] = aliases_with_match_bindings(
				aliases,
				bindings,
				scrutinee_aliases,
			)
			result_aliases_var(state, target, fallback_aliases, body)
		ConstructorMatchFallbackFail:
			False


private pure func function_is_cloneable(
	state: ConsumeSpecializeState,
	arg_index: Int,
	func_info: CoreFunction,
) -> Bool:
	match func_info.function_kind:
		UserFunction:
			match func_info.body:
				Some(body):
					match func_info.params.get(arg_index):
						Some(param):
							managed_param: Bool = source_managed_type_name(
								state,
								param.typ,
							).is_some()
							returns_same_type: Bool = core_type_equal(
								param.typ,
								func_info.return_type,
							)
							result_does_not_alias_param: Bool = not result_aliases_var(
								state,
								param.name,
								[],
								body,
							)
							managed_param and returns_same_type and result_does_not_alias_param
						None:
							False
				None:
					False
		ProgramEntrypointFunction:
			False
		BuiltinFunction(c_name):
			False
		UnresolvedBuiltinFunction:
			False
		ForeignFunction(_):
			False
		ClosureBodyFunction(abi):
			False


private pure func clone_name(original_name: String, arg_index: Int) -> String:
	"${original_name}__consume_arg${arg_index.to_string()}"


private pure func clone_key(
	original_name: String,
	original_def_id: Int,
	arg_index: Int,
) -> CloneKey:
	{
		original_name = original_name,
		original_def_id = original_def_id,
		arg_index = arg_index
	}


private pure func clone_key_equal(left: CloneKey, right: CloneKey) -> Bool:
	(
		left.original_name == right.original_name
		and left.original_def_id == right.original_def_id
		and left.arg_index == right.arg_index
	)


private pure func clone_callee_var(name: String, def_id: Int) -> CoreVar:
	{
		name = name,
		uniq = 0,
		def_id = Some(def_id)
	}


private pure func rewrite_callee_expr(name: String, def_id: Int, callee: CoreExpr) -> CoreExpr:
	match callee:
		VarExpr(variable, typ, loc):
			VarExpr(
				clone_callee_var(name, def_id),
				typ,
				loc,
			)
		_:
			callee


private pure func is_call_to_function(original: CoreFunction, kind: CoreCallKind) -> Bool:
	match kind:
		UserCall(name, Some(def_id), consumed_args):
			name == original.name and def_id == original.def_id
		_:
			False


private pure func direct_arg_var(args: List[CoreExpr], index: Int) -> Option[CoreVar]:
	match args.get(index):
		Some(arg):
			direct_var(arg)
		None:
			None


private pure func seq_owned_use(
	left: OwnedUseAnalysis,
	right: OwnedUseAnalysis,
) -> OwnedUseAnalysis:
	{
		safe = left.safe and right.safe,
		min_count = left.min_count + right.min_count,
		max_count = left.max_count + right.max_count
	}


private pure func join_owned_use(
	left: OwnedUseAnalysis,
	right: OwnedUseAnalysis,
) -> OwnedUseAnalysis:
	{
		safe = left.safe and right.safe,
		min_count = min_int(left.min_count, right.min_count),
		max_count = max_int(left.max_count, right.max_count)
	}


private pure func expr_mentions_var(expr: CoreExpr, target: CoreVar) -> Bool:
	direct_mention: Bool = match expr:
		VarExpr(variable, typ, loc):
			core_var_equal(variable, target)
		AssignExpr(variable, rhs, typ, loc):
			core_var_equal(variable, target)
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			core_var_equal(variable, target)
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			core_var_equal(variable, target)
		_:
			False

	(
		direct_mention
		or CoreTraverse
			.immediate_core_expr_children(expr)
			.any(func(child): expr_mentions_var(child, target))
	)


private pure func analyze_exprs_owned_use(
	original: CoreFunction,
	arg_index: Int,
	target: CoreVar,
	exprs: List[CoreExpr],
) -> OwnedUseAnalysis:
	var result: OwnedUseAnalysis = EMPTY_OWNED_USE

	for expr in exprs:
		result = seq_owned_use(
			result,
			analyze_owned_binding_use(original, arg_index, target, expr),
		)

	result


private pure func allowed_owned_call_use(
	original: CoreFunction,
	arg_index: Int,
	target: CoreVar,
	kind: CoreCallKind,
	args: List[CoreExpr],
) -> Bool:
	(
		is_call_to_function(original, kind)
		and direct_arg_var(args, arg_index)
			.map(func(variable): core_var_equal(variable, target))
			.get_or(False)
	)


private pure func analyze_owned_call_args(
	original: CoreFunction,
	arg_index: Int,
	target: CoreVar,
	args: List[CoreExpr],
) -> OwnedUseAnalysis:
	var result: OwnedUseAnalysis = EMPTY_OWNED_USE
	var index: Int = 0

	for arg in args:
		if (
			index == arg_index
			and direct_var(arg)
				.map(func(variable): core_var_equal(variable, target))
				.get_or(False)
		):
			void
		else:
			result = seq_owned_use(
				result,
				analyze_owned_binding_use(original, arg_index, target, arg),
			)

		index += 1

	result


private pure func analyze_owned_binding_use(
	original: CoreFunction,
	arg_index: Int,
	target: CoreVar,
	expr: CoreExpr,
) -> OwnedUseAnalysis:
	match expr:
		VarExpr(variable, typ, loc):
			if core_var_equal(variable, target):
				UNSAFE_OWNED_USE
			else:
				EMPTY_OWNED_USE
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			if core_var_equal(variable, target):
				UNSAFE_OWNED_USE
			else:
				analyze_owned_binding_use(original, arg_index, target, body)
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			if core_var_equal(variable, target):
				UNSAFE_OWNED_USE
			else:
				analyze_owned_binding_use(original, arg_index, target, body)
		CallExpr(kind, callee, args, typ, loc):
			if allowed_owned_call_use(original, arg_index, target, kind, args):
				call_use: OwnedUseAnalysis = {
					safe = True,
					min_count = 1,
					max_count = 1
				}
				seq_owned_use(
					call_use,
					analyze_owned_call_args(original, arg_index, target, args),
				)
			else:
				analyze_exprs_owned_use(original, arg_index, target, args)
		LetExpr(variable, is_mutable, typ, rhs, body):
			rhs_use: OwnedUseAnalysis = analyze_owned_binding_use(original, arg_index, target, rhs)

			if core_var_equal(variable, target):
				rhs_use
			else:
				seq_owned_use(
					rhs_use,
					analyze_owned_binding_use(original, arg_index, target, body),
				)
		BorrowLetExpr(variable, typ, rhs, body):
			rhs_use: OwnedUseAnalysis = analyze_owned_binding_use(original, arg_index, target, rhs)

			if core_var_equal(variable, target):
				rhs_use
			else:
				seq_owned_use(
					rhs_use,
					analyze_owned_binding_use(original, arg_index, target, body),
				)
		SeqExpr(first, second):
			seq_owned_use(
				analyze_owned_binding_use(original, arg_index, target, first),
				analyze_owned_binding_use(original, arg_index, target, second),
			)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			condition_use: OwnedUseAnalysis = analyze_owned_binding_use(
				original,
				arg_index,
				target,
				cond,
			)
			branch_use: OwnedUseAnalysis = join_owned_use(
				analyze_owned_binding_use(original, arg_index, target, then_expr),
				analyze_owned_binding_use(original, arg_index, target, else_expr),
			)
			seq_owned_use(condition_use, branch_use)
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			scrutinee_use: OwnedUseAnalysis = analyze_owned_binding_use(
				original,
				arg_index,
				target,
				scrutinee,
			)
			case_use: OwnedUseAnalysis = analyze_constructor_match_cases_owned_use(
				original,
				arg_index,
				target,
				cases,
			)
			seq_owned_use(scrutinee_use, case_use)
		_:
			if expr_mentions_var(expr, target):
				UNSAFE_OWNED_USE
			else:
				EMPTY_OWNED_USE


private pure func analyze_constructor_match_cases_owned_use(
	original: CoreFunction,
	arg_index: Int,
	target: CoreVar,
	cases: List[CoreConstructorMatchCase],
) -> OwnedUseAnalysis:
	var result: Option[OwnedUseAnalysis] = None

	for match_case in cases:
		case_use: OwnedUseAnalysis = analyze_constructor_match_body_owned_use(
			original,
			arg_index,
			target,
			match_case.body,
		)

		result = match result:
			Some(current):
				Some(join_owned_use(current, case_use))
			None:
				Some(case_use)

	result.get_or(EMPTY_OWNED_USE)


private pure func analyze_constructor_match_body_owned_use(
	original: CoreFunction,
	arg_index: Int,
	target: CoreVar,
	body: CoreConstructorMatchBody,
) -> OwnedUseAnalysis:
	match body:
		ConstructorMatchBodyExpr(expr):
			analyze_owned_binding_use(original, arg_index, target, expr)
		ConstructorMatchBodyLiteral(match_expr):
			EMPTY_OWNED_USE
		ConstructorMatchBodyLength(match_expr):
			EMPTY_OWNED_USE


private pure func can_own_binding(
	original: CoreFunction,
	arg_index: Int,
	binding: CoreMatchBinding,
	body: CoreConstructorMatchBody,
) -> Bool:
	analysis: OwnedUseAnalysis = analyze_constructor_match_body_owned_use(
		original,
		arg_index,
		binding.variable,
		body,
	)

	analysis.safe and analysis.min_count == 1 and analysis.max_count == 1


private pure func direct_owned_binding_candidate(
	state: ConsumeSpecializeState,
	param_type: CoreType,
	binding: CoreMatchBinding,
) -> Bool:
	match binding.mode:
		MatchBorrowBindingMode:
			match binding.accessor:
				VariantFieldAccessor(RootAccessor, union_c_type, constructor, field_index):
					direct_variant_field_type(state, param_type, constructor, field_index)
						.map(func(field_type):
							same_type: Bool = core_type_equal(field_type, param_type)
							managed_field: Bool = source_managed_type_name(
								state,
								field_type,
							).is_some()

							same_type and managed_field
						)
						.get_or(False)
				_:
					False
		MatchOwnBindingMode:
			False


private pure func owned_binding_vars(
	state: ConsumeSpecializeState,
	original: CoreFunction,
	arg_index: Int,
	param_type: CoreType,
	match_case: CoreConstructorMatchCase,
) -> List[CoreVar]:
	var variables: List[CoreVar] = []

	for binding in match_case.bindings:
		if (
			direct_owned_binding_candidate(state, param_type, binding)
			and can_own_binding(original, arg_index, binding, match_case.body)
		):
			variables = variables.append(binding.variable)
		else:
			void

	variables


private pure func list_contains_var(items: List[CoreVar], value: CoreVar) -> Bool:
	var found: Bool = False

	for item in items:
		if core_var_equal(item, value):
			found = True
			break
		else:
			void

	found


private pure func rewrite_owned_recursive_call(
	original: CoreFunction,
	clone: CoreFunction,
	arg_index: Int,
	owned_vars: List[CoreVar],
	expr: CoreExpr,
) -> CoreExpr:
	mapped: CoreExpr = match expr:
		SeqExpr(_, _):
			CoreTraverse.map_core_sequence_items(
				expr,
				func(
					item,
				): rewrite_owned_recursive_call(original, clone, arg_index, owned_vars, item),
			)
		LogicalExpr(_, _, _, _, _):
			CoreTraverse.map_core_logical_tree(
				expr,
				func(
					item,
				): rewrite_owned_recursive_call(original, clone, arg_index, owned_vars, item),
			)
		_:
			CoreTraverse.map_core_expr_children(
				expr,
				func(
					child,
				): rewrite_owned_recursive_call(original, clone, arg_index, owned_vars, child),
			)

	match mapped:
		CallExpr(kind, callee, args, typ, loc):
			if (
				is_call_to_function(original, kind)
				and direct_arg_var(args, arg_index)
					.map(func(variable): list_contains_var(owned_vars, variable))
					.get_or(False)
			):
				CallExpr(
					UserCall(clone.name, Some(clone.def_id), []),
					rewrite_callee_expr(clone.name, clone.def_id, callee),
					args,
					typ,
					loc,
				)
			else:
				mapped
		_:
			mapped


private pure func rewrite_owned_recursive_match_body(
	original: CoreFunction,
	clone: CoreFunction,
	arg_index: Int,
	owned_vars: List[CoreVar],
	body: CoreConstructorMatchBody,
) -> CoreConstructorMatchBody:
	match body:
		ConstructorMatchBodyExpr(expr):
			ConstructorMatchBodyExpr(
				rewrite_owned_recursive_call(
					original,
					clone,
					arg_index,
					owned_vars,
					expr,
				),
			)
		ConstructorMatchBodyLiteral(match_expr):
			ConstructorMatchBodyLiteral(match_expr)
		ConstructorMatchBodyLength(match_expr):
			ConstructorMatchBodyLength(match_expr)


private pure func rewrite_owned_match_case(
	state: ConsumeSpecializeState,
	original: CoreFunction,
	clone: CoreFunction,
	arg_index: Int,
	param_type: CoreType,
	match_case: CoreConstructorMatchCase,
) -> CoreConstructorMatchCase:
	owned_vars: List[CoreVar] = owned_binding_vars(
		state,
		original,
		arg_index,
		param_type,
		match_case,
	)

	if owned_vars.length() == 0:
		match_case
	else:
		var bindings: List[CoreMatchBinding] = []

		for binding in match_case.bindings:
			if list_contains_var(owned_vars, binding.variable):
				bindings = bindings.append({
					variable = binding.variable,
					typ = binding.typ,
					accessor = binding.accessor,
					mode = MatchOwnBindingMode,
				})
			else:
				bindings = bindings.append(binding)

		{ match_case |
			bindings = bindings,
			body = rewrite_owned_recursive_match_body(
				original,
				clone,
				arg_index,
				owned_vars,
				match_case.body,
			)
		}


private pure func rewrite_owned_match_expr(
	state: ConsumeSpecializeState,
	original: CoreFunction,
	clone: CoreFunction,
	arg_index: Int,
	param: CoreParam,
	expr: CoreExpr,
) -> CoreExpr:
	match expr:
		ConstructorMatchExpr(VarExpr(scrutinee, scrutinee_type, scrutinee_loc), release_policy, cases, fallback, typ, loc):
			if core_var_equal(scrutinee, param.name):
				var rewritten_cases: List[CoreConstructorMatchCase] = []

				for match_case in cases:
					rewritten_cases = rewritten_cases.append(
						rewrite_owned_match_case(
							state,
							original,
							clone,
							arg_index,
							param.typ,
							match_case,
						),
					)

				ConstructorMatchExpr(
					VarExpr(scrutinee, scrutinee_type, scrutinee_loc),
					release_policy,
					rewritten_cases,
					fallback,
					typ,
					loc,
				)
			else:
				expr
		_:
			expr


private pure func result_var_for_param(param: CoreParam) -> CoreVar:
	{
		name = "__consume_result_${param.name.name}",
		uniq = 0,
		def_id = None
	}


private pure func make_consuming_clone(
	state: ConsumeSpecializeState,
	original: CoreFunction,
	arg_index: Int,
	clone_def_id: Int,
) -> Option[CoreFunction]:
	match original.params.get(arg_index):
		Some(param):
			match original.body:
				Some(body):
					placeholder: CoreFunction = {
						name = clone_name(original.name, arg_index),
						source_module = original.source_module,
						type_params = original.type_params,
						params = original.params,
						return_type = original.return_type,
						body = None,
						is_pure = original.is_pure,
						function_kind = original.function_kind,
						def_id = clone_def_id,
						loc = original.loc
					}
					rewritten_body: CoreExpr = rewrite_owned_match_expr(
						state,
						original,
						placeholder,
						arg_index,
						param,
						body,
					)
					result_var: CoreVar = result_var_for_param(param)
					result_ref: CoreExpr = VarExpr(
						result_var,
						original.return_type,
						SyntheticSourceLoc,
					)
					drop_then_return: CoreExpr = DropExpr(
						param.name,
						param.typ,
						ArcReleasePolicy,
						result_ref,
						original.return_type,
						SyntheticSourceLoc,
					)

					Some(
						{ placeholder |
							body = Some(
								LetExpr(
									result_var,
									False,
									original.return_type,
									rewritten_body,
									drop_then_return,
								),
							)
						},
					)
				None:
					None
		None:
			None


private pure func collect_function_clone_candidates(
	state: ConsumeSpecializeState,
	func_info: CoreFunction,
) -> ConsumeSpecializeState:
	var current: ConsumeSpecializeState = state
	var arg_index: Int = 0

	for param in func_info.params:
		if function_is_cloneable(current, arg_index, func_info):
			current = { current |
				next_def_id = current.next_def_id + 1,
				candidates = current.candidates.append({
					key = clone_key(func_info.name, func_info.def_id, arg_index),
					param_type = param.typ,
					clone_name = clone_name(func_info.name, arg_index),
					clone_def_id = current.next_def_id,
				})
			}
		else:
			void

		arg_index += 1

	current


private pure func find_clone_target(
	state: ConsumeSpecializeState,
	original_name: String,
	original_def_id: Int,
	arg_index: Int,
	target_type: CoreType,
) -> Option[CloneTarget]:
	var found: Option[CloneTarget] = None

	for candidate in state.candidates:
		if (
			candidate.key.original_name == original_name
			and candidate.key.original_def_id == original_def_id
			and candidate.key.arg_index == arg_index
			and core_type_equal(candidate.param_type, target_type)
		):
			found = Some({
				key = candidate.key,
				clone_name = candidate.clone_name,
				clone_def_id = candidate.clone_def_id,
			})
		else:
			void

	found


private pure func clone_key_used(used_clone_keys: List[CloneKey], key: CloneKey) -> Bool:
	var found: Bool = False

	for used_key in used_clone_keys:
		if clone_key_equal(used_key, key):
			found = True
			break
		else:
			void

	found


private pure func mark_clone_used(
	state: ConsumeSpecializeState,
	key: CloneKey,
) -> ConsumeSpecializeState:
	if clone_key_used(state.used_clone_keys, key):
		state
	else:
		{ state | used_clone_keys = state.used_clone_keys.append(key) }


private pure func call_arg_consumes_target(
	state: ConsumeSpecializeState,
	target: CoreVar,
	target_type: CoreType,
	kind: CoreCallKind,
	args: List[CoreExpr],
) -> Option[CloneTarget]:
	var candidate_index: Option[Int] = None
	var index: Int = 0
	var count: Int = 0

	for arg in args:
		if (
			direct_var(arg)
				.map(func(variable): core_var_equal(variable, target))
				.get_or(False)
		):
			candidate_index = Some(index)
			count += 1
		else:
			void

		index += 1

	if count == 1:
		match candidate_index:
			Some(arg_index):
				match kind:
					UserCall(name, Some(def_id), consumed_args):
						find_clone_target(state, name, def_id, arg_index, target_type)
					_:
						None
			None:
				None
	else:
		None


private pure func rewrite_assignment_call_expr(
	state: ConsumeSpecializeState,
	target: CoreVar,
	target_type: CoreType,
	rhs: CoreExpr,
) -> CoreExpr:
	match rhs:
		CallExpr(kind, callee, args, typ, loc):
			match call_arg_consumes_target(state, target, target_type, kind, args):
				Some(target_clone):
					CallExpr(
						UserCall(target_clone.clone_name, Some(target_clone.clone_def_id), []),
						rewrite_callee_expr(
							target_clone.clone_name,
							target_clone.clone_def_id,
							callee,
						),
						args,
						typ,
						loc,
					)
				None:
					rhs
		_:
			rhs


private pure func rewrite_expr_total(state: ConsumeSpecializeState, expr: CoreExpr) -> CoreExpr:
	mapped: CoreExpr = match expr:
		SeqExpr(_, _):
			CoreTraverse.map_core_sequence_items(expr, func(item): rewrite_expr_total(state, item))
		LogicalExpr(_, _, _, _, _):
			CoreTraverse.map_core_logical_tree_with_context(expr, state, rewrite_expr_total)
		_:
			CoreTraverse.map_core_expr_children_with_context(expr, state, rewrite_expr_total)

	match mapped:
		AssignExpr(target, rhs, typ, loc):
			rhs_type: CoreType = core_expr_type(rhs)

			rewritten_rhs: CoreExpr = match source_managed_type_name(state, rhs_type):
				Some(type_name):
					rewrite_assignment_call_expr(state, target, rhs_type, rhs)
				None:
					rhs

			AssignExpr(target, rewritten_rhs, typ, loc)
		_:
			mapped


private pure func candidate_for_clone_call(
	state: ConsumeSpecializeState,
	name: String,
	def_id: Int,
) -> Option[CloneCandidate]:
	var found: Option[CloneCandidate] = None

	for candidate in state.candidates:
		if candidate.clone_name == name and candidate.clone_def_id == def_id:
			found = Some(candidate)
			break
		else:
			void

	found


private pure func collect_used_clone_keys_from_expr(
	state: ConsumeSpecializeState,
	expr: CoreExpr,
) -> ConsumeSpecializeState:
	var current: ConsumeSpecializeState = state
	var pending: List[CoreExpr] = [expr]
	var index: Int = 0

	while index < pending.length():
		match pending.get(index):
			Some(current_expr):
				match current_expr:
					CallExpr(UserCall(name, Some(def_id), consumed_args), callee, args, typ, loc):
						match candidate_for_clone_call(current, name, def_id):
							Some(candidate):
								current = mark_clone_used(current, candidate.key)
							None:
								void
					_:
						void

				for child in CoreTraverse.immediate_core_expr_children(current_expr):
					pending = pending.append(child)
			None:
				break

		index += 1

	current


private pure func rewrite_func(
	state: ConsumeSpecializeState,
	func_info: CoreFunction,
) -> CoreFunction:
	match func_info.body:
		Some(body):
			rewritten_body: CoreExpr = rewrite_expr_total(state, body)
			{
				name = func_info.name,
				source_module = func_info.source_module,
				type_params = func_info.type_params,
				params = func_info.params,
				return_type = func_info.return_type,
				body = Some(rewritten_body),
				is_pure = func_info.is_pure,
				function_kind = func_info.function_kind,
				def_id = func_info.def_id,
				loc = func_info.loc
			}
		None:
			func_info


private pure func rewrite_global(state: ConsumeSpecializeState, global: CoreGlobal) -> CoreGlobal:
	rewritten_init: CoreExpr = rewrite_expr_total(state, global.init)
	{
		name = global.name,
		source_module = global.source_module,
		typ = global.typ,
		init = rewritten_init,
		is_mutable = global.is_mutable,
		is_const = global.is_const,
		is_private = global.is_private,
		def_id = global.def_id,
		loc = global.loc
	}


private pure func rewrite_decl_body(state: ConsumeSpecializeState, decl: CoreDecl) -> CoreDecl:
	match decl:
		FunctionDecl(func_info):
			FunctionDecl(rewrite_func(state, func_info))
		GlobalDecl(global):
			GlobalDecl(rewrite_global(state, global))
		_:
			decl


private pure func collect_used_clone_keys_from_decl(
	state: ConsumeSpecializeState,
	decl: CoreDecl,
) -> ConsumeSpecializeState:
	match decl:
		FunctionDecl(func_info):
			match func_info.body:
				Some(body):
					collect_used_clone_keys_from_expr(state, body)
				None:
					state
		GlobalDecl(global):
			collect_used_clone_keys_from_expr(state, global.init)
		_:
			state


private pure func clones_after(
	state: ConsumeSpecializeState,
	original_func: CoreFunction,
) -> List[CoreDecl]:
	var result: List[CoreDecl] = []

	for candidate in state.candidates:
		if (
			candidate.key.original_name == original_func.name
			and candidate.key.original_def_id == original_func.def_id
			and clone_key_used(state.used_clone_keys, candidate.key)
		):
			match make_consuming_clone(
				state,
				original_func,
				candidate.key.arg_index,
				candidate.clone_def_id,
			):
				Some(clone):
					result = result.append(FunctionDecl(clone))
				None:
					void
		else:
			void

	result


private pure func original_function_for_decl(decl: CoreDecl) -> Option[CoreFunction]:
	match decl:
		FunctionDecl(func_info):
			Some(func_info)
		_:
			None


private pure func insert_clones_after_functions(
	state: ConsumeSpecializeState,
	original_decls: List[CoreDecl],
	rewritten_decls: List[CoreDecl],
) -> List[CoreDecl]:
	var result: List[CoreDecl] = []
	var index: Int = 0

	for decl in rewritten_decls:
		result = result.append(decl)

		match original_decls.get(index):
			Some(original_decl):
				match original_function_for_decl(original_decl):
					Some(original_func):
						for clone_decl in clones_after(state, original_func):
							result = result.append(clone_decl)
					None:
						void
			None:
				void

		index += 1

	result


pure func rewrite_program(program: CoreProgram) -> CoreProgram:
	var state: ConsumeSpecializeState = make_state(program)
	var rewritten_decls: List[CoreDecl] = []

	for decl in program.decls:
		rewritten_decl: CoreDecl = rewrite_decl_body(state, decl)
		state = collect_used_clone_keys_from_decl(state, rewritten_decl)
		rewritten_decls = rewritten_decls.append(rewritten_decl)

	{
		decls = insert_clones_after_functions(state, program.decls, rewritten_decls),
		foreign_includes = program.foreign_includes
	}
