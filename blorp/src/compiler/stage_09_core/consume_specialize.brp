-- Consuming-call specialization before Perceus.
--
-- A call hands an owned record to a consuming clone of its callee where the
-- record is at its last use: the owned parameter of a clone, a `let`-bound
-- local, the target of `x = f(x)`, or the result of another user call passed
-- straight in (`b.f().g()`). The clone keeps the original body and
-- declares the parameter owned through its `ConsumingClone` origin; ownership
-- inference takes that declaration as the clone's contract floor, so Perceus
-- transfers the parameter where the body returns or stores it and releases it
-- on paths that do not. A clone may therefore return its parameter unchanged
-- or pass it on, and its own body is retargeted the same way, so clones are
-- created transitively until no new clone is used.
--
-- A clone only pays for itself when the owned record reaches an in-place
-- update: a record update of the parameter (or an alias of it) in the clone
-- itself, or a last-use hand-off to another clone that does. Every clone the
-- walk creates is classified by a fixpoint over those hand-offs, and calls to
-- clones without that benefit go back to the original function. Only record
-- parameters are candidates, because only a record can be updated in place.
--
-- Before a binding is walked, `t = f(out, ...); out = g(t, ...)` with `t`
-- used only there, and neither call able to `break` or `continue` out, is
-- rewritten to `out = f(out, ...); out = g(out, ...)`
-- (destination forwarding), so a loop variable updated through a temporary
-- reaches both clones by the `x = f(x)` rule.
--
-- Last-use liveness is precise through bindings, sequences, branches, match
-- results and call arguments and conservative everywhere else; a retargeted
-- argument that is still live gets a retain from Perceus, so imprecision costs
-- a copy, never correctness. Clone identity includes name and definition id.
import:
	ir:
		CoreCallKind(UserCall),
		CoreDecl(FunctionDecl, GlobalDecl),
		CoreExpr(
			AccessorLiteralMatchExpr,
			AssignExpr,
			BorrowLetExpr,
			BoxExpr,
			BreakExpr,
			CallExpr,
			CastExpr,
			ConstructorMatchExpr,
			ContinueExpr,
			DropExpr,
			DupExpr,
			IfExpr,
			LengthMatchExpr,
			LetExpr,
			LiteralExpr,
			LiteralMatchExpr,
			LogicalExpr,
			RecordUpdateExpr,
			ResourceCleanupExitExpr,
			SeqExpr,
			StaticStringLiteralExpr,
			TailrecListSpreadRecurExpr,
			TailrecRecurExpr,
			UnboxExpr,
			VarExpr,
			VoidExpr,
		),
		CoreFunction,
		CoreFunctionOrigin(ConsumingClone),
		core_function_declared_origin,
		CoreFunctionKind(
			BuiltinFunction,
			ClosureBodyFunction,
			ForeignFunction,
			ProgramEntrypointFunction,
			UnresolvedBuiltinFunction,
			UserFunction,
		),
		CoreGlobal,
		CoreMatchBinding,
		CoreProgram,
		CoreSourceLoc,
		CoreType(HeapRecordType),
		CoreBinderOrigin(AuthoredBinder),
		CoreVar,
		core_var_equal,
	set as Sets
	traverse as CoreTraverse


private record CloneKey {
	original_name: String,
	original_def_id: Int,
	arg_index: Int
}


private record CloneCandidate {
	key: CloneKey,
	param_type: CoreType,
	clone_name: String,
	clone_def_id: Int
}


private record CloneCandidateCatalog {
	ordered: List[CloneCandidate],
	ordinals_by_original_def_id: Dict[Int, List[Int]],
	ordinal_by_clone_def_id: Dict[Int, Int]
}


private record UsedCloneKeyIndex {
	arg_indices_by_name_by_def_id: Dict[Int, Dict[String, Dict[Int, Bool]]]
}


---
`owned_record_types` is the set of parameter record types of the clone candidates. A
`let`-bound local of another type can never be handed to a clone, so the
last-use walk does not track it.
---
private record ConsumeSpecializeState {
	candidates: CloneCandidateCatalog,
	used_clone_keys: UsedCloneKeyIndex,
	owned_record_types: Set[String]
}


private record CloneCandidateDiscoveryState {
	next_def_id: Int,
	candidates: CloneCandidateCatalog
}


private record FunctionCandidateAppendState {
	catalog: CloneCandidateCatalog,
	ordinals: List[Int]
}


private record CloneTarget {
	key: CloneKey,
	clone_name: String,
	clone_def_id: Int
}


---
Whether handing an owned record to a consuming clone lets the record be
updated in place instead of copied.

`UpdatesOwnedRecordInPlace`: the clone updates the parameter, or an alias of
it, with a record update, which record-update lowering turns into an in-place
update of the owned record. `HandsOwnedRecordToBeneficialClone`: the clone
hands the parameter, or an alias of it, at its last use to another clone
with a benefit. `NoInPlaceBenefit`: neither, so the clone would only add code;
calls to it go back to the original function.
---
private enum ConsumingCloneBenefit:
	UpdatesOwnedRecordInPlace
	HandsOwnedRecordToBeneficialClone
	NoInPlaceBenefit


---
Candidates only ever have heap-record parameter types, so type identity here
is heap-record name identity.
---
private pure func same_heap_record(record_name: String, typ: CoreType) -> Bool:
	match typ:
		HeapRecordType(name):
			name == record_name
		_:
			False


private pure func same_heap_record_type(left: CoreType, right: CoreType) -> Bool:
	match left:
		HeapRecordType(name):
			same_heap_record(name, right)
		_:
			False


private pure func direct_var(expr: CoreExpr) -> Option[CoreVar]:
	match expr:
		VarExpr(variable, typ, loc):
			Some(variable)
		CastExpr(inner, typ, loc):
			direct_var(inner)
		UnboxExpr(kind, inner, typ, loc):
			direct_var(inner)
		BoxExpr(box, typ, loc):
			direct_var(box.value)
		_:
			None


private pure func empty_clone_candidate_catalog() -> CloneCandidateCatalog:
	{
		ordered = [],
		ordinals_by_original_def_id = {},
		ordinal_by_clone_def_id = {}
	}


private pure func empty_used_clone_key_index() -> UsedCloneKeyIndex:
	{arg_indices_by_name_by_def_id = {}}


private pure func append_function_clone_candidate(
	state: FunctionCandidateAppendState,
	candidate: CloneCandidate,
) -> FunctionCandidateAppendState:
	ordinal: Int = state.catalog.ordered.length()

	clone_index: Dict[Int, Int] = if state.catalog.ordinal_by_clone_def_id.contains(
		candidate.clone_def_id,
	):
		state.catalog.ordinal_by_clone_def_id
	else:
		state.catalog.ordinal_by_clone_def_id.set(candidate.clone_def_id, ordinal)

	{
		catalog = {
			ordered = state.catalog.ordered.append(candidate),
			ordinals_by_original_def_id = state.catalog.ordinals_by_original_def_id,
			ordinal_by_clone_def_id = clone_index
		},
		ordinals = state.ordinals.append(ordinal)
	}


private pure func finish_function_clone_candidates(
	catalog: CloneCandidateCatalog,
	original_def_id: Int,
	ordinals: List[Int],
) -> CloneCandidateCatalog:
	if ordinals.length() == 0:
		catalog
	else:
		original_bucket: List[Int] = catalog.ordinals_by_original_def_id
			.get_or(original_def_id, [])
			.concat(ordinals)

		{ catalog |
			ordinals_by_original_def_id = catalog.ordinals_by_original_def_id.set(
				original_def_id,
				original_bucket,
			)
		}



private pure func discover_clone_candidates(
	program: CoreProgram,
	next_def_id: Int,
) -> CloneCandidateDiscoveryState:
	var discovery: CloneCandidateDiscoveryState = {
		next_def_id = next_def_id,
		candidates = empty_clone_candidate_catalog()
	}

	for decl in program.decls:
		match decl:
			FunctionDecl(func_info):
				discovery = collect_function_clone_candidates(discovery, func_info)
			_:
				void

	discovery


private pure func state_from_discovery(
	discovery: CloneCandidateDiscoveryState,
) -> ConsumeSpecializeState:
	var record_types: Set[String] = Sets.set()

	for candidate in discovery.candidates.ordered:
		match candidate.param_type:
			HeapRecordType(name):
				record_types = Sets.add(record_types, name)
			_:
				void

	{
		candidates = discovery.candidates,
		used_clone_keys = empty_used_clone_key_index(),
		owned_record_types = record_types
	}


---
Only a record parameter can be updated in place, so only record parameters
of user functions that return the same record type are candidates.
---
private pure func function_is_cloneable(arg_index: Int, func_info: CoreFunction) -> Bool:
	match func_info.function_kind:
		UserFunction:
			if func_info.body.is_none():
				False
			else:
				match func_info.params.get(arg_index):
					Some(param):
						match param.typ:
							HeapRecordType(param_record):
								same_heap_record(param_record, func_info.return_type)
							_:
								False
					None:
						False
		ProgramEntrypointFunction:
			False
		BuiltinFunction(c_name):
			False
		UnresolvedBuiltinFunction:
			False
		ForeignFunction(_):
			False
		ClosureBodyFunction(abi):
			False


private pure func clone_name(original_name: String, arg_index: Int) -> String:
	"${original_name}__consume_arg${arg_index.to_string()}"


private pure func clone_key(
	original_name: String,
	original_def_id: Int,
	arg_index: Int,
) -> CloneKey:
	{
		original_name = original_name,
		original_def_id = original_def_id,
		arg_index = arg_index
	}


private pure func clone_callee_var(name: String, def_id: Int) -> CoreVar:
	{
		name = name,
		id = 0,
		def_id = Some(def_id),
		origin = AuthoredBinder
	}


private pure func rewrite_callee_expr(name: String, def_id: Int, callee: CoreExpr) -> CoreExpr:
	match callee:
		VarExpr(variable, typ, loc):
			VarExpr(
				clone_callee_var(name, def_id),
				typ,
				loc,
			)
		_:
			callee


private pure func expr_mentions_var(expr: CoreExpr, target: CoreVar) -> Bool:
	direct_mention: Bool = match expr:
		VarExpr(variable, typ, loc):
			core_var_equal(variable, target)
		AssignExpr(variable, rhs, typ, loc):
			core_var_equal(variable, target)
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			core_var_equal(variable, target)
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			core_var_equal(variable, target)
		_:
			False

	(
		direct_mention
		or CoreTraverse
			.immediate_core_expr_children(expr)
			.any(func(child): expr_mentions_var(child, target))
	)


---
The clone of `original` that owns parameter `arg_index`: the original body
with every call that hands an owned record on at its last use retargeted,
starting from the owned parameter.
---
private pure func make_consuming_clone(
	state: ConsumeSpecializeState,
	original: CoreFunction,
	arg_index: Int,
	clone_def_id: Int,
) -> Option[CoreFunction]:
	match original.params.get(arg_index):
		Some(param):
			match original.body:
				Some(body):
					Some({
						name = clone_name(original.name, arg_index),
						source_module = original.source_module,
						module = original.module,
						type_params = original.type_params,
						params = original.params,
						return_type = original.return_type,
						body = Some(
							rewrite_last_use(
								{
									state = state,
									owned = [param.name],
									after = NothingAfter
								},
								body,
							),
						),
						is_pure = original.is_pure,
						function_kind = original.function_kind,
						origin = ConsumingClone(arg_index, core_function_declared_origin(original.origin)),
						def_id = clone_def_id,
						loc = original.loc
					})
				None:
					None
		None:
			None


private pure func collect_function_clone_candidates(
	state: CloneCandidateDiscoveryState,
	func_info: CoreFunction,
) -> CloneCandidateDiscoveryState:
	var current: CloneCandidateDiscoveryState = state
	var arg_index: Int = 0
	var function_candidates: FunctionCandidateAppendState = {
		catalog = state.candidates,
		ordinals = []
	}

	for param in func_info.params:
		if function_is_cloneable(arg_index, func_info):
			clone_def_id: Int = current.next_def_id
			current = { current | next_def_id = current.next_def_id + 1 }
			function_candidates = append_function_clone_candidate(
				function_candidates,
				{
					key = clone_key(func_info.name, func_info.def_id, arg_index),
					param_type = param.typ,
					clone_name = clone_name(func_info.name, arg_index),
					clone_def_id = clone_def_id
				},
			)
			current = { current | candidates = function_candidates.catalog }
		else:
			void

		arg_index += 1

	{ current |
		candidates = finish_function_clone_candidates(
			current.candidates,
			func_info.def_id,
			function_candidates.ordinals,
		)
	}


private pure func find_clone_target(
	state: ConsumeSpecializeState,
	original_name: String,
	original_def_id: Int,
	arg_index: Int,
	target_type: CoreType,
) -> Option[CloneTarget]:
	var found: Option[CloneTarget] = None

	match state.candidates.ordinals_by_original_def_id.get(original_def_id):
		Some(ordinals):
			for ordinal in ordinals:
				match state.candidates.ordered.get(ordinal):
					Some(candidate):
						if (
							candidate.key.original_name == original_name
							and candidate.key.original_def_id == original_def_id
							and candidate.key.arg_index == arg_index
							and same_heap_record_type(candidate.param_type, target_type)
						):
							found = Some({
								key = candidate.key,
								clone_name = candidate.clone_name,
								clone_def_id = candidate.clone_def_id,
							})
						else:
							void
					None:
						void
		None:
			void

	found


private pure func clone_key_used(used_clone_keys: UsedCloneKeyIndex, key: CloneKey) -> Bool:
	match used_clone_keys.arg_indices_by_name_by_def_id.get(key.original_def_id):
		Some(by_name):
			match by_name.get(key.original_name):
				Some(arg_indices):
					arg_indices.contains(key.arg_index)
				None:
					False
		None:
			False


private pure func mark_clone_used(
	state: ConsumeSpecializeState,
	key: CloneKey,
) -> ConsumeSpecializeState:
	if clone_key_used(state.used_clone_keys, key):
		state
	else:
		by_name: Dict[String, Dict[Int, Bool]] = state.used_clone_keys.arg_indices_by_name_by_def_id.get_or(
			key.original_def_id,
			{},
		)
		arg_indices: Dict[Int, Bool] = by_name.get_or(key.original_name, {})
		updated_by_name: Dict[String, Dict[Int, Bool]] = by_name.set(
			key.original_name,
			arg_indices.set(key.arg_index, True),
		)

		{ state |
			used_clone_keys = {
				arg_indices_by_name_by_def_id = state.used_clone_keys.arg_indices_by_name_by_def_id.set(
					key.original_def_id,
					updated_by_name,
				),
			}
		}


private pure func candidate_for_clone_call(
	state: ConsumeSpecializeState,
	name: String,
	def_id: Int,
) -> Option[CloneCandidate]:
	match state.candidates.ordinal_by_clone_def_id.get(def_id):
		Some(ordinal):
			match state.candidates.ordered.get(ordinal):
				Some(candidate):
					if candidate.clone_name == name and candidate.clone_def_id == def_id:
						Some(candidate)
					else:
						None
				None:
					None
		None:
			None


private pure func var_list_contains(items: List[CoreVar], value: CoreVar) -> Bool:
	items.any(func(item): core_var_equal(item, value))


private pure func var_list_without(items: List[CoreVar], value: CoreVar) -> List[CoreVar]:
	if var_list_contains(items, value):
		items.filter(func(item): not core_var_equal(item, value))
	else:
		items


-- Allocation identity for the reuse rule of the last-use walk: a rewritten
-- child that is the same allocation as its input means nothing below it was
-- retargeted, so the parent is handed back as is instead of rebuilt. Bound
-- straight to the runtime primitive for the same bootstrap reason as the
-- matching blocks in traverse.brp and tuple_sroa.brp; delete them together.
foreign:
	private pure func same_core_expr(left: CoreExpr, right: CoreExpr) -> Bool = "blorp_same_object"


---
The expressions that run after the one the walk is rewriting, innermost
first. Only mentions matter: an owned variable mentioned in any of them is
still live.
---
private union LastUseContinuation:
	NothingAfter
	EvaluatedAfter(CoreExpr, LastUseContinuation)


---
What the last-use walk knows at the expression it is rewriting.

`owned` holds the variables this body owns and may hand to a consuming clone:
the owned parameter of a clone and every `let`-bound local of a candidate
record type. Borrowed parameters, borrow lets and match bindings are never in
it. `after` holds what runs after the expression; it is only kept while
`owned` is not empty, since it only answers liveness questions about owned
variables. Inside loops, lambdas, logical operators and every other construct
that may run a child more than once or not at all, the walk starts over with
no owned variables, so it only retargets where straight-line control flow
proves the last use.

Perceus is the safety net for this analysis: a variable handed to a clone
while still live gets a retain, so imprecision here costs a copy, never
correctness.
---
private record LastUseWalk {
	state: ConsumeSpecializeState,
	owned: List[CoreVar],
	after: LastUseContinuation
}


private NO_VARS: List[CoreVar] = []


private pure func owned_candidate_type(state: ConsumeSpecializeState, typ: CoreType) -> Bool:
	match typ:
		HeapRecordType(name):
			Sets.contains(state.owned_record_types, name)
		_:
			False


private pure func read_after(variable: CoreVar, after: LastUseContinuation) -> Bool:
	var rest: LastUseContinuation = after
	var found: Bool = False

	while not found:
		match rest:
			EvaluatedAfter(expr, remaining):
				found = expr_mentions_var(expr, variable)
				rest = remaining
			NothingAfter:
				break

	found


---
`walk` for an expression followed by `later`.
---
private pure func walk_before(walk: LastUseWalk, later: CoreExpr) -> LastUseWalk:
	if walk.owned.length() == 0:
		walk
	else:
		{ walk | after = EvaluatedAfter(later, walk.after) }


---
`walk` for a construct the walk does not model: no outer variable is handed
over inside it.
---
private pure func conservative_walk(walk: LastUseWalk) -> LastUseWalk:
	if walk.owned.length() == 0:
		walk
	else:
		{ walk | owned = NO_VARS, after = NothingAfter }


private pure func walk_without(walk: LastUseWalk, variable: CoreVar) -> LastUseWalk:
	if var_list_contains(walk.owned, variable):
		{ walk | owned = var_list_without(walk.owned, variable) }
	else:
		walk


private pure func walk_owning(walk: LastUseWalk, variable: CoreVar) -> LastUseWalk:
	{ walk | owned = var_list_without(walk.owned, variable).append(variable) }


private pure func is_leaf_expr(expr: CoreExpr) -> Bool:
	match expr:
		VarExpr(_, _, _) | LiteralExpr(_, _, _) | StaticStringLiteralExpr(_, _, _, _) | VoidExpr(_, _):
			True
		_:
			False


private pure func rewrite_last_use_child(walk: LastUseWalk, child: CoreExpr) -> CoreExpr:
	rewrite_last_use(walk, child)


private pure func rewrite_last_use_match_result(
	walk: LastUseWalk,
	bindings: List[CoreMatchBinding],
	result: CoreExpr,
) -> CoreExpr:
	var result_walk: LastUseWalk = walk

	for binding in bindings:
		result_walk = walk_without(result_walk, binding.variable)

	rewrite_last_use(result_walk, result)


private pure func rewrite_last_use_sequence(walk: LastUseWalk, expr: CoreExpr) -> CoreExpr:
	spine = CoreTraverse.split_core_sequence(expr)
	final_item: CoreExpr = rewrite_last_use(walk, spine.final_item)
	var changed: Bool = not same_core_expr(final_item, spine.final_item)
	var item_walk: LastUseWalk = walk_before(walk, spine.final_item)
	var rewritten_reversed: List[CoreExpr] = []
	var index: Int = spine.preceding_items.length() - 1

	while index >= 0:
		match spine.preceding_items.get(index):
			Some(item):
				rewritten: CoreExpr = rewrite_last_use(item_walk, item)
				changed = changed or not same_core_expr(rewritten, item)
				rewritten_reversed = rewritten_reversed.append(rewritten)
				item_walk = walk_before(item_walk, item)
			None:
				void

		index -= 1

	if changed:
		CoreTraverse.rebuild_core_sequence({
			preceding_items = rewritten_reversed.reverse(),
			final_item = final_item
		})
	else:
		expr


private pure func direct_arg_count(args: List[CoreExpr], variable: CoreVar) -> Int:
	var count: Int = 0

	for arg in args:
		if (
			direct_var(arg)
				.map(func(arg_var): core_var_equal(arg_var, variable))
				.get_or(False)
		):
			count += 1
		else:
			void

	count


---
Whether `arg` is the result of a user call of a candidate record type. A
user function returns an owned reference (see the source function boundary
in `docs/OWNERSHIP_MODEL.md`) that nothing else names, so the argument slot
is that temporary's only and last use: it can be handed to a consuming clone
without a liveness check. `b.f().g()` and `g(f(b))` hand the record on this
way. Other calls may return a borrowed alias, so only user calls qualify.
---
private pure func is_owned_call_temporary(state: ConsumeSpecializeState, arg: CoreExpr) -> Bool:
	match arg:
		CallExpr(UserCall(_, _, _), _, _, typ, _):
			owned_candidate_type(state, typ)
		_:
			False


---
The clone a call can hand an owned argument to, tried in this order:
`assigned`, the target of `x = f(..., x, ...)`, whose old value the
assignment ends, so it needs no liveness check; then the first owned
variable passed once among the call's direct arguments and not read after
the call; then the first argument that is an owned call temporary. Uses of
the same variable inside other arguments run before the call, so they do
not keep it live past it. A candidate must also be accepted by a clone.
---
private pure func last_use_clone_target(
	walk: LastUseWalk,
	assigned: Option[CoreVar],
	kind: CoreCallKind,
	args: List[CoreExpr],
	result_type: CoreType,
) -> Option[CloneTarget]:
	match kind:
		UserCall(name, Some(def_id), _):
			var assigned_target: Option[CloneTarget] = None
			var other_target: Option[CloneTarget] = None
			var temporary_target: Option[CloneTarget] = None
			var index: Int = 0

			for arg in args:
				if is_owned_call_temporary(walk.state, arg):
					if temporary_target.is_none():
						temporary_target = find_clone_target(walk.state, name, def_id, index, result_type)
					else:
						void
				else if walk.owned.length() > 0:
					match direct_var(arg):
						Some(variable):
							if var_list_contains(walk.owned, variable) and direct_arg_count(args, variable) == 1:
								is_assigned: Bool = assigned
									.map(func(target): core_var_equal(target, variable))
									.get_or(False)

								if is_assigned:
									assigned_target = find_clone_target(walk.state, name, def_id, index, result_type)
								else if other_target.is_none() and not read_after(variable, walk.after):
									other_target = find_clone_target(walk.state, name, def_id, index, result_type)
								else:
									void
							else:
								void
						None:
							void
				else:
					void

				index += 1

			match assigned_target:
				Some(target_clone):
					Some(target_clone)
				None:
					match other_target:
						Some(target_clone):
							Some(target_clone)
						None:
							temporary_target
		_:
			None


---
`after` with every argument except the one at `skipped` in front of it:
while one argument runs, the others are still to run or still to be passed.
---
private pure func other_args_after(
	args: List[CoreExpr],
	skipped: Int,
	after: LastUseContinuation,
) -> LastUseContinuation:
	var result: LastUseContinuation = after
	var index: Int = 0

	for arg in args:
		if index != skipped:
			result = EvaluatedAfter(arg, result)
		else:
			void

		index += 1

	result


private pure func rewrite_last_use_call(
	walk: LastUseWalk,
	assigned: Option[CoreVar],
	expr: CoreExpr,
) -> CoreExpr:
	match expr:
		CallExpr(kind, callee, args, typ, loc):
			var rewritten_args: List[CoreExpr] = []
			var args_changed: Bool = False
			var index: Int = 0

			for arg in args:
				rewritten: CoreExpr = if is_leaf_expr(arg):
					arg
				else if walk.owned.length() == 0:
					rewrite_last_use(walk, arg)
				else:
					rewrite_last_use(
						{ walk | after = other_args_after(args, index, walk.after) },
						arg,
					)

				if args_changed:
					rewritten_args = rewritten_args.append(rewritten)
				else if not same_core_expr(rewritten, arg):
					args_changed = True
					rewritten_args = args.take(index).append(rewritten)
				else:
					void

				index += 1

			final_args: List[CoreExpr] = if args_changed:
				rewritten_args
			else:
				args
			rewritten_callee: CoreExpr = if is_leaf_expr(callee):
				callee
			else:
				rewrite_last_use(conservative_walk(walk), callee)
			target: Option[CloneTarget] = last_use_clone_target(walk, assigned, kind, args, typ)

			match target:
				Some(target_clone):
					CallExpr(
						UserCall(target_clone.clone_name, Some(target_clone.clone_def_id), []),
						rewrite_callee_expr(
							target_clone.clone_name,
							target_clone.clone_def_id,
							rewritten_callee,
						),
						final_args,
						typ,
						loc,
					)
				None:
					if args_changed or not same_core_expr(rewritten_callee, callee):
						CallExpr(kind, rewritten_callee, final_args, typ, loc)
					else:
						expr
		_:
			rewrite_last_use(walk, expr)


private pure func is_var_expr_of(expr: CoreExpr, variable: CoreVar) -> Bool:
	match expr:
		VarExpr(found, _, _):
			core_var_equal(found, variable)
		_:
			False


private pure func call_passes_var(call: CoreExpr, variable: CoreVar) -> Bool:
	match call:
		CallExpr(_, _, args, _, _):
			args.any(func(arg): is_var_expr_of(arg, variable))
		_:
			False


---
Whether `variable` is passed to the call as exactly one direct argument and
mentioned nowhere else in it.
---
private pure func passes_only_once(callee: CoreExpr, args: List[CoreExpr], variable: CoreVar) -> Bool:
	(
		args.filter(func(arg): is_var_expr_of(arg, variable)).length() == 1
		and not args.any(func(arg): not is_var_expr_of(arg, variable) and expr_mentions_var(arg, variable))
		and not expr_mentions_var(callee, variable)
	)


---
Whether evaluating `expr` may leave it without producing a value: a
`break`, `continue`, resource cleanup exit or tail-recursion jump anywhere
inside. Conservative: an exit that targets a loop nested inside `expr`
counts too. Core has no `return`, and `?=` is rejected in loop bodies.
---
private pure func may_exit_early(expr: CoreExpr) -> Bool:
	match expr:
		BreakExpr(_, _) | ContinueExpr(_, _) | ResourceCleanupExitExpr(_, _, _) | TailrecRecurExpr(_, _, _) | TailrecListSpreadRecurExpr(_, _, _, _):
			True
		_:
			CoreTraverse.immediate_core_expr_children(expr).any(may_exit_early)


private pure func replaced_var_arg(arg: CoreExpr, variable: CoreVar, replacement: CoreExpr) -> CoreExpr:
	if is_var_expr_of(arg, variable):
		replacement
	else:
		arg


---
`out = f(out, ...); out = g(out, ...)` for `t = f(out, ...); out = g(t, ...)`,
or `None` when the forwarding does not apply. See `forwarded_assignment`.
---
private pure func forwarded_assignment_pair(
	temporary: CoreVar,
	temporary_type: CoreType,
	temporary_rhs: CoreExpr,
	target: CoreVar,
	assigned: CoreExpr,
	assign_type: CoreType,
	assign_loc: CoreSourceLoc,
) -> Option[CoreExpr]:
	match assigned:
		CallExpr(kind, callee, args, assigned_type, call_loc):
			if (
				same_heap_record_type(temporary_type, assigned_type)
				and call_passes_var(temporary_rhs, target)
				and passes_only_once(callee, args, temporary)
				and not expr_mentions_var(assigned, target)
				and not may_exit_early(temporary_rhs)
				and not may_exit_early(assigned)
			):
				target_read: CoreExpr = VarExpr(target, temporary_type, call_loc)
				forwarded_args: List[CoreExpr] = args.map(
					func(arg): replaced_var_arg(arg, temporary, target_read),
				)

				Some(SeqExpr(
					AssignExpr(target, temporary_rhs, assign_type, assign_loc),
					AssignExpr(
						target,
						CallExpr(kind, callee, forwarded_args, assigned_type, call_loc),
						assign_type,
						assign_loc,
					),
				))
			else:
				None
		_:
			None


---
Destination forwarding (the idea of Rust MIR's destination propagation):
`t = f(out, ...); out = g(t, ...)`, with `t` an immutable record local used
only as one direct argument of the call assigned to `out`, is rewritten to
`out = f(out, ...); out = g(out, ...)`. Each statement is then the
`x = f(x)` form, whose assignment ends the old value, so both calls take
consuming clones even inside a loop, where the last-use walk does not track
variables. The meaning is unchanged when the second call does not mention
`out`, `t` is not used after it, and neither call can leave early: a
`break` or `continue` while evaluating the second call would otherwise leave
`out` holding the first call's result instead of its old value. Closures
cannot capture a mutable variable, so nothing else observes `out` between
the two assignments; a cancellation ends the function, and its cleanup
releases whichever owned value `out` holds.
---
private pure func forwarded_assignment(
	state: ConsumeSpecializeState,
	temporary: CoreVar,
	is_mutable: Bool,
	temporary_type: CoreType,
	temporary_rhs: CoreExpr,
	body: CoreExpr,
) -> Option[CoreExpr]:
	if is_mutable or not owned_candidate_type(state, temporary_type):
		None
	else:
		match body:
			AssignExpr(target, assigned, assign_type, assign_loc):
				forwarded_assignment_pair(
					temporary,
					temporary_type,
					temporary_rhs,
					target,
					assigned,
					assign_type,
					assign_loc,
				)
			SeqExpr(AssignExpr(target, assigned, assign_type, assign_loc), rest):
				if expr_mentions_var(rest, temporary):
					None
				else:
					forwarded_assignment_pair(
						temporary,
						temporary_type,
						temporary_rhs,
						target,
						assigned,
						assign_type,
						assign_loc,
					).map(func(pair): SeqExpr(pair, rest))
			_:
				None


---
Retargets every call that hands an owned record on at its last use to the
consuming clone for that argument, rebuilding only the nodes above a change.
`x = f(x)` is the case where the assignment ends the old value's life: when
the right-hand side is that direct call, the target counts as owned inside
it. Inside any other right-hand side the target is never handed over:
Perceus releases the old value at the assignment unless the right-hand side
as a whole consumes it, and it does not balance a right-hand side that
consumes it on some paths only (`x = match k: A: f(x) B: {x | ...}` would
leak the old value on the B path).
---
private pure func rewrite_last_use(walk: LastUseWalk, expr: CoreExpr) -> CoreExpr:
	match expr:
		VarExpr(_, _, _) | LiteralExpr(_, _, _) | StaticStringLiteralExpr(_, _, _, _) | VoidExpr(_, _):
			expr
		SeqExpr(_, _):
			rewrite_last_use_sequence(walk, expr)
		LetExpr(variable, is_mutable, typ, rhs, body):
			match forwarded_assignment(walk.state, variable, is_mutable, typ, rhs, body):
				Some(forwarded):
					rewrite_last_use(walk, forwarded)
				None:
					body_walk: LastUseWalk = if owned_candidate_type(walk.state, typ):
						walk_owning(walk, variable)
					else:
						walk_without(walk, variable)
					rewritten_body: CoreExpr = rewrite_last_use(body_walk, body)
					rewritten_rhs: CoreExpr = rewrite_last_use(walk_before(walk, body), rhs)

					if same_core_expr(rewritten_rhs, rhs) and same_core_expr(rewritten_body, body):
						expr
					else:
						LetExpr(variable, is_mutable, typ, rewritten_rhs, rewritten_body)
		BorrowLetExpr(variable, typ, rhs, body):
			rewritten_body: CoreExpr = rewrite_last_use(walk_without(walk, variable), body)
			rewritten_rhs: CoreExpr = rewrite_last_use(walk_before(walk, body), rhs)

			if same_core_expr(rewritten_rhs, rhs) and same_core_expr(rewritten_body, body):
				expr
			else:
				BorrowLetExpr(variable, typ, rewritten_rhs, rewritten_body)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			rewritten_then: CoreExpr = rewrite_last_use(walk, then_expr)
			rewritten_else: CoreExpr = rewrite_last_use(walk, else_expr)
			rewritten_cond: CoreExpr = rewrite_last_use(
				walk_before(walk_before(walk, else_expr), then_expr),
				cond,
			)

			if (
				same_core_expr(rewritten_cond, cond)
				and same_core_expr(rewritten_then, then_expr)
				and same_core_expr(rewritten_else, else_expr)
			):
				expr
			else:
				IfExpr(rewritten_cond, rewritten_then, rewritten_else, typ, loc)
		AssignExpr(target, rhs, typ, loc):
			rewritten_rhs: CoreExpr = match rhs:
				CallExpr(_, _, _, _, _):
					rewrite_last_use_call(walk_owning(walk, target), Some(target), rhs)
				_:
					rewrite_last_use(walk_without(walk, target), rhs)

			if same_core_expr(rewritten_rhs, rhs):
				expr
			else:
				AssignExpr(target, rewritten_rhs, typ, loc)
		CallExpr(_, _, _, _, _):
			rewrite_last_use_call(walk, None, expr)
		ConstructorMatchExpr(_, _, _, _, _, _) | LiteralMatchExpr(_, _, _, _, _) | AccessorLiteralMatchExpr(_, _, _, _, _) | LengthMatchExpr(_, _, _, _, _):
			-- Match results are the only children a match runs at most one of,
			-- after the scrutinee; the scrutinee is left as is.
			CoreTraverse.map_core_match_results_with_context(expr, walk, rewrite_last_use_match_result)
		LogicalExpr(_, _, _, _, _):
			CoreTraverse.map_core_logical_tree_with_context(
				expr,
				conservative_walk(walk),
				rewrite_last_use_child,
			)
		_:
			CoreTraverse.map_core_expr_children_with_context(
				expr,
				conservative_walk(walk),
				rewrite_last_use_child,
			)


private pure func original_function_for_decl(decl: CoreDecl) -> Option[CoreFunction]:
	match decl:
		FunctionDecl(func_info):
			Some(func_info)
		_:
			None


---
The clone def ids a rewritten body calls, marking each as used.
---
private record CloneCallCollection {
	state: ConsumeSpecializeState,
	called_clone_def_ids: List[Int]
}


private pure func collect_clone_calls_from_expr(
	state: ConsumeSpecializeState,
	expr: CoreExpr,
) -> CloneCallCollection:
	var current: ConsumeSpecializeState = state
	var called: List[Int] = []
	var pending: List[CoreExpr] = [expr]
	var index: Int = 0

	while index < pending.length():
		match pending.get(index):
			Some(current_expr):
				match current_expr:
					CallExpr(UserCall(name, Some(def_id), _), _, _, _, _):
						match candidate_for_clone_call(current, name, def_id):
							Some(candidate):
								current = mark_clone_used(current, candidate.key)
								called = called.append(def_id)
							None:
								void
					_:
						void

				for child in CoreTraverse.immediate_core_expr_children(current_expr):
					pending = pending.append(child)
			None:
				break

		index += 1

	{state = current, called_clone_def_ids = called}


private pure func decl_body(decl: CoreDecl) -> Option[CoreExpr]:
	match decl:
		FunctionDecl(func_info):
			func_info.body
		GlobalDecl(global):
			Some(global.init)
		_:
			None


private pure func rewrite_decl_body(state: ConsumeSpecializeState, decl: CoreDecl) -> CoreDecl:
	start: LastUseWalk = {state = state, owned = NO_VARS, after = NothingAfter}

	match decl:
		FunctionDecl(func_info):
			match func_info.body:
				Some(body):
					FunctionDecl({ func_info | body = Some(rewrite_last_use(start, body)) })
				None:
					decl
		GlobalDecl(global):
			GlobalDecl({ global | init = rewrite_last_use(start, global.init) })
		_:
			decl


---
What one scan of a built clone's body finds about its owned parameter and the
clones it calls. The owned family is the parameter and every `let` or `var`
that binds a member of the family: record-update lowering binds the updated
record this way, and `var acc = state` followed by `acc = { acc | ... }`
updates the parameter's record through the variable.
---
private record ConsumingCloneScan {
	updates_owned_record: Bool,
	owned_hand_offs: List[Int],
	called_clone_def_ids: List[Int]
}


---
Whether the argument a clone consumes (its `owned_index`) is a member of the
owned family. A family member at a borrowed position is not handed over.
---
private pure func hands_on_family_member(
	family: List[CoreVar],
	args: List[CoreExpr],
	owned_index: Int,
) -> Bool:
	match args.get(owned_index):
		Some(arg):
			match direct_var(arg):
				Some(variable):
					var_list_contains(family, variable)
				None:
					False
		None:
			False


private pure func hands_off_to_beneficial_clone(
	benefits: Dict[Int, ConsumingCloneBenefit],
	owned_hand_offs: List[Int],
) -> Bool:
	var found: Bool = False

	for target in owned_hand_offs:
		if is_beneficial(benefit_of(benefits, target)):
			found = True
		else:
			void

	found


private pure func scan_consuming_clone(
	state: ConsumeSpecializeState,
	clone: CoreFunction,
	arg_index: Int,
) -> ConsumingCloneScan:
	var family: List[CoreVar] = match clone.params.get(arg_index):
		Some(param):
			[param.name]
		None:
			[]
	var updates_owned_record: Bool = False
	var owned_hand_offs: List[Int] = []
	var called: List[Int] = []
	var pending: List[CoreExpr] = match clone.body:
		Some(body):
			[body]
		None:
			[]
	var index: Int = 0

	while index < pending.length():
		match pending.get(index):
			Some(current_expr):
				match current_expr:
					LetExpr(variable, _, _, rhs, _):
						match rhs:
							VarExpr(source, _, _):
								if var_list_contains(family, source):
									family = family.append(variable)
								else:
									void
							_:
								void
					RecordUpdateExpr(update_base, _, _, _):
						match update_base:
							VarExpr(base, _, _):
								if var_list_contains(family, base):
									updates_owned_record = True
								else:
									void
							_:
								void
					CallExpr(UserCall(name, Some(def_id), _), _, args, _, _):
						match candidate_for_clone_call(state, name, def_id):
							Some(candidate):
								called = called.append(def_id)

								if hands_on_family_member(family, args, candidate.key.arg_index):
									owned_hand_offs = owned_hand_offs.append(def_id)
								else:
									void
							None:
								void
					_:
						void

				for child in CoreTraverse.immediate_core_expr_children(current_expr):
					pending = pending.append(child)
			None:
				break

		index += 1

	{
		updates_owned_record = updates_owned_record,
		owned_hand_offs = owned_hand_offs,
		called_clone_def_ids = called
	}


private pure func is_beneficial(benefit: ConsumingCloneBenefit) -> Bool:
	match benefit:
		UpdatesOwnedRecordInPlace | HandsOwnedRecordToBeneficialClone:
			True
		NoInPlaceBenefit:
			False


private pure func benefit_of(
	benefits: Dict[Int, ConsumingCloneBenefit],
	clone_def_id: Int,
) -> ConsumingCloneBenefit:
	benefits.get_or(clone_def_id, NoInPlaceBenefit)


---
Least fixpoint of the benefit relation over the built clones: a clone
benefits when it updates its owned record in place, or when it hands the
record on at its last use to a clone that benefits. Starting from the direct
updates and only ever adding hand-offs keeps recursion honest: a clone whose
only hand-off is to itself never qualifies.
---
private pure func classify_consuming_clones(
	scans: Dict[Int, ConsumingCloneScan],
	clone_def_ids: List[Int],
) -> Dict[Int, ConsumingCloneBenefit]:
	var benefits: Dict[Int, ConsumingCloneBenefit] = {}

	for clone_def_id in clone_def_ids:
		match scans.get(clone_def_id):
			Some(scan):
				if scan.updates_owned_record:
					benefits = benefits.set(clone_def_id, UpdatesOwnedRecordInPlace)
				else:
					benefits = benefits.set(clone_def_id, NoInPlaceBenefit)
			None:
				void

	var changed: Bool = True

	while changed:
		changed = False

		for clone_def_id in clone_def_ids:
			if not is_beneficial(benefit_of(benefits, clone_def_id)):
				match scans.get(clone_def_id):
					Some(scan):
						if hands_off_to_beneficial_clone(benefits, scan.owned_hand_offs):
							benefits = benefits.set(clone_def_id, HandsOwnedRecordToBeneficialClone)
							changed = True
						else:
							void
					None:
						void
			else:
				void

	benefits


---
Calls to clones without a benefit go back to the original function.
---
private record CloneCallReversal {
	state: ConsumeSpecializeState,
	benefits: Dict[Int, ConsumingCloneBenefit]
}


private pure func revert_calls_without_benefit(
	reversal: CloneCallReversal,
	expr: CoreExpr,
) -> CoreExpr:
	mapped: CoreExpr = match expr:
		SeqExpr(_, _):
			CoreTraverse.map_core_sequence_items(
				expr,
				func(item): revert_calls_without_benefit(reversal, item),
			)
		LogicalExpr(_, _, _, _, _):
			CoreTraverse.map_core_logical_tree_with_context(
				expr,
				reversal,
				revert_calls_without_benefit,
			)
		_:
			CoreTraverse.map_core_expr_children_with_context(
				expr,
				reversal,
				revert_calls_without_benefit,
			)

	match mapped:
		CallExpr(UserCall(name, Some(def_id), consumed_args), callee, args, typ, loc):
			if is_beneficial(benefit_of(reversal.benefits, def_id)):
				mapped
			else:
				match candidate_for_clone_call(reversal.state, name, def_id):
					Some(candidate):
						CallExpr(
							UserCall(candidate.key.original_name, Some(candidate.key.original_def_id), consumed_args),
							rewrite_callee_expr(
								candidate.key.original_name,
								candidate.key.original_def_id,
								callee,
							),
							args,
							typ,
							loc,
						)
					None:
						mapped
		_:
			mapped


private pure func revert_decl_calls_without_benefit(
	reversal: CloneCallReversal,
	decl: CoreDecl,
) -> CoreDecl:
	match decl:
		FunctionDecl(func_info):
			match func_info.body:
				Some(body):
					FunctionDecl({ func_info | body = Some(revert_calls_without_benefit(reversal, body)) })
				None:
					decl
		GlobalDecl(global):
			GlobalDecl({ global | init = revert_calls_without_benefit(reversal, global.init) })
		_:
			decl


private pure func calls_clone_without_benefit(
	benefits: Dict[Int, ConsumingCloneBenefit],
	called_clone_def_ids: List[Int],
) -> Bool:
	called_clone_def_ids.any(func(def_id): not is_beneficial(benefit_of(benefits, def_id)))


---
Functions that have clone candidates, by def id. A def id may be shared by
functions of different names, so each entry lists every such function and
the clone key's name picks among them.
---
private pure func original_functions_with_candidates(
	state: ConsumeSpecializeState,
	decls: List[CoreDecl],
) -> Dict[Int, List[CoreFunction]]:
	var originals: Dict[Int, List[CoreFunction]] = {}

	for decl in decls:
		match decl:
			FunctionDecl(func_info):
				if state.candidates.ordinals_by_original_def_id.contains(func_info.def_id):
					originals = originals.set(
						func_info.def_id,
						originals.get_or(func_info.def_id, []).append(func_info),
					)
				else:
					void
			_:
				void

	originals


private pure func original_function_for_key(
	originals: Dict[Int, List[CoreFunction]],
	key: CloneKey,
) -> Option[CoreFunction]:
	originals
		.get_or(key.original_def_id, [])
		.find(func(func_info): func_info.name == key.original_name)


---
Every clone the rewritten program uses, built until no new clone key appears
(a clone's body hands its owned record on at its last use, which can use a
clone of another function or of itself), with one scan of each clone's body.
Every candidate already holds a reserved def id, so the loop only decides
which clones exist; it ends because the candidate set is finite.
---
private record BuiltConsumingClones {
	state: ConsumeSpecializeState,
	clones_by_def_id: Dict[Int, CoreFunction],
	scans: Dict[Int, ConsumingCloneScan],
	built_order: List[Int]
}


private pure func build_used_clones(
	state: ConsumeSpecializeState,
	original_decls: List[CoreDecl],
) -> BuiltConsumingClones:
	originals: Dict[Int, List[CoreFunction]] = original_functions_with_candidates(state, original_decls)
	var current: ConsumeSpecializeState = state
	var clones_by_def_id: Dict[Int, CoreFunction] = {}
	var scans: Dict[Int, ConsumingCloneScan] = {}
	var built_order: List[Int] = []
	var built_new_clone: Bool = True

	while built_new_clone:
		built_new_clone = False

		for candidate in current.candidates.ordered:
			if (
				clone_key_used(current.used_clone_keys, candidate.key)
				and not clones_by_def_id.contains(candidate.clone_def_id)
			):
				match original_function_for_key(originals, candidate.key):
					Some(original_func):
						match make_consuming_clone(
							current,
							original_func,
							candidate.key.arg_index,
							candidate.clone_def_id,
						):
							Some(clone):
								scan: ConsumingCloneScan = scan_consuming_clone(
									current,
									clone,
									candidate.key.arg_index,
								)

								for called_def_id in scan.called_clone_def_ids:
									match current.candidates.ordinal_by_clone_def_id.get(called_def_id):
										Some(ordinal):
											match current.candidates.ordered.get(ordinal):
												Some(called):
													current = mark_clone_used(current, called.key)
												None:
													void
										None:
											void

								clones_by_def_id = clones_by_def_id.set(candidate.clone_def_id, clone)
								scans = scans.set(candidate.clone_def_id, scan)
								built_order = built_order.append(candidate.clone_def_id)
								built_new_clone = True
							None:
								void
					None:
						void
			else:
				void

	{
		state = current,
		clones_by_def_id = clones_by_def_id,
		scans = scans,
		built_order = built_order
	}


---
The beneficial clones reachable from the rewritten program: calls to clones
without a benefit are reverted, so only those clones can still be called.
---
private pure func reachable_beneficial_clones(
	built: BuiltConsumingClones,
	benefits: Dict[Int, ConsumingCloneBenefit],
	program_calls: List[Int],
) -> Dict[Int, Bool]:
	var reachable: Dict[Int, Bool] = {}
	var pending: List[Int] = program_calls
	var index: Int = 0

	while index < pending.length():
		match pending.get(index):
			Some(clone_def_id):
				if is_beneficial(benefit_of(benefits, clone_def_id)) and not reachable.contains(clone_def_id):
					reachable = reachable.set(clone_def_id, True)

					match built.scans.get(clone_def_id):
						Some(scan):
							pending = pending.concat(scan.called_clone_def_ids)
						None:
							void
				else:
					void
			None:
				break

		index += 1

	reachable


private pure func clones_after(
	state: ConsumeSpecializeState,
	kept_clones: Dict[Int, CoreFunction],
	original_func: CoreFunction,
) -> List[CoreDecl]:
	var result: List[CoreDecl] = []

	match state.candidates.ordinals_by_original_def_id.get(original_func.def_id):
		Some(ordinals):
			for ordinal in ordinals:
				match state.candidates.ordered.get(ordinal):
					Some(candidate):
						if (
							candidate.key.original_name == original_func.name
							and candidate.key.original_def_id == original_func.def_id
						):
							match kept_clones.get(candidate.clone_def_id):
								Some(clone):
									result = result.append(FunctionDecl(clone))
								None:
									void
						else:
							void
					None:
						void
		None:
			void

	result


private pure func insert_clones_after_functions(
	state: ConsumeSpecializeState,
	kept_clones: Dict[Int, CoreFunction],
	original_decls: List[CoreDecl],
	rewritten_decls: List[CoreDecl],
) -> List[CoreDecl]:
	var result: List[CoreDecl] = []
	var index: Int = 0

	for decl in rewritten_decls:
		result = result.append(decl)

		match original_decls.get(index):
			Some(original_decl):
				match original_function_for_decl(original_decl):
					Some(original_func):
						for clone_decl in clones_after(state, kept_clones, original_func):
							result = result.append(clone_decl)
					None:
						void
			None:
				void

		index += 1

	result


---
Carries the advanced definition-id frontier back out: clone discovery
mints one def_id per accepted candidate, so the pass runner's
`CorePassState.next_def_id` must learn about them instead of the next
pass rescanning the program to find them.
---
record ConsumeSpecializeResult {
	program: CoreProgram,
	next_def_id: Int
}


pure func rewrite_program(program: CoreProgram, next_def_id: Int) -> ConsumeSpecializeResult:
	discovery: CloneCandidateDiscoveryState = discover_clone_candidates(program, next_def_id)

	if discovery.candidates.ordered.length() == 0:
		{ program = program, next_def_id = discovery.next_def_id }
	else:
		var state: ConsumeSpecializeState = state_from_discovery(discovery)
		var rewritten_decls: List[CoreDecl] = []
		var calls_by_decl: List[List[Int]] = []
		var program_calls: List[Int] = []

		for decl in program.decls:
			rewritten_decl: CoreDecl = rewrite_decl_body(state, decl)
			collection: CloneCallCollection = match decl_body(rewritten_decl):
				Some(body):
					collect_clone_calls_from_expr(state, body)
				None:
					{state = state, called_clone_def_ids = []}
			state = collection.state
			rewritten_decls = rewritten_decls.append(rewritten_decl)
			calls_by_decl = calls_by_decl.append(collection.called_clone_def_ids)
			program_calls = program_calls.concat(collection.called_clone_def_ids)

		built: BuiltConsumingClones = build_used_clones(state, program.decls)
		benefits: Dict[Int, ConsumingCloneBenefit] = classify_consuming_clones(built.scans, built.built_order)
		reachable: Dict[Int, Bool] = reachable_beneficial_clones(built, benefits, program_calls)
		reversal: CloneCallReversal = {state = built.state, benefits = benefits}
		var final_decls: List[CoreDecl] = []
		var index: Int = 0

		for decl in rewritten_decls:
			if calls_clone_without_benefit(benefits, calls_by_decl.get_or(index, [])):
				final_decls = final_decls.append(revert_decl_calls_without_benefit(reversal, decl))
			else:
				final_decls = final_decls.append(decl)

			index += 1

		var kept_clones: Dict[Int, CoreFunction] = {}

		for clone_def_id in built.built_order:
			if reachable.contains(clone_def_id):
				match built.clones_by_def_id.get(clone_def_id):
					Some(clone):
						scan: ConsumingCloneScan = built.scans.get(clone_def_id).get_or({
							updates_owned_record = False,
							owned_hand_offs = [],
							called_clone_def_ids = []
						})
						kept: CoreFunction = if calls_clone_without_benefit(benefits, scan.called_clone_def_ids):
							match revert_decl_calls_without_benefit(reversal, FunctionDecl(clone)):
								FunctionDecl(reverted):
									reverted
								_:
									clone
						else:
							clone
						kept_clones = kept_clones.set(clone_def_id, kept)
					_:
						void
			else:
				void

		{
			program = {
				decls = insert_clones_after_functions(built.state, kept_clones, program.decls, final_decls),
				foreign_includes = program.foreign_includes,
				source_files = program.source_files
			},
			next_def_id = discovery.next_def_id
		}
