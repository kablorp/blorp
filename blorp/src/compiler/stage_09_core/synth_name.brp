-- Shared identity and admission policy for post-mono body synthesis.
--
-- A flattened Core name cannot be split safely on `__`: both module segments
-- and source names may contain that sequence. Decode relative to the explicit
-- source module carried by the function, then remove only compiler-owned
-- suffixes.
import:
	../stage_08_core_lower/identity: core_module_member_prefix
	ir: CoreFunction, CoreFunctionKind(UnresolvedBuiltinFunction)


private MONO_NAME_MARKER: String = "__mono_"

private PURE_NAME_SUFFIX: String = "__pure"


private pure func last_index_of(value: String, needle: String) -> Int:
	var last_index: Int = -1
	var search_start: Int = 0

	while search_start < value.length():
		remaining: String = value.substring(search_start, value.length() - search_start)
		relative_index: Int = remaining.raw_index_of(needle)

		if relative_index < 0:
			break
		else:
			last_index = search_start + relative_index
			search_start = last_index + needle.length()

	last_index


private pure func strip_mono_suffix(name: String) -> String:
	marker_index: Int = last_index_of(name, MONO_NAME_MARKER)

	if marker_index < 0:
		name
	else:
		name.substring(0, marker_index)


private pure func strip_pure_suffix(name: String) -> String:
	if name.ends_with(PURE_NAME_SUFFIX):
		name.substring(0, name.length() - PURE_NAME_SUFFIX.length())
	else:
		name


-- `module_prefix` is the precomputed `core_module_member_prefix` of
-- `function_info.source_module`; callers scanning many functions of one
-- module spell it once and use this entry.
pure func synthesis_source_name_with_prefix(
	module_prefix: String,
	function_info: CoreFunction,
) -> Option[String]:
	if not function_info.name.starts_with(module_prefix):
		None
	else:
		qualified_name: String = function_info.name.substring(
			module_prefix.length(),
			function_info.name.length() - module_prefix.length(),
		)
		Some(strip_pure_suffix(strip_mono_suffix(qualified_name)))


pure func synthesis_source_name(function_info: CoreFunction) -> Option[String]:
	module_name ?= function_info.source_module
	synthesis_source_name_with_prefix(core_module_member_prefix(module_name), function_info)


pure func is_synthesis_candidate(function_info: CoreFunction) -> Bool:
	if not function_info.type_params.is_empty():
		False
	else:
		match function_info.body:
			Some(_):
				False
			None:
				match function_info.function_kind:
					UnresolvedBuiltinFunction:
						True
					_:
						False
