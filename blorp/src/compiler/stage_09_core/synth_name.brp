-- Shared identity and admission policy for post-mono body synthesis.
--
-- A flattened Core name cannot be split safely on `__`: both module segments
-- and source names may contain that sequence. Decode relative to the explicit
-- source module carried by the function, then remove only compiler-owned
-- suffixes.
--
-- This module also owns the two markers `mono.brp` embeds when it
-- synthesizes a specialized function or data-type name
-- (`mangle_specialization_name`/`mangle_generic_data_name`) and the single
-- accessor set that recovers a name's parts from them. No other module may
-- parse a mono-mangled or pure-overload name directly; call these accessors
-- instead.
import:
	../stage_08_core_lower/identity: core_module_member_prefix
	ir: CoreFunction, CoreFunctionKind(UnresolvedBuiltinFunction)


-- `mono.brp` embeds this marker right after a specialized function or
-- data-type's source name, followed by an encoded substitution or argument
-- list. This module owns the marker and the accessors below; no other
-- module may embed or parse it directly.
MONO_NAME_MARKER: String = "__mono_"

-- `stage_08_core_lower/identity.brp`'s pure-overload naming appends this
-- suffix to a function's mangled name. This module owns the accessor
-- that recovers a name's parts; no other module may parse it directly.
PURE_NAME_SUFFIX: String = "__pure"


private pure func last_index_of(value: String, needle: String) -> Int:
	var last_index: Int = -1
	var search_start: Int = 0

	while search_start < value.length():
		remaining: String = value.substring(search_start, value.length() - search_start)
		relative_index: Int = remaining.raw_index_of(needle)

		if relative_index < 0:
			break
		else:
			last_index = search_start + relative_index
			search_start = last_index + needle.length()

	last_index


---
The base name before the last `MONO_NAME_MARKER`, or `name` unchanged when
it carries no marker. A name can carry the marker more than once: mono can
specialize an already-specialized name (for example a pure-overload variant
of a prior specialization), so an earlier round's marker survives inside
the base name and only the last marker delimits the outermost
specialization's encoded suffix.
---
pure func mono_name_base(name: String) -> String:
	index: Int = last_index_of(name, MONO_NAME_MARKER)

	if index < 0:
		name
	else:
		name.substring(0, index)


---
True when `name` carries a mono-specialization marker.
---
pure func is_mono_specialization_name(name: String) -> Bool:
	last_index_of(name, MONO_NAME_MARKER) >= 0


---
True when `name` ends with the pure-overload suffix.
---
pure func is_pure_variant_name(name: String) -> Bool:
	name.ends_with(PURE_NAME_SUFFIX)


---
`name` with a trailing pure-overload suffix removed, or `name` unchanged
when it carries none.
---
pure func strip_pure_suffix(name: String) -> String:
	if is_pure_variant_name(name):
		name.substring(0, name.length() - PURE_NAME_SUFFIX.length())
	else:
		name


---
`module_prefix` is the precomputed `core_module_member_prefix` of
`function_info.source_module`; callers scanning many functions of one
module spell it once and use this entry.
---
pure func synthesis_source_name_with_prefix(
	module_prefix: String,
	function_name: String,
) -> Option[String]:
	if not function_name.starts_with(module_prefix):
		None
	else:
		qualified_name: String = function_name.substring(
			module_prefix.length(),
			function_name.length() - module_prefix.length(),
		)
		Some(strip_pure_suffix(mono_name_base(qualified_name)))


pure func synthesis_source_name(function_info: CoreFunction) -> Option[String]:
	module_name ?= function_info.source_module
	synthesis_source_name_with_prefix(core_module_member_prefix(module_name), function_info.name)


pure func is_synthesis_candidate(function_info: CoreFunction) -> Bool:
	if not function_info.type_params.is_empty():
		False
	else:
		match function_info.body:
			Some(_):
				False
			None:
				match function_info.function_kind:
					UnresolvedBuiltinFunction:
						True
					_:
						False
