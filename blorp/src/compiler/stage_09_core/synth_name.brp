-- Shared identity and admission policy for post-mono body synthesis.
--
-- A synthesis pass is given a source declaration (or a mono instance or pure
-- variant of one) and the source member name the declaration is: `sqrt` of
-- `float`, `map` of `list`. The member is the declaration's own spelling, read
-- through `CoreFunction.origin` (`CoreDeclarationIndex`), never decoded from the
-- function's flattened name, which may carry a module prefix, a mono marker and a
-- pure suffix in any combination.
import:
	ir:
		CoreDeclarationIndex,
		CoreFunction,
		CoreFunctionKind(UnresolvedBuiltinFunction),
		core_declared_member_spelling,


-- `mono.brp` embeds this marker right after a specialized function or
-- data-type's source name, followed by an encoded substitution or argument
-- list. This module owns the marker; no reader parses it (a function's
-- `origin` says what it is an instance of), and the producer goes with the
-- marked names in docs/NAME_MANGLING_REMOVAL_ROADMAP.md step M3.1.
MONO_NAME_MARKER: String = "__mono_"


---
Whether a synthesis pass may give `function_info` a body: a bodyless, non-generic
function the runtime provides (`UnresolvedBuiltinFunction`).
---
pure func is_synthesis_candidate(function_info: CoreFunction) -> Bool:
	if not function_info.type_params.is_empty():
		False
	else:
		match function_info.body:
			Some(_):
				False
			None:
				match function_info.function_kind:
					UnresolvedBuiltinFunction:
						True
					_:
						False


---
The source member name the synthesis passes match `function_info` against, when
`function_info` is a synthesis candidate that a source declaration stands behind.

A member is a spelling key into the passes' body tables (`list` `map`, `float`
`sqrt`, ...), so the passes still compare it with String vocabularies; what is
decided here is only which declaration the function is, from its origin.
---
pure func synthesis_member(
	declarations: CoreDeclarationIndex,
	function_info: CoreFunction,
) -> Option[String]:
	if not is_synthesis_candidate(function_info):
		None
	else:
		core_declared_member_spelling(declarations, function_info)
