-- Shared identity and admission policy for post-mono body synthesis.
--
-- A flattened Core name cannot be split safely on `__`: both module segments
-- and source names may contain that sequence. Decode relative to the explicit
-- source module carried by the function. The function a synthesis pass is
-- given is a source declaration (or a copy carrying its name, see
-- `synth.brp`'s `synthesis_declaration_view`), so its name carries no
-- compiler-owned suffix to remove: which declaration an instance or pure
-- variant is a copy of is `CoreFunction.origin`'s to say.
import:
	../stage_08_core_lower/identity: core_module_member_prefix
	ir:
		CoreCopyDeclarationNames,
		CoreFunction,
		CoreFunctionKind(UnresolvedBuiltinFunction),
		core_declaration_name,


-- `mono.brp` embeds this marker right after a specialized function or
-- data-type's source name, followed by an encoded substitution or argument
-- list. This module owns the marker; no reader parses it (a function's
-- `origin` says what it is an instance of), and the producer goes with the
-- marked names in docs/NAME_MANGLING_REMOVAL_ROADMAP.md step M3.1.
MONO_NAME_MARKER: String = "__mono_"


---
`module_prefix` is the precomputed `core_module_member_prefix` of
`function_info.source_module`; callers scanning many functions of one
module spell it once and use this entry.
---
pure func synthesis_source_name_with_prefix(
	module_prefix: String,
	function_name: String,
) -> Option[String]:
	if not function_name.starts_with(module_prefix):
		None
	else:
		qualified_name: String = function_name.substring(
			module_prefix.length(),
			function_name.length() - module_prefix.length(),
		)
		Some(qualified_name)


pure func synthesis_source_name(function_info: CoreFunction) -> Option[String]:
	module_name ?= function_info.source_module
	synthesis_source_name_with_prefix(core_module_member_prefix(module_name), function_info.name)


pure func is_synthesis_candidate(function_info: CoreFunction) -> Bool:
	if not function_info.type_params.is_empty():
		False
	else:
		match function_info.body:
			Some(_):
				False
			None:
				match function_info.function_kind:
					UnresolvedBuiltinFunction:
						True
					_:
						False


---
`function_info` as the synthesis passes read it: for a candidate that is a mono
instance or pure variant, a copy carrying the name of the declaration it is a
copy of (`names`, from `CorePassState.copy_declaration_names`), so a pass that
asks for the function's source member name gets the source declaration's without
parsing a marker out of the copy's mangled name. Every other function is returned
as it is. `synthesize_function` puts the real name back on the result, so the
synthesized copy keeps its own name.

INTERIM: this is a name round-trip (rename to the declaration, synthesize, restore).
It goes when the synthesis passes match on the declaration's origin or ids instead
of a source-name String (docs/NAME_ID_ROADMAP.md, Interim states). A copy `names`
does not list keeps its own name, which no pass matches, so nothing is synthesized
for it; the origin agreement invariant reports such a copy loudly.
---
pure func synthesis_declaration_view(
	names: CoreCopyDeclarationNames,
	function_info: CoreFunction,
) -> CoreFunction:
	if not is_synthesis_candidate(function_info):
		function_info
	else:
		declaration_name: String = core_declaration_name(names, function_info)

		if declaration_name == function_info.name:
			function_info
		else:
			{ function_info | name = declaration_name }
