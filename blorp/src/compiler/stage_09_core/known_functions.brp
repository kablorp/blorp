		member = NAME_ID_LOG,
		known = VectorLog
	},
	{
		module_path = MODULE_VECTOR,
		member = NAME_ID_ABS,
		known = VectorAbs
	},
	{
		module_path = MODULE_FLOAT,
		member = NAME_ID_SQRT,
		known = FloatSqrt
	},
	{
		module_path = MODULE_FLOAT,
		member = NAME_ID_EXP,
		known = FloatExp
	},
	{
		module_path = MODULE_FLOAT,
		member = NAME_ID_LOG,
		known = FloatLog
	},
	{
