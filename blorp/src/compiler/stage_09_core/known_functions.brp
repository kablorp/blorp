---
The recognised `HasLength.length` implementations.
---
CORE_KNOWN_IMPL_METHOD_ROWS: List[CoreKnownImplMethodRow] = [
	{
		module_path = MODULE_LIST,
		trait_name = NAME_ID_HAS_LENGTH_TRAIT,
		method = NAME_ID_LENGTH,
		known = ListLength
	},
	{
		module_path = MODULE_STRING,
		trait_name = NAME_ID_HAS_LENGTH_TRAIT,
		method = NAME_ID_LENGTH,
		known = StringLength
	},
]


---
The known function that is member `member` of the standard-library module
`module_path`, if any. `member` is a source spelling's id (the declaration's, not
a mono instance's or pure variant's).
---
pure func core_known_function(module_path: String, member: NameId) -> Option[CoreKnownFunction]:
	row ?= CORE_KNOWN_FUNCTION_ROWS.find(func(candidate):
		name_ids_equal(candidate.member, member) and candidate.module_path == module_path
	)
	Some(row.known)


---
The known function that is `method` of `trait_name` implemented in the
standard-library module `module_path`, if any.
---
pure func core_known_impl_method(
	module_path: String,
	trait_name: NameId,
	method: NameId,
) -> Option[CoreKnownFunction]:
	row ?= CORE_KNOWN_IMPL_METHOD_ROWS.find(func(candidate):
		(
			name_ids_equal(candidate.trait_name, trait_name)
			and name_ids_equal(candidate.method, method)
			and candidate.module_path == module_path
		)
	)
	Some(row.known)
