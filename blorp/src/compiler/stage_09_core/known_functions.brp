	},
	{
		module_path = MODULE_STRING,
		member = NAME_ID_TRIM,
		known = StringTrim
	},
	{
		module_path = MODULE_STRING,
		member = NAME_ID_TRIM_LEFT,
		known = StringTrimLeft
	},
	{
		module_path = MODULE_STRING,
		member = NAME_ID_TRIM_RIGHT,
		known = StringTrimRight
	},
	{
		module_path = MODULE_STRING,
		member = NAME_ID_LENGTH,
		known = StringLength
	},
	{
		module_path = MODULE_VECTOR,
		member = NAME_ID_PARALLEL,
		known = VectorParallel
	},
	{
		module_path = MODULE_VECTOR,
		member = NAME_ID_NORM,
		known = VectorNorm
	},
	{
		module_path = MODULE_VECTOR,
		member = NAME_ID_SQRT,
		known = VectorSqrt
	},
	{
		module_path = MODULE_VECTOR,
