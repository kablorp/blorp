-- The standard-library functions the Core passes recognise by identity.
--
-- A pass that fuses or specializes calls to `list.map`, `string.trim`, ... asks
-- "is this function that member of that module?". The answer is a fact about
-- the declaration the function is (or is an instance or variant of), so it is
-- decided once here from the pair `(module, member)`, never read out of a
-- function's flattened name:
--
--   * the member is the declaration's source spelling as a pinned `NameId`
--     (`SourceFunction`, or the method of an `ImplMethod`);
--   * the module is the canonical path of a standard-library module, compared as
--     a String because that is all a function carries of its module today
--     (`CoreFunction.source_module`; docs/IDENTITY_ROADMAP.md,
--     "Function names and module origins" turns it into a module-table lookup,
--     and only this file's module constants change then).
--
-- The result is a closed `CoreKnownFunction`, so a reader matches on a variant
-- and cannot mistype a member name or a module prefix.
import:
	../stage_02_lex/name_table:
		NAME_ID_ABS,
		NAME_ID_DROP_LEFT,
		NAME_ID_DROP_RIGHT,
		NAME_ID_EXP,
		NAME_ID_FILTER,
		NAME_ID_FILTER_MAP,
		NAME_ID_FOLD_LEFT,
		NAME_ID_GET_OR,
		NAME_ID_GET_OR_ELSE,
		NAME_ID_HAS_LENGTH_TRAIT,
		NAME_ID_IS_NONE,
		NAME_ID_IS_SOME,
		NAME_ID_LENGTH,
		NAME_ID_LOG,
		NAME_ID_MAP,
		NAME_ID_MAP_INDEXED,
		NAME_ID_NORM,
		NAME_ID_PARALLEL,
		NAME_ID_RANGE,
		NAME_ID_REPLACE,
		NAME_ID_REVERSE,
		NAME_ID_SQRT,
		NAME_ID_SUBSTRING,
		NAME_ID_TAKE_LEFT,
		NAME_ID_TAKE_RIGHT,
		NAME_ID_TRIM,
		NAME_ID_TRIM_LEFT,
		NAME_ID_TRIM_RIGHT,
		NAME_ID_ZIP_MAP,
		NameId,
		name_ids_equal,


---
A standard-library function a Core pass treats specially. One variant per
`(module, member)` pair some pass asks about; a pass matches the variants it
handles and ignores the rest.
---
enum CoreKnownFunction:
	ListRange
	ListFilter
	ListFilterMap
	ListMap
	ListFoldLeft
	ListLength
	StringDropLeft
	StringDropRight
	StringReplace
	StringReverse
	StringSubstring
	StringTakeLeft
	StringTakeRight
	StringTrim
	StringTrimLeft
	StringTrimRight
	StringLength
	VectorParallel
	ParallelVectorMap
	ParallelVectorMapIndexed
	ParallelVectorZipMap
	MatrixParallel
	ParallelMatrixMap
	ParallelMatrixMapIndexed
	ParallelMatrixZipMap
	OptionIsSome
	OptionIsNone
	OptionGetOr
	OptionGetOrElse
	VectorNorm
	VectorSqrt
	VectorExp
	VectorLog
	VectorAbs
	FloatSqrt
	FloatExp
	FloatLog
	FloatAbs


---
One recognised standard-library function: the `(module, member)` pair that names
it and the variant that stands for it. The only place a membership is decided;
adding a function means adding its variant above and its row below (and its
pinned `NAME_ID_*`).
---
record CoreKnownFunctionRow {
	module_path: String,
	member: NameId,
	known: CoreKnownFunction
}


---
A recognised `impl Trait for T` method: `method` of `trait_name`, implemented in
the standard-library module `module_path`. `list` and `string` each implement
`HasLength` for exactly one type (`List`, `String`), so the module and the method
say which `length` it is; no type name is read. Every row's `known` also has a
`CORE_KNOWN_FUNCTION_ROWS` row.
---
record CoreKnownImplMethodRow {
	module_path: String,
	trait_name: NameId,
	method: NameId,
	known: CoreKnownFunction
}


-- The canonical paths of the standard-library modules the rows name.
private MODULE_LIST: String = "list"

private MODULE_STRING: String = "string"

private MODULE_VECTOR: String = "vector"

private MODULE_FLOAT: String = "float"

private MODULE_MATRIX: String = "matrix"

private MODULE_PARALLEL_VECTOR: String = "parallel_vector"

private MODULE_PARALLEL_MATRIX: String = "parallel_matrix"

private MODULE_OPTION: String = "option"

---
Every recognised standard-library function, one row per `CoreKnownFunction`
variant (`test_core_known_functions` checks it). Read-only, built at program start.
---
CORE_KNOWN_FUNCTION_ROWS: List[CoreKnownFunctionRow] = [
	{
		module_path = MODULE_LIST,
		member = NAME_ID_RANGE,
		known = ListRange
	},
	{
		module_path = MODULE_LIST,
		member = NAME_ID_FILTER,
		known = ListFilter
	},
	{
		module_path = MODULE_LIST,
		member = NAME_ID_FILTER_MAP,
		known = ListFilterMap
	},
	{
		module_path = MODULE_LIST,
		member = NAME_ID_MAP,
		known = ListMap
	},
	{
		module_path = MODULE_LIST,
		member = NAME_ID_FOLD_LEFT,
