		summarize_linear_borrow,
		summarize_match_ownership_uses,
		direct_aliases_name,
		match_bindings_shadow,
		max_int,
		summarize_linear_ownership_uses,
	work_counters:
		perceus_work_contract_collection_expression_visits,
		perceus_work_contract_collection_task_pushes,
		perceus_work_contract_direct_parameter_inserts,
		perceus_work_contract_dup_fallback_analyses,
		perceus_work_contract_flow_dedup_entries,
		perceus_work_contract_flow_edges,
		perceus_work_contract_function_analyses,
		perceus_work_contract_managed_parameter_slots,
		perceus_work_contract_managed_parameter_summaries,
		perceus_work_contract_reverse_parameter_slots,
		perceus_work_contract_scalar_fallback_analyses,
		perceus_work_contract_shadow_fallback_analyses,
		perceus_work_contract_solver_flow_visits,
		perceus_work_contract_solver_frontier_callable_visits,
		perceus_work_contract_solver_parameter_marks,
		perceus_work_contract_solver_wave_iterations,
	results_and_loops:
		binary_operands_are_borrowed,
	mutable:
		assignment_rhs_returns_alias,
	../resolve as CoreResolve
	../traverse as CoreTraverse
	../type_policy as CoreTypePolicy


record ParameterFlow {
	caller: OwnershipCallableId,
	caller_parameter_index: Int,
	callee: OwnershipCallableId,
	callee_argument_index: Int
}


record ReverseParameterFlow {
	caller: OwnershipCallableId,
	caller_parameter_index: Int
}


record FunctionContractEquation {
	function: OwnershipCallableId,
	directly_consumed_parameters: List[Int]
}


record OwnershipContractGraph {
	equations_by_callable_id: List[FunctionContractEquation],
	reverse_flows_by_callee_and_argument: List[Dict[Int, List[ReverseParameterFlow]]],
	scalar_balance_fallbacks: List[ScalarBalanceFallback]
}


private record PendingContractWork {
	callable: OwnershipCallableId,
	parameter_frontier: List[Int]
}


private record ScalarBalanceFallback {
	callable: OwnershipCallableId,
	declaration_index: Int,
	has_incoming_dup: Bool,
	has_parameter_shadow: Bool
}


private record ContractParameterIndex {
	params: List[CoreParam],
	candidate_indices_by_name: Dict[String, List[Int]]
}


private union ContractConsumptionDemand:
	BorrowContractResult
	ConsumeContractResult
	DeferredContractResult(OwnershipCallableId, Int)
	ReturnContractResult(CoreType)
	InspectNestedContractRegion


private union ContractCollectionTaskStack:
	ContractCollectionComplete
	ContractCollectionMore(ContractConsumptionDemand, CoreExpr, ContractCollectionTaskStack)


private record ContractCollectionState {
	directly_consumed_parameters: Dict[Int, Bool],
	user_call_flows: List[ParameterFlow],
	seen_user_call_flows: Dict[Int, Dict[Int, Dict[Int, Bool]]],
	contains_parameter_dup: Bool,
	contains_parameter_shadow: Bool
}


private record ContractCollectionStep {
	state: ContractCollectionState,
	pending: ContractCollectionTaskStack
}


private record CollectedContractEquation {
	equation: FunctionContractEquation,
	user_call_flows: List[ParameterFlow],
	contains_parameter_dup: Bool,
	contains_parameter_shadow: Bool
}


pure func int_list_contains(items: List[Int], value: Int) -> Bool:
	items.any(func(item): item == value)


private pure func merge_consumed_args(left: List[Int], right: List[Int]) -> List[Int]:
	var merged: List[Int] = left

	for index in right:
		if not int_list_contains(merged, index):
			merged = merged.append(index)
		else:
			void

	merged


private pure func contract_parameter_index(
	index: ContractParameterIndex,
	variable: CoreVar,
) -> Option[Int]:
	var found: Option[Int] = None

	for candidate_index in index.candidate_indices_by_name.get_or(variable.name, []):
		match index.params.get(candidate_index):
			Some(param):
				if core_var_equal(variable, param.name):
					found = Some(candidate_index)
					break
				else:
					void
			None:
				void

	found


private pure func build_contract_parameter_index(
	env: PerceusEnv,
	params: List[CoreParam],
) -> ContractParameterIndex:
	var candidates: Dict[String, List[Int]] = {}
	var parameter_index: Int = 0

	for param in params:
		if is_managed_type(env, param.typ):
			debug:
				perceus_work_contract_managed_parameter_slots()

			candidates = candidates.set(
				param.name.name,
				candidates
					.get_or(param.name.name, [])
					.append(parameter_index),
			)
		else:
			void

		parameter_index += 1

	{
		params = params,
		candidate_indices_by_name = candidates
	}


private pure func contract_var_collides_with_parameter(
	index: ContractParameterIndex,
	variable: CoreVar,
) -> Bool:
	contract_parameter_index(index, variable) != None


private pure func contract_bindings_shadow_parameter(
	index: ContractParameterIndex,
	bindings: List[CoreMatchBinding],
) -> Bool:
	bindings.any(func(binding):
		contract_var_collides_with_parameter(index, binding.variable)
	)


private pure func contract_literal_match_shadows_parameter(
	index: ContractParameterIndex,
	match_expr: CoreConstructorLiteralMatch,
) -> Bool:
	var shadowed: Bool = match_expr.cases.any(func(match_case):
		contract_bindings_shadow_parameter(index, match_case.bindings)
	)

	if not shadowed:
		shadowed = match match_expr.fallback:
			LiteralMatchFallbackBindings(bindings, body):
				contract_bindings_shadow_parameter(index, bindings)
			_:
				False
	else:
		void

	shadowed


private pure func contract_match_body_shadows_parameter(
	index: ContractParameterIndex,
	body: CoreConstructorMatchBody,
) -> Bool:
	match body:
		ConstructorMatchBodyExpr(expr):
			False
		ConstructorMatchBodyLiteral(match_expr):
			contract_literal_match_shadows_parameter(index, match_expr)
		ConstructorMatchBodyLength(match_expr):
			contract_length_match_shadows_parameter(index, match_expr)


private pure func contract_length_branch_shadows_parameter(
	index: ContractParameterIndex,
	branch: CoreConstructorLengthMatchBranch,
) -> Bool:
	(
		contract_bindings_shadow_parameter(index, branch.bindings)
		or contract_match_body_shadows_parameter(index, branch.body)
	)


private pure func contract_length_match_shadows_parameter(
	index: ContractParameterIndex,
	match_expr: CoreConstructorLengthMatch,
) -> Bool:
	var shadowed: Bool = match_expr.cases.any(func(match_case):
		contract_length_branch_shadows_parameter(index, match_case.branch)
	)

	if not shadowed:
		shadowed = match match_expr.geq:
			Some(match_case):
				contract_length_branch_shadows_parameter(index, match_case.branch)
			None:
				False
	else:
		void

	if not shadowed:
		shadowed = match match_expr.fallback:
			Some(branch):
				contract_length_branch_shadows_parameter(index, branch)
			None:
				False
	else:
		void

	shadowed


private pure func contract_constructor_match_shadows_parameter(
	index: ContractParameterIndex,
	cases: List[CoreConstructorMatchCase],
	fallback: CoreConstructorMatchFallback,
) -> Bool:
	var shadowed: Bool = cases.any(func(match_case):
		(
			contract_bindings_shadow_parameter(index, match_case.bindings)
			or contract_match_body_shadows_parameter(index, match_case.body)
		)
	)

	if not shadowed:
		shadowed = match fallback:
			ConstructorMatchFallbackBindings(bindings, body):
				contract_bindings_shadow_parameter(index, bindings)
			_:
				False
	else:
		void

	shadowed


private pure func contract_params_shadow_parameter(
	index: ContractParameterIndex,
	params: List[CoreParam],
) -> Bool:
	params.any(func(param):
		contract_var_collides_with_parameter(index, param.name)
	)


private pure func contract_expr_introduces_parameter_shadow(
	index: ContractParameterIndex,
	expr: CoreExpr,
) -> Bool:
	match expr:
		LetExpr(variable, _, _, _, _) | BorrowLetExpr(variable, _, _, _):
			contract_var_collides_with_parameter(index, variable)
		TensorRawViewLetExpr(binding, _, _, _):
			contract_var_collides_with_parameter(index, binding.variable)
		ListHandoffExpr(handoff, _, _):
			(
				contract_var_collides_with_parameter(index, handoff.source_var)
				or contract_var_collides_with_parameter(index, handoff.result_var)
				or contract_var_collides_with_parameter(index, handoff.len_var)
				or contract_var_collides_with_parameter(index, handoff.out_var)
			)
		TailrecLoopExpr(params, _, _, _):
			contract_params_shadow_parameter(index, params)
		TailrecListSpreadLoopExpr(loop, _):
			(
				contract_var_collides_with_parameter(index, loop.list_param.name)
				or contract_params_shadow_parameter(index, loop.params)
			)
		ResourceScopeExpr(scope, _, _):
			contract_var_collides_with_parameter(index, scope.variable)
		ForRangeExpr(binder, _, _, _, _, _):
			contract_var_collides_with_parameter(index, binder.variable)
		ForChannelExpr(loop, _, _):
			contract_var_collides_with_parameter(index, loop.binder.variable)
		ForListExpr(loop, _, _):
			contract_var_collides_with_parameter(index, loop.binder.variable)
		ForStringExpr(loop, _, _):
			contract_var_collides_with_parameter(index, loop.binder.variable)
		ForDictExpr(loop, _, _):
			contract_var_collides_with_parameter(index, loop.binder.variable)
		ForSetExpr(loop, _, _):
			contract_var_collides_with_parameter(index, loop.binder.variable)
		ForStreamExpr(loop, _, _):
			contract_var_collides_with_parameter(index, loop.binder.variable)
		ForResourceSourceExpr(loop, _, _):
			contract_var_collides_with_parameter(index, loop.binder.variable)
		ForTensorExpr(loop, _, _):
			contract_var_collides_with_parameter(index, loop.binder.variable)
		PreClosureConcurrentExpr(block, _, _) | ConcurrentExpr(block, _, _):
			block.bindings.any(func(binding):
				contract_var_collides_with_parameter(index, binding.variable)
			)
		PreClosureConcurrentlyLoopExpr(loop, _, _) | ConcurrentlyLoopExpr(loop, _, _):
			contract_var_collides_with_parameter(index, loop.variable)
		SelectExpr(select_expr, _, _):
			select_expr.any(func(arm):
				match arm.kind:
					SelectRecvArm(recv):
						contract_var_collides_with_parameter(index, recv.binder)
					_:
						False
			)
		ConstructorMatchExpr(_, _, cases, fallback, _, _):
			contract_constructor_match_shadows_parameter(index, cases, fallback)
		LiteralMatchExpr(_, cases, fallback, typ, loc):
			contract_literal_match_shadows_parameter(
				index,
				{
					accessor = RootAccessor,
					scrutinee_type = typ,
					cases = cases,
					fallback = fallback,
					result_type = typ,
					loc = loc
				},
			)
		AccessorLiteralMatchExpr(_, _, match_expr, _, _):
			contract_literal_match_shadows_parameter(index, match_expr)
		LengthMatchExpr(_, _, match_expr, _, _):
			contract_length_match_shadows_parameter(index, match_expr)
		_:
			False


private pure func contract_direct_alias_parameter(
	index: ContractParameterIndex,
	expr: CoreExpr,
) -> Option[Int]:
	match expr:
		VarExpr(variable, typ, loc):
			contract_parameter_index(index, variable)
		FieldExpr(owner, field, typ, loc):
			contract_direct_alias_parameter(index, owner)
		TupleFieldExpr(owner, field_index, typ, loc):
			contract_direct_alias_parameter(index, owner)
		CastExpr(inner, typ, loc):
			contract_direct_alias_parameter(index, inner)
		UnboxExpr(kind, inner, typ, loc):
			contract_direct_alias_parameter(index, inner)
		_:
			None


private pure func contract_release_owner_parameter(
	index: ContractParameterIndex,
	expr: CoreExpr,
) -> Option[Int]:
	match expr:
		VarExpr(variable, typ, loc):
			contract_parameter_index(index, variable)
		CastExpr(inner, typ, loc):
			contract_release_owner_parameter(index, inner)
		UnboxExpr(PointerUnbox, inner, typ, loc):
			contract_release_owner_parameter(index, inner)
		_:
			None


private pure func record_direct_contract_parameter(
	parameter_index: Int,
	state: ContractCollectionState,
) -> ContractCollectionState:
	if state.directly_consumed_parameters.contains(parameter_index):
		state
	else:
		debug:
			perceus_work_contract_direct_parameter_inserts()

		{ state |
			directly_consumed_parameters = state.directly_consumed_parameters.set(
				parameter_index,
				True,
			)
		}


private pure func record_contract_parameter_use(
	index: ContractParameterIndex,
	caller: OwnershipCallableId,
	demand: ContractConsumptionDemand,
	variable: CoreVar,
	state: ContractCollectionState,
) -> ContractCollectionState:
	match contract_parameter_index(index, variable):
		Some(parameter_index):
			match demand:
				ConsumeContractResult:
					record_direct_contract_parameter(parameter_index, state)
				DeferredContractResult(callee, callee_argument_index):
					flow: ParameterFlow = {
						caller = caller,
						caller_parameter_index = parameter_index,
						callee = callee,
						callee_argument_index = callee_argument_index
					}
					callee_arguments: Dict[Int, Dict[Int, Bool]] = state.seen_user_call_flows.get_or(
						parameter_index,
						{},
					)
					argument_indices: Dict[Int, Bool] = callee_arguments.get_or(callee, {})

					if argument_indices.contains(callee_argument_index):
						state
					else:
						debug:
							perceus_work_contract_flow_edges()
							perceus_work_contract_flow_dedup_entries()

						{ state |
							user_call_flows = state.user_call_flows.append(flow),
							seen_user_call_flows = state.seen_user_call_flows.set(
								parameter_index,
								callee_arguments.set(
									callee,
									argument_indices.set(callee_argument_index, True),
								),
							)
						}
				_:
					state
		None:
			state


private pure func push_contract_task(
	pending: ContractCollectionTaskStack,
	demand: ContractConsumptionDemand,
	expr: CoreExpr,
) -> ContractCollectionTaskStack:
	debug:
		perceus_work_contract_collection_task_pushes()

	ContractCollectionMore(demand, expr, pending)


private pure func push_contract_exprs(
	pending: ContractCollectionTaskStack,
	demand: ContractConsumptionDemand,
	exprs: List[CoreExpr],
) -> ContractCollectionTaskStack:
	var next: ContractCollectionTaskStack = pending

	for expr in exprs:
		next = push_contract_task(next, demand, expr)

	next


private pure func push_contract_boxed_storage_values(
	pending: ContractCollectionTaskStack,
	values: List[CoreBoxedStorageValue],
) -> ContractCollectionTaskStack:
	var next: ContractCollectionTaskStack = pending

	for value in values:
		demand: ContractConsumptionDemand = if value.transfers_ownership:
			ConsumeContractResult
		else:
			BorrowContractResult

		next = push_contract_task(next, demand, value.value)

	next


private pure func push_contract_record_fields(
	pending: ContractCollectionTaskStack,
	fields: List[CoreRecordFieldValue],
) -> ContractCollectionTaskStack:
	var next: ContractCollectionTaskStack = pending

	for field in fields:
		next = push_contract_task(next, ConsumeContractResult, field.value)

	next


private pure func push_contract_record_cow_fields(
	pending: ContractCollectionTaskStack,
	fields: List[CoreRecordCowField],
) -> ContractCollectionTaskStack:
	var next: ContractCollectionTaskStack = pending

	for field in fields:
		match field.replacement:
			Some(replacement):
				next = push_contract_task(next, ConsumeContractResult, replacement)
			None:
				void

	next


private pure func push_optional_contract_expr(
	pending: ContractCollectionTaskStack,
	demand: ContractConsumptionDemand,
	expr: Option[CoreExpr],
) -> ContractCollectionTaskStack:
	match expr:
		Some(value):
			push_contract_task(pending, demand, value)
		None:
			pending


private pure func push_contract_call_args(
	pending: ContractCollectionTaskStack,
	modes: List[OwnershipArgMode],
	args: List[CoreExpr],
) -> ContractCollectionTaskStack:
	var next: ContractCollectionTaskStack = pending
	var argument_index: Int = 0

	for arg in args:
		demand: ContractConsumptionDemand = match modes.get(argument_index):
			Some(mode):
				if arg_consumes_caller(mode):
					ConsumeContractResult
				else:
					BorrowContractResult
			None:
				ConsumeContractResult

		next = push_contract_task(next, demand, arg)
		argument_index += 1

	next


private pure func push_contract_match_children(
	index: ContractParameterIndex,
	pending: ContractCollectionTaskStack,
	branch_demand: ContractConsumptionDemand,
	expr: CoreExpr,
) -> ContractCollectionTaskStack:
	var next: ContractCollectionTaskStack = pending
	var child_index: Int = 0

	for child in CoreTraverse.immediate_core_expr_children(expr):
		child_demand: ContractConsumptionDemand = if child_index == 0:
			if contract_direct_alias_parameter(index, child) != None:
				BorrowContractResult
			else:
				ConsumeContractResult
		else:
			branch_demand

		next = push_contract_task(next, child_demand, child)
		child_index += 1

	next


private pure func push_deferred_user_call_args(
	pending: ContractCollectionTaskStack,
	callee: OwnershipCallableId,
	args: List[CoreExpr],
) -> ContractCollectionTaskStack:
	var next: ContractCollectionTaskStack = pending
	var argument_index: Int = 0

	for arg in args:
		-- Inferred callable contracts supersede the incoming call-site list. The
		-- latter can be stale when Perceus is rerun, so it is not a direct seed.
		next = push_contract_task(
			next,
			DeferredContractResult(callee, argument_index),
			arg,
		)
		argument_index += 1

	next


private pure func schedule_contract_call(
	env: PerceusEnv,
	pending: ContractCollectionTaskStack,
	kind: CoreCallKind,
	callee: CoreExpr,
	args: List[CoreExpr],
	return_type: CoreType,
) -> ContractCollectionTaskStack:
	match kind:
		UserCall(name, def_id, explicit_consumed_args):
			match lookup_return_type_constructor_call_contract(
				env,
				name,
				def_id,
				args.length(),
				return_type,
			):
				Some(contract):
					push_contract_call_args(pending, contract.args, args)
				None:
					match lookup_direct_user_call_contract(
						env,
						name,
						def_id,
						args.length(),
						return_type,
					):
						Some(contract):
							push_contract_call_args(pending, contract.args, args)
						None:
							match lookup_ownership_callable_id(env.callables, name, def_id):
								Some(callable_id):
									match env.callables.entries_by_id.get(callable_id):
										Some(entry):
											match entry.contract_source:
												InferredCallableContract:
													push_deferred_user_call_args(
														pending,
														callable_id,
														args,
													)
												FixedCallableContract(consumed_args):
													push_contract_call_args(
														pending,
														user_call_contract_from_consumed_args(
															env,
															consumed_args,
															args.length(),
															return_type,
														).args,
														args,
													)
												ExplicitCallSiteContract:
													push_contract_call_args(
														pending,
														user_call_contract_from_consumed_args(
															env,
															explicit_consumed_args,
															args.length(),
															return_type,
														).args,
														args,
													)
										None:
											push_contract_exprs(
												pending,
												ConsumeContractResult,
												args,
											)
								None:
									match contract_for_call(env, kind, args.length(), return_type):
										Some(contract):
											push_contract_call_args(pending, contract.args, args)
										None:
											push_contract_exprs(
												push_contract_task(
													pending,
													ConsumeContractResult,
													callee,
												),
												ConsumeContractResult,
												args,
											)
		_:
			match contract_for_call(env, kind, args.length(), return_type):
				Some(contract):
					with_args: ContractCollectionTaskStack = push_contract_call_args(
						pending,
						contract.args,
						args,
					)

					match kind:
						ClosureCall:
							push_contract_task(with_args, BorrowContractResult, callee)
						_:
							with_args
				None:
					push_contract_exprs(
						push_contract_task(pending, ConsumeContractResult, callee),
						ConsumeContractResult,
						args,
					)


private pure func schedule_contract_linear(
	env: PerceusEnv,
	index: ContractParameterIndex,
	caller: OwnershipCallableId,
	demand: ContractConsumptionDemand,
	expr: CoreExpr,
	state: ContractCollectionState,
	pending: ContractCollectionTaskStack,
) -> ContractCollectionStep:
	match expr:
		VarExpr(variable, typ, loc):
			{
				state = record_contract_parameter_use(index, caller, demand, variable, state),
				pending = pending
			}
		LiteralExpr(_, _, _) | StaticStringLiteralExpr(_, _, _, _) | VoidExpr(_, _) | BreakExpr(_, _):
			{
				state = state,
				pending = pending
			}
		DebugBlockExpr(body, typ, loc):
			{
				state = state,
				pending = push_contract_task(pending, demand, body)
			}
		CallExpr(kind, callee, args, typ, loc):
			{
				state = state,
				pending = schedule_contract_call(env, pending, kind, callee, args, typ)
			}
		BinaryExpr(op, left, right, typ, loc):
			child_demand: ContractConsumptionDemand = if binary_operands_are_borrowed(
				op,
				left,
				right,
			):
				BorrowContractResult
			else:
				ConsumeContractResult

			{
				state = state,
				pending = push_contract_task(
					push_contract_task(pending, child_demand, left),
					child_demand,
					right,
				)
			}
		AssignExpr(variable, rhs, typ, loc):
			rhs_demand: ContractConsumptionDemand = if assignment_rhs_returns_alias(env, rhs):
				BorrowContractResult
			else:
				ConsumeContractResult

			{
				state = state,
				pending = push_contract_task(pending, rhs_demand, rhs)
			}
		CastExpr(inner, typ, loc):
			{
				state = state,
				pending = push_contract_task(pending, BorrowContractResult, inner)
			}
		UnboxExpr(kind, inner, typ, loc):
			{
				state = state,
				pending = push_contract_task(pending, BorrowContractResult, inner)
			}
		BoxExpr(box_op, typ, loc):
			child_demand: ContractConsumptionDemand = match box_op.kind:
				PointerBox:
					demand
				_:
					BorrowContractResult

			{
				state = state,
				pending = push_contract_task(pending, child_demand, box_op.value)
			}
		FieldExpr(owner, field, typ, loc):
			{
				state = state,
				pending = push_contract_task(pending, BorrowContractResult, owner)
			}
		TupleFieldExpr(owner, field_index, typ, loc):
			{
				state = state,
				pending = push_contract_task(pending, BorrowContractResult, owner)
			}
		TupleExpr(items, typ, loc) | VectorExpr(items, typ, loc):
			{
				state = state,
				pending = push_contract_exprs(pending, ConsumeContractResult, items)
			}
		LambdaExpr(_, _, body, _, _, _):
			-- The enclosing callable borrows captures. Calls in the nested task
			-- belong to its future closure-body callable, not this equation. Visit
			-- the region once for complete collection accounting without allowing
			-- its ownership demands or calls to escape into the enclosing equation.
			{
				state = state,
				pending = push_contract_task(pending, InspectNestedContractRegion, body)
			}
		ClosureCreateExpr(_, _, _):
			{
				state = state,
				pending = pending
			}
		LetExpr(variable, is_mutable, bind_type, rhs, body):
			rhs_demand: ContractConsumptionDemand = if (
				is_managed_type(env, bind_type)
				and contract_direct_alias_parameter(index, rhs) != None
			):
				BorrowContractResult
			else:
				ConsumeContractResult

			{
				state = state,
				pending = push_contract_task(
					push_contract_task(pending, rhs_demand, rhs),
					demand,
					body,
				)
			}
		BorrowLetExpr(variable, bind_type, rhs, body):
			{
				state = state,
				pending = push_contract_task(
					push_contract_task(pending, BorrowContractResult, rhs),
					demand,
					body,
				)
			}
		SeqExpr(first, second):
			{
				state = state,
				pending = push_contract_task(
					push_contract_task(pending, ConsumeContractResult, first),
					demand,
					second,
				)
			}
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			parameter_dup: Bool = contract_parameter_index(index, variable) != None

			next_state: ContractCollectionState = if parameter_dup:
				{ state | contains_parameter_dup = True }
			else:
				state

			{
				state = next_state,
				pending = push_contract_task(pending, demand, body)
			}
		RecordExpr(fields, typ, loc) | RecordConstructExpr(_, fields, typ, loc):
			{
				state = state,
				pending = push_contract_record_fields(pending, fields)
			}
		RecordUpdateExpr(base, fields, typ, loc):
			{
				state = state,
				pending = push_contract_record_fields(
					push_contract_task(pending, ConsumeContractResult, base),
					fields,
				)
			}
		RecordReuseExpr(source, fields, typ, loc):
			{
				state = state,
				pending = push_contract_task(
					push_contract_record_fields(pending, fields),
					ConsumeContractResult,
					source,
				)
			}
		RecordCowUpdateExpr(source, fields, typ, loc):
			{
				state = state,
				pending = push_contract_task(
					push_contract_record_cow_fields(pending, fields),
					ConsumeContractResult,
					source,
				)
			}
		ListConstructExpr(construct, typ, loc):
			{
				state = state,
				pending = push_contract_boxed_storage_values(pending, construct.elements)
			}
		ListGetExpr(get, typ, loc):
			{
				state = state,
				pending = push_contract_task(
					push_contract_task(pending, BorrowContractResult, get.list),
					ConsumeContractResult,
					get.index,
				)
			}
		ListHandoffExpr(handoff, typ, loc):
			source_demand: ContractConsumptionDemand = if handoff.mode == BorrowFreshHandoff:
				BorrowContractResult
			else:
				ConsumeContractResult

			{
				state = state,
				pending = push_contract_task(
					push_contract_task(
						push_contract_task(pending, source_demand, handoff.source),
						ConsumeContractResult,
						handoff.capacity,
					),
					ConsumeContractResult,
					handoff.body,
				)
			}
		ListHandoffSetOwnedExpr(set, typ, loc):
			{
				state = state,
				pending = push_contract_task(
					push_contract_task(
						push_contract_task(pending, BorrowContractResult, set.list),
						ConsumeContractResult,
						set.index,
					),
					ConsumeContractResult,
					set.value.value,
				)
			}
		ListHandoffSetSourceSlotExpr(slot, typ, loc):
			{
				state = state,
				pending = push_contract_exprs(
					pending,
					BorrowContractResult,
					[slot.result, slot.out_index, slot.source, slot.source_index],
				)
			}
		ListRetainExpr(retain, typ, loc):
			{
				state = state,
				pending = push_contract_exprs(
					pending,
					BorrowContractResult,
					[retain.list, retain.value.value],
				)
			}
		ListSetExpr(set, typ, loc):
			value_demand: ContractConsumptionDemand = if set.value.transfers_ownership:
				ConsumeContractResult
			else:
				BorrowContractResult

			{
				state = state,
				pending = push_contract_task(
					push_contract_task(
						push_contract_task(pending, BorrowContractResult, set.list),
						ConsumeContractResult,
						set.index,
					),
					value_demand,
					set.value.value,
				)
			}
		StringByteReadExpr(read, typ, loc):
			{
				state = state,
				pending = push_contract_task(
					push_contract_task(pending, BorrowContractResult, read.source),
					ConsumeContractResult,
					read.index,
				)
			}
		StringByteWriteExpr(write, typ, loc):
			{
				state = state,
				pending = push_contract_exprs(
					pending,
					BorrowContractResult,
					[write.target, write.index, write.byte],
				)
			}
		StringByteCopyExpr(copy, typ, loc):
			{
				state = state,
				pending = push_contract_exprs(
					pending,
					BorrowContractResult,
					[copy.dst, copy.dst_pos, copy.src, copy.src_pos, copy.len],
				)
			}
		StringSetLenExpr(set_len, typ, loc):
			{
				state = state,
				pending = push_contract_exprs(
					pending,
					BorrowContractResult,
					[set_len.target, set_len.len],
				)
			}
		TensorRawReadExpr(read, typ, loc):
			{
				state = state,
				pending = push_contract_task(pending, ConsumeContractResult, read.index)
			}
		TensorRawWriteExpr(write, typ, loc):
			{
				state = state,
				pending = push_contract_exprs(
					pending,
					ConsumeContractResult,
					[write.index, write.value],
				)
			}
		TensorRawViewLetExpr(binding, body, typ, loc):
			{
				state = state,
				pending = push_contract_task(
					push_contract_task(pending, BorrowContractResult, binding.source),
					ConsumeContractResult,
					body,
				)
			}
		TensorBoxedLiteralExpr(literal, typ, loc):
			{
				state = state,
				pending = push_contract_boxed_storage_values(pending, literal.elements)
			}
		DictConstructExpr(construct, typ, loc):
			var next: ContractCollectionTaskStack = pending

			for entry in construct.entries:
				next = push_contract_boxed_storage_values(
					next,
					[entry.key, entry.value],
				)

			{
				state = state,
				pending = next
			}
		UnionConstructExpr(construct, typ, loc):
			{
				state = state,
				pending = push_contract_boxed_storage_values(pending, construct.args)
			}
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			{
				state = record_contract_parameter_use(
					index,
					caller,
					ConsumeContractResult,
					variable,
					state,
				),
				pending = push_contract_task(pending, demand, body)
			}
		IfExpr(cond, then_expr, else_expr, typ, loc):
			{
				state = state,
				pending = push_contract_task(
					push_contract_task(
						push_contract_task(pending, ConsumeContractResult, cond),
						demand,
						then_expr,
					),
					demand,
					else_expr,
				)
			}
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			next_state: ContractCollectionState = if release_policy != NoReleasePolicy:
				match contract_release_owner_parameter(index, scrutinee):
					Some(parameter_index):
						record_direct_contract_parameter(parameter_index, state)
					None:
						state
			else:
				state

			{
				state = next_state,
				pending = push_contract_match_children(index, pending, demand, expr)
			}
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			{
				state = state,
				pending = push_contract_match_children(index, pending, demand, expr)
			}
		AccessorLiteralMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			next_state: ContractCollectionState = if release_policy != NoReleasePolicy:
				match contract_release_owner_parameter(index, scrutinee):
					Some(parameter_index):
						record_direct_contract_parameter(parameter_index, state)
					None:
						state
			else:
				state

			{
				state = next_state,
				pending = push_contract_match_children(index, pending, demand, expr)
			}
		LengthMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			next_state: ContractCollectionState = if release_policy != NoReleasePolicy:
				match contract_release_owner_parameter(index, scrutinee):
					Some(parameter_index):
						record_direct_contract_parameter(parameter_index, state)
					None:
						state
			else:
				state

			{
				state = next_state,
				pending = push_contract_match_children(index, pending, demand, expr)
			}
		ResourceScopeExpr(scope, typ, loc):
			with_body: ContractCollectionTaskStack = push_contract_task(
				push_contract_task(pending, ConsumeContractResult, scope.acquire),
				demand,
				scope.body,
			)

			with_cleanup: ContractCollectionTaskStack = match demand:
				ReturnContractResult(_):
					with_body
				_:
					push_contract_task(with_body, ConsumeContractResult, scope.cleanup)

			{
				state = state,
				pending = with_cleanup
			}
		PreClosureDetachExpr(_, _, _) | DetachExpr(_, _, _):
			{
				state = state,
				pending = pending
			}
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			{
				state = state,
				pending = push_contract_task(
					push_contract_task(
						push_contract_task(pending, ConsumeContractResult, start),
						ConsumeContractResult,
						end_value,
					),
					ConsumeContractResult,
					body,
				)
			}
		ForChannelExpr(loop, typ, loc):
			{
				state = state,
				pending = push_contract_task(
					push_contract_task(pending, BorrowContractResult, loop.iterable),
					ConsumeContractResult,
					loop.body,
				)
			}
		ForListExpr(loop, typ, loc):
			{
				state = state,
				pending = push_contract_task(
					push_contract_task(pending, BorrowContractResult, loop.iterable),
					ConsumeContractResult,
					loop.body,
				)
			}
		ForStringExpr(loop, typ, loc):
			{
				state = state,
				pending = push_contract_task(
					push_contract_task(pending, BorrowContractResult, loop.iterable),
					ConsumeContractResult,
					loop.body,
				)
			}
		ForDictExpr(loop, typ, loc):
			{
				state = state,
				pending = push_contract_task(
					push_contract_task(pending, BorrowContractResult, loop.iterable),
					ConsumeContractResult,
					loop.body,
				)
			}
		ForSetExpr(loop, typ, loc):
			{
				state = state,
				pending = push_contract_task(
					push_contract_task(pending, BorrowContractResult, loop.iterable),
					ConsumeContractResult,
					loop.body,
				)
			}
		ForStreamExpr(loop, typ, loc):
			{
				state = state,
				pending = push_contract_task(
					push_contract_task(pending, BorrowContractResult, loop.iterable),
					ConsumeContractResult,
					loop.body,
				)
			}
		ForResourceSourceExpr(loop, typ, loc):
			{
				state = state,
				pending = push_contract_task(
					push_contract_task(pending, BorrowContractResult, loop.iterable),
					ConsumeContractResult,
					loop.body,
				)
			}
		ForTensorExpr(loop, typ, loc):
			{
				state = state,
				pending = push_contract_task(
					push_contract_task(pending, BorrowContractResult, loop.iterable),
					ConsumeContractResult,
					loop.body,
				)
			}
		PreClosureConcurrentlyLoopExpr(loop, typ, loc) | ConcurrentlyLoopExpr(loop, typ, loc):
			with_timeout: ContractCollectionTaskStack = push_optional_contract_expr(
				pending,
				ConsumeContractResult,
				loop.timeout,
			)
			{
				state = state,
				pending = push_contract_task(
					push_contract_task(with_timeout, BorrowContractResult, loop.iterable),
					ConsumeContractResult,
					loop.limit,
				)
			}
		PreClosureConcurrentExpr(block, typ, loc):
			with_timeout: ContractCollectionTaskStack = push_optional_contract_expr(
				pending,
				ConsumeContractResult,
				block.timeout,
			)
			{
				state = state,
				pending = push_contract_task(with_timeout, ConsumeContractResult, block.body)
			}
		ConcurrentExpr(block, typ, loc):
			with_timeout: ContractCollectionTaskStack = push_optional_contract_expr(
				pending,
				ConsumeContractResult,
				block.timeout,
			)
			{
				state = state,
				pending = push_contract_task(with_timeout, ConsumeContractResult, block.body)
			}
		SelectExpr(select_expr, typ, loc):
			var next: ContractCollectionTaskStack = pending

			for arm in select_expr:
				match arm.kind:
					SelectRecvArm(recv):
						next = push_contract_task(next, BorrowContractResult, recv.channel)
					SelectSealedArm(channel):
						next = push_contract_task(next, BorrowContractResult, channel)
					SelectAfterArm(timeout):
						next = push_contract_task(next, ConsumeContractResult, timeout)

				next = push_contract_task(next, ConsumeContractResult, arm.body)

			{
				state = state,
				pending = next
			}
		_:
			{
				state = state,
				pending = push_contract_exprs(
					pending,
					ConsumeContractResult,
					CoreTraverse.immediate_core_expr_children(expr),
				)
			}


private pure func collect_function_contract_equation(
	env: PerceusEnv,
	callable_id: OwnershipCallableId,
	func_info: CoreFunction,
	body: CoreExpr,
) -> CollectedContractEquation:
	debug:
		perceus_work_contract_function_analyses()

	parameter_index: ContractParameterIndex = build_contract_parameter_index(env, func_info.params)
	var state: ContractCollectionState = {
		directly_consumed_parameters = {},
		user_call_flows = [],
		seen_user_call_flows = {},
		contains_parameter_dup = False,
		contains_parameter_shadow = False
	}
	var pending: ContractCollectionTaskStack = ContractCollectionMore(
		ReturnContractResult(func_info.return_type),
		body,
		ContractCollectionComplete,
	)
	var collection_complete: Bool = False

	while not collection_complete:
		match pending:
			ContractCollectionMore(demand, expr, remaining):
				pending = remaining

				debug:
					perceus_work_contract_collection_expression_visits()

				checks_enclosing_parameter_identity: Bool = match demand:
					InspectNestedContractRegion:
						False
					_:
						True

				if (
					checks_enclosing_parameter_identity
					and contract_expr_introduces_parameter_shadow(parameter_index, expr)
				):
					state = { state | contains_parameter_shadow = True }
				else:
					void

				step: ContractCollectionStep = match demand:
					InspectNestedContractRegion:
						{
							state = state,
							pending = push_contract_exprs(
								pending,
								InspectNestedContractRegion,
								CoreTraverse.immediate_core_expr_children(expr),
							)
						}
					BorrowContractResult:
						match expr:
							VarExpr(variable, typ, loc):
								{
									state = state,
									pending = pending
								}
							FieldExpr(owner, field, typ, loc):
								{
									state = state,
									pending = push_contract_task(
										pending,
										BorrowContractResult,
										owner,
									)
								}
							TupleFieldExpr(owner, field_index, typ, loc):
								{
									state = state,
									pending = push_contract_task(
										pending,
										BorrowContractResult,
										owner,
									)
								}
							CastExpr(inner, typ, loc):
								{
									state = state,
									pending = push_contract_task(
										pending,
										BorrowContractResult,
										inner,
									)
								}
							UnboxExpr(kind, inner, typ, loc):
								{
									state = state,
									pending = push_contract_task(
										pending,
										BorrowContractResult,
										inner,
									)
								}
							BoxExpr(box_op, typ, loc):
								{
									state = state,
									pending = push_contract_task(
										pending,
										BorrowContractResult,
										box_op.value,
									)
								}
							_:
								schedule_contract_linear(
									env,
									parameter_index,
									callable_id,
									ConsumeContractResult,
									expr,
									state,
									pending,
								)
					DeferredContractResult(callee, argument_index):
						match expr:
							VarExpr(variable, typ, loc):
								{
									state = record_contract_parameter_use(
										parameter_index,
										callable_id,
										demand,
										variable,
										state,
									),
									pending = pending
								}
							BoxExpr(box_op, typ, loc):
								match box_op.kind:
									PointerBox:
										{
											state = state,
											pending = push_contract_task(
												pending,
												demand,
												box_op.value,
											)
										}
									_:
										{
											state = state,
											pending = push_contract_task(
												pending,
												BorrowContractResult,
												box_op.value,
											)
										}
							_:
								-- A deferred outer call borrows a composite argument until
								-- its callee contract is known. Evaluate the argument using
								-- normal borrow semantics; only direct Vars and pointer boxes
								-- above become parameter-flow edges.
								schedule_contract_linear(
									env,
									parameter_index,
									callable_id,
									BorrowContractResult,
									expr,
									state,
									pending,
								)
					ReturnContractResult(return_type):
						match expr:
							IfExpr(cond, then_expr, else_expr, typ, loc):
								{
									state = state,
									pending = push_contract_task(
										push_contract_task(
											push_contract_task(
												pending,
												ConsumeContractResult,
												cond,
											),
											ReturnContractResult(return_type),
											then_expr,
										),
										ReturnContractResult(return_type),
										else_expr,
									)
								}
							ConstructorMatchExpr(_, _, _, _, _, _):
								schedule_contract_linear(
									env,
									parameter_index,
									callable_id,
									demand,
									expr,
									state,
									pending,
								)
							LiteralMatchExpr(_, _, _, _, _):
								schedule_contract_linear(
									env,
									parameter_index,
									callable_id,
									demand,
									expr,
									state,
									pending,
								)
							AccessorLiteralMatchExpr(_, _, _, _, _):
								schedule_contract_linear(
									env,
									parameter_index,
									callable_id,
									demand,
									expr,
									state,
									pending,
								)
							LengthMatchExpr(_, _, _, _, _):
								schedule_contract_linear(
									env,
									parameter_index,
									callable_id,
									demand,
									expr,
									state,
									pending,
								)
							LetExpr(variable, is_mutable, bind_type, rhs, body):
								rhs_demand: ContractConsumptionDemand = if (
									is_managed_type(env, bind_type)
									and contract_direct_alias_parameter(
										parameter_index,
										rhs,
									) != None
								):
									BorrowContractResult
								else:
									ConsumeContractResult

								{
									state = state,
									pending = push_contract_task(
										push_contract_task(pending, rhs_demand, rhs),
										ReturnContractResult(return_type),
										body,
									)
								}
							BorrowLetExpr(variable, bind_type, rhs, body):
								{
									state = state,
									pending = push_contract_task(
										push_contract_task(pending, BorrowContractResult, rhs),
										ReturnContractResult(return_type),
										body,
									)
								}
							SeqExpr(first, second):
								{
									state = state,
									pending = push_contract_task(
										push_contract_task(pending, ConsumeContractResult, first),
										ReturnContractResult(return_type),
										second,
									)
								}
							DropExpr(variable, value_type, release_policy, body, typ, loc):
								{
									state = record_contract_parameter_use(
										parameter_index,
										callable_id,
										ConsumeContractResult,
										variable,
										state,
									),
									pending = push_contract_task(
										pending,
										ReturnContractResult(return_type),
										body,
									)
								}
							ResourceScopeExpr(scope, typ, loc):
								{
									state = state,
									pending = push_contract_task(
										push_contract_task(
											pending,
											ConsumeContractResult,
											scope.acquire,
										),
										ReturnContractResult(return_type),
										scope.body,
									)
								}
							VarExpr(_, _, _) | FieldExpr(_, _, _, _) | CastExpr(_, _, _) | UnboxExpr(_, _, _, _):
								if is_managed_type(env, return_type):
									match expr:
										VarExpr(variable, typ, loc):
											{
												state = state,
												pending = pending
											}
										_:
											match schedule_contract_linear(
												env,
												parameter_index,
												callable_id,
												BorrowContractResult,
												expr,
												state,
												pending,
											):
												step:
													step
								else:
									schedule_contract_linear(
										env,
										parameter_index,
										callable_id,
										ConsumeContractResult,
										expr,
										state,
										pending,
									)
							_:
								schedule_contract_linear(
									env,
									parameter_index,
									callable_id,
									ConsumeContractResult,
									expr,
									state,
									pending,
								)
					ConsumeContractResult:
						schedule_contract_linear(
							env,
							parameter_index,
							callable_id,
							demand,
							expr,
							state,
							pending,
						)

				state = step.state
				pending = step.pending
			ContractCollectionComplete:
				collection_complete = True

	var directly_consumed: List[Int] = []
	var parameter_index_value: Int = 0

	while parameter_index_value < func_info.params.length():
		if state.directly_consumed_parameters.contains(parameter_index_value):
			directly_consumed = directly_consumed.append(parameter_index_value)
		else:
			void

		parameter_index_value += 1

	{
		equation = {
			function = callable_id,
			directly_consumed_parameters = directly_consumed
		},
		user_call_flows = state.user_call_flows,
		contains_parameter_dup = state.contains_parameter_dup,
		contains_parameter_shadow = state.contains_parameter_shadow
	}


private pure func summarize_function_return_literal_match_uses(
	env: PerceusEnv,
	name: String,
	return_type: CoreType,
	match_expr: CoreConstructorLiteralMatch,
) -> OwnershipUseSummary:
	var branch_uses: List[OwnershipUseSummary] = []

	for match_case in match_expr.cases:
		if match_bindings_shadow(name, match_case.bindings):
			branch_uses = branch_uses.append(NO_OWNERSHIP_USES)
		else:
			branch_uses = branch_uses.append(
				summarize_function_return_ownership_uses(
					env,
					name,
					return_type,
					match_case.body,
				),
			)

	match match_expr.fallback:
		LiteralMatchFallbackBody(body):
			branch_uses = branch_uses.append(
				summarize_function_return_ownership_uses(
					env,
					name,
					return_type,
					body,
				),
			)
		LiteralMatchFallbackBindings(bindings, body):
			if match_bindings_shadow(name, bindings):
				branch_uses = branch_uses.append(NO_OWNERSHIP_USES)
			else:
				branch_uses = branch_uses.append(
					summarize_function_return_ownership_uses(
						env,
						name,
						return_type,
						body,
					),
				)
		LiteralMatchFallbackFail:
			branch_uses = branch_uses.append(NO_OWNERSHIP_USES)

	branch_ownership_uses(branch_uses)


private pure func summarize_function_return_match_body_uses(
	env: PerceusEnv,
	name: String,
	return_type: CoreType,
	body: CoreConstructorMatchBody,
) -> OwnershipUseSummary:
	match body:
		ConstructorMatchBodyExpr(expr):
			summarize_function_return_ownership_uses(env, name, return_type, expr)
		ConstructorMatchBodyLiteral(match_expr):
			summarize_function_return_literal_match_uses(env, name, return_type, match_expr)
		ConstructorMatchBodyLength(match_expr):
			summarize_function_return_length_match_uses(env, name, return_type, match_expr)


private pure func summarize_function_return_length_branch_uses(
	env: PerceusEnv,
	name: String,
	return_type: CoreType,
	branch: CoreConstructorLengthMatchBranch,
) -> OwnershipUseSummary:
	if match_bindings_shadow(name, branch.bindings):
		NO_OWNERSHIP_USES
	else:
		summarize_function_return_match_body_uses(env, name, return_type, branch.body)


private pure func summarize_function_return_length_match_uses(
	env: PerceusEnv,
	name: String,
	return_type: CoreType,
	match_expr: CoreConstructorLengthMatch,
) -> OwnershipUseSummary:
	var branch_uses: List[OwnershipUseSummary] = []

	for match_case in match_expr.cases:
		branch_uses = branch_uses.append(
			summarize_function_return_length_branch_uses(
				env,
				name,
				return_type,
				match_case.branch,
			),
		)

	match match_expr.geq:
		Some(match_case):
			branch_uses = branch_uses.append(
				summarize_function_return_length_branch_uses(
					env,
					name,
					return_type,
					match_case.branch,
				),
			)
		None:
			void

	match match_expr.fallback:
		Some(branch):
			branch_uses = branch_uses.append(
				summarize_function_return_length_branch_uses(
					env,
					name,
					return_type,
					branch,
				),
			)
		None:
			branch_uses = branch_uses.append(NO_OWNERSHIP_USES)

	branch_ownership_uses(branch_uses)


private pure func summarize_function_return_match_case_uses(
	env: PerceusEnv,
	name: String,
	return_type: CoreType,
	match_case: CoreConstructorMatchCase,
) -> OwnershipUseSummary:
	if match_bindings_shadow(name, match_case.bindings):
		NO_OWNERSHIP_USES
	else:
		summarize_function_return_match_body_uses(env, name, return_type, match_case.body)


private pure func summarize_function_return_match_branch_uses(
	env: PerceusEnv,
	name: String,
	return_type: CoreType,
	cases: List[CoreConstructorMatchCase],
	fallback: CoreConstructorMatchFallback,
) -> OwnershipUseSummary:
	var branch_uses: List[OwnershipUseSummary] = []

	for match_case in cases:
		branch_uses = branch_uses.append(
			summarize_function_return_match_case_uses(
				env,
				name,
				return_type,
				match_case,
			),
		)

	match fallback:
		ConstructorMatchFallbackBody(body):
			branch_uses = branch_uses.append(
				summarize_function_return_ownership_uses(
					env,
					name,
					return_type,
					body,
				),
			)
		ConstructorMatchFallbackBindings(bindings, body):
			if match_bindings_shadow(name, bindings):
				branch_uses = branch_uses.append(NO_OWNERSHIP_USES)
			else:
				branch_uses = branch_uses.append(
					summarize_function_return_ownership_uses(
						env,
						name,
						return_type,
						body,
					),
				)
		ConstructorMatchFallbackFail:
			branch_uses = branch_uses.append(NO_OWNERSHIP_USES)

	branch_ownership_uses(branch_uses)


private pure func summarize_function_return_ownership_uses(
	env: PerceusEnv,
	name: String,
	return_type: CoreType,
	expr: CoreExpr,
) -> OwnershipUseSummary:
	match expr:
		IfExpr(cond, then_expr, else_expr, typ, loc):
			seq_ownership_uses(
				summarize_linear_ownership_uses(env, name, cond),
				branch_ownership_uses_pair(
					summarize_function_return_ownership_uses(env, name, return_type, then_expr),
					summarize_function_return_ownership_uses(env, name, return_type, else_expr),
				),
			)
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			summarize_match_ownership_uses(
				env,
				name,
				scrutinee,
				release_policy,
				summarize_function_return_match_branch_uses(
					env,
					name,
					return_type,
					cases,
					fallback,
				),
			)
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			summarize_match_ownership_uses(
				env,
				name,
				scrutinee,
				NoReleasePolicy,
				summarize_function_return_literal_match_uses(
					env,
					name,
					return_type,
					{
						accessor = RootAccessor,
						scrutinee_type = core_expr_type(scrutinee),
						cases = cases,
						fallback = fallback,
						result_type = typ,
						loc = loc
					},
				),
			)
		AccessorLiteralMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			summarize_match_ownership_uses(
				env,
				name,
				scrutinee,
				release_policy,
				summarize_function_return_literal_match_uses(env, name, return_type, match_expr),
			)
		LengthMatchExpr(scrutinee, release_policy, match_expr, typ, loc):
			summarize_match_ownership_uses(
				env,
				name,
				scrutinee,
				release_policy,
				summarize_function_return_length_match_uses(env, name, return_type, match_expr),
			)
		LetExpr(variable, is_mutable, bind_type, rhs, body):
			rhs_uses: OwnershipUseSummary = if (
				is_managed_type(env, bind_type)
				and direct_aliases_name(name, rhs)
			):
				summarize_linear_borrow(env, name, rhs)
			else:
				summarize_linear_ownership_uses(env, name, rhs)

			body_uses: OwnershipUseSummary = if variable.name == name:
				NO_OWNERSHIP_USES
			else:
				summarize_function_return_ownership_uses(env, name, return_type, body)

			seq_ownership_uses(rhs_uses, body_uses)
		BorrowLetExpr(variable, bind_type, rhs, body):
			rhs_uses: OwnershipUseSummary = summarize_linear_borrow(env, name, rhs)

			body_uses: OwnershipUseSummary = if variable.name == name:
				NO_OWNERSHIP_USES
			else:
				summarize_function_return_ownership_uses(env, name, return_type, body)

			seq_ownership_uses(rhs_uses, body_uses)
		SeqExpr(first, second):
			seq_ownership_uses(
				summarize_linear_ownership_uses(env, name, first),
				summarize_function_return_ownership_uses(env, name, return_type, second),
			)
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			summarize_function_return_ownership_uses(env, name, return_type, body)
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			if variable.name == name:
				seq_ownership_uses(
					CONSUME_OWNERSHIP_USE,
					summarize_function_return_ownership_uses(env, name, return_type, body),
				)
			else:
				summarize_function_return_ownership_uses(env, name, return_type, body)
		ResourceScopeExpr(scope, typ, loc):
			seq_ownership_uses(
				summarize_linear_ownership_uses(env, name, scope.acquire),
				summarize_function_return_ownership_uses(env, name, return_type, scope.body),
			)
		_:
			aliases_managed_result: Bool = match expr:
				VarExpr(variable, typ, loc):
					variable.name == name
				FieldExpr(owner, field, typ, loc):
					borrow_expr_aliases_target(env, name, expr)
				CallExpr(kind, callee, args, typ, loc):
					borrow_expr_aliases_target(env, name, expr)
				CastExpr(inner, typ, loc):
					borrow_expr_aliases_target(env, name, expr)
				UnboxExpr(kind, inner, typ, loc):
					borrow_expr_aliases_target(env, name, expr)
				_:
					False

			if is_managed_type(env, return_type) and aliases_managed_result:
				summarize_linear_borrow(env, name, expr)
			else:
				summarize_linear_ownership_uses(env, name, expr)


private pure func initial_consumed_param_indices(
	env: PerceusEnv,
	func_info: CoreFunction,
) -> List[Int]:
	match func_info.function_kind:
		ClosureBodyFunction(abi):
			[]
		_:
			var consumed: List[Int] = []
			var index: Int = 0

			for param in func_info.params:
				if is_managed_type(env, param.typ):
					consumed = consumed.append(index)
				else:
					void

				index += 1

			consumed


private pure func infer_consumed_parameters_scalar(
	env: PerceusEnv,
	func_info: CoreFunction,
) -> List[Int]:
	debug:
		perceus_work_contract_function_analyses()

	match func_info.function_kind:
		ClosureBodyFunction(abi):
			[]
		_:
			match func_info.body:
				Some(body):
					var consumed: List[Int] = []
					var index: Int = 0

					for param in func_info.params:
						if is_managed_type(env, param.typ):
							debug:
								perceus_work_contract_managed_parameter_summaries()

							uses: OwnershipUseSummary = summarize_function_return_ownership_uses(
								env,
								param.name.name,
								func_info.return_type,
								body,
							)

							if uses.consumed_refs > 0:
								consumed = consumed.append(index)
							else:
								void
						else:
							void

						index += 1

					consumed
				None:
					initial_consumed_param_indices(env, func_info)


private pure func build_ownership_contract_graph(
	program: CoreProgram,
	env: PerceusEnv,
) -> OwnershipContractGraph:
	var equations: List[FunctionContractEquation] = []
	var reverse_flows: List[Dict[Int, List[ReverseParameterFlow]]] = []
	var scalar_balance_fallbacks: List[ScalarBalanceFallback] = []

	for entry in env.callables.entries_by_id:
		equations = equations.append({
			function = entry.id,
			directly_consumed_parameters = [],
		})
		reverse_flows = reverse_flows.append({})

	inference_env: PerceusEnv = { env | infer_unresolved_user_calls_as_borrow = True }

	var declaration_index: Int = 0

	while declaration_index < program.decls.length():
		match program.decls.get(declaration_index):
			Some(FunctionDecl(func_info)):
				match lookup_ownership_callable_id(
					env.callables,
					func_info.name,
					Some(func_info.def_id),
				):
					Some(callable_id):
						match func_info.function_kind:
							ClosureBodyFunction(_):
								void
							_:
								match func_info.body:
									Some(body):
										if func_info.params.any(
											func(param): is_managed_type(env, param.typ),
										):
											collected: CollectedContractEquation = collect_function_contract_equation(
												inference_env,
												callable_id,
												func_info,
												body,
											)
											-- Incoming Dup nodes can cancel a later transfer, while
											-- unresolved local identities cannot distinguish a parameter
											-- from a same-named nested binder. Keep those explicit,
											-- counted cases on the exact scalar analysis.
											uses_scalar_fallback: Bool = (
												collected.contains_parameter_dup
												or collected.contains_parameter_shadow
											)

											equation: FunctionContractEquation = if uses_scalar_fallback:
												scalar_balance_fallbacks = scalar_balance_fallbacks.append({
													callable = callable_id,
													declaration_index = declaration_index,
													has_incoming_dup = collected.contains_parameter_dup,
													has_parameter_shadow = collected.contains_parameter_shadow,
												})
												{
													function = callable_id,
													directly_consumed_parameters = []
												}
											else:
												collected.equation

											equations = equations.set(callable_id, equation)

											if not uses_scalar_fallback:
												for flow in collected.user_call_flows:
													callee_flows: Dict[Int, List[ReverseParameterFlow]] = reverse_flows.get_or(
														flow.callee,
														{},
													)

													if not callee_flows.contains(
														flow.callee_argument_index,
													):
														debug:
															perceus_work_contract_reverse_parameter_slots()
													else:
														void

													reverse_flows = reverse_flows.set(
														flow.callee,
														callee_flows.set(
															flow.callee_argument_index,
															callee_flows
																.get_or(
																	flow.callee_argument_index,
																	[],
																)
																.append({
																	caller = flow.caller,
																	caller_parameter_index = flow.caller_parameter_index,
																}),
														),
													)
											else:
												void
										else:
											void
									None:
										void
					None:
						void
			Some(decl):
				void
			None:
				void

		declaration_index += 1

	{
		equations_by_callable_id = equations,
		reverse_flows_by_callee_and_argument = reverse_flows,
		scalar_balance_fallbacks = scalar_balance_fallbacks
	}


private pure func solve_user_call_contracts(
	program: CoreProgram,
	env: PerceusEnv,
	graph: OwnershipContractGraph,
) -> List[List[Int]]:
	var consumed_parameters_by_callable: List[Dict[Int, Bool]] = []
	var contracts_by_callable: List[List[Int]] = []
	var pending_work: List[PendingContractWork] = []

	for equation in graph.equations_by_callable_id:
		var consumed_parameters: Dict[Int, Bool] = {}
		var contract: List[Int] = []

		for parameter_index in equation.directly_consumed_parameters:
			if not consumed_parameters.contains(parameter_index):
				debug:
					perceus_work_contract_solver_parameter_marks()

				consumed_parameters = consumed_parameters.set(parameter_index, True)
				contract = contract.append(parameter_index)
			else:
				void

		consumed_parameters_by_callable = consumed_parameters_by_callable.append(
			consumed_parameters,
		)
		contracts_by_callable = contracts_by_callable.append(contract)

		if contract.length() > 0:
			pending_work = pending_work.append({
				callable = equation.function,
				parameter_frontier = contract,
			})
		else:
			void

	-- Contract argument order is observable in Core dumps even though lookup is
	-- set-like. Preserve the former inference waves: direct parameters are in
	-- signature order, then each wave appends newly inferred parameters in
	-- signature order. Only compact reverse edges are inspected here.
	-- Scalar compatibility functions participate in the same fixed-point waves
	-- as graph equations. Seed them against the empty inferred-contract table,
	-- exactly like the former initial whole-program analysis.
	initial_fallback_env: PerceusEnv = { env | infer_unresolved_user_calls_as_borrow = True }

	for fallback in graph.scalar_balance_fallbacks:
		match program.decls.get(fallback.declaration_index):
			Some(FunctionDecl(func_info)):
				debug:
					perceus_work_contract_scalar_fallback_analyses()

					if fallback.has_incoming_dup:
						perceus_work_contract_dup_fallback_analyses()
						void
					else:
						void

					if fallback.has_parameter_shadow:
						perceus_work_contract_shadow_fallback_analyses()
						void
					else:
						void

				initial: List[Int] = infer_consumed_parameters_scalar(
					initial_fallback_env,
					func_info,
				)
				var initial_set: Dict[Int, Bool] = {}

				for parameter_index in initial:
					initial_set = initial_set.set(parameter_index, True)

				consumed_parameters_by_callable = consumed_parameters_by_callable.set(
					fallback.callable,
					initial_set,
				)
				contracts_by_callable = contracts_by_callable.set(fallback.callable, initial)

				if initial.length() > 0:
					pending_work = pending_work.append({
						callable = fallback.callable,
						parameter_frontier = initial,
					})
				else:
					void
			_:
				void

	while pending_work.length() > 0:
		debug:
			perceus_work_contract_solver_wave_iterations()

		wave_contracts: List[List[Int]] = if graph.scalar_balance_fallbacks.length() > 0:
			contracts_by_callable
		else:
			[]

		var discovered_parameters_by_caller: Dict[Int, Dict[Int, Bool]] = {}
		var next_candidate_callables: List[OwnershipCallableId] = []
		var seen_next_candidates: Dict[Int, Bool] = {}
		var next_pending_work: List[PendingContractWork] = []
		var scheduled_next_work: Dict[Int, Bool] = {}

		for work in pending_work:
			debug:
				perceus_work_contract_solver_frontier_callable_visits()

			match graph.reverse_flows_by_callee_and_argument.get(work.callable):
				Some(argument_flows):
					for callee_parameter_index in work.parameter_frontier:
						match argument_flows.get(callee_parameter_index):
							Some(flows):
								for flow in flows:
									debug:
										perceus_work_contract_solver_flow_visits()

									match consumed_parameters_by_callable.get(flow.caller):
										Some(caller_consumed_parameters):
											if not caller_consumed_parameters.contains(
												flow.caller_parameter_index,
											):
												discovered: Dict[Int, Bool] = discovered_parameters_by_caller.get_or(
													flow.caller,
													{},
												)
												discovered_parameters_by_caller = discovered_parameters_by_caller.set(
													flow.caller,
													discovered.set(
														flow.caller_parameter_index,
														True,
													),
												)

												if not seen_next_candidates.contains(flow.caller):
													next_candidate_callables = next_candidate_callables.append(
														flow.caller,
													)
													seen_next_candidates = seen_next_candidates.set(
														flow.caller,
														True,
													)
												else:
													void
											else:
												void
										None:
											void
							None:
								void
				None:
					void

		for caller in next_candidate_callables:
			match (
				discovered_parameters_by_caller.get(caller),
				consumed_parameters_by_callable.get(caller),
				contracts_by_callable.get(caller),
				env.callables.entries_by_id.get(caller),
			):
				(Some(discovered), Some(consumed_parameters), Some(contract), Some(entry)):
					var next_consumed_parameters: Dict[Int, Bool] = consumed_parameters
					var next_contract: List[Int] = contract
					var newly_consumed_parameters: List[Int] = []
					var parameter_index: Int = 0

					while parameter_index < entry.parameter_count:
						if (
							discovered.contains(parameter_index)
							and not next_consumed_parameters.contains(parameter_index)
						):
							debug:
								perceus_work_contract_solver_parameter_marks()

							next_consumed_parameters = next_consumed_parameters.set(
								parameter_index,
								True,
							)
							next_contract = next_contract.append(parameter_index)
							newly_consumed_parameters = newly_consumed_parameters.append(
								parameter_index,
							)
						else:
							void

						parameter_index += 1

					consumed_parameters_by_callable = consumed_parameters_by_callable.set(
						caller,
						next_consumed_parameters,
					)
					contracts_by_callable = contracts_by_callable.set(caller, next_contract)

					if newly_consumed_parameters.length() > 0:
						next_pending_work = next_pending_work.append({
							callable = caller,
							parameter_frontier = newly_consumed_parameters,
						})
						scheduled_next_work = scheduled_next_work.set(caller, True)
					else:
						void
				_:
					void

		-- Re-evaluate exceptional lexical/ownership shapes against the contracts
		-- visible at the start of this wave. This preserves historical ordering
		-- while keeping the normal graph path free of Core-expression rescans.
		fallback_env: PerceusEnv = { env |
			user_call_contracts = user_call_contract_table(env.callables, wave_contracts),
			infer_unresolved_user_calls_as_borrow = True
		}

		for fallback in graph.scalar_balance_fallbacks:
			match program.decls.get(fallback.declaration_index):
				Some(FunctionDecl(func_info)):
					debug:
						perceus_work_contract_scalar_fallback_analyses()

						if fallback.has_incoming_dup:
							perceus_work_contract_dup_fallback_analyses()
							void
						else:
							void

						if fallback.has_parameter_shadow:
							perceus_work_contract_shadow_fallback_analyses()
							void
						else:
							void

					inferred: List[Int] = infer_consumed_parameters_scalar(fallback_env, func_info)
					current: List[Int] = wave_contracts.get_or(fallback.callable, [])
					merged: List[Int] = merge_consumed_args(current, inferred)

					if merged.length() > current.length():
						var newly_consumed_parameters: List[Int] = []

						for parameter_index in inferred:
							if not current.contains(parameter_index):
								newly_consumed_parameters = newly_consumed_parameters.append(
									parameter_index,
								)
							else:
								void

						contracts_by_callable = contracts_by_callable.set(fallback.callable, merged)
						var merged_set: Dict[Int, Bool] = consumed_parameters_by_callable.get_or(
							fallback.callable,
							{},
						)

						for parameter_index in merged:
							merged_set = merged_set.set(parameter_index, True)

						consumed_parameters_by_callable = consumed_parameters_by_callable.set(
							fallback.callable,
							merged_set,
						)

						if not scheduled_next_work.contains(fallback.callable):
							next_pending_work = next_pending_work.append({
								callable = fallback.callable,
								parameter_frontier = newly_consumed_parameters,
							})
							scheduled_next_work = scheduled_next_work.set(fallback.callable, True)
						else:
							void
					else:
						void
				_:
					void

		pending_work = next_pending_work

	contracts_by_callable


pure func infer_user_call_contracts(program: CoreProgram, env: PerceusEnv) -> PerceusEnv:
	graph: OwnershipContractGraph = build_ownership_contract_graph(program, env)
	{ env |
		user_call_contracts = user_call_contract_table(
			env.callables,
			solve_user_call_contracts(program, env, graph),
		),
		infer_unresolved_user_calls_as_borrow = False
	}


private pure func inferred_user_call_consumed_args(
	env: PerceusEnv,
	name: String,
	def_id: Option[Int],
	arg_count: Int,
	return_type: CoreType,
	fallback: List[Int],
) -> List[Int]:
	match lookup_return_type_constructor_call_contract(env, name, def_id, arg_count, return_type):
		Some(contract):
			fallback
		None:
			match lookup_ownership_callable_id(env.callables, name, def_id):
				Some(callable_id):
					match callable_consumed_args(env, callable_id):
						Some(inferred):
							merge_consumed_args(fallback, inferred)
						None:
							fallback
				None:
					fallback


pure func annotate_user_call_contracts(env: PerceusEnv, expr: CoreExpr) -> CoreExpr:
	rewritten: CoreExpr = match expr:
		LogicalExpr(_, _, _, _, _):
			CoreTraverse.map_core_logical_tree_with_context(expr, env, annotate_user_call_contracts)
		_:
			CoreTraverse.map_core_expr_children_with_context(
				expr,
				env,
				annotate_user_call_contracts,
			)

	match rewritten:
		CallExpr(UserCall(name, def_id, consumed_args), callee, args, typ, loc):
			CallExpr(
				UserCall(
					name,
					def_id,
					inferred_user_call_consumed_args(
						env,
						name,
						def_id,
						args.length(),
						typ,
						consumed_args,
					),
				),
				callee,
				args,
				typ,
				loc,
			)
		_:
			rewritten
