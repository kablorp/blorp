				target_type,
				[swap.list, swap.left_index, swap.right_index],
				temp_index,
				skip_old_release,
			)

			match children.exprs:
				[list, left_index, right_index]:
					{
						expr = ListSwapExpr(
							{ swap |
								list = list,
								left_index = left_index,
								right_index = right_index
							},
							typ,
							loc,
						),
						next_temp = children.next_temp
					}
				_:
					{
						expr = expr,
						next_temp = children.next_temp
					}
		StringByteReadExpr(read, typ, loc):
			children: MutableExprListRewrite = rewrite_mutable_expr_list(
				env,
				target,
				target_type,
				[read.source, read.index],
				temp_index,
				skip_old_release,
			)

			match children.exprs:
				[source, index]:
					{
						expr = StringByteReadExpr(
							{ read |
								source = source,
								index = index
							},
							typ,
							loc,
						),
						next_temp = children.next_temp
					}
				_:
					{
						expr = expr,
						next_temp = children.next_temp
					}
		StringByteWriteExpr(write, typ, loc):
			children: MutableExprListRewrite = rewrite_mutable_expr_list(
				env,
				target,
				target_type,
				[write.target, write.index, write.byte],
				temp_index,
				skip_old_release,
			)

			match children.exprs:
				[write_target, index, byte]:
					{
						expr = StringByteWriteExpr(
							{ write |
								target = write_target,
								index = index,
								byte = byte
							},
							typ,
							loc,
						),
						next_temp = children.next_temp
					}
				_:
					{
						expr = expr,
						next_temp = children.next_temp
					}
		StringByteCopyExpr(copy, typ, loc):
			children: MutableExprListRewrite = rewrite_mutable_expr_list(
				env,
				target,
				target_type,
				[copy.dst, copy.dst_pos, copy.src, copy.src_pos, copy.len],
				temp_index,
				skip_old_release,
			)

			match children.exprs:
				[dst, dst_pos, src, src_pos, len]:
					{
						expr = StringByteCopyExpr(
							{ copy |
								dst = dst,
								dst_pos = dst_pos,
								src = src,
								src_pos = src_pos,
								len = len
							},
							typ,
							loc,
						),
						next_temp = children.next_temp
					}
				_:
					{
						expr = expr,
						next_temp = children.next_temp
					}
		StringSetLenExpr(set_len, typ, loc):
			children: MutableExprListRewrite = rewrite_mutable_expr_list(
				env,
				target,
				target_type,
				[set_len.target, set_len.len],
				temp_index,
				skip_old_release,
			)

			match children.exprs:
				[set_target, len]:
					{
						expr = StringSetLenExpr(
							{ set_len |
								target = set_target,
								len = len
							},
							typ,
							loc,
						),
						next_temp = children.next_temp
					}
				_:
					{
						expr = expr,
						next_temp = children.next_temp
					}
		TensorBoxedLiteralExpr(literal, typ, loc):
			values_result: MutableBoxedValuesRewrite = rewrite_mutable_boxed_values(
				env,
				target,
				target_type,
				literal.elements,
				temp_index,
				skip_old_release,
			)
			{
				expr = TensorBoxedLiteralExpr(
					{ literal | elements = values_result.values },
					typ,
					loc,
				),
				next_temp = values_result.next_temp
			}
		TensorRawFillExpr(fill, typ, loc):
			children: MutableExprListRewrite = rewrite_mutable_expr_list(
				env,
				target,
				target_type,
				[fill.value].concat(fill.dims),
				temp_index,
				skip_old_release,
			)

			match children.exprs:
				[value, ...dims]:
					{
						expr = TensorRawFillExpr(
							{ fill |
								value = value,
								dims = dims
							},
							typ,
							loc,
						),
						next_temp = children.next_temp
					}
				_:
					{
						expr = expr,
						next_temp = children.next_temp
					}
		TensorRawReadExpr(read, typ, loc):
			index_result: MutableAssignmentRewrite = rewrite_mutable_assignments(
				env,
				target,
				target_type,
				read.index,
				temp_index,
				skip_old_release,
			)
			{
				expr = TensorRawReadExpr({ read | index = index_result.expr }, typ, loc),
				next_temp = index_result.next_temp
			}
		TensorRawWriteExpr(write, typ, loc):
			children: MutableExprListRewrite = rewrite_mutable_expr_list(
				env,
				target,
				target_type,
				[write.index, write.value],
				temp_index,
				skip_old_release,
			)

			match children.exprs:
				[index, value]:
					{
						expr = TensorRawWriteExpr(
							{ write |
								index = index,
								value = value
							},
							typ,
							loc,
						),
						next_temp = children.next_temp
					}
				_:
					{
						expr = expr,
						next_temp = children.next_temp
					}
		TensorRawViewLetExpr(binding, body, typ, loc):
			source_result: MutableAssignmentRewrite = rewrite_mutable_assignments(
				env,
				target,
				target_type,
				binding.source,
				temp_index,
				skip_old_release,
			)

			body_result: MutableAssignmentRewrite = if binding.variable.name == target.name:
				{
					expr = body,
					next_temp = source_result.next_temp
				}
			else:
				rewrite_mutable_assignments(
					env,
					target,
					target_type,
					body,
					source_result.next_temp,
					skip_old_release_after_expr(env, target, skip_old_release, binding.source),
				)

			{
				expr = TensorRawViewLetExpr(
					{ binding | source = source_result.expr },
					body_result.expr,
					typ,
					loc,
				),
				next_temp = body_result.next_temp
			}
		UnionConstructExpr(construct, typ, loc):
			values_result: MutableBoxedValuesRewrite = rewrite_mutable_boxed_values(
				env,
				target,
				target_type,
				construct.args,
				temp_index,
				skip_old_release,
			)
			{
				expr = UnionConstructExpr({ construct | args = values_result.values }, typ, loc),
				next_temp = values_result.next_temp
			}
		DictConstructExpr(construct, typ, loc):
			entries_result: MutableDictEntriesRewrite = rewrite_mutable_dict_entries(
				env,
				target,
				target_type,
				construct.entries,
				temp_index,
				skip_old_release,
			)
			{
				expr = DictConstructExpr(
					{ construct | entries = entries_result.entries },
					typ,
					loc,
				),
				next_temp = entries_result.next_temp
			}
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			body_result: MutableAssignmentRewrite = rewrite_mutable_assignments(
				env,
				target,
				target_type,
				body,
				temp_index,
				skip_old_release,
			)
			{
				expr = DupExpr(variable, value_type, retain_policy, body_result.expr, typ, loc),
				next_temp = body_result.next_temp
			}
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			body_result: MutableAssignmentRewrite = rewrite_mutable_assignments(
				env,
				target,
				target_type,
				body,
				temp_index,
				skip_old_release,
			)
			{
				expr = DropExpr(variable, value_type, release_policy, body_result.expr, typ, loc),
				next_temp = body_result.next_temp
			}
		_:
			{
				expr = expr,
				next_temp = temp_index
			}


private pure func directly_returns_var(name: String, expr: CoreExpr) -> Bool:
	match expr:
		VarExpr(variable, typ, loc):
			variable.name == name
		LetExpr(variable, is_mutable, typ, rhs, body):
			if variable.name == name:
				False
			else if directly_returns_var(name, body):
				True
			else:
				match body:
					DropExpr(dropped, value_type, release_policy, drop_body, drop_type, loc):
						(
							dropped.name != name
							and directly_returns_var(variable.name, drop_body)
							and directly_returns_var(name, rhs)
						)
					_:
						False
		BorrowLetExpr(variable, typ, rhs, body):
			variable.name != name and directly_returns_var(name, body)
		SeqExpr(first, second):
			directly_returns_var(name, second)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			directly_returns_var(name, then_expr) and directly_returns_var(name, else_expr)
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			directly_returns_var(name, body)
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			directly_returns_var(name, body)
		_:
			False


pure func rewrite_mutable_let_body(
	env: PerceusEnv,
	target: CoreVar,
	target_type: CoreType,
	body: CoreExpr,
) -> CoreExpr:
	-- A mutable slot owns its current value until assignment replaces it or the
	-- scope exits. Preserve that owner across outward transfers; this gives the
	-- assignment rewriter one stable invariant instead of path-dependent moves.
	target_param: CoreParam = {
		name = target,
		typ = target_type,
		loc = SyntheticSourceLoc
	}
	transfer_safe_body: CoreExpr = protect_repeated_consumes(env, target, target_type, body, True)

	if directly_returns_var(target.name, transfer_safe_body):
		-- Moving the slot itself out of scope transfers its final owner. Retaining
		-- and then dropping that same owner creates an unnecessary and fragile
		-- handoff for later reuse/codegen passes.
		rewrite_mutable_assignments(env, target, target_type, transfer_safe_body, 0, False).expr
	else:
		result_safe_body: CoreExpr = retain_borrowed_param_result(
			env,
			target_param,
			transfer_safe_body,
		)
		rewritten_body: CoreExpr = rewrite_mutable_assignments(
			env,
			target,
			target_type,
			result_safe_body,
			0,
			False,
		).expr

		drop_after_body(1, target, target_type, rewritten_body)
