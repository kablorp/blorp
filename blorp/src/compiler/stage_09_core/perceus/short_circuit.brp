-- Consumed-parameter balancing and logical-operand short-circuit protection:
-- balance_consumed_param_bodies decides whether a function's consumed
-- parameters can share the function's implicit final drop instead of a
-- per-parameter drop (simple_consumed_parameter_catalog/prove_simple_
-- consumed_parameter_balance walk the whole body once to prove it safe);
-- move_only_owner_alias then turns the retain/release pair of a consumed
-- parameter's (or an immutable managed let's) only alias into a move;
-- balance_short_circuit_operands protects a short-circuited `and`/`or`
-- operand's reads so a value the left operand consumed cannot be read again
-- if the right operand is skipped.
--
-- rewrite_function calls both balance_consumed_param_bodies and
-- balance_short_circuit_operands directly as part of its own per-function
-- pipeline (see perceus.brp).
import:
	../ir:
		CoreExpr(
			AccessorLiteralMatchExpr, AssignExpr, BinaryExpr, BorrowLetExpr, BoxExpr, BreakExpr,
			CallExpr, CastExpr, ClosureCreateExpr, ConcurrentExpr, ConcurrentlyLoopExpr,
			ConstructorMatchExpr, DebugBlockExpr, DetachExpr, DictConstructExpr, DropExpr, DupExpr,
			FieldExpr, ForChannelExpr, ForDictExpr, ForListExpr, ForRangeExpr,
			ForResourceSourceExpr, ForSetExpr, ForStreamExpr, ForStringExpr, ForTensorExpr, IfExpr,
			LambdaExpr, LetExpr, ListConstructExpr, ListAllocExpr, ListGetExpr, ListHandoffExpr,
			ListHandoffSetOwnedExpr, ListHandoffSetSourceSlotExpr, ListRetainExpr, ListSetExpr,
			ListSwapExpr, LiteralExpr, LogicalExpr, PreClosureConcurrentExpr,
			PreClosureConcurrentlyLoopExpr, PreClosureDetachExpr, RecordConstructExpr, RecordExpr,
			RecordCowUpdateExpr, RecordReuseExpr, RecordUpdateExpr, ResourceCleanupExitExpr,
			ResourceScopeExpr, SelectExpr, SeqExpr, StaticStringLiteralExpr, StringByteCopyExpr,
			StringByteReadExpr, StringByteWriteExpr, StringSetLenExpr, TailrecListSpreadLoopExpr,
			TailrecListSpreadRecurExpr, TailrecLoopExpr, TailrecRecurExpr, TensorBoxedLiteralExpr,
			TensorRawFillExpr, TensorRawReadExpr, TensorRawViewLetExpr, TensorRawWriteExpr,
			TupleConstructExpr, TupleExpr, TupleFieldExpr, UnaryExpr, UnboxExpr, UnionConstructExpr,
			VarExpr, VectorExpr, VoidExpr, WhileExpr, LiteralMatchExpr, LengthMatchExpr,
		),
		CoreFunction,
		CoreLogicalOp,
		CoreParam,
		CoreReleasePolicy(ArcReleaseOnlyPolicy, ArcReleasePolicy),
		CoreRetainPolicy(ArcRetainPolicy),
		CoreSourceLoc,
		CoreType,
		CoreVar,
		core_expr_type,
		core_var_equal,
		synthetic_core_source_loc,
	../ownership: arg_consumes_caller
	../ownership_contracts: int_list_contains
	../traverse as CoreTraverse
	balance: balance_branch_body, prepend_dups
	env:
		PerceusBalanceStrategy(BranchAwareOwnershipBalance),
		PerceusEnv,
		contract_for_call,
		is_managed_type,
	protect: protect_repeated_consumes
	uses: OwnershipUseSummary, max_int, summarize_linear_ownership_uses


private record SimpleConsumedParameterCatalog {
	all_parameter_names: Dict[String, Bool],
	consumed_indices_by_name: Dict[String, Int],
	consumed_parameter_count: Int
}


private enum SimpleConsumedParameterBalance:
	UnsupportedSimpleConsumedParameterBalance
	UnchangedSimpleConsumedParameterBalance


private union SimpleConsumedParameterScanStack:
	SimpleConsumedParameterScanComplete
	SimpleConsumedParameterScanMore(CoreExpr, SimpleConsumedParameterScanStack)


private pure func balance_consumed_param_body(
	env: PerceusEnv,
	param: CoreParam,
	body: CoreExpr,
) -> CoreExpr:
	variable: CoreVar = param.name
	value_type: CoreType = param.typ
	protected: CoreExpr = protect_repeated_consumes(env, variable, value_type, body, False)
	balance_env: PerceusEnv = { env | balance_strategy = BranchAwareOwnershipBalance }
	uses: OwnershipUseSummary = summarize_linear_ownership_uses(
		balance_env,
		variable.name,
		protected,
	)
	owned_refs: Int = max_int(1, uses.required_refs)
	balanced: CoreExpr = balance_branch_body(
		balance_env,
		variable,
		value_type,
		owned_refs,
		uses,
		protected,
	)

	move_only_owner_alias(
		variable,
		prepend_dups(owned_refs - 1, variable, value_type, balanced),
	)


---
Occurrences of one owning variable in a balanced body. `alias_on_spine`
and `drop_on_spine` count the alias retain (`let x = DUP p; p`) and the
release found on the straight-line spine; the other counts cover the whole
body.
---
private record OwnerAliasCensus {
	dups: Int,
	drops: Int,
	other_references: Int,
	alias_on_spine: Int,
	drop_on_spine: Int
}


private pure func is_arc_retain(policy: CoreRetainPolicy) -> Bool:
	match policy:
		ArcRetainPolicy:
			True
		_:
			False


private pure func is_arc_release(policy: CoreReleasePolicy) -> Bool:
	match policy:
		ArcReleasePolicy | ArcReleaseOnlyPolicy:
			True
		_:
			False


---
Whether `expr` is `DUP p; p`, the retained right-hand side Perceus gives
`let x = p` or `var x = p`. Only a plain reference-count retain paired with a
plain reference-count release is a move of one reference; any other policy (a
stack-result copy, a copy-on-write field take) does more than that and is
left alone.
---
private pure func is_owner_alias_retain(owner: CoreVar, expr: CoreExpr) -> Bool:
	match expr:
		DupExpr(variable, _, retain_policy, body, _, _):
			core_var_equal(variable, owner) and is_arc_retain(retain_policy) and match body:
				VarExpr(referenced, _, _):
					core_var_equal(referenced, owner)
				_:
					False
		_:
			False


private pure func count_owner_occurrences(owner: CoreVar, body: CoreExpr) -> OwnerAliasCensus:
	var dups: Int = 0
	var drops: Int = 0
	var other_references: Int = 0
	var pending: List[CoreExpr] = [body]
	var index: Int = 0

	-- A second retain or release, or any other reference, already rules the
	-- move out, so the walk stops there instead of covering the whole body.
	while (
		index < pending.length()
		and dups <= 1
		and drops <= 1
		and other_references == 0
	):
		match pending.get(index):
			Some(current):
				var visit_children: Bool = True

				match current:
					DupExpr(variable, _, _, _, _, _):
						if core_var_equal(variable, owner):
							dups += 1

							if is_owner_alias_retain(owner, current):
								-- The alias's own `p` reference is part of the retain.
								visit_children = False
							else:
								void
						else:
							void
					DropExpr(variable, _, release_policy, _, _, _):
						if core_var_equal(variable, owner):
							if is_arc_release(release_policy):
								drops += 1
							else:
								other_references += 1
						else:
							void
					VarExpr(variable, _, _):
						if core_var_equal(variable, owner):
							other_references += 1
						else:
							void
					AssignExpr(variable, _, _, _):
						if core_var_equal(variable, owner):
							other_references += 1
						else:
							void
					ListHandoffExpr(handoff, _, _):
						if core_var_equal(handoff.source_var, owner):
							other_references += 1
						else:
							void
					_:
						void

				if visit_children:
					for child in CoreTraverse.immediate_core_expr_children(current):
						pending = pending.append(child)
				else:
					void
			None:
				break

		index += 1

	{
		dups = dups,
		drops = drops,
		other_references = other_references,
		alias_on_spine = 0,
		drop_on_spine = 0
	}


---
Counts the alias retains and releases of `owner` that run exactly once
on every path: those reached from the root through bindings, sequences and
other retains or releases only, never through a branch, loop or lambda.
---
private pure func count_spine_alias_and_drop(
	owner: CoreVar,
	body: CoreExpr,
	census: OwnerAliasCensus,
) -> OwnerAliasCensus:
	var alias_on_spine: Int = 0
	var drop_on_spine: Int = 0
	var pending: List[CoreExpr] = [body]
	var index: Int = 0

	while index < pending.length():
		match pending.get(index):
			Some(current):
				match current:
					LetExpr(_, _, _, rhs, let_body):
						if is_owner_alias_retain(owner, rhs):
							alias_on_spine += 1
						else:
							pending = pending.append(rhs)

						pending = pending.append(let_body)
					BorrowLetExpr(_, _, rhs, let_body):
						pending = pending.append(rhs)
						pending = pending.append(let_body)
					SeqExpr(first, second):
						pending = pending.append(first)
						pending = pending.append(second)
					DupExpr(_, _, _, dup_body, _, _):
						pending = pending.append(dup_body)
					DropExpr(variable, _, release_policy, drop_body, _, _):
						if core_var_equal(variable, owner) and is_arc_release(release_policy):
							drop_on_spine += 1
						else:
							void

						pending = pending.append(drop_body)
					_:
						void
			None:
				break

		index += 1

	{ census |
		alias_on_spine = alias_on_spine,
		drop_on_spine = drop_on_spine
	}


private pure func remove_owner_alias_retain_and_drop(owner: CoreVar, expr: CoreExpr) -> CoreExpr:
	stripped: CoreExpr = match expr:
		LetExpr(variable, is_mutable, typ, rhs, body):
			if is_owner_alias_retain(owner, rhs):
				match rhs:
					DupExpr(_, _, _, alias_reference, _, _):
						LetExpr(variable, is_mutable, typ, alias_reference, body)
					_:
						expr
			else:
				expr
		DropExpr(variable, _, release_policy, drop_body, _, _):
			if core_var_equal(variable, owner) and is_arc_release(release_policy):
				drop_body
			else:
				expr
		_:
			expr

	match stripped:
		LetExpr(_, _, _, _, _) | BorrowLetExpr(_, _, _, _) | SeqExpr(_, _) | DupExpr(_, _, _, _, _, _) | DropExpr(_, _, _, _, _, _):
			CoreTraverse.map_core_expr_children(
				stripped,
				func(child): remove_owner_alias_retain_and_drop(owner, child),
			)
		_:
			stripped


---
Alias move for a variable that owns one reference: a consumed parameter or
an immutable managed `let` binding. `let x = p` binds a copy of the
reference, so Perceus retains `p` for `x` and later releases `p` itself.
When that alias and that release are the only occurrences of `p`, and both
run exactly once on every path, the retain/release pair only moves the
reference into `x`. Removing both hands `x` the owner's reference directly,
so a callee that takes `x` sees it uniquely owned and can update it in
place. A `var x = p` slot is the same move: the slot owns its current value
and releases it when an assignment replaces it or the scope ends, so it may
start from the owner's reference even when its first update sits under a
branch or loop that does not run.
---
pure func move_only_owner_alias(owner: CoreVar, body: CoreExpr) -> CoreExpr:
	census: OwnerAliasCensus = count_owner_occurrences(owner, body)

	if (
		census.dups != 1
		or census.drops != 1
		or census.other_references != 0
	):
		body
	else:
		spine: OwnerAliasCensus = count_spine_alias_and_drop(owner, body, census)

		if spine.alias_on_spine == 1 and spine.drop_on_spine == 1:
			remove_owner_alias_retain_and_drop(owner, body)
		else:
			body


-- The catalog-and-proof setup only repays its fixed cost for broad generated
-- signatures. Smaller functions retain the general balancing path.
private SIMPLE_CONSUMED_PARAMETER_BALANCE_MINIMUM: Int = 16


private pure func simple_consumed_parameter_catalog(
	env: PerceusEnv,
	params: List[CoreParam],
	return_type: CoreType,
	consumed_params: List[Int],
) -> Option[SimpleConsumedParameterCatalog]:
	if (
		is_managed_type(env, return_type)
		or consumed_params.length() < SIMPLE_CONSUMED_PARAMETER_BALANCE_MINIMUM
	):
		None
	else:
		var all_parameter_names: Dict[String, Bool] = {}
		var consumed_indices_by_name: Dict[String, Int] = {}
		var consumed_parameter_count: Int = 0
		var eligible: Bool = True
		var index: Int = 0

		for param in params:
			if all_parameter_names.contains(param.name.name):
				eligible = False
			else:
				all_parameter_names = all_parameter_names.set(param.name.name, True)

			if int_list_contains(consumed_params, index):
				if is_managed_type(env, param.typ) and param.name.id == 0:
					match param.name.def_id:
						None:
							consumed_indices_by_name = consumed_indices_by_name.set(
								param.name.name,
								index,
							)
							consumed_parameter_count += 1
						Some(def_id):
							eligible = False
				else:
					eligible = False
			else:
				void

			index += 1

		if eligible and consumed_parameter_count == consumed_params.length():
			Some({
				all_parameter_names = all_parameter_names,
				consumed_indices_by_name = consumed_indices_by_name,
				consumed_parameter_count = consumed_parameter_count,
			})
		else:
			None


---
This proof recognizes only a linear post-insertion body where balancing
every consumed parameter is an identity operation. A call is supported only
when its exact ownership contract directly consumes each referenced
candidate once. Borrowed arguments, branches, aliases, repetition,
shadowing, and ownership nodes for parameters all retain the established
parameter-by-parameter logic.
---
private pure func prove_simple_consumed_parameter_balance(
	env: PerceusEnv,
	catalog: SimpleConsumedParameterCatalog,
	body: CoreExpr,
) -> SimpleConsumedParameterBalance:
	var pending: SimpleConsumedParameterScanStack = SimpleConsumedParameterScanMore(
		body,
		SimpleConsumedParameterScanComplete,
	)
	var observed_indices: Dict[Int, Bool] = {}
	var observed_count: Int = 0
	var supported: Bool = True
	var complete: Bool = False

	while not complete:
		match pending:
			SimpleConsumedParameterScanComplete:
				complete = True
			SimpleConsumedParameterScanMore(expr, remaining):
				pending = remaining

				if supported:
					match expr:
						LiteralExpr(_, _, _) | StaticStringLiteralExpr(_, _, _, _) | VoidExpr(_, _):
							void
						VarExpr(variable, _, _):
							match catalog.consumed_indices_by_name.get(variable.name):
								Some(index):
									if (
										variable.id == 0
										and variable.def_id == None
										and not observed_indices.contains(index)
									):
										observed_indices = observed_indices.set(index, True)
										observed_count += 1
									else:
										supported = False
								None:
									supported = False
						SeqExpr(first, second):
							pending = SimpleConsumedParameterScanMore(
								first,
								SimpleConsumedParameterScanMore(second, pending),
							)
						LetExpr(variable, is_mutable, bind_type, rhs, let_body):
							rhs_is_literal: Bool = match rhs:
								LiteralExpr(_, _, _) | StaticStringLiteralExpr(_, _, _, _):
									True
								_:
									False

							if (
								not is_mutable
								and rhs_is_literal
								and not catalog.all_parameter_names.contains(variable.name)
							):
								pending = SimpleConsumedParameterScanMore(let_body, pending)
							else:
								supported = False
						CallExpr(kind, callee, args, typ, loc):
							callee_is_unrelated_function: Bool = match callee:
								VarExpr(variable, _, _):
									not catalog.all_parameter_names.contains(variable.name)
								_:
									False

							if not callee_is_unrelated_function:
								supported = False
							else:
								match contract_for_call(env, kind, args.length(), typ):
									Some(contract):
										var arg_index: Int = 0

										while supported and arg_index < args.length():
											match args.get(arg_index):
												Some(argument):
													match contract.args.get(arg_index):
														Some(mode):
															match argument:
																VarExpr(variable, _, _):
																	variable_name: String = variable.name

																	match catalog.consumed_indices_by_name.get(
																		variable_name,
																	):
																		Some(index):
																			if (
																				arg_consumes_caller(
																					mode,
																				)
																				and variable.id == 0
																				and variable.def_id == None
																				and not observed_indices.contains(
																					index,
																				)
																			):
																				observed_indices = observed_indices.set(
																					index,
																					True,
																				)
																				observed_count += 1
																			else:
																				supported = False
																		None:
																			supported = False
																LiteralExpr(_, _, _) | StaticStringLiteralExpr(_, _, _, _):
																	void
																_:
																	supported = False
														None:
															supported = False
												None:
													supported = False

											arg_index += 1
									None:
										supported = False
						CastExpr(inner, _, _):
							if (
								not is_managed_type(env, core_expr_type(inner))
								and not is_managed_type(env, core_expr_type(expr))
							):
								pending = SimpleConsumedParameterScanMore(inner, pending)
							else:
								supported = False
						DropExpr(variable, value_type, release_policy, drop_body, typ, loc):
							if catalog.all_parameter_names.contains(variable.name):
								supported = False
							else:
								pending = SimpleConsumedParameterScanMore(drop_body, pending)
						_:
							supported = False
				else:
					void

	if supported and observed_count == catalog.consumed_parameter_count:
		UnchangedSimpleConsumedParameterBalance
	else:
		UnsupportedSimpleConsumedParameterBalance


---
Kept callable so regression tests can assert the production fast-path
decision without relying on wall-clock timing.
---
pure func consumed_parameter_balancing_is_identity(
	env: PerceusEnv,
	func_info: CoreFunction,
	consumed_params: List[Int],
	body: CoreExpr,
) -> Bool:
	match simple_consumed_parameter_catalog(
		env,
		func_info.params,
		func_info.return_type,
		consumed_params,
	):
		Some(catalog):
			match prove_simple_consumed_parameter_balance(env, catalog, body):
				UnchangedSimpleConsumedParameterBalance:
					True
				UnsupportedSimpleConsumedParameterBalance:
					False
		None:
			False


pure func balance_consumed_param_bodies(
	env: PerceusEnv,
	func_info: CoreFunction,
	consumed_params: List[Int],
	body: CoreExpr,
) -> CoreExpr:
	prebalanced: Bool = consumed_parameter_balancing_is_identity(
		env,
		func_info,
		consumed_params,
		body,
	)

	if prebalanced:
		body
	else:
		var result: CoreExpr = body
		var index: Int = func_info.params.length() - 1

		while index >= 0:
			match func_info.params.get(index):
				Some(param):
					if (
						is_managed_type(env, param.typ)
						and int_list_contains(consumed_params, index)
					):
						result = balance_consumed_param_body(env, param, result)
					else:
						void
				None:
					void

			index -= 1

		result


--- The scan walks a reused depth-first worklist. Growing it by concatenation
--- copies pending entries quadratically on wide bodies. Keep each list in one
--- local owner while overwriting popped slots, so `.set` can reuse its buffer.
private pure func push_short_circuit_scan_node(
	nodes: List[CoreExpr],
	count: Int,
	node: CoreExpr,
) -> List[CoreExpr]:
	if count < nodes.length():
		nodes.set(count, node)
	else:
		nodes.append(node)


private pure func push_short_circuit_scan_flag(
	operand_flags: List[Bool],
	count: Int,
	inside_operand: Bool,
) -> List[Bool]:
	if count < operand_flags.length():
		operand_flags.set(count, inside_operand)
	else:
		operand_flags.append(inside_operand)


--- A logical operator only evaluates its right operand when the left operand
--- does not already decide the result, so that operand is a branch with no
--- expression to carry the other path. An ownership transfer inside it is
--- therefore unbalanceable: the enclosing region would count the transfer on
--- every path, and the short-circuited path would keep the reference alive
--- forever. Look for the only shape that can transfer, a call under a right
--- operand, before paying for the rewrite walk. Each pushed node carries
--- whether it already sits under a right operand, so a nested operator
--- inherits the answer instead of rescanning its subtree.
private pure func has_short_circuit_operand_call(expr: CoreExpr) -> Bool:
	var nodes: List[CoreExpr] = [expr]
	var operand_flags: List[Bool] = [False]
	var count: Int = 1
	var found: Bool = False

	while not found and count > 0:
		index: Int = count - 1
		count = index

		match (nodes.get(index), operand_flags.get(index)):
			(Some(node), Some(inside_operand)):
				var push_children: Bool = True

				match node:
					LogicalExpr(op, left, right, typ, loc):
						push_children = False
						nodes = push_short_circuit_scan_node(nodes, count, left)
						operand_flags = push_short_circuit_scan_flag(
							operand_flags,
							count,
							inside_operand,
						)
						count += 1
						nodes = push_short_circuit_scan_node(nodes, count, right)
						operand_flags = push_short_circuit_scan_flag(operand_flags, count, True)
						count += 1
					CallExpr(kind, callee, args, typ, loc):
						if inside_operand:
							found = True
							push_children = False
						else:
							void
					_:
						void

				if push_children:
					for child in CoreTraverse.immediate_core_expr_children(node):
						nodes = push_short_circuit_scan_node(nodes, count, child)
						operand_flags = push_short_circuit_scan_flag(
							operand_flags,
							count,
							inside_operand,
						)
						count += 1
				else:
					void
			_:
				void

	found


--- Every name the expression reads, collected in one walk. The owner loop
--- otherwise asks `count_uses` per owner, and owners accumulate with every
--- enclosing immutable binding, so that walks the operand once per owner.
private pure func short_circuit_operand_read_names(expr: CoreExpr) -> Dict[String, Bool]:
	var nodes: List[CoreExpr] = [expr]
	var count: Int = 1
	var names: Dict[String, Bool] = {}

	while count > 0:
		index: Int = count - 1
		count = index

		match nodes.get(index):
			Some(node):
				match node:
					VarExpr(variable, typ, loc):
						names = names.set(variable.name, True)
					_:
						void

				for child in CoreTraverse.immediate_core_expr_children(node):
					nodes = push_short_circuit_scan_node(nodes, count, child)
					count += 1
			None:
				void

	names


--- The owners a short-circuit operand may take a reference from: the enclosing
--- function's managed parameters and the immutable managed bindings above the
--- operator. Their ownership belongs to the linear region this pass balances.
--- Match payloads, borrowed aliases, and referenced globals carry their own
--- owner normalization and must not receive a second reference here.
private record ShortCircuitContext {
	env: PerceusEnv,
	owners: List[CoreParam]
}


--- Give the operand its own reference for every transfer it performs, so the
--- operand neither requires nor consumes ownership from the region around the
--- logical operator. The skipped path then evaluates neither the dup nor the
--- transfer, and the taken path balances itself.
private pure func own_short_circuit_operand(
	context: ShortCircuitContext,
	operand: CoreExpr,
) -> CoreExpr:
	var result: CoreExpr = operand
	read_names: Dict[String, Bool] = short_circuit_operand_read_names(operand)

	for owner in context.owners:
		-- A name the operand never reads cannot transfer it. The summary stays
		-- the authority for the ones it does read.
		if read_names.contains(owner.name.name):
			consumed_refs: Int = summarize_linear_ownership_uses(
				context.env,
				owner.name.name,
				operand,
			).consumed_refs
			result = prepend_dups(consumed_refs, owner.name, owner.typ, result)
		else:
			void

	result


private record ShortCircuitOperandFrame {
	op: CoreLogicalOp,
	right: CoreExpr,
	typ: CoreType,
	loc: CoreSourceLoc
}


--- Long `and`/`or` chains nest to the left, so walk that spine with a frame
--- list instead of one native stack frame per operator.
private pure func normalize_logical_short_circuit(
	context: ShortCircuitContext,
	expr: CoreExpr,
) -> CoreExpr:
	var frames: List[ShortCircuitOperandFrame] = []
	var current: CoreExpr = expr
	var descending: Bool = True

	while descending:
		match current:
			LogicalExpr(op, left, right, typ, loc):
				frames = frames.append({
					op = op,
					right = right,
					typ = typ,
					loc = loc,
				})
				current = left
			_:
				descending = False

	var result: CoreExpr = normalize_short_circuit_operands(context, current)
	var index: Int = frames.length() - 1

	while index >= 0:
		match frames.get(index):
			Some(frame):
				result = LogicalExpr(
					frame.op,
					result,
					own_short_circuit_operand(
						context,
						normalize_short_circuit_operands(context, frame.right),
					),
					frame.typ,
					frame.loc,
				)
			None:
				void

		index -= 1

	result


private pure func normalize_short_circuit_operands(
	context: ShortCircuitContext,
	expr: CoreExpr,
) -> CoreExpr:
	match expr:
		LogicalExpr(op, left, right, typ, loc):
			normalize_logical_short_circuit(context, expr)
		LetExpr(variable, is_mutable, typ, rhs, body):
			-- An immutable managed binding owns its value for the rest of the
			-- region, exactly like a consumed parameter, so a transfer out of a
			-- short-circuit operand below it is unbalanceable in the same way.
			-- A mutable binding can be reassigned between the dup and the
			-- transfer, so it keeps the existing reassignment handling.
			body_context: ShortCircuitContext = if (
				is_mutable
				or not is_managed_type(context.env, typ)
			):
				context
			else:
				{ context | owners = context.owners.append({
						name = variable,
						typ = typ,
						loc = synthetic_core_source_loc(),
					}) }

			LetExpr(
				variable,
				is_mutable,
				typ,
				normalize_short_circuit_operands(context, rhs),
				normalize_short_circuit_operands(body_context, body),
			)
		_:
			CoreTraverse.map_core_expr_children_with_context(
				expr,
				context,
				normalize_short_circuit_operands,
			)


pure func balance_short_circuit_operands(
	env: PerceusEnv,
	params: List[CoreParam],
	expr: CoreExpr,
) -> CoreExpr:
	var owners: List[CoreParam] = []

	for param in params:
		if is_managed_type(env, param.typ):
			owners = owners.append(param)
		else:
			void

	if has_short_circuit_operand_call(expr):
		normalize_short_circuit_operands(
			{
				env = env,
				owners = owners
			},
			expr,
		)
	else:
		expr
