-- Register every marker in a measured debug/profile window. The benchmark
-- subtracts this one registration call, allowing genuinely zero-valued
-- counters to retain a complete schema in the profiler report.
@debug_only
pure func register_perceus_work_counters() -> Int:
	debug:
		perceus_work_contract_function_analyses()
		perceus_work_contract_managed_parameter_summaries()
		perceus_work_contract_solver_wave_iterations()
		perceus_work_contract_solver_frontier_callable_visits()
		perceus_work_contract_collection_expression_visits()
		perceus_work_contract_flow_edges()
		perceus_work_contract_solver_flow_visits()
		perceus_work_contract_scalar_fallback_analyses()
		perceus_work_contract_managed_parameter_slots()
		perceus_work_contract_reverse_parameter_slots()
		perceus_work_contract_flow_dedup_entries()
		perceus_work_contract_direct_parameter_inserts()
		perceus_work_contract_collection_task_pushes()
		perceus_work_contract_solver_parameter_marks()
		perceus_work_contract_dup_fallback_analyses()
		perceus_work_contract_shadow_fallback_analyses()
		perceus_work_linear_summary_requests()
		perceus_work_linear_summary_node_visits()
		perceus_work_legacy_count_node_visits()
		perceus_work_borrowed_call_node_visits()
		perceus_work_borrowed_call_owner_catalog_slots()
		perceus_work_borrowed_call_owner_candidate_visits()
		perceus_work_borrowed_call_alias_fallback_requests()
		perceus_work_borrowed_call_rewrite_actions()
		perceus_work_borrowed_aggregate_owner_candidate_visits()
		perceus_work_borrowed_aggregate_alias_fallback_requests()
		perceus_work_borrowed_aggregate_rewrite_actions()
		perceus_work_borrowed_result_owner_candidate_visits()
		perceus_work_borrowed_result_alias_fallback_requests()
		perceus_work_borrowed_result_rewrite_actions()
		perceus_work_borrowed_call_fallback_expression_visits()
		perceus_work_borrowed_aggregate_fallback_expression_visits()
		perceus_work_borrowed_result_fallback_expression_visits()
		perceus_work_borrowed_call_reconstructed_nodes()
		perceus_work_borrowed_aggregate_reconstructed_nodes()
		perceus_work_borrowed_result_reconstructed_nodes()
		perceus_work_borrowed_fused_node_visits()
		perceus_work_borrowed_fused_reconstructed_nodes()
		perceus_work_borrowed_function_regions_normalized()
		perceus_work_borrowed_global_initializer_regions_normalized()
		perceus_work_borrowed_function_parameter_owner_slots()
		perceus_work_borrowed_function_global_owner_slots()
		perceus_work_referenced_global_discovery_node_visits()
		perceus_work_referenced_global_read_candidates()
		perceus_work_referenced_global_exact_matches()
		perceus_work_borrowed_global_catalog_slots()
		perceus_work_borrowed_global_normalization_visits()
		perceus_work_borrowed_global_alias_fallback_requests()
		perceus_work_borrowed_global_rewrite_actions()
		perceus_work_lambda_regions_normalized()
		perceus_work_lambda_parameter_owner_slots()
		perceus_work_lambda_capture_owner_slots()
		perceus_work_lambda_referenced_global_owner_slots()
		perceus_work_lambda_scalar_owner_normalizations()
		perceus_work_lambda_borrowed_normalization_visits()
		perceus_work_lambda_alias_fallback_requests()
		perceus_work_lambda_rewrite_actions()
		perceus_work_borrowed_origin_member_visits()
		perceus_work_borrowed_origin_storage_slots()
		perceus_work_borrowed_aggregate_node_visits()
		perceus_work_borrowed_result_node_visits()
		perceus_work_resolved_value_queries()
		perceus_work_insert_node_visits()
		perceus_work_insert_rebuild_actions()
		perceus_work_insert_node_reconstructions()
		perceus_work_insert_original_nodes_reused()
		perceus_work_insert_opaque_rewrite_results()
		perceus_work_insert_managed_let_visits()
		perceus_work_insert_managed_let_original_nodes_reused()
		perceus_work_insert_managed_let_reconstructions()
		perceus_work_insert_call_visits()
		perceus_work_insert_call_original_nodes_reused()
		perceus_work_insert_call_reconstructions()
		perceus_work_insert_aggregate_visits()
		perceus_work_insert_aggregate_original_nodes_reused()
		perceus_work_insert_aggregate_reconstructions()
		perceus_work_insert_fixed_ownership_visits()
		perceus_work_insert_fixed_ownership_original_nodes_reused()
		perceus_work_insert_fixed_ownership_reconstructions()
		perceus_work_insert_fixed_ownership_normalization_rewrites()
		perceus_work_declarations_rewritten()
		perceus_work_functions_rewritten()
		perceus_work_globals_rewritten()

	0
