-- Perceus environment: managed-type index, constructor/global/callable
-- ownership tables, and the lookups Perceus consults during rewriting.
--
-- Owns `PerceusEnv` and its build path (`build_env`, `perceus_env_for_managed_types`),
-- the callable/user-call-contract tables and their lookups, and the
-- managed-type, retain/release-policy, and per-call-site ownership contract
-- queries (`is_managed_type`, `result_mode_for_type`, `contract_for_call`,
-- `lookup_constructor_call_contract`, `borrow_contract_for_signature`). This
-- sits early in the Perceus pipeline: `build_env` runs once per program
-- before any per-function rewriting, and every later phase module queries
-- this environment rather than rebuilding it.
import:
	../ir:
		CoreCallKind(
			BuiltinCall,
			ClosureCall,
			DeferredTraitCall,
			DictWithCapacityCall,
			DirectRuntimeCall,
			FallibleStreamTerminalCall,
			ForeignCall,
			IntrinsicCall,
			ListToStringCall,
			OperationResultCall,
			SelectedDirectCall,
			SelectedTraitCall,
			TensorParallelCall,
			UnknownCall,
			UserCall,
		),
		CoreDecl(EnumDecl, FunctionDecl, GlobalDecl, HeapRecordDecl, ImplDecl, UnionDecl),
		CoreDefinitionIdentity,
		CoreExpr(CallExpr, VarExpr),
		CoreFunctionKind(ClosureBodyFunction),
		CoreParam,
		CoreProgram,
		CoreReleasePolicy(ArcReleasePolicy, StackResultReleasePolicy),
		CoreRetainPolicy(ArcRetainPolicy, StackResultRetainPolicy),
		CoreType(BoxedResultType, NamedType, StackResultType, UnionType, VoidType),
		CoreVar,
	../ownership:
		OwnershipArgMode(BorrowArg, TransferArg),
		OwnershipCallContract,
		OwnershipResultMode(ReturnOwned, ReturnPrimitive, ReturnVoid),
		arg_consumes_caller,
		builtin_contract,
		intrinsic_contract,
	../type_policy as CoreTypePolicy


record ConstructorCallContract {
	parent_type_name: String,
	name: String,
	def_id: Option[Int],
	contract: OwnershipCallContract
}


record PerceusGlobal {
	value: CoreParam,
	is_mutable: Bool
}


type alias OwnershipCallableId = Int


record OwnershipCallableEntry {
	id: OwnershipCallableId,
	identity: CoreDefinitionIdentity,
	parameter_count: Int,
	direct_consumed_args: Option[List[Int]],
	contract_source: OwnershipCallableContractSource
}


union OwnershipCallableContractSource:
	InferredCallableContract
	FixedCallableContract(List[Int])
	ExplicitCallSiteContract


-- Callable entries keyed by definition ID. A bucket holds every entry that
-- shares the definition ID in declaration order, so `lookup_ownership_callable_id`
-- keeps the first declaration that also matches the requested name without
-- hashing the name.
record OwnershipCallableIndex {
	entries_by_id: List[OwnershipCallableEntry],
	candidate_ids_by_def_id: Dict[Int, List[OwnershipCallableId]]
}


-- Inferred user-call contracts by callable ID together with the argument
-- modes each denotes for the callable's declared parameter count. Build one
-- through `user_call_contract_table` so an `arg_modes_by_callable_id` entry
-- always equals the list `consumed_arg_modes` builds on demand for that
-- callable's own arity; a missing entry means "build on demand".
record UserCallContractTable {
	consumed_args_by_callable_id: List[List[Int]],
	arg_modes_by_callable_id: List[List[OwnershipArgMode]]
}


union PerceusGlobalLookup:
	UniquePerceusGlobal(Int, Int)
	CollidingPerceusGlobals(Dict[Int, Int])


union PerceusBalanceStrategy:
	LinearOwnershipBalance
	BranchAwareOwnershipBalance


-- Local rebinding of the BLORP_PERCEUS_ENGINE_METRICS enabled check (see
-- `perceus/results_and_loops.brp`'s own foreign block for the design note).
-- `build_env` reads this exactly once per program and caches the result in
-- `PerceusEnv.engine_metrics_enabled`, so every instrumented helper across
-- `perceus/*.brp` branches on a plain record field instead of paying a
-- cross-module foreign call on every one of the millions of Perceus nodes.
foreign:
	private pure func perceus_engine_metrics_enabled() -> Int = "blorp_perceus_engine_metrics_enabled_c"


record PerceusEnv {
	managed_types: CoreTypePolicy.ManagedTypeIndex,
	constructor_contracts_by_def_id: Dict[Int, List[ConstructorCallContract]],
	constructor_contracts_by_parent_name: Dict[String, List[ConstructorCallContract]],
	global_values: List[PerceusGlobal],
	global_lookup_by_name: Dict[String, PerceusGlobalLookup],
	function_definitions: List[CoreDefinitionIdentity],
	constructor_definitions: List[CoreDefinitionIdentity],
	nullary_constructor_definitions: List[CoreDefinitionIdentity],
	callables: OwnershipCallableIndex,
	user_call_contracts: UserCallContractTable,
	infer_unresolved_user_calls_as_borrow: Bool,
	balance_strategy: PerceusBalanceStrategy,
	transferable_result_vars: List[CoreVar],
	engine_metrics_enabled: Bool
}


pure func uses_branch_aware_balance(strategy: PerceusBalanceStrategy) -> Bool:
	match strategy:
		LinearOwnershipBalance:
			False
		BranchAwareOwnershipBalance:
			True


pure func perceus_env_for_managed_types(managed_type_names: List[String]) -> PerceusEnv:
	{
		managed_types = CoreTypePolicy.managed_type_index_from_names(managed_type_names),
		constructor_contracts_by_def_id = {},
		constructor_contracts_by_parent_name = {},
		global_values = [],
		global_lookup_by_name = {},
		function_definitions = [],
		constructor_definitions = [],
		nullary_constructor_definitions = [],
		callables = {
			entries_by_id = [],
			candidate_ids_by_def_id = {}
		},
		user_call_contracts = empty_user_call_contract_table(),
		infer_unresolved_user_calls_as_borrow = False,
		balance_strategy = LinearOwnershipBalance,
		transferable_result_vars = [],
		engine_metrics_enabled = perceus_engine_metrics_enabled() != 0
	}


private pure func transfer_args(arity: Int) -> List[OwnershipArgMode]:
	var args: List[OwnershipArgMode] = []
	var index: Int = 0

	while index < arity:
		args = args.append(TransferArg)
		index += 1

	args


private pure func borrow_args(arity: Int) -> List[OwnershipArgMode]:
	var args: List[OwnershipArgMode] = []
	var index: Int = 0

	while index < arity:
		args = args.append(BorrowArg)
		index += 1

	args


private pure func consumed_user_call_contract(
	env: PerceusEnv,
	consumed_args: List[Int],
	arg_count: Int,
	return_type: CoreType,
) -> Option[OwnershipCallContract]:
	if consumed_args.length() == 0:
		None
	else:
		var args: List[OwnershipArgMode] = []
		var index: Int = 0

		while index < arg_count:
			if consumed_args.contains(index):
				args = args.append(TransferArg)
			else:
				args = args.append(BorrowArg)

			index += 1

		Some({
			args = args,
			result = result_mode_for_type(env, return_type),
		})


-- Argument modes for a call with `arg_count` arguments whose consumed
-- parameter indices are `consumed_args`.
private pure func consumed_arg_modes(
	consumed_args: List[Int],
	arg_count: Int,
) -> List[OwnershipArgMode]:
	var args: List[OwnershipArgMode] = []
	var index: Int = 0

	while index < arg_count:
		if consumed_args.contains(index):
			args = args.append(TransferArg)
		else:
			args = args.append(BorrowArg)

		index += 1

	args


private pure func empty_user_call_contract_table() -> UserCallContractTable:
	{
		consumed_args_by_callable_id = [],
		arg_modes_by_callable_id = []
	}


pure func user_call_contract_table(
	callables: OwnershipCallableIndex,
	consumed_args_by_callable_id: List[List[Int]],
) -> UserCallContractTable:
	var arg_modes_by_callable_id: List[List[OwnershipArgMode]] = []
	var callable_id: OwnershipCallableId = 0

	for consumed_args in consumed_args_by_callable_id:
		parameter_count: Int = match callables.entries_by_id.get(callable_id):
			Some(entry):
				entry.parameter_count
			None:
				0

		arg_modes_by_callable_id = arg_modes_by_callable_id.append(
			consumed_arg_modes(
				consumed_args,
				parameter_count,
			),
		)
		callable_id += 1

	{
		consumed_args_by_callable_id = consumed_args_by_callable_id,
		arg_modes_by_callable_id = arg_modes_by_callable_id
	}


pure func user_call_contract_from_consumed_args(
	env: PerceusEnv,
	consumed_args: List[Int],
	arg_count: Int,
	return_type: CoreType,
) -> OwnershipCallContract:
	{
		args = consumed_arg_modes(consumed_args, arg_count),
		result = result_mode_for_type(env, return_type)
	}


-- The inferred contract of `callable_id`, reusing the table's precomputed
-- argument modes when the call arity is the callable's own.
private pure func inferred_user_call_contract(
	env: PerceusEnv,
	callable_id: OwnershipCallableId,
	consumed_args: List[Int],
	arg_count: Int,
	return_type: CoreType,
) -> OwnershipCallContract:
	args: List[OwnershipArgMode] = match env.user_call_contracts.arg_modes_by_callable_id.get(
		callable_id,
	):
		Some(modes):
			if modes.length() == arg_count:
				modes
			else:
				consumed_arg_modes(consumed_args, arg_count)
		None:
			consumed_arg_modes(consumed_args, arg_count)

	{
		args = args,
		result = result_mode_for_type(env, return_type)
	}


private pure func args_forward_params_in_order(
	args: List[CoreExpr],
	params: List[CoreParam],
) -> Bool:
	if args.length() != params.length():
		False
	else:
		var forwards: Bool = True
		var index: Int = 0

		while forwards and index < args.length():
			match args.get(index):
				Some(VarExpr(variable, typ, loc)):
					match params.get(index):
						Some(param):
							forwards = (
								variable.name == param.name.name
								and variable.id == param.name.id
							)
						None:
							forwards = False
				Some(arg):
					forwards = False
				None:
					forwards = False

			index += 1

		forwards


private pure func consumed_arg_indices(contract: OwnershipCallContract) -> List[Int]:
	var consumed: List[Int] = []
	var index: Int = 0

	for mode in contract.args:
		if arg_consumes_caller(mode):
			consumed = consumed.append(index)
		else:
			void

		index += 1

	consumed


private pure func direct_builtin_wrapper_consumed_args(
	params: List[CoreParam],
	body: Option[CoreExpr],
) -> Option[List[Int]]:
	match body:
		Some(body):
			match body:
				CallExpr(kind, callee, args, typ, loc):
					match kind:
						BuiltinCall(name):
							if args_forward_params_in_order(args, params):
								match builtin_contract(name, args.length()):
									Some(contract):
										Some(consumed_arg_indices(contract))
									None:
										None
							else:
								None
						_:
							None
				_:
					None
		None:
			None


pure func lookup_ownership_callable_id(
	index: OwnershipCallableIndex,
	name: String,
	def_id: Option[Int],
) -> Option[OwnershipCallableId]:
	match def_id:
		Some(expected_def_id):
			var found: Option[OwnershipCallableId] = None

			-- The bucket is keyed by the definition ID, so only the name still
			-- needs checking.
			for candidate_id in index.candidate_ids_by_def_id.get_or(expected_def_id, []):
				match index.entries_by_id.get(candidate_id):
					Some(entry):
						if entry.identity.name == name:
							found = Some(candidate_id)
							break
						else:
							void
					None:
						void

			found
		None:
			None


pure func callable_consumed_args(
	env: PerceusEnv,
	callable_id: OwnershipCallableId,
) -> Option[List[Int]]:
	match env.callables.entries_by_id.get(callable_id):
		Some(entry):
			match entry.contract_source:
				InferredCallableContract:
					env.user_call_contracts.consumed_args_by_callable_id.get(callable_id)
				FixedCallableContract(consumed_args):
					Some(consumed_args)
				ExplicitCallSiteContract:
					None
		None:
			None


-- The contract `callable_id` carries from its own contract source: the solver
-- table for inferred callables, the fixed list for closure bodies, and none
-- for callables whose call sites carry explicit contracts.
private pure func callable_user_call_contract(
	env: PerceusEnv,
	callable_id: OwnershipCallableId,
	entry: OwnershipCallableEntry,
	arg_count: Int,
	return_type: CoreType,
) -> Option[OwnershipCallContract]:
	match entry.contract_source:
		InferredCallableContract:
			match env.user_call_contracts.consumed_args_by_callable_id.get(callable_id):
				Some(consumed_args):
					Some(
						inferred_user_call_contract(
							env,
							callable_id,
							consumed_args,
							arg_count,
							return_type,
						),
					)
				None:
					None
		FixedCallableContract(consumed_args):
			Some(user_call_contract_from_consumed_args(env, consumed_args, arg_count, return_type))
		ExplicitCallSiteContract:
			None


pure func lookup_user_call_contract(
	env: PerceusEnv,
	name: String,
	def_id: Option[Int],
	arg_count: Int,
	return_type: CoreType,
) -> Option[OwnershipCallContract]:
	match lookup_ownership_callable_id(env.callables, name, def_id):
		Some(callable_id):
			match env.callables.entries_by_id.get(callable_id):
				Some(entry):
					callable_user_call_contract(env, callable_id, entry, arg_count, return_type)
				None:
					None
		None:
			None


-- Resolves the callable once for both the direct builtin-wrapper contract and
-- the callable's own contract, in that historical order.
private pure func resolved_user_call_contract(
	env: PerceusEnv,
	name: String,
	def_id: Option[Int],
	arg_count: Int,
	return_type: CoreType,
) -> Option[OwnershipCallContract]:
	match lookup_ownership_callable_id(env.callables, name, def_id):
		Some(callable_id):
			match env.callables.entries_by_id.get(callable_id):
				Some(entry):
					match entry.direct_consumed_args:
						Some(consumed_args):
							Some(
								user_call_contract_from_consumed_args(
									env,
									consumed_args,
									arg_count,
									return_type,
								),
							)
						None:
							callable_user_call_contract(
								env,
								callable_id,
								entry,
								arg_count,
								return_type,
							)
				None:
					None
		None:
			None


pure func lookup_direct_user_call_contract(
	env: PerceusEnv,
	name: String,
	def_id: Option[Int],
	arg_count: Int,
	return_type: CoreType,
) -> Option[OwnershipCallContract]:
	match lookup_ownership_callable_id(env.callables, name, def_id):
		Some(callable_id):
			match env.callables.entries_by_id.get(callable_id):
				Some(entry):
					match entry.direct_consumed_args:
						Some(consumed_args):
							Some(
								user_call_contract_from_consumed_args(
									env,
									consumed_args,
									arg_count,
									return_type,
								),
							)
						None:
							None
				None:
					None
		None:
			None


private pure func append_constructor_identity_aliases(
	definitions: List[CoreDefinitionIdentity],
	name: String,
	c_name: String,
	def_id: Int,
) -> List[CoreDefinitionIdentity]:
	with_source_name: List[CoreDefinitionIdentity] = definitions.append({
		name = name,
		def_id = def_id,
	})

	if c_name == name:
		with_source_name
	else:
		with_source_name.append({
			name = c_name,
			def_id = def_id,
		})


pure func build_env(program: CoreProgram) -> PerceusEnv:
	managed_type_index: CoreTypePolicy.ManagedTypeIndex = CoreTypePolicy.managed_type_index(program)
	var constructor_contracts_by_def_id: Dict[Int, List[ConstructorCallContract]] = {}
	var constructor_contracts_by_parent_name: Dict[String, List[ConstructorCallContract]] = {}
	var callable_entries: List[OwnershipCallableEntry] = []
	var callable_candidate_ids_by_def_id: Dict[Int, List[OwnershipCallableId]] = {}
	var function_definitions: List[CoreDefinitionIdentity] = []
	var constructor_definitions: List[CoreDefinitionIdentity] = []
	var global_values: List[PerceusGlobal] = []
	var global_lookup_by_name: Dict[String, PerceusGlobalLookup] = {}
	var nullary_constructor_definitions: List[CoreDefinitionIdentity] = []

	for decl in program.decls:
		match decl:
			EnumDecl(enum_decl):
				for variant in enum_decl.variants:
					match variant.def_id:
						Some(def_id):
							constructor_definitions = append_constructor_identity_aliases(
								constructor_definitions,
								variant.name,
								variant.c_name,
								def_id,
							)
						None:
							void
			UnionDecl(union_decl):
				for variant in union_decl.variants:
					match variant.def_id:
						Some(def_id):
							constructor_definitions = append_constructor_identity_aliases(
								constructor_definitions,
								variant.name,
								variant.c_name,
								def_id,
							)
						None:
							void

					arity: Int = variant.fields.length()

					if arity == 0:
						match variant.def_id:
							Some(def_id):
								nullary_constructor_definitions = append_constructor_identity_aliases(
									nullary_constructor_definitions,
									variant.name,
									variant.c_name,
									def_id,
								)
							None:
								void
					else:
						entry: ConstructorCallContract = {
							parent_type_name = union_decl.name,
							name = variant.name,
							def_id = variant.def_id,
							contract = {
								args = transfer_args(arity),
								result = ReturnOwned
							}
						}

						contracts_with_parent: List[ConstructorCallContract] = match constructor_contracts_by_parent_name.get(
							entry.parent_type_name,
						):
							Some(contracts):
								contracts
							None:
								[]

						constructor_contracts_by_parent_name = constructor_contracts_by_parent_name.set(
							entry.parent_type_name,
							contracts_with_parent.append(entry),
						)

						match entry.def_id:
							Some(def_id):
								contracts_with_def_id: List[ConstructorCallContract] = match constructor_contracts_by_def_id.get(
									def_id,
								):
									Some(contracts):
										contracts
									None:
										[]

								constructor_contracts_by_def_id = constructor_contracts_by_def_id.set(
									def_id,
									contracts_with_def_id.append(entry),
								)
							None:
								void
			HeapRecordDecl(record_decl):
				void
			FunctionDecl(func_info):
				callable_id: OwnershipCallableId = callable_entries.length()
				identity: CoreDefinitionIdentity = {
					name = func_info.name,
					def_id = func_info.def_id
				}

				contract_source: OwnershipCallableContractSource = match func_info.body:
					Some(_):
						match func_info.function_kind:
							ClosureBodyFunction(_):
								FixedCallableContract([])
							_:
								InferredCallableContract
					None:
						ExplicitCallSiteContract

				callable_entries = callable_entries.append({
					id = callable_id,
					identity = identity,
					parameter_count = func_info.params.length(),
					direct_consumed_args = direct_builtin_wrapper_consumed_args(
						func_info.params,
						func_info.body,
					),
					contract_source = contract_source,
				})
				callable_candidate_ids_by_def_id = callable_candidate_ids_by_def_id.set(
					func_info.def_id,
					callable_candidate_ids_by_def_id
						.get_or(func_info.def_id, [])
						.append(callable_id),
				)
				function_definitions = function_definitions.append(identity)
			GlobalDecl(global):
				global_index: Int = global_values.length()
				perceus_global: PerceusGlobal = {
					value = {
						name = { global.name | def_id = Some(global.def_id) },
						typ = global.typ,
						loc = global.loc
					},
					is_mutable = global.is_mutable
				}
				global_values = global_values.append(perceus_global)

				global_lookup_by_name = match global_lookup_by_name.get(global.name.name):
					None:
						global_lookup_by_name.set(
							global.name.name,
							UniquePerceusGlobal(global.def_id, global_index),
						)
					Some(UniquePerceusGlobal(existing_def_id, existing_index)):
						if existing_def_id == global.def_id:
							-- Preserve the historical first-declaration behavior for
							-- duplicate exact identities. Ingress validation will reject
							-- conflicting metadata in a later slice.
							global_lookup_by_name
						else:
							var collision_indices: Dict[Int, Int] = {}
							collision_indices = collision_indices.set(
								existing_def_id,
								existing_index,
							)
							collision_indices = collision_indices.set(global.def_id, global_index)
							global_lookup_by_name.set(
								global.name.name,
								CollidingPerceusGlobals(collision_indices),
							)
					Some(CollidingPerceusGlobals(indices_by_def_id)):
						if indices_by_def_id.contains(global.def_id):
							global_lookup_by_name
						else:
							global_lookup_by_name.set(
								global.name.name,
								CollidingPerceusGlobals(
									indices_by_def_id.set(
										global.def_id,
										global_index,
									),
								),
							)
			ImplDecl(impl_decl):
				for method in impl_decl.methods:
					function_definitions = function_definitions.append({
						name = method.name,
						def_id = method.def_id,
					})
			_:
				void

	{
		managed_types = managed_type_index,
		constructor_contracts_by_def_id = constructor_contracts_by_def_id,
		constructor_contracts_by_parent_name = constructor_contracts_by_parent_name,
		global_values = global_values,
		global_lookup_by_name = global_lookup_by_name,
		function_definitions = function_definitions,
		constructor_definitions = constructor_definitions,
		nullary_constructor_definitions = nullary_constructor_definitions,
		callables = {
			entries_by_id = callable_entries,
			candidate_ids_by_def_id = callable_candidate_ids_by_def_id
		},
		user_call_contracts = empty_user_call_contract_table(),
		infer_unresolved_user_calls_as_borrow = False,
		balance_strategy = LinearOwnershipBalance,
		transferable_result_vars = [],
		engine_metrics_enabled = perceus_engine_metrics_enabled() != 0
	}


pure func is_managed_type(env: PerceusEnv, typ: CoreType) -> Bool:
	CoreTypePolicy.is_managed_type(env.managed_types, typ)


pure func is_nullary_constructor_reference(
	nullary_constructor_definitions: List[CoreDefinitionIdentity],
	variable: CoreVar,
) -> Bool:
	match variable.def_id:
		Some(def_id):
			var found: Bool = False

			for definition in nullary_constructor_definitions:
				if definition.name == variable.name and definition.def_id == def_id:
					found = True
					break

			found
		None:
			False


pure func retain_policy_for_type(typ: CoreType) -> CoreRetainPolicy:
	match typ:
		StackResultType(ok_type, err_type):
			StackResultRetainPolicy
		_:
			ArcRetainPolicy


pure func release_policy_for_type(typ: CoreType) -> CoreReleasePolicy:
	match typ:
		StackResultType(ok_type, err_type):
			StackResultReleasePolicy
		_:
			ArcReleasePolicy


pure func result_mode_for_type(env: PerceusEnv, typ: CoreType) -> OwnershipResultMode:
	match typ:
		VoidType:
			ReturnVoid
		_:
			if is_managed_type(env, typ):
				ReturnOwned
			else:
				ReturnPrimitive


pure func borrow_contract_for_signature(
	env: PerceusEnv,
	arg_count: Int,
	return_type: CoreType,
) -> OwnershipCallContract:
	{
		args = borrow_args(arg_count),
		result = result_mode_for_type(env, return_type)
	}


private pure func contract_matches_arity(args: List[OwnershipArgMode], arg_count: Int) -> Bool:
	args.length() == arg_count


private pure func optional_constructor_parent_name(typ: CoreType) -> Option[String]:
	match typ:
		NamedType(name, args):
			Some(name)
		UnionType(name):
			Some(name)
		_:
			None


private pure func constructor_contract_by_identity(
	constructor_contracts_by_def_id: Dict[Int, List[ConstructorCallContract]],
	name: String,
	def_id: Int,
	arg_count: Int,
) -> Option[OwnershipCallContract]:
	var found: Option[OwnershipCallContract] = None

	entries: List[ConstructorCallContract] = match constructor_contracts_by_def_id.get(def_id):
		Some(contracts):
			contracts
		None:
			[]

	-- Unscoped lookup preserves the historical last matching declaration.
	for entry in entries:
		if entry.name == name and contract_matches_arity(entry.contract.args, arg_count):
			found = Some(entry.contract)
		else:
			void

	found


private pure func constructor_contract_by_return_type(
	constructor_contracts_by_def_id: Dict[Int, List[ConstructorCallContract]],
	parent_type_name: String,
	name: String,
	def_id: Option[Int],
	arg_count: Int,
) -> Option[OwnershipCallContract]:
	match def_id:
		Some(value):
			-- `build_env` fills the definition-ID and parent-name buckets in the
			-- same pass over `program.decls`, so the definition-ID bucket holds
			-- exactly the entries the parent-name scan would have accepted here,
			-- in the same declaration order. Narrowing by definition ID first
			-- keeps the first match while skipping the parent's other variants.
			entries: List[ConstructorCallContract] = match constructor_contracts_by_def_id.get(
				value,
			):
				Some(contracts):
					contracts
				None:
					[]

			var found: Option[OwnershipCallContract] = None

			for entry in entries:
				if (
					entry.parent_type_name == parent_type_name
					and entry.name == name
					and contract_matches_arity(entry.contract.args, arg_count)
				):
					found = Some(entry.contract)
					break
				else:
					void

			found
		None:
			None


pure func lookup_return_type_constructor_call_contract(
	env: PerceusEnv,
	name: String,
	def_id: Option[Int],
	arg_count: Int,
	return_type: CoreType,
) -> Option[OwnershipCallContract]:
	match return_type:
		StackResultType(_, _):
			result_constructor_contract(env, name, def_id, arg_count, return_type)
		BoxedResultType(_, _):
			result_constructor_contract(env, name, def_id, arg_count, return_type)
		_:
			match optional_constructor_parent_name(return_type):
				Some(parent_type_name):
					constructor_contract_by_return_type(
						env.constructor_contracts_by_def_id,
						parent_type_name,
						name,
						def_id,
						arg_count,
					)
				None:
					None


private pure func result_constructor_contract(
	env: PerceusEnv,
	name: String,
	def_id: Option[Int],
	arg_count: Int,
	return_type: CoreType,
) -> Option[OwnershipCallContract]:
	match def_id:
		Some(value):
			match constructor_contract_by_identity(
				env.constructor_contracts_by_def_id,
				name,
				value,
				arg_count,
			):
				Some(_):
					Some({
						args = transfer_args(arg_count),
						result = result_mode_for_type(env, return_type),
					})
				None:
					None
		None:
			None


private pure func return_type_has_known_constructor_parent(
	constructor_contracts_by_parent_name: Dict[String, List[ConstructorCallContract]],
	return_type: CoreType,
) -> Bool:
	match optional_constructor_parent_name(return_type):
		Some(parent_type_name):
			constructor_contracts_by_parent_name.contains(parent_type_name)
		None:
			False


pure func lookup_constructor_call_contract(
	env: PerceusEnv,
	name: String,
	def_id: Option[Int],
	arg_count: Int,
) -> Option[OwnershipCallContract]:
	match def_id:
		Some(value):
			constructor_contract_by_identity(
				env.constructor_contracts_by_def_id,
				name,
				value,
				arg_count,
			)
		None:
			None


private pure func projected_or_unresolved_user_call_contract(
	env: PerceusEnv,
	consumed_args: List[Int],
	arg_count: Int,
	return_type: CoreType,
) -> Option[OwnershipCallContract]:
	match consumed_user_call_contract(env, consumed_args, arg_count, return_type):
		Some(contract):
			Some(contract)
		None:
			if env.infer_unresolved_user_calls_as_borrow:
				Some(borrow_contract_for_signature(env, arg_count, return_type))
			else:
				None


private pure func unresolved_user_call_contract(
	env: PerceusEnv,
	name: String,
	def_id: Option[Int],
	consumed_args: List[Int],
	arg_count: Int,
	return_type: CoreType,
) -> Option[OwnershipCallContract]:
	if return_type_has_known_constructor_parent(
		env.constructor_contracts_by_parent_name,
		return_type,
	):
		projected_or_unresolved_user_call_contract(env, consumed_args, arg_count, return_type)
	else:
		-- `contract_for_call` reaches this point only after the callable's own
		-- contract lookup returned `None`, so repeating that lookup here (as the
		-- historical code did) can never find a contract.
		match lookup_constructor_call_contract(env, name, def_id, arg_count):
			Some(contract):
				Some(contract)
			None:
				projected_or_unresolved_user_call_contract(
					env,
					consumed_args,
					arg_count,
					return_type,
				)


pure func contract_for_call(
	env: PerceusEnv,
	kind: CoreCallKind,
	arg_count: Int,
	return_type: CoreType,
) -> Option[OwnershipCallContract]:
	match kind:
		UnknownCall:
			None
		DeferredTraitCall(trait_name, method_name):
			None
		SelectedTraitCall(trait_name, method_name, module_path, def_id):
			None
		SelectedDirectCall(def_id):
			None
		IntrinsicCall(name):
			intrinsic_contract(name, arg_count)
		BuiltinCall(name):
			builtin_contract(name, arg_count)
		UserCall(name, def_id, consumed_args):
			-- Constructor calls also arrive as UserCall. Only a resolved constructor
			-- identity may select a constructor ownership contract.
			match lookup_return_type_constructor_call_contract(
				env,
				name,
				def_id,
				arg_count,
				return_type,
			):
				Some(contract):
					Some(contract)
				None:
					match resolved_user_call_contract(env, name, def_id, arg_count, return_type):
						Some(contract):
							Some(contract)
						None:
							unresolved_user_call_contract(
								env,
								name,
								def_id,
								consumed_args,
								arg_count,
								return_type,
							)
		ForeignCall(name, arg_passing):
			Some(borrow_contract_for_signature(env, arg_count, return_type))
		ClosureCall:
			Some(borrow_contract_for_signature(env, arg_count, return_type))
		DirectRuntimeCall(call):
			builtin_contract(call.name, arg_count)
		OperationResultCall(bridge):
			builtin_contract(bridge.builtin_name, arg_count)
		FallibleStreamTerminalCall(bridge):
			builtin_contract(bridge.builtin_name, arg_count)
		TensorParallelCall(name, layout):
			builtin_contract(name, arg_count)
		DictWithCapacityCall(constructor):
			builtin_contract("blorp_dict_with_capacity_custom", arg_count)
		ListToStringCall(name):
			builtin_contract("blorp_list_to_string_cb", arg_count)
