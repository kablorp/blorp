-- Hand-built Core for tests and benchmark fixtures.
--
-- Production code states each function's `CoreFunctionOrigin` where it
-- creates the function. Fixtures that assemble `CoreFunction` records by hand
-- describe declared source functions whose spelling never matters, so they
-- share this one origin instead of each inventing a `NameId`.
import:
	../stage_02_lex/name_table: synthesized_name_id
	../stage_04_modules/loaded_module: ModuleOrigin, resolved_module_identity_from_resolver
	../stage_04_modules/module_table: singleton_module_table
	ir:
		CoreDeclaredOrigin(MonoInstance, PureVariant, SourceFunction),
		CoreFunction,
		CoreFunctionOrigin(Declared),
		CoreModuleOrigin(NoSourceModule, SourceModule),


---
A source function whose name id no fixture inspects: the placeholder `_`
from the parser's closed synthesized vocabulary.
---
FIXTURE_SOURCE_FUNCTION_ORIGIN: CoreFunctionOrigin = Declared(SourceFunction(synthesized_name_id("_")))


---
`base` as a mono instance of itself under a new `name` and `def_id`: the origin
says which declaration it copies, as `mono_specialize.brp` writes it. A fixture
puts `base` in the program beside the instance; a reader asks the origin, so
the instance's name can be anything.
---
pure func fixture_mono_instance_of(base: CoreFunction, name: String, def_id: Int) -> CoreFunction:
	{ base |
		name = name,
		def_id = def_id,
		origin = Declared(MonoInstance(base.def_id, []))
	}


---
`base` as its pure overload under a new `name` and `def_id`, as flatten writes it.
---
pure func fixture_pure_variant_of(base: CoreFunction, name: String, def_id: Int) -> CoreFunction:
	{ base |
		name = name,
		def_id = def_id,
		origin = Declared(PureVariant(base.def_id))
	}


---
The module of a fixture function that no test asks about.
---
FIXTURE_NO_SOURCE_MODULE: CoreModuleOrigin = NoSourceModule


---
A source module for a fixture, made from a one-row module table.
---
pure func fixture_source_module(canonical_path: String, origin: ModuleOrigin) -> CoreModuleOrigin:
	(_, module_id) = singleton_module_table(resolved_module_identity_from_resolver(canonical_path, origin))
	SourceModule(module_id, origin)
