-- Hand-built Core for tests and benchmark fixtures.
--
-- Production code states each function's `CoreFunctionOrigin` where it
-- creates the function. Fixtures that assemble `CoreFunction` records by hand
-- describe declared source functions whose spelling never matters, so they
-- share this one origin instead of each inventing a `NameId`.
import:
	../stage_02_lex/name_table:
		NameTable,
		SYNTHESIZED_NAME_TABLE,
		name_id_unseeded_spelling,
		name_table_find_id,
		name_table_intern,
		synthesized_name_id,
	../stage_04_modules/loaded_module: ModuleOrigin, resolved_module_identity_from_resolver
	../stage_04_modules/module_table: empty_module_table, singleton_module_table
	ir:
		CoreDeclarationIndex,
		CoreProgram,
		core_declaration_index,
		CoreVariantRef(VariantById),
		CoreDeclaredOrigin(MonoInstance, PureVariant, SourceFunction),
		CoreFunction,
		CoreFunctionOrigin(Declared),
		CoreModuleOrigin(NoSourceModule, SourceModule),


---
A source function whose name id no fixture inspects: the placeholder `_`
from the parser's closed synthesized vocabulary.
---
FIXTURE_SOURCE_FUNCTION_ORIGIN: CoreFunctionOrigin = Declared(
	SourceFunction(synthesized_name_id("_")),
)


---
A source function declared under `spelling`, for a fixture whose pass reads the
member the function is. `spelling` must be in the compiler's closed vocabulary
(`synthesized_name_id`); anything else gets the unseeded sentinel, which equals
no member a pass recognises.
---
pure func fixture_source_function_origin_named(spelling: String) -> CoreFunctionOrigin:
	Declared(SourceFunction(synthesized_name_id(spelling)))


---
The compiler's closed vocabulary extended with `spellings`, for a fixture that
declares functions under member names the vocabulary lacks. The fixture asks the
same table for a function's origin (`fixture_source_function_origin_in`) and hands
it to the pass under test as `CoreDeclarationIndex.names`.
---
pure func fixture_name_table(spellings: List[String]) -> NameTable:
	var table: NameTable = SYNTHESIZED_NAME_TABLE

	for spelling in spellings:
		(next_table, _) = name_table_intern(table, spelling)
		table = next_table

	table


---
A source function declared under `spelling`, whose id is `names`'s. A spelling the
table lacks gets the unseeded sentinel, so a fixture that forgot to list it fails
instead of aliasing another member.
---
pure func fixture_source_function_origin_in(
	names: NameTable,
	spelling: String,
) -> CoreFunctionOrigin:
	match name_table_find_id(names, spelling):
		Some(id):
			Declared(SourceFunction(id))
		None:
			Declared(SourceFunction(name_id_unseeded_spelling()))


---
`base` as a mono instance of itself under a new `name` and `def_id`: the origin
says which declaration it copies, as `mono_specialize.brp` writes it. A fixture
puts `base` in the program beside the instance; a reader asks the origin, so
the instance's name can be anything.
---
pure func fixture_mono_instance_of(base: CoreFunction, name: String, def_id: Int) -> CoreFunction:
	{ base |
		name = name,
		def_id = def_id,
		origin = Declared(MonoInstance(base.def_id, []))
	}


---
`base` as its pure overload under a new `name` and `def_id`, as flatten writes it.
---
pure func fixture_pure_variant_of(base: CoreFunction, name: String, def_id: Int) -> CoreFunction:
	{ base |
		name = name,
		def_id = def_id,
		origin = Declared(PureVariant(base.def_id))
	}


---
The declaration index of a hand-built program: `names` for the spellings and an
empty module table, because a fixture mints its module ids from one-row tables of
its own (`fixture_source_module`), so no single table agrees with all of them.
---
pure func fixture_declaration_index(names: NameTable, program: CoreProgram) -> CoreDeclarationIndex:
	core_declaration_index(names, empty_module_table(), program)


---
The module of a fixture function that no test asks about.
---
FIXTURE_NO_SOURCE_MODULE: CoreModuleOrigin = NoSourceModule


---
A source module for a fixture, made from a one-row module table.
---
pure func fixture_source_module(canonical_path: String, origin: ModuleOrigin) -> CoreModuleOrigin:
	(_, module_id) = singleton_module_table(
		resolved_module_identity_from_resolver(
			canonical_path,
			origin,
		),
	)
	SourceModule(module_id, origin)


---
A constructor test or construct whose variant the pass under test never
spells, so any reference will do. The id is negative, which no fixture mints
(definition ids are non-negative), so it can never be mistaken for a declared
variant's id.
---
pure func unspelled_test_variant() -> CoreVariantRef:
	VariantById(-1)


---
The member a fixture function stands for, given that fixtures still name a module
member `<module>__<member>` (the synthesis, resolve and std-inline passes read the
member from the function's origin, not from that name; a test passes it to the
few entry points that take the member as a String). A name without the module
prefix is its own member. Removed with the M3.1 name markers
(docs/NAME_MANGLING_REMOVAL_ROADMAP.md), like the name readers in `pass_runner.brp`.
---
pure func fixture_member_spelling(function_info: CoreFunction) -> String:
	module_prefix: String = function_info.source_module
		.get_or("")
		.replace("/", "_") + "__"

	if function_info.name.starts_with(module_prefix):
		function_info.name.substring(
			module_prefix.length(),
			function_info.name.length() - module_prefix.length(),
		)
	else:
		function_info.name
