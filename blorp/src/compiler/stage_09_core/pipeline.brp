-- Blorp-owned Core-to-Core pipeline slices.
--
-- This module owns contiguous late-Core pass ordering. Pass ordering belongs
-- here rather than in CLI dispatch or C emission.
import:
	../stage_02_lex/name_table: EMPTY_NAME_TABLE, NameTable
	../stage_04_modules/module_table: ModuleTable, empty_module_table
	backend_projection as CoreBackendProjection
	closure as CoreClosure
	consume_specialize as CoreConsumeSpecialize
	dce as CoreDce
	early_stages as CoreEarlyStages
	fairness: insert_cooperative_checkpoints
	hash_key_callbacks as CoreHashKeyCallbacks
	ir: CoreProgram, MINTED_BINDER_ID_FLOOR, core_program_max_declared_definition_id, core_program_to_json
	late_invariants:
		check_definition_id_uniqueness,
		check_late_core_invariants,
		core_late_invariant_message,
	managed_record_layout: managed_record_layout_fault_message
	match_projection as CoreMatchProjection
	ownership_contracts as CoreOwnershipContracts
	pass_runner:
		CORE_REPLAY_BINDER_EXHAUSTION_MESSAGE,
		CorePass,
		CorePassControl,
		CorePassDiagnostic(CorePassMessage),
		CorePassRun(CorePassesCompleted, CorePassesFailed, CorePassesStopped),
		CorePassState,
		core_pass,
		core_pass_matches,
		core_pass_state,
		core_pass_replay_state,
		core_pass_state_carry_ids,
		core_program_invariant,
		core_program_pass,
		core_reserve_binder_ids,
		run_core_passes,
	perceus as CorePerceus
	pipeline_stage:
		CorePipelineStage(
			ClosureStage, ConsumeSpecializeStage, DceStage, DesugarStage, FinalStage,
			ListLayoutStage, PerceusStage, PostClosureTailStage, PostDceTailStage,
			PostPerceusTailStage, PreClosureTailStage, PreDceTailStage, ReuseStage, SpecializeStage,
			StaticStringLiteralsStage,
		),
		DESUGAR_STAGE,
		FINAL_STAGE,
		LIST_LAYOUT_STAGE,
	prepare as CorePrepare: CancellationPlanTable, CleanupPlan
	product_evaluation: normalize_product_evaluation
	record_update as CoreRecordUpdate
	resolve as CoreResolve
	resource_management: rewrite_resource_program
	reuse as CoreReuse
	specialize as CoreSpecialize
	static_string_literals as CoreStaticStringLiterals
	tensor_specialize as CoreTensorSpecialize
	tuple_storage: lower_tuple_storage_program, tuple_storage_failure_message, validate_tuple_storage_program


-- The representation is private so a caller cannot replace a plan after
-- preparation: the plans stay paired with the exact Core program that built
-- them.
private record PreparedCoreProgramRep {
	program: CoreProgram,
	cleanup_plan: CleanupPlan,
	cancellation_plan_table: CancellationPlanTable,
	names: NameTable,
	modules: ModuleTable
}


---
A `CoreProgram` that has been through the full late-Core pass list, paired
with the per-type cleanup plan (see `CorePrepare.CleanupPlan`) and the
per-function/global cancellation plan (see `CorePrepare.CancellationPlanTable`)
computed from it once here -- the single place production code and tests turn
a `CoreProgram` into the thing the backend emits from. Building the plans
here, rather than adding fields to `CoreProgram` itself, avoids touching the
several dozen call sites across `stage_08_core_lower` and `stage_09_core`
that construct a bare `CoreProgram` as one late-Core pass hands off to the
next; only this constructor and its accessors needed to change.
---
opaque type PreparedCoreProgram = PreparedCoreProgramRep


private pure func prepared_core_program_rep(prepared: PreparedCoreProgram) -> PreparedCoreProgramRep:
	from_opaque PreparedCoreProgram(prepared)


pure func prepared_core_program(program: CoreProgram) -> Result[PreparedCoreProgram, CorePassDiagnostic]:
	storage_validation ?= validate_tuple_storage_program(program).map_err(
		func(failure): CorePassMessage(tuple_storage_failure_message(failure)),
	)
	cleanup_plan ?= CorePrepare.build_cleanup_plan(program).map_err(
		func(fault): CorePassMessage(managed_record_layout_fault_message(fault)),
	)
	Ok(into_opaque PreparedCoreProgram({
		program = program,
		cleanup_plan = cleanup_plan,
		cancellation_plan_table = CorePrepare.build_cancellation_plan_table(program),
		names = EMPTY_NAME_TABLE,
		modules = empty_module_table()
	}))


-- The runtime prints allocation and RSS counters for a named checkpoint when
-- BLORP_MEMORY_STATS is set, and is a no-op otherwise. Declared
-- locally rather than imported, matching `pass_runner.brp` and
-- `lib/compile_plan_execute.brp`.
foreign:
	@no_copy func record_compile_memory_checkpoint(
		phase: String,
	) -> Void = "blorp_compiler_memory_checkpoint_c"


CLEANUP_PLAN_CHECKPOINT: String = "cleanup_plan_complete"

CANCELLATION_PLAN_CHECKPOINT: String = "cancellation_plan_complete"


---
Same as `prepared_core_program`, but records a `BLORP_MEMORY_STATS`
checkpoint after each of the two plans it builds. `prepared_core_program`
runs after `run_core_passes` has already emitted `pass_<name>_complete` for
every late-Core pass including the last one (`prepared_reuse`), so without
this, `build_cleanup_plan` and `build_cancellation_plan_table`'s allocations
land in no named row -- only in the coarser `late_core_complete` phase
checkpoint recorded by the caller once this whole struct is built. Used by
`execute_late_core_stages`, the one function every late-Core consumer
(production compiles, `--dump-core-after`, `--stop-after`, the backend
bridge) calls to turn passes' output into a `PreparedCoreProgram`; pure
callers (tests, the work profiler) that build a `PreparedCoreProgram`
directly keep using `prepared_core_program`.
---
func prepared_core_program_with_checkpoints(
	program: CoreProgram,
	names: NameTable,
	modules: ModuleTable,
) -> Result[PreparedCoreProgram, CorePassDiagnostic]:
	storage_validation ?= validate_tuple_storage_program(program).map_err(
		func(failure): CorePassMessage(tuple_storage_failure_message(failure)),
	)
	cleanup_plan ?= CorePrepare.build_cleanup_plan(program).map_err(
		func(fault): CorePassMessage(managed_record_layout_fault_message(fault)),
	)
	record_compile_memory_checkpoint(CLEANUP_PLAN_CHECKPOINT)
	cancellation_plan_table: CancellationPlanTable = CorePrepare.build_cancellation_plan_table(
		program,
	)
	record_compile_memory_checkpoint(CANCELLATION_PLAN_CHECKPOINT)

	Ok(into_opaque PreparedCoreProgram({
		program = program,
		cleanup_plan = cleanup_plan,
		cancellation_plan_table = cancellation_plan_table,
		names = names,
		modules = modules
	}))


---
The compilation's name table, carried with the program the backend emits from
so an emission diagnostic can render an identifier through
`name_spelling_or_text`. Read-only; `EMPTY_NAME_TABLE` for a program built
outside a compilation (tests, profilers).
---
pure func prepared_core_program_name_table(prepared: PreparedCoreProgram) -> NameTable:
	prepared_core_program_rep(prepared).names


---
The compilation's module table, carried with the program the backend emits from
so emission will render a function's module path from its `ModuleId`. Read-only;
`empty_module_table()` for a program built outside a compilation (tests,
profilers).
---
pure func prepared_core_program_module_table(prepared: PreparedCoreProgram) -> ModuleTable:
	prepared_core_program_rep(prepared).modules


pure func prepared_core_program_value(prepared: PreparedCoreProgram) -> CoreProgram:
	prepared_core_program_rep(prepared).program


pure func prepared_core_program_cleanup_plan(prepared: PreparedCoreProgram) -> CleanupPlan:
	prepared_core_program_rep(prepared).cleanup_plan


pure func prepared_core_program_cancellation_plan_table(
	prepared: PreparedCoreProgram,
) -> CancellationPlanTable:
	prepared_core_program_rep(prepared).cancellation_plan_table


ADAPT_FUNCTION_REFS_PASS: String = "adapt_function_refs"

TENSOR_SPECIALIZE_PASS: String = "tensor_specialize"

SPECIALIZE_PASS: String = "specialize"

-- The single walk `fused_late_core_passes` substitutes for the two passes
-- above (see `run_fused_tensor_specialize_and_specialize_pass`). Never a
-- target of `--dump-core-after`/`--stop-after`/`--observe`: those always
-- resolve against `late_core_passes()`'s own two names.
FUSED_TENSOR_SPECIALIZE_PASS: String = "tensor_specialize_specialize_fused"

RESOLVE_CALLABLES_PASS: String = "resolve_callables"

BACKEND_PROJECTION_PASS: String = "backend_projection"

MATCH_PROJECTION_PASS: String = "match_projection"

-- The single walk `fused_late_core_passes` substitutes for the three passes
-- above (see `run_fused_resolve_backend_match_pass`). Never a target of
-- `--dump-core-after`/`--stop-after`/`--observe`: those always resolve
-- against `late_core_passes()`'s own three names.
FUSED_RESOLVE_BACKEND_MATCH_PASS: String = "resolve_backend_match_fused"

HASH_KEY_CALLBACKS_PASS: String = "hash_key_callbacks"

DCE_PASS: String = "dce"

CONSUME_SPECIALIZE_PASS: String = "consume_specialize"

STATIC_STRING_LITERALS_PASS: String = "static_string_literals"

RECORD_UPDATE_OWNERSHIP_PASS: String = "record_update_ownership"

PRODUCT_EVALUATION_PASS: String = "product_evaluation"

DICT_LITERAL_OWNERSHIP_PASS: String = "dict_literal_ownership"

OWNERSHIP_CONTRACTS_PASS: String = "ownership_contracts"

PERCEUS_PASS: String = "perceus"

FUSED_OWNERSHIP_PERCEUS_PASS: String = "ownership_perceus_fused"

REUSE_PASS: String = "reuse"

CLOSURE_PASS: String = "closure"

RESOURCE_MANAGEMENT_PASS: String = "resource_management"

FAIRNESS_PASS: String = "fairness"

PREPARE_PASS: String = "prepare"

PREPARED_REUSE_PASS: String = "prepared_reuse"


---
Invariants that run on every compile. Keep these O(1) or near it; the full
structural walks belong in `checked_invariant`.
---
pure func required_final_invariant(program: CoreProgram) -> Option[CorePassDiagnostic]:
	if CoreRecordUpdate.record_update_carrier_survives(program):
		Some(CorePassMessage("record update survived ownership normalization"))
	else:
		match check_definition_id_uniqueness(program):
			[violation, ..._]:
				Some(CorePassMessage(core_late_invariant_message(violation)))
			[]:
				None


pure func late_core_invariant(
	stage: CorePipelineStage,
	program: CoreProgram,
) -> Option[CorePassDiagnostic]:
	match check_late_core_invariants(stage, program):
		[violation, ..._]:
			Some(CorePassMessage(core_late_invariant_message(violation)))
		[]:
			None


private pure func checked_late_core_pass(
	name: String,
	run: pure (CoreProgram) -> CoreProgram,
	stage: CorePipelineStage,
) -> CorePass:
	walk: pure (CorePassState) -> Option[CorePassDiagnostic] = func(state):
		late_core_invariant(stage, state.program)

	{ core_program_pass(name, run) | checked_invariant = Some(walk) }


---
Same as `checked_late_core_pass`, for a pass that mints declarations and so
must read and advance `CorePassState.next_def_id` instead of only
rewriting `state.program`.
---
private pure func checked_stateful_late_core_pass(
	name: String,
	run: pure (CorePassState) -> Result[CorePassState, CorePassDiagnostic],
	stage: CorePipelineStage,
) -> CorePass:
	walk: pure (CorePassState) -> Option[CorePassDiagnostic] = func(state):
		late_core_invariant(stage, state.program)

	{ core_pass(name, run) | checked_invariant = Some(walk) }


pure func run_adapt_function_refs_pass(
	state: CorePassState,
) -> Result[CorePassState, CorePassDiagnostic]:
	adapted: CoreClosure.ClosurePassResult = CoreClosure.adapt_function_refs_program(
		state.program,
		state.next_def_id,
	)
	Ok(core_pass_state_carry_ids(state, adapted.program, adapted.next_def_id))


pure func run_tensor_specialize_pass(program: CoreProgram) -> CoreProgram:
	CoreTensorSpecialize.specialize_program(program)


pure func run_specialize_pass(program: CoreProgram) -> CoreProgram:
	CoreSpecialize.specialize_program(program)


---
The normal-path replacement for the two passes above: tensor_specialize
adapts tensor dispatch before general ABI specialization runs, and neither
pass needs the other's rewrite to build its own context (tensor_specialize
has none; `CoreSpecialize.specialize_program_fused` builds its layout from
`program.decls`, unaffected by either pass's expression-level rewrites), so
one walk applying tensor_specialize's per-node step then specialize's own
reproduces running them separately. See
`CoreSpecialize.specialize_program_fused`'s docstring for the walk itself
and `late_core_passes_for_control` for when this replaces
`TENSOR_SPECIALIZE_PASS`/`SPECIALIZE_PASS`.
---
pure func run_fused_tensor_specialize_and_specialize_pass(program: CoreProgram) -> CoreProgram:
	CoreSpecialize.specialize_program_fused(program)


pure func run_resolve_callables_pass(program: CoreProgram) -> CoreProgram:
	CoreResolve.resolve_callable_id_calls(program)


pure func run_backend_projection_pass(program: CoreProgram) -> CoreProgram:
	CoreBackendProjection.project_backend_calls(program)


pure func run_match_projection_pass(program: CoreProgram) -> CoreProgram:
	CoreMatchProjection.project_backend_matches(program)


---
The normal-path replacement for the three passes above: builds each pass's
one-time context from the same (pre-fusion) program they would otherwise
each read separately -- none of the three depend on each other's rewrites
for their own context (`CoreResolve.program_callables` and
`CoreBackendProjection.build_backend_projection_context` only scan
`program.decls`) -- then walks the tree once, applying resolve, then
backend projection, then match projection to each node in turn. See
`CoreMatchProjection.project_fused_late_core`'s docstring for the walk
itself and `late_core_passes_for_control` for when this replaces
`RESOLVE_CALLABLES_PASS`/`BACKEND_PROJECTION_PASS`/`MATCH_PROJECTION_PASS`.
---
pure func run_fused_resolve_backend_match_pass(program: CoreProgram) -> CoreProgram:
	callables: List[CoreResolve.CoreCallableIdentity] = CoreResolve.program_callables(program)
	backend: CoreBackendProjection.BackendProjectionContext = CoreBackendProjection.build_backend_projection_context(
		program,
	)
	CoreMatchProjection.project_fused_late_core(program, callables, backend)


---
Mints key-slot callback adapters for trait-hashed Dict and Set keys. It runs
after specialization, which materializes the key types, and before backend
projection, which binds each container constructor to the adapters by definition id;
DCE then keeps only the adapters some container uses.
---
pure func run_hash_key_callbacks_pass(
	state: CorePassState,
) -> Result[CorePassState, CorePassDiagnostic]:
	minted: CoreHashKeyCallbacks.HashKeyCallbackResult = CoreHashKeyCallbacks.mint_hash_key_callbacks(
		state.program,
		state.next_def_id,
	)
	Ok(core_pass_state_carry_ids(state, minted.program, minted.next_def_id))


pure func run_dce_pass(program: CoreProgram) -> CoreProgram:
	CoreDce.prune_program(program)


pure func run_consume_specialize_pass(
	state: CorePassState,
) -> Result[CorePassState, CorePassDiagnostic]:
	rewritten: CoreConsumeSpecialize.ConsumeSpecializeResult = CoreConsumeSpecialize.rewrite_program(
		state.program,
		state.next_def_id,
	)
	Ok(core_pass_state_carry_ids(state, rewritten.program, rewritten.next_def_id))


pure func run_static_string_literals_pass(program: CoreProgram) -> CoreProgram:
	CoreStaticStringLiterals.rewrite_static_string_literals(program)


pure func run_record_update_ownership_pass(program: CoreProgram) -> CoreProgram:
	CoreRecordUpdate.lower_record_updates_for_ownership(program)


pure func run_product_evaluation_pass(
	state: CorePassState,
) -> Result[CorePassState, CorePassDiagnostic]:
	normalized = normalize_product_evaluation(state.program, state.next_binder_id)
	Ok(core_reserve_binder_ids({ state | program = normalized.program }, normalized.ids_used))


pure func run_dict_literal_ownership_pass(program: CoreProgram) -> CoreProgram:
	CorePrepare.prepare_dict_literals_for_ownership(program)


---
Resolves global value refs, builds the base `PerceusEnv`, solves the
ownership contract graph to a fixpoint, and annotates every `UserCall` site
with its resolved consumed-argument list -- once per program, immediately
before `perceus`. Publishes the result as `CorePassState.ownership_contract_facts`
so `perceus` (this span's very next pass) reads it instead of rebuilding the
environment or re-solving the graph.
---


pure func run_ownership_contracts_pass(
	state: CorePassState,
) -> Result[CorePassState, CorePassDiagnostic]:
	resolved_program: CoreProgram = CoreResolve.resolve_global_value_refs(state.program)
	facts: CoreOwnershipContracts.OwnershipContractFacts = CoreOwnershipContracts.infer_ownership_contracts(
		resolved_program,
	)
	annotated_program: CoreProgram = CoreOwnershipContracts.annotate_ownership_contracts_program(
		facts,
		resolved_program,
	)

	Ok({ state |
			program = annotated_program,
			ownership_contract_facts = facts
		})


pure func run_perceus_pass(state: CorePassState) -> Result[CorePassState, CorePassDiagnostic]:
	Ok(
		{ state |
			program = CorePerceus.insert_drops_program_with_facts(
				state.program,
				state.ownership_contract_facts,
			)
		},
	)


---
Resolve globals and solve ownership facts once, then let Perceus annotate
each call during its existing rewrite. The standalone pair remains the
snapshot and differential oracle path.
---
pure func run_fused_ownership_perceus_pass(
	state: CorePassState,
) -> Result[CorePassState, CorePassDiagnostic]:
	resolved_program: CoreProgram = CoreResolve.resolve_global_value_refs(state.program)
	facts: CoreOwnershipContracts.OwnershipContractFacts = CoreOwnershipContracts.infer_ownership_contracts(
		resolved_program,
	)
	Ok({ state |
			program = CorePerceus.insert_drops_program_with_facts(resolved_program, facts),
			ownership_contract_facts = facts
		})


pure func run_reuse_pass(program: CoreProgram) -> CoreProgram:
	CoreReuse.rewrite_post_perceus_program(program)


pure func run_closure_pass(state: CorePassState) -> Result[CorePassState, CorePassDiagnostic]:
	converted: CoreClosure.ClosurePassResult = CoreClosure.convert_program_minting(
		state.program,
		state.next_def_id,
		state.next_binder_id,
	)
	Ok(
		{ core_pass_state_carry_ids(state, converted.program, converted.next_def_id) |
			next_binder_id = converted.next_binder_id
		},
	)


pure func run_resource_management_pass(program: CoreProgram) -> CoreProgram:
	rewrite_resource_program(program)


pure func run_fairness_pass(program: CoreProgram) -> CoreProgram:
	insert_cooperative_checkpoints(program)


pure func run_prepare_pass(program: CoreProgram) -> CoreProgram:
	CorePrepare.prepare_program(program)


pure func run_prepared_reuse_pass(program: CoreProgram) -> CoreProgram:
	CoreReuse.rewrite_prepared_program(program)


private pure func final_checked_invariant(program: CoreProgram) -> Option[CorePassDiagnostic]:
	late_core_invariant(FinalStage, program)


---
The last pass carries the only production invariant: the fast ownership and
identity checks that no compile may skip.
---
private pure func final_late_core_pass() -> CorePass:
	{ core_program_pass(PREPARED_REUSE_PASS, run_prepared_reuse_pass) |
		invariant = Some(core_program_invariant(required_final_invariant)),
		checked_invariant = Some(core_program_invariant(final_checked_invariant))
	}


---
The standalone ordered late-Core pass list used by internal observers, the
work profiler, and the backend bridge. It retains separate
`ownership_contracts` and `perceus` passes as the pre- and post-Perceus
oracle snapshots. Production compiles use `fused_late_core_passes()` through
`late_core_passes_for_control()`; the CLI's `perceus` checkpoint selects this
standalone list. ABI specialization stays last in the projection prefix:
earlier normalizers rebuild expression trees and must not reintroduce unboxed
erased-runtime arguments.
---
pure func late_core_passes() -> List[CorePass]:
	[
		core_pass(ADAPT_FUNCTION_REFS_PASS, run_adapt_function_refs_pass),
		core_program_pass(TENSOR_SPECIALIZE_PASS, run_tensor_specialize_pass),
		checked_late_core_pass(SPECIALIZE_PASS, run_specialize_pass, SpecializeStage),
		core_pass(HASH_KEY_CALLBACKS_PASS, run_hash_key_callbacks_pass),
		core_program_pass(RESOLVE_CALLABLES_PASS, run_resolve_callables_pass),
		core_program_pass(BACKEND_PROJECTION_PASS, run_backend_projection_pass),
		core_program_pass(MATCH_PROJECTION_PASS, run_match_projection_pass),
		checked_late_core_pass(DCE_PASS, run_dce_pass, DceStage),
		checked_stateful_late_core_pass(
			CONSUME_SPECIALIZE_PASS,
			run_consume_specialize_pass,
			ConsumeSpecializeStage,
		),
		checked_late_core_pass(
			STATIC_STRING_LITERALS_PASS,
			run_static_string_literals_pass,
			StaticStringLiteralsStage,
		),
		core_program_pass(RECORD_UPDATE_OWNERSHIP_PASS, run_record_update_ownership_pass),
		core_program_pass(DICT_LITERAL_OWNERSHIP_PASS, run_dict_literal_ownership_pass),
		core_pass(PRODUCT_EVALUATION_PASS, run_product_evaluation_pass),
		core_pass(OWNERSHIP_CONTRACTS_PASS, run_ownership_contracts_pass),
		checked_stateful_late_core_pass(PERCEUS_PASS, run_perceus_pass, PerceusStage),
		checked_late_core_pass(REUSE_PASS, run_reuse_pass, ReuseStage),
		checked_stateful_late_core_pass(CLOSURE_PASS, run_closure_pass, ClosureStage),
		core_program_pass(RESOURCE_MANAGEMENT_PASS, run_resource_management_pass),
		core_program_pass(FAIRNESS_PASS, run_fairness_pass),
		core_program_pass(PREPARE_PASS, run_prepare_pass),
		final_late_core_pass(),
	]


---
Same list as `late_core_passes()`, with tensor_specialize+specialize
replaced by their fused walk (`run_fused_tensor_specialize_and_specialize_pass`)
and resolve_callables+backend_projection+match_projection replaced by their
fused walk (`run_fused_resolve_backend_match_pass`), plus ownership_contracts
and Perceus combined into one production pass. A literal sibling list
rather than a splice of `late_core_passes()`, so the two are easy to diff
against each other when either changes. `late_core_passes_for_control` is
the only caller; the work profiler, backend bridge, and internal pass
observers keep using `late_core_passes()` directly. The fused
tensor_specialize/specialize entry keeps `SpecializeStage`'s
`checked_invariant`, so that invariant still runs exactly once, right after
the fused walk, the same as it does after the standalone `specialize` pass.
---
pure func fused_late_core_passes() -> List[CorePass]:
	[
		core_pass(ADAPT_FUNCTION_REFS_PASS, run_adapt_function_refs_pass),
		checked_late_core_pass(
			FUSED_TENSOR_SPECIALIZE_PASS,
			run_fused_tensor_specialize_and_specialize_pass,
			SpecializeStage,
		),
		core_pass(HASH_KEY_CALLBACKS_PASS, run_hash_key_callbacks_pass),
		core_program_pass(FUSED_RESOLVE_BACKEND_MATCH_PASS, run_fused_resolve_backend_match_pass),
		checked_late_core_pass(DCE_PASS, run_dce_pass, DceStage),
		checked_stateful_late_core_pass(
			CONSUME_SPECIALIZE_PASS,
			run_consume_specialize_pass,
			ConsumeSpecializeStage,
		),
		checked_late_core_pass(
			STATIC_STRING_LITERALS_PASS,
			run_static_string_literals_pass,
			StaticStringLiteralsStage,
		),
		core_program_pass(RECORD_UPDATE_OWNERSHIP_PASS, run_record_update_ownership_pass),
		core_program_pass(DICT_LITERAL_OWNERSHIP_PASS, run_dict_literal_ownership_pass),
		core_pass(PRODUCT_EVALUATION_PASS, run_product_evaluation_pass),
		checked_stateful_late_core_pass(
			FUSED_OWNERSHIP_PERCEUS_PASS,
			run_fused_ownership_perceus_pass,
			PerceusStage,
		),
		checked_late_core_pass(REUSE_PASS, run_reuse_pass, ReuseStage),
		checked_stateful_late_core_pass(CLOSURE_PASS, run_closure_pass, ClosureStage),
		core_program_pass(RESOURCE_MANAGEMENT_PASS, run_resource_management_pass),
		core_program_pass(FAIRNESS_PASS, run_fairness_pass),
		core_program_pass(PREPARE_PASS, run_prepare_pass),
		final_late_core_pass(),
	]


-- Names inside the three spans `fused_late_core_passes` replaces: the
-- tensor_specialize/specialize pair and the
-- resolve_callables/backend_projection/match_projection triple, and the
-- ownership_contracts/perceus pair.
private LATE_FUSED_PASS_SPAN: List[String] = [
	TENSOR_SPECIALIZE_PASS,
	SPECIALIZE_PASS,
	RESOLVE_CALLABLES_PASS,
	BACKEND_PROJECTION_PASS,
	MATCH_PROJECTION_PASS,
	OWNERSHIP_CONTRACTS_PASS,
	PERCEUS_PASS,
]


---
True when `control` asks to observe or stop inside any fused span,
so `late_core_passes_for_control` must fall back to
`late_core_passes()`'s standalone passes to keep that snapshot byte-identical
to today's output. One request inside any span falls back for the whole
list rather than fusing the other span only, keeping this one small check
instead of a per-span mix-and-match selector.
---
private pure func control_targets_fused_pass_span(control: CorePassControl) -> Bool:
	stop_in_span: Bool = match control.stop_after:
		Some(name):
			LATE_FUSED_PASS_SPAN.contains(name)
		None:
			False

	control.observe.any(func(name): LATE_FUSED_PASS_SPAN.contains(name)) or stop_in_span


---
The one place production compiles, `--dump-core-after`, `--stop-after`, and
`--observe` all choose between the two pass lists above. Everything except a
request that names a pass inside a fused span gets `fused_late_core_passes()`;
a request naming one of the replaced passes gets `late_core_passes()` unchanged.
`ownership_contracts` is an internal pass observer boundary; the CLI exposes
the `perceus` stage, which also selects the standalone pair. The work profiler, `run_late_core_span`,
and tests call `late_core_passes()` directly and are unaffected.
---
pure func late_core_passes_for_control(control: CorePassControl) -> List[CorePass]:
	if control_targets_fused_pass_span(control):
		late_core_passes()
	else:
		fused_late_core_passes()


---
User-visible stage names are aliases for the pass they end at. The tail
stage names all name the end of the list.
---
pure func late_core_pass_name(stage: CorePipelineStage) -> String:
	match stage:
		DesugarStage:
			DESUGAR_STAGE
		ListLayoutStage:
			LIST_LAYOUT_STAGE
		SpecializeStage:
			SPECIALIZE_PASS
		DceStage:
			DCE_PASS
		ConsumeSpecializeStage:
			CONSUME_SPECIALIZE_PASS
		StaticStringLiteralsStage:
			STATIC_STRING_LITERALS_PASS
		PerceusStage:
			PERCEUS_PASS
		ReuseStage:
			REUSE_PASS
		ClosureStage:
			CLOSURE_PASS
		PreDceTailStage:
			PREPARED_REUSE_PASS
		PostDceTailStage:
			PREPARED_REUSE_PASS
		PostPerceusTailStage:
			PREPARED_REUSE_PASS
		PreClosureTailStage:
			PREPARED_REUSE_PASS
		PostClosureTailStage:
			PREPARED_REUSE_PASS
		FinalStage:
			PREPARED_REUSE_PASS


---
Checked replay of a contiguous late-Core span. A decoded snapshot must reserve
its existing binder ids before any pass can mint, and preparation callers must
propagate failures instead of admitting partially processed Core as prepared.
---
pure func try_run_late_core_span(
	from_pass: Option[String],
	through_pass: Option[String],
	program: CoreProgram,
) -> Result[CoreProgram, CorePassDiagnostic]:
	initial ?= core_pass_replay_state(program, core_program_max_declared_definition_id(program) + 1)
	var current: CorePassState = initial
	var running: Bool = from_pass.is_none()
	var done: Bool = False
	var failure: Option[CorePassDiagnostic] = None

	for pass in late_core_passes():
		if not done:
			if not running and core_pass_matches(from_pass, pass.name):
				running = True
			if running:
				match pass.run(current):
					Ok(advanced):
						if advanced.next_binder_id < MINTED_BINDER_ID_FLOOR:
							failure = Some(CorePassMessage(CORE_REPLAY_BINDER_EXHAUSTION_MESSAGE))
							done = True
						else:
							current = advanced
					Err(diagnostic):
						failure = Some(diagnostic)
						done = True
			if core_pass_matches(through_pass, pass.name):
				done = True
	match failure:
		Some(diagnostic):
			Err(diagnostic)
		None:
			Ok(current.program)


pure func try_prepare_perceus_input(program: CoreProgram) -> Result[CoreProgram, CorePassDiagnostic]:
	storage ?= lower_tuple_storage_program(program).map_err(
		func(failure): CorePassMessage(tuple_storage_failure_message(failure)),
	)
	try_run_late_core_span(Some(CONSUME_SPECIALIZE_PASS), Some(PRODUCT_EVALUATION_PASS), storage)


pure func try_run_perceus_stage(program: CoreProgram) -> Result[CoreProgram, CorePassDiagnostic]:
	storage ?= lower_tuple_storage_program(program).map_err(
		func(failure): CorePassMessage(tuple_storage_failure_message(failure)),
	)
	try_run_late_core_span(Some(CONSUME_SPECIALIZE_PASS), Some(PERCEUS_PASS), storage)


pure func try_run_post_perceus_tail(program: CoreProgram) -> Result[CoreProgram, CorePassDiagnostic]:
	try_run_late_core_span(Some(REUSE_PASS), None, program)


pure func try_run_pre_dce_tail(program: CoreProgram) -> Result[PreparedCoreProgram, CorePassDiagnostic]:
	storage ?= lower_tuple_storage_program(program).map_err(
		func(failure): CorePassMessage(tuple_storage_failure_message(failure)),
	)
	processed ?= try_run_late_core_span(None, None, storage)
	prepared_core_program(processed)


---
Legacy partial-Core convenience for fixture and debug consumers. This helper
returns the last successful state on failure and is not a validation boundary.
Use the checked try_run_late_core_span or its preparation wrappers when a
successful result promises prepared Core. Production compiles use
run_core_passes, which times, observes, stops and checks invariants.
---
pure func run_late_core_span(
	from_pass: Option[String],
	through_pass: Option[String],
	program: CoreProgram,
) -> CoreProgram:
	match core_pass_replay_state(program, core_program_max_declared_definition_id(program) + 1):
		Err(_):
			program
		Ok(initial):
			var current: CorePassState = initial
			var running: Bool = from_pass.is_none()
			var done: Bool = False

			for pass in late_core_passes():
				if not done:
					if not running and core_pass_matches(from_pass, pass.name):
						running = True

					if running:
						-- This debug span runs no invariants and returns the last
						-- successful Core state if a pass fails.
						match pass.run(current):
							Ok(advanced):
								current = advanced
							Err(_):
								done = True

						if core_pass_matches(through_pass, pass.name):
							done = True

			current.program

pure func run_list_layout_stage(program: CoreProgram) -> CoreProgram:
	CoreEarlyStages.run_list_layout_stage(program)


pure func run_specialize_stage(program: CoreProgram) -> CoreProgram:
	run_late_core_span(None, Some(SPECIALIZE_PASS), program)


pure func prepare_perceus_input(program: CoreProgram) -> CoreProgram:
	run_late_core_span(Some(CONSUME_SPECIALIZE_PASS), Some(PRODUCT_EVALUATION_PASS), program)


pure func run_perceus_stage(program: CoreProgram) -> CoreProgram:
	run_late_core_span(Some(CONSUME_SPECIALIZE_PASS), Some(PERCEUS_PASS), program)


pure func run_post_perceus_tail(program: CoreProgram) -> CoreProgram:
	run_late_core_span(Some(REUSE_PASS), None, program)


-- Preparation always returns a checked artifact, including fixture callers.
-- The partial-Core replay convenience cannot issue a PreparedCoreProgram.
pure func run_pre_dce_tail(program: CoreProgram) -> Result[PreparedCoreProgram, CorePassDiagnostic]:
	try_run_pre_dce_tail(program)


---
Failure and stop reporting uses the user-visible stage name for the pass.
---
pure func late_core_pass_stage_name(pass_name: String) -> String:
	if pass_name == PREPARED_REUSE_PASS:
		FINAL_STAGE
	else:
		pass_name
