-- Declaration-derived facts needed by post-monomorphization body synthesis.
--
-- Core types intentionally keep source names. Layout-sensitive synthesis must
-- therefore consult declarations rather than guess whether a NamedType is an
-- enum, heap record, or union.
import:
	../stage_06_typecheck/type_system/language_surface_manifest: DeclaredAbiType(DeclaredAbiBool)
	ir:
		CoreDecl(EnumDecl, HeapRecordDecl, TypeAliasDecl, UnionDecl),
		CoreDeclarationIndex,
		CoreMonoSubstitution,
		CoreMonoSubstitutionValue(TypeSubstitution),
		CoreProgram,
		CoreType(NamedType),
		CoreTypeAliasDecl,
		core_empty_declaration_index,
	mono: apply_type_substitution
	runtime_callbacks: CoreRuntimeCallbackTable, build_runtime_callback_table


record CoreSynthContext {
	enum_type_names: List[String],
	heap_record_type_names: List[String],
	union_type_names: List[String],
	type_aliases: List[CoreTypeAliasDecl],
	declarations: CoreDeclarationIndex,
	runtime_callbacks: CoreRuntimeCallbackTable
}


enum CoreSynthNamedTypeLayout:
	SynthEnumLayout
	SynthHeapRecordLayout
	SynthUnionLayout


---
A context that knows no declarations. A function, not a constant, because of a C
emitter limit: a global initializer may not read a global defined in another module
(emit.brp reports "unsupported global initializer for `<name>`", which the CLI prints after
`internal C emission failure: `), and the empty
declaration index holds `EMPTY_NAME_TABLE` from `name_table`. Make this a constant
when the emitter accepts cross-module global references in initializers.
---
pure func core_synth_context_empty() -> CoreSynthContext:
	{
		enum_type_names = [],
		heap_record_type_names = [],
		union_type_names = [],
		type_aliases = [],
		declarations = core_empty_declaration_index(),
		runtime_callbacks = build_runtime_callback_table({ decls = [], foreign_includes = [], source_files = [] })
	}


private pure func append_decl(context: CoreSynthContext, decl: CoreDecl) -> CoreSynthContext:
	match decl:
		EnumDecl(enum_decl):
			-- Canonical Bool already has primitive layout; do not reroute its
			-- installed methods through the custom scalar-union key lane.
			if enum_decl.abi_type == Some(DeclaredAbiBool):
				context
			else:
				{ context | enum_type_names = context.enum_type_names.append(enum_decl.name) }
		HeapRecordDecl(record_decl):
			{ context |
				heap_record_type_names = context.heap_record_type_names.append(record_decl.name)
			}
		UnionDecl(union_decl):
			{ context | union_type_names = context.union_type_names.append(union_decl.name) }
		TypeAliasDecl(alias_decl):
			{ context | type_aliases = context.type_aliases.append(alias_decl) }
		_:
			context


pure func core_synth_context(
	declarations: CoreDeclarationIndex,
	program: CoreProgram,
) -> CoreSynthContext:
	var context: CoreSynthContext = { core_synth_context_empty() |
		declarations = declarations,
		runtime_callbacks = build_runtime_callback_table(program)
	}

	for decl in program.decls:
		context = append_decl(context, decl)

	context


pure func core_synth_named_type_layout(
	context: CoreSynthContext,
	name: String,
) -> Option[CoreSynthNamedTypeLayout]:
	if context.enum_type_names.contains(name):
		Some(SynthEnumLayout)
	else if context.heap_record_type_names.contains(name):
		Some(SynthHeapRecordLayout)
	else if context.union_type_names.contains(name):
		Some(SynthUnionLayout)
	else:
		None


private pure func find_type_alias(
	aliases: List[CoreTypeAliasDecl],
	name: String,
) -> Option[CoreTypeAliasDecl]:
	var found: Option[CoreTypeAliasDecl] = None

	for alias_decl in aliases:
		if alias_decl.name == name:
			found = Some(alias_decl)
			break

	found


private pure func alias_substitution(
	type_params: List[String],
	args: List[CoreType],
) -> CoreMonoSubstitution:
	var substitution: CoreMonoSubstitution = []
	var index: Int = 0

	while index < type_params.length():
		match (type_params.get(index), args.get(index)):
			(Some(type_param), Some(arg)):
				substitution = substitution.append((type_param, TypeSubstitution(arg)))
			_:
				break

		index += 1

	substitution


private pure func expand_alias(
	context: CoreSynthContext,
	typ: CoreType,
	active_aliases: List[String],
) -> CoreType:
	match typ:
		NamedType(name, args):
			match find_type_alias(context.type_aliases, name):
				Some(alias_decl):
					if (
						active_aliases.contains(name)
						or alias_decl.type_params.length() != args.length()
					):
						typ
					else:
						expanded_args = args.map(
							func(arg): expand_alias(context, arg, active_aliases),
						)
						target = apply_type_substitution(
							alias_substitution(alias_decl.type_params, expanded_args),
							alias_decl.target,
						)
						expand_alias(
							context,
							target,
							active_aliases.append(name),
						)
				None:
					typ
		_:
			typ


---
Layout is an implementation property of an alias target even when source
typechecking treats the alias as opaque.
---
pure func core_synth_expand_alias(context: CoreSynthContext, typ: CoreType) -> CoreType:
	expand_alias(context, typ, [])


---
Whether `typ` names an opaque alias once transparent aliases are expanded.
Dict and Set keys of an opaque type hash and compare through its own impls,
which the representation's layout does not reveal.
---
pure func core_synth_names_opaque_alias(context: CoreSynthContext, typ: CoreType) -> Bool:
	names_opaque_alias(context, typ, [])


private pure func names_opaque_alias(
	context: CoreSynthContext,
	typ: CoreType,
	active_aliases: List[String],
) -> Bool:
	match typ:
		NamedType(name, args):
			match find_type_alias(context.type_aliases, name):
				Some(alias_decl):
					if (
						active_aliases.contains(name)
						or alias_decl.type_params.length() != args.length()
					):
						False
					else if alias_decl.is_opaque:
						True
					else:
						names_opaque_alias(
							context,
							apply_type_substitution(
								alias_substitution(alias_decl.type_params, args),
								alias_decl.target,
							),
							active_aliases.append(name),
						)
				None:
					False
		_:
			False
