import:
	ir:
		CoreReleasePolicy(
			ArcReleaseOnlyPolicy, ArcReleasePolicy, NoReleasePolicy, StackResultReleasePolicy,
		),
		CoreType(
			InlineRecordType, NativeManagedType, BoxedResultType, UnionType, FunctionType,
			HeapRecordType, NamedType, RangeType, SelfType, StackResultType, TensorType, TupleType,
			TypeParameterType, VoidType,
		),
		CoreUnionValueStorage(ScalarTagValue, ManagedUnionValue),
	type_policy:
		erased_slot_holds_owned_box,
		is_core_fallible_stream_type_name,
		is_core_resource_source_type_name,
		is_core_stream_type_name,
		nullable_managed_option_payload_release_policy,


pure func generated_stack_option_c_type_name(payload_name: String) -> String:
	if payload_name == "Range":
		"blorp_StackOption_RangeValue"
	else:
		"blorp_StackOption_" + payload_name


---
`CoreStackOptionRepresentation.option_type` (and every other Core-IR field
that stores a stack-Option C type spelling) is baked in at Core-lowering
time, before backend symbol projection has a plan to offer -- so it always
carries an *unprojected* payload name. Most payloads reach this through
`generated_stack_option_c_type_name`'s plain `"blorp_StackOption_" +
payload_name` branch, but `stack_option_c_type`'s `RangeType` arm bakes the
fixed literal `"blorp_StackOption_Range"` directly, bypassing
`generated_stack_option_c_type_name` entirely (whose own `Range` special
case produces the differently-spelled `"blorp_StackOption_RangeValue"`, an
unrelated generated-typedef name) -- so naively stripping the prefix and
re-running every payload name back through `generated_stack_option_c_type_name`
would mangle `Range` into the wrong spelling. Only a payload name that is
actually a key in `type_symbol_lookup` was ever a projection candidate
(`Range`, like every other builtin, never is), so this only reconstructs
the spelling when the lookup hits; every other name -- builtin or
absent-from-the-plan -- passes through completely unchanged.
---
pure func resolved_stack_option_type_name(
	option_type: String,
	type_symbol_lookup: Dict[String, String],
) -> String:
	prefix: String = "blorp_StackOption_"

	if type_symbol_lookup.is_empty() or not option_type.starts_with(prefix):
		option_type
	else:
		payload_name: String = option_type.substring(
			prefix.length(),
			option_type.length() - prefix.length(),
		)

		match type_symbol_lookup.get(payload_name):
			Some(projected):
				generated_stack_option_c_type_name(projected)
			None:
				option_type


---
Scalar stack-Option list/tensor elements carry a full
`blorp_StackOption_<payload>` spelling, prepared before C symbol projection.
Re-resolving preserves the projected payload identity: a
`blorp_StackOption_` name defers to `resolved_stack_option_type_name`
(which recovers the projected payload). Other explicit C type spellings use
the supplied type-symbol lookup.
---
pure func resolved_inline_struct_c_type(
	c_type: String,
	type_symbol_lookup: Dict[String, String],
) -> String:
	if c_type.starts_with("blorp_StackOption_"):
		resolved_stack_option_type_name(c_type, type_symbol_lookup)
	else:
		type_symbol_lookup
			.get(c_type)
			.get_or(c_type)


---
Core lowering also bakes a "boxed tensor element" C type as
`c_type_name(element_type, {})` for heap records and unions (see
`tensor_for_element_storage_for_canonical_type`'s catch-all arm), which
comes out as the declared name plus a trailing `*` -- unlike the bare-name
shapes `resolved_inline_struct_c_type` handles. Every other spelling that
arm can produce (`blorp_Vector*`, `blorp_Tuple*`, `blorp_StackResult`,
`blorp_Result*`, `blorp_Closure*`, `void*`, `void`, or a boxed generic's
`void*`) is a fixed runtime name that is never a key in
`type_symbol_lookup`, so stripping and re-appending the trailing `*` for
those is a no-op and safe to apply unconditionally.
---
pure func resolved_boxed_element_c_type(
	c_type: String,
	type_symbol_lookup: Dict[String, String],
) -> String:
	if type_symbol_lookup.is_empty() or not c_type.ends_with("*"):
		c_type
	else:
		bare_name: String = c_type.substring(0, c_type.length() - 1)
		type_symbol_lookup
			.get(bare_name)
			.get_or(bare_name) + "*"


---
`type_symbol_lookup` maps an artifact-local heap/value/union/union type's
declared name to its projected short C symbol (see
`c_symbol_projection.c_emission_type_symbol_lookup`). It is empty for every
caller that runs before final backend emission has a symbol plan to offer
(Core lowering and Core transformation passes still address types by their
declared name); an empty dict makes every lookup a no-op, so those callers
keep emitting today's unprojected spelling.
---
pure func stack_option_c_type(
	payload: CoreType,
	type_symbol_lookup: Dict[String, String],
) -> Option[String]:
	match payload:
		NativeManagedType(_):
			None
		VoidType:
			Some("blorp_StackOption_Void")
		NamedType(name, args):
			if args.length() == 0:
				if name == "Int":
					Some("blorp_StackOption_Int")
				else if name == "Int8":
					Some("blorp_StackOption_Int8")
				else if name == "Int16":
					Some("blorp_StackOption_Int16")
				else if name == "Int32":
					Some("blorp_StackOption_Int32")
				else if name == "Int64":
					Some("blorp_StackOption_Int64")
				else if name == "UInt8":
					Some("blorp_StackOption_UInt8")
				else if name == "UInt16":
					Some("blorp_StackOption_UInt16")
				else if name == "UInt32":
					Some("blorp_StackOption_UInt32")
				else if name == "UInt64":
					Some("blorp_StackOption_UInt64")
				else if name == "Float":
					Some("blorp_StackOption_Float")
				else if name == "Float32":
					Some("blorp_StackOption_Float32")
				else if name == "Float16":
					Some("blorp_StackOption_Float16")
				else if name == "Bool":
					Some("blorp_StackOption_Bool")
				else if name == "Char":
					Some("blorp_StackOption_Char")
				else if name == "Int128":
					Some("blorp_StackOption_Int128")
				else if name == "UInt128":
					Some("blorp_StackOption_UInt128")
				else:
					None
			else:
				None
		TypeParameterType(_) | SelfType:
			None
		UnionType(name, ScalarTagValue):
			Some(
				generated_stack_option_c_type_name(
					type_symbol_lookup
						.get(name)
						.get_or(name),
				),
			)
		HeapRecordType(name):
			None
		InlineRecordType(name):
			Some(
				generated_stack_option_c_type_name(
					type_symbol_lookup
						.get(name)
						.get_or(name),
				),
			)
		UnionType(name, ManagedUnionValue):
			None
		StackResultType(ok_type, err_type):
			None
		BoxedResultType(ok_type, err_type):
			None
		FunctionType(_, _, _):
			None
		RangeType:
			Some("blorp_StackOption_Range")
		TensorType(info):
			None
		TupleType(items):
			None


pure func nullable_managed_option_payload_type(option_type: CoreType) -> Option[CoreType]:
	match option_type:
		NamedType(name, args):
			if name == "Option":
				match args:
					[payload]:
						if stack_option_c_type(payload, {}).is_some():
							None
						else if nullable_managed_option_payload_release_policy(payload).is_some():
							Some(payload)
						else:
							None
					_:
						None
			else:
				None
		_:
			None


-- The runtime-provided stack Option typedefs and specialized operations share
-- this catalog. Int128/UInt128 have C value types but no specialized operations.
pure func stack_option_runtime_suffix(name: String) -> Option[String]:
	if name == "Void":
		Some("void")
	else if name == "Int":
		Some("int")
	else if name == "Int8":
		Some("int8")
	else if name == "Int16":
		Some("int16")
	else if name == "Int32":
		Some("int32")
	else if name == "Int64":
		Some("int64")
	else if name == "UInt8":
		Some("uint8")
	else if name == "UInt16":
		Some("uint16")
	else if name == "UInt32":
		Some("uint32")
	else if name == "UInt64":
		Some("uint64")
	else if name == "Float":
		Some("float")
	else if name == "Float32":
		Some("f32")
	else if name == "Float16":
		Some("f16")
	else if name == "Bool":
		Some("bool")
	else if name == "Char":
		Some("char")
	else:
		None


-- Whether the typedef is provided by the runtime, rather than generated.
pure func runtime_owned_stack_option_payload_name(name: String) -> Bool:
	stack_option_runtime_suffix(name).is_some()


pure func is_closure_abi_prim_name(name: String) -> Bool:
	(
		name == "Int"
		or name == "Int8"
		or name == "Int16"
		or name == "Int32"
		or name == "Int64"
		or name == "UInt8"
		or name == "UInt16"
		or name == "UInt32"
		or name == "UInt64"
		or name == "Bool"
		or name == "Char"
	)


---
`type_symbol_lookup` is the same artifact-local declared-name -> projected-
symbol lookup documented on `stack_option_c_type`; pass `{}` before final
backend emission has a plan to offer.
---
pure func c_type_name(typ: CoreType, type_symbol_lookup: Dict[String, String]) -> String:
	match typ:
		NativeManagedType(_):
			"blorp_String*"
		VoidType:
			"void"
		NamedType(name, args):
			if name == "Option":
				match args:
					[payload]:
						match stack_option_c_type(payload, type_symbol_lookup):
							Some(c_type):
								c_type
							None:
								"void*"
					[]:
						"void*"
					[first, second, ...rest]:
						"void*"
			else if name == "Result":
				match args:
					[ok_type, err_type]:
						"blorp_StackResult"
					[]:
						"void*"
					[only]:
						"void*"
					[first, second, third, ...rest]:
						"void*"
			else if name == "Int":
				"long"
			else if name == "Int8":
				"int8_t"
			else if name == "Int16":
				"int16_t"
			else if name == "Int32":
				"int32_t"
			else if name == "Int64":
				"long"
			else if name == "Int128":
				"__int128"
			else if name == "UInt8":
				"uint8_t"
			else if name == "UInt16":
				"uint16_t"
			else if name == "UInt32":
				"uint32_t"
			else if name == "UInt64":
				"uint64_t"
			else if name == "UInt128":
				"unsigned __int128"
			else if name == "Float":
				"double"
			else if name == "Float32":
				"float"
			else if name == "Float16":
				"_Float16"
			else if name == "Bool":
				"int"
			else if name == "Char":
				"int32_t"
			else if name == "String":
				"blorp_String*"
			else if name == "Bytes":
				"blorp_Bytes*"
			else if name == "FixedPoint":
				"blorp_FixedPoint*"
			else if name == "Closure":
				"blorp_Closure*"
			else if name == "Channel":
				"blorp_Channel*"
			else if name == "ParallelList":
				"blorp_List*"
			else if name == "ParallelVector" or name == "ParallelMatrix":
				"blorp_Vector*"
			else if is_core_resource_source_type_name(name):
				"blorp_ResourceSource*"
			else if is_core_stream_type_name(name):
				"blorp_Stream*"
			else if is_core_fallible_stream_type_name(name):
				"blorp_FallibleStream*"
			else if name == "Port":
				"long"
			else if name == "TcpListener":
				"blorp_TcpListener*"
			else if name == "TcpStream":
				"blorp_TcpStream*"
			-- `UdpSocket` is on `is_global_abi_type_name`, but `net/udp` is not a std
			-- module (it is a `pkg/` module), so ABI bareness does not apply: importers
			-- see `net/udp::UdpSocket`, which flattens to `net_udp__UdpSocket`, and the
			-- declaring module sees the bare name. `TlsSession` and `WebSocketSession`
			-- are not ABI-listed and behave the same way, so all three keep both spellings.
			else if name == "TlsSession" or name == "net_tls__TlsSession":
				"blorp_TlsSession*"
			else if name == "WebSocketSession" or name == "net_websocket__WebSocketSession":
				"blorp_WebSocketSession*"
			else if name == "UdpSocket" or name == "net_udp__UdpSocket":
				"blorp_UdpSocket*"
			else if name == "List":
				"blorp_List*"
			else if name == "Dict" and args.length() == 2:
				"blorp_Dict*"
			else if name == "Set" and args.length() == 1:
				"blorp_Set*"
			else:
				"void*"
		TypeParameterType(_) | SelfType:
			"void*"
		StackResultType(ok_type, err_type):
			"blorp_StackResult"
		BoxedResultType(ok_type, err_type):
			"blorp_Result*"
		FunctionType(_, _, _):
			"blorp_Closure*"
		UnionType(name, ScalarTagValue):
			"long"
		HeapRecordType(name):
			type_symbol_lookup
				.get(name)
				.get_or(name) + "*"
		InlineRecordType(name):
			type_symbol_lookup
				.get(name)
				.get_or(name)
		UnionType(name, ManagedUnionValue):
			type_symbol_lookup
				.get(name)
				.get_or(name) + "*"
		RangeType:
			"long"
		TensorType(info):
			"blorp_Vector*"
		TupleType(items):
			"blorp_Tuple*"


pure func is_void_type(typ: CoreType) -> Bool:
	match typ:
		NativeManagedType(_):
			False
		VoidType:
			True
		NamedType(name, args):
			False
		TypeParameterType(_) | SelfType:
			False
		StackResultType(ok_type, err_type):
			False
		BoxedResultType(ok_type, err_type):
			False
		FunctionType(_, _, _):
			False
		HeapRecordType(name):
			False
		InlineRecordType(name):
			False
		UnionType(name, _):
			False
		RangeType:
			False
		TensorType(info):
			False
		TupleType(items):
			False


pure func type_requires_release(typ: CoreType) -> Bool:
	match typ:
		NativeManagedType(_):
			True
		TupleType(items):
			True
		UnionType(name, ManagedUnionValue):
			True
		VoidType:
			False
		NamedType(name, args):
			name == "Closure" and args.length() == 0
		TypeParameterType(_) | SelfType:
			False
		StackResultType(ok_type, err_type):
			False
		BoxedResultType(ok_type, err_type):
			True
		FunctionType(_, _, _):
			True
		UnionType(name, ScalarTagValue):
			False
		HeapRecordType(name):
			True
		InlineRecordType(name):
			False
		RangeType:
			False
		TensorType(info):
			True


---
Whether a value of `typ` itself carries references its holder must release:
a managed pointer, or a stack Result whose payload slots own objects. This is
a question about the value; where the value is stored in an erased slot, ask
`erased_slot_needs_release_type`, which also counts a box made for the
crossing.
---
pure func boxed_value_needs_release_type(typ: CoreType) -> Bool:
	match typ:
		NativeManagedType(_):
			True
		NamedType(name, args):
			if name == "String" and args.length() == 0:
				True
			else if name == "Bytes" and args.length() == 0:
				True
			else if name == "FixedPoint" and args.length() == 0:
				True
			else if name == "Closure" and args.length() == 0:
				True
			else if name == "List" and args.length() == 1:
				True
			else if name == "Dict" and args.length() == 2:
				True
			else if name == "Set" and args.length() == 1:
				True
			else if name == "Channel" and args.length() == 1:
				True
			else if is_core_resource_source_type_name(name):
				True
			else if is_core_stream_type_name(name) and args.length() == 1:
				True
			else if is_core_fallible_stream_type_name(name) and args.length() == 2:
				True
			else if name == "TcpListener" and args.length() == 0:
				True
			else if name == "TcpStream" and args.length() == 0:
				True
			else if name == "TlsSession" and args.length() == 0:
				True
			else if name == "WebSocketSession" and args.length() == 0:
				True
			else if name == "UdpSocket" and args.length() == 0:
				True
			else if name == "Result" and args.length() == 2:
				True
			else:
				False
		TypeParameterType(_) | SelfType:
			False
		StackResultType(ok_type, err_type):
			True
		BoxedResultType(ok_type, err_type):
			True
		FunctionType(_, _, _):
			True
		HeapRecordType(name):
			True
		InlineRecordType(name):
			-- A struct of scalars owns nothing. The struct box it takes in an
			-- erased slot is the slot's (`erased_slot_holds_owned_box`).
			False
		UnionType(name, ManagedUnionValue):
			True
		TupleType(items):
			True
		TensorType(info):
			True
		VoidType:
			False
		UnionType(name, ScalarTagValue):
			False
		RangeType:
			False


---
Whether a value of `typ` stored in an erased `void*` slot (a task result, for
example) leaves the slot holding an object it must release: the value's own
references, or a box made for the crossing (`erased_slot_holds_owned_box`).

Known fault (DIAGNOSTIC_GAPS CF-019): `Int128` and `UInt128` also cross an
erased slot in an allocated box but are not counted, so a task returning one
leaks its result box.
---
pure func erased_slot_needs_release_type(typ: CoreType) -> Bool:
	erased_slot_holds_owned_box(typ) or boxed_value_needs_release_type(typ)


pure func dict_stored_value_needs_release_type(typ: CoreType) -> Bool:
	match typ:
		NativeManagedType(_):
			True
		StackResultType(ok_type, err_type):
			True
		NamedType(name, args):
			boxed_value_needs_release_type(typ)
		TypeParameterType(_) | SelfType:
			False
		BoxedResultType(ok_type, err_type):
			boxed_value_needs_release_type(typ)
		FunctionType(_, _, _):
			True
		HeapRecordType(name):
			boxed_value_needs_release_type(typ)
		InlineRecordType(name):
			erased_slot_holds_owned_box(typ)
		UnionType(name, ManagedUnionValue):
			boxed_value_needs_release_type(typ)
		TupleType(items):
			boxed_value_needs_release_type(typ)
		TensorType(info):
			boxed_value_needs_release_type(typ)
		VoidType:
			False
		UnionType(name, ScalarTagValue):
			False
		RangeType:
			False


pure func dict_value_needs_release_type(typ: CoreType) -> Bool:
	match typ:
		NativeManagedType(_):
			True
		NamedType(name, args):
			if name == "Dict":
				match args:
					[key_type, value_type]:
						dict_stored_value_needs_release_type(value_type)
					[]:
						False
					[first]:
						False
					[first, second, third, ...rest]:
						False
			else:
				False
		TypeParameterType(_) | SelfType:
			False
		StackResultType(ok_type, err_type):
			False
		BoxedResultType(ok_type, err_type):
			False
		FunctionType(_, _, _):
			False
		HeapRecordType(name):
			False
		InlineRecordType(name):
			False
		UnionType(name, ManagedUnionValue):
			False
		TupleType(items):
			False
		TensorType(info):
			False
		VoidType:
			False
		UnionType(name, ScalarTagValue):
			False
		RangeType:
			False


pure func channel_element_type(typ: CoreType) -> Option[CoreType]:
	match typ:
		NativeManagedType(_):
			None
		NamedType(name, args):
			if name == "Channel":
				match args:
					[elem_type]:
						Some(elem_type)
					[]:
						None
					[first, second, ...rest]:
						None
			else:
				None
		TypeParameterType(_) | SelfType:
			None
		StackResultType(ok_type, err_type):
			None
		BoxedResultType(ok_type, err_type):
			None
		FunctionType(_, _, _):
			None
		VoidType:
			None
		HeapRecordType(name):
			None
		InlineRecordType(name):
			None
		UnionType(name, _):
			None
		RangeType:
			None
		TensorType(info):
			None
		TupleType(items):
			None
