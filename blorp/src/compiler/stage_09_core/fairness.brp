			TraitDecl,
			TypeAliasDecl,
			UnionDecl,
			ValueRecordDecl,
		),
		CoreDictConstruct,
		CoreDictEntry,
		CoreDictLiteralEntry,
		CoreExpr(
			AccessorLiteralMatchExpr,
			AssignExpr,
			BinaryExpr,
			BoxExpr,
			BreakExpr,
			BorrowLetExpr,
			CastExpr,
			CallExpr,
			ClosureCreateExpr,
			ConcurrentlyLoopExpr,
			ConcurrentExpr,
			ConstructorMatchExpr,
			ContinueExpr,
			CooperativeCheckpointExpr,
			DebugBlockExpr,
