private pure func checkpoint_loop_body(loop_loc: CoreSourceLoc, body: CoreExpr) -> CoreExpr:
	if body_starts_with_checkpoint(body):
		body
	else:
		SeqExpr(checkpoint(loop_loc), body)


-- Checkpoints a loop body after its own contents were visited. `None` when the
-- body neither changed nor needed a checkpoint.
private pure func insert_loop_body_checkpoints(
	loop_loc: CoreSourceLoc,
	body: CoreExpr,
) -> Option[CoreExpr]:
	checked_body: CoreExpr = checkpoint_loop_body(
		loop_loc,
		insert_cooperative_checkpoints_expr(body),
	)

	if same_core_expr(checked_body, body):
		None
	else:
		Some(checked_body)


private pure func insert_exprs(exprs: List[CoreExpr]) -> List[CoreExpr]:
	CoreTraverse.map_core_exprs(exprs, insert_cooperative_checkpoints_expr)


private pure func insert_tailrec_list_spread_rebind_checkpoints(
	rebind: CoreTailrecListSpreadRebind,
) -> Option[CoreTailrecListSpreadRebind]:
	inserted_value: CoreExpr = insert_cooperative_checkpoints_expr(rebind.value)

	if same_core_expr(inserted_value, rebind.value):
		None
	else:
		Some({ rebind | value = inserted_value })


private pure func insert_tailrec_list_spread_loop_checkpoints(
	loop: CoreTailrecListSpreadLoop,
	loc: CoreSourceLoc,
) -> Option[CoreTailrecListSpreadLoop]:
	match insert_loop_body_checkpoints(loc, loop.body):
		Some(body):
			Some({ loop | body = body })
		None:
			None


private pure func insert_tuple_element(element: CoreTupleElement) -> Option[CoreTupleElement]:
	match element:
		TuplePrimElement(value):
			inserted: CoreExpr = insert_cooperative_checkpoints_expr(value)

			if same_core_expr(inserted, value):
				None
			else:
				Some(TuplePrimElement(inserted))
		TuplePointerElement(value):
			inserted: CoreExpr = insert_cooperative_checkpoints_expr(value)

			if same_core_expr(inserted, value):
				None
			else:
				Some(TuplePointerElement(inserted))
		TupleStructElement(value, c_type):
			inserted: CoreExpr = insert_cooperative_checkpoints_expr(value)

			if same_core_expr(inserted, value):
				None
			else:
				Some(TupleStructElement(inserted, c_type))
		TupleStackResultElement(value):
			inserted: CoreExpr = insert_cooperative_checkpoints_expr(value)

			if same_core_expr(inserted, value):
				None
			else:
				Some(TupleStackResultElement(inserted))
		TupleVoidElement:
			None
		TupleFloatElement(value):
			inserted: CoreExpr = insert_cooperative_checkpoints_expr(value)

			if same_core_expr(inserted, value):
				None
			else:
				Some(TupleFloatElement(inserted))
		TupleFloat32Element(value):
			inserted: CoreExpr = insert_cooperative_checkpoints_expr(value)

			if same_core_expr(inserted, value):
				None
			else:
				Some(TupleFloat32Element(inserted))
		TupleFloat16Element(value):
			inserted: CoreExpr = insert_cooperative_checkpoints_expr(value)

			if same_core_expr(inserted, value):
				None
			else:
				Some(TupleFloat16Element(inserted))


private pure func insert_tuple_elements(
	elements: List[CoreTupleElement],
) -> Option[List[CoreTupleElement]]:
	insert_list_items(elements, insert_tuple_element)


private pure func insert_boxed_storage_value(
	value: CoreBoxedStorageValue,
) -> Option[CoreBoxedStorageValue]:
	inserted_value: CoreExpr = insert_cooperative_checkpoints_expr(value.value)

	if same_core_expr(inserted_value, value.value):
		None
	else:
		Some({ value | value = inserted_value })


private pure func insert_boxed_storage_values(
	values: List[CoreBoxedStorageValue],
) -> Option[List[CoreBoxedStorageValue]]:
	insert_list_items(values, insert_boxed_storage_value)


private pure func insert_tensor_literal_payload(
	payload: CoreTensorLiteralPayload,
) -> Option[CoreTensorLiteralPayload]:
	match payload:
		TensorRawLiteralPayload(raw):
			inserted_elements: List[CoreExpr] = insert_exprs(raw.elements)

			if same_core_exprs(inserted_elements, raw.elements):
				None
			else:
				Some(TensorRawLiteralPayload({ raw | elements = inserted_elements }))
		TensorInlineStructLiteralPayload(inline_struct):
			inserted_elements: List[CoreExpr] = insert_exprs(inline_struct.elements)

			if same_core_exprs(inserted_elements, inline_struct.elements):
				None
			else:
				Some(
					TensorInlineStructLiteralPayload(
						{ inline_struct | elements = inserted_elements },
					),
				)


private pure func insert_dict_entry(entry: CoreDictEntry) -> Option[CoreDictEntry]:
	inserted_key: Option[CoreBoxedStorageValue] = insert_boxed_storage_value(entry.key)
	inserted_value: Option[CoreBoxedStorageValue] = insert_boxed_storage_value(entry.value)

	if inserted_key.is_none() and inserted_value.is_none():
		None
	else:
		Some({
			key = inserted_key.get_or(entry.key),
			value = inserted_value.get_or(entry.value),
		})


private pure func insert_dict_construct(construct: CoreDictConstruct) -> Option[CoreDictConstruct]:
	match insert_list_items(construct.entries, insert_dict_entry):
		Some(entries):
			Some({ construct | entries = entries })
		None:
			None


private pure func insert_list_construct(construct: CoreListConstruct) -> Option[CoreListConstruct]:
	match insert_boxed_storage_values(construct.elements):
		Some(elements):
			Some({ construct | elements = elements })
		None:
			None


private pure func insert_list_alloc(alloc: CoreListAlloc) -> Option[CoreListAlloc]:
	inserted_capacity: CoreExpr = insert_cooperative_checkpoints_expr(alloc.capacity)

	if same_core_expr(inserted_capacity, alloc.capacity):
		None
	else:
		Some({ alloc | capacity = inserted_capacity })


private pure func insert_list_get(get: CoreListGet) -> Option[CoreListGet]:
	inserted_list: CoreExpr = insert_cooperative_checkpoints_expr(get.list)
	inserted_index: CoreExpr = insert_cooperative_checkpoints_expr(get.index)

	if same_core_expr(inserted_list, get.list) and same_core_expr(inserted_index, get.index):
		None
	else:
		Some({ get |
				list = inserted_list,
				index = inserted_index
			})


