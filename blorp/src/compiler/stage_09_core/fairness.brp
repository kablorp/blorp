private pure func insert_record_fields(
	fields: List[CoreRecordFieldValue],
) -> Option[List[CoreRecordFieldValue]]:
	insert_list_items(fields, insert_record_field)


private pure func insert_record_cow_field(field: CoreRecordCowField) -> Option[CoreRecordCowField]:
	match field.replacement:
		Some(replacement):
			inserted_replacement: CoreExpr = insert_cooperative_checkpoints_expr(replacement)

			if same_core_expr(inserted_replacement, replacement):
				None
			else:
				Some({ field | replacement = Some(inserted_replacement) })
		None:
			None


