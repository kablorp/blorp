	entry: CoreDictLiteralEntry,
) -> Option[CoreDictLiteralEntry]:
	inserted_key: CoreExpr = insert_cooperative_checkpoints_expr(entry.key)
	inserted_value: CoreExpr = insert_cooperative_checkpoints_expr(entry.value)

	if same_core_expr(inserted_key, entry.key) and same_core_expr(inserted_value, entry.value):
