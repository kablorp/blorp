-- Cooperative-fairness checkpoint insertion for the Blorp-owned Core tail.
--
-- Loop bodies must reach the runtime scheduler at bounded intervals. This pass
-- inserts an explicit checkpoint at the start of loop bodies unless one is
-- already present.
import:
	ir:
		CoreConcurrentBinding,
		CoreConcurrentBlock,
		CoreConcurrentlyLoop,
		CoreConstructorLengthMatch,
		CoreConstructorLengthMatchBranch,
		CoreConstructorLengthMatchCase,
		CoreConstructorLengthMatchGeq,
		CoreConstructorLiteralMatch,
		CoreConstructorMatchBody(
			ConstructorMatchBodyExpr,
			ConstructorMatchBodyLength,
			ConstructorMatchBodyLiteral,
		),
		CoreConstructorMatchCase,
		CoreConstructorMatchFallback(
			ConstructorMatchFallbackBindings,
			ConstructorMatchFallbackBody,
			ConstructorMatchFallbackFail,
		),
		CoreDecl(
			EnumDecl,
			FunctionDecl,
			GlobalDecl,
			HeapRecordDecl,
			ImplDecl,
			TraitDecl,
			TypeAliasDecl,
			UnionDecl,
			ValueRecordDecl,
		),
		CoreExpr(
			AccessorLiteralMatchExpr,
			ConcurrentlyLoopExpr,
			ConcurrentExpr,
			ConstructorMatchExpr,
			CooperativeCheckpointExpr,
			ForChannelExpr,
			ForDictExpr,
			ForListExpr,
			ForRangeExpr,
			ForResourceSourceExpr,
			ForSetExpr,
			ForStreamExpr,
			ForStringExpr,
			ForTensorExpr,
			LambdaExpr,
			LengthMatchExpr,
			LiteralMatchExpr,
			LogicalExpr,
			PreClosureConcurrentExpr,
			PreClosureConcurrentlyLoopExpr,
			RawMatchExpr,
			ResourceCleanupExitExpr,
			ResourceScopeExpr,
			SelectExpr,
			SeqExpr,
			TailrecListSpreadLoopExpr,
			TailrecListSpreadRecurExpr,
			TailrecLoopExpr,
			TailrecRecurExpr,
			WhileExpr,
		),
		CoreFunction,
		CoreGlobal,
		CoreLiteralMatchCase,
		CoreLiteralMatchFallback(
			LiteralMatchFallbackBindings,
			LiteralMatchFallbackBody,
			LiteralMatchFallbackFail,
		),
		CoreLogicalOp,
		CoreProgram,
		CoreRawMatchCase,
		CoreSelectArm,
		CoreSelectArmKind(SelectAfterArm, SelectRecvArm, SelectSealedArm),
		CoreSelectRecvArm,
		CoreSourceLoc,
		CoreTailrecListSpreadLoop,
		CoreTailrecListSpreadRebind,
		CoreType(VoidType),
	traverse as CoreTraverse


-- Allocation identity for the reuse rule this pass follows: an inserted child
-- that is the same allocation as its input proves that the input node can be
-- handed back as is, so checkpoint insertion allocates only along the spine to
-- the loop bodies it actually changed. Core is immutable value data, so sharing
-- subtrees between input and output is safe. Bound straight to the runtime
-- primitive for the same bootstrap reason as the matching block in
-- traverse.brp; delete the blocks together and import `memory: same_object`.
foreign:
	private pure func same_core_expr(left: CoreExpr, right: CoreExpr) -> Bool = "blorp_same_object"
	private pure func same_core_exprs(
		left: List[CoreExpr],
		right: List[CoreExpr],
	) -> Bool = "blorp_same_object"


private pure func same_optional_core_expr(left: Option[CoreExpr], right: Option[CoreExpr]) -> Bool:
	match left:
		Some(left_expr):
			match right:
				Some(right_expr):
					same_core_expr(left_expr, right_expr)
				None:
					False
		None:
			right.is_none()


-- Payload helpers below answer `None` for "this value came back unchanged", so
-- a caller keeps its own input instead of allocating an equal copy first. This
-- maps a list with such a helper and answers `None` itself when no item
-- changed, copying the untouched prefix only once an item actually changes.
private pure func insert_list_items[T](
	items: List[T],
	insert_item: pure (T) -> Option[T],
) -> Option[List[T]]:
	var inserted: List[T] = []
	var changed: Bool = False
	var index: Int = 0

	for item in items:
		match insert_item(item):
			Some(inserted_item):
				inserted = if changed:
					inserted.append(inserted_item)
				else:
					items
						.take(index)
						.append(inserted_item)

				changed = True
			None:
				if changed:
					inserted = inserted.append(item)
				else:
					void

		index += 1

	if changed:
		Some(inserted)
	else:
		None


private pure func checkpoint(loc: CoreSourceLoc) -> CoreExpr:
	CooperativeCheckpointExpr(VoidType, loc)


private pure func is_checkpoint_expr(expr: CoreExpr) -> Bool:
	match expr:
		CooperativeCheckpointExpr(_, _):
			True
		_:
			False


private pure func body_starts_with_checkpoint(body: CoreExpr) -> Bool:
	match body:
		CooperativeCheckpointExpr(_, _):
			True
		SeqExpr(first, second):
			is_checkpoint_expr(first)
		_:
			False


private pure func checkpoint_loop_body(loop_loc: CoreSourceLoc, body: CoreExpr) -> CoreExpr:
	if body_starts_with_checkpoint(body):
		body
	else:
		SeqExpr(checkpoint(loop_loc), body)


-- Checkpoints a loop body after its own contents were visited. `None` when the
-- body neither changed nor needed a checkpoint.
private pure func insert_loop_body_checkpoints(
	loop_loc: CoreSourceLoc,
	body: CoreExpr,
) -> Option[CoreExpr]:
	checked_body: CoreExpr = checkpoint_loop_body(
		loop_loc,
		insert_cooperative_checkpoints_expr(body),
	)

	if same_core_expr(checked_body, body):
		None
	else:
		Some(checked_body)


private pure func insert_exprs(exprs: List[CoreExpr]) -> List[CoreExpr]:
	CoreTraverse.map_core_exprs(exprs, insert_cooperative_checkpoints_expr)


private pure func insert_tailrec_list_spread_rebind_checkpoints(
	rebind: CoreTailrecListSpreadRebind,
) -> Option[CoreTailrecListSpreadRebind]:
	inserted_value: CoreExpr = insert_cooperative_checkpoints_expr(rebind.value)

	if same_core_expr(inserted_value, rebind.value):
		None
	else:
		Some({ rebind | value = inserted_value })


private pure func insert_tailrec_list_spread_loop_checkpoints(
	loop: CoreTailrecListSpreadLoop,
	loc: CoreSourceLoc,
) -> Option[CoreTailrecListSpreadLoop]:
	match insert_loop_body_checkpoints(loc, loop.body):
		Some(body):
			Some({ loop | body = body })
		None:
			None


private pure func insert_raw_match_case(match_case: CoreRawMatchCase) -> Option[CoreRawMatchCase]:
	inserted_body: CoreExpr = insert_cooperative_checkpoints_expr(match_case.body)

	if same_core_expr(inserted_body, match_case.body):
		None
	else:
		Some({ match_case | body = inserted_body })


private pure func insert_concurrent_binding_checkpoints(
	binding: CoreConcurrentBinding,
) -> Option[CoreConcurrentBinding]:
	inserted_rhs: CoreExpr = insert_cooperative_checkpoints_expr(binding.rhs)

	if same_core_expr(inserted_rhs, binding.rhs):
		None
	else:
		Some({ binding | rhs = inserted_rhs })


private pure func insert_optional_checkpoints(expr: Option[CoreExpr]) -> Option[CoreExpr]:
	CoreTraverse.map_core_optional_expr(expr, insert_cooperative_checkpoints_expr)


private pure func insert_concurrently_loop_checkpoints(
	loop: CoreConcurrentlyLoop,
	loc: CoreSourceLoc,
) -> Option[CoreConcurrentlyLoop]:
	inserted_iterable: CoreExpr = insert_cooperative_checkpoints_expr(loop.iterable)
	inserted_body: Option[CoreExpr] = insert_loop_body_checkpoints(loc, loop.body)
	inserted_timeout: Option[CoreExpr] = insert_optional_checkpoints(loop.timeout)
	inserted_limit: CoreExpr = insert_cooperative_checkpoints_expr(loop.limit)

	if (
		same_core_expr(inserted_iterable, loop.iterable)
		and inserted_body.is_none()
		and same_optional_core_expr(inserted_timeout, loop.timeout)
		and same_core_expr(inserted_limit, loop.limit)
	):
		None
	else:
		Some({ loop |
				iterable = inserted_iterable,
				body = inserted_body.get_or(loop.body),
				timeout = inserted_timeout,
				limit = inserted_limit
			})


private pure func insert_concurrent_block_checkpoints(
	block: CoreConcurrentBlock,
) -> Option[CoreConcurrentBlock]:
	inserted_bindings: Option[List[CoreConcurrentBinding]] = insert_list_items(
		block.bindings,
		insert_concurrent_binding_checkpoints,
	)
	inserted_body: CoreExpr = insert_cooperative_checkpoints_expr(block.body)
	inserted_timeout: Option[CoreExpr] = insert_optional_checkpoints(block.timeout)

	if (
		inserted_bindings.is_none()
		and same_core_expr(inserted_body, block.body)
		and same_optional_core_expr(inserted_timeout, block.timeout)
	):
		None
	else:
		Some({ block |
				bindings = inserted_bindings.get_or(block.bindings),
				body = inserted_body,
				timeout = inserted_timeout
			})


private pure func insert_select_recv_arm(recv: CoreSelectRecvArm) -> Option[CoreSelectRecvArm]:
	inserted_channel: CoreExpr = insert_cooperative_checkpoints_expr(recv.channel)

	if same_core_expr(inserted_channel, recv.channel):
		None
	else:
		Some({ recv | channel = inserted_channel })


private pure func insert_select_arm_kind(kind: CoreSelectArmKind) -> Option[CoreSelectArmKind]:
	match kind:
		SelectRecvArm(recv):
			match insert_select_recv_arm(recv):
				Some(inserted_recv):
					Some(SelectRecvArm(inserted_recv))
				None:
					None
		SelectSealedArm(channel):
			inserted_channel: CoreExpr = insert_cooperative_checkpoints_expr(channel)

			if same_core_expr(inserted_channel, channel):
				None
			else:
				Some(SelectSealedArm(inserted_channel))
		SelectAfterArm(timeout):
			inserted_timeout: CoreExpr = insert_cooperative_checkpoints_expr(timeout)

			if same_core_expr(inserted_timeout, timeout):
				None
			else:
				Some(SelectAfterArm(inserted_timeout))


private pure func insert_select_arm(
	select_loc: CoreSourceLoc,
	arm: CoreSelectArm,
) -> Option[CoreSelectArm]:
	inserted_kind: Option[CoreSelectArmKind] = insert_select_arm_kind(arm.kind)
	inserted_body: Option[CoreExpr] = insert_loop_body_checkpoints(select_loc, arm.body)

	if inserted_kind.is_none() and inserted_body.is_none():
		None
	else:
		Some({ arm |
				kind = inserted_kind.get_or(arm.kind),
				body = inserted_body.get_or(arm.body)
			})


-- `select` arm bodies are scheduler suspension points like loop bodies, so
-- they get the same leading-checkpoint treatment; nothing else about
-- `SelectExpr` needs bespoke handling.
private pure func insert_select_checkpoints(expr: CoreExpr) -> CoreExpr:
	match expr:
		SelectExpr(select_expr, typ, loc):
			match insert_list_items(select_expr, func(arm): insert_select_arm(loc, arm)):
				Some(arms):
					SelectExpr(arms, typ, loc)
				None:
					expr
		_:
			expr


private pure func insert_literal_match_case(
	match_case: CoreLiteralMatchCase,
) -> Option[CoreLiteralMatchCase]:
	inserted_body: CoreExpr = insert_cooperative_checkpoints_expr(match_case.body)

	if same_core_expr(inserted_body, match_case.body):
		None
	else:
		Some({ match_case | body = inserted_body })


private pure func insert_literal_match_cases(
	cases: List[CoreLiteralMatchCase],
) -> Option[List[CoreLiteralMatchCase]]:
	insert_list_items(cases, insert_literal_match_case)


private pure func insert_literal_match_fallback(
	fallback: CoreLiteralMatchFallback,
) -> Option[CoreLiteralMatchFallback]:
	match fallback:
		LiteralMatchFallbackBody(body):
			inserted_body: CoreExpr = insert_cooperative_checkpoints_expr(body)

			if same_core_expr(inserted_body, body):
				None
			else:
				Some(LiteralMatchFallbackBody(inserted_body))
		LiteralMatchFallbackBindings(bindings, body):
			inserted_body: CoreExpr = insert_cooperative_checkpoints_expr(body)

			if same_core_expr(inserted_body, body):
				None
			else:
				Some(LiteralMatchFallbackBindings(bindings, inserted_body))
		LiteralMatchFallbackFail:
			None


private pure func insert_constructor_literal_match(
	match_expr: CoreConstructorLiteralMatch,
) -> Option[CoreConstructorLiteralMatch]:
	inserted_cases: Option[List[CoreLiteralMatchCase]] = insert_literal_match_cases(
		match_expr.cases,
	)
	inserted_fallback: Option[CoreLiteralMatchFallback] = insert_literal_match_fallback(
		match_expr.fallback,
	)

	if inserted_cases.is_none() and inserted_fallback.is_none():
		None
	else:
		Some({ match_expr |
				cases = inserted_cases.get_or(match_expr.cases),
				fallback = inserted_fallback.get_or(match_expr.fallback)
			})


private pure func insert_constructor_length_match_branch(
	branch: CoreConstructorLengthMatchBranch,
) -> Option[CoreConstructorLengthMatchBranch]:
	match insert_constructor_match_body(branch.body):
		Some(body):
			Some({ branch | body = body })
		None:
			None


private pure func insert_constructor_length_match_case(
	match_case: CoreConstructorLengthMatchCase,
) -> Option[CoreConstructorLengthMatchCase]:
	match insert_constructor_length_match_branch(match_case.branch):
		Some(branch):
			Some({ match_case | branch = branch })
		None:
			None


-- `None` also covers an absent case, so the caller keeps its input either way.
private pure func insert_constructor_length_match_geq(
	geq_case: Option[CoreConstructorLengthMatchGeq],
) -> Option[CoreConstructorLengthMatchGeq]:
	match geq_case:
		Some(existing_case):
			match insert_constructor_length_match_branch(existing_case.branch):
				Some(branch):
					Some({ existing_case | branch = branch })
				None:
					None
		None:
			None


private pure func insert_constructor_length_match_fallback(
	fallback: Option[CoreConstructorLengthMatchBranch],
) -> Option[CoreConstructorLengthMatchBranch]:
	match fallback:
		Some(branch):
			insert_constructor_length_match_branch(branch)
		None:
			None


private pure func insert_constructor_length_match(
	match_expr: CoreConstructorLengthMatch,
) -> Option[CoreConstructorLengthMatch]:
	inserted_cases: Option[List[CoreConstructorLengthMatchCase]] = insert_list_items(
		match_expr.cases,
		insert_constructor_length_match_case,
	)
	inserted_geq: Option[CoreConstructorLengthMatchGeq] = insert_constructor_length_match_geq(
		match_expr.geq,
	)
	inserted_fallback: Option[CoreConstructorLengthMatchBranch] = insert_constructor_length_match_fallback(
		match_expr.fallback,
	)

	if (
		inserted_cases.is_none()
		and inserted_geq.is_none()
		and inserted_fallback.is_none()
	):
		None
	else:
		geq: Option[CoreConstructorLengthMatchGeq] = if inserted_geq.is_some():
			inserted_geq
		else:
			match_expr.geq

		fallback: Option[CoreConstructorLengthMatchBranch] = if inserted_fallback.is_some():
			inserted_fallback
		else:
			match_expr.fallback

		Some({ match_expr |
				cases = inserted_cases.get_or(match_expr.cases),
				geq = geq,
				fallback = fallback
			})


private pure func insert_constructor_match_body(
	body: CoreConstructorMatchBody,
) -> Option[CoreConstructorMatchBody]:
	match body:
		ConstructorMatchBodyExpr(expr):
			inserted: CoreExpr = insert_cooperative_checkpoints_expr(expr)

			if same_core_expr(inserted, expr):
				None
			else:
				Some(ConstructorMatchBodyExpr(inserted))
		ConstructorMatchBodyLiteral(match_expr):
			match insert_constructor_literal_match(match_expr):
				Some(inserted):
					Some(ConstructorMatchBodyLiteral(inserted))
				None:
					None
		ConstructorMatchBodyLength(match_expr):
			match insert_constructor_length_match(match_expr):
				Some(inserted):
					Some(ConstructorMatchBodyLength(inserted))
				None:
					None


private pure func insert_constructor_match_case(
	match_case: CoreConstructorMatchCase,
) -> Option[CoreConstructorMatchCase]:
	match insert_constructor_match_body(match_case.body):
		Some(body):
			Some({ match_case | body = body })
		None:
			None


private pure func insert_constructor_match_fallback(
	fallback: CoreConstructorMatchFallback,
) -> Option[CoreConstructorMatchFallback]:
	match fallback:
		ConstructorMatchFallbackBody(body):
			inserted_body: CoreExpr = insert_cooperative_checkpoints_expr(body)

			if same_core_expr(inserted_body, body):
				None
			else:
				Some(ConstructorMatchFallbackBody(inserted_body))
		ConstructorMatchFallbackBindings(bindings, body):
			inserted_body: CoreExpr = insert_cooperative_checkpoints_expr(body)

			if same_core_expr(inserted_body, body):
				None
			else:
				Some(ConstructorMatchFallbackBindings(bindings, inserted_body))
		ConstructorMatchFallbackFail:
			None


-- Every arm visits its children exactly as it always has and answers `expr`
-- itself when every visited child and child container came back as the same
-- allocation; only a loop body that gained a checkpoint builds new nodes, and
-- only along the spine above it.
--
-- `WhileExpr` is handled directly since it is the one operator-family form
-- that inserts a checkpoint; `SelectExpr` arm bodies are suspension points
-- like loop bodies and get the same treatment via `insert_select_checkpoints`.
-- Every other node kind that merely carries children without needing a
-- checkpoint of its own falls through to the shared Core traversal.
pure func insert_cooperative_checkpoints_expr(expr: CoreExpr) -> CoreExpr:
	match expr:
		LogicalExpr(_, _, _, _, _):
			CoreTraverse.map_core_logical_tree(expr, insert_cooperative_checkpoints_expr)
		WhileExpr(cond, body, typ, loc):
			inserted_body: Option[CoreExpr] = insert_loop_body_checkpoints(loc, body)
			inserted_cond: CoreExpr = insert_cooperative_checkpoints_expr(cond)

			if inserted_body.is_none() and same_core_expr(inserted_cond, cond):
				expr
			else:
				WhileExpr(
					inserted_cond,
					inserted_body.get_or(body),
					typ,
					loc,
				)
		LambdaExpr(_, _, _, _, _, _) | TailrecLoopExpr(_, _, _, _) | TailrecRecurExpr(_, _, _) | TailrecListSpreadLoopExpr(_, _) | TailrecListSpreadRecurExpr(_, _, _, _) | ForRangeExpr(_, _, _, _, _, _) | ForChannelExpr(_, _, _) | ForListExpr(_, _, _) | ForStringExpr(_, _, _) | ForDictExpr(_, _, _) | ForSetExpr(_, _, _) | ForStreamExpr(_, _, _) | ForResourceSourceExpr(_, _, _) | ForTensorExpr(_, _, _) | ResourceScopeExpr(_, _, _) | ResourceCleanupExitExpr(_, _, _):
			insert_loop_checkpoints(expr)
		PreClosureConcurrentlyLoopExpr(_, _, _) | ConcurrentlyLoopExpr(_, _, _) | PreClosureConcurrentExpr(_, _, _) | ConcurrentExpr(_, _, _):
			insert_concurrency_checkpoints(expr)
		SelectExpr(_, _, _):
			insert_select_checkpoints(expr)
		RawMatchExpr(_, _, _, _) | LiteralMatchExpr(_, _, _, _, _) | AccessorLiteralMatchExpr(_, _, _, _, _) | LengthMatchExpr(_, _, _, _, _) | ConstructorMatchExpr(_, _, _, _, _, _):
			insert_match_checkpoints(expr)
		_:
			CoreTraverse.map_core_expr_children(expr, insert_cooperative_checkpoints_expr)


private pure func inserted_for_loop_children(
	loop_loc: CoreSourceLoc,
	iterable: CoreExpr,
	body: CoreExpr,
) -> Option[(CoreExpr, CoreExpr)]:
	inserted_body: Option[CoreExpr] = insert_loop_body_checkpoints(loop_loc, body)
	inserted_iterable: CoreExpr = insert_cooperative_checkpoints_expr(iterable)

	if inserted_body.is_none() and same_core_expr(inserted_iterable, iterable):
		None
	else:
		Some((inserted_iterable, inserted_body.get_or(body)))


-- Lambdas, tail-recursive loops, `for` loops, and resource scopes. Loop bodies
-- gain a leading checkpoint unless they already start with one.
private pure func insert_loop_checkpoints(expr: CoreExpr) -> CoreExpr:
	match expr:
		LambdaExpr(lambda_params, lambda_return_type, lambda_body, lambda_is_pure, typ, loc):
			inserted_body: CoreExpr = insert_cooperative_checkpoints_expr(lambda_body)

			if same_core_expr(inserted_body, lambda_body):
				expr
			else:
				LambdaExpr(
					lambda_params,
					lambda_return_type,
					inserted_body,
					lambda_is_pure,
					typ,
					loc,
				)
		TailrecLoopExpr(params, return_type, body, loc):
			match insert_loop_body_checkpoints(loc, body):
				Some(checked_body):
					TailrecLoopExpr(params, return_type, checked_body, loc)
				None:
					expr
		TailrecRecurExpr(args, typ, loc):
			inserted_args: List[CoreExpr] = insert_exprs(args)

			if same_core_exprs(inserted_args, args):
				expr
			else:
				TailrecRecurExpr(inserted_args, typ, loc)
		TailrecListSpreadLoopExpr(loop, loc):
			match insert_tailrec_list_spread_loop_checkpoints(loop, loc):
				Some(inserted_loop):
					TailrecListSpreadLoopExpr(inserted_loop, loc)
				None:
					expr
		TailrecListSpreadRecurExpr(rebinds, cursor_advance, typ, loc):
			match insert_list_items(rebinds, insert_tailrec_list_spread_rebind_checkpoints):
				Some(inserted_rebinds):
					TailrecListSpreadRecurExpr(inserted_rebinds, cursor_advance, typ, loc)
				None:
					expr
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			inserted_body: Option[CoreExpr] = insert_loop_body_checkpoints(loc, body)
			inserted_start: CoreExpr = insert_cooperative_checkpoints_expr(start)
			inserted_end: CoreExpr = insert_cooperative_checkpoints_expr(end_value)

			if (
				inserted_body.is_none()
				and same_core_expr(inserted_start, start)
				and same_core_expr(inserted_end, end_value)
			):
				expr
			else:
				ForRangeExpr(
					binder,
					inserted_start,
					inserted_end,
					inserted_body.get_or(body),
					typ,
					loc,
				)
		ForChannelExpr(for_channel, typ, loc):
			match inserted_for_loop_children(loc, for_channel.iterable, for_channel.body):
				Some((iterable, body)):
					ForChannelExpr(
						{ for_channel |
							iterable = iterable,
							body = body
						},
						typ,
						loc,
					)
				None:
					expr
		ForListExpr(for_list, typ, loc):
			match inserted_for_loop_children(loc, for_list.iterable, for_list.body):
				Some((iterable, body)):
					ForListExpr(
						{ for_list |
							iterable = iterable,
							body = body
						},
						typ,
						loc,
					)
				None:
					expr
		ForStringExpr(for_string, typ, loc):
			match inserted_for_loop_children(loc, for_string.iterable, for_string.body):
				Some((iterable, body)):
					ForStringExpr(
						{ for_string |
							iterable = iterable,
							body = body
						},
						typ,
						loc,
					)
				None:
					expr
		ForDictExpr(for_dict, typ, loc):
			match inserted_for_loop_children(loc, for_dict.iterable, for_dict.body):
				Some((iterable, body)):
					ForDictExpr(
						{ for_dict |
							iterable = iterable,
							body = body
						},
						typ,
						loc,
					)
				None:
					expr
		ForSetExpr(for_set, typ, loc):
			match inserted_for_loop_children(loc, for_set.iterable, for_set.body):
				Some((iterable, body)):
					ForSetExpr(
						{ for_set |
							iterable = iterable,
							body = body
						},
						typ,
						loc,
					)
				None:
					expr
		ForResourceSourceExpr(for_resource_source, typ, loc):
			match inserted_for_loop_children(
				loc,
				for_resource_source.iterable,
				for_resource_source.body,
			):
				Some((iterable, body)):
					ForResourceSourceExpr(
						{ for_resource_source |
							iterable = iterable,
							body = body
						},
						typ,
						loc,
					)
				None:
					expr
		ForStreamExpr(for_stream, typ, loc):
			match inserted_for_loop_children(loc, for_stream.iterable, for_stream.body):
				Some((iterable, body)):
					ForStreamExpr(
						{ for_stream |
							iterable = iterable,
							body = body
						},
						typ,
						loc,
					)
				None:
					expr
		ForTensorExpr(for_tensor, typ, loc):
			match inserted_for_loop_children(loc, for_tensor.iterable, for_tensor.body):
				Some((iterable, body)):
					ForTensorExpr(
						{ for_tensor |
							iterable = iterable,
							body = body
						},
						typ,
						loc,
					)
				None:
					expr
		ResourceScopeExpr(scope, typ, loc):
			inserted_acquire: CoreExpr = insert_cooperative_checkpoints_expr(scope.acquire)
			inserted_body: CoreExpr = insert_cooperative_checkpoints_expr(scope.body)
			inserted_cleanup: CoreExpr = insert_cooperative_checkpoints_expr(scope.cleanup)

			if (
				same_core_expr(inserted_acquire, scope.acquire)
				and same_core_expr(inserted_body, scope.body)
				and same_core_expr(inserted_cleanup, scope.cleanup)
			):
				expr
			else:
				ResourceScopeExpr(
					{ scope |
						acquire = inserted_acquire,
						body = inserted_body,
						cleanup = inserted_cleanup
					},
					typ,
					loc,
				)
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			inserted_cleanups: List[CoreExpr] = insert_exprs(cleanup_exit.cleanups)

			if same_core_exprs(inserted_cleanups, cleanup_exit.cleanups):
				expr
			else:
				ResourceCleanupExitExpr({ cleanup_exit | cleanups = inserted_cleanups }, typ, loc)
		_:
			expr


-- Structured-concurrency blocks and loops, before and after closure formation.
private pure func insert_concurrency_checkpoints(expr: CoreExpr) -> CoreExpr:
	match expr:
		PreClosureConcurrentlyLoopExpr(loop, typ, loc):
			inserted_iterable: CoreExpr = insert_cooperative_checkpoints_expr(loop.iterable)
			inserted_body: Option[CoreExpr] = insert_loop_body_checkpoints(loc, loop.body)
			inserted_timeout: Option[CoreExpr] = insert_optional_checkpoints(loop.timeout)
			inserted_limit: CoreExpr = insert_cooperative_checkpoints_expr(loop.limit)

			if (
				same_core_expr(inserted_iterable, loop.iterable)
				and inserted_body.is_none()
				and same_optional_core_expr(inserted_timeout, loop.timeout)
				and same_core_expr(inserted_limit, loop.limit)
			):
				expr
			else:
				PreClosureConcurrentlyLoopExpr(
					{ loop |
						iterable = inserted_iterable,
						body = inserted_body.get_or(loop.body),
						timeout = inserted_timeout,
						limit = inserted_limit
					},
					typ,
					loc,
				)
		ConcurrentlyLoopExpr(loop, typ, loc):
			match insert_concurrently_loop_checkpoints(loop, loc):
				Some(inserted_loop):
					ConcurrentlyLoopExpr(inserted_loop, typ, loc)
				None:
					expr
		PreClosureConcurrentExpr(block, typ, loc):
			inserted_body: CoreExpr = insert_cooperative_checkpoints_expr(block.body)
			inserted_timeout: Option[CoreExpr] = insert_optional_checkpoints(block.timeout)

			if (
				same_core_expr(inserted_body, block.body)
				and same_optional_core_expr(inserted_timeout, block.timeout)
			):
				expr
			else:
				PreClosureConcurrentExpr(
					{ block |
						body = inserted_body,
						timeout = inserted_timeout
					},
					typ,
					loc,
				)
		ConcurrentExpr(block, typ, loc):
			match insert_concurrent_block_checkpoints(block):
				Some(inserted_block):
					ConcurrentExpr(inserted_block, typ, loc)
				None:
					expr
		_:
			expr


-- The match forms. Semantic matches already go through the shared traversal,
-- which applies the same reuse rule.
private pure func insert_match_checkpoints(expr: CoreExpr) -> CoreExpr:
	match expr:
		RawMatchExpr(scrutinee, cases, typ, loc):
			inserted_scrutinee: CoreExpr = insert_cooperative_checkpoints_expr(scrutinee)
			inserted_cases: Option[List[CoreRawMatchCase]] = insert_list_items(
				cases,
				insert_raw_match_case,
			)

			if same_core_expr(inserted_scrutinee, scrutinee) and inserted_cases.is_none():
				expr
			else:
				RawMatchExpr(
					inserted_scrutinee,
					inserted_cases.get_or(cases),
					typ,
					loc,
				)
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			inserted_scrutinee: CoreExpr = insert_cooperative_checkpoints_expr(scrutinee)
			inserted_cases: Option[List[CoreLiteralMatchCase]] = insert_literal_match_cases(cases)
			inserted_fallback: Option[CoreLiteralMatchFallback] = insert_literal_match_fallback(
				fallback,
			)

			if (
				same_core_expr(inserted_scrutinee, scrutinee)
				and inserted_cases.is_none()
				and inserted_fallback.is_none()
			):
				expr
			else:
				LiteralMatchExpr(
					inserted_scrutinee,
					inserted_cases.get_or(cases),
					inserted_fallback.get_or(fallback),
					typ,
					loc,
				)
		AccessorLiteralMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			inserted_scrutinee: CoreExpr = insert_cooperative_checkpoints_expr(scrutinee)
			inserted_match: Option[CoreConstructorLiteralMatch] = insert_constructor_literal_match(
				match_expr,
			)

			if same_core_expr(inserted_scrutinee, scrutinee) and inserted_match.is_none():
				expr
			else:
				AccessorLiteralMatchExpr(
					inserted_scrutinee,
					scrutinee_release_policy,
					inserted_match.get_or(match_expr),
					typ,
					loc,
				)
		LengthMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			inserted_scrutinee: CoreExpr = insert_cooperative_checkpoints_expr(scrutinee)
			inserted_match: Option[CoreConstructorLengthMatch] = insert_constructor_length_match(
				match_expr,
			)

			if same_core_expr(inserted_scrutinee, scrutinee) and inserted_match.is_none():
				expr
			else:
				LengthMatchExpr(
					inserted_scrutinee,
					scrutinee_release_policy,
					inserted_match.get_or(match_expr),
					typ,
					loc,
				)
		ConstructorMatchExpr(scrutinee, scrutinee_release_policy, cases, fallback, typ, loc):
			inserted_scrutinee: CoreExpr = insert_cooperative_checkpoints_expr(scrutinee)
			inserted_cases: Option[List[CoreConstructorMatchCase]] = insert_list_items(
				cases,
				insert_constructor_match_case,
			)
			inserted_fallback: Option[CoreConstructorMatchFallback] = insert_constructor_match_fallback(
				fallback,
			)

			if (
				same_core_expr(inserted_scrutinee, scrutinee)
				and inserted_cases.is_none()
				and inserted_fallback.is_none()
			):
				expr
			else:
				ConstructorMatchExpr(
					inserted_scrutinee,
					scrutinee_release_policy,
					inserted_cases.get_or(cases),
					inserted_fallback.get_or(fallback),
					typ,
					loc,
				)
		_:
			expr


private pure func insert_function(func_info: CoreFunction) -> CoreFunction:
	match func_info.body:
		Some(body):
			inserted_body: CoreExpr = insert_cooperative_checkpoints_expr(body)

			if same_core_expr(inserted_body, body):
				func_info
			else:
				{ func_info | body = Some(inserted_body) }
		None:
			func_info


private pure func insert_decl(decl: CoreDecl) -> CoreDecl:
	match decl:
		FunctionDecl(func_info):
			FunctionDecl(insert_function(func_info))
		GlobalDecl(global):
			GlobalDecl({ global | init = insert_cooperative_checkpoints_expr(global.init) })
		EnumDecl(enum_decl):
			EnumDecl(enum_decl)
		UnionDecl(union_decl):
			UnionDecl(union_decl)
		ValueRecordDecl(record_decl):
			ValueRecordDecl(record_decl)
		HeapRecordDecl(record_decl):
			HeapRecordDecl(record_decl)
		TypeAliasDecl(alias_decl):
			TypeAliasDecl(alias_decl)
		TraitDecl(trait_decl):
			TraitDecl(trait_decl)
		ImplDecl(impl_decl):
			ImplDecl({ impl_decl | methods = impl_decl.methods.map(insert_function) })


pure func insert_cooperative_checkpoints(program: CoreProgram) -> CoreProgram:
	{
		decls = program.decls.map(func(decl): insert_decl(decl)),
		foreign_includes = program.foreign_includes
	}
