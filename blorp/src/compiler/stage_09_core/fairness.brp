	inserted_body: CoreExpr = insert_cooperative_checkpoints_expr(match_case.body)

	if same_core_expr(inserted_body, match_case.body):
		None
	else:
		Some({ match_case | body = inserted_body })


private pure func insert_concurrent_binding_checkpoints(
	binding: CoreConcurrentBinding,
) -> Option[CoreConcurrentBinding]:
	inserted_rhs: CoreExpr = insert_cooperative_checkpoints_expr(binding.rhs)

	if same_core_expr(inserted_rhs, binding.rhs):
		None
	else:
		Some({ binding | rhs = inserted_rhs })


private pure func insert_optional_checkpoints(expr: Option[CoreExpr]) -> Option[CoreExpr]:
	CoreTraverse.map_core_optional_expr(expr, insert_cooperative_checkpoints_expr)


private pure func insert_concurrently_loop_checkpoints(
	loop: CoreConcurrentlyLoop,
	loc: CoreSourceLoc,
) -> Option[CoreConcurrentlyLoop]:
	inserted_iterable: CoreExpr = insert_cooperative_checkpoints_expr(loop.iterable)
	inserted_body: Option[CoreExpr] = insert_loop_body_checkpoints(loc, loop.body)
	inserted_timeout: Option[CoreExpr] = insert_optional_checkpoints(loop.timeout)
	inserted_limit: CoreExpr = insert_cooperative_checkpoints_expr(loop.limit)

	if (
		same_core_expr(inserted_iterable, loop.iterable)
		and inserted_body.is_none()
		and same_optional_core_expr(inserted_timeout, loop.timeout)
		and same_core_expr(inserted_limit, loop.limit)
	):
		None
	else:
		Some({ loop |
				iterable = inserted_iterable,
				body = inserted_body.get_or(loop.body),
				timeout = inserted_timeout,
				limit = inserted_limit
			})


private pure func insert_concurrent_block_checkpoints(
	block: CoreConcurrentBlock,
) -> Option[CoreConcurrentBlock]:
	inserted_bindings: Option[List[CoreConcurrentBinding]] = insert_list_items(
		block.bindings,
		insert_concurrent_binding_checkpoints,
	)
	inserted_body: CoreExpr = insert_cooperative_checkpoints_expr(block.body)
	inserted_timeout: Option[CoreExpr] = insert_optional_checkpoints(block.timeout)

	if (
		inserted_bindings.is_none()
		and same_core_expr(inserted_body, block.body)
		and same_optional_core_expr(inserted_timeout, block.timeout)
	):
		None
	else:
		Some({ block |
				bindings = inserted_bindings.get_or(block.bindings),
				body = inserted_body,
				timeout = inserted_timeout
			})


private pure func insert_select_recv_arm(recv: CoreSelectRecvArm) -> Option[CoreSelectRecvArm]:
	inserted_channel: CoreExpr = insert_cooperative_checkpoints_expr(recv.channel)

	if same_core_expr(inserted_channel, recv.channel):
		None
	else:
		Some({ recv | channel = inserted_channel })


private pure func insert_select_arm_kind(kind: CoreSelectArmKind) -> Option[CoreSelectArmKind]:
	match kind:
		SelectRecvArm(recv):
			match insert_select_recv_arm(recv):
				Some(inserted_recv):
					Some(SelectRecvArm(inserted_recv))
				None:
					None
		SelectSealedArm(channel):
			inserted_channel: CoreExpr = insert_cooperative_checkpoints_expr(channel)

			if same_core_expr(inserted_channel, channel):
				None
			else:
				Some(SelectSealedArm(inserted_channel))
		SelectAfterArm(timeout):
			inserted_timeout: CoreExpr = insert_cooperative_checkpoints_expr(timeout)

			if same_core_expr(inserted_timeout, timeout):
				None
			else:
				Some(SelectAfterArm(inserted_timeout))


private pure func insert_select_arm(
	select_loc: CoreSourceLoc,
	arm: CoreSelectArm,
) -> Option[CoreSelectArm]:
	inserted_kind: Option[CoreSelectArmKind] = insert_select_arm_kind(arm.kind)
	inserted_body: Option[CoreExpr] = insert_loop_body_checkpoints(select_loc, arm.body)

	if inserted_kind.is_none() and inserted_body.is_none():
		None
	else:
		Some({ arm |
				kind = inserted_kind.get_or(arm.kind),
				body = inserted_body.get_or(arm.body)
			})


private pure func insert_literal_match_case(
	match_case: CoreLiteralMatchCase,
) -> Option[CoreLiteralMatchCase]:
	inserted_body: CoreExpr = insert_cooperative_checkpoints_expr(match_case.body)

	if same_core_expr(inserted_body, match_case.body):
		None
	else:
		Some({ match_case | body = inserted_body })


private pure func insert_literal_match_cases(
	cases: List[CoreLiteralMatchCase],
) -> Option[List[CoreLiteralMatchCase]]:
	insert_list_items(cases, insert_literal_match_case)


private pure func insert_literal_match_fallback(
	fallback: CoreLiteralMatchFallback,
) -> Option[CoreLiteralMatchFallback]:
	match fallback:
		LiteralMatchFallbackBody(body):
			inserted_body: CoreExpr = insert_cooperative_checkpoints_expr(body)

			if same_core_expr(inserted_body, body):
				None
			else:
				Some(LiteralMatchFallbackBody(inserted_body))
		LiteralMatchFallbackBindings(bindings, body):
			inserted_body: CoreExpr = insert_cooperative_checkpoints_expr(body)

			if same_core_expr(inserted_body, body):
				None
			else:
				Some(LiteralMatchFallbackBindings(bindings, inserted_body))
		LiteralMatchFallbackFail:
			None


private pure func insert_constructor_literal_match(
	match_expr: CoreConstructorLiteralMatch,
) -> Option[CoreConstructorLiteralMatch]:
	inserted_cases: Option[List[CoreLiteralMatchCase]] = insert_literal_match_cases(
		match_expr.cases,
	)
	inserted_fallback: Option[CoreLiteralMatchFallback] = insert_literal_match_fallback(
		match_expr.fallback,
	)

	if inserted_cases.is_none() and inserted_fallback.is_none():
		None
	else:
		Some({ match_expr |
				cases = inserted_cases.get_or(match_expr.cases),
				fallback = inserted_fallback.get_or(match_expr.fallback)
			})


private pure func insert_constructor_length_match_branch(
	branch: CoreConstructorLengthMatchBranch,
) -> Option[CoreConstructorLengthMatchBranch]:
	match insert_constructor_match_body(branch.body):
		Some(body):
			Some({ branch | body = body })
		None:
			None


private pure func insert_constructor_length_match_case(
	match_case: CoreConstructorLengthMatchCase,
) -> Option[CoreConstructorLengthMatchCase]:
	match insert_constructor_length_match_branch(match_case.branch):
		Some(branch):
			Some({ match_case | branch = branch })
		None:
			None


-- `None` also covers an absent case, so the caller keeps its input either way.
private pure func insert_constructor_length_match_geq(
	geq_case: Option[CoreConstructorLengthMatchGeq],
) -> Option[CoreConstructorLengthMatchGeq]:
	match geq_case:
		Some(existing_case):
			match insert_constructor_length_match_branch(existing_case.branch):
				Some(branch):
					Some({ existing_case | branch = branch })
				None:
					None
		None:
			None


private pure func insert_constructor_length_match_fallback(
	fallback: Option[CoreConstructorLengthMatchBranch],
) -> Option[CoreConstructorLengthMatchBranch]:
	match fallback:
		Some(branch):
			insert_constructor_length_match_branch(branch)
		None:
			None


private pure func insert_constructor_length_match(
	match_expr: CoreConstructorLengthMatch,
) -> Option[CoreConstructorLengthMatch]:
	inserted_cases: Option[List[CoreConstructorLengthMatchCase]] = insert_list_items(
		match_expr.cases,
		insert_constructor_length_match_case,
	)
	inserted_geq: Option[CoreConstructorLengthMatchGeq] = insert_constructor_length_match_geq(
		match_expr.geq,
	)
	inserted_fallback: Option[CoreConstructorLengthMatchBranch] = insert_constructor_length_match_fallback(
		match_expr.fallback,
	)

	if (
		inserted_cases.is_none()
		and inserted_geq.is_none()
		and inserted_fallback.is_none()
	):
		None
	else:
		geq: Option[CoreConstructorLengthMatchGeq] = if inserted_geq.is_some():
			inserted_geq
		else:
			match_expr.geq

		fallback: Option[CoreConstructorLengthMatchBranch] = if inserted_fallback.is_some():
			inserted_fallback
		else:
			match_expr.fallback

		Some({ match_expr |
				cases = inserted_cases.get_or(match_expr.cases),
				geq = geq,
				fallback = fallback
			})


private pure func insert_constructor_match_body(
	body: CoreConstructorMatchBody,
) -> Option[CoreConstructorMatchBody]:
	match body:
		ConstructorMatchBodyExpr(expr):
			inserted: CoreExpr = insert_cooperative_checkpoints_expr(expr)

			if same_core_expr(inserted, expr):
				None
			else:
				Some(ConstructorMatchBodyExpr(inserted))
		ConstructorMatchBodyLiteral(match_expr):
			match insert_constructor_literal_match(match_expr):
				Some(inserted):
					Some(ConstructorMatchBodyLiteral(inserted))
				None:
					None
		ConstructorMatchBodyLength(match_expr):
			match insert_constructor_length_match(match_expr):
				Some(inserted):
					Some(ConstructorMatchBodyLength(inserted))
				None:
					None


private pure func insert_constructor_match_case(
	match_case: CoreConstructorMatchCase,
) -> Option[CoreConstructorMatchCase]:
	match insert_constructor_match_body(match_case.body):
		Some(body):
			Some({ match_case | body = body })
		None:
			None


private pure func insert_constructor_match_cases(
	cases: List[CoreConstructorMatchCase],
) -> Option[List[CoreConstructorMatchCase]]:
	insert_list_items(cases, insert_constructor_match_case)


private pure func insert_constructor_match_fallback(
	fallback: CoreConstructorMatchFallback,
) -> Option[CoreConstructorMatchFallback]:
	match fallback:
		ConstructorMatchFallbackBody(body):
			inserted_body: CoreExpr = insert_cooperative_checkpoints_expr(body)

			if same_core_expr(inserted_body, body):
				None
			else:
				Some(ConstructorMatchFallbackBody(inserted_body))
		ConstructorMatchFallbackBindings(bindings, body):
			inserted_body: CoreExpr = insert_cooperative_checkpoints_expr(body)

			if same_core_expr(inserted_body, body):
				None
			else:
				Some(ConstructorMatchFallbackBindings(bindings, inserted_body))
		ConstructorMatchFallbackFail:
			None


private union FairnessLogicalTask:
	InsertFairnessLogicalNode(CoreExpr)
	RebuildFairnessLogicalNode(CoreExpr)


-- Long `and`/`or` chains form deep Core trees; walk them iteratively. The
-- rebuild task carries the source node so an unchanged pair of sides hands
-- that node back instead of an equal copy.
private pure func insert_logical_checkpoints(expr: CoreExpr) -> CoreExpr:
	var tasks: List[FairnessLogicalTask] = [InsertFairnessLogicalNode(expr)]
	var task_count: Int = 1
	var inserted: List[CoreExpr] = []
	var inserted_count: Int = 0
	var valid: Bool = True

	while valid and task_count > 0:
		task_count -= 1

		match tasks.get(task_count):
			Some(task):
				match task:
					InsertFairnessLogicalNode(current_expr):
						match current_expr:
							LogicalExpr(op, left, right, typ, loc):
								rebuild_task: FairnessLogicalTask = RebuildFairnessLogicalNode(
									current_expr,
								)

								tasks = if task_count < tasks.length():
									tasks.set(task_count, rebuild_task)
								else:
									tasks.append(rebuild_task)

								task_count += 1

								right_task: FairnessLogicalTask = InsertFairnessLogicalNode(right)

								tasks = if task_count < tasks.length():
									tasks.set(task_count, right_task)
								else:
									tasks.append(right_task)

								task_count += 1

								left_task: FairnessLogicalTask = InsertFairnessLogicalNode(left)

								tasks = if task_count < tasks.length():
									tasks.set(task_count, left_task)
								else:
									tasks.append(left_task)

								task_count += 1
							_:
								inserted_expr: CoreExpr = insert_cooperative_checkpoints_expr(
									current_expr,
								)

								inserted = if inserted_count < inserted.length():
									inserted.set(inserted_count, inserted_expr)
								else:
									inserted.append(inserted_expr)

								inserted_count += 1
					RebuildFairnessLogicalNode(source_expr):
						match source_expr:
							LogicalExpr(op, left, right, typ, loc):
								match (
									inserted.get(inserted_count - 2),
									inserted.get(inserted_count - 1),
								):
									(Some(inserted_left), Some(inserted_right)):
										rebuilt: CoreExpr = if (
											same_core_expr(inserted_left, left)
											and same_core_expr(inserted_right, right)
										):
											source_expr
										else:
											LogicalExpr(op, inserted_left, inserted_right, typ, loc)

										inserted = inserted.set(inserted_count - 2, rebuilt)
										inserted_count -= 1
									_:
										valid = False
							_:
								valid = False
			None:
				valid = False

	if valid and inserted_count == 1:
		inserted.get_or(0, expr)
	else:
		expr


-- Every arm visits its children exactly as it always has and answers `expr`
-- itself when every visited child and child container came back as the same
-- allocation; only a loop body that gained a checkpoint builds new nodes, and
-- only along the spine above it.
--
-- This dispatcher binds nothing and forwards to one small arm group, so a deep
-- Core tree costs a shallow native frame per level: one match over every
-- constructor would reserve stack for all of its arms' locals at once and
-- overflow the default stack at -O0 on large generated suites.
pure func insert_cooperative_checkpoints_expr(expr: CoreExpr) -> CoreExpr:
	match expr:
		LiteralExpr(_, _, _) | StaticStringLiteralExpr(_, _, _, _) | VarExpr(_, _, _) | VoidExpr(_, _) | CooperativeCheckpointExpr(_, _) | BreakExpr(_, _) | ContinueExpr(_, _) | SetAllocExpr(_, _, _) | ClosureCreateExpr(_, _, _) | DetachExpr(_, _, _):
			expr
		DebugBlockExpr(_, _, _) | BinaryExpr(_, _, _, _, _) | UnaryExpr(_, _, _, _) | LogicalExpr(_, _, _, _, _) | AssignExpr(_, _, _, _) | CastExpr(_, _, _) | UnboxExpr(_, _, _, _) | FieldExpr(_, _, _, _) | TupleFieldExpr(_, _, _, _) | BoxExpr(_, _, _) | PreClosureDetachExpr(_, _, _) | DupExpr(_, _, _, _, _, _) | DropExpr(_, _, _, _, _, _) | LetExpr(_, _, _, _, _) | BorrowLetExpr(_, _, _, _) | SeqExpr(_, _) | WhileExpr(_, _, _, _) | RangeExpr(_, _, _, _) | IfExpr(_, _, _, _, _):
			insert_operator_checkpoints(expr)
		CallExpr(_, _, _, _, _) | TupleExpr(_, _, _) | TupleConstructExpr(_, _, _) | VectorExpr(_, _, _) | ListConstructExpr(_, _, _) | DictExpr(_, _, _) | DictConstructExpr(_, _, _) | RecordExpr(_, _, _) | RecordUpdateExpr(_, _, _, _) | RecordReuseExpr(_, _, _, _) | RecordCowUpdateExpr(_, _, _, _) | RecordConstructExpr(_, _, _, _) | UnionConstructExpr(_, _, _) | UnionReuseConstructExpr(_, _, _) | SelectExpr(_, _, _):
			insert_aggregate_checkpoints(expr)
		ListAllocExpr(_, _, _) | ListGetExpr(_, _, _) | ListHandoffExpr(_, _, _) | ListHandoffSetOwnedExpr(_, _, _) | ListHandoffSetSourceSlotExpr(_, _, _) | ListRetainExpr(_, _, _) | ListSetExpr(_, _, _) | ListSwapExpr(_, _, _) | StringByteReadExpr(_, _, _) | StringByteWriteExpr(_, _, _) | StringByteCopyExpr(_, _, _) | StringSetLenExpr(_, _, _) | TensorLiteralExpr(_, _, _) | TensorBoxedLiteralExpr(_, _, _) | TensorPackedLiteralExpr(_, _, _) | TensorRawFillExpr(_, _, _) | TensorRawReadExpr(_, _, _) | TensorRawWriteExpr(_, _, _) | TensorRawViewLetExpr(_, _, _, _):
			insert_storage_checkpoints(expr)
		LambdaExpr(_, _, _, _, _, _) | TailrecLoopExpr(_, _, _, _) | TailrecRecurExpr(_, _, _) | TailrecListSpreadLoopExpr(_, _) | TailrecListSpreadRecurExpr(_, _, _, _) | ForRangeExpr(_, _, _, _, _, _) | ForChannelExpr(_, _, _) | ForListExpr(_, _, _) | ForStringExpr(_, _, _) | ForDictExpr(_, _, _) | ForSetExpr(_, _, _) | ForStreamExpr(_, _, _) | ForResourceSourceExpr(_, _, _) | ForTensorExpr(_, _, _) | ResourceScopeExpr(_, _, _) | ResourceCleanupExitExpr(_, _, _):
			insert_loop_checkpoints(expr)
		PreClosureConcurrentlyLoopExpr(_, _, _) | ConcurrentlyLoopExpr(_, _, _) | PreClosureConcurrentExpr(_, _, _) | ConcurrentExpr(_, _, _):
			insert_concurrency_checkpoints(expr)
		RawMatchExpr(_, _, _, _) | SemanticMatchExpr(_, _, _, _) | LiteralMatchExpr(_, _, _, _, _) | AccessorLiteralMatchExpr(_, _, _, _, _) | LengthMatchExpr(_, _, _, _, _) | ConstructorMatchExpr(_, _, _, _, _, _):
			insert_match_checkpoints(expr)


-- Operators, casts, field reads, and the simple binding and control forms.
private pure func insert_operator_checkpoints(expr: CoreExpr) -> CoreExpr:
	match expr:
		DebugBlockExpr(body, typ, loc):
			inserted_body: CoreExpr = insert_cooperative_checkpoints_expr(body)

			if same_core_expr(inserted_body, body):
				expr
			else:
				DebugBlockExpr(inserted_body, typ, loc)
		BinaryExpr(op, left, right, typ, loc):
			inserted_left: CoreExpr = insert_cooperative_checkpoints_expr(left)
			inserted_right: CoreExpr = insert_cooperative_checkpoints_expr(right)

			if same_core_expr(inserted_left, left) and same_core_expr(inserted_right, right):
				expr
			else:
				BinaryExpr(op, inserted_left, inserted_right, typ, loc)
		UnaryExpr(op, expr_value, typ, loc):
			inserted_value: CoreExpr = insert_cooperative_checkpoints_expr(expr_value)

			if same_core_expr(inserted_value, expr_value):
				expr
			else:
				UnaryExpr(op, inserted_value, typ, loc)
		LogicalExpr(op, left, right, typ, loc):
			insert_logical_checkpoints(expr)
		AssignExpr(variable, rhs, typ, loc):
			inserted_rhs: CoreExpr = insert_cooperative_checkpoints_expr(rhs)

			if same_core_expr(inserted_rhs, rhs):
				expr
			else:
				AssignExpr(variable, inserted_rhs, typ, loc)
		CastExpr(expr_value, typ, loc):
			inserted_value: CoreExpr = insert_cooperative_checkpoints_expr(expr_value)

			if same_core_expr(inserted_value, expr_value):
				expr
			else:
				CastExpr(inserted_value, typ, loc)
		UnboxExpr(unbox_kind, expr_value, typ, loc):
			inserted_value: CoreExpr = insert_cooperative_checkpoints_expr(expr_value)

			if same_core_expr(inserted_value, expr_value):
				expr
			else:
				UnboxExpr(unbox_kind, inserted_value, typ, loc)
		FieldExpr(expr_value, field_name, typ, loc):
			inserted_value: CoreExpr = insert_cooperative_checkpoints_expr(expr_value)

			if same_core_expr(inserted_value, expr_value):
				expr
			else:
				FieldExpr(inserted_value, field_name, typ, loc)
		TupleFieldExpr(expr_value, field_index, typ, loc):
			inserted_value: CoreExpr = insert_cooperative_checkpoints_expr(expr_value)

			if same_core_expr(inserted_value, expr_value):
				expr
			else:
				TupleFieldExpr(inserted_value, field_index, typ, loc)
		BoxExpr(box, typ, loc):
			inserted_value: CoreExpr = insert_cooperative_checkpoints_expr(box.value)

			if same_core_expr(inserted_value, box.value):
				expr
			else:
				BoxExpr({ box | value = inserted_value }, typ, loc)
		PreClosureDetachExpr(detached, typ, loc):
			inserted_detached: CoreExpr = insert_cooperative_checkpoints_expr(detached)

			if same_core_expr(inserted_detached, detached):
				expr
			else:
				PreClosureDetachExpr(inserted_detached, typ, loc)
		DupExpr(variable, value_type, retain_policy, body, typ, loc):
			inserted_body: CoreExpr = insert_cooperative_checkpoints_expr(body)

			if same_core_expr(inserted_body, body):
				expr
			else:
				DupExpr(variable, value_type, retain_policy, inserted_body, typ, loc)
		DropExpr(variable, value_type, release_policy, body, typ, loc):
			inserted_body: CoreExpr = insert_cooperative_checkpoints_expr(body)

			if same_core_expr(inserted_body, body):
				expr
			else:
				DropExpr(variable, value_type, release_policy, inserted_body, typ, loc)
		LetExpr(name, is_mutable, typ, rhs, body):
			inserted_rhs: CoreExpr = insert_cooperative_checkpoints_expr(rhs)
			inserted_body: CoreExpr = insert_cooperative_checkpoints_expr(body)

			if same_core_expr(inserted_rhs, rhs) and same_core_expr(inserted_body, body):
				expr
			else:
				LetExpr(name, is_mutable, typ, inserted_rhs, inserted_body)
		BorrowLetExpr(name, typ, rhs, body):
			inserted_rhs: CoreExpr = insert_cooperative_checkpoints_expr(rhs)
			inserted_body: CoreExpr = insert_cooperative_checkpoints_expr(body)

			if same_core_expr(inserted_rhs, rhs) and same_core_expr(inserted_body, body):
				expr
			else:
				BorrowLetExpr(name, typ, inserted_rhs, inserted_body)
		SeqExpr(first, second):
			inserted_first: CoreExpr = insert_cooperative_checkpoints_expr(first)
			inserted_second: CoreExpr = insert_cooperative_checkpoints_expr(second)

			if same_core_expr(inserted_first, first) and same_core_expr(inserted_second, second):
				expr
			else:
				SeqExpr(inserted_first, inserted_second)
		WhileExpr(cond, body, typ, loc):
			inserted_body: Option[CoreExpr] = insert_loop_body_checkpoints(loc, body)
			inserted_cond: CoreExpr = insert_cooperative_checkpoints_expr(cond)

			if inserted_body.is_none() and same_core_expr(inserted_cond, cond):
				expr
			else:
				WhileExpr(
					inserted_cond,
					inserted_body.get_or(body),
					typ,
					loc,
				)
		RangeExpr(start, end_value, typ, loc):
			inserted_start: CoreExpr = insert_cooperative_checkpoints_expr(start)
			inserted_end: CoreExpr = insert_cooperative_checkpoints_expr(end_value)

			if same_core_expr(inserted_start, start) and same_core_expr(inserted_end, end_value):
				expr
			else:
				RangeExpr(inserted_start, inserted_end, typ, loc)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			inserted_cond: CoreExpr = insert_cooperative_checkpoints_expr(cond)
			inserted_then: CoreExpr = insert_cooperative_checkpoints_expr(then_expr)
			inserted_else: CoreExpr = insert_cooperative_checkpoints_expr(else_expr)

			if (
				same_core_expr(inserted_cond, cond)
				and same_core_expr(inserted_then, then_expr)
				and same_core_expr(inserted_else, else_expr)
			):
				expr
			else:
				IfExpr(inserted_cond, inserted_then, inserted_else, typ, loc)
		_:
			expr


-- Calls and the literal, record, union, and select aggregates.
private pure func insert_aggregate_checkpoints(expr: CoreExpr) -> CoreExpr:
	match expr:
		CallExpr(kind, callee, args, typ, loc):
			inserted_callee: CoreExpr = insert_cooperative_checkpoints_expr(callee)
			inserted_args: List[CoreExpr] = insert_exprs(args)

			if same_core_expr(inserted_callee, callee) and same_core_exprs(inserted_args, args):
				expr
			else:
				CallExpr(kind, inserted_callee, inserted_args, typ, loc)
		TupleExpr(items, typ, loc):
			inserted_items: List[CoreExpr] = insert_exprs(items)

			if same_core_exprs(inserted_items, items):
				expr
			else:
				TupleExpr(inserted_items, typ, loc)
		TupleConstructExpr(tuple_construct, typ, loc):
			match insert_tuple_elements(tuple_construct.elements):
				Some(elements):
					TupleConstructExpr({ tuple_construct | elements = elements }, typ, loc)
				None:
					expr
		VectorExpr(items, typ, loc):
			inserted_items: List[CoreExpr] = insert_exprs(items)

			if same_core_exprs(inserted_items, items):
				expr
			else:
				VectorExpr(inserted_items, typ, loc)
		ListConstructExpr(construct, typ, loc):
			match insert_list_construct(construct):
				Some(inserted_construct):
					ListConstructExpr(inserted_construct, typ, loc)
				None:
					expr
		DictExpr(entries, typ, loc):
			match insert_list_items(entries, insert_dict_literal_entry):
				Some(inserted_entries):
					DictExpr(inserted_entries, typ, loc)
				None:
					expr
		DictConstructExpr(construct, typ, loc):
			match insert_dict_construct(construct):
				Some(inserted_construct):
					DictConstructExpr(inserted_construct, typ, loc)
				None:
					expr
		RecordExpr(fields, typ, loc):
			match insert_record_fields(fields):
				Some(inserted_fields):
					RecordExpr(inserted_fields, typ, loc)
				None:
					expr
		RecordUpdateExpr(base, fields, typ, loc):
			inserted_base: CoreExpr = insert_cooperative_checkpoints_expr(base)
			inserted_fields: Option[List[CoreRecordFieldValue]] = insert_record_fields(fields)

			if same_core_expr(inserted_base, base) and inserted_fields.is_none():
				expr
			else:
				RecordUpdateExpr(
					inserted_base,
					inserted_fields.get_or(fields),
					typ,
					loc,
				)
		RecordReuseExpr(source, fields, typ, loc):
			inserted_source: CoreExpr = insert_cooperative_checkpoints_expr(source)
			inserted_fields: Option[List[CoreRecordFieldValue]] = insert_record_fields(fields)

			if same_core_expr(inserted_source, source) and inserted_fields.is_none():
				expr
			else:
				RecordReuseExpr(
					inserted_source,
					inserted_fields.get_or(fields),
					typ,
					loc,
				)
		RecordCowUpdateExpr(source, fields, typ, loc):
			inserted_source: CoreExpr = insert_cooperative_checkpoints_expr(source)
			inserted_fields: Option[List[CoreRecordCowField]] = insert_list_items(
				fields,
				insert_record_cow_field,
			)

			if same_core_expr(inserted_source, source) and inserted_fields.is_none():
				expr
			else:
				RecordCowUpdateExpr(
					inserted_source,
					inserted_fields.get_or(fields),
					typ,
					loc,
				)
		RecordConstructExpr(type_name, fields, typ, loc):
			match insert_record_fields(fields):
				Some(inserted_fields):
					RecordConstructExpr(type_name, inserted_fields, typ, loc)
				None:
					expr
		UnionConstructExpr(construct, typ, loc):
			match insert_boxed_storage_values(construct.args):
				Some(args):
					UnionConstructExpr({ construct | args = args }, typ, loc)
				None:
					expr
		UnionReuseConstructExpr(construct, typ, loc):
			inserted_source: CoreExpr = insert_cooperative_checkpoints_expr(construct.source)
			inserted_args: Option[List[CoreBoxedStorageValue]] = insert_boxed_storage_values(
				construct.args,
			)

			if same_core_expr(inserted_source, construct.source) and inserted_args.is_none():
				expr
			else:
				UnionReuseConstructExpr(
					{ construct |
						source = inserted_source,
						args = inserted_args.get_or(construct.args)
					},
					typ,
					loc,
				)
		SelectExpr(select_expr, typ, loc):
			match insert_list_items(select_expr, func(arm): insert_select_arm(loc, arm)):
				Some(arms):
					SelectExpr(arms, typ, loc)
				None:
					expr
		_:
			expr


-- List, string, and tensor storage operations whose children live in one
-- payload record.
private pure func insert_storage_checkpoints(expr: CoreExpr) -> CoreExpr:
	match expr:
		ListAllocExpr(alloc, typ, loc):
			match insert_list_alloc(alloc):
				Some(inserted):
					ListAllocExpr(inserted, typ, loc)
				None:
					expr
		ListGetExpr(get, typ, loc):
			match insert_list_get(get):
				Some(inserted):
					ListGetExpr(inserted, typ, loc)
				None:
					expr
		ListHandoffExpr(handoff, typ, loc):
			match insert_list_handoff(handoff):
				Some(inserted):
					ListHandoffExpr(inserted, typ, loc)
				None:
					expr
		ListHandoffSetOwnedExpr(set, typ, loc):
			match insert_list_set(set):
				Some(inserted):
					ListHandoffSetOwnedExpr(inserted, typ, loc)
				None:
					expr
		ListHandoffSetSourceSlotExpr(slot, typ, loc):
			match insert_list_handoff_set_source_slot(slot):
				Some(inserted):
					ListHandoffSetSourceSlotExpr(inserted, typ, loc)
				None:
					expr
		ListRetainExpr(retain, typ, loc):
			match insert_list_retain(retain):
				Some(inserted):
					ListRetainExpr(inserted, typ, loc)
				None:
					expr
		ListSetExpr(set, typ, loc):
			match insert_list_set(set):
				Some(inserted):
					ListSetExpr(inserted, typ, loc)
				None:
					expr
		ListSwapExpr(swap, typ, loc):
			match insert_list_swap(swap):
				Some(inserted):
					ListSwapExpr(inserted, typ, loc)
				None:
					expr
		StringByteReadExpr(read, typ, loc):
			match insert_string_byte_read(read):
				Some(inserted):
					StringByteReadExpr(inserted, typ, loc)
				None:
					expr
		StringByteWriteExpr(write, typ, loc):
			match insert_string_byte_write(write):
				Some(inserted):
					StringByteWriteExpr(inserted, typ, loc)
				None:
					expr
		StringByteCopyExpr(copy, typ, loc):
			match insert_string_byte_copy(copy):
				Some(inserted):
					StringByteCopyExpr(inserted, typ, loc)
				None:
					expr
		StringSetLenExpr(set_len, typ, loc):
			match insert_string_set_len(set_len):
				Some(inserted):
					StringSetLenExpr(inserted, typ, loc)
				None:
					expr
		TensorLiteralExpr(literal, typ, loc):
			match insert_tensor_literal_payload(literal.payload):
				Some(payload):
					TensorLiteralExpr({ literal | payload = payload }, typ, loc)
				None:
					expr
		TensorBoxedLiteralExpr(literal, typ, loc):
			match insert_boxed_storage_values(literal.elements):
				Some(elements):
					TensorBoxedLiteralExpr({ literal | elements = elements }, typ, loc)
				None:
					expr
		TensorPackedLiteralExpr(literal, typ, loc):
			inserted_elements: List[CoreExpr] = insert_exprs(literal.elements)

			if same_core_exprs(inserted_elements, literal.elements):
				expr
			else:
				TensorPackedLiteralExpr({ literal | elements = inserted_elements }, typ, loc)
		TensorRawFillExpr(fill, typ, loc):
			inserted_value: CoreExpr = insert_cooperative_checkpoints_expr(fill.value)
			inserted_dims: List[CoreExpr] = insert_exprs(fill.dims)

			if (
				same_core_expr(inserted_value, fill.value)
				and same_core_exprs(inserted_dims, fill.dims)
			):
				expr
			else:
				TensorRawFillExpr(
					{ fill |
						value = inserted_value,
						dims = inserted_dims
					},
					typ,
					loc,
				)
		TensorRawReadExpr(read, typ, loc):
			match insert_tensor_raw_read(read):
				Some(inserted):
					TensorRawReadExpr(inserted, typ, loc)
				None:
					expr
		TensorRawWriteExpr(write, typ, loc):
			match insert_tensor_raw_write(write):
				Some(inserted):
					TensorRawWriteExpr(inserted, typ, loc)
				None:
					expr
		TensorRawViewLetExpr(binding, body, typ, loc):
			inserted_binding: Option[CoreTensorRawViewBinding] = insert_tensor_raw_view_binding(
				binding,
			)
			inserted_body: CoreExpr = insert_cooperative_checkpoints_expr(body)

			if inserted_binding.is_none() and same_core_expr(inserted_body, body):
				expr
			else:
				TensorRawViewLetExpr(
					inserted_binding.get_or(binding),
					inserted_body,
					typ,
					loc,
				)
		_:
			expr


-- Rebuilds a `for` loop node only when its iterable changed or its body gained
-- a checkpoint. Every `for` payload shares these two field names.
private pure func inserted_for_loop_children(
	loop_loc: CoreSourceLoc,
	iterable: CoreExpr,
	body: CoreExpr,
) -> Option[(CoreExpr, CoreExpr)]:
	inserted_body: Option[CoreExpr] = insert_loop_body_checkpoints(loop_loc, body)
	inserted_iterable: CoreExpr = insert_cooperative_checkpoints_expr(iterable)

	if inserted_body.is_none() and same_core_expr(inserted_iterable, iterable):
		None
	else:
		Some((inserted_iterable, inserted_body.get_or(body)))


-- Lambdas, tail-recursive loops, `for` loops, and resource scopes. Loop bodies
-- gain a leading checkpoint unless they already start with one.
private pure func insert_loop_checkpoints(expr: CoreExpr) -> CoreExpr:
	match expr:
		LambdaExpr(lambda_params, lambda_return_type, lambda_body, lambda_is_pure, typ, loc):
			inserted_body: CoreExpr = insert_cooperative_checkpoints_expr(lambda_body)

			if same_core_expr(inserted_body, lambda_body):
				expr
			else:
				LambdaExpr(
					lambda_params,
					lambda_return_type,
					inserted_body,
					lambda_is_pure,
					typ,
					loc,
				)
		TailrecLoopExpr(params, return_type, body, loc):
			match insert_loop_body_checkpoints(loc, body):
				Some(checked_body):
					TailrecLoopExpr(params, return_type, checked_body, loc)
				None:
					expr
		TailrecRecurExpr(args, typ, loc):
			inserted_args: List[CoreExpr] = insert_exprs(args)

			if same_core_exprs(inserted_args, args):
				expr
			else:
				TailrecRecurExpr(inserted_args, typ, loc)
		TailrecListSpreadLoopExpr(loop, loc):
			match insert_tailrec_list_spread_loop_checkpoints(loop, loc):
				Some(inserted_loop):
					TailrecListSpreadLoopExpr(inserted_loop, loc)
				None:
					expr
		TailrecListSpreadRecurExpr(rebinds, cursor_advance, typ, loc):
			match insert_list_items(rebinds, insert_tailrec_list_spread_rebind_checkpoints):
				Some(inserted_rebinds):
					TailrecListSpreadRecurExpr(inserted_rebinds, cursor_advance, typ, loc)
				None:
					expr
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			inserted_body: Option[CoreExpr] = insert_loop_body_checkpoints(loc, body)
			inserted_start: CoreExpr = insert_cooperative_checkpoints_expr(start)
			inserted_end: CoreExpr = insert_cooperative_checkpoints_expr(end_value)

			if (
				inserted_body.is_none()
				and same_core_expr(inserted_start, start)
				and same_core_expr(inserted_end, end_value)
			):
				expr
			else:
				ForRangeExpr(
					binder,
					inserted_start,
					inserted_end,
					inserted_body.get_or(body),
					typ,
					loc,
				)
		ForChannelExpr(for_channel, typ, loc):
			match inserted_for_loop_children(loc, for_channel.iterable, for_channel.body):
				Some((iterable, body)):
					ForChannelExpr(
						{ for_channel |
							iterable = iterable,
							body = body
						},
						typ,
						loc,
					)
				None:
					expr
		ForListExpr(for_list, typ, loc):
			match inserted_for_loop_children(loc, for_list.iterable, for_list.body):
				Some((iterable, body)):
					ForListExpr(
						{ for_list |
							iterable = iterable,
							body = body
						},
						typ,
						loc,
					)
				None:
					expr
		ForStringExpr(for_string, typ, loc):
			match inserted_for_loop_children(loc, for_string.iterable, for_string.body):
				Some((iterable, body)):
					ForStringExpr(
						{ for_string |
							iterable = iterable,
							body = body
						},
						typ,
						loc,
					)
				None:
					expr
		ForDictExpr(for_dict, typ, loc):
			match inserted_for_loop_children(loc, for_dict.iterable, for_dict.body):
				Some((iterable, body)):
					ForDictExpr(
						{ for_dict |
							iterable = iterable,
							body = body
						},
						typ,
						loc,
					)
				None:
					expr
		ForSetExpr(for_set, typ, loc):
			match inserted_for_loop_children(loc, for_set.iterable, for_set.body):
				Some((iterable, body)):
					ForSetExpr(
						{ for_set |
							iterable = iterable,
							body = body
						},
						typ,
						loc,
					)
				None:
					expr
		ForResourceSourceExpr(for_resource_source, typ, loc):
			match inserted_for_loop_children(
				loc,
				for_resource_source.iterable,
				for_resource_source.body,
			):
				Some((iterable, body)):
					ForResourceSourceExpr(
						{ for_resource_source |
							iterable = iterable,
							body = body
						},
						typ,
						loc,
					)
				None:
					expr
		ForStreamExpr(for_stream, typ, loc):
			match inserted_for_loop_children(loc, for_stream.iterable, for_stream.body):
				Some((iterable, body)):
					ForStreamExpr(
						{ for_stream |
							iterable = iterable,
							body = body
						},
						typ,
						loc,
					)
				None:
					expr
		ForTensorExpr(for_tensor, typ, loc):
			match inserted_for_loop_children(loc, for_tensor.iterable, for_tensor.body):
				Some((iterable, body)):
					ForTensorExpr(
						{ for_tensor |
							iterable = iterable,
							body = body
						},
						typ,
						loc,
					)
				None:
					expr
		ResourceScopeExpr(scope, typ, loc):
			inserted_acquire: CoreExpr = insert_cooperative_checkpoints_expr(scope.acquire)
			inserted_body: CoreExpr = insert_cooperative_checkpoints_expr(scope.body)
			inserted_cleanup: CoreExpr = insert_cooperative_checkpoints_expr(scope.cleanup)

			if (
				same_core_expr(inserted_acquire, scope.acquire)
				and same_core_expr(inserted_body, scope.body)
				and same_core_expr(inserted_cleanup, scope.cleanup)
			):
				expr
			else:
				ResourceScopeExpr(
					{ scope |
						acquire = inserted_acquire,
						body = inserted_body,
						cleanup = inserted_cleanup
					},
					typ,
					loc,
				)
		ResourceCleanupExitExpr(cleanup_exit, typ, loc):
			inserted_cleanups: List[CoreExpr] = insert_exprs(cleanup_exit.cleanups)

			if same_core_exprs(inserted_cleanups, cleanup_exit.cleanups):
				expr
			else:
				ResourceCleanupExitExpr({ cleanup_exit | cleanups = inserted_cleanups }, typ, loc)
		_:
			expr


-- Structured-concurrency blocks and loops, before and after closure formation.
private pure func insert_concurrency_checkpoints(expr: CoreExpr) -> CoreExpr:
	match expr:
		PreClosureConcurrentlyLoopExpr(loop, typ, loc):
			inserted_iterable: CoreExpr = insert_cooperative_checkpoints_expr(loop.iterable)
			inserted_body: Option[CoreExpr] = insert_loop_body_checkpoints(loc, loop.body)
			inserted_timeout: Option[CoreExpr] = insert_optional_checkpoints(loop.timeout)
			inserted_limit: CoreExpr = insert_cooperative_checkpoints_expr(loop.limit)

			if (
				same_core_expr(inserted_iterable, loop.iterable)
				and inserted_body.is_none()
				and same_optional_core_expr(inserted_timeout, loop.timeout)
				and same_core_expr(inserted_limit, loop.limit)
			):
				expr
			else:
				PreClosureConcurrentlyLoopExpr(
					{ loop |
						iterable = inserted_iterable,
						body = inserted_body.get_or(loop.body),
						timeout = inserted_timeout,
						limit = inserted_limit
					},
					typ,
					loc,
				)
		ConcurrentlyLoopExpr(loop, typ, loc):
			match insert_concurrently_loop_checkpoints(loop, loc):
				Some(inserted_loop):
					ConcurrentlyLoopExpr(inserted_loop, typ, loc)
				None:
					expr
		PreClosureConcurrentExpr(block, typ, loc):
			inserted_body: CoreExpr = insert_cooperative_checkpoints_expr(block.body)
			inserted_timeout: Option[CoreExpr] = insert_optional_checkpoints(block.timeout)

			if (
				same_core_expr(inserted_body, block.body)
				and same_optional_core_expr(inserted_timeout, block.timeout)
			):
				expr
			else:
				PreClosureConcurrentExpr(
					{ block |
						body = inserted_body,
						timeout = inserted_timeout
					},
					typ,
					loc,
				)
		ConcurrentExpr(block, typ, loc):
			match insert_concurrent_block_checkpoints(block):
				Some(inserted_block):
					ConcurrentExpr(inserted_block, typ, loc)
				None:
					expr
		_:
			expr


-- The match forms. Semantic matches already go through the shared traversal,
-- which applies the same reuse rule.
private pure func insert_match_checkpoints(expr: CoreExpr) -> CoreExpr:
	match expr:
		RawMatchExpr(scrutinee, cases, typ, loc):
			inserted_scrutinee: CoreExpr = insert_cooperative_checkpoints_expr(scrutinee)
			inserted_cases: Option[List[CoreRawMatchCase]] = insert_list_items(
				cases,
				insert_raw_match_case,
			)

			if same_core_expr(inserted_scrutinee, scrutinee) and inserted_cases.is_none():
				expr
			else:
				RawMatchExpr(
					inserted_scrutinee,
					inserted_cases.get_or(cases),
					typ,
					loc,
				)
		SemanticMatchExpr(scrutinee, tree, typ, loc):
			CoreTraverse.map_core_expr_children(expr, insert_cooperative_checkpoints_expr)
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			inserted_scrutinee: CoreExpr = insert_cooperative_checkpoints_expr(scrutinee)
			inserted_cases: Option[List[CoreLiteralMatchCase]] = insert_literal_match_cases(cases)
			inserted_fallback: Option[CoreLiteralMatchFallback] = insert_literal_match_fallback(
				fallback,
			)

			if (
				same_core_expr(inserted_scrutinee, scrutinee)
				and inserted_cases.is_none()
				and inserted_fallback.is_none()
			):
				expr
			else:
				LiteralMatchExpr(
					inserted_scrutinee,
					inserted_cases.get_or(cases),
					inserted_fallback.get_or(fallback),
					typ,
					loc,
				)
		AccessorLiteralMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			inserted_scrutinee: CoreExpr = insert_cooperative_checkpoints_expr(scrutinee)
			inserted_match: Option[CoreConstructorLiteralMatch] = insert_constructor_literal_match(
				match_expr,
			)

			if same_core_expr(inserted_scrutinee, scrutinee) and inserted_match.is_none():
				expr
			else:
				AccessorLiteralMatchExpr(
					inserted_scrutinee,
					scrutinee_release_policy,
					inserted_match.get_or(match_expr),
					typ,
					loc,
				)
		LengthMatchExpr(scrutinee, scrutinee_release_policy, match_expr, typ, loc):
			inserted_scrutinee: CoreExpr = insert_cooperative_checkpoints_expr(scrutinee)
			inserted_match: Option[CoreConstructorLengthMatch] = insert_constructor_length_match(
				match_expr,
			)

			if same_core_expr(inserted_scrutinee, scrutinee) and inserted_match.is_none():
				expr
			else:
				LengthMatchExpr(
					inserted_scrutinee,
					scrutinee_release_policy,
					inserted_match.get_or(match_expr),
					typ,
					loc,
				)
		ConstructorMatchExpr(scrutinee, scrutinee_release_policy, cases, fallback, typ, loc):
			inserted_scrutinee: CoreExpr = insert_cooperative_checkpoints_expr(scrutinee)
			inserted_cases: Option[List[CoreConstructorMatchCase]] = insert_constructor_match_cases(
				cases,
			)
			inserted_fallback: Option[CoreConstructorMatchFallback] = insert_constructor_match_fallback(
				fallback,
			)

			if (
				same_core_expr(inserted_scrutinee, scrutinee)
				and inserted_cases.is_none()
				and inserted_fallback.is_none()
			):
				expr
			else:
				ConstructorMatchExpr(
					inserted_scrutinee,
					scrutinee_release_policy,
					inserted_cases.get_or(cases),
					inserted_fallback.get_or(fallback),
					typ,
					loc,
				)
		_:
			expr


private pure func insert_function(func_info: CoreFunction) -> CoreFunction:
	match func_info.body:
		Some(body):
			inserted_body: CoreExpr = insert_cooperative_checkpoints_expr(body)

			if same_core_expr(inserted_body, body):
				func_info
			else:
				{ func_info | body = Some(inserted_body) }
		None:
			func_info


private pure func insert_decl(decl: CoreDecl) -> CoreDecl:
	match decl:
		FunctionDecl(func_info):
			FunctionDecl(insert_function(func_info))
		GlobalDecl(global):
			GlobalDecl({ global | init = insert_cooperative_checkpoints_expr(global.init) })
		EnumDecl(enum_decl):
			EnumDecl(enum_decl)
		UnionDecl(union_decl):
			UnionDecl(union_decl)
		ValueRecordDecl(record_decl):
			ValueRecordDecl(record_decl)
		HeapRecordDecl(record_decl):
			HeapRecordDecl(record_decl)
		TypeAliasDecl(alias_decl):
			TypeAliasDecl(alias_decl)
		TraitDecl(trait_decl):
			TraitDecl(trait_decl)
		ImplDecl(impl_decl):
			ImplDecl({ impl_decl | methods = impl_decl.methods.map(insert_function) })


pure func insert_cooperative_checkpoints(program: CoreProgram) -> CoreProgram:
	{
		decls = program.decls.map(func(decl): insert_decl(decl)),
		foreign_includes = program.foreign_includes
	}
