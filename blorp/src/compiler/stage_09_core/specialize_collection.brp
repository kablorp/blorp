-- Collection- and stream-oriented post-resolve specialization.
--
-- This module rewrites only the current Core node. The production
-- specialization orchestrator owns recursion so independent builtin families
-- can be composed without traversing the tree more than once.
import:
	c_type_layout: generated_stack_option_c_type_name, type_requires_release
	erased_key_temps: RELEASE_HASH_KEY_BOX, is_erased_key_temp_marker
	ir:
		CoreAccessor(RootAccessor, StackOptionPayloadAccessor, VariantFieldAccessor),
		CoreBinaryOp(AddOp),
		CoreBoxKind(
			Float16Box, Float32Box, FloatBox, Int128Box, PointerBox, PrimBox, StructBox, UInt128Box,
			VoidBox,
		),
		CoreBoxedStorageValue,
		CoreCallKind(BuiltinCall, ClosureCall, IntrinsicCall),
		CoreConstructorMatchBody(ConstructorMatchBodyExpr),
		CoreConstructorMatchFallback(ConstructorMatchFallbackBody),
		CoreConstructorMatchTest(StackOptionSomeConstructorTest, UnionTagConstructorTest),
		CoreDecl(UnionDecl),
		CoreDictEntry,
		CoreExpr(
			AssignExpr, BinaryExpr, BorrowLetExpr, BoxExpr, CallExpr, CastExpr,
			ConstructorMatchExpr, DictConstructExpr, ForRangeExpr, LetExpr, ListAllocExpr,
			ListConstructExpr, SeqExpr, TensorBoxedLiteralExpr, UnboxExpr, UnionConstructExpr,
			UnionReuseConstructExpr, VarExpr, VoidExpr,
		),
		CoreLiteral(IntLiteral),
		CoreLoopRangeDirection(RangeForwardOnly),
		CoreMatchBindingMode(MatchBorrowBindingMode),
		CoreReleasePolicy(NoReleasePolicy),
		CoreSourceLoc,
		CoreType(
			BoxedResultType, EnumType, HeapRecordType, InlineRecordType, NamedType, RangeType,
			StackResultType, UnionType, VoidType,
		),
		CoreUnboxKind,
		CoreVar,
		CoreVariantRef(VariantById),
		core_expr_type,
	specialize_layout:
		CoreHashKeyStrategy(
			FloatHashKeys, Int128HashKeys, StringHashKeys, TraitHashKeys, WordHashKeys,
		),
		CoreOptionRuntimeLayout(
			BoxedOptionLayout, NullableManagedOptionLayout, PrimitiveStackOptionLayout,
			UnspecializedOptionLayout,
		),
		CoreSpecializeLayout,
		CoreStreamElementLayout(
			StreamBorrowedArcLayout, StreamImmediateLayout, StreamOwnedArcLayout,
		),
		boxed_storage_allocates,
		boxed_storage_kind,
		boxed_storage_slot_needs_release,
		boxed_storage_unbox_kind,
		boxed_storage_value,
		hash_key_strategy,
		option_payload_runtime_layout,
		option_runtime_builtin,
		resolve_specialize_type,
		single_named_type_argument,
		specialize_list_element_needs_release,
		specialize_list_layout,
		specialize_type_is_managed,
		specialize_type_is_pointer,
		stream_element_layout_code,
		tensor_type_info,
		two_named_type_arguments,
	synth_nodes: builtin_call_with_callee, core_var
	type_policy:
		core_type_has_unresolved_mono_parameters,
		is_core_stream_type_name,
		primitive_integer_type,


private INT_TYPE: CoreType = NamedType("Int", [])

private POINTER_TYPE: CoreType = NamedType("Ptr", [])

private FIRST_ERASED_ARGUMENT_INDEX: Int = 1

private SECOND_ERASED_ARGUMENT_INDEX: Int = 2


private pure func variable(name: String, typ: CoreType, loc: CoreSourceLoc) -> CoreExpr:
	VarExpr(core_var(name), typ, loc)


private pure func int_literal(value: Int, loc: CoreSourceLoc) -> CoreExpr:
	LiteralExpr(IntLiteral(value), INT_TYPE, loc)


private pure func void_expr(loc: CoreSourceLoc) -> CoreExpr:
	VoidExpr(VoidType, loc)


private pure func intrinsic_call(
	name: String,
	args: List[CoreExpr],
	result_type: CoreType,
	loc: CoreSourceLoc,
) -> CoreExpr:
	CallExpr(IntrinsicCall(name), void_expr(loc), args, result_type, loc)


---
Resolves a synthesized body's erased-key-temp marker (`erased_key_temps`) now
that the key's runtime layout is known: a key boxed into a fresh allocation is
released, and any other conversion needs no release. A malformed marker is
left in place for the late invariant to report.
---
private pure func resolve_erased_key_temp_release(
	layout: CoreSpecializeLayout,
	args: List[CoreExpr],
	loc: CoreSourceLoc,
) -> Option[CoreExpr]:
	match args:
		[key_temp, source]:
			if boxed_storage_allocates(layout, core_expr_type(source)):
				Some(intrinsic_call(RELEASE_HASH_KEY_BOX, [key_temp], VoidType, loc))
			else:
				Some(void_expr(loc))
		_:
			None


private pure func list_element_type(
	layout: CoreSpecializeLayout,
	typ: CoreType,
) -> Option[CoreType]:
	match resolve_specialize_type(layout, typ):
		NamedType(name, args):
			if (name == "List" or name == "ParallelList") and args.length() == 1:
				element_type ?= args.get(0)
				Some(resolve_specialize_type(layout, element_type))
			else:
				None
		_:
			None


private pure func stream_element_type(
	layout: CoreSpecializeLayout,
	typ: CoreType,
) -> Option[CoreType]:
	match resolve_specialize_type(layout, typ):
		NamedType(name, args):
			if is_core_stream_type_name(name) and args.length() == 1:
				element_type ?= args.get(0)
				Some(resolve_specialize_type(layout, element_type))
			else:
				None
		_:
			None


private pure func stack_option_c_type(payload: CoreType) -> Option[String]:
	match payload:
		VoidType:
			Some("blorp_StackOption_Void")
		NamedType(name, args):
			if not args.is_empty():
				None
			else if (
				primitive_integer_type(name)
				or name == "Float"
				or name == "Float32"
				or name == "Float16"
				or name == "Int128"
				or name == "UInt128"
			):
				Some("blorp_StackOption_" + name)
			else:
				None
		EnumType(name):
			Some("blorp_StackOption_" + name)
		InlineRecordType(name):
			Some(generated_stack_option_c_type_name(name))
		RangeType:
			Some("blorp_StackOption_Range")
		_:
			None


private pure func canonical_boxed_value(
	layout: CoreSpecializeLayout,
	value: CoreBoxedStorageValue,
) -> CoreBoxedStorageValue:
	boxed_storage_value(layout, value.value, value.transfers_ownership)


private pure func canonical_dict_entry(
	layout: CoreSpecializeLayout,
	entry: CoreDictEntry,
) -> CoreDictEntry:
	{ entry |
		key = canonical_boxed_value(layout, entry.key),
		value = canonical_boxed_value(layout, entry.value)
	}


private pure func canonicalize_erased_storage_metadata(
	layout: CoreSpecializeLayout,
	expr: CoreExpr,
) -> CoreExpr:
	match expr:
		BoxExpr(box, typ, loc):
			BoxExpr({ box | kind = boxed_storage_kind(layout, box.source_type) }, typ, loc)
		CastExpr(value, target_type, loc):
			is_pointer_cast: Bool = match target_type:
				NamedType("Ptr", args):
					args.is_empty()
				_:
					False

			if is_pointer_cast:
				source_type: CoreType = core_expr_type(value)
				kind: CoreBoxKind = boxed_storage_kind(layout, source_type)

				match kind:
					FloatBox | Float32Box | Float16Box | Int128Box | UInt128Box | StructBox(_):
						BoxExpr(
							{
								kind = kind,
								value = value,
								source_type = source_type
							},
							POINTER_TYPE,
							loc,
						)
					PointerBox | PrimBox | VoidBox:
						expr
			else:
				expr
		UnboxExpr(_, value, typ, loc):
			UnboxExpr(
				boxed_storage_unbox_kind(layout, typ),
				value,
				typ,
				loc,
			)
		ListConstructExpr(construct, typ, loc):
			ListConstructExpr(
				{ construct |
					elements = construct.elements.map(
						func(value): canonical_boxed_value(layout, value),
					)
				},
				typ,
				loc,
			)
		TensorBoxedLiteralExpr(tensor, typ, loc):
			TensorBoxedLiteralExpr(
				{ tensor |
					elements = tensor.elements.map(
						func(value): canonical_boxed_value(layout, value),
					)
				},
				typ,
				loc,
			)
		DictConstructExpr(dict, typ, loc):
			DictConstructExpr(
				{ dict |
					entries = dict.entries.map(func(entry): canonical_dict_entry(layout, entry))
				},
				typ,
				loc,
			)
		UnionConstructExpr(construct, typ, loc):
			UnionConstructExpr(
				{ construct |
					args = construct.args.map(func(value): canonical_boxed_value(layout, value))
				},
				typ,
				loc,
			)
		UnionReuseConstructExpr(construct, typ, loc):
			UnionReuseConstructExpr(
				{ construct |
					args = construct.args.map(func(value): canonical_boxed_value(layout, value))
				},
				typ,
				loc,
			)
		_:
			expr


private pure func hash_constructor_suffix(
	layout: CoreSpecializeLayout,
	key_type: CoreType,
) -> String:
	match hash_key_strategy(layout, key_type):
		WordHashKeys:
			""
		StringHashKeys:
			"_string"
		FloatHashKeys:
			"_float"
		Int128HashKeys:
			"_int128"
		TraitHashKeys:
			"_custom"


private pure func set_constructor_name(
	layout: CoreSpecializeLayout,
	element_type: CoreType,
) -> String:
	"blorp_set_new" + hash_constructor_suffix(layout, element_type)


private pure func dict_constructor_name(layout: CoreSpecializeLayout, key_type: CoreType) -> String:
	"blorp_dict_new" + hash_constructor_suffix(layout, key_type)


private pure func dict_capacity_constructor_name(
	layout: CoreSpecializeLayout,
	key_type: CoreType,
) -> String:
	"blorp_dict_with_capacity" + hash_constructor_suffix(layout, key_type)


private pure func set_type_element(layout: CoreSpecializeLayout, typ: CoreType) -> Option[CoreType]:
	element_type ?= single_named_type_argument(layout, typ, "Set")
	Some(resolve_specialize_type(layout, element_type))


private pure func dict_type_parts(
	layout: CoreSpecializeLayout,
	typ: CoreType,
) -> Option[(CoreType, CoreType)]:
	parts ?= two_named_type_arguments(layout, typ, "Dict")

	match parts:
		(key_type, value_type):
			Some(
				(
					resolve_specialize_type(layout, key_type),
					resolve_specialize_type(layout, value_type),
				),
			)


private pure func immediate_set_constructor_name(name: String) -> Bool:
	(
		name == "blorp_set_new"
		or name == "blorp_set_new_string"
		or name == "blorp_set_new_float"
		or name == "blorp_set_new_int128"
		or name == "blorp_set_new_custom"
	)


private pure func immediate_dict_constructor_name(name: String) -> Bool:
	(
		name == "blorp_dict_new"
		or name == "blorp_dict_new_string"
		or name == "blorp_dict_new_float"
		or name == "blorp_dict_new_int128"
		or name == "blorp_dict_new_custom"
	)


private pure func immediate_dict_capacity_constructor_name(name: String) -> Bool:
	(
		name == "blorp_dict_with_capacity"
		or name == "blorp_dict_with_capacity_string"
		or name == "blorp_dict_with_capacity_float"
		or name == "blorp_dict_with_capacity_int128"
		or name == "blorp_dict_with_capacity_custom"
	)


private pure func refine_immediate_set_constructor(
	layout: CoreSpecializeLayout,
	element: CoreExpr,
	set_expr: CoreExpr,
) -> CoreExpr:
	match set_expr:
		CallExpr(kind, callee, constructor_args, _, loc):
			match kind:
				BuiltinCall(name):
					if constructor_args.is_empty() and immediate_set_constructor_name(name):
						element_type: CoreType = core_expr_type(element)
						builtin_call_with_callee(
							set_constructor_name(layout, element_type),
							callee,
							[],
							NamedType("Set", [element_type]),
							loc,
						)
					else:
						set_expr
				_:
					set_expr
		_:
			set_expr


private pure func refine_immediate_dict_constructor(
	layout: CoreSpecializeLayout,
	key: CoreExpr,
	value: CoreExpr,
	dict_expr: CoreExpr,
) -> CoreExpr:
	key_type: CoreType = core_expr_type(key)
	value_type: CoreType = core_expr_type(value)
	dict_type: CoreType = NamedType(
		"Dict",
		[key_type, value_type],
	)

	match dict_expr:
		CallExpr(kind, callee, constructor_args, _, loc):
			match kind:
				BuiltinCall(name):
					if immediate_dict_constructor_name(name) and constructor_args.is_empty():
						builtin_call_with_callee(
							dict_constructor_name(layout, key_type),
							callee,
							[],
							dict_type,
							loc,
						)
					else if (
						immediate_dict_capacity_constructor_name(name)
						and constructor_args.length() == 1
					):
						match constructor_args.get(0):
							Some(capacity):
								builtin_call_with_callee(
									dict_capacity_constructor_name(layout, key_type),
									callee,
									[capacity],
									dict_type,
									loc,
								)
							None:
								dict_expr
					else:
						dict_expr
				_:
					dict_expr
		_:
			dict_expr


private pure func first_erased_argument_builtin(name: String) -> Bool:
	(
		name == "blorp_list_append"
		or name == "blorp_list_append_owned"
		or name == "blorp_channel_send"
		or name == "blorp_channel_try_send"
		or name == "blorp_channel_try_send_status"
		or name == "blorp_channel_try_send_attempt"
		or name == "blorp_channel_send_timeout"
		or name == "blorp_channel_send_timeout_status"
		or name == "blorp_channel_send_timeout_attempt"
		or name == "blorp_set_add"
		or name == "blorp_set_remove"
		or name == "blorp_dict_remove"
		or name == "blorp_fold_parallel"
		or name == "blorp_fold_parallel_ordered"
		or name == "blorp_fold_parallel_with"
		or name == "blorp_fold_parallel_ordered_with"
		or name == "blorp_stream_fold"
		or name == "blorp_fallible_stream_fold_raw"
		or name.starts_with("blorp_dict_get")
	)


private pure func collection_has_erased_arguments(name: String) -> Bool:
	first_erased_argument_builtin(name) or name == "blorp_dict_insert"


private pure func collection_argument_is_erased(name: String, index: Int) -> Bool:
	(
		first_erased_argument_builtin(name) and index == FIRST_ERASED_ARGUMENT_INDEX
		or (
			name == "blorp_dict_insert"
			and (index == FIRST_ERASED_ARGUMENT_INDEX or index == SECOND_ERASED_ARGUMENT_INDEX)
		)
	)


private pure func explicit_box(expr: CoreExpr) -> Bool:
	match expr:
		BoxExpr(_, _, _):
			True
		_:
			False


private pure func box_void_slot_argument(
	layout: CoreSpecializeLayout,
	arg: CoreExpr,
	loc: CoreSourceLoc,
) -> CoreExpr:
	source_type: CoreType = core_expr_type(arg)
	kind: CoreBoxKind = boxed_storage_kind(layout, source_type)

	if explicit_box(arg):
		arg
	else:
		match kind:
			PointerBox:
				arg
			_:
				BoxExpr(
					{
						kind = kind,
						value = arg,
						source_type = source_type
					},
					POINTER_TYPE,
					loc,
				)


private pure func box_collection_void_slots(
	layout: CoreSpecializeLayout,
	name: String,
	args: List[CoreExpr],
	loc: CoreSourceLoc,
) -> List[CoreExpr]:
	if not collection_has_erased_arguments(name):
		args
	else:
		var result: List[CoreExpr] = []
		var index: Int = 0

		for arg in args:
			result = result.append(
				if collection_argument_is_erased(name, index):
					box_void_slot_argument(layout, arg, loc)
				else:
					arg
			)
			index += 1

		result


private pure func option_runtime_name(
	layout: CoreSpecializeLayout,
	option_type: CoreType,
	base: String,
	boxed_base: Option[String],
) -> Option[String]:
	option_runtime_builtin(layout, option_type, base, base + "_nullable", boxed_base)


private pure func stream_filter_map_runtime_name(
	layout: CoreSpecializeLayout,
	stream_type: CoreType,
	base: String,
) -> Option[String]:
	element_type ?= stream_element_type(layout, stream_type)

	match option_payload_runtime_layout(layout, element_type):
		PrimitiveStackOptionLayout(suffix):
			Some(base + "_" + suffix)
		NullableManagedOptionLayout:
			Some(base + "_nullable")
		BoxedOptionLayout | UnspecializedOptionLayout:
			None


private pure func list_filter_map_runtime_name(
	layout: CoreSpecializeLayout,
	list_type: CoreType,
	base: String,
) -> Option[String]:
	element_type ?= list_element_type(layout, list_type)

	match option_payload_runtime_layout(layout, element_type):
		PrimitiveStackOptionLayout(suffix):
			Some(base + "_" + suffix)
		NullableManagedOptionLayout:
			Some(base + "_nullable")
		BoxedOptionLayout:
			Some(base)
		UnspecializedOptionLayout:
			None


private pure func result_ok_type(
	layout: CoreSpecializeLayout,
	result_type: CoreType,
) -> Option[CoreType]:
	resolved: CoreType = resolve_specialize_type(layout, result_type)

	match resolved:
		StackResultType(ok_type, _) | BoxedResultType(ok_type, _):
			Some(resolve_specialize_type(layout, ok_type))
		NamedType(_, _):
			parts ?= two_named_type_arguments(layout, resolved, "Result")

			match parts:
				(ok_type, _):
					Some(resolve_specialize_type(layout, ok_type))
		_:
			None


private pure func fallible_find_runtime_name(
	layout: CoreSpecializeLayout,
	result_type: CoreType,
	base: String,
) -> Option[String]:
	ok_type ?= result_ok_type(layout, result_type)
	element_type ?= single_named_type_argument(layout, ok_type, "Option")

	match option_payload_runtime_layout(layout, element_type):
		PrimitiveStackOptionLayout(suffix):
			Some(base + "_" + suffix)
		NullableManagedOptionLayout:
			Some(base + "_nullable")
		BoxedOptionLayout:
			Some(base)
		UnspecializedOptionLayout:
			None


private pure func erased_stream_result_layout(
	layout: CoreSpecializeLayout,
	result_type: CoreType,
	borrowed: Bool,
) -> Option[CoreStreamElementLayout]:
	element_type ?= stream_element_type(layout, result_type)

	if boxed_storage_slot_needs_release(layout, element_type):
		if borrowed:
			Some(StreamBorrowedArcLayout)
		else:
			Some(StreamOwnedArcLayout)
	else:
		Some(StreamImmediateLayout)


private pure func stream_state_layout(
	layout: CoreSpecializeLayout,
	state_type: CoreType,
) -> CoreStreamElementLayout:
	if specialize_type_is_managed(layout, state_type):
		StreamOwnedArcLayout
	else:
		StreamImmediateLayout


private pure func stream_runtime_value_argument(
	layout: CoreSpecializeLayout,
	value_layout: CoreStreamElementLayout,
	value: CoreExpr,
	loc: CoreSourceLoc,
) -> CoreExpr:
	match value_layout:
		StreamImmediateLayout:
			box_void_slot_argument(layout, value, loc)
		_:
			value


private pure func is_list_filter_map_parallel_builtin(name: String) -> Bool:
	(
		name == "blorp_filter_map_parallel"
		or name == "blorp_filter_map_parallel_int"
		or name == "blorp_filter_map_parallel_int8"
		or name == "blorp_filter_map_parallel_int16"
		or name == "blorp_filter_map_parallel_int32"
		or name == "blorp_filter_map_parallel_int64"
		or name == "blorp_filter_map_parallel_uint8"
		or name == "blorp_filter_map_parallel_uint16"
		or name == "blorp_filter_map_parallel_uint32"
		or name == "blorp_filter_map_parallel_uint64"
		or name == "blorp_filter_map_parallel_float"
		or name == "blorp_filter_map_parallel_bool"
		or name == "blorp_filter_map_parallel_char"
		or name == "blorp_filter_map_parallel_f32"
		or name == "blorp_filter_map_parallel_f16"
		or name == "blorp_filter_map_parallel_nullable"
	)


private pure func list_parallel_map_arity(name: String, arity: Int) -> Bool:
	(
		name == "blorp_map_parallel" and arity == 2
		or name == "blorp_zip_parallel" and arity == 3
		or is_list_filter_map_parallel_builtin(name) and arity == 2
		or name == "blorp_map_parallel_with" and arity == 3
		or name == "blorp_zip_parallel_with" and arity == 4
	)


private pure func tensor_collection_map_arity(name: String, arity: Int) -> Bool:
	(
		(
			((
				name == "blorp_vector_map"
				or name == "blorp_matrix_map"
				or name == "blorp_matrix_map_indexed"
				or name == "blorp_vmap_parallel"
				or name == "blorp_vmap_indexed_parallel"
				or name == "blorp_mmap_parallel"
				or name == "blorp_mmap_indexed_parallel"
				or name == "blorp_mmap_flat_indexed_parallel"
			))
			and arity == 2
		)
		or (
			((
				name == "blorp_matrix_zip_map"
				or name == "blorp_vzip_parallel"
				or name == "blorp_mzip_parallel"
				or name == "blorp_mzip_indexed_parallel"
			))
			and arity == 3
		)
	)


private pure func append_release_flag(
	name: String,
	callee: CoreExpr,
	args: List[CoreExpr],
	result_type: CoreType,
	needs_release: Bool,
	loc: CoreSourceLoc,
) -> CoreExpr:
	release_flag: Int = if needs_release:
		1
	else:
		0

	builtin_call_with_callee(
		name,
		callee,
		args.append(int_literal(release_flag, loc)),
		result_type,
		loc,
	)


private pure func tensor_result_element_type(
	layout: CoreSpecializeLayout,
	typ: CoreType,
) -> Option[CoreType]:
	info ?= tensor_type_info(layout, typ)
	Some(resolve_specialize_type(layout, info.element_type))


private pure func stack_option_match_parts(
	layout: CoreSpecializeLayout,
	element_type: CoreType,
) -> Option[(CoreConstructorMatchTest, CoreAccessor)]:
	resolved: CoreType = resolve_specialize_type(layout, element_type)

	match stack_option_c_type(resolved):
		Some(c_type):
			Some((StackOptionSomeConstructorTest(c_type), StackOptionPayloadAccessor(RootAccessor)))
		None:
			boxed_option_some_match_parts(layout)


---
The `Some` test and payload accessor for an `Option` whose layout is the
general tagged union. The tag macro belongs to the `Option` declaration's
`Some` variant, so it is read from there rather than respelled here; `None`
when the program declares no such variant.
---
private pure func boxed_option_some_match_parts(
	layout: CoreSpecializeLayout,
) -> Option[(CoreConstructorMatchTest, CoreAccessor)]:
	var result: Option[(CoreConstructorMatchTest, CoreAccessor)] = None

	for decl in layout.program.decls:
		match decl:
			UnionDecl(union_decl):
				if union_decl.name == "Option":
					for variant in union_decl.variants:
						if variant.name == "Some":
							match variant.def_id:
								Some(def_id):
									result = Some(
										(
											UnionTagConstructorTest(VariantById(def_id), "Option"),
											VariantFieldAccessor(
												RootAccessor,
												"Option",
												"Some",
												0,
											),
										),
									)
								None:
									void
			_:
				void

	result


private pure func list_filter_map_fallback(
	layout: CoreSpecializeLayout,
	self: CoreExpr,
	function_expr: CoreExpr,
	result_type: CoreType,
	loc: CoreSourceLoc,
) -> Option[CoreExpr]:
	result_element_type: CoreType = list_element_type(layout, result_type).get_or(POINTER_TYPE)
	match_parts ?= stack_option_match_parts(layout, result_element_type)

	Some(list_filter_map_loop(layout, self, function_expr, result_type, match_parts, loc))


private pure func list_filter_map_loop(
	layout: CoreSpecializeLayout,
	self: CoreExpr,
	function_expr: CoreExpr,
	result_type: CoreType,
	match_parts: (CoreConstructorMatchTest, CoreAccessor),
	loc: CoreSourceLoc,
) -> CoreExpr:
	source_type: CoreType = core_expr_type(self)
	element_type: CoreType = list_element_type(layout, source_type).get_or(POINTER_TYPE)
	result_element_type: CoreType = list_element_type(layout, result_type).get_or(POINTER_TYPE)
	option_type: CoreType = NamedType("Option", [result_element_type])
	index: CoreExpr = variable("__i", INT_TYPE, loc)
	output_index: CoreExpr = variable("__out", INT_TYPE, loc)
	raw_value: CoreExpr = variable("__raw", POINTER_TYPE, loc)
	unboxed_value: CoreExpr = UnboxExpr(
		boxed_storage_unbox_kind(layout, element_type),
		raw_value,
		element_type,
		loc,
	)
	mapped: CoreExpr = variable("__mapped", option_type, loc)
	kept_value: CoreExpr = variable("__value", result_element_type, loc)
	result: CoreExpr = variable("__result", result_type, loc)
	keep: CoreExpr = SeqExpr(
		intrinsic_call(
			"list_set_owned",
			[result, output_index, kept_value],
			VoidType,
			loc,
		),
		AssignExpr(
			core_var("__out"),
			BinaryExpr(
				AddOp,
				output_index,
				int_literal(1, loc),
				INT_TYPE,
				loc,
			),
			VoidType,
			loc,
		),
	)
	match_mapped: CoreExpr = ConstructorMatchExpr(
		mapped,
		NoReleasePolicy,
		[
			{
				constructor = "Some",
				accessor = RootAccessor,
				test = match_parts[0],
				bindings = [
					{
						variable = core_var("__value"),
						typ = result_element_type,
						accessor = match_parts[1],
						mode = MatchBorrowBindingMode,
						needs_release = type_requires_release(result_element_type)
					},
				],
				body = ConstructorMatchBodyExpr(keep)
			},
		],
		ConstructorMatchFallbackBody(void_expr(loc)),
		VoidType,
		loc,
	)
	loop_body: CoreExpr = LetExpr(
		core_var("__raw"),
		False,
		POINTER_TYPE,
		intrinsic_call(
			"list_get",
			[variable("__self", source_type, loc), index],
			POINTER_TYPE,
			loc,
		),
		LetExpr(
			core_var("__mapped"),
			False,
			option_type,
			CallExpr(ClosureCall, function_expr, [unboxed_value], option_type, loc),
			match_mapped,
		),
	)
	loop: CoreExpr = ForRangeExpr(
		{
			variable = core_var("__i"),
			typ = INT_TYPE,
			range_direction = RangeForwardOnly
		},
		int_literal(
			0,
			loc,
		),
		variable(
			"__n",
			INT_TYPE,
			loc,
		),
		loop_body,
		VoidType,
		loc,
	)
	finished: CoreExpr = SeqExpr(
		loop,
		SeqExpr(
			intrinsic_call(
				"list_set_len",
				[result, variable("__out", INT_TYPE, loc)],
				VoidType,
				loc,
			),
			result,
		),
	)

	BorrowLetExpr(
		core_var("__self"),
		source_type,
		self,
		LetExpr(
			core_var("__n"),
			False,
			INT_TYPE,
			intrinsic_call("list_len", [variable("__self", source_type, loc)], INT_TYPE, loc),
			LetExpr(
				core_var("__result"),
				False,
				result_type,
				intrinsic_call("list_alloc", [variable("__n", INT_TYPE, loc)], result_type, loc),
				LetExpr(
					core_var("__out"),
					True,
					INT_TYPE,
					int_literal(0, loc),
					finished,
				),
			),
		),
	)


---
A `Dict.get`. With a typed runtime getter for the result's Option layout the
call uses it and boxes its erased arguments. Without one the call stays the
generic `blorp_dict_get`, which the emitter renders into the result's stack
Option. In both cases a key that crosses in a fresh box (an inline record or
a 128-bit integer) is boxed here, so the box has an owner: the lookup only
borrows it, and the operation releases it once the lookup returns.
---
private pure func specialize_dict_get(
	layout: CoreSpecializeLayout,
	original: CoreExpr,
	name: String,
	callee: CoreExpr,
	args: List[CoreExpr],
	result_type: CoreType,
	loc: CoreSourceLoc,
) -> CoreExpr:
	runtime_name: Option[String] = option_runtime_name(layout, result_type, name, Some(name))
	call_name: String = runtime_name.get_or(name)

	match args:
		[dict_value, key]:
			if boxed_storage_allocates(layout, core_expr_type(key)):
				dict_get_releasing_key_box(layout, call_name, callee, dict_value, key, result_type, loc)
			else if runtime_name.is_some():
				builtin_call_with_callee(
					call_name,
					callee,
					box_collection_void_slots(layout, call_name, args, loc),
					result_type,
					loc,
				)
			else:
				original
		_:
			original


---
The lookup with its key boxed into a fresh temporary, released after the
call. A map given as an expression is bound first so it is still evaluated
before the key; a map variable is read in place, which needs no binding and
so no extra reference.
---
private pure func dict_get_releasing_key_box(
	layout: CoreSpecializeLayout,
	call_name: String,
	callee: CoreExpr,
	dict_value: CoreExpr,
	key: CoreExpr,
	result_type: CoreType,
	loc: CoreSourceLoc,
) -> CoreExpr:
	dict_type: CoreType = core_expr_type(dict_value)
	map_value: CoreExpr = match dict_value:
		VarExpr(_, _, _):
			dict_value
		_:
			variable("__dict_get_map", dict_type, loc)
	key_box: CoreExpr = variable("__dict_get_key_box", POINTER_TYPE, loc)
	found: CoreExpr = variable("__dict_get_found", result_type, loc)
	lookup: CoreExpr = LetExpr(
		core_var("__dict_get_key_box"),
		False,
		POINTER_TYPE,
		box_void_slot_argument(layout, key, loc),
		LetExpr(
			core_var("__dict_get_found"),
			False,
			result_type,
			builtin_call_with_callee(call_name, callee, [map_value, key_box], result_type, loc),
			SeqExpr(intrinsic_call(RELEASE_HASH_KEY_BOX, [key_box], VoidType, loc), found),
		),
	)

	match dict_value:
		VarExpr(_, _, _):
			lookup
		_:
			LetExpr(core_var("__dict_get_map"), False, dict_type, dict_value, lookup)


private pure func specialize_collection_call(
	layout: CoreSpecializeLayout,
	original: CoreExpr,
	name: String,
	callee: CoreExpr,
	args: List[CoreExpr],
	result_type: CoreType,
	loc: CoreSourceLoc,
) -> CoreExpr:
	if name == "blorp_dict_with_capacity" and args.length() == 1:
		match dict_type_parts(layout, result_type):
			Some((key_type, _)):
				builtin_call_with_callee(
					dict_capacity_constructor_name(layout, key_type),
					callee,
					args,
					result_type,
					loc,
				)
			None:
				original
	else if name == "blorp_channel_recv" or name == "blorp_channel_try_recv":
		-- Known fault (DIAGNOSTIC_GAPS CF-018): with no typed receive, an enum
		-- or 128-bit payload keeps the erased receive although its Option is a
		-- stack struct, and the C does not compile. Inline records take a
		-- raw-slot receive in the emitter (`emit_inline_record_channel_receive`);
		-- choosing that receive here for every stack-Option payload fixes both.
		match option_runtime_name(layout, result_type, name, Some(name)):
			Some(runtime_name):
				builtin_call_with_callee(runtime_name, callee, args, result_type, loc)
			None:
				original
	else if name == "blorp_channel_recv_timeout":
		match option_runtime_name(layout, result_type, name, Some(name)):
			Some(runtime_name):
				builtin_call_with_callee(runtime_name, callee, args, result_type, loc)
			None:
				original
	else if (
		name == "blorp_getenv"
		or name == "blorp_decode_utf8"
		or name == "blorp_base64_decode"
		or name == "blorp_bytes_from_hex"
	):
		match option_payload_runtime_layout(
			layout,
			single_named_type_argument(layout, result_type, "Option").get_or(VoidType),
		):
			NullableManagedOptionLayout:
				builtin_call_with_callee(name + "_nullable", callee, args, result_type, loc)
			_:
				original
	else if name == "blorp_stream_repeat" and args.length() == 1:
		match erased_stream_result_layout(layout, result_type, True):
			Some(element_layout):
				builtin_call_with_callee(
					name,
					callee,
					[stream_runtime_value_argument(
							layout,
							element_layout,
							args.get_or(0, void_expr(loc)),
							loc,
						), int_literal(stream_element_layout_code(element_layout), loc)],
					result_type,
					loc,
				)
			None:
				original
	else if name == "blorp_set_add" and args.length() == 2:
		set_expr: CoreExpr = refine_immediate_set_constructor(
			layout,
			args.get_or(1, void_expr(loc)),
			args.get_or(0, void_expr(loc)),
		)
		builtin_call_with_callee(
			name,
			callee,
			box_collection_void_slots(
				layout,
				name,
				[set_expr, args.get_or(1, void_expr(loc))],
				loc,
			),
			result_type,
			loc,
		)
	else if name == "blorp_dict_insert" and args.length() == 3:
		key: CoreExpr = args.get_or(1, void_expr(loc))
		value: CoreExpr = args.get_or(2, void_expr(loc))
		dict_expr: CoreExpr = refine_immediate_dict_constructor(
			layout,
			key,
			value,
			args.get_or(0, void_expr(loc)),
		)
		builtin_call_with_callee(
			name,
			callee,
			box_collection_void_slots(
				layout,
				name,
				[dict_expr, key, value],
				loc,
			),
			result_type,
			loc,
		)
	else if name == "blorp_dict_get":
		specialize_dict_get(layout, original, name, callee, args, result_type, loc)
	else if name == "blorp_stream_find":
		match option_runtime_name(layout, result_type, name, Some(name)):
			Some(runtime_name):
				builtin_call_with_callee(runtime_name, callee, args, result_type, loc)
			None:
				original
	else if name == "blorp_stream_unfold" and args.length() == 2:
		match erased_stream_result_layout(layout, result_type, False):
			Some(element_layout):
				seed: CoreExpr = args.get_or(0, void_expr(loc))
				state_layout: CoreStreamElementLayout = stream_state_layout(
					layout,
					core_expr_type(seed),
				)
				builtin_call_with_callee(
					name,
					callee,
					[
						stream_runtime_value_argument(layout, state_layout, seed, loc),
						args.get_or(1, void_expr(loc)),
						int_literal(stream_element_layout_code(element_layout), loc),
						int_literal(stream_element_layout_code(state_layout), loc),
					],
					result_type,
					loc,
				)
			None:
				original
	else if name == "blorp_stream_map" and args.length() == 2:
		match erased_stream_result_layout(layout, result_type, False):
			Some(element_layout):
				builtin_call_with_callee(
					name,
					callee,
					args.append(int_literal(stream_element_layout_code(element_layout), loc)),
					result_type,
					loc,
				)
			None:
				original
	else if name == "blorp_stream_filter_map":
		match stream_filter_map_runtime_name(layout, result_type, name):
			Some(runtime_name):
				builtin_call_with_callee(runtime_name, callee, args, result_type, loc)
			None:
				original
	else if name == "blorp_set_new" and args.is_empty():
		match set_type_element(layout, result_type):
			Some(element_type):
				builtin_call_with_callee(
					set_constructor_name(layout, element_type),
					callee,
					[],
					result_type,
					loc,
				)
			None:
				original
	else if name == "blorp_dict_new" and args.is_empty():
		match dict_type_parts(layout, result_type):
			Some((key_type, _)):
				builtin_call_with_callee(
					dict_constructor_name(layout, key_type),
					callee,
					[],
					result_type,
					loc,
				)
			None:
				original
	else if name == "blorp_filter_map_parallel" and args.length() == 2:
		match list_filter_map_runtime_name(layout, result_type, name):
			Some(runtime_name):
				element_type: CoreType = list_element_type(layout, result_type).get_or(POINTER_TYPE)
				append_release_flag(
					runtime_name,
					callee,
					args,
					result_type,
					boxed_storage_slot_needs_release(layout, element_type),
					loc,
				)
			None:
				list_filter_map_fallback(
					layout,
					args.get_or(0, void_expr(loc)),
					args.get_or(1, void_expr(loc)),
					result_type,
					loc,
				).get_or(original)
	else if list_parallel_map_arity(name, args.length()):
		element_type: CoreType = list_element_type(layout, result_type).get_or(POINTER_TYPE)
		append_release_flag(
			name,
			callee,
			args,
			result_type,
			boxed_storage_slot_needs_release(layout, element_type),
			loc,
		)
	else if tensor_collection_map_arity(name, args.length()):
		match tensor_result_element_type(layout, result_type):
			Some(element_type):
				append_release_flag(
					name,
					callee,
					args,
					result_type,
					boxed_storage_slot_needs_release(layout, element_type),
					loc,
				)
			None:
				original
	else if (
		name == "blorp_fold_parallel"
		or name == "blorp_fold_parallel_ordered"
		or name == "blorp_fold_parallel_with"
		or name == "blorp_fold_parallel_ordered_with"
		or name == "blorp_stream_fold"
	):
		init_type: CoreType = match args.get(1):
			Some(init):
				core_expr_type(init)
			None:
				VoidType

		boxed_args: List[CoreExpr] = box_collection_void_slots(layout, name, args, loc)
		raw: CoreExpr = append_release_flag(
			name,
			callee,
			boxed_args,
			POINTER_TYPE,
			boxed_storage_slot_needs_release(layout, init_type),
			loc,
		)

		if specialize_type_is_pointer(layout, result_type):
			CastExpr(raw, result_type, loc)
		else:
			UnboxExpr(
				boxed_storage_unbox_kind(layout, result_type),
				raw,
				result_type,
				loc,
			)
	else if name == "blorp_fallible_stream_fold_raw":
		init_type: CoreType = match args.get(1):
			Some(init):
				core_expr_type(init)
			None:
				VoidType

		append_release_flag(
			name,
			callee,
			box_collection_void_slots(layout, name, args, loc),
			result_type,
			boxed_storage_slot_needs_release(layout, init_type),
			loc,
		)
	else if name == "blorp_fallible_stream_find_raw":
		match fallible_find_runtime_name(layout, result_type, name):
			Some(runtime_name):
				builtin_call_with_callee(runtime_name, callee, args, result_type, loc)
			None:
				original
	else:
		boxed_args: List[CoreExpr] = box_collection_void_slots(layout, name, args, loc)

		if not collection_has_erased_arguments(name):
			original
		else:
			builtin_call_with_callee(name, callee, boxed_args, result_type, loc)


pure func specialize_collection_expr(layout: CoreSpecializeLayout, expr: CoreExpr) -> CoreExpr:
	canonical: CoreExpr = canonicalize_erased_storage_metadata(layout, expr)

	match canonical:
		BoxExpr(box, _, loc):
			effective_source_type: CoreType = if core_type_has_unresolved_mono_parameters(
				box.source_type,
			):
				core_expr_type(box.value)
			else:
				box.source_type

			if (
				not core_type_has_unresolved_mono_parameters(effective_source_type)
				and specialize_type_is_pointer(layout, effective_source_type)
			):
				CastExpr(box.value, POINTER_TYPE, loc)
			else:
				canonical
		CallExpr(kind, callee, args, result_type, loc):
			erased_key_release: Option[CoreExpr] = match kind:
				IntrinsicCall(name):
					if is_erased_key_temp_marker(name):
						resolve_erased_key_temp_release(layout, args, loc)
					else:
						None
				_:
					None

			is_list_alloc: Bool = match kind:
				IntrinsicCall("list_alloc"):
					True
				BuiltinCall("blorp_list_new"):
					True
				_:
					False

			match erased_key_release:
				Some(release):
					release
				None:
					if is_list_alloc and args.length() == 1:
						element_type: CoreType = list_element_type(
							layout,
							result_type,
						).get_or(POINTER_TYPE)
						ListAllocExpr(
							{
								layout = specialize_list_layout(layout, result_type),
								capacity = args.get_or(0, void_expr(loc)),
								elem_needs_release = specialize_list_element_needs_release(
									layout,
									element_type,
								)
							},
							result_type,
							loc,
						)
					else:
						match kind:
							BuiltinCall(name):
								specialize_collection_call(
									layout,
									canonical,
									name,
									callee,
									args,
									result_type,
									loc,
								)
							_:
								canonical
		_:
			canonical
