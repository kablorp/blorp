-- Single post-monomorphization Core synthesis orchestrator.
--
-- Family modules only construct bodies. This module alone walks declarations
-- and assigns a successfully synthesized declaration its concrete callable
-- identity, keeping the stage transition explicit and testable.
import:
	builtin_registry: core_builtin_name
	ir:
		CoreDecl(FunctionDecl, ImplDecl),
		CoreDeclarationIndex,
		CoreExpr,
		CoreFunction,
		CoreFunctionKind(BuiltinFunction, ProgramEntrypointFunction, UserFunction),
		CoreFunctionOrigin(Synthesized),
		CoreImplDecl,
		CoreProgram,
		CoreSynthesisKind(
			BytesSynthesis, FixedSynthesis, FloatSynthesis, ForwardSynthesis,
			HashCollectionSynthesis, ListSynthesis, ParallelTensorSynthesis,
			ScalarOperatorSynthesis, SliceSynthesis, StringSynthesis, TensorSynthesis,
		),
		core_function_declared_origin,
		is_program_entrypoint_function_kind,
	list: list as allocate_list
	synth_bytes: synthesize_bytes_body
	synth_context: CoreSynthContext, core_synth_context
	synth_error: CoreSynthError
	synth_fixed: synthesize_fixed_body
	synth_float: synthesize_float_body
	synth_forward: synthesize_forward_body
	synth_hash_collections: synthesize_hash_collection_body
	synth_list: synthesize_list_body
	synth_name: synthesis_member
	synth_parallel_tensor: synthesize_parallel_tensor_body
	synth_scalar_operator: synthesize_scalar_operator_impl_body
	synth_slice: synthesize_slice_body
	synth_string: synthesize_string_body
	synth_tensor: synthesize_tensor_body


---
A synthesized body together with the pass that supplied it, so the function
records `Synthesized(kind, ...)` as its origin.
---
private record SynthesizedBody {
	kind: CoreSynthesisKind,
	body: CoreExpr
}


private pure func attributed_to(
	kind: CoreSynthesisKind,
	body: Option[CoreExpr],
) -> Option[SynthesizedBody]:
	-- A `match`, not `body.map(...)`: the closure `map` takes would be allocated
	-- on every attempt, and nearly every attempt over every function is a miss.
	match body:
		Some(supplied):
			Some({
				kind = kind,
				body = supplied,
			})
		None:
			None


private pure func synthesize_infallible_body(
	function_info: CoreFunction,
	member: String,
) -> Option[SynthesizedBody]:
	var body: Option[SynthesizedBody] = attributed_to(
		BytesSynthesis,
		synthesize_bytes_body(function_info, member),
	)

	if body.is_none():
		body = attributed_to(
			FixedSynthesis,
			synthesize_fixed_body(function_info, member),
		)

	if body.is_none():
		body = attributed_to(
			FloatSynthesis,
			synthesize_float_body(function_info, member),
		)

	if body.is_none():
		body = attributed_to(
			ForwardSynthesis,
			synthesize_forward_body(function_info, member),
		)

	if body.is_none():
		body = attributed_to(
			SliceSynthesis,
			synthesize_slice_body(function_info, member),
		)

	if body.is_none():
		body = attributed_to(
			StringSynthesis,
			synthesize_string_body(function_info, member),
		)

	if body.is_none():
		body = attributed_to(
			ListSynthesis,
			synthesize_list_body(function_info, member),
		)

	if body.is_none():
		body = attributed_to(
			ParallelTensorSynthesis,
			synthesize_parallel_tensor_body(function_info, member),
		)

	body


private pure func synthesized_function_kind(
	declaration: CoreFunction,
	member: String,
) -> CoreFunctionKind:
	if is_program_entrypoint_function_kind(declaration.function_kind):
		ProgramEntrypointFunction
	else:
		match declaration.source_module:
			Some(module_name):
				match core_builtin_name(module_name, member):
					Some(runtime_name):
						BuiltinFunction(runtime_name)
					None:
						UserFunction
			None:
				UserFunction


private pure func synthesize_function(
	context: CoreSynthContext,
	function_info: CoreFunction,
) -> Result[CoreFunction, CoreSynthError]:
	match synthesis_member(context.declarations, function_info):
		Some(member):
			synthesize_function_named(context, function_info, member)
		None:
			Ok(function_info)


private pure func synthesize_function_named(
	context: CoreSynthContext,
	function_info: CoreFunction,
	member: String,
) -> Result[CoreFunction, CoreSynthError]:
	hash_collection_body ?= synthesize_hash_collection_body(context, function_info, member)
	tensor_body ?= synthesize_tensor_body(function_info, member)
	var body: Option[SynthesizedBody] = attributed_to(HashCollectionSynthesis, hash_collection_body)

	if body.is_none():
		body = attributed_to(TensorSynthesis, tensor_body)

	if body.is_none():
		body = synthesize_infallible_body(function_info, member)

	match body:
		Some(synthesized):
			Ok(synthesized_function(function_info, member, synthesized))
		None:
			Ok(function_info)


---
`function_info` with the body a synthesis pass supplied. The origin records
the pass and keeps the origin the function was declared with.
---
private pure func synthesized_function(
	function_info: CoreFunction,
	member: String,
	synthesized: SynthesizedBody,
) -> CoreFunction:
	{ function_info |
		body = Some(synthesized.body),
		function_kind = synthesized_function_kind(function_info, member),
		origin = Synthesized(synthesized.kind, core_function_declared_origin(function_info.origin))
	}


private pure func synthesize_impl_method(
	context: CoreSynthContext,
	implementation: CoreImplDecl,
	function_info: CoreFunction,
) -> Result[CoreFunction, CoreSynthError]:
	match synthesis_member(context.declarations, function_info):
		Some(member):
			scalar_operator_body: Option[CoreExpr] = synthesize_scalar_operator_impl_body(
				implementation.trait_name,
				implementation.for_type,
				function_info,
				member,
			)

			match scalar_operator_body:
				Some(body):
					Ok({ function_info |
							body = Some(body),
							origin = Synthesized(
								ScalarOperatorSynthesis,
								core_function_declared_origin(function_info.origin),
							)
						})
				None:
					synthesize_function_named(context, function_info, member)
		None:
			Ok(function_info)


private pure func synthesize_impl_methods(
	context: CoreSynthContext,
	implementation: CoreImplDecl,
) -> Result[List[CoreFunction], CoreSynthError]:
	var synthesized_methods: List[CoreFunction] = allocate_list(implementation.methods.length())
	var failure: Option[CoreSynthError] = None

	for method in implementation.methods:
		match synthesize_impl_method(context, implementation, method):
			Ok(synthesized):
				synthesized_methods = synthesized_methods.append(synthesized)
			Err(error):
				failure = Some(error)
				break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(synthesized_methods)


private pure func synthesize_decl(
	context: CoreSynthContext,
	decl: CoreDecl,
) -> Result[CoreDecl, CoreSynthError]:
	match decl:
		FunctionDecl(function_info):
			synthesized ?= synthesize_function(context, function_info)
			Ok(FunctionDecl(synthesized))
		ImplDecl(impl_info):
			methods ?= synthesize_impl_methods(context, impl_info)
			Ok(ImplDecl({ impl_info | methods = methods }))
		_:
			Ok(decl)


pure func synthesize_program(
	declarations: CoreDeclarationIndex,
	program: CoreProgram,
) -> Result[CoreProgram, CoreSynthError]:
	context: CoreSynthContext = core_synth_context(declarations, program)
	var decls: List[CoreDecl] = allocate_list(program.decls.length())
	var failure: Option[CoreSynthError] = None

	for decl in program.decls:
		match synthesize_decl(context, decl):
			Ok(synthesized):
				decls = decls.append(synthesized)
			Err(error):
				failure = Some(error)
				break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok({
				decls = decls,
				foreign_includes = program.foreign_includes,
				source_files = program.source_files,
			})
