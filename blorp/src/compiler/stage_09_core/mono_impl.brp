-- Demand-driven generic trait-implementation specialization.
--
-- Dispatch identity comes from a selected/deferred trait call or the canonical
-- operation table. Method names alone are never sufficient because unrelated
-- traits may intentionally use the same name.
import:
	hash: hash_combine
	ir:
		CoreCallKind(BuiltinCall, DeferredTraitCall, SelectedDirectCall, SelectedTraitCall),
		CoreDecl(FunctionDecl, GlobalDecl, ImplDecl),
		CoreExpr(BinaryExpr, CallExpr, DictExpr, LogicalExpr, SeqExpr, UnaryExpr, VarExpr),
		CoreFunction,
		CoreImplDecl,
		CoreMonoSubstitution,
		CoreMonoSubstitutionValue(TypeSubstitution),
		CoreProgram,
		CoreSourceLoc,
		CoreType(NamedType, TupleType),
		CoreTypeParam,
		CoreVar,
		core_expr_type,
	mono:
		apply_type_substitution,
		collect_type_substitution,
		core_mono_type_equal,
		core_type_contains_parameter,
		erase_core_mono_value_refinements,
		is_concrete_substitution,
		mangle_generic_data_name,
	mono_instance: core_mono_type_hash
	mono_specialize:
		CoreMonoDiagnostic(CoreMonoConflictingImplMethods),
		CoreMonoProgramSpecialization,
	mono_substitute: substitute_core_decl_types
	trait_dispatch:
		CoreTraitMethodIdentity,
		core_binary_trait_method,
		core_builtin_trait_method,
		core_hash_key_equals_method,
		core_hash_key_hash_method,
		core_unary_trait_method,
	traverse as CoreTraverse: CoreMapState
	type_policy as CoreTypePolicy


private record CoreMonoImplRequest {
	template: CoreImplDecl,
	substitution: CoreMonoSubstitution,
	concrete_for_type: CoreType,
	key: String
}


private record CoreMonoImplMaterialization {
	decl: CoreDecl,
	next_def_id: Int,
	method_selections: List[CoreMonoImplMethodSelection]
}


record CoreMonoImplMethodSelection {
	source_def_id: Int,
	closed_receiver: CoreType,
	target_def_id: Int
}


type alias CoreMonoImplSelectionIndex = Dict[Int, List[CoreMonoImplMethodSelection]]


union CoreMonoImplSelectionLookup:
	NoSelectedImpl
	SelectedImpl(Int)
	ConflictingSelectedImpl(Int, Int)


---
Result of `specialize_generic_impls_with_templates`. `processed_decl_count`
is how many leading decls of `program.decls` have had requests collected;
pass it back in on the next call to skip them.
---
record CoreMonoImplSpecializationStep {
	program: CoreProgram,
	next_def_id: Int,
	processed_decl_count: Int,
	method_selections: List[CoreMonoImplMethodSelection]
}


private record CoreMonoMethodIdRewrite {
	source_def_id: Int,
	target_def_id: Int
}


private type alias CoreMonoDefIdMap = List[CoreMonoMethodIdRewrite]

private LIST_TYPE_NAME: String = "List"

private TO_STRING_CORE_SENTINEL: String = "blorp_to_string"

private DICT_TYPE_NAME: String = "Dict"

private SET_TYPE_NAME: String = "Set"


private pure func impl_type_param_names(type_params: List[CoreTypeParam]) -> List[String]:
	type_params.map(pure func(param): param.name)


private pure func impl_has_method(methods: List[CoreFunction], method_name: String) -> Bool:
	methods.any(pure func(method):
		method.name == method_name and method.body.is_some()
	)


---
Exported (not `private`): `monomorphize.brp` collects this once from the
input program and holds it across the outer callable fixpoint, since
specialized impls always carry `type_params = []` and never join the
template list. `concrete_impl_keys` has no such invariant and is still
recomputed from the current program each iteration.
---
pure func generic_impls(program: CoreProgram) -> List[CoreImplDecl]:
	program.decls.flat_map(pure func(decl) -> List[CoreImplDecl]:
		match decl:
			ImplDecl(impl):
				if impl.type_params.is_empty():
					[]
				else:
					[impl]
			_:
				[]
	)


private pure func impl_key(trait_name: String, for_type: CoreType) -> Option[String]:
	mangle_generic_data_name(trait_name, [for_type])


private pure func concrete_impl_keys(program: CoreProgram) -> List[String]:
	var keys: List[String] = []

	for decl in program.decls:
		match decl:
			ImplDecl(impl):
				if impl.type_params.is_empty():
					match impl_key(impl.trait_name, impl.for_type):
						Some(key):
							if not keys.contains(key):
								keys = keys.append(key)
						None:
							void
			_:
				void

	keys


private pure func request_key_is_known(
	concrete_keys: List[String],
	requests: List[CoreMonoImplRequest],
	key: String,
) -> Bool:
	concrete_keys.contains(key) or requests.any(pure func(request): request.key == key)


private pure func append_request(
	concrete_keys: List[String],
	requests: List[CoreMonoImplRequest],
	request: CoreMonoImplRequest,
) -> List[CoreMonoImplRequest]:
	if request_key_is_known(concrete_keys, requests, request.key):
		requests
	else:
		requests.append(request)


private pure func candidate_request(
	impl: CoreImplDecl,
	unresolved_type_params: List[String],
	receiver_type: CoreType,
) -> Option[CoreMonoImplRequest]:
	type_params: List[String] = impl_type_param_names(impl.type_params)

	match collect_type_substitution(
		type_params,
		unresolved_type_params,
		impl.for_type,
		receiver_type,
		[],
	):
		Some(substitution):
			concrete_for_type: CoreType = apply_type_substitution(substitution, impl.for_type)

			if (
				substitution.is_empty()
				or not is_concrete_substitution(unresolved_type_params, substitution)
				or core_type_contains_parameter(type_params, concrete_for_type)
			):
				None
			else:
				match impl_key(impl.trait_name, concrete_for_type):
					Some(key):
						Some({
							template = impl,
							substitution = substitution,
							concrete_for_type = concrete_for_type,
							key = key,
						})
					None:
						None
		None:
			None


private pure func request_for_trait(
	generic_impls: List[CoreImplDecl],
	concrete_keys: List[String],
	requests: List[CoreMonoImplRequest],
	unresolved_type_params: List[String],
	trait_name: String,
	method_name: Option[String],
	selection_def_id: Option[Int],
	receiver_type: CoreType,
) -> Option[CoreMonoImplRequest]:
	var found: Option[CoreMonoImplRequest] = None
	var ambiguous: Bool = False

	for impl in generic_impls:
		method_matches: Bool = match method_name:
			Some(name):
				-- Callable ids are graph-wide before monomorphization. Target-module
				-- methods intentionally have no source_module, so naming metadata
				-- cannot participate in identity checks here.
				match selection_def_id:
					Some(def_id):
						impl.methods.any(pure func(method):
							(
								method.name == name
								and method.def_id == def_id
								and method.body.is_some()
							)
						)
					None:
						impl_has_method(impl.methods, name)
			None:
				True

		if impl.trait_name == trait_name and method_matches:
			match candidate_request(impl, unresolved_type_params, receiver_type):
				Some(request):
					if not request_key_is_known(concrete_keys, requests, request.key):
						match found:
							Some(_):
								ambiguous = True
								break
							None:
								found = Some(request)
				None:
					void

	if ambiguous:
		None
	else:
		found


private pure func dispatch_receiver_type(args: List[CoreExpr], result_type: CoreType) -> CoreType:
	args
		.get(0)
		.map(core_expr_type)
		.get_or(result_type)


private pure func request_for_identity(
	generic_impls: List[CoreImplDecl],
	concrete_keys: List[String],
	requests: List[CoreMonoImplRequest],
	unresolved_type_params: List[String],
	identity: CoreTraitMethodIdentity,
	receiver_type: CoreType,
) -> Option[CoreMonoImplRequest]:
	request_for_trait(
		generic_impls,
		concrete_keys,
		requests,
		unresolved_type_params,
		identity.trait_name,
		Some(identity.method_name),
		None,
		receiver_type,
	)


private pure func list_element_type(typ: CoreType) -> Option[CoreType]:
	match typ:
		NamedType(name, args):
			if name == LIST_TYPE_NAME:
				args.get(0)
			else:
				None
		_:
			None


---
The key type of a Dict or Set value, when it instantiates a generic type. A
generic impl template can only match an instantiated type, so bare named
keys (Int, String, user records) never need a materialization request, and
skipping them keeps this off the hot path of every `dict.set` call.
---
private pure func hash_container_key_type(typ: CoreType) -> Option[CoreType]:
	key_type ?= match typ:
		NamedType(name, args):
			if name == DICT_TYPE_NAME and args.length() == 2:
				args.get(0)
			else if name == SET_TYPE_NAME and args.length() == 1:
				args.get(0)
			else:
				None
		_:
			None

	match key_type:
		NamedType(_, []):
			None
		NamedType(_, _) | TupleType(_):
			Some(key_type)
		_:
			None


--- A container is only ever produced by a call or a literal.
private pure func hash_container_produced_key_type(expr: CoreExpr) -> Option[CoreType]:
	match expr:
		CallExpr(_, _, _, result_type, _):
			hash_container_key_type(result_type)
		DictExpr(_, typ, _):
			hash_container_key_type(typ)
		_:
			None


private pure func append_identity_request(
	generic_impls: List[CoreImplDecl],
	concrete_keys: List[String],
	requests: List[CoreMonoImplRequest],
	unresolved_type_params: List[String],
	identity: CoreTraitMethodIdentity,
	receiver_type: CoreType,
) -> List[CoreMonoImplRequest]:
	match request_for_identity(
		generic_impls,
		concrete_keys,
		requests,
		unresolved_type_params,
		identity,
		receiver_type,
	):
		Some(request):
			append_request(concrete_keys, requests, request)
		None:
			requests


---
Dict and Set hash and compare keys through the key type's Hashable and
Equatable impls (`hash_key_callbacks`), which nothing else calls directly.
---
private pure func collect_hash_key_requests(
	generic_impls: List[CoreImplDecl],
	concrete_keys: List[String],
	requests: List[CoreMonoImplRequest],
	unresolved_type_params: List[String],
	expr: CoreExpr,
) -> List[CoreMonoImplRequest]:
	match hash_container_produced_key_type(expr):
		Some(key_type):
			with_hash: List[CoreMonoImplRequest] = append_identity_request(
				generic_impls,
				concrete_keys,
				requests,
				unresolved_type_params,
				core_hash_key_hash_method(),
				key_type,
			)
			append_identity_request(
				generic_impls,
				concrete_keys,
				with_hash,
				unresolved_type_params,
				core_hash_key_equals_method(),
				key_type,
			)
		None:
			requests


private pure func collect_builtin_trait_dependency_requests(
	generic_impls: List[CoreImplDecl],
	concrete_keys: List[String],
	requests: List[CoreMonoImplRequest],
	unresolved_type_params: List[String],
	expr: CoreExpr,
) -> List[CoreMonoImplRequest]:
	match expr:
		CallExpr(BuiltinCall(name), _, args, result_type, _):
			if name != TO_STRING_CORE_SENTINEL:
				requests
			else:
				match list_element_type(dispatch_receiver_type(args, result_type)):
					Some(element_type):
						match core_builtin_trait_method(name):
							Some(identity):
								match request_for_identity(
									generic_impls,
									concrete_keys,
									requests,
									unresolved_type_params,
									identity,
									element_type,
								):
									Some(request):
										append_request(concrete_keys, requests, request)
									None:
										requests
							None:
								requests
					None:
						requests
		_:
			requests


private pure func request_for_expr(
	generic_impls: List[CoreImplDecl],
	concrete_keys: List[String],
	requests: List[CoreMonoImplRequest],
	unresolved_type_params: List[String],
	expr: CoreExpr,
) -> Option[CoreMonoImplRequest]:
	match expr:
		CallExpr(DeferredTraitCall(trait_name, method_name), _, args, result_type, _):
			request_for_trait(
				generic_impls,
				concrete_keys,
				requests,
				unresolved_type_params,
				trait_name,
				Some(method_name),
				None,
				dispatch_receiver_type(args, result_type),
			)
		CallExpr(SelectedTraitCall(trait_name, method_name, _, def_id), _, args, result_type, _):
			request_for_trait(
				generic_impls,
				concrete_keys,
				requests,
				unresolved_type_params,
				trait_name,
				Some(method_name),
				Some(def_id),
				dispatch_receiver_type(args, result_type),
			)
		CallExpr(BuiltinCall(name), _, args, result_type, _):
			match core_builtin_trait_method(name):
				Some(identity):
					request_for_identity(
						generic_impls,
						concrete_keys,
						requests,
						unresolved_type_params,
						identity,
						dispatch_receiver_type(args, result_type),
					)
				None:
					None
		BinaryExpr(op, left, _, _, _):
			request_for_identity(
				generic_impls,
				concrete_keys,
				requests,
				unresolved_type_params,
				core_binary_trait_method(op),
				core_expr_type(left),
			)
		UnaryExpr(op, operand, _, _):
			match core_unary_trait_method(op):
				Some(identity):
					request_for_identity(
						generic_impls,
						concrete_keys,
						requests,
						unresolved_type_params,
						identity,
						core_expr_type(operand),
					)
				None:
					None
		_:
			None


private pure func collect_expr_requests(
	generic_impls: List[CoreImplDecl],
	concrete_keys: List[String],
	requests: List[CoreMonoImplRequest],
	unresolved_type_params: List[String],
	expr: CoreExpr,
) -> List[CoreMonoImplRequest]:
	var collected: List[CoreMonoImplRequest] = requests
	var pending: List[CoreExpr] = [expr]
	var index: Int = 0

	while index < pending.length():
		match pending.get(index):
			Some(node):
				match request_for_expr(
					generic_impls,
					concrete_keys,
					collected,
					unresolved_type_params,
					node,
				):
					Some(request):
						collected = append_request(concrete_keys, collected, request)
					None:
						void

				collected = collect_builtin_trait_dependency_requests(
					generic_impls,
					concrete_keys,
					collected,
					unresolved_type_params,
					node,
				)
				collected = collect_hash_key_requests(
					generic_impls,
					concrete_keys,
					collected,
					unresolved_type_params,
					node,
				)

				for child in CoreTraverse.immediate_core_expr_children(node):
					pending = pending.append(child)
			None:
				break

		index += 1

	collected


private pure func collect_function_requests(
	generic_impls: List[CoreImplDecl],
	concrete_keys: List[String],
	requests: List[CoreMonoImplRequest],
	inherited_type_params: List[String],
	function: CoreFunction,
) -> List[CoreMonoImplRequest]:
	match function.body:
		Some(body):
			collect_expr_requests(
				generic_impls,
				concrete_keys,
				requests,
				inherited_type_params.concat(function.type_params),
				body,
			)
		None:
			requests


private pure func collect_impl_requests(
	generic_impls: List[CoreImplDecl],
	concrete_keys: List[String],
	requests: List[CoreMonoImplRequest],
	impl: CoreImplDecl,
) -> List[CoreMonoImplRequest]:
	var collected: List[CoreMonoImplRequest] = requests
	inherited_type_params: List[String] = impl_type_param_names(impl.type_params)

	for method in impl.methods:
		collected = collect_function_requests(
			generic_impls,
			concrete_keys,
			collected,
			inherited_type_params,
			method,
		)

	collected


private pure func collect_program_requests(
	generic_impls: List[CoreImplDecl],
	concrete_keys: List[String],
	decls: List[CoreDecl],
) -> List[CoreMonoImplRequest]:
	var requests: List[CoreMonoImplRequest] = []

	for decl in decls:
		match decl:
			FunctionDecl(function):
				requests = collect_function_requests(
					generic_impls,
					concrete_keys,
					requests,
					[],
					function,
				)
			GlobalDecl(global):
				requests = collect_expr_requests(
					generic_impls,
					concrete_keys,
					requests,
					[],
					global.init,
				)
			ImplDecl(impl):
				requests = collect_impl_requests(generic_impls, concrete_keys, requests, impl)
			_:
				void

	requests


private pure func substitution_type(
	substitution: CoreMonoSubstitution,
	name: String,
) -> Option[CoreType]:
	var result: Option[CoreType] = None

	for binding in substitution:
		if binding[0] == name:
			match binding[1]:
				TypeSubstitution(typ):
					result = Some(typ)
				_:
					void

			break

	result


private pure func collect_bound_requests(
	generic_impls: List[CoreImplDecl],
	concrete_keys: List[String],
	requests: List[CoreMonoImplRequest],
	request: CoreMonoImplRequest,
) -> List[CoreMonoImplRequest]:
	var collected: List[CoreMonoImplRequest] = requests

	for param in request.template.type_params:
		match substitution_type(request.substitution, param.name):
			Some(concrete_type):
				for trait_name in param.bounds:
					match request_for_trait(
						generic_impls,
						concrete_keys,
						collected,
						[],
						trait_name,
						None,
						None,
						concrete_type,
					):
						Some(bound_request):
							collected = append_request(concrete_keys, collected, bound_request)
						None:
							void
			None:
				void

	collected


private pure func replacement_def_id(mapping: CoreMonoDefIdMap, def_id: Int) -> Option[Int]:
	var replacement: Option[Int] = None

	for entry in mapping:
		if entry.source_def_id == def_id:
			replacement = Some(entry.target_def_id)
			break

	replacement


private pure func replace_var_def_id(mapping: CoreMonoDefIdMap, variable: CoreVar) -> CoreVar:
	match variable.def_id:
		Some(def_id):
			match replacement_def_id(mapping, def_id):
				Some(replacement):
					{ variable | def_id = Some(replacement) }
				None:
					variable
		None:
			variable


private pure func rewrite_sequence_method_references(
	mapping: CoreMonoDefIdMap,
	expr: CoreExpr,
) -> CoreExpr:
	spine = CoreTraverse.split_core_sequence(expr)
	var preceding_items: List[CoreExpr] = []

	for item in spine.preceding_items:
		preceding_items = preceding_items.append(rewrite_method_references(mapping, item))

	CoreTraverse.rebuild_core_sequence({
		preceding_items = preceding_items,
		final_item = rewrite_method_references(mapping, spine.final_item),
	})


private pure func rewrite_method_references(mapping: CoreMonoDefIdMap, expr: CoreExpr) -> CoreExpr:
	match expr:
		CallExpr(SelectedTraitCall(trait_name, method_name, module_path, def_id), callee, args, typ, loc):
			-- The same source method can be called on a different closed receiver.
			-- Preserve its callee identity until the final receiver-aware remap.
			CallExpr(
				SelectedTraitCall(trait_name, method_name, module_path, def_id),
				callee,
				args.map(pure func(arg): rewrite_method_references(mapping, arg)),
				typ,
				loc,
			)
		SeqExpr(_, _):
			rewrite_sequence_method_references(mapping, expr)
		LogicalExpr(_, _, _, _, _):
			CoreTraverse.map_core_logical_tree_with_context(
				expr,
				mapping,
				rewrite_method_references,
			)
		_:
			children_rewritten: CoreExpr = CoreTraverse.map_core_expr_children_with_context(
				expr,
				mapping,
				rewrite_method_references,
			)

			match children_rewritten:
				VarExpr(variable, typ, loc):
					VarExpr(
						replace_var_def_id(mapping, variable),
						typ,
						loc,
					)
				CallExpr(SelectedDirectCall(def_id), callee, args, typ, loc):
					match callee:
						VarExpr(variable, _, _):
							match replacement_def_id(mapping, def_id):
								Some(replacement):
									CallExpr(
										SelectedDirectCall(replacement),
										callee,
										args,
										typ,
										loc,
									)
								None:
									children_rewritten
						_:
							children_rewritten
				_:
					children_rewritten


private pure func method_def_id_mapping(
	methods: List[CoreFunction],
	next_def_id: Int,
) -> CoreMonoDefIdMap:
	var mapping: CoreMonoDefIdMap = []
	var current_def_id: Int = next_def_id

	for method in methods:
		mapping = mapping.append({
			source_def_id = method.def_id,
			target_def_id = current_def_id,
		})
		current_def_id += 1

	mapping


private pure func specialize_method(
	mapping: CoreMonoDefIdMap,
	impl_type_params: List[String],
	method: CoreFunction,
) -> CoreFunction:
	def_id: Int = replacement_def_id(mapping, method.def_id).get_or(method.def_id)
	body: Option[CoreExpr] = method.body.map(
		pure func(expr): rewrite_method_references(mapping, expr),
	)

	{ method |
		type_params = method.type_params.filter(
			pure func(name): not impl_type_params.contains(name),
		),
		body = body,
		def_id = def_id
	}


private pure func materialize_request(
	request: CoreMonoImplRequest,
	next_def_id: Int,
) -> CoreMonoImplMaterialization:
	substituted_decl: CoreDecl = substitute_core_decl_types(
		request.substitution,
		ImplDecl(request.template),
	)

	match substituted_decl:
		ImplDecl(substituted):
			impl_type_params: List[String] = impl_type_param_names(request.template.type_params)
			mapping: CoreMonoDefIdMap = method_def_id_mapping(substituted.methods, next_def_id)
			methods: List[CoreFunction] = substituted.methods.map(pure func(method):
				specialize_method(mapping, impl_type_params, method)
			)
			closed_receiver = erase_core_mono_value_refinements(request.concrete_for_type)

			{
				decl = ImplDecl({ substituted |
						for_type = request.concrete_for_type,
						type_params = [],
						methods = methods
					}),
				next_def_id = next_def_id + methods.length(),
				method_selections = mapping.map(pure func(entry): {
						source_def_id = entry.source_def_id,
						closed_receiver = closed_receiver,
						target_def_id = entry.target_def_id
					})
			}
		_:
			{
				decl = ImplDecl(request.template),
				next_def_id = next_def_id,
				method_selections = []
			}


private pure func selection_hash(source_def_id: Int, receiver: CoreType) -> Int:
	-- Hashes only choose a bucket; identity is verified structurally below.
	hash_combine(source_def_id, core_mono_type_hash(receiver))


private pure func collect_selection_index(
	selections: List[CoreMonoImplMethodSelection],
) -> CoreMonoImplSelectionIndex:
	var index: CoreMonoImplSelectionIndex = {}

	for selection in selections:
		key: Int = selection_hash(selection.source_def_id, selection.closed_receiver)
		index = index.set(
			key,
			index
				.get_or(key, [])
				.append(selection),
		)

	index


pure func selected_impl_target(
	index: CoreMonoImplSelectionIndex,
	source_def_id: Int,
	receiver: CoreType,
) -> CoreMonoImplSelectionLookup:
	var found: CoreMonoImplSelectionLookup = NoSelectedImpl

	for selection in index.get_or(
		selection_hash(source_def_id, receiver),
		[],
	):
		if (
			selection.source_def_id == source_def_id
			and core_mono_type_equal(selection.closed_receiver, receiver)
		):
			match found:
				NoSelectedImpl:
					found = SelectedImpl(selection.target_def_id)
				SelectedImpl(first_id):
					if first_id != selection.target_def_id:
						found = ConflictingSelectedImpl(first_id, selection.target_def_id)
						break
					else:
						void
				ConflictingSelectedImpl(_, _):
					break
		else:
			void

	found


private pure func remap_selected_impl_expr(
	state: Result[CoreMonoImplSelectionIndex, CoreMonoDiagnostic],
	expr: CoreExpr,
) -> CoreMapState[Result[CoreMonoImplSelectionIndex, CoreMonoDiagnostic], CoreExpr]:
	match state:
		Err(_):
			{
				state = state,
				value = expr
			}
		Ok(_):
			mapped: CoreMapState[Result[CoreMonoImplSelectionIndex, CoreMonoDiagnostic], CoreExpr] = match expr:
				SeqExpr(_, _):
					spine = CoreTraverse.split_core_sequence(expr)
					var current_state = state
					var items: List[CoreExpr] = []

					for item in spine.preceding_items:
						item_result = remap_selected_impl_expr(current_state, item)
						current_state = item_result.state
						items = items.append(item_result.value)

					final_result = remap_selected_impl_expr(current_state, spine.final_item)
					{
						state = final_result.state,
						value = CoreTraverse.rebuild_core_sequence({
							preceding_items = items,
							final_item = final_result.value,
						})
					}
				_:
					CoreTraverse.map_core_expr_children_with_state(
						state,
						remap_selected_impl_expr,
						expr,
					)

			match mapped.state:
				Ok(index):
					match mapped.value:
						CallExpr(kind, function, args, typ, loc):
							match kind:
								SelectedTraitCall(trait_name, method_name, module_path, source_id):
									match function:
										VarExpr(callee, callee_type, callee_loc):
											receiver = erase_core_mono_value_refinements(
												dispatch_receiver_type(
													args,
													typ,
												),
											)

											match selected_impl_target(index, source_id, receiver):
												SelectedImpl(target_id):
													{
														state = mapped.state,
														value = CallExpr(
															SelectedTraitCall(
																trait_name,
																method_name,
																module_path,
																target_id,
															),
															VarExpr(
																{ callee |
																	def_id = Some(target_id)
																},
																callee_type,
																callee_loc,
															),
															args,
															typ,
															loc,
														)
													}
												ConflictingSelectedImpl(first_id, second_id):
													{
														state = Err(
															CoreMonoConflictingImplMethods(
																source_id,
																receiver,
																first_id,
																second_id,
																loc,
															),
														),
														value = mapped.value
													}
												NoSelectedImpl:
													mapped
										_:
											mapped
								_:
									mapped
						_:
							mapped
				Err(_):
					mapped


private pure func remap_selected_impl_function(
	state: Result[CoreMonoImplSelectionIndex, CoreMonoDiagnostic],
	function: CoreFunction,
) -> CoreMapState[Result[CoreMonoImplSelectionIndex, CoreMonoDiagnostic], CoreFunction]:
	if not function.type_params.is_empty():
		{
			state = state,
			value = function
		}
	else:
		match function.body:
			Some(body):
				mapped = remap_selected_impl_expr(state, body)
				{
					state = mapped.state,
					value = { function | body = Some(mapped.value) }
				}
			None:
				{
					state = state,
					value = function
				}


pure func remap_selected_impl_methods(
	program: CoreProgram,
	selections: List[CoreMonoImplMethodSelection],
) -> Result[CoreProgram, CoreMonoDiagnostic]:
	if selections.is_empty():
		Ok(program)
	else:
		index = collect_selection_index(selections)
		var state: Result[CoreMonoImplSelectionIndex, CoreMonoDiagnostic] = Ok(index)
		var decls: List[CoreDecl] = []

		for decl in program.decls:
			mapped: CoreDecl = match decl:
				FunctionDecl(function):
					remapped = remap_selected_impl_function(state, function)
					state = remapped.state
					FunctionDecl(remapped.value)
				GlobalDecl(global):
					remapped = remap_selected_impl_expr(state, global.init)
					state = remapped.state
					GlobalDecl({ global | init = remapped.value })
				ImplDecl(implementation):
					if CoreTypePolicy.core_impl_is_generic(implementation):
						decl
					else:
						var methods: List[CoreFunction] = []

						for method in implementation.methods:
							remapped = remap_selected_impl_function(state, method)
							state = remapped.state
							methods = methods.append(remapped.value)

						ImplDecl({ implementation | methods = methods })
				_:
					decl

			decls = decls.append(mapped)

			match state:
				Err(_):
					break
				Ok(_):
					void

		validated_index ?= state
		Ok({ program | decls = decls })


---
Specializes generic trait impls, collecting the template list from
`program`. Callers that already hold a template list and a scan cursor
across a fixpoint should call `specialize_generic_impls_with_templates`
directly instead.
---
pure func specialize_generic_impls(
	program: CoreProgram,
	next_def_id: Int,
) -> Result[CoreMonoProgramSpecialization, CoreMonoDiagnostic]:
	step: CoreMonoImplSpecializationStep = specialize_generic_impls_with_templates(
		program,
		next_def_id,
		generic_impls(program),
		0,
	)

	remapped ?= remap_selected_impl_methods(step.program, step.method_selections)
	Ok({
		program = remapped,
		next_def_id = step.next_def_id,
	})


---
Same as `specialize_generic_impls`, but takes an already-built template list
and only collects requests from decls at `processed_decl_count` on: earlier
decls already had their requests collected, and that can't change on a
later call, since a decl's body is immutable once appended and `templates`
is fixed for the whole fixpoint. `concrete_impl_keys` still scans the whole
program, since which impls are already concrete keeps changing as the
fixpoint specializes more of them. Returns the new processed count to pass
back in on the next call.
---
pure func specialize_generic_impls_with_templates(
	program: CoreProgram,
	next_def_id: Int,
	templates: List[CoreImplDecl],
	processed_decl_count: Int,
) -> CoreMonoImplSpecializationStep:
	if templates.is_empty():
		{
			program = program,
			next_def_id = next_def_id,
			processed_decl_count = program.decls.length(),
			method_selections = []
		}
	else:
		concrete_keys: List[String] = concrete_impl_keys(program)
		unprocessed_decls: List[CoreDecl] = program.decls.drop(processed_decl_count)
		var requests: List[CoreMonoImplRequest] = collect_program_requests(
			templates,
			concrete_keys,
			unprocessed_decls,
		)
		var specialized: List[CoreDecl] = []
		var request_index: Int = 0
		var current_def_id: Int = next_def_id
		var method_selections: List[CoreMonoImplMethodSelection] = []

		while request_index < requests.length():
			match requests.get(request_index):
				Some(request):
					materialized: CoreMonoImplMaterialization = materialize_request(
						request,
						current_def_id,
					)
					current_def_id = materialized.next_def_id
					method_selections = method_selections.concat(materialized.method_selections)
					specialized = specialized.append(materialized.decl)
					requests = collect_bound_requests(templates, concrete_keys, requests, request)

					match materialized.decl:
						ImplDecl(impl):
							requests = collect_impl_requests(
								templates,
								concrete_keys,
								requests,
								impl,
							)
						_:
							void
				None:
					break

			request_index += 1

		final_decls: List[CoreDecl] = program.decls.concat(specialized)

		{
			program = { program | decls = final_decls },
			next_def_id = current_def_id,
			processed_decl_count = final_decls.length(),
			method_selections = method_selections
		}
