-- Core body synthesis for non-forwarding fixed operations.
--
-- Constructors and conversions that are single runtime calls live in
-- core_synth_forward. This module owns the operations whose behavior
-- is expressed as ordinary Core so later ownership and optimization passes can
-- reason about it.
import:
	ir:
		CoreBinaryOp(AddOp, DivideOp, GreaterEqualOp, GreaterOp, LessOp, MultiplyOp, SubtractOp),
		CoreCallKind(IntrinsicCall),
		CoreExpr(CallExpr, LetExpr, LiteralExpr, VarExpr, VoidExpr),
		CoreFunction,
		CoreLiteral(IntLiteral),
		CoreParam,
		CoreSourceLoc,
		CoreType(NamedType, VoidType),
		CoreVar,
		synthetic_core_source_loc,
	synth_nodes: binary, core_var, if_expr
	synth_type_queries: param_is_named, type_is_named


private FIXED_POINT_MODULE: String = "fixed_point"

private INT_TYPE: CoreType = NamedType("Int", [])

private BOOL_TYPE: CoreType = NamedType("Bool", [])

private FIXED_POINT_TYPE: CoreType = NamedType("FixedPoint", [])


private pure func variable(name: String, typ: CoreType) -> CoreExpr:
	VarExpr(core_var(name), typ, synthetic_core_source_loc())


private pure func int_literal(value: Int) -> CoreExpr:
	LiteralExpr(IntLiteral(value), INT_TYPE, synthetic_core_source_loc())


private pure func intrinsic_call(
	name: String,
	args: List[CoreExpr],
	return_type: CoreType,
) -> CoreExpr:
	CallExpr(
		IntrinsicCall(name),
		VoidExpr(VoidType, synthetic_core_source_loc()),
		args,
		return_type,
		synthetic_core_source_loc(),
	)


private pure func let_expr(
	name: String,
	typ: CoreType,
	rhs: CoreExpr,
	body: CoreExpr,
) -> CoreExpr:
	LetExpr(core_var(name), False, typ, rhs, body)


private pure func parameter_value(param: CoreParam) -> CoreExpr:
	VarExpr(param.name, param.typ, synthetic_core_source_loc())


private pure func synthesize_to_int(value: CoreExpr) -> CoreExpr:
	let_expr(
		"__val",
		INT_TYPE,
		intrinsic_call("fixed_point_value", [value], INT_TYPE),
		let_expr(
			"__scale",
			INT_TYPE,
			intrinsic_call("fixed_point_scale", [value], INT_TYPE),
			if_expr(
				binary(
					GreaterEqualOp,
					variable("__scale", INT_TYPE),
					int_literal(0),
					BOOL_TYPE,
				),
				binary(
					DivideOp,
					variable("__val", INT_TYPE),
					intrinsic_call("fixed_point_pow10", [variable("__scale", INT_TYPE)], INT_TYPE),
					INT_TYPE,
				),
				binary(
					MultiplyOp,
					variable("__val", INT_TYPE),
					intrinsic_call("fixed_point_pow10", [binary(
								SubtractOp,
								int_literal(0),
								variable("__scale", INT_TYPE),
								INT_TYPE,
							)], INT_TYPE),
					INT_TYPE,
				),
				INT_TYPE,
			),
		),
	)


private pure func synthesize_neg(value: CoreExpr) -> CoreExpr:
	intrinsic_call(
		"fixed_point_alloc",
		[binary(
				SubtractOp,
				int_literal(0),
				intrinsic_call("fixed_point_value", [value], INT_TYPE),
				INT_TYPE,
			), intrinsic_call(
				"fixed_point_scale",
				[value],
				INT_TYPE,
			), intrinsic_call("fixed_point_precision", [value], INT_TYPE)],
		FIXED_POINT_TYPE,
	)


private pure func rounded_value(diff: CoreExpr) -> CoreExpr:
	if_expr(
		binary(GreaterOp, diff, int_literal(0), BOOL_TYPE),
		binary(
			MultiplyOp,
			variable("__val", INT_TYPE),
			intrinsic_call("fixed_point_pow10", [diff], INT_TYPE),
			INT_TYPE,
		),
		if_expr(
			binary(LessOp, diff, int_literal(0), BOOL_TYPE),
			let_expr(
				"__div",
				INT_TYPE,
				intrinsic_call(
					"fixed_point_pow10",
					[binary(SubtractOp, int_literal(0), diff, INT_TYPE)],
					INT_TYPE,
				),
				binary(
					DivideOp,
					binary(
						AddOp,
						variable("__val", INT_TYPE),
						binary(
							DivideOp,
							variable("__div", INT_TYPE),
							int_literal(2),
							INT_TYPE,
						),
						INT_TYPE,
					),
					variable("__div", INT_TYPE),
					INT_TYPE,
				),
			),
			variable("__val", INT_TYPE),
			INT_TYPE,
		),
		INT_TYPE,
	)


private pure func synthesize_round_to(value: CoreExpr, target_scale: CoreExpr) -> CoreExpr:
	let_expr(
		"__val",
		INT_TYPE,
		intrinsic_call(
			"fixed_point_value",
			[value],
			INT_TYPE,
		),
		let_expr(
			"__scale",
			INT_TYPE,
			intrinsic_call(
				"fixed_point_scale",
				[value],
				INT_TYPE,
			),
			let_expr(
				"__prec",
				INT_TYPE,
				intrinsic_call(
					"fixed_point_precision",
					[value],
					INT_TYPE,
				),
				let_expr(
					"__diff",
					INT_TYPE,
					binary(
						SubtractOp,
						target_scale,
						variable("__scale", INT_TYPE),
						INT_TYPE,
					),
					let_expr(
						"__new_val",
						INT_TYPE,
						rounded_value(variable("__diff", INT_TYPE)),
						intrinsic_call(
							"fixed_point_alloc",
							[
								variable("__new_val", INT_TYPE),
								target_scale,
								variable("__prec", INT_TYPE),
							],
							FIXED_POINT_TYPE,
						),
					),
				),
			),
		),
	)


private pure func synthesize_named_body(
	name: String,
	params: List[CoreParam],
	return_type: CoreType,
) -> Option[CoreExpr]:
	if (
		name == "get_scale"
		and params.length() == 1
		and param_is_named(params, 0, "FixedPoint")
		and type_is_named(return_type, "Int")
	):
		param ?= params.get(0)
		Some(intrinsic_call("fixed_point_scale", [parameter_value(param)], INT_TYPE))
	else if (
		name == "get_precision"
		and params.length() == 1
		and param_is_named(params, 0, "FixedPoint")
		and type_is_named(return_type, "Int")
	):
		param ?= params.get(0)
		Some(intrinsic_call("fixed_point_precision", [parameter_value(param)], INT_TYPE))
	else if (
		name == "to_int"
		and params.length() == 1
		and param_is_named(params, 0, "FixedPoint")
		and type_is_named(return_type, "Int")
	):
		param ?= params.get(0)
		Some(synthesize_to_int(parameter_value(param)))
	else if (
		name == "neg"
		and params.length() == 1
		and param_is_named(params, 0, "FixedPoint")
		and type_is_named(return_type, "FixedPoint")
	):
		param ?= params.get(0)
		Some(synthesize_neg(parameter_value(param)))
	else if (
		name == "round_to"
		and params.length() == 2
		and param_is_named(params, 0, "FixedPoint")
		and param_is_named(params, 1, "Int")
		and type_is_named(return_type, "FixedPoint")
	):
		value ?= params.get(0)
		scale ?= params.get(1)
		Some(synthesize_round_to(parameter_value(value), parameter_value(scale)))
	else:
		None


pure func synthesize_fixed_point_body(function_info: CoreFunction, member: String) -> Option[CoreExpr]:
	if function_info.source_module != Some(FIXED_POINT_MODULE):
		None
	else:
		synthesize_named_body(member, function_info.params, function_info.return_type)
