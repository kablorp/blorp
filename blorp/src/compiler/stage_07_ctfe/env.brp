-- Lexical environment operations for compile-time evaluation.
--
-- Assignment returns an updated environment rather than exposing mutable
-- binding cells, so local CTFE execution stays value-oriented.
import:
	../../lib/source: SourceSpan
	value:
		CtfeBinding,
		CtfeBindingScope(CtfeGlobalBinding, CtfeLocalBinding),
		CtfeBindingValue(CtfeAvailableValue, CtfeUnavailableGlobal),
		CtfeEnv,
		CtfeUnavailableGlobalReason,
		CtfeValue,
		ctfe_env_unsafe_from_representation,
		ctfe_env_unsafe_representation,
		ctfe_void,


union CtfeEnvError:
	CtfeUnknownBinding(String)
	CtfeUnavailableBinding(String, CtfeUnavailableGlobalReason)
	CtfeImmutableAssignment(String)


record CtfeAssignResult {
	env: CtfeEnv,
	value: CtfeValue
}


CTFE_ENV_EMPTY: CtfeEnv = ctfe_env_unsafe_from_representation([])


pure func ctfe_env_length(env: CtfeEnv) -> Int:
	ctfe_env_unsafe_representation(env).length()


pure func ctfe_env_concat(nearer: CtfeEnv, farther: CtfeEnv) -> CtfeEnv:
	ctfe_env_unsafe_from_representation(
		ctfe_env_unsafe_representation(nearer).concat(ctfe_env_unsafe_representation(farther)),
	)


pure func ctfe_available_binding(
	scope: CtfeBindingScope,
	is_mutable: Bool,
	value: CtfeValue,
) -> CtfeBinding:
	{
		scope = scope,
		is_mutable = is_mutable,
		value = CtfeAvailableValue(value)
	}


pure func ctfe_unavailable_global_binding(reason: CtfeUnavailableGlobalReason) -> CtfeBinding:
	{
		scope = CtfeGlobalBinding,
		is_mutable = False,
		value = CtfeUnavailableGlobal(reason)
	}


private pure func ctfe_env_cons_binding(
	env: CtfeEnv,
	name: String,
	binding: CtfeBinding,
) -> CtfeEnv:
	if name != "_":
		ctfe_env_unsafe_from_representation(
			[(name, binding)].concat(ctfe_env_unsafe_representation(env)),
		)
	else:
		env


pure func ctfe_bind_local_value(env: CtfeEnv, name: String, value: CtfeValue) -> CtfeEnv:
	ctfe_env_cons_binding(
		env,
		name,
		ctfe_available_binding(CtfeLocalBinding, False, value),
	)


pure func ctfe_bind_mutable_local_value(env: CtfeEnv, name: String, value: CtfeValue) -> CtfeEnv:
	ctfe_env_cons_binding(
		env,
		name,
		ctfe_available_binding(CtfeLocalBinding, True, value),
	)


pure func ctfe_bind_global_value(env: CtfeEnv, name: String, value: CtfeValue) -> CtfeEnv:
	ctfe_env_cons_binding(
		env,
		name,
		ctfe_available_binding(CtfeGlobalBinding, False, value),
	)


pure func ctfe_bind_unavailable_global(
	env: CtfeEnv,
	name: String,
	reason: CtfeUnavailableGlobalReason,
) -> CtfeEnv:
	ctfe_env_cons_binding(env, name, ctfe_unavailable_global_binding(reason))


pure func ctfe_global_bindings(env: CtfeEnv) -> CtfeEnv:
	ctfe_env_unsafe_from_representation(
		ctfe_env_unsafe_representation(env).filter(func(entry: (String, CtfeBinding)):
			(_, binding) = entry
			binding.scope == CtfeGlobalBinding
		),
	)


pure func ctfe_project_existing_bindings(scoped_env: CtfeEnv, base_env: CtfeEnv) -> CtfeEnv:
	scoped_len = ctfe_env_length(scoped_env)
	base_len = ctfe_env_length(base_env)

	if scoped_len <= base_len:
		scoped_env
	else:
		extra_bindings = scoped_len - base_len
		var index: Int = 0
		var projected: List[(String, CtfeBinding)] = []

		for binding in ctfe_env_unsafe_representation(scoped_env):
			if index >= extra_bindings:
				projected = projected.append(binding)

			index += 1

		ctfe_env_unsafe_from_representation(projected)


pure func ctfe_has_local_bindings(env: CtfeEnv) -> Bool:
	ctfe_env_unsafe_representation(env).any(func(entry: (String, CtfeBinding)):
		(_, binding) = entry
		binding.scope == CtfeLocalBinding
	)


pure func ctfe_env_has_binding(env: CtfeEnv, name: String) -> Bool:
	ctfe_env_unsafe_representation(env).any(func(entry: (String, CtfeBinding)):
		(candidate_name, _) = entry
		candidate_name == name
	)


pure func ctfe_lookup_binding(env: CtfeEnv, name: String) -> Result[CtfeBinding, CtfeEnvError]:
	var result: Option[CtfeBinding] = None

	for (candidate_name, binding) in ctfe_env_unsafe_representation(env):
		if result.is_none() and candidate_name == name:
			result = Some(binding)

	match result:
		Some(binding):
			match binding.value:
				CtfeAvailableValue(_):
					Ok(binding)
				CtfeUnavailableGlobal(reason):
					Err(CtfeUnavailableBinding(name, reason))
		None:
			Err(CtfeUnknownBinding(name))


pure func ctfe_lookup_value(env: CtfeEnv, name: String) -> Result[CtfeValue, CtfeEnvError]:
	binding ?= ctfe_lookup_binding(env, name)

	match binding.value:
		CtfeAvailableValue(value):
			Ok(value)
		CtfeUnavailableGlobal(reason):
			Err(CtfeUnavailableBinding(name, reason))


private pure func ctfe_replace_binding(
	env: CtfeEnv,
	name: String,
	replacement: CtfeBinding,
) -> CtfeEnv:
	var replaced: Bool = False
	var result: List[(String, CtfeBinding)] = []

	for (candidate_name, binding) in ctfe_env_unsafe_representation(env):
		if not replaced and candidate_name == name:
			result = result.append((candidate_name, replacement))
			replaced = True
		else:
			result = result.append((candidate_name, binding))

	ctfe_env_unsafe_from_representation(result)


pure func ctfe_assign_value(
	env: CtfeEnv,
	span: SourceSpan,
	name: String,
	value: CtfeValue,
) -> Result[CtfeAssignResult, CtfeEnvError]:
	binding ?= ctfe_lookup_binding(env, name)

	if not binding.is_mutable:
		Err(CtfeImmutableAssignment(name))
	else:
		replacement: CtfeBinding = { binding | value = CtfeAvailableValue(value) }
		Ok({
			env = ctfe_replace_binding(env, name, replacement),
			value = ctfe_void(span),
		})


pure func ctfe_unavailable_global_message(
	name: String,
	reason: CtfeUnavailableGlobalReason,
) -> String:
	match reason:
		CtfeCurrentGlobal:
			"global constant initializer cannot reference itself: '${name}'"
		CtfeLaterGlobal:
			"global constant initializer cannot reference later global constant '${name}'"
		CtfeRuntimeInitializedGlobal:
			"global constant initializer cannot reference global '${name}' because it is not a compile-time constant"
		CtfeImportedRuntimeInitializedGlobal(module_path, original_name):
			"global constant initializer cannot reference imported value '${module_path}.${original_name}' because it is not a compile-time constant"


pure func ctfe_env_error_message(error: CtfeEnvError) -> String:
	match error:
		CtfeUnknownBinding(name):
			"global constant initializer cannot reference '${name}' before it is evaluated"
		CtfeUnavailableBinding(name, reason):
			ctfe_unavailable_global_message(name, reason)
		CtfeImmutableAssignment(name):
			"compile-time assignment target '${name}' is immutable"
