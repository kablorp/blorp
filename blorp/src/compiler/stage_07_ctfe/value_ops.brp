-- Operations over compile-time values that are shared by CTFE evaluators and
-- std intrinsic evaluation.
import:
	../../lib/source: SourceLocation
	../stage_06_typecheck/type_system/semantic_type:
		SemanticType,
		qualify_module_local_type_name,
		qualify_module_local_types,
	value:
		CtfeError(CtfeUnsupported),
		CtfeValue,
		CtfeValueDesc(
			CtfeBoolValue, CtfeCharValue, CtfeConstructorValue, CtfeDictValue, CtfeFloatValue,
			CtfeIntValue, CtfeListValue, CtfeRecordValue, CtfeStringValue,
			CtfeTupleValue, CtfeVectorValue,
		),
		ctfe_constructor_info,
		ctfe_int_value_text,
		ctfe_value,
		ctfe_value_kind,


OPTION_TYPE_NAME: String = "Option"

OPTION_SOME_NAME: String = "Some"

OPTION_NONE_NAME: String = "None"

RESULT_TYPE_NAME: String = "Result"

RESULT_OK_NAME: String = "Ok"

RESULT_ERR_NAME: String = "Err"


union CtfeOptionState:
	CtfeOptionSome(CtfeValue)
	CtfeOptionNone


union CtfeResultState:
	CtfeResultOk(CtfeValue)
	CtfeResultErr(CtfeValue)


pure func ctfe_construct_value(
	typ: SemanticType,
	span: SourceLocation,
	parent_type: String,
	name: String,
	args: List[CtfeValue],
) -> CtfeValue:
	ctfe_value(typ, CtfeConstructorValue({
			name = name,
			args = args,
			constructor_info = ctfe_constructor_info(parent_type, args.length()),
		}), span)


pure func ctfe_option_some_value(
	typ: SemanticType,
	span: SourceLocation,
	value: CtfeValue,
) -> CtfeValue:
	ctfe_construct_value(typ, span, OPTION_TYPE_NAME, OPTION_SOME_NAME, [value])


pure func ctfe_option_none_value(typ: SemanticType, span: SourceLocation) -> CtfeValue:
	ctfe_construct_value(typ, span, OPTION_TYPE_NAME, OPTION_NONE_NAME, [])


pure func ctfe_result_ok_value(
	typ: SemanticType,
	span: SourceLocation,
	value: CtfeValue,
) -> CtfeValue:
	ctfe_construct_value(typ, span, RESULT_TYPE_NAME, RESULT_OK_NAME, [value])


pure func ctfe_result_err_value(
	typ: SemanticType,
	span: SourceLocation,
	value: CtfeValue,
) -> CtfeValue:
	ctfe_construct_value(typ, span, RESULT_TYPE_NAME, RESULT_ERR_NAME, [value])


pure func ctfe_option_state(value: CtfeValue) -> Result[CtfeOptionState, CtfeError]:
	match value.desc:
		CtfeConstructorValue(payload):
			if (
				payload.constructor_info.parent_type == OPTION_TYPE_NAME
				and payload.name == OPTION_SOME_NAME
				and payload.args.length() == 1
			):
				match payload.args.get(0):
					Some(inner):
						Ok(CtfeOptionSome(inner))
					None:
						Err(CtfeUnsupported("Option helper on non-Option values"))
			else if (
				payload.constructor_info.parent_type == OPTION_TYPE_NAME
				and payload.name == OPTION_NONE_NAME
				and payload.args.length() == 0
			):
				Ok(CtfeOptionNone)
			else:
				Err(CtfeUnsupported("Option helper on non-Option values"))
		_:
			Err(CtfeUnsupported("Option helper on non-Option values"))


pure func ctfe_result_state(value: CtfeValue) -> Result[CtfeResultState, CtfeError]:
	match value.desc:
		CtfeConstructorValue(payload):
			if (
				payload.constructor_info.parent_type == RESULT_TYPE_NAME
				and payload.name == RESULT_OK_NAME
				and payload.args.length() == 1
			):
				match payload.args.get(0):
					Some(inner):
						Ok(CtfeResultOk(inner))
					None:
						Err(CtfeUnsupported("Result helper on non-Result values"))
			else if (
				payload.constructor_info.parent_type == RESULT_TYPE_NAME
				and payload.name == RESULT_ERR_NAME
				and payload.args.length() == 1
			):
				match payload.args.get(0):
					Some(inner):
						Ok(CtfeResultErr(inner))
					None:
						Err(CtfeUnsupported("Result helper on non-Result values"))
			else:
				Err(CtfeUnsupported("Result helper on non-Result values"))
		_:
			Err(CtfeUnsupported("Result helper on non-Result values"))


pure func ctfe_string_text_of_value(value: CtfeValue) -> Result[String, CtfeError]:
	match value.desc:
		CtfeStringValue(text):
			Ok(text)
		CtfeIntValue(number):
			Ok(ctfe_int_value_text(value.typ, number))
		CtfeFloatValue(number):
			Ok(number.to_string())
		CtfeBoolValue(flag):
			Ok(flag.to_string())
		CtfeCharValue(char):
			Ok(char.to_string())
		_:
			Err(CtfeUnsupported("String interpolation for " + ctfe_value_kind(value) + " values"))


---
Re-spells every type a value carries, at any depth, from the owning module's
local names (`Extent`) to the canonical names (`module::Extent`) every other
module uses. A module evaluates its own globals and function bodies with local
spellings; a value crossing a module boundary, either as an imported global or
as the result of an imported function call, must use the reader's spelling, or
a later phase cannot find the type or constructor the folded initializer names.
Function references and lambdas keep their payloads: they close over the
defining module's own context and are never materialized into another
module's initializer.
---
pure func ctfe_value_qualify_module_local_types(
	module_path: String,
	local_type_names: List[String],
	value: CtfeValue,
) -> CtfeValue:
	typ = qualify_module_local_types(module_path, local_type_names, value.typ)

	desc = match value.desc:
		CtfeTupleValue(items):
			CtfeTupleValue(
				ctfe_values_qualify_module_local_types(
					module_path,
					local_type_names,
					items,
				),
			)
		CtfeListValue(items):
			CtfeListValue(
				ctfe_values_qualify_module_local_types(
					module_path,
					local_type_names,
					items,
				),
			)
		CtfeVectorValue(items):
			CtfeVectorValue(
				ctfe_values_qualify_module_local_types(
					module_path,
					local_type_names,
					items,
				),
			)
		CtfeDictValue(entries):
			CtfeDictValue(entries.map(
				func(
					entry,
				): (
					ctfe_value_qualify_module_local_types(module_path, local_type_names, entry[0]),
					ctfe_value_qualify_module_local_types(
						module_path,
						local_type_names,
						entry[1],
					),
				),
			))
		CtfeRecordValue(fields):
			CtfeRecordValue(fields.map(
				func(
					field,
				): (
					field[0],
					ctfe_value_qualify_module_local_types(module_path, local_type_names, field[1]),
					field[2],
				),
			))
		CtfeConstructorValue(payload):
			CtfeConstructorValue({ payload |
					args = ctfe_values_qualify_module_local_types(
						module_path,
						local_type_names,
						payload.args,
					),
					constructor_info = { payload.constructor_info |
						parent_type = qualify_module_local_type_name(
							module_path,
							local_type_names,
							payload.constructor_info.parent_type,
						)
					}
				})
		_:
			value.desc

	{ value |
		typ = typ,
		desc = desc
	}


private pure func ctfe_values_qualify_module_local_types(
	module_path: String,
	local_type_names: List[String],
	values: List[CtfeValue],
) -> List[CtfeValue]:
	values.map(
		func(item): ctfe_value_qualify_module_local_types(module_path, local_type_names, item),
	)
