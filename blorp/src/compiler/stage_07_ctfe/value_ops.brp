-- Operations over compile-time values that are shared by CTFE evaluators and
-- std intrinsic evaluation.
import:
	../../lib/source: SourceSpan
	../stage_05_types/semantic_type: SemanticType
	value:
		CtfeError(CtfeUnsupported),
		CtfeValue,
		CtfeValueDesc(
			CtfeBoolValue,
			CtfeCharValue,
			CtfeConstructorValue,
			CtfeFloatValue,
			CtfeIntValue,
			CtfeStringValue,
		),
		ctfe_constructor_info,
		ctfe_value,
		ctfe_value_kind,


OPTION_TYPE_NAME: String = "Option"

OPTION_SOME_NAME: String = "Some"

OPTION_NONE_NAME: String = "None"

RESULT_TYPE_NAME: String = "Result"

RESULT_OK_NAME: String = "Ok"

RESULT_ERR_NAME: String = "Err"


union CtfeOptionState:
	CtfeOptionSome(CtfeValue)
	CtfeOptionNone


union CtfeResultState:
	CtfeResultOk(CtfeValue)
	CtfeResultErr(CtfeValue)


pure func ctfe_construct_value(
	typ: SemanticType,
	span: SourceSpan,
	parent_type: String,
	name: String,
	args: List[CtfeValue],
) -> CtfeValue:
	ctfe_value(typ, CtfeConstructorValue({
			name = name,
			args = args,
			constructor_info = ctfe_constructor_info(parent_type, args.length(), None),
		}), span)


pure func ctfe_option_some_value(
	typ: SemanticType,
	span: SourceSpan,
	value: CtfeValue,
) -> CtfeValue:
	ctfe_construct_value(typ, span, OPTION_TYPE_NAME, OPTION_SOME_NAME, [value])


pure func ctfe_option_none_value(typ: SemanticType, span: SourceSpan) -> CtfeValue:
	ctfe_construct_value(typ, span, OPTION_TYPE_NAME, OPTION_NONE_NAME, [])


pure func ctfe_result_ok_value(typ: SemanticType, span: SourceSpan, value: CtfeValue) -> CtfeValue:
	ctfe_construct_value(typ, span, RESULT_TYPE_NAME, RESULT_OK_NAME, [value])


pure func ctfe_result_err_value(typ: SemanticType, span: SourceSpan, value: CtfeValue) -> CtfeValue:
	ctfe_construct_value(typ, span, RESULT_TYPE_NAME, RESULT_ERR_NAME, [value])


pure func ctfe_option_state(value: CtfeValue) -> Result[CtfeOptionState, CtfeError]:
	match value.desc:
		CtfeConstructorValue(payload):
			if (
				payload.constructor_info.parent_type == OPTION_TYPE_NAME
				and payload.name == OPTION_SOME_NAME
				and payload.args.length() == 1
			):
				match payload.args.get(0):
					Some(inner):
						Ok(CtfeOptionSome(inner))
					None:
						Err(CtfeUnsupported("Option helper on non-Option values"))
			else if (
				payload.constructor_info.parent_type == OPTION_TYPE_NAME
				and payload.name == OPTION_NONE_NAME
				and payload.args.length() == 0
			):
				Ok(CtfeOptionNone)
			else:
				Err(CtfeUnsupported("Option helper on non-Option values"))
		_:
			Err(CtfeUnsupported("Option helper on non-Option values"))


pure func ctfe_result_state(value: CtfeValue) -> Result[CtfeResultState, CtfeError]:
	match value.desc:
		CtfeConstructorValue(payload):
			if (
				payload.constructor_info.parent_type == RESULT_TYPE_NAME
				and payload.name == RESULT_OK_NAME
				and payload.args.length() == 1
			):
				match payload.args.get(0):
					Some(inner):
						Ok(CtfeResultOk(inner))
					None:
						Err(CtfeUnsupported("Result helper on non-Result values"))
			else if (
				payload.constructor_info.parent_type == RESULT_TYPE_NAME
				and payload.name == RESULT_ERR_NAME
				and payload.args.length() == 1
			):
				match payload.args.get(0):
					Some(inner):
						Ok(CtfeResultErr(inner))
					None:
						Err(CtfeUnsupported("Result helper on non-Result values"))
			else:
				Err(CtfeUnsupported("Result helper on non-Result values"))
		_:
			Err(CtfeUnsupported("Result helper on non-Result values"))


pure func ctfe_string_text_of_value(value: CtfeValue) -> Result[String, CtfeError]:
	match value.desc:
		CtfeStringValue(text):
			Ok(text)
		CtfeIntValue(number):
			Ok(number.to_string())
		CtfeFloatValue(number):
			Ok(number.to_string())
		CtfeBoolValue(flag):
			Ok(flag.to_string())
		CtfeCharValue(char):
			Ok(char.to_string())
		_:
			Err(CtfeUnsupported("String interpolation for " + ctfe_value_kind(value) + " values"))
