-- Normalized expression representation for compile-time evaluation.
--
-- This IR is intentionally smaller than TypedExpr. Translation keeps
-- the typed facts CTFE needs and rejects unsupported expression forms at a
-- named boundary instead of letting evaluation guess from typed-AST shapes.
import:
	../../lib/source: SourceSpan
	../stage_03_parse/parsed_ast:
		ParsedBinaryOp,
		ParsedForBinder(ParsedForNameBinder, ParsedForTupleBinder),
		ParsedIdentifier,
		ParsedLogicalOp,
		ParsedUnaryOp,
	../stage_05_types/env: Purity(Impure, Pure), purities_equal
	../stage_05_types/semantic_type: SemanticType(SemanticNamedType, SemanticTupleType)
	../stage_06_typecheck/infer:
		CallableOrigin(
			CallableBuiltin,
			CallableConstructor,
			CallableForeign,
			CallableImported,
			CallableImplMethod,
			CallableLocal,
		),
		ResolvedCallInfo,
		ResolvedCallTarget(
			ResolvedClosureCall,
			ResolvedDirectCall,
			ResolvedIntrinsicCall,
			ResolvedTraitMethodCall,
		),
		TypedAssignScope(LocalAssignScope, ModuleAssignScope),
		TypedDictEntry,
		TypedExpr(
			TypedAscriptionExpr,
			TypedAssignExpr,
			TypedBinaryExpr,
			TypedBlockExpr,
			TypedBoolLiteralExpr,
			TypedBreakExpr,
			TypedBuiltinExpr,
			TypedCallExpr,
			TypedCharLiteralExpr,
			TypedConcurrentBlockExpr,
			TypedConcurrentForExpr,
			TypedContinueExpr,
			TypedDebugBlockExpr,
			TypedDetachExpr,
			TypedDictExpr,
			TypedFieldAccessExpr,
			TypedFloatLiteralExpr,
			TypedForExpr,
			TypedIfExpr,
			TypedIntLiteralExpr,
			TypedLambdaExpr,
			TypedListExpr,
			TypedLogicalExpr,
			TypedMatchExpr,
			TypedMissingExpr,
			TypedNameExpr,
			TypedOpaqueFromExpr,
			TypedOpaqueIntoExpr,
			TypedQuestionBindExpr,
			TypedRangeExpr,
			TypedRecordExpr,
			TypedRecordUpdateExpr,
			TypedSelectExpr,
			TypedStringInterpolationExpr,
			TypedStringInterpolationPartsExpr,
			TypedStringLiteralExpr,
			TypedSubscriptAssignExpr,
			TypedSubscriptExpr,
			TypedTupleDestructExpr,
			TypedTupleExpr,
			TypedUnaryExpr,
			TypedUnsupportedExpr,
			TypedVarDeclExpr,
			TypedVectorExpr,
			TypedVoidExpr,
			TypedWhileExpr,
			TypedWithExpr,
		),
		TypedMatchCase,
		TypedPattern,
		TypedRecordField,
		TypedStringInterpolationPart(TypedInterpolationExpr, TypedInterpolationLiteral),
		typed_expr_resolved_call,
		typed_expr_value_type,
	context:
		CTFE_CONTEXT_EMPTY,
		CtfeContext,
		CtfeNullaryConstructorReference,
		ctfe_context_function_by_callable_id,
		ctfe_context_module_alias,
		ctfe_context_module_has_global_binding,
		ctfe_context_nullary_constructor_reference,
	intrinsic: CtfeBuiltinIntrinsic, ctfe_builtin_intrinsic
	value: CtfeLambdaSource


union CtfeIrLiteral:
	CtfeIrIntLiteral(String)
	CtfeIrFloatLiteral(String)
	CtfeIrStringLiteral(String)
	CtfeIrBoolLiteral(Bool)
	CtfeIrCharLiteral(Int)


record CtfeIrDirectCall {
	callable_id: Int,
	source_name: String,
	is_pure: Bool
}


union CtfeIrReferenceKind:
	CtfeIrValueReference
	CtfeIrLocalFunctionReference(CtfeIrDirectCall)
	CtfeIrNullaryConstructorReference(CtfeNullaryConstructorReference)
	CtfeIrUnsupportedFunctionReference(String)
	CtfeIrImpureFunctionReference


record CtfeIrIdentifier {
	name: String,
	reference_kind: CtfeIrReferenceKind
}


union CtfeIrCallKind:
	CtfeIrUnresolvedCall
	CtfeIrClosureCall
	CtfeIrIntrinsicCall(String)
	CtfeIrLocalCall(CtfeIrDirectCall)
	CtfeIrImportedCall(CtfeIrDirectCall, String)
	CtfeIrConstructorCall(CtfeIrDirectCall, String)
	CtfeIrBuiltinCall(CtfeIrDirectCall, CtfeBuiltinIntrinsic)
	CtfeIrUnsupportedCall(String)
	CtfeIrImpureCall


record CtfeIrCall {
	kind: CtfeIrCallKind,
	callee: CtfeIrExpr,
	args: List[CtfeIrExpr]
}


record CtfeIrField {
	name: String,
	value: CtfeIrExpr
}


record CtfeIrDictEntry {
	key: CtfeIrExpr,
	value: CtfeIrExpr
}


record CtfeIrBlock {
	items: List[CtfeIrBlockItem],
	result: CtfeIrExpr
}


union CtfeIrAssignTarget:
	CtfeIrDiscardAssign
	CtfeIrLocalAssign(String)
	CtfeIrModuleAssign(String)


union CtfeIrBlockItem:
	CtfeIrDiscardItem(CtfeIrExpr)
	CtfeIrBindValueItem(String, Option[SemanticType], CtfeIrExpr, Bool)
	CtfeIrBindTupleItem(List[String], CtfeIrExpr)
	CtfeIrBindQuestionItem(String, Option[SemanticType], CtfeIrExpr)
	CtfeIrAssignItem(CtfeIrAssignTarget, CtfeIrExpr, SourceSpan)


union CtfeIrStringPart:
	CtfeIrStringText(String)
	CtfeIrStringExpr(CtfeIrExpr)


union CtfeIrFieldAccessKind:
	CtfeIrRecordField(String)
	CtfeIrTupleField(Int, String)
	CtfeIrTupleInvalidField(String)
	CtfeIrRangeStartField
	CtfeIrRangeEndField
	CtfeIrRangeInvalidField(String)


record CtfeIrFieldAccess {
	receiver: CtfeIrExpr,
	kind: CtfeIrFieldAccessKind
}


record CtfeIrImportedGlobal {
	module_path: String,
	name: String
}


record CtfeIrMatchCase {
	pattern: TypedPattern,
	body: CtfeIrExpr
}


union CtfeIrExprDesc:
	CtfeIrLiteralExpr(CtfeIrLiteral)
	CtfeIrIdentExpr(CtfeIrIdentifier)
	CtfeIrTransparentExpr(CtfeIrExpr)
	CtfeIrUnaryExpr(ParsedUnaryOp, CtfeIrExpr)
	CtfeIrBinaryExpr(ParsedBinaryOp, CtfeIrExpr, CtfeIrExpr)
	CtfeIrLogicalExpr(ParsedLogicalOp, CtfeIrExpr, CtfeIrExpr)
	CtfeIrIfExpr(CtfeIrExpr, CtfeIrExpr, Option[CtfeIrExpr])
	CtfeIrCallExpr(CtfeIrCall)
	CtfeIrTupleExpr(List[CtfeIrExpr])
	CtfeIrListExpr(List[CtfeIrExpr])
	CtfeIrVectorExpr(List[CtfeIrExpr])
	CtfeIrRecordExpr(List[CtfeIrField])
	CtfeIrRecordUpdateExpr(CtfeIrExpr, List[CtfeIrField])
	CtfeIrDictExpr(List[CtfeIrDictEntry])
	CtfeIrLambdaExpr(CtfeLambdaSource)
	CtfeIrFieldAccessExpr(CtfeIrFieldAccess)
	CtfeIrImportedGlobalExpr(CtfeIrImportedGlobal)
	CtfeIrRangeExpr(CtfeIrExpr, CtfeIrExpr)
	CtfeIrMatchExpr(CtfeIrExpr, List[CtfeIrMatchCase])
	CtfeIrWhileExpr(CtfeIrExpr, CtfeIrExpr)
	CtfeIrForExpr(String, CtfeIrExpr, CtfeIrExpr)
	CtfeIrForTupleExpr(List[String], CtfeIrExpr, CtfeIrExpr)
	CtfeIrBreakExpr
	CtfeIrContinueExpr
	CtfeIrBlockExpr(CtfeIrBlock)
	CtfeIrStringInterpolationExpr(List[CtfeIrStringPart], Bool)
	CtfeIrVoidExpr


record CtfeIrExpr {
	span: SourceSpan,
	value_type: SemanticType,
	desc: CtfeIrExprDesc
}


record CtfeIrTranslateError {
	span: SourceSpan,
	form: String
}


pure func ctfe_ir_translate_error_message(error: CtfeIrTranslateError) -> String:
	"compile-time constant evaluation does not support " + error.form + " yet"


private pure func ctfe_ir_expr_span(expr: TypedExpr) -> SourceSpan:
	match expr:
		TypedNameExpr(name, _):
			name.span
		TypedIntLiteralExpr(_, span, _):
			span
		TypedFloatLiteralExpr(_, span, _):
			span
		TypedStringLiteralExpr(_, span, _):
			span
		TypedStringInterpolationExpr(_, _, span, _):
			span
		TypedStringInterpolationPartsExpr(_, _, span, _):
			span
		TypedBoolLiteralExpr(_, span, _):
			span
		TypedCharLiteralExpr(_, span, _):
			span
		TypedUnaryExpr(_, _, span, _):
			span
		TypedBinaryExpr(_, _, _, span, _):
			span
		TypedLogicalExpr(_, _, _, span, _):
			span
		TypedCallExpr(_, _, span, _):
			span
		TypedTupleExpr(_, span, _):
			span
		TypedTupleDestructExpr(_, _, span, _):
			span
		TypedAssignExpr(_, _, _, span, _):
			span
		TypedSubscriptExpr(_, _, span, _):
			span
		TypedSubscriptAssignExpr(_, _, _, _, span, _):
			span
		TypedListExpr(_, span, _):
			span
		TypedVectorExpr(_, span, _):
			span
		TypedDictExpr(_, span, _):
			span
		TypedOpaqueIntoExpr(_, _, span, _):
			span
		TypedOpaqueFromExpr(_, _, span, _):
			span
		TypedRecordExpr(_, span, _):
			span
		TypedRecordUpdateExpr(_, _, _, span, _):
			span
		TypedFieldAccessExpr(_, _, span, _):
			span
		TypedLambdaExpr(_, _, _, _, span, _):
			span
		TypedRangeExpr(_, _, span, _):
			span
		TypedIfExpr(_, _, _, span, _):
			span
		TypedMatchExpr(_, _, span, _):
			span
		TypedSelectExpr(_, span, _):
			span
		TypedWhileExpr(_, _, span, _):
			span
		TypedForExpr(_, _, _, _, span, _):
			span
		TypedConcurrentBlockExpr(_, _, span, _):
			span
		TypedConcurrentForExpr(_, _, _, _, span, _):
			span
		TypedDetachExpr(_, span, _):
			span
		TypedAscriptionExpr(_, _, span, _):
			span
		TypedBlockExpr(_, span, _):
			span
		TypedWithExpr(_, _, span, _):
			span
		TypedDebugBlockExpr(_, span, _):
			span
		TypedVarDeclExpr(payload, _):
			payload.span
		TypedQuestionBindExpr(_, _, _, span, _):
			span
		TypedBreakExpr(span, _):
			span
		TypedContinueExpr(span, _):
			span
		TypedVoidExpr(span, _):
			span
		TypedBuiltinExpr(_, span, _):
			span
		TypedMissingExpr(span, _):
			span
		TypedUnsupportedExpr(_, span, _):
			span


private pure func ctfe_ir_expr(source: TypedExpr, desc: CtfeIrExprDesc) -> CtfeIrExpr:
	{
		span = ctfe_ir_expr_span(source),
		value_type = typed_expr_value_type(source),
		desc = desc
	}


private pure func ctfe_ir_unsupported(
	expr: TypedExpr,
	form: String,
) -> Result[CtfeIrExpr, CtfeIrTranslateError]:
	Err({
		span = ctfe_ir_expr_span(expr),
		form = form,
	})


private pure func ctfe_ir_clean_source_name(name: String) -> String:
	match name.index_of("#"):
		Some(index):
			name.substring(0, index)
		None:
			name


private pure func ctfe_ir_direct_call(
	callable_id: Int,
	source_name: String,
	purity: Purity,
) -> CtfeIrDirectCall:
	{
		callable_id = callable_id,
		source_name = ctfe_ir_clean_source_name(source_name),
		is_pure = purities_equal(purity, Pure)
	}


private pure func ctfe_ir_reference_kind(
	context: CtfeContext,
	name: String,
	resolved_call: Option[ResolvedCallInfo],
) -> CtfeIrReferenceKind:
	match resolved_call:
		Some(call):
			match call.target:
				ResolvedDirectCall(callable_id, origin):
					match origin:
						CallableLocal:
							CtfeIrLocalFunctionReference(
								ctfe_ir_direct_call(
									callable_id,
									call.source_name,
									call.purity,
								),
							)
						CallableConstructor(parent_type):
							if call.instantiated_params.length() == 0:
								CtfeIrNullaryConstructorReference({
									name = ctfe_ir_clean_source_name(call.source_name),
									parent_type = parent_type,
									callable_id = Some(callable_id),
								})
							else:
								CtfeIrUnsupportedFunctionReference(
									ctfe_ir_clean_source_name(call.source_name),
								)
						_:
							if purities_equal(call.purity, Pure):
								CtfeIrUnsupportedFunctionReference(
									ctfe_ir_clean_source_name(call.source_name),
								)
							else:
								CtfeIrImpureFunctionReference
				_:
					CtfeIrUnsupportedFunctionReference(ctfe_ir_clean_source_name(call.source_name))
		None:
			match ctfe_context_nullary_constructor_reference(context, name):
				Some(constructor):
					CtfeIrNullaryConstructorReference(constructor)
				None:
					CtfeIrValueReference


private pure func ctfe_ir_call_kind(
	context: CtfeContext,
	resolved_call: Option[ResolvedCallInfo],
) -> CtfeIrCallKind:
	match resolved_call:
		Some(call):
			match call.target:
				ResolvedDirectCall(callable_id, origin):
					if not purities_equal(call.purity, Pure):
						CtfeIrImpureCall
					else:
						match origin:
							CallableLocal:
								CtfeIrLocalCall(
									ctfe_ir_direct_call(
										callable_id,
										call.source_name,
										call.purity,
									),
								)
							CallableConstructor(parent_type):
								CtfeIrConstructorCall(
									ctfe_ir_direct_call(callable_id, call.source_name, call.purity),
									parent_type,
								)
							CallableImported(module_path):
								CtfeIrImportedCall(
									ctfe_ir_direct_call(callable_id, call.source_name, call.purity),
									module_path,
								)
							CallableBuiltin:
								source_name = ctfe_ir_clean_source_name(call.source_name)

								match ctfe_builtin_intrinsic(source_name):
									Some(intrinsic):
										CtfeIrBuiltinCall(
											ctfe_ir_direct_call(
												callable_id,
												call.source_name,
												call.purity,
											),
											intrinsic,
										)
									None:
										CtfeIrUnsupportedCall(source_name)
							CallableForeign:
								CtfeIrUnsupportedCall("foreign function calls")
							CallableImplMethod:
								CtfeIrUnsupportedCall("impl method calls")
				ResolvedTraitMethodCall(_, target):
					if not purities_equal(call.purity, Pure):
						CtfeIrImpureCall
					else:
						match target:
							Some(method_target):
								direct = ctfe_ir_direct_call(
									method_target.callable_id,
									call.source_name,
									call.purity,
								)

								match ctfe_context_function_by_callable_id(
									context,
									method_target.callable_id,
								):
									Some(_):
										CtfeIrLocalCall(direct)
									None:
										CtfeIrImportedCall(direct, method_target.module_path)
							None:
								CtfeIrIntrinsicCall(ctfe_ir_clean_source_name(call.source_name))
				ResolvedIntrinsicCall:
					CtfeIrIntrinsicCall(ctfe_ir_clean_source_name(call.source_name))
				ResolvedClosureCall:
					CtfeIrClosureCall
		None:
			CtfeIrUnresolvedCall


private pure func ctfe_ir_exprs_from_typed(
	context: CtfeContext,
	items: List[TypedExpr],
) -> Result[List[CtfeIrExpr], CtfeIrTranslateError]:
	var result: List[CtfeIrExpr] = []
	var failure: Option[CtfeIrTranslateError] = None

	for item in items:
		match ctfe_ir_from_typed_expr(context, item):
			Ok(converted):
				result = result.append(converted)
			Err(error):
				failure = Some(error)
				break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(result)


private pure func ctfe_ir_tuple_field_kind(field: String, arity: Int) -> CtfeIrFieldAccessKind:
	match field.parse_int():
		Some(index):
			if index >= 0 and index < arity:
				CtfeIrTupleField(index, field)
			else:
				CtfeIrTupleInvalidField(field)
		None:
			CtfeIrTupleInvalidField(field)


private pure func ctfe_ir_field_access_kind(
	receiver_type: SemanticType,
	field: String,
) -> CtfeIrFieldAccessKind:
	match receiver_type:
		SemanticTupleType(elements):
			ctfe_ir_tuple_field_kind(field, elements.length())
		SemanticNamedType(name, args):
			if name == "Tuple":
				ctfe_ir_tuple_field_kind(field, args.length())
			else if name == "Range" and args.length() == 0:
				if field == "start":
					CtfeIrRangeStartField
				else if field == "end":
					CtfeIrRangeEndField
				else:
					CtfeIrRangeInvalidField(field)
			else:
				CtfeIrRecordField(field)
		_:
			CtfeIrRecordField(field)


private pure func ctfe_ir_qualified_field_expr(
	context: CtfeContext,
	receiver: TypedExpr,
	field: ParsedIdentifier,
) -> Option[CtfeIrExprDesc]:
	match receiver:
		TypedNameExpr(receiver_name, _):
			match ctfe_context_module_alias(context, receiver_name.text):
				Some(module_path):
					if ctfe_context_module_has_global_binding(context, module_path, field.text):
						Some(CtfeIrImportedGlobalExpr({
							module_path = module_path,
							name = field.text,
						}))
					else:
						match ctfe_context_nullary_constructor_reference(context, field.text):
							Some(constructor):
								Some(CtfeIrIdentExpr({
									name = field.text,
									reference_kind = CtfeIrNullaryConstructorReference(constructor),
								}))
							None:
								Some(CtfeIrImportedGlobalExpr({
									module_path = module_path,
									name = field.text,
								}))
				None:
					None
		_:
			None


private pure func ctfe_ir_block_item_from_typed(
	context: CtfeContext,
	expr: TypedExpr,
) -> Result[CtfeIrBlockItem, CtfeIrTranslateError]:
	match expr:
		TypedVarDeclExpr(payload, _):
			init ?= ctfe_ir_from_typed_expr(context, payload.initializer)
			Ok(CtfeIrBindValueItem(payload.name.text, payload.annotation, init, payload.is_mutable))
		TypedAssignExpr(name, scope, value, span, _):
			value_ir ?= ctfe_ir_from_typed_expr(context, value)

			target: CtfeIrAssignTarget = if name.text == "_":
				CtfeIrDiscardAssign
			else:
				match scope:
					LocalAssignScope:
						CtfeIrLocalAssign(name.text)
					ModuleAssignScope:
						CtfeIrModuleAssign(name.text)

			Ok(CtfeIrAssignItem(target, value_ir, span))
		TypedTupleDestructExpr(names, init, _, _):
			init_ir ?= ctfe_ir_from_typed_expr(context, init)
			name_texts = names.map(func(name): name.text)
			Ok(CtfeIrBindTupleItem(name_texts, init_ir))
		TypedQuestionBindExpr(name, annotation, value, _, _):
			value_ir ?= ctfe_ir_from_typed_expr(context, value)
			Ok(CtfeIrBindQuestionItem(name.text, annotation, value_ir))
		_:
			discard ?= ctfe_ir_from_typed_expr(context, expr)
			Ok(CtfeIrDiscardItem(discard))


private pure func ctfe_ir_block_item_has_void_result(expr: TypedExpr) -> Bool:
	match expr:
		TypedAssignExpr(_, _, _, _, _):
			True
		TypedTupleDestructExpr(_, _, _, _):
			True
		TypedQuestionBindExpr(_, _, _, _, _):
			True
		TypedVarDeclExpr(_, _):
			True
		_:
			False


private pure func ctfe_ir_block_from_typed(
	context: CtfeContext,
	source: TypedExpr,
	items: List[TypedExpr],
) -> Result[CtfeIrBlock, CtfeIrTranslateError]:
	if items.length() == 0:
		Err({
			span = ctfe_ir_expr_span(source),
			form = "empty blocks",
		})
	else:
		var block_items: List[CtfeIrBlockItem] = []
		var result: Option[CtfeIrExpr] = None
		var failure: Option[CtfeIrTranslateError] = None
		var index: Int = 0
		last_index: Int = items.length() - 1

		for item in items:
			if index == last_index:
				if ctfe_ir_block_item_has_void_result(item):
					match ctfe_ir_block_item_from_typed(context, item):
						Ok(block_item):
							block_items = block_items.append(block_item)
							result = Some(ctfe_ir_expr(item, CtfeIrVoidExpr))
						Err(error):
							failure = Some(error)
							break
				else:
					match ctfe_ir_from_typed_expr(context, item):
						Ok(converted):
							result = Some(converted)
						Err(error):
							failure = Some(error)
							break
			else:
				match ctfe_ir_block_item_from_typed(context, item):
					Ok(block_item):
						block_items = block_items.append(block_item)
					Err(error):
						failure = Some(error)
						break

			index += 1

		match failure:
			Some(error):
				Err(error)
			None:
				match result:
					Some(result_expr):
						Ok({
							items = block_items,
							result = result_expr,
						})
					None:
						Err({
							span = ctfe_ir_expr_span(source),
							form = "empty blocks",
						})


private pure func ctfe_ir_record_fields_from_typed(
	context: CtfeContext,
	fields: List[TypedRecordField],
) -> Result[List[CtfeIrField], CtfeIrTranslateError]:
	var result: List[CtfeIrField] = []
	var failure: Option[CtfeIrTranslateError] = None

	for field in fields:
		match ctfe_ir_from_typed_expr(context, field.value):
			Ok(value):
				result = result.append({
					name = field.name.text,
					value = value,
				})
			Err(error):
				failure = Some(error)
				break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(result)


private pure func ctfe_ir_dict_entries_from_typed(
	context: CtfeContext,
	entries: List[TypedDictEntry],
) -> Result[List[CtfeIrDictEntry], CtfeIrTranslateError]:
	var result: List[CtfeIrDictEntry] = []
	var failure: Option[CtfeIrTranslateError] = None

	for entry in entries:
		match ctfe_ir_from_typed_expr(context, entry.key):
			Ok(key):
				match ctfe_ir_from_typed_expr(context, entry.value):
					Ok(value):
						result = result.append({
							key = key,
							value = value,
						})
					Err(error):
						failure = Some(error)
						break
			Err(error):
				failure = Some(error)
				break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(result)


private pure func ctfe_ir_string_parts_from_typed(
	context: CtfeContext,
	parts: List[TypedStringInterpolationPart],
) -> Result[List[CtfeIrStringPart], CtfeIrTranslateError]:
	var result: List[CtfeIrStringPart] = []
	var failure: Option[CtfeIrTranslateError] = None

	for part in parts:
		converted_result: Result[CtfeIrStringPart, CtfeIrTranslateError] = match part:
			TypedInterpolationLiteral(text):
				Ok(CtfeIrStringText(text))
			TypedInterpolationExpr(expr):
				match ctfe_ir_from_typed_expr(context, expr):
					Ok(value):
						Ok(CtfeIrStringExpr(value))
					Err(error):
						Err(error)

		match converted_result:
			Ok(converted):
				result = result.append(converted)
			Err(error):
				failure = Some(error)
				break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(result)


private pure func ctfe_ir_match_cases_from_typed(
	context: CtfeContext,
	cases: List[TypedMatchCase],
) -> Result[List[CtfeIrMatchCase], CtfeIrTranslateError]:
	var result: List[CtfeIrMatchCase] = []
	var failure: Option[CtfeIrTranslateError] = None

	for case in cases:
		match ctfe_ir_from_typed_expr(context, case.body):
			Ok(body):
				result = result.append({
					pattern = case.pattern,
					body = body,
				})
			Err(error):
				failure = Some(error)
				break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(result)


pure func ctfe_ir_from_typed_expr(
	context: CtfeContext,
	expr: TypedExpr,
) -> Result[CtfeIrExpr, CtfeIrTranslateError]:
	match expr:
		TypedNameExpr(name, _):
			Ok(ctfe_ir_expr(
				expr,
				CtfeIrIdentExpr({
					name = name.text,
					reference_kind = ctfe_ir_reference_kind(
						context,
						name.text,
						typed_expr_resolved_call(expr),
					),
				}),
			))
		TypedIntLiteralExpr(text, _, _):
			Ok(ctfe_ir_expr(expr, CtfeIrLiteralExpr(CtfeIrIntLiteral(text))))
		TypedFloatLiteralExpr(text, _, _):
			Ok(ctfe_ir_expr(expr, CtfeIrLiteralExpr(CtfeIrFloatLiteral(text))))
		TypedStringLiteralExpr(text, _, _):
			Ok(ctfe_ir_expr(expr, CtfeIrLiteralExpr(CtfeIrStringLiteral(text))))
		TypedBoolLiteralExpr(value, _, _):
			Ok(ctfe_ir_expr(expr, CtfeIrLiteralExpr(CtfeIrBoolLiteral(value))))
		TypedCharLiteralExpr(value, _, _):
			Ok(ctfe_ir_expr(expr, CtfeIrLiteralExpr(CtfeIrCharLiteral(value))))
		TypedUnaryExpr(op, inner, _, _):
			inner_ir ?= ctfe_ir_from_typed_expr(context, inner)
			Ok(ctfe_ir_expr(expr, CtfeIrUnaryExpr(op, inner_ir)))
		TypedBinaryExpr(op, left, right, _, _):
			left_ir ?= ctfe_ir_from_typed_expr(context, left)
			right_ir ?= ctfe_ir_from_typed_expr(context, right)
			Ok(ctfe_ir_expr(expr, CtfeIrBinaryExpr(op, left_ir, right_ir)))
		TypedLogicalExpr(op, left, right, _, _):
			left_ir ?= ctfe_ir_from_typed_expr(context, left)
			right_ir ?= ctfe_ir_from_typed_expr(context, right)
			Ok(ctfe_ir_expr(expr, CtfeIrLogicalExpr(op, left_ir, right_ir)))
		TypedIfExpr(condition, then_expr, else_expr, _, _):
			condition_ir ?= ctfe_ir_from_typed_expr(context, condition)
			then_ir ?= ctfe_ir_from_typed_expr(context, then_expr)

			else_ir ?= match else_expr:
				Some(value):
					match ctfe_ir_from_typed_expr(context, value):
						Ok(converted):
							Ok(Some(converted))
						Err(error):
							Err(error)
				None:
					Ok(None)

			Ok(ctfe_ir_expr(expr, CtfeIrIfExpr(condition_ir, then_ir, else_ir)))
		TypedTupleExpr(items, _, _):
			items_ir ?= ctfe_ir_exprs_from_typed(context, items)
			Ok(ctfe_ir_expr(expr, CtfeIrTupleExpr(items_ir)))
		TypedListExpr(items, _, _):
			items_ir ?= ctfe_ir_exprs_from_typed(context, items)
			Ok(ctfe_ir_expr(expr, CtfeIrListExpr(items_ir)))
		TypedVectorExpr(items, _, _):
			items_ir ?= ctfe_ir_exprs_from_typed(context, items)
			Ok(ctfe_ir_expr(expr, CtfeIrVectorExpr(items_ir)))
		TypedRecordExpr(fields, _, _):
			fields_ir ?= ctfe_ir_record_fields_from_typed(context, fields)
			Ok(ctfe_ir_expr(expr, CtfeIrRecordExpr(fields_ir)))
		TypedRecordUpdateExpr(base, fields, _, _, _):
			base_ir ?= ctfe_ir_from_typed_expr(context, base)
			fields_ir ?= ctfe_ir_record_fields_from_typed(context, fields)
			Ok(ctfe_ir_expr(expr, CtfeIrRecordUpdateExpr(base_ir, fields_ir)))
		TypedDictExpr(entries, _, _):
			entries_ir ?= ctfe_ir_dict_entries_from_typed(context, entries)
			Ok(ctfe_ir_expr(expr, CtfeIrDictExpr(entries_ir)))
		TypedFieldAccessExpr(receiver, field, _, _):
			match ctfe_ir_qualified_field_expr(context, receiver, field):
				Some(desc):
					Ok(ctfe_ir_expr(expr, desc))
				None:
					receiver_ir ?= ctfe_ir_from_typed_expr(context, receiver)
					Ok(ctfe_ir_expr(
						expr,
						CtfeIrFieldAccessExpr({
							receiver = receiver_ir,
							kind = ctfe_ir_field_access_kind(receiver_ir.value_type, field.text),
						}),
					))
		TypedRangeExpr(start_expr, end_expr, _, _):
			start_ir ?= ctfe_ir_from_typed_expr(context, start_expr)
			end_ir ?= ctfe_ir_from_typed_expr(context, end_expr)
			Ok(ctfe_ir_expr(expr, CtfeIrRangeExpr(start_ir, end_ir)))
		TypedBlockExpr(items, _, _):
			block ?= ctfe_ir_block_from_typed(context, expr, items)
			Ok(ctfe_ir_expr(expr, CtfeIrBlockExpr(block)))
		TypedAscriptionExpr(inner, _, _, _):
			inner_ir ?= ctfe_ir_from_typed_expr(context, inner)
			Ok(ctfe_ir_expr(expr, CtfeIrTransparentExpr(inner_ir)))
		TypedOpaqueIntoExpr(_, inner, _, _):
			inner_ir ?= ctfe_ir_from_typed_expr(context, inner)
			Ok(ctfe_ir_expr(expr, CtfeIrTransparentExpr(inner_ir)))
		TypedOpaqueFromExpr(_, inner, _, _):
			inner_ir ?= ctfe_ir_from_typed_expr(context, inner)
			Ok(ctfe_ir_expr(expr, CtfeIrTransparentExpr(inner_ir)))
		TypedVoidExpr(_, _):
			Ok(ctfe_ir_expr(expr, CtfeIrVoidExpr))
		TypedStringInterpolationExpr(_, _, _, _):
			ctfe_ir_unsupported(expr, "string interpolation")
		TypedStringInterpolationPartsExpr(parts, is_multiline, _, _):
			parts_ir ?= ctfe_ir_string_parts_from_typed(context, parts)
			Ok(ctfe_ir_expr(expr, CtfeIrStringInterpolationExpr(parts_ir, is_multiline)))
		TypedMatchExpr(scrutinee, cases, _, _):
			scrutinee_ir ?= ctfe_ir_from_typed_expr(context, scrutinee)
			cases_ir ?= ctfe_ir_match_cases_from_typed(context, cases)
			Ok(ctfe_ir_expr(expr, CtfeIrMatchExpr(scrutinee_ir, cases_ir)))
		TypedCallExpr(callee, args, _, _):
			callee_ir ?= ctfe_ir_from_typed_expr(context, callee)
			args_ir ?= ctfe_ir_exprs_from_typed(context, args)
			Ok(ctfe_ir_expr(
				expr,
				CtfeIrCallExpr({
					kind = ctfe_ir_call_kind(context, typed_expr_resolved_call(expr)),
					callee = callee_ir,
					args = args_ir,
				}),
			))
		TypedTupleDestructExpr(_, _, _, _):
			ctfe_ir_unsupported(expr, "tuple destructuring as a value")
		TypedAssignExpr(_, _, _, _, _):
			ctfe_ir_unsupported(expr, "assignments")
		TypedSubscriptExpr(_, _, _, _):
			ctfe_ir_unsupported(expr, "subscript expressions")
		TypedSubscriptAssignExpr(_, _, _, _, _, _):
			ctfe_ir_unsupported(expr, "subscript assignments")
		TypedLambdaExpr(is_pure, params, return_annotation, body, span, info):
			Ok(ctfe_ir_expr(
				expr,
				CtfeIrLambdaExpr({
					is_pure = is_pure,
					params = params,
					return_annotation = return_annotation,
					body = body,
					span = span,
					info = info,
				}),
			))
		TypedSelectExpr(_, _, _):
			ctfe_ir_unsupported(expr, "select expressions")
		TypedWhileExpr(condition, body, _, _):
			condition_ir ?= ctfe_ir_from_typed_expr(context, condition)
			body_ir ?= ctfe_ir_from_typed_expr(context, body)
			Ok(ctfe_ir_expr(expr, CtfeIrWhileExpr(condition_ir, body_ir)))
		TypedForExpr(binder, iterable, _, body, _, _):
			iterable_ir ?= ctfe_ir_from_typed_expr(context, iterable)
			body_ir ?= ctfe_ir_from_typed_expr(context, body)

			match binder:
				ParsedForNameBinder(name):
					Ok(ctfe_ir_expr(expr, CtfeIrForExpr(name.text, iterable_ir, body_ir)))
				ParsedForTupleBinder(names, _):
					name_texts = names.map(func(name): name.text)
					Ok(ctfe_ir_expr(expr, CtfeIrForTupleExpr(name_texts, iterable_ir, body_ir)))
		TypedConcurrentBlockExpr(_, _, _, _):
			ctfe_ir_unsupported(expr, "concurrent blocks")
		TypedConcurrentForExpr(_, _, _, _, _, _):
			ctfe_ir_unsupported(expr, "concurrently loops")
		TypedDetachExpr(_, _, _):
			ctfe_ir_unsupported(expr, "detach expressions")
		TypedWithExpr(_, _, _, _):
			ctfe_ir_unsupported(expr, "resource with expressions")
		TypedDebugBlockExpr(_, _, _):
			ctfe_ir_unsupported(expr, "debug blocks")
		TypedVarDeclExpr(_, _):
			ctfe_ir_unsupported(expr, "block binding as a value")
		TypedQuestionBindExpr(_, _, _, _, _):
			ctfe_ir_unsupported(expr, "?= bindings")
		TypedBreakExpr(_, _):
			Ok(ctfe_ir_expr(expr, CtfeIrBreakExpr))
		TypedContinueExpr(_, _):
			Ok(ctfe_ir_expr(expr, CtfeIrContinueExpr))
		TypedBuiltinExpr(_, _, _):
			ctfe_ir_unsupported(expr, "builtin expressions")
		TypedMissingExpr(_, _):
			ctfe_ir_unsupported(expr, "missing expressions")
		TypedUnsupportedExpr(message, _, _):
			ctfe_ir_unsupported(expr, message)


pure func ctfe_ir_from_typed_expr_without_context(
	expr: TypedExpr,
) -> Result[CtfeIrExpr, CtfeIrTranslateError]:
	ctfe_ir_from_typed_expr(CTFE_CONTEXT_EMPTY, expr)
