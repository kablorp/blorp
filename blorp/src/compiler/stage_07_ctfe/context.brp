-- Compile-time evaluator context construction and lookup.
--
-- This is the metadata layer for CTFE. It indexes typed functions,
-- constructor metadata, and module global environments without performing
-- evaluation.
import:
	../stage_03_parse/parsed_ast: ParsedDecl(PrivateParsedDecl, UnionParsedDecl), ParsedUnionDecl
	../stage_04_modules/module_table:
		ModuleId,
		ModuleTable,
		module_id_table_index,
		module_ids_equal,
		module_table_canonical_path,
		module_table_count,
		module_table_find_id_by_canonical_path,
		module_tables_are_compatible,
		module_tables_have_same_identity_rows,
	../stage_06_typecheck/decl:
		TypedDecl(
			TypedFunctionDecl,
			TypedImplDecl,
			TypedParsedDecl,
			TypedPrivateDecl,
			TypedUnionDecl,
		),
		TypedFunctionInfo,
		TypedProgram,
		TypedUnionInfo,
		typed_decls_function_infos,
	../stage_06_typecheck/modules/import_binding:
		ImportBinding(QualifiedModuleBinding, SelectiveDefinitionBinding),
	env: CTFE_ENV_EMPTY, ctfe_env_has_binding, ctfe_lookup_value
	value: CtfeConstructorInfo, CtfeEnv, CtfeValue, ctfe_constructor_info


record CtfeFunction {
	info: TypedFunctionInfo,
	source_name: String,
	module_id: ModuleId
}


union CtfeImportBinding:
	CtfeQualifiedModuleBinding(String, ModuleId)
	CtfeSelectiveDefinitionBinding(String, ModuleId, String)


private union CtfeImportedProgramRep:
	CompleteCtfeImportedProgram(ModuleTable, ModuleId, List[TypedDecl], List[CtfeImportBinding])
	DeclarationOnlyCtfeImportedProgram(ModuleTable, ModuleId, List[TypedDecl], List[CtfeImportBinding])
	SelectiveCtfeImportedProgram(ModuleTable, ModuleId, List[TypedDecl], List[TypedFunctionInfo], List[CtfeImportBinding])


opaque type CtfeImportedProgram = CtfeImportedProgramRep


pure func complete_ctfe_imported_program(
	module_table: ModuleTable,
	module_id: ModuleId,
	decls: List[TypedDecl],
	import_bindings: List[CtfeImportBinding],
) -> CtfeImportedProgram:
	into_opaque CtfeImportedProgram(
		CompleteCtfeImportedProgram(module_table, module_id, decls, import_bindings)
	)


pure func selective_ctfe_imported_program(
	module_table: ModuleTable,
	module_id: ModuleId,
	decls: List[TypedDecl],
	selected_functions: List[TypedFunctionInfo],
	import_bindings: List[CtfeImportBinding],
) -> CtfeImportedProgram:
	if selected_functions.is_empty():
		into_opaque CtfeImportedProgram(
			DeclarationOnlyCtfeImportedProgram(module_table, module_id, decls, import_bindings)
		)
	else:
		into_opaque CtfeImportedProgram(
			SelectiveCtfeImportedProgram(
				module_table,
				module_id,
				decls,
				selected_functions,
				import_bindings,
			)
		)


pure func ctfe_imported_program_module_table(program: CtfeImportedProgram) -> ModuleTable:
	match from_opaque CtfeImportedProgram(program):
		CompleteCtfeImportedProgram(module_table, _, _, _):
			module_table
		DeclarationOnlyCtfeImportedProgram(module_table, _, _, _):
			module_table
		SelectiveCtfeImportedProgram(module_table, _, _, _, _):
			module_table


pure func ctfe_imported_program_module_id(program: CtfeImportedProgram) -> ModuleId:
	match from_opaque CtfeImportedProgram(program):
		CompleteCtfeImportedProgram(_, module_id, _, _):
			module_id
		DeclarationOnlyCtfeImportedProgram(_, module_id, _, _):
			module_id
		SelectiveCtfeImportedProgram(_, module_id, _, _, _):
			module_id


pure func ctfe_imported_program_decls(program: CtfeImportedProgram) -> List[TypedDecl]:
	match from_opaque CtfeImportedProgram(program):
		CompleteCtfeImportedProgram(_, _, decls, _):
			decls
		DeclarationOnlyCtfeImportedProgram(_, _, decls, _):
			decls
		SelectiveCtfeImportedProgram(_, _, decls, _, _):
			decls


pure func ctfe_imported_program_functions(
	program: CtfeImportedProgram,
) -> Option[List[TypedFunctionInfo]]:
	match from_opaque CtfeImportedProgram(program):
		CompleteCtfeImportedProgram(_, _, decls, _):
			functions = typed_decls_function_infos(decls)

			if functions.is_empty():
				None
			else:
				Some(functions)
		DeclarationOnlyCtfeImportedProgram(_, _, _, _):
			None
		SelectiveCtfeImportedProgram(_, _, _, selected_functions, _):
			Some(selected_functions)


pure func ctfe_imported_program_import_bindings(
	program: CtfeImportedProgram,
) -> List[CtfeImportBinding]:
	match from_opaque CtfeImportedProgram(program):
		CompleteCtfeImportedProgram(_, _, _, import_bindings):
			import_bindings
		DeclarationOnlyCtfeImportedProgram(_, _, _, import_bindings):
			import_bindings
		SelectiveCtfeImportedProgram(_, _, _, _, import_bindings):
			import_bindings


record CtfeImportedFunctionGroup {
	module_id: ModuleId,
	source_name: String,
	functions: List[CtfeFunction]
}


private NO_IMPORTED_FUNCTION_INDEX: Int = -1


record CtfeModuleAlias {
	owner_module_id: ModuleId,
	local_name: String,
	module_id: ModuleId
}


record CtfeNullaryConstructorReference {
	name: String,
	parent_type: String,
	callable_id: Option[Int]
}


record CtfeContext {
	module_table: ModuleTable,
	target_module_id: ModuleId,
	functions: List[(Int, CtfeFunction)],
	imported_functions: List[CtfeImportedFunctionGroup],
	constructors: List[(String, CtfeConstructorInfo)],
	module_aliases: List[CtfeModuleAlias],
	module_global_envs: List[CtfeEnv],
	active_module_id: ModuleId
}


pure func ctfe_context_empty(module_table: ModuleTable, active_module_id: ModuleId) -> CtfeContext:
	var module_global_envs: List[CtfeEnv] = []
	var module_index: Int = 0

	while module_index < module_table_count(module_table):
		module_global_envs = module_global_envs.append(CTFE_ENV_EMPTY)
		module_index += 1

	{
		module_table = module_table,
		target_module_id = active_module_id,
		functions = [],
		imported_functions = [],
		constructors = [],
		module_aliases = [],
		module_global_envs = module_global_envs,
		active_module_id = active_module_id
	}


pure func ctfe_context_constructor_info(
	context: CtfeContext,
	name: String,
) -> Option[CtfeConstructorInfo]:
	var result: Option[CtfeConstructorInfo] = None

	for (constructor_name, info) in context.constructors:
		if result.is_none() and constructor_name == name:
			result = Some(info)
			break

	result


pure func ctfe_context_nullary_constructor_reference(
	context: CtfeContext,
	name: String,
) -> Option[CtfeNullaryConstructorReference]:
	match ctfe_context_constructor_info(context, name):
		Some(info):
			if info.arity == 0:
				Some({
					name = name,
					parent_type = info.parent_type,
					callable_id = info.callable_id,
				})
			else:
				None
		None:
			None


pure func ctfe_context_function_by_callable_id(
	context: CtfeContext,
	callable_id: Int,
) -> Option[CtfeFunction]:
	var result: Option[CtfeFunction] = None

	for (id, ctfe_function) in context.functions:
		if (
			result.is_none()
			and id == callable_id
			and module_ids_equal(ctfe_function.module_id, context.active_module_id)
		):
			result = Some(ctfe_function)
			break

	result


pure func ctfe_context_imported_functions_by_source(
	context: CtfeContext,
	module_id: ModuleId,
	source_name: String,
) -> List[CtfeFunction]:
	var result: Option[List[CtfeFunction]] = None

	for group in context.imported_functions:
		if (
			result.is_none()
			and module_ids_equal(group.module_id, module_id)
			and group.source_name == source_name
		):
			result = Some(group.functions)
			break

	result.get_or([])


pure func ctfe_context_imported_function_by_callable_id(
	context: CtfeContext,
	module_id: ModuleId,
	source_name: String,
	callable_id: Int,
) -> Option[CtfeFunction]:
	functions = ctfe_context_imported_functions_by_source(context, module_id, source_name)
	var result: Option[CtfeFunction] = None

	for ctfe_function in functions:
		if result.is_none() and ctfe_function.info.callable_id == Some(callable_id):
			result = Some(ctfe_function)
			break

	if result.is_some():
		result
	else if functions.length() == 1:
		functions.get(0)
	else:
		None


pure func ctfe_context_module_path(context: CtfeContext, module_id: ModuleId) -> Option[String]:
	module_table_canonical_path(context.module_table, module_id)


pure func ctfe_context_module_global_env(context: CtfeContext, module_id: ModuleId) -> CtfeEnv:
	context.module_global_envs.get_or(module_id_table_index(module_id), CTFE_ENV_EMPTY)


pure func ctfe_context_module_global_value(
	context: CtfeContext,
	module_id: ModuleId,
	name: String,
) -> Option[CtfeValue]:
	match ctfe_lookup_value(
		ctfe_context_module_global_env(context, module_id),
		name,
	):
		Ok(value):
			Some(value)
		Err(_):
			None


pure func ctfe_context_module_alias(context: CtfeContext, local_name: String) -> Option[ModuleId]:
	var result: Option[ModuleId] = None

	for module_alias in context.module_aliases:
		if (
			result.is_none()
			and module_ids_equal(module_alias.owner_module_id, context.active_module_id)
			and module_alias.local_name == local_name
		):
			result = Some(module_alias.module_id)
			break

	result


pure func ctfe_context_module_has_global_binding(
	context: CtfeContext,
	module_id: ModuleId,
	name: String,
) -> Bool:
	ctfe_env_has_binding(
		ctfe_context_module_global_env(context, module_id),
		name,
	)


pure func ctfe_context_with_module_alias(
	context: CtfeContext,
	local_name: String,
	module_id: ModuleId,
) -> CtfeContext:
	var replaced: Bool = False
	var aliases: List[CtfeModuleAlias] = []

	for module_alias in context.module_aliases:
		if (
			not replaced
			and module_ids_equal(module_alias.owner_module_id, context.active_module_id)
			and module_alias.local_name == local_name
		):
			aliases = aliases.append({
				owner_module_id = context.active_module_id,
				local_name = local_name,
				module_id = module_id,
			})
			replaced = True
		else:
			aliases = aliases.append(module_alias)

	if not replaced:
		aliases = aliases.append({
			owner_module_id = context.active_module_id,
			local_name = local_name,
			module_id = module_id,
		})

	{ context | module_aliases = aliases }


pure func ctfe_context_with_module_global_env(
	context: CtfeContext,
	issuing_table: ModuleTable,
	module_id: ModuleId,
	env: CtfeEnv,
) -> CtfeContext:
	match (
		(
			module_tables_are_compatible(context.module_table, issuing_table)
			or module_tables_have_same_identity_rows(context.module_table, issuing_table)
		),
		ctfe_context_module_path(context, module_id),
	):
		(True, Some(_)):
			{ context |
				module_global_envs = context.module_global_envs.set(
					module_id_table_index(module_id),
					env,
				)
			}
		_:
			context


pure func ctfe_import_bindings_for_module_table(
	module_table: ModuleTable,
	bindings: List[ImportBinding],
) -> Option[List[CtfeImportBinding]]:
	var result: List[CtfeImportBinding] = []
	var failed: Bool = False

	for binding in bindings:
		if not failed:
			match binding:
				QualifiedModuleBinding(local_name, module_path):
					match module_table_find_id_by_canonical_path(module_table, module_path):
						Some(module_id):
							result = result.append(
								CtfeQualifiedModuleBinding(
									local_name,
									module_id,
								),
							)
						None:
							failed = True
				SelectiveDefinitionBinding(local_name, module_path, source_name):
					match module_table_find_id_by_canonical_path(module_table, module_path):
						Some(module_id):
							result = result.append(
								CtfeSelectiveDefinitionBinding(
									local_name,
									module_id,
									source_name,
								),
							)
						None:
							failed = True

	if failed:
		None
	else:
		Some(result)


pure func ctfe_context_with_import_bindings(
	context: CtfeContext,
	bindings: List[CtfeImportBinding],
) -> CtfeContext:
	var result = context

	for binding in bindings:
		match binding:
			CtfeQualifiedModuleBinding(local_name, module_id):
				result = ctfe_context_with_module_alias(result, local_name, module_id)
			CtfeSelectiveDefinitionBinding(_, _, _):
				void

	result


private pure func ctfe_function_from_info(
	info: TypedFunctionInfo,
	module_id: ModuleId,
) -> Option[CtfeFunction]:
	match info.callable_id:
		Some(_):
			Some({
				info = info,
				source_name = info.decl.name.text,
				module_id = module_id,
			})
		None:
			None


private pure func ctfe_collect_function(
	functions: List[(Int, CtfeFunction)],
	info: TypedFunctionInfo,
	module_id: ModuleId,
) -> List[(Int, CtfeFunction)]:
	match (info.callable_id, ctfe_function_from_info(info, module_id)):
		(Some(callable_id), Some(ctfe_function)):
			functions.append((callable_id, ctfe_function))
		_:
			functions


private pure func ctfe_collect_decl_functions(
	functions: List[(Int, CtfeFunction)],
	decl: TypedDecl,
	module_id: ModuleId,
) -> List[(Int, CtfeFunction)]:
	match decl:
		TypedFunctionDecl(info):
			ctfe_collect_function(functions, info, module_id)
		TypedImplDecl(info):
			var result = functions

			for method in info.methods:
				result = ctfe_collect_function(result, method, module_id)

			result
		TypedPrivateDecl(inner):
			ctfe_collect_decl_functions(functions, inner, module_id)
		_:
			functions


private pure func ctfe_collect_program_functions(
	functions: List[(Int, CtfeFunction)],
	program: TypedProgram,
	module_id: ModuleId,
) -> List[(Int, CtfeFunction)]:
	var result = functions

	for decl in program.decls:
		result = ctfe_collect_decl_functions(result, decl, module_id)

	result


private pure func ctfe_collect_imported_function_info(
	functions: List[CtfeFunction],
	module_id: ModuleId,
	info: TypedFunctionInfo,
) -> List[CtfeFunction]:
	match ctfe_function_from_info(info, module_id):
		Some(ctfe_function):
			functions.append(ctfe_function)
		None:
			functions


private pure func ctfe_collect_decl_constructors(
	constructors: List[(String, CtfeConstructorInfo)],
	decl: TypedDecl,
) -> List[(String, CtfeConstructorInfo)]:
	match decl:
		TypedUnionDecl(info):
			var result = constructors

			for variant in info.variants:
				result = result.append(
					(
						variant.name,
						ctfe_constructor_info(
							info.decl.name.text,
							variant.fields.length(),
							variant.def_id,
						),
					),
				)

			result
		TypedParsedDecl(parsed_decl):
			match parsed_decl:
				UnionParsedDecl(union_decl):
					var result = constructors

					for variant in union_decl.variants:
						result = result.append(
							(
								variant.name.text,
								ctfe_constructor_info(
									union_decl.name.text,
									variant.fields.length(),
									None,
								),
							),
						)

					result
				PrivateParsedDecl(inner, _):
					ctfe_collect_decl_constructors(constructors, TypedParsedDecl(inner))
				_:
					constructors
		TypedPrivateDecl(inner):
			ctfe_collect_decl_constructors(constructors, inner)
		_:
			constructors


private pure func ctfe_collect_program_constructors(
	constructors: List[(String, CtfeConstructorInfo)],
	program: TypedProgram,
) -> List[(String, CtfeConstructorInfo)]:
	var result = constructors

	for decl in program.decls:
		result = ctfe_collect_decl_constructors(result, decl)

	result


private pure func ctfe_collect_decls_constructors(
	constructors: List[(String, CtfeConstructorInfo)],
	decls: List[TypedDecl],
) -> List[(String, CtfeConstructorInfo)]:
	var result = constructors

	for decl in decls:
		result = ctfe_collect_decl_constructors(result, decl)

	result


private pure func ctfe_merge_duplicate_imported_function_group(
	groups: List[CtfeImportedFunctionGroup],
	module_id: ModuleId,
	source_name: String,
	functions: List[CtfeFunction],
) -> List[CtfeImportedFunctionGroup]:
	var result: List[CtfeImportedFunctionGroup] = []
	var merged: Bool = False

	for group in groups:
		if (
			not merged
			and module_ids_equal(group.module_id, module_id)
			and group.source_name == source_name
		):
			var merged_functions = group.functions

			for ctfe_function in functions:
				merged_functions = merged_functions.append(ctfe_function)

			result = result.append({ group | functions = merged_functions })
			merged = True
		else:
			result = result.append(group)

	if not merged:
		result = result.append({
			module_id = module_id,
			source_name = source_name,
			functions = functions,
		})

	result


private pure func ctfe_context_from_program_in_domain(
	module_table: ModuleTable,
	target_module_id: ModuleId,
	program: TypedProgram,
	import_bindings: List[CtfeImportBinding],
	imported_programs: List[CtfeImportedProgram],
) -> CtfeContext:
	var constructors = ctfe_collect_program_constructors([], program)

	for imported in imported_programs:
		constructors = ctfe_collect_decls_constructors(
			constructors,
			ctfe_imported_program_decls(imported),
		)

	var functions = ctfe_collect_program_functions([], program, target_module_id)

	for imported in imported_programs:
		module_id = ctfe_imported_program_module_id(imported)

		match ctfe_imported_program_functions(imported):
			Some(infos):
				for info in infos:
					match ctfe_function_from_info(info, module_id):
						Some(ctfe_function):
							match info.callable_id:
								Some(callable_id):
									functions = functions.append((callable_id, ctfe_function))
								None:
									void
						None:
							void
			None:
				void

	var imported_groups: List[CtfeImportedFunctionGroup] = []
	var seen_imported_module_ids: List[Bool] = []

	for _ in 0..module_table_count(module_table):
		seen_imported_module_ids = seen_imported_module_ids.append(False)

	for imported in imported_programs:
		module_id = ctfe_imported_program_module_id(imported)
		module_index = module_id_table_index(module_id)
		module_id_was_seen: Bool = seen_imported_module_ids.get_or(module_index, False)
		seen_imported_module_ids = seen_imported_module_ids.set(module_index, True)
		-- Prepared CTFE dependencies are deduplicated by canonical module ID,
		-- so the function-name index only needs to live for this module.
		var module_functions: List[CtfeFunction] = []

		match ctfe_imported_program_functions(imported):
			Some(infos):
				for info in infos:
					module_functions = ctfe_collect_imported_function_info(
						module_functions,
						module_id,
						info,
					)
			None:
				void

		var source_names: List[String] = []
		var group_indices_by_source: Dict[String, Int] = {}
		var first_function_indices: List[Int] = []
		var last_function_indices: List[Int] = []
		var next_function_indices: List[Int] = []
		var function_index: Int = 0

		for ctfe_function in module_functions:
			next_function_indices = next_function_indices.append(NO_IMPORTED_FUNCTION_INDEX)

			match group_indices_by_source.get(ctfe_function.source_name):
				Some(group_index):
					match last_function_indices.get(group_index):
						Some(last_function_index):
							next_function_indices = next_function_indices.set(
								last_function_index,
								function_index,
							)
							last_function_indices = last_function_indices.set(
								group_index,
								function_index,
							)
						None:
							void
				None:
					group_index: Int = source_names.length()
					source_names = source_names.append(ctfe_function.source_name)
					group_indices_by_source = group_indices_by_source.set(
						ctfe_function.source_name,
						group_index,
					)
					first_function_indices = first_function_indices.append(function_index)
					last_function_indices = last_function_indices.append(function_index)

			function_index += 1

		var group_index: Int = 0

		for source_name in source_names:
			var functions: List[CtfeFunction] = []
			var current_function_index: Int = first_function_indices.get_or(
				group_index,
				NO_IMPORTED_FUNCTION_INDEX,
			)

			while current_function_index != NO_IMPORTED_FUNCTION_INDEX:
				match module_functions.get(current_function_index):
					Some(ctfe_function):
						functions = functions.append(ctfe_function)
						current_function_index = next_function_indices.get_or(
							current_function_index,
							NO_IMPORTED_FUNCTION_INDEX,
						)
					None:
						current_function_index = NO_IMPORTED_FUNCTION_INDEX

			if module_id_was_seen:
				-- Keep the public constructor's historical behavior for manually
				-- supplied duplicate modules without penalizing production graphs.
				imported_groups = ctfe_merge_duplicate_imported_function_group(
					imported_groups,
					module_id,
					source_name,
					functions,
				)
			else:
				imported_groups = imported_groups.append({
					module_id = module_id,
					source_name = source_name,
					functions = functions,
				})

			group_index += 1

	var context = { ctfe_context_empty(module_table, target_module_id) |
		functions = functions,
		imported_functions = imported_groups,
		constructors = constructors
	}
	context = ctfe_context_with_import_bindings(context, import_bindings)

	for imported in imported_programs:
		context = { context | active_module_id = ctfe_imported_program_module_id(imported) }
		context = ctfe_context_with_import_bindings(
			context,
			ctfe_imported_program_import_bindings(imported),
		)

	{ context | active_module_id = target_module_id }


pure func ctfe_context_from_program(
	module_table: ModuleTable,
	target_module_id: ModuleId,
	program: TypedProgram,
	import_bindings: List[CtfeImportBinding],
	imported_programs: List[CtfeImportedProgram],
) -> Option[CtfeContext]:
	var domain_is_valid = module_table_canonical_path(module_table, target_module_id).is_some()

	for imported in imported_programs:
		if (
			not ((
				module_tables_are_compatible(
					module_table,
					ctfe_imported_program_module_table(imported),
				)
				or module_tables_have_same_identity_rows(
					module_table,
					ctfe_imported_program_module_table(imported),
				)
			))
			or module_table_canonical_path(
				module_table,
				ctfe_imported_program_module_id(imported),
			).is_none()
		):
			domain_is_valid = False
			break

	if domain_is_valid:
		Some(
			ctfe_context_from_program_in_domain(
				module_table,
				target_module_id,
				program,
				import_bindings,
				imported_programs,
			),
		)
	else:
		None
