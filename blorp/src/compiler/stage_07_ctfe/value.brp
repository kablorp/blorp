-- Compile-time value representation and primitive operations.
--
-- This module owns CTFE value data, including the recursive closure/environment
-- shape. Environment operations and evaluation remain in their dedicated
-- modules; materialization owns rewriting values back into typed declarations.
import:
	../../lib/source: SourceLocation
	../stage_03_parse/parsed_ast:
		ParsedBinaryOp(
			ParsedAddOp,
			ParsedDivideOp,
			ParsedEqualOp,
			ParsedGreaterEqualOp,
			ParsedGreaterOp,
			ParsedLessEqualOp,
			ParsedLessOp,
			ParsedModuloOp,
			ParsedMultiplyOp,
			ParsedNotEqualOp,
			ParsedSubtractOp,
		),
		ParsedUnaryOp(ParsedNegateOp, ParsedNotOp),
	../stage_04_modules/module_table: ModuleId
	../stage_06_typecheck/headers/declaration_skeleton:
		CallableId,
		ConstructorId,
		callable_ids_equal,
		constructor_id_definition_id,
	../stage_06_typecheck/graph/definition_index:
		ResolvedFieldIdentity,
		field_ids_equal,
		resolved_field_identity_field_id
	../stage_06_typecheck/infer: TypedExpr, TypedExprInfo, TypedLambdaParam
	../stage_06_typecheck/type_system/semantic_type:
		SemanticType(SemanticNamedType),
		TYPE_BOOL,
		TYPE_CHAR,
		TYPE_FLOAT,
		TYPE_INT,
		TYPE_STRING,
		TYPE_VOID,
		type_to_string,


opaque type CtfeResolvedConstructorId = ConstructorId


union CtfeConstructorIdentity:
	ResolvedCtfeConstructor(CtfeResolvedConstructorId)
	SynthesizedCtfeConstructor


record CtfeConstructorInfo {
	parent_type: String,
	arity: Int,
	identity: CtfeConstructorIdentity
}


record CtfeConstructorPayload {
	name: String,
	args: List[CtfeValue],
	constructor_info: CtfeConstructorInfo
}


record CtfeFunctionReferencePayload {
	callable_id: CallableId,
	source_name: String,
	is_pure: Bool
}


---
Binding data lives with CTFE values because lambda values close over an
environment. Keeping both sides of that recursive relationship in one
module avoids making the value and environment modules import each other.
---
enum CtfeBindingScope:
	CtfeGlobalBinding
	CtfeLocalBinding


union CtfeUnavailableGlobalReason:
	CtfeCurrentGlobal
	CtfeLaterGlobal
	CtfeRuntimeInitializedGlobal
	CtfeImportedRuntimeInitializedGlobal(String, String)
	CtfePendingModuleGlobal(ModuleId)


union CtfeBindingValue:
	CtfeAvailableValue(CtfeValue)
	CtfeUnavailableGlobal(CtfeUnavailableGlobalReason)


record CtfeBinding {
	scope: CtfeBindingScope,
	is_mutable: Bool,
	value: CtfeBindingValue
}


opaque type CtfeEnv = List[(String, CtfeBinding)]


---
Known encapsulation hole: the recursive closure/value graph requires
CtfeEnv to live in this module, while lexical operations live in
ctfe_env. These bridges must therefore be public today. Only that
module should import them; remove them when Blorp supports module-private
collaborators.
---
pure func ctfe_env_unsafe_from_representation(bindings: List[(String, CtfeBinding)]) -> CtfeEnv:
	into_opaque CtfeEnv(bindings)


pure func ctfe_env_unsafe_representation(env: CtfeEnv) -> List[(String, CtfeBinding)]:
	from_opaque CtfeEnv(env)


record CtfeLambdaSource {
	is_pure: Bool,
	params: List[TypedLambdaParam],
	return_annotation: Option[SemanticType],
	body: TypedExpr,
	span: SourceLocation,
	info: TypedExprInfo
}


record CtfeLambdaPayload {
	source: CtfeLambdaSource,
	defining_module_id: ModuleId,
	env: CtfeEnv
}


union CtfeValueDesc:
	CtfeIntValue(Int)
	CtfeFloatValue(Float)
	CtfeBoolValue(Bool)
	CtfeCharValue(Char)
	CtfeStringValue(String)
	CtfeTupleValue(List[CtfeValue])
	CtfeListValue(List[CtfeValue])
	CtfeVectorValue(List[CtfeValue])
	CtfeDictValue(List[(CtfeValue, CtfeValue)])
	CtfeRecordValue(List[(String, CtfeValue, ResolvedFieldIdentity)])
	CtfeRangeValue(CtfeValue, CtfeValue)
	CtfeVoidValue
	CtfeConstructorValue(CtfeConstructorPayload)
	CtfeFunctionReferenceValue(CtfeFunctionReferencePayload)
	CtfeLambdaValue(CtfeLambdaPayload)


record CtfeValue {
	typ: SemanticType,
	desc: CtfeValueDesc,
	span: SourceLocation
}


union CtfeError:
	CtfeExpectedValue(String, String)
	CtfeUnsupported(String)
	CtfeInvalidOperator(String)


pure func ctfe_resolved_constructor_id(constructor_id: ConstructorId) -> CtfeResolvedConstructorId:
	into_opaque CtfeResolvedConstructorId(constructor_id)


pure func ctfe_resolved_constructor_ids_equal(
	left: CtfeResolvedConstructorId,
	right: CtfeResolvedConstructorId,
) -> Bool:
	constructor_id_definition_id(
		from_opaque CtfeResolvedConstructorId(
			left
		),
	) == constructor_id_definition_id(from_opaque CtfeResolvedConstructorId(right))


pure func ctfe_resolved_constructor_definition_id(id: CtfeResolvedConstructorId) -> Int:
	constructor_id_definition_id(from_opaque CtfeResolvedConstructorId(id))


pure func ctfe_resolved_constructor_source_id(id: CtfeResolvedConstructorId) -> ConstructorId:
	from_opaque CtfeResolvedConstructorId(id)


pure func ctfe_constructor_info(parent_type: String, arity: Int) -> CtfeConstructorInfo:
	{
		parent_type = parent_type,
		arity = arity,
		identity = SynthesizedCtfeConstructor
	}


pure func ctfe_resolved_constructor_info(
	parent_type: String,
	arity: Int,
	constructor_id: ConstructorId,
) -> CtfeConstructorInfo:
	{
		parent_type = parent_type,
		arity = arity,
		identity = ResolvedCtfeConstructor(ctfe_resolved_constructor_id(constructor_id))
	}


pure func ctfe_resolved_constructor_info_from_id(
	parent_type: String,
	arity: Int,
	id: CtfeResolvedConstructorId,
) -> CtfeConstructorInfo:
	{
		parent_type = parent_type,
		arity = arity,
		identity = ResolvedCtfeConstructor(id)
	}


pure func ctfe_constructor_info_definition_id(info: CtfeConstructorInfo) -> Option[Int]:
	match info.identity:
		ResolvedCtfeConstructor(id):
			Some(ctfe_resolved_constructor_definition_id(id))
		SynthesizedCtfeConstructor:
			None


pure func ctfe_constructor_info_source_id(info: CtfeConstructorInfo) -> Option[ConstructorId]:
	match info.identity:
		ResolvedCtfeConstructor(id):
			Some(ctfe_resolved_constructor_source_id(id))
		SynthesizedCtfeConstructor:
			None


pure func ctfe_value(typ: SemanticType, desc: CtfeValueDesc, span: SourceLocation) -> CtfeValue:
	{
		typ = typ,
		desc = desc,
		span = span
	}


pure func ctfe_int(span: SourceLocation, value: Int) -> CtfeValue:
	ctfe_value(TYPE_INT, CtfeIntValue(value), span)


---
Compile-time value of an integer literal of type `typ`. CTFE holds integers
as 64-bit Int bits. A UInt64 literal is folded to its exact two's-complement
bits and keeps its type, so formatting and unsigned operations read values
above Int's range correctly. Other literals keep the `parse_int` reading and
the Int type: Int128/UInt128 cannot be represented in 64 bits, and CTFE has no
narrow-width semantics yet, so tagging them would only imply support.
---
pure func ctfe_int_literal(typ: SemanticType, span: SourceLocation, text: String) -> CtfeValue:
	if ctfe_type_is_uint64(typ):
		ctfe_value(typ, CtfeIntValue(ctfe_int_literal_bits(text)), span)
	else:
		ctfe_int(span, ctfe_int_literal_value(typ, text))


---
Int bits a literal pattern or literal of type `typ` denotes; see
`ctfe_int_literal`.
---
pure func ctfe_int_literal_value(typ: SemanticType, text: String) -> Int:
	if ctfe_type_is_uint64(typ):
		ctfe_int_literal_bits(text)
	else:
		text
			.parse_int()
			.get_or(0)


---
Two's-complement bits of a decimal integer literal. Source literals are digit
runs (negation is a separate unary operator); materialized CTFE values may add
a leading '-'. The digit fold wraps like runtime Int arithmetic, so a UInt64
literal above Int's range keeps its exact bits instead of saturating the way
`parse_int` does. Text of any other shape keeps the old `parse_int` reading.
---
pure func ctfe_int_literal_bits(text: String) -> Int:
	negative: Bool = text.starts_with("-")
	digits: String = if negative:
		text.substring(1, text.length() - 1)
	else:
		text
	var magnitude: Int = 0
	var well_formed: Bool = digits.length() > 0

	for ch in digits:
		if ch >= '0' and ch <= '9':
			magnitude = magnitude * DECIMAL_RADIX + (to_int(ch) - to_int('0'))
		else:
			well_formed = False

	if not well_formed:
		text
			.parse_int()
			.get_or(0)
	else if negative:
		0 - magnitude
	else:
		magnitude


private DECIMAL_RADIX: Int = 10

-- 2^63 = UINT64_HALF_RANGE_TENS * 10 + UINT64_HALF_RANGE_ONES. Splitting the
-- offset keeps the unsigned decimal conversion inside Int's range.
private UINT64_HALF_RANGE_TENS: Int = 922337203685477580

private UINT64_HALF_RANGE_ONES: Int = 8

private INT_MIN_BITS: Int = -9223372036854775807 - 1


pure func ctfe_type_is_uint64(typ: SemanticType) -> Bool:
	match typ:
		SemanticNamedType(name, args):
			name == "UInt64" and args.length() == 0
		_:
			False


---
Decimal text of a compile-time integer, matching the runtime formatter for
its type. CTFE stores every integer as 64-bit two's-complement bits in an
Int; `UInt64` reads those bits as unsigned like `blorp_uint64_to_string`, so a
value above Int's range prints as 18446744073709551615 rather than -1.
---
pure func ctfe_int_value_text(typ: SemanticType, raw: Int) -> String:
	if raw >= 0 or not ctfe_type_is_uint64(typ):
		raw.to_string()
	else:
		-- raw's unsigned value is below_half + 2^63, with below_half in
		-- [0, 2^63). Divide each part by ten separately so no step overflows.
		below_half: Int = raw - INT_MIN_BITS
		ones_sum: Int = below_half % DECIMAL_RADIX + UINT64_HALF_RANGE_ONES
		tens: Int = UINT64_HALF_RANGE_TENS + below_half / DECIMAL_RADIX + ones_sum / DECIMAL_RADIX
		tens.to_string() + (ones_sum % DECIMAL_RADIX).to_string()


pure func ctfe_float(span: SourceLocation, value: Float) -> CtfeValue:
	ctfe_value(TYPE_FLOAT, CtfeFloatValue(value), span)


pure func ctfe_bool(span: SourceLocation, value: Bool) -> CtfeValue:
	ctfe_value(TYPE_BOOL, CtfeBoolValue(value), span)


pure func ctfe_char(span: SourceLocation, value: Char) -> CtfeValue:
	ctfe_value(TYPE_CHAR, CtfeCharValue(value), span)


pure func ctfe_string(span: SourceLocation, value: String) -> CtfeValue:
	ctfe_value(TYPE_STRING, CtfeStringValue(value), span)


pure func ctfe_function_reference(
	typ: SemanticType,
	span: SourceLocation,
	callable_id: CallableId,
	source_name: String,
	is_pure: Bool,
) -> CtfeValue:
	ctfe_value(typ, CtfeFunctionReferenceValue({
			callable_id = callable_id,
			source_name = source_name,
			is_pure = is_pure,
		}), span)


pure func ctfe_void(span: SourceLocation) -> CtfeValue:
	ctfe_value(TYPE_VOID, CtfeVoidValue, span)


pure func ctfe_value_kind(value: CtfeValue) -> String:
	match value.desc:
		CtfeIntValue(_):
			"Int"
		CtfeFloatValue(_):
			"Float"
		CtfeBoolValue(_):
			"Bool"
		CtfeCharValue(_):
			"Char"
		CtfeStringValue(_):
			"String"
		CtfeTupleValue(_):
			"Tuple"
		CtfeListValue(_):
			"List"
		CtfeVectorValue(_):
			"Vector"
		CtfeDictValue(_):
			"Dict"
		CtfeRecordValue(_):
			"Record"
		CtfeRangeValue(_, _):
			"Range"
		CtfeVoidValue:
			"Void"
		CtfeConstructorValue(_):
			"Constructor"
		CtfeFunctionReferenceValue(_):
			"Function reference"
		CtfeLambdaValue(_):
			"Lambda"


pure func ctfe_error_message(error: CtfeError) -> String:
	match error:
		CtfeExpectedValue(expected, actual):
			"compile-time constant evaluation expected ${expected}, found ${actual}"
		CtfeUnsupported(form):
			"compile-time constant evaluation does not support ${form} yet"
		CtfeInvalidOperator(op):
			"internal CTFE error: invalid operator ${op}"


private pure func ctfe_expected_error(expected: String, value: CtfeValue) -> CtfeError:
	CtfeExpectedValue(expected, type_to_string(value.typ))


pure func ctfe_expect_int(value: CtfeValue) -> Result[Int, CtfeError]:
	match value.desc:
		CtfeIntValue(raw):
			Ok(raw)
		_:
			Err(ctfe_expected_error("Int", value))


pure func ctfe_expect_float(value: CtfeValue) -> Result[Float, CtfeError]:
	match value.desc:
		CtfeFloatValue(raw):
			Ok(raw)
		_:
			Err(ctfe_expected_error("Float", value))


pure func ctfe_expect_bool(value: CtfeValue) -> Result[Bool, CtfeError]:
	match value.desc:
		CtfeBoolValue(raw):
			Ok(raw)
		_:
			Err(ctfe_expected_error("Bool", value))


pure func ctfe_expect_char(value: CtfeValue) -> Result[Char, CtfeError]:
	match value.desc:
		CtfeCharValue(raw):
			Ok(raw)
		_:
			Err(ctfe_expected_error("Char", value))


pure func ctfe_expect_string(value: CtfeValue) -> Result[String, CtfeError]:
	match value.desc:
		CtfeStringValue(raw):
			Ok(raw)
		_:
			Err(ctfe_expected_error("String", value))


pure func ctfe_values_equal(left: CtfeValue, right: CtfeValue) -> Bool:
	match left.desc:
		CtfeIntValue(left_value):
			match right.desc:
				CtfeIntValue(right_value):
					left_value == right_value
				_:
					False
		CtfeFloatValue(left_value):
			match right.desc:
				CtfeFloatValue(right_value):
					left_value == right_value
				_:
					False
		CtfeBoolValue(left_value):
			match right.desc:
				CtfeBoolValue(right_value):
					left_value == right_value
				_:
					False
		CtfeCharValue(left_value):
			match right.desc:
				CtfeCharValue(right_value):
					left_value == right_value
				_:
					False
		CtfeStringValue(left_value):
			match right.desc:
				CtfeStringValue(right_value):
					left_value == right_value
				_:
					False
		CtfeTupleValue(left_values):
			match right.desc:
				CtfeTupleValue(right_values):
					ctfe_value_lists_equal(left_values, right_values)
				_:
					False
		CtfeListValue(left_values):
			match right.desc:
				CtfeListValue(right_values):
					ctfe_value_lists_equal(left_values, right_values)
				_:
					False
		CtfeVectorValue(left_values):
			match right.desc:
				CtfeVectorValue(right_values):
					ctfe_value_lists_equal(left_values, right_values)
				_:
					False
		CtfeDictValue(left_pairs):
			match right.desc:
				CtfeDictValue(right_pairs):
					ctfe_dict_entries_equal(left_pairs, right_pairs)
				_:
					False
		CtfeRecordValue(left_fields):
			match right.desc:
				CtfeRecordValue(right_fields):
					ctfe_record_fields_equal(left_fields, right_fields)
				_:
					False
		CtfeRangeValue(left_start, left_end):
			match right.desc:
				CtfeRangeValue(right_start, right_end):
					(
						ctfe_values_equal(left_start, right_start)
						and ctfe_values_equal(left_end, right_end)
					)
				_:
					False
		CtfeVoidValue:
			match right.desc:
				CtfeVoidValue:
					True
				_:
					False
		CtfeConstructorValue(left_ctor):
			match right.desc:
				CtfeConstructorValue(right_ctor):
					(
						left_ctor.name == right_ctor.name
						and left_ctor.constructor_info.parent_type == right_ctor.constructor_info.parent_type
						and ctfe_value_lists_equal(left_ctor.args, right_ctor.args)
					)
				_:
					False
		CtfeFunctionReferenceValue(left_ref):
			match right.desc:
				CtfeFunctionReferenceValue(right_ref):
					(
						callable_ids_equal(left_ref.callable_id, right_ref.callable_id)
						and left_ref.source_name == right_ref.source_name
					)
				_:
					False
		CtfeLambdaValue(_):
			False


private pure func ctfe_value_lists_equal(left: List[CtfeValue], right: List[CtfeValue]) -> Bool:
	if not (left.length() == right.length()):
		False
	else:
		var equal: Bool = True
		var index: Int = 0

		for left_value in left:
			right_value: CtfeValue = right.get_or(index, left_value)

			if not ctfe_values_equal(left_value, right_value):
				equal = False
				break

			index += 1

		equal


private pure func ctfe_dict_entries_equal(
	left: List[(CtfeValue, CtfeValue)],
	right: List[(CtfeValue, CtfeValue)],
) -> Bool:
	if not (left.length() == right.length()):
		False
	else:
		var equal: Bool = True
		var index: Int = 0

		for (left_key, left_value) in left:
			right_pair: (CtfeValue, CtfeValue) = right.get_or(index, (left_key, left_value))
			(right_key, right_value) = right_pair

			if not ((
				ctfe_values_equal(left_key, right_key)
				and ctfe_values_equal(left_value, right_value)
			)):
				equal = False
				break

			index += 1

		equal


---
Whether two record-value fields are the same field. Compares the typecheck
field identities when both sides have one. A value built without a resolved
field identity (`MISSING_RESOLVED_FIELD_IDENTITY`: recovery or synthetic
selections) has nothing but its spelling to compare, so that case falls back
to the name.
---
pure func ctfe_record_field_matches(
	left_name: String,
	left_id: ResolvedFieldIdentity,
	right_name: String,
	right_id: ResolvedFieldIdentity,
) -> Bool:
	match (resolved_field_identity_field_id(left_id), resolved_field_identity_field_id(right_id)):
		(Some(left_field), Some(right_field)):
			field_ids_equal(left_field, right_field)
		_:
			left_name == right_name


private pure func ctfe_record_fields_equal(
	left: List[(String, CtfeValue, ResolvedFieldIdentity)],
	right: List[(String, CtfeValue, ResolvedFieldIdentity)],
) -> Bool:
	if not (left.length() == right.length()):
		False
	else:
		var equal: Bool = True
		var index: Int = 0

		for (left_name, left_value, left_id) in left:
			right_triple: (String, CtfeValue, ResolvedFieldIdentity) = right.get_or(
				index,
				(left_name, left_value, left_id),
			)
			(right_name, right_value, right_id) = right_triple

			if not (
				ctfe_record_field_matches(left_name, left_id, right_name, right_id)
				and ctfe_values_equal(left_value, right_value)
			):
				equal = False
				break

			index += 1

		equal


private pure func ctfe_compare_int(op: ParsedBinaryOp, left: Int, right: Int) -> Bool:
	match op:
		ParsedLessOp:
			left < right
		ParsedGreaterOp:
			left > right
		ParsedLessEqualOp:
			left <= right
		ParsedGreaterEqualOp:
			left >= right
		_:
			False


private pure func ctfe_compare_float(op: ParsedBinaryOp, left: Float, right: Float) -> Bool:
	match op:
		ParsedLessOp:
			left < right
		ParsedGreaterOp:
			left > right
		ParsedLessEqualOp:
			left <= right
		ParsedGreaterEqualOp:
			left >= right
		_:
			False


---
How CTFE reads an integer's 64-bit bits in division, modulo, and ordering.
Addition, subtraction, multiplication, and equality agree for both readings.
---
enum CtfeIntSignedness:
	CtfeSignedInt
	CtfeUnsignedInt64


private UINT64_QUARTER_RANGE: Int = 4611686018427387904


---
Order-preserving signed key for UInt64 bits: flipping the sign bit maps
unsigned order onto signed order.
---
private pure func ctfe_uint64_order_key(bits: Int) -> Int:
	bits - INT_MIN_BITS


---
Unsigned quotient of UInt64 bits, following the runtime's C `uint64_t`
division. `divisor` must be nonzero.
---
private pure func ctfe_uint64_divide(dividend: Int, divisor: Int) -> Int:
	if divisor < 0:
		-- A divisor of at least 2^63 goes into any UInt64 at most once.
		if ctfe_uint64_order_key(dividend) >= ctfe_uint64_order_key(divisor):
			1
		else:
			0
	else if dividend >= 0:
		dividend / divisor
	else:
		-- Halve the dividend unsigned (its value is below_half + 2^63), divide,
		-- then correct the doubled quotient by at most one.
		half: Int = (dividend - INT_MIN_BITS) / 2 + UINT64_QUARTER_RANGE
		quotient: Int = half / divisor * 2
		remainder: Int = dividend - quotient * divisor
		if ctfe_uint64_order_key(remainder) >= ctfe_uint64_order_key(divisor):
			quotient + 1
		else:
			quotient


private pure func ctfe_divide_int(signedness: CtfeIntSignedness, left: Int, right: Int) -> Int:
	if right == 0:
		0
	else:
		match signedness:
			CtfeSignedInt:
				left / right
			CtfeUnsignedInt64:
				ctfe_uint64_divide(left, right)


private pure func ctfe_modulo_int(signedness: CtfeIntSignedness, left: Int, right: Int) -> Int:
	if right == 0:
		0
	else:
		match signedness:
			CtfeSignedInt:
				left % right
			CtfeUnsignedInt64:
				left - ctfe_uint64_divide(left, right) * right


private pure func ctfe_int_order_key(signedness: CtfeIntSignedness, bits: Int) -> Int:
	match signedness:
		CtfeSignedInt:
			bits
		CtfeUnsignedInt64:
			ctfe_uint64_order_key(bits)


private pure func ctfe_eval_int_binary_values(
	op: ParsedBinaryOp,
	signedness: CtfeIntSignedness,
	left_value: Int,
	right_value: Int,
) -> Result[CtfeValueDesc, CtfeError]:
	left_key: Int = ctfe_int_order_key(signedness, left_value)
	right_key: Int = ctfe_int_order_key(signedness, right_value)

	match op:
		ParsedAddOp:
			Ok(CtfeIntValue(left_value + right_value))
		ParsedSubtractOp:
			Ok(CtfeIntValue(left_value - right_value))
		ParsedMultiplyOp:
			Ok(CtfeIntValue(left_value * right_value))
		ParsedDivideOp:
			Ok(CtfeIntValue(ctfe_divide_int(signedness, left_value, right_value)))
		ParsedModuloOp:
			Ok(CtfeIntValue(ctfe_modulo_int(signedness, left_value, right_value)))
		ParsedLessOp:
			Ok(CtfeBoolValue(ctfe_compare_int(op, left_key, right_key)))
		ParsedGreaterOp:
			Ok(CtfeBoolValue(ctfe_compare_int(op, left_key, right_key)))
		ParsedLessEqualOp:
			Ok(CtfeBoolValue(ctfe_compare_int(op, left_key, right_key)))
		ParsedGreaterEqualOp:
			Ok(CtfeBoolValue(ctfe_compare_int(op, left_key, right_key)))
		ParsedEqualOp:
			Ok(CtfeBoolValue(left_value == right_value))
		ParsedNotEqualOp:
			Ok(CtfeBoolValue(left_value != right_value))


private pure func ctfe_eval_int_binary_desc(
	op: ParsedBinaryOp,
	left: CtfeValue,
	right: CtfeValue,
) -> Result[CtfeValueDesc, CtfeError]:
	match ctfe_expect_int(left):
		Err(error):
			Err(error)
		Ok(left_value):
			match ctfe_expect_int(right):
				Ok(right_value):
					-- Typecheck gives both operands the same integer type; either
					-- tag suffices when one side came from an untyped path.
					signedness: CtfeIntSignedness = if (
						ctfe_type_is_uint64(left.typ)
						or ctfe_type_is_uint64(right.typ)
					):
						CtfeUnsignedInt64
					else:
						CtfeSignedInt
					ctfe_eval_int_binary_values(op, signedness, left_value, right_value)
				Err(error):
					Err(error)


private pure func ctfe_eval_float_binary_values(
	op: ParsedBinaryOp,
	left_value: Float,
	right_value: Float,
) -> Result[CtfeValueDesc, CtfeError]:
	match op:
		ParsedAddOp:
			Ok(CtfeFloatValue(left_value + right_value))
		ParsedSubtractOp:
			Ok(CtfeFloatValue(left_value - right_value))
		ParsedMultiplyOp:
			Ok(CtfeFloatValue(left_value * right_value))
		ParsedDivideOp:
			Ok(CtfeFloatValue(left_value / right_value))
		ParsedModuloOp:
			Err(CtfeUnsupported("Float modulo"))
		ParsedLessOp:
			Ok(CtfeBoolValue(ctfe_compare_float(op, left_value, right_value)))
		ParsedGreaterOp:
			Ok(CtfeBoolValue(ctfe_compare_float(op, left_value, right_value)))
		ParsedLessEqualOp:
			Ok(CtfeBoolValue(ctfe_compare_float(op, left_value, right_value)))
		ParsedGreaterEqualOp:
			Ok(CtfeBoolValue(ctfe_compare_float(op, left_value, right_value)))
		ParsedEqualOp:
			Ok(CtfeBoolValue(left_value == right_value))
		ParsedNotEqualOp:
			Ok(CtfeBoolValue(left_value != right_value))


private pure func ctfe_eval_float_binary_desc(
	op: ParsedBinaryOp,
	left: CtfeValue,
	right: CtfeValue,
) -> Result[CtfeValueDesc, CtfeError]:
	match ctfe_expect_float(left):
		Err(error):
			Err(error)
		Ok(left_value):
			match ctfe_expect_float(right):
				Ok(right_value):
					ctfe_eval_float_binary_values(op, left_value, right_value)
				Err(error):
					Err(error)


private pure func ctfe_eval_string_binary_desc(
	op: ParsedBinaryOp,
	left: CtfeValue,
	right: CtfeValue,
) -> Result[CtfeValueDesc, CtfeError]:
	match op:
		ParsedAddOp:
			match ctfe_expect_string(left):
				Err(error):
					Err(error)
				Ok(left_value):
					match ctfe_expect_string(right):
						Ok(right_value):
							Ok(CtfeStringValue(left_value + right_value))
						Err(error):
							Err(error)
		ParsedEqualOp:
			Ok(CtfeBoolValue(ctfe_values_equal(left, right)))
		ParsedNotEqualOp:
			Ok(CtfeBoolValue(not ctfe_values_equal(left, right)))
		_:
			Err(CtfeUnsupported("String binary operator"))


private pure func ctfe_binary_result_type(op: ParsedBinaryOp, left: CtfeValue) -> SemanticType:
	match op:
		ParsedEqualOp:
			TYPE_BOOL
		ParsedNotEqualOp:
			TYPE_BOOL
		ParsedLessOp:
			TYPE_BOOL
		ParsedLessEqualOp:
			TYPE_BOOL
		ParsedGreaterOp:
			TYPE_BOOL
		ParsedGreaterEqualOp:
			TYPE_BOOL
		_:
			left.typ


private pure func ctfe_round_float_desc(typ: SemanticType, desc: CtfeValueDesc) -> CtfeValueDesc:
	match desc:
		CtfeFloatValue(raw):
			match typ:
				SemanticNamedType(name, args):
					if args.length() != 0:
						desc
					else if name == "Float16":
						CtfeFloatValue(to_float(to_float16(raw)))
					else if name == "Float32":
						CtfeFloatValue(to_float(to_float32(raw)))
					else:
						desc
				_:
					desc
		_:
			desc


pure func ctfe_eval_binary(
	op: ParsedBinaryOp,
	left: CtfeValue,
	right: CtfeValue,
) -> Result[CtfeValue, CtfeError]:
	desc_result: Result[CtfeValueDesc, CtfeError] = match left.desc:
		CtfeStringValue(_):
			ctfe_eval_string_binary_desc(op, left, right)
		CtfeFloatValue(_):
			ctfe_eval_float_binary_desc(op, left, right)
		_:
			match op:
				ParsedEqualOp:
					Ok(CtfeBoolValue(ctfe_values_equal(left, right)))
				ParsedNotEqualOp:
					Ok(CtfeBoolValue(not ctfe_values_equal(left, right)))
				_:
					ctfe_eval_int_binary_desc(op, left, right)

	match desc_result:
		Ok(desc):
			result_type = ctfe_binary_result_type(op, left)
			Ok(ctfe_value(result_type, ctfe_round_float_desc(result_type, desc), left.span))
		Err(error):
			Err(error)


pure func ctfe_eval_unary(op: ParsedUnaryOp, value: CtfeValue) -> Result[CtfeValue, CtfeError]:
	match op:
		ParsedNegateOp:
			match value.desc:
				CtfeFloatValue(raw):
					Ok(
						ctfe_value(
							value.typ,
							ctfe_round_float_desc(value.typ, CtfeFloatValue(0.0 - raw)),
							value.span,
						),
					)
				_:
					raw ?= ctfe_expect_int(value)
					Ok(ctfe_int(value.span, 0 - raw))
		ParsedNotOp:
			raw ?= ctfe_expect_bool(value)
			Ok(ctfe_bool(value.span, not raw))
