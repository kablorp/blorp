-- Compiler-owned std operations admitted to compile-time evaluation.
--
-- Keep source-name admission centralized here so CTFE support does not spread
-- across evaluator branches as ad-hoc string checks.
import:
	../stage_02_lex/name_table:
		NAME_ID_LENGTH,
		NAME_ID_STD_ALL,
		NAME_ID_STD_AND_THEN,
		NAME_ID_STD_ANY,
		NAME_ID_STD_APPEND,
		NAME_ID_STD_CHARS,
		NAME_ID_STD_COLUMN_COUNT,
		NAME_ID_STD_CONCAT,
		NAME_ID_STD_CONTAINS,
		NAME_ID_STD_COUNT,
		NAME_ID_STD_DROP_LEFT,
		NAME_ID_STD_ENDS_WITH,
		NAME_ID_STD_FILTER,
		NAME_ID_STD_FILTER_MAP,
		NAME_ID_STD_FLAT_MAP,
		NAME_ID_STD_FOLD_LEFT,
		NAME_ID_STD_FOLD_RIGHT,
		NAME_ID_STD_FROM_CHAR,
		NAME_ID_STD_FROM_CHARS,
		NAME_ID_STD_FROM_LIST,
		NAME_ID_STD_FROM_OPTION,
		NAME_ID_STD_GET,
		NAME_ID_STD_GET_OR,
		NAME_ID_STD_GET_OR_ELSE,
		NAME_ID_STD_INDEX_OF,
		NAME_ID_STD_IS_EMPTY,
		NAME_ID_STD_IS_ERR,
		NAME_ID_STD_IS_NONE,
		NAME_ID_STD_IS_OK,
		NAME_ID_STD_IS_SOME,
		NAME_ID_STD_JOIN,
		NAME_ID_STD_LIST,
		NAME_ID_STD_LOWER,
		NAME_ID_STD_MAP,
		NAME_ID_STD_MAP_ERR,
		NAME_ID_STD_MAP_INDEXED,
		NAME_ID_STD_MATRIX,
		NAME_ID_STD_RAW_INDEX_OF,
		NAME_ID_STD_REPEAT,
		NAME_ID_STD_REPLACE,
		NAME_ID_STD_REVERSE,
		NAME_ID_STD_ROW_COUNT,
		NAME_ID_STD_SET,
		NAME_ID_STD_SPLIT,
		NAME_ID_STD_STARTS_WITH,
		NAME_ID_STD_SUBSTRING,
		NAME_ID_STD_TAKE_LEFT,
		NAME_ID_STD_TENSOR3,
		NAME_ID_STD_TENSOR4,
		NAME_ID_STD_TENSOR5,
		NAME_ID_STD_TO_FLOAT16,
		NAME_ID_STD_TO_FLOAT32,
		NAME_ID_STD_TO_OPTION,
		NAME_ID_STD_TO_RESULT,
		NAME_ID_STD_TRIM,
		NAME_ID_STD_TRIM_LEFT,
		NAME_ID_STD_TRIM_RIGHT,
		NAME_ID_STD_UPPER,
		NAME_ID_STD_VECTOR,
		NAME_ID_TO_STRING_METHOD,
		NameId


STD_LIST_MODULE_PATH: String = "list"

STD_MATRIX_MODULE_PATH: String = "matrix"

STD_DICT_MODULE_PATH: String = "dict"

STD_OPTION_MODULE_PATH: String = "option"

STD_RESULT_MODULE_PATH: String = "result"

STD_STRING_MODULE_PATH: String = "string"

STD_FLOAT_MODULE_PATH: String = "float"


union CtfeBuiltinIntrinsic:
	CtfeFromCharIntrinsic
	CtfeFromCharsIntrinsic
	CtfeLengthIntrinsic
	CtfeTensorFillIntrinsic(Int)
	CtfeToFloat16Intrinsic
	CtfeToFloat32Intrinsic
	CtfeToStringIntrinsic


---
The builtin (and `std.float`) CTFE intrinsics by the pinned `NAME_ID_*` of the callee's source name.
Built once (a global initializer) and read-only.
---
private BUILTIN_INTRINSIC_BY_SOURCE_NAME: Dict[NameId, CtfeBuiltinIntrinsic] = {
	NAME_ID_STD_FROM_CHAR => CtfeFromCharIntrinsic,
	NAME_ID_STD_FROM_CHARS => CtfeFromCharsIntrinsic,
	NAME_ID_LENGTH => CtfeLengthIntrinsic,
	NAME_ID_STD_VECTOR => CtfeTensorFillIntrinsic(1),
	NAME_ID_STD_MATRIX => CtfeTensorFillIntrinsic(2),
	NAME_ID_STD_TENSOR3 => CtfeTensorFillIntrinsic(3),
	NAME_ID_STD_TENSOR4 => CtfeTensorFillIntrinsic(4),
	NAME_ID_STD_TENSOR5 => CtfeTensorFillIntrinsic(5),
	NAME_ID_STD_TO_FLOAT16 => CtfeToFloat16Intrinsic,
	NAME_ID_STD_TO_FLOAT32 => CtfeToFloat32Intrinsic,
	NAME_ID_TO_STRING_METHOD => CtfeToStringIntrinsic,
}


pure func ctfe_builtin_intrinsic(source_name: NameId) -> Option[CtfeBuiltinIntrinsic]:
	BUILTIN_INTRINSIC_BY_SOURCE_NAME.get(source_name)


enum CtfeListIntrinsic:
	CtfeListAll
	CtfeListAppend
	CtfeListAny
	CtfeListConcat
	CtfeListContains
	CtfeListFilter
	CtfeListFilterMap
	CtfeListFlatMap
	CtfeListFoldLeft
	CtfeListFoldRight
	CtfeListGet
	CtfeListGetOr
	CtfeListJoin
	CtfeListLength
	CtfeListMake
	CtfeListMap
	CtfeListMapIndexed
	CtfeListSet


enum CtfeMatrixIntrinsic:
	CtfeMatrixColumnCount
	CtfeMatrixRowCount


enum CtfeDictIntrinsic:
	CtfeDictContains
	CtfeDictFromList
	CtfeDictGet
	CtfeDictGetOr
	CtfeDictIsEmpty
	CtfeDictLength
	CtfeDictSet


enum CtfeOptionIntrinsic:
	CtfeOptionAndThen
	CtfeOptionFilter
	CtfeOptionGetOr
	CtfeOptionGetOrElse
	CtfeOptionIsNone
	CtfeOptionIsSome
	CtfeOptionMap
	CtfeOptionToResult


enum CtfeResultIntrinsic:
	CtfeResultAndThen
	CtfeResultFromOption
	CtfeResultGetOr
	CtfeResultGetOrElse
	CtfeResultIsErr
	CtfeResultIsOk
	CtfeResultMap
	CtfeResultMapErr
	CtfeResultToOption


enum CtfeStringIntrinsic:
	CtfeStringChars
	CtfeStringCount
	CtfeStringContains
	CtfeStringDropLeft
	CtfeStringEndsWith
	CtfeStringFromChar
	CtfeStringFromChars
	CtfeStringGet
	CtfeStringGetOr
	CtfeStringIndexOf
	CtfeStringLength
	CtfeStringLower
	CtfeStringRawIndexOf
	CtfeStringRepeat
	CtfeStringReplace
	CtfeStringReverse
	CtfeStringSplit
	CtfeStringStartsWith
	CtfeStringSubstring
	CtfeStringTakeLeft
	CtfeStringTrim
	CtfeStringTrimLeft
	CtfeStringTrimRight
	CtfeStringUpper


union CtfeImportedIntrinsic:
	CtfeImportedBuiltinIntrinsic(CtfeBuiltinIntrinsic)
	CtfeImportedDictIntrinsic(CtfeDictIntrinsic)
	CtfeImportedListIntrinsic(CtfeListIntrinsic)
	CtfeImportedMatrixIntrinsic(CtfeMatrixIntrinsic)
	CtfeImportedOptionIntrinsic(CtfeOptionIntrinsic)
	CtfeImportedResultIntrinsic(CtfeResultIntrinsic)
	CtfeImportedStringIntrinsic(CtfeStringIntrinsic)


---
The `std.list` CTFE intrinsics by the pinned `NAME_ID_*` of the callee's source name.
