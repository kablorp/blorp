---
private LIST_INTRINSIC_BY_SOURCE_NAME: Dict[NameId, CtfeListIntrinsic] = {
	NAME_ID_STD_ALL => CtfeListAll,
	NAME_ID_STD_APPEND => CtfeListAppend,
	NAME_ID_STD_ANY => CtfeListAny,
	NAME_ID_STD_CONCAT => CtfeListConcat,
	NAME_ID_STD_CONTAINS => CtfeListContains,
	NAME_ID_STD_FILTER => CtfeListFilter,
	NAME_ID_STD_FILTER_MAP => CtfeListFilterMap,
	NAME_ID_STD_FLAT_MAP => CtfeListFlatMap,
	NAME_ID_STD_FOLD_LEFT => CtfeListFoldLeft,
	NAME_ID_STD_FOLD_RIGHT => CtfeListFoldRight,
	NAME_ID_STD_GET => CtfeListGet,
	NAME_ID_STD_GET_OR => CtfeListGetOr,
	NAME_ID_STD_JOIN => CtfeListJoin,
	NAME_ID_LENGTH => CtfeListLength,
	NAME_ID_STD_LIST => CtfeListMake,
	NAME_ID_STD_MAP => CtfeListMap,
	NAME_ID_STD_MAP_INDEXED => CtfeListMapIndexed,
	NAME_ID_STD_SET => CtfeListSet,
}


