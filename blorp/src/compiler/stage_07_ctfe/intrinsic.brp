pure func ctfe_imported_intrinsic(
	module_path: String,
	source_name_id: Option[NameId],
) -> Option[CtfeImportedIntrinsic]:
	match source_name_id:
		Some(source_name):
			ctfe_imported_intrinsic_by_name(module_path, source_name)
		None:
			None


private pure func ctfe_imported_intrinsic_by_name(
	module_path: String,
	source_name: NameId,
) -> Option[CtfeImportedIntrinsic]:
	if module_path == STD_FLOAT_MODULE_PATH:
		match ctfe_builtin_intrinsic(source_name):
			Some(op):
				Some(CtfeImportedBuiltinIntrinsic(op))
			None:
				None
	else if module_path == STD_DICT_MODULE_PATH:
		match ctfe_dict_intrinsic(source_name):
			Some(op):
				Some(CtfeImportedDictIntrinsic(op))
			None:
				None
	else if module_path == STD_LIST_MODULE_PATH:
		match ctfe_list_intrinsic(source_name):
			Some(op):
				Some(CtfeImportedListIntrinsic(op))
			None:
				None
	else if module_path == STD_MATRIX_MODULE_PATH:
		match ctfe_matrix_intrinsic(source_name):
			Some(op):
				Some(CtfeImportedMatrixIntrinsic(op))
			None:
				None
	else if module_path == STD_OPTION_MODULE_PATH:
		match ctfe_option_intrinsic(source_name):
			Some(op):
				Some(CtfeImportedOptionIntrinsic(op))
			None:
				None
	else if module_path == STD_RESULT_MODULE_PATH:
		match ctfe_result_intrinsic(source_name):
			Some(op):
				Some(CtfeImportedResultIntrinsic(op))
			None:
				None
	else if module_path == STD_STRING_MODULE_PATH:
		match ctfe_string_intrinsic(source_name):
			Some(op):
				Some(CtfeImportedStringIntrinsic(op))
			None:
				None
	else:
		None
