private DICT_INTRINSIC_BY_SOURCE_NAME: Dict[NameId, CtfeDictIntrinsic] = {
	NAME_ID_STD_CONTAINS => CtfeDictContains,
	NAME_ID_STD_FROM_LIST => CtfeDictFromList,
	NAME_ID_STD_GET => CtfeDictGet,
	NAME_ID_STD_GET_OR => CtfeDictGetOr,
	NAME_ID_STD_IS_EMPTY => CtfeDictIsEmpty,
