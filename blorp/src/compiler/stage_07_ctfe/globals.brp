-- Global binding availability for compile-time evaluation.
--
-- Immutable top-level initializers are evaluated in source order into the
-- CTFE global environment. Mutable top-level `var` bindings run at runtime.
import:
	../stage_06_typecheck/decl:
		TypedDecl(TypedGlobalVarDecl, TypedPrivateDecl),
		TypedGlobalVarInfo,
		TypedProgram,
	../stage_06_typecheck/modules/import_binding:
		ImportBinding(QualifiedModuleBinding, SelectiveDefinitionBinding),
	context:
		CtfeContext,
		CtfeImportedProgram,
		ctfe_context_from_program,
		ctfe_context_module_global_value,
		ctfe_context_module_has_global_binding,
		ctfe_context_with_module_global_env,
		ctfe_imported_program_decls,
		ctfe_imported_program_import_bindings,
		ctfe_imported_program_module_path,
	env: CTFE_ENV_EMPTY, ctfe_bind_global_value, ctfe_bind_unavailable_global
	eval: CtfeEvalError(CtfeEvalInModule, CtfeEvalInvalid), ctfe_eval_typed_expr
	materialize:
		ctfe_materialize_error_message,
		ctfe_materialize_global_var_info,
		ctfe_validate_materializable_value,
	value:
		CtfeEnv,
		CtfeUnavailableGlobalReason(
			CtfeCurrentGlobal,
			CtfeImportedRuntimeInitializedGlobal,
			CtfeLaterGlobal,
			CtfeRuntimeInitializedGlobal,
		),


record CtfeGlobalDecl {
	name: String,
	info: TypedGlobalVarInfo,
	is_private: Bool
}


private record CtfeRewriteDeclResult {
	env: CtfeEnv,
	decl: TypedDecl
}


pure func ctfe_global_initializer_runs_at_runtime(info: TypedGlobalVarInfo) -> Bool:
	info.decl.is_mutable


pure func ctfe_unavailable_reason_for_global(
	info: TypedGlobalVarInfo,
) -> CtfeUnavailableGlobalReason:
	if ctfe_global_initializer_runs_at_runtime(info):
		CtfeRuntimeInitializedGlobal
	else:
		CtfeLaterGlobal


private pure func ctfe_global_decl_from_typed_decl_inner(
	decl: TypedDecl,
	is_private: Bool,
) -> Option[CtfeGlobalDecl]:
	match decl:
		TypedGlobalVarDecl(info):
			Some({
				name = info.decl.name.text,
				info = info,
				is_private = is_private,
			})
		TypedPrivateDecl(inner):
			ctfe_global_decl_from_typed_decl_inner(inner, True)
		_:
			None


pure func ctfe_global_decl_from_typed_decl(decl: TypedDecl) -> Option[CtfeGlobalDecl]:
	ctfe_global_decl_from_typed_decl_inner(decl, False)


pure func ctfe_typed_decl_declares_global(decl: TypedDecl, name: String) -> Bool:
	match ctfe_global_decl_from_typed_decl(decl):
		Some(global_decl):
			global_decl.name == name
		None:
			False


pure func ctfe_program_declares_global(program: TypedProgram, name: String) -> Bool:
	program.decls.any(func(decl): ctfe_typed_decl_declares_global(decl, name))


private pure func ctfe_decls_declare_global(decls: List[TypedDecl], name: String) -> Bool:
	decls.any(func(decl): ctfe_typed_decl_declares_global(decl, name))


pure func ctfe_bind_unavailable_decl_globals(env: CtfeEnv, decl: TypedDecl) -> CtfeEnv:
	match ctfe_global_decl_from_typed_decl(decl):
		Some(global_decl):
			ctfe_bind_unavailable_global(
				env,
				global_decl.name,
				ctfe_unavailable_reason_for_global(global_decl.info),
			)
		None:
			env


pure func ctfe_bind_unavailable_program_globals(env: CtfeEnv, program: TypedProgram) -> CtfeEnv:
	var result = env

	for decl in program.decls:
		result = ctfe_bind_unavailable_decl_globals(result, decl)

	result


pure func ctfe_imported_program_declares_global(
	imported_programs: List[CtfeImportedProgram],
	module_path: String,
	name: String,
) -> Bool:
	imported_programs.any(
		func(
			imported,
		): (
			ctfe_imported_program_module_path(imported) == module_path
			and ctfe_decls_declare_global(ctfe_imported_program_decls(imported), name)
		),
	)


pure func ctfe_eval_global_decl(
	context: CtfeContext,
	env: CtfeEnv,
	global_decl: CtfeGlobalDecl,
) -> Result[CtfeEnv, CtfeEvalError]:
	if ctfe_global_initializer_runs_at_runtime(global_decl.info):
		Ok(env)
	else:
		eval_env = ctfe_bind_unavailable_global(env, global_decl.name, CtfeCurrentGlobal)

		eval_context: CtfeContext = match context.active_module_path:
			Some(module_path):
				-- Imported pure functions resolve globals through their module context.
				-- Install the initializer environment here so it includes both prior
				-- values and the current-binding marker used for cycle diagnostics.
				ctfe_context_with_module_global_env(context, module_path, eval_env)
			None:
				context

		value ?= ctfe_eval_typed_expr(eval_context, eval_env, global_decl.info.value)

		match ctfe_validate_materializable_value(value):
			Ok(_):
				Ok(ctfe_bind_global_value(env, global_decl.name, value))
			Err(error):
				Err(CtfeEvalInvalid(ctfe_materialize_error_message(error)))


private pure func ctfe_rewrite_global_var_decl(
	context: CtfeContext,
	env: CtfeEnv,
	info: TypedGlobalVarInfo,
) -> Result[CtfeRewriteDeclResult, CtfeEvalError]:
	if ctfe_global_initializer_runs_at_runtime(info):
		Ok({
			env = env,
			decl = TypedGlobalVarDecl(info),
		})
	else:
		eval_env = ctfe_bind_unavailable_global(env, info.decl.name.text, CtfeCurrentGlobal)
		value ?= ctfe_eval_typed_expr(context, eval_env, info.value)

		match ctfe_materialize_global_var_info(info, value):
			Ok(materialized):
				Ok({
					env = ctfe_bind_global_value(env, info.decl.name.text, value),
					decl = TypedGlobalVarDecl(materialized),
				})
			Err(error):
				Err(CtfeEvalInvalid(ctfe_materialize_error_message(error)))


private pure func ctfe_rewrite_decl_globals(
	context: CtfeContext,
	env: CtfeEnv,
	decl: TypedDecl,
) -> Result[CtfeRewriteDeclResult, CtfeEvalError]:
	match decl:
		TypedGlobalVarDecl(info):
			ctfe_rewrite_global_var_decl(context, env, info)
		TypedPrivateDecl(inner):
			result ?= ctfe_rewrite_decl_globals(context, env, inner)
			Ok({
				env = result.env,
				decl = TypedPrivateDecl(result.decl),
			})
		_:
			Ok({
				env = env,
				decl = decl,
			})


pure func ctfe_eval_decl_global_env(
	context: CtfeContext,
	env: CtfeEnv,
	decl: TypedDecl,
) -> Result[CtfeEnv, CtfeEvalError]:
	match ctfe_global_decl_from_typed_decl(decl):
		Some(global_decl):
			ctfe_eval_global_decl(context, env, global_decl)
		None:
			Ok(env)


pure func ctfe_eval_program_global_env(
	context: CtfeContext,
	base_env: CtfeEnv,
	program: TypedProgram,
) -> Result[CtfeEnv, CtfeEvalError]:
	var env = ctfe_bind_unavailable_program_globals(base_env, program)
	var failure: Option[CtfeEvalError] = None

	for decl in program.decls:
		match ctfe_eval_decl_global_env(context, env, decl):
			Ok(next_env):
				env = next_env
			Err(error):
				failure = Some(error)
				break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(env)


private pure func ctfe_eval_decls_global_env(
	context: CtfeContext,
	base_env: CtfeEnv,
	decls: List[TypedDecl],
) -> Result[CtfeEnv, CtfeEvalError]:
	var env = base_env

	for decl in decls:
		env = ctfe_bind_unavailable_decl_globals(env, decl)

	var failure: Option[CtfeEvalError] = None

	for decl in decls:
		match ctfe_eval_decl_global_env(context, env, decl):
			Ok(next_env):
				env = next_env
			Err(error):
				failure = Some(error)
				break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(env)


pure func ctfe_eval_imported_program_global_envs(
	context: CtfeContext,
	imported_programs: List[CtfeImportedProgram],
) -> Result[CtfeContext, CtfeEvalError]:
	var result_context = context
	var failure: Option[CtfeEvalError] = None

	for imported in imported_programs:
		module_path = ctfe_imported_program_module_path(imported)
		imported_context = { result_context | active_module_path = Some(module_path) }

		match ctfe_eval_decls_global_env(
			imported_context,
			ctfe_imported_global_env(
				imported_context,
				ctfe_imported_program_import_bindings(imported),
			),
			ctfe_imported_program_decls(imported),
		):
			Ok(env):
				result_context = ctfe_context_with_module_global_env(
					result_context,
					module_path,
					env,
				)
			Err(error):
				failure = Some(CtfeEvalInModule(module_path, error))
				break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(result_context)


pure func ctfe_bind_imported_global(
	context: CtfeContext,
	env: CtfeEnv,
	binding: ImportBinding,
) -> CtfeEnv:
	match binding:
		QualifiedModuleBinding(_, _):
			env
		SelectiveDefinitionBinding(local_name, module_path, source_name):
			match ctfe_context_module_global_value(context, module_path, source_name):
				Some(value):
					ctfe_bind_global_value(env, local_name, value)
				None:
					if ctfe_context_module_has_global_binding(context, module_path, source_name):
						ctfe_bind_unavailable_global(
							env,
							local_name,
							CtfeImportedRuntimeInitializedGlobal(module_path, source_name),
						)
					else:
						env


pure func ctfe_imported_global_env(
	context: CtfeContext,
	import_bindings: List[ImportBinding],
) -> CtfeEnv:
	var env: CtfeEnv = CTFE_ENV_EMPTY

	for binding in import_bindings:
		env = ctfe_bind_imported_global(context, env, binding)

	env


pure func ctfe_rewrite_program_globals(
	context: CtfeContext,
	base_env: CtfeEnv,
	program: TypedProgram,
) -> Result[TypedProgram, CtfeEvalError]:
	var env = ctfe_bind_unavailable_program_globals(base_env, program)
	var decls: List[TypedDecl] = []
	var failure: Option[CtfeEvalError] = None

	for decl in program.decls:
		match ctfe_rewrite_decl_globals(context, env, decl):
			Ok(result):
				env = result.env
				decls = decls.append(result.decl)
			Err(error):
				failure = Some(error)
				break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok({ program | decls = decls })


pure func ctfe_rewrite_program_globals_with_import_bindings(
	context: CtfeContext,
	import_bindings: List[ImportBinding],
	program: TypedProgram,
) -> Result[TypedProgram, CtfeEvalError]:
	ctfe_rewrite_program_globals(
		context,
		ctfe_imported_global_env(context, import_bindings),
		program,
	)


pure func ctfe_evaluate_program_globals(
	program: TypedProgram,
	imported_programs: List[CtfeImportedProgram],
	import_bindings: List[ImportBinding],
) -> Result[TypedProgram, CtfeEvalError]:
	context ?= ctfe_eval_imported_program_global_envs(
		ctfe_context_from_program(program, imported_programs),
		imported_programs,
	)

	ctfe_rewrite_program_globals_with_import_bindings(context, import_bindings, program)
