-- Global binding availability for compile-time evaluation.
--
-- Immutable top-level initializers are evaluated in source order into the
-- CTFE global environment. Mutable top-level `var` bindings run at runtime.
import:
	../stage_04_modules/module_table:
		ModuleId,
		ModuleTable,
		module_id_table_index,
		module_ids_equal,
		module_table_count,
	../stage_06_typecheck/decl:
		TypedDecl(TypedGlobalVarDecl, TypedPrivateDecl),
		TypedGlobalVarInfo,
		TypedProgram,
	../stage_06_typecheck/graph/definition_index:
		DefinitionTable,
		definition_table_module_table,
		definition_tables_share_provenance,
	context:
		CtfeContext,
		CtfeImportBinding(CtfeQualifiedModuleBinding, CtfeSelectiveDefinitionBinding),
		CtfeImportedProgram,
		CtfeImportedProgramSet,
		ctfe_context_from_imported_programs,
		ctfe_context_from_program,
		ctfe_context_module_global_value,
		ctfe_context_module_has_global_binding,
		ctfe_context_module_path,
		ctfe_context_with_module_global_env,
		ctfe_imported_program_decls,
		ctfe_imported_program_import_bindings,
		ctfe_imported_program_module_id,
		ctfe_imported_program_set,
		ctfe_imported_program_set_programs,
	env: CTFE_ENV_EMPTY, ctfe_bind_global_value, ctfe_bind_unavailable_global
	eval: CtfeEvalError(CtfeEvalInModule, CtfeEvalInvalid), ctfe_eval_typed_expr
	materialize:
		ctfe_materialize_error_message,
		ctfe_materialize_global_var_info,
		ctfe_validate_materializable_value,
	value:
		CtfeEnv,
		CtfeUnavailableGlobalReason(
			CtfeCurrentGlobal,
			CtfeImportedRuntimeInitializedGlobal,
			CtfeLaterGlobal,
			CtfeRuntimeInitializedGlobal,
		),


record CtfeGlobalDecl {
	name: String,
	info: TypedGlobalVarInfo,
	is_private: Bool
}


private union CtfeModuleGlobalEvaluation:
	CtfeModuleGlobalsUnrequested
	CtfeModuleGlobalsEvaluating
	CtfeModuleGlobalsEvaluated(CtfeEnv)
	CtfeModuleGlobalsRejected(CtfeEvalError)


record CtfeEvaluatedGlobalGraphMetrics {
	planned_unique_modules: Int,
	module_global_evaluation_starts: Int,
	duplicate_module_global_evaluations: Int,
	import_binding_applications: Int,
	global_declaration_evaluations: Int,
	rejected_module_evaluations: Int
}


private record CtfeEvaluatedGlobalGraphRep {
	definition_table: DefinitionTable,
	modules: List[CtfeModuleGlobalEvaluation],
	metrics: CtfeEvaluatedGlobalGraphMetrics
}


private record CtfeGlobalGraphEvaluationState {
	context: CtfeContext,
	modules: List[CtfeModuleGlobalEvaluation],
	metrics: CtfeEvaluatedGlobalGraphMetrics
}


opaque type CtfeEvaluatedGlobalGraph = CtfeEvaluatedGlobalGraphRep


private record CtfeRewriteDeclResult {
	env: CtfeEnv,
	decl: TypedDecl
}


private record CtfeGlobalEnvEvaluationRun {
	result: Result[CtfeEnv, CtfeEvalError],
	global_declaration_evaluations: Int
}


pure func ctfe_global_initializer_runs_at_runtime(info: TypedGlobalVarInfo) -> Bool:
	info.decl.is_mutable


pure func ctfe_unavailable_reason_for_global(
	info: TypedGlobalVarInfo,
) -> CtfeUnavailableGlobalReason:
	if ctfe_global_initializer_runs_at_runtime(info):
		CtfeRuntimeInitializedGlobal
	else:
		CtfeLaterGlobal


private pure func ctfe_global_decl_from_typed_decl_inner(
	decl: TypedDecl,
	is_private: Bool,
) -> Option[CtfeGlobalDecl]:
	match decl:
		TypedGlobalVarDecl(info):
			Some({
				name = info.decl.name.text,
				info = info,
				is_private = is_private,
			})
		TypedPrivateDecl(inner):
			ctfe_global_decl_from_typed_decl_inner(inner, True)
		_:
			None


pure func ctfe_global_decl_from_typed_decl(decl: TypedDecl) -> Option[CtfeGlobalDecl]:
	ctfe_global_decl_from_typed_decl_inner(decl, False)


pure func ctfe_typed_decl_declares_global(decl: TypedDecl, name: String) -> Bool:
	match ctfe_global_decl_from_typed_decl(decl):
		Some(global_decl):
			global_decl.name == name
		None:
			False


pure func ctfe_program_declares_global(program: TypedProgram, name: String) -> Bool:
	program.decls.any(func(decl): ctfe_typed_decl_declares_global(decl, name))


private pure func ctfe_decls_declare_global(decls: List[TypedDecl], name: String) -> Bool:
	decls.any(func(decl): ctfe_typed_decl_declares_global(decl, name))


pure func ctfe_bind_unavailable_decl_globals(env: CtfeEnv, decl: TypedDecl) -> CtfeEnv:
	match ctfe_global_decl_from_typed_decl(decl):
		Some(global_decl):
			ctfe_bind_unavailable_global(
				env,
				global_decl.name,
				ctfe_unavailable_reason_for_global(global_decl.info),
			)
		None:
			env


pure func ctfe_bind_unavailable_program_globals(env: CtfeEnv, program: TypedProgram) -> CtfeEnv:
	var result = env

	for decl in program.decls:
		result = ctfe_bind_unavailable_decl_globals(result, decl)

	result


pure func ctfe_imported_program_declares_global(
	imported_programs: List[CtfeImportedProgram],
	module_id: ModuleId,
	name: String,
) -> Bool:
	imported_programs.any(
		func(
			imported,
		): (
			module_ids_equal(ctfe_imported_program_module_id(imported), module_id)
			and ctfe_decls_declare_global(ctfe_imported_program_decls(imported), name)
		),
	)


pure func ctfe_eval_global_decl(
	context: CtfeContext,
	env: CtfeEnv,
	global_decl: CtfeGlobalDecl,
) -> Result[CtfeEnv, CtfeEvalError]:
	if ctfe_global_initializer_runs_at_runtime(global_decl.info):
		Ok(env)
	else:
		eval_env = ctfe_bind_unavailable_global(env, global_decl.name, CtfeCurrentGlobal)

		-- Imported pure functions resolve globals through their module context.
		-- Install the initializer environment here so it includes both prior
		-- values and the current-binding marker used for cycle diagnostics.
		eval_context = ctfe_context_with_module_global_env(
			context,
			context.module_table,
			context.active_module_id,
			eval_env,
		)

		value ?= ctfe_eval_typed_expr(eval_context, eval_env, global_decl.info.value)

		match ctfe_validate_materializable_value(value):
			Ok(_):
				Ok(ctfe_bind_global_value(env, global_decl.name, value))
			Err(error):
				Err(CtfeEvalInvalid(ctfe_materialize_error_message(error)))


private pure func ctfe_rewrite_global_var_decl(
	context: CtfeContext,
	env: CtfeEnv,
	info: TypedGlobalVarInfo,
) -> Result[CtfeRewriteDeclResult, CtfeEvalError]:
	if ctfe_global_initializer_runs_at_runtime(info):
		Ok({
			env = env,
			decl = TypedGlobalVarDecl(info),
		})
	else:
		eval_env = ctfe_bind_unavailable_global(env, info.decl.name.text, CtfeCurrentGlobal)
		value ?= ctfe_eval_typed_expr(context, eval_env, info.value)

		match ctfe_materialize_global_var_info(info, value):
			Ok(materialized):
				Ok({
					env = ctfe_bind_global_value(env, info.decl.name.text, value),
					decl = TypedGlobalVarDecl(materialized),
				})
			Err(error):
				Err(CtfeEvalInvalid(ctfe_materialize_error_message(error)))


private pure func ctfe_rewrite_decl_globals(
	context: CtfeContext,
	env: CtfeEnv,
	decl: TypedDecl,
) -> Result[CtfeRewriteDeclResult, CtfeEvalError]:
	match decl:
		TypedGlobalVarDecl(info):
			ctfe_rewrite_global_var_decl(context, env, info)
		TypedPrivateDecl(inner):
			result ?= ctfe_rewrite_decl_globals(context, env, inner)
			Ok({
				env = result.env,
				decl = TypedPrivateDecl(result.decl),
			})
		_:
			Ok({
				env = env,
				decl = decl,
			})


pure func ctfe_eval_decl_global_env(
	context: CtfeContext,
	env: CtfeEnv,
	decl: TypedDecl,
) -> Result[CtfeEnv, CtfeEvalError]:
	match ctfe_global_decl_from_typed_decl(decl):
		Some(global_decl):
			ctfe_eval_global_decl(context, env, global_decl)
		None:
			Ok(env)


pure func ctfe_eval_program_global_env(
	context: CtfeContext,
	base_env: CtfeEnv,
	program: TypedProgram,
) -> Result[CtfeEnv, CtfeEvalError]:
	var env = ctfe_bind_unavailable_program_globals(base_env, program)
	var failure: Option[CtfeEvalError] = None

	for decl in program.decls:
		match ctfe_eval_decl_global_env(context, env, decl):
			Ok(next_env):
				env = next_env
			Err(error):
				failure = Some(error)
				break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(env)


private pure func ctfe_eval_decls_global_env(
	context: CtfeContext,
	base_env: CtfeEnv,
	decls: List[TypedDecl],
) -> Result[CtfeEnv, CtfeEvalError]:
	ctfe_eval_decls_global_env_with_metrics(context, base_env, decls).result


private pure func ctfe_eval_decls_global_env_with_metrics(
	context: CtfeContext,
	base_env: CtfeEnv,
	decls: List[TypedDecl],
) -> CtfeGlobalEnvEvaluationRun:
	var env = base_env

	for decl in decls:
		env = ctfe_bind_unavailable_decl_globals(env, decl)

	var failure: Option[CtfeEvalError] = None
	var global_declaration_evaluations: Int = 0

	for decl in decls:
		match ctfe_global_decl_from_typed_decl(decl):
			Some(_):
				global_declaration_evaluations += 1

				match ctfe_eval_decl_global_env(context, env, decl):
					Ok(next_env):
						env = next_env
					Err(error):
						failure = Some(error)
						break
			None:
				void

	result = match failure:
		Some(error):
			Err(error)
		None:
			Ok(env)

	{
		result = result,
		global_declaration_evaluations = global_declaration_evaluations
	}


private pure func ctfe_empty_module_global_evaluations(
	module_table: ModuleTable,
) -> List[CtfeModuleGlobalEvaluation]:
	var modules: List[CtfeModuleGlobalEvaluation] = []

	for _ in 0..module_table_count(module_table):
		modules = modules.append(CtfeModuleGlobalsUnrequested)

	modules


pure func ctfe_evaluated_global_graph_metrics(
	graph: CtfeEvaluatedGlobalGraph,
) -> CtfeEvaluatedGlobalGraphMetrics:
	from_opaque CtfeEvaluatedGlobalGraph(graph).metrics


private pure func ctfe_rejected_global_graph_state(
	state: CtfeGlobalGraphEvaluationState,
	module_index: Int,
	error: CtfeEvalError,
) -> CtfeGlobalGraphEvaluationState:
	{ state |
		modules = state.modules.set(module_index, CtfeModuleGlobalsRejected(error)),
		metrics = { state.metrics |
			rejected_module_evaluations = state.metrics.rejected_module_evaluations + 1
		}
	}


private pure func ctfe_start_planned_module_evaluation(
	state: CtfeGlobalGraphEvaluationState,
	module_index: Int,
) -> CtfeGlobalGraphEvaluationState:
	{ state |
		modules = state.modules.set(module_index, CtfeModuleGlobalsEvaluating),
		metrics = { state.metrics |
			module_global_evaluation_starts = state.metrics.module_global_evaluation_starts + 1
		}
	}


private pure func ctfe_evaluate_ready_module_globals(
	state: CtfeGlobalGraphEvaluationState,
	imported: CtfeImportedProgram,
) -> CtfeGlobalGraphEvaluationState:
	module_id = ctfe_imported_program_module_id(imported)
	module_index = module_id_table_index(module_id)
	bindings = ctfe_imported_program_import_bindings(imported)
	module_context = { state.context | active_module_id = module_id }
	evaluation = ctfe_eval_decls_global_env_with_metrics(
		module_context,
		ctfe_imported_global_env(module_context, bindings),
		ctfe_imported_program_decls(imported),
	)
	var result = { state | metrics = { state.metrics |
			import_binding_applications = state.metrics.import_binding_applications + bindings.length(),
			global_declaration_evaluations = state.metrics.global_declaration_evaluations + evaluation.global_declaration_evaluations
		} }

	match evaluation.result:
		Ok(env):
			{ result |
				modules = result.modules.set(module_index, CtfeModuleGlobalsEvaluated(env)),
				context = ctfe_context_with_module_global_env(
					result.context,
					result.context.module_table,
					module_id,
					env,
				)
			}
		Err(error):
			wrapped_error = match ctfe_context_module_path(result.context, module_id):
				Some(module_path):
					CtfeEvalInModule(module_path, error)
				None:
					CtfeEvalInvalid(
						"compile-time module id is not present in the CTFE module table",
					)

			ctfe_rejected_global_graph_state(result, module_index, wrapped_error)


pure func ctfe_evaluate_dependency_global_graph(
	definition_table: DefinitionTable,
	active_module_id: ModuleId,
	imported_program_set: CtfeImportedProgramSet,
) -> Result[CtfeEvaluatedGlobalGraph, CtfeEvalError]:
	module_table = definition_table_module_table(definition_table)
	imported_programs = ctfe_imported_program_set_programs(imported_program_set)

	match ctfe_context_from_imported_programs(
		definition_table,
		active_module_id,
		imported_program_set,
	):
		None:
			Err(
				CtfeEvalInvalid(
					"CTFE inputs do not belong to one definition and module identity domain",
				),
			)
		Some(base_context):
			var planned_modules: List[Bool] = []

			for _ in 0..module_table_count(module_table):
				planned_modules = planned_modules.append(False)

			var state: CtfeGlobalGraphEvaluationState = {
				context = base_context,
				modules = ctfe_empty_module_global_evaluations(module_table),
				metrics = {
					planned_unique_modules = 0,
					module_global_evaluation_starts = 0,
					duplicate_module_global_evaluations = 0,
					import_binding_applications = 0,
					global_declaration_evaluations = 0,
					rejected_module_evaluations = 0
				}
			}

			for imported in imported_programs:
				module_index = module_id_table_index(ctfe_imported_program_module_id(imported))

				if planned_modules.get_or(module_index, False):
					state = { state |
						metrics = { state.metrics |
							duplicate_module_global_evaluations = state.metrics.duplicate_module_global_evaluations + 1
						}
					}
				else:
					planned_modules = planned_modules.set(module_index, True)
					state = { state |
						metrics = { state.metrics |
							planned_unique_modules = state.metrics.planned_unique_modules + 1
						}
					}

			-- Stage 06 constructs this list dependency-first from the exact CTFE
			-- artifact closures. Preserve that semantic order; the dense table is
			-- membership/state authority, not a replacement ordering.
			for imported in imported_programs:
				module_index = module_id_table_index(ctfe_imported_program_module_id(imported))

				match state.modules.get(module_index):
					Some(CtfeModuleGlobalsUnrequested):
						state = ctfe_start_planned_module_evaluation(state, module_index)
						state = ctfe_evaluate_ready_module_globals(state, imported)
					Some(CtfeModuleGlobalsEvaluating):
						state = ctfe_rejected_global_graph_state(
							state,
							module_index,
							CtfeEvalInvalid(
								"compile-time dependency global evaluation contains a cycle",
							),
						)
					_:
						void

			Ok(into_opaque CtfeEvaluatedGlobalGraph({
						definition_table = definition_table,
						modules = state.modules,
						metrics = state.metrics
					}))


private pure func ctfe_context_with_evaluated_dependency_globals(
	context: CtfeContext,
	graph: CtfeEvaluatedGlobalGraph,
	imported_programs: List[CtfeImportedProgram],
) -> Result[CtfeContext, CtfeEvalError]:
	rep = from_opaque CtfeEvaluatedGlobalGraph(graph)

	if not definition_tables_share_provenance(context.definition_table, rep.definition_table):
		Err(
			CtfeEvalInvalid(
				"CTFE evaluated globals belong to a different definition identity domain",
			),
		)
	else:
		var result_context = context
		var failure: Option[CtfeEvalError] = None

		for imported in imported_programs:
			module_id = ctfe_imported_program_module_id(imported)

			match rep.modules.get(module_id_table_index(module_id)):
				Some(CtfeModuleGlobalsEvaluated(env)):
					result_context = ctfe_context_with_module_global_env(
						result_context,
						result_context.module_table,
						module_id,
						env,
					)
				Some(CtfeModuleGlobalsRejected(error)):
					failure = Some(error)
				Some(CtfeModuleGlobalsEvaluating):
					failure = Some(
						CtfeEvalInvalid(
							"compile-time dependency global evaluation is still in progress",
						),
					)
				_:
					failure = Some(
						CtfeEvalInvalid("compile-time dependency globals were not evaluated"),
					)

			if failure.is_some():
				break

		match failure:
			Some(error):
				Err(error)
			None:
				Ok(result_context)


pure func ctfe_rewrite_program_globals_with_evaluated_dependencies(
	graph: CtfeEvaluatedGlobalGraph,
	target_module_id: ModuleId,
	program: TypedProgram,
	imported_program_set: CtfeImportedProgramSet,
	import_bindings: List[CtfeImportBinding],
) -> Result[TypedProgram, CtfeEvalError]:
	rep = from_opaque CtfeEvaluatedGlobalGraph(graph)
	imported_programs = ctfe_imported_program_set_programs(imported_program_set)

	match ctfe_context_from_program(
		rep.definition_table,
		target_module_id,
		program,
		import_bindings,
		imported_program_set,
	):
		None:
			Err(
				CtfeEvalInvalid(
					"CTFE inputs do not belong to one definition and module identity domain",
				),
			)
		Some(base_context):
			context ?= ctfe_context_with_evaluated_dependency_globals(
				base_context,
				graph,
				imported_programs,
			)
			ctfe_rewrite_program_globals_with_import_bindings(context, import_bindings, program)


pure func ctfe_eval_imported_program_global_envs(
	context: CtfeContext,
	imported_programs: List[CtfeImportedProgram],
) -> Result[CtfeContext, CtfeEvalError]:
	imported_program_set = ctfe_imported_program_set(context.definition_table, imported_programs)
	graph ?= ctfe_evaluate_dependency_global_graph(
		context.definition_table,
		context.active_module_id,
		imported_program_set,
	)
	ctfe_context_with_evaluated_dependency_globals(context, graph, imported_programs)


pure func ctfe_bind_imported_global(
	context: CtfeContext,
	env: CtfeEnv,
	binding: CtfeImportBinding,
) -> CtfeEnv:
	match binding:
		CtfeQualifiedModuleBinding(_, _):
			env
		CtfeSelectiveDefinitionBinding(local_name, module_id, source_name):
			match ctfe_context_module_global_value(context, module_id, source_name):
				Some(value):
					ctfe_bind_global_value(env, local_name, value)
				None:
					if ctfe_context_module_has_global_binding(context, module_id, source_name):
						match ctfe_context_module_path(context, module_id):
							Some(module_path):
								ctfe_bind_unavailable_global(
									env,
									local_name,
									CtfeImportedRuntimeInitializedGlobal(module_path, source_name),
								)
							None:
								env
					else:
						env


pure func ctfe_imported_global_env(
	context: CtfeContext,
	import_bindings: List[CtfeImportBinding],
) -> CtfeEnv:
	var env: CtfeEnv = CTFE_ENV_EMPTY

	for binding in import_bindings:
		env = ctfe_bind_imported_global(context, env, binding)

	env


pure func ctfe_rewrite_program_globals(
	context: CtfeContext,
	base_env: CtfeEnv,
	program: TypedProgram,
) -> Result[TypedProgram, CtfeEvalError]:
	var env = ctfe_bind_unavailable_program_globals(base_env, program)
	var decls: List[TypedDecl] = []
	var failure: Option[CtfeEvalError] = None

	for decl in program.decls:
		match ctfe_rewrite_decl_globals(context, env, decl):
			Ok(result):
				env = result.env
				decls = decls.append(result.decl)
			Err(error):
				failure = Some(error)
				break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok({ program | decls = decls })


pure func ctfe_rewrite_program_globals_with_import_bindings(
	context: CtfeContext,
	import_bindings: List[CtfeImportBinding],
	program: TypedProgram,
) -> Result[TypedProgram, CtfeEvalError]:
	ctfe_rewrite_program_globals(
		context,
		ctfe_imported_global_env(context, import_bindings),
		program,
	)


pure func ctfe_evaluate_program_globals(
	definition_table: DefinitionTable,
	target_module_id: ModuleId,
	program: TypedProgram,
	imported_program_set: CtfeImportedProgramSet,
	import_bindings: List[CtfeImportBinding],
) -> Result[TypedProgram, CtfeEvalError]:
	graph ?= ctfe_evaluate_dependency_global_graph(
		definition_table,
		target_module_id,
		imported_program_set,
	)
	ctfe_rewrite_program_globals_with_evaluated_dependencies(
		graph,
		target_module_id,
		program,
		imported_program_set,
		import_bindings,
	)
