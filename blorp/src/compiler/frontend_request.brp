-- Compiler-owned request model for source graphs that have completed parsing
-- and import discovery but have not entered typechecking. Command planning may
-- carry this immutable value, while compiler orchestration owns its meaning.
import:
	stage_04_modules/frontend_graph: FrontendGraph


record FrontendSourcePackage {
	package_alias: String,
	package_name: String,
	package_root: String,
	source_dir: String,
	exports: List[String]
}


record FrontendGraphContext {
	std_dir: Option[String],
	source_packages: List[FrontendSourcePackage],
	package_roots: List[String]
}


record FrontendCompilationGraph {
	context: FrontendGraphContext,
	graph: FrontendGraph,
	diagnostics: List[String]
}
