-- Compiler-owned request model for source graphs that have completed parsing
-- and import discovery but have not entered typechecking. Command planning may
-- carry this immutable value, while compiler orchestration owns its meaning.
import:
	stage_03_parse/source_ast_finalize: FinalizedTypecheckProgram


record FrontendSourcePackage {
	package_alias: String,
	package_name: String,
	package_root: String,
	source_dir: String,
	exports: List[String]
}


record FrontendGraphContext {
	std_dir: Option[String],
	source_packages: List[FrontendSourcePackage],
	package_roots: List[String]
}


union FrontendModuleOrigin:
	FrontendUserModule
	FrontendGeneratedModule
	FrontendStdModule
	FrontendSourcePackageModule(String)
	FrontendPkgModule(String)


record FrontendGraphSource {
	path: String,
	module_name: String,
	source_text: String,
	typecheck_program: FinalizedTypecheckProgram,
	origin: FrontendModuleOrigin
}


record FrontendSourceImportEdge {
	from_path: String,
	from_module: String,
	import_path: String,
	resolved_path: Option[String],
	resolved_module: Option[String],
	resolved_origin: Option[FrontendModuleOrigin]
}


record FrontendModuleGraph {
	context: FrontendGraphContext,
	roots: List[FrontendGraphSource],
	modules: List[FrontendGraphSource],
	import_edges: List[FrontendSourceImportEdge],
	diagnostics: List[String]
}
