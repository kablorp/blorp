				else:
					value_start = pattern_values.length() - child_count
					child_start = pattern_children.length()
					var binding_count: Int = 0
					var value_index = value_start

					while value_index < pattern_values.length():
						child_id = pattern_values
							.get(value_index)
							.get_or(-1)
						pattern_children = pattern_children.append(child_id)
						binding_count += pattern_binding_counts
							.get(child_id)
							.get_or(0)
