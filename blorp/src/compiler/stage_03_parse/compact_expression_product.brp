-- Test oracle for the staged compact-expression schema.
--
-- This module has no production callers. It proves one driver-local buffer
-- construction model and differential projection for the first expression
-- family before the production parser owns any compact representation.
import:
	../../lib/source:
		SourceFile,
		SourceLocation,
		compiler_prelude_source_location,
		singleton_source_file_id,
		source_location_end_offset,
		source_location_from_offsets,
		source_location_start_offset,
		source_locations_equal,
	parsed_ast:
		ParsedBinaryOp(
			ParsedAddOp,
			ParsedDivideOp,
			ParsedEqualOp,
			ParsedGreaterEqualOp,
			ParsedGreaterOp,
			ParsedLessEqualOp,
			ParsedLessOp,
			ParsedModuloOp,
			ParsedMultiplyOp,
			ParsedNotEqualOp,
			ParsedSubtractOp,
		),
		ParsedCompoundAssignOp(
			ParsedAssignAddOp,
			ParsedAssignDivideOp,
			ParsedAssignMultiplyOp,
			ParsedAssignSubtractOp,
		),
		ParsedConcurrentParam,
		ParsedDictEntry,
		ParsedDimBinaryOp(
			ParsedDimAddOp,
			ParsedDimDivideOp,
			ParsedDimMultiplyOp,
			ParsedDimSubtractOp,
		),
		ParsedDimConstraint,
		ParsedExpr(
			ParsedAssignExpr,
			ParsedBinaryExpr,
			ParsedAscriptionExpr,
			ParsedBlockExpr,
			ParsedBoolLiteralExpr,
			ParsedBreakExpr,
			ParsedBuiltinExpr,
			ParsedCallExpr,
			ParsedCharLiteralExpr,
			ParsedContinueExpr,
			ParsedCompoundAssignExpr,
			ParsedConcurrentBlockExpr,
			ParsedConcurrentForExpr,
			ParsedDebugBlockExpr,
			ParsedDetachExpr,
			ParsedFloatLiteralExpr,
			ParsedDictExpr,
			ParsedFieldAccessExpr,
			ParsedForExpr,
			ParsedFunctionDeclExpr,
			ParsedIfExpr,
			ParsedIntLiteralExpr,
			ParsedListExpr,
			ParsedLambdaExpr,
			ParsedLogicalExpr,
			ParsedMatchExpr,
			ParsedMissingExpr,
			ParsedNameExpr,
			ParsedOpaqueFromExpr,
			ParsedOpaqueIntoExpr,
			ParsedQuestionBindExpr,
			ParsedRangeExpr,
			ParsedStringInterpolationExpr,
			ParsedStringInterpolationPartsExpr,
			ParsedStringLiteralExpr,
			ParsedSubscriptExpr,
			ParsedSubscriptAssignExpr,
			ParsedTupleExpr,
			ParsedTupleDestructExpr,
			ParsedUnaryExpr,
			ParsedRecordExpr,
			ParsedRecordUpdateExpr,
			ParsedSelectExpr,
			ParsedVectorExpr,
			ParsedVarDeclExpr,
			ParsedVoidExpr,
			ParsedWhileExpr,
			ParsedWithExpr,
		),
		ParsedForBinder(ParsedForNameBinder, ParsedForTupleBinder),
		ParsedFunctionAnnotation(
			ParsedDebugOnlyAnnotation,
			ParsedNoCopyAnnotation,
			ParsedResourceResultOrdinaryAnnotation,
			ParsedTailRecursiveAnnotation,
		),
		ParsedFunctionDecl,
		ParsedIdentifier,
		ParsedLambdaParam,
		ParsedListPatternSpread(ParsedListSpreadName, ParsedListSpreadWildcard),
		ParsedLogicalOp(ParsedAndOp, ParsedOrOp),
		ParsedMatchCase,
		ParsedParam,
		ParsedParamBinder(ParsedParamNameBinder, ParsedParamTupleBinder, ParsedParamWildcardBinder),
		ParsedPattern(
			ParsedBoolPattern,
			ParsedCharPattern,
			ParsedConstructorPattern,
			ParsedFloatPattern,
			ParsedIntPattern,
			ParsedListPattern,
			ParsedMissingPattern,
			ParsedNamePattern,
			ParsedOrPattern,
			ParsedQualifiedConstructorPattern,
			ParsedStringPattern,
			ParsedTuplePattern,
			ParsedWildcardPattern,
		),
		ParsedRecordExprField,
		ParsedSelectArm,
		ParsedSelectArmKind(ParsedSelectAfterArm, ParsedSelectReceiveArm, ParsedSelectSealedArm),
		ParsedStringInterpolationPart(ParsedInterpolationExpr, ParsedInterpolationLiteral),
		ParsedStringLiteralForm,
		ParsedTypeExpr(
			ParsedArrayType,
			ParsedBoundedType,
			ParsedDimBinaryType,
			ParsedDimLiteralType,
			ParsedDimNameType,
			ParsedFunctionType,
			ParsedMissingType,
			ParsedNamedType,
			ParsedQualifiedNamedType,
			ParsedRangeType,
			ParsedTupleType,
		),
		ParsedTypeParamDecl,
		ParsedUnaryOp(ParsedNegateOp, ParsedNotOp),
		ParsedWithBinding,
		ParsedWithBindingKind(ParsedWithPlainBinding, ParsedWithTryBinding),
		ParsedWithErrorMap,
		parsed_identifier,
	source_ast_finalize: IdentifierReference


