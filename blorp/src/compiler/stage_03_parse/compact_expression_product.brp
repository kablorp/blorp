private record CompactExpressionProductRep {
	source_owners: List[SourceFile],
	nodes: List[CompactExpressionNodeRow],
	children: List[Int],
	texts: List[String],
	text_payloads: List[CompactTextPayloadRow],
	string_payloads: List[CompactStringPayloadRow],
	interpolation_payloads: List[CompactInterpolationPayloadRow],
	bool_payloads: List[CompactBoolPayloadRow],
	char_payloads: List[CompactCharPayloadRow],
	operator_payloads: List[CompactOperatorPayloadRow],
	call_payloads: List[CompactCallPayloadRow],
	field_access_payloads: List[CompactFieldAccessPayloadRow],
	record_payloads: List[CompactRecordPayloadRow],
	record_fields: List[CompactRecordFieldRow],
	dict_payloads: List[CompactDictPayloadRow],
	dict_entries: List[CompactDictEntryRow],
	type_nodes: List[CompactTypeNodeRow],
	type_children: List[Int],
	type_identifier_slices: List[CompactTypeIdentifierSliceRow],
	type_identifiers: List[CompactTypeIdentifierRow],
	interpolation_parts_payloads: List[CompactInterpolationPartsPayloadRow],
	interpolation_parts: List[CompactInterpolationPartRow],
	control_identifiers: List[CompactControlIdentifierRow],
	identifier_slices: List[CompactIdentifierSliceRow],
	typed_binders: List[CompactTypedBinderRow],
	pattern_nodes: List[CompactPatternNodeRow],
	pattern_children: List[Int],
	pattern_identifier_slices: List[CompactPatternIdentifierSliceRow],
	pattern_identifiers: List[CompactPatternIdentifierRow],
	match_cases: List[CompactMatchCaseRow],
	select_arms: List[CompactSelectArmRow],
	with_bindings: List[CompactWithBindingRow],
	with_error_maps: List[CompactWithErrorMapRow],
	lambda_payloads: List[CompactLambdaRow],
	function_payloads: List[CompactFunctionRow],
	callable_params: List[CompactCallableParamRow],
	callable_type_params: List[CompactCallableTypeParamRow],
	callable_dim_constraints: List[CompactCallableDimConstraintRow],
	function_annotations: List[CompactFunctionAnnotationKind],
	concurrent_params: List[CompactConcurrentParamRow],
	concurrent_for_payloads: List[CompactConcurrentForRow],
	unit_payloads: List[CompactUnitPayloadRow],
	roots: List[Int]
}


opaque type ValidatedExpressionProduct = CompactExpressionProductRep


