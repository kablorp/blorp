	bool_payload_count: Int,
	char_payload_count: Int,
	operator_payload_count: Int,
	call_payload_count: Int,
	field_access_payload_count: Int,
	record_payload_count: Int,
	record_field_count: Int,
	dict_payload_count: Int,
	dict_entry_count: Int,
	type_node_count: Int,
	type_child_count: Int,
	type_identifier_slice_count: Int,
	type_identifier_count: Int,
	interpolation_parts_payload_count: Int,
	interpolation_part_count: Int,
	control_identifier_count: Int,
	identifier_slice_count: Int,
	typed_binder_count: Int,
	unit_payload_count: Int,
	root_count: Int
}


struct CompactReferenceTraversalCounts {
	reference_count: Int,
	bound_name_comparison_count: Int
}


private record CompactReferenceTraversalResult {
	references: List[IdentifierReference],
	bound_name_comparison_count: Int
}


private struct CompactBoundNameLookup {
	is_bound: Bool,
	comparison_count: Int
}


private union CompactBuildAction:
	CompactBuildVisit(ParsedExpr)
	CompactBuildUnary(ParsedUnaryOp, SourceLocation)
	CompactBuildBinary(ParsedBinaryOp, SourceLocation)
	CompactBuildLogical(ParsedLogicalOp, SourceLocation)
	CompactBuildCall(Int, SourceLocation)
	CompactBuildFieldAccess(ParsedIdentifier, SourceLocation)
	CompactBuildSubscript(Int, SourceLocation)
	CompactBuildSequence(CompactExpressionNodeKind, Int, SourceLocation)
	CompactBuildRecord(List[ParsedRecordExprField], Bool, SourceLocation)
	CompactBuildDict(List[ParsedDictEntry], SourceLocation)
	CompactBuildTypedWrapper(CompactExpressionNodeKind, SourceLocation)
	CompactBuildRange(SourceLocation)
	CompactBuildInterpolationParts(List[ParsedStringInterpolationPart], Bool, SourceLocation)
	CompactBuildTypedBinder(CompactExpressionNodeKind, ParsedIdentifier, Bool, SourceLocation)
	CompactBuildIdentifier(CompactExpressionNodeKind, ParsedIdentifier, Int, SourceLocation)
	CompactBuildIdentifierSlice(CompactExpressionNodeKind, List[ParsedIdentifier], Int, SourceLocation, SourceLocation)
	CompactBuildTypeVisit(ParsedTypeExpr)
	CompactBuildTypeIdentifiers(CompactTypeNodeKind, List[ParsedIdentifier], Int, SourceLocation)
	CompactBuildTypeText(CompactTypeNodeKind, String, SourceLocation)
	CompactBuildTypeNoPayload(CompactTypeNodeKind, Int, SourceLocation)


private union CompactReferenceAction:
	CompactReferenceVisit(Int)
	CompactReferenceEnterIdentifier(Int)
	CompactReferenceEnterIdentifierSlice(Int)
	CompactReferenceLeaveBindings(Int)


private NO_COMPACT_PAYLOAD_INDEX: Int = -1

private NO_COMPACT_SOURCE_OWNER_INDEX: Int = -1

private NO_COMPACT_TYPE_ROOT_INDEX: Int = -1


private pure func compact_source_location(location: SourceLocation) -> CompactProductSourceLocation:
	owner_index = if source_locations_equal(location, compiler_prelude_source_location()):
		NO_COMPACT_SOURCE_OWNER_INDEX
	else:
		0

	{
		source_owner_index = owner_index,
		location = location
	}


private pure func compact_unary_operator(op: ParsedUnaryOp) -> CompactExpressionOperator:
	match op:
		ParsedNegateOp:
			CompactNegateOperator
		ParsedNotOp:
			CompactNotOperator


private pure func compact_binary_operator(op: ParsedBinaryOp) -> CompactExpressionOperator:
	match op:
		ParsedAddOp:
			CompactAddOperator
		ParsedSubtractOp:
			CompactSubtractOperator
		ParsedMultiplyOp:
			CompactMultiplyOperator
		ParsedDivideOp:
			CompactDivideOperator
		ParsedModuloOp:
			CompactModuloOperator
		ParsedEqualOp:
			CompactEqualOperator
		ParsedNotEqualOp:
			CompactNotEqualOperator
		ParsedLessOp:
			CompactLessOperator
		ParsedLessEqualOp:
			CompactLessEqualOperator
		ParsedGreaterOp:
			CompactGreaterOperator
		ParsedGreaterEqualOp:
			CompactGreaterEqualOperator


private pure func compact_logical_operator(op: ParsedLogicalOp) -> CompactExpressionOperator:
	match op:
		ParsedAndOp:
			CompactAndOperator
		ParsedOrOp:
			CompactOrOperator


private pure func compact_compound_assign_kind(
	op: ParsedCompoundAssignOp,
) -> CompactExpressionNodeKind:
	match op:
		ParsedAssignAddOp:
			CompactCompoundAddAssignNode
		ParsedAssignSubtractOp:
			CompactCompoundSubtractAssignNode
		ParsedAssignMultiplyOp:
			CompactCompoundMultiplyAssignNode
		ParsedAssignDivideOp:
			CompactCompoundDivideAssignNode


private pure func parsed_compound_assign_operator(
	kind: CompactExpressionNodeKind,
) -> Option[ParsedCompoundAssignOp]:
	match kind:
		CompactCompoundAddAssignNode:
			Some(ParsedAssignAddOp)
		CompactCompoundSubtractAssignNode:
			Some(ParsedAssignSubtractOp)
		CompactCompoundMultiplyAssignNode:
			Some(ParsedAssignMultiplyOp)
		CompactCompoundDivideAssignNode:
			Some(ParsedAssignDivideOp)
		_:
			None


private pure func compact_dim_binary_kind(op: ParsedDimBinaryOp) -> CompactTypeNodeKind:
	match op:
		ParsedDimAddOp:
			CompactDimAddTypeNode
		ParsedDimSubtractOp:
			CompactDimSubtractTypeNode
		ParsedDimMultiplyOp:
			CompactDimMultiplyTypeNode
		ParsedDimDivideOp:
			CompactDimDivideTypeNode


private pure func parsed_dim_binary_operator(
	kind: CompactTypeNodeKind,
) -> Option[ParsedDimBinaryOp]:
	match kind:
		CompactDimAddTypeNode:
			Some(ParsedDimAddOp)
		CompactDimSubtractTypeNode:
			Some(ParsedDimSubtractOp)
		CompactDimMultiplyTypeNode:
			Some(ParsedDimMultiplyOp)
		CompactDimDivideTypeNode:
			Some(ParsedDimDivideOp)
		_:
			None


private pure func parsed_unary_operator(op: CompactExpressionOperator) -> Option[ParsedUnaryOp]:
	match op:
		CompactNegateOperator:
			Some(ParsedNegateOp)
		CompactNotOperator:
			Some(ParsedNotOp)
		_:
			None


private pure func parsed_binary_operator(op: CompactExpressionOperator) -> Option[ParsedBinaryOp]:
	match op:
		CompactAddOperator:
			Some(ParsedAddOp)
		CompactSubtractOperator:
			Some(ParsedSubtractOp)
		CompactMultiplyOperator:
			Some(ParsedMultiplyOp)
		CompactDivideOperator:
			Some(ParsedDivideOp)
		CompactModuloOperator:
			Some(ParsedModuloOp)
		CompactEqualOperator:
			Some(ParsedEqualOp)
		CompactNotEqualOperator:
			Some(ParsedNotEqualOp)
		CompactLessOperator:
			Some(ParsedLessOp)
		CompactLessEqualOperator:
			Some(ParsedLessEqualOp)
		CompactGreaterOperator:
			Some(ParsedGreaterOp)
		CompactGreaterEqualOperator:
			Some(ParsedGreaterEqualOp)
		_:
			None


private pure func parsed_logical_operator(op: CompactExpressionOperator) -> Option[ParsedLogicalOp]:
	match op:
		CompactAndOperator:
			Some(ParsedAndOp)
		CompactOrOperator:
			Some(ParsedOrOp)
		_:
			None


private pure func compact_operator_matches_node(
	kind: CompactExpressionNodeKind,
	op: CompactExpressionOperator,
) -> Bool:
	match kind:
		CompactUnaryNode:
			parsed_unary_operator(op).is_some()
		CompactBinaryNode:
			parsed_binary_operator(op).is_some()
		CompactLogicalNode:
			parsed_logical_operator(op).is_some()
		_:
			False


private pure func compact_unit_matches_node(
	kind: CompactExpressionNodeKind,
	payload: CompactUnitPayloadKind,
) -> Bool:
	match kind:
		CompactBreakNode:
			payload == CompactBreakPayload
		CompactContinueNode:
			payload == CompactContinuePayload
		CompactVoidNode:
			payload == CompactVoidPayload
		CompactUnnamedBuiltinNode:
			payload == CompactUnnamedBuiltinPayload
		CompactMissingNode:
			payload == CompactMissingPayload
		_:
			False


private pure func compact_expected_child_count(
	kind: CompactExpressionNodeKind,
	call_payloads: List[CompactCallPayloadRow],
	payload_index: Int,
) -> Option[Int]:
	match kind:
		CompactUnaryNode:
			Some(1)
		CompactBinaryNode:
			Some(2)
		CompactLogicalNode:
			Some(2)
		CompactCallNode:
			match call_payloads.get(payload_index):
				Some(row):
					if row.argument_count >= 0:
						Some(row.argument_count + 1)
					else:
						None
				None:
					None
		CompactFieldAccessNode:
			Some(1)
		CompactSubscriptNode:
			None
		CompactListNode | CompactTupleNode | CompactVectorNode:
			None
		CompactRecordNode | CompactRecordUpdateNode | CompactDictNode:
			None
		CompactFinalizedInterpolationNode:
			None
		CompactBlockNode | CompactSubscriptAssignNode | CompactIfNode:
			None
		CompactAscriptionNode | CompactOpaqueIntoNode | CompactOpaqueFromNode:
			Some(1)
		CompactRangeNode:
			Some(2)
		CompactImmutableVarDeclNode | CompactMutableVarDeclNode | CompactAssignNode | CompactCompoundAddAssignNode | CompactCompoundSubtractAssignNode | CompactCompoundMultiplyAssignNode | CompactCompoundDivideAssignNode | CompactTupleDestructNode | CompactQuestionBindNode:
			Some(1)
		CompactDebugBlockNode:
			Some(1)
		CompactWhileNode | CompactForNameNode | CompactForTupleNode:
			Some(2)
		_:
			Some(0)


private pure func compact_metadata_slice_is_valid(start: Int, count: Int, length: Int) -> Bool:
	start >= 0 and count >= 0 and start <= length and count <= length - start


private pure func compact_type_exact_child_count(kind: CompactTypeNodeKind) -> Option[Int]:
	match kind:
		CompactBoundedTypeNode | CompactDimNameTypeNode | CompactDimSplatNameTypeNode | CompactDimLiteralTypeNode | CompactMissingTypeNode:
			Some(0)
		CompactDimAddTypeNode | CompactDimSubtractTypeNode | CompactDimMultiplyTypeNode | CompactDimDivideTypeNode:
			Some(2)
		CompactRangeTypeNode:
			Some(1)
		_:
			None


private pure func compact_type_uses_identifier_slice(kind: CompactTypeNodeKind) -> Bool:
	match kind:
		CompactNamedTypeNode | CompactQualifiedNamedTypeNode | CompactBoundedTypeNode | CompactDimNameTypeNode | CompactDimSplatNameTypeNode:
			True
		_:
			False


private pure func compact_type_identifier_count_is_valid(
	kind: CompactTypeNodeKind,
	count: Int,
) -> Bool:
	match kind:
		CompactNamedTypeNode | CompactDimNameTypeNode | CompactDimSplatNameTypeNode:
			count == 1
		CompactQualifiedNamedTypeNode:
			count == 2
		CompactBoundedTypeNode:
			count >= 1
		_:
			False


private pure func compact_source_span_is_valid(
	sources: List[SourceFile],
	span: CompactProductSourceLocation,
) -> Bool:
	match sources.get(span.source_owner_index):
		Some(source):
			start = source_location_start_offset(span.location)
			end = source_location_end_offset(span.location)
			start >= 0 and start <= end and end <= source.text.length()
		None:
			False


private pure func compact_expression_product_is_valid(rep: CompactExpressionProductRep) -> Bool:
	if rep.source_owners.is_empty():
		False
	else:
		var valid = True
		var parent_count = 0.repeat(rep.nodes.length())
		var root_membership = False.repeat(rep.nodes.length())
		var child_slot_owners = 0.repeat(rep.children.length())
		var owned_text_indices = 0.repeat(rep.texts.length())
		var text_owners = 0.repeat(rep.text_payloads.length())
		var string_owners = 0.repeat(rep.string_payloads.length())
		var interpolation_owners = 0.repeat(rep.interpolation_payloads.length())
		var bool_owners = 0.repeat(rep.bool_payloads.length())
		var char_owners = 0.repeat(rep.char_payloads.length())
		var operator_owners = 0.repeat(rep.operator_payloads.length())
		var call_owners = 0.repeat(rep.call_payloads.length())
		var field_access_owners = 0.repeat(rep.field_access_payloads.length())
		var record_owners = 0.repeat(rep.record_payloads.length())
		var record_field_slot_owners = 0.repeat(rep.record_fields.length())
		var dict_owners = 0.repeat(rep.dict_payloads.length())
		var dict_entry_slot_owners = 0.repeat(rep.dict_entries.length())
		var type_parent_count = 0.repeat(rep.type_nodes.length())
		var type_root_membership = False.repeat(rep.type_nodes.length())
		var type_child_slot_owners = 0.repeat(rep.type_children.length())
		var type_identifier_slice_owners = 0.repeat(rep.type_identifier_slices.length())
		var type_identifier_owners = 0.repeat(rep.type_identifiers.length())
		var interpolation_parts_payload_owners = 0.repeat(rep.interpolation_parts_payloads.length())
		var interpolation_part_slot_owners = 0.repeat(rep.interpolation_parts.length())
		var control_identifier_owners = 0.repeat(rep.control_identifiers.length())
		var identifier_slice_owners = 0.repeat(rep.identifier_slices.length())
		var typed_binder_owners = 0.repeat(rep.typed_binders.length())
		var unit_owners = 0.repeat(rep.unit_payloads.length())

		for root in rep.roots:
			if root < 0 or root >= rep.nodes.length():
				valid = False
			else if (
				root_membership
					.get(root)
					.get_or(False)
			):
				valid = False
			else:
				root_membership = root_membership.set(root, True)

		var node_index: Int = 0

		while node_index < rep.nodes.length() and valid:
			match rep.nodes.get(node_index):
				Some(node):
					if not compact_source_span_is_valid(rep.source_owners, node.span):
						valid = False

					if (
						node.child_start < 0
						or node.child_count < 0
						or node.child_start > rep.children.length()
						or node.child_count > rep.children.length() - node.child_start
					):
						valid = False

					match compact_expected_child_count(
						node.kind,
						rep.call_payloads,
						node.payload_index,
					):
						Some(expected):
							if node.child_count != expected:
								valid = False
						None:
							match node.kind:
								CompactSubscriptNode:
									valid = (
										node.child_count >= 1
										and node.payload_index == NO_COMPACT_PAYLOAD_INDEX
									)
								CompactListNode | CompactTupleNode | CompactVectorNode:
									valid = node.payload_index == NO_COMPACT_PAYLOAD_INDEX
								CompactRecordNode | CompactRecordUpdateNode:
									match rep.record_payloads.get(node.payload_index):
										Some(payload):
											valid = (
												compact_metadata_slice_is_valid(
													payload.field_start,
													payload.field_count,
													rep.record_fields.length(),
												)
												and ((
													(
														node.kind == CompactRecordNode
														and node.child_count == payload.field_count
													)
													or (
														node.kind == CompactRecordUpdateNode
														and node.child_count >= 1
														and node.child_count - 1 == payload.field_count
													)
												))
											)
										None:
											valid = False
								CompactDictNode:
									match rep.dict_payloads.get(node.payload_index):
										Some(payload):
											valid = (
												compact_metadata_slice_is_valid(
													payload.entry_start,
													payload.entry_count,
													rep.dict_entries.length(),
												)
												and node.child_count % 2 == 0
												and node.child_count / 2 == payload.entry_count
											)
										None:
											valid = False
								CompactFinalizedInterpolationNode:
									match rep.interpolation_parts_payloads.get(node.payload_index):
										Some(payload):
											valid = compact_metadata_slice_is_valid(
												payload.part_start,
												payload.part_count,
												rep.interpolation_parts.length(),
											)
										None:
											valid = False
								CompactBlockNode | CompactDebugBlockNode | CompactWhileNode:
									valid = node.payload_index == NO_COMPACT_PAYLOAD_INDEX
								CompactIfNode:
									valid = (
										(node.child_count == 2 or node.child_count == 3)
										and node.payload_index == NO_COMPACT_PAYLOAD_INDEX
									)
								CompactSubscriptAssignNode:
									valid = (
										node.child_count >= 2
										and node.payload_index == NO_COMPACT_PAYLOAD_INDEX
									)
								CompactForNameNode:
									valid = (
										node.payload_index >= 0
										and node.payload_index < rep.control_identifiers.length()
									)
								CompactForTupleNode:
									valid = (
										node.payload_index >= 0
										and node.payload_index < rep.identifier_slices.length()
									)
								_:
									valid = False

					var child_offset: Int = 0

					while child_offset < node.child_count and valid:
						child_slot = node.child_start + child_offset

						match rep.children.get(child_slot):
							Some(child):
								if child < 0 or child >= node_index:
									valid = False
								else:
									parent_count = parent_count.set(child, parent_count
											.get(child)
											.get_or(0) + 1)
									child_slot_owners = child_slot_owners.set(
										child_slot,
										child_slot_owners
											.get(child_slot)
											.get_or(0) + 1,
									)
							None:
								valid = False

						child_offset += 1

					match node.kind:
						CompactNameNode | CompactIntNode | CompactFloatNode | CompactNamedBuiltinNode:
							match rep.text_payloads.get(node.payload_index):
								Some(payload):
									if (
										payload.text_index < 0
										or payload.text_index >= rep.texts.length()
									):
										valid = False
									else:
										text_owners = text_owners.set(
											node.payload_index,
											text_owners
												.get(node.payload_index)
												.get_or(0) + 1,
										)
										owned_text_indices = owned_text_indices.set(
											payload.text_index,
											owned_text_indices
												.get(payload.text_index)
												.get_or(0) + 1,
										)
								None:
									valid = False
						CompactStringNode:
							match rep.string_payloads.get(node.payload_index):
								Some(payload):
									if (
										payload.text_index < 0
										or payload.text_index >= rep.texts.length()
									):
										valid = False
									else:
										string_owners = string_owners.set(
											node.payload_index,
											string_owners
												.get(node.payload_index)
												.get_or(0) + 1,
										)
										owned_text_indices = owned_text_indices.set(
											payload.text_index,
											owned_text_indices
												.get(payload.text_index)
												.get_or(0) + 1,
										)
								None:
									valid = False
						CompactInterpolationNode:
							match rep.interpolation_payloads.get(node.payload_index):
								Some(payload):
									if (
										payload.text_index < 0
										or payload.text_index >= rep.texts.length()
									):
										valid = False
									else:
										interpolation_owners = interpolation_owners.set(
											node.payload_index,
											interpolation_owners
												.get(node.payload_index)
												.get_or(0) + 1,
										)
										owned_text_indices = owned_text_indices.set(
											payload.text_index,
											owned_text_indices
												.get(payload.text_index)
												.get_or(0) + 1,
										)
								None:
									valid = False
						CompactBoolNode:
							if node.payload_index < 0 or node.payload_index >= bool_owners.length():
								valid = False
							else:
								bool_owners = bool_owners.set(node.payload_index, bool_owners
										.get(node.payload_index)
										.get_or(0) + 1)
						CompactCharNode:
							if node.payload_index < 0 or node.payload_index >= char_owners.length():
								valid = False
							else:
								char_owners = char_owners.set(node.payload_index, char_owners
										.get(node.payload_index)
										.get_or(0) + 1)
						CompactUnaryNode | CompactBinaryNode | CompactLogicalNode:
							match rep.operator_payloads.get(node.payload_index):
								Some(payload):
									if compact_operator_matches_node(node.kind, payload.operator):
										operator_owners = operator_owners.set(
											node.payload_index,
											operator_owners
												.get(node.payload_index)
												.get_or(0) + 1,
										)
									else:
										valid = False
								None:
									valid = False
						CompactCallNode:
							if node.payload_index < 0 or node.payload_index >= call_owners.length():
								valid = False
							else:
								call_owners = call_owners.set(node.payload_index, call_owners
										.get(node.payload_index)
										.get_or(0) + 1)
						CompactFieldAccessNode:
							match rep.field_access_payloads.get(node.payload_index):
								Some(payload):
									if (
										not compact_source_span_is_valid(
											rep.source_owners,
											payload.field_span,
										)
										or payload.field_text_index < 0
										or payload.field_text_index >= rep.texts.length()
									):
										valid = False
									else:
										field_access_owners = field_access_owners.set(
											node.payload_index,
											field_access_owners
												.get(node.payload_index)
												.get_or(0) + 1,
										)
										owned_text_indices = owned_text_indices.set(
											payload.field_text_index,
											owned_text_indices
												.get(payload.field_text_index)
												.get_or(0) + 1,
										)
								None:
									valid = False
						CompactSubscriptNode | CompactListNode | CompactTupleNode | CompactVectorNode:
							void
						CompactRecordNode | CompactRecordUpdateNode:
							match rep.record_payloads.get(node.payload_index):
								Some(payload):
									record_owners = record_owners.set(
										node.payload_index,
										record_owners
											.get(node.payload_index)
											.get_or(0) + 1,
									)
									var field_offset: Int = 0

									while field_offset < payload.field_count and valid:
										field_slot = payload.field_start + field_offset

										match rep.record_fields.get(field_slot):
											Some(field):
												if (
													not compact_source_span_is_valid(
														rep.source_owners,
														field.name_span,
													)
													or not compact_source_span_is_valid(
														rep.source_owners,
														field.field_span,
													)
													or field.name_text_index < 0
													or field.name_text_index >= rep.texts.length()
												):
													valid = False
												else:
													record_field_slot_owners = record_field_slot_owners.set(
														field_slot,
														record_field_slot_owners
															.get(field_slot)
															.get_or(0) + 1,
													)
													owned_text_indices = owned_text_indices.set(
														field.name_text_index,
														owned_text_indices
															.get(field.name_text_index)
															.get_or(0) + 1,
													)
											None:
												valid = False

										field_offset += 1
								None:
									valid = False
						CompactDictNode:
							match rep.dict_payloads.get(node.payload_index):
								Some(payload):
									dict_owners = dict_owners.set(node.payload_index, dict_owners
											.get(node.payload_index)
											.get_or(0) + 1)
									var entry_offset: Int = 0

									while entry_offset < payload.entry_count and valid:
										entry_slot = payload.entry_start + entry_offset

										match rep.dict_entries.get(entry_slot):
											Some(entry):
												if not compact_source_span_is_valid(
													rep.source_owners,
													entry.entry_span,
												):
													valid = False
												else:
													dict_entry_slot_owners = dict_entry_slot_owners.set(
														entry_slot,
														dict_entry_slot_owners
															.get(entry_slot)
															.get_or(0) + 1,
													)
											None:
												valid = False

										entry_offset += 1
								None:
									valid = False
						CompactFinalizedInterpolationNode:
							match rep.interpolation_parts_payloads.get(node.payload_index):
								Some(payload):
									interpolation_parts_payload_owners = interpolation_parts_payload_owners.set(
										node.payload_index,
										interpolation_parts_payload_owners
											.get(node.payload_index)
											.get_or(0) + 1,
									)
									var expression_ordinal_owners = 0.repeat(node.child_count)
									var part_offset: Int = 0

									while part_offset < payload.part_count and valid:
										part_slot = payload.part_start + part_offset

										match rep.interpolation_parts.get(part_slot):
											Some(part):
												interpolation_part_slot_owners = interpolation_part_slot_owners.set(
													part_slot,
													interpolation_part_slot_owners
														.get(part_slot)
														.get_or(0) + 1,
												)

												match part.kind:
													CompactInterpolationLiteralPart:
														if (
															part.payload_index < 0
															or part.payload_index >= rep.texts.length()
														):
															valid = False
														else:
															owned_text_indices = owned_text_indices.set(
																part.payload_index,
																owned_text_indices
																	.get(part.payload_index)
																	.get_or(0) + 1,
															)
													CompactInterpolationExpressionPart:
														if (
															part.payload_index < 0
															or part.payload_index >= node.child_count
														):
															valid = False
														else:
															expression_ordinal_owners = expression_ordinal_owners.set(
																part.payload_index,
																expression_ordinal_owners
																	.get(part.payload_index)
																	.get_or(0) + 1,
															)
											None:
												valid = False

										part_offset += 1

									for owners in expression_ordinal_owners:
										valid = valid and owners == 1
								None:
									valid = False
						CompactAscriptionNode | CompactOpaqueIntoNode | CompactOpaqueFromNode:
							if (
								node.payload_index < 0
								or node.payload_index >= rep.type_nodes.length()
							):
								valid = False
							else if (
								type_root_membership
									.get(node.payload_index)
									.get_or(False)
							):
								valid = False
							else:
								type_root_membership = type_root_membership.set(
									node.payload_index,
									True,
								)
						CompactRangeNode:
							if node.payload_index != NO_COMPACT_PAYLOAD_INDEX:
								valid = False
						CompactBlockNode | CompactSubscriptAssignNode | CompactIfNode | CompactDebugBlockNode | CompactWhileNode:
							if node.payload_index != NO_COMPACT_PAYLOAD_INDEX:
								valid = False
						CompactImmutableVarDeclNode | CompactMutableVarDeclNode | CompactQuestionBindNode:
							match rep.typed_binders.get(node.payload_index):
								Some(payload):
									if (
										payload.identifier_index < 0
										or payload.identifier_index >= rep.control_identifiers.length()
									):
										valid = False
									else:
										typed_binder_owners = typed_binder_owners.set(
											node.payload_index,
											typed_binder_owners
												.get(node.payload_index)
												.get_or(0) + 1,
										)
										control_identifier_owners = control_identifier_owners.set(
											payload.identifier_index,
											control_identifier_owners
												.get(payload.identifier_index)
												.get_or(0) + 1,
										)

									if payload.type_root_index != NO_COMPACT_TYPE_ROOT_INDEX:
										if (
											payload.type_root_index < 0
											or payload.type_root_index >= rep.type_nodes.length()
											or type_root_membership
												.get(payload.type_root_index)
												.get_or(False)
										):
											valid = False
										else:
											type_root_membership = type_root_membership.set(
												payload.type_root_index,
												True,
											)
								None:
									valid = False
						CompactAssignNode | CompactCompoundAddAssignNode | CompactCompoundSubtractAssignNode | CompactCompoundMultiplyAssignNode | CompactCompoundDivideAssignNode | CompactForNameNode:
							if (
								node.payload_index < 0
								or node.payload_index >= rep.control_identifiers.length()
							):
								valid = False
							else:
								control_identifier_owners = control_identifier_owners.set(
									node.payload_index,
									control_identifier_owners
										.get(node.payload_index)
										.get_or(0) + 1,
								)
						CompactTupleDestructNode | CompactForTupleNode:
							match rep.identifier_slices.get(node.payload_index):
								Some(payload):
									if (
										not compact_metadata_slice_is_valid(
											payload.identifier_start,
											payload.identifier_count,
											rep.control_identifiers.length(),
										)
										or not compact_source_span_is_valid(
											rep.source_owners,
											payload.span,
										)
									):
										valid = False
									else:
										identifier_slice_owners = identifier_slice_owners.set(
											node.payload_index,
											identifier_slice_owners
												.get(node.payload_index)
												.get_or(0) + 1,
										)
										var identifier_offset: Int = 0

										while identifier_offset < payload.identifier_count:
											identifier_index = payload.identifier_start + identifier_offset
											control_identifier_owners = control_identifier_owners.set(
												identifier_index,
												control_identifier_owners
													.get(identifier_index)
													.get_or(0) + 1,
											)
											identifier_offset += 1
								None:
									valid = False
						CompactBreakNode | CompactContinueNode | CompactVoidNode | CompactUnnamedBuiltinNode | CompactMissingNode:
							match rep.unit_payloads.get(node.payload_index):
								Some(payload):
									if compact_unit_matches_node(node.kind, payload.kind):
										unit_owners = unit_owners.set(
											node.payload_index,
											unit_owners
												.get(node.payload_index)
												.get_or(0) + 1,
										)
									else:
										valid = False
								None:
									valid = False
				None:
					valid = False

			node_index += 1

		var type_node_index: Int = 0

		while type_node_index < rep.type_nodes.length() and valid:
			match rep.type_nodes.get(type_node_index):
				Some(node):
					if not compact_source_span_is_valid(rep.source_owners, node.span):
						valid = False

					if (
						node.child_start < 0
						or node.child_count < 0
						or node.child_start > rep.type_children.length()
						or node.child_count > rep.type_children.length() - node.child_start
					):
						valid = False

					match compact_type_exact_child_count(node.kind):
						Some(expected):
							if node.child_count != expected:
								valid = False
						None:
							match node.kind:
								CompactNamedTypeNode | CompactQualifiedNamedTypeNode | CompactTupleTypeNode:
									void
								CompactPureFunctionTypeNode | CompactImpureFunctionTypeNode | CompactArrayTypeNode:
									if node.child_count < 1:
										valid = False
								_:
									valid = False

					var child_offset: Int = 0

					while child_offset < node.child_count and valid:
						child_slot = node.child_start + child_offset

						match rep.type_children.get(child_slot):
							Some(child):
								if child < 0 or child >= type_node_index:
									valid = False
								else:
									type_parent_count = type_parent_count.set(
										child,
										type_parent_count
											.get(child)
											.get_or(0) + 1,
									)
									type_child_slot_owners = type_child_slot_owners.set(
										child_slot,
										type_child_slot_owners
											.get(child_slot)
											.get_or(0) + 1,
									)
							None:
								valid = False

						child_offset += 1

					if compact_type_uses_identifier_slice(node.kind):
						match rep.type_identifier_slices.get(node.payload_index):
							Some(payload):
								if (
									not compact_metadata_slice_is_valid(
										payload.identifier_start,
										payload.identifier_count,
										rep.type_identifiers.length(),
									)
									or not compact_type_identifier_count_is_valid(
										node.kind,
										payload.identifier_count,
									)
								):
									valid = False
								else:
									type_identifier_slice_owners = type_identifier_slice_owners.set(
										node.payload_index,
										type_identifier_slice_owners
											.get(node.payload_index)
											.get_or(0) + 1,
									)
									var identifier_offset: Int = 0

									while identifier_offset < payload.identifier_count and valid:
										identifier_slot = payload.identifier_start + identifier_offset

										match rep.type_identifiers.get(identifier_slot):
											Some(identifier):
												if (
													not compact_source_span_is_valid(
														rep.source_owners,
														identifier.span,
													)
													or identifier.text_index < 0
													or identifier.text_index >= rep.texts.length()
												):
													valid = False
												else:
													type_identifier_owners = type_identifier_owners.set(
														identifier_slot,
														type_identifier_owners
															.get(identifier_slot)
															.get_or(0) + 1,
													)
													owned_text_indices = owned_text_indices.set(
														identifier.text_index,
														owned_text_indices
															.get(identifier.text_index)
															.get_or(0) + 1,
													)
											None:
												valid = False

										identifier_offset += 1
							None:
								valid = False
					else if node.kind == CompactDimLiteralTypeNode:
						if node.payload_index < 0 or node.payload_index >= rep.texts.length():
							valid = False
						else:
							owned_text_indices = owned_text_indices.set(
								node.payload_index,
								owned_text_indices
									.get(node.payload_index)
									.get_or(0) + 1,
							)
					else if node.payload_index != NO_COMPACT_PAYLOAD_INDEX:
						valid = False
				None:
					valid = False

			type_node_index += 1

		var control_identifier_index: Int = 0

		while control_identifier_index < rep.control_identifiers.length() and valid:
			match rep.control_identifiers.get(control_identifier_index):
				Some(identifier):
					if (
						not compact_source_span_is_valid(rep.source_owners, identifier.span)
						or identifier.text_index < 0
						or identifier.text_index >= rep.texts.length()
					):
						valid = False
					else:
						owned_text_indices = owned_text_indices.set(
							identifier.text_index,
							owned_text_indices
								.get(identifier.text_index)
								.get_or(0) + 1,
						)
				None:
					valid = False

			control_identifier_index += 1

		if valid:
			var index: Int = 0

			while index < rep.nodes.length() and valid:
				parents = parent_count
					.get(index)
					.get_or(-1)
				is_root = root_membership
					.get(index)
					.get_or(False)
				valid = is_root and parents == 0 or not is_root and parents == 1
				index += 1

			var type_index: Int = 0

			while type_index < rep.type_nodes.length() and valid:
				parents = type_parent_count
					.get(type_index)
					.get_or(-1)
				is_root = type_root_membership
					.get(type_index)
					.get_or(False)
				valid = is_root and parents == 0 or not is_root and parents == 1
				type_index += 1

		if valid:
			for owners in child_slot_owners:
				valid = valid and owners == 1

			for owners in owned_text_indices:
				valid = valid and owners == 1

			for owners in text_owners:
				valid = valid and owners == 1

			for owners in string_owners:
				valid = valid and owners == 1

			for owners in interpolation_owners:
				valid = valid and owners == 1

			for owners in bool_owners:
				valid = valid and owners == 1

			for owners in char_owners:
				valid = valid and owners == 1

			for owners in operator_owners:
				valid = valid and owners == 1

			for owners in call_owners:
				valid = valid and owners == 1

			for owners in field_access_owners:
				valid = valid and owners == 1

			for owners in record_owners:
				valid = valid and owners == 1

			for owners in record_field_slot_owners:
				valid = valid and owners == 1

			for owners in dict_owners:
				valid = valid and owners == 1

			for owners in dict_entry_slot_owners:
				valid = valid and owners == 1

			for owners in type_child_slot_owners:
				valid = valid and owners == 1

			for owners in type_identifier_slice_owners:
				valid = valid and owners == 1

			for owners in type_identifier_owners:
				valid = valid and owners == 1

			for owners in interpolation_parts_payload_owners:
				valid = valid and owners == 1

			for owners in interpolation_part_slot_owners:
				valid = valid and owners == 1

			for owners in control_identifier_owners:
				valid = valid and owners == 1

			for owners in identifier_slice_owners:
				valid = valid and owners == 1

			for owners in typed_binder_owners:
				valid = valid and owners == 1

			for owners in unit_owners:
				valid = valid and owners == 1

		valid


pure func compact_expression_oracle_from_parsed_roots(
	source: SourceFile,
	roots: List[ParsedExpr],
) -> Result[ValidatedExpressionProduct, CompactExpressionOracleError]:
	-- All growing buffers belong to this one pure driver. No helper accepts or
	-- returns a builder record.
	var nodes: List[CompactExpressionNodeRow] = []
	var children: List[Int] = []
	var texts: List[String] = []
	var text_payloads: List[CompactTextPayloadRow] = []
	var string_payloads: List[CompactStringPayloadRow] = []
	var interpolation_payloads: List[CompactInterpolationPayloadRow] = []
	var bool_payloads: List[CompactBoolPayloadRow] = []
	var char_payloads: List[CompactCharPayloadRow] = []
	var operator_payloads: List[CompactOperatorPayloadRow] = []
	var call_payloads: List[CompactCallPayloadRow] = []
	var field_access_payloads: List[CompactFieldAccessPayloadRow] = []
	var record_payloads: List[CompactRecordPayloadRow] = []
	var record_fields: List[CompactRecordFieldRow] = []
	var dict_payloads: List[CompactDictPayloadRow] = []
	var dict_entries: List[CompactDictEntryRow] = []
	var type_nodes: List[CompactTypeNodeRow] = []
	var type_children: List[Int] = []
	var type_identifier_slices: List[CompactTypeIdentifierSliceRow] = []
	var type_identifiers: List[CompactTypeIdentifierRow] = []
	var interpolation_parts_payloads: List[CompactInterpolationPartsPayloadRow] = []
	var interpolation_parts: List[CompactInterpolationPartRow] = []
	var control_identifiers: List[CompactControlIdentifierRow] = []
	var identifier_slices: List[CompactIdentifierSliceRow] = []
	var typed_binders: List[CompactTypedBinderRow] = []
	var unit_payloads: List[CompactUnitPayloadRow] = []
	var actions: List[CompactBuildAction] = []
	var values: List[Int] = []
	var type_values: List[Int] = []
	var supported = True

	var root_index = roots.length() - 1

	while root_index >= 0:
		match roots.get(root_index):
			Some(root):
				actions = actions.append(CompactBuildVisit(root))
			None:
				supported = False

		root_index -= 1

	while not actions.is_empty() and supported:
		action_index = actions.length() - 1
		action = actions.get(action_index)
		actions = actions.take(action_index)

		match action:
			Some(CompactBuildVisit(expr)):
				match expr:
					ParsedNameExpr(name):
						text_index = texts.length()
						texts = texts.append(name.text)
						payload_index = text_payloads.length()
						text_payloads = text_payloads.append({text_index = text_index})
						node_index = nodes.length()
						nodes = nodes.append({
							kind = CompactNameNode,
							payload_index = payload_index,
							child_start = children.length(),
							child_count = 0,
							span = compact_source_location(name.span),
						})
						values = values.append(node_index)
					ParsedIntLiteralExpr(text, span):
						text_index = texts.length()
						texts = texts.append(text)
						payload_index = text_payloads.length()
						text_payloads = text_payloads.append({text_index = text_index})
						node_index = nodes.length()
						nodes = nodes.append({
							kind = CompactIntNode,
							payload_index = payload_index,
							child_start = children.length(),
							child_count = 0,
							span = compact_source_location(span),
						})
						values = values.append(node_index)
					ParsedFloatLiteralExpr(text, span):
						text_index = texts.length()
						texts = texts.append(text)
						payload_index = text_payloads.length()
						text_payloads = text_payloads.append({text_index = text_index})
						node_index = nodes.length()
						nodes = nodes.append({
							kind = CompactFloatNode,
							payload_index = payload_index,
							child_start = children.length(),
							child_count = 0,
							span = compact_source_location(span),
						})
						values = values.append(node_index)
					ParsedStringLiteralExpr(text, form, span):
						text_index = texts.length()
						texts = texts.append(text)
						payload_index = string_payloads.length()
						string_payloads = string_payloads.append({
							text_index = text_index,
							form = form,
						})
						node_index = nodes.length()
						nodes = nodes.append({
							kind = CompactStringNode,
							payload_index = payload_index,
							child_start = children.length(),
							child_count = 0,
							span = compact_source_location(span),
						})
						values = values.append(node_index)
					ParsedStringInterpolationExpr(text, is_multiline, span):
						text_index = texts.length()
						texts = texts.append(text)
						payload_index = interpolation_payloads.length()
						interpolation_payloads = interpolation_payloads.append({
							text_index = text_index,
							is_multiline = is_multiline,
						})
						node_index = nodes.length()
						nodes = nodes.append({
							kind = CompactInterpolationNode,
							payload_index = payload_index,
							child_start = children.length(),
							child_count = 0,
							span = compact_source_location(span),
						})
						values = values.append(node_index)
					ParsedBoolLiteralExpr(value, span):
						payload_index = bool_payloads.length()
						bool_payloads = bool_payloads.append({value = value})
						node_index = nodes.length()
						nodes = nodes.append({
							kind = CompactBoolNode,
							payload_index = payload_index,
							child_start = children.length(),
							child_count = 0,
							span = compact_source_location(span),
						})
						values = values.append(node_index)
					ParsedCharLiteralExpr(value, span):
						payload_index = char_payloads.length()
						char_payloads = char_payloads.append({value = value})
						node_index = nodes.length()
						nodes = nodes.append({
							kind = CompactCharNode,
							payload_index = payload_index,
							child_start = children.length(),
							child_count = 0,
							span = compact_source_location(span),
						})
						values = values.append(node_index)
					ParsedUnaryExpr(op, value, span):
						actions = actions
							.append(CompactBuildUnary(op, span))
							.append(CompactBuildVisit(value))
					ParsedBinaryExpr(op, left, right, span):
						actions = actions
							.append(CompactBuildBinary(op, span))
							.append(CompactBuildVisit(right))
							.append(CompactBuildVisit(left))
					ParsedLogicalExpr(op, left, right, span):
						actions = actions
							.append(CompactBuildLogical(op, span))
							.append(CompactBuildVisit(right))
							.append(CompactBuildVisit(left))
					ParsedAscriptionExpr(value, type_expr, span):
						actions = actions
							.append(CompactBuildTypedWrapper(CompactAscriptionNode, span))
							.append(CompactBuildTypeVisit(type_expr))
							.append(CompactBuildVisit(value))
					ParsedRangeExpr(start, finish, span):
						actions = actions
							.append(CompactBuildRange(span))
							.append(CompactBuildVisit(finish))
							.append(CompactBuildVisit(start))
					ParsedCallExpr(callee, args, span):
						actions = actions.append(CompactBuildCall(args.length(), span))
						var arg_index = args.length() - 1

						while arg_index >= 0:
							match args.get(arg_index):
								Some(arg):
									actions = actions.append(CompactBuildVisit(arg))
								None:
									supported = False

							arg_index -= 1

						actions = actions.append(CompactBuildVisit(callee))
					ParsedFieldAccessExpr(target, field, span):
						actions = actions
							.append(CompactBuildFieldAccess(field, span))
							.append(CompactBuildVisit(target))
					ParsedSubscriptExpr(target, indices, span):
						actions = actions.append(CompactBuildSubscript(indices.length(), span))
						var index = indices.length() - 1

						while index >= 0:
							match indices.get(index):
								Some(value):
									actions = actions.append(CompactBuildVisit(value))
								None:
									supported = False

							index -= 1

						actions = actions.append(CompactBuildVisit(target))
					ParsedListExpr(items, span):
						actions = actions.append(
							CompactBuildSequence(
								CompactListNode,
								items.length(),
								span,
							),
						)
						var index = items.length() - 1

						while index >= 0:
							match items.get(index):
								Some(value):
									actions = actions.append(CompactBuildVisit(value))
								None:
									supported = False

							index -= 1
					ParsedTupleExpr(items, span):
						actions = actions.append(
							CompactBuildSequence(
								CompactTupleNode,
								items.length(),
								span,
							),
						)
						var index = items.length() - 1

						while index >= 0:
							match items.get(index):
								Some(value):
									actions = actions.append(CompactBuildVisit(value))
								None:
									supported = False

							index -= 1
					ParsedRecordExpr(fields, span):
						actions = actions.append(CompactBuildRecord(fields, False, span))
						var index = fields.length() - 1

						while index >= 0:
							match fields.get(index):
								Some(field):
									actions = actions.append(CompactBuildVisit(field.value))
								None:
									supported = False

							index -= 1
					ParsedRecordUpdateExpr(base, fields, span):
						actions = actions.append(CompactBuildRecord(fields, True, span))
						var index = fields.length() - 1

						while index >= 0:
							match fields.get(index):
								Some(field):
									actions = actions.append(CompactBuildVisit(field.value))
								None:
									supported = False

							index -= 1

						actions = actions.append(CompactBuildVisit(base))
					ParsedDictExpr(entries, span):
						actions = actions.append(CompactBuildDict(entries, span))
						var index = entries.length() - 1

						while index >= 0:
							match entries.get(index):
								Some(entry):
									actions = actions
										.append(CompactBuildVisit(entry.value))
										.append(CompactBuildVisit(entry.key))
								None:
									supported = False

							index -= 1
					ParsedVectorExpr(items, span):
						actions = actions.append(
							CompactBuildSequence(
								CompactVectorNode,
								items.length(),
								span,
							),
						)
						var index = items.length() - 1

						while index >= 0:
							match items.get(index):
								Some(value):
									actions = actions.append(CompactBuildVisit(value))
								None:
									supported = False

							index -= 1
					ParsedOpaqueIntoExpr(type_expr, value, span):
						actions = actions
							.append(CompactBuildTypedWrapper(CompactOpaqueIntoNode, span))
							.append(CompactBuildTypeVisit(type_expr))
							.append(CompactBuildVisit(value))
					ParsedOpaqueFromExpr(type_expr, value, span):
						actions = actions
							.append(CompactBuildTypedWrapper(CompactOpaqueFromNode, span))
							.append(CompactBuildTypeVisit(type_expr))
							.append(CompactBuildVisit(value))
					ParsedStringInterpolationPartsExpr(parts, is_multiline, span):
						actions = actions.append(
							CompactBuildInterpolationParts(
								parts,
								is_multiline,
								span,
							),
						)
						var part_index = parts.length() - 1

						while part_index >= 0:
							match parts.get(part_index):
								Some(ParsedInterpolationExpr(value)):
									actions = actions.append(CompactBuildVisit(value))
								Some(ParsedInterpolationLiteral(_)):
									void
								None:
									supported = False

							part_index -= 1
					ParsedBlockExpr(items, span):
						actions = actions.append(
							CompactBuildSequence(
								CompactBlockNode,
								items.length(),
								span,
							),
						)
						var index = items.length() - 1

						while index >= 0:
							match items.get(index):
								Some(item):
									actions = actions.append(CompactBuildVisit(item))
								None:
									supported = False

							index -= 1
					ParsedVarDeclExpr(name, type_expr, value, is_mutable, span):
						kind = if is_mutable:
							CompactMutableVarDeclNode
						else:
							CompactImmutableVarDeclNode

						match type_expr:
							Some(value_type):
								actions = actions
									.append(CompactBuildTypedBinder(kind, name, True, span))
									.append(CompactBuildTypeVisit(value_type))
									.append(CompactBuildVisit(value))
							None:
								actions = actions
									.append(CompactBuildTypedBinder(kind, name, False, span))
									.append(CompactBuildVisit(value))
					ParsedAssignExpr(name, value, span):
						actions = actions
							.append(CompactBuildIdentifier(CompactAssignNode, name, 1, span))
							.append(CompactBuildVisit(value))
					ParsedCompoundAssignExpr(name, op, value, span):
						actions = actions
							.append(
								CompactBuildIdentifier(
									compact_compound_assign_kind(op),
									name,
									1,
									span,
								),
							)
							.append(CompactBuildVisit(value))
					ParsedSubscriptAssignExpr(target, indices, value, span):
						actions = actions
							.append(
								CompactBuildSequence(
									CompactSubscriptAssignNode,
									indices.length() + 2,
									span,
								),
							)
							.append(CompactBuildVisit(value))
						var index = indices.length() - 1

						while index >= 0:
							match indices.get(index):
								Some(item):
									actions = actions.append(CompactBuildVisit(item))
								None:
									supported = False

							index -= 1

						actions = actions.append(CompactBuildVisit(target))
					ParsedTupleDestructExpr(names, value, span):
						actions = actions
							.append(
								CompactBuildIdentifierSlice(
									CompactTupleDestructNode,
									names,
									1,
									span,
									span,
								),
							)
							.append(CompactBuildVisit(value))
					ParsedQuestionBindExpr(name, type_expr, value, span):
						match type_expr:
							Some(value_type):
								actions = actions
									.append(
										CompactBuildTypedBinder(
											CompactQuestionBindNode,
											name,
											True,
											span,
										),
									)
									.append(CompactBuildTypeVisit(value_type))
									.append(CompactBuildVisit(value))
							None:
								actions = actions
									.append(
										CompactBuildTypedBinder(
											CompactQuestionBindNode,
											name,
											False,
											span,
										),
									)
									.append(CompactBuildVisit(value))
					ParsedIfExpr(condition, then_expr, else_expr, span):
						child_count = if else_expr.is_some():
							3
						else:
							2

						actions = actions.append(
							CompactBuildSequence(
								CompactIfNode,
								child_count,
								span,
							),
						)

						match else_expr:
							Some(value):
								actions = actions.append(CompactBuildVisit(value))
							None:
								void

						actions = actions
							.append(CompactBuildVisit(then_expr))
							.append(CompactBuildVisit(condition))
					ParsedDebugBlockExpr(body, span):
						actions = actions
							.append(CompactBuildSequence(CompactDebugBlockNode, 1, span))
							.append(CompactBuildVisit(body))
					ParsedWhileExpr(condition, body, span):
						actions = actions
							.append(CompactBuildSequence(CompactWhileNode, 2, span))
							.append(CompactBuildVisit(body))
							.append(CompactBuildVisit(condition))
					ParsedForExpr(binder, iterable, body, span):
						match binder:
							ParsedForNameBinder(name):
								actions = actions.append(
									CompactBuildIdentifier(
										CompactForNameNode,
										name,
										2,
										span,
									),
								)
							ParsedForTupleBinder(names, binder_span):
								actions = actions.append(
									CompactBuildIdentifierSlice(
										CompactForTupleNode,
										names,
										2,
										binder_span,
										span,
									),
								)

						actions = actions
							.append(CompactBuildVisit(body))
							.append(CompactBuildVisit(iterable))
					ParsedBreakExpr(span):
						payload_index = unit_payloads.length()
						unit_payloads = unit_payloads.append({kind = CompactBreakPayload})
						node_index = nodes.length()
						nodes = nodes.append({
							kind = CompactBreakNode,
							payload_index = payload_index,
							child_start = children.length(),
							child_count = 0,
							span = compact_source_location(span),
						})
						values = values.append(node_index)
					ParsedContinueExpr(span):
						payload_index = unit_payloads.length()
						unit_payloads = unit_payloads.append({kind = CompactContinuePayload})
						node_index = nodes.length()
						nodes = nodes.append({
							kind = CompactContinueNode,
							payload_index = payload_index,
							child_start = children.length(),
							child_count = 0,
							span = compact_source_location(span),
						})
						values = values.append(node_index)
					ParsedVoidExpr(span):
						payload_index = unit_payloads.length()
						unit_payloads = unit_payloads.append({kind = CompactVoidPayload})
						node_index = nodes.length()
						nodes = nodes.append({
							kind = CompactVoidNode,
							payload_index = payload_index,
							child_start = children.length(),
							child_count = 0,
							span = compact_source_location(span),
						})
						values = values.append(node_index)
					ParsedBuiltinExpr(name, span):
						match name:
							Some(text):
								text_index = texts.length()
								texts = texts.append(text)
								payload_index = text_payloads.length()
								text_payloads = text_payloads.append({text_index = text_index})
								node_index = nodes.length()
								nodes = nodes.append({
									kind = CompactNamedBuiltinNode,
									payload_index = payload_index,
									child_start = children.length(),
									child_count = 0,
									span = compact_source_location(span),
								})
								values = values.append(node_index)
							None:
								payload_index = unit_payloads.length()
								unit_payloads = unit_payloads.append(
									{kind = CompactUnnamedBuiltinPayload},
								)
								node_index = nodes.length()
								nodes = nodes.append({
									kind = CompactUnnamedBuiltinNode,
									payload_index = payload_index,
									child_start = children.length(),
									child_count = 0,
									span = compact_source_location(span),
								})
								values = values.append(node_index)
					ParsedMissingExpr(span):
						payload_index = unit_payloads.length()
						unit_payloads = unit_payloads.append({kind = CompactMissingPayload})
						node_index = nodes.length()
						nodes = nodes.append({
							kind = CompactMissingNode,
							payload_index = payload_index,
							child_start = children.length(),
							child_count = 0,
							span = compact_source_location(span),
						})
						values = values.append(node_index)
					_:
						supported = False
			Some(CompactBuildTypeVisit(type_expr)):
				match type_expr:
					ParsedNamedType(name, args, span):
						actions = actions.append(
							CompactBuildTypeIdentifiers(
								CompactNamedTypeNode,
								[name],
								args.length(),
								span,
							),
						)
						var index = args.length() - 1

						while index >= 0:
							match args.get(index):
								Some(arg):
									actions = actions.append(CompactBuildTypeVisit(arg))
								None:
									supported = False

							index -= 1
					ParsedQualifiedNamedType(qualifier, name, args, span):
						actions = actions.append(
							CompactBuildTypeIdentifiers(
								CompactQualifiedNamedTypeNode,
								[qualifier, name],
								args.length(),
								span,
							),
						)
						var index = args.length() - 1

						while index >= 0:
							match args.get(index):
								Some(arg):
									actions = actions.append(CompactBuildTypeVisit(arg))
								None:
									supported = False

							index -= 1
					ParsedBoundedType(name, bounds, span):
						actions = actions.append(
							CompactBuildTypeIdentifiers(
								CompactBoundedTypeNode,
								[name].concat(bounds),
								0,
								span,
							),
						)
					ParsedDimNameType(name, is_splat, span):
						kind = if is_splat:
							CompactDimSplatNameTypeNode
						else:
							CompactDimNameTypeNode

						actions = actions.append(CompactBuildTypeIdentifiers(kind, [name], 0, span))
					ParsedDimLiteralType(text, span):
						actions = actions.append(
							CompactBuildTypeText(
								CompactDimLiteralTypeNode,
								text,
								span,
							),
						)
					ParsedDimBinaryType(op, left, right, span):
						actions = actions
							.append(CompactBuildTypeNoPayload(compact_dim_binary_kind(op), 2, span))
							.append(CompactBuildTypeVisit(right))
							.append(CompactBuildTypeVisit(left))
					ParsedRangeType(value, span):
						actions = actions
							.append(CompactBuildTypeNoPayload(CompactRangeTypeNode, 1, span))
							.append(CompactBuildTypeVisit(value))
					ParsedTupleType(fields, span):
						actions = actions.append(
							CompactBuildTypeNoPayload(
								CompactTupleTypeNode,
								fields.length(),
								span,
							),
						)
						var index = fields.length() - 1

						while index >= 0:
							match fields.get(index):
								Some(field):
									actions = actions.append(CompactBuildTypeVisit(field))
								None:
									supported = False

							index -= 1
					ParsedFunctionType(is_pure, params, result, span):
						kind = if is_pure:
							CompactPureFunctionTypeNode
						else:
							CompactImpureFunctionTypeNode

						actions = actions
							.append(CompactBuildTypeNoPayload(kind, params.length() + 1, span))
							.append(CompactBuildTypeVisit(result))
						var index = params.length() - 1

						while index >= 0:
							match params.get(index):
								Some(param):
									actions = actions.append(CompactBuildTypeVisit(param))
								None:
									supported = False

							index -= 1
					ParsedArrayType(element, dimensions, span):
						actions = actions.append(
							CompactBuildTypeNoPayload(
								CompactArrayTypeNode,
								dimensions.length() + 1,
								span,
							),
						)
						var index = dimensions.length() - 1

						while index >= 0:
							match dimensions.get(index):
								Some(dimension):
									actions = actions.append(CompactBuildTypeVisit(dimension))
								None:
									supported = False

							index -= 1

						actions = actions.append(CompactBuildTypeVisit(element))
					ParsedMissingType(span):
						actions = actions.append(
							CompactBuildTypeNoPayload(
								CompactMissingTypeNode,
								0,
								span,
							),
						)
			Some(CompactBuildUnary(op, span)):
				if values.is_empty():
					supported = False
				else:
					value_start = values.length() - 1
					child_start = children.length()
					children = children.append(
						values
							.get(value_start)
							.get_or(-1),
					)
					values = values.take(value_start)
					payload_index = operator_payloads.length()
					operator_payloads = operator_payloads.append(
						{operator = compact_unary_operator(op)},
					)
					node_index = nodes.length()
					nodes = nodes.append({
						kind = CompactUnaryNode,
						payload_index = payload_index,
						child_start = child_start,
						child_count = 1,
						span = compact_source_location(span),
					})
					values = values.append(node_index)
			Some(CompactBuildBinary(op, span)):
				if values.length() < 2:
					supported = False
				else:
					value_start = values.length() - 2
					child_start = children.length()
					children = children
						.append(
							values
								.get(value_start)
								.get_or(-1),
						)
						.append(
							values
								.get(value_start + 1)
								.get_or(-1),
						)
					values = values.take(value_start)
					payload_index = operator_payloads.length()
					operator_payloads = operator_payloads.append(
						{operator = compact_binary_operator(op)},
					)
					node_index = nodes.length()
					nodes = nodes.append({
						kind = CompactBinaryNode,
						payload_index = payload_index,
						child_start = child_start,
						child_count = 2,
						span = compact_source_location(span),
					})
					values = values.append(node_index)
			Some(CompactBuildLogical(op, span)):
				if values.length() < 2:
					supported = False
				else:
					value_start = values.length() - 2
					child_start = children.length()
					children = children
						.append(
							values
								.get(value_start)
								.get_or(-1),
						)
						.append(
							values
								.get(value_start + 1)
								.get_or(-1),
						)
					values = values.take(value_start)
					payload_index = operator_payloads.length()
					operator_payloads = operator_payloads.append(
						{operator = compact_logical_operator(op)},
					)
					node_index = nodes.length()
					nodes = nodes.append({
						kind = CompactLogicalNode,
						payload_index = payload_index,
						child_start = child_start,
						child_count = 2,
						span = compact_source_location(span),
					})
					values = values.append(node_index)
			Some(CompactBuildCall(argument_count, span)):
				child_count = argument_count + 1

				if values.length() < child_count:
					supported = False
				else:
					value_start = values.length() - child_count
					child_start = children.length()
					var value_index = value_start

					while value_index < values.length():
						children = children.append(
							values
								.get(value_index)
								.get_or(-1),
						)
						value_index += 1

					values = values.take(value_start)
					payload_index = call_payloads.length()
					call_payloads = call_payloads.append({argument_count = argument_count})
					node_index = nodes.length()
					nodes = nodes.append({
						kind = CompactCallNode,
						payload_index = payload_index,
						child_start = child_start,
						child_count = child_count,
						span = compact_source_location(span),
					})
					values = values.append(node_index)
			Some(CompactBuildFieldAccess(field, span)):
				if values.is_empty():
					supported = False
				else:
					value_start = values.length() - 1
					child_start = children.length()
					children = children.append(
						values
							.get(value_start)
							.get_or(-1),
					)
					values = values.take(value_start)
					text_index = texts.length()
					texts = texts.append(field.text)
					payload_index = field_access_payloads.length()
					field_access_payloads = field_access_payloads.append({
						field_text_index = text_index,
						field_span = compact_source_location(field.span),
					})
					node_index = nodes.length()
					nodes = nodes.append({
						kind = CompactFieldAccessNode,
						payload_index = payload_index,
						child_start = child_start,
						child_count = 1,
						span = compact_source_location(span),
					})
					values = values.append(node_index)
			Some(CompactBuildSubscript(index_count, span)):
				child_count = index_count + 1

				if index_count < 0 or values.length() < child_count:
					supported = False
				else:
					value_start = values.length() - child_count
					child_start = children.length()
					var value_index = value_start

					while value_index < values.length():
						children = children.append(
							values
								.get(value_index)
								.get_or(-1),
						)
						value_index += 1

					values = values.take(value_start)
					node_index = nodes.length()
					nodes = nodes.append({
						kind = CompactSubscriptNode,
						payload_index = NO_COMPACT_PAYLOAD_INDEX,
						child_start = child_start,
						child_count = child_count,
						span = compact_source_location(span),
					})
					values = values.append(node_index)
			Some(CompactBuildSequence(kind, item_count, span)):
				if item_count < 0 or values.length() < item_count:
					supported = False
				else:
					value_start = values.length() - item_count
					child_start = children.length()
					var value_index = value_start

					while value_index < values.length():
						children = children.append(
							values
								.get(value_index)
								.get_or(-1),
						)
						value_index += 1

					values = values.take(value_start)
					node_index = nodes.length()
					nodes = nodes.append({
						kind = kind,
						payload_index = NO_COMPACT_PAYLOAD_INDEX,
						child_start = child_start,
						child_count = item_count,
						span = compact_source_location(span),
					})
					values = values.append(node_index)
			Some(CompactBuildRecord(fields, is_update, span)):
				var child_count = fields.length()

				if is_update:
					child_count += 1

				if values.length() < child_count:
					supported = False
				else:
					value_start = values.length() - child_count
					child_start = children.length()
					var value_index = value_start

					while value_index < values.length():
						children = children.append(
							values
								.get(value_index)
								.get_or(-1),
						)
						value_index += 1

					values = values.take(value_start)
					field_start = record_fields.length()

					for field in fields:
						text_index = texts.length()
						texts = texts.append(field.name.text)
						record_fields = record_fields.append({
							name_text_index = text_index,
							name_span = compact_source_location(field.name.span),
							field_span = compact_source_location(field.span),
						})

					payload_index = record_payloads.length()
					record_payloads = record_payloads.append({
						field_start = field_start,
						field_count = fields.length(),
					})
					var kind = CompactRecordNode

					if is_update:
						kind = CompactRecordUpdateNode

					node_index = nodes.length()
					nodes = nodes.append({
						kind = kind,
						payload_index = payload_index,
						child_start = child_start,
						child_count = child_count,
						span = compact_source_location(span),
					})
					values = values.append(node_index)
			Some(CompactBuildDict(entries, span)):
				child_count = entries.length() * 2

				if values.length() < child_count:
					supported = False
				else:
					value_start = values.length() - child_count
					child_start = children.length()
					var value_index = value_start

					while value_index < values.length():
						children = children.append(
							values
								.get(value_index)
								.get_or(-1),
						)
						value_index += 1

					values = values.take(value_start)
					entry_start = dict_entries.length()

					for entry in entries:
						dict_entries = dict_entries.append(
							{entry_span = compact_source_location(entry.span)},
						)

					payload_index = dict_payloads.length()
					dict_payloads = dict_payloads.append({
						entry_start = entry_start,
						entry_count = entries.length(),
					})
					node_index = nodes.length()
					nodes = nodes.append({
						kind = CompactDictNode,
						payload_index = payload_index,
						child_start = child_start,
						child_count = child_count,
						span = compact_source_location(span),
					})
					values = values.append(node_index)
			Some(CompactBuildTypedWrapper(kind, span)):
				if values.is_empty() or type_values.is_empty():
					supported = False
				else:
					value_start = values.length() - 1
					type_start = type_values.length() - 1
					child_start = children.length()
					children = children.append(
						values
							.get(value_start)
							.get_or(-1),
					)
					values = values.take(value_start)
					payload_index = type_values
						.get(type_start)
						.get_or(-1)
					type_values = type_values.take(type_start)
					node_index = nodes.length()
					nodes = nodes.append({
						kind = kind,
						payload_index = payload_index,
						child_start = child_start,
						child_count = 1,
						span = compact_source_location(span),
					})
					values = values.append(node_index)
			Some(CompactBuildRange(span)):
				if values.length() < 2:
					supported = False
				else:
					value_start = values.length() - 2
					child_start = children.length()
					children = children
						.append(
							values
								.get(value_start)
								.get_or(-1),
						)
						.append(
							values
								.get(value_start + 1)
								.get_or(-1),
						)
					values = values.take(value_start)
					node_index = nodes.length()
					nodes = nodes.append({
						kind = CompactRangeNode,
						payload_index = NO_COMPACT_PAYLOAD_INDEX,
						child_start = child_start,
						child_count = 2,
						span = compact_source_location(span),
					})
					values = values.append(node_index)
			Some(CompactBuildInterpolationParts(parts, is_multiline, span)):
				var expression_count: Int = 0

				for part in parts:
					match part:
						ParsedInterpolationExpr(_):
							expression_count += 1
						ParsedInterpolationLiteral(_):
							void

				if values.length() < expression_count:
					supported = False
				else:
					value_start = values.length() - expression_count
					child_start = children.length()
					var value_index = value_start

					while value_index < values.length():
						children = children.append(
							values
								.get(value_index)
								.get_or(-1),
						)
						value_index += 1

					values = values.take(value_start)
					part_start = interpolation_parts.length()
					var expression_ordinal: Int = 0

					for part in parts:
						match part:
							ParsedInterpolationLiteral(text):
								text_index = texts.length()
								texts = texts.append(text)
								interpolation_parts = interpolation_parts.append({
									kind = CompactInterpolationLiteralPart,
									payload_index = text_index,
								})
							ParsedInterpolationExpr(_):
								interpolation_parts = interpolation_parts.append({
									kind = CompactInterpolationExpressionPart,
									payload_index = expression_ordinal,
								})
								expression_ordinal += 1

					payload_index = interpolation_parts_payloads.length()
					interpolation_parts_payloads = interpolation_parts_payloads.append({
						part_start = part_start,
						part_count = parts.length(),
						is_multiline = is_multiline,
					})
					node_index = nodes.length()
					nodes = nodes.append({
						kind = CompactFinalizedInterpolationNode,
						payload_index = payload_index,
						child_start = child_start,
						child_count = expression_count,
						span = compact_source_location(span),
					})
					values = values.append(node_index)
			Some(CompactBuildTypedBinder(kind, identifier, has_type, span)):
				if values.is_empty() or has_type and type_values.is_empty():
					supported = False
				else:
					value_start = values.length() - 1
					child_start = children.length()
					children = children.append(
						values
							.get(value_start)
							.get_or(-1),
					)
					values = values.take(value_start)

					type_root_index = if has_type:
						type_value_start = type_values.length() - 1
						root = type_values
							.get(type_value_start)
							.get_or(-1)
						type_values = type_values.take(type_value_start)
						root
					else:
						NO_COMPACT_TYPE_ROOT_INDEX

					text_index = texts.length()
					texts = texts.append(identifier.text)
					identifier_index = control_identifiers.length()
					control_identifiers = control_identifiers.append({
						text_index = text_index,
						span = compact_source_location(identifier.span),
					})
					payload_index = typed_binders.length()
					typed_binders = typed_binders.append({
						identifier_index = identifier_index,
						type_root_index = type_root_index,
					})
					node_index = nodes.length()
					nodes = nodes.append({
						kind = kind,
						payload_index = payload_index,
						child_start = child_start,
						child_count = 1,
						span = compact_source_location(span),
					})
					values = values.append(node_index)
			Some(CompactBuildIdentifier(kind, identifier, child_count, span)):
				if values.length() < child_count:
					supported = False
				else:
					value_start = values.length() - child_count
					child_start = children.length()
					var value_index = value_start

					while value_index < values.length():
						children = children.append(
							values
								.get(value_index)
								.get_or(-1),
						)
						value_index += 1

					values = values.take(value_start)
					text_index = texts.length()
					texts = texts.append(identifier.text)
					identifier_index = control_identifiers.length()
					control_identifiers = control_identifiers.append({
						text_index = text_index,
						span = compact_source_location(identifier.span),
					})
					node_index = nodes.length()
					nodes = nodes.append({
						kind = kind,
						payload_index = identifier_index,
						child_start = child_start,
						child_count = child_count,
						span = compact_source_location(span),
					})
					values = values.append(node_index)
			Some(CompactBuildIdentifierSlice(kind, identifiers, child_count, identifier_span, span)):
				if values.length() < child_count:
					supported = False
				else:
					value_start = values.length() - child_count
					child_start = children.length()
					var value_index = value_start

					while value_index < values.length():
						children = children.append(
							values
								.get(value_index)
								.get_or(-1),
						)
						value_index += 1

					values = values.take(value_start)
					identifier_start = control_identifiers.length()

					for identifier in identifiers:
						text_index = texts.length()
						texts = texts.append(identifier.text)
						control_identifiers = control_identifiers.append({
							text_index = text_index,
							span = compact_source_location(identifier.span),
						})

					payload_index = identifier_slices.length()
					identifier_slices = identifier_slices.append({
						identifier_start = identifier_start,
						identifier_count = identifiers.length(),
						span = compact_source_location(identifier_span),
					})
					node_index = nodes.length()
					nodes = nodes.append({
						kind = kind,
						payload_index = payload_index,
						child_start = child_start,
						child_count = child_count,
						span = compact_source_location(span),
					})
					values = values.append(node_index)
			Some(CompactBuildTypeIdentifiers(kind, identifiers, child_count, span)):
				if type_values.length() < child_count:
					supported = False
				else:
					value_start = type_values.length() - child_count
					child_start = type_children.length()
					var value_index = value_start

					while value_index < type_values.length():
						type_children = type_children.append(
							type_values
								.get(value_index)
								.get_or(-1),
						)
						value_index += 1

					type_values = type_values.take(value_start)
					identifier_start = type_identifiers.length()

					for identifier in identifiers:
						text_index = texts.length()
						texts = texts.append(identifier.text)
						type_identifiers = type_identifiers.append({
							text_index = text_index,
							span = compact_source_location(identifier.span),
						})

					payload_index = type_identifier_slices.length()
					type_identifier_slices = type_identifier_slices.append({
						identifier_start = identifier_start,
						identifier_count = identifiers.length(),
					})
					type_node_index = type_nodes.length()
					type_nodes = type_nodes.append({
						kind = kind,
						payload_index = payload_index,
						child_start = child_start,
						child_count = child_count,
						span = compact_source_location(span),
					})
					type_values = type_values.append(type_node_index)
			Some(CompactBuildTypeText(kind, text, span)):
				text_index = texts.length()
				texts = texts.append(text)
				type_node_index = type_nodes.length()
				type_nodes = type_nodes.append({
					kind = kind,
					payload_index = text_index,
					child_start = type_children.length(),
					child_count = 0,
					span = compact_source_location(span),
				})
				type_values = type_values.append(type_node_index)
			Some(CompactBuildTypeNoPayload(kind, child_count, span)):
				if type_values.length() < child_count:
					supported = False
				else:
					value_start = type_values.length() - child_count
					child_start = type_children.length()
					var value_index = value_start

					while value_index < type_values.length():
						type_children = type_children.append(
							type_values
								.get(value_index)
								.get_or(-1),
						)
						value_index += 1

					type_values = type_values.take(value_start)
					type_node_index = type_nodes.length()
					type_nodes = type_nodes.append({
						kind = kind,
						payload_index = NO_COMPACT_PAYLOAD_INDEX,
						child_start = child_start,
						child_count = child_count,
						span = compact_source_location(span),
					})
					type_values = type_values.append(type_node_index)
			None:
				supported = False

	if (
		not supported
		or values.length() != roots.length()
		or not type_values.is_empty()
	):
		Err(UnsupportedCompactExpressionOracleForm)
	else:
		rep: CompactExpressionProductRep = {
			source_owners = [source],
			nodes = nodes,
			children = children,
			texts = texts,
			text_payloads = text_payloads,
			string_payloads = string_payloads,
			interpolation_payloads = interpolation_payloads,
			bool_payloads = bool_payloads,
			char_payloads = char_payloads,
			operator_payloads = operator_payloads,
			call_payloads = call_payloads,
			field_access_payloads = field_access_payloads,
			record_payloads = record_payloads,
			record_fields = record_fields,
			dict_payloads = dict_payloads,
			dict_entries = dict_entries,
			type_nodes = type_nodes,
			type_children = type_children,
			type_identifier_slices = type_identifier_slices,
			type_identifiers = type_identifiers,
			interpolation_parts_payloads = interpolation_parts_payloads,
			interpolation_parts = interpolation_parts,
			control_identifiers = control_identifiers,
			identifier_slices = identifier_slices,
			typed_binders = typed_binders,
			unit_payloads = unit_payloads,
			roots = values
		}

		if compact_expression_product_is_valid(rep):
			Ok(into_opaque ValidatedExpressionProduct(rep))
		else:
			Err(InvalidCompactExpressionOracleProduct)


private pure func projected_child(
	rep: CompactExpressionProductRep,
	projected: List[ParsedExpr],
	node: CompactExpressionNodeRow,
	offset: Int,
) -> Option[ParsedExpr]:
	match rep.children.get(node.child_start + offset):
		Some(child):
			projected.get(child)
		None:
			None


private pure func compact_text_payload(
	rep: CompactExpressionProductRep,
	payload_index: Int,
) -> Option[String]:
	match rep.text_payloads.get(payload_index):
		Some(payload):
			rep.texts.get(payload.text_index)
		None:
			None


private pure func projected_control_identifier(
	rep: CompactExpressionProductRep,
	identifier_index: Int,
) -> Option[ParsedIdentifier]:
	match rep.control_identifiers.get(identifier_index):
		Some(identifier):
			rep.texts
				.get(identifier.text_index)
				.map(func(text): parsed_identifier(text, identifier.span.location))
		None:
			None


private pure func projected_identifier_slice(
	rep: CompactExpressionProductRep,
	slice_index: Int,
) -> Option[List[ParsedIdentifier]]:
	match rep.identifier_slices.get(slice_index):
		Some(slice):
			var identifiers: List[ParsedIdentifier] = []
			var offset: Int = 0
			var valid = True

			while offset < slice.identifier_count and valid:
				match projected_control_identifier(rep, slice.identifier_start + offset):
					Some(identifier):
						identifiers = identifiers.append(identifier)
					None:
						valid = False

				offset += 1

			if valid:
				Some(identifiers)
			else:
				None
		None:
			None


private pure func projected_optional_type(
	projected_types: List[ParsedTypeExpr],
	type_root_index: Int,
) -> Option[Option[ParsedTypeExpr]]:
	if type_root_index == NO_COMPACT_TYPE_ROOT_INDEX:
		Some(None)
	else:
		projected_types
			.get(type_root_index)
			.map(func(type_expr): Some(type_expr))


private pure func projected_children(
	rep: CompactExpressionProductRep,
	projected: List[ParsedExpr],
	node: CompactExpressionNodeRow,
	start_offset: Int,
) -> Option[List[ParsedExpr]]:
	var values: List[ParsedExpr] = []
	var offset = start_offset
	var valid = True

	while offset < node.child_count and valid:
		match projected_child(rep, projected, node, offset):
			Some(value):
				values = values.append(value)
			None:
				valid = False

		offset += 1

	if valid:
		Some(values)
	else:
		None


private pure func projected_record_fields(
	rep: CompactExpressionProductRep,
	projected: List[ParsedExpr],
	node: CompactExpressionNodeRow,
	payload: CompactRecordPayloadRow,
	child_start_offset: Int,
) -> Option[List[ParsedRecordExprField]]:
	var fields: List[ParsedRecordExprField] = []
	var offset: Int = 0
	var valid = True

	while offset < payload.field_count and valid:
		match (
			rep.record_fields.get(payload.field_start + offset),
			projected_child(rep, projected, node, child_start_offset + offset),
		):
			(Some(field), Some(value)):
				match rep.texts.get(field.name_text_index):
					Some(name):
						fields = fields.append({
							name = parsed_identifier(name, field.name_span.location),
							value = value,
							span = field.field_span.location,
						})
					None:
						valid = False
			_:
				valid = False

		offset += 1

	if valid:
		Some(fields)
	else:
		None


private pure func projected_dict_entries(
	rep: CompactExpressionProductRep,
	projected: List[ParsedExpr],
	node: CompactExpressionNodeRow,
	payload: CompactDictPayloadRow,
) -> Option[List[ParsedDictEntry]]:
	var entries: List[ParsedDictEntry] = []
	var offset: Int = 0
	var valid = True

	while offset < payload.entry_count and valid:
		match (
			rep.dict_entries.get(payload.entry_start + offset),
			projected_child(rep, projected, node, offset * 2),
			projected_child(rep, projected, node, offset * 2 + 1),
		):
			(Some(entry), Some(key), Some(value)):
				entries = entries.append({
					key = key,
					value = value,
					span = entry.entry_span.location,
				})
			_:
				valid = False

		offset += 1

	if valid:
		Some(entries)
	else:
		None


private pure func projected_type_child(
	rep: CompactExpressionProductRep,
	projected: List[ParsedTypeExpr],
	node: CompactTypeNodeRow,
	offset: Int,
) -> Option[ParsedTypeExpr]:
	match rep.type_children.get(node.child_start + offset):
		Some(child):
			projected.get(child)
		None:
			None


private pure func projected_type_children(
	rep: CompactExpressionProductRep,
	projected: List[ParsedTypeExpr],
	node: CompactTypeNodeRow,
	start_offset: Int,
) -> Option[List[ParsedTypeExpr]]:
	var values: List[ParsedTypeExpr] = []
	var offset = start_offset
	var valid = True

	while offset < node.child_count and valid:
		match projected_type_child(rep, projected, node, offset):
			Some(value):
				values = values.append(value)
			None:
				valid = False

		offset += 1

	if valid:
		Some(values)
	else:
		None


private pure func projected_type_identifier(
	rep: CompactExpressionProductRep,
	node: CompactTypeNodeRow,
	offset: Int,
) -> Option[ParsedIdentifier]:
	match rep.type_identifier_slices.get(node.payload_index):
		Some(payload):
			match rep.type_identifiers.get(payload.identifier_start + offset):
				Some(identifier):
					rep.texts
						.get(identifier.text_index)
						.map(func(text): parsed_identifier(text, identifier.span.location))
				None:
					None
		None:
			None


private pure func projected_type_identifiers(
	rep: CompactExpressionProductRep,
	node: CompactTypeNodeRow,
	start_offset: Int,
) -> Option[List[ParsedIdentifier]]:
	match rep.type_identifier_slices.get(node.payload_index):
		Some(payload):
			var values: List[ParsedIdentifier] = []
			var offset = start_offset
			var valid = True

			while offset < payload.identifier_count and valid:
				match projected_type_identifier(rep, node, offset):
					Some(value):
						values = values.append(value)
					None:
						valid = False

				offset += 1

			if valid:
				Some(values)
			else:
				None
		None:
			None


private pure func compact_project_types(
	rep: CompactExpressionProductRep,
) -> Option[List[ParsedTypeExpr]]:
	var projected: List[ParsedTypeExpr] = []
	var valid = True
	var node_index: Int = 0

	while node_index < rep.type_nodes.length() and valid:
		match rep.type_nodes.get(node_index):
			Some(node):
				span = node.span.location
				var value: Option[ParsedTypeExpr] = None

				match node.kind:
					CompactNamedTypeNode:
						match (
							projected_type_identifier(rep, node, 0),
							projected_type_children(rep, projected, node, 0),
						):
							(Some(name), Some(args)):
								value = Some(ParsedNamedType(name, args, span))
							_:
								void
					CompactQualifiedNamedTypeNode:
						match (
							projected_type_identifier(rep, node, 0),
							projected_type_identifier(rep, node, 1),
							projected_type_children(rep, projected, node, 0),
						):
							(Some(qualifier), Some(name), Some(args)):
								value = Some(ParsedQualifiedNamedType(qualifier, name, args, span))
							_:
								void
					CompactBoundedTypeNode:
						match (
							projected_type_identifier(rep, node, 0),
							projected_type_identifiers(rep, node, 1),
						):
							(Some(name), Some(bounds)):
								value = Some(ParsedBoundedType(name, bounds, span))
							_:
								void
					CompactDimNameTypeNode | CompactDimSplatNameTypeNode:
						value = projected_type_identifier(
							rep,
							node,
							0,
						).map(
							func(
								name,
							): ParsedDimNameType(
								name,
								node.kind == CompactDimSplatNameTypeNode,
								span,
							),
						)
					CompactDimLiteralTypeNode:
						value = rep.texts
							.get(node.payload_index)
							.map(func(text): ParsedDimLiteralType(text, span))
					CompactDimAddTypeNode | CompactDimSubtractTypeNode | CompactDimMultiplyTypeNode | CompactDimDivideTypeNode:
						match (
							parsed_dim_binary_operator(node.kind),
							projected_type_child(rep, projected, node, 0),
							projected_type_child(rep, projected, node, 1),
						):
							(Some(op), Some(left), Some(right)):
								value = Some(ParsedDimBinaryType(op, left, right, span))
							_:
								void
					CompactRangeTypeNode:
						value = projected_type_child(
							rep,
							projected,
							node,
							0,
						).map(
							func(inner): ParsedRangeType(inner, span),
						)
					CompactTupleTypeNode:
						value = projected_type_children(
							rep,
							projected,
							node,
							0,
						).map(
							func(fields): ParsedTupleType(fields, span),
						)
					CompactPureFunctionTypeNode | CompactImpureFunctionTypeNode:
						match (
							projected_type_children(rep, projected, node, 0),
							projected_type_child(rep, projected, node, node.child_count - 1),
						):
							(Some(children), Some(result)):
								value = Some(
									ParsedFunctionType(
										node.kind == CompactPureFunctionTypeNode,
										children.take(children.length() - 1),
										result,
										span,
									),
								)
							_:
								void
					CompactArrayTypeNode:
						match (
							projected_type_child(rep, projected, node, 0),
							projected_type_children(rep, projected, node, 1),
						):
							(Some(element), Some(dimensions)):
								value = Some(ParsedArrayType(element, dimensions, span))
							_:
								void
					CompactMissingTypeNode:
						value = Some(ParsedMissingType(span))

				match value:
					Some(type_expr):
						projected = projected.append(type_expr)
					None:
						valid = False
			None:
				valid = False

		node_index += 1

	if valid:
		Some(projected)
	else:
		None


pure func compact_expression_oracle_project(
	product: ValidatedExpressionProduct,
) -> Result[List[ParsedExpr], CompactExpressionOracleError]:
	rep = from_opaque ValidatedExpressionProduct(product)
	var projected: List[ParsedExpr] = []
	var projected_types: List[ParsedTypeExpr] = []
	var valid = False

	match compact_project_types(rep):
		Some(values):
			projected_types = values
			valid = True
		None:
			void

	var node_index: Int = 0

	while node_index < rep.nodes.length() and valid:
		match rep.nodes.get(node_index):
			Some(node):
				span = node.span.location
				var value: Option[ParsedExpr] = None

				match node.kind:
					CompactNameNode:
						value = compact_text_payload(
							rep,
							node.payload_index,
						).map(
							func(text): ParsedNameExpr(parsed_identifier(text, span)),
						)
					CompactIntNode:
						value = compact_text_payload(
							rep,
							node.payload_index,
						).map(
							func(text): ParsedIntLiteralExpr(text, span),
						)
					CompactFloatNode:
						value = compact_text_payload(
							rep,
							node.payload_index,
						).map(
							func(text): ParsedFloatLiteralExpr(text, span),
						)
					CompactStringNode:
						match rep.string_payloads.get(node.payload_index):
							Some(payload):
								value = rep.texts
									.get(payload.text_index)
									.map(
										func(
											text,
										): ParsedStringLiteralExpr(text, payload.form, span),
									)
							None:
								void
					CompactInterpolationNode:
						match rep.interpolation_payloads.get(node.payload_index):
							Some(payload):
								value = rep.texts
									.get(payload.text_index)
									.map(
										func(
											text,
										): ParsedStringInterpolationExpr(
											text,
											payload.is_multiline,
											span,
										),
									)
							None:
								void
					CompactBoolNode:
						value = rep.bool_payloads
							.get(node.payload_index)
							.map(func(row): ParsedBoolLiteralExpr(row.value, span))
					CompactCharNode:
						value = rep.char_payloads
							.get(node.payload_index)
							.map(func(row): ParsedCharLiteralExpr(row.value, span))
					CompactUnaryNode:
						match (
							rep.operator_payloads.get(node.payload_index),
							projected_child(rep, projected, node, 0),
						):
							(Some(payload), Some(child)):
								value = parsed_unary_operator(
									payload.operator,
								).map(
									func(op): ParsedUnaryExpr(op, child, span),
								)
							_:
								void
					CompactBinaryNode:
						match (
							rep.operator_payloads.get(node.payload_index),
							projected_child(rep, projected, node, 0),
							projected_child(rep, projected, node, 1),
						):
							(Some(payload), Some(left), Some(right)):
								value = parsed_binary_operator(
									payload.operator,
								).map(
									func(op): ParsedBinaryExpr(op, left, right, span),
								)
							_:
								void
					CompactLogicalNode:
						match (
							rep.operator_payloads.get(node.payload_index),
							projected_child(rep, projected, node, 0),
							projected_child(rep, projected, node, 1),
						):
							(Some(payload), Some(left), Some(right)):
								value = parsed_logical_operator(
									payload.operator,
								).map(
									func(op): ParsedLogicalExpr(op, left, right, span),
								)
							_:
								void
					CompactAscriptionNode:
						match (
							projected_child(rep, projected, node, 0),
							projected_types.get(node.payload_index),
						):
							(Some(child), Some(type_expr)):
								value = Some(ParsedAscriptionExpr(child, type_expr, span))
							_:
								void
					CompactRangeNode:
						match (
							projected_child(rep, projected, node, 0),
							projected_child(rep, projected, node, 1),
						):
							(Some(start), Some(finish)):
								value = Some(ParsedRangeExpr(start, finish, span))
							_:
								void
					CompactCallNode:
						match projected_child(rep, projected, node, 0):
							Some(callee):
								var args: List[ParsedExpr] = []
								var child_offset: Int = 1

								while child_offset < node.child_count:
									match projected_child(rep, projected, node, child_offset):
										Some(arg):
											args = args.append(arg)
										None:
											valid = False

									child_offset += 1

								if valid:
									value = Some(ParsedCallExpr(callee, args, span))
							None:
								void
					CompactFieldAccessNode:
						match (
							rep.field_access_payloads.get(node.payload_index),
							projected_child(rep, projected, node, 0),
						):
							(Some(payload), Some(target)):
								value = rep.texts
									.get(payload.field_text_index)
									.map(func(field): ParsedFieldAccessExpr(
											target,
											parsed_identifier(field, payload.field_span.location),
											span,
										))
							_:
								void
					CompactSubscriptNode:
						match (
							projected_child(rep, projected, node, 0),
							projected_children(rep, projected, node, 1),
						):
							(Some(target), Some(indices)):
								value = Some(ParsedSubscriptExpr(target, indices, span))
							_:
								void
					CompactListNode:
						value = projected_children(
							rep,
							projected,
							node,
							0,
						).map(
							func(items): ParsedListExpr(items, span),
						)
					CompactTupleNode:
						value = projected_children(
							rep,
							projected,
							node,
							0,
						).map(
							func(items): ParsedTupleExpr(items, span),
						)
					CompactRecordNode:
						match rep.record_payloads.get(node.payload_index):
							Some(payload):
								value = projected_record_fields(
									rep,
									projected,
									node,
									payload,
									0,
								).map(
									func(fields): ParsedRecordExpr(fields, span),
								)
							None:
								void
					CompactRecordUpdateNode:
						match (
							rep.record_payloads.get(node.payload_index),
							projected_child(rep, projected, node, 0),
						):
							(Some(payload), Some(base)):
								value = projected_record_fields(
									rep,
									projected,
									node,
									payload,
									1,
								).map(
									func(fields): ParsedRecordUpdateExpr(base, fields, span),
								)
							_:
								void
					CompactDictNode:
						match rep.dict_payloads.get(node.payload_index):
							Some(payload):
								value = projected_dict_entries(
									rep,
									projected,
									node,
									payload,
								).map(
									func(entries): ParsedDictExpr(entries, span),
								)
							None:
								void
					CompactVectorNode:
						value = projected_children(
							rep,
							projected,
							node,
							0,
						).map(
							func(items): ParsedVectorExpr(items, span),
						)
					CompactOpaqueIntoNode | CompactOpaqueFromNode:
						match (
							projected_child(rep, projected, node, 0),
							projected_types.get(node.payload_index),
						):
							(Some(child), Some(type_expr)):
								value = if node.kind == CompactOpaqueIntoNode:
									Some(ParsedOpaqueIntoExpr(type_expr, child, span))
								else:
									Some(ParsedOpaqueFromExpr(type_expr, child, span))
							_:
								void
					CompactFinalizedInterpolationNode:
						match rep.interpolation_parts_payloads.get(node.payload_index):
							Some(payload):
								var parts: List[ParsedStringInterpolationPart] = []
								var part_offset: Int = 0

								while part_offset < payload.part_count and valid:
									match rep.interpolation_parts.get(
										payload.part_start + part_offset,
									):
										Some(part):
											match part.kind:
												CompactInterpolationLiteralPart:
													match rep.texts.get(part.payload_index):
														Some(text):
															parts = parts.append(
																ParsedInterpolationLiteral(text),
															)
														None:
															valid = False
												CompactInterpolationExpressionPart:
													match projected_child(
														rep,
														projected,
														node,
														part.payload_index,
													):
														Some(expr):
															parts = parts.append(
																ParsedInterpolationExpr(expr),
															)
														None:
															valid = False
										None:
											valid = False

									part_offset += 1

								if valid:
									value = Some(
										ParsedStringInterpolationPartsExpr(
											parts,
											payload.is_multiline,
											span,
										),
									)
							None:
								void
					CompactBlockNode:
						value = projected_children(
							rep,
							projected,
							node,
							0,
						).map(
							func(items): ParsedBlockExpr(items, span),
						)
					CompactImmutableVarDeclNode | CompactMutableVarDeclNode:
						match (
							rep.typed_binders.get(node.payload_index),
							projected_child(rep, projected, node, 0),
						):
							(Some(payload), Some(initializer)):
								match (
									projected_control_identifier(rep, payload.identifier_index),
									projected_optional_type(
										projected_types,
										payload.type_root_index,
									),
								):
									(Some(identifier), Some(type_expr)):
										value = Some(
											ParsedVarDeclExpr(
												identifier,
												type_expr,
												initializer,
												node.kind == CompactMutableVarDeclNode,
												span,
											),
										)
									_:
										void
							_:
								void
					CompactAssignNode:
						match (
							projected_control_identifier(rep, node.payload_index),
							projected_child(rep, projected, node, 0),
						):
							(Some(identifier), Some(assigned_value)):
								value = Some(ParsedAssignExpr(identifier, assigned_value, span))
							_:
								void
					CompactCompoundAddAssignNode | CompactCompoundSubtractAssignNode | CompactCompoundMultiplyAssignNode | CompactCompoundDivideAssignNode:
						match (
							projected_control_identifier(rep, node.payload_index),
							parsed_compound_assign_operator(node.kind),
							projected_child(rep, projected, node, 0),
						):
							(Some(identifier), Some(op), Some(assigned_value)):
								value = Some(
									ParsedCompoundAssignExpr(
										identifier,
										op,
										assigned_value,
										span,
									),
								)
							_:
								void
					CompactSubscriptAssignNode:
						match (
							projected_child(rep, projected, node, 0),
							projected_child(rep, projected, node, node.child_count - 1),
						):
							(Some(target), Some(assigned_value)):
								var indices: List[ParsedExpr] = []
								var child_offset: Int = 1

								while child_offset < node.child_count - 1 and valid:
									match projected_child(rep, projected, node, child_offset):
										Some(index_value):
											indices = indices.append(index_value)
										None:
											valid = False

									child_offset += 1

								if valid:
									value = Some(
										ParsedSubscriptAssignExpr(
											target,
											indices,
											assigned_value,
											span,
										),
									)
							_:
								void
					CompactTupleDestructNode:
						match (
							projected_identifier_slice(rep, node.payload_index),
							projected_child(rep, projected, node, 0),
						):
							(Some(identifiers), Some(initializer)):
								value = Some(
									ParsedTupleDestructExpr(
										identifiers,
										initializer,
										span,
									),
								)
							_:
								void
					CompactQuestionBindNode:
						match (
							rep.typed_binders.get(node.payload_index),
							projected_child(rep, projected, node, 0),
						):
							(Some(payload), Some(initializer)):
								match (
									projected_control_identifier(rep, payload.identifier_index),
									projected_optional_type(
										projected_types,
										payload.type_root_index,
									),
								):
									(Some(identifier), Some(type_expr)):
										value = Some(
											ParsedQuestionBindExpr(
												identifier,
												type_expr,
												initializer,
												span,
											),
										)
									_:
										void
							_:
								void
					CompactIfNode:
						match (
							projected_child(rep, projected, node, 0),
							projected_child(rep, projected, node, 1),
						):
							(Some(condition), Some(then_expr)):
								else_expr: Option[ParsedExpr] = if node.child_count == 3:
									projected_child(rep, projected, node, 2)
								else:
									None

								if node.child_count == 2 or else_expr.is_some():
									value = Some(
										ParsedIfExpr(
											condition,
											then_expr,
											else_expr,
											span,
										),
									)
							_:
								void
					CompactDebugBlockNode:
						value = projected_child(
							rep,
							projected,
							node,
							0,
						).map(
							func(body): ParsedDebugBlockExpr(body, span),
						)
					CompactWhileNode:
						match (
							projected_child(rep, projected, node, 0),
							projected_child(rep, projected, node, 1),
						):
							(Some(condition), Some(body)):
								value = Some(ParsedWhileExpr(condition, body, span))
							_:
								void
					CompactForNameNode:
						match (
							projected_control_identifier(rep, node.payload_index),
							projected_child(rep, projected, node, 0),
							projected_child(rep, projected, node, 1),
						):
							(Some(identifier), Some(iterable), Some(body)):
								value = Some(
									ParsedForExpr(
										ParsedForNameBinder(identifier),
										iterable,
										body,
										span,
									),
								)
							_:
								void
					CompactForTupleNode:
						match (
							rep.identifier_slices.get(node.payload_index),
							projected_identifier_slice(rep, node.payload_index),
							projected_child(rep, projected, node, 0),
							projected_child(rep, projected, node, 1),
						):
							(Some(payload), Some(identifiers), Some(iterable), Some(body)):
								value = Some(
									ParsedForExpr(
										ParsedForTupleBinder(identifiers, payload.span.location),
										iterable,
										body,
										span,
									),
								)
							_:
								void
					CompactBreakNode:
						value = Some(ParsedBreakExpr(span))
					CompactContinueNode:
						value = Some(ParsedContinueExpr(span))
					CompactVoidNode:
						value = Some(ParsedVoidExpr(span))
					CompactNamedBuiltinNode:
						value = compact_text_payload(
							rep,
							node.payload_index,
						).map(
							func(text): ParsedBuiltinExpr(Some(text), span),
						)
					CompactUnnamedBuiltinNode:
						value = Some(ParsedBuiltinExpr(None, span))
					CompactMissingNode:
						value = Some(ParsedMissingExpr(span))

				match value:
					Some(expr):
						projected = projected.append(expr)
					None:
						valid = False
			None:
				valid = False

		node_index += 1

	if not valid:
		Err(InvalidCompactExpressionOracleProduct)
	else:
		var roots: List[ParsedExpr] = []

		for root in rep.roots:
			match projected.get(root):
				Some(expr):
					roots = roots.append(expr)
				None:
					valid = False

		if valid:
			Ok(roots)
		else:
			Err(InvalidCompactExpressionOracleProduct)


private pure func compact_bound_name_lookup(
	rep: CompactExpressionProductRep,
	bound_text_indices: List[Int],
	name: String,
) -> CompactBoundNameLookup:
	var is_bound = False
	var comparison_count: Int = 0
	var index: Int = 0

	while index < bound_text_indices.length() and not is_bound:
		match bound_text_indices.get(index):
			Some(text_index):
				match rep.texts.get(text_index):
					Some(bound_name):
						comparison_count += 1
						is_bound = bound_name == name
					None:
						void
			None:
				void

		index += 1

	{
		is_bound = is_bound,
		comparison_count = comparison_count
	}


private pure func compact_expression_oracle_reference_traversal(
	product: ValidatedExpressionProduct,
) -> CompactReferenceTraversalResult:
	rep = from_opaque ValidatedExpressionProduct(product)
	var references: List[IdentifierReference] = []
	var actions: List[CompactReferenceAction] = []
	var bound_text_indices: List[Int] = []
	var bound_name_comparison_count: Int = 0
	var root_index = rep.roots.length() - 1

	while root_index >= 0:
		actions = actions.append(
			CompactReferenceVisit(
				rep.roots
					.get(root_index)
					.get_or(-1),
			),
		)
		root_index -= 1

	-- The action stack carries only scalar ids and counts. Scope changes mutate
	-- one local stack and are undone explicitly; no expression clones an
	-- environment and no global name set approximates lexical visibility.
	while not actions.is_empty():
		action_index = actions.length() - 1
		action = actions.get(action_index)
		actions = actions.take(action_index)

		match action:
			Some(CompactReferenceVisit(node_id)):
				match rep.nodes.get(node_id):
					Some(node):
						match node.kind:
							CompactNameNode:
								match compact_text_payload(rep, node.payload_index):
									Some(text):
										lookup = compact_bound_name_lookup(
											rep,
											bound_text_indices,
											text,
										)
										bound_name_comparison_count += lookup.comparison_count

										if not lookup.is_bound:
											references = references.append({
												name = text,
												qualified_member = None,
												span = node.span.location,
											})
									None:
										void
							CompactFieldAccessNode:
								match (
									rep.children.get(node.child_start),
									rep.field_access_payloads.get(node.payload_index),
								):
									(Some(target_id), Some(payload)):
										match rep.nodes.get(target_id):
											Some(target):
												if target.kind == CompactNameNode:
													match (
														compact_text_payload(
															rep,
															target.payload_index,
														),
														rep.texts.get(payload.field_text_index),
													):
														(Some(name), Some(member)):
															lookup = compact_bound_name_lookup(
																rep,
																bound_text_indices,
																name,
															)
															bound_name_comparison_count += lookup.comparison_count

															if not lookup.is_bound:
																references = references.append({
																	name = name,
																	qualified_member = Some(member),
																	span = target.span.location,
																})
														_:
															void
												else:
													actions = actions.append(
														CompactReferenceVisit(target_id),
													)
											None:
												void
									_:
										void
							CompactBlockNode:
								var entered_count: Int = 0
								leave_action_index = actions.length()
								actions = actions.append(CompactReferenceLeaveBindings(0))
								var child_offset = node.child_count - 1

								while child_offset >= 0:
									match rep.children.get(node.child_start + child_offset):
										Some(child_id):
											match rep.nodes.get(child_id):
												Some(child):
													match child.kind:
														CompactImmutableVarDeclNode | CompactMutableVarDeclNode | CompactQuestionBindNode:
															match rep.typed_binders.get(
																child.payload_index,
															):
																Some(payload):
																	entered_count += 1
																	actions = actions.append(
																		CompactReferenceEnterIdentifier(
																			payload.identifier_index,
																		),
																	)
																None:
																	void
														CompactTupleDestructNode:
															match rep.identifier_slices.get(
																child.payload_index,
															):
																Some(slice):
																	entered_count += slice.identifier_count
																	actions = actions.append(
																		CompactReferenceEnterIdentifierSlice(
																			child.payload_index,
																		),
																	)
																None:
																	void
														_:
															void
												None:
													void

											actions = actions.append(
												CompactReferenceVisit(child_id),
											)
										None:
											void

									child_offset -= 1

								actions = actions.set(
									leave_action_index,
									CompactReferenceLeaveBindings(entered_count),
								)
							CompactForNameNode | CompactForTupleNode:
								var binding_count: Int = 1
								var enter_action: CompactReferenceAction = CompactReferenceEnterIdentifier(
									node.payload_index,
								)

								if node.kind == CompactForTupleNode:
									binding_count = rep.identifier_slices
										.get(node.payload_index)
										.map(func(slice): slice.identifier_count)
										.get_or(0)
									enter_action = CompactReferenceEnterIdentifierSlice(
										node.payload_index,
									)

								actions = actions
									.append(CompactReferenceLeaveBindings(binding_count))
									.append(
										CompactReferenceVisit(
											rep.children
												.get(node.child_start + 1)
												.get_or(-1),
										),
									)
									.append(enter_action)
									.append(
										CompactReferenceVisit(
											rep.children
												.get(node.child_start)
												.get_or(-1),
										),
									)
							CompactAssignNode | CompactCompoundAddAssignNode | CompactCompoundSubtractAssignNode | CompactCompoundMultiplyAssignNode | CompactCompoundDivideAssignNode:
								match projected_control_identifier(rep, node.payload_index):
									Some(identifier):
										lookup = compact_bound_name_lookup(
											rep,
											bound_text_indices,
											identifier.text,
										)
										bound_name_comparison_count += lookup.comparison_count

										if not lookup.is_bound:
											references = references.append({
												name = identifier.text,
												qualified_member = None,
												span = identifier.span,
											})
									None:
										void

								match rep.children.get(node.child_start):
									Some(child_id):
										actions = actions.append(CompactReferenceVisit(child_id))
									None:
										void
							_:
								var child_offset = node.child_count - 1

								while child_offset >= 0:
									match rep.children.get(node.child_start + child_offset):
										Some(child_id):
											actions = actions.append(
												CompactReferenceVisit(child_id),
											)
										None:
											void

									child_offset -= 1
					None:
						void
			Some(CompactReferenceEnterIdentifier(identifier_index)):
				match rep.control_identifiers.get(identifier_index):
					Some(identifier):
						bound_text_indices = bound_text_indices.append(identifier.text_index)
					None:
						void
			Some(CompactReferenceEnterIdentifierSlice(slice_index)):
				match rep.identifier_slices.get(slice_index):
					Some(slice):
						var offset: Int = 0

						while offset < slice.identifier_count:
							match rep.control_identifiers.get(slice.identifier_start + offset):
								Some(identifier):
									bound_text_indices = bound_text_indices.append(
										identifier.text_index,
									)
								None:
									void

							offset += 1
					None:
						void
			Some(CompactReferenceLeaveBindings(count)):
				bound_text_indices = bound_text_indices.take(bound_text_indices.length() - count)
			None:
				void

	{
		references = references,
		bound_name_comparison_count = bound_name_comparison_count
	}


pure func compact_expression_oracle_free_identifier_references(
	product: ValidatedExpressionProduct,
) -> List[IdentifierReference]:
	compact_expression_oracle_reference_traversal(product).references


pure func compact_expression_oracle_reference_traversal_counts(
	product: ValidatedExpressionProduct,
) -> CompactReferenceTraversalCounts:
	result = compact_expression_oracle_reference_traversal(product)
	{
		reference_count = result.references.length(),
		bound_name_comparison_count = result.bound_name_comparison_count
	}


pure func compact_expression_oracle_counts(
	product: ValidatedExpressionProduct,
) -> CompactExpressionProductCounts:
	rep = from_opaque ValidatedExpressionProduct(product)
	{
		source_owner_count = rep.source_owners.length(),
		node_count = rep.nodes.length(),
		child_count = rep.children.length(),
		text_count = rep.texts.length(),
		text_payload_count = rep.text_payloads.length(),
		string_payload_count = rep.string_payloads.length(),
		interpolation_payload_count = rep.interpolation_payloads.length(),
		bool_payload_count = rep.bool_payloads.length(),
		char_payload_count = rep.char_payloads.length(),
		operator_payload_count = rep.operator_payloads.length(),
		call_payload_count = rep.call_payloads.length(),
		field_access_payload_count = rep.field_access_payloads.length(),
		record_payload_count = rep.record_payloads.length(),
		record_field_count = rep.record_fields.length(),
		dict_payload_count = rep.dict_payloads.length(),
		dict_entry_count = rep.dict_entries.length(),
		type_node_count = rep.type_nodes.length(),
		type_child_count = rep.type_children.length(),
		type_identifier_slice_count = rep.type_identifier_slices.length(),
		type_identifier_count = rep.type_identifiers.length(),
		interpolation_parts_payload_count = rep.interpolation_parts_payloads.length(),
		interpolation_part_count = rep.interpolation_parts.length(),
		control_identifier_count = rep.control_identifiers.length(),
		identifier_slice_count = rep.identifier_slices.length(),
		typed_binder_count = rep.typed_binders.length(),
		unit_payload_count = rep.unit_payloads.length(),
		root_count = rep.roots.length()
	}


private pure func compact_product_with_corrupt_binder_type_root(
	rep: CompactExpressionProductRep,
	scope_root: Int,
	type_root_index: Int,
) -> CompactExpressionProductRep:
	match rep.nodes.get(scope_root):
		Some(scope_node):
			match rep.children.get(scope_node.child_start + 2):
				Some(var_node_id):
					match rep.nodes.get(var_node_id):
						Some(var_node):
							match rep.typed_binders.get(var_node.payload_index):
								Some(payload):
									{ rep |
										typed_binders = rep.typed_binders.set(
											var_node.payload_index,
											{ payload | type_root_index = type_root_index },
										)
									}
								None:
									rep
						None:
							rep
				None:
					rep
		None:
			rep


private pure func compact_corruption_scope_tuple_node_id(
	rep: CompactExpressionProductRep,
	scope_root: Int,
) -> Option[Int]:
	match rep.nodes.get(scope_root):
		Some(scope_node):
			rep.children.get(scope_node.child_start + 3)
		None:
			None


pure func compact_expression_oracle_rejects_corruption(
	source: SourceFile,
	corruption: CompactExpressionCorruption,
) -> Bool:
	if source.text.length() < 10:
		False
	else:
		start_span = compact_source_location(
			source_location_from_offsets(
				singleton_source_file_id(),
				0,
				1,
			),
		)
		left = ParsedNameExpr(parsed_identifier("a", start_span.location))
		right = ParsedNameExpr(parsed_identifier("b", start_span.location))
		base = ParsedBinaryExpr(
			ParsedAddOp,
			ParsedBinaryExpr(ParsedMultiplyOp, left, right, start_span.location),
			right,
			start_span.location,
		)
		record_a = ParsedRecordExpr(
			[
				{
					name = parsed_identifier("first", start_span.location),
					value = left,
					span = start_span.location
				},
			],
			start_span.location,
		)
		record_b = ParsedRecordExpr(
			[
				{
					name = parsed_identifier("second", start_span.location),
					value = right,
					span = start_span.location
				},
			],
			start_span.location,
		)
		typed = ParsedAscriptionExpr(
			left,
			ParsedNamedType(
				parsed_identifier("Type", start_span.location),
				[],
				start_span.location,
			),
			start_span.location,
		)
		interpolated = ParsedStringInterpolationPartsExpr(
			[ParsedInterpolationExpr(left), ParsedInterpolationExpr(right)],
			False,
			start_span.location,
		)
		scoped = ParsedBlockExpr(
			[ParsedAssignExpr(
					parsed_identifier("a", start_span.location),
					left,
					start_span.location,
				), ParsedAssignExpr(
					parsed_identifier("b", start_span.location),
					right,
					start_span.location,
				), ParsedVarDeclExpr(
					parsed_identifier("bound", start_span.location),
					Some(
						ParsedNamedType(
							parsed_identifier("Type", start_span.location),
							[],
							start_span.location,
						),
					),
					left,
					False,
					start_span.location,
				), ParsedTupleDestructExpr(
					[parsed_identifier("tuple", start_span.location)],
					left,
					start_span.location,
				)],
			start_span.location,
		)
		looped = ParsedForExpr(
			ParsedForTupleBinder(
				[
					parsed_identifier("left", start_span.location),
					parsed_identifier("right", start_span.location),
				],
				start_span.location,
			),
			left,
			right,
			start_span.location,
		)

		match (
			compact_expression_oracle_from_parsed_roots(
				source,
				[
					base,
					ParsedBoolLiteralExpr(True, start_span.location),
					ParsedCallExpr(left, [], start_span.location),
					record_a,
					record_b,
					typed,
					interpolated,
					scoped,
					looped,
				],
			)
		):
			Ok(product):
				rep = from_opaque ValidatedExpressionProduct(product)
				var corrupted = rep
				binary_root = rep.roots
					.get(0)
					.get_or(-1)
				call_root = rep.roots
					.get(2)
					.get_or(-1)
				record_a_root = rep.roots
					.get(3)
					.get_or(-1)
				record_b_root = rep.roots
					.get(4)
					.get_or(-1)
				typed_root = rep.roots
					.get(5)
					.get_or(-1)
				interpolation_root = rep.roots
					.get(6)
					.get_or(-1)
				scope_root = rep.roots
					.get(7)
					.get_or(-1)
				loop_root = rep.roots
					.get(8)
					.get_or(-1)

				match corruption:
					CompactChildIdOutOfRange:
						corrupted = { rep | children = rep.children.set(0, rep.nodes.length()) }
					CompactChildSliceOverlap:
						match rep.nodes.get(binary_root):
							Some(node):
								corrupted = { rep |
									nodes = rep.nodes.set(binary_root, { node | child_start = 0 })
								}
							None:
								void
					CompactDuplicateRoot:
						corrupted = { rep | roots = rep.roots.append(binary_root) }
					CompactForeignSourceOwner:
						match rep.nodes.get(0):
							Some(node):
								corrupted = { rep |
									nodes = rep.nodes.set(
										0,
										{ node | span = { node.span | source_owner_index = 1 } },
									)
								}
							None:
								void
					CompactNodeBackEdge:
						corrupted = { rep | children = rep.children.set(0, 2) }
					CompactNegativeCallArity:
						match rep.nodes.get(call_root):
							Some(node):
								match rep.call_payloads.get(node.payload_index):
									Some(payload):
										corrupted = { rep |
											call_payloads = rep.call_payloads.set(
												node.payload_index,
												{ payload | argument_count = -1 },
											)
										}
									None:
										void
							None:
								void
					CompactOrphanNode:
						text_index = rep.texts.length()
						payload_index = rep.text_payloads.length()
						corrupted = { rep |
							texts = rep.texts.append("orphan"),
							text_payloads = rep.text_payloads.append({text_index = text_index}),
							nodes = rep.nodes.append({
								kind = CompactNameNode,
								payload_index = payload_index,
								child_start = rep.children.length(),
								child_count = 0,
								span = start_span,
							})
						}
					CompactOrphanPayload:
						corrupted = { rep |
							text_payloads = rep.text_payloads.append({text_index = 0})
						}
					CompactPayloadFamilyMismatch:
						match rep.nodes.get(0):
							Some(node):
								corrupted = { rep |
									nodes = rep.nodes.set(0, { node | kind = CompactBoolNode })
								}
							None:
								void
					CompactSharedChild:
						match rep.nodes.get(binary_root):
							Some(node):
								corrupted = { rep |
									children = rep.children.set(node.child_start + 1, 0)
								}
							None:
								void
					CompactTextIndexAlias:
						match rep.text_payloads.get(1):
							Some(payload):
								corrupted = { rep |
									text_payloads = rep.text_payloads.set(
										1,
										{ payload | text_index = 0 },
									)
								}
							None:
								void
					CompactWrongArity:
						match rep.nodes.get(binary_root):
							Some(node):
								corrupted = { rep |
									nodes = rep.nodes.set(binary_root, { node | child_count = 1 })
								}
							None:
								void
					CompactMetadataSliceAlias:
						match (rep.nodes.get(record_a_root), rep.nodes.get(record_b_root)):
							(Some(first_node), Some(second_node)):
								match (
									rep.record_payloads.get(first_node.payload_index),
									rep.record_payloads.get(second_node.payload_index),
								):
									(Some(first), Some(second)):
										corrupted = { rep |
											record_payloads = rep.record_payloads.set(
												second_node.payload_index,
												{ second | field_start = first.field_start },
											)
										}
									_:
										void
							_:
								void
					CompactAbsurdMetadataCount:
						match rep.nodes.get(record_a_root):
							Some(node):
								match rep.record_payloads.get(node.payload_index):
									Some(payload):
										corrupted = { rep |
											record_payloads = rep.record_payloads.set(
												node.payload_index,
												{ payload | field_count = 999999999 },
											)
										}
									None:
										void
							None:
								void
					CompactTypePayloadFamilyMismatch:
						match rep.nodes.get(typed_root):
							Some(node):
								match rep.type_nodes.get(node.payload_index):
									Some(type_node):
										corrupted = { rep | type_nodes = rep.type_nodes.set(
												node.payload_index,
												{ type_node |
													kind = CompactDimLiteralTypeNode,
													payload_index = 0
												},
											) }
									None:
										void
							None:
								void
					CompactInterpolationPartOrdinalAlias:
						match rep.nodes.get(interpolation_root):
							Some(node):
								match rep.interpolation_parts_payloads.get(node.payload_index):
									Some(payload):
										match rep.interpolation_parts.get(payload.part_start + 1):
											Some(part):
												corrupted = { rep |
													interpolation_parts = rep.interpolation_parts.set(
														payload.part_start + 1,
														{ part | payload_index = 0 },
													)
												}
											None:
												void
									None:
										void
							None:
								void
					CompactAbsurdInterpolationPartCount:
						match rep.nodes.get(interpolation_root):
							Some(node):
								match rep.interpolation_parts_payloads.get(node.payload_index):
									Some(payload):
										corrupted = { rep |
											interpolation_parts_payloads = rep.interpolation_parts_payloads.set(
												node.payload_index,
												{ payload | part_count = 999999999 },
											)
										}
									None:
										void
							None:
								void
					CompactControlIdentifierAlias:
						match rep.nodes.get(scope_root):
							Some(node):
								match (
									rep.children.get(node.child_start),
									rep.children.get(node.child_start + 1),
								):
									(Some(first_assign), Some(second_assign)):
										match (
											rep.nodes.get(first_assign),
											rep.nodes.get(second_assign),
										):
											(Some(first), Some(second)):
												corrupted = { rep |
													nodes = rep.nodes.set(
														second_assign,
														{ second |
															payload_index = first.payload_index
														},
													)
												}
											_:
												void
									_:
										void
							None:
								void
					CompactTypedBinderTypeRootOutOfRange:
						corrupted = compact_product_with_corrupt_binder_type_root(
							rep,
							scope_root,
							rep.type_nodes.length(),
						)
					CompactTypedBinderInvalidAbsentTypeRoot:
						corrupted = compact_product_with_corrupt_binder_type_root(
							rep,
							scope_root,
							-2,
						)
					CompactTypedBinderSharedTypeRoot:
						match rep.nodes.get(typed_root):
							Some(typed_node):
								corrupted = compact_product_with_corrupt_binder_type_root(
									rep,
									scope_root,
									typed_node.payload_index,
								)
							None:
								void
					CompactForBinderSliceOutOfRange:
						match rep.nodes.get(loop_root):
							Some(loop_node):
								match rep.identifier_slices.get(loop_node.payload_index):
									Some(slice):
										corrupted = { rep |
											identifier_slices = rep.identifier_slices.set(
												loop_node.payload_index,
												{ slice |
													identifier_start = rep.control_identifiers.length()
												},
											)
										}
									None:
										void
							None:
								void
					CompactForBinderSliceAlias:
						match (
							compact_corruption_scope_tuple_node_id(rep, scope_root),
							rep.nodes.get(loop_root),
						):
							(Some(tuple_node_id), Some(loop_node)):
								match rep.nodes.get(tuple_node_id):
									Some(tuple_node):
										corrupted = { rep |
											nodes = rep.nodes.set(
												loop_root,
												{ loop_node |
													payload_index = tuple_node.payload_index
												},
											)
										}
									None:
										void
							_:
								void
					CompactIdentifierSliceForeignSourceOwner:
						match compact_corruption_scope_tuple_node_id(rep, scope_root):
							Some(tuple_node_id):
								match rep.nodes.get(tuple_node_id):
									Some(tuple_node):
										match rep.identifier_slices.get(tuple_node.payload_index):
											Some(slice):
												corrupted = { rep |
													identifier_slices = rep.identifier_slices.set(
														tuple_node.payload_index,
														{ slice |
															span = { slice.span |
																source_owner_index = 1
															}
														},
													)
												}
											None:
												void
									None:
										void
							None:
								void

				not compact_expression_product_is_valid(corrupted)
			Err(_):
				False
