	references: List[IdentifierReference],
	bound_name_comparison_count: Int
}


private struct CompactBoundNameLookup {
	is_bound: Bool,
	comparison_count: Int
}


private union CompactBuildAction:
	CompactBuildVisit(ParsedExpr)
	CompactBuildUnary(ParsedUnaryOp, SourceLocation)
	CompactBuildBinary(ParsedBinaryOp, SourceLocation)
	CompactBuildLogical(ParsedLogicalOp, SourceLocation)
	CompactBuildCall(Int, SourceLocation)
	CompactBuildFieldAccess(ParsedIdentifier, SourceLocation)
	CompactBuildSubscript(Int, SourceLocation)
	CompactBuildSequence(CompactExpressionNodeKind, Int, SourceLocation)
	CompactBuildRecord(List[ParsedRecordExprField], Bool, SourceLocation)
	CompactBuildDict(List[ParsedDictEntry], SourceLocation)
	CompactBuildTypedWrapper(CompactExpressionNodeKind, SourceLocation)
	CompactBuildRange(SourceLocation)
	CompactBuildInterpolationParts(List[ParsedStringInterpolationPart], Bool, SourceLocation)
	CompactBuildTypedBinder(CompactExpressionNodeKind, ParsedIdentifier, Bool, SourceLocation)
	CompactBuildIdentifier(CompactExpressionNodeKind, ParsedIdentifier, Int, SourceLocation)
	CompactBuildIdentifierSlice(CompactExpressionNodeKind, List[ParsedIdentifier], Int, SourceLocation, SourceLocation)
	CompactBuildMatch(List[ParsedMatchCase], SourceLocation)
	CompactBuildSelect(List[ParsedSelectArm], SourceLocation)
	CompactBuildWith(ParsedWithBinding, SourceLocation)
	CompactBuildLambda(Bool, List[ParsedLambdaParam], Option[ParsedTypeExpr], SourceLocation)
	CompactBuildFunction(ParsedFunctionDecl)
	CompactBuildConcurrentBlock(List[ParsedConcurrentParam], SourceLocation)
	CompactBuildConcurrentFor(ParsedIdentifier, List[ParsedConcurrentParam], SourceLocation)
	CompactBuildPatternVisit(ParsedPattern)
	CompactBuildPatternNoPayload(CompactPatternNodeKind, Int, SourceLocation)
	CompactBuildPatternText(CompactPatternNodeKind, String, SourceLocation)
	CompactBuildPatternString(String, ParsedStringLiteralForm, SourceLocation)
	CompactBuildPatternChar(Int, SourceLocation)
	CompactBuildPatternBool(Bool, SourceLocation)
	CompactBuildPatternIdentifiers(CompactPatternNodeKind, List[ParsedIdentifier], Int, SourceLocation, SourceLocation)
	CompactBuildTypeVisit(ParsedTypeExpr)
	CompactBuildTypeIdentifiers(CompactTypeNodeKind, List[ParsedIdentifier], Int, SourceLocation)
	CompactBuildTypeText(CompactTypeNodeKind, String, SourceLocation)
	CompactBuildTypeNoPayload(CompactTypeNodeKind, Int, SourceLocation)


private union CompactReferenceAction:
	CompactReferenceVisit(Int)
	CompactReferenceVisitConcurrentTask(Int)
	CompactReferenceEnterIdentifier(Int)
	CompactReferenceEnterIdentifierSlice(Int)
	CompactReferenceEnterPatternNode(Int)
	CompactReferenceEnterPatternIdentifiers(Int)
	CompactReferenceLeaveBindings(Int)


private NO_COMPACT_PAYLOAD_INDEX: Int = -1

private NO_COMPACT_SOURCE_OWNER_INDEX: Int = -1

private NO_COMPACT_TYPE_ROOT_INDEX: Int = -1

private NO_COMPACT_IDENTIFIER_INDEX: Int = -1

private NO_COMPACT_ERROR_MAP_INDEX: Int = -1

private NO_COMPACT_TEXT_INDEX: Int = -1


private pure func compact_source_location(location: SourceLocation) -> CompactProductSourceLocation:
	owner_index = if source_locations_equal(location, compiler_prelude_source_location()):
		NO_COMPACT_SOURCE_OWNER_INDEX
	else:
		0

	{
		source_owner_index = owner_index,
		location = location
	}


private pure func compact_unary_operator(op: ParsedUnaryOp) -> CompactExpressionOperator:
	match op:
		ParsedNegateOp:
			CompactNegateOperator
		ParsedNotOp:
			CompactNotOperator


private pure func compact_binary_operator(op: ParsedBinaryOp) -> CompactExpressionOperator:
	match op:
		ParsedAddOp:
			CompactAddOperator
		ParsedSubtractOp:
			CompactSubtractOperator
		ParsedMultiplyOp:
			CompactMultiplyOperator
		ParsedDivideOp:
			CompactDivideOperator
		ParsedModuloOp:
			CompactModuloOperator
		ParsedEqualOp:
			CompactEqualOperator
		ParsedNotEqualOp:
			CompactNotEqualOperator
		ParsedLessOp:
			CompactLessOperator
		ParsedLessEqualOp:
			CompactLessEqualOperator
		ParsedGreaterOp:
			CompactGreaterOperator
		ParsedGreaterEqualOp:
			CompactGreaterEqualOperator


private pure func compact_logical_operator(op: ParsedLogicalOp) -> CompactExpressionOperator:
	match op:
		ParsedAndOp:
			CompactAndOperator
		ParsedOrOp:
			CompactOrOperator


private pure func compact_compound_assign_kind(
	op: ParsedCompoundAssignOp,
) -> CompactExpressionNodeKind:
	match op:
		ParsedAssignAddOp:
			CompactCompoundAddAssignNode
		ParsedAssignSubtractOp:
			CompactCompoundSubtractAssignNode
		ParsedAssignMultiplyOp:
			CompactCompoundMultiplyAssignNode
		ParsedAssignDivideOp:
			CompactCompoundDivideAssignNode


private pure func parsed_compound_assign_operator(
	kind: CompactExpressionNodeKind,
) -> Option[ParsedCompoundAssignOp]:
	match kind:
		CompactCompoundAddAssignNode:
			Some(ParsedAssignAddOp)
		CompactCompoundSubtractAssignNode:
			Some(ParsedAssignSubtractOp)
		CompactCompoundMultiplyAssignNode:
			Some(ParsedAssignMultiplyOp)
		CompactCompoundDivideAssignNode:
			Some(ParsedAssignDivideOp)
		_:
			None


private pure func compact_dim_binary_kind(op: ParsedDimBinaryOp) -> CompactTypeNodeKind:
	match op:
		ParsedDimAddOp:
			CompactDimAddTypeNode
		ParsedDimSubtractOp:
			CompactDimSubtractTypeNode
		ParsedDimMultiplyOp:
			CompactDimMultiplyTypeNode
		ParsedDimDivideOp:
			CompactDimDivideTypeNode


private pure func parsed_dim_binary_operator(
	kind: CompactTypeNodeKind,
) -> Option[ParsedDimBinaryOp]:
	match kind:
		CompactDimAddTypeNode:
			Some(ParsedDimAddOp)
		CompactDimSubtractTypeNode:
			Some(ParsedDimSubtractOp)
		CompactDimMultiplyTypeNode:
			Some(ParsedDimMultiplyOp)
		CompactDimDivideTypeNode:
			Some(ParsedDimDivideOp)
		_:
			None


private pure func parsed_unary_operator(op: CompactExpressionOperator) -> Option[ParsedUnaryOp]:
	match op:
		CompactNegateOperator:
			Some(ParsedNegateOp)
		CompactNotOperator:
			Some(ParsedNotOp)
		_:
			None


private pure func parsed_binary_operator(op: CompactExpressionOperator) -> Option[ParsedBinaryOp]:
	match op:
		CompactAddOperator:
			Some(ParsedAddOp)
		CompactSubtractOperator:
			Some(ParsedSubtractOp)
		CompactMultiplyOperator:
			Some(ParsedMultiplyOp)
		CompactDivideOperator:
			Some(ParsedDivideOp)
		CompactModuloOperator:
			Some(ParsedModuloOp)
		CompactEqualOperator:
			Some(ParsedEqualOp)
		CompactNotEqualOperator:
			Some(ParsedNotEqualOp)
		CompactLessOperator:
			Some(ParsedLessOp)
		CompactLessEqualOperator:
			Some(ParsedLessEqualOp)
		CompactGreaterOperator:
			Some(ParsedGreaterOp)
		CompactGreaterEqualOperator:
			Some(ParsedGreaterEqualOp)
		_:
			None


private pure func parsed_logical_operator(op: CompactExpressionOperator) -> Option[ParsedLogicalOp]:
	match op:
		CompactAndOperator:
			Some(ParsedAndOp)
		CompactOrOperator:
			Some(ParsedOrOp)
		_:
			None


private pure func compact_operator_matches_node(
	kind: CompactExpressionNodeKind,
	op: CompactExpressionOperator,
) -> Bool:
	match kind:
		CompactUnaryNode:
			parsed_unary_operator(op).is_some()
		CompactBinaryNode:
			parsed_binary_operator(op).is_some()
		CompactLogicalNode:
			parsed_logical_operator(op).is_some()
		_:
			False


private pure func compact_unit_matches_node(
	kind: CompactExpressionNodeKind,
	payload: CompactUnitPayloadKind,
) -> Bool:
	match kind:
		CompactBreakNode:
			payload == CompactBreakPayload
		CompactContinueNode:
			payload == CompactContinuePayload
		CompactVoidNode:
			payload == CompactVoidPayload
		CompactUnnamedBuiltinNode:
			payload == CompactUnnamedBuiltinPayload
		CompactMissingNode:
			payload == CompactMissingPayload
		_:
			False


private pure func compact_expected_child_count(
	kind: CompactExpressionNodeKind,
	call_payloads: List[CompactCallPayloadRow],
	payload_index: Int,
) -> Option[Int]:
	match kind:
		CompactUnaryNode:
			Some(1)
		CompactBinaryNode:
			Some(2)
		CompactLogicalNode:
			Some(2)
		CompactCallNode:
			match call_payloads.get(payload_index):
				Some(row):
					if row.argument_count >= 0:
						Some(row.argument_count + 1)
					else:
						None
				None:
					None
		CompactFieldAccessNode:
			Some(1)
		CompactSubscriptNode:
			None
		CompactListNode | CompactTupleNode | CompactVectorNode:
			None
		CompactRecordNode | CompactRecordUpdateNode | CompactDictNode:
			None
		CompactFinalizedInterpolationNode:
			None
		CompactBlockNode | CompactSubscriptAssignNode | CompactIfNode | CompactMatchNode | CompactSelectNode | CompactWithNode | CompactFunctionDeclNode | CompactConcurrentBlockNode | CompactConcurrentForNode:
			None
		CompactLambdaNode | CompactDetachNode:
			Some(1)
		CompactAscriptionNode | CompactOpaqueIntoNode | CompactOpaqueFromNode:
			Some(1)
		CompactRangeNode:
			Some(2)
		CompactImmutableVarDeclNode | CompactMutableVarDeclNode | CompactAssignNode | CompactCompoundAddAssignNode | CompactCompoundSubtractAssignNode | CompactCompoundMultiplyAssignNode | CompactCompoundDivideAssignNode | CompactTupleDestructNode | CompactQuestionBindNode:
			Some(1)
		CompactDebugBlockNode:
			Some(1)
		CompactWhileNode | CompactForNameNode | CompactForTupleNode:
			Some(2)
		_:
			Some(0)


private pure func compact_metadata_slice_is_valid(start: Int, count: Int, length: Int) -> Bool:
	start >= 0 and count >= 0 and start <= length and count <= length - start


private pure func compact_type_exact_child_count(kind: CompactTypeNodeKind) -> Option[Int]:
	match kind:
		CompactBoundedTypeNode | CompactDimNameTypeNode | CompactDimSplatNameTypeNode | CompactDimLiteralTypeNode | CompactMissingTypeNode:
			Some(0)
		CompactDimAddTypeNode | CompactDimSubtractTypeNode | CompactDimMultiplyTypeNode | CompactDimDivideTypeNode:
			Some(2)
		CompactRangeTypeNode:
			Some(1)
		_:
			None


private pure func compact_type_uses_identifier_slice(kind: CompactTypeNodeKind) -> Bool:
	match kind:
		CompactNamedTypeNode | CompactQualifiedNamedTypeNode | CompactBoundedTypeNode | CompactDimNameTypeNode | CompactDimSplatNameTypeNode:
			True
		_:
			False


private pure func compact_type_identifier_count_is_valid(
	kind: CompactTypeNodeKind,
	count: Int,
) -> Bool:
	match kind:
		CompactNamedTypeNode | CompactDimNameTypeNode | CompactDimSplatNameTypeNode:
			count == 1
		CompactQualifiedNamedTypeNode:
			count == 2
		CompactBoundedTypeNode:
			count >= 1
		_:
			False


private pure func compact_pattern_exact_child_count(kind: CompactPatternNodeKind) -> Option[Int]:
	match kind:
		CompactWildcardPatternNode | CompactNamePatternNode | CompactIntPatternNode | CompactFloatPatternNode | CompactStringPatternNode | CompactCharPatternNode | CompactBoolPatternNode | CompactMissingPatternNode:
			Some(0)
		_:
			None


private pure func compact_pattern_uses_identifier_slice(kind: CompactPatternNodeKind) -> Bool:
	match kind:
		CompactNamePatternNode | CompactConstructorPatternNode | CompactQualifiedConstructorPatternNode | CompactListNameSpreadPatternNode | CompactListWildcardSpreadPatternNode:
			True
		_:
			False


private pure func compact_pattern_identifier_count_is_valid(
	kind: CompactPatternNodeKind,
	count: Int,
) -> Bool:
	match kind:
		CompactNamePatternNode | CompactConstructorPatternNode | CompactListNameSpreadPatternNode:
			count == 1
		CompactQualifiedConstructorPatternNode:
			count == 2
		CompactListWildcardSpreadPatternNode:
			count == 0
		_:
			False


private pure func compact_source_span_is_valid(
	sources: List[SourceFile],
	span: CompactProductSourceLocation,
) -> Bool:
	match sources.get(span.source_owner_index):
		Some(source):
			start = source_location_start_offset(span.location)
			end = source_location_end_offset(span.location)
			start >= 0 and start <= end and end <= source.text.length()
		None:
			False


private pure func compact_expression_product_is_valid(rep: CompactExpressionProductRep) -> Bool:
	if rep.source_owners.is_empty():
		False
	else:
		var valid = True
		var parent_count = 0.repeat(rep.nodes.length())
		var root_membership = False.repeat(rep.nodes.length())
		var child_slot_owners = 0.repeat(rep.children.length())
		var owned_text_indices = 0.repeat(rep.texts.length())
		var text_owners = 0.repeat(rep.text_payloads.length())
		var string_owners = 0.repeat(rep.string_payloads.length())
		var interpolation_owners = 0.repeat(rep.interpolation_payloads.length())
		var bool_owners = 0.repeat(rep.bool_payloads.length())
		var char_owners = 0.repeat(rep.char_payloads.length())
		var operator_owners = 0.repeat(rep.operator_payloads.length())
		var call_owners = 0.repeat(rep.call_payloads.length())
		var field_access_owners = 0.repeat(rep.field_access_payloads.length())
		var record_owners = 0.repeat(rep.record_payloads.length())
		var record_field_slot_owners = 0.repeat(rep.record_fields.length())
		var dict_owners = 0.repeat(rep.dict_payloads.length())
		var dict_entry_slot_owners = 0.repeat(rep.dict_entries.length())
		var type_parent_count = 0.repeat(rep.type_nodes.length())
		var type_root_membership = False.repeat(rep.type_nodes.length())
		var type_child_slot_owners = 0.repeat(rep.type_children.length())
		var type_identifier_slice_owners = 0.repeat(rep.type_identifier_slices.length())
		var type_identifier_owners = 0.repeat(rep.type_identifiers.length())
		var interpolation_parts_payload_owners = 0.repeat(rep.interpolation_parts_payloads.length())
		var interpolation_part_slot_owners = 0.repeat(rep.interpolation_parts.length())
		var control_identifier_owners = 0.repeat(rep.control_identifiers.length())
		var identifier_slice_owners = 0.repeat(rep.identifier_slices.length())
		var typed_binder_owners = 0.repeat(rep.typed_binders.length())
		var pattern_parent_count = 0.repeat(rep.pattern_nodes.length())
		var pattern_root_membership = False.repeat(rep.pattern_nodes.length())
		var pattern_child_slot_owners = 0.repeat(rep.pattern_children.length())
		var pattern_identifier_slice_owners = 0.repeat(rep.pattern_identifier_slices.length())
		var pattern_identifier_owners = 0.repeat(rep.pattern_identifiers.length())
		var match_case_slot_owners = 0.repeat(rep.match_cases.length())
		var select_arm_slot_owners = 0.repeat(rep.select_arms.length())
		var with_binding_owners = 0.repeat(rep.with_bindings.length())
		var with_error_map_owners = 0.repeat(rep.with_error_maps.length())
		var lambda_payload_owners = 0.repeat(rep.lambda_payloads.length())
		var function_payload_owners = 0.repeat(rep.function_payloads.length())
		var callable_param_slot_owners = 0.repeat(rep.callable_params.length())
		var callable_type_param_slot_owners = 0.repeat(rep.callable_type_params.length())
		var callable_dim_constraint_slot_owners = 0.repeat(rep.callable_dim_constraints.length())
		var function_annotation_slot_owners = 0.repeat(rep.function_annotations.length())
		var concurrent_param_slot_owners = 0.repeat(rep.concurrent_params.length())
		var concurrent_for_payload_owners = 0.repeat(rep.concurrent_for_payloads.length())
		var validated_pattern_binding_counts = 0.repeat(rep.pattern_nodes.length())
		var unit_owners = 0.repeat(rep.unit_payloads.length())

		for root in rep.roots:
			if root < 0 or root >= rep.nodes.length():
				valid = False
			else if (
				root_membership
					.get(root)
					.get_or(False)
			):
				valid = False
			else:
				root_membership = root_membership.set(root, True)

		var node_index: Int = 0

		while node_index < rep.nodes.length() and valid:
			match rep.nodes.get(node_index):
				Some(node):
					if not compact_source_span_is_valid(rep.source_owners, node.span):
						valid = False

					if (
						node.child_start < 0
						or node.child_count < 0
						or node.child_start > rep.children.length()
						or node.child_count > rep.children.length() - node.child_start
					):
						valid = False

					match compact_expected_child_count(
						node.kind,
						rep.call_payloads,
						node.payload_index,
					):
						Some(expected):
							if node.child_count != expected:
								valid = False
						None:
							match node.kind:
								CompactSubscriptNode:
									valid = (
										node.child_count >= 1
										and node.payload_index == NO_COMPACT_PAYLOAD_INDEX
									)
								CompactListNode | CompactTupleNode | CompactVectorNode:
									valid = node.payload_index == NO_COMPACT_PAYLOAD_INDEX
								CompactRecordNode | CompactRecordUpdateNode:
									match rep.record_payloads.get(node.payload_index):
										Some(payload):
											valid = (
												compact_metadata_slice_is_valid(
													payload.field_start,
													payload.field_count,
													rep.record_fields.length(),
												)
												and ((
													(
														node.kind == CompactRecordNode
														and node.child_count == payload.field_count
													)
													or (
														node.kind == CompactRecordUpdateNode
														and node.child_count >= 1
														and node.child_count - 1 == payload.field_count
													)
												))
											)
										None:
											valid = False
								CompactDictNode:
									match rep.dict_payloads.get(node.payload_index):
										Some(payload):
											valid = (
												compact_metadata_slice_is_valid(
													payload.entry_start,
													payload.entry_count,
													rep.dict_entries.length(),
												)
												and node.child_count % 2 == 0
												and node.child_count / 2 == payload.entry_count
											)
										None:
											valid = False
								CompactFinalizedInterpolationNode:
									match rep.interpolation_parts_payloads.get(node.payload_index):
										Some(payload):
											valid = compact_metadata_slice_is_valid(
												payload.part_start,
												payload.part_count,
												rep.interpolation_parts.length(),
											)
										None:
											valid = False
								CompactBlockNode | CompactDebugBlockNode | CompactWhileNode:
									valid = node.payload_index == NO_COMPACT_PAYLOAD_INDEX
								CompactIfNode:
									valid = (
										(node.child_count == 2 or node.child_count == 3)
										and node.payload_index == NO_COMPACT_PAYLOAD_INDEX
									)
								CompactSubscriptAssignNode:
									valid = (
										node.child_count >= 2
										and node.payload_index == NO_COMPACT_PAYLOAD_INDEX
									)
								CompactForNameNode:
									valid = (
										node.payload_index >= 0
										and node.payload_index < rep.control_identifiers.length()
									)
								CompactForTupleNode:
									valid = (
										node.payload_index >= 0
										and node.payload_index < rep.identifier_slices.length()
									)
								CompactMatchNode:
									valid = (
										node.child_count >= 1
										and compact_metadata_slice_is_valid(
											node.payload_index,
											node.child_count - 1,
											rep.match_cases.length(),
										)
									)
								CompactSelectNode:
									valid = (
										node.child_count % 2 == 0
										and compact_metadata_slice_is_valid(
											node.payload_index,
											node.child_count / 2,
											rep.select_arms.length(),
										)
									)
								CompactWithNode:
									match rep.with_bindings.get(node.payload_index):
										Some(binding):
											expected = if binding.error_map_index == NO_COMPACT_ERROR_MAP_INDEX:
												2
											else:
												3

											valid = node.child_count == expected
										None:
											valid = False
								CompactLambdaNode:
									match rep.lambda_payloads.get(node.payload_index):
										Some(payload):
											valid = compact_metadata_slice_is_valid(
												payload.parameter_start,
												payload.parameter_count,
												rep.callable_params.length(),
											)
										None:
											valid = False
								CompactFunctionDeclNode:
									match rep.function_payloads.get(node.payload_index):
										Some(payload):
											valid = (
												(node.child_count == 0 or node.child_count == 1)
												and compact_metadata_slice_is_valid(
													payload.type_parameter_start,
													payload.type_parameter_count,
													rep.callable_type_params.length(),
												)
												and compact_metadata_slice_is_valid(
													payload.parameter_start,
													payload.parameter_count,
													rep.callable_params.length(),
												)
												and compact_metadata_slice_is_valid(
													payload.dimension_constraint_start,
													payload.dimension_constraint_count,
													rep.callable_dim_constraints.length(),
												)
												and compact_metadata_slice_is_valid(
													payload.annotation_start,
													payload.annotation_count,
													rep.function_annotations.length(),
												)
											)
										None:
											valid = False
								CompactConcurrentBlockNode:
									valid = (
										node.child_count >= 1
										and compact_metadata_slice_is_valid(
											node.payload_index,
											node.child_count - 1,
											rep.concurrent_params.length(),
										)
									)
								CompactConcurrentForNode:
									if node.child_count < 2:
										valid = False
									else:
										match rep.concurrent_for_payloads.get(node.payload_index):
											Some(payload):
												valid = compact_metadata_slice_is_valid(
													payload.parameter_start,
													node.child_count - 2,
													rep.concurrent_params.length(),
												)
											None:
												valid = False
								_:
									valid = False

					var child_offset: Int = 0

					while child_offset < node.child_count and valid:
						child_slot = node.child_start + child_offset

						match rep.children.get(child_slot):
							Some(child):
								if child < 0 or child >= node_index:
									valid = False
								else:
									parent_count = parent_count.set(child, parent_count
											.get(child)
											.get_or(0) + 1)
									child_slot_owners = child_slot_owners.set(
										child_slot,
										child_slot_owners
											.get(child_slot)
											.get_or(0) + 1,
									)
							None:
								valid = False

						child_offset += 1

					match node.kind:
						CompactNameNode | CompactIntNode | CompactFloatNode | CompactNamedBuiltinNode:
							match rep.text_payloads.get(node.payload_index):
								Some(payload):
									if (
										payload.text_index < 0
										or payload.text_index >= rep.texts.length()
									):
										valid = False
									else:
										text_owners = text_owners.set(
											node.payload_index,
											text_owners
												.get(node.payload_index)
												.get_or(0) + 1,
										)
										owned_text_indices = owned_text_indices.set(
											payload.text_index,
											owned_text_indices
												.get(payload.text_index)
												.get_or(0) + 1,
										)
								None:
									valid = False
						CompactStringNode:
							match rep.string_payloads.get(node.payload_index):
								Some(payload):
									if (
										payload.text_index < 0
										or payload.text_index >= rep.texts.length()
									):
										valid = False
									else:
										string_owners = string_owners.set(
											node.payload_index,
											string_owners
												.get(node.payload_index)
												.get_or(0) + 1,
										)
										owned_text_indices = owned_text_indices.set(
											payload.text_index,
											owned_text_indices
												.get(payload.text_index)
												.get_or(0) + 1,
										)
								None:
									valid = False
						CompactInterpolationNode:
							match rep.interpolation_payloads.get(node.payload_index):
								Some(payload):
									if (
										payload.text_index < 0
										or payload.text_index >= rep.texts.length()
									):
										valid = False
									else:
										interpolation_owners = interpolation_owners.set(
											node.payload_index,
											interpolation_owners
												.get(node.payload_index)
												.get_or(0) + 1,
										)
										owned_text_indices = owned_text_indices.set(
											payload.text_index,
											owned_text_indices
												.get(payload.text_index)
												.get_or(0) + 1,
										)
								None:
									valid = False
						CompactBoolNode:
							if node.payload_index < 0 or node.payload_index >= bool_owners.length():
								valid = False
							else:
								bool_owners = bool_owners.set(node.payload_index, bool_owners
										.get(node.payload_index)
										.get_or(0) + 1)
						CompactCharNode:
							if node.payload_index < 0 or node.payload_index >= char_owners.length():
								valid = False
							else:
								char_owners = char_owners.set(node.payload_index, char_owners
										.get(node.payload_index)
										.get_or(0) + 1)
						CompactUnaryNode | CompactBinaryNode | CompactLogicalNode:
							match rep.operator_payloads.get(node.payload_index):
								Some(payload):
									if compact_operator_matches_node(node.kind, payload.operator):
										operator_owners = operator_owners.set(
											node.payload_index,
											operator_owners
												.get(node.payload_index)
												.get_or(0) + 1,
										)
									else:
										valid = False
								None:
									valid = False
						CompactCallNode:
							if node.payload_index < 0 or node.payload_index >= call_owners.length():
								valid = False
							else:
								call_owners = call_owners.set(node.payload_index, call_owners
										.get(node.payload_index)
										.get_or(0) + 1)
						CompactFieldAccessNode:
							match rep.field_access_payloads.get(node.payload_index):
								Some(payload):
									if (
										not compact_source_span_is_valid(
											rep.source_owners,
											payload.field_span,
										)
										or payload.field_text_index < 0
										or payload.field_text_index >= rep.texts.length()
									):
										valid = False
									else:
										field_access_owners = field_access_owners.set(
											node.payload_index,
											field_access_owners
												.get(node.payload_index)
												.get_or(0) + 1,
										)
										owned_text_indices = owned_text_indices.set(
											payload.field_text_index,
											owned_text_indices
												.get(payload.field_text_index)
												.get_or(0) + 1,
										)
								None:
									valid = False
						CompactSubscriptNode | CompactListNode | CompactTupleNode | CompactVectorNode:
							void
						CompactRecordNode | CompactRecordUpdateNode:
							match rep.record_payloads.get(node.payload_index):
								Some(payload):
									record_owners = record_owners.set(
										node.payload_index,
										record_owners
											.get(node.payload_index)
											.get_or(0) + 1,
									)
									var field_offset: Int = 0

									while field_offset < payload.field_count and valid:
										field_slot = payload.field_start + field_offset

										match rep.record_fields.get(field_slot):
											Some(field):
												if (
													not compact_source_span_is_valid(
														rep.source_owners,
														field.name_span,
													)
													or not compact_source_span_is_valid(
														rep.source_owners,
														field.field_span,
													)
													or field.name_text_index < 0
													or field.name_text_index >= rep.texts.length()
												):
													valid = False
												else:
													record_field_slot_owners = record_field_slot_owners.set(
														field_slot,
														record_field_slot_owners
															.get(field_slot)
															.get_or(0) + 1,
													)
													owned_text_indices = owned_text_indices.set(
														field.name_text_index,
														owned_text_indices
															.get(field.name_text_index)
															.get_or(0) + 1,
													)
											None:
												valid = False

										field_offset += 1
								None:
									valid = False
						CompactDictNode:
							match rep.dict_payloads.get(node.payload_index):
								Some(payload):
									dict_owners = dict_owners.set(node.payload_index, dict_owners
											.get(node.payload_index)
											.get_or(0) + 1)
									var entry_offset: Int = 0

									while entry_offset < payload.entry_count and valid:
										entry_slot = payload.entry_start + entry_offset

										match rep.dict_entries.get(entry_slot):
											Some(entry):
												if not compact_source_span_is_valid(
													rep.source_owners,
													entry.entry_span,
												):
													valid = False
												else:
													dict_entry_slot_owners = dict_entry_slot_owners.set(
														entry_slot,
														dict_entry_slot_owners
															.get(entry_slot)
															.get_or(0) + 1,
													)
											None:
												valid = False

										entry_offset += 1
								None:
									valid = False
						CompactFinalizedInterpolationNode:
							match rep.interpolation_parts_payloads.get(node.payload_index):
								Some(payload):
									interpolation_parts_payload_owners = interpolation_parts_payload_owners.set(
										node.payload_index,
										interpolation_parts_payload_owners
											.get(node.payload_index)
											.get_or(0) + 1,
									)
									var expression_ordinal_owners = 0.repeat(node.child_count)
									var part_offset: Int = 0

									while part_offset < payload.part_count and valid:
										part_slot = payload.part_start + part_offset

										match rep.interpolation_parts.get(part_slot):
											Some(part):
												interpolation_part_slot_owners = interpolation_part_slot_owners.set(
													part_slot,
													interpolation_part_slot_owners
														.get(part_slot)
														.get_or(0) + 1,
												)

												match part.kind:
													CompactInterpolationLiteralPart:
														if (
															part.payload_index < 0
															or part.payload_index >= rep.texts.length()
														):
															valid = False
														else:
															owned_text_indices = owned_text_indices.set(
																part.payload_index,
																owned_text_indices
																	.get(part.payload_index)
																	.get_or(0) + 1,
															)
													CompactInterpolationExpressionPart:
														if (
															part.payload_index < 0
															or part.payload_index >= node.child_count
														):
															valid = False
														else:
															expression_ordinal_owners = expression_ordinal_owners.set(
																part.payload_index,
																expression_ordinal_owners
																	.get(part.payload_index)
																	.get_or(0) + 1,
															)
											None:
												valid = False

										part_offset += 1

									for owners in expression_ordinal_owners:
										valid = valid and owners == 1
								None:
									valid = False
						CompactAscriptionNode | CompactOpaqueIntoNode | CompactOpaqueFromNode:
							if (
								node.payload_index < 0
								or node.payload_index >= rep.type_nodes.length()
							):
								valid = False
							else if (
								type_root_membership
									.get(node.payload_index)
									.get_or(False)
							):
								valid = False
							else:
								type_root_membership = type_root_membership.set(
									node.payload_index,
									True,
								)
						CompactRangeNode:
							if node.payload_index != NO_COMPACT_PAYLOAD_INDEX:
								valid = False
						CompactBlockNode | CompactSubscriptAssignNode | CompactIfNode | CompactDebugBlockNode | CompactWhileNode:
							if node.payload_index != NO_COMPACT_PAYLOAD_INDEX:
								valid = False
						CompactMatchNode:
							var case_offset: Int = 0

							while case_offset < node.child_count - 1 and valid:
								case_slot = node.payload_index + case_offset

								match rep.match_cases.get(case_slot):
									Some(case):
										if (
											not compact_source_span_is_valid(
												rep.source_owners,
												case.span,
											)
											or case.pattern_root_index < 0
											or case.pattern_root_index >= rep.pattern_nodes.length()
											or case.binding_count < 0
											or pattern_root_membership
												.get(case.pattern_root_index)
												.get_or(False)
										):
											valid = False
										else:
											pattern_root_membership = pattern_root_membership.set(
												case.pattern_root_index,
												True,
											)
											match_case_slot_owners = match_case_slot_owners.set(
												case_slot,
												match_case_slot_owners
													.get(case_slot)
													.get_or(0) + 1,
											)
									None:
										valid = False

								case_offset += 1
						CompactSelectNode:
							var arm_offset: Int = 0

							while arm_offset < node.child_count / 2 and valid:
								arm_slot = node.payload_index + arm_offset

								match rep.select_arms.get(arm_slot):
									Some(arm):
										if not compact_source_span_is_valid(
											rep.source_owners,
											arm.span,
										):
											valid = False
										else:
											match arm.kind:
												CompactSelectReceiveArm:
													if (
														arm.binder_identifier_index < 0
														or arm.binder_identifier_index >= rep.control_identifiers.length()
													):
														valid = False
													else:
														control_identifier_owners = control_identifier_owners.set(
															arm.binder_identifier_index,
															control_identifier_owners
																.get(arm.binder_identifier_index)
																.get_or(0) + 1,
														)
												CompactSelectSealedArm | CompactSelectAfterArm:
													if arm.binder_identifier_index != NO_COMPACT_IDENTIFIER_INDEX:
														valid = False

											select_arm_slot_owners = select_arm_slot_owners.set(
												arm_slot,
												select_arm_slot_owners
													.get(arm_slot)
													.get_or(0) + 1,
											)
									None:
										valid = False

								arm_offset += 1
						CompactWithNode:
							match rep.with_bindings.get(node.payload_index):
								Some(binding):
									if (
										not compact_source_span_is_valid(
											rep.source_owners,
											binding.span,
										)
										or binding.binding_identifier_index < 0
										or binding.binding_identifier_index >= rep.control_identifiers.length()
										or (
											binding.kind == CompactWithPlainBinding
											and binding.error_map_index != NO_COMPACT_ERROR_MAP_INDEX
										)
									):
										valid = False
									else:
										with_binding_owners = with_binding_owners.set(
											node.payload_index,
											with_binding_owners
												.get(node.payload_index)
												.get_or(0) + 1,
										)
										control_identifier_owners = control_identifier_owners.set(
											binding.binding_identifier_index,
											control_identifier_owners
												.get(binding.binding_identifier_index)
												.get_or(0) + 1,
										)

									if binding.type_root_index != NO_COMPACT_TYPE_ROOT_INDEX:
										if (
											binding.type_root_index < 0
											or binding.type_root_index >= rep.type_nodes.length()
											or type_root_membership
												.get(binding.type_root_index)
												.get_or(False)
										):
											valid = False
										else:
											type_root_membership = type_root_membership.set(
												binding.type_root_index,
												True,
											)

									if binding.error_map_index != NO_COMPACT_ERROR_MAP_INDEX:
										match rep.with_error_maps.get(binding.error_map_index):
											Some(error_map):
												if (
													not compact_source_span_is_valid(
														rep.source_owners,
														error_map.span,
													)
													or error_map.identifier_index < 0
													or error_map.identifier_index >= rep.control_identifiers.length()
												):
													valid = False
												else:
													with_error_map_owners = with_error_map_owners.set(
														binding.error_map_index,
														with_error_map_owners
															.get(binding.error_map_index)
															.get_or(0) + 1,
													)
													control_identifier_owners = control_identifier_owners.set(
														error_map.identifier_index,
														control_identifier_owners
															.get(error_map.identifier_index)
															.get_or(0) + 1,
													)
											None:
												valid = False
								None:
									valid = False
						CompactLambdaNode:
							match rep.lambda_payloads.get(node.payload_index):
								Some(payload):
									lambda_payload_owners = lambda_payload_owners.set(
										node.payload_index,
										lambda_payload_owners
											.get(node.payload_index)
											.get_or(0) + 1,
									)
									var parameter_offset: Int = 0

									while parameter_offset < payload.parameter_count and valid:
										parameter_slot = payload.parameter_start + parameter_offset

										match rep.callable_params.get(parameter_slot):
											Some(parameter):
												if (
													parameter.kind != CompactLambdaNameParam
													or not compact_source_span_is_valid(
														rep.source_owners,
														parameter.span,
													)
													or parameter.binder_payload_index < 0
													or parameter.binder_payload_index >= rep.control_identifiers.length()
												):
													valid = False
												else:
													control_identifier_owners = control_identifier_owners.set(
														parameter.binder_payload_index,
														control_identifier_owners
															.get(parameter.binder_payload_index)
															.get_or(0) + 1,
													)

												if parameter.type_root_index != NO_COMPACT_TYPE_ROOT_INDEX:
													if (
														parameter.type_root_index < 0
														or parameter.type_root_index >= rep.type_nodes.length()
														or type_root_membership
															.get(parameter.type_root_index)
															.get_or(False)
													):
														valid = False
													else:
														type_root_membership = type_root_membership.set(
															parameter.type_root_index,
															True,
														)

												callable_param_slot_owners = callable_param_slot_owners.set(
													parameter_slot,
													callable_param_slot_owners
														.get(parameter_slot)
														.get_or(0) + 1,
												)
											None:
												valid = False

										parameter_offset += 1

									if payload.return_type_root_index != NO_COMPACT_TYPE_ROOT_INDEX:
										if (
											payload.return_type_root_index < 0
											or payload.return_type_root_index >= rep.type_nodes.length()
											or type_root_membership
												.get(payload.return_type_root_index)
												.get_or(False)
										):
											valid = False
										else:
											type_root_membership = type_root_membership.set(
												payload.return_type_root_index,
												True,
											)
								None:
									valid = False
						CompactFunctionDeclNode:
							match rep.function_payloads.get(node.payload_index):
								Some(payload):
									function_payload_owners = function_payload_owners.set(
										node.payload_index,
										function_payload_owners
											.get(node.payload_index)
											.get_or(0) + 1,
									)

									if (
										payload.name_identifier_index < 0
										or payload.name_identifier_index >= rep.control_identifiers.length()
									):
										valid = False
									else:
										control_identifier_owners = control_identifier_owners.set(
											payload.name_identifier_index,
											control_identifier_owners
												.get(payload.name_identifier_index)
												.get_or(0) + 1,
										)

									if payload.keyword_span.source_owner_index == NO_COMPACT_SOURCE_OWNER_INDEX:
										if not source_locations_equal(
											payload.keyword_span.location,
											node.span.location,
										):
											valid = False
									else if not compact_source_span_is_valid(
										rep.source_owners,
										payload.keyword_span,
									):
										valid = False

									if payload.doc_text_index != NO_COMPACT_TEXT_INDEX:
										if (
											payload.doc_text_index < 0
											or payload.doc_text_index >= rep.texts.length()
										):
											valid = False
										else:
											owned_text_indices = owned_text_indices.set(
												payload.doc_text_index,
												owned_text_indices
													.get(payload.doc_text_index)
													.get_or(0) + 1,
											)

									var type_parameter_offset: Int = 0

									while (
										type_parameter_offset < payload.type_parameter_count
										and valid
									):
										type_parameter_slot = payload.type_parameter_start + type_parameter_offset

										match rep.callable_type_params.get(type_parameter_slot):
											Some(type_parameter):
												if (
													not compact_source_span_is_valid(
														rep.source_owners,
														type_parameter.span,
													)
													or type_parameter.name_identifier_index < 0
													or type_parameter.name_identifier_index >= rep.type_identifiers.length()
													or not compact_metadata_slice_is_valid(
														type_parameter.bound_identifier_start,
														type_parameter.bound_identifier_count,
														rep.type_identifiers.length(),
													)
												):
													valid = False
												else:
													type_identifier_owners = type_identifier_owners.set(
														type_parameter.name_identifier_index,
														type_identifier_owners
															.get(
																type_parameter.name_identifier_index,
															)
															.get_or(0) + 1,
													)

													match rep.type_identifiers.get(
														type_parameter.name_identifier_index,
													):
														Some(identifier):
															if (
																not compact_source_span_is_valid(
																	rep.source_owners,
																	identifier.span,
																)
																or identifier.text_index < 0
																or identifier.text_index >= rep.texts.length()
															):
																valid = False
															else:
																owned_text_indices = owned_text_indices.set(
																	identifier.text_index,
																	owned_text_indices
																		.get(identifier.text_index)
																		.get_or(0) + 1,
																)
														None:
															valid = False

													var bound_offset: Int = 0

													while bound_offset < type_parameter.bound_identifier_count:
														bound_index = type_parameter.bound_identifier_start + bound_offset
														type_identifier_owners = type_identifier_owners.set(
															bound_index,
															type_identifier_owners
																.get(bound_index)
																.get_or(0) + 1,
														)

														match rep.type_identifiers.get(bound_index):
															Some(identifier):
																if (
																	not compact_source_span_is_valid(
																		rep.source_owners,
																		identifier.span,
																	)
																	or identifier.text_index < 0
																	or identifier.text_index >= rep.texts.length()
																):
																	valid = False
																else:
																	owned_text_indices = owned_text_indices.set(
																		identifier.text_index,
																		owned_text_indices
																			.get(
																				identifier.text_index,
																			)
																			.get_or(0) + 1,
																	)
															None:
																valid = False

														bound_offset += 1

													callable_type_param_slot_owners = callable_type_param_slot_owners.set(
														type_parameter_slot,
														callable_type_param_slot_owners
															.get(type_parameter_slot)
															.get_or(0) + 1,
													)
											None:
												valid = False

										type_parameter_offset += 1

									var parameter_offset: Int = 0

									while parameter_offset < payload.parameter_count and valid:
										parameter_slot = payload.parameter_start + parameter_offset

										match rep.callable_params.get(parameter_slot):
											Some(parameter):
												if not compact_source_span_is_valid(
													rep.source_owners,
													parameter.span,
												):
													valid = False
												else:
													match parameter.kind:
														CompactFunctionNameParam:
															if (
																parameter.binder_payload_index < 0
																or parameter.binder_payload_index >= rep.control_identifiers.length()
															):
																valid = False
															else:
																control_identifier_owners = control_identifier_owners.set(
																	parameter.binder_payload_index,
																	control_identifier_owners
																		.get(
																			parameter.binder_payload_index,
																		)
																		.get_or(0) + 1,
																)
														CompactFunctionWildcardParam | CompactFunctionTupleParam:
															match rep.identifier_slices.get(
																parameter.binder_payload_index,
															):
																Some(slice):
																	if (
																		not compact_source_span_is_valid(
																			rep.source_owners,
																			slice.span,
																		)
																		or not compact_metadata_slice_is_valid(
																			slice.identifier_start,
																			slice.identifier_count,
																			rep.control_identifiers.length(),
																		)
																		or (
																			parameter.kind == CompactFunctionWildcardParam
																			and slice.identifier_count != 0
																		)
																	):
																		valid = False
																	else:
																		identifier_slice_owners = identifier_slice_owners.set(
																			parameter.binder_payload_index,
																			identifier_slice_owners
																				.get(
																					parameter.binder_payload_index,
																				)
																				.get_or(0) + 1,
																		)
																		var identifier_offset: Int = 0

																		while identifier_offset < slice.identifier_count:
																			identifier_index = slice.identifier_start + identifier_offset
																			control_identifier_owners = control_identifier_owners.set(
																				identifier_index,
																				control_identifier_owners
																					.get(
																						identifier_index,
																					)
																					.get_or(0) + 1,
																			)
																			identifier_offset += 1
																None:
																	valid = False
														CompactLambdaNameParam:
															valid = False

												if parameter.type_root_index != NO_COMPACT_TYPE_ROOT_INDEX:
													if (
														parameter.type_root_index < 0
														or parameter.type_root_index >= rep.type_nodes.length()
														or type_root_membership
															.get(parameter.type_root_index)
															.get_or(False)
													):
														valid = False
													else:
														type_root_membership = type_root_membership.set(
															parameter.type_root_index,
															True,
														)

												callable_param_slot_owners = callable_param_slot_owners.set(
													parameter_slot,
													callable_param_slot_owners
														.get(parameter_slot)
														.get_or(0) + 1,
												)
											None:
												valid = False

										parameter_offset += 1

									if payload.return_type_root_index != NO_COMPACT_TYPE_ROOT_INDEX:
										if (
											payload.return_type_root_index < 0
											or payload.return_type_root_index >= rep.type_nodes.length()
											or type_root_membership
												.get(payload.return_type_root_index)
												.get_or(False)
										):
											valid = False
										else:
											type_root_membership = type_root_membership.set(
												payload.return_type_root_index,
												True,
											)

									var constraint_offset: Int = 0

									while (
										constraint_offset < payload.dimension_constraint_count
										and valid
									):
										constraint_slot = payload.dimension_constraint_start + constraint_offset

										match rep.callable_dim_constraints.get(constraint_slot):
											Some(constraint):
												if not compact_source_span_is_valid(
													rep.source_owners,
													constraint.span,
												):
													valid = False

												for type_root_index in [
													constraint.left_type_root_index,
													constraint.right_type_root_index,
												]:
													if (
														type_root_index < 0
														or type_root_index >= rep.type_nodes.length()
														or type_root_membership
															.get(type_root_index)
															.get_or(False)
													):
														valid = False
													else:
														type_root_membership = type_root_membership.set(
															type_root_index,
															True,
														)

												callable_dim_constraint_slot_owners = callable_dim_constraint_slot_owners.set(
													constraint_slot,
													callable_dim_constraint_slot_owners
														.get(constraint_slot)
														.get_or(0) + 1,
												)
											None:
												valid = False

										constraint_offset += 1

									var annotation_offset: Int = 0

									while annotation_offset < payload.annotation_count:
										annotation_slot = payload.annotation_start + annotation_offset
										function_annotation_slot_owners = function_annotation_slot_owners.set(
											annotation_slot,
											function_annotation_slot_owners
												.get(annotation_slot)
												.get_or(0) + 1,
										)
										annotation_offset += 1
								None:
									valid = False
						CompactConcurrentBlockNode:
							var parameter_offset: Int = 0
							parameter_count = node.child_count - 1

							while parameter_offset < parameter_count and valid:
								parameter_slot = node.payload_index + parameter_offset

								match rep.concurrent_params.get(parameter_slot):
									Some(parameter):
										if (
											not compact_source_span_is_valid(
												rep.source_owners,
												parameter.span,
											)
											or parameter.name_identifier_index < 0
											or parameter.name_identifier_index >= rep.control_identifiers.length()
										):
											valid = False
										else:
											concurrent_param_slot_owners = concurrent_param_slot_owners.set(
												parameter_slot,
												concurrent_param_slot_owners
													.get(parameter_slot)
													.get_or(0) + 1,
											)
											control_identifier_owners = control_identifier_owners.set(
												parameter.name_identifier_index,
												control_identifier_owners
													.get(parameter.name_identifier_index)
													.get_or(0) + 1,
											)
									None:
										valid = False

								parameter_offset += 1
						CompactConcurrentForNode:
							match rep.concurrent_for_payloads.get(node.payload_index):
								Some(payload):
									if (
										payload.binder_identifier_index < 0
										or payload.binder_identifier_index >= rep.control_identifiers.length()
									):
										valid = False
									else:
										concurrent_for_payload_owners = concurrent_for_payload_owners.set(
											node.payload_index,
											concurrent_for_payload_owners
												.get(node.payload_index)
												.get_or(0) + 1,
										)
										control_identifier_owners = control_identifier_owners.set(
											payload.binder_identifier_index,
											control_identifier_owners
												.get(payload.binder_identifier_index)
												.get_or(0) + 1,
										)

									var parameter_offset: Int = 0
									parameter_count = node.child_count - 2

									while parameter_offset < parameter_count and valid:
										parameter_slot = payload.parameter_start + parameter_offset

										match rep.concurrent_params.get(parameter_slot):
											Some(parameter):
												if (
													not compact_source_span_is_valid(
														rep.source_owners,
														parameter.span,
													)
													or parameter.name_identifier_index < 0
													or parameter.name_identifier_index >= rep.control_identifiers.length()
												):
													valid = False
												else:
													concurrent_param_slot_owners = concurrent_param_slot_owners.set(
														parameter_slot,
														concurrent_param_slot_owners
															.get(parameter_slot)
															.get_or(0) + 1,
													)
													control_identifier_owners = control_identifier_owners.set(
														parameter.name_identifier_index,
														control_identifier_owners
															.get(parameter.name_identifier_index)
															.get_or(0) + 1,
													)
											None:
												valid = False

										parameter_offset += 1
								None:
									valid = False
						CompactDetachNode:
							if node.payload_index != NO_COMPACT_PAYLOAD_INDEX:
								valid = False
						CompactImmutableVarDeclNode | CompactMutableVarDeclNode | CompactQuestionBindNode:
							match rep.typed_binders.get(node.payload_index):
								Some(payload):
									if (
										payload.identifier_index < 0
										or payload.identifier_index >= rep.control_identifiers.length()
									):
										valid = False
									else:
										typed_binder_owners = typed_binder_owners.set(
											node.payload_index,
											typed_binder_owners
												.get(node.payload_index)
												.get_or(0) + 1,
										)
										control_identifier_owners = control_identifier_owners.set(
											payload.identifier_index,
											control_identifier_owners
												.get(payload.identifier_index)
												.get_or(0) + 1,
										)

									if payload.type_root_index != NO_COMPACT_TYPE_ROOT_INDEX:
										if (
											payload.type_root_index < 0
											or payload.type_root_index >= rep.type_nodes.length()
											or type_root_membership
												.get(payload.type_root_index)
												.get_or(False)
										):
											valid = False
										else:
											type_root_membership = type_root_membership.set(
												payload.type_root_index,
												True,
											)
								None:
									valid = False
						CompactAssignNode | CompactCompoundAddAssignNode | CompactCompoundSubtractAssignNode | CompactCompoundMultiplyAssignNode | CompactCompoundDivideAssignNode | CompactForNameNode:
							if (
								node.payload_index < 0
								or node.payload_index >= rep.control_identifiers.length()
							):
								valid = False
							else:
								control_identifier_owners = control_identifier_owners.set(
									node.payload_index,
									control_identifier_owners
										.get(node.payload_index)
										.get_or(0) + 1,
								)
						CompactTupleDestructNode | CompactForTupleNode:
							match rep.identifier_slices.get(node.payload_index):
								Some(payload):
									if (
										not compact_metadata_slice_is_valid(
											payload.identifier_start,
											payload.identifier_count,
											rep.control_identifiers.length(),
										)
										or not compact_source_span_is_valid(
											rep.source_owners,
											payload.span,
										)
									):
										valid = False
									else:
										identifier_slice_owners = identifier_slice_owners.set(
											node.payload_index,
											identifier_slice_owners
												.get(node.payload_index)
												.get_or(0) + 1,
										)
										var identifier_offset: Int = 0

										while identifier_offset < payload.identifier_count:
											identifier_index = payload.identifier_start + identifier_offset
											control_identifier_owners = control_identifier_owners.set(
												identifier_index,
												control_identifier_owners
													.get(identifier_index)
													.get_or(0) + 1,
											)
											identifier_offset += 1
								None:
									valid = False
						CompactBreakNode | CompactContinueNode | CompactVoidNode | CompactUnnamedBuiltinNode | CompactMissingNode:
							match rep.unit_payloads.get(node.payload_index):
								Some(payload):
									if compact_unit_matches_node(node.kind, payload.kind):
										unit_owners = unit_owners.set(
											node.payload_index,
											unit_owners
												.get(node.payload_index)
												.get_or(0) + 1,
										)
									else:
										valid = False
								None:
									valid = False
				None:
					valid = False

			node_index += 1

		var type_node_index: Int = 0

		while type_node_index < rep.type_nodes.length() and valid:
			match rep.type_nodes.get(type_node_index):
				Some(node):
					if not compact_source_span_is_valid(rep.source_owners, node.span):
						valid = False

					if (
						node.child_start < 0
						or node.child_count < 0
						or node.child_start > rep.type_children.length()
						or node.child_count > rep.type_children.length() - node.child_start
					):
						valid = False

					match compact_type_exact_child_count(node.kind):
						Some(expected):
							if node.child_count != expected:
								valid = False
						None:
							match node.kind:
								CompactNamedTypeNode | CompactQualifiedNamedTypeNode | CompactTupleTypeNode:
									void
								CompactPureFunctionTypeNode | CompactImpureFunctionTypeNode | CompactArrayTypeNode:
									if node.child_count < 1:
										valid = False
								_:
									valid = False

					var child_offset: Int = 0

					while child_offset < node.child_count and valid:
						child_slot = node.child_start + child_offset

						match rep.type_children.get(child_slot):
							Some(child):
								if child < 0 or child >= type_node_index:
									valid = False
								else:
									type_parent_count = type_parent_count.set(
										child,
										type_parent_count
											.get(child)
											.get_or(0) + 1,
									)
									type_child_slot_owners = type_child_slot_owners.set(
										child_slot,
										type_child_slot_owners
											.get(child_slot)
											.get_or(0) + 1,
									)
							None:
								valid = False

						child_offset += 1

					if compact_type_uses_identifier_slice(node.kind):
						match rep.type_identifier_slices.get(node.payload_index):
							Some(payload):
								if (
									not compact_metadata_slice_is_valid(
										payload.identifier_start,
										payload.identifier_count,
										rep.type_identifiers.length(),
									)
									or not compact_type_identifier_count_is_valid(
										node.kind,
										payload.identifier_count,
									)
								):
									valid = False
								else:
									type_identifier_slice_owners = type_identifier_slice_owners.set(
										node.payload_index,
										type_identifier_slice_owners
											.get(node.payload_index)
											.get_or(0) + 1,
									)
									var identifier_offset: Int = 0

									while identifier_offset < payload.identifier_count and valid:
										identifier_slot = payload.identifier_start + identifier_offset

										match rep.type_identifiers.get(identifier_slot):
											Some(identifier):
												if (
													not compact_source_span_is_valid(
														rep.source_owners,
														identifier.span,
													)
													or identifier.text_index < 0
													or identifier.text_index >= rep.texts.length()
												):
													valid = False
												else:
													type_identifier_owners = type_identifier_owners.set(
														identifier_slot,
														type_identifier_owners
															.get(identifier_slot)
															.get_or(0) + 1,
													)
													owned_text_indices = owned_text_indices.set(
														identifier.text_index,
														owned_text_indices
															.get(identifier.text_index)
															.get_or(0) + 1,
													)
											None:
												valid = False

										identifier_offset += 1
							None:
								valid = False
					else if node.kind == CompactDimLiteralTypeNode:
						if node.payload_index < 0 or node.payload_index >= rep.texts.length():
							valid = False
						else:
							owned_text_indices = owned_text_indices.set(
								node.payload_index,
								owned_text_indices
									.get(node.payload_index)
									.get_or(0) + 1,
							)
					else if node.payload_index != NO_COMPACT_PAYLOAD_INDEX:
						valid = False
				None:
					valid = False

			type_node_index += 1

		var pattern_node_index: Int = 0

		while pattern_node_index < rep.pattern_nodes.length() and valid:
			match rep.pattern_nodes.get(pattern_node_index):
				Some(node):
					if not compact_source_span_is_valid(rep.source_owners, node.span):
						valid = False

					if not compact_metadata_slice_is_valid(
						node.child_start,
						node.child_count,
						rep.pattern_children.length(),
					):
						valid = False

					match compact_pattern_exact_child_count(node.kind):
						Some(expected):
							if node.child_count != expected:
								valid = False
						None:
							void

					var binding_count: Int = 0
					var child_offset: Int = 0

					while child_offset < node.child_count and valid:
						child_slot = node.child_start + child_offset

						match rep.pattern_children.get(child_slot):
							Some(child):
								if child < 0 or child >= pattern_node_index:
									valid = False
								else:
									pattern_parent_count = pattern_parent_count.set(
										child,
										pattern_parent_count
											.get(child)
											.get_or(0) + 1,
									)
									pattern_child_slot_owners = pattern_child_slot_owners.set(
										child_slot,
										pattern_child_slot_owners
											.get(child_slot)
											.get_or(0) + 1,
									)
									binding_count += validated_pattern_binding_counts
										.get(child)
										.get_or(0)
							None:
								valid = False

						child_offset += 1

					if compact_pattern_uses_identifier_slice(node.kind):
						match rep.pattern_identifier_slices.get(node.payload_index):
							Some(payload):
								if (
									not compact_metadata_slice_is_valid(
										payload.identifier_start,
										payload.identifier_count,
										rep.pattern_identifiers.length(),
									)
									or not compact_pattern_identifier_count_is_valid(
										node.kind,
										payload.identifier_count,
									)
									or not compact_source_span_is_valid(
										rep.source_owners,
										payload.span,
									)
								):
									valid = False
								else:
									pattern_identifier_slice_owners = pattern_identifier_slice_owners.set(
										node.payload_index,
										pattern_identifier_slice_owners
											.get(node.payload_index)
											.get_or(0) + 1,
									)
									var identifier_offset: Int = 0

									while identifier_offset < payload.identifier_count and valid:
										identifier_slot = payload.identifier_start + identifier_offset

										match rep.pattern_identifiers.get(identifier_slot):
											Some(identifier):
												if (
													not compact_source_span_is_valid(
														rep.source_owners,
														identifier.span,
													)
													or identifier.text_index < 0
													or identifier.text_index >= rep.texts.length()
												):
													valid = False
												else:
													pattern_identifier_owners = pattern_identifier_owners.set(
														identifier_slot,
														pattern_identifier_owners
															.get(identifier_slot)
															.get_or(0) + 1,
													)
													owned_text_indices = owned_text_indices.set(
														identifier.text_index,
														owned_text_indices
															.get(identifier.text_index)
															.get_or(0) + 1,
													)
											None:
												valid = False

										identifier_offset += 1

									if (
										node.kind == CompactNamePatternNode
										or node.kind == CompactListNameSpreadPatternNode
									):
										binding_count += 1
							None:
								valid = False
					else:
						match node.kind:
							CompactIntPatternNode | CompactFloatPatternNode:
								match rep.text_payloads.get(node.payload_index):
									Some(payload):
										if (
											payload.text_index < 0
											or payload.text_index >= rep.texts.length()
										):
											valid = False
										else:
											text_owners = text_owners.set(
												node.payload_index,
												text_owners
													.get(node.payload_index)
													.get_or(0) + 1,
											)
											owned_text_indices = owned_text_indices.set(
												payload.text_index,
												owned_text_indices
													.get(payload.text_index)
													.get_or(0) + 1,
											)
									None:
										valid = False
							CompactStringPatternNode:
								match rep.string_payloads.get(node.payload_index):
									Some(payload):
										if (
											payload.text_index < 0
											or payload.text_index >= rep.texts.length()
										):
											valid = False
										else:
											string_owners = string_owners.set(
												node.payload_index,
												string_owners
													.get(node.payload_index)
													.get_or(0) + 1,
											)
											owned_text_indices = owned_text_indices.set(
												payload.text_index,
												owned_text_indices
													.get(payload.text_index)
													.get_or(0) + 1,
											)
									None:
										valid = False
							CompactCharPatternNode:
								if (
									node.payload_index < 0
									or node.payload_index >= char_owners.length()
								):
									valid = False
								else:
									char_owners = char_owners.set(node.payload_index, char_owners
											.get(node.payload_index)
											.get_or(0) + 1)
							CompactBoolPatternNode:
								if (
									node.payload_index < 0
									or node.payload_index >= bool_owners.length()
								):
									valid = False
								else:
									bool_owners = bool_owners.set(node.payload_index, bool_owners
											.get(node.payload_index)
											.get_or(0) + 1)
							CompactWildcardPatternNode | CompactTuplePatternNode | CompactListPatternNode | CompactOrPatternNode | CompactMissingPatternNode:
								if node.payload_index != NO_COMPACT_PAYLOAD_INDEX:
									valid = False
							_:
								valid = False

					validated_pattern_binding_counts = validated_pattern_binding_counts.set(
						pattern_node_index,
						binding_count,
					)
				None:
					valid = False

			pattern_node_index += 1

		var match_case_index: Int = 0

		while match_case_index < rep.match_cases.length() and valid:
			match rep.match_cases.get(match_case_index):
				Some(case):
					if (
						case.binding_count != validated_pattern_binding_counts
							.get(case.pattern_root_index)
							.get_or(-1)
					):
						valid = False
				None:
					valid = False

			match_case_index += 1

		var control_identifier_index: Int = 0

		while control_identifier_index < rep.control_identifiers.length() and valid:
			match rep.control_identifiers.get(control_identifier_index):
				Some(identifier):
					if (
						not compact_source_span_is_valid(rep.source_owners, identifier.span)
						or identifier.text_index < 0
						or identifier.text_index >= rep.texts.length()
					):
						valid = False
					else:
						owned_text_indices = owned_text_indices.set(
							identifier.text_index,
							owned_text_indices
								.get(identifier.text_index)
								.get_or(0) + 1,
						)
				None:
					valid = False

			control_identifier_index += 1

		if valid:
			var index: Int = 0

			while index < rep.nodes.length() and valid:
				parents = parent_count
					.get(index)
					.get_or(-1)
				is_root = root_membership
					.get(index)
					.get_or(False)
				valid = is_root and parents == 0 or not is_root and parents == 1
				index += 1

			var type_index: Int = 0

			while type_index < rep.type_nodes.length() and valid:
				parents = type_parent_count
					.get(type_index)
					.get_or(-1)
				is_root = type_root_membership
					.get(type_index)
					.get_or(False)
				valid = is_root and parents == 0 or not is_root and parents == 1
				type_index += 1

			var pattern_index: Int = 0

			while pattern_index < rep.pattern_nodes.length() and valid:
				parents = pattern_parent_count
					.get(pattern_index)
					.get_or(-1)
				is_root = pattern_root_membership
					.get(pattern_index)
					.get_or(False)
				valid = is_root and parents == 0 or not is_root and parents == 1
				pattern_index += 1

		if valid:
			for owners in child_slot_owners:
				valid = valid and owners == 1

			for owners in owned_text_indices:
				valid = valid and owners == 1

			for owners in text_owners:
				valid = valid and owners == 1

			for owners in string_owners:
				valid = valid and owners == 1

			for owners in interpolation_owners:
				valid = valid and owners == 1

			for owners in bool_owners:
				valid = valid and owners == 1

			for owners in char_owners:
				valid = valid and owners == 1

			for owners in operator_owners:
				valid = valid and owners == 1

			for owners in call_owners:
				valid = valid and owners == 1

			for owners in field_access_owners:
				valid = valid and owners == 1

			for owners in record_owners:
				valid = valid and owners == 1

			for owners in record_field_slot_owners:
				valid = valid and owners == 1

			for owners in dict_owners:
				valid = valid and owners == 1

			for owners in dict_entry_slot_owners:
				valid = valid and owners == 1

			for owners in type_child_slot_owners:
				valid = valid and owners == 1

			for owners in type_identifier_slice_owners:
				valid = valid and owners == 1

			for owners in type_identifier_owners:
				valid = valid and owners == 1

			for owners in interpolation_parts_payload_owners:
				valid = valid and owners == 1

			for owners in interpolation_part_slot_owners:
				valid = valid and owners == 1

			for owners in control_identifier_owners:
				valid = valid and owners == 1

			for owners in identifier_slice_owners:
				valid = valid and owners == 1

			for owners in typed_binder_owners:
				valid = valid and owners == 1

			for owners in pattern_child_slot_owners:
				valid = valid and owners == 1

			for owners in pattern_identifier_slice_owners:
				valid = valid and owners == 1

			for owners in pattern_identifier_owners:
				valid = valid and owners == 1

			for owners in match_case_slot_owners:
				valid = valid and owners == 1

			for owners in select_arm_slot_owners:
				valid = valid and owners == 1

			for owners in with_binding_owners:
				valid = valid and owners == 1

			for owners in with_error_map_owners:
				valid = valid and owners == 1

			for owners in lambda_payload_owners:
				valid = valid and owners == 1

			for owners in function_payload_owners:
				valid = valid and owners == 1

			for owners in callable_param_slot_owners:
				valid = valid and owners == 1

			for owners in callable_type_param_slot_owners:
				valid = valid and owners == 1

			for owners in callable_dim_constraint_slot_owners:
				valid = valid and owners == 1

			for owners in function_annotation_slot_owners:
				valid = valid and owners == 1

			for owners in concurrent_param_slot_owners:
				valid = valid and owners == 1

			for owners in concurrent_for_payload_owners:
				valid = valid and owners == 1

			for owners in unit_owners:
				valid = valid and owners == 1

		valid


pure func compact_expression_oracle_from_parsed_roots(
	source: SourceFile,
	roots: List[ParsedExpr],
) -> Result[ValidatedExpressionProduct, CompactExpressionOracleError]:
	-- All growing buffers belong to this one pure driver. No helper accepts or
	-- returns a builder record.
	var nodes: List[CompactExpressionNodeRow] = []
	var children: List[Int] = []
	var texts: List[String] = []
	var text_payloads: List[CompactTextPayloadRow] = []
	var string_payloads: List[CompactStringPayloadRow] = []
	var interpolation_payloads: List[CompactInterpolationPayloadRow] = []
	var bool_payloads: List[CompactBoolPayloadRow] = []
	var char_payloads: List[CompactCharPayloadRow] = []
	var operator_payloads: List[CompactOperatorPayloadRow] = []
	var call_payloads: List[CompactCallPayloadRow] = []
	var field_access_payloads: List[CompactFieldAccessPayloadRow] = []
	var record_payloads: List[CompactRecordPayloadRow] = []
	var record_fields: List[CompactRecordFieldRow] = []
	var dict_payloads: List[CompactDictPayloadRow] = []
	var dict_entries: List[CompactDictEntryRow] = []
	var type_nodes: List[CompactTypeNodeRow] = []
	var type_children: List[Int] = []
	var type_identifier_slices: List[CompactTypeIdentifierSliceRow] = []
	var type_identifiers: List[CompactTypeIdentifierRow] = []
	var interpolation_parts_payloads: List[CompactInterpolationPartsPayloadRow] = []
	var interpolation_parts: List[CompactInterpolationPartRow] = []
	var control_identifiers: List[CompactControlIdentifierRow] = []
	var identifier_slices: List[CompactIdentifierSliceRow] = []
	var typed_binders: List[CompactTypedBinderRow] = []
	var pattern_nodes: List[CompactPatternNodeRow] = []
	var pattern_children: List[Int] = []
	var pattern_identifier_slices: List[CompactPatternIdentifierSliceRow] = []
	var pattern_identifiers: List[CompactPatternIdentifierRow] = []
	var match_cases: List[CompactMatchCaseRow] = []
	var select_arms: List[CompactSelectArmRow] = []
	var with_bindings: List[CompactWithBindingRow] = []
	var with_error_maps: List[CompactWithErrorMapRow] = []
	var lambda_payloads: List[CompactLambdaRow] = []
	var function_payloads: List[CompactFunctionRow] = []
	var callable_params: List[CompactCallableParamRow] = []
	var callable_type_params: List[CompactCallableTypeParamRow] = []
	var callable_dim_constraints: List[CompactCallableDimConstraintRow] = []
	var function_annotations: List[CompactFunctionAnnotationKind] = []
	var concurrent_params: List[CompactConcurrentParamRow] = []
	var concurrent_for_payloads: List[CompactConcurrentForRow] = []
	var unit_payloads: List[CompactUnitPayloadRow] = []
	var actions: List[CompactBuildAction] = []
	var values: List[Int] = []
	var type_values: List[Int] = []
	var pattern_values: List[Int] = []
	var pattern_binding_counts: List[Int] = []
	var supported = True

	var root_index = roots.length() - 1

	while root_index >= 0:
		match roots.get(root_index):
			Some(root):
				actions = actions.append(CompactBuildVisit(root))
			None:
				supported = False

		root_index -= 1

	while not actions.is_empty() and supported:
		action_index = actions.length() - 1
		action = actions.get(action_index)
		actions = actions.take(action_index)

		match action:
			Some(CompactBuildVisit(expr)):
				match expr:
					ParsedNameExpr(name):
						text_index = texts.length()
						texts = texts.append(name.text)
						payload_index = text_payloads.length()
						text_payloads = text_payloads.append({text_index = text_index})
						node_index = nodes.length()
						nodes = nodes.append({
							kind = CompactNameNode,
							payload_index = payload_index,
							child_start = children.length(),
							child_count = 0,
							span = compact_source_location(name.span),
						})
						values = values.append(node_index)
					ParsedIntLiteralExpr(text, span):
						text_index = texts.length()
						texts = texts.append(text)
						payload_index = text_payloads.length()
						text_payloads = text_payloads.append({text_index = text_index})
						node_index = nodes.length()
						nodes = nodes.append({
							kind = CompactIntNode,
							payload_index = payload_index,
							child_start = children.length(),
							child_count = 0,
							span = compact_source_location(span),
						})
						values = values.append(node_index)
