						child_start = child_start,
						child_count = child_count,
						span = compact_source_location(span),
					})
					type_values = type_values.append(type_node_index)
			None:
				supported = False

	if (
		not supported
		or values.length() != roots.length()
		or not type_values.is_empty()
		or not pattern_values.is_empty()
	):
		Err(UnsupportedCompactExpressionOracleForm)
	else:
		rep: CompactExpressionProductRep = {
			source_owners = [source],
			nodes = nodes,
			children = children,
			texts = texts,
			text_payloads = text_payloads,
			string_payloads = string_payloads,
			interpolation_payloads = interpolation_payloads,
			bool_payloads = bool_payloads,
			char_payloads = char_payloads,
			operator_payloads = operator_payloads,
			call_payloads = call_payloads,
			field_access_payloads = field_access_payloads,
			record_payloads = record_payloads,
			record_fields = record_fields,
			dict_payloads = dict_payloads,
			dict_entries = dict_entries,
			type_nodes = type_nodes,
			type_children = type_children,
			type_identifier_slices = type_identifier_slices,
			type_identifiers = type_identifiers,
			interpolation_parts_payloads = interpolation_parts_payloads,
			interpolation_parts = interpolation_parts,
			control_identifiers = control_identifiers,
			identifier_slices = identifier_slices,
			typed_binders = typed_binders,
			pattern_nodes = pattern_nodes,
			pattern_children = pattern_children,
			pattern_identifier_slices = pattern_identifier_slices,
			pattern_identifiers = pattern_identifiers,
			match_cases = match_cases,
			select_arms = select_arms,
			with_bindings = with_bindings,
			with_error_maps = with_error_maps,
			lambda_payloads = lambda_payloads,
			function_payloads = function_payloads,
			callable_params = callable_params,
			callable_type_params = callable_type_params,
			callable_dim_constraints = callable_dim_constraints,
			function_annotations = function_annotations,
			concurrent_params = concurrent_params,
			concurrent_for_payloads = concurrent_for_payloads,
			unit_payloads = unit_payloads,
			roots = values
		}

		if compact_expression_product_is_valid(rep):
			Ok(into_opaque ValidatedExpressionProduct(rep))
		else:
			Err(InvalidCompactExpressionOracleProduct)


private pure func projected_child(
	rep: CompactExpressionProductRep,
	projected: List[ParsedExpr],
	node: CompactExpressionNodeRow,
	offset: Int,
) -> Option[ParsedExpr]:
	match rep.children.get(node.child_start + offset):
		Some(child):
			projected.get(child)
		None:
			None


private pure func compact_text_payload(
	rep: CompactExpressionProductRep,
	payload_index: Int,
) -> Option[String]:
	match rep.text_payloads.get(payload_index):
		Some(payload):
			rep.texts.get(payload.text_index)
		None:
			None


private pure func projected_control_identifier(
	rep: CompactExpressionProductRep,
	identifier_index: Int,
) -> Option[ParsedIdentifier]:
	match rep.control_identifiers.get(identifier_index):
		Some(identifier):
			rep.texts
				.get(identifier.text_index)
				.map(func(text): parsed_identifier(text, identifier.span.location))
		None:
			None


private pure func projected_concurrent_params(
	rep: CompactExpressionProductRep,
	projected: List[ParsedExpr],
	node: CompactExpressionNodeRow,
	parameter_start: Int,
	child_start_offset: Int,
	parameter_count: Int,
) -> Option[List[ParsedConcurrentParam]]:
	var params: List[ParsedConcurrentParam] = []
	var parameter_offset: Int = 0
	var valid = True

	while parameter_offset < parameter_count and valid:
		match (
			rep.concurrent_params.get(parameter_start + parameter_offset),
			projected_child(rep, projected, node, child_start_offset + parameter_offset),
		):
			(Some(parameter), Some(value)):
				match projected_control_identifier(rep, parameter.name_identifier_index):
					Some(name):
						params = params.append({
							name = name,
							value = value,
							span = parameter.span.location,
						})
					None:
						valid = False
			_:
				valid = False

		parameter_offset += 1

	if valid:
		Some(params)
	else:
		None


private pure func projected_identifier_slice(
	rep: CompactExpressionProductRep,
	slice_index: Int,
) -> Option[List[ParsedIdentifier]]:
	match rep.identifier_slices.get(slice_index):
		Some(slice):
			var identifiers: List[ParsedIdentifier] = []
			var offset: Int = 0
			var valid = True

			while offset < slice.identifier_count and valid:
				match projected_control_identifier(rep, slice.identifier_start + offset):
					Some(identifier):
						identifiers = identifiers.append(identifier)
					None:
						valid = False

				offset += 1

			if valid:
				Some(identifiers)
			else:
				None
		None:
			None


private pure func projected_optional_type(
	projected_types: List[ParsedTypeExpr],
	type_root_index: Int,
) -> Option[Option[ParsedTypeExpr]]:
	if type_root_index == NO_COMPACT_TYPE_ROOT_INDEX:
		Some(None)
	else:
		projected_types
			.get(type_root_index)
			.map(func(type_expr): Some(type_expr))


private pure func projected_type_identifier_at(
	rep: CompactExpressionProductRep,
	identifier_index: Int,
) -> Option[ParsedIdentifier]:
	match rep.type_identifiers.get(identifier_index):
		Some(identifier):
			rep.texts
				.get(identifier.text_index)
				.map(func(text): parsed_identifier(text, identifier.span.location))
		None:
			None


private pure func projected_lambda_params(
	rep: CompactExpressionProductRep,
	projected_types: List[ParsedTypeExpr],
	start: Int,
	count: Int,
) -> Option[List[ParsedLambdaParam]]:
	var params: List[ParsedLambdaParam] = []
	var offset: Int = 0
	var valid = True

	while offset < count and valid:
		match rep.callable_params.get(start + offset):
			Some(param):
				match (
					projected_control_identifier(rep, param.binder_payload_index),
					projected_optional_type(projected_types, param.type_root_index),
				):
					(Some(name), Some(type_expr)):
						params = params.append({
							name = name,
							type_expr = type_expr,
							span = param.span.location,
						})
					_:
						valid = False
			None:
				valid = False

		offset += 1

	if valid:
		Some(params)
	else:
		None


private pure func projected_function_params(
	rep: CompactExpressionProductRep,
	projected_types: List[ParsedTypeExpr],
	start: Int,
	count: Int,
) -> Option[List[ParsedParam]]:
	var params: List[ParsedParam] = []
	var offset: Int = 0
	var valid = True

	while offset < count and valid:
		match rep.callable_params.get(start + offset):
			Some(param):
				var binder: Option[ParsedParamBinder] = None

				match param.kind:
					CompactFunctionNameParam:
						binder = projected_control_identifier(
							rep,
							param.binder_payload_index,
						).map(
							func(name): ParsedParamNameBinder(name),
						)
					CompactFunctionWildcardParam:
						binder = rep.identifier_slices
							.get(param.binder_payload_index)
							.map(func(slice): ParsedParamWildcardBinder(slice.span.location))
					CompactFunctionTupleParam:
						match (
							rep.identifier_slices.get(param.binder_payload_index),
							projected_identifier_slice(rep, param.binder_payload_index),
						):
							(Some(slice), Some(names)):
								binder = Some(ParsedParamTupleBinder(names, slice.span.location))
							_:
								void
					CompactLambdaNameParam:
						void

				match (binder, projected_optional_type(projected_types, param.type_root_index)):
					(Some(param_binder), Some(type_expr)):
						params = params.append({
							binder = param_binder,
							type_expr = type_expr,
							span = param.span.location,
						})
					_:
						valid = False
			None:
				valid = False

		offset += 1

	if valid:
		Some(params)
	else:
		None


private pure func projected_callable_type_params(
	rep: CompactExpressionProductRep,
	start: Int,
	count: Int,
) -> Option[List[ParsedTypeParamDecl]]:
	var params: List[ParsedTypeParamDecl] = []
	var offset: Int = 0
	var valid = True

	while offset < count and valid:
		match rep.callable_type_params.get(start + offset):
			Some(param):
				var bounds: List[ParsedIdentifier] = []
				var bound_offset: Int = 0

				while bound_offset < param.bound_identifier_count and valid:
					match projected_type_identifier_at(
						rep,
						param.bound_identifier_start + bound_offset,
					):
						Some(bound):
							bounds = bounds.append(bound)
						None:
							valid = False

					bound_offset += 1

				match projected_type_identifier_at(rep, param.name_identifier_index):
					Some(name):
						if valid:
							params = params.append({
								name = name,
								bounds = bounds,
								span = param.span.location,
							})
					None:
						valid = False
			None:
				valid = False

		offset += 1

	if valid:
		Some(params)
	else:
		None


private pure func projected_callable_dim_constraints(
	rep: CompactExpressionProductRep,
	projected_types: List[ParsedTypeExpr],
	start: Int,
	count: Int,
) -> Option[List[ParsedDimConstraint]]:
	var constraints: List[ParsedDimConstraint] = []
	var offset: Int = 0
	var valid = True

	while offset < count and valid:
		match rep.callable_dim_constraints.get(start + offset):
			Some(constraint):
				match (
					projected_types.get(constraint.left_type_root_index),
					projected_types.get(constraint.right_type_root_index),
				):
					(Some(left), Some(right)):
						constraints = constraints.append({
							left = left,
							right = right,
							span = constraint.span.location,
						})
					_:
						valid = False
			None:
				valid = False

		offset += 1

	if valid:
		Some(constraints)
	else:
		None


private pure func projected_function_annotations(
	rep: CompactExpressionProductRep,
	start: Int,
	count: Int,
) -> Option[List[ParsedFunctionAnnotation]]:
	var annotations: List[ParsedFunctionAnnotation] = []
	var offset: Int = 0
	var valid = True

	while offset < count and valid:
		match rep.function_annotations.get(start + offset):
			Some(annotation):
				annotations = annotations.append(
					match annotation:
						CompactTailRecursiveAnnotation:
							ParsedTailRecursiveAnnotation
						CompactNoCopyAnnotation:
							ParsedNoCopyAnnotation
						CompactDebugOnlyAnnotation:
							ParsedDebugOnlyAnnotation
						CompactResourceResultOrdinaryAnnotation:
							ParsedResourceResultOrdinaryAnnotation
				)
			None:
				valid = False

		offset += 1

	if valid:
		Some(annotations)
	else:
		None


private pure func projected_children(
	rep: CompactExpressionProductRep,
	projected: List[ParsedExpr],
	node: CompactExpressionNodeRow,
	start_offset: Int,
) -> Option[List[ParsedExpr]]:
	var values: List[ParsedExpr] = []
	var offset = start_offset
	var valid = True

	while offset < node.child_count and valid:
		match projected_child(rep, projected, node, offset):
			Some(value):
				values = values.append(value)
			None:
				valid = False

		offset += 1

	if valid:
		Some(values)
	else:
		None


private pure func projected_record_fields(
	rep: CompactExpressionProductRep,
	projected: List[ParsedExpr],
	node: CompactExpressionNodeRow,
	payload: CompactRecordPayloadRow,
	child_start_offset: Int,
) -> Option[List[ParsedRecordExprField]]:
	var fields: List[ParsedRecordExprField] = []
	var offset: Int = 0
	var valid = True

	while offset < payload.field_count and valid:
		match (
			rep.record_fields.get(payload.field_start + offset),
			projected_child(rep, projected, node, child_start_offset + offset),
		):
			(Some(field), Some(value)):
				match rep.texts.get(field.name_text_index):
					Some(name):
						fields = fields.append({
							name = parsed_identifier(name, field.name_span.location),
							value = value,
							span = field.field_span.location,
						})
					None:
						valid = False
			_:
				valid = False

		offset += 1

	if valid:
		Some(fields)
	else:
		None


private pure func projected_dict_entries(
	rep: CompactExpressionProductRep,
	projected: List[ParsedExpr],
	node: CompactExpressionNodeRow,
	payload: CompactDictPayloadRow,
) -> Option[List[ParsedDictEntry]]:
	var entries: List[ParsedDictEntry] = []
	var offset: Int = 0
	var valid = True

	while offset < payload.entry_count and valid:
		match (
			rep.dict_entries.get(payload.entry_start + offset),
			projected_child(rep, projected, node, offset * 2),
			projected_child(rep, projected, node, offset * 2 + 1),
		):
			(Some(entry), Some(key), Some(value)):
				entries = entries.append({
					key = key,
					value = value,
					span = entry.entry_span.location,
				})
			_:
				valid = False

		offset += 1

	if valid:
		Some(entries)
	else:
		None


private pure func projected_type_child(
	rep: CompactExpressionProductRep,
	projected: List[ParsedTypeExpr],
	node: CompactTypeNodeRow,
	offset: Int,
) -> Option[ParsedTypeExpr]:
	match rep.type_children.get(node.child_start + offset):
		Some(child):
			projected.get(child)
		None:
			None


private pure func projected_type_children(
	rep: CompactExpressionProductRep,
	projected: List[ParsedTypeExpr],
	node: CompactTypeNodeRow,
	start_offset: Int,
) -> Option[List[ParsedTypeExpr]]:
	var values: List[ParsedTypeExpr] = []
	var offset = start_offset
	var valid = True

	while offset < node.child_count and valid:
		match projected_type_child(rep, projected, node, offset):
			Some(value):
				values = values.append(value)
			None:
				valid = False

		offset += 1

	if valid:
		Some(values)
	else:
		None


private pure func projected_type_identifier(
	rep: CompactExpressionProductRep,
	node: CompactTypeNodeRow,
	offset: Int,
) -> Option[ParsedIdentifier]:
	match rep.type_identifier_slices.get(node.payload_index):
		Some(payload):
			match rep.type_identifiers.get(payload.identifier_start + offset):
				Some(identifier):
					rep.texts
						.get(identifier.text_index)
						.map(func(text): parsed_identifier(text, identifier.span.location))
				None:
					None
		None:
			None


private pure func projected_type_identifiers(
	rep: CompactExpressionProductRep,
	node: CompactTypeNodeRow,
	start_offset: Int,
) -> Option[List[ParsedIdentifier]]:
	match rep.type_identifier_slices.get(node.payload_index):
		Some(payload):
			var values: List[ParsedIdentifier] = []
			var offset = start_offset
			var valid = True

			while offset < payload.identifier_count and valid:
				match projected_type_identifier(rep, node, offset):
					Some(value):
						values = values.append(value)
					None:
						valid = False

				offset += 1

			if valid:
				Some(values)
			else:
				None
		None:
			None


private pure func compact_project_types(
	rep: CompactExpressionProductRep,
) -> Option[List[ParsedTypeExpr]]:
	var projected: List[ParsedTypeExpr] = []
	var valid = True
	var node_index: Int = 0

	while node_index < rep.type_nodes.length() and valid:
		match rep.type_nodes.get(node_index):
			Some(node):
				span = node.span.location
				var value: Option[ParsedTypeExpr] = None

				match node.kind:
					CompactNamedTypeNode:
						match (
							projected_type_identifier(rep, node, 0),
							projected_type_children(rep, projected, node, 0),
						):
							(Some(name), Some(args)):
								value = Some(ParsedNamedType(name, args, span))
							_:
								void
					CompactQualifiedNamedTypeNode:
						match (
							projected_type_identifier(rep, node, 0),
							projected_type_identifier(rep, node, 1),
							projected_type_children(rep, projected, node, 0),
						):
							(Some(qualifier), Some(name), Some(args)):
								value = Some(ParsedQualifiedNamedType(qualifier, name, args, span))
							_:
								void
					CompactBoundedTypeNode:
						match (
							projected_type_identifier(rep, node, 0),
							projected_type_identifiers(rep, node, 1),
						):
							(Some(name), Some(bounds)):
								value = Some(ParsedBoundedType(name, bounds, span))
							_:
								void
					CompactDimNameTypeNode | CompactDimSplatNameTypeNode:
						value = projected_type_identifier(
							rep,
							node,
							0,
						).map(
							func(
								name,
							): ParsedDimNameType(
								name,
								node.kind == CompactDimSplatNameTypeNode,
								span,
							),
						)
					CompactDimLiteralTypeNode:
						value = rep.texts
							.get(node.payload_index)
							.map(func(text): ParsedDimLiteralType(text, span))
					CompactDimAddTypeNode | CompactDimSubtractTypeNode | CompactDimMultiplyTypeNode | CompactDimDivideTypeNode:
						match (
							parsed_dim_binary_operator(node.kind),
							projected_type_child(rep, projected, node, 0),
							projected_type_child(rep, projected, node, 1),
						):
							(Some(op), Some(left), Some(right)):
								value = Some(ParsedDimBinaryType(op, left, right, span))
							_:
								void
					CompactRangeTypeNode:
						value = projected_type_child(
							rep,
							projected,
							node,
							0,
						).map(
							func(inner): ParsedRangeType(inner, span),
						)
					CompactTupleTypeNode:
						value = projected_type_children(
							rep,
							projected,
							node,
							0,
						).map(
							func(fields): ParsedTupleType(fields, span),
						)
					CompactPureFunctionTypeNode | CompactImpureFunctionTypeNode:
						match (
							projected_type_children(rep, projected, node, 0),
							projected_type_child(rep, projected, node, node.child_count - 1),
						):
							(Some(children), Some(result)):
								value = Some(
									ParsedFunctionType(
										node.kind == CompactPureFunctionTypeNode,
										children.take(children.length() - 1),
										result,
										span,
									),
								)
							_:
								void
					CompactArrayTypeNode:
						match (
							projected_type_child(rep, projected, node, 0),
							projected_type_children(rep, projected, node, 1),
						):
							(Some(element), Some(dimensions)):
								value = Some(ParsedArrayType(element, dimensions, span))
							_:
								void
					CompactMissingTypeNode:
						value = Some(ParsedMissingType(span))

				match value:
					Some(type_expr):
						projected = projected.append(type_expr)
					None:
						valid = False
			None:
				valid = False

		node_index += 1

	if valid:
		Some(projected)
	else:
		None


private pure func projected_pattern_child(
	rep: CompactExpressionProductRep,
	projected: List[ParsedPattern],
	node: CompactPatternNodeRow,
	offset: Int,
) -> Option[ParsedPattern]:
	match rep.pattern_children.get(node.child_start + offset):
		Some(child):
			projected.get(child)
		None:
			None


private pure func projected_pattern_children(
	rep: CompactExpressionProductRep,
	projected: List[ParsedPattern],
	node: CompactPatternNodeRow,
) -> Option[List[ParsedPattern]]:
	var values: List[ParsedPattern] = []
	var offset: Int = 0
	var valid = True

	while offset < node.child_count and valid:
		match projected_pattern_child(rep, projected, node, offset):
			Some(value):
				values = values.append(value)
			None:
				valid = False

		offset += 1

	if valid:
		Some(values)
	else:
		None


private pure func projected_pattern_identifier(
	rep: CompactExpressionProductRep,
	node: CompactPatternNodeRow,
	offset: Int,
) -> Option[ParsedIdentifier]:
	match rep.pattern_identifier_slices.get(node.payload_index):
		Some(payload):
			match rep.pattern_identifiers.get(payload.identifier_start + offset):
				Some(identifier):
					rep.texts
						.get(identifier.text_index)
						.map(func(text): parsed_identifier(text, identifier.span.location))
				None:
					None
		None:
			None


private pure func compact_project_patterns(
	rep: CompactExpressionProductRep,
) -> Option[List[ParsedPattern]]:
	var projected: List[ParsedPattern] = []
	var valid = True
	var node_index: Int = 0

	while node_index < rep.pattern_nodes.length() and valid:
		match rep.pattern_nodes.get(node_index):
			Some(node):
				span = node.span.location
				var value: Option[ParsedPattern] = None

				match node.kind:
					CompactWildcardPatternNode:
						value = Some(ParsedWildcardPattern(span))
					CompactNamePatternNode:
						value = projected_pattern_identifier(
							rep,
							node,
							0,
						).map(
							func(identifier): ParsedNamePattern(identifier),
						)
					CompactIntPatternNode:
						value = compact_text_payload(
							rep,
							node.payload_index,
						).map(
							func(text): ParsedIntPattern(text, span),
						)
					CompactFloatPatternNode:
						value = compact_text_payload(
							rep,
							node.payload_index,
						).map(
							func(text): ParsedFloatPattern(text, span),
						)
					CompactStringPatternNode:
						match rep.string_payloads.get(node.payload_index):
							Some(payload):
								value = rep.texts
									.get(payload.text_index)
									.map(func(text): ParsedStringPattern(text, payload.form, span))
							None:
								void
					CompactCharPatternNode:
						value = rep.char_payloads
							.get(node.payload_index)
							.map(func(payload): ParsedCharPattern(payload.value, span))
					CompactBoolPatternNode:
						value = rep.bool_payloads
							.get(node.payload_index)
							.map(func(payload): ParsedBoolPattern(payload.value, span))
					CompactConstructorPatternNode:
						match (
							projected_pattern_identifier(rep, node, 0),
							projected_pattern_children(rep, projected, node),
						):
							(Some(name), Some(args)):
								value = Some(ParsedConstructorPattern(name, args, span))
							_:
								void
					CompactQualifiedConstructorPatternNode:
						match (
							projected_pattern_identifier(rep, node, 0),
							projected_pattern_identifier(rep, node, 1),
							projected_pattern_children(rep, projected, node),
						):
							(Some(module_name), Some(name), Some(args)):
								value = Some(
									ParsedQualifiedConstructorPattern(
										module_name,
										name,
										args,
										span,
									),
								)
							_:
								void
					CompactTuplePatternNode:
						value = projected_pattern_children(
							rep,
							projected,
							node,
						).map(
							func(items): ParsedTuplePattern(items, span),
						)
					CompactListPatternNode | CompactListNameSpreadPatternNode | CompactListWildcardSpreadPatternNode:
						match projected_pattern_children(rep, projected, node):
							Some(items):
								var spread: Option[ParsedListPatternSpread] = None

								if node.kind == CompactListNameSpreadPatternNode:
									spread = projected_pattern_identifier(
										rep,
										node,
										0,
									).map(
										func(name): ParsedListSpreadName(name),
									)
								else if node.kind == CompactListWildcardSpreadPatternNode:
									spread = rep.pattern_identifier_slices
										.get(node.payload_index)
										.map(
											func(
												payload,
											): ParsedListSpreadWildcard(payload.span.location),
										)

								if node.kind == CompactListPatternNode or spread.is_some():
									value = Some(ParsedListPattern(items, spread, span))
							None:
								void
					CompactOrPatternNode:
						value = projected_pattern_children(
							rep,
							projected,
							node,
						).map(
							func(patterns): ParsedOrPattern(patterns, span),
						)
					CompactMissingPatternNode:
						value = Some(ParsedMissingPattern(span))

				match value:
					Some(pattern):
						projected = projected.append(pattern)
					None:
						valid = False
			None:
				valid = False

		node_index += 1

	if valid:
		Some(projected)
	else:
		None


pure func compact_expression_oracle_project(
	product: ValidatedExpressionProduct,
) -> Result[List[ParsedExpr], CompactExpressionOracleError]:
	rep = from_opaque ValidatedExpressionProduct(product)
	var projected: List[ParsedExpr] = []
	var projected_types: List[ParsedTypeExpr] = []
	var projected_patterns: List[ParsedPattern] = []
	var valid = False

	match (compact_project_types(rep), compact_project_patterns(rep)):
		(Some(type_values), Some(pattern_values)):
			projected_types = type_values
			projected_patterns = pattern_values
			valid = True
		_:
			void

	var node_index: Int = 0

	while node_index < rep.nodes.length() and valid:
		match rep.nodes.get(node_index):
			Some(node):
				span = node.span.location
				var value: Option[ParsedExpr] = None

				match node.kind:
					CompactNameNode:
						value = compact_text_payload(
							rep,
							node.payload_index,
						).map(
							func(text): ParsedNameExpr(parsed_identifier(text, span)),
						)
					CompactIntNode:
						value = compact_text_payload(
							rep,
							node.payload_index,
						).map(
							func(text): ParsedIntLiteralExpr(text, span),
						)
					CompactFloatNode:
						value = compact_text_payload(
							rep,
							node.payload_index,
						).map(
							func(text): ParsedFloatLiteralExpr(text, span),
						)
					CompactStringNode:
						match rep.string_payloads.get(node.payload_index):
							Some(payload):
								value = rep.texts
									.get(payload.text_index)
									.map(
										func(
											text,
										): ParsedStringLiteralExpr(text, payload.form, span),
									)
							None:
								void
					CompactInterpolationNode:
						match rep.interpolation_payloads.get(node.payload_index):
							Some(payload):
								value = rep.texts
									.get(payload.text_index)
									.map(
										func(
											text,
										): ParsedStringInterpolationExpr(
											text,
											payload.is_multiline,
											span,
										),
									)
							None:
								void
					CompactBoolNode:
						value = rep.bool_payloads
							.get(node.payload_index)
							.map(func(row): ParsedBoolLiteralExpr(row.value, span))
					CompactCharNode:
						value = rep.char_payloads
							.get(node.payload_index)
							.map(func(row): ParsedCharLiteralExpr(row.value, span))
					CompactUnaryNode:
						match (
							rep.operator_payloads.get(node.payload_index),
							projected_child(rep, projected, node, 0),
						):
							(Some(payload), Some(child)):
								value = parsed_unary_operator(
									payload.operator,
								).map(
									func(op): ParsedUnaryExpr(op, child, span),
								)
							_:
								void
					CompactBinaryNode:
						match (
							rep.operator_payloads.get(node.payload_index),
							projected_child(rep, projected, node, 0),
							projected_child(rep, projected, node, 1),
						):
							(Some(payload), Some(left), Some(right)):
								value = parsed_binary_operator(
									payload.operator,
								).map(
									func(op): ParsedBinaryExpr(op, left, right, span),
								)
							_:
								void
					CompactLogicalNode:
						match (
							rep.operator_payloads.get(node.payload_index),
							projected_child(rep, projected, node, 0),
							projected_child(rep, projected, node, 1),
						):
							(Some(payload), Some(left), Some(right)):
								value = parsed_logical_operator(
									payload.operator,
								).map(
									func(op): ParsedLogicalExpr(op, left, right, span),
								)
							_:
								void
					CompactAscriptionNode:
						match (
							projected_child(rep, projected, node, 0),
							projected_types.get(node.payload_index),
						):
							(Some(child), Some(type_expr)):
								value = Some(ParsedAscriptionExpr(child, type_expr, span))
							_:
								void
					CompactRangeNode:
						match (
							projected_child(rep, projected, node, 0),
							projected_child(rep, projected, node, 1),
						):
							(Some(start), Some(finish)):
								value = Some(ParsedRangeExpr(start, finish, span))
							_:
								void
					CompactCallNode:
						match projected_child(rep, projected, node, 0):
							Some(callee):
								var args: List[ParsedExpr] = []
								var child_offset: Int = 1

								while child_offset < node.child_count:
									match projected_child(rep, projected, node, child_offset):
										Some(arg):
											args = args.append(arg)
										None:
											valid = False

									child_offset += 1

								if valid:
									value = Some(ParsedCallExpr(callee, args, span))
							None:
								void
					CompactFieldAccessNode:
						match (
							rep.field_access_payloads.get(node.payload_index),
							projected_child(rep, projected, node, 0),
						):
							(Some(payload), Some(target)):
								value = rep.texts
									.get(payload.field_text_index)
									.map(func(field): ParsedFieldAccessExpr(
											target,
											parsed_identifier(field, payload.field_span.location),
											span,
										))
							_:
								void
					CompactSubscriptNode:
						match (
							projected_child(rep, projected, node, 0),
							projected_children(rep, projected, node, 1),
						):
							(Some(target), Some(indices)):
								value = Some(ParsedSubscriptExpr(target, indices, span))
							_:
								void
					CompactListNode:
						value = projected_children(
							rep,
							projected,
							node,
							0,
						).map(
							func(items): ParsedListExpr(items, span),
						)
					CompactTupleNode:
						value = projected_children(
							rep,
							projected,
							node,
							0,
						).map(
							func(items): ParsedTupleExpr(items, span),
						)
					CompactRecordNode:
						match rep.record_payloads.get(node.payload_index):
							Some(payload):
								value = projected_record_fields(
									rep,
									projected,
									node,
									payload,
									0,
								).map(
									func(fields): ParsedRecordExpr(fields, span),
								)
							None:
								void
					CompactRecordUpdateNode:
						match (
							rep.record_payloads.get(node.payload_index),
							projected_child(rep, projected, node, 0),
						):
							(Some(payload), Some(base)):
								value = projected_record_fields(
									rep,
									projected,
									node,
									payload,
									1,
								).map(
									func(fields): ParsedRecordUpdateExpr(base, fields, span),
								)
							_:
								void
					CompactDictNode:
						match rep.dict_payloads.get(node.payload_index):
							Some(payload):
								value = projected_dict_entries(
									rep,
									projected,
									node,
									payload,
								).map(
									func(entries): ParsedDictExpr(entries, span),
								)
							None:
								void
					CompactVectorNode:
						value = projected_children(
							rep,
							projected,
							node,
							0,
						).map(
							func(items): ParsedVectorExpr(items, span),
						)
					CompactOpaqueIntoNode | CompactOpaqueFromNode:
						match (
							projected_child(rep, projected, node, 0),
							projected_types.get(node.payload_index),
						):
							(Some(child), Some(type_expr)):
								value = if node.kind == CompactOpaqueIntoNode:
									Some(ParsedOpaqueIntoExpr(type_expr, child, span))
								else:
									Some(ParsedOpaqueFromExpr(type_expr, child, span))
							_:
								void
					CompactFinalizedInterpolationNode:
						match rep.interpolation_parts_payloads.get(node.payload_index):
							Some(payload):
								var parts: List[ParsedStringInterpolationPart] = []
								var part_offset: Int = 0

								while part_offset < payload.part_count and valid:
									match rep.interpolation_parts.get(
										payload.part_start + part_offset,
									):
										Some(part):
											match part.kind:
												CompactInterpolationLiteralPart:
													match rep.texts.get(part.payload_index):
														Some(text):
															parts = parts.append(
																ParsedInterpolationLiteral(text),
															)
														None:
															valid = False
												CompactInterpolationExpressionPart:
													match projected_child(
														rep,
														projected,
														node,
														part.payload_index,
													):
														Some(expr):
															parts = parts.append(
																ParsedInterpolationExpr(expr),
															)
														None:
															valid = False
										None:
											valid = False

									part_offset += 1

								if valid:
									value = Some(
										ParsedStringInterpolationPartsExpr(
											parts,
											payload.is_multiline,
											span,
										),
									)
							None:
								void
					CompactBlockNode:
						value = projected_children(
							rep,
							projected,
							node,
							0,
						).map(
							func(items): ParsedBlockExpr(items, span),
						)
					CompactImmutableVarDeclNode | CompactMutableVarDeclNode:
						match (
							rep.typed_binders.get(node.payload_index),
							projected_child(rep, projected, node, 0),
						):
							(Some(payload), Some(initializer)):
								match (
									projected_control_identifier(rep, payload.identifier_index),
									projected_optional_type(
										projected_types,
										payload.type_root_index,
									),
								):
									(Some(identifier), Some(type_expr)):
										value = Some(
											ParsedVarDeclExpr(
												identifier,
												type_expr,
												initializer,
												node.kind == CompactMutableVarDeclNode,
												span,
											),
										)
									_:
										void
							_:
								void
					CompactAssignNode:
						match (
							projected_control_identifier(rep, node.payload_index),
							projected_child(rep, projected, node, 0),
						):
							(Some(identifier), Some(assigned_value)):
								value = Some(ParsedAssignExpr(identifier, assigned_value, span))
							_:
								void
					CompactCompoundAddAssignNode | CompactCompoundSubtractAssignNode | CompactCompoundMultiplyAssignNode | CompactCompoundDivideAssignNode:
						match (
							projected_control_identifier(rep, node.payload_index),
							parsed_compound_assign_operator(node.kind),
							projected_child(rep, projected, node, 0),
						):
							(Some(identifier), Some(op), Some(assigned_value)):
								value = Some(
									ParsedCompoundAssignExpr(
										identifier,
										op,
										assigned_value,
										span,
									),
								)
							_:
								void
					CompactSubscriptAssignNode:
						match (
							projected_child(rep, projected, node, 0),
							projected_child(rep, projected, node, node.child_count - 1),
						):
							(Some(target), Some(assigned_value)):
								var indices: List[ParsedExpr] = []
								var child_offset: Int = 1

								while child_offset < node.child_count - 1 and valid:
									match projected_child(rep, projected, node, child_offset):
										Some(index_value):
											indices = indices.append(index_value)
										None:
											valid = False

									child_offset += 1

								if valid:
									value = Some(
										ParsedSubscriptAssignExpr(
											target,
											indices,
											assigned_value,
											span,
										),
									)
							_:
								void
					CompactTupleDestructNode:
						match (
							projected_identifier_slice(rep, node.payload_index),
							projected_child(rep, projected, node, 0),
						):
							(Some(identifiers), Some(initializer)):
								value = Some(
									ParsedTupleDestructExpr(
										identifiers,
										initializer,
										span,
									),
								)
							_:
								void
					CompactQuestionBindNode:
						match (
							rep.typed_binders.get(node.payload_index),
							projected_child(rep, projected, node, 0),
						):
							(Some(payload), Some(initializer)):
								match (
									projected_control_identifier(rep, payload.identifier_index),
									projected_optional_type(
										projected_types,
										payload.type_root_index,
									),
								):
									(Some(identifier), Some(type_expr)):
										value = Some(
											ParsedQuestionBindExpr(
												identifier,
												type_expr,
												initializer,
												span,
											),
										)
									_:
										void
							_:
								void
					CompactIfNode:
						match (
							projected_child(rep, projected, node, 0),
							projected_child(rep, projected, node, 1),
						):
							(Some(condition), Some(then_expr)):
								else_expr: Option[ParsedExpr] = if node.child_count == 3:
									projected_child(rep, projected, node, 2)
								else:
									None

								if node.child_count == 2 or else_expr.is_some():
									value = Some(
										ParsedIfExpr(
											condition,
											then_expr,
											else_expr,
											span,
										),
									)
							_:
								void
					CompactMatchNode:
						match projected_child(rep, projected, node, 0):
							Some(scrutinee):
								var cases: List[ParsedMatchCase] = []
								var case_offset: Int = 0

								while case_offset < node.child_count - 1 and valid:
									match (
										rep.match_cases.get(node.payload_index + case_offset),
										projected_child(rep, projected, node, case_offset + 1),
									):
										(Some(case), Some(body)):
											match projected_patterns.get(case.pattern_root_index):
												Some(pattern):
													cases = cases.append({
														pattern = pattern,
														body = body,
														span = case.span.location,
													})
												None:
													valid = False
										_:
											valid = False

									case_offset += 1

								if valid:
									value = Some(ParsedMatchExpr(scrutinee, cases, span))
							None:
								void
					CompactSelectNode:
						var arms: List[ParsedSelectArm] = []
						var arm_offset: Int = 0

						while arm_offset < node.child_count / 2 and valid:
							match (
								rep.select_arms.get(node.payload_index + arm_offset),
								projected_child(rep, projected, node, arm_offset * 2),
								projected_child(rep, projected, node, arm_offset * 2 + 1),
							):
								(Some(arm), Some(source_expr), Some(body)):
									var kind: Option[ParsedSelectArmKind] = None

									match arm.kind:
										CompactSelectReceiveArm:
											kind = projected_control_identifier(
												rep,
												arm.binder_identifier_index,
											).map(
												func(
													name,
												): ParsedSelectReceiveArm(name, source_expr),
											)
										CompactSelectSealedArm:
											kind = Some(ParsedSelectSealedArm(source_expr))
										CompactSelectAfterArm:
											kind = Some(ParsedSelectAfterArm(source_expr))

									match kind:
										Some(arm_kind):
											arms = arms.append({
												kind = arm_kind,
												body = body,
												span = arm.span.location,
											})
										None:
											valid = False
								_:
									valid = False

							arm_offset += 1

						if valid:
							value = Some(ParsedSelectExpr(arms, span))
					CompactWithNode:
						match (
							rep.with_bindings.get(node.payload_index),
							projected_child(rep, projected, node, 0),
						):
							(Some(binding), Some(resource_value)):
								match (
									projected_control_identifier(
										rep,
										binding.binding_identifier_index,
									),
									projected_optional_type(
										projected_types,
										binding.type_root_index,
									),
								):
									(Some(name), Some(type_expr)):
										var error_map: Option[ParsedWithErrorMap] = None
										var body_offset: Int = 1

										if binding.error_map_index != NO_COMPACT_ERROR_MAP_INDEX:
											body_offset = 2

											match (
												rep.with_error_maps.get(binding.error_map_index),
												projected_child(rep, projected, node, 1),
											):
												(Some(map_row), Some(map_value)):
													match projected_control_identifier(
														rep,
														map_row.identifier_index,
													):
														Some(map_name):
															error_map = Some({
																name = map_name,
																value = map_value,
																span = map_row.span.location,
															})
														None:
															valid = False
												_:
													valid = False

										match projected_child(rep, projected, node, body_offset):
											Some(body):
												binding_kind = match binding.kind:
													CompactWithPlainBinding:
														ParsedWithPlainBinding
													CompactWithTryBinding:
														ParsedWithTryBinding

												if valid:
													value = Some(
														ParsedWithExpr(
															{
																name = name,
																type_expr = type_expr,
																value = resource_value,
																kind = binding_kind,
																error_map = error_map,
																span = binding.span.location
															},
															body,
															span,
														),
													)
											None:
												void
									_:
										void
							_:
								void
					CompactLambdaNode:
						match rep.lambda_payloads.get(node.payload_index):
							Some(payload):
								match (
									projected_lambda_params(
										rep,
										projected_types,
										payload.parameter_start,
										payload.parameter_count,
									),
									projected_optional_type(
										projected_types,
										payload.return_type_root_index,
									),
									projected_child(rep, projected, node, 0),
								):
									(Some(params), Some(return_type), Some(body)):
										value = Some(
											ParsedLambdaExpr(
												payload.is_pure,
												params,
												return_type,
												body,
												span,
											),
										)
									_:
										void
							None:
								void
					CompactFunctionDeclNode:
						match rep.function_payloads.get(node.payload_index):
							Some(payload):
								keyword_span = if payload.keyword_span.source_owner_index == NO_COMPACT_SOURCE_OWNER_INDEX:
									Some(None)
								else:
									Some(Some(payload.keyword_span.location))

								doc = if payload.doc_text_index == NO_COMPACT_TEXT_INDEX:
									Some(None)
								else:
									rep.texts
										.get(payload.doc_text_index)
										.map(func(text): Some(text))

								body = if node.child_count == 0:
									Some(None)
								else:
									projected_child(
										rep,
										projected,
										node,
										0,
									).map(
										func(expr): Some(expr),
									)

								match (
									projected_control_identifier(
										rep,
										payload.name_identifier_index,
									),
									projected_callable_type_params(
										rep,
										payload.type_parameter_start,
										payload.type_parameter_count,
									),
									projected_function_params(
										rep,
										projected_types,
										payload.parameter_start,
										payload.parameter_count,
									),
									projected_optional_type(
										projected_types,
										payload.return_type_root_index,
									),
								):
									(Some(name), Some(type_params), Some(params), Some(return_type)):
										match (
											projected_callable_dim_constraints(
												rep,
												projected_types,
												payload.dimension_constraint_start,
												payload.dimension_constraint_count,
											),
											projected_function_annotations(
												rep,
												payload.annotation_start,
												payload.annotation_count,
											),
											keyword_span,
											doc,
										):
											(Some(dim_constraints), Some(annotations), Some(function_keyword_span), Some(function_doc)):
												match body:
													Some(function_body):
														value = Some(ParsedFunctionDeclExpr({
															name = name,
															keyword_span = function_keyword_span,
															type_params = type_params,
															params = params,
															return_type = return_type,
															dim_constraints = dim_constraints,
															body = function_body,
															is_pure = payload.is_pure,
															annotations = annotations,
															doc = function_doc,
															span = span,
														}))
													None:
														void
											_:
												void
									_:
										void
							None:
								void
					CompactConcurrentBlockNode:
						parameter_count = node.child_count - 1

						match (
							projected_concurrent_params(
								rep,
								projected,
								node,
								node.payload_index,
								0,
								parameter_count,
							),
							projected_child(rep, projected, node, parameter_count),
						):
							(Some(params), Some(body)):
								value = Some(ParsedConcurrentBlockExpr(params, body, span))
							_:
								void
					CompactConcurrentForNode:
						match rep.concurrent_for_payloads.get(node.payload_index):
							Some(payload):
								parameter_count = node.child_count - 2

								match (
									projected_control_identifier(
										rep,
										payload.binder_identifier_index,
									),
									projected_child(rep, projected, node, 0),
									projected_concurrent_params(
										rep,
										projected,
										node,
										payload.parameter_start,
										1,
										parameter_count,
									),
									projected_child(rep, projected, node, parameter_count + 1),
								):
									(Some(name), Some(iterable), Some(params), Some(body)):
										value = Some(
											ParsedConcurrentForExpr(
												name,
												iterable,
												params,
												body,
												span,
											),
										)
									_:
										void
							None:
								void
					CompactDetachNode:
						value = projected_child(
							rep,
							projected,
							node,
							0,
						).map(
							func(body): ParsedDetachExpr(body, span),
						)
					CompactDebugBlockNode:
						value = projected_child(
							rep,
							projected,
							node,
							0,
						).map(
							func(body): ParsedDebugBlockExpr(body, span),
						)
					CompactWhileNode:
						match (
							projected_child(rep, projected, node, 0),
							projected_child(rep, projected, node, 1),
						):
							(Some(condition), Some(body)):
								value = Some(ParsedWhileExpr(condition, body, span))
							_:
								void
					CompactForNameNode:
						match (
							projected_control_identifier(rep, node.payload_index),
							projected_child(rep, projected, node, 0),
							projected_child(rep, projected, node, 1),
						):
							(Some(identifier), Some(iterable), Some(body)):
								value = Some(
									ParsedForExpr(
										ParsedForNameBinder(identifier),
										iterable,
										body,
										span,
									),
								)
							_:
								void
					CompactForTupleNode:
						match (
							rep.identifier_slices.get(node.payload_index),
							projected_identifier_slice(rep, node.payload_index),
							projected_child(rep, projected, node, 0),
							projected_child(rep, projected, node, 1),
						):
							(Some(payload), Some(identifiers), Some(iterable), Some(body)):
								value = Some(
									ParsedForExpr(
										ParsedForTupleBinder(identifiers, payload.span.location),
										iterable,
										body,
										span,
									),
								)
							_:
								void
					CompactBreakNode:
						value = Some(ParsedBreakExpr(span))
					CompactContinueNode:
						value = Some(ParsedContinueExpr(span))
					CompactVoidNode:
						value = Some(ParsedVoidExpr(span))
					CompactNamedBuiltinNode:
						value = compact_text_payload(
							rep,
							node.payload_index,
						).map(
							func(text): ParsedBuiltinExpr(Some(text), span),
						)
					CompactUnnamedBuiltinNode:
						value = Some(ParsedBuiltinExpr(None, span))
					CompactMissingNode:
						value = Some(ParsedMissingExpr(span))

				match value:
					Some(expr):
						projected = projected.append(expr)
					None:
						valid = False
			None:
				valid = False

		node_index += 1

	if not valid:
		Err(InvalidCompactExpressionOracleProduct)
	else:
		var roots: List[ParsedExpr] = []

		for root in rep.roots:
			match projected.get(root):
				Some(expr):
					roots = roots.append(expr)
				None:
					valid = False

		if valid:
			Ok(roots)
		else:
			Err(InvalidCompactExpressionOracleProduct)


private pure func compact_bound_name_lookup(
	rep: CompactExpressionProductRep,
	bound_text_indices: List[Int],
	name: String,
) -> CompactBoundNameLookup:
	var is_bound = False
	var comparison_count: Int = 0
	var index: Int = 0

	while index < bound_text_indices.length() and not is_bound:
		match bound_text_indices.get(index):
			Some(text_index):
				match rep.texts.get(text_index):
					Some(bound_name):
						comparison_count += 1
						is_bound = bound_name == name
					None:
						void
			None:
				void

		index += 1

	{
		is_bound = is_bound,
		comparison_count = comparison_count
	}


private pure func compact_expression_oracle_reference_traversal(
	product: ValidatedExpressionProduct,
) -> CompactReferenceTraversalResult:
	rep = from_opaque ValidatedExpressionProduct(product)
	var references: List[IdentifierReference] = []
	var actions: List[CompactReferenceAction] = []
	var bound_text_indices: List[Int] = []
	var bound_name_comparison_count: Int = 0
	var root_index = rep.roots.length() - 1

	while root_index >= 0:
		actions = actions.append(
			CompactReferenceVisit(
				rep.roots
					.get(root_index)
					.get_or(-1),
			),
		)
		root_index -= 1

	-- The action stack carries only scalar ids and counts. Scope changes mutate
	-- one local stack and are undone explicitly; no expression clones an
	-- environment and no global name set approximates lexical visibility.
	while not actions.is_empty():
		action_index = actions.length() - 1
		action = actions.get(action_index)
		actions = actions.take(action_index)

		match action:
			Some(CompactReferenceVisit(node_id)):
				match rep.nodes.get(node_id):
					Some(node):
						match node.kind:
							CompactNameNode:
								match compact_text_payload(rep, node.payload_index):
									Some(text):
										lookup = compact_bound_name_lookup(
											rep,
											bound_text_indices,
											text,
										)
										bound_name_comparison_count += lookup.comparison_count

										if not lookup.is_bound:
											references = references.append({
												name = text,
												qualified_member = None,
												span = node.span.location,
											})
									None:
										void
							CompactFieldAccessNode:
								match (
									rep.children.get(node.child_start),
									rep.field_access_payloads.get(node.payload_index),
								):
									(Some(target_id), Some(payload)):
										match rep.nodes.get(target_id):
											Some(target):
												if target.kind == CompactNameNode:
													match (
														compact_text_payload(
															rep,
															target.payload_index,
														),
														rep.texts.get(payload.field_text_index),
													):
														(Some(name), Some(member)):
															lookup = compact_bound_name_lookup(
																rep,
																bound_text_indices,
																name,
															)
															bound_name_comparison_count += lookup.comparison_count

															if not lookup.is_bound:
																references = references.append({
																	name = name,
																	qualified_member = Some(member),
																	span = target.span.location,
																})
														_:
															void
												else:
													actions = actions.append(
														CompactReferenceVisit(target_id),
													)
											None:
												void
									_:
										void
							CompactMatchNode:
								var case_offset = node.child_count - 2

								while case_offset >= 0:
									match rep.match_cases.get(node.payload_index + case_offset):
										Some(case):
											actions = actions
												.append(
													CompactReferenceLeaveBindings(
														case.binding_count,
													),
												)
												.append(
													CompactReferenceVisit(
														rep.children
															.get(node.child_start + case_offset + 1)
															.get_or(-1),
													),
												)
												.append(
													CompactReferenceEnterPatternNode(
														case.pattern_root_index,
													),
												)
										None:
											void

									case_offset -= 1

								actions = actions.append(
									CompactReferenceVisit(
										rep.children
											.get(node.child_start)
											.get_or(-1),
									),
								)
							CompactSelectNode:
								var arm_offset = node.child_count / 2 - 1

								while arm_offset >= 0:
									match rep.select_arms.get(node.payload_index + arm_offset):
										Some(arm):
											if arm.kind == CompactSelectReceiveArm:
												actions = actions.append(
													CompactReferenceLeaveBindings(1),
												)

											actions = actions.append(
												CompactReferenceVisit(
													rep.children
														.get(node.child_start + arm_offset * 2 + 1)
														.get_or(-1),
												),
											)

											if arm.kind == CompactSelectReceiveArm:
												actions = actions.append(
													CompactReferenceEnterIdentifier(
														arm.binder_identifier_index,
													),
												)

											actions = actions.append(
												CompactReferenceVisit(
													rep.children
														.get(node.child_start + arm_offset * 2)
														.get_or(-1),
												),
											)
										None:
											void

									arm_offset -= 1
							CompactWithNode:
								match rep.with_bindings.get(node.payload_index):
									Some(binding):
										body_offset = if binding.error_map_index == NO_COMPACT_ERROR_MAP_INDEX:
											1
										else:
											2

										actions = actions
											.append(CompactReferenceLeaveBindings(1))
											.append(
												CompactReferenceVisit(
													rep.children
														.get(node.child_start + body_offset)
														.get_or(-1),
												),
											)
											.append(
												CompactReferenceEnterIdentifier(
													binding.binding_identifier_index,
												),
											)

										if binding.error_map_index != NO_COMPACT_ERROR_MAP_INDEX:
											match rep.with_error_maps.get(binding.error_map_index):
												Some(error_map):
													actions = actions
														.append(CompactReferenceLeaveBindings(1))
														.append(
															CompactReferenceVisit(
																rep.children
																	.get(node.child_start + 1)
																	.get_or(-1),
															),
														)
														.append(
															CompactReferenceEnterIdentifier(
																error_map.identifier_index,
															),
														)
												None:
													void

										actions = actions.append(
											CompactReferenceVisit(
												rep.children
													.get(node.child_start)
													.get_or(-1),
											),
										)
									None:
										void
							CompactLambdaNode:
								match rep.lambda_payloads.get(node.payload_index):
									Some(payload):
										actions = actions
											.append(
												CompactReferenceLeaveBindings(
													payload.parameter_count,
												),
											)
											.append(
												CompactReferenceVisit(
													rep.children
														.get(node.child_start)
														.get_or(-1),
												),
											)
										var parameter_offset = payload.parameter_count - 1

										while parameter_offset >= 0:
											match rep.callable_params.get(
												payload.parameter_start + parameter_offset,
											):
												Some(parameter):
													actions = actions.append(
														CompactReferenceEnterIdentifier(
															parameter.binder_payload_index,
														),
													)
												None:
													void

											parameter_offset -= 1
									None:
										void
							CompactFunctionDeclNode:
								-- The production expression-reference consumer treats nested
								-- declarations as opaque and does not bind their names.
								void
							CompactConcurrentBlockNode:
								parameter_count = node.child_count - 1
								body_id = rep.children
									.get(node.child_start + parameter_count)
									.get_or(-1)

								match rep.nodes.get(body_id):
									Some(body):
										if body.kind == CompactBlockNode:
											var task_offset = body.child_count - 1

											while task_offset >= 0:
												actions = actions.append(
													CompactReferenceVisitConcurrentTask(
														rep.children
															.get(body.child_start + task_offset)
															.get_or(-1),
													),
												)
												task_offset -= 1
										else:
											actions = actions.append(CompactReferenceVisit(body_id))
									None:
										void

								var parameter_offset = parameter_count - 1

								while parameter_offset >= 0:
									actions = actions.append(
										CompactReferenceVisit(
											rep.children
												.get(node.child_start + parameter_offset)
												.get_or(-1),
										),
									)
									parameter_offset -= 1
							CompactConcurrentForNode:
								match rep.concurrent_for_payloads.get(node.payload_index):
									Some(payload):
										parameter_count = node.child_count - 2
										actions = actions
											.append(CompactReferenceLeaveBindings(1))
											.append(
												CompactReferenceVisit(
													rep.children
														.get(node.child_start + parameter_count + 1)
														.get_or(-1),
												),
											)
											.append(
												CompactReferenceEnterIdentifier(
													payload.binder_identifier_index,
												),
											)
										var parameter_offset = parameter_count - 1

										while parameter_offset >= 0:
											actions = actions.append(
												CompactReferenceVisit(
													rep.children
														.get(
															node.child_start + parameter_offset + 1,
														)
														.get_or(-1),
												),
											)
											parameter_offset -= 1

										actions = actions.append(
											CompactReferenceVisit(
												rep.children
													.get(node.child_start)
													.get_or(-1),
											),
										)
									None:
										void
							CompactBlockNode:
								var entered_count: Int = 0
								leave_action_index = actions.length()
								actions = actions.append(CompactReferenceLeaveBindings(0))
								var child_offset = node.child_count - 1

								while child_offset >= 0:
									match rep.children.get(node.child_start + child_offset):
										Some(child_id):
											match rep.nodes.get(child_id):
												Some(child):
													match child.kind:
														CompactImmutableVarDeclNode | CompactMutableVarDeclNode | CompactQuestionBindNode:
															match rep.typed_binders.get(
																child.payload_index,
															):
																Some(payload):
																	entered_count += 1
																	actions = actions.append(
																		CompactReferenceEnterIdentifier(
																			payload.identifier_index,
																		),
																	)
																None:
																	void
														CompactTupleDestructNode:
															match rep.identifier_slices.get(
																child.payload_index,
															):
																Some(slice):
																	entered_count += slice.identifier_count
																	actions = actions.append(
																		CompactReferenceEnterIdentifierSlice(
																			child.payload_index,
																		),
																	)
																None:
																	void
														_:
															void
												None:
													void

											actions = actions.append(
												CompactReferenceVisit(child_id),
											)
										None:
											void

									child_offset -= 1

								actions = actions.set(
									leave_action_index,
									CompactReferenceLeaveBindings(entered_count),
								)
							CompactForNameNode | CompactForTupleNode:
								var binding_count: Int = 1
								var enter_action: CompactReferenceAction = CompactReferenceEnterIdentifier(
									node.payload_index,
								)

								if node.kind == CompactForTupleNode:
									binding_count = rep.identifier_slices
										.get(node.payload_index)
										.map(func(slice): slice.identifier_count)
										.get_or(0)
									enter_action = CompactReferenceEnterIdentifierSlice(
										node.payload_index,
									)

								actions = actions
									.append(CompactReferenceLeaveBindings(binding_count))
									.append(
										CompactReferenceVisit(
											rep.children
												.get(node.child_start + 1)
												.get_or(-1),
										),
									)
									.append(enter_action)
									.append(
										CompactReferenceVisit(
											rep.children
												.get(node.child_start)
												.get_or(-1),
										),
									)
							CompactAssignNode | CompactCompoundAddAssignNode | CompactCompoundSubtractAssignNode | CompactCompoundMultiplyAssignNode | CompactCompoundDivideAssignNode:
								match projected_control_identifier(rep, node.payload_index):
									Some(identifier):
										lookup = compact_bound_name_lookup(
											rep,
											bound_text_indices,
											identifier.text,
										)
										bound_name_comparison_count += lookup.comparison_count

										if not lookup.is_bound:
											references = references.append({
												name = identifier.text,
												qualified_member = None,
												span = identifier.span,
											})
									None:
										void

								match rep.children.get(node.child_start):
									Some(child_id):
										actions = actions.append(CompactReferenceVisit(child_id))
									None:
										void
							_:
								var child_offset = node.child_count - 1

								while child_offset >= 0:
									match rep.children.get(node.child_start + child_offset):
										Some(child_id):
											actions = actions.append(
												CompactReferenceVisit(child_id),
											)
										None:
											void

									child_offset -= 1
					None:
						void
			Some(CompactReferenceVisitConcurrentTask(node_id)):
				match rep.nodes.get(node_id):
					Some(node):
						match node.kind:
							CompactAssignNode | CompactImmutableVarDeclNode | CompactMutableVarDeclNode:
								actions = actions.append(
									CompactReferenceVisit(
										rep.children
											.get(node.child_start)
											.get_or(-1),
									),
								)
							_:
								actions = actions.append(CompactReferenceVisit(node_id))
					None:
						void
			Some(CompactReferenceEnterIdentifier(identifier_index)):
				match rep.control_identifiers.get(identifier_index):
					Some(identifier):
						bound_text_indices = bound_text_indices.append(identifier.text_index)
					None:
						void
			Some(CompactReferenceEnterIdentifierSlice(slice_index)):
				match rep.identifier_slices.get(slice_index):
					Some(slice):
						var offset: Int = 0

						while offset < slice.identifier_count:
							match rep.control_identifiers.get(slice.identifier_start + offset):
								Some(identifier):
									bound_text_indices = bound_text_indices.append(
										identifier.text_index,
									)
								None:
									void

							offset += 1
					None:
						void
			Some(CompactReferenceEnterPatternNode(pattern_node_index)):
				match rep.pattern_nodes.get(pattern_node_index):
					Some(node):
						if node.kind == CompactListNameSpreadPatternNode:
							actions = actions.append(
								CompactReferenceEnterPatternIdentifiers(node.payload_index),
							)

						var child_offset = node.child_count - 1

						while child_offset >= 0:
							match rep.pattern_children.get(node.child_start + child_offset):
								Some(child_id):
									actions = actions.append(
										CompactReferenceEnterPatternNode(child_id),
									)
								None:
									void

							child_offset -= 1

						if node.kind == CompactNamePatternNode:
							actions = actions.append(
								CompactReferenceEnterPatternIdentifiers(node.payload_index),
							)
					None:
						void
			Some(CompactReferenceEnterPatternIdentifiers(slice_index)):
				match rep.pattern_identifier_slices.get(slice_index):
					Some(slice):
						var offset: Int = 0

						while offset < slice.identifier_count:
							match rep.pattern_identifiers.get(slice.identifier_start + offset):
								Some(identifier):
									bound_text_indices = bound_text_indices.append(
										identifier.text_index,
									)
								None:
									void

							offset += 1
					None:
						void
			Some(CompactReferenceLeaveBindings(count)):
				bound_text_indices = bound_text_indices.take(bound_text_indices.length() - count)
			None:
				void

	{
		references = references,
		bound_name_comparison_count = bound_name_comparison_count
	}


pure func compact_expression_oracle_free_identifier_references(
	product: ValidatedExpressionProduct,
) -> List[IdentifierReference]:
	compact_expression_oracle_reference_traversal(product).references


pure func compact_expression_oracle_reference_traversal_counts(
	product: ValidatedExpressionProduct,
) -> CompactReferenceTraversalCounts:
	result = compact_expression_oracle_reference_traversal(product)
	{
		reference_count = result.references.length(),
		bound_name_comparison_count = result.bound_name_comparison_count
	}


pure func compact_expression_oracle_counts(
	product: ValidatedExpressionProduct,
) -> CompactExpressionProductCounts:
	rep = from_opaque ValidatedExpressionProduct(product)
	{
		source_owner_count = rep.source_owners.length(),
		node_count = rep.nodes.length(),
		child_count = rep.children.length(),
		text_count = rep.texts.length(),
		text_payload_count = rep.text_payloads.length(),
		string_payload_count = rep.string_payloads.length(),
		interpolation_payload_count = rep.interpolation_payloads.length(),
		bool_payload_count = rep.bool_payloads.length(),
		char_payload_count = rep.char_payloads.length(),
		operator_payload_count = rep.operator_payloads.length(),
		call_payload_count = rep.call_payloads.length(),
		field_access_payload_count = rep.field_access_payloads.length(),
		record_payload_count = rep.record_payloads.length(),
		record_field_count = rep.record_fields.length(),
		dict_payload_count = rep.dict_payloads.length(),
		dict_entry_count = rep.dict_entries.length(),
		type_node_count = rep.type_nodes.length(),
		type_child_count = rep.type_children.length(),
		type_identifier_slice_count = rep.type_identifier_slices.length(),
		type_identifier_count = rep.type_identifiers.length(),
		interpolation_parts_payload_count = rep.interpolation_parts_payloads.length(),
		interpolation_part_count = rep.interpolation_parts.length(),
		control_identifier_count = rep.control_identifiers.length(),
		identifier_slice_count = rep.identifier_slices.length(),
		typed_binder_count = rep.typed_binders.length(),
		pattern_node_count = rep.pattern_nodes.length(),
		pattern_child_count = rep.pattern_children.length(),
		pattern_identifier_slice_count = rep.pattern_identifier_slices.length(),
		pattern_identifier_count = rep.pattern_identifiers.length(),
		match_case_count = rep.match_cases.length(),
		select_arm_count = rep.select_arms.length(),
		with_binding_count = rep.with_bindings.length(),
		with_error_map_count = rep.with_error_maps.length(),
		lambda_payload_count = rep.lambda_payloads.length(),
		function_payload_count = rep.function_payloads.length(),
		callable_param_count = rep.callable_params.length(),
		callable_type_param_count = rep.callable_type_params.length(),
		callable_dim_constraint_count = rep.callable_dim_constraints.length(),
		function_annotation_count = rep.function_annotations.length(),
		concurrent_param_count = rep.concurrent_params.length(),
		concurrent_for_payload_count = rep.concurrent_for_payloads.length(),
		unit_payload_count = rep.unit_payloads.length(),
		root_count = rep.roots.length()
	}


private pure func compact_product_with_corrupt_binder_type_root(
	rep: CompactExpressionProductRep,
	scope_root: Int,
	type_root_index: Int,
) -> CompactExpressionProductRep:
	match rep.nodes.get(scope_root):
		Some(scope_node):
			match rep.children.get(scope_node.child_start + 2):
				Some(var_node_id):
					match rep.nodes.get(var_node_id):
						Some(var_node):
							match rep.typed_binders.get(var_node.payload_index):
								Some(payload):
									{ rep |
										typed_binders = rep.typed_binders.set(
											var_node.payload_index,
											{ payload | type_root_index = type_root_index },
										)
									}
								None:
									rep
						None:
							rep
				None:
					rep
		None:
			rep


private pure func compact_corruption_scope_tuple_node_id(
	rep: CompactExpressionProductRep,
	scope_root: Int,
) -> Option[Int]:
	match rep.nodes.get(scope_root):
		Some(scope_node):
			rep.children.get(scope_node.child_start + 3)
		None:
			None


private pure func compact_corruption_match_case(
	rep: CompactExpressionProductRep,
	match_root: Int,
	case_offset: Int,
) -> Option[CompactMatchCaseRow]:
	match rep.nodes.get(match_root):
		Some(node):
			rep.match_cases.get(node.payload_index + case_offset)
		None:
			None


private pure func compact_corruption_pattern_child(
	rep: CompactExpressionProductRep,
	pattern_root: Int,
	child_offset: Int,
) -> Option[Int]:
	match rep.pattern_nodes.get(pattern_root):
		Some(node):
			rep.pattern_children.get(node.child_start + child_offset)
		None:
			None


pure func compact_expression_oracle_rejects_corruption(
	source: SourceFile,
	corruption: CompactExpressionCorruption,
) -> Bool:
	if source.text.length() < 10:
		False
	else:
		start_span = compact_source_location(
			source_location_from_offsets(
				singleton_source_file_id(),
				0,
				1,
			),
		)
		left = ParsedNameExpr(parsed_identifier("a", start_span.location))
		right = ParsedNameExpr(parsed_identifier("b", start_span.location))
		base = ParsedBinaryExpr(
			ParsedAddOp,
			ParsedBinaryExpr(ParsedMultiplyOp, left, right, start_span.location),
			right,
			start_span.location,
		)
		record_a = ParsedRecordExpr(
			[
				{
					name = parsed_identifier("first", start_span.location),
					value = left,
					span = start_span.location
				},
			],
			start_span.location,
		)
		record_b = ParsedRecordExpr(
			[
				{
					name = parsed_identifier("second", start_span.location),
					value = right,
					span = start_span.location
				},
			],
			start_span.location,
		)
		typed = ParsedAscriptionExpr(
			left,
			ParsedNamedType(
				parsed_identifier("Type", start_span.location),
				[],
				start_span.location,
			),
			start_span.location,
		)
		interpolated = ParsedStringInterpolationPartsExpr(
			[ParsedInterpolationExpr(left), ParsedInterpolationExpr(right)],
			False,
			start_span.location,
		)
		scoped = ParsedBlockExpr(
			[ParsedAssignExpr(
					parsed_identifier("a", start_span.location),
					left,
					start_span.location,
				), ParsedAssignExpr(
					parsed_identifier("b", start_span.location),
					right,
					start_span.location,
				), ParsedVarDeclExpr(
					parsed_identifier("bound", start_span.location),
					Some(
						ParsedNamedType(
							parsed_identifier("Type", start_span.location),
							[],
							start_span.location,
						),
					),
					left,
					False,
					start_span.location,
				), ParsedTupleDestructExpr(
					[parsed_identifier("tuple", start_span.location)],
					left,
					start_span.location,
				)],
			start_span.location,
		)
		looped = ParsedForExpr(
			ParsedForTupleBinder(
				[
					parsed_identifier("left", start_span.location),
					parsed_identifier("right", start_span.location),
				],
				start_span.location,
			),
			left,
			right,
			start_span.location,
		)
		matched = ParsedMatchExpr(
			left,
			[
				{
					pattern = ParsedTuplePattern(
						[
							ParsedNamePattern(parsed_identifier("bound", start_span.location)),
							ParsedConstructorPattern(
								parsed_identifier("Some", start_span.location),
								[
									ParsedNamePattern(
										parsed_identifier(
											"value",
											start_span.location,
										),
									),
								],
								start_span.location,
							),
						],
						start_span.location,
					),
					body = right,
					span = start_span.location
				},
				{
					pattern = ParsedWildcardPattern(start_span.location),
					body = left,
					span = start_span.location
				},
			],
			start_span.location,
		)
		selected = ParsedSelectExpr(
			[
				{
					kind = ParsedSelectReceiveArm(
						parsed_identifier("received", start_span.location),
						left,
					),
					body = right,
					span = start_span.location
				},
				{
					kind = ParsedSelectSealedArm(right),
					body = left,
					span = start_span.location
				},
			],
			start_span.location,
		)
		plain_with = ParsedWithExpr(
			{
				name = parsed_identifier("resource", start_span.location),
				type_expr = None,
				value = left,
				kind = ParsedWithPlainBinding,
				error_map = None,
				span = start_span.location
			},
			right,
			start_span.location,
		)
		mapped_with = ParsedWithExpr(
			{
				name = parsed_identifier("resource", start_span.location),
				type_expr = Some(
					ParsedNamedType(
						parsed_identifier("Type", start_span.location),
						[],
						start_span.location,
					),
				),
				value = left,
				kind = ParsedWithTryBinding,
				error_map = Some({
					name = parsed_identifier("error", start_span.location),
					value = right,
					span = start_span.location,
				}),
				span = start_span.location
			},
			left,
			start_span.location,
		)
		callable_type = ParsedNamedType(
			parsed_identifier("Type", start_span.location),
			[],
			start_span.location,
		)
		first_lambda = ParsedLambdaExpr(
			True,
			[
				{
					name = parsed_identifier("first", start_span.location),
					type_expr = Some(callable_type),
					span = start_span.location
				},
			],
			Some(callable_type),
			left,
			start_span.location,
		)
		second_lambda = ParsedLambdaExpr(
			False,
			[
				{
					name = parsed_identifier("second", start_span.location),
					type_expr = None,
					span = start_span.location
				},
			],
			None,
			right,
			start_span.location,
		)
		first_function = ParsedFunctionDeclExpr({
			name = parsed_identifier("first_function", start_span.location),
			keyword_span = Some(start_span.location),
			type_params = [
				{
					name = parsed_identifier("T", start_span.location),
					bounds = [parsed_identifier("Eq", start_span.location)],
					span = start_span.location
				},
			],
			params = [
				{
					binder = ParsedParamWildcardBinder(start_span.location),
					type_expr = None,
					span = start_span.location
				},
				{
					binder = ParsedParamNameBinder(parsed_identifier("value", start_span.location)),
					type_expr = Some(callable_type),
					span = start_span.location
				},
			],
			return_type = Some(callable_type),
			dim_constraints = [
				{
					left = callable_type,
					right = callable_type,
					span = start_span.location
				},
			],
			body = Some(left),
			is_pure = False,
			annotations = [ParsedTailRecursiveAnnotation, ParsedNoCopyAnnotation],
			doc = Some("docs"),
			span = start_span.location,
		})
		second_function = ParsedFunctionDeclExpr({
			name = parsed_identifier("second_function", start_span.location),
			keyword_span = None,
			type_params = [],
			params = [],
			return_type = None,
			dim_constraints = [],
			body = None,
			is_pure = True,
			annotations = [ParsedDebugOnlyAnnotation],
			doc = None,
			span = start_span.location,
		})
		concurrent_block = ParsedConcurrentBlockExpr(
			[
				{
					name = parsed_identifier("limit", start_span.location),
					value = left,
					span = start_span.location
				},
			],
			right,
			start_span.location,
		)
		first_concurrent_for = ParsedConcurrentForExpr(
			parsed_identifier(
				"item",
				start_span.location,
			),
			left,
			[
				{
					name = parsed_identifier("limit", start_span.location),
					value = right,
					span = start_span.location
				},
			],
			right,
			start_span.location,
		)
		second_concurrent_for = ParsedConcurrentForExpr(
			parsed_identifier(
				"other",
				start_span.location,
			),
			right,
			[
				{
					name = parsed_identifier("timeout", start_span.location),
					value = left,
					span = start_span.location
				},
			],
			left,
			start_span.location,
		)
		detached = ParsedDetachExpr(left, start_span.location)

		match (
			compact_expression_oracle_from_parsed_roots(
				source,
				[
					base,
					ParsedBoolLiteralExpr(True, start_span.location),
					ParsedCallExpr(left, [], start_span.location),
					record_a,
					record_b,
					typed,
					interpolated,
					scoped,
					looped,
					matched,
					selected,
					selected,
					plain_with,
					mapped_with,
					mapped_with,
					first_lambda,
					second_lambda,
					first_function,
					second_function,
					concurrent_block,
					first_concurrent_for,
					second_concurrent_for,
					detached,
				],
			)
		):
			Ok(product):
				rep = from_opaque ValidatedExpressionProduct(product)
				var corrupted = rep
				binary_root = rep.roots
					.get(0)
					.get_or(-1)
				call_root = rep.roots
					.get(2)
					.get_or(-1)
				record_a_root = rep.roots
					.get(3)
					.get_or(-1)
				record_b_root = rep.roots
					.get(4)
					.get_or(-1)
				typed_root = rep.roots
					.get(5)
					.get_or(-1)
				interpolation_root = rep.roots
					.get(6)
					.get_or(-1)
				scope_root = rep.roots
					.get(7)
					.get_or(-1)
				loop_root = rep.roots
					.get(8)
					.get_or(-1)
				match_root = rep.roots
					.get(9)
					.get_or(-1)
				first_select_root = rep.roots
					.get(10)
					.get_or(-1)
				second_select_root = rep.roots
					.get(11)
					.get_or(-1)
				plain_with_root = rep.roots
					.get(12)
					.get_or(-1)
				first_mapped_with_root = rep.roots
					.get(13)
					.get_or(-1)
				second_mapped_with_root = rep.roots
					.get(14)
					.get_or(-1)
				first_lambda_root = rep.roots
					.get(15)
					.get_or(-1)
				second_lambda_root = rep.roots
					.get(16)
					.get_or(-1)
				first_function_root = rep.roots
					.get(17)
					.get_or(-1)
				second_function_root = rep.roots
					.get(18)
					.get_or(-1)
				concurrent_block_root = rep.roots
					.get(19)
					.get_or(-1)
				first_concurrent_for_root = rep.roots
					.get(20)
					.get_or(-1)
				second_concurrent_for_root = rep.roots
					.get(21)
					.get_or(-1)
				detach_root = rep.roots
					.get(22)
					.get_or(-1)

				match corruption:
					CompactChildIdOutOfRange:
						corrupted = { rep | children = rep.children.set(0, rep.nodes.length()) }
					CompactChildSliceOverlap:
						match rep.nodes.get(binary_root):
							Some(node):
								corrupted = { rep |
									nodes = rep.nodes.set(binary_root, { node | child_start = 0 })
								}
							None:
								void
					CompactDuplicateRoot:
						corrupted = { rep | roots = rep.roots.append(binary_root) }
					CompactForeignSourceOwner:
						match rep.nodes.get(0):
							Some(node):
								corrupted = { rep |
									nodes = rep.nodes.set(
										0,
										{ node | span = { node.span | source_owner_index = 1 } },
									)
								}
							None:
								void
					CompactNodeBackEdge:
						corrupted = { rep | children = rep.children.set(0, 2) }
					CompactNegativeCallArity:
						match rep.nodes.get(call_root):
							Some(node):
								match rep.call_payloads.get(node.payload_index):
									Some(payload):
										corrupted = { rep |
											call_payloads = rep.call_payloads.set(
												node.payload_index,
												{ payload | argument_count = -1 },
											)
										}
									None:
										void
							None:
								void
					CompactOrphanNode:
						text_index = rep.texts.length()
						payload_index = rep.text_payloads.length()
						corrupted = { rep |
							texts = rep.texts.append("orphan"),
							text_payloads = rep.text_payloads.append({text_index = text_index}),
							nodes = rep.nodes.append({
								kind = CompactNameNode,
								payload_index = payload_index,
								child_start = rep.children.length(),
								child_count = 0,
								span = start_span,
							})
						}
					CompactOrphanPayload:
						corrupted = { rep |
							text_payloads = rep.text_payloads.append({text_index = 0})
						}
					CompactPayloadFamilyMismatch:
						match rep.nodes.get(0):
							Some(node):
								corrupted = { rep |
									nodes = rep.nodes.set(0, { node | kind = CompactBoolNode })
								}
							None:
								void
					CompactSharedChild:
						match rep.nodes.get(binary_root):
							Some(node):
								corrupted = { rep |
									children = rep.children.set(node.child_start + 1, 0)
								}
							None:
								void
					CompactTextIndexAlias:
						match rep.text_payloads.get(1):
							Some(payload):
								corrupted = { rep |
									text_payloads = rep.text_payloads.set(
										1,
										{ payload | text_index = 0 },
									)
								}
							None:
								void
					CompactWrongArity:
						match rep.nodes.get(binary_root):
							Some(node):
								corrupted = { rep |
									nodes = rep.nodes.set(binary_root, { node | child_count = 1 })
								}
							None:
								void
					CompactMetadataSliceAlias:
						match (rep.nodes.get(record_a_root), rep.nodes.get(record_b_root)):
							(Some(first_node), Some(second_node)):
								match (
									rep.record_payloads.get(first_node.payload_index),
									rep.record_payloads.get(second_node.payload_index),
								):
									(Some(first), Some(second)):
										corrupted = { rep |
											record_payloads = rep.record_payloads.set(
												second_node.payload_index,
												{ second | field_start = first.field_start },
											)
										}
									_:
										void
							_:
								void
					CompactAbsurdMetadataCount:
						match rep.nodes.get(record_a_root):
							Some(node):
								match rep.record_payloads.get(node.payload_index):
									Some(payload):
										corrupted = { rep |
											record_payloads = rep.record_payloads.set(
												node.payload_index,
												{ payload | field_count = 999999999 },
											)
										}
									None:
										void
							None:
								void
					CompactTypePayloadFamilyMismatch:
						match rep.nodes.get(typed_root):
							Some(node):
								match rep.type_nodes.get(node.payload_index):
									Some(type_node):
										corrupted = { rep | type_nodes = rep.type_nodes.set(
												node.payload_index,
												{ type_node |
													kind = CompactDimLiteralTypeNode,
													payload_index = 0
												},
											) }
									None:
										void
							None:
								void
					CompactInterpolationPartOrdinalAlias:
						match rep.nodes.get(interpolation_root):
							Some(node):
								match rep.interpolation_parts_payloads.get(node.payload_index):
									Some(payload):
										match rep.interpolation_parts.get(payload.part_start + 1):
											Some(part):
												corrupted = { rep |
													interpolation_parts = rep.interpolation_parts.set(
														payload.part_start + 1,
														{ part | payload_index = 0 },
													)
												}
											None:
												void
									None:
										void
							None:
								void
					CompactAbsurdInterpolationPartCount:
						match rep.nodes.get(interpolation_root):
							Some(node):
								match rep.interpolation_parts_payloads.get(node.payload_index):
									Some(payload):
										corrupted = { rep |
											interpolation_parts_payloads = rep.interpolation_parts_payloads.set(
												node.payload_index,
												{ payload | part_count = 999999999 },
											)
										}
									None:
										void
							None:
								void
					CompactControlIdentifierAlias:
						match rep.nodes.get(scope_root):
							Some(node):
								match (
									rep.children.get(node.child_start),
									rep.children.get(node.child_start + 1),
								):
									(Some(first_assign), Some(second_assign)):
										match (
											rep.nodes.get(first_assign),
											rep.nodes.get(second_assign),
										):
											(Some(first), Some(second)):
												corrupted = { rep |
													nodes = rep.nodes.set(
														second_assign,
														{ second |
															payload_index = first.payload_index
														},
													)
												}
											_:
												void
									_:
										void
							None:
								void
					CompactTypedBinderTypeRootOutOfRange:
						corrupted = compact_product_with_corrupt_binder_type_root(
							rep,
							scope_root,
							rep.type_nodes.length(),
						)
					CompactTypedBinderInvalidAbsentTypeRoot:
						corrupted = compact_product_with_corrupt_binder_type_root(
							rep,
							scope_root,
							-2,
						)
					CompactTypedBinderSharedTypeRoot:
						match rep.nodes.get(typed_root):
							Some(typed_node):
								corrupted = compact_product_with_corrupt_binder_type_root(
									rep,
									scope_root,
									typed_node.payload_index,
								)
							None:
								void
					CompactForBinderSliceOutOfRange:
						match rep.nodes.get(loop_root):
							Some(loop_node):
								match rep.identifier_slices.get(loop_node.payload_index):
									Some(slice):
										corrupted = { rep |
											identifier_slices = rep.identifier_slices.set(
												loop_node.payload_index,
												{ slice |
													identifier_start = rep.control_identifiers.length()
												},
											)
										}
									None:
										void
							None:
								void
					CompactForBinderSliceAlias:
						match (
							compact_corruption_scope_tuple_node_id(rep, scope_root),
							rep.nodes.get(loop_root),
						):
							(Some(tuple_node_id), Some(loop_node)):
								match rep.nodes.get(tuple_node_id):
									Some(tuple_node):
										corrupted = { rep |
											nodes = rep.nodes.set(
												loop_root,
												{ loop_node |
													payload_index = tuple_node.payload_index
												},
											)
										}
									None:
										void
							_:
								void
					CompactIdentifierSliceForeignSourceOwner:
						match compact_corruption_scope_tuple_node_id(rep, scope_root):
							Some(tuple_node_id):
								match rep.nodes.get(tuple_node_id):
									Some(tuple_node):
										match rep.identifier_slices.get(tuple_node.payload_index):
											Some(slice):
												corrupted = { rep |
													identifier_slices = rep.identifier_slices.set(
														tuple_node.payload_index,
														{ slice |
															span = { slice.span |
																source_owner_index = 1
															}
														},
													)
												}
											None:
												void
									None:
										void
							None:
								void
					CompactPatternChildBackEdge:
						match compact_corruption_match_case(rep, match_root, 0):
							Some(case):
								match rep.pattern_nodes.get(case.pattern_root_index):
									Some(pattern_root):
										corrupted = { rep |
											pattern_children = rep.pattern_children.set(
												pattern_root.child_start,
												case.pattern_root_index,
											)
										}
									None:
										void
							None:
								void
					CompactPatternSharedChild:
						match compact_corruption_match_case(rep, match_root, 0):
							Some(case):
								match (
									rep.pattern_nodes.get(case.pattern_root_index),
									compact_corruption_pattern_child(
										rep,
										case.pattern_root_index,
										0,
									),
								):
									(Some(pattern_root), Some(first_child)):
										corrupted = { rep |
											pattern_children = rep.pattern_children.set(
												pattern_root.child_start + 1,
												first_child,
											)
										}
									_:
										void
							None:
								void
					CompactPatternOrphanNode:
						corrupted = { rep | pattern_nodes = rep.pattern_nodes.append({
								kind = CompactWildcardPatternNode,
								payload_index = NO_COMPACT_PAYLOAD_INDEX,
								child_start = rep.pattern_children.length(),
								child_count = 0,
								span = start_span,
							}) }
					CompactPatternPayloadFamilyMismatch:
						match compact_corruption_match_case(rep, match_root, 0):
							Some(case):
								match compact_corruption_pattern_child(
									rep,
									case.pattern_root_index,
									0,
								):
									Some(name_node_id):
										match rep.pattern_nodes.get(name_node_id):
											Some(name_node):
												corrupted = { rep |
													pattern_nodes = rep.pattern_nodes.set(
														name_node_id,
														{ name_node |
															kind = CompactBoolPatternNode
														},
													)
												}
											None:
												void
									None:
										void
							None:
								void
					CompactPatternIdentifierSliceAlias:
						match compact_corruption_match_case(rep, match_root, 0):
