import:
	../../lib/source: SourceFile, SourceLocation, SourceSpan, SourceTable, source_location_span
	../stage_02_lex/parse_diagnostic: ParseDiagnostic


enum ParsedProgramPhase:
	RawParsedProgram
	TypecheckSourceProgram


pure func parsed_program_phase_name(phase: ParsedProgramPhase) -> String:
	match phase:
		RawParsedProgram:
			"raw_parse"
		TypecheckSourceProgram:
			"typecheck_source"


pure func parsed_program_phase_from_name(name: String) -> Option[ParsedProgramPhase]:
	if name == "raw_parse":
		Some(RawParsedProgram)
	else if name == "typecheck_source":
		Some(TypecheckSourceProgram)
	else:
		None


record ParsedIdentifier {
	text: String,
	span: SourceLocation
}


enum ParsedDimBinaryOp:
	ParsedDimAddOp
	ParsedDimSubtractOp
	ParsedDimMultiplyOp
	ParsedDimDivideOp


union ParsedTypeExpr:
	ParsedNamedType(ParsedIdentifier, List[ParsedTypeExpr], SourceLocation)
	ParsedQualifiedNamedType(ParsedIdentifier, ParsedIdentifier, List[ParsedTypeExpr], SourceLocation)
	ParsedBoundedType(ParsedIdentifier, List[ParsedIdentifier], SourceLocation)
	ParsedDimNameType(ParsedIdentifier, Bool, SourceLocation)
	ParsedDimLiteralType(String, SourceLocation)
	ParsedDimBinaryType(ParsedDimBinaryOp, ParsedTypeExpr, ParsedTypeExpr, SourceLocation)
	ParsedRangeType(ParsedTypeExpr, SourceLocation)
	ParsedTupleType(List[ParsedTypeExpr], SourceLocation)
	ParsedFunctionType(Bool, List[ParsedTypeExpr], ParsedTypeExpr, SourceLocation)
	ParsedArrayType(ParsedTypeExpr, List[ParsedTypeExpr], SourceLocation)
	ParsedMissingType(SourceLocation)


record ParsedTypeParamDecl {
	name: ParsedIdentifier,
	bounds: List[ParsedIdentifier],
	span: SourceLocation
}


record ParsedDimConstraint {
	left: ParsedTypeExpr,
	right: ParsedTypeExpr,
	span: SourceLocation
}


union ParsedParamBinder:
	ParsedParamNameBinder(ParsedIdentifier)
	ParsedParamWildcardBinder(SourceLocation)
	ParsedParamTupleBinder(List[ParsedIdentifier], SourceLocation)


record ParsedParam {
	binder: ParsedParamBinder,
	type_expr: Option[ParsedTypeExpr],
	span: SourceLocation
}


record ParsedLambdaParam {
	name: ParsedIdentifier,
	type_expr: Option[ParsedTypeExpr],
	span: SourceLocation
}


enum ParsedBinaryOp:
	ParsedAddOp
	ParsedSubtractOp
	ParsedMultiplyOp
	ParsedDivideOp
	ParsedModuloOp
	ParsedEqualOp
	ParsedNotEqualOp
	ParsedLessOp
	ParsedLessEqualOp
	ParsedGreaterOp
	ParsedGreaterEqualOp


enum ParsedLogicalOp:
	ParsedAndOp
	ParsedOrOp


enum ParsedUnaryOp:
	ParsedNegateOp
	ParsedNotOp


enum ParsedCompoundAssignOp:
	ParsedAssignAddOp
	ParsedAssignSubtractOp
	ParsedAssignMultiplyOp
	ParsedAssignDivideOp


enum ParsedStringLiteralForm:
	ParsedPlainStringLiteral
	ParsedRawStringLiteral
	ParsedPipeStringLiteral
	ParsedRawPipeStringLiteral


enum ParsedFunctionAnnotation:
	ParsedTailRecursiveAnnotation
	ParsedNoCopyAnnotation
	ParsedDebugOnlyAnnotation
	ParsedResourceResultOrdinaryAnnotation


union ParsedListPatternSpread:
	ParsedListSpreadName(ParsedIdentifier)
	ParsedListSpreadWildcard(SourceLocation)


union ParsedPattern:
	ParsedWildcardPattern(SourceLocation)
	ParsedNamePattern(ParsedIdentifier)
	ParsedIntPattern(String, SourceLocation)
	ParsedFloatPattern(String, SourceLocation)
	ParsedStringPattern(String, ParsedStringLiteralForm, SourceLocation)
	ParsedCharPattern(Int, SourceLocation)
	ParsedBoolPattern(Bool, SourceLocation)
	ParsedConstructorPattern(ParsedIdentifier, List[ParsedPattern], SourceLocation)
	ParsedQualifiedConstructorPattern(ParsedIdentifier, ParsedIdentifier, List[ParsedPattern], SourceLocation)
	ParsedTuplePattern(List[ParsedPattern], SourceLocation)
	ParsedListPattern(List[ParsedPattern], Option[ParsedListPatternSpread], SourceLocation)
	ParsedOrPattern(List[ParsedPattern], SourceLocation)
	ParsedMissingPattern(SourceLocation)


record ParsedMatchCase {
	pattern: ParsedPattern,
	body: ParsedExpr,
	span: SourceLocation
}


union ParsedSelectArmKind:
	ParsedSelectReceiveArm(ParsedIdentifier, ParsedExpr)
	ParsedSelectSealedArm(ParsedExpr)
	ParsedSelectAfterArm(ParsedExpr)


record ParsedSelectArm {
	kind: ParsedSelectArmKind,
	body: ParsedExpr,
	span: SourceLocation
}


record ParsedRecordExprField {
	name: ParsedIdentifier,
	value: ParsedExpr,
	span: SourceLocation
}


record ParsedDictEntry {
	key: ParsedExpr,
	value: ParsedExpr,
	span: SourceLocation
}


record ParsedConcurrentParam {
	name: ParsedIdentifier,
	value: ParsedExpr,
	span: SourceLocation
}


enum ParsedWithBindingKind:
	ParsedWithPlainBinding
	ParsedWithTryBinding


record ParsedWithErrorMap {
	name: ParsedIdentifier,
	value: ParsedExpr,
	span: SourceLocation
}


record ParsedWithBinding {
	name: ParsedIdentifier,
	type_expr: Option[ParsedTypeExpr],
	value: ParsedExpr,
	kind: ParsedWithBindingKind,
	error_map: Option[ParsedWithErrorMap],
	span: SourceLocation
}


union ParsedForBinder:
	ParsedForNameBinder(ParsedIdentifier)
	ParsedForTupleBinder(List[ParsedIdentifier], SourceLocation)


union ParsedStringInterpolationPart:
	ParsedInterpolationLiteral(String)
	ParsedInterpolationExpr(ParsedExpr)


union ParsedExpr:
	ParsedNameExpr(ParsedIdentifier)
	ParsedIntLiteralExpr(String, SourceLocation)
	ParsedFloatLiteralExpr(String, SourceLocation)
	ParsedStringLiteralExpr(String, ParsedStringLiteralForm, SourceLocation)
	ParsedStringInterpolationExpr(String, Bool, SourceLocation)
	ParsedStringInterpolationPartsExpr(List[ParsedStringInterpolationPart], Bool, SourceLocation)
	ParsedBoolLiteralExpr(Bool, SourceLocation)
	ParsedCharLiteralExpr(Int, SourceLocation)
	ParsedUnaryExpr(ParsedUnaryOp, ParsedExpr, SourceLocation)
	ParsedBinaryExpr(ParsedBinaryOp, ParsedExpr, ParsedExpr, SourceLocation)
	ParsedLogicalExpr(ParsedLogicalOp, ParsedExpr, ParsedExpr, SourceLocation)
	ParsedAscriptionExpr(ParsedExpr, ParsedTypeExpr, SourceLocation)
	ParsedRangeExpr(ParsedExpr, ParsedExpr, SourceLocation)
	ParsedCallExpr(ParsedExpr, List[ParsedExpr], SourceLocation)
	ParsedFieldAccessExpr(ParsedExpr, ParsedIdentifier, SourceLocation)
	ParsedSubscriptExpr(ParsedExpr, List[ParsedExpr], SourceLocation)
	ParsedListExpr(List[ParsedExpr], SourceLocation)
	ParsedTupleExpr(List[ParsedExpr], SourceLocation)
	ParsedRecordExpr(List[ParsedRecordExprField], SourceLocation)
	ParsedRecordUpdateExpr(ParsedExpr, List[ParsedRecordExprField], SourceLocation)
	ParsedDictExpr(List[ParsedDictEntry], SourceLocation)
	ParsedVectorExpr(List[ParsedExpr], SourceLocation)
	ParsedOpaqueIntoExpr(ParsedTypeExpr, ParsedExpr, SourceLocation)
	ParsedOpaqueFromExpr(ParsedTypeExpr, ParsedExpr, SourceLocation)
	ParsedBlockExpr(List[ParsedExpr], SourceLocation)
	ParsedIfExpr(ParsedExpr, ParsedExpr, Option[ParsedExpr], SourceLocation)
	ParsedMatchExpr(ParsedExpr, List[ParsedMatchCase], SourceLocation)
	ParsedSelectExpr(List[ParsedSelectArm], SourceLocation)
	ParsedWithExpr(ParsedWithBinding, ParsedExpr, SourceLocation)
	ParsedDebugBlockExpr(ParsedExpr, SourceLocation)
	ParsedLambdaExpr(Bool, List[ParsedLambdaParam], Option[ParsedTypeExpr], ParsedExpr, SourceLocation)
	ParsedFunctionDeclExpr(ParsedFunctionDecl)
	ParsedWhileExpr(ParsedExpr, ParsedExpr, SourceLocation)
	ParsedForExpr(ParsedForBinder, ParsedExpr, ParsedExpr, SourceLocation)
	ParsedConcurrentBlockExpr(List[ParsedConcurrentParam], ParsedExpr, SourceLocation)
	ParsedConcurrentForExpr(ParsedIdentifier, ParsedExpr, List[ParsedConcurrentParam], ParsedExpr, SourceLocation)
	ParsedDetachExpr(ParsedExpr, SourceLocation)
	ParsedBreakExpr(SourceLocation)
	ParsedContinueExpr(SourceLocation)
	ParsedVoidExpr(SourceLocation)
	ParsedBuiltinExpr(Option[String], SourceLocation)
	ParsedVarDeclExpr(ParsedIdentifier, Option[ParsedTypeExpr], ParsedExpr, Bool, SourceLocation)
	ParsedAssignExpr(ParsedIdentifier, ParsedExpr, SourceLocation)
	ParsedCompoundAssignExpr(ParsedIdentifier, ParsedCompoundAssignOp, ParsedExpr, SourceLocation)
	ParsedSubscriptAssignExpr(ParsedExpr, List[ParsedExpr], ParsedExpr, SourceLocation)
	ParsedTupleDestructExpr(List[ParsedIdentifier], ParsedExpr, SourceLocation)
	ParsedQuestionBindExpr(ParsedIdentifier, Option[ParsedTypeExpr], ParsedExpr, SourceLocation)
	ParsedMissingExpr(SourceLocation)


union ParsedFunctionBodyKind:
	ParsedFunctionSourceBody
	ParsedFunctionBuiltinBody(Option[String])
	ParsedFunctionForwardDecl


record ParsedFunctionDecl {
	name: ParsedIdentifier,
	keyword_span: Option[SourceLocation],
	type_params: List[ParsedTypeParamDecl],
	params: List[ParsedParam],
	return_type: Option[ParsedTypeExpr],
	dim_constraints: List[ParsedDimConstraint],
	body: Option[ParsedExpr],
	is_pure: Bool,
	annotations: List[ParsedFunctionAnnotation],
	doc: Option[String],
	span: SourceLocation
}


pure func parsed_function_body_kind(body: Option[ParsedExpr]) -> ParsedFunctionBodyKind:
	match body:
		None:
			ParsedFunctionForwardDecl
		Some(ParsedBuiltinExpr(name, _)):
			ParsedFunctionBuiltinBody(name)
		Some(ParsedBlockExpr(items, _)):
			if items.length() != 1:
				ParsedFunctionSourceBody
			else:
				match items.get(0):
					Some(item):
						match parsed_function_body_kind(Some(item)):
							ParsedFunctionBuiltinBody(name):
								ParsedFunctionBuiltinBody(name)
							_:
								ParsedFunctionSourceBody
					None:
						ParsedFunctionSourceBody
		Some(_):
			ParsedFunctionSourceBody


pure func parsed_function_body_is_builtin(body: Option[ParsedExpr]) -> Bool:
	match parsed_function_body_kind(body):
		ParsedFunctionBuiltinBody(_):
			True
		_:
			False


record ParsedVarDecl {
	name: ParsedIdentifier,
	type_expr: Option[ParsedTypeExpr],
	value: ParsedExpr,
	is_mutable: Bool,
	span: SourceLocation
}


record ParsedImportSymbol {
	name: ParsedIdentifier,
	symbol_alias: Option[ParsedIdentifier],
	constructors: List[ParsedIdentifier],
	span: SourceLocation
}


record ParsedImportDecl {
	module_path: String,
	module_path_span: SourceLocation,
	module_alias: Option[ParsedIdentifier],
	symbols: Option[List[ParsedImportSymbol]],
	span: SourceLocation
}


record ParsedForeignBlockArg {
	name: ParsedIdentifier,
	value: String,
	span: SourceLocation
}


record ParsedForeignFunctionDecl {
	name: ParsedIdentifier,
	params: List[ParsedParam],
	return_type: ParsedTypeExpr,
	c_name: Option[String],
	is_pure: Bool,
	is_private: Bool,
	annotations: List[ParsedFunctionAnnotation],
	span: SourceLocation
}


record ParsedFieldDecl {
	name: ParsedIdentifier,
	type_expr: ParsedTypeExpr,
	span: SourceLocation
}


record ParsedRecordDecl {
	name: ParsedIdentifier,
	type_params: List[ParsedTypeParamDecl],
	fields: List[ParsedFieldDecl],
	is_struct: Bool,
	doc: Option[String],
	span: SourceLocation
}


record ParsedVariantDecl {
	name: ParsedIdentifier,
	fields: List[ParsedTypeExpr],
	span: SourceLocation
}


record ParsedUnionDecl {
	name: ParsedIdentifier,
	type_params: List[ParsedTypeParamDecl],
	variants: List[ParsedVariantDecl],
	is_enum: Bool,
	doc: Option[String],
	span: SourceLocation
}


record ParsedResourceCleanup {
	builtin_name: String,
	span: SourceLocation
}


record ParsedBuiltinTypeDecl {
	name: ParsedIdentifier,
	type_params: List[ParsedTypeParamDecl],
	is_resource: Bool,
	cleanup: Option[ParsedResourceCleanup],
	doc: Option[String],
	span: SourceLocation
}


record ParsedTypeAliasDecl {
	name: ParsedIdentifier,
	type_params: List[ParsedTypeParamDecl],
	target: ParsedTypeExpr,
	is_opaque: Bool,
	doc: Option[String],
	span: SourceLocation
}


record ParsedTraitMethodDecl {
	name: ParsedIdentifier,
	params: List[ParsedParam],
	return_type: Option[ParsedTypeExpr],
	body: Option[ParsedExpr],
	is_pure: Bool,
	span: SourceLocation
}


record ParsedTraitDecl {
	name: ParsedIdentifier,
	type_params: List[ParsedTypeParamDecl],
	supertraits: List[ParsedIdentifier],
	methods: List[ParsedTraitMethodDecl],
	doc: Option[String],
	span: SourceLocation
}


record ParsedImplDecl {
	trait_name: ParsedIdentifier,
	for_type: ParsedTypeExpr,
	methods: List[ParsedFunctionDecl],
	doc: Option[String],
	span: SourceLocation
}


union ParsedDecl:
	FunctionParsedDecl(ParsedFunctionDecl)
	VarParsedDecl(ParsedVarDecl)
	ImportBlockParsedDecl(List[ParsedImportDecl], SourceLocation)
	ForeignBlockParsedDecl(List[ParsedForeignBlockArg], List[ParsedForeignFunctionDecl], SourceLocation)
	RecordParsedDecl(ParsedRecordDecl)
	UnionParsedDecl(ParsedUnionDecl)
	BuiltinTypeParsedDecl(ParsedBuiltinTypeDecl)
	TypeAliasParsedDecl(ParsedTypeAliasDecl)
	TraitParsedDecl(ParsedTraitDecl)
	ImplParsedDecl(ParsedImplDecl)
	PrivateParsedDecl(ParsedDecl, SourceLocation)
	ParsedErrorDecl(SourceLocation)


record ParsedProgram {
	source: SourceFile,
	decls: List[ParsedDecl],
	diagnostics: List[ParseDiagnostic]
}


pure func parsed_identifier(text: String, span: SourceLocation) -> ParsedIdentifier:
	{
		text = text,
		span = span
	}


pure func parsed_program_has_errors(program: ParsedProgram) -> Bool:
	not program.diagnostics.is_empty()


pure func parsed_program_ok(program: ParsedProgram) -> Bool:
	not parsed_program_has_errors(program)


pure func parsed_decl_location(decl: ParsedDecl) -> SourceLocation:
	match decl:
		FunctionParsedDecl(function_decl):
			function_decl.span
		VarParsedDecl(var_decl):
			var_decl.span
		ImportBlockParsedDecl(_, span):
			span
		ForeignBlockParsedDecl(_, _, span):
			span
		RecordParsedDecl(record_decl):
			record_decl.span
		UnionParsedDecl(union_decl):
			union_decl.span
		BuiltinTypeParsedDecl(type_decl):
			type_decl.span
		TypeAliasParsedDecl(type_alias_decl):
			type_alias_decl.span
		TraitParsedDecl(trait_decl):
			trait_decl.span
		ImplParsedDecl(impl_decl):
			impl_decl.span
		PrivateParsedDecl(_, span):
			span
		ParsedErrorDecl(span):
			span


pure func parsed_decl_span(table: SourceTable, decl: ParsedDecl) -> SourceSpan:
	source_location_span(table, parsed_decl_location(decl))


pure func parsed_type_expr_location(type_expr: ParsedTypeExpr) -> SourceLocation:
	match type_expr:
		ParsedNamedType(_, _, span):
			span
		ParsedQualifiedNamedType(_, _, _, span):
			span
		ParsedBoundedType(_, _, span):
			span
		ParsedDimNameType(_, _, span):
			span
		ParsedDimLiteralType(_, span):
			span
		ParsedDimBinaryType(_, _, _, span):
			span
		ParsedRangeType(_, span):
			span
		ParsedTupleType(_, span):
			span
		ParsedFunctionType(_, _, _, span):
			span
		ParsedArrayType(_, _, span):
			span
		ParsedMissingType(span):
			span


pure func parsed_type_expr_span(table: SourceTable, type_expr: ParsedTypeExpr) -> SourceSpan:
	source_location_span(table, parsed_type_expr_location(type_expr))


pure func parsed_expr_location(expr: ParsedExpr) -> SourceLocation:
	match expr:
		ParsedNameExpr(identifier):
			identifier.span
		ParsedIntLiteralExpr(_, span):
			span
		ParsedFloatLiteralExpr(_, span):
			span
		ParsedStringLiteralExpr(_, _, span):
			span
		ParsedStringInterpolationExpr(_, _, span):
			span
		ParsedStringInterpolationPartsExpr(_, _, span):
			span
		ParsedBoolLiteralExpr(_, span):
			span
		ParsedCharLiteralExpr(_, span):
			span
		ParsedUnaryExpr(_, _, span):
			span
		ParsedBinaryExpr(_, _, _, span):
			span
		ParsedLogicalExpr(_, _, _, span):
			span
		ParsedAscriptionExpr(_, _, span):
			span
		ParsedRangeExpr(_, _, span):
			span
		ParsedCallExpr(_, _, span):
			span
		ParsedFieldAccessExpr(_, _, span):
			span
		ParsedSubscriptExpr(_, _, span):
			span
		ParsedListExpr(_, span):
			span
		ParsedTupleExpr(_, span):
			span
		ParsedRecordExpr(_, span):
			span
		ParsedRecordUpdateExpr(_, _, span):
			span
		ParsedDictExpr(_, span):
			span
		ParsedVectorExpr(_, span):
			span
		ParsedOpaqueIntoExpr(_, _, span):
			span
		ParsedOpaqueFromExpr(_, _, span):
			span
		ParsedBlockExpr(_, span):
			span
		ParsedIfExpr(_, _, _, span):
			span
		ParsedMatchExpr(_, _, span):
			span
		ParsedSelectExpr(_, span):
			span
		ParsedWithExpr(_, _, span):
			span
		ParsedDebugBlockExpr(_, span):
			span
		ParsedLambdaExpr(_, _, _, _, span):
			span
		ParsedFunctionDeclExpr(function_decl):
			function_decl.span
		ParsedWhileExpr(_, _, span):
			span
		ParsedForExpr(_, _, _, span):
			span
		ParsedConcurrentBlockExpr(_, _, span):
			span
		ParsedConcurrentForExpr(_, _, _, _, span):
			span
		ParsedDetachExpr(_, span):
			span
		ParsedBreakExpr(span):
			span
		ParsedContinueExpr(span):
			span
		ParsedVoidExpr(span):
			span
		ParsedBuiltinExpr(_, span):
			span
		ParsedVarDeclExpr(_, _, _, _, span):
			span
		ParsedAssignExpr(_, _, span):
			span
		ParsedCompoundAssignExpr(_, _, _, span):
			span
		ParsedSubscriptAssignExpr(_, _, _, span):
			span
		ParsedTupleDestructExpr(_, _, span):
			span
		ParsedQuestionBindExpr(_, _, _, span):
			span
		ParsedMissingExpr(span):
			span


pure func parsed_expr_span(table: SourceTable, expr: ParsedExpr) -> SourceSpan:
	source_location_span(table, parsed_expr_location(expr))


-- Rebuild `expr` with `span` as its source extent. Grouping parentheses have
-- no AST node, so the parser widens the enclosed expression to the delimiters;
-- consumers that reason about source extent (formatter statement spacing,
-- comment attachment) then see the closing parenthesis line. Identifier and
-- nested declaration nodes keep their token-exact spans because rename and
-- reference tooling edits those tokens by span.
pure func parsed_expr_with_location(expr: ParsedExpr, span: SourceLocation) -> ParsedExpr:
	match expr:
		ParsedNameExpr(_):
			expr
		ParsedIntLiteralExpr(value, _):
			ParsedIntLiteralExpr(value, span)
		ParsedFloatLiteralExpr(value, _):
			ParsedFloatLiteralExpr(value, span)
		ParsedStringLiteralExpr(value, form, _):
			ParsedStringLiteralExpr(value, form, span)
		ParsedStringInterpolationExpr(value, is_multiline, _):
			ParsedStringInterpolationExpr(value, is_multiline, span)
		ParsedStringInterpolationPartsExpr(parts, is_multiline, _):
			ParsedStringInterpolationPartsExpr(parts, is_multiline, span)
		ParsedBoolLiteralExpr(value, _):
			ParsedBoolLiteralExpr(value, span)
		ParsedCharLiteralExpr(value, _):
			ParsedCharLiteralExpr(value, span)
		ParsedUnaryExpr(op, operand, _):
			ParsedUnaryExpr(op, operand, span)
		ParsedBinaryExpr(op, left, right, _):
			ParsedBinaryExpr(op, left, right, span)
		ParsedLogicalExpr(op, left, right, _):
			ParsedLogicalExpr(op, left, right, span)
		ParsedAscriptionExpr(inner, type_expr, _):
			ParsedAscriptionExpr(inner, type_expr, span)
		ParsedRangeExpr(start, finish, _):
			ParsedRangeExpr(start, finish, span)
		ParsedCallExpr(callee, args, _):
			ParsedCallExpr(callee, args, span)
		ParsedFieldAccessExpr(target, field_name, _):
			ParsedFieldAccessExpr(target, field_name, span)
		ParsedSubscriptExpr(target, indices, _):
			ParsedSubscriptExpr(target, indices, span)
		ParsedListExpr(items, _):
			ParsedListExpr(items, span)
		ParsedTupleExpr(items, _):
			ParsedTupleExpr(items, span)
		ParsedRecordExpr(fields, _):
			ParsedRecordExpr(fields, span)
		ParsedRecordUpdateExpr(base, fields, _):
			ParsedRecordUpdateExpr(base, fields, span)
		ParsedDictExpr(entries, _):
			ParsedDictExpr(entries, span)
		ParsedVectorExpr(items, _):
			ParsedVectorExpr(items, span)
		ParsedOpaqueIntoExpr(type_expr, inner, _):
			ParsedOpaqueIntoExpr(type_expr, inner, span)
		ParsedOpaqueFromExpr(type_expr, inner, _):
			ParsedOpaqueFromExpr(type_expr, inner, span)
		ParsedBlockExpr(items, _):
			ParsedBlockExpr(items, span)
		ParsedIfExpr(condition, then_branch, else_branch, _):
			ParsedIfExpr(condition, then_branch, else_branch, span)
		ParsedMatchExpr(scrutinee, cases, _):
			ParsedMatchExpr(scrutinee, cases, span)
		ParsedSelectExpr(arms, _):
			ParsedSelectExpr(arms, span)
		ParsedWithExpr(binding, body, _):
			ParsedWithExpr(binding, body, span)
		ParsedDebugBlockExpr(body, _):
			ParsedDebugBlockExpr(body, span)
		ParsedLambdaExpr(is_pure, params, return_type, body, _):
			ParsedLambdaExpr(is_pure, params, return_type, body, span)
		ParsedFunctionDeclExpr(_):
			expr
		ParsedWhileExpr(condition, body, _):
			ParsedWhileExpr(condition, body, span)
		ParsedForExpr(binder, iterable, body, _):
			ParsedForExpr(binder, iterable, body, span)
		ParsedConcurrentBlockExpr(params, body, _):
			ParsedConcurrentBlockExpr(params, body, span)
		ParsedConcurrentForExpr(name, iterable, params, body, _):
			ParsedConcurrentForExpr(name, iterable, params, body, span)
		ParsedDetachExpr(inner, _):
			ParsedDetachExpr(inner, span)
		ParsedBreakExpr(_):
			ParsedBreakExpr(span)
		ParsedContinueExpr(_):
			ParsedContinueExpr(span)
		ParsedVoidExpr(_):
			ParsedVoidExpr(span)
		ParsedBuiltinExpr(name, _):
			ParsedBuiltinExpr(name, span)
		ParsedVarDeclExpr(name, type_expr, value, is_mutable, _):
			ParsedVarDeclExpr(name, type_expr, value, is_mutable, span)
		ParsedAssignExpr(name, value, _):
			ParsedAssignExpr(name, value, span)
		ParsedCompoundAssignExpr(name, op, value, _):
			ParsedCompoundAssignExpr(name, op, value, span)
		ParsedSubscriptAssignExpr(target, indices, value, _):
			ParsedSubscriptAssignExpr(target, indices, value, span)
		ParsedTupleDestructExpr(names, value, _):
			ParsedTupleDestructExpr(names, value, span)
		ParsedQuestionBindExpr(name, type_expr, value, _):
			ParsedQuestionBindExpr(name, type_expr, value, span)
		ParsedMissingExpr(_):
			ParsedMissingExpr(span)


pure func parsed_param_binder_location(binder: ParsedParamBinder) -> SourceLocation:
	match binder:
		ParsedParamNameBinder(identifier):
			identifier.span
		ParsedParamWildcardBinder(span):
			span
		ParsedParamTupleBinder(_, span):
			span


pure func parsed_param_binder_span(table: SourceTable, binder: ParsedParamBinder) -> SourceSpan:
	source_location_span(table, parsed_param_binder_location(binder))


pure func parsed_pattern_location(pattern: ParsedPattern) -> SourceLocation:
	match pattern:
		ParsedWildcardPattern(span):
			span
		ParsedNamePattern(identifier):
			identifier.span
		ParsedIntPattern(_, span):
			span
		ParsedFloatPattern(_, span):
			span
		ParsedStringPattern(_, _, span):
			span
		ParsedCharPattern(_, span):
			span
		ParsedBoolPattern(_, span):
			span
		ParsedConstructorPattern(_, _, span):
			span
		ParsedQualifiedConstructorPattern(_, _, _, span):
			span
		ParsedTuplePattern(_, span):
			span
		ParsedListPattern(_, _, span):
			span
		ParsedOrPattern(_, span):
			span
		ParsedMissingPattern(span):
			span


pure func parsed_pattern_span(table: SourceTable, pattern: ParsedPattern) -> SourceSpan:
	source_location_span(table, parsed_pattern_location(pattern))
