import:
	../../lib/source: SourceFile, SourceSpan
	../stage_02_lex/parse_diagnostic: ParseDiagnostic, parse_diagnostic_is_error


enum ParsedProgramPhase:
	RawParsedProgram
	TypecheckSourceProgram


pure func parsed_program_phase_name(phase: ParsedProgramPhase) -> String:
	match phase:
		RawParsedProgram:
			"raw_parse"
		TypecheckSourceProgram:
			"typecheck_source"


pure func parsed_program_phase_from_name(name: String) -> Option[ParsedProgramPhase]:
	if name == "raw_parse":
		Some(RawParsedProgram)
	else if name == "typecheck_source":
		Some(TypecheckSourceProgram)
	else:
		None


record ParsedIdentifier {
	text: String,
	span: SourceSpan
}


enum ParsedDimBinaryOp:
	ParsedDimAddOp
	ParsedDimSubtractOp
	ParsedDimMultiplyOp
	ParsedDimDivideOp


union ParsedTypeExpr:
	ParsedNamedType(ParsedIdentifier, List[ParsedTypeExpr], SourceSpan)
	ParsedQualifiedNamedType(ParsedIdentifier, ParsedIdentifier, List[ParsedTypeExpr], SourceSpan)
	ParsedBoundedType(ParsedIdentifier, List[ParsedIdentifier], SourceSpan)
	ParsedDimNameType(ParsedIdentifier, Bool, SourceSpan)
	ParsedDimLiteralType(String, SourceSpan)
	ParsedDimBinaryType(ParsedDimBinaryOp, ParsedTypeExpr, ParsedTypeExpr, SourceSpan)
	ParsedRangeType(ParsedTypeExpr, SourceSpan)
	ParsedTupleType(List[ParsedTypeExpr], SourceSpan)
	ParsedFunctionType(Bool, List[ParsedTypeExpr], ParsedTypeExpr, SourceSpan)
	ParsedArrayType(ParsedTypeExpr, List[ParsedTypeExpr], SourceSpan)
	ParsedMissingType(SourceSpan)


record ParsedTypeParamDecl {
	name: ParsedIdentifier,
	bounds: List[ParsedIdentifier],
	span: SourceSpan
}


record ParsedDimConstraint {
	left: ParsedTypeExpr,
	right: ParsedTypeExpr,
	span: SourceSpan
}


union ParsedParamBinder:
	ParsedParamNameBinder(ParsedIdentifier)
	ParsedParamWildcardBinder(SourceSpan)
	ParsedParamTupleBinder(List[ParsedIdentifier], SourceSpan)


record ParsedParam {
	binder: ParsedParamBinder,
	type_expr: Option[ParsedTypeExpr],
	span: SourceSpan
}


record ParsedLambdaParam {
	name: ParsedIdentifier,
	type_expr: Option[ParsedTypeExpr],
	span: SourceSpan
}


enum ParsedBinaryOp:
	ParsedAddOp
	ParsedSubtractOp
	ParsedMultiplyOp
	ParsedDivideOp
	ParsedModuloOp
	ParsedEqualOp
	ParsedNotEqualOp
	ParsedLessOp
	ParsedLessEqualOp
	ParsedGreaterOp
	ParsedGreaterEqualOp


enum ParsedLogicalOp:
	ParsedAndOp
	ParsedOrOp


enum ParsedUnaryOp:
	ParsedNegateOp
	ParsedNotOp


enum ParsedCompoundAssignOp:
	ParsedAssignAddOp
	ParsedAssignSubtractOp
	ParsedAssignMultiplyOp
	ParsedAssignDivideOp


enum ParsedStringLiteralForm:
	ParsedPlainStringLiteral
	ParsedRawStringLiteral
	ParsedPipeStringLiteral
	ParsedRawPipeStringLiteral


enum ParsedFunctionAnnotation:
	ParsedTailRecursiveAnnotation
	ParsedNoCopyAnnotation
	ParsedDebugOnlyAnnotation
	ParsedResourceResultOrdinaryAnnotation


union ParsedListPatternSpread:
	ParsedListSpreadName(ParsedIdentifier)
	ParsedListSpreadWildcard(SourceSpan)


union ParsedPattern:
	ParsedWildcardPattern(SourceSpan)
	ParsedNamePattern(ParsedIdentifier)
	ParsedIntPattern(String, SourceSpan)
	ParsedFloatPattern(String, SourceSpan)
	ParsedStringPattern(String, ParsedStringLiteralForm, SourceSpan)
	ParsedCharPattern(Int, SourceSpan)
	ParsedBoolPattern(Bool, SourceSpan)
	ParsedConstructorPattern(ParsedIdentifier, List[ParsedPattern], SourceSpan)
	ParsedQualifiedConstructorPattern(ParsedIdentifier, ParsedIdentifier, List[ParsedPattern], SourceSpan)
	ParsedTuplePattern(List[ParsedPattern], SourceSpan)
	ParsedListPattern(List[ParsedPattern], Option[ParsedListPatternSpread], SourceSpan)
	ParsedOrPattern(List[ParsedPattern], SourceSpan)
	ParsedMissingPattern(SourceSpan)


record ParsedMatchCase {
	pattern: ParsedPattern,
	body: ParsedExpr,
	span: SourceSpan
}


union ParsedSelectArmKind:
	ParsedSelectReceiveArm(ParsedIdentifier, ParsedExpr)
	ParsedSelectSealedArm(ParsedExpr)
	ParsedSelectAfterArm(ParsedExpr)


record ParsedSelectArm {
	kind: ParsedSelectArmKind,
	body: ParsedExpr,
	span: SourceSpan
}


record ParsedRecordExprField {
	name: ParsedIdentifier,
	value: ParsedExpr,
	span: SourceSpan
}


record ParsedDictEntry {
	key: ParsedExpr,
	value: ParsedExpr,
	span: SourceSpan
}


record ParsedConcurrentParam {
	name: ParsedIdentifier,
	value: ParsedExpr,
	span: SourceSpan
}


enum ParsedWithBindingKind:
	ParsedWithPlainBinding
	ParsedWithTryBinding


record ParsedWithErrorMap {
	name: ParsedIdentifier,
	value: ParsedExpr,
	span: SourceSpan
}


record ParsedWithBinding {
	name: ParsedIdentifier,
	type_expr: Option[ParsedTypeExpr],
	value: ParsedExpr,
	kind: ParsedWithBindingKind,
	error_map: Option[ParsedWithErrorMap],
	span: SourceSpan
}


union ParsedForBinder:
	ParsedForNameBinder(ParsedIdentifier)
	ParsedForTupleBinder(List[ParsedIdentifier], SourceSpan)


union ParsedStringInterpolationPart:
	ParsedInterpolationLiteral(String)
	ParsedInterpolationExpr(ParsedExpr)


union ParsedExpr:
	ParsedNameExpr(ParsedIdentifier)
	ParsedIntLiteralExpr(String, SourceSpan)
	ParsedFloatLiteralExpr(String, SourceSpan)
	ParsedStringLiteralExpr(String, ParsedStringLiteralForm, SourceSpan)
	ParsedStringInterpolationExpr(String, Bool, SourceSpan)
	ParsedStringInterpolationPartsExpr(List[ParsedStringInterpolationPart], Bool, SourceSpan)
	ParsedBoolLiteralExpr(Bool, SourceSpan)
	ParsedCharLiteralExpr(Int, SourceSpan)
	ParsedUnaryExpr(ParsedUnaryOp, ParsedExpr, SourceSpan)
	ParsedBinaryExpr(ParsedBinaryOp, ParsedExpr, ParsedExpr, SourceSpan)
	ParsedLogicalExpr(ParsedLogicalOp, ParsedExpr, ParsedExpr, SourceSpan)
	ParsedAscriptionExpr(ParsedExpr, ParsedTypeExpr, SourceSpan)
	ParsedRangeExpr(ParsedExpr, ParsedExpr, SourceSpan)
	ParsedCallExpr(ParsedExpr, List[ParsedExpr], SourceSpan)
	ParsedFieldAccessExpr(ParsedExpr, ParsedIdentifier, SourceSpan)
	ParsedSubscriptExpr(ParsedExpr, List[ParsedExpr], SourceSpan)
	ParsedListExpr(List[ParsedExpr], SourceSpan)
	ParsedTupleExpr(List[ParsedExpr], SourceSpan)
	ParsedRecordExpr(List[ParsedRecordExprField], SourceSpan)
	ParsedRecordUpdateExpr(ParsedExpr, List[ParsedRecordExprField], SourceSpan)
	ParsedDictExpr(List[ParsedDictEntry], SourceSpan)
	ParsedVectorExpr(List[ParsedExpr], SourceSpan)
	ParsedOpaqueIntoExpr(ParsedTypeExpr, ParsedExpr, SourceSpan)
	ParsedOpaqueFromExpr(ParsedTypeExpr, ParsedExpr, SourceSpan)
	ParsedBlockExpr(List[ParsedExpr], SourceSpan)
	ParsedIfExpr(ParsedExpr, ParsedExpr, Option[ParsedExpr], SourceSpan)
	ParsedMatchExpr(ParsedExpr, List[ParsedMatchCase], SourceSpan)
	ParsedSelectExpr(List[ParsedSelectArm], SourceSpan)
	ParsedWithExpr(ParsedWithBinding, ParsedExpr, SourceSpan)
	ParsedDebugBlockExpr(ParsedExpr, SourceSpan)
	ParsedLambdaExpr(Bool, List[ParsedLambdaParam], Option[ParsedTypeExpr], ParsedExpr, SourceSpan)
	ParsedFunctionDeclExpr(ParsedFunctionDecl)
	ParsedWhileExpr(ParsedExpr, ParsedExpr, SourceSpan)
	ParsedForExpr(ParsedForBinder, ParsedExpr, ParsedExpr, SourceSpan)
	ParsedConcurrentBlockExpr(List[ParsedConcurrentParam], ParsedExpr, SourceSpan)
	ParsedConcurrentForExpr(ParsedIdentifier, ParsedExpr, List[ParsedConcurrentParam], ParsedExpr, SourceSpan)
	ParsedDetachExpr(ParsedExpr, SourceSpan)
	ParsedBreakExpr(SourceSpan)
	ParsedContinueExpr(SourceSpan)
	ParsedVoidExpr(SourceSpan)
	ParsedBuiltinExpr(Option[String], SourceSpan)
	ParsedVarDeclExpr(ParsedIdentifier, Option[ParsedTypeExpr], ParsedExpr, Bool, SourceSpan)
	ParsedAssignExpr(ParsedIdentifier, ParsedExpr, SourceSpan)
	ParsedCompoundAssignExpr(ParsedIdentifier, ParsedCompoundAssignOp, ParsedExpr, SourceSpan)
	ParsedSubscriptAssignExpr(ParsedExpr, List[ParsedExpr], ParsedExpr, SourceSpan)
	ParsedTupleDestructExpr(List[ParsedIdentifier], ParsedExpr, SourceSpan)
	ParsedQuestionBindExpr(ParsedIdentifier, Option[ParsedTypeExpr], ParsedExpr, SourceSpan)
	ParsedMissingExpr(SourceSpan)


union ParsedFunctionBodyKind:
	ParsedFunctionSourceBody
	ParsedFunctionBuiltinBody(Option[String])
	ParsedFunctionForwardDecl


record ParsedFunctionDecl {
	name: ParsedIdentifier,
	keyword_span: Option[SourceSpan],
	type_params: List[ParsedTypeParamDecl],
	params: List[ParsedParam],
	return_type: Option[ParsedTypeExpr],
	dim_constraints: List[ParsedDimConstraint],
	body: Option[ParsedExpr],
	is_pure: Bool,
	annotations: List[ParsedFunctionAnnotation],
	doc: Option[String],
	span: SourceSpan
}


pure func parsed_function_body_kind(body: Option[ParsedExpr]) -> ParsedFunctionBodyKind:
	match body:
		None:
			ParsedFunctionForwardDecl
		Some(ParsedBuiltinExpr(name, _)):
			ParsedFunctionBuiltinBody(name)
		Some(ParsedBlockExpr(items, _)):
			if items.length() != 1:
				ParsedFunctionSourceBody
			else:
				match items.get(0):
					Some(item):
						match parsed_function_body_kind(Some(item)):
							ParsedFunctionBuiltinBody(name):
								ParsedFunctionBuiltinBody(name)
							_:
								ParsedFunctionSourceBody
					None:
						ParsedFunctionSourceBody
		Some(_):
			ParsedFunctionSourceBody


pure func parsed_function_body_is_builtin(body: Option[ParsedExpr]) -> Bool:
	match parsed_function_body_kind(body):
		ParsedFunctionBuiltinBody(_):
			True
		_:
			False


record ParsedVarDecl {
	name: ParsedIdentifier,
	type_expr: Option[ParsedTypeExpr],
	value: ParsedExpr,
	is_mutable: Bool,
	span: SourceSpan
}


record ParsedImportSymbol {
	name: ParsedIdentifier,
	symbol_alias: Option[ParsedIdentifier],
	constructors: List[ParsedIdentifier],
	span: SourceSpan
}


record ParsedImportDecl {
	module_path: String,
	module_path_span: SourceSpan,
	module_alias: Option[ParsedIdentifier],
	symbols: Option[List[ParsedImportSymbol]],
	span: SourceSpan
}


record ParsedForeignBlockArg {
	name: ParsedIdentifier,
	value: String,
	span: SourceSpan
}


record ParsedForeignFunctionDecl {
	name: ParsedIdentifier,
	params: List[ParsedParam],
	return_type: ParsedTypeExpr,
	c_name: Option[String],
	is_pure: Bool,
	is_private: Bool,
	annotations: List[ParsedFunctionAnnotation],
	span: SourceSpan
}


record ParsedFieldDecl {
	name: ParsedIdentifier,
	type_expr: ParsedTypeExpr,
	span: SourceSpan
}


record ParsedRecordDecl {
	name: ParsedIdentifier,
	type_params: List[ParsedTypeParamDecl],
	fields: List[ParsedFieldDecl],
	is_struct: Bool,
	doc: Option[String],
	span: SourceSpan
}


record ParsedVariantDecl {
	name: ParsedIdentifier,
	fields: List[ParsedTypeExpr],
	span: SourceSpan
}


record ParsedUnionDecl {
	name: ParsedIdentifier,
	type_params: List[ParsedTypeParamDecl],
	variants: List[ParsedVariantDecl],
	is_enum: Bool,
	doc: Option[String],
	span: SourceSpan
}


record ParsedResourceCleanup {
	builtin_name: String,
	span: SourceSpan
}


record ParsedBuiltinTypeDecl {
	name: ParsedIdentifier,
	type_params: List[ParsedTypeParamDecl],
	is_resource: Bool,
	cleanup: Option[ParsedResourceCleanup],
	doc: Option[String],
	span: SourceSpan
}


record ParsedTypeAliasDecl {
	name: ParsedIdentifier,
	type_params: List[ParsedTypeParamDecl],
	target: ParsedTypeExpr,
	is_opaque: Bool,
	doc: Option[String],
	span: SourceSpan
}


record ParsedTraitMethodDecl {
	name: ParsedIdentifier,
	params: List[ParsedParam],
	return_type: Option[ParsedTypeExpr],
	body: Option[ParsedExpr],
	is_pure: Bool,
	span: SourceSpan
}


record ParsedTraitDecl {
	name: ParsedIdentifier,
	type_params: List[ParsedTypeParamDecl],
	supertraits: List[ParsedIdentifier],
	methods: List[ParsedTraitMethodDecl],
	doc: Option[String],
	span: SourceSpan
}


record ParsedImplDecl {
	trait_name: ParsedIdentifier,
	for_type: ParsedTypeExpr,
	methods: List[ParsedFunctionDecl],
	doc: Option[String],
	span: SourceSpan
}


union ParsedDecl:
	FunctionParsedDecl(ParsedFunctionDecl)
	VarParsedDecl(ParsedVarDecl)
	ImportBlockParsedDecl(List[ParsedImportDecl], SourceSpan)
	ForeignBlockParsedDecl(List[ParsedForeignBlockArg], List[ParsedForeignFunctionDecl], SourceSpan)
	RecordParsedDecl(ParsedRecordDecl)
	UnionParsedDecl(ParsedUnionDecl)
	BuiltinTypeParsedDecl(ParsedBuiltinTypeDecl)
	TypeAliasParsedDecl(ParsedTypeAliasDecl)
	TraitParsedDecl(ParsedTraitDecl)
	ImplParsedDecl(ParsedImplDecl)
	PrivateParsedDecl(ParsedDecl, SourceSpan)
	ParsedErrorDecl(SourceSpan)


record ParsedProgram {
	source: SourceFile,
	decls: List[ParsedDecl],
	diagnostics: List[ParseDiagnostic]
}


pure func parsed_identifier(text: String, span: SourceSpan) -> ParsedIdentifier:
	{
		text = text,
		span = span
	}


pure func parsed_program_has_errors(program: ParsedProgram) -> Bool:
	var has_error: Bool = False

	for diagnostic in program.diagnostics:
		if parse_diagnostic_is_error(diagnostic):
			has_error = True
			break

	has_error


pure func parsed_program_ok(program: ParsedProgram) -> Bool:
	not parsed_program_has_errors(program)


pure func parsed_decl_span(decl: ParsedDecl) -> SourceSpan:
	match decl:
		FunctionParsedDecl(function_decl):
			function_decl.span
		VarParsedDecl(var_decl):
			var_decl.span
		ImportBlockParsedDecl(_, span):
			span
		ForeignBlockParsedDecl(_, _, span):
			span
		RecordParsedDecl(record_decl):
			record_decl.span
		UnionParsedDecl(union_decl):
			union_decl.span
		BuiltinTypeParsedDecl(type_decl):
			type_decl.span
		TypeAliasParsedDecl(type_alias_decl):
			type_alias_decl.span
		TraitParsedDecl(trait_decl):
			trait_decl.span
		ImplParsedDecl(impl_decl):
			impl_decl.span
		PrivateParsedDecl(_, span):
			span
		ParsedErrorDecl(span):
			span


pure func parsed_type_expr_span(type_expr: ParsedTypeExpr) -> SourceSpan:
	match type_expr:
		ParsedNamedType(_, _, span):
			span
		ParsedQualifiedNamedType(_, _, _, span):
			span
		ParsedBoundedType(_, _, span):
			span
		ParsedDimNameType(_, _, span):
			span
		ParsedDimLiteralType(_, span):
			span
		ParsedDimBinaryType(_, _, _, span):
			span
		ParsedRangeType(_, span):
			span
		ParsedTupleType(_, span):
			span
		ParsedFunctionType(_, _, _, span):
			span
		ParsedArrayType(_, _, span):
			span
		ParsedMissingType(span):
			span


pure func parsed_expr_span(expr: ParsedExpr) -> SourceSpan:
	match expr:
		ParsedNameExpr(identifier):
			identifier.span
		ParsedIntLiteralExpr(_, span):
			span
		ParsedFloatLiteralExpr(_, span):
			span
		ParsedStringLiteralExpr(_, _, span):
			span
		ParsedStringInterpolationExpr(_, _, span):
			span
		ParsedStringInterpolationPartsExpr(_, _, span):
			span
		ParsedBoolLiteralExpr(_, span):
			span
		ParsedCharLiteralExpr(_, span):
			span
		ParsedUnaryExpr(_, _, span):
			span
		ParsedBinaryExpr(_, _, _, span):
			span
		ParsedLogicalExpr(_, _, _, span):
			span
		ParsedAscriptionExpr(_, _, span):
			span
		ParsedRangeExpr(_, _, span):
			span
		ParsedCallExpr(_, _, span):
			span
		ParsedFieldAccessExpr(_, _, span):
			span
		ParsedSubscriptExpr(_, _, span):
			span
		ParsedListExpr(_, span):
			span
		ParsedTupleExpr(_, span):
			span
		ParsedRecordExpr(_, span):
			span
		ParsedRecordUpdateExpr(_, _, span):
			span
		ParsedDictExpr(_, span):
			span
		ParsedVectorExpr(_, span):
			span
		ParsedOpaqueIntoExpr(_, _, span):
			span
		ParsedOpaqueFromExpr(_, _, span):
			span
		ParsedBlockExpr(_, span):
			span
		ParsedIfExpr(_, _, _, span):
			span
		ParsedMatchExpr(_, _, span):
			span
		ParsedSelectExpr(_, span):
			span
		ParsedWithExpr(_, _, span):
			span
		ParsedDebugBlockExpr(_, span):
			span
		ParsedLambdaExpr(_, _, _, _, span):
			span
		ParsedFunctionDeclExpr(function_decl):
			function_decl.span
		ParsedWhileExpr(_, _, span):
			span
		ParsedForExpr(_, _, _, span):
			span
		ParsedConcurrentBlockExpr(_, _, span):
			span
		ParsedConcurrentForExpr(_, _, _, _, span):
			span
		ParsedDetachExpr(_, span):
			span
		ParsedBreakExpr(span):
			span
		ParsedContinueExpr(span):
			span
		ParsedVoidExpr(span):
			span
		ParsedBuiltinExpr(_, span):
			span
		ParsedVarDeclExpr(_, _, _, _, span):
			span
		ParsedAssignExpr(_, _, span):
			span
		ParsedCompoundAssignExpr(_, _, _, span):
			span
		ParsedSubscriptAssignExpr(_, _, _, span):
			span
		ParsedTupleDestructExpr(_, _, span):
			span
		ParsedQuestionBindExpr(_, _, _, span):
			span
		ParsedMissingExpr(span):
			span


pure func parsed_param_binder_span(binder: ParsedParamBinder) -> SourceSpan:
	match binder:
		ParsedParamNameBinder(identifier):
			identifier.span
		ParsedParamWildcardBinder(span):
			span
		ParsedParamTupleBinder(_, span):
			span


pure func parsed_pattern_span(pattern: ParsedPattern) -> SourceSpan:
	match pattern:
		ParsedWildcardPattern(span):
			span
		ParsedNamePattern(identifier):
			identifier.span
		ParsedIntPattern(_, span):
			span
		ParsedFloatPattern(_, span):
			span
		ParsedStringPattern(_, _, span):
			span
		ParsedCharPattern(_, span):
			span
		ParsedBoolPattern(_, span):
			span
		ParsedConstructorPattern(_, _, span):
			span
		ParsedQualifiedConstructorPattern(_, _, _, span):
			span
		ParsedTuplePattern(_, span):
			span
		ParsedListPattern(_, _, span):
			span
		ParsedOrPattern(_, span):
			span
		ParsedMissingPattern(span):
			span
