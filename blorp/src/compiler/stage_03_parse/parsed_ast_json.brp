-- JSON projection for the Blorp-owned parsed AST.
--
-- Explicit benchmark and diagnostic protocols use this shape. Normal compiler
-- phases exchange ParsedProgram values directly.
import:
	../../lib/source:
		SourceFile,
		SourceLocation,
		SourceSpan,
		SourceTable,
		source_location_span,
		source_table_for_file,
	../stage_02_lex/name_table:
		IdentifierSpellings(SpellingsFromIdentifierText),
		identifier_spelling,
	../stage_02_lex/parse_diagnostic: ParseDiagnostic
	json: JsonValue(JsonBool, JsonNull, JsonNumber, JsonObject, JsonString, JsonVector)
	parsed_ast:
		RecordDeclarationForm(OrdinaryRecord, LegacyStruct, FixedRecord),
		ConcurrentForLimit(MissingLimit, WrittenLimit),
		ConcurrentThreadLimit(DefaultThreadLimit, ThreadLimit),
		ParsedBinaryOp(
			ParsedAddOp, ParsedDivideOp, ParsedEqualOp, ParsedGreaterEqualOp, ParsedGreaterOp,
			ParsedLessEqualOp, ParsedLessOp, ParsedModuloOp, ParsedMultiplyOp, ParsedNotEqualOp,
			ParsedSubtractOp,
		),
		ParsedBuiltinTypeDecl,
		ParsedCompoundAssignOp(
			ParsedAssignAddOp, ParsedAssignDivideOp, ParsedAssignMultiplyOp, ParsedAssignSubtractOp,
		),
		ParsedConcurrentBlockOptions,
		ParsedConcurrentForOptions,
		ParsedDecl(
			BuiltinTypeParsedDecl, ForeignBlockParsedDecl, FunctionParsedDecl, ImplParsedDecl,
			ImportBlockParsedDecl, ParsedErrorDecl, PrivateParsedDecl, RecordParsedDecl,
			TraitParsedDecl, TypeAliasParsedDecl, UnionParsedDecl, VarParsedDecl,
		),
		ParsedDictEntry,
		ParsedDimBinaryOp(
			ParsedDimAddOp, ParsedDimDivideOp, ParsedDimMultiplyOp, ParsedDimSubtractOp,
		),
		ParsedDimConstraint,
		ParsedExpr(
			ParsedAssignExpr, ParsedBinaryExpr, ParsedBlockExpr, ParsedBoolLiteralExpr,
			ParsedBreakExpr, ParsedBuiltinExpr, ParsedCallExpr, ParsedCharLiteralExpr,
			ParsedCompoundAssignExpr, ParsedConcurrentBlockExpr, ParsedConcurrentForExpr,
			ParsedContinueExpr, ParsedDebugBlockExpr, ParsedDetachExpr, ParsedDictExpr,
			ParsedFieldAccessExpr, ParsedFloatLiteralExpr, ParsedForExpr, ParsedFunctionDeclExpr,
			ParsedIfExpr, ParsedIntLiteralExpr, ParsedLambdaExpr, ParsedListExpr, ParsedLogicalExpr,
			ParsedMatchExpr, ParsedMissingExpr, ParsedNameExpr, ParsedOpaqueFromExpr,
			ParsedOpaqueIntoExpr, ParsedQuestionBindExpr, ParsedRangeExpr, ParsedRecordExpr,
			ParsedRecordUpdateExpr, ParsedSelectExpr, ParsedStringInterpolationExpr,
			ParsedStringInterpolationPartsExpr, ParsedStringLiteralExpr, ParsedSubscriptAssignExpr,
			ParsedSubscriptExpr, ParsedTupleExpr, ParsedTupleDestructExpr, ParsedUnaryExpr,
			ParsedVarDeclExpr, ParsedVectorExpr, ParsedVoidExpr, ParsedWhileExpr, ParsedWithExpr,
		),
		ParsedFieldDecl,
		ParsedForBinder(ParsedForNameBinder, ParsedForTupleBinder),
		ParsedForeignBlockArg,
		ParsedForeignFunctionDecl,
		ParsedFunctionAnnotation(
			ParsedDebugOnlyAnnotation, ParsedNoCopyAnnotation,
			ParsedResourceResultOrdinaryAnnotation, ParsedTailRecursiveAnnotation,
		),
		ParsedFunctionDecl,
		ParsedIdentifier,
		ParsedImplDecl,
		ParsedImportDecl,
		ParsedImportSymbol,
		ParsedLambdaParam,
		ParsedListPatternSpread(ParsedListSpreadName, ParsedListSpreadWildcard),
		ParsedLogicalOp(ParsedAndOp, ParsedOrOp),
		ParsedMatchCase,
		ParsedModuleDoc,
		ParsedParam,
		ParsedParamBinder(ParsedParamNameBinder, ParsedParamTupleBinder, ParsedParamWildcardBinder),
		ParsedPattern(
			ParsedBoolPattern, ParsedCharPattern, ParsedConstructorPattern, ParsedFloatPattern,
			ParsedIntPattern, ParsedListPattern, ParsedMissingPattern, ParsedNamePattern,
			ParsedOrPattern, ParsedQualifiedConstructorPattern, ParsedStringPattern,
			ParsedTuplePattern, ParsedWildcardPattern,
		),
		ParsedProgram,
		ParsedRecordDecl,
		ParsedRecordExprField,
		ParsedResourceCleanup,
		ParsedSelectArm,
		ParsedSelectArmKind(ParsedSelectAfterArm, ParsedSelectReceiveArm, ParsedSelectSealedArm),
		ParsedStringInterpolationPart(ParsedInterpolationExpr, ParsedInterpolationLiteral),
		ParsedStringLiteralForm(
			ParsedPipeStringLiteral, ParsedPlainStringLiteral, ParsedRawPipeStringLiteral,
			ParsedRawStringLiteral,
		),
		ParsedTraitDecl,
		ParsedTraitMethodDecl,
		ParsedTraitReference,
		ParsedTypeAliasDecl,
		ParsedTypeExpr(
			ParsedArrayType, ParsedBoundedType, ParsedDimBinaryType, ParsedDimLiteralType,
			ParsedDimNameType, ParsedFunctionType, ParsedMissingType, ParsedNamedType,
			ParsedQualifiedNamedType, ParsedRangeType, ParsedTupleType,
		),
		ParsedTypeParamDecl,
		ParsedUnaryOp(ParsedNegateOp, ParsedNotOp),
		ParsedUnionDecl,
		ParsedVarDecl,
		ParsedVariantDecl,
		ParsedWithBinding,
		ParsedWithBindingKind(ParsedWithPlainBinding, ParsedWithTryBinding),
		ParsedWithErrorMap,


private KIND_FIELD: String = "kind"

PARSED_PROGRAM_KIND: String = "parsed_program"

PARSED_DECL_KIND_FUNCTION: String = "function"

private PARSED_DECL_KIND_VAR: String = "var"

private PARSED_DECL_KIND_IMPORT_BLOCK: String = "import_block"

private PARSED_DECL_KIND_FOREIGN_BLOCK: String = "foreign_block"

private PARSED_DECL_KIND_RECORD: String = "record"

private PARSED_DECL_KIND_UNION: String = "union"

private PARSED_DECL_KIND_BUILTIN_TYPE: String = "builtin_type"

private PARSED_DECL_KIND_TYPE_ALIAS: String = "type_alias"

private PARSED_DECL_KIND_TRAIT: String = "trait"

private PARSED_DECL_KIND_IMPL: String = "impl"

private PARSED_DECL_KIND_PRIVATE: String = "private"

private PARSED_DECL_KIND_ERROR: String = "error"


private pure func json_int(value: Int) -> JsonValue:
	JsonNumber(to_float(value))


--- A JSON string, or `null` when `value` is `None`.
pure func option_string_to_json(value: Option[String]) -> JsonValue:
	match value:
		Some(text):
			JsonString(text)
		None:
			JsonNull


---
What a parsed or typed AST dump needs to render: the source table that turns
locations into line and column spans, and where identifier spellings come from.
---
record AstJsonRender {
	source_table: SourceTable,
	spellings: IdentifierSpellings
}


---
The render context for dumping a program from `source`, reading identifier
spellings from `spellings`.
---
pure func ast_json_render(source: SourceFile, spellings: IdentifierSpellings) -> AstJsonRender:
	{
		source_table = source_table_for_file(source),
		spellings = spellings
	}


pure func parsed_source_location_to_json(
	render: AstJsonRender,
	location: SourceLocation,
) -> JsonValue:
	span: SourceSpan = source_location_span(render.source_table, location)
	JsonObject([
		("path", JsonString(span.path)),
		("start_line", json_int(span.start_line)),
		("start_column", json_int(span.start_column)),
		("end_line", json_int(span.end_line)),
		("end_column", json_int(span.end_column)),
	])


private pure func optional_source_location_to_json(
	render: AstJsonRender,
	span: Option[SourceLocation],
) -> JsonValue:
	match span:
		Some(value):
			parsed_source_location_to_json(render, value)
		None:
			JsonNull


pure func parsed_source_span_to_json(span: SourceSpan) -> JsonValue:
	JsonObject([
		("path", JsonString(span.path)),
		("start_line", json_int(span.start_line)),
		("start_column", json_int(span.start_column)),
		("end_line", json_int(span.end_line)),
		("end_column", json_int(span.end_column)),
	])


pure func parsed_source_file_to_json(source: SourceFile) -> JsonValue:
	JsonObject([
		(KIND_FIELD, JsonString("source_file")),
		("path", JsonString(source.path)),
		("module", JsonString(source.module_name)),
	])


---
The spelling of `identifier` in a dump, from the render context's spellings.
---
pure func parsed_identifier_text(render: AstJsonRender, identifier: ParsedIdentifier) -> String:
	identifier_spelling(render.spellings, identifier.name, identifier.text)


pure func parsed_identifier_to_json(
	render: AstJsonRender,
	identifier: ParsedIdentifier,
) -> JsonValue:
	JsonObject([
		("text", JsonString(parsed_identifier_text(render, identifier))),
		("span", parsed_source_location_to_json(render, identifier.span)),
	])


private pure func parsed_trait_reference_to_json(
	render: AstJsonRender,
	reference: ParsedTraitReference,
) -> JsonValue:
	JsonObject([
		(KIND_FIELD, JsonString("trait_reference")),
		("qualifier", option_identifier_to_json(render, reference.qualifier)),
		("name", parsed_identifier_to_json(render, reference.name)),
		("span", parsed_source_location_to_json(render, reference.span)),
	])


private pure func option_identifier_to_json(
	render: AstJsonRender,
	value: Option[ParsedIdentifier],
) -> JsonValue:
	match value:
		Some(identifier):
			parsed_identifier_to_json(render, identifier)
		None:
			JsonNull


private pure func dim_binary_op_to_json(op: ParsedDimBinaryOp) -> JsonValue:
	match op:
		ParsedDimAddOp:
			JsonString("add")
		ParsedDimSubtractOp:
			JsonString("subtract")
		ParsedDimMultiplyOp:
			JsonString("multiply")
		ParsedDimDivideOp:
			JsonString("divide")


--- The JSON spelling of a parsed binary operator.
pure func binary_op_to_json(op: ParsedBinaryOp) -> JsonValue:
	match op:
		ParsedAddOp:
			JsonString("add")
		ParsedSubtractOp:
			JsonString("subtract")
		ParsedMultiplyOp:
			JsonString("multiply")
		ParsedDivideOp:
			JsonString("divide")
		ParsedModuloOp:
			JsonString("modulo")
		ParsedEqualOp:
			JsonString("equal")
		ParsedNotEqualOp:
			JsonString("not_equal")
		ParsedLessOp:
			JsonString("less")
		ParsedLessEqualOp:
			JsonString("less_equal")
		ParsedGreaterOp:
			JsonString("greater")
		ParsedGreaterEqualOp:
			JsonString("greater_equal")


--- The JSON spelling of a parsed `and` or `or` operator.
pure func logical_op_to_json(op: ParsedLogicalOp) -> JsonValue:
	match op:
		ParsedAndOp:
			JsonString("and")
		ParsedOrOp:
			JsonString("or")


--- The JSON spelling of a parsed unary operator.
pure func unary_op_to_json(op: ParsedUnaryOp) -> JsonValue:
	match op:
		ParsedNegateOp:
			JsonString("negate")
		ParsedNotOp:
			JsonString("not")


private pure func compound_assign_op_to_json(op: ParsedCompoundAssignOp) -> JsonValue:
	match op:
		ParsedAssignAddOp:
			JsonString("add")
		ParsedAssignSubtractOp:
			JsonString("subtract")
		ParsedAssignMultiplyOp:
			JsonString("multiply")
		ParsedAssignDivideOp:
			JsonString("divide")


private pure func string_literal_form_to_json(form: ParsedStringLiteralForm) -> JsonValue:
	match form:
		ParsedPlainStringLiteral:
			JsonString("plain")
		ParsedRawStringLiteral:
			JsonString("raw")
		ParsedPipeStringLiteral:
			JsonString("pipe")
		ParsedRawPipeStringLiteral:
			JsonString("raw_pipe")


private pure func function_annotation_to_json(annotation: ParsedFunctionAnnotation) -> JsonValue:
	match annotation:
		ParsedTailRecursiveAnnotation:
			JsonString("tail_recursive")
		ParsedNoCopyAnnotation:
			JsonString("no_copy")
		ParsedDebugOnlyAnnotation:
			JsonString("debug_only")
		ParsedResourceResultOrdinaryAnnotation:
			JsonString("resource_result_ordinary")


private pure func dim_constraint_to_json(
	render: AstJsonRender,
	constraint: ParsedDimConstraint,
) -> JsonValue:
	JsonObject([
		("left", parsed_type_expr_to_json(render, constraint.left)),
		("right", parsed_type_expr_to_json(render, constraint.right)),
		("span", parsed_source_location_to_json(render, constraint.span)),
	])


private pure func option_type_expr_to_json(
	render: AstJsonRender,
	value: Option[ParsedTypeExpr],
) -> JsonValue:
	match value:
		Some(type_expr):
			parsed_type_expr_to_json(render, type_expr)
		None:
			JsonNull


private pure func parsed_for_binder_to_json(
	render: AstJsonRender,
	binder: ParsedForBinder,
) -> JsonValue:
	match binder:
		ParsedForNameBinder(name):
			JsonObject([
				(KIND_FIELD, JsonString("name")),
				("name", parsed_identifier_to_json(render, name)),
			])
		ParsedForTupleBinder(items, span):
			JsonObject([
				(KIND_FIELD, JsonString("tuple")),
				("items", JsonVector(items.map(
						func(item): parsed_identifier_to_json(render, item),
					))),
				("span", parsed_source_location_to_json(render, span)),
			])


private pure func parsed_type_expr_to_json(
	render: AstJsonRender,
	type_expr: ParsedTypeExpr,
) -> JsonValue:
	match type_expr:
		ParsedNamedType(name, args, span):
			JsonObject([
				(KIND_FIELD, JsonString("named")),
				("name", parsed_identifier_to_json(render, name)),
				("args", JsonVector(args.map(
						func(item): parsed_type_expr_to_json(render, item),
					))),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedQualifiedNamedType(module_name, name, args, span):
			JsonObject([
				(KIND_FIELD, JsonString("qualified_named")),
				("module", parsed_identifier_to_json(render, module_name)),
				("name", parsed_identifier_to_json(render, name)),
				("args", JsonVector(args.map(
						func(item): parsed_type_expr_to_json(render, item),
					))),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedBoundedType(name, bounds, span):
			JsonObject([
				(KIND_FIELD, JsonString("bounded")),
				("name", parsed_identifier_to_json(render, name)),
				("bounds", JsonVector(bounds.map(
						func(item): parsed_trait_reference_to_json(render, item),
					))),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedDimNameType(name, is_variadic, span):
			JsonObject([
				(KIND_FIELD, JsonString("dim_name")),
				("name", parsed_identifier_to_json(render, name)),
				("is_variadic", JsonBool(is_variadic)),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedDimLiteralType(value, span):
			JsonObject([
				(KIND_FIELD, JsonString("dim_literal")),
				("value", JsonString(value)),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedDimBinaryType(op, left, right, span):
			JsonObject([
				(KIND_FIELD, JsonString("dim_binary")),
				("op", dim_binary_op_to_json(op)),
				("left", parsed_type_expr_to_json(render, left)),
				("right", parsed_type_expr_to_json(render, right)),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedRangeType(limit, span):
			JsonObject([
				(KIND_FIELD, JsonString("range")),
				("limit", parsed_type_expr_to_json(render, limit)),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedTupleType(items, span):
			JsonObject([
				(KIND_FIELD, JsonString("tuple")),
				("items", JsonVector(items.map(
						func(item): parsed_type_expr_to_json(render, item),
					))),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedFunctionType(is_pure, params, return_type, span):
			JsonObject([
				(KIND_FIELD, JsonString("function")),
				("is_pure", JsonBool(is_pure)),
				("params", JsonVector(params.map(
						func(item): parsed_type_expr_to_json(render, item),
					))),
				("return_type", parsed_type_expr_to_json(render, return_type)),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedArrayType(element, dims, span):
			JsonObject([
				(KIND_FIELD, JsonString("array")),
				("element", parsed_type_expr_to_json(render, element)),
				("dims", JsonVector(dims.map(
						func(item): parsed_type_expr_to_json(render, item),
					))),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedMissingType(span):
			JsonObject([
				(KIND_FIELD, JsonString("missing")),
				("span", parsed_source_location_to_json(render, span)),
			])


private pure func parsed_type_param_decl_to_json(
	render: AstJsonRender,
	param: ParsedTypeParamDecl,
) -> JsonValue:
	JsonObject([
		("name", parsed_identifier_to_json(render, param.name)),
		("bounds", JsonVector(param.bounds.map(
				func(item): parsed_trait_reference_to_json(render, item),
			))),
		("span", parsed_source_location_to_json(render, param.span)),
	])


private pure func parsed_param_binder_to_json(
	render: AstJsonRender,
	binder: ParsedParamBinder,
) -> JsonValue:
	match binder:
		ParsedParamNameBinder(name):
			JsonObject([
				(KIND_FIELD, JsonString("name")),
				("name", parsed_identifier_to_json(render, name)),
			])
		ParsedParamWildcardBinder(span):
			JsonObject([
				(KIND_FIELD, JsonString("wildcard")),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedParamTupleBinder(items, span):
			JsonObject([
				(KIND_FIELD, JsonString("tuple")),
				("items", JsonVector(items.map(
						func(item): parsed_identifier_to_json(render, item),
					))),
				("span", parsed_source_location_to_json(render, span)),
			])


private pure func parsed_param_to_json(render: AstJsonRender, param: ParsedParam) -> JsonValue:
	JsonObject([
		("binder", parsed_param_binder_to_json(render, param.binder)),
		("type", option_type_expr_to_json(render, param.type_expr)),
		("span", parsed_source_location_to_json(render, param.span)),
	])


private pure func parsed_lambda_param_to_json(
	render: AstJsonRender,
	param: ParsedLambdaParam,
) -> JsonValue:
	JsonObject([
		("name", parsed_identifier_to_json(render, param.name)),
		("type", option_type_expr_to_json(render, param.type_expr)),
		("span", parsed_source_location_to_json(render, param.span)),
	])


--- The JSON form of a list-pattern spread: a named rest or a wildcard.
pure func parsed_list_pattern_spread_to_json(
	render: AstJsonRender,
	spread: ParsedListPatternSpread,
) -> JsonValue:
	match spread:
		ParsedListSpreadName(name):
			JsonObject([
				(KIND_FIELD, JsonString("name")),
				("name", parsed_identifier_to_json(render, name)),
			])
		ParsedListSpreadWildcard(span):
			JsonObject([
				(KIND_FIELD, JsonString("wildcard")),
				("span", parsed_source_location_to_json(render, span)),
			])


--- The JSON form of an optional list-pattern spread, `null` when absent.
pure func option_list_pattern_spread_to_json(
	render: AstJsonRender,
	spread: Option[ParsedListPatternSpread],
) -> JsonValue:
	match spread:
		Some(value):
			parsed_list_pattern_spread_to_json(render, value)
		None:
			JsonNull


private pure func parsed_pattern_to_json(
	render: AstJsonRender,
	pattern: ParsedPattern,
) -> JsonValue:
	match pattern:
		ParsedWildcardPattern(span):
			JsonObject([
				(KIND_FIELD, JsonString("wildcard")),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedNamePattern(name):
			JsonObject([
				(KIND_FIELD, JsonString("name")),
				("name", parsed_identifier_to_json(render, name)),
			])
		ParsedIntPattern(value, span):
			JsonObject([
				(KIND_FIELD, JsonString("int")),
				("value", JsonString(value)),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedFloatPattern(value, span):
			JsonObject([
				(KIND_FIELD, JsonString("float")),
				("value", JsonString(value)),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedStringPattern(value, form, span):
			JsonObject([
				(KIND_FIELD, JsonString("string")),
				("value", JsonString(value)),
				("form", string_literal_form_to_json(form)),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedCharPattern(value, span):
			JsonObject([
				(KIND_FIELD, JsonString("char")),
				("value", json_int(value)),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedBoolPattern(value, span):
			JsonObject([
				(KIND_FIELD, JsonString("bool")),
				("value", JsonBool(value)),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedConstructorPattern(name, args, span):
			JsonObject([
				(KIND_FIELD, JsonString("constructor")),
				("name", parsed_identifier_to_json(render, name)),
				("args", JsonVector(args.map(
						func(item): parsed_pattern_to_json(render, item),
					))),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedQualifiedConstructorPattern(module_name, name, args, span):
			JsonObject([
				(KIND_FIELD, JsonString("qualified_constructor")),
				("module", parsed_identifier_to_json(render, module_name)),
				("name", parsed_identifier_to_json(render, name)),
				("args", JsonVector(args.map(
						func(item): parsed_pattern_to_json(render, item),
					))),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedTuplePattern(items, span):
			JsonObject([
				(KIND_FIELD, JsonString("tuple")),
				("items", JsonVector(items.map(
						func(item): parsed_pattern_to_json(render, item),
					))),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedListPattern(items, spread, span):
			JsonObject([
				(KIND_FIELD, JsonString("list")),
				("items", JsonVector(items.map(
						func(item): parsed_pattern_to_json(render, item),
					))),
				("spread", option_list_pattern_spread_to_json(render, spread)),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedOrPattern(patterns, span):
			JsonObject([
				(KIND_FIELD, JsonString("or")),
				("patterns", JsonVector(patterns.map(
						func(item): parsed_pattern_to_json(render, item),
					))),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedMissingPattern(span):
			JsonObject([
				(KIND_FIELD, JsonString("missing")),
				("span", parsed_source_location_to_json(render, span)),
			])


private pure func parsed_match_case_to_json(
	render: AstJsonRender,
	match_case: ParsedMatchCase,
) -> JsonValue:
	JsonObject([
		("pattern", parsed_pattern_to_json(render, match_case.pattern)),
		("body", parsed_expr_to_json(render, match_case.body)),
		("span", parsed_source_location_to_json(render, match_case.span)),
	])


private pure func parsed_select_arm_kind_to_json(
	render: AstJsonRender,
	kind: ParsedSelectArmKind,
) -> JsonValue:
	match kind:
		ParsedSelectReceiveArm(name, source):
			JsonObject([
				(KIND_FIELD, JsonString("receive")),
				("name", parsed_identifier_to_json(render, name)),
				("source", parsed_expr_to_json(render, source)),
			])
		ParsedSelectSealedArm(source):
			JsonObject([
				(KIND_FIELD, JsonString("sealed")),
				("source", parsed_expr_to_json(render, source)),
			])
		ParsedSelectAfterArm(source):
			JsonObject([
				(KIND_FIELD, JsonString("after")),
				("source", parsed_expr_to_json(render, source)),
			])


private pure func parsed_select_arm_to_json(
	render: AstJsonRender,
	arm: ParsedSelectArm,
) -> JsonValue:
	JsonObject([
		("kind", parsed_select_arm_kind_to_json(render, arm.kind)),
		("body", parsed_expr_to_json(render, arm.body)),
		("span", parsed_source_location_to_json(render, arm.span)),
	])


private pure func parsed_record_expr_field_to_json(
	render: AstJsonRender,
	field: ParsedRecordExprField,
) -> JsonValue:
	JsonObject([
		("name", parsed_identifier_to_json(render, field.name)),
		("value", parsed_expr_to_json(render, field.value)),
		("span", parsed_source_location_to_json(render, field.span)),
	])


private pure func parsed_dict_entry_to_json(
	render: AstJsonRender,
	entry: ParsedDictEntry,
) -> JsonValue:
	JsonObject([
		("key", parsed_expr_to_json(render, entry.key)),
		("value", parsed_expr_to_json(render, entry.value)),
		("span", parsed_source_location_to_json(render, entry.span)),
	])


--- `null` for the default thread limit of a `concurrent` block, else the count.
pure func concurrent_thread_limit_to_json(limit: ConcurrentThreadLimit) -> JsonValue:
	match limit:
		DefaultThreadLimit:
			JsonNull
		ThreadLimit(count):
			json_int(count)


private pure func concurrent_for_limit_to_json(limit: ConcurrentForLimit) -> JsonValue:
	match limit:
		WrittenLimit(count):
			json_int(count)
		MissingLimit:
			JsonNull


private pure func parsed_optional_expr_to_json(
	render: AstJsonRender,
	value: Option[ParsedExpr],
) -> JsonValue:
	match value:
		Some(expr):
			parsed_expr_to_json(render, expr)
		None:
			JsonNull


--- The JSON spelling of a `with` binding kind: `plain` or `try`.
pure func with_binding_kind_to_json(kind: ParsedWithBindingKind) -> JsonValue:
	match kind:
		ParsedWithPlainBinding:
			JsonString("plain")
		ParsedWithTryBinding:
			JsonString("try")


private pure func parsed_with_error_map_to_json(
	render: AstJsonRender,
	error_map: ParsedWithErrorMap,
) -> JsonValue:
	JsonObject([
		("name", parsed_identifier_to_json(render, error_map.name)),
		("value", parsed_expr_to_json(render, error_map.value)),
		("span", parsed_source_location_to_json(render, error_map.span)),
	])


private pure func option_with_error_map_to_json(
	render: AstJsonRender,
	value: Option[ParsedWithErrorMap],
) -> JsonValue:
	match value:
		Some(error_map):
			parsed_with_error_map_to_json(render, error_map)
		None:
			JsonNull


private pure func parsed_with_binding_to_json(
	render: AstJsonRender,
	binding: ParsedWithBinding,
) -> JsonValue:
	JsonObject([
		("name", parsed_identifier_to_json(render, binding.name)),
		("type", option_type_expr_to_json(render, binding.type_expr)),
		("value", parsed_expr_to_json(render, binding.value)),
		("kind", with_binding_kind_to_json(binding.kind)),
		("error_map", option_with_error_map_to_json(render, binding.error_map)),
		("span", parsed_source_location_to_json(render, binding.span)),
	])


private pure func option_expr_to_json(
	render: AstJsonRender,
	value: Option[ParsedExpr],
) -> JsonValue:
	match value:
		Some(expr):
			parsed_expr_to_json(render, expr)
		None:
			JsonNull


private pure func parsed_string_interpolation_part_to_json(
	render: AstJsonRender,
	part: ParsedStringInterpolationPart,
) -> JsonValue:
	match part:
		ParsedInterpolationLiteral(value):
			JsonObject([
				(KIND_FIELD, JsonString("literal")),
				("value", JsonString(value)),
			])
		ParsedInterpolationExpr(expr, hole):
			JsonObject([
				(KIND_FIELD, JsonString("expr")),
				("expr", parsed_expr_to_json(render, expr)),
				("span", parsed_source_location_to_json(render, hole)),
			])


private pure func parsed_expr_to_json(render: AstJsonRender, expr: ParsedExpr) -> JsonValue:
	match expr:
		ParsedNameExpr(name):
			JsonObject([
				(KIND_FIELD, JsonString("name")),
				("name", parsed_identifier_to_json(render, name)),
			])
		ParsedIntLiteralExpr(value, span):
			JsonObject([
				(KIND_FIELD, JsonString("int_literal")),
				("value", JsonString(value)),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedFloatLiteralExpr(value, span):
			JsonObject([
				(KIND_FIELD, JsonString("float_literal")),
				("value", JsonString(value)),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedStringLiteralExpr(value, form, span):
			JsonObject([
				(KIND_FIELD, JsonString("string_literal")),
				("value", JsonString(value)),
				("form", string_literal_form_to_json(form)),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedStringInterpolationExpr(value, is_multiline, span):
			JsonObject([
				(KIND_FIELD, JsonString("string_interp_raw")),
				("value", JsonString(value)),
				("multiline", JsonBool(is_multiline)),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedStringInterpolationPartsExpr(parts, is_multiline, span):
			JsonObject([
				(KIND_FIELD, JsonString("string_interp")),
				("parts", JsonVector(parts.map(
						func(item): parsed_string_interpolation_part_to_json(render, item),
					))),
				("multiline", JsonBool(is_multiline)),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedBoolLiteralExpr(value, span):
			JsonObject([
				(KIND_FIELD, JsonString("bool_literal")),
				("value", JsonBool(value)),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedCharLiteralExpr(value, span):
			JsonObject([
				(KIND_FIELD, JsonString("char_literal")),
				("value", json_int(value)),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedUnaryExpr(op, value, span):
			JsonObject([
				(KIND_FIELD, JsonString("unary")),
				("op", unary_op_to_json(op)),
				("value", parsed_expr_to_json(render, value)),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedBinaryExpr(op, left, right, span):
			JsonObject([
				(KIND_FIELD, JsonString("binary")),
				("op", binary_op_to_json(op)),
				("left", parsed_expr_to_json(render, left)),
				("right", parsed_expr_to_json(render, right)),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedLogicalExpr(op, left, right, span):
			JsonObject([
				(KIND_FIELD, JsonString("logical")),
				("op", logical_op_to_json(op)),
				("left", parsed_expr_to_json(render, left)),
				("right", parsed_expr_to_json(render, right)),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedRangeExpr(start, finish, span):
			JsonObject([
				(KIND_FIELD, JsonString("range")),
				("start", parsed_expr_to_json(render, start)),
				("finish", parsed_expr_to_json(render, finish)),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedCallExpr(callee, args, span):
			JsonObject([
				(KIND_FIELD, JsonString("call")),
				("callee", parsed_expr_to_json(render, callee)),
				("args", JsonVector(args.map(
						func(item): parsed_expr_to_json(render, item),
					))),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedFieldAccessExpr(target, field, span):
			JsonObject([
				(KIND_FIELD, JsonString("field_access")),
				("target", parsed_expr_to_json(render, target)),
				("field", parsed_identifier_to_json(render, field)),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedSubscriptExpr(target, indices, span):
			JsonObject([
				(KIND_FIELD, JsonString("subscript")),
				("target", parsed_expr_to_json(render, target)),
				("indices", JsonVector(indices.map(
						func(item): parsed_expr_to_json(render, item),
					))),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedSubscriptAssignExpr(target, indices, value, span):
			JsonObject([
				(KIND_FIELD, JsonString("subscript_assign")),
				("target", parsed_expr_to_json(render, target)),
				("indices", JsonVector(indices.map(
						func(item): parsed_expr_to_json(render, item),
					))),
				("value", parsed_expr_to_json(render, value)),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedListExpr(items, span):
			JsonObject([
				(KIND_FIELD, JsonString("list")),
				("items", JsonVector(items.map(
						func(item): parsed_expr_to_json(render, item),
					))),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedTupleExpr(items, span):
			JsonObject([
				(KIND_FIELD, JsonString("tuple")),
				("items", JsonVector(items.map(
						func(item): parsed_expr_to_json(render, item),
					))),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedRecordExpr(fields, span):
			JsonObject([
				(KIND_FIELD, JsonString("record")),
				("fields", JsonVector(fields.map(
						func(item): parsed_record_expr_field_to_json(render, item),
					))),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedRecordUpdateExpr(base, fields, span):
			JsonObject([
				(KIND_FIELD, JsonString("record_update")),
				("base", parsed_expr_to_json(render, base)),
				("fields", JsonVector(fields.map(
						func(item): parsed_record_expr_field_to_json(render, item),
					))),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedDictExpr(entries, span):
			JsonObject([
				(KIND_FIELD, JsonString("dict")),
				("entries", JsonVector(entries.map(
						func(item): parsed_dict_entry_to_json(render, item),
					))),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedVectorExpr(items, span):
			JsonObject([
				(KIND_FIELD, JsonString("vector")),
				("items", JsonVector(items.map(
						func(item): parsed_expr_to_json(render, item),
					))),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedOpaqueIntoExpr(type_expr, value, span):
			JsonObject([
				(KIND_FIELD, JsonString("opaque_into")),
				("type", parsed_type_expr_to_json(render, type_expr)),
				("value", parsed_expr_to_json(render, value)),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedOpaqueFromExpr(type_expr, value, span):
			JsonObject([
				(KIND_FIELD, JsonString("opaque_from")),
				("type", parsed_type_expr_to_json(render, type_expr)),
				("value", parsed_expr_to_json(render, value)),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedBlockExpr(items, span):
			JsonObject([
				(KIND_FIELD, JsonString("block")),
				("items", JsonVector(items.map(
						func(item): parsed_expr_to_json(render, item),
					))),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedIfExpr(cond, then_expr, else_expr, span):
			JsonObject([
				(KIND_FIELD, JsonString("if")),
				("condition", parsed_expr_to_json(render, cond)),
				("then", parsed_expr_to_json(render, then_expr)),
				("else", option_expr_to_json(
						render,
						else_expr.map(func(branch): branch.body),
					)),
				("else_keyword", optional_source_location_to_json(
						render,
						else_expr.map(func(branch): branch.keyword),
					)),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedMatchExpr(value, cases, span):
			JsonObject([
				(KIND_FIELD, JsonString("match")),
				("value", parsed_expr_to_json(render, value)),
				("cases", JsonVector(cases.map(
						func(item): parsed_match_case_to_json(render, item),
					))),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedSelectExpr(arms, span):
			JsonObject([
				(KIND_FIELD, JsonString("select")),
				("arms", JsonVector(arms.map(
						func(item): parsed_select_arm_to_json(render, item),
					))),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedWithExpr(binding, body, span):
			JsonObject([
				(KIND_FIELD, JsonString("with")),
				("binding", parsed_with_binding_to_json(render, binding)),
				("body", parsed_expr_to_json(render, body)),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedDebugBlockExpr(body, span):
			JsonObject([
				(KIND_FIELD, JsonString("debug_block")),
				("body", parsed_expr_to_json(render, body)),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedLambdaExpr(is_pure, params, return_type, body, span):
			JsonObject([
				(KIND_FIELD, JsonString("lambda")),
				("is_pure", JsonBool(is_pure)),
				("params", JsonVector(params.map(
						func(item): parsed_lambda_param_to_json(render, item),
					))),
				("return_type", option_type_expr_to_json(render, return_type)),
				("body", parsed_expr_to_json(render, body)),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedFunctionDeclExpr(function_decl):
			JsonObject([
				(KIND_FIELD, JsonString("function_decl")),
				("function", parsed_function_decl_to_json(render, function_decl)),
				("span", parsed_source_location_to_json(render, function_decl.span)),
			])
		ParsedWhileExpr(cond, body, span):
			JsonObject([
				(KIND_FIELD, JsonString("while")),
				("condition", parsed_expr_to_json(render, cond)),
				("body", parsed_expr_to_json(render, body)),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedForExpr(binder, iterable, body, span):
			JsonObject([
				(KIND_FIELD, JsonString("for")),
				("binder", parsed_for_binder_to_json(render, binder)),
				("iterable", parsed_expr_to_json(render, iterable)),
				("body", parsed_expr_to_json(render, body)),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedConcurrentBlockExpr(options, body, span):
			JsonObject([
				(KIND_FIELD, JsonString("concurrent_block")),
				("max_threads", concurrent_thread_limit_to_json(options.max_threads)),
				("timeout", parsed_optional_expr_to_json(render, options.timeout)),
				("body", parsed_expr_to_json(render, body)),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedConcurrentForExpr(name, iterable, options, body, span):
			JsonObject([
				(KIND_FIELD, JsonString("concurrent_for")),
				("name", parsed_identifier_to_json(render, name)),
				("iterable", parsed_expr_to_json(render, iterable)),
				("limit", concurrent_for_limit_to_json(options.limit)),
				("timeout", parsed_optional_expr_to_json(render, options.timeout)),
				("body", parsed_expr_to_json(render, body)),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedDetachExpr(body, span):
			JsonObject([
				(KIND_FIELD, JsonString("detach")),
				("body", parsed_expr_to_json(render, body)),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedBreakExpr(span):
			JsonObject([
				(KIND_FIELD, JsonString("break")),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedContinueExpr(span):
			JsonObject([
				(KIND_FIELD, JsonString("continue")),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedVoidExpr(span):
			JsonObject([
				(KIND_FIELD, JsonString("void")),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedBuiltinExpr(name, span):
			JsonObject([
				(KIND_FIELD, JsonString("builtin")),
				("name", option_string_to_json(name)),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedVarDeclExpr(name, type_expr, value, is_mutable, span):
			JsonObject([
				(KIND_FIELD, JsonString("var_decl")),
				("name", parsed_identifier_to_json(render, name)),
				("type", option_type_expr_to_json(render, type_expr)),
				("value", parsed_expr_to_json(render, value)),
				("is_mutable", JsonBool(is_mutable)),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedAssignExpr(name, value, span):
			JsonObject([
				(KIND_FIELD, JsonString("assign")),
				("name", parsed_identifier_to_json(render, name)),
				("value", parsed_expr_to_json(render, value)),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedCompoundAssignExpr(name, op, value, span):
			JsonObject([
				(KIND_FIELD, JsonString("compound_assign")),
				("name", parsed_identifier_to_json(render, name)),
				("op", compound_assign_op_to_json(op)),
				("value", parsed_expr_to_json(render, value)),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedTupleDestructExpr(names, value, span):
			JsonObject([
				(KIND_FIELD, JsonString("tuple_destruct")),
				("names", JsonVector(names.map(
						func(item): parsed_identifier_to_json(render, item),
					))),
				("value", parsed_expr_to_json(render, value)),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedQuestionBindExpr(name, type_expr, value, span):
			JsonObject([
				(KIND_FIELD, JsonString("question_bind")),
				("name", parsed_identifier_to_json(render, name)),
				("type", option_type_expr_to_json(render, type_expr)),
				("value", parsed_expr_to_json(render, value)),
				("span", parsed_source_location_to_json(render, span)),
			])
		ParsedMissingExpr(span):
			JsonObject([
				(KIND_FIELD, JsonString("missing")),
				("span", parsed_source_location_to_json(render, span)),
			])


pure func parsed_function_decl_to_json(
	render: AstJsonRender,
	decl: ParsedFunctionDecl,
) -> JsonValue:
	JsonObject([
		("name", parsed_identifier_to_json(render, decl.name)),
		("keyword_span", optional_source_location_to_json(render, decl.keyword_span)),
		("type_params", JsonVector(decl.type_params.map(
				func(item): parsed_type_param_decl_to_json(render, item),
			))),
		("params", JsonVector(decl.params.map(
				func(item): parsed_param_to_json(render, item),
			))),
		("return_type", option_type_expr_to_json(render, decl.return_type)),
		("dim_constraints", JsonVector(decl.dim_constraints.map(
				func(item): dim_constraint_to_json(render, item),
			))),
		("body", option_expr_to_json(render, decl.body)),
		("is_pure", JsonBool(decl.is_pure)),
		("annotations", JsonVector(decl.annotations.map(function_annotation_to_json))),
		("doc", option_string_to_json(decl.doc)),
		("span", parsed_source_location_to_json(render, decl.span)),
	])


pure func parsed_var_decl_to_json(render: AstJsonRender, decl: ParsedVarDecl) -> JsonValue:
	JsonObject([
		("name", parsed_identifier_to_json(render, decl.name)),
		("type", option_type_expr_to_json(render, decl.type_expr)),
		("value", parsed_expr_to_json(render, decl.value)),
		("is_mutable", JsonBool(decl.is_mutable)),
		("doc", option_string_to_json(decl.doc)),
		("span", parsed_source_location_to_json(render, decl.span)),
	])


private pure func parsed_import_symbol_to_json(
	render: AstJsonRender,
	symbol: ParsedImportSymbol,
) -> JsonValue:
	JsonObject([
		("name", parsed_identifier_to_json(render, symbol.name)),
		("alias", option_identifier_to_json(render, symbol.symbol_alias)),
		("constructors", JsonVector(symbol.constructors.map(
				func(item): parsed_identifier_to_json(render, item),
			))),
		("span", parsed_source_location_to_json(render, symbol.span)),
	])


private pure func option_import_symbols_to_json(
	render: AstJsonRender,
	value: Option[List[ParsedImportSymbol]],
) -> JsonValue:
	match value:
		Some(symbols):
			JsonVector(symbols.map(
				func(item): parsed_import_symbol_to_json(render, item),
			))
		None:
			JsonNull


pure func parsed_import_decl_to_json(render: AstJsonRender, decl: ParsedImportDecl) -> JsonValue:
	JsonObject([
		("module_path", JsonString(decl.module_path)),
		("module_path_span", parsed_source_location_to_json(render, decl.module_path_span)),
		("module_alias", option_identifier_to_json(render, decl.module_alias)),
		("symbols", option_import_symbols_to_json(render, decl.symbols)),
		("span", parsed_source_location_to_json(render, decl.span)),
	])


private pure func parsed_foreign_block_arg_to_json(
	render: AstJsonRender,
	arg: ParsedForeignBlockArg,
) -> JsonValue:
	JsonObject([
		("name", parsed_identifier_to_json(render, arg.name)),
		("value", JsonString(arg.value)),
		("span", parsed_source_location_to_json(render, arg.span)),
	])


private pure func parsed_foreign_function_decl_to_json(
	render: AstJsonRender,
	decl: ParsedForeignFunctionDecl,
) -> JsonValue:
	JsonObject([
		("name", parsed_identifier_to_json(render, decl.name)),
		("params", JsonVector(decl.params.map(
				func(item): parsed_param_to_json(render, item),
			))),
		("return_type", parsed_type_expr_to_json(render, decl.return_type)),
		("c_name", option_string_to_json(decl.c_name)),
		("is_pure", JsonBool(decl.is_pure)),
		("is_private", JsonBool(decl.is_private)),
		("annotations", JsonVector(decl.annotations.map(function_annotation_to_json))),
		("span", parsed_source_location_to_json(render, decl.span)),
	])


private pure func parsed_field_decl_to_json(
	render: AstJsonRender,
	field: ParsedFieldDecl,
) -> JsonValue:
	JsonObject([
		("name", parsed_identifier_to_json(render, field.name)),
		("type", parsed_type_expr_to_json(render, field.type_expr)),
		("span", parsed_source_location_to_json(render, field.span)),
	])


pure func parsed_record_decl_to_json(render: AstJsonRender, decl: ParsedRecordDecl) -> JsonValue:
	form: String = match decl.form:
		OrdinaryRecord:
			"ordinary_record"
		LegacyStruct:
			"legacy_struct"
		FixedRecord:
			"fixed_record"
	JsonObject([
		("name", parsed_identifier_to_json(render, decl.name)),
		("type_params", JsonVector(decl.type_params.map(
				func(item): parsed_type_param_decl_to_json(render, item),
			))),
		("fields", JsonVector(decl.fields.map(
				func(item): parsed_field_decl_to_json(render, item),
			))),
		("form", JsonString(form)),
		("doc", option_string_to_json(decl.doc)),
		("span", parsed_source_location_to_json(render, decl.span)),
	])


private pure func parsed_variant_decl_to_json(
	render: AstJsonRender,
	variant: ParsedVariantDecl,
) -> JsonValue:
	JsonObject([
		("name", parsed_identifier_to_json(render, variant.name)),
		("fields", JsonVector(variant.fields.map(
				func(item): parsed_type_expr_to_json(render, item),
			))),
		("span", parsed_source_location_to_json(render, variant.span)),
	])


pure func parsed_union_decl_to_json(render: AstJsonRender, decl: ParsedUnionDecl) -> JsonValue:
	JsonObject([
		("name", parsed_identifier_to_json(render, decl.name)),
		("type_params", JsonVector(decl.type_params.map(
				func(item): parsed_type_param_decl_to_json(render, item),
			))),
		("variants", JsonVector(decl.variants.map(
				func(item): parsed_variant_decl_to_json(render, item),
			))),
		("is_enum", JsonBool(decl.is_enum)),
		("doc", option_string_to_json(decl.doc)),
		("span", parsed_source_location_to_json(render, decl.span)),
	])


private pure func parsed_resource_cleanup_to_json(
	render: AstJsonRender,
	cleanup: ParsedResourceCleanup,
) -> JsonValue:
	JsonObject([
		(KIND_FIELD, JsonString("builtin")),
		("name", JsonString(cleanup.builtin_name)),
		("span", parsed_source_location_to_json(render, cleanup.span)),
	])


private pure func option_resource_cleanup_to_json(
	render: AstJsonRender,
	value: Option[ParsedResourceCleanup],
) -> JsonValue:
	match value:
		Some(cleanup):
			parsed_resource_cleanup_to_json(render, cleanup)
		None:
			JsonNull


private pure func parsed_builtin_type_decl_to_json(
	render: AstJsonRender,
	decl: ParsedBuiltinTypeDecl,
) -> JsonValue:
	JsonObject([
		("name", parsed_identifier_to_json(render, decl.name)),
		("type_params", JsonVector(decl.type_params.map(
				func(item): parsed_type_param_decl_to_json(render, item),
			))),
		("is_resource", JsonBool(decl.is_resource)),
		("cleanup", option_resource_cleanup_to_json(render, decl.cleanup)),
		("doc", option_string_to_json(decl.doc)),
		("span", parsed_source_location_to_json(render, decl.span)),
	])


pure func parsed_type_alias_decl_to_json(
	render: AstJsonRender,
	decl: ParsedTypeAliasDecl,
) -> JsonValue:
	JsonObject([
		("name", parsed_identifier_to_json(render, decl.name)),
		("type_params", JsonVector(decl.type_params.map(
				func(item): parsed_type_param_decl_to_json(render, item),
			))),
		("target", parsed_type_expr_to_json(render, decl.target)),
		("is_opaque", JsonBool(decl.is_opaque)),
		("doc", option_string_to_json(decl.doc)),
		("span", parsed_source_location_to_json(render, decl.span)),
	])


private pure func parsed_trait_method_decl_to_json(
	render: AstJsonRender,
	decl: ParsedTraitMethodDecl,
) -> JsonValue:
	JsonObject([
		("name", parsed_identifier_to_json(render, decl.name)),
		("params", JsonVector(decl.params.map(
				func(item): parsed_param_to_json(render, item),
			))),
		("return_type", option_type_expr_to_json(render, decl.return_type)),
		("body", option_expr_to_json(render, decl.body)),
		("is_pure", JsonBool(decl.is_pure)),
		("span", parsed_source_location_to_json(render, decl.span)),
	])


private pure func parsed_trait_decl_to_json(
	render: AstJsonRender,
	decl: ParsedTraitDecl,
) -> JsonValue:
	JsonObject([
		("name", parsed_identifier_to_json(render, decl.name)),
		("type_params", JsonVector(decl.type_params.map(
				func(item): parsed_type_param_decl_to_json(render, item),
			))),
		("supertraits", JsonVector(decl.supertraits.map(
				func(item): parsed_trait_reference_to_json(render, item),
			))),
		("methods", JsonVector(decl.methods.map(
				func(item): parsed_trait_method_decl_to_json(render, item),
			))),
		("doc", option_string_to_json(decl.doc)),
		("span", parsed_source_location_to_json(render, decl.span)),
	])


pure func parsed_impl_decl_to_json(render: AstJsonRender, decl: ParsedImplDecl) -> JsonValue:
	JsonObject([
		("trait_name", parsed_identifier_to_json(render, decl.trait_name)),
		("for_type", parsed_type_expr_to_json(render, decl.for_type)),
		("methods", JsonVector(decl.methods.map(
				func(item): parsed_function_decl_to_json(render, item),
			))),
		("doc", option_string_to_json(decl.doc)),
		("span", parsed_source_location_to_json(render, decl.span)),
	])


private pure func with_kind(fields: List[(String, JsonValue)], kind: String) -> JsonValue:
	var result: List[(String, JsonValue)] = [(KIND_FIELD, JsonString(kind))]

	for field in fields:
		result = result.append(field)

	JsonObject(result)


pure func parsed_decl_to_json(render: AstJsonRender, decl: ParsedDecl) -> JsonValue:
	match decl:
		FunctionParsedDecl(function_decl):
			with_kind(
				[
					("name", JsonString(parsed_identifier_text(render, function_decl.name))),
					("function", parsed_function_decl_to_json(render, function_decl)),
				],
				PARSED_DECL_KIND_FUNCTION,
			)
		VarParsedDecl(var_decl):
			with_kind(
				[
					("name", JsonString(parsed_identifier_text(render, var_decl.name))),
					("var", parsed_var_decl_to_json(render, var_decl)),
				],
				PARSED_DECL_KIND_VAR,
			)
		ImportBlockParsedDecl(imports, span):
			with_kind(
				[("imports", JsonVector(imports.map(
							func(item): parsed_import_decl_to_json(render, item),
						))), ("span", parsed_source_location_to_json(render, span))],
				PARSED_DECL_KIND_IMPORT_BLOCK,
			)
		ForeignBlockParsedDecl(args, functions, span):
			with_kind(
				[("args", JsonVector(args.map(
							func(item): parsed_foreign_block_arg_to_json(render, item),
						))), ("functions", JsonVector(functions.map(
							func(item): parsed_foreign_function_decl_to_json(render, item),
						))), ("span", parsed_source_location_to_json(render, span))],
				PARSED_DECL_KIND_FOREIGN_BLOCK,
			)
		RecordParsedDecl(record_decl):
			with_kind(
				[
					("name", JsonString(parsed_identifier_text(render, record_decl.name))),
					("record", parsed_record_decl_to_json(render, record_decl)),
				],
				PARSED_DECL_KIND_RECORD,
			)
		UnionParsedDecl(union_decl):
			with_kind(
				[
					("name", JsonString(parsed_identifier_text(render, union_decl.name))),
					("union", parsed_union_decl_to_json(render, union_decl)),
				],
				PARSED_DECL_KIND_UNION,
			)
		BuiltinTypeParsedDecl(type_decl):
			with_kind(
				[
					("name", JsonString(parsed_identifier_text(render, type_decl.name))),
					("type", parsed_builtin_type_decl_to_json(render, type_decl)),
				],
				PARSED_DECL_KIND_BUILTIN_TYPE,
			)
		TypeAliasParsedDecl(type_alias):
			with_kind(
				[
					("name", JsonString(parsed_identifier_text(render, type_alias.name))),
					("alias", parsed_type_alias_decl_to_json(render, type_alias)),
				],
				PARSED_DECL_KIND_TYPE_ALIAS,
			)
		TraitParsedDecl(trait_decl):
			with_kind(
				[
					("name", JsonString(parsed_identifier_text(render, trait_decl.name))),
					("trait", parsed_trait_decl_to_json(render, trait_decl)),
				],
				PARSED_DECL_KIND_TRAIT,
			)
		ImplParsedDecl(impl_decl):
			with_kind(
				[("impl", parsed_impl_decl_to_json(render, impl_decl))],
				PARSED_DECL_KIND_IMPL,
			)
		PrivateParsedDecl(inner, span):
			with_kind(
				[
					("decl", parsed_decl_to_json(render, inner)),
					("span", parsed_source_location_to_json(render, span)),
				],
				PARSED_DECL_KIND_PRIVATE,
			)
		ParsedErrorDecl(span):
			with_kind(
				[("span", parsed_source_location_to_json(render, span))],
				PARSED_DECL_KIND_ERROR,
			)


pure func parse_diagnostic_to_json(diagnostic: ParseDiagnostic) -> JsonValue:
	JsonObject([
		("severity", JsonString("error")),
		("span", parsed_source_span_to_json(diagnostic.span)),
		("message", JsonString(diagnostic.message)),
		("expected", JsonVector(diagnostic.expected.map(
				func(item: String): JsonString(item),
			))),
		("help", option_string_to_json(diagnostic.help)),
	])


private pure func parsed_module_doc_to_json(
	render: AstJsonRender,
	module_doc: Option[ParsedModuleDoc],
) -> JsonValue:
	match module_doc:
		Some(doc):
			JsonObject([
				("text", JsonString(doc.text)),
				("span", parsed_source_location_to_json(render, doc.span)),
			])
		None:
			JsonNull


pure func parsed_program_to_json(program: ParsedProgram) -> JsonValue:
	render: AstJsonRender = ast_json_render(program.source, SpellingsFromIdentifierText)
	JsonObject([
		(KIND_FIELD, JsonString(PARSED_PROGRAM_KIND)),
		("source", parsed_source_file_to_json(program.source)),
		("module_doc", parsed_module_doc_to_json(render, program.module_doc)),
		("decls", JsonVector(program.decls.map(
				func(decl): parsed_decl_to_json(render, decl),
			))),
		("diagnostics", JsonVector(program.diagnostics.map(parse_diagnostic_to_json))),
	])


---
ParsedProgram intentionally does not claim generic Equatable support. This
exact comparison is reserved for cold compiler-boundary checks that must
include resolved import rewrites as well as source identity. The JSON
projection is complete and deterministic, so it is the canonical structural
form until the parsed phase owns a dedicated comparison representation.
---
pure func parsed_programs_are_equal(left: ParsedProgram, right: ParsedProgram) -> Bool:
	parsed_program_to_json(left).to_string() == parsed_program_to_json(right).to_string()
