-- JSON projection for the Blorp-owned parsed AST.
--
-- Explicit benchmark and diagnostic protocols use this shape. Normal compiler
-- phases exchange ParsedProgram values directly.
import:
	../../lib/source: SourceFile, SourceSpan
	../stage_02_lex/parse_diagnostic:
		ParseDiagnostic,
		ParseDiagnosticSeverity(ParseErrorSeverity, ParseWarningSeverity),
	json: JsonValue(JsonBool, JsonNull, JsonNumber, JsonObject, JsonString, JsonVector)
	parsed_ast:
		ParsedBinaryOp(
			ParsedAddOp,
			ParsedDivideOp,
			ParsedEqualOp,
			ParsedGreaterEqualOp,
			ParsedGreaterOp,
			ParsedLessEqualOp,
			ParsedLessOp,
			ParsedModuloOp,
			ParsedMultiplyOp,
			ParsedNotEqualOp,
			ParsedSubtractOp,
		),
		ParsedBuiltinTypeDecl,
		ParsedCompoundAssignOp(
			ParsedAssignAddOp,
			ParsedAssignDivideOp,
			ParsedAssignMultiplyOp,
			ParsedAssignSubtractOp,
		),
		ParsedConcurrentParam,
		ParsedDecl(
			BuiltinTypeParsedDecl,
			ForeignBlockParsedDecl,
			FunctionParsedDecl,
			ImplParsedDecl,
			ImportBlockParsedDecl,
			ParsedErrorDecl,
			PrivateParsedDecl,
			RecordParsedDecl,
			TraitParsedDecl,
			TypeAliasParsedDecl,
			UnionParsedDecl,
			VarParsedDecl,
		),
		ParsedDictEntry,
		ParsedDimBinaryOp(
			ParsedDimAddOp,
			ParsedDimDivideOp,
			ParsedDimMultiplyOp,
			ParsedDimSubtractOp,
		),
		ParsedDimConstraint,
		ParsedExpr(
			ParsedAssignExpr,
			ParsedAscriptionExpr,
			ParsedBinaryExpr,
			ParsedBlockExpr,
			ParsedBoolLiteralExpr,
			ParsedBreakExpr,
			ParsedBuiltinExpr,
			ParsedCallExpr,
			ParsedCharLiteralExpr,
			ParsedCompoundAssignExpr,
			ParsedConcurrentBlockExpr,
			ParsedConcurrentForExpr,
			ParsedContinueExpr,
			ParsedDebugBlockExpr,
			ParsedDetachExpr,
			ParsedDictExpr,
			ParsedFieldAccessExpr,
			ParsedFloatLiteralExpr,
			ParsedForExpr,
			ParsedFunctionDeclExpr,
			ParsedIfExpr,
			ParsedIntLiteralExpr,
			ParsedLambdaExpr,
			ParsedListExpr,
			ParsedLogicalExpr,
			ParsedMatchExpr,
			ParsedMissingExpr,
			ParsedNameExpr,
			ParsedOpaqueFromExpr,
			ParsedOpaqueIntoExpr,
			ParsedQuestionBindExpr,
			ParsedRangeExpr,
			ParsedRecordExpr,
			ParsedRecordUpdateExpr,
			ParsedSelectExpr,
			ParsedStringInterpolationExpr,
			ParsedStringInterpolationPartsExpr,
			ParsedStringLiteralExpr,
			ParsedSubscriptAssignExpr,
			ParsedSubscriptExpr,
			ParsedTupleExpr,
			ParsedTupleDestructExpr,
			ParsedUnaryExpr,
			ParsedVarDeclExpr,
			ParsedVectorExpr,
			ParsedVoidExpr,
			ParsedWhileExpr,
			ParsedWithExpr,
		),
		ParsedFieldDecl,
		ParsedForBinder(ParsedForNameBinder, ParsedForTupleBinder),
		ParsedForeignBlockArg,
		ParsedForeignFunctionDecl,
		ParsedFunctionAnnotation(
			ParsedDebugOnlyAnnotation,
			ParsedNoCopyAnnotation,
			ParsedResourceResultOrdinaryAnnotation,
			ParsedTailRecursiveAnnotation,
		),
		ParsedFunctionDecl,
		ParsedIdentifier,
		ParsedImplDecl,
		ParsedImportDecl,
		ParsedImportSymbol,
		ParsedLambdaParam,
		ParsedListPatternSpread(ParsedListSpreadName, ParsedListSpreadWildcard),
		ParsedLogicalOp(ParsedAndOp, ParsedOrOp),
		ParsedMatchCase,
		ParsedParam,
		ParsedParamBinder(ParsedParamNameBinder, ParsedParamTupleBinder, ParsedParamWildcardBinder),
		ParsedPattern(
			ParsedBoolPattern,
			ParsedCharPattern,
			ParsedConstructorPattern,
			ParsedFloatPattern,
			ParsedIntPattern,
			ParsedListPattern,
			ParsedMissingPattern,
			ParsedNamePattern,
			ParsedOrPattern,
			ParsedQualifiedConstructorPattern,
			ParsedStringPattern,
			ParsedTuplePattern,
			ParsedWildcardPattern,
		),
		ParsedProgram,
		ParsedRecordDecl,
		ParsedRecordExprField,
		ParsedResourceCleanup,
		ParsedSelectArm,
		ParsedSelectArmKind(ParsedSelectAfterArm, ParsedSelectReceiveArm, ParsedSelectSealedArm),
		ParsedStringInterpolationPart(ParsedInterpolationExpr, ParsedInterpolationLiteral),
		ParsedStringLiteralForm(
			ParsedPipeStringLiteral,
			ParsedPlainStringLiteral,
			ParsedRawPipeStringLiteral,
			ParsedRawStringLiteral,
		),
		ParsedTraitDecl,
		ParsedTraitMethodDecl,
		ParsedTypeAliasDecl,
		ParsedTypeExpr(
			ParsedArrayType,
			ParsedBoundedType,
			ParsedDimBinaryType,
			ParsedDimLiteralType,
			ParsedDimNameType,
			ParsedFunctionType,
			ParsedMissingType,
			ParsedNamedType,
			ParsedQualifiedNamedType,
			ParsedRangeType,
			ParsedTupleType,
		),
		ParsedTypeParamDecl,
		ParsedUnaryOp(ParsedNegateOp, ParsedNotOp),
		ParsedUnionDecl,
		ParsedVarDecl,
		ParsedVariantDecl,
		ParsedWithBinding,
		ParsedWithBindingKind(ParsedWithPlainBinding, ParsedWithTryBinding),
		ParsedWithErrorMap,


private KIND_FIELD: String = "kind"

PARSED_PROGRAM_KIND: String = "parsed_program"

PARSED_DECL_KIND_FUNCTION: String = "function"

private PARSED_DECL_KIND_VAR: String = "var"

private PARSED_DECL_KIND_IMPORT_BLOCK: String = "import_block"

private PARSED_DECL_KIND_FOREIGN_BLOCK: String = "foreign_block"

private PARSED_DECL_KIND_RECORD: String = "record"

private PARSED_DECL_KIND_UNION: String = "union"

private PARSED_DECL_KIND_BUILTIN_TYPE: String = "builtin_type"

private PARSED_DECL_KIND_TYPE_ALIAS: String = "type_alias"

private PARSED_DECL_KIND_TRAIT: String = "trait"

private PARSED_DECL_KIND_IMPL: String = "impl"

private PARSED_DECL_KIND_PRIVATE: String = "private"

private PARSED_DECL_KIND_ERROR: String = "error"


private pure func json_int(value: Int) -> JsonValue:
	JsonNumber(to_float(value))


private pure func option_string_to_json(value: Option[String]) -> JsonValue:
	match value:
		Some(text):
			JsonString(text)
		None:
			JsonNull


pure func parsed_source_span_to_json(span: SourceSpan) -> JsonValue:
	JsonObject([
		("path", JsonString(span.path)),
		("start_line", json_int(span.start_line)),
		("start_column", json_int(span.start_column)),
		("end_line", json_int(span.end_line)),
		("end_column", json_int(span.end_column)),
	])


private pure func optional_source_span_to_json(span: Option[SourceSpan]) -> JsonValue:
	match span:
		Some(value):
			parsed_source_span_to_json(value)
		None:
			JsonNull


pure func parsed_source_file_to_json(source: SourceFile) -> JsonValue:
	JsonObject([
		(KIND_FIELD, JsonString("source_file")),
		("path", JsonString(source.path)),
		("module", JsonString(source.module_name)),
	])


pure func parsed_identifier_to_json(identifier: ParsedIdentifier) -> JsonValue:
	JsonObject([
		("text", JsonString(identifier.text)),
		("span", parsed_source_span_to_json(identifier.span)),
	])


private pure func option_identifier_to_json(value: Option[ParsedIdentifier]) -> JsonValue:
	match value:
		Some(identifier):
			parsed_identifier_to_json(identifier)
		None:
			JsonNull


private pure func dim_binary_op_to_json(op: ParsedDimBinaryOp) -> JsonValue:
	match op:
		ParsedDimAddOp:
			JsonString("add")
		ParsedDimSubtractOp:
			JsonString("subtract")
		ParsedDimMultiplyOp:
			JsonString("multiply")
		ParsedDimDivideOp:
			JsonString("divide")


private pure func binary_op_to_json(op: ParsedBinaryOp) -> JsonValue:
	match op:
		ParsedAddOp:
			JsonString("add")
		ParsedSubtractOp:
			JsonString("subtract")
		ParsedMultiplyOp:
			JsonString("multiply")
		ParsedDivideOp:
			JsonString("divide")
		ParsedModuloOp:
			JsonString("modulo")
		ParsedEqualOp:
			JsonString("equal")
		ParsedNotEqualOp:
			JsonString("not_equal")
		ParsedLessOp:
			JsonString("less")
		ParsedLessEqualOp:
			JsonString("less_equal")
		ParsedGreaterOp:
			JsonString("greater")
		ParsedGreaterEqualOp:
			JsonString("greater_equal")


private pure func logical_op_to_json(op: ParsedLogicalOp) -> JsonValue:
	match op:
		ParsedAndOp:
			JsonString("and")
		ParsedOrOp:
			JsonString("or")


private pure func unary_op_to_json(op: ParsedUnaryOp) -> JsonValue:
	match op:
		ParsedNegateOp:
			JsonString("negate")
		ParsedNotOp:
			JsonString("not")


private pure func compound_assign_op_to_json(op: ParsedCompoundAssignOp) -> JsonValue:
	match op:
		ParsedAssignAddOp:
			JsonString("add")
		ParsedAssignSubtractOp:
			JsonString("subtract")
		ParsedAssignMultiplyOp:
			JsonString("multiply")
		ParsedAssignDivideOp:
			JsonString("divide")


private pure func string_literal_form_to_json(form: ParsedStringLiteralForm) -> JsonValue:
	match form:
		ParsedPlainStringLiteral:
			JsonString("plain")
		ParsedRawStringLiteral:
			JsonString("raw")
		ParsedPipeStringLiteral:
			JsonString("pipe")
		ParsedRawPipeStringLiteral:
			JsonString("raw_pipe")


private pure func function_annotation_to_json(annotation: ParsedFunctionAnnotation) -> JsonValue:
	match annotation:
		ParsedTailRecursiveAnnotation:
			JsonString("tail_recursive")
		ParsedNoCopyAnnotation:
			JsonString("no_copy")
		ParsedDebugOnlyAnnotation:
			JsonString("debug_only")
		ParsedResourceResultOrdinaryAnnotation:
			JsonString("resource_result_ordinary")


private pure func dim_constraint_to_json(constraint: ParsedDimConstraint) -> JsonValue:
	JsonObject([
		("left", parsed_type_expr_to_json(constraint.left)),
		("right", parsed_type_expr_to_json(constraint.right)),
		("span", parsed_source_span_to_json(constraint.span)),
	])


private pure func option_type_expr_to_json(value: Option[ParsedTypeExpr]) -> JsonValue:
	match value:
		Some(type_expr):
			parsed_type_expr_to_json(type_expr)
		None:
			JsonNull


private pure func parsed_for_binder_to_json(binder: ParsedForBinder) -> JsonValue:
	match binder:
		ParsedForNameBinder(name):
			JsonObject([
				(KIND_FIELD, JsonString("name")),
				("name", parsed_identifier_to_json(name)),
			])
		ParsedForTupleBinder(items, span):
			JsonObject([
				(KIND_FIELD, JsonString("tuple")),
				("items", JsonVector(items.map(parsed_identifier_to_json))),
				("span", parsed_source_span_to_json(span)),
			])


pure func parsed_type_expr_to_json(type_expr: ParsedTypeExpr) -> JsonValue:
	match type_expr:
		ParsedNamedType(name, args, span):
			JsonObject([
				(KIND_FIELD, JsonString("named")),
				("name", parsed_identifier_to_json(name)),
				("args", JsonVector(args.map(parsed_type_expr_to_json))),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedQualifiedNamedType(module_name, name, args, span):
			JsonObject([
				(KIND_FIELD, JsonString("qualified_named")),
				("module", parsed_identifier_to_json(module_name)),
				("name", parsed_identifier_to_json(name)),
				("args", JsonVector(args.map(parsed_type_expr_to_json))),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedBoundedType(name, bounds, span):
			JsonObject([
				(KIND_FIELD, JsonString("bounded")),
				("name", parsed_identifier_to_json(name)),
				("bounds", JsonVector(bounds.map(parsed_identifier_to_json))),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedDimNameType(name, is_variadic, span):
			JsonObject([
				(KIND_FIELD, JsonString("dim_name")),
				("name", parsed_identifier_to_json(name)),
				("is_variadic", JsonBool(is_variadic)),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedDimLiteralType(value, span):
			JsonObject([
				(KIND_FIELD, JsonString("dim_literal")),
				("value", JsonString(value)),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedDimBinaryType(op, left, right, span):
			JsonObject([
				(KIND_FIELD, JsonString("dim_binary")),
				("op", dim_binary_op_to_json(op)),
				("left", parsed_type_expr_to_json(left)),
				("right", parsed_type_expr_to_json(right)),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedRangeType(limit, span):
			JsonObject([
				(KIND_FIELD, JsonString("range")),
				("limit", parsed_type_expr_to_json(limit)),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedTupleType(items, span):
			JsonObject([
				(KIND_FIELD, JsonString("tuple")),
				("items", JsonVector(items.map(parsed_type_expr_to_json))),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedFunctionType(is_pure, params, return_type, span):
			JsonObject([
				(KIND_FIELD, JsonString("function")),
				("is_pure", JsonBool(is_pure)),
				("params", JsonVector(params.map(parsed_type_expr_to_json))),
				("return_type", parsed_type_expr_to_json(return_type)),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedArrayType(element, dims, span):
			JsonObject([
				(KIND_FIELD, JsonString("array")),
				("element", parsed_type_expr_to_json(element)),
				("dims", JsonVector(dims.map(parsed_type_expr_to_json))),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedMissingType(span):
			JsonObject([
				(KIND_FIELD, JsonString("missing")),
				("span", parsed_source_span_to_json(span)),
			])


pure func parsed_type_param_decl_to_json(param: ParsedTypeParamDecl) -> JsonValue:
	JsonObject([
		("name", parsed_identifier_to_json(param.name)),
		("bounds", JsonVector(param.bounds.map(parsed_identifier_to_json))),
		("span", parsed_source_span_to_json(param.span)),
	])


pure func parsed_param_binder_to_json(binder: ParsedParamBinder) -> JsonValue:
	match binder:
		ParsedParamNameBinder(name):
			JsonObject([
				(KIND_FIELD, JsonString("name")),
				("name", parsed_identifier_to_json(name)),
			])
		ParsedParamWildcardBinder(span):
			JsonObject([
				(KIND_FIELD, JsonString("wildcard")),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedParamTupleBinder(items, span):
			JsonObject([
				(KIND_FIELD, JsonString("tuple")),
				("items", JsonVector(items.map(parsed_identifier_to_json))),
				("span", parsed_source_span_to_json(span)),
			])


pure func parsed_param_to_json(param: ParsedParam) -> JsonValue:
	JsonObject([
		("binder", parsed_param_binder_to_json(param.binder)),
		("type", option_type_expr_to_json(param.type_expr)),
		("span", parsed_source_span_to_json(param.span)),
	])


pure func parsed_lambda_param_to_json(param: ParsedLambdaParam) -> JsonValue:
	JsonObject([
		("name", parsed_identifier_to_json(param.name)),
		("type", option_type_expr_to_json(param.type_expr)),
		("span", parsed_source_span_to_json(param.span)),
	])


pure func parsed_list_pattern_spread_to_json(spread: ParsedListPatternSpread) -> JsonValue:
	match spread:
		ParsedListSpreadName(name):
			JsonObject([
				(KIND_FIELD, JsonString("name")),
				("name", parsed_identifier_to_json(name)),
			])
		ParsedListSpreadWildcard(span):
			JsonObject([
				(KIND_FIELD, JsonString("wildcard")),
				("span", parsed_source_span_to_json(span)),
			])


private pure func option_list_pattern_spread_to_json(
	spread: Option[ParsedListPatternSpread],
) -> JsonValue:
	match spread:
		Some(value):
			parsed_list_pattern_spread_to_json(value)
		None:
			JsonNull


pure func parsed_pattern_to_json(pattern: ParsedPattern) -> JsonValue:
	match pattern:
		ParsedWildcardPattern(span):
			JsonObject([
				(KIND_FIELD, JsonString("wildcard")),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedNamePattern(name):
			JsonObject([
				(KIND_FIELD, JsonString("name")),
				("name", parsed_identifier_to_json(name)),
			])
		ParsedIntPattern(value, span):
			JsonObject([
				(KIND_FIELD, JsonString("int")),
				("value", JsonString(value)),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedFloatPattern(value, span):
			JsonObject([
				(KIND_FIELD, JsonString("float")),
				("value", JsonString(value)),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedStringPattern(value, form, span):
			JsonObject([
				(KIND_FIELD, JsonString("string")),
				("value", JsonString(value)),
				("form", string_literal_form_to_json(form)),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedCharPattern(value, span):
			JsonObject([
				(KIND_FIELD, JsonString("char")),
				("value", json_int(value)),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedBoolPattern(value, span):
			JsonObject([
				(KIND_FIELD, JsonString("bool")),
				("value", JsonBool(value)),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedConstructorPattern(name, args, span):
			JsonObject([
				(KIND_FIELD, JsonString("constructor")),
				("name", parsed_identifier_to_json(name)),
				("args", JsonVector(args.map(parsed_pattern_to_json))),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedQualifiedConstructorPattern(module_name, name, args, span):
			JsonObject([
				(KIND_FIELD, JsonString("qualified_constructor")),
				("module", parsed_identifier_to_json(module_name)),
				("name", parsed_identifier_to_json(name)),
				("args", JsonVector(args.map(parsed_pattern_to_json))),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedTuplePattern(items, span):
			JsonObject([
				(KIND_FIELD, JsonString("tuple")),
				("items", JsonVector(items.map(parsed_pattern_to_json))),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedListPattern(items, spread, span):
			JsonObject([
				(KIND_FIELD, JsonString("list")),
				("items", JsonVector(items.map(parsed_pattern_to_json))),
				("spread", option_list_pattern_spread_to_json(spread)),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedOrPattern(patterns, span):
			JsonObject([
				(KIND_FIELD, JsonString("or")),
				("patterns", JsonVector(patterns.map(parsed_pattern_to_json))),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedMissingPattern(span):
			JsonObject([
				(KIND_FIELD, JsonString("missing")),
				("span", parsed_source_span_to_json(span)),
			])


pure func parsed_match_case_to_json(match_case: ParsedMatchCase) -> JsonValue:
	JsonObject([
		("pattern", parsed_pattern_to_json(match_case.pattern)),
		("body", parsed_expr_to_json(match_case.body)),
		("span", parsed_source_span_to_json(match_case.span)),
	])


pure func parsed_select_arm_kind_to_json(kind: ParsedSelectArmKind) -> JsonValue:
	match kind:
		ParsedSelectReceiveArm(name, source):
			JsonObject([
				(KIND_FIELD, JsonString("receive")),
				("name", parsed_identifier_to_json(name)),
				("source", parsed_expr_to_json(source)),
			])
		ParsedSelectSealedArm(source):
			JsonObject([
				(KIND_FIELD, JsonString("sealed")),
				("source", parsed_expr_to_json(source)),
			])
		ParsedSelectAfterArm(source):
			JsonObject([
				(KIND_FIELD, JsonString("after")),
				("source", parsed_expr_to_json(source)),
			])


pure func parsed_select_arm_to_json(arm: ParsedSelectArm) -> JsonValue:
	JsonObject([
		("kind", parsed_select_arm_kind_to_json(arm.kind)),
		("body", parsed_expr_to_json(arm.body)),
		("span", parsed_source_span_to_json(arm.span)),
	])


pure func parsed_record_expr_field_to_json(field: ParsedRecordExprField) -> JsonValue:
	JsonObject([
		("name", parsed_identifier_to_json(field.name)),
		("value", parsed_expr_to_json(field.value)),
		("span", parsed_source_span_to_json(field.span)),
	])


pure func parsed_dict_entry_to_json(entry: ParsedDictEntry) -> JsonValue:
	JsonObject([
		("key", parsed_expr_to_json(entry.key)),
		("value", parsed_expr_to_json(entry.value)),
		("span", parsed_source_span_to_json(entry.span)),
	])


pure func parsed_concurrent_param_to_json(param: ParsedConcurrentParam) -> JsonValue:
	JsonObject([
		("name", parsed_identifier_to_json(param.name)),
		("value", parsed_expr_to_json(param.value)),
		("span", parsed_source_span_to_json(param.span)),
	])


private pure func with_binding_kind_to_json(kind: ParsedWithBindingKind) -> JsonValue:
	match kind:
		ParsedWithPlainBinding:
			JsonString("plain")
		ParsedWithTryBinding:
			JsonString("try")


pure func parsed_with_error_map_to_json(error_map: ParsedWithErrorMap) -> JsonValue:
	JsonObject([
		("name", parsed_identifier_to_json(error_map.name)),
		("value", parsed_expr_to_json(error_map.value)),
		("span", parsed_source_span_to_json(error_map.span)),
	])


private pure func option_with_error_map_to_json(value: Option[ParsedWithErrorMap]) -> JsonValue:
	match value:
		Some(error_map):
			parsed_with_error_map_to_json(error_map)
		None:
			JsonNull


pure func parsed_with_binding_to_json(binding: ParsedWithBinding) -> JsonValue:
	JsonObject([
		("name", parsed_identifier_to_json(binding.name)),
		("type", option_type_expr_to_json(binding.type_expr)),
		("value", parsed_expr_to_json(binding.value)),
		("kind", with_binding_kind_to_json(binding.kind)),
		("error_map", option_with_error_map_to_json(binding.error_map)),
		("span", parsed_source_span_to_json(binding.span)),
	])


private pure func option_expr_to_json(value: Option[ParsedExpr]) -> JsonValue:
	match value:
		Some(expr):
			parsed_expr_to_json(expr)
		None:
			JsonNull


private pure func parsed_string_interpolation_part_to_json(
	part: ParsedStringInterpolationPart,
) -> JsonValue:
	match part:
		ParsedInterpolationLiteral(value):
			JsonObject([
				(KIND_FIELD, JsonString("literal")),
				("value", JsonString(value)),
			])
		ParsedInterpolationExpr(expr):
			JsonObject([
				(KIND_FIELD, JsonString("expr")),
				("expr", parsed_expr_to_json(expr)),
			])


pure func parsed_expr_to_json(expr: ParsedExpr) -> JsonValue:
	match expr:
		ParsedNameExpr(name):
			JsonObject([
				(KIND_FIELD, JsonString("name")),
				("name", parsed_identifier_to_json(name)),
			])
		ParsedIntLiteralExpr(value, span):
			JsonObject([
				(KIND_FIELD, JsonString("int_literal")),
				("value", JsonString(value)),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedFloatLiteralExpr(value, span):
			JsonObject([
				(KIND_FIELD, JsonString("float_literal")),
				("value", JsonString(value)),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedStringLiteralExpr(value, form, span):
			JsonObject([
				(KIND_FIELD, JsonString("string_literal")),
				("value", JsonString(value)),
				("form", string_literal_form_to_json(form)),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedStringInterpolationExpr(value, is_multiline, span):
			JsonObject([
				(KIND_FIELD, JsonString("string_interp_raw")),
				("value", JsonString(value)),
				("multiline", JsonBool(is_multiline)),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedStringInterpolationPartsExpr(parts, is_multiline, span):
			JsonObject([
				(KIND_FIELD, JsonString("string_interp")),
				("parts", JsonVector(parts.map(parsed_string_interpolation_part_to_json))),
				("multiline", JsonBool(is_multiline)),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedBoolLiteralExpr(value, span):
			JsonObject([
				(KIND_FIELD, JsonString("bool_literal")),
				("value", JsonBool(value)),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedCharLiteralExpr(value, span):
			JsonObject([
				(KIND_FIELD, JsonString("char_literal")),
				("value", json_int(value)),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedUnaryExpr(op, value, span):
			JsonObject([
				(KIND_FIELD, JsonString("unary")),
				("op", unary_op_to_json(op)),
				("value", parsed_expr_to_json(value)),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedBinaryExpr(op, left, right, span):
			JsonObject([
				(KIND_FIELD, JsonString("binary")),
				("op", binary_op_to_json(op)),
				("left", parsed_expr_to_json(left)),
				("right", parsed_expr_to_json(right)),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedLogicalExpr(op, left, right, span):
			JsonObject([
				(KIND_FIELD, JsonString("logical")),
				("op", logical_op_to_json(op)),
				("left", parsed_expr_to_json(left)),
				("right", parsed_expr_to_json(right)),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedAscriptionExpr(value, type_expr, span):
			JsonObject([
				(KIND_FIELD, JsonString("ascription")),
				("value", parsed_expr_to_json(value)),
				("type", parsed_type_expr_to_json(type_expr)),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedRangeExpr(start, finish, span):
			JsonObject([
				(KIND_FIELD, JsonString("range")),
				("start", parsed_expr_to_json(start)),
				("finish", parsed_expr_to_json(finish)),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedCallExpr(callee, args, span):
			JsonObject([
				(KIND_FIELD, JsonString("call")),
				("callee", parsed_expr_to_json(callee)),
				("args", JsonVector(args.map(parsed_expr_to_json))),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedFieldAccessExpr(target, field, span):
			JsonObject([
				(KIND_FIELD, JsonString("field_access")),
				("target", parsed_expr_to_json(target)),
				("field", parsed_identifier_to_json(field)),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedSubscriptExpr(target, indices, span):
			JsonObject([
				(KIND_FIELD, JsonString("subscript")),
				("target", parsed_expr_to_json(target)),
				("indices", JsonVector(indices.map(parsed_expr_to_json))),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedSubscriptAssignExpr(target, indices, value, span):
			JsonObject([
				(KIND_FIELD, JsonString("subscript_assign")),
				("target", parsed_expr_to_json(target)),
				("indices", JsonVector(indices.map(parsed_expr_to_json))),
				("value", parsed_expr_to_json(value)),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedListExpr(items, span):
			JsonObject([
				(KIND_FIELD, JsonString("list")),
				("items", JsonVector(items.map(parsed_expr_to_json))),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedTupleExpr(items, span):
			JsonObject([
				(KIND_FIELD, JsonString("tuple")),
				("items", JsonVector(items.map(parsed_expr_to_json))),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedRecordExpr(fields, span):
			JsonObject([
				(KIND_FIELD, JsonString("record")),
				("fields", JsonVector(fields.map(parsed_record_expr_field_to_json))),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedRecordUpdateExpr(base, fields, span):
			JsonObject([
				(KIND_FIELD, JsonString("record_update")),
				("base", parsed_expr_to_json(base)),
				("fields", JsonVector(fields.map(parsed_record_expr_field_to_json))),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedDictExpr(entries, span):
			JsonObject([
				(KIND_FIELD, JsonString("dict")),
				("entries", JsonVector(entries.map(parsed_dict_entry_to_json))),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedVectorExpr(items, span):
			JsonObject([
				(KIND_FIELD, JsonString("vector")),
				("items", JsonVector(items.map(parsed_expr_to_json))),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedOpaqueIntoExpr(type_expr, value, span):
			JsonObject([
				(KIND_FIELD, JsonString("opaque_into")),
				("type", parsed_type_expr_to_json(type_expr)),
				("value", parsed_expr_to_json(value)),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedOpaqueFromExpr(type_expr, value, span):
			JsonObject([
				(KIND_FIELD, JsonString("opaque_from")),
				("type", parsed_type_expr_to_json(type_expr)),
				("value", parsed_expr_to_json(value)),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedBlockExpr(items, span):
			JsonObject([
				(KIND_FIELD, JsonString("block")),
				("items", JsonVector(items.map(parsed_expr_to_json))),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedIfExpr(cond, then_expr, else_expr, span):
			JsonObject([
				(KIND_FIELD, JsonString("if")),
				("condition", parsed_expr_to_json(cond)),
				("then", parsed_expr_to_json(then_expr)),
				("else", option_expr_to_json(else_expr)),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedMatchExpr(value, cases, span):
			JsonObject([
				(KIND_FIELD, JsonString("match")),
				("value", parsed_expr_to_json(value)),
				("cases", JsonVector(cases.map(parsed_match_case_to_json))),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedSelectExpr(arms, span):
			JsonObject([
				(KIND_FIELD, JsonString("select")),
				("arms", JsonVector(arms.map(parsed_select_arm_to_json))),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedWithExpr(binding, body, span):
			JsonObject([
				(KIND_FIELD, JsonString("with")),
				("binding", parsed_with_binding_to_json(binding)),
				("body", parsed_expr_to_json(body)),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedDebugBlockExpr(body, span):
			JsonObject([
				(KIND_FIELD, JsonString("debug_block")),
				("body", parsed_expr_to_json(body)),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedLambdaExpr(is_pure, params, return_type, body, span):
			JsonObject([
				(KIND_FIELD, JsonString("lambda")),
				("is_pure", JsonBool(is_pure)),
				("params", JsonVector(params.map(parsed_lambda_param_to_json))),
				("return_type", option_type_expr_to_json(return_type)),
				("body", parsed_expr_to_json(body)),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedFunctionDeclExpr(function_decl):
			JsonObject([
				(KIND_FIELD, JsonString("function_decl")),
				("function", parsed_function_decl_to_json(function_decl)),
				("span", parsed_source_span_to_json(function_decl.span)),
			])
		ParsedWhileExpr(cond, body, span):
			JsonObject([
				(KIND_FIELD, JsonString("while")),
				("condition", parsed_expr_to_json(cond)),
				("body", parsed_expr_to_json(body)),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedForExpr(binder, iterable, body, span):
			JsonObject([
				(KIND_FIELD, JsonString("for")),
				("binder", parsed_for_binder_to_json(binder)),
				("iterable", parsed_expr_to_json(iterable)),
				("body", parsed_expr_to_json(body)),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedConcurrentBlockExpr(params, body, span):
			JsonObject([
				(KIND_FIELD, JsonString("concurrent_block")),
				("params", JsonVector(params.map(parsed_concurrent_param_to_json))),
				("body", parsed_expr_to_json(body)),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedConcurrentForExpr(name, iterable, params, body, span):
			JsonObject([
				(KIND_FIELD, JsonString("concurrent_for")),
				("name", parsed_identifier_to_json(name)),
				("iterable", parsed_expr_to_json(iterable)),
				("params", JsonVector(params.map(parsed_concurrent_param_to_json))),
				("body", parsed_expr_to_json(body)),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedDetachExpr(body, span):
			JsonObject([
				(KIND_FIELD, JsonString("detach")),
				("body", parsed_expr_to_json(body)),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedBreakExpr(span):
			JsonObject([
				(KIND_FIELD, JsonString("break")),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedContinueExpr(span):
			JsonObject([
				(KIND_FIELD, JsonString("continue")),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedVoidExpr(span):
			JsonObject([
				(KIND_FIELD, JsonString("void")),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedBuiltinExpr(name, span):
			JsonObject([
				(KIND_FIELD, JsonString("builtin")),
				("name", option_string_to_json(name)),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedVarDeclExpr(name, type_expr, value, is_mutable, span):
			JsonObject([
				(KIND_FIELD, JsonString("var_decl")),
				("name", parsed_identifier_to_json(name)),
				("type", option_type_expr_to_json(type_expr)),
				("value", parsed_expr_to_json(value)),
				("is_mutable", JsonBool(is_mutable)),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedAssignExpr(name, value, span):
			JsonObject([
				(KIND_FIELD, JsonString("assign")),
				("name", parsed_identifier_to_json(name)),
				("value", parsed_expr_to_json(value)),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedCompoundAssignExpr(name, op, value, span):
			JsonObject([
				(KIND_FIELD, JsonString("compound_assign")),
				("name", parsed_identifier_to_json(name)),
				("op", compound_assign_op_to_json(op)),
				("value", parsed_expr_to_json(value)),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedTupleDestructExpr(names, value, span):
			JsonObject([
				(KIND_FIELD, JsonString("tuple_destruct")),
				("names", JsonVector(names.map(parsed_identifier_to_json))),
				("value", parsed_expr_to_json(value)),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedQuestionBindExpr(name, type_expr, value, span):
			JsonObject([
				(KIND_FIELD, JsonString("question_bind")),
				("name", parsed_identifier_to_json(name)),
				("type", option_type_expr_to_json(type_expr)),
				("value", parsed_expr_to_json(value)),
				("span", parsed_source_span_to_json(span)),
			])
		ParsedMissingExpr(span):
			JsonObject([
				(KIND_FIELD, JsonString("missing")),
				("span", parsed_source_span_to_json(span)),
			])


pure func parsed_function_decl_to_json(decl: ParsedFunctionDecl) -> JsonValue:
	JsonObject([
		("name", parsed_identifier_to_json(decl.name)),
		("keyword_span", optional_source_span_to_json(decl.keyword_span)),
		("type_params", JsonVector(decl.type_params.map(parsed_type_param_decl_to_json))),
		("params", JsonVector(decl.params.map(parsed_param_to_json))),
		("return_type", option_type_expr_to_json(decl.return_type)),
		("dim_constraints", JsonVector(decl.dim_constraints.map(dim_constraint_to_json))),
		("body", option_expr_to_json(decl.body)),
		("is_pure", JsonBool(decl.is_pure)),
		("annotations", JsonVector(decl.annotations.map(function_annotation_to_json))),
		("doc", option_string_to_json(decl.doc)),
		("span", parsed_source_span_to_json(decl.span)),
	])


pure func parsed_var_decl_to_json(decl: ParsedVarDecl) -> JsonValue:
	JsonObject([
		("name", parsed_identifier_to_json(decl.name)),
		("type", option_type_expr_to_json(decl.type_expr)),
		("value", parsed_expr_to_json(decl.value)),
		("is_mutable", JsonBool(decl.is_mutable)),
		("span", parsed_source_span_to_json(decl.span)),
	])


pure func parsed_import_symbol_to_json(symbol: ParsedImportSymbol) -> JsonValue:
	JsonObject([
		("name", parsed_identifier_to_json(symbol.name)),
		("alias", option_identifier_to_json(symbol.symbol_alias)),
		("constructors", JsonVector(symbol.constructors.map(parsed_identifier_to_json))),
		("span", parsed_source_span_to_json(symbol.span)),
	])


private pure func option_import_symbols_to_json(
	value: Option[List[ParsedImportSymbol]],
) -> JsonValue:
	match value:
		Some(symbols):
			JsonVector(symbols.map(parsed_import_symbol_to_json))
		None:
			JsonNull


pure func parsed_import_decl_to_json(decl: ParsedImportDecl) -> JsonValue:
	JsonObject([
		("module_path", JsonString(decl.module_path)),
		("module_path_span", parsed_source_span_to_json(decl.module_path_span)),
		("module_alias", option_identifier_to_json(decl.module_alias)),
		("symbols", option_import_symbols_to_json(decl.symbols)),
		("span", parsed_source_span_to_json(decl.span)),
	])


pure func parsed_foreign_block_arg_to_json(arg: ParsedForeignBlockArg) -> JsonValue:
	JsonObject([
		("name", parsed_identifier_to_json(arg.name)),
		("value", JsonString(arg.value)),
		("span", parsed_source_span_to_json(arg.span)),
	])


pure func parsed_foreign_function_decl_to_json(decl: ParsedForeignFunctionDecl) -> JsonValue:
	JsonObject([
		("name", parsed_identifier_to_json(decl.name)),
		("params", JsonVector(decl.params.map(parsed_param_to_json))),
		("return_type", parsed_type_expr_to_json(decl.return_type)),
		("c_name", option_string_to_json(decl.c_name)),
		("is_pure", JsonBool(decl.is_pure)),
		("is_private", JsonBool(decl.is_private)),
		("annotations", JsonVector(decl.annotations.map(function_annotation_to_json))),
		("span", parsed_source_span_to_json(decl.span)),
	])


pure func parsed_field_decl_to_json(field: ParsedFieldDecl) -> JsonValue:
	JsonObject([
		("name", parsed_identifier_to_json(field.name)),
		("type", parsed_type_expr_to_json(field.type_expr)),
		("span", parsed_source_span_to_json(field.span)),
	])


pure func parsed_record_decl_to_json(decl: ParsedRecordDecl) -> JsonValue:
	JsonObject([
		("name", parsed_identifier_to_json(decl.name)),
		("type_params", JsonVector(decl.type_params.map(parsed_type_param_decl_to_json))),
		("fields", JsonVector(decl.fields.map(parsed_field_decl_to_json))),
		("is_struct", JsonBool(decl.is_struct)),
		("doc", option_string_to_json(decl.doc)),
		("span", parsed_source_span_to_json(decl.span)),
	])


pure func parsed_variant_decl_to_json(variant: ParsedVariantDecl) -> JsonValue:
	JsonObject([
		("name", parsed_identifier_to_json(variant.name)),
		("fields", JsonVector(variant.fields.map(parsed_type_expr_to_json))),
		("span", parsed_source_span_to_json(variant.span)),
	])


pure func parsed_union_decl_to_json(decl: ParsedUnionDecl) -> JsonValue:
	JsonObject([
		("name", parsed_identifier_to_json(decl.name)),
		("type_params", JsonVector(decl.type_params.map(parsed_type_param_decl_to_json))),
		("variants", JsonVector(decl.variants.map(parsed_variant_decl_to_json))),
		("is_enum", JsonBool(decl.is_enum)),
		("doc", option_string_to_json(decl.doc)),
		("span", parsed_source_span_to_json(decl.span)),
	])


pure func parsed_resource_cleanup_to_json(cleanup: ParsedResourceCleanup) -> JsonValue:
	JsonObject([
		(KIND_FIELD, JsonString("builtin")),
		("name", JsonString(cleanup.builtin_name)),
		("span", parsed_source_span_to_json(cleanup.span)),
	])


private pure func option_resource_cleanup_to_json(
	value: Option[ParsedResourceCleanup],
) -> JsonValue:
	match value:
		Some(cleanup):
			parsed_resource_cleanup_to_json(cleanup)
		None:
			JsonNull


pure func parsed_builtin_type_decl_to_json(decl: ParsedBuiltinTypeDecl) -> JsonValue:
	JsonObject([
		("name", parsed_identifier_to_json(decl.name)),
		("type_params", JsonVector(decl.type_params.map(parsed_type_param_decl_to_json))),
		("is_resource", JsonBool(decl.is_resource)),
		("cleanup", option_resource_cleanup_to_json(decl.cleanup)),
		("doc", option_string_to_json(decl.doc)),
		("span", parsed_source_span_to_json(decl.span)),
	])


pure func parsed_type_alias_decl_to_json(decl: ParsedTypeAliasDecl) -> JsonValue:
	JsonObject([
		("name", parsed_identifier_to_json(decl.name)),
		("type_params", JsonVector(decl.type_params.map(parsed_type_param_decl_to_json))),
		("target", parsed_type_expr_to_json(decl.target)),
		("is_opaque", JsonBool(decl.is_opaque)),
		("doc", option_string_to_json(decl.doc)),
		("span", parsed_source_span_to_json(decl.span)),
	])


pure func parsed_trait_method_decl_to_json(decl: ParsedTraitMethodDecl) -> JsonValue:
	JsonObject([
		("name", parsed_identifier_to_json(decl.name)),
		("params", JsonVector(decl.params.map(parsed_param_to_json))),
		("return_type", option_type_expr_to_json(decl.return_type)),
		("body", option_expr_to_json(decl.body)),
		("is_pure", JsonBool(decl.is_pure)),
		("span", parsed_source_span_to_json(decl.span)),
	])


pure func parsed_trait_decl_to_json(decl: ParsedTraitDecl) -> JsonValue:
	JsonObject([
		("name", parsed_identifier_to_json(decl.name)),
		("type_params", JsonVector(decl.type_params.map(parsed_type_param_decl_to_json))),
		("supertraits", JsonVector(decl.supertraits.map(parsed_identifier_to_json))),
		("methods", JsonVector(decl.methods.map(parsed_trait_method_decl_to_json))),
		("doc", option_string_to_json(decl.doc)),
		("span", parsed_source_span_to_json(decl.span)),
	])


pure func parsed_impl_decl_to_json(decl: ParsedImplDecl) -> JsonValue:
	JsonObject([
		("trait_name", parsed_identifier_to_json(decl.trait_name)),
		("for_type", parsed_type_expr_to_json(decl.for_type)),
		("methods", JsonVector(decl.methods.map(parsed_function_decl_to_json))),
		("doc", option_string_to_json(decl.doc)),
		("span", parsed_source_span_to_json(decl.span)),
	])


private pure func with_kind(fields: List[(String, JsonValue)], kind: String) -> JsonValue:
	var result: List[(String, JsonValue)] = [(KIND_FIELD, JsonString(kind))]

	for field in fields:
		result = result.append(field)

	JsonObject(result)


pure func parsed_decl_to_json(decl: ParsedDecl) -> JsonValue:
	match decl:
		FunctionParsedDecl(function_decl):
			with_kind(
				[
					("name", JsonString(function_decl.name.text)),
					("function", parsed_function_decl_to_json(function_decl)),
				],
				PARSED_DECL_KIND_FUNCTION,
			)
		VarParsedDecl(var_decl):
			with_kind(
				[
					("name", JsonString(var_decl.name.text)),
					("var", parsed_var_decl_to_json(var_decl)),
				],
				PARSED_DECL_KIND_VAR,
			)
		ImportBlockParsedDecl(imports, span):
			with_kind(
				[
					("imports", JsonVector(imports.map(parsed_import_decl_to_json))),
					("span", parsed_source_span_to_json(span)),
				],
				PARSED_DECL_KIND_IMPORT_BLOCK,
			)
		ForeignBlockParsedDecl(args, functions, span):
			with_kind(
				[
					("args", JsonVector(args.map(parsed_foreign_block_arg_to_json))),
					("functions", JsonVector(functions.map(parsed_foreign_function_decl_to_json))),
					("span", parsed_source_span_to_json(span)),
				],
				PARSED_DECL_KIND_FOREIGN_BLOCK,
			)
		RecordParsedDecl(record_decl):
			with_kind(
				[
					("name", JsonString(record_decl.name.text)),
					("record", parsed_record_decl_to_json(record_decl)),
				],
				PARSED_DECL_KIND_RECORD,
			)
		UnionParsedDecl(union_decl):
			with_kind(
				[
					("name", JsonString(union_decl.name.text)),
					("union", parsed_union_decl_to_json(union_decl)),
				],
				PARSED_DECL_KIND_UNION,
			)
		BuiltinTypeParsedDecl(type_decl):
			with_kind(
				[
					("name", JsonString(type_decl.name.text)),
					("type", parsed_builtin_type_decl_to_json(type_decl)),
				],
				PARSED_DECL_KIND_BUILTIN_TYPE,
			)
		TypeAliasParsedDecl(type_alias):
			with_kind(
				[
					("name", JsonString(type_alias.name.text)),
					("alias", parsed_type_alias_decl_to_json(type_alias)),
				],
				PARSED_DECL_KIND_TYPE_ALIAS,
			)
		TraitParsedDecl(trait_decl):
			with_kind(
				[
					("name", JsonString(trait_decl.name.text)),
					("trait", parsed_trait_decl_to_json(trait_decl)),
				],
				PARSED_DECL_KIND_TRAIT,
			)
		ImplParsedDecl(impl_decl):
			with_kind([("impl", parsed_impl_decl_to_json(impl_decl))], PARSED_DECL_KIND_IMPL)
		PrivateParsedDecl(inner, span):
			with_kind(
				[("decl", parsed_decl_to_json(inner)), ("span", parsed_source_span_to_json(span))],
				PARSED_DECL_KIND_PRIVATE,
			)
		ParsedErrorDecl(span):
			with_kind([("span", parsed_source_span_to_json(span))], PARSED_DECL_KIND_ERROR)


private pure func diagnostic_severity_to_json(severity: ParseDiagnosticSeverity) -> JsonValue:
	match severity:
		ParseErrorSeverity:
			JsonString("error")
		ParseWarningSeverity:
			JsonString("warning")


pure func parse_diagnostic_to_json(diagnostic: ParseDiagnostic) -> JsonValue:
	JsonObject([
		("severity", diagnostic_severity_to_json(diagnostic.severity)),
		("span", parsed_source_span_to_json(diagnostic.span)),
		("message", JsonString(diagnostic.message)),
		("expected", JsonVector(diagnostic.expected.map(
				func(item: String): JsonString(item),
			))),
		("help", option_string_to_json(diagnostic.help)),
	])


pure func parsed_program_to_json(program: ParsedProgram) -> JsonValue:
	JsonObject([
		(KIND_FIELD, JsonString(PARSED_PROGRAM_KIND)),
		("source", parsed_source_file_to_json(program.source)),
		("decls", JsonVector(program.decls.map(parsed_decl_to_json))),
		("diagnostics", JsonVector(program.diagnostics.map(parse_diagnostic_to_json))),
	])


-- ParsedProgram intentionally does not claim generic Equatable support. This
-- exact comparison is reserved for cold compiler-boundary checks that must
-- include resolved import rewrites as well as source identity. The JSON
-- projection is complete and deterministic, so it is the canonical structural
-- form until the parsed phase owns a dedicated comparison representation.
pure func parsed_programs_are_equal(left: ParsedProgram, right: ParsedProgram) -> Bool:
	parsed_program_to_json(left).to_string() == parsed_program_to_json(right).to_string()
