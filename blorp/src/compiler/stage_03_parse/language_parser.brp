private enum TupleBinderIdentifierMode:
	TupleBinderNamesOnly
	TupleBinderNamesOrUnderscore


private enum AggregateDeclarationSyntax:
	RecordDeclarationSyntax
	StructDeclarationSyntax


private enum InfixOpTag:
	InfixOrOp
	InfixAndOp
	InfixEqualOp
	InfixNotEqualOp
	InfixLessOp
	InfixLessEqualOp
	InfixGreaterOp
	InfixGreaterEqualOp
	InfixRangeOp
	InfixAddOp
	InfixSubtractOp
	InfixMultiplyOp
	InfixDivideOp
	InfixModuloOp


private struct ParsedInfixInfo {
	precedence: Int,
	tag: InfixOpTag
}


private pure func initial_state(source: SourceFile, tokens: List[Token]) -> ParserInput:
	{
		source = source,
		tokens = tokens
	}


private pure func eof_token(source: SourceFile) -> Token:
	cursor = source_cursor_at(source, source.text.length())
	token(
		EndOfFileToken,
		source_empty_span(source, cursor),
	)


private pure func current_token(state: ParserInput, index: Int) -> Token:
	match state.tokens.get(index):
		Some(token):
			token
		None:
			eof_token(state.source)


private pure func token_at(state: ParserInput, index: Int) -> Token:
	match state.tokens.get(index):
		Some(token):
			token
		None:
			eof_token(state.source)


private pure func current_token_kind(state: ParserInput, index: Int) -> TokenKind:
	match state.tokens.get(index):
		Some(token):
			token.kind
		None:
			EndOfFileToken


private pure func token_kind_at(state: ParserInput, index: Int) -> TokenKind:
	match state.tokens.get(index):
		Some(token):
			token.kind
		None:
			EndOfFileToken


private pure func current_span(state: ParserInput, index: Int) -> SourceSpan:
	current_token(state, index).span


private pure func span_cover(start_span: SourceSpan, end_span: SourceSpan) -> SourceSpan:
	{
		path = start_span.path,
		module_name = start_span.module_name,
		start_offset = start_span.start_offset,
		start_line = start_span.start_line,
		start_column = start_span.start_column,
		end_offset = end_span.end_offset,
		end_line = end_span.end_line,
		end_column = end_span.end_column
	}


private pure func add_expected_error(
	diagnostics: List[ParseDiagnostic],
	span: SourceSpan,
	message: String,
	expected: List[String],
	help: Option[String],
) -> List[ParseDiagnostic]:
	diagnostics.append(parse_error_expected(span, message, expected, help))


private pure func current_is_eof(state: ParserInput, index: Int) -> Bool:
	match current_token_kind(state, index):
		EndOfFileToken:
			True
		_:
			False


private pure func advance_parser(state: ParserInput, index: Int) -> Int:
	if current_is_eof(state, index):
		index
	else:
		index + 1


private pure func current_is_newline(state: ParserInput, index: Int) -> Bool:
	match current_token_kind(state, index):
		NewlineToken:
			True
		_:
			False


private pure func current_is_indent(state: ParserInput, index: Int) -> Bool:
	match current_token_kind(state, index):
		IndentToken:
			True
		_:
			False


private pure func current_is_dedent(state: ParserInput, index: Int) -> Bool:
	match current_token_kind(state, index):
		DedentToken:
			True
		_:
			False


private pure func skip_newlines(state: ParserInput, index: Int) -> Int:
	var st: Int = index

	while current_is_newline(state, st):
		st = advance_parser(state, st)

	st


private pure func current_is_keyword(state: ParserInput, index: Int, expected: Keyword) -> Bool:
	match current_token_kind(state, index):
		KeywordToken(actual):
			actual == expected
		_:
			False


private pure func next_is_keyword(state: ParserInput, index: Int, expected: Keyword) -> Bool:
	match token_kind_at(state, index + 1):
		KeywordToken(actual):
			actual == expected
		_:
			False


private pure func current_is_symbol(state: ParserInput, index: Int, expected: Symbol) -> Bool:
	match current_token_kind(state, index):
		SymbolToken(actual):
			actual == expected
		_:
			False


private pure func token_kind_is_symbol(kind: TokenKind, expected: Symbol) -> Bool:
	match kind:
		SymbolToken(actual):
			actual == expected
		_:
			False


---
Whether a token can name one element of a tuple destructuring target.

A reserved keyword counts as a binder name here so `(alias, rest) = pair`
reaches the binder parser and reports the reserved-keyword rule instead of
failing as a tuple expression.
---
private pure func token_kind_is_tuple_binder_name(kind: TokenKind) -> Bool:
	match kind:
		IdentifierToken(_):
			True
		SymbolToken(UnderscoreSymbol):
			True
		KeywordToken(keyword):
			keyword_is_reserved_name(keyword)
		_:
			False


private pure func parsed_function_annotation_from_name(
	name: String,
) -> Option[ParsedFunctionAnnotation]:
	match name:
		"tail_recursive":
			Some(ParsedTailRecursiveAnnotation)
		"no_copy":
			Some(ParsedNoCopyAnnotation)
		"debug_only":
			Some(ParsedDebugOnlyAnnotation)
		"resource_result_ordinary":
			Some(ParsedResourceResultOrdinaryAnnotation)
		_:
			None


private pure func add_unknown_function_annotation_error(
	diagnostics: List[ParseDiagnostic],
	span: SourceSpan,
	name: String,
) -> List[ParseDiagnostic]:
	add_expected_error(
		diagnostics,
		span,
		"unknown function annotation `@${name}`",
		["@tail_recursive", "@debug_only", "@no_copy", "@resource_result_ordinary"],
		Some("use one of the known function annotations, or remove the annotation"),
	)


private pure func consume_annotation_argument_list(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParserStep:
	var st: Int = index
	var st_diag: List[ParseDiagnostic] = add_expected_error(
		diagnostics,
		current_span(state, index),
		"function annotations do not take arguments",
		[],
		Some("remove the argument list from the function annotation"),
	)

	st = advance_parser(state, st)

	while (
		not current_is_eof(state, st)
		and not current_is_newline(state, st)
		and not current_is_symbol(state, st, RightParenSymbol)
	):
		st = advance_parser(state, st)

	if current_is_symbol(state, st, RightParenSymbol):
		{
			index = advance_parser(state, st),
			diagnostics = st_diag
		}
	else:
		{
			index = st,
			diagnostics = st_diag
		}


private pure func parse_function_annotations(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	allow_newlines: Bool,
) -> ParseFunctionAnnotationsStep:
	var st: Int = index
	var st_diag: List[ParseDiagnostic] = diagnostics
	var values: List[ParsedFunctionAnnotation] = []

	while current_is_symbol(state, st, AtSymbol):
		st = advance_parser(state, st)
		name_step: ParseIdentifierStep = parse_identifier_expected(
			state,
			st,
			st_diag,
			EXPECTED_FUNCTION_ANNOTATION,
		)
		st = name_step.index
		st_diag = name_step.diagnostics

		match parsed_function_annotation_from_name(name_step.value.text):
			Some(annotation):
				values = values.append(annotation)
			None:
				st_diag = add_unknown_function_annotation_error(
					st_diag,
					name_step.value.span,
					name_step.value.text,
				)

		if current_is_symbol(state, st, LeftParenSymbol):
			__step_1: ParserStep = consume_annotation_argument_list(state, st, st_diag)
			st = __step_1.index
			st_diag = __step_1.diagnostics

		if allow_newlines and current_is_newline(state, st):
			st = skip_newlines(state, st)

	{
		index = st,
		diagnostics = st_diag,
		values = values
	}


private pure func current_is_soft_boundary(state: ParserInput, index: Int) -> Bool:
	if (
		current_is_eof(state, index)
		or current_is_newline(state, index)
		or current_is_dedent(state, index)
	):
		True
	else:
		match current_token_kind(state, index):
			SymbolToken(ColonSymbol):
				True
			SymbolToken(CommaSymbol):
				True
			SymbolToken(LeftParenSymbol):
				True
			SymbolToken(RightBracketSymbol):
				True
			SymbolToken(RightParenSymbol):
				True
			_:
				False


private pure func expect_symbol(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	symbol: Symbol,
	message: String,
) -> ParseSymbolStep:
	span: SourceSpan = current_span(state, index)

	if current_is_symbol(state, index, symbol):
		{
			index = advance_parser(state, index),
			diagnostics = diagnostics,
			matched = True,
			span = span
		}
	else:
		{
			index = index,
			diagnostics = add_expected_error(
				diagnostics,
				span,
				message,
				[symbol_text(symbol)],
				None,
			),
			matched = False,
			span = span
		}


private pure func expect_newline(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	message: String,
) -> ParserStep:
	if current_is_newline(state, index):
		{
			index = advance_parser(state, index),
			diagnostics = diagnostics
		}
	else:
		{
			index = index,
			diagnostics = add_expected_error(
				diagnostics,
				current_span(state, index),
				message,
				["newline"],
				None,
			)
		}


private pure func expect_keyword(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	keyword: Keyword,
	expected: String,
	message: String,
) -> ParserStep:
	if current_is_keyword(state, index, keyword):
		{
			index = advance_parser(state, index),
			diagnostics = diagnostics
		}
	else:
		{
			index = index,
			diagnostics = add_expected_error(
				diagnostics,
				current_span(state, index),
				message,
				[expected],
				None,
			)
		}


private pure func current_is_block_end(state: ParserInput, index: Int) -> Bool:
	current_is_eof(state, index) or current_is_dedent(state, index)


private pure func type_keyword_identifier_text(state: ParserInput, index: Int) -> Option[String]:
	match current_token_kind(state, index):
		KeywordToken(SelfKeyword):
			Some("Self")
		KeywordToken(VoidKeyword):
			Some("void")
		_:
			None


private pure func soft_keyword_identifier_text(keyword: Keyword) -> Option[String]:
	match keyword:
		DebugKeyword:
			Some("debug")
		WithKeyword:
			Some("with")
		ConcurrentKeyword:
			Some("concurrent")
		ConcurrentlyKeyword:
			Some("concurrently")
		SelectKeyword:
			Some("select")
		AfterKeyword:
			Some("after")
		SealedKeyword:
			Some("sealed")
		OnKeyword:
			Some("on")
		_:
			None


---
Whether a keyword is reserved in every name position: bindings, parameters,
patterns, fields, and declarations. Only keywords with a soft identifier
spelling may be used as names.
---
private pure func keyword_is_reserved_name(keyword: Keyword) -> Bool:
	soft_keyword_identifier_text(keyword).is_none()


---
The single diagnostic text for a reserved keyword written where a name belongs.
It names the keyword and suggests a replacement identifier.
---
private pure func reserved_keyword_name_message(keyword: Keyword) -> String:
	text: String = keyword_text(keyword)
	suggestion: String = "choose another identifier such as `${text}_name`"

	"`${text}` is a reserved keyword and cannot be used as a name; ${suggestion}"


---
One rule for every reserved keyword written where a name belongs.

The keyword is consumed as if it were the name so the rest of the binding,
parameter list, or match case still parses and no bare "expected expression"
cascade follows the reserved-keyword error.
---
private pure func parse_reserved_keyword_as_name(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	keyword: Keyword,
	span: SourceSpan,
) -> ParseIdentifierStep:
	next_state: Int = index
	next_state_diag: List[ParseDiagnostic] = add_expected_error(
		diagnostics,
		span,
		reserved_keyword_name_message(keyword),
		[],
		None,
	)

	{
		index = advance_parser(state, next_state),
		diagnostics = next_state_diag,
		value = parsed_identifier(keyword_text(keyword), span)
	}


private pure func parse_identifier_expected(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	expected: String,
) -> ParseIdentifierStep:
	token: Token = current_token(state, index)

	match token.kind:
		IdentifierToken(text):
			{
				index = advance_parser(state, index),
				diagnostics = diagnostics,
				value = parsed_identifier(text, token.span)
			}
		KeywordToken(keyword):
			match soft_keyword_identifier_text(keyword):
				Some(text):
					{
						index = advance_parser(state, index),
						diagnostics = diagnostics,
						value = parsed_identifier(text, token.span)
					}
				None:
					next_state: Int = index
					next_state_diag: List[ParseDiagnostic] = add_expected_error(
						diagnostics,
						token.span,
						"expected ${expected}",
						[expected],
						None,
					)

					recovery_state: Int = if current_is_soft_boundary(state, next_state):
						next_state
					else:
						advance_parser(state, next_state)

					{
						index = recovery_state,
						diagnostics = next_state_diag,
						value = parsed_identifier("", token.span)
					}
		_:
			next_state: Int = index
			next_state_diag: List[ParseDiagnostic] = add_expected_error(
				diagnostics,
				token.span,
				"expected ${expected}",
				[expected],
				None,
			)

			recovery_state: Int = if current_is_soft_boundary(state, next_state):
				next_state
			else:
				advance_parser(state, next_state)

			{
				index = recovery_state,
				diagnostics = next_state_diag,
				value = parsed_identifier("", token.span)
			}


---
Parse an identifier that introduces a new name: a binding, parameter, pattern,
field, or declaration name.

A reserved keyword here is reported as a misuse of that keyword. Reference
positions such as module paths, field access, and constructor names keep
`parse_identifier_expected`, because a keyword there usually means the
reference is missing rather than that the keyword was meant as a name.
---
private pure func parse_declared_name_expected(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	expected: String,
) -> ParseIdentifierStep:
	token: Token = current_token(state, index)

	match token.kind:
		KeywordToken(keyword):
			if keyword_is_reserved_name(keyword):
				parse_reserved_keyword_as_name(state, index, diagnostics, keyword, token.span)
			else:
				parse_identifier_expected(state, index, diagnostics, expected)
		_:
			parse_identifier_expected(state, index, diagnostics, expected)


private pure func parse_type_identifier_expected(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	expected: String,
) -> ParseIdentifierStep:
	token: Token = current_token(state, index)

	match token.kind:
		IdentifierToken(_):
			parse_identifier_expected(state, index, diagnostics, expected)
		_:
			match type_keyword_identifier_text(state, index):
				Some(text):
					{
						index = advance_parser(state, index),
						diagnostics = diagnostics,
						value = parsed_identifier(text, token.span)
					}
				None:
					parse_identifier_expected(state, index, diagnostics, expected)


private pure func last_type_expr_span(
	items: List[ParsedTypeExpr],
	fallback: SourceSpan,
) -> SourceSpan:
	var span: SourceSpan = fallback

	for item in items:
		span = parsed_type_expr_span(item)

	span


private pure func last_dim_constraint_span(
	items: List[ParsedDimConstraint],
	fallback: SourceSpan,
) -> SourceSpan:
	var span: SourceSpan = fallback

	for item in items:
		span = item.span

	span


private pure func parsed_type_expr_is_dim(type_expr: ParsedTypeExpr) -> Bool:
	match type_expr:
		ParsedDimNameType(_, _, _):
			True
		ParsedDimLiteralType(_, _):
			True
		ParsedDimBinaryType(_, _, _, _):
			True
		_:
			False


private pure func parsed_type_exprs_all_dim(items: List[ParsedTypeExpr]) -> Bool:
	var all_dim: Bool = items.length() > 0

	for item in items:
		if not parsed_type_expr_is_dim(item):
			all_dim = False

	all_dim


private pure func last_identifier_span(
	items: List[ParsedIdentifier],
	fallback: SourceSpan,
) -> SourceSpan:
	var span: SourceSpan = fallback

	for item in items:
		span = item.span

	span


private pure func parse_plus_separated_identifier_list(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	expected: String,
) -> ParseIdentifierListStep:
	var st: Int = index
	var st_diag: List[ParseDiagnostic] = diagnostics
	var values: List[ParsedIdentifier] = []
	var parsing_values: Bool = True

	while parsing_values and not current_is_eof(state, st):
		name_step: ParseIdentifierStep = parse_identifier_expected(state, st, st_diag, expected)
		values = values.append(name_step.value)
		st = name_step.index
		st_diag = name_step.diagnostics

		if current_is_symbol(state, st, PlusSymbol):
			st = advance_parser(state, st)
		else:
			parsing_values = False

	{
		index = st,
		diagnostics = st_diag,
		values = values
	}


private pure func parse_hash_identifier_expected(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	expected: String,
) -> ParseIdentifierStep:
	start_span: SourceSpan = current_span(state, index)
	expect_step: ParseSymbolStep = expect_symbol(
		state,
		index,
		diagnostics,
		HashSymbol,
		"expected `#` before ${expected}",
	)
	st: Int = expect_step.index
	st_diag: List[ParseDiagnostic] = expect_step.diagnostics

	match current_token_kind(state, st):
		IdentifierToken(text):
			{
				index = advance_parser(state, st),
				diagnostics = st_diag,
				value = parsed_identifier(
					"#" + text,
					span_cover(
						start_span,
						current_span(state, st),
					),
				)
			}
		SymbolToken(UnderscoreSymbol):
			{
				index = advance_parser(state, st),
				diagnostics = st_diag,
				value = parsed_identifier(
					"#_",
					span_cover(
						start_span,
						current_span(state, st),
					),
				)
			}
		_:
			next_state: Int = st
			next_state_diag: List[ParseDiagnostic] = add_expected_error(
				st_diag,
				current_span(state, st),
				"expected ${expected}",
				[expected],
				None,
			)

			{
				index = next_state,
				diagnostics = next_state_diag,
				value = parsed_identifier("#", start_span)
			}


private pure func parse_dim_atom(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseTypeStep:
	token: Token = current_token(state, index)

	match token.kind:
		SymbolToken(HashSymbol):
			start_span: SourceSpan = token.span
			var st: Int = advance_parser(state, index)
			var st_diag: List[ParseDiagnostic] = diagnostics

			match current_token_kind(state, st):
				IdentifierToken(text):
					name: ParsedIdentifier = parsed_identifier(
						"#" + text,
						span_cover(
							start_span,
							current_span(state, st),
						),
					)
					st = advance_parser(state, st)
					var is_variadic: Bool = False
					var end_span: SourceSpan = name.span

					if current_is_symbol(state, st, DotDotDotSymbol):
						is_variadic = True
						end_span = current_span(state, st)
						st = advance_parser(state, st)

					{
						index = st,
						diagnostics = st_diag,
						value = ParsedDimNameType(
							name,
							is_variadic,
							span_cover(start_span, end_span),
						)
					}
				IntLiteralToken(text):
					{
						index = advance_parser(state, st),
						diagnostics = st_diag,
						value = ParsedDimLiteralType(
							text,
							span_cover(
								start_span,
								current_span(state, st),
							),
						)
					}
				SymbolToken(UnderscoreSymbol):
					name: ParsedIdentifier = parsed_identifier(
						"#_",
						span_cover(
							start_span,
							current_span(state, st),
						),
					)
					st = advance_parser(state, st)
					var is_variadic: Bool = False
					var end_span: SourceSpan = name.span

					if current_is_symbol(state, st, DotDotDotSymbol):
						is_variadic = True
						end_span = current_span(state, st)
						st = advance_parser(state, st)

					{
						index = st,
						diagnostics = st_diag,
						value = ParsedDimNameType(
							name,
							is_variadic,
							span_cover(start_span, end_span),
						)
					}
				_:
					next_state: Int = st
					next_state_diag: List[ParseDiagnostic] = add_expected_error(
						st_diag,
						current_span(state, st),
						"expected dimension name or literal after `#`",
						["dimension"],
						None,
					)

					{
						index = next_state,
						diagnostics = next_state_diag,
						value = ParsedMissingType(start_span)
					}
		IntLiteralToken(text):
			{
				index = advance_parser(state, index),
				diagnostics = diagnostics,
				value = ParsedDimLiteralType(text, token.span)
			}
		SymbolToken(LeftParenSymbol):
			dim_step: ParseTypeStep = parse_dim_expr(
				state,
				advance_parser(state, index),
				diagnostics,
			)
			right_step: ParseSymbolStep = expect_symbol(
				state,
				dim_step.index,
				dim_step.diagnostics,
				RightParenSymbol,
				"expected `)` after dimension expression",
			)

			{
				index = right_step.index,
				diagnostics = right_step.diagnostics,
				value = dim_step.value
			}
		_:
			next_state: Int = index
			next_state_diag: List[ParseDiagnostic] = add_expected_error(
				diagnostics,
				token.span,
				"expected dimension expression",
				["dimension"],
				None,
			)

			{
				index = next_state,
				diagnostics = next_state_diag,
				value = ParsedMissingType(token.span)
			}


private pure func parse_dim_multiply(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseTypeStep:
	left_step: ParseTypeStep = parse_dim_atom(state, index, diagnostics)
	var st: Int = left_step.index
	var st_diag: List[ParseDiagnostic] = left_step.diagnostics
	var left: ParsedTypeExpr = left_step.value

	while current_is_symbol(state, st, StarSymbol) or current_is_symbol(state, st, SlashSymbol):
		op: ParsedDimBinaryOp = if current_is_symbol(state, st, StarSymbol):
			ParsedDimMultiplyOp
		else:
			ParsedDimDivideOp

		st = advance_parser(state, st)
		right_step: ParseTypeStep = parse_dim_atom(state, st, st_diag)
		left = ParsedDimBinaryType(
			op,
			left,
			right_step.value,
			span_cover(parsed_type_expr_span(left), parsed_type_expr_span(right_step.value)),
		)
		st = right_step.index
		st_diag = right_step.diagnostics

	{
		index = st,
		diagnostics = st_diag,
		value = left
	}


private pure func parse_dim_expr(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseTypeStep:
	left_step: ParseTypeStep = parse_dim_multiply(state, index, diagnostics)
	var st: Int = left_step.index
	var st_diag: List[ParseDiagnostic] = left_step.diagnostics
	var left: ParsedTypeExpr = left_step.value

	while current_is_symbol(state, st, PlusSymbol) or current_is_symbol(state, st, MinusSymbol):
		op: ParsedDimBinaryOp = if current_is_symbol(state, st, PlusSymbol):
			ParsedDimAddOp
		else:
			ParsedDimSubtractOp

		st = advance_parser(state, st)
		right_step: ParseTypeStep = parse_dim_multiply(state, st, st_diag)
		left = ParsedDimBinaryType(
			op,
			left,
			right_step.value,
			span_cover(parsed_type_expr_span(left), parsed_type_expr_span(right_step.value)),
		)
		st = right_step.index
		st_diag = right_step.diagnostics

	{
		index = st,
		diagnostics = st_diag,
		value = left
	}


private pure func parse_dim_constraint(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseDimConstraintStep:
	left_step: ParseTypeStep = parse_dim_expr(state, index, diagnostics)
	equal_step: ParseSymbolStep = expect_symbol(
		state,
		left_step.index,
		left_step.diagnostics,
		EqualEqualSymbol,
		"expected `==` in dimension constraint",
	)
	right_step: ParseTypeStep = parse_dim_expr(state, equal_step.index, equal_step.diagnostics)

	{
		index = right_step.index,
		diagnostics = right_step.diagnostics,
		value = {
			left = left_step.value,
			right = right_step.value,
			span = span_cover(
				parsed_type_expr_span(left_step.value),
				parsed_type_expr_span(right_step.value),
			)
		}
	}


private pure func parse_dim_constraints_opt(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseDimConstraintListStep:
	var st: Int = index
	var st_diag: List[ParseDiagnostic] = diagnostics
	var values: List[ParsedDimConstraint] = []

	if current_is_keyword(state, st, WhereKeyword):
		st = advance_parser(state, st)
		var parsing_constraints: Bool = True

		while parsing_constraints and not current_is_eof(state, st):
			constraint_step: ParseDimConstraintStep = parse_dim_constraint(state, st, st_diag)
			values = values.append(constraint_step.value)
			st = constraint_step.index
			st_diag = constraint_step.diagnostics

			if current_is_symbol(state, st, CommaSymbol):
				st = advance_parser(state, st)
			else:
				parsing_constraints = False

	{
		index = st,
		diagnostics = st_diag,
		values = values
	}


private pure func parse_type_array_suffixes(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	base: ParsedTypeExpr,
) -> ParseTypeStep:
	var st: Int = index
	var st_diag: List[ParseDiagnostic] = diagnostics
	var value: ParsedTypeExpr = base

	while current_is_symbol(state, st, LeftBracketSymbol):
		dims_step: ParseTypeListStep = parse_type_expr_list_until(
			state,
			advance_parser(state, st),
			st_diag,
			RightBracketSymbol,
			False,
		)
		right_step: ParseSymbolStep = expect_symbol(
			state,
			dims_step.index,
			dims_step.diagnostics,
			RightBracketSymbol,
			"expected `]` after array dimensions",
		)
		st = right_step.index
		st_diag = right_step.diagnostics

		if not parsed_type_exprs_all_dim(dims_step.values):
			st_diag = add_expected_error(
				st_diag,
				last_type_expr_span(dims_step.values, parsed_type_expr_span(value)),
				"expected array dimensions",
				["dimension"],
				Some("generic type arguments belong on the named type before array dimensions"),
			)

		end_span: SourceSpan = if right_step.matched:
			right_step.span
		else:
			last_type_expr_span(dims_step.values, parsed_type_expr_span(value))

		value = ParsedArrayType(
			value,
			dims_step.values,
			span_cover(parsed_type_expr_span(value), end_span),
		)

	{
		index = st,
		diagnostics = st_diag,
		value = value
	}


private pure func parse_named_type_expr_with_bounds(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	allow_bounds: Bool,
) -> ParseTypeStep:
	can_qualify: Bool = match current_token_kind(state, index):
		IdentifierToken(_):
			True
		_:
			False

	first_name_step: ParseIdentifierStep = parse_type_identifier_expected(
		state,
		index,
		diagnostics,
		EXPECTED_TYPE,
	)
	var type_name: ParsedIdentifier = first_name_step.value
	var qualifier: Option[ParsedIdentifier] = None
	var st: Int = first_name_step.index
	var st_diag: List[ParseDiagnostic] = first_name_step.diagnostics
	var args: List[ParsedTypeExpr] = []
	var end_span: SourceSpan = first_name_step.value.span

	if allow_bounds and current_is_symbol(state, st, ColonSymbol):
		bounds_step: ParseIdentifierListStep = parse_plus_separated_identifier_list(
			state,
			advance_parser(state, st),
			st_diag,
			"trait bound",
		)

		{
			index = bounds_step.index,
			diagnostics = bounds_step.diagnostics,
			value = ParsedBoundedType(
				type_name,
				bounds_step.values,
				span_cover(
					type_name.span,
					last_identifier_span(bounds_step.values, type_name.span),
				),
			)
		}
	else:
		if can_qualify and current_is_symbol(state, st, DotSymbol):
			qualified_name_step: ParseIdentifierStep = parse_identifier_expected(
				state,
				advance_parser(state, st),
				st_diag,
				EXPECTED_TYPE,
			)
			qualifier = Some(first_name_step.value)
			type_name = qualified_name_step.value
			st = qualified_name_step.index
			st_diag = qualified_name_step.diagnostics
			end_span = type_name.span

		if current_is_symbol(state, st, LeftBracketSymbol):
			args_step: ParseTypeListStep = parse_type_expr_list_until(
				state,
				advance_parser(state, st),
				st_diag,
				RightBracketSymbol,
				True,
			)
			right_step: ParseSymbolStep = expect_symbol(
				state,
				args_step.index,
				args_step.diagnostics,
				RightBracketSymbol,
				"expected `]` after type arguments",
			)
			st = right_step.index
			st_diag = right_step.diagnostics
			args = args_step.values
			end_span = last_type_expr_span(args, end_span)

			if right_step.matched:
				end_span = right_step.span

		base_type: ParsedTypeExpr = match qualifier:
			Some(module_name):
				ParsedQualifiedNamedType(
					module_name,
					type_name,
					[],
					span_cover(module_name.span, type_name.span),
				)
			None:
				ParsedNamedType(type_name, [], type_name.span)

		if parsed_type_exprs_all_dim(args):
			array_type: ParsedTypeExpr = ParsedArrayType(
				base_type,
				args,
				span_cover(parsed_type_expr_span(base_type), end_span),
			)
			parse_type_array_suffixes(state, st, st_diag, array_type)
		else:
			named_type: ParsedTypeExpr = match qualifier:
				Some(module_name):
					ParsedQualifiedNamedType(
						module_name,
						type_name,
						args,
						span_cover(module_name.span, end_span),
					)
				None:
					ParsedNamedType(
						type_name,
						args,
						span_cover(type_name.span, end_span),
					)

			parse_type_array_suffixes(state, st, st_diag, named_type)


private pure func parse_parenthesized_type_expr(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseTypeStep:
	start_span: SourceSpan = current_span(state, index)
	var st: Int = advance_parser(state, index)
	var st_diag: List[ParseDiagnostic] = diagnostics

	if current_is_symbol(state, st, RightParenSymbol):
		right_step: ParseSymbolStep = expect_symbol(
			state,
			st,
			st_diag,
			RightParenSymbol,
			"expected `)` after type",
		)
		st = right_step.index
		st_diag = right_step.diagnostics
		void_type: ParsedTypeExpr = ParsedNamedType(
			parsed_identifier(
				"Void",
				span_cover(start_span, right_step.span),
			),
			[],
			span_cover(start_span, right_step.span),
		)

		if current_is_symbol(state, st, ArrowSymbol):
			return_step: ParseTypeStep = parse_type_expr(
				state,
				advance_parser(state, st),
				st_diag,
			)

			{
				index = return_step.index,
				diagnostics = return_step.diagnostics,
				value = ParsedFunctionType(
					False,
					[],
					return_step.value,
					span_cover(start_span, parsed_type_expr_span(return_step.value)),
				)
			}
		else:
			parse_type_array_suffixes(state, st, st_diag, void_type)
	else:
		items_step: ParseTypeListStep = parse_type_expr_list_until(
			state,
			st,
			st_diag,
			RightParenSymbol,
			False,
		)
		right_step: ParseSymbolStep = expect_symbol(
			state,
			items_step.index,
			items_step.diagnostics,
			RightParenSymbol,
			"expected `)` after type",
		)
		st = right_step.index
		st_diag = right_step.diagnostics

		if current_is_symbol(state, st, ArrowSymbol):
			return_step: ParseTypeStep = parse_type_expr(
				state,
				advance_parser(state, st),
				st_diag,
			)

			{
				index = return_step.index,
				diagnostics = return_step.diagnostics,
				value = ParsedFunctionType(
					False,
					items_step.values,
					return_step.value,
					span_cover(start_span, parsed_type_expr_span(return_step.value)),
				)
			}
		else:
			if items_step.values.length() > 4:
				st_diag = add_tuple_arity_error(
					st_diag,
					span_cover(start_span, right_step.span),
				)

			base_type: ParsedTypeExpr = if items_step.values.length() == 1:
				match items_step.values.get(0):
					Some(item):
						item
					None:
						ParsedMissingType(start_span)
			else:
				ParsedTupleType(
					items_step.values,
					span_cover(start_span, right_step.span),
				)

			parse_type_array_suffixes(state, st, st_diag, base_type)


private pure func parse_pure_function_type_expr(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseTypeStep:
	start_span: SourceSpan = current_span(state, index)
	var st: Int = advance_parser(state, index)
	var st_diag: List[ParseDiagnostic] = diagnostics
	left_step: ParseSymbolStep = expect_symbol(
		state,
		st,
		st_diag,
		LeftParenSymbol,
		"expected `(` after `pure` in function type",
	)
	st = left_step.index
	st_diag = left_step.diagnostics
	params_step: ParseTypeListStep = parse_type_expr_list_until(
		state,
		st,
		st_diag,
		RightParenSymbol,
		True,
	)
	right_step: ParseSymbolStep = expect_symbol(
		state,
		params_step.index,
		params_step.diagnostics,
		RightParenSymbol,
		"expected `)` after function type parameters",
	)
	st = right_step.index
	st_diag = right_step.diagnostics
	arrow_step: ParseSymbolStep = expect_symbol(
		state,
		st,
		st_diag,
		ArrowSymbol,
		"expected `->` after function type parameters",
	)
	return_step: ParseTypeStep = parse_type_expr(state, arrow_step.index, arrow_step.diagnostics)

	{
		index = return_step.index,
		diagnostics = return_step.diagnostics,
		value = ParsedFunctionType(
			True,
			params_step.values,
			return_step.value,
			span_cover(start_span, parsed_type_expr_span(return_step.value)),
		)
	}


private pure func parse_range_type_expr(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseTypeStep:
	start_span: SourceSpan = current_span(state, index)
	var st: Int = advance_parser(state, index)
	var st_diag: List[ParseDiagnostic] = diagnostics

	if (
		not current_is_symbol(state, st, HashSymbol)
		and not current_is_symbol(state, st, LeftParenSymbol)
	):
		st_diag = add_expected_error(
			st_diag,
			current_span(state, st),
			"expected `#` dimension after `..`",
			["# dimension"],
			None,
		)

	dim_step: ParseTypeStep = parse_dim_expr(state, st, st_diag)

	{
		index = dim_step.index,
		diagnostics = dim_step.diagnostics,
		value = ParsedRangeType(
			dim_step.value,
			span_cover(start_span, parsed_type_expr_span(dim_step.value)),
		)
	}


private pure func token_index_starts_dim_atom(state: ParserInput, index: Int) -> Bool:
	match token_kind_at(state, index):
		SymbolToken(HashSymbol):
			True
		IntLiteralToken(_):
			True
		SymbolToken(LeftParenSymbol):
			token_index_starts_dim_atom(state, index + 1)
		_:
			False


private pure func starts_parenthesized_dim_expr(state: ParserInput, index: Int) -> Bool:
	(
		current_is_symbol(state, index, LeftParenSymbol)
		and token_index_starts_dim_atom(state, index + 1)
	)


private pure func parse_type_expr_allow_bounds(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	allow_bounds: Bool,
) -> ParseTypeStep:
	token: Token = current_token(state, index)

	match token.kind:
		IdentifierToken(_):
			parse_named_type_expr_with_bounds(state, index, diagnostics, allow_bounds)
		KeywordToken(SelfKeyword):
			parse_named_type_expr_with_bounds(state, index, diagnostics, allow_bounds)
		KeywordToken(VoidKeyword):
			parse_named_type_expr_with_bounds(state, index, diagnostics, allow_bounds)
		KeywordToken(PureKeyword):
			parse_pure_function_type_expr(state, index, diagnostics)
		SymbolToken(HashSymbol):
			parse_dim_expr(state, index, diagnostics)
		IntLiteralToken(_):
			parse_dim_expr(state, index, diagnostics)
		SymbolToken(DotDotSymbol):
			parse_range_type_expr(state, index, diagnostics)
		SymbolToken(LeftParenSymbol):
			if starts_parenthesized_dim_expr(state, index):
				parse_dim_expr(state, index, diagnostics)
			else:
				parse_parenthesized_type_expr(state, index, diagnostics)
		_:
			next_state: Int = index
			next_state_diag: List[ParseDiagnostic] = add_expected_error(
				diagnostics,
				token.span,
				"expected type",
				[EXPECTED_TYPE],
				None,
			)

			recovery_state: Int = if current_is_soft_boundary(state, next_state):
				next_state
			else:
				advance_parser(state, next_state)

			{
				index = recovery_state,
				diagnostics = next_state_diag,
				value = ParsedMissingType(token.span)
			}


private pure func parse_type_expr(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseTypeStep:
	parse_type_expr_allow_bounds(state, index, diagnostics, False)


private pure func param_span_from_start(
	start_span: SourceSpan,
	type_expr: Option[ParsedTypeExpr],
) -> SourceSpan:
	end_span: SourceSpan = match type_expr:
		Some(ty):
			parsed_type_expr_span(ty)
		None:
			start_span

	span_cover(start_span, end_span)


private pure func param_span(
	binder: ParsedParamBinder,
	type_expr: Option[ParsedTypeExpr],
) -> SourceSpan:
	param_span_from_start(parsed_param_binder_span(binder), type_expr)


private pure func parse_tuple_param(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseParamStep:
	start_span: SourceSpan = current_span(state, index)
	binder_step: ParseTupleBinderStep = parse_tuple_binder_after_left_paren(
		state,
		advance_parser(state, index),
		diagnostics,
		start_span,
		TupleBinderNamesOnly,
		"tuple parameter name",
		"expected `, ` between tuple parameter names",
		"expected tuple parameter name after `, `",
		"expected `)` after tuple parameter names",
	)
	type_step: ParseOptionalTypeStep = parse_optional_type_annotation(
		state,
		binder_step.index,
		binder_step.diagnostics,
	)
	binder: ParsedParamBinder = ParsedParamTupleBinder(binder_step.values, binder_step.span)

	{
		index = type_step.index,
		diagnostics = type_step.diagnostics,
		value = {
			binder = binder,
			type_expr = type_step.value,
			span = param_span(binder, type_step.value)
		}
	}


private pure func parse_named_or_wildcard_param(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseParamStep:
	token: Token = current_token(state, index)

	match token.kind:
		SymbolToken(UnderscoreSymbol):
			underscore: ParsedIdentifier = parsed_identifier("_", token.span)
			type_step: ParseOptionalTypeStep = parse_optional_type_annotation(
				state,
				advance_parser(state, index),
				diagnostics,
			)

			binder: ParsedParamBinder = match type_step.value:
				Some(_):
					ParsedParamNameBinder(underscore)
				None:
					ParsedParamWildcardBinder(token.span)

			{
				index = type_step.index,
				diagnostics = type_step.diagnostics,
				value = {
					binder = binder,
					type_expr = type_step.value,
					span = param_span(binder, type_step.value)
				}
			}
		_:
			name_step: ParseIdentifierStep = parse_declared_name_expected(
				state,
				index,
				diagnostics,
				EXPECTED_PARAMETER_NAME,
			)
			type_step: ParseOptionalTypeStep = parse_optional_type_annotation(
				state,
				name_step.index,
				name_step.diagnostics,
			)
			binder: ParsedParamBinder = ParsedParamNameBinder(name_step.value)

			{
				index = type_step.index,
				diagnostics = type_step.diagnostics,
				value = {
					binder = binder,
					type_expr = type_step.value,
					span = param_span(binder, type_step.value)
				}
			}


private pure func parse_param(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseParamStep:
	if current_is_symbol(state, index, LeftParenSymbol):
		parse_tuple_param(state, index, diagnostics)
	else:
		parse_named_or_wildcard_param(state, index, diagnostics)


private pure func parse_params_after_left_paren(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseParamsStep:
	var st: Int = skip_newlines(state, index)
	var st_diag: List[ParseDiagnostic] = diagnostics
	var opened_indent: Bool = False
	var params: List[ParsedParam] = []

	if current_is_indent(state, st):
		opened_indent = True
		st = advance_parser(state, st)
		st = skip_newlines(state, st)

	if not current_is_symbol(state, st, RightParenSymbol):
		var parsing_params: Bool = True

		while parsing_params and not current_is_eof(state, st):
			param_step: ParseParamStep = parse_param(state, st, st_diag)
			params = params.append(param_step.value)
			st = param_step.index
			st_diag = param_step.diagnostics

			if current_is_symbol(state, st, CommaSymbol):
				st = advance_parser(state, st)
				st = skip_newlines(state, st)

				if opened_indent and current_is_dedent(state, st):
					st = advance_parser(state, st)
					st = skip_newlines(state, st)

				if current_is_symbol(state, st, RightParenSymbol):
					parsing_params = False
			else:
				parsing_params = False

	st = skip_newlines(state, st)

	if opened_indent and current_is_dedent(state, st):
		st = advance_parser(state, st)
		st = skip_newlines(state, st)

	right_step: ParseSymbolStep = expect_symbol(
		state,
		st,
		st_diag,
		RightParenSymbol,
		"expected `)` after function parameters",
	)

	{
		index = right_step.index,
		diagnostics = right_step.diagnostics,
		values = params
	}


private pure func parse_lambda_param(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseLambdaParamStep:
	name_step: ParseIdentifierStep = parse_binder_identifier_expected(
		state,
		index,
		diagnostics,
		"lambda parameter",
	)
	type_step: ParseOptionalTypeStep = parse_optional_type_annotation(
		state,
		name_step.index,
		name_step.diagnostics,
	)

	{
		index = type_step.index,
		diagnostics = type_step.diagnostics,
		value = {
			name = name_step.value,
			type_expr = type_step.value,
			span = param_span_from_start(name_step.value.span, type_step.value)
		}
	}


private pure func parse_lambda_params_after_left_paren(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseLambdaParamsStep:
	var st: Int = skip_newlines(state, index)
	var st_diag: List[ParseDiagnostic] = diagnostics
	var opened_indent: Bool = False
	var params: List[ParsedLambdaParam] = []

	if current_is_indent(state, st):
		opened_indent = True
		st = advance_parser(state, st)
		st = skip_newlines(state, st)

	if not current_is_symbol(state, st, RightParenSymbol):
		var parsing_params: Bool = True

		while parsing_params and not current_is_eof(state, st):
			param_step: ParseLambdaParamStep = parse_lambda_param(state, st, st_diag)
			params = params.append(param_step.value)
			st = param_step.index
			st_diag = param_step.diagnostics

			if current_is_symbol(state, st, CommaSymbol):
				st = advance_parser(state, st)
				st = skip_newlines(state, st)

				if opened_indent and current_is_dedent(state, st):
					st = advance_parser(state, st)
					st = skip_newlines(state, st)

				if current_is_symbol(state, st, RightParenSymbol):
					parsing_params = False
			else:
				parsing_params = False

	st = skip_newlines(state, st)

	if opened_indent and current_is_dedent(state, st):
		st = advance_parser(state, st)
		st = skip_newlines(state, st)

	right_step: ParseSymbolStep = expect_symbol(
		state,
		st,
		st_diag,
		RightParenSymbol,
		"expected `)` after lambda parameters",
	)

	{
		index = right_step.index,
		diagnostics = right_step.diagnostics,
		values = params
	}


private pure func parse_identifier_list_until(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	end_symbol: Symbol,
	allow_empty: Bool,
	expected: String,
) -> ParseIdentifierListStep:
	var st: Int = index
	var st_diag: List[ParseDiagnostic] = diagnostics
	var values: List[ParsedIdentifier] = []

	if allow_empty and current_is_symbol(state, st, end_symbol):
		{
			index = st,
			diagnostics = st_diag,
			values = values
		}
	else:
		var parsing_values: Bool = True

		while parsing_values and not current_is_eof(state, st):
			item_step: ParseIdentifierStep = parse_identifier_expected(state, st, st_diag, expected)
			values = values.append(item_step.value)
			st = item_step.index
			st_diag = item_step.diagnostics

			if current_is_symbol(state, st, CommaSymbol):
				st = advance_parser(state, st)

				if current_is_symbol(state, st, end_symbol):
					parsing_values = False
			else:
				parsing_values = False

		{
			index = st,
			diagnostics = st_diag,
			values = values
		}


private pure func parse_type_expr_list_until(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	end_symbol: Symbol,
	allow_empty: Bool,
) -> ParseTypeListStep:
	var st: Int = index
	var st_diag: List[ParseDiagnostic] = diagnostics
	var values: List[ParsedTypeExpr] = []

	if allow_empty and current_is_symbol(state, st, end_symbol):
		{
			index = st,
			diagnostics = st_diag,
			values = values
		}
	else:
		var parsing_values: Bool = True

		while parsing_values and not current_is_eof(state, st):
			type_step: ParseTypeStep = parse_type_expr_allow_bounds(state, st, st_diag, True)
			values = values.append(type_step.value)
			st = type_step.index
			st_diag = type_step.diagnostics

			if current_is_symbol(state, st, CommaSymbol):
				st = advance_parser(state, st)

				if current_is_symbol(state, st, end_symbol):
					parsing_values = False
			else:
				parsing_values = False

		{
			index = st,
			diagnostics = st_diag,
			values = values
		}


private pure func parse_type_param_decl(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseTypeParamStep:
	name_step: ParseIdentifierStep = if current_is_symbol(state, index, HashSymbol):
		parse_hash_identifier_expected(state, index, diagnostics, "dimension parameter")
	else:
		parse_declared_name_expected(state, index, diagnostics, "type parameter")

	var st: Int = name_step.index
	var st_diag: List[ParseDiagnostic] = name_step.diagnostics
	var bounds: List[ParsedIdentifier] = []
	var end_span: SourceSpan = name_step.value.span

	if current_is_symbol(state, st, ColonSymbol):
		bounds_step: ParseIdentifierListStep = parse_plus_separated_identifier_list(
			state,
			advance_parser(state, st),
			st_diag,
			"trait bound",
		)
		bounds = bounds_step.values
		st = bounds_step.index
		st_diag = bounds_step.diagnostics
		end_span = last_identifier_span(bounds, end_span)

	{
		index = st,
		diagnostics = st_diag,
		value = {
			name = name_step.value,
			bounds = bounds,
			span = span_cover(name_step.value.span, end_span)
		}
	}


private pure func parse_type_param_list_until(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	end_symbol: Symbol,
	allow_empty: Bool,
) -> ParseTypeParamListStep:
	var st: Int = index
	var st_diag: List[ParseDiagnostic] = diagnostics
	var values: List[ParsedTypeParamDecl] = []

	if allow_empty and current_is_symbol(state, st, end_symbol):
		{
			index = st,
			diagnostics = st_diag,
			values = values
		}
	else:
		var parsing_values: Bool = True

		while parsing_values and not current_is_eof(state, st):
			item_step: ParseTypeParamStep = parse_type_param_decl(state, st, st_diag)
			values = values.append(item_step.value)
			st = item_step.index
			st_diag = item_step.diagnostics

			if current_is_symbol(state, st, CommaSymbol):
				st = advance_parser(state, st)

				if current_is_symbol(state, st, end_symbol):
					parsing_values = False
			else:
				parsing_values = False

		{
			index = st,
			diagnostics = st_diag,
			values = values
		}


private pure func parse_type_params_opt(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseTypeParamListStep:
	if current_is_symbol(state, index, LeftBracketSymbol):
		items_step: ParseTypeParamListStep = parse_type_param_list_until(
			state,
			advance_parser(state, index),
			diagnostics,
			RightBracketSymbol,
			True,
		)
		right_step: ParseSymbolStep = expect_symbol(
			state,
			items_step.index,
			items_step.diagnostics,
			RightBracketSymbol,
			"expected `]` after type parameters",
		)

		{
			index = right_step.index,
			diagnostics = right_step.diagnostics,
			values = items_step.values
		}
	else:
		{
			index = index,
			diagnostics = diagnostics,
			values = []
		}


private pure func parse_binder_identifier_expected(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	expected: String,
) -> ParseIdentifierStep:
	token: Token = current_token(state, index)

	match token.kind:
		IdentifierToken(text):
			{
				index = advance_parser(state, index),
				diagnostics = diagnostics,
				value = parsed_identifier(text, token.span)
			}
		SymbolToken(UnderscoreSymbol):
			{
				index = advance_parser(state, index),
				diagnostics = diagnostics,
				value = parsed_identifier("_", token.span)
			}
		_:
			parse_declared_name_expected(state, index, diagnostics, expected)


private pure func parse_select_receive_identifier_expected(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	expected: String,
) -> ParseIdentifierStep:
	token: Token = current_token(state, index)

	match token.kind:
		IdentifierToken(text):
			{
				index = advance_parser(state, index),
				diagnostics = diagnostics,
				value = parsed_identifier(text, token.span)
			}
		SymbolToken(UnderscoreSymbol):
			{
				index = advance_parser(state, index),
				diagnostics = diagnostics,
				value = parsed_identifier("_", token.span)
			}
		KeywordToken(AfterKeyword):
			{
				index = advance_parser(state, index),
				diagnostics = diagnostics,
				value = parsed_identifier("after", token.span)
			}
		KeywordToken(FromKeyword):
			{
				index = advance_parser(state, index),
				diagnostics = diagnostics,
				value = parsed_identifier("from", token.span)
			}
		_:
			parse_declared_name_expected(state, index, diagnostics, expected)


private pure func current_infix_info(state: ParserInput, index: Int) -> Option[ParsedInfixInfo]:
	match current_token_kind(state, index):
		KeywordToken(OrKeyword):
			Some({
				precedence = PREC_OR,
				tag = InfixOrOp,
			})
		KeywordToken(AndKeyword):
			Some({
				precedence = PREC_AND,
				tag = InfixAndOp,
			})
		SymbolToken(EqualEqualSymbol):
			Some({
				precedence = PREC_COMPARE,
				tag = InfixEqualOp,
			})
		SymbolToken(NotEqualSymbol):
			Some({
				precedence = PREC_COMPARE,
				tag = InfixNotEqualOp,
			})
		SymbolToken(LessSymbol):
			Some({
				precedence = PREC_COMPARE,
				tag = InfixLessOp,
			})
		SymbolToken(LessEqualSymbol):
			Some({
				precedence = PREC_COMPARE,
				tag = InfixLessEqualOp,
			})
		SymbolToken(GreaterSymbol):
			Some({
				precedence = PREC_COMPARE,
				tag = InfixGreaterOp,
			})
		SymbolToken(GreaterEqualSymbol):
			Some({
				precedence = PREC_COMPARE,
				tag = InfixGreaterEqualOp,
			})
		SymbolToken(DotDotSymbol):
			Some({
				precedence = PREC_RANGE,
				tag = InfixRangeOp,
			})
		SymbolToken(PlusSymbol):
			Some({
				precedence = PREC_ADD,
				tag = InfixAddOp,
			})
		SymbolToken(MinusSymbol):
			Some({
				precedence = PREC_ADD,
				tag = InfixSubtractOp,
			})
		SymbolToken(StarSymbol):
			Some({
				precedence = PREC_MULTIPLY,
				tag = InfixMultiplyOp,
			})
		SymbolToken(SlashSymbol):
			Some({
				precedence = PREC_MULTIPLY,
				tag = InfixDivideOp,
			})
		SymbolToken(PercentSymbol):
			Some({
				precedence = PREC_MULTIPLY,
				tag = InfixModuloOp,
			})
		_:
			None


private pure func current_compound_assign_op(
	state: ParserInput,
	index: Int,
) -> Option[ParsedCompoundAssignOp]:
	match current_token_kind(state, index):
		SymbolToken(PlusEqualSymbol):
			Some(ParsedAssignAddOp)
		SymbolToken(MinusEqualSymbol):
			Some(ParsedAssignSubtractOp)
		SymbolToken(StarEqualSymbol):
			Some(ParsedAssignMultiplyOp)
		SymbolToken(SlashEqualSymbol):
			Some(ParsedAssignDivideOp)
		_:
			None


private pure func current_can_start_assignment_tail(state: ParserInput, index: Int) -> Bool:
	(
		current_is_symbol(state, index, EqualSymbol)
		or current_is_symbol(state, index, QuestionEqualsSymbol)
		or current_compound_assign_op(state, index).is_some()
	)


private pure func colon_starts_typed_assignment(state: ParserInput, start_index: Int) -> Bool:
	var index: Int = start_index + 1
	var depth: Int = 0
	var found_assignment: Bool = False

	while not found_assignment:
		token_kind: TokenKind = token_kind_at(state, index)

		match token_kind:
			EndOfFileToken:
				break
			NewlineToken:
				break
			DedentToken:
				break
			SymbolToken(EqualSymbol):
				if depth == 0:
					found_assignment = True
				else:
					index += 1
			SymbolToken(QuestionEqualsSymbol):
				if depth == 0:
					found_assignment = True
				else:
					index += 1
			SymbolToken(LeftParenSymbol):
				depth += 1
				index += 1
			SymbolToken(LeftBracketSymbol):
				depth += 1
				index += 1
			SymbolToken(LeftBraceSymbol):
				depth += 1
				index += 1
			SymbolToken(RightParenSymbol):
				if depth == 0:
					break
				else:
					depth -= 1
					index += 1
			SymbolToken(RightBracketSymbol):
				if depth == 0:
					break
				else:
					depth -= 1
					index += 1
			SymbolToken(RightBraceSymbol):
				if depth == 0:
					break
				else:
					depth -= 1
					index += 1
			SymbolToken(CommaSymbol):
				if depth == 0:
					break
				else:
					index += 1
			SymbolToken(ColonSymbol):
				if depth == 0:
					break
				else:
					index += 1
			_:
				index += 1

	found_assignment


private pure func expr_list_has_leading_dot_postfix_continuation(items: List[ParsedExpr]) -> Bool:
	var found: Bool = False

	for item in items:
		if parsed_expr_has_leading_dot_postfix_continuation(item):
			found = True
			break

	found


private pure func parsed_expr_has_leading_dot_postfix_continuation(expr: ParsedExpr) -> Bool:
	match expr:
		ParsedFieldAccessExpr(target, _, span):
			target_span: SourceSpan = parsed_expr_span(target)

			(
				span.end_line > target_span.end_line
				or parsed_expr_has_leading_dot_postfix_continuation(target)
			)
		ParsedCallExpr(callee, args, _):
			(
				parsed_expr_has_leading_dot_postfix_continuation(callee)
				or expr_list_has_leading_dot_postfix_continuation(args)
			)
		ParsedSubscriptExpr(target, indices, _):
			(
				parsed_expr_has_leading_dot_postfix_continuation(target)
				or expr_list_has_leading_dot_postfix_continuation(indices)
			)
		ParsedBinaryExpr(_, left, right, _):
			(
				parsed_expr_has_leading_dot_postfix_continuation(left)
				or parsed_expr_has_leading_dot_postfix_continuation(right)
			)
		ParsedLogicalExpr(_, left, right, _):
			(
				parsed_expr_has_leading_dot_postfix_continuation(left)
				or parsed_expr_has_leading_dot_postfix_continuation(right)
			)
		ParsedAscriptionExpr(value, _, _):
			parsed_expr_has_leading_dot_postfix_continuation(value)
		_:
			False


private pure func parsed_expr_needs_leading_dot_continuation_dedent(expr: ParsedExpr) -> Bool:
	match expr:
		ParsedBinaryExpr(_, left, right, _):
			(
				parsed_expr_has_leading_dot_postfix_continuation(left)
				or parsed_expr_needs_leading_dot_continuation_dedent(right)
			)
		ParsedLogicalExpr(_, left, right, _):
			(
				parsed_expr_has_leading_dot_postfix_continuation(left)
				or parsed_expr_needs_leading_dot_continuation_dedent(right)
			)
		ParsedAscriptionExpr(value, _, _):
			parsed_expr_has_leading_dot_postfix_continuation(value)
		_:
			False


private pure func consume_leading_dot_postfix_continuation_dedent(
	state: ParserInput,
	index: Int,
	value: ParsedExpr,
) -> Int:
	after_value: Int = skip_newlines(state, index)

	if (
		current_is_dedent(state, after_value)
		and parsed_expr_needs_leading_dot_continuation_dedent(value)
	):
		advance_parser(state, after_value)
	else:
		after_value


private pure func parse_header_anchored_expression(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	header_span: SourceSpan,
) -> ParseExprStep:
	if current_is_keyword(state, index, IfKeyword):
		parse_if_expr_with_header_span(state, index, diagnostics, header_span)
	else if current_is_keyword(state, index, MatchKeyword):
		parse_match_expr_with_header_span(state, index, diagnostics, header_span)
	else if current_is_keyword(state, index, SelectKeyword):
		parse_select_expr_with_header_span(state, index, diagnostics, header_span)
	else if current_is_keyword(state, index, ForKeyword):
		parse_for_expr_with_header_span(state, index, diagnostics, header_span)
	else if (
		current_is_keyword(state, index, FuncKeyword)
		or current_is_keyword(state, index, PureKeyword)
	):
		parse_lambda_expr_with_header_span(state, index, diagnostics, header_span)
	else:
		parse_expression_with_header_span(state, index, diagnostics, PREC_LOWEST, header_span)


private pure func parse_assignment_value_expr(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	header_span: SourceSpan,
) -> ParseExprStep:
	if current_is_newline(state, index):
		var st: Int = advance_parser(state, index)
		var st_diag: List[ParseDiagnostic] = diagnostics

		if current_is_indent(state, st):
			st = advance_parser(state, st)
		else:
			st_diag = add_expected_error(
				st_diag,
				current_span(state, st),
				"expected indented assignment value",
				["indent"],
				None,
			)

		value_step: ParseExprStep = parse_expression(state, st, st_diag, PREC_LOWEST)
		after_value: Int = skip_newlines(state, value_step.index)
		after_value_diag: List[ParseDiagnostic] = value_step.diagnostics

		final_state: Int = if current_is_dedent(state, after_value):
			advance_parser(state, after_value)
		else:
			after_value

		{
			index = final_state,
			diagnostics = after_value_diag,
			value = value_step.value
		}
	else:
		value_step: ParseExprStep = parse_header_anchored_expression(
			state,
			index,
			diagnostics,
			header_span,
		)

		{
			index = consume_leading_dot_postfix_continuation_dedent(
				state,
				value_step.index,
				value_step.value,
			),
			diagnostics = value_step.diagnostics,
			value = value_step.value
		}


private pure func parse_optional_type_annotation(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseOptionalTypeStep:
	if current_is_symbol(state, index, ColonSymbol):
		type_step: ParseTypeStep = parse_type_expr(
			state,
			advance_parser(state, index),
			diagnostics,
		)

		{
			index = type_step.index,
			diagnostics = type_step.diagnostics,
			value = Some(type_step.value)
		}
	else:
		{
			index = index,
			diagnostics = diagnostics,
			value = None
		}


private pure func make_infix_expr(
	info: ParsedInfixInfo,
	left: ParsedExpr,
	right: ParsedExpr,
) -> ParsedExpr:
	span: SourceSpan = span_cover(parsed_expr_span(left), parsed_expr_span(right))

	match info.tag:
		InfixOrOp:
			ParsedLogicalExpr(ParsedOrOp, left, right, span)
		InfixAndOp:
			ParsedLogicalExpr(ParsedAndOp, left, right, span)
		InfixEqualOp:
			ParsedBinaryExpr(ParsedEqualOp, left, right, span)
		InfixNotEqualOp:
			ParsedBinaryExpr(ParsedNotEqualOp, left, right, span)
		InfixLessOp:
			ParsedBinaryExpr(ParsedLessOp, left, right, span)
		InfixLessEqualOp:
			ParsedBinaryExpr(ParsedLessEqualOp, left, right, span)
		InfixGreaterOp:
			ParsedBinaryExpr(ParsedGreaterOp, left, right, span)
		InfixGreaterEqualOp:
			ParsedBinaryExpr(ParsedGreaterEqualOp, left, right, span)
		InfixRangeOp:
			ParsedRangeExpr(left, right, span)
		InfixAddOp:
			ParsedBinaryExpr(ParsedAddOp, left, right, span)
		InfixSubtractOp:
			ParsedBinaryExpr(ParsedSubtractOp, left, right, span)
		InfixMultiplyOp:
			ParsedBinaryExpr(ParsedMultiplyOp, left, right, span)
		InfixDivideOp:
			ParsedBinaryExpr(ParsedDivideOp, left, right, span)
		InfixModuloOp:
			ParsedBinaryExpr(ParsedModuloOp, left, right, span)


private pure func layout_reaches_end_symbol(
	state: ParserInput,
	start_index: Int,
	end_symbol: Symbol,
) -> Bool:
	var index: Int = start_index

	while True:
		match token_kind_at(state, index):
			NewlineToken:
				index += 1
			DedentToken:
				index += 1
			_:
				break

	token_kind_is_symbol(
		token_kind_at(state, index),
		end_symbol,
	)


private pure func consume_layout_before_end_symbol(
	state: ParserInput,
	index: Int,
	end_symbol: Symbol,
) -> Int:
	var st: Int = index

	if layout_reaches_end_symbol(state, st, end_symbol):
		while True:
			if current_is_newline(state, st) or current_is_dedent(state, st):
				st = advance_parser(state, st)
			else:
				break

	st


private pure func parse_expr_list_until(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	end_symbol: Symbol,
	allow_empty: Bool,
	header_span: SourceSpan,
) -> ParseExprListStep:
	var st: Int = index
	var st_diag: List[ParseDiagnostic] = diagnostics
	var values: List[ParsedExpr] = []

	if allow_empty and current_is_symbol(state, st, end_symbol):
		{
			index = st,
			diagnostics = st_diag,
			values = values
		}
	else:
		var parsing_values: Bool = True

		while parsing_values and not current_is_eof(state, st):
			expr_step: ParseExprStep = parse_header_anchored_expression(
				state,
				st,
				st_diag,
				header_span,
			)
			values = values.append(expr_step.value)
			st = expr_step.index
			st_diag = expr_step.diagnostics

			if current_is_symbol(state, st, CommaSymbol):
				st = advance_parser(state, st)

				if current_is_newline(state, st) or current_is_dedent(state, st):
					st = consume_layout_before_end_symbol(
						state,
						skip_newlines(state, st),
						end_symbol,
					)
				else:
					st = skip_newlines(state, st)

				if current_is_symbol(state, st, end_symbol):
					parsing_values = False
			else:
				parsing_values = False

		{
			index = st,
			diagnostics = st_diag,
			values = values
		}


private pure func parse_pattern_list_until(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	end_symbol: Symbol,
	allow_empty: Bool,
) -> ParsePatternListStep:
	var st: Int = index
	var st_diag: List[ParseDiagnostic] = diagnostics
	var values: List[ParsedPattern] = []

	if allow_empty and current_is_symbol(state, st, end_symbol):
		{
			index = st,
			diagnostics = st_diag,
			values = values
		}
	else:
		var parsing_values: Bool = True

		while parsing_values and not current_is_eof(state, st):
			pattern_step: ParsePatternStep = parse_pattern(state, st, st_diag)
			values = values.append(pattern_step.value)
			st = pattern_step.index
			st_diag = pattern_step.diagnostics

			if current_is_symbol(state, st, CommaSymbol):
				st = advance_parser(state, st)

				if current_is_symbol(state, st, end_symbol):
					parsing_values = False
			else:
				parsing_values = False

		{
			index = st,
			diagnostics = st_diag,
			values = values
		}


private pure func add_tuple_arity_error(
	diagnostics: List[ParseDiagnostic],
	span: SourceSpan,
) -> List[ParseDiagnostic]:
	add_expected_error(
		diagnostics,
		span,
		"Tuples support 2-4 elements",
		["2-4 tuple elements"],
		None,
	)


private pure func parse_tuple_pattern_after_left_paren(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	start_span: SourceSpan,
) -> ParsePatternStep:
	first_step: ParsePatternStep = parse_pattern(state, index, diagnostics)
	var st: Int = first_step.index
	var st_diag: List[ParseDiagnostic] = first_step.diagnostics
	var items: List[ParsedPattern] = [first_step.value]
	var end_span: SourceSpan = parsed_pattern_span(first_step.value)

	comma_step: ParseSymbolStep = expect_symbol(
		state,
		st,
		st_diag,
		CommaSymbol,
		"expected `, ` between tuple pattern items",
	)
	st = comma_step.index
	st_diag = comma_step.diagnostics

	if comma_step.matched:
		rest_step: ParsePatternListStep = parse_pattern_list_until(
			state,
			st,
			st_diag,
			RightParenSymbol,
			True,
		)
		items = items.concat(rest_step.values)
		st = rest_step.index
		st_diag = rest_step.diagnostics

		match rest_step.values.get(rest_step.values.length() - 1):
			Some(last):
				end_span = parsed_pattern_span(last)
			None:
				end_span = comma_step.span

	right_step: ParseSymbolStep = expect_symbol(
		state,
		st,
		st_diag,
		RightParenSymbol,
		"expected `)` after tuple pattern",
	)
	st = right_step.index
	st_diag = right_step.diagnostics

	if right_step.matched:
		end_span = right_step.span

	if items.length() < 2 or items.length() > 4:
		st_diag = add_tuple_arity_error(
			st_diag,
			span_cover(start_span, end_span),
		)

	{
		index = st,
		diagnostics = st_diag,
		value = ParsedTuplePattern(
			items,
			span_cover(start_span, end_span),
		)
	}


private pure func parse_list_pattern_spread_after_dotdotdot(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	start_span: SourceSpan,
) -> ParseListPatternSpreadStep:
	token: Token = current_token(state, index)

	match token.kind:
		IdentifierToken(text):
			name: ParsedIdentifier = parsed_identifier(text, token.span)
			{
				index = advance_parser(state, index),
				diagnostics = diagnostics,
				value = ParsedListSpreadName(name),
				span = span_cover(start_span, token.span)
			}
		SymbolToken(UnderscoreSymbol):
			{
				index = advance_parser(state, index),
				diagnostics = diagnostics,
				value = ParsedListSpreadWildcard(token.span),
				span = span_cover(start_span, token.span)
			}
		_:
			next_state: Int = index
			next_state_diag: List[ParseDiagnostic] = add_expected_error(
				diagnostics,
				token.span,
				"expected list pattern spread target",
				["identifier", "_"],
				None,
			)

			recovery_state: Int = if current_is_soft_boundary(state, next_state):
				next_state
			else:
				advance_parser(state, next_state)

			{
				index = recovery_state,
				diagnostics = next_state_diag,
				value = ParsedListSpreadWildcard(token.span),
				span = span_cover(start_span, token.span)
			}


private pure func parse_list_pattern_after_left_bracket(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	start_span: SourceSpan,
) -> ParsePatternStep:
	var st: Int = index
	var st_diag: List[ParseDiagnostic] = diagnostics
	var items: List[ParsedPattern] = []
	var spread: Option[ParsedListPatternSpread] = None
	var end_span: SourceSpan = start_span

	if not current_is_symbol(state, st, RightBracketSymbol):
		if current_is_symbol(state, st, DotDotDotSymbol):
			dots_span: SourceSpan = current_span(state, st)
			spread_step: ParseListPatternSpreadStep = parse_list_pattern_spread_after_dotdotdot(
				state,
				advance_parser(state, st),
				st_diag,
				dots_span,
			)
			spread = Some(spread_step.value)
			end_span = spread_step.span
			st = spread_step.index
			st_diag = spread_step.diagnostics
		else:
			var parsing_items: Bool = True

			while parsing_items and not current_is_eof(state, st):
				pattern_step: ParsePatternStep = parse_pattern(state, st, st_diag)
				items = items.append(pattern_step.value)
				st = pattern_step.index
				st_diag = pattern_step.diagnostics
				end_span = parsed_pattern_span(pattern_step.value)

				if current_is_symbol(state, st, CommaSymbol):
					st = advance_parser(state, st)

					if current_is_symbol(state, st, DotDotDotSymbol):
						dots_span: SourceSpan = current_span(state, st)
						spread_step: ParseListPatternSpreadStep = parse_list_pattern_spread_after_dotdotdot(
							state,
							advance_parser(state, st),
							st_diag,
							dots_span,
						)
						spread = Some(spread_step.value)
						end_span = spread_step.span
						st = spread_step.index
						st_diag = spread_step.diagnostics
						parsing_items = False
				else:
					parsing_items = False

	right_step: ParseSymbolStep = expect_symbol(
		state,
		st,
		st_diag,
		RightBracketSymbol,
		"expected `]` after list pattern",
	)
	st = right_step.index
	st_diag = right_step.diagnostics

	if right_step.matched:
		end_span = right_step.span

	{
		index = st,
		diagnostics = st_diag,
		value = ParsedListPattern(
			items,
			spread,
			span_cover(start_span, end_span),
		)
	}


private pure func parse_simple_pattern(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParsePatternStep:
	token: Token = current_token(state, index)

	match token.kind:
		SymbolToken(UnderscoreSymbol):
			{
				index = advance_parser(state, index),
				diagnostics = diagnostics,
				value = ParsedWildcardPattern(token.span)
			}
		IdentifierToken(text):
			name: ParsedIdentifier = parsed_identifier(text, token.span)
			var st: Int = advance_parser(state, index)
			var st_diag: List[ParseDiagnostic] = diagnostics

			if current_is_symbol(state, st, DotSymbol):
				constructor_step: ParseIdentifierStep = parse_identifier_expected(
					state,
					advance_parser(state, st),
					st_diag,
					EXPECTED_CONSTRUCTOR_NAME,
				)
				constructor_name: ParsedIdentifier = constructor_step.value
				st = constructor_step.index
				st_diag = constructor_step.diagnostics
				var args: List[ParsedPattern] = []
				var end_span: SourceSpan = constructor_name.span

				if current_is_symbol(state, st, LeftParenSymbol):
					args_step: ParsePatternListStep = parse_pattern_list_until(
						state,
						advance_parser(state, st),
						st_diag,
						RightParenSymbol,
						True,
					)
					right_step: ParseSymbolStep = expect_symbol(
						state,
						args_step.index,
						args_step.diagnostics,
						RightParenSymbol,
						"expected `)` after constructor pattern",
					)
					st = right_step.index
					st_diag = right_step.diagnostics
					args = args_step.values

					if right_step.matched:
						end_span = right_step.span

				result: ParsePatternStep = {
					index = st,
					diagnostics = st_diag,
					value = ParsedQualifiedConstructorPattern(
						name,
						constructor_name,
						args,
						span_cover(name.span, end_span),
					)
				}
				result
			else if current_is_symbol(state, st, LeftParenSymbol):
				args_step: ParsePatternListStep = parse_pattern_list_until(
					state,
					advance_parser(state, st),
					st_diag,
					RightParenSymbol,
					True,
				)
				right_step: ParseSymbolStep = expect_symbol(
					state,
					args_step.index,
					args_step.diagnostics,
					RightParenSymbol,
					"expected `)` after constructor pattern",
				)

				end_span: SourceSpan = if right_step.matched:
					right_step.span
				else:
					name.span

				result: ParsePatternStep = {
					index = right_step.index,
					diagnostics = right_step.diagnostics,
					value = ParsedConstructorPattern(
						name,
						args_step.values,
						span_cover(name.span, end_span),
					)
				}
				result
			else:
				result: ParsePatternStep = {
					index = st,
					diagnostics = st_diag,
					value = ParsedNamePattern(name)
				}
				result
		KeywordToken(TrueKeyword):
			{
				index = advance_parser(state, index),
				diagnostics = diagnostics,
				value = ParsedBoolPattern(True, token.span)
			}
		KeywordToken(FalseKeyword):
			{
				index = advance_parser(state, index),
				diagnostics = diagnostics,
				value = ParsedBoolPattern(False, token.span)
			}
		KeywordToken(keyword):
			match soft_keyword_identifier_text(keyword):
				Some(text):
					{
						index = advance_parser(state, index),
						diagnostics = diagnostics,
						value = ParsedNamePattern(parsed_identifier(text, token.span))
					}
				None:
					name_step: ParseIdentifierStep = parse_reserved_keyword_as_name(
						state,
						index,
						diagnostics,
						keyword,
						token.span,
					)

					{
						index = name_step.index,
						diagnostics = name_step.diagnostics,
						value = ParsedNamePattern(name_step.value)
					}
		SymbolToken(LeftParenSymbol):
			parse_tuple_pattern_after_left_paren(
				state,
				advance_parser(state, index),
				diagnostics,
				token.span,
			)
		SymbolToken(LeftBracketSymbol):
			parse_list_pattern_after_left_bracket(
				state,
				advance_parser(state, index),
				diagnostics,
				token.span,
			)
		IntLiteralToken(text):
			{
				index = advance_parser(state, index),
				diagnostics = diagnostics,
				value = ParsedIntPattern(text, token.span)
			}
		FloatLiteralToken(text):
			{
				index = advance_parser(state, index),
				diagnostics = diagnostics,
				value = ParsedFloatPattern(text, token.span)
			}
		StringLiteralToken(kind, text):
			{
				index = advance_parser(state, index),
				diagnostics = diagnostics,
				value = ParsedStringPattern(text, parsed_string_literal_form(kind), token.span)
			}
		CharLiteralToken(codepoint):
			{
				index = advance_parser(state, index),
				diagnostics = diagnostics,
				value = ParsedCharPattern(codepoint, token.span)
			}
		SymbolToken(MinusSymbol):
			next_token: Token = token_at(state, index + 1)

			match next_token.kind:
				IntLiteralToken(text):
					{
						index = advance_parser(
							state,
							advance_parser(state, index),
						),
						diagnostics = diagnostics,
						value = ParsedIntPattern(
							"-" + text,
							span_cover(token.span, next_token.span),
						)
					}
				FloatLiteralToken(text):
					{
						index = advance_parser(
							state,
							advance_parser(state, index),
						),
						diagnostics = diagnostics,
						value = ParsedFloatPattern(
							"-" + text,
							span_cover(token.span, next_token.span),
						)
					}
				_:
					next_state: Int = index
					next_state_diag: List[ParseDiagnostic] = add_expected_error(
						diagnostics,
						token.span,
						"expected numeric literal after `-` in pattern",
						["integer literal", "float literal"],
						None,
					)

					{
						index = advance_parser(state, next_state),
						diagnostics = next_state_diag,
						value = ParsedMissingPattern(token.span)
					}
		_:
			next_state: Int = index
			next_state_diag: List[ParseDiagnostic] = add_expected_error(
				diagnostics,
				token.span,
				"expected pattern",
				["pattern"],
				None,
			)

			recovery_state: Int = if current_is_soft_boundary(state, next_state):
				next_state
			else:
				advance_parser(state, next_state)

			{
				index = recovery_state,
				diagnostics = next_state_diag,
				value = ParsedMissingPattern(token.span)
			}


private pure func parse_pattern(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParsePatternStep:
	first_step: ParsePatternStep = parse_simple_pattern(state, index, diagnostics)
	var st: Int = first_step.index
	var st_diag: List[ParseDiagnostic] = first_step.diagnostics
	var patterns: List[ParsedPattern] = [first_step.value]
	var end_span: SourceSpan = parsed_pattern_span(first_step.value)

	while current_is_symbol(state, st, PipeSymbol) and not current_is_eof(state, st):
		next_step: ParsePatternStep = parse_simple_pattern(
			state,
			advance_parser(state, st),
			st_diag,
		)
		patterns = patterns.append(next_step.value)
		st = next_step.index
		st_diag = next_step.diagnostics
		end_span = parsed_pattern_span(next_step.value)

	if patterns.length() == 1:
		first_step
	else:
		{
			index = st,
			diagnostics = st_diag,
			value = ParsedOrPattern(
				patterns,
				span_cover(parsed_pattern_span(first_step.value), end_span),
			)
		}


private pure func last_expr_span(items: List[ParsedExpr], fallback: SourceSpan) -> SourceSpan:
	var span: SourceSpan = fallback

	for item in items:
		span = parsed_expr_span(item)

	span


private pure func first_expr_span(items: List[ParsedExpr], fallback: SourceSpan) -> SourceSpan:
	match items.get(0):
		Some(item):
			parsed_expr_span(item)
		None:
			fallback


private pure func current_token_is_indented_past(
	state: ParserInput,
	index: Int,
	header_span: SourceSpan,
) -> Bool:
	(
		not current_is_eof(state, index)
		and not current_is_dedent(state, index)
		and current_span(state, index).start_line > header_span.start_line
		and current_span(state, index).start_column > header_span.start_column
	)


private pure func consume_block_indent(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	header_span: SourceSpan,
) -> ParserStep:
	st: Int = skip_newlines(state, index)

	if current_is_indent(state, st):
		{
			index = advance_parser(state, st),
			diagnostics = diagnostics
		}
	else if current_token_is_indented_past(state, st, header_span):
		{
			index = st,
			diagnostics = diagnostics
		}
	else:
		expect_indent(state, st, diagnostics)


private pure func parse_statement_list(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	header_span: SourceSpan,
) -> ParseExprListStep:
	var st: Int = skip_newlines(state, index)
	var st_diag: List[ParseDiagnostic] = diagnostics
	var values: List[ParsedExpr] = []

	while (
		current_token_is_indented_past(state, st, header_span)
		and not current_is_block_end(state, st)
	):
		before_index: Int = st
		statement_step: ParseExprStep = parse_statement(state, st, st_diag)
		values = values.append(statement_step.value)
		st = skip_newlines(state, statement_step.index)
		st_diag = statement_step.diagnostics

		if (
			st == before_index
			and current_token_is_indented_past(state, st, header_span)
			and not current_is_block_end(state, st)
		):
			st = advance_parser(state, st)

	{
		index = st,
		diagnostics = st_diag,
		values = values
	}


private pure func parse_indented_block_body(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	start_span: SourceSpan,
) -> ParseExprStep:
	__step_2: ParserStep = consume_block_indent(state, index, diagnostics, start_span)
	var st: Int = __step_2.index
	var st_diag: List[ParseDiagnostic] = __step_2.diagnostics
	st = skip_newlines(state, st)
	items_step: ParseExprListStep = parse_statement_list(state, st, st_diag, start_span)
	st = items_step.index
	st_diag = items_step.diagnostics

	block_start_span: SourceSpan = first_expr_span(items_step.values, start_span)
	block_end_span: SourceSpan = last_expr_span(items_step.values, block_start_span)

	if current_is_dedent(state, st):
		__step_3: ParserStep = expect_dedent(state, st, st_diag)
		st = __step_3.index
		st_diag = __step_3.diagnostics

	{
		index = st,
		diagnostics = st_diag,
		value = ParsedBlockExpr(
			items_step.values,
			span_cover(block_start_span, block_end_span),
		)
	}


private pure func parse_block_after_colon(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	start_span: SourceSpan,
) -> ParseExprStep:
	newline_step: ParserStep = expect_newline(
		state,
		index,
		diagnostics,
		"expected newline before indented block",
	)
	parse_indented_block_body(state, newline_step.index, newline_step.diagnostics, start_span)


private pure func parse_if_expr_with_header_span(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	header_span: SourceSpan,
) -> ParseExprStep:
	start_span: SourceSpan = current_span(state, index)
	cond_step: ParseExprStep = parse_expression(
		state,
		advance_parser(state, index),
		diagnostics,
		PREC_LOWEST,
	)
	colon_step: ParseSymbolStep = expect_symbol(
		state,
		cond_step.index,
		cond_step.diagnostics,
		ColonSymbol,
		"expected `:` after if condition",
	)
	then_step: ParseExprStep = parse_block_after_colon(
		state,
		colon_step.index,
		colon_step.diagnostics,
		header_span,
	)
	var st: Int = then_step.index
	var st_diag: List[ParseDiagnostic] = then_step.diagnostics
	var else_branch: Option[ParsedExpr] = None
	var end_span: SourceSpan = parsed_expr_span(then_step.value)

	if current_is_keyword(state, st, ElseKeyword):
		else_span: SourceSpan = current_span(state, st)
		st = advance_parser(state, st)

		if current_is_keyword(state, st, IfKeyword):
			else_if_step: ParseExprStep = parse_if_expr_with_header_span(
				state,
				st,
				st_diag,
				else_span,
			)
			else_branch = Some(else_if_step.value)
			st = else_if_step.index
			st_diag = else_if_step.diagnostics
			end_span = parsed_expr_span(else_if_step.value)
		else:
			else_colon_step: ParseSymbolStep = expect_symbol(
				state,
				st,
				st_diag,
				ColonSymbol,
				"expected `:` after else",
			)
			else_step: ParseExprStep = parse_block_after_colon(
				state,
				else_colon_step.index,
				else_colon_step.diagnostics,
				else_span,
			)
			else_branch = Some(else_step.value)
			st = else_step.index
			st_diag = else_step.diagnostics
			end_span = parsed_expr_span(else_step.value)

	{
		index = st,
		diagnostics = st_diag,
		value = ParsedIfExpr(
			cond_step.value,
			then_step.value,
			else_branch,
			span_cover(start_span, end_span),
		)
	}


private pure func parse_match_case(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseMatchCaseStep:
	pattern_step: ParsePatternStep = parse_pattern(state, index, diagnostics)
	colon_step: ParseSymbolStep = expect_symbol(
		state,
		pattern_step.index,
		pattern_step.diagnostics,
		ColonSymbol,
		"expected `:` after match pattern",
	)

	body_step: ParseExprStep = if current_is_newline(state, colon_step.index):
		parse_block_after_colon(
			state,
			colon_step.index,
			colon_step.diagnostics,
			parsed_pattern_span(pattern_step.value),
		)
	else if current_is_keyword(state, colon_step.index, MatchKeyword):
		parse_match_expr_with_header_span(
			state,
			colon_step.index,
			colon_step.diagnostics,
			parsed_pattern_span(pattern_step.value),
		)
	else if current_is_keyword(state, colon_step.index, IfKeyword):
		parse_if_expr_with_header_span(
			state,
			colon_step.index,
			colon_step.diagnostics,
			parsed_pattern_span(pattern_step.value),
		)
	else:
		parse_statement(state, colon_step.index, colon_step.diagnostics)

	{
		index = body_step.index,
		diagnostics = body_step.diagnostics,
		value = {
			pattern = pattern_step.value,
			body = body_step.value,
			span = span_cover(
				parsed_pattern_span(pattern_step.value),
				parsed_expr_span(body_step.value),
			)
		}
	}


private pure func parse_match_case_list(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	header_span: SourceSpan,
) -> ParseMatchCaseListStep:
	var st: Int = skip_newlines(state, index)
	var st_diag: List[ParseDiagnostic] = diagnostics
	var cases: List[ParsedMatchCase] = []

	while (
		current_token_is_indented_past(state, st, header_span)
		and not current_is_block_end(state, st)
	):
		before_index: Int = st
		case_step: ParseMatchCaseStep = parse_match_case(state, st, st_diag)
		cases = cases.append(case_step.value)
		st = skip_newlines(state, case_step.index)
		st_diag = case_step.diagnostics

		if (
			st == before_index
			and current_token_is_indented_past(state, st, header_span)
			and not current_is_block_end(state, st)
		):
			st = advance_parser(state, st)

	{
		index = st,
		diagnostics = st_diag,
		values = cases
	}


private pure func parse_match_expr_with_header_span(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	header_span: SourceSpan,
) -> ParseExprStep:
	start_span: SourceSpan = current_span(state, index)
	scrutinee_step: ParseExprStep = parse_expression(
		state,
		advance_parser(state, index),
		diagnostics,
		PREC_LOWEST,
	)
	colon_step: ParseSymbolStep = expect_symbol(
		state,
		scrutinee_step.index,
		scrutinee_step.diagnostics,
		ColonSymbol,
		"expected `:` after match expression",
	)
	__step_4: ParserStep = expect_newline(
		state,
		colon_step.index,
		colon_step.diagnostics,
		"expected newline before match cases",
	)
	var st: Int = __step_4.index
	var st_diag: List[ParseDiagnostic] = __step_4.diagnostics
	__step_5: ParserStep = consume_block_indent(state, st, st_diag, header_span)
	st = __step_5.index
	st_diag = __step_5.diagnostics
	cases_step: ParseMatchCaseListStep = parse_match_case_list(state, st, st_diag, header_span)
	st = cases_step.index
	st_diag = cases_step.diagnostics

	end_span: SourceSpan = if current_is_dedent(state, st):
		current_span(state, st)
	else:
		start_span

	if current_is_dedent(state, st):
		__step_6: ParserStep = expect_dedent(state, st, st_diag)
		st = __step_6.index
		st_diag = __step_6.diagnostics

	{
		index = st,
		diagnostics = st_diag,
		value = ParsedMatchExpr(
			scrutinee_step.value,
			cases_step.values,
			span_cover(start_span, end_span),
		)
	}


private pure func parse_select_receive_arm(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	start_span: SourceSpan,
) -> ParseSelectArmStep:
	binder_step: ParseIdentifierStep = parse_select_receive_identifier_expected(
		state,
		index,
		diagnostics,
		"select receive binding",
	)
	__step_7: ParserStep = expect_keyword(
		state,
		binder_step.index,
		binder_step.diagnostics,
		FromKeyword,
		"from",
		"expected `from` after select receive binding",
	)
	var st: Int = __step_7.index
	var st_diag: List[ParseDiagnostic] = __step_7.diagnostics
	channel_step: ParseExprStep = parse_expression(state, st, st_diag, PREC_LOWEST)
	colon_step: ParseSymbolStep = expect_symbol(
		state,
		channel_step.index,
		channel_step.diagnostics,
		ColonSymbol,
		"expected `:` after select receive channel",
	)
	body_step: ParseExprStep = parse_block_after_colon(
		state,
		colon_step.index,
		colon_step.diagnostics,
		start_span,
	)

	{
		index = body_step.index,
		diagnostics = body_step.diagnostics,
		value = {
			kind = ParsedSelectReceiveArm(binder_step.value, channel_step.value),
			body = body_step.value,
			span = span_cover(start_span, parsed_expr_span(body_step.value))
		}
	}


private pure func parse_select_sealed_arm(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	start_span: SourceSpan,
) -> ParseSelectArmStep:
	channel_step: ParseExprStep = parse_expression(
		state,
		advance_parser(state, index),
		diagnostics,
		PREC_LOWEST,
	)
	colon_step: ParseSymbolStep = expect_symbol(
		state,
		channel_step.index,
		channel_step.diagnostics,
		ColonSymbol,
		"expected `:` after sealed select channel",
	)
	body_step: ParseExprStep = parse_block_after_colon(
		state,
		colon_step.index,
		colon_step.diagnostics,
		start_span,
	)

	{
		index = body_step.index,
		diagnostics = body_step.diagnostics,
		value = {
			kind = ParsedSelectSealedArm(channel_step.value),
			body = body_step.value,
			span = span_cover(start_span, parsed_expr_span(body_step.value))
		}
	}


private pure func parse_select_after_arm(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	start_span: SourceSpan,
) -> ParseSelectArmStep:
	var st: Int = advance_parser(state, index)
	var st_diag: List[ParseDiagnostic] = diagnostics
	__step_8: ParserStep = expect_keyword(
		state,
		st,
		st_diag,
		AfterKeyword,
		"after",
		"expected `after` in select timeout arm",
	)
	st = __step_8.index
	st_diag = __step_8.diagnostics
	timeout_step: ParseExprStep = parse_expression(state, st, st_diag, PREC_LOWEST)
	colon_step: ParseSymbolStep = expect_symbol(
		state,
		timeout_step.index,
		timeout_step.diagnostics,
		ColonSymbol,
		"expected `:` after select timeout",
	)
	body_step: ParseExprStep = parse_block_after_colon(
		state,
		colon_step.index,
		colon_step.diagnostics,
		start_span,
	)

	{
		index = body_step.index,
		diagnostics = body_step.diagnostics,
		value = {
			kind = ParsedSelectAfterArm(timeout_step.value),
			body = body_step.value,
			span = span_cover(start_span, parsed_expr_span(body_step.value))
		}
	}


private pure func parse_select_arm(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseSelectArmStep:
	start_span: SourceSpan = current_span(state, index)

	if current_is_keyword(state, index, SealedKeyword):
		parse_select_sealed_arm(state, index, diagnostics, start_span)
	else if (
		current_is_symbol(state, index, UnderscoreSymbol)
		and next_is_keyword(state, index, AfterKeyword)
	):
		parse_select_after_arm(state, index, diagnostics, start_span)
	else:
		parse_select_receive_arm(state, index, diagnostics, start_span)


private pure func parse_select_arm_list(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	header_span: SourceSpan,
) -> ParseSelectArmListStep:
	var st: Int = skip_newlines(state, index)
	var st_diag: List[ParseDiagnostic] = diagnostics
	var values: List[ParsedSelectArm] = []

	while (
		current_token_is_indented_past(state, st, header_span)
		and not current_is_block_end(state, st)
	):
		before_index: Int = st
		arm_step: ParseSelectArmStep = parse_select_arm(state, st, st_diag)
		values = values.append(arm_step.value)
		st = skip_newlines(state, arm_step.index)
		st_diag = arm_step.diagnostics

		if (
			st == before_index
			and current_token_is_indented_past(state, st, header_span)
			and not current_is_block_end(state, st)
		):
			st = advance_parser(state, st)

	{
		index = st,
		diagnostics = st_diag,
		values = values
	}


private pure func parse_select_expr_with_header_span(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	header_span: SourceSpan,
) -> ParseExprStep:
	start_span: SourceSpan = current_span(state, index)
	var st: Int = advance_parser(state, index)
	var st_diag: List[ParseDiagnostic] = diagnostics
	colon_step: ParseSymbolStep = expect_symbol(
		state,
		st,
		st_diag,
		ColonSymbol,
		"expected `:` after select",
	)
	__step_9: ParserStep = expect_newline(
		state,
		colon_step.index,
		colon_step.diagnostics,
		"expected newline before select arms",
	)
	st = __step_9.index
	st_diag = __step_9.diagnostics
	__step_10: ParserStep = consume_block_indent(state, st, st_diag, header_span)
	st = __step_10.index
	st_diag = __step_10.diagnostics
	arms_step: ParseSelectArmListStep = parse_select_arm_list(state, st, st_diag, header_span)
	st = arms_step.index
	st_diag = arms_step.diagnostics

	end_span: SourceSpan = if current_is_dedent(state, st):
		current_span(state, st)
	else:
		start_span

	if current_is_dedent(state, st):
		__step_11: ParserStep = expect_dedent(state, st, st_diag)
		st = __step_11.index
		st_diag = __step_11.diagnostics

	{
		index = st,
		diagnostics = st_diag,
		value = ParsedSelectExpr(
			arms_step.values,
			span_cover(start_span, end_span),
		)
	}


private pure func parse_debug_block_expr(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseExprStep:
	start_span: SourceSpan = current_span(state, index)
	colon_step: ParseSymbolStep = expect_symbol(
		state,
		advance_parser(state, index),
		diagnostics,
		ColonSymbol,
		"expected `:` after debug",
	)
	body_step: ParseExprStep = parse_block_after_colon(
		state,
		colon_step.index,
		colon_step.diagnostics,
		start_span,
	)

	{
		index = body_step.index,
		diagnostics = body_step.diagnostics,
		value = ParsedDebugBlockExpr(
			body_step.value,
			span_cover(start_span, parsed_expr_span(body_step.value)),
		)
	}


private pure func parse_with_error_map_opt(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseWithErrorMapStep:
	if current_is_keyword(state, index, OnKeyword):
		var st: Int = advance_parser(state, index)
		var st_diag: List[ParseDiagnostic] = diagnostics
		name_step: ParseIdentifierStep = parse_binder_identifier_expected(
			state,
			st,
			st_diag,
			"with error name",
		)
		st = name_step.index
		st_diag = name_step.diagnostics
		fat_arrow_step: ParseSymbolStep = expect_symbol(
			state,
			st,
			st_diag,
			FatArrowSymbol,
			"expected `=>` after with error name",
		)
		value_step: ParseExprStep = parse_expression(
			state,
			fat_arrow_step.index,
			fat_arrow_step.diagnostics,
			PREC_LOWEST,
		)

		{
			index = value_step.index,
			diagnostics = value_step.diagnostics,
			value = Some({
				name = name_step.value,
				value = value_step.value,
				span = span_cover(name_step.value.span, parsed_expr_span(value_step.value)),
			})
		}
	else:
		{
			index = index,
			diagnostics = diagnostics,
			value = None
		}


private pure func parse_with_binding(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseWithBindingStep:
	name_step: ParseIdentifierStep = parse_binder_identifier_expected(
		state,
		index,
		diagnostics,
		"with binding name",
	)
	type_step: ParseOptionalTypeStep = parse_optional_type_annotation(
		state,
		name_step.index,
		name_step.diagnostics,
	)
	var st: Int = type_step.index
	var st_diag: List[ParseDiagnostic] = type_step.diagnostics
	var kind: ParsedWithBindingKind = ParsedWithPlainBinding

	if current_is_symbol(state, st, QuestionEqualsSymbol):
		kind = ParsedWithTryBinding
		st = advance_parser(state, st)
	else:
		equal_step: ParseSymbolStep = expect_symbol(
			state,
			st,
			st_diag,
			EqualSymbol,
			"expected `=` or `?=` after with binding",
		)
		st = equal_step.index
		st_diag = equal_step.diagnostics

	value_step: ParseExprStep = parse_expression(state, st, st_diag, PREC_LOWEST)
	st = value_step.index
	st_diag = value_step.diagnostics

	error_map_step: ParseWithErrorMapStep = if kind == ParsedWithTryBinding:
		parse_with_error_map_opt(state, st, st_diag)
	else:
		{
			index = st,
			diagnostics = st_diag,
			value = None
		}

	st = error_map_step.index
	st_diag = error_map_step.diagnostics

	end_span: SourceSpan = match error_map_step.value:
		Some(error_map):
			error_map.span
		None:
			parsed_expr_span(value_step.value)

	{
		index = st,
		diagnostics = st_diag,
		value = {
			name = name_step.value,
			type_expr = type_step.value,
			value = value_step.value,
			kind = kind,
			error_map = error_map_step.value,
			span = span_cover(name_step.value.span, end_span)
		}
	}


private pure func add_with_multi_binding_error(
	diagnostics: List[ParseDiagnostic],
	span: SourceSpan,
) -> List[ParseDiagnostic]:
	add_expected_error(
		diagnostics,
		span,
		(
			"Multiple resource bindings in one `with` header are not supported yet. Nested "
			+ "`with` blocks make resource close order explicit."
		),
		[":"],
		Some("use nested `with` blocks to make resource close order explicit"),
	)


private pure func parse_with_expr(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseExprStep:
	start_span: SourceSpan = current_span(state, index)
	binding_step: ParseWithBindingStep = parse_with_binding(
		state,
		advance_parser(state, index),
		diagnostics,
	)
	var st: Int = binding_step.index
	var st_diag: List[ParseDiagnostic] = binding_step.diagnostics

	if current_is_symbol(state, st, CommaSymbol):
		st_diag = add_with_multi_binding_error(
			st_diag,
			current_span(state, st),
		)

		while (
			not current_is_eof(state, st)
			and not current_is_newline(state, st)
			and not current_is_symbol(state, st, ColonSymbol)
		):
			st = advance_parser(state, st)

	colon_step: ParseSymbolStep = expect_symbol(
		state,
		st,
		st_diag,
		ColonSymbol,
		"expected `:` after with binding",
	)
	body_step: ParseExprStep = parse_block_after_colon(
		state,
		colon_step.index,
		colon_step.diagnostics,
		start_span,
	)

	body: ParsedExpr = match body_step.value:
		ParsedBlockExpr(items, span):
			ParsedBlockExpr(
				items,
				span_cover(
					first_expr_span(items, span),
					span,
				),
			)
		_:
			body_step.value

	{
		index = body_step.index,
		diagnostics = body_step.diagnostics,
		value = ParsedWithExpr(
			binding_step.value,
			body,
			span_cover(start_span, parsed_expr_span(body)),
		)
	}


private pure func parse_concurrent_param(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseConcurrentParamStep:
	name_step: ParseIdentifierStep = parse_identifier_expected(
		state,
		index,
		diagnostics,
		EXPECTED_CONCURRENT_PARAM,
	)
	var st: Int = name_step.index
	var st_diag: List[ParseDiagnostic] = name_step.diagnostics
	colon_step: ParseSymbolStep = expect_symbol(
		state,
		st,
		st_diag,
		ColonSymbol,
		"expected `:` after concurrent parameter name",
	)
	value_step: ParseExprStep = parse_expression(
		state,
		colon_step.index,
		colon_step.diagnostics,
		PREC_LOWEST,
	)

	{
		index = value_step.index,
		diagnostics = value_step.diagnostics,
		value = {
			name = name_step.value,
			value = value_step.value,
			span = span_cover(name_step.value.span, parsed_expr_span(value_step.value))
		}
	}


private pure func parse_concurrent_param_list_after_left_paren(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	empty_help: String,
) -> ParseConcurrentParamListStep:
	var st: Int = index
	var st_diag: List[ParseDiagnostic] = diagnostics
	var values: List[ParsedConcurrentParam] = []

	if current_is_symbol(state, st, RightParenSymbol):
		st_diag = add_expected_error(
			st_diag,
			current_span(state, st),
			"expected concurrent parameter",
			[EXPECTED_CONCURRENT_PARAM],
			Some(empty_help),
		)
	else:
		var parsing_params: Bool = True

		while parsing_params and not current_is_eof(state, st):
			before_index: Int = st
			param_step: ParseConcurrentParamStep = parse_concurrent_param(state, st, st_diag)
			values = values.append(param_step.value)
			st = param_step.index
			st_diag = param_step.diagnostics

			if current_is_symbol(state, st, CommaSymbol):
				st = advance_parser(state, st)

				if current_is_symbol(state, st, RightParenSymbol):
					parsing_params = False
			else if current_is_symbol(state, st, RightParenSymbol):
				parsing_params = False
			else:
				st_diag = add_expected_error(
					st_diag,
					current_span(state, st),
					"expected `, ` between concurrent parameters",
					[","],
					None,
				)

			if st == before_index and not current_is_symbol(state, st, RightParenSymbol):
				st = advance_parser(state, st)

	{
		index = st,
		diagnostics = st_diag,
		values = values
	}


private pure func parse_concurrent_block_expr(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseExprStep:
	start_span: SourceSpan = current_span(state, index)
	var st: Int = advance_parser(state, index)
	var st_diag: List[ParseDiagnostic] = diagnostics
	var params: List[ParsedConcurrentParam] = []

	if current_is_symbol(state, st, LeftParenSymbol):
		params_step: ParseConcurrentParamListStep = parse_concurrent_param_list_after_left_paren(
			state,
			advance_parser(state, st),
			st_diag,
			"omit the parentheses for a concurrent block with no parameters",
		)
		params = params_step.values
		right_step: ParseSymbolStep = expect_symbol(
			state,
			params_step.index,
			params_step.diagnostics,
			RightParenSymbol,
			"expected `)` after concurrent parameters",
		)
		st = right_step.index
		st_diag = right_step.diagnostics

	colon_step: ParseSymbolStep = expect_symbol(
		state,
		st,
		st_diag,
		ColonSymbol,
		"expected `:` after concurrent",
	)
	body_step: ParseExprStep = parse_block_after_colon(
		state,
		colon_step.index,
		colon_step.diagnostics,
		start_span,
	)

	{
		index = body_step.index,
		diagnostics = body_step.diagnostics,
		value = ParsedConcurrentBlockExpr(
			params,
			body_step.value,
			span_cover(start_span, parsed_expr_span(body_step.value)),
		)
	}


private pure func parse_concurrent_for_tail(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	binder: ParsedIdentifier,
	iterable: ParsedExpr,
	start_span: SourceSpan,
	header_span: SourceSpan,
) -> ParseExprStep:
	var st: Int = advance_parser(state, index)
	var st_diag: List[ParseDiagnostic] = diagnostics
	var params: List[ParsedConcurrentParam] = []

	if current_is_symbol(state, st, LeftParenSymbol):
		params_step: ParseConcurrentParamListStep = parse_concurrent_param_list_after_left_paren(
			state,
			advance_parser(state, st),
			st_diag,
			"write at least `limit: N` inside concurrently(...)",
		)
		params = params_step.values
		right_step: ParseSymbolStep = expect_symbol(
			state,
			params_step.index,
			params_step.diagnostics,
			RightParenSymbol,
			"expected `)` after concurrently parameters",
		)
		st = right_step.index
		st_diag = right_step.diagnostics
	else:
		st_diag = add_expected_error(
			st_diag,
			current_span(state, st),
			"expected `(` after concurrently",
			["("],
			Some("write `for x in xs concurrently(limit: N):`"),
		)

	colon_step: ParseSymbolStep = expect_symbol(
		state,
		st,
		st_diag,
		ColonSymbol,
		"expected `:` after concurrently parameters",
	)
	body_step: ParseExprStep = parse_block_after_colon(
		state,
		colon_step.index,
		colon_step.diagnostics,
		header_span,
	)

	{
		index = body_step.index,
		diagnostics = body_step.diagnostics,
		value = ParsedConcurrentForExpr(
			binder,
			iterable,
			params,
			body_step.value,
			span_cover(start_span, parsed_expr_span(body_step.value)),
		)
	}


private pure func parse_tuple_binder_identifier_expected(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	expected: String,
	mode: TupleBinderIdentifierMode,
) -> ParseIdentifierStep:
	match mode:
		TupleBinderNamesOnly:
			parse_declared_name_expected(state, index, diagnostics, expected)
		TupleBinderNamesOrUnderscore:
			parse_binder_identifier_expected(state, index, diagnostics, expected)


private pure func parse_tuple_binder_after_left_paren(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	start_span: SourceSpan,
	mode: TupleBinderIdentifierMode,
	item_expected: String,
	comma_message: String,
	missing_after_comma_message: String,
	close_message: String,
) -> ParseTupleBinderStep:
	var st: Int = index
	var st_diag: List[ParseDiagnostic] = diagnostics
	var values: List[ParsedIdentifier] = []
	var end_span: SourceSpan = start_span

	first_step: ParseIdentifierStep = parse_tuple_binder_identifier_expected(
		state,
		st,
		st_diag,
		item_expected,
		mode,
	)
	values = values.append(first_step.value)
	st = first_step.index
	st_diag = first_step.diagnostics
	end_span = first_step.value.span

	comma_step: ParseSymbolStep = expect_symbol(state, st, st_diag, CommaSymbol, comma_message)
	st = comma_step.index
	st_diag = comma_step.diagnostics

	if comma_step.matched:
		var parsing_values: Bool = True

		while parsing_values and not current_is_eof(state, st):
			if current_is_symbol(state, st, RightParenSymbol):
				st_diag = add_expected_error(
					st_diag,
					current_span(state, st),
					missing_after_comma_message,
					[item_expected],
					None,
				)
				parsing_values = False
			else:
				item_step: ParseIdentifierStep = parse_tuple_binder_identifier_expected(
					state,
					st,
					st_diag,
					item_expected,
					mode,
				)
				values = values.append(item_step.value)
				st = item_step.index
				st_diag = item_step.diagnostics
				end_span = item_step.value.span

				if current_is_symbol(state, st, CommaSymbol):
					st = advance_parser(state, st)

					if current_is_symbol(state, st, RightParenSymbol):
						parsing_values = False
				else:
					parsing_values = False

	right_step: ParseSymbolStep = expect_symbol(state, st, st_diag, RightParenSymbol, close_message)
	st = right_step.index
	st_diag = right_step.diagnostics

	if right_step.matched:
		end_span = right_step.span

	if values.length() < 2 or values.length() > 4:
		st_diag = add_tuple_arity_error(
			st_diag,
			span_cover(start_span, end_span),
		)

	{
		index = st,
		diagnostics = st_diag,
		values = values,
		span = span_cover(start_span, end_span)
	}


private pure func parse_for_tuple_binder_after_left_paren(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	start_span: SourceSpan,
) -> ParseForBinderStep:
	binder_step: ParseTupleBinderStep = parse_tuple_binder_after_left_paren(
		state,
		index,
		diagnostics,
		start_span,
		TupleBinderNamesOrUnderscore,
		"tuple loop variable",
		"expected `, ` between tuple loop variables",
		"expected tuple loop variable after `, `",
		"expected `)` after tuple loop variables",
	)

	{
		index = binder_step.index,
		diagnostics = binder_step.diagnostics,
		value = ParsedForTupleBinder(binder_step.values, binder_step.span)
	}


private pure func parse_for_binder(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseForBinderStep:
	if current_is_symbol(state, index, LeftParenSymbol):
		parse_for_tuple_binder_after_left_paren(
			state,
			advance_parser(state, index),
			diagnostics,
			current_span(state, index),
		)
	else:
		name_step: ParseIdentifierStep = parse_binder_identifier_expected(
			state,
			index,
			diagnostics,
			"for loop variable",
		)

		{
			index = name_step.index,
			diagnostics = name_step.diagnostics,
			value = ParsedForNameBinder(name_step.value)
		}


private pure func parse_while_expr(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseExprStep:
	start_span: SourceSpan = current_span(state, index)
	cond_step: ParseExprStep = parse_expression(
		state,
		advance_parser(state, index),
		diagnostics,
		PREC_LOWEST,
	)
	colon_step: ParseSymbolStep = expect_symbol(
		state,
		cond_step.index,
		cond_step.diagnostics,
		ColonSymbol,
		"expected `:` after while condition",
	)
	body_step: ParseExprStep = parse_block_after_colon(
		state,
		colon_step.index,
		colon_step.diagnostics,
		start_span,
	)

	{
		index = body_step.index,
		diagnostics = body_step.diagnostics,
		value = ParsedWhileExpr(
			cond_step.value,
			body_step.value,
			span_cover(start_span, parsed_expr_span(body_step.value)),
		)
	}


private pure func parse_for_expr_with_header_span(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	header_span: SourceSpan,
) -> ParseExprStep:
	start_span: SourceSpan = current_span(state, index)
	binder_step: ParseForBinderStep = parse_for_binder(
		state,
		advance_parser(state, index),
		diagnostics,
	)
	__step_12: ParserStep = expect_keyword(
		state,
		binder_step.index,
		binder_step.diagnostics,
		InKeyword,
		"in",
		"expected `in` after for loop variable",
	)
	var st: Int = __step_12.index
	var st_diag: List[ParseDiagnostic] = __step_12.diagnostics
	iter_step: ParseExprStep = parse_expression(state, st, st_diag, PREC_LOWEST)

	if current_is_keyword(state, iter_step.index, ConcurrentlyKeyword):
		match binder_step.value:
			ParsedForNameBinder(name):
				parse_concurrent_for_tail(
					state,
					iter_step.index,
					iter_step.diagnostics,
					name,
					iter_step.value,
					start_span,
					header_span,
				)
			ParsedForTupleBinder(_, _):
				error_state: Int = iter_step.index
				error_state_diag: List[ParseDiagnostic] = add_expected_error(
					iter_step.diagnostics,
					current_span(state, iter_step.index),
					"`for ... concurrently` requires a single loop variable",
					["loop variable"],
					Some("write `for item in items concurrently(limit: N):`"),
				)
				parse_concurrent_for_tail(
					state,
					error_state,
					error_state_diag,
					parsed_identifier("_", start_span),
					iter_step.value,
					start_span,
					header_span,
				)
	else:
		colon_step: ParseSymbolStep = expect_symbol(
			state,
			iter_step.index,
			iter_step.diagnostics,
			ColonSymbol,
			"expected `:` after for loop iterable",
		)
		body_step: ParseExprStep = parse_block_after_colon(
			state,
			colon_step.index,
			colon_step.diagnostics,
			header_span,
		)

		{
			index = body_step.index,
			diagnostics = body_step.diagnostics,
			value = ParsedForExpr(
				binder_step.value,
				iter_step.value,
				body_step.value,
				span_cover(start_span, parsed_expr_span(body_step.value)),
			)
		}


private pure func parse_var_decl_statement(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseExprStep:
	start_span: SourceSpan = current_span(state, index)
	name_step: ParseIdentifierStep = parse_binder_identifier_expected(
		state,
		advance_parser(state, index),
		diagnostics,
		"variable name",
	)
	type_step: ParseOptionalTypeStep = parse_optional_type_annotation(
		state,
		name_step.index,
		name_step.diagnostics,
	)
	var st: Int = type_step.index
	var st_diag: List[ParseDiagnostic] = type_step.diagnostics

	equal_step: ParseSymbolStep = expect_symbol(
		state,
		st,
		st_diag,
		EqualSymbol,
		"expected `=` after variable declaration",
	)
	value_step: ParseExprStep = parse_assignment_value_expr(
		state,
		equal_step.index,
		equal_step.diagnostics,
		start_span,
	)

	{
		index = value_step.index,
		diagnostics = value_step.diagnostics,
		value = ParsedVarDeclExpr(
			name_step.value,
			type_step.value,
			value_step.value,
			True,
			span_cover(start_span, parsed_expr_span(value_step.value)),
		)
	}


private pure func parse_named_assignment_tail(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	name: ParsedIdentifier,
	type_expr: Option[ParsedTypeExpr],
) -> ParseExprStep:
	if current_is_symbol(state, index, EqualSymbol):
		value_step: ParseExprStep = parse_assignment_value_expr(
			state,
			advance_parser(state, index),
			diagnostics,
			name.span,
		)

		match type_expr:
			Some(ty):
				{
					index = value_step.index,
					diagnostics = value_step.diagnostics,
					value = ParsedVarDeclExpr(
						name,
						Some(ty),
						value_step.value,
						False,
						span_cover(name.span, parsed_expr_span(value_step.value)),
					)
				}
			None:
				{
					index = value_step.index,
					diagnostics = value_step.diagnostics,
					value = ParsedAssignExpr(
						name,
						value_step.value,
						span_cover(name.span, parsed_expr_span(value_step.value)),
					)
				}
	else if current_is_symbol(state, index, QuestionEqualsSymbol):
		value_step: ParseExprStep = parse_assignment_value_expr(
			state,
			advance_parser(state, index),
			diagnostics,
			name.span,
		)

		if name.text == "_":
			next_state: Int = value_step.index
			next_state_diag: List[ParseDiagnostic] = add_expected_error(
				value_step.diagnostics,
				name.span,
				"`?=` cannot bind to `_`; use a name for the unwrapped value",
				["binding name"],
				None,
			)

			{
				index = next_state,
				diagnostics = next_state_diag,
				value = ParsedQuestionBindExpr(
					name,
					type_expr,
					value_step.value,
					span_cover(name.span, parsed_expr_span(value_step.value)),
				)
			}
		else:
			{
				index = value_step.index,
				diagnostics = value_step.diagnostics,
				value = ParsedQuestionBindExpr(
					name,
					type_expr,
					value_step.value,
					span_cover(name.span, parsed_expr_span(value_step.value)),
				)
			}
	else:
		match current_compound_assign_op(state, index):
			Some(op):
				value_step: ParseExprStep = parse_assignment_value_expr(
					state,
					advance_parser(state, index),
					diagnostics,
					name.span,
				)

				{
					index = value_step.index,
					diagnostics = value_step.diagnostics,
					value = ParsedCompoundAssignExpr(
						name,
						op,
						value_step.value,
						span_cover(name.span, parsed_expr_span(value_step.value)),
					)
				}
			None:
				next_state: Int = index
				next_state_diag: List[ParseDiagnostic] = add_expected_error(
					diagnostics,
					current_span(
						state,
						index,
					),
					"expected assignment operator",
					["=", "?=", "+=", "-=", "*=", "/="],
					None,
				)

				{
					index = next_state,
					diagnostics = next_state_diag,
					value = ParsedMissingExpr(name.span)
				}


private pure func current_is_tuple_destruct_assignment_start(
	state: ParserInput,
	start_index: Int,
) -> Bool:
	if not current_is_symbol(state, start_index, LeftParenSymbol):
		False
	else:
		var index: Int = start_index + 1
		var saw_comma: Bool = False
		var expecting_name: Bool = True
		var saw_close: Bool = False
		var valid: Bool = True

		while valid:
			token_kind: TokenKind = token_kind_at(state, index)

			if expecting_name:
				if token_kind_is_tuple_binder_name(token_kind):
					index += 1
					expecting_name = False
				else:
					valid = False
			else:
				match token_kind:
					SymbolToken(CommaSymbol):
						saw_comma = True
						index += 1

						if token_kind_is_symbol(
							token_kind_at(state, index),
							RightParenSymbol,
						):
							saw_close = True
							break
						else:
							expecting_name = True
					SymbolToken(RightParenSymbol):
						saw_close = True
						break
					_:
						valid = False

		valid and saw_close and saw_comma and token_kind_is_symbol(
			token_kind_at(state, index + 1),
			EqualSymbol,
		)


private pure func parse_tuple_destruct_assignment(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseExprStep:
	start_span: SourceSpan = current_span(state, index)
	binder_step: ParseTupleBinderStep = parse_tuple_binder_after_left_paren(
		state,
		advance_parser(state, index),
		diagnostics,
		start_span,
		TupleBinderNamesOrUnderscore,
		"tuple destructuring name",
		"expected `, ` between tuple destructuring names",
		"expected tuple destructuring name after `, `",
		"expected `)` after tuple destructuring names",
	)
	equal_step: ParseSymbolStep = expect_symbol(
		state,
		binder_step.index,
		binder_step.diagnostics,
		EqualSymbol,
		"expected `=` after tuple destructuring",
	)
	value_step: ParseExprStep = parse_assignment_value_expr(
		state,
		equal_step.index,
		equal_step.diagnostics,
		start_span,
	)

	{
		index = value_step.index,
		diagnostics = value_step.diagnostics,
		value = ParsedTupleDestructExpr(
			binder_step.values,
			value_step.value,
			span_cover(start_span, parsed_expr_span(value_step.value)),
		)
	}


private pure func token_index_is_keyword(state: ParserInput, index: Int, expected: Keyword) -> Bool:
	match token_kind_at(state, index):
		KeywordToken(actual):
			actual == expected
		_:
			False


private pure func func_keyword_starts_nested_function_decl(state: ParserInput, index: Int) -> Bool:
	token_index_is_keyword(state, index, FuncKeyword) and not token_kind_is_symbol(
		token_kind_at(state, index + 1),
		LeftParenSymbol,
	)


private pure func current_starts_nested_function_decl(state: ParserInput, index: Int) -> Bool:
	if current_is_keyword(state, index, FuncKeyword):
		func_keyword_starts_nested_function_decl(state, index)
	else if current_is_keyword(state, index, PureKeyword):
		token_index_is_keyword(state, index + 1, FuncKeyword) and not token_kind_is_symbol(
			token_kind_at(state, index + 2),
			LeftParenSymbol,
		)
	else:
		False


private pure func parse_nested_function_decl_expr(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseExprStep:
	start_span: SourceSpan = current_span(state, index)
	var st: Int = index
	var st_diag: List[ParseDiagnostic] = diagnostics
	var is_pure: Bool = False

	if current_is_keyword(state, st, PureKeyword):
		is_pure = True
		st = advance_parser(state, st)

	function_step: ParseFunctionStep = parse_function_decl_value(
		state,
		st,
		st_diag,
		None,
		is_pure,
		[],
		start_span,
	)

	{
		index = function_step.index,
		diagnostics = function_step.diagnostics,
		value = ParsedFunctionDeclExpr(function_step.value)
	}


private pure func parse_assignment_after_expression(
	state: ParserInput,
	expr_step: ParseExprStep,
) -> ParseExprStep:
	if current_is_symbol(state, expr_step.index, EqualSymbol):
		match expr_step.value:
			ParsedNameExpr(name):
				value_step: ParseExprStep = parse_assignment_value_expr(
					state,
					advance_parser(state, expr_step.index),
					expr_step.diagnostics,
					name.span,
				)

				{
					index = value_step.index,
					diagnostics = value_step.diagnostics,
					value = ParsedAssignExpr(
						name,
						value_step.value,
						span_cover(name.span, parsed_expr_span(value_step.value)),
					)
				}
			ParsedSubscriptExpr(target, indices, left_span):
				value_step: ParseExprStep = parse_assignment_value_expr(
					state,
					advance_parser(state, expr_step.index),
					expr_step.diagnostics,
					left_span,
				)

				{
					index = value_step.index,
					diagnostics = value_step.diagnostics,
					value = ParsedSubscriptAssignExpr(
						target,
						indices,
						value_step.value,
						span_cover(left_span, parsed_expr_span(value_step.value)),
					)
				}
			ParsedFieldAccessExpr(_, _, left_span):
				value_step: ParseExprStep = parse_assignment_value_expr(
					state,
					advance_parser(state, expr_step.index),
					expr_step.diagnostics,
					left_span,
				)
				next_state: Int = value_step.index
				next_state_diag: List[ParseDiagnostic] = add_expected_error(
					value_step.diagnostics,
					left_span,
					(
						"Field assignment is not supported. Use record update syntax: { record | field = "
						+ "value }"
					),
					["record update"],
					None,
				)

				{
					index = next_state,
					diagnostics = next_state_diag,
					value = ParsedMissingExpr(left_span)
				}
			_:
				expr_step
	else:
		expr_step


---
Whether the current token is a reserved keyword followed by a binding tail
(`: Type =`, `=`, `?=`, or a compound assignment).

Such a keyword sits in a name position rather than starting a keyword construct
such as `if` or `match`. Routing it to the binder parser reports the
reserved-keyword rule once and keeps the rest of the statement parsing.
---
private pure func current_reserved_keyword_starts_binding(state: ParserInput, index: Int) -> Bool:
	match current_token_kind(state, index):
		KeywordToken(keyword):
			if keyword_is_reserved_name(keyword):
				after_name: Int = advance_parser(state, index)

				(
					current_can_start_assignment_tail(state, after_name)
					or (
						current_is_symbol(state, after_name, ColonSymbol)
						and colon_starts_typed_assignment(state, after_name)
					)
				)
			else:
				False
		_:
			False


private pure func current_token_can_start_named_statement(state: ParserInput, index: Int) -> Bool:
	match current_token_kind(state, index):
		IdentifierToken(_):
			True
		KeywordToken(keyword):
			match soft_keyword_identifier_text(keyword):
				Some(_):
					True
				None:
					current_reserved_keyword_starts_binding(state, index)
		_:
			False


private pure func parse_named_statement_or_expression(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseExprStep:
	if current_token_can_start_named_statement(state, index):
		name_step: ParseIdentifierStep = parse_binder_identifier_expected(
			state,
			index,
			diagnostics,
			"statement name",
		)
		var st: Int = name_step.index
		var st_diag: List[ParseDiagnostic] = name_step.diagnostics

		if current_is_symbol(state, st, ColonSymbol) and colon_starts_typed_assignment(state, st):
			type_step: ParseOptionalTypeStep = parse_optional_type_annotation(state, st, st_diag)
			parse_named_assignment_tail(
				state,
				type_step.index,
				type_step.diagnostics,
				name_step.value,
				type_step.value,
			)
		else if current_can_start_assignment_tail(state, st):
			parse_named_assignment_tail(state, st, st_diag, name_step.value, None)
		else:
			parse_assignment_after_expression(
				state,
				parse_expression(state, index, diagnostics, PREC_LOWEST),
			)
	else:
		match current_token_kind(state, index):
			SymbolToken(UnderscoreSymbol):
				name_step: ParseIdentifierStep = parse_binder_identifier_expected(
					state,
					index,
					diagnostics,
					"statement name",
				)
				var st: Int = name_step.index
				var st_diag: List[ParseDiagnostic] = name_step.diagnostics

				if current_can_start_assignment_tail(state, st):
					parse_named_assignment_tail(state, st, st_diag, name_step.value, None)
				else:
					parse_expression(state, index, diagnostics, PREC_LOWEST)
			_:
				parse_assignment_after_expression(
					state,
					parse_expression(state, index, diagnostics, PREC_LOWEST),
				)


private pure func parse_statement(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseExprStep:
	step: ParseExprStep = if current_starts_nested_function_decl(state, index):
		parse_nested_function_decl_expr(state, index, diagnostics)
	else if current_is_keyword(state, index, VarKeyword):
		parse_var_decl_statement(state, index, diagnostics)
	else if current_is_keyword(state, index, WhileKeyword):
		parse_while_expr(state, index, diagnostics)
	else if current_is_keyword(state, index, ForKeyword):
		parse_for_expr_with_header_span(
			state,
			index,
			diagnostics,
			current_span(state, index),
		)
	else if current_is_tuple_destruct_assignment_start(state, index):
		parse_tuple_destruct_assignment(state, index, diagnostics)
	else:
		parse_named_statement_or_expression(state, index, diagnostics)

	{
		index = consume_leading_dot_postfix_continuation_dedent(state, step.index, step.value),
		diagnostics = step.diagnostics,
		value = step.value
	}


private pure func parse_lambda_body(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	body_intro_start_line: Int,
	block_anchor_span: SourceSpan,
) -> ParseExprStep:
	if current_is_newline(state, index):
		parse_block_after_colon(state, index, diagnostics, block_anchor_span)
	else if (
		current_span(state, index).start_line > body_intro_start_line
		and current_token_is_indented_past(state, index, block_anchor_span)
	):
		parse_indented_block_body(state, index, diagnostics, block_anchor_span)
	else:
		parse_expression(state, index, diagnostics, PREC_LOWEST)


private pure func parse_lambda_expr_with_header_span(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	header_span: SourceSpan,
) -> ParseExprStep:
	start_span: SourceSpan = current_span(state, index)
	var st: Int = index
	var st_diag: List[ParseDiagnostic] = diagnostics
	var is_pure: Bool = False

	if current_is_keyword(state, st, PureKeyword):
		is_pure = True
		st = advance_parser(state, st)
		__step_13: ParserStep = expect_keyword(
			state,
			st,
			st_diag,
			FuncKeyword,
			"func",
			"expected `func` after `pure` in lambda expression",
		)
		st = __step_13.index
		st_diag = __step_13.diagnostics
	else:
		__step_14: ParserStep = expect_keyword(
			state,
			st,
			st_diag,
			FuncKeyword,
			"func",
			"expected `func` before lambda",
		)
		st = __step_14.index
		st_diag = __step_14.diagnostics

	left_step: ParseSymbolStep = expect_symbol(
		state,
		st,
		st_diag,
		LeftParenSymbol,
		"expected `(` after lambda `func`",
	)
	st = left_step.index
	st_diag = left_step.diagnostics

	params_step: ParseLambdaParamsStep = if left_step.matched:
		parse_lambda_params_after_left_paren(state, st, st_diag)
	else:
		{
			index = st,
			diagnostics = st_diag,
			values = []
		}

	st = params_step.index
	st_diag = params_step.diagnostics
	var return_type: Option[ParsedTypeExpr] = None

	if current_is_symbol(state, st, ArrowSymbol):
		type_step: ParseTypeStep = parse_type_expr(
			state,
			advance_parser(state, st),
			st_diag,
		)
		return_type = Some(type_step.value)
		st = type_step.index
		st_diag = type_step.diagnostics

	colon_step: ParseSymbolStep = expect_symbol(
		state,
		st,
		st_diag,
		ColonSymbol,
		"expected `:` before lambda body",
	)
	body_step: ParseExprStep = parse_lambda_body(
		state,
		colon_step.index,
		colon_step.diagnostics,
		colon_step.span.start_line,
		header_span,
	)

	{
		index = body_step.index,
		diagnostics = body_step.diagnostics,
		value = ParsedLambdaExpr(
			is_pure,
			params_step.values,
			return_type,
			body_step.value,
			span_cover(start_span, parsed_expr_span(body_step.value)),
		)
	}


private pure func parse_tuple_tail(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	first_item: ParsedExpr,
	start_span: SourceSpan,
) -> ParseExprStep:
	var st: Int = index
	var st_diag: List[ParseDiagnostic] = diagnostics
	var items: List[ParsedExpr] = [first_item]
	var parsing_items: Bool = True

	while parsing_items and not current_is_eof(state, st):
		if current_is_symbol(state, st, CommaSymbol):
			st = advance_parser(state, st)

			if current_is_symbol(state, st, RightParenSymbol):
				parsing_items = False
			else:
				item_step: ParseExprStep = parse_expression_with_header_span(
					state,
					st,
					st_diag,
					PREC_LOWEST,
					start_span,
				)
				items = items.append(item_step.value)
				st = item_step.index
				st_diag = item_step.diagnostics
		else:
			parsing_items = False

	right_step: ParseSymbolStep = expect_symbol(
		state,
		st,
		st_diag,
		RightParenSymbol,
		"expected `)` after tuple expression",
	)
	st = right_step.index
	st_diag = right_step.diagnostics

	end_span: SourceSpan = if right_step.matched:
		right_step.span
	else:
		parsed_expr_span(first_item)

	if items.length() > 4:
		st_diag = add_tuple_arity_error(
			st_diag,
			span_cover(start_span, end_span),
		)

	{
		index = st,
		diagnostics = st_diag,
		value = ParsedTupleExpr(
			items,
			span_cover(start_span, end_span),
		)
	}


private pure func parse_parenthesized_or_tuple_expr(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	start_span: SourceSpan,
) -> ParseExprStep:
	if current_is_symbol(state, index, RightParenSymbol):
		right_step: ParseSymbolStep = expect_symbol(
			state,
			index,
			diagnostics,
			RightParenSymbol,
			"expected `)` after void expression",
		)

		{
			index = right_step.index,
			diagnostics = right_step.diagnostics,
			value = ParsedVoidExpr(span_cover(start_span, right_step.span))
		}
	else:
		expr_step: ParseExprStep = parse_expression_with_header_span(
			state,
			index,
			diagnostics,
			PREC_LOWEST,
			start_span,
		)

		if current_is_symbol(state, expr_step.index, CommaSymbol):
			parse_tuple_tail(
				state,
				expr_step.index,
				expr_step.diagnostics,
				expr_step.value,
				start_span,
			)
		else:
			right_step: ParseSymbolStep = expect_symbol(
				state,
				expr_step.index,
				expr_step.diagnostics,
				RightParenSymbol,
				"expected `)` after expression",
			)

			-- Grouping parentheses have no AST node; widen the enclosed
			-- expression to both delimiters so its span reports the real
			-- source extent, matching tuple and void expressions.
			if right_step.matched:
				{
					index = right_step.index,
					diagnostics = right_step.diagnostics,
					value = parsed_expr_with_span(
						expr_step.value,
						span_cover(start_span, right_step.span),
					)
				}
			else:
				{
					index = right_step.index,
					diagnostics = right_step.diagnostics,
					value = expr_step.value
				}


private pure func next_is_symbol(state: ParserInput, index: Int, symbol: Symbol) -> Bool:
	match token_kind_at(state, index + 1):
		SymbolToken(actual):
			actual == symbol
		_:
			False


private pure func current_can_start_record_expr_field(state: ParserInput, index: Int) -> Bool:
	match current_token_kind(state, index):
		IdentifierToken(_):
			next_is_symbol(state, index, EqualSymbol)
		KeywordToken(keyword):
			(
				soft_keyword_identifier_text(keyword).is_some()
				and next_is_symbol(state, index, EqualSymbol)
			)
		_:
			False


private pure func parse_record_expr_field(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseRecordExprFieldStep:
	name_step: ParseIdentifierStep = parse_identifier_expected(
		state,
		index,
		diagnostics,
		"record field",
	)
	equal_step: ParseSymbolStep = expect_symbol(
		state,
		name_step.index,
		name_step.diagnostics,
		EqualSymbol,
		"expected `=` after record field name",
	)
	value_step: ParseExprStep = parse_expression(
		state,
		equal_step.index,
		equal_step.diagnostics,
		PREC_LOWEST,
	)

	{
		index = value_step.index,
		diagnostics = value_step.diagnostics,
		value = {
			name = name_step.value,
			value = value_step.value,
			span = span_cover(name_step.value.span, parsed_expr_span(value_step.value))
		}
	}


private pure func parse_record_expr_field_list_until_right_brace(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	allow_empty: Bool,
) -> ParseRecordExprFieldListStep:
	var st: Int = index
	var st_diag: List[ParseDiagnostic] = diagnostics
	var fields: List[ParsedRecordExprField] = []

	if allow_empty and current_is_symbol(state, st, RightBraceSymbol):
		{
			index = st,
			diagnostics = st_diag,
			values = fields
		}
	else:
		var parsing_fields: Bool = True

		while parsing_fields and not current_is_eof(state, st):
			field_step: ParseRecordExprFieldStep = parse_record_expr_field(state, st, st_diag)
			fields = fields.append(field_step.value)
			st = field_step.index
			st_diag = field_step.diagnostics

			if current_is_symbol(state, st, CommaSymbol):
				st = advance_parser(state, st)

				if current_is_symbol(state, st, RightBraceSymbol):
					parsing_fields = False
			else:
				parsing_fields = False

		{
			index = st,
			diagnostics = st_diag,
			values = fields
		}


private pure func parse_record_literal_expr(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	start_span: SourceSpan,
) -> ParseExprStep:
	fields_step: ParseRecordExprFieldListStep = parse_record_expr_field_list_until_right_brace(
		state,
		index,
		diagnostics,
		True,
	)
	right_step: ParseSymbolStep = expect_symbol(
		state,
		fields_step.index,
		fields_step.diagnostics,
		RightBraceSymbol,
		"expected `}` after record literal",
	)

	end_span: SourceSpan = if right_step.matched:
		right_step.span
	else:
		start_span

	{
		index = right_step.index,
		diagnostics = right_step.diagnostics,
		value = ParsedRecordExpr(
			fields_step.values,
			span_cover(start_span, end_span),
		)
	}


private pure func parse_dict_entry_after_key(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	key: ParsedExpr,
) -> ParseDictEntryStep:
	arrow_step: ParseSymbolStep = expect_symbol(
		state,
		index,
		diagnostics,
		FatArrowSymbol,
		"expected `=>` between dict key and value",
	)
	value_step: ParseExprStep = parse_expression(
		state,
		arrow_step.index,
		arrow_step.diagnostics,
		PREC_LOWEST,
	)

	{
		index = value_step.index,
		diagnostics = value_step.diagnostics,
		value = {
			key = key,
			value = value_step.value,
			span = span_cover(parsed_expr_span(key), parsed_expr_span(value_step.value))
		}
	}


private pure func parse_dict_literal_tail(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	first_key: ParsedExpr,
	start_span: SourceSpan,
) -> ParseExprStep:
	first_entry_step: ParseDictEntryStep = parse_dict_entry_after_key(
		state,
		index,
		diagnostics,
		first_key,
	)
	var st: Int = first_entry_step.index
	var st_diag: List[ParseDiagnostic] = first_entry_step.diagnostics
	var entries: List[ParsedDictEntry] = [first_entry_step.value]
	var parsing_entries: Bool = True

	while parsing_entries and not current_is_eof(state, st):
		if current_is_symbol(state, st, CommaSymbol):
			st = advance_parser(state, st)

			if current_is_symbol(state, st, RightBraceSymbol):
				parsing_entries = False
			else:
				key_step: ParseExprStep = parse_expression(state, st, st_diag, PREC_LOWEST)
				entry_step: ParseDictEntryStep = parse_dict_entry_after_key(
					state,
					key_step.index,
					key_step.diagnostics,
					key_step.value,
				)
				entries = entries.append(entry_step.value)
				st = entry_step.index
				st_diag = entry_step.diagnostics
		else:
			parsing_entries = False

	right_step: ParseSymbolStep = expect_symbol(
		state,
		st,
		st_diag,
		RightBraceSymbol,
		"expected `}` after dict literal",
	)

	end_span: SourceSpan = if right_step.matched:
		right_step.span
	else:
		parsed_expr_span(first_key)

	{
		index = right_step.index,
		diagnostics = right_step.diagnostics,
		value = ParsedDictExpr(
			entries,
			span_cover(start_span, end_span),
		)
	}


private pure func parse_vector_literal_tail(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	first_item: ParsedExpr,
	start_span: SourceSpan,
) -> ParseExprStep:
	var st: Int = index
	var st_diag: List[ParseDiagnostic] = diagnostics
	var items: List[ParsedExpr] = [first_item]
	var parsing_items: Bool = True

	while parsing_items and not current_is_eof(state, st):
		if current_is_symbol(state, st, CommaSymbol):
			st = advance_parser(state, st)

			if current_is_symbol(state, st, RightBraceSymbol):
				parsing_items = False
			else:
				item_step: ParseExprStep = parse_expression(state, st, st_diag, PREC_LOWEST)
				items = items.append(item_step.value)
				st = item_step.index
				st_diag = item_step.diagnostics
		else:
			parsing_items = False

	right_step: ParseSymbolStep = expect_symbol(
		state,
		st,
		st_diag,
		RightBraceSymbol,
		"expected `}` after vector literal",
	)

	end_span: SourceSpan = if right_step.matched:
		right_step.span
	else:
		parsed_expr_span(first_item)

	{
		index = right_step.index,
		diagnostics = right_step.diagnostics,
		value = ParsedVectorExpr(
			items,
			span_cover(start_span, end_span),
		)
	}


private pure func parse_record_update_tail(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	base: ParsedExpr,
	start_span: SourceSpan,
) -> ParseExprStep:
	pipe_step: ParseSymbolStep = expect_symbol(
		state,
		index,
		diagnostics,
		PipeSymbol,
		"expected `|` before record update fields",
	)
	fields_step: ParseRecordExprFieldListStep = parse_record_expr_field_list_until_right_brace(
		state,
		pipe_step.index,
		pipe_step.diagnostics,
		False,
	)
	right_step: ParseSymbolStep = expect_symbol(
		state,
		fields_step.index,
		fields_step.diagnostics,
		RightBraceSymbol,
		"expected `}` after record update",
	)

	end_span: SourceSpan = if right_step.matched:
		right_step.span
	else:
		parsed_expr_span(base)

	{
		index = right_step.index,
		diagnostics = right_step.diagnostics,
		value = ParsedRecordUpdateExpr(
			base,
			fields_step.values,
			span_cover(start_span, end_span),
		)
	}


private pure func parse_braced_expr(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	start_span: SourceSpan,
) -> ParseExprStep:
	st: Int = advance_parser(state, index)
	st_diag: List[ParseDiagnostic] = diagnostics

	if (
		current_is_symbol(state, st, RightBraceSymbol)
		or current_can_start_record_expr_field(state, st)
	):
		parse_record_literal_expr(state, st, st_diag, start_span)
	else:
		first_step: ParseExprStep = parse_expression(state, st, st_diag, PREC_LOWEST)

		if current_is_symbol(state, first_step.index, FatArrowSymbol):
			parse_dict_literal_tail(
				state,
				first_step.index,
				first_step.diagnostics,
				first_step.value,
				start_span,
			)
		else if current_is_symbol(state, first_step.index, PipeSymbol):
			parse_record_update_tail(
				state,
				first_step.index,
				first_step.diagnostics,
				first_step.value,
				start_span,
			)
		else:
			parse_vector_literal_tail(
				state,
				first_step.index,
				first_step.diagnostics,
				first_step.value,
				start_span,
			)


private pure func parse_builtin_expr(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseExprStep:
	start_span: SourceSpan = current_span(state, index)
	var st: Int = advance_parser(state, index)
	var st_diag: List[ParseDiagnostic] = diagnostics
	var name: Option[String] = None
	var end_span: SourceSpan = start_span

	if current_is_symbol(state, st, LeftParenSymbol):
		st = advance_parser(state, st)

		match current_token_kind(state, st):
			StringLiteralToken(_, text):
				name = Some(text)
				end_span = current_span(state, st)
				st = advance_parser(state, st)
			_:
				st_diag = add_expected_error(
					st_diag,
					current_span(state, st),
					"expected builtin name",
					["string literal"],
					Some("write builtin(\"runtime_helper_name\") or bare builtin"),
				)

				if not current_is_soft_boundary(state, st):
					st = advance_parser(state, st)

		right_step: ParseSymbolStep = expect_symbol(
			state,
			st,
			st_diag,
			RightParenSymbol,
			"expected `)` after builtin name",
		)
		st = right_step.index
		st_diag = right_step.diagnostics

		if right_step.matched:
			end_span = right_step.span

	{
		index = st,
		diagnostics = st_diag,
		value = ParsedBuiltinExpr(
			name,
			span_cover(start_span, end_span),
		)
	}


private pure func parse_opaque_conversion_expr(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	is_into: Bool,
) -> ParseExprStep:
	start_span: SourceSpan = current_span(state, index)
	type_step: ParseTypeStep = parse_type_expr(
		state,
		advance_parser(state, index),
		diagnostics,
	)
	left_step: ParseSymbolStep = expect_symbol(
		state,
		type_step.index,
		type_step.diagnostics,
		LeftParenSymbol,
		"expected `(` after opaque conversion type",
	)
	value_step: ParseExprStep = parse_expression(
		state,
		left_step.index,
		left_step.diagnostics,
		PREC_LOWEST,
	)
	right_step: ParseSymbolStep = expect_symbol(
		state,
		value_step.index,
		value_step.diagnostics,
		RightParenSymbol,
		"expected `)` after opaque conversion value",
	)

	end_span: SourceSpan = if right_step.matched:
		right_step.span
	else:
		parsed_expr_span(value_step.value)

	value: ParsedExpr = if is_into:
		ParsedOpaqueIntoExpr(
			type_step.value,
			value_step.value,
			span_cover(start_span, end_span),
		)
	else:
		ParsedOpaqueFromExpr(
			type_step.value,
			value_step.value,
			span_cover(start_span, end_span),
		)

	{
		index = right_step.index,
		diagnostics = right_step.diagnostics,
		value = value
	}


-- COMPAT-001: reject the removed spelling with its explicit replacement. Drop
-- this diagnostic-only lookahead after one preview/bootstrap migration cycle.
private pure func starts_removed_opaque_conversion(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> Bool:
	type_step: ParseTypeStep = parse_type_expr(
		state,
		advance_parser(state, index),
		diagnostics,
	)
	(
		type_step.diagnostics.length() == diagnostics.length()
		and current_is_symbol(state, type_step.index, LeftParenSymbol)
	)


private pure func reject_removed_opaque_conversion(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	is_into: Bool,
) -> ParseExprStep:
	step: ParseExprStep = parse_opaque_conversion_expr(state, index, diagnostics, is_into)

	removed_keyword: String = if is_into:
		"into"
	else:
		"from"

	explicit_keyword: String = if is_into:
		"into_opaque"
	else:
		"from_opaque"

	{ step | diagnostics = add_expected_error(
			step.diagnostics,
			current_span(state, index),
			"`" + removed_keyword + " Type(...)` opaque conversions have been removed",
			[explicit_keyword],
			Some("use `" + explicit_keyword + " Type(...)` instead"),
		) }


private pure func parse_primary_expr(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseExprStep:
	token: Token = current_token(state, index)

	match token.kind:
		IdentifierToken(text):
			if text == "into":
				if starts_removed_opaque_conversion(state, index, diagnostics):
					reject_removed_opaque_conversion(state, index, diagnostics, True)
				else:
					{
						index = advance_parser(state, index),
						diagnostics = diagnostics,
						value = ParsedNameExpr(parsed_identifier(text, token.span))
					}
			else:
				{
					index = advance_parser(state, index),
					diagnostics = diagnostics,
					value = ParsedNameExpr(parsed_identifier(text, token.span))
				}
		IntLiteralToken(text):
			{
				index = advance_parser(state, index),
				diagnostics = diagnostics,
				value = ParsedIntLiteralExpr(text, token.span)
			}
		FloatLiteralToken(text):
			{
				index = advance_parser(state, index),
				diagnostics = diagnostics,
				value = ParsedFloatLiteralExpr(text, token.span)
			}
		StringLiteralToken(kind, text):
			expr_value: ParsedExpr = if (
				kind == InterpolatedStringLiteral
				or kind == InterpolatedPipeStringLiteral
			):
				ParsedStringInterpolationExpr(
					text,
					kind == InterpolatedPipeStringLiteral,
					token.span,
				)
			else:
				ParsedStringLiteralExpr(text, parsed_string_literal_form(kind), token.span)

			{
				index = advance_parser(state, index),
				diagnostics = diagnostics,
				value = expr_value
			}
		CharLiteralToken(codepoint):
			{
				index = advance_parser(state, index),
				diagnostics = diagnostics,
				value = ParsedCharLiteralExpr(codepoint, token.span)
			}
		KeywordToken(TrueKeyword):
			{
				index = advance_parser(state, index),
				diagnostics = diagnostics,
				value = ParsedBoolLiteralExpr(True, token.span)
			}
		KeywordToken(FalseKeyword):
			{
				index = advance_parser(state, index),
				diagnostics = diagnostics,
				value = ParsedBoolLiteralExpr(False, token.span)
			}
		KeywordToken(AfterKeyword):
			{
				index = advance_parser(state, index),
				diagnostics = diagnostics,
				value = ParsedNameExpr(parsed_identifier("after", token.span))
			}
		KeywordToken(SealedKeyword):
			{
				index = advance_parser(state, index),
				diagnostics = diagnostics,
				value = ParsedNameExpr(parsed_identifier("sealed", token.span))
			}
		KeywordToken(BreakKeyword):
			{
				index = advance_parser(state, index),
				diagnostics = diagnostics,
				value = ParsedBreakExpr(token.span)
			}
		KeywordToken(ContinueKeyword):
			{
				index = advance_parser(state, index),
				diagnostics = diagnostics,
				value = ParsedContinueExpr(token.span)
			}
		KeywordToken(VoidKeyword):
			{
				index = advance_parser(state, index),
				diagnostics = diagnostics,
				value = ParsedVoidExpr(token.span)
			}
		KeywordToken(BuiltinKeyword):
			parse_builtin_expr(state, index, diagnostics)
		KeywordToken(IntoOpaqueKeyword):
			parse_opaque_conversion_expr(state, index, diagnostics, True)
		KeywordToken(FromKeyword):
			if starts_removed_opaque_conversion(state, index, diagnostics):
				reject_removed_opaque_conversion(state, index, diagnostics, False)
			else:
				{
					index = advance_parser(state, index),
					diagnostics = diagnostics,
					value = ParsedNameExpr(parsed_identifier("from", token.span))
				}
		KeywordToken(FromOpaqueKeyword):
			parse_opaque_conversion_expr(state, index, diagnostics, False)
		KeywordToken(FuncKeyword):
			parse_lambda_expr_with_header_span(
				state,
				index,
				diagnostics,
				current_span(state, index),
			)
		KeywordToken(PureKeyword):
			parse_lambda_expr_with_header_span(
				state,
				index,
				diagnostics,
				current_span(state, index),
			)
		KeywordToken(IfKeyword):
			parse_if_expr_with_header_span(
				state,
				index,
				diagnostics,
				current_span(state, index),
			)
		KeywordToken(MatchKeyword):
			parse_match_expr_with_header_span(
				state,
				index,
				diagnostics,
				current_span(state, index),
			)
		KeywordToken(SelectKeyword):
			parse_select_expr_with_header_span(
				state,
				index,
				diagnostics,
				current_span(state, index),
			)
		KeywordToken(DebugKeyword):
			if next_is_symbol(state, index, DotSymbol):
				{
					index = advance_parser(state, index),
					diagnostics = diagnostics,
					value = ParsedNameExpr(parsed_identifier("debug", token.span))
				}
			else:
				parse_debug_block_expr(state, index, diagnostics)
		KeywordToken(WithKeyword):
			parse_with_expr(state, index, diagnostics)
		KeywordToken(ConcurrentKeyword):
			parse_concurrent_block_expr(state, index, diagnostics)
		SymbolToken(LeftParenSymbol):
			parse_parenthesized_or_tuple_expr(
				state,
				advance_parser(state, index),
				diagnostics,
				token.span,
			)
		SymbolToken(LeftBracketSymbol):
			start_span: SourceSpan = token.span
			items_step: ParseExprListStep = parse_expr_list_until(
				state,
				advance_parser(state, index),
				diagnostics,
				RightBracketSymbol,
				True,
				start_span,
			)
			right_step: ParseSymbolStep = expect_symbol(
				state,
				items_step.index,
				items_step.diagnostics,
				RightBracketSymbol,
				"expected `]` after list literal",
			)

			end_span: SourceSpan = if right_step.matched:
				right_step.span
			else:
				start_span

			{
				index = right_step.index,
				diagnostics = right_step.diagnostics,
				value = ParsedListExpr(
					items_step.values,
					span_cover(start_span, end_span),
				)
			}
		SymbolToken(LeftBraceSymbol):
			parse_braced_expr(state, index, diagnostics, token.span)
		SymbolToken(UnderscoreSymbol):
			{
				index = advance_parser(state, index),
				diagnostics = diagnostics,
				value = ParsedVoidExpr(token.span)
			}
		_:
			next_state: Int = index
			next_state_diag: List[ParseDiagnostic] = add_expected_error(
				diagnostics,
				token.span,
				"expected expression",
				[EXPECTED_EXPRESSION],
				None,
			)

			recovery_state: Int = if current_is_soft_boundary(state, next_state):
				next_state
			else:
				advance_parser(state, next_state)

			{
				index = recovery_state,
				diagnostics = next_state_diag,
				value = ParsedMissingExpr(token.span)
			}


private pure func postfix_continuation_after_newline(
	state: ParserInput,
	index: Int,
) -> ParsePostfixContinuationStep:
	if current_is_newline(state, index):
		after_newline: Int = advance_parser(state, index)

		if current_is_indent(state, after_newline):
			after_indent: Int = advance_parser(state, after_newline)

			if current_is_symbol(state, after_indent, DotSymbol):
				{
					index = after_indent,
					opened_indent = True
				}
			else:
				{
					index = index,
					opened_indent = False
				}
		else if current_is_symbol(state, after_newline, DotSymbol):
			{
				index = after_newline,
				opened_indent = False
			}
		else:
			{
				index = index,
				opened_indent = False
			}
	else:
		{
			index = index,
			opened_indent = False
		}


private pure func parse_postfix_expr(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	left: ParsedExpr,
	header_span: SourceSpan,
) -> ParseExprStep:
	var st: Int = index
	var st_diag: List[ParseDiagnostic] = diagnostics
	var expr: ParsedExpr = left
	var parsing_postfix: Bool = True
	var continuation_indents: Int = 0

	while parsing_postfix and not current_is_eof(state, st):
		if continuation_indents > 0 and current_is_dedent(state, st):
			st = advance_parser(state, st)
			continuation_indents -= 1

			if continuation_indents == 0:
				parsing_postfix = False
		else if continuation_indents > 0 and current_is_newline(state, st):
			after_newline: Int = advance_parser(state, st)
			after_newline_diag: List[ParseDiagnostic] = st_diag

			if current_is_dedent(state, after_newline):
				st = advance_parser(state, after_newline)
				st_diag = after_newline_diag
				continuation_indents -= 1

				if continuation_indents == 0:
					parsing_postfix = False
			else:
				continuation_step: ParsePostfixContinuationStep = postfix_continuation_after_newline(
					state,
					st,
				)
				st = continuation_step.index

				if continuation_step.opened_indent:
					continuation_indents += 1
		else:
			continuation_step: ParsePostfixContinuationStep = postfix_continuation_after_newline(
				state,
				st,
			)
			st = continuation_step.index

			if continuation_step.opened_indent:
				continuation_indents += 1

			if current_is_symbol(state, st, DotSymbol):
				st = advance_parser(state, st)
				field_step: ParseIdentifierStep = parse_identifier_expected(
					state,
					st,
					st_diag,
					"field name",
				)
				st = field_step.index
				st_diag = field_step.diagnostics
				expr = ParsedFieldAccessExpr(
					expr,
					field_step.value,
					span_cover(parsed_expr_span(expr), field_step.value.span),
				)
			else if current_is_symbol(state, st, LeftParenSymbol):
				start_span: SourceSpan = parsed_expr_span(expr)
				args_step: ParseExprListStep = parse_expr_list_until(
					state,
					advance_parser(state, st),
					st_diag,
					RightParenSymbol,
					True,
					header_span,
				)
				right_step: ParseSymbolStep = expect_symbol(
					state,
					args_step.index,
					args_step.diagnostics,
					RightParenSymbol,
					"expected `)` after call arguments",
				)
				st = right_step.index
				st_diag = right_step.diagnostics

				end_span: SourceSpan = if right_step.matched:
					right_step.span
				else:
					start_span

				expr = ParsedCallExpr(
					expr,
					args_step.values,
					span_cover(start_span, end_span),
				)
			else if current_is_symbol(state, st, LeftBracketSymbol):
				start_span: SourceSpan = parsed_expr_span(expr)
				indices_step: ParseExprListStep = parse_expr_list_until(
					state,
					advance_parser(state, st),
					st_diag,
					RightBracketSymbol,
					False,
					header_span,
				)
				right_step: ParseSymbolStep = expect_symbol(
					state,
					indices_step.index,
					indices_step.diagnostics,
					RightBracketSymbol,
					"expected `]` after subscript",
				)
				st = right_step.index
				st_diag = right_step.diagnostics

				end_span: SourceSpan = if right_step.matched:
					right_step.span
				else:
					start_span

				expr = ParsedSubscriptExpr(
					expr,
					indices_step.values,
					span_cover(start_span, end_span),
				)
			else:
				parsing_postfix = False

	{
		index = st,
		diagnostics = st_diag,
		value = expr
	}


private pure func parse_prefix_expr_with_header_span(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	header_span: SourceSpan,
) -> ParseExprStep:
	token: Token = current_token(state, index)

	match token.kind:
		SymbolToken(MinusSymbol):
			operand_step: ParseExprStep = parse_prefix_expr_with_header_span(
				state,
				advance_parser(state, index),
				diagnostics,
				header_span,
			)
			{
				index = operand_step.index,
				diagnostics = operand_step.diagnostics,
				value = ParsedUnaryExpr(
					ParsedNegateOp,
					operand_step.value,
					span_cover(token.span, parsed_expr_span(operand_step.value)),
				)
			}
		KeywordToken(NotKeyword):
			operand_step: ParseExprStep = parse_prefix_expr_with_header_span(
				state,
				advance_parser(state, index),
				diagnostics,
				header_span,
			)
			{
				index = operand_step.index,
				diagnostics = operand_step.diagnostics,
				value = ParsedUnaryExpr(
					ParsedNotOp,
					operand_step.value,
					span_cover(token.span, parsed_expr_span(operand_step.value)),
				)
			}
		KeywordToken(DetachKeyword):
			operand_step: ParseExprStep = parse_prefix_expr_with_header_span(
				state,
				advance_parser(state, index),
				diagnostics,
				header_span,
			)
			{
				index = operand_step.index,
				diagnostics = operand_step.diagnostics,
				value = ParsedDetachExpr(
					operand_step.value,
					span_cover(token.span, parsed_expr_span(operand_step.value)),
				)
			}
		KeywordToken(FuncKeyword):
			parse_lambda_expr_with_header_span(state, index, diagnostics, header_span)
		KeywordToken(PureKeyword):
			parse_lambda_expr_with_header_span(state, index, diagnostics, header_span)
		KeywordToken(IfKeyword):
			parse_if_expr_with_header_span(state, index, diagnostics, header_span)
		KeywordToken(MatchKeyword):
			parse_match_expr_with_header_span(state, index, diagnostics, header_span)
		KeywordToken(SelectKeyword):
			parse_select_expr_with_header_span(state, index, diagnostics, header_span)
		KeywordToken(ForKeyword):
			parse_for_expr_with_header_span(state, index, diagnostics, header_span)
		_:
			primary_step: ParseExprStep = parse_primary_expr(state, index, diagnostics)
			parse_postfix_expr(
				state,
				primary_step.index,
				primary_step.diagnostics,
				primary_step.value,
				header_span,
			)


private pure func parse_expression_with_header_span(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	min_precedence: Int,
	header_span: SourceSpan,
) -> ParseExprStep:
	prefix_step: ParseExprStep = parse_prefix_expr_with_header_span(
		state,
		index,
		diagnostics,
		header_span,
	)
	var st: Int = prefix_step.index
	var st_diag: List[ParseDiagnostic] = prefix_step.diagnostics
	var left: ParsedExpr = prefix_step.value
	var parsing_infix: Bool = True

	while parsing_infix and not current_is_eof(state, st):
		if current_is_keyword(state, st, AsKeyword):
			if PREC_ASCRIPTION < min_precedence:
				parsing_infix = False
			else:
				type_step: ParseTypeStep = parse_type_expr(
					state,
					advance_parser(state, st),
					st_diag,
				)
				left = ParsedAscriptionExpr(
					left,
					type_step.value,
					span_cover(parsed_expr_span(left), parsed_type_expr_span(type_step.value)),
				)
				st = type_step.index
				st_diag = type_step.diagnostics
		else:
			match current_infix_info(state, st):
				Some(info):
					if info.precedence < min_precedence:
						parsing_infix = False
					else:
						st = advance_parser(state, st)
						st = skip_newlines(state, st)
						right_step: ParseExprStep = parse_expression_with_header_span(
							state,
							st,
							st_diag,
							info.precedence + 1,
							header_span,
						)
						left = make_infix_expr(info, left, right_step.value)
						st = right_step.index
						st_diag = right_step.diagnostics
				None:
					parsing_infix = False

	result: ParseExprStep = {
		index = st,
		diagnostics = st_diag,
		value = left
	}

	if min_precedence <= PREC_LOWEST:
		parse_assignment_after_expression(state, result)
	else:
		result


private pure func parse_expression(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	min_precedence: Int,
) -> ParseExprStep:
	parse_expression_with_header_span(
		state,
		index,
		diagnostics,
		min_precedence,
		current_span(state, index),
	)


private pure func expect_indent(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParserStep:
	if current_is_indent(state, index):
		{
			index = advance_parser(state, index),
			diagnostics = diagnostics
		}
	else:
		{
			index = index,
			diagnostics = add_expected_error(
				diagnostics,
				current_span(state, index),
				"expected indented function body",
				["indent"],
				None,
			)
		}


private pure func expect_dedent(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParserStep:
	if current_is_dedent(state, index):
		{
			index = advance_parser(state, index),
			diagnostics = diagnostics
		}
	else:
		{
			index = index,
			diagnostics = add_expected_error(
				diagnostics,
				current_span(state, index),
				"expected dedent after function body",
				["dedent"],
				None,
			)
		}


private pure func parse_function_body(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	start_span: SourceSpan,
) -> ParseBodyStep:
	if current_is_newline(state, index):
		block_step: ParseExprStep = parse_block_after_colon(state, index, diagnostics, start_span)

		{
			index = block_step.index,
			diagnostics = block_step.diagnostics,
			body = Some(block_step.value)
		}
	else:
		expr_step: ParseExprStep = parse_expression(state, index, diagnostics, PREC_LOWEST)

		{
			index = expr_step.index,
			diagnostics = expr_step.diagnostics,
			body = Some(expr_step.value)
		}


private pure func parse_function_decl_value(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	doc: Option[String],
	is_pure: Bool,
	annotations: List[ParsedFunctionAnnotation],
	start_span: SourceSpan,
) -> ParseFunctionStep:
	func_span: SourceSpan = current_span(state, index)
	var st: Int = advance_parser(state, index)
	var st_diag: List[ParseDiagnostic] = diagnostics
	name_step: ParseIdentifierStep = parse_declared_name_expected(
		state,
		st,
		st_diag,
		EXPECTED_FUNCTION_NAME,
	)
	st = name_step.index
	st_diag = name_step.diagnostics
	type_params_step: ParseTypeParamListStep = parse_type_params_opt(state, st, st_diag)
	st = type_params_step.index
	st_diag = type_params_step.diagnostics

	left_step: ParseSymbolStep = expect_symbol(
		state,
		st,
		st_diag,
		LeftParenSymbol,
		"expected `(` after function name",
	)
	st = left_step.index
	st_diag = left_step.diagnostics

	params_step: ParseParamsStep = if left_step.matched:
		parse_params_after_left_paren(state, st, st_diag)
	else:
		{
			index = st,
			diagnostics = st_diag,
			values = []
		}

	st = params_step.index
	st_diag = params_step.diagnostics

	var return_type: Option[ParsedTypeExpr] = None
	var end_span: SourceSpan = name_step.value.span

	if current_is_symbol(state, st, ArrowSymbol):
		st = advance_parser(state, st)
		type_step: ParseTypeStep = parse_type_expr(state, st, st_diag)
		return_type = Some(type_step.value)
		st = type_step.index
		st_diag = type_step.diagnostics
		end_span = parsed_type_expr_span(type_step.value)

	dim_constraints_step: ParseDimConstraintListStep = parse_dim_constraints_opt(state, st, st_diag)
	st = dim_constraints_step.index
	st_diag = dim_constraints_step.diagnostics
	end_span = last_dim_constraint_span(dim_constraints_step.values, end_span)

	body_step: ParseBodyStep = if current_is_symbol(state, st, ColonSymbol):
		colon_step: ParseSymbolStep = expect_symbol(
			state,
			st,
			st_diag,
			ColonSymbol,
			"expected `:` before function body",
		)
		st = colon_step.index
		st_diag = colon_step.diagnostics

		if current_is_eof(state, st) or current_is_dedent(state, st):
			{
				index = st,
				diagnostics = st_diag,
				body = None
			}
		else if current_is_newline(state, st) and not current_is_indent(
			state,
			advance_parser(state, st),
		):
			{
				index = st,
				diagnostics = st_diag,
				body = None
			}
		else if (
			not current_is_newline(state, st)
			and current_span(state, st).start_line > colon_step.span.start_line
		):
			{
				index = st,
				diagnostics = st_diag,
				body = None
			}
		else:
			parse_function_body(state, st, st_diag, start_span)
	else if (
		current_is_newline(state, st)
		or current_is_dedent(state, st)
		or current_is_eof(state, st)
	):
		{
			index = st,
			diagnostics = st_diag,
			body = None
		}
	else:
		error_state: Int = st
		error_state_diag: List[ParseDiagnostic] = add_expected_error(
			st_diag,
			current_span(state, st),
			"expected `:` before function body",
			[":"],
			None,
		)
		{
			index = error_state,
			diagnostics = error_state_diag,
			body = None
		}

	st = body_step.index
	st_diag = body_step.diagnostics

	match body_step.body:
		Some(body):
			end_span = parsed_expr_span(body)
		None:
			if end_span.start_offset == name_step.value.span.start_offset:
				end_span = func_span

	{
		index = st,
		diagnostics = st_diag,
		value = {
			name = name_step.value,
			keyword_span = Some(func_span),
			type_params = type_params_step.values,
			params = params_step.values,
			return_type = return_type,
			dim_constraints = dim_constraints_step.values,
			body = body_step.body,
			is_pure = is_pure,
			annotations = annotations,
			doc = doc,
			span = span_cover(start_span, end_span)
		}
	}


private pure func parse_function_decl(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	doc: Option[String],
	is_pure: Bool,
	annotations: List[ParsedFunctionAnnotation],
	start_span: SourceSpan,
) -> ParseDeclStep:
	function_step: ParseFunctionStep = parse_function_decl_value(
		state,
		index,
		diagnostics,
		doc,
		is_pure,
		annotations,
		start_span,
	)

	{
		index = function_step.index,
		diagnostics = function_step.diagnostics,
		value = FunctionParsedDecl(function_step.value)
	}


private pure func parse_import_symbol(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseImportSymbolStep:
	name_step: ParseIdentifierStep = parse_identifier_expected(
		state,
		index,
		diagnostics,
		"import symbol",
	)
	var st: Int = name_step.index
	var st_diag: List[ParseDiagnostic] = name_step.diagnostics
	var constructors: List[ParsedIdentifier] = []
	var symbol_alias: Option[ParsedIdentifier] = None
	var end_span: SourceSpan = name_step.value.span

	if current_is_symbol(state, st, LeftParenSymbol):
		ctors_step: ParseIdentifierListStep = parse_identifier_list_until(
			state,
			advance_parser(state, st),
			st_diag,
			RightParenSymbol,
			True,
			"constructor name",
		)
		constructors = ctors_step.values
		var ctors_state: Int = ctors_step.index
		var ctors_state_diag: List[ParseDiagnostic] = ctors_step.diagnostics

		if constructors.length() == 0:
			ctors_state_diag = add_expected_error(
				ctors_state_diag,
				current_span(state, ctors_state),
				"expected constructor name",
				[EXPECTED_CONSTRUCTOR_NAME],
				None,
			)

		right_step: ParseSymbolStep = expect_symbol(
			state,
			ctors_state,
			ctors_state_diag,
			RightParenSymbol,
			"expected `)` after imported constructors",
		)
		st = right_step.index
		st_diag = right_step.diagnostics

		if right_step.matched:
			end_span = right_step.span

	if current_is_keyword(state, st, AsKeyword):
		alias_step: ParseIdentifierStep = parse_declared_name_expected(
			state,
			advance_parser(state, st),
			st_diag,
			"import symbol alias",
		)
		symbol_alias = Some(alias_step.value)
		st = alias_step.index
		st_diag = alias_step.diagnostics
		end_span = alias_step.value.span

	{
		index = st,
		diagnostics = st_diag,
		value = {
			name = name_step.value,
			symbol_alias = symbol_alias,
			constructors = constructors,
			span = span_cover(name_step.value.span, end_span)
		}
	}


private pure func parse_import_symbols_until_line_end(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseImportSymbolListStep:
	var st: Int = index
	var st_diag: List[ParseDiagnostic] = diagnostics
	var symbols: List[ParsedImportSymbol] = []

	while not current_is_newline(state, st) and not current_is_block_end(state, st):
		before_index: Int = st
		symbol_step: ParseImportSymbolStep = parse_import_symbol(state, st, st_diag)
		symbols = symbols.append(symbol_step.value)
		st = symbol_step.index
		st_diag = symbol_step.diagnostics

		if current_is_symbol(state, st, CommaSymbol):
			st = advance_parser(state, st)
		else if not current_is_newline(state, st) and not current_is_block_end(state, st):
			st_diag = add_expected_error(
				st_diag,
				current_span(state, st),
				"expected `, ` between imported symbols",
				[","],
				None,
			)

		if (
			st == before_index
			and not current_is_newline(state, st)
			and not current_is_block_end(state, st)
		):
			st = advance_parser(state, st)

	{
		index = st,
		diagnostics = st_diag,
		values = symbols
	}


private pure func parse_import_symbols_block(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseImportSymbolListStep:
	__step_15: ParserStep = expect_indent(state, index, diagnostics)
	var st: Int = __step_15.index
	var st_diag: List[ParseDiagnostic] = __step_15.diagnostics
	st = skip_newlines(state, st)
	var symbols: List[ParsedImportSymbol] = []

	while not current_is_block_end(state, st):
		before_index: Int = st
		line_step: ParseImportSymbolListStep = parse_import_symbols_until_line_end(
			state,
			st,
			st_diag,
		)
		symbols = symbols.concat(line_step.values)
		st = skip_newlines(state, line_step.index)
		st_diag = line_step.diagnostics

		if st == before_index and not current_is_block_end(state, st):
			st = advance_parser(state, st)

	if current_is_dedent(state, st):
		st = advance_parser(state, st)

	{
		index = st,
		diagnostics = st_diag,
		values = symbols
	}


private pure func parse_module_path(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseModulePathStep:
	var st: Int = index
	var st_diag: List[ParseDiagnostic] = diagnostics
	var prefix: String = ""
	var start_span: SourceSpan = current_span(state, index)

	if current_is_symbol(state, st, DotSymbol) and next_is_symbol(state, st, SlashSymbol):
		prefix = "./"
		st = advance_parser(
			state,
			advance_parser(state, st),
		)
	else:
		var parsing_parent_prefix: Bool = True

		while parsing_parent_prefix:
			if (
				current_is_symbol(state, st, DotDotSymbol)
				and next_is_symbol(state, st, SlashSymbol)
			):
				prefix += "../"
				st = advance_parser(
					state,
					advance_parser(state, st),
				)
			else:
				parsing_parent_prefix = False

	first_step: ParseIdentifierStep = parse_identifier_expected(state, st, st_diag, "module path")
	st = first_step.index
	st_diag = first_step.diagnostics
	var path: String = prefix + first_step.value.text
	var end_span: SourceSpan = first_step.value.span

	while current_is_symbol(state, st, SlashSymbol):
		st = advance_parser(state, st)
		part_step: ParseIdentifierStep = parse_identifier_expected(
			state,
			st,
			st_diag,
			"module path",
		)
		part_text: String = part_step.value.text
		path = "${path}/${part_text}"
		st = part_step.index
		st_diag = part_step.diagnostics
		end_span = part_step.value.span

	{
		index = st,
		diagnostics = st_diag,
		value = path,
		span = span_cover(start_span, end_span)
	}


private pure func parse_import_item(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseImportItemStep:
	path_step: ParseModulePathStep = parse_module_path(state, index, diagnostics)
	var st: Int = path_step.index
	var st_diag: List[ParseDiagnostic] = path_step.diagnostics
	var module_alias: Option[ParsedIdentifier] = None
	var symbols: Option[List[ParsedImportSymbol]] = None
	var end_span: SourceSpan = path_step.span

	if current_is_keyword(state, st, AsKeyword):
		alias_step: ParseIdentifierStep = parse_declared_name_expected(
			state,
			advance_parser(state, st),
			st_diag,
			"module alias",
		)
		module_alias = Some(alias_step.value)
		st = alias_step.index
		st_diag = alias_step.diagnostics
		end_span = alias_step.value.span

	if current_is_symbol(state, st, ColonSymbol):
		st = advance_parser(state, st)

		if current_is_newline(state, st):
			block_start: Int = skip_newlines(state, st)
			block_start_diag: List[ParseDiagnostic] = st_diag

			if current_is_indent(state, block_start):
				symbols_step: ParseImportSymbolListStep = parse_import_symbols_block(
					state,
					block_start,
					block_start_diag,
				)
				symbols = Some(symbols_step.values)
				st = symbols_step.index
				st_diag = symbols_step.diagnostics

				match symbols_step.values.get(symbols_step.values.length() - 1):
					Some(last_symbol):
						end_span = last_symbol.span
					None:
						void
			else:
				st_diag = add_expected_error(
					st_diag,
					current_span(state, st),
					"expected import symbols after `:`",
					["import symbol"],
					None,
				)
				symbols = Some([])
		else:
			symbols_step: ParseImportSymbolListStep = parse_import_symbols_until_line_end(
				state,
				st,
				st_diag,
			)
			symbols = Some(symbols_step.values)
			st = symbols_step.index
			st_diag = symbols_step.diagnostics

			match symbols_step.values.get(symbols_step.values.length() - 1):
				Some(last_symbol):
					end_span = last_symbol.span
				None:
					void

	{
		index = st,
		diagnostics = st_diag,
		value = {
			module_path = path_step.value,
			module_path_span = path_step.span,
			module_alias = module_alias,
			symbols = symbols,
			span = span_cover(path_step.span, end_span)
		}
	}


private pure func parse_import_item_list(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseImportItemListStep:
	var st: Int = skip_newlines(state, index)
	var st_diag: List[ParseDiagnostic] = diagnostics
	var items: List[ParsedImportDecl] = []

	while not current_is_block_end(state, st):
		before_index: Int = st
		item_step: ParseImportItemStep = parse_import_item(state, st, st_diag)
		items = items.append(item_step.value)
		st = skip_newlines(state, item_step.index)
		st_diag = item_step.diagnostics

		if st == before_index and not current_is_block_end(state, st):
			st = advance_parser(state, st)

	{
		index = st,
		diagnostics = st_diag,
		values = items
	}


private pure func parse_import_block_decl(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	start_span: SourceSpan,
) -> ParseDeclStep:
	var st: Int = advance_parser(state, index)
	var st_diag: List[ParseDiagnostic] = diagnostics
	colon_step: ParseSymbolStep = expect_symbol(
		state,
		st,
		st_diag,
		ColonSymbol,
		"expected `:` after import",
	)
	__step_16: ParserStep = expect_newline(
		state,
		colon_step.index,
		colon_step.diagnostics,
		"expected newline after import header",
	)
	st = __step_16.index
	st_diag = __step_16.diagnostics
	__step_17: ParserStep = expect_indent(state, st, st_diag)
	st = __step_17.index
	st_diag = __step_17.diagnostics
	items_step: ParseImportItemListStep = parse_import_item_list(state, st, st_diag)
	st = items_step.index
	st_diag = items_step.diagnostics

	end_span: SourceSpan = if current_is_dedent(state, st):
		current_span(state, st)
	else:
		start_span

	__step_18: ParserStep = expect_dedent(state, st, st_diag)
	st = __step_18.index
	st_diag = __step_18.diagnostics

	{
		index = st,
		diagnostics = st_diag,
		value = ImportBlockParsedDecl(
			items_step.values,
			span_cover(start_span, end_span),
		)
	}


private pure func add_foreign_block_only_error(
	diagnostics: List[ParseDiagnostic],
	span: SourceSpan,
) -> List[ParseDiagnostic]:
	add_expected_error(
		diagnostics,
		span,
		(
			"foreign declarations must use a foreign: block; write `foreign:` and indent "
			+ "`func ...` inside it"
		),
		["foreign:"],
		Some("write `foreign:` followed by an indented function signature"),
	)


private pure func parse_foreign_block_arg(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseForeignBlockArgStep:
	name_step: ParseIdentifierStep = parse_identifier_expected(
		state,
		index,
		diagnostics,
		EXPECTED_FOREIGN_BLOCK_ARG,
	)
	var st: Int = name_step.index
	var st_diag: List[ParseDiagnostic] = name_step.diagnostics
	colon_step: ParseSymbolStep = expect_symbol(
		state,
		st,
		st_diag,
		ColonSymbol,
		"expected `:` after foreign block argument name",
	)
	st = colon_step.index
	st_diag = colon_step.diagnostics
	var value: String = ""
	var end_span: SourceSpan = name_step.value.span

	match current_token_kind(state, st):
		StringLiteralToken(_, text):
			value = text
			end_span = current_span(state, st)
			st = advance_parser(state, st)
		_:
			st_diag = add_expected_error(
				st_diag,
				current_span(state, st),
				"expected foreign block argument value",
				["string literal"],
				Some("write foreign block arguments as name: \"value\""),
			)

			if not current_is_soft_boundary(state, st):
				st = advance_parser(state, st)

	{
		index = st,
		diagnostics = st_diag,
		value = {
			name = name_step.value,
			value = value,
			span = span_cover(name_step.value.span, end_span)
		}
	}


private pure func parse_foreign_block_arg_list_until_right_paren(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseForeignBlockArgListStep:
	var st: Int = index
	var st_diag: List[ParseDiagnostic] = diagnostics
	var values: List[ParsedForeignBlockArg] = []

	if current_is_symbol(state, st, RightParenSymbol):
		st_diag = add_expected_error(
			st_diag,
			current_span(state, st),
			"expected foreign block argument",
			[EXPECTED_FOREIGN_BLOCK_ARG],
			Some("omit the parentheses for a foreign block with no arguments"),
		)
	else:
		var parsing_args: Bool = True

		while parsing_args and not current_is_eof(state, st):
			before_index: Int = st
			arg_step: ParseForeignBlockArgStep = parse_foreign_block_arg(state, st, st_diag)
			values = values.append(arg_step.value)
			st = arg_step.index
			st_diag = arg_step.diagnostics

			if current_is_symbol(state, st, CommaSymbol):
				st = advance_parser(state, st)

				if current_is_symbol(state, st, RightParenSymbol):
					parsing_args = False
			else if current_is_symbol(state, st, RightParenSymbol):
				parsing_args = False
			else:
				st_diag = add_expected_error(
					st_diag,
					current_span(state, st),
					"expected `, ` between foreign block arguments",
					[","],
					None,
				)

			if st == before_index and not current_is_symbol(state, st, RightParenSymbol):
				st = advance_parser(state, st)

	{
		index = st,
		diagnostics = st_diag,
		values = values
	}


private pure func current_can_start_foreign_function(state: ParserInput, index: Int) -> Bool:
	(
		current_is_keyword(state, index, PrivateKeyword)
		or current_is_keyword(state, index, PureKeyword)
		or current_is_keyword(state, index, FuncKeyword)
		or current_is_symbol(state, index, AtSymbol)
	)


private pure func parse_foreign_function_decl(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseForeignFunctionStep:
	var st: Int = index
	var st_diag: List[ParseDiagnostic] = diagnostics
	start_span: SourceSpan = current_span(state, st)
	var is_private: Bool = False

	if current_is_keyword(state, st, PrivateKeyword):
		is_private = True
		st = advance_parser(state, st)

	annotations_step: ParseFunctionAnnotationsStep = parse_function_annotations(
		state,
		st,
		st_diag,
		False,
	)
	st = annotations_step.index
	st_diag = annotations_step.diagnostics
	var is_pure: Bool = False

	if current_is_keyword(state, st, PureKeyword):
		is_pure = True
		st = advance_parser(state, st)

	__step_19: ParserStep = expect_keyword(
		state,
		st,
		st_diag,
		FuncKeyword,
		"func",
		"expected `func` in foreign block item",
	)
	st = __step_19.index
	st_diag = __step_19.diagnostics
	name_step: ParseIdentifierStep = parse_declared_name_expected(
		state,
		st,
		st_diag,
		EXPECTED_FUNCTION_NAME,
	)
	st = name_step.index
	st_diag = name_step.diagnostics
	left_step: ParseSymbolStep = expect_symbol(
		state,
		st,
		st_diag,
		LeftParenSymbol,
		"expected `(` after foreign function name",
	)
	st = left_step.index
	st_diag = left_step.diagnostics

	params_step: ParseParamsStep = if left_step.matched:
		parse_params_after_left_paren(state, st, st_diag)
	else:
		{
			index = st,
			diagnostics = st_diag,
			values = []
		}

	st = params_step.index
	st_diag = params_step.diagnostics
	var return_type: ParsedTypeExpr = ParsedMissingType(current_span(state, st))
	var end_span: SourceSpan = name_step.value.span
	arrow_step: ParseSymbolStep = expect_symbol(
		state,
		st,
		st_diag,
		ArrowSymbol,
		"expected `->` before foreign function return type",
	)
	st = arrow_step.index
	st_diag = arrow_step.diagnostics

	if arrow_step.matched:
		type_step: ParseTypeStep = parse_type_expr(state, st, st_diag)
		return_type = type_step.value
		st = type_step.index
		st_diag = type_step.diagnostics
		end_span = parsed_type_expr_span(type_step.value)
	else:
		end_span = arrow_step.span

	var c_name: Option[String] = None

	if current_is_symbol(state, st, EqualSymbol):
		st = advance_parser(state, st)

		match current_token_kind(state, st):
			StringLiteralToken(_, text):
				c_name = Some(text)
				end_span = current_span(state, st)
				st = advance_parser(state, st)
			_:
				st_diag = add_expected_error(
					st_diag,
					current_span(state, st),
					"expected foreign C function name",
					["string literal"],
					Some("write = \"c_function_name\" or omit the C name to use the Blorp name"),
				)

				if not current_is_soft_boundary(state, st):
					st = advance_parser(state, st)

	{
		index = st,
		diagnostics = st_diag,
		value = {
			name = name_step.value,
			params = params_step.values,
			return_type = return_type,
			c_name = c_name,
			is_pure = is_pure,
			is_private = is_private,
			annotations = annotations_step.values,
			span = span_cover(start_span, end_span)
		}
	}


private pure func parse_foreign_function_list(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseForeignFunctionListStep:
	var st: Int = skip_newlines(state, index)
	var st_diag: List[ParseDiagnostic] = diagnostics
	var values: List[ParsedForeignFunctionDecl] = []

	while not current_is_block_end(state, st):
		before_index: Int = st

		if current_can_start_foreign_function(state, st):
			function_step: ParseForeignFunctionStep = parse_foreign_function_decl(
				state,
				st,
				st_diag,
			)
			values = values.append(function_step.value)
			st = skip_newlines(state, function_step.index)
			st_diag = function_step.diagnostics
		else:
			st_diag = add_expected_error(
				st_diag,
				current_span(state, st),
				"expected foreign function declaration",
				["func"],
				Some("write a bodyless function signature inside the foreign block"),
			)

			if not current_is_block_end(state, st):
				st = advance_parser(state, st)

			st = skip_newlines(state, st)

		if st == before_index and not current_is_block_end(state, st):
			st = advance_parser(state, st)

	{
		index = st,
		diagnostics = st_diag,
		values = values
	}


private pure func parse_foreign_block_decl(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	start_span: SourceSpan,
) -> ParseDeclStep:
	var st: Int = advance_parser(state, index)
	var st_diag: List[ParseDiagnostic] = diagnostics

	if current_is_keyword(state, st, PureKeyword) or current_is_keyword(state, st, FuncKeyword):
		error_state: Int = st
		error_state_diag: List[ParseDiagnostic] = add_foreign_block_only_error(st_diag, start_span)

		{
			index = advance_parser(state, error_state),
			diagnostics = error_state_diag,
			value = ParsedErrorDecl(start_span)
		}
	else:
		var args: List[ParsedForeignBlockArg] = []

		if current_is_symbol(state, st, LeftParenSymbol):
			args_step: ParseForeignBlockArgListStep = parse_foreign_block_arg_list_until_right_paren(
				state,
				advance_parser(state, st),
				st_diag,
			)
			args = args_step.values
			right_step: ParseSymbolStep = expect_symbol(
				state,
				args_step.index,
				args_step.diagnostics,
				RightParenSymbol,
				"expected `)` after foreign block arguments",
			)
			st = right_step.index
			st_diag = right_step.diagnostics

		colon_step: ParseSymbolStep = expect_symbol(
			state,
			st,
			st_diag,
			ColonSymbol,
			"expected `:` after foreign",
		)
		__step_20: ParserStep = expect_newline(
			state,
			colon_step.index,
			colon_step.diagnostics,
			"expected newline after foreign header",
		)
		st = __step_20.index
		st_diag = __step_20.diagnostics
		__step_21: ParserStep = expect_indent(state, st, st_diag)
		st = __step_21.index
		st_diag = __step_21.diagnostics
		functions_step: ParseForeignFunctionListStep = parse_foreign_function_list(
			state,
			st,
			st_diag,
		)
		st = functions_step.index
		st_diag = functions_step.diagnostics

		end_span: SourceSpan = if current_is_dedent(state, st):
			current_span(state, st)
		else:
			start_span

		__step_22: ParserStep = expect_dedent(state, st, st_diag)
		st = __step_22.index
		st_diag = __step_22.diagnostics

		{
			index = st,
			diagnostics = st_diag,
			value = ForeignBlockParsedDecl(
				args,
				functions_step.values,
				span_cover(start_span, end_span),
			)
		}


private pure func parse_field_decl(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseFieldStep:
	name_step: ParseIdentifierStep = parse_declared_name_expected(
		state,
		index,
		diagnostics,
		"field name",
	)
	colon_step: ParseSymbolStep = expect_symbol(
		state,
		name_step.index,
		name_step.diagnostics,
		ColonSymbol,
		"expected `:` after field name",
	)
	type_step: ParseTypeStep = parse_type_expr(state, colon_step.index, colon_step.diagnostics)

	{
		index = type_step.index,
		diagnostics = type_step.diagnostics,
		value = {
			name = name_step.value,
			type_expr = type_step.value,
			span = span_cover(name_step.value.span, parsed_type_expr_span(type_step.value))
		}
	}


private pure func parse_field_list_until_right_brace(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseFieldListStep:
	var st: Int = index
	var st_diag: List[ParseDiagnostic] = diagnostics
	var fields: List[ParsedFieldDecl] = []

	if not current_is_symbol(state, st, RightBraceSymbol):
		var parsing_fields: Bool = True

		while parsing_fields and not current_is_eof(state, st):
			field_step: ParseFieldStep = parse_field_decl(state, st, st_diag)
			fields = fields.append(field_step.value)
			st = field_step.index
			st_diag = field_step.diagnostics

			if current_is_symbol(state, st, CommaSymbol):
				st = advance_parser(state, st)

				if current_is_symbol(state, st, RightBraceSymbol):
					parsing_fields = False
			else:
				parsing_fields = False

	{
		index = st,
		diagnostics = st_diag,
		values = fields
	}


private pure func parse_record_decl(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	doc: Option[String],
	syntax: AggregateDeclarationSyntax,
	start_span: SourceSpan,
) -> ParseDeclStep:
	var st: Int = advance_parser(state, index)
	var st_diag: List[ParseDiagnostic] = diagnostics
	is_struct: Bool = syntax == StructDeclarationSyntax

	name_expected: String = if is_struct:
		"struct name"
	else:
		"record name"

	open_fields_message: String = if is_struct:
		"expected `{` before struct fields"
	else:
		"expected `{` before record fields"

	close_fields_message: String = if is_struct:
		"expected `}` after struct fields"
	else:
		"expected `}` after record fields"

	name_step: ParseIdentifierStep = parse_declared_name_expected(state, st, st_diag, name_expected)
	st = name_step.index
	st_diag = name_step.diagnostics

	type_params_step: ParseTypeParamListStep = if is_struct:
		{
			index = st,
			diagnostics = st_diag,
			values = []
		}
	else:
		parse_type_params_opt(state, st, st_diag)

	st = type_params_step.index
	st_diag = type_params_step.diagnostics
	left_step: ParseSymbolStep = expect_symbol(
		state,
		st,
		st_diag,
		LeftBraceSymbol,
		open_fields_message,
	)
	fields_step: ParseFieldListStep = parse_field_list_until_right_brace(
		state,
		left_step.index,
		left_step.diagnostics,
	)
	right_step: ParseSymbolStep = expect_symbol(
		state,
		fields_step.index,
		fields_step.diagnostics,
		RightBraceSymbol,
		close_fields_message,
	)

	{
		index = right_step.index,
		diagnostics = right_step.diagnostics,
		value = RecordParsedDecl({
			name = name_step.value,
			type_params = type_params_step.values,
			fields = fields_step.values,
			is_struct = is_struct,
			doc = doc,
			span = span_cover(start_span, right_step.span),
		})
	}


private pure func parse_variant_identifier_expected(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseIdentifierStep:
	token: Token = current_token(state, index)

	match token.kind:
		KeywordToken(TrueKeyword):
			{
				index = advance_parser(state, index),
				diagnostics = diagnostics,
				value = parsed_identifier("True", token.span)
			}
		KeywordToken(FalseKeyword):
			{
				index = advance_parser(state, index),
				diagnostics = diagnostics,
				value = parsed_identifier("False", token.span)
			}
		_:
			parse_declared_name_expected(state, index, diagnostics, "variant name")


private pure func parse_variant_decl(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseVariantStep:
	name_step: ParseIdentifierStep = parse_variant_identifier_expected(state, index, diagnostics)
	var st: Int = name_step.index
	var st_diag: List[ParseDiagnostic] = name_step.diagnostics
	var fields: List[ParsedTypeExpr] = []
	var end_span: SourceSpan = name_step.value.span

	if current_is_symbol(state, st, LeftParenSymbol):
		fields_step: ParseTypeListStep = parse_type_expr_list_until(
			state,
			advance_parser(state, st),
			st_diag,
			RightParenSymbol,
			True,
		)
		fields = fields_step.values
		right_step: ParseSymbolStep = expect_symbol(
			state,
			fields_step.index,
			fields_step.diagnostics,
			RightParenSymbol,
			"expected `)` after variant fields",
		)
		st = right_step.index
		st_diag = right_step.diagnostics

		if right_step.matched:
			end_span = right_step.span

	{
		index = st,
		diagnostics = st_diag,
		value = {
			name = name_step.value,
			fields = fields,
			span = span_cover(name_step.value.span, end_span)
		}
	}


private pure func parse_variant_list(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseVariantListStep:
	var st: Int = skip_newlines(state, index)
	var st_diag: List[ParseDiagnostic] = diagnostics
	var variants: List[ParsedVariantDecl] = []

	while not current_is_block_end(state, st):
		before_index: Int = st
		variant_step: ParseVariantStep = parse_variant_decl(state, st, st_diag)
		variants = variants.append(variant_step.value)
		st = skip_newlines(state, variant_step.index)
		st_diag = variant_step.diagnostics

		if st == before_index and not current_is_block_end(state, st):
			st = advance_parser(state, st)

	{
		index = st,
		diagnostics = st_diag,
		values = variants
	}


private pure func parse_union_decl(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	doc: Option[String],
	is_enum: Bool,
	start_span: SourceSpan,
) -> ParseDeclStep:
	var st: Int = advance_parser(state, index)
	var st_diag: List[ParseDiagnostic] = diagnostics
	name_step: ParseIdentifierStep = parse_declared_name_expected(state, st, st_diag, "type name")
	st = name_step.index
	st_diag = name_step.diagnostics

	type_params_step: ParseTypeParamListStep = if is_enum:
		{
			index = st,
			diagnostics = st_diag,
			values = []
		}
	else:
		parse_type_params_opt(state, st, st_diag)

	st = type_params_step.index
	st_diag = type_params_step.diagnostics
	colon_step: ParseSymbolStep = expect_symbol(
		state,
		st,
		st_diag,
		ColonSymbol,
		"expected `:` before variants",
	)
	__step_23: ParserStep = expect_newline(
		state,
		colon_step.index,
		colon_step.diagnostics,
		"expected newline before variants",
	)
	st = __step_23.index
	st_diag = __step_23.diagnostics
	__step_24: ParserStep = expect_indent(state, st, st_diag)
	st = __step_24.index
	st_diag = __step_24.diagnostics
	variants_step: ParseVariantListStep = parse_variant_list(state, st, st_diag)
	st = variants_step.index
	st_diag = variants_step.diagnostics

	end_span: SourceSpan = if current_is_dedent(state, st):
		current_span(state, st)
	else:
		name_step.value.span

	__step_25: ParserStep = expect_dedent(state, st, st_diag)
	st = __step_25.index
	st_diag = __step_25.diagnostics

	{
		index = st,
		diagnostics = st_diag,
		value = UnionParsedDecl({
			name = name_step.value,
			type_params = type_params_step.values,
			variants = variants_step.values,
			is_enum = is_enum,
			doc = doc,
			span = span_cover(start_span, end_span),
		})
	}


private pure func consume_builtin_type_argument_list(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParserStep:
	var st: Int = index
	var st_diag: List[ParseDiagnostic] = add_expected_error(
		diagnostics,
		current_span(state, index),
		"builtin type declarations do not take arguments",
		[],
		Some("use `resource type Name = builtin(\"cleanup\")` for resource cleanup metadata"),
	)

	st = advance_parser(state, st)

	while (
		not current_is_eof(state, st)
		and not current_is_newline(state, st)
		and not current_is_symbol(state, st, RightParenSymbol)
	):
		st = advance_parser(state, st)

	if current_is_symbol(state, st, RightParenSymbol):
		{
			index = advance_parser(state, st),
			diagnostics = st_diag
		}
	else:
		{
			index = st,
			diagnostics = st_diag
		}


private pure func parse_builtin_type_decl(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	doc: Option[String],
	is_resource: Bool,
	start_span: SourceSpan,
) -> ParseDeclStep:
	var st: Int = if is_resource:
		advance_parser(state, index)
	else:
		index

	var st_diag: List[ParseDiagnostic] = diagnostics

	keyword_step: ParserStep = expect_keyword(
		state,
		st,
		st_diag,
		TypeKeyword,
		"type",
		"expected `type` in builtin type declaration",
	)
	st = keyword_step.index
	st_diag = keyword_step.diagnostics
	name_step: ParseIdentifierStep = parse_declared_name_expected(state, st, st_diag, "type name")
	st = name_step.index
	st_diag = name_step.diagnostics
	type_params_step: ParseTypeParamListStep = parse_type_params_opt(state, st, st_diag)
	st = type_params_step.index
	st_diag = type_params_step.diagnostics
	equal_step: ParseSymbolStep = expect_symbol(
		state,
		st,
		st_diag,
		EqualSymbol,
		"expected `=` before builtin type marker",
	)
	builtin_span: SourceSpan = current_span(state, equal_step.index)
	builtin_keyword_step: ParserStep = expect_keyword(
		state,
		equal_step.index,
		equal_step.diagnostics,
		BuiltinKeyword,
		"builtin",
		"expected `builtin` after `=`",
	)
	st = builtin_keyword_step.index
	st_diag = builtin_keyword_step.diagnostics
	var cleanup: Option[ParsedResourceCleanup] = None
	var end_span: SourceSpan = builtin_span

	if current_is_symbol(state, st, LeftParenSymbol):
		if is_resource:
			st = advance_parser(state, st)

			match current_token_kind(state, st):
				StringLiteralToken(_, text):
					cleanup = Some({
						builtin_name = text,
						span = current_span(state, st),
					})
					end_span = current_span(state, st)
					st = advance_parser(state, st)
				_:
					st_diag = add_expected_error(
						st_diag,
						current_span(state, st),
						"expected resource cleanup builtin name",
						["string literal"],
						Some("write resource type Name = builtin(\"cleanup_function\")"),
					)

					if not current_is_soft_boundary(state, st):
						st = advance_parser(state, st)

			right_step: ParseSymbolStep = expect_symbol(
				state,
				st,
				st_diag,
				RightParenSymbol,
				"expected `)` after resource cleanup builtin name",
			)
			st = right_step.index
			st_diag = right_step.diagnostics

			if right_step.matched:
				end_span = right_step.span
		else:
			argument_list_step: ParserStep = consume_builtin_type_argument_list(state, st, st_diag)
			st = argument_list_step.index
			st_diag = argument_list_step.diagnostics

	{
		index = st,
		diagnostics = st_diag,
		value = BuiltinTypeParsedDecl({
			name = name_step.value,
			type_params = type_params_step.values,
			is_resource = is_resource,
			cleanup = cleanup,
			doc = doc,
			span = span_cover(start_span, end_span),
		})
	}


private pure func parse_type_alias_decl(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	doc: Option[String],
	is_opaque: Bool,
	start_span: SourceSpan,
) -> ParseDeclStep:
	var st: Int = advance_parser(state, index)
	var st_diag: List[ParseDiagnostic] = diagnostics

	if is_opaque:
		__step_26: ParserStep = expect_keyword(
			state,
			st,
			st_diag,
			TypeKeyword,
			"type",
			"expected `type` after `opaque`",
		)
		st = __step_26.index
		st_diag = __step_26.diagnostics
	else:
		__step_27: ParserStep = expect_keyword(
			state,
			st,
			st_diag,
			AliasKeyword,
			"alias",
			"expected `alias` after `type`",
		)
		st = __step_27.index
		st_diag = __step_27.diagnostics

	name_step: ParseIdentifierStep = parse_declared_name_expected(
		state,
		st,
		st_diag,
		"type alias name",
	)
	st = name_step.index
	st_diag = name_step.diagnostics
	type_params_step: ParseTypeParamListStep = parse_type_params_opt(state, st, st_diag)
	st = type_params_step.index
	st_diag = type_params_step.diagnostics
	equal_step: ParseSymbolStep = expect_symbol(
		state,
		st,
		st_diag,
		EqualSymbol,
		"expected `=` before type alias target",
	)
	target_step: ParseTypeStep = parse_type_expr(state, equal_step.index, equal_step.diagnostics)

	{
		index = target_step.index,
		diagnostics = target_step.diagnostics,
		value = TypeAliasParsedDecl({
			name = name_step.value,
			type_params = type_params_step.values,
			target = target_step.value,
			is_opaque = is_opaque,
			doc = doc,
			span = span_cover(start_span, parsed_type_expr_span(target_step.value)),
		})
	}


private pure func parse_trait_method(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseTraitMethodStep:
	var st: Int = index
	var st_diag: List[ParseDiagnostic] = diagnostics
	var is_pure: Bool = False
	start_span: SourceSpan = current_span(state, st)

	if current_is_keyword(state, st, PureKeyword):
		is_pure = True
		st = advance_parser(state, st)

	__step_28: ParserStep = expect_keyword(
		state,
		st,
		st_diag,
		FuncKeyword,
		"func",
		"expected `func` before trait method",
	)
	st = __step_28.index
	st_diag = __step_28.diagnostics
	name_step: ParseIdentifierStep = parse_declared_name_expected(
		state,
		st,
		st_diag,
		"trait method name",
	)
	st = name_step.index
	st_diag = name_step.diagnostics
	left_step: ParseSymbolStep = expect_symbol(
		state,
		st,
		st_diag,
		LeftParenSymbol,
		"expected `(` after trait method name",
	)
	st = left_step.index
	st_diag = left_step.diagnostics

	params_step: ParseParamsStep = if left_step.matched:
		parse_params_after_left_paren(state, st, st_diag)
	else:
		{
			index = st,
			diagnostics = st_diag,
			values = []
		}

	st = params_step.index
	st_diag = params_step.diagnostics
	var return_type: Option[ParsedTypeExpr] = None
	var body: Option[ParsedExpr] = None
	var end_span: SourceSpan = name_step.value.span

	if current_is_symbol(state, st, ArrowSymbol):
		st = advance_parser(state, st)
		type_step: ParseTypeStep = parse_type_expr(state, st, st_diag)
		return_type = Some(type_step.value)
		st = type_step.index
		st_diag = type_step.diagnostics
		end_span = parsed_type_expr_span(type_step.value)

	if current_is_symbol(state, st, ColonSymbol):
		colon_step: ParseSymbolStep = expect_symbol(
			state,
			st,
			st_diag,
			ColonSymbol,
			"expected `:` before trait method body",
		)
		body_step: ParseBodyStep = parse_function_body(
			state,
			colon_step.index,
			colon_step.diagnostics,
			start_span,
		)
		body = body_step.body
		st = body_step.index
		st_diag = body_step.diagnostics

		match body_step.body:
			Some(body_expr):
				end_span = parsed_expr_span(body_expr)
			None:
				end_span = colon_step.span

	{
		index = st,
		diagnostics = st_diag,
		value = {
			name = name_step.value,
			params = params_step.values,
			return_type = return_type,
			body = body,
			is_pure = is_pure,
			span = span_cover(start_span, end_span)
		}
	}


private pure func parse_trait_method_list(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseTraitMethodListStep:
	var st: Int = skip_newlines(state, index)
	var st_diag: List[ParseDiagnostic] = diagnostics
	var values: List[ParsedTraitMethodDecl] = []

	while not current_is_block_end(state, st):
		before_index: Int = st
		method_step: ParseTraitMethodStep = parse_trait_method(state, st, st_diag)
		values = values.append(method_step.value)
		st = skip_newlines(state, method_step.index)
		st_diag = method_step.diagnostics

		if st == before_index and not current_is_block_end(state, st):
			st = advance_parser(state, st)

	{
		index = st,
		diagnostics = st_diag,
		values = values
	}


private pure func parse_trait_decl(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	doc: Option[String],
	start_span: SourceSpan,
) -> ParseDeclStep:
	var st: Int = advance_parser(state, index)
	var st_diag: List[ParseDiagnostic] = diagnostics
	name_step: ParseIdentifierStep = parse_declared_name_expected(state, st, st_diag, "trait name")
	st = name_step.index
	st_diag = name_step.diagnostics
	type_params_step: ParseTypeParamListStep = parse_type_params_opt(state, st, st_diag)
	st = type_params_step.index
	st_diag = type_params_step.diagnostics
	colon_step: ParseSymbolStep = expect_symbol(
		state,
		st,
		st_diag,
		ColonSymbol,
		"expected `:` after trait name",
	)
	st = colon_step.index
	st_diag = colon_step.diagnostics
	var supertraits: List[ParsedIdentifier] = []
	var methods: List[ParsedTraitMethodDecl] = []
	var has_method_block: Bool = False
	var end_span: SourceSpan = name_step.value.span

	if current_is_newline(state, st):
		has_method_block = True
	else if current_is_block_end(state, st):
		st_diag = add_expected_error(
			st_diag,
			current_span(
				state,
				st,
			),
			"expected supertrait or trait method block",
			["supertrait", "trait method block"],
			None,
		)
	else:
		supertraits_step: ParseIdentifierListStep = parse_plus_separated_identifier_list(
			state,
			st,
			st_diag,
			"supertrait name",
		)
		supertraits = supertraits_step.values
		st = supertraits_step.index
		st_diag = supertraits_step.diagnostics
		end_span = last_identifier_span(supertraits, end_span)

		if current_is_symbol(state, st, ColonSymbol):
			second_colon_step: ParseSymbolStep = expect_symbol(
				state,
				st,
				st_diag,
				ColonSymbol,
				"expected `:` before trait methods",
			)
			st = second_colon_step.index
			st_diag = second_colon_step.diagnostics
			has_method_block = True

	if has_method_block:
		__step_29: ParserStep = expect_newline(
			state,
			st,
			st_diag,
			"expected newline before trait methods",
		)
		st = __step_29.index
		st_diag = __step_29.diagnostics
		__step_30: ParserStep = expect_indent(state, st, st_diag)
		st = __step_30.index
		st_diag = __step_30.diagnostics
		methods_step: ParseTraitMethodListStep = parse_trait_method_list(state, st, st_diag)
		methods = methods_step.values
		st = methods_step.index
		st_diag = methods_step.diagnostics

		if current_is_dedent(state, st):
			end_span = current_span(state, st)

		__step_31: ParserStep = expect_dedent(state, st, st_diag)
		st = __step_31.index
		st_diag = __step_31.diagnostics

	{
		index = st,
		diagnostics = st_diag,
		value = TraitParsedDecl({
			name = name_step.value,
			type_params = type_params_step.values,
			supertraits = supertraits,
			methods = methods,
			doc = doc,
			span = span_cover(start_span, end_span),
		})
	}


private pure func parse_impl_method_list(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseImplMethodListStep:
	var st: Int = skip_newlines(state, index)
	var st_diag: List[ParseDiagnostic] = diagnostics
	var values: List[ParsedFunctionDecl] = []

	while not current_is_block_end(state, st):
		before_index: Int = st
		var method_start_span: SourceSpan = current_span(state, st)
		annotations_step: ParseFunctionAnnotationsStep = parse_function_annotations(
			state,
			st,
			st_diag,
			True,
		)

		if annotations_step.values.length() > 0:
			method_start_span = current_span(state, st)

		st = annotations_step.index
		st_diag = annotations_step.diagnostics
		var is_pure: Bool = False

		if current_is_keyword(state, st, PureKeyword):
			is_pure = True

			if annotations_step.values.length() == 0:
				method_start_span = current_span(state, st)

			st = advance_parser(state, st)

		if current_is_keyword(state, st, FuncKeyword):
			function_step: ParseFunctionStep = parse_function_decl_value(
				state,
				st,
				st_diag,
				None,
				is_pure,
				annotations_step.values,
				method_start_span,
			)
			values = values.append(function_step.value)
			st = skip_newlines(state, function_step.index)
			st_diag = function_step.diagnostics
		else:
			st_diag = add_expected_error(
				st_diag,
				current_span(state, st),
				"expected implementation method",
				["func"],
				Some("write a function declaration inside the implements block"),
			)

			if not current_is_block_end(state, st):
				st = advance_parser(state, st)

		if st == before_index and not current_is_block_end(state, st):
			st = advance_parser(state, st)

	{
		index = st,
		diagnostics = st_diag,
		values = values
	}


private pure func parse_impl_decl(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	doc: Option[String],
	start_span: SourceSpan,
) -> ParseDeclStep:
	var st: Int = advance_parser(state, index)
	var st_diag: List[ParseDiagnostic] = diagnostics
	trait_name_step: ParseIdentifierStep = parse_identifier_expected(
		state,
		st,
		st_diag,
		"trait name",
	)
	st = trait_name_step.index
	st_diag = trait_name_step.diagnostics
	__step_32: ParserStep = expect_keyword(
		state,
		st,
		st_diag,
		ForKeyword,
		"for",
		"expected `for` after trait name",
	)
	st = __step_32.index
	st_diag = __step_32.diagnostics
	for_type_step: ParseTypeStep = parse_type_expr(state, st, st_diag)
	st = for_type_step.index
	st_diag = for_type_step.diagnostics
	colon_step: ParseSymbolStep = expect_symbol(
		state,
		st,
		st_diag,
		ColonSymbol,
		"expected `:` before implementation methods",
	)
	__step_33: ParserStep = expect_newline(
		state,
		colon_step.index,
		colon_step.diagnostics,
		"expected newline before implementation methods",
	)
	st = __step_33.index
	st_diag = __step_33.diagnostics
	__step_34: ParserStep = expect_indent(state, st, st_diag)
	st = __step_34.index
	st_diag = __step_34.diagnostics
	methods_step: ParseImplMethodListStep = parse_impl_method_list(state, st, st_diag)
	st = methods_step.index
	st_diag = methods_step.diagnostics

	end_span: SourceSpan = if current_is_dedent(state, st):
		current_span(state, st)
	else:
		parsed_type_expr_span(for_type_step.value)

	__step_35: ParserStep = expect_dedent(state, st, st_diag)
	st = __step_35.index
	st_diag = __step_35.diagnostics

	{
		index = st,
		diagnostics = st_diag,
		value = ImplParsedDecl({
			trait_name = trait_name_step.value,
			for_type = for_type_step.value,
			methods = methods_step.values,
			doc = doc,
			span = span_cover(start_span, end_span),
		})
	}


private pure func parse_top_level_var_decl(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	is_mutable: Bool,
	start_span: SourceSpan,
) -> ParseDeclStep:
	var st: Int = if is_mutable:
		advance_parser(state, index)
	else:
		index

	var st_diag: List[ParseDiagnostic] = diagnostics

	name_step: ParseIdentifierStep = parse_binder_identifier_expected(
		state,
		st,
		st_diag,
		"variable name",
	)
	type_step: ParseOptionalTypeStep = parse_optional_type_annotation(
		state,
		name_step.index,
		name_step.diagnostics,
	)
	st = type_step.index
	st_diag = type_step.diagnostics

	equal_step: ParseSymbolStep = expect_symbol(
		state,
		st,
		st_diag,
		EqualSymbol,
		"expected `=` after top-level variable declaration",
	)
	value_step: ParseExprStep = parse_assignment_value_expr(
		state,
		equal_step.index,
		equal_step.diagnostics,
		start_span,
	)

	{
		index = value_step.index,
		diagnostics = value_step.diagnostics,
		value = VarParsedDecl({
			name = name_step.value,
			type_expr = type_step.value,
			value = value_step.value,
			is_mutable = is_mutable,
			span = span_cover(start_span, parsed_expr_span(value_step.value)),
		})
	}


private pure func parse_private_decl(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	doc: Option[String],
	start_span: SourceSpan,
) -> ParseDeclStep:
	var st: Int = advance_parser(state, index)
	var st_diag: List[ParseDiagnostic] = diagnostics
	var inner_start_span: SourceSpan = start_span

	annotations_step: ParseFunctionAnnotationsStep = parse_function_annotations(
		state,
		st,
		st_diag,
		False,
	)

	st = annotations_step.index
	st_diag = annotations_step.diagnostics

	var is_pure: Bool = False

	if current_is_keyword(state, st, PureKeyword):
		is_pure = True

		st = advance_parser(state, st)

	if annotations_step.values.length() > 0 and not current_is_keyword(state, st, FuncKeyword):
		st_diag = add_expected_error(
			st_diag,
			current_span(state, st),
			"function annotations must be followed by a function declaration",
			["func"],
			Some("move the annotation onto a function declaration, or remove it"),
		)

	inner_step: ParseDeclStep = if current_is_keyword(state, st, FuncKeyword):
		parse_function_decl(
			state,
			st,
			st_diag,
			doc,
			is_pure,
			annotations_step.values,
			inner_start_span,
		)
	else if current_is_keyword(state, st, VarKeyword):
		parse_top_level_var_decl(state, st, st_diag, True, inner_start_span)
	else if current_is_keyword(state, st, RecordKeyword):
		parse_record_decl(state, st, st_diag, doc, RecordDeclarationSyntax, inner_start_span)
	else if current_is_keyword(state, st, StructKeyword):
		parse_record_decl(state, st, st_diag, doc, StructDeclarationSyntax, inner_start_span)
	else if current_is_keyword(state, st, UnionKeyword):
		parse_union_decl(state, st, st_diag, doc, False, inner_start_span)
	else if current_is_keyword(state, st, EnumKeyword):
		parse_union_decl(state, st, st_diag, doc, True, inner_start_span)
	else if current_is_keyword(state, st, TypeKeyword):
		if next_is_keyword(state, st, AliasKeyword):
			parse_type_alias_decl(state, st, st_diag, doc, False, inner_start_span)
		else:
			parse_builtin_type_decl(state, st, st_diag, doc, False, inner_start_span)
	else if current_is_keyword(state, st, OpaqueKeyword):
		parse_type_alias_decl(state, st, st_diag, doc, True, inner_start_span)
	else if current_is_keyword(state, st, ResourceKeyword):
		parse_builtin_type_decl(state, st, st_diag, doc, True, inner_start_span)
	else if current_is_keyword(state, st, TraitKeyword):
		parse_trait_decl(state, st, st_diag, doc, inner_start_span)
	else if current_is_keyword(state, st, ImplementsKeyword):
		parse_impl_decl(state, st, st_diag, doc, inner_start_span)
	else:
		match current_token_kind(state, st):
			IdentifierToken(_):
				parse_top_level_var_decl(state, st, st_diag, False, inner_start_span)
			KeywordToken(_):
				if current_reserved_keyword_starts_binding(state, st):
					parse_top_level_var_decl(state, st, st_diag, False, inner_start_span)
				else:
					parse_error_decl(state, st, st_diag)
			_:
				parse_error_decl(state, st, st_diag)

	{
		index = inner_step.index,
		diagnostics = inner_step.diagnostics,
		value = PrivateParsedDecl(
			inner_step.value,
			span_cover(start_span, parsed_decl_span(inner_step.value)),
		)
	}


private pure func parse_decl(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseDeclStep:
	var st: Int = skip_newlines(state, index)
	var st_diag: List[ParseDiagnostic] = diagnostics
	var doc: Option[String] = None
	var start_span: SourceSpan = current_span(state, st)

	match current_token_kind(state, st):
		DocStringToken(text):
			doc = Some(text)
			start_span = current_span(state, st)
			st = advance_parser(state, st)
			st = skip_newlines(state, st)
		_:
			void

	annotations_step: ParseFunctionAnnotationsStep = parse_function_annotations(
		state,
		st,
		st_diag,
		True,
	)

	if annotations_step.values.length() > 0 and doc.is_none():
		start_span = current_span(state, st)

	st = annotations_step.index
	st_diag = annotations_step.diagnostics

	var is_pure: Bool = False

	if current_is_keyword(state, st, PureKeyword):
		is_pure = True

		if doc.is_none() and annotations_step.values.length() == 0:
			start_span = current_span(state, st)

		st = advance_parser(state, st)

	if annotations_step.values.length() > 0 and not current_is_keyword(state, st, FuncKeyword):
		st_diag = add_expected_error(
			st_diag,
			current_span(state, st),
			"function annotations must be followed by a function declaration",
			["func"],
			Some("move the annotation onto a function declaration, or remove it"),
		)

	if current_is_keyword(state, st, PrivateKeyword):
		parse_private_decl(state, st, st_diag, doc, start_span)
	else if current_is_keyword(state, st, ImportKeyword):
		parse_import_block_decl(state, st, st_diag, start_span)
	else if current_is_keyword(state, st, ForeignKeyword):
		parse_foreign_block_decl(state, st, st_diag, start_span)
	else if current_is_keyword(state, st, FuncKeyword):
		parse_function_decl(state, st, st_diag, doc, is_pure, annotations_step.values, start_span)
	else if current_is_keyword(state, st, VarKeyword):
		parse_top_level_var_decl(state, st, st_diag, True, start_span)
	else if current_is_keyword(state, st, RecordKeyword):
		parse_record_decl(state, st, st_diag, doc, RecordDeclarationSyntax, start_span)
	else if current_is_keyword(state, st, StructKeyword):
		parse_record_decl(state, st, st_diag, doc, StructDeclarationSyntax, start_span)
	else if current_is_keyword(state, st, UnionKeyword):
		parse_union_decl(state, st, st_diag, doc, False, start_span)
	else if current_is_keyword(state, st, EnumKeyword):
		parse_union_decl(state, st, st_diag, doc, True, start_span)
	else if current_is_keyword(state, st, TypeKeyword):
		if next_is_keyword(state, st, AliasKeyword):
			parse_type_alias_decl(state, st, st_diag, doc, False, start_span)
		else:
			parse_builtin_type_decl(state, st, st_diag, doc, False, start_span)
	else if current_is_keyword(state, st, OpaqueKeyword):
		parse_type_alias_decl(state, st, st_diag, doc, True, start_span)
	else if current_is_keyword(state, st, ResourceKeyword):
		parse_builtin_type_decl(state, st, st_diag, doc, True, start_span)
	else if current_is_keyword(state, st, TraitKeyword):
		parse_trait_decl(state, st, st_diag, doc, start_span)
	else if current_is_keyword(state, st, ImplementsKeyword):
		parse_impl_decl(state, st, st_diag, doc, start_span)
	else:
		match current_token_kind(state, st):
			IdentifierToken(_):
				parse_top_level_var_decl(state, st, st_diag, False, start_span)
			KeywordToken(_):
				if current_reserved_keyword_starts_binding(state, st):
					parse_top_level_var_decl(state, st, st_diag, False, start_span)
				else:
					parse_error_decl(state, st, st_diag)
			_:
				parse_error_decl(state, st, st_diag)


private pure func parse_error_decl(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseDeclStep:
	error_span: SourceSpan = current_span(state, index)
	next_state: Int = index
	next_state_diag: List[ParseDiagnostic] = add_expected_error(
		diagnostics,
		error_span,
		"expected declaration",
		[EXPECTED_DECLARATION],
		Some("start a function declaration with `func`"),
	)

	recovery_state: Int = if current_is_eof(state, next_state):
		next_state
	else:
		advance_parser(state, next_state)

	{
		index = recovery_state,
		diagnostics = next_state_diag,
		value = ParsedErrorDecl(error_span)
	}


pure func parse_compiler_source(source: SourceFile) -> ParsedProgram:
	lex_result = lex(source)
	state: ParserInput = initial_state(source, lex_result.tokens)
	var index: Int = skip_newlines(state, 0)
	var diagnostics: List[ParseDiagnostic] = lex_result.diagnostics
	var decls: List[ParsedDecl] = []

	while not current_is_eof(state, index):
		before_index: Int = index
		decl_step: ParseDeclStep = parse_decl(state, index, diagnostics)
		decls = decls.append(decl_step.value)
		index = skip_newlines(state, decl_step.index)
		diagnostics = decl_step.diagnostics

		if index == before_index and not current_is_eof(state, index):
			index = advance_parser(state, index)

	{
		source = source,
		decls = decls,
		diagnostics = diagnostics
	}
