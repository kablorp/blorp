	diagnostics: List[ParseDiagnostic],
	value: ParsedTypeExpr
}


private record ParseTypeParamStep {
	index: Int,
	diagnostics: List[ParseDiagnostic],
	value: ParsedTypeParamDecl
}


private record ParseTypeParamListStep {
	index: Int,
	diagnostics: List[ParseDiagnostic],
	values: List[ParsedTypeParamDecl]
}


private record ParseOptionalTypeStep {
