-- `span` is a `TokenRange`, not yet materialized. Keeping diagnostics in a
-- separate result lets this hot success-path value stay inline; diagnostics
-- build a real `SourceLocation` only after failure, while delimiter consumers
-- materialize it only when the bound is part of an AST node.
private struct ParseSymbolStep {
	index: Int,
	matched: Bool,
	span: TokenRange
}


private enum TupleBinderIdentifierMode:
	TupleBinderNamesOnly
	TupleBinderNamesOrUnderscore


private enum AggregateDeclarationSyntax:
	RecordDeclarationSyntax
	StructDeclarationSyntax


private enum InfixOpTag:
	InfixOrOp
	InfixAndOp
	InfixEqualOp
	InfixNotEqualOp
	InfixLessOp
	InfixLessEqualOp
	InfixGreaterOp
	InfixGreaterEqualOp
	InfixRangeOp
	InfixAddOp
	InfixSubtractOp
	InfixMultiplyOp
	InfixDivideOp
	InfixModuloOp


private struct ParsedInfixInfo {
	precedence: Int,
	tag: InfixOpTag
}


-- Builds `ParserInput`'s column storage from the lexer's `List[Token]` in
-- one linear pass. Splitting into columns here (once, O(token count)) is
-- what lets every read during parsing -- there are several per token,
-- and the parser reads the same index more than once per decision -- be
-- a single scalar list index instead of copying a whole ten-field
-- struct out of an inline list only to read one of its fields.
private pure func initial_state(
	source: SourceFile,
	tokens: List[Token],
	texts: List[String],
	path: String,
	module_name: String,
	location_offset_delta: Int,
) -> ParserInput:
	capacity: Int = tokens.length()
	var tags: List[TokenTag] = list(capacity)
	var payloads: List[Int] = list(capacity)
	var start_offsets: List[Int] = list(capacity)
	var start_lines: List[Int] = list(capacity)
	var start_columns: List[Int] = list(capacity)
	var end_offsets: List[Int] = list(capacity)
	var end_lines: List[Int] = list(capacity)
	var end_columns: List[Int] = list(capacity)
	var trivia_starts: List[Int] = list(capacity)
	var trivia_counts: List[Int] = list(capacity)

	for token in tokens:
		tags = tags.append(token.kind)
		payloads = payloads.append(token.payload)
		start_offsets = start_offsets.append(token.start_offset)
		start_lines = start_lines.append(token.start_line)
		start_columns = start_columns.append(token.start_column)
		end_offsets = end_offsets.append(token.end_offset)
		end_lines = end_lines.append(token.end_line)
		end_columns = end_columns.append(token.end_column)
		trivia_starts = trivia_starts.append(token.trivia_start)
		trivia_counts = trivia_counts.append(token.trivia_count)

	{
		source = source,
		file_id = singleton_source_file_id(),
		location_offset_delta = location_offset_delta,
		tags = tags,
		payloads = payloads,
		start_offsets = start_offsets,
		start_lines = start_lines,
		start_columns = start_columns,
		end_offsets = end_offsets,
		end_lines = end_lines,
		end_columns = end_columns,
		trivia_starts = trivia_starts,
		trivia_counts = trivia_counts,
		texts = texts
	}


private pure func eof_location(state: ParserInput) -> SourceLocation:
	offset: Int = state.source.text.length() + state.location_offset_delta

	source_location_from_offsets(
		state.file_id,
		offset,
		offset,
	)


private pure func current_tag(state: ParserInput, index: Int) -> TokenTag:
	match state.tags.get(index):
		Some(tag):
			tag
		None:
			EndOfFileTag


private pure func tag_at(state: ParserInput, index: Int) -> TokenTag:
	current_tag(state, index)


private pure func current_payload(state: ParserInput, index: Int) -> Int:
	state.payloads.get_or(index, -1)


private pure func current_location(state: ParserInput, index: Int) -> SourceLocation:
	match state.start_offsets.get(index):
		Some(start_offset):
			source_location_from_offsets(
				state.file_id,
				start_offset + state.location_offset_delta,
				state.end_offsets.get_or(index, 0) + state.location_offset_delta,
			)
		None:
			eof_location(state)


-- A span not yet materialized: the `[first, last]` token indices it will
-- cover. Like the scalar `SourceLocation`, two `Int`s remain inline and avoid
-- heap allocation. Threading a `TokenRange` through the recursive descent
-- defers offset lookup and packing while spans are still being merged. Call
-- `materialize_location` exactly once, at the point a real `SourceLocation` is
-- required: building a `ParsedXxx` node's `span` field or a diagnostic.
private struct TokenRange {
	first: Int,
	last: Int
}


private pure func current_token_range(state: ParserInput, index: Int) -> TokenRange:
	{
		first = index,
		last = index
	}


private pure func token_range_cover(a: TokenRange, b: TokenRange) -> TokenRange:
	first: Int = if a.first < b.first:
		a.first
	else:
		b.first

	last: Int = if a.last > b.last:
		a.last
	else:
		b.last

	{
		first = first,
		last = last
	}


private pure func materialize_location(state: ParserInput, range: TokenRange) -> SourceLocation:
	start_offset: Int = state.start_offsets.get_or(range.first, 0)
	end_offset: Int = state.end_offsets.get_or(range.last, 0)

	source_location_from_offsets(
		state.file_id,
		start_offset + state.location_offset_delta,
		end_offset + state.location_offset_delta,
	)


private pure func parser_cursor_at_location_start(
	state: ParserInput,
	location: SourceLocation,
) -> Cursor:
	offset: Int = source_location_start_offset(location) - state.location_offset_delta
	var lower: Int = 0
	var upper: Int = state.start_offsets.length()

	while lower < upper:
		middle: Int = (lower + upper) / 2

		if state.start_offsets.get_or(middle, offset) < offset:
			lower = middle + 1
		else:
			upper = middle

	if (
		lower < state.start_offsets.length()
		and state.start_offsets.get_or(lower, -1) == offset
	):
		{
			offset = offset,
			line = state.start_lines.get_or(lower, 1),
			column = state.start_columns.get_or(lower, 1)
		}
	else:
		source_cursor_at(state.source, offset)


private pure func parser_cursor_at_location_end(
	state: ParserInput,
	location: SourceLocation,
) -> Cursor:
	offset: Int = source_location_end_offset(location) - state.location_offset_delta
	var lower: Int = 0
	var upper: Int = state.end_offsets.length()

	while lower < upper:
		middle: Int = (lower + upper) / 2

		if state.end_offsets.get_or(middle, offset) < offset:
			lower = middle + 1
		else:
			upper = middle

	if lower < state.end_offsets.length() and state.end_offsets.get_or(lower, -1) == offset:
		{
			offset = offset,
			line = state.end_lines.get_or(lower, 1),
			column = state.end_columns.get_or(lower, 1)
		}
	else:
		source_cursor_at(state.source, offset)


private pure func parser_location_span(
	state: ParserInput,
	location: SourceLocation,
) -> SourceSpan:
	-- Diagnostics are the cold path, so reconstruct from the authored offsets.
	-- This also avoids choosing among synthetic tokens that share one offset.
	source_span(
		state.source,
		source_cursor_at(
			state.source,
			source_location_start_offset(location) - state.location_offset_delta,
		),
		source_cursor_at(
			state.source,
			source_location_end_offset(location) - state.location_offset_delta,
		),
	)


-- Text for an identifier / int-literal / float-literal / docstring token:
-- an indexed read of the interned `texts` table (retains, does not
-- allocate). Callers only reach this from a match arm that already knows
-- `current_tag`/`tag_at` picked one of those tags.
private pure func current_text(state: ParserInput, index: Int) -> String:
	interned_text(
		state.texts,
		current_payload(state, index),
	)


private pure func current_keyword(state: ParserInput, index: Int) -> Keyword:
	keyword_from_ordinal(current_payload(state, index))


private pure func current_symbol(state: ParserInput, index: Int) -> Symbol:
	symbol_from_ordinal(current_payload(state, index))


private pure func current_string_literal_kind(state: ParserInput, index: Int) -> StringLiteralKind:
	unpacked_string_literal_kind(current_payload(state, index))


private pure func current_string_literal_text(state: ParserInput, index: Int) -> String:
	interned_text(state.texts, unpacked_string_literal_text_id(current_payload(state, index)))


private pure func current_char_code_point(state: ParserInput, index: Int) -> Int:
	current_payload(state, index)


private pure func location_cover(
	start_span: SourceLocation,
	end_span: SourceLocation,
) -> SourceLocation:
	source_location_cover(start_span, end_span)


private pure func add_expected_error(
	state: ParserInput,
	diagnostics: List[ParseDiagnostic],
	span: SourceLocation,
	message: String,
	expected: List[String],
	help: Option[String],
) -> List[ParseDiagnostic]:
	diagnostics.append(
		parse_error_expected(
			parser_location_span(state, span),
			message,
			expected,
			help,
		),
	)


private pure func current_is_eof(state: ParserInput, index: Int) -> Bool:
	match current_tag(state, index):
		EndOfFileTag:
			True
		_:
			False


private pure func advance_parser(state: ParserInput, index: Int) -> Int:
	if current_is_eof(state, index):
		index
	else:
		index + 1


private pure func current_is_newline(state: ParserInput, index: Int) -> Bool:
	match current_tag(state, index):
		NewlineTag:
			True
		_:
			False


private pure func current_is_indent(state: ParserInput, index: Int) -> Bool:
	match current_tag(state, index):
		IndentTag:
			True
		_:
			False


private pure func current_is_dedent(state: ParserInput, index: Int) -> Bool:
	match current_tag(state, index):
		DedentTag:
			True
		_:
			False


private pure func skip_newlines(state: ParserInput, index: Int) -> Int:
	var st: Int = index

	while current_is_newline(state, st):
		st = advance_parser(state, st)

	st


private pure func current_is_keyword(state: ParserInput, index: Int, expected: Keyword) -> Bool:
	match current_tag(state, index):
		KeywordTag:
			current_keyword(state, index) == expected
		_:
			False


private pure func next_is_keyword(state: ParserInput, index: Int, expected: Keyword) -> Bool:
	match tag_at(state, index + 1):
		KeywordTag:
			current_keyword(state, index + 1) == expected
		_:
			False


private pure func current_is_symbol(state: ParserInput, index: Int, expected: Symbol) -> Bool:
	match current_tag(state, index):
		SymbolTag:
			current_symbol(state, index) == expected
		_:
			False


---
Whether a token can name one element of a tuple destructuring target.

A reserved keyword counts as a binder name here so `(alias, rest) = pair`
reaches the binder parser and reports the reserved-keyword rule instead of
failing as a tuple expression.
---
private pure func token_is_tuple_binder_name_at(state: ParserInput, index: Int) -> Bool:
	match tag_at(state, index):
		IdentifierTag:
			True
		SymbolTag:
			current_symbol(state, index) == UnderscoreSymbol
		KeywordTag:
			keyword_is_reserved_name(current_keyword(state, index))
		_:
			False


private pure func parsed_function_annotation_from_name(
	name: String,
) -> Option[ParsedFunctionAnnotation]:
	match name:
		"tail_recursive":
			Some(ParsedTailRecursiveAnnotation)
		"no_copy":
			Some(ParsedNoCopyAnnotation)
		"debug_only":
			Some(ParsedDebugOnlyAnnotation)
		"resource_result_ordinary":
			Some(ParsedResourceResultOrdinaryAnnotation)
		_:
			None


private pure func add_unknown_function_annotation_error(
	state: ParserInput,
	diagnostics: List[ParseDiagnostic],
	span: SourceLocation,
	name: String,
) -> List[ParseDiagnostic]:
	add_expected_error(
		state,
		diagnostics,
		span,
		"unknown function annotation `@${name}`",
		["@tail_recursive", "@debug_only", "@no_copy", "@resource_result_ordinary"],
		Some("use one of the known function annotations, or remove the annotation"),
	)


private pure func consume_annotation_argument_list(
	state: ParserInput,
	index: Int,
) -> Int:
	var st: Int = index

	st = advance_parser(state, st)

	while (
		not current_is_eof(state, st)
		and not current_is_newline(state, st)
		and not current_is_symbol(state, st, RightParenSymbol)
	):
		st = advance_parser(state, st)

	if current_is_symbol(state, st, RightParenSymbol):
		advance_parser(state, st)
	else:
		st


private pure func parse_function_annotations(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	allow_newlines: Bool,
) -> ParseFunctionAnnotationsStep:
	var st: Int = index
	var st_diag: List[ParseDiagnostic] = diagnostics
	var values: List[ParsedFunctionAnnotation] = []

	while current_is_symbol(state, st, AtSymbol):
		st = advance_parser(state, st)
		name_step: ParseIdentifierStep = parse_identifier_expected(
			state,
			st,
			st_diag,
			EXPECTED_FUNCTION_ANNOTATION,
		)
		st = name_step.index
		st_diag = name_step.diagnostics

		match parsed_function_annotation_from_name(name_step.value.text):
			Some(annotation):
				values = values.append(annotation)
			None:
				st_diag = add_unknown_function_annotation_error(
					state,
					st_diag,
					name_step.value.span,
					name_step.value.text,
				)

		if current_is_symbol(state, st, LeftParenSymbol):
			st_diag = add_expected_error(
				state,
				st_diag,
				current_location(state, st),
				"function annotations do not take arguments",
				[],
				Some("remove the argument list from the function annotation"),
			)
			st = consume_annotation_argument_list(state, st)

		if allow_newlines and current_is_newline(state, st):
			st = skip_newlines(state, st)

	{
		index = st,
		diagnostics = st_diag,
		values = values
	}


private pure func current_is_soft_boundary(state: ParserInput, index: Int) -> Bool:
	if (
		current_is_eof(state, index)
		or current_is_newline(state, index)
		or current_is_dedent(state, index)
	):
		True
	else:
		match current_tag(state, index):
			SymbolTag:
				symbol: Symbol = current_symbol(state, index)

				(
					symbol == ColonSymbol
					or symbol == CommaSymbol
					or symbol == LeftParenSymbol
					or symbol == RightBracketSymbol
					or symbol == RightParenSymbol
				)
			_:
				False


private pure func expect_symbol(state: ParserInput, index: Int, symbol: Symbol) -> ParseSymbolStep:
	range: TokenRange = current_token_range(state, index)

	if current_is_symbol(state, index, symbol):
		{
			index = advance_parser(state, index),
			matched = True,
			span = range
		}
	else:
		{
			index = index,
			matched = False,
			span = range
		}


private pure func expect_symbol_diagnostics(
	state: ParserInput,
	diagnostics: List[ParseDiagnostic],
	step: ParseSymbolStep,
	symbol: Symbol,
	message: String,
) -> List[ParseDiagnostic]:
	if step.matched:
		diagnostics
	else:
		add_expected_error(
			state,
			diagnostics,
			materialize_location(state, step.span),
			message,
			[symbol_text(symbol)],
			None,
		)


private pure func expect_newline(state: ParserInput, index: Int) -> ParserStep:
	if current_is_newline(state, index):
		{
			index = advance_parser(state, index),
			matched = True
		}
	else:
		{
			index = index,
			matched = False
		}


private pure func expect_keyword(state: ParserInput, index: Int, keyword: Keyword) -> ParserStep:
	if current_is_keyword(state, index, keyword):
		{
			index = advance_parser(state, index),
			matched = True
		}
	else:
		{
			index = index,
			matched = False
		}


private pure func expect_newline_diagnostics(
	state: ParserInput,
	diagnostics: List[ParseDiagnostic],
	step: ParserStep,
	message: String,
) -> List[ParseDiagnostic]:
	if step.matched:
		diagnostics
	else:
		add_expected_error(
			state,
			diagnostics,
			current_location(state, step.index),
			message,
			["newline"],
			None,
		)


private pure func expect_keyword_diagnostics(
	state: ParserInput,
	diagnostics: List[ParseDiagnostic],
	step: ParserStep,
	expected: String,
	message: String,
) -> List[ParseDiagnostic]:
	if step.matched:
		diagnostics
	else:
		add_expected_error(
			state,
			diagnostics,
			current_location(state, step.index),
			message,
			[expected],
			None,
		)


private pure func current_is_block_end(state: ParserInput, index: Int) -> Bool:
	current_is_eof(state, index) or current_is_dedent(state, index)


private pure func type_keyword_identifier_text(state: ParserInput, index: Int) -> Option[String]:
	match current_tag(state, index):
		KeywordTag:
			match current_keyword(state, index):
				SelfKeyword:
					Some("Self")
				VoidKeyword:
					Some("void")
				_:
					None
		_:
			None


private pure func soft_keyword_identifier_text(keyword: Keyword) -> Option[String]:
	match keyword:
		DebugKeyword:
			Some("debug")
		WithKeyword:
			Some("with")
		ConcurrentKeyword:
			Some("concurrent")
		ConcurrentlyKeyword:
			Some("concurrently")
		SelectKeyword:
			Some("select")
		AfterKeyword:
			Some("after")
		SealedKeyword:
			Some("sealed")
		OnKeyword:
			Some("on")
		_:
			None


---
Whether a keyword is reserved in every name position: bindings, parameters,
patterns, fields, and declarations. Only keywords with a soft identifier
spelling may be used as names.
---
private pure func keyword_is_reserved_name(keyword: Keyword) -> Bool:
	soft_keyword_identifier_text(keyword).is_none()


---
The single diagnostic text for a reserved keyword written where a name belongs.
It names the keyword and suggests a replacement identifier.
---
private pure func reserved_keyword_name_message(keyword: Keyword) -> String:
	text: String = keyword_text(keyword)
	suggestion: String = "choose another identifier such as `${text}_name`"

	"`${text}` is a reserved keyword and cannot be used as a name; ${suggestion}"


---
One rule for every reserved keyword written where a name belongs.

The keyword is consumed as if it were the name so the rest of the binding,
parameter list, or match case still parses and no bare "expected expression"
cascade follows the reserved-keyword error.
---
private pure func parse_reserved_keyword_as_name(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	keyword: Keyword,
	span: SourceLocation,
) -> ParseIdentifierStep:
	next_state: Int = index
	next_state_diag: List[ParseDiagnostic] = add_expected_error(
		state,
		diagnostics,
		span,
		reserved_keyword_name_message(keyword),
		[],
		None,
	)

	{
		index = advance_parser(state, next_state),
		diagnostics = next_state_diag,
		value = parsed_identifier(keyword_text(keyword), span)
	}


private pure func parse_identifier_expected(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	expected: String,
) -> ParseIdentifierStep:
	span: SourceLocation = current_location(state, index)

	match current_tag(state, index):
		IdentifierTag:
			{
				index = advance_parser(state, index),
				diagnostics = diagnostics,
				value = parsed_identifier(
					current_text(state, index),
					span,
				)
			}
		KeywordTag:
			keyword: Keyword = current_keyword(state, index)

			match soft_keyword_identifier_text(keyword):
				Some(text):
					{
						index = advance_parser(state, index),
						diagnostics = diagnostics,
						value = parsed_identifier(text, span)
					}
				None:
					next_state: Int = index
					next_state_diag: List[ParseDiagnostic] = add_expected_error(
						state,
						diagnostics,
						span,
						"expected ${expected}",
						[expected],
						None,
					)

					recovery_state: Int = if current_is_soft_boundary(state, next_state):
						next_state
					else:
						advance_parser(state, next_state)

					{
						index = recovery_state,
						diagnostics = next_state_diag,
						value = parsed_identifier("", span)
					}
		_:
			next_state: Int = index
			next_state_diag: List[ParseDiagnostic] = add_expected_error(
				state,
				diagnostics,
				span,
				"expected ${expected}",
				[expected],
				None,
			)

			recovery_state: Int = if current_is_soft_boundary(state, next_state):
				next_state
			else:
				advance_parser(state, next_state)

			{
				index = recovery_state,
				diagnostics = next_state_diag,
				value = parsed_identifier("", span)
			}


---
Parse an identifier that introduces a new name: a binding, parameter, pattern,
field, or declaration name.

A reserved keyword here is reported as a misuse of that keyword. Reference
positions such as module paths, field access, and constructor names keep
`parse_identifier_expected`, because a keyword there usually means the
reference is missing rather than that the keyword was meant as a name.
---
private pure func parse_declared_name_expected(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	expected: String,
) -> ParseIdentifierStep:
	match current_tag(state, index):
		KeywordTag:
			keyword: Keyword = current_keyword(state, index)

			if keyword_is_reserved_name(keyword):
				parse_reserved_keyword_as_name(
					state,
					index,
					diagnostics,
					keyword,
					current_location(state, index),
				)
			else:
				parse_identifier_expected(state, index, diagnostics, expected)
		_:
			parse_identifier_expected(state, index, diagnostics, expected)


private pure func parse_type_identifier_expected(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	expected: String,
) -> ParseIdentifierStep:
	match current_tag(state, index):
		IdentifierTag:
			parse_identifier_expected(state, index, diagnostics, expected)
		_:
			match type_keyword_identifier_text(state, index):
				Some(text):
					{
						index = advance_parser(state, index),
						diagnostics = diagnostics,
						value = parsed_identifier(
							text,
							current_location(state, index),
						)
					}
				None:
					parse_identifier_expected(state, index, diagnostics, expected)


private pure func last_type_expr_location(
	items: List[ParsedTypeExpr],
	fallback: SourceLocation,
) -> SourceLocation:
	var span: SourceLocation = fallback

	for item in items:
		span = parsed_type_expr_location(item)

	span


private pure func last_dim_constraint_span(
	items: List[ParsedDimConstraint],
	fallback: SourceLocation,
) -> SourceLocation:
	var span: SourceLocation = fallback

	for item in items:
		span = item.span

	span


private pure func parsed_type_expr_is_dim(type_expr: ParsedTypeExpr) -> Bool:
	match type_expr:
		ParsedDimNameType(_, _, _):
			True
		ParsedDimLiteralType(_, _):
			True
		ParsedDimBinaryType(_, _, _, _):
			True
		_:
			False


private pure func parsed_type_exprs_all_dim(items: List[ParsedTypeExpr]) -> Bool:
	var all_dim: Bool = items.length() > 0

	for item in items:
		if not parsed_type_expr_is_dim(item):
			all_dim = False

	all_dim


private pure func last_identifier_span(
	items: List[ParsedIdentifier],
	fallback: SourceLocation,
) -> SourceLocation:
	var span: SourceLocation = fallback

	for item in items:
		span = item.span

	span


private pure func parse_plus_separated_identifier_list(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	expected: String,
) -> ParseIdentifierListStep:
	var st: Int = index
	var st_diag: List[ParseDiagnostic] = diagnostics
	var values: List[ParsedIdentifier] = []
	var parsing_values: Bool = True

	while parsing_values and not current_is_eof(state, st):
		name_step: ParseIdentifierStep = parse_identifier_expected(state, st, st_diag, expected)
		values = values.append(name_step.value)
		st = name_step.index
		st_diag = name_step.diagnostics

		if current_is_symbol(state, st, PlusSymbol):
			st = advance_parser(state, st)
		else:
			parsing_values = False

	{
		index = st,
		diagnostics = st_diag,
		values = values
	}


private pure func parse_hash_identifier_expected(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	expected: String,
) -> ParseIdentifierStep:
	start_span: SourceLocation = current_location(state, index)
	expect_step: ParseSymbolStep = expect_symbol(state, index, HashSymbol)
	expect_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
		state,
		diagnostics,
		expect_step,
		HashSymbol,
		"expected `#` before ${expected}",
	)
	st: Int = expect_step.index
	st_diag: List[ParseDiagnostic] = expect_step_diagnostics

	match current_tag(state, st):
		IdentifierTag:
			{
				index = advance_parser(state, st),
				diagnostics = st_diag,
				value = parsed_identifier(
					"#" + current_text(state, st),
					location_cover(
						start_span,
						current_location(state, st),
					),
				)
			}
		SymbolTag:
			if current_symbol(state, st) == UnderscoreSymbol:
				{
					index = advance_parser(state, st),
					diagnostics = st_diag,
					value = parsed_identifier(
						"#_",
						location_cover(
							start_span,
							current_location(state, st),
						),
					)
				}
			else:
				next_state: Int = st
				next_state_diag: List[ParseDiagnostic] = add_expected_error(
					state,
					st_diag,
					current_location(state, st),
					"expected ${expected}",
					[expected],
					None,
				)

				{
					index = next_state,
					diagnostics = next_state_diag,
					value = parsed_identifier("#", start_span)
				}
		_:
			next_state: Int = st
			next_state_diag: List[ParseDiagnostic] = add_expected_error(
				state,
				st_diag,
				current_location(state, st),
				"expected ${expected}",
				[expected],
				None,
			)

			{
				index = next_state,
				diagnostics = next_state_diag,
				value = parsed_identifier("#", start_span)
			}


private pure func parse_dim_hash_suffix(
	state: ParserInput,
	st_in: Int,
	start_span: SourceLocation,
	diagnostics: List[ParseDiagnostic],
) -> ParseTypeStep:
	match current_tag(state, st_in):
		IdentifierTag:
			var st: Int = st_in
			name: ParsedIdentifier = parsed_identifier(
				"#" + current_text(state, st),
				location_cover(
					start_span,
					current_location(state, st),
				),
			)
			st = advance_parser(state, st)
			var is_variadic: Bool = False
			var end_span: SourceLocation = name.span

			if current_is_symbol(state, st, DotDotDotSymbol):
				is_variadic = True
				end_span = current_location(state, st)
				st = advance_parser(state, st)

			{
				index = st,
				diagnostics = diagnostics,
				value = ParsedDimNameType(
					name,
					is_variadic,
					location_cover(start_span, end_span),
				)
			}
		IntLiteralTag:
			{
				index = advance_parser(state, st_in),
				diagnostics = diagnostics,
				value = ParsedDimLiteralType(
					current_text(state, st_in),
					location_cover(
						start_span,
						current_location(state, st_in),
					),
				)
			}
		SymbolTag:
			if current_symbol(state, st_in) == UnderscoreSymbol:
				var st: Int = st_in
				name: ParsedIdentifier = parsed_identifier(
					"#_",
					location_cover(
						start_span,
						current_location(state, st),
					),
				)
				st = advance_parser(state, st)
				var is_variadic: Bool = False
				var end_span: SourceLocation = name.span

				if current_is_symbol(state, st, DotDotDotSymbol):
					is_variadic = True
					end_span = current_location(state, st)
					st = advance_parser(state, st)

				{
					index = st,
					diagnostics = diagnostics,
					value = ParsedDimNameType(
						name,
						is_variadic,
						location_cover(start_span, end_span),
					)
				}
			else:
				next_state: Int = st_in
				next_state_diag: List[ParseDiagnostic] = add_expected_error(
					state,
					diagnostics,
					current_location(state, st_in),
					"expected dimension name or literal after `#`",
					["dimension"],
					None,
				)

				{
					index = next_state,
					diagnostics = next_state_diag,
					value = ParsedMissingType(start_span)
				}
		_:
			next_state: Int = st_in
			next_state_diag: List[ParseDiagnostic] = add_expected_error(
				state,
				diagnostics,
				current_location(state, st_in),
				"expected dimension name or literal after `#`",
				["dimension"],
				None,
			)

			{
				index = next_state,
				diagnostics = next_state_diag,
				value = ParsedMissingType(start_span)
			}


private pure func parse_dim_atom(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseTypeStep:
	match current_tag(state, index):
		SymbolTag:
			symbol: Symbol = current_symbol(state, index)

			if symbol == HashSymbol:
				parse_dim_hash_suffix(
					state,
					advance_parser(state, index),
					current_location(state, index),
					diagnostics,
				)
			else if symbol == LeftParenSymbol:
				dim_step: ParseTypeStep = parse_dim_expr(
					state,
					advance_parser(state, index),
					diagnostics,
				)
				right_step: ParseSymbolStep = expect_symbol(state, dim_step.index, RightParenSymbol)
				right_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
					state,
					dim_step.diagnostics,
					right_step,
					RightParenSymbol,
					"expected `)` after dimension expression",
				)

				{
					index = right_step.index,
					diagnostics = right_step_diagnostics,
					value = dim_step.value
				}
			else:
				next_state: Int = index
				next_state_diag: List[ParseDiagnostic] = add_expected_error(
					state,
					diagnostics,
					current_location(state, index),
					"expected dimension expression",
					["dimension"],
					None,
				)

				{
					index = next_state,
					diagnostics = next_state_diag,
					value = ParsedMissingType(current_location(state, index))
				}
		IntLiteralTag:
			{
				index = advance_parser(state, index),
				diagnostics = diagnostics,
				value = ParsedDimLiteralType(
					current_text(state, index),
					current_location(state, index),
				)
			}
		_:
			next_state: Int = index
			next_state_diag: List[ParseDiagnostic] = add_expected_error(
				state,
				diagnostics,
				current_location(state, index),
				"expected dimension expression",
				["dimension"],
				None,
			)

			{
				index = next_state,
				diagnostics = next_state_diag,
				value = ParsedMissingType(current_location(state, index))
			}


private pure func parse_dim_multiply(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseTypeStep:
	left_step: ParseTypeStep = parse_dim_atom(state, index, diagnostics)
	var st: Int = left_step.index
	var st_diag: List[ParseDiagnostic] = left_step.diagnostics
	var left: ParsedTypeExpr = left_step.value

	while current_is_symbol(state, st, StarSymbol) or current_is_symbol(state, st, SlashSymbol):
		op: ParsedDimBinaryOp = if current_is_symbol(state, st, StarSymbol):
			ParsedDimMultiplyOp
		else:
			ParsedDimDivideOp

		st = advance_parser(state, st)
		right_step: ParseTypeStep = parse_dim_atom(state, st, st_diag)
		left = ParsedDimBinaryType(
			op,
			left,
			right_step.value,
			location_cover(
				parsed_type_expr_location(left),
				parsed_type_expr_location(right_step.value),
			),
		)
		st = right_step.index
		st_diag = right_step.diagnostics

	{
		index = st,
		diagnostics = st_diag,
		value = left
	}


private pure func parse_dim_expr(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseTypeStep:
	left_step: ParseTypeStep = parse_dim_multiply(state, index, diagnostics)
	var st: Int = left_step.index
	var st_diag: List[ParseDiagnostic] = left_step.diagnostics
	var left: ParsedTypeExpr = left_step.value

	while current_is_symbol(state, st, PlusSymbol) or current_is_symbol(state, st, MinusSymbol):
		op: ParsedDimBinaryOp = if current_is_symbol(state, st, PlusSymbol):
			ParsedDimAddOp
		else:
			ParsedDimSubtractOp

		st = advance_parser(state, st)
		right_step: ParseTypeStep = parse_dim_multiply(state, st, st_diag)
		left = ParsedDimBinaryType(
			op,
			left,
			right_step.value,
			location_cover(
				parsed_type_expr_location(left),
				parsed_type_expr_location(right_step.value),
			),
		)
		st = right_step.index
		st_diag = right_step.diagnostics

	{
		index = st,
		diagnostics = st_diag,
		value = left
	}


private pure func parse_dim_constraint(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseDimConstraintStep:
	left_step: ParseTypeStep = parse_dim_expr(state, index, diagnostics)
	equal_step: ParseSymbolStep = expect_symbol(state, left_step.index, EqualEqualSymbol)
	equal_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
		state,
		left_step.diagnostics,
		equal_step,
		EqualEqualSymbol,
		"expected `==` in dimension constraint",
	)
	right_step: ParseTypeStep = parse_dim_expr(state, equal_step.index, equal_step_diagnostics)

	{
		index = right_step.index,
		diagnostics = right_step.diagnostics,
		value = {
			left = left_step.value,
			right = right_step.value,
			span = location_cover(
				parsed_type_expr_location(left_step.value),
				parsed_type_expr_location(right_step.value),
			)
		}
	}


private pure func parse_dim_constraints_opt(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseDimConstraintListStep:
	var st: Int = index
	var st_diag: List[ParseDiagnostic] = diagnostics
	var values: List[ParsedDimConstraint] = []

	if current_is_keyword(state, st, WhereKeyword):
		st = advance_parser(state, st)
		var parsing_constraints: Bool = True

		while parsing_constraints and not current_is_eof(state, st):
			constraint_step: ParseDimConstraintStep = parse_dim_constraint(state, st, st_diag)
			values = values.append(constraint_step.value)
			st = constraint_step.index
			st_diag = constraint_step.diagnostics

			if current_is_symbol(state, st, CommaSymbol):
				st = advance_parser(state, st)
			else:
				parsing_constraints = False

	{
		index = st,
		diagnostics = st_diag,
		values = values
	}


private pure func parse_type_array_suffixes(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	base: ParsedTypeExpr,
) -> ParseTypeStep:
	var st: Int = index
	var st_diag: List[ParseDiagnostic] = diagnostics
	var value: ParsedTypeExpr = base

	while current_is_symbol(state, st, LeftBracketSymbol):
		dims_step: ParseTypeListStep = parse_type_expr_list_until(
			state,
			advance_parser(state, st),
			st_diag,
			RightBracketSymbol,
			False,
		)
		right_step: ParseSymbolStep = expect_symbol(state, dims_step.index, RightBracketSymbol)
		right_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
			state,
			dims_step.diagnostics,
			right_step,
			RightBracketSymbol,
			"expected `]` after array dimensions",
		)
		st = right_step.index
		st_diag = right_step_diagnostics

		if not parsed_type_exprs_all_dim(dims_step.values):
			st_diag = add_expected_error(
				state,
				st_diag,
				last_type_expr_location(dims_step.values, parsed_type_expr_location(value)),
				"expected array dimensions",
				["dimension"],
				Some("generic type arguments belong on the named type before array dimensions"),
			)

		end_span: SourceLocation = if right_step.matched:
			materialize_location(state, right_step.span)
		else:
			last_type_expr_location(dims_step.values, parsed_type_expr_location(value))

		value = ParsedArrayType(
			value,
			dims_step.values,
			location_cover(parsed_type_expr_location(value), end_span),
		)

	{
		index = st,
		diagnostics = st_diag,
		value = value
	}


private pure func parse_named_type_expr_with_bounds(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	allow_bounds: Bool,
) -> ParseTypeStep:
	can_qualify: Bool = match current_tag(state, index):
		IdentifierTag:
			True
		_:
			False

	first_name_step: ParseIdentifierStep = parse_type_identifier_expected(
		state,
		index,
		diagnostics,
		EXPECTED_TYPE,
	)
	var type_name: ParsedIdentifier = first_name_step.value
	var qualifier: Option[ParsedIdentifier] = None
	var st: Int = first_name_step.index
	var st_diag: List[ParseDiagnostic] = first_name_step.diagnostics
	var args: List[ParsedTypeExpr] = []
	var end_span: SourceLocation = first_name_step.value.span

	if allow_bounds and current_is_symbol(state, st, ColonSymbol):
		bounds_step: ParseIdentifierListStep = parse_plus_separated_identifier_list(
			state,
			advance_parser(state, st),
			st_diag,
			"trait bound",
		)

		{
			index = bounds_step.index,
			diagnostics = bounds_step.diagnostics,
			value = ParsedBoundedType(
				type_name,
				bounds_step.values,
				location_cover(
					type_name.span,
					last_identifier_span(bounds_step.values, type_name.span),
				),
			)
		}
	else:
		if can_qualify and current_is_symbol(state, st, DotSymbol):
			qualified_name_step: ParseIdentifierStep = parse_identifier_expected(
				state,
				advance_parser(state, st),
				st_diag,
				EXPECTED_TYPE,
			)
			qualifier = Some(first_name_step.value)
			type_name = qualified_name_step.value
			st = qualified_name_step.index
			st_diag = qualified_name_step.diagnostics
			end_span = type_name.span

		if current_is_symbol(state, st, LeftBracketSymbol):
			args_step: ParseTypeListStep = parse_type_expr_list_until(
				state,
				advance_parser(state, st),
				st_diag,
				RightBracketSymbol,
				True,
			)
			right_step: ParseSymbolStep = expect_symbol(state, args_step.index, RightBracketSymbol)
			right_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
				state,
				args_step.diagnostics,
				right_step,
				RightBracketSymbol,
				"expected `]` after type arguments",
			)
			st = right_step.index
			st_diag = right_step_diagnostics
			args = args_step.values
			end_span = last_type_expr_location(args, end_span)

			if right_step.matched:
				end_span = materialize_location(state, right_step.span)

		base_type: ParsedTypeExpr = match qualifier:
			Some(module_name):
				ParsedQualifiedNamedType(
					module_name,
					type_name,
					[],
					location_cover(module_name.span, type_name.span),
				)
			None:
				ParsedNamedType(type_name, [], type_name.span)

		if parsed_type_exprs_all_dim(args):
			array_type: ParsedTypeExpr = ParsedArrayType(
				base_type,
				args,
				location_cover(parsed_type_expr_location(base_type), end_span),
			)
			parse_type_array_suffixes(state, st, st_diag, array_type)
		else:
			named_type: ParsedTypeExpr = match qualifier:
				Some(module_name):
					ParsedQualifiedNamedType(
						module_name,
						type_name,
						args,
						location_cover(module_name.span, end_span),
					)
				None:
					ParsedNamedType(
						type_name,
						args,
						location_cover(type_name.span, end_span),
					)

			parse_type_array_suffixes(state, st, st_diag, named_type)


private pure func parse_parenthesized_type_expr(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseTypeStep:
	start_span: SourceLocation = current_location(state, index)
	var st: Int = advance_parser(state, index)
	var st_diag: List[ParseDiagnostic] = diagnostics

	if current_is_symbol(state, st, RightParenSymbol):
		right_step: ParseSymbolStep = expect_symbol(state, st, RightParenSymbol)
		right_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
			state,
			st_diag,
			right_step,
			RightParenSymbol,
			"expected `)` after type",
		)
		st = right_step.index
		st_diag = right_step_diagnostics
		void_type: ParsedTypeExpr = ParsedNamedType(
			parsed_identifier(
				"Void",
				location_cover(
					start_span,
					materialize_location(state, right_step.span),
				),
			),
			[],
			location_cover(
				start_span,
				materialize_location(state, right_step.span),
			),
		)

		if current_is_symbol(state, st, ArrowSymbol):
			return_step: ParseTypeStep = parse_type_expr(
				state,
				advance_parser(state, st),
				st_diag,
			)

			{
				index = return_step.index,
				diagnostics = return_step.diagnostics,
				value = ParsedFunctionType(
					False,
					[],
					return_step.value,
					location_cover(start_span, parsed_type_expr_location(return_step.value)),
				)
			}
		else:
			parse_type_array_suffixes(state, st, st_diag, void_type)
	else:
		items_step: ParseTypeListStep = parse_type_expr_list_until(
			state,
			st,
			st_diag,
			RightParenSymbol,
			False,
		)
		right_step: ParseSymbolStep = expect_symbol(state, items_step.index, RightParenSymbol)
		right_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
			state,
			items_step.diagnostics,
			right_step,
			RightParenSymbol,
			"expected `)` after type",
		)
		st = right_step.index
		st_diag = right_step_diagnostics

		if current_is_symbol(state, st, ArrowSymbol):
			return_step: ParseTypeStep = parse_type_expr(
				state,
				advance_parser(state, st),
				st_diag,
			)

			{
				index = return_step.index,
				diagnostics = return_step.diagnostics,
				value = ParsedFunctionType(
					False,
					items_step.values,
					return_step.value,
					location_cover(start_span, parsed_type_expr_location(return_step.value)),
				)
			}
		else:
			if items_step.values.length() > 4:
				st_diag = add_tuple_arity_error(
					state,
					st_diag,
					location_cover(
						start_span,
						materialize_location(state, right_step.span),
					),
				)

			base_type: ParsedTypeExpr = if items_step.values.length() == 1:
				match items_step.values.get(0):
					Some(item):
						item
					None:
						ParsedMissingType(start_span)
			else:
				ParsedTupleType(
					items_step.values,
					location_cover(
						start_span,
						materialize_location(state, right_step.span),
					),
				)

			parse_type_array_suffixes(state, st, st_diag, base_type)


private pure func parse_pure_function_type_expr(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseTypeStep:
	start_span: SourceLocation = current_location(state, index)
	var st: Int = advance_parser(state, index)
	var st_diag: List[ParseDiagnostic] = diagnostics
	left_step: ParseSymbolStep = expect_symbol(state, st, LeftParenSymbol)
	left_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
		state,
		st_diag,
		left_step,
		LeftParenSymbol,
		"expected `(` after `pure` in function type",
	)
	st = left_step.index
	st_diag = left_step_diagnostics
	params_step: ParseTypeListStep = parse_type_expr_list_until(
		state,
		st,
		st_diag,
		RightParenSymbol,
		True,
	)
	right_step: ParseSymbolStep = expect_symbol(state, params_step.index, RightParenSymbol)
	right_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
		state,
		params_step.diagnostics,
		right_step,
		RightParenSymbol,
		"expected `)` after function type parameters",
	)
	st = right_step.index
	st_diag = right_step_diagnostics
	arrow_step: ParseSymbolStep = expect_symbol(state, st, ArrowSymbol)
	arrow_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
		state,
		st_diag,
		arrow_step,
		ArrowSymbol,
		"expected `->` after function type parameters",
	)
	return_step: ParseTypeStep = parse_type_expr(state, arrow_step.index, arrow_step_diagnostics)

	{
		index = return_step.index,
		diagnostics = return_step.diagnostics,
		value = ParsedFunctionType(
			True,
			params_step.values,
			return_step.value,
			location_cover(start_span, parsed_type_expr_location(return_step.value)),
		)
	}


private pure func parse_range_type_expr(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseTypeStep:
	start_span: SourceLocation = current_location(state, index)
	var st: Int = advance_parser(state, index)
	var st_diag: List[ParseDiagnostic] = diagnostics

	if (
		not current_is_symbol(state, st, HashSymbol)
		and not current_is_symbol(state, st, LeftParenSymbol)
	):
		st_diag = add_expected_error(
			state,
			st_diag,
			current_location(state, st),
			"expected `#` dimension after `..`",
			["# dimension"],
			None,
		)

	dim_step: ParseTypeStep = parse_dim_expr(state, st, st_diag)

	{
		index = dim_step.index,
		diagnostics = dim_step.diagnostics,
		value = ParsedRangeType(
			dim_step.value,
			location_cover(start_span, parsed_type_expr_location(dim_step.value)),
		)
	}


private pure func token_index_starts_dim_atom(state: ParserInput, index: Int) -> Bool:
	match tag_at(state, index):
		SymbolTag:
			symbol: Symbol = current_symbol(state, index)

			if symbol == HashSymbol:
				True
			else if symbol == LeftParenSymbol:
				token_index_starts_dim_atom(state, index + 1)
			else:
				False
		IntLiteralTag:
			True
		_:
			False


private pure func starts_parenthesized_dim_expr(state: ParserInput, index: Int) -> Bool:
	(
		current_is_symbol(state, index, LeftParenSymbol)
		and token_index_starts_dim_atom(state, index + 1)
	)


private pure func parse_type_expr_missing(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseTypeStep:
	next_state_diag: List[ParseDiagnostic] = add_expected_error(
		state,
		diagnostics,
		current_location(state, index),
		"expected type",
		[EXPECTED_TYPE],
		None,
	)

	recovery_state: Int = if current_is_soft_boundary(state, index):
		index
	else:
		advance_parser(state, index)

	{
		index = recovery_state,
		diagnostics = next_state_diag,
		value = ParsedMissingType(current_location(state, index))
	}


private pure func parse_type_expr_allow_bounds(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	allow_bounds: Bool,
) -> ParseTypeStep:
	match current_tag(state, index):
		IdentifierTag:
			parse_named_type_expr_with_bounds(state, index, diagnostics, allow_bounds)
		KeywordTag:
			keyword: Keyword = current_keyword(state, index)

			if keyword == SelfKeyword or keyword == VoidKeyword:
				parse_named_type_expr_with_bounds(state, index, diagnostics, allow_bounds)
			else if keyword == PureKeyword:
				parse_pure_function_type_expr(state, index, diagnostics)
			else:
				parse_type_expr_missing(state, index, diagnostics)
		SymbolTag:
			symbol: Symbol = current_symbol(state, index)

			if symbol == HashSymbol:
				parse_dim_expr(state, index, diagnostics)
			else if symbol == DotDotSymbol:
				parse_range_type_expr(state, index, diagnostics)
			else if symbol == LeftParenSymbol:
				if starts_parenthesized_dim_expr(state, index):
					parse_dim_expr(state, index, diagnostics)
				else:
					parse_parenthesized_type_expr(state, index, diagnostics)
			else:
				parse_type_expr_missing(state, index, diagnostics)
		IntLiteralTag:
			parse_dim_expr(state, index, diagnostics)
		_:
			parse_type_expr_missing(state, index, diagnostics)


private pure func parse_type_expr(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseTypeStep:
	parse_type_expr_allow_bounds(state, index, diagnostics, False)


private pure func param_location_from_start(
	start_span: SourceLocation,
	type_expr: Option[ParsedTypeExpr],
) -> SourceLocation:
	end_span: SourceLocation = match type_expr:
		Some(ty):
			parsed_type_expr_location(ty)
		None:
			start_span

	location_cover(start_span, end_span)


private pure func param_span(
	binder: ParsedParamBinder,
	type_expr: Option[ParsedTypeExpr],
) -> SourceLocation:
	param_location_from_start(parsed_param_binder_location(binder), type_expr)


private pure func parse_tuple_param(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseParamStep:
	start_span: SourceLocation = current_location(state, index)
	binder_step: ParseTupleBinderStep = parse_tuple_binder_after_left_paren(
		state,
		advance_parser(state, index),
		diagnostics,
		start_span,
		TupleBinderNamesOnly,
		"tuple parameter name",
		"expected `, ` between tuple parameter names",
		"expected tuple parameter name after `, `",
		"expected `)` after tuple parameter names",
	)
	type_step: ParseOptionalTypeStep = parse_optional_type_annotation(
		state,
		binder_step.index,
		binder_step.diagnostics,
	)
	binder: ParsedParamBinder = ParsedParamTupleBinder(binder_step.values, binder_step.span)

	{
		index = type_step.index,
		diagnostics = type_step.diagnostics,
		value = {
			binder = binder,
			type_expr = type_step.value,
			span = param_span(binder, type_step.value)
		}
	}


private pure func parse_named_or_wildcard_param(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseParamStep:
	is_underscore: Bool = match current_tag(state, index):
		SymbolTag:
			current_symbol(state, index) == UnderscoreSymbol
		_:
			False

	if is_underscore:
		span: SourceLocation = current_location(state, index)
		underscore: ParsedIdentifier = parsed_identifier("_", span)
		type_step: ParseOptionalTypeStep = parse_optional_type_annotation(
			state,
			advance_parser(state, index),
			diagnostics,
		)

		binder: ParsedParamBinder = match type_step.value:
			Some(_):
				ParsedParamNameBinder(underscore)
			None:
				ParsedParamWildcardBinder(span)

		{
			index = type_step.index,
			diagnostics = type_step.diagnostics,
			value = {
				binder = binder,
				type_expr = type_step.value,
				span = param_span(binder, type_step.value)
			}
		}
	else:
		name_step: ParseIdentifierStep = parse_declared_name_expected(
			state,
			index,
			diagnostics,
			EXPECTED_PARAMETER_NAME,
		)
		type_step: ParseOptionalTypeStep = parse_optional_type_annotation(
			state,
			name_step.index,
			name_step.diagnostics,
		)
		binder: ParsedParamBinder = ParsedParamNameBinder(name_step.value)

		{
			index = type_step.index,
			diagnostics = type_step.diagnostics,
			value = {
				binder = binder,
				type_expr = type_step.value,
				span = param_span(binder, type_step.value)
			}
		}


private pure func parse_param(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseParamStep:
	if current_is_symbol(state, index, LeftParenSymbol):
		parse_tuple_param(state, index, diagnostics)
	else:
		parse_named_or_wildcard_param(state, index, diagnostics)


private pure func parse_params_after_left_paren(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseParamsStep:
	var st: Int = skip_newlines(state, index)
	var st_diag: List[ParseDiagnostic] = diagnostics
	var opened_indent: Bool = False
	var params: List[ParsedParam] = []

	if current_is_indent(state, st):
		opened_indent = True
		st = advance_parser(state, st)
		st = skip_newlines(state, st)

	if not current_is_symbol(state, st, RightParenSymbol):
		var parsing_params: Bool = True

		while parsing_params and not current_is_eof(state, st):
			param_step: ParseParamStep = parse_param(state, st, st_diag)
			params = params.append(param_step.value)
			st = param_step.index
			st_diag = param_step.diagnostics

			if current_is_symbol(state, st, CommaSymbol):
				st = advance_parser(state, st)
				st = skip_newlines(state, st)

				if opened_indent and current_is_dedent(state, st):
					st = advance_parser(state, st)
					st = skip_newlines(state, st)

				if current_is_symbol(state, st, RightParenSymbol):
					parsing_params = False
			else:
				parsing_params = False

	st = skip_newlines(state, st)

	if opened_indent and current_is_dedent(state, st):
		st = advance_parser(state, st)
		st = skip_newlines(state, st)

	right_step: ParseSymbolStep = expect_symbol(state, st, RightParenSymbol)
	right_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
		state,
		st_diag,
		right_step,
		RightParenSymbol,
		"expected `)` after function parameters",
	)

	{
		index = right_step.index,
		diagnostics = right_step_diagnostics,
		values = params
	}


private pure func parse_lambda_param(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseLambdaParamStep:
	name_step: ParseIdentifierStep = parse_binder_identifier_expected(
		state,
		index,
		diagnostics,
		"lambda parameter",
	)
	type_step: ParseOptionalTypeStep = parse_optional_type_annotation(
		state,
		name_step.index,
		name_step.diagnostics,
	)

	{
		index = type_step.index,
		diagnostics = type_step.diagnostics,
		value = {
			name = name_step.value,
			type_expr = type_step.value,
			span = param_location_from_start(name_step.value.span, type_step.value)
		}
	}


private pure func parse_lambda_params_after_left_paren(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseLambdaParamsStep:
	var st: Int = skip_newlines(state, index)
	var st_diag: List[ParseDiagnostic] = diagnostics
	var opened_indent: Bool = False
	var params: List[ParsedLambdaParam] = []

	if current_is_indent(state, st):
		opened_indent = True
		st = advance_parser(state, st)
		st = skip_newlines(state, st)

	if not current_is_symbol(state, st, RightParenSymbol):
		var parsing_params: Bool = True

		while parsing_params and not current_is_eof(state, st):
			param_step: ParseLambdaParamStep = parse_lambda_param(state, st, st_diag)
			params = params.append(param_step.value)
			st = param_step.index
			st_diag = param_step.diagnostics

			if current_is_symbol(state, st, CommaSymbol):
				st = advance_parser(state, st)
				st = skip_newlines(state, st)

				if opened_indent and current_is_dedent(state, st):
					st = advance_parser(state, st)
					st = skip_newlines(state, st)

				if current_is_symbol(state, st, RightParenSymbol):
					parsing_params = False
			else:
				parsing_params = False

	st = skip_newlines(state, st)

	if opened_indent and current_is_dedent(state, st):
		st = advance_parser(state, st)
		st = skip_newlines(state, st)

	right_step: ParseSymbolStep = expect_symbol(state, st, RightParenSymbol)
	right_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
		state,
		st_diag,
		right_step,
		RightParenSymbol,
		"expected `)` after lambda parameters",
	)

	{
		index = right_step.index,
		diagnostics = right_step_diagnostics,
		values = params
	}


private pure func parse_identifier_list_until(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	end_symbol: Symbol,
	allow_empty: Bool,
	expected: String,
) -> ParseIdentifierListStep:
	var st: Int = index
	var st_diag: List[ParseDiagnostic] = diagnostics
	var values: List[ParsedIdentifier] = []

	if allow_empty and current_is_symbol(state, st, end_symbol):
		{
			index = st,
			diagnostics = st_diag,
			values = values
		}
	else:
		var parsing_values: Bool = True

		while parsing_values and not current_is_eof(state, st):
			item_step: ParseIdentifierStep = parse_identifier_expected(state, st, st_diag, expected)
			values = values.append(item_step.value)
			st = item_step.index
			st_diag = item_step.diagnostics

			if current_is_symbol(state, st, CommaSymbol):
				st = advance_parser(state, st)

				if current_is_symbol(state, st, end_symbol):
					parsing_values = False
			else:
				parsing_values = False

		{
			index = st,
			diagnostics = st_diag,
			values = values
		}


private pure func parse_type_expr_list_until(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	end_symbol: Symbol,
	allow_empty: Bool,
) -> ParseTypeListStep:
	var st: Int = index
	var st_diag: List[ParseDiagnostic] = diagnostics
	var values: List[ParsedTypeExpr] = []

	if allow_empty and current_is_symbol(state, st, end_symbol):
		{
			index = st,
			diagnostics = st_diag,
			values = values
		}
	else:
		var parsing_values: Bool = True

		while parsing_values and not current_is_eof(state, st):
			type_step: ParseTypeStep = parse_type_expr_allow_bounds(state, st, st_diag, True)
			values = values.append(type_step.value)
			st = type_step.index
			st_diag = type_step.diagnostics

			if current_is_symbol(state, st, CommaSymbol):
				st = advance_parser(state, st)

				if current_is_symbol(state, st, end_symbol):
					parsing_values = False
			else:
				parsing_values = False

		{
			index = st,
			diagnostics = st_diag,
			values = values
		}


private pure func parse_type_param_decl(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseTypeParamStep:
	name_step: ParseIdentifierStep = if current_is_symbol(state, index, HashSymbol):
		parse_hash_identifier_expected(state, index, diagnostics, "dimension parameter")
	else:
		parse_declared_name_expected(state, index, diagnostics, "type parameter")

	var st: Int = name_step.index
	var st_diag: List[ParseDiagnostic] = name_step.diagnostics
	var bounds: List[ParsedIdentifier] = []
	var end_span: SourceLocation = name_step.value.span

	if current_is_symbol(state, st, ColonSymbol):
		bounds_step: ParseIdentifierListStep = parse_plus_separated_identifier_list(
			state,
			advance_parser(state, st),
			st_diag,
			"trait bound",
		)
		bounds = bounds_step.values
		st = bounds_step.index
		st_diag = bounds_step.diagnostics
		end_span = last_identifier_span(bounds, end_span)

	{
		index = st,
		diagnostics = st_diag,
		value = {
			name = name_step.value,
			bounds = bounds,
			span = location_cover(name_step.value.span, end_span)
		}
	}


private pure func parse_type_param_list_until(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	end_symbol: Symbol,
	allow_empty: Bool,
) -> ParseTypeParamListStep:
	var st: Int = index
	var st_diag: List[ParseDiagnostic] = diagnostics
	var values: List[ParsedTypeParamDecl] = []

	if allow_empty and current_is_symbol(state, st, end_symbol):
		{
			index = st,
			diagnostics = st_diag,
			values = values
		}
	else:
		var parsing_values: Bool = True

		while parsing_values and not current_is_eof(state, st):
			item_step: ParseTypeParamStep = parse_type_param_decl(state, st, st_diag)
			values = values.append(item_step.value)
			st = item_step.index
			st_diag = item_step.diagnostics

			if current_is_symbol(state, st, CommaSymbol):
				st = advance_parser(state, st)

				if current_is_symbol(state, st, end_symbol):
					parsing_values = False
			else:
				parsing_values = False

		{
			index = st,
			diagnostics = st_diag,
			values = values
		}


private pure func parse_type_params_opt(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseTypeParamListStep:
	if current_is_symbol(state, index, LeftBracketSymbol):
		items_step: ParseTypeParamListStep = parse_type_param_list_until(
			state,
			advance_parser(state, index),
			diagnostics,
			RightBracketSymbol,
			True,
		)
		right_step: ParseSymbolStep = expect_symbol(state, items_step.index, RightBracketSymbol)
		right_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
			state,
			items_step.diagnostics,
			right_step,
			RightBracketSymbol,
			"expected `]` after type parameters",
		)

		{
			index = right_step.index,
			diagnostics = right_step_diagnostics,
			values = items_step.values
		}
	else:
		{
			index = index,
			diagnostics = diagnostics,
			values = []
		}


private pure func parse_binder_identifier_expected(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	expected: String,
) -> ParseIdentifierStep:
	span: SourceLocation = current_location(state, index)

	match current_tag(state, index):
		IdentifierTag:
			{
				index = advance_parser(state, index),
				diagnostics = diagnostics,
				value = parsed_identifier(
					current_text(state, index),
					span,
				)
			}
		SymbolTag:
			if current_symbol(state, index) == UnderscoreSymbol:
				{
					index = advance_parser(state, index),
					diagnostics = diagnostics,
					value = parsed_identifier("_", span)
				}
			else:
				parse_declared_name_expected(state, index, diagnostics, expected)
		_:
			parse_declared_name_expected(state, index, diagnostics, expected)


private pure func parse_select_receive_identifier_expected(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	expected: String,
) -> ParseIdentifierStep:
	span: SourceLocation = current_location(state, index)

	match current_tag(state, index):
		IdentifierTag:
			{
				index = advance_parser(state, index),
				diagnostics = diagnostics,
				value = parsed_identifier(
					current_text(state, index),
					span,
				)
			}
		SymbolTag:
			if current_symbol(state, index) == UnderscoreSymbol:
				{
					index = advance_parser(state, index),
					diagnostics = diagnostics,
					value = parsed_identifier("_", span)
				}
			else:
				parse_declared_name_expected(state, index, diagnostics, expected)
		KeywordTag:
			keyword: Keyword = current_keyword(state, index)

			if keyword == AfterKeyword:
				{
					index = advance_parser(state, index),
					diagnostics = diagnostics,
					value = parsed_identifier("after", span)
				}
			else if keyword == FromKeyword:
				{
					index = advance_parser(state, index),
					diagnostics = diagnostics,
					value = parsed_identifier("from", span)
				}
			else:
				parse_declared_name_expected(state, index, diagnostics, expected)
		_:
			parse_declared_name_expected(state, index, diagnostics, expected)


private pure func current_infix_info(state: ParserInput, index: Int) -> Option[ParsedInfixInfo]:
	match current_tag(state, index):
		KeywordTag:
			match current_keyword(state, index):
				OrKeyword:
					Some({
						precedence = PREC_OR,
						tag = InfixOrOp,
					})
				AndKeyword:
					Some({
						precedence = PREC_AND,
						tag = InfixAndOp,
					})
				_:
					None
		SymbolTag:
			match current_symbol(state, index):
				EqualEqualSymbol:
					Some({
						precedence = PREC_COMPARE,
						tag = InfixEqualOp,
					})
				NotEqualSymbol:
					Some({
						precedence = PREC_COMPARE,
						tag = InfixNotEqualOp,
					})
				LessSymbol:
					Some({
						precedence = PREC_COMPARE,
						tag = InfixLessOp,
					})
				LessEqualSymbol:
					Some({
						precedence = PREC_COMPARE,
						tag = InfixLessEqualOp,
					})
				GreaterSymbol:
					Some({
						precedence = PREC_COMPARE,
						tag = InfixGreaterOp,
					})
				GreaterEqualSymbol:
					Some({
						precedence = PREC_COMPARE,
						tag = InfixGreaterEqualOp,
					})
				DotDotSymbol:
					Some({
						precedence = PREC_RANGE,
						tag = InfixRangeOp,
					})
				PlusSymbol:
					Some({
						precedence = PREC_ADD,
						tag = InfixAddOp,
					})
				MinusSymbol:
					Some({
						precedence = PREC_ADD,
						tag = InfixSubtractOp,
					})
				StarSymbol:
					Some({
						precedence = PREC_MULTIPLY,
						tag = InfixMultiplyOp,
					})
				SlashSymbol:
					Some({
						precedence = PREC_MULTIPLY,
						tag = InfixDivideOp,
					})
				PercentSymbol:
					Some({
						precedence = PREC_MULTIPLY,
						tag = InfixModuloOp,
					})
				_:
					None
		_:
			None


private pure func current_compound_assign_op(
	state: ParserInput,
	index: Int,
) -> Option[ParsedCompoundAssignOp]:
	match current_tag(state, index):
		SymbolTag:
			match current_symbol(state, index):
				PlusEqualSymbol:
					Some(ParsedAssignAddOp)
				MinusEqualSymbol:
					Some(ParsedAssignSubtractOp)
				StarEqualSymbol:
					Some(ParsedAssignMultiplyOp)
				SlashEqualSymbol:
					Some(ParsedAssignDivideOp)
				_:
					None
		_:
			None


private pure func current_can_start_assignment_tail(state: ParserInput, index: Int) -> Bool:
	(
		current_is_symbol(state, index, EqualSymbol)
		or current_is_symbol(state, index, QuestionEqualsSymbol)
		or current_compound_assign_op(state, index).is_some()
	)


private pure func colon_starts_typed_assignment(state: ParserInput, start_index: Int) -> Bool:
	var index: Int = start_index + 1
	var depth: Int = 0
	var found_assignment: Bool = False

	while not found_assignment:
		tag: TokenTag = tag_at(state, index)

		match tag:
			EndOfFileTag:
				break
			NewlineTag:
				break
			DedentTag:
				break
			SymbolTag:
				match current_symbol(state, index):
					EqualSymbol:
						if depth == 0:
							found_assignment = True
						else:
							index += 1
					QuestionEqualsSymbol:
						if depth == 0:
							found_assignment = True
						else:
							index += 1
					LeftParenSymbol:
						depth += 1
						index += 1
					LeftBracketSymbol:
						depth += 1
						index += 1
					LeftBraceSymbol:
						depth += 1
						index += 1
					RightParenSymbol:
						if depth == 0:
							break
						else:
							depth -= 1
							index += 1
					RightBracketSymbol:
						if depth == 0:
							break
						else:
							depth -= 1
							index += 1
					RightBraceSymbol:
						if depth == 0:
							break
						else:
							depth -= 1
							index += 1
					CommaSymbol:
						if depth == 0:
							break
						else:
							index += 1
					ColonSymbol:
						if depth == 0:
							break
						else:
							index += 1
					_:
						index += 1
			_:
				index += 1

	found_assignment


private pure func expr_list_has_leading_dot_postfix_continuation(
	state: ParserInput,
	items: List[ParsedExpr],
) -> Bool:
	var found: Bool = False

	for item in items:
		if parsed_expr_has_leading_dot_postfix_continuation(state, item):
			found = True
			break

	found


private pure func parsed_expr_has_leading_dot_postfix_continuation(
	state: ParserInput,
	expr: ParsedExpr,
) -> Bool:
	match expr:
		ParsedFieldAccessExpr(target, _, span):
			target_span: SourceLocation = parsed_expr_location(target)
			field_end = parser_cursor_at_location_end(state, span)
			target_end = parser_cursor_at_location_end(state, target_span)

			(
				field_end.line > target_end.line
					or parsed_expr_has_leading_dot_postfix_continuation(state, target)
			)
		ParsedCallExpr(callee, args, _):
			(
				parsed_expr_has_leading_dot_postfix_continuation(state, callee)
					or expr_list_has_leading_dot_postfix_continuation(state, args)
			)
		ParsedSubscriptExpr(target, indices, _):
			(
				parsed_expr_has_leading_dot_postfix_continuation(state, target)
					or expr_list_has_leading_dot_postfix_continuation(state, indices)
			)
		ParsedBinaryExpr(_, left, right, _):
			(
				parsed_expr_has_leading_dot_postfix_continuation(state, left)
					or parsed_expr_has_leading_dot_postfix_continuation(state, right)
			)
		ParsedLogicalExpr(_, left, right, _):
			(
				parsed_expr_has_leading_dot_postfix_continuation(state, left)
					or parsed_expr_has_leading_dot_postfix_continuation(state, right)
			)
		ParsedAscriptionExpr(value, _, _):
			parsed_expr_has_leading_dot_postfix_continuation(state, value)
		_:
			False


private pure func parsed_expr_needs_leading_dot_continuation_dedent(
	state: ParserInput,
	expr: ParsedExpr,
) -> Bool:
	match expr:
		ParsedBinaryExpr(_, left, right, _):
			(
				parsed_expr_has_leading_dot_postfix_continuation(state, left)
					or parsed_expr_needs_leading_dot_continuation_dedent(state, right)
			)
		ParsedLogicalExpr(_, left, right, _):
			(
				parsed_expr_has_leading_dot_postfix_continuation(state, left)
					or parsed_expr_needs_leading_dot_continuation_dedent(state, right)
			)
		ParsedAscriptionExpr(value, _, _):
			parsed_expr_has_leading_dot_postfix_continuation(state, value)
		_:
			False


private pure func consume_leading_dot_postfix_continuation_dedent(
	state: ParserInput,
	index: Int,
	value: ParsedExpr,
) -> Int:
	after_value: Int = skip_newlines(state, index)

	if (
		current_is_dedent(state, after_value)
		and parsed_expr_needs_leading_dot_continuation_dedent(state, value)
	):
		advance_parser(state, after_value)
	else:
		after_value


private pure func parse_header_anchored_expression(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	header_span: SourceLocation,
) -> ParseExprStep:
	if current_is_keyword(state, index, IfKeyword):
		parse_if_expr_with_header_span(state, index, diagnostics, header_span)
	else if current_is_keyword(state, index, MatchKeyword):
		parse_match_expr_with_header_span(state, index, diagnostics, header_span)
	else if current_is_keyword(state, index, SelectKeyword):
		parse_select_expr_with_header_span(state, index, diagnostics, header_span)
	else if current_is_keyword(state, index, ForKeyword):
		parse_for_expr_with_header_span(state, index, diagnostics, header_span)
	else if (
		current_is_keyword(state, index, FuncKeyword)
		or current_is_keyword(state, index, PureKeyword)
	):
		parse_lambda_expr_with_header_span(state, index, diagnostics, header_span)
	else:
		parse_expression_with_header_span(state, index, diagnostics, PREC_LOWEST, header_span)


private pure func parse_assignment_value_expr(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	header_span: SourceLocation,
) -> ParseExprStep:
	if current_is_newline(state, index):
		var st: Int = advance_parser(state, index)
		var st_diag: List[ParseDiagnostic] = diagnostics

		if current_is_indent(state, st):
			st = advance_parser(state, st)
		else:
			st_diag = add_expected_error(
				state,
				st_diag,
				current_location(state, st),
				"expected indented assignment value",
				["indent"],
				None,
			)

		value_step: ParseExprStep = parse_expression(state, st, st_diag, PREC_LOWEST)
		after_value: Int = skip_newlines(state, value_step.index)
		after_value_diag: List[ParseDiagnostic] = value_step.diagnostics

		final_state: Int = if current_is_dedent(state, after_value):
			advance_parser(state, after_value)
		else:
			after_value

		{
			index = final_state,
			diagnostics = after_value_diag,
			value = value_step.value
		}
	else:
		value_step: ParseExprStep = parse_header_anchored_expression(
			state,
			index,
			diagnostics,
			header_span,
		)

		{
			index = consume_leading_dot_postfix_continuation_dedent(
				state,
				value_step.index,
				value_step.value,
			),
			diagnostics = value_step.diagnostics,
			value = value_step.value
		}


private pure func parse_optional_type_annotation(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseOptionalTypeStep:
	if current_is_symbol(state, index, ColonSymbol):
		type_step: ParseTypeStep = parse_type_expr(
			state,
			advance_parser(state, index),
			diagnostics,
		)

		{
			index = type_step.index,
			diagnostics = type_step.diagnostics,
			value = Some(type_step.value)
		}
	else:
		{
			index = index,
			diagnostics = diagnostics,
			value = None
		}


private pure func make_infix_expr(
	info: ParsedInfixInfo,
	left: ParsedExpr,
	right: ParsedExpr,
) -> ParsedExpr:
	span: SourceLocation = location_cover(parsed_expr_location(left), parsed_expr_location(right))

	match info.tag:
		InfixOrOp:
			ParsedLogicalExpr(ParsedOrOp, left, right, span)
		InfixAndOp:
			ParsedLogicalExpr(ParsedAndOp, left, right, span)
		InfixEqualOp:
			ParsedBinaryExpr(ParsedEqualOp, left, right, span)
		InfixNotEqualOp:
			ParsedBinaryExpr(ParsedNotEqualOp, left, right, span)
		InfixLessOp:
			ParsedBinaryExpr(ParsedLessOp, left, right, span)
		InfixLessEqualOp:
			ParsedBinaryExpr(ParsedLessEqualOp, left, right, span)
		InfixGreaterOp:
			ParsedBinaryExpr(ParsedGreaterOp, left, right, span)
		InfixGreaterEqualOp:
			ParsedBinaryExpr(ParsedGreaterEqualOp, left, right, span)
		InfixRangeOp:
			ParsedRangeExpr(left, right, span)
		InfixAddOp:
			ParsedBinaryExpr(ParsedAddOp, left, right, span)
		InfixSubtractOp:
			ParsedBinaryExpr(ParsedSubtractOp, left, right, span)
		InfixMultiplyOp:
			ParsedBinaryExpr(ParsedMultiplyOp, left, right, span)
		InfixDivideOp:
			ParsedBinaryExpr(ParsedDivideOp, left, right, span)
		InfixModuloOp:
			ParsedBinaryExpr(ParsedModuloOp, left, right, span)


private pure func layout_reaches_end_symbol(
	state: ParserInput,
	start_index: Int,
	end_symbol: Symbol,
) -> Bool:
	var index: Int = start_index

	while True:
		match tag_at(state, index):
			NewlineTag:
				index += 1
			DedentTag:
				index += 1
			_:
				break

	current_is_symbol(state, index, end_symbol)


private pure func consume_layout_before_end_symbol(
	state: ParserInput,
	index: Int,
	end_symbol: Symbol,
) -> Int:
	var st: Int = index

	if layout_reaches_end_symbol(state, st, end_symbol):
		while True:
			if current_is_newline(state, st) or current_is_dedent(state, st):
				st = advance_parser(state, st)
			else:
				break

	st


private pure func parse_expr_list_until(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	end_symbol: Symbol,
	allow_empty: Bool,
	header_span: SourceLocation,
) -> ParseExprListStep:
	var st: Int = index
	var st_diag: List[ParseDiagnostic] = diagnostics
	var values: List[ParsedExpr] = []

	if allow_empty and current_is_symbol(state, st, end_symbol):
		{
			index = st,
			diagnostics = st_diag,
			values = values
		}
	else:
		var parsing_values: Bool = True

		while parsing_values and not current_is_eof(state, st):
			expr_step: ParseExprStep = parse_header_anchored_expression(
				state,
				st,
				st_diag,
				header_span,
			)
			values = values.append(expr_step.value)
			st = expr_step.index
			st_diag = expr_step.diagnostics

			if current_is_symbol(state, st, CommaSymbol):
				st = advance_parser(state, st)

				if current_is_newline(state, st) or current_is_dedent(state, st):
					st = consume_layout_before_end_symbol(
						state,
						skip_newlines(state, st),
						end_symbol,
					)
				else:
					st = skip_newlines(state, st)

				if current_is_symbol(state, st, end_symbol):
					parsing_values = False
			else:
				parsing_values = False

		{
			index = st,
			diagnostics = st_diag,
			values = values
		}


private pure func parse_pattern_list_until(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	end_symbol: Symbol,
	allow_empty: Bool,
) -> ParsePatternListStep:
	var st: Int = index
	var st_diag: List[ParseDiagnostic] = diagnostics
	var values: List[ParsedPattern] = []

	if allow_empty and current_is_symbol(state, st, end_symbol):
		{
			index = st,
			diagnostics = st_diag,
			values = values
		}
	else:
		var parsing_values: Bool = True

		while parsing_values and not current_is_eof(state, st):
			pattern_step: ParsePatternStep = parse_pattern(state, st, st_diag)
			values = values.append(pattern_step.value)
			st = pattern_step.index
			st_diag = pattern_step.diagnostics

			if current_is_symbol(state, st, CommaSymbol):
				st = advance_parser(state, st)

				if current_is_symbol(state, st, end_symbol):
					parsing_values = False
			else:
				parsing_values = False

		{
			index = st,
			diagnostics = st_diag,
			values = values
		}


private pure func add_tuple_arity_error(
	state: ParserInput,
	diagnostics: List[ParseDiagnostic],
	span: SourceLocation,
) -> List[ParseDiagnostic]:
	add_expected_error(
		state,
		diagnostics,
		span,
		"Tuples support 2-4 elements",
		["2-4 tuple elements"],
		None,
	)


private pure func parse_tuple_pattern_after_left_paren(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	start_span: SourceLocation,
) -> ParsePatternStep:
	first_step: ParsePatternStep = parse_pattern(state, index, diagnostics)
	var st: Int = first_step.index
	var st_diag: List[ParseDiagnostic] = first_step.diagnostics
	var items: List[ParsedPattern] = [first_step.value]
	var end_span: SourceLocation = parsed_pattern_location(first_step.value)

	comma_step: ParseSymbolStep = expect_symbol(state, st, CommaSymbol)
	comma_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
		state,
		st_diag,
		comma_step,
		CommaSymbol,
		"expected `, ` between tuple pattern items",
	)
	st = comma_step.index
	st_diag = comma_step_diagnostics

	if comma_step.matched:
		rest_step: ParsePatternListStep = parse_pattern_list_until(
			state,
			st,
			st_diag,
			RightParenSymbol,
			True,
		)
		items = items.concat(rest_step.values)
		st = rest_step.index
		st_diag = rest_step.diagnostics

		match rest_step.values.get(rest_step.values.length() - 1):
			Some(last):
				end_span = parsed_pattern_location(last)
			None:
				end_span = materialize_location(state, comma_step.span)

	right_step: ParseSymbolStep = expect_symbol(state, st, RightParenSymbol)
	right_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
		state,
		st_diag,
		right_step,
		RightParenSymbol,
		"expected `)` after tuple pattern",
	)
	st = right_step.index
	st_diag = right_step_diagnostics

	if right_step.matched:
		end_span = materialize_location(state, right_step.span)

	if items.length() < 2 or items.length() > 4:
		st_diag = add_tuple_arity_error(
			state,
			st_diag,
			location_cover(start_span, end_span),
		)

	{
		index = st,
		diagnostics = st_diag,
		value = ParsedTuplePattern(
			items,
			location_cover(start_span, end_span),
		)
	}


private pure func parse_list_pattern_spread_missing(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	start_span: SourceLocation,
	span: SourceLocation,
) -> ParseListPatternSpreadStep:
	next_state_diag: List[ParseDiagnostic] = add_expected_error(
		state,
		diagnostics,
		span,
		"expected list pattern spread target",
		["identifier", "_"],
		None,
	)

	recovery_state: Int = if current_is_soft_boundary(state, index):
		index
	else:
		advance_parser(state, index)

	{
		index = recovery_state,
		diagnostics = next_state_diag,
		value = ParsedListSpreadWildcard(span),
		span = location_cover(start_span, span)
	}


private pure func parse_list_pattern_spread_after_dotdotdot(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	start_span: SourceLocation,
) -> ParseListPatternSpreadStep:
	span: SourceLocation = current_location(state, index)

	match current_tag(state, index):
		IdentifierTag:
			name: ParsedIdentifier = parsed_identifier(
				current_text(state, index),
				span,
			)
			{
				index = advance_parser(state, index),
				diagnostics = diagnostics,
				value = ParsedListSpreadName(name),
				span = location_cover(start_span, span)
			}
		SymbolTag:
			if current_symbol(state, index) == UnderscoreSymbol:
				{
					index = advance_parser(state, index),
					diagnostics = diagnostics,
					value = ParsedListSpreadWildcard(span),
					span = location_cover(start_span, span)
				}
			else:
				parse_list_pattern_spread_missing(state, index, diagnostics, start_span, span)
		_:
			parse_list_pattern_spread_missing(state, index, diagnostics, start_span, span)


private pure func parse_list_pattern_after_left_bracket(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	start_span: SourceLocation,
) -> ParsePatternStep:
	var st: Int = index
	var st_diag: List[ParseDiagnostic] = diagnostics
	var items: List[ParsedPattern] = []
	var spread: Option[ParsedListPatternSpread] = None
	var end_span: SourceLocation = start_span

	if not current_is_symbol(state, st, RightBracketSymbol):
		if current_is_symbol(state, st, DotDotDotSymbol):
			dots_span: SourceLocation = current_location(state, st)
			spread_step: ParseListPatternSpreadStep = parse_list_pattern_spread_after_dotdotdot(
				state,
				advance_parser(state, st),
				st_diag,
				dots_span,
			)
			spread = Some(spread_step.value)
			end_span = spread_step.span
			st = spread_step.index
			st_diag = spread_step.diagnostics
		else:
			var parsing_items: Bool = True

			while parsing_items and not current_is_eof(state, st):
				pattern_step: ParsePatternStep = parse_pattern(state, st, st_diag)
				items = items.append(pattern_step.value)
				st = pattern_step.index
				st_diag = pattern_step.diagnostics
				end_span = parsed_pattern_location(pattern_step.value)

				if current_is_symbol(state, st, CommaSymbol):
					st = advance_parser(state, st)

					if current_is_symbol(state, st, DotDotDotSymbol):
						dots_span: SourceLocation = current_location(state, st)
						spread_step: ParseListPatternSpreadStep = parse_list_pattern_spread_after_dotdotdot(
							state,
							advance_parser(state, st),
							st_diag,
							dots_span,
						)
						spread = Some(spread_step.value)
						end_span = spread_step.span
						st = spread_step.index
						st_diag = spread_step.diagnostics
						parsing_items = False
				else:
					parsing_items = False

	right_step: ParseSymbolStep = expect_symbol(state, st, RightBracketSymbol)
	right_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
		state,
		st_diag,
		right_step,
		RightBracketSymbol,
		"expected `]` after list pattern",
	)
	st = right_step.index
	st_diag = right_step_diagnostics

	if right_step.matched:
		end_span = materialize_location(state, right_step.span)

	{
		index = st,
		diagnostics = st_diag,
		value = ParsedListPattern(
			items,
			spread,
			location_cover(start_span, end_span),
		)
	}


private pure func parse_simple_pattern(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParsePatternStep:
	span: SourceLocation = current_location(state, index)

	match current_tag(state, index):
		IdentifierTag:
			name: ParsedIdentifier = parsed_identifier(
				current_text(state, index),
				span,
			)
			var st: Int = advance_parser(state, index)
			var st_diag: List[ParseDiagnostic] = diagnostics

			if current_is_symbol(state, st, DotSymbol):
				constructor_step: ParseIdentifierStep = parse_identifier_expected(
					state,
					advance_parser(state, st),
					st_diag,
					EXPECTED_CONSTRUCTOR_NAME,
				)
				constructor_name: ParsedIdentifier = constructor_step.value
				st = constructor_step.index
				st_diag = constructor_step.diagnostics
				var args: List[ParsedPattern] = []
				var end_span: SourceLocation = constructor_name.span

				if current_is_symbol(state, st, LeftParenSymbol):
					args_step: ParsePatternListStep = parse_pattern_list_until(
						state,
						advance_parser(state, st),
						st_diag,
						RightParenSymbol,
						True,
					)
					right_step: ParseSymbolStep = expect_symbol(
						state,
						args_step.index,
						RightParenSymbol,
					)
					right_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
						state,
						args_step.diagnostics,
						right_step,
						RightParenSymbol,
						"expected `)` after constructor pattern",
					)
					st = right_step.index
					st_diag = right_step_diagnostics
					args = args_step.values

					if right_step.matched:
						end_span = materialize_location(state, right_step.span)

				result: ParsePatternStep = {
					index = st,
					diagnostics = st_diag,
					value = ParsedQualifiedConstructorPattern(
						name,
						constructor_name,
						args,
						location_cover(name.span, end_span),
					)
				}
				result
			else if current_is_symbol(state, st, LeftParenSymbol):
				args_step: ParsePatternListStep = parse_pattern_list_until(
					state,
					advance_parser(state, st),
					st_diag,
					RightParenSymbol,
					True,
				)
				right_step: ParseSymbolStep = expect_symbol(
					state,
					args_step.index,
					RightParenSymbol,
				)
				right_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
					state,
					args_step.diagnostics,
					right_step,
					RightParenSymbol,
					"expected `)` after constructor pattern",
				)

				end_span: SourceLocation = if right_step.matched:
					materialize_location(state, right_step.span)
				else:
					name.span

				result: ParsePatternStep = {
					index = right_step.index,
					diagnostics = right_step_diagnostics,
					value = ParsedConstructorPattern(
						name,
						args_step.values,
						location_cover(name.span, end_span),
					)
				}
				result
			else:
				result: ParsePatternStep = {
					index = st,
					diagnostics = st_diag,
					value = ParsedNamePattern(name)
				}
				result
		KeywordTag:
			keyword: Keyword = current_keyword(state, index)

			if keyword == TrueKeyword:
				{
					index = advance_parser(state, index),
					diagnostics = diagnostics,
					value = ParsedBoolPattern(True, span)
				}
			else if keyword == FalseKeyword:
				{
					index = advance_parser(state, index),
					diagnostics = diagnostics,
					value = ParsedBoolPattern(False, span)
				}
			else:
				match soft_keyword_identifier_text(keyword):
					Some(text):
						{
							index = advance_parser(state, index),
							diagnostics = diagnostics,
							value = ParsedNamePattern(parsed_identifier(text, span))
						}
					None:
						name_step: ParseIdentifierStep = parse_reserved_keyword_as_name(
							state,
							index,
							diagnostics,
							keyword,
							span,
						)

						{
							index = name_step.index,
							diagnostics = name_step.diagnostics,
							value = ParsedNamePattern(name_step.value)
						}
		SymbolTag:
			symbol: Symbol = current_symbol(state, index)

			if symbol == UnderscoreSymbol:
				{
					index = advance_parser(state, index),
					diagnostics = diagnostics,
					value = ParsedWildcardPattern(span)
				}
			else if symbol == LeftParenSymbol:
				parse_tuple_pattern_after_left_paren(
					state,
					advance_parser(state, index),
					diagnostics,
					span,
				)
			else if symbol == LeftBracketSymbol:
				parse_list_pattern_after_left_bracket(
					state,
					advance_parser(state, index),
					diagnostics,
					span,
				)
			else if symbol == MinusSymbol:
				next_index: Int = advance_parser(state, index)

				match tag_at(state, next_index):
					IntLiteralTag:
						{
							index = advance_parser(state, next_index),
							diagnostics = diagnostics,
							value = ParsedIntPattern(
								"-" + current_text(state, next_index),
								location_cover(
									span,
									current_location(state, next_index),
								),
							)
						}
					FloatLiteralTag:
						{
							index = advance_parser(state, next_index),
							diagnostics = diagnostics,
							value = ParsedFloatPattern(
								"-" + current_text(state, next_index),
								location_cover(
									span,
									current_location(state, next_index),
								),
							)
						}
					_:
						next_state_diag: List[ParseDiagnostic] = add_expected_error(
							state,
							diagnostics,
							span,
							"expected numeric literal after `-` in pattern",
							["integer literal", "float literal"],
							None,
						)

						{
							index = advance_parser(state, index),
							diagnostics = next_state_diag,
							value = ParsedMissingPattern(span)
						}
			else:
				next_state: Int = index
				next_state_diag: List[ParseDiagnostic] = add_expected_error(
					state,
					diagnostics,
					span,
					"expected pattern",
					["pattern"],
					None,
				)

				recovery_state: Int = if current_is_soft_boundary(state, next_state):
					next_state
				else:
					advance_parser(state, next_state)

				{
					index = recovery_state,
					diagnostics = next_state_diag,
					value = ParsedMissingPattern(span)
				}
		IntLiteralTag:
			{
				index = advance_parser(state, index),
				diagnostics = diagnostics,
				value = ParsedIntPattern(
					current_text(state, index),
					span,
				)
			}
		FloatLiteralTag:
			{
				index = advance_parser(state, index),
				diagnostics = diagnostics,
				value = ParsedFloatPattern(
					current_text(state, index),
					span,
				)
			}
		StringLiteralTag:
			{
				index = advance_parser(state, index),
				diagnostics = diagnostics,
				value = ParsedStringPattern(
					current_string_literal_text(state, index),
					parsed_string_literal_form(current_string_literal_kind(state, index)),
					span,
				)
			}
		CharLiteralTag:
			{
				index = advance_parser(state, index),
				diagnostics = diagnostics,
				value = ParsedCharPattern(
					current_char_code_point(state, index),
					span,
				)
			}
		_:
			next_state: Int = index
			next_state_diag: List[ParseDiagnostic] = add_expected_error(
				state,
				diagnostics,
				span,
				"expected pattern",
				["pattern"],
				None,
			)

			recovery_state: Int = if current_is_soft_boundary(state, next_state):
				next_state
			else:
				advance_parser(state, next_state)

			{
				index = recovery_state,
				diagnostics = next_state_diag,
				value = ParsedMissingPattern(span)
			}


private pure func parse_pattern(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParsePatternStep:
	first_step: ParsePatternStep = parse_simple_pattern(state, index, diagnostics)
	var st: Int = first_step.index
	var st_diag: List[ParseDiagnostic] = first_step.diagnostics
	var patterns: List[ParsedPattern] = [first_step.value]
	var end_span: SourceLocation = parsed_pattern_location(first_step.value)

	while current_is_symbol(state, st, PipeSymbol) and not current_is_eof(state, st):
		next_step: ParsePatternStep = parse_simple_pattern(
			state,
			advance_parser(state, st),
			st_diag,
		)
		patterns = patterns.append(next_step.value)
		st = next_step.index
		st_diag = next_step.diagnostics
		end_span = parsed_pattern_location(next_step.value)

	if patterns.length() == 1:
		first_step
	else:
		{
			index = st,
			diagnostics = st_diag,
			value = ParsedOrPattern(
				patterns,
				location_cover(parsed_pattern_location(first_step.value), end_span),
			)
		}


private pure func last_expr_location(
	items: List[ParsedExpr],
	fallback: SourceLocation,
) -> SourceLocation:
	var span: SourceLocation = fallback

	for item in items:
		span = parsed_expr_location(item)

	span


private pure func first_expr_location(
	items: List[ParsedExpr],
	fallback: SourceLocation,
) -> SourceLocation:
	match items.get(0):
		Some(item):
			parsed_expr_location(item)
		None:
			fallback


private pure func current_token_is_indented_past_anchor(
	state: ParserInput,
	index: Int,
	header: Cursor,
) -> Bool:
	(
		not current_is_eof(state, index)
		and not current_is_dedent(state, index)
		and state.start_lines.get_or(index, 0) > header.line
		and state.start_columns.get_or(index, 0) > header.column
	)


private pure func current_token_is_indented_past(
	state: ParserInput,
	index: Int,
	header_span: SourceLocation,
) -> Bool:
	current_token_is_indented_past_anchor(
		state,
		index,
		parser_cursor_at_location_start(state, header_span),
	)


private pure func consume_block_indent(
	state: ParserInput,
	index: Int,
	header_span: SourceLocation,
) -> ParserStep:
	st: Int = skip_newlines(state, index)

	if current_is_indent(state, st):
		{
			index = advance_parser(state, st),
			matched = True
		}
	else if current_token_is_indented_past(state, st, header_span):
		{
			index = st,
			matched = True
		}
	else:
		expect_indent(state, st)


private pure func parse_statement_list(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	header_span: SourceLocation,
) -> ParseExprListStep:
	header: Cursor = parser_cursor_at_location_start(state, header_span)
	var st: Int = skip_newlines(state, index)
	var st_diag: List[ParseDiagnostic] = diagnostics
	var values: List[ParsedExpr] = []

	while (
		current_token_is_indented_past_anchor(state, st, header)
		and not current_is_block_end(state, st)
	):
		before_index: Int = st
		statement_step: ParseExprStep = parse_statement(state, st, st_diag)
		values = values.append(statement_step.value)
		st = skip_newlines(state, statement_step.index)
		st_diag = statement_step.diagnostics

		if (
			st == before_index
			and current_token_is_indented_past_anchor(state, st, header)
			and not current_is_block_end(state, st)
		):
			st = advance_parser(state, st)

	{
		index = st,
		diagnostics = st_diag,
		values = values
	}


private pure func parse_indented_block_body(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	start_span: SourceLocation,
) -> ParseExprStep:
	__step_2: ParserStep = consume_block_indent(state, index, start_span)
	__step_2_diagnostics: List[ParseDiagnostic] = expect_indent_diagnostics(
		state,
		diagnostics,
		__step_2,
	)
	var st: Int = __step_2.index
	var st_diag: List[ParseDiagnostic] = __step_2_diagnostics
	st = skip_newlines(state, st)
	items_step: ParseExprListStep = parse_statement_list(state, st, st_diag, start_span)
	st = items_step.index
	st_diag = items_step.diagnostics

	block_start_span: SourceLocation = first_expr_location(items_step.values, start_span)
	block_end_span: SourceLocation = last_expr_location(items_step.values, block_start_span)

	if current_is_dedent(state, st):
		__step_3: ParserStep = expect_dedent(state, st)
		__step_3_diagnostics: List[ParseDiagnostic] = expect_dedent_diagnostics(
			state,
			st_diag,
			__step_3,
		)
		st = __step_3.index
		st_diag = __step_3_diagnostics

	{
		index = st,
		diagnostics = st_diag,
		value = ParsedBlockExpr(
			items_step.values,
			location_cover(block_start_span, block_end_span),
		)
	}


private pure func parse_block_after_colon(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	start_span: SourceLocation,
) -> ParseExprStep:
	newline_step: ParserStep = expect_newline(state, index)
	newline_step_diagnostics: List[ParseDiagnostic] = expect_newline_diagnostics(
		state,
		diagnostics,
		newline_step,
		"expected newline before indented block",
	)
	parse_indented_block_body(state, newline_step.index, newline_step_diagnostics, start_span)


private pure func parse_if_expr_with_header_span(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	header_span: SourceLocation,
) -> ParseExprStep:
	start_span: SourceLocation = current_location(state, index)
	cond_step: ParseExprStep = parse_expression(
		state,
		advance_parser(state, index),
		diagnostics,
		PREC_LOWEST,
	)
	colon_step: ParseSymbolStep = expect_symbol(state, cond_step.index, ColonSymbol)
	colon_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
		state,
		cond_step.diagnostics,
		colon_step,
		ColonSymbol,
		"expected `:` after if condition",
	)
	then_step: ParseExprStep = parse_block_after_colon(
		state,
		colon_step.index,
		colon_step_diagnostics,
		header_span,
	)
	var st: Int = then_step.index
	var st_diag: List[ParseDiagnostic] = then_step.diagnostics
	var else_branch: Option[ParsedExpr] = None
	var end_span: SourceLocation = parsed_expr_location(then_step.value)

	if current_is_keyword(state, st, ElseKeyword):
		else_span: SourceLocation = current_location(state, st)
		st = advance_parser(state, st)

		if current_is_keyword(state, st, IfKeyword):
			else_if_step: ParseExprStep = parse_if_expr_with_header_span(
				state,
				st,
				st_diag,
				else_span,
			)
			else_branch = Some(else_if_step.value)
			st = else_if_step.index
			st_diag = else_if_step.diagnostics
			end_span = parsed_expr_location(else_if_step.value)
		else:
			else_colon_step: ParseSymbolStep = expect_symbol(state, st, ColonSymbol)
			else_colon_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
				state,
				st_diag,
				else_colon_step,
				ColonSymbol,
				"expected `:` after else",
			)
			else_step: ParseExprStep = parse_block_after_colon(
				state,
				else_colon_step.index,
				else_colon_step_diagnostics,
				else_span,
			)
			else_branch = Some(else_step.value)
			st = else_step.index
			st_diag = else_step.diagnostics
			end_span = parsed_expr_location(else_step.value)

	{
		index = st,
		diagnostics = st_diag,
		value = ParsedIfExpr(
			cond_step.value,
			then_step.value,
			else_branch,
			location_cover(start_span, end_span),
		)
	}


private pure func parse_match_case(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseMatchCaseStep:
	pattern_step: ParsePatternStep = parse_pattern(state, index, diagnostics)
	colon_step: ParseSymbolStep = expect_symbol(state, pattern_step.index, ColonSymbol)
	colon_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
		state,
		pattern_step.diagnostics,
		colon_step,
		ColonSymbol,
		"expected `:` after match pattern",
	)

	body_step: ParseExprStep = if current_is_newline(state, colon_step.index):
		parse_block_after_colon(
			state,
			colon_step.index,
			colon_step_diagnostics,
			parsed_pattern_location(pattern_step.value),
		)
	else if current_is_keyword(state, colon_step.index, MatchKeyword):
		parse_match_expr_with_header_span(
			state,
			colon_step.index,
			colon_step_diagnostics,
			parsed_pattern_location(pattern_step.value),
		)
	else if current_is_keyword(state, colon_step.index, IfKeyword):
		parse_if_expr_with_header_span(
			state,
			colon_step.index,
			colon_step_diagnostics,
			parsed_pattern_location(pattern_step.value),
		)
	else:
		parse_statement(state, colon_step.index, colon_step_diagnostics)

	{
		index = body_step.index,
		diagnostics = body_step.diagnostics,
		value = {
			pattern = pattern_step.value,
			body = body_step.value,
			span = location_cover(
				parsed_pattern_location(pattern_step.value),
				parsed_expr_location(body_step.value),
			)
		}
	}


private pure func parse_match_case_list(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	header_span: SourceLocation,
) -> ParseMatchCaseListStep:
	header: Cursor = parser_cursor_at_location_start(state, header_span)
	var st: Int = skip_newlines(state, index)
	var st_diag: List[ParseDiagnostic] = diagnostics
	var cases: List[ParsedMatchCase] = []

	while (
		current_token_is_indented_past_anchor(state, st, header)
		and not current_is_block_end(state, st)
	):
		before_index: Int = st
		case_step: ParseMatchCaseStep = parse_match_case(state, st, st_diag)
		cases = cases.append(case_step.value)
		st = skip_newlines(state, case_step.index)
		st_diag = case_step.diagnostics

		if (
			st == before_index
			and current_token_is_indented_past_anchor(state, st, header)
			and not current_is_block_end(state, st)
		):
			st = advance_parser(state, st)

	{
		index = st,
		diagnostics = st_diag,
		values = cases
	}


private pure func parse_match_expr_with_header_span(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	header_span: SourceLocation,
) -> ParseExprStep:
	start_span: SourceLocation = current_location(state, index)
	scrutinee_step: ParseExprStep = parse_expression(
		state,
		advance_parser(state, index),
		diagnostics,
		PREC_LOWEST,
	)
	colon_step: ParseSymbolStep = expect_symbol(state, scrutinee_step.index, ColonSymbol)
	colon_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
		state,
		scrutinee_step.diagnostics,
		colon_step,
		ColonSymbol,
		"expected `:` after match expression",
	)
	__step_4: ParserStep = expect_newline(state, colon_step.index)
	__step_4_diagnostics: List[ParseDiagnostic] = expect_newline_diagnostics(
		state,
		colon_step_diagnostics,
		__step_4,
		"expected newline before match cases",
	)
	var st: Int = __step_4.index
	var st_diag: List[ParseDiagnostic] = __step_4_diagnostics
	__step_5: ParserStep = consume_block_indent(state, st, header_span)
	__step_5_diagnostics: List[ParseDiagnostic] = expect_indent_diagnostics(
		state,
		st_diag,
		__step_5,
	)
	st = __step_5.index
	st_diag = __step_5_diagnostics
	cases_step: ParseMatchCaseListStep = parse_match_case_list(state, st, st_diag, header_span)
	st = cases_step.index
	st_diag = cases_step.diagnostics

	end_span: SourceLocation = if current_is_dedent(state, st):
		current_location(state, st)
	else:
		start_span

	if current_is_dedent(state, st):
		__step_6: ParserStep = expect_dedent(state, st)
		__step_6_diagnostics: List[ParseDiagnostic] = expect_dedent_diagnostics(
			state,
			st_diag,
			__step_6,
		)
		st = __step_6.index
		st_diag = __step_6_diagnostics

	{
		index = st,
		diagnostics = st_diag,
		value = ParsedMatchExpr(
			scrutinee_step.value,
			cases_step.values,
			location_cover(start_span, end_span),
		)
	}


private pure func parse_select_receive_arm(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	start_span: SourceLocation,
) -> ParseSelectArmStep:
	binder_step: ParseIdentifierStep = parse_select_receive_identifier_expected(
		state,
		index,
		diagnostics,
		"select receive binding",
	)
	__step_7: ParserStep = expect_keyword(state, binder_step.index, FromKeyword)
	__step_7_diagnostics: List[ParseDiagnostic] = expect_keyword_diagnostics(
		state,
		binder_step.diagnostics,
		__step_7,
		"from",
		"expected `from` after select receive binding",
	)
	var st: Int = __step_7.index
	var st_diag: List[ParseDiagnostic] = __step_7_diagnostics
	channel_step: ParseExprStep = parse_expression(state, st, st_diag, PREC_LOWEST)
	colon_step: ParseSymbolStep = expect_symbol(state, channel_step.index, ColonSymbol)
	colon_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
		state,
		channel_step.diagnostics,
		colon_step,
		ColonSymbol,
		"expected `:` after select receive channel",
	)
	body_step: ParseExprStep = parse_block_after_colon(
		state,
		colon_step.index,
		colon_step_diagnostics,
		start_span,
	)

	{
		index = body_step.index,
		diagnostics = body_step.diagnostics,
		value = {
			kind = ParsedSelectReceiveArm(binder_step.value, channel_step.value),
			body = body_step.value,
			span = location_cover(start_span, parsed_expr_location(body_step.value))
		}
	}


private pure func parse_select_sealed_arm(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	start_span: SourceLocation,
) -> ParseSelectArmStep:
	channel_step: ParseExprStep = parse_expression(
		state,
		advance_parser(state, index),
		diagnostics,
		PREC_LOWEST,
	)
	colon_step: ParseSymbolStep = expect_symbol(state, channel_step.index, ColonSymbol)
	colon_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
		state,
		channel_step.diagnostics,
		colon_step,
		ColonSymbol,
		"expected `:` after sealed select channel",
	)
	body_step: ParseExprStep = parse_block_after_colon(
		state,
		colon_step.index,
		colon_step_diagnostics,
		start_span,
	)

	{
		index = body_step.index,
		diagnostics = body_step.diagnostics,
		value = {
			kind = ParsedSelectSealedArm(channel_step.value),
			body = body_step.value,
			span = location_cover(start_span, parsed_expr_location(body_step.value))
		}
	}


private pure func parse_select_after_arm(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	start_span: SourceLocation,
) -> ParseSelectArmStep:
	var st: Int = advance_parser(state, index)
	var st_diag: List[ParseDiagnostic] = diagnostics
	__step_8: ParserStep = expect_keyword(state, st, AfterKeyword)
	__step_8_diagnostics: List[ParseDiagnostic] = expect_keyword_diagnostics(
		state,
		st_diag,
		__step_8,
		"after",
		"expected `after` in select timeout arm",
	)
	st = __step_8.index
	st_diag = __step_8_diagnostics
	timeout_step: ParseExprStep = parse_expression(state, st, st_diag, PREC_LOWEST)
	colon_step: ParseSymbolStep = expect_symbol(state, timeout_step.index, ColonSymbol)
	colon_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
		state,
		timeout_step.diagnostics,
		colon_step,
		ColonSymbol,
		"expected `:` after select timeout",
	)
	body_step: ParseExprStep = parse_block_after_colon(
		state,
		colon_step.index,
		colon_step_diagnostics,
		start_span,
	)

	{
		index = body_step.index,
		diagnostics = body_step.diagnostics,
		value = {
			kind = ParsedSelectAfterArm(timeout_step.value),
			body = body_step.value,
			span = location_cover(start_span, parsed_expr_location(body_step.value))
		}
	}


private pure func parse_select_arm(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseSelectArmStep:
	start_span: SourceLocation = current_location(state, index)

	if current_is_keyword(state, index, SealedKeyword):
		parse_select_sealed_arm(state, index, diagnostics, start_span)
	else if (
		current_is_symbol(state, index, UnderscoreSymbol)
		and next_is_keyword(state, index, AfterKeyword)
	):
		parse_select_after_arm(state, index, diagnostics, start_span)
	else:
		parse_select_receive_arm(state, index, diagnostics, start_span)


private pure func parse_select_arm_list(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	header_span: SourceLocation,
) -> ParseSelectArmListStep:
	header: Cursor = parser_cursor_at_location_start(state, header_span)
	var st: Int = skip_newlines(state, index)
	var st_diag: List[ParseDiagnostic] = diagnostics
	var values: List[ParsedSelectArm] = []

	while (
		current_token_is_indented_past_anchor(state, st, header)
		and not current_is_block_end(state, st)
	):
		before_index: Int = st
		arm_step: ParseSelectArmStep = parse_select_arm(state, st, st_diag)
		values = values.append(arm_step.value)
		st = skip_newlines(state, arm_step.index)
		st_diag = arm_step.diagnostics

		if (
			st == before_index
			and current_token_is_indented_past_anchor(state, st, header)
			and not current_is_block_end(state, st)
		):
			st = advance_parser(state, st)

	{
		index = st,
		diagnostics = st_diag,
		values = values
	}


private pure func parse_select_expr_with_header_span(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	header_span: SourceLocation,
) -> ParseExprStep:
	start_span: SourceLocation = current_location(state, index)
	var st: Int = advance_parser(state, index)
	var st_diag: List[ParseDiagnostic] = diagnostics
	colon_step: ParseSymbolStep = expect_symbol(state, st, ColonSymbol)
	colon_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
		state,
		st_diag,
		colon_step,
		ColonSymbol,
		"expected `:` after select",
	)
	__step_9: ParserStep = expect_newline(state, colon_step.index)
	__step_9_diagnostics: List[ParseDiagnostic] = expect_newline_diagnostics(
		state,
		colon_step_diagnostics,
		__step_9,
		"expected newline before select arms",
	)
	st = __step_9.index
	st_diag = __step_9_diagnostics
	__step_10: ParserStep = consume_block_indent(state, st, header_span)
	__step_10_diagnostics: List[ParseDiagnostic] = expect_indent_diagnostics(
		state,
		st_diag,
		__step_10,
	)
	st = __step_10.index
	st_diag = __step_10_diagnostics
	arms_step: ParseSelectArmListStep = parse_select_arm_list(state, st, st_diag, header_span)
	st = arms_step.index
	st_diag = arms_step.diagnostics

	end_span: SourceLocation = if current_is_dedent(state, st):
		current_location(state, st)
	else:
		start_span

	if current_is_dedent(state, st):
		__step_11: ParserStep = expect_dedent(state, st)
		__step_11_diagnostics: List[ParseDiagnostic] = expect_dedent_diagnostics(
			state,
			st_diag,
			__step_11,
		)
		st = __step_11.index
		st_diag = __step_11_diagnostics

	{
		index = st,
		diagnostics = st_diag,
		value = ParsedSelectExpr(
			arms_step.values,
			location_cover(start_span, end_span),
		)
	}


private pure func parse_debug_block_expr(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseExprStep:
	start_span: SourceLocation = current_location(state, index)
	colon_step: ParseSymbolStep = expect_symbol(
		state,
		advance_parser(state, index),
		ColonSymbol,
	)
	colon_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
		state,
		diagnostics,
		colon_step,
		ColonSymbol,
		"expected `:` after debug",
	)
	body_step: ParseExprStep = parse_block_after_colon(
		state,
		colon_step.index,
		colon_step_diagnostics,
		start_span,
	)

	{
		index = body_step.index,
		diagnostics = body_step.diagnostics,
		value = ParsedDebugBlockExpr(
			body_step.value,
			location_cover(start_span, parsed_expr_location(body_step.value)),
		)
	}


private pure func parse_with_error_map_opt(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseWithErrorMapStep:
	if current_is_keyword(state, index, OnKeyword):
		var st: Int = advance_parser(state, index)
		var st_diag: List[ParseDiagnostic] = diagnostics
		name_step: ParseIdentifierStep = parse_binder_identifier_expected(
			state,
			st,
			st_diag,
			"with error name",
		)
		st = name_step.index
		st_diag = name_step.diagnostics
		fat_arrow_step: ParseSymbolStep = expect_symbol(state, st, FatArrowSymbol)
		fat_arrow_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
			state,
			st_diag,
			fat_arrow_step,
			FatArrowSymbol,
			"expected `=>` after with error name",
		)
		value_step: ParseExprStep = parse_expression(
			state,
			fat_arrow_step.index,
			fat_arrow_step_diagnostics,
			PREC_LOWEST,
		)

		{
			index = value_step.index,
			diagnostics = value_step.diagnostics,
			value = Some({
				name = name_step.value,
				value = value_step.value,
				span = location_cover(name_step.value.span, parsed_expr_location(value_step.value)),
			})
		}
	else:
		{
			index = index,
			diagnostics = diagnostics,
			value = None
		}


private pure func parse_with_binding(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseWithBindingStep:
	name_step: ParseIdentifierStep = parse_binder_identifier_expected(
		state,
		index,
		diagnostics,
		"with binding name",
	)
	type_step: ParseOptionalTypeStep = parse_optional_type_annotation(
		state,
		name_step.index,
		name_step.diagnostics,
	)
	var st: Int = type_step.index
	var st_diag: List[ParseDiagnostic] = type_step.diagnostics
	var kind: ParsedWithBindingKind = ParsedWithPlainBinding

	if current_is_symbol(state, st, QuestionEqualsSymbol):
		kind = ParsedWithTryBinding
		st = advance_parser(state, st)
	else:
		equal_step: ParseSymbolStep = expect_symbol(state, st, EqualSymbol)
		equal_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
			state,
			st_diag,
			equal_step,
			EqualSymbol,
			"expected `=` or `?=` after with binding",
		)
		st = equal_step.index
		st_diag = equal_step_diagnostics

	value_step: ParseExprStep = parse_expression(state, st, st_diag, PREC_LOWEST)
	st = value_step.index
	st_diag = value_step.diagnostics

	error_map_step: ParseWithErrorMapStep = if kind == ParsedWithTryBinding:
		parse_with_error_map_opt(state, st, st_diag)
	else:
		{
			index = st,
			diagnostics = st_diag,
			value = None
		}

	st = error_map_step.index
	st_diag = error_map_step.diagnostics

	end_span: SourceLocation = match error_map_step.value:
		Some(error_map):
			error_map.span
		None:
			parsed_expr_location(value_step.value)

	{
		index = st,
		diagnostics = st_diag,
		value = {
			name = name_step.value,
			type_expr = type_step.value,
			value = value_step.value,
			kind = kind,
			error_map = error_map_step.value,
			span = location_cover(name_step.value.span, end_span)
		}
	}


private pure func add_with_multi_binding_error(
	state: ParserInput,
	diagnostics: List[ParseDiagnostic],
	span: SourceLocation,
) -> List[ParseDiagnostic]:
	add_expected_error(
		state,
		diagnostics,
		span,
		(
			"Multiple resource bindings in one `with` header are not supported yet. Nested "
			+ "`with` blocks make resource close order explicit."
		),
		[":"],
		Some("use nested `with` blocks to make resource close order explicit"),
	)


private pure func parse_with_expr(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseExprStep:
	start_span: SourceLocation = current_location(state, index)
	binding_step: ParseWithBindingStep = parse_with_binding(
		state,
		advance_parser(state, index),
		diagnostics,
	)
	var st: Int = binding_step.index
	var st_diag: List[ParseDiagnostic] = binding_step.diagnostics

	if current_is_symbol(state, st, CommaSymbol):
		st_diag = add_with_multi_binding_error(
			state,
			st_diag,
			current_location(state, st),
		)

		while (
			not current_is_eof(state, st)
			and not current_is_newline(state, st)
			and not current_is_symbol(state, st, ColonSymbol)
		):
			st = advance_parser(state, st)

	colon_step: ParseSymbolStep = expect_symbol(state, st, ColonSymbol)
	colon_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
		state,
		st_diag,
		colon_step,
		ColonSymbol,
		"expected `:` after with binding",
	)
	body_step: ParseExprStep = parse_block_after_colon(
		state,
		colon_step.index,
		colon_step_diagnostics,
		start_span,
	)

	body: ParsedExpr = match body_step.value:
		ParsedBlockExpr(items, span):
			ParsedBlockExpr(
				items,
				location_cover(
					first_expr_location(items, span),
					span,
				),
			)
		_:
			body_step.value

	{
		index = body_step.index,
		diagnostics = body_step.diagnostics,
		value = ParsedWithExpr(
			binding_step.value,
			body,
			location_cover(start_span, parsed_expr_location(body)),
		)
	}


private pure func parse_concurrent_param(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseConcurrentParamStep:
	name_step: ParseIdentifierStep = parse_identifier_expected(
		state,
		index,
		diagnostics,
		EXPECTED_CONCURRENT_PARAM,
	)
	var st: Int = name_step.index
	var st_diag: List[ParseDiagnostic] = name_step.diagnostics
	colon_step: ParseSymbolStep = expect_symbol(state, st, ColonSymbol)
	colon_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
		state,
		st_diag,
		colon_step,
		ColonSymbol,
		"expected `:` after concurrent parameter name",
	)
	value_step: ParseExprStep = parse_expression(
		state,
		colon_step.index,
		colon_step_diagnostics,
		PREC_LOWEST,
	)

	{
		index = value_step.index,
		diagnostics = value_step.diagnostics,
		value = {
			name = name_step.value,
			value = value_step.value,
			span = location_cover(name_step.value.span, parsed_expr_location(value_step.value))
		}
	}


private pure func parse_concurrent_param_list_after_left_paren(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	empty_help: String,
) -> ParseConcurrentParamListStep:
	var st: Int = index
	var st_diag: List[ParseDiagnostic] = diagnostics
	var values: List[ParsedConcurrentParam] = []

	if current_is_symbol(state, st, RightParenSymbol):
		st_diag = add_expected_error(
			state,
			st_diag,
			current_location(state, st),
			"expected concurrent parameter",
			[EXPECTED_CONCURRENT_PARAM],
			Some(empty_help),
		)
	else:
		var parsing_params: Bool = True

		while parsing_params and not current_is_eof(state, st):
			before_index: Int = st
			param_step: ParseConcurrentParamStep = parse_concurrent_param(state, st, st_diag)
			values = values.append(param_step.value)
			st = param_step.index
			st_diag = param_step.diagnostics

			if current_is_symbol(state, st, CommaSymbol):
				st = advance_parser(state, st)

				if current_is_symbol(state, st, RightParenSymbol):
					parsing_params = False
			else if current_is_symbol(state, st, RightParenSymbol):
				parsing_params = False
			else:
				st_diag = add_expected_error(
					state,
					st_diag,
					current_location(state, st),
					"expected `, ` between concurrent parameters",
					[","],
					None,
				)

			if st == before_index and not current_is_symbol(state, st, RightParenSymbol):
				st = advance_parser(state, st)

	{
		index = st,
		diagnostics = st_diag,
		values = values
	}


private pure func parse_concurrent_block_expr(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseExprStep:
	start_span: SourceLocation = current_location(state, index)
	var st: Int = advance_parser(state, index)
	var st_diag: List[ParseDiagnostic] = diagnostics
	var params: List[ParsedConcurrentParam] = []

	if current_is_symbol(state, st, LeftParenSymbol):
		params_step: ParseConcurrentParamListStep = parse_concurrent_param_list_after_left_paren(
			state,
			advance_parser(state, st),
			st_diag,
			"omit the parentheses for a concurrent block with no parameters",
		)
		params = params_step.values
		right_step: ParseSymbolStep = expect_symbol(state, params_step.index, RightParenSymbol)
		right_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
			state,
			params_step.diagnostics,
			right_step,
			RightParenSymbol,
			"expected `)` after concurrent parameters",
		)
		st = right_step.index
		st_diag = right_step_diagnostics

	colon_step: ParseSymbolStep = expect_symbol(state, st, ColonSymbol)
	colon_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
		state,
		st_diag,
		colon_step,
		ColonSymbol,
		"expected `:` after concurrent",
	)
	body_step: ParseExprStep = parse_block_after_colon(
		state,
		colon_step.index,
		colon_step_diagnostics,
		start_span,
	)

	{
		index = body_step.index,
		diagnostics = body_step.diagnostics,
		value = ParsedConcurrentBlockExpr(
			params,
			body_step.value,
			location_cover(start_span, parsed_expr_location(body_step.value)),
		)
	}


private pure func parse_concurrent_for_tail(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	binder: ParsedIdentifier,
	iterable: ParsedExpr,
	start_span: SourceLocation,
	header_span: SourceLocation,
) -> ParseExprStep:
	var st: Int = advance_parser(state, index)
	var st_diag: List[ParseDiagnostic] = diagnostics
	var params: List[ParsedConcurrentParam] = []

	if current_is_symbol(state, st, LeftParenSymbol):
		params_step: ParseConcurrentParamListStep = parse_concurrent_param_list_after_left_paren(
			state,
			advance_parser(state, st),
			st_diag,
			"write at least `limit: N` inside concurrently(...)",
		)
		params = params_step.values
		right_step: ParseSymbolStep = expect_symbol(state, params_step.index, RightParenSymbol)
		right_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
			state,
			params_step.diagnostics,
			right_step,
			RightParenSymbol,
			"expected `)` after concurrently parameters",
		)
		st = right_step.index
		st_diag = right_step_diagnostics
	else:
		st_diag = add_expected_error(
			state,
			st_diag,
			current_location(state, st),
			"expected `(` after concurrently",
			["("],
			Some("write `for x in xs concurrently(limit: N):`"),
		)

	colon_step: ParseSymbolStep = expect_symbol(state, st, ColonSymbol)
	colon_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
		state,
		st_diag,
		colon_step,
		ColonSymbol,
		"expected `:` after concurrently parameters",
	)
	body_step: ParseExprStep = parse_block_after_colon(
		state,
		colon_step.index,
		colon_step_diagnostics,
		header_span,
	)

	{
		index = body_step.index,
		diagnostics = body_step.diagnostics,
		value = ParsedConcurrentForExpr(
			binder,
			iterable,
			params,
			body_step.value,
			location_cover(start_span, parsed_expr_location(body_step.value)),
		)
	}


private pure func parse_tuple_binder_identifier_expected(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	expected: String,
	mode: TupleBinderIdentifierMode,
) -> ParseIdentifierStep:
	match mode:
		TupleBinderNamesOnly:
			parse_declared_name_expected(state, index, diagnostics, expected)
		TupleBinderNamesOrUnderscore:
			parse_binder_identifier_expected(state, index, diagnostics, expected)


private pure func parse_tuple_binder_after_left_paren(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	start_span: SourceLocation,
	mode: TupleBinderIdentifierMode,
	item_expected: String,
	comma_message: String,
	missing_after_comma_message: String,
	close_message: String,
) -> ParseTupleBinderStep:
	var st: Int = index
	var st_diag: List[ParseDiagnostic] = diagnostics
	var values: List[ParsedIdentifier] = []
	var end_span: SourceLocation = start_span

	first_step: ParseIdentifierStep = parse_tuple_binder_identifier_expected(
		state,
		st,
		st_diag,
		item_expected,
		mode,
	)
	values = values.append(first_step.value)
	st = first_step.index
	st_diag = first_step.diagnostics
	end_span = first_step.value.span

	comma_step: ParseSymbolStep = expect_symbol(state, st, CommaSymbol)
	comma_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
		state,
		st_diag,
		comma_step,
		CommaSymbol,
		comma_message,
	)
	st = comma_step.index
	st_diag = comma_step_diagnostics

	if comma_step.matched:
		var parsing_values: Bool = True

		while parsing_values and not current_is_eof(state, st):
			if current_is_symbol(state, st, RightParenSymbol):
				st_diag = add_expected_error(
					state,
					st_diag,
					current_location(state, st),
					missing_after_comma_message,
					[item_expected],
					None,
				)
				parsing_values = False
			else:
				item_step: ParseIdentifierStep = parse_tuple_binder_identifier_expected(
					state,
					st,
					st_diag,
					item_expected,
					mode,
				)
				values = values.append(item_step.value)
				st = item_step.index
				st_diag = item_step.diagnostics
				end_span = item_step.value.span

				if current_is_symbol(state, st, CommaSymbol):
					st = advance_parser(state, st)

					if current_is_symbol(state, st, RightParenSymbol):
						parsing_values = False
				else:
					parsing_values = False

	right_step: ParseSymbolStep = expect_symbol(state, st, RightParenSymbol)
	right_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
		state,
		st_diag,
		right_step,
		RightParenSymbol,
		close_message,
	)
	st = right_step.index
	st_diag = right_step_diagnostics

	if right_step.matched:
		end_span = materialize_location(state, right_step.span)

	if values.length() < 2 or values.length() > 4:
		st_diag = add_tuple_arity_error(
			state,
			st_diag,
			location_cover(start_span, end_span),
		)

	{
		index = st,
		diagnostics = st_diag,
		values = values,
		span = location_cover(start_span, end_span)
	}


private pure func parse_for_tuple_binder_after_left_paren(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	start_span: SourceLocation,
) -> ParseForBinderStep:
	binder_step: ParseTupleBinderStep = parse_tuple_binder_after_left_paren(
		state,
		index,
		diagnostics,
		start_span,
		TupleBinderNamesOrUnderscore,
		"tuple loop variable",
		"expected `, ` between tuple loop variables",
		"expected tuple loop variable after `, `",
		"expected `)` after tuple loop variables",
	)

	{
		index = binder_step.index,
		diagnostics = binder_step.diagnostics,
		value = ParsedForTupleBinder(binder_step.values, binder_step.span)
	}


private pure func parse_for_binder(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseForBinderStep:
	if current_is_symbol(state, index, LeftParenSymbol):
		parse_for_tuple_binder_after_left_paren(
			state,
			advance_parser(state, index),
			diagnostics,
			current_location(state, index),
		)
	else:
		name_step: ParseIdentifierStep = parse_binder_identifier_expected(
			state,
			index,
			diagnostics,
			"for loop variable",
		)

		{
			index = name_step.index,
			diagnostics = name_step.diagnostics,
			value = ParsedForNameBinder(name_step.value)
		}


private pure func parse_while_expr(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseExprStep:
	start_span: SourceLocation = current_location(state, index)
	cond_step: ParseExprStep = parse_expression(
		state,
		advance_parser(state, index),
		diagnostics,
		PREC_LOWEST,
	)
	colon_step: ParseSymbolStep = expect_symbol(state, cond_step.index, ColonSymbol)
	colon_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
		state,
		cond_step.diagnostics,
		colon_step,
		ColonSymbol,
		"expected `:` after while condition",
	)
	body_step: ParseExprStep = parse_block_after_colon(
		state,
		colon_step.index,
		colon_step_diagnostics,
		start_span,
	)

	{
		index = body_step.index,
		diagnostics = body_step.diagnostics,
		value = ParsedWhileExpr(
			cond_step.value,
			body_step.value,
			location_cover(start_span, parsed_expr_location(body_step.value)),
		)
	}


private pure func parse_for_expr_with_header_span(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	header_span: SourceLocation,
) -> ParseExprStep:
	start_span: SourceLocation = current_location(state, index)
	binder_step: ParseForBinderStep = parse_for_binder(
		state,
		advance_parser(state, index),
		diagnostics,
	)
	__step_12: ParserStep = expect_keyword(state, binder_step.index, InKeyword)
	__step_12_diagnostics: List[ParseDiagnostic] = expect_keyword_diagnostics(
		state,
		binder_step.diagnostics,
		__step_12,
		"in",
		"expected `in` after for loop variable",
	)
	var st: Int = __step_12.index
	var st_diag: List[ParseDiagnostic] = __step_12_diagnostics
	iter_step: ParseExprStep = parse_expression(state, st, st_diag, PREC_LOWEST)

	if current_is_keyword(state, iter_step.index, ConcurrentlyKeyword):
		match binder_step.value:
			ParsedForNameBinder(name):
				parse_concurrent_for_tail(
					state,
					iter_step.index,
					iter_step.diagnostics,
					name,
					iter_step.value,
					start_span,
					header_span,
				)
			ParsedForTupleBinder(_, _):
				error_state: Int = iter_step.index
				error_state_diag: List[ParseDiagnostic] = add_expected_error(
					state,
					iter_step.diagnostics,
					current_location(state, iter_step.index),
					"`for ... concurrently` requires a single loop variable",
					["loop variable"],
					Some("write `for item in items concurrently(limit: N):`"),
				)
				parse_concurrent_for_tail(
					state,
					error_state,
					error_state_diag,
					parsed_identifier("_", start_span),
					iter_step.value,
					start_span,
					header_span,
				)
	else:
		colon_step: ParseSymbolStep = expect_symbol(state, iter_step.index, ColonSymbol)
		colon_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
			state,
			iter_step.diagnostics,
			colon_step,
			ColonSymbol,
			"expected `:` after for loop iterable",
		)
		body_step: ParseExprStep = parse_block_after_colon(
			state,
			colon_step.index,
			colon_step_diagnostics,
			header_span,
		)

		{
			index = body_step.index,
			diagnostics = body_step.diagnostics,
			value = ParsedForExpr(
				binder_step.value,
				iter_step.value,
				body_step.value,
				location_cover(start_span, parsed_expr_location(body_step.value)),
			)
		}


private pure func parse_var_decl_statement(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseExprStep:
	start_span: SourceLocation = current_location(state, index)
	name_step: ParseIdentifierStep = parse_binder_identifier_expected(
		state,
		advance_parser(state, index),
		diagnostics,
		"variable name",
	)
	type_step: ParseOptionalTypeStep = parse_optional_type_annotation(
		state,
		name_step.index,
		name_step.diagnostics,
	)
	var st: Int = type_step.index
	var st_diag: List[ParseDiagnostic] = type_step.diagnostics

	equal_step: ParseSymbolStep = expect_symbol(state, st, EqualSymbol)
	equal_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
		state,
		st_diag,
		equal_step,
		EqualSymbol,
		"expected `=` after variable declaration",
	)
	value_step: ParseExprStep = parse_assignment_value_expr(
		state,
		equal_step.index,
		equal_step_diagnostics,
		start_span,
	)

	{
		index = value_step.index,
		diagnostics = value_step.diagnostics,
		value = ParsedVarDeclExpr(
			name_step.value,
			type_step.value,
			value_step.value,
			True,
			location_cover(start_span, parsed_expr_location(value_step.value)),
		)
	}


private pure func parse_named_assignment_tail(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	name: ParsedIdentifier,
	type_expr: Option[ParsedTypeExpr],
) -> ParseExprStep:
	if current_is_symbol(state, index, EqualSymbol):
		value_step: ParseExprStep = parse_assignment_value_expr(
			state,
			advance_parser(state, index),
			diagnostics,
			name.span,
		)

		match type_expr:
			Some(ty):
				{
					index = value_step.index,
					diagnostics = value_step.diagnostics,
					value = ParsedVarDeclExpr(
						name,
						Some(ty),
						value_step.value,
						False,
						location_cover(name.span, parsed_expr_location(value_step.value)),
					)
				}
			None:
				{
					index = value_step.index,
					diagnostics = value_step.diagnostics,
					value = ParsedAssignExpr(
						name,
						value_step.value,
						location_cover(name.span, parsed_expr_location(value_step.value)),
					)
				}
	else if current_is_symbol(state, index, QuestionEqualsSymbol):
		value_step: ParseExprStep = parse_assignment_value_expr(
			state,
			advance_parser(state, index),
			diagnostics,
			name.span,
		)

		if name.text == "_":
			next_state: Int = value_step.index
			next_state_diag: List[ParseDiagnostic] = add_expected_error(
				state,
				value_step.diagnostics,
				name.span,
				"`?=` cannot bind to `_`; use a name for the unwrapped value",
				["binding name"],
				None,
			)

			{
				index = next_state,
				diagnostics = next_state_diag,
				value = ParsedQuestionBindExpr(
					name,
					type_expr,
					value_step.value,
					location_cover(name.span, parsed_expr_location(value_step.value)),
				)
			}
		else:
			{
				index = value_step.index,
				diagnostics = value_step.diagnostics,
				value = ParsedQuestionBindExpr(
					name,
					type_expr,
					value_step.value,
					location_cover(name.span, parsed_expr_location(value_step.value)),
				)
			}
	else:
		match current_compound_assign_op(state, index):
			Some(op):
				value_step: ParseExprStep = parse_assignment_value_expr(
					state,
					advance_parser(state, index),
					diagnostics,
					name.span,
				)

				{
					index = value_step.index,
					diagnostics = value_step.diagnostics,
					value = ParsedCompoundAssignExpr(
						name,
						op,
						value_step.value,
						location_cover(name.span, parsed_expr_location(value_step.value)),
					)
				}
			None:
				next_state: Int = index
				next_state_diag: List[ParseDiagnostic] = add_expected_error(
					state,
					diagnostics,
					current_location(
						state,
						index,
					),
					"expected assignment operator",
					["=", "?=", "+=", "-=", "*=", "/="],
					None,
				)

				{
					index = next_state,
					diagnostics = next_state_diag,
					value = ParsedMissingExpr(name.span)
				}


private pure func current_is_tuple_destruct_assignment_start(
	state: ParserInput,
	start_index: Int,
) -> Bool:
	if not current_is_symbol(state, start_index, LeftParenSymbol):
		False
	else:
		var index: Int = start_index + 1
		var saw_comma: Bool = False
		var expecting_name: Bool = True
		var saw_close: Bool = False
		var valid: Bool = True

		while valid:
			tag: TokenTag = tag_at(state, index)

			if expecting_name:
				if token_is_tuple_binder_name_at(state, index):
					index += 1
					expecting_name = False
				else:
					valid = False
			else:
				match tag:
					SymbolTag:
						symbol: Symbol = current_symbol(state, index)

						if symbol == CommaSymbol:
							saw_comma = True
							index += 1

							if current_is_symbol(state, index, RightParenSymbol):
								saw_close = True
								break
							else:
								expecting_name = True
						else if symbol == RightParenSymbol:
							saw_close = True
							break
						else:
							valid = False
					_:
						valid = False

		valid and saw_close and saw_comma and current_is_symbol(state, index + 1, EqualSymbol)


private pure func parse_tuple_destruct_assignment(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseExprStep:
	start_span: SourceLocation = current_location(state, index)
	binder_step: ParseTupleBinderStep = parse_tuple_binder_after_left_paren(
		state,
		advance_parser(state, index),
		diagnostics,
		start_span,
		TupleBinderNamesOrUnderscore,
		"tuple destructuring name",
		"expected `, ` between tuple destructuring names",
		"expected tuple destructuring name after `, `",
		"expected `)` after tuple destructuring names",
	)
	equal_step: ParseSymbolStep = expect_symbol(state, binder_step.index, EqualSymbol)
	equal_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
		state,
		binder_step.diagnostics,
		equal_step,
		EqualSymbol,
		"expected `=` after tuple destructuring",
	)
	value_step: ParseExprStep = parse_assignment_value_expr(
		state,
		equal_step.index,
		equal_step_diagnostics,
		start_span,
	)

	{
		index = value_step.index,
		diagnostics = value_step.diagnostics,
		value = ParsedTupleDestructExpr(
			binder_step.values,
			value_step.value,
			location_cover(start_span, parsed_expr_location(value_step.value)),
		)
	}


private pure func func_keyword_starts_nested_function_decl(state: ParserInput, index: Int) -> Bool:
	(
		current_is_keyword(state, index, FuncKeyword)
		and not current_is_symbol(state, index + 1, LeftParenSymbol)
	)


private pure func current_starts_nested_function_decl(state: ParserInput, index: Int) -> Bool:
	if current_is_keyword(state, index, FuncKeyword):
		func_keyword_starts_nested_function_decl(state, index)
	else if current_is_keyword(state, index, PureKeyword):
		(
			current_is_keyword(state, index + 1, FuncKeyword)
			and not current_is_symbol(state, index + 2, LeftParenSymbol)
		)
	else:
		False


private pure func parse_nested_function_decl_expr(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseExprStep:
	start_span: SourceLocation = current_location(state, index)
	var st: Int = index
	var st_diag: List[ParseDiagnostic] = diagnostics
	var is_pure: Bool = False

	if current_is_keyword(state, st, PureKeyword):
		is_pure = True
		st = advance_parser(state, st)

	function_step: ParseFunctionStep = parse_function_decl_value(
		state,
		st,
		st_diag,
		None,
		is_pure,
		[],
		start_span,
	)

	{
		index = function_step.index,
		diagnostics = function_step.diagnostics,
		value = ParsedFunctionDeclExpr(function_step.value)
	}


private pure func parse_assignment_after_expression(
	state: ParserInput,
	expr_step: ParseExprStep,
) -> ParseExprStep:
	if current_is_symbol(state, expr_step.index, EqualSymbol):
		match expr_step.value:
			ParsedNameExpr(name):
				value_step: ParseExprStep = parse_assignment_value_expr(
					state,
					advance_parser(state, expr_step.index),
					expr_step.diagnostics,
					name.span,
				)

				{
					index = value_step.index,
					diagnostics = value_step.diagnostics,
					value = ParsedAssignExpr(
						name,
						value_step.value,
						location_cover(name.span, parsed_expr_location(value_step.value)),
					)
				}
			ParsedSubscriptExpr(target, indices, left_span):
				value_step: ParseExprStep = parse_assignment_value_expr(
					state,
					advance_parser(state, expr_step.index),
					expr_step.diagnostics,
					left_span,
				)

				{
					index = value_step.index,
					diagnostics = value_step.diagnostics,
					value = ParsedSubscriptAssignExpr(
						target,
						indices,
						value_step.value,
						location_cover(left_span, parsed_expr_location(value_step.value)),
					)
				}
			ParsedFieldAccessExpr(_, _, left_span):
				value_step: ParseExprStep = parse_assignment_value_expr(
					state,
					advance_parser(state, expr_step.index),
					expr_step.diagnostics,
					left_span,
				)
				next_state: Int = value_step.index
				next_state_diag: List[ParseDiagnostic] = add_expected_error(
					state,
					value_step.diagnostics,
					left_span,
					(
						"Field assignment is not supported. Use record update syntax: { record | field = "
						+ "value }"
					),
					["record update"],
					None,
				)

				{
					index = next_state,
					diagnostics = next_state_diag,
					value = ParsedMissingExpr(left_span)
				}
			_:
				expr_step
	else:
		expr_step


---
Whether the current token is a reserved keyword followed by a binding tail
(`: Type =`, `=`, `?=`, or a compound assignment).

Such a keyword sits in a name position rather than starting a keyword construct
such as `if` or `match`. Routing it to the binder parser reports the
reserved-keyword rule once and keeps the rest of the statement parsing.
---
private pure func current_reserved_keyword_starts_binding(state: ParserInput, index: Int) -> Bool:
	match current_tag(state, index):
		KeywordTag:
			if keyword_is_reserved_name(current_keyword(state, index)):
				after_name: Int = advance_parser(state, index)

				(
					current_can_start_assignment_tail(state, after_name)
					or (
						current_is_symbol(state, after_name, ColonSymbol)
						and colon_starts_typed_assignment(state, after_name)
					)
				)
			else:
				False
		_:
			False


private pure func current_token_can_start_named_statement(state: ParserInput, index: Int) -> Bool:
	match current_tag(state, index):
		IdentifierTag:
			True
		KeywordTag:
			match soft_keyword_identifier_text(current_keyword(state, index)):
				Some(_):
					True
				None:
					current_reserved_keyword_starts_binding(state, index)
		_:
			False


private pure func parse_named_statement_or_expression(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseExprStep:
	if current_token_can_start_named_statement(state, index):
		name_step: ParseIdentifierStep = parse_binder_identifier_expected(
			state,
			index,
			diagnostics,
			"statement name",
		)
		var st: Int = name_step.index
		var st_diag: List[ParseDiagnostic] = name_step.diagnostics

		if current_is_symbol(state, st, ColonSymbol) and colon_starts_typed_assignment(state, st):
			type_step: ParseOptionalTypeStep = parse_optional_type_annotation(state, st, st_diag)
			parse_named_assignment_tail(
				state,
				type_step.index,
				type_step.diagnostics,
				name_step.value,
				type_step.value,
			)
		else if current_can_start_assignment_tail(state, st):
			parse_named_assignment_tail(state, st, st_diag, name_step.value, None)
		else:
			parse_assignment_after_expression(
				state,
				parse_expression(state, index, diagnostics, PREC_LOWEST),
			)
	else:
		is_underscore: Bool = match current_tag(state, index):
			SymbolTag:
				current_symbol(state, index) == UnderscoreSymbol
			_:
				False

		if is_underscore:
			name_step: ParseIdentifierStep = parse_binder_identifier_expected(
				state,
				index,
				diagnostics,
				"statement name",
			)
			var st: Int = name_step.index
			var st_diag: List[ParseDiagnostic] = name_step.diagnostics

			if current_can_start_assignment_tail(state, st):
				parse_named_assignment_tail(state, st, st_diag, name_step.value, None)
			else:
				parse_expression(state, index, diagnostics, PREC_LOWEST)
		else:
			parse_assignment_after_expression(
				state,
				parse_expression(state, index, diagnostics, PREC_LOWEST),
			)


private pure func parse_statement(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseExprStep:
	step: ParseExprStep = if current_starts_nested_function_decl(state, index):
		parse_nested_function_decl_expr(state, index, diagnostics)
	else if current_is_keyword(state, index, VarKeyword):
		parse_var_decl_statement(state, index, diagnostics)
	else if current_is_keyword(state, index, WhileKeyword):
		parse_while_expr(state, index, diagnostics)
	else if current_is_keyword(state, index, ForKeyword):
		parse_for_expr_with_header_span(
			state,
			index,
			diagnostics,
			current_location(state, index),
		)
	else if current_is_tuple_destruct_assignment_start(state, index):
		parse_tuple_destruct_assignment(state, index, diagnostics)
	else:
		parse_named_statement_or_expression(state, index, diagnostics)

	{
		index = consume_leading_dot_postfix_continuation_dedent(state, step.index, step.value),
		diagnostics = step.diagnostics,
		value = step.value
	}


private pure func parse_lambda_body(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	body_intro_start_line: Int,
	block_anchor_span: SourceLocation,
) -> ParseExprStep:
	if current_is_newline(state, index):
		parse_block_after_colon(state, index, diagnostics, block_anchor_span)
	else if (
		state.start_lines.get_or(index, 0) > body_intro_start_line
		and current_token_is_indented_past(state, index, block_anchor_span)
	):
		parse_indented_block_body(state, index, diagnostics, block_anchor_span)
	else:
		parse_expression(state, index, diagnostics, PREC_LOWEST)


private pure func parse_lambda_expr_with_header_span(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	header_span: SourceLocation,
) -> ParseExprStep:
	start_span: SourceLocation = current_location(state, index)
	var st: Int = index
	var st_diag: List[ParseDiagnostic] = diagnostics
	var is_pure: Bool = False

	if current_is_keyword(state, st, PureKeyword):
		is_pure = True
		st = advance_parser(state, st)
		__step_13: ParserStep = expect_keyword(state, st, FuncKeyword)
		__step_13_diagnostics: List[ParseDiagnostic] = expect_keyword_diagnostics(
			state,
			st_diag,
			__step_13,
			"func",
			"expected `func` after `pure` in lambda expression",
		)
		st = __step_13.index
		st_diag = __step_13_diagnostics
	else:
		__step_14: ParserStep = expect_keyword(state, st, FuncKeyword)
		__step_14_diagnostics: List[ParseDiagnostic] = expect_keyword_diagnostics(
			state,
			st_diag,
			__step_14,
			"func",
			"expected `func` before lambda",
		)
		st = __step_14.index
		st_diag = __step_14_diagnostics

	left_step: ParseSymbolStep = expect_symbol(state, st, LeftParenSymbol)
	left_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
		state,
		st_diag,
		left_step,
		LeftParenSymbol,
		"expected `(` after lambda `func`",
	)
	st = left_step.index
	st_diag = left_step_diagnostics

	params_step: ParseLambdaParamsStep = if left_step.matched:
		parse_lambda_params_after_left_paren(state, st, st_diag)
	else:
		{
			index = st,
			diagnostics = st_diag,
			values = []
		}

	st = params_step.index
	st_diag = params_step.diagnostics
	var return_type: Option[ParsedTypeExpr] = None

	if current_is_symbol(state, st, ArrowSymbol):
		type_step: ParseTypeStep = parse_type_expr(
			state,
			advance_parser(state, st),
			st_diag,
		)
		return_type = Some(type_step.value)
		st = type_step.index
		st_diag = type_step.diagnostics

	colon_step: ParseSymbolStep = expect_symbol(state, st, ColonSymbol)
	colon_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
		state,
		st_diag,
		colon_step,
		ColonSymbol,
		"expected `:` before lambda body",
	)
	body_step: ParseExprStep = parse_lambda_body(
		state,
		colon_step.index,
		colon_step_diagnostics,
		state.start_lines.get_or(colon_step.span.first, 0),
		header_span,
	)

	{
		index = body_step.index,
		diagnostics = body_step.diagnostics,
		value = ParsedLambdaExpr(
			is_pure,
			params_step.values,
			return_type,
			body_step.value,
			location_cover(start_span, parsed_expr_location(body_step.value)),
		)
	}


private pure func parse_tuple_tail(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	first_item: ParsedExpr,
	start_span: SourceLocation,
) -> ParseExprStep:
	var st: Int = index
	var st_diag: List[ParseDiagnostic] = diagnostics
	var items: List[ParsedExpr] = [first_item]
	var parsing_items: Bool = True

	while parsing_items and not current_is_eof(state, st):
		if current_is_symbol(state, st, CommaSymbol):
			st = advance_parser(state, st)

			if current_is_symbol(state, st, RightParenSymbol):
				parsing_items = False
			else:
				item_step: ParseExprStep = parse_expression_with_header_span(
					state,
					st,
					st_diag,
					PREC_LOWEST,
					start_span,
				)
				items = items.append(item_step.value)
				st = item_step.index
				st_diag = item_step.diagnostics
		else:
			parsing_items = False

	right_step: ParseSymbolStep = expect_symbol(state, st, RightParenSymbol)
	right_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
		state,
		st_diag,
		right_step,
		RightParenSymbol,
		"expected `)` after tuple expression",
	)
	st = right_step.index
	st_diag = right_step_diagnostics

	end_span: SourceLocation = if right_step.matched:
		materialize_location(state, right_step.span)
	else:
		parsed_expr_location(first_item)

	if items.length() > 4:
		st_diag = add_tuple_arity_error(
			state,
			st_diag,
			location_cover(start_span, end_span),
		)

	{
		index = st,
		diagnostics = st_diag,
		value = ParsedTupleExpr(
			items,
			location_cover(start_span, end_span),
		)
	}


private pure func parse_parenthesized_or_tuple_expr(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	start_span: SourceLocation,
) -> ParseExprStep:
	if current_is_symbol(state, index, RightParenSymbol):
		right_step: ParseSymbolStep = expect_symbol(state, index, RightParenSymbol)
		right_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
			state,
			diagnostics,
			right_step,
			RightParenSymbol,
			"expected `)` after void expression",
		)

		{
			index = right_step.index,
			diagnostics = right_step_diagnostics,
			value = ParsedVoidExpr(
				location_cover(
					start_span,
					materialize_location(state, right_step.span),
				),
			)
		}
	else:
		expr_step: ParseExprStep = parse_expression_with_header_span(
			state,
			index,
			diagnostics,
			PREC_LOWEST,
			start_span,
		)

		if current_is_symbol(state, expr_step.index, CommaSymbol):
			parse_tuple_tail(
				state,
				expr_step.index,
				expr_step.diagnostics,
				expr_step.value,
				start_span,
			)
		else:
			right_step: ParseSymbolStep = expect_symbol(state, expr_step.index, RightParenSymbol)
			right_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
				state,
				expr_step.diagnostics,
				right_step,
				RightParenSymbol,
				"expected `)` after expression",
			)

			-- Grouping parentheses have no AST node; widen the enclosed
			-- expression to both delimiters so its span reports the real
			-- source extent, matching tuple and void expressions.
			if right_step.matched:
				{
					index = right_step.index,
					diagnostics = right_step_diagnostics,
					value = parsed_expr_with_location(
						expr_step.value,
						location_cover(
							start_span,
							materialize_location(state, right_step.span),
						),
					)
				}
			else:
				{
					index = right_step.index,
					diagnostics = right_step_diagnostics,
					value = expr_step.value
				}


private pure func next_is_symbol(state: ParserInput, index: Int, symbol: Symbol) -> Bool:
	match tag_at(state, index + 1):
		SymbolTag:
			current_symbol(state, index + 1) == symbol
		_:
			False


private pure func current_can_start_record_expr_field(state: ParserInput, index: Int) -> Bool:
	match current_tag(state, index):
		IdentifierTag:
			next_is_symbol(state, index, EqualSymbol)
		KeywordTag:
			(
				soft_keyword_identifier_text(current_keyword(state, index)).is_some()
				and next_is_symbol(state, index, EqualSymbol)
			)
		_:
			False


private pure func parse_record_expr_field(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseRecordExprFieldStep:
	name_step: ParseIdentifierStep = parse_identifier_expected(
		state,
		index,
		diagnostics,
		"record field",
	)
	equal_step: ParseSymbolStep = expect_symbol(state, name_step.index, EqualSymbol)
	equal_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
		state,
		name_step.diagnostics,
		equal_step,
		EqualSymbol,
		"expected `=` after record field name",
	)
	value_step: ParseExprStep = parse_expression(
		state,
		equal_step.index,
		equal_step_diagnostics,
		PREC_LOWEST,
	)

	{
		index = value_step.index,
		diagnostics = value_step.diagnostics,
		value = {
			name = name_step.value,
			value = value_step.value,
			span = location_cover(name_step.value.span, parsed_expr_location(value_step.value))
		}
	}


private pure func parse_record_expr_field_list_until_right_brace(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	allow_empty: Bool,
) -> ParseRecordExprFieldListStep:
	var st: Int = index
	var st_diag: List[ParseDiagnostic] = diagnostics
	var fields: List[ParsedRecordExprField] = []

	if allow_empty and current_is_symbol(state, st, RightBraceSymbol):
		{
			index = st,
			diagnostics = st_diag,
			values = fields
		}
	else:
		var parsing_fields: Bool = True

		while parsing_fields and not current_is_eof(state, st):
			field_step: ParseRecordExprFieldStep = parse_record_expr_field(state, st, st_diag)
			fields = fields.append(field_step.value)
			st = field_step.index
			st_diag = field_step.diagnostics

			if current_is_symbol(state, st, CommaSymbol):
				st = advance_parser(state, st)

				if current_is_symbol(state, st, RightBraceSymbol):
					parsing_fields = False
			else:
				parsing_fields = False

		{
			index = st,
			diagnostics = st_diag,
			values = fields
		}


private pure func parse_record_literal_expr(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	start_span: SourceLocation,
) -> ParseExprStep:
	fields_step: ParseRecordExprFieldListStep = parse_record_expr_field_list_until_right_brace(
		state,
		index,
		diagnostics,
		True,
	)
	right_step: ParseSymbolStep = expect_symbol(state, fields_step.index, RightBraceSymbol)
	right_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
		state,
		fields_step.diagnostics,
		right_step,
		RightBraceSymbol,
		"expected `}` after record literal",
	)

	end_span: SourceLocation = if right_step.matched:
		materialize_location(state, right_step.span)
	else:
		start_span

	{
		index = right_step.index,
		diagnostics = right_step_diagnostics,
		value = ParsedRecordExpr(
			fields_step.values,
			location_cover(start_span, end_span),
		)
	}


private pure func parse_dict_entry_after_key(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	key: ParsedExpr,
) -> ParseDictEntryStep:
	arrow_step: ParseSymbolStep = expect_symbol(state, index, FatArrowSymbol)
	arrow_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
		state,
		diagnostics,
		arrow_step,
		FatArrowSymbol,
		"expected `=>` between dict key and value",
	)
	value_step: ParseExprStep = parse_expression(
		state,
		arrow_step.index,
		arrow_step_diagnostics,
		PREC_LOWEST,
	)

	{
		index = value_step.index,
		diagnostics = value_step.diagnostics,
		value = {
			key = key,
			value = value_step.value,
			span = location_cover(parsed_expr_location(key), parsed_expr_location(value_step.value))
		}
	}


private pure func parse_dict_literal_tail(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	first_key: ParsedExpr,
	start_span: SourceLocation,
) -> ParseExprStep:
	first_entry_step: ParseDictEntryStep = parse_dict_entry_after_key(
		state,
		index,
		diagnostics,
		first_key,
	)
	var st: Int = first_entry_step.index
	var st_diag: List[ParseDiagnostic] = first_entry_step.diagnostics
	var entries: List[ParsedDictEntry] = [first_entry_step.value]
	var parsing_entries: Bool = True

	while parsing_entries and not current_is_eof(state, st):
		if current_is_symbol(state, st, CommaSymbol):
			st = advance_parser(state, st)

			if current_is_symbol(state, st, RightBraceSymbol):
				parsing_entries = False
			else:
				key_step: ParseExprStep = parse_expression(state, st, st_diag, PREC_LOWEST)
				entry_step: ParseDictEntryStep = parse_dict_entry_after_key(
					state,
					key_step.index,
					key_step.diagnostics,
					key_step.value,
				)
				entries = entries.append(entry_step.value)
				st = entry_step.index
				st_diag = entry_step.diagnostics
		else:
			parsing_entries = False

	right_step: ParseSymbolStep = expect_symbol(state, st, RightBraceSymbol)
	right_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
		state,
		st_diag,
		right_step,
		RightBraceSymbol,
		"expected `}` after dict literal",
	)

	end_span: SourceLocation = if right_step.matched:
		materialize_location(state, right_step.span)
	else:
		parsed_expr_location(first_key)

	{
		index = right_step.index,
		diagnostics = right_step_diagnostics,
		value = ParsedDictExpr(
			entries,
			location_cover(start_span, end_span),
		)
	}


private pure func parse_vector_literal_tail(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	first_item: ParsedExpr,
	start_span: SourceLocation,
) -> ParseExprStep:
	var st: Int = index
	var st_diag: List[ParseDiagnostic] = diagnostics
	var items: List[ParsedExpr] = [first_item]
	var parsing_items: Bool = True

	while parsing_items and not current_is_eof(state, st):
		if current_is_symbol(state, st, CommaSymbol):
			st = advance_parser(state, st)

			if current_is_symbol(state, st, RightBraceSymbol):
				parsing_items = False
			else:
				item_step: ParseExprStep = parse_expression(state, st, st_diag, PREC_LOWEST)
				items = items.append(item_step.value)
				st = item_step.index
				st_diag = item_step.diagnostics
		else:
			parsing_items = False

	right_step: ParseSymbolStep = expect_symbol(state, st, RightBraceSymbol)
	right_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
		state,
		st_diag,
		right_step,
		RightBraceSymbol,
		"expected `}` after vector literal",
	)

	end_span: SourceLocation = if right_step.matched:
		materialize_location(state, right_step.span)
	else:
		parsed_expr_location(first_item)

	{
		index = right_step.index,
		diagnostics = right_step_diagnostics,
		value = ParsedVectorExpr(
			items,
			location_cover(start_span, end_span),
		)
	}


private pure func parse_record_update_tail(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	base: ParsedExpr,
	start_span: SourceLocation,
) -> ParseExprStep:
	pipe_step: ParseSymbolStep = expect_symbol(state, index, PipeSymbol)
	pipe_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
		state,
		diagnostics,
		pipe_step,
		PipeSymbol,
		"expected `|` before record update fields",
	)
	fields_step: ParseRecordExprFieldListStep = parse_record_expr_field_list_until_right_brace(
		state,
		pipe_step.index,
		pipe_step_diagnostics,
		False,
	)
	right_step: ParseSymbolStep = expect_symbol(state, fields_step.index, RightBraceSymbol)
	right_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
		state,
		fields_step.diagnostics,
		right_step,
		RightBraceSymbol,
		"expected `}` after record update",
	)

	end_span: SourceLocation = if right_step.matched:
		materialize_location(state, right_step.span)
	else:
		parsed_expr_location(base)

	{
		index = right_step.index,
		diagnostics = right_step_diagnostics,
		value = ParsedRecordUpdateExpr(
			base,
			fields_step.values,
			location_cover(start_span, end_span),
		)
	}


private pure func parse_braced_expr(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	start_span: SourceLocation,
) -> ParseExprStep:
	st: Int = advance_parser(state, index)
	st_diag: List[ParseDiagnostic] = diagnostics

	if (
		current_is_symbol(state, st, RightBraceSymbol)
		or current_can_start_record_expr_field(state, st)
	):
		parse_record_literal_expr(state, st, st_diag, start_span)
	else:
		first_step: ParseExprStep = parse_expression(state, st, st_diag, PREC_LOWEST)

		if current_is_symbol(state, first_step.index, FatArrowSymbol):
			parse_dict_literal_tail(
				state,
				first_step.index,
				first_step.diagnostics,
				first_step.value,
				start_span,
			)
		else if current_is_symbol(state, first_step.index, PipeSymbol):
			parse_record_update_tail(
				state,
				first_step.index,
				first_step.diagnostics,
				first_step.value,
				start_span,
			)
		else:
			parse_vector_literal_tail(
				state,
				first_step.index,
				first_step.diagnostics,
				first_step.value,
				start_span,
			)


private pure func parse_builtin_expr(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseExprStep:
	start_span: SourceLocation = current_location(state, index)
	var st: Int = advance_parser(state, index)
	var st_diag: List[ParseDiagnostic] = diagnostics
	var name: Option[String] = None
	var end_span: SourceLocation = start_span

	if current_is_symbol(state, st, LeftParenSymbol):
		st = advance_parser(state, st)

		match current_tag(state, st):
			StringLiteralTag:
				name = Some(current_string_literal_text(state, st))
				end_span = current_location(state, st)
				st = advance_parser(state, st)
			_:
				st_diag = add_expected_error(
					state,
					st_diag,
					current_location(state, st),
					"expected builtin name",
					["string literal"],
					Some("write builtin(\"runtime_helper_name\") or bare builtin"),
				)

				if not current_is_soft_boundary(state, st):
					st = advance_parser(state, st)

		right_step: ParseSymbolStep = expect_symbol(state, st, RightParenSymbol)
		right_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
			state,
			st_diag,
			right_step,
			RightParenSymbol,
			"expected `)` after builtin name",
		)
		st = right_step.index
		st_diag = right_step_diagnostics

		if right_step.matched:
			end_span = materialize_location(state, right_step.span)

	{
		index = st,
		diagnostics = st_diag,
		value = ParsedBuiltinExpr(
			name,
			location_cover(start_span, end_span),
		)
	}


private pure func parse_opaque_conversion_expr(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	is_into: Bool,
) -> ParseExprStep:
	start_span: SourceLocation = current_location(state, index)
	type_step: ParseTypeStep = parse_type_expr(
		state,
		advance_parser(state, index),
		diagnostics,
	)
	left_step: ParseSymbolStep = expect_symbol(state, type_step.index, LeftParenSymbol)
	left_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
		state,
		type_step.diagnostics,
		left_step,
		LeftParenSymbol,
		"expected `(` after opaque conversion type",
	)
	value_step: ParseExprStep = parse_expression(
		state,
		left_step.index,
		left_step_diagnostics,
		PREC_LOWEST,
	)
	right_step: ParseSymbolStep = expect_symbol(state, value_step.index, RightParenSymbol)
	right_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
		state,
		value_step.diagnostics,
		right_step,
		RightParenSymbol,
		"expected `)` after opaque conversion value",
	)

	end_span: SourceLocation = if right_step.matched:
		materialize_location(state, right_step.span)
	else:
		parsed_expr_location(value_step.value)

	value: ParsedExpr = if is_into:
		ParsedOpaqueIntoExpr(
			type_step.value,
			value_step.value,
			location_cover(start_span, end_span),
		)
	else:
		ParsedOpaqueFromExpr(
			type_step.value,
			value_step.value,
			location_cover(start_span, end_span),
		)

	{
		index = right_step.index,
		diagnostics = right_step_diagnostics,
		value = value
	}


-- COMPAT-001: reject the removed spelling with its explicit replacement. Drop
-- this diagnostic-only lookahead after one preview/bootstrap migration cycle.
private pure func starts_removed_opaque_conversion(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> Bool:
	type_step: ParseTypeStep = parse_type_expr(
		state,
		advance_parser(state, index),
		diagnostics,
	)
	(
		type_step.diagnostics.length() == diagnostics.length()
		and current_is_symbol(state, type_step.index, LeftParenSymbol)
	)


private pure func reject_removed_opaque_conversion(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	is_into: Bool,
) -> ParseExprStep:
	step: ParseExprStep = parse_opaque_conversion_expr(state, index, diagnostics, is_into)

	removed_keyword: String = if is_into:
		"into"
	else:
		"from"

	explicit_keyword: String = if is_into:
		"into_opaque"
	else:
		"from_opaque"

	{ step | diagnostics = add_expected_error(
			state,
			step.diagnostics,
			current_location(state, index),
			"`" + removed_keyword + " Type(...)` opaque conversions have been removed",
			[explicit_keyword],
			Some("use `" + explicit_keyword + " Type(...)` instead"),
		) }


private pure func parse_primary_expr_missing(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	span: SourceLocation,
) -> ParseExprStep:
	next_state_diag: List[ParseDiagnostic] = add_expected_error(
		state,
		diagnostics,
		span,
		"expected expression",
		[EXPECTED_EXPRESSION],
		None,
	)

	recovery_state: Int = if current_is_soft_boundary(state, index):
		index
	else:
		advance_parser(state, index)

	{
		index = recovery_state,
		diagnostics = next_state_diag,
		value = ParsedMissingExpr(span)
	}


private pure func parse_primary_expr(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseExprStep:
	span: SourceLocation = current_location(state, index)

	match current_tag(state, index):
		IdentifierTag:
			text: String = current_text(state, index)

			if text == "into" and starts_removed_opaque_conversion(state, index, diagnostics):
				reject_removed_opaque_conversion(state, index, diagnostics, True)
			else:
				{
					index = advance_parser(state, index),
					diagnostics = diagnostics,
					value = ParsedNameExpr(parsed_identifier(text, span))
				}
		IntLiteralTag:
			{
				index = advance_parser(state, index),
				diagnostics = diagnostics,
				value = ParsedIntLiteralExpr(
					current_text(state, index),
					span,
				)
			}
		FloatLiteralTag:
			{
				index = advance_parser(state, index),
				diagnostics = diagnostics,
				value = ParsedFloatLiteralExpr(
					current_text(state, index),
					span,
				)
			}
		StringLiteralTag:
			kind: StringLiteralKind = current_string_literal_kind(state, index)
			text: String = current_string_literal_text(state, index)

			expr_value: ParsedExpr = if (
				kind == InterpolatedStringLiteral
				or kind == InterpolatedPipeStringLiteral
			):
				ParsedStringInterpolationExpr(text, kind == InterpolatedPipeStringLiteral, span)
			else:
				ParsedStringLiteralExpr(text, parsed_string_literal_form(kind), span)

			{
				index = advance_parser(state, index),
				diagnostics = diagnostics,
				value = expr_value
			}
		CharLiteralTag:
			{
				index = advance_parser(state, index),
				diagnostics = diagnostics,
				value = ParsedCharLiteralExpr(
					current_char_code_point(state, index),
					span,
				)
			}
		KeywordTag:
			match current_keyword(state, index):
				TrueKeyword:
					{
						index = advance_parser(state, index),
						diagnostics = diagnostics,
						value = ParsedBoolLiteralExpr(True, span)
					}
				FalseKeyword:
					{
						index = advance_parser(state, index),
						diagnostics = diagnostics,
						value = ParsedBoolLiteralExpr(False, span)
					}
				AfterKeyword:
					{
						index = advance_parser(state, index),
						diagnostics = diagnostics,
						value = ParsedNameExpr(parsed_identifier("after", span))
					}
				SealedKeyword:
					{
						index = advance_parser(state, index),
						diagnostics = diagnostics,
						value = ParsedNameExpr(parsed_identifier("sealed", span))
					}
				BreakKeyword:
					{
						index = advance_parser(state, index),
						diagnostics = diagnostics,
						value = ParsedBreakExpr(span)
					}
				ContinueKeyword:
					{
						index = advance_parser(state, index),
						diagnostics = diagnostics,
						value = ParsedContinueExpr(span)
					}
				VoidKeyword:
					{
						index = advance_parser(state, index),
						diagnostics = diagnostics,
						value = ParsedVoidExpr(span)
					}
				BuiltinKeyword:
					parse_builtin_expr(state, index, diagnostics)
				IntoOpaqueKeyword:
					parse_opaque_conversion_expr(state, index, diagnostics, True)
				FromKeyword:
					if starts_removed_opaque_conversion(state, index, diagnostics):
						reject_removed_opaque_conversion(state, index, diagnostics, False)
					else:
						{
							index = advance_parser(state, index),
							diagnostics = diagnostics,
							value = ParsedNameExpr(parsed_identifier("from", span))
						}
				FromOpaqueKeyword:
					parse_opaque_conversion_expr(state, index, diagnostics, False)
				FuncKeyword:
					parse_lambda_expr_with_header_span(state, index, diagnostics, span)
				PureKeyword:
					parse_lambda_expr_with_header_span(state, index, diagnostics, span)
				IfKeyword:
					parse_if_expr_with_header_span(state, index, diagnostics, span)
				MatchKeyword:
					parse_match_expr_with_header_span(state, index, diagnostics, span)
				SelectKeyword:
					parse_select_expr_with_header_span(state, index, diagnostics, span)
				DebugKeyword:
					if next_is_symbol(state, index, DotSymbol):
						{
							index = advance_parser(state, index),
							diagnostics = diagnostics,
							value = ParsedNameExpr(parsed_identifier("debug", span))
						}
					else:
						parse_debug_block_expr(state, index, diagnostics)
				WithKeyword:
					parse_with_expr(state, index, diagnostics)
				ConcurrentKeyword:
					parse_concurrent_block_expr(state, index, diagnostics)
				_:
					parse_primary_expr_missing(state, index, diagnostics, span)
		SymbolTag:
			match current_symbol(state, index):
				LeftParenSymbol:
					parse_parenthesized_or_tuple_expr(
						state,
						advance_parser(state, index),
						diagnostics,
						span,
					)
				LeftBracketSymbol:
					start_span: SourceLocation = span
					items_step: ParseExprListStep = parse_expr_list_until(
						state,
						advance_parser(state, index),
						diagnostics,
						RightBracketSymbol,
						True,
						start_span,
					)
					right_step: ParseSymbolStep = expect_symbol(
						state,
						items_step.index,
						RightBracketSymbol,
					)
					right_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
						state,
						items_step.diagnostics,
						right_step,
						RightBracketSymbol,
						"expected `]` after list literal",
					)

					end_span: SourceLocation = if right_step.matched:
						materialize_location(state, right_step.span)
					else:
						start_span

					{
						index = right_step.index,
						diagnostics = right_step_diagnostics,
						value = ParsedListExpr(
							items_step.values,
							location_cover(start_span, end_span),
						)
					}
				LeftBraceSymbol:
					parse_braced_expr(state, index, diagnostics, span)
				UnderscoreSymbol:
					{
						index = advance_parser(state, index),
						diagnostics = diagnostics,
						value = ParsedVoidExpr(span)
					}
				_:
					parse_primary_expr_missing(state, index, diagnostics, span)
		_:
			parse_primary_expr_missing(state, index, diagnostics, span)


private pure func postfix_continuation_after_newline(
	state: ParserInput,
	index: Int,
) -> ParsePostfixContinuationStep:
	if current_is_newline(state, index):
		after_newline: Int = advance_parser(state, index)

		if current_is_indent(state, after_newline):
			after_indent: Int = advance_parser(state, after_newline)

			if current_is_symbol(state, after_indent, DotSymbol):
				{
					index = after_indent,
					opened_indent = True
				}
			else:
				{
					index = index,
					opened_indent = False
				}
		else if current_is_symbol(state, after_newline, DotSymbol):
			{
				index = after_newline,
				opened_indent = False
			}
		else:
			{
				index = index,
				opened_indent = False
			}
	else:
		{
			index = index,
			opened_indent = False
		}


private pure func parse_postfix_expr(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	left: ParsedExpr,
	header_span: SourceLocation,
) -> ParseExprStep:
	var st: Int = index
	var st_diag: List[ParseDiagnostic] = diagnostics
	var expr: ParsedExpr = left
	var parsing_postfix: Bool = True
	var continuation_indents: Int = 0

	while parsing_postfix and not current_is_eof(state, st):
		if continuation_indents > 0 and current_is_dedent(state, st):
			st = advance_parser(state, st)
			continuation_indents -= 1

			if continuation_indents == 0:
				parsing_postfix = False
		else if continuation_indents > 0 and current_is_newline(state, st):
			after_newline: Int = advance_parser(state, st)
			after_newline_diag: List[ParseDiagnostic] = st_diag

			if current_is_dedent(state, after_newline):
				st = advance_parser(state, after_newline)
				st_diag = after_newline_diag
				continuation_indents -= 1

				if continuation_indents == 0:
					parsing_postfix = False
			else:
				continuation_step: ParsePostfixContinuationStep = postfix_continuation_after_newline(
					state,
					st,
				)
				st = continuation_step.index

				if continuation_step.opened_indent:
					continuation_indents += 1
		else:
			continuation_step: ParsePostfixContinuationStep = postfix_continuation_after_newline(
				state,
				st,
			)
			st = continuation_step.index

			if continuation_step.opened_indent:
				continuation_indents += 1

			if current_is_symbol(state, st, DotSymbol):
				st = advance_parser(state, st)
				field_step: ParseIdentifierStep = parse_identifier_expected(
					state,
					st,
					st_diag,
					"field name",
				)
				st = field_step.index
				st_diag = field_step.diagnostics
				expr = ParsedFieldAccessExpr(
					expr,
					field_step.value,
					location_cover(parsed_expr_location(expr), field_step.value.span),
				)
			else if current_is_symbol(state, st, LeftParenSymbol):
				start_span: SourceLocation = parsed_expr_location(expr)
				args_step: ParseExprListStep = parse_expr_list_until(
					state,
					advance_parser(state, st),
					st_diag,
					RightParenSymbol,
					True,
					header_span,
				)
				right_step: ParseSymbolStep = expect_symbol(
					state,
					args_step.index,
					RightParenSymbol,
				)
				right_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
					state,
					args_step.diagnostics,
					right_step,
					RightParenSymbol,
					"expected `)` after call arguments",
				)
				st = right_step.index
				st_diag = right_step_diagnostics

				end_span: SourceLocation = if right_step.matched:
					materialize_location(state, right_step.span)
				else:
					start_span

				expr = ParsedCallExpr(
					expr,
					args_step.values,
					location_cover(start_span, end_span),
				)
			else if current_is_symbol(state, st, LeftBracketSymbol):
				start_span: SourceLocation = parsed_expr_location(expr)
				indices_step: ParseExprListStep = parse_expr_list_until(
					state,
					advance_parser(state, st),
					st_diag,
					RightBracketSymbol,
					False,
					header_span,
				)
				right_step: ParseSymbolStep = expect_symbol(
					state,
					indices_step.index,
					RightBracketSymbol,
				)
				right_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
					state,
					indices_step.diagnostics,
					right_step,
					RightBracketSymbol,
					"expected `]` after subscript",
				)
				st = right_step.index
				st_diag = right_step_diagnostics

				end_span: SourceLocation = if right_step.matched:
					materialize_location(state, right_step.span)
				else:
					start_span

				expr = ParsedSubscriptExpr(
					expr,
					indices_step.values,
					location_cover(start_span, end_span),
				)
			else:
				parsing_postfix = False

	{
		index = st,
		diagnostics = st_diag,
		value = expr
	}


private pure func parse_prefix_expr_with_header_span(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	header_span: SourceLocation,
) -> ParseExprStep:
	match current_tag(state, index):
		SymbolTag:
			if current_symbol(state, index) == MinusSymbol:
				span: SourceLocation = current_location(state, index)
				operand_step: ParseExprStep = parse_prefix_expr_with_header_span(
					state,
					advance_parser(state, index),
					diagnostics,
					header_span,
				)
				{
					index = operand_step.index,
					diagnostics = operand_step.diagnostics,
					value = ParsedUnaryExpr(
						ParsedNegateOp,
						operand_step.value,
						location_cover(span, parsed_expr_location(operand_step.value)),
					)
				}
			else:
				primary_step: ParseExprStep = parse_primary_expr(state, index, diagnostics)
				parse_postfix_expr(
					state,
					primary_step.index,
					primary_step.diagnostics,
					primary_step.value,
					header_span,
				)
		KeywordTag:
			keyword: Keyword = current_keyword(state, index)

			if keyword == NotKeyword:
				span: SourceLocation = current_location(state, index)
				operand_step: ParseExprStep = parse_prefix_expr_with_header_span(
					state,
					advance_parser(state, index),
					diagnostics,
					header_span,
				)
				{
					index = operand_step.index,
					diagnostics = operand_step.diagnostics,
					value = ParsedUnaryExpr(
						ParsedNotOp,
						operand_step.value,
						location_cover(span, parsed_expr_location(operand_step.value)),
					)
				}
			else if keyword == DetachKeyword:
				span: SourceLocation = current_location(state, index)
				operand_step: ParseExprStep = parse_prefix_expr_with_header_span(
					state,
					advance_parser(state, index),
					diagnostics,
					header_span,
				)
				{
					index = operand_step.index,
					diagnostics = operand_step.diagnostics,
					value = ParsedDetachExpr(
						operand_step.value,
						location_cover(span, parsed_expr_location(operand_step.value)),
					)
				}
			else if keyword == FuncKeyword:
				parse_lambda_expr_with_header_span(state, index, diagnostics, header_span)
			else if keyword == PureKeyword:
				parse_lambda_expr_with_header_span(state, index, diagnostics, header_span)
			else if keyword == IfKeyword:
				parse_if_expr_with_header_span(state, index, diagnostics, header_span)
			else if keyword == MatchKeyword:
				parse_match_expr_with_header_span(state, index, diagnostics, header_span)
			else if keyword == SelectKeyword:
				parse_select_expr_with_header_span(state, index, diagnostics, header_span)
			else if keyword == ForKeyword:
				parse_for_expr_with_header_span(state, index, diagnostics, header_span)
			else:
				primary_step: ParseExprStep = parse_primary_expr(state, index, diagnostics)
				parse_postfix_expr(
					state,
					primary_step.index,
					primary_step.diagnostics,
					primary_step.value,
					header_span,
				)
		_:
			primary_step: ParseExprStep = parse_primary_expr(state, index, diagnostics)
			parse_postfix_expr(
				state,
				primary_step.index,
				primary_step.diagnostics,
				primary_step.value,
				header_span,
			)


private pure func parse_expression_with_header_span(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	min_precedence: Int,
	header_span: SourceLocation,
) -> ParseExprStep:
	prefix_step: ParseExprStep = parse_prefix_expr_with_header_span(
		state,
		index,
		diagnostics,
		header_span,
	)
	var st: Int = prefix_step.index
	var st_diag: List[ParseDiagnostic] = prefix_step.diagnostics
	var left: ParsedExpr = prefix_step.value
	var parsing_infix: Bool = True

	while parsing_infix and not current_is_eof(state, st):
		if current_is_keyword(state, st, AsKeyword):
			if PREC_ASCRIPTION < min_precedence:
				parsing_infix = False
			else:
				type_step: ParseTypeStep = parse_type_expr(
					state,
					advance_parser(state, st),
					st_diag,
				)
				left = ParsedAscriptionExpr(
					left,
					type_step.value,
					location_cover(
						parsed_expr_location(left),
						parsed_type_expr_location(type_step.value),
					),
				)
				st = type_step.index
				st_diag = type_step.diagnostics
		else:
			match current_infix_info(state, st):
				Some(info):
					if info.precedence < min_precedence:
						parsing_infix = False
					else:
						st = advance_parser(state, st)
						st = skip_newlines(state, st)
						right_step: ParseExprStep = parse_expression_with_header_span(
							state,
							st,
							st_diag,
							info.precedence + 1,
							header_span,
						)
						left = make_infix_expr(info, left, right_step.value)
						st = right_step.index
						st_diag = right_step.diagnostics
				None:
					parsing_infix = False

	result: ParseExprStep = {
		index = st,
		diagnostics = st_diag,
		value = left
	}

	if min_precedence <= PREC_LOWEST:
		parse_assignment_after_expression(state, result)
	else:
		result


private pure func parse_expression(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	min_precedence: Int,
) -> ParseExprStep:
	parse_expression_with_header_span(
		state,
		index,
		diagnostics,
		min_precedence,
		current_location(state, index),
	)


private pure func expect_indent(state: ParserInput, index: Int) -> ParserStep:
	if current_is_indent(state, index):
		{
			index = advance_parser(state, index),
			matched = True
		}
	else:
		{
			index = index,
			matched = False
		}


private pure func expect_dedent(state: ParserInput, index: Int) -> ParserStep:
	if current_is_dedent(state, index):
		{
			index = advance_parser(state, index),
			matched = True
		}
	else:
		{
			index = index,
			matched = False
		}


private pure func expect_indent_diagnostics(
	state: ParserInput,
	diagnostics: List[ParseDiagnostic],
	step: ParserStep,
) -> List[ParseDiagnostic]:
	if step.matched:
		diagnostics
	else:
		add_expected_error(
			state,
			diagnostics,
			current_location(state, step.index),
			"expected indented function body",
			["indent"],
			None,
		)


private pure func expect_dedent_diagnostics(
	state: ParserInput,
	diagnostics: List[ParseDiagnostic],
	step: ParserStep,
) -> List[ParseDiagnostic]:
	if step.matched:
		diagnostics
	else:
		add_expected_error(
			state,
			diagnostics,
			current_location(state, step.index),
			"expected dedent after function body",
			["dedent"],
			None,
		)


private pure func parse_function_body(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	start_span: SourceLocation,
) -> ParseBodyStep:
	if current_is_newline(state, index):
		block_step: ParseExprStep = parse_block_after_colon(state, index, diagnostics, start_span)

		{
			index = block_step.index,
			diagnostics = block_step.diagnostics,
			body = Some(block_step.value)
		}
	else:
		expr_step: ParseExprStep = parse_expression(state, index, diagnostics, PREC_LOWEST)

		{
			index = expr_step.index,
			diagnostics = expr_step.diagnostics,
			body = Some(expr_step.value)
		}


private pure func parse_function_decl_value(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	doc: Option[String],
	is_pure: Bool,
	annotations: List[ParsedFunctionAnnotation],
	start_span: SourceLocation,
) -> ParseFunctionStep:
	func_span: SourceLocation = current_location(state, index)
	var st: Int = advance_parser(state, index)
	var st_diag: List[ParseDiagnostic] = diagnostics
	name_step: ParseIdentifierStep = parse_declared_name_expected(
		state,
		st,
		st_diag,
		EXPECTED_FUNCTION_NAME,
	)
	st = name_step.index
	st_diag = name_step.diagnostics
	type_params_step: ParseTypeParamListStep = parse_type_params_opt(state, st, st_diag)
	st = type_params_step.index
	st_diag = type_params_step.diagnostics

	left_step: ParseSymbolStep = expect_symbol(state, st, LeftParenSymbol)
	left_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
		state,
		st_diag,
		left_step,
		LeftParenSymbol,
		"expected `(` after function name",
	)
	st = left_step.index
	st_diag = left_step_diagnostics

	params_step: ParseParamsStep = if left_step.matched:
		parse_params_after_left_paren(state, st, st_diag)
	else:
		{
			index = st,
			diagnostics = st_diag,
			values = []
		}

	st = params_step.index
	st_diag = params_step.diagnostics

	var return_type: Option[ParsedTypeExpr] = None
	var end_span: SourceLocation = name_step.value.span

	if current_is_symbol(state, st, ArrowSymbol):
		st = advance_parser(state, st)
		type_step: ParseTypeStep = parse_type_expr(state, st, st_diag)
		return_type = Some(type_step.value)
		st = type_step.index
		st_diag = type_step.diagnostics
		end_span = parsed_type_expr_location(type_step.value)

	dim_constraints_step: ParseDimConstraintListStep = parse_dim_constraints_opt(state, st, st_diag)
	st = dim_constraints_step.index
	st_diag = dim_constraints_step.diagnostics
	end_span = last_dim_constraint_span(dim_constraints_step.values, end_span)

	body_step: ParseBodyStep = if current_is_symbol(state, st, ColonSymbol):
		colon_step: ParseSymbolStep = expect_symbol(state, st, ColonSymbol)
		colon_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
			state,
			st_diag,
			colon_step,
			ColonSymbol,
			"expected `:` before function body",
		)
		st = colon_step.index
		st_diag = colon_step_diagnostics

		if current_is_eof(state, st) or current_is_dedent(state, st):
			{
				index = st,
				diagnostics = st_diag,
				body = None
			}
		else if current_is_newline(state, st) and not current_is_indent(
			state,
			advance_parser(state, st),
		):
			{
				index = st,
				diagnostics = st_diag,
				body = None
			}
		else if (
			not current_is_newline(state, st)
			and state.start_lines.get_or(st, 0) > state.start_lines.get_or(colon_step.span.first, 0)
		):
			{
				index = st,
				diagnostics = st_diag,
				body = None
			}
		else:
			parse_function_body(state, st, st_diag, start_span)
	else if (
		current_is_newline(state, st)
		or current_is_dedent(state, st)
		or current_is_eof(state, st)
	):
		{
			index = st,
			diagnostics = st_diag,
			body = None
		}
	else:
		error_state: Int = st
		error_state_diag: List[ParseDiagnostic] = add_expected_error(
			state,
			st_diag,
			current_location(state, st),
			"expected `:` before function body",
			[":"],
			None,
		)
		{
			index = error_state,
			diagnostics = error_state_diag,
			body = None
		}

	st = body_step.index
	st_diag = body_step.diagnostics

	match body_step.body:
		Some(body):
			end_span = parsed_expr_location(body)
		None:
			if source_locations_equal(end_span, name_step.value.span):
				end_span = func_span

	{
		index = st,
		diagnostics = st_diag,
		value = {
			name = name_step.value,
			keyword_span = Some(func_span),
			type_params = type_params_step.values,
			params = params_step.values,
			return_type = return_type,
			dim_constraints = dim_constraints_step.values,
			body = body_step.body,
			is_pure = is_pure,
			annotations = annotations,
			doc = doc,
			span = location_cover(start_span, end_span)
		}
	}


private pure func parse_function_decl(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	doc: Option[String],
	is_pure: Bool,
	annotations: List[ParsedFunctionAnnotation],
	start_span: SourceLocation,
) -> ParseDeclStep:
	function_step: ParseFunctionStep = parse_function_decl_value(
		state,
		index,
		diagnostics,
		doc,
		is_pure,
		annotations,
		start_span,
	)

	{
		index = function_step.index,
		diagnostics = function_step.diagnostics,
		value = FunctionParsedDecl(function_step.value)
	}


private pure func parse_import_symbol(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseImportSymbolStep:
	name_step: ParseIdentifierStep = parse_identifier_expected(
		state,
		index,
		diagnostics,
		"import symbol",
	)
	var st: Int = name_step.index
	var st_diag: List[ParseDiagnostic] = name_step.diagnostics
	var constructors: List[ParsedIdentifier] = []
	var symbol_alias: Option[ParsedIdentifier] = None
	var end_span: SourceLocation = name_step.value.span

	if current_is_symbol(state, st, LeftParenSymbol):
		ctors_step: ParseIdentifierListStep = parse_identifier_list_until(
			state,
			advance_parser(state, st),
			st_diag,
			RightParenSymbol,
			True,
			"constructor name",
		)
		constructors = ctors_step.values
		var ctors_state: Int = ctors_step.index
		var ctors_state_diag: List[ParseDiagnostic] = ctors_step.diagnostics

		if constructors.length() == 0:
			ctors_state_diag = add_expected_error(
				state,
				ctors_state_diag,
				current_location(state, ctors_state),
				"expected constructor name",
				[EXPECTED_CONSTRUCTOR_NAME],
				None,
			)

		right_step: ParseSymbolStep = expect_symbol(state, ctors_state, RightParenSymbol)
		right_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
			state,
			ctors_state_diag,
			right_step,
			RightParenSymbol,
			"expected `)` after imported constructors",
		)
		st = right_step.index
		st_diag = right_step_diagnostics

		if right_step.matched:
			end_span = materialize_location(state, right_step.span)

	if current_is_keyword(state, st, AsKeyword):
		alias_step: ParseIdentifierStep = parse_declared_name_expected(
			state,
			advance_parser(state, st),
			st_diag,
			"import symbol alias",
		)
		symbol_alias = Some(alias_step.value)
		st = alias_step.index
		st_diag = alias_step.diagnostics
		end_span = alias_step.value.span

	{
		index = st,
		diagnostics = st_diag,
		value = {
			name = name_step.value,
			symbol_alias = symbol_alias,
			constructors = constructors,
			span = location_cover(name_step.value.span, end_span)
		}
	}


private pure func parse_import_symbols_until_line_end(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseImportSymbolListStep:
	var st: Int = index
	var st_diag: List[ParseDiagnostic] = diagnostics
	var symbols: List[ParsedImportSymbol] = []

	while not current_is_newline(state, st) and not current_is_block_end(state, st):
		before_index: Int = st
		symbol_step: ParseImportSymbolStep = parse_import_symbol(state, st, st_diag)
		symbols = symbols.append(symbol_step.value)
		st = symbol_step.index
		st_diag = symbol_step.diagnostics

		if current_is_symbol(state, st, CommaSymbol):
			st = advance_parser(state, st)
		else if not current_is_newline(state, st) and not current_is_block_end(state, st):
			st_diag = add_expected_error(
				state,
				st_diag,
				current_location(state, st),
				"expected `, ` between imported symbols",
				[","],
				None,
			)

		if (
			st == before_index
			and not current_is_newline(state, st)
			and not current_is_block_end(state, st)
		):
			st = advance_parser(state, st)

	{
		index = st,
		diagnostics = st_diag,
		values = symbols
	}


private pure func parse_import_symbols_block(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseImportSymbolListStep:
	__step_15: ParserStep = expect_indent(state, index)
	__step_15_diagnostics: List[ParseDiagnostic] = expect_indent_diagnostics(
		state,
		diagnostics,
		__step_15,
	)
	var st: Int = __step_15.index
	var st_diag: List[ParseDiagnostic] = __step_15_diagnostics
	st = skip_newlines(state, st)
	var symbols: List[ParsedImportSymbol] = []

	while not current_is_block_end(state, st):
		before_index: Int = st
		line_step: ParseImportSymbolListStep = parse_import_symbols_until_line_end(
			state,
			st,
			st_diag,
		)
		symbols = symbols.concat(line_step.values)
		st = skip_newlines(state, line_step.index)
		st_diag = line_step.diagnostics

		if st == before_index and not current_is_block_end(state, st):
			st = advance_parser(state, st)

	if current_is_dedent(state, st):
		st = advance_parser(state, st)

	{
		index = st,
		diagnostics = st_diag,
		values = symbols
	}


private pure func parse_module_path(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseModulePathStep:
	var st: Int = index
	var st_diag: List[ParseDiagnostic] = diagnostics
	var prefix: String = ""
	var start_span: SourceLocation = current_location(state, index)

	if current_is_symbol(state, st, DotSymbol) and next_is_symbol(state, st, SlashSymbol):
		prefix = "./"
		st = advance_parser(
			state,
			advance_parser(state, st),
		)
	else:
		var parsing_parent_prefix: Bool = True

		while parsing_parent_prefix:
			if (
				current_is_symbol(state, st, DotDotSymbol)
				and next_is_symbol(state, st, SlashSymbol)
			):
				prefix += "../"
				st = advance_parser(
					state,
					advance_parser(state, st),
				)
			else:
				parsing_parent_prefix = False

	first_step: ParseIdentifierStep = parse_identifier_expected(state, st, st_diag, "module path")
	st = first_step.index
	st_diag = first_step.diagnostics
	var path: String = prefix + first_step.value.text
	var end_span: SourceLocation = first_step.value.span

	while current_is_symbol(state, st, SlashSymbol):
		st = advance_parser(state, st)
		part_step: ParseIdentifierStep = parse_identifier_expected(
			state,
			st,
			st_diag,
			"module path",
		)
		part_text: String = part_step.value.text
		path = "${path}/${part_text}"
		st = part_step.index
		st_diag = part_step.diagnostics
		end_span = part_step.value.span

	{
		index = st,
		diagnostics = st_diag,
		value = path,
		span = location_cover(start_span, end_span)
	}


private pure func parse_import_item(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseImportItemStep:
	path_step: ParseModulePathStep = parse_module_path(state, index, diagnostics)
	var st: Int = path_step.index
	var st_diag: List[ParseDiagnostic] = path_step.diagnostics
	var module_alias: Option[ParsedIdentifier] = None
	var symbols: Option[List[ParsedImportSymbol]] = None
	var end_span: SourceLocation = path_step.span

	if current_is_keyword(state, st, AsKeyword):
		alias_step: ParseIdentifierStep = parse_declared_name_expected(
			state,
			advance_parser(state, st),
			st_diag,
			"module alias",
		)
		module_alias = Some(alias_step.value)
		st = alias_step.index
		st_diag = alias_step.diagnostics
		end_span = alias_step.value.span

	if current_is_symbol(state, st, ColonSymbol):
		st = advance_parser(state, st)

		if current_is_newline(state, st):
			block_start: Int = skip_newlines(state, st)
			block_start_diag: List[ParseDiagnostic] = st_diag

			if current_is_indent(state, block_start):
				symbols_step: ParseImportSymbolListStep = parse_import_symbols_block(
					state,
					block_start,
					block_start_diag,
				)
				symbols = Some(symbols_step.values)
				st = symbols_step.index
				st_diag = symbols_step.diagnostics

				match symbols_step.values.get(symbols_step.values.length() - 1):
					Some(last_symbol):
						end_span = last_symbol.span
					None:
						void
			else:
				st_diag = add_expected_error(
					state,
					st_diag,
					current_location(state, st),
					"expected import symbols after `:`",
					["import symbol"],
					None,
				)
				symbols = Some([])
		else:
			symbols_step: ParseImportSymbolListStep = parse_import_symbols_until_line_end(
				state,
				st,
				st_diag,
			)
			symbols = Some(symbols_step.values)
			st = symbols_step.index
			st_diag = symbols_step.diagnostics

			match symbols_step.values.get(symbols_step.values.length() - 1):
				Some(last_symbol):
					end_span = last_symbol.span
				None:
					void

	{
		index = st,
		diagnostics = st_diag,
		value = {
			module_path = path_step.value,
			module_path_span = path_step.span,
			module_alias = module_alias,
			symbols = symbols,
			span = location_cover(path_step.span, end_span)
		}
	}


private pure func parse_import_item_list(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseImportItemListStep:
	var st: Int = skip_newlines(state, index)
	var st_diag: List[ParseDiagnostic] = diagnostics
	var items: List[ParsedImportDecl] = []

	while not current_is_block_end(state, st):
		before_index: Int = st
		item_step: ParseImportItemStep = parse_import_item(state, st, st_diag)
		items = items.append(item_step.value)
		st = skip_newlines(state, item_step.index)
		st_diag = item_step.diagnostics

		if st == before_index and not current_is_block_end(state, st):
			st = advance_parser(state, st)

	{
		index = st,
		diagnostics = st_diag,
		values = items
	}


private pure func parse_import_block_decl(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	start_span: SourceLocation,
) -> ParseDeclStep:
	var st: Int = advance_parser(state, index)
	var st_diag: List[ParseDiagnostic] = diagnostics
	colon_step: ParseSymbolStep = expect_symbol(state, st, ColonSymbol)
	colon_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
		state,
		st_diag,
		colon_step,
		ColonSymbol,
		"expected `:` after import",
	)
	__step_16: ParserStep = expect_newline(state, colon_step.index)
	__step_16_diagnostics: List[ParseDiagnostic] = expect_newline_diagnostics(
		state,
		colon_step_diagnostics,
		__step_16,
		"expected newline after import header",
	)
	st = __step_16.index
	st_diag = __step_16_diagnostics
	__step_17: ParserStep = expect_indent(state, st)
	__step_17_diagnostics: List[ParseDiagnostic] = expect_indent_diagnostics(
		state,
		st_diag,
		__step_17,
	)
	st = __step_17.index
	st_diag = __step_17_diagnostics
	items_step: ParseImportItemListStep = parse_import_item_list(state, st, st_diag)
	st = items_step.index
	st_diag = items_step.diagnostics

	end_span: SourceLocation = if current_is_dedent(state, st):
		current_location(state, st)
	else:
		start_span

	__step_18: ParserStep = expect_dedent(state, st)
	__step_18_diagnostics: List[ParseDiagnostic] = expect_dedent_diagnostics(
		state,
		st_diag,
		__step_18,
	)
	st = __step_18.index
	st_diag = __step_18_diagnostics

	{
		index = st,
		diagnostics = st_diag,
		value = ImportBlockParsedDecl(
			items_step.values,
			location_cover(start_span, end_span),
		)
	}


private pure func add_foreign_block_only_error(
	state: ParserInput,
	diagnostics: List[ParseDiagnostic],
	span: SourceLocation,
) -> List[ParseDiagnostic]:
	add_expected_error(
		state,
		diagnostics,
		span,
		(
			"foreign declarations must use a foreign: block; write `foreign:` and indent "
			+ "`func ...` inside it"
		),
		["foreign:"],
		Some("write `foreign:` followed by an indented function signature"),
	)


private pure func parse_foreign_block_arg(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseForeignBlockArgStep:
	name_step: ParseIdentifierStep = parse_identifier_expected(
		state,
		index,
		diagnostics,
		EXPECTED_FOREIGN_BLOCK_ARG,
	)
	var st: Int = name_step.index
	var st_diag: List[ParseDiagnostic] = name_step.diagnostics
	colon_step: ParseSymbolStep = expect_symbol(state, st, ColonSymbol)
	colon_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
		state,
		st_diag,
		colon_step,
		ColonSymbol,
		"expected `:` after foreign block argument name",
	)
	st = colon_step.index
	st_diag = colon_step_diagnostics
	var value: String = ""
	var end_span: SourceLocation = name_step.value.span

	match current_tag(state, st):
		StringLiteralTag:
			value = current_string_literal_text(state, st)
			end_span = current_location(state, st)
			st = advance_parser(state, st)
		_:
			st_diag = add_expected_error(
				state,
				st_diag,
				current_location(state, st),
				"expected foreign block argument value",
				["string literal"],
				Some("write foreign block arguments as name: \"value\""),
			)

			if not current_is_soft_boundary(state, st):
				st = advance_parser(state, st)

	{
		index = st,
		diagnostics = st_diag,
		value = {
			name = name_step.value,
			value = value,
			span = location_cover(name_step.value.span, end_span)
		}
	}


private pure func parse_foreign_block_arg_list_until_right_paren(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseForeignBlockArgListStep:
	var st: Int = index
	var st_diag: List[ParseDiagnostic] = diagnostics
	var values: List[ParsedForeignBlockArg] = []

	if current_is_symbol(state, st, RightParenSymbol):
		st_diag = add_expected_error(
			state,
			st_diag,
			current_location(state, st),
			"expected foreign block argument",
			[EXPECTED_FOREIGN_BLOCK_ARG],
			Some("omit the parentheses for a foreign block with no arguments"),
		)
	else:
		var parsing_args: Bool = True

		while parsing_args and not current_is_eof(state, st):
			before_index: Int = st
			arg_step: ParseForeignBlockArgStep = parse_foreign_block_arg(state, st, st_diag)
			values = values.append(arg_step.value)
			st = arg_step.index
			st_diag = arg_step.diagnostics

			if current_is_symbol(state, st, CommaSymbol):
				st = advance_parser(state, st)

				if current_is_symbol(state, st, RightParenSymbol):
					parsing_args = False
			else if current_is_symbol(state, st, RightParenSymbol):
				parsing_args = False
			else:
				st_diag = add_expected_error(
					state,
					st_diag,
					current_location(state, st),
					"expected `, ` between foreign block arguments",
					[","],
					None,
				)

			if st == before_index and not current_is_symbol(state, st, RightParenSymbol):
				st = advance_parser(state, st)

	{
		index = st,
		diagnostics = st_diag,
		values = values
	}


private pure func current_can_start_foreign_function(state: ParserInput, index: Int) -> Bool:
	(
		current_is_keyword(state, index, PrivateKeyword)
		or current_is_keyword(state, index, PureKeyword)
		or current_is_keyword(state, index, FuncKeyword)
		or current_is_symbol(state, index, AtSymbol)
	)


private pure func parse_foreign_function_decl(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseForeignFunctionStep:
	var st: Int = index
	var st_diag: List[ParseDiagnostic] = diagnostics
	start_span: SourceLocation = current_location(state, st)
	var is_private: Bool = False

	if current_is_keyword(state, st, PrivateKeyword):
		is_private = True
		st = advance_parser(state, st)

	annotations_step: ParseFunctionAnnotationsStep = parse_function_annotations(
		state,
		st,
		st_diag,
		False,
	)
	st = annotations_step.index
	st_diag = annotations_step.diagnostics
	var is_pure: Bool = False

	if current_is_keyword(state, st, PureKeyword):
		is_pure = True
		st = advance_parser(state, st)

	__step_19: ParserStep = expect_keyword(state, st, FuncKeyword)
	__step_19_diagnostics: List[ParseDiagnostic] = expect_keyword_diagnostics(
		state,
		st_diag,
		__step_19,
		"func",
		"expected `func` in foreign block item",
	)
	st = __step_19.index
	st_diag = __step_19_diagnostics
	name_step: ParseIdentifierStep = parse_declared_name_expected(
		state,
		st,
		st_diag,
		EXPECTED_FUNCTION_NAME,
	)
	st = name_step.index
	st_diag = name_step.diagnostics
	left_step: ParseSymbolStep = expect_symbol(state, st, LeftParenSymbol)
	left_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
		state,
		st_diag,
		left_step,
		LeftParenSymbol,
		"expected `(` after foreign function name",
	)
	st = left_step.index
	st_diag = left_step_diagnostics

	params_step: ParseParamsStep = if left_step.matched:
		parse_params_after_left_paren(state, st, st_diag)
	else:
		{
			index = st,
			diagnostics = st_diag,
			values = []
		}

	st = params_step.index
	st_diag = params_step.diagnostics
	var return_type: ParsedTypeExpr = ParsedMissingType(current_location(state, st))
	var end_span: SourceLocation = name_step.value.span
	arrow_step: ParseSymbolStep = expect_symbol(state, st, ArrowSymbol)
	arrow_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
		state,
		st_diag,
		arrow_step,
		ArrowSymbol,
		"expected `->` before foreign function return type",
	)
	st = arrow_step.index
	st_diag = arrow_step_diagnostics

	if arrow_step.matched:
		type_step: ParseTypeStep = parse_type_expr(state, st, st_diag)
		return_type = type_step.value
		st = type_step.index
		st_diag = type_step.diagnostics
		end_span = parsed_type_expr_location(type_step.value)
	else:
		end_span = materialize_location(state, arrow_step.span)

	var c_name: Option[String] = None

	if current_is_symbol(state, st, EqualSymbol):
		st = advance_parser(state, st)

		match current_tag(state, st):
			StringLiteralTag:
				c_name = Some(current_string_literal_text(state, st))
				end_span = current_location(state, st)
				st = advance_parser(state, st)
			_:
				st_diag = add_expected_error(
					state,
					st_diag,
					current_location(state, st),
					"expected foreign C function name",
					["string literal"],
					Some("write = \"c_function_name\" or omit the C name to use the Blorp name"),
				)

				if not current_is_soft_boundary(state, st):
					st = advance_parser(state, st)

	{
		index = st,
		diagnostics = st_diag,
		value = {
			name = name_step.value,
			params = params_step.values,
			return_type = return_type,
			c_name = c_name,
			is_pure = is_pure,
			is_private = is_private,
			annotations = annotations_step.values,
			span = location_cover(start_span, end_span)
		}
	}


private pure func parse_foreign_function_list(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseForeignFunctionListStep:
	var st: Int = skip_newlines(state, index)
	var st_diag: List[ParseDiagnostic] = diagnostics
	var values: List[ParsedForeignFunctionDecl] = []

	while not current_is_block_end(state, st):
		before_index: Int = st

		if current_can_start_foreign_function(state, st):
			function_step: ParseForeignFunctionStep = parse_foreign_function_decl(
				state,
				st,
				st_diag,
			)
			values = values.append(function_step.value)
			st = skip_newlines(state, function_step.index)
			st_diag = function_step.diagnostics
		else:
			st_diag = add_expected_error(
				state,
				st_diag,
				current_location(state, st),
				"expected foreign function declaration",
				["func"],
				Some("write a bodyless function signature inside the foreign block"),
			)

			if not current_is_block_end(state, st):
				st = advance_parser(state, st)

			st = skip_newlines(state, st)

		if st == before_index and not current_is_block_end(state, st):
			st = advance_parser(state, st)

	{
		index = st,
		diagnostics = st_diag,
		values = values
	}


private pure func parse_foreign_block_decl(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	start_span: SourceLocation,
) -> ParseDeclStep:
	var st: Int = advance_parser(state, index)
	var st_diag: List[ParseDiagnostic] = diagnostics

	if current_is_keyword(state, st, PureKeyword) or current_is_keyword(state, st, FuncKeyword):
		error_state: Int = st
		error_state_diag: List[ParseDiagnostic] = add_foreign_block_only_error(
			state,
			st_diag,
			start_span,
		)

		{
			index = advance_parser(state, error_state),
			diagnostics = error_state_diag,
			value = ParsedErrorDecl(start_span)
		}
	else:
		var args: List[ParsedForeignBlockArg] = []

		if current_is_symbol(state, st, LeftParenSymbol):
			args_step: ParseForeignBlockArgListStep = parse_foreign_block_arg_list_until_right_paren(
				state,
				advance_parser(state, st),
				st_diag,
			)
			args = args_step.values
			right_step: ParseSymbolStep = expect_symbol(state, args_step.index, RightParenSymbol)
			right_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
				state,
				args_step.diagnostics,
				right_step,
				RightParenSymbol,
				"expected `)` after foreign block arguments",
			)
			st = right_step.index
			st_diag = right_step_diagnostics

		colon_step: ParseSymbolStep = expect_symbol(state, st, ColonSymbol)
		colon_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
			state,
			st_diag,
			colon_step,
			ColonSymbol,
			"expected `:` after foreign",
		)
		__step_20: ParserStep = expect_newline(state, colon_step.index)
		__step_20_diagnostics: List[ParseDiagnostic] = expect_newline_diagnostics(
			state,
			colon_step_diagnostics,
			__step_20,
			"expected newline after foreign header",
		)
		st = __step_20.index
		st_diag = __step_20_diagnostics
		__step_21: ParserStep = expect_indent(state, st)
		__step_21_diagnostics: List[ParseDiagnostic] = expect_indent_diagnostics(
			state,
			st_diag,
			__step_21,
		)
		st = __step_21.index
		st_diag = __step_21_diagnostics
		functions_step: ParseForeignFunctionListStep = parse_foreign_function_list(
			state,
			st,
			st_diag,
		)
		st = functions_step.index
		st_diag = functions_step.diagnostics

		end_span: SourceLocation = if current_is_dedent(state, st):
			current_location(state, st)
		else:
			start_span

		__step_22: ParserStep = expect_dedent(state, st)
		__step_22_diagnostics: List[ParseDiagnostic] = expect_dedent_diagnostics(
			state,
			st_diag,
			__step_22,
		)
		st = __step_22.index
		st_diag = __step_22_diagnostics

		{
			index = st,
			diagnostics = st_diag,
			value = ForeignBlockParsedDecl(
				args,
				functions_step.values,
				location_cover(start_span, end_span),
			)
		}


private pure func parse_field_decl(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseFieldStep:
	name_step: ParseIdentifierStep = parse_declared_name_expected(
		state,
		index,
		diagnostics,
		"field name",
	)
	colon_step: ParseSymbolStep = expect_symbol(state, name_step.index, ColonSymbol)
	colon_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
		state,
		name_step.diagnostics,
		colon_step,
		ColonSymbol,
		"expected `:` after field name",
	)
	type_step: ParseTypeStep = parse_type_expr(state, colon_step.index, colon_step_diagnostics)

	{
		index = type_step.index,
		diagnostics = type_step.diagnostics,
		value = {
			name = name_step.value,
			type_expr = type_step.value,
			span = location_cover(name_step.value.span, parsed_type_expr_location(type_step.value))
		}
	}


private pure func parse_field_list_until_right_brace(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseFieldListStep:
	var st: Int = index
	var st_diag: List[ParseDiagnostic] = diagnostics
	var fields: List[ParsedFieldDecl] = []

	if not current_is_symbol(state, st, RightBraceSymbol):
		var parsing_fields: Bool = True

		while parsing_fields and not current_is_eof(state, st):
			field_step: ParseFieldStep = parse_field_decl(state, st, st_diag)
			fields = fields.append(field_step.value)
			st = field_step.index
			st_diag = field_step.diagnostics

			if current_is_symbol(state, st, CommaSymbol):
				st = advance_parser(state, st)

				if current_is_symbol(state, st, RightBraceSymbol):
					parsing_fields = False
			else:
				parsing_fields = False

	{
		index = st,
		diagnostics = st_diag,
		values = fields
	}


private pure func parse_record_decl(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	doc: Option[String],
	syntax: AggregateDeclarationSyntax,
	start_span: SourceLocation,
) -> ParseDeclStep:
	var st: Int = advance_parser(state, index)
	var st_diag: List[ParseDiagnostic] = diagnostics
	is_struct: Bool = syntax == StructDeclarationSyntax

	name_expected: String = if is_struct:
		"struct name"
	else:
		"record name"

	open_fields_message: String = if is_struct:
		"expected `{` before struct fields"
	else:
		"expected `{` before record fields"

	close_fields_message: String = if is_struct:
		"expected `}` after struct fields"
	else:
		"expected `}` after record fields"

	name_step: ParseIdentifierStep = parse_declared_name_expected(state, st, st_diag, name_expected)
	st = name_step.index
	st_diag = name_step.diagnostics

	type_params_step: ParseTypeParamListStep = if is_struct:
		{
			index = st,
			diagnostics = st_diag,
			values = []
		}
	else:
		parse_type_params_opt(state, st, st_diag)

	st = type_params_step.index
	st_diag = type_params_step.diagnostics
	left_step: ParseSymbolStep = expect_symbol(state, st, LeftBraceSymbol)
	left_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
		state,
		st_diag,
		left_step,
		LeftBraceSymbol,
		open_fields_message,
	)
	fields_step: ParseFieldListStep = parse_field_list_until_right_brace(
		state,
		left_step.index,
		left_step_diagnostics,
	)
	right_step: ParseSymbolStep = expect_symbol(state, fields_step.index, RightBraceSymbol)
	right_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
		state,
		fields_step.diagnostics,
		right_step,
		RightBraceSymbol,
		close_fields_message,
	)

	{
		index = right_step.index,
		diagnostics = right_step_diagnostics,
		value = RecordParsedDecl({
			name = name_step.value,
			type_params = type_params_step.values,
			fields = fields_step.values,
			is_struct = is_struct,
			doc = doc,
			span = location_cover(
				start_span,
				materialize_location(state, right_step.span),
			),
		})
	}


private pure func parse_variant_identifier_expected(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseIdentifierStep:
	span: SourceLocation = current_location(state, index)

	match current_tag(state, index):
		KeywordTag:
			keyword: Keyword = current_keyword(state, index)

			if keyword == TrueKeyword:
				{
					index = advance_parser(state, index),
					diagnostics = diagnostics,
					value = parsed_identifier("True", span)
				}
			else if keyword == FalseKeyword:
				{
					index = advance_parser(state, index),
					diagnostics = diagnostics,
					value = parsed_identifier("False", span)
				}
			else:
				parse_declared_name_expected(state, index, diagnostics, "variant name")
		_:
			parse_declared_name_expected(state, index, diagnostics, "variant name")


private pure func parse_variant_decl(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseVariantStep:
	name_step: ParseIdentifierStep = parse_variant_identifier_expected(state, index, diagnostics)
	var st: Int = name_step.index
	var st_diag: List[ParseDiagnostic] = name_step.diagnostics
	var fields: List[ParsedTypeExpr] = []
	var end_span: SourceLocation = name_step.value.span

	if current_is_symbol(state, st, LeftParenSymbol):
		fields_step: ParseTypeListStep = parse_type_expr_list_until(
			state,
			advance_parser(state, st),
			st_diag,
			RightParenSymbol,
			True,
		)
		fields = fields_step.values
		right_step: ParseSymbolStep = expect_symbol(state, fields_step.index, RightParenSymbol)
		right_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
			state,
			fields_step.diagnostics,
			right_step,
			RightParenSymbol,
			"expected `)` after variant fields",
		)
		st = right_step.index
		st_diag = right_step_diagnostics

		if right_step.matched:
			end_span = materialize_location(state, right_step.span)

	{
		index = st,
		diagnostics = st_diag,
		value = {
			name = name_step.value,
			fields = fields,
			span = location_cover(name_step.value.span, end_span)
		}
	}


private pure func parse_variant_list(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseVariantListStep:
	var st: Int = skip_newlines(state, index)
	var st_diag: List[ParseDiagnostic] = diagnostics
	var variants: List[ParsedVariantDecl] = []

	while not current_is_block_end(state, st):
		before_index: Int = st
		variant_step: ParseVariantStep = parse_variant_decl(state, st, st_diag)
		variants = variants.append(variant_step.value)
		st = skip_newlines(state, variant_step.index)
		st_diag = variant_step.diagnostics

		if st == before_index and not current_is_block_end(state, st):
			st = advance_parser(state, st)

	{
		index = st,
		diagnostics = st_diag,
		values = variants
	}


private pure func parse_union_decl(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	doc: Option[String],
	is_enum: Bool,
	start_span: SourceLocation,
) -> ParseDeclStep:
	var st: Int = advance_parser(state, index)
	var st_diag: List[ParseDiagnostic] = diagnostics
	name_step: ParseIdentifierStep = parse_declared_name_expected(state, st, st_diag, "type name")
	st = name_step.index
	st_diag = name_step.diagnostics

	type_params_step: ParseTypeParamListStep = if is_enum:
		{
			index = st,
			diagnostics = st_diag,
			values = []
		}
	else:
		parse_type_params_opt(state, st, st_diag)

	st = type_params_step.index
	st_diag = type_params_step.diagnostics
	colon_step: ParseSymbolStep = expect_symbol(state, st, ColonSymbol)
	colon_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
		state,
		st_diag,
		colon_step,
		ColonSymbol,
		"expected `:` before variants",
	)
	__step_23: ParserStep = expect_newline(state, colon_step.index)
	__step_23_diagnostics: List[ParseDiagnostic] = expect_newline_diagnostics(
		state,
		colon_step_diagnostics,
		__step_23,
		"expected newline before variants",
	)
	st = __step_23.index
	st_diag = __step_23_diagnostics
	__step_24: ParserStep = expect_indent(state, st)
	__step_24_diagnostics: List[ParseDiagnostic] = expect_indent_diagnostics(
		state,
		st_diag,
		__step_24,
	)
	st = __step_24.index
	st_diag = __step_24_diagnostics
	variants_step: ParseVariantListStep = parse_variant_list(state, st, st_diag)
	st = variants_step.index
	st_diag = variants_step.diagnostics

	end_span: SourceLocation = if current_is_dedent(state, st):
		current_location(state, st)
	else:
		name_step.value.span

	__step_25: ParserStep = expect_dedent(state, st)
	__step_25_diagnostics: List[ParseDiagnostic] = expect_dedent_diagnostics(
		state,
		st_diag,
		__step_25,
	)
	st = __step_25.index
	st_diag = __step_25_diagnostics

	{
		index = st,
		diagnostics = st_diag,
		value = UnionParsedDecl({
			name = name_step.value,
			type_params = type_params_step.values,
			variants = variants_step.values,
			is_enum = is_enum,
			doc = doc,
			span = location_cover(start_span, end_span),
		})
	}


private pure func consume_builtin_type_argument_list(
	state: ParserInput,
	index: Int,
) -> Int:
	var st: Int = index

	st = advance_parser(state, st)

	while (
		not current_is_eof(state, st)
		and not current_is_newline(state, st)
		and not current_is_symbol(state, st, RightParenSymbol)
	):
		st = advance_parser(state, st)

	if current_is_symbol(state, st, RightParenSymbol):
		advance_parser(state, st)
	else:
		st


private pure func parse_builtin_type_decl(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	doc: Option[String],
	is_resource: Bool,
	start_span: SourceLocation,
) -> ParseDeclStep:
	var st: Int = if is_resource:
		advance_parser(state, index)
	else:
		index

	var st_diag: List[ParseDiagnostic] = diagnostics

	keyword_step: ParserStep = expect_keyword(state, st, TypeKeyword)
	keyword_step_diagnostics: List[ParseDiagnostic] = expect_keyword_diagnostics(
		state,
		st_diag,
		keyword_step,
		"type",
		"expected `type` in builtin type declaration",
	)
	st = keyword_step.index
	st_diag = keyword_step_diagnostics
	name_step: ParseIdentifierStep = parse_declared_name_expected(state, st, st_diag, "type name")
	st = name_step.index
	st_diag = name_step.diagnostics
	type_params_step: ParseTypeParamListStep = parse_type_params_opt(state, st, st_diag)
	st = type_params_step.index
	st_diag = type_params_step.diagnostics
	equal_step: ParseSymbolStep = expect_symbol(state, st, EqualSymbol)
	equal_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
		state,
		st_diag,
		equal_step,
		EqualSymbol,
		"expected `=` before builtin type marker",
	)
	builtin_span: SourceLocation = current_location(state, equal_step.index)
	builtin_keyword_step: ParserStep = expect_keyword(state, equal_step.index, BuiltinKeyword)
	builtin_keyword_step_diagnostics: List[ParseDiagnostic] = expect_keyword_diagnostics(
		state,
		equal_step_diagnostics,
		builtin_keyword_step,
		"builtin",
		"expected `builtin` after `=`",
	)
	st = builtin_keyword_step.index
	st_diag = builtin_keyword_step_diagnostics
	var cleanup: Option[ParsedResourceCleanup] = None
	var end_span: SourceLocation = builtin_span

	if current_is_symbol(state, st, LeftParenSymbol):
		if is_resource:
			st = advance_parser(state, st)

			match current_tag(state, st):
				StringLiteralTag:
					cleanup = Some({
						builtin_name = current_string_literal_text(state, st),
						span = current_location(state, st),
					})
					end_span = current_location(state, st)
					st = advance_parser(state, st)
				_:
					st_diag = add_expected_error(
						state,
						st_diag,
						current_location(state, st),
						"expected resource cleanup builtin name",
						["string literal"],
						Some("write resource type Name = builtin(\"cleanup_function\")"),
					)

					if not current_is_soft_boundary(state, st):
						st = advance_parser(state, st)

			right_step: ParseSymbolStep = expect_symbol(state, st, RightParenSymbol)
			right_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
				state,
				st_diag,
				right_step,
				RightParenSymbol,
				"expected `)` after resource cleanup builtin name",
			)
			st = right_step.index
			st_diag = right_step_diagnostics

			if right_step.matched:
				end_span = materialize_location(state, right_step.span)
		else:
			st_diag = add_expected_error(
				state,
				st_diag,
				current_location(state, st),
				"builtin type declarations do not take arguments",
				[],
				Some(
					"use `resource type Name = builtin(\"cleanup\")` for resource cleanup metadata",
				),
			)
			st = consume_builtin_type_argument_list(state, st)

	{
		index = st,
		diagnostics = st_diag,
		value = BuiltinTypeParsedDecl({
			name = name_step.value,
			type_params = type_params_step.values,
			is_resource = is_resource,
			cleanup = cleanup,
			doc = doc,
			span = location_cover(start_span, end_span),
		})
	}


private pure func parse_type_alias_decl(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	doc: Option[String],
	is_opaque: Bool,
	start_span: SourceLocation,
) -> ParseDeclStep:
	var st: Int = advance_parser(state, index)
	var st_diag: List[ParseDiagnostic] = diagnostics

	if is_opaque:
		__step_26: ParserStep = expect_keyword(state, st, TypeKeyword)
		__step_26_diagnostics: List[ParseDiagnostic] = expect_keyword_diagnostics(
			state,
			st_diag,
			__step_26,
			"type",
			"expected `type` after `opaque`",
		)
		st = __step_26.index
		st_diag = __step_26_diagnostics
	else:
		__step_27: ParserStep = expect_keyword(state, st, AliasKeyword)
		__step_27_diagnostics: List[ParseDiagnostic] = expect_keyword_diagnostics(
			state,
			st_diag,
			__step_27,
			"alias",
			"expected `alias` after `type`",
		)
		st = __step_27.index
		st_diag = __step_27_diagnostics

	name_step: ParseIdentifierStep = parse_declared_name_expected(
		state,
		st,
		st_diag,
		"type alias name",
	)
	st = name_step.index
	st_diag = name_step.diagnostics
	type_params_step: ParseTypeParamListStep = parse_type_params_opt(state, st, st_diag)
	st = type_params_step.index
	st_diag = type_params_step.diagnostics
	equal_step: ParseSymbolStep = expect_symbol(state, st, EqualSymbol)
	equal_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
		state,
		st_diag,
		equal_step,
		EqualSymbol,
		"expected `=` before type alias target",
	)
	target_step: ParseTypeStep = parse_type_expr(state, equal_step.index, equal_step_diagnostics)

	{
		index = target_step.index,
		diagnostics = target_step.diagnostics,
		value = TypeAliasParsedDecl({
			name = name_step.value,
			type_params = type_params_step.values,
			target = target_step.value,
			is_opaque = is_opaque,
			doc = doc,
			span = location_cover(start_span, parsed_type_expr_location(target_step.value)),
		})
	}


private pure func parse_trait_method(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseTraitMethodStep:
	var st: Int = index
	var st_diag: List[ParseDiagnostic] = diagnostics
	var is_pure: Bool = False
	start_span: SourceLocation = current_location(state, st)

	if current_is_keyword(state, st, PureKeyword):
		is_pure = True
		st = advance_parser(state, st)

	__step_28: ParserStep = expect_keyword(state, st, FuncKeyword)
	__step_28_diagnostics: List[ParseDiagnostic] = expect_keyword_diagnostics(
		state,
		st_diag,
		__step_28,
		"func",
		"expected `func` before trait method",
	)
	st = __step_28.index
	st_diag = __step_28_diagnostics
	name_step: ParseIdentifierStep = parse_declared_name_expected(
		state,
		st,
		st_diag,
		"trait method name",
	)
	st = name_step.index
	st_diag = name_step.diagnostics
	left_step: ParseSymbolStep = expect_symbol(state, st, LeftParenSymbol)
	left_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
		state,
		st_diag,
		left_step,
		LeftParenSymbol,
		"expected `(` after trait method name",
	)
	st = left_step.index
	st_diag = left_step_diagnostics

	params_step: ParseParamsStep = if left_step.matched:
		parse_params_after_left_paren(state, st, st_diag)
	else:
		{
			index = st,
			diagnostics = st_diag,
			values = []
		}

	st = params_step.index
	st_diag = params_step.diagnostics
	var return_type: Option[ParsedTypeExpr] = None
	var body: Option[ParsedExpr] = None
	var end_span: SourceLocation = name_step.value.span

	if current_is_symbol(state, st, ArrowSymbol):
		st = advance_parser(state, st)
		type_step: ParseTypeStep = parse_type_expr(state, st, st_diag)
		return_type = Some(type_step.value)
		st = type_step.index
		st_diag = type_step.diagnostics
		end_span = parsed_type_expr_location(type_step.value)

	if current_is_symbol(state, st, ColonSymbol):
		colon_step: ParseSymbolStep = expect_symbol(state, st, ColonSymbol)
		colon_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
			state,
			st_diag,
			colon_step,
			ColonSymbol,
			"expected `:` before trait method body",
		)
		body_step: ParseBodyStep = parse_function_body(
			state,
			colon_step.index,
			colon_step_diagnostics,
			start_span,
		)
		body = body_step.body
		st = body_step.index
		st_diag = body_step.diagnostics

		match body_step.body:
			Some(body_expr):
				end_span = parsed_expr_location(body_expr)
			None:
				end_span = materialize_location(state, colon_step.span)

	{
		index = st,
		diagnostics = st_diag,
		value = {
			name = name_step.value,
			params = params_step.values,
			return_type = return_type,
			body = body,
			is_pure = is_pure,
			span = location_cover(start_span, end_span)
		}
	}


private pure func parse_trait_method_list(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseTraitMethodListStep:
	var st: Int = skip_newlines(state, index)
	var st_diag: List[ParseDiagnostic] = diagnostics
	var values: List[ParsedTraitMethodDecl] = []

	while not current_is_block_end(state, st):
		before_index: Int = st
		method_step: ParseTraitMethodStep = parse_trait_method(state, st, st_diag)
		values = values.append(method_step.value)
		st = skip_newlines(state, method_step.index)
		st_diag = method_step.diagnostics

		if st == before_index and not current_is_block_end(state, st):
			st = advance_parser(state, st)

	{
		index = st,
		diagnostics = st_diag,
		values = values
	}


private pure func parse_trait_decl(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	doc: Option[String],
	start_span: SourceLocation,
) -> ParseDeclStep:
	var st: Int = advance_parser(state, index)
	var st_diag: List[ParseDiagnostic] = diagnostics
	name_step: ParseIdentifierStep = parse_declared_name_expected(state, st, st_diag, "trait name")
	st = name_step.index
	st_diag = name_step.diagnostics
	type_params_step: ParseTypeParamListStep = parse_type_params_opt(state, st, st_diag)
	st = type_params_step.index
	st_diag = type_params_step.diagnostics
	colon_step: ParseSymbolStep = expect_symbol(state, st, ColonSymbol)
	colon_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
		state,
		st_diag,
		colon_step,
		ColonSymbol,
		"expected `:` after trait name",
	)
	st = colon_step.index
	st_diag = colon_step_diagnostics
	var supertraits: List[ParsedIdentifier] = []
	var methods: List[ParsedTraitMethodDecl] = []
	var has_method_block: Bool = False
	var end_span: SourceLocation = name_step.value.span

	if current_is_newline(state, st):
		has_method_block = True
	else if current_is_block_end(state, st):
		st_diag = add_expected_error(
			state,
			st_diag,
			current_location(
				state,
				st,
			),
			"expected supertrait or trait method block",
			["supertrait", "trait method block"],
			None,
		)
	else:
		supertraits_step: ParseIdentifierListStep = parse_plus_separated_identifier_list(
			state,
			st,
			st_diag,
			"supertrait name",
		)
		supertraits = supertraits_step.values
		st = supertraits_step.index
		st_diag = supertraits_step.diagnostics
		end_span = last_identifier_span(supertraits, end_span)

		if current_is_symbol(state, st, ColonSymbol):
			second_colon_step: ParseSymbolStep = expect_symbol(state, st, ColonSymbol)
			second_colon_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
				state,
				st_diag,
				second_colon_step,
				ColonSymbol,
				"expected `:` before trait methods",
			)
			st = second_colon_step.index
			st_diag = second_colon_step_diagnostics
			has_method_block = True

	if has_method_block:
		__step_29: ParserStep = expect_newline(state, st)
		__step_29_diagnostics: List[ParseDiagnostic] = expect_newline_diagnostics(
			state,
			st_diag,
			__step_29,
			"expected newline before trait methods",
		)
		st = __step_29.index
		st_diag = __step_29_diagnostics
		__step_30: ParserStep = expect_indent(state, st)
		__step_30_diagnostics: List[ParseDiagnostic] = expect_indent_diagnostics(
			state,
			st_diag,
			__step_30,
		)
		st = __step_30.index
		st_diag = __step_30_diagnostics
		methods_step: ParseTraitMethodListStep = parse_trait_method_list(state, st, st_diag)
		methods = methods_step.values
		st = methods_step.index
		st_diag = methods_step.diagnostics

		if current_is_dedent(state, st):
			end_span = current_location(state, st)

		__step_31: ParserStep = expect_dedent(state, st)
		__step_31_diagnostics: List[ParseDiagnostic] = expect_dedent_diagnostics(
			state,
			st_diag,
			__step_31,
		)
		st = __step_31.index
		st_diag = __step_31_diagnostics

	{
		index = st,
		diagnostics = st_diag,
		value = TraitParsedDecl({
			name = name_step.value,
			type_params = type_params_step.values,
			supertraits = supertraits,
			methods = methods,
			doc = doc,
			span = location_cover(start_span, end_span),
		})
	}


private pure func parse_impl_method_list(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseImplMethodListStep:
	var st: Int = skip_newlines(state, index)
	var st_diag: List[ParseDiagnostic] = diagnostics
	var values: List[ParsedFunctionDecl] = []

	while not current_is_block_end(state, st):
		before_index: Int = st
		var method_start_span: SourceLocation = current_location(state, st)
		annotations_step: ParseFunctionAnnotationsStep = parse_function_annotations(
			state,
			st,
			st_diag,
			True,
		)

		if annotations_step.values.length() > 0:
			method_start_span = current_location(state, st)

		st = annotations_step.index
		st_diag = annotations_step.diagnostics
		var is_pure: Bool = False

		if current_is_keyword(state, st, PureKeyword):
			is_pure = True

			if annotations_step.values.length() == 0:
				method_start_span = current_location(state, st)

			st = advance_parser(state, st)

		if current_is_keyword(state, st, FuncKeyword):
			function_step: ParseFunctionStep = parse_function_decl_value(
				state,
				st,
				st_diag,
				None,
				is_pure,
				annotations_step.values,
				method_start_span,
			)
			values = values.append(function_step.value)
			st = skip_newlines(state, function_step.index)
			st_diag = function_step.diagnostics
		else:
			st_diag = add_expected_error(
				state,
				st_diag,
				current_location(state, st),
				"expected implementation method",
				["func"],
				Some("write a function declaration inside the implements block"),
			)

			if not current_is_block_end(state, st):
				st = advance_parser(state, st)

		if st == before_index and not current_is_block_end(state, st):
			st = advance_parser(state, st)

	{
		index = st,
		diagnostics = st_diag,
		values = values
	}


private pure func parse_impl_decl(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	doc: Option[String],
	start_span: SourceLocation,
) -> ParseDeclStep:
	var st: Int = advance_parser(state, index)
	var st_diag: List[ParseDiagnostic] = diagnostics
	trait_name_step: ParseIdentifierStep = parse_identifier_expected(
		state,
		st,
		st_diag,
		"trait name",
	)
	st = trait_name_step.index
	st_diag = trait_name_step.diagnostics
	__step_32: ParserStep = expect_keyword(state, st, ForKeyword)
	__step_32_diagnostics: List[ParseDiagnostic] = expect_keyword_diagnostics(
		state,
		st_diag,
		__step_32,
		"for",
		"expected `for` after trait name",
	)
	st = __step_32.index
	st_diag = __step_32_diagnostics
	for_type_step: ParseTypeStep = parse_type_expr(state, st, st_diag)
	st = for_type_step.index
	st_diag = for_type_step.diagnostics
	colon_step: ParseSymbolStep = expect_symbol(state, st, ColonSymbol)
	colon_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
		state,
		st_diag,
		colon_step,
		ColonSymbol,
		"expected `:` before implementation methods",
	)
	__step_33: ParserStep = expect_newline(state, colon_step.index)
	__step_33_diagnostics: List[ParseDiagnostic] = expect_newline_diagnostics(
		state,
		colon_step_diagnostics,
		__step_33,
		"expected newline before implementation methods",
	)
	st = __step_33.index
	st_diag = __step_33_diagnostics
	__step_34: ParserStep = expect_indent(state, st)
	__step_34_diagnostics: List[ParseDiagnostic] = expect_indent_diagnostics(
		state,
		st_diag,
		__step_34,
	)
	st = __step_34.index
	st_diag = __step_34_diagnostics
	methods_step: ParseImplMethodListStep = parse_impl_method_list(state, st, st_diag)
	st = methods_step.index
	st_diag = methods_step.diagnostics

	end_span: SourceLocation = if current_is_dedent(state, st):
		current_location(state, st)
	else:
		parsed_type_expr_location(for_type_step.value)

	__step_35: ParserStep = expect_dedent(state, st)
	__step_35_diagnostics: List[ParseDiagnostic] = expect_dedent_diagnostics(
		state,
		st_diag,
		__step_35,
	)
	st = __step_35.index
	st_diag = __step_35_diagnostics

	{
		index = st,
		diagnostics = st_diag,
		value = ImplParsedDecl({
			trait_name = trait_name_step.value,
			for_type = for_type_step.value,
			methods = methods_step.values,
			doc = doc,
			span = location_cover(start_span, end_span),
		})
	}


private pure func parse_top_level_var_decl(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	is_mutable: Bool,
	start_span: SourceLocation,
) -> ParseDeclStep:
	var st: Int = if is_mutable:
		advance_parser(state, index)
	else:
		index

	var st_diag: List[ParseDiagnostic] = diagnostics

	name_step: ParseIdentifierStep = parse_binder_identifier_expected(
		state,
		st,
		st_diag,
		"variable name",
	)
	type_step: ParseOptionalTypeStep = parse_optional_type_annotation(
		state,
		name_step.index,
		name_step.diagnostics,
	)
	st = type_step.index
	st_diag = type_step.diagnostics

	equal_step: ParseSymbolStep = expect_symbol(state, st, EqualSymbol)
	equal_step_diagnostics: List[ParseDiagnostic] = expect_symbol_diagnostics(
		state,
		st_diag,
		equal_step,
		EqualSymbol,
		"expected `=` after top-level variable declaration",
	)
	value_step: ParseExprStep = parse_assignment_value_expr(
		state,
		equal_step.index,
		equal_step_diagnostics,
		start_span,
	)

	{
		index = value_step.index,
		diagnostics = value_step.diagnostics,
		value = VarParsedDecl({
			name = name_step.value,
			type_expr = type_step.value,
			value = value_step.value,
			is_mutable = is_mutable,
			span = location_cover(start_span, parsed_expr_location(value_step.value)),
		})
	}


private pure func parse_private_decl(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
	doc: Option[String],
	start_span: SourceLocation,
) -> ParseDeclStep:
	var st: Int = advance_parser(state, index)
	var st_diag: List[ParseDiagnostic] = diagnostics
	var inner_start_span: SourceLocation = start_span

	annotations_step: ParseFunctionAnnotationsStep = parse_function_annotations(
		state,
		st,
		st_diag,
		False,
	)

	st = annotations_step.index
	st_diag = annotations_step.diagnostics

	var is_pure: Bool = False

	if current_is_keyword(state, st, PureKeyword):
		is_pure = True

		st = advance_parser(state, st)

	if annotations_step.values.length() > 0 and not current_is_keyword(state, st, FuncKeyword):
		st_diag = add_expected_error(
			state,
			st_diag,
			current_location(state, st),
			"function annotations must be followed by a function declaration",
			["func"],
			Some("move the annotation onto a function declaration, or remove it"),
		)

	inner_step: ParseDeclStep = if current_is_keyword(state, st, FuncKeyword):
		parse_function_decl(
			state,
			st,
			st_diag,
			doc,
			is_pure,
			annotations_step.values,
			inner_start_span,
		)
	else if current_is_keyword(state, st, VarKeyword):
		parse_top_level_var_decl(state, st, st_diag, True, inner_start_span)
	else if current_is_keyword(state, st, RecordKeyword):
		parse_record_decl(state, st, st_diag, doc, RecordDeclarationSyntax, inner_start_span)
	else if current_is_keyword(state, st, StructKeyword):
		parse_record_decl(state, st, st_diag, doc, StructDeclarationSyntax, inner_start_span)
	else if current_is_keyword(state, st, UnionKeyword):
		parse_union_decl(state, st, st_diag, doc, False, inner_start_span)
	else if current_is_keyword(state, st, EnumKeyword):
		parse_union_decl(state, st, st_diag, doc, True, inner_start_span)
	else if current_is_keyword(state, st, TypeKeyword):
		if next_is_keyword(state, st, AliasKeyword):
			parse_type_alias_decl(state, st, st_diag, doc, False, inner_start_span)
		else:
			parse_builtin_type_decl(state, st, st_diag, doc, False, inner_start_span)
	else if current_is_keyword(state, st, OpaqueKeyword):
		parse_type_alias_decl(state, st, st_diag, doc, True, inner_start_span)
	else if current_is_keyword(state, st, ResourceKeyword):
		parse_builtin_type_decl(state, st, st_diag, doc, True, inner_start_span)
	else if current_is_keyword(state, st, TraitKeyword):
		parse_trait_decl(state, st, st_diag, doc, inner_start_span)
	else if current_is_keyword(state, st, ImplementsKeyword):
		parse_impl_decl(state, st, st_diag, doc, inner_start_span)
	else:
		match current_tag(state, st):
			IdentifierTag:
				parse_top_level_var_decl(state, st, st_diag, False, inner_start_span)
			KeywordTag:
				if current_reserved_keyword_starts_binding(state, st):
					parse_top_level_var_decl(state, st, st_diag, False, inner_start_span)
				else:
					parse_error_decl(state, st, st_diag)
			_:
				parse_error_decl(state, st, st_diag)

	{
		index = inner_step.index,
		diagnostics = inner_step.diagnostics,
		value = PrivateParsedDecl(
			inner_step.value,
			location_cover(start_span, parsed_decl_location(inner_step.value)),
		)
	}


private pure func parse_decl(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseDeclStep:
	var st: Int = skip_newlines(state, index)
	var st_diag: List[ParseDiagnostic] = diagnostics
	var doc: Option[String] = None
	var start_span: SourceLocation = current_location(state, st)

	match current_tag(state, st):
		DocStringTag:
			doc = Some(current_text(state, st))
			start_span = current_location(state, st)
			st = advance_parser(state, st)
			st = skip_newlines(state, st)
		_:
			void

	annotations_step: ParseFunctionAnnotationsStep = parse_function_annotations(
		state,
		st,
		st_diag,
		True,
	)

	if annotations_step.values.length() > 0 and doc.is_none():
		start_span = current_location(state, st)

	st = annotations_step.index
	st_diag = annotations_step.diagnostics

	var is_pure: Bool = False

	if current_is_keyword(state, st, PureKeyword):
		is_pure = True

		if doc.is_none() and annotations_step.values.length() == 0:
			start_span = current_location(state, st)

		st = advance_parser(state, st)

	if annotations_step.values.length() > 0 and not current_is_keyword(state, st, FuncKeyword):
		st_diag = add_expected_error(
			state,
			st_diag,
			current_location(state, st),
			"function annotations must be followed by a function declaration",
			["func"],
			Some("move the annotation onto a function declaration, or remove it"),
		)

	if current_is_keyword(state, st, PrivateKeyword):
		parse_private_decl(state, st, st_diag, doc, start_span)
	else if current_is_keyword(state, st, ImportKeyword):
		parse_import_block_decl(state, st, st_diag, start_span)
	else if current_is_keyword(state, st, ForeignKeyword):
		parse_foreign_block_decl(state, st, st_diag, start_span)
	else if current_is_keyword(state, st, FuncKeyword):
		parse_function_decl(state, st, st_diag, doc, is_pure, annotations_step.values, start_span)
	else if current_is_keyword(state, st, VarKeyword):
		parse_top_level_var_decl(state, st, st_diag, True, start_span)
	else if current_is_keyword(state, st, RecordKeyword):
		parse_record_decl(state, st, st_diag, doc, RecordDeclarationSyntax, start_span)
	else if current_is_keyword(state, st, StructKeyword):
		parse_record_decl(state, st, st_diag, doc, StructDeclarationSyntax, start_span)
	else if current_is_keyword(state, st, UnionKeyword):
		parse_union_decl(state, st, st_diag, doc, False, start_span)
	else if current_is_keyword(state, st, EnumKeyword):
		parse_union_decl(state, st, st_diag, doc, True, start_span)
	else if current_is_keyword(state, st, TypeKeyword):
		if next_is_keyword(state, st, AliasKeyword):
			parse_type_alias_decl(state, st, st_diag, doc, False, start_span)
		else:
			parse_builtin_type_decl(state, st, st_diag, doc, False, start_span)
	else if current_is_keyword(state, st, OpaqueKeyword):
		parse_type_alias_decl(state, st, st_diag, doc, True, start_span)
	else if current_is_keyword(state, st, ResourceKeyword):
		parse_builtin_type_decl(state, st, st_diag, doc, True, start_span)
	else if current_is_keyword(state, st, TraitKeyword):
		parse_trait_decl(state, st, st_diag, doc, start_span)
	else if current_is_keyword(state, st, ImplementsKeyword):
		parse_impl_decl(state, st, st_diag, doc, start_span)
	else:
		match current_tag(state, st):
			IdentifierTag:
				parse_top_level_var_decl(state, st, st_diag, False, start_span)
			KeywordTag:
				if current_reserved_keyword_starts_binding(state, st):
					parse_top_level_var_decl(state, st, st_diag, False, start_span)
				else:
					parse_error_decl(state, st, st_diag)
			_:
				parse_error_decl(state, st, st_diag)


private pure func parse_error_decl(
	state: ParserInput,
	index: Int,
	diagnostics: List[ParseDiagnostic],
) -> ParseDeclStep:
	error_span: SourceLocation = current_location(state, index)
	next_state: Int = index
	next_state_diag: List[ParseDiagnostic] = add_expected_error(
		state,
		diagnostics,
		error_span,
		"expected declaration",
		[EXPECTED_DECLARATION],
		Some("start a function declaration with `func`"),
	)

	recovery_state: Int = if current_is_eof(state, next_state):
		next_state
	else:
		advance_parser(state, next_state)

	{
		index = recovery_state,
		diagnostics = next_state_diag,
		value = ParsedErrorDecl(error_span)
	}


-- Parse a synthetic source while storing its authored locations at a caller-
-- supplied offset in the owning source file. Parser control and diagnostics
-- remain local to `source`; only retained AST locations are rebased.
pure func parse_compiler_source_rebased(
	source: SourceFile,
	location_offset_delta: Int,
) -> ParsedProgram:
	lex_result = lex(source)
	state: ParserInput = initial_state(
		source,
		lex_result.tokens,
		lex_result.texts,
		lex_result.path,
		lex_result.module_name,
		location_offset_delta,
	)
	var index: Int = skip_newlines(state, 0)
	var diagnostics: List[ParseDiagnostic] = lex_result.diagnostics
	var decls: List[ParsedDecl] = []

	while not current_is_eof(state, index):
		before_index: Int = index
		decl_step: ParseDeclStep = parse_decl(state, index, diagnostics)
		decls = decls.append(decl_step.value)
		index = skip_newlines(state, decl_step.index)
		diagnostics = decl_step.diagnostics

		if index == before_index and not current_is_eof(state, index):
			index = advance_parser(state, index)

	{
		source = source,
		decls = decls,
		diagnostics = diagnostics
	}


pure func parse_compiler_source(source: SourceFile) -> ParsedProgram:
	parse_compiler_source_rebased(source, 0)
