private EXPECTED_DECLARATION: String = "declaration"

private EXPECTED_EXPRESSION: String = "expression"

private EXPECTED_FUNCTION_NAME: String = "function name"

private EXPECTED_FUNCTION_ANNOTATION: String = "function annotation"

private EXPECTED_CONSTRUCTOR_NAME: String = "constructor name"

private EXPECTED_PARAMETER_NAME: String = "parameter name"

private EXPECTED_TYPE: String = "type"

private EXPECTED_FOREIGN_BLOCK_ARG: String = "foreign block argument"

private EXPECTED_CONCURRENT_PARAM: String = "concurrent parameter"

private PREC_LOWEST: Int = 0

private PREC_ASCRIPTION: Int = 0

private PREC_OR: Int = 1

private PREC_AND: Int = 2

private PREC_COMPARE: Int = 3

private PREC_RANGE: Int = 4

private PREC_ADD: Int = 5

private PREC_MULTIPLY: Int = 6


private pure func parsed_string_literal_form(kind: StringLiteralKind) -> ParsedStringLiteralForm:
	match kind:
		RawStringLiteral:
			ParsedRawStringLiteral
		PipeStringLiteral:
			ParsedPipeStringLiteral
		RawPipeStringLiteral:
			ParsedRawPipeStringLiteral
		_:
			ParsedPlainStringLiteral


-- Token storage as columns (struct of arrays) instead of a `List[Token]`
-- (array of structs): reading one field of one token -- the common case,
-- several times per parse decision -- is one scalar list index instead
-- of copying all ten fields out of an inline list to reach one of them.
-- Built once from the lexer's `List[Token]` by `initial_state`.
private record ParserInput {
	source: SourceFile,
	file_id: SourceFileId,
	location_offset_delta: Int,
	tags: List[TokenTag],
	payloads: List[Int],
	start_offsets: List[Int],
	start_lines: List[Int],
	start_columns: List[Int],
	end_offsets: List[Int],
	end_lines: List[Int],
	end_columns: List[Int],
	trivia_starts: List[Int],
	trivia_counts: List[Int],
	texts: List[String]
}


private struct ParserStep {
	index: Int,
	matched: Bool
}


-- Parse results that publish diagnostics or syntax values remain records,
-- unlike the scalar-only hot expectation result above.
private record ParseDeclStep {
	index: Int,
	diagnostics: List[ParseDiagnostic],
	value: ParsedDecl
}


private record ParseFunctionStep {
	index: Int,
	diagnostics: List[ParseDiagnostic],
	value: ParsedFunctionDecl
}


private record ParseIdentifierStep {
	index: Int,
	diagnostics: List[ParseDiagnostic],
	value: ParsedIdentifier
}


private record ParseTypeStep {
