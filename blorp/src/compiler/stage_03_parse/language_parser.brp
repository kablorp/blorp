private EXPECTED_DECLARATION: String = "declaration"

private EXPECTED_EXPRESSION: String = "expression"

private EXPECTED_FUNCTION_NAME: String = "function name"

private EXPECTED_FUNCTION_ANNOTATION: String = "function annotation"

private EXPECTED_CONSTRUCTOR_NAME: String = "constructor name"

private EXPECTED_PARAMETER_NAME: String = "parameter name"

private EXPECTED_TYPE: String = "type"

private EXPECTED_FOREIGN_BLOCK_ARG: String = "foreign block argument"

private EXPECTED_CONCURRENT_PARAM: String = "concurrent parameter"

private PREC_LOWEST: Int = 0

private PREC_ASCRIPTION: Int = 0

private PREC_OR: Int = 1

private PREC_AND: Int = 2

private PREC_COMPARE: Int = 3

private PREC_RANGE: Int = 4

private PREC_ADD: Int = 5

private PREC_MULTIPLY: Int = 6


private pure func parsed_string_literal_form(kind: StringLiteralKind) -> ParsedStringLiteralForm:
	match kind:
		RawStringLiteral:
			ParsedRawStringLiteral
		PipeStringLiteral:
			ParsedPipeStringLiteral
		RawPipeStringLiteral:
			ParsedRawPipeStringLiteral
		_:
			ParsedPlainStringLiteral


