-- Source-AST finalization for typecheck-ready parser artifacts.
--
-- Raw parser consumers need to see syntax as written. Compile/check/run need a
-- source AST where parser-owned sugar has already been normalized. This module
-- owns those parser-adjacent rewrites one slice at a time.
import:
	../../lib/source: SourceFile, SourceSpan, source_file
	../stage_02_lex/parse_diagnostic: ParseDiagnostic, parse_error
	language_parser: parse_compiler_source
	parsed_ast:
		ParsedBinaryOp,
		ParsedConcurrentParam,
		ParsedDecl(
			BuiltinTypeParsedDecl,
			ForeignBlockParsedDecl,
			FunctionParsedDecl,
			ImplParsedDecl,
			ImportBlockParsedDecl,
			ParsedErrorDecl,
			PrivateParsedDecl,
			RecordParsedDecl,
			TraitParsedDecl,
			TypeAliasParsedDecl,
			UnionParsedDecl,
			VarParsedDecl,
		),
		ParsedDictEntry,
		ParsedExpr(
			ParsedAssignExpr,
			ParsedAscriptionExpr,
			ParsedBinaryExpr,
			ParsedBlockExpr,
			ParsedBoolLiteralExpr,
			ParsedBreakExpr,
			ParsedBuiltinExpr,
			ParsedCallExpr,
			ParsedCharLiteralExpr,
			ParsedCompoundAssignExpr,
			ParsedConcurrentBlockExpr,
			ParsedConcurrentForExpr,
			ParsedContinueExpr,
			ParsedDebugBlockExpr,
			ParsedDetachExpr,
			ParsedDictExpr,
			ParsedFieldAccessExpr,
			ParsedFloatLiteralExpr,
			ParsedForExpr,
			ParsedFunctionDeclExpr,
			ParsedIfExpr,
			ParsedIntLiteralExpr,
			ParsedLambdaExpr,
			ParsedListExpr,
			ParsedLogicalExpr,
			ParsedMatchExpr,
			ParsedMissingExpr,
			ParsedNameExpr,
			ParsedOpaqueFromExpr,
			ParsedOpaqueIntoExpr,
			ParsedQuestionBindExpr,
			ParsedRangeExpr,
			ParsedRecordExpr,
			ParsedRecordUpdateExpr,
			ParsedSelectExpr,
			ParsedStringInterpolationExpr,
			ParsedStringInterpolationPartsExpr,
			ParsedStringLiteralExpr,
			ParsedSubscriptAssignExpr,
			ParsedSubscriptExpr,
			ParsedTupleDestructExpr,
			ParsedTupleExpr,
			ParsedUnaryExpr,
			ParsedVarDeclExpr,
			ParsedVectorExpr,
			ParsedVoidExpr,
			ParsedWhileExpr,
			ParsedWithExpr,
		),
		ParsedForBinder(ParsedForNameBinder, ParsedForTupleBinder),
		ParsedFunctionDecl,
		ParsedIdentifier,
		ParsedImportDecl,
		ParsedListPatternSpread(ParsedListSpreadName, ParsedListSpreadWildcard),
		ParsedLogicalOp,
		ParsedMatchCase,
		ParsedParam,
		ParsedParamBinder(ParsedParamNameBinder, ParsedParamTupleBinder, ParsedParamWildcardBinder),
		ParsedPattern(
			ParsedBoolPattern,
			ParsedCharPattern,
			ParsedConstructorPattern,
			ParsedFloatPattern,
			ParsedIntPattern,
			ParsedListPattern,
			ParsedMissingPattern,
			ParsedNamePattern,
			ParsedOrPattern,
			ParsedQualifiedConstructorPattern,
			ParsedStringPattern,
			ParsedTuplePattern,
			ParsedWildcardPattern,
		),
		ParsedProgram,
		ParsedRecordExprField,
		ParsedSelectArm,
		ParsedSelectArmKind(ParsedSelectAfterArm, ParsedSelectReceiveArm, ParsedSelectSealedArm),
		ParsedStringInterpolationPart(ParsedInterpolationExpr, ParsedInterpolationLiteral),
		ParsedTraitMethodDecl,
		ParsedVarDecl,
		ParsedWithBinding,
		ParsedWithErrorMap,
	string: string


opaque type FinalizedTypecheckProgram = ParsedProgram


record FinalizedImportPathRewrite {
	from_path: String,
	from_module: String,
	import_path: String,
	resolved_module: String
}


union StringInterpolationRawPart:
	InterpolationLiteralText(String)
	InterpolationExprText(String)


record UnicodeEscapeResult {
	value: Option[Char],
	next_index: Int
}


record ParsedExprOptionResult {
	value: Option[ParsedExpr],
	diagnostics: List[ParseDiagnostic]
}


record ParsedExprResult {
	value: ParsedExpr,
	diagnostics: List[ParseDiagnostic]
}


private union ParsedLogicalFinalizeFrame:
	ParsedLogicalFinalizeVisitRightFrame(ParsedLogicalOp, ParsedExpr, SourceSpan)
	ParsedLogicalFinalizeRebuildParentFrame(ParsedLogicalOp, ParsedExprResult, SourceSpan)


private union ParsedLogicalFinalizeFrameStack:
	ParsedLogicalFinalizeNoFrame
	ParsedLogicalFinalizeMoreFrames(ParsedLogicalFinalizeFrame, ParsedLogicalFinalizeFrameStack)


private union ParsedLogicalFinalizeAction:
	ParsedLogicalFinalizeVisitExpr(ParsedExpr)
	ParsedLogicalFinalizeRebuildExpr(ParsedExprResult)


record InterpolationPartsResult {
	parts: List[ParsedStringInterpolationPart],
	diagnostics: List[ParseDiagnostic]
}


record ParsedExprsResult {
	values: List[ParsedExpr],
	diagnostics: List[ParseDiagnostic]
}


record RecordFieldsResult {
	fields: List[ParsedRecordExprField],
	diagnostics: List[ParseDiagnostic]
}


record DictEntriesResult {
	entries: List[ParsedDictEntry],
	diagnostics: List[ParseDiagnostic]
}


record MatchCasesResult {
	cases: List[ParsedMatchCase],
	diagnostics: List[ParseDiagnostic]
}


record SelectArmKindResult {
	kind: ParsedSelectArmKind,
	diagnostics: List[ParseDiagnostic]
}


record SelectArmsResult {
	arms: List[ParsedSelectArm],
	diagnostics: List[ParseDiagnostic]
}


record ConcurrentParamsResult {
	params: List[ParsedConcurrentParam],
	diagnostics: List[ParseDiagnostic]
}


record WithErrorMapResult {
	value: Option[ParsedWithErrorMap],
	diagnostics: List[ParseDiagnostic]
}


record WithBindingResult {
	binding: ParsedWithBinding,
	diagnostics: List[ParseDiagnostic]
}


record FunctionDeclResult {
	decl: ParsedFunctionDecl,
	diagnostics: List[ParseDiagnostic]
}


record VarDeclResult {
	decl: ParsedVarDecl,
	diagnostics: List[ParseDiagnostic]
}


record TraitMethodResult {
	method: ParsedTraitMethodDecl,
	diagnostics: List[ParseDiagnostic]
}


record TraitMethodsResult {
	methods: List[ParsedTraitMethodDecl],
	diagnostics: List[ParseDiagnostic]
}


record FunctionDeclsResult {
	functions: List[ParsedFunctionDecl],
	diagnostics: List[ParseDiagnostic]
}


record IdentifierReference {
	name: String,
	qualified_member: Option[String],
	span: SourceSpan
}


record NameRewrite {
	old_name: String,
	new_name: String
}


record HoistExprResult {
	value: ParsedExpr,
	hoisted: List[ParsedFunctionDecl],
	diagnostics: List[ParseDiagnostic],
	next_id: Int
}


record HoistFunctionResult {
	decl: ParsedFunctionDecl,
	hoisted: List[ParsedFunctionDecl],
	diagnostics: List[ParseDiagnostic],
	next_id: Int
}


record HoistFunctionDeclsResult {
	functions: List[ParsedFunctionDecl],
	hoisted: List[ParsedFunctionDecl],
	diagnostics: List[ParseDiagnostic],
	next_id: Int
}


record HoistBlockResult {
	value: List[ParsedExpr],
	hoisted: List[ParsedFunctionDecl],
	diagnostics: List[ParseDiagnostic],
	next_id: Int
}


record HoistDeclsResult {
	decls: List[ParsedDecl],
	diagnostics: List[ParseDiagnostic]
}


record DeclResult {
	decl: ParsedDecl,
	diagnostics: List[ParseDiagnostic]
}


record DeclsResult {
	decls: List[ParsedDecl],
	diagnostics: List[ParseDiagnostic]
}


private pure func names_from_identifiers(items: List[ParsedIdentifier]) -> List[String]:
	items.map(func(item): item.text)


private pure func names_without(names: List[String], excluded: List[String]) -> List[String]:
	var kept: List[String] = []

	for name in names:
		if not excluded.contains(name):
			kept = kept.append(name)

	kept


private pure func param_bound_names(param: ParsedParam) -> List[String]:
	match param.binder:
		ParsedParamNameBinder(name):
			[name.text]
		ParsedParamTupleBinder(names, _):
			names_from_identifiers(names)
		ParsedParamWildcardBinder(_):
			[]


private pure func params_bound_names(params: List[ParsedParam]) -> List[String]:
	var names: List[String] = []

	for param in params:
		names = names.concat(param_bound_names(param))

	names


private pure func for_binder_bound_names(binder: ParsedForBinder) -> List[String]:
	match binder:
		ParsedForNameBinder(name):
			[name.text]
		ParsedForTupleBinder(names, _):
			names_from_identifiers(names)


private pure func list_spread_bound_names(spread: Option[ParsedListPatternSpread]) -> List[String]:
	match spread:
		Some(ParsedListSpreadName(name)):
			[name.text]
		Some(ParsedListSpreadWildcard(_)):
			[]
		None:
			[]


private pure func pattern_bound_names(pattern: ParsedPattern) -> List[String]:
	match pattern:
		ParsedNamePattern(name):
			[name.text]
		ParsedConstructorPattern(_, args, _):
			patterns_bound_names(args)
		ParsedQualifiedConstructorPattern(_, _, args, _):
			patterns_bound_names(args)
		ParsedTuplePattern(items, _):
			patterns_bound_names(items)
		ParsedListPattern(items, spread, _):
			patterns_bound_names(items).concat(list_spread_bound_names(spread))
		ParsedOrPattern(items, _):
			patterns_bound_names(items)
		_:
			[]


private pure func patterns_bound_names(patterns: List[ParsedPattern]) -> List[String]:
	patterns.flat_map(func(pattern): pattern_bound_names(pattern))


private pure func mangle_nested_function_name(
	parent_name: String,
	nested_name: String,
	id: Int,
) -> String:
	"__nested_" + parent_name + "_" + nested_name + "_" + id.to_string()


private pure func nested_capture_diagnostic(
	nested_name: String,
	parent_name: String,
	captured_name: String,
	span: SourceSpan,
) -> ParseDiagnostic:
	parse_error(
		span,
		"Nested function '" + nested_name + "' cannot capture parent-scope identifier '" + captured_name + "'",
	)


private pure func first_parse_error(diagnostics: List[ParseDiagnostic]) -> Option[ParseDiagnostic]:
	var result: Option[ParseDiagnostic] = None

	for diagnostic in diagnostics:
		if result.is_none():
			result = Some(diagnostic)

	result


private pure func hex_value(ch: Char) -> Int:
	if ch >= '0' and ch <= '9':
		to_int(ch) - to_int('0')
	else if ch >= 'a' and ch <= 'f':
		10 + to_int(ch) - to_int('a')
	else:
		10 + to_int(ch) - to_int('A')


private pure func decode_unicode_escape_at(text: String, start: Int) -> UnicodeEscapeResult:
	var index: Int = start + 3
	var value: Int = 0
	var digits: Int = 0
	var valid: Bool = True
	var closed: Bool = False

	while (
		index < text.length()
		and valid
		and not closed
	):
		match text.get(index):
			Some('}'):
				closed = True
			Some(ch):
				if (
					ch >= '0' and ch <= '9'
					or ch >= 'a' and ch <= 'f'
					or ch >= 'A' and ch <= 'F'
				):
					value = value * 16 + hex_value(ch)
					digits += 1
					index += 1
				else:
					valid = False
			None:
				valid = False

	-- Unicode scalar values exclude UTF-16 surrogates and values above U+10FFFF.
	if (
		closed
		and digits > 0
		and digits <= 6
		and not (value > 1114111 or value >= 55296 and value <= 57343)
	):
		{
			value = Some(to_char(value)),
			next_index = index + 1
		}
	else:
		{
			value = None,
			next_index = start + 1
		}


private pure func append_lit_part(
	parts: List[StringInterpolationRawPart],
	literal: String,
) -> List[StringInterpolationRawPart]:
	if literal.length() == 0:
		parts
	else:
		parts.append(InterpolationLiteralText(literal))


pure func split_interpolated_string(
	span: SourceSpan,
	text: String,
) -> Result[List[StringInterpolationRawPart], ParseDiagnostic]:
	var parts: List[StringInterpolationRawPart] = []
	var literal: String = string(64)
	var index: Int = 0
	var error: Option[ParseDiagnostic] = None

	while index < text.length() and error.is_none():
		ch: Char = text.get_or(index, '\0')

		if ch == '\\' and index + 1 < text.length():
			next: Char = text.get_or(index + 1, '\0')

			if (
				next == 'u'
				and index + 2 < text.length()
				and text.get_or(index + 2, '\0') == '{'
			):
				decoded = decode_unicode_escape_at(text, index)

				match decoded.value:
					Some(value):
						literal = literal.append_char(value)
					None:
						literal = literal.append_char(ch)

				index = decoded.next_index
			else:
				match next:
					'n':
						literal += "\n"
						index += 2
					't':
						literal += "\t"
						index += 2
					'r':
						literal += "\r"
						index += 2
					'\\':
						literal = literal.append_char('\\')
						index += 2
					'\"':
						literal = literal.append_char('\"')
						index += 2
					'\'':
						literal = literal.append_char('\'')
						index += 2
					'0':
						literal = literal.append_char('\0')
						index += 2
					'{':
						literal = literal.append_char('{')
						index += 2
					'}':
						literal = literal.append_char('}')
						index += 2
					_:
						literal = literal.append_char(ch)
						index += 1
		else if ch == '{':
			parts = append_lit_part(parts, literal)
			literal = ""
			index += 1

			var expr_text: String = string(32)
			var depth: Int = 1
			var in_string: Bool = False

			while index < text.length() and depth > 0:
				current: Char = text.get_or(index, '\0')

				if current == '\\' and index + 1 < text.length():
					expr_text = expr_text.append_char(current)
					expr_text = expr_text.append_char(text.get_or(index + 1, '\0'))
					index += 2
				else if current == '\"':
					in_string = not in_string
					expr_text = expr_text.append_char(current)
					index += 1
				else if in_string:
					expr_text = expr_text.append_char(current)
					index += 1
				else if current == '{':
					depth += 1
					expr_text = expr_text.append_char(current)
					index += 1
				else if current == '}':
					depth -= 1

					if depth > 0:
						expr_text = expr_text.append_char(current)

					index += 1
				else:
					expr_text = expr_text.append_char(current)
					index += 1

			if depth > 0:
				error = Some(parse_error(span, "Unclosed `" + "$" + "{` in string interpolation"))
			else:
				parts = parts.append(InterpolationExprText(expr_text))
		else:
			literal = literal.append_char(ch)
			index += 1

	match error:
		Some(diagnostic):
			Err(diagnostic)
		None:
			Ok(append_lit_part(parts, literal))


private pure func collect_name_reference(
	bound: List[String],
	name: ParsedIdentifier,
) -> List[IdentifierReference]:
	if bound.contains(name.text):
		[]
	else:
		[
			{
				name = name.text,
				qualified_member = None,
				span = name.span
			},
		]


private pure func collect_free_optional_expr(
	bound: List[String],
	value: Option[ParsedExpr],
) -> List[IdentifierReference]:
	match value:
		Some(expr):
			collect_free_identifiers(bound, expr)
		None:
			[]


private pure func collect_free_exprs(
	bound: List[String],
	items: List[ParsedExpr],
) -> List[IdentifierReference]:
	var references: List[IdentifierReference] = []

	for item in items:
		references = references.concat(collect_free_identifiers(bound, item))

	references


private pure func collect_free_record_fields(
	bound: List[String],
	fields: List[ParsedRecordExprField],
) -> List[IdentifierReference]:
	var references: List[IdentifierReference] = []

	for field in fields:
		references = references.concat(collect_free_identifiers(bound, field.value))

	references


private pure func collect_free_dict_entries(
	bound: List[String],
	entries: List[ParsedDictEntry],
) -> List[IdentifierReference]:
	var references: List[IdentifierReference] = []

	for entry in entries:
		references = references.concat(collect_free_identifiers(bound, entry.key))
		references = references.concat(collect_free_identifiers(bound, entry.value))

	references


private pure func collect_free_block(
	bound: List[String],
	items: List[ParsedExpr],
) -> List[IdentifierReference]:
	var current_bound: List[String] = bound
	var references: List[IdentifierReference] = []

	for item in items:
		match item:
			ParsedVarDeclExpr(name, _, value, _, _):
				references = references.concat(collect_free_identifiers(current_bound, value))
				current_bound = current_bound.append(name.text)
			ParsedTupleDestructExpr(names, value, _):
				references = references.concat(collect_free_identifiers(current_bound, value))
				current_bound = names_from_identifiers(names).concat(current_bound)
			ParsedQuestionBindExpr(name, _, value, _):
				references = references.concat(collect_free_identifiers(current_bound, value))
				current_bound = current_bound.append(name.text)
			_:
				references = references.concat(collect_free_identifiers(current_bound, item))

	references


private pure func collect_free_concurrent_block_body(
	bound: List[String],
	body: ParsedExpr,
) -> List[IdentifierReference]:
	match body:
		ParsedBlockExpr(items, _):
			var references: List[IdentifierReference] = []

			for item in items:
				match item:
					ParsedAssignExpr(_, value, _) | ParsedVarDeclExpr(_, _, value, False, _):
						references = references.concat(collect_free_identifiers(bound, value))
					_:
						references = references.concat(collect_free_identifiers(bound, item))

			references
		_:
			collect_free_identifiers(bound, body)


private pure func collect_free_match_cases(
	bound: List[String],
	cases: List[ParsedMatchCase],
) -> List[IdentifierReference]:
	var references: List[IdentifierReference] = []

	for case in cases:
		case_bound: List[String] = pattern_bound_names(case.pattern).concat(bound)
		references = references.concat(collect_free_identifiers(case_bound, case.body))

	references


private pure func collect_free_select_arm_kind(
	bound: List[String],
	kind: ParsedSelectArmKind,
) -> List[IdentifierReference]:
	match kind:
		ParsedSelectReceiveArm(_, channel):
			collect_free_identifiers(bound, channel)
		ParsedSelectSealedArm(channel):
			collect_free_identifiers(bound, channel)
		ParsedSelectAfterArm(timeout):
			collect_free_identifiers(bound, timeout)


private pure func collect_free_select_arms(
	bound: List[String],
	arms: List[ParsedSelectArm],
) -> List[IdentifierReference]:
	var references: List[IdentifierReference] = []

	for arm in arms:
		references = references.concat(collect_free_select_arm_kind(bound, arm.kind))

		body_bound: List[String] = match arm.kind:
			ParsedSelectReceiveArm(name, _):
				[name.text].concat(bound)
			_:
				bound

		references = references.concat(collect_free_identifiers(body_bound, arm.body))

	references


private pure func collect_free_with_error_map(
	bound: List[String],
	error_map: Option[ParsedWithErrorMap],
) -> List[IdentifierReference]:
	match error_map:
		Some(mapper):
			collect_free_identifiers(
				[mapper.name.text].concat(bound),
				mapper.value,
			)
		None:
			[]


private pure func collect_free_concurrent_params(
	bound: List[String],
	params: List[ParsedConcurrentParam],
) -> List[IdentifierReference]:
	var references: List[IdentifierReference] = []

	for param in params:
		references = references.concat(collect_free_identifiers(bound, param.value))

	references


private pure func collect_free_interpolation_parts(
	bound: List[String],
	parts: List[ParsedStringInterpolationPart],
) -> List[IdentifierReference]:
	var references: List[IdentifierReference] = []

	for part in parts:
		match part:
			ParsedInterpolationExpr(expr):
				references = references.concat(collect_free_identifiers(bound, expr))
			ParsedInterpolationLiteral(_):
				void

	references


private pure func collect_free_identifiers(
	bound: List[String],
	expr: ParsedExpr,
) -> List[IdentifierReference]:
	match expr:
		ParsedNameExpr(name):
			collect_name_reference(bound, name)
		ParsedStringInterpolationPartsExpr(parts, _, _):
			collect_free_interpolation_parts(bound, parts)
		ParsedUnaryExpr(_, value, _):
			collect_free_identifiers(bound, value)
		ParsedBinaryExpr(_, left, right, _):
			collect_free_identifiers(bound, left).concat(collect_free_identifiers(bound, right))
		ParsedLogicalExpr(_, left, right, _):
			collect_free_identifiers(bound, left).concat(collect_free_identifiers(bound, right))
		ParsedAscriptionExpr(value, _, _):
			collect_free_identifiers(bound, value)
		ParsedRangeExpr(start, finish, _):
			collect_free_identifiers(bound, start).concat(collect_free_identifiers(bound, finish))
		ParsedCallExpr(callee, args, _):
			collect_free_identifiers(bound, callee).concat(collect_free_exprs(bound, args))
		ParsedFieldAccessExpr(target, field, _):
			match target:
				ParsedNameExpr(qualifier):
					if bound.contains(qualifier.text):
						[]
					else:
						[
							{
								name = qualifier.text,
								qualified_member = Some(field.text),
								span = qualifier.span
							},
						]
				_:
					collect_free_identifiers(bound, target)
		ParsedSubscriptExpr(target, indices, _):
			collect_free_identifiers(bound, target).concat(collect_free_exprs(bound, indices))
		ParsedListExpr(items, _):
			collect_free_exprs(bound, items)
		ParsedTupleExpr(items, _):
			collect_free_exprs(bound, items)
		ParsedRecordExpr(fields, _):
			collect_free_record_fields(bound, fields)
		ParsedRecordUpdateExpr(base, fields, _):
			collect_free_identifiers(bound, base).concat(collect_free_record_fields(bound, fields))
		ParsedDictExpr(entries, _):
			collect_free_dict_entries(bound, entries)
		ParsedVectorExpr(items, _):
			collect_free_exprs(bound, items)
		ParsedOpaqueIntoExpr(_, value, _):
			collect_free_identifiers(bound, value)
		ParsedOpaqueFromExpr(_, value, _):
			collect_free_identifiers(bound, value)
		ParsedBlockExpr(items, _):
			collect_free_block(bound, items)
		ParsedIfExpr(cond, then_expr, else_expr, _):
			collect_free_identifiers(bound, cond)
				.concat(collect_free_identifiers(bound, then_expr))
				.concat(collect_free_optional_expr(bound, else_expr))
		ParsedMatchExpr(value, cases, _):
			collect_free_identifiers(bound, value).concat(collect_free_match_cases(bound, cases))
		ParsedSelectExpr(arms, _):
			collect_free_select_arms(bound, arms)
		ParsedWithExpr(binding, body, _):
			collect_free_identifiers(bound, binding.value)
				.concat(collect_free_with_error_map(bound, binding.error_map))
				.concat(collect_free_identifiers([binding.name.text].concat(bound), body))
		ParsedDebugBlockExpr(body, _):
			collect_free_identifiers(bound, body)
		ParsedLambdaExpr(_, params, _, body, _):
			collect_free_identifiers(
				params
					.map(func(param): param.name.text)
					.concat(bound),
				body,
			)
		ParsedFunctionDeclExpr(_):
			[]
		ParsedWhileExpr(cond, body, _):
			collect_free_identifiers(bound, cond).concat(collect_free_identifiers(bound, body))
		ParsedForExpr(binder, iterable, body, _):
			collect_free_identifiers(
				bound,
				iterable,
			).concat(collect_free_identifiers(for_binder_bound_names(binder).concat(bound), body))
		ParsedConcurrentBlockExpr(params, body, _):
			collect_free_concurrent_params(
				bound,
				params,
			).concat(collect_free_concurrent_block_body(bound, body))
		ParsedConcurrentForExpr(name, iterable, params, body, _):
			collect_free_identifiers(bound, iterable)
				.concat(collect_free_concurrent_params(bound, params))
				.concat(collect_free_identifiers([name.text].concat(bound), body))
		ParsedDetachExpr(body, _):
			collect_free_identifiers(bound, body)
		ParsedVarDeclExpr(_, _, value, _, _):
			collect_free_identifiers(bound, value)
		ParsedAssignExpr(name, value, _):
			collect_name_reference(bound, name).concat(collect_free_identifiers(bound, value))
		ParsedCompoundAssignExpr(name, _, value, _):
			collect_name_reference(bound, name).concat(collect_free_identifiers(bound, value))
		ParsedSubscriptAssignExpr(target, indices, value, _):
			collect_free_identifiers(bound, target)
				.concat(collect_free_exprs(bound, indices))
				.concat(collect_free_identifiers(bound, value))
		ParsedTupleDestructExpr(_, value, _):
			collect_free_identifiers(bound, value)
		ParsedQuestionBindExpr(_, _, value, _):
			collect_free_identifiers(bound, value)
		_:
			[]


-- Initializer planning and other semantic consumers need the same lexical
-- binding rules as nested-function capture analysis. Keep that policy owned
-- by source-AST finalization instead of duplicating a partial expression walk
-- in later compiler stages. Lambda bodies are included because their free
-- values are captured when the closure is created and may also be needed to
-- infer its type. Typed callable-dependency collection separately excludes
-- calls in deferred bodies because creating a closure does not execute them.
pure func parsed_expr_free_identifier_references(expr: ParsedExpr) -> List[IdentifierReference]:
	collect_free_identifiers([], expr)


private pure func find_capture(
	parent_locals: List[String],
	nested_body: ParsedExpr,
) -> Option[IdentifierReference]:
	var captured: Option[IdentifierReference] = None

	for reference in collect_free_identifiers([], nested_body):
		if captured.is_none() and parent_locals.contains(reference.name):
			captured = Some(reference)

	captured


private pure func rewrite_identifier_name(
	name: ParsedIdentifier,
	rewrites: List[NameRewrite],
) -> ParsedIdentifier:
	var rewritten = name

	for rewrite in rewrites:
		if rewritten.text == rewrite.old_name:
			rewritten = { rewritten | text = rewrite.new_name }

	rewritten


private pure func rewrite_identifier_exprs(
	rewrites: List[NameRewrite],
	items: List[ParsedExpr],
) -> List[ParsedExpr]:
	var values: List[ParsedExpr] = []

	for item in items:
		values = values.append(rewrite_identifier_expr(rewrites, item))

	values


private pure func rewrite_identifier_optional_expr(
	rewrites: List[NameRewrite],
	value: Option[ParsedExpr],
) -> Option[ParsedExpr]:
	match value:
		Some(expr):
			Some(rewrite_identifier_expr(rewrites, expr))
		None:
			None


private pure func rewrite_identifier_record_fields(
	rewrites: List[NameRewrite],
	fields: List[ParsedRecordExprField],
) -> List[ParsedRecordExprField]:
	var values: List[ParsedRecordExprField] = []

	for field in fields:
		values = values.append({ field | value = rewrite_identifier_expr(rewrites, field.value) })

	values


private pure func rewrite_identifier_dict_entries(
	rewrites: List[NameRewrite],
	entries: List[ParsedDictEntry],
) -> List[ParsedDictEntry]:
	var values: List[ParsedDictEntry] = []

	for entry in entries:
		values = values.append({ entry |
				key = rewrite_identifier_expr(rewrites, entry.key),
				value = rewrite_identifier_expr(rewrites, entry.value)
			})

	values


private pure func rewrite_identifier_match_cases(
	rewrites: List[NameRewrite],
	cases: List[ParsedMatchCase],
) -> List[ParsedMatchCase]:
	var values: List[ParsedMatchCase] = []

	for item in cases:
		values = values.append({ item | body = rewrite_identifier_expr(rewrites, item.body) })

	values


private pure func rewrite_identifier_select_arm_kind(
	rewrites: List[NameRewrite],
	kind: ParsedSelectArmKind,
) -> ParsedSelectArmKind:
	match kind:
		ParsedSelectReceiveArm(name, channel):
			ParsedSelectReceiveArm(
				name,
				rewrite_identifier_expr(rewrites, channel),
			)
		ParsedSelectSealedArm(channel):
			ParsedSelectSealedArm(rewrite_identifier_expr(rewrites, channel))
		ParsedSelectAfterArm(timeout):
			ParsedSelectAfterArm(rewrite_identifier_expr(rewrites, timeout))


private pure func rewrite_identifier_select_arms(
	rewrites: List[NameRewrite],
	arms: List[ParsedSelectArm],
) -> List[ParsedSelectArm]:
	var values: List[ParsedSelectArm] = []

	for arm in arms:
		values = values.append({ arm |
				kind = rewrite_identifier_select_arm_kind(rewrites, arm.kind),
				body = rewrite_identifier_expr(rewrites, arm.body)
			})

	values


private pure func rewrite_identifier_with_error_map(
	rewrites: List[NameRewrite],
	value: Option[ParsedWithErrorMap],
) -> Option[ParsedWithErrorMap]:
	match value:
		Some(error_map):
			Some({ error_map | value = rewrite_identifier_expr(rewrites, error_map.value) })
		None:
			None


private pure func rewrite_identifier_with_binding(
	rewrites: List[NameRewrite],
	binding: ParsedWithBinding,
) -> ParsedWithBinding:
	{ binding |
		value = rewrite_identifier_expr(rewrites, binding.value),
		error_map = rewrite_identifier_with_error_map(rewrites, binding.error_map)
	}


private pure func rewrite_identifier_concurrent_params(
	rewrites: List[NameRewrite],
	params: List[ParsedConcurrentParam],
) -> List[ParsedConcurrentParam]:
	var values: List[ParsedConcurrentParam] = []

	for param in params:
		values = values.append({ param | value = rewrite_identifier_expr(rewrites, param.value) })

	values


private pure func rewrite_identifier_interpolation_parts(
	rewrites: List[NameRewrite],
	parts: List[ParsedStringInterpolationPart],
) -> List[ParsedStringInterpolationPart]:
	var values: List[ParsedStringInterpolationPart] = []

	for part in parts:
		match part:
			ParsedInterpolationExpr(expr):
				values = values.append(
					ParsedInterpolationExpr(rewrite_identifier_expr(rewrites, expr)),
				)
			ParsedInterpolationLiteral(_):
				values = values.append(part)

	values


private pure func rewrite_identifier_expr(
	rewrites: List[NameRewrite],
	expr: ParsedExpr,
) -> ParsedExpr:
	match expr:
		ParsedNameExpr(name):
			ParsedNameExpr(rewrite_identifier_name(name, rewrites))
		ParsedStringInterpolationPartsExpr(parts, is_multiline, span):
			ParsedStringInterpolationPartsExpr(
				rewrite_identifier_interpolation_parts(rewrites, parts),
				is_multiline,
				span,
			)
		ParsedUnaryExpr(op, value, span):
			ParsedUnaryExpr(
				op,
				rewrite_identifier_expr(rewrites, value),
				span,
			)
		ParsedBinaryExpr(op, left, right, span):
			ParsedBinaryExpr(
				op,
				rewrite_identifier_expr(rewrites, left),
				rewrite_identifier_expr(rewrites, right),
				span,
			)
		ParsedLogicalExpr(op, left, right, span):
			ParsedLogicalExpr(
				op,
				rewrite_identifier_expr(rewrites, left),
				rewrite_identifier_expr(rewrites, right),
				span,
			)
		ParsedAscriptionExpr(value, type_expr, span):
			ParsedAscriptionExpr(
				rewrite_identifier_expr(rewrites, value),
				type_expr,
				span,
			)
		ParsedRangeExpr(start, finish, span):
			ParsedRangeExpr(
				rewrite_identifier_expr(rewrites, start),
				rewrite_identifier_expr(rewrites, finish),
				span,
			)
		ParsedCallExpr(callee, args, span):
			ParsedCallExpr(
				rewrite_identifier_expr(rewrites, callee),
				rewrite_identifier_exprs(rewrites, args),
				span,
			)
		ParsedFieldAccessExpr(target, field, span):
			ParsedFieldAccessExpr(
				rewrite_identifier_expr(rewrites, target),
				field,
				span,
			)
		ParsedSubscriptExpr(target, indices, span):
			ParsedSubscriptExpr(
				rewrite_identifier_expr(rewrites, target),
				rewrite_identifier_exprs(rewrites, indices),
				span,
			)
		ParsedListExpr(items, span):
			ParsedListExpr(
				rewrite_identifier_exprs(rewrites, items),
				span,
			)
		ParsedTupleExpr(items, span):
			ParsedTupleExpr(
				rewrite_identifier_exprs(rewrites, items),
				span,
			)
		ParsedRecordExpr(fields, span):
			ParsedRecordExpr(
				rewrite_identifier_record_fields(rewrites, fields),
				span,
			)
		ParsedRecordUpdateExpr(base, fields, span):
			ParsedRecordUpdateExpr(
				rewrite_identifier_expr(rewrites, base),
				rewrite_identifier_record_fields(rewrites, fields),
				span,
			)
		ParsedDictExpr(entries, span):
			ParsedDictExpr(
				rewrite_identifier_dict_entries(rewrites, entries),
				span,
			)
		ParsedVectorExpr(items, span):
			ParsedVectorExpr(
				rewrite_identifier_exprs(rewrites, items),
				span,
			)
		ParsedOpaqueIntoExpr(type_expr, value, span):
			ParsedOpaqueIntoExpr(
				type_expr,
				rewrite_identifier_expr(rewrites, value),
				span,
			)
		ParsedOpaqueFromExpr(type_expr, value, span):
			ParsedOpaqueFromExpr(
				type_expr,
				rewrite_identifier_expr(rewrites, value),
				span,
			)
		ParsedBlockExpr(items, span):
			ParsedBlockExpr(
				rewrite_identifier_exprs(rewrites, items),
				span,
			)
		ParsedIfExpr(cond, then_expr, else_expr, span):
			ParsedIfExpr(
				rewrite_identifier_expr(rewrites, cond),
				rewrite_identifier_expr(rewrites, then_expr),
				rewrite_identifier_optional_expr(rewrites, else_expr),
				span,
			)
		ParsedMatchExpr(value, cases, span):
			ParsedMatchExpr(
				rewrite_identifier_expr(rewrites, value),
				rewrite_identifier_match_cases(rewrites, cases),
				span,
			)
		ParsedSelectExpr(arms, span):
			ParsedSelectExpr(
				rewrite_identifier_select_arms(rewrites, arms),
				span,
			)
		ParsedWithExpr(binding, body, span):
			ParsedWithExpr(
				rewrite_identifier_with_binding(rewrites, binding),
				rewrite_identifier_expr(rewrites, body),
				span,
			)
		ParsedDebugBlockExpr(body, span):
			ParsedDebugBlockExpr(
				rewrite_identifier_expr(rewrites, body),
				span,
			)
		ParsedLambdaExpr(_, _, _, _, _):
			expr
		ParsedFunctionDeclExpr(_):
			expr
		ParsedWhileExpr(cond, body, span):
			ParsedWhileExpr(
				rewrite_identifier_expr(rewrites, cond),
				rewrite_identifier_expr(rewrites, body),
				span,
			)
		ParsedForExpr(binder, iterable, body, span):
			ParsedForExpr(
				binder,
				rewrite_identifier_expr(rewrites, iterable),
				rewrite_identifier_expr(rewrites, body),
				span,
			)
		ParsedConcurrentBlockExpr(params, body, span):
			ParsedConcurrentBlockExpr(
				rewrite_identifier_concurrent_params(rewrites, params),
				rewrite_identifier_expr(rewrites, body),
				span,
			)
		ParsedConcurrentForExpr(name, iterable, params, body, span):
			ParsedConcurrentForExpr(
				name,
				rewrite_identifier_expr(rewrites, iterable),
				rewrite_identifier_concurrent_params(rewrites, params),
				rewrite_identifier_expr(rewrites, body),
				span,
			)
		ParsedDetachExpr(body, span):
			ParsedDetachExpr(
				rewrite_identifier_expr(rewrites, body),
				span,
			)
		ParsedVarDeclExpr(name, type_expr, value, is_mutable, span):
			ParsedVarDeclExpr(
				name,
				type_expr,
				rewrite_identifier_expr(rewrites, value),
				is_mutable,
				span,
			)
		ParsedAssignExpr(name, value, span):
			ParsedAssignExpr(
				name,
				rewrite_identifier_expr(rewrites, value),
				span,
			)
		ParsedCompoundAssignExpr(name, op, value, span):
			ParsedCompoundAssignExpr(
				name,
				op,
				rewrite_identifier_expr(rewrites, value),
				span,
			)
		ParsedSubscriptAssignExpr(target, indices, value, span):
			ParsedSubscriptAssignExpr(
				rewrite_identifier_expr(rewrites, target),
				rewrite_identifier_exprs(rewrites, indices),
				rewrite_identifier_expr(rewrites, value),
				span,
			)
		ParsedTupleDestructExpr(names, value, span):
			ParsedTupleDestructExpr(
				names,
				rewrite_identifier_expr(rewrites, value),
				span,
			)
		ParsedQuestionBindExpr(name, type_expr, value, span):
			ParsedQuestionBindExpr(
				name,
				type_expr,
				rewrite_identifier_expr(rewrites, value),
				span,
			)
		_:
			expr


private pure func apply_name_rewrites(rewrites: List[NameRewrite], expr: ParsedExpr) -> ParsedExpr:
	if rewrites.length() == 0:
		expr
	else:
		rewrite_identifier_expr(rewrites, expr)


private pure func parsed_function_decls_to_decls(
	functions: List[ParsedFunctionDecl],
) -> List[ParsedDecl]:
	functions.map(func(function_decl): FunctionParsedDecl(function_decl))


private pure func hoist_nested_body(
	parent_name: String,
	parent_locals: List[String],
	body: ParsedExpr,
	next_id: Int,
) -> HoistExprResult:
	match body:
		ParsedBlockExpr(items, span):
			result = hoist_nested_block_items(parent_name, parent_locals, items, next_id)
			{
				value = ParsedBlockExpr(result.value, span),
				hoisted = result.hoisted,
				diagnostics = result.diagnostics,
				next_id = result.next_id
			}
		_:
			{
				value = body,
				hoisted = [],
				diagnostics = [],
				next_id = next_id
			}


private pure func hoist_nested_block_items(
	parent_name: String,
	parent_locals: List[String],
	items: List[ParsedExpr],
	next_id: Int,
) -> HoistBlockResult:
	var values: List[ParsedExpr] = []
	var hoisted: List[ParsedFunctionDecl] = []
	var diagnostics: List[ParseDiagnostic] = []
	var rewrites: List[NameRewrite] = []
	var current_locals: List[String] = parent_locals
	var current_id: Int = next_id

	for item in items:
		match item:
			ParsedFunctionDeclExpr(nested_decl):
				original_name: String = nested_decl.name.text
				new_name: String = mangle_nested_function_name(
					parent_name,
					original_name,
					current_id,
				)
				current_id += 1
				self_rewrite: NameRewrite = {
					old_name = original_name,
					new_name = new_name
				}

				own_params: List[String] = params_bound_names(nested_decl.params)
				var external_locals: List[String] = names_without(current_locals, own_params)
				external_locals = names_without(
					external_locals,
					rewrites.map(func(rewrite): rewrite.old_name),
				)

				new_body: Option[ParsedExpr] = match nested_decl.body:
					Some(raw_body):
						match find_capture(external_locals, raw_body):
							Some(reference):
								diagnostics = diagnostics.append(
									nested_capture_diagnostic(
										original_name,
										parent_name,
										reference.name,
										reference.span,
									),
								)
							None:
								void

						body_with_rewrites = apply_name_rewrites(
							rewrites.append(self_rewrite),
							raw_body,
						)
						body_result = hoist_nested_body(
							new_name,
							own_params,
							body_with_rewrites,
							current_id,
						)
						current_id = body_result.next_id
						hoisted = hoisted.concat(body_result.hoisted)
						diagnostics = diagnostics.concat(body_result.diagnostics)
						Some(body_result.value)
					None:
						None

				renamed_decl: ParsedFunctionDecl = { nested_decl |
					name = { nested_decl.name | text = new_name },
					body = new_body
				}

				hoisted = hoisted.append(renamed_decl)
				values = values.append(ParsedVoidExpr(nested_decl.span))
				rewrites = [self_rewrite].concat(rewrites)
			ParsedVarDeclExpr(name, _, _, _, _):
				values = values.append(apply_name_rewrites(rewrites, item))
				current_locals = current_locals.append(name.text)
			ParsedTupleDestructExpr(names, _, _):
				values = values.append(apply_name_rewrites(rewrites, item))
				current_locals = names_from_identifiers(names).concat(current_locals)
			_:
				values = values.append(apply_name_rewrites(rewrites, item))

	{
		value = values,
		hoisted = hoisted,
		diagnostics = diagnostics,
		next_id = current_id
	}


private pure func hoist_nested_function_decl(
	decl: ParsedFunctionDecl,
	next_id: Int,
) -> HoistFunctionResult:
	match decl.body:
		Some(body):
			body_result = hoist_nested_body(
				decl.name.text,
				params_bound_names(decl.params),
				body,
				next_id,
			)
			{
				decl = { decl | body = Some(body_result.value) },
				hoisted = body_result.hoisted,
				diagnostics = body_result.diagnostics,
				next_id = body_result.next_id
			}
		None:
			{
				decl = decl,
				hoisted = [],
				diagnostics = [],
				next_id = next_id
			}


private pure func hoist_nested_function_decls(
	items: List[ParsedFunctionDecl],
	next_id: Int,
) -> HoistFunctionDeclsResult:
	var values: List[ParsedFunctionDecl] = []
	var hoisted: List[ParsedFunctionDecl] = []
	var diagnostics: List[ParseDiagnostic] = []
	var current_id: Int = next_id

	for item in items:
		result = hoist_nested_function_decl(item, current_id)
		current_id = result.next_id
		values = values.append(result.decl)
		hoisted = hoisted.concat(result.hoisted)
		diagnostics = diagnostics.concat(result.diagnostics)

	{
		functions = values,
		hoisted = hoisted,
		diagnostics = diagnostics,
		next_id = current_id
	}


private pure func hoist_nested_decls(decls: List[ParsedDecl]) -> HoistDeclsResult:
	var values: List[ParsedDecl] = []
	var diagnostics: List[ParseDiagnostic] = []
	var current_id: Int = 0

	for decl in decls:
		match decl:
			FunctionParsedDecl(function_decl):
				result = hoist_nested_function_decl(function_decl, current_id)
				current_id = result.next_id
				values = values.concat(parsed_function_decls_to_decls(result.hoisted))
				values = values.append(FunctionParsedDecl(result.decl))
				diagnostics = diagnostics.concat(result.diagnostics)
			ImplParsedDecl(impl_decl):
				result = hoist_nested_function_decls(impl_decl.methods, current_id)
				current_id = result.next_id
				values = values.concat(parsed_function_decls_to_decls(result.hoisted))
				values = values.append(ImplParsedDecl({ impl_decl | methods = result.functions }))
				diagnostics = diagnostics.concat(result.diagnostics)
			PrivateParsedDecl(inner, span):
				match inner:
					FunctionParsedDecl(function_decl):
						result = hoist_nested_function_decl(function_decl, current_id)
						current_id = result.next_id
						values = values.concat(parsed_function_decls_to_decls(result.hoisted))
						values = values.append(
							PrivateParsedDecl(
								FunctionParsedDecl(result.decl),
								span,
							),
						)
						diagnostics = diagnostics.concat(result.diagnostics)
					_:
						values = values.append(decl)
			_:
				values = values.append(decl)

	{
		decls = values,
		diagnostics = diagnostics
	}


private pure func subscript_get_builtin_name(arity: Int) -> String:
	if arity == 1:
		"checked_get"
	else if arity == 2:
		"matrix_checked_get"
	else if arity == 3:
		"tensor3_checked_get"
	else if arity == 4:
		"tensor4_checked_get"
	else if arity == 5:
		"tensor5_checked_get"
	else:
		"tensor" + arity.to_string() + "_checked_get"


private pure func make_untyped_call_expr(
	span: SourceSpan,
	name: String,
	args: List[ParsedExpr],
) -> ParsedExpr:
	callee: ParsedExpr = ParsedNameExpr({
		text = name,
		span = span,
	})
	ParsedCallExpr(callee, args, span)


private pure func rewrite_subscript_read_node(
	target: ParsedExpr,
	indices: List[ParsedExpr],
	span: SourceSpan,
) -> ParsedExpr:
	if indices.length() == 1:
		match indices.get(0):
			Some(ParsedRangeExpr(start, finish, _)):
				make_untyped_call_expr(
					span,
					"checked_slice",
					[target, start, finish],
				)
			Some(index):
				make_untyped_call_expr(
					span,
					"checked_get",
					[target, index],
				)
			None:
				make_untyped_call_expr(span, subscript_get_builtin_name(0), [target])
	else:
		make_untyped_call_expr(
			span,
			subscript_get_builtin_name(indices.length()),
			[target].concat(indices),
		)


private pure func rewrite_subscript_read_optional_expr(
	value: Option[ParsedExpr],
) -> Option[ParsedExpr]:
	match value:
		Some(expr):
			Some(rewrite_subscript_read_expr(expr))
		None:
			None


private pure func rewrite_subscript_read_exprs(items: List[ParsedExpr]) -> List[ParsedExpr]:
	items.map(func(item): rewrite_subscript_read_expr(item))


private pure func rewrite_subscript_read_select_arm_kind(
	kind: ParsedSelectArmKind,
) -> ParsedSelectArmKind:
	match kind:
		ParsedSelectReceiveArm(name, channel):
			ParsedSelectReceiveArm(name, rewrite_subscript_read_expr(channel))
		ParsedSelectSealedArm(channel):
			ParsedSelectSealedArm(rewrite_subscript_read_expr(channel))
		ParsedSelectAfterArm(timeout):
			ParsedSelectAfterArm(rewrite_subscript_read_expr(timeout))


private pure func rewrite_subscript_read_with_error_map(
	value: Option[ParsedWithErrorMap],
) -> Option[ParsedWithErrorMap]:
	match value:
		Some(error_map):
			Some({ error_map | value = rewrite_subscript_read_expr(error_map.value) })
		None:
			None


private pure func rewrite_subscript_read_with_binding(
	binding: ParsedWithBinding,
) -> ParsedWithBinding:
	{ binding |
		value = rewrite_subscript_read_expr(binding.value),
		error_map = rewrite_subscript_read_with_error_map(binding.error_map)
	}


private pure func rewrite_subscript_read_function_decl(
	decl: ParsedFunctionDecl,
) -> ParsedFunctionDecl:
	{ decl | body = rewrite_subscript_read_optional_expr(decl.body) }


private pure func rewrite_subscript_read_expr(expr: ParsedExpr) -> ParsedExpr:
	match expr:
		ParsedStringInterpolationPartsExpr(parts, is_multiline, span):
			ParsedStringInterpolationPartsExpr(
				parts.map(func(part):
					match part:
						ParsedInterpolationExpr(interpolation_expr):
							ParsedInterpolationExpr(rewrite_subscript_read_expr(interpolation_expr))
						ParsedInterpolationLiteral(_):
							part
				),
				is_multiline,
				span,
			)
		ParsedUnaryExpr(op, value, span):
			ParsedUnaryExpr(op, rewrite_subscript_read_expr(value), span)
		ParsedBinaryExpr(op, left, right, span):
			ParsedBinaryExpr(
				op,
				rewrite_subscript_read_expr(left),
				rewrite_subscript_read_expr(right),
				span,
			)
		ParsedLogicalExpr(op, left, right, span):
			ParsedLogicalExpr(
				op,
				rewrite_subscript_read_expr(left),
				rewrite_subscript_read_expr(right),
				span,
			)
		ParsedAscriptionExpr(value, type_expr, span):
			ParsedAscriptionExpr(rewrite_subscript_read_expr(value), type_expr, span)
		ParsedRangeExpr(start, finish, span):
			ParsedRangeExpr(
				rewrite_subscript_read_expr(start),
				rewrite_subscript_read_expr(finish),
				span,
			)
		ParsedCallExpr(callee, args, span):
			ParsedCallExpr(
				rewrite_subscript_read_expr(callee),
				rewrite_subscript_read_exprs(args),
				span,
			)
		ParsedFieldAccessExpr(target, field, span):
			ParsedFieldAccessExpr(rewrite_subscript_read_expr(target), field, span)
		ParsedSubscriptExpr(target, indices, span):
			rewrite_subscript_read_node(
				rewrite_subscript_read_expr(target),
				rewrite_subscript_read_exprs(indices),
				span,
			)
		ParsedListExpr(items, span):
			ParsedListExpr(rewrite_subscript_read_exprs(items), span)
		ParsedTupleExpr(items, span):
			ParsedTupleExpr(rewrite_subscript_read_exprs(items), span)
		ParsedRecordExpr(fields, span):
			ParsedRecordExpr(
				fields.map(
					func(field): { field | value = rewrite_subscript_read_expr(field.value) },
				),
				span,
			)
		ParsedRecordUpdateExpr(base, fields, span):
			ParsedRecordUpdateExpr(
				rewrite_subscript_read_expr(base),
				fields.map(
					func(field): { field | value = rewrite_subscript_read_expr(field.value) },
				),
				span,
			)
		ParsedDictExpr(entries, span):
			ParsedDictExpr(
				entries.map(func(entry):
					{ entry |
						key = rewrite_subscript_read_expr(entry.key),
						value = rewrite_subscript_read_expr(entry.value)
					}
				),
				span,
			)
		ParsedVectorExpr(items, span):
			ParsedVectorExpr(rewrite_subscript_read_exprs(items), span)
		ParsedOpaqueIntoExpr(type_expr, value, span):
			ParsedOpaqueIntoExpr(type_expr, rewrite_subscript_read_expr(value), span)
		ParsedOpaqueFromExpr(type_expr, value, span):
			ParsedOpaqueFromExpr(type_expr, rewrite_subscript_read_expr(value), span)
		ParsedBlockExpr(items, span):
			ParsedBlockExpr(rewrite_subscript_read_exprs(items), span)
		ParsedIfExpr(cond, then_expr, else_expr, span):
			ParsedIfExpr(
				rewrite_subscript_read_expr(cond),
				rewrite_subscript_read_expr(then_expr),
				rewrite_subscript_read_optional_expr(else_expr),
				span,
			)
		ParsedMatchExpr(value, cases, span):
			ParsedMatchExpr(
				rewrite_subscript_read_expr(value),
				cases.map(func(item): { item | body = rewrite_subscript_read_expr(item.body) }),
				span,
			)
		ParsedSelectExpr(arms, span):
			ParsedSelectExpr(
				arms.map(func(arm):
					{ arm |
						kind = rewrite_subscript_read_select_arm_kind(arm.kind),
						body = rewrite_subscript_read_expr(arm.body)
					}
				),
				span,
			)
		ParsedWithExpr(binding, body, span):
			ParsedWithExpr(
				rewrite_subscript_read_with_binding(binding),
				rewrite_subscript_read_expr(body),
				span,
			)
		ParsedDebugBlockExpr(body, span):
			ParsedDebugBlockExpr(rewrite_subscript_read_expr(body), span)
		ParsedLambdaExpr(is_pure, params, return_type, body, span):
			ParsedLambdaExpr(is_pure, params, return_type, rewrite_subscript_read_expr(body), span)
		ParsedFunctionDeclExpr(decl):
			ParsedFunctionDeclExpr(rewrite_subscript_read_function_decl(decl))
		ParsedWhileExpr(cond, body, span):
			ParsedWhileExpr(
				rewrite_subscript_read_expr(cond),
				rewrite_subscript_read_expr(body),
				span,
			)
		ParsedForExpr(binder, iterable, body, span):
			ParsedForExpr(
				binder,
				rewrite_subscript_read_expr(iterable),
				rewrite_subscript_read_expr(body),
				span,
			)
		ParsedConcurrentBlockExpr(params, body, span):
			ParsedConcurrentBlockExpr(
				params.map(
					func(param): { param | value = rewrite_subscript_read_expr(param.value) },
				),
				rewrite_subscript_read_expr(body),
				span,
			)
		ParsedConcurrentForExpr(name, iterable, params, body, span):
			ParsedConcurrentForExpr(
				name,
				rewrite_subscript_read_expr(iterable),
				params.map(
					func(param): { param | value = rewrite_subscript_read_expr(param.value) },
				),
				rewrite_subscript_read_expr(body),
				span,
			)
		ParsedDetachExpr(body, span):
			ParsedDetachExpr(rewrite_subscript_read_expr(body), span)
		ParsedVarDeclExpr(name, type_expr, value, is_mutable, span):
			ParsedVarDeclExpr(name, type_expr, rewrite_subscript_read_expr(value), is_mutable, span)
		ParsedAssignExpr(name, value, span):
			ParsedAssignExpr(name, rewrite_subscript_read_expr(value), span)
		ParsedCompoundAssignExpr(name, op, value, span):
			ParsedCompoundAssignExpr(name, op, rewrite_subscript_read_expr(value), span)
		ParsedSubscriptAssignExpr(target, indices, value, span):
			ParsedSubscriptAssignExpr(
				rewrite_subscript_read_expr(target),
				rewrite_subscript_read_exprs(indices),
				rewrite_subscript_read_expr(value),
				span,
			)
		ParsedTupleDestructExpr(names, value, span):
			ParsedTupleDestructExpr(names, rewrite_subscript_read_expr(value), span)
		ParsedQuestionBindExpr(name, type_expr, value, span):
			ParsedQuestionBindExpr(name, type_expr, rewrite_subscript_read_expr(value), span)
		_:
			expr


private pure func rewrite_subscript_read_decl(decl: ParsedDecl) -> ParsedDecl:
	match decl:
		FunctionParsedDecl(function_decl):
			FunctionParsedDecl(rewrite_subscript_read_function_decl(function_decl))
		VarParsedDecl(var_decl):
			VarParsedDecl({ var_decl | value = rewrite_subscript_read_expr(var_decl.value) })
		TraitParsedDecl(trait_decl):
			TraitParsedDecl(
				{ trait_decl |
					methods = trait_decl.methods.map(
						func(
							item,
						): { item | body = rewrite_subscript_read_optional_expr(item.body) },
					)
				},
			)
		ImplParsedDecl(impl_decl):
			ImplParsedDecl(
				{ impl_decl |
					methods = impl_decl.methods.map(
						func(item): rewrite_subscript_read_function_decl(item),
					)
				},
			)
		PrivateParsedDecl(inner, span):
			PrivateParsedDecl(rewrite_subscript_read_decl(inner), span)
		_:
			decl


private pure func rewrite_subscript_read_program(program: ParsedProgram) -> ParsedProgram:
	{ program | decls = program.decls.map(func(decl): rewrite_subscript_read_decl(decl)) }


private pure func parse_interpolation_expr(
	module_name: String,
	span: SourceSpan,
	text: String,
) -> ParsedExprOptionResult:
	wrapper_source: SourceFile = source_file(
		span.path,
		module_name,
		"___interp_temp = " + text + "\n",
	)
	program: ParsedProgram = parse_compiler_source(wrapper_source)

	match first_parse_error(program.diagnostics):
		Some(diagnostic):
			{
				value = None,
				diagnostics = [
					parse_error(
						span,
						"Parse error in interpolated expression: " + diagnostic.message,
					),
				]
			}
		None:
			match program.decls:
				[VarParsedDecl(var_decl)]:
					finalized = finalize_interpolation_expr(module_name, var_decl.value)
					{
						value = Some(finalized.value),
						diagnostics = finalized.diagnostics
					}
				_:
					{
						value = None,
						diagnostics = [
							parse_error(span, "Failed to parse interpolated expression: " + text),
						]
					}


private pure func finalize_interpolation_parts(
	module_name: String,
	span: SourceSpan,
	raw_parts: List[StringInterpolationRawPart],
) -> InterpolationPartsResult:
	var parts: List[ParsedStringInterpolationPart] = []
	var diagnostics: List[ParseDiagnostic] = []

	for part in raw_parts:
		match part:
			InterpolationLiteralText(value):
				parts = parts.append(ParsedInterpolationLiteral(value))
			InterpolationExprText(text):
				parsed_expr = parse_interpolation_expr(module_name, span, text)
				diagnostics = diagnostics.concat(parsed_expr.diagnostics)

				match parsed_expr.value:
					Some(expr):
						parts = parts.append(ParsedInterpolationExpr(expr))
					None:
						void

	{
		parts = parts,
		diagnostics = diagnostics
	}


private pure func finalize_optional_expr(
	module_name: String,
	value: Option[ParsedExpr],
) -> ParsedExprOptionResult:
	match value:
		Some(expr):
			finalized = finalize_interpolation_expr(module_name, expr)
			{
				value = Some(finalized.value),
				diagnostics = finalized.diagnostics
			}
		None:
			{
				value = None,
				diagnostics = []
			}


private pure func finalize_exprs(module_name: String, items: List[ParsedExpr]) -> ParsedExprsResult:
	var values: List[ParsedExpr] = []
	var diagnostics: List[ParseDiagnostic] = []

	for item in items:
		finalized = finalize_interpolation_expr(module_name, item)
		values = values.append(finalized.value)
		diagnostics = diagnostics.concat(finalized.diagnostics)

	{
		values = values,
		diagnostics = diagnostics
	}


private pure func finalize_record_fields(
	module_name: String,
	items: List[ParsedRecordExprField],
) -> RecordFieldsResult:
	var values: List[ParsedRecordExprField] = []
	var diagnostics: List[ParseDiagnostic] = []

	for item in items:
		finalized = finalize_interpolation_expr(module_name, item.value)
		values = values.append({ item | value = finalized.value })
		diagnostics = diagnostics.concat(finalized.diagnostics)

	{
		fields = values,
		diagnostics = diagnostics
	}


private pure func finalize_dict_entries(
	module_name: String,
	items: List[ParsedDictEntry],
) -> DictEntriesResult:
	var values: List[ParsedDictEntry] = []
	var diagnostics: List[ParseDiagnostic] = []

	for item in items:
		key = finalize_interpolation_expr(module_name, item.key)
		value = finalize_interpolation_expr(module_name, item.value)
		values = values.append({ item |
				key = key.value,
				value = value.value
			})
		diagnostics = diagnostics.concat(key.diagnostics)
		diagnostics = diagnostics.concat(value.diagnostics)

	{
		entries = values,
		diagnostics = diagnostics
	}


private pure func finalize_match_cases(
	module_name: String,
	items: List[ParsedMatchCase],
) -> MatchCasesResult:
	var values: List[ParsedMatchCase] = []
	var diagnostics: List[ParseDiagnostic] = []

	for item in items:
		body = finalize_interpolation_expr(module_name, item.body)
		values = values.append({ item | body = body.value })
		diagnostics = diagnostics.concat(body.diagnostics)

	{
		cases = values,
		diagnostics = diagnostics
	}


private pure func finalize_select_arm_kind(
	module_name: String,
	kind: ParsedSelectArmKind,
) -> SelectArmKindResult:
	match kind:
		ParsedSelectReceiveArm(name, source):
			finalized = finalize_interpolation_expr(module_name, source)
			{
				kind = ParsedSelectReceiveArm(name, finalized.value),
				diagnostics = finalized.diagnostics
			}
		ParsedSelectSealedArm(source):
			finalized = finalize_interpolation_expr(module_name, source)
			{
				kind = ParsedSelectSealedArm(finalized.value),
				diagnostics = finalized.diagnostics
			}
		ParsedSelectAfterArm(source):
			finalized = finalize_interpolation_expr(module_name, source)
			{
				kind = ParsedSelectAfterArm(finalized.value),
				diagnostics = finalized.diagnostics
			}


private pure func finalize_select_arms(
	module_name: String,
	items: List[ParsedSelectArm],
) -> SelectArmsResult:
	var values: List[ParsedSelectArm] = []
	var diagnostics: List[ParseDiagnostic] = []

	for item in items:
		kind = finalize_select_arm_kind(module_name, item.kind)
		body = finalize_interpolation_expr(module_name, item.body)
		values = values.append({ item |
				kind = kind.kind,
				body = body.value
			})
		diagnostics = diagnostics.concat(kind.diagnostics)
		diagnostics = diagnostics.concat(body.diagnostics)

	{
		arms = values,
		diagnostics = diagnostics
	}


private pure func finalize_concurrent_params(
	module_name: String,
	items: List[ParsedConcurrentParam],
) -> ConcurrentParamsResult:
	var values: List[ParsedConcurrentParam] = []
	var diagnostics: List[ParseDiagnostic] = []

	for item in items:
		value = finalize_interpolation_expr(module_name, item.value)
		values = values.append({ item | value = value.value })
		diagnostics = diagnostics.concat(value.diagnostics)

	{
		params = values,
		diagnostics = diagnostics
	}


private pure func finalize_with_error_map(
	module_name: String,
	value: Option[ParsedWithErrorMap],
) -> WithErrorMapResult:
	match value:
		Some(error_map):
			finalized = finalize_interpolation_expr(module_name, error_map.value)
			{
				value = Some({ error_map | value = finalized.value }),
				diagnostics = finalized.diagnostics
			}
		None:
			{
				value = None,
				diagnostics = []
			}


private pure func finalize_with_binding(
	module_name: String,
	binding: ParsedWithBinding,
) -> WithBindingResult:
	value = finalize_interpolation_expr(module_name, binding.value)
	error_map = finalize_with_error_map(module_name, binding.error_map)
	{
		binding = { binding |
			value = value.value,
			error_map = error_map.value
		},
		diagnostics = value.diagnostics.concat(error_map.diagnostics)
	}


private pure func finalize_function_decl(
	module_name: String,
	decl: ParsedFunctionDecl,
) -> FunctionDeclResult:
	body = finalize_optional_expr(module_name, decl.body)
	{
		decl = { decl | body = body.value },
		diagnostics = body.diagnostics
	}


private pure func finalize_var_decl(module_name: String, decl: ParsedVarDecl) -> VarDeclResult:
	value = finalize_interpolation_expr(module_name, decl.value)
	{
		decl = { decl | value = value.value },
		diagnostics = value.diagnostics
	}


private pure func finalize_trait_method(
	module_name: String,
	decl: ParsedTraitMethodDecl,
) -> TraitMethodResult:
	body = finalize_optional_expr(module_name, decl.body)
	{
		method = { decl | body = body.value },
		diagnostics = body.diagnostics
	}


private pure func finalize_trait_methods(
	module_name: String,
	items: List[ParsedTraitMethodDecl],
) -> TraitMethodsResult:
	var values: List[ParsedTraitMethodDecl] = []
	var diagnostics: List[ParseDiagnostic] = []

	for item in items:
		finalized = finalize_trait_method(module_name, item)
		values = values.append(finalized.method)
		diagnostics = diagnostics.concat(finalized.diagnostics)

	{
		methods = values,
		diagnostics = diagnostics
	}


private pure func finalize_function_decls(
	module_name: String,
	items: List[ParsedFunctionDecl],
) -> FunctionDeclsResult:
	var values: List[ParsedFunctionDecl] = []
	var diagnostics: List[ParseDiagnostic] = []

	for item in items:
		finalized = finalize_function_decl(module_name, item)
		values = values.append(finalized.decl)
		diagnostics = diagnostics.concat(finalized.diagnostics)

	{
		functions = values,
		diagnostics = diagnostics
	}


-- Binary expressions commonly form deep left-associated spines in generated
-- source. Keep recursive binary children inside this small helper instead of
-- re-entering the exhaustive dispatcher, whose generated C frame contains the
-- temporaries for every ParsedExpr variant. Logical chains use the explicit
-- frame machine below.
private pure func finalize_binary_spine_operand(
	module_name: String,
	expr: ParsedExpr,
) -> ParsedExprResult:
	match expr:
		ParsedBinaryExpr(op, left, right, span):
			finalize_binary_interpolation_expr(module_name, op, left, right, span)
		_:
			finalize_interpolation_expr(module_name, expr)


private pure func finalize_binary_interpolation_expr(
	module_name: String,
	op: ParsedBinaryOp,
	left: ParsedExpr,
	right: ParsedExpr,
	span: SourceSpan,
) -> ParsedExprResult:
	left_result = finalize_binary_spine_operand(module_name, left)
	right_result = finalize_binary_spine_operand(module_name, right)
	{
		value = ParsedBinaryExpr(op, left_result.value, right_result.value, span),
		diagnostics = left_result.diagnostics.concat(right_result.diagnostics)
	}


private pure func finalize_logical_expr(module_name: String, expr: ParsedExpr) -> ParsedExprResult:
	-- Source logical chains are left-associated. Traverse this common generated
	-- shape explicitly because the full expression matcher has a large -O0 C
	-- frame and cannot recurse safely through thousands of terms.
	var frames: ParsedLogicalFinalizeFrameStack = ParsedLogicalFinalizeNoFrame
	var action: ParsedLogicalFinalizeAction = ParsedLogicalFinalizeVisitExpr(expr)
	var result: ParsedExprResult = {
		value = expr,
		diagnostics = []
	}

	while True:
		match action:
			ParsedLogicalFinalizeVisitExpr(current):
				match current:
					ParsedLogicalExpr(op, left, right, span):
						frames = ParsedLogicalFinalizeMoreFrames(
							ParsedLogicalFinalizeVisitRightFrame(op, right, span),
							frames,
						)
						action = ParsedLogicalFinalizeVisitExpr(left)
					_:
						action = ParsedLogicalFinalizeRebuildExpr(
							finalize_interpolation_expr(
								module_name,
								current,
							),
						)
			ParsedLogicalFinalizeRebuildExpr(finalized):
				match frames:
					ParsedLogicalFinalizeNoFrame:
						result = finalized
						break
					ParsedLogicalFinalizeMoreFrames(frame, remaining):
						frames = remaining

						match frame:
							ParsedLogicalFinalizeVisitRightFrame(op, right, span):
								frames = ParsedLogicalFinalizeMoreFrames(
									ParsedLogicalFinalizeRebuildParentFrame(op, finalized, span),
									frames,
								)
								action = ParsedLogicalFinalizeVisitExpr(right)
							ParsedLogicalFinalizeRebuildParentFrame(op, left, span):
								action = ParsedLogicalFinalizeRebuildExpr({
									value = ParsedLogicalExpr(
										op,
										left.value,
										finalized.value,
										span,
									),
									diagnostics = left.diagnostics.concat(finalized.diagnostics),
								})

	result


private pure func finalize_interpolation_expr(
	module_name: String,
	expr: ParsedExpr,
) -> ParsedExprResult:
	match expr:
		ParsedStringInterpolationExpr(value, is_multiline, span):
			match split_interpolated_string(span, value):
				Ok(raw_parts):
					parts = finalize_interpolation_parts(module_name, span, raw_parts)

					if parts.diagnostics.length() == 0:
						{
							value = ParsedStringInterpolationPartsExpr(
								parts.parts,
								is_multiline,
								span,
							),
							diagnostics = []
						}
					else:
						{
							value = expr,
							diagnostics = parts.diagnostics
						}
				Err(diagnostic):
					{
						value = expr,
						diagnostics = [diagnostic]
					}
		ParsedUnaryExpr(op, value, span):
			finalized = finalize_interpolation_expr(module_name, value)
			{
				value = ParsedUnaryExpr(op, finalized.value, span),
				diagnostics = finalized.diagnostics
			}
		ParsedBinaryExpr(op, left, right, span):
			finalize_binary_interpolation_expr(module_name, op, left, right, span)
		ParsedLogicalExpr(op, left, right, span):
			finalize_logical_expr(module_name, expr)
		ParsedAscriptionExpr(value, type_expr, span):
			finalized = finalize_interpolation_expr(module_name, value)
			{
				value = ParsedAscriptionExpr(finalized.value, type_expr, span),
				diagnostics = finalized.diagnostics
			}
		ParsedRangeExpr(start, finish, span):
			start_result = finalize_interpolation_expr(module_name, start)
			finish_result = finalize_interpolation_expr(module_name, finish)
			{
				value = ParsedRangeExpr(start_result.value, finish_result.value, span),
				diagnostics = start_result.diagnostics.concat(finish_result.diagnostics)
			}
		ParsedCallExpr(callee, args, span):
			callee_result = finalize_interpolation_expr(module_name, callee)
			args_result = finalize_exprs(module_name, args)
			{
				value = ParsedCallExpr(callee_result.value, args_result.values, span),
				diagnostics = callee_result.diagnostics.concat(args_result.diagnostics)
			}
		ParsedFieldAccessExpr(target, field, span):
			finalized = finalize_interpolation_expr(module_name, target)
			{
				value = ParsedFieldAccessExpr(finalized.value, field, span),
				diagnostics = finalized.diagnostics
			}
		ParsedSubscriptExpr(target, indices, span):
			target_result = finalize_interpolation_expr(module_name, target)
			indices_result = finalize_exprs(module_name, indices)
			{
				value = ParsedSubscriptExpr(target_result.value, indices_result.values, span),
				diagnostics = target_result.diagnostics.concat(indices_result.diagnostics)
			}
		ParsedListExpr(items, span):
			result = finalize_exprs(module_name, items)
			{
				value = ParsedListExpr(result.values, span),
				diagnostics = result.diagnostics
			}
		ParsedTupleExpr(items, span):
			result = finalize_exprs(module_name, items)
			{
				value = ParsedTupleExpr(result.values, span),
				diagnostics = result.diagnostics
			}
		ParsedRecordExpr(fields, span):
			result = finalize_record_fields(module_name, fields)
			{
				value = ParsedRecordExpr(result.fields, span),
				diagnostics = result.diagnostics
			}
		ParsedRecordUpdateExpr(base, fields, span):
			base_result = finalize_interpolation_expr(module_name, base)
			fields_result = finalize_record_fields(module_name, fields)
			{
				value = ParsedRecordUpdateExpr(base_result.value, fields_result.fields, span),
				diagnostics = base_result.diagnostics.concat(fields_result.diagnostics)
			}
		ParsedDictExpr(entries, span):
			result = finalize_dict_entries(module_name, entries)
			{
				value = ParsedDictExpr(result.entries, span),
				diagnostics = result.diagnostics
			}
		ParsedVectorExpr(items, span):
			result = finalize_exprs(module_name, items)
			{
				value = ParsedVectorExpr(result.values, span),
				diagnostics = result.diagnostics
			}
		ParsedOpaqueIntoExpr(type_expr, value, span):
			result = finalize_interpolation_expr(module_name, value)
			{
				value = ParsedOpaqueIntoExpr(type_expr, result.value, span),
				diagnostics = result.diagnostics
			}
		ParsedOpaqueFromExpr(type_expr, value, span):
			result = finalize_interpolation_expr(module_name, value)
			{
				value = ParsedOpaqueFromExpr(type_expr, result.value, span),
				diagnostics = result.diagnostics
			}
		ParsedBlockExpr(items, span):
			result = finalize_exprs(module_name, items)
			{
				value = ParsedBlockExpr(result.values, span),
				diagnostics = result.diagnostics
			}
		ParsedIfExpr(cond, then_expr, else_expr, span):
			cond_result = finalize_interpolation_expr(module_name, cond)
			then_result = finalize_interpolation_expr(module_name, then_expr)
			else_result = finalize_optional_expr(module_name, else_expr)
			{
				value = ParsedIfExpr(cond_result.value, then_result.value, else_result.value, span),
				diagnostics = cond_result.diagnostics
					.concat(then_result.diagnostics)
					.concat(else_result.diagnostics)
			}
		ParsedMatchExpr(value, cases, span):
			value_result = finalize_interpolation_expr(module_name, value)
			cases_result = finalize_match_cases(module_name, cases)
			{
				value = ParsedMatchExpr(value_result.value, cases_result.cases, span),
				diagnostics = value_result.diagnostics.concat(cases_result.diagnostics)
			}
		ParsedSelectExpr(arms, span):
			result = finalize_select_arms(module_name, arms)
			{
				value = ParsedSelectExpr(result.arms, span),
				diagnostics = result.diagnostics
			}
		ParsedWithExpr(binding, body, span):
			binding_result = finalize_with_binding(module_name, binding)
			body_result = finalize_interpolation_expr(module_name, body)
			{
				value = ParsedWithExpr(binding_result.binding, body_result.value, span),
				diagnostics = binding_result.diagnostics.concat(body_result.diagnostics)
			}
		ParsedDebugBlockExpr(body, span):
			result = finalize_interpolation_expr(module_name, body)
			{
				value = ParsedDebugBlockExpr(result.value, span),
				diagnostics = result.diagnostics
			}
		ParsedLambdaExpr(is_pure, params, return_type, body, span):
			result = finalize_interpolation_expr(module_name, body)
			{
				value = ParsedLambdaExpr(is_pure, params, return_type, result.value, span),
				diagnostics = result.diagnostics
			}
		ParsedFunctionDeclExpr(decl):
			result = finalize_function_decl(module_name, decl)
			{
				value = ParsedFunctionDeclExpr(result.decl),
				diagnostics = result.diagnostics
			}
		ParsedWhileExpr(cond, body, span):
			cond_result = finalize_interpolation_expr(module_name, cond)
			body_result = finalize_interpolation_expr(module_name, body)
			{
				value = ParsedWhileExpr(cond_result.value, body_result.value, span),
				diagnostics = cond_result.diagnostics.concat(body_result.diagnostics)
			}
		ParsedForExpr(binder, iterable, body, span):
			iter_result = finalize_interpolation_expr(module_name, iterable)
			body_result = finalize_interpolation_expr(module_name, body)
			{
				value = ParsedForExpr(binder, iter_result.value, body_result.value, span),
				diagnostics = iter_result.diagnostics.concat(body_result.diagnostics)
			}
		ParsedConcurrentBlockExpr(params, body, span):
			params_result = finalize_concurrent_params(module_name, params)
			body_result = finalize_interpolation_expr(module_name, body)
			{
				value = ParsedConcurrentBlockExpr(params_result.params, body_result.value, span),
				diagnostics = params_result.diagnostics.concat(body_result.diagnostics)
			}
		ParsedConcurrentForExpr(name, iterable, params, body, span):
			iter_result = finalize_interpolation_expr(module_name, iterable)
			params_result = finalize_concurrent_params(module_name, params)
			body_result = finalize_interpolation_expr(module_name, body)
			{
				value = ParsedConcurrentForExpr(
					name,
					iter_result.value,
					params_result.params,
					body_result.value,
					span,
				),
				diagnostics = iter_result.diagnostics
					.concat(params_result.diagnostics)
					.concat(body_result.diagnostics)
			}
		ParsedDetachExpr(body, span):
			result = finalize_interpolation_expr(module_name, body)
			{
				value = ParsedDetachExpr(result.value, span),
				diagnostics = result.diagnostics
			}
		ParsedVarDeclExpr(name, type_expr, value, is_mutable, span):
			result = finalize_interpolation_expr(module_name, value)
			{
				value = ParsedVarDeclExpr(name, type_expr, result.value, is_mutable, span),
				diagnostics = result.diagnostics
			}
		ParsedAssignExpr(name, value, span):
			result = finalize_interpolation_expr(module_name, value)
			{
				value = ParsedAssignExpr(name, result.value, span),
				diagnostics = result.diagnostics
			}
		ParsedCompoundAssignExpr(name, op, value, span):
			result = finalize_interpolation_expr(module_name, value)
			{
				value = ParsedCompoundAssignExpr(name, op, result.value, span),
				diagnostics = result.diagnostics
			}
		ParsedSubscriptAssignExpr(target, indices, value, span):
			target_result = finalize_interpolation_expr(module_name, target)
			indices_result = finalize_exprs(module_name, indices)
			value_result = finalize_interpolation_expr(module_name, value)
			{
				value = ParsedSubscriptAssignExpr(
					target_result.value,
					indices_result.values,
					value_result.value,
					span,
				),
				diagnostics = target_result.diagnostics
					.concat(indices_result.diagnostics)
					.concat(value_result.diagnostics)
			}
		ParsedTupleDestructExpr(names, value, span):
			result = finalize_interpolation_expr(module_name, value)
			{
				value = ParsedTupleDestructExpr(names, result.value, span),
				diagnostics = result.diagnostics
			}
		ParsedQuestionBindExpr(name, type_expr, value, span):
			result = finalize_interpolation_expr(module_name, value)
			{
				value = ParsedQuestionBindExpr(name, type_expr, result.value, span),
				diagnostics = result.diagnostics
			}
		_:
			{
				value = expr,
				diagnostics = []
			}


private pure func finalize_decl(module_name: String, decl: ParsedDecl) -> DeclResult:
	match decl:
		FunctionParsedDecl(function_decl):
			result = finalize_function_decl(module_name, function_decl)
			{
				decl = FunctionParsedDecl(result.decl),
				diagnostics = result.diagnostics
			}
		VarParsedDecl(var_decl):
			result = finalize_var_decl(module_name, var_decl)
			{
				decl = VarParsedDecl(result.decl),
				diagnostics = result.diagnostics
			}
		TraitParsedDecl(trait_decl):
			methods = finalize_trait_methods(module_name, trait_decl.methods)
			{
				decl = TraitParsedDecl({ trait_decl | methods = methods.methods }),
				diagnostics = methods.diagnostics
			}
		ImplParsedDecl(impl_decl):
			methods = finalize_function_decls(module_name, impl_decl.methods)
			{
				decl = ImplParsedDecl({ impl_decl | methods = methods.functions }),
				diagnostics = methods.diagnostics
			}
		PrivateParsedDecl(inner, span):
			result = finalize_decl(module_name, inner)
			{
				decl = PrivateParsedDecl(result.decl, span),
				diagnostics = result.diagnostics
			}
		_:
			{
				decl = decl,
				diagnostics = []
			}


private pure func finalize_decls(module_name: String, decls: List[ParsedDecl]) -> DeclsResult:
	var values: List[ParsedDecl] = []
	var diagnostics: List[ParseDiagnostic] = []

	for decl in decls:
		result = finalize_decl(module_name, decl)
		values = values.append(result.decl)
		diagnostics = diagnostics.concat(result.diagnostics)

	{
		decls = values,
		diagnostics = diagnostics
	}


pure func finalize_interpolation_program(program: ParsedProgram) -> ParsedProgram:
	result = finalize_decls(program.source.module_name, program.decls)
	{
		source = program.source,
		decls = result.decls,
		diagnostics = program.diagnostics.concat(result.diagnostics)
	}


pure func finalize_nested_functions_program(program: ParsedProgram) -> ParsedProgram:
	result = hoist_nested_decls(program.decls)
	{
		source = program.source,
		decls = result.decls,
		diagnostics = program.diagnostics.concat(result.diagnostics)
	}


pure func finalize_typecheck_source_program(program: ParsedProgram) -> ParsedProgram:
	rewrite_subscript_read_program(
		finalize_nested_functions_program(finalize_interpolation_program(program)),
	)


pure func finalized_typecheck_program(program: ParsedProgram) -> FinalizedTypecheckProgram:
	into_opaque FinalizedTypecheckProgram(finalize_typecheck_source_program(program))


pure func finalized_typecheck_program_ast(program: FinalizedTypecheckProgram) -> ParsedProgram:
	from_opaque FinalizedTypecheckProgram(program)


private pure func resolved_module_for_finalized_import(
	from_path: String,
	from_module: String,
	rewrites: List[FinalizedImportPathRewrite],
	import_path: String,
) -> String:
	var result: String = import_path

	for rewrite in rewrites:
		if (
			rewrite.from_path == from_path
			and rewrite.from_module == from_module
			and rewrite.import_path == import_path
		):
			result = rewrite.resolved_module
			break

	result


private pure func rewrite_finalized_import_decl_path(
	from_path: String,
	from_module: String,
	rewrites: List[FinalizedImportPathRewrite],
	import_decl: ParsedImportDecl,
) -> ParsedImportDecl:
	{ import_decl |
		module_path = resolved_module_for_finalized_import(
			from_path,
			from_module,
			rewrites,
			import_decl.module_path,
		)
	}


private pure func rewrite_finalized_decl_import_paths(
	from_path: String,
	from_module: String,
	rewrites: List[FinalizedImportPathRewrite],
	decl: ParsedDecl,
) -> ParsedDecl:
	match decl:
		ImportBlockParsedDecl(imports, span):
			ImportBlockParsedDecl(
				imports.map(
					func(
						import_decl,
					): rewrite_finalized_import_decl_path(
						from_path,
						from_module,
						rewrites,
						import_decl,
					),
				),
				span,
			)
		PrivateParsedDecl(inner, span):
			PrivateParsedDecl(
				rewrite_finalized_decl_import_paths(from_path, from_module, rewrites, inner),
				span,
			)
		_:
			decl


-- Import resolution changes names only. Keeping this transformation on the
-- opaque type prevents module preparation from discarding the finalization
-- proof or rerunning parser-owned normalization.
pure func finalized_typecheck_program_rewrite_import_paths(
	program: FinalizedTypecheckProgram,
	from_path: String,
	from_module: String,
	rewrites: List[FinalizedImportPathRewrite],
) -> FinalizedTypecheckProgram:
	parsed_program: ParsedProgram = from_opaque FinalizedTypecheckProgram(program)
	rewritten_program = { parsed_program |
		decls = parsed_program.decls.map(
			func(
				decl,
			): rewrite_finalized_decl_import_paths(from_path, from_module, rewrites, decl),
		)
	}
	into_opaque FinalizedTypecheckProgram(rewritten_program)


pure func finalized_typecheck_program_matches_source(
	program: FinalizedTypecheckProgram,
	path: String,
	module_name: String,
	text: String,
) -> Bool:
	source = finalized_typecheck_program_ast(program).source
	source.path == path and source.module_name == module_name and source.text == text
