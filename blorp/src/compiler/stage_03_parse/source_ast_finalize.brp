-- Source-AST finalization for typecheck-ready parser artifacts.
--
-- Raw parser consumers need to see syntax as written. Compile/check/run need a
-- source AST where parser-owned sugar has already been normalized. This module
-- owns those parser-adjacent rewrites one slice at a time.
import:
	../../lib/source:
		SourceFile,
		SourceFileId,
		SourceLocation,
		SourceTable,
		source_file,
		source_location_end_offset,
		source_location_file_id,
		source_location_from_offsets,
		source_location_span,
		source_location_start_offset,
		source_table_source,
		unindexed_source_table_for_file,
	../stage_02_lex/lexer: lex
	../stage_02_lex/name_table:
		EMPTY_NAME_TABLE,
		NameId,
		NameTable,
		SYNTHESIZED_NAME_TABLE,
		name_id_pending_dynamic_intern,
		name_table_find_id,
	../stage_02_lex/parse_diagnostic: ParseDiagnostic, parse_error, parse_error_expected
	language_parser: parse_compiler_source, parse_interpolation_hole_source
	memory: same_object
	parsed_ast:
		ParsedBinaryOp,
		ParsedDecl(
			BuiltinTypeParsedDecl, ForeignBlockParsedDecl, FunctionParsedDecl, ImplParsedDecl,
			ImportBlockParsedDecl, ParsedErrorDecl, PrivateParsedDecl, RecordParsedDecl,
			TraitParsedDecl, TypeAliasParsedDecl, UnionParsedDecl, VarParsedDecl,
		),
		ParsedDictEntry,
		ParsedElseBranch,
		ParsedExpr(
			ParsedAssignExpr, ParsedBinaryExpr, ParsedBlockExpr, ParsedBoolLiteralExpr,
			ParsedBreakExpr, ParsedBuiltinExpr, ParsedCallExpr, ParsedCharLiteralExpr,
			ParsedCompoundAssignExpr, ParsedConcurrentBlockExpr, ParsedConcurrentForExpr,
			ParsedContinueExpr, ParsedDebugBlockExpr, ParsedDetachExpr, ParsedDictExpr,
			ParsedFieldAccessExpr, ParsedFloatLiteralExpr, ParsedForExpr, ParsedFunctionDeclExpr,
			ParsedIfExpr, ParsedIntLiteralExpr, ParsedLambdaExpr, ParsedListExpr, ParsedLogicalExpr,
			ParsedMatchExpr, ParsedMissingExpr, ParsedNameExpr, ParsedOpaqueFromExpr,
			ParsedOpaqueIntoExpr, ParsedQuestionBindExpr, ParsedRangeExpr, ParsedRecordExpr,
			ParsedRecordUpdateExpr, ParsedSelectExpr, ParsedStringInterpolationExpr,
			ParsedStringInterpolationPartsExpr, ParsedStringLiteralExpr, ParsedSubscriptAssignExpr,
			ParsedSubscriptExpr, ParsedTupleDestructExpr, ParsedTupleExpr, ParsedUnaryExpr,
			ParsedVarDeclExpr, ParsedVectorExpr, ParsedVoidExpr, ParsedWhileExpr, ParsedWithExpr,
		),
		ParsedForBinder(ParsedForNameBinder, ParsedForTupleBinder),
		ParsedFunctionDecl,
		ParsedIdentifier,
		ParsedImportDecl,
		ParsedListPatternSpread(ParsedListSpreadName, ParsedListSpreadWildcard),
		ParsedLogicalOp,
		ParsedMatchCase,
		ParsedParam,
		ParsedParamBinder(ParsedParamNameBinder, ParsedParamTupleBinder, ParsedParamWildcardBinder),
		ParsedPattern(
			ParsedBoolPattern, ParsedCharPattern, ParsedConstructorPattern, ParsedFloatPattern,
			ParsedIntPattern, ParsedListPattern, ParsedMissingPattern, ParsedNamePattern,
			ParsedOrPattern, ParsedQualifiedConstructorPattern, ParsedStringPattern,
			ParsedTuplePattern, ParsedWildcardPattern,
		),
		ParsedProgram,
		ParsedRecordExprField,
		ParsedSelectArm,
		ParsedSelectArmKind(ParsedSelectAfterArm, ParsedSelectReceiveArm, ParsedSelectSealedArm),
		ParsedStringInterpolationPart(ParsedInterpolationExpr, ParsedInterpolationLiteral),
		ParsedTraitMethodDecl,
		ParsedVarDecl,
		ParsedWithBinding,
		ParsedWithErrorMap,
	string: string


opaque type FinalizedTypecheckProgram = ParsedProgram


record FinalizedImportPathRewrite {
	from_path: String,
	from_module: String,
	import_path: String,
	resolved_module: String
}


---
One piece of an interpolated string's token text. A hole carries its
expression text and its authored `${...}` extent (see
`interpolation_hole_extents`).
---
union StringInterpolationRawPart:
	InterpolationLiteralText(String)
	InterpolationExprText(String, SourceLocation)


private INTERPOLATION_WRAPPER_PREFIX: String = "x="

-- The width of the `${` that opens a hole in the authored source.
private INTERPOLATION_HOLE_OPENER_WIDTH: Int = 2


record UnicodeEscapeResult {
	value: Option[Char],
	next_index: Int
}


record ParsedExprOptionResult {
	value: Option[ParsedExpr],
	diagnostics: List[ParseDiagnostic],
	names: NameTable
}


record ParsedElseBranchResult {
	value: Option[ParsedElseBranch],
	diagnostics: List[ParseDiagnostic],
	names: NameTable
}


record ParsedExprResult {
	value: ParsedExpr,
	diagnostics: List[ParseDiagnostic],
	names: NameTable
}


private union ParsedLogicalFinalizeFrame:
	ParsedLogicalFinalizeVisitRightFrame(ParsedLogicalOp, ParsedExpr, SourceLocation)
	ParsedLogicalFinalizeRebuildParentFrame(ParsedLogicalOp, ParsedExprResult, SourceLocation)


private union ParsedLogicalFinalizeFrameStack:
	ParsedLogicalFinalizeNoFrame
	ParsedLogicalFinalizeMoreFrames(ParsedLogicalFinalizeFrame, ParsedLogicalFinalizeFrameStack)


private union ParsedLogicalFinalizeAction:
	ParsedLogicalFinalizeVisitExpr(ParsedExpr)
	ParsedLogicalFinalizeRebuildExpr(ParsedExprResult)


record InterpolationPartsResult {
	parts: List[ParsedStringInterpolationPart],
	diagnostics: List[ParseDiagnostic],
	names: NameTable
}


record ParsedExprsResult {
	values: List[ParsedExpr],
	diagnostics: List[ParseDiagnostic],
	names: NameTable
}


record RecordFieldsResult {
	fields: List[ParsedRecordExprField],
	diagnostics: List[ParseDiagnostic],
	names: NameTable
}


record DictEntriesResult {
	entries: List[ParsedDictEntry],
	diagnostics: List[ParseDiagnostic],
	names: NameTable
}


record MatchCasesResult {
	cases: List[ParsedMatchCase],
	diagnostics: List[ParseDiagnostic],
	names: NameTable
}


record SelectArmKindResult {
	kind: ParsedSelectArmKind,
	diagnostics: List[ParseDiagnostic],
	names: NameTable
}


record SelectArmsResult {
	arms: List[ParsedSelectArm],
	diagnostics: List[ParseDiagnostic],
	names: NameTable
}


record ConcurrentTimeoutResult {
	timeout: Option[ParsedExpr],
	diagnostics: List[ParseDiagnostic],
	names: NameTable
}


record WithErrorMapResult {
	value: Option[ParsedWithErrorMap],
	diagnostics: List[ParseDiagnostic],
	names: NameTable
}


record WithBindingResult {
	binding: ParsedWithBinding,
	diagnostics: List[ParseDiagnostic],
	names: NameTable
}


record FunctionDeclResult {
	decl: ParsedFunctionDecl,
	diagnostics: List[ParseDiagnostic],
	names: NameTable
}


record VarDeclResult {
	decl: ParsedVarDecl,
	diagnostics: List[ParseDiagnostic],
	names: NameTable
}


record TraitMethodResult {
	method: ParsedTraitMethodDecl,
	diagnostics: List[ParseDiagnostic],
	names: NameTable
}


record TraitMethodsResult {
	methods: List[ParsedTraitMethodDecl],
	diagnostics: List[ParseDiagnostic],
	names: NameTable
}


record FunctionDeclsResult {
	functions: List[ParsedFunctionDecl],
	diagnostics: List[ParseDiagnostic],
	names: NameTable
}


record IdentifierReference {
	name: String,
	qualified_member: Option[String],
	span: SourceLocation
}


record NameRewrite {
	old_name: String,
	new_name: String
}


record HoistExprResult {
	value: ParsedExpr,
	hoisted: List[ParsedFunctionDecl],
	diagnostics: List[ParseDiagnostic],
	next_id: Int
}


record HoistFunctionResult {
	decl: ParsedFunctionDecl,
	hoisted: List[ParsedFunctionDecl],
	diagnostics: List[ParseDiagnostic],
	next_id: Int
}


record HoistFunctionDeclsResult {
	functions: List[ParsedFunctionDecl],
	hoisted: List[ParsedFunctionDecl],
	diagnostics: List[ParseDiagnostic],
	next_id: Int
}


record HoistBlockResult {
	value: List[ParsedExpr],
	hoisted: List[ParsedFunctionDecl],
	diagnostics: List[ParseDiagnostic],
	next_id: Int
}


record HoistDeclsResult {
	decls: List[ParsedDecl],
	diagnostics: List[ParseDiagnostic]
}


record DeclResult {
	decl: ParsedDecl,
	diagnostics: List[ParseDiagnostic],
	names: NameTable
}


record DeclsResult {
	decls: List[ParsedDecl],
	diagnostics: List[ParseDiagnostic],
	names: NameTable
}


private pure func names_from_identifiers(items: List[ParsedIdentifier]) -> List[String]:
	items.map(func(item): item.text)


private pure func names_without(names: List[String], excluded: List[String]) -> List[String]:
	var kept: List[String] = []

	for name in names:
		if not excluded.contains(name):
			kept = kept.append(name)

	kept


private pure func param_bound_names(param: ParsedParam) -> List[String]:
	match param.binder:
		ParsedParamNameBinder(name):
			[name.text]
		ParsedParamTupleBinder(names, _):
			names_from_identifiers(names)
		ParsedParamWildcardBinder(_):
			[]


private pure func params_bound_names(params: List[ParsedParam]) -> List[String]:
	var names: List[String] = []

	for param in params:
		names = names.concat(param_bound_names(param))

	names


private pure func for_binder_bound_names(binder: ParsedForBinder) -> List[String]:
	match binder:
		ParsedForNameBinder(name):
			[name.text]
		ParsedForTupleBinder(names, _):
			names_from_identifiers(names)


private pure func list_spread_bound_names(spread: Option[ParsedListPatternSpread]) -> List[String]:
	match spread:
		Some(ParsedListSpreadName(name)):
			[name.text]
		Some(ParsedListSpreadWildcard(_)):
			[]
		None:
			[]


private pure func pattern_bound_names(pattern: ParsedPattern) -> List[String]:
	match pattern:
		ParsedNamePattern(name):
			[name.text]
		ParsedConstructorPattern(_, args, _):
			patterns_bound_names(args)
		ParsedQualifiedConstructorPattern(_, _, args, _):
			patterns_bound_names(args)
		ParsedTuplePattern(items, _):
			patterns_bound_names(items)
		ParsedListPattern(items, spread, _):
			patterns_bound_names(items).concat(list_spread_bound_names(spread))
		ParsedOrPattern(items, _):
			patterns_bound_names(items)
		_:
			[]


private pure func patterns_bound_names(patterns: List[ParsedPattern]) -> List[String]:
	patterns.flat_map(func(pattern): pattern_bound_names(pattern))


private pure func nested_capture_diagnostic(
	table: SourceTable,
	nested_name: String,
	parent_name: String,
	captured_name: String,
	span: SourceLocation,
) -> ParseDiagnostic:
	parse_error(
		source_location_span(table, span),
		"Nested function '" + nested_name + "' cannot capture parent-scope identifier '" + captured_name + "'",
	)


private pure func first_parse_error(diagnostics: List[ParseDiagnostic]) -> Option[ParseDiagnostic]:
	var result: Option[ParseDiagnostic] = None

	for diagnostic in diagnostics:
		if result.is_none():
			result = Some(diagnostic)

	result


private pure func hex_value(ch: Char) -> Int:
	if ch >= '0' and ch <= '9':
		to_int(ch) - to_int('0')
	else if ch >= 'a' and ch <= 'f':
		10 + to_int(ch) - to_int('a')
	else:
		10 + to_int(ch) - to_int('A')


private pure func decode_unicode_escape_at(text: String, start: Int) -> UnicodeEscapeResult:
	var index: Int = start + 3
	var value: Int = 0
	var digits: Int = 0
	var valid: Bool = True
	var closed: Bool = False

	while (
		index < text.length()
		and valid
		and not closed
	):
		match text.get(index):
			Some('}'):
				closed = True
			Some(ch):
				if (
					ch >= '0' and ch <= '9'
					or ch >= 'a' and ch <= 'f'
					or ch >= 'A' and ch <= 'F'
				):
					value = value * 16 + hex_value(ch)
					digits += 1
					index += 1
				else:
					valid = False
			None:
				valid = False

	-- Unicode scalar values exclude UTF-16 surrogates and values above U+10FFFF.
	if (
		closed
		and digits > 0
		and digits <= 6
		and not (value > 1114111 or value >= 55296 and value <= 57343)
	):
		{
			value = Some(to_char(value)),
			next_index = index + 1
		}
	else:
		{
			value = None,
			next_index = start + 1
		}


private pure func append_lit_part(
	parts: List[StringInterpolationRawPart],
	literal: String,
) -> List[StringInterpolationRawPart]:
	if literal.length() == 0:
		parts
	else:
		parts.append(InterpolationLiteralText(literal))


---
The token text is a byte-indexed copy of the source, so a verbatim run has to
be copied as bytes. Rebuilding one Char at a time would re-encode every byte
of a multibyte character as its own codepoint and corrupt the text. Both
helpers start past the first byte so a run always advances.
---
private pure func plain_literal_run_end(text: String, start: Int) -> Int:
	var index: Int = start + 1

	while index < text.length():
		ch: Char = text.get_or(index, '\0')

		if ch == '\\' or ch == '{':
			break

		index += 1

	index


private pure func plain_expr_run_end(text: String, start: Int, in_string: Bool) -> Int:
	var index: Int = start + 1

	while index < text.length():
		ch: Char = text.get_or(index, '\0')

		if ch == '\\' or ch == '\"':
			break

		if not in_string and (ch == '{' or ch == '}'):
			break

		index += 1

	index


---
The lexer removes the `$` that introduces an interpolation hole. Recover
each hole's authored extent, from its `$` through its closing `}`, from the
original source: the expression inside starts `INTERPOLATION_HOLE_OPENER_WIDTH`
bytes in, so the synthetic wrapper parser can retain locations owned by that
source file, and the extent itself is the hole's own location. No other node
covers exactly those bytes, so Core lowering uses it as the identity of the
call that converts the hole's value to text.
---
private pure func interpolation_hole_extents(
	table: SourceTable,
	span: SourceLocation,
) -> List[SourceLocation]:
	source: SourceFile = source_table_source(table)
	file_id: SourceFileId = source_location_file_id(span)
	var extents: List[SourceLocation] = []
	var offset: Int = source_location_start_offset(span)
	end_offset: Int = source_location_end_offset(span)

	while offset + 1 < end_offset:
		current: Char = source.text.get_or(offset, '\0')

		if current == '\\':
			offset += 2
		else if current == '$' and source.text.get_or(offset + 1, '\0') == '{':
			hole_start: Int = offset
			offset += INTERPOLATION_HOLE_OPENER_WIDTH
			var depth: Int = 1
			var in_string: Bool = False
			var in_char: Bool = False

			while offset < end_offset and depth > 0:
				nested: Char = source.text.get_or(offset, '\0')

				if nested == '\\':
					offset += 2
				else if nested == '\"' and not in_char:
					in_string = not in_string
					offset += 1
				else if nested == '\'' and not in_string:
					in_char = not in_char
					offset += 1
				else if (
					not in_string
					and not in_char
					and nested == '{'
				):
					depth += 1
					offset += 1
				else if (
					not in_string
					and not in_char
					and nested == '}'
				):
					depth -= 1
					offset += 1
				else:
					offset += 1

			-- An unclosed hole's escape skip can step past the string; the
			-- extent never does.
			hole_end: Int = if offset < end_offset:
				offset
			else:
				end_offset

			extents = extents.append(source_location_from_offsets(file_id, hole_start, hole_end))
		else:
			offset += 1

	extents


pure func split_interpolated_string(
	table: SourceTable,
	span: SourceLocation,
	text: String,
) -> Result[List[StringInterpolationRawPart], ParseDiagnostic]:
	var parts: List[StringInterpolationRawPart] = []
	var literal: String = string(64)
	var index: Int = 0
	hole_extents: List[SourceLocation] = interpolation_hole_extents(table, span)
	var hole_index: Int = 0
	var error: Option[ParseDiagnostic] = None

	while index < text.length() and error.is_none():
		ch: Char = text.get_or(index, '\0')

		if ch == '\\' and index + 1 < text.length():
			next: Char = text.get_or(index + 1, '\0')

			if (
				next == 'u'
				and index + 2 < text.length()
				and text.get_or(index + 2, '\0') == '{'
			):
				decoded = decode_unicode_escape_at(text, index)

				match decoded.value:
					Some(value):
						literal = literal.append_char(value)
					None:
						literal = literal.append_char(ch)

				index = decoded.next_index
			else:
				match next:
					'n':
						literal += "\n"
						index += 2
					't':
						literal += "\t"
						index += 2
					'r':
						literal += "\r"
						index += 2
					'\\':
						literal = literal.append_char('\\')
						index += 2
					'\"':
						literal = literal.append_char('\"')
						index += 2
					'\'':
						literal = literal.append_char('\'')
						index += 2
					'0':
						literal = literal.append_char('\0')
						index += 2
					'{':
						literal = literal.append_char('{')
						index += 2
					'}':
						literal = literal.append_char('}')
						index += 2
					_:
						literal = literal.append_char(ch)
						index += 1
		else if ch == '{':
			hole_extent: Option[SourceLocation] = hole_extents.get(hole_index)
			hole_index += 1
			parts = append_lit_part(parts, literal)
			literal = ""
			index += 1

			var expr_text: String = string(32)
			var depth: Int = 1
			var in_string: Bool = False

			while index < text.length() and depth > 0:
				current: Char = text.get_or(index, '\0')

				if current == '\\' and index + 1 < text.length():
					expr_text += text.substring(index, 2)
					index += 2
				else if current == '\"':
					in_string = not in_string
					expr_text = expr_text.append_char(current)
					index += 1
				else if in_string:
					run_end: Int = plain_expr_run_end(text, index, True)
					expr_text += text.substring(index, run_end - index)
					index = run_end
				else if current == '{':
					depth += 1
					expr_text = expr_text.append_char(current)
					index += 1
				else if current == '}':
					depth -= 1

					if depth > 0:
						expr_text = expr_text.append_char(current)

					index += 1
				else:
					run_end: Int = plain_expr_run_end(text, index, False)
					expr_text += text.substring(index, run_end - index)
					index = run_end

			if depth > 0:
				error = Some(
					parse_error(
						source_location_span(table, span),
						"Unclosed `" + "$" + "{` in string interpolation",
					),
				)
			else:
				match hole_extent:
					Some(extent):
						parts = parts.append(InterpolationExprText(expr_text, extent))
					None:
						error = Some(unmatched_interpolation_holes(table, span))
		else:
			run_end: Int = plain_literal_run_end(text, index)
			literal += text.substring(index, run_end - index)
			index = run_end

	if error.is_none() and hole_index != hole_extents.length():
		error = Some(unmatched_interpolation_holes(table, span))

	match error:
		Some(diagnostic):
			Err(diagnostic)
		None:
			Ok(append_lit_part(parts, literal))


---
The token text and the authored source disagree on how many holes a string has.
Holes are paired with their `${...}` extents in order, so the pairing holds only
when the counts agree; falling back to the string's own span would give a hole
a location it does not have and an identity another node shares. They disagree
when this lexer reads a plain brace as a hole, as it does in an interpolated
pipe string (docs/issues/interpolation_nesting_in_the_existing_lexer.md).
---
private pure func unmatched_interpolation_holes(
	table: SourceTable,
	span: SourceLocation,
) -> ParseDiagnostic:
	parse_error_expected(
		source_location_span(table, span),
		"A brace in this interpolated string is read as a hole, but only `" + "$" + "{...}` opens one",
		[],
		Some("write a literal brace in an interpolated string as `\\{` or `\\}`"),
	)


private pure func collect_name_reference(
	bound: List[String],
	name: ParsedIdentifier,
) -> List[IdentifierReference]:
	if bound.contains(name.text):
		[]
	else:
		[
			{
				name = name.text,
				qualified_member = None,
				span = name.span
			},
		]


private pure func collect_free_else_branch(
	bound: List[String],
	value: Option[ParsedElseBranch],
) -> List[IdentifierReference]:
	match value:
		Some(branch):
			collect_free_identifiers(bound, branch.body)
		None:
			[]


private pure func collect_free_exprs(
	bound: List[String],
	items: List[ParsedExpr],
) -> List[IdentifierReference]:
	var references: List[IdentifierReference] = []

	for item in items:
		references = references.concat(collect_free_identifiers(bound, item))

	references


private pure func collect_free_record_fields(
	bound: List[String],
	fields: List[ParsedRecordExprField],
) -> List[IdentifierReference]:
	var references: List[IdentifierReference] = []

	for field in fields:
		references = references.concat(collect_free_identifiers(bound, field.value))

	references


private pure func collect_free_dict_entries(
	bound: List[String],
	entries: List[ParsedDictEntry],
) -> List[IdentifierReference]:
	var references: List[IdentifierReference] = []

	for entry in entries:
		references = references
			.concat(collect_free_identifiers(bound, entry.key))
			.concat(collect_free_identifiers(bound, entry.value))

	references


private pure func collect_free_block(
	bound: List[String],
	items: List[ParsedExpr],
) -> List[IdentifierReference]:
	var current_bound: List[String] = bound
	var references: List[IdentifierReference] = []

	for item in items:
		match item:
			ParsedVarDeclExpr(name, _, value, _, _):
				references = references.concat(collect_free_identifiers(current_bound, value))
				current_bound = current_bound.append(name.text)
			ParsedTupleDestructExpr(names, value, _):
				references = references.concat(collect_free_identifiers(current_bound, value))
				current_bound = names_from_identifiers(names).concat(current_bound)
			ParsedQuestionBindExpr(name, _, value, _):
				references = references.concat(collect_free_identifiers(current_bound, value))
				current_bound = current_bound.append(name.text)
			_:
				references = references.concat(collect_free_identifiers(current_bound, item))

	references


private pure func collect_free_concurrent_block_body(
	bound: List[String],
	body: ParsedExpr,
) -> List[IdentifierReference]:
	match body:
		ParsedBlockExpr(items, _):
			var references: List[IdentifierReference] = []

			for item in items:
				match item:
					ParsedAssignExpr(_, value, _) | ParsedVarDeclExpr(_, _, value, False, _):
						references = references.concat(collect_free_identifiers(bound, value))
					_:
						references = references.concat(collect_free_identifiers(bound, item))

			references
		_:
			collect_free_identifiers(bound, body)


private pure func collect_free_match_cases(
	bound: List[String],
	cases: List[ParsedMatchCase],
) -> List[IdentifierReference]:
	var references: List[IdentifierReference] = []

	for case in cases:
		case_bound: List[String] = pattern_bound_names(case.pattern).concat(bound)
		references = references.concat(collect_free_identifiers(case_bound, case.body))

	references


private pure func collect_free_select_arm_kind(
	bound: List[String],
	kind: ParsedSelectArmKind,
) -> List[IdentifierReference]:
	match kind:
		ParsedSelectReceiveArm(_, channel):
			collect_free_identifiers(bound, channel)
		ParsedSelectSealedArm(channel):
			collect_free_identifiers(bound, channel)
		ParsedSelectAfterArm(timeout):
			collect_free_identifiers(bound, timeout)


private pure func collect_free_select_arms(
	bound: List[String],
	arms: List[ParsedSelectArm],
) -> List[IdentifierReference]:
	var references: List[IdentifierReference] = []

	for arm in arms:
		references = references.concat(collect_free_select_arm_kind(bound, arm.kind))

		body_bound: List[String] = match arm.kind:
			ParsedSelectReceiveArm(name, _):
				[name.text].concat(bound)
			_:
				bound

		references = references.concat(collect_free_identifiers(body_bound, arm.body))

	references


private pure func collect_free_with_error_map(
	bound: List[String],
	error_map: Option[ParsedWithErrorMap],
) -> List[IdentifierReference]:
	match error_map:
		Some(mapper):
			collect_free_identifiers(
				[mapper.name.text].concat(bound),
				mapper.value,
			)
		None:
			[]


private pure func collect_free_concurrent_timeout(
	bound: List[String],
	timeout: Option[ParsedExpr],
) -> List[IdentifierReference]:
	match timeout:
		Some(expr):
			collect_free_identifiers(bound, expr)
		None:
			[]


private pure func collect_free_interpolation_parts(
	bound: List[String],
	parts: List[ParsedStringInterpolationPart],
) -> List[IdentifierReference]:
	var references: List[IdentifierReference] = []

	for part in parts:
		match part:
			ParsedInterpolationExpr(expr, _):
				references = references.concat(collect_free_identifiers(bound, expr))
			ParsedInterpolationLiteral(_):
				void

	references


private pure func collect_free_identifiers(
	bound: List[String],
	expr: ParsedExpr,
) -> List[IdentifierReference]:
	match expr:
		ParsedNameExpr(name):
			collect_name_reference(bound, name)
		ParsedStringInterpolationPartsExpr(parts, _, _):
			collect_free_interpolation_parts(bound, parts)
		ParsedUnaryExpr(_, value, _):
			collect_free_identifiers(bound, value)
		ParsedBinaryExpr(_, left, right, _):
			collect_free_identifiers(bound, left).concat(collect_free_identifiers(bound, right))
		ParsedLogicalExpr(_, left, right, _):
			collect_free_identifiers(bound, left).concat(collect_free_identifiers(bound, right))
		ParsedRangeExpr(start, finish, _):
			collect_free_identifiers(bound, start).concat(collect_free_identifiers(bound, finish))
		ParsedCallExpr(callee, args, _):
			collect_free_identifiers(bound, callee).concat(collect_free_exprs(bound, args))
		ParsedFieldAccessExpr(target, field, _):
			match target:
				ParsedNameExpr(qualifier):
					if bound.contains(qualifier.text):
						[]
					else:
						[
							{
								name = qualifier.text,
								qualified_member = Some(field.text),
								span = qualifier.span
							},
						]
				_:
					collect_free_identifiers(bound, target)
		ParsedSubscriptExpr(target, indices, _):
			collect_free_identifiers(bound, target).concat(collect_free_exprs(bound, indices))
		ParsedListExpr(items, _):
			collect_free_exprs(bound, items)
		ParsedTupleExpr(items, _):
			collect_free_exprs(bound, items)
		ParsedRecordExpr(fields, _):
			collect_free_record_fields(bound, fields)
		ParsedRecordUpdateExpr(base, fields, _):
			collect_free_identifiers(bound, base).concat(collect_free_record_fields(bound, fields))
		ParsedDictExpr(entries, _):
			collect_free_dict_entries(bound, entries)
		ParsedVectorExpr(items, _):
			collect_free_exprs(bound, items)
		ParsedOpaqueIntoExpr(_, value, _):
			collect_free_identifiers(bound, value)
		ParsedOpaqueFromExpr(_, value, _):
			collect_free_identifiers(bound, value)
		ParsedBlockExpr(items, _):
			collect_free_block(bound, items)
		ParsedIfExpr(cond, then_expr, else_expr, _):
			collect_free_identifiers(bound, cond)
				.concat(collect_free_identifiers(bound, then_expr))
				.concat(collect_free_else_branch(bound, else_expr))
		ParsedMatchExpr(value, cases, _):
			collect_free_identifiers(bound, value).concat(collect_free_match_cases(bound, cases))
		ParsedSelectExpr(arms, _):
			collect_free_select_arms(bound, arms)
		ParsedWithExpr(binding, body, _):
			collect_free_identifiers(bound, binding.value)
				.concat(collect_free_with_error_map(bound, binding.error_map))
				.concat(collect_free_identifiers([binding.name.text].concat(bound), body))
		ParsedDebugBlockExpr(body, _):
			collect_free_identifiers(bound, body)
		ParsedLambdaExpr(_, params, _, body, _):
			collect_free_identifiers(
				params
					.map(func(param): param.name.text)
					.concat(bound),
				body,
			)
		ParsedFunctionDeclExpr(_):
			[]
		ParsedWhileExpr(cond, body, _):
			collect_free_identifiers(bound, cond).concat(collect_free_identifiers(bound, body))
		ParsedForExpr(binder, iterable, body, _):
			collect_free_identifiers(
				bound,
				iterable,
			).concat(collect_free_identifiers(for_binder_bound_names(binder).concat(bound), body))
		ParsedConcurrentBlockExpr(options, body, _):
			collect_free_concurrent_timeout(
				bound,
				options.timeout,
			).concat(collect_free_concurrent_block_body(bound, body))
		ParsedConcurrentForExpr(name, iterable, options, body, _):
			collect_free_identifiers(bound, iterable)
				.concat(collect_free_concurrent_timeout(bound, options.timeout))
				.concat(collect_free_identifiers([name.text].concat(bound), body))
		ParsedDetachExpr(body, _):
			collect_free_identifiers(bound, body)
		ParsedVarDeclExpr(_, _, value, _, _):
			collect_free_identifiers(bound, value)
		ParsedAssignExpr(name, value, _):
			collect_name_reference(bound, name).concat(collect_free_identifiers(bound, value))
		ParsedCompoundAssignExpr(name, _, value, _):
			collect_name_reference(bound, name).concat(collect_free_identifiers(bound, value))
		ParsedSubscriptAssignExpr(target, indices, value, _):
			collect_free_identifiers(bound, target)
				.concat(collect_free_exprs(bound, indices))
				.concat(collect_free_identifiers(bound, value))
		ParsedTupleDestructExpr(_, value, _):
			collect_free_identifiers(bound, value)
		ParsedQuestionBindExpr(_, _, value, _):
			collect_free_identifiers(bound, value)
		_:
			[]


---
Initializer planning and other semantic consumers need the same lexical
binding rules as nested-function capture analysis. Keep that policy owned
by source-AST finalization instead of duplicating a partial expression walk
in later compiler stages. Lambda bodies are included because their free
values are captured when the closure is created and may also be needed to
infer its type. Typed callable-dependency collection separately excludes
calls in deferred bodies because creating a closure does not execute them.
---
pure func parsed_expr_free_identifier_references(expr: ParsedExpr) -> List[IdentifierReference]:
	collect_free_identifiers([], expr)


private pure func find_capture(
	parent_locals: List[String],
	nested_body: ParsedExpr,
) -> Option[IdentifierReference]:
	var captured: Option[IdentifierReference] = None

	for reference in collect_free_identifiers([], nested_body):
		if captured.is_none() and parent_locals.contains(reference.name):
			captured = Some(reference)

	captured


private pure func rewrite_identifier_name(
	name: ParsedIdentifier,
	rewrites: List[NameRewrite],
) -> ParsedIdentifier:
	var rewritten = name

	for rewrite in rewrites:
		if rewritten.text == rewrite.old_name:
			rewritten = { rewritten | text = rewrite.new_name }

	rewritten


private pure func rewrite_identifier_exprs(
	rewrites: List[NameRewrite],
	items: List[ParsedExpr],
) -> List[ParsedExpr]:
	var values: List[ParsedExpr] = []

	for item in items:
		values = values.append(rewrite_identifier_expr(rewrites, item))

	values


private pure func rewrite_identifier_else_branch(
	rewrites: List[NameRewrite],
	value: Option[ParsedElseBranch],
) -> Option[ParsedElseBranch]:
	value.map(func(branch): { branch | body = rewrite_identifier_expr(rewrites, branch.body) })


private pure func rewrite_identifier_record_fields(
	rewrites: List[NameRewrite],
	fields: List[ParsedRecordExprField],
) -> List[ParsedRecordExprField]:
	var values: List[ParsedRecordExprField] = []

	for field in fields:
		values = values.append({ field | value = rewrite_identifier_expr(rewrites, field.value) })

	values


private pure func rewrite_identifier_dict_entries(
	rewrites: List[NameRewrite],
	entries: List[ParsedDictEntry],
) -> List[ParsedDictEntry]:
	var values: List[ParsedDictEntry] = []

	for entry in entries:
		values = values.append({ entry |
				key = rewrite_identifier_expr(rewrites, entry.key),
				value = rewrite_identifier_expr(rewrites, entry.value)
			})

	values


private pure func rewrite_identifier_match_cases(
	rewrites: List[NameRewrite],
	cases: List[ParsedMatchCase],
) -> List[ParsedMatchCase]:
	var values: List[ParsedMatchCase] = []

	for item in cases:
		values = values.append({ item | body = rewrite_identifier_expr(rewrites, item.body) })

	values


private pure func rewrite_identifier_select_arm_kind(
	rewrites: List[NameRewrite],
	kind: ParsedSelectArmKind,
) -> ParsedSelectArmKind:
	match kind:
		ParsedSelectReceiveArm(name, channel):
			ParsedSelectReceiveArm(
				name,
				rewrite_identifier_expr(rewrites, channel),
			)
		ParsedSelectSealedArm(channel):
			ParsedSelectSealedArm(rewrite_identifier_expr(rewrites, channel))
		ParsedSelectAfterArm(timeout):
			ParsedSelectAfterArm(rewrite_identifier_expr(rewrites, timeout))


private pure func rewrite_identifier_select_arms(
	rewrites: List[NameRewrite],
	arms: List[ParsedSelectArm],
) -> List[ParsedSelectArm]:
	var values: List[ParsedSelectArm] = []

	for arm in arms:
		values = values.append({ arm |
				kind = rewrite_identifier_select_arm_kind(rewrites, arm.kind),
				body = rewrite_identifier_expr(rewrites, arm.body)
			})

	values


private pure func rewrite_identifier_with_error_map(
	rewrites: List[NameRewrite],
	value: Option[ParsedWithErrorMap],
) -> Option[ParsedWithErrorMap]:
	match value:
		Some(error_map):
			Some({ error_map | value = rewrite_identifier_expr(rewrites, error_map.value) })
		None:
			None


private pure func rewrite_identifier_with_binding(
	rewrites: List[NameRewrite],
	binding: ParsedWithBinding,
) -> ParsedWithBinding:
	{ binding |
		value = rewrite_identifier_expr(rewrites, binding.value),
		error_map = rewrite_identifier_with_error_map(rewrites, binding.error_map)
	}


private pure func rewrite_identifier_concurrent_timeout(
	rewrites: List[NameRewrite],
	timeout: Option[ParsedExpr],
) -> Option[ParsedExpr]:
	match timeout:
		Some(expr):
			Some(rewrite_identifier_expr(rewrites, expr))
		None:
			None


private pure func rewrite_identifier_interpolation_parts(
	rewrites: List[NameRewrite],
	parts: List[ParsedStringInterpolationPart],
) -> List[ParsedStringInterpolationPart]:
	var values: List[ParsedStringInterpolationPart] = []

	for part in parts:
		match part:
			ParsedInterpolationExpr(expr, hole):
				values = values.append(
					ParsedInterpolationExpr(
						rewrite_identifier_expr(rewrites, expr),
						hole,
					),
				)
			ParsedInterpolationLiteral(_):
				values = values.append(part)

	values


private pure func rewrite_identifier_expr(
	rewrites: List[NameRewrite],
	expr: ParsedExpr,
) -> ParsedExpr:
	match expr:
		ParsedNameExpr(name):
			ParsedNameExpr(rewrite_identifier_name(name, rewrites))
		ParsedStringInterpolationPartsExpr(parts, is_multiline, span):
			ParsedStringInterpolationPartsExpr(
				rewrite_identifier_interpolation_parts(rewrites, parts),
				is_multiline,
				span,
			)
		ParsedUnaryExpr(op, value, span):
			ParsedUnaryExpr(
				op,
				rewrite_identifier_expr(rewrites, value),
				span,
			)
		ParsedBinaryExpr(op, left, right, span):
			ParsedBinaryExpr(
				op,
				rewrite_identifier_expr(rewrites, left),
				rewrite_identifier_expr(rewrites, right),
				span,
			)
		ParsedLogicalExpr(op, left, right, span):
			ParsedLogicalExpr(
				op,
				rewrite_identifier_expr(rewrites, left),
				rewrite_identifier_expr(rewrites, right),
				span,
			)
		ParsedRangeExpr(start, finish, span):
			ParsedRangeExpr(
				rewrite_identifier_expr(rewrites, start),
				rewrite_identifier_expr(rewrites, finish),
				span,
			)
		ParsedCallExpr(callee, args, span):
			ParsedCallExpr(
				rewrite_identifier_expr(rewrites, callee),
				rewrite_identifier_exprs(rewrites, args),
				span,
			)
		ParsedFieldAccessExpr(target, field, span):
			ParsedFieldAccessExpr(
				rewrite_identifier_expr(rewrites, target),
				field,
				span,
			)
		ParsedSubscriptExpr(target, indices, span):
			ParsedSubscriptExpr(
				rewrite_identifier_expr(rewrites, target),
				rewrite_identifier_exprs(rewrites, indices),
				span,
			)
		ParsedListExpr(items, span):
			ParsedListExpr(
				rewrite_identifier_exprs(rewrites, items),
				span,
			)
		ParsedTupleExpr(items, span):
			ParsedTupleExpr(
				rewrite_identifier_exprs(rewrites, items),
				span,
			)
		ParsedRecordExpr(fields, span):
			ParsedRecordExpr(
				rewrite_identifier_record_fields(rewrites, fields),
				span,
			)
		ParsedRecordUpdateExpr(base, fields, span):
			ParsedRecordUpdateExpr(
				rewrite_identifier_expr(rewrites, base),
				rewrite_identifier_record_fields(rewrites, fields),
				span,
			)
		ParsedDictExpr(entries, span):
			ParsedDictExpr(
				rewrite_identifier_dict_entries(rewrites, entries),
				span,
			)
		ParsedVectorExpr(items, span):
			ParsedVectorExpr(
				rewrite_identifier_exprs(rewrites, items),
				span,
			)
		ParsedOpaqueIntoExpr(type_expr, value, span):
			ParsedOpaqueIntoExpr(
				type_expr,
				rewrite_identifier_expr(rewrites, value),
				span,
			)
		ParsedOpaqueFromExpr(type_expr, value, span):
			ParsedOpaqueFromExpr(
				type_expr,
				rewrite_identifier_expr(rewrites, value),
				span,
			)
		ParsedBlockExpr(items, span):
			ParsedBlockExpr(
				rewrite_identifier_exprs(rewrites, items),
				span,
			)
		ParsedIfExpr(cond, then_expr, else_expr, span):
			ParsedIfExpr(
				rewrite_identifier_expr(rewrites, cond),
				rewrite_identifier_expr(rewrites, then_expr),
				rewrite_identifier_else_branch(rewrites, else_expr),
				span,
			)
		ParsedMatchExpr(value, cases, span):
			ParsedMatchExpr(
				rewrite_identifier_expr(rewrites, value),
				rewrite_identifier_match_cases(rewrites, cases),
				span,
			)
		ParsedSelectExpr(arms, span):
			ParsedSelectExpr(
				rewrite_identifier_select_arms(rewrites, arms),
				span,
			)
		ParsedWithExpr(binding, body, span):
			ParsedWithExpr(
				rewrite_identifier_with_binding(rewrites, binding),
				rewrite_identifier_expr(rewrites, body),
				span,
			)
		ParsedDebugBlockExpr(body, span):
			ParsedDebugBlockExpr(
				rewrite_identifier_expr(rewrites, body),
				span,
			)
		ParsedLambdaExpr(_, _, _, _, _):
			expr
		ParsedFunctionDeclExpr(_):
			expr
		ParsedWhileExpr(cond, body, span):
			ParsedWhileExpr(
				rewrite_identifier_expr(rewrites, cond),
				rewrite_identifier_expr(rewrites, body),
				span,
			)
		ParsedForExpr(binder, iterable, body, span):
			ParsedForExpr(
				binder,
				rewrite_identifier_expr(rewrites, iterable),
				rewrite_identifier_expr(rewrites, body),
				span,
			)
		ParsedConcurrentBlockExpr(options, body, span):
			ParsedConcurrentBlockExpr(
				{ options |
					timeout = rewrite_identifier_concurrent_timeout(rewrites, options.timeout)
				},
				rewrite_identifier_expr(rewrites, body),
				span,
			)
		ParsedConcurrentForExpr(name, iterable, options, body, span):
			ParsedConcurrentForExpr(
				name,
				rewrite_identifier_expr(rewrites, iterable),
				{ options |
					timeout = rewrite_identifier_concurrent_timeout(rewrites, options.timeout)
				},
				rewrite_identifier_expr(rewrites, body),
				span,
			)
		ParsedDetachExpr(body, span):
			ParsedDetachExpr(
				rewrite_identifier_expr(rewrites, body),
				span,
			)
		ParsedVarDeclExpr(name, type_expr, value, is_mutable, span):
			ParsedVarDeclExpr(
				name,
				type_expr,
				rewrite_identifier_expr(rewrites, value),
				is_mutable,
				span,
			)
		ParsedAssignExpr(name, value, span):
			ParsedAssignExpr(
				name,
				rewrite_identifier_expr(rewrites, value),
				span,
			)
		ParsedCompoundAssignExpr(name, op, value, span):
			ParsedCompoundAssignExpr(
				name,
				op,
				rewrite_identifier_expr(rewrites, value),
				span,
			)
		ParsedSubscriptAssignExpr(target, indices, value, span):
			ParsedSubscriptAssignExpr(
				rewrite_identifier_expr(rewrites, target),
				rewrite_identifier_exprs(rewrites, indices),
				rewrite_identifier_expr(rewrites, value),
				span,
			)
		ParsedTupleDestructExpr(names, value, span):
			ParsedTupleDestructExpr(
				names,
				rewrite_identifier_expr(rewrites, value),
				span,
			)
		ParsedQuestionBindExpr(name, type_expr, value, span):
			ParsedQuestionBindExpr(
				name,
				type_expr,
				rewrite_identifier_expr(rewrites, value),
				span,
			)
		_:
			expr


private pure func apply_name_rewrites(rewrites: List[NameRewrite], expr: ParsedExpr) -> ParsedExpr:
	if rewrites.length() == 0:
		expr
	else:
		rewrite_identifier_expr(rewrites, expr)


private pure func hoist_nested_body(
	table: SourceTable,
	parent_name: String,
	parent_locals: List[String],
	body: ParsedExpr,
	next_id: Int,
) -> HoistExprResult:
	match body:
		ParsedBlockExpr(items, span):
			result = hoist_nested_block_items(table, parent_name, parent_locals, items, next_id)
			{
				value = ParsedBlockExpr(result.value, span),
				hoisted = result.hoisted,
				diagnostics = result.diagnostics,
				next_id = result.next_id
			}
		_:
			{
				value = body,
				hoisted = [],
				diagnostics = [],
				next_id = next_id
			}


private pure func hoist_nested_block_items(
	table: SourceTable,
	parent_name: String,
	parent_locals: List[String],
	items: List[ParsedExpr],
	next_id: Int,
) -> HoistBlockResult:
	var values: List[ParsedExpr] = []
	var hoisted: List[ParsedFunctionDecl] = []
	var diagnostics: List[ParseDiagnostic] = []
	var rewrites: List[NameRewrite] = []
	var current_locals: List[String] = parent_locals
	var current_id: Int = next_id

	for item in items:
		match item:
			ParsedFunctionDeclExpr(nested_decl):
				original_name: String = nested_decl.name.text
				new_name: String = "__nested_" + parent_name + "_" + original_name + "_" + current_id.to_string()
				current_id += 1
				self_rewrite: NameRewrite = {
					old_name = original_name,
					new_name = new_name
				}

				own_params: List[String] = params_bound_names(nested_decl.params)
				var external_locals: List[String] = names_without(current_locals, own_params)
				external_locals = names_without(
					external_locals,
					rewrites.map(func(rewrite): rewrite.old_name),
				)

				new_body: Option[ParsedExpr] = match nested_decl.body:
					Some(raw_body):
						match find_capture(external_locals, raw_body):
							Some(reference):
								diagnostics = diagnostics.append(
									nested_capture_diagnostic(
										table,
										original_name,
										parent_name,
										reference.name,
										reference.span,
									),
								)
							None:
								void

						body_with_rewrites = apply_name_rewrites(
							rewrites.append(self_rewrite),
							raw_body,
						)
						body_result = hoist_nested_body(
							table,
							new_name,
							own_params,
							body_with_rewrites,
							current_id,
						)
						current_id = body_result.next_id

						if not body_result.hoisted.is_empty():
							for hoisted_decl in body_result.hoisted:
								hoisted = hoisted.append(hoisted_decl)

						diagnostics = diagnostics.concat(body_result.diagnostics)
						Some(body_result.value)
					None:
						None

				renamed_decl: ParsedFunctionDecl = { nested_decl |
					name = { nested_decl.name | text = new_name },
					body = new_body
				}

				hoisted = hoisted.append(renamed_decl)
				values = values.append(ParsedVoidExpr(nested_decl.span))
				rewrites = [self_rewrite].concat(rewrites)
			ParsedVarDeclExpr(name, _, _, _, _):
				values = values.append(apply_name_rewrites(rewrites, item))
				current_locals = current_locals.append(name.text)
			ParsedTupleDestructExpr(names, _, _):
				values = values.append(apply_name_rewrites(rewrites, item))
				current_locals = names_from_identifiers(names).concat(current_locals)
			_:
				values = values.append(apply_name_rewrites(rewrites, item))

	{
		value = values,
		hoisted = hoisted,
		diagnostics = diagnostics,
		next_id = current_id
	}


private pure func hoist_nested_function_decl(
	table: SourceTable,
	decl: ParsedFunctionDecl,
	next_id: Int,
) -> HoistFunctionResult:
	match decl.body:
		Some(body):
			body_result = hoist_nested_body(
				table,
				decl.name.text,
				params_bound_names(decl.params),
				body,
				next_id,
			)
			{
				decl = { decl | body = Some(body_result.value) },
				hoisted = body_result.hoisted,
				diagnostics = body_result.diagnostics,
				next_id = body_result.next_id
			}
		None:
			{
				decl = decl,
				hoisted = [],
				diagnostics = [],
				next_id = next_id
			}


private pure func hoist_nested_function_decls(
	table: SourceTable,
	items: List[ParsedFunctionDecl],
	next_id: Int,
) -> HoistFunctionDeclsResult:
	var values: List[ParsedFunctionDecl] = []
	var hoisted: List[ParsedFunctionDecl] = []
	var diagnostics: List[ParseDiagnostic] = []
	var current_id: Int = next_id

	for item in items:
		result = hoist_nested_function_decl(table, item, current_id)
		current_id = result.next_id
		values = values.append(result.decl)

		if not result.hoisted.is_empty():
			for hoisted_decl in result.hoisted:
				hoisted = hoisted.append(hoisted_decl)

		diagnostics = diagnostics.concat(result.diagnostics)

	{
		functions = values,
		hoisted = hoisted,
		diagnostics = diagnostics,
		next_id = current_id
	}


private pure func hoist_nested_decls(
	table: SourceTable,
	decls: List[ParsedDecl],
) -> HoistDeclsResult:
	var values: List[ParsedDecl] = []
	var diagnostics: List[ParseDiagnostic] = []
	var current_id: Int = 0

	for decl in decls:
		match decl:
			FunctionParsedDecl(function_decl):
				result = hoist_nested_function_decl(table, function_decl, current_id)
				current_id = result.next_id

				if not result.hoisted.is_empty():
					for hoisted_decl in result.hoisted:
						values = values.append(FunctionParsedDecl(hoisted_decl))

				values = values.append(FunctionParsedDecl(result.decl))
				diagnostics = diagnostics.concat(result.diagnostics)
			ImplParsedDecl(impl_decl):
				result = hoist_nested_function_decls(table, impl_decl.methods, current_id)
				current_id = result.next_id

				if not result.hoisted.is_empty():
					for hoisted_decl in result.hoisted:
						values = values.append(FunctionParsedDecl(hoisted_decl))

				values = values.append(ImplParsedDecl({ impl_decl | methods = result.functions }))
				diagnostics = diagnostics.concat(result.diagnostics)
			PrivateParsedDecl(inner, span):
				match inner:
					FunctionParsedDecl(function_decl):
						result = hoist_nested_function_decl(table, function_decl, current_id)
						current_id = result.next_id

						if not result.hoisted.is_empty():
							for hoisted_decl in result.hoisted:
								values = values.append(FunctionParsedDecl(hoisted_decl))

						values = values.append(
							PrivateParsedDecl(
								FunctionParsedDecl(result.decl),
								span,
							),
						)
						diagnostics = diagnostics.concat(result.diagnostics)
					_:
						values = values.append(decl)
			_:
				values = values.append(decl)

	{
		decls = values,
		diagnostics = diagnostics
	}


private pure func subscript_get_builtin_name(arity: Int) -> String:
	if arity == 1:
		"checked_get"
	else if arity == 2:
		"matrix_checked_get"
	else if arity == 3:
		"tensor3_checked_get"
	else if arity == 4:
		"tensor4_checked_get"
	else if arity == 5:
		"tensor5_checked_get"
	else:
		"tensor" + arity.to_string() + "_checked_get"


private pure func make_untyped_call_expr(
	span: SourceLocation,
	name: String,
	args: List[ParsedExpr],
) -> ParsedExpr:
	-- The builtin callees are a closed synthesized vocabulary. Only the callee of
	-- a subscript with zero or more than five indices (`tensorN_checked_get`,
	-- which the standard library does not declare, so it is a name error
	-- downstream) falls outside it; this pass has no name accumulator to mint
	-- that spelling into, so it keeps the pending id.
	callee_id: NameId = match name_table_find_id(SYNTHESIZED_NAME_TABLE, name):
		Some(id):
			id
		None:
			name_id_pending_dynamic_intern()

	callee: ParsedExpr = ParsedNameExpr({
		name = callee_id,
		text = name,
		span = span,
	})
	ParsedCallExpr(callee, args, span)


private pure func rewrite_subscript_read_node(
	target: ParsedExpr,
	indices: List[ParsedExpr],
	span: SourceLocation,
) -> ParsedExpr:
	if indices.length() == 1:
		match indices.get(0):
			Some(ParsedRangeExpr(start, finish, _)):
				make_untyped_call_expr(
					span,
					"checked_slice",
					[target, start, finish],
				)
			Some(index):
				make_untyped_call_expr(
					span,
					"checked_get",
					[target, index],
				)
			None:
				make_untyped_call_expr(span, subscript_get_builtin_name(0), [target])
	else:
		make_untyped_call_expr(
			span,
			subscript_get_builtin_name(indices.length()),
			[target].concat(indices),
		)


private pure func rewrite_subscript_read_optional_expr(
	value: Option[ParsedExpr],
) -> Option[ParsedExpr]:
	match value:
		Some(expr):
			rewritten = rewrite_subscript_read_expr(expr)

			if same_object(rewritten, expr):
				value
			else:
				Some(rewritten)
		None:
			value


--- Returns `value` itself when the branch body is unchanged, so callers can test identity.
private pure func rewrite_subscript_read_else_branch(
	value: Option[ParsedElseBranch],
) -> Option[ParsedElseBranch]:
	match value:
		Some(branch):
			rewritten = rewrite_subscript_read_expr(branch.body)

			if same_object(rewritten, branch.body):
				value
			else:
				Some({ branch | body = rewritten })
		None:
			value


private pure func optional_subscript_read_expr_changed(
	original: Option[ParsedExpr],
	rewritten: Option[ParsedExpr],
) -> Bool:
	match (original, rewritten):
		(Some(before), Some(after)):
			not same_object(before, after)
		(None, None):
			False
		_:
			True


private pure func rewrite_subscript_read_exprs(items: List[ParsedExpr]) -> List[ParsedExpr]:
	-- Keep the original list until a child changes; the first set makes the
	-- changed path's private COW copy, and unchanged paths retain identity.
	var rewritten: List[ParsedExpr] = items
	var index: Int = 0

	for item in items:
		mapped = rewrite_subscript_read_expr(item)

		if not same_object(mapped, item):
			rewritten = rewritten.set(index, mapped)

		index += 1

	rewritten


private pure func rewrite_subscript_read_interpolation_parts(
	parts: List[ParsedStringInterpolationPart],
) -> List[ParsedStringInterpolationPart]:
	var rewritten: List[ParsedStringInterpolationPart] = parts
	var index: Int = 0

	for part in parts:
		match part:
			ParsedInterpolationExpr(expr, hole):
				mapped = rewrite_subscript_read_expr(expr)

				if not same_object(mapped, expr):
					rewritten = rewritten.set(
						index,
						ParsedInterpolationExpr(mapped, hole),
					)
			ParsedInterpolationLiteral(_):
				void

		index += 1

	rewritten


private pure func rewrite_subscript_read_record_fields(
	fields: List[ParsedRecordExprField],
) -> List[ParsedRecordExprField]:
	var rewritten: List[ParsedRecordExprField] = fields
	var index: Int = 0

	for field in fields:
		mapped = rewrite_subscript_read_expr(field.value)

		if not same_object(mapped, field.value):
			rewritten = rewritten.set(index, { field | value = mapped })

		index += 1

	rewritten


private pure func rewrite_subscript_read_dict_entries(
	entries: List[ParsedDictEntry],
) -> List[ParsedDictEntry]:
	var rewritten: List[ParsedDictEntry] = entries
	var index: Int = 0

	for entry in entries:
		key = rewrite_subscript_read_expr(entry.key)
		value = rewrite_subscript_read_expr(entry.value)

		if not same_object(key, entry.key) or not same_object(value, entry.value):
			rewritten = rewritten.set(
				index,
				{ entry |
					key = key,
					value = value
				},
			)

		index += 1

	rewritten


private pure func rewrite_subscript_read_match_cases(
	cases: List[ParsedMatchCase],
) -> List[ParsedMatchCase]:
	var rewritten: List[ParsedMatchCase] = cases
	var index: Int = 0

	for item in cases:
		body = rewrite_subscript_read_expr(item.body)

		if not same_object(body, item.body):
			rewritten = rewritten.set(index, { item | body = body })

		index += 1

	rewritten


private pure func rewrite_subscript_read_concurrent_timeout(
	timeout: Option[ParsedExpr],
) -> Option[ParsedExpr]:
	match timeout:
		Some(expr):
			rewritten = rewrite_subscript_read_expr(expr)

			if same_object(rewritten, expr):
				timeout
			else:
				Some(rewritten)
		None:
			None


private pure func rewrite_subscript_read_select_arm_kind(
	kind: ParsedSelectArmKind,
) -> ParsedSelectArmKind:
	match kind:
		ParsedSelectReceiveArm(name, channel):
			rewritten = rewrite_subscript_read_expr(channel)

			if same_object(rewritten, channel):
				kind
			else:
				ParsedSelectReceiveArm(name, rewritten)
		ParsedSelectSealedArm(channel):
			rewritten = rewrite_subscript_read_expr(channel)

			if same_object(rewritten, channel):
				kind
			else:
				ParsedSelectSealedArm(rewritten)
		ParsedSelectAfterArm(timeout):
			rewritten = rewrite_subscript_read_expr(timeout)

			if same_object(rewritten, timeout):
				kind
			else:
				ParsedSelectAfterArm(rewritten)


private pure func rewrite_subscript_read_select_arms(
	arms: List[ParsedSelectArm],
) -> List[ParsedSelectArm]:
	var rewritten: List[ParsedSelectArm] = arms
	var index: Int = 0

	for arm in arms:
		kind = rewrite_subscript_read_select_arm_kind(arm.kind)
		body = rewrite_subscript_read_expr(arm.body)

		if not same_object(kind, arm.kind) or not same_object(body, arm.body):
			rewritten = rewritten.set(
				index,
				{ arm |
					kind = kind,
					body = body
				},
			)

		index += 1

	rewritten


private pure func rewrite_subscript_read_with_error_map(
	value: Option[ParsedWithErrorMap],
) -> Option[ParsedWithErrorMap]:
	match value:
		Some(error_map):
			rewritten = rewrite_subscript_read_expr(error_map.value)

			if same_object(rewritten, error_map.value):
				value
			else:
				Some({ error_map | value = rewritten })
		None:
			value


private pure func optional_subscript_read_error_map_changed(
	original: Option[ParsedWithErrorMap],
	rewritten: Option[ParsedWithErrorMap],
) -> Bool:
	match (original, rewritten):
		(Some(before), Some(after)):
			not same_object(before.value, after.value)
		(None, None):
			False
		_:
			True


private pure func rewrite_subscript_read_with_binding(
	binding: ParsedWithBinding,
) -> ParsedWithBinding:
	value = rewrite_subscript_read_expr(binding.value)
	error_map = rewrite_subscript_read_with_error_map(binding.error_map)

	if (
		same_object(value, binding.value)
		and not optional_subscript_read_error_map_changed(binding.error_map, error_map)
	):
		binding
	else:
		{ binding |
			value = value,
			error_map = error_map
		}


private pure func rewrite_subscript_read_function_decl(
	decl: ParsedFunctionDecl,
) -> ParsedFunctionDecl:
	body = rewrite_subscript_read_optional_expr(decl.body)

	if optional_subscript_read_expr_changed(decl.body, body):
		{ decl | body = body }
	else:
		decl


private pure func rewrite_subscript_read_trait_methods(
	methods: List[ParsedTraitMethodDecl],
) -> List[ParsedTraitMethodDecl]:
	var rewritten: List[ParsedTraitMethodDecl] = methods
	var index: Int = 0

	for method in methods:
		body = rewrite_subscript_read_optional_expr(method.body)

		if optional_subscript_read_expr_changed(method.body, body):
			rewritten = rewritten.set(index, { method | body = body })

		index += 1

	rewritten


private pure func rewrite_subscript_read_impl_methods(
	methods: List[ParsedFunctionDecl],
) -> List[ParsedFunctionDecl]:
	var rewritten: List[ParsedFunctionDecl] = methods
	var index: Int = 0

	for method in methods:
		mapped = rewrite_subscript_read_function_decl(method)

		if not same_object(mapped, method):
			rewritten = rewritten.set(index, mapped)

		index += 1

	rewritten


private pure func rewrite_subscript_read_expr(expr: ParsedExpr) -> ParsedExpr:
	match expr:
		ParsedStringInterpolationPartsExpr(parts, is_multiline, span):
			rewritten = rewrite_subscript_read_interpolation_parts(parts)

			if same_object(rewritten, parts):
				expr
			else:
				ParsedStringInterpolationPartsExpr(rewritten, is_multiline, span)
		ParsedUnaryExpr(op, value, span):
			rewritten = rewrite_subscript_read_expr(value)

			if same_object(rewritten, value):
				expr
			else:
				ParsedUnaryExpr(op, rewritten, span)
		ParsedBinaryExpr(op, left, right, span):
			rewritten_left = rewrite_subscript_read_expr(left)
			rewritten_right = rewrite_subscript_read_expr(right)

			if same_object(rewritten_left, left) and same_object(rewritten_right, right):
				expr
			else:
				ParsedBinaryExpr(op, rewritten_left, rewritten_right, span)
		ParsedLogicalExpr(op, left, right, span):
			rewritten_left = rewrite_subscript_read_expr(left)
			rewritten_right = rewrite_subscript_read_expr(right)

			if same_object(rewritten_left, left) and same_object(rewritten_right, right):
				expr
			else:
				ParsedLogicalExpr(op, rewritten_left, rewritten_right, span)
		ParsedRangeExpr(start, finish, span):
			rewritten_start = rewrite_subscript_read_expr(start)
			rewritten_finish = rewrite_subscript_read_expr(finish)

			if same_object(rewritten_start, start) and same_object(rewritten_finish, finish):
				expr
			else:
				ParsedRangeExpr(rewritten_start, rewritten_finish, span)
		ParsedCallExpr(callee, args, span):
			rewritten_callee = rewrite_subscript_read_expr(callee)
			rewritten_args = rewrite_subscript_read_exprs(args)

			if same_object(rewritten_callee, callee) and same_object(rewritten_args, args):
				expr
			else:
				ParsedCallExpr(rewritten_callee, rewritten_args, span)
		ParsedFieldAccessExpr(target, field, span):
			rewritten = rewrite_subscript_read_expr(target)

			if same_object(rewritten, target):
				expr
			else:
				ParsedFieldAccessExpr(rewritten, field, span)
		ParsedSubscriptExpr(target, indices, span):
			rewrite_subscript_read_node(
				rewrite_subscript_read_expr(target),
				rewrite_subscript_read_exprs(indices),
				span,
			)
		ParsedListExpr(items, span):
			rewritten = rewrite_subscript_read_exprs(items)

			if same_object(rewritten, items):
				expr
			else:
				ParsedListExpr(rewritten, span)
		ParsedTupleExpr(items, span):
			rewritten = rewrite_subscript_read_exprs(items)

			if same_object(rewritten, items):
				expr
			else:
				ParsedTupleExpr(rewritten, span)
		ParsedRecordExpr(fields, span):
			rewritten = rewrite_subscript_read_record_fields(fields)

			if same_object(rewritten, fields):
				expr
			else:
				ParsedRecordExpr(rewritten, span)
		ParsedRecordUpdateExpr(base, fields, span):
			rewritten_base = rewrite_subscript_read_expr(base)
			rewritten_fields = rewrite_subscript_read_record_fields(fields)

			if same_object(rewritten_base, base) and same_object(rewritten_fields, fields):
				expr
			else:
				ParsedRecordUpdateExpr(rewritten_base, rewritten_fields, span)
		ParsedDictExpr(entries, span):
			rewritten = rewrite_subscript_read_dict_entries(entries)

			if same_object(rewritten, entries):
				expr
			else:
				ParsedDictExpr(rewritten, span)
		ParsedVectorExpr(items, span):
			rewritten = rewrite_subscript_read_exprs(items)

			if same_object(rewritten, items):
				expr
			else:
				ParsedVectorExpr(rewritten, span)
		ParsedOpaqueIntoExpr(type_expr, value, span):
			rewritten = rewrite_subscript_read_expr(value)

			if same_object(rewritten, value):
				expr
			else:
				ParsedOpaqueIntoExpr(type_expr, rewritten, span)
		ParsedOpaqueFromExpr(type_expr, value, span):
			rewritten = rewrite_subscript_read_expr(value)

			if same_object(rewritten, value):
				expr
			else:
				ParsedOpaqueFromExpr(type_expr, rewritten, span)
		ParsedBlockExpr(items, span):
			rewritten = rewrite_subscript_read_exprs(items)

			if same_object(rewritten, items):
				expr
			else:
				ParsedBlockExpr(rewritten, span)
		ParsedIfExpr(cond, then_expr, else_expr, span):
			rewritten_cond = rewrite_subscript_read_expr(cond)
			rewritten_then = rewrite_subscript_read_expr(then_expr)
			rewritten_else = rewrite_subscript_read_else_branch(else_expr)

			if (
				same_object(rewritten_cond, cond)
				and same_object(rewritten_then, then_expr)
				and same_object(rewritten_else, else_expr)
			):
				expr
			else:
				ParsedIfExpr(rewritten_cond, rewritten_then, rewritten_else, span)
		ParsedMatchExpr(value, cases, span):
			rewritten_value = rewrite_subscript_read_expr(value)
			rewritten_cases = rewrite_subscript_read_match_cases(cases)

			if same_object(rewritten_value, value) and same_object(rewritten_cases, cases):
				expr
			else:
				ParsedMatchExpr(rewritten_value, rewritten_cases, span)
		ParsedSelectExpr(arms, span):
			rewritten = rewrite_subscript_read_select_arms(arms)

			if same_object(rewritten, arms):
				expr
			else:
				ParsedSelectExpr(rewritten, span)
		ParsedWithExpr(binding, body, span):
			rewritten_binding = rewrite_subscript_read_with_binding(binding)
			rewritten_body = rewrite_subscript_read_expr(body)

			if same_object(rewritten_binding, binding) and same_object(rewritten_body, body):
				expr
			else:
				ParsedWithExpr(rewritten_binding, rewritten_body, span)
		ParsedDebugBlockExpr(body, span):
			rewritten = rewrite_subscript_read_expr(body)

			if same_object(rewritten, body):
				expr
			else:
				ParsedDebugBlockExpr(rewritten, span)
		ParsedLambdaExpr(is_pure, params, return_type, body, span):
			rewritten = rewrite_subscript_read_expr(body)

			if same_object(rewritten, body):
				expr
			else:
				ParsedLambdaExpr(is_pure, params, return_type, rewritten, span)
		ParsedFunctionDeclExpr(decl):
			rewritten = rewrite_subscript_read_function_decl(decl)

			if same_object(rewritten, decl):
				expr
			else:
				ParsedFunctionDeclExpr(rewritten)
		ParsedWhileExpr(cond, body, span):
			rewritten_cond = rewrite_subscript_read_expr(cond)
			rewritten_body = rewrite_subscript_read_expr(body)

			if same_object(rewritten_cond, cond) and same_object(rewritten_body, body):
				expr
			else:
				ParsedWhileExpr(rewritten_cond, rewritten_body, span)
		ParsedForExpr(binder, iterable, body, span):
			rewritten_iterable = rewrite_subscript_read_expr(iterable)
			rewritten_body = rewrite_subscript_read_expr(body)

			if same_object(rewritten_iterable, iterable) and same_object(rewritten_body, body):
				expr
			else:
				ParsedForExpr(binder, rewritten_iterable, rewritten_body, span)
		ParsedConcurrentBlockExpr(options, body, span):
			rewritten_timeout = rewrite_subscript_read_concurrent_timeout(options.timeout)
			rewritten_body = rewrite_subscript_read_expr(body)

			if (
				same_object(rewritten_timeout, options.timeout)
				and same_object(rewritten_body, body)
			):
				expr
			else:
				ParsedConcurrentBlockExpr(
					{ options | timeout = rewritten_timeout },
					rewritten_body,
					span,
				)
		ParsedConcurrentForExpr(name, iterable, options, body, span):
			rewritten_iterable = rewrite_subscript_read_expr(iterable)
			rewritten_timeout = rewrite_subscript_read_concurrent_timeout(options.timeout)
			rewritten_body = rewrite_subscript_read_expr(body)

			if (
				same_object(rewritten_iterable, iterable)
				and same_object(rewritten_timeout, options.timeout)
				and same_object(rewritten_body, body)
			):
				expr
			else:
				ParsedConcurrentForExpr(
					name,
					rewritten_iterable,
					{ options | timeout = rewritten_timeout },
					rewritten_body,
					span,
				)
		ParsedDetachExpr(body, span):
			rewritten = rewrite_subscript_read_expr(body)

			if same_object(rewritten, body):
				expr
			else:
				ParsedDetachExpr(rewritten, span)
		ParsedVarDeclExpr(name, type_expr, value, is_mutable, span):
			rewritten = rewrite_subscript_read_expr(value)

			if same_object(rewritten, value):
				expr
			else:
				ParsedVarDeclExpr(name, type_expr, rewritten, is_mutable, span)
		ParsedAssignExpr(name, value, span):
			rewritten = rewrite_subscript_read_expr(value)

			if same_object(rewritten, value):
				expr
			else:
				ParsedAssignExpr(name, rewritten, span)
		ParsedCompoundAssignExpr(name, op, value, span):
			rewritten = rewrite_subscript_read_expr(value)

			if same_object(rewritten, value):
				expr
			else:
				ParsedCompoundAssignExpr(name, op, rewritten, span)
		ParsedSubscriptAssignExpr(target, indices, value, span):
			rewritten_target = rewrite_subscript_read_expr(target)
			rewritten_indices = rewrite_subscript_read_exprs(indices)
			rewritten_value = rewrite_subscript_read_expr(value)

			if (
				same_object(rewritten_target, target)
				and same_object(rewritten_indices, indices)
				and same_object(rewritten_value, value)
			):
				expr
			else:
				ParsedSubscriptAssignExpr(
					rewritten_target,
					rewritten_indices,
					rewritten_value,
					span,
				)
		ParsedTupleDestructExpr(names, value, span):
			rewritten = rewrite_subscript_read_expr(value)

			if same_object(rewritten, value):
				expr
			else:
				ParsedTupleDestructExpr(names, rewritten, span)
		ParsedQuestionBindExpr(name, type_expr, value, span):
			rewritten = rewrite_subscript_read_expr(value)

			if same_object(rewritten, value):
				expr
			else:
				ParsedQuestionBindExpr(name, type_expr, rewritten, span)
		_:
			expr


private pure func rewrite_subscript_read_decl(decl: ParsedDecl) -> ParsedDecl:
	match decl:
		FunctionParsedDecl(function_decl):
			rewritten = rewrite_subscript_read_function_decl(function_decl)

			if same_object(rewritten, function_decl):
				decl
			else:
				FunctionParsedDecl(rewritten)
		VarParsedDecl(var_decl):
			rewritten = rewrite_subscript_read_expr(var_decl.value)

			if same_object(rewritten, var_decl.value):
				decl
			else:
				VarParsedDecl({ var_decl | value = rewritten })
		TraitParsedDecl(trait_decl):
			methods = rewrite_subscript_read_trait_methods(trait_decl.methods)

			if same_object(methods, trait_decl.methods):
				decl
			else:
				TraitParsedDecl({ trait_decl | methods = methods })
		ImplParsedDecl(impl_decl):
			methods = rewrite_subscript_read_impl_methods(impl_decl.methods)

			if same_object(methods, impl_decl.methods):
				decl
			else:
				ImplParsedDecl({ impl_decl | methods = methods })
		PrivateParsedDecl(inner, span):
			rewritten = rewrite_subscript_read_decl(inner)

			if same_object(rewritten, inner):
				decl
			else:
				PrivateParsedDecl(rewritten, span)
		_:
			decl


private pure func rewrite_subscript_read_decls(decls: List[ParsedDecl]) -> List[ParsedDecl]:
	var rewritten: List[ParsedDecl] = decls
	var index: Int = 0

	for decl in decls:
		mapped = rewrite_subscript_read_decl(decl)

		if not same_object(mapped, decl):
			rewritten = rewritten.set(index, mapped)

		index += 1

	rewritten


private pure func parse_interpolation_expr(
	table: SourceTable,
	module_name: String,
	compilation_names: NameTable,
	span: SourceLocation,
	text: String,
	source_start_offset: Int,
) -> ParsedExprOptionResult:
	source: SourceFile = source_table_source(table)
	wrapper_source: SourceFile = source_file(
		source.path,
		module_name,
		INTERPOLATION_WRAPPER_PREFIX + text + "\n",
	)
	(program, hole_names) = parse_interpolation_hole_source(
		wrapper_source,
		source_start_offset - INTERPOLATION_WRAPPER_PREFIX.length(),
		compilation_names,
	)

	match first_parse_error(program.diagnostics):
		Some(diagnostic):
			{
				value = None,
				diagnostics = [parse_error(
						source_location_span(table, span),
						"Parse error in interpolated expression: " + diagnostic.message,
					)],
				names = hole_names
			}
		None:
			match program.decls:
				[VarParsedDecl(var_decl)]:
					finalized = finalize_interpolation_expr(
						table,
						module_name,
						hole_names,
						var_decl.value,
					)
					{
						value = Some(finalized.value),
						diagnostics = finalized.diagnostics,
						names = finalized.names
					}
				_:
					{
						value = None,
						diagnostics = [parse_error(
								source_location_span(table, span),
								"Failed to parse interpolated expression: " + text,
							)],
						names = hole_names
					}


private pure func finalize_interpolation_parts(
	table: SourceTable,
	module_name: String,
	compilation_names: NameTable,
	span: SourceLocation,
	raw_parts: List[StringInterpolationRawPart],
) -> InterpolationPartsResult:
	var parts: List[ParsedStringInterpolationPart] = []
	var diagnostics: List[ParseDiagnostic] = []
	var running_names: NameTable = compilation_names

	for part in raw_parts:
		match part:
			InterpolationLiteralText(value):
				parts = parts.append(ParsedInterpolationLiteral(value))
			InterpolationExprText(text, hole_extent):
				parsed_expr = parse_interpolation_expr(
					table,
					module_name,
					running_names,
					span,
					text,
					source_location_start_offset(hole_extent) + INTERPOLATION_HOLE_OPENER_WIDTH,
				)
				running_names = parsed_expr.names
				diagnostics = diagnostics.concat(parsed_expr.diagnostics)

				match parsed_expr.value:
					Some(expr):
						parts = parts.append(ParsedInterpolationExpr(expr, hole_extent))
					None:
						void

	{
		parts = parts,
		diagnostics = diagnostics,
		names = running_names
	}


private pure func finalize_else_branch(
	table: SourceTable,
	module_name: String,
	compilation_names: NameTable,
	value: Option[ParsedElseBranch],
) -> ParsedElseBranchResult:
	match value:
		Some(branch):
			finalized = finalize_interpolation_expr(
				table,
				module_name,
				compilation_names,
				branch.body,
			)
			{
				value = Some({ branch | body = finalized.value }),
				diagnostics = finalized.diagnostics,
				names = finalized.names
			}
		None:
			{
				value = None,
				diagnostics = [],
				names = compilation_names
			}


private pure func finalize_optional_expr(
	table: SourceTable,
	module_name: String,
	compilation_names: NameTable,
	value: Option[ParsedExpr],
) -> ParsedExprOptionResult:
	match value:
		Some(expr):
			finalized = finalize_interpolation_expr(table, module_name, compilation_names, expr)
			{
				value = Some(finalized.value),
				diagnostics = finalized.diagnostics,
				names = finalized.names
			}
		None:
			{
				value = None,
				diagnostics = [],
				names = compilation_names
			}


private pure func finalize_exprs(
	table: SourceTable,
	module_name: String,
	compilation_names: NameTable,
	items: List[ParsedExpr],
) -> ParsedExprsResult:
	var values: List[ParsedExpr] = []
	var diagnostics: List[ParseDiagnostic] = []
	var running_names: NameTable = compilation_names

	for item in items:
		finalized = finalize_interpolation_expr(table, module_name, running_names, item)
		running_names = finalized.names
		values = values.append(finalized.value)

		for diagnostic in finalized.diagnostics:
			diagnostics = diagnostics.append(diagnostic)

	{
		values = values,
		diagnostics = diagnostics,
		names = running_names
	}


private pure func finalize_record_fields(
	table: SourceTable,
	module_name: String,
	compilation_names: NameTable,
	items: List[ParsedRecordExprField],
) -> RecordFieldsResult:
	var values: List[ParsedRecordExprField] = []
	var diagnostics: List[ParseDiagnostic] = []
	var running_names: NameTable = compilation_names

	for item in items:
		finalized = finalize_interpolation_expr(table, module_name, running_names, item.value)
		running_names = finalized.names
		values = values.append({ item | value = finalized.value })
		diagnostics = diagnostics.concat(finalized.diagnostics)

	{
		fields = values,
		diagnostics = diagnostics,
		names = running_names
	}


private pure func finalize_dict_entries(
	table: SourceTable,
	module_name: String,
	compilation_names: NameTable,
	items: List[ParsedDictEntry],
) -> DictEntriesResult:
	var values: List[ParsedDictEntry] = []
	var diagnostics: List[ParseDiagnostic] = []
	var running_names: NameTable = compilation_names

	for item in items:
		key = finalize_interpolation_expr(table, module_name, running_names, item.key)
		value = finalize_interpolation_expr(table, module_name, key.names, item.value)
		running_names = value.names
		values = values.append({ item |
				key = key.value,
				value = value.value
			})
		diagnostics = diagnostics.concat(key.diagnostics)
		diagnostics = diagnostics.concat(value.diagnostics)

	{
		entries = values,
		diagnostics = diagnostics,
		names = running_names
	}


private pure func finalize_match_cases(
	table: SourceTable,
	module_name: String,
	compilation_names: NameTable,
	items: List[ParsedMatchCase],
) -> MatchCasesResult:
	var values: List[ParsedMatchCase] = []
	var diagnostics: List[ParseDiagnostic] = []
	var running_names: NameTable = compilation_names

	for item in items:
		body = finalize_interpolation_expr(table, module_name, running_names, item.body)
		running_names = body.names
		values = values.append({ item | body = body.value })
		diagnostics = diagnostics.concat(body.diagnostics)

	{
		cases = values,
		diagnostics = diagnostics,
		names = running_names
	}


private pure func finalize_select_arm_kind(
	table: SourceTable,
	module_name: String,
	compilation_names: NameTable,
	kind: ParsedSelectArmKind,
) -> SelectArmKindResult:
	match kind:
		ParsedSelectReceiveArm(name, source):
			finalized = finalize_interpolation_expr(table, module_name, compilation_names, source)
			{
				kind = ParsedSelectReceiveArm(name, finalized.value),
				diagnostics = finalized.diagnostics,
				names = finalized.names
			}
		ParsedSelectSealedArm(source):
			finalized = finalize_interpolation_expr(table, module_name, compilation_names, source)
			{
				kind = ParsedSelectSealedArm(finalized.value),
				diagnostics = finalized.diagnostics,
				names = finalized.names
			}
		ParsedSelectAfterArm(source):
			finalized = finalize_interpolation_expr(table, module_name, compilation_names, source)
			{
				kind = ParsedSelectAfterArm(finalized.value),
				diagnostics = finalized.diagnostics,
				names = finalized.names
			}


private pure func finalize_select_arms(
	table: SourceTable,
	module_name: String,
	compilation_names: NameTable,
	items: List[ParsedSelectArm],
) -> SelectArmsResult:
	var values: List[ParsedSelectArm] = []
	var diagnostics: List[ParseDiagnostic] = []
	var running_names: NameTable = compilation_names

	for item in items:
		kind = finalize_select_arm_kind(table, module_name, running_names, item.kind)
		body = finalize_interpolation_expr(table, module_name, kind.names, item.body)
		running_names = body.names
		values = values.append({ item |
				kind = kind.kind,
				body = body.value
			})
		diagnostics = diagnostics.concat(kind.diagnostics)
		diagnostics = diagnostics.concat(body.diagnostics)

	{
		arms = values,
		diagnostics = diagnostics,
		names = running_names
	}


private pure func finalize_concurrent_timeout(
	table: SourceTable,
	module_name: String,
	compilation_names: NameTable,
	timeout: Option[ParsedExpr],
) -> ConcurrentTimeoutResult:
	match timeout:
		Some(expr):
			value = finalize_interpolation_expr(table, module_name, compilation_names, expr)
			{
				timeout = Some(value.value),
				diagnostics = value.diagnostics,
				names = value.names
			}
		None:
			{
				timeout = None,
				diagnostics = [],
				names = compilation_names
			}


private pure func finalize_with_error_map(
	table: SourceTable,
	module_name: String,
	compilation_names: NameTable,
	value: Option[ParsedWithErrorMap],
) -> WithErrorMapResult:
	match value:
		Some(error_map):
			finalized = finalize_interpolation_expr(
				table,
				module_name,
				compilation_names,
				error_map.value,
			)
			{
				value = Some({ error_map | value = finalized.value }),
				diagnostics = finalized.diagnostics,
				names = finalized.names
			}
		None:
			{
				value = None,
				diagnostics = [],
				names = compilation_names
			}


private pure func finalize_with_binding(
	table: SourceTable,
	module_name: String,
	compilation_names: NameTable,
	binding: ParsedWithBinding,
) -> WithBindingResult:
	value = finalize_interpolation_expr(table, module_name, compilation_names, binding.value)
	error_map = finalize_with_error_map(table, module_name, value.names, binding.error_map)
	{
		binding = { binding |
			value = value.value,
			error_map = error_map.value
		},
		diagnostics = value.diagnostics.concat(error_map.diagnostics),
		names = error_map.names
	}


private pure func finalize_function_decl(
	table: SourceTable,
	module_name: String,
	compilation_names: NameTable,
	decl: ParsedFunctionDecl,
) -> FunctionDeclResult:
	body = finalize_optional_expr(table, module_name, compilation_names, decl.body)
	{
		decl = { decl | body = body.value },
		diagnostics = body.diagnostics,
		names = body.names
	}


private pure func finalize_var_decl(
	table: SourceTable,
	module_name: String,
	compilation_names: NameTable,
	decl: ParsedVarDecl,
) -> VarDeclResult:
	value = finalize_interpolation_expr(table, module_name, compilation_names, decl.value)
	{
		decl = { decl | value = value.value },
		diagnostics = value.diagnostics,
		names = value.names
	}


private pure func finalize_trait_method(
	table: SourceTable,
	module_name: String,
	compilation_names: NameTable,
	decl: ParsedTraitMethodDecl,
) -> TraitMethodResult:
	body = finalize_optional_expr(table, module_name, compilation_names, decl.body)
	{
		method = { decl | body = body.value },
		diagnostics = body.diagnostics,
		names = body.names
	}


private pure func finalize_trait_methods(
	table: SourceTable,
	module_name: String,
	compilation_names: NameTable,
	items: List[ParsedTraitMethodDecl],
) -> TraitMethodsResult:
	var values: List[ParsedTraitMethodDecl] = []
	var diagnostics: List[ParseDiagnostic] = []
	var running_names: NameTable = compilation_names

	for item in items:
		finalized = finalize_trait_method(table, module_name, running_names, item)
		running_names = finalized.names
		values = values.append(finalized.method)
		diagnostics = diagnostics.concat(finalized.diagnostics)

	{
		methods = values,
		diagnostics = diagnostics,
		names = running_names
	}


private pure func finalize_function_decls(
	table: SourceTable,
	module_name: String,
	compilation_names: NameTable,
	items: List[ParsedFunctionDecl],
) -> FunctionDeclsResult:
	var values: List[ParsedFunctionDecl] = []
	var diagnostics: List[ParseDiagnostic] = []
	var running_names: NameTable = compilation_names

	for item in items:
		finalized = finalize_function_decl(table, module_name, running_names, item)
		running_names = finalized.names
		values = values.append(finalized.decl)
		diagnostics = diagnostics.concat(finalized.diagnostics)

	{
		functions = values,
		diagnostics = diagnostics,
		names = running_names
	}


---
Binary expressions commonly form deep left-associated spines in generated
source. Keep recursive binary children inside this small helper instead of
re-entering the exhaustive dispatcher, whose generated C frame contains the
temporaries for every ParsedExpr variant. Logical chains use the explicit
frame machine below.
---
private pure func finalize_binary_spine_operand(
	table: SourceTable,
	module_name: String,
	compilation_names: NameTable,
	expr: ParsedExpr,
) -> ParsedExprResult:
	match expr:
		ParsedBinaryExpr(op, left, right, span):
			finalize_binary_interpolation_expr(
				table,
				module_name,
				compilation_names,
				op,
				left,
				right,
				span,
			)
		_:
			finalize_interpolation_expr(table, module_name, compilation_names, expr)


private pure func finalize_binary_interpolation_expr(
	table: SourceTable,
	module_name: String,
	compilation_names: NameTable,
	op: ParsedBinaryOp,
	left: ParsedExpr,
	right: ParsedExpr,
	span: SourceLocation,
) -> ParsedExprResult:
	left_result = finalize_binary_spine_operand(table, module_name, compilation_names, left)
	right_result = finalize_binary_spine_operand(table, module_name, left_result.names, right)
	{
		value = ParsedBinaryExpr(op, left_result.value, right_result.value, span),
		diagnostics = left_result.diagnostics.concat(right_result.diagnostics),
		names = right_result.names
	}


private pure func finalize_logical_expr(
	table: SourceTable,
	module_name: String,
	compilation_names: NameTable,
	expr: ParsedExpr,
) -> ParsedExprResult:
	-- Source logical chains are left-associated. Traverse this common generated
	-- shape explicitly because the full expression matcher has a large -O0 C
	-- frame and cannot recurse safely through thousands of terms.
	--
	-- The name table is threaded in visit order: each operand is finalized with
	-- the table its predecessor returned (`finalized.names` below), and the
	-- last operand's table is the result's.
	var frames: ParsedLogicalFinalizeFrameStack = ParsedLogicalFinalizeNoFrame
	var action: ParsedLogicalFinalizeAction = ParsedLogicalFinalizeVisitExpr(expr)
	var running_names: NameTable = compilation_names
	-- Placeholder until the loop breaks with the real result; it must not hold
	-- a second reference to the accumulator, or an appending hole would copy it.
	var result: ParsedExprResult = {
		value = expr,
		diagnostics = [],
		names = EMPTY_NAME_TABLE
	}

	while True:
		match action:
			ParsedLogicalFinalizeVisitExpr(current):
				match current:
					ParsedLogicalExpr(op, left, right, span):
						frames = ParsedLogicalFinalizeMoreFrames(
							ParsedLogicalFinalizeVisitRightFrame(op, right, span),
							frames,
						)
						action = ParsedLogicalFinalizeVisitExpr(left)
					_:
						leaf = finalize_interpolation_expr(
							table,
							module_name,
							running_names,
							current,
						)
						running_names = leaf.names
						action = ParsedLogicalFinalizeRebuildExpr(leaf)
			ParsedLogicalFinalizeRebuildExpr(finalized):
				match frames:
					ParsedLogicalFinalizeNoFrame:
						result = finalized
						break
					ParsedLogicalFinalizeMoreFrames(frame, remaining):
						frames = remaining

						match frame:
							ParsedLogicalFinalizeVisitRightFrame(op, right, span):
								frames = ParsedLogicalFinalizeMoreFrames(
									ParsedLogicalFinalizeRebuildParentFrame(op, finalized, span),
									frames,
								)
								action = ParsedLogicalFinalizeVisitExpr(right)
							ParsedLogicalFinalizeRebuildParentFrame(op, left, span):
								action = ParsedLogicalFinalizeRebuildExpr({
									value = ParsedLogicalExpr(
										op,
										left.value,
										finalized.value,
										span,
									),
									diagnostics = left.diagnostics.concat(finalized.diagnostics),
									names = finalized.names,
								})

	result


private pure func finalize_interpolation_expr(
	table: SourceTable,
	module_name: String,
	compilation_names: NameTable,
	expr: ParsedExpr,
) -> ParsedExprResult:
	match expr:
		ParsedStringInterpolationExpr(value, is_multiline, span):
			match split_interpolated_string(table, span, value):
				Ok(raw_parts):
					parts = finalize_interpolation_parts(
						table,
						module_name,
						compilation_names,
						span,
						raw_parts,
					)

					if parts.diagnostics.length() == 0:
						{
							value = ParsedStringInterpolationPartsExpr(
								parts.parts,
								is_multiline,
								span,
							),
							diagnostics = [],
							names = parts.names
						}
					else:
						{
							value = expr,
							diagnostics = parts.diagnostics,
							names = parts.names
						}
				Err(diagnostic):
					{
						value = expr,
						diagnostics = [diagnostic],
						names = compilation_names
					}
		ParsedUnaryExpr(op, value, span):
			finalized = finalize_interpolation_expr(table, module_name, compilation_names, value)
			{
				value = ParsedUnaryExpr(op, finalized.value, span),
				diagnostics = finalized.diagnostics,
				names = finalized.names
			}
		ParsedBinaryExpr(op, left, right, span):
			finalize_binary_interpolation_expr(
				table,
				module_name,
				compilation_names,
				op,
				left,
				right,
				span,
			)
		ParsedLogicalExpr(op, left, right, span):
			finalize_logical_expr(table, module_name, compilation_names, expr)
		ParsedRangeExpr(start, finish, span):
			start_result = finalize_interpolation_expr(table, module_name, compilation_names, start)
			finish_result = finalize_interpolation_expr(
				table,
				module_name,
				start_result.names,
				finish,
			)
			{
				value = ParsedRangeExpr(start_result.value, finish_result.value, span),
				diagnostics = start_result.diagnostics.concat(finish_result.diagnostics),
				names = finish_result.names
			}
		ParsedCallExpr(callee, args, span):
			callee_result = finalize_interpolation_expr(
				table,
				module_name,
				compilation_names,
				callee,
			)
			args_result = finalize_exprs(table, module_name, callee_result.names, args)
			{
				value = ParsedCallExpr(callee_result.value, args_result.values, span),
				diagnostics = callee_result.diagnostics.concat(args_result.diagnostics),
				names = args_result.names
			}
		ParsedFieldAccessExpr(target, field, span):
			finalized = finalize_interpolation_expr(table, module_name, compilation_names, target)
			{
				value = ParsedFieldAccessExpr(finalized.value, field, span),
				diagnostics = finalized.diagnostics,
				names = finalized.names
			}
		ParsedSubscriptExpr(target, indices, span):
			target_result = finalize_interpolation_expr(
				table,
				module_name,
				compilation_names,
				target,
			)
			indices_result = finalize_exprs(table, module_name, target_result.names, indices)
			{
				value = ParsedSubscriptExpr(target_result.value, indices_result.values, span),
				diagnostics = target_result.diagnostics.concat(indices_result.diagnostics),
				names = indices_result.names
			}
		ParsedListExpr(items, span):
			result = finalize_exprs(table, module_name, compilation_names, items)
			{
				value = ParsedListExpr(result.values, span),
				diagnostics = result.diagnostics,
				names = result.names
			}
		ParsedTupleExpr(items, span):
			result = finalize_exprs(table, module_name, compilation_names, items)
			{
				value = ParsedTupleExpr(result.values, span),
				diagnostics = result.diagnostics,
				names = result.names
			}
		ParsedRecordExpr(fields, span):
			result = finalize_record_fields(table, module_name, compilation_names, fields)
			{
				value = ParsedRecordExpr(result.fields, span),
				diagnostics = result.diagnostics,
				names = result.names
			}
		ParsedRecordUpdateExpr(base, fields, span):
			base_result = finalize_interpolation_expr(table, module_name, compilation_names, base)
			fields_result = finalize_record_fields(table, module_name, base_result.names, fields)
			{
				value = ParsedRecordUpdateExpr(base_result.value, fields_result.fields, span),
				diagnostics = base_result.diagnostics.concat(fields_result.diagnostics),
				names = fields_result.names
			}
		ParsedDictExpr(entries, span):
			result = finalize_dict_entries(table, module_name, compilation_names, entries)
			{
				value = ParsedDictExpr(result.entries, span),
				diagnostics = result.diagnostics,
				names = result.names
			}
		ParsedVectorExpr(items, span):
			result = finalize_exprs(table, module_name, compilation_names, items)
			{
				value = ParsedVectorExpr(result.values, span),
				diagnostics = result.diagnostics,
				names = result.names
			}
		ParsedOpaqueIntoExpr(type_expr, value, span):
			result = finalize_interpolation_expr(table, module_name, compilation_names, value)
			{
				value = ParsedOpaqueIntoExpr(type_expr, result.value, span),
				diagnostics = result.diagnostics,
				names = result.names
			}
		ParsedOpaqueFromExpr(type_expr, value, span):
			result = finalize_interpolation_expr(table, module_name, compilation_names, value)
			{
				value = ParsedOpaqueFromExpr(type_expr, result.value, span),
				diagnostics = result.diagnostics,
				names = result.names
			}
		ParsedBlockExpr(items, span):
			result = finalize_exprs(table, module_name, compilation_names, items)
			{
				value = ParsedBlockExpr(result.values, span),
				diagnostics = result.diagnostics,
				names = result.names
			}
		ParsedIfExpr(cond, then_expr, else_expr, span):
			cond_result = finalize_interpolation_expr(table, module_name, compilation_names, cond)
			then_result = finalize_interpolation_expr(
				table,
				module_name,
				cond_result.names,
				then_expr,
			)
			else_result = finalize_else_branch(table, module_name, then_result.names, else_expr)
			{
				value = ParsedIfExpr(cond_result.value, then_result.value, else_result.value, span),
				diagnostics = cond_result.diagnostics
					.concat(then_result.diagnostics)
					.concat(else_result.diagnostics),
				names = else_result.names
			}
		ParsedMatchExpr(value, cases, span):
			value_result = finalize_interpolation_expr(table, module_name, compilation_names, value)
			cases_result = finalize_match_cases(table, module_name, value_result.names, cases)
			{
				value = ParsedMatchExpr(value_result.value, cases_result.cases, span),
				diagnostics = value_result.diagnostics.concat(cases_result.diagnostics),
				names = cases_result.names
			}
		ParsedSelectExpr(arms, span):
			result = finalize_select_arms(table, module_name, compilation_names, arms)
			{
				value = ParsedSelectExpr(result.arms, span),
				diagnostics = result.diagnostics,
				names = result.names
			}
		ParsedWithExpr(binding, body, span):
			binding_result = finalize_with_binding(table, module_name, compilation_names, binding)
			body_result = finalize_interpolation_expr(
				table,
				module_name,
				binding_result.names,
				body,
			)
			{
				value = ParsedWithExpr(binding_result.binding, body_result.value, span),
				diagnostics = binding_result.diagnostics.concat(body_result.diagnostics),
				names = body_result.names
			}
		ParsedDebugBlockExpr(body, span):
			result = finalize_interpolation_expr(table, module_name, compilation_names, body)
			{
				value = ParsedDebugBlockExpr(result.value, span),
				diagnostics = result.diagnostics,
				names = result.names
			}
		ParsedLambdaExpr(is_pure, params, return_type, body, span):
			result = finalize_interpolation_expr(table, module_name, compilation_names, body)
			{
				value = ParsedLambdaExpr(is_pure, params, return_type, result.value, span),
				diagnostics = result.diagnostics,
				names = result.names
			}
		ParsedFunctionDeclExpr(decl):
			result = finalize_function_decl(table, module_name, compilation_names, decl)
			{
				value = ParsedFunctionDeclExpr(result.decl),
				diagnostics = result.diagnostics,
				names = result.names
			}
		ParsedWhileExpr(cond, body, span):
			cond_result = finalize_interpolation_expr(table, module_name, compilation_names, cond)
			body_result = finalize_interpolation_expr(table, module_name, cond_result.names, body)
			{
				value = ParsedWhileExpr(cond_result.value, body_result.value, span),
				diagnostics = cond_result.diagnostics.concat(body_result.diagnostics),
				names = body_result.names
			}
		ParsedForExpr(binder, iterable, body, span):
			iter_result = finalize_interpolation_expr(
				table,
				module_name,
				compilation_names,
				iterable,
			)
			body_result = finalize_interpolation_expr(table, module_name, iter_result.names, body)
			{
				value = ParsedForExpr(binder, iter_result.value, body_result.value, span),
				diagnostics = iter_result.diagnostics.concat(body_result.diagnostics),
				names = body_result.names
			}
		ParsedConcurrentBlockExpr(options, body, span):
			params_result = finalize_concurrent_timeout(
				table,
				module_name,
				compilation_names,
				options.timeout,
			)
			body_result = finalize_interpolation_expr(table, module_name, params_result.names, body)
			{
				value = ParsedConcurrentBlockExpr(
					{ options | timeout = params_result.timeout },
					body_result.value,
					span,
				),
				diagnostics = params_result.diagnostics.concat(body_result.diagnostics),
				names = body_result.names
			}
		ParsedConcurrentForExpr(name, iterable, options, body, span):
			iter_result = finalize_interpolation_expr(
				table,
				module_name,
				compilation_names,
				iterable,
			)
			params_result = finalize_concurrent_timeout(
				table,
				module_name,
				iter_result.names,
				options.timeout,
			)
			body_result = finalize_interpolation_expr(table, module_name, params_result.names, body)
			{
				value = ParsedConcurrentForExpr(
					name,
					iter_result.value,
					{ options | timeout = params_result.timeout },
					body_result.value,
					span,
				),
				diagnostics = iter_result.diagnostics
					.concat(params_result.diagnostics)
					.concat(body_result.diagnostics),
				names = body_result.names
			}
		ParsedDetachExpr(body, span):
			result = finalize_interpolation_expr(table, module_name, compilation_names, body)
			{
				value = ParsedDetachExpr(result.value, span),
				diagnostics = result.diagnostics,
				names = result.names
			}
		ParsedVarDeclExpr(name, type_expr, value, is_mutable, span):
			result = finalize_interpolation_expr(table, module_name, compilation_names, value)
			{
				value = ParsedVarDeclExpr(name, type_expr, result.value, is_mutable, span),
				diagnostics = result.diagnostics,
				names = result.names
			}
		ParsedAssignExpr(name, value, span):
			result = finalize_interpolation_expr(table, module_name, compilation_names, value)
			{
				value = ParsedAssignExpr(name, result.value, span),
				diagnostics = result.diagnostics,
				names = result.names
			}
		ParsedCompoundAssignExpr(name, op, value, span):
			result = finalize_interpolation_expr(table, module_name, compilation_names, value)
			{
				value = ParsedCompoundAssignExpr(name, op, result.value, span),
				diagnostics = result.diagnostics,
				names = result.names
			}
		ParsedSubscriptAssignExpr(target, indices, value, span):
			target_result = finalize_interpolation_expr(
				table,
				module_name,
				compilation_names,
				target,
			)
			indices_result = finalize_exprs(table, module_name, target_result.names, indices)
			value_result = finalize_interpolation_expr(
				table,
				module_name,
				indices_result.names,
				value,
			)
			{
				value = ParsedSubscriptAssignExpr(
					target_result.value,
					indices_result.values,
					value_result.value,
					span,
				),
				diagnostics = target_result.diagnostics
					.concat(indices_result.diagnostics)
					.concat(value_result.diagnostics),
				names = value_result.names
			}
		ParsedTupleDestructExpr(names, value, span):
			result = finalize_interpolation_expr(table, module_name, compilation_names, value)
			{
				value = ParsedTupleDestructExpr(names, result.value, span),
				diagnostics = result.diagnostics,
				names = result.names
			}
		ParsedQuestionBindExpr(name, type_expr, value, span):
			result = finalize_interpolation_expr(table, module_name, compilation_names, value)
			{
				value = ParsedQuestionBindExpr(name, type_expr, result.value, span),
				diagnostics = result.diagnostics,
				names = result.names
			}
		_:
			{
				value = expr,
				diagnostics = [],
				names = compilation_names
			}


private pure func finalize_decl(
	table: SourceTable,
	module_name: String,
	compilation_names: NameTable,
	decl: ParsedDecl,
) -> DeclResult:
	match decl:
		FunctionParsedDecl(function_decl):
			result = finalize_function_decl(table, module_name, compilation_names, function_decl)
			{
				decl = FunctionParsedDecl(result.decl),
				diagnostics = result.diagnostics,
				names = result.names
			}
		VarParsedDecl(var_decl):
			result = finalize_var_decl(table, module_name, compilation_names, var_decl)
			{
				decl = VarParsedDecl(result.decl),
				diagnostics = result.diagnostics,
				names = result.names
			}
		TraitParsedDecl(trait_decl):
			methods = finalize_trait_methods(
				table,
				module_name,
				compilation_names,
				trait_decl.methods,
			)
			{
				decl = TraitParsedDecl({ trait_decl | methods = methods.methods }),
				diagnostics = methods.diagnostics,
				names = methods.names
			}
		ImplParsedDecl(impl_decl):
			methods = finalize_function_decls(
				table,
				module_name,
				compilation_names,
				impl_decl.methods,
			)
			{
				decl = ImplParsedDecl({ impl_decl | methods = methods.functions }),
				diagnostics = methods.diagnostics,
				names = methods.names
			}
		PrivateParsedDecl(inner, span):
			result = finalize_decl(table, module_name, compilation_names, inner)
			{
				decl = PrivateParsedDecl(result.decl, span),
				diagnostics = result.diagnostics,
				names = result.names
			}
		_:
			{
				decl = decl,
				diagnostics = [],
				names = compilation_names
			}


private pure func finalize_decls(
	table: SourceTable,
	module_name: String,
	compilation_names: NameTable,
	decls: List[ParsedDecl],
) -> DeclsResult:
	var values: List[ParsedDecl] = []
	var diagnostics: List[ParseDiagnostic] = []
	var running_names: NameTable = compilation_names

	for decl in decls:
		result = finalize_decl(table, module_name, running_names, decl)
		running_names = result.names
		values = values.append(result.decl)
		diagnostics = diagnostics.concat(result.diagnostics)

	{
		decls = values,
		diagnostics = diagnostics,
		names = running_names
	}


private record FinalizedInterpolationProgram {
	program: ParsedProgram,
	names: NameTable
}


private pure func finalize_interpolation_program_with_table(
	program: ParsedProgram,
	table: SourceTable,
	compilation_names: NameTable,
) -> FinalizedInterpolationProgram:
	result = finalize_decls(table, program.source.module_name, compilation_names, program.decls)
	{
		program = {
			source = program.source,
			module_doc = program.module_doc,
			decls = result.decls,
			diagnostics = program.diagnostics.concat(result.diagnostics)
		},
		names = result.names
	}


---
Interpolation-only finalization against the compilation name table. Each
interpolation hole is parsed with the table so far and can introduce
spellings the compilation has not seen; the returned table carries them, and
the caller must continue from it (discovery folds it back into its
accumulator) so hole identifiers' `NameId`s stay unique compilation-wide.
---
pure func finalize_interpolation_program_with_names(
	program: ParsedProgram,
	compilation_names: NameTable,
) -> (ParsedProgram, NameTable):
	finalized = finalize_interpolation_program_with_table(
		program,
		unindexed_source_table_for_file(program.source),
		compilation_names,
	)
	(finalized.program, finalized.names)


---
Single-file interpolation finalization for callers (formatter, tests) that
parsed with `parse_compiler_source` and keep no compilation table: the file's
own table is rebuilt by re-lexing it from `SYNTHESIZED_NAME_TABLE`, which is
exactly the table that parse used, so hole ids continue above it without
colliding with the file's identifiers.
---
pure func finalize_interpolation_program(program: ParsedProgram) -> ParsedProgram:
	(finalized, _) = finalize_interpolation_program_with_names(
		program,
		single_file_name_table(program),
	)
	finalized


---
The table `parse_compiler_source(program.source)` interned into, for a
program that was parsed that way.
---
private pure func single_file_name_table(program: ParsedProgram) -> NameTable:
	lex(program.source, SYNTHESIZED_NAME_TABLE).names


private pure func finalize_nested_functions_program_with_table(
	program: ParsedProgram,
	table: SourceTable,
) -> ParsedProgram:
	result = hoist_nested_decls(table, program.decls)
	{
		source = program.source,
		module_doc = program.module_doc,
		decls = result.decls,
		diagnostics = program.diagnostics.concat(result.diagnostics)
	}


pure func finalize_nested_functions_program(program: ParsedProgram) -> ParsedProgram:
	finalize_nested_functions_program_with_table(
		program,
		unindexed_source_table_for_file(program.source),
	)


pure func finalize_typecheck_source_program(program: ParsedProgram) -> ParsedProgram:
	(finalized, _) = finalize_typecheck_source_program_with_names(
		program,
		single_file_name_table(program),
	)
	finalized


pure func finalize_typecheck_source_program_with_names(
	program: ParsedProgram,
	compilation_names: NameTable,
) -> (ParsedProgram, NameTable):
	table: SourceTable = unindexed_source_table_for_file(program.source)
	interpolated = finalize_interpolation_program_with_table(program, table, compilation_names)
	nested = finalize_nested_functions_program_with_table(interpolated.program, table)
	({ nested | decls = rewrite_subscript_read_decls(nested.decls) }, interpolated.names)


pure func finalized_typecheck_program(program: ParsedProgram) -> FinalizedTypecheckProgram:
	(finalized, _) = finalized_typecheck_program_with_single_file_names(program)
	finalized


---
Finalizes a program that was parsed with `parse_compiler_source` and returns
the table its identifiers index: `SYNTHESIZED_NAME_TABLE` plus the file's own
spellings plus the ones its interpolation holes introduced. A caller that hands
the program to discovery as a finalized root keeps this table with it, so
discovery adopts it instead of parsing the root's source a second time to
re-derive it.
---
pure func finalized_typecheck_program_with_single_file_names(
	program: ParsedProgram,
) -> (FinalizedTypecheckProgram, NameTable):
	finalized_typecheck_program_with_names(program, single_file_name_table(program))


---
Finalizes one parsed file for typechecking and returns the compilation name
table extended with the spellings its interpolation holes introduced.
---
pure func finalized_typecheck_program_with_names(
	program: ParsedProgram,
	compilation_names: NameTable,
) -> (FinalizedTypecheckProgram, NameTable):
	(finalized, names) = finalize_typecheck_source_program_with_names(program, compilation_names)
	(into_opaque FinalizedTypecheckProgram(finalized), names)


pure func finalized_typecheck_program_ast(program: FinalizedTypecheckProgram) -> ParsedProgram:
	from_opaque FinalizedTypecheckProgram(program)


private pure func resolved_module_for_finalized_import(
	from_path: String,
	from_module: String,
	rewrites: List[FinalizedImportPathRewrite],
	import_path: String,
) -> String:
	var result: String = import_path

	for rewrite in rewrites:
		if (
			rewrite.from_path == from_path
			and rewrite.from_module == from_module
			and rewrite.import_path == import_path
		):
			result = rewrite.resolved_module
			break

	result


private pure func rewrite_finalized_import_decl_path(
	from_path: String,
	from_module: String,
	rewrites: List[FinalizedImportPathRewrite],
	import_decl: ParsedImportDecl,
) -> ParsedImportDecl:
	{ import_decl |
		module_path = resolved_module_for_finalized_import(
			from_path,
			from_module,
			rewrites,
			import_decl.module_path,
		)
	}


private pure func rewrite_finalized_decl_import_paths(
	from_path: String,
	from_module: String,
	rewrites: List[FinalizedImportPathRewrite],
	decl: ParsedDecl,
) -> ParsedDecl:
	match decl:
		ImportBlockParsedDecl(imports, span):
			ImportBlockParsedDecl(
				imports.map(
					func(
						import_decl,
					): rewrite_finalized_import_decl_path(
						from_path,
						from_module,
						rewrites,
						import_decl,
					),
				),
				span,
			)
		PrivateParsedDecl(inner, span):
			PrivateParsedDecl(
				rewrite_finalized_decl_import_paths(from_path, from_module, rewrites, inner),
				span,
			)
		_:
			decl


---
Import resolution changes names only. Keeping this transformation on the
opaque type prevents module preparation from discarding the finalization
proof or rerunning parser-owned normalization.
---
pure func finalized_typecheck_program_rewrite_import_paths(
	program: FinalizedTypecheckProgram,
	from_path: String,
	from_module: String,
	rewrites: List[FinalizedImportPathRewrite],
) -> FinalizedTypecheckProgram:
	parsed_program: ParsedProgram = from_opaque FinalizedTypecheckProgram(program)
	rewritten_program = { parsed_program |
		decls = parsed_program.decls.map(
			func(
				decl,
			): rewrite_finalized_decl_import_paths(from_path, from_module, rewrites, decl),
		)
	}
	into_opaque FinalizedTypecheckProgram(rewritten_program)


pure func finalized_typecheck_program_matches_source(
	program: FinalizedTypecheckProgram,
	path: String,
	module_name: String,
	text: String,
) -> Bool:
	source = finalized_typecheck_program_ast(program).source
	source.path == path and source.module_name == module_name and source.text == text
