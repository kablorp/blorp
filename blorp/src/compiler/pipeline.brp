-- Authoritative orchestration for the whole compiler pipeline.
--
-- Today this module owns source discovery across parsing and module-graph
-- construction, then orchestration from the typed frontend through Core and
-- backend emission. Source providers and presentation remain adapter-owned.
-- As earlier phases are made explicit, their sequencing should move here so
-- stage modules remain transformations rather than callers of other stages.
import:
	../lib/build_artifact:
		BuildArtifact,
		BuildArtifactConfiguration,
		BuildArtifactError(InvalidForeignLinkArguments),
		CArtifact,
	../lib/source: SourceFile
	frontend_output: typed_program_summary
	frontend_request: FrontendCompilationGraph
	path: dirname
	stage_02_lex/parse_diagnostic: parse_diagnostic_to_string
	stage_03_parse/language_parser: parse_compiler_source
	stage_03_parse/parsed_ast: ParsedProgram
	stage_03_parse/source_ast_finalize: finalized_typecheck_program, finalized_typecheck_program_ast
	stage_04_modules/frontend_graph:
		FrontendGraph,
		FrontendImportEdge,
		FrontendImportResolution(FrontendResolvedImport, FrontendUnresolvedImport),
		FrontendModule,
		frontend_graph_dependency_modules,
		frontend_graph_module_ids,
		frontend_graph_module_table,
		frontend_graph_modules,
		frontend_graph_root_ids,
		frontend_graph_root_modules,
	stage_04_modules/frontend_graph_service:
		FrontendDiscoveryError(
			FrontendDiscoveryGraphFailed,
			FrontendDiscoveryIdentityConflict,
			FrontendDiscoveryProviderFailed,
		),
		FrontendSourceCandidate,
		FrontendSourceInput(FinalizedFrontendSource, RawFrontendSource),
		FrontendSourceLocation,
		FrontendSourceResolution(FrontendSourceResolved, FrontendSourceUnresolved),
		frontend_source_location,
		validated_frontend_graph_for_modules,
	stage_04_modules/loaded_module:
		ResolvedModuleIdentity,
		resolved_module_identities_equal,
		resolved_module_identity_storage_key,
	stage_04_modules/module_surface: module_surface_for_program
	stage_04_modules/module_table: ModuleId, ModuleTable, module_table_canonical_path
	stage_06_typecheck/bridge:
		TypecheckGraphRequest,
		TypecheckedGraph,
		TypecheckedModule,
		typecheck_frontend_graph_ids,
		typecheck_graph,
		typechecked_module_name,
		typechecked_module_path,
		typechecked_module_program_with_ctfe_replacements,
	stage_06_typecheck/decl: TypedDecl(TypedForeignFunctionDecl, TypedPrivateDecl), TypedProgram
	stage_06_typecheck/frontend_graph_typecheck:
		FrontendTypecheckRequestError,
		typecheck_frontend_graph_direct,
		typecheck_request_for_frontend_module,
	stage_06_typecheck/graph/definition_index:
		DefinitionTable,
		definition_id_runtime_value,
		definition_table_module_table,
	stage_06_typecheck/modules/import_binding:
		ImportBinding(
			GraphQualifiedModuleBinding,
			GraphSelectiveDefinitionBinding,
			GraphSelectiveTraitMethodBinding,
			StandaloneQualifiedModuleBinding,
			StandaloneSelectiveDefinitionBinding,
		),
	stage_07_ctfe/globals: CtfeGlobalReplacements
	stage_08_core_lower/graph_prepare:
		CoreGraphModules,
		CoreGraphUnit,
		core_graph_modules,
		core_graph_prepare_error_to_string,
		prepare_core_graph_with_ctfe_replacements,
	stage_09_core/early_pipeline:
		CoreEarlyPipelineConfiguration,
		CoreEarlyPipelineExecution(
			CoreEarlyPipelineCompleted,
			CoreEarlyPipelineFailed,
			CoreEarlyPipelineStopped,
		),
		CoreEarlyPipelineInput,
		CoreEarlyPipelineObservation,
		CoreEarlyPipelineOutput,
		CoreEarlyPipelineStage,
		finish_early_core_pipeline_after_projection,
		run_early_core_pipeline_to_runtime_projection,
	stage_09_core/ir:
		CoreDecl(FunctionDecl),
		CoreFunctionKind(ProgramEntrypointFunction),
		CoreProgram,
		core_program_to_json,
	stage_09_core/pass_runner:
