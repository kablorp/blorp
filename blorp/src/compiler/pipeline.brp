private record DiscoveredFrontendSource {
	candidate: FrontendSourceCandidate,
	module: FrontendModule
}


private pure func discover_frontend_source(
	candidate: FrontendSourceCandidate,
) -> DiscoveredFrontendSource:
	program = finalized_typecheck_program(parse_compiler_source(candidate.source))

	{
		candidate = candidate,
		module = {
			identity = candidate.identity,
			program = program,
			surface = module_surface_for_program(finalized_typecheck_program_ast(program))
		}
	}


private pure func same_candidate_source(
	left: FrontendSourceCandidate,
	right: FrontendSourceCandidate,
) -> Bool:
	(
		left.source.path == right.source.path
		and left.source.module_name == right.source.module_name
		and left.source.text == right.source.text
	)


private pure func discovered_source_index(
	discovered: List[DiscoveredFrontendSource],
) -> Dict[String, DiscoveredFrontendSource]:
	var index: Dict[String, DiscoveredFrontendSource] = {}

	for source in discovered:
		key = resolved_module_identity_storage_key(source.candidate.identity)

		if not index.contains(key):
			index = index.set(key, source)

	index


-- The source provider owns effects and package policy. The compiler pipeline
-- owns the deterministic Stage 03/04 walk, exact edge construction, cycle
-- termination, and final graph validation shared by every compiler client.
func frontend_graph_discover(
	roots: List[FrontendSourceCandidate],
	seed_modules: List[FrontendSourceCandidate],
	resolve: (FrontendSourceCandidate, String) -> Result[FrontendSourceResolution, String],
) -> Result[FrontendGraph, FrontendDiscoveryError]:
	var discovered = roots
		.concat(seed_modules)
		.map(discover_frontend_source)
	var discovered_by_identity = discovered_source_index(discovered)
	var pending = discovered
	var edges: List[FrontendImportEdge] = []
	var error: Option[FrontendDiscoveryError] = None

	while pending.length() > 0 and error.is_none():
		match pending:
			[]:
				void
			[discovered_importer, ...remaining]:
				pending = remaining
				importer = discovered_importer.candidate

				for requested_path in discovered_importer.module.surface.import_paths:
					if error.is_none():
						match resolve(importer, requested_path):
							Err(message):
								error = Some(
									FrontendDiscoveryProviderFailed(
										importer.identity,
										requested_path,
										message,
									),
								)
							Ok(FrontendSourceUnresolved):
								edges = edges.append({
									importer = importer.identity,
									requested_path = requested_path,
									resolution = FrontendUnresolvedImport,
								})
							Ok(FrontendSourceResolved(target)):
								edges = edges.append({
									importer = importer.identity,
									requested_path = requested_path,
									resolution = FrontendResolvedImport(target.identity),
								})

								target_key = resolved_module_identity_storage_key(target.identity)

								match discovered_by_identity.get(target_key):
									None:
										discovered_target = discover_frontend_source(target)
										discovered = discovered.append(discovered_target)
										discovered_by_identity = discovered_by_identity.set(
											target_key,
											discovered_target,
										)
										pending = pending.append(discovered_target)
									Some(existing):
										if not same_candidate_source(existing.candidate, target):
											error = Some(
												FrontendDiscoveryIdentityConflict(
													existing.candidate,
													target,
												),
											)

	match error:
		Some(found):
			Err(found)
		None:
			modules = discovered.map(func(source): source.module)
			root_identities = roots.map(func(root): root.identity)

			match validated_frontend_graph_for_modules(modules, root_identities, edges):
				Ok(graph):
					Ok(graph)
				Err(errors):
					Err(FrontendDiscoveryGraphFailed(errors))


record CoreCompilation {
	target_path: String,
	target_module_name: String,
	program: CoreProgram,
	check_invariants: Bool
}


enum CompilerPhase:
	TypedFrontendPhase
	CoreLoweringPhase
	EarlyCorePhase
	RuntimeProjectionPhase
	LateCorePhase
	BackendEmissionPhase
	ArtifactConstructionPhase


enum CompilerPhaseTerminalState:
	CompilerPhaseFailed
	CompilerPhaseStopped


pure func compiler_phase_label(phase: CompilerPhase) -> String:
	match phase:
		TypedFrontendPhase:
			"typed_frontend"
		CoreLoweringPhase:
			"core_lowering"
		EarlyCorePhase:
			"early_core"
		RuntimeProjectionPhase:
			"runtime_projection"
		LateCorePhase:
			"late_core"
		BackendEmissionPhase:
			"backend_emission"
		ArtifactConstructionPhase:
			"artifact_construction"


pure func compiler_phase_start_checkpoint_label(phase: CompilerPhase) -> String:
	"${compiler_phase_label(phase)}_start"


pure func compiler_phase_complete_checkpoint_label(phase: CompilerPhase) -> String:
	"${compiler_phase_label(phase)}_complete"


pure func compiler_phase_terminal_checkpoint_label(
	phase: CompilerPhase,
	state: CompilerPhaseTerminalState,
) -> String:
	suffix: String = match state:
		CompilerPhaseFailed:
			"failed"
		CompilerPhaseStopped:
			"stopped"

	"${compiler_phase_label(phase)}_${suffix}"


-- This manifests cross-stage ownership without duplicating the pass list owned
-- by stage_09_core/pipeline.brp.
COMPILER_PHASE_ORDER: List[CompilerPhase] = [
	TypedFrontendPhase,
	CoreLoweringPhase,
	EarlyCorePhase,
	RuntimeProjectionPhase,
	LateCorePhase,
	BackendEmissionPhase,
	ArtifactConstructionPhase,
]


record CoreObservation {
	stage_name: String,
	rendered: String
}


private record TypedFrontendCompilationRep {
	typechecked: TypecheckedGraph,
	policy: CoreCompilePolicy,
	typed_summary: Option[String],
	require_main: Bool,
	check_invariants: Bool,
	early_observations: List[CoreEarlyPipelineStage],
	early_stop: Option[CoreEarlyPipelineStage]
}


opaque type TypedFrontendCompilation = TypedFrontendCompilationRep


private record LoweredCoreCompilationRep {
	target_path: String,
	target_module_name: String,
	target_import_bindings: List[CoreResolveImportBinding],
	module_imports: List[CoreResolveModuleImports],
	include_dirs: List[String],
	typed_summary: Option[String],
	require_main: Bool,
	check_invariants: Bool,
	early_configuration: CoreEarlyPipelineConfiguration,
	early_input: CoreEarlyPipelineInput
}


opaque type LoweredCoreCompilation = LoweredCoreCompilationRep


private record EarlyCoreCompilationRep {
	target_path: String,
	target_module_name: String,
	include_dirs: List[String],
	typed_summary: Option[String],
	require_main: Bool,
	check_invariants: Bool,
	early_configuration: CoreEarlyPipelineConfiguration,
	output: CoreEarlyPipelineOutput
}


opaque type EarlyCoreCompilation = EarlyCoreCompilationRep


private record RuntimeProjectedCompilationRep {
	target_path: String,
	target_module_name: String,
	include_dirs: List[String],
	typed_summary: Option[String],
	check_invariants: Bool,
	program: CoreProgram,
	observations: List[CoreObservation]
}


opaque type RuntimeProjectedCompilation = RuntimeProjectedCompilationRep


private record BackendEmissionCompilationRep {
	prepared_core: PreparedCoreProgram,
	configuration: BuildArtifactConfiguration,
	emission: CArtifact
}


opaque type BackendEmissionCompilation = BackendEmissionCompilationRep


union CompiledTypedGraph:
	CompiledTypedGraphReady(CoreCompilation, Option[String], List[String], List[CoreObservation])
	CompiledTypedGraphStopped(String, String, String, List[CoreObservation])


record CoreCompilePolicy {
	retain_debug_blocks: Bool
}


record FrontendCompilePolicy {
	allow_debug_only_calls: Bool,
	retain_debug_blocks: Bool,
	include_typed_summary: Bool
}


enum LateCoreStageAction:
	ObserveLateCoreStage
	StopLateCoreStage
	ObserveAndStopLateCoreStage


record LateCoreStageRequest {
	name: String,
	stage: CorePipelineStage,
	action: LateCoreStageAction
}


union LateCoreExecution:
	LateCoreCompleted(PreparedCoreProgram, List[CoreObservation])
	LateCoreStopped(String, String, List[CoreObservation])
	LateCoreFailed(String, String)


union EarlyCorePhaseExecution:
	EarlyCorePhaseReady(EarlyCoreCompilation)
	EarlyCorePhaseStopped(String, String, String, List[CoreObservation])
	EarlyCorePhaseFailed(List[String])


union RuntimeProjectionPhaseExecution:
	RuntimeProjectionPhaseReady(RuntimeProjectedCompilation)
	RuntimeProjectionPhaseStopped(String, String, String, List[CoreObservation])
	RuntimeProjectionPhaseFailed(List[String])


union BackendEmissionPhaseExecution:
	BackendEmissionPhaseReady(BackendEmissionCompilation)
	BackendEmissionPhaseFailed(String)


union ArtifactConstructionPhaseExecution:
	ArtifactConstructionPhaseReady(BuildArtifact)
	ArtifactConstructionPhaseFailed(String)


union FinishedCompilerPipeline:
	CompilerPipelineArtifactReady(BuildArtifact, List[CoreObservation])
	CompilerPipelineStopped(String, String, List[CoreObservation])
	CompilerPipelineInvariantFailed(String, String)
	CompilerPipelineEmitFailed(String)
	CompilerPipelineArtifactFailed(String)


private record CoreLoweringInput {
	target_path: String,
	target_module_name: String,
	definition_table: DefinitionTable,
	target_module_id: ModuleId,
	target_program: TypedProgram,
	modules: CoreGraphModules,
	target_import_bindings: List[CoreResolveImportBinding],
	module_imports: List[CoreResolveModuleImports],
	include_dirs: List[String],
	typed_summary: Option[String],
	next_def_id: Int
}


private pure func core_resolve_import_binding(
	definition_table: DefinitionTable,
	binding: ImportBinding,
) -> Option[CoreResolveImportBinding]:
	module_table = definition_table_module_table(definition_table)

	match binding:
		GraphQualifiedModuleBinding(local_name, module_id):
			module_path ?= module_table_canonical_path(module_table, module_id)
			Some(CoreQualifiedModuleImport(local_name, module_path))
		StandaloneQualifiedModuleBinding(local_name, module_path):
			Some(CoreQualifiedModuleImport(local_name, module_path))
		GraphSelectiveDefinitionBinding(local_name, _, definition_ids):
			Some(
				CoreExactSelectiveDefinitionImport(
					local_name,
					definition_ids.map(definition_id_runtime_value),
				),
			)
		GraphSelectiveTraitMethodBinding(local_name, module_id, source_name):
			module_path ?= module_table_canonical_path(module_table, module_id)
			Some(CoreSelectiveDefinitionImport(local_name, module_path, source_name))
		StandaloneSelectiveDefinitionBinding(local_name, module_path, source_name):
			Some(CoreSelectiveDefinitionImport(local_name, module_path, source_name))


private pure func core_resolve_import_bindings(
	definition_table: DefinitionTable,
	bindings: List[ImportBinding],
) -> Option[List[CoreResolveImportBinding]]:
	var resolved: List[CoreResolveImportBinding] = []
	var failed: Bool = False

	for binding in bindings:
		if not failed:
			match core_resolve_import_binding(definition_table, binding):
				Some(item):
					resolved = resolved.append(item)
				None:
					failed = True

	if failed:
		None
	else:
		Some(resolved)


private pure func core_graph_unit(module: TypecheckedModule) -> CoreGraphUnit:
	{
		module_id = module.module_id,
		typed_program = module.typed_program
	}


private pure func core_resolve_module_imports(
	definition_table: DefinitionTable,
	module: TypecheckedModule,
) -> Option[CoreResolveModuleImports]:
	bindings ?= core_resolve_import_bindings(definition_table, module.import_bindings)
	Some({
		module_name = typechecked_module_name(module),
		import_bindings = bindings,
	})


private pure func core_resolve_module_import_list(
	definition_table: DefinitionTable,
	modules: List[TypecheckedModule],
) -> Option[List[CoreResolveModuleImports]]:
	var resolved: List[CoreResolveModuleImports] = []
	var failed: Bool = False

	for module in modules:
		if not failed:
			match core_resolve_module_imports(definition_table, module):
				Some(imports):
					resolved = resolved.append(imports)
				None:
					failed = True

	if failed:
		None
	else:
		Some(resolved)


private pure func typed_decl_uses_source_include(decl: TypedDecl) -> Bool:
	match decl:
		TypedForeignFunctionDecl(info):
			not info.includes.is_empty()
		TypedPrivateDecl(inner):
			typed_decl_uses_source_include(inner)
		_:
			False


private pure func typechecked_module_source_include_dirs(module: TypecheckedModule) -> List[String]:
	if module.typed_program.decls.any(typed_decl_uses_source_include):
		[dirname(typechecked_module_path(module))]
	else:
		[]


pure func typechecked_graph_source_include_dirs(graph: TypecheckedGraph) -> List[String]:
	[graph.target]
		.concat(graph.modules)
		.flat_map(typechecked_module_source_include_dirs)
		.unique()


pure func typecheck_frontend_root_request(
	graph: FrontendCompilationGraph,
	root: FrontendModule,
	allow_debug_only_calls: Bool,
) -> TypecheckGraphRequest:
	module_targets = frontend_graph_dependency_modules(
		graph.graph,
	).map(
		func(module): module.identity,
	)
	typecheck_request_for_frontend_module(
		graph.graph,
		root,
		module_targets,
		False,
		allow_debug_only_calls,
	)


pure func typecheck_frontend_root(
	graph: FrontendCompilationGraph,
	root: FrontendModule,
	allow_debug_only_calls: Bool,
) -> TypecheckedGraph:
	typecheck_graph(typecheck_frontend_root_request(graph, root, allow_debug_only_calls))


pure func typecheck_frontend_all_roots(
	graph: FrontendCompilationGraph,
	root: FrontendModule,
	allow_debug_only_calls: Bool,
) -> TypecheckedGraph:
	ordered_modules = frontend_graph_dependency_modules(
		graph.graph,
	).concat(frontend_graph_root_modules(graph.graph))
	module_targets = ordered_modules
		.filter(func(module):
			not resolved_module_identities_equal(module.identity, root.identity)
		)
		.map(func(module): module.identity)
	request = typecheck_request_for_frontend_module(
		graph.graph,
		root,
		module_targets,
		False,
		allow_debug_only_calls,
	)
	typecheck_graph(request)


pure func typecheck_frontend_root_only(
	graph: FrontendCompilationGraph,
	root: FrontendModule,
	allow_debug_only_calls: Bool,
) -> TypecheckedGraph:
	request = typecheck_request_for_frontend_module(
		graph.graph,
		root,
		[],
		False,
		allow_debug_only_calls,
	)
	typecheck_graph(request)


pure func typecheck_compiler_frontend_graph(
	graph: FrontendGraph,
	root_identity: ResolvedModuleIdentity,
	module_target_identities: List[ResolvedModuleIdentity],
	include_comments: Bool,
	allow_debug_only_calls: Bool,
) -> Result[TypecheckedGraph, FrontendTypecheckRequestError]:
	typecheck_frontend_graph_direct(
		graph,
		root_identity,
		module_target_identities,
		include_comments,
		allow_debug_only_calls,
	)


-- Analysis context is stamped only after the shared frontend and typechecker
-- have produced a complete graph. The cache identity remains an adapter input,
-- not part of the generic typechecker request.
pure func typecheck_compiler_frontend_graph_with_context(
	graph: FrontendGraph,
	root_identity: ResolvedModuleIdentity,
	module_target_identities: List[ResolvedModuleIdentity],
	include_comments: Bool,
	allow_debug_only_calls: Bool,
	analysis_context: String,
) -> Result[TypecheckedGraph, FrontendTypecheckRequestError]:
	result ?= typecheck_compiler_frontend_graph(
		graph,
		root_identity,
		module_target_identities,
		include_comments,
		allow_debug_only_calls,
	)
	Ok({ result | analysis_context = Some(analysis_context) })


private pure func parse_error_messages(program: ParsedProgram) -> List[String]:
	program.diagnostics.map(parse_diagnostic_to_string)


private pure func typechecked_module_diagnostics(module: TypecheckedModule) -> List[String]:
	parse_error_messages(module.parsed_program).concat(module.errors)


pure func typechecked_graph_diagnostics(graph: TypecheckedGraph) -> List[String]:
	graph.modules
		.flat_map(typechecked_module_diagnostics)
		.concat(typechecked_module_diagnostics(graph.target))


pure func compile_frontend_graph(
	graph: FrontendCompilationGraph,
	policy: FrontendCompilePolicy,
	render_typecheck_diagnostics: pure (List[String]) -> List[String],
	require_main: Bool,
	check_invariants: Bool,
	early_observations: List[CoreEarlyPipelineStage],
	early_stop: Option[CoreEarlyPipelineStage],
) -> Result[CompiledTypedGraph, List[String]]:
	compile_frontend_graph_with_typed_validation(
		graph,
		policy,
		pure func(_): [],
		render_typecheck_diagnostics,
		require_main,
		check_invariants,
		early_observations,
		early_stop,
	)


pure func run_typed_frontend_compilation(
	graph: FrontendCompilationGraph,
	policy: FrontendCompilePolicy,
	validate: pure (TypecheckedGraph) -> List[String],
	render_typecheck_diagnostics: pure (List[String]) -> List[String],
	require_main: Bool,
	check_invariants: Bool,
	early_observations: List[CoreEarlyPipelineStage],
	early_stop: Option[CoreEarlyPipelineStage],
) -> Result[TypedFrontendCompilation, List[String]]:
	match frontend_graph_root_ids(graph.graph):
		[root_id]:
			module_target_ids = frontend_graph_module_ids(
				graph.graph,
			).filter(
				func(module_id): module_id != root_id,
			)

			match typecheck_frontend_graph_ids(
				graph.graph,
				frontend_graph_module_table(graph.graph),
				root_id,
				module_target_ids,
				policy.allow_debug_only_calls,
			):
				None:
					Err(["validated frontend graph lost its compilation root"])
				Some(typechecked):
					errors = graph.diagnostics.concat(
						render_typecheck_diagnostics(typechecked_graph_diagnostics(typechecked)),
					)

					if errors.length() != 0:
						Err(errors)
					else:
						validation_errors: List[String] = validate(typechecked)

						if validation_errors.length() != 0:
							Err(validation_errors)
						else:
							typed_summary: Option[String] = if policy.include_typed_summary:
								Some(typed_program_summary(typechecked.target.typed_program))
							else:
								None

							core_policy: CoreCompilePolicy = {
								retain_debug_blocks = policy.retain_debug_blocks,
							}

							Ok(into_opaque TypedFrontendCompilation({
										typechecked = typechecked,
										policy = core_policy,
										typed_summary = typed_summary,
										require_main = require_main,
										check_invariants = check_invariants,
										early_observations = early_observations,
										early_stop = early_stop
									}))
		_:
			Err(["source compilation requires exactly one root module"])


pure func compile_frontend_graph_with_typed_validation(
	graph: FrontendCompilationGraph,
	policy: FrontendCompilePolicy,
	validate: pure (TypecheckedGraph) -> List[String],
	render_typecheck_diagnostics: pure (List[String]) -> List[String],
	require_main: Bool,
	check_invariants: Bool,
	early_observations: List[CoreEarlyPipelineStage],
	early_stop: Option[CoreEarlyPipelineStage],
) -> Result[CompiledTypedGraph, List[String]]:
	typed ?= run_typed_frontend_compilation(
		graph,
		policy,
		validate,
		render_typecheck_diagnostics,
		require_main,
		check_invariants,
		early_observations,
		early_stop,
	)
	lowered ?= lower_typed_frontend_compilation(typed)

	match run_early_core_compilation(lowered):
		EarlyCorePhaseFailed(errors):
			Err(errors)
		EarlyCorePhaseStopped(target_path, stage_name, rendered, observations):
			Ok(CompiledTypedGraphStopped(target_path, stage_name, rendered, observations))
		EarlyCorePhaseReady(early):
			match project_runtime_compilation(early):
				RuntimeProjectionPhaseFailed(errors):
					Err(errors)
				RuntimeProjectionPhaseStopped(target_path, stage_name, rendered, observations):
					Ok(CompiledTypedGraphStopped(target_path, stage_name, rendered, observations))
				RuntimeProjectionPhaseReady(projected):
					Ok(compiled_typed_graph_ready(projected))


private pure func early_observation(observation: CoreEarlyPipelineObservation) -> CoreObservation:
	{
		stage_name = core_early_pipeline_stage_name(observation.stage),
		rendered = observation.rendered
	}


private pure func early_pipeline_error(diagnostic: CoreEarlyPipelineDiagnostic) -> String:
	message: String = core_early_pipeline_diagnostic_message(diagnostic)

	match core_early_pipeline_diagnostic_hint(diagnostic):
		Some(hint):
			"${message}\nhelp: ${hint}"
		None:
			message


private pure func program_has_top_level_main(program: CoreProgram) -> Bool:
	program.decls.any(func(decl):
		match decl:
			FunctionDecl(function_info):
				function_info.function_kind == ProgramEntrypointFunction
			_:
				False
	)


private pure func missing_main_error(path: String) -> String:
	"${path}:1:1: error[missing_main]: cannot compile runnable source without a main function\nhelp: Add a top-level `main` function, or use a check-only command for library source."


private pure func core_lowering_input(
	typechecked: TypecheckedGraph,
	typed_summary: Option[String],
) -> Option[CoreLoweringInput]:
	target_import_bindings ?= core_resolve_import_bindings(
		typechecked.definition_table,
		typechecked.target.import_bindings,
	)
	module_imports ?= core_resolve_module_import_list(
		typechecked.definition_table,
		typechecked.modules,
	)

	Some({
		target_path = typechecked_module_path(typechecked.target),
		target_module_name = typechecked_module_name(typechecked.target),
		definition_table = typechecked.definition_table,
		target_module_id = typechecked.target.module_id,
		target_program = typechecked.target.typed_program,
		modules = core_graph_modules(
			typechecked.definition_table,
			typechecked.modules.map(core_graph_unit),
		),
		target_import_bindings = target_import_bindings,
		module_imports = module_imports,
		include_dirs = typechecked_graph_source_include_dirs(typechecked),
		typed_summary = typed_summary,
		next_def_id = typechecked.next_def_id,
	})


pure func lower_typed_frontend_compilation(
	typed: TypedFrontendCompilation,
) -> Result[LoweredCoreCompilation, List[String]]:
	representation: TypedFrontendCompilationRep = from_opaque TypedFrontendCompilation(typed)
	input ?= core_lowering_input(
		representation.typechecked,
		representation.typed_summary,
	).to_result(["internal compiler error: qualified import target is outside its ModuleTable"])
	prepared = prepare_core_graph(
		input.definition_table,
		input.target_module_id,
		input.target_program,
		input.modules,
		input.next_def_id,
	)

	prepared_graph ?= match prepared:
		Ok(graph):
			Ok(graph)
		Err(error):
			Err([core_graph_prepare_error_to_string(error)])

	early_configuration: CoreEarlyPipelineConfiguration = {
		debug = representation.policy.retain_debug_blocks,
		check_invariants = representation.check_invariants,
		observations = representation.early_observations,
		stop_after = representation.early_stop
	}
	early_input: CoreEarlyPipelineInput = {
		program = prepared_graph.program,
		next_def_id = prepared_graph.next_def_id
	}

	Ok(into_opaque LoweredCoreCompilation({
				target_path = input.target_path,
				target_module_name = input.target_module_name,
				target_import_bindings = input.target_import_bindings,
				module_imports = input.module_imports,
				include_dirs = input.include_dirs,
				typed_summary = input.typed_summary,
				require_main = representation.require_main,
				check_invariants = representation.check_invariants,
				early_configuration = early_configuration,
				early_input = early_input
			}))


pure func run_early_core_compilation(lowered: LoweredCoreCompilation) -> EarlyCorePhaseExecution:
	representation: LoweredCoreCompilationRep = from_opaque LoweredCoreCompilation(lowered)

	match run_early_core_pipeline_to_runtime_projection(
		representation.early_input,
		representation.early_configuration,
		representation.target_import_bindings,
		representation.module_imports,
	):
		CoreEarlyPipelineFailed(diagnostic):
			EarlyCorePhaseFailed([early_pipeline_error(diagnostic)])
		CoreEarlyPipelineStopped(stage, rendered, completed_observations):
			EarlyCorePhaseStopped(
				representation.target_path,
				core_early_pipeline_stage_name(stage),
				rendered,
				completed_observations.map(early_observation),
			)
		CoreEarlyPipelineCompleted(output):
			EarlyCorePhaseReady(into_opaque EarlyCoreCompilation({
						target_path = representation.target_path,
						target_module_name = representation.target_module_name,
						include_dirs = representation.include_dirs,
						typed_summary = representation.typed_summary,
						require_main = representation.require_main,
						check_invariants = representation.check_invariants,
						early_configuration = representation.early_configuration,
						output = output
					}))


pure func project_runtime_compilation(
	early: EarlyCoreCompilation,
) -> RuntimeProjectionPhaseExecution:
	representation: EarlyCoreCompilationRep = from_opaque EarlyCoreCompilation(early)

	match project_runtime_program(representation.output.program):
		Err(error):
			RuntimeProjectionPhaseFailed([core_runtime_projection_error_message(error)])
		Ok(projected_program):
			match finish_early_core_pipeline_after_projection(
				{ representation.output | program = projected_program },
				representation.early_configuration,
			):
				CoreEarlyPipelineFailed(diagnostic):
					RuntimeProjectionPhaseFailed([early_pipeline_error(diagnostic)])
				CoreEarlyPipelineStopped(stage, rendered, completed_observations):
					RuntimeProjectionPhaseStopped(
						representation.target_path,
						core_early_pipeline_stage_name(stage),
						rendered,
						completed_observations.map(early_observation),
					)
				CoreEarlyPipelineCompleted(completed):
					if (
						representation.require_main
						and not program_has_top_level_main(completed.program)
					):
						RuntimeProjectionPhaseFailed(
							[missing_main_error(representation.target_path)],
						)
					else:
						RuntimeProjectionPhaseReady(into_opaque RuntimeProjectedCompilation({
									target_path = representation.target_path,
									target_module_name = representation.target_module_name,
									include_dirs = representation.include_dirs,
									typed_summary = representation.typed_summary,
									check_invariants = representation.check_invariants,
									program = completed.program,
									observations = completed.observations.map(early_observation)
								}))


pure func runtime_projected_core_compilation(
	projected: RuntimeProjectedCompilation,
) -> CoreCompilation:
	representation: RuntimeProjectedCompilationRep = from_opaque RuntimeProjectedCompilation(
		projected
	)
	{
		target_path = representation.target_path,
		target_module_name = representation.target_module_name,
		program = representation.program,
		check_invariants = representation.check_invariants
	}


pure func runtime_projected_include_dirs(projected: RuntimeProjectedCompilation) -> List[String]:
	representation: RuntimeProjectedCompilationRep = from_opaque RuntimeProjectedCompilation(
		projected
	)
	representation.include_dirs


pure func runtime_projected_typed_summary(projected: RuntimeProjectedCompilation) -> Option[String]:
	representation: RuntimeProjectedCompilationRep = from_opaque RuntimeProjectedCompilation(
		projected
	)
	representation.typed_summary


pure func runtime_projected_observations(
	projected: RuntimeProjectedCompilation,
) -> List[CoreObservation]:
	representation: RuntimeProjectedCompilationRep = from_opaque RuntimeProjectedCompilation(
		projected
	)
	representation.observations


pure func compiled_typed_graph_ready(projected: RuntimeProjectedCompilation) -> CompiledTypedGraph:
	compilation: CoreCompilation = runtime_projected_core_compilation(projected)
	CompiledTypedGraphReady(
		compilation,
		runtime_projected_typed_summary(projected),
		runtime_projected_include_dirs(projected),
		runtime_projected_observations(projected),
	)


pure func compile_typechecked_graph(
	typechecked: TypecheckedGraph,
	policy: CoreCompilePolicy,
	typed_summary: Option[String],
	require_main: Bool,
	check_invariants: Bool,
	early_observations: List[CoreEarlyPipelineStage],
	early_stop: Option[CoreEarlyPipelineStage],
) -> Result[CompiledTypedGraph, List[String]]:
	typed: TypedFrontendCompilation = into_opaque TypedFrontendCompilation({
			typechecked = typechecked,
			policy = policy,
			typed_summary = typed_summary,
			require_main = require_main,
			check_invariants = check_invariants,
			early_observations = early_observations,
			early_stop = early_stop
		})
	lowered ?= lower_typed_frontend_compilation(typed)

	match run_early_core_compilation(lowered):
		EarlyCorePhaseFailed(errors):
			Err(errors)
		EarlyCorePhaseStopped(target_path, stage_name, rendered, observations):
			Ok(CompiledTypedGraphStopped(target_path, stage_name, rendered, observations))
		EarlyCorePhaseReady(early):
			match project_runtime_compilation(early):
				RuntimeProjectionPhaseFailed(errors):
					Err(errors)
				RuntimeProjectionPhaseStopped(target_path, stage_name, rendered, observations):
					Ok(CompiledTypedGraphStopped(target_path, stage_name, rendered, observations))
				RuntimeProjectionPhaseReady(projected):
					Ok(compiled_typed_graph_ready(projected))


private pure func observes_late_stage(action: LateCoreStageAction) -> Bool:
	match action:
		ObserveLateCoreStage:
			True
		ObserveAndStopLateCoreStage:
			True
		StopLateCoreStage:
			False


private pure func stops_at_late_stage(action: LateCoreStageAction) -> Bool:
	match action:
		StopLateCoreStage:
			True
		ObserveAndStopLateCoreStage:
			True
		ObserveLateCoreStage:
			False


pure func late_core_invariant(stage: CorePipelineStage, program: CoreProgram) -> Option[String]:
	match check_late_core_invariants(stage, program):
		[violation, ..._]:
			Some(core_late_invariant_message(violation))
		[]:
			None


private pure func required_final_invariant(program: CoreProgram) -> Option[String]:
	if record_update_carrier_survives(program):
		Some("record update survived ownership normalization")
	else:
		match check_definition_id_uniqueness(program):
			[violation, ..._]:
				Some(core_late_invariant_message(violation))
			[]:
				None


pure func execute_late_core_stages(
	pre_dce_core: CoreProgram,
	observations: List[CoreObservation],
	stages: List[LateCoreStageRequest],
	check_invariants: Bool,
) -> LateCoreExecution:
	match stages:
		[]:
			completed: PreparedCoreProgram = run_pre_dce_tail(pre_dce_core)
			program: CoreProgram = prepared_core_program_value(completed)

			-- Keep the fast ownership and identity checks on every compile. The
			-- broader expression-tree audit remains opt-in through adapter policy.
			final_invariant_error: Option[String] = if check_invariants:
				late_core_invariant(FinalStage, program)
			else:
				required_final_invariant(program)

			match final_invariant_error:
				Some(detail):
					LateCoreFailed("final", detail)
				None:
					LateCoreCompleted(completed, observations)
		[stage, ...remaining]:
			transformed: CoreProgram = run_core_pipeline_stage(stage.stage, pre_dce_core)

			invariant_error: Option[String] = if check_invariants:
				late_core_invariant(stage.stage, transformed)
			else:
				None

			match invariant_error:
				Some(detail):
					LateCoreFailed(stage.name, detail)
				None:
					rendered: String = core_program_to_json(transformed).to_string()

					updated_observations: List[CoreObservation] = if observes_late_stage(
						stage.action,
					):
						observations.append({
							stage_name = stage.name,
							rendered = rendered,
						})
					else:
						observations

					if stops_at_late_stage(stage.action):
						LateCoreStopped(stage.name, rendered, updated_observations)
					else:
						execute_late_core_stages(
							transformed,
							updated_observations,
							remaining,
							check_invariants,
						)


private pure func build_artifact_error_message(error: BuildArtifactError) -> String:
	match error:
		InvalidForeignLinkArguments(arguments):
			"invalid foreign link arguments in semantic Core: `${arguments}`"


pure func run_late_core_compilation(
	projected: RuntimeProjectedCompilation,
	stages: List[LateCoreStageRequest],
) -> LateCoreExecution:
	representation: RuntimeProjectedCompilationRep = from_opaque RuntimeProjectedCompilation(
		projected
	)
	execute_late_core_stages(
		representation.program,
		representation.observations,
		stages,
		representation.check_invariants,
	)


pure func emit_backend_c(
	prepared_core: PreparedCoreProgram,
	configuration: BuildArtifactConfiguration,
) -> BackendEmissionPhaseExecution:
	match try_emit_prepared_core_program_c_artifact_with_profile(
		prepared_core,
		configuration.profile,
	):
		Ok(emission):
			BackendEmissionPhaseReady(into_opaque BackendEmissionCompilation({
						prepared_core = prepared_core,
						configuration = configuration,
						emission = emission
					}))
		Err(error):
			BackendEmissionPhaseFailed(core_emit_error_message(error))


pure func construct_backend_artifact(
	emission: BackendEmissionCompilation,
) -> ArtifactConstructionPhaseExecution:
	representation: BackendEmissionCompilationRep = from_opaque BackendEmissionCompilation(emission)
	program: CoreProgram = prepared_core_program_value(representation.prepared_core)

	match build_artifact(program, representation.emission, representation.configuration):
		Ok(artifact):
			ArtifactConstructionPhaseReady(artifact)
		Err(error):
			ArtifactConstructionPhaseFailed(build_artifact_error_message(error))


pure func finish_compiler_pipeline(
	pre_dce_core: CoreProgram,
	observations: List[CoreObservation],
	stages: List[LateCoreStageRequest],
	check_invariants: Bool,
	configuration: BuildArtifactConfiguration,
) -> FinishedCompilerPipeline:
	match execute_late_core_stages(pre_dce_core, observations, stages, check_invariants):
		LateCoreCompleted(completed_core, completed_observations):
			match emit_backend_c(completed_core, configuration):
				BackendEmissionPhaseReady(emission):
					match construct_backend_artifact(emission):
						ArtifactConstructionPhaseReady(artifact):
							CompilerPipelineArtifactReady(artifact, completed_observations)
						ArtifactConstructionPhaseFailed(message):
							CompilerPipelineArtifactFailed(message)
				BackendEmissionPhaseFailed(message):
					CompilerPipelineEmitFailed(message)
		LateCoreStopped(stage_name, rendered, stopped_observations):
			CompilerPipelineStopped(stage_name, rendered, stopped_observations)
		LateCoreFailed(stage_name, detail):
			CompilerPipelineInvariantFailed(stage_name, detail)
