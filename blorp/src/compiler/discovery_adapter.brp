---
The sign the existing parser prefixes to a negative numeric pattern's digits.
---
private NEGATIVE_SIGN: String = "-"

---
Stands for a by-key index entry whose key has no row.
---
private ABSENT_ROW: Int = -1

---
Stands for the start of an item list that has no more items, so merging by
start picks another list.
---
private NO_MORE_ITEMS: Int = 9223372036854775807


---
Why the tables could not be rebuilt as the existing front end's AST.

- `MissingTableRow(table, index)`: a row the tables should hold is not there.
- `NotAWrittenType(node)`: a node in a type position has a kind no written type
  has.
- `MalformedNode(node, kind)`: a body node's children are not the kinds, or not
  as many, as its kind documents (`NodeKind` in the stage's row kinds).
- `BodyRootNotAnExpression(node)`: the node a body row names as its root is not
  an expression.
- `ModuleWithoutRequest(module)`: a module no root, implicit request or import
  loaded, so it has no name.
- `GraphRejected(errors)`: the existing graph validation refused the rebuilt
  modules.
---
union LegacyAdapterError:
	MissingTableRow(DiscoveryTable, Int)
	NotAWrittenType(Int)
	MalformedNode(Int, Kinds.NodeKind)
	BodyRootNotAnExpression(Int)
	ModuleWithoutRequest(Int)
	GraphRejected(List[FrontendGraphServiceError])


---
The error as a line of text.
---
pure func legacy_adapter_error_message(error: LegacyAdapterError) -> String:
	match error:
		MissingTableRow(table, index):
			"the tables hold no row ${index} of ${discovery_table_name(table)}"
		NotAWrittenType(node):
			"node ${node} is in a type position but is not a written type"
		BodyRootNotAnExpression(node):
			"node ${node} is the root of a body but is not an expression"
		MalformedNode(node, kind):
			"node ${node} (${Kinds.node_kind_name(kind)}) does not have the children its kind documents"
		ModuleWithoutRequest(module):
			"module ${module} was loaded by no root, implicit request or import"
		GraphRejected(errors):
			"the existing graph validation refused the rebuilt modules: ${errors.map(frontend_graph_service_error_message).join("; ")}"


---
How the existing front end names the modules the stage loaded. A module's name
comes from how it was reached, which the tables hold: a module imported by a
bare, native-package or source-package request is named by the request's text,
one imported by a relative request, or from user code, by its path, an
implicit module by its request's name. The two things they do not hold are
conventions of the existing front end's callers, so they are inputs: the name a
root takes, a function of the root's request path as it was given to discovery,
and how a module named by its path spells that path (`path_module_name`, of the
module's canonical path with its extension: the existing front end spells it
from the working directory, so a file reached by an absolute path and one
reached by a relative path have the same name).
---
record LegacyModuleNaming {
	root_module_name: pure (String) -> String,
	path_module_name: pure (String) -> String
}


---
The rows of a table that belong to each owner, in table order: a counting-sort
index, so the rows of one owner need not be adjacent in the table. `starts`
has one entry per owner plus one; the rows of owner `k` are
`rows[starts[k] .. starts[k + 1]]`, each a row position in the indexed table.
---
record OwnerRows {
	starts: List[Int],
	rows: List[Int]
}


---
Everything the declaration half reads from the frozen tables, plus the indexes
derived from them. Derived from one `FrontendTables`, built once by
`legacy_declaration_reader`, read-only afterwards; no fact is stored here that
the tables do not hold.
---
record DeclarationReader {
	tables: Tables.FrontendTables,
	import_texts: List[String],
	module_names: List[String],
	source_paths: List[String],
	members: OwnerRows,
	annotations: OwnerRows,
	type_parameters: OwnerRows,
	bounds: OwnerRows,
	supertraits: OwnerRows,
	variant_payloads: OwnerRows,
	dimension_constraints: OwnerRows,
	import_blocks: OwnerRows,
	foreign_blocks: OwnerRows,
	foreign_block_functions: OwnerRows,
	documentation_of: List[Int],
	signature_of: List[Int],
	impl_of: List[Int],
	definition_type_of: List[Int],
	parameter_type_of: List[Int],
	body_of: List[Int],
	foreign_c_name_of: List[Int],
	resource_cleanup_of: List[Int],
	module_documentation_of: List[Int],
	sigil_name_of: List[Int]
}


---
The standard library embedded in the compiler (`embedded_std`, generated by the
build), as the stage's embedded provider asks for it. The composition belongs
here because the stage must not import the compiler's generated inputs.
---
record CompilerEmbeddedTexts {
	description: String
}


COMPILER_EMBEDDED_TEXTS: CompilerEmbeddedTexts = {description = "embedded standard library"}


implements EmbeddedStandardLibraryTexts for CompilerEmbeddedTexts:
	pure func module_names(self: CompilerEmbeddedTexts) -> List[String]:
		embedded_std_module_names()

	pure func module_source(self: CompilerEmbeddedTexts, module_name: String) -> Option[String]:
		embedded_std_source(module_name)


---
The source path a graph module reports for an embedded standard-library module.
---
pure func legacy_embedded_path(module_name: String) -> String:
	"<embedded:" + module_name + ">"


-- Results.
private pure func present[T](
	row: Option[T],
	table: DiscoveryTable,
	index: Int,
) -> Result[T, LegacyAdapterError]:
	match row:
		Some(found):
			Ok(found)
		None:
			Err(MissingTableRow(table, index))


---
The values of `items` if every one is `Ok`, else the first error.
---
private pure func collected[T](
	items: List[Result[T, LegacyAdapterError]],
) -> Result[List[T], LegacyAdapterError]:
	var values: List[T] = []
	var failure: Option[LegacyAdapterError] = None

	for item in items:
		match item:
			Ok(value):
				values = values.append(value)
			Err(error):
				if failure.is_none():
					failure = Some(error)

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(values)


-- Indexes.
---
The index of `owner_count` owners over a table whose row `i` belongs to owner
`owners[i]`.
---
private pure func group_by_owner(owner_count: Int, owners: List[Int]) -> OwnerRows:
	var starts: List[Int] = repeat(0, owner_count + 1)

	for owner in owners:
		starts = starts.set(owner + 1, starts.get_or(owner + 1, 0) + 1)

	for owner in 0..owner_count:
		starts = starts.set(owner + 1, starts.get_or(owner + 1, 0) + starts.get_or(owner, 0))

	var next_slot: List[Int] = starts
	var rows: List[Int] = repeat(0, owners.length())
	var row: Int = 0

	for owner in owners:
		slot: Int = next_slot.get_or(owner, 0)
		rows = rows.set(slot, row)
		next_slot = next_slot.set(owner, slot + 1)
		row += 1

	{
		starts = starts,
		rows = rows
	}


---
The row position of each key's row in a table whose row `i` has key `keys[i]`;
`ABSENT_ROW` for a key with none. A key with several rows takes the last.
---
private pure func row_by_key(key_count: Int, keys: List[Int]) -> List[Int]:
	var rows: List[Int] = repeat(ABSENT_ROW, key_count)
	var row: Int = 0

	for key in keys:
		rows = rows.set(key, row)
		row += 1

	rows


---
The row positions of `owner`'s rows in the indexed `table`.
---
private pure func rows_of(
	index: OwnerRows,
	owner: Int,
	table: DiscoveryTable,
) -> Result[List[Int], LegacyAdapterError]:
	first ?= present(
		index.starts.get(owner),
		table,
		owner,
	)
	end ?= present(
		index.starts.get(owner + 1),
		table,
		owner + 1,
	)
	slots: List[Result[Int, LegacyAdapterError]] = range(first, end).map(pure func(slot): present(
			index.rows.get(slot),
			table,
			slot,
		))
	collected(slots)


---
The row of `table` that `rows` records for `key`, or `None` when the key has
none; an error when the key is outside the index.
---
private pure func optional_row(
	rows: List[Int],
	key: Int,
	table: DiscoveryTable,
) -> Result[Option[Int], LegacyAdapterError]:
	row ?= present(
		rows.get(key),
		table,
		key,
	)

	if row == ABSENT_ROW:
		Ok(None)
	else:
		Ok(Some(row))


---
The row of `table` that `rows` records for `key`; an error when it has none.
---
private pure func required_row(
	rows: List[Int],
	key: Int,
	table: DiscoveryTable,
) -> Result[Int, LegacyAdapterError]:
	found ?= optional_row(rows, key, table)
	present(found, table, key)


private pure func keys_of(
	count: Int,
	key_at: pure (Int) -> Int,
) -> List[Int]:
	range(0, count).map(key_at)


-- Module names.
---
The existing front end's name for each module, in module order: see
`LegacyModuleNaming`.
---
private pure func legacy_module_names(
	tables: Tables.FrontendTables,
	naming: LegacyModuleNaming,
	import_texts: List[String],
) -> Result[List[String], LegacyAdapterError]:
	modules: Int = Tables.module_count(tables)
	root_requests: List[Int] = first_requests(
		modules,
		range(
			0,
			Tables.root_count(tables),
		).map(pure func(root): root_target_index(tables, root)),
	)
	implicit_requests: List[Int] = first_requests(
		modules,
		range(
			0,
			Tables.implicit_request_count(tables),
		).map(pure func(request): implicit_target_index(tables, request)),
	)
	import_requests: List[Int] = first_requests(
		modules,
		range(
			0,
			Tables.import_count(tables),
		).map(pure func(import_row): import_target_index(tables, import_row)),
	)

	collected(range(0, modules).map(
		pure func(
			module,
		): legacy_module_name(
			tables,
			naming,
			module,
			root_requests,
			implicit_requests,
			import_requests,
			import_texts,
		),
	))


---
For each module, the first request (by request position) that loaded it, from
`targets[request]`, the module a request loaded or `ABSENT_ROW`.

"First by position" is "first loaded" only because of an order the stage
guarantees: the import rows are appended module by module in load order and, in
a module, in source order (`close_module` ends each module's import block where
its parse left the table, and modules parse one at a time), and discovery resolves
imports in that same order, so the first import row naming a module as its
target is the one that loaded it. The existing front end names a module by the
request that loaded it.
---
private pure func first_requests(module_count: Int, targets: List[Int]) -> List[Int]:
	var first: List[Int] = repeat(ABSENT_ROW, module_count)
	var request: Int = 0

	for target in targets:
		if target != ABSENT_ROW and first.get_or(target, 0) == ABSENT_ROW:
			first = first.set(target, request)

		request += 1

	first


private pure func root_target_index(tables: Tables.FrontendTables, root: Int) -> Int:
	match Tables.root_target(tables, root_id_at_row(root)):
		Some(target):
			module_id_index(target)
		None:
			ABSENT_ROW


private pure func implicit_target_index(tables: Tables.FrontendTables, request: Int) -> Int:
	match Tables.implicit_target(tables, implicit_request_id_at_row(request)):
		Some(target):
			module_id_index(target)
		None:
			ABSENT_ROW


private pure func import_target_index(tables: Tables.FrontendTables, import_row: Int) -> Int:
	match Tables.import_target(tables, import_id_at_row(import_row)):
		Some(target):
			module_id_index(target)
		None:
			ABSENT_ROW


private pure func legacy_module_name(
	tables: Tables.FrontendTables,
	naming: LegacyModuleNaming,
	module: Int,
	root_requests: List[Int],
	implicit_requests: List[Int],
	import_requests: List[Int],
	import_texts: List[String],
) -> Result[String, LegacyAdapterError]:
	row: ModuleRow = Tables.module_row(tables, module_id_at_row(module))

	match row.reach:
		Kinds.RootModule:
			root ?= requested(root_requests, module)
			request_path: String = Tables.path_text(
				tables,
				Tables.root_row(tables, root_id_at_row(root)).request_path,
			)
			Ok(naming.root_module_name(request_path))
		Kinds.ImplicitModule:
			request ?= requested(implicit_requests, module)
			Ok(
				Tables.path_text(
					tables,
					Tables.implicit_request_row(
						tables,
						implicit_request_id_at_row(request),
					).request_path,
				),
			)
		Kinds.ImportedModule:
			import_row ?= requested(import_requests, module)
			imported ?= present(
				Tables.import_row_at(tables, import_row),
				ImportTable,
				import_row,
			)
			Ok(
				imported_module_name(
					tables,
					naming,
					row,
					imported,
					import_texts.get_or(import_row, ""),
				),
			)


---
The request that loaded `module`, or `ModuleWithoutRequest`.
---
private pure func requested(requests: List[Int], module: Int) -> Result[Int, LegacyAdapterError]:
	match requests.get(module):
		Some(request):
			if request == ABSENT_ROW:
				Err(ModuleWithoutRequest(module))
			else:
				Ok(request)
		None:
			Err(ModuleWithoutRequest(module))


---
The name of a module an import loaded: the request's text, except for a
relative request or a user module, which the existing front end names by the
file's path, spelled as `naming` spells it.
---
private pure func imported_module_name(
	tables: Tables.FrontendTables,
	naming: LegacyModuleNaming,
	module: ModuleRow,
	request: ImportRow,
	request_text: String,
) -> String:
	path_name: String = naming.path_module_name(
		Tables.path_text(
			tables,
			Tables.module_path(tables, module),
		),
	)

	match request.request.request_kind():
		Kinds.RelativeModuleRequest:
			path_name
		_:
			match module.origin:
				Kinds.UserModule:
					path_name
				_:
					request_text


---
A source file's path in the existing front end's spelling: the stage's path, or
for an embedded module `<embedded:name>`.
---
private pure func legacy_source_path(path: String) -> String:
	match embedded_module_name(path):
		Some(module_name):
			legacy_embedded_path(module_name)
		None:
			path


---
Each module's source path in the existing front end's spelling: the stage's
canonical (normalized) path, or `<embedded:name>` for an embedded module, except
for a module a root loaded, which the existing front end keeps as the caller
wrote it (the request's text), so a path with a doubled separator or a leading
`./` is reported as given.
---
private pure func legacy_source_paths(tables: Tables.FrontendTables) -> List[String]:
	modules: Int = Tables.module_count(tables)
	root_requests: List[Int] = first_requests(
		modules,
		range(
			0,
			Tables.root_count(tables),
		).map(pure func(root): root_target_index(tables, root)),
	)

	range(0, modules).map(pure func(module):
		row: ModuleRow = Tables.module_row(tables, module_id_at_row(module))

		match (row.reach, root_requests.get(module)):
			(Kinds.RootModule, Some(root)):
				Tables.path_text(tables, Tables.root_row(tables, root_id_at_row(root)).request_path)
			_:
				legacy_source_path(
					Tables.path_text(
						tables,
						Tables.source_row(tables, row.source).path,
					),
				)
	)


---
The text each import row's request is written as, built once per row from its
structure (`Tables.import_request_text`) and read by row afterwards.
---
private pure func legacy_import_texts(tables: Tables.FrontendTables) -> List[String]:
	range(
		0,
		Tables.import_count(tables),
	).map(pure func(import_row): import_text_at(tables, import_row))


private pure func import_text_at(tables: Tables.FrontendTables, import_row: Int) -> String:
	match Tables.import_row_at(tables, import_row):
		Some(row):
			Tables.import_request_text(tables, row)
		None:
			""


---
The reader over `tables`: its indexes, built in one pass over each table.
---
pure func legacy_declaration_reader(
	tables: Tables.FrontendTables,
	naming: LegacyModuleNaming,
) -> Result[DeclarationReader, LegacyAdapterError]:
	definitions: Int = Tables.definition_count(tables)
	modules: Int = Tables.module_count(tables)
	parameters: Int = Tables.parameter_count(tables)
	foreign_blocks: Int = Tables.foreign_block_count(tables)
	import_texts: List[String] = legacy_import_texts(tables)
	module_names ?= legacy_module_names(tables, naming, import_texts)
	source_paths: List[String] = legacy_source_paths(tables)

	Ok({
		tables = tables,
		import_texts = import_texts,
		module_names = module_names,
		source_paths = source_paths,
		members = group_by_owner(
			definitions,
			keys_of(Tables.member_count(tables), pure func(row): member_owner(tables, row)),
		),
		annotations = group_by_owner(
			definitions,
			keys_of(Tables.annotation_count(tables), pure func(row): annotation_owner(tables, row)),
		),
		type_parameters = group_by_owner(
			definitions,
			keys_of(
				Tables.type_parameter_count(tables),
				pure func(row): type_parameter_owner(tables, row),
			),
		),
		bounds = group_by_owner(
			definitions,
			keys_of(Tables.bound_count(tables), pure func(row): bound_owner(tables, row)),
		),
		supertraits = group_by_owner(
			definitions,
			keys_of(Tables.supertrait_count(tables), pure func(row): supertrait_owner(tables, row)),
		),
		variant_payloads = group_by_owner(
			definitions,
			keys_of(
				Tables.variant_payload_count(tables),
				pure func(row): variant_payload_owner(tables, row),
			),
		),
		dimension_constraints = group_by_owner(
			definitions,
			keys_of(
				Tables.dimension_constraint_count(tables),
				pure func(row): dimension_constraint_owner(tables, row),
			),
		),
		import_blocks = group_by_owner(
			modules,
			keys_of(
				Tables.import_block_count(tables),
				pure func(row): import_block_owner(tables, row),
			),
		),
		foreign_blocks = group_by_owner(
			modules,
			keys_of(
				Tables.foreign_block_count(tables),
				pure func(row): foreign_block_owner(tables, row),
			),
		),
		foreign_block_functions = group_by_owner(
			foreign_blocks,
			keys_of(
				Tables.foreign_binding_count(tables),
				pure func(row): foreign_binding_block(tables, row),
			),
		),
		documentation_of = row_by_key(
			definitions,
			keys_of(
				Tables.documentation_count(tables),
				pure func(row): documentation_definition(tables, row),
			),
		),
		signature_of = row_by_key(
			definitions,
			keys_of(
				Tables.signature_count(tables),
				pure func(row): signature_definition(tables, row),
			),
		),
		impl_of = row_by_key(
			definitions,
			keys_of(Tables.impl_count(tables), pure func(row): impl_definition(tables, row)),
		),
		definition_type_of = row_by_key(
			definitions,
			keys_of(
				Tables.definition_type_count(tables),
				pure func(row): definition_type_definition(tables, row),
			),
		),
		parameter_type_of = row_by_key(
			parameters,
			keys_of(
				Tables.parameter_type_count(tables),
				pure func(row): parameter_type_parameter(tables, row),
			),
		),
		body_of = row_by_key(
			definitions,
			keys_of(Tables.body_count(tables), pure func(row): body_definition(tables, row)),
		),
		foreign_c_name_of = row_by_key(
			definitions,
			keys_of(
				Tables.foreign_c_name_count(tables),
				pure func(row): foreign_c_name_definition(tables, row),
			),
		),
		resource_cleanup_of = row_by_key(
			definitions,
			keys_of(
				Tables.resource_cleanup_count(tables),
				pure func(row): resource_cleanup_definition(tables, row),
			),
		),
		module_documentation_of = row_by_key(
			modules,
			keys_of(
				Tables.module_documentation_count(tables),
				pure func(row): module_documentation_module(tables, row),
			),
		),
		sigil_name_of = row_by_key(
			Tables.name_count(tables),
			keys_of(
				Tables.dimension_name_count(tables),
				pure func(row): dimension_plain_name(tables, row),
			),
		),
	})


-- The key each table's row `row` is indexed under. `row` is below the table's
-- count, so the row exists; the key 0 for one that does not is unreachable.
private pure func member_owner(tables: Tables.FrontendTables, row: Int) -> Int:
	match Tables.member_row_at(tables, row):
		Some(member):
			definition_id_index(member.owner)
		None:
			0


private pure func annotation_owner(tables: Tables.FrontendTables, row: Int) -> Int:
	match Tables.annotation_row_at(tables, row):
		Some(annotation):
			definition_id_index(annotation.definition)
		None:
			0


private pure func type_parameter_owner(tables: Tables.FrontendTables, row: Int) -> Int:
	match Tables.type_parameter_row_at(tables, row):
		Some(parameter):
			definition_id_index(parameter.owner)
		None:
			0


private pure func bound_owner(tables: Tables.FrontendTables, row: Int) -> Int:
	match Tables.bound_row_at(tables, row):
		Some(bound):
			definition_id_index(bound.owner)
		None:
			0


private pure func supertrait_owner(tables: Tables.FrontendTables, row: Int) -> Int:
	match Tables.supertrait_row_at(tables, row):
		Some(supertrait):
			definition_id_index(supertrait.trait_definition)
		None:
			0


private pure func variant_payload_owner(tables: Tables.FrontendTables, row: Int) -> Int:
	match Tables.variant_payload_row_at(tables, row):
		Some(payload):
			definition_id_index(payload.variant)
		None:
			0


private pure func dimension_constraint_owner(tables: Tables.FrontendTables, row: Int) -> Int:
	match Tables.dimension_constraint_row_at(tables, row):
		Some(constraint):
			definition_id_index(constraint.owner)
		None:
			0


private pure func import_block_owner(tables: Tables.FrontendTables, row: Int) -> Int:
	match Tables.import_block_row_at(tables, row):
		Some(block):
			module_id_index(block.module)
		None:
			0


private pure func foreign_block_owner(tables: Tables.FrontendTables, row: Int) -> Int:
	match Tables.foreign_block_row_at(tables, row):
		Some(block):
			module_id_index(block.module)
		None:
			0


private pure func foreign_binding_block(tables: Tables.FrontendTables, row: Int) -> Int:
	match Tables.foreign_binding_row_at(tables, row):
		Some(binding):
			foreign_block_id_index(binding.block)
		None:
			0


private pure func documentation_definition(tables: Tables.FrontendTables, row: Int) -> Int:
	match Tables.documentation_row_at(tables, row):
		Some(documentation):
			definition_id_index(documentation.definition)
		None:
			0


private pure func signature_definition(tables: Tables.FrontendTables, row: Int) -> Int:
	match Tables.signature_row_at(tables, row):
		Some(signature):
			definition_id_index(signature.definition)
		None:
			0


private pure func impl_definition(tables: Tables.FrontendTables, row: Int) -> Int:
	match Tables.impl_row_at(tables, row):
		Some(impl_row):
			definition_id_index(impl_row.definition)
		None:
			0


private pure func definition_type_definition(tables: Tables.FrontendTables, row: Int) -> Int:
	match Tables.definition_type_row_at(tables, row):
		Some(declared):
			definition_id_index(declared.definition)
		None:
			0


private pure func parameter_type_parameter(tables: Tables.FrontendTables, row: Int) -> Int:
	match Tables.parameter_type_row_at(tables, row):
		Some(declared):
			parameter_id_index(declared.parameter)
		None:
			0


private pure func body_definition(tables: Tables.FrontendTables, row: Int) -> Int:
	match Tables.body_row_at(tables, row):
		Some(body):
			definition_id_index(body.definition)
		None:
			0


private pure func foreign_c_name_definition(tables: Tables.FrontendTables, row: Int) -> Int:
	match Tables.foreign_c_name_row_at(tables, row):
		Some(c_name):
			definition_id_index(c_name.definition)
		None:
			0


private pure func resource_cleanup_definition(tables: Tables.FrontendTables, row: Int) -> Int:
	match Tables.resource_cleanup_row_at(tables, row):
		Some(cleanup):
			definition_id_index(cleanup.definition)
		None:
			0


private pure func module_documentation_module(tables: Tables.FrontendTables, row: Int) -> Int:
	match Tables.module_documentation_row_at(tables, row):
		Some(documentation):
			module_id_index(documentation.module)
		None:
			0


private pure func dimension_plain_name(tables: Tables.FrontendTables, row: Int) -> Int:
	match Tables.dimension_name_row_at(tables, row):
		Some(pair):
			table_name_index(pair.name)
		None:
			0


-- Names, locations and text.
private pure func legacy_location(span: Span) -> SourceLocation:
	source_location_from_offsets(singleton_source_file_id(), span_start(span), span_end(span))


---
An identifier of the existing parsed AST: the stage's name id and spelling, so
the two agree by construction.
---
private pure func legacy_identifier(
	reader: DeclarationReader,
	name: TableNameId,
	span: Span,
) -> ParsedIdentifier:
	parsed_identifier(
		name_id_from_interned_index(table_name_index(name)),
		Tables.name_spelling(reader.tables, name),
		legacy_location(span),
	)


private pure func literal_string(reader: DeclarationReader, literal: LiteralId) -> String:
	Tables.literal_text(reader.tables, literal)


---
A dimension name as the existing AST spells it: with its `#`, the name the
dimension name rows pair with the plain one.
---
private pure func legacy_dimension_identifier(
	reader: DeclarationReader,
	name: TableNameId,
	span: Span,
) -> Result[ParsedIdentifier, LegacyAdapterError]:
	key: Int = table_name_index(name)
	row ?= required_row(reader.sigil_name_of, key, DimensionNameTable)
	pair ?= present(
		Tables.dimension_name_row_at(reader.tables, row),
		DimensionNameTable,
		row,
	)
	Ok(legacy_identifier(reader, pair.sigil_name, span))


private pure func legacy_wildcard_dimension_identifier(
	reader: DeclarationReader,
	span: Span,
) -> ParsedIdentifier:
	legacy_identifier(reader, Tables.wildcard_dimension_name(), span)


-- Rows by id.
private pure func definition_at(
	reader: DeclarationReader,
	definition: Int,
) -> Result[DefinitionRow, LegacyAdapterError]:
	present(
		Tables.definition_row_at(reader.tables, definition),
		DefinitionTable,
		definition,
	)


private pure func node_at(
	reader: DeclarationReader,
	node: NodeId,
) -> Result[NodeRow, LegacyAdapterError]:
	index: Int = node_id_index(node)
	present(
		Tables.node_row_at(reader.tables, index),
		NodeTable,
		index,
	)


---
Child `ordinal` of `node`.
---
private pure func child_node(
	reader: DeclarationReader,
	node: NodeId,
	ordinal: Int,
) -> Result[NodeId, LegacyAdapterError]:
	present(
		Tables.node_child(reader.tables, node, ordinal),
		NodeChildTable,
		node_id_index(node),
	)


-- Types.
---
The written type rooted at `node`. `MissingTypeNode` is what the parser records
where a type was required and absent (a diagnostic reports it); any other kind
that is not a written type is an error.
---
private pure func legacy_type(
	reader: DeclarationReader,
	node: NodeId,
) -> Result[ParsedTypeExpr, LegacyAdapterError]:
	row ?= node_at(reader, node)
	location: SourceLocation = legacy_location(row.span)
	name: TableNameId = name_id_at_row(row.payload)
	name_span: Span = Tables.node_name_span(reader.tables, node)

	match row.kind:
		Kinds.NamedTypeNode:
			arguments ?= legacy_children(reader, node, 0)
			Ok(ParsedNamedType(legacy_identifier(reader, name, name_span), arguments, location))
		Kinds.QualifiedTypeNode:
			qualifier_node ?= child_node(reader, node, 0)
			qualifier ?= node_at(reader, qualifier_node)
			arguments ?= legacy_children(reader, node, 1)
			Ok(
				ParsedQualifiedNamedType(
					legacy_identifier(reader, name_id_at_row(qualifier.payload), qualifier.span),
					legacy_identifier(reader, name, name_span),
					arguments,
					location,
				),
			)
		Kinds.BoundedTypeNode:
			bounds ?= collected(range(0, row.children.count).map(
				pure func(ordinal): legacy_inline_bound(reader, node, ordinal),
			))
			Ok(ParsedBoundedType(legacy_identifier(reader, name, name_span), bounds, location))
		Kinds.DimensionNameTypeNode:
			identifier ?= legacy_dimension_identifier(reader, name, row.span)
			Ok(ParsedDimNameType(identifier, False, location))
		Kinds.VariadicDimensionNameTypeNode:
			identifier ?= legacy_dimension_identifier(reader, name, name_span)
			Ok(ParsedDimNameType(identifier, True, location))
		Kinds.DimensionWildcardTypeNode:
			Ok(
				ParsedDimNameType(
					legacy_wildcard_dimension_identifier(reader, row.span),
					False,
					location,
				),
			)
		Kinds.VariadicDimensionWildcardTypeNode:
			Ok(
				ParsedDimNameType(
					legacy_wildcard_dimension_identifier(reader, name_span),
					True,
					location,
				),
			)
		Kinds.DimensionLiteralTypeNode:
			Ok(
				ParsedDimLiteralType(
					literal_string(reader, literal_id_at_row(row.payload)),
					location,
				),
			)
		Kinds.DimensionAddTypeNode:
			legacy_dimension_binary(reader, ParsedDimAddOp, node)
		Kinds.DimensionSubtractTypeNode:
			legacy_dimension_binary(reader, ParsedDimSubtractOp, node)
		Kinds.DimensionMultiplyTypeNode:
			legacy_dimension_binary(reader, ParsedDimMultiplyOp, node)
		Kinds.DimensionDivideTypeNode:
			legacy_dimension_binary(reader, ParsedDimDivideOp, node)
		Kinds.RangeTypeNode:
			element ?= legacy_child_type(reader, node, 0)
			Ok(ParsedRangeType(element, location))
		Kinds.TupleTypeNode:
			elements ?= legacy_children(reader, node, 0)
			Ok(ParsedTupleType(elements, location))
		Kinds.FunctionTypeNode:
			legacy_function_type(reader, False, node)
		Kinds.PureFunctionTypeNode:
			legacy_function_type(reader, True, node)
		Kinds.ArrayTypeNode:
			element ?= legacy_child_type(reader, node, 0)
			dimensions ?= legacy_children(reader, node, 1)
			Ok(ParsedArrayType(element, dimensions, location))
		Kinds.MissingTypeNode:
			Ok(ParsedMissingType(location))
		_:
			Err(NotAWrittenType(node_id_index(node)))


private pure func legacy_child_type(
	reader: DeclarationReader,
	node: NodeId,
	ordinal: Int,
) -> Result[ParsedTypeExpr, LegacyAdapterError]:
	child ?= child_node(reader, node, ordinal)
	legacy_type(reader, child)


---
The types of the children of `node` from `first_ordinal` on.
---
private pure func legacy_children(
	reader: DeclarationReader,
	node: NodeId,
	first_ordinal: Int,
) -> Result[List[ParsedTypeExpr], LegacyAdapterError]:
	row ?= node_at(reader, node)
	collected(range(first_ordinal, row.children.count).map(
		pure func(ordinal): legacy_child_type(reader, node, ordinal),
	))


private pure func legacy_dimension_binary(
	reader: DeclarationReader,
	operator: ParsedDimBinaryOp,
	node: NodeId,
) -> Result[ParsedTypeExpr, LegacyAdapterError]:
	row ?= node_at(reader, node)
	left ?= legacy_child_type(reader, node, 0)
	right ?= legacy_child_type(reader, node, 1)
	Ok(ParsedDimBinaryType(operator, left, right, legacy_location(row.span)))


private pure func legacy_function_type(
	reader: DeclarationReader,
	is_pure: Bool,
	node: NodeId,
) -> Result[ParsedTypeExpr, LegacyAdapterError]:
	row ?= node_at(reader, node)
	parameter_count: Int = row.children.count - 1
	parameters ?= collected(range(0, parameter_count).map(
		pure func(ordinal): legacy_child_type(reader, node, ordinal),
	))
	return_type ?= legacy_child_type(reader, node, parameter_count)
	Ok(ParsedFunctionType(is_pure, parameters, return_type, legacy_location(row.span)))


---
Bound `ordinal` of a bounded type: a `TypeBoundNode`, or a `QualifiedTypeBoundNode`
over its qualifier.
---
private pure func legacy_inline_bound(
	reader: DeclarationReader,
	bounded: NodeId,
	ordinal: Int,
) -> Result[ParsedTraitReference, LegacyAdapterError]:
	node ?= child_node(reader, bounded, ordinal)
	row ?= node_at(reader, node)
	trait_name: TableNameId = name_id_at_row(row.payload)

	match row.kind:
		Kinds.QualifiedTypeBoundNode:
			qualifier_node ?= child_node(reader, node, 0)
			qualifier ?= node_at(reader, qualifier_node)
			Ok({
				qualifier = Some(
					legacy_identifier(
						reader,
						name_id_at_row(qualifier.payload),
						qualifier.span,
					),
				),
				name = legacy_identifier(
					reader,
					trait_name,
					Tables.node_name_span(reader.tables, node),
				),
				span = legacy_location(row.span),
			})
		Kinds.TypeBoundNode:
			Ok({
				qualifier = None,
				name = legacy_identifier(reader, trait_name, row.span),
				span = legacy_location(row.span),
			})
		_:
			Err(NotAWrittenType(node_id_index(node)))


-- Type parameters, bounds and parameters.
private pure func legacy_trait_reference(
	reader: DeclarationReader,
	name: TableNameId,
	name_span: Span,
	qualifier: Option[(TableNameId, Span)],
	span: Span,
) -> ParsedTraitReference:
	{
		qualifier = qualifier.map(
			pure func(written): legacy_identifier(reader, written[0], written[1]),
		),
		name = legacy_identifier(reader, name, name_span),
		span = legacy_location(span)
	}


private pure func legacy_bound(
	reader: DeclarationReader,
	bound_row: Int,
) -> Result[ParsedTraitReference, LegacyAdapterError]:
	bound ?= present(
		Tables.bound_row_at(reader.tables, bound_row),
		BoundTable,
		bound_row,
	)

	qualifier: Option[(TableNameId, Span)] = match Tables.bound_qualifier(
		reader.tables,
		bound_id_at_row(bound_row),
	):
		Some(written):
			Some((written.qualifier, written.span))
		None:
			None

	Ok(legacy_trait_reference(reader, bound.trait_name, bound.name_span, qualifier, bound.span))


private pure func legacy_supertrait(
	reader: DeclarationReader,
	supertrait_row: Int,
) -> Result[ParsedTraitReference, LegacyAdapterError]:
	supertrait ?= present(
		Tables.supertrait_row_at(reader.tables, supertrait_row),
		SupertraitTable,
		supertrait_row,
	)

	qualifier: Option[(TableNameId, Span)] = match Tables.supertrait_qualifier(
		reader.tables,
		supertrait_id_at_row(supertrait_row),
	):
		Some(written):
			Some((written.qualifier, written.span))
		None:
			None

	Ok(
		legacy_trait_reference(
			reader,
			supertrait.name,
			supertrait.name_span,
			qualifier,
			supertrait.span,
		),
	)


private pure func legacy_type_parameters(
	reader: DeclarationReader,
	definition: Int,
) -> Result[List[ParsedTypeParamDecl], LegacyAdapterError]:
	rows ?= rows_of(reader.type_parameters, definition, TypeParameterTable)
	bound_rows ?= rows_of(reader.bounds, definition, BoundTable)
	collected(rows.map(
		pure func(row): legacy_type_parameter(reader, bound_rows, row),
	))


private pure func legacy_type_parameter(
	reader: DeclarationReader,
	bound_rows: List[Int],
	row: Int,
) -> Result[ParsedTypeParamDecl, LegacyAdapterError]:
	parameter ?= present(
		Tables.type_parameter_row_at(reader.tables, row),
		TypeParameterTable,
		row,
	)
	name ?= legacy_type_parameter_name(reader, parameter.name, parameter.kind, parameter.name_span)
	bounds ?= collected(bound_rows.filter(
		pure func(bound_row): bound_is_on_parameter(reader, bound_row, parameter.ordinal),
	).map(
		pure func(bound_row): legacy_bound(reader, bound_row),
	))

	kind: ParsedTypeParamKind = match parameter.kind:
		Kinds.TypeParameter:
			ParsedTypeParameter
		_:
			ParsedDimensionParameter

	Ok({
		name = name,
		kind = kind,
		bounds = bounds,
		span = legacy_location(parameter.span),
	})


private pure func legacy_type_parameter_name(
	reader: DeclarationReader,
	name: TableNameId,
	kind: Kinds.TypeParameterKind,
	span: Span,
) -> Result[ParsedIdentifier, LegacyAdapterError]:
	match kind:
		Kinds.TypeParameter:
			Ok(legacy_identifier(reader, name, span))
		Kinds.DimensionParameter:
			legacy_dimension_identifier(reader, name, span)
		Kinds.WildcardDimensionParameter:
			Ok(legacy_identifier(reader, name, span))


private pure func bound_is_on_parameter(
	reader: DeclarationReader,
	bound_row: Int,
	ordinal: Int,
) -> Bool:
	match Tables.bound_row_at(reader.tables, bound_row):
		Some(bound):
			bound.parameter_ordinal == ordinal
		None:
			False


private pure func legacy_params(
	reader: DeclarationReader,
	definition: Int,
) -> Result[List[ParsedParam], LegacyAdapterError]:
	signature ?= signature_of_definition(reader, definition)
	collected(range(
		signature.parameters.first,
		signature.parameters.first + signature.parameters.count,
	).map(
		pure func(parameter_row): legacy_param(reader, parameter_row),
	))


private pure func legacy_param(
	reader: DeclarationReader,
	parameter_row: Int,
) -> Result[ParsedParam, LegacyAdapterError]:
	parameter ?= present(
		Tables.parameter_row_at(reader.tables, parameter_row),
		ParameterTable,
		parameter_row,
	)
	names ?= collected(range(
		parameter.binder_names.first,
		parameter.binder_names.first + parameter.binder_names.count,
	).map(
		pure func(name_row): legacy_binder_name(reader, name_row),
	))
	binder ?= legacy_binder(parameter.binder, names, parameter_row, parameter.binder_span)
	type_row ?= optional_row(reader.parameter_type_of, parameter_row, ParameterTypeTable)
	type_expr ?= legacy_parameter_type(reader, type_row)

	Ok({
		binder = binder,
		type_expr = type_expr,
		span = legacy_location(parameter.span),
	})


private pure func legacy_binder(
	binder: Kinds.ParameterBinder,
	names: List[ParsedIdentifier],
	parameter_row: Int,
	binder_span: Span,
) -> Result[ParsedParamBinder, LegacyAdapterError]:
	match binder:
		Kinds.NamedParameterBinder:
			name ?= present(
				names.get(0),
				BinderNameTable,
				parameter_row,
			)
			Ok(ParsedParamNameBinder(name))
		Kinds.WildcardParameterBinder:
			Ok(ParsedParamWildcardBinder(legacy_location(binder_span)))
		Kinds.TupleParameterBinder:
			Ok(ParsedParamTupleBinder(names, legacy_location(binder_span)))


private pure func legacy_parameter_type(
	reader: DeclarationReader,
	type_row: Option[Int],
) -> Result[Option[ParsedTypeExpr], LegacyAdapterError]:
	match type_row:
		Some(row):
			declared ?= present(
				Tables.parameter_type_row_at(reader.tables, row),
				ParameterTypeTable,
				row,
			)
			written ?= legacy_type(reader, declared.type_root)
			Ok(Some(written))
		None:
			Ok(None)


private pure func legacy_binder_name(
	reader: DeclarationReader,
	name_row: Int,
) -> Result[ParsedIdentifier, LegacyAdapterError]:
	binder ?= present(
		Tables.binder_name_row_at(reader.tables, name_row),
		BinderNameTable,
		name_row,
	)
	Ok(legacy_identifier(reader, binder.name, binder.span))


---
The definition's one written type, if it has one.
---
private pure func legacy_definition_type(
	reader: DeclarationReader,
	definition: Int,
) -> Result[Option[ParsedTypeExpr], LegacyAdapterError]:
	type_row ?= optional_row(reader.definition_type_of, definition, DefinitionTypeTable)

	match type_row:
		Some(row):
			declared ?= present(
				Tables.definition_type_row_at(reader.tables, row),
				DefinitionTypeTable,
				row,
			)
			written ?= legacy_type(reader, declared.type_root)
			Ok(Some(written))
		None:
			Ok(None)


---
The definition's written type where the language requires one: the parser
appends a (possibly missing) type node there, so a definition without a row is
an error.
---
private pure func legacy_required_type(
	reader: DeclarationReader,
	definition: Int,
) -> Result[ParsedTypeExpr, LegacyAdapterError]:
	declared ?= legacy_definition_type(reader, definition)
	present(declared, DefinitionTypeTable, definition)


private pure func legacy_documentation(
	reader: DeclarationReader,
	definition: Int,
) -> Result[Option[String], LegacyAdapterError]:
	documentation_row ?= optional_row(reader.documentation_of, definition, DocumentationTable)

	match documentation_row:
		Some(row):
			documentation ?= present(
				Tables.documentation_row_at(reader.tables, row),
				DocumentationTable,
				row,
			)
			Ok(Some(literal_string(reader, documentation.text)))
		None:
			Ok(None)


private pure func legacy_annotations(
	reader: DeclarationReader,
	definition: Int,
) -> Result[List[ParsedFunctionAnnotation], LegacyAdapterError]:
	rows ?= rows_of(reader.annotations, definition, AnnotationTable)
	collected(rows.map(
		pure func(row): legacy_annotation(reader, row),
	))


private pure func legacy_annotation(
	reader: DeclarationReader,
	row: Int,
) -> Result[ParsedFunctionAnnotation, LegacyAdapterError]:
	annotation ?= present(
		Tables.annotation_row_at(reader.tables, row),
		AnnotationTable,
		row,
	)

	match annotation.annotation:
		Kinds.TailRecursiveAnnotation:
			Ok(ParsedTailRecursiveAnnotation)
		Kinds.NoCopyAnnotation:
			Ok(ParsedNoCopyAnnotation)
		Kinds.DebugOnlyAnnotation:
			Ok(ParsedDebugOnlyAnnotation)
		Kinds.ResourceResultOrdinaryAnnotation:
			Ok(ParsedResourceResultOrdinaryAnnotation)


private pure func signature_of_definition(
	reader: DeclarationReader,
	definition: Int,
) -> Result[SignatureRow, LegacyAdapterError]:
	signature_row ?= required_row(reader.signature_of, definition, SignatureTable)
	present(
		Tables.signature_row_at(reader.tables, signature_row),
		SignatureTable,
		signature_row,
	)


---
The body of `definition` when it has one.
---
private pure func legacy_body(
	reader: DeclarationReader,
	bodies: ModuleBodies,
	definition: Int,
) -> Result[Option[ParsedExpr], LegacyAdapterError]:
	body_row ?= optional_row(reader.body_of, definition, BodyTable)

	match body_row:
		Some(row):
			root ?= body_expression(reader, bodies, row)
			Ok(Some(root))
		None:
			Ok(None)


---
The expression rooted at body row `body_row`'s root.
---
private pure func body_expression(
	reader: DeclarationReader,
	bodies: ModuleBodies,
	body_row: Int,
) -> Result[ParsedExpr, LegacyAdapterError]:
	body ?= present(
		Tables.body_row_at(reader.tables, body_row),
		BodyTable,
		body_row,
	)
	root: Int = node_id_index(body.root)
	value ?= present(
		bodies.built.get(root - bodies.first_node),
		NodeTable,
		root,
	)

	match value:
		BuiltExpression(expression):
			Ok(expression)
		_:
			Err(BodyRootNotAnExpression(root))


-- Bodies.
---
What the pass over a module's nodes holds for one node. A parent takes its
children's values by kind, so each kind a parent can take is one variant;
`legacy_expression_child` and its siblings turn a child of another variant
into `MalformedNode`. A written type is not rebuilt in the pass: its parent
reads it with `legacy_type` when it needs it, so `BuiltTypeNode` only says
that the child is one.
---
private union BuiltNode:
	BuiltExpression(ParsedExpr)
	BuiltPattern(ParsedPattern)
	BuiltTypeNode
	BuiltInterpolationText(String)
	BuiltInterpolationHole(ParsedExpr, SourceLocation)
	BuiltRecordField(ParsedRecordExprField)
	BuiltDictEntry(ParsedDictEntry)
	BuiltMatchCase(ParsedMatchCase)
	BuiltSelectArm(ParsedSelectArm)
	BuiltLambdaParameter(ParsedLambdaParam)
	BuiltBinder(ParsedIdentifier)
	BuiltTupleBinder(List[ParsedIdentifier], SourceLocation)
	BuiltConcurrentParameter(ConcurrentParameterValue)
	BuiltWithBinding(ParsedWithBinding)
	BuiltWithErrorMap(ParsedWithErrorMap)
	BuiltQualifier(ParsedIdentifier)
	BuiltListSpread(ParsedListPatternSpread)
	NotYetBuilt


---
A `name: value` parameter of a `concurrent` block or `concurrently(...)`; `name`
is compared with the vocabulary's `max_threads`, `limit` and `timeout`, and
`count` is the integer the stage read from a `max_threads` or `limit` literal.
---
private record ConcurrentParameterValue {
	name: TableNameId,
	value: ParsedExpr,
	count: Option[Int]
}


---
The rebuilt nodes of one module: `built[i]` is the value of node `first_node + i`.
---
private record ModuleBodies {
	first_node: Int,
	built: List[BuiltNode]
}


---
The node being rebuilt, as its pass sees it: its position in the table, its
row, the position of the module's first node, its span as a location, and the
span of the name it carries (its own span unless a `NodeNameSpanRow` says the
name is narrower).
---
private fixed record NodeView {
	index: Int,
	first_node: Int,
	row: NodeRow,
	location: SourceLocation,
	name_span: Span
}


---
Rebuilds the nodes of `module_row` in table order. The table is post-order,
so each node's children are rebuilt before it is and the pass is one forward
walk: no routine recurses over a body, and a body nested as deep as the
source allows costs the same as a flat one. Values are kept by node position
rather than on a stack because a local function's signature and body roots sit
between the siblings of the statements around it, which a stack would have to
skip.
---
private pure func legacy_module_bodies(
	reader: DeclarationReader,
	module_row: ModuleRow,
) -> Result[ModuleBodies, LegacyAdapterError]:
	first_node: Int = module_row.nodes.first
	count: Int = module_row.nodes.count
	var built: List[BuiltNode] = repeat(NotYetBuilt, count)
	var position: Int = 0
	var failure: Option[LegacyAdapterError] = None
	name_row_count: Int = Tables.node_name_span_count(reader.tables)
	var name_row: Int = first_name_span_row(reader, first_node)

	while failure.is_none() and position < count:
		index: Int = first_node + position
		row: NodeRow = Tables.node_row(reader.tables, node_id_at_row(index))
		var name_span: Span = row.span

		if (
			name_row < name_row_count
			and Tables.node_name_span_row_node(reader.tables, name_row) == index
		):
			match Tables.node_name_span_row_span(reader.tables, name_row):
				Some(written):
					name_span = written
				None:
					failure = Some(MissingTableRow(NodeNameSpanTable, name_row))

			name_row += 1
		else if needs_name_span_row(row.kind, row.children.count):
			-- The node's name is narrower than the node, so its span is a row's.
			failure = Some(MissingTableRow(NodeNameSpanTable, index))

		view: NodeView = {
			index = index,
			first_node = first_node,
			row = row,
			location = legacy_location(row.span),
			name_span = name_span
		}

		match legacy_node(reader, built, view):
			Ok(value):
				built = built.set(position, value)
			Err(error):
				failure = Some(error)

		position += 1

	match failure:
		Some(error):
			Err(error)
		None:
			Ok({
				first_node = first_node,
				built = built,
			})


---
The first name span row that belongs to a node at or after `first_node`: a binary
search over the rows, which are sorted by node.
---
private pure func first_name_span_row(reader: DeclarationReader, first_node: Int) -> Int:
	var low: Int = 0
	var high: Int = Tables.node_name_span_count(reader.tables)

	while low < high:
		middle: Int = (low + high) / 2

		if Tables.node_name_span_row_node(reader.tables, middle) < first_node:
			low = middle + 1
		else:
			high = middle

	low


private pure func malformed(view: NodeView) -> LegacyAdapterError:
	MalformedNode(view.index, view.row.kind)


---
The id of child `ordinal` of the node.
---
private pure func child_id(
	reader: DeclarationReader,
	view: NodeView,
	ordinal: Int,
) -> Result[NodeId, LegacyAdapterError]:
	if ordinal < 0 or ordinal >= view.row.children.count:
		Err(malformed(view))
	else:
		slot: Int = view.row.children.first + ordinal
		present(
			Tables.node_child_row_at(reader.tables, slot),
			NodeChildTable,
			slot,
		)


---
The value of child `ordinal` of the node. Total: a child that has no row, or
that the pass has not reached, is `NotYetBuilt`, which no parent takes, so the
parent reports `MalformedNode`. The freeze invariants rule both out for a table
the stage froze (a child's edge is in range and the child precedes its parent),
and a lookup that cannot fail does not need a `Result` per child.
---
private pure func child_value(
	reader: DeclarationReader,
	built: List[BuiltNode],
	view: NodeView,
	ordinal: Int,
) -> BuiltNode:
	if ordinal < 0 or ordinal >= view.row.children.count:
		NotYetBuilt
	else:
		match Tables.node_child_row_at(reader.tables, view.row.children.first + ordinal):
			Some(child):
				built.get_or(node_id_index(child) - view.first_node, NotYetBuilt)
			None:
				NotYetBuilt


private pure func child_expression(
	reader: DeclarationReader,
	built: List[BuiltNode],
	view: NodeView,
	ordinal: Int,
) -> Result[ParsedExpr, LegacyAdapterError]:
	match child_value(reader, built, view, ordinal):
		BuiltExpression(expression):
			Ok(expression)
		_:
			Err(malformed(view))


private pure func child_pattern(
	reader: DeclarationReader,
	built: List[BuiltNode],
	view: NodeView,
	ordinal: Int,
) -> Result[ParsedPattern, LegacyAdapterError]:
	match child_value(reader, built, view, ordinal):
		BuiltPattern(pattern):
			Ok(pattern)
		_:
			Err(malformed(view))


---
The written type of child `ordinal`.
---
private pure func child_written_type(
	reader: DeclarationReader,
	view: NodeView,
	ordinal: Int,
) -> Result[ParsedTypeExpr, LegacyAdapterError]:
	child ?= child_id(reader, view, ordinal)
	legacy_type(reader, child)


---
Whether child `ordinal` is a written type.
---
private pure func child_is_type(
	reader: DeclarationReader,
	built: List[BuiltNode],
	view: NodeView,
	ordinal: Int,
) -> Result[Bool, LegacyAdapterError]:
	match child_value(reader, built, view, ordinal):
		BuiltTypeNode:
			Ok(True)
		_:
			Ok(False)


---
The values of children `first_ordinal` up to (not including) `end_ordinal` that
`extract` takes; a child it does not take is `MalformedNode`. A loop with a
failure variable, not `?=`, which a loop body may not use.
---
private pure func collected_children[T](
	reader: DeclarationReader,
	built: List[BuiltNode],
	view: NodeView,
	first_ordinal: Int,
	end_ordinal: Int,
	extract: pure (BuiltNode) -> Option[T],
) -> Result[List[T], LegacyAdapterError]:
	var items: List[T] = []
	var failure: Option[LegacyAdapterError] = None
	var ordinal: Int = first_ordinal

	while failure.is_none() and ordinal < end_ordinal:
		match extract(child_value(reader, built, view, ordinal)):
			Some(item):
				items = items.append(item)
			None:
				failure = Some(malformed(view))

		ordinal += 1

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(items)


private pure func as_expression(value: BuiltNode) -> Option[ParsedExpr]:
	match value:
		BuiltExpression(expression):
			Some(expression)
		_:
			None


private pure func as_pattern(value: BuiltNode) -> Option[ParsedPattern]:
	match value:
		BuiltPattern(found):
			Some(found)
		_:
			None


private pure func as_interpolation_part(value: BuiltNode) -> Option[ParsedStringInterpolationPart]:
	match value:
		BuiltInterpolationText(text):
			Some(ParsedInterpolationLiteral(text))
		BuiltInterpolationHole(hole, extent):
			Some(ParsedInterpolationExpr(hole, extent))
		_:
			None


private pure func as_record_field(value: BuiltNode) -> Option[ParsedRecordExprField]:
	match value:
		BuiltRecordField(field):
			Some(field)
		_:
			None


private pure func as_dict_entry(value: BuiltNode) -> Option[ParsedDictEntry]:
	match value:
		BuiltDictEntry(entry):
			Some(entry)
		_:
			None


private pure func as_match_case(value: BuiltNode) -> Option[ParsedMatchCase]:
	match value:
		BuiltMatchCase(found):
			Some(found)
		_:
			None


private pure func as_select_arm(value: BuiltNode) -> Option[ParsedSelectArm]:
	match value:
		BuiltSelectArm(arm):
			Some(arm)
		_:
			None


private pure func as_lambda_parameter(value: BuiltNode) -> Option[ParsedLambdaParam]:
	match value:
		BuiltLambdaParameter(parameter):
			Some(parameter)
		_:
			None


private pure func as_binder(value: BuiltNode) -> Option[ParsedIdentifier]:
	match value:
		BuiltBinder(identifier):
			Some(identifier)
		_:
			None


private pure func as_concurrent_parameter(value: BuiltNode) -> Option[ConcurrentParameterValue]:
	match value:
		BuiltConcurrentParameter(parameter):
			Some(parameter)
		_:
			None


private pure func child_expressions(
	reader: DeclarationReader,
	built: List[BuiltNode],
	view: NodeView,
	first_ordinal: Int,
	end_ordinal: Int,
) -> Result[List[ParsedExpr], LegacyAdapterError]:
	collected_children(reader, built, view, first_ordinal, end_ordinal, as_expression)


---
The span of the name a node carries (see `NodeNameSpanRow`) as a location.
---
private pure func node_name_location(view: NodeView) -> SourceLocation:
	legacy_location(view.name_span)


---
The identifier a node names: its payload, spelled over the node's name span.
---
private pure func node_identifier(reader: DeclarationReader, view: NodeView) -> ParsedIdentifier:
	legacy_identifier(reader, name_id_at_row(view.row.payload), view.name_span)


---
The identifier a node names when the node is the name alone.
---
private pure func whole_node_identifier(
	reader: DeclarationReader,
	view: NodeView,
) -> ParsedIdentifier:
	legacy_identifier(reader, name_id_at_row(view.row.payload), view.row.span)


private pure func node_literal(reader: DeclarationReader, view: NodeView) -> String:
	literal_string(reader, literal_id_at_row(view.row.payload))


private pure func expression(value: ParsedExpr) -> Result[BuiltNode, LegacyAdapterError]:
	Ok(BuiltExpression(value))


private pure func pattern(value: ParsedPattern) -> Result[BuiltNode, LegacyAdapterError]:
	Ok(BuiltPattern(value))


---
The value of one node, from the values of its children.
---
private pure func legacy_node(
	reader: DeclarationReader,
	built: List[BuiltNode],
	view: NodeView,
) -> Result[BuiltNode, LegacyAdapterError]:
	location: SourceLocation = view.location

	match view.row.kind:
		Kinds.IdentifierNode:
			expression(ParsedNameExpr(whole_node_identifier(reader, view)))
		Kinds.IntegerLiteralNode:
			expression(ParsedIntLiteralExpr(node_literal(reader, view), location))
		Kinds.FloatLiteralNode:
			expression(ParsedFloatLiteralExpr(node_literal(reader, view), location))
		Kinds.StringLiteralNode:
			expression(
				ParsedStringLiteralExpr(
					node_literal(reader, view),
					ParsedPlainStringLiteral,
					location,
				),
			)
		Kinds.RawStringLiteralNode:
			expression(
				ParsedStringLiteralExpr(
					node_literal(reader, view),
					ParsedRawStringLiteral,
					location,
				),
			)
		Kinds.PipeStringLiteralNode:
			expression(
				ParsedStringLiteralExpr(
					node_literal(reader, view),
					ParsedPipeStringLiteral,
					location,
				),
			)
		Kinds.RawPipeStringLiteralNode:
			expression(
				ParsedStringLiteralExpr(
					node_literal(reader, view),
					ParsedRawPipeStringLiteral,
					location,
				),
			)
		Kinds.InterpolatedStringNode:
			legacy_interpolated_string(reader, built, view, False)
		Kinds.InterpolatedPipeStringNode:
			legacy_interpolated_string(reader, built, view, True)
		Kinds.InterpolationTextNode:
			Ok(BuiltInterpolationText(node_literal(reader, view)))
		Kinds.InterpolationHoleNode:
			hole ?= child_expression(reader, built, view, 0)
			Ok(BuiltInterpolationHole(hole, location))
		Kinds.TrueLiteralNode:
			expression(ParsedBoolLiteralExpr(True, location))
		Kinds.FalseLiteralNode:
			expression(ParsedBoolLiteralExpr(False, location))
		Kinds.CharLiteralNode:
			expression(ParsedCharLiteralExpr(view.row.payload, location))
		Kinds.NegateNode:
			operand ?= child_expression(reader, built, view, 0)
			expression(ParsedUnaryExpr(ParsedNegateOp, operand, location))
		Kinds.NotNode:
			operand ?= child_expression(reader, built, view, 0)
			expression(ParsedUnaryExpr(ParsedNotOp, operand, location))
		Kinds.DetachNode:
			operand ?= child_expression(reader, built, view, 0)
			expression(ParsedDetachExpr(operand, location))
		Kinds.AddNode:
			legacy_binary(reader, built, view, ParsedAddOp)
		Kinds.SubtractNode:
			legacy_binary(reader, built, view, ParsedSubtractOp)
		Kinds.MultiplyNode:
			legacy_binary(reader, built, view, ParsedMultiplyOp)
		Kinds.DivideNode:
			legacy_binary(reader, built, view, ParsedDivideOp)
		Kinds.ModuloNode:
			legacy_binary(reader, built, view, ParsedModuloOp)
		Kinds.EqualNode:
			legacy_binary(reader, built, view, ParsedEqualOp)
		Kinds.NotEqualNode:
			legacy_binary(reader, built, view, ParsedNotEqualOp)
		Kinds.LessNode:
			legacy_binary(reader, built, view, ParsedLessOp)
		Kinds.LessEqualNode:
			legacy_binary(reader, built, view, ParsedLessEqualOp)
		Kinds.GreaterNode:
			legacy_binary(reader, built, view, ParsedGreaterOp)
		Kinds.GreaterEqualNode:
			legacy_binary(reader, built, view, ParsedGreaterEqualOp)
		Kinds.AndNode:
			legacy_logical(reader, built, view, ParsedAndOp)
		Kinds.OrNode:
			legacy_logical(reader, built, view, ParsedOrOp)
		Kinds.RangeNode:
			left ?= child_expression(reader, built, view, 0)
			right ?= child_expression(reader, built, view, 1)
			expression(ParsedRangeExpr(left, right, location))
		Kinds.CallNode:
			callee ?= child_expression(reader, built, view, 0)
			arguments ?= child_expressions(reader, built, view, 1, view.row.children.count)
			expression(ParsedCallExpr(callee, arguments, location))
		Kinds.FieldAccessNode:
			receiver ?= child_expression(reader, built, view, 0)
			expression(ParsedFieldAccessExpr(receiver, node_identifier(reader, view), location))
		Kinds.SubscriptNode:
			target ?= child_expression(reader, built, view, 0)
			indices ?= child_expressions(reader, built, view, 1, view.row.children.count)
			expression(ParsedSubscriptExpr(target, indices, location))
		Kinds.ListLiteralNode:
			items ?= child_expressions(reader, built, view, 0, view.row.children.count)
			expression(ParsedListExpr(items, location))
		Kinds.TupleNode:
			items ?= child_expressions(reader, built, view, 0, view.row.children.count)
			expression(ParsedTupleExpr(items, location))
		Kinds.VectorLiteralNode:
			items ?= child_expressions(reader, built, view, 0, view.row.children.count)
			expression(ParsedVectorExpr(items, location))
		Kinds.RecordLiteralNode:
			fields ?= legacy_record_fields(reader, built, view, 0)
			expression(ParsedRecordExpr(fields, location))
		Kinds.RecordUpdateNode:
			base ?= child_expression(reader, built, view, 0)
			fields ?= legacy_record_fields(reader, built, view, 1)
			expression(ParsedRecordUpdateExpr(base, fields, location))
		Kinds.RecordFieldNode:
			value ?= child_expression(reader, built, view, 0)
			Ok(BuiltRecordField({
				name = node_identifier(reader, view),
				value = value,
				span = location,
			}))
		Kinds.DictLiteralNode:
			entries ?= collected_children(
				reader,
				built,
				view,
				0,
				view.row.children.count,
				as_dict_entry,
			)
			expression(ParsedDictExpr(entries, location))
		Kinds.DictEntryNode:
			key ?= child_expression(reader, built, view, 0)
			value ?= child_expression(reader, built, view, 1)
			Ok(BuiltDictEntry({
				key = key,
				value = value,
				span = location,
			}))
		Kinds.IntoOpaqueNode:
			written ?= child_written_type(reader, view, 0)
			value ?= child_expression(reader, built, view, 1)
			expression(ParsedOpaqueIntoExpr(written, value, location))
		Kinds.FromOpaqueNode:
			written ?= child_written_type(reader, view, 0)
			value ?= child_expression(reader, built, view, 1)
			expression(ParsedOpaqueFromExpr(written, value, location))
		Kinds.BlockNode:
			items ?= child_expressions(reader, built, view, 0, view.row.children.count)
			expression(ParsedBlockExpr(items, location))
		Kinds.IfNode:
			legacy_if(reader, built, view)
		Kinds.MatchNode:
			scrutinee ?= child_expression(reader, built, view, 0)
			cases ?= collected_children(
				reader,
				built,
				view,
				1,
				view.row.children.count,
				as_match_case,
			)
			expression(ParsedMatchExpr(scrutinee, cases, location))
		Kinds.MatchCaseNode:
			case_pattern ?= child_pattern(reader, built, view, 0)
			body ?= child_expression(reader, built, view, 1)
			Ok(BuiltMatchCase({
				pattern = case_pattern,
				body = body,
				span = location,
			}))
		Kinds.SelectNode:
			arms ?= collected_children(
				reader,
				built,
				view,
				0,
				view.row.children.count,
				as_select_arm,
			)
			expression(ParsedSelectExpr(arms, location))
		Kinds.SelectReceiveArmNode:
			channel ?= child_expression(reader, built, view, 0)
			body ?= child_expression(reader, built, view, 1)
			Ok(BuiltSelectArm({
				kind = ParsedSelectReceiveArm(
					node_identifier(reader, view),
					channel,
				),
				body = body,
				span = location,
			}))
		Kinds.SelectSealedArmNode:
			channel ?= child_expression(reader, built, view, 0)
			body ?= child_expression(reader, built, view, 1)
			Ok(BuiltSelectArm({
				kind = ParsedSelectSealedArm(channel),
				body = body,
				span = location,
			}))
		Kinds.SelectAfterArmNode:
			timeout ?= child_expression(reader, built, view, 0)
			body ?= child_expression(reader, built, view, 1)
			Ok(BuiltSelectArm({
				kind = ParsedSelectAfterArm(timeout),
				body = body,
				span = location,
			}))
		Kinds.WithNode:
			body ?= child_expression(reader, built, view, 1)

			match child_value(reader, built, view, 0):
				BuiltWithBinding(binding):
					expression(ParsedWithExpr(binding, body, location))
				_:
					Err(malformed(view))
		Kinds.WithBindingNode:
			legacy_with_binding(reader, built, view, ParsedWithPlainBinding)
		Kinds.WithTryBindingNode:
			legacy_with_binding(reader, built, view, ParsedWithTryBinding)
		Kinds.WithErrorMapNode:
			value ?= child_expression(reader, built, view, 0)
			Ok(BuiltWithErrorMap({
				name = node_identifier(reader, view),
				value = value,
				span = location,
			}))
		Kinds.DebugBlockNode:
			body ?= child_expression(reader, built, view, 0)
			expression(ParsedDebugBlockExpr(body, location))
		Kinds.LambdaNode:
			legacy_lambda(reader, built, view, False)
		Kinds.PureLambdaNode:
			legacy_lambda(reader, built, view, True)
		Kinds.LambdaParameterNode:
			legacy_lambda_parameter(reader, view)
		Kinds.LocalFunctionNode:
			legacy_local_function(reader, built, view)
		Kinds.WhileNode:
			condition ?= child_expression(reader, built, view, 0)
			body ?= child_expression(reader, built, view, 1)
			expression(ParsedWhileExpr(condition, body, location))
		Kinds.ForNode:
			legacy_for(reader, built, view)
		Kinds.LoopBinderNode:
			Ok(BuiltBinder(whole_node_identifier(reader, view)))
		Kinds.TupleLoopBinderNode:
			names ?= legacy_binder_names(reader, built, view, view.row.children.count)
			Ok(BuiltTupleBinder(names, location))
		Kinds.ConcurrentForNode:
			legacy_concurrent_for(reader, built, view)
		Kinds.ConcurrentBlockNode:
			legacy_concurrent_block(reader, built, view)
		Kinds.ConcurrentParameterNode:
			value ?= child_expression(reader, built, view, 0)
			Ok(BuiltConcurrentParameter({
				name = name_id_at_row(view.row.payload),
				value = value,
				count = Tables.concurrency_count(reader.tables, node_id_at_row(view.index)),
			}))
		Kinds.BreakNode:
			expression(ParsedBreakExpr(location))
		Kinds.ContinueNode:
			expression(ParsedContinueExpr(location))
		Kinds.VoidNode:
			expression(ParsedVoidExpr(location))
		Kinds.BuiltinNode:
			expression(ParsedBuiltinExpr(None, location))
		Kinds.NamedBuiltinNode:
			expression(ParsedBuiltinExpr(Some(node_literal(reader, view)), location))
		Kinds.MissingExpressionNode:
			expression(ParsedMissingExpr(location))
		Kinds.VarDeclarationNode:
			legacy_binding(reader, built, view, True)
		Kinds.TypedBindingNode:
			legacy_binding(reader, built, view, False)
		Kinds.AssignmentNode:
			value ?= child_expression(reader, built, view, 0)
			expression(ParsedAssignExpr(node_identifier(reader, view), value, location))
		Kinds.QuestionBindNode:
			legacy_question_bind(reader, built, view)
		Kinds.AddAssignNode:
			legacy_compound_assignment(reader, built, view, ParsedAssignAddOp)
		Kinds.SubtractAssignNode:
			legacy_compound_assignment(reader, built, view, ParsedAssignSubtractOp)
		Kinds.MultiplyAssignNode:
			legacy_compound_assignment(reader, built, view, ParsedAssignMultiplyOp)
		Kinds.DivideAssignNode:
			legacy_compound_assignment(reader, built, view, ParsedAssignDivideOp)
		Kinds.SubscriptAssignmentNode:
			legacy_subscript_assignment(reader, built, view)
		Kinds.TupleDestructureNode:
			value_ordinal: Int = view.row.children.count - 1
			names ?= legacy_binder_names(reader, built, view, value_ordinal)
			value ?= child_expression(reader, built, view, value_ordinal)
			expression(ParsedTupleDestructExpr(names, value, location))
		Kinds.DestructureBinderNode:
			Ok(BuiltBinder(whole_node_identifier(reader, view)))
		Kinds.WildcardPatternNode:
			pattern(ParsedWildcardPattern(location))
		Kinds.NamePatternNode:
			pattern(ParsedNamePattern(whole_node_identifier(reader, view)))
		Kinds.IntegerPatternNode:
			pattern(ParsedIntPattern(node_literal(reader, view), location))
		Kinds.NegativeIntegerPatternNode:
			pattern(ParsedIntPattern(NEGATIVE_SIGN + node_literal(reader, view), location))
		Kinds.FloatPatternNode:
			pattern(ParsedFloatPattern(node_literal(reader, view), location))
		Kinds.NegativeFloatPatternNode:
			pattern(ParsedFloatPattern(NEGATIVE_SIGN + node_literal(reader, view), location))
		Kinds.StringPatternNode:
			pattern(
				ParsedStringPattern(
					node_literal(reader, view),
					ParsedPlainStringLiteral,
					location,
				),
			)
		Kinds.RawStringPatternNode:
			pattern(
				ParsedStringPattern(
					node_literal(reader, view),
					ParsedRawStringLiteral,
					location,
				),
			)
		Kinds.PipeStringPatternNode:
			pattern(
				ParsedStringPattern(
					node_literal(reader, view),
					ParsedPipeStringLiteral,
					location,
				),
			)
		Kinds.RawPipeStringPatternNode:
			pattern(
				ParsedStringPattern(
					node_literal(reader, view),
					ParsedRawPipeStringLiteral,
					location,
				),
			)
		Kinds.CharPatternNode:
			pattern(ParsedCharPattern(view.row.payload, location))
		Kinds.TruePatternNode:
			pattern(ParsedBoolPattern(True, location))
		Kinds.FalsePatternNode:
			pattern(ParsedBoolPattern(False, location))
		Kinds.ConstructorPatternNode:
			arguments ?= legacy_patterns(reader, built, view, 0)
			pattern(ParsedConstructorPattern(node_identifier(reader, view), arguments, location))
		Kinds.QualifiedConstructorPatternNode:
			arguments ?= legacy_patterns(reader, built, view, 1)

			match child_value(reader, built, view, 0):
				BuiltQualifier(qualifier):
					pattern(
						ParsedQualifiedConstructorPattern(
							qualifier,
							node_identifier(reader, view),
							arguments,
							location,
						),
					)
				_:
					Err(malformed(view))
		Kinds.PatternQualifierNode:
			Ok(BuiltQualifier(whole_node_identifier(reader, view)))
		Kinds.TuplePatternNode:
			elements ?= legacy_patterns(reader, built, view, 0)
			pattern(ParsedTuplePattern(elements, location))
		Kinds.ListPatternNode:
			legacy_list_pattern(reader, built, view)
		Kinds.ListSpreadNameNode:
			Ok(BuiltListSpread(ParsedListSpreadName(node_identifier(reader, view))))
		Kinds.ListSpreadWildcardNode:
			Ok(BuiltListSpread(ParsedListSpreadWildcard(node_name_location(view))))
		Kinds.OrPatternNode:
			alternatives ?= legacy_patterns(reader, built, view, 0)
			pattern(ParsedOrPattern(alternatives, location))
		Kinds.MissingPatternNode:
			pattern(ParsedMissingPattern(location))
		Kinds.NamedTypeNode | Kinds.QualifiedTypeNode | Kinds.TypeQualifierNode | Kinds.BoundedTypeNode | Kinds.TypeBoundNode | Kinds.QualifiedTypeBoundNode | Kinds.DimensionNameTypeNode | Kinds.VariadicDimensionNameTypeNode | Kinds.DimensionWildcardTypeNode | Kinds.VariadicDimensionWildcardTypeNode | Kinds.DimensionLiteralTypeNode | Kinds.DimensionAddTypeNode | Kinds.DimensionSubtractTypeNode | Kinds.DimensionMultiplyTypeNode | Kinds.DimensionDivideTypeNode | Kinds.RangeTypeNode | Kinds.TupleTypeNode | Kinds.FunctionTypeNode | Kinds.PureFunctionTypeNode | Kinds.ArrayTypeNode | Kinds.MissingTypeNode:
			Ok(BuiltTypeNode)


-- Rebuilding constructs from their children.
private pure func legacy_binary(
	reader: DeclarationReader,
	built: List[BuiltNode],
	view: NodeView,
	operator: ParsedBinaryOp,
) -> Result[BuiltNode, LegacyAdapterError]:
	left ?= child_expression(reader, built, view, 0)
	right ?= child_expression(reader, built, view, 1)
	expression(ParsedBinaryExpr(operator, left, right, view.location))


private pure func legacy_logical(
	reader: DeclarationReader,
	built: List[BuiltNode],
	view: NodeView,
	operator: ParsedLogicalOp,
) -> Result[BuiltNode, LegacyAdapterError]:
	left ?= child_expression(reader, built, view, 0)
	right ?= child_expression(reader, built, view, 1)
	expression(ParsedLogicalExpr(operator, left, right, view.location))


---
The parts of an interpolated string: its text pieces and its holes in source
order, as the existing parser has them once the holes are parsed (the finalized
form, `ParsedStringInterpolationPartsExpr`).
---
private pure func legacy_interpolated_string(
	reader: DeclarationReader,
	built: List[BuiltNode],
	view: NodeView,
	is_multiline: Bool,
) -> Result[BuiltNode, LegacyAdapterError]:
	parts ?= collected_children(
		reader,
		built,
		view,
		0,
		view.row.children.count,
		as_interpolation_part,
	)
	expression(ParsedStringInterpolationPartsExpr(parts, is_multiline, view.location))


private pure func legacy_record_fields(
	reader: DeclarationReader,
	built: List[BuiltNode],
	view: NodeView,
	first_ordinal: Int,
) -> Result[List[ParsedRecordExprField], LegacyAdapterError]:
	collected_children(reader, built, view, first_ordinal, view.row.children.count, as_record_field)


private pure func legacy_patterns(
	reader: DeclarationReader,
	built: List[BuiltNode],
	view: NodeView,
	first_ordinal: Int,
) -> Result[List[ParsedPattern], LegacyAdapterError]:
	collected_children(reader, built, view, first_ordinal, view.row.children.count, as_pattern)


---
`[p, ...]`, with its spread when the last child is one.
---
private pure func legacy_list_pattern(
	reader: DeclarationReader,
	built: List[BuiltNode],
	view: NodeView,
) -> Result[BuiltNode, LegacyAdapterError]:
	count: Int = view.row.children.count

	match child_value(reader, built, view, count - 1):
		BuiltListSpread(spread):
			elements ?= collected_children(reader, built, view, 0, count - 1, as_pattern)
			pattern(ParsedListPattern(elements, Some(spread), view.location))
		_:
			elements ?= collected_children(reader, built, view, 0, count, as_pattern)
			pattern(ParsedListPattern(elements, None, view.location))


---
`if condition: then [else ...]`: the else branch, when written, is the third
child, with the `else` keyword's span from the node's keyword row.
---
private pure func legacy_if(
	reader: DeclarationReader,
	built: List[BuiltNode],
	view: NodeView,
) -> Result[BuiltNode, LegacyAdapterError]:
	condition ?= child_expression(reader, built, view, 0)
	then_branch ?= child_expression(reader, built, view, 1)
	else_branch ?= legacy_else_branch(reader, built, view)
	expression(ParsedIfExpr(condition, then_branch, else_branch, view.location))


private pure func legacy_else_branch(
	reader: DeclarationReader,
	built: List[BuiltNode],
	view: NodeView,
) -> Result[Option[ParsedElseBranch], LegacyAdapterError]:
	if view.row.children.count > 2:
		body ?= child_expression(reader, built, view, 2)
		keyword ?= present(
			Tables.else_keyword_span(reader.tables, node_id_at_row(view.index)),
			ElseKeywordTable,
			view.index,
		)
		Ok(Some({
			keyword = legacy_location(keyword),
			body = body,
		}))
	else:
		Ok(None)


---
`with name [: T] = value` or `with name [: T] ?= value [on e => mapped]`: the
type when written, the value, then the error map when written. The type is
told from the value by the child's kind, as the node table documents.
---
private pure func legacy_with_binding(
	reader: DeclarationReader,
	built: List[BuiltNode],
	view: NodeView,
	kind: ParsedWithBindingKind,
) -> Result[BuiltNode, LegacyAdapterError]:
	typed ?= child_is_type(reader, built, view, 0)

	value_ordinal: Int = if typed:
		1
	else:
		0

	type_expr ?= optional_child_type(reader, view, typed)
	value ?= child_expression(reader, built, view, value_ordinal)
	error_map ?= legacy_error_map(reader, built, view, value_ordinal + 1)
	Ok(BuiltWithBinding({
		name = node_identifier(reader, view),
		type_expr = type_expr,
		value = value,
		kind = kind,
		error_map = error_map,
		span = view.location,
	}))


private pure func legacy_error_map(
	reader: DeclarationReader,
	built: List[BuiltNode],
	view: NodeView,
	ordinal: Int,
) -> Result[Option[ParsedWithErrorMap], LegacyAdapterError]:
	if ordinal < view.row.children.count:
		match child_value(reader, built, view, ordinal):
			BuiltWithErrorMap(written):
				Ok(Some(written))
			_:
				Err(malformed(view))
	else:
		Ok(None)


---
The type child 0 when `typed`, which the caller read from the child's kind.
---
private pure func optional_child_type(
	reader: DeclarationReader,
	view: NodeView,
	typed: Bool,
) -> Result[Option[ParsedTypeExpr], LegacyAdapterError]:
	if typed:
		written ?= child_written_type(reader, view, 0)
		Ok(Some(written))
	else:
		Ok(None)


---
`func(params) [-> R]: body`: the parameters, the return type when written, then
the body. The return type is the child before the body when it is a written
type; a parameter is never one.
---
private pure func legacy_lambda(
	reader: DeclarationReader,
	built: List[BuiltNode],
	view: NodeView,
	is_pure: Bool,
) -> Result[BuiltNode, LegacyAdapterError]:
	count: Int = view.row.children.count
	body_ordinal: Int = count - 1
	typed ?= lambda_has_return_type(reader, built, view)

	parameter_end: Int = if typed:
		body_ordinal - 1
	else:
		body_ordinal

	parameters ?= collected_children(reader, built, view, 0, parameter_end, as_lambda_parameter)
	return_type ?= optional_return_type(reader, view, typed, body_ordinal - 1)
	body ?= child_expression(reader, built, view, body_ordinal)
	expression(ParsedLambdaExpr(is_pure, parameters, return_type, body, view.location))


private pure func lambda_has_return_type(
	reader: DeclarationReader,
	built: List[BuiltNode],
	view: NodeView,
) -> Result[Bool, LegacyAdapterError]:
	count: Int = view.row.children.count

	if count < 2:
		Ok(False)
	else:
		child_is_type(reader, built, view, count - 2)


private pure func optional_return_type(
	reader: DeclarationReader,
	view: NodeView,
	typed: Bool,
	ordinal: Int,
) -> Result[Option[ParsedTypeExpr], LegacyAdapterError]:
	if typed:
		written ?= child_written_type(reader, view, ordinal)
		Ok(Some(written))
	else:
		Ok(None)


private pure func legacy_lambda_parameter(
	reader: DeclarationReader,
	view: NodeView,
) -> Result[BuiltNode, LegacyAdapterError]:
	type_expr ?= optional_child_type(reader, view, view.row.children.count > 0)
	Ok(BuiltLambdaParameter({
		name = node_identifier(reader, view),
		type_expr = type_expr,
		span = view.location,
	}))


---
A function declared in a body. Its signature, type parameters and body are the
definition's rows; its body root precedes this node, so it is already rebuilt.
---
private pure func legacy_local_function(
	reader: DeclarationReader,
	built: List[BuiltNode],
	view: NodeView,
) -> Result[BuiltNode, LegacyAdapterError]:
	definition: Int = definition_id_index(definition_id_at_row(view.row.payload))
	definition_row ?= definition_at(reader, definition)
	rebuilt: ModuleBodies = {
		first_node = view.first_node,
		built = built
	}
	function_decl ?= legacy_function(reader, rebuilt, definition, definition_row)
	expression(ParsedFunctionDeclExpr(function_decl))


---
The names of a tuple binder: the identifiers among children `0` up to `end_ordinal`.
---
private pure func legacy_binder_names(
	reader: DeclarationReader,
	built: List[BuiltNode],
	view: NodeView,
	end_ordinal: Int,
) -> Result[List[ParsedIdentifier], LegacyAdapterError]:
	collected_children(reader, built, view, 0, end_ordinal, as_binder)


private pure func legacy_for_binder(
	reader: DeclarationReader,
	built: List[BuiltNode],
	view: NodeView,
) -> Result[ParsedForBinder, LegacyAdapterError]:
	match child_value(reader, built, view, 0):
		BuiltBinder(identifier):
			Ok(ParsedForNameBinder(identifier))
		BuiltTupleBinder(names, location):
			Ok(ParsedForTupleBinder(names, location))
		_:
			Err(malformed(view))


private pure func legacy_for(
	reader: DeclarationReader,
	built: List[BuiltNode],
	view: NodeView,
) -> Result[BuiltNode, LegacyAdapterError]:
	binder ?= legacy_for_binder(reader, built, view)
	iterable ?= child_expression(reader, built, view, 1)
	body ?= child_expression(reader, built, view, 2)
	expression(ParsedForExpr(binder, iterable, body, view.location))


---
The parameter named `name`, or `None` when none is written.
---
private pure func concurrent_parameter(
	parameters: List[ConcurrentParameterValue],
	name: TableNameId,
) -> Option[ConcurrentParameterValue]:
	parameters.find(pure func(parameter): table_names_equal(parameter.name, name))


---
The value of the parameter named `name`, or `None` when none is written.
---
private pure func concurrent_parameter_value(
	parameters: List[ConcurrentParameterValue],
	name: TableNameId,
) -> Option[ParsedExpr]:
	concurrent_parameter(parameters, name).map(pure func(parameter): parameter.value)


---
The thread limit of a `concurrent(max_threads: n)` block: `n`, or the default
when none is written.
---
private pure func legacy_thread_limit(
	view: NodeView,
	parameters: List[ConcurrentParameterValue],
) -> Result[ConcurrentThreadLimit, LegacyAdapterError]:
	match concurrent_parameter(parameters, MAX_THREADS_NAME):
		Some(parameter):
			match parameter.count:
				Some(count):
					Ok(ThreadLimit(count))
				None:
					Err(malformed(view))
		None:
			Ok(DefaultThreadLimit)


---
The width of a `concurrently(limit: n)` loop. The parser rejects a loop without
one, so a loop in an accepted module has it.
---
private pure func legacy_for_limit(
	view: NodeView,
	parameters: List[ConcurrentParameterValue],
) -> Result[ConcurrentForLimit, LegacyAdapterError]:
	match concurrent_parameter(parameters, LIMIT_NAME):
		Some(parameter):
			match parameter.count:
				Some(count):
					Ok(WrittenLimit(count))
				None:
					Err(malformed(view))
		None:
			Err(malformed(view))


private pure func legacy_concurrent_block(
	reader: DeclarationReader,
	built: List[BuiltNode],
	view: NodeView,
) -> Result[BuiltNode, LegacyAdapterError]:
	body_ordinal: Int = view.row.children.count - 1
	parameters ?= collected_children(reader, built, view, 0, body_ordinal, as_concurrent_parameter)
	body ?= child_expression(reader, built, view, body_ordinal)
	max_threads ?= legacy_thread_limit(view, parameters)
	expression(
		ParsedConcurrentBlockExpr(
			{
				max_threads = max_threads,
				timeout = concurrent_parameter_value(parameters, TIMEOUT_NAME)
			},
			body,
			view.location,
		),
	)


---
`for x in xs concurrently(limit: n, ...): body`: the binder, the iterable, the
parameters, then the body. The existing AST has no tuple binder here; the
parser rejects one.
---
private pure func legacy_concurrent_for(
	reader: DeclarationReader,
	built: List[BuiltNode],
	view: NodeView,
) -> Result[BuiltNode, LegacyAdapterError]:
	body_ordinal: Int = view.row.children.count - 1
	iterable ?= child_expression(reader, built, view, 1)
	parameters ?= collected_children(reader, built, view, 2, body_ordinal, as_concurrent_parameter)
	body ?= child_expression(reader, built, view, body_ordinal)
	limit ?= legacy_for_limit(view, parameters)

	match child_value(reader, built, view, 0):
		BuiltBinder(name):
			expression(
				ParsedConcurrentForExpr(
					name,
					iterable,
					{
						limit = limit,
						timeout = concurrent_parameter_value(parameters, TIMEOUT_NAME)
					},
					body,
					view.location,
				),
			)
		_:
			Err(malformed(view))


---
The written type, when there is one, and the value of a `name [: T] = value`
form: the type is the first child of two.
---
private pure func legacy_typed_value(
	reader: DeclarationReader,
	built: List[BuiltNode],
	view: NodeView,
) -> Result[(Option[ParsedTypeExpr], ParsedExpr), LegacyAdapterError]:
	typed: Bool = view.row.children.count > 1

	value_ordinal: Int = if typed:
		1
	else:
		0

	type_expr ?= optional_child_type(reader, view, typed)
	value ?= child_expression(reader, built, view, value_ordinal)
	Ok((type_expr, value))


private pure func legacy_binding(
	reader: DeclarationReader,
	built: List[BuiltNode],
	view: NodeView,
	is_mutable: Bool,
) -> Result[BuiltNode, LegacyAdapterError]:
	typed_value ?= legacy_typed_value(reader, built, view)
	expression(
		ParsedVarDeclExpr(
			node_identifier(reader, view),
			typed_value[0],
			typed_value[1],
			is_mutable,
			view.location,
		),
	)


private pure func legacy_question_bind(
	reader: DeclarationReader,
	built: List[BuiltNode],
	view: NodeView,
) -> Result[BuiltNode, LegacyAdapterError]:
	typed_value ?= legacy_typed_value(reader, built, view)
	expression(
		ParsedQuestionBindExpr(
			node_identifier(reader, view),
			typed_value[0],
			typed_value[1],
			view.location,
		),
	)


private pure func legacy_compound_assignment(
	reader: DeclarationReader,
	built: List[BuiltNode],
	view: NodeView,
	operator: ParsedCompoundAssignOp,
) -> Result[BuiltNode, LegacyAdapterError]:
	value ?= child_expression(reader, built, view, 0)
	expression(
		ParsedCompoundAssignExpr(
			node_identifier(reader, view),
			operator,
			value,
			view.location,
		),
	)


---
`target[indices] = value`: the target's subscript is the first child, rebuilt as
a subscript read, which this takes apart.
---
private pure func legacy_subscript_assignment(
	reader: DeclarationReader,
	built: List[BuiltNode],
	view: NodeView,
) -> Result[BuiltNode, LegacyAdapterError]:
	subscript ?= child_expression(reader, built, view, 0)
	value ?= child_expression(reader, built, view, 1)

	match subscript:
		ParsedSubscriptExpr(target, indices, _):
			expression(ParsedSubscriptAssignExpr(target, indices, value, view.location))
		_:
			Err(malformed(view))


-- Declarations.
private pure func legacy_function(
	reader: DeclarationReader,
	bodies: ModuleBodies,
	definition: Int,
	row: DefinitionRow,
) -> Result[ParsedFunctionDecl, LegacyAdapterError]:
	signature ?= signature_of_definition(reader, definition)
	type_params ?= legacy_type_parameters(reader, definition)
	params ?= legacy_params(reader, definition)
	return_type ?= legacy_definition_type(reader, definition)
	constraint_rows ?= rows_of(reader.dimension_constraints, definition, DimensionConstraintTable)
	dim_constraints ?= collected(constraint_rows.map(
		pure func(constraint_row): legacy_dimension_constraint(reader, constraint_row),
	))
	body ?= legacy_body(reader, bodies, definition)
	annotations ?= legacy_annotations(reader, definition)
	doc ?= legacy_documentation(reader, definition)

	Ok({
		name = legacy_identifier(reader, row.name, row.name_span),
		keyword_span = Some(legacy_location(signature.keyword_span)),
		type_params = type_params,
		params = params,
		return_type = return_type,
		dim_constraints = dim_constraints,
		body = body,
		is_pure = signature.purity == Kinds.PureFunction,
		annotations = annotations,
		doc = doc,
		span = legacy_location(row.span),
	})


private pure func legacy_dimension_constraint(
	reader: DeclarationReader,
	constraint_row: Int,
) -> Result[ParsedDimConstraint, LegacyAdapterError]:
	constraint ?= present(
		Tables.dimension_constraint_row_at(reader.tables, constraint_row),
		DimensionConstraintTable,
		constraint_row,
	)
	left ?= legacy_type(reader, constraint.left)
	right ?= legacy_type(reader, constraint.right)
	Ok({
		left = left,
		right = right,
		span = legacy_location(constraint.span),
	})


---
The definitions that are members of `owner`, in written order.
---
private pure func legacy_members(
	reader: DeclarationReader,
	owner: Int,
) -> Result[List[Int], LegacyAdapterError]:
	rows ?= rows_of(reader.members, owner, MemberTable)
	collected(rows.map(
		pure func(member_row): member_definition(reader, member_row),
	))


private pure func member_definition(
	reader: DeclarationReader,
	member_row: Int,
) -> Result[Int, LegacyAdapterError]:
	member ?= present(
		Tables.member_row_at(reader.tables, member_row),
		MemberTable,
		member_row,
	)
	Ok(definition_id_index(member.definition))


private pure func legacy_record(
	reader: DeclarationReader,
	definition: Int,
	row: DefinitionRow,
) -> Result[ParsedRecordDecl, LegacyAdapterError]:
	type_params ?= legacy_type_parameters(reader, definition)
	members ?= legacy_members(reader, definition)
	fields ?= collected(members.map(
		pure func(field): legacy_field(reader, field),
	))
	doc ?= legacy_documentation(reader, definition)
	form: RecordDeclarationForm = match row.kind:
		Kinds.FixedRecordDefinition:
			FixedRecord
		_:
			OrdinaryRecord

	Ok({
		name = legacy_identifier(reader, row.name, row.name_span),
		type_params = type_params,
		fields = fields,
		form = form,
		doc = doc,
		span = legacy_location(row.span),
	})


private pure func legacy_field(
	reader: DeclarationReader,
	field: Int,
) -> Result[ParsedFieldDecl, LegacyAdapterError]:
	row ?= definition_at(reader, field)
	type_expr ?= legacy_required_type(reader, field)
	Ok({
		name = legacy_identifier(reader, row.name, row.name_span),
		type_expr = type_expr,
		span = legacy_location(row.span),
	})


private pure func legacy_union(
	reader: DeclarationReader,
	definition: Int,
	row: DefinitionRow,
	form: UnionDeclarationForm,
) -> Result[ParsedUnionDecl, LegacyAdapterError]:
	type_params ?= legacy_type_parameters(reader, definition)
	members ?= legacy_members(reader, definition)
	variants ?= collected(members.map(
		pure func(variant): legacy_variant(reader, variant),
	))
	doc ?= legacy_documentation(reader, definition)

	Ok({
		name = legacy_identifier(reader, row.name, row.name_span),
		type_params = type_params,
		variants = variants,
		form = form,
		doc = doc,
		span = legacy_location(row.span),
	})


private pure func legacy_variant(
	reader: DeclarationReader,
	variant: Int,
) -> Result[ParsedVariantDecl, LegacyAdapterError]:
	row ?= definition_at(reader, variant)
	payload_rows ?= rows_of(reader.variant_payloads, variant, VariantPayloadTable)
	fields ?= collected(payload_rows.map(
		pure func(payload_row): legacy_variant_payload(reader, payload_row),
	))
	Ok({
		name = legacy_identifier(reader, row.name, row.name_span),
		fields = fields,
		span = legacy_location(row.span),
	})


private pure func legacy_variant_payload(
	reader: DeclarationReader,
	payload_row: Int,
) -> Result[ParsedTypeExpr, LegacyAdapterError]:
	payload ?= present(
		Tables.variant_payload_row_at(reader.tables, payload_row),
		VariantPayloadTable,
		payload_row,
	)
	legacy_type(reader, payload.type_root)


private pure func legacy_builtin_type(
	reader: DeclarationReader,
	definition: Int,
	row: DefinitionRow,
) -> Result[ParsedBuiltinTypeDecl, LegacyAdapterError]:
	type_params ?= legacy_type_parameters(reader, definition)
	cleanup ?= legacy_resource_cleanup(reader, definition)
	doc ?= legacy_documentation(reader, definition)

	Ok({
		name = legacy_identifier(reader, row.name, row.name_span),
		type_params = type_params,
		is_resource = row.kind == Kinds.ResourceTypeDefinition,
		cleanup = cleanup,
		doc = doc,
		span = legacy_location(row.span),
	})


private pure func legacy_resource_cleanup(
	reader: DeclarationReader,
	definition: Int,
) -> Result[Option[ParsedResourceCleanup], LegacyAdapterError]:
	cleanup_row ?= optional_row(reader.resource_cleanup_of, definition, ResourceCleanupTable)

	match cleanup_row:
		Some(row):
			cleanup ?= present(
				Tables.resource_cleanup_row_at(reader.tables, row),
				ResourceCleanupTable,
				row,
			)
			Ok(Some({
				builtin_name = literal_string(reader, cleanup.builtin_name),
				span = legacy_location(cleanup.span),
			}))
		None:
			Ok(None)


private pure func legacy_type_alias(
	reader: DeclarationReader,
	definition: Int,
	row: DefinitionRow,
) -> Result[ParsedTypeAliasDecl, LegacyAdapterError]:
	type_params ?= legacy_type_parameters(reader, definition)
	target ?= legacy_required_type(reader, definition)
	doc ?= legacy_documentation(reader, definition)

	Ok({
		name = legacy_identifier(reader, row.name, row.name_span),
		type_params = type_params,
		target = target,
		is_opaque = row.kind == Kinds.OpaqueTypeDefinition,
		doc = doc,
		span = legacy_location(row.span),
	})


private pure func legacy_trait(
	reader: DeclarationReader,
	bodies: ModuleBodies,
	definition: Int,
	row: DefinitionRow,
) -> Result[ParsedTraitDecl, LegacyAdapterError]:
	type_params ?= legacy_type_parameters(reader, definition)
	supertrait_rows ?= rows_of(reader.supertraits, definition, SupertraitTable)
	supertraits ?= collected(supertrait_rows.map(
		pure func(supertrait_row): legacy_supertrait(reader, supertrait_row),
	))
	members ?= legacy_members(reader, definition)
	methods ?= collected(members.map(
		pure func(method): legacy_trait_method(reader, bodies, method),
	))
	doc ?= legacy_documentation(reader, definition)

	Ok({
		name = legacy_identifier(reader, row.name, row.name_span),
		type_params = type_params,
		supertraits = supertraits,
		methods = methods,
		doc = doc,
		span = legacy_location(row.span),
	})


private pure func legacy_trait_method(
	reader: DeclarationReader,
	bodies: ModuleBodies,
	method: Int,
) -> Result[ParsedTraitMethodDecl, LegacyAdapterError]:
	row ?= definition_at(reader, method)
	signature ?= signature_of_definition(reader, method)
	params ?= legacy_params(reader, method)
	return_type ?= legacy_definition_type(reader, method)
	body ?= legacy_body(reader, bodies, method)
	Ok({
		name = legacy_identifier(reader, row.name, row.name_span),
		params = params,
		return_type = return_type,
		body = body,
		is_pure = signature.purity == Kinds.PureFunction,
		span = legacy_location(row.span),
	})


private pure func legacy_impl(
	reader: DeclarationReader,
	bodies: ModuleBodies,
	definition: Int,
	row: DefinitionRow,
) -> Result[ParsedImplDecl, LegacyAdapterError]:
	impl_index ?= required_row(reader.impl_of, definition, ImplTable)
	impl_row ?= present(
		Tables.impl_row_at(reader.tables, impl_index),
		ImplTable,
		impl_index,
	)
	for_type ?= legacy_required_type(reader, definition)
	members ?= legacy_members(reader, definition)
	methods ?= collected(members.map(
		pure func(method): legacy_impl_method(reader, bodies, method),
	))
	doc ?= legacy_documentation(reader, definition)

	Ok({
		trait_name = legacy_identifier(reader, impl_row.trait_name, impl_row.trait_span),
		for_type = for_type,
		methods = methods,
		doc = doc,
		span = legacy_location(row.span),
	})


private pure func legacy_impl_method(
	reader: DeclarationReader,
	bodies: ModuleBodies,
	method: Int,
) -> Result[ParsedFunctionDecl, LegacyAdapterError]:
	row ?= definition_at(reader, method)
	legacy_function(reader, bodies, method, row)


private pure func legacy_global(
	reader: DeclarationReader,
	bodies: ModuleBodies,
	definition: Int,
	row: DefinitionRow,
) -> Result[ParsedVarDecl, LegacyAdapterError]:
	type_expr ?= legacy_definition_type(reader, definition)
	doc ?= legacy_documentation(reader, definition)
	value_row ?= required_row(reader.body_of, definition, BodyTable)
	value ?= body_expression(reader, bodies, value_row)

	Ok({
		name = legacy_identifier(reader, row.name, row.name_span),
		type_expr = type_expr,
		value = value,
		is_mutable = row.kind == Kinds.MutableGlobalDefinition,
		doc = doc,
		span = legacy_location(row.span),
	})


---
The top-level declaration `definition` is, or `None` for a definition that is
not one: a member (rebuilt through its owner), a foreign function (through its
block) or a local function (part of a body).
---
private pure func legacy_declaration(
	reader: DeclarationReader,
	bodies: ModuleBodies,
	definition: Int,
) -> Result[Option[ParsedDecl], LegacyAdapterError]:
	row ?= definition_at(reader, definition)
	inner ?= legacy_unwrapped_declaration(reader, bodies, definition, row)

	match (inner, row.visibility):
		(Some(declaration), Kinds.PrivateVisibility):
			Ok(Some(PrivateParsedDecl(declaration, legacy_location(row.span))))
		_:
			Ok(inner)


---
The declaration `definition` is, without the `private` wrapper.
---
private pure func legacy_unwrapped_declaration(
	reader: DeclarationReader,
	bodies: ModuleBodies,
	definition: Int,
	row: DefinitionRow,
) -> Result[Option[ParsedDecl], LegacyAdapterError]:
	match row.kind:
		Kinds.FunctionDefinition:
			function_decl ?= legacy_function(reader, bodies, definition, row)
			Ok(Some(FunctionParsedDecl(function_decl)))
		Kinds.ConstantDefinition:
			global ?= legacy_global(reader, bodies, definition, row)
			Ok(Some(VarParsedDecl(global)))
		Kinds.MutableGlobalDefinition:
			global ?= legacy_global(reader, bodies, definition, row)
			Ok(Some(VarParsedDecl(global)))
		Kinds.RecordDefinition:
			record_decl ?= legacy_record(reader, definition, row)
			Ok(Some(RecordParsedDecl(record_decl)))
		Kinds.FixedRecordDefinition:
			record_decl ?= legacy_record(reader, definition, row)
			Ok(Some(RecordParsedDecl(record_decl)))
		Kinds.UnionDefinition:
			union_decl ?= legacy_union(reader, definition, row, OrdinaryUnion)
			Ok(Some(UnionParsedDecl(union_decl)))
		Kinds.FixedUnionDefinition:
			union_decl ?= legacy_union(reader, definition, row, FixedUnion)
			Ok(Some(UnionParsedDecl(union_decl)))
		Kinds.EnumDefinition:
			union_decl ?= legacy_union(reader, definition, row, LegacyEnum)
			Ok(Some(UnionParsedDecl(union_decl)))
		Kinds.BuiltinTypeDefinition:
			builtin_decl ?= legacy_builtin_type(reader, definition, row)
			Ok(Some(BuiltinTypeParsedDecl(builtin_decl)))
		Kinds.ResourceTypeDefinition:
			builtin_decl ?= legacy_builtin_type(reader, definition, row)
			Ok(Some(BuiltinTypeParsedDecl(builtin_decl)))
		Kinds.TypeAliasDefinition:
			alias_decl ?= legacy_type_alias(reader, definition, row)
			Ok(Some(TypeAliasParsedDecl(alias_decl)))
		Kinds.OpaqueTypeDefinition:
			alias_decl ?= legacy_type_alias(reader, definition, row)
			Ok(Some(TypeAliasParsedDecl(alias_decl)))
		Kinds.TraitDefinition:
			trait_decl ?= legacy_trait(reader, bodies, definition, row)
			Ok(Some(TraitParsedDecl(trait_decl)))
		Kinds.ImplDefinition:
			impl_decl ?= legacy_impl(reader, bodies, definition, row)
			Ok(Some(ImplParsedDecl(impl_decl)))
		Kinds.ForeignFunctionDefinition:
			Ok(None)
		Kinds.FieldDefinition:
			Ok(None)
		Kinds.VariantDefinition:
			Ok(None)
		Kinds.TraitMethodDefinition:
			Ok(None)
		Kinds.ImplMethodDefinition:
			Ok(None)
		Kinds.LocalFunctionDefinition:
			Ok(None)


-- Imports and foreign blocks.
private pure func legacy_import_block(
	reader: DeclarationReader,
	block_row: Int,
) -> Result[ParsedDecl, LegacyAdapterError]:
	block ?= present(
		Tables.import_block_row_at(reader.tables, block_row),
		ImportBlockTable,
		block_row,
	)
	imports ?= collected(range(block.imports.first, block.imports.first + block.imports.count).map(
		pure func(import_row): legacy_import(reader, import_row),
	))
	Ok(ImportBlockParsedDecl(imports, legacy_location(block.span)))


private pure func legacy_import(
	reader: DeclarationReader,
	import_row: Int,
) -> Result[ParsedImportDecl, LegacyAdapterError]:
	import_id: ImportId = import_id_at_row(import_row)
	row ?= present(
		Tables.import_row_at(reader.tables, import_row),
		ImportTable,
		import_row,
	)

	module_alias: Option[ParsedIdentifier] = match Tables.import_alias(reader.tables, import_id):
		Some(alias_row):
			Some(legacy_identifier(reader, alias_row.alias_name, alias_row.span))
		None:
			None

	-- An item-less import is `import: path`; the parser reports `path:` with no
	-- selection, so no accepted module has an empty selection.
	symbols ?= legacy_import_symbols(reader, row.items)

	Ok({
		module_path = reader.import_texts.get_or(import_row, ""),
		module_path_span = legacy_location(row.path_span),
		module_alias = module_alias,
		symbols = symbols,
		span = legacy_location(row.span),
	})


private pure func legacy_import_symbols(
	reader: DeclarationReader,
	items: RowRange,
) -> Result[Option[List[ParsedImportSymbol]], LegacyAdapterError]:
	if items.count == 0:
		Ok(None)
	else:
		symbols ?= collected(range(items.first, items.first + items.count).map(
			pure func(item_row): legacy_import_symbol(reader, item_row),
		))
		Ok(Some(symbols))


private pure func legacy_import_symbol(
	reader: DeclarationReader,
	item_row: Int,
) -> Result[ParsedImportSymbol, LegacyAdapterError]:
	item_id: ImportItemId = import_item_id_at_row(item_row)
	item ?= present(
		Tables.import_item_row_at(reader.tables, item_id),
		ImportItemTable,
		item_row,
	)
	constructors ?= collected(range(
		item.variants.first,
		item.variants.first + item.variants.count,
	).map(
		pure func(variant_row): legacy_import_constructor(reader, variant_row),
	))

	symbol_alias: Option[ParsedIdentifier] = match Tables.import_item_alias(reader.tables, item_id):
		Some(alias_row):
			Some(legacy_identifier(reader, alias_row.alias_name, alias_row.span))
		None:
			None

	Ok({
		name = legacy_identifier(reader, item.name, item.name_span),
		symbol_alias = symbol_alias,
		constructors = constructors,
		span = legacy_location(item.span),
	})


private pure func legacy_import_constructor(
	reader: DeclarationReader,
	variant_row: Int,
) -> Result[ParsedIdentifier, LegacyAdapterError]:
	variant ?= present(
		Tables.import_item_variant_row_at(reader.tables, variant_row),
		ImportItemVariantTable,
		variant_row,
	)
	Ok(legacy_identifier(reader, variant.name, variant.span))


private pure func legacy_foreign_block(
	reader: DeclarationReader,
	block_row: Int,
) -> Result[ParsedDecl, LegacyAdapterError]:
	block ?= present(
		Tables.foreign_block_row_at(reader.tables, block_row),
		ForeignBlockTable,
		block_row,
	)
	arguments ?= collected(range(
		block.arguments.first,
		block.arguments.first + block.arguments.count,
	).map(
		pure func(argument_row): legacy_foreign_argument(reader, argument_row),
	))
	binding_rows ?= rows_of(reader.foreign_block_functions, block_row, ForeignBindingTable)
	functions ?= collected(binding_rows.map(
		pure func(binding_row): legacy_foreign_function(reader, binding_row),
	))
	Ok(ForeignBlockParsedDecl(arguments, functions, legacy_location(block.span)))


private pure func legacy_foreign_argument(
	reader: DeclarationReader,
	argument_row: Int,
) -> Result[ParsedForeignBlockArg, LegacyAdapterError]:
	argument ?= present(
		Tables.foreign_argument_row_at(reader.tables, argument_row),
		ForeignArgumentTable,
		argument_row,
	)
	Ok({
		name = legacy_identifier(reader, argument.name, argument.name_span),
		value = literal_string(reader, argument.value),
		span = legacy_location(argument.span),
	})


private pure func legacy_foreign_function(
	reader: DeclarationReader,
	binding_row: Int,
) -> Result[ParsedForeignFunctionDecl, LegacyAdapterError]:
	binding ?= present(
		Tables.foreign_binding_row_at(reader.tables, binding_row),
		ForeignBindingTable,
		binding_row,
	)
	definition: Int = definition_id_index(binding.definition)
	row ?= definition_at(reader, definition)
	signature ?= signature_of_definition(reader, definition)
	params ?= legacy_params(reader, definition)
	return_type ?= legacy_required_type(reader, definition)
	c_name ?= legacy_c_name(reader, definition)
	annotations ?= legacy_annotations(reader, definition)

	Ok({
		name = legacy_identifier(reader, row.name, row.name_span),
		params = params,
		return_type = return_type,
		c_name = c_name,
		is_pure = signature.purity == Kinds.PureFunction,
		is_private = row.visibility == Kinds.PrivateVisibility,
		annotations = annotations,
		span = legacy_location(row.span),
	})


private pure func legacy_c_name(
	reader: DeclarationReader,
	definition: Int,
) -> Result[Option[String], LegacyAdapterError]:
	c_name_row ?= optional_row(reader.foreign_c_name_of, definition, ForeignCNameTable)

	match c_name_row:
		Some(row):
			c_name ?= present(
				Tables.foreign_c_name_row_at(reader.tables, row),
				ForeignCNameTable,
				row,
			)
			Ok(Some(literal_string(reader, c_name.c_name)))
		None:
			Ok(None)


-- Modules.
---
One module's parsed program as the existing parser would have produced it, with
interpolation holes parsed: its docstring, then its import blocks, foreign blocks
and definitions in source order, each with its body. The program carries no
diagnostics; a module the stage rejected has none to translate.
---
pure func legacy_parsed_program(
	reader: DeclarationReader,
	module: ModuleId,
) -> Result[ParsedProgram, LegacyAdapterError]:
	index: Int = module_id_index(module)
	row: ModuleRow = Tables.module_row(reader.tables, module)
	source ?= legacy_source_file(reader, module)
	documentation_row ?= optional_row(
		reader.module_documentation_of,
		index,
		ModuleDocumentationTable,
	)
	module_doc ?= legacy_module_doc(reader, documentation_row)
	bodies ?= legacy_module_bodies(reader, row)
	decls ?= legacy_module_items(reader, bodies, index, row)

	Ok({
		source = source,
		module_doc = module_doc,
		decls = decls,
		diagnostics = [],
	})


---
The source file of `module` as the existing front end holds it: its path in the
existing spelling, its name from how it was reached, and its text.
---
pure func legacy_source_file(
	reader: DeclarationReader,
	module: ModuleId,
) -> Result[SourceFile, LegacyAdapterError]:
	index: Int = module_id_index(module)
	row: ModuleRow = Tables.module_row(reader.tables, module)
	module_name ?= present(
		reader.module_names.get(index),
		ModuleTable,
		index,
	)
	source_path ?= present(
		reader.source_paths.get(index),
		ModuleTable,
		index,
	)
	Ok(source_file(source_path, module_name, Tables.source_text(reader.tables, row.source)))


private pure func legacy_module_doc(
	reader: DeclarationReader,
	documentation_row: Option[Int],
) -> Result[Option[ParsedModuleDoc], LegacyAdapterError]:
	match documentation_row:
		Some(row):
			documentation ?= present(
				Tables.module_documentation_row_at(reader.tables, row),
				ModuleDocumentationTable,
				row,
			)
			Ok(Some({
				text = literal_string(reader, documentation.text),
				span = legacy_location(documentation.span),
			}))
		None:
			Ok(None)


private pure func import_block_start(reader: DeclarationReader, block_row: Int) -> Int:
	match Tables.import_block_row_at(reader.tables, block_row):
		Some(block):
			span_start(block.span)
		None:
			NO_MORE_ITEMS


private pure func foreign_block_start(reader: DeclarationReader, block_row: Int) -> Int:
	match Tables.foreign_block_row_at(reader.tables, block_row):
		Some(block):
			span_start(block.span)
		None:
			NO_MORE_ITEMS


private pure func definition_start(reader: DeclarationReader, definition: Int) -> Int:
	match Tables.definition_row_at(reader.tables, definition):
		Some(row):
			span_start(row.span)
		None:
			NO_MORE_ITEMS


---
The module's top-level items in source order: its definitions, import blocks
and foreign blocks, each already in source order within its table, merged by
the start of their spans. A row that does not exist starts at `NO_MORE_ITEMS`,
so it ends its list; reading it reports `MissingTableRow`.
---
private pure func legacy_module_items(
	reader: DeclarationReader,
	bodies: ModuleBodies,
	module: Int,
	row: ModuleRow,
) -> Result[List[ParsedDecl], LegacyAdapterError]:
	import_rows ?= rows_of(reader.import_blocks, module, ImportBlockTable)
	foreign_rows ?= rows_of(reader.foreign_blocks, module, ForeignBlockTable)
	definition_end: Int = row.definitions.first + row.definitions.count
	var definition: Int = row.definitions.first
	var next_import: Int = 0
	var next_foreign: Int = 0
	var items: List[ParsedDecl] = []
	var failure: Option[LegacyAdapterError] = None

	while (
		failure.is_none()
		and ((
			definition < definition_end
			or next_import < import_rows.length()
			or next_foreign < foreign_rows.length()
		))
	):
		next_definition_start: Int = if definition < definition_end:
			definition_start(reader, definition)
		else:
			NO_MORE_ITEMS

		next_import_row: Int = import_rows.get_or(next_import, ABSENT_ROW)

		next_import_start: Int = if next_import < import_rows.length():
			import_block_start(reader, next_import_row)
		else:
			NO_MORE_ITEMS

		next_foreign_row: Int = foreign_rows.get_or(next_foreign, ABSENT_ROW)

		next_foreign_start: Int = if next_foreign < foreign_rows.length():
			foreign_block_start(reader, next_foreign_row)
		else:
			NO_MORE_ITEMS

		if next_import_start <= next_definition_start and next_import_start <= next_foreign_start:
			match legacy_import_block(reader, next_import_row):
				Ok(block):
					items = items.append(block)
				Err(error):
					failure = Some(error)

			next_import += 1
		else if next_foreign_start <= next_definition_start:
			match legacy_foreign_block(reader, next_foreign_row):
				Ok(block):
					items = items.append(block)
				Err(error):
					failure = Some(error)

			next_foreign += 1
		else:
			match legacy_declaration(reader, bodies, definition):
				Ok(Some(declaration)):
					items = items.append(declaration)
				Ok(None):
					void
				Err(error):
					failure = Some(error)

			definition += 1

	match failure:
		Some(error):
			Err(error)
		None:
			Ok(items)


-- The graph.
---
The existing front end's name table over the stage's: the same spellings at the
same ids, plus the by-spelling dictionary that table carries. Nothing is
re-interned, so every id the rebuilt AST holds indexes this table.
---
private pure func legacy_name_table(tables: Tables.FrontendTables) -> NameTable:
	spellings: List[String] = Tables.name_spellings(tables)
	var ids_by_spelling: Dict[String, Int] = {}
	var id: Int = 0

	for spelling in spellings:
		ids_by_spelling = ids_by_spelling.set(spelling, id)
		id += 1

	name_table_from_parts(spellings, ids_by_spelling)


---
The origin the existing front end gives `module`, from its origin and package
row.
---
private pure func legacy_module_origin(
	tables: Tables.FrontendTables,
	module: ModuleId,
	row: ModuleRow,
) -> Result[ModuleOrigin, LegacyAdapterError]:
	match row.origin:
		Kinds.StdlibModule:
			Ok(StdlibModule)
		Kinds.UserModule:
			Ok(UserModule)
		Kinds.PackageModule:
			package ?= package_of(tables, module)
			Ok(NativePackageModule(Tables.name_spelling(tables, package.name)))
		Kinds.SourcePackageModule:
			package ?= package_of(tables, module)
			Ok(SourcePackageModule(Tables.name_spelling(tables, package.name)))


private pure func package_of(
	tables: Tables.FrontendTables,
	module: ModuleId,
) -> Result[PackageRow, LegacyAdapterError]:
	present(
		Tables.module_package(tables, module),
		ModulePackageTable,
		module_id_index(module),
	)


private pure func legacy_module_identity(
	reader: DeclarationReader,
	module: Int,
) -> Result[ResolvedModuleIdentity, LegacyAdapterError]:
	id: ModuleId = module_id_at_row(module)
	name ?= present(
		reader.module_names.get(module),
		ModuleTable,
		module,
	)
	origin ?= legacy_module_origin(
		reader.tables,
		id,
		Tables.module_row(reader.tables, id),
	)
	Ok(resolved_module_identity_from_resolver(name, origin))


---
The import edges of module `module`: one per import written, in source order,
resolved to the module the stage loaded for it, or unresolved when it loaded
none.
---
private pure func legacy_import_edges(
	reader: DeclarationReader,
	module: Int,
) -> Result[List[FrontendImportEdge], LegacyAdapterError]:
	row: ModuleRow = Tables.module_row(reader.tables, module_id_at_row(module))
	importer ?= legacy_module_identity(reader, module)

	collected(range(row.imports.first, row.imports.first + row.imports.count).map(
		pure func(import_row): legacy_import_edge(reader, importer, import_row),
	))


private pure func legacy_import_edge(
	reader: DeclarationReader,
	importer: ResolvedModuleIdentity,
	import_row: Int,
) -> Result[FrontendImportEdge, LegacyAdapterError]:
	import_id: ImportId = import_id_at_row(import_row)
	row ?= present(
		Tables.import_row_at(reader.tables, import_row),
		ImportTable,
		import_row,
	)
	resolution ?= legacy_import_resolution(reader, import_id)

	Ok({
		importer = importer,
		requested_path = reader.import_texts.get_or(import_row, ""),
		resolution = resolution,
	})


private pure func legacy_import_resolution(
	reader: DeclarationReader,
	import_id: ImportId,
) -> Result[FrontendImportResolution, LegacyAdapterError]:
	match Tables.import_target(reader.tables, import_id):
		Some(target):
			identity ?= legacy_module_identity(reader, module_id_index(target))
			Ok(FrontendResolvedImport(identity))
		None:
			Ok(FrontendUnresolvedImport)


---
Rebuilds the graph the typecheck reads from the stage's tables: each module's
declarations finalized and summarized, the roots, the import edges, and the name
table, validated by the graph service. `context` and `naming` are what the caller
knew about the file system; the tables hold no policy of their own.

A compile reaches it only through the CLI's graph seam
(`frontend_compilation_graph_for_root_paths` in `lib/source_graph`, which composes
the inputs in `compiler/discovery_front_end`); the differential and the cost
measurement call it directly.
---
pure func legacy_frontend_graph(
	tables: Tables.FrontendTables,
	naming: LegacyModuleNaming,
	context: FrontendGraphContext,
) -> Result[FrontendCompilationGraph, LegacyAdapterError]:
	reader ?= legacy_declaration_reader(tables, naming)
	parts ?= collected(range(
		0,
		Tables.module_count(tables),
	).map(
		pure func(module): legacy_module_parts(reader, module),
	))
	roots ?= legacy_root_identities(reader)
	var names: NameTable = legacy_name_table(tables)
	var modules: List[FrontendModule] = []
	var edges: List[FrontendImportEdge] = []

	for part in parts:
		(program, extended_names) = finalized_typecheck_program_with_names(part.declarations, names)
		names = extended_names
		modules = modules.append({
			identity = part.identity,
			program = program,
			surface = module_surface_for_program(finalized_typecheck_program_ast(program)),
		})
		edges = edges.concat(part.edges)

	match validated_frontend_graph_for_modules(modules, roots, edges, names):
		Ok(graph):
			Ok({
				context = context,
				graph = graph,
				diagnostics = [],
			})
		Err(errors):
			Err(GraphRejected(errors))


---
What the graph needs of one module before finalization.
---
record LegacyModuleParts {
	identity: ResolvedModuleIdentity,
	declarations: ParsedProgram,
	edges: List[FrontendImportEdge]
}


private pure func legacy_module_parts(
	reader: DeclarationReader,
	module: Int,
) -> Result[LegacyModuleParts, LegacyAdapterError]:
	declarations ?= legacy_parsed_program(reader, module_id_at_row(module))
	identity ?= legacy_module_identity(reader, module)
	edges ?= legacy_import_edges(reader, module)
	Ok({
		identity = identity,
		declarations = declarations,
		edges = edges,
	})


private pure func legacy_root_identities(
	reader: DeclarationReader,
) -> Result[List[ResolvedModuleIdentity], LegacyAdapterError]:
	loaded: List[Int] = range(
		0,
		Tables.root_count(reader.tables),
	)
		.map(pure func(root): root_target_index(reader.tables, root))
		.filter(pure func(target): target != ABSENT_ROW)

	collected(loaded.map(
		pure func(target): legacy_module_identity(reader, target),
	))


---
A successful preview lacked an integer or wildcard token its dimension must own.
This is a preview invariant error, never replacement text in the legacy AST.
---
union LegacyDeclarationPreviewError:
	MissingDimensionLiteralToken(Span)
	MissingVariadicWildcardToken(Span)
	InvalidGlobalInitializerEntry(Span)
	UnsupportedGlobalInitializerExpression(Span)
	MissingIntegerLiteralToken(Span)
	UnsupportedBodyStatement(Span)
	MissingPatternNumberToken(Span)


---
One successful tree preview rebuilt for the legacy parser boundary. Every
identifier indexes this preview's own name table, independent of lexer ids.
---
record LegacyRecordPreview {
	declaration: ParsedDecl,
	names: NameTable
}


pure func legacy_record_preview(preview: RecordPreview) -> Result[LegacyRecordPreview, LegacyDeclarationPreviewError]:
	translated ?= preview_record_declaration(record_source(preview), EMPTY_NAME_TABLE, record_declaration(preview))
	(names, declaration) = translated
	Ok({ declaration = declaration, names = names })


private pure func preview_record_declaration(
	source: PreviewSource, initial_names: NameTable, declaration: TreeDeclarations.RecordDeclaration,
) -> Result[(NameTable, ParsedDecl), LegacyDeclarationPreviewError]:
	(after_name, name) = preview_identifier(source, initial_names, declaration.name)
	(after_parameters, parameters) = preview_type_parameters(source, after_name, declaration.type_parameters)
	translated_fields ?= preview_fields(source, after_parameters, declaration.fields)
	(names, fields) = translated_fields
	form: RecordDeclarationForm = match declaration.form:
		TreeDeclarations.OrdinaryRecord: OrdinaryRecord
		TreeDeclarations.FixedRecord: FixedRecord
	Ok((names, preview_visibility(RecordParsedDecl({
		name = name, type_params = parameters, fields = fields, form = form,
		doc = preview_documentation(declaration.documentation), span = legacy_location(declaration.span)
	}), declaration.visibility, declaration.span)))


record LegacyAliasPreview {
	declaration: ParsedDecl,
	names: NameTable
}


pure func legacy_alias_preview(preview: AliasPreview) -> Result[LegacyAliasPreview, LegacyDeclarationPreviewError]:
	translated ?= preview_alias_declaration(alias_source(preview), EMPTY_NAME_TABLE, alias_declaration(preview))
	(names, declaration) = translated
	Ok({ declaration = declaration, names = names })


private pure func preview_alias_declaration(
	source: PreviewSource, initial_names: NameTable, declaration: TreeDeclarations.AliasDeclaration,
) -> Result[(NameTable, ParsedDecl), LegacyDeclarationPreviewError]:
	(after_name, name) = preview_identifier(source, initial_names, declaration.name)
	(after_parameters, parameters) = preview_type_parameters(source, after_name, declaration.type_parameters)
	translated_target ?= preview_type(source, after_parameters, declaration.target)
	(names, target) = translated_target
	Ok((names, preview_visibility(TypeAliasParsedDecl({
		name = name, type_params = parameters, target = target,
		is_opaque = declaration.form == TreeDeclarations.OpaqueAlias,
		doc = preview_documentation(declaration.documentation), span = legacy_location(declaration.span)
	}), declaration.visibility, declaration.span)))


record LegacyBuiltinTypePreview {
	declaration: ParsedDecl,
	names: NameTable
}


pure func legacy_builtin_type_preview(preview: BuiltinTypePreview) -> Result[LegacyBuiltinTypePreview, LegacyDeclarationPreviewError]:
	translated ?= match builtin_type_declaration(preview):
		BuiltinDeclaration(declaration):
			preview_builtin_declaration(builtin_type_source(preview), EMPTY_NAME_TABLE, declaration)
		ResourceDeclaration(declaration):
			preview_resource_declaration(builtin_type_source(preview), EMPTY_NAME_TABLE, declaration)
	(names, declaration) = translated
	Ok({ declaration = declaration, names = names })


private pure func preview_builtin_declaration(
	source: PreviewSource, initial_names: NameTable, declaration: TreeDeclarations.BuiltinTypeDeclaration,
) -> Result[(NameTable, ParsedDecl), LegacyDeclarationPreviewError]:
	(after_name, name) = preview_identifier(source, initial_names, declaration.name)
	(names, parameters) = preview_type_parameters(source, after_name, declaration.type_parameters)
	Ok((names, preview_visibility(BuiltinTypeParsedDecl({
		name = name, type_params = parameters, is_resource = False, cleanup = None,
		doc = preview_documentation(declaration.documentation), span = legacy_location(declaration.span)
	}), declaration.visibility, declaration.span)))


private pure func preview_resource_declaration(
	source: PreviewSource, initial_names: NameTable, declaration: TreeDeclarations.ResourceTypeDeclaration,
) -> Result[(NameTable, ParsedDecl), LegacyDeclarationPreviewError]:
	(after_name, name) = preview_identifier(source, initial_names, declaration.name)
	(names, parameters) = preview_type_parameters(source, after_name, declaration.type_parameters)
	cleanup: Option[ParsedResourceCleanup] = match declaration.cleanup:
		None:
			None
		Some(cleanup):
			Some({ builtin_name = cleanup.name, span = legacy_location(cleanup.span) })
	Ok((names, preview_visibility(BuiltinTypeParsedDecl({
		name = name, type_params = parameters, is_resource = True, cleanup = cleanup,
		doc = preview_documentation(declaration.documentation), span = legacy_location(declaration.span)
	}), declaration.visibility, declaration.span)))



record LegacyUnionPreview {
	declaration: ParsedDecl,
	names: NameTable
}


pure func legacy_union_preview(preview: UnionPreview) -> Result[LegacyUnionPreview, LegacyDeclarationPreviewError]:
	translated ?= preview_union_declaration(union_source(preview), EMPTY_NAME_TABLE, union_declaration(preview))
	(names, declaration) = translated
	Ok({ declaration = declaration, names = names })


private pure func preview_union_declaration(
	source: PreviewSource, initial_names: NameTable, declaration: TreeDeclarations.UnionDeclaration,
) -> Result[(NameTable, ParsedDecl), LegacyDeclarationPreviewError]:
	(after_name, name) = preview_identifier(source, initial_names, declaration.name)
	(after_parameters, parameters) = preview_type_parameters(source, after_name, declaration.type_parameters)
	translated_variants ?= preview_variants(source, after_parameters, declaration.variants)
	(names, variants) = translated_variants
	form: UnionDeclarationForm = match declaration.form:
		TreeDeclarations.OrdinaryUnion: OrdinaryUnion
		TreeDeclarations.FixedUnion: FixedUnion
	Ok((names, preview_visibility(UnionParsedDecl({
		name = name, type_params = parameters, variants = variants, form = form,
		doc = preview_documentation(declaration.documentation), span = legacy_location(declaration.span)
	}), declaration.visibility, declaration.span)))


private pure func preview_variants(
	source: PreviewSource, names: NameTable, written: List[TreeDeclarations.VariantDeclaration],
) -> Result[(NameTable, List[ParsedVariantDecl]), LegacyDeclarationPreviewError]:
	var extended: NameTable = names
	var variants: List[ParsedVariantDecl] = []
	var failure: Option[LegacyDeclarationPreviewError] = None

	for variant in written:
		(after_name, name) = preview_identifier(source, extended, variant.name)
		payload: List[TreeTypes.TypeArgument] = variant.payload.map(pure func(written): TreeTypes.TypeArgumentType(written))

		match preview_arguments(source, after_name, payload):
			Ok((after_payload, fields)):
				extended = after_payload
				variants = variants.append({ name = name, fields = fields, span = legacy_location(variant.span) })
			Err(error):
				failure = Some(error)
				break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok((extended, variants))


record LegacyEnumPreview {
	declaration: ParsedDecl,
	names: NameTable
}


pure func legacy_enum_preview(preview: EnumPreview) -> Result[LegacyEnumPreview, LegacyDeclarationPreviewError]:
	translated ?= preview_enum_declaration(enum_source(preview), EMPTY_NAME_TABLE, enum_declaration(preview))
	(names, declaration) = translated
	Ok({ declaration = declaration, names = names })


private pure func preview_enum_declaration(
	source: PreviewSource, initial_names: NameTable, declaration: TreeDeclarations.EnumDeclaration,
) -> Result[(NameTable, ParsedDecl), LegacyDeclarationPreviewError]:
	(after_name, name) = preview_identifier(source, initial_names, declaration.name)
	var names: NameTable = after_name
	var variants: List[ParsedVariantDecl] = []

	for case in declaration.cases:
		(after_case, case_name) = preview_identifier(source, names, case.name)
		names = after_case
		variants = variants.append({ name = case_name, fields = [], span = legacy_location(case.span) })

	Ok((names, preview_visibility(UnionParsedDecl({
		name = name, type_params = [], variants = variants, form = LegacyEnum,
		doc = preview_documentation(declaration.documentation), span = legacy_location(declaration.span)
	}), declaration.visibility, declaration.span)))


---
Completed declaration evidence with a shared legacy name table. This bounded
projection never asserts that a module or its deferred bodies were accepted.
---
record LegacyDeclarationProjection {
	module_doc: Option[ParsedModuleDoc],
	declarations: List[ParsedDecl],
	names: NameTable,
	stop: LegacyDeclarationProjectionStop
}


---
Translated function syntax and deferred body evidence. The header cannot carry
a function body or the complete declaration's endpoint.
---
record LegacyFunctionHeaderPreview {
	header: ParsedFunctionHeader,
	visibility: Kinds.Visibility,
	body_extent: FunctionBodyExtent,
	header_span: Span,
	body_colon: Span
}


---
Translated global header syntax and the scanner's deferred initializer entry.
The initializer expression and its endpoint remain outside this projection.
---
record LegacyGlobalInitializerEntry {
	assignment_equal: Span,
	initializer_entry: Span,
	anchor: Span
}


record LegacyGlobalHeaderPreview {
	header: ParsedVarHeader,
	visibility: Kinds.Visibility,
	header_span: Span,
	initializer: LegacyGlobalInitializerEntry
}


-- Keep method syntax paired with its lexical body evidence and boundary.
-- Owner headers are derived from these records rather than parallel lists.
record LegacyTraitMethodHeaderPreview {
	header: ParsedTraitMethodHeader,
	body_extent: MethodBodyExtent,
	header_span: Span
}


record LegacyTraitHeaderPreview {
	name: ParsedIdentifier,
	type_params: List[ParsedTypeParamDecl],
	supertraits: List[ParsedTraitReference],
	methods: List[LegacyTraitMethodHeaderPreview],
	doc: Option[String],
	visibility: Kinds.Visibility,
	owner_span: Span
}


pure func legacy_trait_header(preview: LegacyTraitHeaderPreview) -> ParsedTraitHeader:
	{
		name = preview.name, type_params = preview.type_params, supertraits = preview.supertraits,
		methods = preview.methods.map(pure func(method): method.header), doc = preview.doc
	}


record LegacyImplementationMethodHeaderPreview {
	header: ParsedFunctionHeader,
	body: DeferredBody,
	header_span: Span
}


record LegacyImplementationHeaderPreview {
	trait_name: ParsedIdentifier,
	for_type: ParsedTypeExpr,
	methods: List[LegacyImplementationMethodHeaderPreview],
	doc: Option[String],
	visibility: Kinds.Visibility,
	owner_span: Span
}


pure func legacy_implementation_header(preview: LegacyImplementationHeaderPreview) -> ParsedImplHeader:
	{
		trait_name = preview.trait_name, for_type = preview.for_type,
		methods = preview.methods.map(pure func(method): method.header), doc = preview.doc
	}


union LegacyDeclarationProjectionStop:
	ReachedEndOfSource
	StoppedAtFunctionHeader(LegacyFunctionHeaderPreview)
	StoppedAtTraitPreview(LegacyTraitHeaderPreview)
	StoppedAtImplementationPreview(LegacyImplementationHeaderPreview)
	StoppedAtGlobalInitializer(LegacyGlobalHeaderPreview)
	StoppedAtRejectedGlobalInitializer(DeferredInitializerStart)
	StoppedAtRejectedDeclaration
	StoppedWithoutDeclarationProgress


private union PreviewDeclarationProjection:
	CompletedPreviewDeclaration(NameTable, ParsedDecl)
	DeferredPreviewDeclaration(NameTable, LegacyDeclarationProjectionStop)


pure func legacy_declaration_projection(
	source: PreviewSource, scan: TreeScan.ModuleDeclarationPreviewScan, names: NameTable,
) -> Result[LegacyDeclarationProjection, LegacyDeclarationPreviewError]:
	var extended: NameTable = names
	var declarations: List[ParsedDecl] = []
	var deferred_stop: Option[LegacyDeclarationProjectionStop] = None

	var failure: Option[LegacyDeclarationPreviewError] = None
	for preview in scan.declarations:
		match preview_declaration(source, extended, preview):
			Ok(CompletedPreviewDeclaration(after_declaration, declaration)):
				extended = after_declaration
				declarations = declarations.append(declaration)
			Ok(DeferredPreviewDeclaration(after_header, deferred)):
				extended = after_header
				-- The scanner may hold later previews. Their names and syntax
				-- cannot enter this prefix until its deferred owner is implemented.
				deferred_stop = Some(deferred)
				break
			Err(error):
				failure = Some(error)
				break

	module_doc: Option[ParsedModuleDoc] = match scan.documentation:
		None:
			None
		Some(documentation):
			Some({ text = documentation.text, span = legacy_location(documentation.span) })
	-- Only select the scan's global stop after all completed declarations. An
	-- earlier deferred declaration owns the boundary and excludes later names.
	stop_translation: Result[(NameTable, LegacyDeclarationProjectionStop), LegacyDeclarationPreviewError] = match failure:
		Some(error):
			Err(error)
		None:
			match deferred_stop:
				Some(stop):
					Ok((extended, stop))
				None:
					match scan.stop:
						TreeScan.ReachedEndOfSource:
							Ok((extended, ReachedEndOfSource))
						TreeScan.StoppedAtGlobalInitializer(preview):
							match preview_global_header(source, extended, preview):
								Ok((after_header, header)):
									Ok((after_header, StoppedAtGlobalInitializer(header)))
								Err(error):
									Err(error)
						TreeScan.StoppedAtRejectedGlobalInitializer(start):
							Ok((extended, StoppedAtRejectedGlobalInitializer(start)))
						TreeScan.StoppedAtRejectedDeclaration:
							Ok((extended, StoppedAtRejectedDeclaration))
						TreeScan.StoppedWithoutDeclarationProgress:
							Ok((extended, StoppedWithoutDeclarationProgress))
	selected_stop ?= stop_translation
	(projected_names, stop) = selected_stop
	Ok({ module_doc = module_doc, declarations = declarations, names = projected_names, stop = stop })


private pure func preview_declaration(
	source: PreviewSource, names: NameTable, preview: TreePreviews.DeclarationPreview,
) -> Result[PreviewDeclarationProjection, LegacyDeclarationPreviewError]:
	match preview:
		TreePreviews.GlobalDeclarationPreview(declaration):
			translated ?= preview_completed_global(source, names, declaration)
			(extended, parsed) = translated
			Ok(CompletedPreviewDeclaration(extended, parsed))
		TreePreviews.RecordDeclarationPreview(declaration):
			translated ?= preview_record_declaration(source, names, declaration)
			(extended, parsed) = translated
			Ok(CompletedPreviewDeclaration(extended, parsed))
		TreePreviews.AliasDeclarationPreview(declaration):
			translated ?= preview_alias_declaration(source, names, declaration)
			(extended, parsed) = translated
			Ok(CompletedPreviewDeclaration(extended, parsed))
		TreePreviews.BuiltinTypeDeclarationPreview(declaration):
			translated ?= preview_builtin_declaration(source, names, declaration)
			(extended, parsed) = translated
			Ok(CompletedPreviewDeclaration(extended, parsed))
		TreePreviews.ResourceTypeDeclarationPreview(declaration):
			translated ?= preview_resource_declaration(source, names, declaration)
			(extended, parsed) = translated
			Ok(CompletedPreviewDeclaration(extended, parsed))
		TreePreviews.UnionDeclarationPreview(declaration):
			translated ?= preview_union_declaration(source, names, declaration)
			(extended, parsed) = translated
			Ok(CompletedPreviewDeclaration(extended, parsed))
		TreePreviews.EnumDeclarationPreview(declaration):
			translated ?= preview_enum_declaration(source, names, declaration)
			(extended, parsed) = translated
			Ok(CompletedPreviewDeclaration(extended, parsed))
		TreePreviews.ImportBlockDeclarationPreview(block):
			(extended, parsed) = preview_import_block(source, names, block)
			Ok(CompletedPreviewDeclaration(extended, parsed))
		TreePreviews.ForeignBlockDeclarationPreview(block):
			translated ?= preview_foreign_block(source, names, block)
			(extended, parsed) = translated
			Ok(CompletedPreviewDeclaration(extended, parsed))
		TreePreviews.FunctionDeclarationPreview(preview):
			translated ?= preview_function_header(source, names, preview)
			(extended, header) = translated
			Ok(DeferredPreviewDeclaration(extended, StoppedAtFunctionHeader(header)))
		TreePreviews.CompletedFunctionPreview(declaration):
			translated ?= preview_completed_function(source, names, declaration)
			(extended, parsed) = translated
			Ok(CompletedPreviewDeclaration(extended, parsed))
		TreePreviews.CompletedTraitPreview(declaration):
			translated ?= preview_completed_trait(source, names, declaration)
			(extended, parsed) = translated
			Ok(CompletedPreviewDeclaration(extended, parsed))
		TreePreviews.CompletedImplementationPreview(declaration):
			translated ?= preview_completed_implementation(source, names, declaration)
			(extended, parsed) = translated
			Ok(CompletedPreviewDeclaration(extended, parsed))
		TreePreviews.TraitDeclarationPreview(preview):
			translated ?= preview_trait_header(source, names, preview)
			(extended, header) = translated
			Ok(DeferredPreviewDeclaration(extended, StoppedAtTraitPreview(header)))
		TreePreviews.ImplementationDeclarationPreview(preview):
			translated ?= preview_implementation_header(source, names, preview)
			(extended, header) = translated
			Ok(DeferredPreviewDeclaration(extended, StoppedAtImplementationPreview(header)))


private pure func preview_completed_global(
	source: PreviewSource, names: NameTable, declaration: TreeDeclarations.GlobalDeclaration,
) -> Result[(NameTable, ParsedDecl), LegacyDeclarationPreviewError]:
	(after_name, name) = preview_identifier(source, names, declaration.name)
	translated_type ?= preview_optional_type(source, after_name, declaration.declared_type)
	(after_type, type_expr) = translated_type
	value_translation ?= legacy_expression_preview(source, after_type, declaration.value)
	(after_value, value) = value_translation
	Ok((after_value, preview_visibility(VarParsedDecl({
		name = name, type_expr = type_expr, value = value,
		is_mutable = declaration.form == TreeDeclarations.MutableGlobal,
		doc = preview_documentation(declaration.documentation), span = legacy_location(declaration.span)
	}), declaration.visibility, declaration.span)))


-- Continuations retain completed children while their siblings are visited.
-- Descent and completed values are separate states, so binary and postfix
-- left spines never recurse and names are interned in written order.
private union PreviewPairOperator:
	PreviewBinaryOperator(ParsedBinaryOp)
	PreviewLogicalOperator(ParsedLogicalOp)
	PreviewRangeOperator


private enum PreviewArgumentOperator:
	PreviewCallOperator
	PreviewSubscriptOperator


private enum PreviewSequenceKind:
	PreviewListSequence
	PreviewTupleSequence
	PreviewVectorSequence


-- What a record's fields complete: a literal, or an update of an expression
-- that is already projected.
private union PreviewRecordShape:
	PreviewRecordLiteral
	PreviewRecordUpdate(ParsedExpr)


-- Where the fields of a record stand: finished, or a value still to project
-- under the continuation that will take it.
private union PreviewFieldStep:
	PreviewFieldsDone(ParsedExpr)
	PreviewFieldValue(PreviewExpressionContinuation, TreeExpressions.Expression)


private union PreviewExpressionContinuation:
	FinishPreviewField(WrittenName, Span)
	VisitPreviewArguments(PreviewArgumentOperator, List[TreeExpressions.Expression], Span)
	FinishPreviewArgument(PreviewArgumentOperator, ParsedExpr, List[TreeExpressions.Expression], Int, List[ParsedExpr], Span)
	FinishPreviewSequenceItem(PreviewSequenceKind, List[TreeExpressions.Expression], Int, List[ParsedExpr], Span)
	StartPreviewUpdateFields(List[TreeExpressions.NamedValue], Span)
	FinishPreviewRecordField(PreviewRecordShape, List[TreeExpressions.NamedValue], Int, List[ParsedRecordExprField], ParsedIdentifier, Span, Span)
	FinishPreviewDictKey(TreeExpressions.Expression, Span, List[TreeExpressions.DictEntry], Int, List[ParsedDictEntry], Span)
	FinishPreviewDictValue(ParsedExpr, Span, List[TreeExpressions.DictEntry], Int, List[ParsedDictEntry], Span)
	FinishPreviewInterpolationHole(PreviewInterpolation, Span)
	FinishPreviewUnary(ParsedUnaryOp, Span)
	VisitPreviewRight(PreviewPairOperator, TreeExpressions.Expression, Span)
	FinishPreviewPair(PreviewPairOperator, ParsedExpr, Span)


-- An interpolated string being rebuilt: its pieces, the next one to read, the
-- parts rebuilt so far, and its own form and span.
private record PreviewInterpolation {
	pieces: List[TreeExpressions.InterpolationPiece],
	next: Int,
	parts: List[ParsedStringInterpolationPart],
	is_multiline: Bool,
	span: Span
}


-- Text pieces are appended as they are met; the walk stops at the next hole,
-- whose value the expression walk must visit before the string continues.
private union PreviewInterpolationStep:
	ReadPreviewHole(TreeExpressions.Hole, PreviewInterpolation)
	FinishedPreviewInterpolation(ParsedExpr)


private pure func next_interpolation_step(interpolation: PreviewInterpolation) -> PreviewInterpolationStep:
	var parts: List[ParsedStringInterpolationPart] = interpolation.parts
	var index: Int = interpolation.next
	var hole: Option[TreeExpressions.Hole] = None
	while hole.is_none() and index < interpolation.pieces.length():
		match interpolation.pieces.get(index):
			Some(TreeExpressions.InterpolationText(text)):
				parts = parts.append(ParsedInterpolationLiteral(text))
			Some(TreeExpressions.InterpolationHole(found)):
				hole = Some(found)
			None:
				void
		index += 1
	match hole:
		Some(found):
			ReadPreviewHole(found, { interpolation | next = index, parts = parts })
		None:
			FinishedPreviewInterpolation(ParsedStringInterpolationPartsExpr(parts, interpolation.is_multiline, legacy_location(interpolation.span)))


private union PreviewExpressionWalk:
	VisitPreviewExpression(TreeExpressions.Expression)
	ReturnPreviewExpression(ParsedExpr)


-- Rebuild supported expression syntax and intern names in written order.
-- Numeric text belongs to lexical evidence, independently of grouping spans.
pure func legacy_expression_preview(
	source: PreviewSource, names: NameTable, value: TreeExpressions.Expression,
) -> Result[(NameTable, ParsedExpr), LegacyDeclarationPreviewError]:
	var extended: NameTable = names
	var walk: PreviewExpressionWalk = VisitPreviewExpression(value)
	var continuations: List[PreviewExpressionContinuation] = []
	-- Every exit supplies a completed value or a precise projection error.
	var result: Result[(NameTable, ParsedExpr), LegacyDeclarationPreviewError] = Err(UnsupportedGlobalInitializerExpression(value.span))
	while True:
		match walk:
			VisitPreviewExpression(current):
				location = legacy_location(current.span)
				match current.kind:
					TreeExpressions.NameReference(use):
						(after_name, name) = preview_identifier(source, extended, use.name)
						extended = after_name
						walk = ReturnPreviewExpression(ParsedNameExpr(name))
					TreeExpressions.IntegerLiteral(_):
						match preview_integer_literal_text(source, current.span):
							Some(digits): walk = ReturnPreviewExpression(ParsedIntLiteralExpr(digits, location))
							None:
								result = Err(MissingIntegerLiteralToken(current.span))
								break
					TreeExpressions.FloatLiteral(literal):
						walk = ReturnPreviewExpression(ParsedFloatLiteralExpr(literal.written_digits(), location))
					TreeExpressions.StringLiteral(form, text):
						walk = ReturnPreviewExpression(ParsedStringLiteralExpr(text, legacy_string_form(form), location))
					TreeExpressions.CharacterLiteral(character):
						walk = ReturnPreviewExpression(ParsedCharLiteralExpr(character.to_int(), location))
					TreeExpressions.InterpolatedString(form, pieces):
						is_multiline: Bool = match form:
							TreeExpressions.QuotedInterpolation: False
							TreeExpressions.PipeInterpolation: True
						match next_interpolation_step({ pieces = pieces, next = 0, parts = [], is_multiline = is_multiline, span = current.span }):
							ReadPreviewHole(hole, interpolation):
								continuations = continuations.append(FinishPreviewInterpolationHole(interpolation, hole.span))
								walk = VisitPreviewExpression(hole.value)
							FinishedPreviewInterpolation(finished):
								walk = ReturnPreviewExpression(finished)
					TreeExpressions.BooleanLiteral(literal):
						walk = ReturnPreviewExpression(ParsedBoolLiteralExpr(literal, location))
					TreeExpressions.VoidValue:
						walk = ReturnPreviewExpression(ParsedVoidExpr(location))
					TreeExpressions.Unary(operator, operand):
						legacy_operator: ParsedUnaryOp = match operator:
							TreeExpressions.Negate: ParsedNegateOp
							TreeExpressions.LogicalNot: ParsedNotOp
						continuations = continuations.append(FinishPreviewUnary(legacy_operator, current.span))
						walk = VisitPreviewExpression(operand)
					TreeExpressions.Binary(operator, left, right):
						continuations = continuations.append(VisitPreviewRight(PreviewBinaryOperator(preview_binary_operator(operator)), right, current.span))
						walk = VisitPreviewExpression(left)
					TreeExpressions.ShortCircuit(operator, left, right):
						legacy_operator: ParsedLogicalOp = match operator:
							TreeExpressions.LogicalAnd: ParsedAndOp
							TreeExpressions.LogicalOr: ParsedOrOp
						continuations = continuations.append(VisitPreviewRight(PreviewLogicalOperator(legacy_operator), right, current.span))
						walk = VisitPreviewExpression(left)
					TreeExpressions.FieldAccess(receiver, field):
						continuations = continuations.append(FinishPreviewField(field.name, current.span))
						walk = VisitPreviewExpression(receiver)
					TreeExpressions.Call(callee, arguments):
						continuations = continuations.append(VisitPreviewArguments(PreviewCallOperator, arguments, current.span))
						walk = VisitPreviewExpression(callee)
					TreeExpressions.Subscript(receiver, indices):
						continuations = continuations.append(VisitPreviewArguments(PreviewSubscriptOperator, at_least_one_items(indices), current.span))
						walk = VisitPreviewExpression(receiver)
					TreeExpressions.ListLiteral(items):
						match items.get(0):
							None:
								walk = ReturnPreviewExpression(ParsedListExpr([], location))
							Some(first):
								continuations = continuations.append(FinishPreviewSequenceItem(PreviewListSequence, items, 1, [], current.span))
								walk = VisitPreviewExpression(first)
					TreeExpressions.VectorLiteral(items):
						match items.get(0):
							None:
								walk = ReturnPreviewExpression(ParsedVectorExpr([], location))
							Some(first):
								continuations = continuations.append(FinishPreviewSequenceItem(PreviewVectorSequence, items, 1, [], current.span))
								walk = VisitPreviewExpression(first)
					TreeExpressions.RecordLiteral(fields):
						(after_names, step) = preview_record_field(source, extended, PreviewRecordLiteral, fields, 0, [], current.span)
						extended = after_names
						match step:
							PreviewFieldsDone(finished):
								walk = ReturnPreviewExpression(finished)
							PreviewFieldValue(continuation, value):
								continuations = continuations.append(continuation)
								walk = VisitPreviewExpression(value)
					TreeExpressions.RecordUpdate(base, fields):
						continuations = continuations.append(StartPreviewUpdateFields(fields, current.span))
						walk = VisitPreviewExpression(base)
					TreeExpressions.DictLiteral(entries):
						match entries.get(0):
							None:
								walk = ReturnPreviewExpression(ParsedDictExpr([], location))
							Some(first):
								continuations = continuations.append(FinishPreviewDictKey(first.value, first.span, entries, 1, [], current.span))
								walk = VisitPreviewExpression(first.key)
					TreeExpressions.TupleLiteral(tuple):
						continuations = continuations.append(FinishPreviewSequenceItem(PreviewTupleSequence, small_tuple_items(tuple), 1, [], current.span))
						walk = VisitPreviewExpression(small_tuple_first(tuple))
					TreeExpressions.RangeExpression(left, right):
						continuations = continuations.append(VisitPreviewRight(PreviewRangeOperator, right, current.span))
						walk = VisitPreviewExpression(left)
					_:
						result = Err(UnsupportedGlobalInitializerExpression(current.span))
						break
			ReturnPreviewExpression(completed):
				match continuations.get(continuations.length() - 1):
					None:
						result = Ok((extended, completed))
						break
					Some(continuation):
						continuations = continuations.drop_last()
						match continuation:
							FinishPreviewField(field, span):
								(after_name, name) = preview_identifier(source, extended, field)
								extended = after_name
								walk = ReturnPreviewExpression(ParsedFieldAccessExpr(completed, name, legacy_location(span)))
							VisitPreviewArguments(operator, arguments, span):
								match arguments.get(0):
									None:
										walk = ReturnPreviewExpression(preview_argument_expression(operator, completed, [], span))
									Some(first):
										continuations = continuations.append(FinishPreviewArgument(operator, completed, arguments, 1, [], span))
										walk = VisitPreviewExpression(first)
							FinishPreviewArgument(operator, receiver, arguments, next, parsed, span):
								completed_arguments = parsed.append(completed)
								match arguments.get(next):
									None:
										walk = ReturnPreviewExpression(preview_argument_expression(operator, receiver, completed_arguments, span))
									Some(argument):
										continuations = continuations.append(FinishPreviewArgument(operator, receiver, arguments, next + 1, completed_arguments, span))
										walk = VisitPreviewExpression(argument)
							FinishPreviewSequenceItem(kind, items, next, parsed, span):
								completed_items = parsed.append(completed)
								match items.get(next):
									None:
										sequence: ParsedExpr = match kind:
											PreviewListSequence: ParsedListExpr(completed_items, legacy_location(span))
											PreviewTupleSequence: ParsedTupleExpr(completed_items, legacy_location(span))
											PreviewVectorSequence: ParsedVectorExpr(completed_items, legacy_location(span))
										walk = ReturnPreviewExpression(sequence)
									Some(item):
										continuations = continuations.append(FinishPreviewSequenceItem(kind, items, next + 1, completed_items, span))
										walk = VisitPreviewExpression(item)
							StartPreviewUpdateFields(fields, span):
								(after_names, step) = preview_record_field(source, extended, PreviewRecordUpdate(completed), fields, 0, [], span)
								extended = after_names
								match step:
									PreviewFieldsDone(finished):
										walk = ReturnPreviewExpression(finished)
									PreviewFieldValue(continuation, value):
										continuations = continuations.append(continuation)
										walk = VisitPreviewExpression(value)
							FinishPreviewRecordField(shape, fields, next, done, name, field_span, span):
								completed_field: ParsedRecordExprField = { name = name, value = completed, span = legacy_location(field_span) }
								(after_names, step) = preview_record_field(source, extended, shape, fields, next, done.append(completed_field), span)
								extended = after_names
								match step:
									PreviewFieldsDone(finished):
										walk = ReturnPreviewExpression(finished)
									PreviewFieldValue(continuation, value):
										continuations = continuations.append(continuation)
										walk = VisitPreviewExpression(value)
							FinishPreviewDictKey(value, entry_span, entries, next, done, span):
								continuations = continuations.append(FinishPreviewDictValue(completed, entry_span, entries, next, done, span))
								walk = VisitPreviewExpression(value)
							FinishPreviewDictValue(key, entry_span, entries, next, done, span):
								completed_entries = done.append({ key = key, value = completed, span = legacy_location(entry_span) })
								match entries.get(next):
									None:
										walk = ReturnPreviewExpression(ParsedDictExpr(completed_entries, legacy_location(span)))
									Some(entry):
										continuations = continuations.append(FinishPreviewDictKey(entry.value, entry.span, entries, next + 1, completed_entries, span))
										walk = VisitPreviewExpression(entry.key)
							FinishPreviewInterpolationHole(interpolation, hole_span):
								read: PreviewInterpolation = { interpolation | parts = interpolation.parts.append(ParsedInterpolationExpr(completed, legacy_location(hole_span))) }
								match next_interpolation_step(read):
									ReadPreviewHole(hole, next_interpolation):
										continuations = continuations.append(FinishPreviewInterpolationHole(next_interpolation, hole.span))
										walk = VisitPreviewExpression(hole.value)
									FinishedPreviewInterpolation(finished):
										walk = ReturnPreviewExpression(finished)
							FinishPreviewUnary(operator, span):
								walk = ReturnPreviewExpression(ParsedUnaryExpr(operator, completed, legacy_location(span)))
							VisitPreviewRight(operator, right, span):
								continuations = continuations.append(FinishPreviewPair(operator, completed, span))
								walk = VisitPreviewExpression(right)
							FinishPreviewPair(operator, left, span):
								location = legacy_location(span)
								parsed: ParsedExpr = match operator:
									PreviewBinaryOperator(binary): ParsedBinaryExpr(binary, left, completed, location)
									PreviewLogicalOperator(logical): ParsedLogicalExpr(logical, left, completed, location)
									PreviewRangeOperator: ParsedRangeExpr(left, completed, location)
								walk = ReturnPreviewExpression(parsed)
	result


-- The next field of a record literal or update: its name is interned before
-- its value is projected, so names follow written order. Past the last field
-- the record is complete.
private pure func preview_record_field(
	source: PreviewSource, names: NameTable, shape: PreviewRecordShape, fields: List[TreeExpressions.NamedValue],
	next: Int, done: List[ParsedRecordExprField], span: Span,
) -> (NameTable, PreviewFieldStep):
	match fields.get(next):
		None:
			finished: ParsedExpr = match shape:
				PreviewRecordLiteral: ParsedRecordExpr(done, legacy_location(span))
				PreviewRecordUpdate(base): ParsedRecordUpdateExpr(base, done, legacy_location(span))
			(names, PreviewFieldsDone(finished))
		Some(field):
			(after_name, name) = preview_identifier(source, names, field.name.name)
			(after_name, PreviewFieldValue(FinishPreviewRecordField(shape, fields, next + 1, done, name, field.span, span), field.value))


private pure func legacy_string_form(form: TreePatterns.StringForm) -> ParsedStringLiteralForm:
	match form:
		TreePatterns.QuotedString: ParsedPlainStringLiteral
		TreePatterns.RawString: ParsedRawStringLiteral
		TreePatterns.PipeString: ParsedPipeStringLiteral
		TreePatterns.RawPipeString: ParsedRawPipeStringLiteral


private pure func preview_argument_expression(
	operator: PreviewArgumentOperator, receiver: ParsedExpr, arguments: List[ParsedExpr], span: Span,
) -> ParsedExpr:
	match operator:
		PreviewCallOperator: ParsedCallExpr(receiver, arguments, legacy_location(span))
		PreviewSubscriptOperator: ParsedSubscriptExpr(receiver, arguments, legacy_location(span))


private pure func preview_binary_operator(operator: TreeExpressions.BinaryOperator) -> ParsedBinaryOp:
	match operator:
		TreeExpressions.Add: ParsedAddOp
		TreeExpressions.Subtract: ParsedSubtractOp
		TreeExpressions.Multiply: ParsedMultiplyOp
		TreeExpressions.Divide: ParsedDivideOp
		TreeExpressions.Modulo: ParsedModuloOp
		TreeExpressions.Equal: ParsedEqualOp
		TreeExpressions.NotEqual: ParsedNotEqualOp
		TreeExpressions.Less: ParsedLessOp
		TreeExpressions.LessEqual: ParsedLessEqualOp
		TreeExpressions.Greater: ParsedGreaterOp
		TreeExpressions.GreaterEqual: ParsedGreaterEqualOp


-- A completed function: its header as for a deferred one, then its body
-- projected the way the frozen parser shapes it.
private pure func preview_completed_function(
	source: PreviewSource, names: NameTable, declaration: TreeDeclarations.FunctionDeclaration,
) -> Result[(NameTable, ParsedDecl), LegacyDeclarationPreviewError]:
	function = declaration.function
	translated ?= preview_callable_header(source, names, function.signature, function.type_parameters,
		function.constraints, declaration.annotations, preview_documentation(declaration.documentation))
	(after_header, header) = translated
	translated_body ?= legacy_optional_body_preview(source, after_header, function.body)
	(after_body, body) = translated_body
	Ok((after_body, preview_visibility(FunctionParsedDecl({
		name = header.name, keyword_span = header.keyword_span, type_params = header.type_params, params = header.params,
		return_type = header.return_type, dim_constraints = header.dim_constraints, body = body, is_pure = header.is_pure,
		annotations = header.annotations, doc = header.doc, span = legacy_location(declaration.span)
	}), declaration.visibility, declaration.span)))


-- A completed trait: its header as for a deferred one, each method's header
-- then its default body in written order.
private pure func preview_completed_trait(
	source: PreviewSource, names: NameTable, declaration: TreeDeclarations.TraitDeclaration,
) -> Result[(NameTable, ParsedDecl), LegacyDeclarationPreviewError]:
	(after_name, name) = preview_identifier(source, names, declaration.name)
	(after_type_parameters, type_parameters) = preview_type_parameters(source, after_name, declaration.type_parameters)
	var extended: NameTable = after_type_parameters
	var supertraits: List[ParsedTraitReference] = []
	for bound in declaration.supertraits:
		(after_bound, translated) = preview_bound(source, extended, bound)
		extended = after_bound
		supertraits = supertraits.append(translated)
	var methods: List[ParsedTraitMethodDecl] = []
	var failure: Option[LegacyDeclarationPreviewError] = None
	for method in declaration.methods:
		match preview_completed_trait_method(source, extended, method):
			Ok((after_method, parsed)):
				extended = after_method
				methods = methods.append(parsed)
			Err(error):
				failure = Some(error)
				break
	match failure:
		Some(error):
			Err(error)
		None:
			Ok((extended, preview_visibility(TraitParsedDecl({
				name = name, type_params = type_parameters, supertraits = supertraits, methods = methods,
				doc = preview_documentation(declaration.documentation), span = legacy_location(declaration.span)
			}), declaration.visibility, declaration.span)))


private pure func preview_completed_trait_method(
	source: PreviewSource, names: NameTable, method: TreeDeclarations.TraitMethod,
) -> Result[(NameTable, ParsedTraitMethodDecl), LegacyDeclarationPreviewError]:
	signature = method.signature
	(after_name, name) = preview_identifier(source, names, signature.name)
	translated_parameters ?= preview_parameters(source, after_name, signature.parameters)
	(after_parameters, parameters) = translated_parameters
	translated_return ?= preview_optional_type(source, after_parameters, signature.return_type)
	(after_return, return_type) = translated_return
	translated_body ?= legacy_optional_body_preview(source, after_return, method.default_body)
	(after_body, body) = translated_body
	Ok((after_body, {
		name = name, params = parameters, return_type = return_type, body = body,
		is_pure = signature.purity == Kinds.PureFunction, span = legacy_location(method.span)
	}))


private pure func preview_completed_implementation(
	source: PreviewSource, names: NameTable, declaration: TreeDeclarations.ImplementationDeclaration,
) -> Result[(NameTable, ParsedDecl), LegacyDeclarationPreviewError]:
	(after_trait, trait_name) = preview_identifier(source, names, declaration.trait_name.name)
	translated_receiver ?= preview_type(source, after_trait, declaration.receiver)
	(after_receiver, receiver) = translated_receiver
	var extended: NameTable = after_receiver
	var methods: List[ParsedFunctionDecl] = []
	var failure: Option[LegacyDeclarationPreviewError] = None
	for method in declaration.methods:
		match preview_completed_implementation_method(source, extended, method):
			Ok((after_method, parsed)):
				extended = after_method
				methods = methods.append(parsed)
			Err(error):
				failure = Some(error)
				break
	match failure:
		Some(error):
			Err(error)
		None:
			Ok((extended, preview_visibility(ImplParsedDecl({
				trait_name = trait_name, for_type = receiver, methods = methods,
				doc = preview_documentation(declaration.documentation), span = legacy_location(declaration.span)
			}), declaration.visibility, declaration.span)))


private pure func preview_completed_implementation_method(
	source: PreviewSource, names: NameTable, method: TreeDeclarations.ImplementationMethod,
) -> Result[(NameTable, ParsedFunctionDecl), LegacyDeclarationPreviewError]:
	function = method.function
	translated ?= preview_callable_header(source, names, function.signature, function.type_parameters,
		function.constraints, method.annotations, None)
	(after_header, header) = translated
	translated_body ?= legacy_optional_body_preview(source, after_header, function.body)
	(after_body, body) = translated_body
	Ok((after_body, {
		name = header.name, keyword_span = header.keyword_span, type_params = header.type_params, params = header.params,
		return_type = header.return_type, dim_constraints = header.dim_constraints, body = body, is_pure = header.is_pure,
		annotations = header.annotations, doc = header.doc, span = legacy_location(method.span)
	}))


private pure func legacy_optional_body_preview(
	source: PreviewSource, names: NameTable, body: Option[TreeExpressions.Body],
) -> Result[(NameTable, Option[ParsedExpr]), LegacyDeclarationPreviewError]:
	match body:
		Some(written):
			translated ?= legacy_body_preview(source, names, written)
			(extended, projected) = translated
			Ok((extended, Some(projected)))
		None:
			Ok((names, None))


-- The name the frozen parser gives a discarded binder.
private PREVIEW_DISCARD_NAME: String = "_"


-- Bodies, blocks and statements. Statements are expressions in the frozen
-- AST. A block's statements and an `else if` chain are walked by loops;
-- recursion follows only the nesting the source's indentation writes.
pure func legacy_body_preview(
	source: PreviewSource, names: NameTable, body: TreeExpressions.Body,
) -> Result[(NameTable, ParsedExpr), LegacyDeclarationPreviewError]:
	match body:
		TreeExpressions.BlockBody(block):
			legacy_block_preview(source, names, block)
		TreeExpressions.ExpressionBody(expression):
			legacy_expression_preview(source, names, expression)


private pure func legacy_block_preview(
	source: PreviewSource, names: NameTable, block: TreeExpressions.Block,
) -> Result[(NameTable, ParsedExpr), LegacyDeclarationPreviewError]:
	var extended: NameTable = names
	var items: List[ParsedExpr] = []
	var failure: Option[LegacyDeclarationPreviewError] = None
	for statement in block.leading.append(block.last):
		match legacy_statement_preview(source, extended, statement):
			Ok((after_statement, item)):
				extended = after_statement
				items = items.append(item)
			Err(error):
				failure = Some(error)
				break
	match failure:
		Some(error):
			Err(error)
		None:
			Ok((extended, ParsedBlockExpr(items, legacy_location(block.span))))


-- Blocks nest by indentation and hold statements, so the functions between a
-- statement and the statements of its blocks are on the native stack once per
-- level. Each kind is projected by a function of its own and this dispatcher
-- stays thin, which keeps the 1,000-deep proof of section 3.14 inside the
-- Linux stack.
private pure func legacy_statement_preview(
	source: PreviewSource, names: NameTable, statement: TreeExpressions.Statement,
) -> Result[(NameTable, ParsedExpr), LegacyDeclarationPreviewError]:
	location: SourceLocation = legacy_location(statement.span)
	match statement.kind:
		TreeExpressions.ExpressionStatement(expression):
			legacy_statement_expression_preview(source, names, expression)
		TreeExpressions.VariableDeclaration(declaration):
			legacy_variable_preview(source, names, declaration, location)
		TreeExpressions.TypedBinding(binding):
			legacy_typed_binding_preview(source, names, binding, location)
		TreeExpressions.Assignment(assignment):
			legacy_assignment_preview(source, names, assignment, location)
		TreeExpressions.CompoundAssignment(assignment):
			legacy_compound_assignment_preview(source, names, assignment, location)
		TreeExpressions.SubscriptAssignment(assignment):
			legacy_subscript_assignment_preview(source, names, assignment, location)
		TreeExpressions.WhileLoop(loop):
			translated_condition ?= legacy_expression_preview(source, names, loop.condition)
			(after_condition, condition) = translated_condition
			translated_body ?= legacy_block_preview(source, after_condition, loop.body)
			(after_body, body) = translated_body
			Ok((after_body, ParsedWhileExpr(condition, body, location)))
		TreeExpressions.ForLoop(loop):
			legacy_for_preview(source, names, loop, location)
		TreeExpressions.QuestionBinding(binding):
			legacy_question_binding_preview(source, names, binding, location)
		_:
			Err(UnsupportedBodyStatement(statement.span))


private pure func legacy_variable_preview(
	source: PreviewSource, names: NameTable, declaration: TreeExpressions.VariableStatement, location: SourceLocation,
) -> Result[(NameTable, ParsedExpr), LegacyDeclarationPreviewError]:
	match declaration.target:
		BindsName(binder):
			(after_name, name) = preview_identifier(source, names, binder.name)
			translated_type ?= preview_optional_type(source, after_name, declaration.declared_type)
			(after_type, type_expr) = translated_type
			translated_value ?= legacy_value_preview(source, after_type, declaration.value)
			(after_value, value) = translated_value
			Ok((after_value, ParsedVarDeclExpr(name, type_expr, value, True, location)))
		DiscardsValue(span):
			Err(UnsupportedBodyStatement(span))


private pure func legacy_typed_binding_preview(
	source: PreviewSource, names: NameTable, binding: TreeExpressions.TypedBindingStatement, location: SourceLocation,
) -> Result[(NameTable, ParsedExpr), LegacyDeclarationPreviewError]:
	match binding.target:
		BindsName(binder):
			(after_name, name) = preview_identifier(source, names, binder.name)
			translated_type ?= preview_type(source, after_name, binding.declared_type)
			(after_type, type_expr) = translated_type
			translated_value ?= legacy_value_preview(source, after_type, binding.value)
			(after_value, value) = translated_value
			Ok((after_value, ParsedVarDeclExpr(name, Some(type_expr), value, False, location)))
		DiscardsValue(span):
			Err(UnsupportedBodyStatement(span))


private pure func legacy_assignment_preview(
	source: PreviewSource, names: NameTable, assignment: TreeExpressions.AssignmentStatement, location: SourceLocation,
) -> Result[(NameTable, ParsedExpr), LegacyDeclarationPreviewError]:
	(after_target, name) = match assignment.target:
		TreeExpressions.AssignsName(use):
			preview_identifier(source, names, use.name)
		TreeExpressions.AssignsDiscard(span):
			preview_text_identifier(names, PREVIEW_DISCARD_NAME, span)
	translated_value ?= legacy_value_preview(source, after_target, assignment.value)
	(after_value, value) = translated_value
	Ok((after_value, ParsedAssignExpr(name, value, location)))


private pure func legacy_compound_assignment_preview(
	source: PreviewSource, names: NameTable, assignment: TreeExpressions.CompoundAssignmentStatement, location: SourceLocation,
) -> Result[(NameTable, ParsedExpr), LegacyDeclarationPreviewError]:
	(after_target, name) = preview_identifier(source, names, assignment.target.name)
	operator: ParsedCompoundAssignOp = match assignment.operator:
		TreeExpressions.AddAssign: ParsedAssignAddOp
		TreeExpressions.SubtractAssign: ParsedAssignSubtractOp
		TreeExpressions.MultiplyAssign: ParsedAssignMultiplyOp
		TreeExpressions.DivideAssign: ParsedAssignDivideOp
	translated_value ?= legacy_value_preview(source, after_target, assignment.value)
	(after_value, value) = translated_value
	Ok((after_value, ParsedCompoundAssignExpr(name, operator, value, location)))


private pure func legacy_subscript_assignment_preview(
	source: PreviewSource, names: NameTable, assignment: TreeExpressions.SubscriptAssignmentStatement, location: SourceLocation,
) -> Result[(NameTable, ParsedExpr), LegacyDeclarationPreviewError]:
	translated_collection ?= legacy_expression_preview(source, names, assignment.place.collection)
	(after_collection, collection) = translated_collection
	translated_indices ?= legacy_expressions_preview(source, after_collection, at_least_one_items(assignment.place.indices))
	(extended, indices) = translated_indices
	translated_value ?= legacy_value_preview(source, extended, assignment.value)
	(after_value, value) = translated_value
	Ok((after_value, ParsedSubscriptAssignExpr(collection, indices, value, location)))


private pure func legacy_question_binding_preview(
	source: PreviewSource, names: NameTable, binding: TreeExpressions.QuestionBindingStatement, location: SourceLocation,
) -> Result[(NameTable, ParsedExpr), LegacyDeclarationPreviewError]:
	(after_name, name) = preview_identifier(source, names, binding.binder.name)
	translated_type ?= preview_optional_type(source, after_name, binding.declared_type)
	(after_type, type_expr) = translated_type
	translated_value ?= legacy_value_preview(source, after_type, binding.value)
	(after_value, value) = translated_value
	Ok((after_value, ParsedQuestionBindExpr(name, type_expr, value, location)))


private pure func legacy_for_preview(
	source: PreviewSource, names: NameTable, loop: TreeExpressions.ForStatement, location: SourceLocation,
) -> Result[(NameTable, ParsedExpr), LegacyDeclarationPreviewError]:
	translated_binder ?= legacy_loop_binder_preview(source, names, loop.binder)
	(after_binder, binder) = translated_binder
	translated_iterable ?= legacy_expression_preview(source, after_binder, loop.iterable)
	(after_iterable, iterable) = translated_iterable
	translated_body ?= legacy_block_preview(source, after_iterable, loop.body)
	(after_body, body) = translated_body
	Ok((after_body, ParsedForExpr(binder, iterable, body, location)))


-- A loop's variable, or its tuple of variables with the parenthesized span.
-- A discarded position keeps the name the frozen parser gives it.
private pure func legacy_loop_binder_preview(
	source: PreviewSource, names: NameTable, binder: TreeExpressions.LoopBinder,
) -> Result[(NameTable, ParsedForBinder), LegacyDeclarationPreviewError]:
	match binder:
		TreeExpressions.LoopVariable(target):
			(after_target, name) = legacy_binding_target_name(source, names, target)
			Ok((after_target, ParsedForNameBinder(name)))
		TreeExpressions.LoopTuple(targets, span):
			var extended: NameTable = names
			var tuple_names: List[ParsedIdentifier] = []
			for target in small_tuple_items(targets):
				(after_target, name) = legacy_binding_target_name(source, extended, target)
				extended = after_target
				tuple_names = tuple_names.append(name)
			Ok((extended, ParsedForTupleBinder(tuple_names, legacy_location(span))))


private pure func legacy_binding_target_name(
	source: PreviewSource, names: NameTable, target: BindingTarget,
) -> (NameTable, ParsedIdentifier):
	match target:
		BindsName(binder):
			preview_identifier(source, names, binder.name)
		DiscardsValue(span):
			preview_text_identifier(names, PREVIEW_DISCARD_NAME, span)


-- An expression in statement position: the block-bearing forms are read here,
-- everything else by the expression projection.
private pure func legacy_statement_expression_preview(
	source: PreviewSource, names: NameTable, expression: TreeExpressions.Expression,
) -> Result[(NameTable, ParsedExpr), LegacyDeclarationPreviewError]:
	location: SourceLocation = legacy_location(expression.span)
	match expression.kind:
		TreeExpressions.Break:
			Ok((names, ParsedBreakExpr(location)))
		TreeExpressions.Continue:
			Ok((names, ParsedContinueExpr(location)))
		_:
			legacy_value_preview(source, names, expression)


-- A statement's value: the block-bearing `if` and `match` are read here, and
-- every other expression by the expression projection.
private pure func legacy_value_preview(
	source: PreviewSource, names: NameTable, expression: TreeExpressions.Expression,
) -> Result[(NameTable, ParsedExpr), LegacyDeclarationPreviewError]:
	match expression.kind:
		TreeExpressions.If(conditional):
			legacy_conditional_preview(source, names, conditional, expression.span)
		TreeExpressions.Match(subject, cases):
			legacy_match_preview(source, names, subject, cases, legacy_location(expression.span))
		_:
			legacy_expression_preview(source, names, expression)


-- One `else if` of a chain, projected before the links that follow it. The
-- `else` keyword before it belongs to the branch that holds this link.
private record PreviewElseIfLink {
	else_keyword: Span,
	span: Span,
	condition: ParsedExpr,
	then_block: ParsedExpr
}


-- Names follow written order: the head's condition and block, each `else if`
-- link's, then the final `else` block. The nested `ParsedIfExpr`s are then
-- built from the last link back, so no recursion follows the length of the
-- chain.
private pure func legacy_conditional_preview(
	source: PreviewSource, names: NameTable, conditional: TreeExpressions.IfExpression, span: Span,
) -> Result[(NameTable, ParsedExpr), LegacyDeclarationPreviewError]:
	translated_head ?= legacy_if_link_preview(source, names, conditional)
	(after_head, head_condition, head_block) = translated_head
	var extended: NameTable = after_head
	var else_ifs: List[PreviewElseIfLink] = []
	var final_else: Option[ParsedElseBranch] = None
	var failure: Option[LegacyDeclarationPreviewError] = None
	var branch: Option[TreeExpressions.ElseBranch] = conditional.else_branch
	while branch.is_some() and failure.is_none():
		match branch:
			Some(written):
				match written.body:
					TreeExpressions.ElseBlock(block):
						match legacy_block_preview(source, extended, block):
							Ok((after_block, else_block)):
								extended = after_block
								final_else = Some(parsed_else_branch(written.keyword, else_block))
							Err(error):
								failure = Some(error)
						branch = None
					TreeExpressions.ElseIf(else_if):
						match legacy_if_link_preview(source, extended, else_if.conditional):
							Ok((after_link, condition, then_block)):
								extended = after_link
								else_ifs = else_ifs.append({
									else_keyword = written.keyword, span = else_if.span, condition = condition, then_block = then_block
								})
								branch = else_if.conditional.else_branch
							Err(error):
								failure = Some(error)
			None:
				void
	match failure:
		Some(error):
			Err(error)
		None:
			var else_branch: Option[ParsedElseBranch] = final_else
			for link in else_ifs.reverse():
				chained: ParsedExpr = ParsedIfExpr(link.condition, link.then_block, else_branch, legacy_location(link.span))
				else_branch = Some(parsed_else_branch(link.else_keyword, chained))
			Ok((extended, ParsedIfExpr(head_condition, head_block, else_branch, legacy_location(span))))


private pure func parsed_else_branch(keyword: Span, body: ParsedExpr) -> ParsedElseBranch:
	{ keyword = legacy_location(keyword), body = body }


private pure func legacy_if_link_preview(
	source: PreviewSource, names: NameTable, link: TreeExpressions.IfExpression,
) -> Result[(NameTable, ParsedExpr, ParsedExpr), LegacyDeclarationPreviewError]:
	translated_condition ?= legacy_expression_preview(source, names, link.condition)
	(after_condition, condition) = translated_condition
	translated_block ?= legacy_block_preview(source, after_condition, link.then_block)
	(after_block, then_block) = translated_block
	Ok((after_block, condition, then_block))


private pure func legacy_match_preview(
	source: PreviewSource, names: NameTable, subject: TreeExpressions.Expression,
	cases: List[TreeExpressions.MatchCase], location: SourceLocation,
) -> Result[(NameTable, ParsedExpr), LegacyDeclarationPreviewError]:
	translated_subject ?= legacy_expression_preview(source, names, subject)
	(after_subject, scrutinee) = translated_subject
	var extended: NameTable = after_subject
	var parsed_cases: List[ParsedMatchCase] = []
	var failure: Option[LegacyDeclarationPreviewError] = None
	for written in cases:
		match legacy_case_preview(source, extended, written):
			Ok((after_case, parsed)):
				extended = after_case
				parsed_cases = parsed_cases.append(parsed)
			Err(error):
				failure = Some(error)
				break
	match failure:
		Some(error):
			Err(error)
		None:
			Ok((extended, ParsedMatchExpr(scrutinee, parsed_cases, location)))


private pure func legacy_case_preview(
	source: PreviewSource, names: NameTable, written: TreeExpressions.MatchCase,
) -> Result[(NameTable, ParsedMatchCase), LegacyDeclarationPreviewError]:
	translated_pattern ?= legacy_pattern_preview(source, names, written.pattern)
	(after_pattern, pattern) = translated_pattern
	translated_body ?= match written.body:
		TreeExpressions.CaseBlock(block):
			legacy_block_preview(source, after_pattern, block)
		TreeExpressions.CaseStatement(statement):
			legacy_statement_preview(source, after_pattern, statement)
	(after_body, body) = translated_body
	Ok((after_body, { pattern = pattern, body = body, span = legacy_location(written.span) }))


-- Patterns nest only by their own brackets. Numbers keep their authored
-- digits: the sign belongs to the pattern, the digits to the literal token.
private pure func legacy_pattern_preview(
	source: PreviewSource, names: NameTable, pattern: TreePatterns.Pattern,
) -> Result[(NameTable, ParsedPattern), LegacyDeclarationPreviewError]:
	location: SourceLocation = legacy_location(pattern.span)
	match pattern.kind:
		TreePatterns.WildcardPattern:
			Ok((names, ParsedWildcardPattern(location)))
		TreePatterns.NamePattern(use):
			(extended, name) = preview_identifier(source, names, use.name)
			Ok((extended, ParsedNamePattern(name)))
		TreePatterns.IntegerPattern(sign, _):
			match preview_number_literal_text(source, pattern.span):
				Some(digits):
					Ok((names, ParsedIntPattern(signed_pattern_digits(sign, digits), location)))
				None:
					Err(MissingPatternNumberToken(pattern.span))
		TreePatterns.FloatPattern(sign, literal):
			Ok((names, ParsedFloatPattern(signed_pattern_digits(sign, literal.written_digits()), location)))
		TreePatterns.StringPattern(form, text):
			Ok((names, ParsedStringPattern(text, legacy_string_form(form), location)))
		TreePatterns.CharacterPattern(character):
			Ok((names, ParsedCharPattern(character.to_int(), location)))
		TreePatterns.BooleanPattern(value):
			Ok((names, ParsedBoolPattern(value, location)))
		TreePatterns.ConstructorPattern(constructor, arguments):
			(after_name, name) = preview_identifier(source, names, constructor.name)
			translated ?= legacy_patterns_preview(source, after_name, arguments)
			(extended, parsed) = translated
			Ok((extended, ParsedConstructorPattern(name, parsed, location)))
		TreePatterns.QualifiedConstructorPattern(qualifier, constructor, arguments):
			(after_qualifier, qualifier_name) = preview_identifier(source, names, qualifier.name)
			(after_name, name) = preview_identifier(source, after_qualifier, constructor.name)
			translated ?= legacy_patterns_preview(source, after_name, arguments)
			(extended, parsed) = translated
			Ok((extended, ParsedQualifiedConstructorPattern(qualifier_name, name, parsed, location)))
		TreePatterns.TuplePattern(elements):
			translated ?= legacy_patterns_preview(source, names, small_tuple_items(elements))
			(extended, parsed) = translated
			Ok((extended, ParsedTuplePattern(parsed, location)))
		TreePatterns.AlternativePatterns(alternatives):
			translated ?= legacy_patterns_preview(source, names, at_least_two_items(alternatives))
			(extended, parsed) = translated
			Ok((extended, ParsedOrPattern(parsed, location)))
		TreePatterns.ListPattern(elements, spread):
			translated ?= legacy_patterns_preview(source, names, elements)
			(after_elements, parsed) = translated
			match spread:
				None:
					Ok((after_elements, ParsedListPattern(parsed, None, location)))
				Some(written):
					match written.target:
						BindsName(binder):
							(extended, name) = preview_identifier(source, after_elements, binder.name)
							Ok((extended, ParsedListPattern(parsed, Some(ParsedListSpreadName(name)), location)))
						DiscardsValue(span):
							Ok((after_elements, ParsedListPattern(parsed, Some(ParsedListSpreadWildcard(legacy_location(span))), location)))


private pure func legacy_expressions_preview(
	source: PreviewSource, names: NameTable, expressions: List[TreeExpressions.Expression],
) -> Result[(NameTable, List[ParsedExpr]), LegacyDeclarationPreviewError]:
	var extended: NameTable = names
	var parsed: List[ParsedExpr] = []
	var failure: Option[LegacyDeclarationPreviewError] = None
	for expression in expressions:
		match legacy_expression_preview(source, extended, expression):
			Ok((after_expression, translated)):
				extended = after_expression
				parsed = parsed.append(translated)
			Err(error):
				failure = Some(error)
				break
	match failure:
		Some(error):
			Err(error)
		None:
			Ok((extended, parsed))


private pure func legacy_patterns_preview(
	source: PreviewSource, names: NameTable, patterns: List[TreePatterns.Pattern],
) -> Result[(NameTable, List[ParsedPattern]), LegacyDeclarationPreviewError]:
	var extended: NameTable = names
	var parsed: List[ParsedPattern] = []
	var failure: Option[LegacyDeclarationPreviewError] = None
	for pattern in patterns:
		match legacy_pattern_preview(source, extended, pattern):
			Ok((after_pattern, translated)):
				extended = after_pattern
				parsed = parsed.append(translated)
			Err(error):
				failure = Some(error)
				break
	match failure:
		Some(error):
			Err(error)
		None:
			Ok((extended, parsed))


private pure func signed_pattern_digits(sign: TreePatterns.Sign, digits: String) -> String:
	match sign:
		TreePatterns.NonNegative: digits
		TreePatterns.Negative: NEGATIVE_SIGN + digits



private pure func preview_global_header(
	source: PreviewSource, names: NameTable, preview: GlobalHeaderPreview,
) -> Result[(NameTable, LegacyGlobalHeaderPreview), LegacyDeclarationPreviewError]:
	-- Read only the scanner's consumed equal token and its next lexical token.
	-- Initializer grammar and its endpoint remain M4's responsibility.
	entry_translation: Result[LegacyGlobalInitializerEntry, LegacyDeclarationPreviewError] = match (source.tokens.get(preview.initializer.token_start - 1), source.tokens.get(preview.initializer.token_start)):
		(Some(assignment_equal), Some(initializer_entry)):
			if (preview.initializer.token_start <= 0 or assignment_equal.kind != PreviewTokens.EqualSymbol
				or assignment_equal.span.span_end() != preview.header.header_span.span_end()
				or initializer_entry.span.span_start() < assignment_equal.span.span_end()):
				Err(InvalidGlobalInitializerEntry(preview.initializer.anchor))
			else:
				Ok({ assignment_equal = assignment_equal.span, initializer_entry = initializer_entry.span, anchor = preview.initializer.anchor })
		_:
			Err(InvalidGlobalInitializerEntry(preview.initializer.anchor))
	initializer ?= entry_translation
	written = preview.header
	(after_name, name) = preview_identifier(source, names, written.name)
	type_translation: Result[(NameTable, Option[ParsedTypeExpr]), LegacyDeclarationPreviewError] = match written.declared_type:
		Some(written_type):
			match preview_type(source, after_name, written_type):
				Ok((after_type, translated)):
					Ok((after_type, Some(translated)))
				Err(error):
					Err(error)
		None:
			Ok((after_name, None))
	translated_type ?= type_translation
	(extended, type_expr) = translated_type
	Ok((extended, {
		header = {
			name = name, type_expr = type_expr,
			is_mutable = written.form == TreeDeclarations.MutableGlobal,
			doc = preview_documentation(written.documentation)
		},
		visibility = written.visibility, header_span = written.header_span,
		initializer = initializer
	}))


private pure func preview_function_header(
	source: PreviewSource, names: NameTable, preview: FunctionHeaderPreview,
) -> Result[(NameTable, LegacyFunctionHeaderPreview), LegacyDeclarationPreviewError]:
	written = preview.header
	translated ?= preview_callable_header(source, names, written.signature, written.type_parameters,
		written.constraints, written.annotations, preview_documentation(written.documentation))
	(extended, header) = translated
	Ok((extended, {
		header = header, visibility = written.visibility, body_extent = preview.body_extent,
		header_span = written.header_span, body_colon = written.body_colon
	}))


private pure func preview_callable_header(
	source: PreviewSource, names: NameTable, signature: TreeDeclarations.Signature,
	type_parameters: List[TreeDeclarations.TypeParameter], constraints: List[TreeDeclarations.DimensionConstraint],
	annotations: List[TreeDeclarations.Annotation], doc: Option[String],
) -> Result[(NameTable, ParsedFunctionHeader), LegacyDeclarationPreviewError]:
	(after_name, name) = preview_identifier(source, names, signature.name)
	(after_type_parameters, translated_type_parameters) = preview_type_parameters(source, after_name, type_parameters)
	translated_parameters ?= preview_parameters(source, after_type_parameters, signature.parameters)
	(after_parameters, parameters) = translated_parameters
	translated_return ?= preview_optional_type(source, after_parameters, signature.return_type)
	(after_return, return_type) = translated_return
	var extended: NameTable = after_return
	var translated_constraints: List[ParsedDimConstraint] = []
	var failure: Option[LegacyDeclarationPreviewError] = None
	for constraint in constraints:
		match preview_dimension_constraint(source, extended, constraint):
			Ok((after_constraint, translated)):
				extended = after_constraint
				translated_constraints = translated_constraints.append(translated)
			Err(error):
				failure = Some(error)
				break
	match failure:
		Some(error): Err(error)
		None:
			Ok((extended, {
				name = name, keyword_span = Some(legacy_location(signature.keyword)),
				type_params = translated_type_parameters, params = parameters, return_type = return_type,
				dim_constraints = translated_constraints, is_pure = signature.purity == Kinds.PureFunction,
				annotations = annotations.map(pure func(annotation): preview_annotation(annotation.annotation)), doc = doc
			}))


private pure func preview_optional_type(
	source: PreviewSource, names: NameTable, written: Option[TreeTypes.WrittenType],
) -> Result[(NameTable, Option[ParsedTypeExpr]), LegacyDeclarationPreviewError]:
	match written:
		Some(result):
			translated ?= preview_type(source, names, result)
			(extended, parsed) = translated
			Ok((extended, Some(parsed)))
		None: Ok((names, None))


private pure func preview_trait_header(
	source: PreviewSource, names: NameTable, preview: TraitPreview,
) -> Result[(NameTable, LegacyTraitHeaderPreview), LegacyDeclarationPreviewError]:
	(after_name, name) = preview_identifier(source, names, preview.name)
	(after_type_parameters, type_parameters) = preview_type_parameters(source, after_name, preview.type_parameters)
	var extended: NameTable = after_type_parameters
	var supertraits: List[ParsedTraitReference] = []
	for bound in preview.supertraits:
		(after_bound, translated) = preview_bound(source, extended, bound)
		extended = after_bound
		supertraits = supertraits.append(translated)
	var methods: List[LegacyTraitMethodHeaderPreview] = []
	var failure: Option[LegacyDeclarationPreviewError] = None
	for method in preview.methods:
		signature = method.header.signature
		(after_method, method_name) = preview_identifier(source, extended, signature.name)
		match preview_parameters(source, after_method, signature.parameters):
			Ok((after_parameters, parameters)):
				match preview_optional_type(source, after_parameters, signature.return_type):
					Ok((after_return, return_type)):
						extended = after_return
						methods = methods.append({
							header = { name = method_name, params = parameters, return_type = return_type, is_pure = signature.purity == Kinds.PureFunction },
							body_extent = method.body_extent, header_span = method.header.span
						})
					Err(error): failure = Some(error)
			Err(error): failure = Some(error)
		if failure.is_some():
			break
	match failure:
		Some(error): Err(error)
		None:
			Ok((extended, {
				name = name, type_params = type_parameters, supertraits = supertraits, methods = methods,
				doc = preview_documentation(preview.documentation), visibility = preview.visibility, owner_span = preview.span
			}))


private pure func preview_implementation_header(
	source: PreviewSource, names: NameTable, preview: ImplementationPreview,
) -> Result[(NameTable, LegacyImplementationHeaderPreview), LegacyDeclarationPreviewError]:
	(after_trait, trait_name) = preview_identifier(source, names, preview.trait_name.name)
	translated_receiver ?= preview_type(source, after_trait, preview.receiver)
	(after_receiver, receiver) = translated_receiver
	var extended: NameTable = after_receiver
	var methods: List[LegacyImplementationMethodHeaderPreview] = []
	var failure: Option[LegacyDeclarationPreviewError] = None
	for method in preview.methods:
		written = method.header
		match preview_callable_header(source, extended, written.signature, written.type_parameters,
			written.constraints, written.annotations, None):
			Ok((after_method, header)):
				extended = after_method
				methods = methods.append({ header = header, body = method.body, header_span = written.header_span })
			Err(error):
				failure = Some(error)
				break
	match failure:
		Some(error): Err(error)
		None:
			Ok((extended, {
				trait_name = trait_name, for_type = receiver, methods = methods,
				doc = preview_documentation(preview.documentation), visibility = preview.visibility, owner_span = preview.span
			}))


private pure func preview_dimension_constraint(
	source: PreviewSource, names: NameTable, constraint: TreeDeclarations.DimensionConstraint,
) -> Result[(NameTable, ParsedDimConstraint), LegacyDeclarationPreviewError]:
	translated_left ?= preview_dimension(source, names, constraint.left)
	(after_left, left) = translated_left
	translated_right ?= preview_dimension(source, after_left, constraint.right)
	(extended, right) = translated_right
	Ok((extended, { left = left, right = right, span = legacy_location(constraint.span) }))


private pure func preview_documentation(documentation: Option[Documentation]) -> Option[String]:
	documentation.map(pure func(written): written.text)


private pure func preview_visibility(declaration: ParsedDecl, visibility: Kinds.Visibility, span: Span) -> ParsedDecl:
	match visibility:
		Kinds.PublicVisibility:
			declaration
		Kinds.PrivateVisibility:
			PrivateParsedDecl(declaration, legacy_location(span))


private pure func preview_import_block(
	source: PreviewSource, names: NameTable, block: TreeImports.ImportBlock,
) -> (NameTable, ParsedDecl):
	var extended: NameTable = names
	var imports: List[ParsedImportDecl] = []
	for written in block.imports:
		var module_alias: Option[ParsedIdentifier] = None
		match written.alias_name:
			Some(alias_name):
				(after_alias, parsed) = preview_identifier(source, extended, alias_name)
				extended = after_alias
				module_alias = Some(parsed)
			None:
				()
		var symbols: List[ParsedImportSymbol] = []
		for item in written.items:
			(after_name, name) = preview_identifier(source, extended, item.name.name)
			var after_item: NameTable = after_name
			var symbol_alias: Option[ParsedIdentifier] = None
			match item.alias_name:
				Some(alias_name):
					(after_alias, parsed) = preview_identifier(source, after_item, alias_name)
					after_item = after_alias
					symbol_alias = Some(parsed)
				None:
					()
			var constructors: List[ParsedIdentifier] = []
			for constructor in item.constructors:
				(after_constructor, parsed) = preview_identifier(source, after_item, constructor.name)
				after_item = after_constructor
				constructors = constructors.append(parsed)
			extended = after_item
			symbols = symbols.append({ name = name, symbol_alias = symbol_alias,
				constructors = constructors, span = legacy_location(item.span) })
		selected: Option[List[ParsedImportSymbol]] = if symbols.is_empty():
			None
		else:
			Some(symbols)
		-- Legacy paths use separators from the grammar, excluding source trivia.
		prefix: String = match written.path.anchor:
			TreeImports.BareAnchor:
				""
			TreeImports.SameDirectoryAnchor:
				"./"
			TreeImports.ParentDirectoryAnchor(steps):
				repeat("../", parent_step_count(steps)).join("")
			TreeImports.NativePackageAnchor:
				"pkg/"
		parts: List[String] = at_least_one_items(written.path.parts)
			.map(pure func(part): preview_span_text(source, part.span))
		imports = imports.append({
			module_path = prefix + parts.join("/"),
			module_path_span = legacy_location(written.path_span), module_alias = module_alias,
			symbols = selected,
			span = legacy_location(written.span)
		})
	(extended, ImportBlockParsedDecl(imports, legacy_location(block.span)))


private pure func preview_foreign_block(
	source: PreviewSource, names: NameTable, block: TreeForeign.ForeignBlock,
) -> Result[(NameTable, ParsedDecl), LegacyDeclarationPreviewError]:
	var extended: NameTable = names
	var arguments: List[ParsedForeignBlockArg] = []
	for argument in block.arguments:
		(after_name, name) = preview_identifier(source, extended, argument.name)
		extended = after_name
		arguments = arguments.append({ name = name, value = argument.value, span = legacy_location(argument.span) })
	var functions: List[ParsedForeignFunctionDecl] = []
	var failure: Option[LegacyDeclarationPreviewError] = None
	for function in block.functions:
		match preview_foreign_function(source, extended, function):
			Ok((after_function, parsed)):
				extended = after_function
				functions = functions.append(parsed)
			Err(error):
				failure = Some(error)
				break
	match failure:
		Some(error):
			Err(error)
		None:
			Ok((extended, ForeignBlockParsedDecl(arguments, functions, legacy_location(block.span))))


private pure func preview_foreign_function(
	source: PreviewSource, names: NameTable, function: TreeForeign.ForeignFunction,
) -> Result[(NameTable, ParsedForeignFunctionDecl), LegacyDeclarationPreviewError]:
	(after_name, name) = preview_identifier(source, names, function.name)
	translated_parameters ?= preview_parameters(source, after_name, function.parameters)
	(after_parameters, parameters) = translated_parameters
	translated_return ?= preview_type(source, after_parameters, function.return_type)
	(after_return, return_type) = translated_return
	Ok((after_return, {
		name = name, params = parameters, return_type = return_type,
		c_name = function.c_name.map(pure func(written): written.name),
		is_pure = function.purity == Kinds.PureFunction,
		is_private = function.visibility == Kinds.PrivateVisibility,
		annotations = function.annotations.map(pure func(written): preview_annotation(written.annotation)),
		span = legacy_location(function.span)
	}))


private pure func preview_annotation(annotation: Kinds.FunctionAnnotation) -> ParsedFunctionAnnotation:
	match annotation:
		Kinds.TailRecursiveAnnotation:
			ParsedTailRecursiveAnnotation
		Kinds.NoCopyAnnotation:
			ParsedNoCopyAnnotation
		Kinds.DebugOnlyAnnotation:
			ParsedDebugOnlyAnnotation
		Kinds.ResourceResultOrdinaryAnnotation:
			ParsedResourceResultOrdinaryAnnotation


private pure func preview_parameters(
	source: PreviewSource, names: NameTable, written: List[TreeDeclarations.Parameter],
) -> Result[(NameTable, List[ParsedParam]), LegacyDeclarationPreviewError]:
	var extended: NameTable = names
	var parameters: List[ParsedParam] = []
	var failure: Option[LegacyDeclarationPreviewError] = None
	for parameter in written:
		match preview_parameter(source, extended, parameter):
			Ok((after_parameter, parsed)):
				extended = after_parameter
				parameters = parameters.append(parsed)
			Err(error):
				failure = Some(error)
				break
	match failure:
		Some(error):
			Err(error)
		None:
			Ok((extended, parameters))


private pure func preview_parameter(
	source: PreviewSource, names: NameTable, parameter: TreeDeclarations.Parameter,
) -> Result[(NameTable, ParsedParam), LegacyDeclarationPreviewError]:
	(after_binding, binder) = preview_parameter_binding(source, names, parameter.binding)
	match parameter.declared_type:
		Some(written_type):
			translated ?= preview_type(source, after_binding, written_type)
			(after_type, parsed) = translated
			Ok((after_type, { binder = binder, type_expr = Some(parsed), span = legacy_location(parameter.span) }))
		None:
			Ok((after_binding, { binder = binder, type_expr = None, span = legacy_location(parameter.span) }))


private pure func preview_parameter_binding(
	source: PreviewSource, names: NameTable, binding: TreeDeclarations.ParameterBinding,
) -> (NameTable, ParsedParamBinder):
	match binding:
		TreeDeclarations.NamedParameter(binder):
			(extended, name) = preview_identifier(source, names, binder.name)
			(extended, ParsedParamNameBinder(name))
		TreeDeclarations.WildcardParameter(span):
			(names, ParsedParamWildcardBinder(legacy_location(span)))
		TreeDeclarations.TupleParameter(binding):
			var extended: NameTable = names
			var binders: List[ParsedIdentifier] = []
			for binder in small_tuple_items(binding.names):
				(after_name, name) = preview_identifier(source, extended, binder.name)
				extended = after_name
				binders = binders.append(name)
			(extended, ParsedParamTupleBinder(binders, legacy_location(binding.span)))


private pure func preview_fields(
	source: PreviewSource, names: NameTable, written: List[TreeDeclarations.FieldDeclaration],
) -> Result[(NameTable, List[ParsedFieldDecl]), LegacyDeclarationPreviewError]:
	var extended: NameTable = names
	var fields: List[ParsedFieldDecl] = []
	var failure: Option[LegacyDeclarationPreviewError] = None

	for field in written:
		(after_name, field_name) = preview_identifier(source, extended, field.name)

		match preview_type(source, after_name, field.field_type):
			Ok(translated):
				(after_type, field_type) = translated
				extended = after_type
				fields = fields.append({ name = field_name, type_expr = field_type, span = legacy_location(field.span) })
			Err(error):
				failure = Some(error)
				break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok((extended, fields))


private pure func preview_type_parameters(
	source: PreviewSource, names: NameTable, written: List[TreeDeclarations.TypeParameter],
) -> (NameTable, List[ParsedTypeParamDecl]):
	var extended: NameTable = names
	var parameters: List[ParsedTypeParamDecl] = []

	for parameter in written:
		match parameter:
			TreeDeclarations.TypeVariable(variable):
				(after_name, name) = preview_identifier(source, extended, variable.binder.name)
				extended = after_name
				var bounds: List[ParsedTraitReference] = []

				for bound in variable.bounds:
					(after_bound, translated) = preview_bound(source, extended, bound)
					extended = after_bound
					bounds = bounds.append(translated)

				parameters = parameters.append({ name = name, kind = ParsedTypeParameter, bounds = bounds, span = legacy_location(variable.span) })
			TreeDeclarations.DimensionVariable(binder):
				(after_name, name) = preview_text_identifier(extended, preview_span_text(source, binder.name.span), binder.name.span)
				extended = after_name
				parameters = parameters.append({ name = name, kind = ParsedDimensionParameter, bounds = [], span = legacy_location(binder.name.span) })
			TreeDeclarations.WildcardDimensionParameter(span):
				(after_name, name) = preview_text_identifier(extended, PREVIEW_WILDCARD_DIMENSION_NAME, span)
				extended = after_name
				parameters = parameters.append({ name = name, kind = ParsedDimensionParameter, bounds = [], span = legacy_location(span) })

	(extended, parameters)


-- Syntax-owned spellings synthesized by the legacy AST representation.
private PREVIEW_VOID_NAME: String = "Void"
private PREVIEW_WILDCARD_DIMENSION_NAME: String = "#_"


private pure func preview_identifier(
	preview: PreviewSource, names: NameTable, name: WrittenName,
) -> (NameTable, ParsedIdentifier):
	preview_text_identifier(names, preview_span_text(preview, name.span), name.span)


private pure func preview_text_identifier(
	names: NameTable, text: String, span: Span,
) -> (NameTable, ParsedIdentifier):
	(extended, index) = name_table_intern(names, text)
	(extended, parsed_identifier(name_id_from_interned_index(index), text, legacy_location(span)))


private pure func preview_arguments(
	preview: PreviewSource, names: NameTable, arguments: List[TreeTypes.TypeArgument],
) -> Result[(NameTable, List[ParsedTypeExpr]), LegacyDeclarationPreviewError]:
	var extended: NameTable = names
	var translated: List[ParsedTypeExpr] = []
	var failure: Option[LegacyDeclarationPreviewError] = None

	for argument in arguments:
		match preview_argument(preview, extended, argument):
			Ok(part):
				(extended_names, written) = part
				extended = extended_names
				translated = translated.append(written)
			Err(error):
				failure = Some(error)
				break

	match failure:
		Some(error):
			Err(error)
		None:
			Ok((extended, translated))


private pure func preview_type(
	preview: PreviewSource, names: NameTable, written: TreeTypes.WrittenType,
) -> Result[(NameTable, ParsedTypeExpr), LegacyDeclarationPreviewError]:
	location: SourceLocation = legacy_location(written.span)

	match written.kind:
		TreeTypes.NamedType(use, arguments):
			(after_name, name) = preview_identifier(preview, names, use.name)
			translated_arguments ?= preview_arguments(preview, after_name, arguments)
			(extended_names, translated) = translated_arguments
			Ok((extended_names, ParsedNamedType(name, translated, location)))
		TreeTypes.QualifiedType(qualifier_use, name_use, arguments):
			(after_qualifier, qualifier) = preview_identifier(preview, names, qualifier_use.name)
			(after_name, name) = preview_identifier(preview, after_qualifier, name_use.name)
			translated_arguments ?= preview_arguments(preview, after_name, arguments)
			(extended_names, translated) = translated_arguments
			Ok((extended_names, ParsedQualifiedNamedType(qualifier, name, translated, location)))
		TreeTypes.VoidType:
			(extended_names, name) = preview_text_identifier(names, PREVIEW_VOID_NAME, written.span)
			Ok((extended_names, ParsedNamedType(name, [], location)))
		TreeTypes.TupleType(elements):
			translated_elements ?= preview_arguments(preview, names, small_tuple_items(elements))
			(extended_names, translated) = translated_elements
			Ok((extended_names, ParsedTupleType(translated, location)))
		TreeTypes.FunctionType(purity, parameters, result):
			translated_parameters ?= preview_arguments(preview, names, parameters)
			(after_parameters, translated) = translated_parameters
			translated_return_type ?= preview_type(preview, after_parameters, result)
			(extended_names, translated_result) = translated_return_type
			Ok((extended_names, ParsedFunctionType(purity == Kinds.PureFunction, translated, translated_result, location)))
		TreeTypes.ArrayType(element, dimensions):
			translated_element_part ?= preview_type(preview, names, element)
			(after_element, translated_element) = translated_element_part
			arguments: List[TreeTypes.TypeArgument] = at_least_one_items(dimensions).map(pure func(dimension): TreeTypes.DimensionArgument(dimension))
			translated_dimensions ?= preview_arguments(preview, after_element, arguments)
			(extended, translated) = translated_dimensions
			Ok((extended, ParsedArrayType(translated_element, translated, location)))
		TreeTypes.RangeType(dimension):
			translated_dimension ?= preview_dimension(preview, names, dimension)
			(extended_names, translated) = translated_dimension
			Ok((extended_names, ParsedRangeType(translated, location)))
		TreeTypes.DimensionType(dimension):
			preview_dimension(preview, names, dimension)
		TreeTypes.BoundedType(bounded):
			preview_bounded_type(preview, names, bounded)


private pure func preview_argument(
	preview: PreviewSource, names: NameTable, argument: TreeTypes.TypeArgument,
) -> Result[(NameTable, ParsedTypeExpr), LegacyDeclarationPreviewError]:
	match argument:
		TreeTypes.TypeArgumentType(written):
			preview_type(preview, names, written)
		TreeTypes.DimensionArgument(dimension):
			preview_dimension(preview, names, dimension)
		TreeTypes.BoundedArgument(bounded):
			preview_bounded_type(preview, names, bounded)


-- Both receiver shapes preserve the bounded payload's authored location.
private pure func preview_bounded_type(
	preview: PreviewSource, names: NameTable, bounded: TreeTypes.BoundedTypeArgument,
) -> Result[(NameTable, ParsedTypeExpr), LegacyDeclarationPreviewError]:
	(after_name, name) = preview_identifier(preview, names, bounded.parameter.name)
	var extended: NameTable = after_name
	var bounds: List[ParsedTraitReference] = []

	for bound in at_least_one_items(bounded.bounds):
		(extended_names, translated) = preview_bound(preview, extended, bound)
		extended = extended_names
		bounds = bounds.append(translated)

	Ok((extended, ParsedBoundedType(name, bounds, legacy_location(bounded.span))))


private pure func preview_bound(
	preview: PreviewSource, names: NameTable, bound: TreeDeclarations.TraitReference,
) -> (NameTable, ParsedTraitReference):
	(after_qualifier, qualifier) = match bound.qualifier:
		Some(use):
			(extended_names, name) = preview_identifier(preview, names, use.name)
			(extended_names, Some(name))
		None:
			(names, None)

	(extended_names, name) = preview_identifier(preview, after_qualifier, bound.trait_name.name)
	(extended_names, { qualifier = qualifier, name = name, span = legacy_location(bound.span) })


private pure func preview_dimension(
	preview: PreviewSource, names: NameTable, dimension: TreeTypes.Dimension,
) -> Result[(NameTable, ParsedTypeExpr), LegacyDeclarationPreviewError]:
	location: SourceLocation = legacy_location(dimension.span)

	match dimension.kind:
		TreeTypes.NamedDimension(use):
			(extended_names, name) = preview_text_identifier(names, preview_span_text(preview, use.name.span), dimension.span)
			Ok((extended_names, ParsedDimNameType(name, False, location)))
		TreeTypes.VariadicNamedDimension(use):
			(extended_names, name) = preview_text_identifier(names, preview_span_text(preview, use.name.span), use.name.span)
			Ok((extended_names, ParsedDimNameType(name, True, location)))
		TreeTypes.WildcardDimension:
			(extended_names, name) = preview_text_identifier(names, PREVIEW_WILDCARD_DIMENSION_NAME, dimension.span)
			Ok((extended_names, ParsedDimNameType(name, False, location)))
		TreeTypes.VariadicWildcardDimension:
			match preview_variadic_wildcard_span(preview, dimension.span):
				Some(identifier_span):
					(extended_names, name) = preview_text_identifier(names, PREVIEW_WILDCARD_DIMENSION_NAME, identifier_span)
					Ok((extended_names, ParsedDimNameType(name, True, location)))
				None:
					Err(MissingVariadicWildcardToken(dimension.span))
		TreeTypes.LiteralDimension(_):
			match preview_dimension_literal_text(preview, dimension.span):
				Some(digits):
					Ok((names, ParsedDimLiteralType(digits, location)))
				None:
					Err(MissingDimensionLiteralToken(dimension.span))
		TreeTypes.DimensionArithmetic(operator, left, right):
			translated_left_dimension ?= preview_dimension(preview, names, left)
			(after_left, translated_left) = translated_left_dimension
			translated_right_dimension ?= preview_dimension(preview, after_left, right)
			(extended_names, translated_right) = translated_right_dimension
			translated_operator: ParsedDimBinaryOp = match operator:
				TreeTypes.AddDimensions:
					ParsedDimAddOp
				TreeTypes.SubtractDimensions:
					ParsedDimSubtractOp
				TreeTypes.MultiplyDimensions:
					ParsedDimMultiplyOp
				TreeTypes.DivideDimensions:
					ParsedDimDivideOp

			Ok((extended_names, ParsedDimBinaryType(translated_operator, translated_left, translated_right, location)))
