-- Pure argument parsing for the Blorp CLI.
--
-- Commands use this typed argument surface before Blorp executes them.
import:
	../stage_09_core/stage_manifest: CORE_STAGE_NAMES
	lint_model: lint_rule_id_from_name


private CLI_USAGE_SUCCESS_EXIT: Int = 0

private CLI_USAGE_ERROR_EXIT: Int = 1

private DEFAULT_TEST_REPEAT: Int = 1


enum CliSanitizerMode:
	CliSanitizeOff
	CliSanitizeAddressUndefined
	CliSanitizeUndefined


enum CliTestMode:
	CliTestAll
	CliTestDocOnly
	CliTestSuiteOnly


enum CliFormatMode:
	CliFormatWrite
	CliFormatCheck
	CliFormatCheckDiff


record CliCheckArgs {
	dump_ast: Bool,
	dump_typed_ast: Bool,
	capture_typecheck_request: Option[String],
	debug: Bool,
	no_format: Bool,
	std_dir: Option[String],
	paths: List[String]
}


record CliCompileArgs {
	ast_only: Bool,
	profile: Bool,
	dump_ast: Bool,
	dump_typed_ast: Bool,
	dump_core_after: List[String],
	dump_file: Option[String],
	stop_after: Option[String],
	time_phases: Bool,
	check_invariants: Bool,
	debug: Bool,
	no_format: Bool,
	embed_runtime: Bool,
	std_dir: Option[String],
	output: Option[String],
	files: List[String]
}


record CliRunArgs {
	profile: Bool,
	debug: Bool,
	sanitizer: Option[CliSanitizerMode],
	leak_check: Bool,
	release: Bool,
	no_format: Bool,
	timeout: Option[Int],
	threads: Option[Int],
	std_dir: Option[String],
	files: List[String],
	user_args: List[String]
}


record CliTestArgs {
	profile: Bool,
	debug: Bool,
	sanitizer: Option[CliSanitizerMode],
	leak_check: Bool,
	maximal_artifacts: Bool,
	timeout: Option[Int],
	repeat: Int,
	mode: CliTestMode,
	std_dir: Option[String],
	paths: List[String]
}


record CliPurifyArgs {
	dry_run: Bool,
	verbose: Bool,
	paths: List[String]
}


enum CliLintOutputFormat:
	CliLintHuman
	CliLintJson


record CliLintArgs {
	output_format: CliLintOutputFormat,
	fail_on_findings: Bool,
	disabled_rules: List[String],
	paths: List[String]
}


record CliFormatFilesArgs {
	mode: CliFormatMode,
	paths: List[String]
}


union CliFormatAction:
	CliFormatHelp
	CliFormatFiles(CliFormatFilesArgs)


record CliPackagePackArgs {
	path: String,
	output: String
}


union CliPackageAction:
	CliPackageHelp
	CliPackageCheckHelp
	CliPackageCheck(String)
	CliPackageHashHelp
	CliPackageHash(String)
	CliPackagePackHelp
	CliPackagePack(CliPackagePackArgs)
	CliPackageFetchHelp
	CliPackageFetchAll
	CliPackageFetchTarget(String, List[String])
	CliPackageVendorHelp
	CliPackageVendorAll
	CliPackageVendorTarget(String, Option[String])


enum CliLspAction:
	CliLspHelp
	CliLspRun


union CliAction:
	CliUsage(Int)
	CliVersion
	CliCheckHelp
	CliCompileHelp
	CliRunHelp
	CliTestHelp
	CliTestWarmupOnly
	CliPurifyHelp
	CliLintHelp
	CliLsp(CliLspAction)
	CliFormat(CliFormatAction)
	CliPackage(CliPackageAction)
	CliCheck(CliCheckArgs)
	CliCompile(CliCompileArgs)
	CliRun(CliRunArgs)
	CliTest(CliTestArgs)
	CliPurify(CliPurifyArgs)
	CliLint(CliLintArgs)
	CliError(String)


private pure func is_help_arg(arg: String) -> Bool:
	arg == "--help" or arg == "-h"


private pure func is_option(arg: String) -> Bool:
	arg.starts_with("-")


private pure func option_requires_value(name: String) -> String:
	"Error: " + name + " requires a value"


private pure func parse_int_option(name: String, raw: String) -> Result[Int, CliAction]:
	match raw.parse_int():
		Some(value):
			Ok(value)
		None:
			Err(CliError("Error: " + name + " requires an integer"))


private pure func parse_positive_int_option(name: String, raw: String) -> Result[Int, CliAction]:
	match raw.parse_int():
		Some(value):
			if value > 0:
				Ok(value)
			else:
				Err(CliError("Error: " + name + " requires a positive integer"))
		None:
			Err(CliError("Error: " + name + " requires a positive integer"))


private pure func all_valid_stages(stages: List[String]) -> Bool:
	var ok: Bool = True

	for stage in stages:
		if not CORE_STAGE_NAMES.contains(stage):
			ok = False
			break

	ok


private pure func parse_stage_arg(flag: String, value: String) -> Result[String, CliAction]:
	if CORE_STAGE_NAMES.contains(value):
		Ok(value)
	else:
		Err(CliError(flag + ": unknown stage \"" + value + "\""))


private pure func parse_stage_list_arg(
	flag: String,
	value: String,
) -> Result[List[String], CliAction]:
	stages: List[String] = value.split(",")

	if all_valid_stages(stages):
		Ok(stages)
	else:
		Err(CliError(flag + ": unknown stage in \"" + value + "\""))


private pure func parse_sanitizer_value(raw: String) -> Result[CliSanitizerMode, CliAction]:
	match raw:
		"0":
			Ok(CliSanitizeOff)
		"off":
			Ok(CliSanitizeOff)
		"1":
			Ok(CliSanitizeAddressUndefined)
		"address":
			Ok(CliSanitizeAddressUndefined)
		"asan":
			Ok(CliSanitizeAddressUndefined)
		"undefined":
			Ok(CliSanitizeUndefined)
		"ubsan":
			Ok(CliSanitizeUndefined)
		_:
			Err(
				CliError(
					"Error: --sanitize must be one of: 0, 1, off, address, asan, undefined, ubsan",
				),
			)


private pure func parse_sanitize_option(arg: String) -> Result[CliSanitizerMode, CliAction]:
	if arg == "--sanitize":
		Ok(CliSanitizeAddressUndefined)
	else if arg.starts_with("--sanitize="):
		parse_sanitizer_value(arg.remove_prefix("--sanitize="))
	else:
		Err(CliError("Error: " + arg + " must be --sanitize or --sanitize=<mode>"))


private DEFAULT_CHECK_ARGS: CliCheckArgs = {
	dump_ast = False,
	dump_typed_ast = False,
	capture_typecheck_request = None,
	debug = False,
	no_format = False,
	std_dir = None,
	paths = []
}

private DEFAULT_COMPILE_ARGS: CliCompileArgs = {
	ast_only = False,
	profile = False,
	dump_ast = False,
	dump_typed_ast = False,
	dump_core_after = [],
	dump_file = None,
	stop_after = None,
	time_phases = False,
	check_invariants = False,
	debug = False,
	no_format = False,
	embed_runtime = True,
	std_dir = None,
	output = None,
	files = []
}

private DEFAULT_RUN_ARGS: CliRunArgs = {
	profile = False,
	debug = False,
	sanitizer = None,
	leak_check = False,
	release = False,
	no_format = False,
	timeout = None,
	threads = None,
	std_dir = None,
	files = [],
	user_args = []
}

private DEFAULT_TEST_ARGS: CliTestArgs = {
	profile = False,
	debug = False,
	sanitizer = None,
	leak_check = False,
	maximal_artifacts = False,
	timeout = None,
	repeat = DEFAULT_TEST_REPEAT,
	mode = CliTestAll,
	std_dir = None,
	paths = []
}


private pure func parse_check_args(args: List[String]) -> CliAction:
	var parsed: CliCheckArgs = DEFAULT_CHECK_ARGS
	var result: Option[CliAction] = None
	var index: Int = 0

	while index < args.length():
		arg: String = args
			.get(index)
			.get_or("")

		if result.is_none():
			if is_help_arg(arg):
				result = Some(CliCheckHelp)
			else if arg == "--dump-ast":
				parsed = { parsed | dump_ast = True }
			else if arg == "--dump-typed-ast":
				parsed = { parsed | dump_typed_ast = True }
			else if arg == "--capture-typecheck-request":
				match args.get(index + 1):
					Some(path):
						parsed = { parsed | capture_typecheck_request = Some(path) }
						index += 1
					None:
						result = Some(
							CliError(option_requires_value("--capture-typecheck-request")),
						)
			else if arg == "--debug":
				parsed = { parsed | debug = True }
			else if arg == "--no-format":
				parsed = { parsed | no_format = True }
			else if arg == "--std-dir":
				match args.get(index + 1):
					Some(dir):
						parsed = { parsed | std_dir = Some(dir) }
						index += 1
					None:
						result = Some(CliError(option_requires_value("--std-dir")))
			else:
				parsed = { parsed | paths = parsed.paths.append(arg) }

		index += 1

	match result:
		Some(action):
			action
		None:
			if parsed.paths.length() == 0:
				CliError("Error: No input file specified")
			else:
				CliCheck(parsed)


private pure func parse_eq_arg(arg: String, flag: String) -> Option[String]:
	prefix: String = flag + "="

	if arg.starts_with(prefix):
		Some(arg.remove_prefix(prefix))
	else:
		None


private pure func parse_compile_args(args: List[String]) -> CliAction:
	var parsed: CliCompileArgs = DEFAULT_COMPILE_ARGS
	var result: Option[CliAction] = None
	var index: Int = 0

	while index < args.length():
		arg: String = args
			.get(index)
			.get_or("")

		if result.is_none():
			match parse_eq_arg(arg, "--dump-core-after"):
				Some(value):
					match parse_stage_list_arg("--dump-core-after", value):
						Ok(stages):
							parsed = { parsed |
								dump_core_after = parsed.dump_core_after.concat(stages)
							}
						Err(action):
							result = Some(action)
				None:
					match parse_eq_arg(arg, "--stop-after"):
						Some(value):
							match parse_stage_arg("--stop-after", value):
								Ok(stage):
									parsed = { parsed | stop_after = Some(stage) }
								Err(action):
									result = Some(action)
						None:
							match parse_eq_arg(arg, "--dump-core-file"):
								Some(value):
									parsed = { parsed | dump_file = Some(value) }
								None:
									if is_help_arg(arg):
										result = Some(CliCompileHelp)
									else if arg == "--ast":
										parsed = { parsed | ast_only = True }
									else if arg == "--profile":
										parsed = { parsed | profile = True }
									else if arg == "--dump-ast":
										parsed = { parsed | dump_ast = True }
									else if arg == "--dump-typed-ast":
										parsed = { parsed | dump_typed_ast = True }
									else if arg == "--dump-core":
										parsed = { parsed |
											dump_core_after = parsed.dump_core_after.append("final")
										}
									else if arg == "--dump-core-after":
										match args.get(index + 1):
											Some(value):
												match parse_stage_list_arg(
													"--dump-core-after",
													value,
												):
													Ok(stages):
														parsed = { parsed |
															dump_core_after = parsed.dump_core_after.concat(
																stages,
															)
														}
														index += 1
													Err(action):
														result = Some(action)
											None:
												result = Some(
													CliError(
														option_requires_value(
															"--dump-core-after",
														),
													),
												)
									else if arg == "--stop-after":
										match args.get(index + 1):
											Some(value):
												match parse_stage_arg("--stop-after", value):
													Ok(stage):
														parsed = { parsed |
															stop_after = Some(stage)
														}
														index += 1
													Err(action):
														result = Some(action)
											None:
												result = Some(
													CliError(
														option_requires_value("--stop-after"),
													),
												)
									else if arg == "--dump-core-file":
										match args.get(index + 1):
											Some(value):
												parsed = { parsed | dump_file = Some(value) }
												index += 1
											None:
												result = Some(
													CliError(
														option_requires_value(
															"--dump-core-file",
														),
													),
												)
									else if arg == "--time-phases":
										parsed = { parsed | time_phases = True }
									else if arg == "--check-invariants":
										parsed = { parsed | check_invariants = True }
									else if arg == "--debug":
										parsed = { parsed | debug = True }
									else if arg == "--no-format":
										parsed = { parsed | no_format = True }
									else if arg == "--no-embed-runtime":
										parsed = { parsed | embed_runtime = False }
									else if arg == "--std-dir":
										match args.get(index + 1):
											Some(dir):
												parsed = { parsed | std_dir = Some(dir) }
												index += 1
											None:
												result = Some(
													CliError(option_requires_value("--std-dir")),
												)
									else if arg == "-o":
										match args.get(index + 1):
											Some(output):
												parsed = { parsed | output = Some(output) }
												index += 1
											None:
												result = Some(CliError(option_requires_value("-o")))
									else if is_option(arg):
										result = Some(
											CliError("Error: unknown compile option: " + arg),
										)
									else:
										parsed = { parsed | files = parsed.files.append(arg) }

		index += 1

	match result:
		Some(action):
			action
		None:
			match parsed.stop_after:
				Some(stage):
					if parsed.dump_core_after.length() == 0:
						updated: CliCompileArgs = { parsed | dump_core_after = [stage] }

						if updated.files.length() == 0:
							CliError("Error: No input file specified")
						else if updated.files.length() > 1:
							CliError("Error: Multiple input files not supported")
						else:
							CliCompile(updated)
					else if parsed.files.length() == 0:
						CliError("Error: No input file specified")
					else if parsed.files.length() > 1:
						CliError("Error: Multiple input files not supported")
					else:
						CliCompile(parsed)
				None:
					if parsed.files.length() == 0:
						CliError("Error: No input file specified")
					else if parsed.files.length() > 1:
						CliError("Error: Multiple input files not supported")
					else:
						CliCompile(parsed)


private pure func parse_run_args(args: List[String]) -> CliAction:
	var parsed: CliRunArgs = DEFAULT_RUN_ARGS
	var result: Option[CliAction] = None
	var index: Int = 0

	while index < args.length():
		arg: String = args
			.get(index)
			.get_or("")

		if result.is_none():
			if arg == "--":
				parsed = { parsed | user_args = args.drop(index + 1) }
				index = args.length()
			else if is_help_arg(arg):
				result = Some(CliRunHelp)
			else if arg == "--profile":
				parsed = { parsed | profile = True }
			else if arg == "--release":
				parsed = { parsed | release = True }
			else if arg == "--debug":
				parsed = { parsed | debug = True }
			else if arg == "--sanitize" or arg.starts_with("--sanitize="):
				match parse_sanitize_option(arg):
					Ok(mode):
						parsed = { parsed | sanitizer = Some(mode) }
					Err(action):
						result = Some(action)
			else if arg == "--leak-check":
				parsed = { parsed | leak_check = True }
			else if arg == "--no-format":
				parsed = { parsed | no_format = True }
			else if arg == "--std-dir":
				match args.get(index + 1):
					Some(dir):
						parsed = { parsed | std_dir = Some(dir) }
						index += 1
					None:
						result = Some(CliError(option_requires_value("--std-dir")))
			else if arg == "--timeout":
				match args.get(index + 1):
					Some(raw):
						match parse_int_option("--timeout", raw):
							Ok(value):
								parsed = { parsed | timeout = Some(value) }
								index += 1
							Err(action):
								result = Some(action)
					None:
						result = Some(CliError(option_requires_value("--timeout")))
			else if arg == "--threads":
				match args.get(index + 1):
					Some(raw):
						match parse_int_option("--threads", raw):
							Ok(value):
								parsed = { parsed | threads = Some(value) }
								index += 1
							Err(action):
								result = Some(action)
					None:
						result = Some(CliError(option_requires_value("--threads")))
			else:
				parsed = { parsed | files = parsed.files.append(arg) }

		index += 1

	match result:
		Some(action):
			action
		None:
			if parsed.files.length() == 0:
				CliError("Error: No input file specified")
			else if parsed.files.length() > 1:
				CliError("Error: Multiple input files not supported")
			else:
				CliRun(parsed)


private pure func parse_test_args(args: List[String]) -> CliAction:
	var parsed: CliTestArgs = DEFAULT_TEST_ARGS
	var result: Option[CliAction] = None
	var warmup_only: Bool = False
	var index: Int = 0

	while index < args.length():
		arg: String = args
			.get(index)
			.get_or("")

		if result.is_none():
			if is_help_arg(arg):
				result = Some(CliTestHelp)
			else if arg == "--profile":
				parsed = { parsed | profile = True }
			else if arg == "--debug":
				parsed = { parsed | debug = True }
			else if arg == "--sanitize" or arg.starts_with("--sanitize="):
				match parse_sanitize_option(arg):
					Ok(mode):
						parsed = { parsed | sanitizer = Some(mode) }
					Err(action):
						result = Some(action)
			else if arg == "--leak-check":
				parsed = { parsed | leak_check = True }
			else if arg == "--maximal-artifacts":
				parsed = { parsed | maximal_artifacts = True }
			else if arg == "--warmup-only":
				warmup_only = True
			else if arg == "--doc":
				parsed = { parsed | mode = CliTestDocOnly }
			else if arg == "--suite":
				parsed = { parsed | mode = CliTestSuiteOnly }
			else if arg == "--std-dir":
				match args.get(index + 1):
					Some(dir):
						parsed = { parsed | std_dir = Some(dir) }
						index += 1
					None:
						result = Some(CliError(option_requires_value("--std-dir")))
			else if arg == "--timeout":
				match args.get(index + 1):
					Some(raw):
						match parse_int_option("--timeout", raw):
							Ok(value):
								parsed = { parsed | timeout = Some(value) }
								index += 1
							Err(action):
								result = Some(action)
					None:
						result = Some(CliError(option_requires_value("--timeout")))
			else if arg == "--repeat":
				match args.get(index + 1):
					Some(raw):
						match parse_positive_int_option("--repeat", raw):
							Ok(value):
								parsed = { parsed | repeat = value }
								index += 1
							Err(action):
								result = Some(action)
					None:
						result = Some(CliError(option_requires_value("--repeat")))
			else if is_option(arg):
				result = Some(CliError("Error: unknown test option: " + arg))
			else:
				parsed = { parsed | paths = parsed.paths.append(arg) }

		index += 1

	match result:
		Some(action):
			action
		None:
			if warmup_only and parsed.paths.length() > 0:
				CliError("Error: test --warmup-only does not accept test paths")
			else if warmup_only:
				CliTestWarmupOnly
			else if parsed.paths.length() == 0:
				CliError("Error: No test path specified")
			else:
				CliTest(parsed)


private pure func parse_purify_args(args: List[String]) -> CliAction:
	var parsed: CliPurifyArgs = {
		dry_run = False,
		verbose = False,
		paths = []
	}
	var result: Option[CliAction] = None

	for arg in args:
		if result.is_none():
			if is_help_arg(arg):
				result = Some(CliPurifyHelp)
			else if arg == "--dry-run":
				parsed = { parsed | dry_run = True }
			else if arg == "--verbose" or arg == "-v":
				parsed = { parsed | verbose = True }
			else:
				parsed = { parsed | paths = parsed.paths.append(arg) }

	match result:
		Some(action):
			action
		None:
			if parsed.paths.length() == 0:
				CliError("Error: No input files specified")
			else:
				CliPurify(parsed)


private pure func parse_lint_args(args: List[String]) -> CliAction:
	var parsed: CliLintArgs = {
		output_format = CliLintHuman,
		fail_on_findings = False,
		disabled_rules = [],
		paths = []
	}
	var result: Option[CliAction] = None
	var index: Int = 0

	while index < args.length():
		arg: String = args
			.get(index)
			.get_or("")

		if result.is_none():
			if is_help_arg(arg):
				result = Some(CliLintHelp)
			else if arg == "--fail-on-findings":
				parsed = { parsed | fail_on_findings = True }
			else if arg == "--disable":
				match args.get(index + 1):
					Some(rule_name):
						match lint_rule_id_from_name(rule_name):
							Some(_):
								if not parsed.disabled_rules.contains(rule_name):
									parsed = { parsed |
										disabled_rules = parsed.disabled_rules.append(rule_name)
									}
							None:
								result = Some(CliError("Error: unknown lint rule: " + rule_name))

						index += 1
					None:
						result = Some(CliError(option_requires_value("--disable")))
			else if arg == "--format":
				match args.get(index + 1):
					Some(format):
						if format == "human":
							parsed = { parsed | output_format = CliLintHuman }
						else if format == "json":
							parsed = { parsed | output_format = CliLintJson }
						else:
							result = Some(CliError("Error: --format must be 'human' or 'json'"))

						index += 1
					None:
						result = Some(CliError(option_requires_value("--format")))
			else if is_option(arg):
				result = Some(CliError("Error: unknown lint option: " + arg))
			else:
				parsed = { parsed | paths = parsed.paths.append(arg) }

		index += 1

	match result:
		Some(action):
			action
		None:
			if parsed.paths.length() == 0:
				CliError("Error: No input files specified")
			else:
				CliLint(parsed)


private pure func parse_lsp_args(args: List[String]) -> CliAction:
	match args:
		[]:
			CliLsp(CliLspRun)
		[arg]:
			if is_help_arg(arg):
				CliLsp(CliLspHelp)
			else:
				CliError("Error: Unknown lsp option: " + arg)
		[arg, ...rest]:
			CliError("Error: Unknown lsp option: " + arg)


private pure func parse_format_args(args: List[String]) -> CliAction:
	var mode: CliFormatMode = CliFormatWrite
	var paths: List[String] = []
	var result: Option[CliAction] = None
	var index: Int = 0

	while index < args.length():
		arg: String = args
			.get(index)
			.get_or("")

		if result.is_none():
			if is_help_arg(arg):
				result = Some(CliFormat(CliFormatHelp))
			else if arg == "--check":
				match mode:
					CliFormatCheckDiff:
						mode = CliFormatCheckDiff
					_:
						mode = CliFormatCheck
			else if arg == "--diff":
				mode = CliFormatCheckDiff
			else if is_option(arg):
				result = Some(CliError("unknown format option: " + arg))
			else:
				paths = paths.append(arg)

		index += 1

	match result:
		Some(action):
			action
		None:
			if paths.length() == 0:
				CliError(
					"no files specified. Usage: blorp format [--check] [--diff] <file.brp|dir> [...]",
				)
			else:
				CliFormat(CliFormatFiles({
					mode = mode,
					paths = paths,
				}))


private pure func parse_package_pack_args(args: List[String]) -> Option[CliPackagePackArgs]:
	var path: Option[String] = None
	var output: Option[String] = None
	var index: Int = 0

	while index < args.length():
		arg: String = args
			.get(index)
			.get_or("")

		if arg == "-o" or arg == "--output":
			match args.get(index + 1):
				Some(value):
					output = Some(value)
					index += 1
				None:
					output = None
		else if is_option(arg):
			path = path
		else:
			path = Some(arg)

		index += 1

	match (path, output):
		(Some(package_path), Some(output_path)):
			Some({
				path = package_path,
				output = output_path,
			})
		_:
			None


private pure func parse_package_args(args: List[String]) -> CliAction:
	match args:
		[]:
			CliPackage(CliPackageHelp)
		[arg]:
			if is_help_arg(arg):
				CliPackage(CliPackageHelp)
			else if arg == "fetch":
				CliPackage(CliPackageFetchAll)
			else if arg == "vendor":
				CliPackage(CliPackageVendorAll)
			else if arg == "check":
				CliError("Error: package check requires a path")
			else if arg == "hash":
				CliError("Error: package hash requires a path")
			else:
				CliError("Error: unknown package command: " + arg)
		["check", flag]:
			if is_help_arg(flag):
				CliPackage(CliPackageCheckHelp)
			else:
				CliPackage(CliPackageCheck(flag))
		["check", first, ...rest]:
			CliError("Error: package check accepts exactly one path")
		["hash", flag]:
			if is_help_arg(flag):
				CliPackage(CliPackageHashHelp)
			else:
				CliPackage(CliPackageHash(flag))
		["hash", first, ...rest]:
			CliError("Error: package hash accepts exactly one path")
		["pack", flag]:
			if is_help_arg(flag):
				CliPackage(CliPackagePackHelp)
			else:
				CliError("Error: package pack requires a package path and -o <file>")
		["pack", ...pack_args]:
			match parse_package_pack_args(pack_args):
				Some(pack):
					CliPackage(CliPackagePack(pack))
				None:
					CliError("Error: package pack requires a package path and -o <file>")
		["fetch", flag]:
			if is_help_arg(flag):
				CliPackage(CliPackageFetchHelp)
			else:
				CliPackage(CliPackageFetchTarget(flag, []))
		["fetch", target, ...locations]:
			CliPackage(CliPackageFetchTarget(target, locations))
		["vendor", flag]:
			if is_help_arg(flag):
				CliPackage(CliPackageVendorHelp)
			else:
				CliPackage(CliPackageVendorTarget(flag, None))
		["vendor", target, dest]:
			CliPackage(CliPackageVendorTarget(target, Some(dest)))
		["vendor", first, second, ...rest]:
			CliError("Error: package vendor requires a hash and path")
		[command, ...rest]:
			CliError("Error: unknown package command: " + command)


pure func parse_cli_args(args: List[String]) -> CliAction:
	match args:
		[]:
			CliUsage(CLI_USAGE_ERROR_EXIT)
		[arg]:
			if is_help_arg(arg):
				CliUsage(CLI_USAGE_SUCCESS_EXIT)
			else if arg == "--version" or arg == "-v":
				CliVersion
			else:
				match arg:
					"lsp":
						CliLsp(CliLspRun)
					"package":
						CliPackage(CliPackageHelp)
					"check":
						parse_check_args([])
					"compile":
						parse_compile_args([])
					"run":
						parse_run_args([])
					"test":
						parse_test_args([])
					"purify":
						parse_purify_args([])
					"lint":
						parse_lint_args([])
					"format":
						parse_format_args([])
					_:
						CliError("Error: Unknown command")
		[command, ...rest]:
			match command:
				"lsp":
					parse_lsp_args(rest)
				"format":
					parse_format_args(rest)
				"package":
					parse_package_args(rest)
				"check":
					parse_check_args(rest)
				"compile":
					parse_compile_args(rest)
				"run":
					parse_run_args(rest)
				"test":
					parse_test_args(rest)
				"purify":
					parse_purify_args(rest)
				"lint":
					parse_lint_args(rest)
				_:
					CliError("Error: Unknown command")
