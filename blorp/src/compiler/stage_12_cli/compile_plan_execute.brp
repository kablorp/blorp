-- Timed plan execution for the contiguous Blorp compile pipeline.
import:
	../cli:
		CliCompileExecution(CliCompileFrontendFailed, CliCompileStopped),
		CliCompilePreparation(CliCompilePreparationReady, CliCompilePreparationStopped),
		CliRunArtifactExecution(CliRunArtifactFailed, CliRunArtifactStopped),
		finish_prepared_compile_execution,
		finish_prepared_run_artifact_execution,
		prepare_compile_plan,
		prepare_run_plan,
	plan: CliCompilePlan, CliRunSourcePlan
	system: now_microseconds
	timing: CliCompileTiming


record CliTimedCompileExecution {
	execution: CliCompileExecution,
	timings: List[CliCompileTiming]
}


foreign:
	@no_copy func record_compile_memory_checkpoint(
		phase: String,
	) -> Void = "blorp_compiler_memory_checkpoint_c"


private pure func elapsed_timing(
	label: String,
	started_at: Int,
	finished_at: Int,
) -> CliCompileTiming:
	{
		label = label,
		microseconds = finished_at - started_at
	}


private func current_time_when(enabled: Bool) -> Int:
	if enabled:
		now_microseconds()
	else:
		0


func execute_compile_plan_timed(
	plan: CliCompilePlan,
	record_timings: Bool,
) -> CliTimedCompileExecution:
	record_compile_memory_checkpoint("frontend_start")
	frontend_started: Int = current_time_when(record_timings)

	match prepare_compile_plan(plan):
		Err(errors):
			record_compile_memory_checkpoint("frontend_failed")
			frontend_finished: Int = current_time_when(record_timings)

			timings: List[CliCompileTiming] = if record_timings:
				[elapsed_timing("frontend", frontend_started, frontend_finished)]
			else:
				[]

			{
				execution = CliCompileFrontendFailed(errors),
				timings = timings
			}
		Ok(CliCompilePreparationStopped(target_path, stage_name, rendered, observations)):
			record_compile_memory_checkpoint("frontend_stopped")
			frontend_finished: Int = current_time_when(record_timings)

			timings: List[CliCompileTiming] = if record_timings:
				[elapsed_timing("frontend", frontend_started, frontend_finished)]
			else:
				[]

			{
				execution = CliCompileStopped(target_path, stage_name, rendered, observations),
				timings = timings
			}
		Ok(CliCompilePreparationReady(prepared)):
			record_compile_memory_checkpoint("frontend_complete")
			frontend_finished: Int = current_time_when(record_timings)
			backend_started: Int = frontend_finished
			execution: CliCompileExecution = finish_prepared_compile_execution(prepared)
			record_compile_memory_checkpoint("backend_complete")
			backend_finished: Int = current_time_when(record_timings)

			timings: List[CliCompileTiming] = if record_timings:
				[
					elapsed_timing("frontend", frontend_started, frontend_finished),
					elapsed_timing("backend", backend_started, backend_finished),
				]
			else:
				[]

			{
				execution = execution,
				timings = timings
			}


func execute_run_artifact_plan(plan: CliRunSourcePlan) -> CliRunArtifactExecution:
	match prepare_run_plan(plan):
		Err(errors):
			CliRunArtifactFailed(errors.join("\n"))
		Ok(CliCompilePreparationStopped(_, _, _, _)):
			CliRunArtifactStopped
		Ok(CliCompilePreparationReady(prepared)):
			finish_prepared_run_artifact_execution(prepared)
