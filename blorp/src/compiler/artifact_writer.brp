-- Atomic filesystem boundary for compiler C artifacts.
--
-- Runtime source is supplied explicitly by the executable assembly layer. The
-- writer does not discover installation paths or consult process-global state.
import:
	../lib/compilation: CompileArtifactOutput
	fs: IOError, write_text_parts_atomic
	path: extension
	string: remove_suffix


union ArtifactWriteError:
	MissingEmbeddedRuntime
	ArtifactWriteIo(IOError)


pure func artifact_write_error_message(error: ArtifactWriteError) -> String:
	match error:
		MissingEmbeddedRuntime:
			"embedded compiler runtime source is unavailable"
		ArtifactWriteIo(io_error):
			io_error.to_string()


pure func compile_output_path(source_path: String, requested: Option[String]) -> String:
	match requested:
		Some(path):
			path
		None:
			match extension(source_path):
				Some(source_extension):
					source_path.remove_suffix(source_extension) + ".c"
				None:
					source_path + ".c"


private pure func compile_artifact_source_parts(
	artifact: CompileArtifactOutput,
	embedded_runtime_source: String,
) -> Result[List[String], ArtifactWriteError]:
	if artifact.embed_runtime:
		if embedded_runtime_source.length() == 0:
			Err(MissingEmbeddedRuntime)
		else:
			Ok([embedded_runtime_source, artifact.c_code])
	else:
		Ok([artifact.c_code])


func write_compile_artifact(
	artifact: CompileArtifactOutput,
	output_path: String,
	embedded_runtime_source: String,
) -> Result[String, ArtifactWriteError]:
	source_parts ?= compile_artifact_source_parts(artifact, embedded_runtime_source)

	match write_text_parts_atomic(output_path, source_parts):
		Ok(_):
			Ok(output_path)
		Err(error):
			Err(ArtifactWriteIo(error))
