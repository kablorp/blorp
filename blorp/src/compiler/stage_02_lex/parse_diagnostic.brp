import:
	../../lib/source: SourceSpan, source_span_label


record ParseDiagnostic {
	span: SourceSpan,
	message: String,
	expected: List[String],
	help: Option[String]
}


pure func parse_error(span: SourceSpan, message: String) -> ParseDiagnostic:
	{
		span = span,
		message = message,
		expected = [],
		help = None
	}


pure func parse_error_expected(
	span: SourceSpan,
	message: String,
	expected: List[String],
	help: Option[String],
) -> ParseDiagnostic:
	{
		span = span,
		message = message,
		expected = expected,
		help = help
	}


---
Renders a diagnostic as `<path>:<line>:<column>: error: <message>`, the final
form a command prints as-is. The message already says what was expected, so the
structured `expected` tokens (kept for tools such as the LSP) are not repeated.
---
pure func parse_diagnostic_to_string(diagnostic: ParseDiagnostic) -> String:
	base: String = source_span_label(diagnostic.span) + ": error: " + diagnostic.message

	match diagnostic.help:
		Some(help):
			base + "\nhelp: " + help
		None:
			base
