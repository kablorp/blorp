pure func string_literal_kind_ordinal(kind: StringLiteralKind) -> Int:
	match kind:
		NormalStringLiteral:
			0
		RawStringLiteral:
			1
		InterpolatedStringLiteral:
			2
		PipeStringLiteral:
			3
		RawPipeStringLiteral:
			4
		InterpolatedPipeStringLiteral:
			5


pure func string_literal_kind_from_ordinal(ordinal: Int) -> StringLiteralKind:
	match ordinal:
		0:
			NormalStringLiteral
		1:
			RawStringLiteral
		2:
			InterpolatedStringLiteral
		3:
			PipeStringLiteral
		4:
			RawPipeStringLiteral
		_:
			InterpolatedPipeStringLiteral


-- String-literal tokens pack their `StringLiteralKind` (3 bits are enough
-- for 6 variants) below the interned text id so both fit in one `Int`
-- payload.
private STRING_LITERAL_KIND_BITS: Int = 8


pure func pack_string_literal_payload(kind: StringLiteralKind, text_id: Int) -> Int:
	text_id * STRING_LITERAL_KIND_BITS + string_literal_kind_ordinal(kind)


pure func unpacked_string_literal_kind(payload: Int) -> StringLiteralKind:
	string_literal_kind_from_ordinal(payload % STRING_LITERAL_KIND_BITS)


pure func unpacked_string_literal_text_id(payload: Int) -> Int:
	payload / STRING_LITERAL_KIND_BITS


-- Recovers the tag and payload `Int` for building a `Token` from a
-- `TokenKind` view, interning any text the variant carries.
-- Tag and payload for building a `Token` from a `TokenKind` view, given
-- the text-carrying variants' id already interned by the caller (`lex`
-- interns inline, on its own `texts`/`by_text` locals, before calling
-- this: see the lexer pilot rule that no tuple or table record should
-- cross a call boundary per token). Scalar in, scalar out: this never
-- allocates.
struct TaggedPayload {
	tag: TokenTag,
	id: Int
}


pure func tagged_payload_for(kind: TokenKind, interned_id: Int) -> TaggedPayload:
	match kind:
		IdentifierToken(_):
			{
				tag = IdentifierTag,
				id = interned_id
			}
		KeywordToken(keyword):
			{
				tag = KeywordTag,
				id = keyword_ordinal(keyword)
			}
		SymbolToken(symbol):
			{
				tag = SymbolTag,
				id = symbol_ordinal(symbol)
			}
		IntLiteralToken(_):
			{
				tag = IntLiteralTag,
				id = interned_id
			}
		FloatLiteralToken(_):
			{
				tag = FloatLiteralTag,
				id = interned_id
			}
		StringLiteralToken(kind, _):
			{
				tag = StringLiteralTag,
				id = pack_string_literal_payload(kind, interned_id)
			}
		CharLiteralToken(codepoint):
			{
				tag = CharLiteralTag,
				id = codepoint
			}
		DocStringToken(_):
			{
				tag = DocStringTag,
				id = interned_id
			}
		NewlineToken:
			{
				tag = NewlineTag,
				id = -1
			}
		IndentToken:
			{
				tag = IndentTag,
				id = -1
			}
		DedentToken:
			{
				tag = DedentTag,
				id = -1
			}
		EndOfFileToken:
			{
				tag = EndOfFileTag,
				id = -1
			}


-- The text a `TokenKind` carries, for `lex` to intern inline before
-- calling `tagged_payload_for`. `None` for every payload-free or
-- already-scalar (`CharLiteralToken`) variant.
pure func token_kind_own_text(kind: TokenKind) -> Option[String]:
	match kind:
		IdentifierToken(text):
			Some(text)
		IntLiteralToken(text):
			Some(text)
		FloatLiteralToken(text):
			Some(text)
		StringLiteralToken(_, text):
			Some(text)
		DocStringToken(text):
			Some(text)
		_:
			None


-- Reconstructs the `TokenKind` view of a token on demand. Called only at
-- the sites that need a payload; symbol/keyword/newline/indent/dedent/eof
-- tokens never allocated a payload object even before this change.
pure func token_kind_of(texts: List[String], token: Token) -> TokenKind:
	match token.kind:
		IdentifierTag:
			IdentifierToken(interned_text(texts, token.payload))
		KeywordTag:
			KeywordToken(keyword_from_ordinal(token.payload))
		SymbolTag:
			SymbolToken(symbol_from_ordinal(token.payload))
		IntLiteralTag:
			IntLiteralToken(interned_text(texts, token.payload))
		FloatLiteralTag:
			FloatLiteralToken(interned_text(texts, token.payload))
		StringLiteralTag:
			StringLiteralToken(
				unpacked_string_literal_kind(token.payload),
				interned_text(texts, unpacked_string_literal_text_id(token.payload)),
			)
		CharLiteralTag:
			CharLiteralToken(token.payload)
		DocStringTag:
			DocStringToken(interned_text(texts, token.payload))
		NewlineTag:
			NewlineToken
		IndentTag:
			IndentToken
		DedentTag:
			DedentToken
		EndOfFileTag:
			EndOfFileToken


-- Scalar/interned-text payload readers for a `Token`, used by the parser in
-- place of `token_kind_of` so a hot-path read never rebuilds a `TokenKind`
-- union: each of these does at most one scalar decode or one retaining
-- (non-allocating) `texts` index. Callers pick the accessor that matches the
-- token's `kind` (checked via a `TokenTag` match) rather than probing all of
-- them.
pure func token_text(texts: List[String], token: Token) -> String:
	interned_text(texts, token.payload)


pure func token_keyword(token: Token) -> Keyword:
	keyword_from_ordinal(token.payload)


pure func token_symbol(token: Token) -> Symbol:
	symbol_from_ordinal(token.payload)


pure func token_string_literal_kind(token: Token) -> StringLiteralKind:
	unpacked_string_literal_kind(token.payload)


pure func token_string_literal_text(texts: List[String], token: Token) -> String:
	interned_text(texts, unpacked_string_literal_text_id(token.payload))


pure func token_char_code_point(token: Token) -> Int:
	token.payload


