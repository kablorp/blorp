import:
	../../lib/source: Cursor, SourceSpan


enum Keyword:
	FuncKeyword
	PureKeyword
	VarKeyword
	UnionKeyword
	RecordKeyword
	VoidKeyword
	WhileKeyword
	ForKeyword
	InKeyword
	IfKeyword
	ElseKeyword
	AndKeyword
	OrKeyword
	NotKeyword
	OnKeyword
	MatchKeyword
	TrueKeyword
	FalseKeyword
	BreakKeyword
	ContinueKeyword
	DebugKeyword
	StructKeyword
	EnumKeyword
	WithKeyword
	ResourceKeyword
	ForeignKeyword
	PrivateKeyword
	BuiltinKeyword
	ConcurrentKeyword
	ConcurrentlyKeyword
	DetachKeyword
	SelectKeyword
	IntoOpaqueKeyword
	FromKeyword
	FromOpaqueKeyword
	AfterKeyword
	SealedKeyword
	OpaqueKeyword
	TryKeyword
	ImportKeyword
	AsKeyword
	TraitKeyword
	ImplementsKeyword
	SelfKeyword
	TypeKeyword
	AliasKeyword
	WhereKeyword


enum Symbol:
	LeftParenSymbol
	RightParenSymbol
	LeftBracketSymbol
	RightBracketSymbol
	LeftBraceSymbol
	RightBraceSymbol
	CommaSymbol
	ColonSymbol
	DotSymbol
	DotDotSymbol
	DotDotDotSymbol
	ArrowSymbol
	FatArrowSymbol
	EqualSymbol
	QuestionEqualsSymbol
	PlusSymbol
	MinusSymbol
	StarSymbol
	SlashSymbol
	PlusEqualSymbol
	MinusEqualSymbol
	StarEqualSymbol
	SlashEqualSymbol
	UnderscoreSymbol
	PercentSymbol
	HashSymbol
	AtSymbol
	PipeSymbol
	EqualEqualSymbol
	NotEqualSymbol
	LessSymbol
	LessEqualSymbol
	GreaterSymbol
	GreaterEqualSymbol


enum TriviaKind:
	WhitespaceTrivia
	CommentTrivia


enum StringLiteralKind:
	NormalStringLiteral
	RawStringLiteral
	InterpolatedStringLiteral
	PipeStringLiteral
	RawPipeStringLiteral
	InterpolatedPipeStringLiteral


-- `is_trailing` distinguishes a token's leading run from its trailing run
-- once both are flattened into `LexResult.trivia`; it is set when `lex`
-- attaches a trivia item to a token (via `append_trivia_run` or its own
-- inline trailing-comment update), never by the `trivia` constructor
-- itself.
record Trivia {
	kind: TriviaKind,
	text: String,
	span: SourceSpan,
	is_trailing: Bool
}


union TokenKind:
	IdentifierToken(String)
	KeywordToken(Keyword)
	SymbolToken(Symbol)
	IntLiteralToken(String)
	FloatLiteralToken(String)
	StringLiteralToken(StringLiteralKind, String)
	CharLiteralToken(Int)
	DocStringToken(String)
	NewlineToken
	IndentToken
	DedentToken
	EndOfFileToken


-- Fieldless view of `TokenKind`'s variants, stored inline in `Token` so a
-- token never allocates a union box just to carry its tag. Non-scalar
-- payloads (identifier/literal text, the string-literal kind) live in
-- `LexResult.texts`, the flat table `lex` interns into directly, and are
-- recovered by `token_kind_of` on demand.
enum TokenTag:
	IdentifierTag
	KeywordTag
	SymbolTag
	IntLiteralTag
	FloatLiteralTag
	StringLiteralTag
	CharLiteralTag
	DocStringTag
	NewlineTag
	IndentTag
	DedentTag
	EndOfFileTag


-- A token, stored inline in `LexResult.tokens` (`InlineStructListStorage`):
-- no per-token heap object. All fields are scalar so the struct qualifies
-- for inline list storage; `SourceSpan` (a record with `String` fields) and
-- `List[Trivia]` cannot be struct fields, so both are represented
-- out-of-line: the span as its six scalar components (reassembled by
-- `span_of`/`token_span` with the path and module name published once on
-- `LexResult`, not per token), and trivia as a `[trivia_start, trivia_start
-- + trivia_count)` slice into the flat `LexResult.trivia` table (split back
-- into leading/trailing runs by each item's `is_trailing` flag).
--
-- `payload` means different things per `kind`: an id into
-- `LexResult.texts` for the text-carrying tags, the keyword or symbol
-- ordinal, the character code point, or -1 when unused.
struct Token {
	kind: TokenTag,
	payload: Int,
	start_offset: Int,
	start_line: Int,
	start_column: Int,
	end_offset: Int,
	end_line: Int,
	end_column: Int,
	trivia_start: Int,
	trivia_count: Int
}


pure func span_of(token: Token, path: String, module_name: String) -> SourceSpan:
	{
		path = path,
		module_name = module_name,
		start_offset = token.start_offset,
		start_line = token.start_line,
		start_column = token.start_column,
		end_offset = token.end_offset,
		end_line = token.end_line,
		end_column = token.end_column
	}


-- Builds a payload-free, trivia-free `Token` directly from a `SourceSpan`.
-- Used for the fallback EOF token and anywhere a `Token` is needed without
-- going through the intern/trivia tables.
pure func scalar_token(tag: TokenTag, payload: Int, span: SourceSpan) -> Token:
	{
		kind = tag,
		payload = payload,
		start_offset = span.start_offset,
		start_line = span.start_line,
		start_column = span.start_column,
		end_offset = span.end_offset,
		end_line = span.end_line,
		end_column = span.end_column,
		trivia_start = 0,
		trivia_count = 0
	}


-- Builds a `Token` directly from start/end cursors, with no `SourceSpan`
-- built or discarded in between. The lexer's successful scalar scans (all of
-- them except diagnostics and retained trivia) call this instead of
-- `token_with_trivia_range`, so a successful token never allocates a
-- `SourceSpan` merely to be flattened back into these same six scalars.
pure func token_from_cursors(
	tag: TokenTag,
	payload: Int,
	start: Cursor,
	end: Cursor,
	trivia_start: Int,
	trivia_count: Int,
) -> Token:
	{
		kind = tag,
		payload = payload,
		start_offset = start.offset,
		start_line = start.line,
		start_column = start.column,
		end_offset = end.offset,
		end_line = end.line,
		end_column = end.column,
		trivia_start = trivia_start,
		trivia_count = trivia_count
	}


private pure func trailing_marked(item: Trivia, is_trailing: Bool) -> Trivia:
	{
		kind = item.kind,
		text = item.text,
		span = item.span,
		is_trailing = is_trailing
	}


pure func append_trivia_run(
	table: List[Trivia],
	items: List[Trivia],
	is_trailing: Bool,
) -> List[Trivia]:
	var result: List[Trivia] = table

	for item in items:
		result = result.append(trailing_marked(item, is_trailing))

	result


-- Splits a token's `[trivia_start, trivia_start + trivia_count)` slice of
-- the flat trivia table back into (leading, trailing) runs.
pure func token_trivia_of(trivia: List[Trivia], token: Token) -> (List[Trivia], List[Trivia]):
	var leading: List[Trivia] = []
	var trailing: List[Trivia] = []
	var i: Int = token.trivia_start
	end: Int = token.trivia_start + token.trivia_count

	while i < end:
		match trivia.get(i):
			Some(item):
				if item.is_trailing:
					trailing = trailing.append(item)
				else:
					leading = leading.append(item)
			None:
				void

		i += 1

	(leading, trailing)


pure func interned_text(texts: List[String], id: Int) -> String:
	match texts.get(id):
		Some(text):
			text
		None:
			""


