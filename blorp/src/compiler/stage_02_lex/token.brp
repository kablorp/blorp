pure func symbol_text(symbol: Symbol) -> String:
	match symbol:
		LeftParenSymbol:
			"("
		RightParenSymbol:
			")"
		LeftBracketSymbol:
			"["
		RightBracketSymbol:
			"]"
		LeftBraceSymbol:
			"{"
		RightBraceSymbol:
			"}"
		CommaSymbol:
			","
		ColonSymbol:
			":"
		DotSymbol:
			"."
		DotDotSymbol:
			".."
		DotDotDotSymbol:
			"..."
		ArrowSymbol:
			"->"
		FatArrowSymbol:
			"=>"
		EqualSymbol:
			"="
		QuestionEqualsSymbol:
			"?="
		PlusSymbol:
			"+"
		MinusSymbol:
			"-"
		StarSymbol:
			"*"
		SlashSymbol:
			"/"
		PlusEqualSymbol:
			"+="
		MinusEqualSymbol:
			"-="
		StarEqualSymbol:
			"*="
		SlashEqualSymbol:
			"/="
		UnderscoreSymbol:
			"_"
		PercentSymbol:
			"%"
		HashSymbol:
			"#"
		AtSymbol:
			"@"
		PipeSymbol:
			"|"
		EqualEqualSymbol:
			"=="
		NotEqualSymbol:
			"!="
		LessSymbol:
			"<"
		LessEqualSymbol:
			"<="
		GreaterSymbol:
			">"
		GreaterEqualSymbol:
			">="


private pure func string_literal_kind_name(kind: StringLiteralKind) -> String:
	match kind:
		NormalStringLiteral:
			"string literal"
		RawStringLiteral:
			"raw string literal"
		InterpolatedStringLiteral:
			"interpolated string literal"
		PipeStringLiteral:
			"pipe string literal"
		RawPipeStringLiteral:
			"raw pipe string literal"
		InterpolatedPipeStringLiteral:
			"interpolated pipe string literal"


pure func trivia(kind: TriviaKind, text: String, span: SourceSpan) -> Trivia:
	{
		kind = kind,
		text = text,
		span = span,
		is_trailing = False
	}


-- Builds a `Token` from its already-computed tag/payload, span, and
-- trivia slice. Every field is a scalar or an already-built `SourceSpan`,
-- so this never allocates; `lex` calls it directly (no tuple, no table,
-- no list crosses this call) after interning inline and appending any
-- trivia into its own `trivia` local.
pure func token_with_trivia_range(
	tag: TokenTag,
	payload: Int,
	span: SourceSpan,
	trivia_start: Int,
	trivia_count: Int,
) -> Token:
	{
		kind = tag,
		payload = payload,
		start_offset = span.start_offset,
		start_line = span.start_line,
		start_column = span.start_column,
		end_offset = span.end_offset,
		end_line = span.end_line,
		end_column = span.end_column,
		trivia_start = trivia_start,
		trivia_count = trivia_count
	}


-- Returns the last token with its `trivia_count` incremented by one, for
-- attaching a trailing comment `lex` has already appended (as the last
-- item) to its own `trivia` local. `lex` calls `tokens.set(...)` with
-- this itself; relies on that trivia item being the last one written,
-- true for a single-pass lexer.
pure func token_with_trailing_trivia_added(token: Token) -> Token:
	{
		kind = token.kind,
		payload = token.payload,
		start_offset = token.start_offset,
		start_line = token.start_line,
		start_column = token.start_column,
		end_offset = token.end_offset,
		end_line = token.end_line,
		end_column = token.end_column,
		trivia_start = token.trivia_start,
		trivia_count = token.trivia_count + 1
	}


pure func token_kind_name(kind: TokenKind) -> String:
	match kind:
		IdentifierToken(_):
			"identifier"
		KeywordToken(keyword):
			"keyword " + keyword_text(keyword)
		SymbolToken(symbol):
			"symbol " + symbol_text(symbol)
		IntLiteralToken(_):
			"integer literal"
		FloatLiteralToken(_):
			"float literal"
		StringLiteralToken(kind, _):
			string_literal_kind_name(kind)
		CharLiteralToken(_):
			"char literal"
		DocStringToken(_):
			"docstring"
		NewlineToken:
			"newline"
		IndentToken:
			"indent"
		DedentToken:
			"dedent"
		EndOfFileToken:
			"end of file"
