---
The table pre-seeded with `name_table_synthesized_spellings()`, as a shared
immutable constant (CTFE accepts the initializer): discovery, hole parses and
single-file parses (formatter, LSP, tools, tests) share one copy instead of
rebuilding the vocabulary, and ids for these spellings agree everywhere.
---
SYNTHESIZED_NAME_TABLE: NameTable = build_synthesized_name_table()


private pure func build_synthesized_name_table() -> NameTable:
	var table: NameTable = EMPTY_NAME_TABLE

	for spelling in name_table_synthesized_spellings():
		(next_table, _) = name_table_intern(table, spelling)
		table = next_table

	table


---
The empty spelling `""` used for parser error recovery.
Its value is its index in `name_table_synthesized_spellings()`.
---
NAME_ID_EMPTY: NameId = into_opaque NameId(0)

