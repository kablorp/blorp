---
Looks up a synthesized spelling's id without a table in hand, for phases that
mint a spelling from the closed synthesized vocabulary after discovery (the
typechecker's builtin callees, the foreign bridge JSON) and for parser
self-test/oracle helpers that build sample `ParsedIdentifier`s outside any
real parse. Every compilation's table is seeded from
`SYNTHESIZED_NAME_TABLE`, so the id agrees with the compilation's.

`spelling` must be in `name_table_synthesized_spellings()`. A spelling outside
it resolves to `name_id_unseeded_spelling()`, a sentinel that equals no real
id, so the mistake cannot silently alias another spelling (it used to
resolve to the id of `""`): every `NameId` comparison against it is False, and
the name-identity check (`BLORP_NAME_IDENTITY`) counts it as unresolved.
Callers that know the spelling statically should use the `NAME_ID_*`
constants instead of a lookup.
---
pure func synthesized_name_id(spelling: String) -> NameId:
	match name_table_find_id(SYNTHESIZED_NAME_TABLE, spelling):
		Some(id):
			id
		None:
			name_id_unseeded_spelling()


---
The id `synthesized_name_id` and the parser's seeded lookup return for a
spelling the closed synthesized vocabulary does not contain. Distinct from
`name_id_pending_dynamic_intern()` (a deliberately un-interned identifier,
-1) so a census can tell "never seeded, a bug" from "pending later plumbing".
Like the pending id it is negative, so it never equals a real dense id and
`name_spelling` has no spelling for it.
---
pure func name_id_unseeded_spelling() -> NameId:
	name_id(-2)


---
How many tuple field positions (`"0"`, `"1"`, ...) the synthesized vocabulary
seeds; a static subscript past the last one keeps the pending id. Must match
the number of digit entries in `name_table_synthesized_spellings()`
(a name-table test asserts it).
---
TUPLE_FIELD_SEEDED_COUNT: Int = 16


---
The id of the field a static tuple subscript at `index` names: the seeded
digit spelling, or `name_id_pending_dynamic_intern()` for a position past the
seeded range (no tuple in the compiler or standard library is that wide).
---
pure func tuple_field_name_id(index: Int) -> NameId:
	if index >= 0 and index < TUPLE_FIELD_SEEDED_COUNT:
		name_id(NAME_ID_TUPLE_FIELD_ZERO_INDEX + index)
	else:
		name_id_pending_dynamic_intern()


---
A table read-only after discovery, plus the spellings one later phase mints
for itself.

Discovery publishes one immutable `NameTable` (the frontend graph's). A phase
that runs after that -- typecheck, CTFE, lowering -- cannot append to it, but
can own a `NameTableExtension`: ids continue densely above the base table's
count, a spelling the base already has resolves to the base id (an extension
never re-mints a base spelling), and the phase publishes the extension on its
result so a consumer can resolve any id with `name_spelling_in_extension`.
Extensions of different phases (or different modules) are independent and
their ids overlap; an id is only meaningful together with the base and
extension it came from, so a phase must not mix them.

No production phase owns one yet: each remaining post-discovery identifier
site (see `name_id_pending_dynamic_intern`) lacks a way to reach the base
table, let alone publish an extension, without new plumbing.
---
opaque type NameTableExtension = NameTableExtensionRep


private record NameTableExtensionRep {
	base_count: Int,
	spellings: List[String],
	id_by_spelling: Dict[String, Int]
}


pure func name_table_extension_empty(base: NameTable) -> NameTableExtension:
	into_opaque NameTableExtension({
			base_count = name_table_count(base),
			spellings = [],
			id_by_spelling = {}
		})


pure func name_table_extension_count(extension: NameTableExtension) -> Int:
	from_opaque NameTableExtension(extension).spellings.length()


---
Resolves `spelling` to its base id if the base has it, else to the
extension's id for it, minting the next id above the base when this is the
first time either has seen it.
---
pure func name_table_extension_intern(
	base: NameTable,
	extension: NameTableExtension,
	spelling: String,
) -> (NameTableExtension, NameId):
	match name_table_find_id(base, spelling):
		Some(base_id):
			(extension, base_id)
		None:
			rep = from_opaque NameTableExtension(extension)

			match rep.id_by_spelling.get(spelling):
				Some(existing_id):
					(extension, name_id(existing_id))
				None:
					new_id = rep.base_count + rep.spellings.length()
					(into_opaque NameTableExtension({
								base_count = rep.base_count,
								spellings = rep.spellings.append(spelling),
								id_by_spelling = rep.id_by_spelling.set(spelling, new_id)
							}), name_id(new_id))


---
The spelling of `id` in `base` extended by `extension`.
---
pure func name_spelling_in_extension(
	base: NameTable,
	extension: NameTableExtension,
	id: NameId,
) -> Option[String]:
	rep = from_opaque NameTableExtension(extension)
	index = name_id_index(id)

	if index < rep.base_count:
		name_spelling(base, id)
	else:
		rep.spellings.get(index - rep.base_count)


---
The id of an identifier that is still built from source text after discovery
by a phase with no way to reach the compilation's name table. `.text` is
authoritative for it; the negative index can never equal a real `NameId`
(every real one is a non-negative dense index), so no reader can mistake this
for a resolved identity, and the name-identity check counts each one.

Survivors and the seam each needs:
  * `source_ast_finalize.brp`: the callee of a subscript read with zero or
    more than five indices (`tensorN_checked_get` does not exist in the
    standard library, so the call is a name error anyway) -- the
    `rewrite_subscript_read_*` pass takes no name accumulator.
  * `stage_07_ctfe/materialize.brp` (seven sites): constructor, field and
    function names of a materialized CTFE value -- `CtfeContext` carries no
    `NameTable`; needs the frontend graph's table threaded through
    `evaluated_typecheck_artifact` and `ctfe_context_from_program`.
  * `stage_06_typecheck/infer.brp`: the `__resource_*` loop item, and the
    tuple field named by a static subscript index past
    `TUPLE_FIELD_SEEDED_COUNT` -- inference has no `NameTableExtension` to
    append to or publish (expression recursion).
  * `stage_06_typecheck/modules/module_prelude.brp`: the default import alias
    -- module preparation has no table.
  * `stage_08_core_lower/lower.brp`: the `with ?=` payload binder -- lowering
    has no table.
---
pure func name_id_pending_dynamic_intern() -> NameId:
	name_id(-1)
