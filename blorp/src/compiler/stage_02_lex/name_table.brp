-- One compilation-wide spelling catalog.
--
-- `NameTable` replaces the lexer's former per-file `texts`/`by_text` locals
-- with an accumulator that can be threaded across every file in one
-- compilation: the same spelling anywhere in the compilation gets the same
-- id, and ids are assigned densely in encounter order (file order, then
-- first occurrence within a file). A single-file caller (the formatter,
-- LSP incremental reparse, standalone tools, tests) starts from
-- `EMPTY_NAME_TABLE` and gets a table scoped to that one lex; discovery
-- threads one table through every file so ids are shared compilation-wide.
--
-- `NameId` is a spelling identity, not a semantic entity identity: two
-- different bindings that happen to share a spelling share a `NameId`.
-- Hygiene (distinguishing same-named locals) and semantic identity remain
-- the responsibility of later phases (see docs/IDENTITY_ROADMAP.md,
-- "Value identity through the front end and Core").
--
-- Where a `ParsedIdentifier`'s id comes from, by phase:
--   * lexing: every identifier, integer-literal and `#`-prefixed dimension
--     spelling in a file (and in each interpolation hole, which discovery
--     lexes against the same accumulator) is interned here;
--   * parsing: spellings the parser fabricates come from the closed
--     `name_table_synthesized_spellings()` vocabulary, pre-seeded into every
--     compilation's table;
--   * after discovery has published the table (typecheck, CTFE, lowering)
--     the table is immutable, so a phase that must mint a spelling the
--     compilation never wrote uses a `NameTableExtension` (below).
opaque type NameId = Int


private record NameTableRep {
	spellings: List[String],
	id_by_spelling: Dict[String, Int]
}


opaque type NameTable = NameTableRep

---
The table with no spellings: what a single-file lex (formatter, tools, tests)
starts from. A shared immutable constant, not a function, so no caller
rebuilds it.
---
EMPTY_NAME_TABLE: NameTable = into_opaque NameTable({
		spellings = [],
		id_by_spelling = {}
	})


pure func name_table_spellings(table: NameTable) -> List[String]:
	from_opaque NameTable(table).spellings


pure func name_table_dict(table: NameTable) -> Dict[String, Int]:
	from_opaque NameTable(table).id_by_spelling


pure func name_table_from_parts(
	spellings: List[String],
	id_by_spelling: Dict[String, Int],
) -> NameTable:
	into_opaque NameTable({
			spellings = spellings,
			id_by_spelling = id_by_spelling
		})


pure func name_table_count(table: NameTable) -> Int:
	name_table_spellings(table).length()


private pure func name_id(index: Int) -> NameId:
	into_opaque NameId(index)


pure func name_id_index(id: NameId) -> Int:
	from_opaque NameId(id)


pure func name_ids_equal(left: NameId, right: NameId) -> Bool:
	name_id_index(left) == name_id_index(right)


implements Equatable for NameId:
	pure func equals(left: NameId, right: NameId) -> Bool:
		name_ids_equal(left, right)


---
Hashes the spelling index, consistent with `name_ids_equal`, so name ids can
key Dict and Set.
---
implements Hashable for NameId:
	pure func hash(self: NameId) -> Int:
		name_id_index(self).hash()


---
Looks up the id already assigned to `spelling`, or mints the next dense id
and appends it when this is the first time this table has seen it.
---
pure func name_table_intern(table: NameTable, spelling: String) -> (NameTable, Int):
	id_by_spelling = name_table_dict(table)

	match id_by_spelling.get(spelling):
		Some(existing_id):
			(table, existing_id)
		None:
			spellings = name_table_spellings(table)
			new_id = spellings.length()
			(name_table_from_parts(
					spellings.append(spelling),
					id_by_spelling.set(spelling, new_id),
				), new_id)


pure func name_table_find_id(table: NameTable, spelling: String) -> Option[NameId]:
	name_table_dict(table)
		.get(spelling)
		.map(name_id)


pure func name_table_id_at(table: NameTable, index: Int) -> Option[NameId]:
	match name_table_spellings(table).get(index):
		Some(_):
			Some(name_id(index))
		None:
			None


pure func name_spelling(table: NameTable, id: NameId) -> Option[String]:
	name_table_spellings(table).get(name_id_index(id))


---
THE way to render an identifier at a boundary (diagnostic, formatter, LSP,
dump): the spelling `table` holds for `id`, falling back to the identifier's
own `text` when the table has none (a pending or unseeded id, or a table
that is not the one the id came from).

While `text` is still carried beside every `NameId` the two agree, so this
renders the same string either way; once identifiers carry only their id,
`text` disappears from the signature and the table is the sole source of
spellings.
---
pure func name_spelling_or_text(table: NameTable, id: NameId, text: String) -> String:
	match name_spelling(table, id):
		Some(spelling):
			spelling
		None:
			text


---
Where a diagnostic reads an identifier's spelling from. `SpellingsFromNameTable`
when the table the identifier's `NameId` indexes is at hand; otherwise
`SpellingsFromIdentifierText`, so a construction path cannot leave "no table"
as an empty table that silently agrees with nothing (an id from a private
per-program table must never be looked up in a table it does not index).
---
union IdentifierSpellings:
	SpellingsFromNameTable(NameTable)
	SpellingsFromIdentifierText


---
The spelling of the identifier `(id, text)` for a diagnostic, from `spellings`.
Through a table it is `name_spelling_or_text`; without one it is `text`.
---
pure func identifier_spelling(spellings: IdentifierSpellings, id: NameId, text: String) -> String:
	match spellings:
		SpellingsFromNameTable(table):
			name_spelling_or_text(table, id, text)
		SpellingsFromIdentifierText:
			text


---
`name_spelling_or_text` for a consumer that still holds an identifier's
spelling as a `String` rather than its `NameId` (Core, and the LSP's semantic
occurrences): resolves the spelling through `table` and renders what the table
holds for it, or `text` unchanged when the table has never seen it (a
synthesized name). A temporary bridge: it disappears when those consumers
carry the `NameId` and call `name_spelling_or_text` directly.
---
pure func name_spelling_of_text(table: NameTable, text: String) -> String:
	match name_table_find_id(table, text):
		Some(id):
			name_spelling_or_text(table, id, text)
		None:
			text


---
Wraps an index that is already known to be a valid dense position in some
name table as a `NameId`, without needing the table itself in hand.

The one legitimate caller is the identifier-token path: the lexer assigns
an `IdentifierTag` token's payload from this same table (`name_table_intern`
during lexing), so that payload already *is* the spelling's `NameId` index.
Do not call this on an index that has not gone through interning -- callers
elsewhere should go through `name_table_find_id` or `name_table_id_at`.
---
pure func name_id_from_interned_index(index: Int) -> NameId:
	name_id(index)


---
The closed vocabulary of spellings the parser synthesizes itself rather than
reading from a token: every keyword spelling (a reserved keyword written
where a name belongs is echoed back as that name, and several keywords have
a soft-identifier use such as `after`/`debug`/`sealed`/`from`), the small set
of literal names desugaring and parser self-tests fabricate (`_`, `#`,
`resource`, `Type`, ...), `""` for error recovery, and the closed
vocabularies later phases synthesize: the builtin callees subscript lowering
and the typechecker name (`checked_get` ... `tensor5_checked_set`, fixed by
arity; `tensor.brp` stops at rank 5) and the foreign bridge JSON's argument
names (`include`, `link`, `link_<platform>`), and the first
`TUPLE_FIELD_SEEDED_COUNT` tuple field positions (`0` ... `15`), which a static
tuple subscript names as a field. Keeping the set here,
named, is what lets the parser only ever do read-only lookups
(`name_table_find_id`) against a pre-seeded table instead of appending new
spellings while it parses.

`""` is listed first so it gets a low, stable id across every table this
function seeds; nothing depends on the exact value, only on it existing.
---
