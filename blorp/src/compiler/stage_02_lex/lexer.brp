private TAB_WIDTH: Int = 4

private MAX_INTERPOLATION_DEPTH: Int = 64

private INT128_MAX_DECIMAL: String = "170141183460469231731687303715884105727"


record LexResult {
	tokens: List[Token],
	diagnostics: List[ParseDiagnostic]
}


private struct LambdaBodyLevel {
	group_depth: Int,
	base_indent: Int
}


private record LexerState {
	source: SourceFile,
	cursor: Cursor,
	diagnostics: List[ParseDiagnostic],
	pending_trivia: List[Trivia],
	indent_stack: List[Int],
	lambda_body_levels: List[LambdaBodyLevel],
	group_depth: Int,
	pending_newline: Bool,
	at_line_start: Bool,
	line_has_token: Bool,
	last_token_kind: Option[TokenKind],
	emitted_token: Option[Token],
	emitted_trivia: Option[Trivia]
}


pure func lex_ok(result: LexResult) -> Bool:
	result.diagnostics.is_empty()


private pure func initial_state(source: SourceFile) -> LexerState:
	{
		source = source,
		cursor = source_start(source),
		diagnostics = [],
		pending_trivia = [],
		indent_stack = [0],
		lambda_body_levels = [],
		group_depth = 0,
		pending_newline = False,
		at_line_start = True,
		line_has_token = False,
		last_token_kind = None,
		emitted_token = None,
		emitted_trivia = None
	}


private pure func is_digit_char(c: Char) -> Bool:
	c >= '0' and c <= '9'


private pure func is_ident_start(c: Char) -> Bool:
	c >= 'a' and c <= 'z' or c >= 'A' and c <= 'Z' or c == '_'


private pure func is_ident_continue(c: Char) -> Bool:
	is_ident_start(c) or is_digit_char(c)


private pure func is_space(c: Char) -> Bool:
	c == ' ' or c == '\t'


private pure func hex_value(c: Char) -> Int:
	if c >= '0' and c <= '9':
		to_int(c) - to_int('0')
	else if c >= 'a' and c <= 'f':
		10 + to_int(c) - to_int('a')
	else if c >= 'A' and c <= 'F':
		10 + to_int(c) - to_int('A')
	else:
		0


private pure func tab_advance(column: Int) -> Int:
	TAB_WIDTH - (column - 1) % TAB_WIDTH


private pure func advance(state: LexerState) -> LexerState:
	{ state | cursor = source_advance(state.source, state.cursor) }


private pure func peek(state: LexerState) -> Option[Char]:
	source_peek(state.source, state.cursor)


private pure func peek_next(state: LexerState) -> Option[Char]:
	next_cursor: Cursor = source_advance(state.source, state.cursor)
	source_peek(state.source, next_cursor)


private pure func peek_at(state: LexerState, offset: Int) -> Option[Char]:
	state.source.text.get(state.cursor.offset + offset)


private pure func span_from(
	state: LexerState,
	start_cursor: Cursor,
	end_cursor: Cursor,
) -> SourceSpan:
	source_span(state.source, start_cursor, end_cursor)


private pure func empty_span(state: LexerState) -> SourceSpan:
	source_empty_span(state.source, state.cursor)


private pure func add_error(state: LexerState, message: String) -> LexerState:
	diag: ParseDiagnostic = parse_error(empty_span(state), message)
	{ state | diagnostics = state.diagnostics.append(diag) }


private pure func add_error_at_span(
	state: LexerState,
	span: SourceSpan,
	message: String,
) -> LexerState:
	diag: ParseDiagnostic = parse_error(span, message)
	{ state | diagnostics = state.diagnostics.append(diag) }


private pure func kind_counts_as_line_token(kind: TokenKind) -> Bool:
	match kind:
		NewlineToken:
			False
		IndentToken:
			False
		DedentToken:
			False
		EndOfFileToken:
			False
		_:
			True


---
The single record update a token emission performs. Callers that scanned the
token by walking a `Cursor` hand back the cursor and the new group depth here
instead of rebuilding `LexerState` once per scanning step.
---
private pure func emitted_token_state(
	state: LexerState,
	kind: TokenKind,
	end_cursor: Cursor,
	group_depth: Int,
	emitted: Token,
) -> LexerState:
	{ state |
		cursor = end_cursor,
		group_depth = group_depth,
		pending_trivia = [],
		line_has_token = state.line_has_token or kind_counts_as_line_token(kind),
		last_token_kind = Some(kind),
		emitted_token = Some(emitted),
		emitted_trivia = None
	}


---
The exit for a step that produced neither a token nor trailing trivia. Every
state handed back to the `lex` loop passes through one of these three, which
is what keeps the two emission slots mutually exclusive and never stale.
---
private pure func stepped_state(state: LexerState) -> LexerState:
	{ state |
		emitted_token = None,
		emitted_trivia = None
	}


private pure func emit_token_at(
	state: LexerState,
	kind: TokenKind,
	span: SourceSpan,
	end_cursor: Cursor,
) -> LexerState:
	emitted: Token = token_with_trivia(kind, span, state.pending_trivia, [])
	emitted_token_state(state, kind, end_cursor, state.group_depth, emitted)


private pure func emit_token(state: LexerState, kind: TokenKind, span: SourceSpan) -> LexerState:
	emit_token_at(state, kind, span, state.cursor)


private pure func add_trailing_trivia(tokens: List[Token], trivia: Trivia) -> List[Token]:
	last: Int = tokens.length() - 1

	match tokens.get(last):
		Some(token):
			tokens.set(last, { token | trailing_trivia = token.trailing_trivia.append(trivia) })
		None:
			tokens


private pure func starts_with(state: LexerState, expected: String) -> Bool:
	expected_len: Int = expected.length()

	if state.cursor.offset + expected_len > state.source.text.length():
		False
	else:
		var index: Int = 0
		var matches: Bool = True

		while matches and index < expected_len:
			if state.source.text.get_or(
				state.cursor.offset + index,
				'\0',
			) == expected.get_or(index, '\0'):
				index += 1
			else:
				matches = False

		matches


private pure func cursor_advanced(source: SourceFile, cursor: Cursor, width: Int) -> Cursor:
	var moved: Cursor = cursor
	var remaining: Int = width

	while remaining > 0:
		moved = source_advance(source, moved)
		remaining -= 1

	moved


private pure func advance_n(state: LexerState, width: Int) -> LexerState:
	{ state | cursor = cursor_advanced(state.source, state.cursor, width) }


private pure func line_ends_after_optional_space(state: LexerState, offset: Int) -> Bool:
	var i: Int = offset
	var ok: Bool = False

	while True:
		match peek_at(state, i):
			Some(' '):
				i += 1
			Some('\t'):
				i += 1
			Some('\n'):
				ok = True
				break
			None:
				ok = True
				break
			_:
				break

	ok


private pure func starts_docstring_delimiter(state: LexerState) -> Bool:
	starts_with(state, "---") and line_ends_after_optional_space(state, 3)


private pure func consume_line(state: LexerState) -> LexerState:
	var st: LexerState = state

	while True:
		match peek(st):
			Some('\n'):
				st = advance(st)
				break
			Some(_):
				st = advance(st)
			None:
				break

	st


private pure func read_line_text(state: LexerState) -> (String, LexerState):
	var st: LexerState = state
	start_cursor: Cursor = st.cursor
	var text: String = ""

	while True:
		match peek(st):
			Some('\n'):
				line_span: SourceSpan = span_from(st, start_cursor, st.cursor)
				text = source_span_text(st.source, line_span)
				st = advance(st)
				break
			Some(_):
				st = advance(st)
			None:
				line_span: SourceSpan = span_from(st, start_cursor, st.cursor)
				text = source_span_text(st.source, line_span)
				break

	(text, st)


-- Leading spaces and tabs never change the line, so the run is scanned by
-- offset while the indent width and the column are carried forward together.
private pure func skip_line_spaces_with_indent(state: LexerState) -> (Int, LexerState):
	text: String = state.source.text
	var offset: Int = state.cursor.offset
	var column: Int = state.cursor.column
	var indent: Int = 0

	while True:
		match text.get(offset):
			Some(' '):
				indent += 1
				column += 1
				offset += 1
			Some('\t'):
				indent += tab_advance(indent + 1)
				column += tab_advance(column)
				offset += 1
			_:
				break

	next_state: LexerState = { state | cursor = {
			offset = offset,
			line = state.cursor.line,
			column = column
		} }

	(indent, next_state)


private pure func pipe_marker_at_margin(
	state: LexerState,
	margin_column: Int,
) -> (Bool, LexerState):
	(indent, marker_state) = skip_line_spaces_with_indent(state)

	if indent == margin_column - 1:
		match peek(marker_state):
			Some('|'):
				(True, marker_state)
			_:
				(False, marker_state)
	else:
		(False, marker_state)


private pure func raw_pipe_start_marker(state: LexerState) -> (Bool, Int, LexerState):
	(indent, marker_state) = skip_line_spaces_with_indent(state)

	match peek(marker_state):
		Some('|'):
			(True, indent + 1, marker_state)
		_:
			(False, indent + 1, marker_state)


private pure func raw_pipe_start_after_raw(state: LexerState) -> Option[(Int, LexerState)]:
	if not starts_with(state, "raw"):
		None
	else:
		match peek_at(state, 3):
			Some(c):
				if is_ident_continue(c):
					None
				else:
					after_raw: LexerState = advance_n(state, 3)
					(_, after_spaces) = skip_line_spaces_with_indent(after_raw)

					match peek(after_spaces):
						Some('\n'):
							after_newline: LexerState = advance(after_spaces)
							(ok, margin_column, marker_state) = raw_pipe_start_marker(after_newline)

							if ok:
								Some((margin_column, marker_state))
							else:
								None
						_:
							None
			None:
				None


private pure func escape_char(c: Char) -> Option[Char]:
	match c:
		'n':
			Some('\n')
		't':
			Some('\t')
		'r':
			Some('\r')
		'\\':
			Some('\\')
		'\"':
			Some('\"')
		'\'':
			Some('\'')
		'0':
			Some(to_char(0))
		'{':
			Some('{')
		'}':
			Some('}')
		_:
			None


private pure func scan_unicode_escape(state: LexerState) -> (Option[Int], LexerState):
	var st: LexerState = advance_n(state, 3)
	var codepoint: Int = 0
	var digits: Int = 0
	var has_error: Bool = False

	while not has_error:
		match peek(st):
			Some('}'):
				break
			Some(c):
				if (
					is_digit_char(c)
					or c >= 'a' and c <= 'f'
					or c >= 'A' and c <= 'F'
				):
					digits += 1

					if digits > 6:
						has_error = True
						st = add_error(st, "Unicode escape \\u{} must contain 1-6 hex digits")
					else:
						codepoint = codepoint * 16 + hex_value(c)
						st = advance(st)
				else:
					has_error = True
					st = add_error(st, "Unicode escape \\u{} must contain only hex digits")
			None:
				has_error = True
				st = add_error(st, "unterminated Unicode escape")

	if has_error:
		(None, st)
	else if digits == 0:
		(None, add_error(st, "Unicode escape \\u{} must contain 1-6 hex digits"))
	else:
		after_close: LexerState = advance(st)

		-- Unicode scalar values exclude UTF-16 surrogates and values above U+10FFFF.
		if codepoint > 1114111 or codepoint >= 55296 and codepoint <= 57343:
			(None, add_error(after_close, "Unicode codepoint is out of range or a surrogate"))
		else:
			(Some(codepoint), after_close)


private pure func append_source_segment(
	text: String,
	state: LexerState,
	start_cursor: Cursor,
	end_cursor: Cursor,
) -> String:
	if end_cursor.offset > start_cursor.offset:
		text + source_span_text(
			state.source,
			source_span(state.source, start_cursor, end_cursor),
		)
	else:
		text


-- A literal body never spans a line, so a run inside one is scanned by offset
-- with only tabs moving the column by more than one.
private pure func run_end_state(state: LexerState, end_offset: Int, end_column: Int) -> LexerState:
	if end_offset == state.cursor.offset:
		state
	else:
		{ state | cursor = {
				offset = end_offset,
				line = state.cursor.line,
				column = end_column
			} }


-- Skip the run of string-body characters that are copied verbatim, stopping at
-- the closing quote, a newline, an escape, or an interpolation marker.
private pure func skip_plain_string_run(state: LexerState) -> LexerState:
	text: String = state.source.text
	var offset: Int = state.cursor.offset
	var column: Int = state.cursor.column

	while True:
		match text.get(offset):
			Some('\"'):
				break
			Some('\n'):
				break
			Some('\\'):
				break
			Some('$'):
				break
			Some('\t'):
				column += tab_advance(column)
				offset += 1
			Some(_):
				column += 1
				offset += 1
			None:
				break

	run_end_state(state, offset, column)


-- Skip the run of interpolated-tail characters that are copied verbatim,
-- stopping at any character that changes brace depth, quoting, or escaping.
private pure func skip_plain_interpolation_run(state: LexerState) -> LexerState:
	text: String = state.source.text
	var offset: Int = state.cursor.offset
	var column: Int = state.cursor.column

	while True:
		match text.get(offset):
			Some('\"'):
				break
			Some('$'):
				break
			Some('{'):
				break
			Some('}'):
				break
			Some('\\'):
				break
			Some('\n'):
				break
			Some('\t'):
				column += tab_advance(column)
				offset += 1
			Some(_):
				column += 1
				offset += 1
			None:
				break

	run_end_state(state, offset, column)


-- Skip the run of pipe-line characters that are copied verbatim, stopping at
-- the end of the line or at an interpolation marker.
private pure func skip_plain_pipe_run(state: LexerState) -> LexerState:
	text: String = state.source.text
	var offset: Int = state.cursor.offset
	var column: Int = state.cursor.column

	while True:
		match text.get(offset):
			Some('\n'):
				break
			Some('$'):
				break
			Some('\t'):
				column += tab_advance(column)
				offset += 1
			Some(_):
				column += 1
				offset += 1
			None:
				break

	run_end_state(state, offset, column)


private pure func consume_until_single_quote(state: LexerState) -> LexerState:
	var st: LexerState = state

	while True:
		match peek(st):
			Some('\''):
				st = advance(st)
				break
			Some('\n'):
				break
			Some(_):
				st = advance(st)
			None:
				break

	st


-- Spaces and tabs never change the line, so the run is scanned by offset and
-- the column is carried forward instead of recomputed per character.
private pure func scan_docstring(state: LexerState) -> LexerState:
	start_cursor: Cursor = state.cursor
	var st: LexerState = consume_line(state)
	var text: String = string(128)
	var first_line: Bool = True
	var has_error: Bool = False

	while not has_error:
		if starts_docstring_delimiter(st):
			st = consume_line(st)
			break
		else:
			match peek(st):
				None:
					has_error = True
					st = add_error(st, "Unterminated docstring: missing closing ---")
				Some(_):
					(line, next_state) = read_line_text(st)

					if first_line:
						text = line
						first_line = False
					else:
						text = text + "\n" + line

					st = next_state

	if has_error:
		stepped_state(st)
	else:
		span: SourceSpan = span_from(st, start_cursor, st.cursor)
		kind: TokenKind = DocStringToken(text)
		emitted: Token = token_with_trivia(kind, span, st.pending_trivia, [])
		{ st |
			pending_trivia = [],
			pending_newline = False,
			at_line_start = True,
			line_has_token = False,
			last_token_kind = Some(kind),
			emitted_token = Some(emitted),
			emitted_trivia = None
		}


private pure func scan_string_literal(state: LexerState) -> LexerState:
	start_cursor: Cursor = state.cursor
	var st: LexerState = advance(state)
	var segment_start: Cursor = st.cursor
	var text: String = string(32)
	var has_error: Bool = False
	var is_interpolated: Bool = False

	while True:
		st = skip_plain_string_run(st)

		match peek(st):
			Some('\"'):
				text = append_source_segment(text, st, segment_start, st.cursor)
				st = advance(st)
				break
			Some('\n'):
				has_error = True
				st = add_error(
					st,
					"Unterminated string literal. Use aligned pipe strings for multiline text",
				)
				st = advance(st)
				break
			Some('\\'):
				text = append_source_segment(text, st, segment_start, st.cursor)

				if starts_with(st, "\\u{"):
					(codepoint, next_state) = scan_unicode_escape(st)
					st = next_state

					match codepoint:
						Some(value):
							text = text.append_char(to_char(value))
							segment_start = st.cursor
						None:
							has_error = True
				else:
					escape_start: LexerState = st
					st = advance(st)

					match peek(st):
						Some(escaped):
							match escape_char(escaped):
								Some(c):
									text = text.append_char(c)
									st = advance(st)
									segment_start = st.cursor
								None:
									has_error = True
									st = add_error(
										escape_start,
										"unknown escape sequence '\\" + escaped.to_string() + "'",
									)
									st = advance(st)
						None:
							has_error = True
							st = add_error(escape_start, "unterminated escape sequence")
							break
			Some('$'):
				if starts_with(st, "$" + "{"):
					text = append_source_segment(text, st, segment_start, st.cursor)
					is_interpolated = True
					st = advance_n(st, 2)
					break
				else:
					st = advance(st)
			Some(_):
				st = advance(st)
			None:
				has_error = True
				st = add_error(st, "Unterminated string literal: missing closing '\"'")
				break

	if has_error:
		stepped_state(st)
	else if is_interpolated:
		scan_interpolated_string_tail(st, start_cursor, text)
	else:
		span: SourceSpan = span_from(st, start_cursor, st.cursor)
		emit_token(
			st,
			StringLiteralToken(NormalStringLiteral, text),
			span,
		)


private pure func scan_raw_string_literal(state: LexerState) -> LexerState:
	start_cursor: Cursor = state.cursor
	var st: LexerState = advance_n(state, 4)
	body_start: Cursor = st.cursor
	source_text: String = st.source.text
	var offset: Int = st.cursor.offset
	var column: Int = st.cursor.column

	while True:
		match source_text.get(offset):
			Some('\"'):
				break
			Some('\n'):
				break
			Some('\t'):
				column += tab_advance(column)
				offset += 1
			Some(_):
				column += 1
				offset += 1
			None:
				break

	st = run_end_state(st, offset, column)
	text: String = append_source_segment(string(32), st, body_start, st.cursor)
	var has_error: Bool = False

	match peek(st):
		Some('\"'):
			st = advance(st)
		Some('\n'):
			has_error = True
			st = add_error(st, "Raw string cannot span multiple lines")
			st = advance(st)
		_:
			has_error = True
			st = add_error(st, "Unterminated raw string literal: missing closing '\"'")

	if has_error:
		stepped_state(st)
	else:
		span: SourceSpan = span_from(st, start_cursor, st.cursor)
		emit_token(
			st,
			StringLiteralToken(RawStringLiteral, text),
			span,
		)


private pure func scan_interpolated_string_tail(
	state: LexerState,
	span_start: Cursor,
	prefix: String,
) -> LexerState:
	var st: LexerState = state
	var text: String = prefix + "{"
	var brace_depth: Int = 1
	var in_string: Bool = False
	var has_error: Bool = False

	while not has_error:
		run_state: LexerState = skip_plain_interpolation_run(st)
		text = append_source_segment(text, st, st.cursor, run_state.cursor)
		st = run_state

		match peek(st):
			Some('\"'):
				if brace_depth > 0:
					text = text.append_char('\"')
					in_string = not in_string
					st = advance(st)
				else:
					st = advance(st)
					break
			Some('$'):
				if starts_with(st, "$" + "{"):
					if in_string:
						text = text + "$" + "{"
					else:
						text = text.append_char('{')
						brace_depth += 1

						if brace_depth > MAX_INTERPOLATION_DEPTH:
							has_error = True
							st = add_error(st, "string interpolation nested too deeply")

					if not has_error:
						st = advance_n(st, 2)
				else:
					text = text.append_char('$')
					st = advance(st)
			Some('{'):
				if in_string:
					text = text.append_char('{')
				else if brace_depth > 0:
					text = text.append_char('{')
					brace_depth += 1
				else:
					text += "\\{"

				st = advance(st)
			Some('}'):
				if in_string:
					text = text.append_char('}')
				else if brace_depth > 0:
					text = text.append_char('}')
					brace_depth -= 1
				else:
					text += "\\}"

				st = advance(st)
			Some('\\'):
				text = text.append_char('\\')
				st = advance(st)

				match peek(st):
					Some(escaped):
						text = text.append_char(escaped)
						st = advance(st)
					None:
						has_error = True
						st = add_error(st, "unterminated interpolated string")
			Some('\n'):
				has_error = True
				st = add_error(
					st,
					"Unterminated interpolated string. Use aligned pipe strings for multiline text",
				)
				st = advance(st)
			Some(c):
				text = text.append_char(c)
				st = advance(st)
			None:
				has_error = True
				st = add_error(st, "Unterminated interpolated string: missing closing '\"'")

	if has_error:
		stepped_state(st)
	else:
		span: SourceSpan = span_from(st, span_start, st.cursor)
		emit_token(
			st,
			StringLiteralToken(InterpolatedStringLiteral, text),
			span,
		)


private pure func read_pipe_line_content(
	state: LexerState,
	raw: Bool,
) -> (String, Bool, LexerState, Bool):
	var st: LexerState = state
	var text: String = string(64)
	var saw_interp: Bool = False
	var ended_with_newline: Bool = False

	while True:
		run_state: LexerState = skip_plain_pipe_run(st)
		text = append_source_segment(text, st, st.cursor, run_state.cursor)
		st = run_state

		match peek(st):
			Some('\n'):
				st = advance(st)
				ended_with_newline = True
				break
			Some('$'):
				if not raw and starts_with(st, "$" + "{"):
					text = text.append_char('{')
					saw_interp = True
					st = advance_n(st, 2)
				else:
					text = text.append_char('$')
					st = advance(st)
			Some(c):
				text = text.append_char(c)
				st = advance(st)
			None:
				break

	(text, saw_interp, st, ended_with_newline)


private pure func scan_pipe_block(
	state: LexerState,
	span_start: Cursor,
	margin_column: Int,
	raw: Bool,
) -> LexerState:
	var st: LexerState = state
	var text: String = string(128)
	var saw_interp: Bool = False
	var first_line: Bool = True
	var ended_with_newline: Bool = False
	var has_error: Bool = False

	while not has_error:
		if not first_line:
			text = text.append_char('\n')

		if not raw and starts_with(st, "||"):
			text = text.append_char('|')
			st = advance_n(st, 2)
		else:
			match peek(st):
				Some('|'):
					st = advance(st)
				_:
					has_error = True
					st = add_error(
						st,
						"Expected aligned pipe string marker at column " + margin_column.to_string(),
					)

		if not has_error:
			line_result: (String, Bool, LexerState, Bool) = read_pipe_line_content(st, raw)
			line_text: String = line_result[0]
			line_saw_interp: Bool = line_result[1]
			next_state: LexerState = line_result[2]
			line_ended_with_newline: Bool = line_result[3]
			text += line_text
			saw_interp = saw_interp or line_saw_interp
			st = next_state
			ended_with_newline = line_ended_with_newline

			if ended_with_newline:
				(continues, marker_state) = pipe_marker_at_margin(st, margin_column)

				if continues:
					st = marker_state
					first_line = False
				else:
					break
			else:
				break

	if has_error:
		stepped_state(st)
	else:
		span: SourceSpan = span_from(st, span_start, st.cursor)

		var string_kind: StringLiteralKind = PipeStringLiteral

		if raw:
			string_kind = RawPipeStringLiteral
		else if saw_interp:
			string_kind = InterpolatedPipeStringLiteral

		kind: TokenKind = StringLiteralToken(string_kind, text)
		emitted: Token = token_with_trivia(kind, span, st.pending_trivia, [])
		var next_state: LexerState = { st |
			pending_trivia = [],
			line_has_token = True,
			last_token_kind = Some(kind),
			emitted_token = Some(emitted),
			emitted_trivia = None
		}

		if ended_with_newline:
			next_state = { next_state |
				pending_newline = True,
				at_line_start = True,
				line_has_token = False
			}

		next_state


private pure func scan_char_literal(state: LexerState) -> LexerState:
	start_cursor: Cursor = state.cursor
	var st: LexerState = advance(state)
	var codepoint: Int = 0
	var has_value: Bool = False
	var has_error: Bool = False

	match peek(st):
		Some('\\'):
			if starts_with(st, "\\u{"):
				(value, next_state) = scan_unicode_escape(st)
				st = next_state

				match value:
					Some(cp):
						codepoint = cp
						has_value = True
					None:
						has_error = True
			else:
				escape_start: LexerState = st
				st = advance(st)

				match peek(st):
					Some(escaped):
						match escape_char(escaped):
							Some(c):
								codepoint = to_int(c)
								has_value = True
								st = advance(st)
							None:
								has_error = True
								st = add_error(
									escape_start,
									"unknown escape sequence '\\" + escaped.to_string() + "'",
								)
								st = advance(st)
					None:
						has_error = True
						st = add_error(escape_start, "unterminated character literal")
		Some('\n'):
			has_error = True
			st = add_error(
				st,
				"Invalid character literal: expected single character between quotes",
			)
		Some(c):
			codepoint = to_int(c)
			has_value = True
			st = advance(st)
		None:
			has_error = True
			st = add_error(st, "unterminated character literal")

	if not has_error:
		match peek(st):
			Some('\''):
				st = advance(st)
			_:
				has_error = True
				st = add_error(
					st,
					"Invalid character literal: expected single character between quotes",
				)

	if has_error or not has_value:
		stepped_state(consume_until_single_quote(st))
	else:
		span: SourceSpan = span_from(st, start_cursor, st.cursor)
		emit_token(st, CharLiteralToken(codepoint), span)


-- Identifier characters are never newlines or tabs, so the run is scanned by
-- offset and the end cursor is computed once instead of per character.
private pure func identifier_end_cursor(source: SourceFile, start_cursor: Cursor) -> Cursor:
	text: String = source.text
	var offset: Int = start_cursor.offset

	while True:
		match text.get(offset):
			Some(c):
				if is_ident_continue(c):
					offset += 1
				else:
					break
			None:
				break

	{
		offset = offset,
		line = start_cursor.line,
		column = start_cursor.column + offset - start_cursor.offset
	}


private pure func keyword_for(text: String) -> Option[Keyword]:
	match text:
		"func":
			Some(FuncKeyword)
		"pure":
			Some(PureKeyword)
		"var":
			Some(VarKeyword)
		"union":
			Some(UnionKeyword)
		"record":
			Some(RecordKeyword)
		"void":
			Some(VoidKeyword)
		"while":
			Some(WhileKeyword)
		"for":
			Some(ForKeyword)
		"in":
			Some(InKeyword)
		"if":
			Some(IfKeyword)
		"else":
			Some(ElseKeyword)
		"and":
			Some(AndKeyword)
		"or":
			Some(OrKeyword)
		"not":
			Some(NotKeyword)
		"on":
			Some(OnKeyword)
		"match":
			Some(MatchKeyword)
		"True":
			Some(TrueKeyword)
		"False":
			Some(FalseKeyword)
		"break":
			Some(BreakKeyword)
		"continue":
			Some(ContinueKeyword)
		"debug":
			Some(DebugKeyword)
		"struct":
			Some(StructKeyword)
		"enum":
			Some(EnumKeyword)
		"with":
			Some(WithKeyword)
		"resource":
			Some(ResourceKeyword)
		"foreign":
			Some(ForeignKeyword)
		"private":
			Some(PrivateKeyword)
		"builtin":
			Some(BuiltinKeyword)
		"concurrent":
			Some(ConcurrentKeyword)
		"concurrently":
			Some(ConcurrentlyKeyword)
		"detach":
			Some(DetachKeyword)
		"select":
			Some(SelectKeyword)
		"into_opaque":
			Some(IntoOpaqueKeyword)
		"from":
			Some(FromKeyword)
		"from_opaque":
			Some(FromOpaqueKeyword)
		"after":
			Some(AfterKeyword)
		"sealed":
			Some(SealedKeyword)
		"opaque":
			Some(OpaqueKeyword)
		"try":
			Some(TryKeyword)
		"import":
			Some(ImportKeyword)
		"as":
			Some(AsKeyword)
		"trait":
			Some(TraitKeyword)
		"implements":
			Some(ImplementsKeyword)
		"Self":
			Some(SelfKeyword)
		"type":
			Some(TypeKeyword)
		"alias":
			Some(AliasKeyword)
		"where":
			Some(WhereKeyword)
		_:
			None


private pure func scan_identifier(state: LexerState) -> LexerState:
	start_cursor: Cursor = state.cursor
	end_cursor: Cursor = identifier_end_cursor(state.source, start_cursor)
	span: SourceSpan = span_from(state, start_cursor, end_cursor)
	text: String = source_span_text(state.source, span)

	match keyword_for(text):
		Some(keyword):
			emit_token_at(state, KeywordToken(keyword), span, end_cursor)
		None:
			emit_token_at(state, IdentifierToken(text), span, end_cursor)


private pure func first_significant_decimal_digit(text: String) -> Int:
	var index: Int = 0

	while index + 1 < text.length():
		if text.get_or(index, '0') == '0':
			index += 1
		else:
			break

	index


private pure func decimal_literal_leq(left: String, right: String) -> Bool:
	left_start: Int = first_significant_decimal_digit(left)
	right_start: Int = first_significant_decimal_digit(right)
	left_len: Int = left.length() - left_start
	right_len: Int = right.length() - right_start

	if left_len < right_len:
		True
	else if left_len > right_len:
		False
	else:
		var result: Bool = True
		var comparing: Bool = True
		var index: Int = 0

		while comparing and index < left_len:
			left_char: Char = left.get_or(left_start + index, '0')
			right_char: Char = right.get_or(right_start + index, '0')

			if left_char < right_char:
				comparing = False
				result = True
			else if left_char > right_char:
				comparing = False
				result = False
			else:
				index += 1

		result


-- Digits and the single fraction dot are never newlines or tabs, so the run is
-- scanned by offset and the end cursor is computed once.
private pure func group_depth_after_symbol(depth: Int, symbol: Symbol) -> Int:
	match symbol:
		LeftParenSymbol:
			depth + 1
		LeftBracketSymbol:
			depth + 1
		LeftBraceSymbol:
			depth + 1
		RightParenSymbol:
			if depth <= 0:
				0
			else:
				depth - 1
		RightBracketSymbol:
			if depth <= 0:
				0
			else:
				depth - 1
		RightBraceSymbol:
			if depth <= 0:
				0
			else:
				depth - 1
		_:
			depth


private struct SymbolMatch {
	symbol: Symbol,
	width: Int
}


private struct NumberScan {
	end_offset: Int,
	saw_dot: Bool
}


private pure func top_indent(indent_stack: List[Int]) -> Int:
	indent_stack.get_or(0, 0)


private pure func top_lambda_level(levels: List[LambdaBodyLevel]) -> Option[LambdaBodyLevel]:
	levels.get(0)


private pure func in_lambda_body_at(levels: List[LambdaBodyLevel], group_depth: Int) -> Bool:
	match top_lambda_level(levels):
		Some(level):
			group_depth >= level.group_depth
		None:
			False


private pure func in_nested_group_in_lambda_at(
	levels: List[LambdaBodyLevel],
	group_depth: Int,
) -> Bool:
	match top_lambda_level(levels):
		Some(level):
			group_depth > level.group_depth
		None:
			False


private pure func kind_is_colon_symbol(kind: Option[TokenKind]) -> Bool:
	match kind:
		Some(SymbolToken(ColonSymbol)):
			True
		_:
			False


private pure func can_enter_lambda_body_at(
	levels: List[LambdaBodyLevel],
	group_depth: Int,
	last_token_kind: Option[TokenKind],
) -> Bool:
	group_depth > 0 and kind_is_colon_symbol(last_token_kind) and match top_lambda_level(levels):
		Some(level):
			group_depth > level.group_depth
		None:
			True


private pure func dropped_first_lambda_level(
	levels: List[LambdaBodyLevel],
) -> List[LambdaBodyLevel]:
	var rest: List[LambdaBodyLevel] = []
	var i: Int = 1

	while i < levels.length():
		match levels.get(i):
			Some(level):
				rest = rest.append(level)
			None:
				void

		i += 1

	rest


private pure func pruned_lambda_body_levels(
	levels: List[LambdaBodyLevel],
	indent_stack: List[Int],
) -> List[LambdaBodyLevel]:
	var remaining: List[LambdaBodyLevel] = levels

	while True:
		match top_lambda_level(remaining):
			Some(level):
				if top_indent(indent_stack) <= level.base_indent:
					remaining = dropped_first_lambda_level(remaining)
				else:
					break
			None:
				break

	remaining


private pure func dedent_would_be_inconsistent_at(indent_stack: List[Int], indent: Int) -> Bool:
	var i: Int = 0
	var inconsistent: Bool = False

	while i < indent_stack.length():
		match indent_stack.get(i):
			Some(level):
				if indent >= level:
					break
				else:
					next_level: Int = indent_stack.get_or(i + 1, 0)

					if indent > next_level:
						inconsistent = True
						break
					else:
						i += 1
			None:
				break

	inconsistent


private pure func lambda_body_close_indent_at(
	levels: List[LambdaBodyLevel],
	group_depth: Int,
	indent_stack: List[Int],
	indent: Int,
) -> Option[Int]:
	match top_lambda_level(levels):
		Some(level):
			if (
				group_depth == level.group_depth
				and indent > level.base_indent
				and indent < top_indent(indent_stack)
				and dedent_would_be_inconsistent_at(indent_stack, indent)
			):
				Some(level.base_indent)
			else:
				None
		None:
			None


private pure func text_starts_with(source: SourceFile, cursor: Cursor, expected: String) -> Bool:
	expected_len: Int = expected.length()

	if cursor.offset + expected_len > source.text.length():
		False
	else:
		var index: Int = 0
		var matches: Bool = True

		while matches and index < expected_len:
			if source.text.get_or(cursor.offset + index, '\0') == expected.get_or(index, '\0'):
				index += 1
			else:
				matches = False

		matches


private pure func line_ends_after_optional_space_at(
	source: SourceFile,
	cursor: Cursor,
	offset: Int,
) -> Bool:
	var i: Int = offset
	var ok: Bool = False

	while True:
		match source.text.get(cursor.offset + i):
			Some(' '):
				i += 1
			Some('\t'):
				i += 1
			Some('\n'):
				ok = True
				break
			None:
				ok = True
				break
			_:
				break

	ok


private pure func starts_docstring_at(source: SourceFile, cursor: Cursor) -> Bool:
	text_starts_with(source, cursor, "---") and line_ends_after_optional_space_at(source, cursor, 3)


---
Whether the cursor sits on the word `raw` used as a literal introducer rather
than as the start of a longer identifier. Both raw string and raw pipe forms
begin this way; which one it is, the rare-literal scanner decides.
---
private pure func starts_raw_word_at(source: SourceFile, cursor: Cursor) -> Bool:
	if not text_starts_with(source, cursor, "raw"):
		False
	else:
		match source.text.get(cursor.offset + 3):
			Some(c):
				not is_ident_continue(c)
			None:
				True


private pure func spaces_end_cursor(source: SourceFile, cursor: Cursor) -> Cursor:
	text: String = source.text
	var offset: Int = cursor.offset
	var column: Int = cursor.column

	while True:
		match text.get(offset):
			Some(' '):
				column += 1
				offset += 1
			Some('\t'):
				column += tab_advance(column)
				offset += 1
			_:
				break

	{
		offset = offset,
		line = cursor.line,
		column = column
	}


private pure func line_comment_end_cursor(source: SourceFile, cursor: Cursor) -> Cursor:
	text: String = source.text
	var offset: Int = cursor.offset + 2
	var column: Int = cursor.column + 2

	while True:
		match text.get(offset):
			Some('\n'):
				break
			Some('\t'):
				column += tab_advance(column)
				offset += 1
			Some(_):
				column += 1
				offset += 1
			None:
				break

	{
		offset = offset,
		line = cursor.line,
		column = column
	}


private pure func number_scan(source: SourceFile, cursor: Cursor) -> NumberScan:
	text: String = source.text
	var offset: Int = cursor.offset
	var saw_dot: Bool = False

	while True:
		match text.get(offset):
			Some(c):
				if is_digit_char(c):
					offset += 1
				else if c == '.' and not saw_dot:
					match text.get(offset + 1):
						Some(next):
							if is_digit_char(next):
								saw_dot = True
								offset += 1
							else:
								break
						None:
							break
				else:
					break
			None:
				break

	{
		end_offset = offset,
		saw_dot = saw_dot
	}


---
Classify the symbol at the cursor, returning only the symbol and how many
characters it spans. `None` means the character starts no symbol, which the
builder reports as an unexpected character.
---
private pure func symbol_at(source: SourceFile, cursor: Cursor) -> Option[SymbolMatch]:
	text: String = source.text
	next: Option[Char] = text.get(cursor.offset + 1)

	match text.get(cursor.offset):
		Some('-'):
			if next == Some('>'):
				Some({
					symbol = ArrowSymbol,
					width = 2,
				})
			else if next == Some('='):
				Some({
					symbol = MinusEqualSymbol,
					width = 2,
				})
			else:
				Some({
					symbol = MinusSymbol,
					width = 1,
				})
		Some('='):
			if next == Some('>'):
				Some({
					symbol = FatArrowSymbol,
					width = 2,
				})
			else if next == Some('='):
				Some({
					symbol = EqualEqualSymbol,
					width = 2,
				})
			else:
				Some({
					symbol = EqualSymbol,
					width = 1,
				})
		Some('<'):
			if next == Some('='):
				Some({
					symbol = LessEqualSymbol,
					width = 2,
				})
			else:
				Some({
					symbol = LessSymbol,
					width = 1,
				})
		Some('>'):
			if next == Some('='):
				Some({
					symbol = GreaterEqualSymbol,
					width = 2,
				})
			else:
				Some({
					symbol = GreaterSymbol,
					width = 1,
				})
		Some('!'):
			if next == Some('='):
				Some({
					symbol = NotEqualSymbol,
					width = 2,
				})
			else:
				None
		Some('?'):
			if next == Some('='):
				Some({
					symbol = QuestionEqualsSymbol,
					width = 2,
				})
			else:
				None
		Some('.'):
			if next == Some('.') and text.get(cursor.offset + 2) == Some('.'):
				Some({
					symbol = DotDotDotSymbol,
					width = 3,
				})
			else if next == Some('.'):
				Some({
					symbol = DotDotSymbol,
					width = 2,
				})
			else:
				Some({
					symbol = DotSymbol,
					width = 1,
				})
		Some('+'):
			if next == Some('='):
				Some({
					symbol = PlusEqualSymbol,
					width = 2,
				})
			else:
				Some({
					symbol = PlusSymbol,
					width = 1,
				})
		Some('*'):
			if next == Some('='):
				Some({
					symbol = StarEqualSymbol,
					width = 2,
				})
			else:
				Some({
					symbol = StarSymbol,
					width = 1,
				})
		Some('/'):
			if next == Some('='):
				Some({
					symbol = SlashEqualSymbol,
					width = 2,
				})
			else:
				Some({
					symbol = SlashSymbol,
					width = 1,
				})
		Some('('):
			Some({
				symbol = LeftParenSymbol,
				width = 1,
			})
		Some(')'):
			Some({
				symbol = RightParenSymbol,
				width = 1,
			})
		Some('['):
			Some({
				symbol = LeftBracketSymbol,
				width = 1,
			})
		Some(']'):
			Some({
				symbol = RightBracketSymbol,
				width = 1,
			})
		Some('{'):
			Some({
				symbol = LeftBraceSymbol,
				width = 1,
			})
		Some('}'):
			Some({
				symbol = RightBraceSymbol,
				width = 1,
			})
		Some(':'):
			Some({
				symbol = ColonSymbol,
				width = 1,
			})
		Some(','):
			Some({
				symbol = CommaSymbol,
				width = 1,
			})
		Some('_'):
			Some({
				symbol = UnderscoreSymbol,
				width = 1,
			})
		Some('%'):
			Some({
				symbol = PercentSymbol,
				width = 1,
			})
		Some('#'):
			Some({
				symbol = HashSymbol,
				width = 1,
			})
		Some('@'):
			Some({
				symbol = AtSymbol,
				width = 1,
			})
		Some('|'):
			Some({
				symbol = PipeSymbol,
				width = 1,
			})
		_:
			None


---
Assemble the `LexerState` the rare literal scanners still expect. Only the
string, char, docstring and pipe-block forms need it; the builder below scans
every other token without building a state record at all.
---
private pure func literal_scan_state(
	source: SourceFile,
	cursor: Cursor,
	diagnostics: List[ParseDiagnostic],
	pending_trivia: List[Trivia],
	indent_stack: List[Int],
	lambda_body_levels: List[LambdaBodyLevel],
	group_depth: Int,
	pending_newline: Bool,
	at_line_start: Bool,
	line_has_token: Bool,
	last_token_kind: Option[TokenKind],
) -> LexerState:
	{
		source = source,
		cursor = cursor,
		diagnostics = diagnostics,
		pending_trivia = pending_trivia,
		indent_stack = indent_stack,
		lambda_body_levels = lambda_body_levels,
		group_depth = group_depth,
		pending_newline = pending_newline,
		at_line_start = at_line_start,
		line_has_token = line_has_token,
		last_token_kind = last_token_kind,
		emitted_token = None,
		emitted_trivia = None
	}


private pure func scan_literal_form(state: LexerState) -> LexerState:
	match peek(state):
		Some('-'):
			scan_docstring(state)
		Some('\"'):
			scan_string_literal(state)
		Some('\''):
			scan_char_literal(state)
		Some('|'):
			scan_pipe_block(state, state.cursor, state.cursor.column, False)
		Some('r'):
			if starts_with(state, "raw\""):
				scan_raw_string_literal(state)
			else:
				match raw_pipe_start_after_raw(state):
					Some((margin_column, marker_state)):
						scan_pipe_block(marker_state, state.cursor, margin_column, True)
					None:
						scan_identifier(state)
		_:
			stepped_state(state)


---
Lex a source file.

This is a builder: every accumulator is a local `var` that the loop mutates in
place, and the immutable token and diagnostic lists are published once at the
end. The scanners it calls return only what they found -- an end cursor, a
symbol, a token kind -- so scanning a token builds no state record. Only the
rare literal forms still thread `LexerState`, through `scan_literal_form`.
---
pure func lex(source: SourceFile) -> LexResult:
	text: String = source.text
	var cursor: Cursor = source_start(source)
	var tokens: List[Token] = list(text.length() / 4 + 16)
	var diagnostics: List[ParseDiagnostic] = []
	var pending_trivia: List[Trivia] = []
	var indent_stack: List[Int] = [0]
	var lambda_body_levels: List[LambdaBodyLevel] = []
	var group_depth: Int = 0
	var pending_newline: Bool = False
	var at_line_start: Bool = True
	var line_has_token: Bool = False
	var last_token_kind: Option[TokenKind] = None
	var scanning: Bool = True

	while scanning:
		if at_line_start:
			line_start_cursor: Cursor = cursor
			var indent: Int = 0

			while True:
				match text.get(cursor.offset):
					Some(' '):
						indent += 1
						cursor = source_advance(source, cursor)
					Some('\t'):
						indent += tab_advance(indent + 1)
						cursor = source_advance(source, cursor)
					_:
						break

			if (
				group_depth > 0
				and ((
					not in_lambda_body_at(lambda_body_levels, group_depth)
					or in_nested_group_in_lambda_at(lambda_body_levels, group_depth)
				))
			):
				pending_newline = False
				at_line_start = False
			else:
				match text.get(cursor.offset):
					Some('\n'):
						void
					None:
						void
					Some(_):
						current_column: Int = top_indent(indent_stack)
						var dedent_target: Int = -1

						match lambda_body_close_indent_at(
							lambda_body_levels,
							group_depth,
							indent_stack,
							indent,
						):
							Some(base_indent):
								dedent_target = base_indent
							None:
								if indent > current_column:
									if pending_newline:
										tokens = tokens.append(
											token(
												NewlineToken,
												source_empty_span(source, cursor),
											),
										)
										last_token_kind = Some(NewlineToken)
										pending_newline = False

									indent_stack = [indent].concat(indent_stack)
									tokens = tokens.append(
										token(
											IndentToken,
											source_span(source, line_start_cursor, cursor),
										),
									)
									last_token_kind = Some(IndentToken)
								else if indent == current_column:
									if pending_newline:
										tokens = tokens.append(
											token(
												NewlineToken,
												source_empty_span(source, cursor),
											),
										)
										last_token_kind = Some(NewlineToken)
										pending_newline = False
								else:
									dedent_target = indent

						if dedent_target >= 0:
							pending_newline = False

							while top_indent(indent_stack) > dedent_target:
								tokens = tokens.append(
									token(
										DedentToken,
										source_empty_span(source, cursor),
									),
								)
								last_token_kind = Some(DedentToken)
								indent_stack = indent_stack.tail()

							if top_indent(indent_stack) != dedent_target:
								diagnostics = diagnostics.append(
									parse_error(
										source_empty_span(source, cursor),
										"inconsistent indentation",
									),
								)
							else:
								lambda_body_levels = pruned_lambda_body_levels(
									lambda_body_levels,
									indent_stack,
								)

						at_line_start = False

		match text.get(cursor.offset):
			None:
				scanning = False
			Some(c):
				if c == '\n':
					entering: Bool = can_enter_lambda_body_at(
						lambda_body_levels,
						group_depth,
						last_token_kind,
					)

					if entering:
						level: LambdaBodyLevel = {
							group_depth = group_depth,
							base_indent = top_indent(indent_stack)
						}
						lambda_body_levels = [level].concat(lambda_body_levels)
						pending_newline = True
					else if (
						group_depth > 0
						and ((
							not in_lambda_body_at(lambda_body_levels, group_depth)
							or in_nested_group_in_lambda_at(lambda_body_levels, group_depth)
						))
					):
						pending_newline = False
					else:
						pending_newline = pending_newline or line_has_token

					cursor = source_advance(source, cursor)
					at_line_start = True
					line_has_token = False
				else if is_space(c):
					cursor = spaces_end_cursor(source, cursor)
				else if (
					c == '\"'
					or c == '\''
					or c == '-' and starts_docstring_at(source, cursor)
					or c == 'r' and starts_raw_word_at(source, cursor)
					or c == '|' and not line_has_token
				):
					scanned: LexerState = scan_literal_form(
						literal_scan_state(
							source,
							cursor,
							diagnostics,
							pending_trivia,
							indent_stack,
							lambda_body_levels,
							group_depth,
							pending_newline,
							at_line_start,
							line_has_token,
							last_token_kind,
						),
					)
					cursor = scanned.cursor
					diagnostics = scanned.diagnostics
					pending_trivia = scanned.pending_trivia
					indent_stack = scanned.indent_stack
					lambda_body_levels = scanned.lambda_body_levels
					group_depth = scanned.group_depth
					pending_newline = scanned.pending_newline
					at_line_start = scanned.at_line_start
					line_has_token = scanned.line_has_token
					last_token_kind = scanned.last_token_kind

					match scanned.emitted_token:
						Some(emitted):
							tokens = tokens.append(emitted)
						None:
							match scanned.emitted_trivia:
								Some(found):
									tokens = add_trailing_trivia(tokens, found)
								None:
									void
				else if c == '-' and text_starts_with(source, cursor, "--"):
					comment_end: Cursor = line_comment_end_cursor(source, cursor)
					comment_span: SourceSpan = source_span(source, cursor, comment_end)
					comment: Trivia = trivia(
						CommentTrivia,
						source_span_text(source, comment_span),
						comment_span,
					)
					cursor = comment_end

					if line_has_token:
						tokens = add_trailing_trivia(tokens, comment)
					else:
						pending_trivia = pending_trivia.append(comment)
				else if (
					c == '_'
					and not text
						.get(cursor.offset + 1)
						.map(is_ident_continue)
						.get_or(False)
				):
					span: SourceSpan = source_span(
						source,
						cursor,
						source_advance(source, cursor),
					)
					kind: TokenKind = SymbolToken(UnderscoreSymbol)
					tokens = tokens.append(token_with_trivia(kind, span, pending_trivia, []))
					pending_trivia = []
					line_has_token = True
					last_token_kind = Some(kind)
					cursor = source_advance(source, cursor)
				else if is_ident_start(c):
					end_cursor: Cursor = identifier_end_cursor(source, cursor)
					span: SourceSpan = source_span(source, cursor, end_cursor)
					word: String = source_span_text(source, span)

					kind: TokenKind = match keyword_for(word):
						Some(keyword):
							KeywordToken(keyword)
						None:
							IdentifierToken(word)

					tokens = tokens.append(token_with_trivia(kind, span, pending_trivia, []))
					pending_trivia = []
					line_has_token = True
					last_token_kind = Some(kind)
					cursor = end_cursor
				else if is_digit_char(c):
					scan: NumberScan = number_scan(source, cursor)
					end_cursor: Cursor = {
						offset = scan.end_offset,
						line = cursor.line,
						column = cursor.column + scan.end_offset - cursor.offset
					}
					span: SourceSpan = source_span(source, cursor, end_cursor)
					digits: String = source_span_text(source, span)

					if not scan.saw_dot and not decimal_literal_leq(digits, INT128_MAX_DECIMAL):
						diagnostics = diagnostics.append(
							parse_error(
								span,
								"Integer literal '" + digits + "' exceeds Int128 range",
							),
						)

					kind: TokenKind = if scan.saw_dot:
						FloatLiteralToken(digits)
					else:
						IntLiteralToken(digits)

					tokens = tokens.append(token_with_trivia(kind, span, pending_trivia, []))
					pending_trivia = []
					line_has_token = True
					last_token_kind = Some(kind)
					cursor = end_cursor
				else:
					match symbol_at(source, cursor):
						Some(found):
							end_cursor: Cursor = cursor_advanced(source, cursor, found.width)
							span: SourceSpan = source_span(source, cursor, end_cursor)
							kind: TokenKind = SymbolToken(found.symbol)
							tokens = tokens.append(
								token_with_trivia(
									kind,
									span,
									pending_trivia,
									[],
								),
							)
							pending_trivia = []
							line_has_token = True
							last_token_kind = Some(kind)
							group_depth = group_depth_after_symbol(group_depth, found.symbol)
							cursor = end_cursor
						None:
							diagnostics = diagnostics.append(
								parse_error(
									source_empty_span(source, cursor),
									"unexpected character '" + c.to_string() + "'",
								),
							)
							cursor = source_advance(source, cursor)

	while top_indent(indent_stack) > 0:
		tokens = tokens.append(token(DedentToken, source_empty_span(source, cursor)))
		indent_stack = indent_stack.tail()

	if top_indent(indent_stack) != 0:
		diagnostics = diagnostics.append(
			parse_error(
				source_empty_span(source, cursor),
				"inconsistent indentation",
			),
		)

	tokens = tokens.append(
		token_with_trivia(
			EndOfFileToken,
			source_empty_span(source, cursor),
			pending_trivia,
			[],
		),
	)

	{
		tokens = tokens,
		diagnostics = diagnostics
	}
