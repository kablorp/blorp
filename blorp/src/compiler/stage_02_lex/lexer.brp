import:
	../../lib/source:
		Cursor,
		SourceFile,
		SourceSpan,
		source_advance,
		source_empty_span,
		source_peek,
		source_span,
		source_span_text,
		source_start,
	list: list
	parse_diagnostic: ParseDiagnostic, parse_error
	string: string
	token:
		Keyword(
			AfterKeyword,
			AliasKeyword,
			AndKeyword,
			AsKeyword,
			BreakKeyword,
			BuiltinKeyword,
			ConcurrentKeyword,
			ConcurrentlyKeyword,
			ContinueKeyword,
			DebugKeyword,
			DetachKeyword,
			ElseKeyword,
			EnumKeyword,
			FalseKeyword,
			ForKeyword,
			ForeignKeyword,
			FromKeyword,
			FromOpaqueKeyword,
			FuncKeyword,
			IfKeyword,
			ImplementsKeyword,
			ImportKeyword,
			InKeyword,
			IntoOpaqueKeyword,
			MatchKeyword,
			NotKeyword,
			OnKeyword,
			OpaqueKeyword,
			OrKeyword,
			PrivateKeyword,
			PureKeyword,
			RecordKeyword,
			ResourceKeyword,
			SealedKeyword,
			SelectKeyword,
			SelfKeyword,
			StructKeyword,
			TraitKeyword,
			TryKeyword,
			TrueKeyword,
			TypeKeyword,
			UnionKeyword,
			VarKeyword,
			VoidKeyword,
			WhereKeyword,
			WhileKeyword,
			WithKeyword,
		),
		StringLiteralKind(
			InterpolatedPipeStringLiteral,
			InterpolatedStringLiteral,
			NormalStringLiteral,
			PipeStringLiteral,
			RawPipeStringLiteral,
			RawStringLiteral,
		),
		Symbol(
			AtSymbol,
			ArrowSymbol,
			ColonSymbol,
			CommaSymbol,
			DotSymbol,
			DotDotDotSymbol,
			DotDotSymbol,
			EqualEqualSymbol,
			EqualSymbol,
			FatArrowSymbol,
			GreaterEqualSymbol,
			GreaterSymbol,
			HashSymbol,
			LeftBraceSymbol,
			LeftBracketSymbol,
			LeftParenSymbol,
			LessEqualSymbol,
			LessSymbol,
			MinusEqualSymbol,
			MinusSymbol,
			NotEqualSymbol,
			PercentSymbol,
			PipeSymbol,
			PlusEqualSymbol,
			PlusSymbol,
			QuestionEqualsSymbol,
			RightBraceSymbol,
			RightBracketSymbol,
			RightParenSymbol,
			SlashEqualSymbol,
			SlashSymbol,
			StarEqualSymbol,
			StarSymbol,
			UnderscoreSymbol,
		),
		Token,
		TokenKind(
			CharLiteralToken,
			DedentToken,
			DocStringToken,
			EndOfFileToken,
			FloatLiteralToken,
			IdentifierToken,
			IndentToken,
			IntLiteralToken,
			KeywordToken,
			NewlineToken,
			StringLiteralToken,
			SymbolToken,
		),
		Trivia,
		TriviaKind(CommentTrivia),
		token,
		token_with_trivia,
		trivia,


private TAB_WIDTH: Int = 4

private MAX_INTERPOLATION_DEPTH: Int = 64

private INT128_MAX_DECIMAL: String = "170141183460469231731687303715884105727"


record LexResult {
	tokens: List[Token],
	diagnostics: List[ParseDiagnostic]
}


private struct LambdaBodyLevel {
	group_depth: Int,
	base_indent: Int
}


private record LexerState {
	source: SourceFile,
	cursor: Cursor,
	diagnostics: List[ParseDiagnostic],
	pending_trivia: List[Trivia],
	indent_stack: List[Int],
	lambda_body_levels: List[LambdaBodyLevel],
	group_depth: Int,
	pending_newline: Bool,
	at_line_start: Bool,
	line_has_token: Bool,
	last_token_kind: Option[TokenKind]
}


private union LexerStep:
	LexerStateStep(LexerState)
	LexerTokenStep(LexerState, Token)
	LexerTrailingTriviaStep(LexerState, Trivia)


pure func lex_ok(result: LexResult) -> Bool:
	result.diagnostics.is_empty()


private pure func initial_state(source: SourceFile) -> LexerState:
	{
		source = source,
		cursor = source_start(source),
		diagnostics = [],
		pending_trivia = [],
		indent_stack = [0],
		lambda_body_levels = [],
		group_depth = 0,
		pending_newline = False,
		at_line_start = True,
		line_has_token = False,
		last_token_kind = None
	}


private pure func current_indent(state: LexerState) -> Int:
	state.indent_stack.get_or(0, 0)


private pure func current_lambda_body_level(state: LexerState) -> Option[LambdaBodyLevel]:
	state.lambda_body_levels.get(0)


private pure func in_lambda_body(state: LexerState) -> Bool:
	match current_lambda_body_level(state):
		Some(level):
			state.group_depth >= level.group_depth
		None:
			False


private pure func in_nested_group_in_lambda(state: LexerState) -> Bool:
	match current_lambda_body_level(state):
		Some(level):
			state.group_depth > level.group_depth
		None:
			False


private pure func last_token_is_colon(state: LexerState) -> Bool:
	match state.last_token_kind:
		Some(SymbolToken(ColonSymbol)):
			True
		_:
			False


private pure func can_enter_lambda_body(state: LexerState) -> Bool:
	state.group_depth > 0 and last_token_is_colon(state) and match current_lambda_body_level(state):
		Some(level):
			state.group_depth > level.group_depth
		None:
			True


private pure func enter_lambda_body(state: LexerState) -> LexerState:
	level: LambdaBodyLevel = {
		group_depth = state.group_depth,
		base_indent = current_indent(state)
	}
	{ state | lambda_body_levels = [level].concat(state.lambda_body_levels) }


private pure func is_digit_char(c: Char) -> Bool:
	c >= '0' and c <= '9'


private pure func is_ident_start(c: Char) -> Bool:
	c >= 'a' and c <= 'z' or c >= 'A' and c <= 'Z' or c == '_'


private pure func is_ident_continue(c: Char) -> Bool:
	is_ident_start(c) or is_digit_char(c)


private pure func is_space(c: Char) -> Bool:
	c == ' ' or c == '\t'


private pure func hex_value(c: Char) -> Int:
	if c >= '0' and c <= '9':
		to_int(c) - to_int('0')
	else if c >= 'a' and c <= 'f':
		10 + to_int(c) - to_int('a')
	else if c >= 'A' and c <= 'F':
		10 + to_int(c) - to_int('A')
	else:
		0


private pure func tab_advance(column: Int) -> Int:
	TAB_WIDTH - (column - 1) % TAB_WIDTH


private pure func advance(state: LexerState) -> LexerState:
	{ state | cursor = source_advance(state.source, state.cursor) }


private pure func peek(state: LexerState) -> Option[Char]:
	source_peek(state.source, state.cursor)


private pure func peek_next(state: LexerState) -> Option[Char]:
	next_cursor: Cursor = source_advance(state.source, state.cursor)
	source_peek(state.source, next_cursor)


private pure func peek_at(state: LexerState, offset: Int) -> Option[Char]:
	state.source.text.get(state.cursor.offset + offset)


private pure func span_from(
	state: LexerState,
	start_cursor: Cursor,
	end_cursor: Cursor,
) -> SourceSpan:
	source_span(state.source, start_cursor, end_cursor)


private pure func empty_span(state: LexerState) -> SourceSpan:
	source_empty_span(state.source, state.cursor)


private pure func add_error(state: LexerState, message: String) -> LexerState:
	diag: ParseDiagnostic = parse_error(empty_span(state), message)
	{ state | diagnostics = state.diagnostics.append(diag) }


private pure func add_error_at_span(
	state: LexerState,
	span: SourceSpan,
	message: String,
) -> LexerState:
	diag: ParseDiagnostic = parse_error(span, message)
	{ state | diagnostics = state.diagnostics.append(diag) }


private pure func kind_counts_as_line_token(kind: TokenKind) -> Bool:
	match kind:
		NewlineToken:
			False
		IndentToken:
			False
		DedentToken:
			False
		EndOfFileToken:
			False
		_:
			True


private pure func emit_token(state: LexerState, kind: TokenKind, span: SourceSpan) -> LexerStep:
	emitted: Token = token_with_trivia(kind, span, state.pending_trivia, [])
	LexerTokenStep(
		{ state |
			pending_trivia = [],
			line_has_token = state.line_has_token or kind_counts_as_line_token(kind),
			last_token_kind = Some(kind)
		},
		emitted,
	)


private pure func emit_structural_token(
	state: LexerState,
	tokens: List[Token],
	kind: TokenKind,
	span: SourceSpan,
) -> (LexerState, List[Token]):
	({ state | last_token_kind = Some(kind) }, tokens.append(token(kind, span)))


private pure func add_trailing_trivia(tokens: List[Token], trivia: Trivia) -> List[Token]:
	last: Int = tokens.length() - 1

	match tokens.get(last):
		Some(token):
			tokens.set(last, { token | trailing_trivia = token.trailing_trivia.append(trivia) })
		None:
			tokens


private pure func append_trivia(state: LexerState, trivia: Trivia) -> LexerStep:
	if state.line_has_token:
		LexerTrailingTriviaStep(state, trivia)
	else:
		LexerStateStep({ state | pending_trivia = state.pending_trivia.append(trivia) })


private pure func starts_with(state: LexerState, expected: String) -> Bool:
	expected_len: Int = expected.length()

	if state.cursor.offset + expected_len > state.source.text.length():
		False
	else:
		var index: Int = 0
		var matches: Bool = True

		while matches and index < expected_len:
			if state.source.text.get_or(
				state.cursor.offset + index,
				'\0',
			) == expected.get_or(index, '\0'):
				index += 1
			else:
				matches = False

		matches


private pure func advance_n(state: LexerState, width: Int) -> LexerState:
	var st: LexerState = state
	var remaining: Int = width

	while remaining > 0:
		st = advance(st)
		remaining -= 1

	st


private pure func line_ends_after_optional_space(state: LexerState, offset: Int) -> Bool:
	var i: Int = offset
	var ok: Bool = False

	while True:
		match peek_at(state, i):
			Some(' '):
				i += 1
			Some('\t'):
				i += 1
			Some('\n'):
				ok = True
				break
			None:
				ok = True
				break
			_:
				break

	ok


private pure func starts_docstring_delimiter(state: LexerState) -> Bool:
	starts_with(state, "---") and line_ends_after_optional_space(state, 3)


private pure func consume_line(state: LexerState) -> LexerState:
	var st: LexerState = state

	while True:
		match peek(st):
			Some('\n'):
				st = advance(st)
				break
			Some(_):
				st = advance(st)
			None:
				break

	st


private pure func read_line_text(state: LexerState) -> (String, LexerState):
	var st: LexerState = state
	start_cursor: Cursor = st.cursor
	var text: String = ""

	while True:
		match peek(st):
			Some('\n'):
				line_span: SourceSpan = span_from(st, start_cursor, st.cursor)
				text = source_span_text(st.source, line_span)
				st = advance(st)
				break
			Some(_):
				st = advance(st)
			None:
				line_span: SourceSpan = span_from(st, start_cursor, st.cursor)
				text = source_span_text(st.source, line_span)
				break

	(text, st)


private pure func skip_line_spaces_with_indent(state: LexerState) -> (Int, LexerState):
	var st: LexerState = state
	var indent: Int = 0

	while True:
		match peek(st):
			Some(' '):
				indent += 1
				st = advance(st)
			Some('\t'):
				indent += tab_advance(indent + 1)
				st = advance(st)
			_:
				break

	(indent, st)


private pure func pipe_marker_at_margin(
	state: LexerState,
	margin_column: Int,
) -> (Bool, LexerState):
	(indent, marker_state) = skip_line_spaces_with_indent(state)

	if indent == margin_column - 1:
		match peek(marker_state):
			Some('|'):
				(True, marker_state)
			_:
				(False, marker_state)
	else:
		(False, marker_state)


private pure func raw_pipe_start_marker(state: LexerState) -> (Bool, Int, LexerState):
	(indent, marker_state) = skip_line_spaces_with_indent(state)

	match peek(marker_state):
		Some('|'):
			(True, indent + 1, marker_state)
		_:
			(False, indent + 1, marker_state)


private pure func raw_pipe_start_after_raw(state: LexerState) -> Option[(Int, LexerState)]:
	if not starts_with(state, "raw"):
		None
	else:
		match peek_at(state, 3):
			Some(c):
				if is_ident_continue(c):
					None
				else:
					after_raw: LexerState = advance_n(state, 3)
					(_, after_spaces) = skip_line_spaces_with_indent(after_raw)

					match peek(after_spaces):
						Some('\n'):
							after_newline: LexerState = advance(after_spaces)
							(ok, margin_column, marker_state) = raw_pipe_start_marker(after_newline)

							if ok:
								Some((margin_column, marker_state))
							else:
								None
						_:
							None
			None:
				None


private pure func escape_char(c: Char) -> Option[Char]:
	match c:
		'n':
			Some('\n')
		't':
			Some('\t')
		'r':
			Some('\r')
		'\\':
			Some('\\')
		'\"':
			Some('\"')
		'\'':
			Some('\'')
		'0':
			Some(to_char(0))
		'{':
			Some('{')
		'}':
			Some('}')
		_:
			None


private pure func scan_unicode_escape(state: LexerState) -> (Option[Int], LexerState):
	var st: LexerState = advance_n(state, 3)
	var codepoint: Int = 0
	var digits: Int = 0
	var has_error: Bool = False

	while not has_error:
		match peek(st):
			Some('}'):
				break
			Some(c):
				if (
					is_digit_char(c)
					or c >= 'a' and c <= 'f'
					or c >= 'A' and c <= 'F'
				):
					digits += 1

					if digits > 6:
						has_error = True
						st = add_error(st, "Unicode escape \\u{} must contain 1-6 hex digits")
					else:
						codepoint = codepoint * 16 + hex_value(c)
						st = advance(st)
				else:
					has_error = True
					st = add_error(st, "Unicode escape \\u{} must contain only hex digits")
			None:
				has_error = True
				st = add_error(st, "unterminated Unicode escape")

	if has_error:
		(None, st)
	else if digits == 0:
		(None, add_error(st, "Unicode escape \\u{} must contain 1-6 hex digits"))
	else:
		after_close: LexerState = advance(st)

		-- Unicode scalar values exclude UTF-16 surrogates and values above U+10FFFF.
		if codepoint > 1114111 or codepoint >= 55296 and codepoint <= 57343:
			(None, add_error(after_close, "Unicode codepoint is out of range or a surrogate"))
		else:
			(Some(codepoint), after_close)


private pure func append_source_segment(
	text: String,
	state: LexerState,
	start_cursor: Cursor,
	end_cursor: Cursor,
) -> String:
	if end_cursor.offset > start_cursor.offset:
		text + source_span_text(
			state.source,
			source_span(state.source, start_cursor, end_cursor),
		)
	else:
		text


private pure func consume_until_single_quote(state: LexerState) -> LexerState:
	var st: LexerState = state

	while True:
		match peek(st):
			Some('\''):
				st = advance(st)
				break
			Some('\n'):
				break
			Some(_):
				st = advance(st)
			None:
				break

	st


private pure func scan_spaces(state: LexerState) -> LexerState:
	var st: LexerState = state

	while True:
		match peek(st):
			Some(c):
				if is_space(c):
					st = advance(st)
				else:
					break
			None:
				break

	st


private pure func scan_line_comment(state: LexerState) -> LexerStep:
	start_cursor: Cursor = state.cursor
	var st: LexerState = advance(advance(state))

	while True:
		match peek(st):
			Some('\n'):
				break
			Some(_):
				st = advance(st)
			None:
				break

	comment_span: SourceSpan = span_from(st, start_cursor, st.cursor)
	trivia: Trivia = trivia(
		CommentTrivia,
		source_span_text(st.source, comment_span),
		comment_span,
	)
	append_trivia(st, trivia)


private pure func scan_docstring(state: LexerState) -> LexerStep:
	start_cursor: Cursor = state.cursor
	var st: LexerState = consume_line(state)
	var text: String = string(128)
	var first_line: Bool = True
	var has_error: Bool = False

	while not has_error:
		if starts_docstring_delimiter(st):
			st = consume_line(st)
			break
		else:
			match peek(st):
				None:
					has_error = True
					st = add_error(st, "Unterminated docstring: missing closing ---")
				Some(_):
					(line, next_state) = read_line_text(st)

					if first_line:
						text = line
						first_line = False
					else:
						text = text + "\n" + line

					st = next_state

	if has_error:
		LexerStateStep(st)
	else:
		span: SourceSpan = span_from(st, start_cursor, st.cursor)
		kind: TokenKind = DocStringToken(text)
		emitted: Token = token_with_trivia(kind, span, st.pending_trivia, [])
		LexerTokenStep(
			{ st |
				pending_trivia = [],
				pending_newline = False,
				at_line_start = True,
				line_has_token = False,
				last_token_kind = Some(kind)
			},
			emitted,
		)


private pure func scan_string_literal(state: LexerState) -> LexerStep:
	start_cursor: Cursor = state.cursor
	var st: LexerState = advance(state)
	var segment_start: Cursor = st.cursor
	var text: String = string(32)
	var has_error: Bool = False
	var is_interpolated: Bool = False

	while True:
		match peek(st):
			Some('\"'):
				text = append_source_segment(text, st, segment_start, st.cursor)
				st = advance(st)
				break
			Some('\n'):
				has_error = True
				st = add_error(
					st,
					"Unterminated string literal. Use aligned pipe strings for multiline text",
				)
				st = advance(st)
				break
			Some('\\'):
				text = append_source_segment(text, st, segment_start, st.cursor)

				if starts_with(st, "\\u{"):
					(codepoint, next_state) = scan_unicode_escape(st)
					st = next_state

					match codepoint:
						Some(value):
							text = text.append_char(to_char(value))
							segment_start = st.cursor
						None:
							has_error = True
				else:
					escape_start: LexerState = st
					st = advance(st)

					match peek(st):
						Some(escaped):
							match escape_char(escaped):
								Some(c):
									text = text.append_char(c)
									st = advance(st)
									segment_start = st.cursor
								None:
									has_error = True
									st = add_error(
										escape_start,
										"unknown escape sequence '\\" + escaped.to_string() + "'",
									)
									st = advance(st)
						None:
							has_error = True
							st = add_error(escape_start, "unterminated escape sequence")
							break
			Some('$'):
				if starts_with(st, "$" + "{"):
					text = append_source_segment(text, st, segment_start, st.cursor)
					is_interpolated = True
					st = advance_n(st, 2)
					break
				else:
					st = advance(st)
			Some(_):
				st = advance(st)
			None:
				has_error = True
				st = add_error(st, "Unterminated string literal: missing closing '\"'")
				break

	if has_error:
		LexerStateStep(st)
	else if is_interpolated:
		scan_interpolated_string_tail(st, start_cursor, text)
	else:
		span: SourceSpan = span_from(st, start_cursor, st.cursor)
		emit_token(
			st,
			StringLiteralToken(NormalStringLiteral, text),
			span,
		)


private pure func scan_raw_string_literal(state: LexerState) -> LexerStep:
	start_cursor: Cursor = state.cursor
	var st: LexerState = advance_n(state, 4)
	var text: String = string(32)
	var has_error: Bool = False

	while True:
		match peek(st):
			Some('\"'):
				st = advance(st)
				break
			Some('\n'):
				has_error = True
				st = add_error(st, "Raw string cannot span multiple lines")
				st = advance(st)
				break
			Some(c):
				text = text.append_char(c)
				st = advance(st)
			None:
				has_error = True
				st = add_error(st, "Unterminated raw string literal: missing closing '\"'")
				break

	if has_error:
		LexerStateStep(st)
	else:
		span: SourceSpan = span_from(st, start_cursor, st.cursor)
		emit_token(
			st,
			StringLiteralToken(RawStringLiteral, text),
			span,
		)


private pure func scan_interpolated_string_tail(
	state: LexerState,
	span_start: Cursor,
	prefix: String,
) -> LexerStep:
	var st: LexerState = state
	var text: String = prefix + "{"
	var brace_depth: Int = 1
	var in_string: Bool = False
	var has_error: Bool = False

	while not has_error:
		match peek(st):
			Some('\"'):
				if brace_depth > 0:
					text = text.append_char('\"')
					in_string = not in_string
					st = advance(st)
				else:
					st = advance(st)
					break
			Some('$'):
				if starts_with(st, "$" + "{"):
					if in_string:
						text = text + "$" + "{"
					else:
						text = text.append_char('{')
						brace_depth += 1

						if brace_depth > MAX_INTERPOLATION_DEPTH:
							has_error = True
							st = add_error(st, "string interpolation nested too deeply")

					if not has_error:
						st = advance_n(st, 2)
				else:
					text = text.append_char('$')
					st = advance(st)
			Some('{'):
				if in_string:
					text = text.append_char('{')
				else if brace_depth > 0:
					text = text.append_char('{')
					brace_depth += 1
				else:
					text += "\\{"

				st = advance(st)
			Some('}'):
				if in_string:
					text = text.append_char('}')
				else if brace_depth > 0:
					text = text.append_char('}')
					brace_depth -= 1
				else:
					text += "\\}"

				st = advance(st)
			Some('\\'):
				text = text.append_char('\\')
				st = advance(st)

				match peek(st):
					Some(escaped):
						text = text.append_char(escaped)
						st = advance(st)
					None:
						has_error = True
						st = add_error(st, "unterminated interpolated string")
			Some('\n'):
				has_error = True
				st = add_error(
					st,
					"Unterminated interpolated string. Use aligned pipe strings for multiline text",
				)
				st = advance(st)
			Some(c):
				text = text.append_char(c)
				st = advance(st)
			None:
				has_error = True
				st = add_error(st, "Unterminated interpolated string: missing closing '\"'")

	if has_error:
		LexerStateStep(st)
	else:
		span: SourceSpan = span_from(st, span_start, st.cursor)
		emit_token(
			st,
			StringLiteralToken(InterpolatedStringLiteral, text),
			span,
		)


private pure func read_pipe_line_content(
	state: LexerState,
	raw: Bool,
) -> (String, Bool, LexerState, Bool):
	var st: LexerState = state
	var text: String = string(64)
	var saw_interp: Bool = False
	var ended_with_newline: Bool = False

	while True:
		match peek(st):
			Some('\n'):
				st = advance(st)
				ended_with_newline = True
				break
			Some('$'):
				if not raw and starts_with(st, "$" + "{"):
					text = text.append_char('{')
					saw_interp = True
					st = advance_n(st, 2)
				else:
					text = text.append_char('$')
					st = advance(st)
			Some(c):
				text = text.append_char(c)
				st = advance(st)
			None:
				break

	(text, saw_interp, st, ended_with_newline)


private pure func scan_pipe_block(
	state: LexerState,
	span_start: Cursor,
	margin_column: Int,
	raw: Bool,
) -> LexerStep:
	var st: LexerState = state
	var text: String = string(128)
	var saw_interp: Bool = False
	var first_line: Bool = True
	var ended_with_newline: Bool = False
	var has_error: Bool = False

	while not has_error:
		if not first_line:
			text = text.append_char('\n')

		if not raw and starts_with(st, "||"):
			text = text.append_char('|')
			st = advance_n(st, 2)
		else:
			match peek(st):
				Some('|'):
					st = advance(st)
				_:
					has_error = True
					st = add_error(
						st,
						"Expected aligned pipe string marker at column " + margin_column.to_string(),
					)

		if not has_error:
			line_result: (String, Bool, LexerState, Bool) = read_pipe_line_content(st, raw)
			line_text: String = line_result[0]
			line_saw_interp: Bool = line_result[1]
			next_state: LexerState = line_result[2]
			line_ended_with_newline: Bool = line_result[3]
			text += line_text
			saw_interp = saw_interp or line_saw_interp
			st = next_state
			ended_with_newline = line_ended_with_newline

			if ended_with_newline:
				(continues, marker_state) = pipe_marker_at_margin(st, margin_column)

				if continues:
					st = marker_state
					first_line = False
				else:
					break
			else:
				break

	if has_error:
		LexerStateStep(st)
	else:
		span: SourceSpan = span_from(st, span_start, st.cursor)

		var string_kind: StringLiteralKind = PipeStringLiteral

		if raw:
			string_kind = RawPipeStringLiteral
		else if saw_interp:
			string_kind = InterpolatedPipeStringLiteral

		kind: TokenKind = StringLiteralToken(string_kind, text)
		emitted: Token = token_with_trivia(kind, span, st.pending_trivia, [])
		var next_state: LexerState = { st |
			pending_trivia = [],
			line_has_token = True,
			last_token_kind = Some(kind)
		}

		if ended_with_newline:
			next_state = { next_state |
				pending_newline = True,
				at_line_start = True,
				line_has_token = False
			}

		LexerTokenStep(next_state, emitted)


private pure func scan_char_literal(state: LexerState) -> LexerStep:
	start_cursor: Cursor = state.cursor
	var st: LexerState = advance(state)
	var codepoint: Int = 0
	var has_value: Bool = False
	var has_error: Bool = False

	match peek(st):
		Some('\\'):
			if starts_with(st, "\\u{"):
				(value, next_state) = scan_unicode_escape(st)
				st = next_state

				match value:
					Some(cp):
						codepoint = cp
						has_value = True
					None:
						has_error = True
			else:
				escape_start: LexerState = st
				st = advance(st)

				match peek(st):
					Some(escaped):
						match escape_char(escaped):
							Some(c):
								codepoint = to_int(c)
								has_value = True
								st = advance(st)
							None:
								has_error = True
								st = add_error(
									escape_start,
									"unknown escape sequence '\\" + escaped.to_string() + "'",
								)
								st = advance(st)
					None:
						has_error = True
						st = add_error(escape_start, "unterminated character literal")
		Some('\n'):
			has_error = True
			st = add_error(
				st,
				"Invalid character literal: expected single character between quotes",
			)
		Some(c):
			codepoint = to_int(c)
			has_value = True
			st = advance(st)
		None:
			has_error = True
			st = add_error(st, "unterminated character literal")

	if not has_error:
		match peek(st):
			Some('\''):
				st = advance(st)
			_:
				has_error = True
				st = add_error(
					st,
					"Invalid character literal: expected single character between quotes",
				)

	if has_error or not has_value:
		LexerStateStep(consume_until_single_quote(st))
	else:
		span: SourceSpan = span_from(st, start_cursor, st.cursor)
		emit_token(st, CharLiteralToken(codepoint), span)


private pure func identifier_end_cursor(source: SourceFile, start_cursor: Cursor) -> Cursor:
	var cursor: Cursor = start_cursor

	while True:
		match source_peek(source, cursor):
			Some(c):
				if is_ident_continue(c):
					cursor = source_advance(source, cursor)
				else:
					break
			None:
				break

	cursor


private pure func keyword_for(text: String) -> Option[Keyword]:
	match text:
		"func":
			Some(FuncKeyword)
		"pure":
			Some(PureKeyword)
		"var":
			Some(VarKeyword)
		"union":
			Some(UnionKeyword)
		"record":
			Some(RecordKeyword)
		"void":
			Some(VoidKeyword)
		"while":
			Some(WhileKeyword)
		"for":
			Some(ForKeyword)
		"in":
			Some(InKeyword)
		"if":
			Some(IfKeyword)
		"else":
			Some(ElseKeyword)
		"and":
			Some(AndKeyword)
		"or":
			Some(OrKeyword)
		"not":
			Some(NotKeyword)
		"on":
			Some(OnKeyword)
		"match":
			Some(MatchKeyword)
		"True":
			Some(TrueKeyword)
		"False":
			Some(FalseKeyword)
		"break":
			Some(BreakKeyword)
		"continue":
			Some(ContinueKeyword)
		"debug":
			Some(DebugKeyword)
		"struct":
			Some(StructKeyword)
		"enum":
			Some(EnumKeyword)
		"with":
			Some(WithKeyword)
		"resource":
			Some(ResourceKeyword)
		"foreign":
			Some(ForeignKeyword)
		"private":
			Some(PrivateKeyword)
		"builtin":
			Some(BuiltinKeyword)
		"concurrent":
			Some(ConcurrentKeyword)
		"concurrently":
			Some(ConcurrentlyKeyword)
		"detach":
			Some(DetachKeyword)
		"select":
			Some(SelectKeyword)
		"into_opaque":
			Some(IntoOpaqueKeyword)
		"from":
			Some(FromKeyword)
		"from_opaque":
			Some(FromOpaqueKeyword)
		"after":
			Some(AfterKeyword)
		"sealed":
			Some(SealedKeyword)
		"opaque":
			Some(OpaqueKeyword)
		"try":
			Some(TryKeyword)
		"import":
			Some(ImportKeyword)
		"as":
			Some(AsKeyword)
		"trait":
			Some(TraitKeyword)
		"implements":
			Some(ImplementsKeyword)
		"Self":
			Some(SelfKeyword)
		"type":
			Some(TypeKeyword)
		"alias":
			Some(AliasKeyword)
		"where":
			Some(WhereKeyword)
		_:
			None


private pure func scan_identifier(state: LexerState) -> LexerStep:
	start_cursor: Cursor = state.cursor
	end_cursor: Cursor = identifier_end_cursor(state.source, start_cursor)
	span: SourceSpan = span_from(state, start_cursor, end_cursor)
	text: String = source_span_text(state.source, span)

	match keyword_for(text):
		Some(keyword):
			emit_token({ state | cursor = end_cursor }, KeywordToken(keyword), span)
		None:
			emit_token({ state | cursor = end_cursor }, IdentifierToken(text), span)


private pure func first_significant_decimal_digit(text: String) -> Int:
	var index: Int = 0

	while index + 1 < text.length():
		if text.get_or(index, '0') == '0':
			index += 1
		else:
			break

	index


private pure func decimal_literal_leq(left: String, right: String) -> Bool:
	left_start: Int = first_significant_decimal_digit(left)
	right_start: Int = first_significant_decimal_digit(right)
	left_len: Int = left.length() - left_start
	right_len: Int = right.length() - right_start

	if left_len < right_len:
		True
	else if left_len > right_len:
		False
	else:
		var result: Bool = True
		var comparing: Bool = True
		var index: Int = 0

		while comparing and index < left_len:
			left_char: Char = left.get_or(left_start + index, '0')
			right_char: Char = right.get_or(right_start + index, '0')

			if left_char < right_char:
				comparing = False
				result = True
			else if left_char > right_char:
				comparing = False
				result = False
			else:
				index += 1

		result


private pure func scan_number(state: LexerState) -> LexerStep:
	start_cursor: Cursor = state.cursor
	var st: LexerState = state
	var saw_dot: Bool = False

	while True:
		match peek(st):
			Some(c):
				if is_digit_char(c):
					st = advance(st)
				else if c == '.' and not saw_dot:
					match peek_next(st):
						Some(next):
							if is_digit_char(next):
								saw_dot = True
								st = advance(st)
							else:
								break
						None:
							break
				else:
					break
			None:
				break

	span: SourceSpan = span_from(st, start_cursor, st.cursor)
	text: String = source_span_text(st.source, span)

	if saw_dot:
		emit_token(st, FloatLiteralToken(text), span)
	else if decimal_literal_leq(text, INT128_MAX_DECIMAL):
		emit_token(st, IntLiteralToken(text), span)
	else:
		emit_token(
			add_error_at_span(st, span, "Integer literal '" + text + "' exceeds Int128 range"),
			IntLiteralToken(text),
			span,
		)


private pure func group_depth_after_symbol(depth: Int, symbol: Symbol) -> Int:
	match symbol:
		LeftParenSymbol:
			depth + 1
		LeftBracketSymbol:
			depth + 1
		LeftBraceSymbol:
			depth + 1
		RightParenSymbol:
			if depth <= 0:
				0
			else:
				depth - 1
		RightBracketSymbol:
			if depth <= 0:
				0
			else:
				depth - 1
		RightBraceSymbol:
			if depth <= 0:
				0
			else:
				depth - 1
		_:
			depth


private pure func emit_symbol(state: LexerState, symbol: Symbol, width: Int) -> LexerStep:
	start_cursor: Cursor = state.cursor
	st: LexerState = advance_n(state, width)

	span: SourceSpan = span_from(st, start_cursor, st.cursor)
	emit_token(
		{ st | group_depth = group_depth_after_symbol(st.group_depth, symbol) },
		SymbolToken(symbol),
		span,
	)


private pure func scan_unexpected_character(state: LexerState, c: Char) -> LexerState:
	advance(add_error(state, "unexpected character '" + c.to_string() + "'"))


private pure func scan_symbol_or_error(state: LexerState) -> LexerStep:
	match peek(state):
		Some('-'):
			next = peek_next(state)

			if next == Some('>'):
				emit_symbol(state, ArrowSymbol, 2)
			else if next == Some('='):
				emit_symbol(state, MinusEqualSymbol, 2)
			else:
				emit_symbol(state, MinusSymbol, 1)
		Some('='):
			next = peek_next(state)

			if next == Some('>'):
				emit_symbol(state, FatArrowSymbol, 2)
			else if next == Some('='):
				emit_symbol(state, EqualEqualSymbol, 2)
			else:
				emit_symbol(state, EqualSymbol, 1)
		Some('<'):
			next = peek_next(state)

			if next == Some('='):
				emit_symbol(state, LessEqualSymbol, 2)
			else:
				emit_symbol(state, LessSymbol, 1)
		Some('>'):
			next = peek_next(state)

			if next == Some('='):
				emit_symbol(state, GreaterEqualSymbol, 2)
			else:
				emit_symbol(state, GreaterSymbol, 1)
		Some('!'):
			next = peek_next(state)

			if next == Some('='):
				emit_symbol(state, NotEqualSymbol, 2)
			else:
				LexerStateStep(scan_unexpected_character(state, '!'))
		Some('?'):
			next = peek_next(state)

			if next == Some('='):
				emit_symbol(state, QuestionEqualsSymbol, 2)
			else:
				LexerStateStep(scan_unexpected_character(state, '?'))
		Some('.'):
			next = peek_next(state)

			if next == Some('.') and peek_at(state, 2) == Some('.'):
				emit_symbol(state, DotDotDotSymbol, 3)
			else if next == Some('.'):
				emit_symbol(state, DotDotSymbol, 2)
			else:
				emit_symbol(state, DotSymbol, 1)
		Some('+'):
			next = peek_next(state)

			if next == Some('='):
				emit_symbol(state, PlusEqualSymbol, 2)
			else:
				emit_symbol(state, PlusSymbol, 1)
		Some('*'):
			next = peek_next(state)

			if next == Some('='):
				emit_symbol(state, StarEqualSymbol, 2)
			else:
				emit_symbol(state, StarSymbol, 1)
		Some('/'):
			next = peek_next(state)

			if next == Some('='):
				emit_symbol(state, SlashEqualSymbol, 2)
			else:
				emit_symbol(state, SlashSymbol, 1)
		Some('('):
			emit_symbol(state, LeftParenSymbol, 1)
		Some(')'):
			emit_symbol(state, RightParenSymbol, 1)
		Some('['):
			emit_symbol(state, LeftBracketSymbol, 1)
		Some(']'):
			emit_symbol(state, RightBracketSymbol, 1)
		Some('{'):
			emit_symbol(state, LeftBraceSymbol, 1)
		Some('}'):
			emit_symbol(state, RightBraceSymbol, 1)
		Some(':'):
			emit_symbol(state, ColonSymbol, 1)
		Some(','):
			emit_symbol(state, CommaSymbol, 1)
		Some('_'):
			emit_symbol(state, UnderscoreSymbol, 1)
		Some('%'):
			emit_symbol(state, PercentSymbol, 1)
		Some('#'):
			emit_symbol(state, HashSymbol, 1)
		Some('@'):
			emit_symbol(state, AtSymbol, 1)
		Some('|'):
			emit_symbol(state, PipeSymbol, 1)
		Some(';'):
			LexerStateStep(scan_unexpected_character(state, ';'))
		Some(c):
			LexerStateStep(scan_unexpected_character(state, c))
		None:
			LexerStateStep(state)


private pure func emit_pending_newline(
	state: LexerState,
	tokens: List[Token],
) -> (LexerState, List[Token]):
	if state.pending_newline:
		span: SourceSpan = empty_span(state)
		(with_token, with_tokens) = emit_structural_token(state, tokens, NewlineToken, span)
		({ with_token | pending_newline = False }, with_tokens)
	else:
		(state, tokens)


private pure func pop_lambda_body_level(state: LexerState) -> LexerState:
	var rest: List[LambdaBodyLevel] = []
	var i: Int = 1

	while i < state.lambda_body_levels.length():
		match state.lambda_body_levels.get(i):
			Some(level):
				rest = rest.append(level)
			None:
				void

		i += 1

	{ state | lambda_body_levels = rest }


private pure func prune_lambda_body_levels(state: LexerState) -> LexerState:
	var st: LexerState = state

	while True:
		match current_lambda_body_level(st):
			Some(level):
				if current_indent(st) <= level.base_indent:
					st = pop_lambda_body_level(st)
				else:
					break
			None:
				break

	st


private pure func dedent_would_be_inconsistent(state: LexerState, indent: Int) -> Bool:
	var i: Int = 0
	var inconsistent: Bool = False

	while i < state.indent_stack.length():
		match state.indent_stack.get(i):
			Some(level):
				if indent >= level:
					break
				else:
					next_level: Int = state.indent_stack.get_or(i + 1, 0)

					if indent > next_level:
						inconsistent = True
						break
					else:
						i += 1
			None:
				break

	inconsistent


private pure func lambda_body_close_indent(state: LexerState, indent: Int) -> Option[Int]:
	match current_lambda_body_level(state):
		Some(level):
			if (
				state.group_depth == level.group_depth
				and indent > level.base_indent
				and indent < current_indent(state)
				and dedent_would_be_inconsistent(state, indent)
			):
				Some(level.base_indent)
			else:
				None
		None:
			None


private pure func emit_indent_token(
	state: LexerState,
	tokens: List[Token],
	start_cursor: Cursor,
	indent: Int,
) -> (LexerState, List[Token]):
	(with_newline, with_tokens) = emit_pending_newline(state, tokens)
	span: SourceSpan = span_from(with_newline, start_cursor, with_newline.cursor)

	emit_structural_token(
		{ with_newline |
			indent_stack = [indent].concat(with_newline.indent_stack),
			at_line_start = False
		},
		with_tokens,
		IndentToken,
		span,
	)


private pure func emit_dedents_to(
	state: LexerState,
	tokens: List[Token],
	indent: Int,
) -> (LexerState, List[Token]):
	var st: LexerState = { state | pending_newline = False }
	var out_tokens: List[Token] = tokens

	while current_indent(st) > indent:
		span: SourceSpan = empty_span(st)

		(next_state, next_tokens) = emit_structural_token(
			{ st | indent_stack = st.indent_stack.tail() },
			out_tokens,
			DedentToken,
			span,
		)
		st = next_state
		out_tokens = next_tokens

	if current_indent(st) != indent:
		(add_error(st, "inconsistent indentation"), out_tokens)
	else:
		(prune_lambda_body_levels(st), out_tokens)


private pure func handle_line_start(
	state: LexerState,
	tokens: List[Token],
) -> (LexerState, List[Token]):
	if not state.at_line_start:
		(state, tokens)
	else:
		start_cursor: Cursor = state.cursor
		var st: LexerState = state
		var indent: Int = 0

		while True:
			match peek(st):
				Some(' '):
					indent += 1
					st = advance(st)
				Some('\t'):
					indent += tab_advance(indent + 1)
					st = advance(st)
				_:
					break

		if st.group_depth > 0 and (not in_lambda_body(st) or in_nested_group_in_lambda(st)):
			({ st |
					pending_newline = False,
					at_line_start = False
				}, tokens)
		else:
			match peek(st):
				Some('\n'):
					(st, tokens)
				Some(_):
					current: Int = current_indent(st)

					match lambda_body_close_indent(st, indent):
						Some(base_indent):
							(dedented, dedented_tokens) = emit_dedents_to(st, tokens, base_indent)
							({ dedented |
									pending_newline = False,
									at_line_start = False
								}, dedented_tokens)
						None:
							if indent > current:
								emit_indent_token(st, tokens, start_cursor, indent)
							else if indent == current:
								(with_newline, with_tokens) = emit_pending_newline(st, tokens)
								({ with_newline | at_line_start = False }, with_tokens)
							else:
								(dedented, dedented_tokens) = emit_dedents_to(st, tokens, indent)
								({ dedented | at_line_start = False }, dedented_tokens)
				None:
					(st, tokens)


private pure func scan_newline(state: LexerState) -> LexerState:
	if can_enter_lambda_body(state):
		{ enter_lambda_body(advance(state)) |
			pending_newline = True,
			at_line_start = True,
			line_has_token = False
		}
	else if (
		state.group_depth > 0
		and (not in_lambda_body(state) or in_nested_group_in_lambda(state))
	):
		{ advance(state) |
			pending_newline = False,
			at_line_start = True,
			line_has_token = False
		}
	else:
		{ advance(state) |
			pending_newline = state.pending_newline or state.line_has_token,
			at_line_start = True,
			line_has_token = False
		}


private pure func scan_one(state: LexerState) -> LexerStep:
	match peek(state):
		Some('\n'):
			LexerStateStep(scan_newline(state))
		Some(c):
			if is_space(c):
				LexerStateStep(scan_spaces(state))
			else if c == '-' and starts_docstring_delimiter(state):
				scan_docstring(state)
			else if c == '-' and starts_with(state, "--"):
				scan_line_comment(state)
			else if c == 'r' and starts_with(state, "raw\""):
				scan_raw_string_literal(state)
			else if c == 'r':
				match raw_pipe_start_after_raw(state):
					Some((margin_column, marker_state)):
						scan_pipe_block(marker_state, state.cursor, margin_column, True)
					None:
						scan_identifier(state)
			else if c == '\"':
				scan_string_literal(state)
			else if c == '\'':
				scan_char_literal(state)
			else if c == '|' and not state.line_has_token:
				scan_pipe_block(state, state.cursor, state.cursor.column, False)
			else if (
				c == '_'
				and not peek_next(state)
					.map(is_ident_continue)
					.get_or(False)
			):
				emit_symbol(state, UnderscoreSymbol, 1)
			else if is_ident_start(c):
				scan_identifier(state)
			else if is_digit_char(c):
				scan_number(state)
			else:
				scan_symbol_or_error(state)
		None:
			LexerStateStep(state)


private pure func finalize_lexer(state: LexerState) -> (LexerState, List[Token]):
	without_newline: LexerState = { state | pending_newline = False }
	emit_dedents_to(without_newline, [], 0)


pure func lex(source: SourceFile) -> LexResult:
	var state: LexerState = initial_state(source)
	var tokens: List[Token] = list(source.text.length() / 4 + 16)

	while True:
		if state.at_line_start:
			(line_state, line_tokens) = handle_line_start(state, [])
			state = line_state

			for line_token in line_tokens:
				tokens = tokens.append(line_token)

		match peek(state):
			Some(_):
				match scan_one(state):
					LexerStateStep(next_state):
						state = next_state
					LexerTokenStep(next_state, emitted):
						state = next_state
						tokens = tokens.append(emitted)
					LexerTrailingTriviaStep(next_state, trivia):
						state = next_state
						tokens = add_trailing_trivia(tokens, trivia)
			None:
				break

	(final_state, final_tokens) = finalize_lexer(state)

	for final_token in final_tokens:
		tokens = tokens.append(final_token)

	match emit_token(final_state, EndOfFileToken, empty_span(final_state)):
		LexerTokenStep(_, end_of_file):
			tokens = tokens.append(end_of_file)
		_:
			void

	{
		tokens = tokens,
		diagnostics = final_state.diagnostics
	}
