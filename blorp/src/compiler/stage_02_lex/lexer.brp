import:
	../../lib/source:
		Cursor,
		SourceFile,
		SourceSpan,
		source_advance,
		source_empty_span,
		source_peek,
		source_span,
		source_span_text,
		source_start,
	list: list
	parse_diagnostic: ParseDiagnostic, parse_error
	string: string
	token:
		Keyword(
			AfterKeyword,
			AliasKeyword,
			AndKeyword,
			AsKeyword,
