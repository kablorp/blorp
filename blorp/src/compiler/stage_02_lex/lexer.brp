private TAB_WIDTH: Int = 4

private MAX_INTERPOLATION_DEPTH: Int = 64

private INT128_MAX_DECIMAL: String = "170141183460469231731687303715884105727"


record LexResult {
	tokens: List[Token],
	diagnostics: List[ParseDiagnostic]
}


private struct LambdaBodyLevel {
	group_depth: Int,
	base_indent: Int
}


pure func lex_ok(result: LexResult) -> Bool:
	result.diagnostics.is_empty()


private pure func is_digit_char(c: Char) -> Bool:
	c >= '0' and c <= '9'


private pure func is_ident_start(c: Char) -> Bool:
	c >= 'a' and c <= 'z' or c >= 'A' and c <= 'Z' or c == '_'


private pure func is_ident_continue(c: Char) -> Bool:
	is_ident_start(c) or is_digit_char(c)


private pure func is_space(c: Char) -> Bool:
	c == ' ' or c == '\t'


private pure func hex_value(c: Char) -> Int:
	if c >= '0' and c <= '9':
		to_int(c) - to_int('0')
	else if c >= 'a' and c <= 'f':
		10 + to_int(c) - to_int('a')
	else if c >= 'A' and c <= 'F':
		10 + to_int(c) - to_int('A')
	else:
		0


private pure func tab_advance(column: Int) -> Int:
	TAB_WIDTH - (column - 1) % TAB_WIDTH


private record LiteralScan {
	end_cursor: Cursor,
	kind: Option[TokenKind],
	span: SourceSpan,
	diagnostics: List[ParseDiagnostic]
}


private record PipeBlockScan {
	end_cursor: Cursor,
	kind: Option[TokenKind],
	span: SourceSpan,
	diagnostics: List[ParseDiagnostic],
	ended_with_newline: Bool
}


private pure func add_trailing_trivia(tokens: List[Token], trivia: Trivia) -> List[Token]:
	last: Int = tokens.length() - 1

	match tokens.get(last):
		Some(token):
			tokens.set(last, { token | trailing_trivia = token.trailing_trivia.append(trivia) })
		None:
			tokens


private pure func cursor_advanced(source: SourceFile, cursor: Cursor, width: Int) -> Cursor:
	var moved: Cursor = cursor
	var remaining: Int = width

	while remaining > 0:
		moved = source_advance(source, moved)
		remaining -= 1

	moved


private pure func consume_line(source: SourceFile, cursor: Cursor) -> Cursor:
	var cur: Cursor = cursor

	while True:
		match source_peek(source, cur):
			Some('\n'):
				cur = source_advance(source, cur)
				break
			Some(_):
				cur = source_advance(source, cur)
			None:
				break

	cur


private pure func read_line_text(source: SourceFile, cursor: Cursor) -> (String, Cursor):
	var cur: Cursor = cursor
	start_cursor: Cursor = cur
	var text: String = ""

	while True:
		match source_peek(source, cur):
			Some('\n'):
				line_span: SourceSpan = source_span(source, start_cursor, cur)
				text = source_span_text(source, line_span)
				cur = source_advance(source, cur)
				break
			Some(_):
				cur = source_advance(source, cur)
			None:
				line_span: SourceSpan = source_span(source, start_cursor, cur)
				text = source_span_text(source, line_span)
				break

	(text, cur)


-- Leading spaces and tabs never change the line, so the run is scanned by
-- offset while the indent width and the column are carried forward together.
private pure func skip_line_spaces_with_indent(source: SourceFile, cursor: Cursor) -> (Int, Cursor):
	text: String = source.text
	var offset: Int = cursor.offset
	var column: Int = cursor.column
	var indent: Int = 0

	while True:
		match text.get(offset):
			Some(' '):
				indent += 1
				column += 1
				offset += 1
			Some('\t'):
				indent += tab_advance(indent + 1)
				column += tab_advance(column)
				offset += 1
			_:
				break

	next_cursor: Cursor = {
		offset = offset,
		line = cursor.line,
		column = column
	}

	(indent, next_cursor)


private pure func pipe_marker_at_margin(
	source: SourceFile,
	cursor: Cursor,
	margin_column: Int,
) -> (Bool, Cursor):
	(indent, marker_cursor) = skip_line_spaces_with_indent(source, cursor)

	if indent == margin_column - 1:
		match source_peek(source, marker_cursor):
			Some('|'):
				(True, marker_cursor)
			_:
				(False, marker_cursor)
	else:
		(False, marker_cursor)


private pure func raw_pipe_start_marker(source: SourceFile, cursor: Cursor) -> (Bool, Int, Cursor):
	(indent, marker_cursor) = skip_line_spaces_with_indent(source, cursor)

	match source_peek(source, marker_cursor):
		Some('|'):
			(True, indent + 1, marker_cursor)
		_:
			(False, indent + 1, marker_cursor)


private pure func raw_pipe_start_after_raw(
	source: SourceFile,
	cursor: Cursor,
) -> Option[(Int, Cursor)]:
	if not text_starts_with(source, cursor, "raw"):
		None
	else:
		match source.text.get(cursor.offset + 3):
			Some(c):
				if is_ident_continue(c):
					None
				else:
					after_raw: Cursor = cursor_advanced(source, cursor, 3)
					(_, after_spaces) = skip_line_spaces_with_indent(source, after_raw)

					match source_peek(source, after_spaces):
						Some('\n'):
							after_newline: Cursor = source_advance(source, after_spaces)
							(ok, margin_column, marker_cursor) = raw_pipe_start_marker(
								source,
								after_newline,
							)

							if ok:
								Some((margin_column, marker_cursor))
							else:
								None
						_:
							None
			None:
				None


private pure func escape_char(c: Char) -> Option[Char]:
	match c:
		'n':
			Some('\n')
		't':
			Some('\t')
		'r':
			Some('\r')
		'\\':
			Some('\\')
		'\"':
			Some('\"')
		'\'':
			Some('\'')
		'0':
			Some(to_char(0))
		'{':
			Some('{')
		'}':
			Some('}')
		_:
			None


private pure func scan_unicode_escape(
	source: SourceFile,
	cursor: Cursor,
) -> (Option[Int], Cursor, List[ParseDiagnostic]):
	var cur: Cursor = cursor_advanced(source, cursor, 3)
	var codepoint: Int = 0
	var digits: Int = 0
	var has_error: Bool = False
	var diagnostics: List[ParseDiagnostic] = []

	while not has_error:
		match source_peek(source, cur):
			Some('}'):
				break
			Some(c):
				if (
					is_digit_char(c)
					or c >= 'a' and c <= 'f'
					or c >= 'A' and c <= 'F'
				):
					digits += 1

					if digits > 6:
						has_error = True
						diagnostics = diagnostics.append(
							parse_error(
								source_empty_span(source, cur),
								"Unicode escape \\u{} must contain 1-6 hex digits",
							),
						)
					else:
						codepoint = codepoint * 16 + hex_value(c)
						cur = source_advance(source, cur)
				else:
					has_error = True
					diagnostics = diagnostics.append(
						parse_error(
							source_empty_span(source, cur),
							"Unicode escape \\u{} must contain only hex digits",
						),
					)
			None:
				has_error = True
				diagnostics = diagnostics.append(
					parse_error(
						source_empty_span(source, cur),
						"unterminated Unicode escape",
					),
				)

	if has_error:
		(None, cur, diagnostics)
	else if digits == 0:
		final_diagnostics: List[ParseDiagnostic] = diagnostics.append(
			parse_error(
				source_empty_span(source, cur),
				"Unicode escape \\u{} must contain 1-6 hex digits",
			),
		)
		(None, cur, final_diagnostics)
	else:
		after_close: Cursor = source_advance(source, cur)

		-- Unicode scalar values exclude UTF-16 surrogates and values above U+10FFFF.
		if codepoint > 1114111 or codepoint >= 55296 and codepoint <= 57343:
			final_diagnostics: List[ParseDiagnostic] = diagnostics.append(
				parse_error(
					source_empty_span(source, after_close),
					"Unicode codepoint is out of range or a surrogate",
				),
			)
			(None, after_close, final_diagnostics)
		else:
			(Some(codepoint), after_close, diagnostics)


private pure func append_source_segment(
	text: String,
	source: SourceFile,
	start_cursor: Cursor,
	end_cursor: Cursor,
) -> String:
	if end_cursor.offset > start_cursor.offset:
		text + source_span_text(
			source,
			source_span(source, start_cursor, end_cursor),
		)
	else:
		text


-- A literal body never spans a line, so a run inside one is scanned by offset
-- with only tabs moving the column by more than one.
private pure func cursor_after_run(cursor: Cursor, end_offset: Int, end_column: Int) -> Cursor:
	if end_offset == cursor.offset:
		cursor
	else:
		{
			offset = end_offset,
			line = cursor.line,
			column = end_column
		}


-- Skip the run of string-body characters that are copied verbatim, stopping at
-- the closing quote, a newline, an escape, or an interpolation marker.
private pure func skip_plain_string_run(source: SourceFile, cursor: Cursor) -> Cursor:
	text: String = source.text
	var offset: Int = cursor.offset
	var column: Int = cursor.column

	while True:
		match text.get(offset):
			Some('\"'):
				break
			Some('\n'):
				break
			Some('\\'):
				break
			Some('$'):
				break
			Some('\t'):
				column += tab_advance(column)
				offset += 1
			Some(_):
				column += 1
				offset += 1
			None:
				break

	cursor_after_run(cursor, offset, column)


-- Skip the run of interpolated-tail characters that are copied verbatim,
-- stopping at any character that changes brace depth, quoting, or escaping.
private pure func skip_plain_interpolation_run(source: SourceFile, cursor: Cursor) -> Cursor:
	text: String = source.text
	var offset: Int = cursor.offset
	var column: Int = cursor.column

	while True:
		match text.get(offset):
			Some('\"'):
				break
			Some('$'):
				break
			Some('{'):
				break
			Some('}'):
				break
			Some('\\'):
				break
			Some('\n'):
				break
			Some('\t'):
				column += tab_advance(column)
				offset += 1
			Some(_):
				column += 1
				offset += 1
			None:
				break

	cursor_after_run(cursor, offset, column)


-- Skip the run of pipe-line characters that are copied verbatim, stopping at
-- the end of the line or at an interpolation marker.
private pure func skip_plain_pipe_run(source: SourceFile, cursor: Cursor) -> Cursor:
	text: String = source.text
	var offset: Int = cursor.offset
	var column: Int = cursor.column

	while True:
		match text.get(offset):
			Some('\n'):
				break
			Some('$'):
				break
			Some('\t'):
				column += tab_advance(column)
				offset += 1
			Some(_):
				column += 1
				offset += 1
			None:
				break

	cursor_after_run(cursor, offset, column)


private pure func consume_until_single_quote(source: SourceFile, cursor: Cursor) -> Cursor:
	var cur: Cursor = cursor

	while True:
		match source_peek(source, cur):
			Some('\''):
				cur = source_advance(source, cur)
				break
			Some('\n'):
				break
			Some(_):
				cur = source_advance(source, cur)
			None:
				break

	cur


-- Spaces and tabs never change the line, so the run is scanned by offset and
-- the column is carried forward instead of recomputed per character.
private pure func scan_docstring(source: SourceFile, cursor: Cursor) -> LiteralScan:
	start_cursor: Cursor = cursor
	var cur: Cursor = consume_line(source, cursor)
	var text: String = string(128)
	var first_line: Bool = True
	var has_error: Bool = False
	var diagnostics: List[ParseDiagnostic] = []

	while not has_error:
		if starts_docstring_at(source, cur):
			cur = consume_line(source, cur)
			break
		else:
			match source_peek(source, cur):
				None:
					has_error = True
					diagnostics = diagnostics.append(
						parse_error(
							source_empty_span(source, cur),
							"Unterminated docstring: missing closing ---",
						),
					)
				Some(_):
					(line, next_cursor) = read_line_text(source, cur)

					if first_line:
						text = line
						first_line = False
					else:
						text = text + "\n" + line

					cur = next_cursor

	if has_error:
		{
			end_cursor = cur,
			kind = None,
			span = source_span(source, start_cursor, cur),
			diagnostics = diagnostics
		}
	else:
		kind: TokenKind = DocStringToken(text)
		{
			end_cursor = cur,
			kind = Some(kind),
			span = source_span(source, start_cursor, cur),
			diagnostics = diagnostics
		}


private pure func scan_string_literal(source: SourceFile, cursor: Cursor) -> LiteralScan:
	start_cursor: Cursor = cursor
	var cur: Cursor = source_advance(source, cursor)
	var segment_start: Cursor = cur
	var text: String = string(32)
	var has_error: Bool = False
	var is_interpolated: Bool = False
	var diagnostics: List[ParseDiagnostic] = []

	while True:
		cur = skip_plain_string_run(source, cur)

		match source_peek(source, cur):
			Some('\"'):
				text = append_source_segment(text, source, segment_start, cur)
				cur = source_advance(source, cur)
				break
			Some('\n'):
				has_error = True
				diagnostics = diagnostics.append(
					parse_error(
						source_empty_span(source, cur),
						"Unterminated string literal. Use aligned pipe strings for multiline text",
					),
				)
				cur = source_advance(source, cur)
				break
			Some('\\'):
				text = append_source_segment(text, source, segment_start, cur)

				if text_starts_with(source, cur, "\\u{"):
					(codepoint, next_cursor, escape_diagnostics) = scan_unicode_escape(source, cur)
					cur = next_cursor
					diagnostics = diagnostics.concat(escape_diagnostics)

					match codepoint:
						Some(value):
							text = text.append_char(to_char(value))
							segment_start = cur
						None:
							has_error = True
				else:
					escape_start: Cursor = cur
					cur = source_advance(source, cur)

					match source_peek(source, cur):
						Some(escaped):
							match escape_char(escaped):
								Some(c):
									text = text.append_char(c)
									cur = source_advance(source, cur)
									segment_start = cur
								None:
									has_error = True
									diagnostics = diagnostics.append(
										parse_error(
											source_empty_span(source, escape_start),
											"unknown escape sequence '\\" + escaped.to_string() + "'",
										),
									)
									cur = source_advance(source, cur)
						None:
							has_error = True
							diagnostics = diagnostics.append(
								parse_error(
									source_empty_span(source, escape_start),
									"unterminated escape sequence",
								),
							)
							break
			Some('$'):
				if text_starts_with(source, cur, "$" + "{"):
					text = append_source_segment(text, source, segment_start, cur)
					is_interpolated = True
					cur = cursor_advanced(source, cur, 2)
					break
				else:
					cur = source_advance(source, cur)
			Some(_):
				cur = source_advance(source, cur)
			None:
				has_error = True
				diagnostics = diagnostics.append(
					parse_error(
						source_empty_span(source, cur),
						"Unterminated string literal: missing closing '\"'",
					),
				)
				break

	if has_error:
		{
			end_cursor = cur,
			kind = None,
			span = source_span(source, start_cursor, cur),
			diagnostics = diagnostics
		}
	else if is_interpolated:
		scan_interpolated_string_tail(source, cur, start_cursor, text)
	else:
		kind: TokenKind = StringLiteralToken(NormalStringLiteral, text)
		{
			end_cursor = cur,
			kind = Some(kind),
			span = source_span(source, start_cursor, cur),
			diagnostics = diagnostics
		}


private pure func scan_raw_string_literal(source: SourceFile, cursor: Cursor) -> LiteralScan:
	start_cursor: Cursor = cursor
	var cur: Cursor = cursor_advanced(source, cursor, 4)
	body_start: Cursor = cur
	source_text: String = source.text
	var offset: Int = cur.offset
	var column: Int = cur.column

	while True:
		match source_text.get(offset):
			Some('\"'):
				break
			Some('\n'):
				break
			Some('\t'):
				column += tab_advance(column)
				offset += 1
			Some(_):
				column += 1
				offset += 1
			None:
				break

	cur = cursor_after_run(cur, offset, column)
	text: String = append_source_segment(string(32), source, body_start, cur)
	var has_error: Bool = False
	var diagnostics: List[ParseDiagnostic] = []

	match source_peek(source, cur):
		Some('\"'):
			cur = source_advance(source, cur)
		Some('\n'):
			has_error = True
			diagnostics = diagnostics.append(
				parse_error(
					source_empty_span(source, cur),
					"Raw string cannot span multiple lines",
				),
			)
			cur = source_advance(source, cur)
		_:
			has_error = True
			diagnostics = diagnostics.append(
				parse_error(
					source_empty_span(source, cur),
					"Unterminated raw string literal: missing closing '\"'",
				),
			)

	if has_error:
		{
			end_cursor = cur,
			kind = None,
			span = source_span(source, start_cursor, cur),
			diagnostics = diagnostics
		}
	else:
		kind: TokenKind = StringLiteralToken(RawStringLiteral, text)
		{
			end_cursor = cur,
			kind = Some(kind),
			span = source_span(source, start_cursor, cur),
			diagnostics = diagnostics
		}


private pure func scan_interpolated_string_tail(
	source: SourceFile,
	cursor: Cursor,
	span_start: Cursor,
	prefix: String,
) -> LiteralScan:
	var cur: Cursor = cursor
	var text: String = prefix + "{"
	var brace_depth: Int = 1
	var in_string: Bool = False
	var has_error: Bool = False
	var diagnostics: List[ParseDiagnostic] = []

	while not has_error:
		run_cursor: Cursor = skip_plain_interpolation_run(source, cur)
		text = append_source_segment(text, source, cur, run_cursor)
		cur = run_cursor

		match source_peek(source, cur):
			Some('\"'):
				if brace_depth > 0:
					text = text.append_char('\"')
					in_string = not in_string
					cur = source_advance(source, cur)
				else:
					cur = source_advance(source, cur)
					break
			Some('$'):
				if text_starts_with(source, cur, "$" + "{"):
					if in_string:
						text = text + "$" + "{"
					else:
						text = text.append_char('{')
						brace_depth += 1

						if brace_depth > MAX_INTERPOLATION_DEPTH:
							has_error = True
							diagnostics = diagnostics.append(
								parse_error(
									source_empty_span(source, cur),
									"string interpolation nested too deeply",
								),
							)

					if not has_error:
						cur = cursor_advanced(source, cur, 2)
				else:
					text = text.append_char('$')
					cur = source_advance(source, cur)
			Some('{'):
				if in_string:
					text = text.append_char('{')
				else if brace_depth > 0:
					text = text.append_char('{')
					brace_depth += 1
				else:
					text += "\\{"

				cur = source_advance(source, cur)
			Some('}'):
				if in_string:
					text = text.append_char('}')
				else if brace_depth > 0:
					text = text.append_char('}')
					brace_depth -= 1
				else:
					text += "\\}"

				cur = source_advance(source, cur)
			Some('\\'):
				text = text.append_char('\\')
				cur = source_advance(source, cur)

				match source_peek(source, cur):
					Some(escaped):
						text = text.append_char(escaped)
						cur = source_advance(source, cur)
					None:
						has_error = True
						diagnostics = diagnostics.append(
							parse_error(
								source_empty_span(source, cur),
								"unterminated interpolated string",
							),
						)
			Some('\n'):
				has_error = True
				diagnostics = diagnostics.append(
					parse_error(
						source_empty_span(source, cur),
						"Unterminated interpolated string. Use aligned pipe strings for multiline text",
					),
				)
				cur = source_advance(source, cur)
			Some(c):
				text = text.append_char(c)
				cur = source_advance(source, cur)
			None:
				has_error = True
				diagnostics = diagnostics.append(
					parse_error(
						source_empty_span(source, cur),
						"Unterminated interpolated string: missing closing '\"'",
					),
				)

	if has_error:
		{
			end_cursor = cur,
			kind = None,
			span = source_span(source, span_start, cur),
			diagnostics = diagnostics
		}
	else:
		kind: TokenKind = StringLiteralToken(InterpolatedStringLiteral, text)
		{
			end_cursor = cur,
			kind = Some(kind),
			span = source_span(source, span_start, cur),
			diagnostics = diagnostics
		}


private pure func read_pipe_line_content(
	source: SourceFile,
	cursor: Cursor,
	raw: Bool,
) -> (String, Bool, Cursor, Bool):
	var cur: Cursor = cursor
	var text: String = string(64)
	var saw_interp: Bool = False
	var ended_with_newline: Bool = False

	while True:
		run_cursor: Cursor = skip_plain_pipe_run(source, cur)
		text = append_source_segment(text, source, cur, run_cursor)
		cur = run_cursor

		match source_peek(source, cur):
			Some('\n'):
				cur = source_advance(source, cur)
				ended_with_newline = True
				break
			Some('$'):
				if not raw and text_starts_with(source, cur, "$" + "{"):
					text = text.append_char('{')
					saw_interp = True
					cur = cursor_advanced(source, cur, 2)
				else:
					text = text.append_char('$')
					cur = source_advance(source, cur)
			Some(c):
				text = text.append_char(c)
				cur = source_advance(source, cur)
			None:
				break

	(text, saw_interp, cur, ended_with_newline)


private pure func scan_pipe_block(
	source: SourceFile,
	cursor: Cursor,
	span_start: Cursor,
	margin_column: Int,
	raw: Bool,
) -> PipeBlockScan:
	var cur: Cursor = cursor
	var text: String = string(128)
	var saw_interp: Bool = False
	var first_line: Bool = True
	var ended_with_newline: Bool = False
	var has_error: Bool = False
	var diagnostics: List[ParseDiagnostic] = []

	while not has_error:
		if not first_line:
			text = text.append_char('\n')

		if not raw and text_starts_with(source, cur, "||"):
			text = text.append_char('|')
			cur = cursor_advanced(source, cur, 2)
		else:
			match source_peek(source, cur):
				Some('|'):
					cur = source_advance(source, cur)
				_:
					has_error = True
					diagnostics = diagnostics.append(
						parse_error(
							source_empty_span(source, cur),
							"Expected aligned pipe string marker at column " + margin_column.to_string(),
						),
					)

		if not has_error:
			line_result: (String, Bool, Cursor, Bool) = read_pipe_line_content(source, cur, raw)
			line_text: String = line_result[0]
			line_saw_interp: Bool = line_result[1]
			next_cursor: Cursor = line_result[2]
			line_ended_with_newline: Bool = line_result[3]
			text += line_text
			saw_interp = saw_interp or line_saw_interp
			cur = next_cursor
			ended_with_newline = line_ended_with_newline

			if ended_with_newline:
				(continues, marker_cursor) = pipe_marker_at_margin(source, cur, margin_column)

				if continues:
					cur = marker_cursor
					first_line = False
				else:
					break
			else:
				break

	if has_error:
		{
			end_cursor = cur,
			kind = None,
			span = source_span(source, span_start, cur),
			diagnostics = diagnostics,
			ended_with_newline = ended_with_newline
		}
	else:
		var string_kind: StringLiteralKind = PipeStringLiteral

		if raw:
			string_kind = RawPipeStringLiteral
		else if saw_interp:
			string_kind = InterpolatedPipeStringLiteral

		kind: TokenKind = StringLiteralToken(string_kind, text)
		{
			end_cursor = cur,
			kind = Some(kind),
			span = source_span(source, span_start, cur),
			diagnostics = diagnostics,
			ended_with_newline = ended_with_newline
		}


private pure func scan_char_literal(source: SourceFile, cursor: Cursor) -> LiteralScan:
	start_cursor: Cursor = cursor
	var cur: Cursor = source_advance(source, cursor)
	var codepoint: Int = 0
	var has_value: Bool = False
	var has_error: Bool = False
	var diagnostics: List[ParseDiagnostic] = []

	match source_peek(source, cur):
		Some('\\'):
			if text_starts_with(source, cur, "\\u{"):
				(value, next_cursor, escape_diagnostics) = scan_unicode_escape(source, cur)
				cur = next_cursor
				diagnostics = diagnostics.concat(escape_diagnostics)

				match value:
					Some(cp):
						codepoint = cp
						has_value = True
					None:
						has_error = True
			else:
				escape_start: Cursor = cur
				cur = source_advance(source, cur)

				match source_peek(source, cur):
					Some(escaped):
						match escape_char(escaped):
							Some(c):
								codepoint = to_int(c)
								has_value = True
								cur = source_advance(source, cur)
							None:
								has_error = True
								diagnostics = diagnostics.append(
									parse_error(
										source_empty_span(source, escape_start),
										"unknown escape sequence '\\" + escaped.to_string() + "'",
									),
								)
								cur = source_advance(source, cur)
					None:
						has_error = True
						diagnostics = diagnostics.append(
							parse_error(
								source_empty_span(source, escape_start),
								"unterminated character literal",
							),
						)
		Some('\n'):
			has_error = True
			diagnostics = diagnostics.append(
				parse_error(
					source_empty_span(source, cur),
					"Invalid character literal: expected single character between quotes",
				),
			)
		Some(c):
			codepoint = to_int(c)
			has_value = True
			cur = source_advance(source, cur)
		None:
			has_error = True
			diagnostics = diagnostics.append(
				parse_error(
					source_empty_span(source, cur),
					"unterminated character literal",
				),
			)

	if not has_error:
		match source_peek(source, cur):
			Some('\''):
				cur = source_advance(source, cur)
			_:
				has_error = True
				diagnostics = diagnostics.append(
					parse_error(
						source_empty_span(source, cur),
						"Invalid character literal: expected single character between quotes",
					),
				)

	if has_error or not has_value:
		final_cursor: Cursor = consume_until_single_quote(source, cur)
		{
			end_cursor = final_cursor,
			kind = None,
			span = source_span(source, start_cursor, final_cursor),
			diagnostics = diagnostics
		}
	else:
		kind: TokenKind = CharLiteralToken(codepoint)
		{
			end_cursor = cur,
			kind = Some(kind),
			span = source_span(source, start_cursor, cur),
			diagnostics = diagnostics
		}


-- Identifier characters are never newlines or tabs, so the run is scanned by
-- offset and the end cursor is computed once instead of per character.
private pure func identifier_end_cursor(source: SourceFile, start_cursor: Cursor) -> Cursor:
	text: String = source.text
	var offset: Int = start_cursor.offset

	while True:
		match text.get(offset):
			Some(c):
				if is_ident_continue(c):
					offset += 1
				else:
					break
			None:
				break

	{
		offset = offset,
		line = start_cursor.line,
		column = start_cursor.column + offset - start_cursor.offset
	}


private pure func keyword_for(text: String) -> Option[Keyword]:
	match text:
		"func":
			Some(FuncKeyword)
		"pure":
			Some(PureKeyword)
		"var":
			Some(VarKeyword)
		"union":
			Some(UnionKeyword)
		"record":
			Some(RecordKeyword)
		"void":
			Some(VoidKeyword)
		"while":
			Some(WhileKeyword)
		"for":
			Some(ForKeyword)
		"in":
			Some(InKeyword)
		"if":
			Some(IfKeyword)
		"else":
			Some(ElseKeyword)
		"and":
			Some(AndKeyword)
		"or":
			Some(OrKeyword)
		"not":
			Some(NotKeyword)
		"on":
			Some(OnKeyword)
		"match":
			Some(MatchKeyword)
		"True":
			Some(TrueKeyword)
		"False":
			Some(FalseKeyword)
		"break":
			Some(BreakKeyword)
		"continue":
			Some(ContinueKeyword)
		"debug":
			Some(DebugKeyword)
		"struct":
			Some(StructKeyword)
		"enum":
			Some(EnumKeyword)
		"with":
			Some(WithKeyword)
		"resource":
			Some(ResourceKeyword)
		"foreign":
			Some(ForeignKeyword)
		"private":
			Some(PrivateKeyword)
		"builtin":
			Some(BuiltinKeyword)
		"concurrent":
			Some(ConcurrentKeyword)
		"concurrently":
			Some(ConcurrentlyKeyword)
		"detach":
			Some(DetachKeyword)
		"select":
			Some(SelectKeyword)
		"into_opaque":
			Some(IntoOpaqueKeyword)
		"from":
			Some(FromKeyword)
		"from_opaque":
			Some(FromOpaqueKeyword)
		"after":
			Some(AfterKeyword)
		"sealed":
			Some(SealedKeyword)
		"opaque":
			Some(OpaqueKeyword)
		"try":
			Some(TryKeyword)
		"import":
			Some(ImportKeyword)
		"as":
			Some(AsKeyword)
		"trait":
			Some(TraitKeyword)
		"implements":
			Some(ImplementsKeyword)
		"Self":
			Some(SelfKeyword)
		"type":
			Some(TypeKeyword)
		"alias":
			Some(AliasKeyword)
		"where":
			Some(WhereKeyword)
		_:
			None


private pure func scan_raw_as_identifier(source: SourceFile, cursor: Cursor) -> LiteralScan:
	end_cursor: Cursor = identifier_end_cursor(source, cursor)
	span: SourceSpan = source_span(source, cursor, end_cursor)
	text: String = source_span_text(source, span)

	kind: TokenKind = match keyword_for(text):
		Some(keyword):
			KeywordToken(keyword)
		None:
			IdentifierToken(text)

	{
		end_cursor = end_cursor,
		kind = Some(kind),
		span = span,
		diagnostics = []
	}


private pure func first_significant_decimal_digit(text: String) -> Int:
	var index: Int = 0

	while index + 1 < text.length():
		if text.get_or(index, '0') == '0':
			index += 1
		else:
			break

	index


private pure func decimal_literal_leq(left: String, right: String) -> Bool:
	left_start: Int = first_significant_decimal_digit(left)
	right_start: Int = first_significant_decimal_digit(right)
	left_len: Int = left.length() - left_start
	right_len: Int = right.length() - right_start

	if left_len < right_len:
		True
	else if left_len > right_len:
		False
	else:
		var result: Bool = True
		var comparing: Bool = True
		var index: Int = 0

		while comparing and index < left_len:
			left_char: Char = left.get_or(left_start + index, '0')
			right_char: Char = right.get_or(right_start + index, '0')

			if left_char < right_char:
				comparing = False
				result = True
			else if left_char > right_char:
				comparing = False
				result = False
			else:
				index += 1

		result


-- Digits and the single fraction dot are never newlines or tabs, so the run is
-- scanned by offset and the end cursor is computed once.
private pure func group_depth_after_symbol(depth: Int, symbol: Symbol) -> Int:
	match symbol:
		LeftParenSymbol:
			depth + 1
		LeftBracketSymbol:
			depth + 1
		LeftBraceSymbol:
			depth + 1
		RightParenSymbol:
			if depth <= 0:
				0
			else:
				depth - 1
		RightBracketSymbol:
			if depth <= 0:
				0
			else:
				depth - 1
		RightBraceSymbol:
			if depth <= 0:
				0
			else:
				depth - 1
		_:
			depth


private struct SymbolMatch {
	symbol: Symbol,
	width: Int
}


private struct NumberScan {
	end_offset: Int,
	saw_dot: Bool
}


private pure func top_indent(indent_stack: List[Int]) -> Int:
	indent_stack.get_or(0, 0)


private pure func top_lambda_level(levels: List[LambdaBodyLevel]) -> Option[LambdaBodyLevel]:
	levels.get(0)


private pure func in_lambda_body_at(levels: List[LambdaBodyLevel], group_depth: Int) -> Bool:
	match top_lambda_level(levels):
		Some(level):
			group_depth >= level.group_depth
		None:
			False


private pure func in_nested_group_in_lambda_at(
	levels: List[LambdaBodyLevel],
	group_depth: Int,
) -> Bool:
	match top_lambda_level(levels):
		Some(level):
			group_depth > level.group_depth
		None:
			False


private pure func kind_is_colon_symbol(kind: Option[TokenKind]) -> Bool:
	match kind:
		Some(SymbolToken(ColonSymbol)):
			True
		_:
			False


private pure func can_enter_lambda_body_at(
	levels: List[LambdaBodyLevel],
	group_depth: Int,
	last_token_kind: Option[TokenKind],
) -> Bool:
	group_depth > 0 and kind_is_colon_symbol(last_token_kind) and match top_lambda_level(levels):
		Some(level):
			group_depth > level.group_depth
		None:
			True


private pure func dropped_first_lambda_level(
	levels: List[LambdaBodyLevel],
) -> List[LambdaBodyLevel]:
	var rest: List[LambdaBodyLevel] = []
	var i: Int = 1

	while i < levels.length():
		match levels.get(i):
			Some(level):
				rest = rest.append(level)
			None:
				void

		i += 1

	rest


private pure func pruned_lambda_body_levels(
	levels: List[LambdaBodyLevel],
	indent_stack: List[Int],
) -> List[LambdaBodyLevel]:
	var remaining: List[LambdaBodyLevel] = levels

	while True:
		match top_lambda_level(remaining):
			Some(level):
				if top_indent(indent_stack) <= level.base_indent:
					remaining = dropped_first_lambda_level(remaining)
				else:
					break
			None:
				break

	remaining


private pure func dedent_would_be_inconsistent_at(indent_stack: List[Int], indent: Int) -> Bool:
	var i: Int = 0
	var inconsistent: Bool = False

	while i < indent_stack.length():
		match indent_stack.get(i):
			Some(level):
				if indent >= level:
					break
				else:
					next_level: Int = indent_stack.get_or(i + 1, 0)

					if indent > next_level:
						inconsistent = True
						break
					else:
						i += 1
			None:
				break

	inconsistent


private pure func lambda_body_close_indent_at(
	levels: List[LambdaBodyLevel],
	group_depth: Int,
	indent_stack: List[Int],
	indent: Int,
) -> Option[Int]:
	match top_lambda_level(levels):
		Some(level):
			if (
				group_depth == level.group_depth
				and indent > level.base_indent
				and indent < top_indent(indent_stack)
				and dedent_would_be_inconsistent_at(indent_stack, indent)
			):
				Some(level.base_indent)
			else:
				None
		None:
			None


private pure func text_starts_with(source: SourceFile, cursor: Cursor, expected: String) -> Bool:
	expected_len: Int = expected.length()

	if cursor.offset + expected_len > source.text.length():
		False
	else:
		var index: Int = 0
		var matches: Bool = True

		while matches and index < expected_len:
			if source.text.get_or(cursor.offset + index, '\0') == expected.get_or(index, '\0'):
				index += 1
			else:
				matches = False

		matches


private pure func line_ends_after_optional_space_at(
	source: SourceFile,
	cursor: Cursor,
	offset: Int,
) -> Bool:
	var i: Int = offset
	var ok: Bool = False

	while True:
		match source.text.get(cursor.offset + i):
			Some(' '):
				i += 1
			Some('\t'):
				i += 1
			Some('\n'):
				ok = True
				break
			None:
				ok = True
				break
			_:
				break

	ok


private pure func starts_docstring_at(source: SourceFile, cursor: Cursor) -> Bool:
	text_starts_with(source, cursor, "---") and line_ends_after_optional_space_at(source, cursor, 3)


---
Whether the cursor sits on the word `raw` used as a literal introducer rather
than as the start of a longer identifier. Both raw string and raw pipe forms
begin this way; which one it is, the rare-literal scanner decides.
---
private pure func starts_raw_word_at(source: SourceFile, cursor: Cursor) -> Bool:
	if not text_starts_with(source, cursor, "raw"):
		False
	else:
		match source.text.get(cursor.offset + 3):
			Some(c):
				not is_ident_continue(c)
			None:
				True


private pure func spaces_end_cursor(source: SourceFile, cursor: Cursor) -> Cursor:
	text: String = source.text
	var offset: Int = cursor.offset
	var column: Int = cursor.column

	while True:
		match text.get(offset):
			Some(' '):
				column += 1
				offset += 1
			Some('\t'):
				column += tab_advance(column)
				offset += 1
			_:
				break

	{
		offset = offset,
		line = cursor.line,
		column = column
	}


private pure func line_comment_end_cursor(source: SourceFile, cursor: Cursor) -> Cursor:
	text: String = source.text
	var offset: Int = cursor.offset + 2
	var column: Int = cursor.column + 2

	while True:
		match text.get(offset):
			Some('\n'):
				break
			Some('\t'):
				column += tab_advance(column)
				offset += 1
			Some(_):
				column += 1
				offset += 1
			None:
				break

	{
		offset = offset,
		line = cursor.line,
		column = column
	}


private pure func number_scan(source: SourceFile, cursor: Cursor) -> NumberScan:
	text: String = source.text
	var offset: Int = cursor.offset
	var saw_dot: Bool = False

	while True:
		match text.get(offset):
			Some(c):
				if is_digit_char(c):
					offset += 1
				else if c == '.' and not saw_dot:
					match text.get(offset + 1):
						Some(next):
							if is_digit_char(next):
								saw_dot = True
								offset += 1
							else:
								break
						None:
							break
				else:
					break
			None:
				break

	{
		end_offset = offset,
		saw_dot = saw_dot
	}


---
Classify the symbol at the cursor, returning only the symbol and how many
characters it spans. `None` means the character starts no symbol, which the
builder reports as an unexpected character.
---
private pure func symbol_at(source: SourceFile, cursor: Cursor) -> Option[SymbolMatch]:
	text: String = source.text
	next: Option[Char] = text.get(cursor.offset + 1)

	match text.get(cursor.offset):
		Some('-'):
			if next == Some('>'):
				Some({
					symbol = ArrowSymbol,
					width = 2,
				})
			else if next == Some('='):
				Some({
					symbol = MinusEqualSymbol,
					width = 2,
				})
			else:
				Some({
					symbol = MinusSymbol,
					width = 1,
				})
		Some('='):
			if next == Some('>'):
				Some({
					symbol = FatArrowSymbol,
					width = 2,
				})
			else if next == Some('='):
				Some({
					symbol = EqualEqualSymbol,
					width = 2,
				})
			else:
				Some({
					symbol = EqualSymbol,
					width = 1,
				})
		Some('<'):
			if next == Some('='):
				Some({
					symbol = LessEqualSymbol,
					width = 2,
				})
			else:
				Some({
					symbol = LessSymbol,
					width = 1,
				})
		Some('>'):
			if next == Some('='):
				Some({
					symbol = GreaterEqualSymbol,
					width = 2,
				})
			else:
				Some({
					symbol = GreaterSymbol,
					width = 1,
				})
		Some('!'):
			if next == Some('='):
				Some({
					symbol = NotEqualSymbol,
					width = 2,
				})
			else:
				None
		Some('?'):
			if next == Some('='):
				Some({
					symbol = QuestionEqualsSymbol,
					width = 2,
				})
			else:
				None
		Some('.'):
			if next == Some('.') and text.get(cursor.offset + 2) == Some('.'):
				Some({
					symbol = DotDotDotSymbol,
					width = 3,
				})
			else if next == Some('.'):
				Some({
					symbol = DotDotSymbol,
					width = 2,
				})
			else:
				Some({
					symbol = DotSymbol,
					width = 1,
				})
		Some('+'):
			if next == Some('='):
				Some({
					symbol = PlusEqualSymbol,
					width = 2,
				})
			else:
				Some({
					symbol = PlusSymbol,
					width = 1,
				})
		Some('*'):
			if next == Some('='):
				Some({
					symbol = StarEqualSymbol,
					width = 2,
				})
			else:
				Some({
					symbol = StarSymbol,
					width = 1,
				})
		Some('/'):
			if next == Some('='):
				Some({
					symbol = SlashEqualSymbol,
					width = 2,
				})
			else:
				Some({
					symbol = SlashSymbol,
					width = 1,
				})
		Some('('):
			Some({
				symbol = LeftParenSymbol,
				width = 1,
			})
		Some(')'):
			Some({
				symbol = RightParenSymbol,
				width = 1,
			})
		Some('['):
			Some({
				symbol = LeftBracketSymbol,
				width = 1,
			})
		Some(']'):
			Some({
				symbol = RightBracketSymbol,
				width = 1,
			})
		Some('{'):
			Some({
				symbol = LeftBraceSymbol,
				width = 1,
			})
		Some('}'):
			Some({
				symbol = RightBraceSymbol,
				width = 1,
			})
		Some(':'):
			Some({
				symbol = ColonSymbol,
				width = 1,
			})
		Some(','):
			Some({
				symbol = CommaSymbol,
				width = 1,
			})
		Some('_'):
			Some({
				symbol = UnderscoreSymbol,
				width = 1,
			})
		Some('%'):
			Some({
				symbol = PercentSymbol,
				width = 1,
			})
		Some('#'):
			Some({
				symbol = HashSymbol,
				width = 1,
			})
		Some('@'):
			Some({
				symbol = AtSymbol,
				width = 1,
			})
		Some('|'):
			Some({
				symbol = PipeSymbol,
				width = 1,
			})
		_:
			None


---
Lex a source file.

This is a builder: every accumulator is a local `var` that the loop mutates in
place, and the immutable token and diagnostic lists are published once at the
end. Every scanner it calls, including the rare literal forms, returns only
what it found -- an end cursor, a token kind, diagnostics -- so scanning a
token never threads a state record.
---
pure func lex(source: SourceFile) -> LexResult:
	text: String = source.text
	var cursor: Cursor = source_start(source)
	var tokens: List[Token] = list(text.length() / 4 + 16)
	var diagnostics: List[ParseDiagnostic] = []
	var pending_trivia: List[Trivia] = []
	var indent_stack: List[Int] = [0]
	var lambda_body_levels: List[LambdaBodyLevel] = []
	var group_depth: Int = 0
	var pending_newline: Bool = False
	var at_line_start: Bool = True
	var line_has_token: Bool = False
	var last_token_kind: Option[TokenKind] = None
	var scanning: Bool = True

	while scanning:
		if at_line_start:
			line_start_cursor: Cursor = cursor
			var indent: Int = 0

			while True:
				match text.get(cursor.offset):
					Some(' '):
						indent += 1
						cursor = source_advance(source, cursor)
					Some('\t'):
						indent += tab_advance(indent + 1)
						cursor = source_advance(source, cursor)
					_:
						break

			if (
				group_depth > 0
				and ((
					not in_lambda_body_at(lambda_body_levels, group_depth)
					or in_nested_group_in_lambda_at(lambda_body_levels, group_depth)
				))
			):
				pending_newline = False
				at_line_start = False
			else:
				match text.get(cursor.offset):
					Some('\n'):
						void
					None:
						void
					Some(_):
						current_column: Int = top_indent(indent_stack)
						var dedent_target: Int = -1

						match lambda_body_close_indent_at(
							lambda_body_levels,
							group_depth,
							indent_stack,
							indent,
						):
							Some(base_indent):
								dedent_target = base_indent
							None:
								if indent > current_column:
									if pending_newline:
										tokens = tokens.append(
											token(
												NewlineToken,
												source_empty_span(source, cursor),
											),
										)
										last_token_kind = Some(NewlineToken)
										pending_newline = False

									indent_stack = [indent].concat(indent_stack)
									tokens = tokens.append(
										token(
											IndentToken,
											source_span(source, line_start_cursor, cursor),
										),
									)
									last_token_kind = Some(IndentToken)
								else if indent == current_column:
									if pending_newline:
										tokens = tokens.append(
											token(
												NewlineToken,
												source_empty_span(source, cursor),
											),
										)
										last_token_kind = Some(NewlineToken)
										pending_newline = False
								else:
									dedent_target = indent

						if dedent_target >= 0:
							pending_newline = False

							while top_indent(indent_stack) > dedent_target:
								tokens = tokens.append(
									token(
										DedentToken,
										source_empty_span(source, cursor),
									),
								)
								last_token_kind = Some(DedentToken)
								indent_stack = indent_stack.tail()

							if top_indent(indent_stack) != dedent_target:
								diagnostics = diagnostics.append(
									parse_error(
										source_empty_span(source, cursor),
										"inconsistent indentation",
									),
								)
							else:
								lambda_body_levels = pruned_lambda_body_levels(
									lambda_body_levels,
									indent_stack,
								)

						at_line_start = False

		match text.get(cursor.offset):
			None:
				scanning = False
			Some(c):
				if c == '\n':
					entering: Bool = can_enter_lambda_body_at(
						lambda_body_levels,
						group_depth,
						last_token_kind,
					)

					if entering:
						level: LambdaBodyLevel = {
							group_depth = group_depth,
							base_indent = top_indent(indent_stack)
						}
						lambda_body_levels = [level].concat(lambda_body_levels)
						pending_newline = True
					else if (
						group_depth > 0
						and ((
							not in_lambda_body_at(lambda_body_levels, group_depth)
							or in_nested_group_in_lambda_at(lambda_body_levels, group_depth)
						))
					):
						pending_newline = False
					else:
						pending_newline = pending_newline or line_has_token

					cursor = source_advance(source, cursor)
					at_line_start = True
					line_has_token = False
				else if is_space(c):
					cursor = spaces_end_cursor(source, cursor)
				else if (
					c == '\"'
					or c == '\''
					or c == '-' and starts_docstring_at(source, cursor)
					or c == 'r' and starts_raw_word_at(source, cursor)
					or c == '|' and not line_has_token
				):
					match c:
						'-':
							doc_scan: LiteralScan = scan_docstring(source, cursor)
							cursor = doc_scan.end_cursor
							diagnostics = diagnostics.concat(doc_scan.diagnostics)

							match doc_scan.kind:
								Some(kind):
									tokens = tokens.append(
										token_with_trivia(
											kind,
											doc_scan.span,
											pending_trivia,
											[],
										),
									)
									pending_trivia = []
									pending_newline = False
									at_line_start = True
									line_has_token = False
									last_token_kind = Some(kind)
								None:
									void
						'|':
							pipe_scan: PipeBlockScan = scan_pipe_block(
								source,
								cursor,
								cursor,
								cursor.column,
								False,
							)
							cursor = pipe_scan.end_cursor
							diagnostics = diagnostics.concat(pipe_scan.diagnostics)

							match pipe_scan.kind:
								Some(kind):
									tokens = tokens.append(
										token_with_trivia(
											kind,
											pipe_scan.span,
											pending_trivia,
											[],
										),
									)
									pending_trivia = []
									line_has_token = True
									last_token_kind = Some(kind)

									if pipe_scan.ended_with_newline:
										pending_newline = True
										at_line_start = True
										line_has_token = False
								None:
									void
						'r':
							if text_starts_with(source, cursor, "raw\""):
								raw_literal: LiteralScan = scan_raw_string_literal(source, cursor)
								cursor = raw_literal.end_cursor
								diagnostics = diagnostics.concat(raw_literal.diagnostics)

								match raw_literal.kind:
									Some(kind):
										tokens = tokens.append(
											token_with_trivia(
												kind,
												raw_literal.span,
												pending_trivia,
												[],
											),
										)
										pending_trivia = []
										line_has_token = True
										last_token_kind = Some(kind)
									None:
										void
							else:
								match raw_pipe_start_after_raw(source, cursor):
									Some((margin_column, marker_cursor)):
										raw_pipe_scan: PipeBlockScan = scan_pipe_block(
											source,
											marker_cursor,
											cursor,
											margin_column,
											True,
										)
										cursor = raw_pipe_scan.end_cursor
										diagnostics = diagnostics.concat(raw_pipe_scan.diagnostics)

										match raw_pipe_scan.kind:
											Some(kind):
												tokens = tokens.append(
													token_with_trivia(
														kind,
														raw_pipe_scan.span,
														pending_trivia,
														[],
													),
												)
												pending_trivia = []
												line_has_token = True
												last_token_kind = Some(kind)

												if raw_pipe_scan.ended_with_newline:
													pending_newline = True
													at_line_start = True
													line_has_token = False
											None:
												void
									None:
										ident_literal: LiteralScan = scan_raw_as_identifier(
											source,
											cursor,
										)
										cursor = ident_literal.end_cursor
										diagnostics = diagnostics.concat(ident_literal.diagnostics)

										match ident_literal.kind:
											Some(kind):
												tokens = tokens.append(
													token_with_trivia(
														kind,
														ident_literal.span,
														pending_trivia,
														[],
													),
												)
												pending_trivia = []
												line_has_token = True
												last_token_kind = Some(kind)
											None:
												void
						'\"':
							string_literal: LiteralScan = scan_string_literal(source, cursor)
							cursor = string_literal.end_cursor
							diagnostics = diagnostics.concat(string_literal.diagnostics)

							match string_literal.kind:
								Some(kind):
									tokens = tokens.append(
										token_with_trivia(
											kind,
											string_literal.span,
											pending_trivia,
											[],
										),
									)
									pending_trivia = []
									line_has_token = True
									last_token_kind = Some(kind)
								None:
									void
						'\'':
							char_literal: LiteralScan = scan_char_literal(source, cursor)
							cursor = char_literal.end_cursor
							diagnostics = diagnostics.concat(char_literal.diagnostics)

							match char_literal.kind:
								Some(kind):
									tokens = tokens.append(
										token_with_trivia(
											kind,
											char_literal.span,
											pending_trivia,
											[],
										),
									)
									pending_trivia = []
									line_has_token = True
									last_token_kind = Some(kind)
								None:
									void
						_:
							void
				else if c == '-' and text_starts_with(source, cursor, "--"):
					comment_end: Cursor = line_comment_end_cursor(source, cursor)
					comment_span: SourceSpan = source_span(source, cursor, comment_end)
					comment: Trivia = trivia(
						CommentTrivia,
						source_span_text(source, comment_span),
						comment_span,
					)
					cursor = comment_end

					if line_has_token:
						tokens = add_trailing_trivia(tokens, comment)
					else:
						pending_trivia = pending_trivia.append(comment)
				else if (
					c == '_'
					and not text
						.get(cursor.offset + 1)
						.map(is_ident_continue)
						.get_or(False)
				):
					span: SourceSpan = source_span(
						source,
						cursor,
						source_advance(source, cursor),
					)
					kind: TokenKind = SymbolToken(UnderscoreSymbol)
					tokens = tokens.append(token_with_trivia(kind, span, pending_trivia, []))
					pending_trivia = []
					line_has_token = True
					last_token_kind = Some(kind)
					cursor = source_advance(source, cursor)
				else if is_ident_start(c):
					end_cursor: Cursor = identifier_end_cursor(source, cursor)
					span: SourceSpan = source_span(source, cursor, end_cursor)
					word: String = source_span_text(source, span)

					kind: TokenKind = match keyword_for(word):
						Some(keyword):
							KeywordToken(keyword)
						None:
							IdentifierToken(word)

					tokens = tokens.append(token_with_trivia(kind, span, pending_trivia, []))
					pending_trivia = []
					line_has_token = True
					last_token_kind = Some(kind)
					cursor = end_cursor
				else if is_digit_char(c):
					scan: NumberScan = number_scan(source, cursor)
					end_cursor: Cursor = {
						offset = scan.end_offset,
						line = cursor.line,
						column = cursor.column + scan.end_offset - cursor.offset
					}
					span: SourceSpan = source_span(source, cursor, end_cursor)
					digits: String = source_span_text(source, span)

					if not scan.saw_dot and not decimal_literal_leq(digits, INT128_MAX_DECIMAL):
						diagnostics = diagnostics.append(
							parse_error(
								span,
								"Integer literal '" + digits + "' exceeds Int128 range",
							),
						)

					kind: TokenKind = if scan.saw_dot:
						FloatLiteralToken(digits)
					else:
						IntLiteralToken(digits)

					tokens = tokens.append(token_with_trivia(kind, span, pending_trivia, []))
					pending_trivia = []
					line_has_token = True
					last_token_kind = Some(kind)
					cursor = end_cursor
				else:
					match symbol_at(source, cursor):
						Some(found):
							end_cursor: Cursor = cursor_advanced(source, cursor, found.width)
							span: SourceSpan = source_span(source, cursor, end_cursor)
							kind: TokenKind = SymbolToken(found.symbol)
							tokens = tokens.append(
								token_with_trivia(
									kind,
									span,
									pending_trivia,
									[],
								),
							)
							pending_trivia = []
							line_has_token = True
							last_token_kind = Some(kind)
							group_depth = group_depth_after_symbol(group_depth, found.symbol)
							cursor = end_cursor
						None:
							diagnostics = diagnostics.append(
								parse_error(
									source_empty_span(source, cursor),
									"unexpected character '" + c.to_string() + "'",
								),
							)
							cursor = source_advance(source, cursor)

	while top_indent(indent_stack) > 0:
		tokens = tokens.append(token(DedentToken, source_empty_span(source, cursor)))
		indent_stack = indent_stack.tail()

	if top_indent(indent_stack) != 0:
		diagnostics = diagnostics.append(
			parse_error(
				source_empty_span(source, cursor),
				"inconsistent indentation",
			),
		)

	tokens = tokens.append(
		token_with_trivia(
			EndOfFileToken,
			source_empty_span(source, cursor),
			pending_trivia,
			[],
		),
	)

	{
		tokens = tokens,
		diagnostics = diagnostics
	}
