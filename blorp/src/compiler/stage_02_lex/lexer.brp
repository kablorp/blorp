import:
	../../lib/source:
		Cursor,
		SourceFile,
		SourceSpan,
		source_advance,
		source_empty_span,
		source_peek,
		source_span,
		source_span_text,
		source_start,
	list: list
	parse_diagnostic: ParseDiagnostic, parse_error
	string: string
	token:
		Keyword(
			AfterKeyword,
			AliasKeyword,
			AndKeyword,
			AsKeyword,
			BreakKeyword,
			BuiltinKeyword,
			ConcurrentKeyword,
			ConcurrentlyKeyword,
			ContinueKeyword,
			DebugKeyword,
			DetachKeyword,
			ElseKeyword,
			EnumKeyword,
			FalseKeyword,
			ForKeyword,
			ForeignKeyword,
			FromKeyword,
			FromOpaqueKeyword,
			FuncKeyword,
			IfKeyword,
			ImplementsKeyword,
			ImportKeyword,
			InKeyword,
			IntoOpaqueKeyword,
			MatchKeyword,
			NotKeyword,
			OnKeyword,
			OpaqueKeyword,
			OrKeyword,
			PrivateKeyword,
			PureKeyword,
			RecordKeyword,
			ResourceKeyword,
			SealedKeyword,
			SelectKeyword,
			SelfKeyword,
			StructKeyword,
			TraitKeyword,
			TryKeyword,
			TrueKeyword,
			TypeKeyword,
			UnionKeyword,
			VarKeyword,
			VoidKeyword,
			WhereKeyword,
			WhileKeyword,
			WithKeyword,
		),
		StringLiteralKind(
			InterpolatedPipeStringLiteral,
			InterpolatedStringLiteral,
			NormalStringLiteral,
			PipeStringLiteral,
			RawPipeStringLiteral,
			RawStringLiteral,
		),
