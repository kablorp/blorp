			EqualSymbol,
			FatArrowSymbol,
			GreaterEqualSymbol,
			GreaterSymbol,
			HashSymbol,
			LeftBraceSymbol,
			LeftBracketSymbol,
			LeftParenSymbol,
			LessEqualSymbol,
			LessSymbol,
			MinusEqualSymbol,
			MinusSymbol,
			NotEqualSymbol,
			PercentSymbol,
			PipeSymbol,
			PlusEqualSymbol,
			PlusSymbol,
			QuestionEqualsSymbol,
			RightBraceSymbol,
			RightBracketSymbol,
			RightParenSymbol,
			SlashEqualSymbol,
			SlashSymbol,
