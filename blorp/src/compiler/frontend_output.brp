-- Shared human-readable frontend output for source-oriented CLI commands.
--
-- Parse-only output intentionally starts from source text. It must not enter
-- typechecking or Core lowering because `compile --ast` is a parser command
-- even when the program contains type errors.
import:
	../lib/source: source_file
	stage_02_lex/name_table: IdentifierSpellings(SpellingsFromIdentifierText), identifier_spelling
	stage_03_parse/language_parser: parse_compiler_source
	stage_03_parse/parsed_ast:
		RecordDeclarationForm(OrdinaryRecord, LegacyStruct, FixedRecord),
		ParsedDecl(
			BuiltinTypeParsedDecl, ForeignBlockParsedDecl, FunctionParsedDecl, ImplParsedDecl,
			ImportBlockParsedDecl, ParsedErrorDecl, PrivateParsedDecl, RecordParsedDecl,
			TraitParsedDecl, TypeAliasParsedDecl, UnionParsedDecl, VarParsedDecl,
		),
		ParsedIdentifier,
		ParsedProgram,
	stage_06_typecheck/decl:
		TypedDecl(
			TypedForeignFunctionDecl, TypedFunctionDecl, TypedGlobalVarDecl, TypedImplDecl,
			TypedParsedDecl, TypedPrivateDecl, TypedRecordDecl, TypedTraitDecl, TypedTypeAliasDecl,
			TypedUnionDecl,
		),
		TypedProgram,
	stage_06_typecheck/type_system/semantic_type: SemanticType, type_to_string
	stage_06_typecheck/typed_display: typed_callable_display, typed_named_value_display


---
The spelling of `identifier` in a summary line, from `spellings`.
---
private pure func summary_name(
	spellings: IdentifierSpellings,
	identifier: ParsedIdentifier,
) -> String:
	identifier_spelling(spellings, identifier.name, identifier.text)


private pure func parsed_count_summary(
	kind: String,
	name: String,
	count: Int,
	item_name: String,
) -> String:
	"${kind} ${name} with ${count.to_string()} ${item_name}"


private pure func parsed_decl_summary(
	spellings: IdentifierSpellings,
	decl: ParsedDecl,
) -> List[String]:
	match decl:
		FunctionParsedDecl(function_decl):
			["Func ${summary_name(spellings, function_decl.name)}"]
		VarParsedDecl(var_decl):
			if var_decl.is_mutable:
				["var ${summary_name(spellings, var_decl.name)}"]
			else:
				[summary_name(spellings, var_decl.name)]
		ImportBlockParsedDecl(imports, _):
			imports.map(func(import_decl): "Import ${import_decl.module_path}")
		ForeignBlockParsedDecl(_, functions, _):
			functions.map(
				func(function_decl): "Func ${summary_name(spellings, function_decl.name)}",
			)
		RecordParsedDecl(record_decl):
			kind: String = match record_decl.form:
				OrdinaryRecord: "Record"
				LegacyStruct: "Struct"
				FixedRecord: "FixedRecord"
			[parsed_count_summary(
					kind,
					summary_name(spellings, record_decl.name),
					record_decl.fields.length(),
					"fields",
				)]
		UnionParsedDecl(union_decl):
			[parsed_count_summary(
					"Union",
					summary_name(spellings, union_decl.name),
					union_decl.variants.length(),
					"variants",
				)]
		BuiltinTypeParsedDecl(type_decl):
			["BuiltinType ${summary_name(spellings, type_decl.name)}"]
		TypeAliasParsedDecl(alias_decl):
			["TypeAlias ${summary_name(spellings, alias_decl.name)}"]
		TraitParsedDecl(trait_decl):
			["Trait ${summary_name(spellings, trait_decl.name)}"]
		ImplParsedDecl(impl_decl):
			["Impl ${summary_name(spellings, impl_decl.trait_name)}"]
		PrivateParsedDecl(_, _):
			["Private"]
		ParsedErrorDecl(_):
			["<parse error>"]


pure func parsed_program_summary(spellings: IdentifierSpellings, program: ParsedProgram) -> String:
	program.decls
		.flat_map(func(decl): parsed_decl_summary(spellings, decl))
		.join("\n")


private pure func typed_callable_summary(
	kind: String,
	name: String,
	is_pure: Bool,
	param_types: List[SemanticType],
	return_type: SemanticType,
) -> String:
	"${kind} ${typed_callable_display(name, is_pure, param_types, return_type)}"


private pure func typed_decl_summary(
	spellings: IdentifierSpellings,
	decl: TypedDecl,
) -> List[String]:
	match decl:
		TypedFunctionDecl(info):
			[typed_callable_summary(
					"Func",
					summary_name(spellings, info.decl.name),
					info.decl.is_pure,
					info.param_types,
					info.semantic_return_type,
				)]
		TypedForeignFunctionDecl(info):
			[typed_callable_summary(
					"Foreign func",
					summary_name(spellings, info.decl.name),
					info.decl.is_pure,
					info.param_types,
					info.semantic_return_type,
				)]
		TypedGlobalVarDecl(info):
			prefix: String = if info.decl.is_mutable:
				"var "
			else:
				""

			name: String = summary_name(spellings, info.decl.name)
			["${prefix}${typed_named_value_display(name, info.binding_type)}"]
		TypedRecordDecl(info):
			kind: String = match info.decl.form:
				OrdinaryRecord: "Record"
				LegacyStruct: "Struct"
				FixedRecord: "FixedRecord"

			name: String = summary_name(spellings, info.decl.name)
			[parsed_count_summary(kind, name, info.fields.length(), "fields")]
		TypedTypeAliasDecl(info):
			target_type: String = type_to_string(info.semantic_target_type)
			["TypeAlias ${summary_name(spellings, info.decl.name)}: ${target_type}"]
		TypedTraitDecl(info):
			name: String = summary_name(spellings, info.decl.name)
			[parsed_count_summary("Trait", name, info.methods.length(), "methods")]
		TypedUnionDecl(info):
			name: String = summary_name(spellings, info.decl.name)
			[parsed_count_summary("Union", name, info.variants.length(), "variants")]
		TypedImplDecl(info):
			[
				"Impl ${summary_name(spellings, info.decl.trait_name)} for ${type_to_string(info.for_type)}",
			]
		TypedPrivateDecl(inner):
			typed_decl_summary(spellings, inner).map(func(line): "Private ${line}")
		TypedParsedDecl(parsed):
			parsed_decl_summary(spellings, parsed)


pure func typed_program_summary(spellings: IdentifierSpellings, program: TypedProgram) -> String:
	program.decls
		.flat_map(func(decl): typed_decl_summary(spellings, decl))
		.join("\n")


pure func parsed_source_summary(path: String, module_name: String, source_text: String) -> String:
	-- Parse-only: the program's identifier ids index a private lexer table that is
	-- not kept, so the summary reads each identifier's own text.
	parsed_program_summary(
		SpellingsFromIdentifierText,
		parse_compiler_source(source_file(path, module_name, source_text)),
	)
