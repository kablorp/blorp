-- Source, configuration, and dependency facts owned by an LSP workspace.
import:
	../../stage_01_file_io/source: SourceFile
	../../stage_04_modules/frontend_graph: FrontendImportEdge
	../../stage_04_modules/loaded_module:
		ModuleOrigin(NativePackageModule, SourcePackageModule, StdlibModule, UserModule),
		ResolvedModuleIdentity,
	../../stage_04_modules/project_source_catalog: ProjectStdProvider, project_std_providers_equal
	../../stage_04_modules/source_package_layout: SourcePackageLayout
	../analysis/fingerprint_model: ContentFingerprint
	../protocol/identity: DocumentUri
	document_model: DocumentChange, DocumentSave, DocumentVersion, OpenedDocument


record WorkspaceRoot {
	client_uri: DocumentUri,
	client_path: String,
	canonical_path: String
}


record WorkspaceConfiguration {
	workspace_roots: List[WorkspaceRoot],
	std_provider: ProjectStdProvider,
	source_packages: List[SourcePackageLayout],
	native_package_roots: List[String]
}


pure func workspace_configurations_equal(
	left: WorkspaceConfiguration,
	right: WorkspaceConfiguration,
) -> Bool:
	(
		left.workspace_roots == right.workspace_roots
		and project_std_providers_equal(left.std_provider, right.std_provider)
		and left.source_packages == right.source_packages
		and left.native_package_roots == right.native_package_roots
	)


-- Filesystem and package discovery happen before this value enters the pure
-- workspace reducer. It carries a complete source view for the new epoch.
record WorkspaceConfigurationUpdate {
	configuration: WorkspaceConfiguration,
	sources: List[DiscoveredSourceSnapshot]
}


union DiscoveredSourceProvenance:
	DiskSource
	StandardLibrarySource
	SourcePackageSource(SourcePackageLayout)
	NativePackageSource(String)


record ResolvedDocumentOpen {
	document: OpenedDocument,
	source: SourceFile,
	provenance: DiscoveredSourceProvenance
}


-- The save-refresh effect reports only what the pure workspace reducer needs.
-- Keeping this narrower than WorkspaceEvent prevents filesystem code from
-- manufacturing document or configuration transitions.
union SavedSourceRefresh:
	SavedSourceUpdated(DiscoveredSourceSnapshot)
	SavedSourceRemoved(DocumentUri)


union WorkspaceEvent:
	ResolvedDocumentOpened(ResolvedDocumentOpen)
	WorkspaceDocumentChanged(DocumentChange)
	WorkspaceDocumentSaved(DocumentSave)
	WorkspaceDocumentClosed(DocumentUri)
	DiskSourceUpdated(DiscoveredSourceSnapshot)
	DiskSourceRemoved(DocumentUri)
	WorkspaceConfigurationChanged(WorkspaceConfigurationUpdate)


pure func saved_source_refresh_event(refresh: SavedSourceRefresh) -> WorkspaceEvent:
	match refresh:
		SavedSourceUpdated(discovered):
			DiskSourceUpdated(discovered)
		SavedSourceRemoved(uri):
			DiskSourceRemoved(uri)


record OpenDocumentSourceLayer {
	source: SourceFile,
	provenance: DiscoveredSourceProvenance,
	document_version: DocumentVersion,
	content_fingerprint: ContentFingerprint
}


record DiscoveredSourceLayer {
	source: SourceFile,
	provenance: DiscoveredSourceProvenance,
	content_fingerprint: ContentFingerprint
}


record DiscoveredSourceSnapshot {
	uri: DocumentUri,
	layer: DiscoveredSourceLayer
}


-- Both layers remain under one URI while an editor overlay is open. A disk
-- update changes only discovered_source; closing the document then reveals the
-- latest retained disk layer without another read or a duplicate-URI search.
record SourceLayers {
	uri: DocumentUri,
	discovered_source: Option[DiscoveredSourceLayer],
	open_document: Option[OpenDocumentSourceLayer]
}


union SelectedSourceProvenance:
	SelectedOpenDocument(DocumentVersion)
	SelectedDiscoveredSource(DiscoveredSourceProvenance)


-- Compiler workers receive only the selected layer. Construction is private so
-- URI, source, provenance, origin, and fingerprint always come from one layer.
private record SourceSnapshotRep {
	uri: DocumentUri,
	source: SourceFile,
	origin: ModuleOrigin,
	source_package: Option[SourcePackageLayout],
	provenance: SelectedSourceProvenance,
	content_fingerprint: ContentFingerprint
}


opaque type SourceSnapshot = SourceSnapshotRep


private pure func discovered_origin(provenance: DiscoveredSourceProvenance) -> ModuleOrigin:
	match provenance:
		DiskSource:
			UserModule
		StandardLibrarySource:
			StdlibModule
		SourcePackageSource(package):
			SourcePackageModule(package.package_alias)
		NativePackageSource(package_id):
			NativePackageModule(package_id)


private pure func discovered_source_package(
	provenance: DiscoveredSourceProvenance,
) -> Option[SourcePackageLayout]:
	match provenance:
		SourcePackageSource(package):
			Some(package)
		_:
			None


pure func source_snapshot_for_layers(layers: SourceLayers) -> Option[SourceSnapshot]:
	match layers.open_document:
		Some(open_document):
			origin = discovered_origin(open_document.provenance)
			source_package = discovered_source_package(open_document.provenance)

			representation: SourceSnapshotRep = {
				uri = layers.uri,
				source = open_document.source,
				origin = origin,
				source_package = source_package,
				provenance = SelectedOpenDocument(open_document.document_version),
				content_fingerprint = open_document.content_fingerprint
			}
			Some(into SourceSnapshot(representation))
		None:
			match layers.discovered_source:
				Some(discovered):
					representation: SourceSnapshotRep = {
						uri = layers.uri,
						source = discovered.source,
						origin = discovered_origin(discovered.provenance),
						source_package = discovered_source_package(discovered.provenance),
						provenance = SelectedDiscoveredSource(discovered.provenance),
						content_fingerprint = discovered.content_fingerprint
					}
					Some(into SourceSnapshot(representation))
				None:
					None


pure func source_snapshot_uri(snapshot: SourceSnapshot) -> DocumentUri:
	representation: SourceSnapshotRep = from SourceSnapshot(snapshot)
	representation.uri


pure func source_snapshot_source(snapshot: SourceSnapshot) -> SourceFile:
	representation: SourceSnapshotRep = from SourceSnapshot(snapshot)
	representation.source


pure func source_snapshot_origin(snapshot: SourceSnapshot) -> ModuleOrigin:
	representation: SourceSnapshotRep = from SourceSnapshot(snapshot)
	representation.origin


pure func source_snapshot_source_package(snapshot: SourceSnapshot) -> Option[SourcePackageLayout]:
	representation: SourceSnapshotRep = from SourceSnapshot(snapshot)
	representation.source_package


pure func source_snapshot_provenance(snapshot: SourceSnapshot) -> SelectedSourceProvenance:
	representation: SourceSnapshotRep = from SourceSnapshot(snapshot)
	representation.provenance


pure func source_snapshot_content_fingerprint(snapshot: SourceSnapshot) -> ContentFingerprint:
	representation: SourceSnapshotRep = from SourceSnapshot(snapshot)
	representation.content_fingerprint


-- Import knowledge has explicit phases. A failed or incomplete resolution is
-- data, not an empty dependency list, so invalidation cannot accidentally treat
-- a broken module as dependency-free.
record ParsedModuleDependencies {
	uri: DocumentUri,
	module_identity: ResolvedModuleIdentity,
	import_paths: List[String]
}


record ResolvedModuleDependencies {
	uri: DocumentUri,
	module_identity: ResolvedModuleIdentity,
	import_edges: List[FrontendImportEdge]
}


union ModuleDependencyState:
	UnparsedModuleDependencies(DocumentUri, ResolvedModuleIdentity)
	ParsedDependencies(ParsedModuleDependencies)
	ResolvedDependencies(ResolvedModuleDependencies)


pure func module_dependency_uri(dependency: ModuleDependencyState) -> DocumentUri:
	match dependency:
		UnparsedModuleDependencies(uri, _):
			uri
		ParsedDependencies(parsed):
			parsed.uri
		ResolvedDependencies(resolved):
			resolved.uri


pure func module_dependency_identity(dependency: ModuleDependencyState) -> ResolvedModuleIdentity:
	match dependency:
		UnparsedModuleDependencies(_, identity):
			identity
		ParsedDependencies(parsed):
			parsed.module_identity
		ResolvedDependencies(resolved):
			resolved.module_identity
