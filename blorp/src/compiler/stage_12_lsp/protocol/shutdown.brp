-- Decoder and response encoder for the LSP shutdown request.
--
-- Existing LSP clients commonly serialize absent parameters as JSON null, so
-- shutdown accepts either an omitted params field or null and rejects all other
-- parameter shapes.
import:
	json: JsonValue(JsonNull)
	json_rpc:
		JsonRpcEnvelope,
		decode_lsp_json_rpc_body,
		json_rpc_method,
		json_rpc_parameters,
		json_rpc_request_id,
		json_rpc_success_value,
	protocol:
		ProtocolError(InvalidMethodParameters, MissingRequestId, UnknownMethod),
		ProtocolInputOutcome(ProtocolInputAccepted, ProtocolInputIgnored, ProtocolInputRejected),
		RequestId,


SHUTDOWN_METHOD: String = "shutdown"


record ShutdownRequest {
	id: RequestId
}

private pure func shutdown_parameter_error() -> ProtocolError:
	InvalidMethodParameters(SHUTDOWN_METHOD, "params must be omitted or null")


pure func decode_lsp_shutdown_envelope(
	envelope: JsonRpcEnvelope,
) -> ProtocolInputOutcome[ShutdownRequest]:
	method = json_rpc_method(envelope)
	request_id = json_rpc_request_id(envelope)

	if method != SHUTDOWN_METHOD:
		match request_id:
			Some(id):
				ProtocolInputRejected({
					request_id = Some(id),
					error = UnknownMethod(method),
				})
			None:
				ProtocolInputIgnored(UnknownMethod(method))
	else:
		match request_id:
			None:
				ProtocolInputIgnored(MissingRequestId(method))
			Some(id):
				match json_rpc_parameters(envelope):
					None:
						ProtocolInputAccepted({id = id})
					Some(JsonNull):
						ProtocolInputAccepted({id = id})
					Some(_):
						ProtocolInputRejected({
							request_id = Some(id),
							error = shutdown_parameter_error(),
						})


pure func decode_lsp_shutdown_request(body: String) -> ProtocolInputOutcome[ShutdownRequest]:
	match decode_lsp_json_rpc_body(body):
		Err(failure):
			ProtocolInputRejected(failure)
		Ok(envelope):
			decode_lsp_shutdown_envelope(envelope)


pure func encode_lsp_shutdown_response(request: ShutdownRequest) -> String:
	json_rpc_success_value(request.id, JsonNull).to_string()
