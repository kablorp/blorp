-- Naming policy shared by the typed-AST -> Core boundary passes.
--
-- Keep this module independent of the typed AST and Core data models. Naming
-- policy does not depend on either representation, and lowerers should not
-- import data-heavy passes solely to share these helpers.
import:
	string: string


private CORE_MODULE_NAME_SEPARATOR: String = "__"

private MANGLED_DEF_ID_PREFIX: String = "__def_"

private CORE_UFCS_PREFIX: String = "__ufcs_"

private CORE_UFCS_MODULE_SEPARATOR: String = "$"


---
Fold a module path into the identifier alphabet the C backend accepts.

Every character outside `[A-Za-z0-9_]` becomes `_`, matching
`sanitize_core_mono_name` in stage_09_core. Module names are host filesystem
paths, so a directory such as `my-project` reaches here carrying characters C
rejects in an identifier; passing them through emits a program the C compiler
cannot parse. The mapping is many-to-one, so paths differing only in which
non-identifier character separates two segments share one spelling. That is
unchanged in kind from the `/` and `.` folding this has always performed.
---
pure func sanitize_core_module_name(module_name: String) -> String:
	var result: String = string(module_name.length())

	for ch in module_name:
		result = if (
			ch >= 'a' and ch <= 'z'
			or ch >= 'A' and ch <= 'Z'
			or ch >= '0' and ch <= '9'
			or ch == '_'
		):
			result.append_char(ch)
		else:
			result.append_char('_')

	result


---
Sanitizing a module name costs about as much as spelling a whole member
name, so callers that spell many members of one module compute this prefix
once and join each member through `core_module_member_name_from_prefix`.
`core_module_member_name` composes the same two halves; it stays the single
spelling authority and the prefix pair is only its factored form.
---
pure func core_module_member_prefix(module_name: String) -> String:
	sanitize_core_module_name(module_name) + CORE_MODULE_NAME_SEPARATOR


pure func core_module_member_name_from_prefix(prefix: String, source_name: String) -> String:
	prefix + source_name


pure func core_module_member_name(module_name: String, source_name: String) -> String:
	core_module_member_name_from_prefix(core_module_member_prefix(module_name), source_name)


---
One prefix per distinct module name, for passes that spell members of many
modules and want to sanitize each module exactly once up front.
---
pure func core_module_member_prefix_table(module_names: List[String]) -> Dict[String, String]:
	var table: Dict[String, String] = {}

	for module_name in module_names:
		if not table.contains(module_name):
			table = table.set(module_name, core_module_member_prefix(module_name))
		else:
			void

	table


---
Keep the escaped module identity separate from the source name so callers
lowering many declarations from one module can perform path escaping once.
---
pure func core_ufcs_module_prefix(module_name: String) -> String:
	CORE_UFCS_PREFIX + module_name.replace(
		"/",
		CORE_UFCS_MODULE_SEPARATOR,
	) + CORE_MODULE_NAME_SEPARATOR


pure func core_ufcs_name_from_prefix(prefix: String, source_name: String) -> String:
	prefix + source_name


pure func core_ufcs_function_name(module_name: String, source_name: String) -> String:
	core_ufcs_name_from_prefix(core_ufcs_module_prefix(module_name), source_name)


---
The C symbol for a definition identified by `def_id`. Two definitions may share a
source name (for example variants of different unions), so the id is part of
the spelling. Every producer of such a symbol calls this; nothing parses it
back, because the identity travels explicitly as `CoreVar.def_id`.
---
pure func mangled_definition_name(def_id: Int, name: String) -> String:
	MANGLED_DEF_ID_PREFIX + def_id.to_string() + "_" + name


---
Suffix appended to a function's mangled name for its pure overload. This is
the single definition: `stage_09_core/synth_name.brp` imports it (it cannot own
it, because it imports this module) and owns the accessors that recover a
name's parts.
---
CORE_PURE_OVERLOAD_SUFFIX: String = "__pure"


pure func core_pure_overload_function_name_from_prefix(
	prefix: String,
	source_name: String,
) -> String:
	core_module_member_name_from_prefix(prefix, source_name + CORE_PURE_OVERLOAD_SUFFIX)


pure func core_pure_overload_function_name(module_name: String, source_name: String) -> String:
	core_pure_overload_function_name_from_prefix(
		core_module_member_prefix(module_name),
		source_name,
	)


pure func is_core_ufcs_function_name(name: String) -> Bool:
	name.starts_with(CORE_UFCS_PREFIX)


---
Decode relative to an already-known module. A standalone split is ambiguous
when either a module segment or source name contains `__`.

This is the only parser of the `core_ufcs_function_name` format; callers in
`stage_09_core` (`resolve.brp`, `mono_specialize.brp`) hold a `module_name`
already, from a resolved call or a specialization site, and reach here
because Core itself does not carry a separate `source_name` field once a
UFCS name is flattened. Publishing that unflattened `source_name` alongside
the flattened one at the point Core is constructed (see
`core_ufcs_function_name`/`resolved_imported_call_explicit_name` in
`lower.brp`) would let those callers read a structured field instead of
decoding this string; that is out of this slice's file ownership.
---
pure func core_ufcs_source_name_for_module(module_name: String, name: String) -> Option[String]:
	prefix: String = core_ufcs_module_prefix(module_name)

	if not name.starts_with(prefix) or name.length() <= prefix.length():
		None
	else:
		Some(name.substring(prefix.length(), name.length() - prefix.length()))


private EMPTY_MODULE_MEMBER_PREFIXES: Dict[String, String] = {}


---
Typecheck represents module-owned type identity as `module::Type`. Core is
intentionally flat, so lower that canonical identity once as the Core type
is constructed rather than rediscovering ownership from imports later.

This is the no-prefix-table special case of
`flatten_canonical_core_type_name_with_prefixes`. The two used to run
independent copies of the same `"::"`-split; `raw_index_of("::")` plus the
two `substring` calls are now written exactly once, here, so this stays the
only parser of the `module::Type` canonical-name format. A caller with a
prefix table for many members of few modules should call
`flatten_canonical_core_type_name_with_prefixes` directly rather than pay
for an empty-table lookup per member.
---
pure func flatten_canonical_core_type_name(name: String) -> String:
	flatten_canonical_core_type_name_with_prefixes(EMPTY_MODULE_MEMBER_PREFIXES, name)


---
Same flattening through a precomputed prefix table (see
`core_module_member_prefix_table`); a module missing from the table falls
back to the per-member authority, so the spelling never depends on the table.
---
pure func flatten_canonical_core_type_name_with_prefixes(
	module_member_prefixes: Dict[String, String],
	name: String,
) -> String:
	separator_index: Int = name.raw_index_of("::")

	if separator_index < 0:
		name
	else:
		module_name = name.substring(0, separator_index)
		type_name = name.substring(separator_index + 2, name.length() - separator_index - 2)

		match module_member_prefixes.get(module_name):
			Some(prefix):
				core_module_member_name_from_prefix(prefix, type_name)
			None:
				core_module_member_name(module_name, type_name)
