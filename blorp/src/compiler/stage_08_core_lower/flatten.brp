private pure func bound_with_concurrent_bindings(
	bound: List[String],
	bindings: List[CorePreClosureConcurrentBinding],
) -> List[String]:
	var result: List[String] = bound

	for binding in bindings:
		result = bound_with_var(result, binding.variable)

	result


private pure func rewrite_raw_match_case(
	callable_rewrites: List[CallableRewrite],
	global_rewrites: List[GlobalRewrite],
	bound: List[String],
	match_case: CoreRawMatchCase,
) -> CoreRawMatchCase:
	case_bound = bound_with_pattern(bound, match_case.pattern)
	{ match_case |
		body = rewrite_expr(callable_rewrites, global_rewrites, case_bound, match_case.body)
	}


private pure func rewrite_select_arm(
	callable_rewrites: List[CallableRewrite],
	global_rewrites: List[GlobalRewrite],
	bound: List[String],
	arm: CoreSelectArm,
) -> CoreSelectArm:
	match arm.kind:
		SelectRecvArm(recv):
			{ arm |
				kind = SelectRecvArm(
					{ recv |
						channel = rewrite_expr(
							callable_rewrites,
							global_rewrites,
							bound,
							recv.channel,
						)
					},
				),
				body = rewrite_expr(
					callable_rewrites,
					global_rewrites,
					bound_with_var(bound, recv.binder),
					arm.body,
				)
			}
		SelectSealedArm(channel):
			{ arm |
				kind = SelectSealedArm(
					rewrite_expr(
						callable_rewrites,
						global_rewrites,
						bound,
						channel,
					),
				),
				body = rewrite_expr(callable_rewrites, global_rewrites, bound, arm.body)
			}
		SelectAfterArm(timeout):
			{ arm |
				kind = SelectAfterArm(
					rewrite_expr(
						callable_rewrites,
						global_rewrites,
						bound,
						timeout,
					),
				),
				body = rewrite_expr(callable_rewrites, global_rewrites, bound, arm.body)
			}


private pure func rewrite_dict_literal_entry(
	callable_rewrites: List[CallableRewrite],
	global_rewrites: List[GlobalRewrite],
	bound: List[String],
	entry: CoreDictLiteralEntry,
) -> CoreDictLiteralEntry:
	{
		key = rewrite_expr(callable_rewrites, global_rewrites, bound, entry.key),
		value = rewrite_expr(callable_rewrites, global_rewrites, bound, entry.value)
	}


private pure func rewrite_record_field_value(
	callable_rewrites: List[CallableRewrite],
	global_rewrites: List[GlobalRewrite],
	bound: List[String],
	field: CoreRecordFieldValue,
) -> CoreRecordFieldValue:
	{ field | value = rewrite_expr(callable_rewrites, global_rewrites, bound, field.value) }


private pure func rewrite_logical_expr(
	callable_rewrites: List[CallableRewrite],
	global_rewrites: List[GlobalRewrite],
	bound: List[String],
	expr: CoreExpr,
) -> CoreExpr:
	-- Logical chains are left-associated. Preserve left-before-right postorder
	-- and lexical scope without recursively entering the full flatten matcher
	-- once per source term.
	var frames: FlattenRewriteLogicalFrameStack = FlattenRewriteLogicalNoFrame
	var action: FlattenRewriteLogicalAction = FlattenRewriteLogicalVisitExpr(bound, expr)
	var result: CoreExpr = expr
	var complete: Bool = False

	while not complete:
		match action:
			FlattenRewriteLogicalVisitExpr(current_bound, current):
				match current:
					LogicalExpr(op, left, right, typ, loc):
						frames = FlattenRewriteLogicalMoreFrames(
							FlattenRewriteLogicalVisitRightFrame(
								op,
								right,
								typ,
								loc,
								current_bound,
							),
							frames,
						)
						action = FlattenRewriteLogicalVisitExpr(current_bound, left)
					_:
						action = FlattenRewriteLogicalRebuildExpr(
							rewrite_expr(
								callable_rewrites,
								global_rewrites,
								current_bound,
								current,
							),
						)
			FlattenRewriteLogicalRebuildExpr(rewritten):
				match frames:
					FlattenRewriteLogicalNoFrame:
						result = rewritten
						complete = True
					FlattenRewriteLogicalMoreFrames(frame, remaining):
						frames = remaining

						match frame:
							FlattenRewriteLogicalVisitRightFrame(op, right, typ, loc, right_bound):
								frames = FlattenRewriteLogicalMoreFrames(
									FlattenRewriteLogicalRebuildParentFrame(
										op,
										rewritten,
										typ,
										loc,
									),
									frames,
								)
								action = FlattenRewriteLogicalVisitExpr(right_bound, right)
							FlattenRewriteLogicalRebuildParentFrame(op, left, typ, loc):
								action = FlattenRewriteLogicalRebuildExpr(
									LogicalExpr(
										op,
										left,
										rewritten,
										typ,
										loc,
									),
								)

	result


private pure func rewrite_non_binding_expr(
	callable_rewrites: List[CallableRewrite],
	global_rewrites: List[GlobalRewrite],
	bound: List[String],
	expr: CoreExpr,
) -> CoreExpr:
	match expr:
		LiteralExpr(_, _, _):
			expr
		VarExpr(variable, typ, loc):
			match rewrite_var(callable_rewrites, global_rewrites, bound, variable):
				Some(rewritten):
					VarExpr(rewritten, typ, loc)
				None:
					expr
		AssignExpr(variable, rhs, typ, loc):
			AssignExpr(
				rewrite_var(callable_rewrites, global_rewrites, bound, variable).get_or(variable),
				rewrite_expr(callable_rewrites, global_rewrites, bound, rhs),
				typ,
				loc,
			)
		ClosureCreateExpr(closure, typ, loc):
			rewrite_closure_reference(callable_rewrites, closure, typ, loc)
		VoidExpr(_, _):
			expr
		BreakExpr(_, _):
			expr
		ContinueExpr(_, _):
			expr
		CallExpr(kind, callee, args, typ, loc):
			rewritten_callee: CoreExpr = match (kind, callee):
				(SelectedDirectCall(def_id), VarExpr(variable, callee_type, callee_loc)):
					match rewrite_var_with_id(callable_rewrites, variable, def_id):
						Some(rewritten):
							VarExpr(rewritten, callee_type, callee_loc)
						None:
							callee
				_:
					rewrite_expr(callable_rewrites, global_rewrites, bound, callee)

			CallExpr(
				rewrite_call_kind(callable_rewrites, kind, callee),
				rewritten_callee,
				args.map(func(arg): rewrite_expr(callable_rewrites, global_rewrites, bound, arg)),
				typ,
				loc,
			)
		BinaryExpr(op, left, right, typ, loc):
			BinaryExpr(
				op,
				rewrite_expr(callable_rewrites, global_rewrites, bound, left),
				rewrite_expr(callable_rewrites, global_rewrites, bound, right),
				typ,
				loc,
			)
		UnaryExpr(op, value, typ, loc):
			UnaryExpr(
				op,
				rewrite_expr(callable_rewrites, global_rewrites, bound, value),
				typ,
				loc,
			)
		LogicalExpr(op, left, right, typ, loc):
			rewrite_logical_expr(callable_rewrites, global_rewrites, bound, expr)
		FieldExpr(value, field_name, typ, loc):
			FieldExpr(
				rewrite_expr(callable_rewrites, global_rewrites, bound, value),
				field_name,
				typ,
				loc,
			)
		TupleFieldExpr(value, field_index, typ, loc):
			TupleFieldExpr(
				rewrite_expr(callable_rewrites, global_rewrites, bound, value),
				field_index,
				typ,
				loc,
			)
		TupleExpr(items, typ, loc):
			TupleExpr(
				items.map(
					func(item): rewrite_expr(callable_rewrites, global_rewrites, bound, item),
				),
				typ,
				loc,
			)
		VectorExpr(items, typ, loc):
			VectorExpr(
				items.map(
					func(item): rewrite_expr(callable_rewrites, global_rewrites, bound, item),
				),
				typ,
				loc,
			)
		ListConstructExpr(construct, typ, loc):
			ListConstructExpr(
				{ construct |
					elements = construct.elements.map(
						func(
							item,
						): { item |
							value = rewrite_expr(
								callable_rewrites,
								global_rewrites,
								bound,
								item.value,
							)
						},
					)
				},
				typ,
				loc,
			)
		DictExpr(entries, typ, loc):
			DictExpr(
				entries.map(
					func(
						entry,
					): rewrite_dict_literal_entry(
						callable_rewrites,
						global_rewrites,
						bound,
						entry,
					),
				),
				typ,
				loc,
			)
		RecordExpr(fields, typ, loc):
			RecordExpr(
				fields.map(
					func(
						field,
					): rewrite_record_field_value(
						callable_rewrites,
						global_rewrites,
						bound,
						field,
					),
				),
				typ,
				loc,
			)
		RecordUpdateExpr(base, fields, typ, loc):
			RecordUpdateExpr(
				rewrite_expr(callable_rewrites, global_rewrites, bound, base),
				fields.map(
					func(
						field,
					): rewrite_record_field_value(
						callable_rewrites,
						global_rewrites,
						bound,
						field,
					),
				),
				typ,
				loc,
			)
		RecordReuseExpr(source, fields, typ, loc):
			RecordReuseExpr(
				rewrite_expr(callable_rewrites, global_rewrites, bound, source),
				fields.map(
					func(
						field,
					): rewrite_record_field_value(
						callable_rewrites,
						global_rewrites,
						bound,
						field,
					),
				),
				typ,
				loc,
			)
		RecordCowUpdateExpr(source, fields, typ, loc):
			RecordCowUpdateExpr(
				rewrite_expr(callable_rewrites, global_rewrites, bound, source),
				CoreTraverse.map_core_record_cow_fields(
					fields,
					func(
						replacement,
					): rewrite_expr(callable_rewrites, global_rewrites, bound, replacement),
				),
				typ,
				loc,
			)
		LetExpr(variable, is_mutable, typ, rhs, body):
			LetExpr(
				variable,
				is_mutable,
				typ,
				rewrite_expr(callable_rewrites, global_rewrites, bound, rhs),
				rewrite_expr(
					callable_rewrites,
					global_rewrites,
					bound_with_var(bound, variable),
					body,
				),
			)
		BorrowLetExpr(variable, typ, rhs, body):
			BorrowLetExpr(
				variable,
				typ,
				rewrite_expr(callable_rewrites, global_rewrites, bound, rhs),
				rewrite_expr(
					callable_rewrites,
					global_rewrites,
					bound_with_var(bound, variable),
					body,
				),
			)
		LambdaExpr(params, return_type, body, is_pure, typ, loc):
			LambdaExpr(
				params,
				return_type,
				rewrite_expr(
					callable_rewrites,
					global_rewrites,
					bound_with_params(bound, params),
					body,
				),
				is_pure,
				typ,
				loc,
			)
		TensorRawViewLetExpr(binding, body, typ, loc):
			TensorRawViewLetExpr(
				{ binding |
					source = rewrite_expr(callable_rewrites, global_rewrites, bound, binding.source)
				},
				rewrite_expr(
					callable_rewrites,
					global_rewrites,
					bound_with_var(bound, binding.variable),
					body,
				),
				typ,
				loc,
			)
		ResourceScopeExpr(scope, typ, loc):
			inner_bound = bound_with_var(bound, scope.variable)
			ResourceScopeExpr(
				{ scope |
					acquire = rewrite_expr(
						callable_rewrites,
						global_rewrites,
						bound,
						scope.acquire,
					),
					body = rewrite_expr(
						callable_rewrites,
						global_rewrites,
						inner_bound,
						scope.body,
					),
					cleanup = rewrite_expr(
						callable_rewrites,
						global_rewrites,
						inner_bound,
						scope.cleanup,
					)
				},
				typ,
				loc,
			)
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			ForRangeExpr(
				binder,
				rewrite_expr(callable_rewrites, global_rewrites, bound, start),
				rewrite_expr(callable_rewrites, global_rewrites, bound, end_value),
				rewrite_loop_body(callable_rewrites, global_rewrites, bound, binder, body),
				typ,
				loc,
			)
		ForChannelExpr(loop, typ, loc):
			ForChannelExpr(
				rewrite_for_channel(callable_rewrites, global_rewrites, bound, loop),
				typ,
				loc,
			)
		ForListExpr(loop, typ, loc):
			ForListExpr(
				rewrite_for_list(callable_rewrites, global_rewrites, bound, loop),
				typ,
				loc,
			)
		ForStringExpr(loop, typ, loc):
			ForStringExpr(
				rewrite_for_string(callable_rewrites, global_rewrites, bound, loop),
				typ,
				loc,
			)
		ForDictExpr(loop, typ, loc):
			ForDictExpr(
				rewrite_for_dict(callable_rewrites, global_rewrites, bound, loop),
				typ,
				loc,
			)
		ForSetExpr(loop, typ, loc):
			ForSetExpr(
				rewrite_for_set(callable_rewrites, global_rewrites, bound, loop),
				typ,
				loc,
			)
		ForStreamExpr(loop, typ, loc):
			ForStreamExpr(
				rewrite_for_stream(callable_rewrites, global_rewrites, bound, loop),
				typ,
				loc,
			)
		ForResourceSourceExpr(loop, typ, loc):
			ForResourceSourceExpr(
				rewrite_for_resource_source(callable_rewrites, global_rewrites, bound, loop),
				typ,
				loc,
			)
		ForTensorExpr(loop, typ, loc):
			ForTensorExpr(
				rewrite_for_tensor(callable_rewrites, global_rewrites, bound, loop),
				typ,
				loc,
			)
		PreClosureConcurrentlyLoopExpr(loop, typ, loc):
			loop_bound = bound_with_var(bound, loop.variable)
			PreClosureConcurrentlyLoopExpr(
				{ loop |
					iterable = rewrite_expr(
						callable_rewrites,
						global_rewrites,
						bound,
						loop.iterable,
					),
					body = rewrite_expr(callable_rewrites, global_rewrites, loop_bound, loop.body),
					timeout = loop.timeout.map(
						func(
							value,
						): rewrite_expr(callable_rewrites, global_rewrites, bound, value),
					),
					limit = rewrite_expr(callable_rewrites, global_rewrites, bound, loop.limit)
				},
				typ,
				loc,
			)
		PreClosureConcurrentExpr(block, typ, loc):
			block_bound: List[String] = bound_with_concurrent_bindings(bound, block.bindings)
			PreClosureConcurrentExpr(
				{ block |
					bindings = block.bindings.map(
						func(
							binding,
						): { binding |
							rhs = rewrite_expr(
								callable_rewrites,
								global_rewrites,
								bound,
								binding.rhs,
							)
						},
					),
					body = rewrite_expr(
						callable_rewrites,
						global_rewrites,
						block_bound,
						block.body,
					),
					timeout = block.timeout.map(
						func(
							value,
						): rewrite_expr(callable_rewrites, global_rewrites, bound, value),
					)
				},
				typ,
				loc,
			)
		SelectExpr(select_expr, typ, loc):
			SelectExpr(
				select_expr.map(
					func(arm): rewrite_select_arm(callable_rewrites, global_rewrites, bound, arm),
				),
				typ,
				loc,
			)
		RawMatchExpr(scrutinee, cases, typ, loc):
			RawMatchExpr(
				rewrite_expr(callable_rewrites, global_rewrites, bound, scrutinee),
				cases.map(
					func(
						match_case,
					): rewrite_raw_match_case(
						callable_rewrites,
						global_rewrites,
						bound,
						match_case,
					),
				),
				typ,
				loc,
			)
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			LiteralMatchExpr(
				rewrite_expr(callable_rewrites, global_rewrites, bound, scrutinee),
				cases.map(
					func(
						match_case,
					): rewrite_literal_match_case(
						callable_rewrites,
						global_rewrites,
						bound,
						match_case,
					),
				),
				rewrite_literal_match_fallback(callable_rewrites, global_rewrites, bound, fallback),
				typ,
				loc,
			)
		ConstructorMatchExpr(scrutinee, release_policy, cases, fallback, typ, loc):
			ConstructorMatchExpr(
				rewrite_expr(callable_rewrites, global_rewrites, bound, scrutinee),
				release_policy,
				cases.map(
					func(
						match_case,
					): rewrite_constructor_match_case(
						callable_rewrites,
						global_rewrites,
						bound,
						match_case,
					),
				),
				rewrite_constructor_match_fallback(
					callable_rewrites,
					global_rewrites,
					bound,
					fallback,
				),
				typ,
				loc,
			)
		PreClosureDetachExpr(detached, typ, loc):
			PreClosureDetachExpr(
				rewrite_expr(callable_rewrites, global_rewrites, bound, detached),
				typ,
				loc,
			)
		RangeExpr(start, end_value, typ, loc):
			RangeExpr(
				rewrite_expr(callable_rewrites, global_rewrites, bound, start),
				rewrite_expr(callable_rewrites, global_rewrites, bound, end_value),
				typ,
				loc,
			)
		IfExpr(cond, then_expr, else_expr, typ, loc):
			IfExpr(
				rewrite_expr(callable_rewrites, global_rewrites, bound, cond),
				rewrite_expr(callable_rewrites, global_rewrites, bound, then_expr),
				rewrite_expr(callable_rewrites, global_rewrites, bound, else_expr),
				typ,
				loc,
			)
		WhileExpr(cond, body, typ, loc):
			WhileExpr(
				rewrite_expr(callable_rewrites, global_rewrites, bound, cond),
				rewrite_expr(callable_rewrites, global_rewrites, bound, body),
				typ,
				loc,
			)
		SeqExpr(_, _):
			CoreTraverse.map_core_sequence_items(
				expr,
				pure func(item): rewrite_expr(callable_rewrites, global_rewrites, bound, item),
			)
		_:
			expr


private pure func rewrite_expr(
	callable_rewrites: List[CallableRewrite],
	global_rewrites: List[GlobalRewrite],
	bound: List[String],
	expr: CoreExpr,
) -> CoreExpr:
	-- Bindings are another naturally deep Core spine. Preserve the exact
	-- RHS-before-body traversal and lexical scope transition without recursive
	-- binding-depth growth.
	var frames: FlattenRewriteBindingFrameStack = FlattenRewriteNoBindingFrame
	var action: FlattenRewriteBindingAction = FlattenRewriteVisitBindingExpr(bound, expr)
	var result: CoreExpr = expr
	var complete: Bool = False

	while not complete:
		match action:
			FlattenRewriteVisitBindingExpr(current_bound, current):
				match current:
					AssignExpr(variable, rhs, _, _):
						frames = FlattenRewriteMoreBindingFrames(
							FlattenRewriteAssignFrame(
								current,
								rewrite_var(
									callable_rewrites,
									global_rewrites,
									current_bound,
									variable,
								),
							),
							frames,
						)
						action = FlattenRewriteVisitBindingExpr(current_bound, rhs)
					LetExpr(variable, _, _, rhs, _):
						frames = FlattenRewriteMoreBindingFrames(
							FlattenRewriteLetRhsFrame(
								current,
								bound_with_var(current_bound, variable),
							),
							frames,
						)
						action = FlattenRewriteVisitBindingExpr(current_bound, rhs)
					BorrowLetExpr(variable, _, rhs, _):
						frames = FlattenRewriteMoreBindingFrames(
							FlattenRewriteBorrowLetRhsFrame(
								current,
								bound_with_var(current_bound, variable),
							),
							frames,
						)
						action = FlattenRewriteVisitBindingExpr(current_bound, rhs)
					_:
						action = FlattenRewriteRebuildBindingExpr(
							rewrite_non_binding_expr(
								callable_rewrites,
								global_rewrites,
								current_bound,
								current,
							),
						)
			FlattenRewriteRebuildBindingExpr(rewritten):
				match frames:
					FlattenRewriteNoBindingFrame:
						result = rewritten
						complete = True
					FlattenRewriteMoreBindingFrames(frame, remaining):
						frames = remaining

						match frame:
							FlattenRewriteAssignFrame(original, rewritten_variable):
								action = FlattenRewriteRebuildBindingExpr(
									rebuilt_assign_names(
										original,
										rewritten_variable,
										rewritten,
									),
								)
							FlattenRewriteLetRhsFrame(original, body_bound):
								match original:
									LetExpr(_, _, _, _, body):
										frames = FlattenRewriteMoreBindingFrames(
											FlattenRewriteLetBodyFrame(original, rewritten),
											frames,
										)
										action = FlattenRewriteVisitBindingExpr(body_bound, body)
									_:
										action = FlattenRewriteRebuildBindingExpr(rewritten)
							FlattenRewriteLetBodyFrame(original, rewritten_rhs):
								action = FlattenRewriteRebuildBindingExpr(
									rebuilt_let_names(
										original,
										rewritten_rhs,
										rewritten,
									),
								)
							FlattenRewriteBorrowLetRhsFrame(original, body_bound):
								match original:
									BorrowLetExpr(_, _, _, body):
										frames = FlattenRewriteMoreBindingFrames(
											FlattenRewriteBorrowLetBodyFrame(original, rewritten),
											frames,
										)
										action = FlattenRewriteVisitBindingExpr(body_bound, body)
									_:
										action = FlattenRewriteRebuildBindingExpr(rewritten)
							FlattenRewriteBorrowLetBodyFrame(original, rewritten_rhs):
								action = FlattenRewriteRebuildBindingExpr(
									rebuilt_borrow_let_names(
										original,
										rewritten_rhs,
										rewritten,
									),
								)

	result


private pure func rebuilt_assign_names(
	original: CoreExpr,
	rewritten_variable: Option[CoreVar],
	rewritten_rhs: CoreExpr,
) -> CoreExpr:
	match original:
		AssignExpr(variable, rhs, typ, loc):
			if rewritten_variable.is_none() and same_core_expr(rewritten_rhs, rhs):
				original
			else:
				AssignExpr(
					rewritten_variable.get_or(variable),
					rewritten_rhs,
					typ,
					loc,
				)
		_:
			original


private pure func rebuilt_let_names(
	original: CoreExpr,
	rewritten_rhs: CoreExpr,
	rewritten_body: CoreExpr,
) -> CoreExpr:
	match original:
		LetExpr(variable, is_mutable, typ, rhs, body):
			if same_core_expr(rewritten_rhs, rhs) and same_core_expr(rewritten_body, body):
				original
			else:
				LetExpr(variable, is_mutable, typ, rewritten_rhs, rewritten_body)
		_:
			original


private pure func rebuilt_borrow_let_names(
	original: CoreExpr,
	rewritten_rhs: CoreExpr,
	rewritten_body: CoreExpr,
) -> CoreExpr:
	match original:
		BorrowLetExpr(variable, typ, rhs, body):
			if same_core_expr(rewritten_rhs, rhs) and same_core_expr(rewritten_body, body):
				original
			else:
				BorrowLetExpr(variable, typ, rewritten_rhs, rewritten_body)
		_:
			original


private pure func rewrite_function_body(
	module_name: String,
	callable_rewrites: List[CallableRewrite],
	global_rewrites: List[GlobalRewrite],
	function_info: CoreFunction,
) -> CoreFunction:
	bound = bound_with_params([], function_info.params)
	{ function_info |
		source_module = Some(module_name),
		body = function_info.body.map(
			func(body): rewrite_expr(callable_rewrites, global_rewrites, bound, body),
		)
	}


private pure func rewrite_top_level_function(
	module_name: String,
	callable_rewrites: List[CallableRewrite],
	global_rewrites: List[GlobalRewrite],
	function_info: CoreFunction,
) -> CoreFunction:
	rewritten: CoreFunction = rewrite_function_body(
		module_name,
		callable_rewrites,
		global_rewrites,
		function_info,
	)

	match find_callable_rewrite(callable_rewrites, function_info.name, function_info.def_id):
		Some(rewrite):
			{ rewritten | name = rewrite.target_name }
		None:
			rewritten


private pure func rewrite_global(
	module_name: String,
	callable_rewrites: List[CallableRewrite],
	global_rewrites: List[GlobalRewrite],
	global: CoreGlobal,
) -> CoreGlobal:
	{ global |
		source_module = Some(module_name),
		name = rewrite_global_var(global_rewrites, global.name).get_or(global.name),
		init = rewrite_expr(callable_rewrites, global_rewrites, [], global.init)
	}


private pure func rewrite_impl(
	module_name: String,
	callable_rewrites: List[CallableRewrite],
	global_rewrites: List[GlobalRewrite],
	impl_decl: CoreImplDecl,
) -> CoreImplDecl:
	{ impl_decl |
		methods = impl_decl.methods.map(
			func(
				method,
			): rewrite_function_body(module_name, callable_rewrites, global_rewrites, method),
		)
	}


private pure func module_type_name(
	module_prefix: String,
	source_name: String,
	abi_type: Option[DeclaredAbiType],
) -> String:
	match abi_type:
		Some(accepted_abi_type):
			declared_abi_type_name(accepted_abi_type)
		None:
			core_module_member_name_from_prefix(module_prefix, source_name)


private pure func local_type_rewrite(
	module_prefix: String,
	source_name: String,
	abi_type: Option[DeclaredAbiType],
) -> CoreTypeNameRewrite:
	{
		source_name = source_name,
		target_name = module_type_name(module_prefix, source_name, abi_type)
	}


private pure func collect_local_type_rewrites(
	module_prefix: String,
	program: CoreProgram,
) -> List[CoreTypeNameRewrite]:
	program.decls.filter_map(func(decl):
		match decl:
			EnumDecl(enum_decl):
				Some(local_type_rewrite(module_prefix, enum_decl.name, enum_decl.abi_type))
			UnionDecl(union_decl):
				Some(local_type_rewrite(module_prefix, union_decl.name, union_decl.abi_type))
			ValueRecordDecl(record_decl):
				Some(local_type_rewrite(module_prefix, record_decl.name, record_decl.abi_type))
			HeapRecordDecl(record_decl):
				Some(local_type_rewrite(module_prefix, record_decl.name, record_decl.abi_type))
			TypeAliasDecl(alias_decl):
				Some(local_type_rewrite(module_prefix, alias_decl.name, alias_decl.abi_type))
			_:
				None
	)


-- `None` means the name is already spelled the way Core wants it, which is the
-- overwhelming majority: the canonical form only differs for a `module::Type`
-- identity, and the rewrite table only covers types this module renames.
private pure func rewritten_type_name(
	context: CoreTypeRewriteContext,
	name: String,
) -> Option[String]:
	canonical_name: String = flatten_canonical_core_type_name(name)

	if canonical_name != name:
		Some(canonical_name)
	else:
		var target_name: Option[String] = None

		for rewrite in context.rewrites:
			if rewrite.source_name == name:
				target_name = Some(rewrite.target_name)
				break

		target_name


private pure func rewrite_core_type(
	context: CoreTypeRewriteContext,
	typ: CoreType,
) -> Option[CoreType]:
	match typ:
		VoidType | SelfType | RangeType:
			None
		NamedType(name, args):
			rewritten_name: Option[String] = rewritten_type_name(context, name)
			rewritten_args: Option[List[CoreType]] = rewrite_list_items(
				args,
				func(arg): rewrite_core_type(context, arg),
			)

			if rewritten_name.is_none() and rewritten_args.is_none():
				None
			else:
				Some(NamedType(rewritten_name.get_or(name), rewritten_args.get_or(args)))
		TypeParameterType(_):
			None
		FunctionType(is_pure, params, return_type):
			rewritten_params: Option[List[CoreType]] = rewrite_list_items(
				params,
				func(param): rewrite_core_type(context, param),
			)
			rewritten_return: Option[CoreType] = rewrite_core_type(context, return_type)

			if rewritten_params.is_none() and rewritten_return.is_none():
				None
			else:
				Some(
					FunctionType(
						is_pure,
						rewritten_params.get_or(params),
						rewritten_return.get_or(return_type),
					),
				)
		StackResultType(value_type, error_type):
			rewritten_value: Option[CoreType] = rewrite_core_type(context, value_type)
			rewritten_error: Option[CoreType] = rewrite_core_type(context, error_type)

			if rewritten_value.is_none() and rewritten_error.is_none():
				None
			else:
				Some(
					StackResultType(
						rewritten_value.get_or(value_type),
						rewritten_error.get_or(error_type),
					),
				)
		BoxedResultType(value_type, error_type):
			rewritten_value: Option[CoreType] = rewrite_core_type(context, value_type)
			rewritten_error: Option[CoreType] = rewrite_core_type(context, error_type)

			if rewritten_value.is_none() and rewritten_error.is_none():
				None
			else:
				Some(
					BoxedResultType(
						rewritten_value.get_or(value_type),
						rewritten_error.get_or(error_type),
					),
				)
		EnumType(name):
			rewritten_type_name(context, name).map(func(rewritten): EnumType(rewritten))
		ValueRecordType(name):
			rewritten_type_name(context, name).map(func(rewritten): ValueRecordType(rewritten))
		HeapRecordType(name):
			rewritten_type_name(context, name).map(func(rewritten): HeapRecordType(rewritten))
		UnionType(name):
			rewritten_type_name(context, name).map(func(rewritten): UnionType(rewritten))
		TensorType(info):
			rewrite_core_type(
				context,
				info.element_type,
			).map(
				func(rewritten): TensorType({ info | element_type = rewritten }),
			)
		TupleType(elements):
			rewrite_list_items(
				elements,
				func(
					element,
				): rewrite_core_type(context, element),
			).map(
				func(rewritten): TupleType(rewritten),
			)


private pure func rewrite_param_type(
	context: CoreTypeRewriteContext,
	param: CoreParam,
) -> Option[CoreParam]:
	rewrite_core_type(context, param.typ).map(func(rewritten): { param | typ = rewritten })


private pure func rewrite_loop_binder_type(
	context: CoreTypeRewriteContext,
	binder: CoreLoopBinder,
) -> Option[CoreLoopBinder]:
	rewrite_core_type(context, binder.typ).map(func(rewritten): { binder | typ = rewritten })


private pure func rewrite_select_arm_types(
	context: CoreTypeRewriteContext,
	arm: CoreSelectArm,
) -> Option[CoreSelectArm]:
	match arm.kind:
		SelectRecvArm(recv):
			rewrite_core_type(
				context,
				recv.elem_type,
			).map(
				func(rewritten): { arm | kind = SelectRecvArm({ recv | elem_type = rewritten }) },
			)
		_:
			None


private pure func rewrite_concurrent_item_mode_types(
	context: CoreTypeRewriteContext,
	mode: CoreConcurrentlyLoopItemMode,
) -> Option[CoreConcurrentlyLoopItemMode]:
	match mode:
		ConcurrentlyLoopMoveResourceItem(item):
			rewritten_resource: Option[CoreType] = rewrite_core_type(context, item.resource_type)
			rewritten_error: Option[CoreType] = rewrite_core_type(context, item.error_type)

			if rewritten_resource.is_none() and rewritten_error.is_none():
				None
			else:
				Some(ConcurrentlyLoopMoveResourceItem({
					resource_type = rewritten_resource.get_or(item.resource_type),
					error_type = rewritten_error.get_or(item.error_type),
				}))
		_:
			None


-- Answers `None` when no type on this node changed, so the caller keeps the
-- node it already has. Children are not this function's business: the callers
-- below map those first and hand the mapped node in.
--
-- The arms are grouped into the three functions below rather than written as
-- one exhaustive match, because a match over every CoreExpr variant emits a C
-- frame holding the temporaries of every arm at once, and the arms here each
-- need a local for the mapped type. This dispatcher itself binds nothing.
private pure func rewrite_expr_node_types(
	context: CoreTypeRewriteContext,
	rewritten: CoreExpr,
) -> Option[CoreExpr]:
	match rewritten:
		LiteralExpr(_, _, _) | VarExpr(_, _, _) | VoidExpr(_, _) | BreakExpr(_, _) | ContinueExpr(_, _) | CallExpr(_, _, _, _, _) | BinaryExpr(_, _, _, _, _) | UnaryExpr(_, _, _, _) | LogicalExpr(_, _, _, _, _) | AssignExpr(_, _, _, _) | FieldExpr(_, _, _, _) | TupleFieldExpr(_, _, _, _) | LetExpr(_, _, _, _, _) | BorrowLetExpr(_, _, _, _) | PreClosureDetachExpr(_, _, _) | RangeExpr(_, _, _, _) | IfExpr(_, _, _, _, _) | WhileExpr(_, _, _, _):
			rewrite_operator_node_types(context, rewritten)
		TupleExpr(_, _, _) | VectorExpr(_, _, _) | ListConstructExpr(_, _, _) | DictExpr(_, _, _) | RecordExpr(_, _, _) | RecordUpdateExpr(_, _, _, _) | RecordReuseExpr(_, _, _, _) | TensorRawViewLetExpr(_, _, _, _) | RawMatchExpr(_, _, _, _) | LiteralMatchExpr(_, _, _, _, _) | ConstructorMatchExpr(_, _, _, _, _, _):
			rewrite_aggregate_node_types(context, rewritten)
		RecordCowUpdateExpr(_, _, _, _) | LambdaExpr(_, _, _, _, _, _) | ResourceScopeExpr(_, _, _) | ForRangeExpr(_, _, _, _, _, _) | ForChannelExpr(_, _, _) | ForListExpr(_, _, _) | ForStringExpr(_, _, _) | ForDictExpr(_, _, _) | ForSetExpr(_, _, _) | ForStreamExpr(_, _, _) | ForResourceSourceExpr(_, _, _) | ForTensorExpr(_, _, _) | PreClosureConcurrentlyLoopExpr(_, _, _) | PreClosureConcurrentExpr(_, _, _) | SelectExpr(_, _, _):
			rewrite_binder_node_types(context, rewritten)
		_:
			None


-- Variants whose only type-bearing field is the node's own result type.
private pure func rewrite_operator_node_types(
	context: CoreTypeRewriteContext,
	rewritten: CoreExpr,
) -> Option[CoreExpr]:
	match rewritten:
		LiteralExpr(literal, typ, loc):
			rewritten_type ?= rewrite_core_type(context, typ)
			Some(LiteralExpr(literal, rewritten_type, loc))
		VarExpr(variable, typ, loc):
			rewritten_type ?= rewrite_core_type(context, typ)
			Some(VarExpr(variable, rewritten_type, loc))
		VoidExpr(typ, loc):
			rewritten_type ?= rewrite_core_type(context, typ)
			Some(VoidExpr(rewritten_type, loc))
		BreakExpr(typ, loc):
			rewritten_type ?= rewrite_core_type(context, typ)
			Some(BreakExpr(rewritten_type, loc))
		ContinueExpr(typ, loc):
			rewritten_type ?= rewrite_core_type(context, typ)
			Some(ContinueExpr(rewritten_type, loc))
		CallExpr(kind, callee, args, typ, loc):
			rewritten_type ?= rewrite_core_type(context, typ)
			Some(CallExpr(kind, callee, args, rewritten_type, loc))
		BinaryExpr(op, left, right, typ, loc):
			rewritten_type ?= rewrite_core_type(context, typ)
			Some(BinaryExpr(op, left, right, rewritten_type, loc))
		UnaryExpr(op, value, typ, loc):
			rewritten_type ?= rewrite_core_type(context, typ)
			Some(UnaryExpr(op, value, rewritten_type, loc))
		LogicalExpr(op, left, right, typ, loc):
			rewritten_type ?= rewrite_core_type(context, typ)
			Some(LogicalExpr(op, left, right, rewritten_type, loc))
		AssignExpr(variable, rhs, typ, loc):
			rewritten_type ?= rewrite_core_type(context, typ)
			Some(AssignExpr(variable, rhs, rewritten_type, loc))
		FieldExpr(value, field_name, typ, loc):
			rewritten_type ?= rewrite_core_type(context, typ)
			Some(FieldExpr(value, field_name, rewritten_type, loc))
		TupleFieldExpr(value, field_index, typ, loc):
			rewritten_type ?= rewrite_core_type(context, typ)
			Some(TupleFieldExpr(value, field_index, rewritten_type, loc))
		LetExpr(variable, is_mutable, typ, rhs, body):
			rewritten_type ?= rewrite_core_type(context, typ)
			Some(LetExpr(variable, is_mutable, rewritten_type, rhs, body))
		BorrowLetExpr(variable, typ, rhs, body):
			rewritten_type ?= rewrite_core_type(context, typ)
			Some(BorrowLetExpr(variable, rewritten_type, rhs, body))
		PreClosureDetachExpr(detached, typ, loc):
			rewritten_type ?= rewrite_core_type(context, typ)
			Some(PreClosureDetachExpr(detached, rewritten_type, loc))
		RangeExpr(start, end_value, typ, loc):
			rewritten_type ?= rewrite_core_type(context, typ)
			Some(RangeExpr(start, end_value, rewritten_type, loc))
		IfExpr(cond, then_expr, else_expr, typ, loc):
			rewritten_type ?= rewrite_core_type(context, typ)
			Some(IfExpr(cond, then_expr, else_expr, rewritten_type, loc))
		WhileExpr(cond, body, typ, loc):
			rewritten_type ?= rewrite_core_type(context, typ)
			Some(WhileExpr(cond, body, rewritten_type, loc))
		_:
			None


-- Aggregates and match forms; their payloads carry expressions, which the
-- caller has already mapped, so again only the node's own type is at stake.
private pure func rewrite_aggregate_node_types(
	context: CoreTypeRewriteContext,
	rewritten: CoreExpr,
) -> Option[CoreExpr]:
	match rewritten:
		TupleExpr(items, typ, loc):
			rewritten_type ?= rewrite_core_type(context, typ)
			Some(TupleExpr(items, rewritten_type, loc))
		VectorExpr(items, typ, loc):
			rewritten_type ?= rewrite_core_type(context, typ)
			Some(VectorExpr(items, rewritten_type, loc))
		ListConstructExpr(construct, typ, loc):
			rewritten_type ?= rewrite_core_type(context, typ)
			Some(ListConstructExpr(construct, rewritten_type, loc))
		DictExpr(entries, typ, loc):
			rewritten_type ?= rewrite_core_type(context, typ)
			Some(DictExpr(entries, rewritten_type, loc))
		RecordExpr(fields, typ, loc):
			rewritten_type ?= rewrite_core_type(context, typ)
			Some(RecordExpr(fields, rewritten_type, loc))
		RecordUpdateExpr(base, fields, typ, loc):
			rewritten_type ?= rewrite_core_type(context, typ)
			Some(RecordUpdateExpr(base, fields, rewritten_type, loc))
		RecordReuseExpr(source, fields, typ, loc):
			rewritten_type ?= rewrite_core_type(context, typ)
			Some(RecordReuseExpr(source, fields, rewritten_type, loc))
		TensorRawViewLetExpr(binding, body, typ, loc):
			rewritten_type ?= rewrite_core_type(context, typ)
			Some(TensorRawViewLetExpr(binding, body, rewritten_type, loc))
		RawMatchExpr(scrutinee, cases, typ, loc):
			rewritten_type ?= rewrite_core_type(context, typ)
			Some(RawMatchExpr(scrutinee, cases, rewritten_type, loc))
		LiteralMatchExpr(scrutinee, cases, fallback, typ, loc):
			rewritten_type ?= rewrite_core_type(context, typ)
			Some(LiteralMatchExpr(scrutinee, cases, fallback, rewritten_type, loc))
		ConstructorMatchExpr(scrutinee, policy, cases, fallback, typ, loc):
			rewritten_type ?= rewrite_core_type(context, typ)
			Some(ConstructorMatchExpr(scrutinee, policy, cases, fallback, rewritten_type, loc))
		_:
			None


-- Variants that carry type-bearing payload of their own: loop binders, lambda
-- parameters, resource-scope and concurrency types, select element types, and
-- copy-on-write field types. Each answers `None` only when neither the payload
-- nor the node's own type changed.
private pure func rewrite_binder_node_types(
	context: CoreTypeRewriteContext,
	rewritten: CoreExpr,
) -> Option[CoreExpr]:
	match rewritten:
		RecordCowUpdateExpr(source, fields, typ, loc):
			rewritten_fields: List[CoreRecordCowField] = CoreTraverse.map_core_record_cow_fields_with_types(
				fields,
				func(replacement): replacement,
				func(field_type): rewrite_core_type(context, field_type).get_or(field_type),
			)
			rewritten_type: Option[CoreType] = rewrite_core_type(context, typ)

			if same_core_record_cow_fields(rewritten_fields, fields) and rewritten_type.is_none():
				None
			else:
				Some(RecordCowUpdateExpr(source, rewritten_fields, rewritten_type.get_or(typ), loc))
		LambdaExpr(params, return_type, body, is_pure, typ, loc):
			rewritten_params: Option[List[CoreParam]] = rewrite_list_items(
				params,
				func(param): rewrite_param_type(context, param),
			)
			rewritten_return: Option[CoreType] = rewrite_core_type(context, return_type)
			rewritten_type: Option[CoreType] = rewrite_core_type(context, typ)

			if (
				rewritten_params.is_none()
				and rewritten_return.is_none()
				and rewritten_type.is_none()
			):
				None
			else:
				Some(
					LambdaExpr(
						rewritten_params.get_or(params),
						rewritten_return.get_or(return_type),
						body,
						is_pure,
						rewritten_type.get_or(typ),
						loc,
					),
				)
		ResourceScopeExpr(scope, typ, loc):
			rewritten_scope_type: Option[CoreType] = rewrite_core_type(context, scope.typ)
			rewritten_type: Option[CoreType] = rewrite_core_type(context, typ)

			if rewritten_scope_type.is_none() and rewritten_type.is_none():
				None
			else:
				Some(
					ResourceScopeExpr(
						rewritten_scope_type
							.map(func(scope_type): { scope | typ = scope_type })
							.get_or(scope),
						rewritten_type.get_or(typ),
						loc,
					),
				)
		ForRangeExpr(binder, start, end_value, body, typ, loc):
			rewritten_binder: Option[CoreLoopBinder] = rewrite_loop_binder_type(context, binder)
			rewritten_type: Option[CoreType] = rewrite_core_type(context, typ)

			if rewritten_binder.is_none() and rewritten_type.is_none():
				None
			else:
				Some(
					ForRangeExpr(
						rewritten_binder.get_or(binder),
						start,
						end_value,
						body,
						rewritten_type.get_or(typ),
						loc,
					),
				)
		ForChannelExpr(_, _, _) | ForListExpr(_, _, _) | ForStringExpr(_, _, _) | ForDictExpr(_, _, _) | ForSetExpr(_, _, _) | ForStreamExpr(_, _, _) | ForResourceSourceExpr(_, _, _) | ForTensorExpr(_, _, _):
			rewrite_iterable_loop_node_types(context, rewritten)
		PreClosureConcurrentlyLoopExpr(loop, typ, loc):
			rewritten_item_type: Option[CoreType] = rewrite_core_type(context, loop.item_type)
			rewritten_item_mode: Option[CoreConcurrentlyLoopItemMode] = rewrite_concurrent_item_mode_types(
				context,
				loop.item_mode,
			)
			rewritten_type: Option[CoreType] = rewrite_core_type(context, typ)

			if (
				rewritten_item_type.is_none()
				and rewritten_item_mode.is_none()
				and rewritten_type.is_none()
			):
				None
			else:
				Some(
					PreClosureConcurrentlyLoopExpr(
						{ loop |
							item_type = rewritten_item_type.get_or(loop.item_type),
							item_mode = rewritten_item_mode.get_or(loop.item_mode)
						},
						rewritten_type.get_or(typ),
						loc,
					),
				)
		PreClosureConcurrentExpr(block, typ, loc):
			rewritten_bindings: Option[List[CorePreClosureConcurrentBinding]] = rewrite_list_items(
				block.bindings,
				func(
					binding,
				): rewrite_core_type(
					context,
					binding.typ,
				).map(
					func(binding_type): { binding | typ = binding_type },
				),
			)
			rewritten_type: Option[CoreType] = rewrite_core_type(context, typ)

			if rewritten_bindings.is_none() and rewritten_type.is_none():
				None
			else:
				Some(
					PreClosureConcurrentExpr(
						rewritten_bindings
							.map(func(bindings): { block | bindings = bindings })
							.get_or(block),
						rewritten_type.get_or(typ),
						loc,
					),
				)
		SelectExpr(arms, typ, loc):
			rewritten_arms: Option[List[CoreSelectArm]] = rewrite_list_items(
				arms,
				func(arm): rewrite_select_arm_types(context, arm),
			)
			rewritten_type: Option[CoreType] = rewrite_core_type(context, typ)

			if rewritten_arms.is_none() and rewritten_type.is_none():
				None
			else:
				Some(SelectExpr(rewritten_arms.get_or(arms), rewritten_type.get_or(typ), loc))
		_:
			None


-- The eight iterable loops share one shape: a binder type and the loop's own
-- result type.
private pure func rewrite_iterable_loop_node_types(
	context: CoreTypeRewriteContext,
	rewritten: CoreExpr,
) -> Option[CoreExpr]:
	match rewritten:
		ForChannelExpr(loop, typ, loc):
			rewritten_binder: Option[CoreLoopBinder] = rewrite_loop_binder_type(
				context,
				loop.binder,
			)
			rewritten_type: Option[CoreType] = rewrite_core_type(context, typ)

			if rewritten_binder.is_none() and rewritten_type.is_none():
				None
			else:
				Some(
					ForChannelExpr(
						rewritten_binder
							.map(func(binder): { loop | binder = binder })
							.get_or(loop),
						rewritten_type.get_or(typ),
						loc,
					),
				)
		ForListExpr(loop, typ, loc):
			rewritten_binder: Option[CoreLoopBinder] = rewrite_loop_binder_type(
				context,
				loop.binder,
			)
			rewritten_type: Option[CoreType] = rewrite_core_type(context, typ)

			if rewritten_binder.is_none() and rewritten_type.is_none():
				None
			else:
				Some(
					ForListExpr(
						rewritten_binder
							.map(func(binder): { loop | binder = binder })
							.get_or(loop),
						rewritten_type.get_or(typ),
						loc,
					),
				)
		ForStringExpr(loop, typ, loc):
			rewritten_binder: Option[CoreLoopBinder] = rewrite_loop_binder_type(
				context,
				loop.binder,
			)
			rewritten_type: Option[CoreType] = rewrite_core_type(context, typ)

			if rewritten_binder.is_none() and rewritten_type.is_none():
				None
			else:
				Some(
					ForStringExpr(
						rewritten_binder
							.map(func(binder): { loop | binder = binder })
							.get_or(loop),
						rewritten_type.get_or(typ),
						loc,
					),
				)
		ForDictExpr(loop, typ, loc):
			rewritten_binder: Option[CoreLoopBinder] = rewrite_loop_binder_type(
				context,
				loop.binder,
			)
			rewritten_type: Option[CoreType] = rewrite_core_type(context, typ)

			if rewritten_binder.is_none() and rewritten_type.is_none():
				None
			else:
				Some(
					ForDictExpr(
						rewritten_binder
							.map(func(binder): { loop | binder = binder })
							.get_or(loop),
						rewritten_type.get_or(typ),
						loc,
					),
				)
		ForSetExpr(loop, typ, loc):
			rewritten_binder: Option[CoreLoopBinder] = rewrite_loop_binder_type(
				context,
				loop.binder,
			)
			rewritten_type: Option[CoreType] = rewrite_core_type(context, typ)

			if rewritten_binder.is_none() and rewritten_type.is_none():
				None
			else:
				Some(
					ForSetExpr(
						rewritten_binder
							.map(func(binder): { loop | binder = binder })
							.get_or(loop),
						rewritten_type.get_or(typ),
						loc,
					),
				)
		ForStreamExpr(loop, typ, loc):
			rewritten_binder: Option[CoreLoopBinder] = rewrite_loop_binder_type(
				context,
				loop.binder,
			)
			rewritten_type: Option[CoreType] = rewrite_core_type(context, typ)

			if rewritten_binder.is_none() and rewritten_type.is_none():
				None
			else:
				Some(
					ForStreamExpr(
						rewritten_binder
							.map(func(binder): { loop | binder = binder })
							.get_or(loop),
						rewritten_type.get_or(typ),
						loc,
					),
				)
		ForResourceSourceExpr(loop, typ, loc):
			rewritten_binder: Option[CoreLoopBinder] = rewrite_loop_binder_type(
				context,
				loop.binder,
			)
			rewritten_type: Option[CoreType] = rewrite_core_type(context, typ)

			if rewritten_binder.is_none() and rewritten_type.is_none():
				None
			else:
				Some(
					ForResourceSourceExpr(
						rewritten_binder
							.map(func(binder): { loop | binder = binder })
							.get_or(loop),
						rewritten_type.get_or(typ),
						loc,
					),
				)
		ForTensorExpr(loop, typ, loc):
			rewritten_binder: Option[CoreLoopBinder] = rewrite_loop_binder_type(
				context,
				loop.binder,
			)
			rewritten_type: Option[CoreType] = rewrite_core_type(context, typ)

			if rewritten_binder.is_none() and rewritten_type.is_none():
				None
			else:
				Some(
					ForTensorExpr(
						rewritten_binder
							.map(func(binder): { loop | binder = binder })
							.get_or(loop),
						rewritten_type.get_or(typ),
						loc,
					),
				)
		_:
			None


private pure func rewrite_non_binding_expr_types(
	context: CoreTypeRewriteContext,
	expr: CoreExpr,
) -> CoreExpr:
	match expr:
		SeqExpr(_, _):
			CoreTraverse.map_core_sequence_items(
				expr,
				pure func(item): rewrite_expr_types(context, item),
			)
		LogicalExpr(_, _, _, _, _):
			rewrite_logical_expr_types(context, expr)
		_:
			-- The child mapper already answers the same allocation when no child
			-- changed, so an unchanged node here means nothing below it moved
			-- either and the input can be handed straight back.
			mapped_children: CoreExpr = CoreTraverse.map_core_expr_children_with_context(
				expr,
				context,
				rewrite_expr_types,
			)

			match rewrite_expr_node_types(context, mapped_children):
				Some(rewritten):
					rewritten
				None:
					mapped_children


private pure func rewrite_logical_expr_types(
	context: CoreTypeRewriteContext,
	expr: CoreExpr,
) -> CoreExpr:
	-- Logical chains are left-associated and can contain thousands of nodes in
	-- generated suites. Preserve left-before-right postorder without consuming
	-- one large generic-mapper stack frame per operator.
	var frames: CoreTypeRewriteLogicalFrameStack = CoreTypeRewriteLogicalNoFrame
	var action: CoreTypeRewriteLogicalAction = CoreTypeRewriteLogicalVisitExpr(expr)
	var result: CoreExpr = expr
	var complete: Bool = False

	while not complete:
		match action:
			CoreTypeRewriteLogicalVisitExpr(current):
				match current:
					LogicalExpr(_, left, _, _, _):
						frames = CoreTypeRewriteLogicalMoreFrames(
							CoreTypeRewriteLogicalVisitRightFrame(current),
							frames,
						)
						action = CoreTypeRewriteLogicalVisitExpr(left)
					_:
						action = CoreTypeRewriteLogicalRebuildExpr(
							rewrite_expr_types(
								context,
								current,
							),
						)
			CoreTypeRewriteLogicalRebuildExpr(rewritten):
				match frames:
					CoreTypeRewriteLogicalNoFrame:
						result = rewritten
						complete = True
					CoreTypeRewriteLogicalMoreFrames(frame, remaining):
						frames = remaining

						match frame:
							CoreTypeRewriteLogicalVisitRightFrame(original):
								match original:
									LogicalExpr(_, _, right, _, _):
										frames = CoreTypeRewriteLogicalMoreFrames(
											CoreTypeRewriteLogicalRebuildParentFrame(
												original,
												rewritten,
											),
											frames,
										)
										action = CoreTypeRewriteLogicalVisitExpr(right)
									_:
										action = CoreTypeRewriteLogicalRebuildExpr(rewritten)
							CoreTypeRewriteLogicalRebuildParentFrame(original, rewritten_left):
								action = CoreTypeRewriteLogicalRebuildExpr(
									rebuilt_logical_types(
										context,
										original,
										rewritten_left,
										rewritten,
									),
								)

	result


private pure func rewrite_expr_types(context: CoreTypeRewriteContext, expr: CoreExpr) -> CoreExpr:
	-- Source blocks create deep right-associated binding spines. Traverse their
	-- two-child post-order shape explicitly so neither the binding depth nor the
	-- generic Core child mapper consumes recursive stack.
	var frames: CoreTypeRewriteBindingFrameStack = CoreTypeRewriteNoBindingFrame
	var action: CoreTypeRewriteBindingAction = CoreTypeRewriteVisitBindingExpr(expr)
	var result: CoreExpr = expr
	var complete: Bool = False

	while not complete:
		match action:
			CoreTypeRewriteVisitBindingExpr(current):
				match current:
					AssignExpr(_, rhs, _, _):
						frames = CoreTypeRewriteMoreBindingFrames(
							CoreTypeRewriteAssignFrame(current),
							frames,
						)
						action = CoreTypeRewriteVisitBindingExpr(rhs)
					LetExpr(_, _, _, rhs, _):
						frames = CoreTypeRewriteMoreBindingFrames(
							CoreTypeRewriteLetRhsFrame(current),
							frames,
						)
						action = CoreTypeRewriteVisitBindingExpr(rhs)
					BorrowLetExpr(_, _, rhs, _):
						frames = CoreTypeRewriteMoreBindingFrames(
							CoreTypeRewriteBorrowLetRhsFrame(current),
							frames,
						)
						action = CoreTypeRewriteVisitBindingExpr(rhs)
					_:
						action = CoreTypeRewriteRebuildBindingExpr(
							rewrite_non_binding_expr_types(
								context,
								current,
							),
						)
			CoreTypeRewriteRebuildBindingExpr(rewritten):
				match frames:
					CoreTypeRewriteNoBindingFrame:
						result = rewritten
						complete = True
					CoreTypeRewriteMoreBindingFrames(frame, remaining):
						frames = remaining

						match frame:
							CoreTypeRewriteAssignFrame(original):
								action = CoreTypeRewriteRebuildBindingExpr(
									rebuilt_assign_types(
										context,
										original,
										rewritten,
									),
								)
							CoreTypeRewriteLetRhsFrame(original):
								match original:
									LetExpr(_, _, _, _, body):
										frames = CoreTypeRewriteMoreBindingFrames(
											CoreTypeRewriteLetBodyFrame(original, rewritten),
											frames,
										)
										action = CoreTypeRewriteVisitBindingExpr(body)
									_:
										action = CoreTypeRewriteRebuildBindingExpr(rewritten)
							CoreTypeRewriteLetBodyFrame(original, rewritten_rhs):
								action = CoreTypeRewriteRebuildBindingExpr(
									rebuilt_let_types(
										context,
										original,
										rewritten_rhs,
										rewritten,
									),
								)
							CoreTypeRewriteBorrowLetRhsFrame(original):
								match original:
									BorrowLetExpr(_, _, _, body):
										frames = CoreTypeRewriteMoreBindingFrames(
											CoreTypeRewriteBorrowLetBodyFrame(original, rewritten),
											frames,
										)
										action = CoreTypeRewriteVisitBindingExpr(body)
									_:
										action = CoreTypeRewriteRebuildBindingExpr(rewritten)
							CoreTypeRewriteBorrowLetBodyFrame(original, rewritten_rhs):
								action = CoreTypeRewriteRebuildBindingExpr(
									rebuilt_borrow_let_types(
										context,
										original,
										rewritten_rhs,
										rewritten,
									),
								)

	result


private pure func rebuilt_logical_types(
	context: CoreTypeRewriteContext,
	original: CoreExpr,
	rewritten_left: CoreExpr,
	rewritten_right: CoreExpr,
) -> CoreExpr:
	match original:
		LogicalExpr(op, left, right, typ, loc):
			rewritten_type: Option[CoreType] = rewrite_core_type(context, typ)

			if (
				same_core_expr(rewritten_left, left)
				and same_core_expr(rewritten_right, right)
				and rewritten_type.is_none()
			):
				original
			else:
				LogicalExpr(
					op,
					rewritten_left,
					rewritten_right,
					rewritten_type.get_or(typ),
					loc,
				)
		_:
			original


private pure func rebuilt_assign_types(
	context: CoreTypeRewriteContext,
	original: CoreExpr,
	rewritten_rhs: CoreExpr,
) -> CoreExpr:
	match original:
		AssignExpr(variable, rhs, typ, loc):
			rewritten_type: Option[CoreType] = rewrite_core_type(context, typ)

			if same_core_expr(rewritten_rhs, rhs) and rewritten_type.is_none():
				original
			else:
				AssignExpr(
					variable,
					rewritten_rhs,
					rewritten_type.get_or(typ),
					loc,
				)
		_:
			original


private pure func rebuilt_let_types(
	context: CoreTypeRewriteContext,
	original: CoreExpr,
	rewritten_rhs: CoreExpr,
	rewritten_body: CoreExpr,
) -> CoreExpr:
	match original:
		LetExpr(variable, is_mutable, typ, rhs, body):
			rewritten_type: Option[CoreType] = rewrite_core_type(context, typ)

			if (
				same_core_expr(rewritten_rhs, rhs)
				and same_core_expr(rewritten_body, body)
				and rewritten_type.is_none()
			):
				original
			else:
				LetExpr(
					variable,
					is_mutable,
					rewritten_type.get_or(typ),
					rewritten_rhs,
					rewritten_body,
				)
		_:
			original


private pure func rebuilt_borrow_let_types(
	context: CoreTypeRewriteContext,
	original: CoreExpr,
	rewritten_rhs: CoreExpr,
	rewritten_body: CoreExpr,
) -> CoreExpr:
	match original:
		BorrowLetExpr(variable, typ, rhs, body):
			rewritten_type: Option[CoreType] = rewrite_core_type(context, typ)

			if (
				same_core_expr(rewritten_rhs, rhs)
				and same_core_expr(rewritten_body, body)
				and rewritten_type.is_none()
			):
				original
			else:
				BorrowLetExpr(
					variable,
					rewritten_type.get_or(typ),
					rewritten_rhs,
					rewritten_body,
				)
		_:
			original


private pure func rewrite_function_types(
	context: CoreTypeRewriteContext,
	function_info: CoreFunction,
) -> CoreFunction:
	{ function_info |
		params = rewrite_list_items(
			function_info.params,
			func(param): rewrite_param_type(context, param),
		).get_or(function_info.params),
		return_type = rewrite_core_type(
			context,
			function_info.return_type,
		).get_or(function_info.return_type),
		body = function_info.body.map(func(body): rewrite_expr_types(context, body))
	}


private pure func rewrite_trait_method_types(
	context: CoreTypeRewriteContext,
	method: CoreTraitMethod,
) -> CoreTraitMethod:
	{ method |
		params = rewrite_list_items(
			method.params,
			func(param): rewrite_param_type(context, param),
		).get_or(method.params),
		return_type = rewrite_core_type(context, method.return_type).get_or(method.return_type)
	}


private pure func rewrite_decl_types(context: CoreTypeRewriteContext, decl: CoreDecl) -> CoreDecl:
	match decl:
		FunctionDecl(function_info):
			FunctionDecl(rewrite_function_types(context, function_info))
		GlobalDecl(global):
			GlobalDecl({ global |
					typ = rewrite_core_type(context, global.typ).get_or(global.typ),
					init = rewrite_expr_types(context, global.init)
				})
		EnumDecl(_):
			decl
		UnionDecl(union_decl):
			UnionDecl(
				{ union_decl |
					variants = union_decl.variants.map(
						func(
							variant,
						): { variant |
							fields = variant.fields.map(
								func(
									field,
								): { field |
									typ = rewrite_core_type(context, field.typ).get_or(field.typ)
								},
							)
						},
					)
				},
			)
		ValueRecordDecl(record_decl):
			ValueRecordDecl(
				{ record_decl |
					fields = record_decl.fields.map(
						func(
							field,
						): { field |
							typ = rewrite_core_type(context, field.typ).get_or(field.typ)
						},
					)
				},
			)
		HeapRecordDecl(record_decl):
			HeapRecordDecl(
				{ record_decl |
					fields = record_decl.fields.map(
						func(
							field,
						): { field |
							typ = rewrite_core_type(context, field.typ).get_or(field.typ)
						},
					)
				},
			)
		TypeAliasDecl(alias_decl):
			TypeAliasDecl(
				{ alias_decl |
					target = rewrite_core_type(context, alias_decl.target).get_or(alias_decl.target)
				},
			)
		TraitDecl(trait_decl):
			TraitDecl(
				{ trait_decl |
					methods = trait_decl.methods.map(
						func(method): rewrite_trait_method_types(context, method),
					)
				},
			)
		ImplDecl(impl_decl):
			ImplDecl({ impl_decl |
					for_type = rewrite_core_type(
						context,
						impl_decl.for_type,
					).get_or(impl_decl.for_type),
					methods = impl_decl.methods.map(
						func(method): rewrite_function_types(context, method),
					)
				})


private pure func union_tag_c_name(type_name: String, variant_name: String) -> String:
	"TAG_" + type_name + "_" + variant_name


private pure func rewrite_decl(
	module_name: String,
	module_prefix: String,
	callable_rewrites: List[CallableRewrite],
	global_rewrites: List[GlobalRewrite],
	decl: CoreDecl,
) -> CoreDecl:
	match decl:
		FunctionDecl(function_info):
			FunctionDecl(
				rewrite_top_level_function(
					module_name,
					callable_rewrites,
					global_rewrites,
					function_info,
				),
			)
		GlobalDecl(global):
			GlobalDecl(rewrite_global(module_name, callable_rewrites, global_rewrites, global))
		ImplDecl(impl_decl):
			ImplDecl(rewrite_impl(module_name, callable_rewrites, global_rewrites, impl_decl))
		EnumDecl(enum_decl):
			EnumDecl(
				{ enum_decl |
					name = module_type_name(module_prefix, enum_decl.name, enum_decl.abi_type)
				},
			)
		UnionDecl(union_decl):
			target_name = module_type_name(module_prefix, union_decl.name, union_decl.abi_type)
			UnionDecl({ union_decl |
					name = target_name,
					variants = union_decl.variants.map(
						func(
							variant,
						): { variant | tag_c_name = union_tag_c_name(target_name, variant.name) },
					)
				})
		ValueRecordDecl(record_decl):
			ValueRecordDecl(
				{ record_decl |
					name = module_type_name(module_prefix, record_decl.name, record_decl.abi_type)
				},
			)
		HeapRecordDecl(record_decl):
			HeapRecordDecl(
				{ record_decl |
					name = module_type_name(module_prefix, record_decl.name, record_decl.abi_type)
				},
			)
		TypeAliasDecl(alias_decl):
			TypeAliasDecl(
				{ alias_decl |
					name = module_type_name(module_prefix, alias_decl.name, alias_decl.abi_type)
				},
			)
		TraitDecl(_):
			decl


-- Whether some declaration in `decls` implements each function name, keyed by
-- the same name string `deduplicate_functions` compares on. Built once per
-- call so admitting a forward declaration never rescans the full declaration
-- list; a name absent from this index has no implementation anywhere.
private pure func index_implemented_function_names(decls: List[CoreDecl]) -> Dict[String, Bool]:
	var implemented: Dict[String, Bool] = {}

	for decl in decls:
		match decl:
			FunctionDecl(function_info):
				if has_callable_implementation(function_info):
					implemented = implemented.set(function_info.name, True)
			_:
				void

	implemented


private pure func deduplicate_functions(decls: List[CoreDecl]) -> List[CoreDecl]:
	-- Two invocation-local indexes replace the previous full-declaration
	-- rescan and linear seen-name list: `implemented` is built once up front,
	-- and `seen` accumulates admitted function names as the single walk below
	-- proceeds. The winner rule is unchanged: an implementation wins over a
	-- forward declaration, and otherwise the first declaration by name wins.
	-- Identity stays name-only on purpose; do not key either index by
	-- `def_id` or another nominal identity.
	implemented: Dict[String, Bool] = index_implemented_function_names(decls)
	var seen: Dict[String, Bool] = {}
	var result: List[CoreDecl] = []

	for decl in decls:
		match decl:
			FunctionDecl(function_info):
				if not seen.get_or(function_info.name, False):
					if (
						has_callable_implementation(function_info)
						or not implemented.get_or(function_info.name, False)
					):
						seen = seen.set(function_info.name, True)
						result = result.append(decl)
			_:
				result = result.append(decl)

	result


private pure func callable_aliases(
	module_name: String,
	rewrites: List[CallableRewrite],
) -> List[CoreCallableAlias]:
	-- Callable aliases are consumed as one module-owned group, so every alias
	-- can share the same escaped UFCS prefix. Avoid constructing it for the
	-- common no-alias case, which has no UFCS names to emit.
	if rewrites.any(func(rewrite): rewrite.def_id != rewrite.target_def_id):
		ufcs_prefix: String = core_ufcs_module_prefix(module_name)

		rewrites.filter_map(func(rewrite):
			if rewrite.def_id == rewrite.target_def_id:
				None
			else:
				Some({
					source_name = core_ufcs_name_from_prefix(ufcs_prefix, rewrite.source_name),
					source_def_id = rewrite.def_id,
					target_name = rewrite.target_name,
					target_def_id = rewrite.target_def_id,
				})
		)
	else:
		[]


pure func prefix_module_names_with_aliases(
	module_name: String,
	program: CoreProgram,
) -> Result[CorePrefixedModule, CoreFlattenError]:
	materialized_program: CoreProgram = materialize_builtin_overloads(program)
	-- Every member this module owns shares one sanitized module identity, so
	-- spell it once here and join names through the prefix below.
	module_prefix: String = core_module_member_prefix(module_name)
	callable_plan ?= collect_callable_rewrites(module_prefix, materialized_program)
	callable_rewrites: List[CallableRewrite] = callable_plan.rewrites
	global_rewrites: List[GlobalRewrite] = collect_global_rewrites(
		module_prefix,
		materialized_program,
	)
	type_context: CoreTypeRewriteContext = {
		rewrites = collect_local_type_rewrites(module_prefix, materialized_program),
	}
	named_decls: List[CoreDecl] = materialized_program.decls.map(
		func(
			decl,
		): rewrite_decl(module_name, module_prefix, callable_rewrites, global_rewrites, decl),
	)
	rewritten_decls: List[CoreDecl] = named_decls.map(
		func(decl): rewrite_decl_types(type_context, decl),
	)
	Ok({
		program = {
			decls = deduplicate_functions(rewritten_decls),
			foreign_includes = materialized_program.foreign_includes
		},
		callable_aliases = callable_aliases(module_name, callable_rewrites),
		callable_plan_function_visits = callable_plan.function_visits,
	})


private pure func callable_alias_rewrite(entry: CoreCallableAlias) -> CallableRewrite:
	{
		source_name = entry.source_name,
		def_id = entry.source_def_id,
		target_name = entry.target_name,
		target_def_id = entry.target_def_id
	}


private pure func rewrite_function_callable_aliases(
	rewrites: List[CallableRewrite],
	function_info: CoreFunction,
) -> CoreFunction:
	bound = bound_with_params([], function_info.params)
	{ function_info |
		body = function_info.body.map(func(body): rewrite_expr(rewrites, [], bound, body))
	}


private pure func rewrite_decl_callable_aliases(
	rewrites: List[CallableRewrite],
	decl: CoreDecl,
) -> CoreDecl:
	match decl:
		FunctionDecl(function_info):
			FunctionDecl(rewrite_function_callable_aliases(rewrites, function_info))
		GlobalDecl(global):
			GlobalDecl({ global | init = rewrite_expr(rewrites, [], [], global.init) })
		ImplDecl(impl_decl):
			ImplDecl(
				{ impl_decl |
					methods = impl_decl.methods.map(
						func(method): rewrite_function_callable_aliases(rewrites, method),
					)
				},
			)
		_:
			decl


pure func rewrite_program_callable_aliases(
	program: CoreProgram,
	aliases: List[CoreCallableAlias],
) -> CoreProgram:
	if aliases.is_empty():
		program
	else:
		rewrites: List[CallableRewrite] = aliases.map(callable_alias_rewrite)
		{ program |
			decls = program.decls.map(func(decl): rewrite_decl_callable_aliases(rewrites, decl))
		}
