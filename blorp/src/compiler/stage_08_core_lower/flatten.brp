-- Establish globally unique names for module-owned declarations before modules
-- are assembled into one Core program.
--
-- Callable references are rewritten by declaration identity, never by an
-- unscoped source-name guess, so local variables with the same name remain
-- untouched. Type references are rewritten from explicit local declaration
-- identities; imported identities have already been canonicalized by typecheck.
import:
	../stage_06_typecheck/type_system/language_surface_manifest:
		DeclaredAbiType,
		declared_abi_type_name,
	../stage_09_core/ir:
		CoreBoxedStorageValue,
		CoreCallKind(SelectedDirectCall),
		CoreClosureCreate,
		CoreConcurrentlyLoopItemMode(ConcurrentlyLoopMoveResourceItem),
		CoreConstructorMatchBody(ConstructorMatchBodyExpr),
		CoreConstructorMatchCase,
		CoreConstructorMatchFallback(
			ConstructorMatchFallbackBindings,
			ConstructorMatchFallbackBody,
			ConstructorMatchFallbackFail,
		),
		CoreDecl(
			EnumDecl,
			FunctionDecl,
			GlobalDecl,
			HeapRecordDecl,
			ImplDecl,
			TraitDecl,
			TypeAliasDecl,
			UnionDecl,
			ValueRecordDecl,
		),
		CoreDictLiteralEntry,
		CoreExpr(
			AssignExpr,
			BinaryExpr,
			BorrowLetExpr,
			BreakExpr,
			CallExpr,
			ContinueExpr,
			ClosureCreateExpr,
			ConstructorMatchExpr,
			DictExpr,
			FieldExpr,
			ForChannelExpr,
			ForDictExpr,
			ForListExpr,
			ForRangeExpr,
			ForResourceSourceExpr,
			ForSetExpr,
			ForStreamExpr,
			ForStringExpr,
			ForTensorExpr,
			IfExpr,
			LambdaExpr,
			LetExpr,
			ListConstructExpr,
			LiteralExpr,
			LiteralMatchExpr,
			LogicalExpr,
			PreClosureConcurrentExpr,
			PreClosureConcurrentlyLoopExpr,
			PreClosureDetachExpr,
			RangeExpr,
			RawMatchExpr,
			RecordExpr,
			RecordCowUpdateExpr,
			RecordReuseExpr,
			RecordUpdateExpr,
			ResourceScopeExpr,
			SelectExpr,
			SeqExpr,
			TensorRawViewLetExpr,
			TupleExpr,
			TupleFieldExpr,
			UnaryExpr,
			VarExpr,
			VectorExpr,
			VoidExpr,
			WhileExpr,
		),
		CoreForChannel,
		CoreForDict,
		CoreForList,
		CoreForResourceSource,
		CoreForSet,
		CoreForStream,
		CoreForString,
		CoreForTensor,
		CoreFunction,
		CoreFunctionKind(
			BuiltinFunction,
			ClosureBodyFunction,
			ForeignFunction,
			ProgramEntrypointFunction,
			UnresolvedBuiltinFunction,
			UserFunction,
		),
		CoreGlobal,
		CoreHeapRecordField,
		CoreImplDecl,
		CoreLiteralMatchCase,
		CoreLiteralMatchFallback(
			LiteralMatchFallbackBindings,
			LiteralMatchFallbackBody,
			LiteralMatchFallbackFail,
		),
		CoreLogicalOp,
		CoreLoopBinder,
		CoreMatchBinding,
		CoreParam,
		CorePattern(
			ConstructorPattern,
			ListPattern,
			LiteralPattern,
			NamePattern,
			OrPattern,
			QualifiedConstructorPattern,
			TuplePattern,
			WildcardPattern,
		),
		CorePreClosureConcurrentBinding,
		CoreProgram,
		CoreRawMatchCase,
		CoreRecordCowField,
		CoreRecordFieldValue,
		CoreSelectArm,
		CoreSelectArmKind(SelectAfterArm, SelectRecvArm, SelectSealedArm),
		CoreSourceLoc,
		CoreTraitMethod,
		CoreType(
			BoxedResultType,
			EnumType,
			FunctionType,
			HeapRecordType,
			NamedType,
			RangeType,
			SelfType,
			StackResultType,
			TensorType,
			TupleType,
			TypeParameterType,
			UnionType,
			ValueRecordType,
			VoidType,
		),
		CoreUnionField,
		CoreUnionVariant,
		CoreValueRecordField,
		CoreVar,
	../stage_09_core/traverse as CoreTraverse
	identity:
		core_module_member_name_from_prefix,
		core_module_member_prefix,
		core_pure_overload_function_name_from_prefix,
		core_ufcs_module_prefix,
		core_ufcs_name_from_prefix,
		flatten_canonical_core_type_name,
		is_core_ufcs_function_name,


private record CallableRewrite {
	source_name: String,
	def_id: Int,
	target_name: String,
	target_def_id: Int
}


-- Callable selection is computed once while flattening a single module. The
-- source function list is immutable throughout that pass, so these facts are
-- stable and must not outlive the pass.
private union CallableTargetSelection:
	NoCallableTarget
	UniqueCallableTarget(Int)
	AmbiguousCallableTarget


private record CallableNameFacts {
	has_pure_implementation: Bool,
	has_impure_implementation: Bool,
	has_unresolved_builtin: Bool,
	pure_target: CallableTargetSelection,
	ordinary_target: CallableTargetSelection
}


private EMPTY_CALLABLE_NAME_FACTS: CallableNameFacts = {
	has_pure_implementation = False,
	has_impure_implementation = False,
	has_unresolved_builtin = False,
	pure_target = NoCallableTarget,
	ordinary_target = NoCallableTarget
}


private record CallableRewritePlan {
	rewrites: List[CallableRewrite],
	function_visits: Int
}


union CoreFlattenError:
	CoreFlattenAmbiguousCallableTarget(String)
	CoreFlattenCallableTargetNameCollision(String)


record CoreCallableAlias {
	source_name: String,
	source_def_id: Int,
	target_name: String,
	target_def_id: Int
}


record CorePrefixedModule {
	program: CoreProgram,
	callable_aliases: List[CoreCallableAlias],
	callable_plan_function_visits: Int
}


pure func core_flatten_error_to_string(error: CoreFlattenError) -> String:
	match error:
		CoreFlattenAmbiguousCallableTarget(source_name):
			"multiple callable implementations select the same emitted target for '${source_name}'"
		CoreFlattenCallableTargetNameCollision(target_name):
			"multiple callables would emit the same target name '${target_name}'"


private record GlobalRewrite {
	source_name: String,
	target_name: String
}


private record CoreTypeNameRewrite {
	source_name: String,
	target_name: String
}


private record CoreTypeRewriteContext {
	rewrites: List[CoreTypeNameRewrite]
}


-- Allocation identity for the reuse rule the type rewrites below follow: a
-- mapped child that is the same allocation as its input proves the input node
-- can be handed back as is, so a module whose types need no rewriting stops
-- reallocating its whole body behind itself. Core is immutable value data, so
-- sharing subtrees between input and output is safe. Bound straight to the
-- runtime primitive for the same bootstrap reason as the matching block in
-- traverse.brp; delete the blocks together and import `memory: same_object`
-- instead.
foreign:
	private pure func same_core_expr(left: CoreExpr, right: CoreExpr) -> Bool = "blorp_same_object"
	private pure func same_core_record_cow_fields(
		left: List[CoreRecordCowField],
		right: List[CoreRecordCowField],
	) -> Bool = "blorp_same_object"


-- The type rewrites below answer `None` for "this value came back unchanged",
-- so a caller keeps its own input instead of allocating an equal copy first.
-- This maps a list with such a helper and answers `None` itself when no item
-- changed, copying the untouched prefix only once an item actually changes.
private pure func rewrite_list_items[T](
	items: List[T],
	rewrite_item: pure (T) -> Option[T],
) -> Option[List[T]]:
	var rewritten: List[T] = []
	var changed: Bool = False
	var index: Int = 0

	for item in items:
		match rewrite_item(item):
			Some(rewritten_item):
				rewritten = if changed:
					rewritten.append(rewritten_item)
				else:
					items
						.take(index)
						.append(rewritten_item)

				changed = True
			None:
				if changed:
					rewritten = rewritten.append(item)
				else:
					void

		index += 1

	if changed:
		Some(rewritten)
	else:
		None


private union CoreTypeRewriteBindingFrame:
	CoreTypeRewriteAssignFrame(CoreExpr)
	CoreTypeRewriteLetRhsFrame(CoreExpr)
	CoreTypeRewriteLetBodyFrame(CoreExpr, CoreExpr)
	CoreTypeRewriteBorrowLetRhsFrame(CoreExpr)
	CoreTypeRewriteBorrowLetBodyFrame(CoreExpr, CoreExpr)


private union CoreTypeRewriteBindingFrameStack:
	CoreTypeRewriteNoBindingFrame
	CoreTypeRewriteMoreBindingFrames(CoreTypeRewriteBindingFrame, CoreTypeRewriteBindingFrameStack)


private union CoreTypeRewriteBindingAction:
	CoreTypeRewriteVisitBindingExpr(CoreExpr)
	CoreTypeRewriteRebuildBindingExpr(CoreExpr)


private union CoreTypeRewriteLogicalFrame:
	CoreTypeRewriteLogicalVisitRightFrame(CoreExpr)
	CoreTypeRewriteLogicalRebuildParentFrame(CoreExpr, CoreExpr)


private union CoreTypeRewriteLogicalFrameStack:
	CoreTypeRewriteLogicalNoFrame
	CoreTypeRewriteLogicalMoreFrames(CoreTypeRewriteLogicalFrame, CoreTypeRewriteLogicalFrameStack)


private union CoreTypeRewriteLogicalAction:
	CoreTypeRewriteLogicalVisitExpr(CoreExpr)
	CoreTypeRewriteLogicalRebuildExpr(CoreExpr)


private union FlattenRewriteBindingFrame:
	FlattenRewriteAssignFrame(CoreExpr, Option[CoreVar])
	FlattenRewriteLetRhsFrame(CoreExpr, List[String])
	FlattenRewriteLetBodyFrame(CoreExpr, CoreExpr)
	FlattenRewriteBorrowLetRhsFrame(CoreExpr, List[String])
	FlattenRewriteBorrowLetBodyFrame(CoreExpr, CoreExpr)


private union FlattenRewriteBindingFrameStack:
	FlattenRewriteNoBindingFrame
	FlattenRewriteMoreBindingFrames(FlattenRewriteBindingFrame, FlattenRewriteBindingFrameStack)


private union FlattenRewriteBindingAction:
	FlattenRewriteVisitBindingExpr(List[String], CoreExpr)
	FlattenRewriteRebuildBindingExpr(CoreExpr)


private union FlattenRewriteLogicalFrame:
	FlattenRewriteLogicalVisitRightFrame(CoreLogicalOp, CoreExpr, CoreType, CoreSourceLoc, List[String])
	FlattenRewriteLogicalRebuildParentFrame(CoreLogicalOp, CoreExpr, CoreType, CoreSourceLoc)


private union FlattenRewriteLogicalFrameStack:
	FlattenRewriteLogicalNoFrame
	FlattenRewriteLogicalMoreFrames(FlattenRewriteLogicalFrame, FlattenRewriteLogicalFrameStack)


private union FlattenRewriteLogicalAction:
	FlattenRewriteLogicalVisitExpr(List[String], CoreExpr)
	FlattenRewriteLogicalRebuildExpr(CoreExpr)


private pure func is_module_user_callable(function_info: CoreFunction) -> Bool:
	match function_info.function_kind:
		UserFunction:
			not is_core_ufcs_function_name(function_info.name)
		UnresolvedBuiltinFunction:
			True
		BuiltinFunction(c_name):
			False
		ForeignFunction(_):
			False
		ClosureBodyFunction(_):
			False
		ProgramEntrypointFunction:
			False


private pure func has_callable_implementation(function_info: CoreFunction) -> Bool:
	if function_info.body.is_some():
		True
	else:
		-- Source `builtin("...")` bodies lower to a bodyless
		-- UnresolvedBuiltinFunction. They are still implementations; treating
		-- them as forward declarations can discard the selected overload.
		match function_info.function_kind:
			UnresolvedBuiltinFunction:
				True
			_:
				False


private pure func top_level_functions(program: CoreProgram) -> List[CoreFunction]:
	program.decls.filter_map(func(decl):
		match decl:
			FunctionDecl(function_info):
				Some(function_info)
			_:
				None
	)


private pure func callable_name_facts_has_implementation(facts: CallableNameFacts) -> Bool:
	facts.has_pure_implementation or facts.has_impure_implementation


private pure func callable_name_facts_has_purity_overload(facts: CallableNameFacts) -> Bool:
	facts.has_pure_implementation and facts.has_impure_implementation


private pure func add_callable_name_facts(
	name_facts: Dict[String, CallableNameFacts],
	function_info: CoreFunction,
) -> Dict[String, CallableNameFacts]:
	if not is_module_user_callable(function_info):
		name_facts
	else:
		previous: CallableNameFacts = name_facts.get_or(
			function_info.name,
			EMPTY_CALLABLE_NAME_FACTS,
		)
		is_implementation: Bool = has_callable_implementation(function_info)
		updated: CallableNameFacts = { previous |
			has_pure_implementation = (
				previous.has_pure_implementation
				or function_info.is_pure and is_implementation
			),
			has_impure_implementation = (
				previous.has_impure_implementation
				or not function_info.is_pure and is_implementation
			),
			has_unresolved_builtin = (
				previous.has_unresolved_builtin
				or function_info.function_kind == UnresolvedBuiltinFunction
			)
		}

		name_facts.set(function_info.name, updated)


private pure func build_callable_name_facts(
	functions: List[CoreFunction],
) -> Dict[String, CallableNameFacts]:
	var name_facts: Dict[String, CallableNameFacts] = {}

	for function_info in functions:
		name_facts = add_callable_name_facts(name_facts, function_info)

	name_facts


private pure func materialize_builtin_overload(
	name_facts: Dict[String, CallableNameFacts],
	function_info: CoreFunction,
) -> CoreFunction:
	match function_info.function_kind:
		UserFunction:
			if (
				function_info.body.is_none()
				and name_facts
					.get(function_info.name)
					.map(func(facts): facts.has_unresolved_builtin)
					.get_or(False)
			):
				-- A bodyless declaration paired with a source `builtin(...)`
				-- declaration is another purity overload of that implementation.
				-- Keep its distinct callable ID and signature so calls selected
				-- during typechecking can be specialized without guessing.
				{ function_info | function_kind = UnresolvedBuiltinFunction }
			else:
				function_info
		_:
			function_info


private pure func materialize_builtin_overload_decl(
	name_facts: Dict[String, CallableNameFacts],
	decl: CoreDecl,
) -> CoreDecl:
	match decl:
		FunctionDecl(function_info):
			FunctionDecl(materialize_builtin_overload(name_facts, function_info))
		_:
			decl


private pure func materialize_builtin_overloads(program: CoreProgram) -> CoreProgram:
	functions: List[CoreFunction] = top_level_functions(program)
	name_facts: Dict[String, CallableNameFacts] = build_callable_name_facts(functions)

	{ program |
		decls = program.decls.map(func(decl): materialize_builtin_overload_decl(name_facts, decl))
	}


private pure func callable_target_name(
	module_prefix: String,
	facts: CallableNameFacts,
	function_info: CoreFunction,
) -> String:
	if function_info.is_pure and callable_name_facts_has_purity_overload(facts):
		core_pure_overload_function_name_from_prefix(module_prefix, function_info.name)
	else:
		core_module_member_name_from_prefix(module_prefix, function_info.name)


private pure func add_callable_target_selection(
	selection: CallableTargetSelection,
	def_id: Int,
) -> CallableTargetSelection:
	match selection:
		NoCallableTarget:
			UniqueCallableTarget(def_id)
		UniqueCallableTarget(_):
			-- Multiple implementations for one emitted target are malformed Core.
			-- Preserve the ambiguity instead of choosing declaration order.
			AmbiguousCallableTarget
		AmbiguousCallableTarget:
			AmbiguousCallableTarget


private pure func add_callable_target_def_id(
	name_facts: Dict[String, CallableNameFacts],
	function_info: CoreFunction,
) -> Dict[String, CallableNameFacts]:
	if not is_module_user_callable(function_info) or not has_callable_implementation(function_info):
		name_facts
	else:
		match name_facts.get(function_info.name):
			None:
				name_facts
			Some(facts):
				updated: CallableNameFacts = if (
					function_info.is_pure
					and callable_name_facts_has_purity_overload(facts)
				):
					{ facts |
						pure_target = add_callable_target_selection(
							facts.pure_target,
							function_info.def_id,
						)
					}
				else:
					{ facts |
						ordinary_target = add_callable_target_selection(
							facts.ordinary_target,
							function_info.def_id,
						)
					}

				name_facts.set(function_info.name, updated)


private pure func add_callable_target_def_ids(
	functions: List[CoreFunction],
	name_facts: Dict[String, CallableNameFacts],
) -> Dict[String, CallableNameFacts]:
	var updated_facts: Dict[String, CallableNameFacts] = name_facts

	for function_info in functions:
		updated_facts = add_callable_target_def_id(updated_facts, function_info)

	updated_facts


private pure func callable_target_def_id(
	facts: CallableNameFacts,
	function_info: CoreFunction,
) -> Option[Int]:
	selection: CallableTargetSelection = if (
		function_info.is_pure
		and callable_name_facts_has_purity_overload(facts)
	):
		facts.pure_target
	else:
		facts.ordinary_target

	match selection:
		UniqueCallableTarget(def_id):
			Some(def_id)
		NoCallableTarget:
			None
		AmbiguousCallableTarget:
			None


private pure func register_callable_target_name(
	target_def_ids: Dict[String, Int],
	target_name: String,
	target_def_id: Int,
) -> Result[Dict[String, Int], CoreFlattenError]:
	match target_def_ids.get(target_name):
		None:
			Ok(target_def_ids.set(target_name, target_def_id))
		Some(existing_def_id):
			if existing_def_id == target_def_id:
				Ok(target_def_ids)
			else:
				Err(CoreFlattenCallableTargetNameCollision(target_name))


private pure func collect_callable_rewrites(
	module_prefix: String,
	program: CoreProgram,
) -> Result[CallableRewritePlan, CoreFlattenError]:
	functions: List[CoreFunction] = top_level_functions(program)
	var name_facts: Dict[String, CallableNameFacts] = build_callable_name_facts(functions)
	name_facts = add_callable_target_def_ids(functions, name_facts)
	var target_def_ids: Dict[String, Int] = {}
	var rewrites: List[CallableRewrite] = []
	var error: Option[CoreFlattenError] = None

	for function_info in functions:
		if error.is_none() and is_module_user_callable(function_info):
			match name_facts.get(function_info.name):
				Some(facts):
					if callable_name_facts_has_implementation(facts):
						match callable_target_def_id(facts, function_info):
							Some(target_def_id):
								target_name = callable_target_name(
									module_prefix,
									facts,
									function_info,
								)

								match register_callable_target_name(
									target_def_ids,
									target_name,
									target_def_id,
								):
									Ok(updated_target_def_ids):
										target_def_ids = updated_target_def_ids
										rewrites = rewrites.append({
											source_name = function_info.name,
											def_id = function_info.def_id,
											target_name = target_name,
											target_def_id = target_def_id,
										})
									Err(flatten_error):
										error = Some(flatten_error)
							None:
								error = Some(CoreFlattenAmbiguousCallableTarget(function_info.name))
					else:
						void
				None:
					void

	match error:
		Some(flatten_error):
			Err(flatten_error)
		None:
			Ok({
				rewrites = rewrites,
				function_visits = functions.length() * 3,
			})


private pure func collect_global_rewrites(
	module_prefix: String,
	program: CoreProgram,
) -> List[GlobalRewrite]:
	program.decls.filter_map(func(decl):
		match decl:
			GlobalDecl(global):
				rewrite: GlobalRewrite = {
					source_name = global.name.name,
					target_name = core_module_member_name_from_prefix(
						module_prefix,
						global.name.name,
					)
				}
				Some(rewrite)
			_:
				None
	)


private pure func find_callable_rewrite(
	rewrites: List[CallableRewrite],
	source_name: String,
	def_id: Int,
) -> Option[CallableRewrite]:
	var target: Option[CallableRewrite] = None

	for rewrite in rewrites:
		if rewrite.source_name == source_name and rewrite.def_id == def_id:
			target = Some(rewrite)
			break

	target


private pure func rewritten_global_name(
	rewrites: List[GlobalRewrite],
	source_name: String,
) -> Option[String]:
	var target: Option[String] = None

	for rewrite in rewrites:
		if rewrite.source_name == source_name:
			target = Some(rewrite.target_name)
			break

	target


-- `None` means this reference keeps the name and id it arrived with, which is
-- the common case: only the module's own callables and globals are renamed.
private pure func rewrite_var(
	callable_rewrites: List[CallableRewrite],
	global_rewrites: List[GlobalRewrite],
	bound: List[String],
	variable: CoreVar,
) -> Option[CoreVar]:
	match variable.def_id:
		Some(def_id):
			rewritten: Option[CoreVar] = rewrite_var_with_id(callable_rewrites, variable, def_id)

			if rewritten.is_some() or bound.contains(variable.name):
				rewritten
			else:
				rewrite_global_var(global_rewrites, variable)
		None:
			if bound.contains(variable.name):
				None
			else:
				rewrite_global_var(global_rewrites, variable)


private pure func rewrite_global_var(
	rewrites: List[GlobalRewrite],
	variable: CoreVar,
) -> Option[CoreVar]:
	rewritten_global_name(
		rewrites,
		variable.name,
	).map(
		func(target_name): { variable | name = target_name },
	)


private pure func rewrite_var_with_id(
	rewrites: List[CallableRewrite],
	variable: CoreVar,
	def_id: Int,
) -> Option[CoreVar]:
	find_callable_rewrite(rewrites, variable.name, def_id).map(func(rewrite): { variable |
			name = rewrite.target_name,
			def_id = Some(rewrite.target_def_id)
		})


private pure func rewrite_call_kind(
	rewrites: List[CallableRewrite],
	kind: CoreCallKind,
	callee: CoreExpr,
) -> CoreCallKind:
	match (kind, callee):
		(SelectedDirectCall(def_id), VarExpr(variable, _, _)):
			match find_callable_rewrite(rewrites, variable.name, def_id):
				Some(rewrite):
					SelectedDirectCall(rewrite.target_def_id)
				None:
					kind
		_:
			kind


private pure func rewrite_closure_reference(
	rewrites: List[CallableRewrite],
	closure: CoreClosureCreate,
	typ: CoreType,
	loc: CoreSourceLoc,
) -> CoreExpr:
	match find_callable_rewrite(rewrites, closure.function_name, closure.def_id):
		Some(rewrite):
			ClosureCreateExpr(
				{ closure |
					function_name = rewrite.target_name,
					def_id = rewrite.target_def_id
				},
				typ,
				loc,
			)
		None:
			ClosureCreateExpr(closure, typ, loc)


private pure func bound_with_name(bound: List[String], name: String) -> List[String]:
	if bound.contains(name):
		bound
	else:
		bound.append(name)


private pure func bound_with_var(bound: List[String], variable: CoreVar) -> List[String]:
	bound_with_name(bound, variable.name)


private pure func bound_with_pattern(bound: List[String], pattern: CorePattern) -> List[String]:
	-- `bound` is unique by construction: both public entry points start with an
	-- empty list and every recursive scope extension uses a `bound_with_*`
	-- admission helper. Preserve that invariant here while adding pattern names
	-- in the same order as CoreTraverse.core_pattern_bound_names.
	match pattern:
		NamePattern(name):
			bound_with_name(bound, name)
		ConstructorPattern(_, args) | QualifiedConstructorPattern(_, _, args):
			var result: List[String] = bound

			for arg in args:
				result = bound_with_pattern(result, arg)

			result
		TuplePattern(items) | OrPattern(items):
			var result: List[String] = bound

			for item in items:
				result = bound_with_pattern(result, item)

			result
		ListPattern(items, spread):
			var result: List[String] = bound

			for item in items:
				result = bound_with_pattern(result, item)

			match spread:
				Some(spread_pattern):
					bound_with_pattern(result, spread_pattern)
				None:
					result
		WildcardPattern | LiteralPattern(_):
			bound


private pure func bound_with_params(bound: List[String], params: List[CoreParam]) -> List[String]:
	var result: List[String] = bound

	for param in params:
		result = bound_with_var(result, param.name)

	result


private pure func bound_with_match_bindings(
	bound: List[String],
	bindings: List[CoreMatchBinding],
) -> List[String]:
	var result: List[String] = bound

	for binding in bindings:
		result = bound_with_var(result, binding.variable)

	result


private pure func rewrite_literal_match_case(
	callable_rewrites: List[CallableRewrite],
	global_rewrites: List[GlobalRewrite],
	bound: List[String],
	match_case: CoreLiteralMatchCase,
) -> CoreLiteralMatchCase:
	case_bound = bound_with_match_bindings(bound, match_case.bindings)
	{ match_case |
		body = rewrite_expr(callable_rewrites, global_rewrites, case_bound, match_case.body)
	}


private pure func rewrite_literal_match_fallback(
	callable_rewrites: List[CallableRewrite],
	global_rewrites: List[GlobalRewrite],
	bound: List[String],
	fallback: CoreLiteralMatchFallback,
) -> CoreLiteralMatchFallback:
	match fallback:
		LiteralMatchFallbackBody(body):
			LiteralMatchFallbackBody(rewrite_expr(callable_rewrites, global_rewrites, bound, body))
		LiteralMatchFallbackBindings(bindings, body):
			LiteralMatchFallbackBindings(
				bindings,
				rewrite_expr(
					callable_rewrites,
					global_rewrites,
					bound_with_match_bindings(bound, bindings),
					body,
				),
			)
		LiteralMatchFallbackFail:
			LiteralMatchFallbackFail


private pure func rewrite_constructor_match_case(
	callable_rewrites: List[CallableRewrite],
	global_rewrites: List[GlobalRewrite],
	bound: List[String],
	match_case: CoreConstructorMatchCase,
) -> CoreConstructorMatchCase:
	case_bound = bound_with_match_bindings(bound, match_case.bindings)

	match match_case.body:
		ConstructorMatchBodyExpr(body):
			{ match_case |
				body = ConstructorMatchBodyExpr(
					rewrite_expr(
						callable_rewrites,
						global_rewrites,
						case_bound,
						body,
					),
				)
			}
		_:
			match_case


private pure func rewrite_constructor_match_fallback(
	callable_rewrites: List[CallableRewrite],
	global_rewrites: List[GlobalRewrite],
	bound: List[String],
	fallback: CoreConstructorMatchFallback,
) -> CoreConstructorMatchFallback:
	match fallback:
		ConstructorMatchFallbackBody(body):
			ConstructorMatchFallbackBody(
				rewrite_expr(
					callable_rewrites,
					global_rewrites,
					bound,
					body,
				),
			)
		ConstructorMatchFallbackBindings(bindings, body):
			ConstructorMatchFallbackBindings(
				bindings,
				rewrite_expr(
					callable_rewrites,
					global_rewrites,
					bound_with_match_bindings(bound, bindings),
					body,
				),
			)
		ConstructorMatchFallbackFail:
			ConstructorMatchFallbackFail


private pure func rewrite_loop_body(
	callable_rewrites: List[CallableRewrite],
	global_rewrites: List[GlobalRewrite],
	bound: List[String],
	binder: CoreLoopBinder,
	body: CoreExpr,
) -> CoreExpr:
	rewrite_expr(
		callable_rewrites,
		global_rewrites,
		bound_with_var(bound, binder.variable),
		body,
	)


private pure func rewrite_for_channel(
	callable_rewrites: List[CallableRewrite],
	global_rewrites: List[GlobalRewrite],
	bound: List[String],
	loop: CoreForChannel,
) -> CoreForChannel:
	{ loop |
		iterable = rewrite_expr(callable_rewrites, global_rewrites, bound, loop.iterable),
		body = rewrite_loop_body(callable_rewrites, global_rewrites, bound, loop.binder, loop.body)
	}


