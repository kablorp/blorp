-- Assemble the typed module graph into the one prepared Core program accepted
-- by the semantic middle.
--
-- This is the checkpoint-8 ownership boundary. It lowers each module, flattens
-- module-owned names, lowers the unprefixed root program, and attaches the FFI
-- and list-layout facts required by the first middle-Core pass.
import:
	../stage_04_modules/module_table:
		ModuleId,
		ModuleTable,
		module_id_table_index,
		module_table_canonical_path,
		module_table_count,
		module_tables_are_compatible,
	../stage_06_typecheck/decl:
		TypedDecl(TypedFunctionDecl, TypedImplDecl, TypedPrivateDecl),
		TypedFunctionInfo,
		TypedProgram,
	../stage_09_core/ir: CoreProgram
	entrypoint: synthesize_program_entrypoint
	ffi_boundary: CoreFfiBoundaryError, annotate_ffi_boundaries, core_ffi_boundary_error_to_string
	flatten:
		CoreCallableAlias,
		CoreFlattenError,
		core_flatten_error_to_string,
		prefix_module_names_with_aliases,
		rewrite_program_callable_aliases,
	identity: core_ufcs_module_prefix, core_ufcs_name_from_prefix
	list_layout: annotate_list_layouts
	lower:
		CoreLowerCallableName,
		CoreLowerCallableNameRegistry(CoreLowerPreparedCallableNames),
		CoreLowerContext,
		CoreLowerError,
		core_lower_context_with_callable_names,
		core_lower_error_to_string,
		lower_typed_program,


record CoreGraphUnit {
	module_id: ModuleId,
	typed_program: TypedProgram
}


private record CoreGraphModulesRep {
	module_table: ModuleTable,
	units: List[CoreGraphUnit]
}


opaque type CoreGraphModules = CoreGraphModulesRep


pure func core_graph_modules(
	module_table: ModuleTable,
	units: List[CoreGraphUnit],
) -> CoreGraphModules:
	into_opaque CoreGraphModules({
			module_table = module_table,
			units = units
		})


record CorePreparedGraph {
	program: CoreProgram,
	next_def_id: Int
}


union CoreGraphPrepareError:
	CoreGraphLowerError(String, CoreLowerError)
	CoreGraphFlattenError(String, CoreFlattenError)
	CoreGraphModuleTableError(String)
	CoreGraphFfiError(CoreFfiBoundaryError)
	CoreGraphEntrypointError(String)


private record LoweredCoreModules {
	context: CoreLowerContext,
	programs: List[CoreProgram],
	callable_aliases: List[CoreCallableAlias]
}


-- Resolved calls retain canonical module paths, while Core's module-name
-- flattening may use a separately projected display/module name. Keep both
-- facts at this boundary and index canonical UFCS names by the resolved path.
private pure func register_callable_name(
	by_module: List[Dict[Int, CoreLowerCallableName]],
	module_id: ModuleId,
	module_prefix: String,
	function_info: TypedFunctionInfo,
) -> Option[List[Dict[Int, CoreLowerCallableName]]]:
	match function_info.callable_id:
		Some(callable_id):
			module_index = module_id_table_index(module_id)
			by_callable ?= by_module.get(module_index)
			Some(
				by_module.set(
					module_index,
					by_callable.set(
						callable_id,
						{
							source_name = function_info.decl.name.text,
							ufcs_name = core_ufcs_name_from_prefix(
								module_prefix,
								function_info.decl.name.text,
							)
						},
					),
				),
			)
		None:
			Some(by_module)


private pure func register_decl_callable_names(
	by_module: List[Dict[Int, CoreLowerCallableName]],
	module_id: ModuleId,
	module_prefix: String,
	decl: TypedDecl,
) -> Option[List[Dict[Int, CoreLowerCallableName]]]:
	match decl:
		TypedFunctionDecl(function_info):
			register_callable_name(by_module, module_id, module_prefix, function_info)
		TypedImplDecl(impl_info):
			var result: Option[List[Dict[Int, CoreLowerCallableName]]] = Some(by_module)

			for method in impl_info.methods:
				match result:
					Some(names):
						result = register_callable_name(names, module_id, module_prefix, method)
					None:
						void

			result
		TypedPrivateDecl(inner):
			register_decl_callable_names(by_module, module_id, module_prefix, inner)
		_:
			Some(by_module)


private pure func register_program_callable_names(
	by_module: List[Dict[Int, CoreLowerCallableName]],
	module_table: ModuleTable,
	module_id: ModuleId,
	program: TypedProgram,
) -> Option[List[Dict[Int, CoreLowerCallableName]]]:
	-- Escaping occurs once for the entire typed module, not per declaration or
	-- reference lowered from it.
	module_path ?= module_table_canonical_path(module_table, module_id)
	module_prefix: String = core_ufcs_module_prefix(module_path)
	var result: Option[List[Dict[Int, CoreLowerCallableName]]] = Some(by_module)

	for decl in program.decls:
		match result:
			Some(names):
				result = register_decl_callable_names(names, module_id, module_prefix, decl)
			None:
				void

	result


private pure func core_graph_callable_names(
	module_table: ModuleTable,
	target_module_id: ModuleId,
	target: TypedProgram,
	modules: List[CoreGraphUnit],
) -> Option[CoreLowerCallableNameRegistry]:
	var by_module: List[Dict[Int, CoreLowerCallableName]] = []

	for _ in 0..module_table_count(module_table):
		by_module = by_module.append({})

	registered_target ?= register_program_callable_names(
		by_module,
		module_table,
		target_module_id,
		target,
	)
	by_module = registered_target

	var registered_modules: Option[List[Dict[Int, CoreLowerCallableName]]] = Some(by_module)

	for unit in modules:
		match registered_modules:
			Some(names):
				registered_modules = register_program_callable_names(
					names,
					module_table,
					unit.module_id,
					unit.typed_program,
				)
			None:
				void

	registered_modules.map(func(names): CoreLowerPreparedCallableNames(module_table, names))


pure func core_graph_prepare_error_to_string(error: CoreGraphPrepareError) -> String:
	match error:
		CoreGraphLowerError(module_name, lower_error):
			"${module_name}: ${core_lower_error_to_string(lower_error)}"
		CoreGraphFlattenError(module_name, flatten_error):
			"${module_name}: ${core_flatten_error_to_string(flatten_error)}"
		CoreGraphModuleTableError(message):
			message
		CoreGraphFfiError(ffi_error):
			core_ffi_boundary_error_to_string(ffi_error)
		CoreGraphEntrypointError(message):
			message


private pure func lower_core_modules(
	modules: List[CoreGraphUnit],
	context: CoreLowerContext,
) -> Result[LoweredCoreModules, CoreGraphPrepareError]:
	match modules:
		[]:
			Ok({
				context = context,
				programs = [],
				callable_aliases = [],
			})
		[unit, ...remaining]:
			module_name = unit.typed_program.source.module_name
			module_context = core_lower_context_with_callable_names(
				context.next_def_id,
				Some(module_name),
				context.callable_names,
			)

			lowered_result ?= match lower_typed_program(module_context, unit.typed_program):
				Ok(result):
					Ok(result)
				Err(error):
					Err(CoreGraphLowerError(module_name, error))

			prefixed ?= match prefix_module_names_with_aliases(module_name, lowered_result.program):
				Ok(result):
					Ok(result)
				Err(error):
					Err(CoreGraphFlattenError(module_name, error))

			rest ?= lower_core_modules(remaining, lowered_result.context)

			Ok({
				context = rest.context,
				programs = [prefixed.program].concat(rest.programs),
				callable_aliases = prefixed.callable_aliases.concat(rest.callable_aliases),
			})


private pure func assemble_core_program(
	modules: List[CoreProgram],
	target: CoreProgram,
) -> CoreProgram:
	module_decls = modules.flat_map(func(program): program.decls)
	module_includes = modules.flat_map(func(program): program.foreign_includes)

	{
		decls = module_decls.concat(target.decls),
		foreign_includes = module_includes
			.concat(target.foreign_includes)
			.unique()
	}


pure func prepare_core_graph(
	module_table: ModuleTable,
	target_module_id: ModuleId,
	target: TypedProgram,
	modules: CoreGraphModules,
	next_def_id: Int,
) -> Result[CorePreparedGraph, CoreGraphPrepareError]:
	module_product: CoreGraphModulesRep = from_opaque CoreGraphModules(modules)

	compatible_units = if module_tables_are_compatible(module_table, module_product.module_table):
		Some(module_product.units)
	else:
		None

	units ?= compatible_units.to_result(
		CoreGraphModuleTableError("Core graph module IDs were issued by a different module table"),
	)
	callable_names ?= core_graph_callable_names(
		module_table,
		target_module_id,
		target,
		units,
	).to_result(
		CoreGraphModuleTableError("Core graph contains a module ID outside its module table"),
	)
	initial_context = core_lower_context_with_callable_names(next_def_id, None, callable_names)
	lowered_modules ?= lower_core_modules(units, initial_context)
	target_context = core_lower_context_with_callable_names(
		lowered_modules.context.next_def_id,
		None,
		callable_names,
	)

	lowered_target_result ?= match lower_typed_program(target_context, target):
		Ok(result):
			Ok(result)
		Err(error):
			Err(CoreGraphLowerError("target", error))

	assembled = assemble_core_program(lowered_modules.programs, lowered_target_result.program)
	aliased = rewrite_program_callable_aliases(assembled, lowered_modules.callable_aliases)

	entrypoint_result ?= match synthesize_program_entrypoint(
		aliased,
		lowered_target_result.context.next_def_id,
	):
		Ok(result):
			Ok(result)
		Err(error):
			Err(CoreGraphEntrypointError(error))

	entrypoint_program = entrypoint_result[0]
	entrypoint_next_def_id = entrypoint_result[1]

	ffi_program ?= match annotate_ffi_boundaries(entrypoint_program):
		Ok(program):
			Ok(program)
		Err(error):
			Err(CoreGraphFfiError(error))

	Ok({
		program = annotate_list_layouts(ffi_program),
		next_def_id = entrypoint_next_def_id,
	})
