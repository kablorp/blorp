-- Assemble the typed module graph into the one prepared Core program accepted
-- by the semantic middle.
--
-- This is the checkpoint-8 ownership boundary. It lowers each module, flattens
-- module-owned names, lowers the unprefixed root program, and attaches the FFI
-- and list-layout facts required by the first middle-Core pass.
import:
	../stage_04_modules/module_table:
		ModuleId,
		ModuleTable,
		module_id_table_index,
		module_table_canonical_path,
		module_table_count,
	../stage_06_typecheck/decl:
		TypedDecl(TypedFunctionDecl, TypedImplDecl, TypedPrivateDecl),
		TypedFunctionInfo,
		TypedProgram,
	../stage_06_typecheck/graph/definition_index:
		DefinitionTable,
		definition_table_module_table,
		definition_tables_share_provenance,
	../stage_07_ctfe/globals:
		CtfeGlobalReplacements,
		ctfe_global_replacements_are_compatible,
		ctfe_global_replacements_empty,
	../stage_09_core/ir: CoreProgram
	dict: entries as dict_entries, from_list as dict_from_list
	entrypoint: synthesize_program_entrypoint
	ffi_boundary: CoreFfiBoundaryError, annotate_ffi_boundaries, core_ffi_boundary_error_to_string
	flatten:
		CoreCallableAlias,
		CoreFlattenError,
		core_flatten_error_to_string,
		prefix_module_names_with_aliases,
		rewrite_program_callable_aliases,
	identity: core_module_member_prefix_table, core_ufcs_module_prefix, core_ufcs_name_from_prefix
	list: list as list_with_capacity
	list_layout: annotate_list_layouts
	lower:
		CoreLowerCallableName,
		CoreLowerCallableNameRegistry(CoreLowerPreparedCallableNames),
		CoreLowerContext,
		CoreLowerError,
		core_lower_context_with_callable_names,
		core_lower_context_with_module_member_prefixes,
		core_lower_error_to_string,
		lower_typed_program_with_ctfe_replacements,


record CoreGraphUnit {
	module_id: ModuleId,
	typed_program: TypedProgram,
	ctfe_replacements: CtfeGlobalReplacements
}


private record CoreGraphModulesRep {
	definition_table: DefinitionTable,
	units: List[CoreGraphUnit]
}


opaque type CoreGraphModules = CoreGraphModulesRep


pure func core_graph_modules(
	definition_table: DefinitionTable,
	units: List[CoreGraphUnit],
) -> CoreGraphModules:
	into_opaque CoreGraphModules({
			definition_table = definition_table,
			units = units
		})


record CorePreparedGraph {
	program: CoreProgram,
	next_def_id: Int
}


private record CoreGraphCallableNameRegistryBuild {
	by_module: List[Dict[Int, CoreLowerCallableName]]
}


union CoreGraphPrepareError:
	CoreGraphLowerError(String, CoreLowerError)
	CoreGraphFlattenError(String, CoreFlattenError)
	CoreGraphModuleTableError(String)
	CoreGraphFfiError(CoreFfiBoundaryError)
	CoreGraphEntrypointError(String)


private record LoweredCoreModules {
	context: CoreLowerContext,
	programs: List[CoreProgram],
	callable_aliases: List[CoreCallableAlias]
}


---
Resolved calls carry definition-backed identity. Core's emitted UFCS name
still needs the module prefix, so register that display projection once at
this boundary and index it by the definition's owning ModuleId.
---
private pure func callable_name_entry(
	module_prefix: String,
	function_info: TypedFunctionInfo,
) -> Option[(Int, CoreLowerCallableName)]:
	match function_info.callable_id:
		Some(callable_id):
			Some(
				(callable_id, {
						source_name = function_info.decl.name.text,
						ufcs_name = core_ufcs_name_from_prefix(
							module_prefix,
							function_info.decl.name.text,
						)
					}),
			)
		None:
			None


private pure func register_decl_callable_names(
	module_prefix: String,
	decl: TypedDecl,
) -> List[(Int, CoreLowerCallableName)]:
	match decl:
		TypedFunctionDecl(function_info):
			match callable_name_entry(module_prefix, function_info):
				Some(entry):
					[entry]
				None:
					[]
		TypedImplDecl(impl_info):
			var entries: List[(Int, CoreLowerCallableName)] = list_with_capacity(
				impl_info.methods.length(),
			)

			for method in impl_info.methods:
				match callable_name_entry(module_prefix, method):
					Some(entry):
						entries = entries.append(entry)
					None:
						void

			entries
		TypedPrivateDecl(inner):
			register_decl_callable_names(module_prefix, inner)
		_:
			[]


private pure func register_program_callable_names(
	build: CoreGraphCallableNameRegistryBuild,
	module_table: ModuleTable,
	module_id: ModuleId,
	program: TypedProgram,
) -> Option[CoreGraphCallableNameRegistryBuild]:
	-- Escaping occurs once for the entire typed module, not per declaration or
	-- reference lowered from it.
	module_path ?= module_table_canonical_path(module_table, module_id)
	module_prefix: String = core_ufcs_module_prefix(module_path)
	module_index = module_id_table_index(module_id)
	existing ?= build.by_module.get(module_index)
	initial_entries = dict_entries(existing)
	var entries: List[(Int, CoreLowerCallableName)] = list_with_capacity(program.decls.length())

	for decl in program.decls:
		match decl:
			TypedFunctionDecl(function_info):
				match callable_name_entry(module_prefix, function_info):
					Some(entry):
						entries = entries.append(entry)
					None:
						void
			_:
				for entry in register_decl_callable_names(module_prefix, decl):
					entries = entries.append(entry)

	if entries.length() > 0:
		by_callable: Dict[Int, CoreLowerCallableName] = dict_from_list(
			initial_entries.concat(entries),
		)
		Some({by_module = build.by_module.set(module_index, by_callable)})
	else:
		Some(build)


private pure func core_graph_callable_name_registry_build(
	module_table: ModuleTable,
	target_module_id: ModuleId,
	target: TypedProgram,
	modules: List[CoreGraphUnit],
) -> Option[CoreGraphCallableNameRegistryBuild]:
	var by_module: List[Dict[Int, CoreLowerCallableName]] = []

	for _ in 0..module_table_count(module_table):
		by_module = by_module.append({})

	var build: CoreGraphCallableNameRegistryBuild = {by_module = by_module}

	registered_target ?= register_program_callable_names(
		build,
		module_table,
		target_module_id,
		target,
	)
	build = registered_target

	var registered_modules: Option[CoreGraphCallableNameRegistryBuild] = Some(build)

	for unit in modules:
		match registered_modules:
			Some(names):
				registered_modules = register_program_callable_names(
					names,
					module_table,
					unit.module_id,
					unit.typed_program,
				)
			None:
				void

	registered_modules


private pure func core_graph_callable_names(
	module_table: ModuleTable,
	target_module_id: ModuleId,
	target: TypedProgram,
	modules: List[CoreGraphUnit],
) -> Option[CoreLowerCallableNameRegistry]:
	core_graph_callable_name_registry_build(
		module_table,
		target_module_id,
		target,
		modules,
	).map(
		func(build): CoreLowerPreparedCallableNames(module_table, build.by_module),
	)


pure func core_graph_prepare_error_to_string(error: CoreGraphPrepareError) -> String:
	match error:
		CoreGraphLowerError(module_name, lower_error):
			"${module_name}: ${core_lower_error_to_string(lower_error)}"
		CoreGraphFlattenError(module_name, flatten_error):
			"${module_name}: ${core_flatten_error_to_string(flatten_error)}"
		CoreGraphModuleTableError(message):
			message
		CoreGraphFfiError(ffi_error):
			core_ffi_boundary_error_to_string(ffi_error)
		CoreGraphEntrypointError(message):
			message


private pure func lower_core_modules(
	modules: List[CoreGraphUnit],
	context: CoreLowerContext,
	definition_table: DefinitionTable,
) -> Result[LoweredCoreModules, CoreGraphPrepareError]:
	match modules:
		[]:
			Ok({
				context = context,
				programs = [],
				callable_aliases = [],
			})
		[unit, ...remaining]:
			module_name = unit.typed_program.source.module_name
			module_context = core_lower_context_with_module_member_prefixes(
				core_lower_context_with_callable_names(
					context.next_def_id,
					Some(module_name),
					definition_table,
					unit.module_id,
					context.callable_names,
				),
				context.module_member_prefixes,
			)

			lowered_result ?= match lower_typed_program_with_ctfe_replacements(
				module_context,
				unit.typed_program,
				unit.ctfe_replacements,
			):
				Ok(result):
					Ok(result)
				Err(error):
					Err(CoreGraphLowerError(module_name, error))

			prefixed ?= match prefix_module_names_with_aliases(module_name, lowered_result.program):
				Ok(result):
					Ok(result)
				Err(error):
					Err(CoreGraphFlattenError(module_name, error))

			rest ?= lower_core_modules(remaining, lowered_result.context, definition_table)

			Ok({
				context = rest.context,
				programs = [prefixed.program].concat(rest.programs),
				callable_aliases = prefixed.callable_aliases.concat(rest.callable_aliases),
			})


private pure func assemble_core_program(
	modules: List[CoreProgram],
	target: CoreProgram,
) -> CoreProgram:
	module_decls = modules.flat_map(func(program): program.decls)
	module_includes = modules.flat_map(func(program): program.foreign_includes)

	{
		decls = module_decls.concat(target.decls),
		foreign_includes = module_includes
			.concat(target.foreign_includes)
			.unique()
	}


pure func prepare_core_graph_with_ctfe_replacements(
	definition_table: DefinitionTable,
	target_module_id: ModuleId,
	target: TypedProgram,
	target_ctfe_replacements: CtfeGlobalReplacements,
	modules: CoreGraphModules,
	next_def_id: Int,
) -> Result[CorePreparedGraph, CoreGraphPrepareError]:
	module_product: CoreGraphModulesRep = from_opaque CoreGraphModules(modules)
	module_table: ModuleTable = definition_table_module_table(definition_table)

	compatible_units = if definition_tables_share_provenance(
		definition_table,
		module_product.definition_table,
	):
		Some(module_product.units)
	else:
		None

	units ?= compatible_units.to_result(
		CoreGraphModuleTableError("Core graph modules use an incompatible definition table"),
	)
	compatible_replacements = (
		ctfe_global_replacements_are_compatible(target_ctfe_replacements, definition_table)
		and units.all(
			func(unit): ctfe_global_replacements_are_compatible(unit.ctfe_replacements, definition_table),
		)
	)

	validated_units = if compatible_replacements:
		Some(units)
	else:
		None

	codegen_units ?= validated_units.to_result(
		CoreGraphModuleTableError(
			"Core graph CTFE replacements use an incompatible definition table",
		),
	)
	callable_names ?= core_graph_callable_names(
		module_table,
		target_module_id,
		target,
		codegen_units,
	).to_result(
		CoreGraphModuleTableError("Core graph contains a module ID outside its module table"),
	)
	-- Sanitize every module identity in the graph once; type lowering spells
	-- nominal `module::Type` names through this table.
	module_member_prefixes: Dict[String, String] = core_module_member_prefix_table(
		codegen_units
			.map(func(unit): unit.typed_program.source.module_name)
			.append(target.source.module_name),
	)
	initial_context = core_lower_context_with_module_member_prefixes(
		core_lower_context_with_callable_names(
			next_def_id,
			None,
			definition_table,
			target_module_id,
			callable_names,
		),
		module_member_prefixes,
	)
	lowered_modules ?= lower_core_modules(codegen_units, initial_context, definition_table)
	target_context = core_lower_context_with_module_member_prefixes(
		core_lower_context_with_callable_names(
			lowered_modules.context.next_def_id,
			None,
			definition_table,
			target_module_id,
			callable_names,
		),
		module_member_prefixes,
	)

	lowered_target_result ?= match lower_typed_program_with_ctfe_replacements(
		target_context,
		target,
		target_ctfe_replacements,
	):
		Ok(result):
			Ok(result)
		Err(error):
			Err(CoreGraphLowerError("target", error))

	assembled = assemble_core_program(lowered_modules.programs, lowered_target_result.program)
	aliased = rewrite_program_callable_aliases(assembled, lowered_modules.callable_aliases)

	entrypoint_result ?= match synthesize_program_entrypoint(
		aliased,
		lowered_target_result.context.next_def_id,
	):
		Ok(result):
			Ok(result)
		Err(error):
			Err(CoreGraphEntrypointError(error))

	entrypoint_program = entrypoint_result[0]
	entrypoint_next_def_id = entrypoint_result[1]

	ffi_program ?= match annotate_ffi_boundaries(entrypoint_program):
		Ok(program):
			Ok(program)
		Err(error):
			Err(CoreGraphFfiError(error))

	Ok({
		program = annotate_list_layouts(ffi_program),
		next_def_id = entrypoint_next_def_id,
	})


pure func prepare_core_graph(
	definition_table: DefinitionTable,
	target_module_id: ModuleId,
	target: TypedProgram,
	modules: CoreGraphModules,
	next_def_id: Int,
) -> Result[CorePreparedGraph, CoreGraphPrepareError]:
	prepare_core_graph_with_ctfe_replacements(
		definition_table,
		target_module_id,
		target,
		ctfe_global_replacements_empty(),
		modules,
		next_def_id,
	)
