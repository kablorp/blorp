import:
	../lib/runtime_sources: RuntimeSources


-- These sources are ambient because the build links the compiler's exact
-- runtime translation unit and declarations into the executable.
private func compiler_runtime_source_raw() -> String:
	builtin("blorp_compiler_runtime_source")


private func compiler_runtime_declarations_raw() -> String:
	builtin("blorp_compiler_runtime_decl")


func load_compiler_runtime_sources() -> RuntimeSources:
	{
		runtime = compiler_runtime_source_raw(),
		declarations = compiler_runtime_declarations_raw()
	}
