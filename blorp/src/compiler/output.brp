-- Rendering policy for the Blorp-owned compile/run effect boundary.
import:
	../lib/compilation: CompileObservation
	../lib/compilation_timing: CompileTiming
	pipeline: compiler_phase_label


private pure func render_core_observation(observation: CompileObservation) -> String:
	rendered: String = if observation.rendered.ends_with("\n"):
		observation.rendered
	else:
		observation.rendered + "\n"

	"===== after ${observation.stage_name} =====\n${rendered}"


pure func render_core_observations(
	source_path: String,
	observations: List[CompileObservation],
) -> String:
	if observations.length() == 0:
		""
	else:
		body: String = observations
			.map(render_core_observation)
			.join("")
		"-- blorp ${source_path}\n${body}"


private pure func render_compile_timing(timing: CompileTiming) -> String:
	milliseconds: Float = to_float(timing.microseconds) / 1000.0
	"${compiler_phase_label(timing.phase)}\t${milliseconds.to_string()} ms"


pure func render_compile_timings(timings: List[CompileTiming], outer_microseconds: Int) -> String:
	if timings.length() == 0:
		""
	else:
		var total_microseconds: Int = 0

		for timing in timings:
			total_microseconds += timing.microseconds

		rendered_timings: String = timings
			.map(render_compile_timing)
			.join("\n")
		phase_total_milliseconds: Float = to_float(total_microseconds) / 1000.0
		outer_total_milliseconds: Float = to_float(outer_microseconds) / 1000.0
		phase_summary: String = "\nphase_total\t${phase_total_milliseconds.to_string()} ms"
		outer_summary: String = "\nouter_total\t${outer_total_milliseconds.to_string()} ms"

		"Compiler phase timings\n" + rendered_timings + phase_summary + outer_summary
