-- Debug-only identity-work markers. The function profiler counts calls exactly.
-- Normal builds erase both these functions and every call to them.
-- This module has no compiler imports, so typecheck and Core can share it.
import:
	instrumentation: black_box_int


@debug_only pure func identity_work_core_var_equal() -> Int:
	black_box_int(0)


@debug_only pure func identity_work_local_scope_lookup() -> Int:
	black_box_int(0)


-- Counts only the explicitly marked constructor helpers, not all CoreVar
-- record literals. The static census records this coverage boundary.
@debug_only pure func identity_work_observed_core_var_constructor_helper_calls() -> Int:
	black_box_int(0)


-- There is currently no central ID-to-display-name accessor. This marker
-- reserves a zero-valued schema row until that authority exists.
@debug_only pure func identity_work_observed_display_lookup() -> Int:
	black_box_int(0)


-- The profiler emits a row for each called function. Register once inside a
-- measured debug/profile window and subtract one call from every marker row.
@debug_only
pure func register_identity_work_counters() -> Int:
	debug:
		identity_work_core_var_equal()
		identity_work_local_scope_lookup()
		identity_work_observed_core_var_constructor_helper_calls()
		identity_work_observed_display_lookup()

	0
