-- Build facts stamped into the CLI binary at compile time (see
-- runtime/native/build_stamp.c and BLORP_CLI_BUILD_STAMP_OBJECT in the
-- Makefile). Kept out of the generated compiler C on purpose: the values
-- change on nearly every commit, and folding them into an embedded Blorp
-- constant would force a full self-hosted recompile every time they change.
foreign(include: "runtime/native/build_stamp.h"):
	pure func blorp_build_stamp_commit() -> String
	pure func blorp_build_stamp_target() -> String
	pure func blorp_build_stamp_channel() -> String
	pure func blorp_build_stamp_dirty() -> String
	pure func blorp_build_stamp_compiled_by() -> String
	pure func blorp_build_stamp_cli_optimization() -> String
	pure func blorp_build_stamp_runtime_optimization() -> String
	pure func blorp_build_stamp_split() -> String
	pure func blorp_build_stamp_cc() -> String
	pure func blorp_memory_diagnostics_mode() -> Int


--- Render the `blorp --version` block. `version` is the semantic version
--- (from compiler_build_info); everything else is a build fact read from
--- the small stamp object the Makefile compiles fresh for every build. The
--- first five lines (version, commit, target, channel, dirty) are the release
--- provenance contract the CI and release smoke steps assert verbatim.
pure func cli_version_report(version: String) -> String:
	"blorp " + version + "\n" + "commit: " + blorp_build_stamp_commit() + "\n" + "target: " + blorp_build_stamp_target() + "\n" + "channel: " + blorp_build_stamp_channel() + "\n" + "dirty: " + blorp_build_stamp_dirty() + "\n" + "compiled_by: " + blorp_build_stamp_compiled_by() + "\n" + "optimization: cli=" + blorp_build_stamp_cli_optimization() + " runtime=" + blorp_build_stamp_runtime_optimization() + "\n" + "split: " + blorp_build_stamp_split() + "\n" + "cc: " + blorp_build_stamp_cc() + "\n" + "memory_diagnostics: " + blorp_memory_diagnostics_mode().to_string() + "\n"
