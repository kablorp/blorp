-- Public compile-command effect boundary.
--
-- Frontend preparation, Core execution, emission, observation rendering, and
-- artifact publication meet here exactly once. Parse-only AST
-- output returns before typechecking or process execution.
import:
	../lib/cli_plan: CliCompilePlan, CliHandledResult
	../lib/compilation:
		CompileArtifactOutput,
		CompileExecution(
			CompileArtifact,
			CompileBuildArtifactFailed,
			CompileCoreInvariantFailed,
			CompileEmitFailed,
			CompileFrontendFailed,
			CompileStopped,
		),
		CompileObservation,
		compile_plan_parsed_summary,
	../lib/compile_plan_execute:
		TimedCompilePlanPreparation,
		execute_prepared_compile_plan_timed,
		prepare_compile_plan_timed,
		record_compile_memory_checkpoint,
	../lib/runtime_sources: RuntimeSources
	artifact_writer: artifact_write_error_message, compile_output_path, write_compile_artifact
	fs: write_text_atomic
	output: render_compile_timings, render_core_observations


private ARTIFACT_PUBLICATION_FAILED_CHECKPOINT: String = "artifact_publication_failed"


private record CompileCommandOutputPolicy {
	ast_output: String,
	dump_file: Option[String],
	requested_output: Option[String]
}


private union CompileCommandPreparationRep:
	CompileCommandPreparationHandled(CliHandledResult)
	CompileCommandPreparationReady(CompileCommandOutputPolicy, TimedCompilePlanPreparation)


opaque type CompileCommandPreparation = CompileCommandPreparationRep


private pure func append_output(output: String, text: String) -> String:
	if text.length() == 0:
		output
	else if output.length() == 0:
		text
	else:
		output + "\n" + text


private pure func handled_error(message: String) -> CliHandledResult:
	{
		status = 1,
		stdout = "",
		stderr = message
	}


private func observation_output(
	dump_file: Option[String],
	source_path: String,
	observations: List[CompileObservation],
) -> Result[String, String]:
	rendered: String = render_core_observations(source_path, observations)

	if rendered.length() == 0:
		Ok("")
	else:
		match dump_file:
			Some(path):
				match write_text_atomic(path, rendered):
					Ok(_):
						Ok("")
					Err(error):
						Err("cannot write Core dump `${path}`: ${error.to_string()}")
			None:
				Ok(rendered)


--- What `blorp compile` reports after publishing: the single C file, or the
--- manifest of a split set together with how many translation units it lists.
private pure func artifact_publication_summary(
	artifact: CompileArtifactOutput,
	path: String,
) -> String:
	unit_count: Int = artifact.extra_units.length()

	if unit_count == 0:
		"Generated ${path}"
	else:
		"Generated ${path} (${unit_count.to_string()} translation units)"


private pure func execution_error(
	label: String,
	detail: String,
	stdout: String,
) -> CliHandledResult:
	{
		status = 1,
		stdout = stdout,
		stderr = "${label}: ${detail}"
	}


func finish_compile_command(
	policy: CompileCommandOutputPolicy,
	execution: CompileExecution,
	runtime_sources: RuntimeSources,
) -> CliHandledResult:
	ast_output = policy.ast_output

	match execution:
		CompileFrontendFailed(errors):
			{
				status = 1,
				stdout = ast_output,
				stderr = errors.join("\n")
			}
		CompileCoreInvariantFailed(detail):
			execution_error("Core invariant failure", detail, ast_output)
		CompileEmitFailed(detail):
			execution_error("internal C emission failure", detail, ast_output)
		CompileBuildArtifactFailed(detail):
			execution_error("build artifact failure", detail, ast_output)
		CompileStopped(target_path, stage_name, _, observations):
			match observation_output(policy.dump_file, target_path, observations):
				Err(message):
					{ handled_error(message) | stdout = ast_output }
				Ok(observation_stderr):
					{
						status = 0,
						stdout = ast_output,
						stderr = append_output(observation_stderr, "stopped after ${stage_name}")
					}
		CompileArtifact(target_path, artifact, observations, typed_program_summary):
			match observation_output(policy.dump_file, target_path, observations):
				Err(message):
					{ handled_error(message) | stdout = ast_output }
				Ok(observation_stderr):
					typed_output: String = typed_program_summary.get_or("")

					output_path: String = compile_output_path(target_path, policy.requested_output)

					write_result = write_compile_artifact(
						artifact,
						output_path,
						runtime_sources.runtime,
					)

					match write_result:
						Ok(path):
							{
								status = 0,
								stdout = append_output(
									append_output(ast_output, typed_output),
									artifact_publication_summary(artifact, path),
								),
								stderr = observation_stderr
							}
						Err(error):
							record_compile_memory_checkpoint(ARTIFACT_PUBLICATION_FAILED_CHECKPOINT)
							error_message: String = artifact_write_error_message(error)
							{
								status = 1,
								stdout = append_output(ast_output, typed_output),
								stderr = append_output(
									observation_stderr,
									"cannot write compile artifact: ${error_message}",
								)
							}


func prepare_compile_command(plan: CliCompilePlan) -> CompileCommandPreparation:
	if plan.options.ast_only:
		result: CliHandledResult = match compile_plan_parsed_summary(plan):
			Some(summary):
				{
					status = 0,
					stdout = summary,
					stderr = ""
				}
			None:
				handled_error("source compilation requires exactly one root module")

		into_opaque CompileCommandPreparation(CompileCommandPreparationHandled(result))
	else:
		time_phases = plan.options.time_phases

		ast_output = if plan.options.dump_ast:
			compile_plan_parsed_summary(plan).get_or("")
		else:
			""

		output_policy: CompileCommandOutputPolicy = {
			ast_output = ast_output,
			dump_file = plan.options.dump_file,
			requested_output = plan.options.output
		}
		into_opaque CompileCommandPreparation(CompileCommandPreparationReady(
				output_policy,
				prepare_compile_plan_timed(plan, time_phases),
			))


func execute_prepared_compile_command(
	preparation: CompileCommandPreparation,
	runtime_sources: RuntimeSources,
) -> CliHandledResult:
	representation: CompileCommandPreparationRep = from_opaque CompileCommandPreparation(
		preparation
	)

	match representation:
		CompileCommandPreparationHandled(result):
			result
		CompileCommandPreparationReady(output_policy, timed_preparation):
			timed = execute_prepared_compile_plan_timed(timed_preparation)
			result = finish_compile_command(output_policy, timed.execution, runtime_sources)
			{ result | stderr = append_output(
					result.stderr,
					render_compile_timings(timed.timings, timed.outer_microseconds),
				) }
