import:
	../stage_03_parse/parsed_ast:
		ParsedDecl(
			BuiltinTypeParsedDecl,
			PrivateParsedDecl,
			RecordParsedDecl,
			TypeAliasParsedDecl,
			UnionParsedDecl,
		),


private pure func append_unique_type_name(names: List[String], name: String) -> List[String]:
	if names.contains(name):
		names
	else:
		names.append(name)


private pure func collect_local_type_name(names: List[String], decl: ParsedDecl) -> List[String]:
	match decl:
		RecordParsedDecl(record_decl):
			append_unique_type_name(names, record_decl.name.text)
		UnionParsedDecl(union_decl):
			append_unique_type_name(names, union_decl.name.text)
		BuiltinTypeParsedDecl(type_decl):
			append_unique_type_name(names, type_decl.name.text)
		TypeAliasParsedDecl(type_alias_decl):
			append_unique_type_name(names, type_alias_decl.name.text)
		PrivateParsedDecl(inner, _):
			collect_local_type_name(names, inner)
		_:
			names


pure func local_type_names_from_decls(decls: List[ParsedDecl]) -> List[String]:
	var names: List[String] = []

	for decl in decls:
		names = collect_local_type_name(names, decl)

	names.sort()
