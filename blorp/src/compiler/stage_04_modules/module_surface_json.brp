-- JSON projection for Blorp-owned syntactic module surfaces.
import:
	json: JsonValue(JsonNumber, JsonObject, JsonString, JsonVector)
	module_surface:
		ModuleSurface,
		ModuleSurfaceSymbol,
		ModuleSurfaceSymbolKind,
		ModuleSurfaceSymbolSource(
			DeclSurfaceSource,
			ImplMethodSurfaceSource,
			PrivateDeclSurfaceSource,
			PrivateImplMethodSurfaceSource,
			PrivateTraitMethodSurfaceSource,
			TraitMethodSurfaceSource,
		),
		module_surface_symbol_kind_name,
		module_surface_symbol_source_kind,


private pure func int_to_json(value: Int) -> JsonValue:
	JsonNumber(to_float(value))


private pure func module_surface_symbol_kind_to_json(kind: ModuleSurfaceSymbolKind) -> JsonValue:
	JsonString(module_surface_symbol_kind_name(kind))


private pure func module_surface_symbol_source_to_json(
	source: ModuleSurfaceSymbolSource,
) -> JsonValue:
	match source:
		DeclSurfaceSource(decl_index):
			JsonObject([
				("kind", JsonString(module_surface_symbol_source_kind(source))),
				("decl_index", int_to_json(decl_index)),
			])
		TraitMethodSurfaceSource(decl_index, method_index):
			JsonObject([
				("kind", JsonString(module_surface_symbol_source_kind(source))),
				("decl_index", int_to_json(decl_index)),
				("method_index", int_to_json(method_index)),
			])
		ImplMethodSurfaceSource(decl_index, method_index):
			JsonObject([
				("kind", JsonString(module_surface_symbol_source_kind(source))),
				("decl_index", int_to_json(decl_index)),
				("method_index", int_to_json(method_index)),
			])
		PrivateDeclSurfaceSource(decl_index):
			JsonObject([
				("kind", JsonString(module_surface_symbol_source_kind(source))),
				("decl_index", int_to_json(decl_index)),
			])
		PrivateTraitMethodSurfaceSource(decl_index, method_index):
			JsonObject([
				("kind", JsonString(module_surface_symbol_source_kind(source))),
				("decl_index", int_to_json(decl_index)),
				("method_index", int_to_json(method_index)),
			])
		PrivateImplMethodSurfaceSource(decl_index, method_index):
			JsonObject([
				("kind", JsonString(module_surface_symbol_source_kind(source))),
				("decl_index", int_to_json(decl_index)),
				("method_index", int_to_json(method_index)),
			])


private pure func module_surface_symbol_to_json(symbol: ModuleSurfaceSymbol) -> JsonValue:
	JsonObject([
		("name", JsonString(symbol.name)),
		("kind", module_surface_symbol_kind_to_json(symbol.kind)),
		("source", module_surface_symbol_source_to_json(symbol.source)),
	])


pure func module_surface_to_json(surface: ModuleSurface) -> JsonValue:
	JsonObject([
		("kind", JsonString("module_surface")),
		("module", JsonString(surface.module_name)),
		(
			"imports",
			JsonVector(
				surface.import_paths.map(func(import_path: String):
					JsonObject([("module_path", JsonString(import_path))])
				),
			),
		),
		("exports", JsonVector(surface.exports.map(module_surface_symbol_to_json))),
		("private_names", JsonVector(surface.private_names.map(module_surface_symbol_to_json))),
		("private_traits", JsonVector(surface.private_traits.map(
				func(item: String): JsonString(item),
			))),
	])
