-- Validated module-loading products shared by graph indexing and typechecking.
--
-- A load candidate carries two intentionally distinct identities: the source
-- module name retained by parsing and the canonical path chosen by resolution.
-- Its representation is opaque so later phases cannot accidentally rewrite
-- either fact. The accepted set rejects duplicate canonical identities.
import:
	../stage_03_parse/parsed_ast: ParsedProgram
	../stage_03_parse/source_ast_finalize:
		FinalizedTypecheckProgram,
		finalized_typecheck_program_ast,


union ModuleOrigin:
	StdlibModule
	NativePackageModule(String)
	SourcePackageModule(String)
	UserModule


pure func module_origins_equal(left: ModuleOrigin, right: ModuleOrigin) -> Bool:
	match (left, right):
		(StdlibModule, StdlibModule):
			True
		(NativePackageModule(left_name), NativePackageModule(right_name)):
			left_name == right_name
		(SourcePackageModule(left_name), SourcePackageModule(right_name)):
			left_name == right_name
		(UserModule, UserModule):
			True
		_:
			False


private record ResolvedModuleIdentityRep {
	canonical_path: String,
	origin: ModuleOrigin
}


opaque type ResolvedModuleIdentity = ResolvedModuleIdentityRep


private pure func resolved_module_identity_rep(
	identity: ResolvedModuleIdentity,
) -> ResolvedModuleIdentityRep:
	from_opaque ResolvedModuleIdentity(identity)


-- This is the explicit handoff from module resolution. Later phases receive
-- the opaque result and cannot vary canonical path independently from origin.
pure func resolved_module_identity_from_resolver(
	canonical_path: String,
	origin: ModuleOrigin,
) -> ResolvedModuleIdentity:
	representation: ResolvedModuleIdentityRep = {
		canonical_path = canonical_path,
		origin = origin
	}
	into_opaque ResolvedModuleIdentity(representation)


pure func resolved_module_canonical_path(identity: ResolvedModuleIdentity) -> String:
	representation = resolved_module_identity_rep(identity)
	representation.canonical_path


pure func resolved_module_origin(identity: ResolvedModuleIdentity) -> ModuleOrigin:
	representation = resolved_module_identity_rep(identity)
	representation.origin


pure func resolved_module_identities_equal(
	left: ResolvedModuleIdentity,
	right: ResolvedModuleIdentity,
) -> Bool:
	(
		resolved_module_canonical_path(left) == resolved_module_canonical_path(right)
		and module_origins_equal(resolved_module_origin(left), resolved_module_origin(right))
	)


private pure func module_origin_storage_key(origin: ModuleOrigin) -> String:
	match origin:
		StdlibModule:
			"stdlib"
		NativePackageModule(package_id):
			"native:" + identity_key_component(package_id)
		SourcePackageModule(package_alias):
			"source:" + identity_key_component(package_alias)
		UserModule:
			"user"


pure func resolved_module_identity_storage_key(identity: ResolvedModuleIdentity) -> String:
	identity_key_component(
		resolved_module_canonical_path(
			identity,
		),
	) + module_origin_storage_key(resolved_module_origin(identity))


pure func module_identity_from_resolved(identity: ResolvedModuleIdentity) -> ModuleIdentity:
	representation = LoadedModuleIdentityRep(
		resolved_module_canonical_path(identity),
		resolved_module_origin(identity),
	)
	into_opaque ModuleIdentity(representation)


private record ModuleLoadCandidateRep {
	resolved_identity: ResolvedModuleIdentity,
	program: FinalizedTypecheckProgram
}


opaque type ModuleLoadCandidate = ModuleLoadCandidateRep


pure func module_load_candidate(
	resolved_identity: ResolvedModuleIdentity,
	program: FinalizedTypecheckProgram,
) -> ModuleLoadCandidate:
	representation: ModuleLoadCandidateRep = {
		resolved_identity = resolved_identity,
		program = program
	}
	into_opaque ModuleLoadCandidate(representation)


pure func module_load_candidate_canonical_path(candidate: ModuleLoadCandidate) -> String:
	representation: ModuleLoadCandidateRep = from_opaque ModuleLoadCandidate(candidate)
	resolved_module_canonical_path(representation.resolved_identity)


pure func module_load_candidate_program(candidate: ModuleLoadCandidate) -> ParsedProgram:
	representation: ModuleLoadCandidateRep = from_opaque ModuleLoadCandidate(candidate)
	finalized_typecheck_program_ast(representation.program)


pure func module_load_candidate_origin(candidate: ModuleLoadCandidate) -> ModuleOrigin:
	representation: ModuleLoadCandidateRep = from_opaque ModuleLoadCandidate(candidate)
	resolved_module_origin(representation.resolved_identity)


private union ModuleIdentityRep:
	LoadedModuleIdentityRep(String, ModuleOrigin)
	DirectModuleIdentityRep(String, String)
	SurfaceModuleIdentityRep(String)
	AnonymousModuleIdentityRep


opaque type ModuleIdentity = ModuleIdentityRep


private pure func module_identity_rep(identity: ModuleIdentity) -> ModuleIdentityRep:
	from_opaque ModuleIdentity(identity)


private record LoadedModuleRep {
	canonical_path: String,
	identity: ModuleIdentity,
	program: ParsedProgram,
	origin: ModuleOrigin
}


opaque type LoadedModule = LoadedModuleRep


record LoadedModuleSetError {
	identity: ModuleIdentity,
	first_path: String,
	duplicate_path: String
}


private record LoadedModuleSetRep {
	target: LoadedModule,
	modules: List[LoadedModule]
}


opaque type LoadedModuleSet = LoadedModuleSetRep


private pure func loaded_module_from_valid_candidate(
	candidate: ModuleLoadCandidate,
) -> LoadedModule:
	canonical_path = module_load_candidate_canonical_path(candidate)
	identity_representation = LoadedModuleIdentityRep(
		canonical_path,
		module_load_candidate_origin(candidate),
	)
	identity = into_opaque ModuleIdentity(identity_representation)
	representation: LoadedModuleRep = {
		canonical_path = canonical_path,
		identity = identity,
		program = module_load_candidate_program(candidate),
		origin = module_load_candidate_origin(candidate)
	}
	into_opaque LoadedModule(representation)


pure func loaded_module_set(
	target_candidate: ModuleLoadCandidate,
	module_candidates: List[ModuleLoadCandidate],
) -> Result[LoadedModuleSet, List[LoadedModuleSetError]]:
	var source_path_by_identity: Dict[String, String] = {}
	var errors: List[LoadedModuleSetError] = []

	target_canonical_path = module_load_candidate_canonical_path(target_candidate)
	target_program = module_load_candidate_program(target_candidate)
	source_path_by_identity = source_path_by_identity.set(
		resolved_module_identity_storage_key(
			resolved_module_identity_from_resolver(
				target_canonical_path,
				module_load_candidate_origin(target_candidate),
			),
		),
		target_program.source.path,
	)

	for candidate in module_candidates:
		canonical_path = module_load_candidate_canonical_path(candidate)
		program = module_load_candidate_program(candidate)
		identity_key = resolved_module_identity_storage_key(
			resolved_module_identity_from_resolver(
				canonical_path,
				module_load_candidate_origin(candidate),
			),
		)

		match source_path_by_identity.get(identity_key):
			Some(first_source_path):
				identity_representation = LoadedModuleIdentityRep(
					canonical_path,
					module_load_candidate_origin(candidate),
				)
				identity = into_opaque ModuleIdentity(identity_representation)
				errors = errors.append({
					identity = identity,
					first_path = first_source_path,
					duplicate_path = program.source.path,
				})
			None:
				source_path_by_identity = source_path_by_identity.set(
					identity_key,
					program.source.path,
				)

	if errors.length() > 0:
		Err(errors)
	else:
		target = loaded_module_from_valid_candidate(target_candidate)
		modules = module_candidates.map(loaded_module_from_valid_candidate)
		representation: LoadedModuleSetRep = {
			target = target,
			modules = modules
		}
		Ok(into_opaque LoadedModuleSet(representation))


pure func loaded_module_set_target(modules: LoadedModuleSet) -> LoadedModule:
	representation: LoadedModuleSetRep = from_opaque LoadedModuleSet(modules)
	representation.target


pure func loaded_module_set_modules(modules: LoadedModuleSet) -> List[LoadedModule]:
	representation: LoadedModuleSetRep = from_opaque LoadedModuleSet(modules)
	representation.modules


pure func loaded_module_identity(module: LoadedModule) -> ModuleIdentity:
	representation: LoadedModuleRep = from_opaque LoadedModule(module)
	representation.identity


pure func loaded_module_canonical_path(module: LoadedModule) -> String:
	representation: LoadedModuleRep = from_opaque LoadedModule(module)
	representation.canonical_path


pure func loaded_module_program(module: LoadedModule) -> ParsedProgram:
	representation: LoadedModuleRep = from_opaque LoadedModule(module)
	representation.program


pure func loaded_module_origin(module: LoadedModule) -> ModuleOrigin:
	representation: LoadedModuleRep = from_opaque LoadedModule(module)
	representation.origin


pure func module_identity_for_program(program: ParsedProgram) -> ModuleIdentity:
	representation = DirectModuleIdentityRep(program.source.path, program.source.module_name)
	into_opaque ModuleIdentity(representation)


pure func module_identity_for_compiler_surface(surface_name: String) -> ModuleIdentity:
	into_opaque ModuleIdentity(SurfaceModuleIdentityRep(surface_name))


private ANONYMOUS_IDENTITY_REP: ModuleIdentityRep = AnonymousModuleIdentityRep

ANONYMOUS_IDENTITY: ModuleIdentity = into_opaque ModuleIdentity(ANONYMOUS_IDENTITY_REP)


pure func module_identity_display_name(identity: ModuleIdentity) -> String:
	representation = module_identity_rep(identity)

	match representation:
		LoadedModuleIdentityRep(canonical_path, _):
			canonical_path
		DirectModuleIdentityRep(_, module_name):
			module_name
		SurfaceModuleIdentityRep(surface_name):
			"<compiler:" + surface_name + ">"
		AnonymousModuleIdentityRep:
			"<direct-typecheck>"


-- Import resolution stores canonical module paths. Keep this comparison on the
-- opaque identity boundary so callers never infer identity kind from display
-- text, which is intentionally only diagnostic.
pure func module_identity_matches_canonical_path(
	identity: ModuleIdentity,
	canonical_path: String,
) -> Bool:
	match module_identity_rep(identity):
		LoadedModuleIdentityRep(path, _):
			path == canonical_path
		DirectModuleIdentityRep(_, _):
			False
		SurfaceModuleIdentityRep(_):
			False
		AnonymousModuleIdentityRep:
			False


-- Typechecking may operate either on a resolver-owned loaded module or on one
-- direct parsed program. Both variants carry an explicit current module path;
-- compare that identity instead of inferring ownership from a source filename.
pure func module_identity_matches_module_path(
	identity: ModuleIdentity,
	module_path: String,
) -> Bool:
	match module_identity_rep(identity):
		LoadedModuleIdentityRep(path, _):
			path == module_path
		DirectModuleIdentityRep(_, module_name):
			module_name == module_path
		SurfaceModuleIdentityRep(_):
			False
		AnonymousModuleIdentityRep:
			False


private pure func identity_key_component(value: String) -> String:
	-- Length-prefixing makes adjacent components unambiguous without escaping
	-- source paths or module names. The variant prefix keeps identity kinds
	-- disjoint even when their display names happen to match.
	value
		.length()
		.to_string() + ":" + value


pure func module_identity_storage_key(identity: ModuleIdentity) -> String:
	representation = module_identity_rep(identity)

	match representation:
		LoadedModuleIdentityRep(canonical_path, origin):
			"loaded:" + identity_key_component(canonical_path) + module_origin_storage_key(origin)
		DirectModuleIdentityRep(path, module_name):
			"direct:" + identity_key_component(path) + identity_key_component(module_name)
		SurfaceModuleIdentityRep(surface_name):
			"compiler:" + identity_key_component(surface_name)
		AnonymousModuleIdentityRep:
			"anonymous"


pure func module_identities_equal(left: ModuleIdentity, right: ModuleIdentity) -> Bool:
	left_representation = module_identity_rep(left)
	right_representation = module_identity_rep(right)

	match (left_representation, right_representation):
		(LoadedModuleIdentityRep(left_path, left_origin), LoadedModuleIdentityRep(right_path, right_origin)):
			left_path == right_path and module_origins_equal(left_origin, right_origin)
		(DirectModuleIdentityRep(left_path, left_module), DirectModuleIdentityRep(right_path, right_module)):
			left_path == right_path and left_module == right_module
		(SurfaceModuleIdentityRep(left_name), SurfaceModuleIdentityRep(right_name)):
			left_name == right_name
		(AnonymousModuleIdentityRep, AnonymousModuleIdentityRep):
			True
		_:
			False
