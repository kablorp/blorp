-- Pure source-package identity and export policy shared by compiler clients.
--
-- Filesystem discovery constructs this value from a validated package manifest.
-- Import providers use it without rereading manifests, so CLI and LSP apply the
-- same alias, declared-name, export, and package-confinement rules.
import:
	path: join, normalize


record SourcePackageLayout {
	package_alias: String,
	package_name: String,
	source_dir: String,
	exports: List[String]
}


private pure func split_module_ref(module_path: String) -> Option[(String, String)]:
	match module_path.split("/"):
		[]:
			None
		[""]:
			None
		[head]:
			Some((head, ""))
		[head, ...rest]:
			if head == "":
				None
			else:
				Some((head, rest.join("/")))


private pure func module_source_filename(module_path: String) -> String:
	if module_path.ends_with(".brp"):
		module_path
	else:
		module_path + ".brp"


pure func source_package_export_for_alias(
	package: SourcePackageLayout,
	requested_path: String,
) -> Option[String]:
	parts ?= split_module_ref(requested_path)

	if parts[0] != package.package_alias:
		None
	else:
		package_module = if parts[1] == "":
			package.package_name
		else:
			package.package_name + "/" + parts[1]

		if package.exports.contains(package_module):
			Some(package_module)
		else:
			None


pure func source_package_contains_internal_module(
	package: SourcePackageLayout,
	module_path: String,
) -> Bool:
	module_path == package.package_name or module_path.starts_with(package.package_name + "/")


pure func source_package_path_for_module(
	package: SourcePackageLayout,
	module_path: String,
) -> String:
	normalize(join(package.source_dir, module_source_filename(module_path)))
