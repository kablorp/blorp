-- Shared frontend graph discovery over compiler-owned source candidates.
--
-- Effectful source providers resolve filesystem/package candidates at this
-- boundary. This service owns the deterministic walk and production parsing,
-- then validates the exact typed graph used by CLI and LSP.
import:
	../../lib/source: SourceFile
	../stage_03_parse/language_parser: parse_compiler_source
	../stage_03_parse/source_ast_finalize:
		finalized_typecheck_program,
		finalized_typecheck_program_ast,
	frontend_graph:
		FrontendGraph,
		FrontendGraphError,
		FrontendImportEdge,
		FrontendImportResolution(FrontendResolvedImport, FrontendUnresolvedImport),
		FrontendModule,
		frontend_graph,
		frontend_graph_error_message,
	loaded_module:
		ResolvedModuleIdentity,
		resolved_module_canonical_path,
		resolved_module_identity_storage_key,
	module_surface: module_surface_for_program


union FrontendGraphServiceError:
	FrontendGraphValidationFailed(List[FrontendGraphError])
	MissingCompilerFrontendImportOutcome(ResolvedModuleIdentity, String)
	DuplicateCompilerFrontendImportOutcome(ResolvedModuleIdentity, String)
	UndeclaredCompilerFrontendImportOutcome(ResolvedModuleIdentity, String)


record FrontendSourceCandidate {
	identity: ResolvedModuleIdentity,
	source: SourceFile
}


union FrontendSourceResolution:
	FrontendSourceResolved(FrontendSourceCandidate)
	FrontendSourceUnresolved


union FrontendDiscoveryError:
	FrontendDiscoveryProviderFailed(ResolvedModuleIdentity, String, String)
	FrontendDiscoveryIdentityConflict(FrontendSourceCandidate, FrontendSourceCandidate)
	FrontendDiscoveryGraphFailed(List[FrontendGraphServiceError])


private record DiscoveredFrontendSource {
	candidate: FrontendSourceCandidate,
	module: FrontendModule
}


private record FrontendImportValidationIndex {
	modules_by_identity: Dict[String, FrontendModule],
	declared_imports: Dict[String, Bool],
	outcome_counts: Dict[String, Int]
}


private pure func import_fact_key(identity_key: String, requested_path: String) -> String:
	identity_key
		.length()
		.to_string() + ":" + identity_key + requested_path


private pure func import_outcome_count(counts: Dict[String, Int], fact_key: String) -> Int:
	match counts.get(fact_key):
		Some(found):
			found
		None:
			0


private COMPILER_FRONTEND_PRELUDE_MODULE: String = "prelude"

private COMPILER_FRONTEND_TUPLE_IMPL_MODULE: String = "tuple"

COMPILER_FRONTEND_IMPLICIT_MODULE_PATHS: List[String] = [
	COMPILER_FRONTEND_PRELUDE_MODULE,
	COMPILER_FRONTEND_TUPLE_IMPL_MODULE,
]


pure func frontend_graph_service_error_message(error: FrontendGraphServiceError) -> String:
	match error:
		FrontendGraphValidationFailed(errors):
			errors
				.map(frontend_graph_error_message)
				.join("\n")
		MissingCompilerFrontendImportOutcome(importer, requested_path):
			"compiler frontend import `" + requested_path + "` from `" + resolved_module_canonical_path(
				importer,
			) + "` has no resolution outcome"
		DuplicateCompilerFrontendImportOutcome(importer, requested_path):
			"compiler frontend import `" + requested_path + "` from `" + resolved_module_canonical_path(
				importer,
			) + "` has multiple resolution outcomes"
		UndeclaredCompilerFrontendImportOutcome(importer, requested_path):
			"compiler frontend import outcome `" + requested_path + "` from `" + resolved_module_canonical_path(
				importer,
			) + "` has no corresponding source import"


pure func frontend_discovery_error_message(error: FrontendDiscoveryError) -> String:
	match error:
		FrontendDiscoveryProviderFailed(importer, requested_path, message):
			"failed to resolve compiler frontend import `" + requested_path + "` from `" + resolved_module_canonical_path(
				importer,
			) + "`: " + message
		FrontendDiscoveryIdentityConflict(first, second):
			"compiler frontend module identity `" + resolved_module_canonical_path(
				first.identity,
			) + "` resolves to both `" + first.source.path + "` and `" + second.source.path + "`"
		FrontendDiscoveryGraphFailed(errors):
			errors
				.map(frontend_graph_service_error_message)
				.join("\n")


private pure func frontend_import_validation_index(
	modules: List[FrontendModule],
	edges: List[FrontendImportEdge],
) -> FrontendImportValidationIndex:
	var modules_by_identity: Dict[String, FrontendModule] = {}
	var declared_imports: Dict[String, Bool] = {}
	var outcome_counts: Dict[String, Int] = {}

	for module in modules:
		identity_key = resolved_module_identity_storage_key(module.identity)

		for requested_path in module.surface.import_paths:
			declared_imports = declared_imports.set(
				import_fact_key(identity_key, requested_path),
				True,
			)

		modules_by_identity = modules_by_identity.set(identity_key, module)

	for edge in edges:
		identity_key = resolved_module_identity_storage_key(edge.importer)
		fact_key = import_fact_key(identity_key, edge.requested_path)
		count = import_outcome_count(outcome_counts, fact_key)
		outcome_counts = outcome_counts.set(fact_key, count + 1)

	{
		modules_by_identity = modules_by_identity,
		declared_imports = declared_imports,
		outcome_counts = outcome_counts
	}


private pure func import_outcome_errors(
	modules: List[FrontendModule],
	index: FrontendImportValidationIndex,
) -> List[FrontendGraphServiceError]:
	var errors: List[FrontendGraphServiceError] = []

	for module in modules:
		identity_key = resolved_module_identity_storage_key(module.identity)

		for requested_path in module.surface.import_paths:
			count = import_outcome_count(
				index.outcome_counts,
				import_fact_key(identity_key, requested_path),
			)

			if count == 0:
				errors = errors.append(
					MissingCompilerFrontendImportOutcome(
						module.identity,
						requested_path,
					),
				)
			else if count > 1:
				errors = errors.append(
					DuplicateCompilerFrontendImportOutcome(
						module.identity,
						requested_path,
					),
				)

	errors


private pure func edge_without_import_errors(
	index: FrontendImportValidationIndex,
	edges: List[FrontendImportEdge],
) -> List[FrontendGraphServiceError]:
	edges.filter_map(func(edge) -> Option[FrontendGraphServiceError]:
		identity_key = resolved_module_identity_storage_key(edge.importer)
		importer = index.modules_by_identity.get(identity_key)

		match importer:
			None:
				-- The graph validator reports the missing endpoint.
				None
			Some(_module):
				if index.declared_imports.contains(
					import_fact_key(
						identity_key,
						edge.requested_path,
					),
				):
					None
				else:
					Some(
						UndeclaredCompilerFrontendImportOutcome(
							edge.importer,
							edge.requested_path,
						),
					)
	)


pure func frontend_graph_for_sources(
	modules: List[FrontendModule],
	roots: List[ResolvedModuleIdentity],
	import_edges: List[FrontendImportEdge],
) -> Result[FrontendGraph, List[FrontendGraphServiceError]]:
	match frontend_graph(modules, roots, import_edges):
		Err(errors):
			Err([FrontendGraphValidationFailed(errors)])
		Ok(graph):
			index = frontend_import_validation_index(modules, import_edges)
			errors = import_outcome_errors(
				modules,
				index,
			).concat(edge_without_import_errors(index, import_edges))

			if errors.length() > 0:
				Err(errors)
			else:
				Ok(graph)


private pure func discover_frontend_source(
	candidate: FrontendSourceCandidate,
) -> DiscoveredFrontendSource:
	program = finalized_typecheck_program(parse_compiler_source(candidate.source))

	{
		candidate = candidate,
		module = {
			identity = candidate.identity,
			program = program,
			surface = module_surface_for_program(finalized_typecheck_program_ast(program))
		}
	}


private pure func same_candidate_source(
	left: FrontendSourceCandidate,
	right: FrontendSourceCandidate,
) -> Bool:
	(
		left.source.path == right.source.path
		and left.source.module_name == right.source.module_name
		and left.source.text == right.source.text
	)


private pure func discovered_source_index(
	discovered: List[DiscoveredFrontendSource],
) -> Dict[String, DiscoveredFrontendSource]:
	var index: Dict[String, DiscoveredFrontendSource] = {}

	for source in discovered:
		key = resolved_module_identity_storage_key(source.candidate.identity)

		if not index.contains(key):
			index = index.set(key, source)

	index


-- The source provider owns effects and package policy. This service owns the
-- deterministic walk, production parsing, exact edge construction, cycle
-- termination, and final graph validation shared by every compiler client.
func frontend_graph_discover(
	roots: List[FrontendSourceCandidate],
	seed_modules: List[FrontendSourceCandidate],
	resolve: (FrontendSourceCandidate, String) -> Result[FrontendSourceResolution, String],
) -> Result[FrontendGraph, FrontendDiscoveryError]:
	var discovered = roots
		.concat(seed_modules)
		.map(discover_frontend_source)
	var discovered_by_identity = discovered_source_index(discovered)
	var pending = discovered
	var edges: List[FrontendImportEdge] = []
	var error: Option[FrontendDiscoveryError] = None

	while pending.length() > 0 and error.is_none():
		match pending:
			[]:
				void
			[discovered_importer, ...remaining]:
				pending = remaining
				importer = discovered_importer.candidate

				for requested_path in discovered_importer.module.surface.import_paths:
					if error.is_none():
						match resolve(importer, requested_path):
							Err(message):
								error = Some(
									FrontendDiscoveryProviderFailed(
										importer.identity,
										requested_path,
										message,
									),
								)
							Ok(FrontendSourceUnresolved):
								edges = edges.append({
									importer = importer.identity,
									requested_path = requested_path,
									resolution = FrontendUnresolvedImport,
								})
							Ok(FrontendSourceResolved(target)):
								edges = edges.append({
									importer = importer.identity,
									requested_path = requested_path,
									resolution = FrontendResolvedImport(target.identity),
								})

								target_key = resolved_module_identity_storage_key(target.identity)

								match discovered_by_identity.get(target_key):
									None:
										discovered_target = discover_frontend_source(target)
										discovered = discovered.append(discovered_target)
										discovered_by_identity = discovered_by_identity.set(
											target_key,
											discovered_target,
										)
										pending = pending.append(discovered_target)
									Some(existing):
										if not same_candidate_source(existing.candidate, target):
											error = Some(
												FrontendDiscoveryIdentityConflict(
													existing.candidate,
													target,
												),
											)

	match error:
		Some(found):
			Err(found)
		None:
			modules = discovered.map(func(source): source.module)
			root_identities = roots.map(func(root): root.identity)

			match frontend_graph_for_sources(modules, root_identities, edges):
				Ok(graph):
					Ok(graph)
				Err(errors):
					Err(FrontendDiscoveryGraphFailed(errors))
