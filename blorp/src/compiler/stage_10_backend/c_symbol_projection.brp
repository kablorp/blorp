-- Deterministic artifact-local callable symbol planning.
--
-- Projection happens only after the final Core pipeline has completed. This
-- module therefore encodes validated artifact-wide definition IDs while
-- retaining semantic names in every earlier compiler phase.
import:
	../stage_09_core/c_type_layout as TypeLayout
	../stage_09_core/ir:
		CoreCallKind(
			ClosureCall,
			DeferredTraitCall,
			DictWithCapacityCall,
			ForeignCall,
			ListToStringCall,
			SelectedDirectCall,
			SelectedTraitCall,
			UnknownCall,
			UserCall,
		),
		CoreDecl(
			EnumDecl,
			FunctionDecl,
			GlobalDecl,
			HeapRecordDecl,
			ImplDecl,
			TraitDecl,
			TypeAliasDecl,
			UnionDecl,
			ValueRecordDecl,
		),
		CoreExpr(
			CallExpr,
			ClosureCreateExpr,
			ConcurrentExpr,
			ConcurrentlyLoopExpr,
			DetachExpr,
			DictConstructExpr,
			ListConstructExpr,
			LiteralExpr,
			RecordConstructExpr,
			SeqExpr,
			SetAllocExpr,
			StaticStringLiteralExpr,
			TupleConstructExpr,
			UnionConstructExpr,
			VarExpr,
		),
		CoreFunction,
		CoreFunctionKind(
			BuiltinFunction,
			ClosureBodyFunction,
			ForeignFunction,
			ProgramEntrypointFunction,
			UnresolvedBuiltinFunction,
			UserFunction,
		),
		CoreHashContainerConstructor(CustomHashContainerConstructor),
		CoreLiteral(StringLiteral),
		CoreProgram,
		CoreTaskClosure,
		CoreTupleElement(
			TupleFloat16Element,
			TupleFloat32Element,
			TupleFloatElement,
			TuplePointerElement,
			TuplePrimElement,
			TupleStackResultElement,
			TupleStructElement,
			TupleVoidElement,
		),
		CoreType(FunctionType),
		core_expr_type,
	../stage_09_core/late_invariants: check_definition_id_uniqueness, core_late_invariant_message
	../stage_09_core/traverse as CoreTraverse
	c_naming:
		BUILTIN_STACK_OPTION_INT128_OPTION_C_TYPE,
		BUILTIN_STACK_OPTION_RANGE_OPTION_C_TYPE,
		BUILTIN_STACK_OPTION_UINT128_OPTION_C_TYPE,
		BackendTypeNaming,
		backend_type_naming,
		c_identifier,
		c_local_name,
		static_child_path,
		static_closure_name,
		static_list_child_path,
		static_list_storage_name,
		static_record_storage_name,
		static_tuple_child_path,
		static_tuple_storage_name,
		static_union_child_path,
		static_union_storage_name,
		union_init_name,
		union_instance_name,
		union_reuse_name,
	canonical_empty_list:
		CanonicalEmptyList,
		canonical_empty_list_for_construct,
		canonical_empty_list_layout_is_valid,
		canonical_empty_list_symbol_names,
		canonical_empty_lists_add,
		canonical_empty_lists_sorted,
	static_string_literal_pool:
		BackendStaticStringLiteral,
		BackendStaticStringLiteralPool,
		StaticStringLiteralPoolError,
		backend_static_string_literal_pool_add,
		backend_static_string_literal_pool_reject_unpooled,
		empty_backend_static_string_literal_pool,
		finish_backend_static_string_literal_pool,


enum CProjectedCallableKind:
	ProjectedUserFunction
	ProjectedClosureBody


record CCallableSymbolCandidate {
	kind: CProjectedCallableKind,
	qualified_name: String,
	def_id: Int,
	original_c_spelling: String
}


record CCallableSymbol {
	kind: CProjectedCallableKind,
	qualified_name: String,
	def_id: Int,
	original_c_spelling: String,
	projected_name: String
}


record CCallableSymbolPlan {
	by_definition_id: Dict[Int, CCallableSymbol],
	by_original_c_spelling: Dict[String, CCallableSymbol]
}


private record CEmissionCallablePlan {
	by_definition_id: Dict[Int, String],
	by_original_c_spelling: Dict[String, String]
}


private record CProgramSymbolInventory {
	candidates: List[CCallableSymbolCandidate],
	preserved_names: List[String],
	type_naming: Dict[String, BackendTypeNaming],
	type_symbol_lookup: Dict[String, String]
}


union CSymbolProjectionError:
	DuplicateCallableDefinitionId(Int, String, String)
	DuplicateCallableIdentity(String, Int)
	DuplicateCallableCName(String)
	InvalidCoreDefinitionIdentity(String)
	InvalidCallableDefinitionId(Int, String)
	MissingProjectedCallable(String, Int)
	UnresolvedProjectedCallable(String)
	UnresolvedCallbackTarget(String)
	CallableCNameMismatch(String, String)
	UnsupportedPreparedCallKind(String)
	UnprojectedCallableValue(String, Int)
	InvalidCanonicalEmptyListLayout(String)
	CanonicalEmptyListSymbolCollision(String)


private record CEmissionSymbolPlanRep {
	callables: CEmissionCallablePlan,
	canonical_empty_lists: List[CanonicalEmptyList],
	foreign_boundary_types: List[CoreType],
	static_string_literals: Result[List[BackendStaticStringLiteral], StaticStringLiteralPoolError],
	preserved_symbol_count: Int,
	type_naming: Dict[String, BackendTypeNaming],
	type_symbol_lookup: Dict[String, String]
}


private record CProjectionValidation {
	error: Option[CSymbolProjectionError],
	canonical_empty_lists: List[CanonicalEmptyList],
	foreign_boundary_types: List[CoreType],
	static_string_literal_pool: BackendStaticStringLiteralPool
}


opaque type CEmissionSymbolPlan = CEmissionSymbolPlanRep

private BASE62_ALPHABET: String = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"

private BASE62_RADIX: Int = 62

-- `brp_` is the compiler-owned C namespace. The delimiter keeps numeric IDs
-- from spelling ordinary declarations from system headers (one undelimited
-- definition ID encoded to `brk`) without paying for the full `blorp_` prefix.
private PROJECTED_CALLABLE_PREFIX: String = "brp_"

-- Distinct from `PROJECTED_CALLABLE_PREFIX`: an artifact-local type has no
-- definition ID to encode, so its base symbol is minted from a local
-- declaration-order index instead. The extra underscore is deliberate: a
-- callable spelling is always `brp_` followed directly by a base-62 digit
-- (never an underscore), so a type base symbol and every name derived from
-- it (`_destroy`, `_make`, ...) can never collide with a callable spelling
-- by construction, independent of the def-id-keyed collision table.
private PROJECTED_TYPE_PREFIX: String = "brp_ty"

-- Validation makes this branch unreachable. Keeping an unmistakably invalid
-- internal symbol here ensures future validator/projector drift cannot emit a
-- partially projected reference to the original callable.
private INVALID_PROJECTED_CALLABLE_NAME: String = "__blorp_invalid_projected_callable"


private pure func encode_callable_id(def_id: Int) -> String:
	var remaining: Int = def_id
	var payload: String = ""

	while remaining > 0:
		digit: Int = remaining % BASE62_RADIX
		payload = BASE62_ALPHABET.substring(digit, 1) + payload
		remaining /= BASE62_RADIX

	if payload.is_empty():
		"0"
	else:
		payload


pure func projected_callable_base_symbol(def_id: Int) -> String:
	PROJECTED_CALLABLE_PREFIX + encode_callable_id(def_id)


pure func projected_type_base_symbol(index: Int) -> String:
	PROJECTED_TYPE_PREFIX + encode_callable_id(index)


---
Mint a short symbol for the type at `index` in declaration order, avoiding
every name already claimed (by an earlier program-wide reservation or an
earlier-minted type in the same declaration-order walk). Mirrors
`available_projected_callable_name`'s suffix-on-conflict fallback.
---
private pure func available_projected_type_name(index: Int, taken: Dict[String, Bool]) -> String:
	var name: String = projected_type_base_symbol(index)

	while taken.contains(name):
		name += "_"

	name


private pure func preserved_symbol_index(names: List[String]) -> Dict[String, Bool]:
	var result: Dict[String, Bool] = {}

	for name in names:
		result = result.set(name, True)

	result


private pure func projected_name_conflicts_with_preserved(
	name: String,
	kind: CProjectedCallableKind,
	preserved: Dict[String, Bool],
) -> Bool:
	(
		preserved.contains(name)
		or kind == ProjectedClosureBody and preserved.contains(static_closure_name(name))
	)


private pure func available_projected_callable_name(
	def_id: Int,
	kind: CProjectedCallableKind,
	preserved: Dict[String, Bool],
) -> String:
	var name: String = projected_callable_base_symbol(def_id)

	while projected_name_conflicts_with_preserved(name, kind, preserved):
		-- Base-62 IDs never contain underscores, so suffixing cannot collide
		-- with another unescaped artifact-local ID.
		name += "_"

	name


private pure func ordered_pair(first: String, second: String) -> (String, String):
	if first < second:
		(first, second)
	else:
		(second, first)


private pure func callable_symbol(
	candidate: CCallableSymbolCandidate,
	preserved: Dict[String, Bool],
) -> CCallableSymbol:
	original_c_spelling: String = c_identifier(candidate.original_c_spelling)
	{
		kind = candidate.kind,
		qualified_name = candidate.qualified_name,
		def_id = candidate.def_id,
		original_c_spelling = original_c_spelling,
		projected_name = available_projected_callable_name(
			candidate.def_id,
			candidate.kind,
			preserved,
		)
	}


pure func build_callable_symbol_plan(
	candidates: List[CCallableSymbolCandidate],
	preserved_names: List[String],
) -> Result[CCallableSymbolPlan, CSymbolProjectionError]:
	var by_definition_id: Dict[Int, CCallableSymbol] = {}
	var by_original: Dict[String, CCallableSymbol] = {}
	var plan_error: Option[CSymbolProjectionError] = None
	preserved: Dict[String, Bool] = preserved_symbol_index(preserved_names)

	for candidate in candidates:
		if plan_error.is_none():
			if candidate.def_id < 0:
				plan_error = Some(
					InvalidCallableDefinitionId(
						candidate.def_id,
						candidate.qualified_name,
					),
				)
			else:
				symbol: CCallableSymbol = callable_symbol(candidate, preserved)

				match by_definition_id.get(candidate.def_id):
					Some(existing):
						if existing.qualified_name != symbol.qualified_name:
							(first, second) = ordered_pair(
								existing.qualified_name,
								symbol.qualified_name,
							)
							plan_error = Some(
								DuplicateCallableDefinitionId(
									candidate.def_id,
									first,
									second,
								),
							)
						else if (
							existing.kind != symbol.kind
							or existing.def_id != symbol.def_id
							or existing.original_c_spelling != symbol.original_c_spelling
							or existing.projected_name != symbol.projected_name
						):
							plan_error = Some(
								DuplicateCallableIdentity(
									candidate.qualified_name,
									candidate.def_id,
								),
							)
						else:
							void
					None:
						match by_original.get(symbol.original_c_spelling):
							Some(existing):
								if (
									existing.qualified_name != symbol.qualified_name
									or existing.def_id != symbol.def_id
								):
									plan_error = Some(
										DuplicateCallableCName(symbol.original_c_spelling),
									)
								else:
									void
							None:
								by_original = by_original.set(symbol.original_c_spelling, symbol)

						by_definition_id = by_definition_id.set(candidate.def_id, symbol)
		else:
			void

	match plan_error:
		Some(error):
			Err(error)
		None:
			Ok({
				by_definition_id = by_definition_id,
				by_original_c_spelling = by_original,
			})


---
Publish only the callable facts needed while printing C. Semantic names and
the original callable records remain in the validation plan above, whose
lifetime ends at the projection boundary.
---
private pure func build_emission_callable_plan(
	candidates: List[CCallableSymbolCandidate],
	preserved_names: List[String],
) -> CEmissionCallablePlan:
	var by_definition_id: Dict[Int, String] = {}
	var by_original: Dict[String, String] = {}
	preserved: Dict[String, Bool] = preserved_symbol_index(preserved_names)

	for candidate in candidates:
		projected_name: String = available_projected_callable_name(
			candidate.def_id,
			candidate.kind,
			preserved,
		)
		by_definition_id = by_definition_id.set(candidate.def_id, projected_name)
		by_original = by_original.set(c_identifier(candidate.original_c_spelling), projected_name)

	{
		by_definition_id = by_definition_id,
		by_original_c_spelling = by_original,
	}


pure func projected_callable_name(
	plan: CCallableSymbolPlan,
	qualified_name: String,
	def_id: Int,
) -> Option[String]:
	planned_callable(plan.by_definition_id, qualified_name, def_id).map(func(symbol): symbol.projected_name)


private pure func planned_callable(
	by_definition_id: Dict[Int, CCallableSymbol],
	qualified_name: String,
	def_id: Int,
) -> Option[CCallableSymbol]:
	match by_definition_id.get(def_id):
		Some(symbol):
			if symbol.qualified_name == qualified_name:
				Some(symbol)
			else:
				None
		None:
			None


private pure func projected_callback_name(
	by_original_c_spelling: Dict[String, CCallableSymbol],
	original_name: String,
) -> Option[String]:
	by_original_c_spelling
		.get(c_identifier(original_name))
		.map(func(symbol): symbol.projected_name)


private pure func c_emission_callable_plan(plan: CEmissionSymbolPlan) -> CEmissionCallablePlan:
	representation: CEmissionSymbolPlanRep = from_opaque CEmissionSymbolPlan(plan)
	representation.callables


pure func planned_emitted_callable_name(
	plan: CEmissionSymbolPlan,
	def_id: Int,
) -> Option[String]:
	c_emission_callable_plan(plan).by_definition_id.get(def_id)


pure func planned_emitted_callback_name(
	plan: CEmissionSymbolPlan,
	original_name: String,
) -> Option[String]:
	c_emission_callable_plan(plan)
		.by_original_c_spelling
		.get(c_identifier(original_name))


pure func emitted_callable_name(
	plan: CEmissionSymbolPlan,
	def_id: Int,
) -> String:
	planned_emitted_callable_name(plan, def_id).get_or(INVALID_PROJECTED_CALLABLE_NAME)


pure func emitted_callback_name(plan: CEmissionSymbolPlan, original_name: String) -> String:
	planned_emitted_callback_name(plan, original_name).get_or(INVALID_PROJECTED_CALLABLE_NAME)


pure func c_emission_canonical_empty_lists(plan: CEmissionSymbolPlan) -> List[CanonicalEmptyList]:
	representation: CEmissionSymbolPlanRep = from_opaque CEmissionSymbolPlan(plan)
	representation.canonical_empty_lists


pure func c_emission_foreign_boundary_types(plan: CEmissionSymbolPlan) -> List[CoreType]:
	representation: CEmissionSymbolPlanRep = from_opaque CEmissionSymbolPlan(plan)
	representation.foreign_boundary_types


pure func c_emission_static_string_literals(
	plan: CEmissionSymbolPlan,
) -> Result[List[BackendStaticStringLiteral], StaticStringLiteralPoolError]:
	representation: CEmissionSymbolPlanRep = from_opaque CEmissionSymbolPlan(plan)
	representation.static_string_literals


pure func c_emission_symbol_plan_entry_count(plan: CEmissionSymbolPlan) -> Int:
	c_emission_callable_plan(plan).by_definition_id.length()


pure func c_emission_preserved_symbol_count(plan: CEmissionSymbolPlan) -> Int:
	representation: CEmissionSymbolPlanRep = from_opaque CEmissionSymbolPlan(plan)
	representation.preserved_symbol_count


---
The declared type's precomputed C spellings (make/destroy/reuse/enum/union
helper names), or a freshly derived value when a type name is absent from
the plan (unreachable once `program_symbol_inventory` has walked every
declaration; kept only so a caller cannot crash on a stale plan).
---
pure func c_emission_type_naming(plan: CEmissionSymbolPlan, type_name: String) -> BackendTypeNaming:
	representation: CEmissionSymbolPlanRep = from_opaque CEmissionSymbolPlan(plan)

	match representation.type_naming.get(type_name):
		Some(facts):
			facts
		None:
			backend_type_naming(type_name)


---
The declared-name -> projected-symbol lookup for every artifact-local
heap/value/union/enum type (empty entries fall back to the declared name
itself, matching `c_type_name`'s and `c_emission_type_naming`'s defensive
behavior on a stale or absent plan).
---
pure func c_emission_type_symbol_lookup(plan: CEmissionSymbolPlan) -> Dict[String, String]:
	representation: CEmissionSymbolPlanRep = from_opaque CEmissionSymbolPlan(plan)
	representation.type_symbol_lookup


private pure func callable_candidate(
	function_info: CoreFunction,
) -> Option[CCallableSymbolCandidate]:
	if function_info.body.is_none():
		None
	else:
		match function_info.function_kind:
			UserFunction:
				Some({
					kind = ProjectedUserFunction,
					qualified_name = function_info.name,
					def_id = function_info.def_id,
					original_c_spelling = function_info.name,
				})
			ClosureBodyFunction(abi):
				Some({
					kind = ProjectedClosureBody,
					qualified_name = function_info.name,
					def_id = function_info.def_id,
					original_c_spelling = abi.c_name,
				})
			_:
				None


private pure func tuple_element_expr(element: CoreTupleElement) -> Option[CoreExpr]:
	match element:
		TuplePrimElement(value):
			Some(value)
		TuplePointerElement(value):
			Some(value)
		TupleStructElement(value, _):
			Some(value)
		TupleStackResultElement(value):
			Some(value)
		TupleVoidElement:
			None
		TupleFloatElement(value):
			Some(value)
		TupleFloat32Element(value):
			Some(value)
		TupleFloat16Element(value):
			Some(value)


private pure func static_storage_names(path: String, expr: CoreExpr) -> List[String]:
	var names: List[String] = []

	match expr:
		RecordConstructExpr(_, fields, _, _):
			names = names.append(static_record_storage_name(path))

			for field in fields:
				names = names.concat(
					static_storage_names(
						static_child_path(path, field.name),
						field.value,
					),
				)
		ListConstructExpr(construct, _, _):
			names = names.append(static_list_storage_name(path))
			var index: Int = 0

			for element in construct.elements:
				names = names.concat(
					static_storage_names(
						static_list_child_path(path, index),
						element.value,
					),
				)
				index += 1
		TupleConstructExpr(construct, _, _):
			names = names.append(static_tuple_storage_name(path))
			var index: Int = 0

			for element in construct.elements:
				match tuple_element_expr(element):
					Some(value):
						names = names.concat(
							static_storage_names(
								static_tuple_child_path(path, index),
								value,
							),
						)
					None:
						void

				index += 1
		UnionConstructExpr(construct, _, _):
			names = names.append(static_union_storage_name(path))
			var index: Int = 0

			for arg in construct.args:
				names = names.concat(
					static_storage_names(
						static_union_child_path(path, construct.constructor_name, index),
						arg.value,
					),
				)
				index += 1
		_:
			void

	names


---
An artifact-local type's projected base symbol, or its own name when it has
none (an ABI-classified type, or a name absent from `lookup` because a caller
holds a stale plan). Mirrors `c_emission_type_naming`'s defensive fallback.
---
private pure func resolved_type_name(lookup: Dict[String, String], name: String) -> String:
	lookup.get(name).get_or(name)


---
Mint a short symbol for every artifact-local type name in `candidates`
(declaration order), avoiding every name in `taken` and every symbol minted
earlier in this same walk. Returns the name -> symbol lookup plus the flat
list of minted symbols so callers can extend their own preserved-name set.
---
private pure func mint_type_symbols(
	candidates: List[String],
	taken: Dict[String, Bool],
) -> (Dict[String, String], List[String]):
	var lookup: Dict[String, String] = {}
	var minted: List[String] = []
	var occupied: Dict[String, Bool] = taken
	var index: Int = 0

	for name in candidates:
		projected: String = available_projected_type_name(index, occupied)
		lookup = lookup.set(name, projected)
		minted = minted.append(projected)
		occupied = occupied.set(projected, True)
		index += 1

	(lookup, minted)


private pure func program_symbol_inventory(program: CoreProgram) -> CProgramSymbolInventory:
	var candidates: List[CCallableSymbolCandidate] = []
	var names: List[String] = ["main", "__blorp_init_globals", "__blorp_drop_globals"]
	var type_candidates: List[String] = []

	names = names.append(BUILTIN_STACK_OPTION_INT128_OPTION_C_TYPE)
	names = names.append(BUILTIN_STACK_OPTION_UINT128_OPTION_C_TYPE)
	names = names.append(BUILTIN_STACK_OPTION_RANGE_OPTION_C_TYPE)

	-- First walk: every program-wide reserved name that does not depend on a
	-- type's own projected spelling, plus the ordered list of artifact-local
	-- type names (`abi_type.is_none()`) that still need one minted below. An
	-- ABI-classified type keeps today's behavior exactly: its declared
	-- spelling is already the runtime-mandated short name, so it is never a
	-- projection candidate.
	for decl in program.decls:
		match decl:
			FunctionDecl(function_info):
				match callable_candidate(function_info):
					Some(candidate):
						candidates = candidates.append(candidate)
					None:
						match function_info.function_kind:
							ProgramEntrypointFunction:
								names = names.append("main")
							BuiltinFunction(c_name):
								names = names.append(c_identifier(c_name))
							ForeignFunction(foreign_info):
								names = names.append(c_identifier(foreign_info.c_name))
							UnresolvedBuiltinFunction | UserFunction | ClosureBodyFunction(_):
								names = names.append(c_identifier(function_info.name))
			GlobalDecl(global):
				global_name: String = c_local_name(global.name.name)
				names = names.append(global_name)
				names = names.concat(static_storage_names(global_name, global.init))
			EnumDecl(enum_decl):
				if enum_decl.abi_type.is_none():
					type_candidates = type_candidates.append(enum_decl.name)
				else:
					facts: BackendTypeNaming = backend_type_naming(enum_decl.name)
					names = names.append(facts.c_name)
					names = names.append(facts.enum_to_string_name)
					names = names.append(facts.enum_vector_to_string_name)

					if not TypeLayout.runtime_owned_stack_option_payload_name(enum_decl.name):
						names = names.append(
							TypeLayout.generated_stack_option_c_type_name(enum_decl.name),
						)
					else:
						void

				-- Variant constructor spellings still carry the type's
				-- original qualified name baked in from Core lowering; they
				-- are not re-derived from the projected type symbol here.
				for variant in enum_decl.variants:
					names = names.append(c_identifier(variant.c_name))
			UnionDecl(union_decl):
				if union_decl.abi_type.is_none():
					type_candidates = type_candidates.append(union_decl.name)
				else:
					facts: BackendTypeNaming = backend_type_naming(union_decl.name)
					names = names.append(facts.c_name)
					names = names.append(facts.destroy_name)
					names = names.append(facts.union_destroy_stack_push_name)
					names = names.append(facts.union_destroy_release_child_name)
					names = names.append(facts.union_destroy_fields_name)

				for variant in union_decl.variants:
					names = names.append(c_identifier(variant.c_name))
					names = names.append(c_identifier(variant.tag_c_name))
					names = names.append(union_instance_name(variant.c_name))
					names = names.append(union_init_name(variant.c_name))
					names = names.append(union_reuse_name(union_decl.name, variant.c_name))
			ValueRecordDecl(record_decl):
				if record_decl.abi_type.is_none():
					type_candidates = type_candidates.append(record_decl.name)
				else:
					facts: BackendTypeNaming = backend_type_naming(record_decl.name)
					names = names.append(facts.c_name)
					names = names.append(facts.make_name)

					if not TypeLayout.runtime_owned_stack_option_payload_name(record_decl.name):
						names = names.append(
							TypeLayout.generated_stack_option_c_type_name(record_decl.name),
						)
					else:
						void
			HeapRecordDecl(record_decl):
				if record_decl.abi_type.is_none():
					type_candidates = type_candidates.append(record_decl.name)
				else:
					facts: BackendTypeNaming = backend_type_naming(record_decl.name)
					names = names.append(facts.c_name)
					names = names.append(facts.make_name)
					names = names.append(facts.destroy_name)
					names = names.append(facts.reuse_name)
			TypeAliasDecl(alias_decl):
				names = names.append(c_identifier(alias_decl.name))
			TraitDecl(trait_decl):
				names = names.append(c_identifier(trait_decl.name))
			ImplDecl(impl_decl):
				void

	-- Mint short symbols for every artifact-local type, in declaration
	-- order, only once every other program-wide reservation is known.
	-- Appending the minted symbols to `names` before any callable is minted
	-- means a callable's own collision-avoidance (`available_projected_
	-- callable_name`) automatically steers clear of them; the reverse
	-- direction can never happen because a callable spelling is `brp_`
	-- followed directly by a base-62 digit while every type spelling is
	-- `brp_ty` (or a derived form containing `_destroy`/`_make`, ...), so the
	-- two families cannot collide by construction.
	taken: Dict[String, Bool] = preserved_symbol_index(names)
	(type_symbol_lookup, minted_type_names) = mint_type_symbols(type_candidates, taken)
	names = names.concat(minted_type_names)

	-- Second walk: now that every artifact-local type has a final spelling,
	-- build its derived C names from that spelling (unchanged for an
	-- ABI-classified type, which was never in `type_symbol_lookup`) and
	-- extend `names` with the ones this walk could not have produced above.
	var type_naming: Dict[String, BackendTypeNaming] = {}

	for decl in program.decls:
		match decl:
			EnumDecl(enum_decl):
				if enum_decl.abi_type.is_none():
					resolved: String = resolved_type_name(type_symbol_lookup, enum_decl.name)
					facts: BackendTypeNaming = backend_type_naming(resolved)
					type_naming = type_naming.set(enum_decl.name, facts)
					names = names.append(facts.enum_to_string_name)
					names = names.append(facts.enum_vector_to_string_name)

					if not TypeLayout.runtime_owned_stack_option_payload_name(enum_decl.name):
						names = names.append(TypeLayout.generated_stack_option_c_type_name(resolved))
					else:
						void
				else:
					type_naming = type_naming.set(enum_decl.name, backend_type_naming(enum_decl.name))
			UnionDecl(union_decl):
				if union_decl.abi_type.is_none():
					resolved: String = resolved_type_name(type_symbol_lookup, union_decl.name)
					facts: BackendTypeNaming = backend_type_naming(resolved)
					type_naming = type_naming.set(union_decl.name, facts)
					names = names.append(facts.destroy_name)
					names = names.append(facts.union_destroy_stack_push_name)
					names = names.append(facts.union_destroy_release_child_name)
					names = names.append(facts.union_destroy_fields_name)
				else:
					type_naming = type_naming.set(union_decl.name, backend_type_naming(union_decl.name))
			ValueRecordDecl(record_decl):
				if record_decl.abi_type.is_none():
					resolved: String = resolved_type_name(type_symbol_lookup, record_decl.name)
					facts: BackendTypeNaming = backend_type_naming(resolved)
					type_naming = type_naming.set(record_decl.name, facts)
					names = names.append(facts.make_name)

					if not TypeLayout.runtime_owned_stack_option_payload_name(record_decl.name):
						names = names.append(TypeLayout.generated_stack_option_c_type_name(resolved))
					else:
						void
				else:
					type_naming = type_naming.set(record_decl.name, backend_type_naming(record_decl.name))
			HeapRecordDecl(record_decl):
				if record_decl.abi_type.is_none():
					resolved: String = resolved_type_name(type_symbol_lookup, record_decl.name)
					facts: BackendTypeNaming = backend_type_naming(resolved)
					type_naming = type_naming.set(record_decl.name, facts)
					names = names.append(facts.make_name)
					names = names.append(facts.destroy_name)
					names = names.append(facts.reuse_name)
				else:
					type_naming = type_naming.set(record_decl.name, backend_type_naming(record_decl.name))
			_:
				void

	{
		candidates = candidates,
		preserved_names = names,
		type_naming = type_naming,
		type_symbol_lookup = type_symbol_lookup
	}


private pure func missing_structured_callable(
	plan: CCallableSymbolPlan,
	name: String,
	def_id: Option[Int],
) -> Option[CSymbolProjectionError]:
	match def_id:
		Some(selected_id):
			if projected_callable_name(plan, name, selected_id).is_some():
				None
			else:
				Some(MissingProjectedCallable(name, selected_id))
		None:
			Some(UnresolvedProjectedCallable(name))


private pure func unresolved_callback(
	plan: CCallableSymbolPlan,
	name: String,
) -> Option[CSymbolProjectionError]:
	if projected_callback_name(plan.by_original_c_spelling, name).is_some():
		None
	else:
		Some(UnresolvedCallbackTarget(name))


private pure func task_projection_error(
	plan: CCallableSymbolPlan,
	task: CoreTaskClosure,
) -> Option[CSymbolProjectionError]:
	match projected_callable_name(plan, task.function_name, task.def_id):
		Some(_):
			match planned_callable(plan.by_definition_id, task.function_name, task.def_id):
				Some(symbol):
					if symbol.original_c_spelling != c_identifier(task.c_name):
						Some(CallableCNameMismatch(symbol.original_c_spelling, task.c_name))
					else if task.static_name != static_closure_name(symbol.original_c_spelling):
						Some(
							CallableCNameMismatch(
								static_closure_name(symbol.original_c_spelling),
								task.static_name,
							),
						)
					else:
						None
				None:
					Some(MissingProjectedCallable(task.function_name, task.def_id))
		None:
			Some(MissingProjectedCallable(task.function_name, task.def_id))


private pure func constructor_projection_error(
	plan: CCallableSymbolPlan,
	constructor: CoreHashContainerConstructor,
) -> Option[CSymbolProjectionError]:
	match constructor:
		CustomHashContainerConstructor(hash_name, equals_name, _):
			match unresolved_callback(plan, hash_name):
				Some(error):
					Some(error)
				None:
					unresolved_callback(plan, equals_name)
		_:
			None


private pure func expr_projection_error(
	plan: CCallableSymbolPlan,
	expr: CoreExpr,
) -> Option[CSymbolProjectionError]:
	match expr:
		CallExpr(UnknownCall, _, _, _, _):
			Some(UnsupportedPreparedCallKind("unknown"))
		CallExpr(SelectedDirectCall(_), _, _, _, _):
			Some(UnsupportedPreparedCallKind("selected_direct"))
		CallExpr(DeferredTraitCall(_, _), _, _, _, _):
			Some(UnsupportedPreparedCallKind("deferred_trait"))
		CallExpr(SelectedTraitCall(_, _, _, _), _, _, _, _):
			Some(UnsupportedPreparedCallKind("selected_trait"))
		CallExpr(UserCall(name, def_id, _), _, _, _, _):
			missing_structured_callable(plan, name, def_id)
		CallExpr(ListToStringCall(callback_name), _, _, _, _):
			unresolved_callback(plan, callback_name)
		CallExpr(DictWithCapacityCall(constructor), _, _, _, _):
			constructor_projection_error(plan, constructor)
		DictConstructExpr(construct, _, _):
			constructor_projection_error(plan, construct.constructor)
		SetAllocExpr(constructor, _, _):
			constructor_projection_error(plan, constructor)
		ClosureCreateExpr(closure, _, _):
			match projected_callable_name(plan, closure.function_name, closure.def_id):
				Some(_):
					match planned_callable(plan.by_definition_id, closure.function_name, closure.def_id):
						Some(symbol):
							if symbol.original_c_spelling != c_identifier(closure.c_name):
								Some(
									CallableCNameMismatch(
										symbol.original_c_spelling,
										closure.c_name,
									),
								)
							else if closure.static_name != static_closure_name(
								symbol.original_c_spelling,
							):
								Some(
									CallableCNameMismatch(
										static_closure_name(symbol.original_c_spelling),
										closure.static_name,
									),
								)
							else:
								None
						None:
							Some(MissingProjectedCallable(closure.function_name, closure.def_id))
				None:
					Some(MissingProjectedCallable(closure.function_name, closure.def_id))
		DetachExpr(task, _, _):
			task_projection_error(plan, task)
		ConcurrentlyLoopExpr(loop, _, _):
			task_projection_error(plan, loop.task)
		ConcurrentExpr(block, _, _):
			var error: Option[CSymbolProjectionError] = None

			for binding in block.bindings:
				if error.is_none():
					error = task_projection_error(plan, binding.task)
				else:
					void

			error
		VarExpr(variable, FunctionType(_, _, _), _):
			match variable.def_id:
				Some(def_id):
					if projected_callable_name(plan, variable.name, def_id).is_some():
						Some(UnprojectedCallableValue(variable.name, def_id))
					else:
						None
				None:
					None
		_:
			None


private pure func validate_expr_projection(
	plan: Option[CCallableSymbolPlan],
	initial_static_string_literal_pool: BackendStaticStringLiteralPool,
	root: CoreExpr,
) -> CProjectionValidation:
	-- Keep only the current and next breadth-first layers so completed layers
	-- are released without changing deterministic first-error selection. The
	-- parallel flags keep direct-call callees in the emission-fact census while
	-- excluding them from callable projection validation.
	var current_frontier: List[CoreExpr] = [root]
	var current_validation: List[Bool] = [True]
	var next_frontier: List[CoreExpr] = []
	var next_validation: List[Bool] = []
	var current_index: Int = 0
	var error: Option[CSymbolProjectionError] = None
	var canonical_empty_lists: List[CanonicalEmptyList] = []
	var foreign_boundary_types: List[CoreType] = []
	var static_string_literal_pool: BackendStaticStringLiteralPool = initial_static_string_literal_pool

	while current_frontier.length() > 0 and error.is_none():
		while current_index < current_frontier.length() and error.is_none():
			match (current_frontier.get(current_index), current_validation.get(current_index)):
				(Some(expr), Some(should_validate)):
					if should_validate:
						error = match plan:
							Some(selected_plan):
								expr_projection_error(selected_plan, expr)
							None:
								None
					else:
						void

					match expr:
						StaticStringLiteralExpr(id, value, _, _):
							static_string_literal_pool = backend_static_string_literal_pool_add(
								static_string_literal_pool,
								id,
								value,
							)
						LiteralExpr(StringLiteral(value), _, _):
							static_string_literal_pool = backend_static_string_literal_pool_reject_unpooled(
								static_string_literal_pool,
								value,
							)
						CallExpr(ForeignCall(_, _), _, args, return_type, _):
							for arg in args:
								foreign_boundary_types = foreign_boundary_types.append(
									core_expr_type(arg),
								)

							foreign_boundary_types = foreign_boundary_types.append(return_type)
						ListConstructExpr(construct, _, _):
							if should_validate and (
								construct.elements.length() == 0
								and not canonical_empty_list_layout_is_valid(construct)
							):
								error = Some(
									InvalidCanonicalEmptyListLayout(
										"inline empty lists cannot own releasable elements",
									),
								)
							else if should_validate:
								match canonical_empty_list_for_construct(construct):
									Some(item):
										canonical_empty_lists = canonical_empty_lists_add(
											canonical_empty_lists,
											item,
										)
									None:
										void
							else:
								void
						_:
							void

					if error.is_none():
						match expr:
							CallExpr(ClosureCall, callee, args, _, _):
								next_frontier = next_frontier.append(callee)
								next_validation = next_validation.append(should_validate)

								for arg in args:
									next_frontier = next_frontier.append(arg)
									next_validation = next_validation.append(should_validate)
							CallExpr(_, callee, args, _, _):
								next_frontier = next_frontier.append(callee)
								next_validation = next_validation.append(False)

								for arg in args:
									next_frontier = next_frontier.append(arg)
									next_validation = next_validation.append(should_validate)
							_:
								for child in CoreTraverse.immediate_core_expr_children(expr):
									next_frontier = next_frontier.append(child)
									next_validation = next_validation.append(should_validate)
				_:
					void

			current_index += 1

		if error.is_none():
			current_frontier = next_frontier
			current_validation = next_validation
			next_frontier = []
			next_validation = []
			current_index = 0

	{
		error = error,
		canonical_empty_lists = canonical_empty_lists,
		foreign_boundary_types = foreign_boundary_types,
		static_string_literal_pool = static_string_literal_pool
	}


private pure func validate_program_projection(
	plan: Option[CCallableSymbolPlan],
	program: CoreProgram,
) -> CProjectionValidation:
	var error: Option[CSymbolProjectionError] = None
	var canonical_empty_lists: List[CanonicalEmptyList] = []
	var foreign_boundary_types: List[CoreType] = []
	var static_string_literal_pool: BackendStaticStringLiteralPool = empty_backend_static_string_literal_pool()

	for decl in program.decls:
		if error.is_none():
			match decl:
				FunctionDecl(function_info):
					match function_info.function_kind:
						ForeignFunction(_):
							for param in function_info.params:
								foreign_boundary_types = foreign_boundary_types.append(param.typ)

							foreign_boundary_types = foreign_boundary_types.append(
								function_info.return_type,
							)
						_:
							void

					match function_info.body:
						Some(body):
							validation: CProjectionValidation = validate_expr_projection(
								plan,
								static_string_literal_pool,
								body,
							)
							error = validation.error
							static_string_literal_pool = validation.static_string_literal_pool

							for item in validation.canonical_empty_lists:
								canonical_empty_lists = canonical_empty_lists_add(
									canonical_empty_lists,
									item,
								)

							for typ in validation.foreign_boundary_types:
								foreign_boundary_types = foreign_boundary_types.append(typ)
						None:
							void
				GlobalDecl(global):
					validation: CProjectionValidation = validate_expr_projection(
						plan,
						static_string_literal_pool,
						global.init,
					)
					error = validation.error
					static_string_literal_pool = validation.static_string_literal_pool

					for item in validation.canonical_empty_lists:
						canonical_empty_lists = canonical_empty_lists_add(
							canonical_empty_lists,
							item,
						)

					for typ in validation.foreign_boundary_types:
						foreign_boundary_types = foreign_boundary_types.append(typ)
				ImplDecl(impl):
					for method in impl.methods:
						match method.function_kind:
							ForeignFunction(_):
								for param in method.params:
									foreign_boundary_types = foreign_boundary_types.append(param.typ)

								foreign_boundary_types = foreign_boundary_types.append(
									method.return_type,
								)
							_:
								void

						match method.body:
							Some(body):
								-- Impl bodies no longer participate in projection validation,
								-- but their foreign calls still constrain ABI layout.
								validation: CProjectionValidation = validate_expr_projection(
									None,
									static_string_literal_pool,
									body,
								)
								static_string_literal_pool = validation.static_string_literal_pool

								for typ in validation.foreign_boundary_types:
									foreign_boundary_types = foreign_boundary_types.append(typ)
							None:
								void
				_:
					void
		else:
			void

	{
		error = error,
		canonical_empty_lists = canonical_empty_lists_sorted(canonical_empty_lists),
		foreign_boundary_types = foreign_boundary_types,
		static_string_literal_pool = static_string_literal_pool
	}


pure func canonical_empty_lists_for_unprojected_program(
	program: CoreProgram,
) -> Result[List[CanonicalEmptyList], CSymbolProjectionError]:
	validation: CProjectionValidation = validate_program_projection(None, program)

	match validation.error:
		Some(error):
			Err(error)
		None:
			Ok(validation.canonical_empty_lists)


private pure func canonical_empty_list_symbol_collision(
	items: List[CanonicalEmptyList],
	preserved_names: List[String],
) -> Option[String]:
	var occupied: List[String] = preserved_names
	var collision: Option[String] = None

	for item in items:
		if collision.is_none():
			if occupied.contains(item.symbol_name):
				collision = Some(item.symbol_name)
			else:
				occupied = occupied.append(item.symbol_name)

	collision


pure func prepare_c_emission_symbols(
	program: CoreProgram,
) -> Result[CEmissionSymbolPlan, CSymbolProjectionError]:
	match check_definition_id_uniqueness(program):
		[violation, ..._]:
			Err(InvalidCoreDefinitionIdentity(core_late_invariant_message(violation)))
		[]:
			inventory: CProgramSymbolInventory = program_symbol_inventory(program)

			match build_callable_symbol_plan(inventory.candidates, inventory.preserved_names):
				Err(error):
					Err(error)
				Ok(preliminary_plan):
					validation: CProjectionValidation = validate_program_projection(
						Some(preliminary_plan),
						program,
					)

					match validation.error:
						Some(error):
							Err(error)
						None:
							match canonical_empty_list_symbol_collision(
								validation.canonical_empty_lists,
								inventory.preserved_names,
							):
								Some(name):
									Err(CanonicalEmptyListSymbolCollision(name))
								None:
									preserved_names: List[String] = inventory.preserved_names.concat(
										canonical_empty_list_symbol_names(
											validation.canonical_empty_lists,
										),
									)

									Ok(into_opaque CEmissionSymbolPlan({
										callables = build_emission_callable_plan(
											inventory.candidates,
											preserved_names,
										),
										canonical_empty_lists = validation.canonical_empty_lists,
										foreign_boundary_types = validation.foreign_boundary_types,
										static_string_literals = finish_backend_static_string_literal_pool(
											validation.static_string_literal_pool,
										),
										preserved_symbol_count = preserved_names.length(),
										type_naming = inventory.type_naming,
										type_symbol_lookup = inventory.type_symbol_lookup
									}))


pure func symbol_projection_error_text(error: CSymbolProjectionError) -> String:
	match error:
		DuplicateCallableDefinitionId(def_id, first, second):
			"callable definition ID ${def_id} is owned by both `${first}` and `${second}`"
		DuplicateCallableIdentity(name, def_id):
			"duplicate callable identity `${name}` (${def_id}) has inconsistent C metadata"
		DuplicateCallableCName(name):
			"multiple callable identities emit the C name `${name}`"
		InvalidCoreDefinitionIdentity(detail):
			"invalid final Core definition identity: ${detail}"
		InvalidCallableDefinitionId(def_id, name):
			"callable `${name}` has invalid negative definition ID ${def_id}"
		MissingProjectedCallable(name, def_id):
			"missing projected callable `${name}` (${def_id})"
		UnresolvedProjectedCallable(name):
			"callable `${name}` has no resolved definition id at final C projection"
		UnresolvedCallbackTarget(name):
			"callback `${name}` does not resolve to a projected callable"
		CallableCNameMismatch(expected, actual):
			"callable C name `${actual}` does not agree with declared C name `${expected}`"
		UnsupportedPreparedCallKind(kind):
			"unresolved `${kind}` call kind reached final C symbol projection"
		UnprojectedCallableValue(name, def_id):
			"callable value `${name}` (${def_id}) reached final C symbol projection without closure conversion"
		InvalidCanonicalEmptyListLayout(detail):
			"invalid canonical empty list layout: ${detail}"
		CanonicalEmptyListSymbolCollision(name):
			"canonical empty list symbol `${name}` conflicts with an existing C symbol"
