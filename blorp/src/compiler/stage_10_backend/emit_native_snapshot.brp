-- Copy one native by-value snapshot into an ordinary managed language record.
-- Construction happens after the snapshot, so the returned counters honestly
-- describe the native observation before the managed result was allocated.
import:
	../stage_06_typecheck/type_system/native_snapshot_abi:
		NativeSnapshotKind,
		native_snapshot_c_function,
		native_snapshot_c_type,
		native_snapshot_fields,


pure func emit_native_snapshot_adapter(
	abi: NativeSnapshotKind,
	record_c_type: String,
	make_name: String,
	helper_name: String,
	linkage_prefix: String,
) -> String:
	arguments = native_snapshot_fields(abi).map(pure func(field): "native." + field)
	(
		linkage_prefix + record_c_type + "* " + helper_name + "(void) {\n  "
		+ native_snapshot_c_type(abi) + " native = " + native_snapshot_c_function(abi)
		+ "();\n  return " + make_name + "(" + arguments.join(", ") + ");\n}\n\n"
	)
