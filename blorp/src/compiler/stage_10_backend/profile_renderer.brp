-- Select and render function profiling metadata and runtime hooks.
--
-- The emitter supplies already-projected function metadata. This module owns
-- selector matching, deterministic profile IDs, and the small C fragments
-- that connect emitted functions to the runtime profiler.
import:
	../../lib/function_profile:
		FunctionProfileMode(
			FunctionProfileCallsMode,
			FunctionProfileExactMode,
			FunctionProfileOffMode,
		),
	../stage_09_core/ir: CoreFunction
	emit_literal: c_string_literal
	string: string as make_string


struct ProfileFunctionId {
	value: Int,
	mode: FunctionProfileMode
}


record ProfileFunctionMetadata {
	logical_name: String,
	c_symbol: String,
	module_path: Option[String],
	definition_id: Int
}


record ProfileEmissionPlan {
	mode: FunctionProfileMode,
	described_count: Int,
	functions: List[ProfileFunctionMetadata]
}


pure func emit_profile_metadata(
	plan: Option[ProfileEmissionPlan],
	internal_type_linkage: Bool,
) -> String:
	match plan:
		Some(profile_plan):
			if profile_plan.functions.length() == 0:
				""
			else:
				var rows: String = make_string(0)

				for metadata in profile_plan.functions:
					module_path: String = match metadata.module_path:
						Some(path):
							c_string_literal(path)
						None:
							"NULL"

					flags: String = if metadata.module_path.is_some():
						"BLORP_PROFILE_METADATA_HAS_MODULE"
					else:
						"0u"

					rows += "  {" + c_string_literal(
						metadata.logical_name,
					) + ", " + c_string_literal(
						metadata.c_symbol,
					) + ", " + module_path + ", " + metadata.definition_id.to_string() + ", " + flags + "},\n"

				profile_mode_name: String = match profile_plan.mode:
					FunctionProfileCallsMode:
						"calls"
					FunctionProfileExactMode:
						"exact"
					FunctionProfileOffMode:
						"off"

				storage_class: String = if internal_type_linkage:
					"static const "
				else:
					"const "

				"/* BLORP_PROFILE mode=" + profile_mode_name + " functions_described=" + profile_plan.described_count.to_string() + " functions_selected=" + profile_plan.functions
					.length()
					.to_string() + " */\n" + storage_class + "blorp_ProfileFunctionMetadata __blorp_profile_functions[" + profile_plan.functions
					.length()
					.to_string() + "] = {\n" + rows + "};\n\n"
		None:
			""


pure func emit_profile_metadata_extern_decl(plan: Option[ProfileEmissionPlan]) -> String:
	match plan:
		Some(profile_plan):
			if profile_plan.functions.length() == 0:
				""
			else:
				"extern const blorp_ProfileFunctionMetadata __blorp_profile_functions[];\n"
		None:
			""


pure func emit_profile_runtime_setup(plan: Option[ProfileEmissionPlan]) -> String:
	match plan:
		Some(profile_plan):
			profile_mode: String = match profile_plan.mode:
				FunctionProfileCallsMode:
					"BLORP_PROFILE_MODE_CALLS"
				FunctionProfileExactMode:
					"BLORP_PROFILE_MODE_EXACT"
				FunctionProfileOffMode:
					"BLORP_PROFILE_MODE_OFF"

			"  if (blorp_profile_enable(" + profile_mode + ", __blorp_profile_functions, " + profile_plan.functions
				.length()
				.to_string() + ", " + profile_plan.described_count.to_string() + ") != 0) return 1;\n"
		None:
			""


pure func emit_profile_start(profile_function_id: Option[ProfileFunctionId]) -> String:
	match profile_function_id:
		Some(id):
			match id.mode:
				FunctionProfileCallsMode:
					"  blorp_profile_count_id(" + id.value.to_string() + ");\n"
				FunctionProfileExactMode:
					"  blorp_profile_start_id(" + id.value.to_string() + ");\n"
				FunctionProfileOffMode:
					""
		None:
			""


pure func emit_profile_end(
	indent: String,
	profile_function_id: Option[ProfileFunctionId],
) -> String:
	match profile_function_id:
		Some(id):
			match id.mode:
				FunctionProfileExactMode:
					indent + "blorp_profile_end_id(" + id.value.to_string() + ");\n"
				FunctionProfileCallsMode | FunctionProfileOffMode:
					""
		None:
			""


pure func profile_function_requires_exit(
	profile_function_id: Option[ProfileFunctionId],
) -> Bool:
	match profile_function_id:
		Some(id):
			id.mode == FunctionProfileExactMode
		None:
			False


pure func profile_function_id_at_cursor(
	profile_plan: Option[ProfileEmissionPlan],
	next_profile_id: Int,
	func_info: CoreFunction,
) -> Option[ProfileFunctionId]:
	match profile_plan:
		Some(plan):
			match plan.functions.get(next_profile_id):
				Some(metadata):
					if metadata.definition_id == func_info.def_id and metadata.module_path == func_info.source_module:
						Some({
							value = next_profile_id,
							mode = plan.mode,
						})
					else:
						None
				None:
					None
		None:
			None
