-- Classify record layouts before C emission.
--
-- Foreign pointer ABI exposure is transitive: changing an embedded record also
-- changes the containing foreign parameter or result. Keep that distinction
-- explicit so storage optimizations cannot depend on naming conventions.
import:
	../stage_06_typecheck/type_system/language_surface_manifest:
		DeclaredAbiType(DeclaredAbiMemStats, DeclaredAbiSchedulerStats),
	../stage_08_core_lower/list_layout: resolve_layout_type_with_index
	../stage_09_core/c_type_layout: c_type_name
	../stage_09_core/ir:
		CoreLayoutTypeIndex,
		CoreCallKind(ForeignCall),
		CoreDecl(InlineRecordDecl, FunctionDecl, GlobalDecl, HeapRecordDecl, ImplDecl, UnionDecl),
		CoreExpr(CallExpr),
		CoreFieldOrdinal,
		CoreFunction,
		CoreFunctionKind(ForeignFunction),
		CoreHeapRecordDecl,
		CoreProgram,
		CoreTupleStorageCatalog,
		CoreType(
			InlineRecordType, NativeManagedType,
			BoxedResultType, FunctionType, HeapRecordType, NamedType, RangeType, SelfType,
			StackResultType, TensorType, TupleType, TypeParameterType, UnionType,
			VoidType,
		),
		CoreUnionDecl,
		CoreUnionValueStorage(ScalarTagValue, ManagedUnionValue),
		CoreUnionStorage(ScalarTagStorage, ManagedPayloadStorage),
		core_expr_type,
		core_field_ordinal_index,
	../stage_09_core/managed_record_layout:
		CoreManagedRecordLayout,
		CoreManagedRecordLayoutFault,
		managed_record_layout_for_decl,
		managed_record_layout_fields,
		managed_record_layout_name,
	../stage_09_core/specialize_layout: CoreSpecializeLayout
	../stage_09_core/traverse: immediate_core_expr_children
	c_naming: c_field_name, c_record_member_name
	set as Sets


fixed union CRecordLayout:
	InternalLayout
	ForeignAbiLayout






union CHeapRecordFieldStorage:
	OrdinaryCHeapRecordField(String)
	PackedBooleanCHeapRecordField


implements Equatable for CHeapRecordFieldStorage:
	pure func equals(left: CHeapRecordFieldStorage, right: CHeapRecordFieldStorage) -> Bool:
		match (left, right):
			(OrdinaryCHeapRecordField(left_value), OrdinaryCHeapRecordField(right_value)):
				left_value == right_value
			(PackedBooleanCHeapRecordField, PackedBooleanCHeapRecordField):
				True
			_:
				False

	pure func not_equals(left: CHeapRecordFieldStorage, right: CHeapRecordFieldStorage) -> Bool:
		not equals(left, right)


MAX_BYTE_UNION_TAG: Int = 255


pure func c_record_field_type_is_boolean(typ: CoreType) -> Bool:
	match typ:
		NamedType(name, args):
			name == "Bool" and args.length() == 0
		_:
			False


pure func c_heap_record_field_storage(
	byte_sized_scalar_union_names: Set[String],
	layout: CRecordLayout,
	typ: CoreType,
	has_boolean_neighbor: Bool,
	type_symbol_lookup: Dict[String, String],
) -> CHeapRecordFieldStorage:
	match layout:
		InternalLayout:
			if c_record_field_type_is_boolean(typ):
				if has_boolean_neighbor:
					PackedBooleanCHeapRecordField
				else:
					OrdinaryCHeapRecordField("_Bool")
			else:
				match typ:
					UnionType(name, ScalarTagValue):
						if Sets.contains(byte_sized_scalar_union_names, name):
							OrdinaryCHeapRecordField("uint8_t")
						else:
							OrdinaryCHeapRecordField(c_type_name(typ, type_symbol_lookup))
					_:
						OrdinaryCHeapRecordField(c_type_name(typ, type_symbol_lookup))
		ForeignAbiLayout:
			OrdinaryCHeapRecordField(c_type_name(typ, type_symbol_lookup))




record CRecordLayoutRegistry {
	foreign_abi_heap_record_names: Set[String],
	byte_sized_scalar_union_names: Set[String],
	-- The declared records whose members keep their source names (a declared
	-- ABI record, or one reachable from a foreign function's signature), each
	-- with its member spellings in declaration order. Every other record
	-- spells its members `f<ordinal>`.
	source_member_fields: Dict[String, List[String]],
	-- Physical views are derived from the checked complete catalog. They retain
	-- logical unit ordinals while distinguishing omitted C storage.
	managed_layouts: Dict[String, CoreManagedRecordLayout],
	tuple_catalog: CoreTupleStorageCatalog
}


---
The member spelling of field `ordinal` of the record named `record_name`, for a
field read: its source name for a record in `source_member_fields`, `f<ordinal>`
for every other. `None` only for an ordinal past the end of a source-named
record, which an ordinal issued from the record's row rules out.
---
pure func c_record_member_at(
	layouts: CRecordLayoutRegistry,
	record_name: String,
	ordinal: CoreFieldOrdinal,
) -> Option[String]:
	index: Int = core_field_ordinal_index(ordinal)

	match layouts.source_member_fields.get(record_name):
		Some(members):
			members.get(index)
		None:
			Some(c_record_member_name(index))


---
The member spelling of one record, for the sites that spell every field of a
record (its declaration, its constructor, its static initializer).
---
record CRecordMemberScope {
	layouts: CRecordLayoutRegistry,
	record_name: String
}


pure func c_record_member_scope(
	layouts: CRecordLayoutRegistry,
	record_name: String,
) -> CRecordMemberScope:
	{
		layouts = layouts,
		record_name = record_name
	}


---
The member spelling of the field at position `ordinal` of a record's declaration,
for the declaration sites that walk the fields in order: what `c_record_member_at`
answers for it, without the lookup.
---
pure func c_declared_record_member(scope: CRecordMemberScope, name: String, ordinal: Int) -> String:
	if scope.layouts.source_member_fields.contains(scope.record_name):
		c_field_name(name)
	else:
		c_record_member_name(ordinal)


private record CRecordDeclIndex {
	layout_types: CoreLayoutTypeIndex,
	managed_layouts: Dict[String, CoreManagedRecordLayout],
	unions: Dict[String, CoreUnionDecl]
}


private pure func build_record_decl_index(
	specialize_layout: CoreSpecializeLayout,
	catalog: CoreTupleStorageCatalog,
) -> Result[CRecordDeclIndex, CoreManagedRecordLayoutFault]:
	var layouts: Dict[String, CoreManagedRecordLayout] = {}
	var unions: Dict[String, CoreUnionDecl] = {}
	var failure: Option[CoreManagedRecordLayoutFault] = None

	for decl in specialize_layout.program.decls:
		match managed_record_layout_for_decl(catalog, decl):
			Ok(Some(layout)):
				name = managed_record_layout_name(layout)
				layouts = layouts.set(name, layout)
			Ok(None):
				void
			Err(fault):
				failure = Some(fault)

		match decl:
			UnionDecl(union_decl):
				if not unions.contains(union_decl.name):
					unions = unions.set(union_decl.name, union_decl)
			_:
				void

	match failure:
		Some(fault):
			Err(fault)
		None:
			Ok({
				layout_types = specialize_layout.types,
				managed_layouts = layouts,
				unions = unions
			})




pure func c_heap_record_layout(
	foreign_abi_heap_record_names: Set[String],
	record_name: String,
) -> CRecordLayout:
	if Sets.contains(foreign_abi_heap_record_names, record_name):
		ForeignAbiLayout
	else:
		InternalLayout


private pure func append_foreign_signature_types_for_function(
	types: List[CoreType],
	function_info: CoreFunction,
) -> List[CoreType]:
	var result: List[CoreType] = types

	match function_info.function_kind:
		ForeignFunction(_):
			for param in function_info.params:
				result = result.append(param.typ)

			result.append(function_info.return_type)
		_:
			result


private pure func foreign_call_types(root: CoreExpr) -> List[CoreType]:
	var result: List[CoreType] = []
	var pending: List[CoreExpr] = [root]
	var pending_count: Int = 1

	while pending_count > 0:
		pending_count -= 1

		match pending.get(pending_count):
			Some(expr):
				match expr:
					CallExpr(ForeignCall(_, _), _, args, return_type, _):
						for arg in args:
							result = result.append(core_expr_type(arg))

						result = result.append(return_type)
					_:
						void

				for child in immediate_core_expr_children(expr):
					pending = if pending_count < pending.length():
						pending.set(pending_count, child)
					else:
						pending.append(child)

					pending_count += 1
			None:
				void

	result


pure func collect_foreign_boundary_types(program: CoreProgram) -> List[CoreType]:
	var types: List[CoreType] = []

	for decl in program.decls:
		match decl:
			FunctionDecl(function_info):
				types = append_foreign_signature_types_for_function(types, function_info)

				match function_info.body:
					Some(body):
						for typ in foreign_call_types(body):
							types = types.append(typ)
					None:
						void
			GlobalDecl(global):
				for typ in foreign_call_types(global.init):
					types = types.append(typ)
			ImplDecl(impl_info):
				for method in impl_info.methods:
					types = append_foreign_signature_types_for_function(types, method)

					match method.body:
						Some(body):
							for typ in foreign_call_types(body):
								types = types.append(typ)
						None:
							void
			_:
				void

	types


private pure func append_nested_types(pending: List[CoreType], typ: CoreType) -> List[CoreType]:
	match typ:
		NamedType(_, args):
			pending.concat(args)
		StackResultType(ok_type, err_type):
			pending
				.append(ok_type)
				.append(err_type)
		BoxedResultType(ok_type, err_type):
			pending
				.append(ok_type)
				.append(err_type)
		FunctionType(_, params, return_type):
			pending
				.concat(params)
				.append(return_type)
		TensorType(info):
			pending.append(info.element_type)
		TupleType(items):
			pending.concat(items)
		NativeManagedType(_) | VoidType | HeapRecordType(_) | RangeType | TypeParameterType(_) | SelfType | UnionType(_, _) | InlineRecordType(_):
			pending


private pure func scalar_union_decl_uses_byte_tags(union_decl: CoreUnionDecl) -> Bool:
	var uses_byte_tags: Bool = union_decl.variants.length() > 0

	for variant in union_decl.variants:
		if variant.tag < 0 or variant.tag > MAX_BYTE_UNION_TAG:
			uses_byte_tags = False
			break

	uses_byte_tags


pure func classify_c_record_layouts(
	specialize_layout: CoreSpecializeLayout,
	catalog: CoreTupleStorageCatalog,
	foreign_boundary_types: List[CoreType],
) -> Result[CRecordLayoutRegistry, CoreManagedRecordLayoutFault]:
	program: CoreProgram = specialize_layout.program
	decl_index ?= build_record_decl_index(specialize_layout, catalog)
	var foreign_heap_names: Set[String] = Sets.set()
	var declared_abi_names: Set[String] = Sets.set()
	var byte_sized_scalar_union_names: Set[String] = Sets.set()
	var visited_union_names: Set[String] = Sets.set()
	var pending: List[CoreType] = foreign_boundary_types
	var index: Int = 0

	for decl in program.decls:
		match decl:
			UnionDecl(union_decl):
				match union_decl.storage:
					ScalarTagStorage:
						if scalar_union_decl_uses_byte_tags(union_decl):
							byte_sized_scalar_union_names = Sets.add(byte_sized_scalar_union_names, union_decl.name)
					ManagedPayloadStorage(_):
						void
			HeapRecordDecl(record_decl):
				if record_decl.abi_type.is_some():
					declared_abi_names = Sets.add(declared_abi_names, record_decl.name)
			_:
				void

	while index < pending.length():
		match pending.get(index):
			Some(typ):
				resolved: CoreType = resolve_layout_type_with_index(decl_index.layout_types, typ)

				match resolved:
					HeapRecordType(record_name):
						if not Sets.contains(foreign_heap_names, record_name):
							foreign_heap_names = Sets.add(foreign_heap_names, record_name)

							match decl_index.managed_layouts.get(record_name):
								Some(record_decl):
									for field in managed_record_layout_fields(record_decl):
										pending = pending.append(field.typ)
								None:
									void
					UnionType(union_name, ManagedUnionValue):
						if not Sets.contains(visited_union_names, union_name):
							visited_union_names = Sets.add(visited_union_names, union_name)

							match decl_index.unions.get(union_name):
								Some(union_decl):
									for variant in union_decl.variants:
										for field in variant.fields:
											pending = pending.append(field.typ)
								None:
									void
					_:
						pending = append_nested_types(pending, resolved)
			None:
				void

		index += 1

	source_member_records: Set[String] = Sets.combine(declared_abi_names, foreign_heap_names)
	var source_member_fields: Dict[String, List[String]] = {}

	-- Only the records spelled by name build their member names; every other
	-- record spells a member from its ordinal when it is used.
	for decl in program.decls:
		match decl:
			HeapRecordDecl(record_decl):
				if (
					Sets.contains(source_member_records, record_decl.name)
					and not source_member_fields.contains(record_decl.name)
				):
					source_member_fields = source_member_fields.set(
						record_decl.name,
						record_decl.fields.map(func(field): c_field_name(field.name)),
					)
			_:
				void

	Ok({
		foreign_abi_heap_record_names = foreign_heap_names,
		byte_sized_scalar_union_names = byte_sized_scalar_union_names,
		source_member_fields = source_member_fields,
		managed_layouts = decl_index.managed_layouts,
		tuple_catalog = catalog
	})
