-- Classify record layouts before C emission.
--
-- Foreign pointer ABI exposure is transitive: changing an embedded record also
-- changes the containing foreign parameter or result. Keep that distinction
-- explicit so storage optimizations cannot depend on naming conventions.
import:
	../stage_06_typecheck/type_system/language_surface_manifest:
		DeclaredAbiType(DeclaredAbiMemStats, DeclaredAbiSchedulerStats),
	../stage_08_core_lower/list_layout: CoreLayoutTypeIndex, resolve_layout_type_with_index
	../stage_09_core/c_type_layout: c_type_name
	../stage_09_core/ir:
		CoreCallKind(ForeignCall),
		CoreDecl(FunctionDecl, GlobalDecl, HeapRecordDecl, ImplDecl, InlineRecordDecl, UnionDecl),
		CoreEnumDecl,
		CoreExpr(CallExpr),
		CoreFieldRef,
		CoreFunction,
		CoreFunctionKind(ForeignFunction),
		CoreHeapRecordDecl,
		CoreProgram,
		CoreType(
			BoxedResultType, EnumType, FunctionType, HeapRecordType, InlineRecordType, NamedType, RangeType, SelfType,
			StackResultType, TensorType, TupleType, TypeParameterType, UnionType,
			VoidType,
		),
		CoreUnionDecl,
		core_expr_type,
		core_field_ref_id,
		core_field_ref_is_resolved,
	../stage_09_core/specialize_layout: CoreSpecializeLayout
	../stage_09_core/traverse: immediate_core_expr_children
	c_naming: c_field_name, c_record_member_name
	set as Sets


enum CRecordLayout:
	InternalLayout
	ForeignAbiLayout






union CHeapRecordFieldStorage:
	OrdinaryCHeapRecordField(String)
	PackedBooleanCHeapRecordField


implements Equatable for CHeapRecordFieldStorage:
	pure func equals(left: CHeapRecordFieldStorage, right: CHeapRecordFieldStorage) -> Bool:
		match (left, right):
			(OrdinaryCHeapRecordField(left_value), OrdinaryCHeapRecordField(right_value)):
				left_value == right_value
			(PackedBooleanCHeapRecordField, PackedBooleanCHeapRecordField):
				True
			_:
				False

	pure func not_equals(left: CHeapRecordFieldStorage, right: CHeapRecordFieldStorage) -> Bool:
		not equals(left, right)


MAX_BYTE_ENUM_TAG: Int = 255


pure func c_record_field_type_is_boolean(typ: CoreType) -> Bool:
	match typ:
		NamedType(name, args):
			name == "Bool" and args.length() == 0
		EnumType(name):
			name == "Bool"
		_:
			False


pure func c_heap_record_field_storage(
	byte_sized_enum_names: Set[String],
	layout: CRecordLayout,
	typ: CoreType,
	has_boolean_neighbor: Bool,
	type_symbol_lookup: Dict[String, String],
) -> CHeapRecordFieldStorage:
	match layout:
		InternalLayout:
			if c_record_field_type_is_boolean(typ):
				if has_boolean_neighbor:
					PackedBooleanCHeapRecordField
				else:
					OrdinaryCHeapRecordField("_Bool")
			else:
				match typ:
					EnumType(name):
						if Sets.contains(byte_sized_enum_names, name):
							OrdinaryCHeapRecordField("uint8_t")
						else:
							OrdinaryCHeapRecordField(c_type_name(typ, type_symbol_lookup))
					_:
						OrdinaryCHeapRecordField(c_type_name(typ, type_symbol_lookup))
		ForeignAbiLayout:
			OrdinaryCHeapRecordField(c_type_name(typ, type_symbol_lookup))




record CRecordLayoutRegistry {
	foreign_abi_heap_record_names: Set[String],
	byte_sized_enum_names: Set[String],
	source_member_record_names: Set[String],
	record_member_names: Dict[Int, String]
}


---
Why classifying the record layouts failed: a record whose members are spelled
from field identity has a field with no typecheck identity, so it has no member
spelling. Names the record and the field.
---
union CRecordLayoutError:
	UnresolvedRecordFieldRef(String, String)


---
The member spelling of the record named `record_name`'s field `name` with identity
`ref`, for a site that has the field's identity but not its position: source names
for a record in `source_member_record_names` (a declared ABI record, or one reachable
from a foreign function's signature), `f<ordinal>` for every other, looked up in
`record_member_names`. That table is filled once per field when the layouts are
classified (a member access that rebuilt the string instead cost +0.44% backend
allocations), from the same ordinals the declaration sites use, so a declaration and
its accesses cannot disagree. `None` for a field of a non-ABI record the table does
not hold, which classification rules out for declared fields.
---
pure func c_record_member_of(
	layouts: CRecordLayoutRegistry,
	record_name: String,
	name: String,
	ref: CoreFieldRef,
) -> Option[String]:
	if Sets.contains(layouts.source_member_record_names, record_name):
		Some(c_field_name(name))
	else:
		layouts.record_member_names.get(core_field_ref_id(ref))


---
The member spelling of one record, for the sites that spell every field of a
record (its declaration, its constructor, its static initializer).
---
record CRecordMemberScope {
	layouts: CRecordLayoutRegistry,
	record_name: String
}


pure func c_record_member_scope(
	layouts: CRecordLayoutRegistry,
	record_name: String,
) -> CRecordMemberScope:
	{
		layouts = layouts,
		record_name = record_name
	}


pure func c_record_member(
	scope: CRecordMemberScope,
	name: String,
	ref: CoreFieldRef,
) -> Option[String]:
	c_record_member_of(scope.layouts, scope.record_name, name, ref)


---
The member spelling of the field at position `ordinal` of a record's declaration:
what `c_record_member_of` finds for it in the table, without the lookup, for the
declaration sites that walk the fields in order.
---
pure func c_declared_record_member(scope: CRecordMemberScope, name: String, ordinal: Int) -> String:
	if Sets.contains(scope.layouts.source_member_record_names, scope.record_name):
		c_field_name(name)
	else:
		c_record_member_name(ordinal)


private record CRecordDeclIndex {
	layout_types: CoreLayoutTypeIndex,
	heap_records: Dict[String, CoreHeapRecordDecl],
	unions: Dict[String, CoreUnionDecl]
}


private pure func build_record_decl_index(
	specialize_layout: CoreSpecializeLayout,
) -> CRecordDeclIndex:
	var heap_records: Dict[String, CoreHeapRecordDecl] = {}
	var unions: Dict[String, CoreUnionDecl] = {}

	for decl in specialize_layout.program.decls:
		match decl:
			HeapRecordDecl(record_decl):
				if not heap_records.contains(record_decl.name):
					heap_records = heap_records.set(record_decl.name, record_decl)
			UnionDecl(union_decl):
				if not unions.contains(union_decl.name):
					unions = unions.set(union_decl.name, union_decl)
			_:
				void

	{
		layout_types = specialize_layout.types,
		heap_records = heap_records,
		unions = unions
	}




pure func c_heap_record_layout(
	foreign_abi_heap_record_names: Set[String],
	record_name: String,
) -> CRecordLayout:
	if Sets.contains(foreign_abi_heap_record_names, record_name):
		ForeignAbiLayout
	else:
		InternalLayout


private pure func append_foreign_signature_types_for_function(
	types: List[CoreType],
	function_info: CoreFunction,
) -> List[CoreType]:
	var result: List[CoreType] = types

	match function_info.function_kind:
		ForeignFunction(_):
			for param in function_info.params:
				result = result.append(param.typ)

			result.append(function_info.return_type)
		_:
			result


private pure func foreign_call_types(root: CoreExpr) -> List[CoreType]:
	var result: List[CoreType] = []
	var pending: List[CoreExpr] = [root]
	var pending_count: Int = 1

	while pending_count > 0:
		pending_count -= 1

		match pending.get(pending_count):
			Some(expr):
				match expr:
					CallExpr(ForeignCall(_, _), _, args, return_type, _):
						for arg in args:
							result = result.append(core_expr_type(arg))

						result = result.append(return_type)
					_:
						void

				for child in immediate_core_expr_children(expr):
					pending = if pending_count < pending.length():
						pending.set(pending_count, child)
					else:
						pending.append(child)

					pending_count += 1
			None:
				void

	result


pure func collect_foreign_boundary_types(program: CoreProgram) -> List[CoreType]:
	var types: List[CoreType] = []

	for decl in program.decls:
		match decl:
			FunctionDecl(function_info):
				types = append_foreign_signature_types_for_function(types, function_info)

				match function_info.body:
					Some(body):
						for typ in foreign_call_types(body):
							types = types.append(typ)
					None:
						void
			GlobalDecl(global):
				for typ in foreign_call_types(global.init):
					types = types.append(typ)
			ImplDecl(impl_info):
				for method in impl_info.methods:
					types = append_foreign_signature_types_for_function(types, method)

					match method.body:
						Some(body):
							for typ in foreign_call_types(body):
								types = types.append(typ)
						None:
							void
			_:
				void

	types


private pure func append_nested_types(pending: List[CoreType], typ: CoreType) -> List[CoreType]:
	match typ:
		NamedType(_, args):
			pending.concat(args)
		StackResultType(ok_type, err_type) | BoxedResultType(ok_type, err_type):
			pending
				.append(ok_type)
				.append(err_type)
		FunctionType(_, params, return_type):
			pending
				.concat(params)
				.append(return_type)
		TensorType(info):
			pending.append(info.element_type)
		TupleType(items):
			pending.concat(items)
		VoidType | EnumType(_) | HeapRecordType(_) | InlineRecordType(_) | RangeType | TypeParameterType(_) | SelfType | UnionType(_):
			pending


private pure func enum_decl_uses_byte_tags(enum_decl: CoreEnumDecl) -> Bool:
	var uses_byte_tags: Bool = enum_decl.variants.length() > 0

	for variant in enum_decl.variants:
		if variant.tag < 0 or variant.tag > MAX_BYTE_ENUM_TAG:
			uses_byte_tags = False
			break

	uses_byte_tags


---
`names` with the spelling of the field at `ordinal`, keyed by its identity. A generic
record's instances copy its fields with their ids and in order, so one id has one
ordinal in every instance and the first one recorded stands.
---
private pure func with_member_name(
	names: Dict[Int, String],
	ref: CoreFieldRef,
	ordinal: Int,
) -> Dict[Int, String]:
	field_id: Int = core_field_ref_id(ref)

	if names.contains(field_id) or not core_field_ref_is_resolved(ref):
		names
	else:
		names.set(field_id, c_record_member_name(ordinal))


---
The first field with no typecheck identity that sits in a record whose members are
spelled from identity; an ABI record's members keep their names, so an unresolved
field there is not an error.
---
private pure func first_unresolved_outside(
	unresolved: List[CRecordLayoutError],
	source_member_names: Set[String],
) -> Option[CRecordLayoutError]:
	var found: Option[CRecordLayoutError] = None

	for error in unresolved:
		match error:
			UnresolvedRecordFieldRef(record_name, _):
				if found.is_none() and not Sets.contains(source_member_names, record_name):
					found = Some(error)

	found


---
Member spellings collected from every record declaration, and the fields
that have no typecheck identity to spell a member from.
---
private record RecordMemberScan {
	member_names: Dict[Int, String],
	unresolved: List[CRecordLayoutError]
}


private pure func with_record_member(
	scan: RecordMemberScan,
	record_name: String,
	ref: CoreFieldRef,
	field_name: String,
	ordinal: Int,
) -> RecordMemberScan:
	member_names: Dict[Int, String] = with_member_name(scan.member_names, ref, ordinal)

	if core_field_ref_is_resolved(ref):
		{ scan | member_names = member_names }
	else:
		{
			member_names = member_names,
			unresolved = scan.unresolved.append(UnresolvedRecordFieldRef(record_name, field_name))
		}


pure func classify_c_record_layouts(
	specialize_layout: CoreSpecializeLayout,
	foreign_boundary_types: List[CoreType],
) -> Result[CRecordLayoutRegistry, CRecordLayoutError]:
	program: CoreProgram = specialize_layout.program
	decl_index: CRecordDeclIndex = build_record_decl_index(specialize_layout)
	var foreign_heap_names: Set[String] = Sets.set()
	var declared_abi_names: Set[String] = Sets.set()
	var members: RecordMemberScan = {member_names = {}, unresolved = []}
	var byte_sized_enum_names: Set[String] = Sets.set()
	var visited_union_names: Set[String] = Sets.set()
	var pending: List[CoreType] = foreign_boundary_types
	var index: Int = 0

	for decl in program.decls:
		match decl:
			EnumDecl(enum_decl):
				if enum_decl_uses_byte_tags(enum_decl):
					byte_sized_enum_names = Sets.add(byte_sized_enum_names, enum_decl.name)
			HeapRecordDecl(record_decl):
				if record_decl.abi_type.is_some():
					declared_abi_names = Sets.add(declared_abi_names, record_decl.name)

				for (ordinal, field) in record_decl.fields.enumerate():
					members = with_record_member(members, record_decl.name, field.ref, field.name, ordinal)
			InlineRecordDecl(record_decl):
				for (ordinal, field) in record_decl.fields.enumerate():
					members = with_record_member(members, record_decl.name, field.ref, field.name, ordinal)
			_:
				void

	while index < pending.length():
		match pending.get(index):
			Some(typ):
				resolved: CoreType = resolve_layout_type_with_index(decl_index.layout_types, typ)

				match resolved:
					HeapRecordType(record_name):
						if not Sets.contains(foreign_heap_names, record_name):
							foreign_heap_names = Sets.add(foreign_heap_names, record_name)

							match decl_index.heap_records.get(record_name):
								Some(record_decl):
									for field in record_decl.fields:
										pending = pending.append(field.typ)
								None:
									void
					UnionType(union_name):
						if not Sets.contains(visited_union_names, union_name):
							visited_union_names = Sets.add(visited_union_names, union_name)

							match decl_index.unions.get(union_name):
								Some(union_decl):
									for variant in union_decl.variants:
										for field in variant.fields:
											pending = pending.append(field.typ)
								None:
									void
					_:
						pending = append_nested_types(pending, resolved)
			None:
				void

		index += 1

	source_member_names: Set[String] = Sets.combine(declared_abi_names, foreign_heap_names)
	unresolved: Option[CRecordLayoutError] = first_unresolved_outside(
		members.unresolved,
		source_member_names,
	)

	match unresolved:
		Some(error):
			Err(error)
		None:
			Ok({
				foreign_abi_heap_record_names = foreign_heap_names,
				byte_sized_enum_names = byte_sized_enum_names,
				source_member_record_names = source_member_names,
				record_member_names = members.member_names,
			})
