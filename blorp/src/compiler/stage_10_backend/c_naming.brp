-- Shared C identifier spelling used by final backend emission and symbol
-- projection. Classification belongs to callers; this module only applies C
-- spelling rules and constructs names derived from an already-classified
-- callable.
-- This includes language keywords and compiler-provided object-like macros.
-- GCC defines `linux` in non-strict C modes before processing our artifact.
import:
	../stage_09_core/ir:
		CoreBinderOrigin(
			AuthoredBinder,
			DerivedFrom,
			LoweringTemporary,
			PassTemporary,
			PerceusBorrowedResultTemporary,
			PerceusTemporary,
		),
		CoreVar,
		DerivedTempKind(AssignTemp, BorrowedView, ClosureDropTemp, DropTemp),
		PerceusBorrowedResultKind(
			BorrowedResultAlias,
			BorrowedResultCallArg,
			BorrowedResultEqualityArg,
		),
		PerceusTempKind(
			PerceusAggregateField,
			PerceusBorrowArg,
			PerceusBorrowCallee,
			PerceusBorrowCastSource,
			PerceusCowArg,
			PerceusEqualityArg,
			PerceusOwnedCastSource,
			PerceusOwnedFieldOwner,
			PerceusOwnedListGetSource,
			PerceusOwnedResult,
		),
	string: string as make_string


private C_RESERVED_IDENTIFIERS: List[String] = [
	"auto",
	"break",
	"case",
	"char",
	"const",
	"continue",
	"default",
	"do",
	"double",
	"else",
	"enum",
	"extern",
	"float",
	"for",
	"goto",
	"if",
	"inline",
	"int",
	"long",
	"register",
	"restrict",
	"return",
	"short",
	"signed",
	"sizeof",
	"static",
	"struct",
	"switch",
	"typedef",
	"union",
	"unsigned",
	"void",
	"volatile",
	"while",
	"_Alignas",
	"_Alignof",
	"_Atomic",
	"_Bool",
	"_Complex",
	"_Generic",
	"_Imaginary",
	"_Noreturn",
	"_Static_assert",
	"_Thread_local",
	"alignas",
	"alignof",
	"bool",
	"false",
	"true",
	"nullptr",
	"static_assert",
	"thread_local",
	"typeof",
	"typeof_unqual",
	"linux",
]


---
`C_RESERVED_IDENTIFIERS` published as a membership index, built once. Every
call to `c_identifier` (transitively, every emitted local reference through
`c_local_name`) tested the list with a linear `List.contains` scan of up to
54 string comparisons; the index turns that into one hash lookup.
---
private pure func c_reserved_identifier_index() -> Dict[String, Bool]:
	var index: Dict[String, Bool] = {}

	for name in C_RESERVED_IDENTIFIERS:
		index = index.set(name, True)

	index


private C_RESERVED_IDENTIFIER_INDEX: Dict[String, Bool] = c_reserved_identifier_index()

-- Struct member names the runtime owns. A heap record's C struct opens with
-- the ARC object header, spelled `blorp_Object header` in `runtime.c`, so a
-- declared field of the same name would emit a duplicate member and retarget
-- every read and write of that field at the header. These names stay legal in
-- Blorp source and are escaped on the way out instead.
private C_RESERVED_STRUCT_MEMBERS: List[String] = ["header"]


---
`C_RESERVED_STRUCT_MEMBERS` published as a membership index, built once, for
the same reason `c_reserved_identifier_index` exists: every emitted field
declaration and every field read goes through `c_field_name`.
---
private pure func c_reserved_struct_member_index() -> Dict[String, Bool]:
	var index: Dict[String, Bool] = {}

	for name in C_RESERVED_STRUCT_MEMBERS:
		index = index.set(name, True)

	index


private C_RESERVED_STRUCT_MEMBER_INDEX: Dict[String, Bool] = c_reserved_struct_member_index()

private RESERVED_STRUCT_MEMBER_C_PREFIX: String = "__blorp_field_"

private COMPILER_LOCAL_PREFIX: String = "$blorp$"

private COMPILER_LOCAL_C_PREFIX: String = "__blorp_internal_"

private ESCAPED_SOURCE_LOCAL_C_PREFIX: String = "__blorp_source_"

-- Compact emission owns this namespace for short-lived compiler-generated
-- temporaries. Source locals using the same prefix are escaped by
-- `c_local_name`, keeping the generated spelling injective.
COMPACT_TEMP_C_PREFIX: String = "__t"

CANONICAL_EMPTY_LIST_C_PREFIX: String = "__blorp_canonical_empty_list_"

BUILTIN_STACK_OPTION_INT128_OPTION_C_TYPE: String = "blorp_StackOption_Int128"

BUILTIN_STACK_OPTION_UINT128_OPTION_C_TYPE: String = "blorp_StackOption_UInt128"

BUILTIN_STACK_OPTION_RANGE_OPTION_C_TYPE: String = "blorp_StackOption_Range"


private pure func is_compact_temp_c_name(name: String) -> Bool:
	-- Compact temporaries are `__t<base62-kind>_<index>`. Reserve that exact
	-- shape; broader `__t...` names such as compiler-owned tailrec locals remain
	-- readable. Accepting any non-empty base-62 kind keeps this collision guard
	-- authoritative as the emitter's explicit, stable kind table grows.
	if name.length() < 6 or not name.starts_with(COMPACT_TEMP_C_PREFIX):
		False
	else:
		var index: Int = 3
		var kind_is_valid: Bool = True
		var found_separator: Bool = False
		while kind_is_valid and not found_separator and index < name.length():
			kind: Char = name.get_or(index, '_')
			if kind == '_':
				if index > 3:
					found_separator = True
				else:
					kind_is_valid = False
			else:
				kind_is_valid = (
					(kind >= '0' and kind <= '9')
					or (kind >= 'a' and kind <= 'z')
					or (kind >= 'A' and kind <= 'Z')
				)
			index += 1

		var suffix_is_numeric: Bool = found_separator and index < name.length()
		while suffix_is_numeric and index < name.length():
			digit: Char = name.get_or(index, 'x')
			suffix_is_numeric = digit >= '0' and digit <= '9'
			index += 1

		kind_is_valid and suffix_is_numeric


pure func c_identifier(name: String) -> String:
	if C_RESERVED_IDENTIFIER_INDEX.contains(name):
		name + "_"
	else:
		name


---
The C spelling of a declared record field of an ABI record: a record whose
members C code outside the compiler reads (a declared ABI type such as `MemStats`
or `SchedulerStats`, or a record reachable from a foreign function's signature).
Its members keep the source name; every other record's members are spelled from
the field's position by `c_record_member_name`. Fields the runtime reserves take
a prefixed name; a source field already spelled with that prefix is escaped the
same way, so the mapping stays one-to-one.

The records that map onto runtime-declared C structs (`MemStats`,
`SchedulerStats`) have no reserved member name, so their spelling is unchanged.
---
pure func c_field_name(name: String) -> String:
	if (
		C_RESERVED_STRUCT_MEMBER_INDEX.contains(name)
		or name.starts_with(RESERVED_STRUCT_MEMBER_C_PREFIX)
	):
		RESERVED_STRUCT_MEMBER_C_PREFIX + name
	else:
		c_identifier(name)


private RECORD_MEMBER_C_PREFIX: String = "f"

---
`f<ordinal>`: the struct member of a non-ABI record's field, spelled from the field's
position in its record's declaration, never from its source name. A struct only ever
holds one record's fields, so the ordinals are distinct within it, and the members
sit in the struct's own namespace: they cannot meet the runtime's `header` member
or a `brp_` symbol. The ordinal comes from the layout classification, which keys it
by the field's identity for the sites that only have the identity.

Chosen over `brp_f_<b62 field id>` on size: the self-compile artifact is 68,035,852
bytes with `f<ordinal>` and 68,579,944 with `brp_f_<id>` (the un-projected members
were 68,660,353), so the ordinal saves 0.79% more. Emitted C need not be stable when
fields are reordered, so an ordinal's dependence on position costs nothing.
---
pure func c_record_member_name(ordinal: Int) -> String:
	match RECORD_MEMBER_NAMES.get(ordinal):
		Some(spelling):
			spelling
		None:
			RECORD_MEMBER_C_PREFIX + ordinal.to_string()


-- The spellings of the first ordinals, built once: a declaration site spells every
-- field of every record instance, and building `f<n>` there costs two allocations.
private RECORD_MEMBER_NAMES_LENGTH: Int = 64

private RECORD_MEMBER_NAMES: List[String] = record_member_names_below(RECORD_MEMBER_NAMES_LENGTH)


private pure func record_member_names_below(count: Int) -> List[String]:
	var names: List[String] = []

	for ordinal in 0..count:
		names = names.append(RECORD_MEMBER_C_PREFIX + ordinal.to_string())

	names


private BASE62_ALPHABET: String = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"

private BASE62_RADIX: Int = 62

-- Spellings of a local by binder identity. A positive `CoreVar.id` is an
-- authored (lowering) or seeded-band binder, a negative one a binder a pass
-- minted from `CorePassState.next_binder_id`; each is unique within a
-- function, so the spelling is a pure function of the `CoreVar` and needs no
-- rename pass or scope table. The underscore after `brp_v` is deliberate: a
-- callable spelling is `brp_` followed directly by a base-62 digit, which can
-- itself be `v` (or `vn`), so without it a callable could equal a local; no
-- callable has `_` there. `n` marks the minted (negative) domain so `+id`
-- and `-id` never spell alike.
private PROJECTED_LOCAL_PREFIX: String = "brp_v_"

private PROJECTED_MINTED_LOCAL_PREFIX: String = "brp_vn_"

private pure func base62_digit_strings() -> List[String]:
	var digits: List[String] = []

	for digit in 0..BASE62_RADIX:
		digits = digits.append(BASE62_ALPHABET.substring(digit, 1))

	digits


private BASE62_DIGIT_STRINGS: List[String] = base62_digit_strings()

---
`prefix` followed by `value` in base 62 (`"0"` for zero), built in one
buffer allocated up front. `c_binder_name` runs once per emitted occurrence
of a local, so encoding by prepending a digit at a time (an allocation per
digit) was several times the cost of the one allocation this needs.
---
private pure func base62_spelling(prefix: String, value: Int) -> String:
	var digit_count: Int = 1
	var scale: Int = 1

	while value / scale >= BASE62_RADIX:
		scale *= BASE62_RADIX
		digit_count += 1

	var spelling: String = make_string(prefix.length() + digit_count)
	spelling += prefix
	var remaining: Int = value

	while scale > 0:
		spelling += BASE62_DIGIT_STRINGS.get_or(remaining / scale, "")
		remaining = remaining % scale
		scale /= BASE62_RADIX

	spelling


private pure func base62_spelling_with_suffix(prefix: String, value: Int, suffix: String) -> String:
	var digit_count: Int = 1
	var scale: Int = 1

	while value / scale >= BASE62_RADIX:
		scale *= BASE62_RADIX
		digit_count += 1

	var spelling: String = make_string(prefix.length() + digit_count + suffix.length())
	spelling += prefix
	var remaining: Int = value

	while scale > 0:
		spelling += BASE62_DIGIT_STRINGS.get_or(remaining / scale, "")
		remaining = remaining % scale
		scale /= BASE62_RADIX

	spelling += suffix
	spelling


pure func encode_base62(value: Int) -> String:
	base62_spelling("", value)


---
The C spelling of a local variable occurrence. Id 0 ("not minted", the
binders docs/CORE_ID_MIGRATION.md still has to convert) and the discard
binder keep the escaped source spelling of `c_local_name`.
---
pure func c_binder_name(name: String, id: Int) -> String:
	if name == "_" or id == 0:
		c_local_name(name)
	else if id > 0:
		base62_spelling(PROJECTED_LOCAL_PREFIX, id)
	else:
		base62_spelling(PROJECTED_MINTED_LOCAL_PREFIX, 0 - id)


-- Spellings of the Perceus temporaries. A Perceus temporary shares its id (the
-- negated packed node handle) with every temporary at the same node, so its
-- spelling adds a kind letter and an ordinal: `brp_vt_<b62 |id|>_<kind><n>`,
-- with `_<owner>` appended for the borrowed-result kinds, where the borrowed
-- owner parameter is what tells two temporaries at one call argument apart. A
-- temporary derived from a protected variable is
-- `brp_vd_<anchor key>_<kind><n>`; the key is built from the anchor's id and
-- origin (an anchor that is itself a temporary contributes its own kind and
-- ordinal, since its id alone does not identify it; an anchor with no id
-- contributes its escaped name). Each is built once, where the temporary is
-- created, by exactly these two functions, and stored as the variable's `name`:
-- for these two origins the name IS the projected C spelling, so emission
-- passes it through and a `String` shared by reference costs nothing per
-- occurrence. This is interim, until Perceus carries threaded state and can
-- mint dense binder ids. Both families are disjoint from `brp_v_`, `brp_vn_`,
-- callables (`brp_` then a base-62 digit), `brp_c_`, `brp_t_`, `brp_ty`, `brp_g`.
private PROJECTED_PERCEUS_TEMPORARY_PREFIX: String = "brp_vt_"

private PROJECTED_DERIVED_LOCAL_PREFIX: String = "brp_vd_"

private pure func perceus_temp_kind_letter(kind: PerceusTempKind) -> String:
	match kind:
		PerceusAggregateField:
			"a"
		PerceusBorrowArg:
			"b"
		PerceusBorrowCallee:
			"c"
		PerceusBorrowCastSource:
			"d"
		PerceusCowArg:
			"e"
		PerceusEqualityArg:
			"f"
		PerceusOwnedCastSource:
			"g"
		PerceusOwnedFieldOwner:
			"h"
		PerceusOwnedListGetSource:
			"i"
		PerceusOwnedResult:
			"j"


private pure func borrowed_result_kind_letter(kind: PerceusBorrowedResultKind) -> String:
	match kind:
		BorrowedResultAlias:
			"k"
		BorrowedResultCallArg:
			"l"
		BorrowedResultEqualityArg:
			"m"


private pure func derived_temp_kind_letter(kind: DerivedTempKind) -> String:
	match kind:
		DropTemp:
			"d"
		BorrowedView:
			"v"
		AssignTemp:
			"a"
		ClosureDropTemp:
			"c"


private pure func borrowed_owner_key(owner_id: Int) -> String:
	if owner_id >= 0:
		encode_base62(owner_id)
	else:
		"n" + encode_base62(0 - owner_id)


private pure func perceus_temporary_suffix(kind: PerceusTempKind, ordinal: Int) -> String:
	perceus_temp_kind_letter(kind) + ordinal.to_string()


private pure func borrowed_result_suffix(kind: PerceusBorrowedResultKind, ordinal: Int, owner_id: Int) -> String:
	borrowed_result_kind_letter(kind) + ordinal.to_string() + "_" + borrowed_owner_key(owner_id)


---
`brp_vt_<b62 |id|>_<kind letter><ordinal>`, built in one buffer.
---
pure func perceus_temporary_spelling(kind: PerceusTempKind, id: Int, ordinal: Int) -> String:
	base62_spelling_with_suffix(
		PROJECTED_PERCEUS_TEMPORARY_PREFIX,
		0 - id,
		"_" + perceus_temporary_suffix(kind, ordinal),
	)


---
`brp_vt_<b62 |id|>_<kind letter><ordinal>_<owner>`: the borrowed owner parameter
is what tells two temporaries at one call argument apart, since they share node,
kind and ordinal.
---
pure func perceus_borrowed_result_spelling(
	kind: PerceusBorrowedResultKind,
	id: Int,
	ordinal: Int,
	owner_id: Int,
) -> String:
	base62_spelling_with_suffix(
		PROJECTED_PERCEUS_TEMPORARY_PREFIX,
		0 - id,
		"_" + borrowed_result_suffix(kind, ordinal, owner_id),
	)


---
The identity of a variable a temporary is derived from, spelled once when the
derived temporary is created and stored in its `DerivedFrom` origin. It reads the
anchor's id and origin, never a spelling of its name (an anchor with neither an
id nor a temporary origin contributes its escaped name); an anchor that is itself
a temporary contributes its own kind and ordinal, since its id alone does not
identify it.
---
pure func derived_anchor_key(anchor: CoreVar) -> String:
	match anchor.origin:
		PerceusTemporary(kind, ordinal):
			"t" + encode_base62(0 - anchor.id) + "_" + perceus_temporary_suffix(kind, ordinal)
		PerceusBorrowedResultTemporary(kind, ordinal, owner_id):
			"t" + encode_base62(0 - anchor.id) + "_" + borrowed_result_suffix(kind, ordinal, owner_id)
		DerivedFrom(anchor_key, kind, ordinal):
			"d" + anchor_key + "_" + derived_temp_kind_letter(kind) + ordinal.to_string()
		_:
			if anchor.id > 0:
				"p" + encode_base62(anchor.id)
			else if anchor.id < 0:
				"n" + encode_base62(0 - anchor.id)
			else:
				"z" + c_local_name(anchor.name)


---
`brp_vd_<anchor key>_<kind letter><ordinal>` for a temporary derived from the
variable whose `derived_anchor_key` is `anchor_key`.
---
pure func derived_temporary_spelling(anchor_key: String, kind: DerivedTempKind, ordinal: Int) -> String:
	PROJECTED_DERIVED_LOCAL_PREFIX + anchor_key + "_" + derived_temp_kind_letter(kind) + ordinal.to_string()


---
The spelling `variable`'s `(id, origin)` promises for a Perceus or derived
temporary, recomputed from those two alone; `None` for every other origin, whose
spelling is `c_binder_name`. The identity contract requires a temporary's stored
`name` to equal it.
---
pure func projected_temporary_spelling(variable: CoreVar) -> Option[String]:
	match variable.origin:
		PerceusTemporary(kind, ordinal):
			Some(perceus_temporary_spelling(kind, variable.id, ordinal))
		PerceusBorrowedResultTemporary(kind, ordinal, owner_id):
			Some(perceus_borrowed_result_spelling(kind, variable.id, ordinal, owner_id))
		DerivedFrom(anchor_key, kind, ordinal):
			Some(derived_temporary_spelling(anchor_key, kind, ordinal))
		_:
			None


--- Whether `variable`'s name has the family shape its origin promises. This is
--- the cheap emission guard; the identity contract compares against the full
--- `projected_temporary_spelling`. Any origin other than a Perceus or derived
--- temporary has no such promise.
pure func temporary_name_is_projected(variable: CoreVar) -> Bool:
	match variable.origin:
		PerceusTemporary(_, _) | PerceusBorrowedResultTemporary(_, _, _):
			variable.name.starts_with(PROJECTED_PERCEUS_TEMPORARY_PREFIX)
		DerivedFrom(_, _, _):
			variable.name.starts_with(PROJECTED_DERIVED_LOCAL_PREFIX)
		_:
			True


private INVALID_PROJECTED_TEMPORARY_NAME: String = "__blorp_invalid_projected_temporary"

---
The C spelling of a local variable occurrence, a pure function of its id and
origin. A Perceus or derived temporary's `name` already is its projected
spelling (see above); a name outside the family fails closed to a spelling the C
compiler rejects. Every other local is spelled from its id by `c_binder_name`.
---
pure func c_local_spelling(name: String, id: Int, origin: CoreBinderOrigin) -> String:
	c_variable_spelling({
		name = name,
		id = id,
		def_id = None,
		origin = origin
	})


pure func c_variable_spelling(variable: CoreVar) -> String:
	if temporary_name_is_projected(variable):
		match variable.origin:
			PerceusTemporary(_, _) | PerceusBorrowedResultTemporary(_, _, _) | DerivedFrom(_, _, _):
				variable.name
			_:
				c_binder_name(variable.name, variable.id)
	else:
		INVALID_PROJECTED_TEMPORARY_NAME


-- Spellings of a union or enum variant by definition identity. Every variant
-- declaration carries a `def_id` that is unique across the artifact (a
-- monomorphized union mints a fresh one per variant per instantiation), so
-- the constructor symbol and the tag symbol are pure functions of it and do
-- not repeat the type and variant names in every reference. As with locals
-- the underscore after `brp_c` / `brp_t` is deliberate: a callable spelling is
-- `brp_` followed directly by a base-62 digit (which can itself be `c` or
-- `t`), a type spelling is `brp_ty`, a local `brp_v_`/`brp_vn_`, a global
-- `brp_g`; none has `_` in the second position, so the families cannot
-- collide with each other or with a callable. A variant with no definition
-- identity (a hand-built declaration for a runtime-provided union) keeps its
-- source-derived spelling.
private PROJECTED_VARIANT_CONSTRUCTOR_PREFIX: String = "brp_c_"

private PROJECTED_VARIANT_TAG_PREFIX: String = "brp_t_"

private SOURCE_VARIANT_TAG_PREFIX: String = "TAG_"


pure func variant_constructor_symbol(variant_name: String, def_id: Option[Int]) -> String:
	match def_id:
		Some(id):
			base62_spelling(PROJECTED_VARIANT_CONSTRUCTOR_PREFIX, id)
		None:
			variant_name


pure func variant_tag_symbol(type_name: String, variant_name: String, def_id: Option[Int]) -> String:
	match def_id:
		Some(id):
			base62_spelling(PROJECTED_VARIANT_TAG_PREFIX, id)
		None:
			SOURCE_VARIANT_TAG_PREFIX + type_name + "_" + variant_name


pure func c_local_name(name: String) -> String:
	-- Later Core passes may derive a local from another compiler-owned local.
	-- Preserve that namespace even when its marker is no longer at the start.
	if name.contains(COMPILER_LOCAL_PREFIX):
		COMPILER_LOCAL_C_PREFIX + name
			.replace(COMPILER_LOCAL_PREFIX, "")
			.replace("$", "_")
	else if (
		name.starts_with(COMPILER_LOCAL_C_PREFIX)
		or is_compact_temp_c_name(name)
		or name.starts_with(CANONICAL_EMPTY_LIST_C_PREFIX)
		or name.starts_with(ESCAPED_SOURCE_LOCAL_C_PREFIX)
	):
		ESCAPED_SOURCE_LOCAL_C_PREFIX + name
			.length()
			.to_string() + "_" + name
	else:
		c_identifier(name)


pure func static_closure_name(c_name: String) -> String:
	"__sc_" + c_identifier(c_name)


---
Every C identifier derived from a declared type's name (record make/destroy/
reuse, enum to-string helpers, union destroy helpers), computed once per
type name. Backends look these fields up instead of re-deriving a name by
concatenation on every reference; see `build_backend_type_naming` for the
single per-program builder.
---
record BackendTypeNaming {
	c_name: String,
	make_name: String,
	destroy_name: String,
	reuse_name: String,
	enum_to_string_name: String,
	enum_vector_to_string_name: String,
	union_destroy_stack_push_name: String,
	union_destroy_release_child_name: String,
	union_destroy_fields_name: String
}


pure func backend_type_naming(type_name: String) -> BackendTypeNaming:
	c_name: String = c_identifier(type_name)
	{
		c_name = c_name,
		make_name = c_name + "_make",
		destroy_name = c_name + "_destroy",
		reuse_name = "__blorp_reuse_record_" + c_name,
		enum_to_string_name = "__blorp_enum_to_string_" + c_name,
		enum_vector_to_string_name = "blorp_vector_to_string_" + c_name,
		union_destroy_stack_push_name = c_name + "_destroy_stack_push",
		union_destroy_release_child_name = c_name + "_destroy_release_child",
		union_destroy_fields_name = c_name + "_destroy_fields"
	}


pure func union_instance_name(variant_c_name: String) -> String:
	"__instance_" + c_identifier(variant_c_name)


pure func union_init_name(variant_c_name: String) -> String:
	"__init_" + c_identifier(variant_c_name)


pure func union_reuse_name(type_name: String, variant_c_name: String) -> String:
	"__blorp_reuse_" + c_identifier(type_name) + "_" + c_identifier(variant_c_name)


pure func static_child_path(parent_path: String, field_name: String) -> String:
	parent_path + "_" + c_identifier(field_name)


pure func static_list_child_path(parent_path: String, index: Int) -> String:
	parent_path + "_elem_" + index.to_string()


pure func static_tuple_child_path(parent_path: String, index: Int) -> String:
	parent_path + "_" + index.to_string()


pure func static_union_child_path(
	parent_path: String,
	constructor_name: String,
	index: Int,
) -> String:
	parent_path + "_" + c_identifier(constructor_name) + "_" + index.to_string()


pure func static_record_storage_name(path: String) -> String:
	"__blorp_static_record_" + path


pure func static_tuple_storage_name(path: String) -> String:
	"__blorp_static_tuple_" + path


pure func static_union_storage_name(path: String) -> String:
	"__blorp_static_union_" + path


pure func static_list_storage_name(path: String) -> String:
	"__blorp_static_list_" + path
