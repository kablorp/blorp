---
C renderer helpers for prepared constructor emission.

`emit.brp` decides representation and renders child Core expressions.
This module owns the final C shape once the constructor callee and argument
list are known.
---
record ConstructorCallArgs {
	callee: String,
	argument_list: String
}


record InlineTaggedValueArgs {
	c_type: String,
	tag: String,
	value: String
}


record InlineTaggedVoidStatementArgs {
	c_type: String,
	tag: String,
	statement: String
}


record InlineTaggedEmptyArgs {
	c_type: String,
	tag: String,
	empty_value: String
}


record StackResultPayloadArgs {
	result_type: String,
	tag: String,
	field: String,
	payload: String,
	release_mask: String
}


union PreparedConstructorOp:
	ConstructorCall(ConstructorCallArgs)
	ConstructorSymbol(String)
	ConstructorNullableNone
	ConstructorNullablePayload(String)
	InlineTaggedValue(InlineTaggedValueArgs)
	InlineTaggedVoidStatement(InlineTaggedVoidStatementArgs)
	InlineTaggedEmpty(InlineTaggedEmptyArgs)
	StackResultPayload(StackResultPayloadArgs)


pure func render_constructor_call(args: ConstructorCallArgs) -> String:
	args.callee + "(" + args.argument_list + ")"


pure func render_inline_tagged_value(args: InlineTaggedValueArgs) -> String:
	"((" + args.c_type + "){ .tag = " + args.tag + ", .value = " + args.value + " })"


pure func render_inline_tagged_void_statement(args: InlineTaggedVoidStatementArgs) -> String:
	"({ " + args.statement + " ((" + args.c_type + "){ .tag = " + args.tag + ", .value = 0 }); })"


pure func render_inline_tagged_empty(args: InlineTaggedEmptyArgs) -> String:
	"((" + args.c_type + "){ .tag = " + args.tag + ", .value = " + args.empty_value + " })"


pure func render_inline_tagged_match_test(source: String, tag: String) -> String:
	source + ".tag == " + tag


pure func render_stack_result_payload(args: StackResultPayloadArgs) -> String:
	"((" + args.result_type + "){ .tag = " + args.tag + ", .release_mask = " + args.release_mask + "UL, .data." + args.field + ".field0 = " + args.payload + " })"


pure func render_prepared_constructor_op(op: PreparedConstructorOp) -> String:
	match op:
		ConstructorCall(args):
			render_constructor_call(args)
		ConstructorSymbol(name):
			name
		ConstructorNullableNone:
			"NULL"
		ConstructorNullablePayload(payload):
			payload
		InlineTaggedValue(args):
			render_inline_tagged_value(args)
		InlineTaggedVoidStatement(args):
			render_inline_tagged_void_statement(args)
		InlineTaggedEmpty(args):
			render_inline_tagged_empty(args)
		StackResultPayload(args):
			render_stack_result_payload(args)
