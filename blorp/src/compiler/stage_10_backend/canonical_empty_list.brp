import:
	../stage_09_core/ir:
		CoreListConstruct,
		CoreListStorageLayout(InlineListStorage, InlineStructListStorage, PointerListStorage),
	c_naming: CANONICAL_EMPTY_LIST_C_PREFIX, c_identifier


record CanonicalEmptyList {
	layout: CoreListStorageLayout,
	elem_needs_release: Bool,
	symbol_name: String
}


pure func canonical_empty_list_layout_is_valid(construct: CoreListConstruct) -> Bool:
	match construct.layout:
		PointerListStorage:
			True
		InlineListStorage(width_bytes):
			not construct.elem_needs_release and width_bytes > 0
		InlineStructListStorage(c_type):
			not construct.elem_needs_release and not c_type.is_empty()


pure func canonical_empty_list_for_construct(
	construct: CoreListConstruct,
) -> Option[CanonicalEmptyList]:
	if construct.elements.length() != 0 or not canonical_empty_list_layout_is_valid(construct):
		None
	else:
		match construct.layout:
			PointerListStorage:
				policy: String = if construct.elem_needs_release:
					"managed"
				else:
					"plain"

				Some({
					layout = construct.layout,
					elem_needs_release = construct.elem_needs_release,
					symbol_name = CANONICAL_EMPTY_LIST_C_PREFIX + "pointer_" + policy,
				})
			InlineListStorage(width_bytes):
				Some({
					layout = construct.layout,
					elem_needs_release = False,
					symbol_name = CANONICAL_EMPTY_LIST_C_PREFIX + "inline_" + width_bytes.to_string(),
				})
			InlineStructListStorage(c_type):
				Some({
					layout = construct.layout,
					elem_needs_release = False,
					symbol_name = CANONICAL_EMPTY_LIST_C_PREFIX + "struct_" + c_identifier(c_type),
				})


pure func canonical_empty_list_keys_equal(
	left: CanonicalEmptyList,
	right: CanonicalEmptyList,
) -> Bool:
	match left.layout:
		PointerListStorage:
			match right.layout:
				PointerListStorage:
					left.elem_needs_release == right.elem_needs_release
				_:
					False
		InlineListStorage(left_width):
			match right.layout:
				InlineListStorage(right_width):
					left_width == right_width
				_:
					False
		InlineStructListStorage(left_type):
			match right.layout:
				InlineStructListStorage(right_type):
					left_type == right_type
				_:
					False


pure func canonical_empty_lists_add(
	existing: List[CanonicalEmptyList],
	item: CanonicalEmptyList,
) -> List[CanonicalEmptyList]:
	if existing.any(func(candidate): canonical_empty_list_keys_equal(candidate, item)):
		existing
	else:
		existing.append(item)


pure func canonical_empty_lists_sorted(items: List[CanonicalEmptyList]) -> List[CanonicalEmptyList]:
	items.sort_by(func(item): item.symbol_name)


pure func canonical_empty_list_symbol_names(items: List[CanonicalEmptyList]) -> List[String]:
	items.map(func(item): item.symbol_name)
