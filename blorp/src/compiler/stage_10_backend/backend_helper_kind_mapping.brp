--- Maps a `PreparedTupleOp` to the `BackendHelperKind` row describing it.
--- Every kind name is `Tuple` + the variant name (all seven variants; no
--- variant here carries a secondary flag).
pure func backend_helper_kind_of_prepared_tuple_renderer_op(op: PreparedTupleOp) -> BackendHelperKind:
	match op:
		TupleName(_):
			TupleTupleName
		TupleArg(_):
			TupleTupleArg
		TupleConstruct(_):
			TupleTupleConstruct
		TupleRetainElem(_):
			TupleTupleRetainElem
		TupleConstructWithRc(_):
			TupleTupleConstructWithRc
		TupleFieldElement(_):
			TupleTupleFieldElement
		TupleFieldAccess(_):
			TupleTupleFieldAccess


--- Maps a `PreparedListOp` to the `BackendHelperKind` row describing it.
--- Every kind name is `List` + the variant name (all fifty-two variants; no
--- variant here carries a secondary flag).
pure func backend_helper_kind_of_prepared_list_renderer_op(op: PreparedListOp) -> BackendHelperKind:
	match op:
		PointerGet(_, _):
			ListPointerGet
		InlineCheckedGet(_):
			ListInlineCheckedGet
		InlineProvenGet(_):
			ListInlineProvenGet
		InlineBitsLoad(_):
			ListInlineBitsLoad
		InlineBitsStore(_):
			ListInlineBitsStore
		PointerSetRawStore(_):
			ListPointerSetRawStore
		PointerHandoffSetOwnedStore(_):
			ListPointerHandoffSetOwnedStore
		InlineStructSetRawStore(_):
			ListInlineStructSetRawStore
		InlineStructHandoffSetOwnedStore(_):
			ListInlineStructHandoffSetOwnedStore
		PointerSwap(_):
			ListPointerSwap
		InlineBitsSwap(_):
			ListInlineBitsSwap
