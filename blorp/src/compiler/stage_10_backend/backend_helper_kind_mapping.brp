--- Maps a `PreparedBackendOp` to the `BackendHelperKind` row describing it.
--- Most kind names are the variant name unchanged (`Backend...` is already
--- the variant's own prefix). Nine variants carry a secondary flag that the
--- catalog split into two or three rows instead of a boolean field
--- (`backend_helper_catalog.brp`'s docstring); those are matched here too.
pure func backend_helper_kind_of_prepared_backend_renderer_op(op: PreparedBackendOp) -> BackendHelperKind:
	match op:
		BackendRenderer.BackendDictCtorGeneric:
			BackendDictCtorGeneric
		BackendRenderer.BackendDictCtorString:
			BackendDictCtorString
		BackendRenderer.BackendDictCtorFloat:
			BackendDictCtorFloat
		BackendDictCtorCustom(_, flag):
			match flag:
				NoElemRelease:
					BackendDictCtorCustomNoElemRelease
				ElemReleaseFn:
					BackendDictCtorCustomWithElemRelease
		BackendDictStackOptionValueRecordGet(_, policy):
			match policy:
				DictKeepKey:
					BackendDictStackOptionValueRecordGetKeepKey
				DictReleaseKey:
					BackendDictStackOptionValueRecordGetReleaseKey
		BackendDictStackOptionLongGet(_, policy):
			match policy:
				DictKeepKey:
					BackendDictStackOptionLongGetKeepKey
				DictReleaseKey:
					BackendDictStackOptionLongGetReleaseKey
		BackendDictStackOptionInt128Get(_, policy):
			match policy:
				DictKeepKey:
					BackendDictStackOptionInt128GetKeepKey
				DictReleaseKey:
					BackendDictStackOptionInt128GetReleaseKey
		BackendDictStackOptionUInt128Get(_, policy):
			match policy:
				DictKeepKey:
					BackendDictStackOptionUInt128GetKeepKey
				DictReleaseKey:
					BackendDictStackOptionUInt128GetReleaseKey
		BackendRenderer.BackendDictConstructEmpty(_):
			BackendDictConstructEmpty
		BackendRenderer.BackendDictValueReleaseInit(_):
			BackendDictValueReleaseInit
		BackendRenderer.BackendDictInsert(_):
			BackendDictInsert
		BackendRenderer.BackendDictIterSourceBinding(_):
			BackendDictIterSourceBinding
		BackendRenderer.BackendDictIterLoopOpen(_):
			BackendDictIterLoopOpen
		BackendRenderer.BackendDictIterHeader(_):
			BackendDictIterHeader
