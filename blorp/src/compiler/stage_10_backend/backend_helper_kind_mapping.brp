--- Maps an `Intrinsic` (one of the four arity-keyed enums used by
--- `intrinsic_renderer.brp`'s NoArg/OneArg/TwoArg/ThreeArg tables) to the
--- `BackendHelperKind` row describing it. Every kind name is `Intrinsic` +
--- the inner enum's variant name; arity plays no role in the kind name, only
--- in which of the four enums the variant is looked up in.
pure func backend_helper_kind_of_intrinsic_renderer_op(op: Intrinsic) -> BackendHelperKind:
	match op:
		NoArgs(no_arg):
			match no_arg:
				MathInfinity:
					IntrinsicMathInfinity
				MathNegInfinity:
					IntrinsicMathNegInfinity
				MathNan:
					IntrinsicMathNan
				IntrinsicRenderer.ElemReleaseFn:
					IntrinsicElemReleaseFn
		OneArg(one_arg):
			match one_arg:
				MathSin:
					IntrinsicMathSin
				MathCos:
					IntrinsicMathCos
				MathTan:
					IntrinsicMathTan
