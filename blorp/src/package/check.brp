-- Package validation through the production Blorp frontend.
--
-- A source package is not a weaker form of a normal module. The explicit
-- source-package origin makes builtin/foreign declarations unavailable and
-- constrains import resolution to std plus the package's own source tree.
-- Reusing the graph and typechecker here keeps those rules in their owning
-- phases instead of duplicating an AST policy walker in the package command.
import:
	../compiler/frontend_request:
		FrontendGraphContext,
		FrontendSourceImportEdge,
		FrontendSourcePackage,
	../compiler/stage_04_modules/package_inventory:
		PackageInventory,
		package_inventory_error_text,
		read_package_inventory,
	../lib/source_graph:
		CliSourceGraphSetup,
		frontend_module_graph_for_roots_with_setup,
		parse_cli_sources_with_setup,
	../lib/cli_plan: CliParsedSourceFile, CliSourceFile
	../lib/frontend_validation: validate_frontend_graph
	path: join, normalize
	system: read_file


private PACKAGE_SOURCE_EXTENSION: String = ".brp"


private pure func package_module_name(source_dir: String, source_path: String) -> String:
	relative_path: String = source_path.drop_left(source_dir.length() + 1)
	relative_path.take_left(relative_path.length() - PACKAGE_SOURCE_EXTENSION.length())


private func package_source_files(
	source_dir: String,
	source_files: List[String],
) -> Result[List[CliSourceFile], String]:
	var sources: List[CliSourceFile] = []
	var read_error: Option[String] = None

	for path in source_files:
		if read_error.is_none():
			match read_file(path):
				Err(detail):
					read_error = Some("failed to read package source `${path}`: ${detail}")
				Ok(source_text):
					sources = sources.append({
						path = normalize(path),
						module_name = package_module_name(source_dir, path),
						source_text = source_text,
					})

	match read_error:
		Some(error):
			Err(error)
		None:
			Ok(sources)


private pure func package_source_graph_setup(
	root: String,
	inventory: PackageInventory,
) -> CliSourceGraphSetup:
	normalized_root: String = normalize(root)
	package: FrontendSourcePackage = {
		package_alias = inventory.manifest.name,
		package_name = inventory.manifest.name,
		package_root = normalized_root,
		source_dir = join(normalized_root, "src"),
		exports = inventory.manifest.exports
	}
	context: FrontendGraphContext = {
		std_dir = None,
		source_packages = [package],
		package_roots = []
	}
	{
		context = context,
		diagnostics = []
	}


private pure func unresolved_package_import_errors(
	package_name: String,
	edges: List[FrontendSourceImportEdge],
) -> List[String]:
	edges.filter_map(func(edge):
		if edge.resolved_path.is_some():
			None
		else if edge.import_path.starts_with("./") or edge.import_path.starts_with("../"):
			Some(
				"${edge.from_path}: package relative import `${edge.import_path}` must resolve to a source file under src/",
			)
		else:
			Some(
				"${edge.from_path}: source packages may import only std modules or modules inside package `${package_name}`; found import `${edge.import_path}`",
			)
	)


func check_cli_package(root: String) -> Result[PackageInventory, List[String]]:
	inventory ?= read_package_inventory(root).map_err(func(errors):
		errors.map(package_inventory_error_text)
	)
	sources ?= package_source_files(
		join(root, "src"),
		inventory.source_files,
	).map_err(func(error): [error])
	setup: CliSourceGraphSetup = package_source_graph_setup(root, inventory)
	parsed_sources: List[CliParsedSourceFile] ?= parse_cli_sources_with_setup(
		setup,
		sources,
	).map_err(
		func(error): [error],
	)
	graph ?= frontend_module_graph_for_roots_with_setup(
		setup,
		parsed_sources,
	).map_err(
		func(error): [error],
	)

	var errors: List[String] = graph.diagnostics.concat(
		unresolved_package_import_errors(
			inventory.manifest.name,
			graph.import_edges,
		),
	)

	if errors.length() == 0:
		validation = validate_frontend_graph(
			graph,
			{
				allow_debug_only_calls = False,
				include_parsed_summary = False,
				include_typed_summary = False
			},
		)
		errors = errors.concat(validation.graph_diagnostics)

		for root_validation in validation.roots:
			errors = errors.concat(root_validation.errors)

	if errors.length() == 0:
		Ok(inventory)
	else:
		Err(errors)
