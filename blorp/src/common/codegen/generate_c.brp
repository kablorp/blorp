---
The whole pipeline from a parsed program to C: check, specialize, lower, own,
verify and emit.
---
import:
    result: Result methods
    ../analysis/assemble: ParsedProgram
    ../analysis/check/check: check
    ../analysis/check/render: render_failure
    ../syntax/syntax: Diagnostics, singleton_diagnostic
    ./emit/emit: emit
    ./lower/lower: lower
    ./own/own: own
    ./specialize/specialize: specialize
    ./verify/verify: verify


-- Source loading publishes complete syntax and identities. Every stage here is pure.
pure func generate_c(program: ParsedProgram) -> Result[String, Diagnostics]:
    checked ?= program
        .check()
        .map_err(render_failure)
    specialized ?= checked
        .specialize()
        .map_err(singleton_diagnostic)
    lowered ?= specialized
        .lower()
        .map_err(singleton_diagnostic)
    owned ?= lowered
        .own()
        .map_err(singleton_diagnostic)
    verified ?= owned
        .verify()
        .map_err(singleton_diagnostic)
    verified
        .emit()
        .map_err(singleton_diagnostic)
