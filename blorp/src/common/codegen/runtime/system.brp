import:
    ../../syntax/syntax:
        SystemOperation(
            CurrentDirectory,
            ProcessCapture,
            ProcessFindProgram,
            ProcessFault,
            FsReadText,
            FsWriteText,
            FsEntryKind,
            FsListDirectory,
            FsCreateDirectory,
            FsCreateDirectories,
            FsRemoveFile,
            FsRemoveDirectory,
            FsRename,
            FsRemoveDirectoryTree,
            FsCreateTemporaryDirectory,
            FsOpenRead,
            FsNextLines,
            FsClose,
        ),
    ./fs:
        FS_ENTRY_KIND_RUNTIME,
        FS_READ_TEXT_RUNTIME,
        FS_WRITE_TEXT_RUNTIME,
        fs_list_directory_runtime,
        FS_CREATE_DIRECTORY_RUNTIME,
        FS_CREATE_DIRECTORIES_RUNTIME,
        FS_REMOVE_FILE_RUNTIME,
        FS_REMOVE_DIRECTORY_RUNTIME,
        FS_RENAME_RUNTIME,
        FS_REMOVE_DIRECTORY_TREE_RUNTIME,
        FS_CREATE_TEMPORARY_DIRECTORY_RUNTIME,
        FS_OPEN_READ_RUNTIME,
        fs_next_lines_runtime,
        FS_CLOSE_RUNTIME,
    ./process: process_capture_runtime, PROCESS_FIND_PROGRAM_RUNTIME, PROCESS_FAULT_RUNTIME


-- The working directory, failing with an Int code of the shared fs protocol
-- (fs.brp), which io/_codes.brp decodes. A path the OS names but that is empty
-- or not absolute (Linux's "(unreachable)/...") is Unreachable; a path longer
-- than any String is OtherOs(EOVERFLOW).
SYSTEM_CURRENT_DIRECTORY_RUNTIME: String =
    raw
        |enum {BLORP_CURRENT_DIRECTORY_CODE_INITIAL_CAPACITY=256};
        |/* The limit is a parameter so that a test can reach it without a huge allocation. */
        |static uint8_t blorp_system_current_directory_within(struct blorp_string **directory,int64_t *error,size_t maximum_capacity){
        |size_t capacity=BLORP_CURRENT_DIRECTORY_CODE_INITIAL_CAPACITY;
        |char *buffer=blorp_memory_allocate(capacity);
        |if(buffer==NULL){abort();}
        |for(;;){
        |errno=0;
        |if(getcwd(buffer,capacity)!=NULL){
        |const size_t length=strlen(buffer);
        |const int usable=length>0&&buffer[0]=='/';
        |const int valid=usable&&blorp_utf8_is_valid(buffer,length);
        |if(valid){*directory=blorp_string_from_bytes(buffer,(int64_t)length);}
        |blorp_memory_release(buffer);
        |if(valid){return BLORP_FS_SUCCEEDED;}
        |*error=usable?BLORP_FS_INVALID_UTF8:BLORP_FS_UNREACHABLE;
        |return BLORP_FS_FAILED;
        |}
        |const int saved_errno=errno;
        |if(saved_errno!=ERANGE||capacity==maximum_capacity){
        |blorp_memory_release(buffer);
        |*error=saved_errno==ERANGE?blorp_fs_other_os_code(EOVERFLOW):blorp_fs_errno_code_within(saved_errno,BLORP_FS_CURRENT_DIRECTORY_KINDS);
        |return BLORP_FS_FAILED;
        |}
        |const size_t grown_capacity=capacity>maximum_capacity/2?maximum_capacity:capacity*2;
        |char *grown=blorp_memory_resize(buffer,grown_capacity);
        |if(grown==NULL){abort();}
        |buffer=grown;
        |capacity=grown_capacity;
        |}
        |}
        |uint8_t blorp_system_current_directory(struct blorp_string **directory,int64_t *error){
        |return blorp_system_current_directory_within(directory,error,blorp_string_maximum_capacity()+1);
        |}
        |


-- The C symbol each system operation calls. Its fragment defines it with the
-- emitter's one shape: borrowed arguments, then one out-parameter per non-Void
-- Result payload, success first, returning whether the call succeeded.
pure func system_symbol(operation: SystemOperation) -> String:
    match operation:
        CurrentDirectory: "blorp_system_current_directory"
        ProcessCapture: "blorp_process_capture"
        ProcessFindProgram: "blorp_process_find_program"
        ProcessFault: "blorp_process_fault"
        FsReadText: "blorp_fs_read_text"
        FsWriteText: "blorp_fs_write_text"
        FsEntryKind: "blorp_fs_entry_kind"
        FsListDirectory: "blorp_fs_list_directory"
        FsCreateDirectory: "blorp_fs_create_directory"
        FsCreateDirectories: "blorp_fs_create_directories"
        FsRemoveFile: "blorp_fs_remove_file"
        FsRemoveDirectory: "blorp_fs_remove_directory"
        FsRename: "blorp_fs_rename"
        FsRemoveDirectoryTree: "blorp_fs_remove_directory_tree"
        FsCreateTemporaryDirectory: "blorp_fs_create_temporary_directory"
        FsOpenRead: "blorp_fs_open_read"
        FsNextLines: "blorp_fs_next_lines"
        FsClose: "blorp_fs_close"


-- `fs_helpers` needs FS_HELPERS_RUNTIME, and `process_helpers` needs
-- PROCESS_HELPERS_RUNTIME after it.
record SystemRuntime {
    fragment: String,
    fs_helpers: Bool,
    process_helpers: Bool,
}


-- The emitter supplies the String-list C type from its existing typed key.
pure func system_runtime(operation: SystemOperation, string_list_type: String) -> SystemRuntime:
    match operation:
        CurrentDirectory:
            {
                fragment = SYSTEM_CURRENT_DIRECTORY_RUNTIME,
                fs_helpers = True,
                process_helpers = False,
            }
        ProcessCapture:
            {
                fragment = process_capture_runtime(string_list_type),
                fs_helpers = True,
                process_helpers = True,
            }
        ProcessFindProgram:
            { fragment = PROCESS_FIND_PROGRAM_RUNTIME, fs_helpers = True, process_helpers = True }
        ProcessFault:
            { fragment = PROCESS_FAULT_RUNTIME, fs_helpers = False, process_helpers = True }
        FsReadText:
            { fragment = FS_READ_TEXT_RUNTIME, fs_helpers = True, process_helpers = False }
        FsWriteText:
            { fragment = FS_WRITE_TEXT_RUNTIME, fs_helpers = True, process_helpers = False }
        FsEntryKind:
            { fragment = FS_ENTRY_KIND_RUNTIME, fs_helpers = True, process_helpers = False }
        FsListDirectory:
            {
                fragment = fs_list_directory_runtime(string_list_type),
                fs_helpers = True,
                process_helpers = False,
            }
        FsCreateDirectory:
            { fragment = FS_CREATE_DIRECTORY_RUNTIME, fs_helpers = True, process_helpers = False }
        FsCreateDirectories:
            { fragment = FS_CREATE_DIRECTORIES_RUNTIME, fs_helpers = True, process_helpers = False }
        FsRemoveFile:
            { fragment = FS_REMOVE_FILE_RUNTIME, fs_helpers = True, process_helpers = False }
        FsRemoveDirectory:
            { fragment = FS_REMOVE_DIRECTORY_RUNTIME, fs_helpers = True, process_helpers = False }
        FsRename:
            { fragment = FS_RENAME_RUNTIME, fs_helpers = True, process_helpers = False }
        FsRemoveDirectoryTree:
            {
                fragment = FS_REMOVE_DIRECTORY_TREE_RUNTIME,
                fs_helpers = True,
                process_helpers = False,
            }
        FsCreateTemporaryDirectory:
            {
                fragment = FS_CREATE_TEMPORARY_DIRECTORY_RUNTIME,
                fs_helpers = True,
                process_helpers = False,
            }
        FsOpenRead:
            { fragment = FS_OPEN_READ_RUNTIME, fs_helpers = True, process_helpers = False }
        FsNextLines:
            {
                fragment = fs_next_lines_runtime(string_list_type),
                fs_helpers = True,
                process_helpers = False,
            }
        FsClose:
            { fragment = FS_CLOSE_RUNTIME, fs_helpers = True, process_helpers = False }
