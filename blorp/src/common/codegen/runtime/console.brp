-- The C half of the console natives (standard_library/io/console/ calls them
-- by label). Every operation reports a failure as an Int code of the shared
-- native error protocol: the kind's positive code when BLORP_CONSOLE_KINDS names
-- it, else the errno negated (fs.brp, io/_errors.brp).


import:
    ../../utils/text: concat
    ./list: list_root_allocation


-- Emitted once, however many console operations a program calls. process.run
-- and process.exit_interrupted flush through blorp_console_flush_stream too, so
-- they select this fragment. Not every program calls both stream helpers, and an
-- unused static function would warn under -Werror, so they have external
-- linkage, as fs's partly used helpers do.
CONSOLE_HELPERS_RUNTIME: String =
    raw
        |/* The one kind a console error names is IsADirectory (EISDIR from a directory on stdin). */
        |enum {BLORP_CONSOLE_KINDS=BLORP_FS_KIND(IS_A_DIRECTORY)};
        |/* The code of an errno, or of EIO when a stdio failure left none. */
        |int64_t blorp_console_error(int number){
        |return blorp_fs_errno_code_within(number!=0?number:EIO,BLORP_CONSOLE_KINDS);
        |}
        |/* print shares standard output's buffer, so their order holds. Every console
        | * operation, and process.run and exit_interrupted, which flush stdout, arm, once,
        | * an exit handler that closes stdout under the guard. exit_interrupted needs it only
        | * when SIGINT is blocked and it returns, for the caller to exit 130.
        | * Without it, stdio's own flush at exit would write to a closed pipe unguarded and
        | * the program would die of SIGPIPE instead of exiting with its status: a failed
        | * fflush keeps the buffer, so stdio's flush would retry. fclose flushes once under
        | * the guard and removes the stream, leaving nothing for stdio. It flushes what print
        | * buffered too, or drops it when the reader has gone. No other atexit handler
        | * exists, so nothing runs after this one and writes stdout; keep it that way. It
        | * allocates nothing, and the leak check, which runs inside main, has finished. */
        |static pthread_once_t blorp_console_exit_once=PTHREAD_ONCE_INIT;
        |static void blorp_console_close_stdout(void){
        |struct blorp_pipe_guard guard;
        |if(blorp_block_sigpipe(&guard)!=0){return;}
        |errno=0;
        |const int failed=fclose(stdout)!=0;
        |blorp_restore_sigpipe(&guard,failed&&errno==EPIPE);
        |}
        |static void blorp_console_register_exit(void){(void)atexit(blorp_console_close_stdout);}
        |/* No retry on EINTR here: Blorp installs no catching signal handler, so a write or
        | * flush sees it only under a handler installed elsewhere without SA_RESTART, and then
        | * reports EINTR as its error. Some bytes may already be out when a write reports any
        | * error. The reads retry, because a retried read cannot duplicate anything. */
        |/* Sends the stream's buffer under the SIGPIPE guard, so a reader that has gone
        | * yields EPIPE and not the end of the program. Returns 0 or the errno. */
        |int blorp_console_flush_stream(FILE *stream){
        |(void)pthread_once(&blorp_console_exit_once,blorp_console_register_exit);
        |struct blorp_pipe_guard guard;
        |const int blocked=blorp_block_sigpipe(&guard);
        |if(blocked!=0){return blocked;}
        |clearerr(stream);
        |errno=0;
        |const int number=fflush(stream)==0?0:(errno!=0?errno:EIO);
        |blorp_restore_sigpipe(&guard,number==EPIPE);
        |return number;
        |}
        |/* The bytes through the stream's stdio buffer, under the same guard. A buffered
        | * stream reports a closed reader only when the buffer fills or is flushed. */
        |int blorp_console_write_stream(FILE *stream,const void *bytes,size_t length){
        |(void)pthread_once(&blorp_console_exit_once,blorp_console_register_exit);
        |struct blorp_pipe_guard guard;
        |const int blocked=blorp_block_sigpipe(&guard);
        |if(blocked!=0){return blocked;}
        |clearerr(stream);
        |errno=0;
        |const int number=fwrite(bytes,1,length,stream)==length?0:(errno!=0?errno:EIO);
        |blorp_restore_sigpipe(&guard,number==EPIPE);
        |return number;
        |}
        |


-- Writes through the stdio buffer that print shares.
pure func console_write_runtime(byte_list_type: String) -> String:
    |uint8_t blorp_console_write(${byte_list_type} data,int64_t *error){
    |const int number=blorp_console_write_stream(stdout,data->values,(size_t)data->length);
    |if(number!=0){*error=blorp_console_error(number);return BLORP_FS_FAILED;}
    |return BLORP_FS_SUCCEEDED;
    |}
    |


-- Standard error is unbuffered, so its write reports a closed reader at once.
pure func console_write_error_runtime(byte_list_type: String) -> String:
    |uint8_t blorp_console_write_error(${byte_list_type} data,int64_t *error){
    |const int number=blorp_console_write_stream(stderr,data->values,(size_t)data->length);
    |if(number!=0){*error=blorp_console_error(number);return BLORP_FS_FAILED;}
    |return BLORP_FS_SUCCEEDED;
    |}
    |


CONSOLE_FLUSH_RUNTIME: String =
    raw
        |uint8_t blorp_console_flush(int64_t *error){
        |const int number=blorp_console_flush_stream(stdout);
        |if(number!=0){*error=blorp_console_error(number);return BLORP_FS_FAILED;}
        |return BLORP_FS_SUCCEEDED;
        |}
        |


-- Standard input as the runtime owns it (CONCURRENCY_PLAN.md, "Cancelling
-- natives"). Only the two reads select it, so a program that only writes has
-- none of it, and both call every function here, so they are static. It comes
-- after CONSOLE_HELPERS_RUNTIME, whose error codes it reports.
CONSOLE_INPUT_RUNTIME: String =
    raw
        |
        |#include <poll.h>
        |#include <pthread.h>
        |#include <stdlib.h>
        |#include <string.h>
        |#include <unistd.h>
        |/* A read holds the line lock from start to end, so two reads never interleave. `pending` holds bytes read from
        |   descriptor 0 that no read has taken: the rest of a chunk after a line, or a cancelled read's partial input.
        |   Descriptor 0 is read only into an empty `pending`, so a cancelled read's bytes go back in front of nothing and
        |   keep their order. The buffer is malloc'd, as the pool's helpers are, and lives until exit: it belongs to the
        |   runtime, not to any program value, so the leak check does not count it. */
        |enum {BLORP_CONSOLE_INPUT_STEP=1<<16};
        |static struct {
        |    pthread_mutex_t line;
        |    uint8_t *pending;
        |    size_t start,length,capacity;
        |} blorp_console_input={PTHREAD_MUTEX_INITIALIZER,NULL,0,0,0};
        |static void blorp_console_broken(const char *rule){
        |fprintf(stderr,"error: console invariant broken: %s\n",rule);
        |abort();
        |}
        |/* Held for a whole read. An in-place read, with no kernel running, may wait for it. A cancellable read never may:
        |   landing 5's kernel admits one console reader at a time, through a wait a cancel ends, and a read that waited
        |   here could not see its cancel until the one ahead of it finished. */
        |static void blorp_console_lock_line(int cancel){
        |const int code=cancel<0?pthread_mutex_lock(&blorp_console_input.line):pthread_mutex_trylock(&blorp_console_input.line);
        |if(code==EBUSY)blorp_console_broken("a cancellable console read found the line lock held: the kernel admits one console reader at a time");
        |if(code!=0)blorp_console_broken("the console's line lock failed");
        |}
        |static void blorp_console_unlock_line(void){
        |(void)pthread_mutex_unlock(&blorp_console_input.line);
        |}
        |/* Makes the empty `pending` hold at least `count` bytes, and at least one step, so a read(2) never asks for less. */
        |static void blorp_console_reserve(size_t count){
        |if(blorp_console_input.capacity>=count)return;
        |const size_t capacity=count<BLORP_CONSOLE_INPUT_STEP?BLORP_CONSOLE_INPUT_STEP:count;
        |free(blorp_console_input.pending);
        |blorp_console_input.pending=malloc(capacity);
        |if(blorp_console_input.pending==NULL){
        |fprintf(stderr,"error: cannot buffer standard input: malloc failed: %s\n",strerror(ENOMEM));
        |abort();
        |}
        |blorp_console_input.capacity=capacity;
        |}
        |/* Moves the first `count` bytes of `pending`, which holds at least that many, to `into`. */
        |static void blorp_console_take(uint8_t *into,size_t count){
        |memcpy(into,blorp_console_input.pending+blorp_console_input.start,count);
        |blorp_console_input.start+=count;
        |blorp_console_input.length-=count;
        |}
        |/* A cancelled read's bytes, back into `pending`. It is empty, since a read waits only once it has taken all of it. */
        |static void blorp_console_give_back(const uint8_t *bytes,size_t count){
        |blorp_console_reserve(count);
        |if(count>0)memcpy(blorp_console_input.pending,bytes,count);
        |blorp_console_input.start=0;
        |blorp_console_input.length=count;
        |}
        |enum blorp_console_refill_result {
        |    BLORP_CONSOLE_REFILLED,   /* `pending` holds what one read(2) gave */
        |    BLORP_CONSOLE_ENDED,      /* the end of input, which is not sticky: a terminal's ^D, then more input, is read */
        |    BLORP_CONSOLE_CANCELLED,
        |    BLORP_CONSOLE_FAILED      /* the error's code is in *error */
        |};
        |/* Refills the empty `pending` with one read(2) of descriptor 0, once poll says the read will not block: bytes, the
        |   end of input or an error, which the read then reports. Once a read needs the descriptor, a cancel wins, even when
        |   input arrives with it. A negative `cancel` is an in-place call, which poll ignores. Polling, not O_NONBLOCK,
        |   leaves the open file description the parent shares untouched. Any event on descriptor 0 goes to the read,
        |   POLLNVAL included, which macOS reports for a directory, /dev/null and /dev/tty.
        |   A signal retries. So does EAGAIN, from a description the parent made O_NONBLOCK, but only when poll said the
        |   descriptor was ready, POLLIN or POLLHUP, so another reader drained it after the poll. Without that, poll cannot
        |   wait on the descriptor, as for macOS's /dev/tty, and a retry would spin, so EAGAIN is reported, as stdio's read
        |   reported it. */
        |static enum blorp_console_refill_result blorp_console_refill(int cancel,int64_t *error){
        |for(;;){
        |struct pollfd waits[2]={{STDIN_FILENO,POLLIN,0},{cancel,POLLIN,0}};
        |if(poll(waits,2,-1)<0){
        |if(errno==EINTR)continue;
        |waits[0].revents=waits[1].revents=0; /* the read then reports what is wrong, or blocks without its cancel */
        |}
        |if(waits[1].revents!=0)return BLORP_CONSOLE_CANCELLED;
        |blorp_console_reserve(1);
        |const ssize_t received=read(STDIN_FILENO,blorp_console_input.pending,blorp_console_input.capacity);
        |if(received>0){
        |blorp_console_input.start=0;
        |blorp_console_input.length=(size_t)received;
        |return BLORP_CONSOLE_REFILLED;
        |}
        |if(received==0)return BLORP_CONSOLE_ENDED;
        |const int drained=(errno==EAGAIN||errno==EWOULDBLOCK)&&(waits[0].revents&(POLLIN|POLLHUP))!=0;
        |if(errno!=EINTR&&!drained){
        |*error=blorp_console_error(errno);
        |return BLORP_CONSOLE_FAILED;
        |}
        |}
        |}
        |


-- Both reads take standard input through CONSOLE_INPUT_RUNTIME's one buffer,
-- so a line read then an exact read continue where the other stopped. Each
-- flushes stdout first, so a prompt shows before the program waits; that
-- failure is the next write's to report. An error after some bytes drops them:
-- the Result has room for one or the other. A blocking job runs each read's
-- cancellable body with its helper's cancel descriptor (console_jobs_runtime),
-- and the native calls it in place with -1.
--
-- The line includes its LF. Any line takes at least that, so an empty result is
-- end of input and "\n" stays distinct from it.
pure func console_read_line_runtime(byte_list_type: String) -> String:
    |enum {BLORP_CONSOLE_LINE_CAPACITY=64};
    |/* A line with its LF, the last bytes before the end of input, or nothing once input has ended or `cancel` became
    |   readable. A cancelled read gives back what it took, for the next reader. */
    |uint8_t blorp_console_read_line_cancellable(${byte_list_type} *line,int64_t *error,int cancel){
    |/* The flush is unbounded, and no cancel reaches it: to a full pipe, it waits until the reader drains it. */
    |(void)blorp_console_flush_stream(stdout);
    |blorp_console_lock_line(cancel);
    |${list_root_allocation(byte_list_type, "result", "BLORP_CONSOLE_LINE_CAPACITY")}
    |enum blorp_console_refill_result refill=BLORP_CONSOLE_REFILLED;
    |for(;;){
    |if(blorp_console_input.length==0){
    |refill=blorp_console_refill(cancel,error);
    |if(refill==BLORP_CONSOLE_REFILLED){continue;}
    |break;
    |}
    |/* Grown only once another byte is known, as stdio's read grew it, so a line ends with the same capacity. */
    |if(result->length==(int64_t)result->capacity){
    |const size_t grown_capacity=result->capacity*2;
    |${byte_list_type} grown=blorp_memory_resize(result,sizeof *result+grown_capacity*sizeof *result->values);
    |if(grown==NULL){abort();}
    |result=grown;
    |result->capacity=grown_capacity;
    |}
    |/* Through the first LF of what `pending` holds and the line has room for. */
    |const uint8_t *const from=blorp_console_input.pending+blorp_console_input.start;
    |const size_t room=result->capacity-(size_t)result->length;
    |const size_t most=room<blorp_console_input.length?room:blorp_console_input.length;
    |const uint8_t *const feed=memchr(from,'\n',most);
    |const size_t taken=feed==NULL?most:(size_t)(feed-from)+1;
    |blorp_console_take(result->values+result->length,taken);
    |result->length+=(int64_t)taken;
    |if(feed!=NULL){break;}
    |}
    |if(refill==BLORP_CONSOLE_CANCELLED){blorp_console_give_back(result->values,(size_t)result->length);result->length=0;}
    |blorp_console_unlock_line();
    |if(refill==BLORP_CONSOLE_FAILED){blorp_memory_release(result);return BLORP_FS_FAILED;}
    |*line=result;
    |return BLORP_FS_SUCCEEDED;
    |}
    |uint8_t blorp_console_read_line(${byte_list_type} *line,int64_t *error){
    |return blorp_console_read_line_cancellable(line,error,-1);
    |}
    |


-- Up to `count` bytes, fewer only at end of input. The result grows in steps as
-- bytes arrive and never reserves `count`, so a huge count costs the input
-- received. A count of zero or less reads, and flushes, nothing.
pure func console_read_exact_runtime(byte_list_type: String) -> String:
    |enum {BLORP_CONSOLE_READ_STEP=1<<16};
    |/* `count` bytes, fewer at the end of input, or nothing once `cancel` became readable. A cancelled read gives back
    |   what it took, for the next reader. */
    |uint8_t blorp_console_read_exact_cancellable(int64_t count,${byte_list_type} *bytes,int64_t *error,int cancel){
    |const size_t first=count<=0?0:(count<BLORP_CONSOLE_READ_STEP?(size_t)count:(size_t)BLORP_CONSOLE_READ_STEP);
    |${list_root_allocation(byte_list_type, "result", "first")}
    |if(count<=0){*bytes=result;return BLORP_FS_SUCCEEDED;}
    |/* The flush is unbounded, and no cancel reaches it: to a full pipe, it waits until the reader drains it. */
    |(void)blorp_console_flush_stream(stdout);
    |blorp_console_lock_line(cancel);
    |uint64_t remaining=(uint64_t)count;
    |enum blorp_console_refill_result refill=BLORP_CONSOLE_REFILLED;
    |while(remaining>0){
    |/* Grown once full, before the next byte is known, as stdio's read grew it, so capacities are the same. */
    |if(result->length==(int64_t)result->capacity){
    |const size_t addition=remaining<result->capacity?(size_t)remaining:result->capacity;
    |const size_t grown_capacity=result->capacity+addition;
    |${byte_list_type} grown=blorp_memory_resize(result,sizeof *result+grown_capacity*sizeof *result->values);
    |if(grown==NULL){abort();}
    |result=grown;
    |result->capacity=grown_capacity;
    |}
    |if(blorp_console_input.length==0){
    |refill=blorp_console_refill(cancel,error);
    |if(refill==BLORP_CONSOLE_REFILLED){continue;}
    |break;
    |}
    |/* The capacity never passes `count`, so the room is at most what remains. */
    |size_t taken=result->capacity-(size_t)result->length;
    |if(taken>blorp_console_input.length){taken=blorp_console_input.length;}
    |blorp_console_take(result->values+result->length,taken);
    |result->length+=(int64_t)taken;
    |remaining-=taken;
    |}
    |if(refill==BLORP_CONSOLE_CANCELLED){blorp_console_give_back(result->values,(size_t)result->length);result->length=0;}
    |blorp_console_unlock_line();
    |if(refill==BLORP_CONSOLE_FAILED){blorp_memory_release(result);return BLORP_FS_FAILED;}
    |*bytes=result;
    |return BLORP_FS_SUCCEEDED;
    |}
    |uint8_t blorp_console_read_exact(int64_t count,${byte_list_type} *bytes,int64_t *error){
    |return blorp_console_read_exact_cancellable(count,bytes,error,-1);
    |}
    |


-- The seven console natives as blocking jobs (runtime/blocking.brp), print and
-- print_error included. The reads are cancellable; the writes, the flush and
-- the prints are unbounded, since a write to a full pipe can block without
-- bound. It comes after BLOCKING_RUNTIME, the console fragments,
-- CONSOLE_INPUT_RUNTIME and both prints. Nothing emits it yet: landing 5 is its
-- first user. The initializers are external, as BLOCKING_RUNTIME's functions
-- are, so nothing warns as unused.
pure func console_jobs_runtime(byte_list_type: String) -> String:
    |/* A console native's call as a blocking job. The waiting fiber owns it, usually in its frame, and fills the waiter
    |   and the generation before it submits it. Its arguments are borrowed from the fiber, whose frame outlives the wait.
    |   Its run writes the results, which the waiter reads once its wait ends. Each initializer zeroes the job, so it is
    |   unsubmitted, and gives it its run, its kind and its arguments. The job comes first in each, so the pool's pointer
    |   is the call's. */
    |struct blorp_console_read_line_job {
    |    struct blorp_blocking_job job;
    |    ${byte_list_type} line;
    |    int64_t error;
    |    uint8_t succeeded;
    |};
    |static void blorp_console_read_line_run(struct blorp_blocking_job *job,int cancel){
    |struct blorp_console_read_line_job *const call=(struct blorp_console_read_line_job *)job;
    |call->succeeded=blorp_console_read_line_cancellable(&call->line,&call->error,cancel);
    |}
    |void blorp_console_read_line_job_init(struct blorp_console_read_line_job *call){
    |*call=(struct blorp_console_read_line_job){.job={.run=blorp_console_read_line_run,.kind=BLORP_JOB_CANCELLABLE}};
    |}
    |struct blorp_console_read_exact_job {
    |    struct blorp_blocking_job job;
    |    int64_t count;
    |    ${byte_list_type} bytes;
    |    int64_t error;
    |    uint8_t succeeded;
    |};
    |static void blorp_console_read_exact_run(struct blorp_blocking_job *job,int cancel){
    |struct blorp_console_read_exact_job *const call=(struct blorp_console_read_exact_job *)job;
    |call->succeeded=blorp_console_read_exact_cancellable(call->count,&call->bytes,&call->error,cancel);
    |}
    |void blorp_console_read_exact_job_init(struct blorp_console_read_exact_job *call,int64_t count){
    |*call=(struct blorp_console_read_exact_job){.job={.run=blorp_console_read_exact_run,.kind=BLORP_JOB_CANCELLABLE},.count=count};
    |}
    |/* write's and write_error's. */
    |struct blorp_console_write_job {
    |    struct blorp_blocking_job job;
    |    ${byte_list_type} data;
    |    int64_t error;
    |    uint8_t succeeded;
    |};
    |static void blorp_console_write_run(struct blorp_blocking_job *job,int cancel){
    |(void)cancel;
    |struct blorp_console_write_job *const call=(struct blorp_console_write_job *)job;
    |call->succeeded=blorp_console_write(call->data,&call->error);
    |}
    |static void blorp_console_write_error_run(struct blorp_blocking_job *job,int cancel){
    |(void)cancel;
    |struct blorp_console_write_job *const call=(struct blorp_console_write_job *)job;
    |call->succeeded=blorp_console_write_error(call->data,&call->error);
    |}
    |void blorp_console_write_job_init(struct blorp_console_write_job *call,${byte_list_type} data){
    |*call=(struct blorp_console_write_job){.job={.run=blorp_console_write_run,.kind=BLORP_JOB_UNBOUNDED},.data=data};
    |}
    |void blorp_console_write_error_job_init(struct blorp_console_write_job *call,${byte_list_type} data){
    |*call=(struct blorp_console_write_job){.job={.run=blorp_console_write_error_run,.kind=BLORP_JOB_UNBOUNDED},.data=data};
    |}
    |struct blorp_console_flush_job {
    |    struct blorp_blocking_job job;
    |    int64_t error;
    |    uint8_t succeeded;
    |};
    |static void blorp_console_flush_run(struct blorp_blocking_job *job,int cancel){
    |(void)cancel;
    |struct blorp_console_flush_job *const call=(struct blorp_console_flush_job *)job;
    |call->succeeded=blorp_console_flush(&call->error);
    |}
    |void blorp_console_flush_job_init(struct blorp_console_flush_job *call){
    |*call=(struct blorp_console_flush_job){.job={.run=blorp_console_flush_run,.kind=BLORP_JOB_UNBOUNDED}};
    |}
    |/* print's and print_error's, which return nothing. */
    |struct blorp_string_print_job {
    |    struct blorp_blocking_job job;
    |    const struct blorp_string *text;
    |};
    |static void blorp_string_print_run(struct blorp_blocking_job *job,int cancel){
    |(void)cancel;
    |(void)blorp_string_print(((struct blorp_string_print_job *)job)->text);
    |}
    |static void blorp_string_print_error_run(struct blorp_blocking_job *job,int cancel){
    |(void)cancel;
    |(void)blorp_string_print_error(((struct blorp_string_print_job *)job)->text);
    |}
    |void blorp_string_print_job_init(struct blorp_string_print_job *call,const struct blorp_string *text){
    |*call=(struct blorp_string_print_job){.job={.run=blorp_string_print_run,.kind=BLORP_JOB_UNBOUNDED},.text=text};
    |}
    |void blorp_string_print_error_job_init(struct blorp_string_print_job *call,const struct blorp_string *text){
    |*call=(struct blorp_string_print_job){.job={.run=blorp_string_print_error_run,.kind=BLORP_JOB_UNBOUNDED},.text=text};
    |}
    |
