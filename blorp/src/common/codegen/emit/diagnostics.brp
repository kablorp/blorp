import:
    ../../syntax/syntax: Diagnostic, Span, internal_error
    ../lower/lower: ValueId
    ../own/own: OwnerId
    ../specialize/specialize: RecordInstanceId, UnionInstanceId


-- The verified aggregate order holds catalogue indices, not issued identities.
fixed union AggregateKind:
    RecordAggregate
    UnionAggregate


fixed union EmissionFailure:
    MissingUnionLayout(UnionInstanceId)
    MissingRecordLayout(RecordInstanceId)
    MissingOwnerType(OwnerId)
    MissingValueType(ValueId)
    MissingRuntimeArgument(ValueId, Int)
    -- The callable entry's instance number.
    MissingFunctionRow(Int)
    MissingJoinTransfer(ValueId)
    MissingSelectionArm(ValueId)
    MissingEnclosingLoop(ValueId)
    StatementOnlyValue(ValueId)
    InvalidOperationShape(ValueId)
    MissingAggregateLayout(AggregateKind, Int)
    MissingInPlaceHelper(ValueId)
    -- The task's instance number: an instance identity is not plain data.
    MissingJoinedTask(Int)
    -- A parallel map's direct callback, by its instance number, whose row is
    -- missing or takes more than its environment and an element.
    InvalidMapCallback(Int)
    -- A constant, by its instance number, whose value does not fit its type
    -- or that has no value in the program's table.
    ConstantValueMismatch(Int)
    -- A callable entry, by its instance number, whose type is not callable.
    NonCallableEntry(Int)


private pure func aggregate_name(kind: AggregateKind) -> String:
    match kind:
        RecordAggregate: "record"
        UnionAggregate: "union"


pure func render(span: Span, failure: EmissionFailure) -> Diagnostic:
    message = match failure:
        MissingUnionLayout(id):
            "missing emitted union layout #".append_int(id.union_number())
        MissingRecordLayout(id):
            "missing emitted record layout #".append_int(id.record_number())
        MissingOwnerType(id):
            "missing emitted owner type #".append_int(id.owner_number())
        MissingValueType(id):
            "missing emitted value type #".append_int(id.value_number())
        MissingRuntimeArgument(id, argument):
            "missing runtime argument #${argument} for value #${id.value_number()}"
        MissingFunctionRow(number):
            "missing function row for callable entry #".append_int(number)
        MissingJoinTransfer(id):
            "missing verified join transfer for value #".append_int(id.value_number())
        MissingSelectionArm(id):
            "missing selection arm for join value #".append_int(id.value_number())
        MissingEnclosingLoop(id):
            "missing enclosing loop for transfer to value #".append_int(id.value_number())
        StatementOnlyValue(id):
            "value #${id.value_number()} requires statement emission"
        InvalidOperationShape(id):
            "value #${id.value_number()} has an operation of the wrong shape here"
        MissingAggregateLayout(kind, index):
            "missing ${kind.aggregate_name()} aggregate layout #${index}"
        MissingInPlaceHelper(id):
            "value #${id.value_number()} consumes an operand with no in-place helper"
        MissingJoinedTask(number):
            "missing function row for joined task #".append_int(number)
        InvalidMapCallback(number):
            "no parallel map callback row for function #".append_int(number)
        ConstantValueMismatch(number):
            "constant #${number} has no value of its type"
        NonCallableEntry(number):
            "callable entry for function #${number} has no callable type"

    internal_error(span, message)
