private pure func append_parameter_name(output: String, index: Int) -> String:
    output
        .concat("blorp_p_")
        .append_int(index)


private pure func c_name(index: Int) -> String:
    "blorp_f_".append_int(index)


-- The `append_*` name writers below add a C identifier to `output` in place.
-- Returning the name as a String would allocate one fragment per reference.
-- A fragment that must be a String starts from `""`, as in `"".append_local_name(id)`.
private pure func append_local_name(output: String, id: ValueId) -> String:
    output
        .concat("blorp_vl_")
        .append_int(id.value_number())


private pure func c_header(id: ValueId) -> String:
    "blorp_h_".append_int(id.value_number())


private pure func c_loop_header(target: lower.LoopTarget) -> String:
    "blorp_loop_${target.loop_target_value().value_number()}_header"


private pure func c_loop_break(target: lower.LoopTarget) -> String:
    "blorp_loop_${target.loop_target_value().value_number()}_break"


private pure func append_loop_transfer_name(
    output: String,
    target: lower.LoopTarget,
    position: Int
) -> String:
    output
        .concat("blorp_loop_")
        .append_int(
            target
                .loop_target_value()
                .value_number()
        )
        .concat("_transfer_")
        .append_int(position)


private pure func append_owner_name(output: String, id: OwnerId) -> String:
    output
        .concat("blorp_owner_")
        .append_int(id.owner_number())


-- Designated-Bool operations and system calls use statement dispatch and
-- constructor publication, not the ordinary expression-callable symbol path.
private pure func c_callable(target: CallTarget) -> Option[String]:
    match target:
        JoinTasks(_):
            None
        MapElements(callback):
            Some(
                ""
                    .append_map_job_name(callback)
                    .concat("_run")
            )
        UserFunction(id):
            Some(
                id
                    .function_number()
                    .c_name()
            )
        RuntimeFunction(operation):
            match operation:
                StringPrint:
                    Some("blorp_string_print")
                StringPrintError:
                    Some("blorp_string_print_error")
                IntegerAdd(Int64Format):
                    Some("blorp_int_add")
                IntegerSubtract(Int64Format):
                    Some("blorp_int_subtract")
                IntegerMultiply(Int64Format):
                    Some("blorp_int_multiply")
                IntegerDivide(Int64Format):
                    Some("blorp_int_divide")
                IntegerRemainder(Int64Format):
                    Some("blorp_int_remainder")
                IntegerAdd(UInt8Format):
                    Some("blorp_uint8_add")
                IntegerSubtract(UInt8Format):
                    Some("blorp_uint8_subtract")
                IntegerMultiply(UInt8Format):
                    Some("blorp_uint8_multiply")
                IntegerDivide(UInt8Format):
                    Some("blorp_uint8_divide")
                IntegerRemainder(UInt8Format):
                    Some("blorp_uint8_remainder")
                -- C converts a narrower argument to int64_t exactly.
                IntegerToString(Int64Format) | IntegerToString(UInt8Format):
                    Some("blorp_int_to_string")
                FloatAdd:
                    Some("blorp_float_add")
                FloatSubtract:
                    Some("blorp_float_subtract")
                FloatMultiply:
                    Some("blorp_float_multiply")
                FloatDivide:
                    Some("blorp_float_divide")
                FloatRemainder:
                    Some("blorp_float_remainder")
                FloatToString:
                    Some("blorp_float_to_string")
                FloatCopySign:
                    Some("copysign")
                FloatUnary(function):
                    Some(function.float_unary_c_function())
                FloatBinary(function):
                    Some(function.float_binary_c_function())
                FloatToInt:
                    Some("blorp_float_to_int")
                IntToFloat:
                    Some("blorp_int_to_float")
                IntegerBitwise(bitwise):
                    Some(bitwise.bitwise_c_function())
                StringLength | StringByteLength:
                    Some("blorp_string_byte_length")
                StringCodepointLength:
                    Some("blorp_string_codepoint_length")
                StringCodepointSlice:
                    Some("blorp_string_codepoint_slice")
                StringConcat:
                    Some("blorp_string_concat")
                StringAppendInt:
                    Some("blorp_string_append_int")
                StringParseInt(_):
                    Some("blorp_string_parse_int")
                StringParseFloat(_):
                    Some("blorp_string_parse_float")
                StringByteAtUInt8(_):
                    Some("blorp_string_byte_at_uint8")
                StringFromCodepoint(_):
                    Some("blorp_string_from_codepoint")
                StringSlice(_):
                    Some("blorp_string_byte_slice")
                StringToBytes:
                    Some("blorp_string_to_bytes")
                ListRepeat(element):
                    Some("blorp_list_repeat_${element.list_element_key().list_suffix()}")
                ListLength(element):
                    Some("blorp_list_length_${element.list_element_key().list_suffix()}")
                ListGet(element, _):
                    Some("blorp_list_get_${element.list_element_key().list_suffix()}")
                ListAppend(element):
                    Some(AppendUpdate.list_update_name(element.list_element_key()))
                ListSet(element):
                    Some(SetUpdate.list_update_name(element.list_element_key()))
                ListConcat(element):
                    Some(ConcatUpdate.list_update_name(element.list_element_key()))
                -- append_operation writes a conversion as a C cast.
                StringEquals(_) | IntegerEquals(_, _) | IntegerLessThan(_, _) | IntegerConvert(_, _) | FloatEquals(_) | FloatLessThan(_) | BytesToText(_) | StringByteSlice(_) | StringCodepointAt(_) | SystemCall(_, _) | ConcurrencyJoin(_) | ConcurrencyParallelMap(_):
                    None


private pure func append_integer(output: String, value: Int) -> String:
    if value == INT_MIN:
        "${output}INT64_MIN"
    else if value < 0:
        "${output}(-INT64_C(${(0 - value)}))"
    else:
        "${output}INT64_C(${value})"


-- A String literal is a function-local writable static String at the literal
-- base (BLORP_STATIC_STRING in runtime/string.brp), whose bytes are an
-- initializer list: C limits a string token's length, not a list's. A read is
-- its address. Its name is its value's: an identity belongs to one function.
private pure func c_literal_name(id: ValueId) -> String:
    "blorp_literal_".append_int(id.value_number())


-- RFC 3629: a UTF-8 continuation byte is 10xxxxxx, 128 up to but excluding 192.
-- Every other byte starts a code point.
private CONTINUATION_BYTE_FIRST: Int = 128
private CONTINUATION_BYTE_END: Int = 192


private pure func code_point_count(bytes: String) -> Int:
    var count = 0
    var position = 0

    while True:
        match bytes.byte_at(position):
            Some(byte):
                number = byte.to_int()

                if (number < CONTINUATION_BYTE_FIRST).or(number >= CONTINUATION_BYTE_END):
                    count = count + 1

                position = position + 1
            None:
                break

    count


private pure func append_static_string(output: String, name: String, bytes: String) -> String:
    output
        .concat("BLORP_STATIC_STRING(")
        .concat(name)
        .concat(",")
        .append_int(bytes.length())
        .concat(",")
        .append_int(bytes.code_point_count())
        .concat(",{")
        .append_byte_list(bytes)
        .concat("});")


-- The bytes as C integers. ISO C forbids an empty initializer, so an empty
-- String is `0`, and its logical length remains zero.
private pure func append_byte_list(output: String, bytes: String) -> String:
    var projected = output
    var position = 0

    while True:
        match bytes.byte_at(position):
            Some(byte):
                if position > 0:
                    projected = "${projected},"

                projected = projected.append_int(byte.to_int())
                position = position + 1
            None:
                break

    if position == 0:
        projected = "${projected}0"

    projected


private pure func append_byte_array(output: String, name: String, bytes: String) -> String:
    "${output}static const unsigned char ${name}[]={"
        .append_byte_list(bytes)
        .concat("};")


private pure func has_payload(declaration: ConcreteUnion) -> Bool:
    declaration
        .union_variants()
        .any(
            pure func(fields): fields
                .is_empty()
                .not()
        )


private pure func append_boxed_union_struct(output: String, index: Int) -> String:
    output
        .concat("struct blorp_u_")
        .append_int(index)


private pure func union_is_boxed(layout: ConcreteUnion) -> Bool:
    match layout:
        BoxedCases(_): True
        PlainCases(_) | OwningCases(_): False


-- A boxed union value is a pointer to its counted node.
private pure func append_union_type_name(
    output: String,
    id: UnionInstanceId,
    declaration: ConcreteUnion
) -> String:
    match declaration.union_is_boxed():
        True:
            output
                .append_boxed_union_struct(id.union_number())
                .concat("*")
        False:
            prefix = if declaration.has_payload():
                "struct blorp_u_"
            else:
                "enum blorp_u_"

            output
                .concat(prefix)
                .append_int(id.union_number())


-- Every value local is const except a join's, which its arms assign.
private fixed union LocalAssignment:
    InitializedLocal
    JoinLocal


-- A local holding a pointer is itself const, so const follows a pointer type.
-- String, List and boxed union carriers spell their pointer in the C type.
private pure func append_local_declaration(
    output: String,
    value_type: TypeRef,
    assignment: LocalAssignment,
    unions: List[ConcreteUnion],
    span: Span
) -> Result[String, Diagnostic]:
    pointer_carrier: Bool ?= match value_type:
        StringType | ListType(_):
            Ok(True)
        UnionType(id):
            match unions.get(id.union_number()):
                None: Err(render(span, MissingUnionLayout(id)))
                Some(layout): Ok(layout.union_is_boxed())
        _:
            Ok(False)

    prefix = match assignment:
        InitializedLocal:
            if pointer_carrier:
                ""
            else:
                "const "
        JoinLocal:
            ""

    suffix = match assignment:
        InitializedLocal:
            if pointer_carrier:
                " const "
            else:
                " "
        JoinLocal:
            " "

    typed ?= output
        .concat(prefix)
        .append_type_name(value_type, unions, span)

    Ok(typed.concat(suffix))


private pure func append_record_type_name(output: String, id: RecordInstanceId) -> String:
    output
        .concat("blorp_r_")
        .append_int(id.record_number())


private pure func append_field_name(output: String, id: FieldInstanceId) -> String:
    output.append_field_position_name(id.field_owner(), id.field_number())


private pure func append_field_position_name(
    output: String,
    owner: RecordInstanceId,
    position: Int
) -> String:
    output
        .concat("blorp_rf_")
        .append_int(owner.record_number())
        .concat("_")
        .append_int(position)


private pure func append_record(
    output: String,
    layout: ConcreteRecord,
    index: Int,
    unions: List[ConcreteUnion]
) -> Result[String, Diagnostic]:
    var result = "${output}struct blorp_r_${index}{"

    -- C has no empty struct, so an inline record whose fields are all Void
    -- stores one unused byte, which its `{0}` literal initializes.
    match layout:
        CountedFields(_):
            result = "${result}_Atomic uint64_t references;"
        InlineFields(fields):
            if fields.all(pure func(field) -> Bool: field == VoidType):
                result = "${result}uint8_t blorp_rf_${index}_unit;"
        ValueFields(_):
            void

    var position = 0
    var invalid: Option[Diagnostic] = None

    for field in layout.record_fields():
        match field:
            VoidType:
                position = position + 1
                continue
            _:
                void

        match "".append_type_name(field, unions, compiler_span()):
            Ok(name):
                result = "${result}${name} blorp_rf_${index}_${position};"
            Err(error):
                invalid = Some(error)
                break

        position = position + 1

    match invalid:
        Some(error): Err(error)
        None: Ok("${result}};")


-- These names serialize already sealed concrete types. Equality and catalogue
-- deduplication use TypeRefs, never the generated C spelling.
private pure func append_callable_type_name(
    output: String,
    parameters: List[TypeRef],
    result: TypeRef
) -> String:
    output
        .concat("struct blorp_c_")
        .append_callable_suffix(parameters, result)


private pure func append_callable_entry_name(
    output: String,
    body: specialized.FunctionInstanceId,
    value_type: TypeRef
) -> String:
    output
        .concat("blorp_ce_")
        .append_int(body.function_number())
        .concat("_")
        .append_list_suffix(value_type.list_element_key())


private pure func callable_types(values: List[TypeRef]) -> List[TypeRef]:
    var found: List[TypeRef] = []

    for value in values:
        match value:
            ListType(element):
                for child in [element].callable_types():
                    if (
                        found
                            .any(pure func(other): child == other)
                            .not()
                    ):
                        found = found.append(child)
            CallableType(parameters, result):
                if (
                    found
                        .any(pure func(other): value == other)
                        .not()
                ):
                    found = found.append(value)

                for child in (
                    parameters
                        .append(result)
                        .callable_types()
                ):
                    if (
                        found
                            .any(pure func(other): child == other)
                            .not()
                    ):
                        found = found.append(child)
            _:
                void

    found


private pure func callable_parameters(
    parameters: List[TypeRef],
    unions: List[ConcreteUnion]
) -> Result[String, Diagnostic]:
    var output = "(void* environment"
    var failure: Option[Diagnostic] = None
    var ordinal = 0

    for parameter in parameters:
        match (
            output
                .concat(",")
                .append_type_name(parameter, unions, compiler_span())
        ):
            Ok(typed):
                output = typed
                    .concat(" ")
                    .append_parameter_name(ordinal)
            Err(error):
                failure = Some(error)
                break

        ordinal = ordinal + 1

    match failure:
        Some(error): Err(error)
        None: Ok("${output})")


-- Complete every pair before any aggregate or function ABI mentions it. Ops
-- tags may be incomplete here; their function members follow aggregate bodies.
private pure func callable_declarations(types: List[TypeRef]) -> String:
    var fragments: List[String] = []

    for value in types:
        match value:
            CallableType(parameters, result):
                suffix = parameters.callable_suffix(result)
                name = "".append_callable_type_name(parameters, result)
                ops_forward = "struct blorp_co_${suffix};"
                pair_definition = "${name}{const struct blorp_co_${suffix}* ops;void* environment;};"
                retain_declaration = "void blorp_callable_dup_${suffix}(${name});"

                drop_declaration = "void blorp_callable_drop_${suffix}(${name});".concat(
                    "void blorp_callable_drop_at_${suffix}(${name},unsigned);\n"
                )

                fragments = fragments.append(
                    ops_forward
                        .concat(pair_definition)
                        .concat(retain_declaration)
                        .concat(drop_declaration)
                )
            _:
                void

    fragments.join("")


private pure func callable_ops(
    types: List[TypeRef],
    unions: List[ConcreteUnion]
) -> Result[String, Diagnostic]:
    var fragments: List[String] = []
    var failure: Option[Diagnostic] = None

    for value in types:
        match value:
            CallableType(parameters, result):
                signature: Result[String, Diagnostic] = ""
                    .append_type_name(result, unions, compiler_span())
                    .and_then(pure func(returned):
                        parameters
                            .callable_parameters(unions)
                            .map(pure func(arguments):
                                suffix = parameters.callable_suffix(result)
                                name = "".append_callable_type_name(parameters, result)
                                ops_definition = "struct blorp_co_${suffix}{${returned} (*invoke)${arguments};void (*retain)(void*);void (*drop)(void*,unsigned);};"
                                retain_definition = "void blorp_callable_dup_${suffix}(${name} value){value.ops->retain(value.environment);}"

                                nested_definition = "void blorp_callable_drop_at_${suffix}(${name} value,unsigned depth){".concat(
                                    "value.ops->drop(value.environment,depth);}"
                                )

                                drop_definition = top_level_drop(
                                    "void blorp_callable_drop_${suffix}(${name} value)",
                                    "blorp_callable_drop_at_${suffix}"
                                )

                                ops_definition
                                    .concat(retain_definition)
                                    .concat(nested_definition)
                                    .concat("${drop_definition}\n")
                            )
                    )

                match signature:
                    Ok(text): fragments = fragments.append(text)
                    Err(error): failure = Some(error)
            _:
                void

        if failure.is_some():
            break

    match failure:
        Some(error): Err(error)
        None: Ok(fragments.join(""))


-- A callable's code entry, which its pair's ops name: the instance it runs at
-- one concrete callable type, passing the environment when it captures one.
-- Entries are disposable emission rows, keyed by instance and type.
private record CallableEntry {
    body: specialized.FunctionInstanceId,
    value_type: TypeRef,
    captures: Bool
}


-- Verification proved every callable definition's type a callable type.
private pure func append_callable_entry(
    entry: CallableEntry,
    program: OwnershipProgram
) -> Result[String, Diagnostic]:
    match entry.value_type:
        CallableType(parameters, result):
            entry.append_callable_adapters(parameters, result, program)
        _:
            Err(render(compiler_span(), NonCallableEntry(entry.body.function_number())))


private pure func append_callable_adapters(
    entry: CallableEntry,
    parameters: List[TypeRef],
    result: TypeRef,
    program: OwnershipProgram
) -> Result[String, Diagnostic]:
    body = entry.body
    span = compiler_span()

    function: OwnedFunction ?= match program.functions.get(body.function_number()):
        Some(present): Ok(present)
        None: Err(render(span, MissingFunctionRow(body.function_number())))

    name = "".append_callable_entry_name(body, entry.value_type)
    returned ?= "".append_type_name(result, program.unions, span)
    arguments ?= parameters.callable_parameters(program.unions)
    var invocation = "${body.function_number().c_name()}("
    var retain = "(void)environment;"
    var drop = "(void)environment;(void)depth;"
    var prefix = "(void)environment;"

    if entry.captures:
        match (
            function.parameters
                .get(0)
                .map(parameter_type)
        ):
            Some(RecordType(owner)):
                cast = ""
                    .concat("(")
                    .append_record_type_name(owner)
                    .concat(")environment")

                invocation = invocation.concat(cast)
                retain = "blorp_record_dup_${owner.record_number()}(${cast});"
                drop = "blorp_record_drop_at_${owner.record_number()}(${cast},depth);"
                prefix = ""
            _:
                void

    var separator: Bool = entry.captures
    var ordinal = 0

    for _ in parameters:
        if separator:
            invocation = "${invocation},"

        invocation = invocation.append_parameter_name(ordinal)
        separator = True
        ordinal = ordinal + 1

    invoke_adapter = "${returned} ${name}_invoke${arguments}{${prefix}return ${invocation});}"
    retain_adapter = "void ${name}_retain(void* environment){${retain}}"
    drop_adapter = "void ${name}_drop(void* environment,unsigned depth){${drop}}"
    ops_type = "const struct blorp_co_${parameters.callable_suffix(result)} ${name}"
    ops_initializer = "${ops_type}={${name}_invoke,${name}_retain,${name}_drop};\n"

    Ok(
        invoke_adapter
            .concat(retain_adapter)
            .concat(drop_adapter)
            .concat(ops_initializer)
    )


private pure func integer_c_type(format: IntegerFormat) -> String:
    match format:
        Int64Format: "int64_t"
        UInt8Format: "uint8_t"


private pure func append_type_name(
    output: String,
    type_ref: TypeRef,
    unions: List[ConcreteUnion],
    span: Span
) -> Result[String, Diagnostic]:
    match type_ref:
        RecordType(id):
            Ok(output.append_record_type_name(id))
        VoidType:
            Ok(output.concat("uint8_t"))
        IntegerType(format):
            Ok(output.concat(integer_c_type(format)))
        FloatType:
            Ok(output.concat("double"))
        StringType:
            Ok(output.concat("struct blorp_string*"))
        CallableType(parameters, result):
            Ok(output.append_callable_type_name(parameters, result))
        ListType(element):
            Ok(output.append_list_c_type(element.list_element_key()))
        UnionType(id):
            match unions.get(id.union_number()):
                Some(declaration): Ok(output.append_union_type_name(id, declaration))
                None: Err(render(span, MissingUnionLayout(id)))


private pure func append_variant_name(output: String, id: VariantInstanceId) -> String:
    output
        .concat("blorp_v_")
        .append_int(
            id
                .variant_owner()
                .union_number()
        )
        .concat("_")
        .append_int(id.variant_number())


private pure func c_parameters(
    parameters: List[TypeRef],
    unions: List[ConcreteUnion]
) -> Result[String, Diagnostic]:
    if parameters.length() == 0:
        Ok("(void)")
    else:
        var output: Result[String, Diagnostic] = Ok("(")
        var index: Int = 0

        for parameter in parameters:
            output = match output:
                Ok(written):
                    separated = if index > 0:
                        written.concat(",")
                    else:
                        written

                    match separated.append_type_name(parameter, unions, compiler_span()):
                        Ok(typed):
                            Ok(
                                typed
                                    .concat(" ")
                                    .append_parameter_name(index)
                            )
                        Err(error):
                            Err(error)
                Err(error):
                    Err(error)

            index = index + 1

        match output:
            Ok(written): Ok("${written})")
            Err(error): Err(error)


-- Inline unions are read by value; boxed unions through their node pointer.
private pure func union_member_selector(declaration: ConcreteUnion) -> String:
    match declaration.union_is_boxed():
        True: "->"
        False: "."


private pure func append_payload_member_name(output: String, id: VariantInstanceId) -> String:
    output
        .concat("blorp_up_")
        .append_int(id.variant_number())


private pure func append_payload_field_name(
    output: String,
    variant: VariantInstanceId,
    position: Int
) -> String:
    output
        .append_payload_member_name(variant)
        .concat(".blorp_uf_")
        .append_int(position)


private pure func append_union(
    output: String,
    declaration: ConcreteUnion,
    index: Int,
    unions: List[ConcreteUnion]
) -> Result[String, Diagnostic]:
    variants = declaration.union_variants()
    payload = declaration.has_payload()

    prefix = if payload:
        "enum blorp_tag_"
    else:
        "enum blorp_u_"

    var result = "${output}${prefix}${index}{"
    var position: Int = 0

    for shape in variants:
        if position != 0:
            result = "${result},"

        result = "${result}blorp_v_${index}_${position}"
        position = position + 1

    result = "${result}};"

    if payload:
        struct_prefix: String = "${result}struct blorp_u_${index}{"

        reference_header: String = match declaration.union_is_boxed():
            True: "_Atomic uint64_t references;"
            False: ""

        result = "${struct_prefix}${reference_header}enum blorp_tag_${index} tag;union{"
        position = 0
        var failure: Option[Diagnostic] = None

        for fields in variants:
            if (
                fields
                    .is_empty()
                    .not()
            ):
                result = "${result}struct{"
                var field_position = 0

                for value_type in fields:
                    match "".append_type_name(value_type, unions, compiler_span()):
                        Err(error):
                            failure = Some(error)
                            break
                        Ok(name):
                            result = "${result}${name} blorp_uf_${field_position};"

                    field_position = field_position + 1

                if failure.is_some():
                    break

                result = "${result}} blorp_up_${position};"

            position = position + 1

        match failure:
            Some(error): Err(error)
            None: "${result}}payload;};".append_union_ownership(declaration, index, unions)
    else:
        Ok(result)


-- Verification sealed every record and union in an order that puts each
-- by-value child first, so each C definition follows the definitions it
-- stores. Pointer edges need only the forward declarations emitted earlier.
-- Verify read each index from this program's own catalogues, so a missing
-- layout means a broken seal and is reported as a compiler error.
private pure func append_aggregate_definitions(
    program: VerifiedProgram
) -> Result[String, Diagnostic]:
    checked = program.verified_contents()
    var fragments: List[String] = []
    var failure: Option[Diagnostic] = None

    for definition in program.aggregate_order():
        rendered = match definition:
            RecordDefinition(index):
                match checked.records.get(index):
                    Some(layout):
                        "".append_record(layout, index, checked.unions)
                    None:
                        Err(render(compiler_span(), MissingAggregateLayout(RecordAggregate, index)))
            UnionDefinition(index):
                match checked.unions.get(index):
                    Some(layout):
                        "".append_union(layout, index, checked.unions)
                    None:
                        Err(render(compiler_span(), MissingAggregateLayout(UnionAggregate, index)))

        match rendered:
            Ok(text):
                fragments = fragments.append(text)
            Err(error):
                failure = Some(error)
                break

    match failure:
        Some(error): Err(error)
        None: Ok(fragments.join("\n"))


private pure func append_record_prototypes(output: String, index: Int) -> String:
    "${output}void blorp_record_dup_${index}(blorp_r_${index});".concat(
        "void blorp_record_drop_${index}(blorp_r_${index});void blorp_record_drop_at_${index}(blorp_r_${index},unsigned);"
    )


-- No cell and no count: a by-value record's references are its fields'.
private pure func append_value_record_ownership(
    prefix: String,
    fields: List[TypeRef],
    index: Int,
    unions: List[ConcreteUnion]
) -> Result[String, Diagnostic]:
    duplicated ?= prefix
        .concat("(void)value;")
        .append_value_field_actions(fields, index, unions, DuplicateValue)

    destroyed ?= duplicated
        .concat("}void blorp_record_drop_at_")
        .append_int(index)
        .concat("(blorp_r_")
        .append_int(index)
        .concat(" value,unsigned depth){(void)value;(void)depth;")
        .append_value_field_actions(fields, index, unions, DestroyNested)

    drop = top_level_drop(
        "void blorp_record_drop_${index}(blorp_r_${index} value)",
        "blorp_record_drop_at_${index}"
    )

    Ok("${destroyed}}${drop}")


-- Each field's ownership action on a by-value record named `value`.
private pure func append_value_field_actions(
    output: String,
    fields: List[TypeRef],
    index: Int,
    unions: List[ConcreteUnion],
    action: OwnershipAction
) -> Result[String, Diagnostic]:
    var result: Result[String, Diagnostic] = Ok(output)
    var position = 0

    for field in fields:
        selector = "value.blorp_rf_"
            .append_int(index)
            .concat("_")
            .append_int(position)

        result = match result:
            Ok(written):
                written.append_storage_operation(field, action, selector, unions, compiler_span())
            Err(error):
                Err(error)

        position = position + 1

    result


-- A counted record's drop only decrements and calls its release body, so the
-- C compiler can inline the decrement where a record is dropped and keep the
-- release out of line; a drop with the release inside is too large to inline.
-- A record that joins the release scheduler releases its fields at the depth
-- its nested drop passes; one whose managed fields are all Strings cannot
-- cascade, so its nested drop ignores the depth.
private pure func append_record_ownership(
    output: String,
    layout: ConcreteRecord,
    index: Int,
    unions: List[ConcreteUnion],
    records: List[ConcreteRecord]
) -> Result[String, Diagnostic]:
    prefix = "${output}void blorp_record_dup_${index}(blorp_r_${index} value){"
    joins ?= layout.record_joins_release(unions, records)

    match layout:
        InlineFields(_):
            Ok(
                "${prefix}(void)value;}void blorp_record_drop_${index}(blorp_r_${index} value){".concat(
                    "(void)value;}void blorp_record_drop_at_${index}(blorp_r_${index} value,unsigned depth){(void)value;(void)depth;}"
                )
            )
        ValueFields(fields):
            prefix.append_value_record_ownership(fields, index, unions)
        CountedFields(fields):
            release = record_release_name(index)

            body: String = if joins:
                "void ${release}(blorp_r_${index} value,unsigned depth){"
            else:
                "void ${release}(blorp_r_${index} value){"

            action: OwnershipAction = if joins:
                DestroyNested
            else:
                DestroyValue

            var result = "${prefix}(void)blorp_record_count_add(&value->references);}${body}"
            var position = 0
            var invalid: Option[Diagnostic] = None

            for field in fields:
                match (result.append_storage_operation(
                    field,
                    action,
                    "value->blorp_rf_${index}_${position}",
                    unions,
                    compiler_span()
                )):
                    Ok(updated):
                        result = updated
                    Err(error):
                        invalid = Some(error)
                        break

                position = position + 1

            match invalid:
                Some(error):
                    Err(error)
                None:
                    decrement = "if(blorp_record_count_subtract(&value->references)!=UINT64_C(1))return;"
                    drop = "void blorp_record_drop_${index}(blorp_r_${index} value)"
                    nested = "void blorp_record_drop_at_${index}(blorp_r_${index} value,unsigned depth){"

                    released = if joins:
                        "${nested}${decrement}${depth_checked_release(release)}".concat(
                            top_level_drop(drop, "blorp_record_drop_at_${index}")
                        )
                    else:
                        "${drop}{${decrement}${release}(value);}${nested}(void)depth;blorp_record_drop_${index}(value);}"

                    result = "${result}blorp_memory_release(value);}${released}"
                        .concat(
                            "blorp_r_${index} blorp_record_make_${index}(struct blorp_r_${index} fields){"
                        )
                        .concat(
                            "(void)fields;blorp_r_${index} value=blorp_memory_allocate(sizeof *value);if(!value)abort();"
                        )
                        .concat("atomic_init(&value->references,UINT64_C(1));")

                    position = 0

                    for value_type in fields:
                        match value_type:
                            VoidType:
                                position = position + 1
                                continue
                            _:
                                void

                        field = "blorp_rf_${index}_${position}"
                        result = "${result}value->${field}=fields.${field};"
                        position = position + 1

                    Ok("${result}return value;}")


private pure func append_operation(
    output: String,
    id: ValueId,
    value_type: TypeRef,
    operation: OwnedValueOperation,
    unions: List[ConcreteUnion],
    records: List[ConcreteRecord],
    span: Span
) -> Result[String, Diagnostic]:
    match operation:
        ConstructRecordDefinition(owner, fields):
            match records.get(owner.record_number()):
                Some(layout):

                    var result = match layout:
                        InlineFields(_) | ValueFields(_): "${output}(("
                        CountedFields(_): "${output}blorp_record_make_${owner.record_number()}(("

                    result = "${result}struct blorp_r_${owner.record_number()}){"
                    var position = 0
                    layout_fields = layout.record_fields()

                    for field in fields:
                        match layout_fields.get(field.field.field_number()):
                            Some(VoidType): continue
                            _: void

                        if position > 0:
                            result = "${result},"

                        stored = match field.value:
                            UnmanagedPayload(value): value
                            OwnedPayload(value, _): value

                        result = result
                            .concat(".")
                            .append_field_name(field.field)
                            .concat("=")
                            .append_local_name(stored)

                        position = position + 1

                    if position == 0:
                        result = "${result}0"

                    Ok("${result}})")
                None:
                    Err(render(span, MissingRecordLayout(owner)))
        ReadRecordFieldDefinition(field, argument):
            match records.get(
                field
                    .field_owner()
                    .record_number()
            ):
                Some(layout):

                    match value_type:
                        VoidType:
                            Ok("${output}0")
                        _:
                            value = match argument:
                                UnmanagedArgument(value): value
                                ConsumedArgument(value, _): value
                                BorrowedArgument(borrow): borrow.value

                            selector = match layout:
                                InlineFields(_) | ValueFields(_): "."
                                CountedFields(_): "->"

                            Ok(
                                output
                                    .append_local_name(value)
                                    .concat(selector)
                                    .append_field_name(field)
                            )
                None:
                    Err(render(span, MissingRecordLayout(field.field_owner())))
        ParameterDefinition(index):
            Ok(output.append_parameter_name(index))
        VoidDefinition:
            Ok("${output}((uint8_t)0)")
        IntegerDefinition(Int64Format, value):
            Ok(output.append_integer(value))
        -- Verification proved that the value fits, so the cast never changes it.
        IntegerDefinition(UInt8Format, value):
            Ok("${output}((uint8_t)${value})")
        FloatDefinition(value):
            Ok(output.concat(value.c_float_literal()))
        StringDefinition(_):
            Ok("${output}blorp_string_literal_acquire(&${id.c_literal_name()}.value)")
        ReadConstantDefinition(constant):
            Ok("${output}blorp_k_".append_int(constant.constant_instance_number()))
        FreeCallableDefinition(body):
            match (
                output
                    .concat("((")
                    .append_type_name(value_type, unions, span)
            ):
                Err(error):
                    Err(error)
                Ok(typed):
                    Ok(
                        typed
                            .concat("){&")
                            .append_callable_entry_name(body, value_type)
                            .concat(",(void*)0})")
                    )
        CapturedCallableDefinition(body, payload):
            match (
                output
                    .concat("((")
                    .append_type_name(value_type, unions, span)
            ):
                Err(error):
                    Err(error)
                Ok(typed):
                    value = match payload:
                        UnmanagedPayload(stored): stored
                        OwnedPayload(stored, _): stored

                    Ok(
                        typed
                            .concat("){&")
                            .append_callable_entry_name(body, value_type)
                            .concat(",")
                            .append_local_name(value)
                            .concat("})")
                    )
        InvokeCallableDefinition(callee, arguments):
            callee_value = callee.argument_value()

            var invocation = output
                .append_local_name(callee_value)
                .concat(".ops->invoke(")
                .append_local_name(callee_value)
                .concat(".environment")

            for argument in arguments:
                invocation = invocation
                    .concat(",")
                    .append_local_name(argument.argument_value())

            Ok(invocation.concat(")"))
        -- C defines the conversion into each format named here: into Int64, which
        -- holds every source value, exactly, and into the unsigned UInt8, modulo 256.
        -- A signed format narrower than Int64 would need a helper instead.
        CallDefinition(RuntimeFunction(IntegerConvert(_, target)), [argument]):
            match target:
                Int64Format | UInt8Format:
                    Ok(
                        output
                            .concat("(${integer_c_type(target)})")
                            .append_local_name(argument.argument_value())
                    )
        CallDefinition(target, arguments):
            -- A runtime operand 0 that receives its obligation calls the
            -- operation's in-place helper; verification admits no other.
            named: Result[String, Diagnostic] = match (target, arguments.get(0)):
                (RuntimeFunction(runtime), Some(ConsumedArgument(_, _))):
                    match runtime.consuming_helper_name():
                        Some(helper): Ok(helper)
                        None: Err(render(span, MissingInPlaceHelper(id)))
                _:
                    match target.c_callable():
                        Some(callable): Ok(callable)
                        None: Err(render(span, StatementOnlyValue(id)))

            match named:
                Err(error):
                    Err(error)
                Ok(name):
                    var prefix = "${output}${name}("
                    var index: Int = 0

                    for argument in arguments:
                        if index > 0:
                            prefix = "${prefix},"

                        value = match argument:
                            UnmanagedArgument(argument_id): argument_id
                            ConsumedArgument(argument_id, _): argument_id
                            BorrowedArgument(borrow): borrow.value

                        prefix = prefix.append_local_name(value)
                        index = index + 1

                    Ok("${prefix})")
        ConstructDefinition(variant_id, fields):
            var operands: List[String] = []

            for field in fields:
                operands = operands.append("".append_stored_name(field))

            output.append_union_value(variant_id, operands, unions, span)
        ConstructListDefinition(_):
            -- List construction and joins are written as statements, by
            -- append_list_construction and append_join; never as expressions.
            Err(render(span, StatementOnlyValue(id)))
        ListElementDefinition(index, parent):
            Ok(
                output
                    .append_local_name(parent)
                    .concat("->values[")
                    .append_int(index)
                    .concat("]")
            )
        ListSuffixDefinition(parent, skipped):
            match value_type:
                ListType(element):
                    Ok(
                        output
                            .append_list_update_name(SuffixUpdate, element.list_element_key())
                            .concat("(")
                            .append_local_name(parent.argument_value())
                            .concat(",INT64_C(")
                            .append_int(skipped)
                            .concat("))")
                    )
                _:
                    Err(render(span, InvalidOperationShape(id)))
        PayloadDefinition(field, source_id):
            match unions.get(
                field
                    .variant_field_variant()
                    .variant_owner()
                    .union_number()
            ):
                Some(declaration):
                    Ok(
                        output
                            .append_local_name(source_id)
                            .concat(declaration.union_member_selector())
                            .concat("payload.")
                            .append_payload_field_name(
                                field.variant_field_variant(),
                                field.variant_field_number()
                            )
                    )
                None:
                    Err(
                        render(
                            span,
                            MissingUnionLayout(
                                field
                                    .variant_field_variant()
                                    .variant_owner()
                            )
                        )
                    )


-- The one C rendering of a union value, for source constructions and runtime
-- results alike, so every union value local follows its layout. A union with
-- no payload anywhere is a bare C enum and a variant is its tag; any other
-- value is a compound literal, from which a boxed union allocates its counted
-- node. Each operand is an occurrence the new value owns.
private pure func append_union_value(
    output: String,
    variant: VariantInstanceId,
    operands: List[String],
    unions: List[ConcreteUnion],
    span: Span
) -> Result[String, Diagnostic]:
    index = variant
        .variant_owner()
        .union_number()

    declaration: ConcreteUnion ?= match unions.get(index):
        Some(found): Ok(found)
        None: Err(render(span, MissingUnionLayout(variant.variant_owner())))

    if declaration.has_payload():
        opening = match declaration.union_is_boxed():
            True:
                output
                    .concat("blorp_union_make_")
                    .append_int(index)
                    .concat("((")
                    .append_boxed_union_struct(index)
            False:
                output
                    .concat("((")
                    .append_union_type_name(variant.variant_owner(), declaration)

        tagged = opening
            .concat("){.tag=")
            .append_variant_name(variant)

        -- A variant without fields omits the payload initializer.
        if operands.is_empty():
            Ok(tagged.concat("})"))
        else:
            Ok(
                tagged
                    .append_payload_initializer(variant, operands)
                    .concat("})")
            )
    else:
        Ok(output.append_variant_name(variant))


private pure func append_payload_initializer(
    output: String,
    id: VariantInstanceId,
    operands: List[String]
) -> String:
    var result = output
        .concat(",.payload.")
        .append_payload_member_name(id)
        .concat("={")

    var position = 0

    for operand in operands:
        if position > 0:
            result = result.concat(",")

        result = result
            .concat(".blorp_uf_")
            .append_int(position)
            .concat("=")
            .concat(operand)

        position = position + 1

    result.concat("}")


private pure func argument_value(argument: OwnedArgument) -> ValueId:
    match argument:
        UnmanagedArgument(id): id
        ConsumedArgument(id, _): id
        BorrowedArgument(borrow): borrow.value


private pure func append_optional_value(
    output: String,
    id: ValueId,
    option: DesignatedOption[VariantInstanceId],
    condition: String,
    payload: String,
    unions: List[ConcreteUnion],
    span: Span
) -> Result[String, Diagnostic]:
    declared ?= output.append_local_declaration(
        UnionType(option.some.variant_owner()),
        InitializedLocal,
        unions,
        span
    )

    with_some ?= declared
        .append_local_name(id)
        .concat("=")
        .concat(condition)
        .concat("?")
        .append_union_value(option.some, [payload], unions, span)

    with_none ?= with_some
        .concat(":")
        .append_union_value(option.none, [], unions, span)

    Ok(
        with_none
            .concat(";(void)")
            .append_local_name(id)
            .concat(";")
    )


-- The error is built only when the argument is missing: callers sit on the success path.
private pure func runtime_argument(
    arguments: List[OwnedArgument],
    position: Int,
    id: ValueId,
    span: Span
) -> Result[OwnedArgument, Diagnostic]:
    match arguments.get(position):
        Some(found): Ok(found)
        None: Err(render(span, MissingRuntimeArgument(id, position)))


-- A one-argument runtime call that fills its scratch payload and returns whether
-- the result is Some.
private pure func append_unary_option(
    output: String,
    id: ValueId,
    option: DesignatedOption[VariantInstanceId],
    arguments: List[OwnedArgument],
    unions: List[ConcreteUnion],
    scalar_type: String,
    runtime: String,
    span: Span
) -> Result[String, Diagnostic]:
    argument ?= arguments.runtime_argument(0, id, span)
    scratch = "blorp_runtime_".append_int(id.value_number())

    prefix = "${output}${scalar_type} ${scratch}=0;"
        .concat("const uint8_t ${scratch}_some=${runtime}(")
        .append_local_name(argument.argument_value())
        .concat(",&${scratch});")

    prefix.append_optional_value(id, option, "${scratch}_some", scratch, unions, span)


-- A String and an index that fill a `scalar_type` payload when the index is in
-- range: `runtime` reads a byte, or the scalar at a code point index.
private pure func append_string_index(
    output: String,
    id: ValueId,
    option: DesignatedOption[VariantInstanceId],
    arguments: List[OwnedArgument],
    unions: List[ConcreteUnion],
    scalar_type: String,
    runtime: String,
    span: Span
) -> Result[String, Diagnostic]:
    text ?= arguments.runtime_argument(0, id, span)
    index ?= arguments.runtime_argument(1, id, span)
    scratch = "blorp_runtime_".append_int(id.value_number())

    prefix = "${output}${scalar_type} ${scratch}=0;const uint8_t ${scratch}_some=${runtime}("
        .append_local_name(text.argument_value())
        .concat(",")
        .append_local_name(index.argument_value())
        .concat(",&${scratch});")

    prefix.append_optional_value(id, option, "${scratch}_some", scratch, unions, span)


private pure func append_string_from_codepoint(
    output: String,
    id: ValueId,
    option: DesignatedOption[VariantInstanceId],
    arguments: List[OwnedArgument],
    unions: List[ConcreteUnion],
    span: Span
) -> Result[String, Diagnostic]:
    scalar ?= arguments.runtime_argument(0, id, span)
    scratch = "blorp_runtime_".append_int(id.value_number())

    prefix = "${output}struct blorp_string *${scratch}=NULL;"
        .concat("const uint8_t ${scratch}_some=blorp_string_from_codepoint(")
        .append_local_name(scalar.argument_value())
        .concat(",&${scratch});")

    -- Some takes the fresh root. Scratch is neither retained nor released here.
    prefix.append_optional_value(id, option, "${scratch}_some", scratch, unions, span)


private pure func append_string_slice(
    output: String,
    id: ValueId,
    option: DesignatedOption[VariantInstanceId],
    arguments: List[OwnedArgument],
    unions: List[ConcreteUnion],
    span: Span
) -> Result[String, Diagnostic]:
    text ?= arguments.runtime_argument(0, id, span)
    start ?= arguments.runtime_argument(1, id, span)
    end ?= arguments.runtime_argument(2, id, span)

    scratch = "blorp_runtime_".append_int(id.value_number())

    prefix = "${output}struct blorp_string *${scratch}=NULL;"
        .concat("const uint8_t ${scratch}_some=blorp_string_byte_slice(")
        .append_local_name(text.argument_value())
        .concat(",")
        .append_local_name(start.argument_value())
        .concat(",")
        .append_local_name(end.argument_value())
        .concat(",&${scratch});")

    -- Some takes the fresh root. Scratch has no separate ownership obligation.
    prefix.append_optional_value(id, option, "${scratch}_some", scratch, unions, span)


-- The declaration of the C local a system call fills with one Result payload.
-- A Void payload has none; its constructor takes the unmanaged unit.
private pure func system_payload_local(payload: SystemPayload, name: String) -> Option[String]:
    match payload:
        IntPayload:
            Some("int64_t ${name}=0;")
        StringPayload:
            Some("struct blorp_string *${name}=NULL;")
        StringListPayload:
            Some("${StringType.list_element_key().list_c_type()} ${name}=NULL;")
        UInt8ListPayload:
            Some("${IntegerType(UInt8Format).list_element_key().list_c_type()} ${name}=NULL;")
        VoidPayload:
            None


-- The call's argument and the constructor's payload for one Result branch.
private record PayloadUse {
    addresses: List[String],
    declarations: String,
    value: String
}


private pure func payload_use(
    payload: SystemPayload,
    name: String,
    previous: PayloadUse
) -> PayloadUse:
    match payload.system_payload_local(name):
        Some(declaration):
            {
                addresses = previous.addresses.append("&${name}"),
                declarations = previous.declarations.concat(declaration),
                value = name
            }
        None:
            { previous | value = "(uint8_t)0" }


-- Every system call has one C shape: its borrowed arguments, then the address
-- of one local per non-Void payload, success first, and a status choosing the
-- constructor. Each constructor takes its own fresh payload, and the other
-- local stays unowned.
private pure func append_system_call(
    output: String,
    id: ValueId,
    operation: SystemOperation,
    result: DesignatedResult[VariantInstanceId],
    arguments: List[OwnedArgument],
    unions: List[ConcreteUnion],
    span: Span
) -> Result[String, Diagnostic]:
    signature = operation.system_signature()
    scratch = "blorp_runtime_".append_int(id.value_number())

    values = arguments.map(
        pure func(argument: OwnedArgument) -> String: "".append_local_name(
            argument.argument_value()
        )
    )

    success = signature.success.payload_use("${scratch}_value", {
        addresses = values,
        declarations = "",
        value = ""
    })

    failure = signature.error.payload_use("${scratch}_error", success)
    call = "${output}${failure.declarations}const uint8_t ${scratch}_ok=${operation.system_symbol()}(${failure.addresses.join(",")});"

    declared ?= call.append_local_declaration(
        UnionType(result.ok.variant_owner()),
        InitializedLocal,
        unions,
        span
    )

    with_ok ?= declared
        .append_local_name(id)
        .concat("=${scratch}_ok?")
        .append_union_value(result.ok, [success.value], unions, span)

    with_error ?= with_ok
        .concat(":")
        .append_union_value(result.err, [failure.value], unions, span)

    Ok(
        with_error
            .concat(";(void)")
            .append_local_name(id)
            .concat(";")
    )


private pure func append_list_get(
    output: String,
    id: ValueId,
    option: DesignatedOption[VariantInstanceId],
    element: TypeRef,
    arguments: List[OwnedArgument],
    unions: List[ConcreteUnion],
    span: Span
) -> Result[String, Diagnostic]:
    values ?= arguments.runtime_argument(0, id, span)
    index ?= arguments.runtime_argument(1, id, span)
    scratch = "blorp_runtime_".append_int(id.value_number())
    typed ?= output.append_type_name(element, unions, span)

    prefix = typed
        .concat(" ${scratch}={0};")
        .concat("const uint8_t ${scratch}_some=blorp_list_get_")
        .append_list_suffix(element.list_element_key())
        .concat("(")
        .append_local_name(values.argument_value())
        .concat(",")
        .append_local_name(index.argument_value())
        .concat(",&${scratch});")

    prefix.append_optional_value(id, option, "${scratch}_some", scratch, unions, span)


-- A join's job, named by its two tasks' instances: its slots follow from
-- their signatures alone, so one pair of tasks has one job.
private pure func append_job_name(output: String, tasks: TaskJoin) -> String:
    output
        .concat("blorp_job_")
        .append_int(tasks.left.function_number())
        .concat("_")
        .append_int(tasks.right.function_number())


-- The trampoline blorp_join runs for the task at `position`, 0 for the left
-- and 1 for the right, as in the pair: it calls the task's instance
-- directly, lending it the job's environment slot `environment` when the task
-- takes one, and stores the result unless it is Void.
private pure func append_trampoline(
    output: String,
    job: String,
    position: Int,
    task: FunctionInstanceId,
    function: OwnedFunction,
    environment: Int
) -> String:
    takes_environment = function.parameters
        .is_empty()
        .not()

    argument = if takes_environment:
        "slots->environment_${environment}"
    else:
        ""

    call = "${task.function_number().c_name()}(${argument})"
    stores_result = function.return_type != VoidType

    body = if stores_result:
        "slots->result_${position}=${call};"
    else:
        "(void)${call};"

    slots = if stores_result.or(takes_environment):
        "struct ${job} *const slots=job;"
    else:
        "(void)job;"

    "${output}static void ${job}_${position}(void *job){${slots}${body}}"


-- A task's result slot in its job, which a Void result does not have.
private pure func result_slot(
    function: OwnedFunction,
    position: Int,
    unions: List[ConcreteUnion]
) -> Result[List[String], Diagnostic]:
    match function.return_type:
        VoidType:
            Ok([])
        _:
            ""
                .append_type_name(function.return_type, unions, compiler_span())
                .map(pure func(typed) -> List[String]: ["${typed} result_${position};"])


-- The job a join's call fills and the trampolines blorp_join runs on it. It
-- holds each environment the tasks take, numbered in the call's argument
-- order, then each task's result but Void, since C has no Void member.
private pure func append_job(
    output: String,
    tasks: TaskJoin,
    functions: List[OwnedFunction],
    unions: List[ConcreteUnion]
) -> Result[String, Diagnostic]:
    left ?= functions
        .get(tasks.left.function_number())
        .to_result(render(compiler_span(), MissingJoinedTask(tasks.left.function_number())))

    right ?= functions
        .get(tasks.right.function_number())
        .to_result(render(compiler_span(), MissingJoinedTask(tasks.right.function_number())))

    job = "".append_job_name(tasks)

    environments ?= left.parameters
        .concat(right.parameters)
        .translated_list(pure func(parameter: own.OwnedParameter) -> Result[String, Diagnostic]:
            "".append_type_name(parameter.parameter_type(), unions, compiler_span())
        )

    left_result ?= left.result_slot(0, unions)
    right_result ?= right.result_slot(1, unions)
    var members: List[String] = []

    for typed in environments:
        members = members.append("${typed} environment_${members.length()};")

    members = members
        .concat(left_result)
        .concat(right_result)

    slots = if members.is_empty():
        "uint8_t unit;"
    else:
        members.join("")

    Ok(
        "${output}struct ${job}{${slots}};"
            .append_trampoline(job, 0, tasks.left, left, 0)
            .append_trampoline(job, 1, tasks.right, right, left.parameters.length())
    )


-- A join's call: the job holds the environments it lends, blorp_join runs
-- both trampolines, and the pair takes the results they stored, moved, as
-- ConstructRecordDefinition builds a record.
private pure func append_task_join(
    output: String,
    id: ValueId,
    value_type: TypeRef,
    tasks: TaskJoin,
    arguments: List[OwnedArgument],
    unions: List[ConcreteUnion],
    records: List[ConcreteRecord],
    span: Span
) -> Result[String, Diagnostic]:
    owner: RecordInstanceId ?= match value_type:
        RecordType(pair): Ok(pair)
        _: Err(render(span, InvalidOperationShape(id)))

    layout ?= records
        .get(owner.record_number())
        .to_result(render(span, MissingRecordLayout(owner)))

    job = "".append_job_name(tasks)
    scratch = "blorp_runtime_".append_int(id.value_number())
    var lent: List[String] = []

    for argument in arguments:
        lent = lent.append(
            ".environment_${lent.length()}=".append_local_name(argument.argument_value())
        )

    var stored: List[String] = []
    var position = 0

    for field in layout.record_fields():
        if field != VoidType:
            stored = stored.append(
                "."
                    .append_field_position_name(owner, position)
                    .concat("=${scratch}.result_${position}")
            )

        position = position + 1

    filled = if lent.is_empty():
        "0"
    else:
        lent.join(",")

    values = if stored.is_empty():
        "0"
    else:
        stored.join(",")

    pair = "(struct blorp_r_${owner.record_number()}){${values}}"

    made = match layout:
        CountedFields(_): "blorp_record_make_${owner.record_number()}(${pair})"
        InlineFields(_) | ValueFields(_): "(${pair})"

    declared ?= output
        .concat("struct ${job} ${scratch}={${filled}};")
        .concat("blorp_join(${job}_0,${job}_1,&${scratch});")
        .append_local_declaration(value_type, InitializedLocal, unions, span)

    Ok(
        declared
            .append_local_name(id)
            .concat("=${made};(void)")
            .append_local_name(id)
            .concat(";")
    )


-- A parallel map's job and its functions: `blorp_map_7` for a direct call of
-- the instance blorp_f_7, and `blorp_map_p1_s_r_i_e` for a closure of
-- `(String) -> Int`, by its callable type's suffix. The two never meet, since
-- an instance number starts with a digit and a callable suffix with `p`.
private pure func append_map_job_name(output: String, callback: MapCallback) -> String:
    match callback:
        DirectCallback(id):
            output
                .concat("blorp_map_")
                .append_int(id.function_number())
        ClosureCallback(types):
            output
                .concat("blorp_map_")
                .append_callable_suffix([types.element], types.result)


-- A parallel map's job: the job's struct, its piece and its run function,
-- which the map's call calls. A direct callback's job lends it the
-- environment, if its instance takes one, and a closure's job holds the
-- closure, which the piece invokes as InvokeCallable does.
private pure func append_map_job(
    output: String,
    callback: MapCallback,
    functions: List[OwnedFunction],
    unions: List[ConcreteUnion]
) -> Result[String, Diagnostic]:
    job = "".append_map_job_name(callback)
    element = "slots->values->values[index]"

    match callback:
        ClosureCallback(types):
            output.append_map_functions(
                job,
                types.element,
                types.result,
                Some(("closure", CallableType([types.element], types.result))),
                "slots->closure.ops->invoke(slots->closure.environment,${element})",
                unions
            )
        DirectCallback(id):
            callee = id
                .function_number()
                .c_name()

            invalid = render(compiler_span(), InvalidMapCallback(id.function_number()))

            match functions.get(id.function_number()):
                None:
                    Err(invalid)
                Some(function):
                    match function.parameters.map(parameter_type):
                        [taken]:
                            output.append_map_functions(
                                job,
                                taken,
                                function.return_type,
                                None,
                                "${callee}(${element})",
                                unions
                            )
                        [environment, taken]:
                            output.append_map_functions(
                                job,
                                taken,
                                function.return_type,
                                Some(("environment", environment)),
                                "${callee}(slots->environment,${element})",
                                unions
                            )
                        _:
                            Err(invalid)


-- A job of `call`, the callback's call on the element at `index`, mapping
-- `element`s to `result`s, with the value the callback borrows besides each
-- element, if any, as its slot's name and type. The run function returns the
-- layout's empty root for an empty input, with no allocation, as `map` does,
-- and otherwise allocates the result once, with a slot per element, and runs
-- the pieces on the pool. A piece writes only the slots of its range, never
-- the length, so no two threads write one location. blorp_join_range returns
-- once every piece has, and each join's `done` is released after its half's
-- last write and acquired before the join returns, so every slot is visible
-- here before the length, written once, counts it and the result is returned.
private pure func append_map_functions(
    output: String,
    job: String,
    element: TypeRef,
    result: TypeRef,
    borrowed: Option[(String, TypeRef)],
    call: String,
    unions: List[ConcreteUnion]
) -> Result[String, Diagnostic]:
    values ?= "const ".append_type_name(ListType(element), unions, compiler_span())
    results ?= "".append_type_name(ListType(result), unions, compiler_span())

    lent: Option[(String, String)] ?= match borrowed:
        None:
            Ok(None)
        Some((name, value_type)):
            ""
                .append_type_name(value_type, unions, compiler_span())
                .map(pure func(typed) -> Option[(String, String)]: Some(("${typed} ${name}", name)))

    (member, parameter, initializer) = match lent:
        None: ("", "", "")
        Some((declared, name)): ("${declared};", ",${declared}", ",.${name}=${name}")

    empty = result
        .list_element_key()
        .list_empty_root()

    allocation = results.list_root_allocation("result", "count")

    Ok(
        "${output}struct ${job}{${values} values;${results} result;${member}};"
            .concat(
                "static void ${job}_piece(void *job,int64_t low,int64_t high){struct ${job} *const slots=job;"
            )
            .concat(
                "for(int64_t index=low;index<high;index++)slots->result->values[index]=${call};}"
            )
            .concat(
                "static ${results} ${job}_run(${values} values${parameter}){const int64_t count=values->length;"
            )
            .concat("if(count==0)return ${empty};")
            .concat(
                "if((uintmax_t)count>(SIZE_MAX-sizeof *((${results})0))/sizeof ((${results})0)->values[0])abort();"
            )
            .concat("${allocation}struct ${job} job={.values=values,.result=result${initializer}};")
            .concat(
                "blorp_join_range(${job}_piece,&job,count);result->length=count;return result;}"
            )
    )


private pure func append_value(
    output: String,
    id: ValueId,
    value_type: TypeRef,
    operation: OwnedValueOperation,
    unions: List[ConcreteUnion],
    records: List[ConcreteRecord],
    span: Span
) -> Result[String, Diagnostic]:
    match operation:
        CallDefinition(target, arguments):
            match target:
                JoinTasks(tasks):
                    output.append_task_join(id, value_type, tasks, arguments, unions, records, span)
                RuntimeFunction(StringParseInt(option)):
                    output.append_unary_option(
                        id,
                        option,
                        arguments,
                        unions,
                        "int64_t",
                        "blorp_string_parse_int",
                        span
                    )
                RuntimeFunction(StringParseFloat(option)):
                    output.append_unary_option(
                        id,
                        option,
                        arguments,
                        unions,
                        "double",
                        "blorp_string_parse_float",
                        span
                    )
                RuntimeFunction(ListGet(element, option)):
                    output.append_list_get(id, option, element, arguments, unions, span)
                RuntimeFunction(StringByteAtUInt8(option)):
                    output.append_string_index(
                        id,
                        option,
                        arguments,
                        unions,
                        "uint8_t",
                        "blorp_string_byte_at_uint8",
                        span
                    )
                RuntimeFunction(StringCodepointAt(option)):
                    output.append_string_index(
                        id,
                        option,
                        arguments,
                        unions,
                        "int64_t",
                        "blorp_string_codepoint_at",
                        span
                    )
                RuntimeFunction(BytesToText(option)):
                    output.append_unary_option(
                        id,
                        option,
                        arguments,
                        unions,
                        "struct blorp_string *",
                        "blorp_bytes_to_text",
                        span
                    )
                RuntimeFunction(StringFromCodepoint(option)):
                    output.append_string_from_codepoint(id, option, arguments, unions, span)
                RuntimeFunction(StringSlice(option)) | RuntimeFunction(StringByteSlice(option)):
                    output.append_string_slice(id, option, arguments, unions, span)
                RuntimeFunction(SystemCall(system, result)):
                    output.append_system_call(id, system, result, arguments, unions, span)
                RuntimeFunction(StringEquals(boolean)):
                    output.append_comparison(id, boolean, arguments, unions, StringEquality, span)
                -- C compares every integer format's values exactly after promotion.
                RuntimeFunction(IntegerEquals(_, boolean)):
                    output.append_comparison(id, boolean, arguments, unions, ScalarEquality, span)
                RuntimeFunction(IntegerLessThan(_, boolean)):
                    output.append_comparison(id, boolean, arguments, unions, ScalarLessThan, span)
                RuntimeFunction(FloatEquals(boolean)):
                    output.append_comparison(id, boolean, arguments, unions, ScalarEquality, span)
                RuntimeFunction(FloatLessThan(boolean)):
                    output.append_comparison(id, boolean, arguments, unions, ScalarLessThan, span)
                _:
                    output.append_regular_value(id, value_type, operation, unions, records, span)
        ConstructListDefinition(payloads):
            output.append_list_construction(id, value_type, payloads, span)
        _:
            output.append_regular_value(id, value_type, operation, unions, records, span)


-- Literals reserve exactly their known number of element slots; `[]` instead
-- names its layout's immortal root, an owner whose dup and drop do nothing in
-- normal builds and only count its owners in diagnostic builds.
-- Elements' acquisitions precede the inline construction, so each store
-- moves an owner or copies an unmanaged value, publishing length per slot.
private pure func append_list_construction(
    output: String,
    id: ValueId,
    value_type: TypeRef,
    payloads: List[StoredPayload],
    span: Span
) -> Result[String, Diagnostic]:
    key: ListElementKey ?= match value_type:
        ListType(element): Ok(element.list_element_key())
        _: Err(render(span, InvalidOperationShape(id)))

    type_name = key.list_c_type()
    name = "".append_local_name(id)

    var result = if payloads.is_empty():
        "${output}${type_name} const ${name}=${key.list_empty_root()};"
    else:
        capacity = "".append_int(payloads.length())
        checked_capacity = "${name}_capacity"

        "${output}const size_t ${checked_capacity}=${capacity};"
            .concat(
                "if((uintmax_t)${checked_capacity}>(uintmax_t)INT64_MAX||${checked_capacity}>(SIZE_MAX-sizeof *((${type_name})0))/sizeof ((${type_name})0)->values[0])abort();"
            )
            .concat(
                type_name
                    .concat(" const")
                    .list_root_allocation(name, checked_capacity)
            )

    var slot = 0

    for payload in payloads:
        result = result.concat(
            name.list_slot_store("".append_int(slot), "".append_stored_name(payload))
        )

        slot = slot + 1

    Ok("${result}(void)${name};")


private fixed union Comparison:
    StringEquality
    ScalarEquality
    ScalarLessThan


private pure func append_comparison(
    output: String,
    id: ValueId,
    boolean: DesignatedBoolean[VariantInstanceId],
    arguments: List[OwnedArgument],
    unions: List[ConcreteUnion],
    comparison: Comparison,
    span: Span
) -> Result[String, Diagnostic]:
    left ?= arguments.runtime_argument(0, id, span)
    right ?= arguments.runtime_argument(1, id, span)
    left_value = "".append_local_name(left.argument_value())
    right_value = "".append_local_name(right.argument_value())

    condition = match comparison:
        StringEquality: "blorp_string_equals(${left_value},${right_value})"
        ScalarEquality: "(${left_value}==${right_value})"
        ScalarLessThan: "(${left_value}<${right_value})"

    output.append_boolean(id, boolean, condition, unions, span)


private pure func append_boolean(
    output: String,
    id: ValueId,
    boolean: DesignatedBoolean[VariantInstanceId],
    condition: String,
    unions: List[ConcreteUnion],
    span: Span
) -> Result[String, Diagnostic]:
    declared ?= output.append_local_declaration(
        UnionType(boolean.true_variant.variant_owner()),
        InitializedLocal,
        unions,
        span
    )

    with_true ?= declared
        .append_local_name(id)
        .concat("=")
        .concat(condition)
        .concat("?")
        .append_union_value(boolean.true_variant, [], unions, span)

    with_false ?= with_true
        .concat(":")
        .append_union_value(boolean.false_variant, [], unions, span)

    Ok(
        with_false
            .concat(";(void)")
            .append_local_name(id)
            .concat(";")
    )


private pure func append_regular_value(
    output: String,
    id: ValueId,
    value_type: TypeRef,
    operation: OwnedValueOperation,
    unions: List[ConcreteUnion],
    records: List[ConcreteRecord],
    span: Span
) -> Result[String, Diagnostic]:
    prepared = match operation:
        StringDefinition(bytes): output.append_static_string(id.c_literal_name(), bytes)
        _: output

    declared ?= prepared.append_local_declaration(value_type, InitializedLocal, unions, span)

    value ?= declared
        .append_local_name(id)
        .concat("=")
        .append_operation(id, value_type, operation, unions, records, span)

    Ok(
        value
            .concat(";(void)")
            .append_local_name(id)
            .concat(";")
    )


-- The C that binds `owner` to `value`. Callers append it themselves: passing
-- in an accumulator that is still read after the call would keep a second
-- reference live across it, so the append would copy the whole accumulator.
private pure func owner_alias(
    owner: OwnerId,
    value: ValueId,
    value_type: TypeRef,
    unions: List[ConcreteUnion],
    span: Span
) -> Result[String, Diagnostic]:
    declaration ?= "".append_local_declaration(value_type, InitializedLocal, unions, span)

    Ok(
        declaration
            .append_owner_name(owner)
            .concat("=")
            .append_local_name(value)
            .concat(";(void)")
            .append_owner_name(owner)
            .concat(";")
    )


private pure func append_owned_definition(
    output: String,
    definition: OwnedDefinition,
    unions: List[ConcreteUnion],
    records: List[ConcreteRecord]
) -> Result[String, Diagnostic]:
    value ?= output.append_value(
        definition.id,
        definition.value_type,
        definition.operation,
        unions,
        records,
        definition.span
    )

    match definition.result:
        UnmanagedResult | BorrowedResult(_):
            Ok(value)
        OwnedResult(owner):
            match owner.owner_alias(definition.id, definition.value_type, unions, definition.span):
                Ok(binding): Ok("${value}${binding}")
                Err(error): Err(error)


-- Disposable owner-type projection of accepted IR; value types stay local.
private pure func owner_types(function: OwnedFunction) -> Result[List[TypeRef], Diagnostic]:
    blocks = function.function_blocks()
    var values: List[TypeRef] = []
    var owners: List[TypeRef] = []
    var failure: Option[Diagnostic] = None

    for block in blocks:
        for header in block.headers:
            fact = header.parameter.join_parameter()
            values = values.append(fact.value_type)

            match header.parameter:
                UnmanagedJoinParameter(_): void
                ManagedJoinParameter(_, _): owners = owners.append(fact.value_type)

        for input in block.inputs:
            fact = input.join_parameter()
            values = values.append(fact.value_type)

            match input:
                UnmanagedJoinParameter(_): void
                ManagedJoinParameter(_, _): owners = owners.append(fact.value_type)

        for operation in block.operations:
            match operation:
                DefineValue(definition):
                    values = values.append(definition.value_type)

                    match definition.result:
                        OwnedResult(_): owners = owners.append(definition.value_type)
                        _: void
                ExecuteJoin(join):
                    for output in [join.result].concat(join.carried):
                        parameter = output.join_parameter()
                        values = values.append(parameter.value_type)

                        match output:
                            UnmanagedJoinParameter(_): void
                            ManagedJoinParameter(_, _): owners = owners.append(parameter.value_type)

                ExecuteLoop(loop):
                    for output in [loop.result].concat(loop.carried):
                        parameter = output.join_parameter()
                        values = values.append(parameter.value_type)

                        match output:
                            UnmanagedJoinParameter(_): void
                            ManagedJoinParameter(_, _): owners = owners.append(parameter.value_type)

                AcquireOwner(_, borrowed, span):
                    match values.get(borrowed.value.value_number()):
                        Some(value_type):
                            owners = owners.append(value_type)
                        None:
                            failure = Some(render(span, MissingValueType(borrowed.value)))
                            break
                DropOwner(_, _):
                    void

        if failure.is_some():
            break

    match failure:
        Some(error): Err(error)
        None: Ok(owners)


-- DestroyNested drops a child inside a drop helper, whose C parameter `depth`
-- counts the counted releases running below it (RELEASE_RUNTIME).
private fixed union OwnershipAction:
    DuplicateValue
    DestroyValue
    DestroyNested


private pure func append_storage_operation(
    output: String,
    value_type: TypeRef,
    action: OwnershipAction,
    expression: String,
    unions: List[ConcreteUnion],
    span: Span
) -> Result[String, Diagnostic]:
    -- A nested destroy passes the release depth to the child's helper.
    depth = match action:
        DestroyNested: ",depth"
        DuplicateValue | DestroyValue: ""

    -- The helper and the arguments after the value. A String owns no
    -- children, so its release never takes the depth.
    name_result: Result[Option[(String, String)], Diagnostic] = match value_type:
        CallableType(parameters, result):
            prefix = match action:
                DuplicateValue: "blorp_callable_dup_"
                DestroyValue: "blorp_callable_drop_"
                DestroyNested: "blorp_callable_drop_at_"

            Ok(Some((prefix.concat(parameters.callable_suffix(result)), depth)))
        RecordType(id):
            prefix = match action:
                DuplicateValue: "blorp_record_dup_"
                DestroyValue: "blorp_record_drop_"
                DestroyNested: "blorp_record_drop_at_"

            Ok(Some((prefix.append_int(id.record_number()), depth)))
        ListType(element):
            prefix = match action:
                DuplicateValue: "blorp_list_dup_"
                DestroyValue: "blorp_list_drop_"
                DestroyNested: "blorp_list_drop_at_"

            suffix = element
                .list_element_key()
                .list_suffix()

            Ok(Some((prefix.concat(suffix), depth)))
        StringType:
            storage_helper: String = match action:
                DuplicateValue: "blorp_string_retain"
                DestroyValue | DestroyNested: "blorp_string_release"

            Ok(Some((storage_helper, "")))
        UnionType(id):
            match unions.get(id.union_number()):
                Some(layout):
                    union_helper: Option[(String, String)] = match layout:
                        PlainCases(_):
                            None
                        OwningCases(_) | BoxedCases(_):
                            prefix = match action:
                                DuplicateValue: "blorp_union_dup_"
                                DestroyValue: "blorp_union_drop_"
                                DestroyNested: "blorp_union_drop_at_"

                            Some((prefix.append_int(id.union_number()), depth))

                    Ok(union_helper)
                None:
                    Err(render(span, MissingUnionLayout(id)))
        _:
            Ok(None)

    found_name ?= name_result

    operation: String = match found_name:
        Some((name, arguments)): "${output}${name}(${expression}${arguments});"
        None: output

    Ok(operation)


-- An inline union's dup, its nested drop, and its drop at depth 0.
private pure func append_owning_union_ownership(
    output: String,
    layout: ConcreteUnion,
    index: Int,
    unions: List[ConcreteUnion]
) -> Result[String, Diagnostic]:
    value = "struct blorp_u_${index} value"

    duplicated ?= "${output}void blorp_union_dup_${index}(${value}){".append_variant_actions(
        layout,
        index,
        unions,
        DuplicateValue,
        "value."
    )

    nested ?= "${duplicated}}void blorp_union_drop_at_${index}(${value},unsigned depth){(void)depth;".append_variant_actions(
        layout,
        index,
        unions,
        DestroyNested,
        "value."
    )

    drop = top_level_drop(
        "void blorp_union_drop_${index}(${value})",
        "blorp_union_drop_at_${index}"
    )

    Ok("${nested}}${drop}")


-- Each variant's ownership action on its payload fields, for the union whose
-- members `place` reaches: `value.` for an inline union, `value->` for a node.
private pure func append_variant_actions(
    output: String,
    layout: ConcreteUnion,
    index: Int,
    unions: List[ConcreteUnion],
    action: OwnershipAction,
    place: String
) -> Result[String, Diagnostic]:
    var result: Result[String, Diagnostic] = Ok("${output}switch(${place}tag){")
    var position = 0

    for fields in layout.union_variants():
        result = match result:
            Ok(written): Ok("${written}case blorp_v_${index}_${position}:")
            Err(error): Err(error)

        var field_position = 0

        for value_type in fields:
            path = "${place}payload.blorp_up_${position}.blorp_uf_${field_position}"

            result = match result:
                Ok(written):
                    written.append_storage_operation(
                        value_type,
                        action,
                        path,
                        unions,
                        compiler_span()
                    )
                Err(error):
                    Err(error)

            field_position = field_position + 1

        result = match result:
            Ok(written): Ok("${written}break;")
            Err(error): Err(error)

        position = position + 1

    match result:
        Ok(written): Ok("${written}}")
        Err(error): Err(error)


-- One counted node per constructed value: the compound literal's payload
-- already holds acquired children, so the node takes them without retains.
private pure func append_boxed_union_constructor(output: String, index: Int) -> String:
    node = "".append_boxed_union_struct(index)

    "${output}${node}* blorp_union_make_${index}(${node} fields){"
        .concat(
            "${node}* value=blorp_memory_allocate(sizeof *value);if(!value)abort();atomic_init(&value->references,UINT64_C(1));"
        )
        .concat("value->tag=fields.tag;value->payload=fields.payload;return value;}")


private pure func append_boxed_union_retain(output: String, index: Int) -> String:
    node = "".append_boxed_union_struct(index)

    "${output}void blorp_union_dup_${index}(${node}* value){".concat(
        "(void)blorp_record_count_add(&value->references);}"
    )


-- A boxed union is stored by pointer, so any layout may retain and release
-- it before its definition; its tag and helpers are declared up front with
-- the record and List prototypes.
private pure func append_boxed_union_prototypes(
    output: String,
    unions: List[ConcreteUnion]
) -> String:
    var fragments: List[String] = [output]
    var index = 0

    for layout in unions:
        if layout.union_is_boxed():
            node = "".append_boxed_union_struct(index)

            fragments = fragments.append(
                "${node};void blorp_union_dup_${index}(${node}*);".concat(
                    "void blorp_union_drop_${index}(${node}*);void blorp_union_drop_at_${index}(${node}*,unsigned);"
                )
            )

        index = index + 1

    fragments.join("")


-- A node owns a node of its own layout, so every boxed union joins the release
-- scheduler: its release body drops each payload, self children included, at
-- the depth its nested drop passes.
private pure func append_boxed_union_release(
    output: String,
    layout: ConcreteUnion,
    index: Int,
    unions: List[ConcreteUnion]
) -> Result[String, Diagnostic]:
    node = "".append_boxed_union_struct(index)
    release = union_release_name(index)

    body ?= "${output}void ${release}(${node}* value,unsigned depth){".append_variant_actions(
        layout,
        index,
        unions,
        DestroyNested,
        "value->"
    )

    nested = "void blorp_union_drop_at_${index}(${node}* value,unsigned depth){".concat(
        "if(blorp_record_count_subtract(&value->references)!=UINT64_C(1))return;"
    )

    drop = top_level_drop(
        "void blorp_union_drop_${index}(${node}* value)",
        "blorp_union_drop_at_${index}"
    )

    Ok("${body}blorp_memory_release(value);}${nested}${depth_checked_release(release)}${drop}")


private pure func append_union_ownership(
    output: String,
    layout: ConcreteUnion,
    index: Int,
    unions: List[ConcreteUnion]
) -> Result[String, Diagnostic]:
    match layout:
        PlainCases(_):
            Ok(output)
        OwningCases(_):
            output.append_owning_union_ownership(layout, index, unions)
        BoxedCases(_):
            constructed = output.append_boxed_union_constructor(index)

            constructed
                .append_boxed_union_retain(index)
                .append_boxed_union_release(layout, index, unions)


-- Exit destinations are prepared once; nested emission does not need the body.
private record LoopEmissionContext {
    break_parameters: List[own.OwnedJoinParameter],
    recur_parameters: List[own.OwnedJoinParameter],
    target: lower.LoopTarget
}


private pure func append_ownership_operation(
    output: String,
    operation: OwnershipOperation,
    unions: List[ConcreteUnion],
    types: List[TypeRef],
    records: List[ConcreteRecord],
    nearest: Option[LoopEmissionContext]
) -> Result[String, Diagnostic]:
    match operation:
        DefineValue(definition):
            output.append_owned_definition(definition, unions, records)
        ExecuteJoin(matched_join):
            output.append_join(matched_join, unions, types, records, nearest)
        ExecuteLoop(loop):
            output.append_loop(loop, unions, types, records)
        AcquireOwner(owner, borrowed, span):
            match types.get(owner.owner_number()):
                Some(value_type):
                    match output.append_storage_operation(
                        value_type,
                        DuplicateValue,
                        "".append_local_name(borrowed.value),
                        unions,
                        span
                    ):
                        Ok(retained):
                            match owner.owner_alias(borrowed.value, value_type, unions, span):
                                Ok(binding): Ok("${retained}${binding}")
                                Err(error): Err(error)
                        Err(error):
                            Err(error)
                None:
                    Err(render(span, MissingOwnerType(owner)))
        DropOwner(owner, span):
            match types.get(owner.owner_number()):
                Some(value_type):
                    output.append_storage_operation(
                        value_type,
                        DestroyValue,
                        "".append_owner_name(owner),
                        unions,
                        span
                    )
                None:
                    Err(render(span, MissingOwnerType(owner)))


private pure func append_ownership_operations(
    output: String,
    operations: List[OwnershipOperation],
    unions: List[ConcreteUnion],
    types: List[TypeRef],
    records: List[ConcreteRecord],
    nearest: Option[LoopEmissionContext]
) -> Result[String, Diagnostic]:
    operations
        .translated_list(pure func(operation: OwnershipOperation) -> Result[String, Diagnostic]:
            "".append_ownership_operation(operation, unions, types, records, nearest)
        )
        .map(
            pure func(emitted: List[String]) -> String: [output]
                .concat(emitted)
                .join("")
        )


-- Selection labels project existing value and arm identities. A terminal
-- selector's arm path distinguishes nested blocks that introduce no values.
private record SelectionEmissionScope {
    root: ValueId,
    path: List[MatchArmId]
}


private pure func append_selection_scope_name(
    output: String,
    scope: SelectionEmissionScope
) -> String:
    var name = output
        .concat("blorp_selection_")
        .append_int(scope.root.value_number())

    for arm in scope.path:
        name = name
            .concat("_in_")
            .append_int(arm.match_arm_number())

    name


private pure func append_decision_name(
    output: String,
    scope: SelectionEmissionScope,
    node: DecisionNodeId
) -> String:
    output
        .append_selection_scope_name(scope)
        .concat("_node_")
        .append_int(node.decision_node_number())


private pure func append_selection_arm_name(
    output: String,
    scope: SelectionEmissionScope,
    arm: MatchArmId
) -> String:
    output
        .append_selection_scope_name(scope)
        .concat("_arm_")
        .append_int(arm.match_arm_number())


private pure func c_pattern_field(
    parent: ConcretePatternPlace,
    field: specialized.VariantFieldInstanceId,
    scrutinee: ValueId,
    unions: List[ConcreteUnion],
    records: List[ConcreteRecord],
    span: Span
) -> Result[String, Diagnostic]:
    base ?= parent.c_pattern_place(scrutinee, unions, records, span)

    owner = field
        .variant_field_variant()
        .variant_owner()

    layout: ConcreteUnion ?= match unions.get(owner.union_number()):
        Some(found): Ok(found)
        None: Err(render(span, MissingUnionLayout(owner)))

    Ok(
        "(${base})${layout.union_member_selector()}payload.".append_payload_field_name(
            field.variant_field_variant(),
            field.variant_field_number()
        )
    )


private pure func c_pattern_place(
    place: ConcretePatternPlace,
    scrutinee: ValueId,
    unions: List[ConcreteUnion],
    records: List[ConcreteRecord],
    span: Span
) -> Result[String, Diagnostic]:
    match place.route:
        specialized.MatchRoot:
            Ok("".append_local_name(scrutinee))
        specialized.UnionField(parent, field):
            parent.c_pattern_field(field, scrutinee, unions, records, span)
        specialized.RecordField(parent, field):
            place.c_pattern_record_field(parent, field, scrutinee, unions, records, span)
        specialized.ListElement(parent, index):
            match parent.c_pattern_place(scrutinee, unions, records, span):
                Err(error): Err(error)
                Ok(base): Ok("(${base})->values[${index}]")


private pure func c_pattern_record_field(
    place: ConcretePatternPlace,
    parent: ConcretePatternPlace,
    field: FieldInstanceId,
    scrutinee: ValueId,
    unions: List[ConcreteUnion],
    records: List[ConcreteRecord],
    span: Span
) -> Result[String, Diagnostic]:
    base ?= parent.c_pattern_place(scrutinee, unions, records, span)

    layout: ConcreteRecord ?= match records.get(
        field
            .field_owner()
            .record_number()
    ):
        Some(present): Ok(present)
        None: Err(render(span, MissingRecordLayout(field.field_owner())))

    match place.value_type:
        VoidType:
            Ok("0")
        _:
            selector = match layout:
                InlineFields(_) | ValueFields(_): "."
                CountedFields(_): "->"

            Ok("(${base})${selector}".append_field_name(field))


private pure func c_variant_test(
    place: ConcretePatternPlace,
    scrutinee: ValueId,
    variant: VariantInstanceId,
    unions: List[ConcreteUnion],
    records: List[ConcreteRecord],
    span: Span
) -> Result[String, Diagnostic]:
    base ?= place.c_pattern_place(scrutinee, unions, records, span)
    owner = variant.variant_owner()

    layout: ConcreteUnion ?= match unions.get(owner.union_number()):
        Some(found): Ok(found)
        None: Err(render(span, MissingUnionLayout(owner)))

    tag = if layout.has_payload():
        "(${base})${layout.union_member_selector()}tag"
    else:
        base

    Ok(
        tag
            .concat("==")
            .append_variant_name(variant)
    )


private record SelectionEmissionArm {
    id: MatchArmId,
    inputs: List[own.OwnedJoinParameter],
    operations: List[OwnershipOperation],
    ending: String
}


private pure func append_input_declarations(
    output: String,
    inputs: List[own.OwnedJoinParameter],
    unions: List[ConcreteUnion]
) -> Result[String, Diagnostic]:
    var result = output
    var failure: Option[Diagnostic] = None

    for input in inputs:
        fact = input.join_parameter()

        match "".append_local_declaration(fact.value_type, JoinLocal, unions, fact.span):
            Ok(declaration):
                result = result
                    .concat(declaration)
                    .append_local_name(fact.id)
                    .concat(";")
            Err(error):
                failure = Some(error)
                break

    match failure:
        Some(error): Err(error)
        None: Ok(result)


private pure func append_input_owners(
    output: String,
    inputs: List[own.OwnedJoinParameter],
    unions: List[ConcreteUnion]
) -> Result[String, Diagnostic]:
    var result: Result[String, Diagnostic] = Ok(output)

    for input in inputs:
        fact = input.join_parameter()

        result = match result:
            Ok(written):
                declared = written
                    .concat("(void)")
                    .append_local_name(fact.id)
                    .concat(";")

                match input:
                    UnmanagedJoinParameter(_):
                        Ok(declared)
                    ManagedJoinParameter(_, owner):
                        match owner.owner_alias(fact.id, fact.value_type, unions, fact.span):
                            Ok(binding): Ok("${declared}${binding}")
                            Err(error): Err(error)
            Err(error):
                Err(error)

    result


private pure func append_selection_edge(
    output: String,
    scope: SelectionEmissionScope,
    edge: own.OwnedSelectionEdge,
    arms: List[SelectionEmissionArm],
    unions: List[ConcreteUnion],
    types: List[TypeRef],
    records: List[ConcreteRecord],
    nearest: Option[LoopEmissionContext]
) -> Result[String, Diagnostic]:
    arm: SelectionEmissionArm ?= match arms.get(edge.arm.match_arm_number()):
        Some(found): Ok(found)
        None: Err(render(compiler_span(), MissingSelectionArm(scope.root)))

    operations ?= output.append_ownership_operations(
        edge.operations,
        unions,
        types,
        records,
        nearest
    )

    var result = operations
    var position = 0
    var failure: Option[Diagnostic] = None

    for input in arm.inputs:
        fact = input.join_parameter()

        match edge.transfers.get(position):
            Some(transfer):
                result = result
                    .append_local_name(fact.id)
                    .concat("=")
                    .append_transfer_name(transfer)
                    .concat(";")
            None:
                failure = Some(render(fact.span, MissingJoinTransfer(fact.id)))
                break

        position = position + 1

    match failure:
        Some(error):
            Err(error)
        None:
            Ok(
                result
                    .concat("goto ")
                    .append_selection_arm_name(scope, edge.arm)
                    .concat(";")
            )


private pure func c_selection_branch(
    scope: SelectionEmissionScope,
    test: String,
    yes: DecisionNodeId,
    no: DecisionNodeId
) -> String:
    "if("
        .concat(test)
        .concat(")goto ")
        .append_decision_name(scope, yes)
        .concat(";goto ")
        .append_decision_name(scope, no)
        .concat(";")


private pure func append_selection_node(
    scope: SelectionEmissionScope,
    selection: own.OwnedSelection,
    node: own.OwnedDecisionNode,
    arms: List[SelectionEmissionArm],
    unions: List[ConcreteUnion],
    types: List[TypeRef],
    records: List[ConcreteRecord],
    nearest: Option[LoopEmissionContext]
) -> Result[String, Diagnostic]:
    match node:
        own.TestVariant(place, variant, yes, no):
            match place.c_variant_test(
                selection.scrutinee.argument_value(),
                variant,
                unions,
                records,
                compiler_span()
            ):
                Err(error): Err(error)
                Ok(test): Ok(scope.c_selection_branch(test, yes, no))
        own.TestListLength(place, length, yes, no):
            match place.c_pattern_place(
                selection.scrutinee.argument_value(),
                unions,
                records,
                compiler_span()
            ):
                Err(error):
                    Err(error)
                Ok(base):
                    test = match length:
                        ExactLength(count): "(${base})->length==INT64_C(${count})"
                        MinimumLength(count): "(${base})->length>=INT64_C(${count})"

                    Ok(scope.c_selection_branch(test, yes, no))
        own.TestLiteral(place, literal, yes, no):
            match place.c_pattern_place(
                selection.scrutinee.argument_value(),
                unions,
                records,
                compiler_span()
            ):
                Err(error):
                    Err(error)
                Ok(base):
                    match literal:
                        ExactBytes(bytes):
                            -- Each node has its own C scope. Static bytes preserve embedded
                            -- NUL and UTF8, with no String construction during testing.
                            name = "blorp_pattern_bytes"
                            data = "".append_byte_array(name, bytes)
                            test = "(${base})->length==INT64_C(${bytes.length()})&&memcmp((${base})->bytes,${name},(size_t)${bytes.length()})==0"
                            Ok(data.concat(scope.c_selection_branch(test, yes, no)))
                        -- Verification proved that the value fits the place's format, and C
                        -- compares promoted values exactly, so an Int64 constant serves every format.
                        ExactInt(value):
                            Ok(
                                scope.c_selection_branch(
                                    "(${base})==".append_integer(value),
                                    yes,
                                    no
                                )
                            )
        own.EnterArm(edge):
            "".append_selection_edge(scope, edge, arms, unions, types, records, nearest)


private pure func append_selection(
    output: String,
    scope: SelectionEmissionScope,
    selection: own.OwnedSelection,
    arms: List[SelectionEmissionArm],
    unions: List[ConcreteUnion],
    types: List[TypeRef],
    records: List[ConcreteRecord],
    nearest: Option[LoopEmissionContext]
) -> Result[String, Diagnostic]:
    var result = output
    var failure: Option[Diagnostic] = None

    for arm in arms:
        match result.append_input_declarations(arm.inputs, unions):
            Ok(declared):
                result = declared
            Err(error):
                failure = Some(error)
                break

    _: Void ?= match failure:
        Some(error): Err(error)
        None: Ok(void)

    result = result
        .concat("goto ")
        .append_decision_name(scope, selection.entry)
        .concat(";")

    var position = 0

    for node in selection.nodes:
        match scope.append_selection_node(selection, node, arms, unions, types, records, nearest):
            Ok(emitted):
                result = result
                    .append_selection_scope_name(scope)
                    .concat("_node_")
                    .append_int(position)
                    .concat(":{")
                    .concat(emitted)
                    .concat("}")
            Err(error):
                failure = Some(error)
                break

        position = position + 1

    _: Void ?= match failure:
        Some(error): Err(error)
        None: Ok(void)

    for arm in arms:
        match scope.append_selection_body(arm, unions, types, records, nearest):
            Ok(body):
                result = result.concat(body)
            Err(error):
                failure = Some(error)
                break

    match failure:
        Some(error): Err(error)
        None: Ok(result)


private pure func append_selection_body(
    scope: SelectionEmissionScope,
    arm: SelectionEmissionArm,
    unions: List[ConcreteUnion],
    types: List[TypeRef],
    records: List[ConcreteRecord],
    nearest: Option[LoopEmissionContext]
) -> Result[String, Diagnostic]:
    opening = ""
        .append_selection_arm_name(scope, arm.id)
        .concat(":{")

    inputs ?= opening.append_input_owners(arm.inputs, unions)
    body ?= inputs.append_ownership_operations(arm.operations, unions, types, records, nearest)
    Ok("${body}${arm.ending}}")


-- Capture the complete outgoing batch before assigning any destination. The
-- producer has already acquired or moved every owned occurrence and retired
-- old owners.
private pure func append_loop_exit(
    output: String,
    exit: own.OwnedLoopExit,
    context: LoopEmissionContext,
    unions: List[ConcreteUnion]
) -> Result[String, Diagnostic]:
    parameters = match exit:
        own.Break(_): context.break_parameters
        own.Recur(_, _): context.recur_parameters

    transfers = match exit:
        own.Break(outputs): [outputs.value].concat(outputs.carried)
        own.Recur(arguments, _): arguments

    var result = output
    var position = 0
    var failure: Option[Diagnostic] = None

    for parameter in parameters:
        fact = parameter.join_parameter()

        match transfers.get(position):
            None:
                failure = Some(render(fact.span, MissingJoinTransfer(fact.id)))
                break
            Some(transfer):
                match "".append_local_declaration(
                    fact.value_type,
                    InitializedLocal,
                    unions,
                    fact.span
                ):
                    Err(error):
                        failure = Some(error)
                        break
                    Ok(declaration):
                        result = result
                            .concat(declaration)
                            .append_loop_transfer_name(context.target, position)
                            .concat("=")
                            .append_transfer_name(transfer)
                            .concat(";")

        position = position + 1

    _: Void ?= match failure:
        Some(error): Err(error)
        None: Ok(void)

    position = 0

    for parameter in parameters:
        fact = parameter.join_parameter()

        named = match exit:
            own.Break(_): result.append_local_name(fact.id)
            own.Recur(_, _): result.concat(fact.id.c_header())

        result = named
            .concat("=")
            .append_loop_transfer_name(context.target, position)
            .concat(";")

        position = position + 1

    label = match exit:
        own.Break(_): context.target.c_loop_break()
        own.Recur(_, _): context.target.c_loop_header()

    Ok("${result}goto ${label};")


private pure func append_loop_block(
    output: String,
    block: own.OwnedLoopBlock,
    context: LoopEmissionContext,
    scope: SelectionEmissionScope,
    unions: List[ConcreteUnion],
    types: List[TypeRef],
    records: List[ConcreteRecord]
) -> Result[String, Diagnostic]:
    body ?= output.append_ownership_operations(
        block.operations,
        unions,
        types,
        records,
        Some(context)
    )

    body.append_loop_tail(block.tail, context, scope, unions, types, records)


private pure func append_loop_tail(
    output: String,
    tail: own.OwnedLoopTail,
    context: LoopEmissionContext,
    scope: SelectionEmissionScope,
    unions: List[ConcreteUnion],
    types: List[TypeRef],
    records: List[ConcreteRecord]
) -> Result[String, Diagnostic]:
    match tail:
        own.ExitLoop(exit):
            output.append_loop_exit(exit, context, unions)
        own.MatchLoop(matched):
            output.append_loop_match(matched, context, scope, unions, types, records)


private pure func append_loop_match(
    output: String,
    matched: own.OwnedLoopMatch,
    context: LoopEmissionContext,
    scope: SelectionEmissionScope,
    unions: List[ConcreteUnion],
    types: List[TypeRef],
    records: List[ConcreteRecord]
) -> Result[String, Diagnostic]:
    var arms: List[SelectionEmissionArm] = []
    var failure: Option[Diagnostic] = None

    for arm in matched.arms:
        child = { scope | path = scope.path.append(arm.id) }

        match "".append_loop_block(arm.body, context, child, unions, types, records):
            Err(error):
                failure = Some(error)
                break
            Ok(ending):
                arms = arms.append({
                    id = arm.id,
                    inputs = arm.inputs,
                    operations = [],
                    ending = ending
                })

    _: Void ?= match failure:
        Some(error): Err(error)
        None: Ok(void)

    output.append_selection(scope, matched.selection, arms, unions, types, records, Some(context))


private pure func append_loop(
    output: String,
    loop: own.OwnedLoop,
    unions: List[ConcreteUnion],
    types: List[TypeRef],
    records: List[ConcreteRecord]
) -> Result[String, Diagnostic]:
    parameters = [loop.result].concat(loop.carried)
    output_declarations ?= "".append_input_declarations(parameters, unions)
    var declarations = output_declarations
    var snapshots = ""
    var failure: Option[Diagnostic] = None

    for header in loop.headers:
        fact = header.parameter.join_parameter()

        match "".append_local_declaration(fact.value_type, JoinLocal, unions, fact.span):
            Err(error):
                failure = Some(error)
                break
            Ok(declaration):
                declarations = declarations
                    .concat(declaration)
                    .concat(fact.id.c_header())
                    .concat("=")
                    .append_transfer_name(header.initial)
                    .concat(";")

                match "".append_local_declaration(
                    fact.value_type,
                    InitializedLocal,
                    unions,
                    fact.span
                ):
                    Err(error):
                        failure = Some(error)
                        break
                    Ok(snapshot):
                        snapshots = snapshots
                            .concat(snapshot)
                            .append_local_name(fact.id)
                            .concat("=")
                            .concat(fact.id.c_header())
                            .concat(";(void)")
                            .append_local_name(fact.id)
                            .concat(";")

                match header.parameter:
                    UnmanagedJoinParameter(_):
                        void
                    ManagedJoinParameter(_, owner):
                        match owner.owner_alias(fact.id, fact.value_type, unions, fact.span):
                            Ok(binding):
                                snapshots = "${snapshots}${binding}"
                            Err(error):
                                failure = Some(error)
                                break

    _: Void ?= match failure:
        Some(error): Err(error)
        None: Ok(void)

    scope: SelectionEmissionScope = { root = loop.result.join_parameter().id, path = [] }

    context: LoopEmissionContext = {
        break_parameters = parameters,
        recur_parameters = loop.headers.map(pure func(header): header.parameter),
        target = lower.loop_target(scope.root)
    }

    var entered = output

    for acquisition in loop.entry_acquisitions:
        match entered.append_ownership_operation(
            AcquireOwner(acquisition.owner, acquisition.borrow, loop.result.join_parameter().span),
            unions,
            types,
            records,
            None
        ):
            Ok(acquired):
                entered = acquired
            Err(error):
                failure = Some(error)
                break

    _: Void ?= match failure:
        Some(error): Err(error)
        None: Ok(void)

    -- Acquisitions precede header initialization, which may move their aliases.
    declared = entered.concat(declarations)
    body ?= snapshots.append_loop_block(loop.body, context, scope, unions, types, records)

    -- Both labels have lexical uses even for a loop with only one exit kind.
    -- A sealed body always transfers before the final, unreachable goto.
    completed = "${declared}goto ${context.target.c_loop_header()};${context.target.c_loop_header()}:{${body}}".concat(
        "goto ${context.target.c_loop_break()};${context.target.c_loop_break()}:;"
    )

    completed.append_input_owners(parameters, unions)


-- Verified ordinary joins have a yielding continuation. Abrupt arms transfer
-- directly to their typed loop target through the same selection emitter.
private pure func append_join(
    output: String,
    matched_join: OwnedJoin,
    unions: List[ConcreteUnion],
    types: List[TypeRef],
    records: List[ConcreteRecord],
    nearest: Option[LoopEmissionContext]
) -> Result[String, Diagnostic]:
    parameter = matched_join.result.join_parameter()
    parameters = [matched_join.result].concat(matched_join.carried)
    var declarations = output
    var failure: Option[Diagnostic] = None

    for output_parameter in parameters:
        fact = output_parameter.join_parameter()

        match "".append_local_declaration(fact.value_type, JoinLocal, unions, fact.span):
            Err(error):
                failure = Some(error)
                break
            Ok(declaration):
                declarations = declarations
                    .concat(declaration)
                    .append_local_name(fact.id)
                    .concat(";")

    _: Void ?= match failure:
        Some(error): Err(error)
        None: Ok(void)

    scope: SelectionEmissionScope = { root = parameter.id, path = [] }

    done = ""
        .append_selection_scope_name(scope)
        .concat("_done")

    var arms: List[SelectionEmissionArm] = []

    for arm in matched_join.arms:
        ending: Result[String, Diagnostic] = match arm.exit:
            own.TransferLoop(target, exit):
                match nearest:
                    None:
                        Err(
                            render(
                                parameter.span,
                                MissingEnclosingLoop(target.loop_target_value())
                            )
                        )
                    Some(context):
                        "".append_loop_tail(
                            exit,
                            context,
                            { root = scope.root, path = scope.path.append(arm.id) },
                            unions,
                            types,
                            records
                        )
            own.Yield(outputs):
                var transferred = ""
                    .append_local_name(parameter.id)
                    .concat("=")
                    .append_transfer_name(outputs.transfer)
                    .concat(";")

                var position = 0

                for output_parameter in matched_join.carried:
                    fact = output_parameter.join_parameter()

                    match outputs.carried.get(position):
                        None:
                            failure = Some(render(fact.span, MissingJoinTransfer(fact.id)))
                            break
                        Some(transfer):
                            transferred = transferred
                                .append_local_name(fact.id)
                                .concat("=")
                                .append_transfer_name(transfer)
                                .concat(";")

                    position = position + 1

                match failure:
                    Some(error): Err(error)
                    None: Ok("${transferred}goto ${done};")

        match ending:
            Err(error):
                failure = Some(error)
                break
            Ok(exit):
                arms = arms.append({
                    id = arm.id,
                    inputs = arm.inputs,
                    operations = arm.operations,
                    ending = exit
                })

    _: Void ?= match failure:
        Some(error): Err(error)
        None: Ok(void)

    selected ?= declarations.append_selection(
        scope,
        matched_join.selection,
        arms,
        unions,
        types,
        records,
        nearest
    )

    -- Every output is named, Void and unused ones included, exactly as an arm
    -- input is.
    "${selected}${done}:;".append_input_owners(parameters, unions)


private pure func append_signature(
    output: String,
    function: OwnedFunction,
    index: Int,
    unions: List[ConcreteUnion]
) -> Result[String, Diagnostic]:
    typed ?= output.append_type_name(function.return_type, unions, compiler_span())

    parameters ?= function.parameters
        .map(parameter_type)
        .c_parameters(unions)

    Ok(
        typed
            .concat(" ")
            .concat(index.c_name())
            .concat(parameters)
    )


private pure func append_transfer_name(output: String, result: ReturnTransfer) -> String:
    match result:
        UnmanagedReturn(id): output.append_local_name(id)
        OwnedReturn(_, owner): output.append_owner_name(owner)


private pure func append_stored_name(output: String, payload: StoredPayload) -> String:
    match payload:
        UnmanagedPayload(value): output.append_local_name(value)
        OwnedPayload(_, owner): output.append_owner_name(owner)


private pure func append_return(output: String, result: ReturnTransfer) -> String:
    output
        .concat("return ")
        .append_transfer_name(result)
        .concat(";")


private pure func append_function(
    function: OwnedFunction,
    index: Int,
    unions: List[ConcreteUnion],
    records: List[ConcreteRecord]
) -> Result[String, Diagnostic]:
    header ?= "".append_signature(function, index, unions)
    types ?= function.owner_types()
    body ?= "".append_ownership_operations(function.operations, unions, types, records, None)

    -- The comment names the source function in profiles of the generated program.
    Ok(
        [
            "/* ",
            function.label.label_text(),
            " */ ",
            header,
            "{",
            body,
            "".append_return(function.result),
            "}"
        ].join("")
    )


-- Unsigned addition wraps. Both signed casts below receive representable values;
-- the negative branch also stays within Int64 at UINT64_MAX - sum == INT64_MAX.
INTEGER_ADD_RUNTIME: String =
    |static int64_t blorp_int_add(int64_t first,int64_t second){uint64_t sum=(uint64_t)first+(uint64_t)second;return sum<=INT64_MAX?(int64_t)sum:-INT64_C(1)-(int64_t)(UINT64_MAX-sum);}
    |


-- Convert wrapped unsigned bits using only representable signed casts. Division
-- and remainder guard both zero and the sole overflowing signed quotient.
INTEGER_ARITHMETIC_RUNTIME: String =
    |int64_t blorp_int_signed(uint64_t value){return value<=INT64_MAX?(int64_t)value:-INT64_C(1)-(int64_t)(UINT64_MAX-value);}
    |int64_t blorp_int_subtract(int64_t first,int64_t second){return blorp_int_signed((uint64_t)first-(uint64_t)second);}
    |int64_t blorp_int_multiply(int64_t first,int64_t second){return blorp_int_signed((uint64_t)first*(uint64_t)second);}
    |int64_t blorp_int_divide(int64_t first,int64_t second){if(second==0)return 0;if(first==INT64_MIN&&second==-1)return INT64_MIN;return first/second;}
    |int64_t blorp_int_remainder(int64_t first,int64_t second){if(second==0||(first==INT64_MIN&&second==-1))return 0;return first%second;}
    |


-- Requires INTEGER_ARITHMETIC_RUNTIME's blorp_int_signed. C defines &, | and ^ on
-- int64_t's two's complement bits; a shift runs on the unsigned bits, since
-- shifting a negative int64_t left is undefined, and only for a count C defines.
INTEGER_BITS_RUNTIME: String =
    |enum {BLORP_INT_BITS=64};
    |int64_t blorp_int_bit_and(int64_t first,int64_t second){return first&second;}
    |int64_t blorp_int_bit_or(int64_t first,int64_t second){return first|second;}
    |int64_t blorp_int_bit_xor(int64_t first,int64_t second){return first^second;}
    |int64_t blorp_int_shift_left(int64_t value,int64_t count){return count<0||count>=BLORP_INT_BITS?0:blorp_int_signed((uint64_t)value<<count);}
    |int64_t blorp_int_shift_right(int64_t value,int64_t count){return count<0||count>=BLORP_INT_BITS?0:blorp_int_signed((uint64_t)value>>count);}
    |


private pure func bitwise_c_function(operation: BitwiseOperation) -> String:
    match operation:
        BitAnd: "blorp_int_bit_and"
        BitOr: "blorp_int_bit_or"
        BitXor: "blorp_int_bit_xor"
        ShiftLeft: "blorp_int_shift_left"
        ShiftRight: "blorp_int_shift_right"


-- Unsigned int holds every intermediate result, so nothing overflows, and the
-- conversion back to uint8_t keeps it modulo 256. Division and remainder by
-- zero give 0. A program may call only some, so they have external linkage.
UINT8_ARITHMETIC_RUNTIME: String =
    |uint8_t blorp_uint8_add(uint8_t first,uint8_t second){return (uint8_t)((unsigned)first+(unsigned)second);}
    |uint8_t blorp_uint8_subtract(uint8_t first,uint8_t second){return (uint8_t)((unsigned)first-(unsigned)second);}
    |uint8_t blorp_uint8_multiply(uint8_t first,uint8_t second){return (uint8_t)((unsigned)first*(unsigned)second);}
    |uint8_t blorp_uint8_divide(uint8_t first,uint8_t second){return second==0?0:(uint8_t)(first/second);}
    |uint8_t blorp_uint8_remainder(uint8_t first,uint8_t second){return second==0?0:(uint8_t)(first%second);}
    |


-- The type under any List layers. A String or Float there, anywhere in a record,
-- union or function that specialization kept, selects its ABI prelude even when
-- no value of it is ever built: a phantom type argument keeps its record
-- (blorp/test/test_compile/fixtures/record/phantom_union_fields.brp).
private pure func innermost_element(value_type: TypeRef) -> TypeRef:
    match value_type:
        ListType(element): element.innermost_element()
        _: value_type


-- The scalar helper preludes a program selects, read from its inventory: a
-- String or Float type selects its ABI prelude, and each runtime operation called
-- selects its own helper. Allocation headers follow from the layouts and the
-- argument vector from the entrypoint, which already own those facts.
private fixed record RuntimeRequirements {
    string_types: Bool,
    float_types: Bool,
    integer_addition: Bool,
    integer_arithmetic: Bool,
    integer_bits: Bool,
    uint8_arithmetic: Bool,
    string_output: Bool,
    string_error_output: Bool,
    integer_parsing: Bool,
    string_equality: Bool,
    string_concatenation: Bool,
    string_integer_appending: Bool,
    string_slicing: Bool,
    string_to_bytes: Bool,
    bytes_to_text: Bool,
    float_formatting: Bool,
    float_parsing: Bool,
    thread_pool: Bool,
    range_splitter: Bool
}


private pure func runtime_requirements(inventory: ProgramInventory) -> RuntimeRequirements:
    var requirements: RuntimeRequirements = {
        string_types = False,
        float_types = False,
        integer_addition = False,
        integer_arithmetic = False,
        integer_bits = False,
        uint8_arithmetic = False,
        string_output = False,
        string_error_output = False,
        integer_parsing = False,
        string_equality = False,
        string_concatenation = False,
        string_integer_appending = False,
        string_slicing = False,
        string_to_bytes = False,
        bytes_to_text = False,
        float_formatting = False,
        float_parsing = False,
        thread_pool = inventory.pool_jobs
            .is_empty()
            .not(),
        range_splitter = inventory.pool_jobs.any(pure func(job: PoolJob) -> Bool:
            match job:
                MapJob(_): True
                JoinJob(_): False
        )
    }

    for value_type in inventory.types:
        match value_type.innermost_element():
            StringType: requirements = { requirements | string_types = True }
            FloatType: requirements = { requirements | float_types = True }
            _: void

    for operation in inventory.runtime_calls:
        match operation:
            IntegerAdd(Int64Format):
                requirements = { requirements | integer_addition = True }
            IntegerSubtract(Int64Format) | IntegerMultiply(Int64Format) | IntegerDivide(Int64Format) | IntegerRemainder(Int64Format):
                requirements = { requirements | integer_arithmetic = True }
            IntegerBitwise(_):
                requirements = { requirements | integer_arithmetic = True, integer_bits = True }
            IntegerAdd(UInt8Format) | IntegerSubtract(UInt8Format) | IntegerMultiply(UInt8Format) | IntegerDivide(UInt8Format) | IntegerRemainder(UInt8Format):
                requirements = { requirements | uint8_arithmetic = True }
            StringPrint:
                requirements = { requirements | string_output = True }
            StringPrintError:
                requirements = { requirements | string_error_output = True }
            StringParseInt(_):
                requirements = { requirements | integer_parsing = True }
            StringEquals(_):
                requirements = { requirements | string_equality = True }
            StringConcat:
                requirements = { requirements | string_concatenation = True }
            StringAppendInt:
                requirements = { requirements | string_integer_appending = True }
            StringSlice(_) | StringByteSlice(_) | StringCodepointSlice:
                requirements = { requirements | string_slicing = True }
            StringToBytes:
                requirements = { requirements | string_to_bytes = True }
            BytesToText(_):
                requirements = { requirements | bytes_to_text = True }
            FloatToString:
                requirements = { requirements | float_formatting = True }
            StringParseFloat(_):
                requirements = { requirements | float_parsing = True }
            ListRepeat(_) | ListLength(_) | ListGet(_, _) | ListAppend(_) | ListSet(_) | ListConcat(_):
                void
            IntegerToString(_) | IntegerEquals(_, _) | IntegerLessThan(_, _) | IntegerConvert(_, _) | FloatAdd | FloatSubtract | FloatMultiply | FloatDivide | FloatRemainder | StringLength | StringByteLength | StringCodepointLength | StringByteAtUInt8(_) | StringCodepointAt(_) | StringFromCodepoint(_):
                void
            -- Specialization turns join into a JoinTasks call, and a parallel
            -- map into a MapElements one: see pool_jobs.
            FloatCopySign | FloatEquals(_) | FloatLessThan(_) | ConcurrencyJoin(_) | ConcurrencyParallelMap(_):
                void
            -- Each takes or returns a Float, which selects FLOAT_RUNTIME: math.h and
            -- the two conversions.
            FloatUnary(_) | FloatBinary(_) | FloatToInt | IntToFloat:
                void
            -- Shared system helpers name String storage even when the selected
            -- operation has only Int or byte-list parameters and results.
            SystemCall(_, _):
                requirements = { requirements | string_types = True }

    requirements


-- Each system operation the program calls, once, in first-call order; each
-- selects its own runtime fragment.
private pure func system_calls(inventory: ProgramInventory) -> List[SystemOperation]:
    var calls: List[SystemOperation] = []

    for operation in inventory.runtime_calls:
        match operation:
            SystemCall(system, _):
                if (
                    calls
                        .contains(system)
                        .not()
                ):
                    calls = calls.append(system)
            _:
                void

    calls


-- This table lives for one emission only. Its complete key is a projection
-- of concrete TypeRefs, not an ownership or layout authority. Stable sorting
-- and adjacent key equality avoid scanning existing helpers at each occurrence.
private record ListLayout {
    element: TypeRef,
    key: ListElementKey
}


private pure func strip_list_layer(value_type: TypeRef) -> TypeRef:
    match value_type:
        ListType(element): element
        _: value_type


private pure func element_list_layouts(element: TypeRef) -> List[ListLayout]:
    var current = element
    var key = element.list_element_key()
    var remaining = key.list_key_depth()
    var layouts: List[ListLayout] = []
    layouts = layouts.append({ element = current, key = key })

    while remaining > 0:
        current = current.strip_list_layer()
        key = key.list_child_key()
        remaining = remaining - 1
        layouts = layouts.append({ element = current, key = key })

    layouts


private pure func type_list_layouts(value_type: TypeRef) -> List[ListLayout]:
    match value_type:
        ListType(element): element.element_list_layouts()
        _: []


-- One transient traversal item. H has no synthetic value definition, so its
-- types enter the value projection when this child interval is visited.
private record EmissionBlock {
    headers: List[own.OwnedLoopHeader],
    inputs: List[own.OwnedJoinParameter],
    operations: List[OwnershipOperation]
}


private pure func function_blocks(function: OwnedFunction) -> List[EmissionBlock]:
    append_block([], function.operations, [], [])


private pure func append_selection_blocks(
    blocks: List[EmissionBlock],
    selection: own.OwnedSelection
) -> List[EmissionBlock]:
    var collected = blocks

    for node in selection.nodes:
        match node:
            own.TestVariant(_, _, _, _) | own.TestListLength(_, _, _, _) | own.TestLiteral(_, _, _, _):
                void
            own.EnterArm(edge):
                collected = collected.append_block(edge.operations, [], [])

    collected


private pure func append_loop_blocks(
    blocks: List[EmissionBlock],
    block: own.OwnedLoopBlock,
    headers: List[own.OwnedLoopHeader],
    inputs: List[own.OwnedJoinParameter]
) -> List[EmissionBlock]:
    blocks
        .append_block(block.operations, headers, inputs)
        .append_loop_tail_blocks(block.tail)


private pure func append_loop_tail_blocks(
    blocks: List[EmissionBlock],
    tail: own.OwnedLoopTail
) -> List[EmissionBlock]:
    var collected = blocks

    match tail:
        own.ExitLoop(_):
            void
        own.MatchLoop(matched):
            collected = collected.append_selection_blocks(matched.selection)

            for arm in matched.arms:
                collected = collected.append_loop_blocks(arm.body, [], arm.inputs)

    collected


private pure func append_block(
    blocks: List[EmissionBlock],
    operations: List[OwnershipOperation],
    headers: List[own.OwnedLoopHeader],
    inputs: List[own.OwnedJoinParameter]
) -> List[EmissionBlock]:
    var collected: List[EmissionBlock] = blocks.append({
        headers = headers,
        inputs = inputs,
        operations = operations
    })

    for operation in operations:
        match operation:
            ExecuteJoin(join):
                collected = collected.append_selection_blocks(join.selection)

                for arm in join.arms:
                    collected = collected.append_block(arm.operations, [], arm.inputs)

                    match arm.exit:
                        own.Yield(_):
                            void
                        own.TransferLoop(_, tail):
                            collected = collected.append_loop_tail_blocks(tail)
            ExecuteLoop(loop):
                acquisitions: List[OwnershipOperation] = loop.entry_acquisitions.map(
                    pure func(acquisition):
                        AcquireOwner(
                            acquisition.owner,
                            acquisition.borrow,
                            loop.result.join_parameter().span
                        )
                )

                collected = collected.append_block(acquisitions, [], [])
                collected = collected.append_loop_blocks(loop.body, loop.headers, [])
            DefineValue(_) | AcquireOwner(_, _, _) | DropOwner(_, _):
                void

    collected


-- What emission inventories, found in one walk of the verified program: the
-- type of every declared field and payload and of every defined value, and
-- every runtime operation called. The list layouts read the types, the list
-- update helpers read the calls and the runtime requirements read both, so none
-- of them walks the program again. A signature type needs no entry of its own
-- because the verifier ties it to a defined value: a parameter's definition
-- takes its type from the signature, a call result must match the callee's
-- return type, and the returned value must match the function's. The callable
-- types are found once here: the callables the extended `types` adds are
-- parameters and results of ones already found, so they add no new entry.
private record ProgramInventory {
    types: List[TypeRef],
    callable_types: List[TypeRef],
    runtime_calls: List[RuntimeOperation[VariantInstanceId, TypeRef]],
    list_updates: List[ListUpdateHelper],
    callable_entries: List[CallableEntry],
    -- Each job the pool runs, once, in the walk's order: one list, since the
    -- walk's loop dups and drops every list it carries once per operation.
    pool_jobs: List[PoolJob]
}


-- A job the thread pool runs: a join's tasks, with two trampolines, or a
-- parallel map's callback, with a piece and a run function.
private union PoolJob:
    JoinJob(TaskJoin)
    MapJob(MapCallback)


-- `entries` with `entry`, unless one already runs its instance at its type.
private pure func with_entry(
    entries: List[CallableEntry],
    entry: CallableEntry
) -> List[CallableEntry]:
    duplicate = entries.any(pure func(previous):
        (previous.body == entry.body).and(previous.value_type == entry.value_type)
    )

    if duplicate:
        entries
    else:
        entries.append(entry)


private pure func program_inventory(program: OwnershipProgram) -> ProgramInventory:
    var types: List[TypeRef] = []
    var runtime_calls: List[RuntimeOperation[VariantInstanceId, TypeRef]] = []
    var list_updates: List[ListUpdateHelper] = []
    var callable_entries: List[CallableEntry] = []
    var pool_jobs: List[PoolJob] = []

    for layout in program.records:
        for field in layout.record_fields():
            types = types.append(field)

    for layout in program.unions:
        for fields in layout.union_variants():
            for value_type in fields:
                types = types.append(value_type)

    for function in program.functions:
        for block in function.function_blocks():
            for header in block.headers:
                types = types.append(header.parameter.join_parameter().value_type)

            for input in block.inputs:
                types = types.append(input.join_parameter().value_type)

            for operation in block.operations:
                match operation:
                    DefineValue(definition):
                        types = types.append(definition.value_type)

                        -- Matched apart, as a pair would be a cell for every definition.
                        entry: Option[CallableEntry] = match definition.operation:
                            FreeCallableDefinition(id):
                                Some({
                                    body = id,
                                    value_type = definition.value_type,
                                    captures = False
                                })
                            CapturedCallableDefinition(id, _):
                                Some({
                                    body = id,
                                    value_type = definition.value_type,
                                    captures = True
                                })
                            _:
                                None

                        match entry:
                            Some(found): callable_entries = callable_entries.with_entry(found)
                            None: void

                        match definition.operation:
                            CallDefinition(target, _):
                                match target:
                                    RuntimeFunction(runtime):
                                        runtime_calls = runtime_calls.append(runtime)

                                        match runtime.call_list_update():
                                            Some(helper): list_updates = list_updates.append(helper)
                                            None: void
                                    JoinTasks(tasks):
                                        if (
                                            pool_jobs
                                                .contains(JoinJob(tasks))
                                                .not()
                                        ):
                                            pool_jobs = pool_jobs.append(JoinJob(tasks))
                                    MapElements(callback):
                                        if (
                                            pool_jobs
                                                .contains(MapJob(callback))
                                                .not()
                                        ):
                                            pool_jobs = pool_jobs.append(MapJob(callback))
                                    UserFunction(_):
                                        void
                            ListSuffixDefinition(_, _):
                                match definition.value_type:
                                    ListType(element):
                                        list_updates = list_updates.append(
                                            SuffixUpdate.update_helper(element)
                                        )
                                    _:
                                        void
                            _:
                                void
                    ExecuteJoin(join):
                        for output in [join.result].concat(join.carried):
                            types = types.append(output.join_parameter().value_type)
                    ExecuteLoop(loop):
                        for output in [loop.result].concat(loop.carried):
                            types = types.append(output.join_parameter().value_type)
                    AcquireOwner(_, _, _) | DropOwner(_, _):
                        void

    callables = types.callable_types()

    for value in callables:
        match value:
            CallableType(parameters, result):
                types = types
                    .concat(parameters)
                    .append(result)
            _:
                void

    {
        types = types,
        callable_types = callables,
        runtime_calls = runtime_calls,
        list_updates = list_updates,
        callable_entries = callable_entries,
        pool_jobs = pool_jobs
    }


private pure func list_layouts(inventory: ProgramInventory) -> List[ListLayout]:
    var layouts: List[ListLayout] = []

    for value_type in inventory.types:
        for layout in value_type.type_list_layouts():
            layouts = layouts.append(layout)

    ordered = layouts
        .sort_by(pure func(layout): layout.key.list_key_ordinal())
        .sort_by(pure func(layout): layout.key.list_key_rank())
        .sort_by(pure func(layout): layout.key.list_key_depth())

    var unique: List[ListLayout] = []
    var previous: Option[ListElementKey] = None

    for layout in ordered:
        duplicate = if layout.key.list_key_is_callable():
            -- Structural signatures share the non-nominal sort ordinal; use the
            -- complete typed key, including nonadjacent equal signatures.
            unique.any(pure func(other): other.key == layout.key)
        else:
            match previous:
                Some(key): key == layout.key
                None: False

        if duplicate.not():
            unique = unique.append(layout)
            previous = Some(layout.key)

    unique


-- An update helper is emitted only where its operation is called. The
-- helper list is deduplicated by scanning its own entries: there are at most
-- four per element layout, so the scan stays small for any call count.
private record ListUpdateHelper {
    update: ListUpdate,
    layout: ListLayout
}


private pure func update_helper(update: ListUpdate, element: TypeRef) -> ListUpdateHelper:
    { update = update, layout = { element = element, key = element.list_element_key() } }


private pure func call_list_update(
    operation: RuntimeOperation[VariantInstanceId, TypeRef]
) -> Option[ListUpdateHelper]:
    match operation:
        ListAppend(element): Some(AppendUpdate.update_helper(element))
        ListSet(element): Some(SetUpdate.update_helper(element))
        ListConcat(element): Some(ConcatUpdate.update_helper(element))
        _: None


private pure func list_update_helpers(inventory: ProgramInventory) -> List[ListUpdateHelper]:
    var unique: List[ListUpdateHelper] = []

    for helper in inventory.list_updates:
        var known: Bool = False

        for existing in unique:
            match existing.update == helper.update:
                False:
                    void
                True:
                    if existing.layout.key == helper.layout.key:
                        known = True
                        break

        match known:
            True: void
            False: unique = unique.append(helper)

    unique


private pure func append_list_prototypes(output: String, layouts: List[ListLayout]) -> String:
    if layouts.is_empty():
        output
    else:
        var fragments: List[String] = [output]

        for layout in layouts:
            suffix = layout.key.list_suffix()
            type_name = layout.key.list_c_type()

            fragment = "struct blorp_l_${suffix};void blorp_list_dup_${suffix}(${type_name});void blorp_list_drop_${suffix}(${type_name});".concat(
                "void blorp_list_drop_at_${suffix}(${type_name},unsigned);"
            )

            fragments = fragments.append(fragment)

        fragments.join("")


-- The element C type and the stored-occurrence fragments every helper of one
-- List layout stores and destroys through; `nested_destroy` destroys an
-- element inside the layout's release body, at its `depth`.
private record ElementFragments {
    type_name: String,
    acquire: String,
    destroy: String,
    nested_destroy: String
}


private pure func element_fragments(
    layout: ListLayout,
    unions: List[ConcreteUnion],
    records: List[ConcreteRecord]
) -> Result[ElementFragments, Diagnostic]:
    -- Nested helpers use the precomputed suffix key. Rewalking the TypeRef at
    -- every suffix would make a single deeply nested List require quadratic work.
    if layout.key.list_key_depth() > 0:
        child = layout.key.list_child_key()
        suffix = child.list_suffix()

        Ok({
            type_name = child.list_c_type(),
            acquire = "blorp_list_dup_${suffix}(element);",
            destroy = "blorp_list_drop_${suffix}(element);",
            nested_destroy = "blorp_list_drop_at_${suffix}(element,depth);"
        })
    else:
        layout.element.terminal_element_fragments(unions, records)


private pure func terminal_element_fragments(
    element: TypeRef,
    unions: List[ConcreteUnion],
    records: List[ConcreteRecord]
) -> Result[ElementFragments, Diagnostic]:
    type_name ?= "".append_type_name(element, unions, compiler_span())
    needs_owner ?= element.value_needs_ownership(unions, records)

    acquire: String ?= match needs_owner:
        False:
            Ok("")
        True:
            "".append_storage_operation(element, DuplicateValue, "element", unions, compiler_span())

    destroy: String ?= match needs_owner:
        False: Ok("")
        True: "".append_storage_operation(element, DestroyValue, "element", unions, compiler_span())

    nested_destroy: String ?= match needs_owner:
        False:
            Ok("")
        True:
            "".append_storage_operation(element, DestroyNested, "element", unions, compiler_span())

    Ok({
        type_name = type_name,
        acquire = acquire,
        destroy = destroy,
        nested_destroy = nested_destroy
    })


private pure func list_runtime_fragment(
    layout: ListLayout,
    unions: List[ConcreteUnion],
    records: List[ConcreteRecord]
) -> Result[String, Diagnostic]:
    element ?= layout.element_fragments(unions, records)
    joins ?= layout.list_joins_release(unions, records)

    release: Option[String] = if joins:
        Some(element.nested_destroy)
    else:
        None

    Ok(layout.key.list_runtime(element.type_name, element.acquire, element.destroy, release))


private pure func append_list_updates(
    output: String,
    helpers: List[ListUpdateHelper],
    unions: List[ConcreteUnion],
    records: List[ConcreteRecord]
) -> Result[String, Diagnostic]:
    if helpers.is_empty():
        Ok(output)
    else:
        var fragments: List[String] = [output]
        var failure: Option[Diagnostic] = None

        -- At most four helpers share one layout, so recomputing its few
        -- fragments costs less than keying them from the layout table.
        for helper in helpers:
            match helper.layout.element_fragments(unions, records):
                Err(error):
                    failure = Some(error)
                    break
                Ok(element):
                    fragments = fragments.append(
                        helper.update.list_update_runtime(
                            helper.layout.element,
                            element.type_name,
                            element.acquire,
                            element.destroy
                        )
                    )

        match failure:
            Some(error): Err(error)
            None: Ok(fragments.join("\n"))


private pure func append_list_runtime(
    output: String,
    layouts: List[ListLayout],
    unions: List[ConcreteUnion],
    records: List[ConcreteRecord]
) -> Result[String, Diagnostic]:
    if layouts.is_empty():
        Ok(output)
    else:
        layouts
            .translated_list(pure func(layout: ListLayout) -> Result[String, Diagnostic]:
                layout.list_runtime_fragment(unions, records)
            )
            .map(pure func(completed: List[String]) -> String:
                [output, LIST_SHARED_RUNTIME]
                    .concat(completed)
                    .join("\n")
            )


-- Whether releasing a value of this type may release a counted object that
-- owns children. A String owns none, so a layout whose managed children are
-- all Strings keeps a release that ignores the depth; every layout on a cycle
-- has a child that is not a String, and joins the release scheduler.
private pure func may_release_owner(
    value_type: TypeRef,
    unions: List[ConcreteUnion],
    records: List[ConcreteRecord]
) -> Result[Bool, Diagnostic]:
    match value_type:
        StringType: Ok(False)
        _: value_type.value_needs_ownership(unions, records)


private pure func any_may_release_owner(
    fields: List[TypeRef],
    unions: List[ConcreteUnion],
    records: List[ConcreteRecord]
) -> Result[Bool, Diagnostic]:
    var found: Result[Bool, Diagnostic] = Ok(False)

    for field in fields:
        found = match found:
            Ok(False): field.may_release_owner(unions, records)
            _: found

    found


-- Whether a record joins the release scheduler: a counted record whose
-- release may release a child that owns children.
private pure func record_joins_release(
    layout: ConcreteRecord,
    unions: List[ConcreteUnion],
    records: List[ConcreteRecord]
) -> Result[Bool, Diagnostic]:
    match layout:
        CountedFields(fields): fields.any_may_release_owner(unions, records)
        InlineFields(_) | ValueFields(_): Ok(False)


-- Whether a List layout joins the release scheduler: its elements may own children.
private pure func list_joins_release(
    layout: ListLayout,
    unions: List[ConcreteUnion],
    records: List[ConcreteRecord]
) -> Result[Bool, Diagnostic]:
    layout.element.may_release_owner(unions, records)


private pure func record_release_name(index: Int) -> String:
    "blorp_record_release_${index}"


private pure func union_release_name(index: Int) -> String:
    "blorp_union_release_${index}"


-- The release body of every layout that joins the release scheduler, in
-- record, union and List order; each also names its kind.
private pure func release_bodies(
    records: List[ConcreteRecord],
    unions: List[ConcreteUnion],
    lists: List[ListLayout]
) -> Result[List[String], Diagnostic]:
    var bodies: List[String] = []
    var failure: Option[Diagnostic] = None
    var index = 0

    for layout in records:
        match layout.record_joins_release(unions, records):
            Ok(True):
                bodies = bodies.append(record_release_name(index))
            Ok(False):
                void
            Err(error):
                failure = Some(error)
                break

        index = index + 1

    index = 0

    for layout in unions:
        if layout.union_is_boxed():
            bodies = bodies.append(union_release_name(index))

        index = index + 1

    for layout in lists:
        match layout.list_joins_release(unions, records):
            Ok(True):
                bodies = bodies.append(layout.key.list_release_name())
            Ok(False):
                void
            Err(error):
                failure = Some(error)
                break

    match failure:
        Some(error): Err(error)
        None: Ok(bodies)


-- The scheduler's kinds and state, before the first drop that parks.
private pure func release_scheduler(bodies: List[String]) -> String:
    kinds = bodies
        .map(pure func(body): "${release_kind(body)},")
        .join("")

    "enum blorp_release_kind{${kinds}blorp_release_kinds};\n${RELEASE_RUNTIME}"


-- Releases a parked object with its kind's release body at depth 1; emitted
-- after every release body.
private pure func release_dispatch(bodies: List[String]) -> String:
    cases = bodies
        .map(pure func(body): "case ${release_kind(body)}:${body}(dead,1);break;")
        .join("")

    "static void blorp_release_dispatch(enum blorp_release_kind kind,void *dead){switch(kind){${cases}".concat(
        "case blorp_release_kinds:abort();}}\n"
    )


private pure func aggregate_runtime_contents(
    program: VerifiedProgram,
    lists: List[ListLayout],
    helpers: List[ListUpdateHelper],
    callables: List[TypeRef]
) -> Result[String, Diagnostic]:
    checked = program.verified_contents()
    ordered ?= program.append_aggregate_definitions()
    completed ?= "".append_list_runtime(lists, checked.unions, checked.records)
    updates ?= "".append_list_updates(helpers, checked.unions, checked.records)
    ops ?= callables.callable_ops(checked.unions)
    bodies ?= release_bodies(checked.records, checked.unions, lists)

    scheduler = if bodies.is_empty():
        ""
    else:
        bodies.release_scheduler()

    dispatch = if bodies.is_empty():
        ""
    else:
        bodies.release_dispatch()

    var fragments: List[String] = [
        callables.callable_declarations(),
        "".append_list_prototypes(lists)
    ]

    var index: Int = 0

    -- Complete declarations and helper groups end physical C lines so GCC can
    -- retain column tracking and its diagnostics for the generated runtime.
    for layout in checked.records:
        typedef_prefix: String = "typedef struct blorp_r_".append_int(index)

        pointer_marker: String = match layout:
            InlineFields(_) | ValueFields(_): " "
            CountedFields(_): "* "

        fragments = fragments.append("${typedef_prefix}${pointer_marker}blorp_r_${index};\n")
        index = index + 1

    index = 0

    for _ in checked.records:
        fragments = fragments.append("${"".append_record_prototypes(index)}\n")
        index = index + 1

    fragments = fragments.append("".append_boxed_union_prototypes(checked.unions))
    fragments = fragments.append(scheduler)
    fragments = fragments.append(ordered)
    index = 0
    var failure: Option[Diagnostic] = None

    for layout in checked.records:
        match "".append_record_ownership(layout, index, checked.unions, checked.records):
            Ok(ownership):
                fragments = fragments.append("${ownership}\n")
            Err(error):
                failure = Some(error)
                break

        index = index + 1

    _: Void ?= match failure:
        Some(error): Err(error)
        None: Ok(void)

    arguments = match checked.entrypoint:
        WithArguments(_, _):
            StringType
                .list_element_key()
                .arguments_runtime()
        NoArguments(_, _):
            ""

    fragments = fragments.concat([completed, updates, arguments, ops, dispatch])
    Ok(fragments.join(""))


-- Boxed union nodes need the allocation and atomic headers like managed records.
private pure func has_boxed_union(unions: List[ConcreteUnion]) -> Bool:
    var boxed: Bool = False

    for layout in unions:
        if layout.union_is_boxed():
            boxed = True
            break

    boxed


-- The static data of a program's constants: each static object, children
-- before the parents that link to them, then each constant, and the callable
-- entries their functions need.
private record StaticData {
    objects: List[String],
    entries: List[CallableEntry],
    -- The position of the current constant's first object.
    first: Int
}


-- A value's C initializer, after the static objects it links to.
private record StaticInitializer {
    data: StaticData,
    initializer: String
}


private record StaticInitializers {
    data: StaticData,
    initializers: List[String]
}


-- `data` with one more static object of constant `constant`, named for the
-- constant and its position among the constant's objects, after its children.
-- `declare` writes the object's declaration from its name and `link` the
-- parent's link to it.
private pure func with_object(
    data: StaticData,
    constant: Int,
    declare: pure (String) -> String,
    link: pure (String) -> String
) -> StaticInitializer:
    name = "blorp_k_${constant}_${data.objects.length() - data.first}"
    { data = { data | objects = data.objects.append(declare(name)) }, initializer = link(name) }


-- A fact of constant `constant` that its type's layout lacks.
private pure func or_mismatch[T](found: Option[T], constant: Int) -> Result[T, Diagnostic]:
    match found:
        Some(present): Ok(present)
        None: Err(render(compiler_span(), ConstantValueMismatch(constant)))


-- The read forms of CTFE_PLAN.md: a String, a nonempty List, a counted record
-- or a boxed union is a static object at its base count, and a link to it is
-- its address; an empty List links to its layout's `[]` root; any other value
-- is a C initializer, written in its parent's. The objects of constant
-- `constant` are named for it and their position among the objects.
private pure func static_initializer(
    data: StaticData,
    value: specialized.ConstantValue,
    value_type: TypeRef,
    constant: Int,
    program: OwnershipProgram
) -> Result[StaticInitializer, Diagnostic]:
    match (value_type, value):
        (VoidType, specialized.VoidConstant):
            Ok({ data = data, initializer = "((uint8_t)0)" })
        (IntegerType(Int64Format), specialized.Int64Constant(number)):
            Ok({ data = data, initializer = "".append_integer(number) })
        (IntegerType(UInt8Format), specialized.UInt8Constant(byte)):
            Ok({ data = data, initializer = "((uint8_t)${byte})" })
        (FloatType, specialized.FloatConstant(number)):
            Ok({ data = data, initializer = number.c_float_literal() })
        (StringType, specialized.StringConstant(text)):
            Ok(
                data.with_object(
                    constant,
                    pure func(name): "${"".append_static_string(name, text)}\n",
                    pure func(name): "&${name}.value"
                )
            )
        (ListType(element), specialized.ListConstant([])):
            Ok({
                data = data,
                initializer = element
                    .list_element_key()
                    .list_empty_root_address()
            })
        (ListType(element), specialized.ListConstant(items)):
            data.static_list(element, items, constant, program)
        (RecordType(id), specialized.RecordConstant(fields)):
            data.static_record(id, fields, constant, program)
        (UnionType(id), specialized.VariantConstant(variant, payload)):
            data.static_variant(variant, payload, constant, program)
        (CallableType(_, _), specialized.FunctionConstant(body)):
            entry: CallableEntry = { body = body, value_type = value_type, captures = False }

            Ok({
                data = { data | entries = data.entries.with_entry(entry) },
                initializer = "{&${"".append_callable_entry_name(body, value_type)},(void*)0}"
            })
        _:
            Err(render(compiler_span(), ConstantValueMismatch(constant)))


private pure func static_list(
    data: StaticData,
    element: TypeRef,
    items: List[specialized.ConstantValue],
    constant: Int,
    program: OwnershipProgram
) -> Result[StaticInitializer, Diagnostic]:
    types = items.map(pure func(_) -> TypeRef: element)
    elements ?= data.static_initializers(items, types, constant, program)
    element_type ?= "".append_type_name(element, program.unions, compiler_span())

    suffix = element
        .list_element_key()
        .list_suffix()

    values = elements.initializers.join(",")

    Ok(
        elements.data.with_object(
            constant,
            pure func(name): "BLORP_STATIC_LIST(${name},blorp_l_${suffix},${element_type},${items.length()},{${values}});\n",
            pure func(name): "&${name}.value"
        )
    )


-- A record's fields by designator; Void fields have no C member.
private pure func static_record(
    data: StaticData,
    id: RecordInstanceId,
    fields: List[specialized.ConstantValue],
    constant: Int,
    program: OwnershipProgram
) -> Result[StaticInitializer, Diagnostic]:
    index = id.record_number()

    layout ?= program.records
        .get(index)
        .or_mismatch(constant)

    layout_fields = layout.record_fields()
    built ?= data.static_initializers(fields, layout_fields, constant, program)
    var designated: List[String] = []
    var position = 0

    for initializer in built.initializers:
        if layout_fields.get(position) != Some(VoidType):
            designated = designated.append(".blorp_rf_${index}_${position}=${initializer}")

        position = position + 1

    match layout:
        CountedFields(_):
            initial = ["BLORP_STATIC_RECORD_REFERENCES"]
                .concat(designated)
                .join(",")

            Ok(
                built.data.with_object(
                    constant,
                    pure func(name): "static struct blorp_r_${index} ${name}={${initial}};\n",
                    pure func(name): "&${name}"
                )
            )
        InlineFields(_) | ValueFields(_):
            -- C has no empty initializer; an all-Void record's unit byte takes 0.
            text = if designated.is_empty():
                "0"
            else:
                designated.join(",")

            Ok({ data = built.data, initializer = "{${text}}" })


-- A payload-free union is an enum, and its value its tag's name.
private pure func static_variant(
    data: StaticData,
    variant: VariantInstanceId,
    payload: List[specialized.ConstantValue],
    constant: Int,
    program: OwnershipProgram
) -> Result[StaticInitializer, Diagnostic]:
    index = variant
        .variant_owner()
        .union_number()

    layout ?= program.unions
        .get(index)
        .or_mismatch(constant)

    payload_types ?= layout
        .union_variants()
        .get(variant.variant_number())
        .or_mismatch(constant)

    built ?= data.static_initializers(payload, payload_types, constant, program)
    tag = "".append_variant_name(variant)
    var designated: List[String] = []
    var position = 0

    for initializer in built.initializers:
        designated = designated.append(".blorp_uf_${position}=${initializer}")
        position = position + 1

    fields = if payload.is_empty():
        ""
    else:
        ",.payload.blorp_up_${variant.variant_number()}={${designated.join(",")}}"

    if (
        layout
            .has_payload()
            .not()
    ):
        Ok({ data = built.data, initializer = tag })
    else if layout.union_is_boxed():
        Ok(
            built.data.with_object(
                constant,
                pure func(name): "static struct blorp_u_${index} ${name}={BLORP_STATIC_RECORD_REFERENCES,.tag=${tag}${fields}};\n",
                pure func(name): "&${name}"
            )
        )
    else:
        Ok({ data = built.data, initializer = "{.tag=${tag}${fields}}" })


-- Each value's initializer at the type in the same position. A record value
-- short of a field would leave it zero in C, so the lengths must agree.
private pure func static_initializers(
    data: StaticData,
    values: List[specialized.ConstantValue],
    types: List[TypeRef],
    constant: Int,
    program: OwnershipProgram
) -> Result[StaticInitializers, Diagnostic]:
    var built = data
    var initializers: List[String] = []
    var failure: Option[Diagnostic] = None
    var position = 0

    if values.length() != types.length():
        failure = Some(render(compiler_span(), ConstantValueMismatch(constant)))

    for value in values:
        if failure.is_some():
            break

        match types.get(position):
            Some(value_type):
                match built.static_initializer(value, value_type, constant, program):
                    Ok(child):
                        built = child.data
                        initializers = initializers.append(child.initializer)
                    Err(error):
                        failure = Some(error)
            None:
                failure = Some(render(compiler_span(), ConstantValueMismatch(constant)))

        position = position + 1

    match failure:
        Some(error): Err(error)
        None: Ok({ data = built, initializers = initializers })


-- `data` with constant `constant`: a `static const` C value named for its
-- instance, which a read copies, after the static objects it links to. Its
-- counts live in those objects, never in it, so only they are writable.
private pure func with_constant(
    data: StaticData,
    value: specialized.ConstantValue,
    row: specialized.ConcreteConstant,
    constant: Int,
    program: OwnershipProgram
) -> Result[StaticData, Diagnostic]:
    value_type = row.value_type

    -- Ownership pinned the row's callables, so the value may hold no others.
    _: Void ?= if value.held_callables() == row.callables:
        Ok(void)
    else:
        Err(render(compiler_span(), ConstantValueMismatch(constant)))

    built ?= { data | first = data.objects.length() }.static_initializer(
        value,
        value_type,
        constant,
        program
    )

    declared ?= "static ".append_local_declaration(
        value_type,
        InitializedLocal,
        program.unions,
        compiler_span()
    )

    declaration = "${declared}blorp_k_${constant}=${built.initializer};\n"
    Ok({ built.data | objects = built.data.objects.append(declaration) })


-- Every constant's static data, in instance order.
private pure func constant_statics(
    program: OwnershipProgram,
    table: specialized.ConstantTable
) -> Result[StaticData, Diagnostic]:
    values = table.constant_values()
    var data: StaticData = { objects = [], entries = [], first = 0 }
    var failure: Option[Diagnostic] = None
    var position = 0

    for constant in program.constants:
        if failure.is_some():
            break

        match values.get(position):
            Some(value):
                match data.with_constant(value, constant, position, program):
                    Ok(next): data = next
                    Err(error): failure = Some(error)
            None:
                failure = Some(render(compiler_span(), ConstantValueMismatch(position)))

        position = position + 1

    match failure:
        Some(error): Err(error)
        None: Ok(data)


pure func aggregate_runtime(program: VerifiedProgram) -> Result[String, Diagnostic]:
    checked = program.verified_contents()
    inventory = checked.program_inventory()

    program.aggregate_runtime_contents(
        inventory.list_layouts(),
        inventory.list_update_helpers(),
        inventory.callable_types
    )


-- Every exit from main reports through this one function. A diagnostic build
-- of a program with Lists checks that every owner of an immortal empty root
-- was dropped; blorp_memory_finish checks every static object's count.
private pure func program_finish_definition(list_types: Bool) -> String:
    finished_status = if list_types:
        "blorp_list_empty_finish(status)"
    else:
        "status"

    "static int blorp_program_finish(int status){return blorp_memory_finish(${finished_status});}\n"


-- `constants` is the table of the constants `program` reads, which travels
-- beside the IR.
pure func emit(
    program: VerifiedProgram,
    constants: specialized.ConstantTable
) -> Result[String, Diagnostic]:
    checked = program.verified_contents()
    records = checked.records
    inventory = checked.program_inventory()
    requirements = inventory.runtime_requirements()
    lists = inventory.list_layouts()
    statics ?= checked.constant_statics(constants)

    aggregates ?= program.aggregate_runtime_contents(
        lists,
        inventory.list_update_helpers(),
        inventory.callable_types
    )

    -- C is collected as fragments and joined once; appending each one to the
    -- whole output would copy everything emitted so far at every step.
    prelude = if requirements.string_types:
        STRING_RUNTIME
    else:
        "#include <stdint.h>\n"

    native_lists: NativeListTypes = {
        strings = StringType
            .list_element_key()
            .list_c_type(),
        bytes = IntegerType(UInt8Format)
            .list_element_key()
            .list_c_type()
    }

    system = inventory
        .system_calls()
        .map(
            pure func(operation: SystemOperation) -> SystemRuntime: operation.system_runtime(
                native_lists
            )
        )

    -- Every system operation's fragment, the thread pool, and print and
    -- print_error, which lock their stream with flockfile, need POSIX.1-2008,
    -- with the XSI and Darwin extensions, requested before any header. These
    -- fragments start the file, so the prelude precedes its first #include.
    needs_posix = system
        .is_empty()
        .not()
        .or(requirements.thread_pool)
        .or(requirements.string_output)
        .or(requirements.string_error_output)

    var fragments: List[String] = if needs_posix:
        [PROCESS_POSIX_PRELUDE, MEMORY_RUNTIME, prelude]
    else:
        [MEMORY_RUNTIME, prelude]

    needs_allocation_headers: Bool = match (
        lists
            .is_empty()
            .not()
    ):
        True:
            True
        False:
            match checked.records.any(pure func(layout):
                match layout:
                    CountedFields(_): True
                    InlineFields(_) | ValueFields(_): False
            ):
                True: True
                False: checked.unions.has_boxed_union()

    if needs_allocation_headers:
        fragments = fragments.append("#include <stdlib.h>\n#include <stdatomic.h>\n")

    if requirements.thread_pool:
        fragments = fragments
            .append(THREAD_RUNTIME)
            .append(JOIN_RUNTIME)

    if requirements.range_splitter:
        fragments = fragments.append(JOIN_RANGE_RUNTIME)

    if requirements.float_types:
        fragments = fragments.append(FLOAT_RUNTIME)

    if requirements.float_formatting:
        fragments = fragments.append(FLOAT_STRING_RUNTIME)

    if requirements.float_parsing:
        fragments = fragments.append(FLOAT_PARSE_RUNTIME)

    if requirements.integer_addition:
        fragments = fragments.append(INTEGER_ADD_RUNTIME)

    if requirements.integer_arithmetic:
        fragments = fragments.append(INTEGER_ARITHMETIC_RUNTIME)

    if requirements.integer_bits:
        fragments = fragments.append(INTEGER_BITS_RUNTIME)

    if requirements.uint8_arithmetic:
        fragments = fragments.append(UINT8_ARITHMETIC_RUNTIME)

    if requirements.string_output:
        fragments = fragments.append(STRING_PRINT_RUNTIME)

    if requirements.string_error_output:
        fragments = fragments.append(STRING_PRINT_ERROR_RUNTIME)

    if requirements.integer_parsing:
        fragments = fragments.append(STRING_PARSE_INT_RUNTIME)

    if requirements.string_equality:
        fragments = fragments.append(STRING_EQUALS_RUNTIME)

    if requirements.string_concatenation.or(requirements.string_integer_appending):
        fragments = fragments.append(string_concat_runtime())

    if requirements.string_integer_appending:
        fragments = fragments.append(string_append_int_runtime())

    if requirements.string_slicing:
        fragments = fragments.append(STRING_SLICE_RUNTIME)

    fragments = fragments.append(aggregates)

    -- These fragments follow the aggregates, whose List types they use.
    if requirements.string_to_bytes:
        fragments = fragments.append(string_to_bytes_runtime(native_lists.bytes))

    if requirements.bytes_to_text:
        fragments = fragments.append(bytes_to_text_runtime(native_lists.bytes))

    for shared in SHARED_FRAGMENTS:
        if system.any(pure func(runtime: SystemRuntime) -> Bool: runtime.shared.contains(shared)):
            fragments = fragments.append(shared.shared_fragment_runtime())

    for runtime in system:
        fragments = fragments.append(runtime.fragment)

    var index: Int = 0
    var failure: Option[Diagnostic] = None

    index = 0

    for function in checked.functions:
        match "".append_signature(function, index, checked.unions):
            Err(error):
                failure = Some(error)
                break
            Ok(signature):
                fragments = fragments.append("${signature};")

        index = index + 1

    if (
        failure
            .is_some()
            .not()
    ):
        for job in inventory.pool_jobs:
            emitted = match job:
                JoinJob(tasks): "".append_job(tasks, checked.functions, checked.unions)
                MapJob(callback): "".append_map_job(callback, checked.functions, checked.unions)

            match emitted:
                Ok(code):
                    fragments = fragments.append(code)
                Err(error):
                    failure = Some(error)
                    break

        var entries = inventory.callable_entries

        for entry in statics.entries:
            entries = entries.with_entry(entry)

        for entry in entries:
            match entry.append_callable_entry(checked):
                Ok(adapter):
                    fragments = fragments.append(adapter)
                Err(error):
                    failure = Some(error)
                    break

    -- Constants follow the callable entries their functions' pairs name, and
    -- precede the functions that read them, each on its own line.
    if (
        statics.objects
            .is_empty()
            .not()
    ):
        fragments = fragments
            .append("\n")
            .concat(statics.objects)

    if (
        failure
            .is_some()
            .not()
    ):
        index = 0

        for function in checked.functions:
            match function.append_function(index, checked.unions, records):
                Err(error):
                    failure = Some(error)
                    break
                Ok(function_code):
                    -- Each definition ends its line. Clang's -Wmisleading-indentation
                    -- slows sharply with line length, and one line of every body
                    -- dominated test compile time. GCC skips that check on very
                    -- long lines, so it now runs it and compiles somewhat slower.
                    fragments = fragments.append("${function_code}\n")

            index = index + 1

    match failure:
        Some(error):
            Err(error)
        None:
            output = fragments
                .append(
                    lists
                        .is_empty()
                        .not()
                        .program_finish_definition()
                )
                .join("")

            name = checked.entrypoint
                .entry_function()
                .function_number()
                .c_name()

            -- A program that uses the pool, through a join or a parallel map,
            -- rejects a bad BLORP_THREADS before any of its own code runs, as
            -- the memory start does BLORP_LEAK_CHECK; the pool's threads still
            -- start at the first join or map.
            start = if requirements.thread_pool:
                "blorp_memory_start();(void)blorp_join_requested_threads();"
            else:
                "blorp_memory_start();"

            wrapper = match checked.entrypoint:
                NoArguments(_, IntegerExitStatus):
                    "${output}int main(void){${start}return blorp_program_finish((int)${name}());}\n"
                NoArguments(_, SuccessfulExit):
                    "${output}int main(void){${start}(void)${name}();return blorp_program_finish(0);}\n"
                WithArguments(_, result):
                    suffix = StringType
                        .list_element_key()
                        .list_suffix()

                    prefix = output
                        .concat(
                            "int main(int argc,char **argv){${start}struct blorp_l_${suffix} *const blorp_arguments=blorp_list_from_argv(argc,argv);"
                        )
                        .concat(
                            "if(blorp_arguments==NULL){fputs(\"error: command-line argument is not valid UTF-8\\nhelp: pass UTF-8 encoded arguments\\n\",stderr);return blorp_program_finish(1);}"
                        )

                    match result:
                        IntegerExitStatus:
                            "${prefix}const int64_t blorp_result=${name}(blorp_arguments);blorp_list_drop_${suffix}(blorp_arguments);".concat(
                                "return blorp_program_finish((int)blorp_result);}\n"
                            )
                        SuccessfulExit:
                            "${prefix}(void)${name}(blorp_arguments);blorp_list_drop_${suffix}(blorp_arguments);return blorp_program_finish(0);}\n"

            Ok(wrapper)
