import:
    bool: Bool methods
    int: INT_MIN, Int methods
    option: Option methods
    result: Result methods
    string: String methods
    ../../analysis/check/model:
        MatchArmId,
        DecisionNodeId,
        ListLengthTest(ExactLength, MinimumLength),
    ../../analysis/namespace/builtins:
        IntegerFormat(Int64Format),
        DesignatedBoolean,
