import:
    bool: Bool methods
    int: INT_MAX, Int methods
    option: Option methods
    path as path_ops: Path
    string: String methods


-- Module IDs index one compilation's inventory; they never cross compilations.
-- The loader issues ordinals from the inventory's length before appending a row.
opaque type ModuleId = Int


implements Equatable for ModuleId:
    pure func equals(left: Self, right: Self) -> Bool:
        from_opaque ModuleId(left) == from_opaque ModuleId(right)


-- Keep the span carrier scalar: a union field would make every Span managed.
-- Only this authority translates roles and inventory ordinals into source IDs.
opaque type SourceId = Int


implements Equatable for SourceId:
    pure func equals(left: Self, right: Self) -> Bool:
        from_opaque SourceId(left) == from_opaque SourceId(right)


fixed union ModuleKind:
    FoundationTypesModule
    FoundationPreludeModule
    LibraryModule
    UserModule


fixed union SourceRole:
    CompilerRole
    ModuleRole
    InvalidRole


private COMPILER_SOURCE_NUMBER: Int = 1

private FIRST_MODULE_SOURCE_NUMBER: Int = 2

-- The root is the first row, then the two designated foundation inputs; later
-- rows are discovered dependencies.
private ROOT_MODULE_ORDINAL: Int = 0

private FOUNDATION_TYPES_ORDINAL: Int = 1

private FOUNDATION_PRELUDE_ORDINAL: Int = 2


pure func compiler_source() -> SourceId:
    into_opaque SourceId(COMPILER_SOURCE_NUMBER)


pure func module_id(ordinal: Int) -> Option[ModuleId]:
    maximum = INT_MAX - FIRST_MODULE_SOURCE_NUMBER
    if (ordinal >= 0).and(ordinal <= maximum):
        Some(into_opaque ModuleId(ordinal))
    else:
        None


pure func module_number(id: ModuleId) -> Int:
    from_opaque ModuleId(id)


pure func root_module_id() -> ModuleId:
    into_opaque ModuleId(ROOT_MODULE_ORDINAL)


pure func foundation_types_module_id() -> ModuleId:
    into_opaque ModuleId(FOUNDATION_TYPES_ORDINAL)


pure func foundation_prelude_module_id() -> ModuleId:
    into_opaque ModuleId(FOUNDATION_PRELUDE_ORDINAL)


pure func module_source(id: ModuleId) -> SourceId:
    into_opaque SourceId(FIRST_MODULE_SOURCE_NUMBER + id.module_number())


-- A module's file name without directories or extension, for annotations in
-- generated C comments. It holds no `/`, so the text can never contain `*/`,
-- whatever the file is called.
opaque type ModuleStem = String


-- What a function is called in generated C comments. Callers pass lexer
-- identifier spellings (a function or type name) and a `ModuleStem`, which holds
-- no `/`, so the text never contains `*/`.
opaque type FunctionLabel = String


-- The file name without its extension, so `x.test.brp` is `x.test`. It holds no
-- `/`, being one path component, so the label never contains `*/`. A path with
-- no file name (`/`, `..`) has no stem.
pure func file_stem(path: Path) -> Option[ModuleStem]:
    path_ops.stem(path).map(pure func(name: String) -> ModuleStem: into_opaque ModuleStem(name))


pure func declared_label(stem: ModuleStem, function_name: String) -> FunctionLabel:
    stem_name = from_opaque ModuleStem(stem)
    into_opaque FunctionLabel("${stem_name}.${function_name}")


pure func lambda_label(enclosing: FunctionLabel) -> FunctionLabel:
    text = from_opaque FunctionLabel(enclosing)
    into_opaque FunctionLabel("${text} lambda")


pure func equality_label(type_name: String) -> FunctionLabel:
    into_opaque FunctionLabel("equality for ${type_name}")


pure func label_text(label: FunctionLabel) -> String:
    from_opaque FunctionLabel(label)


pure func source_role(id: SourceId) -> SourceRole:
    if id == compiler_source():
        CompilerRole
    else if from_opaque SourceId(id) < FIRST_MODULE_SOURCE_NUMBER:
        InvalidRole
    else:
        ModuleRole


pure func source_module(id: SourceId) -> Option[ModuleId]:
    match id.source_role():
        CompilerRole | InvalidRole: None
        ModuleRole: module_id(from_opaque SourceId(id) - FIRST_MODULE_SOURCE_NUMBER)


record SourceFile {
    path: String,
    contents: String,
}


-- Module source rows use the same order as the parser's module inventory.
record SourceInputs {
    modules: List[SourceFile],
}
