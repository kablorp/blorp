import:
    int: Int methods
    option: Option methods
    string: String methods


pure func concat(left: String, right: String) -> String:
    left + right


-- Whether `left` sorts before `right` comparing bytes; a prefix sorts first.
pure func byte_order_before(left: String, right: String) -> Bool:
    var position = 0
    var decided: Option[Bool] = None
    while decided.is_none():
        decided = match (left.byte_at(position), right.byte_at(position)):
            (Some(first), Some(second)):
                if first == second:
                    None
                else:
                    Some(first < second)
            (None, Some(_)):
                Some(True)
            (_, None):
                Some(False)
        position = position + 1
    decided.get_or(False)
