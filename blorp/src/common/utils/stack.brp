---
The step every list-backed stack shares. An iterative walk keeps its pending
work in a list and a depth: a pop lowers the depth and leaves the slot, and the
next push overwrites that slot or, when the walk has not been this deep before,
appends.
---
import:
    int: Int methods
    list: List methods


-- Writes `item` at `depth` in `slots`, which holds at most `depth` live items
-- and may hold stale slots above them.
pure func push_at[T](slots: List[T], depth: Int, item: T) -> List[T]:
    if depth < slots.length():
        slots.set(depth, item)
    else:
        slots.append(item)
