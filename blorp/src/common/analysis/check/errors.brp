---
The checker's failure vocabulary: every rejection's semantic facts and span.
Rendering lives in render.brp; nothing here depends on wording.
---
import:
    ../../syntax/names: NameId
    ../../syntax/parse: ModulePath
    ../../syntax/syntax:
        IntegerFormat,
        ParsedImplementationHeader,
        ParsedReceiverHead,
        ParsedRuntimeOperation,
        Span,
        WrittenName,
    ../ids: TraitId, TraitMethodId, ConstantId, FunctionId, OpaqueId, RecordId, UnionId, VariantId
    ../namespace/builtins: BuiltinTypeError
    ../namespace/namespace: TypeHead, NamespaceProblem, Unoffered, ValueBinding
    ./model:
        EqualityMember,
        BodyOwner,
        ScopedBindingId,
        BindingOrigin,
        CallableParameterId,
        CallIdentity,
        FieldId,
        NominalId,
        TypeParameterId,
        TypeRef,
        TypeUse,
        FunctionSignature,


record BindingSite {
    binding: ScopedBindingId,
    name: NameId,
    span: Span,
}


-- Where an expected type came from. `FirstArmValue` is a later arm of a
-- match whose type its first arm decided; only checking an arm's value
-- produces it, so argument mismatches never carry it, and an infinite
-- inference carries it only through that value's result constraint.
union ExpectedTypeSite:
    SourceAnnotation(Span)
    InferredBindingDeclaration(BindingSite)
    FirstArmValue
    FirstIfBranchValue
    ForRangeBound
    OpaqueConstruction(OpaqueId)
    OpaqueProjection(OpaqueId)


record ArgumentMismatch {
    expected: TypeRef,
    actual: TypeUse,
    argument_position: Int,
    expected_site: ExpectedTypeSite,
}


record ExpressionMismatch {
    expected: TypeRef,
    actual: TypeUse,
    expected_site: ExpectedTypeSite,
}


record InfiniteInference {
    parameter: TypeParameterId,
    call_span: Span,
    recursive_type: TypeRef,
    expected_site: ExpectedTypeSite,
}


-- A local declared without an annotation from a lone integer literal, which
-- gave it Int: annotating it would give it another integer format.
record LiteralBinding {
    name: NameId,
    mutable: Bool,
    literal: Int,
}


-- `previous_literal` and `current_literal` are the arguments' locals of that
-- kind, when an argument reads one directly.
record GenericConflict {
    mismatch: ArgumentMismatch,
    parameter: TypeParameterId,
    previous: TypeUse,
    current: TypeUse,
    previous_literal: Option[LiteralBinding],
    current_literal: Option[LiteralBinding],
}


record ArityMismatch {
    callee: NameId,
    expected: Int,
    actual: Int,
    receiver_call: Bool,
    target: CallIdentity,
}


-- Source locations explain candidates; availability remains scope-owned.
record MethodCandidateSite {
    function: FunctionId,
    declaration: Span,
    import_site: Option[Span],
}


record ReceiverOverlap {
    introduced: MethodCandidateSite,
    introduced_receiver: TypeRef,
    other: MethodCandidateSite,
    other_receiver: TypeRef,
}


-- Syntax the parser reads ahead of its semantics. Each form is rejected
-- once, by the first checking module that sees it; the milestone that gives
-- the form its meaning deletes that rejection.
union UnsupportedForm:
    RangeValue
    IfValue
    -- A match nested inside a larger expression; bound and statement
    -- matches are joins.
    MatchInExpression
    CharPattern


-- `Alias.name` resolves through the importing module's alias row to the
-- target module's own exported declarations; nothing is recovered from a
-- spelling. Each failure names the alias and the module's written path.
union QualifiedError:
    UnknownModuleAlias(NameId)
    BareModuleAlias(NameId)
    QualifiedNotOffered(NameId, NameId, ModulePath, Unoffered)


-- Every rejection, grouped by the checking concern that reports it.
union CheckErrorKind:
    TraitRejection(TraitError)
    UnsupportedSyntax(UnsupportedForm)
    QualifiedRejection(QualifiedError)
    NamespaceRejection(NamespaceProblem)
    TypeDeclarationRejection(TypeDeclarationError)
    TypeTermRejection(TypeTermError)
    SignatureRejection(SignatureError)
    BuiltinRejection(BuiltinError)
    CallRejection(CallError)
    ConstantRejection(ConstantError)
    MethodRejection(MethodError)
    ConstructorRejection(ConstructorError)
    RecordRejection(RecordError)
    ValueRejection(ValueError)
    BindingRejection(BindingError)
    StatementRejection(StatementError)
    MatchRejection(MatchError)
    RecursionRejection(RecursionError)
    InternalInvariant(CheckerInvariant)


-- The six canonical arithmetic traits, each selected for one operator.
union ArithmeticTrait:
    AddableTrait
    SubtractableTrait
    MultipliableTrait
    DivisibleTrait
    ModulableTrait
    NegatableTrait


-- The comparison traits; only these reserve default members beside their
-- abstract one.
union ComparisonTrait:
    EquatableTrait
    OrderableTrait


-- The operators or interpolation whose prelude-selected trait a diagnostic concerns.
union CanonicalFamily:
    ComparisonFamily(ComparisonTrait)
    ArithmeticFamily(ArithmeticTrait)
    StringableFamily


union TraitError:
    DuplicateRequirementParameter(TraitMethodId, WrittenName)
    DifferentMethodFamilies(TraitMethodId, TraitMethodId, Span)
    FamilyFunctionConflict(TraitMethodId, FunctionId, Span)
    ImpureRequirement(TraitMethodId)
    GenericRequirement(TraitMethodId)
    FirstParameterMustBeSelf(TraitMethodId)
    CallableFormalDeferred(TraitMethodId)
    IndependentImplementationParameters
    InvalidTraitBound
    DuplicateReceiverParameter(WrittenName)
    ReceiverParameterCount(Int, Int)
    MissingTraitBound(TraitId, TypeRef)
    EqualityMemberUnsupported(TraitId, TypeRef, EqualityMember)
    OrphanImplementation(TraitId, TypeHead)
    DuplicateImplementation(TraitId, TypeHead, Span)
    MissingImplementationMethod(TraitMethodId)
    UnknownImplementationMethod(NameId)
    DuplicateImplementationMethod(NameId, Span)
    ImplementationSignatureMismatch(TraitMethodId, FunctionSignature, FunctionSignature)
    MalformedCanonicalTrait(CanonicalFamily, TraitId)
    -- A reserved default member, named because a missing one has no method id.
    MalformedCanonicalMember(ComparisonTrait, NameId)
    OperatorRequiresCanonical(CanonicalFamily)
    MissingCanonicalInequality
    MissingImplementation(TraitMethodId, TypeRef)
    -- `-value` on an integer format whose library has no Negatable, as an
    -- unsigned format has no negation.
    IntegerWithoutNegation(IntegerFormat)
    MethodNeedsExpectedType(TraitMethodId)
    SupertraitUnknown
    -- The walk from the repeated trait back to itself, reported at the closing edge.
    SupertraitCycle(List[TraitId])
    -- The implemented trait, its supertrait, the written receiver and why the
    -- supertrait implementation is absent.
    SupertraitNotImplemented(TraitId, TraitId, ParsedReceiverHead, AbsentSupertrait)
    -- The implemented trait, the bound it lacks, the receiver parameter's
    -- written name and the written receiver.
    SupertraitBoundNotEntailed(TraitId, TraitId, WrittenName, ParsedReceiverHead)
    SupertraitMethodInImplementation(NameId, TraitId, ParsedReceiverHead)
    CanonicalEquatableSupertraits
    -- An applied record, union or opaque type, the argument that fails one
    -- of its declaration's bounds, and that bound.
    DeclaredBoundUnsatisfied(TypeRef, TypeRef, TraitId)
    -- A receiver declaration's bound that the receiver parameter at this
    -- position does not declare, and the written header.
    ReceiverBoundUndeclared(TraitId, Int, ParsedImplementationHeader)


-- Why a receiver head lacks a supertrait implementation, so the help names the
-- fix. Only canonical equality is automatic, so only it has the later causes.
union AbsentSupertrait:
    NeverImplemented
    AutomaticEqualityRejected(EqualityMember)
    AutomaticEqualityNotFinite


union ConstantError:
    NonClosedInitializer
    ConstantCalled(ConstantId)


union TypeDeclarationError:
    DuplicateRecordField(NameId, Span)
    RecursiveAggregateType(TypeRef)
    RecursiveOpaqueRepresentation(OpaqueId)
    -- A fixed union payload whose stored type is not a number, Void, a fixed
    -- record or a fixed union.
    NonFixedPayload(TypeRef)
    -- A fixed record field whose stored type is not a number, a fixed record
    -- or a fixed union.
    NonFixedField(TypeRef)
    -- The field or payload that closes a cycle of fixed types stored by value.
    RecursiveFixedType(TypeRef)
    DuplicateTypeParameter(TypeParameterId, TypeParameterId, Span)
    TypeParameterTypeNameConflict(NameId)


union TypeTermError:
    TraitUsedAsType(TraitId)
    PrivateTypeInPublicDeclaration(NameId, NameId)
    -- A record, union or opaque type written with the wrong number of arguments.
    MissingTypeArguments(NominalId, Int)
    TypeArgumentCountMismatch(NominalId, Int, Int)
    OrdinaryTypeApplied(NominalId)
    UnknownType(NameId)
    NonApplicableType(NameId)
    ListTypeArgumentCount


union SignatureError:
    GenericMain(TypeParameterId)
    MainHasParameters(Int)
    MainParameterType
    MainReturnType(TypeRef)
    MissingMain


union BuiltinError:
    BuiltinTypesRejected(BuiltinTypeError)
    BuiltinContractMismatch(ParsedRuntimeOperation)
    BuiltinTailAnnotation


union CallError:
    CallableReceiverSyntax(CallIdentity)
    ImpureCallback(FunctionId)
    CallableValueRequired
    UnknownFunction(NameId)
    UncallableBinding(BindingSite, BindingOrigin, TypeRef)
    ArgumentCountMismatch(ArityMismatch)
    ImpureCall(BodyOwner, FunctionId)
    ImpureCallableCall(BodyOwner)
    ImpureLambda
    LambdaArityMismatch(Int, Int)
    LambdaInputNeedsType
    LambdaBlockNeedsResult
    LambdaResultNeedsType
    ArgumentTypeMismatch(ArgumentMismatch)
    GenericArgumentConflict(GenericConflict)
    -- A conflict at the canonical add between a String and another type.
    TextJoinConflict(GenericConflict)
    UninferableTypeParameter(TypeParameterId)
    InfiniteTypeArgument(InfiniteInference)


union MethodError:
    OverlappingReceivers(NameId, ReceiverOverlap)
    NoApplicableMethod(NameId, TypeRef, List[MethodCandidateSite])
    MethodArgumentCounts(NameId, Int, List[Int], List[MethodCandidateSite])
    MethodReceiverNeedsType(NameId, List[MethodCandidateSite])


-- What the capitalized `X` of `X.Variant` names when it is not a union.
union QualifierKind:
    RecordQualifier
    ConstantQualifier
    BuiltinTypeQualifier
    OpaqueTypeQualifier
    TraitQualifier
    TypeParameterQualifier


union ConstructorError:
    ConstructorNeedsExpectedType(VariantId)
    -- `X.Variant` where X is not a union: the name written as X, and what it is.
    QualifierNotUnion(NameId, QualifierKind)
    -- `X.Variant` where X names nothing this module can see as a type.
    UnknownUnion(NameId)
    -- `Union.Variant` where the union declares no such variant.
    UnionHasNoVariant(UnionId, NameId)
    VariantNotInExpectedType(NameId, TypeRef)
    PayloadFreeVariantCalled(VariantId)
    ConstructorFieldCountMismatch(VariantId, Int, Int)


union RecordError:
    RecordNeedsExpectedType
    UnknownRecordField(NameId, RecordId)
    DuplicateLiteralField(NameId, Span)
    DuplicateUpdateField(NameId, Span)
    MissingRecordField(FieldId, Span)
    RecordFieldTypeMismatch(FieldId, TypeUse, TypeUse)
    FieldRequiresRecord(TypeRef)
    UpdateRequiresRecord(TypeRef)


-- Which element type a list literal's elements must share.
union ListElementReference:
    EarlierElement
    ExpectedElement


record ListElementMismatch {
    position: Int,
    actual: TypeRef,
    expected: TypeRef,
    reference: ListElementReference,
}


union ValueError:
    TupleIndexRequiresTuple(TypeRef)
    TupleIndexMustBeLiteral
    TupleIndexOutOfRange(Int, Int)
    MutableCapture(ScopedBindingId)
    MissingIfElse
    IfBranchWithoutValue
    UnknownValue(NameId)
    -- A bare name that is a variant of a union this module sees by name but
    -- did not import, so `Union.Variant` reaches it: the first such variant,
    -- then any others of the same name, since two visible unions can share it.
    UnimportedVariantValue(VariantId, List[VariantId])
    UnknownOpaqueType(NameId)
    NonOpaqueConversionType(NameId)
    ForeignOpaqueConstruction(OpaqueId)
    ForeignOpaqueProjection(OpaqueId)
    ExpressionTypeMismatch(ExpressionMismatch)
    InterpolationRequiresStringable(TypeRef)
    EmptyListNeedsElementType
    ListElementTypeMismatch(ListElementMismatch)
    -- `{}` without an expected type: no entry supplies K or V.
    EmptyDictNeedsType
    -- The configured prelude selects no Dict whose module declares the
    -- functions a literal calls.
    DictLiteralRequiresDict
    -- An integer literal, or literal pattern, outside its format's limits.
    IntegerLiteralOutOfRange(Int, IntegerFormat)


union BindingError:
    ModuleBindingConflict(ValueBinding)
    LocalBindingConflict(BindingSite, BindingOrigin)
    CallableBindingConflict(CallableParameterId, Span)


union StatementError:
    NonBooleanCondition(TypeRef)
    NonIterableFor(TypeRef)
    TupleBindingRequiresTuple(TypeRef)
    TupleBindingArityMismatch(Int, Int)
    PropagationNeedsResultReturn(TypeRef)
    PropagationNeedsResultValue(TypeRef)
    NonVoidStatement(TypeRef)
    NonVoidMatchArm(TypeRef)
    ImmutableAssignment(BindingSite)
    CapturedAssignment(ScopedBindingId)
    CallableAssignment(CallableParameterId)


union PatternWitness:
    AnyWitness
    VariantWitness(VariantId, List[PatternWitness])
    TupleWitness(List[PatternWitness])
    EmptyListWitness
    ConsListWitness(PatternWitnessChildren)
    OtherValueWitness


record PatternWitnessChildren {
    head: PatternWitness,
    tail: PatternWitness,
}


union MatchError:
    ArmWithoutValue
    PatternFieldCountMismatch(VariantId, Int, Int)
    TuplePatternRequiresTuple(TypeRef)
    TuplePatternArityMismatch(Int, Int)
    BarePatternName(NameId, TypeRef)
    -- The variant, and whether its union is in scope under its own name, so
    -- that `Union.Variant` would reach it.
    UnimportedConstructorPattern(VariantId, Bool)
    -- `Union.Variant` named a variant of a union other than the matched one.
    WrongUnionPattern(VariantId, UnionId)
    UnknownConstructorPattern(NameId, TypeRef)
    UnreachableArm
    OrPatternBindingsDiffer
    OrPatternBindingTypeMismatch(NameId, TypeRef, TypeRef)
    NonExhaustiveMatch(List[VariantId])
    NonExhaustiveStructuralMatch(PatternWitness)
    PatternTypeMismatch(TypeRef)
    InvalidMatchScrutinee(TypeRef)


union RecursionError:
    PropagationTailRecursionUnsupported
    CallableTailRecursionUnsupported
    AnnotatedSelfCallback
    UnprovenTraitInstantiation
    GrowingRecursiveInstantiation
    NonTailSelfCall(FunctionId)
    NoSelfRecursion
    GenericTailRecursionUnsupported
    -- A self call that is a nested match's arm value: at the tail, but a
    -- backedge cannot leave a join until the loops milestone.
    TailCallInNestedMatch


record CheckError {
    span: Span,
    kind: CheckErrorKind,
}


record CheckErrors {
    first: CheckError,
    remaining: List[CheckError],
}


private pure func rejected(span: Span, kind: CheckErrorKind) -> CheckError:
    { span = span, kind = kind }


-- A rejection is built through its family's constructor, which names the
-- family once.
pure func unsupported_form(span: Span, form: UnsupportedForm) -> CheckError:
    rejected(span, UnsupportedSyntax(form))


pure func namespace_rejection(span: Span, problem: NamespaceProblem) -> CheckError:
    rejected(span, NamespaceRejection(problem))


pure func type_declaration_error(span: Span, error: TypeDeclarationError) -> CheckError:
    rejected(span, TypeDeclarationRejection(error))


pure func type_term_error(span: Span, error: TypeTermError) -> CheckError:
    rejected(span, TypeTermRejection(error))


pure func binding_error(span: Span, error: BindingError) -> CheckError:
    rejected(span, BindingRejection(error))


pure func signature_error(span: Span, error: SignatureError) -> CheckError:
    rejected(span, SignatureRejection(error))


pure func builtin_error(span: Span, error: BuiltinError) -> CheckError:
    rejected(span, BuiltinRejection(error))


pure func call_error(span: Span, error: CallError) -> CheckError:
    rejected(span, CallRejection(error))


pure func constant_error(span: Span, error: ConstantError) -> CheckError:
    rejected(span, ConstantRejection(error))


pure func method_error(span: Span, error: MethodError) -> CheckError:
    rejected(span, MethodRejection(error))


pure func constructor_error(span: Span, error: ConstructorError) -> CheckError:
    rejected(span, ConstructorRejection(error))


pure func record_error(span: Span, error: RecordError) -> CheckError:
    rejected(span, RecordRejection(error))


pure func qualified_error(span: Span, error: QualifiedError) -> CheckError:
    { span = span, kind = QualifiedRejection(error) }


pure func value_error(span: Span, error: ValueError) -> CheckError:
    rejected(span, ValueRejection(error))


pure func statement_error(span: Span, error: StatementError) -> CheckError:
    rejected(span, StatementRejection(error))


pure func match_error(span: Span, error: MatchError) -> CheckError:
    rejected(span, MatchRejection(error))


pure func recursion_error(span: Span, error: RecursionError) -> CheckError:
    rejected(span, RecursionRejection(error))


union CheckerInvariant:
    GenericConstructorContract
    InvalidInferenceVariable(Int)
    InvalidInferenceWorklist
    InvalidDeclarationVisit
    InvalidRecordField(FieldId)
    MissingCallParameter(Int)
    InvalidFunctionContract
    InvalidReceiverScope
    -- The parser rejects `break` and `continue` outside a loop, so a stray
    -- loop control can only reach checking through a parser fault.
    LoopControlOutsideLoop
    -- The parser admits `?=` only among a function's own top-level statements,
    -- which body resolution handles before nested blocks.
    NestedPropagation
    MissingGenericParameter(Int)
    InvalidRecordDeclaration(RecordId)
    InvalidOpaqueDeclaration(OpaqueId)
    InvalidConstantDeclaration(ConstantId)
    InvalidResolvedFunction(FunctionId)
    InvalidUnionDeclaration(UnionId)
    InvalidResolvedUnion(UnionId)
    InvalidCheckedUnion(UnionId)
    InvalidResolvedVariant(VariantId)
    InvalidParameterDeclaration(TypeParameterId)
    InvalidParameterName(TypeParameterId)
    ParameterOwnerWithoutParameter(TypeParameterId)
    InvalidParsedName(NameId)
    RuntimeContractMismatch
    InvalidResolvedParameter(Int)
    InvalidCallName(NameId)
    -- Pattern resolution received a form the match's pre-scan rejects.
    UnsupportedPatternReachedResolution
    -- A parsed match has an arm, so a synthesized join's type is decided.
    JoinWithoutArms


pure func checker_invariant(span: Span, invariant: CheckerInvariant) -> CheckError:
    rejected(span, InternalInvariant(invariant))


-- A fact earlier phases guarantee. The error is built here, only when the fact
-- is missing: `value.to_result(checker_invariant(...))` would build it on every
-- call, and a lookup that almost never fails runs that call millions of times.
pure func or_checker_invariant[T](
    value: Option[T],
    span: Span,
    invariant: CheckerInvariant,
) -> Result[T, CheckError]:
    match value:
        Some(present): Ok(present)
        None: Err(checker_invariant(span, invariant))


pure func trait_error(span: Span, error: TraitError) -> CheckError:
    rejected(span, TraitRejection(error))
