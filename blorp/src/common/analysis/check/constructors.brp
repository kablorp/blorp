---
Plans and validates record literals, record updates and variant applications from
their expected types, producing the pending records and variants that freezing later
publishes.
---
import:
    bool: Bool methods
    int: Int methods
    option: Option methods
    result: Result methods
    ../../syntax/source: ModuleId
    ../../syntax/syntax:
        Span,
        ValueExpression,
        WrittenName,
        ParsedRecordField,
        ParsedDictEntry,
        ParsedQualified,
    ../../utils/results: first_error
    ../ids: RecordId, UnionId, VariantId
    ../namespace/namespace:
        Namespace,
        NamedValue(NamedConstructor),
        OfferedValue(OfferedConstructor),
    ./callables: FunctionContract, ResolutionContext
    ./declarations: Namespace methods, find_field, occurrence_fields, previous_declaration
    ./errors:
        CheckError,
        ExpectedTypeSite(SourceAnnotation),
        CallError(ArgumentTypeMismatch),
        MatchError(UnimportedConstructorPattern),
        QualifiedError(QualifiedNotOffered),
        match_error,
        qualified_error,
        ConstructorError(
            ConstructorNeedsExpectedType,
            VariantNotInExpectedType,
            PayloadFreeVariantCalled,
            ConstructorFieldCountMismatch,
        ),
        RecordError(
            UpdateRequiresRecord,
            DuplicateUpdateField,
            RecordNeedsExpectedType,
            UnknownRecordField,
            DuplicateLiteralField,
            MissingRecordField,
            RecordFieldTypeMismatch,
        ),
        ValueError(EmptyListNeedsElementType, ListElementTypeMismatch),
        ListElementReference(EarlierElement, ExpectedElement),
        CheckerInvariant(
            InvalidCheckedUnion,
            InvalidRecordDeclaration,
            InvalidRecordField,
            GenericConstructorContract,
            InvalidInferenceWorklist,
        ),
        call_error,
        constructor_error,
        record_error,
        value_error,
        checker_invariant,
        or_checker_invariant,
    ./inference:
        PendingBase(
            PendingConstructRecord,
            PendingConstructVariant,
            PendingUpdateRecord,
            PendingConstructList,
        ),
        ListElementSource(ExpectedElementType, FirstElementType),
        InferenceType(AcceptedType, CallVariable, InferredNominal, InferredList),
        InferenceReadiness(ClosedInference, DeferredInference),
        InferencePublication(CompleteInference, DiagnosticInference),
        InferenceSlot,
        InferenceUse,
        PendingOperations(NoPendingOperations),
        PendingRecordField,
        PendingRetainedField,
        PendingValue,
        PendingVariantContract,
        TypeRef methods,
    ./model:
        FieldId,
        CheckedRecord,
        CheckedUnion,
        CheckedOpaque,
        CheckedField,
        TypeParameterId,
        TypeRef(NominalType, ListType),
        AggregateId(RecordAggregate, UnionAggregate),
        NominalId(AggregateNominal),
        TypeUse,
        CheckedExpr,
        UnionOccurrence,


-- Construction reads declarations and module visibility, never a body owner.
record ConstructionContext {
    module: ModuleId,
    namespace: Namespace,
    records: List[CheckedRecord],
    unions: List[CheckedUnion],
}


pure func construction_context(context: ResolutionContext) -> ConstructionContext:
    {
        module = context.module,
        namespace = context.namespace,
        records = context.records,
        unions = context.unions,
    }


record VariantContract {
    variant: VariantId,
    result_type: TypeRef,
    fields: List[TypeUse],
}


record DeclaredVariantContract {
    variant: VariantId,
    fields: List[TypeUse],
    parameters: List[TypeParameterId],
}


-- The one reader of a variant's declaration: its fields and the union's
-- parameters, for a variant identity the caller has already established.
private pure func declared_variant_contract(
    context: ConstructionContext,
    owner: UnionId,
    variant: VariantId,
    span: Span,
) -> Result[Option[DeclaredVariantContract], CheckError]:
    declaration ?= context.unions
        .get(owner.union_number())
        .or_checker_invariant(span, InvalidCheckedUnion(owner))
    found: Option[DeclaredVariantContract] = match declaration.variants.get(
        variant.variant_number(),
    ):
        Some(declared):
            if variant == declared.id:
                Some({
                    variant = declared.id,
                    fields = declared.fields,
                    parameters = declaration.type_parameters,
                })
            else:
                None
        None:
            None
    Ok(found)


-- A bare constructor is the one the caller's module sees under its name, and
-- it must belong to `owner`; an unimported constructor of the union is not found.
private pure func find_declared_variant(
    context: ConstructionContext,
    owner: UnionId,
    name: WrittenName,
) -> Result[Option[DeclaredVariantContract], CheckError]:
    match context.namespace.named_value(context.module, name.id):
        Some(NamedConstructor(variant)):
            context.declared_variant_contract(owner, variant, name.span)
        _:
            Ok(None)


pure func find_variant(
    context: ConstructionContext,
    occurrence: UnionOccurrence,
    name: WrittenName,
) -> Result[Option[VariantContract], CheckError]:
    found ?= context.find_declared_variant(occurrence.owner, name)
    match found:
        None:
            match context.unions.get(occurrence.owner.union_number()):
                None:
                    Err(checker_invariant(name.span, InvalidCheckedUnion(occurrence.owner)))
                Some(declaration):
                    var failure: Option[CheckError] = None
                    for variant in declaration.variants:
                        if variant.name.id == name.id:
                            failure = Some(
                                match_error(name.span, UnimportedConstructorPattern(variant.id)),
                            )
                            break
                    match failure:
                        Some(error): Err(error)
                        None: Ok(None)
        Some(variant):
            match variant.instantiate_pattern_variant(occurrence):
                Ok(contract): Ok(Some(contract))
                Err(error): Err(error)


-- Qualification selects an exported declaration, then the same membership
-- authority as a bare head checks it against the scrutinee's union.
pure func find_qualified_variant(
    context: ConstructionContext,
    occurrence: UnionOccurrence,
    qualified: ParsedQualified,
) -> Result[Option[VariantContract], CheckError]:
    aliased ?= context.namespace.aliased_module(context.module, qualified.module)
    declared ?= match context.namespace.offered_value(aliased.target, qualified.name.id):
        Ok(OfferedConstructor(variant)):
            context.declared_variant_contract(occurrence.owner, variant, qualified.name.span)
        Ok(_):
            Ok(None)
        Err(reason):
            Err(
                qualified_error(
                    qualified.name.span,
                    QualifiedNotOffered(
                        qualified.module.id,
                        qualified.name.id,
                        aliased.path,
                        reason,
                    ),
                ),
            )
    match declared:
        None:
            Ok(None)
        Some(variant):
            match variant.instantiate_pattern_variant(occurrence):
                Ok(contract): Ok(Some(contract))
                Err(error): Err(error)


private pure func instantiate_pattern_variant(
    variant: DeclaredVariantContract,
    occurrence: UnionOccurrence,
) -> Result[VariantContract, CheckError]:
    fields ?= variant.fields.occurrence_fields(occurrence)
    Ok({
        variant = variant.variant,
        result_type = NominalType(
            AggregateNominal(UnionAggregate(occurrence.owner)),
            occurrence.arguments,
        ),
        fields = fields,
    })


pure func resolve_record_field(
    name: WrittenName,
    owner: RecordId,
    context: ConstructionContext,
) -> Result[CheckedField, CheckError]:
    declaration ?= context.records
        .get(owner.record_number())
        .or_checker_invariant(name.span, InvalidRecordDeclaration(owner))
    match declaration.fields.find_field(name.id):
        Some(present): Ok(present)
        None: Err(record_error(name.span, UnknownRecordField(name.id, owner)))


record PlannedRecordField {
    field: FieldId,
    written: ValueExpression,
    expected: InferenceUse,
}


-- Literal and update fields share one RHS/constraint engine; only their origins differ.
union RecordOrigin:
    LiteralRecord(RecordId)
    UpdatedRecord(RecordId, PendingValue, Span, List[PendingRetainedField])


record PlannedRecordFields {
    origin: RecordOrigin,
    value_type: InferenceType,
    fields: List[PlannedRecordField],
    span: Span,
}


record RecordOccurrence {
    owner: RecordId,
    arguments: List[InferenceType],
}


pure func record_occurrence(value: InferenceType) -> Option[RecordOccurrence]:
    match value.inference_shape():
        InferredNominal(AggregateNominal(RecordAggregate(owner)), arguments):
            Some({ owner = owner, arguments = arguments })
        _:
            None


pure func record_argument_hints(arguments: List[InferenceType]) -> List[Option[InferenceType]]:
    arguments.map(pure func(value): Some(value))


record ResolvedLiteralField {
    field: CheckedField,
    written: ParsedRecordField,
}


-- Structural admission precedes child planning and preserves written order.
-- Only missing-field selection follows the declaration's field order.
pure func admit_record_fields(
    written: List[ParsedRecordField],
    span: Span,
    declaration: CheckedRecord,
) -> Result[List[ResolvedLiteralField], CheckError]:
    var resolved: List[ResolvedLiteralField] = []
    var previous: List[WrittenName] = []
    var failure: Option[CheckError] = None

    for field in written:
        result: Result[ResolvedLiteralField, CheckError] = match declaration.fields.find_field(
            field.name.id,
        ):
            None:
                Err(
                    record_error(
                        field.name.span,
                        UnknownRecordField(field.name.id, declaration.id),
                    ),
                )
            Some(declared):
                match previous.previous_declaration(field.name.id):
                    Some(first):
                        Err(
                            record_error(
                                field.name.span,
                                DuplicateLiteralField(field.name.id, first.span),
                            ),
                        )
                    None:
                        Ok({ field = declared, written = field })

        match result:
            Err(error):
                failure = Some(error)
                break
            Ok(resolved_field):
                resolved = resolved.append(resolved_field)
                previous = previous.append(resolved_field.written.name)

    _: Void ?= match failure:
        Some(error): Err(error)
        None: Ok(void)

    for field in declaration.fields:
        if (
            previous
                .previous_declaration(field.name.id)
                .is_some()
                .not()
        ):
            failure = Some(record_error(span, MissingRecordField(field.id, field.name.span)))
            break

    match failure:
        Some(error): Err(error)
        None: Ok(resolved)


pure func plan_record_literal(
    written: List[ParsedRecordField],
    span: Span,
    expectation: Option[InferenceType],
    context: ConstructionContext,
    slots: List[InferenceSlot],
) -> Result[PlannedBase, CheckError]:
    written_term: InferenceType ?= match expectation:
        Some(present): Ok(present)
        None: Err(record_error(span, RecordNeedsExpectedType))
    term ?= written_term.inference_head(slots, span)
    match term:
        CallVariable(_): Ok(PlannedContext(SuspendedRecord(written, span), term))
        _: written.plan_known_record(span, term, context)


private pure func plan_known_record(
    written: List[ParsedRecordField],
    span: Span,
    term: InferenceType,
    context: ConstructionContext,
) -> Result[PlannedBase, CheckError]:
    occurrence: RecordOccurrence ?= match term.record_occurrence():
        Some(present): Ok(present)
        None: Err(record_error(span, RecordNeedsExpectedType))
    owner = occurrence.owner
    declaration ?= context.records
        .get(owner.record_number())
        .or_checker_invariant(span, InvalidRecordDeclaration(owner))
    resolved ?= written.admit_record_fields(span, declaration)

    accepted = declaration
    if accepted.type_parameters.length() != occurrence.arguments.length():
        Err(checker_invariant(span, InvalidRecordDeclaration(owner)))
    else:
        hints = occurrence.arguments.record_argument_hints()
        var fields: List[PlannedRecordField] = []
        var found_error: Option[CheckError] = None

        for field in resolved:
            result = field.plan_record_field(accepted, hints)
            match result:
                Ok(planned_field):
                    fields = fields.append(planned_field)
                Err(field_error):
                    found_error = Some(field_error)
                    break

        match found_error:
            Some(error):
                Err(error)
            None:
                Ok(
                    PlannedRecord({
                        origin = LiteralRecord(owner),
                        value_type = term,
                        fields = fields,
                        span = span,
                    }),
                )


pure func plan_record_update(
    base: PendingValue,
    written: List[ParsedRecordField],
    span: Span,
    expression_span: Span,
    context: ConstructionContext,
    slots: List[InferenceSlot],
) -> Result[PlannedRecordFields, CheckError]:
    head ?= base
        .pending_type()
        .inference_head(slots, expression_span)
    occurrence_result: Result[RecordOccurrence, CheckError] = match head.record_occurrence():
        Some(value):
            Ok(value)
        None:
            match head.publish_inference_type(slots, DiagnosticInference, expression_span):
                Ok(actual): Err(record_error(expression_span, UpdateRequiresRecord(actual)))
                Err(error): Err(error)
    occurrence ?= occurrence_result
    declaration ?= context.records
        .get(occurrence.owner.record_number())
        .or_checker_invariant(span, InvalidRecordDeclaration(occurrence.owner))
    hints = occurrence.arguments.record_argument_hints()
    var replaced: List[Option[Span]] = []
    for _ in declaration.fields:
        replaced = replaced.append(None)
    var fields: List[PlannedRecordField] = []
    var failure: Option[CheckError] = None
    for written_field in written:
        planned: Result[PlannedRecordField, CheckError] = match resolve_record_field(
            written_field.name,
            occurrence.owner,
            context,
        ):
            Err(error):
                Err(error)
            Ok(field):
                match replaced.get(field.id.field_number()):
                    Some(Some(first)):
                        Err(
                            record_error(
                                written_field.name.span,
                                DuplicateUpdateField(written_field.name.id, first),
                            ),
                        )
                    Some(None):
                        plan_record_field(
                            { field = field, written = written_field },
                            declaration,
                            hints,
                        )
                    None:
                        Err(checker_invariant(span, InvalidRecordField(field.id)))
        match planned:
            Err(error):
                failure = Some(error)
                break
            Ok(field):
                fields = fields.append(field)
                replaced = replaced.set(field.field.field_number(), Some(written_field.name.span))
    _: Void ?= match failure:
        Some(error): Err(error)
        None: Ok(void)
    var inherited: List[PendingRetainedField] = []
    for field in declaration.fields:
        match replaced.get(field.id.field_number()):
            Some(None):
                annotation = field.value_type
                match annotation.value_type.apply_type_hint(declaration.type_parameters, hints):
                    Some(value_type):
                        inherited = inherited.append({ field = field.id, value_type = value_type })
                    None:
                        failure = Some(
                            checker_invariant(annotation.span, InvalidRecordField(field.id)),
                        )
                        break
            Some(Some(_)):
                void
            None:
                failure = Some(checker_invariant(span, InvalidRecordField(field.id)))
                break
    _: Void ?= match failure:
        Some(error): Err(error)
        None: Ok(void)
    Ok({
        origin = UpdatedRecord(occurrence.owner, base, expression_span, inherited),
        value_type = base.pending_type(),
        fields = fields,
        span = span,
    })


private pure func plan_record_field(
    field: ResolvedLiteralField,
    accepted: CheckedRecord,
    hints: List[Option[InferenceType]],
) -> Result[PlannedRecordField, CheckError]:
    annotation = field.field.value_type
    value_type ?= annotation.value_type
        .apply_type_hint(accepted.type_parameters, hints)
        .or_checker_invariant(annotation.span, InvalidRecordField(field.field.id))
    Ok({
        field = field.field.id,
        written = field.written.value,
        expected = { value_type = value_type, span = annotation.span },
    })


private pure func validate_record_field(
    field: PendingRecordField,
    slots: List[InferenceSlot],
) -> Result[Void, CheckError]:
    expected ?= field.expected.value_type.publish_inference_type(
        slots,
        CompleteInference,
        field.expected.span,
    )
    actual ?= field.value
        .pending_type()
        .publish_inference_type(slots, CompleteInference, field.value.span)
    if expected == actual:
        Ok(void)
    else:
        Err(
            record_error(
                field.value.span,
                RecordFieldTypeMismatch(
                    field.field,
                    { value_type = actual, span = field.value.span },
                    { value_type = expected, span = field.expected.span },
                ),
            ),
        )


pure func validate_record_fields(
    fields: List[PendingRecordField],
    slots: List[InferenceSlot],
) -> Result[Void, CheckError]:
    fields.first_error(
        pure func(field: PendingRecordField) -> Result[Void, CheckError]: field.validate_record_field(
            slots,
        ),
    )


-- Closed construction checks establish an actual type, not just a repeated
-- contextual term. Retain it as argument evidence just as closed calls do.
private pure func construction_result_type(
    term: InferenceType,
    readiness: InferenceReadiness,
    slots: List[InferenceSlot],
    span: Span,
) -> Result[InferenceType, CheckError]:
    match readiness:
        ClosedInference:
            term
                .publish_inference_type(slots, CompleteInference, span)
                .map(pure func(accepted): AcceptedType(accepted))
        DeferredInference:
            Ok(term)


private pure func is_deferred(value: PendingValue) -> Bool:
    match value.readiness:
        DeferredInference: True
        ClosedInference: False


-- A construction is closed only when every operand is closed and its own type
-- is fully inferred.
private pure func construction_readiness(
    operand_deferred: Bool,
    term: InferenceType,
    slots: List[InferenceSlot],
    span: Span,
) -> Result[InferenceReadiness, CheckError]:
    complete ?= term.inference_complete(slots, span)
    if complete.and(operand_deferred.not()):
        Ok(ClosedInference)
    else:
        Ok(DeferredInference)


pure func finish_pending_record(
    plan: PlannedRecordFields,
    fields: List[PendingRecordField],
    slots: List[InferenceSlot],
) -> Result[PendingValue, CheckError]:
    field_deferred = fields.any(
        pure func(field: PendingRecordField) -> Bool: field.value.is_deferred(),
    )
    operand_deferred = match plan.origin:
        LiteralRecord(_): field_deferred
        UpdatedRecord(_, base, _, _): field_deferred.or(base.is_deferred())
    readiness ?= construction_readiness(operand_deferred, plan.value_type, slots, plan.span)
    _: Void ?= match readiness:
        ClosedInference: fields.validate_record_fields(slots)
        DeferredInference: Ok(void)
    value_type ?= plan.value_type.construction_result_type(readiness, slots, plan.span)
    base: PendingBase = match plan.origin:
        LiteralRecord(owner):
            PendingConstructRecord(owner, fields)
        UpdatedRecord(owner, base, expression_span, inherited):
            PendingUpdateRecord(owner, base, expression_span, fields, inherited)
    Ok({
        span = plan.span,
        readiness = readiness,
        base = base,
        base_type = value_type,
        base_span = plan.span,
        operations = NoPendingOperations,
    })


private pure func pending_variant(
    variant_id: VariantId,
    name: WrittenName,
    expected: Option[InferenceType],
    slots: List[InferenceSlot],
    context: ConstructionContext,
) -> Result[PendingVariantContract, CheckError]:
    term: InferenceType ?= match expected:
        Some(present): Ok(present)
        None: Err(constructor_error(name.span, ConstructorNeedsExpectedType(name.id)))
    head ?= term.inference_head(slots, name.span)
    shape = head.inference_shape()
    owner_result: Result[UnionId, CheckError] = match shape:
        InferredNominal(AggregateNominal(UnionAggregate(owner)), _):
            Ok(owner)
        CallVariable(_):
            Err(constructor_error(name.span, ConstructorNeedsExpectedType(name.id)))
        _:
            match head.publish_inference_type(slots, DiagnosticInference, name.span):
                Ok(snapshot):
                    Err(constructor_error(name.span, VariantNotInExpectedType(name.id, snapshot)))
                Err(error):
                    Err(error)
    owner ?= owner_result
    declared ?= context.declared_variant_contract(owner, variant_id, name.span)
    variant_result: Result[DeclaredVariantContract, CheckError] = match declared:
        Some(variant):
            Ok(variant)
        None:
            match head.publish_inference_type(slots, DiagnosticInference, name.span):
                Ok(snapshot):
                    Err(constructor_error(name.span, VariantNotInExpectedType(name.id, snapshot)))
                Err(error):
                    Err(error)
    variant ?= variant_result
    arguments: List[InferenceType] = match shape:
        InferredNominal(AggregateNominal(UnionAggregate(_)), arguments): arguments
        _: []
    variant.instantiate_variant(head, arguments, name)


-- The contract of one declared variant under the union's type arguments
-- (empty for a nongeneric union). Bare and qualified constructors share it.
private pure func instantiate_variant(
    variant: DeclaredVariantContract,
    head: InferenceType,
    arguments: List[InferenceType],
    name: WrittenName,
) -> Result[PendingVariantContract, CheckError]:
    hints = arguments.record_argument_hints()
    var fields: List[InferenceUse] = []
    var failure: Option[CheckError] = None
    for annotation in variant.fields:
        match annotation.value_type.apply_type_hint(variant.parameters, hints):
            Some(value_type):
                fields = fields.append({ value_type = value_type, span = annotation.span })
            None:
                failure = Some(checker_invariant(name.span, GenericConstructorContract))
                break
    _: Void ?= match failure:
        Some(error): Err(error)
        None: Ok(void)
    Ok({ variant = variant.variant, result_type = head, fields = fields, span = name.span })


-- `Alias.Variant` names its union through the alias row, so no expected type
-- is needed to find the owner; a generic union still takes its arguments
-- from the expectation, as a bare constructor does.
private pure func pending_qualified_variant(
    declared: DeclaredVariantContract,
    name: WrittenName,
    expected: Option[InferenceType],
) -> Result[PendingVariantContract, CheckError]:
    owner = declared.variant.variant_owner()
    arguments: List[InferenceType] = match expected:
        Some(hint):
            match hint.inference_shape():
                InferredNominal(AggregateNominal(UnionAggregate(expected_owner)), values):
                    if expected_owner == owner:
                        values
                    else:
                        []
                _:
                    []
        None:
            []
    head: InferenceType = if arguments.is_empty():
        AcceptedType(NominalType(AggregateNominal(UnionAggregate(owner)), []))
    else:
        InferredNominal(AggregateNominal(UnionAggregate(owner)), arguments)
    _: Void ?= if (
        declared.parameters
            .is_empty()
            .or(
                arguments
                    .is_empty()
                    .not(),
            )
    ):
        Ok(void)
    else:
        Err(constructor_error(name.span, ConstructorNeedsExpectedType(name.id)))
    declared.instantiate_variant(head, arguments, name)


pure func plan_qualified_variant(
    owner: UnionId,
    variant: VariantId,
    name: WrittenName,
    arguments: List[ValueExpression],
    called: Bool,
    expected: Option[InferenceType],
    context: ConstructionContext,
    slots: List[InferenceSlot],
) -> Result[PlannedBase, CheckError]:
    contract ?= context.declared_variant_contract(owner, variant, name.span)
    declared ?= contract.or_checker_invariant(name.span, InvalidCheckedUnion(owner))
    normalized: Result[Option[InferenceType], CheckError] = match expected:
        Some(term):
            match term.inference_head(slots, name.span):
                Ok(head): Ok(Some(head))
                Err(error): Err(error)
        None:
            Ok(None)
    head ?= normalized
    match head:
        Some(term):
            match term:
                CallVariable(_):
                    if declared.parameters.is_empty():
                        declared.plan_known_qualified_variant(name, arguments, called, head)
                    else:
                        Ok(
                            PlannedContext(
                                SuspendedQualifiedVariant(declared, name, arguments, called),
                                term,
                            ),
                        )
                _:
                    declared.plan_known_qualified_variant(name, arguments, called, head)
        _:
            declared.plan_known_qualified_variant(name, arguments, called, head)


private pure func plan_known_qualified_variant(
    declared: DeclaredVariantContract,
    name: WrittenName,
    arguments: List[ValueExpression],
    called: Bool,
    expected: Option[InferenceType],
) -> Result[PlannedBase, CheckError]:
    contract ?= declared.pending_qualified_variant(name, expected)
    contract.plan_variant_arguments(name, arguments, called)


pure func plan_variant(
    variant: VariantId,
    name: WrittenName,
    arguments: List[ValueExpression],
    called: Bool,
    expected: Option[InferenceType],
    slots: List[InferenceSlot],
    context: ConstructionContext,
) -> Result[PlannedBase, CheckError]:
    term: InferenceType ?= match expected:
        Some(present): Ok(present)
        None: Err(constructor_error(name.span, ConstructorNeedsExpectedType(name.id)))
    head ?= term.inference_head(slots, name.span)
    match head:
        CallVariable(_):
            Ok(PlannedContext(SuspendedVariant(variant, name, arguments, called), head))
        _:
            variant.plan_known_variant(name, arguments, called, head, slots, context)


private pure func plan_known_variant(
    variant: VariantId,
    name: WrittenName,
    arguments: List[ValueExpression],
    called: Bool,
    expected: InferenceType,
    slots: List[InferenceSlot],
    context: ConstructionContext,
) -> Result[PlannedBase, CheckError]:
    contract ?= variant.pending_variant(name, Some(expected), slots, context)
    contract.plan_variant_arguments(name, arguments, called)


-- A payload-free variant takes no call, and a payload variant takes one
-- argument per field.
private pure func plan_variant_arguments(
    contract: PendingVariantContract,
    name: WrittenName,
    arguments: List[ValueExpression],
    called: Bool,
) -> Result[PlannedBase, CheckError]:
    if (
        contract.fields
            .is_empty()
            .and(called)
    ):
        Err(constructor_error(name.span, PayloadFreeVariantCalled(contract.variant)))
    else if contract.fields.length() != arguments.length():
        Err(
            constructor_error(
                name.span,
                ConstructorFieldCountMismatch(
                    contract.variant,
                    contract.fields.length(),
                    arguments.length(),
                ),
            ),
        )
    else:
        Ok(PlannedVariant(contract, arguments))


private pure func validate_variant_field(
    contract: PendingVariantContract,
    annotation: InferenceUse,
    value: PendingValue,
    position: Int,
    slots: List[InferenceSlot],
) -> Result[Void, CheckError]:
    expected ?= annotation.value_type.publish_inference_type(
        slots,
        CompleteInference,
        annotation.span,
    )
    actual ?= value
        .pending_type()
        .publish_inference_type(slots, CompleteInference, value.span)
    if expected == actual:
        Ok(void)
    else:
        Err(
            call_error(
                contract.span,
                ArgumentTypeMismatch({
                    expected = expected,
                    actual = { value_type = actual, span = value.span },
                    argument_position = position,
                    expected_site = SourceAnnotation(annotation.span),
                }),
            ),
        )


pure func validate_variant_fields(
    contract: PendingVariantContract,
    values: List[PendingValue],
    slots: List[InferenceSlot],
) -> Result[Void, CheckError]:
    var position = 0
    var failure: Option[CheckError] = None
    for value in values:
        result: Result[Void, CheckError] = match contract.fields.get(position):
            Some(annotation): contract.validate_variant_field(annotation, value, position, slots)
            None: Err(checker_invariant(contract.span, GenericConstructorContract))
        match result:
            Ok(_):
                void
            Err(error):
                failure = Some(error)
                break
        position = position + 1
    match failure:
        Some(error): Err(error)
        None: Ok(void)


pure func finish_pending_variant(
    contract: PendingVariantContract,
    values: List[PendingValue],
    span: Span,
    slots: List[InferenceSlot],
) -> Result[PendingValue, CheckError]:
    readiness ?= construction_readiness(values.any(is_deferred), contract.result_type, slots, span)
    _: Void ?= match readiness:
        ClosedInference: contract.validate_variant_fields(values, slots)
        DeferredInference: Ok(void)
    value_type ?= contract.result_type.construction_result_type(readiness, slots, span)
    Ok({
        span = span,
        readiness = readiness,
        base = PendingConstructVariant(contract, values),
        base_type = value_type,
        base_span = contract.span,
        operations = NoPendingOperations,
    })


-- A list literal is a construction of n stored occurrences. The expected List
-- type supplies E when the context establishes one; otherwise the first
-- element decides, so an empty literal without a List context is rejected.
pure func plan_list_literal(
    elements: List[ValueExpression],
    expectation: Option[InferenceType],
    span: Span,
) -> Result[PlannedBase, CheckError]:
    source: ListElementSource = match expectation:
        Some(hint):
            match hint.inference_shape():
                InferredList(element): ExpectedElementType(element)
                _: FirstElementType
        None:
            FirstElementType
    match source:
        ExpectedElementType(_):
            Ok(PlannedList(elements, source))
        FirstElementType:
            if elements.is_empty():
                Err(value_error(span, EmptyListNeedsElementType))
            else:
                Ok(PlannedList(elements, source))


pure func list_element_type(
    source: ListElementSource,
    values: List[PendingValue],
    span: Span,
) -> Result[InferenceType, CheckError]:
    match source:
        ExpectedElementType(element):
            Ok(element)
        FirstElementType:
            match (
                values
                    .get(0)
                    .or_checker_invariant(span, InvalidInferenceWorklist)
            ):
                Ok(first): Ok(first.pending_type())
                Err(error): Err(error)


-- Every element's published type must equal the published E; the first
-- mismatch is reported at that element, naming what it had to agree with.
pure func validate_list_elements(
    source: ListElementSource,
    values: List[PendingValue],
    slots: List[InferenceSlot],
    span: Span,
) -> Result[TypeRef, CheckError]:
    element ?= source.list_element_type(values, span)
    expected ?= element.publish_inference_type(slots, CompleteInference, span)
    reference: ListElementReference = match source:
        ExpectedElementType(_): ExpectedElement
        FirstElementType: EarlierElement
    var position = 1
    var failure: Option[CheckError] = None
    for value in values:
        match (
            value
                .pending_type()
                .publish_inference_type(slots, CompleteInference, value.span)
        ):
            Err(error):
                failure = Some(error)
                break
            Ok(actual):
                if expected != actual:
                    failure = Some(
                        value_error(
                            value.span,
                            ListElementTypeMismatch({
                                position = position,
                                actual = actual,
                                expected = expected,
                                reference = reference,
                            }),
                        ),
                    )
                    break
        position = position + 1
    match failure:
        Some(error): Err(error)
        None: Ok(expected)


pure func finish_pending_list(
    source: ListElementSource,
    values: List[PendingValue],
    span: Span,
    base_span: Span,
    slots: List[InferenceSlot],
) -> Result[PendingValue, CheckError]:
    element ?= source.list_element_type(values, base_span)
    readiness ?= construction_readiness(values.any(is_deferred), element, slots, base_span)
    value_type: InferenceType ?= match readiness:
        ClosedInference:
            source
                .validate_list_elements(values, slots, base_span)
                .map(pure func(accepted): AcceptedType(ListType(accepted)))
        DeferredInference:
            Ok(element.list_inference_type())
    Ok({
        span = span,
        readiness = readiness,
        base = PendingConstructList(source, values),
        base_type = value_type,
        base_span = base_span,
        operations = NoPendingOperations,
    })


union CallPlacement:
    ReturnPlacement(Span, Span)
    ReceiverPlacement(PendingValue, Span)


-- A construct whose nominal expected head is still a call-local variable.
-- Names already resolved to variants retain that identity while waiting.
union SuspendedConstruction:
    SuspendedRecord(List[ParsedRecordField], Span)
    SuspendedVariant(VariantId, WrittenName, List[ValueExpression], Bool)
    SuspendedQualifiedVariant(DeclaredVariantContract, WrittenName, List[ValueExpression], Bool)


pure func resume_construction(
    written: SuspendedConstruction,
    head: InferenceType,
    context: ConstructionContext,
    slots: List[InferenceSlot],
) -> Result[PlannedBase, CheckError]:
    match written:
        SuspendedRecord(fields, span):
            fields.plan_known_record(span, head, context)
        SuspendedVariant(variant, name, arguments, called):
            variant.plan_known_variant(name, arguments, called, head, slots, context)
        SuspendedQualifiedVariant(declared, name, arguments, called):
            declared.plan_known_qualified_variant(name, arguments, called, Some(head))


pure func construction_context_error(written: SuspendedConstruction) -> CheckError:
    match written:
        SuspendedRecord(_, span):
            record_error(span, RecordNeedsExpectedType)
        SuspendedVariant(_, name, _, _):
            constructor_error(name.span, ConstructorNeedsExpectedType(name.id))
        SuspendedQualifiedVariant(_, name, _, _):
            constructor_error(name.span, ConstructorNeedsExpectedType(name.id))


union PlannedBase:
    PlannedContext(SuspendedConstruction, InferenceType)
    PlannedCallable(ValueExpression, Option[InferenceType])
    PlannedLeaf(PendingBase, TypeRef)
    PlannedConstructOpaque(CheckedOpaque, ValueExpression)
    PlannedProjectOpaque(CheckedOpaque, ValueExpression)
    PlannedRecord(PlannedRecordFields)
    PlannedUpdate(ValueExpression, List[ParsedRecordField], Option[InferenceType])
    PlannedVariant(PendingVariantContract, List[ValueExpression])
    PlannedTuple(List[ValueExpression], List[Option[InferenceType]])
    PlannedInterpolation(List[ValueExpression])
    PlannedList(List[ValueExpression], ListElementSource)
    PlannedCall(FunctionContract, List[ValueExpression], CallPlacement, Option[InferenceType])
    -- A populated Dict literal: the `dict` contract, then the `set`
    -- contract each entry calls.
    PlannedDict(FunctionContract, FunctionContract, List[ParsedDictEntry], Option[InferenceType])
    PlannedStoredCall(
        CheckedExpr,
        FunctionContract,
        List[ValueExpression],
        CallPlacement,
        Option[InferenceType],
    )
