---
Synchronous loans use the parsed opaque declaration as their resource authority.
These checks publish no runtime or downstream lifetime representation.
---
import:
    bool: Bool methods
    result: Result methods
    ../../syntax/syntax: Span, Purity(Pure)
    ../ids: OpaqueId, OpaqueRow, opaque_number
    ./errors as errors: CheckError, ResourceUse, checker_invariant, resource_error
    ./model as model: TypeRef, type_children


-- `id` when it declares a resource type. The inventory issued every OpaqueId,
-- so a miss is a checker defect: it stops the check instead of reading as
-- "not a resource", which would turn the loan rules off.
pure func declared_resource(
    id: OpaqueId,
    opaques: List[OpaqueRow],
    span: Span
) -> Result[Option[OpaqueId], CheckError]:
    match opaques.get(id.opaque_number()):
        Some(row):
            if row.declaration.resource_type:
                Ok(Some(id))
            else:
                Ok(None)
        None:
            Err(checker_invariant(span, errors.InvalidOpaqueDeclaration(id)))


-- The resource the whole type is, if it is one.
pure func as_resource(
    value_type: TypeRef,
    opaques: List[OpaqueRow],
    span: Span
) -> Result[Option[OpaqueId], CheckError]:
    match value_type:
        model.NominalType(model.OpaqueNominal(id), _):
            id.declared_resource(opaques, span)
        model.NominalType(model.AggregateNominal(_), _) | model.ListType(_) | model.TupleType(_) | model.CallableType(_, _, _) | model.VoidType | model.IntegerType(_) | model.FloatType | model.StringType | model.ParameterType(_):
            Ok(None)


-- The first resource the type mentions, the type itself first.
pure func mentioned_resource(
    value_type: TypeRef,
    opaques: List[OpaqueRow],
    span: Span
) -> Result[Option[OpaqueId], CheckError]:
    found = value_type.as_resource(opaques, span)
    match found:
        Ok(None):
            value_type
                .type_children()
                .first_mentioned(opaques, span)
        Ok(Some(_)) | Err(_):
            found


-- The first resource any of the types mentions.
pure func first_mentioned(
    types: List[TypeRef],
    opaques: List[OpaqueRow],
    span: Span
) -> Result[Option[OpaqueId], CheckError]:
    var found: Result[Option[OpaqueId], CheckError] = Ok(None)
    for value_type in types:
        match found:
            Ok(None): found = value_type.mentioned_resource(opaques, span)
            Ok(Some(_)) | Err(_): break
    found


-- Rejects the resource the search found, if any, as a `use` it cannot have.
pure func refuse(
    found: Result[Option[OpaqueId], CheckError],
    span: Span,
    use: ResourceUse
) -> Result[Void, CheckError]:
    held ?= found
    match held:
        Some(id): Err(resource_error(span, errors.MisusedResource(id, use)))
        None: Ok(void)


-- Rejects the type as a `use` it cannot have when it is a resource.
pure func refuse_resource(
    value_type: TypeRef,
    opaques: List[OpaqueRow],
    span: Span,
    use: ResourceUse
) -> Result[Void, CheckError]:
    value_type
        .as_resource(opaques, span)
        .refuse(span, use)


pure func resource_free(
    value_type: TypeRef,
    opaques: List[OpaqueRow],
    span: Span
) -> Result[Void, CheckError]:
    value_type
        .mentioned_resource(opaques, span)
        .refuse(span, errors.ResourceStorage)


-- A written resource may appear as a whole impure callable input. Source containers
-- and generic applications cannot contain even a resource-taking callable.
pure func admit_resource_type(
    value_type: TypeRef,
    opaques: List[OpaqueRow],
    span: Span
) -> Result[Void, CheckError]:
    match value_type:
        model.CallableType(purity, parameters, result):
            var admitted: Result[Void, CheckError] = Ok(void)
            for parameter in parameters:
                if (purity == Pure).and(admitted.is_ok()):
                    admitted = parameter.refuse_resource(
                        opaques,
                        span,
                        errors.ResourcePureParameter
                    )
                if admitted.is_ok():
                    admitted = parameter.admit_resource_type(opaques, span)
            if admitted.is_ok():
                admitted = result.refuse_resource(opaques, span, errors.ResourceResult)
            if admitted.is_ok():
                admitted = result.admit_resource_type(opaques, span)
            admitted
        model.ListType(_) | model.NominalType(_, _):
            value_type
                .type_children()
                .first_mentioned(opaques, span)
                .refuse(span, errors.ResourceTypeArgument)
        model.TupleType(_):
            value_type.resource_free(opaques, span)
        model.VoidType | model.IntegerType(_) | model.FloatType | model.StringType | model.ParameterType(_):
            Ok(void)


-- Admits a type Self was read into as `resolve_type` admits a written one.
-- `whole` is what a resource may not be in this place, if anything.
pure func admit_as_written(
    value_type: TypeRef,
    opaques: List[OpaqueRow],
    span: Span,
    whole: Option[ResourceUse]
) -> Result[Void, CheckError]:
    _: Void ?= match whole:
        Some(use): value_type.refuse_resource(opaques, span, use)
        None: Ok(void)
    value_type.admit_resource_type(opaques, span)
