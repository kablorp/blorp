---
Checks union and record declarations and resolves written type terms
against the frozen namespace, including declared type parameters.
---
import:
    ../../syntax/names: NameId
    ../../syntax/source: ModuleId
    ../../syntax/syntax:
        ParsedReceiverHead(ReceiverName, QualifiedReceiverName),
        ParsedQualified,
        ParsedRecord,
        ParsedTypeParameter,
        Span,
        compiler_span,
        TypeSyntax(TupleTypeSyntax, AtomicType, AppliedType, QualifiedType, CallableTypeSyntax),
        UnionKind(FixedUnion),
        WrittenName,
        Visibility(Private, Public)
    ../../utils/results: first_error, translated_list
    ../../utils/stack: push_at
    ../assemble: ParsedContents
    ../ids:
        RecordRow,
        UnionRow,
        NominalRow(UnionDeclarationRow, RecordDeclarationRow),
        DeclarationInventory,
        RecordId,
        UnionId,
        inventory_records,
        inventory_unions
    ../namespace/builtins: integer_fixed_storage
    ../namespace/namespace:
        AliasedModule,
        Unoffered,
        Namespace,
        NamedValue(NamedAlias),
        TraitReference,
        TypeHead(PrimitiveHead, ListHead, UnionHead, RecordHead),
        Origin(Declared)
    ./errors as errors:
        CheckError,
        CheckerInvariant(
            InvalidParameterDeclaration,
            InvalidUnionDeclaration,
            InvalidRecordDeclaration,
            InvalidDeclarationVisit
        ),
        TypeDeclarationError(
            DuplicateRecordField,
            DuplicateTypeParameter,
            TypeParameterTypeNameConflict,
            GrowingRecursiveType,
            NonFixedPayload,
            NonFixedField,
            RecursiveFixedType
        ),
        TraitError(InvalidTraitBound),
        TypeTermError(
            PrivateTypeInPublicDeclaration,
            TraitUsedAsType,
            ListTypeArgumentCount,
            NonApplicableType,
            MissingTypeArguments,
            TypeArgumentCountMismatch,
            OrdinaryTypeApplied,
            UnknownType
        ),
        QualifiedError(UnknownModuleAlias, QualifiedNotOffered),
        qualified_error,
        checker_invariant,
        or_checker_invariant,
        trait_error,
        type_declaration_error,
        type_term_error
    ./instantiation_paths: InstantiationPath, PathOperation(KeepPath), strong_components
    ./model:
        substitute_parameters,
        CheckedField,
        CheckedRecord,
        CheckedUnion,
        CheckedVariant,
        LocatedTrait,
        UnionStorage(StoredAsPayload, StoredByValue, StoredOnHeap),
        TraitRequirement,
        TypeParameterId,
        TypeParameterOwner(
            TraitDeclaration,
            FunctionDeclaration,
            UnionDeclaration,
            RecordDeclaration,
            TupleDeclaration
        ),
        TypeRef(
            TupleType,
            CallableType,
            NominalType,
            VoidType,
            FloatType,
            IntegerType,
            ListType,
            ParameterType,
            StringType
        ),
        AggregateId(RecordAggregate, UnionAggregate),
        NominalId(AggregateNominal),
        TypeUse,
        UnionOccurrence,
        aggregate_owner,
        field_id,
        primitive_ref,
        type_parameter_id
    ./name_uses:
        NameUse,
        Referent(TypeReferent, TypeParameterReferent, ModuleReferent),
        name_use,
        trait_uses
    ./resource_types: TypeRef methods


pure func previous_declaration(previous: List[WrittenName], name: NameId) -> Option[WrittenName]:
    var found: Option[WrittenName] = None

    for known in previous:
        if known.id == name:
            found = Some(known)
            break

    found


-- `Self` where a trait or an implementation is checked: the type it stands
-- for, and what it names, the trait or the implementation's receiver type.
record SelfBinding {
    name: NameId,
    value_type: TypeRef,
    referent: Referent
}


-- The type names visible where a type is written: the module's namespace, the
-- declarations' row tables and the enclosing declaration's own type parameters.
record TypeScope {
    self_binding: Option[SelfBinding],
    inventory: DeclarationInventory,
    namespace: Namespace,
    module: ModuleId,
    access: TypeAccess,
    parameters: List[LocalTypeParameter]
}


fixed union TypeAccess:
    PrivateTypeUse
    PublicTypeUse(NameId)


pure func type_access(visibility: Visibility, declaration: NameId) -> TypeAccess:
    match visibility:
        Private(_): PrivateTypeUse
        Public: PublicTypeUse(declaration)


record LocalTypeParameter {
    name: WrittenName,
    id: TypeParameterId
}


private pure func lookup_type_parameter(
    parameters: List[LocalTypeParameter],
    name: NameId
) -> Option[LocalTypeParameter]:
    var found: Option[LocalTypeParameter] = None

    for parameter in parameters:
        if parameter.name.id == name:
            found = Some(parameter)
            break

    found


-- Declares a declaration's own type parameters in the scope of its module.
pure func local_type_parameters(
    written: List[ParsedTypeParameter],
    owner: TypeParameterOwner,
    module_scope: TypeScope
) -> Result[TypeScope, CheckError]:
    written.declare_type_parameters(owner, { module_scope | parameters = [] })


-- Declares the type parameters in order; each name is new and is not already
-- a visible type.
private pure func declare_type_parameters(
    written: List[ParsedTypeParameter],
    owner: TypeParameterOwner,
    scope: TypeScope
) -> Result[TypeScope, CheckError]:
    match written.get(scope.parameters.length()):
        None:
            Ok(scope)
        Some(parameter):
            name = parameter.name
            id = type_parameter_id(owner, scope.parameters.length())

            match scope.parameters.lookup_type_parameter(name.id):
                Some(previous):
                    Err(
                        type_declaration_error(
                            name.span,
                            DuplicateTypeParameter(id, previous.id, previous.name.span)
                        )
                    )
                None:
                    if (
                        scope.namespace
                            .named_type(scope.module, name.id)
                            .is_none()
                    ):
                        written.declare_type_parameters(
                            owner,
                            { scope |
                                parameters = scope.parameters.append({ name = name, id = id })
                            }
                        )
                    else:
                        Err(
                            type_declaration_error(
                                name.span,
                                TypeParameterTypeNameConflict(name.id)
                            )
                        )


pure func declared_parameters(scope: TypeScope) -> List[TypeParameterId]:
    scope.parameters.map(pure func(parameter: LocalTypeParameter): parameter.id)


-- Each parameter's bounds, in order, and the names they use.
record ResolvedBounds {
    bounds: List[List[LocatedTrait]],
    uses: List[NameUse]
}


-- Bounds are resolved once at their written declaration, one list per
-- parameter in order.
pure func resolve_bounds(
    parameters: List[ParsedTypeParameter],
    scope: TypeScope
) -> Result[ResolvedBounds, CheckError]:
    var resolved: List[List[LocatedTrait]] = []
    var uses: List[NameUse] = []
    var failure: Option[CheckError] = None

    for parameter in parameters:
        var bounds: List[LocatedTrait] = []

        for written in parameter.bounds:
            match scope.namespace.resolve_trait(scope.module, written):
                Some(reference):
                    bounds = bounds.append({
                        required_trait = reference.referenced_trait(),
                        span = written.type_span()
                    })

                    uses = uses.concat(reference.trait_uses())
                None:
                    failure = Some(trait_error(written.type_span(), InvalidTraitBound))
                    break

        resolved = resolved.append(bounds)

        if failure.is_some():
            break

    match failure:
        Some(error): Err(error)
        None: Ok({ bounds = resolved, uses = uses })


-- Attaches each parameter's resolved bounds to that parameter's identity in
-- `owner`'s domain, in declaration order.
pure func parameter_requirements(
    bounds: List[List[LocatedTrait]],
    owner: TypeParameterOwner
) -> List[TraitRequirement]:
    var requirements: List[TraitRequirement] = []
    var position = 0

    for parameter in bounds:
        id = type_parameter_id(owner, position)

        for bound in parameter:
            requirements = requirements.append({
                parameter = id,
                required_trait = bound.required_trait,
                span = bound.span
            })

        position = position + 1

    requirements


-- The number of type parameters a record or union declares.
private pure func nominal_arity(
    scope: TypeScope,
    owner: NominalId,
    span: Span
) -> Result[Int, CheckError]:
    match owner:
        AggregateNominal(RecordAggregate(id)):
            match inventory_records(scope.inventory).get(id.record_number()):
                Some(row): Ok(row.declaration.type_parameters.length())
                None: Err(checker_invariant(span, InvalidRecordDeclaration(id)))
        AggregateNominal(UnionAggregate(id)):
            match inventory_unions(scope.inventory).get(id.union_number()):
                Some(row): Ok(row.type_parameters.length())
                None: Err(checker_invariant(span, InvalidUnionDeclaration(id)))


-- A nominal head written alone, which its declaration must not need arguments for.
private pure func unapplied_nominal(
    scope: TypeScope,
    owner: NominalId,
    span: Span
) -> Result[TypeRef, CheckError]:
    arity ?= scope.nominal_arity(owner, span)

    if arity == 0:
        Ok(NominalType(owner, []))
    else:
        Err(type_term_error(span, MissingTypeArguments(owner, arity)))


-- A nominal head with written arguments, which must match its arity.
private pure func resolve_nominal(
    scope: TypeScope,
    owner: NominalId,
    arguments: List[TypeSyntax],
    span: Span,
    uses: List[NameUse]
) -> Result[ResolvedType, CheckError]:
    arity ?= scope.nominal_arity(owner, span)

    if arity == arguments.length():
        match scope.resolve_types(arguments, [], uses):
            Ok(ResolvedTypeTerms(values, recorded)):
                Ok(ResolvedTypeTerm(NominalType(owner, values), recorded))
            Err(error):
                Err(error)
    else if arity == 0:
        Err(type_term_error(span, OrdinaryTypeApplied(owner)))
    else:
        Err(type_term_error(span, TypeArgumentCountMismatch(owner, arity, arguments.length())))


-- A resolved written type and the uses so far. A union, because a union is
-- returned by value: as a plain record, a heap cell today, it cost 22,253 more
-- allocations per self-compile (+0.16%). It becomes a record once records are
-- passed by value.
union ResolvedType:
    ResolvedTypeTerm(TypeRef, List[NameUse])


pure func resolved_value_type(resolved: ResolvedType) -> TypeRef:
    match resolved:
        ResolvedTypeTerm(value_type, _): value_type


pure func resolved_uses(resolved: ResolvedType) -> List[NameUse]:
    match resolved:
        ResolvedTypeTerm(_, uses): uses


-- Written types resolved in order, carried as `ResolvedType` is.
private union ResolvedTypes:
    ResolvedTypeTerms(List[TypeRef], List[NameUse])


private pure func resolve_atomic_head(
    scope: TypeScope,
    head: TypeHead,
    name: WrittenName
) -> Result[TypeRef, CheckError]:
    match head:
        PrimitiveHead(primitive): Ok(primitive.primitive_ref())
        ListHead: Err(type_term_error(name.span, ListTypeArgumentCount))
        RecordHead(id): scope.unapplied_nominal(AggregateNominal(RecordAggregate(id)), name.span)
        UnionHead(id): scope.unapplied_nominal(AggregateNominal(UnionAggregate(id)), name.span)


-- One unqualified lookup validates access before publishing the head.
private pure func resolve_head(
    scope: TypeScope,
    name: WrittenName,
    missing: TypeTermError
) -> Result[TypeHead, CheckError]:
    match scope.namespace.named_type(scope.module, name.id):
        None:
            match scope.namespace.named_trait(scope.module, name.id):
                Some(id): Err(type_term_error(name.span, TraitUsedAsType(id)))
                None: Err(type_term_error(name.span, missing))
        Some(found):
            match scope.access:
                PublicTypeUse(declaration):
                    match found.origin:
                        Declared(Private(_)):
                            Err(
                                type_term_error(
                                    name.span,
                                    PrivateTypeInPublicDeclaration(name.id, declaration)
                                )
                            )
                        _:
                            Ok(found.head)
                PrivateTypeUse:
                    Ok(found.head)


private pure func scoped_type(scope: TypeScope, name: WrittenName) -> Option[SelfBinding]:
    match scope.self_binding:
        Some(binding):
            if binding.name == name.id:
                Some(binding)
            else:
                None
        None:
            None


private pure func resolve_atomic_type(
    scope: TypeScope,
    name: WrittenName,
    uses: List[NameUse]
) -> Result[ResolvedType, CheckError]:
    match scope.scoped_type(name):
        Some(binding):
            Ok(ResolvedTypeTerm(binding.value_type, uses.append(name.name_use(binding.referent))))
        None:
            match scope.parameters.lookup_type_parameter(name.id):
                Some(parameter):
                    Ok(
                        ResolvedTypeTerm(
                            ParameterType(parameter.id),
                            uses.append(name.name_use(TypeParameterReferent(parameter.id)))
                        )
                    )
                None:
                    match scope.resolve_head(name, UnknownType(name.id)):
                        Ok(head):
                            match scope.resolve_atomic_head(head, name):
                                Ok(value_type):
                                    Ok(
                                        ResolvedTypeTerm(
                                            value_type,
                                            uses.append(name.name_use(TypeReferent(head)))
                                        )
                                    )
                                Err(error):
                                    Err(error)
                        Err(error):
                            Err(error)


-- A head applied to written arguments; the head's own arity rules.
private pure func resolve_applied_head(
    scope: TypeScope,
    head: TypeHead,
    name: WrittenName,
    arguments: List[TypeSyntax],
    span: Span,
    uses: List[NameUse]
) -> Result[ResolvedType, CheckError]:
    match head:
        ListHead:
            match arguments:
                [element]:
                    match scope.resolve_type(element, uses):
                        Ok(ResolvedTypeTerm(value, recorded)):
                            Ok(ResolvedTypeTerm(ListType(value), recorded))
                        Err(error):
                            Err(error)
                _:
                    Err(type_term_error(span, ListTypeArgumentCount))
        RecordHead(owner):
            scope.resolve_nominal(AggregateNominal(RecordAggregate(owner)), arguments, span, uses)
        UnionHead(owner):
            scope.resolve_nominal(AggregateNominal(UnionAggregate(owner)), arguments, span, uses)
        PrimitiveHead(_):
            Err(type_term_error(name.span, NonApplicableType(name.id)))


-- An implementation's receiver head, and the names it was written with.
record ResolvedReceiverHead {
    head: TypeHead,
    uses: List[NameUse]
}


-- Receiver families name one head; their binders are accepted separately.
pure func resolve_receiver_head(
    scope: TypeScope,
    written: ParsedReceiverHead
) -> Result[ResolvedReceiverHead, CheckError]:
    match written:
        ReceiverName(name):
            match scope.resolve_head(name, UnknownType(name.id)):
                Ok(head): Ok({ head = head, uses = [name.name_use(TypeReferent(head))] })
                Err(error): Err(error)
        QualifiedReceiverName(qualified):
            match scope.namespace.aliased_module(scope.module, qualified.module):
                Err(error):
                    Err(error)
                Ok(aliased):
                    match scope.namespace.offered_type(aliased.target, qualified.name.id):
                        Ok(head):
                            Ok({
                                head = head,
                                uses = [
                                    qualified.module.name_use(ModuleReferent(aliased.target)),
                                    qualified.name.name_use(TypeReferent(head))
                                ]
                            })
                        Err(reason):
                            Err(scope.qualified_type_rejection(aliased, qualified, reason))


pure func receiver_arity(scope: TypeScope, head: TypeHead, span: Span) -> Result[Int, CheckError]:
    match head:
        ListHead: Ok(1)
        RecordHead(owner): scope.nominal_arity(AggregateNominal(RecordAggregate(owner)), span)
        UnionHead(owner): scope.nominal_arity(AggregateNominal(UnionAggregate(owner)), span)
        PrimitiveHead(_): Ok(0)


-- The module `written` names as a module alias in `module`.
pure func aliased_module(
    namespace: Namespace,
    module: ModuleId,
    written: WrittenName
) -> Result[AliasedModule, CheckError]:
    match namespace.named_value(module, written.id):
        Some(NamedAlias(aliased)): Ok(aliased)
        _: Err(qualified_error(written.span, UnknownModuleAlias(written.id)))


-- `Alias.Name[args]` names a type the aliased module offers.
private pure func resolve_qualified_type(
    scope: TypeScope,
    qualified: ParsedQualified,
    arguments: List[TypeSyntax],
    span: Span,
    uses: List[NameUse]
) -> Result[ResolvedType, CheckError]:
    aliased ?= scope.namespace.aliased_module(scope.module, qualified.module)

    head: TypeHead ?= match scope.namespace.offered_type(aliased.target, qualified.name.id):
        Ok(head): Ok(head)
        Err(reason): Err(scope.qualified_type_rejection(aliased, qualified, reason))

    named = uses
        .append(qualified.module.name_use(ModuleReferent(aliased.target)))
        .append(qualified.name.name_use(TypeReferent(head)))

    if arguments.is_empty():
        match scope.resolve_atomic_head(head, qualified.name):
            Ok(value_type): Ok(ResolvedTypeTerm(value_type, named))
            Err(error): Err(error)
    else:
        scope.resolve_applied_head(head, qualified.name, arguments, span, named)


-- Produce the rejection fact before wrapping it in the caller's Result. This
-- keeps the two failed lookup cases on one ordinary publication boundary.
private pure func qualified_type_rejection(
    scope: TypeScope,
    aliased: AliasedModule,
    qualified: ParsedQualified,
    reason: Unoffered
) -> CheckError:
    match scope.namespace.offered_trait(aliased.target, qualified.name.id):
        Ok(id):
            type_term_error(qualified.name.span, TraitUsedAsType(id))
        Err(_):
            qualified_error(
                qualified.name.span,
                QualifiedNotOffered(qualified.module.id, qualified.name.id, aliased.path, reason)
            )


-- `written` resolved in `scope`, with each name it uses appended to `uses`.
pure func resolve_type(
    scope: TypeScope,
    written: TypeSyntax,
    uses: List[NameUse]
) -> Result[ResolvedType, CheckError]:
    resolved ?= scope.resolve_written_type(written, uses)

    _: Void ?= resolved
        .resolved_value_type()
        .admit_resource_type(scope.inventory, written.type_span())

    Ok(resolved)


private pure func resolve_written_type(
    scope: TypeScope,
    written: TypeSyntax,
    uses: List[NameUse]
) -> Result[ResolvedType, CheckError]:
    match written:
        TupleTypeSyntax(elements, _):
            match scope.resolve_types(elements, [], uses):
                Ok(ResolvedTypeTerms(values, recorded)):
                    Ok(ResolvedTypeTerm(TupleType(values), recorded))
                Err(error):
                    Err(error)
        CallableTypeSyntax(purity, parameters, result, _):
            match scope.resolve_types(parameters, [], uses):
                Err(error):
                    Err(error)
                Ok(ResolvedTypeTerms(values, recorded)):
                    match scope.resolve_type(result, recorded):
                        Err(error):
                            Err(error)
                        Ok(ResolvedTypeTerm(returned, all)):
                            Ok(ResolvedTypeTerm(CallableType(purity, values, returned), all))
        QualifiedType(qualified, arguments, span):
            scope.resolve_qualified_type(qualified, arguments, span, uses)
        AtomicType(name):
            scope.resolve_atomic_type(name, uses)
        AppliedType(name, arguments, span):
            match scope.scoped_type(name):
                Some(_):
                    Err(type_term_error(name.span, NonApplicableType(name.id)))
                None:
                    match scope.resolve_head(name, NonApplicableType(name.id)):
                        Ok(head):
                            scope.resolve_applied_head(
                                head,
                                name,
                                arguments,
                                span,
                                uses.append(name.name_use(TypeReferent(head)))
                            )
                        Err(error):
                            Err(error)


-- Each accumulator passes from one call to the next and is never held across
-- one, so each append is in place.
private pure func resolve_types(
    scope: TypeScope,
    written: List[TypeSyntax],
    resolved: List[TypeRef],
    uses: List[NameUse]
) -> Result[ResolvedTypes, CheckError]:
    match written.get(resolved.length()):
        None:
            Ok(ResolvedTypeTerms(resolved, uses))
        Some(argument):
            match scope.resolve_type(argument, uses):
                Ok(ResolvedTypeTerm(value, recorded)):
                    scope.resolve_types(written, resolved.append(value), recorded)
                Err(error):
                    Err(error)


record CheckedDeclarations {
    unions: List[CheckedUnion],
    records: List[CheckedRecord]
}


-- The checked nominal declarations, and the names their bounds and
-- annotations use.
record DeclaredTypes {
    declarations: CheckedDeclarations,
    uses: List[NameUse]
}


-- A union declaration with its annotations resolved, before
-- validate_finite_declarations classifies its storage into a CheckedUnion.
private record ResolvedUnion {
    id: UnionId,
    module: ModuleId,
    name: WrittenName,
    type_parameters: List[TypeParameterId],
    requirements: List[TraitRequirement],
    variants: List[CheckedVariant],
    fixed: Bool
}


-- A record declaration with its annotations resolved, before
-- validate_finite_declarations publishes it as a CheckedRecord with whether
-- it contains itself. Only Check reads `fixed`, to enforce it on the fields.
private record ResolvedRecord {
    id: RecordId,
    type_parameters: List[TypeParameterId],
    requirements: List[TraitRequirement],
    fields: List[CheckedField],
    fixed: Bool
}


-- The nominal declarations with every annotation resolved, which the finite
-- storage checks read before any is published.
private record ResolvedDeclarations {
    unions: List[ResolvedUnion],
    records: List[ResolvedRecord]
}


-- The resolved declarations, and the names their bounds and annotations use.
private record ResolvedNominals {
    declarations: ResolvedDeclarations,
    uses: List[NameUse]
}


private pure func declared_module(declaration: NominalRow) -> ModuleId:
    match declaration:
        UnionDeclarationRow(parsed_union): parsed_union.module
        RecordDeclarationRow(parsed_record): parsed_record.declaration.module


-- Every declaration resolved, proved finite and published with its storage
-- classified.
pure func validate_declarations(
    parsed: ParsedContents,
    namespace: Namespace
) -> Result[DeclaredTypes, CheckError]:
    resolved ?= parsed.declare_types(namespace, { unions = [], records = [] }, [])
    declarations ?= resolved.declarations.validate_finite_declarations()
    Ok({ declarations = declarations, uses = resolved.uses })


private pure func declare_types(
    parsed: ParsedContents,
    namespace: Namespace,
    resolved: ResolvedDeclarations,
    uses: List[NameUse]
) -> Result[ResolvedNominals, CheckError]:
    match parsed.declarations.next_nominal(resolved.records.length(), resolved.unions.length()):
        None:
            Ok({ declarations = resolved, uses = uses })
        Some(declaration):
            access = match declaration:
                UnionDeclarationRow(row):
                    type_access(row.visibility, row.type_name.id)
                RecordDeclarationRow(row):
                    type_access(row.declaration.visibility, row.declaration.type_name.id)

            scope: TypeScope = {
                self_binding = None,
                inventory = parsed.declarations,
                namespace = namespace,
                module = declaration.declared_module(),
                access = access,
                parameters = []
            }

            declared: Result[ResolvedNominals, CheckError] = match declaration:
                UnionDeclarationRow(parsed_union): parsed_union.resolved_union(scope, resolved)
                RecordDeclarationRow(parsed_record): parsed_record.resolved_record(scope, resolved)

            match declared:
                Ok(updated):
                    parsed.declare_types(namespace, updated.declarations, uses.concat(updated.uses))
                Err(error):
                    Err(error)


-- An annotation in a declaration resolved and proved free of resource types,
-- in that order, with the names it uses.
private pure func plain_annotation(
    scope: TypeScope,
    written: TypeSyntax
) -> Result[ResolvedType, CheckError]:
    resolved ?= scope.resolve_type(written, [])

    _: Void ?= resolved
        .resolved_value_type()
        .resource_free(scope.inventory, written.type_span())

    Ok(resolved)


-- Each declaration below returns the resolved declarations with itself
-- added, and its own uses.
private pure func resolved_union(
    row: UnionRow,
    module_scope: TypeScope,
    resolved: ResolvedDeclarations
) -> Result[ResolvedNominals, CheckError]:
    owner: TypeParameterOwner = UnionDeclaration(row.id)
    scope ?= row.type_parameters.local_type_parameters(owner, module_scope)
    bounds ?= row.type_parameters.resolve_bounds(scope)
    var variants: List[CheckedVariant] = []
    var uses: List[NameUse] = []
    var failure: Option[CheckError] = None

    for variant in row.variants:
        var fields: List[TypeUse] = []

        -- Only this module can see a private variant's payload, so the payload
        -- may mention private types (rule 5).
        payload_scope = match variant.visibility:
            Private(_): { scope | access = PrivateTypeUse }
            Public: scope

        for annotation in variant.declaration.fields:
            match payload_scope.plain_annotation(annotation):
                Ok(ResolvedTypeTerm(value_type, field_uses)):
                    fields = fields.append({
                        value_type = value_type,
                        span = annotation.type_span()
                    })

                    uses = uses.concat(field_uses)
                Err(error):
                    failure = Some(error)
                    break

        if failure.is_some():
            break

        variants = variants.append({
            id = variant.id,
            visibility = variant.visibility,
            name = variant.declaration.name,
            fields = fields
        })

    match failure:
        Some(error):
            Err(error)
        None:
            declared: ResolvedUnion = {
                id = row.id,
                module = row.module,
                name = row.type_name,
                type_parameters = scope.declared_parameters(),
                requirements = bounds.bounds.parameter_requirements(owner),
                variants = variants,
                fixed = row.kind == FixedUnion
            }

            Ok({
                declarations = { resolved | unions = resolved.unions.append(declared) },
                uses = bounds.uses.concat(uses)
            })


private pure func resolved_record(
    row: RecordRow,
    module_scope: TypeScope,
    resolved: ResolvedDeclarations
) -> Result[ResolvedNominals, CheckError]:
    owner: TypeParameterOwner = RecordDeclaration(row.id)
    scope ?= row.declaration.type_parameters.local_type_parameters(owner, module_scope)
    bounds ?= row.declaration.type_parameters.resolve_bounds(scope)
    var fields: List[CheckedField] = []
    var uses: List[NameUse] = []
    var failure: Option[CheckError] = None

    for field in row.declaration.fields:
        match fields.find_field(field.name.id):
            Some(first):
                failure = Some(
                    type_declaration_error(
                        field.name.span,
                        DuplicateRecordField(field.name.id, first.name.span)
                    )
                )
            None:
                match scope.plain_annotation(field.type_name):
                    Ok(ResolvedTypeTerm(value_type, field_uses)):
                        fields = fields.append({
                            id = field_id(row.id, fields.length()),
                            name = field.name,
                            value_type = {
                                value_type = value_type,
                                span = field.type_name.type_span()
                            }
                        })

                        uses = uses.concat(field_uses)
                    Err(error):
                        failure = Some(error)

        if failure.is_some():
            break

    match failure:
        Some(error):
            Err(error)
        None:
            declared: ResolvedRecord = {
                id = row.id,
                type_parameters = scope.declared_parameters(),
                requirements = bounds.bounds.parameter_requirements(owner),
                fields = fields,
                fixed = row.declaration.fixed
            }

            Ok({
                declarations = { resolved | records = resolved.records.append(declared) },
                uses = bounds.uses.concat(uses)
            })


-- Annotations resolved in order, each with its written span, and the names
-- they use.
record AnnotatedTypes {
    types: List[TypeUse],
    uses: List[NameUse]
}


-- `written` resolved after `types`, each with its written span, and `uses`
-- with the names they use. Each accumulator passes from one call to the next.
pure func annotated_types(
    scope: TypeScope,
    written: List[TypeSyntax],
    types: List[TypeUse],
    uses: List[NameUse]
) -> Result[AnnotatedTypes, CheckError]:
    match written.get(types.length()):
        None:
            Ok({ types = types, uses = uses })
        Some(annotation):
            match scope.resolve_type(annotation, uses):
                Ok(ResolvedTypeTerm(value_type, recorded)):
                    scope.annotated_types(
                        written,
                        types.append({ value_type = value_type, span = annotation.type_span() }),
                        recorded
                    )
                Err(error):
                    Err(error)


pure func find_field(fields: List[CheckedField], name: NameId) -> Option[CheckedField]:
    var found: Option[CheckedField] = None

    for field in fields:
        if field.name.id == name:
            found = Some(field)
            break

    found


-- Every field at one nominal union occurrence, with simultaneous substitution.
pure func occurrence_fields(
    fields: List[TypeUse],
    occurrence: UnionOccurrence
) -> Result[List[TypeUse], CheckError]:
    fields.substituted_fields({
        owner = UnionDeclaration(occurrence.owner),
        values = occurrence.arguments
    })


-- Each `TypeUse` with its type substituted, stopping at the first error. Union
-- fields and trait-method parameters both use it.
pure func substituted_fields(
    fields: List[TypeUse],
    substitution: Substitution
) -> Result[List[TypeUse], CheckError]:
    fields.translated_list(pure func(written: TypeUse) -> Result[TypeUse, CheckError]:
        written.value_type
            .substitute_type(substitution, written.span)
            .map(pure func(value: TypeRef) -> TypeUse: { written | value_type = value })
    )


-- One declaration's rigid type parameters replaced simultaneously, by
-- declaration position. Replacements are terminal: they are never substituted
-- again, so a caller's own parameters may appear among them.
record Substitution {
    owner: TypeParameterOwner,
    values: List[TypeRef]
}


pure func substitute_type(
    value_type: TypeRef,
    substitution: Substitution,
    span: Span
) -> Result[TypeRef, CheckError]:
    match value_type.substitute_parameters(substitution.owner, substitution.values):
        Ok(value): Ok(value)
        Err(missing): Err(checker_invariant(span, InvalidParameterDeclaration(missing)))


-- The written field and payload types of a record or union, with their own spans.
private pure func root_fields(
    root: AggregateId,
    declarations: ResolvedDeclarations
) -> Result[List[TypeUse], CheckError]:
    origin: Span = compiler_span()

    match root:
        UnionAggregate(id):
            match (
                declarations.unions
                    .get(id.union_number())
                    .or_checker_invariant(origin, InvalidUnionDeclaration(id))
            ):
                Ok(declaration):
                    var fields: List[TypeUse] = []

                    for variant in declaration.variants:
                        fields = fields.concat(variant.fields)

                    Ok(fields)
                Err(error):
                    Err(error)
        RecordAggregate(id):
            match (
                declarations.records
                    .get(id.record_number())
                    .or_checker_invariant(origin, InvalidRecordDeclaration(id))
            ):
                Ok(declaration):
                    var fields: List[TypeUse] = []

                    for field in declaration.fields:
                        fields = fields.append(field.value_type)

                    Ok(fields)
                Err(error):
                    Err(error)


-- One place where a declaration passes one of its own type parameters to a
-- type it applies, between the two parameters' controls: `Link(T, Chain[T])`
-- passes Chain's T unchanged, and `Nest(Nested[List[T]])` passes it inside a
-- List, which grows it. Reported at the written field or payload.
private record ParameterFlow {
    source: Int,
    target: Int,
    grows: Bool,
    span: Span
}


-- Each declaration's first control: one control per type parameter, unions
-- first, then records, each in declaration order.
private record ParameterControls {
    unions: List[Int],
    records: List[Int],
    count: Int
}


private pure func parameter_controls(declarations: ResolvedDeclarations) -> ParameterControls:
    var next = 0
    var unions: List[Int] = []

    for declaration in declarations.unions:
        unions = unions.append(next)
        next = next + declaration.type_parameters.length()

    var records: List[Int] = []

    for declaration in declarations.records:
        records = records.append(next)
        next = next + declaration.type_parameters.length()

    { unions = unions, records = records, count = next }


-- A type parameter's control. Only a type declaration owns the parameters a
-- declaration body names or passes arguments to.
private pure func parameter_control(
    controls: ParameterControls,
    parameter: TypeParameterId,
    span: Span
) -> Result[Int, CheckError]:
    first: Option[Int] = match parameter.parameter_owner():
        UnionDeclaration(id): controls.unions.get(id.union_number())
        RecordDeclaration(id): controls.records.get(id.record_number())
        TraitDeclaration(_) | FunctionDeclaration(_) | TupleDeclaration(_): None

    first
        .map(pure func(start): start + parameter.parameter_position())
        .or_checker_invariant(span, InvalidParameterDeclaration(parameter))


private pure func parameter_flow(
    controls: ParameterControls,
    source: TypeParameterId,
    target: TypeParameterId,
    grows: Bool,
    span: Span
) -> Result[ParameterFlow, CheckError]:
    start ?= controls.parameter_control(source, span)
    end ?= controls.parameter_control(target, span)
    Ok({ source = start, target = end, grows = grows, span = span })


private pure func parameters_in(value_type: TypeRef) -> List[TypeParameterId]:
    match value_type:
        ParameterType(id):
            [id]
        _:
            var found: List[TypeParameterId] = []

            for child in value_type.type_children():
                found = found.concat(child.parameters_in())

            found


-- `flows` with every flow of one written type of a declaration's body.
private pure func written_flows(
    written: TypeUse,
    controls: ParameterControls,
    flows: List[ParameterFlow]
) -> Result[List[ParameterFlow], CheckError]:
    var found: Result[List[ParameterFlow], CheckError] = Ok(flows)

    match written.value_type:
        NominalType(nominal, arguments):
            owner: TypeParameterOwner = match nominal:
                AggregateNominal(aggregate): aggregate.aggregate_owner()

            var position = 0

            for argument in arguments:
                target = type_parameter_id(owner, position)

                for parameter in argument.parameters_in():
                    grows = argument != ParameterType(parameter)

                    found = match found:
                        Ok(earlier):
                            controls
                                .parameter_flow(parameter, target, grows, written.span)
                                .map(pure func(flow): earlier.append(flow))
                        Err(error):
                            Err(error)

                position = position + 1
        _:
            void

    for child in written.value_type.type_children():
        inner: TypeUse = { written | value_type = child }

        found = match found:
            Ok(earlier): inner.written_flows(controls, earlier)
            Err(error): Err(error)

    found


-- Specialization makes one layout per type argument list, so every
-- declaration must reach finitely many applications of itself. That fails
-- exactly when a flow that grows its argument lies on a cycle of flows,
-- Kennedy and Pierce's expansive cycle: `Nested[T]: Nest(Nested[List[T]])`.
-- Passing a parameter unchanged, permuted or replaced by a closed type stays
-- finite, so `Chain[T]: Link(T, Chain[T])` is accepted. This is the rule
-- recursion.brp applies to calls, decided by the same strong components.
-- Every position counts, a List element and a record field included,
-- because specialization lays out every type it meets.
private pure func validate_type_growth(
    declarations: ResolvedDeclarations
) -> Result[Void, CheckError]:
    controls = declarations.parameter_controls()
    var written: List[TypeUse] = []

    for declaration in declarations.unions:
        for variant in declaration.variants:
            written = written.concat(variant.fields)

    for declaration in declarations.records:
        for field in declaration.fields:
            written = written.append(field.value_type)

    var collected: Result[List[ParameterFlow], CheckError] = Ok([])

    for field in written:
        collected = match collected:
            Ok(earlier): field.written_flows(controls, earlier)
            Err(error): Err(error)

    flows ?= collected

    -- strong_components reads its transitions as a plain graph, so every
    -- flow is passed as a kept path whatever it does to its argument.
    components = strong_components(
        controls.count,
        flows.map(
            pure func(flow) -> InstantiationPath: {
                source = flow.source,
                target = flow.target,
                operation = KeepPath
            }
        )
    )

    var growing: Option[Span] = None

    for flow in flows:
        -- parameter_control issued both ends below controls.count, and
        -- strong_components names a component for every such control.
        if flow.grows.and(components.get_or(flow.source, 0) == components.get_or(flow.target, 0)):
            growing = Some(flow.span)
            break

    match growing:
        Some(span): Err(type_declaration_error(span, GrowingRecursiveType))
        None: Ok(void)


-- Whether a stored type keeps a fixed declaration inline by its own declared
-- promise: Int, Float, a fixed record or a fixed union. An ordinary record or
-- union is not accepted even when it is unmanaged today: the promise must be
-- declared, so that editing that type cannot break this one.
private pure func fixed_storage(
    stored: TypeRef,
    span: Span,
    declarations: ResolvedDeclarations
) -> Result[Bool, CheckError]:
    match stored:
        IntegerType(format):
            Ok(format.integer_fixed_storage())
        FloatType:
            Ok(True)
        NominalType(AggregateNominal(UnionAggregate(id)), _):
            declarations.unions
                .get(id.union_number())
                .map(pure func(declaration: ResolvedUnion) -> Bool: declaration.fixed)
                .or_checker_invariant(span, InvalidUnionDeclaration(id))
        NominalType(AggregateNominal(RecordAggregate(id)), _):
            declarations.records
                .get(id.record_number())
                .map(pure func(declaration: ResolvedRecord) -> Bool: declaration.fixed)
                .or_checker_invariant(span, InvalidRecordDeclaration(id))
        _:
            Ok(False)


-- Every fixed declaration, unions then records, each in declaration order.
private pure func fixed_roots(declarations: ResolvedDeclarations) -> List[AggregateId]:
    var roots: List[AggregateId] = []

    for declaration in declarations.unions:
        if declaration.fixed:
            roots = roots.append(UnionAggregate(declaration.id))

    for declaration in declarations.records:
        if declaration.fixed:
            roots = roots.append(RecordAggregate(declaration.id))

    roots


-- The first field or payload of a fixed declaration that is not stored
-- inline, as its error.
private pure func unfixed_field(
    root: AggregateId,
    declarations: ResolvedDeclarations
) -> Result[Option[CheckError], CheckError]:
    fields ?= root.root_fields(declarations)

    -- A union payload may also be Void, which stores nothing.
    payloads: Bool = match root:
        UnionAggregate(_): True
        RecordAggregate(_): False

    var found: Result[Option[CheckError], CheckError] = Ok(None)

    for field in fields:
        accepted: Result[Bool, CheckError] = match field.value_type:
            VoidType: Ok(payloads)
            _: field.value_type.fixed_storage(field.span, declarations)

        found = match accepted:
            Ok(True):
                Ok(None)
            Ok(False):
                rejection: TypeDeclarationError = if payloads:
                    NonFixedPayload(field.value_type)
                else:
                    NonFixedField(field.value_type)

                Ok(Some(type_declaration_error(field.span, rejection)))
            Err(error):
                Err(error)

        match found:
            Ok(None): void
            _: break

    found


private pure func contains_aggregate(aggregates: List[AggregateId], id: AggregateId) -> Bool:
    aggregates.any(pure func(known: AggregateId) -> Bool: known == id)


-- Walks the fixed declarations `owner` stores by value, depth first, and
-- returns the declarations finished so far: those that reach no cycle.
-- `path` holds the declarations being walked, so a field stored as one of
-- them closes a cycle. Every field has passed `unfixed_field`, so only fixed
-- records and fixed unions are walked.
private pure func walk_fixed_type(
    owner: AggregateId,
    path: List[AggregateId],
    finished: List[AggregateId],
    declarations: ResolvedDeclarations
) -> Result[List[AggregateId], CheckError]:
    fields ?= owner.root_fields(declarations)
    var walked = finished
    var failure: Option[CheckError] = None

    for field in fields:
        if failure.is_none():
            match field.value_type:
                NominalType(AggregateNominal(target), _):
                    if path.contains_aggregate(target):
                        failure = Some(
                            type_declaration_error(
                                field.span,
                                RecursiveFixedType(field.value_type)
                            )
                        )
                    else if (
                        walked
                            .contains_aggregate(target)
                            .not()
                    ):
                        match target.walk_fixed_type(path.append(target), walked, declarations):
                            Ok(next): walked = next
                            Err(error): failure = Some(error)
                _:
                    void

    match failure:
        Some(error): Err(error)
        None: Ok(walked.append(owner))


-- A fixed record or fixed union promises the storage specialization gives a
-- declaration whose fields are all unmanaged and none of which contains it:
-- inline, with no counted child. Every field is checked before any cycle, so
-- a cycle can only pass through fixed declarations. A union that contains
-- itself is classified below and stored on the heap, which a fixed type
-- promises never to be, so a fixed type that contains itself is rejected here
-- rather than classified.
private pure func validate_fixed_types(
    declarations: ResolvedDeclarations
) -> Result[Void, CheckError]:
    roots = declarations.fixed_roots()
    var failure: Option[CheckError] = None

    for root in roots:
        if failure.is_none():
            failure = match root.unfixed_field(declarations):
                Ok(found): found
                Err(error): Some(error)

    var finished: List[AggregateId] = []

    for root in roots:
        if (
            failure
                .is_none()
                .and(
                    finished
                        .contains_aggregate(root)
                        .not()
                )
        ):
            match root.walk_fixed_type([root], finished, declarations):
                Ok(walked): finished = walked
                Err(error): failure = Some(error)

    match failure:
        Some(error): Err(error)
        None: Ok(void)


-- One record or union a walk meets, at its type arguments.
private record StoredOccurrence {
    aggregate: AggregateId,
    arguments: List[TypeRef]
}


-- How a walk treats a record it meets. Records are classified first, each
-- following every record and union it stores, so a record's fact depends on
-- no other. Unions are classified after them, given whether each record, by
-- record number, contains itself: such a record is a counted cell, a pointer
-- that ends a union's walk, and any other record is stored by value.
private union RecordEdges:
    EveryRecordByValue
    ClassifiedRecords(List[Bool])


-- What a walk meets at one stored field: its root, a record or union stored
-- by value, the elements of a tuple, or a pointer that ends the walk there.
private union Met:
    MetRoot
    MetOccurrence(StoredOccurrence)
    MetElements(List[TypeUse])
    MetPointer


-- What a walk from `root` meets at `field`. Lists,
-- Strings and callables are pointers, and so is a record `edges` marks as
-- containing itself.
private pure func met(
    field: TypeUse,
    root: AggregateId,
    edges: RecordEdges,
    declarations: ResolvedDeclarations
) -> Result[Met, CheckError]:
    match field.value_type:
        TupleType(elements):
            Ok(MetElements(elements.map(pure func(element): { field | value_type = element })))
        NominalType(AggregateNominal(aggregate), arguments):
            if aggregate == root:
                Ok(MetRoot)
            else:
                cell: Result[Bool, CheckError] = match (aggregate, edges):
                    (RecordAggregate(id), ClassifiedRecords(cells)):
                        cells
                            .get(id.record_number())
                            .or_checker_invariant(field.span, InvalidRecordDeclaration(id))
                    _:
                        Ok(False)

                cell.map(pure func(pointer) -> Met:
                    if pointer:
                        MetPointer
                    else:
                        MetOccurrence({ aggregate = aggregate, arguments = arguments })
                )
        _:
            Ok(MetPointer)


-- Whether a declaration contains itself: its fields or payloads, followed
-- through the tuples, records and unions they store by value, at their
-- substituted arguments, reach it again. Each occurrence is expanded once, and there are finitely many
-- because growing recursion is rejected first.
private pure func contains_itself(
    root: AggregateId,
    edges: RecordEdges,
    declarations: ResolvedDeclarations
) -> Result[Bool, CheckError]:
    fields ?= root.root_fields(declarations)
    var pending = fields
    var pending_count = fields.length()
    var expanded: List[StoredOccurrence] = []
    var found: Bool = False
    var failure: Option[CheckError] = None

    while (
        (pending_count > 0)
            .and(found.not())
            .and(failure.is_none())
    ):
        pending_count = pending_count - 1

        step: Result[Met, CheckError] = pending
            .get(pending_count)
            .or_checker_invariant(compiler_span(), InvalidDeclarationVisit)
            .and_then(pure func(field): field.met(root, edges, declarations))

        match step:
            Err(error):
                failure = Some(error)
            Ok(MetRoot):
                found = True
            Ok(MetPointer):
                void
            Ok(MetElements(elements)):
                for element in elements:
                    pending = pending.push_at(pending_count, element)
                    pending_count = pending_count + 1
            Ok(MetOccurrence(occurrence)):
                if (
                    expanded
                        .contains(occurrence)
                        .not()
                ):
                    expanded = expanded.append(occurrence)
                    written = occurrence.aggregate.root_fields(declarations)

                    -- An occurrence without arguments names a declaration
                    -- without type parameters: its fields are stored as written.
                    stored: Result[List[TypeUse], CheckError] = if occurrence.arguments.is_empty():
                        written
                    else:
                        written.and_then(
                            pure func(declared): declared.substituted_fields({
                                owner = occurrence.aggregate.aggregate_owner(),
                                values = occurrence.arguments
                            })
                        )

                    match stored:
                        Ok(children):
                            for child in children:
                                pending = pending.push_at(pending_count, child)
                                pending_count = pending_count + 1
                        Err(error):
                            failure = Some(error)

    match failure:
        Some(error): Err(error)
        None: Ok(found)


-- Every declaration must have a finite layout. A fixed type must be stored
-- inline, and a generic type must reach finitely many applications of itself. Every by-value cycle then
-- passes through a record or union that contains itself, and each is
-- published with that classification: specialization stores such a record or
-- union in counted heap cells, which breaks every such cycle. Fixed types are
-- checked before growth, so a fixed type that contains itself is reported by
-- its own rule.
private pure func validate_finite_declarations(
    declarations: ResolvedDeclarations
) -> Result[CheckedDeclarations, CheckError]:
    _: Void ?= declarations.validate_fixed_types()
    -- Substituting declaration bodies below terminates only once growth is rejected.
    _: Void ?= declarations.validate_type_growth()

    records ?= declarations.records.translated_list(
        pure func(declaration: ResolvedRecord) -> Result[CheckedRecord, CheckError]:
            RecordAggregate(declaration.id)
                .contains_itself(EveryRecordByValue, declarations)
                .map(
                    pure func(found) -> CheckedRecord: {
                        id = declaration.id,
                        type_parameters = declaration.type_parameters,
                        requirements = declaration.requirements,
                        fields = declaration.fields,
                        contains_itself = found
                    }
                )
    )

    cells: RecordEdges = ClassifiedRecords(
        records.map(pure func(declaration: CheckedRecord) -> Bool: declaration.contains_itself)
    )

    unions ?= declarations.unions.translated_list(
        pure func(declaration: ResolvedUnion) -> Result[CheckedUnion, CheckError]:
            declaration
                .union_storage(cells, declarations)
                .map(
                    pure func(storage) -> CheckedUnion: {
                        id = declaration.id,
                        module = declaration.module,
                        name = declaration.name,
                        type_parameters = declaration.type_parameters,
                        requirements = declaration.requirements,
                        variants = declaration.variants,
                        fixed = declaration.fixed,
                        storage = storage
                    }
                )
    )

    Ok({ unions = unions, records = records })


-- Where the walk from `start` meets `root` again by any path: type
-- arguments, phantom ones included, then each declaration's written body,
-- through records, unions, Lists and callables. Reachability is
-- fresh for every root. Mark a type only when expanding it: all its children
-- are then pending, so an aggregate revisit needs no second expansion. Check
-- reentry before that shortcut. A union whose one payload never meets it is
-- stored as that payload.
private pure func first_reentry(
    start: TypeUse,
    root: NominalId,
    declarations: ResolvedDeclarations
) -> Result[Option[Span], CheckError]:
    var pending = [start]
    var depth = 1
    var visited: List[TypeRef] = []
    var found: Option[Span] = None
    var failure: Option[CheckError] = None

    while (
        (depth > 0)
            .and(found.is_none())
            .and(failure.is_none())
    ):
        depth = depth - 1

        match pending.get(depth):
            None:
                failure = Some(checker_invariant(start.span, InvalidDeclarationVisit))
            Some(annotation):
                reentry = match annotation.value_type:
                    NominalType(owner, _): owner == root
                    _: False

                if reentry:
                    found = Some(annotation.span)
                else:
                    var seen: Bool = False

                    for previous in visited:
                        if previous == annotation.value_type:
                            seen = True
                            break

                    if seen.not():
                        visited = visited.append(annotation.value_type)

                        children: Result[List[TypeUse], CheckError] = match annotation.value_type:
                            NominalType(owner, arguments):
                                owner.representation_children(
                                    arguments,
                                    annotation.span,
                                    declarations
                                )
                            _:
                                Ok(
                                    annotation.value_type
                                        .type_children()
                                        .map(pure func(child): { annotation | value_type = child })
                                )

                        match children:
                            Err(error):
                                failure = Some(error)
                            Ok(ordered):
                                var position = ordered.length()

                                while position > 0:
                                    position = position - 1

                                    match ordered.get(position):
                                        Some(child):
                                            pending = pending.push_at(depth, child)
                                            depth = depth + 1
                                        None:
                                            failure = Some(
                                                checker_invariant(
                                                    annotation.span,
                                                    InvalidDeclarationVisit
                                                )
                                            )

    match failure:
        Some(error): Err(error)
        None: Ok(found)


-- A union with one variant and one payload that never reaches the union again
-- is stored as that payload (rule 8). The walk follows every path, so it can
-- decline a union that would be safe to erase, but never erases one that is
-- not. Any other union is stored as `contains_itself` classifies it.
private pure func union_storage(
    declaration: ResolvedUnion,
    cells: RecordEdges,
    declarations: ResolvedDeclarations
) -> Result[UnionStorage, CheckError]:
    erased: Bool ?= match declaration.variants:
        [variant]:
            match variant.fields:
                [payload]:
                    payload
                        .first_reentry(
                            AggregateNominal(UnionAggregate(declaration.id)),
                            declarations
                        )
                        .map(pure func(reentry): reentry.is_none())
                _:
                    Ok(False)
        _:
            Ok(False)

    if erased:
        Ok(StoredAsPayload)
    else:
        UnionAggregate(declaration.id)
            .contains_itself(cells, declarations)
            .map(pure func(found) -> UnionStorage:
                if found:
                    StoredOnHeap
                else:
                    StoredByValue
            )


-- Arguments, including phantom ones, precede the declaration's written body.
-- The body is not substituted: its parameters are leaves, so the walk meets
-- only written types and is finite however a cycle would grow its arguments.
private pure func representation_children(
    owner: NominalId,
    arguments: List[TypeRef],
    span: Span,
    declarations: ResolvedDeclarations
) -> Result[List[TypeUse], CheckError]:
    body: List[TypeUse] ?= match owner:
        AggregateNominal(aggregate): aggregate.root_fields(declarations)

    Ok(
        arguments
            .map(pure func(argument): { value_type = argument, span = span })
            .concat(body)
    )
