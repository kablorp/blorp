import:
    ../../syntax/names: NameId
    ../../syntax/source: ModuleId
    ../../syntax/syntax: Span, WrittenName
    ../namespace/namespace: Namespace
    ./errors:
        BindingSite,
        LiteralBinding,
        CheckError,
        BindingError(ModuleBindingConflict, LocalBindingConflict, CallableBindingConflict),
        binding_error,
        CheckerInvariant(InvalidFunctionContract),
        checker_invariant
    ./model:
        BindingDefinition,
        BindingId,
        BodyOwner,
        ScopedBindingId,
        CallableParameterId,
        FunctionSignature,
        TypeRef(CallableType),
        TypeUse,
        BindingOrigin(CallableParameterBinding)


-- Only bind_local publishes a binding; later readers receive accepted facts.
union LocalBinding:
    private Init(ScopedBinding)


private record ScopedBinding {
    name: NameId,
    id: ScopedBindingId,
    definition: BindingDefinition,
    -- Set when an unannotated declaration took its Int type from a lone literal.
    literal: Option[LiteralBinding]
}


union ScopedValue:
    DataLocal(LocalBinding)
    CallableLocal(CallableBinding)


pure func lookup_binding(scope: List[ScopedValue], name: NameId) -> Option[ScopedValue]:
    var found: Option[ScopedValue] = None

    for binding in scope:
        binding_name = match binding:
            DataLocal(data):
                contents = match data:
                    LocalBinding.Init(contents): contents

                contents.name
            CallableLocal(callable):
                callable
                    .callable_local()
                    .binding_site().name

        if binding_name == name:
            found = Some(binding)
            break

    found


pure func local_binding_id(binding: LocalBinding) -> BindingId:
    match binding:
        LocalBinding.Init(contents): contents.id.binding


pure func binding_definition(binding: LocalBinding) -> BindingDefinition:
    match binding:
        LocalBinding.Init(contents): contents.definition


-- Whether a read in `body` accepts `binding`: one of its own, or an enclosing
-- body's immutable one, which a lambda captures by value.
pure func readable_from(binding: LocalBinding, body: BodyOwner) -> Bool:
    match binding:
        LocalBinding.Init(accepted):
            (accepted.id.owner == body).or(accepted.definition.mutable.not())


-- The names of the written bindings a read in `body` accepts, in scope order.
pure func readable_names(scope: List[ScopedValue], body: BodyOwner) -> List[NameId]:
    var visible: List[NameId] = []

    for value in scope:
        local = match value:
            DataLocal(data): data
            CallableLocal(callable): callable.callable_local()

        accepted = match local:
            LocalBinding.Init(accepted): accepted

        if (
            local
                .readable_from(body)
                .and(accepted.definition.named)
        ):
            visible = visible.append(accepted.name)

    visible


-- A data local declared without an annotation from the lone integer `literal`.
pure func with_literal(value: ScopedValue, literal: Int) -> ScopedValue:
    match value:
        DataLocal(local):
            accepted = match local:
                LocalBinding.Init(accepted): accepted

            binding: LiteralBinding = {
                name = accepted.name,
                mutable = accepted.definition.mutable,
                literal = literal
            }

            DataLocal(LocalBinding.Init({ accepted | literal = Some(binding) }))
        CallableLocal(_):
            value


pure func literal_binding(binding: LocalBinding) -> Option[LiteralBinding]:
    match binding:
        LocalBinding.Init(contents): contents.literal


pure func binding_site(binding: LocalBinding) -> BindingSite:
    match binding:
        LocalBinding.Init(accepted):
            { binding = accepted.id, name = accepted.name, span = accepted.definition.span }


private pure func bind_data(
    scope: List[ScopedValue],
    namespace: Namespace,
    module: ModuleId,
    owner: BodyOwner,
    name: WrittenName,
    id: BindingId,
    definition: BindingDefinition
) -> Result[LocalBinding, CheckError]:
    match namespace.value_binding(module, name.id):
        Some(previous):
            Err(binding_error(name.span, ModuleBindingConflict(previous)))
        None:
            match scope.lookup_binding(name.id):
                Some(DataLocal(previous)):
                    Err(
                        binding_error(
                            name.span,
                            LocalBindingConflict(
                                previous.binding_site(),
                                previous.binding_definition().origin
                            )
                        )
                    )
                Some(CallableLocal(previous)):
                    Err(callable_conflict(name.span, previous))
                None:
                    Ok(
                        LocalBinding.Init({
                            name = name.id,
                            id = { owner = owner, binding = id },
                            definition = definition,
                            literal = None
                        })
                    )


pure func bind_local(
    scope: List[ScopedValue],
    namespace: Namespace,
    module: ModuleId,
    owner: BodyOwner,
    name: WrittenName,
    id: BindingId,
    definition: BindingDefinition
) -> Result[ScopedValue, CheckError]:
    local ?= scope.bind_data(namespace, module, owner, name, id, definition)
    Ok(DataLocal(local))


pure func bind_callable(
    scope: List[ScopedValue],
    namespace: Namespace,
    module: ModuleId,
    name: WrittenName,
    id: CallableParameterId,
    value_type: TypeUse,
    owner: BodyOwner,
    binding: BindingId
) -> Result[ScopedValue, CheckError]:
    definition: BindingDefinition = {
        origin = CallableParameterBinding(id),
        mutable = False,
        named = True,
        value_type = value_type.value_type,
        span = name.span
    }

    local ?= scope.bind_data(namespace, module, owner, name, binding, definition)

    match value_type.value_type:
        CallableType(_, _, _):
            Ok(CallableLocal(CallableBinding.Init({ local = local, annotation = value_type.span })))
        _:
            Err(checker_invariant(value_type.span, InvalidFunctionContract))


private record ScopedCallable {
    local: LocalBinding,
    annotation: Span
}


union CallableBinding:
    private Init(ScopedCallable)


record CallableParameterContract {
    parameter: CallableParameterId,
    signature: FunctionSignature
}


-- A transient projection of the canonical local definition, not a second
-- stored signature or identity. Annotation spans remain declaration-owned.
pure func callable_parameter_contract(
    binding: CallableBinding
) -> Result[CallableParameterContract, CheckError]:
    accepted = match binding:
        CallableBinding.Init(accepted): accepted

    definition = accepted.local.binding_definition()

    match definition.origin:
        CallableParameterBinding(parameter):
            match definition.value_type:
                CallableType(purity, parameters, result):
                    Ok({
                        parameter = parameter,
                        signature = {
                            type_parameters = [],
                            requirements = [],
                            purity = purity,
                            parameters = parameters.map(
                                pure func(value) -> TypeUse: {
                                    value_type = value,
                                    span = accepted.annotation
                                }
                            ),
                            return_type = { value_type = result, span = accepted.annotation }
                        }
                    })
                _:
                    Err(checker_invariant(definition.span, InvalidFunctionContract))
        _:
            Err(checker_invariant(definition.span, InvalidFunctionContract))


pure func callable_local(binding: CallableBinding) -> LocalBinding:
    match binding:
        CallableBinding.Init(contents): contents.local


private pure func callable_conflict(span: Span, previous: CallableBinding) -> CheckError:
    match previous.callable_parameter_contract():
        Err(error):
            error
        Ok(accepted):
            binding_error(
                span,
                CallableBindingConflict(
                    accepted.parameter,
                    previous
                        .callable_local()
                        .binding_site().span
                )
            )
