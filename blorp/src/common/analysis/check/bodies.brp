---
Checks function bodies: parameter scope, ordered statements, match arms
and patterns, and the canonical Void tail.
---
import:
    bool: and, not
    list: repeat
    ../../syntax/names: NameId
    ../../syntax/source: ModuleId, ModuleKind(UserModule)
    ../../syntax/syntax:
        IntegerFormat(Int64Format),
        ParsedBinding,
        binder_span,
        ParsedPropagation,
        compiler_span,
        ExpressionBase(MatchExpression, IfExpression, VoidExpression, RangeExpression),
        ForBinder(SingleForBinder, TupleForBinder),
        ParsedBlock,
        ParsedIf,
        ParsedWhile,
        ParsedFor,
        ParsedConcurrentBlock,
        ParsedBinder(NamedBinder, DiscardBinder),
        ElseBranch(ElseIf, ElseBlock),
        ParsedMatch,
        ParsedMatchArm,
        ParsedParameter,
        ParsedPattern(
            PatternName,
            PatternWildcard,
            PatternConstructor,
            PatternOr,
            PatternList,
            PatternLiteral,
            PatternChar
        ),
        PatternHead(BareHead, QualifiedHead),
        statement_end,
        ParsedStatement(
            TupleBinding,
            VariantBinding,
            BindingStatement,
            PropagatingBinding,
            ExpressionStatement,
            WhileLoop,
            ForLoop,
            Break,
            Continue,
            ConcurrentBlock
        ),
        Span,
        ValueExpression,
        WrittenName,
        TypeSyntax,
        ParsedVariantBinding,
        Purity(Pure)
    ../assemble: ParsedModuleRow
    ../ids: DeclarationInventory, FunctionId, TraitId, TraitMethodId, UnionId, VariantId
    ../namespace/builtins: DesignatedResult, DesignatedBoolean, DesignatedOption, RuntimeOperation
    ../namespace/namespace: Namespace
    ./callables: ResolutionContext
    ./constructors: VariantContract, ConstructionContext, construction_context, destructured_variant
    ./declarations: CheckedDeclarations, ResolvedType(ResolvedTypeTerm), occurrence_fields
    ./errors:
        CheckError,
        CheckErrorKind(CallRejection, ValueRejection),
        CallError(UnknownFunction),
        ConcurrencyError(TaskRejection, UnboundTaskValue, ConcurrentBlockRequiresLibrary),
        TaskRule(TaskSiblingBinding, TaskAssignment),
        concurrency_error,
        RecursionError(
            CallableTailRecursionUnsupported,
            GenericTailRecursionUnsupported,
            PropagationTailRecursionUnsupported
        ),
        recursion_error,
        ValueError(ExpressionTypeMismatch, MissingIfElse, IfBranchWithoutValue, UnknownValue),
        value_error,
        CheckerInvariant(
            InvalidReceiverScope,
            InvalidResolvedFunction,
            InvalidInferenceWorklist,
            InvalidCheckedUnion,
            InvalidResolvedParameter,
            UnsupportedPatternReachedResolution,
            LoopControlOutsideLoop,
            NestedPropagation,
            JoinWithoutArms
        ),
        ExpectedTypeSite(
            FirstArmValue,
            FirstIfBranchValue,
            InferredBindingDeclaration,
            SourceAnnotation,
            ForRangeBound
        ),
        MatchError(
            ArmWithoutValue,
            InvalidMatchScrutinee,
            NonExhaustiveMatch,
            PatternFieldCountMismatch,
            BarePatternName,
            UnknownConstructorPattern,
            UnreachableArm,
            OrPatternBindingsDiffer,
            OrPatternBindingTypeMismatch
        ),
        StatementError(
            CallableAssignment,
            ImmutableAssignment,
            CapturedAssignment,
            NonVoidMatchArm,
            NonVoidStatement,
            PropagationNeedsResultReturn,
            PropagationNeedsResultValue,
            NonBooleanCondition,
            NonIterableFor,
            TupleBindingRequiresTuple,
            TupleBindingArityMismatch
        ),
        checker_invariant,
        match_error,
        statement_error,
        ConstructorError(DestructuringRejected),
        DestructuringProblem(SeveralVariants, PayloadCountMismatch, ValueOfOtherType),
        constructor_error,
        ResourceError(MatchedResource),
        resource_error,
        Option methods,
        UnsupportedForm(CharPattern, IfValue),
        unsupported_form
    ./expressions:
        CheckedValueResult,
        ResolvedBody,
        capture_operands,
        check_value,
        lambda_captures,
        synthesize_value
    ./model:
        BodyOwner(DeclaredBody, LambdaBody, DerivedEqualityBody, DerivedTupleEquality),
        AcceptedMethodCall,
        AcceptedTraits,
        CallableChoice(
            MethodCallable,
            NamedCallable,
            ForwardedCallable,
            LambdaCallable,
            StoredCallable
        ),
        CheckedCall,
        CheckedFunctionBody,
        FunctionElaboration(ElaboratedBody, BodyNotReached),
        ImplementationTable,
        ImplementedBody(AuthoredMethod, TraitDefault, StructuralEquality, TupleEquality),
        body_calls,
        body_callable_creations,
        expression_calls,
        expression_callable_creations,
        AdmittedReceiverScope,
        CheckedLambda,
        LambdaOrigin(BlockTask, BlockRest),
        ScopedBindingId,
        ConcurrentFunctions,
        LambdaId,
        LambdaRow(CollectingLambda, CheckedLambdaRow),
        lambda_id,
        lambda_number,
        CheckedConstant,
        BindingDefinition,
        BindingId,
        BindingOrigin(BodyLocal, MatchCapture, ParameterBinding, CallableParameterBinding),
        CallTarget(RuntimeFunction, TraitMethod, UserFunction, CallableParameter, ValueCall),
        CheckedArm,
        CheckedBody(CheckedMatchBody, CheckedValueBody),
        CheckedExit(RecurWith, ReturnExpression),
        CheckedJoin,
        CheckedJoinArm,
        CheckedExpr,
        CheckedForm(
            InvokeFunction,
            LiteralInteger,
            LiteralVoid,
            Match,
            MakeCallable,
            ReadBinding,
            ConstructVariant,
            ReadTupleElement,
            ReadPayload,
            ConstructTuple
        ),
        CheckedCallOperand(ValueOperand, CallableOperand),
        CheckedFunction,
        CheckedPatternPlace,
        CheckedPatternRoute(MatchRoot, UnionField),
        CheckedPatternArgument(BorrowPlace),
        CheckedSelection,
        CheckedDecisionNode(TestVariant, EnterArm),
        MatchArmId,
        DecisionNodeId,
        match_arm_id,
        decision_node_id,
        CheckedStatement(
            DiscardExpression,
            InitializeBinding,
            ReassignBinding,
            RunWhile,
            RunFor,
            BreakSourceLoop,
            ContinueSourceLoop
        ),
        CheckedIteration(ListIteration, AscendingIntRange),
        TypeRef(CallableType, VoidType, IntegerType, ListType, NominalType, TupleType),
        AggregateId(UnionAggregate),
        NominalId(AggregateNominal),
        FunctionSignature,
        TypeUse,
        UnionOccurrence,
        UnionStorage(StoredAsPayload, StoredByValue, StoredOnHeap),
        union_occurrence,
        callable_parameter,
        binding_id,
        implementation_rows
    ./name_uses: NameUse, Referent(BindingReferent), name_use, with_uses
    ./patterns as patterns: ParsedPattern methods, TypeRef methods
    ./recursion: BodyCalls, automatic_origin, check_execution
    ./resource_scopes: ResourceDefault, admit_resource_body, resource_defaults
    ./resource_types: TypeRef methods
    ./scope:
        ScopedValue(DataLocal, CallableLocal),
        LocalBinding,
        bind_callable,
        bind_local,
        with_literal,
        lookup_binding,
        CallableBinding
    ./signatures: AcceptedBody(BuiltinBody, MatchBody, ValueBody), AcceptedFunction
    ./traits: TraitAvailability


private record MatchContext {
    subject: patterns.PatternSubject,
    scope: List[ScopedValue]
}


-- Each `uses` below is the name uses of exactly the syntax its record covers;
-- a parent appends a child's where the child's record dies.
private record ResolvedMatch {
    lambdas: List[LambdaRow],
    body: CheckedJoin,
    bindings: List[BindingDefinition],
    uses: List[NameUse]
}


private record StartedMatch {
    lambdas: List[LambdaRow],
    scrutinee: CheckedExpr,
    match_context: MatchContext,
    uses: List[NameUse]
}


private pure func start_match(
    scope: List[ScopedValue],
    body: ParsedMatch,
    context: ResolutionContext,
    lambdas: List[LambdaRow]
) -> Result[StartedMatch, CheckError]:
    var unsupported: Option[CheckError] = None

    for arm in body.arms:
        if unsupported.is_none():
            unsupported = arm.pattern.unsupported_pattern_form()

    _: Void ?= match unsupported:
        Some(error): Err(error)
        None: Ok(void)

    scrutinee ?= scope.synthesize_value(
        body.scrutinee,
        None,
        context,
        lambdas,
        resolve_lambda_block
    )

    scrutinee_type = scrutinee.value.value_type

    _: Void ?= match scrutinee_type.supports_root():
        True: Ok(void)
        False: Err(match_error(body.scrutinee.span, InvalidMatchScrutinee(scrutinee_type)))

    held ?= scrutinee_type.as_resource(context.body_types.inventory, body.scrutinee.span)

    _: Void ?= match held:
        Some(matched): Err(resource_error(body.scrutinee.span, MatchedResource(matched)))
        None: Ok(void)

    subject ?= scrutinee_type.prepare_subject(context, body.scrutinee.span)

    Ok({
        lambdas = scrutinee.lambdas,
        scrutinee = scrutinee.value,
        match_context = { subject = subject, scope = scope },
        uses = scrutinee.uses
    })


private record ResolvedArmPrefix {
    rows: List[patterns.PatternRow],
    inputs: List[BindingId],
    block: ResolvedStatements
}


private pure func resolve_arm_prefix(
    arm: ParsedMatchArm,
    match_context: MatchContext,
    previous: List[patterns.PatternRow],
    id: MatchArmId,
    bindings: List[BindingDefinition],
    context: ResolutionContext,
    lambdas: List[LambdaRow]
) -> Result[ResolvedArmPrefix, CheckError]:
    pattern ?= arm.pattern.resolve_arm(
        match_context.subject,
        match_context.scope,
        bindings.length(),
        id,
        previous,
        context
    )

    block ?= arm.block.statements.resolve_statements(
        {
            lambdas = lambdas,
            bindings = bindings.concat(pattern.bindings),
            scope = pattern.scope,
            statements = [],
            reassigned = [],
            uses = pattern.uses
        },
        context
    )

    Ok({ rows = pattern.rows, inputs = pattern.inputs, block = block })


-- Every arm must be useful, and together the arms must cover every variant.
private pure func resolve_match(
    return_type: TypeUse,
    scope: List[ScopedValue],
    body: ParsedMatch,
    bindings: List[BindingDefinition],
    context: ResolutionContext,
    lambdas: List[LambdaRow]
) -> Result[ResolvedMatch, CheckError]:
    started ?= scope.start_match(body, context, lambdas)

    resolved ?= body.arms.resolve_join_arms(
        started.match_context,
        {
            lambdas = started.lambdas,
            arms = [],
            cases = [],
            bindings = bindings,
            expectation = return_type.return_expectation(),
            reassigned = [],
            uses = started.uses
        },
        context
    )

    selected ?= patterns.finish_selection(
        resolved.cases,
        started.match_context.subject,
        body.keyword_span,
        context
    )

    Ok({
        body = {
            scrutinee = started.scrutinee,
            selection = selected,
            arms = resolved.arms,
            -- Only the function return follows this match.
            carried = []
        },
        lambdas = resolved.lambdas,
        bindings = resolved.bindings,
        uses = resolved.uses
    })


-- What a block's value, an initializer or an expression statement must
-- produce. A bare match's arms take the expectation of the position it
-- stands in: a known type checks every arm; a statement requires Void, and
-- its arms may end with a statement; a Void function's tail discards each
-- arm's value, as it does a plain tail value. Only a new binding, or the
-- first arm of a match under one, has no expectation: there the first arm's
-- type decides the later arms'.
private union ValueExpectation:
    UntypedValue
    -- A condition supplies the canonical constructor context; each leaf still
    -- validates its resulting nominal type before a Bool join can be published.
    ConditionValue(TypeRef)
    CheckedAgainst(TypeRef, ExpectedTypeSite)
    StatementValue
    -- Without else the then block must be Void, independent of its receiver.
    AbsentElseBranch(Span)
    -- An arm of a statement match, or of a match nested as one's value.
    StatementArm
    -- A concurrent task that is an expression: Void as a statement is, and so
    -- are its `if` branches and `match` arms, where a value would be the
    -- task's, which the block, having no value, cannot keep.
    TaskStatementValue
    -- A Void function's tail. The match there is Void; its arms keep their
    -- values' own types only until normalize_void_body discards them, after
    -- tail-recursion analysis has seen them at the tail. Like any tail arm,
    -- each arm still needs a value.
    VoidTail


-- A checked value with the function's bindings after it: a match's arms
-- add their captures and locals.
private record ResolvedValue {
    lambdas: List[LambdaRow],
    value: CheckedExpr,
    bindings: List[BindingDefinition],
    reassigned: List[BindingId],
    -- The value's uses alone, not those of the block it follows.
    uses: List[NameUse]
}


-- Arms resolved so far, the uncovered variants and what the next arm's
-- value must produce.
private record JoinProgress {
    lambdas: List[LambdaRow],
    arms: List[CheckedJoinArm],
    cases: List[patterns.PatternRow],
    bindings: List[BindingDefinition],
    expectation: ValueExpectation,
    reassigned: List[BindingId],
    -- The scrutinee's and the arms' uses so far.
    uses: List[NameUse]
}


private pure func return_expectation(return_type: TypeUse) -> ValueExpectation:
    -- Void tails have no expected value type: each expression is still fully
    -- checked, then its value is discarded after tail-recursion analysis.
    if return_type.value_type == VoidType:
        VoidTail
    else:
        CheckedAgainst(return_type.value_type, SourceAnnotation(return_type.span))


-- A bare match is the only expression resolved here rather than by the
-- expression planner, which rejects a match nested inside another expression.
private pure func bare_match(written: ValueExpression) -> Option[ParsedMatch]:
    match written.base:
        MatchExpression(matched):
            if written.applications.is_empty():
                Some(matched)
            else:
                None
        _:
            None


-- A block's final value, an initializer or an expression statement, in the
-- scope after `block`'s statements.
private pure func resolve_value(
    block: ResolvedStatements,
    written: ValueExpression,
    expectation: ValueExpectation,
    context: ResolutionContext
) -> Result[ResolvedValue, CheckError]:
    match written.base:
        IfExpression(branch):
            if written.applications.is_empty():
                branch.resolve_if(block, expectation, context)
            else:
                Err(unsupported_form(written.base_span, IfValue))
        _:
            match written.bare_match():
                Some(matched):
                    block.resolve_join(matched, expectation, context)
                None:
                    value_result: Result[CheckedValueResult, CheckError] = match expectation:
                        UntypedValue | VoidTail:
                            block.scope.synthesize_value(
                                written,
                                None,
                                context,
                                block.lambdas,
                                resolve_lambda_block
                            )
                        ConditionValue(expected):
                            match block.scope.synthesize_value(
                                written,
                                Some(expected),
                                context,
                                block.lambdas,
                                resolve_lambda_block
                            ):
                                Err(error):
                                    Err(error)
                                Ok(value):
                                    if value.value.value_type == expected:
                                        Ok(value)
                                    else:
                                        Err(
                                            statement_error(
                                                written.span,
                                                NonBooleanCondition(value.value.value_type)
                                            )
                                        )
                        CheckedAgainst(expected, site):
                            block.scope.check_value(
                                written,
                                expected,
                                site,
                                context,
                                block.lambdas,
                                resolve_lambda_block
                            )
                        StatementValue:
                            block.scope.statement_value(
                                written,
                                ExpressionStatementValue,
                                context,
                                block.lambdas
                            )
                        AbsentElseBranch(origin):
                            block.scope.statement_value(
                                written,
                                IfThenWithoutElse(origin),
                                context,
                                block.lambdas
                            )
                        StatementArm:
                            block.scope.statement_value(
                                written,
                                StatementMatchArmValue,
                                context,
                                block.lambdas
                            )
                        TaskStatementValue:
                            block.scope.statement_value(
                                written,
                                ConcurrentTaskValue,
                                context,
                                block.lambdas
                            )

                    match value_result:
                        Ok(value):
                            Ok({
                                value = value.value,
                                lambdas = value.lambdas,
                                bindings = block.bindings,
                                reassigned = block.reassigned,
                                uses = value.uses
                            })
                        Err(error):
                            Err(error)


-- Non-final expression statements, and a statement match's arm values, must
-- have Void type.
-- Where a value must be Void: each position names its own rejection.
private fixed union VoidPosition:
    ExpressionStatementValue
    StatementMatchArmValue
    IfThenWithoutElse(Span)
    ConcurrentTaskValue


private pure func statement_value(
    scope: List[ScopedValue],
    written: ValueExpression,
    position: VoidPosition,
    context: ResolutionContext,
    lambdas: List[LambdaRow]
) -> Result[CheckedValueResult, CheckError]:
    value ?= scope.synthesize_value(written, None, context, lambdas, resolve_lambda_block)

    if value.value.value_type == VoidType:
        Ok(value)
    else:
        rejection: CheckError = match position:
            ExpressionStatementValue:
                statement_error(written.span, NonVoidStatement(value.value.value_type))
            StatementMatchArmValue:
                statement_error(written.span, NonVoidMatchArm(value.value.value_type))
            IfThenWithoutElse(origin):
                value_error(origin, MissingIfElse)
            ConcurrentTaskValue:
                concurrency_error(written.span, UnboundTaskValue)

        Err(rejection)


-- A bound or statement match. Its arms resolve as a tail match's do, except
-- that each yields its value to the code after the match.
private pure func resolve_join(
    block: ResolvedStatements,
    body: ParsedMatch,
    expectation: ValueExpectation,
    context: ResolutionContext
) -> Result[ResolvedValue, CheckError]:
    started ?= block.scope.start_match(body, context, block.lambdas)

    -- A statement match's arms, and those of matches nested as their values,
    -- are statement arms.
    arm_expectation: ValueExpectation = match expectation:
        StatementValue | StatementArm | AbsentElseBranch(_):
            StatementArm
        UntypedValue | ConditionValue(_) | CheckedAgainst(_, _) | VoidTail | TaskStatementValue:
            expectation

    resolved ?= body.arms.resolve_join_arms(
        started.match_context,
        {
            lambdas = started.lambdas,
            arms = [],
            cases = [],
            bindings = block.bindings,
            expectation = arm_expectation,
            reassigned = [],
            uses = started.uses
        },
        context
    )

    selected ?= patterns.finish_selection(
        resolved.cases,
        started.match_context.subject,
        body.keyword_span,
        context
    )

    decided: Result[TypeRef, CheckError] = match resolved.expectation:
        ConditionValue(expected):
            Ok(expected)
        CheckedAgainst(expected, _):
            Ok(expected)
        StatementValue | StatementArm | AbsentElseBranch(_) | VoidTail | TaskStatementValue:
            Ok(VoidType)
        -- Only a match without arms leaves its type undecided.
        UntypedValue:
            Err(checker_invariant(body.keyword_span, JoinWithoutArms))

    value_type ?= decided

    carried: List[BindingId] = if resolved.reassigned.is_empty():
        []
    else:
        block.carried_bindings(resolved.reassigned)

    Ok({
        value = {
            form = Match({
                scrutinee = started.scrutinee,
                selection = selected,
                arms = resolved.arms,
                carried = carried
            }),
            value_type = value_type,
            span = body.span
        },
        lambdas = resolved.lambdas,
        bindings = resolved.bindings,
        reassigned = block.reassigned.concat(carried),
        uses = resolved.uses
    })


private pure func resolve_join_arms(
    written: List[ParsedMatchArm],
    match_context: MatchContext,
    progress: JoinProgress,
    context: ResolutionContext
) -> Result[JoinProgress, CheckError]:
    match written.get(progress.arms.length()):
        None:
            Ok(progress)
        Some(arm):
            match arm.resolve_arm_prefix(
                match_context,
                progress.cases,
                match_arm_id(progress.arms.length()),
                progress.bindings,
                context,
                progress.lambdas
            ):
                Ok(prefix):
                    resolved: Result[ResolvedValue, CheckError] = match arm.block.value:
                        Some(body):
                            prefix.block.resolve_value(body, progress.expectation, context)
                        None:
                            match progress.expectation:
                                -- An arm of a statement match may end with a statement.
                                StatementValue | StatementArm | AbsentElseBranch(_) | TaskStatementValue:
                                    Ok({
                                        value = {
                                            form = LiteralVoid,
                                            value_type = VoidType,
                                            span = arm.span
                                        },
                                        lambdas = prefix.block.lambdas,
                                        bindings = prefix.block.bindings,
                                        reassigned = prefix.block.reassigned,
                                        uses = []
                                    })
                                UntypedValue | ConditionValue(_) | CheckedAgainst(_, _) | VoidTail:
                                    Err(match_error(arm.span, ArmWithoutValue))

                    match resolved:
                        Ok(value):
                            expectation: ValueExpectation = match progress.expectation:
                                UntypedValue:
                                    CheckedAgainst(value.value.value_type, FirstArmValue)
                                ConditionValue(_) | CheckedAgainst(_, _) | StatementValue | StatementArm | AbsentElseBranch(_) | VoidTail | TaskStatementValue:
                                    progress.expectation

                            written.resolve_join_arms(
                                match_context,
                                {
                                    arms = progress.arms.append({
                                        id = match_arm_id(progress.arms.length()),
                                        inputs = prefix.inputs,
                                        statements = prefix.block.statements,
                                        value = value.value
                                    }),
                                    cases = progress.cases.concat(prefix.rows),
                                    lambdas = value.lambdas,
                                    bindings = value.bindings,
                                    expectation = expectation,
                                    reassigned = progress.reassigned.concat(value.reassigned),
                                    uses = progress.uses
                                        .concat(prefix.block.uses)
                                        .concat(value.uses)
                                },
                                context
                            )
                        Err(error):
                            Err(error)
                Err(error):
                    Err(error)


-- What the parameters bind: the names the body can see, and every parameter's
-- definition in runtime order, including each discarded `_`.
private record ParameterScope {
    scope: List[ScopedValue],
    definitions: List[BindingDefinition]
}


-- The signature was resolved from these parameters, one type each.
private pure func parameter_scope(
    parameters: List[ParsedParameter],
    types: List[TypeUse],
    scope: List[ScopedValue],
    context: ResolutionContext
) -> Result[ParameterScope, CheckError]:
    var resolved = scope
    var definitions: List[BindingDefinition] = []
    var position = 0
    var failure: Option[CheckError] = None

    for parameter in parameters:
        match types.get(position):
            None:
                failure = Some(
                    checker_invariant(
                        parameter.binder.binder_span(),
                        InvalidResolvedParameter(position)
                    )
                )
            Some(value_type):
                data_ordinal = definitions.length()

                match parameter.binder:
                    DiscardBinder(span):
                        -- A function-typed formal keeps its callable identity even when
                        -- unnamed, so call sites erase or pass its argument as for any other.
                        origin: BindingOrigin = match value_type.value_type:
                            CallableType(_, _, _):
                                CallableParameterBinding(
                                    callable_parameter(context.root_function, position)
                                )
                            _:
                                ParameterBinding(data_ordinal)

                        definitions = definitions.append({
                            origin = origin,
                            mutable = False,
                            named = False,
                            value_type = value_type.value_type,
                            span = span
                        })
                    NamedBinder(name):
                        binding_result = match value_type.value_type:
                            CallableType(_, _, _):
                                resolved.bind_callable(
                                    context.namespace,
                                    context.module,
                                    name,
                                    callable_parameter(context.root_function, position),
                                    value_type,
                                    context.caller.body,
                                    binding_id(data_ordinal)
                                )
                            _:
                                resolved.bind_local(
                                    context.namespace,
                                    context.module,
                                    context.caller.body,
                                    name,
                                    binding_id(data_ordinal),
                                    {
                                        origin = ParameterBinding(data_ordinal),
                                        mutable = False,
                                        named = True,
                                        value_type = value_type.value_type,
                                        span = name.span
                                    }
                                )

                        match binding_result:
                            Ok(binding):
                                resolved = resolved.append(binding)

                                definition = match binding:
                                    DataLocal(data):
                                        data.binding_definition()
                                    CallableLocal(callable):
                                        callable
                                            .callable_local()
                                            .binding_definition()

                                definitions = definitions.append(definition)
                            Err(error):
                                failure = Some(error)

        if failure.is_some():
            break

        position = position + 1

    match failure:
        Some(error): Err(error)
        None: Ok({ scope = resolved, definitions = definitions })


-- A block's checked statements, the scope after them and the function's
-- bindings so far.
private record ResolvedStatements {
    lambdas: List[LambdaRow],
    bindings: List[BindingDefinition],
    scope: List[ScopedValue],
    statements: List[CheckedStatement],
    reassigned: List[BindingId],
    -- The uses of this block's statements so far. A nested block starts its
    -- own list, so no two live blocks share one.
    uses: List[NameUse]
}


private fixed union JoinBindingState:
    OutsideJoinScope
    UntouchedJoinBinding
    ReassignedJoinBinding


-- Scope membership and write occurrences are already checked facts. This local
-- table filters arm locals and freezes each visible identity once, in ordinal
-- order even though the lexical lookup scope has most recent bindings first.
private pure func carried_bindings(
    entry: ResolvedStatements,
    written: List[BindingId]
) -> List[BindingId]:
    var states: List[JoinBindingState] = repeat(OutsideJoinScope, entry.bindings.length())

    for binding in entry.scope:
        match binding:
            DataLocal(data):
                states = states.set(
                    data
                        .local_binding_id()
                        .binding_number(),
                    UntouchedJoinBinding
                )
            CallableLocal(_):
                void

    for id in written:
        position = id.binding_number()

        match states.get(position):
            Some(state):
                match state:
                    UntouchedJoinBinding | ReassignedJoinBinding:
                        states = states.set(position, ReassignedJoinBinding)
                    OutsideJoinScope:
                        void
            None:
                void

    var carried: List[BindingId] = []
    var ordinal = 0

    for state in states:
        match state:
            ReassignedJoinBinding: carried = carried.append(binding_id(ordinal))
            OutsideJoinScope | UntouchedJoinBinding: void

        ordinal = ordinal + 1

    carried


-- New bindings are validated once after their initializer is checked.
private pure func resolve_statements(
    written: List[ParsedStatement],
    block: ResolvedStatements,
    context: ResolutionContext
) -> Result[ResolvedStatements, CheckError]:
    written.resolve_statement_prefix(0, block, context)


-- One source destructuring statement expands to several ordinary bindings.
-- Track written position independently of the checked statement count.
private pure func resolve_statement_prefix(
    written: List[ParsedStatement],
    position: Int,
    block: ResolvedStatements,
    context: ResolutionContext
) -> Result[ResolvedStatements, CheckError]:
    match written.get(position):
        None:
            Ok(block)
        Some(statement):
            match statement.resolve_statement(block, context):
                Ok(next): written.resolve_statement_prefix(position + 1, next, context)
                Err(error): Err(error)


private pure func resolve_loop_control(
    control: CheckedStatement,
    span: Span,
    block: ResolvedStatements,
    context: ResolutionContext
) -> Result[ResolvedStatements, CheckError]:
    if context.in_source_loop:
        Ok({ block | statements = block.statements.append(control) })
    else:
        Err(checker_invariant(span, LoopControlOutsideLoop))


private pure func resolve_statement(
    statement: ParsedStatement,
    block: ResolvedStatements,
    context: ResolutionContext
) -> Result[ResolvedStatements, CheckError]:
    match statement:
        TupleBinding(binders, initializer, span):
            binders.resolve_tuple_binding(initializer, span, block, context)
        VariantBinding(binding):
            binding.resolve_variant_binding(block, context)
        BindingStatement(binding):
            binding.resolve_assignment(block, context)
        PropagatingBinding(propagation):
            Err(checker_invariant(propagation.span, NestedPropagation))
        WhileLoop(loop):
            loop.resolve_while(block, context)
        ForLoop(loop):
            loop.resolve_for(block, context)
        Break(span):
            resolve_loop_control(BreakSourceLoop(span), span, block, context)
        Continue(span):
            resolve_loop_control(ContinueSourceLoop(span), span, block, context)
        ConcurrentBlock(written):
            written.resolve_concurrent_block(block, context)
        ExpressionStatement(expression):
            match block.resolve_value(expression, StatementValue, context):
                Ok(resolved):
                    Ok(
                        { block |
                            lambdas = resolved.lambdas,
                            bindings = resolved.bindings,
                            statements = block.statements.append(DiscardExpression(resolved.value)),
                            reassigned = resolved.reassigned,
                            uses = block.uses.concat(resolved.uses)
                        }
                    )
                Err(error):
                    Err(error)


private pure func resolve_condition(
    written: ValueExpression,
    block: ResolvedStatements,
    context: ResolutionContext
) -> Result[ResolvedValue, CheckError]:
    expected: TypeRef = NominalType(
        AggregateNominal(UnionAggregate(context.boolean.true_variant.variant_owner())),
        []
    )

    { block | reassigned = [] }.resolve_value(written, ConditionValue(expected), context)


-- Statement blocks may finish without a value. A written final expression
-- remains a statement and must be Void, just like each preceding expression.
private pure func resolve_statement_block(
    written: ParsedBlock,
    block: ResolvedStatements,
    context: ResolutionContext
) -> Result[ResolvedStatements, CheckError]:
    prefix ?= written.statements.resolve_statements(block, context)

    match written.value:
        Some(value): resolve_statement(ExpressionStatement(value), prefix, context)
        None: Ok(prefix)


private record ResolvedIfBranch {
    block: ResolvedStatements,
    value: CheckedExpr
}


private pure func resolve_if_branch(
    written: ParsedBlock,
    block: ResolvedStatements,
    expectation: ValueExpectation,
    context: ResolutionContext
) -> Result[ResolvedIfBranch, CheckError]:
    prefix ?= match expectation:
        StatementValue | StatementArm: written.resolve_statement_block(block, context)
        _: written.statements.resolve_statements(block, context)

    resolved: ResolvedValue ?= match expectation:
        StatementValue | StatementArm:
            Ok({
                value = { form = LiteralVoid, value_type = VoidType, span = written.span },
                bindings = prefix.bindings,
                lambdas = prefix.lambdas,
                reassigned = prefix.reassigned,
                uses = []
            })
        _:
            match written.value:
                Some(body):
                    prefix.resolve_value(body, expectation, context)
                None:
                    match expectation:
                        AbsentElseBranch(_) | TaskStatementValue:
                            Ok({
                                value = {
                                    form = LiteralVoid,
                                    value_type = VoidType,
                                    span = written.span
                                },
                                bindings = prefix.bindings,
                                lambdas = prefix.lambdas,
                                reassigned = prefix.reassigned,
                                uses = []
                            })
                        _:
                            Err(value_error(written.span, IfBranchWithoutValue))

    Ok({
        block = { prefix |
            bindings = resolved.bindings,
            lambdas = resolved.lambdas,
            reassigned = resolved.reassigned,
            uses = prefix.uses.concat(resolved.uses)
        },
        value = resolved.value
    })


private pure func resolve_if(
    written: ParsedIf,
    block: ResolvedStatements,
    expectation: ValueExpectation,
    context: ResolutionContext
) -> Result[ResolvedValue, CheckError]:
    condition ?= written.condition.resolve_condition(block, context)

    entry: ResolvedStatements = {
        lambdas = condition.lambdas,
        bindings = condition.bindings,
        scope = block.scope,
        statements = [],
        reassigned = [],
        uses = []
    }

    arm_expectation = match written.else_branch:
        Some(_): expectation
        None: AbsentElseBranch(written.span)

    selected ?= written.then_block.resolve_if_branch(entry, arm_expectation, context)

    next_expectation: ValueExpectation = match expectation:
        UntypedValue: CheckedAgainst(selected.value.value_type, FirstIfBranchValue)
        _: expectation

    other_entry = { entry | bindings = selected.block.bindings, lambdas = selected.block.lambdas }

    other: ResolvedIfBranch ?= match written.else_branch:
        None:
            Ok({
                block = other_entry,
                value = { form = LiteralVoid, value_type = VoidType, span = written.span }
            })
        Some(branch):
            match branch:
                ElseBlock(body):
                    body.resolve_if_branch(other_entry, next_expectation, context)
                ElseIf(body):
                    match body.resolve_if(other_entry, next_expectation, context):
                        Err(error):
                            Err(error)
                        Ok(resolved):
                            Ok({
                                block = { other_entry |
                                    lambdas = resolved.lambdas,
                                    bindings = resolved.bindings,
                                    reassigned = resolved.reassigned,
                                    uses = resolved.uses
                                },
                                value = resolved.value
                            })

    value_type = match expectation:
        UntypedValue:
            selected.value.value_type
        CheckedAgainst(expected, _):
            expected
        ConditionValue(expected):
            expected
        StatementValue | StatementArm | AbsentElseBranch(_) | VoidTail | TaskStatementValue:
            VoidType

    -- With no else, branches were checked without the receiving expectation.
    -- Validate its canonical Void result before publishing any join facts.
    _: Void ?= match written.else_branch:
        Some(_):
            Ok(void)
        None:
            match expectation:
                CheckedAgainst(expected, site):
                    if expected == VoidType:
                        Ok(void)
                    else:
                        Err(
                            value_error(
                                written.span,
                                ExpressionTypeMismatch({
                                    expected = expected,
                                    actual = { value_type = VoidType, span = written.span },
                                    expected_site = site
                                })
                            )
                        )
                ConditionValue(_):
                    Err(statement_error(written.span, NonBooleanCondition(VoidType)))
                _:
                    Ok(void)

    carried = block.carried_bindings(
        condition.reassigned
            .concat(selected.block.reassigned)
            .concat(other.block.reassigned)
    )

    matched_selection ?= patterns.union_selection(
        [
            {
                arm = match_arm_id(0),
                variant = context.boolean.true_variant,
                fields = [],
                arguments = []
            },
            {
                arm = match_arm_id(1),
                variant = context.boolean.false_variant,
                fields = [],
                arguments = []
            }
        ],
        condition.value.value_type,
        written.span,
        context
    )

    Ok({
        value = {
            form = Match({
                scrutinee = condition.value,
                selection = matched_selection,
                arms = [
                    {
                        id = match_arm_id(0),
                        inputs = [],
                        statements = selected.block.statements,
                        value = selected.value
                    },
                    {
                        id = match_arm_id(1),
                        inputs = [],
                        statements = other.block.statements,
                        value = other.value
                    }
                ],
                carried = carried
            }),
            value_type = value_type,
            span = written.span
        },
        lambdas = other.block.lambdas,
        bindings = other.block.bindings,
        reassigned = block.reassigned.concat(carried),
        uses = condition.uses
            .concat(selected.block.uses)
            .concat(other.block.uses)
    })


private pure func resolve_while(
    written: ParsedWhile,
    block: ResolvedStatements,
    context: ResolutionContext
) -> Result[ResolvedStatements, CheckError]:
    inside = { context | in_source_loop = True }
    condition ?= written.condition.resolve_condition(block, inside)

    body ?= written.body.resolve_statement_block(
        {
            lambdas = condition.lambdas,
            bindings = condition.bindings,
            scope = block.scope,
            statements = [],
            reassigned = [],
            uses = []
        },
        inside
    )

    carried = block.carried_bindings(condition.reassigned.concat(body.reassigned))

    Ok(
        { block |
            lambdas = body.lambdas,
            bindings = body.bindings,
            statements = block.statements.append(
                RunWhile({
                    condition = condition.value,
                    body = body.statements,
                    carried = carried,
                    boolean = context.boolean,
                    span = written.span
                })
            ),
            reassigned = block.reassigned.concat(carried),
            uses = block.uses
                .concat(condition.uses)
                .concat(body.uses)
        }
    )


-- The loop's entry block starts its own uses; `uses` are the iterable's.
private record ResolvedIteration {
    iteration: CheckedIteration,
    element: TypeRef,
    block: ResolvedStatements,
    uses: List[NameUse]
}


-- Iterable expressions run before the loop. Their writes and LambdaRows flow
-- into the body's entry, but their locals do not escape their value scopes.
private pure func resolve_iteration(
    written: ValueExpression,
    block: ResolvedStatements,
    context: ResolutionContext
) -> Result[ResolvedIteration, CheckError]:
    match written.base:
        RangeExpression(start, end):
            if written.applications.is_empty():
                start.resolve_range_iteration(end, block, context)
            else:
                written.resolve_list_iteration(block, context)
        _:
            written.resolve_list_iteration(block, context)


private pure func resolve_range_iteration(
    start: ValueExpression,
    end: ValueExpression,
    block: ResolvedStatements,
    context: ResolutionContext
) -> Result[ResolvedIteration, CheckError]:
    first ?= block.resolve_value(
        start,
        CheckedAgainst(IntegerType(Int64Format), ForRangeBound),
        context
    )

    previous = { block |
        lambdas = first.lambdas,
        bindings = first.bindings,
        reassigned = first.reassigned,
        uses = []
    }

    last ?= previous.resolve_value(
        end,
        CheckedAgainst(IntegerType(Int64Format), ForRangeBound),
        context
    )

    Ok({
        iteration = AscendingIntRange(first.value, last.value, context.boolean),
        element = IntegerType(Int64Format),
        block = { previous |
            lambdas = last.lambdas,
            bindings = last.bindings,
            reassigned = last.reassigned
        },
        uses = first.uses.concat(last.uses)
    })


private pure func resolve_list_iteration(
    written: ValueExpression,
    block: ResolvedStatements,
    context: ResolutionContext
) -> Result[ResolvedIteration, CheckError]:
    resolved ?= block.resolve_value(written, UntypedValue, context)

    match resolved.value.value_type:
        ListType(element):
            Ok({
                iteration = ListIteration(resolved.value, element, context.option),
                element = element,
                block = { block |
                    lambdas = resolved.lambdas,
                    bindings = resolved.bindings,
                    reassigned = resolved.reassigned,
                    uses = []
                },
                uses = resolved.uses
            })
        _:
            Err(statement_error(written.span, NonIterableFor(resolved.value.value_type)))


private record ForItemScope {
    item: Option[BindingId],
    block: ResolvedStatements
}


private pure func bind_for_item(
    binder: ParsedBinder,
    element: TypeRef,
    block: ResolvedStatements,
    context: ResolutionContext
) -> Result[ForItemScope, CheckError]:
    match binder:
        DiscardBinder(_):
            Ok({ item = None, block = block })
        NamedBinder(name):
            id = binding_id(block.bindings.length())

            definition: BindingDefinition = {
                origin = BodyLocal,
                mutable = False,
                named = True,
                value_type = element,
                span = name.span
            }

            match block.scope.bind_local(
                context.namespace,
                context.module,
                context.caller.body,
                name,
                id,
                definition
            ):
                Err(error):
                    Err(error)
                Ok(binding):
                    Ok({
                        item = Some(id),
                        block = { block |
                            bindings = block.bindings.append(definition),
                            scope = [binding].concat(block.scope)
                        }
                    })


private pure func tuple_binder_types(
    binders: List[ParsedBinder],
    value_type: TypeRef,
    span: Span
) -> Result[List[TypeRef], CheckError]:
    selected: Result[List[TypeRef], CheckError] = match value_type:
        TupleType(elements): Ok(elements)
        _: Err(statement_error(span, TupleBindingRequiresTuple(value_type)))

    fields ?= selected

    if fields.length() == binders.length():
        Ok(fields)
    else:
        Err(statement_error(span, TupleBindingArityMismatch(fields.length(), binders.length())))


-- The unnamed subject owns the whole tuple. Named projections use ordinary
-- bindings, while '_' leaves its element owned only by that subject.
private pure func bind_tuple_elements(
    binders: List[ParsedBinder],
    fields: List[TypeRef],
    subject: CheckedExpr,
    block: ResolvedStatements,
    context: ResolutionContext
) -> Result[ResolvedStatements, CheckError]:
    var resolved = block
    var position = 0
    var failure: Option[CheckError] = None

    for binder in binders:
        match binder:
            DiscardBinder(_):
                void
            NamedBinder(name):
                match fields.get(position):
                    None:
                        failure = Some(
                            checker_invariant(name.span, UnsupportedPatternReachedResolution)
                        )
                    Some(value_type):
                        projection: CheckedExpr = {
                            form = ReadTupleElement(subject, position),
                            value_type = value_type,
                            span = name.span
                        }

                        match resolved.bind_projection(name, projection, context):
                            Err(error): failure = Some(error)
                            Ok(bound): resolved = bound

        if failure.is_some():
            break

        position = position + 1

    match failure:
        Some(error): Err(error)
        None: Ok(resolved)


private pure func resolve_tuple_binding(
    binders: List[ParsedBinder],
    initializer: ValueExpression,
    span: Span,
    block: ResolvedStatements,
    context: ResolutionContext
) -> Result[ResolvedStatements, CheckError]:
    resolved ?= block.resolve_value(initializer, UntypedValue, context)
    fields ?= binders.tuple_binder_types(resolved.value.value_type, span)
    id = binding_id(resolved.bindings.length())

    definition: BindingDefinition = {
        origin = BodyLocal,
        mutable = False,
        named = False,
        value_type = resolved.value.value_type,
        span = initializer.span
    }

    subject: CheckedExpr = {
        form = ReadBinding(id),
        value_type = resolved.value.value_type,
        span = initializer.span
    }

    binders.bind_tuple_elements(
        fields,
        subject,
        {
            lambdas = resolved.lambdas,
            bindings = resolved.bindings.append(definition),
            scope = block.scope,
            statements = block.statements.append(InitializeBinding(id, resolved.value)),
            reassigned = resolved.reassigned,
            uses = block.uses.concat(resolved.uses)
        },
        context
    )


-- A destructured name: a new immutable binding initialized with `projection`.
private pure func bind_projection(
    block: ResolvedStatements,
    name: WrittenName,
    projection: CheckedExpr,
    context: ResolutionContext
) -> Result[ResolvedStatements, CheckError]:
    id = binding_id(block.bindings.length())

    definition: BindingDefinition = {
        origin = BodyLocal,
        mutable = False,
        named = True,
        value_type = projection.value_type,
        span = name.span
    }

    binding ?= block.scope.bind_local(
        context.namespace,
        context.module,
        context.caller.body,
        name,
        id,
        definition
    )

    Ok(
        { block |
            bindings = block.bindings.append(definition),
            scope = [binding].concat(block.scope),
            statements = block.statements.append(InitializeBinding(id, projection))
        }
    )


-- `Union.Variant(binders) = value` reads a union with one variant (rule 7).
-- Its variant resolves as a construction's does, so the access and ambiguity
-- rules apply unchanged. A union stored as its payload reads that payload and
-- binds nothing else, so a resource union's handle is read without an alias.
-- Any other union is bound once and read with a `match` per binder.
private pure func resolve_variant_binding(
    written: ParsedVariantBinding,
    block: ResolvedStatements,
    context: ResolutionContext
) -> Result[ResolvedStatements, CheckError]:
    head ?= context
        .construction_context()
        .destructured_variant(written.variant)

    variant = head[0]
    owner = variant.variant_owner()

    rejected = pure func(span: Span, problem: DestructuringProblem) -> CheckError: constructor_error(
        span,
        DestructuringRejected(variant, problem)
    )

    declaration ?= context.unions
        .get(owner.union_number())
        .or_checker_invariant(written.span, InvalidCheckedUnion(owner))

    fields: List[TypeUse] ?= match declaration.variants:
        [only]: Ok(only.fields)
        _: Err(rejected(written.span, SeveralVariants(declaration.variants.length())))

    _: Void ?= if fields.length() == written.binders.length():
        Ok(void)
    else:
        Err(rejected(written.span, PayloadCountMismatch(fields.length(), written.binders.length())))

    resolved ?= block.resolve_value(written.initializer, UntypedValue, context)
    value_type = resolved.value.value_type

    occurrence: UnionOccurrence ?= match value_type.union_occurrence():
        Some(found):
            if found.owner == owner:
                Ok(found)
            else:
                Err(rejected(written.initializer.span, ValueOfOtherType(value_type)))
        None:
            Err(rejected(written.initializer.span, ValueOfOtherType(value_type)))

    payloads ?= fields.occurrence_fields(occurrence)

    next: ResolvedStatements = { block |
        lambdas = resolved.lambdas,
        bindings = resolved.bindings,
        reassigned = resolved.reassigned,
        uses = block.uses
            .concat(resolved.uses)
            .with_uses(head[1])
    }

    match declaration.storage:
        StoredAsPayload:
            written.binders.bind_erased_payload(
                variant,
                payloads,
                resolved.value,
                written.span,
                next,
                context
            )
        StoredByValue | StoredOnHeap:
            written.binders.bind_payload_matches(
                variant,
                payloads,
                resolved.value,
                written.span,
                next,
                context
            )


-- Destructures a union stored as its payload: the arity check leaves exactly
-- one payload and binder, and a `_` binder still evaluates the read.
private pure func bind_erased_payload(
    binders: List[ParsedBinder],
    variant: VariantId,
    payloads: List[TypeUse],
    value: CheckedExpr,
    span: Span,
    block: ResolvedStatements,
    context: ResolutionContext
) -> Result[ResolvedStatements, CheckError]:
    read: CheckedExpr ?= match payloads:
        [payload]:
            Ok({
                form = ReadPayload(variant, value, 0),
                value_type = payload.value_type,
                span = span
            })
        _:
            Err(checker_invariant(span, InvalidCheckedUnion(variant.variant_owner())))

    match binders:
        [NamedBinder(name)]: block.bind_projection(name, read, context)
        _: Ok({ block | statements = block.statements.append(DiscardExpression(read)) })


-- Destructures a union that is not stored as its payload: the value is bound
-- once, unnamed, and each named binder reads its payload with a single-arm
-- `match`. The union has one variant, so the match needs no tag test, as in
-- derived equality's singleton selection.
private pure func bind_payload_matches(
    binders: List[ParsedBinder],
    variant: VariantId,
    payloads: List[TypeUse],
    value: CheckedExpr,
    span: Span,
    block: ResolvedStatements,
    context: ResolutionContext
) -> Result[ResolvedStatements, CheckError]:
    subject_id = binding_id(block.bindings.length())

    subject_definition: BindingDefinition = {
        origin = BodyLocal,
        mutable = False,
        named = False,
        value_type = value.value_type,
        span = span
    }

    var resolved: ResolvedStatements = { block |
        bindings = block.bindings.append(subject_definition),
        statements = block.statements.append(InitializeBinding(subject_id, value))
    }

    root: CheckedPatternPlace = { route = MatchRoot, value_type = value.value_type }
    var position = 0
    var failure: Option[CheckError] = None

    for binder in binders:
        match binder:
            DiscardBinder(_):
                void
            NamedBinder(name):
                match payloads.get(position):
                    None:
                        failure = Some(
                            checker_invariant(name.span, UnsupportedPatternReachedResolution)
                        )
                    Some(payload):
                        input = binding_id(resolved.bindings.length())

                        input_definition: BindingDefinition = {
                            origin = MatchCapture,
                            mutable = False,
                            named = False,
                            value_type = payload.value_type,
                            span = name.span
                        }

                        arm = match_arm_id(0)

                        projection: CheckedExpr = {
                            form = Match({
                                scrutinee = {
                                    form = ReadBinding(subject_id),
                                    value_type = value.value_type,
                                    span = span
                                },
                                selection = {
                                    nodes = [
                                        EnterArm(arm, [
                                            BorrowPlace({
                                                route = UnionField(root, variant, position),
                                                value_type = payload.value_type
                                            })
                                        ])
                                    ],
                                    entry = decision_node_id(0)
                                },
                                arms = [
                                    {
                                        id = arm,
                                        inputs = [input],
                                        statements = [],
                                        value = {
                                            form = ReadBinding(input),
                                            value_type = payload.value_type,
                                            span = name.span
                                        }
                                    }
                                ],
                                carried = []
                            }),
                            value_type = payload.value_type,
                            span = name.span
                        }

                        resolved = { resolved |
                            bindings = resolved.bindings.append(input_definition)
                        }

                        match resolved.bind_projection(name, projection, context):
                            Err(error): failure = Some(error)
                            Ok(bound): resolved = bound

        if failure.is_some():
            break

        position = position + 1

    match failure:
        Some(error): Err(error)
        None: Ok(resolved)


private pure func bind_for_binder(
    binder: ForBinder,
    element: TypeRef,
    block: ResolvedStatements,
    context: ResolutionContext
) -> Result[ForItemScope, CheckError]:
    match binder:
        SingleForBinder(single): single.bind_for_item(element, block, context)
        TupleForBinder(binders, span): binders.bind_tuple_for_item(span, element, block, context)


private pure func bind_tuple_for_item(
    binders: List[ParsedBinder],
    span: Span,
    element: TypeRef,
    block: ResolvedStatements,
    context: ResolutionContext
) -> Result[ForItemScope, CheckError]:
    fields ?= binders.tuple_binder_types(element, span)
    id = binding_id(block.bindings.length())

    definition: BindingDefinition = {
        origin = BodyLocal,
        mutable = False,
        named = False,
        value_type = element,
        span = span
    }

    subject: CheckedExpr = { form = ReadBinding(id), value_type = element, span = span }

    resolved ?= binders.bind_tuple_elements(
        fields,
        subject,
        { block | bindings = block.bindings.append(definition) },
        context
    )

    Ok({ item = Some(id), block = resolved })


private pure func resolve_for(
    written: ParsedFor,
    block: ResolvedStatements,
    context: ResolutionContext
) -> Result[ResolvedStatements, CheckError]:
    iterated ?= written.iterable.resolve_iteration(block, context)

    item ?= written.binder.bind_for_binder(
        iterated.element,
        { iterated.block | statements = [], reassigned = [] },
        context
    )

    body ?= written.body.resolve_statement_block(item.block, { context | in_source_loop = True })
    carried = iterated.block.carried_bindings(body.reassigned)

    Ok(
        { block |
            lambdas = body.lambdas,
            bindings = body.bindings,
            statements = block.statements.append(
                RunFor({
                    iteration = iterated.iteration,
                    item = item.item,
                    body = body.statements,
                    carried = carried,
                    span = written.span
                })
            ),
            reassigned = iterated.block.reassigned.concat(carried),
            uses = block.uses
                .concat(iterated.uses)
                .concat(body.uses)
        }
    )


-- An assignment of a binding from a body that does not own it: a lambda's
-- capture, or a task's, which names the binding, var or immutable.
private pure func captured_assignment_error(
    context: ResolutionContext,
    name: WrittenName,
    binding: LocalBinding
) -> CheckError:
    if context.caller.concurrent_task:
        concurrency_error(name.span, TaskRejection(TaskAssignment, name.id))
    else:
        statement_error(name.span, CapturedAssignment(binding.binding_site().binding))


private pure func binder_names(binders: List[ParsedBinder]) -> List[NameId]:
    var names: List[NameId] = []

    for binder in binders:
        match binder:
            NamedBinder(name): names = names.append(name.id)
            DiscardBinder(_): void

    names


-- The names tasks bind, which no other task of their block may use. A nested
-- block's are its own tasks'.
private pure func task_names(tasks: List[ParsedStatement]) -> List[NameId]:
    var names: List[NameId] = []

    for task in tasks:
        bound: List[NameId] = match task:
            BindingStatement(binding): [binding.name.id]
            TupleBinding(binders, _, _): binders.binder_names()
            VariantBinding(binding): binding.binders.binder_names()
            ConcurrentBlock(block): block.tasks.task_names()
            _: []

        names = names.concat(bound)

    names


-- A name unknown in a task that another task of the block binds is that
-- task's binding, which tasks running at once cannot share.
private pure func as_sibling_error(
    error: CheckError,
    task: ParsedStatement,
    siblings: List[NameId]
) -> CheckError:
    match error.kind:
        ValueRejection(UnknownValue(name)) | CallRejection(UnknownFunction(name)):
            own = [task].task_names()

            if and(siblings.contains(name), not(own.contains(name))):
                concurrency_error(error.span, TaskRejection(TaskSiblingBinding, name))
            else:
                error
        _:
            error


-- A checked lambda of a block: what it returns, the values its environment
-- captures in the body that creates it, and the rows and uses after it.
private record TaskLambda {
    id: LambdaId,
    result: TypeRef,
    environment: List[CheckedExpr],
    lambdas: List[LambdaRow],
    uses: List[NameUse],
    span: Span
}


-- The row of a pure `() -> T` lambda `id` whose statements are `prefix`'s and
-- which returns `value`, and the values that create it in `parent`.
private pure func finished_lambda(
    id: LambdaId,
    parent: BodyOwner,
    prefix: ResolvedStatements,
    value: CheckedExpr,
    origin: LambdaOrigin,
    span: Span,
    context: ResolutionContext
) -> Result[TaskLambda, CheckError]:
    result = value.value_type
    captures ?= prefix.lambdas.lambda_captures(id, span)

    resolved: ResolvedBody = {
        bindings = prefix.bindings,
        statements = prefix.statements,
        body = CheckedValueBody(ReturnExpression(value)),
        lambdas = prefix.lambdas,
        uses = prefix.uses
    }

    body = if result == VoidType:
        resolved.normalize_void_body()
    else:
        resolved

    row: CheckedLambda = {
        purity = Pure,
        origin = origin,
        root = context.root_function,
        parameters = [],
        return_type = { value_type = result, span = span },
        bindings = body.bindings,
        captures = captures,
        statements = body.statements,
        body = body.body
    }

    rows = body.lambdas.set(id.lambda_number(), CheckedLambdaRow(row))
    environment ?= capture_operands(id, parent, rows, span)

    Ok({
        id = id,
        result = result,
        environment = environment,
        lambdas = rows,
        uses = body.uses,
        span = span
    })


-- What every task of one block is checked with: the block's word, whose
-- source its tasks share, and its end, which a rest's lambda spans to; the
-- functions it calls; the scope before it; and the names its tasks bind.
private record TaskSite {
    keyword: Span,
    end: Int,
    functions: ConcurrentFunctions,
    scope: List[ScopedValue],
    siblings: List[NameId],
    context: ResolutionContext
}


-- A lambda created in `parent` and the empty body it starts with, which sees
-- the block's scope: every read of a binding there is a capture, so the
-- closure rules hold in it.
private pure func lambda_start(
    lambdas: List[LambdaRow],
    parent: BodyOwner,
    site: TaskSite
) -> ResolvedStatements:
    {
        lambdas = lambdas.append(CollectingLambda({ parent = parent, captures = [] })),
        bindings = [],
        scope = site.scope,
        statements = [],
        reassigned = [],
        uses = []
    }


-- A task's statement, checked as any statement is, except that a value an
-- expression task leaves is the task's, which the block cannot keep.
private pure func task_statement(
    task: ParsedStatement,
    start: ResolvedStatements,
    task_context: ResolutionContext
) -> Result[ResolvedStatements, CheckError]:
    match task:
        ExpressionStatement(written):
            start
                .resolve_value(written, TaskStatementValue, task_context)
                .map(
                    pure func(resolved) -> ResolvedStatements: { start |
                        lambdas = resolved.lambdas,
                        bindings = resolved.bindings,
                        statements = [DiscardExpression(resolved.value)],
                        reassigned = resolved.reassigned,
                        uses = resolved.uses
                    }
                )
        _:
            task.resolve_statement(start, task_context)


private pure func scoped_identity(value: ScopedValue) -> ScopedBindingId:
    match value:
        DataLocal(local):
            local.binding_site().binding
        CallableLocal(callable):
            callable
                .callable_local()
                .binding_site().binding


-- The bindings a statement made, in order: it adds them at the head of its
-- block's scope and keeps the rest, `before`. Only a parameter binds a
-- callable, so each is data.
private pure func made_bindings(
    after: List[ScopedValue],
    before: List[ScopedValue],
    span: Span
) -> Result[List[LocalBinding], CheckError]:
    added = after.length() - before.length()
    var made: List[LocalBinding] = []

    var valid: Bool = (
        after
            .drop(added)
            .map(scoped_identity)
        == before.map(scoped_identity)
    )

    for value in after.take(added):
        match value:
            DataLocal(local): made = [local].concat(made)
            CallableLocal(_): valid = False

    if valid:
        Ok(made)
    else:
        Err(checker_invariant(span, InvalidInferenceWorklist))


-- What a task's lambda returns: nothing for a task that binds no name, its
-- one binding's value, or a tuple of its bindings' values.
private pure func task_value(made: List[LocalBinding], span: Span) -> CheckedExpr:
    reads = made.map(
        pure func(local) -> CheckedExpr: {
            form = ReadBinding(local.local_binding_id()),
            value_type = local.binding_definition().value_type,
            span = span
        }
    )

    match reads:
        []:
            { form = LiteralVoid, value_type = VoidType, span = span }
        [only]:
            only
        _:
            types = reads.map(pure func(read) -> TypeRef: read.value_type)
            { form = ConstructTuple(reads), value_type = TupleType(types), span = span }


-- A task's whole statement as the body of an unscoped pure `() -> T` lambda
-- created in `parent`.
private pure func task_lambda(
    task: ParsedStatement,
    parent: BodyOwner,
    lambdas: List[LambdaRow],
    site: TaskSite
) -> Result[JoinOperand, CheckError]:
    id = lambda_id(lambdas.length())
    span = { site.keyword | start = task.statement_start(), end = task.statement_end() }

    task_context = { site.context |
        caller = { body = LambdaBody(id), purity = Pure, concurrent_task = True },
        in_source_loop = False
    }

    resolved ?= task
        .task_statement(lambdas.lambda_start(parent, site), task_context)
        .map_err(pure func(error) -> CheckError: error.as_sibling_error(task, site.siblings))

    made ?= resolved.scope.made_bindings(site.scope, span)

    lambda ?= finished_lambda(
        id,
        parent,
        resolved,
        made.task_value(span),
        BlockTask,
        span,
        site.context
    )

    result: TaskResult = { made = made, result = lambda.result, holds = lambda.result }
    Ok({ lambda = lambda, results = [result] })


-- A call of `function`, a block's `run` or `join`, with one task lambda per
-- callable parameter, each created where the call is.
private pure func task_call(
    function: FunctionId,
    lambdas: List[TaskLambda],
    value_type: TypeRef,
    span: Span
) -> CheckedExpr:
    var operands: List[CheckedCallOperand] = []
    var types: List[TypeRef] = []

    for lambda in lambdas:
        parameter = callable_parameter(function, types.length())
        choice: CallableChoice = LambdaCallable(lambda.id, lambda.environment)
        operands = operands.append(CallableOperand(parameter, choice, lambda.span))
        types = types.append(lambda.result)

    target: CallTarget = UserFunction(function, types)

    {
        form = InvokeFunction({ target = target, operands = operands, span = span }),
        value_type = value_type,
        span = span
    }


-- What a task's bindings take after the block: its lambda's result, read
-- from `holds`, the type of the pair that holds it and every later result.
private record TaskResult {
    made: List[LocalBinding],
    result: TypeRef,
    holds: TypeRef
}


-- The calls of a block's tasks, made in the body that holds the block, and
-- what each task binds, in the block's order.
private record TaskChain {
    call: CheckedExpr,
    results: List[TaskResult],
    lambdas: List[LambdaRow],
    uses: List[NameUse]
}


-- One task has nothing to run beside it, so the library's `run` calls it in
-- place.
private pure func run_task(
    task: ParsedStatement,
    parent: BodyOwner,
    lambdas: List[LambdaRow],
    site: TaskSite
) -> Result[TaskChain, CheckError]:
    checked ?= task.task_lambda(parent, lambdas, site)
    lambda = checked.lambda

    Ok({
        call = task_call(site.functions.run, [lambda], lambda.result, site.keyword),
        results = checked.results,
        lambdas = lambda.lambdas,
        uses = lambda.uses
    })


-- What `join` or `run` calls: a task's lambda, or a rest's, and what the
-- tasks it runs bind, which the block binds again after it.
private record JoinOperand {
    lambda: TaskLambda,
    results: List[TaskResult]
}


-- The tasks from `first` on as the right-leaning chain
-- `join(t1, () -> join(t2, ... join(tn-1, tn)))` called in `parent`. With
-- work stealing a chain still runs every task at once, since each stolen rest
-- pushes its own rest, and a block has a handful of tasks.
private pure func task_chain(
    first: ParsedStatement,
    second: ParsedStatement,
    more: List[ParsedStatement],
    parent: BodyOwner,
    lambdas: List[LambdaRow],
    site: TaskSite
) -> Result[TaskChain, CheckError]:
    left ?= first.task_lambda(parent, lambdas, site)

    side: Result[JoinOperand, CheckError] = match more:
        []: second.task_lambda(parent, left.lambda.lambdas, site)
        [third, ...rest]: second.rest_lambda(third, rest, parent, left.lambda.lambdas, site)

    right ?= side
    pair: TypeRef = TupleType([left.lambda.result, right.lambda.result])
    held = left.results.map(pure func(result) -> TaskResult: { result | holds = pair })

    Ok({
        call = task_call(site.functions.join, [left.lambda, right.lambda], pair, site.keyword),
        results = held.concat(right.results),
        lambdas = right.lambda.lambdas,
        uses = left.lambda.uses.concat(right.lambda.uses)
    })


-- The tasks from `first` on, run by a lambda of their own whose body is the
-- next join.
private pure func rest_lambda(
    first: ParsedStatement,
    second: ParsedStatement,
    more: List[ParsedStatement],
    parent: BodyOwner,
    lambdas: List[LambdaRow],
    site: TaskSite
) -> Result[JoinOperand, CheckError]:
    id = lambda_id(lambdas.length())
    span = { site.keyword | start = first.statement_start(), end = site.end }
    start = lambdas.lambda_start(parent, site)
    inner ?= first.task_chain(second, more, LambdaBody(id), start.lambdas, site)
    prefix = { start | lambdas = inner.lambdas, uses = inner.uses }
    lambda ?= finished_lambda(id, parent, prefix, inner.call, BlockRest, span, site.context)
    Ok({ lambda = lambda, results = inner.results })


-- A binding a task made joins the enclosing scope after the block, bound once
-- more as the task bound it: its type, mutability and literal note.
private pure func rebind(
    block: ResolvedStatements,
    made: LocalBinding,
    value: CheckedExpr,
    context: ResolutionContext
) -> Result[ResolvedStatements, CheckError]:
    site = made.binding_site()
    definition = made.binding_definition()
    id = binding_id(block.bindings.length())

    bound ?= block.scope.bind_local(
        context.namespace,
        context.module,
        context.caller.body,
        { id = site.name, span = site.span },
        id,
        definition
    )

    noted = match made.literal_binding():
        Some(literal): bound.with_literal(literal.literal)
        None: bound

    Ok(
        { block |
            bindings = block.bindings.append(definition),
            scope = [noted].concat(block.scope),
            statements = block.statements.append(InitializeBinding(id, value))
        }
    )


-- A task's bindings take `value`, its lambda's result: itself for one, an
-- element of the tuple for each of several.
private pure func rebind_task(
    block: ResolvedStatements,
    task: TaskResult,
    value: CheckedExpr,
    context: ResolutionContext
) -> Result[ResolvedStatements, CheckError]:
    match task.made:
        [only]:
            block.rebind(only, value, context)
        _:
            var bound: Result[ResolvedStatements, CheckError] = Ok(block)
            var position = 0

            for made in task.made:
                element: CheckedExpr = { value |
                    form = ReadTupleElement(value, position),
                    value_type = made.binding_definition().value_type
                }

                bound = bound.and_then(pure func(current) -> Result[ResolvedStatements, CheckError]:
                    current.rebind(made, element, context)
                )

                position = position + 1

            bound


-- The tasks' results, from `pairs`, the chain's nested pairs
-- `(r1, (r2, ... (rn-1, rn)))`: each takes a first element, and the last task
-- the innermost pair's second.
private pure func rebind_results(
    block: ResolvedStatements,
    results: List[TaskResult],
    pairs: CheckedExpr,
    context: ResolutionContext
) -> Result[ResolvedStatements, CheckError]:
    match results:
        [first, second, ...rest]:
            element: CheckedExpr = { pairs |
                form = ReadTupleElement(pairs, 0),
                value_type = first.result
            }

            others: CheckedExpr = { pairs |
                form = ReadTupleElement(pairs, 1),
                value_type = second.holds
            }

            block
                .rebind_task(first, element, context)
                .and_then(pure func(bound) -> Result[ResolvedStatements, CheckError]:
                    bound.rebind_results([second].concat(rest), others, context)
                )
        [only]:
            block.rebind_task(only, pairs, context)
        []:
            Ok(block)


-- A `concurrent:` block. Each task's statement is checked as the body of an
-- unscoped pure `() -> T` lambda, and the tasks become calls of the
-- concurrency module's `join`, or of its `run` for one task, as a Dict literal
-- becomes calls, so later phases see only calls and lambdas. An unnamed
-- binding holds the results until each name a task bound is bound again.
private pure func resolve_concurrent_block(
    written: ParsedConcurrentBlock,
    block: ResolvedStatements,
    context: ResolutionContext
) -> Result[ResolvedStatements, CheckError]:
    functions ?= context.traits
        .accepted_traits().canonical.concurrent_functions
        .to_result(concurrency_error(written.keyword, ConcurrentBlockRequiresLibrary))

    site: TaskSite = {
        keyword = written.keyword,
        end = ConcurrentBlock(written).statement_end(),
        functions = functions,
        scope = block.scope,
        siblings = written.tasks.task_names(),
        context = context
    }

    parent = context.caller.body

    chained: Result[TaskChain, CheckError] = match written.tasks:
        [only]: only.run_task(parent, block.lambdas, site)
        [first, second, ...more]: first.task_chain(second, more, parent, block.lambdas, site)
        -- The parser admits no block without a task.
        []: Err(checker_invariant(written.keyword, InvalidInferenceWorklist))

    chain ?= chained
    id = binding_id(block.bindings.length())
    results = chain.call.value_type

    definition: BindingDefinition = {
        origin = BodyLocal,
        mutable = False,
        named = False,
        value_type = results,
        span = written.keyword
    }

    pairs: CheckedExpr = { form = ReadBinding(id), value_type = results, span = written.keyword }

    { block |
        lambdas = chain.lambdas,
        bindings = block.bindings.append(definition),
        statements = block.statements.append(InitializeBinding(id, chain.call)),
        uses = block.uses.concat(chain.uses)
    }.rebind_results(chain.results, pairs, context)


-- Resolve a declaration's annotation before its initializer. Propagation stays
-- at this function's top level, as required by the compiler's source subset.
private pure func resolve_initializer(
    written: ParsedBinding,
    block: ResolvedStatements,
    context: ResolutionContext
) -> Result[ResolvedValue, CheckError]:
    match written.annotation:
        None:
            block.resolve_value(written.initializer, UntypedValue, context)
        Some(annotation):
            match context.resolve_body_type(annotation, []):
                Err(error):
                    Err(error)
                Ok(ResolvedTypeTerm(annotated_type, annotation_uses)):
                    match block.resolve_value(
                        written.initializer,
                        CheckedAgainst(annotated_type, SourceAnnotation(annotation.type_span())),
                        context
                    ):
                        Ok(value): Ok({ value | uses = annotation_uses.concat(value.uses) })
                        Err(error): Err(error)


private pure func resolve_assignment(
    written: ParsedBinding,
    block: ResolvedStatements,
    context: ResolutionContext
) -> Result[ResolvedStatements, CheckError]:
    -- An annotation or explicit var declares a binding. Plain assignment keeps
    -- its existing error priority before checking the RHS.
    decision: Result[Option[LocalBinding], CheckError] = match written.annotation:
        Some(_):
            Ok(None)
        None:
            if written.mutable:
                Ok(None)
            else:
                match block.scope.lookup_binding(written.name.id):
                    None:
                        Ok(None)
                    Some(CallableLocal(binding)):
                        match binding.callable_parameter_contract():
                            Err(error):
                                Err(error)
                            Ok(accepted):
                                Err(
                                    statement_error(
                                        written.name.span,
                                        CallableAssignment(accepted.parameter)
                                    )
                                )
                    Some(DataLocal(binding)):
                        if binding.binding_site().binding.owner != context.caller.body:
                            Err(context.captured_assignment_error(written.name, binding))
                        else:
                            if binding.binding_definition().mutable:
                                Ok(Some(binding))
                            else:
                                Err(
                                    statement_error(
                                        written.name.span,
                                        ImmutableAssignment(binding.binding_site())
                                    )
                                )

    reassign ?= decision

    match reassign:
        Some(binding):
            site: ExpectedTypeSite = InferredBindingDeclaration(binding.binding_site())

            match block.resolve_value(
                written.initializer,
                CheckedAgainst(binding.binding_definition().value_type, site),
                context
            ):
                Ok(resolved):
                    Ok(
                        { block |
                            lambdas = resolved.lambdas,
                            bindings = resolved.bindings,
                            statements = block.statements.append(
                                ReassignBinding(binding.local_binding_id(), resolved.value)
                            ),
                            reassigned = resolved.reassigned.append(binding.local_binding_id()),
                            uses = block.uses
                                .append(
                                    written.name.name_use(
                                        BindingReferent(binding.binding_site().binding)
                                    )
                                )
                                .concat(resolved.uses)
                        }
                    )
                Err(error):
                    Err(error)
        None:
            match written.resolve_initializer(block, context):
                Ok(resolved):
                    value = resolved.value

                    definition: BindingDefinition = {
                        origin = BodyLocal,
                        mutable = written.mutable,
                        named = True,
                        value_type = value.value_type,
                        span = written.name.span
                    }

                    -- A match's arm captures and locals precede this binding's ordinal.
                    id = binding_id(resolved.bindings.length())

                    match block.scope.bind_local(
                        context.namespace,
                        context.module,
                        context.caller.body,
                        written.name,
                        id,
                        definition
                    ):
                        Err(error):
                            Err(error)
                        Ok(binding):
                            noted: ScopedValue = match value.form:
                                LiteralInteger(literal):
                                    if written.annotation.is_none():
                                        binding.with_literal(literal)
                                    else:
                                        binding
                                _:
                                    binding

                            Ok({
                                lambdas = resolved.lambdas,
                                bindings = resolved.bindings.append(definition),
                                scope = [noted].concat(block.scope),
                                statements = block.statements.append(InitializeBinding(id, value)),
                                reassigned = resolved.reassigned,
                                uses = block.uses.concat(resolved.uses)
                            })
                Err(error):
                    Err(error)


private pure func resolve_body(
    accepted: AcceptedFunction,
    result: DesignatedResult[VariantId],
    context: ResolutionContext,
    lambdas: List[LambdaRow]
) -> Result[ResolvedBody, CheckError]:
    signature = accepted.signature

    tail_decision: Result[Void, CheckError] = match accepted.declaration.tail_annotation:
        None:
            Ok(void)
        Some(annotation):
            if signature.has_callable_parameters():
                if signature.type_parameters.is_empty():
                    Err(recursion_error(annotation, CallableTailRecursionUnsupported))
                else:
                    Err(recursion_error(annotation, GenericTailRecursionUnsupported))
            else:
                Ok(void)

    tail_contract ?= tail_decision
    bound ?= accepted.declaration.parameters.parameter_scope(signature.parameters, [], context)
    initial = bound.scope

    block: ResolvedStatements = {
        lambdas = lambdas,
        bindings = bound.definitions,
        scope = initial,
        statements = [],
        reassigned = [],
        uses = []
    }

    accepted.resolve_function_prefix(0, block, initial, result, context)


-- Ordinary functions keep their existing tail-body form. Only a propagation
-- statement switches to a Result-valued suffix inside its successful arm.
private pure func resolve_function_prefix(
    accepted: AcceptedFunction,
    position: Int,
    block: ResolvedStatements,
    initial: List[ScopedValue],
    result: DesignatedResult[VariantId],
    context: ResolutionContext
) -> Result[ResolvedBody, CheckError]:
    match accepted.declaration.statements.get(position):
        None:
            accepted.finish_body(block, initial, context)
        Some(statement):
            match statement:
                PropagatingBinding(written):
                    match accepted.resolve_propagation(
                        position,
                        block,
                        initial,
                        written,
                        result,
                        context
                    ):
                        Err(error):
                            Err(error)
                        Ok(value):
                            match accepted.declaration.tail_annotation:
                                Some(annotation):
                                    if accepted.signature.type_parameters.is_empty():
                                        Err(
                                            recursion_error(
                                                written.span,
                                                PropagationTailRecursionUnsupported
                                            )
                                        )
                                    else:
                                        Err(
                                            recursion_error(
                                                annotation,
                                                GenericTailRecursionUnsupported
                                            )
                                        )
                                None:
                                    Ok({
                                        lambdas = value.lambdas,
                                        bindings = value.bindings,
                                        statements = value.statements,
                                        body = CheckedValueBody(ReturnExpression(value.value)),
                                        uses = value.uses
                                    })
                _:
                    match statement.resolve_statement(block, context):
                        Ok(next):
                            accepted.resolve_function_prefix(
                                position + 1,
                                next,
                                initial,
                                result,
                                context
                            )
                        Err(error):
                            Err(error)


private pure func finish_body(
    accepted: AcceptedFunction,
    prefix: ResolvedStatements,
    initial: List[ScopedValue],
    context: ResolutionContext
) -> Result[ResolvedBody, CheckError]:
    signature = accepted.signature

    match accepted.body:
        BuiltinBody(operation, span):
            Ok({
                lambdas = prefix.lambdas,
                bindings = prefix.bindings,
                statements = prefix.statements,
                body = CheckedValueBody(
                    ReturnExpression(signature.builtin_value(prefix.bindings, operation, span))
                ),
                uses = prefix.uses
            })
        ValueBody(body):
            match prefix.resolve_value(body, signature.return_type.return_expectation(), context):
                Ok(value):
                    Ok({
                        lambdas = value.lambdas,
                        bindings = value.bindings,
                        statements = prefix.statements,
                        body = CheckedValueBody(ReturnExpression(value.value)),
                        uses = prefix.uses.concat(value.uses)
                    })
                Err(error):
                    Err(error)
        MatchBody(body):
            match signature.return_type.resolve_match(
                prefix.scope,
                body,
                prefix.bindings,
                context,
                prefix.lambdas
            ):
                Ok(matched):
                    checked_body: CheckedBody = match accepted.declaration.tail_annotation:
                        None:
                            CheckedValueBody(
                                ReturnExpression({
                                    form = Match(matched.body),
                                    value_type = signature.return_type.value_type,
                                    span = body.span
                                })
                            )
                        Some(_):
                            var arms: List[CheckedArm] = []

                            for arm in matched.body.arms:
                                arms = arms.append({
                                    id = arm.id,
                                    inputs = arm.inputs,
                                    statements = arm.statements,
                                    body = ReturnExpression(arm.value)
                                })

                            CheckedMatchBody({
                                scrutinee = matched.body.scrutinee,
                                selection = matched.body.selection,
                                arms = arms
                            })

                    Ok({
                        lambdas = matched.lambdas,
                        bindings = matched.bindings,
                        statements = prefix.statements,
                        body = checked_body,
                        uses = prefix.uses.concat(matched.uses)
                    })
                Err(error):
                    Err(error)


-- A builtin body stands alone, so the bindings so far are exactly the parameters,
-- in runtime order and including each discarded `_`, which the native still
-- receives as an argument.
private pure func builtin_value(
    signature: FunctionSignature,
    parameters: List[BindingDefinition],
    operation: RuntimeOperation[VariantId, TypeRef],
    span: Span
) -> CheckedExpr:
    var operands: List[CheckedCallOperand] = []
    var position = 0

    for definition in parameters:
        match definition.origin:
            CallableParameterBinding(_):
                void
            _:
                operands = operands.append(
                    ValueOperand({
                        form = ReadBinding(binding_id(position)),
                        value_type = definition.value_type,
                        span = definition.span
                    })
                )

        position = position + 1

    {
        form = InvokeFunction({
            target = RuntimeFunction(operation),
            operands = operands,
            span = span
        }),
        value_type = signature.return_type.value_type,
        span = span
    }


-- A Result-valued function suffix. It becomes the ordinary value of an Ok arm.
private record ResolvedFunctionValue {
    lambdas: List[LambdaRow],
    bindings: List[BindingDefinition],
    statements: List[CheckedStatement],
    value: CheckedExpr,
    -- Every use from the block it continues to the function's end.
    uses: List[NameUse]
}


private pure func resolve_result_prefix(
    accepted: AcceptedFunction,
    position: Int,
    block: ResolvedStatements,
    initial: List[ScopedValue],
    result: DesignatedResult[VariantId],
    context: ResolutionContext
) -> Result[ResolvedFunctionValue, CheckError]:
    match accepted.declaration.statements.get(position):
        Some(statement):
            match statement:
                PropagatingBinding(written):
                    accepted.resolve_propagation(position, block, initial, written, result, context)
                _:
                    match statement.resolve_statement(block, context):
                        Ok(next):
                            accepted.resolve_result_prefix(
                                position + 1,
                                next,
                                initial,
                                result,
                                context
                            )
                        Err(error):
                            Err(error)
        None:
            value: Result[ResolvedValue, CheckError] = match accepted.body:
                ValueBody(body):
                    block.resolve_value(
                        body,
                        accepted.signature.return_type.return_expectation(),
                        context
                    )
                MatchBody(body):
                    block.resolve_join(
                        body,
                        accepted.signature.return_type.return_expectation(),
                        context
                    )
                BuiltinBody(operation, span):
                    Ok({
                        value = accepted.signature.builtin_value(block.bindings, operation, span),
                        lambdas = block.lambdas,
                        bindings = block.bindings,
                        reassigned = block.reassigned,
                        uses = []
                    })

            match value:
                Ok(resolved):
                    Ok({
                        bindings = resolved.bindings,
                        statements = block.statements,
                        lambdas = resolved.lambdas,
                        value = resolved.value,
                        uses = block.uses.concat(resolved.uses)
                    })
                Err(error):
                    Err(error)


-- Canonical Result's checked parameter order is Value, Error.
private record ResultPayloads {
    value: TypeRef,
    error: TypeRef
}


private pure func result_payloads(
    value: TypeRef,
    result: DesignatedResult[VariantId]
) -> Option[ResultPayloads]:
    match value.union_occurrence():
        Some(occurrence):
            if occurrence.owner == result.ok.variant_owner():
                match occurrence.arguments.get(0):
                    Some(success_type):
                        match occurrence.arguments.get(1):
                            Some(error): Some({ value = success_type, error = error })
                            None: None
                    None:
                        None
            else:
                None
        None:
            None


private pure func propagation_source(
    written: ParsedPropagation,
    block: ResolvedStatements,
    error_type: TypeRef,
    result: DesignatedResult[VariantId],
    context: ResolutionContext
) -> Result[ResolvedValue, CheckError]:
    match written.annotation:
        None:
            block.resolve_value(written.value, UntypedValue, context)
        Some(annotation):
            match context.resolve_body_type(annotation, []):
                Err(error):
                    Err(error)
                Ok(ResolvedTypeTerm(annotated_type, annotation_uses)):
                    expected: TypeRef = NominalType(
                        AggregateNominal(UnionAggregate(result.ok.variant_owner())),
                        [annotated_type, error_type]
                    )

                    match block.resolve_value(
                        written.value,
                        CheckedAgainst(expected, SourceAnnotation(annotation.type_span())),
                        context
                    ):
                        Ok(value): Ok({ value | uses = annotation_uses.concat(value.uses) })
                        Err(error): Err(error)


private pure func resolve_propagation(
    accepted: AcceptedFunction,
    position: Int,
    block: ResolvedStatements,
    initial: List[ScopedValue],
    written: ParsedPropagation,
    result: DesignatedResult[VariantId],
    context: ResolutionContext
) -> Result[ResolvedFunctionValue, CheckError]:
    returned = accepted.signature.return_type

    error_type: TypeRef ?= match returned.value_type.result_payloads(result):
        Some(payloads): Ok(payloads.error)
        _: Err(statement_error(written.span, PropagationNeedsResultReturn(returned.value_type)))

    source ?= written.propagation_source(block, error_type, result, context)

    success_type: TypeRef ?= match source.value.value_type.result_payloads(result):
        Some(payloads):
            if payloads.error == error_type:
                Ok(payloads.value)
            else:
                Err(
                    value_error(
                        written.value.span,
                        ExpressionTypeMismatch({
                            expected = NominalType(
                                AggregateNominal(UnionAggregate(result.ok.variant_owner())),
                                [payloads.value, error_type]
                            ),
                            actual = {
                                value_type = source.value.value_type,
                                span = source.value.span
                            },
                            expected_site = SourceAnnotation(returned.span)
                        })
                    )
                )
        _:
            Err(
                statement_error(
                    written.value.span,
                    PropagationNeedsResultValue(source.value.value_type)
                )
            )

    -- Keep RHS evaluation as a statement: its match may publish new versions
    -- of mutable prefix bindings before the success continuation reads them.
    source_id = binding_id(source.bindings.length())

    source_definition: BindingDefinition = {
        origin = BodyLocal,
        mutable = False,
        named = False,
        value_type = source.value.value_type,
        span = written.value.span
    }

    bindings = source.bindings.append(source_definition)
    success = binding_id(bindings.length())

    named: Bool = match written.binder:
        NamedBinder(_): True
        DiscardBinder(_): False

    definition: BindingDefinition = {
        origin = MatchCapture,
        mutable = False,
        named = named,
        value_type = success_type,
        span = written.binder.binder_span()
    }

    -- Keep the internal capture for ownership; only named binders extend scope.
    scope: List[ScopedValue] ?= match written.binder:
        DiscardBinder(_):
            Ok(block.scope)
        NamedBinder(name):
            match block.scope.bind_local(
                context.namespace,
                context.module,
                context.caller.body,
                name,
                success,
                definition
            ):
                Ok(binding): Ok([binding].concat(block.scope))
                Err(error): Err(error)

    continuation ?= accepted.resolve_result_prefix(
        position + 1,
        {
            lambdas = source.lambdas,
            bindings = bindings.append(definition),
            scope = scope,
            statements = [],
            reassigned = [],
            uses = []
        },
        initial,
        result,
        context
    )

    failure = binding_id(continuation.bindings.length())

    error_definition: BindingDefinition = {
        origin = MatchCapture,
        mutable = False,
        named = False,
        value_type = error_type,
        span = written.value.span
    }

    error_value: CheckedExpr = {
        form = ReadBinding(failure),
        value_type = error_type,
        span = written.value.span
    }

    root: CheckedPatternPlace = { value_type = source.value.value_type, route = MatchRoot }

    matched_selection ?= patterns.union_selection(
        [
            {
                arm = match_arm_id(0),
                variant = result.ok,
                fields = [success_type],
                arguments = [
                    BorrowPlace({
                        value_type = success_type,
                        route = UnionField(root, result.ok, 0)
                    })
                ]
            },
            {
                arm = match_arm_id(1),
                variant = result.err,
                fields = [error_type],
                arguments = [
                    BorrowPlace({
                        value_type = error_type,
                        route = UnionField(root, result.err, 0)
                    })
                ]
            }
        ],
        source.value.value_type,
        written.span,
        context
    )

    -- The selected source Err and constructed return Err share a declaration,
    -- but their enclosing Result instantiations can differ after specialization.
    Ok({
        lambdas = continuation.lambdas,
        bindings = continuation.bindings.append(error_definition),
        statements = block.statements.append(InitializeBinding(source_id, source.value)),
        uses = block.uses
            .concat(source.uses)
            .concat(continuation.uses),
        value = {
            form = Match({
                scrutinee = {
                    form = ReadBinding(source_id),
                    value_type = source.value.value_type,
                    span = written.value.span
                },
                selection = matched_selection,
                carried = [],
                arms = [
                    {
                        id = match_arm_id(0),
                        inputs = [success],
                        statements = continuation.statements,
                        value = continuation.value
                    },
                    {
                        id = match_arm_id(1),
                        inputs = [failure],
                        statements = [],
                        value = {
                            form = ConstructVariant(result.err, [error_value]),
                            value_type = returned.value_type,
                            span = written.span
                        }
                    }
                ]
            }),
            value_type = returned.value_type,
            span = written.span
        }
    })


-- Every function, its body elaborated or not, and every checked lambda. It
-- lives here, not in `model`, which cannot import `name_uses`.
record CheckedBodies {
    functions: List[CheckedFunction],
    lambdas: List[CheckedLambda],
    -- The names every body uses, except a synthesised entry's.
    uses: List[NameUse],
    -- What each function body, then each lambda, then each structural-equality
    -- template calls and creates, walked once for the reach; the recursion
    -- check reads it. Not published.
    calls: List[BodyCalls]
}


-- The declared bodies that implement each trait member, by trait number and
-- member position. Derived once from the implementation table and only read:
-- a trait call on a type parameter can run any of them.
private pure func member_bodies(traits: AcceptedTraits) -> List[List[List[FunctionId]]]:
    var index: List[List[List[FunctionId]]] = traits.declarations.map(
        pure func(declaration) -> List[List[FunctionId]]: declaration.methods.map(
            pure func(_) -> List[FunctionId]: []
        )
    )

    for implementation in traits.implementations.implementation_rows():
        for member in implementation.methods:
            match member.body:
                AuthoredMethod(function) | TraitDefault(function):
                    owner = member.method
                        .trait_method_owner()
                        .trait_number()

                    -- An implemented member's trait and position index the table.
                    no_members: List[List[FunctionId]] = []

                    index = index.set(
                        owner,
                        index
                            .get_or(owner, no_members)
                            .set(
                                member.method.trait_method_number(),
                                index
                                    .bodies_of(member.method)
                                    .append(function)
                            )
                    )
                StructuralEquality(_, _) | TupleEquality(_, _):
                    void

    index


private pure func bodies_of(
    index: List[List[List[FunctionId]]],
    member: TraitMethodId
) -> List[FunctionId]:
    no_members: List[List[FunctionId]] = []
    no_bodies: List[FunctionId] = []

    index
        .get_or(
            member
                .trait_method_owner()
                .trait_number(),
            no_members
        )
        .get_or(member.trait_method_number(), no_bodies)


-- Appends the function number of every declaration a trait call can run.
private pure func reach_method(
    queue: List[Int],
    method: AcceptedMethodCall,
    traits: AcceptedTraits,
    members: List[List[List[FunctionId]]]
) -> List[Int]:
    match traits.method_body(method):
        Some(selected):
            match selected.body:
                DeclaredBody(function):
                    queue.append(function.function_number())
                -- Structural-equality templates are seeds, and lambdas belong
                -- to the body that creates them.
                LambdaBody(_) | DerivedEqualityBody(_):
                    queue
                -- A tuple's template is built on request and compares its elements
                -- through the member, so any implementation of it can run.
                DerivedTupleEquality(_):
                    var reached = queue

                    for function in members.bodies_of(method.method_identity()):
                        reached = reached.append(function.function_number())

                    reached
        None:
            var reached = queue

            for function in members.bodies_of(method.method_identity()):
                reached = reached.append(function.function_number())

            reached


private pure func reach_choice(
    queue: List[Int],
    choice: CallableChoice,
    traits: AcceptedTraits,
    members: List[List[List[FunctionId]]]
) -> List[Int]:
    match choice:
        MethodCallable(method): queue.reach_method(method, traits, members)
        NamedCallable(id, _): queue.append(id.function_number())
        ForwardedCallable(_) | LambdaCallable(_, _) | StoredCallable(_): queue


-- Appends the function number of every declaration a body's calls and created
-- callables can run. A number may repeat; the queue elaborates each body once.
private pure func reach_calls(
    queue: List[Int],
    body: BodyCalls,
    traits: AcceptedTraits,
    members: List[List[List[FunctionId]]]
) -> List[Int]:
    var reached = queue

    for call in body.calls:
        match call.target:
            UserFunction(id, _): reached = reached.append(id.function_number())
            TraitMethod(method): reached = reached.reach_method(method, traits, members)
            RuntimeFunction(_) | CallableParameter(_) | ValueCall(_): void

        for operand in call.operands:
            match operand:
                CallableOperand(_, choice, _):
                    reached = reached.reach_choice(choice, traits, members)
                ValueOperand(_):
                    void

    for value in body.creations:
        match value.form:
            MakeCallable(choice): reached = reached.reach_choice(choice, traits, members)
            _: void

    reached


private pure func calls_of(
    statements: List[CheckedStatement],
    body: CheckedBody,
    automatic: List[AggregateId]
) -> BodyCalls:
    {
        calls = body_calls(statements, body),
        creations = body_callable_creations(statements, body),
        automatic = automatic
    }


-- Every user body is elaborated, and with `whole_library` every library body
-- too. Otherwise a library body is elaborated only when a constant, a
-- structural-equality template or an elaborated body can reach it, or a
-- resource type inherits it as a default (LIBRARY_COST_PLAN.md, option (b)).
-- User bodies come first, in declaration order, so of the errors in user bodies
-- the first reported is the one checking every body in order finds. A library
-- body's error is found only when the body is reached, after every user body.
-- `synthesized_entry` is the entry function assembly wrote, if it wrote one: no
-- source spells its names, so its body records none.
pure func resolve_functions(
    functions: List[AcceptedFunction],
    modules: List[ParsedModuleRow],
    whole_library: Bool,
    declarations: CheckedDeclarations,
    inventory: DeclarationInventory,
    namespace: Namespace,
    receivers: List[AdmittedReceiverScope],
    constants: List[CheckedConstant],
    traits: TraitAvailability,
    result: DesignatedResult[VariantId],
    boolean: DesignatedBoolean[VariantId],
    option: DesignatedOption[VariantId],
    synthesized_entry: Option[FunctionId]
) -> Result[CheckedBodies, CheckError]:
    has_resources = inventory.declares_resource_unions()

    inherited: List[ResourceDefault] ?= if has_resources:
        traits
            .accepted_traits().implementations
            .implementation_rows()
            .resource_defaults(inventory)
    else:
        Ok([])

    trait_table = traits.accepted_traits()
    members = trait_table.member_bodies()
    var pending: List[Int] = []
    var failure: Option[CheckError] = None

    for accepted in functions:
        match modules.get(accepted.body_types.module.module_number()):
            Some(module):
                if whole_library.or(module.role == UserModule):
                    pending = pending.append(accepted.id.function_number())
            None:
                failure = Some(
                    checker_invariant(
                        accepted.declaration.function_name.span,
                        InvalidResolvedFunction(accepted.id)
                    )
                )

    -- A default a resource type inherits is walked again with Self as that
    -- resource, and what that walk finds is the implementation's own error, so
    -- it is checked whether or not a call reaches it.
    for row in inherited:
        pending = pending.append(row.default_body.function_number())

    -- Only a structural-equality template has an automatic origin.
    no_origin: List[AggregateId] = []

    for constant in constants:
        pending = pending.reach_calls(
            {
                calls = constant.value.expression_calls(),
                creations = constant.value.expression_callable_creations(),
                automatic = no_origin
            },
            trait_table,
            members
        )

    var template_reach: List[BodyCalls] = []

    for implementation in trait_table.implementations.implementation_rows():
        for member in implementation.methods:
            match member.body:
                StructuralEquality(_, template):
                    reached = calls_of([], template.body, implementation.automatic_origin())
                    template_reach = template_reach.append(reached)
                    pending = pending.reach_calls(reached, trait_table, members)
                AuthoredMethod(_) | TraitDefault(_) | TupleEquality(_, _):
                    void

    no_calls: BodyCalls = { calls = [], creations = [], automatic = no_origin }
    var function_reach: List[BodyCalls] = repeat(no_calls, functions.length())
    var lambda_reach: List[BodyCalls] = []
    var elaborations: List[FunctionElaboration] = repeat(BodyNotReached, functions.length())
    var lambdas: List[LambdaRow] = []
    var uses: List[NameUse] = []
    var head = 0

    while (
        failure
            .is_none()
            .and(head < pending.length())
    ):
        position = pending.get_or(head, 0)
        head = head + 1
        first_lambda = lambdas.length()

        -- A body is queued once per call that reaches it and elaborated once.
        unelaborated: Option[AcceptedFunction] = match elaborations.get(position):
            Some(BodyNotReached): functions.get(position)
            Some(ElaboratedBody(_)) | None: None

        match unelaborated:
            None:
                void
            Some(accepted):
                match receivers.get(accepted.body_types.module.module_number()):
                    None:
                        failure = Some(
                            checker_invariant(
                                accepted.declaration.function_name.span,
                                InvalidReceiverScope
                            )
                        )
                    Some(receiver_scope):
                        id = accepted.id

                        context: ResolutionContext = {
                            traits = traits,
                            caller = {
                                body = DeclaredBody(id),
                                purity = accepted.signature.purity,
                                concurrent_task = False
                            },
                            root_function = id,
                            module = accepted.body_types.module,
                            namespace = accepted.body_types.namespace,
                            receiver_scope = receiver_scope,
                            body_types = accepted.body_types,
                            signatures = functions,
                            unions = declarations.unions,
                            records = declarations.records,
                            constants = constants,
                            boolean = boolean,
                            option = option,
                            in_source_loop = False
                        }

                        signature = accepted.signature

                        match accepted.resolve_body(result, context, lambdas):
                            Ok(body):
                                -- No loan can originate without a resource declaration or a
                                -- declared scoped input. Avoid building unused lexical facts.
                                admitted: Result[Void, CheckError] = if has_resources.or(
                                    accepted.declaration.parameters.any(
                                        pure func(parameter): parameter.scoped_qualifier.is_some()
                                    )
                                ):
                                    body.admit_resource_body(
                                        id,
                                        signature,
                                        functions,
                                        inventory,
                                        inherited
                                    )
                                else:
                                    Ok(void)

                                match admitted.and_then(
                                    pure func(_): accepted.declaration.check_execution(
                                        accepted.signature.type_parameters,
                                        body.statements,
                                        body.body,
                                        id,
                                        trait_table
                                    )
                                ):
                                    Ok(execution):

                                        executed: ResolvedBody = { body | body = execution.body }

                                        published = if signature.return_type.value_type == VoidType:
                                            executed.normalize_void_body()
                                        else:
                                            executed

                                        elaborations = elaborations.set(
                                            position,
                                            ElaboratedBody({
                                                execution = execution.execution,
                                                bindings = published.bindings,
                                                statements = published.statements,
                                                body = published.body
                                            })
                                        )

                                        reached = calls_of(
                                            published.statements,
                                            published.body,
                                            no_origin
                                        )

                                        function_reach = function_reach.set(position, reached)
                                        pending = pending.reach_calls(reached, trait_table, members)
                                        lambdas = published.lambdas

                                        if synthesized_entry != Some(id):
                                            uses = uses.concat(published.uses)
                                    Err(error):
                                        failure = Some(error)
                            Err(error):
                                failure = Some(error)

        -- A body's lambdas are its own: what they call is reached through it.
        for lambda_position in first_lambda..lambdas.length():
            match lambdas.get(lambda_position):
                Some(CheckedLambdaRow(lambda)):
                    reached = calls_of(lambda.statements, lambda.body, no_origin)
                    lambda_reach = lambda_reach.append(reached)
                    pending = pending.reach_calls(reached, trait_table, members)
                Some(CollectingLambda(_)) | None:
                    void

    match failure:
        Some(error):
            Err(error)
        None:
            var checked: List[CheckedFunction] = []

            for accepted in functions:
                checked = checked.append({
                    id = accepted.id,
                    label = accepted.label,
                    signature = accepted.signature,
                    elaboration = elaborations.get_or(
                        accepted.id.function_number(),
                        BodyNotReached
                    )
                })

            match lambdas.seal_lambda_rows():
                Ok(rows):
                    Ok({
                        functions = checked,
                        lambdas = rows,
                        uses = uses,
                        calls = function_reach
                            .concat(lambda_reach)
                            .concat(template_reach)
                    })
                Err(error):
                    Err(error)


private record NormalizedVoidExit {
    statements: List[CheckedStatement],
    exit: CheckedExit
}


private pure func normalize_void_exit(
    statements: List[CheckedStatement],
    exit: CheckedExit
) -> NormalizedVoidExit:
    match exit:
        RecurWith(_, _):
            { statements = statements, exit = exit }
        ReturnExpression(value):
            discarded = statements.discard_tail_value(value)
            { statements = discarded.statements, exit = ReturnExpression(discarded.value) }


-- A Void tail value after discarding: statements, then canonical void.
private record DiscardedTail {
    statements: List[CheckedStatement],
    value: CheckedExpr
}


-- A match at a Void tail was resolved with VoidTail, so it is Void and its
-- arm values are tail values too: each is discarded the same way first.
private pure func discard_tail_value(
    statements: List[CheckedStatement],
    value: CheckedExpr
) -> DiscardedTail:
    match value.form:
        LiteralVoid:
            { statements = statements, value = value }
        _:
            {
                statements = statements.append(DiscardExpression(value.discard_arm_values())),
                value = { form = LiteralVoid, value_type = VoidType, span = value.span }
            }


private pure func discard_arm_values(value: CheckedExpr) -> CheckedExpr:
    match value.form:
        Match(join):
            var arms: List[CheckedJoinArm] = []

            for arm in join.arms:
                discarded = arm.statements.discard_tail_value(arm.value)

                arms = arms.append(
                    { arm | statements = discarded.statements, value = discarded.value }
                )

            { value | form = Match({ join | arms = arms }) }
        _:
            value


-- A Void body's tails return canonical void after discarding their values.
private pure func normalize_void_body(resolved: ResolvedBody) -> ResolvedBody:
    match resolved.body:
        CheckedValueBody(exit):
            normalized = resolved.statements.normalize_void_exit(exit)

            { resolved |
                statements = normalized.statements,
                body = CheckedValueBody(normalized.exit)
            }
        CheckedMatchBody(matched):
            arms = matched.arms.map(pure func(arm: CheckedArm) -> CheckedArm:
                normalized = arm.statements.normalize_void_exit(arm.body)
                { arm | statements = normalized.statements, body = normalized.exit }
            )

            { resolved | body = CheckedMatchBody({ matched | arms = arms }) }


-- Seal the single reserved inventory; a missing completion is a checker fault.
private pure func seal_lambda_rows(
    rows: List[LambdaRow]
) -> Result[List[CheckedLambda], CheckError]:
    var complete: List[CheckedLambda] = []
    var missing: Bool = False

    for row in rows:
        match row:
            CheckedLambdaRow(value):
                complete = complete.append(value)
            CollectingLambda(_):
                missing = True
                break

    if missing:
        Err(checker_invariant(compiler_span(), InvalidInferenceWorklist))
    else:
        Ok(complete)


-- Blocks reuse the root's accepted annotation scope and ordinary body rules.
pure func resolve_lambda_block(
    scope: List[ScopedValue],
    parameters: List[BindingDefinition],
    block: ParsedBlock,
    result: TypeUse,
    context: ResolutionContext,
    lambdas: List[LambdaRow]
) -> Result[ResolvedBody, CheckError]:
    prefix ?= block.statements.resolve_statements(
        {
            bindings = parameters,
            scope = scope,
            statements = [],
            reassigned = [],
            lambdas = lambdas,
            uses = []
        },
        context
    )

    written: ValueExpression = block.value.get_or({
        base = VoidExpression,
        base_span = block.span,
        applications = [],
        parentheses = [],
        span = block.span
    })

    value ?= prefix.resolve_value(written, result.return_expectation(), context)

    resolved: ResolvedBody = {
        bindings = value.bindings,
        statements = prefix.statements,
        body = CheckedValueBody(ReturnExpression(value.value)),
        lambdas = value.lambdas,
        uses = prefix.uses.concat(value.uses)
    }

    if result.value_type == VoidType:
        Ok(resolved.normalize_void_body())
    else:
        Ok(resolved)
