---
Transient constructor-path boundedness for checking generic instantiation.
Controls and symbols are local indices issued by the dependency producer.
No semantic declaration identity is invented or erased by this analysis.
---
import:
    bool: Bool methods
    int: INT_MAX, Int methods
    list: repeat
    option: Option methods


union PathOperation:
    KeepPath
    PushPath(Int)
    PopPath(Int)


record InstantiationPath {
    source: Int,
    target: Int,
    operation: PathOperation,
}


union PathBoundedness:
    BoundedPaths
    -- All original transition positions on any pump, including alternative
    -- balanced derivations. The producer owns their spans and family origins.
    UnboundedPaths(List[Int])


private fixed record PathPair {
    source: Int,
    target: Int,
}


-- Entry validation establishes 0 <= source,target < count and count*count <=
-- INT_MAX, so this dense key is injective and cannot wrap.
private pure func pair_key(count: Int, source: Int, target: Int) -> Int:
    source * count + target


-- The pair relation over `count` controls. `present` is indexed by pair_key,
-- so membership needs no hashing; `pairs` keeps insertion order, which is also
-- the closure's worklist order. `present[key]` is True exactly when the pair is
-- in `pairs`, so a relation is built only by no_pairs and insert. The table is
-- sized count * count up front, so entry validation's overflow check is also
-- its only size bound: the producer issues one control per path position.
private record PathPairs {
    count: Int,
    present: List[Bool],
    pairs: List[PathPair],
}


private pure func no_pairs(count: Int) -> PathPairs:
    { count = count, present = repeat(False, count * count), pairs = [] }


private pure func has_pair(paths: PathPairs, source: Int, target: Int) -> Bool:
    paths.present.get_or(pair_key(paths.count, source, target), False)


private pure func insert(paths: PathPairs, source: Int, target: Int) -> PathPairs:
    key = pair_key(paths.count, source, target)
    if paths.present.get_or(key, False):
        paths
    else:
        pair: PathPair = { source = source, target = target }
        { paths | present = paths.present.set(key, True), pairs = paths.pairs.append(pair) }


-- The insertion-ordered pair list is also the worklist: each new pair is processed
-- once. Empty matching transitions request plain transitive closure.
private pure func close_paths(initial: PathPairs, matching: List[InstantiationPath]) -> PathPairs:
    var paths = initial
    var position = 0
    while position < paths.pairs.length():
        match paths.pairs.get(position):
            None:
                void
            Some(pair):
                for control in 0..paths.count:
                    if paths.has_pair(control, pair.source):
                        paths = paths.insert(control, pair.target)
                    if paths.has_pair(pair.target, control):
                        paths = paths.insert(pair.source, control)
                for opening in matching:
                    match opening.operation:
                        PushPath(symbol):
                            if opening.target == pair.source:
                                for closing in matching:
                                    match closing.operation:
                                        PopPath(other):
                                            if (symbol == other).and(closing.source == pair.target):
                                                paths = paths.insert(opening.source, closing.target)
                                        _:
                                            void
                        _:
                            void
        position = position + 1
    paths


private pure func pump_edge(
    reachable: PathPairs,
    anchors: List[Int],
    source: Int,
    target: Int,
) -> Bool:
    var found: Bool = False
    for anchor in anchors:
        if (
            reachable
                .has_pair(anchor, source)
                .and(reachable.has_pair(target, anchor))
        ):
            found = True
            break
    found


-- Each anchor denotes a positive SCC in balanced-plus-push reachability.
-- Choices of anchor affect no membership result; no first-witness pruning.
private pure func pump_anchors(
    reachable: PathPairs,
    transitions: List[InstantiationPath],
) -> List[Int]:
    var anchors: List[Int] = []
    for transition in transitions:
        match transition.operation:
            PushPath(_):
                if (
                    reachable
                        .has_pair(transition.target, transition.source)
                        .and(
                            reachable
                                .pump_edge(anchors, transition.source, transition.target)
                                .not(),
                        )
                ):
                    anchors = anchors.append(transition.source)
            _:
                void
    anchors


private pure func mark(marked: List[Int], position: Int) -> List[Int]:
    if marked.any(pure func(found): found == position):
        marked
    else:
        marked.append(position)


-- Mark EVERY derivation of a balanced pair, not only its first producer.
-- Space is quadratic in controls; split/matching scans have product time.
private pure func pump_transitions(
    balanced: PathPairs,
    reachable: PathPairs,
    anchors: List[Int],
    transitions: List[InstantiationPath],
) -> List[Int]:
    var pairs = no_pairs(balanced.count)
    for pair in balanced.pairs:
        if reachable.pump_edge(anchors, pair.source, pair.target):
            pairs = pairs.insert(pair.source, pair.target)
    var marked: List[Int] = []
    var edge_position = 0
    for transition in transitions:
        match transition.operation:
            PushPath(_):
                if reachable.pump_edge(anchors, transition.source, transition.target):
                    marked = marked.mark(edge_position)
            _:
                void
        edge_position = edge_position + 1
    var cursor = 0
    while cursor < pairs.pairs.length():
        match pairs.pairs.get(cursor):
            None:
                void
            Some(pair):
                for split in 0..balanced.count:
                    if (
                        balanced
                            .has_pair(pair.source, split)
                            .and(balanced.has_pair(split, pair.target))
                    ):
                        pairs = pairs.insert(pair.source, split)
                        pairs = pairs.insert(split, pair.target)
                var opening_position = 0
                for opening in transitions:
                    if opening.source == pair.source:
                        match opening.operation:
                            KeepPath:
                                if opening.target == pair.target:
                                    marked = marked.mark(opening_position)
                            PushPath(symbol):
                                var closing_position = 0
                                for closing in transitions:
                                    if closing.target == pair.target:
                                        match closing.operation:
                                            PopPath(other):
                                                if (symbol == other).and(
                                                    balanced.has_pair(
                                                        opening.target,
                                                        closing.source,
                                                    ),
                                                ):
                                                    marked = marked.mark(opening_position)
                                                    marked = marked.mark(closing_position)
                                                    pairs = pairs.insert(
                                                        opening.target,
                                                        closing.source,
                                                    )
                                            _:
                                                void
                                    closing_position = closing_position + 1
                            PopPath(_):
                                void
                    opening_position = opening_position + 1
        cursor = cursor + 1
    marked


-- One control on Tarjan's depth-first path and the next of its successors to
-- visit, an offset into `successors`.
private fixed record Visit {
    control: Int,
    edge: Int,
}


-- A stack whose live part is the first `height` entries, so a pop is a
-- counter decrement and never copies the list.
private pure func push_at[T](values: List[T], height: Int, value: T) -> List[T]:
    if height < values.length():
        values.set(height, value)
    else:
        values.append(value)


-- Each control's strongly connected component over the transitions read as a
-- plain graph, named by the component's first-visited control. Tarjan's
-- algorithm, iterative so that a long chain of controls cannot exhaust the
-- stack; successors are in compressed rows (row c is successors[starts[c]
-- up to starts[c + 1]]). Callers pass transitions whose ends lie in
-- 0..count, so every index below is in range and no `get_or` default is
-- ever used: each stands in for a lookup that cannot miss.
pure func strong_components(count: Int, transitions: List[InstantiationPath]) -> List[Int]:
    var starts: List[Int] = repeat(0, count + 1)
    for transition in transitions:
        starts = starts.set(transition.source + 1, starts.get_or(transition.source + 1, 0) + 1)
    for control in 0..count:
        starts = starts.set(control + 1, starts.get_or(control + 1, 0) + starts.get_or(control, 0))
    var filled = starts
    var successors: List[Int] = repeat(0, transitions.length())
    for transition in transitions:
        slot = filled.get_or(transition.source, 0)
        successors = successors.set(slot, transition.target)
        filled = filled.set(transition.source, slot + 1)
    var order: List[Int] = repeat(-1, count)
    var low: List[Int] = repeat(-1, count)
    var component: List[Int] = repeat(-1, count)
    var frames: List[Visit] = []
    var depth = 0
    var waiting: List[Int] = []
    var height = 0
    var discovered = 0
    for root in 0..count:
        var entering: Option[Int] = None
        if order.get_or(root, 0) < 0:
            entering = Some(root)
        while (
            entering
                .is_some()
                .or(depth > 0)
        ):
            match entering:
                Some(control):
                    order = order.set(control, discovered)
                    low = low.set(control, discovered)
                    discovered = discovered + 1
                    waiting = waiting.push_at(height, control)
                    height = height + 1
                    frames = frames.push_at(depth, {
                        control = control,
                        edge = starts.get_or(control, 0),
                    })
                    depth = depth + 1
                    entering = None
                None:
                    -- depth > 0 here: the loop runs with no control to enter only then.
                    top = frames.get_or(depth - 1, { control = 0, edge = 0 })
                    if top.edge < starts.get_or(top.control + 1, 0):
                        frames = frames.set(depth - 1, { top | edge = top.edge + 1 })
                        successor = successors.get_or(top.edge, 0)
                        if order.get_or(successor, 0) < 0:
                            entering = Some(successor)
                        else:
                            -- A visited control without a component is still waiting.
                            if component.get_or(successor, 0) < 0:
                                low = low.set(
                                    top.control,
                                    low
                                        .get_or(top.control, 0)
                                        .min(order.get_or(successor, 0)),
                                )
                    else:
                        depth = depth - 1
                        finished = low.get_or(top.control, 0)
                        if finished == order.get_or(top.control, 0):
                            var member = -1
                            while member != top.control:
                                height = height - 1
                                member = waiting.get_or(height, 0)
                                component = component.set(member, top.control)
                        if depth > 0:
                            parent = frames.get_or(depth - 1, top).control
                            low = low.set(
                                parent,
                                low
                                    .get_or(parent, 0)
                                    .min(finished),
                            )
    component


-- A pump is a cycle, and every derivation of a pair whose ends share a
-- strongly connected component stays inside that component, so only
-- transitions within one component can be marked or make a path unbounded.
-- Closing over just those keeps the dense tables sized by the controls on
-- cycles, not by every control the producer issued. Controls are renumbered
-- in their original order and marks map back to original positions, so the
-- result, including the order of marks, is what the whole graph gives.
pure func bound_instantiation_paths(
    count: Int,
    transitions: List[InstantiationPath],
) -> Option[PathBoundedness]:
    -- A malformed dependency producer is distinct from a bounded graph.
    var valid: Bool = count >= 0
    if count > 0:
        valid = count <= INT_MAX / count
    for transition in transitions:
        valid = valid.and(
            (transition.source >= 0)
                .and(transition.source < count)
                .and((transition.target >= 0).and(transition.target < count)),
        )
        match transition.operation:
            PushPath(symbol): valid = valid.and(symbol >= 0)
            PopPath(symbol): valid = valid.and(symbol >= 0)
            KeepPath: void
        if valid.not():
            break
    if valid.not():
        None
    else:
        -- Validation above bounds every control, so no lookup below can miss.
        components = strong_components(count, transitions)
        var used: List[Bool] = repeat(False, count)
        var cyclic: List[InstantiationPath] = []
        var origins: List[Int] = []
        var position = 0
        for transition in transitions:
            if components.get_or(transition.source, 0) == components.get_or(transition.target, 0):
                used = used
                    .set(transition.source, True)
                    .set(transition.target, True)
                cyclic = cyclic.append(transition)
                origins = origins.append(position)
            position = position + 1
        var local: List[Int] = repeat(0, count)
        var size = 0
        for control in 0..count:
            if used.get_or(control, False):
                local = local.set(control, size)
                size = size + 1
        -- Lambdas cannot capture a `var`, so the closures below read these
        -- immutable copies.
        numbering = local
        positions = origins
        inner = cyclic.map(
            pure func(transition) -> InstantiationPath: { transition |
                source = numbering.get_or(transition.source, 0),
                target = numbering.get_or(transition.target, 0),
            },
        )
        match bound_cyclic_paths(size, inner):
            UnboundedPaths(marked):
                Some(UnboundedPaths(marked.map(pure func(found): positions.get_or(found, 0))))
            BoundedPaths:
                Some(BoundedPaths)


private pure func bound_cyclic_paths(
    count: Int,
    transitions: List[InstantiationPath],
) -> PathBoundedness:
    var initial = no_pairs(count)
    for control in 0..count:
        initial = initial.insert(control, control)
    for transition in transitions:
        match transition.operation:
            KeepPath: initial = initial.insert(transition.source, transition.target)
            _: void
    balanced = initial.close_paths(transitions)
    var forward = balanced
    for transition in transitions:
        match transition.operation:
            PushPath(_): forward = forward.insert(transition.source, transition.target)
            _: void
    reachable = forward.close_paths([])
    anchors = reachable.pump_anchors(transitions)
    if anchors.is_empty():
        BoundedPaths
    else:
        UnboundedPaths(balanced.pump_transitions(reachable, anchors, transitions))
