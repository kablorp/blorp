---
One completed-body admission validates synchronous loans before Check publishes
its products. Binding/capture facts live only for this lexical walk; ordinary
callable types and all downstream representations remain unchanged. A default
that a resource type inherits is walked again with its Self read as that
resource.
---
import:
    list: repeat
    ../../syntax/syntax: Span, Purity(Pure, Impure)
    ../ids: DeclarationInventory, FunctionId, TraitMethodId, function_number
    ../namespace/namespace: TypeHead(PrimitiveHead, ListHead, UnionHead, RecordHead)
    ./declarations: Substitution, TypeRef methods
    ./errors as errors: CheckError, ResourceUse, resource_error, scoped_error, Option methods
    ./expressions: ResolvedBody
    ./model as model:
        AcceptedImplementation,
        FunctionSignature,
        TypeRef,
        TypeUse,
        binding_number,
        lambda_number,
        capture_number,
        callable_owner,
        callable_position,
        method_receiver
    ./resource_types: TypeRef methods, declared_resource, first_mentioned, refuse
    ./signatures: AcceptedFunction


private record Admission {
    inventory: DeclarationInventory,
    functions: List[AcceptedFunction],
    lambdas: List[model.LambdaRow],
    -- Set while an inherited default is walked again: its Self, as the resource.
    lent_self: Option[Substitution]
}


private record Facts {
    bindings: List[Bool],
    definitions: List[model.BindingDefinition],
    captures: List[Bool]
}


-- A default that an implementation for a resource inherits, read from its
-- `TraitDefault` member: the method, the body it names, and the
-- implementation that reports a misuse.
record ResourceDefault {
    resource_type: model.AggregateId,
    method: TraitMethodId,
    default_body: FunctionId,
    implementation: Span
}


-- Derived once from the accepted implementations: each default one for a
-- resource inherits.
pure func resource_defaults(
    implementations: List[AcceptedImplementation],
    inventory: DeclarationInventory
) -> Result[List[ResourceDefault], CheckError]:
    var rows: List[ResourceDefault] = []
    var failure: Option[CheckError] = None

    for implementation in implementations:
        lent: Result[Option[model.AggregateId], CheckError] = match implementation.receiver_head:
            model.NamedHead(UnionHead(id)):
                union_type = model.UnionAggregate(id)
                union_type.declared_resource(inventory, implementation.span)
            model.NamedHead(PrimitiveHead(_) | ListHead | RecordHead(_)):
                Ok(None)
            model.TupleHead(_):
                Ok(None)

        match lent:
            Ok(Some(resource_type)):
                for member in implementation.methods:
                    match member.body:
                        model.TraitDefault(function):
                            rows = rows.append({
                                resource_type = resource_type,
                                method = member.method,
                                default_body = function,
                                implementation = implementation.span
                            })
                        model.AuthoredMethod(_) | model.StructuralEquality(_, _):
                            void
                        -- A tuple is no resource.
                        model.TupleEquality(_, _):
                            void
            Ok(None):
                void
            Err(error):
                failure = Some(error)
                break

    match failure:
        Some(error): Err(error)
        None: Ok(rows)


-- Admits a completed body's loans, then walks it again for each resource that
-- inherits it as a default, reading its Self as that resource: the first walk
-- saw Self rigid, so it could not see the loan.
pure func admit_resource_body(
    body: ResolvedBody,
    id: FunctionId,
    signature: FunctionSignature,
    functions: List[AcceptedFunction],
    inventory: DeclarationInventory,
    inherited: List[ResourceDefault]
) -> Result[Void, CheckError]:
    var admitted = body.admit_body_loans(signature, functions, inventory, None)

    for row in inherited:
        if (
            admitted
                .is_ok()
                .and(row.default_body == id)
        ):
            lent: Substitution = {
                owner = model.FunctionDeclaration(id),
                values = [model.NominalType(row.resource_type, [])]
            }

            admitted = match body.admit_body_loans(signature, functions, inventory, Some(lent)):
                Ok(_): Ok(void)
                Err(error): Err(error.as_lent_default(row))

    admitted


-- A loan rule the second walk broke is reported at the implementation.
private pure func as_lent_default(error: CheckError, row: ResourceDefault) -> CheckError:
    match error.lent_misuse(row.resource_type):
        Ok(misuse):
            resource_error(
                row.implementation,
                errors.InheritedDefault({
                    resource_type = row.resource_type,
                    method = row.method,
                    misuse = misuse,
                    at = error.span
                })
            )
        Err(passed):
            passed


private pure func admit_body_loans(
    body: ResolvedBody,
    signature: FunctionSignature,
    functions: List[AcceptedFunction],
    inventory: DeclarationInventory,
    lent_self: Option[Substitution]
) -> Result[Void, CheckError]:
    admission: Admission = {
        inventory = inventory,
        functions = functions,
        lambdas = body.lambdas,
        lent_self = lent_self
    }

    _: Void ?= admission.admit_lent_types(body.bindings, signature.purity, signature.return_type)
    bindings ?= admission.seed_parameters(body.bindings)
    facts: Facts = { bindings = bindings, definitions = body.bindings, captures = [] }
    completed ?= admission.admit_statements(body.statements, facts)
    admission.admit_body(body.body, completed, signature.return_type.value_type == model.VoidType)


-- The type as this walk reads it: in a second walk, with Self as the resource.
private pure func viewed(
    admission: Admission,
    value_type: TypeRef,
    span: Span
) -> Result[TypeRef, CheckError]:
    match admission.lent_self:
        None: Ok(value_type)
        Some(lent): value_type.substitute_type(lent, span)


-- Elaboration admitted written types (`resolve_type`) and refused a pure
-- lambda's resource parameter (`lambda_scope`) with Self rigid. In a second
-- walk each binding's type and the result are admitted again as if written,
-- and a pure body's parameters again cannot be the resource.
private pure func admit_lent_types(
    admission: Admission,
    bindings: List[model.BindingDefinition],
    purity: Purity,
    result: TypeUse
) -> Result[Void, CheckError]:
    var admitted: Result[Void, CheckError] = Ok(void)

    if admission.lent_self.is_some():
        admitted = admission.admit_written(result.value_type, result.span, None)

        pure_parameter: Option[ResourceUse] = match purity:
            Pure: Some(errors.ResourcePureParameter)
            Impure: None

        for definition in bindings:
            whole: Option[ResourceUse] = match definition.origin:
                model.ParameterBinding(_) | model.CallableParameterBinding(_): pure_parameter
                model.BodyLocal | model.MatchCapture: None

            if admitted.is_ok():
                admitted = admission.admit_written(definition.value_type, definition.span, whole)

    admitted


private pure func admit_written(
    admission: Admission,
    value_type: TypeRef,
    span: Span,
    whole: Option[ResourceUse]
) -> Result[Void, CheckError]:
    seen ?= admission.viewed(value_type, span)
    seen.admit_as_written(admission.inventory, span, whole)


-- A scoped parameter's binding starts scoped; every other binding starts unscoped.
private pure func seed_parameters(
    admission: Admission,
    definitions: List[model.BindingDefinition]
) -> Result[List[Bool], CheckError]:
    var bindings: List[Bool] = repeat(False, definitions.length())
    var failure: Option[CheckError] = None
    var position = 0

    for definition in definitions:
        match definition.origin:
            model.CallableParameterBinding(parameter):
                match admission.promised(parameter, definition.span):
                    Ok(promise): bindings = bindings.set(position, promise)
                    Err(error): failure = Some(error)
            model.ParameterBinding(_) | model.BodyLocal | model.MatchCapture:
                void

        if failure.is_some():
            break

        position = position + 1

    match failure:
        Some(error): Err(error)
        None: Ok(bindings)


-- Signature acceptance admits `scoped` only on a declared function's callable
-- parameter, so its parsed qualifier is the parameter's promise.
private pure func promised(
    admission: Admission,
    parameter: model.CallableParameterId,
    span: Span
) -> Result[Bool, CheckError]:
    owner = parameter.callable_owner()

    function ?= admission.functions
        .get(owner.function_number())
        .or_checker_invariant(span, errors.InvalidFunctionContract)

    written ?= function.declaration.parameters
        .get(parameter.callable_position())
        .or_checker_invariant(span, errors.InvalidFunctionContract)

    Ok(written.scoped_qualifier.is_some())


private pure func admit_statements(
    admission: Admission,
    statements: List[model.CheckedStatement],
    facts: Facts
) -> Result[Facts, CheckError]:
    var admitted: Result[Facts, CheckError] = Ok(facts)

    for statement in statements:
        match admitted:
            Ok(current): admitted = admission.admit_statement(statement, current)
            Err(_): break

    admitted


private pure func admit_statement(
    admission: Admission,
    statement: model.CheckedStatement,
    facts: Facts
) -> Result[Facts, CheckError]:
    match statement:
        model.InitializeBinding(id, value) | model.ReassignBinding(id, value):
            admission.admit_binding(id, value, facts)
        model.DiscardExpression(value):
            admission
                .admit_expression(value, facts)
                .map(pure func(_): facts)
        model.RunWhile(loop):
            admission
                .admit_expression(loop.condition, facts)
                .and_then(pure func(_): admission.admit_statements(loop.body, facts))
                .map(pure func(_): facts)
        model.RunFor(loop):
            values: List[model.CheckedExpr] = match loop.iteration:
                model.ListIteration(value, _, _): [value]
                model.AscendingIntRange(start, end, _): [start, end]

            admission
                .admit_storage(values, facts)
                .and_then(pure func(_): admission.admit_statements(loop.body, facts))
                .map(pure func(_): facts)
        model.BreakSourceLoop(_) | model.ContinueSourceLoop(_):
            Ok(facts)


-- No binding holds a resource, and only an immutable one holds a scoped callable.
private pure func admit_binding(
    admission: Admission,
    id: model.BindingId,
    value: model.CheckedExpr,
    facts: Facts
) -> Result[Facts, CheckError]:
    scoped_callable ?= admission.admit_expression(value, facts)

    definition ?= facts.definitions
        .get(id.binding_number())
        .or_checker_invariant(value.span, errors.InvalidInferenceWorklist)

    stored ?= admission.viewed(value.value_type, value.span)

    _: Void ?= stored.refuse_resource(admission.inventory, value.span, errors.ResourceStorage)

    if scoped_callable.and(definition.mutable):
        Err(scoped_error(value.span, errors.ScopedStorage))
    else:
        Ok({ facts | bindings = facts.bindings.set(id.binding_number(), scoped_callable) })


private pure func admit_body(
    admission: Admission,
    body: model.CheckedBody,
    facts: Facts,
    discard: Bool
) -> Result[Void, CheckError]:
    match body:
        model.CheckedValueBody(exit):
            admission.admit_exit(exit, facts, discard)
        model.CheckedMatchBody(matched):
            var admitted = admission.admit_match_root(matched.scrutinee, facts)

            for arm in matched.arms:
                if admitted.is_ok():
                    admitted = admission
                        .admit_statements(arm.statements, facts)
                        .and_then(
                            pure func(completed): admission.admit_exit(
                                arm.body,
                                completed,
                                discard
                            )
                        )

            admitted


private pure func admit_exit(
    admission: Admission,
    exit: model.CheckedExit,
    facts: Facts,
    discard: Bool
) -> Result[Void, CheckError]:
    match exit:
        model.ReturnExpression(value):
            admission.admit_return(value, facts, discard)
        model.RecurWith(_, span):
            Err(errors.checker_invariant(span, errors.InvalidInferenceWorklist))


-- Root Void normalization runs after admission. Its tail expression is a
-- discard, while constructions within it still cannot store loans.
private pure func admit_return(
    admission: Admission,
    value: model.CheckedExpr,
    facts: Facts,
    discard: Bool
) -> Result[Void, CheckError]:
    scoped_callable ?= admission.admit_expression(value, facts)
    returned ?= admission.viewed(value.value_type, value.span)

    if discard:
        Ok(void)
    else if scoped_callable:
        Err(scoped_error(value.span, errors.ScopedResult))
    else:
        returned.refuse_resource(admission.inventory, value.span, errors.ResourceResult)


-- Check rejects matching a callable, and a resource outside its declaring
-- module, and admission rejects a construction that could hold a loan before
-- it reaches the root. A root that is a resource union is the one resource a
-- match reads: its module's match selects on the erased handle, which is plain
-- data, and the match makes no binding that holds the resource, so every
-- pattern binding keeps its unscoped fact.
private pure func admit_match_root(
    admission: Admission,
    scrutinee: model.CheckedExpr,
    facts: Facts
) -> Result[Void, CheckError]:
    scoped_callable ?= admission.admit_expression(scrutinee, facts)
    matched ?= admission.viewed(scrutinee.value_type, scrutinee.span)
    whole ?= matched.as_resource(admission.inventory, scrutinee.span)
    held ?= matched.mentioned_resource(admission.inventory, scrutinee.span)

    -- `held` is Some whenever `whole` is, so a root that is a resource union
    -- is admitted and only a root that merely mentions one is refused. User
    -- code cannot reach that case: the container and type-argument errors
    -- fire first, which is why LoanInMatchRoot stays a checker invariant.
    around_resource = whole
        .is_none()
        .and(held.is_some())

    if scoped_callable.or(around_resource):
        Err(errors.checker_invariant(scrutinee.span, errors.LoanInMatchRoot))
    else:
        Ok(void)


private pure func admit_join(
    admission: Admission,
    joined: model.CheckedJoin,
    facts: Facts
) -> Result[Bool, CheckError]:
    _: Void ?= admission.admit_match_root(joined.scrutinee, facts)
    var admitted: Result[Bool, CheckError] = Ok(False)

    for arm in joined.arms:
        match admitted:
            Ok(scoped_callable):
                admitted = admission
                    .admit_statements(arm.statements, facts)
                    .and_then(
                        pure func(completed): admission.admit_expression(arm.value, completed)
                    )
                    .map(pure func(value): scoped_callable.or(value))
            Err(_):
                break

    admitted


private pure func admit_storage(
    admission: Admission,
    values: List[model.CheckedExpr],
    facts: Facts
) -> Result[Void, CheckError]:
    var admitted: Result[Void, CheckError] = Ok(void)

    for value in values:
        if admitted.is_ok():
            admitted = admission.admit_stored(value, facts)

    admitted


private pure func admit_stored(
    admission: Admission,
    value: model.CheckedExpr,
    facts: Facts
) -> Result[Void, CheckError]:
    scoped_callable ?= admission.admit_expression(value, facts)
    stored ?= admission.viewed(value.value_type, value.span)

    _: Void ?= stored.refuse_resource(admission.inventory, value.span, errors.ResourceStorage)

    if scoped_callable:
        Err(scoped_error(value.span, errors.ScopedStorage))
    else:
        Ok(void)


-- Final generic actuals and resource identities first coexist here without
-- adding declaration inventories throughout elaboration's inference state.
private pure func admit_type_arguments(
    admission: Admission,
    arguments: List[model.TypeRef],
    span: Span
) -> Result[Void, CheckError]:
    var admitted: Result[Void, CheckError] = Ok(void)

    for argument in arguments:
        if admitted.is_ok():
            admitted = admission
                .viewed(argument, span)
                .and_then(
                    pure func(seen): seen
                        .mentioned_resource(admission.inventory, span)
                        .refuse(span, errors.ResourceInferredType(seen))
                )

    admitted


-- A method's receiver is Self, not a type argument a generic body could keep:
-- every body that receives a resource as Self is walked with it in view.
private pure func admit_receiver(
    admission: Admission,
    receiver: TypeRef,
    span: Span
) -> Result[Void, CheckError]:
    seen ?= admission.viewed(receiver, span)
    whole ?= seen.as_resource(admission.inventory, span)

    match whole:
        Some(_): Ok(void)
        None: admission.admit_type_arguments([receiver], span)


private pure func admit_choice(
    admission: Admission,
    choice: model.CallableChoice,
    span: Span,
    facts: Facts
) -> Result[Bool, CheckError]:
    match choice:
        model.StoredCallable(value):
            admission.admit_expression(value, facts)
        model.ForwardedCallable(parameter):
            admission.promised(parameter, span)
        model.NamedCallable(_, arguments):
            admission
                .admit_type_arguments(arguments, span)
                .map(pure func(_): False)
        model.MethodCallable(method):
            admission
                .admit_receiver(method.method_receiver(), span)
                .map(pure func(_): False)
        model.LambdaCallable(id, environment):
            admission.admit_closure(id, environment, span, facts)


private pure func admit_closure(
    admission: Admission,
    id: model.LambdaId,
    environment: List[model.CheckedExpr],
    span: Span,
    facts: Facts
) -> Result[Bool, CheckError]:
    var captures: List[Bool] = []
    var scoped_capture: Bool = False
    -- The first resource captured, and its position among the captures.
    var captured_resource: Option[(model.AggregateId, Int)] = None
    var failure: Option[CheckError] = None

    for value in environment:
        match admission.admit_expression(value, facts):
            Err(error):
                failure = Some(error)
                break
            Ok(captured):
                whole = admission
                    .viewed(value.value_type, value.span)
                    .and_then(pure func(seen): seen.as_resource(admission.inventory, value.span))

                match whole:
                    Err(error):
                        failure = Some(error)
                        break
                    Ok(held):
                        match (captured_resource, held):
                            (None, Some(nominal)):
                                captured_resource = Some((nominal, captures.length()))
                            _:
                                void

                        captures = captures.append(captured)
                        scoped_capture = scoped_capture.or(captured)

    _: Void ?= match failure:
        Some(error): Err(error)
        None: Ok(void)

    row ?= admission.lambdas
        .get(id.lambda_number())
        .or_checker_invariant(span, errors.InvalidInferenceWorklist)

    lambda: model.CheckedLambda ?= match row:
        model.CheckedLambdaRow(value):
            Ok(value)
        model.CollectingLambda(_):
            Err(errors.checker_invariant(span, errors.InvalidInferenceWorklist))

    -- A task may run at once with its block's code, so it captures neither a
    -- resource nor a scoped callable, each rejected at its first use. A default
    -- walked again with Self read as a resource names the type instead, and a
    -- rest of a block's tasks only forwards what its tasks' walks reject.
    _: Void ?= match (lambda.origin, lambda.purity, captured_resource, admission.lent_self):
        (model.BlockTask, _, Some((captured, _)), Some(_)):
            Err(resource_error(span, errors.MisusedResource(captured, errors.ResourceTaskCapture)))
        (model.BlockTask, _, Some((_, position)), None):
            lambda.captures.refuse_capture(Some(position), errors.TaskResource, span)
        (model.BlockTask, _, None, _):
            lambda.captures.refuse_capture(captures.index_of(True), errors.TaskScopedCallable, span)
        (model.WrittenLambda, Pure, Some((captured, _)), _):
            Err(resource_error(span, errors.MisusedResource(captured, errors.ResourcePureCapture)))
        (model.WrittenLambda, _, _, _) | (model.BlockRest, _, _, _):
            Ok(void)

    _: Void ?= admission.admit_lambda(lambda, captures)
    Ok(scoped_capture.or(captured_resource.is_some()))


-- The capture at `position`, if any, rejected under `rule` at its first use.
private pure func refuse_capture(
    captures: List[model.CheckedCapture],
    position: Option[Int],
    rule: errors.TaskRule,
    span: Span
) -> Result[Void, CheckError]:
    match position.map(pure func(index) -> Option[model.CheckedCapture]: captures.get(index)):
        Some(Some(capture)):
            first_use = capture.value_type.span
            Err(errors.concurrency_error(first_use, errors.TaskRejection(rule, capture.name)))
        Some(None):
            Err(errors.checker_invariant(span, errors.InvalidInferenceWorklist))
        None:
            Ok(void)


private pure func admit_lambda(
    admission: Admission,
    lambda: model.CheckedLambda,
    captures: List[Bool]
) -> Result[Void, CheckError]:
    result = lambda.return_type
    returned ?= admission.viewed(result.value_type, result.span)

    _: Void ?= returned.refuse_resource(admission.inventory, result.span, errors.ResourceResult)

    _: Void ?= admission.admit_lent_types(lambda.bindings, lambda.purity, result)

    facts: Facts = {
        bindings = repeat(False, lambda.bindings.length()),
        definitions = lambda.bindings,
        captures = captures
    }

    completed ?= admission.admit_statements(lambda.statements, facts)
    admission.admit_body(lambda.body, completed, lambda.return_type.value_type == model.VoidType)


private pure func admit_call(
    admission: Admission,
    call: model.CheckedCall,
    facts: Facts
) -> Result[Bool, CheckError]:
    var admitted: Result[Void, CheckError] = match call.target:
        model.UserFunction(_, arguments):
            admission.admit_type_arguments(arguments, call.span)
        model.TraitMethod(method):
            admission.admit_receiver(method.method_receiver(), call.span)
        model.ValueCall(value):
            admission
                .admit_expression(value, facts)
                .map(pure func(_): void)
        -- A callable type carries no promise, and a runtime operation takes
        -- only values; the loop below admits their operands.
        model.CallableParameter(_) | model.RuntimeFunction(_):
            Ok(void)

    for operand in call.operands:
        if admitted.is_ok():
            admitted = admission.admit_operand(operand, facts)

    admitted.map(pure func(_): False)


-- Only a declared callee's scoped parameter may receive a scoped callable.
private pure func admit_operand(
    admission: Admission,
    operand: model.CheckedCallOperand,
    facts: Facts
) -> Result[Void, CheckError]:
    match operand:
        model.ValueOperand(value):
            match admission.admit_expression(value, facts):
                Ok(True): Err(scoped_error(value.span, errors.ScopedArgument))
                Ok(False): Ok(void)
                Err(error): Err(error)
        model.CallableOperand(parameter, choice, span):
            -- A stored callable is reported where it is read.
            culprit = match choice:
                model.StoredCallable(value):
                    value.span
                model.MethodCallable(_) | model.NamedCallable(_, _) | model.ForwardedCallable(_) | model.LambdaCallable(_, _):
                    span

            match admission.admit_choice(choice, span, facts):
                Ok(True):
                    match admission.promised(parameter, span):
                        Ok(True): Ok(void)
                        Ok(False): Err(scoped_error(culprit, errors.ScopedArgument))
                        Err(error): Err(error)
                Ok(False):
                    Ok(void)
                Err(error):
                    Err(error)


private pure func admit_expression(
    admission: Admission,
    value: model.CheckedExpr,
    facts: Facts
) -> Result[Bool, CheckError]:
    match value.form:
        model.ReadBinding(id):
            facts.bindings
                .get(id.binding_number())
                .or_checker_invariant(value.span, errors.InvalidInferenceWorklist)
        model.ReadCapture(id):
            facts.captures
                .get(id.capture_number())
                .or_checker_invariant(value.span, errors.InvalidInferenceWorklist)
        model.MakeCallable(choice):
            admission.admit_choice(choice, value.span, facts)
        model.InvokeFunction(call):
            admission.admit_call(call, facts)
        model.Match(joined):
            admission
                .admit_join(joined, facts)
                .map(
                    pure func(scoped_callable): scoped_callable.and(
                        value.value_type != model.VoidType
                    )
                )
        model.ConstructVariant(_, children) | model.ConstructList(children) | model.ConstructTuple(children):
            admission.admit_construction(value, children, facts)
        model.ConstructRecord(_, fields):
            admission.admit_construction(value, fields.map(pure func(field): field.value), facts)
        model.UpdateRecord(_, update):
            admission.admit_construction(
                value,
                [update.base].concat(update.replacements.map(pure func(field): field.value)),
                facts
            )
        model.ReadRecordField(child, _) | model.ReadTupleElement(child, _):
            admission
                .admit_expression(child, facts)
                .map(pure func(_): False)
        model.LiteralVoid | model.LiteralInteger(_) | model.LiteralFloat(_) | model.LiteralString(_):
            Ok(False)


-- An inferred container type has no written type-use boundary: `[consume]`
-- would otherwise hide a resource-taking callable in a List. A construction
-- is never scoped, and none of its children may hold a loan.
private pure func admit_construction(
    admission: Admission,
    value: model.CheckedExpr,
    children: List[model.CheckedExpr],
    facts: Facts
) -> Result[Bool, CheckError]:
    constructed ?= admission.viewed(value.value_type, value.span)

    _: Void ?= constructed
        .type_children()
        .first_mentioned(admission.inventory, value.span)
        .refuse(value.span, errors.ResourceInferredType(constructed))

    _: Void ?= admission.admit_storage(children, facts)
    Ok(False)
