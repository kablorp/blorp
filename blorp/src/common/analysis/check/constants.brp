---
Accepts every constant annotation before signatures and closed construction templates.
The temporary headers disappear when the dense complete rows are published.
---
import:
    result: Result methods
    ../../syntax/syntax: TypeSyntax
    ../assemble: ParsedContents
    ../ids: ConstantId, DeclarationInventory
    ../namespace/namespace: Namespace
    ./constructors: ConstructionContext
    ./declarations: TypeScope, type_access
    ./errors: CheckError, CheckerInvariant(InvalidConstantDeclaration), checker_invariant
    ./expressions: check_constant_initializer
    ./model: CheckedConstant, CheckedRecord, CheckedUnion, TypeUse
    ./signatures: AcceptedFunction
    ./traits: TraitAvailability


pure func constant_annotations(
    parsed: ParsedContents,
    namespace: Namespace,
) -> Result[List[TypeUse], CheckError]:
    var accepted: List[TypeUse] = []
    var failure: Option[CheckError] = None
    for row in parsed.declarations.inventory_constants():
        declaration = row.declaration
        scope: TypeScope = {
            self_binding = None,
            records = parsed.declarations.inventory_records(),
            unions = parsed.declarations.inventory_unions(),
            opaques = parsed.declarations.inventory_opaques(),
            namespace = namespace,
            module = declaration.module,
            access = declaration.visibility.type_access(declaration.name.id),
            parameters = [],
        }
        match scope.resolve_type(declaration.type_name):
            Ok(value_type):
                accepted = accepted.append({
                    value_type = value_type,
                    span = declaration.type_name.type_span(),
                })
            Err(error):
                failure = Some(error)
                break
    match failure:
        Some(error): Err(error)
        None: Ok(accepted)


pure func validate_constants(
    parsed: ParsedContents,
    namespace: Namespace,
    annotations: List[TypeUse],
    records: List[CheckedRecord],
    unions: List[CheckedUnion],
    signatures: List[AcceptedFunction],
    traits: TraitAvailability,
) -> Result[List[CheckedConstant], CheckError]:
    var accepted: List[CheckedConstant] = []
    var failure: Option[CheckError] = None
    for row in parsed.declarations.inventory_constants():
        result = match annotations.get(row.id.constant_number()):
            Some(annotation):
                context: ConstructionContext = {
                    module = row.declaration.module,
                    namespace = namespace,
                    records = records,
                    unions = unions,
                }
                row.declaration.value
                    .check_constant_initializer(annotation, context, signatures, traits)
                    .map(
                        pure func(value) -> CheckedConstant: {
                            id = row.id,
                            annotation = annotation.span,
                            value = value,
                        },
                    )
            None:
                Err(
                    checker_invariant(
                        row.declaration.name.span,
                        InvalidConstantDeclaration(row.id),
                    ),
                )
        match result:
            Ok(constant):
                accepted = accepted.append(constant)
            Err(error):
                failure = Some(error)
                break
    match failure:
        Some(error): Err(error)
        None: Ok(accepted)
