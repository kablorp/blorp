---
Accepts every constant annotation before signatures and closed construction templates.
The temporary headers disappear when the dense complete rows are published.
---
import:
    option: Option methods
    result: Result methods
    ../../syntax/syntax: TypeSyntax
    ../assemble: ParsedContents
    ../ids: ConstantId, DeclarationInventory
    ../namespace/namespace: Namespace
    ./constructors: ConstructionContext
    ./declarations: AnnotatedTypes, ResolvedType(ResolvedTypeTerm), TypeScope, type_access
    ./errors: CheckError, CheckerInvariant(InvalidConstantDeclaration), checker_invariant
    ./expressions: check_constant_initializer
    ./model: CheckedConstant, CheckedRecord, CheckedUnion, TypeUse, TypeRef
    ./name_uses: NameUse
    ./resource_types: TypeRef methods
    ./signatures: AcceptedFunction
    ./traits: TraitAvailability


pure func constant_annotations(
    parsed: ParsedContents,
    namespace: Namespace
) -> Result[AnnotatedTypes, CheckError]:
    var accepted: List[TypeUse] = []
    var uses: List[NameUse] = []
    var failure: Option[CheckError] = None
    for row in parsed.declarations.inventory_constants():
        declaration = row.declaration
        scope: TypeScope = {
            self_binding = None,
            records = parsed.declarations.inventory_records(),
            unions = parsed.declarations.inventory_unions(),
            opaques = parsed.declarations.inventory_opaques(),
            namespace = namespace,
            module = declaration.module,
            access = declaration.visibility.type_access(declaration.name.id),
            parameters = []
        }
        span = declaration.type_name.type_span()
        match scope.resolve_type(declaration.type_name, []):
            Ok(ResolvedTypeTerm(value_type, annotation_uses)):
                match value_type.resource_free(scope.opaques, span):
                    Ok(_):
                        accepted = accepted.append({ value_type = value_type, span = span })
                        uses = uses.concat(annotation_uses)
                    Err(error):
                        failure = Some(error)
            Err(error):
                failure = Some(error)
        if failure.is_some():
            break
    match failure:
        Some(error): Err(error)
        None: Ok({ types = accepted, uses = uses })


-- Every constant's checked template in declaration order, and the names their
-- initializers use.
record CheckedConstants {
    constants: List[CheckedConstant],
    uses: List[NameUse]
}


pure func validate_constants(
    parsed: ParsedContents,
    namespace: Namespace,
    annotations: List[TypeUse],
    records: List[CheckedRecord],
    unions: List[CheckedUnion],
    signatures: List[AcceptedFunction],
    traits: TraitAvailability
) -> Result[CheckedConstants, CheckError]:
    var accepted: List[CheckedConstant] = []
    var uses: List[NameUse] = []
    var failure: Option[CheckError] = None
    for row in parsed.declarations.inventory_constants():
        match annotations.get(row.id.constant_number()):
            Some(annotation):
                context: ConstructionContext = {
                    module = row.declaration.module,
                    namespace = namespace,
                    records = records,
                    unions = unions,
                    type_parameters = []
                }
                match row.declaration.value.check_constant_initializer(
                    annotation,
                    context,
                    signatures,
                    traits
                ):
                    Ok(checked):
                        accepted = accepted.append({
                            id = row.id,
                            annotation = annotation.span,
                            value = checked.value
                        })
                        uses = uses.concat(checked.uses)
                    Err(error):
                        failure = Some(error)
            None:
                failure = Some(
                    checker_invariant(
                        row.declaration.name.span,
                        InvalidConstantDeclaration(row.id)
                    )
                )
        if failure.is_some():
            break
    match failure:
        Some(error): Err(error)
        None: Ok({ constants = accepted, uses = uses })
