-- The constructors of the foundation's designated unions. The foundation check
-- establishes them once as declaration identities (`Variant` = VariantId);
-- specialization translates them per concrete instance. Each union's identity
-- is its constructors' owner, so no second field records it.
record DesignatedBoolean[Variant] {
    true_variant: Variant,
    false_variant: Variant,
}


record DesignatedOption[Variant] {
    some: Variant,
    none: Variant,
}


record DesignatedResult[Variant] {
    ok: Variant,
    err: Variant,
}


record DesignatedUnions {
    boolean: DesignatedBoolean[VariantId],
    option: DesignatedOption[VariantId],
    result: DesignatedResult[VariantId],
}


-- A storage format, carried by checked types and runtime operations. Each phase
-- owns exhaustive projections of the facts it needs.
fixed union IntegerFormat:
    Int64Format


pure func integer_primitive(format: IntegerFormat) -> PrimitiveType:
    match format:
        Int64Format: BuiltinInt


-- Whether a format is plain data that a fixed record or union stores inline.
pure func integer_fixed_storage(format: IntegerFormat) -> Bool:
    match format:
        Int64Format: True


-- Int is the parser's literal carrier, so every representable value fits Int64.
pure func integer_fits(format: IntegerFormat, value: Int) -> Bool:
    match format:
        Int64Format: True


-- An operation whose result is a designated union carries that union's
-- constructors; the checker supplies them from the one designation.
union RuntimeOperation[Variant, Element]:
    IntegerAdd(IntegerFormat)
    IntegerSubtract(IntegerFormat)
    IntegerMultiply(IntegerFormat)
    IntegerDivide(IntegerFormat)
    IntegerRemainder(IntegerFormat)
    IntegerToString(IntegerFormat)
    FloatAdd
    FloatSubtract
    FloatMultiply
    FloatDivide
    FloatRemainder
    FloatToString
    FloatCopySign
    FloatEquals(DesignatedBoolean[Variant])
    FloatLessThan(DesignatedBoolean[Variant])
    StringLength
    StringConcat
    StringAppendInt
    StringPrint
    StringPrintError
    StringParseInt(DesignatedOption[Variant])
    StringParseFloat(DesignatedOption[Variant])
    StringByteAt(DesignatedOption[Variant])
    StringFromCodepoint(DesignatedOption[Variant])
    StringSlice(DesignatedOption[Variant])
    SystemCall(SystemOperation, DesignatedResult[Variant])
    ListRepeat(Element)
    ListLength(Element)
    ListGet(Element, DesignatedOption[Variant])
    ListAppend(Element)
    ListSet(Element)
    ListConcat(Element)
    StringEquals(DesignatedBoolean[Variant])
    IntegerEquals(IntegerFormat, DesignatedBoolean[Variant])
    IntegerLessThan(IntegerFormat, DesignatedBoolean[Variant])


union PrimitiveType:
    BuiltinInt
    BuiltinFloat
    BuiltinString
    BuiltinVoid


union RuntimeType[Element]:
    PrimitiveRuntimeType(PrimitiveType)
    ElementRuntimeType(Element)
    ListRuntimeType(Element)
    StringListRuntimeType


-- Union results retain their designated constructors and exact payload types.
union RuntimeResult[Variant, Element]:
    ValueResult(RuntimeType[Element])
    OptionalResult(RuntimeType[Element], DesignatedOption[Variant])
    ResultResult(RuntimeType[Element], RuntimeType[Element], DesignatedResult[Variant])
    BooleanResult(DesignatedBoolean[Variant])


record RuntimeContract[Variant, Element] {
    purity: Purity,
    parameters: List[RuntimeType[Element]],
    return_type: RuntimeResult[Variant, Element],
}


-- The sole authority for runtime signatures. Element and designated
-- constructor identities are accepted before constructing an operation; no
-- phase supplies a missing E.
pure func runtime_contract[Variant, Element](
    operation: RuntimeOperation[Variant, Element],
) -> RuntimeContract[Variant, Element]:
    match operation:
        IntegerAdd(format) | IntegerSubtract(format) | IntegerMultiply(format) | IntegerDivide(format) | IntegerRemainder(format):
            {
                purity = Pure,
                parameters = [
                    PrimitiveRuntimeType(integer_primitive(format)),
                    PrimitiveRuntimeType(integer_primitive(format)),
                ],
                return_type = ValueResult(PrimitiveRuntimeType(integer_primitive(format))),
            }
        FloatAdd | FloatSubtract | FloatMultiply | FloatDivide | FloatRemainder | FloatCopySign:
            {
                purity = Pure,
                parameters = [
                    PrimitiveRuntimeType(BuiltinFloat),
                    PrimitiveRuntimeType(BuiltinFloat),
                ],
                return_type = ValueResult(PrimitiveRuntimeType(BuiltinFloat)),
            }
        FloatToString:
            {
                purity = Pure,
                parameters = [PrimitiveRuntimeType(BuiltinFloat)],
                return_type = ValueResult(PrimitiveRuntimeType(BuiltinString)),
            }
        IntegerToString(format):
            {
                purity = Pure,
                parameters = [PrimitiveRuntimeType(integer_primitive(format))],
                return_type = ValueResult(PrimitiveRuntimeType(BuiltinString)),
            }
        StringLength:
            {
                purity = Pure,
                parameters = [PrimitiveRuntimeType(BuiltinString)],
                return_type = ValueResult(PrimitiveRuntimeType(BuiltinInt)),
            }
        StringConcat:
            {
                purity = Pure,
                parameters = [
                    PrimitiveRuntimeType(BuiltinString),
                    PrimitiveRuntimeType(BuiltinString),
                ],
                return_type = ValueResult(PrimitiveRuntimeType(BuiltinString)),
            }
        StringAppendInt:
            {
                purity = Pure,
                parameters = [
                    PrimitiveRuntimeType(BuiltinString),
                    PrimitiveRuntimeType(BuiltinInt),
                ],
                return_type = ValueResult(PrimitiveRuntimeType(BuiltinString)),
            }
        StringPrint | StringPrintError:
            {
                purity = Impure,
                parameters = [PrimitiveRuntimeType(BuiltinString)],
                return_type = ValueResult(PrimitiveRuntimeType(BuiltinVoid)),
            }
        StringParseInt(option):
            {
                purity = Pure,
                parameters = [PrimitiveRuntimeType(BuiltinString)],
                return_type = OptionalResult(PrimitiveRuntimeType(BuiltinInt), option),
            }
        StringParseFloat(option):
            {
                purity = Pure,
                parameters = [PrimitiveRuntimeType(BuiltinString)],
                return_type = OptionalResult(PrimitiveRuntimeType(BuiltinFloat), option),
            }
        StringByteAt(option):
            {
                purity = Pure,
                parameters = [
                    PrimitiveRuntimeType(BuiltinString),
                    PrimitiveRuntimeType(BuiltinInt),
                ],
                return_type = OptionalResult(PrimitiveRuntimeType(BuiltinInt), option),
            }
        StringFromCodepoint(option):
            {
                purity = Pure,
                parameters = [PrimitiveRuntimeType(BuiltinInt)],
                return_type = OptionalResult(PrimitiveRuntimeType(BuiltinString), option),
            }
        StringSlice(option):
            {
                purity = Pure,
                parameters = [
                    PrimitiveRuntimeType(BuiltinString),
                    PrimitiveRuntimeType(BuiltinInt),
                    PrimitiveRuntimeType(BuiltinInt),
                ],
                return_type = OptionalResult(PrimitiveRuntimeType(BuiltinString), option),
            }
        SystemCall(system, result):
            signature = system.system_signature()
            parameters = signature.parameters.map(
                pure func(parameter: SystemParameter) -> RuntimeType[Element]: parameter.parameter_runtime_type(),
            )
            {
                purity = Impure,
                parameters = parameters,
                return_type = ResultResult(
                    signature.success.payload_runtime_type(),
                    signature.error.payload_runtime_type(),
                    result,
                ),
            }
        ListRepeat(element):
            {
                purity = Pure,
                parameters = [ElementRuntimeType(element), PrimitiveRuntimeType(BuiltinInt)],
                return_type = ValueResult(ListRuntimeType(element)),
            }
        ListLength(element):
            {
                purity = Pure,
                parameters = [ListRuntimeType(element)],
                return_type = ValueResult(PrimitiveRuntimeType(BuiltinInt)),
            }
        ListGet(element, option):
            {
                purity = Pure,
                parameters = [ListRuntimeType(element), PrimitiveRuntimeType(BuiltinInt)],
                return_type = OptionalResult(ElementRuntimeType(element), option),
            }
        ListAppend(element):
            {
                purity = Pure,
                parameters = [ListRuntimeType(element), ElementRuntimeType(element)],
                return_type = ValueResult(ListRuntimeType(element)),
            }
        ListSet(element):
            {
                purity = Pure,
                parameters = [
                    ListRuntimeType(element),
                    PrimitiveRuntimeType(BuiltinInt),
                    ElementRuntimeType(element),
                ],
                return_type = ValueResult(ListRuntimeType(element)),
            }
        ListConcat(element):
            {
                purity = Pure,
                parameters = [ListRuntimeType(element), ListRuntimeType(element)],
                return_type = ValueResult(ListRuntimeType(element)),
            }
        StringEquals(boolean):
            {
                purity = Pure,
                parameters = [
                    PrimitiveRuntimeType(BuiltinString),
                    PrimitiveRuntimeType(BuiltinString),
                ],
                return_type = BooleanResult(boolean),
            }
        IntegerEquals(format, boolean):
            {
                purity = Pure,
                parameters = [
                    PrimitiveRuntimeType(integer_primitive(format)),
                    PrimitiveRuntimeType(integer_primitive(format)),
                ],
                return_type = BooleanResult(boolean),
            }
        IntegerLessThan(format, boolean):
            {
                purity = Pure,
                parameters = [
                    PrimitiveRuntimeType(integer_primitive(format)),
                    PrimitiveRuntimeType(integer_primitive(format)),
                ],
                return_type = BooleanResult(boolean),
            }
        FloatEquals(boolean):
            {
                purity = Pure,
                parameters = [
                    PrimitiveRuntimeType(BuiltinFloat),
                    PrimitiveRuntimeType(BuiltinFloat),
                ],
                return_type = BooleanResult(boolean),
            }
        FloatLessThan(boolean):
            {
                purity = Pure,
                parameters = [
                    PrimitiveRuntimeType(BuiltinFloat),
                    PrimitiveRuntimeType(BuiltinFloat),
                ],
                return_type = BooleanResult(boolean),
            }


-- A system call's parameter, always borrowed.
union SystemParameter:
    IntParameter
    StringParameter
    StringListParameter


-- One branch of a system call's Result, which takes one fresh payload.
union SystemPayload:
    IntPayload
    StringPayload
    StringListPayload
    VoidPayload


-- A system operation's row. Every system call is impure and returns the
-- designated Result, so only its parameters and payloads vary.
record SystemSignature {
    parameters: List[SystemParameter],
    success: SystemPayload,
    error: SystemPayload,
}


pure func system_signature(operation: SystemOperation) -> SystemSignature:
    match operation:
        CurrentDirectory:
            { parameters = [], success = StringPayload, error = IntPayload }
        ProcessCapture:
            {
                parameters = [
                    StringParameter,
                    StringListParameter,
                    StringListParameter,
                    StringListParameter,
                    StringListParameter,
                    IntParameter,
                ],
                success = StringListPayload,
                error = IntPayload,
            }
        FsReadText | ProcessFindProgram:
            { parameters = [StringParameter], success = StringPayload, error = IntPayload }
        FsWriteText:
            {
                parameters = [StringParameter, StringParameter],
                success = VoidPayload,
                error = IntPayload,
            }
        FsEntryKind:
            { parameters = [StringParameter], success = IntPayload, error = IntPayload }
        FsListDirectory:
            { parameters = [StringParameter], success = StringListPayload, error = IntPayload }
        FsCreateDirectory | FsCreateDirectories | FsRemoveFile | FsRemoveDirectory | FsRemoveDirectoryTree | ProcessFault:
            { parameters = [StringParameter], success = VoidPayload, error = IntPayload }
        FsRename:
            {
                parameters = [StringParameter, StringParameter],
                success = VoidPayload,
                error = IntPayload,
            }
        FsCreateTemporaryDirectory:
            {
                parameters = [StringParameter, StringParameter],
                success = StringPayload,
                error = IntPayload,
            }
        FsOpenRead:
            { parameters = [StringParameter], success = IntPayload, error = IntPayload }
        FsNextLines:
            {
                parameters = [IntParameter, StringParameter],
                success = StringListPayload,
                error = IntPayload,
            }
        FsClose:
            { parameters = [IntParameter], success = VoidPayload, error = IntPayload }


private pure func parameter_runtime_type[Element](
    parameter: SystemParameter,
) -> RuntimeType[Element]:
    match parameter:
        IntParameter: PrimitiveRuntimeType(BuiltinInt)
        StringParameter: PrimitiveRuntimeType(BuiltinString)
        StringListParameter: StringListRuntimeType


private pure func payload_runtime_type[Element](payload: SystemPayload) -> RuntimeType[Element]:
    match payload:
        IntPayload: PrimitiveRuntimeType(BuiltinInt)
        StringPayload: PrimitiveRuntimeType(BuiltinString)
        StringListPayload: StringListRuntimeType
        VoidPayload: PrimitiveRuntimeType(BuiltinVoid)


-- Whether a runtime operation may reuse operand 0's buffer in place when it
-- receives that operand's obligation. The one authority for in-place updates.
pure func reuses_first_operand[Variant, Element](
    operation: RuntimeOperation[Variant, Element],
) -> Bool:
    match operation:
        StringConcat | StringAppendInt | ListAppend(_) | ListSet(_) | ListConcat(_): True
        _: False


pure func primitive_operation[Variant, Element](
    parsed: ParsedRuntimeOperation,
) -> Option[RuntimeOperation[Variant, Element]]:
    match parsed:
        IntegerAddBuiltin:
            Some(IntegerAdd(Int64Format))
        IntegerSubtractBuiltin:
            Some(IntegerSubtract(Int64Format))
        IntegerMultiplyBuiltin:
            Some(IntegerMultiply(Int64Format))
        IntegerDivideBuiltin:
            Some(IntegerDivide(Int64Format))
        IntegerRemainderBuiltin:
            Some(IntegerRemainder(Int64Format))
        FloatAddBuiltin:
            Some(FloatAdd)
        FloatSubtractBuiltin:
            Some(FloatSubtract)
        FloatMultiplyBuiltin:
            Some(FloatMultiply)
        FloatDivideBuiltin:
            Some(FloatDivide)
        FloatRemainderBuiltin:
            Some(FloatRemainder)
        FloatToStringBuiltin:
            Some(FloatToString)
        FloatCopySignBuiltin:
            Some(FloatCopySign)
        FloatEqualsBuiltin | FloatLessThanBuiltin:
            None
        IntegerToStringBuiltin:
            Some(IntegerToString(Int64Format))
        StringLengthBuiltin:
            Some(StringLength)
        StringConcatBuiltin:
            Some(StringConcat)
        StringAppendIntBuiltin:
            Some(StringAppendInt)
        StringPrintBuiltin:
            Some(StringPrint)
        StringPrintErrorBuiltin:
            Some(StringPrintError)
        ListRepeatBuiltin | ListLengthBuiltin | ListAppendBuiltin | ListSetBuiltin | ListConcatBuiltin | StringParseIntBuiltin | StringParseFloatBuiltin | StringByteAtBuiltin | StringFromCodepointBuiltin | StringSliceBuiltin | SystemBuiltin(_) | ListGetBuiltin | StringEqualsBuiltin | IntegerEqualsBuiltin | IntegerLessThanBuiltin:
            None


pure func runtime_declaration_help(operation: ParsedRuntimeOperation) -> String:
    match operation:
        StringPrintBuiltin | StringPrintErrorBuiltin:
            "declare an impure function with one String parameter returning Void"
        IntegerAddBuiltin | IntegerSubtractBuiltin | IntegerMultiplyBuiltin | IntegerDivideBuiltin | IntegerRemainderBuiltin:
            "declare a pure function with two Int parameters returning Int"
        FloatAddBuiltin | FloatSubtractBuiltin | FloatMultiplyBuiltin | FloatDivideBuiltin | FloatRemainderBuiltin:
            "declare a pure function with two Float parameters returning Float"
        FloatCopySignBuiltin:
            "declare a pure nongeneric function with two Float parameters returning Float"
        FloatToStringBuiltin:
            "declare a pure function with one Float parameter returning String"
        IntegerToStringBuiltin:
            "declare a pure function with one Int parameter returning String"
        StringLengthBuiltin:
            "declare a pure function with one String parameter returning Int"
        StringConcatBuiltin:
            "declare a pure nongeneric function with two String parameters returning String"
        StringAppendIntBuiltin:
            "declare a pure nongeneric function with String and Int parameters returning String"
        StringParseIntBuiltin:
            "declare a pure nongeneric function with one String parameter returning Option[Int]"
        StringParseFloatBuiltin:
            "declare a pure nongeneric function with one String parameter returning Option[Float]"
        StringByteAtBuiltin:
            "declare a pure nongeneric function with String and Int parameters returning Option[Int]"
        StringFromCodepointBuiltin:
            "declare a pure nongeneric function with one Int parameter returning Option[String]"
        StringSliceBuiltin:
            "declare a pure nongeneric function with String, Int and Int parameters returning Option[String]"
        SystemBuiltin(system):
            system.system_declaration_help()
        ListRepeatBuiltin:
            "declare a pure function with E and Int parameters returning List[E]"
        ListLengthBuiltin:
            "declare a pure function with one List[E] parameter returning Int"
        ListGetBuiltin:
            "declare a pure function with List[E] and Int parameters returning Option[E]"
        ListAppendBuiltin:
            "declare a pure function with List[E] and E parameters returning List[E]"
        ListSetBuiltin:
            "declare a pure function with List[E], Int and E parameters returning List[E]"
        ListConcatBuiltin:
            "declare a pure function with two List[E] parameters returning List[E]"
        IntegerEqualsBuiltin | IntegerLessThanBuiltin:
            "declare a pure nongeneric function with two Int parameters returning Bool"
        FloatEqualsBuiltin | FloatLessThanBuiltin:
            "declare a pure nongeneric function with two Float parameters returning Bool"
        StringEqualsBuiltin:
            "declare a pure nongeneric function with two String parameters returning Bool"


private pure func parameter_spelling(parameter: SystemParameter) -> String:
    match parameter:
        IntParameter: "Int"
        StringParameter: "String"
        StringListParameter: "List[String]"


private pure func payload_spelling(payload: SystemPayload) -> String:
    match payload:
        IntPayload: "Int"
        StringPayload: "String"
        StringListPayload: "List[String]"
        VoidPayload: "Void"


-- Rendered from the signature row, so the help cannot disagree with it.
private pure func system_declaration_help(operation: SystemOperation) -> String:
    signature = operation.system_signature()
    spelled = signature.parameters.map(
        pure func(parameter: SystemParameter) -> String: parameter.parameter_spelling(),
    )
    parameters = match spelled:
        []:
            "no parameters"
        [only]:
            "one ${only} parameter"
        [first, second]:
            if first == second:
                "two ${first} parameters"
            else:
                "${first} and ${second} parameters"
        _:
            "${spelled.join(", ")} parameters"
    "declare an impure nongeneric function with ${parameters} returning Result[${signature.success.payload_spelling()}, ${signature.error.payload_spelling()}]"


union BuiltinTypeRole:
    IntRole
    FloatRole
    StringRole
    VoidRole
    ListRole


union DesignatedUnionRole:
    BoolUnion
    OptionUnion
    ResultUnion


union BuiltinTypeErrorKind:
    DuplicateBuiltinType(BuiltinTypeRole)
    MissingBuiltinType(BuiltinTypeRole)
    MissingDesignatedUnion(DesignatedUnionRole)
    MalformedDesignatedUnion(DesignatedUnionRole)
    BuiltinOutsideFoundation
    FoundationImports
    FoundationFunctions


record BuiltinTypeError {
    span: Span,
    kind: BuiltinTypeErrorKind,
}


private pure func builtin_type_error(span: Span, kind: BuiltinTypeErrorKind) -> BuiltinTypeError:
    { span = span, kind = kind }


pure func builtin_type_name(declaration: ParsedBuiltinType) -> WrittenName:
    match declaration:
        IntegerBuiltin(name): name
        FloatBuiltin(name): name
        StringBuiltin(name): name
        VoidBuiltin(name): name
        ListBuiltin(name, _): name


private pure func builtin_type_role(declaration: ParsedBuiltinType) -> BuiltinTypeRole:
    match declaration:
        IntegerBuiltin(_): IntRole
        FloatBuiltin(_): FloatRole
        StringBuiltin(_): StringRole
        VoidBuiltin(_): VoidRole
        ListBuiltin(_, _): ListRole


private pure func reject_at(
    found: Option[Span],
    kind: BuiltinTypeErrorKind,
) -> Result[Void, BuiltinTypeError]:
    match found:
        Some(span): Err(builtin_type_error(span, kind))
        None: Ok(void)


-- Only a default owned by an actual trait declaration is a foundation body.
private pure func foundation_default(row: FunctionRow, parsed: ParsedContents) -> Bool:
    match row.role:
        TraitDefaultBody:
            var owned: Bool = False
            for declaration in parsed.declarations.inventory_traits():
                if declaration.module == parsed.foundation.types:
                    for method in declaration.methods:
                        match method.declaration:
                            DefaultMethod(function):
                                if function == row.id:
                                    owned = True
                            _:
                                void
            owned
        _:
            False


-- The foundation types module only declares types.
private pure func check_foundation_shape(parsed: ParsedContents) -> Result[Void, BuiltinTypeError]:
    var function_span: Option[Span] = None
    for row in parsed.declarations.inventory_functions():
        function = row.declaration
        if (
            function_span
                .is_none()
                .and(function.module == parsed.foundation.types)
        ):
            if (
                row
                    .foundation_default(parsed)
                    .not()
            ):
                function_span = Some(function.function_name.span)
    functionless ?= reject_at(function_span, FoundationFunctions)
    var import_span: Option[Span] = None
    for row in parsed.modules:
        if row.module == parsed.foundation.types:
            match row.imports.get(0):
                Some(request): import_span = Some(request.span)
                None: void
    reject_at(import_span, FoundationImports)


-- Each builtin declaration must be in the foundation module and the first of its role.
private pure func accept_builtins(
    parsed: ParsedContents,
    accepted: List[ParsedBuiltinDeclaration],
) -> Result[List[ParsedBuiltinDeclaration], BuiltinTypeError]:
    match parsed.builtin_types.get(accepted.length()):
        None:
            Ok(accepted)
        Some(row):
            role = row.declaration.builtin_type_role()
            span = row.declaration.builtin_type_name().span
            var repeated: Bool = False
            for earlier in accepted:
                repeated = repeated.or(earlier.declaration.builtin_type_role() == role)
            if row.module != parsed.foundation.types:
                Err(builtin_type_error(span, BuiltinOutsideFoundation))
            else if repeated:
                Err(builtin_type_error(span, DuplicateBuiltinType(role)))
            else:
                parsed.accept_builtins(accepted.append(row))


-- Accepted declarations name each role at most once; a missing one ends the foundation module.
private pure func builtin_head(
    accepted: List[ParsedBuiltinDeclaration],
    role: BuiltinTypeRole,
    end: Span,
) -> Result[NameId, BuiltinTypeError]:
    var head: Option[NameId] = None
    for row in accepted:
        if row.declaration.builtin_type_role() == role:
            head = Some(row.declaration.builtin_type_name().id)
    match head:
        Some(present): Ok(present)
        None: Err(builtin_type_error(end, MissingBuiltinType(role)))


-- One constructor of a designated union: its wired-in name, and the position of
-- the union's type parameter it carries, or None when it has no payload.
private record ConstructorShape {
    name: NameId,
    payload: Option[Int],
}


-- `fixed` says the union must be declared `fixed union`: Bool promises inline
-- storage, and the generic Option and Result cannot be fixed.
private record UnionShape {
    name: NameId,
    parameters: Int,
    first: ConstructorShape,
    second: ConstructorShape,
    fixed: Bool,
}


private pure func designated_shape(role: DesignatedUnionRole, words: FoundationWords) -> UnionShape:
    match role:
        BoolUnion:
            {
                name = words.bool_word,
                parameters = 0,
                first = { name = words.true_word, payload = None },
                second = { name = words.false_word, payload = None },
                fixed = True,
            }
        OptionUnion:
            {
                name = words.option_word,
                parameters = 1,
                first = { name = words.some_word, payload = Some(0) },
                second = { name = words.none_word, payload = None },
                fixed = False,
            }
        ResultUnion:
            {
                name = words.result_word,
                parameters = 2,
                first = { name = words.ok_word, payload = Some(0) },
                second = { name = words.err_word, payload = Some(1) },
                fixed = False,
            }


-- A payload matches when it is exactly the union's own parameter at that position.
-- Comparing the written name is sound: _base imports nothing, so no imported
-- type can share the parameter's name, and declaration checking rejects a
-- parameter named like any visible type, so a match always denotes the parameter.
private pure func carries(row: UnionRow, fields: List[TypeSyntax], payload: Option[Int]) -> Bool:
    match payload:
        None:
            fields.is_empty()
        Some(position):
            match fields:
                [AtomicType(written)]:
                    match row.type_parameters.get(position):
                        Some(parameter): written.id == parameter.name.id
                        None: False
                _:
                    False


private pure func shaped_variant(row: UnionRow, shape: ConstructorShape) -> Option[VariantId]:
    var found: Option[VariantId] = None
    for variant in row.variants:
        if (variant.declaration.name.id == shape.name).and(
            row.carries(variant.declaration.fields, shape.payload),
        ):
            found = Some(variant.id)
            break
    found


-- The designated union's two constructors, in its shape's order. The union's
-- variant order is its own: layout follows declaration order as for any union.
private fixed record DesignatedPair {
    first: VariantId,
    second: VariantId,
}


private pure func designated_pair(
    parsed: ParsedContents,
    role: DesignatedUnionRole,
    end: Span,
) -> Result[DesignatedPair, BuiltinTypeError]:
    shape = role.designated_shape(parsed.names.foundation_words())
    var declaration: Option[UnionRow] = None
    for row in parsed.declarations.inventory_unions():
        if (
            declaration
                .is_none()
                .and(row.module == parsed.foundation.types)
                .and(row.type_name.id == shape.name)
        ):
            declaration = Some(row)
    row: UnionRow ?= match declaration:
        None: Err(builtin_type_error(end, MissingDesignatedUnion(role)))
        Some(found): Ok(found)
    has_designated_shape = (row.type_parameters.length() == shape.parameters)
        .and(row.variants.length() == 2)
        .and(row.fixed == shape.fixed)
    match (row.shaped_variant(shape.first), row.shaped_variant(shape.second), has_designated_shape):
        (Some(first), Some(second), True): Ok({ first = first, second = second })
        _: Err(builtin_type_error(row.type_name.span, MalformedDesignatedUnion(role)))


-- Bool, Option and Result are source unions; designating them is an identity
-- fact only, decided here once from the foundation module by wired-in name.
-- A same-named union elsewhere is an ordinary declaration.
private pure func designate_unions(
    parsed: ParsedContents,
    end: Span,
) -> Result[DesignatedUnions, BuiltinTypeError]:
    boolean ?= parsed.designated_pair(BoolUnion, end)
    option ?= parsed.designated_pair(OptionUnion, end)
    result ?= parsed.designated_pair(ResultUnion, end)
    Ok({
        boolean = { true_variant = boolean.first, false_variant = boolean.second },
        option = { some = option.first, none = option.second },
        result = { ok = result.first, err = result.second },
    })


-- The accepted foundation, published once for this compilation: the primitive
-- heads' names and the designated unions. Its ids are this compilation's.
record CheckedFoundation {
    initial: InitialNames,
    designated: DesignatedUnions,
}


-- Primitive names are checked once from the sealed designated source inventory.
-- Ordinary unions remain nominal declarations owned by the normal namespace.
-- There is no invalid-name error: the parser assigns each builtin's role from its
-- spelling and append_module rejects a foreign name table, so every name id here
-- has a spelling and the five role names and the entrypoint are distinct.
pure func check_builtin_types(
    program: ParsedProgram,
) -> Result[CheckedFoundation, BuiltinTypeError]:
    parsed = program.parsed_contents()
    -- A missing builtin declaration is reported at the end of the foundation types module.
    var end = parsed.end
    for row in parsed.modules:
        if row.module == parsed.foundation.types:
            end = row.end
    shaped ?= parsed.check_foundation_shape()
    accepted ?= parsed.accept_builtins([])
    integer_id ?= accepted.builtin_head(IntRole, end)
    string_id ?= accepted.builtin_head(StringRole, end)
    unit_id ?= accepted.builtin_head(VoidRole, end)
    float_id ?= accepted.builtin_head(FloatRole, end)
    list_id ?= accepted.builtin_head(ListRole, end)
    designated ?= parsed.designate_unions(end)
    initial: InitialNames = {
        names = parsed.names,
        special = {
            main = parsed.entrypoint,
            integer = integer_id,
            float = float_id,
            string = string_id,
            unit = unit_id,
            list = list_id,
        },
    }
    Ok({ initial = initial, designated = designated })


pure func integer_spelling(format: IntegerFormat) -> String:
    match format:
        Int64Format: IntRole.builtin_type_spelling()


private pure func builtin_type_spelling(role: BuiltinTypeRole) -> String:
    match role:
        IntRole: "Int"
        FloatRole: "Float"
        StringRole: "String"
        VoidRole: "Void"
        ListRole: "List"


private pure func builtin_type_declaration(role: BuiltinTypeRole) -> String:
    match role:
        ListRole: "type List[T] = builtin"
        _: "type ${role.builtin_type_spelling()} = builtin"


private pure func designated_union_spelling(role: DesignatedUnionRole) -> String:
    match role:
        BoolUnion: "Bool"
        OptionUnion: "Option"
        ResultUnion: "Result"


private pure func designated_union_declaration(role: DesignatedUnionRole) -> String:
    match role:
        BoolUnion: "fixed union Bool with exactly the variants True and False"
        OptionUnion: "union Option[A] with exactly the variants Some(A) and None"
        ResultUnion: "union Result[Value, Error] with exactly the variants Ok(Value) and Err(Error)"


pure func render_builtin_type_error(error: BuiltinTypeError) -> Diagnostic:
    message = match error.kind:
        DuplicateBuiltinType(_):
            "duplicate builtin type declaration"
        MissingBuiltinType(role):
            "missing ${role.builtin_type_spelling()} builtin declaration"
        MissingDesignatedUnion(role):
            "missing ${role.designated_union_spelling()} union declaration"
        MalformedDesignatedUnion(role):
            "foundation union ${role.designated_union_spelling()} does not have its designated shape"
        BuiltinOutsideFoundation:
            "builtin type declarations belong in the configured foundation module"
        FoundationImports:
            "foundation types cannot import modules"
        FoundationFunctions:
            "foundation types cannot declare functions"
    help = match error.kind:
        DuplicateBuiltinType(role):
            "declare ${role.builtin_type_declaration()} exactly once"
        MissingBuiltinType(role):
            "add ${role.builtin_type_declaration()} to _base.brp"
        MissingDesignatedUnion(role):
            "add ${role.designated_union_declaration()} to _base.brp"
        MalformedDesignatedUnion(role):
            "declare it as ${role.designated_union_declaration()}"
        BuiltinOutsideFoundation:
            "remove this declaration; builtin types are supplied by _base.brp under --library-root"
        FoundationImports:
            "keep _base.brp independent; put operation imports in prelude.brp"
        FoundationFunctions:
            "move functions to a library operation module and select its methods in prelude.brp"
    { span = error.span, note = None, message = message, help = help, kind = ProgramProblem }
