            FloatCopySignBuiltin,
            FloatEqualsBuiltin,
            FloatLessThanBuiltin,
            IntegerAddBuiltin,
            IntegerSubtractBuiltin,
            IntegerMultiplyBuiltin,
            IntegerDivideBuiltin,
            IntegerRemainderBuiltin,
            IntegerToStringBuiltin,
            StringLengthBuiltin,
            StringConcatBuiltin,
            StringAppendIntBuiltin,
            FloatAddBuiltin,
            FloatSubtractBuiltin,
            FloatMultiplyBuiltin,
            FloatDivideBuiltin,
            FloatRemainderBuiltin,
            FloatToStringBuiltin,
            StringParseFloatBuiltin,
            StringPrintBuiltin,
            StringPrintErrorBuiltin,
            StringParseIntBuiltin,
            ListRepeatBuiltin,
            ListLengthBuiltin,
            ListGetBuiltin,
            StringByteAtBuiltin,
            StringFromCodepointBuiltin,
            StringSliceBuiltin,
            SystemBuiltin,
            ListAppendBuiltin,
            ListSetBuiltin,
            ListConcatBuiltin,
