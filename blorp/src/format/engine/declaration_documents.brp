import:
	./document_layout:
		Doc(Hardline, Softline, SoftlineSpace),
		blank_lines,
		comma_fill,
		comma_sep,
		comma_sep_break,
		hardlines,
		layout,
		layout_default,
		line_suffix,
		text,
	./expression_documents:
		Expression,
		FunctionParameter,
		MemberComments,
		Pattern,
		assignment_value_document,
		block_body_document,
		commented_member_document,
		escape_string_value,
		expression_from_json,
		function_parameter_array_field,
		function_parameters_document,
		member_comments_field,
		optional_expression_field,
		pattern_from_json,
	./json_fields:
		bool_field,
		field,
		int_field,
		optional_int_field,
		parsed_array_field,
		string_array_field,
		string_field,
	./type_documents:
		TypeConstraint,
		TypeExpression,
		optional_type_expression_field,
		return_type_document,
		string_documents,
		type_constraint_array_field_or_empty,
		type_document_list,
		type_expression_array_field,
		type_expression_field,
		type_params_document,
		where_constraints_document,
	json: JsonValue, parse_json


record ImportSymbol {
	name: String,
	alias_name: Option[String],
	ctors: Option[List[String]]
}


record ImportItem {
	module_name: String,
	alias_name: Option[String],
	symbols: Option[List[ImportSymbol]]
}


--- A union or enum variant with the comments written above and on its line.
record TypeVariant {
	name: String,
	fields: List[TypeExpression],
	comments: MemberComments
}


--- A record or struct field with the comments written above and on its line.
record DeclarationField {
	name: String,
	field_type: TypeExpression,
	comments: MemberComments
}


record TraitMethod {
	name: String,
	is_pure: Bool,
	params: List[FunctionParameter],
	return_type: Option[TypeExpression],
	body: Option[Expression]
}


record ForeignLinkFlag {
	platform: Option[String],
	value: String
}


---
The `foreign:` block a foreign function was written in. `header_line` is the
source line of the block's header: it identifies the block, so adjacent blocks
with the same arguments stay separate, and it divides the comments written
above the header from those written inside the block.
---
record ForeignMetadata {
	header_line: Int,
	includes: List[String],
	link_flags: List[ForeignLinkFlag]
}


union FunctionBody:
	ExpressionFunctionBody(Expression)
	BuiltinFunctionBody(Option[String])
	ForeignFunctionBody(String, ForeignMetadata)
	NoFunctionBody


record ImplementationMethod {
	name: String,
	is_pure: Bool,
	is_tailrec: Bool,
	is_debug_only: Bool,
	no_copy: Bool,
	resource_result_ordinary: Bool,
	type_params: List[String],
	params: List[FunctionParameter],
	return_type: Option[TypeExpression],
	where_constraints: List[TypeConstraint],
	body: FunctionBody
}


record DoctestGroup {
	description: String,
	imports: List[String],
	body: Option[Expression],
	raw_body: List[String]
}


union DeclarationDoc:
	PlainDeclarationDoc(String)
	DoctestDeclarationDoc(List[String], List[DoctestGroup])


union Declaration:
	DocumentedDeclaration(DeclarationDoc, Declaration)
	ImportDeclaration(ImportItem)
	VariableDeclaration(Bool, Option[String], Option[Pattern], Bool, Option[TypeExpression], Expression)
	FunctionDeclaration(Bool, String, Bool, Bool, Bool, Bool, Bool, List[String], List[FunctionParameter], Option[TypeExpression], List[TypeConstraint], FunctionBody)
	TypeDeclaration(Bool, String, List[String], Bool, Bool, Bool, Option[String], List[TypeVariant], List[String])
	RecordDeclaration(Bool, String, List[String], RecordSpelling, Bool, List[DeclarationField], List[String])
	TypeAliasDeclaration(Bool, Bool, String, List[String], TypeExpression)
	TraitDeclaration(Bool, String, List[String], List[String], List[TraitMethod])
	ImplementationDeclaration(Bool, String, TypeExpression, List[ImplementationMethod])


enum RecordSpelling:
	OrdinaryRecordSpelling
	StructSpelling
	FixedRecordSpelling


record FormatterComment {
	text_value: String,
	line: Int,
	column: Int,
	trailing: Bool
}


record LocatedDeclaration {
	line: Int,
	column: Int,
	end_line: Int,
	declaration: Declaration
}


---
The module docstring rendered above the leading import block. It is not a
declaration's doc, so it lives on the program; `line` is where its opening
`---` sits, which separates comments written above it from comments between
it and the imports.
---
record ModuleDoc {
	text_value: String,
	line: Int
}


record Program {
	module_doc: Option[ModuleDoc],
	declarations: List[LocatedDeclaration],
	comments: List[FormatterComment]
}


record LocatedImport {
	line: Int,
	column: Int,
	item: ImportItem
}


union ProgramBodyItem:
	BodyDeclaration(LocatedDeclaration)
	BodyImportBlock(List[LocatedImport])
	BodyForeignBlock(ForeignMetadata, List[LocatedDeclaration])


---
The functions of one source `foreign:` block, gathered in order while the
program's declarations are grouped into body items.
---
record ForeignBlockGroup {
	metadata: ForeignMetadata,
	functions: List[LocatedDeclaration]
}


record ProgramParts {
	imports: List[LocatedImport],
	body: List[LocatedDeclaration]
}


record ImportWithComments {
	item: ImportItem,
	leading: List[FormatterComment],
	trailing: Option[FormatterComment]
}


record ImportCommentCollect {
	items: List[ImportWithComments],
	remaining_comments: List[FormatterComment]
}


record RenderedImportBlock {
	document: Doc,
	remaining_comments: List[FormatterComment]
}


record CommentTake {
	taken: List[FormatterComment],
	remaining: List[FormatterComment]
}


record TrailingCommentTake {
	comment: Option[FormatterComment],
	remaining: List[FormatterComment]
}


record RenderedDocument {
	document: Doc,
	remaining_comments: List[FormatterComment]
}


private pure func optional_string_field(
	value: JsonValue,
	key: String,
) -> Result[Option[String], String]:
	match value.get_field(key):
		None:
			Ok(None)
		Some(child):
			match child.as_string():
				Some(s):
					Ok(Some(s))
				None:
					Err("expected formatter JSON field '" + key + "' to be a string")


private pure func optional_string_array_field(
	value: JsonValue,
	key: String,
) -> Result[Option[List[String]], String]:
	match value.get_field(key):
		None:
			Ok(None)
		Some(_):
			items ?= value.string_array_field(key)
			Ok(Some(items))


private pure func optional_bool_field(
	value: JsonValue,
	key: String,
) -> Result[Option[Bool], String]:
	match value.get_field(key):
		None:
			Ok(None)
		Some(_):
			bool_value ?= value.bool_field(key)
			Ok(Some(bool_value))


private pure func optional_pattern_field(
	value: JsonValue,
	key: String,
) -> Result[Option[Pattern], String]:
	match value.get_field(key):
		None:
			Ok(None)
		Some(child):
			pattern ?= child.pattern_from_json()
			Ok(Some(pattern))


private pure func expression_field(value: JsonValue, key: String) -> Result[Expression, String]:
	child ?= value.field(key)
	child.expression_from_json()


private pure func import_symbol_from_json(value: JsonValue) -> Result[ImportSymbol, String]:
	name ?= value.string_field("name")
	alias_name ?= value.optional_string_field("alias")
	ctors ?= value.optional_string_array_field("ctors")
	Ok({
		name = name,
		alias_name = alias_name,
		ctors = ctors,
	})


private pure func import_symbols_field(
	value: JsonValue,
	key: String,
) -> Result[Option[List[ImportSymbol]], String]:
	match value.get_field(key):
		None:
			Ok(None)
		Some(_):
			symbols ?= value.parsed_array_field(key, import_symbol_from_json)
			Ok(Some(symbols))


private pure func import_item_from_json(value: JsonValue) -> Result[ImportItem, String]:
	module_name ?= value.string_field("module")
	alias_name ?= value.optional_string_field("alias")
	symbols ?= value.import_symbols_field("symbols")
	Ok({
		module_name = module_name,
		alias_name = alias_name,
		symbols = symbols,
	})


private pure func formatter_comment_from_json(value: JsonValue) -> Result[FormatterComment, String]:
	text_value ?= value.string_field("text")
	line ?= value.int_field("line")
	column ?= value.int_field("column")
	trailing ?= value.bool_field("trailing")
	Ok({
		text_value = text_value,
		line = line,
		column = column,
		trailing = trailing,
	})


private pure func formatter_comments_field(
	value: JsonValue,
	key: String,
) -> Result[List[FormatterComment], String]:
	match value.get_field(key):
		None:
			Ok([])
		Some(_):
			value.parsed_array_field(key, formatter_comment_from_json)


private pure func string_array_field_or_empty(
	value: JsonValue,
	key: String,
) -> Result[List[String], String]:
	match value.get_field(key):
		None:
			Ok([])
		Some(_):
			value.string_array_field(key)


private pure func foreign_link_flag_from_json(value: JsonValue) -> Result[ForeignLinkFlag, String]:
	platform ?= value.optional_string_field("platform")
	flag_value ?= value.string_field("value")
	Ok({
		platform = platform,
		value = flag_value,
	})


private pure func foreign_link_flags_field(
	value: JsonValue,
	key: String,
) -> Result[List[ForeignLinkFlag], String]:
	match value.get_field(key):
		None:
			Ok([])
		Some(_):
			value.parsed_array_field(key, foreign_link_flag_from_json)


private pure func type_variant_from_json(value: JsonValue) -> Result[TypeVariant, String]:
	name ?= value.string_field("name")
	fields ?= value.type_expression_array_field("fields")
	comments ?= value.member_comments_field("comments")
	Ok({
		name = name,
		fields = fields,
		comments = comments,
	})


private pure func type_variant_array_field(
	value: JsonValue,
	key: String,
) -> Result[List[TypeVariant], String]:
	value.parsed_array_field(key, type_variant_from_json)


private pure func declaration_field_from_json(value: JsonValue) -> Result[DeclarationField, String]:
	name ?= value.string_field("name")
	field_type ?= value.type_expression_field("type")
	comments ?= value.member_comments_field("comments")
	Ok({
		name = name,
		field_type = field_type,
		comments = comments,
	})


private pure func declaration_field_array_field(
	value: JsonValue,
	key: String,
) -> Result[List[DeclarationField], String]:
	value.parsed_array_field(key, declaration_field_from_json)


private pure func trait_method_from_json(value: JsonValue) -> Result[TraitMethod, String]:
	name ?= value.string_field("name")
	is_pure ?= value.bool_field("pure")
	params ?= value.function_parameter_array_field("params")
	return_type ?= value.optional_type_expression_field("return")
	body ?= value.optional_expression_field("body")
	Ok({
		name = name,
		is_pure = is_pure,
		params = params,
		return_type = return_type,
		body = body,
	})


private pure func trait_method_array_field(
	value: JsonValue,
	key: String,
) -> Result[List[TraitMethod], String]:
	value.parsed_array_field(key, trait_method_from_json)


private pure func implementation_method_from_json(
	value: JsonValue,
) -> Result[ImplementationMethod, String]:
	name ?= value.string_field("name")
	is_pure ?= value.bool_field("pure")
	is_tailrec ?= value.bool_field("tailrec")
	is_debug_only ?= value.bool_field("debug_only")
	no_copy ?= value.bool_field("no_copy")
	resource_result_ordinary ?= value.bool_field("resource_result_ordinary")
	type_params ?= value.string_array_field("type_params")
	params ?= value.function_parameter_array_field("params")
	return_type ?= value.optional_type_expression_field("return")
	where_constraints ?= value.type_constraint_array_field_or_empty("where")
	body ?= value.function_body_from_json()
	Ok({
		name = name,
		is_pure = is_pure,
		is_tailrec = is_tailrec,
		is_debug_only = is_debug_only,
		no_copy = no_copy,
		resource_result_ordinary = resource_result_ordinary,
		type_params = type_params,
		params = params,
		return_type = return_type,
		where_constraints = where_constraints,
		body = body,
	})


private pure func implementation_method_array_field(
	value: JsonValue,
	key: String,
) -> Result[List[ImplementationMethod], String]:
	value.parsed_array_field(key, implementation_method_from_json)


private pure func function_body_from_json(value: JsonValue) -> Result[FunctionBody, String]:
	match value.get_field("body"):
		Some(child):
			body ?= child.expression_from_json()
			Ok(ExpressionFunctionBody(body))
		None:
			kind ?= value.string_field("body_kind")

			match kind:
				"builtin":
					name ?= value.optional_string_field("builtin_name")
					Ok(BuiltinFunctionBody(name))
				"foreign":
					foreign_name ?= value.string_field("foreign_name")
					header_line ?= value.int_field("foreign_header_line")
					includes ?= value.string_array_field_or_empty("foreign_includes")
					link_flags ?= value.foreign_link_flags_field("foreign_link_flags")
					Ok(
						ForeignFunctionBody(
							foreign_name,
							{
								header_line = header_line,
								includes = includes,
								link_flags = link_flags
							},
						),
					)
				"none":
					Ok(NoFunctionBody)
				_:
					Err("unknown function body JSON kind: " + kind)


private pure func doctest_group_from_json(value: JsonValue) -> Result[DoctestGroup, String]:
	description ?= value.string_field("description")
	imports ?= value.string_array_field_or_empty("imports")
	body ?= value.optional_expression_field("body")
	raw_body ?= value.string_array_field_or_empty("raw_body")
	Ok({
		description = description,
		imports = imports,
		body = body,
		raw_body = raw_body,
	})


private pure func doctest_group_array_field(
	value: JsonValue,
	key: String,
) -> Result[List[DoctestGroup], String]:
	value.parsed_array_field(key, doctest_group_from_json)


private pure func declaration_doc_from_json(value: JsonValue) -> Result[DeclarationDoc, String]:
	tag ?= value.string_field("tag")

	match tag:
		"Plain":
			text_value ?= value.string_field("text")
			Ok(PlainDeclarationDoc(text_value))
		"Doctests":
			prefix ?= value.string_array_field("prefix")
			groups ?= value.doctest_group_array_field("groups")
			Ok(DoctestDeclarationDoc(prefix, groups))
		_:
			Err("unknown declaration doc JSON tag: " + tag)


pure func declaration_from_json(value: JsonValue) -> Result[Declaration, String]:
	tag ?= value.string_field("tag")

	match tag:
		"Doc":
			doc_value ?= value.field("doc")
			doc ?= doc_value.declaration_doc_from_json()
			decl_value ?= value.field("decl")
			decl ?= decl_value.declaration_from_json()
			Ok(DocumentedDeclaration(doc, decl))
		"Import":
			item ?= value.import_item_from_json()
			Ok(ImportDeclaration(item))
		"Var":
			is_private ?= value.bool_field("private")
			name ?= value.optional_string_field("name")
			pattern ?= value.optional_pattern_field("pattern")
			is_mutable ?= value.bool_field("mutable")
			type_expression ?= value.optional_type_expression_field("type")
			value_expr ?= value.expression_field("value")
			Ok(
				VariableDeclaration(
					is_private,
					name,
					pattern,
					is_mutable,
					type_expression,
					value_expr,
				),
			)
		"Func":
			is_private ?= value.bool_field("private")
			name ?= value.string_field("name")
			is_pure ?= value.bool_field("pure")
			is_tailrec ?= value.bool_field("tailrec")
			is_debug_only ?= value.bool_field("debug_only")
			no_copy ?= value.bool_field("no_copy")
			resource_result_ordinary ?= value.bool_field("resource_result_ordinary")
			type_params ?= value.string_array_field("type_params")
			params ?= value.function_parameter_array_field("params")
			return_type ?= value.optional_type_expression_field("return")
			where_constraints ?= value.type_constraint_array_field_or_empty("where")
			body ?= value.function_body_from_json()
			Ok(
				FunctionDeclaration(
					is_private,
					name,
					is_pure,
					is_tailrec,
					is_debug_only,
					no_copy,
					resource_result_ordinary,
					type_params,
					params,
					return_type,
					where_constraints,
					body,
				),
			)
		"Type":
			is_private ?= value.bool_field("private")
			name ?= value.string_field("name")
			type_params ?= value.string_array_field("type_params")
			is_enum ?= value.bool_field("enum")
			is_builtin ?= value.bool_field("builtin")
			is_resource ?= value.bool_field("resource")
			resource_cleanup ?= value.optional_string_field("resource_cleanup_builtin")
			variants ?= value.type_variant_array_field("variants")
			optional_closing_comments ?= value.optional_string_array_field("closing_comments")
			closing_comments: List[String] = optional_closing_comments.get_or([])
			Ok(
				TypeDeclaration(
					is_private,
					name,
					type_params,
					is_enum,
					is_builtin,
					is_resource,
					resource_cleanup,
					variants,
					closing_comments,
				),
			)
		"Record":
			is_private ?= value.bool_field("private")
			name ?= value.string_field("name")
			type_params ?= value.string_array_field("type_params")
			is_value ?= value.bool_field("value")
			written_form ?= value.optional_string_field("form")
			spelling: RecordSpelling ?= match written_form:
				Some("fixed record"):
					if is_value:
						Ok(FixedRecordSpelling)
					else:
						Err("fixed record form requires value=true")
				Some(other):
					Err("unknown record declaration form: " + other)
				None:
					Ok(if is_value:
						StructSpelling
					else:
						OrdinaryRecordSpelling
					)
			is_builtin ?= value.bool_field("builtin")
			fields ?= value.declaration_field_array_field("fields")
			optional_closing_comments ?= value.optional_string_array_field("closing_comments")
			closing_comments: List[String] = optional_closing_comments.get_or([])
			Ok(
				RecordDeclaration(
					is_private,
					name,
					type_params,
					spelling,
					is_builtin,
					fields,
					closing_comments,
				),
			)
		"TypeAlias":
			is_private ?= value.bool_field("private")
			opaque_flag ?= value.optional_bool_field("opaque")
			is_opaque: Bool = opaque_flag.get_or(False)
			name ?= value.string_field("name")
			type_params ?= value.string_array_field("type_params")
			target ?= value.type_expression_field("target")
			Ok(TypeAliasDeclaration(is_private, is_opaque, name, type_params, target))
		"Trait":
			is_private ?= value.bool_field("private")
			name ?= value.string_field("name")
			type_params ?= value.string_array_field("type_params")
			supertraits ?= value.string_array_field("supertraits")
			methods ?= value.trait_method_array_field("methods")
			Ok(TraitDeclaration(is_private, name, type_params, supertraits, methods))
		"Impl":
			is_private ?= value.bool_field("private")
			trait_name ?= value.string_field("trait")
			for_type ?= value.type_expression_field("for")
			methods ?= value.implementation_method_array_field("methods")
			Ok(ImplementationDeclaration(is_private, trait_name, for_type, methods))
		_:
			Err("unknown declaration JSON tag: " + tag)


pure func declaration_from_json_string(input: String) -> Result[Declaration, String]:
	value ?= input.parse_json()
	value.declaration_from_json()


private pure func import_symbol_document(symbol: ImportSymbol) -> Doc:
	match symbol.ctors:
		Some(ctors):
			symbol.name
				.text()
				.cat("(".text())
				.cat(
					Softline
						.cat(
							ctors
								.string_documents()
								.comma_fill(),
						)
						.indent(),
				)
				.cat(Softline)
				.cat(")".text())
				.group()
		None:
			match symbol.alias_name:
				Some(alias_value):
					symbol.name
						.text()
						.cat(" as ".text())
						.cat(alias_value.text())
				None:
					symbol.name.text()


private pure func import_symbol_documents(symbols: List[ImportSymbol]) -> List[Doc]:
	var documents: List[Doc] = []

	for symbol in symbols.sort_by(func(item: ImportSymbol): item.name):
		documents = documents.append(symbol.import_symbol_document())

	documents


private pure func import_item_document(item: ImportItem) -> Doc:
	match item.symbols:
		Some(symbols):
			prefix: Doc = match item.alias_name:
				Some(alias_value):
					item.module_name
						.text()
						.cat(" as ".text())
						.cat(alias_value.text())
						.cat(":".text())
				None:
					item.module_name
						.text()
						.cat(":".text())

			prefix
				.cat(
					SoftlineSpace
						.cat(
							symbols
								.import_symbol_documents()
								.comma_sep_break(),
						)
						.indent(),
				)
				.group()
		None:
			match item.alias_name:
				Some(alias_value):
					item.module_name
						.text()
						.cat(" as ".text())
						.cat(alias_value.text())
				None:
					item.module_name.text()


private pure func import_symbol_dedup_key(symbol: ImportSymbol) -> String:
	alias_key: String = match symbol.alias_name:
		Some(alias_value):
			" as " + alias_value
		None:
			""

	ctor_key: String = match symbol.ctors:
		Some(ctor_values):
			"(" + ctor_values.join(",") + ")"
		None:
			""

	symbol.name + ctor_key + alias_key


private pure func import_symbols_dedup_key(symbols: List[ImportSymbol]) -> String:
	var keys: List[String] = []

	for symbol in symbols.sort_by(func(item: ImportSymbol): item.name):
		keys = keys.append(symbol.import_symbol_dedup_key())

	keys.join(",")


private pure func import_item_dedup_key(item: ImportItem) -> String:
	value_key: String = match item.symbols:
		Some(symbols):
			symbols.import_symbols_dedup_key()
		None:
			match item.alias_name:
				Some(alias_value):
					"as:" + alias_value
				None:
					"*"

	item.module_name + ":" + value_key


private pure func import_declaration_document(item: ImportItem) -> Doc:
	"import:"
		.text()
		.cat(
			Hardline
				.cat(item.import_item_document())
				.indent(),
		)


private pure func private_document(is_private: Bool) -> Doc:
	if is_private:
		"private ".text()
	else:
		"".text()


private pure func drop_trailing_empty_lines(lines: List[String]) -> List[String]:
	match lines:
		[]:
			[]
		[line, ...rest]:
			tail: List[String] = rest.drop_trailing_empty_lines()

			if tail.length() == 0 and line == "":
				[]
			else:
				[line].concat(tail)


private pure func expand_doc_tabs(line: String) -> String:
	line.replace("\t", "    ")


private pure func doctest_body_lines(body: Expression) -> List[String]:
	var result: List[String] = []

	for line in (
		body
			.block_body_document()
			.layout_default()
			.split("\n")
			.drop_trailing_empty_lines()
	):
		result = result.append(line.expand_doc_tabs())

	result


private pure func doctest_group_code_lines(group: DoctestGroup) -> List[String]:
	if group.raw_body.length() > 0:
		group.raw_body
	else:
		body_lines: List[String] = match group.body:
			Some(body):
				body.doctest_body_lines()
			None:
				[]

		if group.imports.length() > 0 and body_lines.length() > 0:
			group.imports
				.append("")
				.concat(body_lines)
		else:
			group.imports.concat(body_lines)


private pure func doctest_group_doc_lines(group: DoctestGroup) -> List[String]:
	var result: List[String] = ["    :: " + group.description]

	for line in group.doctest_group_code_lines():
		if line == "":
			result = result.append("")
		else:
			result = result.append("    " + line)

	result


private pure func doctest_groups_doc_lines(groups: List[DoctestGroup]) -> List[String]:
	var result: List[String] = []
	var first: Bool = True

	for group in groups:
		if first:
			first = False
		else:
			result = result.append("")

		result = result.concat(group.doctest_group_doc_lines())

	result


private pure func declaration_doc_lines(doc: DeclarationDoc) -> List[String]:
	match doc:
		PlainDeclarationDoc(text_value):
			text_value.split("\n")
		DoctestDeclarationDoc(prefix, groups):
			prefix
				.append("doctests:")
				.concat(groups.doctest_groups_doc_lines())


private pure func docstring_document(doc: DeclarationDoc) -> Doc:
	var result: Doc = "---"
		.text()
		.cat(Hardline)

	for line in doc.declaration_doc_lines():
		result = result
			.cat(line.text())
			.cat(Hardline)

	result
		.cat("---".text())
		.cat(Hardline)


private pure func comment_document(comment: FormatterComment) -> Doc:
	comment.text_value.text()


private pure func comments_document(comments: List[FormatterComment]) -> Doc:
	var result: Doc = "".text()

	for comment in comments:
		result = result
			.cat(comment.comment_document())
			.cat(Hardline)

	result


private pure func copy_formatter_comments(
	comments: List[FormatterComment],
) -> List[FormatterComment]:
	comments.take(comments.length())


private pure func append_remaining_comments(document: Doc, comments: List[FormatterComment]) -> Doc:
	if comments.length() == 0:
		document
	else:
		document
			.cat(Hardline)
			.cat(comments.comments_document())


private pure func trailing_comment_document(comment: Option[FormatterComment]) -> Doc:
	match comment:
		Some(value):
			value.text_value.line_suffix()
		None:
			"".text()


private pure func take_leading_comments(
	comments: List[FormatterComment],
	before_line: Int,
) -> CommentTake:
	var taken: List[FormatterComment] = []
	var remaining: List[FormatterComment] = []
	var taking: Bool = True

	for comment in comments:
		if (
			taking
			and (comment.line < before_line or comment.line == before_line and not comment.trailing)
		):
			taken = taken.append(comment)
		else:
			taking = False
			remaining = remaining.append(comment)

	{
		taken = taken,
		remaining = remaining
	}


private pure func take_trailing_comment(
	comments: List[FormatterComment],
	on_line: Int,
) -> TrailingCommentTake:
	match comments:
		[]:
			{
				comment = None,
				remaining = []
			}
		[first, ...rest]:
			if first.line == on_line and first.trailing:
				{
					comment = Some(first),
					remaining = rest
				}
			else:
				{
					comment = None,
					remaining = comments
				}


private pure func drain_comments_through(
	comments: List[FormatterComment],
	through_line: Int,
) -> CommentTake:
	var taken: List[FormatterComment] = []
	var remaining: List[FormatterComment] = []
	var taking: Bool = True

	for comment in comments:
		if taking and comment.line <= through_line:
			taken = taken.append(comment)
		else:
			taking = False
			remaining = remaining.append(comment)

	{
		taken = taken,
		remaining = remaining
	}


private pure func drain_nested_comments_through(
	comments: List[FormatterComment],
	through_line: Int,
	parent_column: Int,
) -> CommentTake:
	var taken: List[FormatterComment] = []
	var remaining: List[FormatterComment] = []

	for comment in comments:
		if comment.line <= through_line and comment.column > parent_column:
			taken = taken.append(comment)
		else:
			remaining = remaining.append(comment)

	{
		taken = taken,
		remaining = remaining
	}


private pure func import_with_comments_dedup_key(item: ImportWithComments) -> String:
	item.item.import_item_dedup_key()


private pure func merge_duplicate_import_comments(
	existing: ImportWithComments,
	duplicate: ImportWithComments,
) -> ImportWithComments:
	var leading: List[FormatterComment] = existing.leading

	for comment in duplicate.leading:
		leading = leading.append(comment)

	match duplicate.trailing:
		Some(comment):
			leading = leading.append(comment)
		None:
			void

	{
		item = existing.item,
		leading = leading,
		trailing = existing.trailing
	}


private pure func append_or_merge_import_with_comments(
	items: List[ImportWithComments],
	item: ImportWithComments,
) -> List[ImportWithComments]:
	key: String = item.import_with_comments_dedup_key()
	var result: List[ImportWithComments] = []
	var merged: Bool = False

	for existing in items:
		if existing.import_with_comments_dedup_key() == key:
			result = result.append(existing.merge_duplicate_import_comments(item))
			merged = True
		else:
			result = result.append(existing)

	if merged:
		result
	else:
		result.append(item)


private pure func dedup_imports_with_comments(
	items: List[ImportWithComments],
) -> List[ImportWithComments]:
	var result: List[ImportWithComments] = []

	for item in items:
		result = result.append_or_merge_import_with_comments(item)

	result


private pure func sorted_imports_with_comments(
	items: List[ImportWithComments],
) -> List[ImportWithComments]:
	var result: List[ImportWithComments] = []

	for item in (
		items
			.dedup_imports_with_comments()
			.sort_by(
				func(
					import_item: ImportWithComments,
				): import_item.import_with_comments_dedup_key(),
			)
	):
		result = result.append(item)

	result


private pure func import_with_comments_document(item: ImportWithComments) -> Doc:
	leading_doc = item.leading.comments_document()
	item_doc = item.item.import_item_document()
	trailing_doc = item.trailing.trailing_comment_document()

	leading_doc
		.cat(item_doc)
		.cat(trailing_doc)


private pure func import_with_comments_documents(items: List[ImportWithComments]) -> List[Doc]:
	var documents: List[Doc] = []

	for item in items:
		documents = documents.append(item.import_with_comments_document())

	documents


private pure func import_block_body_document(items: List[ImportWithComments]) -> Doc:
	items
		.sorted_imports_with_comments()
		.import_with_comments_documents()
		.hardlines()


private pure func import_block_with_comments_document(
	items: List[ImportWithComments],
	suffix: Doc,
) -> Doc:
	if items.length() == 0:
		"".text()
	else:
		"import:"
			.text()
			.cat(
				Hardline
					.cat(items.import_block_body_document())
					.indent(),
			)
			.cat(suffix)


private pure func located_imports_last_line(imports: List[LocatedImport]) -> Int:
	var line: Int = 0

	for import_item in imports:
		if import_item.line > line:
			line = import_item.line

	line


private pure func collect_import_comments(
	imports: List[LocatedImport],
	comments: List[FormatterComment],
) -> ImportCommentCollect:
	var items: List[ImportWithComments] = []
	var remaining_comments: List[FormatterComment] = comments

	for import_item in imports:
		leading: CommentTake = remaining_comments.take_leading_comments(import_item.line)
		trailing: TrailingCommentTake = leading.remaining.take_trailing_comment(import_item.line)
		items = items.append({
			item = import_item.item,
			leading = leading.taken,
			trailing = trailing.comment,
		})
		remaining_comments = trailing.remaining.copy_formatter_comments()

	{
		items = items,
		remaining_comments = remaining_comments
	}


private pure func render_import_block(
	imports: List[LocatedImport],
	comments: List[FormatterComment],
) -> RenderedImportBlock:
	collected: ImportCommentCollect = imports.collect_import_comments(comments)
	drained: CommentTake = collected.remaining_comments.drain_comments_through(
		imports.located_imports_last_line(),
	)

	suffix: Doc = if drained.taken.length() == 0:
		"".text()
	else:
		drained_doc = drained.taken.comments_document()
		Hardline.cat(drained_doc)

	{
		document = collected.items.import_block_with_comments_document(suffix),
		remaining_comments = drained.remaining.copy_formatter_comments()
	}


private pure func target_document(name: Option[String], pattern: Option[Pattern]) -> Doc:
	match name:
		Some(var_name):
			var_name.text()
		None:
			match pattern:
				Some(var_pattern):
					var_pattern.pattern_document()
				None:
					"_".text()


private pure func variable_declaration_document(
	is_private: Bool,
	name: Option[String],
	pattern: Option[Pattern],
	is_mutable: Bool,
	type_expression: Option[TypeExpression],
	value: Expression,
) -> Doc:
	mutable_document: Doc = if is_mutable:
		"var ".text()
	else:
		"".text()

	type_document_part: Doc = match type_expression:
		Some(type_expr):
			": "
				.text()
				.cat(type_expr.type_document())
		None:
			"".text()

	is_private
		.private_document()
		.cat(mutable_document)
		.cat(target_document(name, pattern))
		.cat(type_document_part)
		.cat(" =".assignment_value_document(value))


private pure func annotation_document(name: String, enabled: Bool, is_private: Bool) -> Doc:
	if enabled:
		sep: Doc = if is_private:
			" ".text()
		else:
			Hardline

		name
			.text()
			.cat(sep)
	else:
		"".text()


private pure func is_foreign_function_body(body: FunctionBody) -> Bool:
	match body:
		ForeignFunctionBody(_, _):
			True
		_:
			False


private pure func builtin_body_document(name: Option[String]) -> Doc:
	match name:
		Some(c_name):
			("builtin(\"" + c_name.escape_string_value() + "\")").text()
		None:
			"builtin".text()


private pure func function_body_suffix_document(name: String, body: FunctionBody) -> Doc:
	match body:
		ExpressionFunctionBody(expr):
			":"
				.text()
				.cat(
					Hardline
						.cat(expr.block_body_document())
						.indent(),
				)
		BuiltinFunctionBody(c_name):
			":"
				.text()
				.cat(
					Hardline
						.cat(c_name.builtin_body_document())
						.indent(),
				)
		ForeignFunctionBody(foreign_name, _):
			if foreign_name == name:
				"".text()
			else:
				" = \""
					.text()
					.cat(
						foreign_name
							.escape_string_value()
							.text(),
					)
					.cat("\"".text())
		NoFunctionBody:
			":".text()


private pure func function_declaration_document(
	is_private: Bool,
	name: String,
	is_pure: Bool,
	is_tailrec: Bool,
	is_debug_only: Bool,
	no_copy: Bool,
	resource_result_ordinary: Bool,
	type_params: List[String],
	params: List[FunctionParameter],
	return_type: Option[TypeExpression],
	where_constraints: List[TypeConstraint],
	body: FunctionBody,
) -> Doc:
	pure_document: Doc = if is_pure:
		"pure ".text()
	else:
		"".text()

	foreign_body: Bool = body.is_foreign_function_body()

	foreign_document: Doc = if foreign_body:
		"foreign ".text()
	else:
		"".text()

	head: Doc = is_private
		.private_document()
		.cat(annotation_document("@debug_only", is_debug_only, is_private))
		.cat(annotation_document("@tail_recursive", is_tailrec, is_private))
		.cat(annotation_document("@no_copy", no_copy and foreign_body, is_private))
		.cat(annotation_document("@resource_result_ordinary", resource_result_ordinary, is_private))
		.cat(foreign_document)
		.cat(pure_document)
		.cat("func ".text())
		.cat(name.text())
		.cat(type_params.type_params_document())
		.cat(params.function_parameters_document())
		.cat(return_type.return_type_document())
		.cat(where_constraints.where_constraints_document())
	head.cat(function_body_suffix_document(name, body))


private pure func single_foreign_declaration_document(decl: Declaration) -> Doc:
	match decl.declaration_foreign_metadata():
		Some(metadata):
			metadata
				.foreign_block_header_document()
				.cat(
					Hardline
						.cat(decl.foreign_block_function_document())
						.indent(),
				)
		None:
			"".text()


private pure func type_variant_document(variant: TypeVariant) -> Doc:
	head: Doc = if variant.fields.length() == 0:
		variant.name.text()
	else:
		variant.name
			.text()
			.cat("(".text())
			.cat(
				variant.fields
					.type_document_list()
					.comma_sep(),
			)
			.cat(")".text())

	commented_member_document(head, "".text(), variant.comments)


--- The variants of a union body, one per line, then the comments after the last.
private pure func type_variant_lines(
	variants: List[TypeVariant],
	closing_comments: List[String],
) -> List[Doc]:
	var lines: List[Doc] = []

	for variant in variants:
		lines = lines.append(variant.type_variant_document())

	for comment in closing_comments:
		lines = lines.append(comment.text())

	lines


private pure func type_declaration_document(
	is_private: Bool,
	name: String,
	type_params: List[String],
	is_enum: Bool,
	is_builtin: Bool,
	is_resource: Bool,
	resource_cleanup: Option[String],
	variants: List[TypeVariant],
	closing_comments: List[String],
) -> Doc:
	if is_builtin:
		keyword: String = if is_resource:
			"resource type "
		else:
			"type "

		cleanup_document: Doc = match resource_cleanup:
			Some(cleanup):
				"(\""
					.text()
					.cat(
						cleanup
							.escape_string_value()
							.text(),
					)
					.cat("\")".text())
			None:
				"".text()

		is_private
			.private_document()
			.cat(keyword.text())
			.cat(name.text())
			.cat(type_params.type_params_document())
			.cat(" = builtin".text())
			.cat(cleanup_document)
	else:
		keyword: String = if is_enum:
			"enum "
		else:
			"union "

		is_private
			.private_document()
			.cat(keyword.text())
			.cat(name.text())
			.cat(type_params.type_params_document())
			.cat(":".text())
			.cat(
				Hardline
					.cat(
						variants
							.type_variant_lines(closing_comments)
							.hardlines(),
					)
					.indent(),
			)


private pure func declaration_field_head_document(field_value: DeclarationField) -> Doc:
	field_value.name
		.text()
		.cat(": ".text())
		.cat(field_value.field_type.type_document())


---
The fields of a record body, one per line: each field after its leading
comments, then its comma (none after the last field) and the comment ending its
line, then the whole-line comments after the last field.
---
private pure func declaration_field_lines(
	fields: List[DeclarationField],
	closing_comments: List[String],
) -> List[Doc]:
	var lines: List[Doc] = []
	last_index: Int = fields.length() - 1
	var index: Int = 0

	for field_value in fields:
		comma: Doc = if index < last_index:
			",".text()
		else:
			"".text()

		lines = lines.append(
			commented_member_document(
				field_value.declaration_field_head_document(),
				comma,
				field_value.comments,
			),
		)
		index += 1

	for comment in closing_comments:
		lines = lines.append(comment.text())

	lines


private pure func record_fields_prefer_multiline(
	fields: List[DeclarationField],
	closing_comments: List[String],
) -> Bool:
	fields.length() > 0 or closing_comments.length() > 0


private pure func record_declaration_document(
	is_private: Bool,
	name: String,
	type_params: List[String],
	spelling: RecordSpelling,
	is_builtin: Bool,
	fields: List[DeclarationField],
	closing_comments: List[String],
) -> Doc:
	keyword: String = match spelling:
		OrdinaryRecordSpelling: "record "
		StructSpelling: "struct "
		FixedRecordSpelling: "fixed record "

	if is_builtin:
		is_private
			.private_document()
			.cat(keyword.text())
			.cat(name.text())
			.cat(type_params.type_params_document())
			.cat(" {builtin}".text())
	else:
		header: Doc = is_private
			.private_document()
			.cat(keyword.text())
			.cat(name.text())
			.cat(type_params.type_params_document())
			.cat(" {".text())

		if fields.record_fields_prefer_multiline(closing_comments):
			header
				.cat(
					Hardline
						.cat(
							fields
								.declaration_field_lines(closing_comments)
								.hardlines(),
						)
						.indent(),
				)
				.cat(Hardline)
				.cat("}".text())
		else:
			-- No fields and no comments: the empty body `{}`.
			header.cat("}".text())


private pure func type_alias_declaration_document(
	is_private: Bool,
	is_opaque: Bool,
	name: String,
	type_params: List[String],
	target: TypeExpression,
) -> Doc:
	prefix: String = if is_opaque:
		"opaque type "
	else:
		"type alias "

	is_private
		.private_document()
		.cat(prefix.text())
		.cat(name.text())
		.cat(type_params.type_params_document())
		.cat(" = ".text())
		.cat(target.type_document())


private pure func supertraits_document(supertraits: List[String]) -> Doc:
	if supertraits.length() == 0:
		"".text()
	else:
		": "
			.text()
			.cat(
				" + "
					.text()
					.intersperse(supertraits.string_documents()),
			)


private pure func trait_method_document(method: TraitMethod) -> Doc:
	pure_document: Doc = if method.is_pure:
		"pure ".text()
	else:
		"".text()

	head: Doc = pure_document
		.cat("func ".text())
		.cat(method.name.text())
		.cat(method.params.function_parameters_document())
		.cat(method.return_type.return_type_document())

	match method.body:
		None:
			head
		Some(body):
			if body.is_block_expression():
				head
					.cat(":".text())
					.cat(
						Hardline
							.cat(body.block_body_document())
							.indent(),
					)
			else:
				head
					.cat(": ".text())
					.cat(body.expression_document())


private pure func trait_method_documents(methods: List[TraitMethod]) -> List[Doc]:
	var documents: List[Doc] = []

	for method in methods:
		documents = documents.append(method.trait_method_document())

	documents


private pure func trait_declaration_document(
	is_private: Bool,
	name: String,
	type_params: List[String],
	supertraits: List[String],
	methods: List[TraitMethod],
) -> Doc:
	needs_colon: Bool = methods.length() != 0 or supertraits.length() == 0

	colon_document: Doc = if needs_colon:
		":".text()
	else:
		"".text()

	header: Doc = is_private
		.private_document()
		.cat("trait ".text())
		.cat(name.text())
		.cat(type_params.type_params_document())
		.cat(supertraits.supertraits_document())
		.cat(colon_document)

	if methods.length() == 0:
		header
	else:
		header.cat(
			Hardline
				.cat(
					methods
						.trait_method_documents()
						.hardlines(),
				)
				.indent(),
		)


private pure func implementation_method_document(method: ImplementationMethod) -> Doc:
	function_declaration_document(
		False,
		method.name,
		method.is_pure,
		method.is_tailrec,
		method.is_debug_only,
		method.no_copy,
		method.resource_result_ordinary,
		method.type_params,
		method.params,
		method.return_type,
		method.where_constraints,
		method.body,
	)


private pure func implementation_method_documents(methods: List[ImplementationMethod]) -> List[Doc]:
	var documents: List[Doc] = []

	for method in methods:
		documents = documents.append(method.implementation_method_document())

	documents


private pure func implementation_declaration_document(
	is_private: Bool,
	trait_name: String,
	for_type: TypeExpression,
	methods: List[ImplementationMethod],
) -> Doc:
	is_private
		.private_document()
		.cat("implements ".text())
		.cat(trait_name.text())
		.cat(" for ".text())
		.cat(for_type.type_document())
		.cat(":".text())
		.cat(
			Hardline
				.cat(blank_lines(1, methods.implementation_method_documents()))
				.indent(),
		)


private pure func declaration_documents(declarations: List[Declaration]) -> List[Doc]:
	var documents: List[Doc] = []

	for decl in declarations:
		documents = documents.append(decl.declaration_document())

	documents


pure func declaration_document(decl: Declaration) -> Doc:
	match decl:
		DocumentedDeclaration(doc, inner):
			doc
				.docstring_document()
				.cat(inner.declaration_document())
		ImportDeclaration(item):
			item.import_declaration_document()
		VariableDeclaration(is_private, name, pattern, is_mutable, type_expression, value):
			variable_declaration_document(
				is_private,
				name,
				pattern,
				is_mutable,
				type_expression,
				value,
			)
		FunctionDeclaration(is_private, name, is_pure, is_tailrec, is_debug_only, no_copy, resource_result_ordinary, type_params, params, return_type, where_constraints, body):
			if body.is_foreign_function_body():
				FunctionDeclaration(
					is_private,
					name,
					is_pure,
					is_tailrec,
					is_debug_only,
					no_copy,
					resource_result_ordinary,
					type_params,
					params,
					return_type,
					where_constraints,
					body,
				).single_foreign_declaration_document()
			else:
				function_declaration_document(
					is_private,
					name,
					is_pure,
					is_tailrec,
					is_debug_only,
					no_copy,
					resource_result_ordinary,
					type_params,
					params,
					return_type,
					where_constraints,
					body,
				)
		TypeDeclaration(is_private, name, type_params, is_enum, is_builtin, is_resource, resource_cleanup, variants, closing_comments):
			type_declaration_document(
				is_private,
				name,
				type_params,
				is_enum,
				is_builtin,
				is_resource,
				resource_cleanup,
				variants,
				closing_comments,
			)
		RecordDeclaration(is_private, name, type_params, spelling, is_builtin, fields, closing_comments):
			record_declaration_document(
				is_private,
				name,
				type_params,
				spelling,
				is_builtin,
				fields,
				closing_comments,
			)
		TypeAliasDeclaration(is_private, is_opaque, name, type_params, target):
			type_alias_declaration_document(is_private, is_opaque, name, type_params, target)
		TraitDeclaration(is_private, name, type_params, supertraits, methods):
			trait_declaration_document(is_private, name, type_params, supertraits, methods)
		ImplementationDeclaration(is_private, trait_name, for_type, methods):
			implementation_declaration_document(is_private, trait_name, for_type, methods)


private pure func declaration_function_name(decl: Declaration) -> Option[String]:
	match decl:
		DocumentedDeclaration(_, inner):
			inner.declaration_function_name()
		FunctionDeclaration(_, name, _, _, _, _, _, _, _, _, _, _):
			Some(name)
		_:
			None


private pure func is_small_declaration(decl: Declaration) -> Bool:
	match decl:
		DocumentedDeclaration(_, inner):
			inner.is_small_declaration()
		VariableDeclaration(_, _, _, _, _, _):
			True
		TypeAliasDeclaration(_, _, _, _, _):
			True
		_:
			False


private pure func foreign_block_function_document(decl: Declaration) -> Doc:
	match decl:
		DocumentedDeclaration(doc, inner):
			doc
				.docstring_document()
				.cat(inner.foreign_block_function_document())
		FunctionDeclaration(is_private, name, is_pure, _, is_debug_only, no_copy, _, type_params, params, return_type, where_constraints, body):
			private_prefix: Doc = if is_private:
				"private ".text()
			else:
				"".text()

			debug_document: Doc = if is_debug_only:
				"@debug_only ".text()
			else:
				"".text()

			no_copy_document: Doc = if no_copy:
				"@no_copy ".text()
			else:
				"".text()

			pure_document: Doc = if is_pure:
				"pure ".text()
			else:
				"".text()

			private_prefix
				.cat(debug_document)
				.cat(no_copy_document)
				.cat(pure_document)
				.cat("func ".text())
				.cat(name.text())
				.cat(type_params.type_params_document())
				.cat(params.function_parameters_document())
				.cat(return_type.return_type_document())
				.cat(where_constraints.where_constraints_document())
				.cat(function_body_suffix_document(name, body))
		_:
			decl.declaration_document()


private pure func foreign_link_flag_key(flag: ForeignLinkFlag) -> String:
	match flag.platform:
		None:
			"link"
		Some("linux"):
			"link_linux"
		Some("macos"):
			"link_macos"
		Some(platform):
			"link_" + platform


private pure func foreign_link_flag_arg(flag: ForeignLinkFlag) -> String:
	flag.foreign_link_flag_key() + ": \"" + flag.value.escape_string_value() + "\""


private pure func foreign_block_header_document(metadata: ForeignMetadata) -> Doc:
	var args: List[String] = []

	for include in metadata.includes:
		args = args.append("include: \"" + include.escape_string_value() + "\"")

	for flag in metadata.link_flags:
		args = args.append(flag.foreign_link_flag_arg())

	if args.length() == 0:
		"foreign:".text()
	else:
		("foreign(" + args.join(", ") + "):").text()


private pure func declaration_foreign_metadata(decl: Declaration) -> Option[ForeignMetadata]:
	match decl:
		DocumentedDeclaration(_, inner):
			inner.declaration_foreign_metadata()
		FunctionDeclaration(_, _, _, _, _, _, _, _, _, _, _, body):
			match body:
				ForeignFunctionBody(_, metadata):
					Some(metadata)
				_:
					None
		_:
			None


private pure func located_declaration_foreign_metadata(
	located: LocatedDeclaration,
) -> Option[ForeignMetadata]:
	located.declaration.declaration_foreign_metadata()


private pure func render_foreign_block_function(
	located: LocatedDeclaration,
	comments: List[FormatterComment],
) -> RenderedDocument:
	leading: CommentTake = comments.take_leading_comments(located.line)
	trailing: TrailingCommentTake = leading.remaining.take_trailing_comment(located.line)
	leading_doc = leading.taken.comments_document()
	function_doc = located.declaration.foreign_block_function_document()
	trailing_doc = trailing.comment.trailing_comment_document()
	{
		document = leading_doc
			.cat(function_doc)
			.cat(trailing_doc),
		remaining_comments = trailing.remaining.copy_formatter_comments()
	}


---
Render one source `foreign:` block. The comments written above its header have
already been taken, so each comment left before a function sits inside the
block and leads that function.
---
private pure func render_foreign_block(
	metadata: ForeignMetadata,
	declarations: List[LocatedDeclaration],
	comments: List[FormatterComment],
) -> RenderedDocument:
	var body_document: Doc = "".text()
	var has_body_document: Bool = False
	var remaining_comments: List[FormatterComment] = comments

	for located in declarations:
		rendered: RenderedDocument = located.render_foreign_block_function(remaining_comments)

		if has_body_document:
			body_document = body_document
				.cat(Hardline)
				.cat(rendered.document)
		else:
			body_document = rendered.document
			has_body_document = True

		remaining_comments = rendered.remaining_comments.copy_formatter_comments()

	{
		document = metadata
			.foreign_block_header_document()
			.cat(
				Hardline
					.cat(body_document)
					.indent(),
			),
		remaining_comments = remaining_comments
	}


private pure func flush_foreign_body_item(
	items: List[ProgramBodyItem],
	foreign_group: Option[ForeignBlockGroup],
) -> List[ProgramBodyItem]:
	match foreign_group:
		Some(group):
			items.append(BodyForeignBlock(group.metadata, group.functions))
		None:
			items


private pure func flush_import_body_item(
	items: List[ProgramBodyItem],
	import_group: List[LocatedImport],
) -> List[ProgramBodyItem]:
	if import_group.length() == 0:
		items
	else:
		items.append(BodyImportBlock(import_group))


private pure func located_declaration_import(located: LocatedDeclaration) -> Option[LocatedImport]:
	match located.declaration:
		ImportDeclaration(item):
			Some({
				line = located.line,
				column = located.column,
				item = item,
			})
		_:
			None


private pure func program_body_items(
	declarations: List[LocatedDeclaration],
) -> List[ProgramBodyItem]:
	var items: List[ProgramBodyItem] = []
	var import_group: List[LocatedImport] = []
	var foreign_group: Option[ForeignBlockGroup] = None

	for located in declarations:
		match located.located_declaration_import():
			Some(import_item):
				items = items.flush_foreign_body_item(foreign_group)
				foreign_group = None
				import_group = import_group.append(import_item)
			None:
				items = items.flush_import_body_item(import_group)
				import_group = []

				match located.located_declaration_foreign_metadata():
					Some(metadata):
						foreign_group = match foreign_group:
							Some(group):
								if group.metadata.header_line == metadata.header_line:
									Some({
										metadata = group.metadata,
										functions = group.functions.append(located),
									})
								else:
									items = items.flush_foreign_body_item(Some(group))
									Some({
										metadata = metadata,
										functions = [located],
									})
							None:
								Some({
									metadata = metadata,
									functions = [located],
								})
					None:
						items = items.flush_foreign_body_item(foreign_group)
						foreign_group = None
						items = items.append(BodyDeclaration(located))

	items
		.flush_import_body_item(import_group)
		.flush_foreign_body_item(foreign_group)


private pure func program_body_item_func_name(item: ProgramBodyItem) -> Option[String]:
	match item:
		BodyDeclaration(located):
			located.declaration.declaration_function_name()
		BodyImportBlock(_):
			None
		BodyForeignBlock(_, _):
			None


private pure func is_small_program_body_item(item: ProgramBodyItem) -> Bool:
	match item:
		BodyDeclaration(located):
			located.declaration.is_small_declaration()
		BodyImportBlock(_):
			False
		BodyForeignBlock(_, _):
			False


private pure func is_same_function_overload_item(
	left: ProgramBodyItem,
	right: ProgramBodyItem,
) -> Bool:
	match left.program_body_item_func_name():
		Some(left_name):
			match right.program_body_item_func_name():
				Some(right_name):
					left_name == right_name
				None:
					False
		None:
			False


private pure func program_body_item_separator(left: ProgramBodyItem, right: ProgramBodyItem) -> Doc:
	if left.is_same_function_overload_item(right):
		Hardline
	else if left.is_small_program_body_item() and right.is_small_program_body_item():
		Hardline.cat(Hardline)
	else:
		Hardline
			.cat(Hardline)
			.cat(Hardline)


private pure func render_program_body_item(
	item: ProgramBodyItem,
	comments: List[FormatterComment],
) -> RenderedDocument:
	match item:
		BodyDeclaration(located):
			leading: CommentTake = comments.take_leading_comments(located.line)
			trailing: TrailingCommentTake = leading.remaining.take_trailing_comment(located.line)
			drained: CommentTake = trailing.remaining.drain_nested_comments_through(
				located.end_line,
				located.column,
			)
			leading_doc = leading.taken.comments_document()
			-- The comment ending the declaration's first line is deferred to the
			-- end of the first rendered line, so it stays on the header instead
			-- of following the body. A documented declaration's first line is
			-- its docstring, which ends no comment.
			header_comment = trailing.comment.trailing_comment_document()
			{
				document = leading_doc
					.cat(header_comment)
					.cat(located.declaration.declaration_document()),
				remaining_comments = drained.remaining.copy_formatter_comments()
			}
		BodyImportBlock(imports):
			rendered: RenderedImportBlock = imports.render_import_block(comments)
			{
				document = rendered.document,
				remaining_comments = rendered.remaining_comments.copy_formatter_comments()
			}
		BodyForeignBlock(metadata, declarations):
			leading: CommentTake = comments.take_leading_comments(metadata.header_line)
			header: TrailingCommentTake = leading.remaining.take_trailing_comment(
				metadata.header_line,
			)
			rendered: RenderedDocument = metadata.render_foreign_block(
				declarations,
				header.remaining.copy_formatter_comments(),
			)
			leading_doc = leading.taken.comments_document()
			-- The comment ending the `foreign:` line is deferred to the end of the
			-- rendered header, as for a declaration's first line.
			header_comment = header.comment.trailing_comment_document()
			{
				document = leading_doc
					.cat(header_comment)
					.cat(rendered.document),
				remaining_comments = rendered.remaining_comments.copy_formatter_comments()
			}


private pure func split_leading_imports(declarations: List[LocatedDeclaration]) -> ProgramParts:
	var imports: List[LocatedImport] = []
	var body: List[LocatedDeclaration] = []
	var in_body: Bool = False

	for located in declarations:
		if in_body:
			body = body.append(located)
		else:
			match located.declaration:
				ImportDeclaration(item):
					imports = imports.append({
						line = located.line,
						column = located.column,
						item = item,
					})
				_:
					in_body = True
					body = body.append(located)

	{
		imports = imports,
		body = body
	}


private pure func program_body_document(
	declarations: List[LocatedDeclaration],
	comments: List[FormatterComment],
) -> Doc:
	items: List[ProgramBodyItem] = declarations.program_body_items()
	var result: Doc = "".text()
	var previous: Option[ProgramBodyItem] = None
	var remaining_comments: List[FormatterComment] = comments

	for item in items:
		rendered: RenderedDocument = item.render_program_body_item(remaining_comments)

		match previous:
			None:
				result = rendered.document
			Some(prev):
				result = result
					.cat(prev.program_body_item_separator(item))
					.cat(rendered.document)

		remaining_comments = rendered.remaining_comments.copy_formatter_comments()
		previous = Some(item)

	result.append_remaining_comments(remaining_comments)


private pure func program_first_decl_line(declarations: List[LocatedDeclaration]) -> Int:
	match declarations.get(0):
		Some(first):
			first.line
		None:
			2147483647


---
Renders the comments above the leading import block, with the module
docstring (when present) between the comments written above it and those
written between it and the imports.
---
private pure func import_header_document(program: Program) -> RenderedDocument:
	first_decl_line: Int = program.declarations.program_first_decl_line()

	match program.module_doc:
		Some(module_doc):
			above_doc: CommentTake = program.comments.take_leading_comments(module_doc.line)
			below_doc: CommentTake = above_doc.remaining.take_leading_comments(first_decl_line)
			{
				document = above_doc.taken
					.comments_document()
					.cat(PlainDeclarationDoc(module_doc.text_value).docstring_document())
					.cat(below_doc.taken.comments_document()),
				remaining_comments = below_doc.remaining.copy_formatter_comments()
			}
		None:
			header_comments: CommentTake = program.comments.take_leading_comments(first_decl_line)
			{
				document = header_comments.taken.comments_document(),
				remaining_comments = header_comments.remaining.copy_formatter_comments()
			}


pure func program_document(program: Program) -> Doc:
	parts: ProgramParts = program.declarations.split_leading_imports()

	if parts.imports.length() == 0:
		parts.body.program_body_document(program.comments)
	else:
		header: RenderedDocument = program.import_header_document()
		import_render: RenderedImportBlock = parts.imports.render_import_block(
			header.remaining_comments.copy_formatter_comments(),
		)
		import_document: Doc = header.document.cat(import_render.document)
		body_document: Doc = parts.body.program_body_document(
			import_render.remaining_comments.copy_formatter_comments(),
		)

		if parts.body.length() == 0:
			import_document.append_remaining_comments(
				import_render.remaining_comments.copy_formatter_comments(),
			)
		else:
			import_document
				.cat(Hardline)
				.cat(Hardline)
				.cat(Hardline)
				.cat(body_document)


private pure func located_declaration_from_json(
	value: JsonValue,
) -> Result[LocatedDeclaration, String]:
	match value.get_field("decl"):
		Some(decl_value):
			line ?= value.int_field("line")
			column ?= value.int_field("column")
			end_line ?= value.optional_int_field("end_line")
			declaration ?= decl_value.declaration_from_json()
			resolved_end: Int = end_line.get_or(line)
			Ok({
				line = line,
				column = column,
				end_line = resolved_end,
				declaration = declaration,
			})
		None:
			declaration ?= value.declaration_from_json()
			Ok({
				line = 0,
				column = 0,
				end_line = 0,
				declaration = declaration,
			})


private pure func module_doc_field(
	value: JsonValue,
	key: String,
) -> Result[Option[ModuleDoc], String]:
	match value.get_field(key):
		None:
			Ok(None)
		Some(child):
			text_value ?= child.string_field("text")
			line ?= child.int_field("line")
			Ok(Some({
				text_value = text_value,
				line = line,
			}))


pure func program_from_json(value: JsonValue) -> Result[Program, String]:
	declarations ?= value.parsed_array_field("program", located_declaration_from_json)
	comments ?= value.formatter_comments_field("comments")
	module_doc ?= value.module_doc_field("module_doc")
	Ok({
		module_doc = module_doc,
		declarations = declarations,
		comments = comments,
	})


pure func program_from_json_string(input: String) -> Result[Program, String]:
	value ?= input.parse_json()
	value.program_from_json()


pure func render_declaration_json(width: Int, input: String) -> Result[String, String]:
	decl ?= input.declaration_from_json_string()
	Ok(width.layout(decl.declaration_document()))


pure func render_program_json(width: Int, input: String) -> Result[String, String]:
	program ?= input.program_from_json_string()
	Ok(width.layout(program.program_document()))
