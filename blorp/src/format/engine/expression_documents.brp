import:
	./document_layout:
		Doc(Hardline, Softline, SoftlineSpace),
		comma_hardline_documents,
		comma_sep,
		comma_sep_break,
		concat_documents,
		hardlines,
		layout,
		line_suffix,
		render_flat,
		text,
	./json_fields:
		array_field,
		bool_field,
		field,
		int_field,
		optional_int_field,
		parsed_array_field,
		string_array_field,
		string_field,
	./type_documents:
		TypeConstraint,
		TypeExpression,
		optional_type_expression_field,
		return_type_document,
		string_documents,
		type_constraint_array_field_or_empty,
		type_expression_field,
		type_params_document,
		where_constraints_document,
	json: JsonValue, parse_json


record StringFlags {
	raw: Bool,
	multiline: Bool
}


union Literal:
	IntLiteral(String)
	Int128Literal(String)
	FloatLiteral(String)
	StringLiteral(String, StringFlags)
	BoolLiteral(Bool)
	CharLiteral(Int)


union UnaryOp:
	NegOp
	NotOp


union BinaryOp:
	AddOp
	SubOp
	MulOp
	DivOp
	ModOp
	LtOp
	GtOp
	LeOp
	GeOp
	EqOp
	NeOp


union LogicalOp:
	AndOp
	OrOp


union Pattern:
	WildcardPattern
	VarPattern(String)
	ConstructorPattern(String, List[Pattern])
	LiteralPattern(Literal)
	TuplePattern(List[Pattern])
	QualifiedPattern(String, String, List[Pattern])
	ListPattern(List[Pattern])
	ListSpreadPattern(List[Pattern], Pattern)
	OrPattern(List[Pattern])


---
A function parameter. `CommentedParam` is a parameter written with comments:
those above it and ending its line, then the whole-line comments after it
before the closing `)`, which only the last parameter has. A parameter list
with one renders a parameter per line.
---
union FunctionParameter:
	NameParam(String)
	TypedNameParam(String, TypeExpression)
	PatternParam(Pattern)
	TypedPatternParam(Pattern, TypeExpression)
	CommentedParam(FunctionParameter, MemberComments, List[String])


union StringInterpolationPart:
	StringInterpolationTextPart(String)
	StringInterpolationExpressionPart(Expression)


union BlockItem:
	BlockCommentItem(Bool, String)
	BlockExpressionItem(Bool, Expression, Option[String])


---
Comments kept with one member of a body the formatter lays out itself, such as
a match case. The member owns them because no enclosing block or declaration
claims comments written among its members. `leading` holds the whole-line
comments directly above the member, in source order; `trailing` is the comment
that ends the member's first line.
---
record MemberComments {
	leading: List[String],
	trailing: Option[String]
}


--- A collection item with the comments written around it.
record CommentedItem[T] {
	item: T,
	comments: MemberComments
}


---
A call, subscript or collection literal written with comments among its items. Each
variant mirrors the plain expression of the same shape (a call's callee, a
record update's base) with commented items.
---
union CommentedCollection:
	CommentedCall(Expression, List[CommentedItem[Expression]])
	CommentedSubscript(Expression, List[CommentedItem[Expression]])
	CommentedList(List[CommentedItem[Expression]])
	CommentedTuple(List[CommentedItem[Expression]])
	CommentedVector(List[CommentedItem[Expression]])
	CommentedRecord(List[CommentedItem[(String, Expression)]])
	CommentedRecordUpdate(Expression, List[CommentedItem[(String, Expression)]])
	CommentedDictionary(List[CommentedItem[(Expression, Expression)]])


---
Whether the last item of a broken collection takes a comma: records keep
their last field bare, as the plain record layouts do.
---
fixed union LastItemComma:
	CommaAfterLastItem
	NoCommaAfterLastItem


---
How an expression renders as the operand of a postfix form: a field access
receiver, a call callee, a subscript target, or the receiver of a method chain.
An expression that binds looser than the postfix form needs parentheses, and
one that renders as an indented suite also needs its closing parenthesis on a
line of its own, because a `)` after the suite's last line does not parse.
---
fixed union PostfixOperandForm:
	BarePostfixOperand
	InlineParenthesizedPostfixOperand
	SuiteParenthesizedPostfixOperand


---
The comments a match keeps outside its cases: `header_trailing` ends the
`match ...:` line, and `closing` holds the whole-line comments after the last
case, at case indentation.
---
record MatchComments {
	header_trailing: Option[String],
	closing: List[String]
}


union MatchCase:
	MatchCaseData(Pattern, Expression, MemberComments)


union SelectArm:
	SelectRecvArm(String, Expression, Expression)
	SelectAfterArm(Expression, Expression)
	SelectSealedArm(Expression, Expression)


---
A formatter expression. `if`, `while` and `for` carry the comment ending their
header line as an `Option[String]` after their parts; `IfElseExpression` also
carries the comments of its `else` keyword: the whole-line comments above it
and the comment ending an `else:` line. `CommentedCollectionExpression` is a
call or collection written with comments among its items; its list holds the
whole-line comments after the last item. It always renders one item per line,
so each comment keeps its place. `CommentedLogicalExpression` is an `and` or
`or` chain written with comments among its terms; it always renders one term
per line inside parentheses.
---
union Expression:
	IdentifierExpression(String)
	LiteralExpression(Literal)
	VoidExpression
	BreakExpression
	ContinueExpression
	BuiltinExpression
	BuiltinRuntimeExpression(String)
	FieldAccessExpression(Expression, String)
	CallExpression(Expression, List[Expression])
	OpaqueIntoExpression(TypeExpression, Expression)
	OpaqueFromExpression(TypeExpression, Expression)
	UnaryExpression(UnaryOp, Expression)
	BinaryExpression(BinaryOp, Expression, Expression)
	LogicalExpression(LogicalOp, Expression, Expression)
	TupleExpression(List[Expression])
	ListExpression(List[Expression])
	VectorExpression(List[Expression])
	RecordExpression(List[(String, Expression)])
	RecordUpdateExpression(Expression, List[(String, Expression)])
	RangeExpression(Expression, Expression)
	SubscriptExpression(Expression, Expression)
	MultiSubscriptExpression(Expression, List[Expression])
	DictionaryExpression(List[(Expression, Expression)])
	AssignmentExpression(String, Expression)
	CompoundAssignmentExpression(String, BinaryOp, Expression)
	VariableDeclarationExpression(String, Bool, Expression)
	TypedVariableDeclarationExpression(String, Bool, TypeExpression, Expression)
	TupleDestructureExpression(List[String], Expression)
	SubscriptAssignmentExpression(Expression, List[Expression], Expression)
	QuestionBindExpression(String, Expression)
	TypedQuestionBindExpression(String, TypeExpression, Expression)
	BlockExpression(List[Expression])
	SpacedBlockExpression(List[(Bool, Expression)])
	ItemBlockExpression(List[BlockItem])
	IfExpression(Expression, Expression, Option[String])
	IfElseExpression(Expression, Expression, Expression, Option[String], MemberComments)
	MatchExpression(Expression, List[MatchCase], MatchComments)
	SelectExpression(List[SelectArm])
	WhileExpression(Expression, Expression, Option[String])
	ForExpression(String, Expression, Expression, Option[String])
	TupleForExpression(List[String], Expression, Expression, Option[String])
	LambdaExpression(Bool, List[FunctionParameter], Expression)
	TypedLambdaExpression(Bool, List[FunctionParameter], TypeExpression, Expression)
	FunctionDeclarationExpression(String, Bool, List[String], List[FunctionParameter], List[TypeConstraint], Expression)
	TypedFunctionDeclarationExpression(String, Bool, List[String], List[FunctionParameter], TypeExpression, List[TypeConstraint], Expression)
	StringInterpolationExpression(List[StringInterpolationPart], Bool)
	DebugBlockExpression(Expression)
	ConcurrentExpression(List[Expression], Option[Expression], Option[Int])
	ConcurrentBindExpression(String, Option[TypeExpression], Expression)
	DetachExpression(Expression)
	ConcurrentlyLoopExpression(String, Expression, Expression, Option[Expression], ConcurrentlyLoopWidth)
	WithExpression(String, Option[TypeExpression], Bool, Expression, Option[String], Option[Expression], Expression)
	CommentedCollectionExpression(CommentedCollection, List[String])
	CommentedLogicalExpression(LogicalOp, List[CommentedItem[Expression]])


union ConcurrentlyLoopWidth:
	ConcurrentlyLoopLimit(Int)


record UfcsStep {
	name: String,
	args: List[Expression]
}


record UfcsChain {
	receiver: Expression,
	steps: List[UfcsStep]
}


private pure func hex_digit(n: Int) -> String:
	if n < 10:
		to_char(to_int('0') + n).to_string()
	else:
		to_char(to_int('A') + n - 10).to_string()


private pure func hex_upper(n: Int) -> String:
	if n == 0:
		"0"
	else:
		var value: Int = n
		var output: String = ""

		while value > 0:
			digit: Int = value % 16
			output = digit.hex_digit() + output
			value /= 16

		output


private pure func unicode_escape(code: Int) -> String:
	"\\u{" + code.hex_upper() + "}"


private pure func escape_char_code(code: Int, escape_single_quote: Bool) -> String:
	if code == 10:
		"\\n"
	else if code == 9:
		"\\t"
	else if code == 13:
		"\\r"
	else if code == 92:
		"\\\\"
	else if code == 34:
		"\\\""
	else if code == 39 and escape_single_quote:
		"\\'"
	else if code == 0:
		"\\0"
	else if code >= 32 and code < 127:
		to_char(code).to_string()
	else:
		code.unicode_escape()


pure func escape_string_value(s: String) -> String:
	var output: String = ""
	var i: Int = 0

	while i < s.length():
		match s.get(i):
			Some(c):
				code: Int = c.to_int()

				if code >= 128:
					output += s.substring(i, 1)
				else:
					output += escape_char_code(code, False)
			None:
				void

		i += 1

	output


private pure func escape_multiline_string_value(s: String) -> String:
	var output: String = ""
	var i: Int = 0

	while i < s.length():
		match s.get(i):
			Some(c):
				code: Int = c.to_int()

				if code >= 128:
					output += s.substring(i, 1)
				else if code == 92:
					output += "\\\\"
				else if code == 9:
					output += "\\t"
				else if code == 13:
					output += "\\r"
				else if code == 0:
					output += "\\0"
				else:
					output += c.to_string()
			None:
				void

		i += 1

	output


private pure func pipe_string_line_document(line: String) -> Doc:
	("|" + line).text()


private pure func pipe_string_line_documents(lines: List[String]) -> List[Doc]:
	var documents: List[Doc] = []

	for line in lines:
		documents = documents.append(line.pipe_string_line_document())

	documents


private pure func pipe_string_content_document(value: String) -> Doc:
	value
		.split("\n")
		.pipe_string_line_documents()
		.hardlines()


private pure func pipe_string_literal_document(value: String, raw: Bool) -> Doc:
	if raw:
		"raw"
			.text()
			.cat(
				Hardline
					.cat(value.pipe_string_content_document())
					.indent(),
			)
	else:
		value.pipe_string_content_document()


private pure func is_pipe_string_expression(expr: Expression) -> Bool:
	match expr:
		LiteralExpression(StringLiteral(_, flags)):
			flags.multiline
		StringInterpolationExpression(_, is_multiline):
			is_multiline
		_:
			False


pure func assignment_value_document(operator_text: String, value: Expression) -> Doc:
	if value.is_pipe_string_expression():
		match value:
			LiteralExpression(StringLiteral(_, flags)):
				if flags.raw:
					operator_text
						.text()
						.cat(" ".text())
						.cat(value.expression_document())
				else:
					operator_text
						.text()
						.cat(
							Hardline
								.cat(value.expression_document())
								.indent(),
						)
			StringInterpolationExpression(_, _):
				operator_text
					.text()
					.cat(
						Hardline
							.cat(value.expression_document())
							.indent(),
					)
			_:
				operator_text
					.text()
					.cat(" ".text())
					.cat(value.expression_document())
	else:
		operator_text
			.text()
			.cat(" ".text())
			.cat(value.expression_document())


private string_literal_wrap_char_limit: Int = 80

private string_literal_wrap_min_search_width: Int = 48


private pure func char_is_safe_plain_string_literal_char(c: Char) -> Bool:
	code: Int = c.to_int()
	code >= 32 and code < 127 and code != 34 and code != 36 and code != 92


private pure func string_is_safe_to_wrap_as_plain_literal(value: String) -> Bool:
	var safe: Bool = True
	var i: Int = 0

	while i < value.length():
		match value.get(i):
			Some(c):
				if not c.char_is_safe_plain_string_literal_char():
					safe = False
					break
			None:
				safe = False
				break

		i += 1

	safe


private pure func char_is_string_literal_wrap_boundary(c: Char) -> Bool:
	code: Int = c.to_int()
	code == 32 or code == 44 or code == 45 or code == 46 or code == 47 or code == 58 or code == 59


private pure func string_literal_wrap_end(value: String, start: Int) -> Int:
	limit: Int = string_literal_wrap_char_limit
	remaining: Int = value.length() - start

	if remaining <= limit:
		value.length()
	else:
		fallback: Int = start + limit
		min_end: Int = start + string_literal_wrap_min_search_width
		var i: Int = fallback - 1
		var found: Bool = False
		var split_at: Int = fallback

		while i >= min_end and not found:
			match value.get(i):
				Some(c):
					if c.char_is_string_literal_wrap_boundary():
						split_at = i + 1
						found = True
				None:
					void

			i -= 1

		split_at


private pure func string_literal_wrap_chunks(value: String) -> List[String]:
	var chunks: List[String] = []
	var start: Int = 0

	while start < value.length():
		end_idx: Int = value.string_literal_wrap_end(start)
		chunks = chunks.append(value.substring(start, end_idx - start))
		start = end_idx

	chunks


private pure func string_literal_can_wrap(value: String) -> Bool:
	(
		value.length() > string_literal_wrap_char_limit
		and value.string_is_safe_to_wrap_as_plain_literal()
	)


-- A plain literal that is too long for one line renders as a parenthesized
-- concatenation of chunks. Layout decisions must treat such a literal exactly
-- like the equivalent explicit concatenation, otherwise formatting the
-- formatter's own output changes the surrounding layout.
private pure func string_literal_renders_wrapped(value: String, flags: StringFlags) -> Bool:
	not flags.multiline and not flags.raw and value.string_literal_can_wrap()


private pure func plain_string_literal_document(value: String) -> Doc:
	("\"" + value.escape_string_value() + "\"").text()


private pure func wrapped_string_literal_chunk_documents(chunks: List[String]) -> List[Doc]:
	var documents: List[Doc] = []
	var index: Int = 0

	for chunk in chunks:
		chunk_document: Doc = chunk.plain_string_literal_document()

		if index == 0:
			documents = documents.append(chunk_document)
		else:
			documents = documents.append(
				"+ "
					.text()
					.cat(chunk_document),
			)

		index += 1

	documents


private pure func wrapped_plain_string_literal_chunks_document(chunks: List[String]) -> Doc:
	"("
		.text()
		.cat(
			Hardline
				.cat(
					chunks
						.wrapped_string_literal_chunk_documents()
						.hardlines(),
				)
				.indent(),
		)
		.cat(Hardline)
		.cat(")".text())


private pure func wrapped_plain_string_literal_document(value: String) -> Doc:
	value
		.string_literal_wrap_chunks()
		.wrapped_plain_string_literal_chunks_document()


private pure func plain_string_literal_value(expr: Expression) -> Option[String]:
	match expr:
		LiteralExpression(StringLiteral(value, flags)):
			if (
				flags.raw
				or flags.multiline
				or not value.string_is_safe_to_wrap_as_plain_literal()
			):
				None
			else:
				Some(value)
		_:
			None


private pure func plain_string_concat_chunks(expr: Expression) -> Option[List[String]]:
	match expr:
		BinaryExpression(AddOp, left, right):
			match left.plain_string_concat_chunks():
				Some(left_chunks):
					match right.plain_string_concat_chunks():
						Some(right_chunks):
							Some(left_chunks.concat(right_chunks))
						None:
							None
				None:
					None
		_:
			match expr.plain_string_literal_value():
				Some(value):
					Some([value])
				None:
					None


private pure func concat_string_chunks(chunks: List[String]) -> String:
	var result: String = ""

	for chunk in chunks:
		result += chunk

	result


private pure func string_concat_wrap_document(expr: Expression) -> Option[Doc]:
	match expr.plain_string_concat_chunks():
		Some(chunks):
			value: String = chunks.concat_string_chunks()

			if chunks.length() > 1 and value.string_literal_can_wrap():
				Some(value.wrapped_plain_string_literal_document())
			else:
				None
		None:
			None


-- A plain string concatenation that renders wrapped already carries its own
-- parentheses. Adding another pair would grow by one pair on every format
-- pass, because the wrapped output parses back as a concatenation operand.
private pure func parenthesized_expression_document(expr: Expression) -> Doc:
	match expr.string_concat_wrap_document():
		Some(document):
			document
		None:
			expr
				.expression_document()
				.parens()


private pure func unary_op_from_json(value: String) -> Result[UnaryOp, String]:
	match value:
		"Neg":
			Ok(NegOp)
		"Not":
			Ok(NotOp)
		_:
			Err("unknown unary operator: " + value)


private pure func binary_op_from_json(value: String) -> Result[BinaryOp, String]:
	match value:
		"Add":
			Ok(AddOp)
		"Sub":
			Ok(SubOp)
		"Mul":
			Ok(MulOp)
		"Div":
			Ok(DivOp)
		"Mod":
			Ok(ModOp)
		"Lt":
			Ok(LtOp)
		"Gt":
			Ok(GtOp)
		"Le":
			Ok(LeOp)
		"Ge":
			Ok(GeOp)
		"Eq":
			Ok(EqOp)
		"Ne":
			Ok(NeOp)
		_:
			Err("unknown binary operator: " + value)


private pure func logical_op_from_json(value: String) -> Result[LogicalOp, String]:
	match value:
		"And":
			Ok(AndOp)
		"Or":
			Ok(OrOp)
		_:
			Err("unknown logical operator: " + value)


private pure func unary_text(op: UnaryOp) -> String:
	match op:
		NegOp:
			"-"
		NotOp:
			"not "


private pure func binary_text(op: BinaryOp) -> String:
	match op:
		AddOp:
			"+"
		SubOp:
			"-"
		MulOp:
			"*"
		DivOp:
			"/"
		ModOp:
			"%"
		LtOp:
			"<"
		GtOp:
			">"
		LeOp:
			"<="
		GeOp:
			">="
		EqOp:
			"=="
		NeOp:
			"!="


private pure func logical_text(op: LogicalOp) -> String:
	match op:
		AndOp:
			"and"
		OrOp:
			"or"


private pure func unary_op_is_neg(op: UnaryOp) -> Bool:
	match op:
		NegOp:
			True
		NotOp:
			False


private pure func logical_ops_equal(left: LogicalOp, right: LogicalOp) -> Bool:
	match left:
		AndOp:
			match right:
				AndOp:
					True
				OrOp:
					False
		OrOp:
			match right:
				AndOp:
					False
				OrOp:
					True


private pure func binary_prec(op: BinaryOp) -> Int:
	match op:
		MulOp:
			7
		DivOp:
			7
		ModOp:
			7
		AddOp:
			6
		SubOp:
			6
		_:
			4


private pure func logical_prec(op: LogicalOp) -> Int:
	match op:
		AndOp:
			2
		OrOp:
			1


private pure func expression_precedence(expr: Expression) -> Int:
	match expr:
		BinaryExpression(op, _, _):
			op.binary_prec()
		LogicalExpression(op, _, _):
			op.logical_prec()
		_:
			100


private pure func postfix_operand_form(expr: Expression) -> PostfixOperandForm:
	match expr:
		BinaryExpression(_, _, _):
			InlineParenthesizedPostfixOperand
		LogicalExpression(_, _, _):
			InlineParenthesizedPostfixOperand
		RangeExpression(_, _):
			InlineParenthesizedPostfixOperand
		UnaryExpression(_, _):
			InlineParenthesizedPostfixOperand
		BlockExpression(_):
			SuiteParenthesizedPostfixOperand
		SpacedBlockExpression(_):
			SuiteParenthesizedPostfixOperand
		ItemBlockExpression(_):
			SuiteParenthesizedPostfixOperand
		ConcurrentExpression(_, _, _):
			SuiteParenthesizedPostfixOperand
		ConcurrentlyLoopExpression(_, _, _, _, _):
			SuiteParenthesizedPostfixOperand
		DebugBlockExpression(_):
			SuiteParenthesizedPostfixOperand
		ForExpression(_, _, _, _):
			SuiteParenthesizedPostfixOperand
		TupleForExpression(_, _, _, _):
			SuiteParenthesizedPostfixOperand
		IfExpression(_, _, _):
			SuiteParenthesizedPostfixOperand
		IfElseExpression(_, _, _, _, _):
			SuiteParenthesizedPostfixOperand
		MatchExpression(_, _, _):
			SuiteParenthesizedPostfixOperand
		SelectExpression(_):
			SuiteParenthesizedPostfixOperand
		WithExpression(_, _, _, _, _, _, _):
			SuiteParenthesizedPostfixOperand
		WhileExpression(_, _, _):
			SuiteParenthesizedPostfixOperand
		LambdaExpression(_, _, body):
			body.trailing_body_postfix_operand_form()
		TypedLambdaExpression(_, _, _, body):
			body.trailing_body_postfix_operand_form()
		DetachExpression(body):
			body.trailing_body_postfix_operand_form()
		_:
			BarePostfixOperand


---
A lambda or `detach` operand ends with its body, which would swallow the postfix
form, so it always needs parentheses; it ends on an indented line when its body
does.
---
private pure func trailing_body_postfix_operand_form(body: Expression) -> PostfixOperandForm:
	match body.postfix_operand_form():
		SuiteParenthesizedPostfixOperand:
			SuiteParenthesizedPostfixOperand
		_:
			InlineParenthesizedPostfixOperand


private pure func postfix_operand_document(expr: Expression) -> Doc:
	match expr.postfix_operand_form():
		BarePostfixOperand:
			expr.expression_document()
		InlineParenthesizedPostfixOperand:
			expr.parenthesized_expression_document()
		SuiteParenthesizedPostfixOperand:
			expr
				.expression_document()
				.parenthesized_indented_document()


private pure func needs_detach_body_parens(expr: Expression) -> Bool:
	match expr:
		AssignmentExpression(_, _):
			True
		SubscriptAssignmentExpression(_, _, _):
			True
		VariableDeclarationExpression(_, _, _):
			True
		TypedVariableDeclarationExpression(_, _, _, _):
			True
		TupleDestructureExpression(_, _):
			True
		QuestionBindExpression(_, _):
			True
		TypedQuestionBindExpression(_, _, _):
			True
		SelectExpression(_):
			True
		BinaryExpression(_, _, _):
			True
		LogicalExpression(_, _, _):
			True
		RangeExpression(_, _):
			True
		_:
			False


private pure func string_flags_from_json(value: JsonValue) -> Result[StringFlags, String]:
	raw ?= value.bool_field("raw")
	multiline ?= value.bool_field("multiline")
	Ok({
		raw = raw,
		multiline = multiline,
	})


pure func literal_from_json(value: JsonValue) -> Result[Literal, String]:
	tag ?= value.string_field("tag")

	match tag:
		"Int":
			raw ?= value.string_field("value")
			Ok(IntLiteral(raw))
		"Int128":
			raw ?= value.string_field("value")
			Ok(Int128Literal(raw))
		"Float":
			raw ?= value.string_field("value")
			Ok(FloatLiteral(raw))
		"String":
			text_value ?= value.string_field("text")
			flags ?= value.string_flags_from_json()
			Ok(StringLiteral(text_value, flags))
		"Bool":
			bool_value ?= value.bool_field("value")
			Ok(BoolLiteral(bool_value))
		"Char":
			code ?= value.int_field("value")
			Ok(CharLiteral(code))
		_:
			Err("unknown literal JSON tag: " + tag)


private pure func literal_field(value: JsonValue, key: String) -> Result[Literal, String]:
	child ?= value.field(key)
	child.literal_from_json()


private pure func pattern_field(value: JsonValue, key: String) -> Result[Pattern, String]:
	child ?= value.field(key)
	child.pattern_from_json()


private pure func expression_field(value: JsonValue, key: String) -> Result[Expression, String]:
	child ?= value.field(key)
	child.expression_from_json()


--- The expression in field `key`, or `None` when the field is absent.
pure func optional_expression_field(
	value: JsonValue,
	key: String,
) -> Result[Option[Expression], String]:
	match value.get_field(key):
		None:
			Ok(None)
		Some(child):
			expr_value ?= child.expression_from_json()
			Ok(Some(expr_value))


private pure func optional_string_field(
	value: JsonValue,
	key: String,
) -> Result[Option[String], String]:
	match value.get_field(key):
		None:
			Ok(None)
		Some(child):
			match child.as_string():
				Some(text_value):
					Ok(Some(text_value))
				None:
					Err("expected formatter JSON field '" + key + "' to be a string")


private pure func bool_array_field(value: JsonValue, key: String) -> Result[List[Bool], String]:
	items ?= value.array_field(key)
	var result: List[Bool] = []
	var error: Option[String] = None

	for item in items:
		match error:
			Some(_):
				void
			None:
				match item.as_bool():
					Some(bool_value):
						result = result.append(bool_value)
					None:
						error = Some(
							"expected formatter JSON field '" + key + "' to be an array of booleans",
						)

	match error:
		Some(msg):
			Err(msg)
		None:
			Ok(result)


private pure func optional_bool_array_field(
	value: JsonValue,
	key: String,
) -> Result[Option[List[Bool]], String]:
	match value.get_field(key):
		None:
			Ok(None)
		Some(_):
			items ?= value.bool_array_field(key)
			Ok(Some(items))


private pure func pattern_array_field(
	value: JsonValue,
	key: String,
) -> Result[List[Pattern], String]:
	value.parsed_array_field(key, pattern_from_json)


--- The function parameters stored in array field `key` of `value`.
pure func function_parameter_array_field(
	value: JsonValue,
	key: String,
) -> Result[List[FunctionParameter], String]:
	value.parsed_array_field(key, function_parameter_from_json)


private pure func string_interpolation_part_array_field(
	value: JsonValue,
	key: String,
) -> Result[List[StringInterpolationPart], String]:
	value.parsed_array_field(key, string_interpolation_part_from_json)


private pure func expression_array_field(
	value: JsonValue,
	key: String,
) -> Result[List[Expression], String]:
	value.parsed_array_field(key, expression_from_json)


private pure func block_items_from_flags(
	exprs: List[Expression],
	flags: List[Bool],
) -> List[(Bool, Expression)]:
	var result: List[(Bool, Expression)] = []
	var index: Int = 0

	for expr in exprs:
		blank_before: Bool = flags.get_or(index, False)
		result = result.append((blank_before, expr))
		index += 1

	result


private pure func block_item_from_json(value: JsonValue) -> Result[BlockItem, String]:
	tag ?= value.string_field("tag")
	blank_before ?= value.bool_field("blank_before")

	match tag:
		"Comment":
			text_value ?= value.string_field("text")
			Ok(BlockCommentItem(blank_before, text_value))
		"Expr":
			expr_value ?= value.expression_field("expr")
			trailing ?= value.optional_string_field("trailing")
			Ok(BlockExpressionItem(blank_before, expr_value, trailing))
		"Expression":
			expr_value ?= value.expression_field("expr")
			trailing ?= value.optional_string_field("trailing")
			Ok(BlockExpressionItem(blank_before, expr_value, trailing))
		_:
			Err("unknown block item JSON tag: " + tag)


private pure func block_item_array_field(
	value: JsonValue,
	key: String,
) -> Result[List[BlockItem], String]:
	value.parsed_array_field(key, block_item_from_json)


private pure func record_expression_field_from_json(
	value: JsonValue,
) -> Result[(String, Expression), String]:
	name ?= value.string_field("name")
	expr ?= value.expression_field("value")
	Ok((name, expr))


private pure func record_expression_fields(
	value: JsonValue,
	key: String,
) -> Result[List[(String, Expression)], String]:
	value.parsed_array_field(key, record_expression_field_from_json)


private pure func dictionary_entry_from_json(
	value: JsonValue,
) -> Result[(Expression, Expression), String]:
	key ?= value.expression_field("key")
	entry_value ?= value.expression_field("value")
	Ok((key, entry_value))


private pure func dictionary_entries(
	value: JsonValue,
	key: String,
) -> Result[List[(Expression, Expression)], String]:
	value.parsed_array_field(key, dictionary_entry_from_json)


pure func pattern_from_json(value: JsonValue) -> Result[Pattern, String]:
	tag ?= value.string_field("tag")

	match tag:
		"Wildcard":
			Ok(WildcardPattern)
		"Var":
			name ?= value.string_field("name")
			Ok(VarPattern(name))
		"Constructor":
			name ?= value.string_field("name")
			args ?= value.pattern_array_field("args")
			Ok(ConstructorPattern(name, args))
		"Literal":
			lit ?= value.literal_field("literal")
			Ok(LiteralPattern(lit))
		"Tuple":
			elems ?= value.pattern_array_field("elems")
			Ok(TuplePattern(elems))
		"Qualified":
			module_name ?= value.string_field("module")
			name ?= value.string_field("name")
			args ?= value.pattern_array_field("args")
			Ok(QualifiedPattern(module_name, name, args))
		"List":
			elems ?= value.pattern_array_field("elems")

			match value.get_field("spread"):
				None:
					Ok(ListPattern(elems))
				Some(spread_value):
					spread ?= spread_value.pattern_from_json()
					Ok(ListSpreadPattern(elems, spread))
		"Or":
			elems ?= value.pattern_array_field("patterns")
			Ok(OrPattern(elems))
		_:
			Err("unknown pattern JSON tag: " + tag)


pure func function_parameter_from_json(value: JsonValue) -> Result[FunctionParameter, String]:
	tag ?= value.string_field("tag")

	match tag:
		"Name":
			name ?= value.string_field("name")
			Ok(NameParam(name))
		"TypedName":
			name ?= value.string_field("name")
			type_expression ?= value.type_expression_field("type")
			Ok(TypedNameParam(name, type_expression))
		"Pattern":
			pattern ?= value.pattern_field("pattern")
			Ok(PatternParam(pattern))
		"TypedPattern":
			pattern ?= value.pattern_field("pattern")
			type_expression ?= value.type_expression_field("type")
			Ok(TypedPatternParam(pattern, type_expression))
		_:
			Err("unknown function parameter JSON tag: " + tag)


pure func string_interpolation_part_from_json(
	value: JsonValue,
) -> Result[StringInterpolationPart, String]:
	tag ?= value.string_field("tag")

	match tag:
		"Text":
			text_value ?= value.string_field("text")
			Ok(StringInterpolationTextPart(text_value))
		"Expr":
			expr_value ?= value.expression_field("expr")
			Ok(StringInterpolationExpressionPart(expr_value))
		_:
			Err("unknown string interpolation part JSON tag: " + tag)


private pure func optional_string_array_field(
	value: JsonValue,
	key: String,
) -> Result[List[String], String]:
	match value.get_field(key):
		None:
			Ok([])
		Some(_):
			value.string_array_field(key)


--- Read a member's `{"leading": [...], "trailing": "..."}` comments; absent means none.
pure func member_comments_field(value: JsonValue, key: String) -> Result[MemberComments, String]:
	match value.get_field(key):
		None:
			Ok({
				leading = [],
				trailing = None,
			})
		Some(comments):
			leading ?= comments.optional_string_array_field("leading")
			trailing ?= comments.optional_string_field("trailing")
			Ok({
				leading = leading,
				trailing = trailing,
			})


private pure func match_case_from_json(value: JsonValue) -> Result[MatchCase, String]:
	pattern ?= value.pattern_field("pattern")
	body ?= value.expression_field("body")
	comments ?= value.member_comments_field("comments")
	Ok(MatchCaseData(pattern, body, comments))


private pure func match_cases(value: JsonValue, key: String) -> Result[List[MatchCase], String]:
	value.parsed_array_field(key, match_case_from_json)


private pure func select_arm_from_json(value: JsonValue) -> Result[SelectArm, String]:
	kind ?= value.string_field("kind")
	body ?= value.expression_field("body")

	match kind:
		"Recv":
			name ?= value.string_field("name")
			channel ?= value.expression_field("channel")
			Ok(SelectRecvArm(name, channel, body))
		"After":
			timeout ?= value.expression_field("timeout")
			Ok(SelectAfterArm(timeout, body))
		"Sealed":
			channel ?= value.expression_field("channel")
			Ok(SelectSealedArm(channel, body))
		_:
			Err("unknown select arm JSON kind: " + kind)


private pure func select_arms(value: JsonValue, key: String) -> Result[List[SelectArm], String]:
	value.parsed_array_field(key, select_arm_from_json)


pure func expression_from_json(value: JsonValue) -> Result[Expression, String]:
	tag ?= value.string_field("tag")

	match tag:
		"Ident":
			name ?= value.string_field("name")
			Ok(IdentifierExpression(name))
		"Literal":
			lit ?= value.literal_field("literal")
			Ok(LiteralExpression(lit))
		"Void":
			Ok(VoidExpression)
		"Break":
			Ok(BreakExpression)
		"Continue":
			Ok(ContinueExpression)
		"Builtin":
			Ok(BuiltinExpression)
		"BuiltinRuntime":
			name ?= value.string_field("name")
			Ok(BuiltinRuntimeExpression(name))
		"FieldAccess":
			receiver ?= value.expression_field("receiver")
			field_name ?= value.string_field("field")
			Ok(FieldAccessExpression(receiver, field_name))
		"Call":
			callee ?= value.expression_field("callee")
			args ?= value.expression_array_field("args")
			Ok(CallExpression(callee, args))
		"OpaqueInto":
			type_expression ?= value.type_expression_field("type")
			inner ?= value.expression_field("value")
			Ok(OpaqueIntoExpression(type_expression, inner))
		"OpaqueFrom":
			type_expression ?= value.type_expression_field("type")
			inner ?= value.expression_field("value")
			Ok(OpaqueFromExpression(type_expression, inner))
		"Unary":
			raw_op ?= value.string_field("op")
			op ?= raw_op.unary_op_from_json()
			inner ?= value.expression_field("expr")
			Ok(UnaryExpression(op, inner))
		"Binary":
			raw_op ?= value.string_field("op")
			op ?= raw_op.binary_op_from_json()
			left ?= value.expression_field("left")
			right ?= value.expression_field("right")
			Ok(BinaryExpression(op, left, right))
		"Logical":
			raw_op ?= value.string_field("op")
			op ?= raw_op.logical_op_from_json()
			left ?= value.expression_field("left")
			right ?= value.expression_field("right")
			Ok(LogicalExpression(op, left, right))
		"Tuple":
			elems ?= value.expression_array_field("elems")
			Ok(TupleExpression(elems))
		"List":
			elems ?= value.expression_array_field("elems")
			Ok(ListExpression(elems))
		"Vector":
			elems ?= value.expression_array_field("elems")
			Ok(VectorExpression(elems))
		"Record":
			fields ?= value.record_expression_fields("fields")
			Ok(RecordExpression(fields))
		"RecordUpdate":
			base ?= value.expression_field("base")
			fields ?= value.record_expression_fields("fields")
			Ok(RecordUpdateExpression(base, fields))
		"Range":
			left ?= value.expression_field("left")
			right ?= value.expression_field("right")
			Ok(RangeExpression(left, right))
		"Subscript":
			target ?= value.expression_field("target")
			index ?= value.expression_field("index")
			Ok(SubscriptExpression(target, index))
		"SubscriptMulti":
			target ?= value.expression_field("target")
			indices ?= value.expression_array_field("indices")
			Ok(MultiSubscriptExpression(target, indices))
		"Dict":
			entries ?= value.dictionary_entries("entries")
			Ok(DictionaryExpression(entries))
		"Assign":
			name ?= value.string_field("name")
			expr ?= value.expression_field("value")
			op ?= value.optional_string_field("op")

			match op:
				Some(op_name):
					binary_op ?= op_name.binary_op_from_json()
					Ok(CompoundAssignmentExpression(name, binary_op, expr))
				None:
					Ok(AssignmentExpression(name, expr))
		"VarDecl":
			name ?= value.string_field("name")
			is_mutable ?= value.bool_field("mutable")
			expr ?= value.expression_field("value")
			type_expression ?= value.optional_type_expression_field("type")

			match type_expression:
				Some(type_expr):
					Ok(TypedVariableDeclarationExpression(name, is_mutable, type_expr, expr))
				None:
					Ok(VariableDeclarationExpression(name, is_mutable, expr))
		"TupleDestruct":
			names ?= value.string_array_field("names")
			expr ?= value.expression_field("value")
			Ok(TupleDestructureExpression(names, expr))
		"SubscriptAssign":
			target ?= value.expression_field("target")
			indices ?= value.expression_array_field("indices")
			expr ?= value.expression_field("value")
			Ok(SubscriptAssignmentExpression(target, indices, expr))
		"QuestionBind":
			name ?= value.string_field("name")
			expr ?= value.expression_field("expr")
			type_expression ?= value.optional_type_expression_field("type")

			match type_expression:
				Some(type_expr):
					Ok(TypedQuestionBindExpression(name, type_expr, expr))
				None:
					Ok(QuestionBindExpression(name, expr))
		"Block":
			exprs ?= value.expression_array_field("exprs")

			match value.get_field("items"):
				Some(_):
					items ?= value.block_item_array_field("items")
					Ok(ItemBlockExpression(items))
				None:
					blank_before ?= value.optional_bool_array_field("blank_before")

					match blank_before:
						Some(flags):
							Ok(SpacedBlockExpression(exprs.block_items_from_flags(flags)))
						None:
							Ok(BlockExpression(exprs))
		"If":
			cond ?= value.expression_field("cond")
			then_expr ?= value.expression_field("then")

			header_comment ?= value.optional_string_field("header_comment")

			match value.get_field("else"):
				None:
					Ok(IfExpression(cond, then_expr, header_comment))
				Some(else_value):
					else_expr ?= else_value.expression_from_json()
					else_comments ?= value.member_comments_field("else_comments")
					Ok(IfElseExpression(cond, then_expr, else_expr, header_comment, else_comments))
		"Match":
			scrutinee ?= value.expression_field("scrutinee")
			cases ?= value.match_cases("cases")
			header_trailing ?= value.optional_string_field("header_comment")
			closing ?= value.optional_string_array_field("closing_comments")
			Ok(
				MatchExpression(
					scrutinee,
					cases,
					{
						header_trailing = header_trailing,
						closing = closing
					},
				),
			)
		"Select":
			arms ?= value.select_arms("arms")
			Ok(SelectExpression(arms))
		"While":
			cond ?= value.expression_field("cond")
			body ?= value.expression_field("body")
			header_comment ?= value.optional_string_field("header_comment")
			Ok(WhileExpression(cond, body, header_comment))
		"For":
			name ?= value.string_field("name")
			iter ?= value.expression_field("iter")
			body ?= value.expression_field("body")
			header_comment ?= value.optional_string_field("header_comment")
			Ok(ForExpression(name, iter, body, header_comment))
		"ForTuple":
			names ?= value.string_array_field("names")
			iter ?= value.expression_field("iter")
			body ?= value.expression_field("body")
			header_comment ?= value.optional_string_field("header_comment")
			Ok(TupleForExpression(names, iter, body, header_comment))
		"With":
			name ?= value.string_field("name")
			type_expression ?= value.optional_type_expression_field("type")
			is_try ?= value.bool_field("try")
			expr ?= value.expression_field("value")
			error_name ?= value.optional_string_field("error_name")
			error_value ?= value.optional_expression_field("error_value")

			error_map_valid ?= match error_name:
				Some(map_name):
					match error_value:
						Some(_):
							Ok(0)
						None:
							Err("With expression has error_name without error_value")
				None:
					match error_value:
						Some(_):
							Err("With expression has error_value without error_name")
						None:
							Ok(0)

			body ?= value.expression_field("body")
			Ok(WithExpression(name, type_expression, is_try, expr, error_name, error_value, body))
		"Lambda":
			is_pure ?= value.bool_field("pure")
			params ?= value.function_parameter_array_field("params")
			body ?= value.expression_field("body")
			return_type ?= value.optional_type_expression_field("return")

			match return_type:
				Some(return_type):
					Ok(TypedLambdaExpression(is_pure, params, return_type, body))
				None:
					Ok(LambdaExpression(is_pure, params, body))
		"FuncDecl":
			name ?= value.string_field("name")
			is_pure ?= value.bool_field("pure")
			type_params ?= value.string_array_field("type_params")
			params ?= value.function_parameter_array_field("params")
			body ?= value.expression_field("body")
			return_type ?= value.optional_type_expression_field("return")
			where_constraints ?= value.type_constraint_array_field_or_empty("where")

			match return_type:
				Some(return_type):
					Ok(
						TypedFunctionDeclarationExpression(
							name,
							is_pure,
							type_params,
							params,
							return_type,
							where_constraints,
							body,
						),
					)
				None:
					Ok(
						FunctionDeclarationExpression(
							name,
							is_pure,
							type_params,
							params,
							where_constraints,
							body,
						),
					)
		"StringInterp":
			parts ?= value.string_interpolation_part_array_field("parts")
			is_multiline ?= value.bool_field("multiline")
			Ok(StringInterpolationExpression(parts, is_multiline))
		"DebugBlock":
			exprs ?= value.expression_array_field("exprs")

			match value.get_field("items"):
				Some(_):
					items ?= value.block_item_array_field("items")
					Ok(DebugBlockExpression(ItemBlockExpression(items)))
				None:
					blank_before ?= value.optional_bool_array_field("blank_before")

					body: Expression = match blank_before:
						Some(flags):
							SpacedBlockExpression(exprs.block_items_from_flags(flags))
						None:
							BlockExpression(exprs)

					Ok(DebugBlockExpression(body))
		"Concurrent":
			bindings ?= value.expression_array_field("bindings")
			timeout ?= value.optional_expression_field("timeout")
			max_threads ?= value.optional_int_field("max_threads")
			Ok(ConcurrentExpression(bindings, timeout, max_threads))
		"ConcurrentBind":
			name ?= value.string_field("name")
			type_expression ?= value.optional_type_expression_field("type")
			body ?= value.expression_field("value")
			Ok(ConcurrentBindExpression(name, type_expression, body))
		"Detach":
			body ?= value.expression_field("body")
			Ok(DetachExpression(body))
		"ConcurrentlyLoop":
			var_name ?= value.string_field("var")
			iter ?= value.expression_field("iter")
			body ?= value.expression_field("body")
			timeout ?= value.optional_expression_field("timeout")
			limit ?= value.optional_int_field("limit")
			width ?= concurrently_loop_width_from_json(limit)
			Ok(ConcurrentlyLoopExpression(var_name, iter, body, timeout, width))
		_:
			Err("unknown expression JSON tag: " + tag)


pure func expression_from_json_string(input: String) -> Result[Expression, String]:
	value ?= input.parse_json()
	value.expression_from_json()


private pure func literal_document(lit: Literal) -> Doc:
	match lit:
		IntLiteral(raw):
			raw.text()
		Int128Literal(raw):
			raw.text()
		FloatLiteral(raw):
			raw.text()
		StringLiteral(value, flags):
			if flags.multiline:
				value.pipe_string_literal_document(flags.raw)
			else if flags.raw:
				("raw\"" + value + "\"").text()
			else if string_literal_renders_wrapped(value, flags):
				value.wrapped_plain_string_literal_document()
			else:
				value.plain_string_literal_document()
		BoolLiteral(value):
			if value:
				"True".text()
			else:
				"False".text()
		CharLiteral(code):
			if code < 128:
				("'" + escape_char_code(code, True) + "'").text()
			else:
				("'" + code.unicode_escape() + "'").text()


pure func pattern_document(pattern: Pattern) -> Doc:
	match pattern:
		WildcardPattern:
			"_".text()
		VarPattern(name):
			name.text()
		ConstructorPattern(name, args):
			if args.length() == 0:
				(name + "()").text()
			else:
				name
					.text()
					.cat("(".text())
					.cat(
						args
							.pattern_document_list()
							.comma_sep(),
					)
					.cat(")".text())
		LiteralPattern(lit):
			lit.literal_document()
		TuplePattern(elems):
			"("
				.text()
				.cat(
					elems
						.pattern_document_list()
						.comma_sep(),
				)
				.cat(")".text())
		QualifiedPattern(module_name, name, args):
			prefix: Doc = module_name
				.text()
				.cat(".".text())
				.cat(name.text())

			if args.length() == 0:
				prefix
			else:
				prefix
					.cat("(".text())
					.cat(
						args
							.pattern_document_list()
							.comma_sep(),
					)
					.cat(")".text())
		ListPattern(elems):
			"["
				.text()
				.cat(
					elems
						.pattern_document_list()
						.comma_sep(),
				)
				.cat("]".text())
		ListSpreadPattern(elems, spread):
			documents: List[Doc] = elems
				.pattern_document_list()
				.append(
					"..."
						.text()
						.cat(spread.pattern_document()),
				)
			"["
				.text()
				.cat(documents.comma_sep())
				.cat("]".text())
		OrPattern(elems):
			" | "
				.text()
				.intersperse(elems.pattern_document_list())


private pure func pattern_document_list(patterns: List[Pattern]) -> List[Doc]:
	var documents: List[Doc] = []

	for pattern in patterns:
		documents = documents.append(pattern.pattern_document())

	documents


private pure func expression_document_list(exprs: List[Expression]) -> List[Doc]:
	var documents: List[Doc] = []

	for expr in exprs:
		documents = documents.append(expr.expression_document())

	documents


private pure func trailing_comma_documents(documents: List[Doc]) -> List[Doc]:
	var result: List[Doc] = []

	for document in documents:
		result = result.append(document.cat(",".text()))

	result


private pure func logical_chain_terms(expr: Expression, op: LogicalOp) -> List[Expression]:
	match expr:
		LogicalExpression(inner_op, left, right):
			if logical_ops_equal(inner_op, op):
				left
					.logical_chain_terms(op)
					.concat(right.logical_chain_terms(op))
			else:
				[expr]
		_:
			[expr]


private pure func logical_term_document(expr: Expression, op: LogicalOp) -> Doc:
	if expr.expression_precedence() < op.logical_prec():
		expr
			.expression_document()
			.parens()
	else:
		expr.expression_document()


private pure func logical_condition_term_documents(
	terms: List[Expression],
	op: LogicalOp,
) -> List[Doc]:
	var documents: List[Doc] = []
	var index: Int = 0

	for term in terms:
		term_document: Doc = term.logical_term_document(op)

		if index == 0:
			documents = documents.append(term_document)
		else:
			documents = documents.append(
				op
					.logical_text()
					.text()
					.cat(" ".text())
					.cat(term_document),
			)

		index += 1

	documents


private pure func logical_expression_flat_document(terms: List[Expression], op: LogicalOp) -> Doc:
	match terms:
		[]:
			"".text()
		[first, ...rest]:
			var document: Doc = first.logical_term_document(op)

			for term in rest:
				document = document
					.cat(" ".text())
					.cat(
						op
							.logical_text()
							.text(),
					)
					.cat(" ".text())
					.cat(term.logical_term_document(op))

			document


-- Ordinary expression continuations cannot start with `and`/`or` unless the
-- chain is explicitly grouped. Keep broken logical chains parenthesized.
private pure func logical_expression_broken_document(terms: List[Expression], op: LogicalOp) -> Doc:
	"("
		.text()
		.cat(
			Hardline
				.cat(
					terms
						.logical_condition_term_documents(op)
						.hardlines(),
				)
				.indent(),
		)
		.cat(Hardline)
		.cat(")".text())


private pure func logical_term_prefers_multiline_value(expr: Expression) -> Bool:
	match expr:
		CallExpression(_, _):
			expr.expression_is_multistep_ufcs_chain()
		UnaryExpression(_, inner):
			inner.logical_term_prefers_multiline_value()
		BinaryExpression(_, left, right):
			(
				left.logical_term_prefers_multiline_value()
				or right.logical_term_prefers_multiline_value()
			)
		LogicalExpression(op, _, _):
			expr
				.logical_chain_terms(op)
				.logical_terms_prefer_multiline_value()
		CommentedLogicalExpression(_, _):
			True
		OpaqueIntoExpression(_, inner):
			inner.logical_term_prefers_multiline_value()
		OpaqueFromExpression(_, inner):
			inner.logical_term_prefers_multiline_value()
		_:
			False


private pure func logical_terms_prefer_multiline_value(terms: List[Expression]) -> Bool:
	var prefers_multiline: Bool = False

	for term in terms:
		if term.logical_term_prefers_multiline_value():
			prefers_multiline = True
			break

	prefers_multiline


-- The flat layout writes ` <op> <next>` straight after the previous term, so a
-- term that renders with block syntax has to be the last one. Anywhere else the
-- operator lands inside that term's block, and the result no longer parses.
private pure func logical_terms_require_broken_layout(terms: List[Expression]) -> Bool:
	last_index: Int = terms.length() - 1
	var index: Int = 0
	var requires_broken: Bool = False

	for term in terms:
		if index < last_index and term.expression_renders_with_block_syntax():
			requires_broken = True
			break

		index += 1

	requires_broken


private pure func logical_expression_document(expr: Expression, op: LogicalOp) -> Doc:
	terms: List[Expression] = expr.logical_chain_terms(op)

	match terms:
		[]:
			expr.expression_document()
		[_]:
			terms.logical_expression_flat_document(op)
		_:
			if (
				terms.logical_terms_prefer_multiline_value()
				or terms.logical_terms_require_broken_layout()
			):
				terms.logical_expression_broken_document(op)
			else:
				terms
					.logical_expression_broken_document(op)
					.if_break(terms.logical_expression_flat_document(op))
					.group()


---
A logical chain with comments among its terms, one term per line inside
parentheses, the layout of a broken chain in a value or a block header.
---
private pure func commented_logical_expression_document(
	op: LogicalOp,
	terms: List[CommentedItem[Expression]],
) -> Doc:
	var lines: List[Doc] = []
	var index: Int = 0

	for term in terms:
		term_document: Doc = term.item.logical_term_document(op)

		operator_document: Doc = if index == 0:
			term_document
		else:
			op
				.logical_text()
				.text()
				.cat(" ".text())
				.cat(term_document)

		lines = lines.append(commented_member_document(operator_document, "".text(), term.comments))
		index += 1

	lines
		.hardlines()
		.parenthesized_indented_document()


--- `(`, then the document indented on its own lines, then `)` on a line of its own.
private pure func parenthesized_indented_document(document: Doc) -> Doc:
	"("
		.text()
		.cat(
			Hardline
				.cat(document)
				.indent(),
		)
		.cat(Hardline)
		.cat(")".text())


private pure func logical_block_header_expression_document(
	terms: List[Expression],
	op: LogicalOp,
) -> Doc:
	terms
		.logical_condition_term_documents(op)
		.hardlines()
		.parenthesized_indented_document()


private pure func expression_pair_prefers_multiline_block_header(
	left: Expression,
	right: Expression,
) -> Bool:
	(
		left.expression_prefers_multiline_block_header()
		or right.expression_prefers_multiline_block_header()
	)


private pure func expression_list_prefers_multiline_block_header(exprs: List[Expression]) -> Bool:
	var prefers_multiline: Bool = False

	for expr in exprs:
		if expr.expression_prefers_multiline_block_header():
			prefers_multiline = True
			break

	prefers_multiline


private pure func named_expression_list_prefers_multiline_block_header(
	items: List[(String, Expression)],
) -> Bool:
	var prefers_multiline: Bool = False

	for item in items:
		if item[1].expression_prefers_multiline_block_header():
			prefers_multiline = True
			break

	prefers_multiline


private pure func expression_entry_list_prefers_multiline_block_header(
	items: List[(Expression, Expression)],
) -> Bool:
	var prefers_multiline: Bool = False

	for item in items:
		if expression_pair_prefers_multiline_block_header(item[0], item[1]):
			prefers_multiline = True
			break

	prefers_multiline


private pure func expression_prefers_multiline_block_header(expr: Expression) -> Bool:
	if expr.expression_has_block():
		True
	else:
		match expr:
			FieldAccessExpression(receiver, _):
				receiver.expression_prefers_multiline_block_header()
			CallExpression(callee, args):
				(
					callee.expression_prefers_multiline_block_header()
					or args.expression_list_prefers_multiline_block_header()
				)
			UnaryExpression(_, inner):
				inner.expression_prefers_multiline_block_header()
			BinaryExpression(_, left, right):
				expression_pair_prefers_multiline_block_header(left, right)
			LogicalExpression(op, _, _):
				terms: List[Expression] = expr.logical_chain_terms(op)
				terms.block_header_terms_prefer_multiline()
			TupleExpression(elems):
				elems.expression_list_prefers_multiline_block_header()
			ListExpression(elems):
				elems.expression_list_prefers_multiline_block_header()
			VectorExpression(elems):
				elems.expression_list_prefers_multiline_block_header()
			RecordExpression(fields):
				fields.named_expression_list_prefers_multiline_block_header()
			RecordUpdateExpression(base, fields):
				(
					base.expression_prefers_multiline_block_header()
					or fields.named_expression_list_prefers_multiline_block_header()
				)
			OpaqueIntoExpression(_, inner):
				inner.expression_prefers_multiline_block_header()
			OpaqueFromExpression(_, inner):
				inner.expression_prefers_multiline_block_header()
			RangeExpression(start_expr, end_expr):
				expression_pair_prefers_multiline_block_header(start_expr, end_expr)
			SubscriptExpression(target, index):
				expression_pair_prefers_multiline_block_header(target, index)
			MultiSubscriptExpression(target, indices):
				(
					target.expression_prefers_multiline_block_header()
					or indices.expression_list_prefers_multiline_block_header()
				)
			DictionaryExpression(entries):
				entries.expression_entry_list_prefers_multiline_block_header()
			_:
				False


private pure func block_header_terms_prefer_multiline(terms: List[Expression]) -> Bool:
	var prefers_multiline: Bool = False

	for term in terms:
		if term.expression_prefers_multiline_block_header():
			prefers_multiline = True
			break

	prefers_multiline


private pure func block_header_expression_document(expr: Expression) -> Doc:
	match expr:
		CommentedLogicalExpression(op, terms):
			commented_logical_expression_document(op, terms)
		LogicalExpression(op, _, _):
			terms: List[Expression] = expr.logical_chain_terms(op)

			if terms.length() > 2 or terms.block_header_terms_prefer_multiline():
				terms.logical_block_header_expression_document(op)
			else:
				expr.expression_document()
		_:
			if expr.expression_prefers_multiline_block_header():
				expr
					.expression_document()
					.parenthesized_indented_document()
			else:
				expr.expression_document()


private pure func is_breakable_call_callee(expr: Expression) -> Bool:
	match expr:
		IdentifierExpression(_):
			True
		FieldAccessExpression(_, _):
			True
		_:
			False


private pure func expression_list_should_use_block_call_arguments(args: List[Expression]) -> Bool:
	has_multiple_args: Bool = args.length() >= 2
	has_callback_shape: Bool = args.length() >= 3 and args.expression_list_has_inline_lambda()
	has_multiline_arg: Bool = args.expression_list_prefers_multiline_call_argument()
	has_multiple_args and (has_callback_shape or has_multiline_arg)


private pure func expression_list_should_use_nested_block_call_arguments(
	args: List[Expression],
) -> Bool:
	(
		args.expression_list_should_use_block_call_arguments()
		or args.length() >= 2 and args.expression_list_has_inline_lambda()
	)


-- This bypasses forced call-complexity hardlines so nested call arguments keep
-- a real flat alternative for parent group decisions.
private pure func compact_call_expression_document(
	callee: Expression,
	args: List[Expression],
) -> Doc:
	callee
		.expression_document()
		.cat(args.grouped_call_arguments_document())


private pure func call_argument_document(expr: Expression) -> Doc:
	match expr:
		CallExpression(callee, args):
			if (
				args.length() == 1
				and args.expression_list_has_inline_lambda()
				and callee.is_breakable_call_callee()
			):
				callee
					.expression_document()
					.cat(args.block_call_arguments_document())
			else if (
				args.expression_list_should_use_nested_block_call_arguments()
				and callee.is_breakable_call_callee()
			):
				callee
					.expression_document()
					.cat(args.block_call_arguments_document())
			else if args.length() >= 2 and callee.is_breakable_call_callee():
				flat_document: Doc = compact_call_expression_document(callee, args)

				broken_arguments: Doc = if args.expression_list_has_nontrivial_call_argument():
					args.outer_only_block_call_arguments_document()
				else:
					args.block_call_arguments_document()

				broken_document: Doc = callee
					.expression_document()
					.cat(broken_arguments)
				broken_document.if_break(flat_document)
			else:
				expr.expression_document()
		_:
			expr.expression_document()


private pure func call_argument_documents(exprs: List[Expression]) -> List[Doc]:
	var documents: List[Doc] = []

	for expr in exprs:
		documents = documents.append(expr.call_argument_document())

	documents


private pure func expression_is_block_lambda(expr: Expression) -> Bool:
	match expr:
		LambdaExpression(_, _, body):
			body.is_block_expression()
		TypedLambdaExpression(_, _, _, body):
			body.is_block_expression()
		_:
			False


private pure func expression_is_inline_lambda(expr: Expression) -> Bool:
	match expr:
		LambdaExpression(_, _, body):
			not body.is_block_expression()
		TypedLambdaExpression(_, _, _, body):
			not body.is_block_expression()
		_:
			False


private pure func expression_list_has_trailing_block_lambda(exprs: List[Expression]) -> Bool:
	match exprs.get(exprs.length() - 1):
		Some(last):
			last.expression_is_block_lambda()
		None:
			False


private pure func expression_list_has_block_lambda(exprs: List[Expression]) -> Bool:
	var has_lambda: Bool = False

	for expr in exprs:
		if expr.expression_is_block_lambda():
			has_lambda = True
			break

	has_lambda


private pure func expression_list_has_inline_lambda(exprs: List[Expression]) -> Bool:
	var has_lambda: Bool = False

	for expr in exprs:
		if expr.expression_is_inline_lambda():
			has_lambda = True
			break

	has_lambda


private pure func expression_is_call_with_single_inline_lambda_argument(expr: Expression) -> Bool:
	match expr:
		CallExpression(_, args):
			match args:
				[arg]:
					arg.expression_is_inline_lambda()
				_:
					False
		_:
			False


private pure func expression_list_is_single_call_with_inline_lambda_argument(
	args: List[Expression],
) -> Bool:
	match args:
		[arg]:
			arg.expression_is_call_with_single_inline_lambda_argument()
		_:
			False


private pure func trailing_block_lambda_call_arguments_document(args: List[Expression]) -> Doc:
	last_idx: Int = args.length() - 1
	var index: Int = 0
	var leading_documents: List[Doc] = []
	var last_document: Doc = "".text()

	for arg in args:
		if index == last_idx:
			last_document = arg.expression_document()
		else:
			leading_documents = leading_documents.append(arg.expression_document())

		index += 1

	var leading_part: Doc = "".text()

	if leading_documents.length() != 0:
		leading_part = leading_documents
			.comma_sep()
			.cat(", ".text())

	open_document: Doc = "(".text()
	open_document
		.cat(leading_part)
		.cat(last_document)
		.cat(Hardline)
		.cat(")".text())


private pure func block_lambda_call_arguments_document(args: List[Expression]) -> Doc:
	var result: Doc = "(".text()
	var index: Int = 0

	for arg in args:
		if index == 0:
			result = result.cat(arg.expression_document())
		else:
			result = result
				.cat(Hardline)
				.cat(", ".text())
				.cat(arg.expression_document())

		index += 1

	result.cat(")".text())


private pure func expression_list_has_block(exprs: List[Expression]) -> Bool:
	var has_block: Bool = False

	for expr in exprs:
		if expr.expression_has_block():
			has_block = True
			break

	has_block


private pure func expression_renders_with_block_syntax(expr: Expression) -> Bool:
	match expr:
		BlockExpression(_):
			True
		SpacedBlockExpression(_):
			True
		ItemBlockExpression(_):
			True
		IfExpression(_, _, _):
			True
		IfElseExpression(_, _, _, _, _):
			True
		MatchExpression(_, _, _):
			True
		SelectExpression(_):
			True
		WhileExpression(_, _, _):
			True
		ForExpression(_, _, _, _):
			True
		TupleForExpression(_, _, _, _):
			True
		WithExpression(_, _, _, _, _, _, _):
			True
		DebugBlockExpression(_):
			True
		ConcurrentExpression(_, _, _):
			True
		ConcurrentlyLoopExpression(_, _, _, _, _):
			True
		LambdaExpression(_, _, body):
			body.is_block_expression()
		TypedLambdaExpression(_, _, _, body):
			body.is_block_expression()
		FunctionDeclarationExpression(_, _, _, _, _, _):
			True
		TypedFunctionDeclarationExpression(_, _, _, _, _, _, _):
			True
		_:
			False


private pure func expression_pair_list_has_block(items: List[(String, Expression)]) -> Bool:
	var has_block: Bool = False

	for item in items:
		if item[1].expression_has_block():
			has_block = True
			break

	has_block


private pure func dictionary_entries_prefer_multiline_call_argument(
	entries: List[(Expression, Expression)],
) -> Bool:
	var found: Bool = False

	for entry in entries:
		key_prefers_multiline: Bool = entry[0].expression_prefers_multiline_call_argument()
		value_prefers_multiline: Bool = entry[1].expression_prefers_multiline_call_argument()

		if key_prefers_multiline or value_prefers_multiline:
			found = True
			break

	found


private pure func expression_pair_prefers_multiline_call_argument(
	left: Expression,
	right: Expression,
) -> Bool:
	(
		left.expression_prefers_multiline_call_argument()
		or right.expression_prefers_multiline_call_argument()
	)


private pure func expression_pair_list_prefers_multiline_call_argument(
	items: List[(String, Expression)],
) -> Bool:
	var found: Bool = False

	for item in items:
		if item[1].expression_prefers_multiline_call_argument():
			found = True
			break

	found


private pure func expression_list_prefers_multiline_call_argument(exprs: List[Expression]) -> Bool:
	var found: Bool = False

	for expr in exprs:
		if expr.expression_prefers_multiline_call_argument():
			found = True
			break

	found


private pure func expression_is_nontrivial_call_argument(expr: Expression) -> Bool:
	match expr:
		CallExpression(callee, args):
			method_call_with_args: Bool = match callee:
				FieldAccessExpression(_, _):
					args.length() > 0
				_:
					False

			args.length() > 1 or method_call_with_args or expr.expression_is_multistep_ufcs_chain()
		OpaqueIntoExpression(_, inner):
			inner.expression_is_nontrivial_call_argument()
		OpaqueFromExpression(_, inner):
			inner.expression_is_nontrivial_call_argument()
		_:
			False


private pure func expression_list_has_nontrivial_call_argument(exprs: List[Expression]) -> Bool:
	if exprs.length() <= 1:
		False
	else:
		var found: Bool = False

		for expr in exprs:
			if expr.expression_is_nontrivial_call_argument():
				found = True
				break

		found


private pure func record_update_prefers_multiline_call_argument(
	base: Expression,
	fields: List[(String, Expression)],
) -> Bool:
	base_prefers_multiline: Bool = base.expression_prefers_multiline_call_argument()
	update_prefers_multiline: Bool = fields.record_update_expression_prefers_multiline()
	field_prefers_multiline: Bool = fields.expression_pair_list_prefers_multiline_call_argument()
	base_prefers_multiline or update_prefers_multiline or field_prefers_multiline


private pure func expression_prefers_multiline_call_argument(expr: Expression) -> Bool:
	if expr.expression_renders_with_block_syntax():
		True
	else:
		match expr:
			LiteralExpression(StringLiteral(value, flags)):
				flags.multiline or string_literal_renders_wrapped(value, flags)
			StringInterpolationExpression(_, is_multiline):
				is_multiline
			BinaryExpression(AddOp, left, right):
				match expr.string_concat_wrap_document():
					Some(_):
						True
					None:
						expression_pair_prefers_multiline_call_argument(left, right)
			BinaryExpression(_, left, right):
				expression_pair_prefers_multiline_call_argument(left, right)
			LogicalExpression(_, left, right):
				expression_pair_prefers_multiline_call_argument(left, right)
			CallExpression(_, args):
				args.expression_list_should_use_block_call_arguments()
			TupleExpression(elems):
				elems.expression_list_prefers_multiline_call_argument()
			ListExpression(elems):
				elems.length() > 1 or elems.expression_list_prefers_multiline_call_argument()
			VectorExpression(elems):
				elems.length() > 1 or elems.expression_list_prefers_multiline_call_argument()
			RecordExpression(fields):
				(
					fields.record_expression_prefers_multiline()
					or fields.expression_pair_list_prefers_multiline_call_argument()
				)
			RecordUpdateExpression(base, fields):
				record_update_prefers_multiline_call_argument(base, fields)
			DictionaryExpression(entries):
				entries.length() > 1 or entries.dictionary_entries_prefer_multiline_call_argument()
			OpaqueIntoExpression(_, inner):
				inner.expression_prefers_multiline_call_argument()
			OpaqueFromExpression(_, inner):
				inner.expression_prefers_multiline_call_argument()
			RangeExpression(start_expr, end_expr):
				expression_pair_prefers_multiline_call_argument(start_expr, end_expr)
			SubscriptExpression(target, index):
				expression_pair_prefers_multiline_call_argument(target, index)
			MultiSubscriptExpression(target, indices):
				(
					target.expression_prefers_multiline_call_argument()
					or indices.expression_list_prefers_multiline_call_argument()
				)
			_:
				False


private pure func call_expression_has_block_or_forced_multiline(
	expr: Expression,
	args: List[Expression],
) -> Bool:
	has_chain: Bool = expr.expression_is_multistep_ufcs_chain()
	has_block_arg: Bool = args.expression_list_has_block()
	has_forced_multiline_arg: Bool = args.expression_list_should_use_block_call_arguments()
	has_chain or has_block_arg or has_forced_multiline_arg


private pure func expression_is_ufcs_call(expr: Expression) -> Bool:
	match expr:
		CallExpression(FieldAccessExpression(_, _), _):
			True
		_:
			False


private pure func expression_is_multistep_ufcs_chain(expr: Expression) -> Bool:
	match expr:
		CallExpression(FieldAccessExpression(receiver, _), _):
			receiver.expression_is_ufcs_call()
		_:
			False


private pure func expression_has_block(expr: Expression) -> Bool:
	if expr.expression_renders_with_block_syntax():
		True
	else:
		match expr:
			CommentedCollectionExpression(_, _):
				True
			CommentedLogicalExpression(_, _):
				True
			CallExpression(_, args):
				call_expression_has_block_or_forced_multiline(expr, args)
			TupleExpression(elems):
				(
					elems.expression_list_has_block()
					or elems.expression_list_prefers_multiline_call_argument()
				)
			ListExpression(elems):
				(
					elems.expression_list_has_block()
					or elems.expression_list_prefers_multiline_call_argument()
				)
			VectorExpression(elems):
				(
					elems.expression_list_has_block()
					or elems.expression_list_prefers_multiline_call_argument()
				)
			RecordExpression(fields):
				(
					fields.expression_pair_list_has_block()
					or fields.expression_pair_list_prefers_multiline_call_argument()
				)
			RecordUpdateExpression(_, fields):
				(
					fields.expression_pair_list_has_block()
					or fields.expression_pair_list_prefers_multiline_call_argument()
				)
			_:
				False


private pure func expression_is_non_lambda_block(expr: Expression) -> Bool:
	match expr:
		LambdaExpression(_, _, _):
			False
		TypedLambdaExpression(_, _, _, _):
			False
		_:
			expr.expression_has_block()


private pure func expression_list_has_non_lambda_block(exprs: List[Expression]) -> Bool:
	var has_block: Bool = False

	for expr in exprs:
		if expr.expression_is_non_lambda_block():
			has_block = True
			break

	has_block


private simple_numeric_collection_inline_limit: Int = 8

private simple_numeric_collection_inline_char_limit: Int = 80

private compact_call_collection_item_limit: Int = 3

private compact_call_collection_char_limit: Int = 60


private pure func literal_compact_inline_width(lit: Literal) -> Option[Int]:
	match lit:
		IntLiteral(raw):
			Some(raw.length())
		Int128Literal(raw):
			Some(raw.length())
		FloatLiteral(raw):
			Some(raw.length())
		StringLiteral(value, flags):
			if flags.multiline or string_literal_renders_wrapped(value, flags):
				None
			else if flags.raw:
				Some(value.length() + 5)
			else:
				Some(value
						.escape_string_value()
						.length() + 2)
		BoolLiteral(value):
			if value:
				Some(4)
			else:
				Some(5)
		CharLiteral(code):
			Some(escape_char_code(code, True).length() + 2)


private pure func literal_numeric_width(lit: Literal) -> Option[Int]:
	match lit:
		IntLiteral(raw):
			Some(raw.length())
		Int128Literal(raw):
			Some(raw.length())
		FloatLiteral(raw):
			Some(raw.length())
		_:
			None


private pure func expression_simple_numeric_width(expr: Expression) -> Option[Int]:
	match expr:
		LiteralExpression(lit):
			lit.literal_numeric_width()
		UnaryExpression(NegOp, LiteralExpression(lit)):
			match lit.literal_numeric_width():
				Some(width):
					Some(width + 1)
				None:
					None
		_:
			None


private pure func expression_is_simple_numeric(expr: Expression) -> Bool:
	match expr.expression_simple_numeric_width():
		Some(_):
			True
		None:
			False


private pure func expression_list_is_simple_numeric(exprs: List[Expression]) -> Bool:
	if exprs.length() == 0:
		False
	else:
		var all_numeric: Bool = True

		for expr in exprs:
			if not expr.expression_is_simple_numeric():
				all_numeric = False
				break

		all_numeric


private pure func expression_list_simple_numeric_inline_width(
	exprs: List[Expression],
	open_text: String,
	close_text: String,
) -> Option[Int]:
	if exprs.length() == 0:
		None
	else:
		var total: Int = open_text.length() + close_text.length()
		var index: Int = 0
		var valid: Bool = True

		for expr in exprs:
			match expr.expression_simple_numeric_width():
				Some(width):
					if index > 0:
						total += 2

					total += width
				None:
					valid = False
					break

			index += 1

		if valid:
			Some(total)
		else:
			None


private pure func expression_list_is_compact_simple_numeric(
	exprs: List[Expression],
	open_text: String,
	close_text: String,
) -> Bool:
	if exprs.length() > simple_numeric_collection_inline_limit:
		False
	else:
		match exprs.expression_list_simple_numeric_inline_width(open_text, close_text):
			Some(width):
				width <= simple_numeric_collection_inline_char_limit
			None:
				False


private pure func is_tuple_index_field(field: String) -> Bool:
	match field.parse_int():
		Some(index):
			index >= 0
		None:
			False


private pure func expression_compact_inline_width(expr: Expression) -> Option[Int]:
	match expr:
		IdentifierExpression(name):
			Some(name.length())
		LiteralExpression(lit):
			lit.literal_compact_inline_width()
		BuiltinRuntimeExpression(name):
			Some(name
					.escape_string_value()
					.length() + 11)
		FieldAccessExpression(receiver, field):
			match receiver.expression_compact_inline_width():
				Some(width):
					if field.is_tuple_index_field():
						Some(width + field.length() + 2)
					else:
						Some(width + field.length() + 1)
				None:
					None
		CallExpression(callee, args):
			match callee.expression_compact_inline_width():
				Some(callee_width):
					match args.expression_list_compact_inline_width("(", ")"):
						Some(args_width):
							Some(callee_width + args_width)
						None:
							None
				None:
					None
		UnaryExpression(NegOp, inner):
			match inner.expression_compact_inline_width():
				Some(width):
					Some(width + 1)
				None:
					None
		TupleExpression(elems):
			elems.expression_list_compact_inline_width("(", ")")
		ListExpression(elems):
			elems.expression_list_compact_inline_width("[", "]")
		VectorExpression(elems):
			elems.expression_list_compact_inline_width("{", "}")
		_:
			None


private pure func expression_list_compact_inline_width(
	exprs: List[Expression],
	open_text: String,
	close_text: String,
) -> Option[Int]:
	var total: Int = open_text.length() + close_text.length()
	var index: Int = 0
	var valid: Bool = True

	for expr in exprs:
		match expr.expression_compact_inline_width():
			Some(width):
				if index > 0:
					total += 2

				total += width
			None:
				valid = False
				break

		index += 1

	if valid:
		Some(total)
	else:
		None


private pure func expression_list_is_compact_call_collection(
	exprs: List[Expression],
	open_text: String,
	close_text: String,
) -> Bool:
	if exprs.length() > compact_call_collection_item_limit:
		False
	else:
		match exprs.expression_list_compact_inline_width(open_text, close_text):
			Some(width):
				width <= compact_call_collection_char_limit
			None:
				False


private pure func expression_list_is_compact_collection_argument(
	exprs: List[Expression],
	open_text: String,
	close_text: String,
) -> Bool:
	if exprs.expression_list_is_compact_simple_numeric(open_text, close_text):
		True
	else:
		exprs.expression_list_is_compact_call_collection(open_text, close_text)


private pure func block_call_argument_documents_with_nested_policy(
	args: List[Expression],
	expand_nested_calls: Bool,
) -> List[Doc]:
	var documents: List[Doc] = []
	last_index: Int = args.length() - 1
	var index: Int = 0

	for arg in args:
		if arg.expression_renders_with_block_syntax():
			arg_document: Doc = arg.expression_document()

			if index == last_index:
				documents = documents.append(arg_document)
			else:
				documents = documents.append(
					arg_document
						.cat(Hardline)
						.cat(",".text()),
				)
		else:
			arg_document: Doc = if expand_nested_calls:
				arg.call_argument_document()
			else:
				arg.expression_document()

			documents = documents.append(arg_document.cat(",".text()))

		index += 1

	documents


private pure func block_call_argument_documents(args: List[Expression]) -> List[Doc]:
	args.block_call_argument_documents_with_nested_policy(True)


private pure func block_call_arguments_document(args: List[Expression]) -> Doc:
	"("
		.text()
		.cat(
			Hardline
				.cat(
					args
						.block_call_argument_documents()
						.hardlines(),
				)
				.indent(),
		)
		.cat(Hardline)
		.cat(")".text())


private pure func outer_only_block_call_arguments_document(args: List[Expression]) -> Doc:
	"("
		.text()
		.cat(
			Hardline
				.cat(
					args
						.block_call_argument_documents_with_nested_policy(False)
						.hardlines(),
				)
				.indent(),
		)
		.cat(Hardline)
		.cat(")".text())


private pure func delimited_collection_call_arguments_document(
	open_text: String,
	close_text: String,
	items: List[Doc],
) -> Doc:
	"("
		.text()
		.cat(open_text.text())
		.cat(
			Hardline
				.cat(
					items
						.trailing_comma_documents()
						.hardlines(),
				)
				.indent(),
		)
		.cat(Hardline)
		.cat(close_text.text())
		.cat(")".text())


private pure func dictionary_entries_have_block(entries: List[(Expression, Expression)]) -> Bool:
	var has_block: Bool = False

	for entry in entries:
		if entry[0].expression_has_block() or entry[1].expression_has_block():
			has_block = True
			break

	has_block


private pure func collection_call_arguments_document(args: List[Expression]) -> Option[Doc]:
	match args:
		[ListExpression(elems)]:
			if elems.expression_list_is_compact_collection_argument("[", "]"):
				None
			else if elems.length() > 1 or elems.expression_list_has_block():
				Some(
					delimited_collection_call_arguments_document(
						"[",
						"]",
						elems.expression_document_list(),
					),
				)
			else:
				None
		[VectorExpression(elems)]:
			if elems.expression_list_is_compact_collection_argument("{", "}"):
				None
			else if elems.length() > 1 or elems.expression_list_has_block():
				Some(
					delimited_collection_call_arguments_document(
						"{",
						"}",
						elems.expression_document_list(),
					),
				)
			else:
				None
		[DictionaryExpression(entries)]:
			if entries.length() > 1 or entries.dictionary_entries_have_block():
				Some(
					delimited_collection_call_arguments_document(
						"{",
						"}",
						entries.dictionary_entry_documents(),
					),
				)
			else:
				None
		[RecordExpression(fields)]:
			if fields.record_expression_prefers_multiline():
				Some(
					delimited_collection_call_arguments_document(
						"{",
						"}",
						fields.record_field_documents(),
					),
				)
			else:
				None
		_:
			None


private pure func expression_list_is_multiline_collection_call_arguments(
	args: List[Expression],
) -> Bool:
	match args:
		[ListExpression(elems)]:
			if elems.expression_list_is_compact_collection_argument("[", "]"):
				False
			else:
				elems.length() > 1 or elems.expression_list_has_block()
		[VectorExpression(elems)]:
			if elems.expression_list_is_compact_collection_argument("{", "}"):
				False
			else:
				elems.length() > 1 or elems.expression_list_has_block()
		[DictionaryExpression(entries)]:
			entries.length() > 1 or entries.dictionary_entries_have_block()
		[RecordExpression(fields)]:
			fields.record_expression_prefers_multiline()
		_:
			False


private pure func expression_list_contains_multiline_collection_call_arg(
	exprs: List[Expression],
) -> Bool:
	var found: Bool = False

	for expr in exprs:
		if expr.expression_contains_multiline_collection_call_arg():
			found = True
			break

	found


private pure func expression_contains_multiline_collection_call_arg(expr: Expression) -> Bool:
	match expr:
		FieldAccessExpression(receiver, _):
			receiver.expression_contains_multiline_collection_call_arg()
		CallExpression(callee, args):
			callee_has_multiline_call: Bool = callee.expression_contains_multiline_collection_call_arg()
			args_are_multiline_collection: Bool = args.expression_list_is_multiline_collection_call_arguments()
			args_contain_multiline_call: Bool = args.expression_list_contains_multiline_collection_call_arg()

			(
				callee_has_multiline_call
				or args_are_multiline_collection
				or args_contain_multiline_call
			)
		UnaryExpression(_, inner):
			inner.expression_contains_multiline_collection_call_arg()
		BinaryExpression(_, left, right):
			left_has_multiline_call: Bool = left.expression_contains_multiline_collection_call_arg()
			right_has_multiline_call: Bool = right.expression_contains_multiline_collection_call_arg()
			left_has_multiline_call or right_has_multiline_call
		LogicalExpression(_, left, right):
			left_has_multiline_call: Bool = left.expression_contains_multiline_collection_call_arg()
			right_has_multiline_call: Bool = right.expression_contains_multiline_collection_call_arg()
			left_has_multiline_call or right_has_multiline_call
		TupleExpression(elems):
			elems.expression_list_contains_multiline_collection_call_arg()
		ListExpression(elems):
			elems.expression_list_contains_multiline_collection_call_arg()
		VectorExpression(elems):
			elems.expression_list_contains_multiline_collection_call_arg()
		OpaqueIntoExpression(_, inner):
			inner.expression_contains_multiline_collection_call_arg()
		OpaqueFromExpression(_, inner):
			inner.expression_contains_multiline_collection_call_arg()
		RangeExpression(start_expr, end_expr):
			start_has_multiline_call: Bool = start_expr.expression_contains_multiline_collection_call_arg()
			end_has_multiline_call: Bool = end_expr.expression_contains_multiline_collection_call_arg()
			start_has_multiline_call or end_has_multiline_call
		SubscriptExpression(target, index):
			target_has_multiline_call: Bool = target.expression_contains_multiline_collection_call_arg()
			index_has_multiline_call: Bool = index.expression_contains_multiline_collection_call_arg()
			target_has_multiline_call or index_has_multiline_call
		MultiSubscriptExpression(target, indices):
			target_has_multiline_call: Bool = target.expression_contains_multiline_collection_call_arg()
			index_has_multiline_call: Bool = indices.expression_list_contains_multiline_collection_call_arg()
			target_has_multiline_call or index_has_multiline_call
		_:
			False


private pure func single_argument_contains_multiline_collection_call_arg(
	args: List[Expression],
) -> Bool:
	match args:
		[arg]:
			arg.expression_contains_multiline_collection_call_arg()
		_:
			False


private pure func single_argument_without_extra_indent_document(args: List[Expression]) -> Doc:
	match args:
		[arg]:
			"("
				.text()
				.cat(arg.call_argument_document())
				.cat(")".text())
		_:
			args.grouped_call_arguments_document()


private pure func vector_rank_expression(expr: Expression) -> Int:
	match expr:
		VectorExpression(elems):
			elems.vector_rank_elems()
		_:
			0


private pure func vector_rank_elems(elems: List[Expression]) -> Int:
	if elems.length() == 0:
		1
	else:
		child_rank: Int = match elems.get(0):
			Some(first):
				first.vector_rank_expression()
			None:
				0

		if child_rank > 0:
			var same_rank: Bool = True

			for elem in elems:
				if elem.vector_rank_expression() != child_rank:
					same_rank = False
					break

			if same_rank:
				child_rank + 1
			else:
				1
		else:
			1


private pure func vector_row_document(elems: List[Expression]) -> Doc:
	"{"
		.text()
		.cat(
			Softline
				.cat(
					elems
						.expression_document_list()
						.comma_sep_break(),
				)
				.indent(),
		)
		.cat(Softline)
		.cat("}".text())
		.group()


private pure func shaped_vector_item_document(expr: Expression) -> Doc:
	match expr:
		VectorExpression(elems):
			if elems.vector_rank_elems() >= 2:
				elems.shaped_vector_document()
			else:
				elems.vector_row_document()
		_:
			expr.expression_document()


private pure func shaped_vector_item_documents(elems: List[Expression]) -> List[Doc]:
	var documents: List[Doc] = []

	for elem in elems:
		documents = documents.append(
			elem
				.shaped_vector_item_document()
				.cat(",".text()),
		)

	documents


private pure func shaped_vector_document(elems: List[Expression]) -> Doc:
	"{"
		.text()
		.cat(
			Hardline
				.cat(
					elems
						.shaped_vector_item_documents()
						.hardlines(),
				)
				.indent(),
		)
		.cat(Hardline)
		.cat("}".text())


private pure func vector_literal_document(elems: List[Expression]) -> Doc:
	if elems.vector_rank_elems() >= 2 and not elems.expression_list_has_block():
		elems.shaped_vector_document()
	else:
		bracketed_expression_document("{", "}", elems)


private pure func bracketed_expression_document(
	open_text: String,
	close_text: String,
	exprs: List[Expression],
) -> Doc:
	if exprs.expression_list_is_simple_numeric():
		if exprs.expression_list_is_compact_simple_numeric(open_text, close_text):
			open_text
				.text()
				.cat(
					exprs
						.expression_document_list()
						.comma_sep(),
				)
				.cat(close_text.text())
		else:
			open_text
				.text()
				.cat(
					Hardline
						.cat(
							exprs
								.expression_document_list()
								.comma_sep_break(),
						)
						.indent(),
				)
				.cat(Hardline)
				.cat(close_text.text())
	else if exprs.expression_list_has_block():
		open_text
			.text()
			.cat(
				Hardline
					.cat(
						exprs
							.expression_document_list()
							.trailing_comma_documents()
							.hardlines(),
					)
					.indent(),
			)
			.cat(Hardline)
			.cat(close_text.text())
	else:
		open_text
			.text()
			.cat(
				Softline
					.cat(
						exprs
							.expression_document_list()
							.comma_sep_break(),
					)
					.indent(),
			)
			.cat(Softline)
			.cat(close_text.text())
			.group()


private pure func list_expression_document(elems: List[Expression]) -> Doc:
	if elems.expression_list_prefers_multiline_call_argument():
		"["
			.text()
			.cat(
				Hardline
					.cat(
						elems
							.expression_document_list()
							.trailing_comma_documents()
							.hardlines(),
					)
					.indent(),
			)
			.cat(Hardline)
			.cat("]".text())
	else:
		bracketed_expression_document("[", "]", elems)


private pure func inline_tuple_expression_document(elems: List[Expression]) -> Doc:
	"("
		.text()
		.cat(
			elems
				.expression_document_list()
				.comma_sep(),
		)
		.cat(")".text())


-- Keep a flat tuple's optional indent from leaking into nested collection-call
-- hardlines, e.g. `("error", JsonObject([ ... ]))`.
private pure func tuple_expression_document(elems: List[Expression]) -> Doc:
	if elems.expression_list_has_trailing_block_lambda():
		last_index: Int = elems.length() - 1
		var index: Int = 0
		var leading_documents: List[Doc] = []
		var last_document: Doc = "".text()

		for elem in elems:
			if index == last_index:
				last_document = elem.expression_document()
			else:
				leading_documents = leading_documents.append(elem.expression_document())

			index += 1

		var leading_part: Doc = "".text()

		if leading_documents.length() != 0:
			leading_part = leading_documents
				.comma_sep()
				.cat(", ".text())

		open_document: Doc = "(".text()
		open_document
			.cat(leading_part)
			.cat(last_document)
			.cat(Hardline)
			.cat(")".text())
	else if elems.expression_list_contains_multiline_collection_call_arg():
		elems.inline_tuple_expression_document()
	else:
		bracketed_expression_document("(", ")", elems)


private pure func grouped_call_arguments_document(args: List[Expression]) -> Doc:
	"("
		.text()
		.cat(
			Softline
				.cat(
					args
						.call_argument_documents()
						.comma_sep_break(),
				)
				.indent(),
		)
		.cat(Softline)
		.cat(")".text())
		.group()


private pure func opaque_conversion_value_document(inner: Expression) -> Doc:
	"("
		.text()
		.cat(
			Softline
				.cat(inner.expression_document())
				.indent(),
		)
		.cat(Softline)
		.cat(")".text())
		.group()


private pure func call_arguments_document(args: List[Expression]) -> Doc:
	if args.length() == 0:
		"()".text()
	else if args.expression_list_has_trailing_block_lambda():
		args.trailing_block_lambda_call_arguments_document()
	else if args.expression_list_has_block_lambda():
		args.block_lambda_call_arguments_document()
	else if args.expression_list_is_single_call_with_inline_lambda_argument():
		args.single_argument_without_extra_indent_document()
	else if args.single_argument_contains_multiline_collection_call_arg():
		args.single_argument_without_extra_indent_document()
	else:
		match args.collection_call_arguments_document():
			Some(doc):
				doc
			None:
				if (
					args.expression_list_has_non_lambda_block()
					or args.expression_list_should_use_block_call_arguments()
				):
					args.block_call_arguments_document()
				else if args.expression_list_has_nontrivial_call_argument():
					args.outer_only_block_call_arguments_document()
				else:
					args.grouped_call_arguments_document()


private pure func collect_ufcs_chain(receiver: Expression, steps: List[UfcsStep]) -> UfcsChain:
	match receiver:
		CallExpression(FieldAccessExpression(inner, method_name), method_args):
			inner.collect_ufcs_chain([
					{
						name = method_name,
						args = method_args
					},
				].concat(steps))
		_:
			{
				receiver = receiver,
				steps = steps
			}


private pure func ufcs_steps_document(steps: List[UfcsStep]) -> Doc:
	var result: Doc = "".text()

	for step in steps:
		result = result
			.cat(Hardline)
			.cat(".".text())
			.cat(step.name.text())
			.cat(step.args.call_arguments_document())

	result


private pure func ufcs_chain_document(callee: Expression, args: List[Expression]) -> Option[Doc]:
	match callee:
		FieldAccessExpression(receiver, method_name):
			chain: UfcsChain = receiver.collect_ufcs_chain(
				[
					{
						name = method_name,
						args = args
					},
				],
			)

			if chain.steps.length() >= 2:
				Some(
					chain.receiver
						.postfix_operand_document()
						.cat(
							chain.steps
								.ufcs_steps_document()
								.indent(),
						),
				)
			else:
				None
		_:
			None


private pure func inline_lambda_call_document(callee: Expression, args: List[Expression]) -> Doc:
	if args.expression_list_should_use_block_call_arguments():
		callee
			.postfix_operand_document()
			.cat(args.block_call_arguments_document())
	else:
		callee
			.postfix_operand_document()
			.cat("(".text())
			.cat(
				Softline
					.cat(
						args
							.call_argument_documents()
							.comma_sep_break(),
					)
					.indent(),
			)
			.cat(Softline)
			.cat(")".text())
			.group()


---
A collection broken one item per line: each item after its leading comments,
followed by its comma and the comment ending its line, then the whole-line
comments after the last item.
---
private pure func commented_items_document[T](
	open_text: String,
	close_text: String,
	items: List[CommentedItem[T]],
	item_document: pure (T) -> Doc,
	last_item_comma: LastItemComma,
	closing: List[String],
) -> Doc:
	var lines: List[Doc] = []
	last_index: Int = items.length() - 1
	var index: Int = 0

	for commented in items:
		comma: Doc = if index < last_index or last_item_comma == CommaAfterLastItem:
			",".text()
		else:
			"".text()

		lines = lines.append(
			commented_member_document(
				item_document(commented.item),
				comma,
				commented.comments,
			),
		)
		index += 1

	for comment in closing:
		lines = lines.append(comment.text())

	open_text
		.text()
		.cat(
			Hardline
				.cat(lines.hardlines())
				.indent(),
		)
		.cat(Hardline)
		.cat(close_text.text())


private pure func commented_collection_document(
	collection: CommentedCollection,
	closing: List[String],
) -> Doc:
	match collection:
		CommentedCall(callee, args):
			callee
				.postfix_operand_document()
				.cat(
					commented_items_document(
						"(",
						")",
						args,
						func(arg): arg.expression_document(),
						CommaAfterLastItem,
						closing,
					),
				)
		CommentedSubscript(target, indices):
			target
				.postfix_operand_document()
				.cat(
					commented_items_document(
						"[",
						"]",
						indices,
						func(index): index.expression_document(),
						CommaAfterLastItem,
						closing,
					),
				)
		CommentedList(elems):
			commented_items_document(
				"[",
				"]",
				elems,
				func(elem): elem.expression_document(),
				CommaAfterLastItem,
				closing,
			)
		CommentedTuple(elems):
			commented_items_document(
				"(",
				")",
				elems,
				func(elem): elem.expression_document(),
				CommaAfterLastItem,
				closing,
			)
		CommentedVector(elems):
			commented_items_document(
				"{",
				"}",
				elems,
				func(elem): elem.expression_document(),
				CommaAfterLastItem,
				closing,
			)
		CommentedRecord(fields):
			commented_items_document(
				"{",
				"}",
				fields,
				func(field_value): field_value.record_field_document(),
				NoCommaAfterLastItem,
				closing,
			)
		CommentedRecordUpdate(base, fields):
			"{ "
				.text()
				.cat(base.expression_document())
				.cat(
					commented_items_document(
						" |",
						"}",
						fields,
						func(field_value): field_value.record_field_document(),
						NoCommaAfterLastItem,
						closing,
					),
				)
		CommentedDictionary(entries):
			commented_items_document(
				"{",
				"}",
				entries,
				func(entry): entry.dictionary_entry_document(),
				CommaAfterLastItem,
				closing,
			)


private pure func record_field_document(field_value: (String, Expression)) -> Doc:
	field_value[0]
		.text()
		.cat(" = ".text())
		.cat(field_value[1].expression_document())


private pure func record_field_documents(fields: List[(String, Expression)]) -> List[Doc]:
	var documents: List[Doc] = []

	for field_value in fields:
		documents = documents.append(field_value.record_field_document())

	documents


private pure func record_expression_prefers_multiline(fields: List[(String, Expression)]) -> Bool:
	fields.length() > 1


private pure func record_update_expression_prefers_multiline(
	fields: List[(String, Expression)],
) -> Bool:
	fields.length() > 1


private pure func record_expression_document(fields: List[(String, Expression)]) -> Doc:
	if fields.record_expression_prefers_multiline():
		"{"
			.text()
			.cat(
				Hardline
					.cat(
						fields
							.record_field_documents()
							.comma_hardline_documents(),
					)
					.indent(),
			)
			.cat(Hardline)
			.cat("}".text())
	else:
		"{"
			.text()
			.cat(
				Softline
					.cat(
						fields
							.record_field_documents()
							.comma_sep_break(),
					)
					.indent(),
			)
			.cat(Softline)
			.cat("}".text())
			.group()


private pure func record_update_expression_document(
	base: Expression,
	fields: List[(String, Expression)],
) -> Doc:
	match fields:
		[]:
			"{ "
				.text()
				.cat(base.expression_document())
				.cat(" | }".text())
		[field]:
			"{ "
				.text()
				.cat(base.expression_document())
				.cat(" |".text())
				.cat(
					SoftlineSpace
						.cat(field.record_field_document())
						.indent(),
				)
				.cat(SoftlineSpace)
				.cat("}".text())
				.group()
		_:
			"{ "
				.text()
				.cat(base.expression_document())
				.cat(" |".text())
				.cat(
					Hardline
						.cat(
							fields
								.record_field_documents()
								.comma_hardline_documents(),
						)
						.indent(),
				)
				.cat(Hardline)
				.cat("}".text())


private pure func dictionary_entry_document(entry: (Expression, Expression)) -> Doc:
	entry[0]
		.expression_document()
		.cat(" => ".text())
		.cat(entry[1].expression_document())


private pure func dictionary_entry_documents(entries: List[(Expression, Expression)]) -> List[Doc]:
	var documents: List[Doc] = []

	for entry in entries:
		documents = documents.append(entry.dictionary_entry_document())

	documents


private pure func dictionary_expression_document(entries: List[(Expression, Expression)]) -> Doc:
	if entries.dictionary_entries_have_block():
		"{"
			.text()
			.cat(
				Hardline
					.cat(
						entries
							.dictionary_entry_documents()
							.trailing_comma_documents()
							.hardlines(),
					)
					.indent(),
			)
			.cat(Hardline)
			.cat("}".text())
	else:
		"{"
			.text()
			.cat(
				Softline
					.cat(
						entries
							.dictionary_entry_documents()
							.comma_sep_break(),
					)
					.indent(),
			)
			.cat(Softline)
			.cat("}".text())
			.group()


private pure func assign_document(name: String, value: Expression) -> Doc:
	match value:
		BinaryExpression(op, IdentifierExpression(left_name), rhs):
			if left_name == name and op.is_compound_assign_op():
				name
					.text()
					.cat(" ".text())
					.cat(
						op
							.compound_assign_text()
							.text(),
					)
					.cat(" ".text())
					.cat(rhs.expression_document())
			else:
				name
					.text()
					.cat(" =".assignment_value_document(value))
		_:
			name
				.text()
				.cat(" =".assignment_value_document(value))


private pure func is_compound_assign_op(op: BinaryOp) -> Bool:
	match op:
		AddOp:
			True
		SubOp:
			True
		MulOp:
			True
		DivOp:
			True
		_:
			False


private pure func compound_assign_text(op: BinaryOp) -> String:
	match op:
		AddOp:
			"+="
		SubOp:
			"-="
		MulOp:
			"*="
		DivOp:
			"/="
		_:
			"="


private pure func compound_assign_document(name: String, op: BinaryOp, value: Expression) -> Doc:
	name
		.text()
		.cat(" ".text())
		.cat(
			op
				.compound_assign_text()
				.text(),
		)
		.cat(" ".text())
		.cat(value.expression_document())


private pure func variable_declaration_document(
	name: String,
	is_mutable: Bool,
	type_expression: Option[TypeExpression],
	value: Expression,
) -> Doc:
	prefix: Doc = if is_mutable:
		"var ".text()
	else:
		"".text()

	type_document_part: Doc = match type_expression:
		Some(type_expr):
			": "
				.text()
				.cat(type_expr.type_document())
		None:
			"".text()

	prefix
		.cat(name.text())
		.cat(type_document_part)
		.cat(" =".assignment_value_document(value))


private pure func question_bind_document(
	name: String,
	type_expression: Option[TypeExpression],
	value: Expression,
) -> Doc:
	type_document_part: Doc = match type_expression:
		Some(type_expr):
			": "
				.text()
				.cat(type_expr.type_document())
		None:
			"".text()

	name
		.text()
		.cat(type_document_part)
		.cat(" ?= ".text())
		.cat(value.expression_document())


pure func is_block_expression(expr: Expression) -> Bool:
	match expr:
		BlockExpression(_):
			True
		SpacedBlockExpression(_):
			True
		ItemBlockExpression(_):
			True
		_:
			False


private pure func is_paragraph_control_expression(expr: Expression) -> Bool:
	match expr:
		IfExpression(_, _, _):
			True
		IfElseExpression(_, _, _, _, _):
			True
		MatchExpression(_, _, _):
			True
		WhileExpression(_, _, _):
			True
		ForExpression(_, _, _, _):
			True
		TupleForExpression(_, _, _, _):
			True
		WithExpression(_, _, _, _, _, _, _):
			True
		DebugBlockExpression(_):
			True
		ConcurrentExpression(_, _, _):
			True
		ConcurrentlyLoopExpression(_, _, _, _, _):
			True
		AssignmentExpression(_, value):
			value.is_paragraph_control_expression()
		CompoundAssignmentExpression(_, _, value):
			value.is_paragraph_control_expression()
		VariableDeclarationExpression(_, _, value):
			value.is_paragraph_control_expression()
		TypedVariableDeclarationExpression(_, _, _, value):
			value.is_paragraph_control_expression()
		TupleDestructureExpression(_, value):
			value.is_paragraph_control_expression()
		SubscriptAssignmentExpression(_, _, value):
			value.is_paragraph_control_expression()
		QuestionBindExpression(_, value):
			value.is_paragraph_control_expression()
		TypedQuestionBindExpression(_, _, value):
			value.is_paragraph_control_expression()
		ConcurrentBindExpression(_, _, value):
			value.is_paragraph_control_expression()
		_:
			False


private pure func expression_block_separator(
	previous: Expression,
	current: Expression,
	blank_before: Bool,
) -> Doc:
	if (
		blank_before
		or previous.is_paragraph_control_expression()
		or current.is_paragraph_control_expression()
	):
		Hardline.cat(Hardline)
	else:
		Hardline


private pure func block_expressions_document(exprs: List[Expression]) -> Doc:
	var result: Doc = "".text()
	var first: Bool = True
	var previous_expr: Option[Expression] = None

	for expr in exprs:
		item_document: Doc = expr.expression_document()

		if first:
			result = item_document
			first = False
		else:
			separator: Doc = match previous_expr:
				Some(previous):
					previous.expression_block_separator(expr, False)
				None:
					Hardline

			result = result
				.cat(separator)
				.cat(item_document)

		previous_expr = Some(expr)

	result


private pure func spaced_block_expressions_document(items: List[(Bool, Expression)]) -> Doc:
	var result: Doc = "".text()
	var first: Bool = True
	var previous_expr: Option[Expression] = None

	for item in items:
		expr: Expression = item[1]
		item_document: Doc = expr.expression_document()

		if first:
			result = item_document
			first = False
		else:
			separator: Doc = match previous_expr:
				Some(previous):
					previous.expression_block_separator(expr, item[0])
				None:
					Hardline

			result = result
				.cat(separator)
				.cat(item_document)

		previous_expr = Some(expr)

	result


private pure func trailing_text_document(trailing: Option[String]) -> Doc:
	match trailing:
		Some(text_value):
			text_value.line_suffix()
		None:
			"".text()


private pure func block_item_document(item: BlockItem) -> Doc:
	match item:
		BlockCommentItem(_, text_value):
			text_value.text()
		BlockExpressionItem(_, expr, trailing):
			expr
				.expression_document()
				.cat(trailing.trailing_text_document())


private pure func block_item_blank_before(item: BlockItem) -> Bool:
	match item:
		BlockCommentItem(blank_before, _):
			blank_before
		BlockExpressionItem(blank_before, _, _):
			blank_before


private pure func block_item_is_comment(item: BlockItem) -> Bool:
	match item:
		BlockCommentItem(_, _):
			True
		BlockExpressionItem(_, _, _):
			False


private pure func block_item_is_paragraph_control(item: BlockItem) -> Bool:
	match item:
		BlockCommentItem(_, _):
			False
		BlockExpressionItem(_, expr, _):
			expr.is_paragraph_control_expression()


private pure func next_expression_is_paragraph_control(
	items: List[BlockItem],
	start_index: Int,
) -> Bool:
	var result: Bool = False
	var done: Bool = False
	var index: Int = start_index + 1

	while not done and index < items.length():
		match items.get(index):
			Some(item):
				match item:
					BlockCommentItem(_, _):
						index += 1
					BlockExpressionItem(_, expr, _):
						result = expr.is_paragraph_control_expression()
						done = True
			None:
				done = True

	result


private pure func block_item_separator(
	previous: BlockItem,
	current: BlockItem,
	next_expr_is_control: Bool,
) -> Doc:
	if (
		current.block_item_blank_before()
		or previous.block_item_is_paragraph_control()
		or current.block_item_is_paragraph_control() and not previous.block_item_is_comment()
		or (
			current.block_item_is_comment()
			and not previous.block_item_is_comment()
			and next_expr_is_control
		)
	):
		Hardline.cat(Hardline)
	else:
		Hardline


private pure func block_items_document(items: List[BlockItem]) -> Doc:
	var result: Doc = "".text()
	var first: Bool = True
	var previous_item: Option[BlockItem] = None
	var index: Int = 0

	for item in items:
		item_document: Doc = item.block_item_document()

		if first:
			result = item_document
			first = False
		else:
			next_expr_is_control: Bool = items.next_expression_is_paragraph_control(index)

			separator: Doc = match previous_item:
				Some(previous):
					previous.block_item_separator(item, next_expr_is_control)
				None:
					Hardline

			result = result
				.cat(separator)
				.cat(item_document)

		previous_item = Some(item)
		index += 1

	result


pure func block_body_document(expr: Expression) -> Doc:
	match expr:
		BlockExpression(exprs):
			exprs.block_expressions_document()
		SpacedBlockExpression(items):
			items.spaced_block_expressions_document()
		ItemBlockExpression(items):
			items.block_items_document()
		_:
			expr.expression_document()


--- Whole-line comments, each followed by a line break.
private pure func comment_lines_document(comments: List[String]) -> Doc:
	var result: Doc = "".text()

	for comment in comments:
		result = result
			.cat(comment.text())
			.cat(Hardline)

	result


---
A control-flow header after its keyword prefix, such as `if cond:`, with the
comment ending the header line, and its indented body.
---
private pure func headed_block_document(
	prefix: Doc,
	header: Expression,
	header_comment: Option[String],
	body: Expression,
) -> Doc:
	prefix
		.cat(header.block_header_expression_document())
		.cat(":".text())
		.cat(header_comment.trailing_text_document())
		.cat(
			Hardline
				.cat(body.block_body_document())
				.indent(),
		)


---
Wrap a member with its comments: each leading comment on its own line above
it, and the trailing comment deferred to the end of the member's first line.
---
pure func commented_member_document(
	member_head: Doc,
	member_rest: Doc,
	comments: MemberComments,
) -> Doc:
	comments.leading
		.comment_lines_document()
		.cat(member_head)
		.cat(comments.trailing.trailing_text_document())
		.cat(member_rest)


private pure func match_case_document(case_value: MatchCase) -> Doc:
	match case_value:
		MatchCaseData(pattern, body, comments):
			head: Doc = pattern
				.pattern_document()
				.cat(":".text())
			body_document: Doc = Hardline
				.cat(body.block_body_document())
				.indent()
			commented_member_document(head, body_document, comments)


private pure func match_case_documents(cases: List[MatchCase]) -> List[Doc]:
	var documents: List[Doc] = []

	for case_value in cases:
		documents = documents.append(case_value.match_case_document())

	documents


private pure func select_arm_document(arm: SelectArm) -> Doc:
	match arm:
		SelectRecvArm(name, channel, body):
			name
				.text()
				.cat(" from ".text())
				.cat(channel.expression_document())
				.cat(":".text())
				.cat(
					Hardline
						.cat(body.block_body_document())
						.indent(),
				)
		SelectAfterArm(timeout, body):
			"_ after "
				.text()
				.cat(timeout.expression_document())
				.cat(":".text())
				.cat(
					Hardline
						.cat(body.block_body_document())
						.indent(),
				)
		SelectSealedArm(channel, body):
			"sealed "
				.text()
				.cat(channel.expression_document())
				.cat(":".text())
				.cat(
					Hardline
						.cat(body.block_body_document())
						.indent(),
				)


private pure func select_arm_documents(arms: List[SelectArm]) -> List[Doc]:
	var documents: List[Doc] = []

	for arm in arms:
		documents = documents.append(arm.select_arm_document())

	documents


pure func function_parameter_document(param: FunctionParameter) -> Doc:
	match param:
		NameParam(name):
			name.text()
		TypedNameParam(name, type_expression):
			name
				.text()
				.cat(": ".text())
				.cat(type_expression.type_document())
		PatternParam(pattern):
			pattern.pattern_document()
		TypedPatternParam(pattern, type_expression):
			pattern
				.pattern_document()
				.cat(": ".text())
				.cat(type_expression.type_document())
		CommentedParam(inner, _, _):
			inner.function_parameter_document()


pure func function_parameter_documents(params: List[FunctionParameter]) -> List[Doc]:
	var documents: List[Doc] = []

	for param in params:
		documents = documents.append(param.function_parameter_document())

	documents


private pure func function_parameter_documents_with_commas(
	params: List[FunctionParameter],
) -> List[Doc]:
	var documents: List[Doc] = []

	for param in params:
		match param:
			CommentedParam(inner, comments, after):
				documents = documents.append(
					commented_member_document(
						inner.function_parameter_document(),
						",".text(),
						comments,
					),
				)

				for comment in after:
					documents = documents.append(comment.text())
			_:
				documents = documents.append(
					param
						.function_parameter_document()
						.cat(",".text()),
				)

	documents


private pure func function_parameter_flat_length(param: FunctionParameter) -> Int:
	1000
		.layout(param.function_parameter_document())
		.trim_right()
		.length()


private pure func function_parameter_contains_function_type(param: FunctionParameter) -> Bool:
	match param:
		TypedNameParam(_, type_expression):
			type_expression.type_expression_contains_function()
		TypedPatternParam(_, type_expression):
			type_expression.type_expression_contains_function()
		CommentedParam(inner, _, _):
			inner.function_parameter_contains_function_type()
		_:
			False


private pure func function_parameters_contain_function_type(
	params: List[FunctionParameter],
) -> Bool:
	var contains: Bool = False

	for param in params:
		if param.function_parameter_contains_function_type():
			contains = True
			break

	contains


private pure func function_parameters_have_comments(params: List[FunctionParameter]) -> Bool:
	var found: Bool = False

	for param in params:
		match param:
			CommentedParam(_, _, _):
				found = True
				break
			_:
				void

	found


private pure func should_force_multiline_parameters(params: List[FunctionParameter]) -> Bool:
	if params.function_parameters_have_comments():
		True
	else if params.length() > 1 and params.function_parameters_contain_function_type():
		True
	else if params.length() <= 3:
		False
	else:
		var should_force: Bool = False

		for param in params:
			if param.function_parameter_flat_length() > 12:
				should_force = True
				break

		should_force


private pure func multiline_function_parameters_document(params: List[FunctionParameter]) -> Doc:
	match params:
		[]:
			"()".text()
		_:
			"("
				.text()
				.cat(
					Hardline
						.cat(
							params
								.function_parameter_documents_with_commas()
								.hardlines(),
						)
						.indent(),
				)
				.cat(Hardline)
				.cat(")".text())


private pure func grouped_function_parameters_document(params: List[FunctionParameter]) -> Doc:
	"("
		.text()
		.cat(
			Softline
				.cat(
					params
						.function_parameter_documents()
						.comma_sep_break(),
				)
				.indent(),
		)
		.cat(Softline)
		.cat(")".text())
		.group()


pure func function_parameters_document(params: List[FunctionParameter]) -> Doc:
	if params.should_force_multiline_parameters():
		params.multiline_function_parameters_document()
	else:
		params.grouped_function_parameters_document()


private pure func lambda_document(
	is_pure: Bool,
	params: List[FunctionParameter],
	return_type: Option[TypeExpression],
	body: Expression,
) -> Doc:
	prefix: Doc = if is_pure:
		"pure ".text()
	else:
		"".text()

	head: Doc = prefix
		.cat("func".text())
		.cat(params.function_parameters_document())
		.cat(return_type.return_type_document())

	match body:
		BlockExpression(_):
			head
				.cat(":".text())
				.cat(
					Hardline
						.cat(body.block_body_document())
						.indent(),
				)
		SpacedBlockExpression(_):
			head
				.cat(":".text())
				.cat(
					Hardline
						.cat(body.block_body_document())
						.indent(),
				)
		ItemBlockExpression(_):
			head
				.cat(":".text())
				.cat(
					Hardline
						.cat(body.block_body_document())
						.indent(),
				)
		_:
			head
				.cat(": ".text())
				.cat(body.expression_document())


private pure func function_declaration_document(
	name: String,
	is_pure: Bool,
	type_params: List[String],
	params: List[FunctionParameter],
	return_type: Option[TypeExpression],
	where_constraints: List[TypeConstraint],
	body: Expression,
) -> Doc:
	prefix: Doc = if is_pure:
		"pure ".text()
	else:
		"".text()

	prefix
		.cat("func ".text())
		.cat(name.text())
		.cat(type_params.type_params_document())
		.cat(params.function_parameters_document())
		.cat(return_type.return_type_document())
		.cat(where_constraints.where_constraints_document())
		.cat(":".text())
		.cat(
			Hardline
				.cat(body.block_body_document())
				.indent(),
		)


private pure func concurrent_params_document(
	timeout: Option[Expression],
	max_threads: Option[Int],
) -> Doc:
	match max_threads:
		Some(thread_count):
			match timeout:
				Some(timeout_expr):
					"(max_threads: "
						.text()
						.cat(
							thread_count
								.to_string()
								.text(),
						)
						.cat(", timeout: ".text())
						.cat(timeout_expr.expression_document())
						.cat(")".text())
				None:
					("(max_threads: " + thread_count.to_string() + ")").text()
		None:
			match timeout:
				Some(timeout_expr):
					"(timeout: "
						.text()
						.cat(timeout_expr.expression_document())
						.cat(")".text())
				None:
					"".text()


private pure func concurrently_loop_width_from_json(
	limit: Option[Int],
) -> Result[ConcurrentlyLoopWidth, String]:
	match limit:
		Some(limit_count):
			Ok(ConcurrentlyLoopLimit(limit_count))
		None:
			Err("ConcurrentlyLoop requires a limit field")


private pure func concurrently_params_document(timeout: Option[Expression], limit: Int) -> Doc:
	match timeout:
		Some(timeout_expr):
			"(limit: "
				.text()
				.cat(
					limit
						.to_string()
						.text(),
				)
				.cat(", timeout: ".text())
				.cat(timeout_expr.expression_document())
				.cat(")".text())
		None:
			("(limit: " + limit.to_string() + ")").text()


private pure func concurrently_loop_head_document(
	var_name: String,
	iter: Expression,
	timeout: Option[Expression],
	width: ConcurrentlyLoopWidth,
) -> Doc:
	match width:
		ConcurrentlyLoopLimit(limit):
			"for "
				.text()
				.cat(var_name.text())
				.cat(" in ".text())
				.cat(iter.expression_document())
				.cat(" concurrently".text())
				.cat(concurrently_params_document(timeout, limit))
				.cat(":".text())


private pure func concurrent_bind_document(
	name: String,
	type_expression: Option[TypeExpression],
	value: Expression,
) -> Doc:
	ty_document: Doc = match type_expression:
		Some(type_expr):
			": "
				.text()
				.cat(type_expr.type_document())
		None:
			"".text()

	name
		.text()
		.cat(ty_document)
		.cat(" = ".text())
		.cat(value.expression_document())


private pure func with_type_suffix_document(type_expression: Option[TypeExpression]) -> Doc:
	match type_expression:
		Some(type_expr):
			": "
				.text()
				.cat(type_expr.type_document())
		None:
			"".text()


private pure func with_operator_document(is_try: Bool) -> Doc:
	if is_try:
		" ?= ".text()
	else:
		" = ".text()


private pure func with_error_map_document(
	error_name: Option[String],
	error_value: Option[Expression],
) -> Doc:
	match error_name:
		Some(mapper_name):
			match error_value:
				Some(mapper_value):
					" on "
						.text()
						.cat(mapper_name.text())
						.cat(" => ".text())
						.cat(mapper_value.expression_document())
				None:
					"".text()
		None:
			"".text()


private pure func with_expression_document(
	name: String,
	type_expression: Option[TypeExpression],
	is_try: Bool,
	value: Expression,
	error_name: Option[String],
	error_value: Option[Expression],
	body: Expression,
) -> Doc:
	"with "
		.text()
		.cat(name.text())
		.cat(type_expression.with_type_suffix_document())
		.cat(is_try.with_operator_document())
		.cat(value.expression_document())
		.cat(with_error_map_document(error_name, error_value))
		.cat(":".text())
		.cat(
			Hardline
				.cat(body.block_body_document())
				.indent(),
		)


-- An interpolated expression has to stay on one line: the `${...}` that holds it
-- is part of a string literal, and neither a plain nor a pipe literal can carry
-- a break inside one. Forced breaks such as the leading-dot chain layout would
-- produce source that no longer lexes, so render the expression flat.
private pure func interpolated_expression_document(value: Expression) -> Doc:
	"$"
		.text()
		.cat("{".text())
		.cat(
			value
				.expression_document()
				.render_flat()
				.text(),
		)
		.cat("}".text())


private pure func string_interpolation_part_document(
	part: StringInterpolationPart,
	is_multiline: Bool,
) -> Doc:
	match part:
		StringInterpolationTextPart(value):
			escaped: String = if is_multiline:
				value.escape_multiline_string_value()
			else:
				value.escape_string_value()

			escaped.text()
		StringInterpolationExpressionPart(value):
			value.interpolated_expression_document()


private pure func string_interpolation_part_documents(
	parts: List[StringInterpolationPart],
	is_multiline: Bool,
) -> List[Doc]:
	var documents: List[Doc] = []

	for part in parts:
		documents = documents.append(part.string_interpolation_part_document(is_multiline))

	documents


private pure func append_to_last_document(lines: List[Doc], suffix: Doc) -> List[Doc]:
	last_index: Int = lines.length() - 1
	lines.set(
		last_index,
		lines
			.get_or(last_index, "".text())
			.cat(suffix),
	)


private pure func append_pipe_interpolation_text(lines: List[Doc], value: String) -> List[Doc]:
	segments: List[String] = value.split("\n")
	var output: List[Doc] = lines
	var index: Int = 0

	for segment in segments:
		if index > 0:
			output = output.append("|".text())

		output = output.append_to_last_document(segment.text())
		index += 1

	output


private pure func append_pipe_interpolation_part(
	lines: List[Doc],
	part: StringInterpolationPart,
) -> List[Doc]:
	match part:
		StringInterpolationTextPart(value):
			lines.append_pipe_interpolation_text(value)
		StringInterpolationExpressionPart(value):
			lines.append_to_last_document(value.interpolated_expression_document())


private pure func pipe_string_interpolation_document(parts: List[StringInterpolationPart]) -> Doc:
	var lines: List[Doc] = ["|".text()]

	for part in parts:
		lines = lines.append_pipe_interpolation_part(part)

	lines.hardlines()


private pure func string_interpolation_document(
	parts: List[StringInterpolationPart],
	is_multiline: Bool,
) -> Doc:
	if is_multiline:
		parts.pipe_string_interpolation_document()
	else:
		"\""
			.text()
			.cat(
				parts
					.string_interpolation_part_documents(is_multiline)
					.concat_documents(),
			)
			.cat("\"".text())


pure func expression_document(expr: Expression) -> Doc:
	match expr:
		IdentifierExpression(name):
			name.text()
		LiteralExpression(lit):
			lit.literal_document()
		VoidExpression:
			"void".text()
		BreakExpression:
			"break".text()
		ContinueExpression:
			"continue".text()
		BuiltinExpression:
			"builtin".text()
		BuiltinRuntimeExpression(name):
			("builtin(\"" + name.escape_string_value() + "\")").text()
		FieldAccessExpression(receiver, field_name):
			receiver_document: Doc = receiver.postfix_operand_document()

			if field_name.is_tuple_index_field():
				receiver_document
					.cat("[".text())
					.cat(field_name.text())
					.cat("]".text())
			else:
				receiver_document
					.cat(".".text())
					.cat(field_name.text())
		CallExpression(callee, args):
			match callee.ufcs_chain_document(args):
				Some(chain_document):
					chain_document
				None:
					if args.expression_list_has_inline_lambda():
						callee.inline_lambda_call_document(args)
					else:
						callee
							.postfix_operand_document()
							.cat(args.call_arguments_document())
		OpaqueIntoExpression(type_expression, inner):
			type_doc = type_expression.type_document()
			value_doc = inner.opaque_conversion_value_document()

			"into_opaque "
				.text()
				.cat(type_doc)
				.cat(value_doc)
		OpaqueFromExpression(type_expression, inner):
			type_doc = type_expression.type_document()
			value_doc = inner.opaque_conversion_value_document()

			"from_opaque "
				.text()
				.cat(type_doc)
				.cat(value_doc)
		UnaryExpression(op, inner):
			inner_document: Doc = match inner:
				BinaryExpression(_, _, _):
					inner
						.expression_document()
						.parens()
				LogicalExpression(_, _, _):
					inner
						.expression_document()
						.parens()
				UnaryExpression(NegOp, _):
					if unary_op_is_neg(op):
						inner
							.expression_document()
							.parens()
					else:
						inner.expression_document()
				LiteralExpression(IntLiteral(raw)):
					if unary_op_is_neg(op) and raw.starts_with("-"):
						inner
							.expression_document()
							.parens()
					else:
						inner.expression_document()
				LiteralExpression(FloatLiteral(raw)):
					if unary_op_is_neg(op) and raw.starts_with("-"):
						inner
							.expression_document()
							.parens()
					else:
						inner.expression_document()
				_:
					inner.expression_document()

			op
				.unary_text()
				.text()
				.cat(inner_document)
		BinaryExpression(op, left, right):
			match expr.string_concat_wrap_document():
				Some(document):
					document
				None:
					prec: Int = op.binary_prec()

					left_document: Doc = if left.expression_precedence() < prec:
						left.parenthesized_expression_document()
					else:
						left.expression_document()

					right_document: Doc = if right.expression_precedence() <= prec:
						right.parenthesized_expression_document()
					else:
						right.expression_document()

					left_document
						.cat(" ".text())
						.cat(
							op
								.binary_text()
								.text(),
						)
						.cat(" ".text())
						.cat(right_document)
		LogicalExpression(op, _, _):
			expr.logical_expression_document(op)
		CommentedLogicalExpression(op, terms):
			commented_logical_expression_document(op, terms)
		TupleExpression(elems):
			elems.tuple_expression_document()
		ListExpression(elems):
			elems.list_expression_document()
		VectorExpression(elems):
			elems.vector_literal_document()
		RecordExpression(fields):
			fields.record_expression_document()
		RecordUpdateExpression(base, fields):
			base.record_update_expression_document(fields)
		RangeExpression(left, right):
			left
				.expression_document()
				.cat("..".text())
				.cat(right.expression_document())
		SubscriptExpression(target, index):
			target
				.postfix_operand_document()
				.cat("[".text())
				.cat(index.expression_document())
				.cat("]".text())
		MultiSubscriptExpression(target, indices):
			target
				.postfix_operand_document()
				.cat("[".text())
				.cat(
					indices
						.expression_document_list()
						.comma_sep(),
				)
				.cat("]".text())
		DictionaryExpression(entries):
			entries.dictionary_expression_document()
		AssignmentExpression(name, value):
			assign_document(name, value)
		CompoundAssignmentExpression(name, op, value):
			compound_assign_document(name, op, value)
		VariableDeclarationExpression(name, is_mutable, value):
			variable_declaration_document(name, is_mutable, None, value)
		TypedVariableDeclarationExpression(name, is_mutable, type_expression, value):
			variable_declaration_document(name, is_mutable, Some(type_expression), value)
		TupleDestructureExpression(names, value):
			"("
				.text()
				.cat(
					names
						.string_documents()
						.comma_sep(),
				)
				.cat(") = ".text())
				.cat(value.expression_document())
		SubscriptAssignmentExpression(target, indices, value):
			target
				.expression_document()
				.cat("[".text())
				.cat(
					indices
						.expression_document_list()
						.comma_sep(),
				)
				.cat("] = ".text())
				.cat(value.expression_document())
		QuestionBindExpression(name, value):
			question_bind_document(name, None, value)
		TypedQuestionBindExpression(name, type_expression, value):
			question_bind_document(name, Some(type_expression), value)
		BlockExpression(exprs):
			exprs.block_expressions_document()
		SpacedBlockExpression(items):
			items.spaced_block_expressions_document()
		ItemBlockExpression(items):
			items.block_items_document()
		IfExpression(cond, then_expr, header_comment):
			"if "
				.text()
				.headed_block_document(cond, header_comment, then_expr)
		IfElseExpression(cond, then_expr, else_expr, header_comment, else_comments):
			else_document: Doc = match else_expr:
				IfExpression(_, _, _):
					"else "
						.text()
						.cat(else_expr.expression_document())
				IfElseExpression(_, _, _, _, _):
					"else "
						.text()
						.cat(else_expr.expression_document())
				_:
					"else:"
						.text()
						.cat(else_comments.trailing.trailing_text_document())
						.cat(
							Hardline
								.cat(else_expr.block_body_document())
								.indent(),
						)

			"if "
				.text()
				.headed_block_document(cond, header_comment, then_expr)
				.cat(Hardline)
				.cat(else_comments.leading.comment_lines_document())
				.cat(else_document)
		MatchExpression(scrutinee, cases, comments):
			var closing: Doc = "".text()

			for comment in comments.closing:
				closing = closing
					.cat(Hardline)
					.cat(comment.text())

			"match "
				.text()
				.cat(scrutinee.block_header_expression_document())
				.cat(":".text())
				.cat(comments.header_trailing.trailing_text_document())
				.cat(
					Hardline
						.cat(
							cases
								.match_case_documents()
								.hardlines(),
						)
						.cat(closing)
						.indent(),
				)
		SelectExpression(arms):
			"select:"
				.text()
				.cat(
					Hardline
						.cat(
							arms
								.select_arm_documents()
								.hardlines(),
						)
						.indent(),
				)
		WhileExpression(cond, body, header_comment):
			"while "
				.text()
				.headed_block_document(cond, header_comment, body)
		ForExpression(name, iter, body, header_comment):
			"for "
				.text()
				.cat(name.text())
				.cat(" in ".text())
				.headed_block_document(iter, header_comment, body)
		TupleForExpression(names, iter, body, header_comment):
			"for ("
				.text()
				.cat(
					names
						.string_documents()
						.comma_sep(),
				)
				.cat(") in ".text())
				.headed_block_document(iter, header_comment, body)
		CommentedCollectionExpression(collection, closing):
			collection.commented_collection_document(closing)
		WithExpression(name, type_expression, is_try, value, error_name, error_value, body):
			with_expression_document(
				name,
				type_expression,
				is_try,
				value,
				error_name,
				error_value,
				body,
			)
		LambdaExpression(is_pure, params, body):
			lambda_document(is_pure, params, None, body)
		TypedLambdaExpression(is_pure, params, return_type, body):
			lambda_document(is_pure, params, Some(return_type), body)
		FunctionDeclarationExpression(name, is_pure, type_params, params, where_constraints, body):
			function_declaration_document(
				name,
				is_pure,
				type_params,
				params,
				None,
				where_constraints,
				body,
			)
		TypedFunctionDeclarationExpression(name, is_pure, type_params, params, return_type, where_constraints, body):
			function_declaration_document(
				name,
				is_pure,
				type_params,
				params,
				Some(return_type),
				where_constraints,
				body,
			)
		StringInterpolationExpression(parts, is_multiline):
			string_interpolation_document(parts, is_multiline)
		DebugBlockExpression(body):
			"debug:"
				.text()
				.cat(
					Hardline
						.cat(body.block_body_document())
						.indent(),
				)
		ConcurrentExpression(bindings, timeout, max_threads):
			"concurrent"
				.text()
				.cat(concurrent_params_document(timeout, max_threads))
				.cat(":".text())
				.cat(
					Hardline
						.cat(bindings.block_expressions_document())
						.indent(),
				)
		ConcurrentBindExpression(name, type_expression, value):
			concurrent_bind_document(name, type_expression, value)
		DetachExpression(body):
			body_document: Doc = if body.needs_detach_body_parens():
				body
					.expression_document()
					.parens()
			else:
				body.expression_document()

			text("detach ").cat(body_document)
		ConcurrentlyLoopExpression(var_name, iter, body, timeout, width):
			concurrently_loop_head_document(var_name, iter, timeout, width).cat(
				Hardline
					.cat(body.block_body_document())
					.indent(),
			)


pure func render_expression_json(width: Int, input: String) -> Result[String, String]:
	expr ?= input.expression_from_json_string()
	Ok(width.layout(expr.expression_document()))
