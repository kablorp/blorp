import:
	./document_layout:
		Doc(
			Nil,
			Text,
			Hardline,
			Softline,
			SoftlineSpace,
			Indent,
			Group,
			Concat,
			IfBreak,
			LineSuffix,
		),
		layout,
	./json_fields: field, int_field, string_field
	json: JsonValue, parse_json


private pure func document_field(value: JsonValue, key: String) -> Result[Doc, String]:
	child ?= value.field(key)
	child.document_from_json()


pure func document_from_json(value: JsonValue) -> Result[Doc, String]:
	tag ?= value.string_field("tag")

	match tag:
		"Nil":
			Ok(Nil)
		"Text":
			s ?= value.string_field("text")
			Ok(Text(s))
		"Hardline":
			Ok(Hardline)
		"Softline":
			Ok(Softline)
		"SoftlineSpace":
			Ok(SoftlineSpace)
		"Indent":
			width ?= value.int_field("width")
			doc ?= value.document_field("doc")
			Ok(Indent(width, doc))
		"Group":
			doc ?= value.document_field("doc")
			Ok(Group(doc))
		"Concat":
			left ?= value.document_field("left")
			right ?= value.document_field("right")
			Ok(Concat(left, right))
		"IfBreak":
			broken ?= value.document_field("broken")
			flat ?= value.document_field("flat")
			Ok(IfBreak(broken, flat))
		"LineSuffix":
			s ?= value.string_field("text")
			Ok(LineSuffix(s))
		_:
			Err("unknown Doc JSON tag: " + tag)


pure func document_from_json_string(input: String) -> Result[Doc, String]:
	value ?= input.parse_json()
	value.document_from_json()


pure func render_document_json(width: Int, input: String) -> Result[String, String]:
	doc ?= input.document_from_json_string()
	Ok(width.layout(doc))
