import:
	json: JsonValue


pure func missing_field(key: String) -> String:
	"missing formatter JSON field: " + key


pure func expected_field(key: String, expected: String) -> String:
	"expected formatter JSON field '" + key + "' to be " + expected


pure func field(value: JsonValue, key: String) -> Result[JsonValue, String]:
	match value.get_field(key):
		Some(child):
			Ok(child)
		None:
			Err(missing_field(key))


pure func string_field(value: JsonValue, key: String) -> Result[String, String]:
	child ?= value.field(key)

	match child.as_string():
		Some(s):
			Ok(s)
		None:
			Err(expected_field(key, "a string"))


pure func int_field(value: JsonValue, key: String) -> Result[Int, String]:
	child ?= value.field(key)

	match child.as_number():
		Some(n):
			Ok(to_int(n))
		None:
			Err(expected_field(key, "a number"))


--- The integer field `key` of `value`, or `None` when the field is absent.
pure func optional_int_field(value: JsonValue, key: String) -> Result[Option[Int], String]:
	match value.get_field(key):
		None:
			Ok(None)
		Some(_):
			int_value ?= value.int_field(key)
			Ok(Some(int_value))


pure func bool_field(value: JsonValue, key: String) -> Result[Bool, String]:
	child ?= value.field(key)

	match child.as_bool():
		Some(b):
			Ok(b)
		None:
			Err(expected_field(key, "a boolean"))


pure func array_field(value: JsonValue, key: String) -> Result[List[JsonValue], String]:
	child ?= value.field(key)

	match child.as_array():
		Some(items):
			Ok(items)
		None:
			Err(expected_field(key, "an array"))


--- The array field `key` of `value`, every item of which must be a string.
pure func string_array_field(value: JsonValue, key: String) -> Result[List[String], String]:
	items ?= value.array_field(key)
	var result: List[String] = []
	var error: Option[String] = None

	for item in items:
		match error:
			Some(_):
				void
			None:
				match item.as_string():
					Some(s):
						result = result.append(s)
					None:
						error = Some(
							"expected formatter JSON field '" + key + "' to be an array of strings",
						)

	match error:
		Some(msg):
			Err(msg)
		None:
			Ok(result)


pure func parsed_array_items[T](
	items: List[JsonValue],
	parse_item: pure (JsonValue) -> Result[T, String],
) -> Result[List[T], String]:
	var result: List[T] = []
	var error: Option[String] = None

	for item in items:
		match error:
			Some(_):
				void
			None:
				match parse_item(item):
					Ok(parsed):
						result = result.append(parsed)
					Err(msg):
						error = Some(msg)

	match error:
		Some(msg):
			Err(msg)
		None:
			Ok(result)


pure func parsed_array_field[T](
	value: JsonValue,
	key: String,
	parse_item: pure (JsonValue) -> Result[T, String],
) -> Result[List[T], String]:
	items ?= value.array_field(key)
	items.parsed_array_items(parse_item)
