import:
    bool: and, not, or
    int: Int methods
    list: List methods
    option: Option methods
    result: Result methods
    string: String methods
    ../utils/syntax:
        ArithmeticOperator(
            AddOperator,
            SubtractOperator,
            MultiplyOperator,
            DivideOperator,
            RemainderOperator,
        ),
        ComparisonOperator(
            EqualOperator,
            NotEqualOperator,
            LessOperator,
            GreaterOperator,
            LessEqualOperator,
            GreaterEqualOperator,
        ),
        ExpressionBase(
            VoidExpression,
            IntegerExpression,
            FloatExpression,
            StringExpression,
            InterpolatedString,
            NameExpression,
            DirectApplication,
            QualifiedName,
            QualifiedApplication,
            OpaqueWrap,
            OpaqueUnwrap,
            ListExpression,
            TupleExpression,
            RangeExpression,
            ComparisonExpression,
            ArithmeticExpression,
            NegationExpression,
            IfExpression,
            MatchExpression,
            LambdaExpression,
            RecordExpression,
            RecordUpdateExpression,
            DictExpression,
        ),
        LambdaBody(InlineBody, BlockBody),
        LambdaParameter,
        ParsedBinder(NamedBinder, DiscardBinder),
        ParsedLambda,
        ParsedPattern(
            PatternName,
            PatternWildcard,
            PatternConstructor,
            PatternOr,
            PatternList,
            PatternTuple,
            PatternLiteral,
            PatternChar,
        ),
        LiteralPattern(ExactBytes, ExactInt),
        ParsedQualified,
        ParsedRecordField,
        ParsedTypeParameter,
        PatternHead(BareHead, QualifiedHead),
        PostfixOperation(ReceiverInvocation, FieldAccess, TupleIndex),
        Purity(Pure, Impure),
        Span,
        SpreadTarget(SpreadName, SpreadWildcard),
        TokenKind(PipeString, StringStart),
        StringForm(PipeStringForm),
        TypeSyntax(AtomicType, AppliedType, QualifiedType, CallableTypeSyntax, TupleTypeSyntax),
        ValueExpression,
        WrittenName,
    ./printer: SourceView, token_at, written
    ./trivia: LINE_FEED_BYTE, MINUS_BYTE, SPACE_BYTE, TAB_BYTE


-- Where a value stands, which decides what its written parentheses are.
-- Parentheses that wrap a whole value can never change its meaning, so there
-- they are layout: the printer removes them, and adds a pair exactly when it
-- breaks an operator chain (FORMATTER_PLAN.md, decision 8 and D1).
union Placement:
    -- A binding's value, an argument, an element, a condition, a body's final
    -- value, a record field's or Dict entry's value, or a `?=` value.
    WholeValue
    -- Anywhere else: every pair the author wrote is kept.
    PartValue


-- Why a construct has no one-line form.
union NoFlatForm:
    -- An if, a match or a block lambda, whose blocks need lines of their own.
    HoldsBlock
    -- A comment, which only a broken layout keeps in place.
    HoldsComment
    -- A pipe or raw String, which must start a line.
    HoldsPipeString


-- Where the code that parentheses around `value` can wrap ends: its last
-- postfix operation, or its base. A pair ending at or after it wraps the
-- whole value; one ending before it wraps the base and the operations up to
-- the pair's end, as in `(x.f()).g()`.
pure func content_end(value: ValueExpression) -> Int:
    match value.applications.last():
        Some(application): application.application_end()
        None: value.base_span.end


pure func wraps_whole(pair: Span, value: ValueExpression) -> Bool:
    pair.end >= value.content_end()


-- The parentheses printed around `value` where it stands. Pairs around an
-- `if`, a `match` or a block lambda stay: removing one around a function's
-- final `match` would turn its value into a tail match, another tree.
pure func kept_parentheses(value: ValueExpression, placement: Placement) -> List[Span]:
    match placement:
        PartValue: value.parentheses
        WholeValue:
            if value.base.holds_block():
                value.parentheses
            else:
                value.parentheses.filter(
                    pure func(pair: Span) -> Bool: pair.wraps_whole(value).not(),
                )


pure func holds_block(base: ExpressionBase) -> Bool:
    match base:
        IfExpression(_) | MatchExpression(_): True
        LambdaExpression(lambda):
            match lambda.body:
                BlockBody(_): True
                InlineBody(_): False
        _: False


pure func name_text(source: SourceView, name: WrittenName) -> String:
    source.written(name.span)


pure func qualified_text(source: SourceView, qualified: ParsedQualified) -> String:
    "${source.name_text(qualified.module)}.${source.name_text(qualified.name)}"


pure func arithmetic_text(operator: ArithmeticOperator) -> String:
    match operator:
        AddOperator: "+"
        SubtractOperator: "-"
        MultiplyOperator: "*"
        DivideOperator: "/"
        RemainderOperator: "%"


pure func comparison_text(operator: ComparisonOperator) -> String:
    match operator:
        EqualOperator: "=="
        NotEqualOperator: "!="
        LessOperator: "<"
        GreaterOperator: ">"
        LessEqualOperator: "<="
        GreaterEqualOperator: ">="


pure func type_text(source: SourceView, written_type: TypeSyntax) -> String:
    match written_type:
        AtomicType(name): source.name_text(name)
        AppliedType(name, arguments, _):
            "${source.name_text(name)}[${source.types_text(arguments)}]"
        QualifiedType(qualified, arguments, _):
            if arguments.is_empty():
                source.qualified_text(qualified)
            else:
                "${source.qualified_text(qualified)}[${source.types_text(arguments)}]"
        CallableTypeSyntax(purity, parameters, result, _):
            "${purity.purity_text()}(${source.types_text(parameters)}) -> ${source.type_text(result)}"
        TupleTypeSyntax(elements, _): "(${source.types_text(elements)})"


pure func types_text(source: SourceView, types: List[TypeSyntax]) -> String:
    types
        .map(pure func(written_type: TypeSyntax) -> String: source.type_text(written_type))
        .join(", ")


pure func type_parameter_text(source: SourceView, parameter: ParsedTypeParameter) -> String:
    if parameter.bounds.is_empty():
        source.name_text(parameter.name)
    else:
        bounds = parameter.bounds
            .map(pure func(bound: TypeSyntax) -> String: source.type_text(bound))
            .join(" + ")
        "${source.name_text(parameter.name)}: ${bounds}"


-- `[T: Bound, U]`, or nothing when there are none.
pure func type_parameters_text(source: SourceView, parameters: List[ParsedTypeParameter]) -> String:
    if parameters.is_empty():
        ""
    else:
        "[${parameters.map(pure func(parameter: ParsedTypeParameter) -> String: source.type_parameter_text(parameter)).join(", ")}]"


pure func binder_text(source: SourceView, binder: ParsedBinder) -> String:
    match binder:
        NamedBinder(name): source.name_text(name)
        DiscardBinder(_): "_"


pure func lambda_parameter_text(source: SourceView, parameter: LambdaParameter) -> String:
    match parameter.annotation:
        Some(annotation): "${source.binder_text(parameter.binder)}: ${source.type_text(annotation)}"
        None: source.binder_text(parameter.binder)


pure func pattern_text(source: SourceView, pattern: ParsedPattern) -> String:
    match pattern:
        PatternName(name): source.name_text(name)
        PatternWildcard(_): "_"
        -- A bare head with no fields keeps its parentheses: `Empty` alone is
        -- a name pattern, a different tree from `Empty()`.
        PatternConstructor(head, fields, _):
            match head:
                BareHead(name): "${source.name_text(name)}(${source.patterns_text(fields)})"
                QualifiedHead(qualified):
                    if fields.is_empty():
                        source.qualified_text(qualified)
                    else:
                        "${source.qualified_text(qualified)}(${source.patterns_text(fields)})"
        PatternOr(alternatives, _):
            alternatives
                .map(
                    pure func(alternative: ParsedPattern) -> String: source.pattern_text(
                        alternative,
                    ),
                )
                .join(" | ")
        PatternList(elements, spread, _):
            rest = match spread:
                Some(SpreadName(name)): "...${source.name_text(name)}"
                Some(SpreadWildcard(_)): "..._"
                None: ""
            listed = if and(elements.is_empty().not(), rest.length() > 0):
                "${source.patterns_text(elements)}, ${rest}"
            else:
                source.patterns_text(elements) + rest
            "[${listed}]"
        PatternTuple(elements, _): "(${source.patterns_text(elements)})"
        -- Literals print as written; a negative Int loses the spaces after its
        -- minus, as in a value.
        PatternLiteral(ExactBytes(_), span): source.written(span)
        PatternLiteral(ExactInt(_), span): source.number_text(span)
        PatternChar(span): source.written(span)


private pure func patterns_text(source: SourceView, patterns: List[ParsedPattern]) -> String:
    patterns
        .map(pure func(pattern: ParsedPattern) -> String: source.pattern_text(pattern))
        .join(", ")


-- Whether a String literal at `span` is a pipe String or raw block.
pure func is_pipe_string(source: SourceView, span: Span) -> Bool:
    match source.token_at(span.start):
        Some(token):
            match token.kind:
                PipeString(_): True
                StringStart(PipeStringForm): True
                _: False
        None: False


-- A numeric literal as written; a folded minus loses the spaces after it.
private pure func number_text(source: SourceView, span: Span) -> String:
    text = source.written(span)
    if text.byte_at(0) == Some(MINUS_BYTE):
        var digits = 1
        while text.byte_at(digits).map(
            pure func(byte: Int) -> Bool: [SPACE_BYTE, TAB_BYTE, LINE_FEED_BYTE].contains(byte),
        ).get_or(False):
            digits = digits + 1
        "-" + text.slice(digits, text.length()).get_or("")
    else:
        text


-- Each text, joined by `separator`, or the first reason one has no flat form.
pure func joined(
    texts: List[Result[String, NoFlatForm]],
    separator: String,
) -> Result[String, NoFlatForm]:
    var parts: List[String] = []
    var failure: Option[NoFlatForm] = None
    for flat in texts:
        match flat:
            Ok(part): parts = parts.append(part)
            Err(reason):
                failure = Some(reason)
                break
    match failure:
        Some(reason): Err(reason)
        None: Ok(parts.join(separator))


pure func values_text(
    source: SourceView,
    values: List[ValueExpression],
    placement: Placement,
) -> Result[String, NoFlatForm]:
    values
        .map(
            pure func(value: ValueExpression) -> Result[String, NoFlatForm]: source.value_text(
                value,
                placement,
            ),
        )
        .joined(", ")


pure func purity_text(purity: Purity) -> String:
    match purity:
        Pure: "pure "
        Impure: ""


-- ` -> Type`, or nothing for an omitted result.
pure func returned_text(source: SourceView, return_type: Option[TypeSyntax]) -> String:
    match return_type:
        Some(written_type): " -> ${source.type_text(written_type)}"
        None: ""


pure func lambda_header_text(source: SourceView, lambda: ParsedLambda) -> String:
    parameters = lambda.parameters
        .map(
            pure func(parameter: LambdaParameter) -> String: source.lambda_parameter_text(
                parameter,
            ),
        )
        .join(", ")
    "${lambda.purity.purity_text()}func(${parameters})${source.returned_text(lambda.return_type)}:"


-- A prefix minus before a value that starts with one keeps a space, since
-- `--` would start a comment.
pure func negation_prefix(operand: String) -> String:
    if operand.byte_at(0) == Some(MINUS_BYTE):
        "- "
    else:
        "-"


pure func negated_text(operand: String) -> String:
    "${operand.negation_prefix()}${operand}"


-- The one-line form of a sum or product chain. Its left spine is walked in a
-- loop: a 2,000-term sum nests 2,000 deep.
private pure func arithmetic_text_of(
    source: SourceView,
    base: ExpressionBase,
) -> Result[String, NoFlatForm]:
    var rights: List[Result[String, NoFlatForm]] = []
    var current = base
    -- The loop below always replaces this: `base` is a sum or product.
    var leftmost: Result[String, NoFlatForm] = Err(HoldsBlock)
    var walking: Bool = True
    while walking:
        walking = False
        match current:
            ArithmeticExpression(operator, _, left, right):
                rights = rights.append(
                    source
                        .value_text(right, PartValue)
                        .map(
                            pure func(text: String) -> String: "${operator.arithmetic_text()} ${text}",
                        ),
                )
                if left.continues_chain():
                    current = left.base
                    walking = True
                else:
                    leftmost = source.value_text(left, PartValue)
            _: void
    [leftmost].concat(rights.reverse()).joined(" ")


-- Whether a left operand is the next link of an unparenthesized sum or
-- product chain.
pure func continues_chain(left: ValueExpression) -> Bool:
    match left.base:
        ArithmeticExpression(_, _, _, _):
            and(left.applications.is_empty(), left.parentheses.is_empty())
        _: False


pure func base_text(
    source: SourceView,
    base: ExpressionBase,
    span: Span,
) -> Result[String, NoFlatForm]:
    match base:
        VoidExpression: Ok("void")
        IntegerExpression(_) | FloatExpression(_): Ok(source.number_text(span))
        StringExpression(_) | InterpolatedString(_):
            if source.is_pipe_string(span):
                Err(HoldsPipeString)
            else:
                Ok(source.written(span))
        NameExpression(name): Ok(source.name_text(name))
        DirectApplication(callee, arguments):
            source
                .values_text(arguments, WholeValue)
                .map(pure func(listed: String) -> String: "${source.name_text(callee)}(${listed})")
        QualifiedName(qualified): Ok(source.qualified_text(qualified))
        QualifiedApplication(qualified, arguments):
            source
                .values_text(arguments, WholeValue)
                .map(
                    pure func(listed: String) -> String: "${source.qualified_text(qualified)}(${listed})",
                )
        OpaqueWrap(name, value):
            source
                .value_text(value, PartValue)
                .map(
                    pure func(inner: String) -> String: "into_opaque ${source.name_text(name)}(${inner})",
                )
        OpaqueUnwrap(name, value):
            source
                .value_text(value, PartValue)
                .map(
                    pure func(inner: String) -> String: "from_opaque ${source.name_text(name)}(${inner})",
                )
        ListExpression(elements):
            source
                .values_text(elements, WholeValue)
                .map(pure func(listed: String) -> String: "[${listed}]")
        TupleExpression(elements):
            source
                .values_text(elements, WholeValue)
                .map(pure func(listed: String) -> String: "(${listed})")
        RangeExpression(low, high):
            [source.value_text(low, PartValue), source.value_text(high, PartValue)].joined("..")
        ComparisonExpression(operator, _, left, right):
            [source.value_text(left, PartValue), source.value_text(right, PartValue)].joined(
                " ${operator.comparison_text()} ",
            )
        ArithmeticExpression(_, _, _, _): source.arithmetic_text_of(base)
        NegationExpression(_, operand): source.value_text(operand, PartValue).map(negated_text)
        IfExpression(_) | MatchExpression(_): Err(HoldsBlock)
        LambdaExpression(lambda):
            match lambda.body:
                InlineBody(value):
                    source
                        .value_text(value, WholeValue)
                        .map(
                            pure func(body: String) -> String: "${source.lambda_header_text(lambda)} ${body}",
                        )
                BlockBody(_): Err(HoldsBlock)
        RecordExpression(fields):
            fields
                .map(
                    pure func(field: ParsedRecordField) -> Result[String, NoFlatForm]: source.field_text(
                        field,
                    ),
                )
                .joined(", ")
                .map(pure func(listed: String) -> String: "{ ${listed} }")
        RecordUpdateExpression(updated, fields):
            replaced = fields
                .map(
                    pure func(field: ParsedRecordField) -> Result[String, NoFlatForm]: source.field_text(
                        field,
                    ),
                )
                .joined(", ")
            [source.value_text(updated, PartValue), replaced]
                .joined(" | ")
                .map(pure func(inside: String) -> String: "{ ${inside} }")
        DictExpression(entries):
            if entries.is_empty():
                Ok("{}")
            else:
                entries
                    .map(
                        pure func(entry) -> Result[String, NoFlatForm]: [
                            source.value_text(entry.key, PartValue),
                            source.value_text(entry.value, WholeValue),
                        ].joined(" => "),
                    )
                    .joined(", ")
                    .map(pure func(listed: String) -> String: "{ ${listed} }")


pure func field_text(source: SourceView, field: ParsedRecordField) -> Result[String, NoFlatForm]:
    source
        .value_text(field.value, WholeValue)
        .map(pure func(value: String) -> String: "${source.name_text(field.name)} = ${value}")


pure func application_end(application: PostfixOperation) -> Int:
    match application:
        ReceiverInvocation(call): call.span.end
        FieldAccess(field): field.span.end
        TupleIndex(_, span): span.end


pure func application_text(
    source: SourceView,
    application: PostfixOperation,
) -> Result[String, NoFlatForm]:
    match application:
        ReceiverInvocation(call):
            source
                .values_text(call.arguments, WholeValue)
                .map(
                    pure func(listed: String) -> String: ".${source.name_text(call.callee)}(${listed})",
                )
        FieldAccess(field): Ok(".${source.name_text(field)}")
        TupleIndex(index, _):
            source
                .value_text(index, PartValue)
                .map(pure func(inner: String) -> String: "[${inner}]")


-- How many of the `open` innermost pairs of `pairs` close before the part of
-- a value that ends at `next_end`: those that end before it, since a pair
-- that wraps a part ends after it.
pure func closing_count(pairs: List[Span], open: Int, next_end: Int) -> Int:
    var still_open = open
    var closing: Bool = True
    while and(closing, still_open > 0):
        closing = False
        match pairs.get(still_open - 1):
            Some(pair):
                if pair.end < next_end:
                    still_open = still_open - 1
                    closing = True
            None: void
    open - still_open


-- `value` on one line where it stands, or why it has none. Comments are the
-- caller's to check: a construct holding one is broken however short.
pure func value_text(
    source: SourceView,
    value: ValueExpression,
    placement: Placement,
) -> Result[String, NoFlatForm]:
    pairs = value.kept_parentheses(placement)
    var parts: List[Result[String, NoFlatForm]] = [
        Ok("(".repeated(pairs.length())),
        source.base_text(value.base, value.base_span),
    ]
    var open = pairs.length()
    for application in value.applications:
        closing = closing_count(pairs, open, application.application_end())
        parts = parts.append(Ok(")".repeated(closing))).append(source.application_text(application))
        open = open - closing
    parts.append(Ok(")".repeated(open))).joined("")


pure func repeated(text: String, count: Int) -> String:
    var result = ""
    for _ in 0..count:
        result = result + text
    result
