private pure func type_param_name(param: ParsedTypeParamDecl) -> String:
	if param.bounds.length() == 0:
		param.name.text
	else:
		var bounds: List[String] = []

		for bound in param.bounds:
			bounds = bounds.append(parsed_trait_reference_text(bound))

		param.name.text + ":" + bounds.join("+")


private pure func type_param_names(params: List[ParsedTypeParamDecl]) -> List[String]:
	params.map(func(param): type_param_name(param))


private pure func option_type_expr(value: Option[ParsedTypeExpr]) -> Option[TypeExpression]:
	match value:
		Some(type_expr):
			Some(project_type_expr(type_expr))
		None:
			None


private pure func project_dim_op(op: ParsedDimBinaryOp) -> TypeDimensionOperator:
	match op:
		ParsedDimAddOp:
			TypeDimensionAdd
		ParsedDimSubtractOp:
			TypeDimensionSub
		ParsedDimMultiplyOp:
			TypeDimensionMul
		ParsedDimDivideOp:
			TypeDimensionDiv


pure func project_type_expr(type_expr: ParsedTypeExpr) -> TypeExpression:
	match type_expr:
		ParsedNamedType(name, args, _):
			var projected_args: List[TypeExpression] = []

			for arg in args:
				projected_args = projected_args.append(project_type_expr(arg))

			if name_ids_equal(name.name, NAME_ID_SELF_TYPE) and projected_args.length() == 0:
				SelfType
			else:
				NamedType(name.text, projected_args)
		ParsedQualifiedNamedType(module_name, name, args, _):
			var projected_args: List[TypeExpression] = []

			for arg in args:
				projected_args = projected_args.append(project_type_expr(arg))

			NamedType(module_name.text + "." + name.text, projected_args)
		ParsedBoundedType(name, bounds, _):
			var bound_names: List[String] = []

			for bound in bounds:
				bound_names = bound_names.append(parsed_trait_reference_text(bound))

			BoundVarType(name.text + ":" + bound_names.join("+"))
		ParsedDimNameType(name, is_variadic, _):
			if is_variadic:
				VarDimsType(name.text)
			else:
				VarType(name.text)
		ParsedDimLiteralType(value, _):
			ConstIntType(
				value
					.parse_int()
					.get_or(0),
			)
		ParsedDimBinaryType(op, left, right, _):
			DimensionOperationType(
				project_dim_op(op),
				project_type_expr(left),
				project_type_expr(right),
			)
		ParsedRangeType(limit, _):
			RangeType(project_type_expr(limit))
		ParsedTupleType(elems, _):
			var projected: List[TypeExpression] = []

			for elem in elems:
				projected = projected.append(project_type_expr(elem))

			TupleType(projected)
		ParsedFunctionType(is_pure, params, return_type, _):
			var projected_params: List[TypeExpression] = []

			for param in params:
				projected_params = projected_params.append(project_type_expr(param))

			FuncType(is_pure, projected_params, project_type_expr(return_type))
		ParsedArrayType(elem, dims, _):
			var projected_dims: List[TypeExpression] = []

			for dim in dims:
				projected_dims = projected_dims.append(project_type_expr(dim))

			ArrayType(project_type_expr(elem), projected_dims)
		ParsedMissingType(_):
			NamedType("?", [])


private pure func project_dim_constraint(constraint: ParsedDimConstraint) -> TypeConstraint:
	{
		left = project_type_expr(constraint.left),
		right = project_type_expr(constraint.right)
	}


private pure func project_dim_constraints(
	constraints: List[ParsedDimConstraint],
) -> List[TypeConstraint]:
	var projected: List[TypeConstraint] = []

	for constraint in constraints:
		projected = projected.append(project_dim_constraint(constraint))

	projected


private pure func string_flags(form: ParsedStringLiteralForm) -> StringFlags:
	match form:
		ParsedPlainStringLiteral:
			{
				raw = False,
				multiline = False
			}
		ParsedRawStringLiteral:
			{
				raw = True,
				multiline = False
			}
		ParsedPipeStringLiteral:
			{
				raw = False,
				multiline = True
			}
		ParsedRawPipeStringLiteral:
			{
				raw = True,
				multiline = True
			}


private pure func int_literal(raw: String) -> Literal:
	match raw.parse_int():
		Some(_):
			IntLiteral(raw)
		None:
			Int128Literal(raw)


private pure func project_literal_string(value: String, form: ParsedStringLiteralForm) -> Literal:
	StringLiteral(value, string_flags(form))


private pure func project_unary_op(op: ParsedUnaryOp) -> UnaryOp:
	match op:
		ParsedNegateOp:
			NegOp
		ParsedNotOp:
			NotOp


private pure func project_binary_op(op: ParsedBinaryOp) -> BinaryOp:
	match op:
		ParsedAddOp:
			AddOp
		ParsedSubtractOp:
			SubOp
		ParsedMultiplyOp:
			MulOp
		ParsedDivideOp:
			DivOp
		ParsedModuloOp:
			ModOp
		ParsedLessOp:
			LtOp
		ParsedGreaterOp:
			GtOp
		ParsedLessEqualOp:
			LeOp
		ParsedGreaterEqualOp:
			GeOp
		ParsedEqualOp:
			EqOp
		ParsedNotEqualOp:
			NeOp


private pure func project_compound_assign_op(op: ParsedCompoundAssignOp) -> BinaryOp:
	match op:
		ParsedAssignAddOp:
			AddOp
		ParsedAssignSubtractOp:
			SubOp
		ParsedAssignMultiplyOp:
			MulOp
		ParsedAssignDivideOp:
			DivOp


private pure func project_logical_op(op: ParsedLogicalOp) -> LogicalOp:
	match op:
		ParsedAndOp:
			AndOp
		ParsedOrOp:
			OrOp


private pure func project_pattern(pattern: ParsedPattern) -> Pattern:
	match pattern:
		ParsedWildcardPattern(_):
			WildcardPattern
		ParsedNamePattern(name):
			VarPattern(name.text)
		ParsedIntPattern(value, _):
			LiteralPattern(int_literal(value))
		ParsedFloatPattern(value, _):
			LiteralPattern(FloatLiteral(value))
		ParsedStringPattern(value, form, _):
			LiteralPattern(project_literal_string(value, form))
		ParsedCharPattern(value, _):
			LiteralPattern(CharLiteral(value))
		ParsedBoolPattern(value, _):
			LiteralPattern(BoolLiteral(value))
		ParsedConstructorPattern(name, args, _):
			var projected: List[Pattern] = []

			for arg in args:
				projected = projected.append(project_pattern(arg))

			ConstructorPattern(name.text, projected)
		ParsedQualifiedConstructorPattern(module_name, name, args, _):
			var projected: List[Pattern] = []

			for arg in args:
				projected = projected.append(project_pattern(arg))

			QualifiedPattern(module_name.text, name.text, projected)
		ParsedTuplePattern(items, _):
			var projected: List[Pattern] = []

			for item in items:
				projected = projected.append(project_pattern(item))

			TuplePattern(projected)
		ParsedListPattern(items, spread, _):
			var projected: List[Pattern] = []

			for item in items:
				projected = projected.append(project_pattern(item))

			match spread:
				Some(ParsedListSpreadName(name)):
					ListSpreadPattern(projected, VarPattern(name.text))
				Some(ParsedListSpreadWildcard(_)):
					ListSpreadPattern(projected, WildcardPattern)
				None:
					ListPattern(projected)
		ParsedOrPattern(items, _):
			var projected: List[Pattern] = []

			for item in items:
				projected = projected.append(project_pattern(item))

			OrPattern(projected)
		ParsedMissingPattern(_):
			WildcardPattern


private pure func project_param(param: ParsedParam) -> FunctionParameter:
	match (param.binder, param.type_expr):
		(ParsedParamNameBinder(name), Some(type_expr)):
			TypedNameParam(name.text, project_type_expr(type_expr))
		(ParsedParamNameBinder(name), None):
			NameParam(name.text)
		(ParsedParamWildcardBinder(_), Some(type_expr)):
			TypedNameParam("_", project_type_expr(type_expr))
		(ParsedParamWildcardBinder(_), None):
			NameParam("_")
		(ParsedParamTupleBinder(names, _), Some(type_expr)):
			var patterns: List[Pattern] = []

			for name in names:
				patterns = patterns.append(VarPattern(name.text))

			TypedPatternParam(TuplePattern(patterns), project_type_expr(type_expr))
		(ParsedParamTupleBinder(names, _), None):
			var patterns: List[Pattern] = []

			for name in names:
				patterns = patterns.append(VarPattern(name.text))

			PatternParam(TuplePattern(patterns))


private pure func project_params(params: List[ParsedParam]) -> List[FunctionParameter]:
	params.map(func(param): project_param(param))


---
The last line before a function's closing `)` that can hold a comment of its
parameter list. The parser does not locate the `)`, so the bound comes from
what follows it: the return type starts on the `)` line or after it, and a
body block claims the comments directly above its first statement. Without a
return type, a comment after `):` that a blank line separates from the first
statement falls in the parameter list; no block claims it.
---
private pure func parameter_comments_end_line(
	table: SourceTable,
	comments: List[FormatterComment],
	last_param_end_line: Int,
	return_type: Option[ParsedTypeExpr],
	body: Option[ParsedExpr],
) -> Int:
	match (return_type, body):
		(Some(type_expr), _):
			source_location_span(table, parsed_type_expr_location(type_expr)).start_line - 1
		(None, Some(ParsedBlockExpr(items, span))):
			initial_block_previous_end(
				table,
				items,
				comments,
				block_comment_column(table, items),
				source_location_span(table, span).start_line,
			)
		_:
			last_param_end_line


---
Project a function's parameters with the comments written among them (see
`collection_item_comments`). A top-level declaration's renderer keeps the
comment ending its `func` line (see `project_decls`); a method's or nested
function's `func`-line comment goes to its parameters. Without a return type
the `)` line is not located (see `parameter_comments_end_line`), so a comment
ending a `):` line attaches to the last parameter.
---
private pure func project_function_params(
	table: SourceTable,
	comments: List[FormatterComment],
	name: ParsedIdentifier,
	params: List[ParsedParam],
	return_type: Option[ParsedTypeExpr],
	body: Option[ParsedExpr],
) -> List[FunctionParameter]:
	if comments.length() == 0:
		project_params(params)
	else:
		project_commented_function_params(table, comments, name, params, return_type, body)


private pure func project_commented_function_params(
	table: SourceTable,
	comments: List[FormatterComment],
	name: ParsedIdentifier,
	params: List[ParsedParam],
	return_type: Option[ParsedTypeExpr],
	body: Option[ParsedExpr],
) -> List[FunctionParameter]:
	open_line: Int = source_location_span(table, name.span).start_line

	last_param_end_line: Int = match params.last():
		Some(param):
			span_end_line(table, param.span)
		None:
			open_line

	commented: CommentedItems[FunctionParameter] = collection_item_comments(
		table,
		comments,
		open_line,
		parameter_comments_end_line(table, comments, last_param_end_line, return_type, body) + 1,
		params.map(func(param): located_item(project_param(param), param_item_extent(param))),
	)
	var result: List[FunctionParameter] = []
	last_index: Int = commented.items.length() - 1
	var index: Int = 0

	for param in commented.items:
		after: List[String] = if index == last_index:
			commented.closing
		else:
			[]

		if (
			param.comments.leading.length() > 0
			or param.comments.trailing.is_some()
			or after.length() > 0
		):
			result = result.append(CommentedParam(param.item, param.comments, after))
		else:
			result = result.append(param.item)

		index += 1

	result


private pure func project_lambda_param(param: ParsedLambdaParam) -> FunctionParameter:
	match param.type_expr:
		Some(type_expr):
			TypedNameParam(param.name.text, project_type_expr(type_expr))
		None:
			NameParam(param.name.text)


record BlockCommentCollect {
	items: List[BlockItem],
	previous_end: Int
}


private pure func append_leading_block_comments(
	items: List[BlockItem],
	comments: List[FormatterComment],
	previous_end: Int,
	before_line: Int,
	min_column: Int,
) -> BlockCommentCollect:
	var result: List[BlockItem] = items
	var last_line: Int = previous_end

	for comment in comments:
		if (
			not comment.trailing
			and comment.line >= last_line
			and comment.line <= before_line
			and comment.column >= min_column
		):
			result = result.append(
				BlockCommentItem(
					comment.line - last_line > 1,
					comment.text_value,
				),
			)
			last_line = comment.line

	{
		items = result,
		previous_end = last_line
	}


private pure func trailing_comment_on_line(
	comments: List[FormatterComment],
	line: Int,
) -> Option[String]:
	var result: Option[String] = None

	for comment in comments:
		if (
			result.is_none()
			and comment.trailing
			and comment.line == line
		):
			result = Some(comment.text_value)

	result


---
The comment ending a statement's last line, when the statement owns it: a
statement on one line, or one whose last line does not end inside a nested
block (see `parsed_expr_ends_inside_block`), which claims that comment itself.
---
private pure func trailing_comment_for_expr(
	table: SourceTable,
	comments: List[FormatterComment],
	expr: ParsedExpr,
) -> Option[String]:
	resolved: SourceSpan = source_location_span(table, parsed_expr_location(expr))

	if comments.length() == 0:
		None
	else if resolved.start_line == resolved.end_line:
		trailing_comment_on_line(comments, resolved.end_line)
	else if not parsed_expr_ends_inside_block(table, expr):
		trailing_comment_on_line(
			comments,
			span_end_line(table, parsed_expr_location(expr)),
		)
	else:
		None


private pure func block_item_trailing_comment(
	table: SourceTable,
	expr: ParsedExpr,
	comments: List[FormatterComment],
) -> Option[String]:
	match expr:
		ParsedBlockExpr(_, _):
			None
		ParsedIfExpr(_, _, _, _):
			None
		ParsedMatchExpr(_, _, _):
			None
		ParsedSelectExpr(_, _):
			None
		ParsedWithExpr(_, _, _):
			None
		ParsedDebugBlockExpr(_, _):
			None
		ParsedFunctionDeclExpr(_):
			None
		ParsedWhileExpr(_, _, _):
			None
		ParsedForExpr(_, _, _, _):
			None
		ParsedConcurrentBlockExpr(_, _, _):
			None
		ParsedConcurrentForExpr(_, _, _, _, _):
			None
		_:
			trailing_comment_for_expr(table, comments, expr)


private pure func block_has_comments(
	table: SourceTable,
	span: SourceLocation,
	comments: List[FormatterComment],
) -> Bool:
	resolved: SourceSpan = source_location_span(table, span)
	var found: Bool = False

	for comment in comments:
		if comment.line >= resolved.start_line - 1 and comment.line <= resolved.end_line:
			found = True
			break

	found


private pure func block_comment_column(table: SourceTable, exprs: List[ParsedExpr]) -> Int:
	match exprs.get(0):
		Some(expr):
			source_location_span(table, parsed_expr_location(expr)).start_column
		None:
			0


private pure func has_leading_comment_on_line(
	comments: List[FormatterComment],
	line: Int,
	min_column: Int,
) -> Bool:
	var found: Bool = False

	for comment in comments:
		if (
			not comment.trailing
			and comment.line == line
			and comment.column >= min_column
		):
			found = True
			break

	found


private pure func initial_block_previous_end(
	table: SourceTable,
	exprs: List[ParsedExpr],
	comments: List[FormatterComment],
	min_column: Int,
	fallback_start_line: Int,
) -> Int:
	first_line: Int = match exprs.get(0):
		Some(expr):
			source_location_span(table, parsed_expr_location(expr)).start_line
		None:
			fallback_start_line

	var start_line: Int = first_line
	var scanning: Bool = True

	while scanning:
		if has_leading_comment_on_line(comments, start_line - 1, min_column):
			start_line -= 1
		else:
			scanning = False

	start_line - 1


private pure func parsed_block_items(
	table: SourceTable,
	exprs: List[ParsedExpr],
) -> List[Expression]:
	exprs.map(func(expr): project_expr(table, expr))


private pure func span_end_line(table: SourceTable, span: SourceLocation) -> Int:
	resolved: SourceSpan = source_location_span(table, span)

	if resolved.end_line > resolved.start_line:
		resolved.end_line
	else:
		resolved.start_line


private pure func expr_end_line(table: SourceTable, expr: ParsedExpr) -> Int:
	span_end_line(table, parsed_expr_location(expr))


private pure func block_blank_before(table: SourceTable, exprs: List[ParsedExpr]) -> List[Bool]:
	var flags: List[Bool] = []
	var previous_end: Option[Int] = None

	for expr in exprs:
		line: Int = source_location_span(table, parsed_expr_location(expr)).start_line

		blank: Bool = match previous_end:
			Some(prev):
				line - prev > 1
			None:
				False

		flags = flags.append(blank)
		previous_end = Some(expr_end_line(table, expr))

	flags


private pure func any_true(values: List[Bool]) -> Bool:
	var found: Bool = False

	for value in values:
		if value:
			found = True
			break

	found


private pure func spaced_block_expr(table: SourceTable, exprs: List[ParsedExpr]) -> Expression:
	projected: List[Expression] = parsed_block_items(table, exprs)
	flags: List[Bool] = block_blank_before(table, exprs)

	if any_true(flags):
		var items: List[(Bool, Expression)] = []
		var index: Int = 0

		for expr in projected:
			items = items.append((flags.get_or(index, False), expr))
			index += 1

		SpacedBlockExpression(items)
	else:
		BlockExpression(projected)


private pure func commented_block_expr(
	table: SourceTable,
	exprs: List[ParsedExpr],
	comments: List[FormatterComment],
	span: SourceLocation,
) -> Expression:
	if not block_has_comments(table, span, comments):
		spaced_block_expr(table, exprs)
	else:
		span_record: SourceSpan = source_location_span(table, span)
		var items: List[BlockItem] = []
		block_column: Int = block_comment_column(table, exprs)
		var previous_end: Int = initial_block_previous_end(
			table,
			exprs,
			comments,
			block_column,
			span_record.start_line,
		)

		for expr in exprs:
			expr_span: SourceLocation = parsed_expr_location(expr)
			expr_span_record: SourceSpan = source_location_span(table, expr_span)
			leading: BlockCommentCollect = append_leading_block_comments(
				items,
				comments,
				previous_end,
				expr_span_record.start_line,
				block_column,
			)
			items = leading.items
			previous_end = leading.previous_end

			items = items.append(
				BlockExpressionItem(
					expr_span_record.start_line - previous_end > 1,
					project_expr_with_comments(table, expr, comments),
					block_item_trailing_comment(table, expr, comments),
				),
			)
			previous_end = expr_end_line(table, expr)

		after_body: BlockCommentCollect = append_leading_block_comments(
			items,
			comments,
			previous_end,
			span_record.end_line,
			block_column,
		)
		ItemBlockExpression(after_body.items)


private pure func block_exprs_for_concurrent(
	table: SourceTable,
	body: ParsedExpr,
	comments: List[FormatterComment],
) -> List[Expression]:
	match body:
		ParsedBlockExpr(items, _):
			var projected: List[Expression] = []

			for item in items:
				projected = projected.append(project_expr_with_comments(table, item, comments))

			projected
		_:
			[project_expr_with_comments(table, body, comments)]


---
Where one item of a call, collection, logical chain or parameter list sits:
its span; the statement column of a block ending it (see `PrecedingBody`);
and whether its last line ends inside a nested block, which claims the
comment ending that line (see `parsed_expr_ends_inside_block`).
---
record ParsedItemExtent {
	span: SourceLocation,
	ending_block_column: Option[Int],
	ends_inside_block: Bool
}


---
Whether an expression's last line ends inside a nested block: a block-bodied
construct (`if`, `match`, a loop, a block lambda...) reached through the
expression's rightmost parts. That block's last statement claims the comment
ending the line, so the expression must not. A call or collection reaches its
last item only when that item ends on the closing bracket's line. Any other
expression owns the comment ending its last line.
---
private pure func parsed_expr_ends_inside_block(table: SourceTable, expr: ParsedExpr) -> Bool:
	match expr:
		ParsedBlockExpr(_, _):
			True
		ParsedIfExpr(_, _, _, _):
			True
		ParsedMatchExpr(_, _, _):
			True
		ParsedSelectExpr(_, _):
			True
		ParsedWithExpr(_, _, _):
			True
		ParsedDebugBlockExpr(_, _):
			True
		ParsedFunctionDeclExpr(_):
			True
		ParsedWhileExpr(_, _, _):
			True
		ParsedForExpr(_, _, _, _):
			True
		ParsedConcurrentBlockExpr(_, _, _):
			True
		ParsedConcurrentForExpr(_, _, _, _, _):
			True
		ParsedLambdaExpr(_, _, _, body, _):
			parsed_expr_ends_inside_block(table, body)
		ParsedDetachExpr(body, _):
			parsed_expr_ends_inside_block(table, body)
		ParsedUnaryExpr(_, inner, _):
			parsed_expr_ends_inside_block(table, inner)
		ParsedBinaryExpr(_, _, right, _):
			parsed_expr_ends_inside_block(table, right)
		ParsedRangeExpr(_, right, _):
			parsed_expr_ends_inside_block(table, right)
		ParsedLogicalExpr(_, _, right, _):
			parsed_expr_ends_inside_block(table, right)
		ParsedFieldAccessExpr(target, _, _):
			parsed_expr_ends_inside_block(table, target)
		ParsedOpaqueIntoExpr(_, inner, _):
			parsed_expr_ends_inside_block(table, inner)
		ParsedOpaqueFromExpr(_, inner, _):
			parsed_expr_ends_inside_block(table, inner)
		ParsedAssignExpr(_, value, _):
			parsed_expr_ends_inside_block(table, value)
		ParsedVarDeclExpr(_, _, value, _, _):
			parsed_expr_ends_inside_block(table, value)
		ParsedCompoundAssignExpr(_, _, value, _):
			parsed_expr_ends_inside_block(table, value)
		ParsedQuestionBindExpr(_, _, value, _):
			parsed_expr_ends_inside_block(table, value)
		ParsedTupleDestructExpr(_, value, _):
			parsed_expr_ends_inside_block(table, value)
		ParsedSubscriptAssignExpr(_, _, value, _):
			parsed_expr_ends_inside_block(table, value)
		ParsedCallExpr(_, args, span):
			last_item_ends_inside_block(table, args.last(), span)
		ParsedSubscriptExpr(_, indices, span):
			last_item_ends_inside_block(table, indices.last(), span)
		ParsedListExpr(items, span):
			last_item_ends_inside_block(table, items.last(), span)
		ParsedTupleExpr(items, span):
			last_item_ends_inside_block(table, items.last(), span)
		ParsedVectorExpr(items, span):
			last_item_ends_inside_block(table, items.last(), span)
		ParsedRecordExpr(fields, span):
			last_item_ends_inside_block(
				table,
				fields.last().map(
					func(field): field.value,
				),
				span,
			)
		ParsedRecordUpdateExpr(_, fields, span):
			last_item_ends_inside_block(
				table,
				fields.last().map(
					func(field): field.value,
				),
				span,
			)
		ParsedDictExpr(entries, span):
			last_item_ends_inside_block(
				table,
				entries.last().map(
					func(entry): entry.value,
				),
				span,
			)
		_:
			False


---
The last line holding an expression's own text. A match's span runs to the
line that dedents it, which may hold an enclosing call's `)`, so its text ends
with its last case instead; blocks, lambdas and bindings end with their last
part.
---
private pure func parsed_expr_text_end_line(table: SourceTable, expr: ParsedExpr) -> Int:
	match expr:
		ParsedMatchExpr(_, cases, _):
			match cases.last():
				Some(last_case):
					parsed_expr_text_end_line(table, last_case.body)
				None:
					expr_end_line(table, expr)
		ParsedBlockExpr(items, _):
			match items.last():
				Some(last_item):
					parsed_expr_text_end_line(table, last_item)
				None:
					expr_end_line(table, expr)
		ParsedLambdaExpr(_, _, _, body, _):
			parsed_expr_text_end_line(table, body)
		ParsedAssignExpr(_, value, _):
			parsed_expr_text_end_line(table, value)
		ParsedVarDeclExpr(_, _, value, _, _):
			parsed_expr_text_end_line(table, value)
		_:
			expr_end_line(table, expr)


--- Whether a bracketed expression's last item ends inside a block on its closing line.
private pure func last_item_ends_inside_block(
	table: SourceTable,
	last_item: Option[ParsedExpr],
	span: SourceLocation,
) -> Bool:
	match last_item:
		Some(item):
			(
				parsed_expr_text_end_line(table, item) == span_end_line(table, span)
				and parsed_expr_ends_inside_block(table, item)
			)
		None:
			False


private pure func expr_item_extent(table: SourceTable, expr: ParsedExpr) -> ParsedItemExtent:
	{
		span = parsed_expr_location(expr),
		ending_block_column = ending_block_column(table, expr),
		ends_inside_block = parsed_expr_ends_inside_block(table, expr)
	}


private pure func value_item_extent(
	table: SourceTable,
	span: SourceLocation,
	value: ParsedExpr,
) -> ParsedItemExtent:
	{
		span = span,
		ending_block_column = ending_block_column(table, value),
		ends_inside_block = parsed_expr_ends_inside_block(table, value)
	}


private pure func param_item_extent(param: ParsedParam) -> ParsedItemExtent:
	{
		span = param.span,
		ending_block_column = None,
		ends_inside_block = False
	}


--- A projected item paired with where its parsed form sits.
record LocatedItem[T] {
	item: T,
	extent: ParsedItemExtent
}


-- A typed constructor: a generic record literal inside a lambda fails to
-- typecheck ("matched record type has no field metadata").
private pure func located_item[T](item: T, extent: ParsedItemExtent) -> LocatedItem[T]:
	{
		item = item,
		extent = extent
	}


--- Commented items and the whole-line comments after the last one.
record CommentedItems[T] {
	items: List[CommentedItem[T]],
	closing: List[String]
}


private pure func commented_items_have_comments[T](commented: CommentedItems[T]) -> Bool:
	var found: Bool = commented.closing.length() > 0

	for item in commented.items:
		if item.comments.leading.length() > 0 or item.comments.trailing.is_some():
			found = True
			break

	found


private pure func plain_items[T](commented: CommentedItems[T]) -> List[T]:
	commented.items.map(func(item): item.item)


---
Claim the comments written among a call's or collection's items by position.
An item owns the whole-line comments after the previous item (or after
`open_line`, the line of the opening bracket) and above it. It also owns the
comment ending its last line when no other item starts on that line and the
line does not end inside a nested block (see `parsed_expr_ends_inside_block`).
The first item also owns the comment ending the opening bracket's line when it
starts on a later line, so no nested item shares that line; that comment moves
to its own line above the item. The closing comments are the whole-line comments after the
last item above `close_line`, the closing bracket's line; the comment ending
that line belongs to whatever encloses the collection. Every comment kept here
is re-indented to the item column.
---
private pure func collection_item_comments[T](
	table: SourceTable,
	comments: List[FormatterComment],
	open_line: Int,
	close_line: Int,
	items: List[LocatedItem[T]],
) -> CommentedItems[T]:
	var commented: List[CommentedItem[T]] = []
	var preceding: PrecedingBody = line_as_preceding_body(open_line)
	var index: Int = 0

	for located in items:
		span: SourceSpan = source_location_span(table, located.extent.span)
		end_line: Int = span_end_line(table, located.extent.span)

		next_start_line: Int = match items.get(index + 1):
			Some(next):
				source_location_span(table, next.extent.span).start_line
			None:
				close_line

		claims_trailing: Bool = not located.extent.ends_inside_block and end_line < next_start_line

		trailing: Option[String] = if claims_trailing:
			trailing_comment_on_line(comments, end_line)
		else:
			None

		var leading: List[String] = whole_line_comments_after(
			comments,
			preceding,
			span.start_line - 1,
			0,
		)

		if index == 0 and span.start_line > open_line:
			match trailing_comment_on_line(comments, open_line):
				Some(comment):
					leading = [comment].concat(leading)
				None:
					void

		commented = commented.append({
			item = located.item,
			comments = {
				leading = leading,
				trailing = trailing
			},
		})
		preceding = {
			end_line = end_line,
			block_column = located.extent.ending_block_column
		}
		index += 1

	{
		items = commented,
		closing = whole_line_comments_after(comments, preceding, close_line - 1, 0)
	}


---
Project items without claiming comments, for a declaration that has none:
locating items costs span lookups per item, which most declarations never need.
---
private pure func plain_exprs(table: SourceTable, exprs: List[ParsedExpr]) -> List[Expression]:
	exprs.map(func(expr): project_expr(table, expr))


private pure func plain_record_field(
	table: SourceTable,
	field: ParsedRecordExprField,
) -> (String, Expression):
	(field.name.text, project_expr(table, field.value))


private pure func plain_dict_entry(
	table: SourceTable,
	entry: ParsedDictEntry,
) -> (Expression, Expression):
	(project_expr(table, entry.key), project_expr(table, entry.value))


private pure func located_exprs(
	table: SourceTable,
	exprs: List[ParsedExpr],
	comments: List[FormatterComment],
) -> List[LocatedItem[Expression]]:
	exprs.map(func(expr): located_item(
			project_expr_with_comments(table, expr, comments),
			expr_item_extent(table, expr),
		))


private pure func located_record_fields(
	table: SourceTable,
	fields: List[ParsedRecordExprField],
	comments: List[FormatterComment],
) -> List[LocatedItem[(String, Expression)]]:
	fields.map(func(field): located_item(
			(field.name.text, project_expr_with_comments(table, field.value, comments)),
			value_item_extent(table, field.span, field.value),
		))


private pure func located_dict_entries(
	table: SourceTable,
	entries: List[ParsedDictEntry],
	comments: List[FormatterComment],
) -> List[LocatedItem[(Expression, Expression)]]:
	entries.map(func(entry): located_item(
			(
				project_expr_with_comments(table, entry.key, comments),
				project_expr_with_comments(table, entry.value, comments),
			),
			value_item_extent(table, entry.span, entry.value),
		))


private pure func same_parsed_logical_op(left: ParsedLogicalOp, right: ParsedLogicalOp) -> Bool:
	match (left, right):
		(ParsedAndOp, ParsedAndOp):
			True
		(ParsedOrOp, ParsedOrOp):
			True
		_:
			False


--- The terms of a chain of one logical operator, as the renderer flattens them.
private pure func parsed_logical_chain_terms(
	expr: ParsedExpr,
	op: ParsedLogicalOp,
) -> List[ParsedExpr]:
	match expr:
		ParsedLogicalExpr(inner_op, left, right, _):
			if same_parsed_logical_op(inner_op, op):
				parsed_logical_chain_terms(left, op).concat(parsed_logical_chain_terms(right, op))
			else:
				[expr]
		_:
			[expr]


--- Fold chain terms back into a logical expression; the renderer flattens it again.
private pure func logical_chain_of(op: LogicalOp, terms: List[Expression]) -> Expression:
	match terms:
		[first, ...rest]:
			var chain: Expression = first

			for term in rest:
				chain = LogicalExpression(op, chain, term)

			chain
		[]:
			-- A chain has at least two terms.
			VoidExpression


---
Project an `and` or `or` chain with the comments written among its terms (see
`collection_item_comments`). A term claims the whole-line comments above it
and the comment ending its line when the next term starts on a later line. The
chain starts on its first term's line, so no comment claimed on the opening
line precedes it. The first term's leading comments and the last term's
trailing comment fall outside the chain's span: a block header or statement
owns the last line, and the parentheses around a broken chain are not in the
parsed tree.
---
private pure func project_logical_chain(
	table: SourceTable,
	parsed_op: ParsedLogicalOp,
	expr: ParsedExpr,
	comments: List[FormatterComment],
) -> Expression:
	op: LogicalOp = project_logical_op(parsed_op)
	parsed_terms: List[ParsedExpr] = parsed_logical_chain_terms(expr, parsed_op)

	if comments.length() == 0:
		logical_chain_of(
			op,
			plain_exprs(table, parsed_terms),
		)
	else:
		terms: CommentedItems[Expression] = collection_item_comments(
			table,
			comments,
			source_location_span(table, parsed_expr_location(expr)).start_line,
			expr_end_line(table, expr),
			located_exprs(table, parsed_terms, comments),
		)

		if terms.commented_items_have_comments():
			CommentedLogicalExpression(op, terms.items)
		else:
			logical_chain_of(op, terms.plain_items())


private pure func project_call_expr(
	table: SourceTable,
	callee: ParsedExpr,
	args: List[ParsedExpr],
	comments: List[FormatterComment],
	span: SourceLocation,
) -> Expression:
	projected_callee: Expression = project_expr_with_comments(table, callee, comments)

	if comments.length() == 0:
		CallExpression(
			projected_callee,
			plain_exprs(table, args),
		)
	else:
		commented: CommentedItems[Expression] = collection_item_comments(
			table,
			comments,
			expr_end_line(table, callee),
			span_end_line(table, span),
			located_exprs(table, args, comments),
		)

		if commented.commented_items_have_comments():
			CommentedCollectionExpression(
				CommentedCall(projected_callee, commented.items),
				commented.closing,
			)
		else:
			CallExpression(projected_callee, commented.plain_items())


private pure func project_subscript_expr(
	table: SourceTable,
	target: ParsedExpr,
	indices: List[ParsedExpr],
	comments: List[FormatterComment],
	span: SourceLocation,
) -> Expression:
	projected_target: Expression = project_expr_with_comments(table, target, comments)

	if comments.length() == 0:
		match plain_exprs(table, indices):
			[index]:
				SubscriptExpression(projected_target, index)
			projected:
				MultiSubscriptExpression(projected_target, projected)
	else:
		commented: CommentedItems[Expression] = collection_item_comments(
			table,
			comments,
			expr_end_line(table, target),
			span_end_line(table, span),
			located_exprs(table, indices, comments),
		)

		if commented.commented_items_have_comments():
			CommentedCollectionExpression(
				CommentedSubscript(projected_target, commented.items),
				commented.closing,
			)
		else:
			match commented.plain_items():
				[index]:
					SubscriptExpression(projected_target, index)
				projected:
					MultiSubscriptExpression(projected_target, projected)


--- The shapes of collection literals whose items are plain expressions.
fixed union ExpressionCollectionShape:
	ListShape
	TupleShape
	VectorShape


private pure func project_expression_collection(
	table: SourceTable,
	shape: ExpressionCollectionShape,
	items: List[ParsedExpr],
	comments: List[FormatterComment],
	span: SourceLocation,
) -> Expression:
	if comments.length() == 0:
		match shape:
			ListShape:
				ListExpression(plain_exprs(table, items))
			TupleShape:
				TupleExpression(plain_exprs(table, items))
			VectorShape:
				VectorExpression(plain_exprs(table, items))
	else:
		commented: CommentedItems[Expression] = collection_item_comments(
			table,
			comments,
			source_location_span(table, span).start_line,
			span_end_line(table, span),
			located_exprs(table, items, comments),
		)

		if commented.commented_items_have_comments():
			collection: CommentedCollection = match shape:
				ListShape:
					CommentedList(commented.items)
				TupleShape:
					CommentedTuple(commented.items)
				VectorShape:
					CommentedVector(commented.items)

			CommentedCollectionExpression(collection, commented.closing)
		else:
			projected: List[Expression] = commented.plain_items()

			match shape:
				ListShape:
					ListExpression(projected)
				TupleShape:
					TupleExpression(projected)
				VectorShape:
					VectorExpression(projected)


private pure func project_record_expr(
	table: SourceTable,
	fields: List[ParsedRecordExprField],
	comments: List[FormatterComment],
	span: SourceLocation,
) -> Expression:
	if comments.length() == 0:
		RecordExpression(fields.map(
			func(field): plain_record_field(table, field),
		))
	else:
		commented: CommentedItems[(String, Expression)] = collection_item_comments(
			table,
			comments,
			source_location_span(table, span).start_line,
			span_end_line(table, span),
			located_record_fields(table, fields, comments),
		)

		if commented.commented_items_have_comments():
			CommentedCollectionExpression(CommentedRecord(commented.items), commented.closing)
		else:
			RecordExpression(commented.plain_items())


private pure func project_record_update_expr(
	table: SourceTable,
	base: ParsedExpr,
	fields: List[ParsedRecordExprField],
	comments: List[FormatterComment],
	span: SourceLocation,
) -> Expression:
	projected_base: Expression = project_expr_with_comments(table, base, comments)

	if comments.length() == 0:
		RecordUpdateExpression(
			projected_base,
			fields.map(func(field): plain_record_field(table, field)),
		)
	else:
		commented: CommentedItems[(String, Expression)] = collection_item_comments(
			table,
			comments,
			expr_end_line(table, base),
			span_end_line(table, span),
			located_record_fields(table, fields, comments),
		)

		if commented.commented_items_have_comments():
			CommentedCollectionExpression(
				CommentedRecordUpdate(projected_base, commented.items),
				commented.closing,
			)
		else:
			RecordUpdateExpression(projected_base, commented.plain_items())


private pure func project_dict_expr(
	table: SourceTable,
	entries: List[ParsedDictEntry],
	comments: List[FormatterComment],
	span: SourceLocation,
) -> Expression:
	if comments.length() == 0:
		DictionaryExpression(entries.map(
			func(entry): plain_dict_entry(table, entry),
		))
	else:
		commented: CommentedItems[(Expression, Expression)] = collection_item_comments(
			table,
			comments,
			source_location_span(table, span).start_line,
			span_end_line(table, span),
			located_dict_entries(table, entries, comments),
		)

		if commented.commented_items_have_comments():
			CommentedCollectionExpression(CommentedDictionary(commented.items), commented.closing)
		else:
			DictionaryExpression(commented.plain_items())


---
The body before a group of comments that a match case, an `else` or a
collection item claims: the previous case body, the `then` block, the previous
item, or none at a header or opening bracket. Usually no
whole-line comment can sit on its last line (`end_line`). The exception is a
body ending with a nested match, whose span runs to the line that dedents it,
which may be a comment line. A body block claims a comment on that line at or
right of its statements (`block_column`), because a block claims comments up
to its last line; a comment left of them belongs to what follows the body.
---
record PrecedingBody {
	end_line: Int,
	block_column: Option[Int]
}


---
A line holding a header or an opening bracket, as the body before the first
member. No whole-line comment shares it and no block claims one there.
---
private pure func line_as_preceding_body(header_line: Int) -> PrecedingBody:
	{
		end_line = header_line,
		block_column = None
	}


--- The statement column of the block that ends `expr`, directly or as a lambda body.
private pure func ending_block_column(table: SourceTable, expr: ParsedExpr) -> Option[Int]:
	match expr:
		ParsedBlockExpr(items, _):
			Some(block_comment_column(table, items))
		ParsedLambdaExpr(_, _, _, body, _):
			ending_block_column(table, body)
		_:
			None


private pure func preceding_body(
	table: SourceTable,
	body: ParsedExpr,
	end_line: Int,
) -> PrecedingBody:
	{
		end_line = end_line,
		block_column = ending_block_column(table, body)
	}


private pure func follows_preceding_body(
	preceding: PrecedingBody,
	comment: FormatterComment,
) -> Bool:
	if comment.line > preceding.end_line:
		True
	else if comment.line == preceding.end_line:
		match preceding.block_column:
			Some(column):
				comment.column < column
			None:
				True
	else:
		False


---
The whole-line comments at or right of `min_column` after `preceding` up to
and including `last_line`, in source order.
---
private pure func whole_line_comments_after(
	comments: List[FormatterComment],
	preceding: PrecedingBody,
	last_line: Int,
	min_column: Int,
) -> List[String]:
	var texts: List[String] = []

	for comment in comments:
		if (
			not comment.trailing
			and comment.line <= last_line
			and comment.column >= min_column
			and preceding.follows_preceding_body(comment)
		):
			texts = texts.append(comment.text_value)

	texts


---
The comment ending a control-flow header (`if cond:`, `while cond:`, `for x in
xs:`): the first trailing comment from the header expression's last line to
the line above the body block, since a closing parenthesis may sit on a line
of its own. The parser requires these bodies to start on a later line.
---
private pure func header_trailing_comment(
	table: SourceTable,
	header: ParsedExpr,
	body: ParsedExpr,
	comments: List[FormatterComment],
) -> Option[String]:
	match body:
		ParsedBlockExpr(_, span):
			header_end_line: Int = expr_end_line(table, header)
			body_start_line: Int = source_location_span(table, span).start_line
			var found: Option[String] = None

			for comment in comments:
				if (
					found.is_none()
					and comment.trailing
					and comment.line >= header_end_line
					and comment.line < body_start_line
				):
					found = Some(comment.text_value)

			found
		_:
			None


---
Project a match case body. A body on the pattern's line (`Some(v): v -- note`)
is not a block, so no block item claims the comment ending that line; the case
keeps it on the body, which the renderer moves below the pattern. A nested
`match` or `if` claims its own header comment.
---
private pure func project_match_case_body(
	table: SourceTable,
	body: ParsedExpr,
	comments: List[FormatterComment],
) -> Expression:
	projected: Expression = project_expr_with_comments(table, body, comments)

	match body:
		ParsedBlockExpr(_, _):
			projected
		ParsedMatchExpr(_, _, _):
			projected
		ParsedIfExpr(_, _, _, _):
			projected
		_:
			match trailing_comment_for_expr(table, comments, body):
				Some(comment):
					ItemBlockExpression([BlockExpressionItem(False, projected, Some(comment))])
				None:
					projected


---
The comment ending a case's `pattern:` line, when the case owns it: only a
case whose body starts on a later line. A body on the same line claims that
comment itself.
---
private pure func match_case_pattern_trailing_comment(
	table: SourceTable,
	case_value: ParsedMatchCase,
	comments: List[FormatterComment],
) -> Option[String]:
	match case_value.body:
		ParsedBlockExpr(_, _):
			trailing_comment_on_line(
				comments,
				span_end_line(table, parsed_pattern_location(case_value.pattern)),
			)
		_:
			None


---
A match's projected cases and the comments after its last case.
---
record ProjectedMatchCases {
	cases: List[MatchCase],
	closing_comments: List[String]
}


---
Project a match's cases with the comments written among them. No enclosing
block claims these: a block claims only comments between its own statements,
and the match span covers every line up to the first one indented left of its
cases, comment lines included. A case owns the whole-line comments at or right
of the case column from the end of the previous case (or the header line) to
its pattern (see `PrecedingBody` for the line where the previous case ends). A
body block's span ends at its last statement, so a comment after that
statement, even at the body's indentation, falls in the next case's region, or
in the closing comments after the last case, and is re-indented to the case
column. The column bound keeps a nested match from claiming comments that sit
left of its own cases, which belong to an enclosing match or block.
---
private pure func project_match_cases(
	table: SourceTable,
	cases: List[ParsedMatchCase],
	comments: List[FormatterComment],
	header_line: Int,
	match_end_line: Int,
) -> ProjectedMatchCases:
	case_column: Int = match cases.get(0):
		Some(first):
			source_location_span(table, first.span).start_column
		None:
			0

	var projected: List[MatchCase] = []
	var preceding: PrecedingBody = line_as_preceding_body(header_line)

	for case_value in cases:
		span: SourceSpan = source_location_span(table, case_value.span)
		case_comments: MemberComments = {
			leading = whole_line_comments_after(
				comments,
				preceding,
				span.start_line - 1,
				case_column,
			),
			trailing = match_case_pattern_trailing_comment(table, case_value, comments)
		}
		projected = projected.append(
			MatchCaseData(
				project_pattern(case_value.pattern),
				project_match_case_body(table, case_value.body, comments),
				case_comments,
			),
		)
		preceding = preceding_body(
			table,
			case_value.body,
			span_end_line(table, case_value.span),
		)

	{
		cases = projected,
		closing_comments = whole_line_comments_after(
			comments,
			preceding,
			match_end_line,
			case_column,
		)
	}


---
The comments of an `else` keyword: the whole-line comments at or right of it
after the `then` block (see `PrecedingBody`), and the comment ending an
`else:` line. After `else if` the nested `if` claims its header comment.
---
private pure func else_keyword_comments(
	table: SourceTable,
	then_expr: ParsedExpr,
	branch: ParsedElseBranch,
	comments: List[FormatterComment],
) -> MemberComments:
	keyword: SourceSpan = source_location_span(table, branch.keyword)

	trailing: Option[String] = match branch.body:
		ParsedBlockExpr(_, _):
			trailing_comment_on_line(comments, keyword.start_line)
		_:
			None

	{
		leading = whole_line_comments_after(
			comments,
			preceding_body(
				table,
				then_expr,
				expr_end_line(table, then_expr),
			),
			keyword.start_line - 1,
			keyword.start_column,
		),
		trailing = trailing
	}


private pure func project_if_expr(
	table: SourceTable,
	cond: ParsedExpr,
	then_expr: ParsedExpr,
	else_expr: Option[ParsedElseBranch],
	comments: List[FormatterComment],
) -> Expression:
	projected_cond: Expression = project_expr_with_comments(table, cond, comments)
	projected_then: Expression = project_expr_with_comments(table, then_expr, comments)
	header_comment: Option[String] = header_trailing_comment(table, cond, then_expr, comments)

	match else_expr:
		Some(branch):
			IfElseExpression(
				projected_cond,
				projected_then,
				project_expr_with_comments(table, branch.body, comments),
				header_comment,
				else_keyword_comments(table, then_expr, branch, comments),
			)
		None:
			IfExpression(projected_cond, projected_then, header_comment)


private pure func project_match_expr(
	table: SourceTable,
	value: ParsedExpr,
	cases: List[ParsedMatchCase],
	comments: List[FormatterComment],
	span: SourceLocation,
) -> Expression:
	header_line: Int = expr_end_line(table, value)
	projected: ProjectedMatchCases = project_match_cases(
		table,
		cases,
		comments,
		header_line,
		span_end_line(table, span),
	)
	MatchExpression(
		project_expr_with_comments(
			table,
			value,
			comments,
		),
		projected.cases,
		{
			header_trailing = trailing_comment_on_line(comments, header_line),
			closing = projected.closing_comments
		},
	)


private pure func project_select_arm(
	table: SourceTable,
	arm: ParsedSelectArm,
	comments: List[FormatterComment],
) -> SelectArm:
	body: Expression = project_expr_with_comments(table, arm.body, comments)

	match arm.kind:
		ParsedSelectReceiveArm(name, channel):
			SelectRecvArm(
				name.text,
				project_expr_with_comments(table, channel, comments),
				body,
			)
		ParsedSelectAfterArm(timeout):
			SelectAfterArm(
				project_expr_with_comments(table, timeout, comments),
				body,
			)
		ParsedSelectSealedArm(channel):
			SelectSealedArm(
				project_expr_with_comments(table, channel, comments),
				body,
			)


private pure func project_select_arms(
	table: SourceTable,
	arms: List[ParsedSelectArm],
	comments: List[FormatterComment],
) -> List[SelectArm]:
	var projected: List[SelectArm] = []

	for arm in arms:
		projected = projected.append(project_select_arm(table, arm, comments))

	projected


private pure func project_for_binder_name(binder: ParsedForBinder) -> Option[String]:
	match binder:
		ParsedForNameBinder(name):
			Some(name.text)
		ParsedForTupleBinder(_, _):
			None


private pure func project_for_binder_names(binder: ParsedForBinder) -> List[String]:
	match binder:
		ParsedForNameBinder(name):
			[name.text]
		ParsedForTupleBinder(names, _):
			var projected: List[String] = []

			for name in names:
				projected = projected.append(name.text)

			projected


private pure func annotation_present(
	annotations: List[ParsedFunctionAnnotation],
	target: ParsedFunctionAnnotation,
) -> Bool:
	var found: Bool = False

	for annotation in annotations:
		if annotation == target:
			found = True
			break

	found


private pure func function_body(
	table: SourceTable,
	body: Option[ParsedExpr],
	comments: List[FormatterComment],
) -> FunctionBody:
	match body:
		None:
			NoFunctionBody
		Some(ParsedBuiltinExpr(name, _)):
			BuiltinFunctionBody(name)
		Some(body):
			ExpressionFunctionBody(project_expr_with_comments(table, body, comments))


private pure func project_function_declaration_expr(
	table: SourceTable,
	decl: ParsedFunctionDecl,
	comments: List[FormatterComment],
) -> Expression:
	body: Expression = match decl.body:
		Some(expr):
			project_expr_with_comments(table, expr, comments)
		None:
			VoidExpression

	params: List[FunctionParameter] = project_function_params(
		table,
		comments,
		decl.name,
		decl.params,
		decl.return_type,
		decl.body,
	)
	type_params: List[String] = type_param_names(decl.type_params)
	where_constraints: List[TypeConstraint] = project_dim_constraints(decl.dim_constraints)

	match decl.return_type:
		Some(return_type):
			TypedFunctionDeclarationExpression(
				decl.name.text,
				decl.is_pure,
				type_params,
				params,
				project_type_expr(return_type),
				where_constraints,
				body,
			)
		None:
			FunctionDeclarationExpression(
				decl.name.text,
				decl.is_pure,
				type_params,
				params,
				where_constraints,
				body,
			)


-- Strings are byte-indexed and `append_char` re-encodes a byte above 0x7F as
-- a Unicode code point, which double-encodes multi-byte UTF-8 sequences.
-- Interpolation text is therefore copied byte-for-byte from the source, a
-- maximal verbatim run at a time. Both run helpers start past the first byte so
-- a run always advances.
private pure func append_source_bytes(
	target: String,
	text: String,
	start: Int,
	count: Int,
) -> String:
	target + text.substring(start, count)


private pure func plain_literal_run_end(text: String, start: Int) -> Int:
	var index: Int = start + 1

	while index < text.length():
		ch: Char = text.get_or(index, '\0')

		if ch == '\\' or ch == '{':
			break

		index += 1

	index


private pure func plain_expr_run_end(text: String, start: Int, in_string: Bool) -> Int:
	var index: Int = start + 1

	while index < text.length():
		ch: Char = text.get_or(index, '\0')

		if ch == '\\' or ch == '\"':
			break

		if not in_string and (ch == '{' or ch == '}'):
			break

		index += 1

	index


private pure func split_interpolation_text(
	table: SourceTable,
	span: SourceLocation,
	text: String,
) -> Result[List[StringInterpolationPart], String]:
	resolved_span: SourceSpan = source_location_span(table, span)
	var parts: List[StringInterpolationPart] = []
	var literal: String = ""
	var i: Int = 0
	var error: Option[String] = None

	while i < text.length() and error.is_none():
		ch: Char = text.get_or(i, '\0')

		if ch == '\\' and i + 1 < text.length():
			next: Char = text.get_or(i + 1, '\0')

			match next:
				'n':
					literal += "\n"
					i += 2
				't':
					literal += "\t"
					i += 2
				'r':
					literal += "\r"
					i += 2
				'{':
					literal += "{"
					i += 2
				'}':
					literal += "}"
					i += 2
				_:
					literal = append_source_bytes(literal, text, i, 2)
					i += 2
		else if ch == '{':
			if literal.length() > 0:
				parts = parts.append(StringInterpolationTextPart(literal))
				literal = ""

			var depth: Int = 1
			var expr_text: String = ""
			var in_string: Bool = False
			i += 1

			while i < text.length() and depth > 0:
				current: Char = text.get_or(i, '\0')

				if current == '\\' and i + 1 < text.length():
					expr_text = append_source_bytes(expr_text, text, i, 2)
					i += 2
				else if current == '\"':
					in_string = not in_string
					expr_text = append_source_bytes(expr_text, text, i, 1)
					i += 1
				else if not in_string and current == '{':
					depth += 1
					expr_text = append_source_bytes(expr_text, text, i, 1)
					i += 1
				else if not in_string and current == '}':
					depth -= 1

					if depth > 0:
						expr_text = append_source_bytes(expr_text, text, i, 1)

					i += 1
				else:
					run_end: Int = plain_expr_run_end(text, i, in_string)
					expr_text = append_source_bytes(expr_text, text, i, run_end - i)
					i = run_end

			if depth > 0:
				error = Some("Unclosed `" + "$" + "{` in string interpolation")
			else:
				match parse_interpolation_expr(
					resolved_span.path,
					resolved_span.module_name,
					expr_text,
				):
					Ok(expr):
						parts = parts.append(StringInterpolationExpressionPart(expr))
					Err(message):
						error = Some(message)
		else:
			run_end: Int = plain_literal_run_end(text, i)
			literal = append_source_bytes(literal, text, i, run_end - i)
			i = run_end

	if literal.length() > 0 and error.is_none():
		parts = parts.append(StringInterpolationTextPart(literal))

	match error:
		Some(message):
			Err(message)
		None:
			Ok(parts)


private pure func parse_interpolation_expr(
	path: String,
	module_name: String,
	text: String,
) -> Result[Expression, String]:
	wrapper: String = "___interp_temp = " + text + "\n"
	wrapper_source: SourceFile = source_file(path, module_name, wrapper)
	program: ParsedProgram = parse_compiler_source(wrapper_source)
	table: SourceTable = source_table_for_file(program.source)

	match first_parse_error(program.diagnostics):
		Some(message):
			Err("Parse error in interpolated expression: " + message)
		None:
			match program.decls:
				[VarParsedDecl(var_decl)]:
					Ok(project_expr(table, var_decl.value))
				_:
					Err("Failed to parse interpolated expression: " + text)


private pure func first_parse_error(diagnostics: List[ParseDiagnostic]) -> Option[String]:
	var message: Option[String] = None

	for diagnostic in diagnostics:
		if message.is_none():
			message = Some(parse_diagnostic_to_string(diagnostic))

	message


private pure func project_parsed_string_interpolation_part(
	table: SourceTable,
	part: ParsedStringInterpolationPart,
) -> StringInterpolationPart:
	match part:
		ParsedInterpolationLiteral(value):
			StringInterpolationTextPart(value)
		ParsedInterpolationExpr(expr, _):
			StringInterpolationExpressionPart(project_expr(table, expr))


private pure func project_parsed_string_interpolation_parts(
	table: SourceTable,
	parts: List[ParsedStringInterpolationPart],
) -> List[StringInterpolationPart]:
	var projected: List[StringInterpolationPart] = []

	for part in parts:
		projected = projected.append(project_parsed_string_interpolation_part(table, part))

	projected


private pure func project_string_interpolation(
	table: SourceTable,
	value: String,
	is_multiline: Bool,
	span: SourceLocation,
) -> Expression:
	match split_interpolation_text(table, span, value):
		Ok(parts):
			StringInterpolationExpression(parts, is_multiline)
		Err(_):
			StringInterpolationExpression([StringInterpolationTextPart(value)], is_multiline)


private pure func project_expr_with_comments(
	table: SourceTable,
	expr: ParsedExpr,
	comments: List[FormatterComment],
) -> Expression:
	match expr:
		ParsedNameExpr(name):
			IdentifierExpression(name.text)
		ParsedIntLiteralExpr(value, _):
			LiteralExpression(int_literal(value))
		ParsedFloatLiteralExpr(value, _):
			LiteralExpression(FloatLiteral(value))
		ParsedStringLiteralExpr(value, form, _):
			LiteralExpression(project_literal_string(value, form))
		ParsedStringInterpolationExpr(value, is_multiline, span):
			project_string_interpolation(table, value, is_multiline, span)
		ParsedStringInterpolationPartsExpr(parts, is_multiline, _):
			StringInterpolationExpression(
				project_parsed_string_interpolation_parts(table, parts),
				is_multiline,
			)
		ParsedBoolLiteralExpr(value, _):
			LiteralExpression(BoolLiteral(value))
		ParsedCharLiteralExpr(value, _):
			LiteralExpression(CharLiteral(value))
		ParsedUnaryExpr(op, inner, _):
			UnaryExpression(
				project_unary_op(op),
				project_expr_with_comments(table, inner, comments),
			)
		ParsedBinaryExpr(op, left, right, _):
			BinaryExpression(
				project_binary_op(op),
				project_expr_with_comments(table, left, comments),
				project_expr_with_comments(table, right, comments),
			)
		ParsedLogicalExpr(op, _, _, _):
			project_logical_chain(table, op, expr, comments)
		ParsedRangeExpr(start, finish, _):
			RangeExpression(
				project_expr_with_comments(table, start, comments),
				project_expr_with_comments(table, finish, comments),
			)
		ParsedCallExpr(callee, args, span):
			project_call_expr(table, callee, args, comments, span)
		ParsedFieldAccessExpr(target, field_name, _):
			FieldAccessExpression(
				project_expr_with_comments(table, target, comments),
				field_name.text,
			)
		ParsedSubscriptExpr(target, indices, span):
			project_subscript_expr(table, target, indices, comments, span)
		ParsedListExpr(items, span):
			project_expression_collection(table, ListShape, items, comments, span)
		ParsedTupleExpr(items, span):
			project_expression_collection(table, TupleShape, items, comments, span)
		ParsedRecordExpr(fields, span):
			project_record_expr(table, fields, comments, span)
		ParsedRecordUpdateExpr(base, fields, span):
			project_record_update_expr(table, base, fields, comments, span)
		ParsedDictExpr(entries, span):
			project_dict_expr(table, entries, comments, span)
		ParsedVectorExpr(items, span):
			project_expression_collection(table, VectorShape, items, comments, span)
		ParsedOpaqueIntoExpr(type_expr, inner, _):
			OpaqueIntoExpression(
				project_type_expr(type_expr),
				project_expr_with_comments(table, inner, comments),
			)
		ParsedOpaqueFromExpr(type_expr, inner, _):
			OpaqueFromExpression(
				project_type_expr(type_expr),
				project_expr_with_comments(table, inner, comments),
			)
		ParsedBlockExpr(items, span):
			commented_block_expr(table, items, comments, span)
		ParsedIfExpr(cond, then_expr, else_expr, _):
			project_if_expr(table, cond, then_expr, else_expr, comments)
		ParsedMatchExpr(value, cases, span):
			project_match_expr(table, value, cases, comments, span)
		ParsedSelectExpr(arms, _):
			SelectExpression(project_select_arms(table, arms, comments))
		ParsedWithExpr(binding, body, _):
			project_with_expr(table, binding, body, comments)
		ParsedDebugBlockExpr(body, _):
			DebugBlockExpression(project_expr_with_comments(table, body, comments))
		ParsedLambdaExpr(is_pure, params, return_type, body, _):
			projected_params: List[FunctionParameter] = params.map(
				func(param): project_lambda_param(param),
			)

			match return_type:
				Some(type_expr):
					TypedLambdaExpression(
						is_pure,
						projected_params,
						project_type_expr(type_expr),
						project_expr_with_comments(table, body, comments),
					)
				None:
					LambdaExpression(
						is_pure,
						projected_params,
						project_expr_with_comments(table, body, comments),
					)
		ParsedFunctionDeclExpr(decl):
			project_function_declaration_expr(table, decl, comments)
		ParsedWhileExpr(cond, body, _):
			WhileExpression(
				project_expr_with_comments(table, cond, comments),
				project_expr_with_comments(table, body, comments),
				header_trailing_comment(table, cond, body, comments),
			)
		ParsedForExpr(binder, iterable, body, _):
			header_comment: Option[String] = header_trailing_comment(
				table,
				iterable,
				body,
				comments,
			)

			match project_for_binder_name(binder):
				Some(name):
					ForExpression(
						name,
						project_expr_with_comments(table, iterable, comments),
						project_expr_with_comments(table, body, comments),
						header_comment,
					)
				None:
					TupleForExpression(
						project_for_binder_names(binder),
						project_expr_with_comments(table, iterable, comments),
						project_expr_with_comments(table, body, comments),
						header_comment,
					)
		ParsedConcurrentBlockExpr(options, body, _):
			project_concurrent_expr(table, options, body, comments)
		ParsedConcurrentForExpr(name, iterable, options, body, _):
			project_concurrently_loop_expr(table, name.text, iterable, options, body, comments)
		ParsedDetachExpr(body, _):
			DetachExpression(project_expr_with_comments(table, body, comments))
		ParsedBreakExpr(_):
			BreakExpression
		ParsedContinueExpr(_):
			ContinueExpression
		ParsedVoidExpr(_):
			VoidExpression
		ParsedBuiltinExpr(name, _):
			match name:
				Some(value):
					BuiltinRuntimeExpression(value)
				None:
					BuiltinExpression
		ParsedVarDeclExpr(name, type_expr, value, is_mutable, _):
			match type_expr:
				Some(type_value):
					TypedVariableDeclarationExpression(
						name.text,
						is_mutable,
						project_type_expr(type_value),
						project_expr_with_comments(table, value, comments),
					)
				None:
					VariableDeclarationExpression(
						name.text,
						is_mutable,
						project_expr_with_comments(table, value, comments),
					)
		ParsedAssignExpr(name, value, _):
			AssignmentExpression(
				name.text,
				project_expr_with_comments(table, value, comments),
			)
		ParsedCompoundAssignExpr(name, op, value, _):
			CompoundAssignmentExpression(
				name.text,
				project_compound_assign_op(op),
				project_expr_with_comments(table, value, comments),
			)
		ParsedSubscriptAssignExpr(target, indices, value, _):
			var projected_indices: List[Expression] = []

			for index in indices:
				projected_indices = projected_indices.append(
					project_expr_with_comments(
						table,
						index,
						comments,
					),
				)

			SubscriptAssignmentExpression(
				project_expr_with_comments(table, target, comments),
				projected_indices,
				project_expr_with_comments(table, value, comments),
			)
		ParsedTupleDestructExpr(names, value, _):
			var projected_names: List[String] = []

			for name in names:
				projected_names = projected_names.append(name.text)

			TupleDestructureExpression(
				projected_names,
				project_expr_with_comments(table, value, comments),
			)
		ParsedQuestionBindExpr(name, type_expr, value, _):
			match type_expr:
				Some(type_value):
					TypedQuestionBindExpression(
						name.text,
						project_type_expr(type_value),
						project_expr_with_comments(table, value, comments),
					)
				None:
					QuestionBindExpression(
						name.text,
						project_expr_with_comments(table, value, comments),
					)
		ParsedMissingExpr(_):
			VoidExpression


pure func project_expr(table: SourceTable, expr: ParsedExpr) -> Expression:
	project_expr_with_comments(table, expr, [])


private pure func project_with_expr(
	table: SourceTable,
	binding: ParsedWithBinding,
	body: ParsedExpr,
	comments: List[FormatterComment],
) -> Expression:
	is_try: Bool = binding.kind == ParsedWithTryBinding

	error_name: Option[String] = match binding.error_map:
		Some(error_map):
			Some(error_map.name.text)
		None:
			None

	error_value: Option[Expression] = match binding.error_map:
		Some(error_map):
			Some(project_expr_with_comments(table, error_map.value, comments))
		None:
			None

	WithExpression(
		binding.name.text,
		option_type_expr(binding.type_expr),
		is_try,
		project_expr_with_comments(table, binding.value, comments),
		error_name,
		error_value,
		project_expr_with_comments(table, body, comments),
	)


private pure func concurrent_timeout_expr(
	table: SourceTable,
	timeout: Option[ParsedExpr],
	comments: List[FormatterComment],
) -> Option[Expression]:
	timeout.map(func(expr): project_expr_with_comments(table, expr, comments))


private pure func project_concurrent_expr(
	table: SourceTable,
	options: ParsedConcurrentBlockOptions,
	body: ParsedExpr,
	comments: List[FormatterComment],
) -> Expression:
	max_threads: Option[Int] = match options.max_threads:
		DefaultThreadLimit:
			None
		ThreadLimit(count):
			Some(count)

	ConcurrentExpression(
		block_exprs_for_concurrent(table, body, comments),
		concurrent_timeout_expr(table, options.timeout, comments),
		max_threads,
	)


private pure func project_concurrently_loop_expr(
	table: SourceTable,
	name: String,
	iterable: ParsedExpr,
	options: ParsedConcurrentForOptions,
	body: ParsedExpr,
	comments: List[FormatterComment],
) -> Expression:
	-- The formatter refuses buffers with parse errors, so `MissingLimit` (a
	-- header the parser rejected) never reaches here; 0 only keeps the match total.
	limit: Int = match options.limit:
		WrittenLimit(count):
			count
		MissingLimit:
			0

	ConcurrentlyLoopExpression(
		name,
		project_expr_with_comments(table, iterable, comments),
		project_expr_with_comments(table, body, comments),
		concurrent_timeout_expr(table, options.timeout, comments),
		ConcurrentlyLoopLimit(limit),
	)


private pure func option_doc(doc: Option[String], decl: Declaration) -> Declaration:
	match doc:
		Some(text):
			DocumentedDeclaration(PlainDeclarationDoc(text), decl)
		None:
			decl


private pure func project_import_symbol(symbol: ParsedImportSymbol) -> ImportSymbol:
	var ctors: List[String] = []

	for ctor in symbol.constructors:
		ctors = ctors.append(ctor.text)

	ctor_imports: Option[List[String]] = if ctors.length() == 0:
		None
	else:
		Some(ctors)

	{
		name = symbol.name.text,
		alias_name = symbol.symbol_alias.map(func(name): name.text),
		ctors = ctor_imports
	}


private pure func project_import_symbols(
	symbols: Option[List[ParsedImportSymbol]],
) -> Option[List[ImportSymbol]]:
	match symbols:
		Some(items):
			var projected: List[ImportSymbol] = []

			for item in items:
				projected = projected.append(project_import_symbol(item))

			Some(projected)
		None:
			None


private pure func project_import_item(item: ParsedImportDecl) -> ImportItem:
	{
		module_name = item.module_path,
		alias_name = item.module_alias.map(func(name): name.text),
		symbols = project_import_symbols(item.symbols)
	}


private pure func located_decl(
	table: SourceTable,
	span: SourceLocation,
	declaration: Declaration,
) -> LocatedDeclaration:
	resolved: SourceSpan = source_location_span(table, span)
	{
		line = resolved.start_line,
		column = resolved.start_column,
		end_line = span_end_line(table, span),
		declaration = declaration
	}


private pure func no_member_comments() -> MemberComments:
	{
		leading = [],
		trailing = None
	}


--- A declaration member's extent: it never ends inside a nested block.
private pure func declaration_member_extent(span: SourceLocation) -> ParsedItemExtent:
	{
		span = span,
		ending_block_column = None,
		ends_inside_block = False
	}


private pure func project_type_variant(
	variant: ParsedVariantDecl,
	comments: MemberComments,
) -> TypeVariant:
	var fields: List[TypeExpression] = []

	for field in variant.fields:
		fields = fields.append(project_type_expr(field))

	{
		name = variant.name.text,
		fields = fields,
		comments = comments
	}


private pure func project_field_decl(
	field: ParsedFieldDecl,
	comments: MemberComments,
) -> DeclarationField:
	{
		name = field.name.text,
		field_type = project_type_expr(field.type_expr),
		comments = comments
	}


---
A record body's fields with the comments written among them (see
`collection_item_comments`; the opening line is the header's, the closing line
the `}` that ends the declaration), and the whole-line comments after the last
field. A file without comments skips locating the fields.
---
private pure func project_record_fields(
	table: SourceTable,
	comments: List[FormatterComment],
	record_decl: ParsedRecordDecl,
) -> (List[DeclarationField], List[String]):
	if comments.length() == 0:
		(record_decl.fields.map(func(field): project_field_decl(field, no_member_comments())), [])
	else:
		located: List[LocatedItem[ParsedFieldDecl]] = record_decl.fields.map(
			func(field): located_item(field, declaration_member_extent(field.span)),
		)
		commented: CommentedItems[ParsedFieldDecl] = collection_item_comments(
			table,
			comments,
			source_location_span(table, record_decl.name.span).start_line,
			span_end_line(table, record_decl.span),
			located,
		)
		(
			commented.items.map(func(item): project_field_decl(item.item, item.comments)),
			commented.closing,
		)


---
A union body's variants with the comments written among them (see
`collection_item_comments`), and the whole-line comments after the last variant.
The body has no closing line, so its closing comments are those indented at the
variants' column that follow the last variant: `comments` ends at the next
declaration, and a comment at the declaration's own column belongs to what
follows it. A file without comments skips locating the variants.
---
private pure func project_type_variants(
	table: SourceTable,
	comments: List[FormatterComment],
	union_decl: ParsedUnionDecl,
) -> (List[TypeVariant], List[String]):
	match union_decl.variants:
		[]:
			([], [])
		[first_variant, ..._]:
			if comments.length() == 0:
				(
					union_decl.variants.map(
						func(variant): project_type_variant(variant, no_member_comments()),
					),
					[],
				)
			else:
				commented_type_variants(table, comments, union_decl, first_variant)


---
`project_type_variants` for a union with at least one variant in a file with
comments. The first variant's column is the body's indent, which the closing
comments must share.
---
private pure func commented_type_variants(
	table: SourceTable,
	comments: List[FormatterComment],
	union_decl: ParsedUnionDecl,
	first_variant: ParsedVariantDecl,
) -> (List[TypeVariant], List[String]):
	located: List[LocatedItem[ParsedVariantDecl]] = union_decl.variants.map(
		func(variant): located_item(variant, declaration_member_extent(variant.span)),
	)

	last_variant_end_line: Int = match union_decl.variants.last():
		Some(variant):
			span_end_line(table, variant.span)
		None:
			source_location_span(table, union_decl.name.span).start_line

	variant_column: Int = source_location_span(table, first_variant.span).start_column

	commented: CommentedItems[ParsedVariantDecl] = collection_item_comments(
		table,
		comments,
		source_location_span(table, union_decl.name.span).start_line,
		last_variant_end_line + 1,
		located,
	)

	last_comment_line: Int = match comments.last():
		Some(comment):
			comment.line
		None:
			last_variant_end_line

	closing: List[String] = whole_line_comments_after(
		comments,
		line_as_preceding_body(last_variant_end_line),
		last_comment_line,
		variant_column,
	)
	(commented.items.map(func(item): project_type_variant(item.item, item.comments)), closing)


private pure func project_function_decl(
	table: SourceTable,
	decl: ParsedFunctionDecl,
	is_private: Bool,
	comments: List[FormatterComment],
) -> Declaration:
	option_doc(
		decl.doc,
		FunctionDeclaration(
			is_private,
			decl.name.text,
			decl.is_pure,
			annotation_present(decl.annotations, ParsedTailRecursiveAnnotation),
			annotation_present(decl.annotations, ParsedDebugOnlyAnnotation),
			annotation_present(decl.annotations, ParsedNoCopyAnnotation),
			annotation_present(decl.annotations, ParsedResourceResultOrdinaryAnnotation),
			type_param_names(decl.type_params),
			project_function_params(
				table,
				comments,
				decl.name,
				decl.params,
				decl.return_type,
				decl.body,
			),
			option_type_expr(decl.return_type),
			project_dim_constraints(decl.dim_constraints),
			function_body(table, decl.body, comments),
		),
	)


private pure func project_trait_method(
	table: SourceTable,
	method: ParsedTraitMethodDecl,
	comments: List[FormatterComment],
) -> TraitMethod:
	{
		name = method.name.text,
		is_pure = method.is_pure,
		params = project_function_params(
			table,
			comments,
			method.name,
			method.params,
			method.return_type,
			method.body,
		),
		return_type = option_type_expr(method.return_type),
		body = method.body.map(func(expr): project_expr_with_comments(table, expr, comments))
	}


private pure func project_trait_methods(
	table: SourceTable,
	methods: List[ParsedTraitMethodDecl],
	comments: List[FormatterComment],
) -> List[TraitMethod]:
	var projected: List[TraitMethod] = []

	for method in methods:
		projected = projected.append(project_trait_method(table, method, comments))

	projected


private pure func foreign_metadata(
	header_line: Int,
	args: List[ParsedForeignBlockArg],
) -> ForeignMetadata:
	var includes: List[String] = []
	var link_flags: List[ForeignLinkFlag] = []

	for arg in args:
		match arg.name.text:
			"include":
				includes = includes.append(arg.value)
			"link":
				link_flags = link_flags.append({
					platform = None,
					value = arg.value,
				})
			"link_linux":
				link_flags = link_flags.append({
					platform = Some("linux"),
					value = arg.value,
				})
			"link_macos":
				link_flags = link_flags.append({
					platform = Some("macos"),
					value = arg.value,
				})
			_:
				void

	{
		header_line = header_line,
		includes = includes,
		link_flags = link_flags
	}


private pure func project_foreign_function(
	metadata: ForeignMetadata,
	decl: ParsedForeignFunctionDecl,
) -> Declaration:
	FunctionDeclaration(
		decl.is_private,
		decl.name.text,
		decl.is_pure,
		annotation_present(decl.annotations, ParsedTailRecursiveAnnotation),
		annotation_present(decl.annotations, ParsedDebugOnlyAnnotation),
		annotation_present(decl.annotations, ParsedNoCopyAnnotation),
		annotation_present(decl.annotations, ParsedResourceResultOrdinaryAnnotation),
		[],
		project_params(decl.params),
		Some(project_type_expr(decl.return_type)),
		[],
		ForeignFunctionBody(
			decl.c_name.get_or(decl.name.text),
			metadata,
		),
	)


private pure func project_impl_method(
	table: SourceTable,
	method: ParsedFunctionDecl,
	comments: List[FormatterComment],
) -> ImplementationMethod:
	{
		name = method.name.text,
		is_pure = method.is_pure,
		is_tailrec = annotation_present(method.annotations, ParsedTailRecursiveAnnotation),
		is_debug_only = annotation_present(method.annotations, ParsedDebugOnlyAnnotation),
		no_copy = annotation_present(method.annotations, ParsedNoCopyAnnotation),
		resource_result_ordinary = annotation_present(
			method.annotations,
			ParsedResourceResultOrdinaryAnnotation,
		),
		type_params = type_param_names(method.type_params),
		params = project_function_params(
			table,
			comments,
			method.name,
			method.params,
			method.return_type,
			method.body,
		),
		return_type = option_type_expr(method.return_type),
		where_constraints = project_dim_constraints(method.dim_constraints),
		body = function_body(table, method.body, comments)
	}


private pure func project_impl_methods(
	table: SourceTable,
	methods: List[ParsedFunctionDecl],
	comments: List[FormatterComment],
) -> List[ImplementationMethod]:
	var projected: List[ImplementationMethod] = []

	for method in methods:
		projected = projected.append(project_impl_method(table, method, comments))

	projected


private pure func project_decl_to_located(
	table: SourceTable,
	names: NameTable,
	decl: ParsedDecl,
	is_private: Bool,
	comments: List[FormatterComment],
) -> List[LocatedDeclaration]:
	match decl:
		FunctionParsedDecl(function_decl):
			[located_decl(
					table,
					function_decl.span,
					project_function_decl(table, function_decl, is_private, comments),
				)]
		VarParsedDecl(var_decl):
			[located_decl(
					table,
					var_decl.span,
					option_doc(
						var_decl.doc,
						VariableDeclaration(
							is_private,
							Some(var_decl.name.text),
							None,
							var_decl.is_mutable,
							option_type_expr(var_decl.type_expr),
							project_expr_with_comments(table, var_decl.value, comments),
						),
					),
				)]
		ImportBlockParsedDecl(items, _):
			var located: List[LocatedDeclaration] = []

			for item in items:
				located = located.append(
					located_decl(
						table,
						item.span,
						ImportDeclaration(project_import_item(item)),
					),
				)

			located
		ForeignBlockParsedDecl(args, functions, span):
			metadata: ForeignMetadata = foreign_metadata(
				source_location_span(table, span).start_line,
				args,
			)
			var located: List[LocatedDeclaration] = []

			for function_decl in functions:
				located = located.append(
					located_decl(
						table,
						function_decl.span,
						project_foreign_function(metadata, function_decl),
					),
				)

			located
		RecordParsedDecl(record_decl):
			(record_fields, closing_comments) = project_record_fields(table, comments, record_decl)
			spelling: RecordSpelling = match record_decl.form:
				OrdinaryRecord: OrdinaryRecordSpelling
				FixedRecord: FixedRecordSpelling

			[located_decl(
					table,
					record_decl.span,
					option_doc(
						record_decl.doc,
						RecordDeclaration(
							is_private,
							name_spelling_or_text(
								names,
								record_decl.name.name,
								record_decl.name.text,
							),
							type_param_names(record_decl.type_params),
							spelling,
							False,
							record_fields,
							closing_comments,
						),
					),
				)]
		UnionParsedDecl(union_decl):
			(variants, closing_comments) = project_type_variants(table, comments, union_decl)
			spelling = match union_decl.form:
				OrdinaryUnion: OrdinaryUnionSpelling
				FixedUnion: FixedUnionSpelling

			[located_decl(
					table,
					union_decl.span,
					option_doc(
						union_decl.doc,
						TypeDeclaration(
							is_private,
							union_decl.name.text,
							type_param_names(union_decl.type_params),
							UnionDeclarationKind(spelling),
							variants,
							closing_comments,
						),
					),
				)]
		BuiltinTypeParsedDecl(type_decl):
			kind = if type_decl.is_resource:
				ResourceTypeDeclarationKind(type_decl.cleanup.map(func(cleanup): cleanup.builtin_name))
			else:
				BuiltinTypeDeclarationKind
			[located_decl(
					table,
					type_decl.span,
					option_doc(
						type_decl.doc,
						TypeDeclaration(
							is_private,
							type_decl.name.text,
							type_param_names(type_decl.type_params),
							kind,
							[],
							[],
						),
					),
				)]
		TypeAliasParsedDecl(alias_decl):
			[located_decl(
					table,
					alias_decl.span,
					option_doc(
						alias_decl.doc,
						TypeAliasDeclaration(
							is_private,
							alias_decl.is_opaque,
							alias_decl.name.text,
							type_param_names(alias_decl.type_params),
							project_type_expr(alias_decl.target),
						),
					),
				)]
		TraitParsedDecl(trait_decl):
			var supertraits: List[String] = []

			for supertrait in trait_decl.supertraits:
				supertraits = supertraits.append(parsed_trait_reference_text(supertrait))

			[located_decl(
					table,
					trait_decl.span,
					option_doc(
						trait_decl.doc,
						TraitDeclaration(
							is_private,
							trait_decl.name.text,
							type_param_names(trait_decl.type_params),
							supertraits,
							project_trait_methods(table, trait_decl.methods, comments),
						),
					),
				)]
		ImplParsedDecl(impl_decl):
			[located_decl(
					table,
					impl_decl.span,
					option_doc(
						impl_decl.doc,
						ImplementationDeclaration(
							is_private,
							impl_decl.trait_name.text,
							project_type_expr(impl_decl.for_type),
							project_impl_methods(table, impl_decl.methods, comments),
						),
					),
				)]
		PrivateParsedDecl(inner, _):
			project_decl_to_located(table, names, inner, True, comments)
		ParsedErrorDecl(span):
			[located_decl(
					table,
					span,
					VariableDeclaration(
						True,
						Some("__parse_error"),
						None,
						False,
						None,
						VoidExpression,
					),
				)]


---
Project each declaration with only the comments between its first line and
the next declaration's first line. Every comment a declaration claims lies in
that range: a construct ending at a dedent spans at most to the next
declaration's line. Comments arrive in source order, so one sweep slices them,
and each claim scans its declaration's comments rather than the whole file's.
The program renderer keeps the comment ending a declaration's first line
(`take_trailing_comment`), so the slice leaves it out and no claimer inside
the declaration can take it a second time.
---
private pure func project_decls(
	table: SourceTable,
	names: NameTable,
	decls: List[ParsedDecl],
	comments: List[FormatterComment],
) -> List[LocatedDeclaration]:
	var located: List[LocatedDeclaration] = []
	var next_comment: Int = 0
	var index: Int = 0

	for decl in decls:
		decl_line: Int = source_location_span(table, parsed_decl_location(decl)).start_line
		next_decl_line: Option[Int] = decls
			.get(index + 1)
			.map(func(next): source_location_span(table, parsed_decl_location(next)).start_line)
		var own_comments: List[FormatterComment] = []
		var collecting: Bool = True

		while collecting:
			match comments.get(next_comment):
				Some(comment):
					before_next: Bool = match next_decl_line:
						Some(line):
							comment.line < line
						None:
							True

					if before_next:
						if not (comment.trailing and comment.line == decl_line):
							own_comments = own_comments.append(comment)

						next_comment += 1
					else:
						collecting = False
				None:
					collecting = False

		for item in project_decl_to_located(table, names, decl, False, own_comments):
			located = located.append(item)

		index += 1

	located


private pure func project_module_doc(
	table: SourceTable,
	module_doc: Option[ParsedModuleDoc],
) -> Option[ModuleDoc]:
	match module_doc:
		Some(doc):
			Some({
				text_value = doc.text,
				line = source_location_span(table, doc.span).start_line,
			})
		None:
			None


pure func parsed_program_to_formatter_program(
	program: ParsedProgram,
	names: NameTable,
	comments: List[FormatterComment],
) -> Result[Program, String]:
	table: SourceTable = source_table_for_file(program.source)

	match first_parse_error(program.diagnostics):
		Some(message):
			Err(message)
		None:
			Ok({
				module_doc = project_module_doc(table, program.module_doc),
				declarations = project_decls(table, names, program.decls, comments),
				comments = comments,
			})


pure func render_parsed_program(
	width: Int,
	program: ParsedProgram,
	names: NameTable,
	comments: List[FormatterComment],
) -> Result[String, String]:
	formatter_program ?= parsed_program_to_formatter_program(program, names, comments)
	Ok(width.layout(formatter_program.program_document()))
