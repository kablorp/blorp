---
The source files `blorp format` visits: the `.brp` files named on the command
line or found by walking the directories it names, with `--exclude` applied.
Paths are the normalized paths `format_command.brp` produced, and the walk keeps them
normalized, so one file reached from two roots is visited once.
---
import:
    _base: Stringable
    bool: and, not
    io/fs/entry: EntryError, EntryKind(File, Directory, Symlink, Other), entry_kind
    io/fs/list: ListError, list_directory
    list: List methods
    option: Option methods
    path: Path, join, normalize, is_within, to_path
    result: Result methods
    string: String methods
    ../common/cli/usage: source_stem, error_message
    ../common/utils/results: first_error


-- Why a path could not be read.
union Unreadable:
    -- Named on the command line, and nothing is there.
    Missing
    EntryFailed(EntryError)
    ListFailed(ListError)


implements Stringable for Unreadable:
    pure func to_string(value: Self) -> String:
        match value:
            Missing: "no such file"
            EntryFailed(error): error.to_string()
            ListFailed(error): error.to_string()


-- A path beside why it could not be read.
record UnreadablePath {
    path: Path,
    reason: Unreadable,
}


-- The source files in visiting order, each once, and the paths that could not
-- be read.
record SourceWalk {
    files: List[Path],
    unreadable: List[UnreadablePath],
}


-- Names that begin with a dot are hidden from a walk.
private HIDDEN_PREFIX: String = "."


private pure func is_excluded(path: Path, excluded: List[Path]) -> Bool:
    excluded.any(pure func(prefix: Path): path.is_within(prefix))


private pure func with_unreadable(walk: SourceWalk, path: Path, reason: Unreadable) -> SourceWalk:
    { walk | unreadable = walk.unreadable.append({ path = path, reason = reason }) }


private pure func with_file(walk: SourceWalk, path: Path) -> SourceWalk:
    if walk.files.contains(path):
        walk
    else:
        { walk | files = walk.files.append(path) }


-- An excluded path must lie below a root, or it would exclude nothing.
private pure func below_a_root(excluded_path: Path, roots: List[Path]) -> Result[Void, String]:
    if roots.any(pure func(root: Path): excluded_path.is_within(root)):
        Ok(void)
    else:
        Err(
            error_message(
                "the excluded path `${excluded_path}` is not inside any path being formatted",
                "exclude a file or directory below one of the paths to format, or add a path that contains it",
            ),
        )


-- An excluded path that does not exist is a misspelling.
private func existing_exclusions(
    excluded: List[Path],
    walk: SourceWalk,
) -> Result[SourceWalk, String]:
    match excluded:
        []:
            Ok(walk)
        [excluded_path, ...rest]:
            match entry_kind(excluded_path):
                Ok(None):
                    Err(
                        error_message(
                            "the excluded path `${excluded_path}` does not exist",
                            "check the spelling of the path given to --exclude",
                        ),
                    )
                Ok(Some(_)):
                    rest.existing_exclusions(walk)
                Err(error):
                    rest.existing_exclusions(
                        walk.with_unreadable(excluded_path, EntryFailed(error)),
                    )


-- Entries are visited in byte order of their names. Hidden entries, symbolic
-- links and other special files are skipped, and so is anything excluded.
private func visit_directory(directory: Path, excluded: List[Path], walk: SourceWalk) -> SourceWalk:
    match list_directory(directory):
        Err(error):
            walk.with_unreadable(directory, ListFailed(error))
        Ok(entries):
            var found = walk
            for entry in entries:
                -- A listed name is never empty and holds no NUL, so `to_path` keeps every entry.
                match entry.name.to_path():
                    Ok(name):
                        path = directory
                            .join(name)
                            .normalize()
                        visible = entry.name
                            .starts_with(HIDDEN_PREFIX)
                            .not()
                        if visible.and(
                            path
                                .is_excluded(excluded)
                                .not(),
                        ):
                            match entry.kind:
                                File:
                                    if (
                                        path
                                            .source_stem()
                                            .is_some()
                                    ):
                                        found = found.with_file(path)
                                Directory:
                                    found = path.visit_directory(excluded, found)
                                Symlink | Other:
                                    void
                    Err(_):
                        void
            found


private pure func not_a_source(path: Path) -> String:
    error_message(
        "`${path}` is not a .brp source file or a directory",
        "pass .brp files and directories to blorp format",
    )


private pure func file_root(root: Path, walk: SourceWalk) -> Result[SourceWalk, String]:
    if (
        root
            .source_stem()
            .is_some()
    ):
        Ok(walk.with_file(root))
    else:
        Err(not_a_source(root))


-- A root is used as given, even if it is hidden or a symbolic link; a link is
-- followed to what it names. `entry_kind` does not follow links, so a link is
-- probed with `list_directory`, which does: if that lists, the link names a
-- directory, and if it fails with NotADirectory the link names a file.
private func visit_root(
    root: Path,
    excluded: List[Path],
    walk: SourceWalk,
) -> Result[SourceWalk, String]:
    if root.is_excluded(excluded):
        Ok(walk)
    else:
        match entry_kind(root):
            Err(error):
                Ok(walk.with_unreadable(root, EntryFailed(error)))
            Ok(None):
                Ok(walk.with_unreadable(root, Missing))
            Ok(Some(File)):
                root.file_root(walk)
            Ok(Some(Directory)):
                Ok(root.visit_directory(excluded, walk))
            Ok(Some(Other)):
                Err(not_a_source(root))
            Ok(Some(Symlink)):
                match list_directory(root):
                    Ok(_): Ok(root.visit_directory(excluded, walk))
                    Err(ListError.NotADirectory): root.file_root(walk)
                    Err(error): Ok(walk.with_unreadable(root, ListFailed(error)))


private func visit_roots(
    roots: List[Path],
    excluded: List[Path],
    walk: SourceWalk,
) -> Result[SourceWalk, String]:
    match roots:
        []:
            Ok(walk)
        [root, ...rest]:
            match root.visit_root(excluded, walk):
                Ok(visited): rest.visit_roots(excluded, visited)
                Err(message): Err(message)


-- Every exclusion is checked before any file is visited, so a misspelt
-- --exclude rewrites nothing. The error is the usage message to print.
func walk_sources(roots: List[Path], excluded: List[Path]) -> Result[SourceWalk, String]:
    _ ?= excluded.first_error(pure func(path: Path): path.below_a_root(roots))
    start: SourceWalk = { files = [], unreadable = [] }
    checked ?= excluded.existing_exclusions(start)
    roots.visit_roots(excluded, checked)
