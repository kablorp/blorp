---
The source files `blorp format` visits: the `.brp` files named on the command
line or found by walking the directories it names, with `--exclude` applied.
Paths are the normalized paths `cli.brp` produced, and the walk keeps them
normalized, so one file reached from two roots is visited once.
---
import:
    bool: and, not
    io/error: IOError, IOErrorKind(NotADirectory, NotFound)
    io/fs: EntryKind(File, Directory, Symlink, Other), entry_kind, list_directory
    list: List methods
    option: Option methods
    path: join, normalize
    result: Result methods
    string: String methods
    ../cli: has_source_suffix, error_message
    ../common/utils/results: first_error


-- The source files in visiting order, each once, and the paths that could not
-- be read.
record SourceWalk {
    files: List[String],
    unreadable: List[IOError],
}


-- Names that begin with a dot are hidden from a walk.
private HIDDEN_PREFIX: String = "."

private CURRENT_DIRECTORY: String = "."

private PARENT_PREFIX: String = "../"

private PARENT_DIRECTORY: String = ".."

private ROOT_DIRECTORY: String = "/"


-- Whether the normalized `path` is `root` or lies below it, on component
-- boundaries: a/b/c.brp is below a/b, a/bc.brp is not. The test is lexical.
pure func is_at_or_below(path: String, root: String) -> Bool:
    if path == root:
        True
    else if root == CURRENT_DIRECTORY:
        and(
            path
                .starts_with(ROOT_DIRECTORY)
                .not(),
            and(
                path != PARENT_DIRECTORY,
                path
                    .starts_with(PARENT_PREFIX)
                    .not(),
            ),
        )
    else if root == ROOT_DIRECTORY:
        path.starts_with(ROOT_DIRECTORY)
    else:
        path.starts_with(root + ROOT_DIRECTORY)


private pure func is_excluded(path: String, excluded: List[String]) -> Bool:
    excluded.any(pure func(prefix: String): path.is_at_or_below(prefix))


private pure func with_unreadable(walk: SourceWalk, error: IOError) -> SourceWalk:
    { walk | unreadable = walk.unreadable.append(error) }


private pure func with_file(walk: SourceWalk, path: String) -> SourceWalk:
    if walk.files.contains(path):
        walk
    else:
        { walk | files = walk.files.append(path) }


-- An excluded path must lie below a root, or it would exclude nothing.
private pure func below_a_root(excluded_path: String, roots: List[String]) -> Result[Void, String]:
    if roots.any(pure func(root: String): excluded_path.is_at_or_below(root)):
        Ok(void)
    else:
        Err(
            error_message(
                "the excluded path `${excluded_path}` is not inside any path being formatted",
                "exclude a file or directory below one of the paths to format, or add a path that contains it",
            ),
        )


-- An excluded path that does not exist is a misspelling.
private func existing_exclusions(
    excluded: List[String],
    walk: SourceWalk,
) -> Result[SourceWalk, String]:
    match excluded:
        []:
            Ok(walk)
        [excluded_path, ...rest]:
            match entry_kind(excluded_path):
                Ok(None):
                    Err(
                        error_message(
                            "the excluded path `${excluded_path}` does not exist",
                            "check the spelling of the path given to --exclude",
                        ),
                    )
                Ok(Some(_)):
                    rest.existing_exclusions(walk)
                Err(error):
                    rest.existing_exclusions(walk.with_unreadable(error))


-- Entries are visited in byte order of their names. Hidden entries, symbolic
-- links and other special files are skipped, and so is anything excluded.
private func visit_directory(
    directory: String,
    excluded: List[String],
    walk: SourceWalk,
) -> SourceWalk:
    match list_directory(directory):
        Err(error):
            walk.with_unreadable(error)
        Ok(entries):
            var found = walk
            for entry in entries:
                path = normalize(join(directory, entry.name))
                visible = entry.name
                    .starts_with(HIDDEN_PREFIX)
                    .not()
                if visible.and(
                    path
                        .is_excluded(excluded)
                        .not(),
                ):
                    match entry.kind:
                        File:
                            if entry.name.has_source_suffix():
                                found = found.with_file(path)
                        Directory:
                            found = path.visit_directory(excluded, found)
                        Symlink | Other:
                            void
            found


private pure func not_a_source(path: String) -> String:
    error_message(
        "`${path}` is not a .brp source file or a directory",
        "pass .brp files and directories to blorp format",
    )


private pure func file_root(root: String, walk: SourceWalk) -> Result[SourceWalk, String]:
    if root.has_source_suffix():
        Ok(walk.with_file(root))
    else:
        Err(not_a_source(root))


-- A root is used as given, even if it is hidden or a symbolic link; a link is
-- followed to what it names. `entry_kind` does not follow links, so a link is
-- probed with `list_directory`, which does: if that lists, the link names a
-- directory, and if it fails with NotADirectory the link names a file.
private func visit_root(
    root: String,
    excluded: List[String],
    walk: SourceWalk,
) -> Result[SourceWalk, String]:
    if root.is_excluded(excluded):
        Ok(walk)
    else:
        match entry_kind(root):
            Err(error):
                Ok(walk.with_unreadable(error))
            Ok(None):
                Ok(walk.with_unreadable({ path = root, destination = None, kind = NotFound }))
            Ok(Some(File)):
                root.file_root(walk)
            Ok(Some(Directory)):
                Ok(root.visit_directory(excluded, walk))
            Ok(Some(Other)):
                Err(not_a_source(root))
            Ok(Some(Symlink)):
                match list_directory(root):
                    Ok(_):
                        Ok(root.visit_directory(excluded, walk))
                    Err(error):
                        match error.kind:
                            NotADirectory: root.file_root(walk)
                            _: Ok(walk.with_unreadable(error))


private func visit_roots(
    roots: List[String],
    excluded: List[String],
    walk: SourceWalk,
) -> Result[SourceWalk, String]:
    match roots:
        []:
            Ok(walk)
        [root, ...rest]:
            match root.visit_root(excluded, walk):
                Ok(visited): rest.visit_roots(excluded, visited)
                Err(message): Err(message)


-- Every exclusion is checked before any file is visited, so a misspelt
-- --exclude rewrites nothing. The error is the usage message to print.
func walk_sources(roots: List[String], excluded: List[String]) -> Result[SourceWalk, String]:
    _ ?= excluded.first_error(pure func(path: String): path.below_a_root(roots))
    start: SourceWalk = { files = [], unreadable = [] }
    checked ?= excluded.existing_exclusions(start)
    roots.visit_roots(excluded, checked)
