import:
    bool: Bool methods
    int: Int methods
    list: repeat, List methods
    option: Option methods
    result: Result methods
    ../../syntax/source: FunctionLabel
    ../../syntax/syntax:
        Diagnostic,
        Entrypoint,
        LiteralPattern,
        Span,
        compiler_span,
        internal_error,
        or_internal_error,
    ../../utils/results: translated_list
    ../../utils/stack: push_at
    ../../utils/text: concat
    ../check/model: MatchArmId, DecisionNodeId, ListLengthTest
    ../lower/lower as Lower:
        JoinArm,
        LoopExit,
        LoweredLoop,
        LoweredFunction,
        LoweredJoin,
        LoweredFunctions,
        LoweredProgram,
        LoweredStep(Define, Join, Loop),
        LoweredSelection,
        SelectionEdge,
        SelectionDefinition(BorrowUnionField, BorrowRecordField, BorrowListElement, CopyListSuffix),
        ValueDefinition,
        ValueId,
        ValueParameter,
        ValueOperation(
            ParameterValue,
            VoidValue,
            IntegerValue,
            FloatValue,
            StringValue,
            CallValue,
            InvokeCallableValue,
            FreeCallableValue,
            CapturedCallableValue,
            ConstructValue,
            ConstructListValue,
            PayloadValue,
            ListElementValue,
            ListSuffixValue,
            ConstructRecordValue,
            ReadRecordFieldValue,
        ),
        block_value_count,
        step_reads,
        value_span,
    ../namespace/builtins: reuses_first_operand
    ../specialize/specialize:
        CallTarget(RuntimeFunction, UserFunction),
        ConcretePatternPlace,
        ConcreteRecord,
        ConcreteUnion,
        FieldInstanceId,
        FunctionInstanceId,
        RecordInstanceId,
        TypeRef,
        VariantInstanceId,
        VariantFieldInstanceId,


-- This identity names an obligation in an unverified function body. Only the
-- independent verifier establishes its membership, lifetime and uniqueness.
opaque type OwnerId = Int


implements Equatable for OwnerId:
    pure func equals(left: Self, right: Self) -> Bool:
        from_opaque OwnerId(left) == from_opaque OwnerId(right)


pure func owner_id(ordinal: Int) -> OwnerId:
    into_opaque OwnerId(ordinal)


pure func owner_number(id: OwnerId) -> Int:
    from_opaque OwnerId(id)


union BorrowSource:
    ParameterBorrow(ValueId)
    OwnerBorrow(OwnerId)
    PayloadBorrow(ValueId)


record BorrowedValue { value: ValueId, source: BorrowSource }


union OwnedArgument:
    UnmanagedArgument(ValueId)
    BorrowedArgument(BorrowedValue)
    ConsumedArgument(ValueId, OwnerId)


union ResultOwnership:
    UnmanagedResult
    BorrowedResult(BorrowSource)
    OwnedResult(OwnerId)


union StoredPayload:
    UnmanagedPayload(ValueId)
    OwnedPayload(ValueId, OwnerId)


record OwnedRecordField { field: FieldInstanceId, value: StoredPayload }


union OwnedValueOperation:
    ConstructRecordDefinition(RecordInstanceId, List[OwnedRecordField])
    ReadRecordFieldDefinition(FieldInstanceId, OwnedArgument)
    ParameterDefinition(Int)
    VoidDefinition
    IntegerDefinition(Int)
    FloatDefinition(Float)
    StringDefinition(String)
    CallDefinition(CallTarget, List[OwnedArgument])
    InvokeCallableDefinition(OwnedArgument, List[OwnedArgument])
    FreeCallableDefinition(FunctionInstanceId)
    CapturedCallableDefinition(FunctionInstanceId, StoredPayload)
    ConstructDefinition(VariantInstanceId, List[StoredPayload])
    ConstructListDefinition(List[StoredPayload])
    PayloadDefinition(VariantFieldInstanceId, ValueId)
    ListElementDefinition(Int, ValueId)
    ListSuffixDefinition(OwnedArgument, Int)


record OwnedDefinition {
    id: ValueId,
    value_type: TypeRef,
    operation: OwnedValueOperation,
    result: ResultOwnership,
    span: Span,
}


union OwnershipOperation:
    DefineValue(OwnedDefinition)
    ExecuteJoin(OwnedJoin)
    ExecuteLoop(OwnedLoop)
    AcquireOwner(OwnerId, BorrowedValue, Span)
    DropOwner(OwnerId, Span)


-- A value leaving its block on a return or yield edge, with the owner a
-- managed value moves.
union ReturnTransfer:
    UnmanagedReturn(ValueId)
    OwnedReturn(ValueId, OwnerId)


record OwnedJoinOutputs { transfer: ReturnTransfer, carried: List[ReturnTransfer] }


union OwnedJoinExit:
    Yield(OwnedJoinOutputs)
    TransferLoop(Lower.LoopTarget, OwnedLoopTail)


-- Only yielding arms move values into the join's continuation.
record OwnedJoinArm {
    id: MatchArmId,
    inputs: List[OwnedJoinParameter],
    operations: List[OwnershipOperation],
    exit: OwnedJoinExit,
}


union OwnedJoinParameter:
    UnmanagedJoinParameter(ValueParameter)
    ManagedJoinParameter(ValueParameter, OwnerId)


pure func join_parameter(output: OwnedJoinParameter) -> ValueParameter:
    match output:
        UnmanagedJoinParameter(parameter): parameter
        ManagedJoinParameter(parameter, _): parameter


pure func join_ownership(output: OwnedJoinParameter) -> ResultOwnership:
    match output:
        UnmanagedJoinParameter(_): UnmanagedResult
        ManagedJoinParameter(_, owner): OwnedResult(owner)


-- Selection edges follow their enclosing block in decision-node order;
-- canonical arm inputs then precede ordinary arm values and nested controls.
record OwnedJoin {
    result: OwnedJoinParameter,
    carried: List[OwnedJoinParameter],
    -- Obligations whose last enclosing use is this join; every yielding arm
    -- discharges each exactly once, and abrupt arms retire them at the edge.
    entering: List[OwnerId],
    selection: OwnedSelection,
    arms: List[OwnedJoinArm],
}


record OwnedLoopOutputs { value: ReturnTransfer, carried: List[ReturnTransfer], span: Span }


union OwnedLoopExit:
    Break(OwnedLoopOutputs)
    Recur(List[ReturnTransfer], Span)


record OwnedSelectionEdge {
    arm: MatchArmId,
    operations: List[OwnershipOperation],
    transfers: List[ReturnTransfer],
}


union OwnedDecisionNode:
    TestVariant(ConcretePatternPlace, VariantInstanceId, DecisionNodeId, DecisionNodeId)
    TestListLength(ConcretePatternPlace, ListLengthTest, DecisionNodeId, DecisionNodeId)
    TestLiteral(ConcretePatternPlace, LiteralPattern, DecisionNodeId, DecisionNodeId)
    EnterArm(OwnedSelectionEdge)


record OwnedSelection {
    scrutinee: OwnedArgument,
    nodes: List[OwnedDecisionNode],
    entry: DecisionNodeId,
}


record OwnedLoopArm { id: MatchArmId, inputs: List[OwnedJoinParameter], body: OwnedLoopBlock }


record OwnedLoopMatch { selection: OwnedSelection, arms: List[OwnedLoopArm] }


union OwnedLoopTail:
    ExitLoop(OwnedLoopExit)
    MatchLoop(OwnedLoopMatch)


record OwnedLoopBlock { operations: List[OwnershipOperation], tail: OwnedLoopTail }


record OwnedLoopHeader { parameter: OwnedJoinParameter, initial: ReturnTransfer }


record OwnedLoop {
    entry_acquisitions: List[OwnerAcquisition],
    headers: List[OwnedLoopHeader],
    result: OwnedJoinParameter,
    carried: List[OwnedJoinParameter],
    body: OwnedLoopBlock,
}


-- How the ownership stage passes one managed parameter.
record ManagedPassing {
    value_type: TypeRef,
    -- The caller transfers one obligation; the callee discharges it.
    owned: Bool,
}


-- A function's parameter as the ownership stage passes it. These rows replace
-- the specialization signature's parameters, so a caller reads one contract.
union OwnedParameter:
    UnmanagedParameter(TypeRef)
    ManagedParameter(ManagedPassing)


pure func parameter_type(parameter: OwnedParameter) -> TypeRef:
    match parameter:
        UnmanagedParameter(value_type): value_type
        ManagedParameter(passing): passing.value_type


pure func parameter_owned(parameter: OwnedParameter) -> Bool:
    match parameter:
        UnmanagedParameter(_): False
        ManagedParameter(passing): passing.owned


record OwnedFunction {
    label: FunctionLabel,
    parameters: List[OwnedParameter],
    return_type: TypeRef,
    operations: List[OwnershipOperation],
    result: ReturnTransfer,
}


record OwnershipProgram {
    records: List[ConcreteRecord],
    unions: List[ConcreteUnion],
    functions: List[OwnedFunction],
    entrypoint: Entrypoint[FunctionInstanceId],
}


-- Values of enclosing blocks that a block may read: each a consecutive
-- interval of one enclosing block's values before the nested arm.
private fixed record ValueInterval { first: Int, count: Int }


private pure func in_interval(ordinal: Int, first: Int, count: Int) -> Bool:
    match ordinal >= first:
        False: False
        True: ordinal < first + count


private pure func visible_outside(ordinal: Int, outer: List[ValueInterval]) -> Bool:
    var visible: Bool = False
    for interval in outer:
        if ordinal.in_interval(interval.first, interval.count):
            visible = True
            break
    visible


-- Last-use positions belong to this block; ValueIds remain function-wide.
-- Enclosing values are visible, but earlier sibling ordinals are not.
private pure func use_slot(
    value: ValueId,
    introduced_count: Int,
    outer: List[ValueInterval],
    first_value: Int,
    slot_count: Int,
    span: Span,
) -> Result[Option[Int], Diagnostic]:
    ordinal = value.value_number()

    if ordinal.visible_outside(outer):
        Ok(None)
    else if ordinal.in_interval(first_value, introduced_count):
        index = ordinal - first_value

        if index.in_interval(0, slot_count):
            Ok(Some(index))
        else:
            Err(internal_error(span, "invalid value identity in ownership use analysis"))
    else:
        Err(internal_error(span, "invalid value identity in ownership use analysis"))


-- The span a block's terminal use reports: its local operand's definition.
private pure func terminal_span(
    steps: List[LoweredStep],
    result: ValueId,
    outer: List[ValueInterval],
) -> Result[Span, Diagnostic]:
    if (
        result
            .value_number()
            .visible_outside(outer)
    ):
        Ok(compiler_span())
    else:
        match steps.value_span(result):
            Some(span): Ok(span)
            None:
                Err(
                    internal_error(
                        compiler_span(),
                        "invalid return value in ownership use analysis",
                    ),
                )


-- A terminal reads one returned value, a loop edge's arguments, or a
-- join result and ordered carriers with their existing parameter origins.
private union BlockTerminal:
    TerminalValue(ValueId)
    TerminalArguments(List[ValueId])
    TerminalJoin(ValueId, List[ValueId], List[ValueParameter])


-- Each definition's last use in this block, at the position of its last
-- reader; the terminal operands are read at the synthetic position after
-- the last definition.
private pure func block_uses(
    steps: List[LoweredStep],
    terminal: BlockTerminal,
    outer: List[ValueInterval],
    first_value: Int,
    seed_count: Int,
    span_result: Result[Span, Diagnostic],
) -> Result[List[Option[Int]], Diagnostic]:
    unused: Option[Int] = None
    var uses = repeat(unused, seed_count + steps.block_value_count())
    var step_position: Int = 0
    var introduced_count: Int = seed_count
    var failure: Option[Diagnostic] = None

    for step in steps:
        span = step.step_span()
        first = match step:
            Define(definition): definition.id
            Join(join): join.result.id
            Loop(loop): loop.result.id
        if first.value_number() != first_value + introduced_count:
            failure = Some(
                internal_error(span, "nonconsecutive value identity in ownership use analysis"),
            )
        else:
            carried: List[ValueParameter] = match step:
                Define(_): []
                Join(join): join.carried
                Loop(loop): loop.carried
            var ordinal = first_value + introduced_count + 1
            for parameter in carried:
                if parameter.id.value_number() != ordinal:
                    failure = Some(
                        internal_error(
                            parameter.span,
                            "nonconsecutive value identity in ownership use analysis",
                        ),
                    )
                    break
                ordinal = ordinal + 1
        if failure.is_some():
            break

        -- Slot validation borrows only scalar bounds, so each write keeps the
        -- same local vector owner rather than sharing it through Result[List].
        for operand in step.step_reads():
            match operand.use_slot(introduced_count, outer, first_value, uses.length(), span):
                Ok(Some(index)): uses = uses.set(index, Some(step_position))
                Ok(None): void
                Err(error):
                    failure = Some(error)
                    break

        if failure.is_some():
            break

        introduced_count = introduced_count + step.step_value_count()
        step_position = step_position + 1

    ready: Void ?= match failure:
        Some(error): Err(error)
        None: Ok(void)

    operands = match terminal:
        TerminalValue(result): [result]
        TerminalArguments(arguments): arguments
        TerminalJoin(result, _, _): [result]
    -- Resolve once at the caller, but keep operand errors ahead of a bad exit.
    span ?= span_result

    -- Start this builder inside the successful span scope. The outer snapshot
    -- may cause one initial copy; subsequent writes keep the local vector owner.
    var terminal_uses = uses
    var invalid: Option[Diagnostic] = None

    for operand in operands:
        match operand.use_slot(introduced_count, outer, first_value, terminal_uses.length(), span):
            Ok(Some(index)): terminal_uses = terminal_uses.set(index, Some(step_position))
            Ok(None): void
            Err(error):
                invalid = Some(error)
                break

    match terminal:
        TerminalValue(_) | TerminalArguments(_): void
        TerminalJoin(_, arguments, parameters):
            var position = 0
            for parameter in parameters:
                if invalid.is_some():
                    break
                match arguments.get(position):
                    None:
                        invalid = Some(
                            internal_error(span, "join arm carries the wrong number of values"),
                        )
                    Some(operand):
                        match operand.use_slot(
                            introduced_count,
                            outer,
                            first_value,
                            terminal_uses.length(),
                            parameter.span,
                        ):
                            Ok(slot):
                                match slot:
                                    Some(index):
                                        terminal_uses = terminal_uses.set(
                                            index,
                                            Some(step_position),
                                        )
                                    None: void
                            Err(error): invalid = Some(error)
                position = position + 1

    match invalid:
        Some(error): Err(error)
        None: Ok(terminal_uses)


-- A loop edge reads every outgoing occurrence before retiring any owner.
pure func exit_last_uses(
    steps: List[LoweredStep],
    exit: LoopExit,
    prefix_count: Int,
    first_value: Int,
) -> Result[List[Option[Int]], Diagnostic]:
    outer: List[ValueInterval] = [{ first = 0, count = prefix_count }]
    terminal: BlockTerminal = match exit:
        Lower.Recur(arguments, _): TerminalArguments(arguments)
        Lower.Break(outputs): TerminalArguments([outputs.value].concat(outputs.carried))
    span = match exit:
        Lower.Recur(_, span): span
        Lower.Break(outputs): outputs.span
    steps.block_uses(terminal, outer, first_value, 0, Ok(span))


pure func block_last_uses(
    steps: List[LoweredStep],
    result: ValueId,
    prefix_count: Int,
    first_value: Int,
) -> Result[List[Option[Int]], Diagnostic]:
    outer: List[ValueInterval] = [{ first = 0, count = prefix_count }]
    steps.block_uses(
        TerminalValue(result),
        outer,
        first_value,
        0,
        steps.terminal_span(result, outer),
    )


pure func last_uses(
    steps: List[LoweredStep],
    result: ValueId,
) -> Result[List[Option[Int]], Diagnostic]:
    steps.block_last_uses(result, 0, 0)


record OwnerAcquisition { owner: OwnerId, borrow: BorrowedValue }


-- Stored payloads acquire before their definition, or take an owner whose
-- last use is the definition. A managed record projection borrows its parent,
-- and insertion decides at its step whether that borrow lasts or the
-- projection acquires its own owner.
private union AcquisitionPlan:
    StoredAcquisitions(List[OwnerAcquisition], List[OwnerId])
    Projection(BorrowedValue)


private record BuiltDefinition {
    definition: OwnedDefinition,
    next_owner: Int,
    acquisitions: AcquisitionPlan,
}


-- Each callee's rows, by instance number. Inserting one function on its own
-- treats every call as borrowing.
private union CalleeContracts:
    EveryCallBorrows
    InstanceRows(List[List[OwnedParameter]])


-- The contracts one insertion reads: its function's own rows and its callees'.
private record CallContracts { parameters: List[OwnedParameter], callees: CalleeContracts }


private pure func value_source(
    value: ValueId,
    sources: List[ResultOwnership],
    enclosing: List[EnclosingBlock],
    first_value: Int,
    span: Span,
) -> Result[ResultOwnership, Diagnostic]:
    ordinal = value.value_number()
    var entry: Option[ResultOwnership] = None

    if ordinal.in_interval(first_value, sources.length()):
        entry = sources.get(ordinal - first_value)
    else:
        for block in enclosing:
            if ordinal.in_interval(block.first_value, block.sources.length()):
                entry = block.sources.get(ordinal - block.first_value)
                break

    entry.or_internal_error(span, "value used before definition in ownership insertion")


private pure func borrow_argument(
    value: ValueId,
    sources: List[ResultOwnership],
    enclosing: List[EnclosingBlock],
    first_value: Int,
    span: Span,
) -> Result[OwnedArgument, Diagnostic]:
    source ?= value.value_source(sources, enclosing, first_value, span)
    match source:
        UnmanagedResult: Ok(UnmanagedArgument(value))
        BorrowedResult(borrow_source):
            Ok(BorrowedArgument({ value = value, source = borrow_source }))
        OwnedResult(owner): Ok(BorrowedArgument({ value = value, source = OwnerBorrow(owner) }))


-- Stored payloads of a record, a variant, a list literal or a callable
-- environment. Each payload asks `transfer`: one moves its owner into its
-- slot, and every other acquires before the definition, including the second
-- of Pair(x, x) and [x, x], since one obligation fills one slot.
private record StoredPayloads {
    stored: List[StoredPayload],
    acquisitions: List[OwnerAcquisition],
    taken: List[OwnerId],
    next: Int,
}


private pure func store_payloads(
    values: List[ValueId],
    sources: List[ResultOwnership],
    enclosing: List[EnclosingBlock],
    first_value: Int,
    span: Span,
    pre_step_drops: Option[List[ScheduledDrop]],
    loop_uses: List[ScheduledDrop],
    consumed: List[OwnerId],
    position: Int,
    next_owner: Int,
) -> Result[StoredPayloads, Diagnostic]:
    step_drops ?= pre_step_drops.or_internal_error(span, "missing drop schedule row")
    var stored: List[StoredPayload] = []
    var acquired: List[OwnerAcquisition] = []
    var taken: List[OwnerId] = []
    var next = next_owner
    var failure: Option[Diagnostic] = None
    for value in values:
        var acquire_from: Option[BorrowSource] = None
        match value.value_source(sources, enclosing, first_value, span):
            Err(error):
                failure = Some(error)
                break
            Ok(UnmanagedResult): stored = stored.append(UnmanagedPayload(value))
            Ok(BorrowedResult(borrowed)): acquire_from = Some(borrowed)
            Ok(OwnedResult(owner)):
                match OwnedResult(owner).transfer(step_drops, loop_uses, consumed, position, taken):
                    Moves(moved):
                        taken = taken.append(moved)
                        stored = stored.append(OwnedPayload(value, moved))
                    Acquires: acquire_from = Some(OwnerBorrow(owner))
        match acquire_from:
            Some(borrow):
                child_owner = owner_id(next)
                next = next + 1
                acquired = acquired.append({
                    owner = child_owner,
                    borrow = { value = value, source = borrow },
                })
                stored = stored.append(OwnedPayload(value, child_owner))
            None: void
    match failure:
        Some(error): Err(error)
        None: Ok({ stored = stored, acquisitions = acquired, taken = taken, next = next })


private pure func borrowed_arguments(
    values: List[ValueId],
    sources: List[ResultOwnership],
    enclosing: List[EnclosingBlock],
    first_value: Int,
    span: Span,
) -> Result[List[OwnedArgument], Diagnostic]:
    values.translated_list(pure func(value: ValueId) -> Result[OwnedArgument, Diagnostic]:
        value.borrow_argument(sources, enclosing, first_value, span)
    )


private pure func build_definition(
    definition: ValueDefinition,
    sources: List[ResultOwnership],
    enclosing: List[EnclosingBlock],
    first_value: Int,
    next_owner: Int,
    pre_step_drops: Option[List[ScheduledDrop]],
    loop_uses: List[ScheduledDrop],
    consumed: List[OwnerId],
    position: Int,
    parameters: List[OwnedParameter],
    unions: List[ConcreteUnion],
    records: List[ConcreteRecord],
) -> Result[BuiltDefinition, Diagnostic]:
    needs_owner ?= definition.value_type.value_needs_ownership(unions, records)
    var next = next_owner
    var acquisitions: List[OwnerAcquisition] = []
    var taken: List[OwnerId] = []

    operation_result: Result[OwnedValueOperation, Diagnostic] = match definition.operation:
        ConstructRecordValue(owner, fields):
            values = fields.map(pure func(field) -> ValueId: field.value)
            match values.store_payloads(
                sources,
                enclosing,
                first_value,
                definition.span,
                pre_step_drops,
                loop_uses,
                consumed,
                position,
                next,
            ):
                Err(error): Err(error)
                Ok(payloads):
                    acquisitions = payloads.acquisitions
                    taken = payloads.taken
                    next = payloads.next
                    var stored: List[OwnedRecordField] = []
                    for field in fields:
                        match payloads.stored.get(stored.length()):
                            Some(payload):
                                stored = stored.append({ field = field.field, value = payload })
                            None: break
                    if stored.length() == fields.length():
                        Ok(ConstructRecordDefinition(owner, stored))
                    else:
                        Err(internal_error(definition.span, "record field has no stored payload"))
        ReadRecordFieldValue(field, value):
            value
                .borrow_argument(sources, enclosing, first_value, definition.span)
                .map(pure func(parent): ReadRecordFieldDefinition(field, parent))
        ParameterValue(index): Ok(ParameterDefinition(index))
        VoidValue: Ok(VoidDefinition)
        StringValue(bytes): Ok(StringDefinition(bytes))
        IntegerValue(value): Ok(IntegerDefinition(value))
        FloatValue(value): Ok(FloatDefinition(value))
        ConstructValue(id, values):
            match values.store_payloads(
                sources,
                enclosing,
                first_value,
                definition.span,
                pre_step_drops,
                loop_uses,
                consumed,
                position,
                next,
            ):
                Err(error): Err(error)
                Ok(payloads):
                    acquisitions = payloads.acquisitions
                    taken = payloads.taken
                    next = payloads.next
                    Ok(ConstructDefinition(id, payloads.stored))
        ConstructListValue(values):
            match values.store_payloads(
                sources,
                enclosing,
                first_value,
                definition.span,
                pre_step_drops,
                loop_uses,
                consumed,
                position,
                next,
            ):
                Err(error): Err(error)
                Ok(payloads):
                    acquisitions = payloads.acquisitions
                    taken = payloads.taken
                    next = payloads.next
                    Ok(ConstructListDefinition(payloads.stored))
        PayloadValue(variant, value): Ok(PayloadDefinition(variant, value))
        ListElementValue(index, value): Ok(ListElementDefinition(index, value))
        ListSuffixValue(value, skipped):
            value
                .borrow_argument(sources, enclosing, first_value, definition.span)
                .map(pure func(argument): ListSuffixDefinition(argument, skipped))
        FreeCallableValue(body): Ok(FreeCallableDefinition(body))
        CapturedCallableValue(body, environment):
            match [environment].store_payloads(
                sources,
                enclosing,
                first_value,
                definition.span,
                pre_step_drops,
                loop_uses,
                consumed,
                position,
                next,
            ):
                Err(error): Err(error)
                Ok(payloads):
                    acquisitions = payloads.acquisitions
                    taken = payloads.taken
                    next = payloads.next
                    match (
                        payloads.stored
                            .get(0)
                            .or_internal_error(
                                definition.span,
                                "missing callable environment payload",
                            )
                    ):
                        Err(error): Err(error)
                        Ok(payload): Ok(CapturedCallableDefinition(body, payload))
        InvokeCallableValue(callee, written):
            match callee.borrow_argument(sources, enclosing, first_value, definition.span):
                Err(error): Err(error)
                Ok(callable):
                    match written.borrowed_arguments(
                        sources,
                        enclosing,
                        first_value,
                        definition.span,
                    ):
                        Err(error): Err(error)
                        Ok(arguments): Ok(InvokeCallableDefinition(callable, arguments))
        CallValue(target, written):
            written
                .borrowed_arguments(sources, enclosing, first_value, definition.span)
                .map(pure func(arguments): CallDefinition(target, arguments))

    operation ?= operation_result

    ownership_result: Result[ResultOwnership, Diagnostic] = match needs_owner:
        False: Ok(UnmanagedResult)
        True:
            match operation:
                -- An owned parameter is an ordinary local obligation of the callee.
                ParameterDefinition(index):
                    match parameters.get(index):
                        Some(ManagedParameter(passing)):
                            if passing.owned:
                                Ok(OwnedResult(owner_id(next)))
                            else:
                                Ok(BorrowedResult(ParameterBorrow(definition.id)))
                        _:
                            Err(
                                internal_error(
                                    definition.span,
                                    "managed parameter has no managed row",
                                ),
                            )
                PayloadDefinition(_, source): Ok(BorrowedResult(PayloadBorrow(source)))
                ListElementDefinition(_, source): Ok(BorrowedResult(PayloadBorrow(source)))
                ReadRecordFieldDefinition(_, argument):
                    parent = match argument:
                        UnmanagedArgument(value): value
                        ConsumedArgument(value, _): value
                        BorrowedArgument(borrow): borrow.value

                    Ok(BorrowedResult(PayloadBorrow(parent)))
                StringDefinition(_) | CallDefinition(_, _) | InvokeCallableDefinition(_, _) | FreeCallableDefinition(_) | CapturedCallableDefinition(_, _) | ConstructDefinition(_, _) | ConstructListDefinition(_) | ListSuffixDefinition(_, _) | ConstructRecordDefinition(_, _):
                    Ok(OwnedResult(owner_id(next)))
                _: Err(internal_error(definition.span, "unsupported managed value operation"))

    result ?= ownership_result

    updated_owner = match result:
        OwnedResult(_): next + 1
        _: next

    acquisition_plan: AcquisitionPlan = match operation:
        ReadRecordFieldDefinition(_, _):
            match result:
                BorrowedResult(source): Projection({ value = definition.id, source = source })
                _: StoredAcquisitions(acquisitions, taken)
        _: StoredAcquisitions(acquisitions, taken)

    Ok({
        definition = {
            id = definition.id,
            value_type = definition.value_type,
            operation = operation,
            result = result,
            span = definition.span,
        },
        next_owner = updated_owner,
        acquisitions = acquisition_plan,
    })


private fixed record ScheduledDrop { owner: OwnerId, span: Span, last: Int }


-- A block enclosing a join arm, as of that join: its values before the join
-- with their ownership.
private record EnclosingBlock {
    first_value: Int,
    sources: List[ResultOwnership],
    owners: List[ScheduledDrop],
    position: Int,
    consumed: List[OwnerId],
}


-- The nearest loop owns cleanup only inside this lexical PRE boundary.
private fixed record LoopScope { target: Lower.LoopTarget, pre_blocks: Int }


private pure func enclosing_intervals(enclosing: List[EnclosingBlock]) -> List[ValueInterval]:
    var intervals: List[ValueInterval] = []
    for block in enclosing:
        intervals = intervals.append({ first = block.first_value, count = block.sources.length() })
    intervals


-- How a block schedules its owners' drops. A tail match's prefix keeps every
-- owner until each arm's exit, which drops it.
private union DropSchedule:
    DropAtLastUse(List[Option[Int]])
    DropInEachArm


-- A pending join sees the pre-output snapshot. Its arms follow the complete
-- block's values and owners, keeping both introduction intervals consecutive.
-- `entering` rows are the obligations the join takes; the snapshot does not
-- count them consumed, so its arms can discharge them.
private record PendingOwnedJoin {
    join: LoweredJoin,
    scrutinee: OwnedArgument,
    result: OwnedJoinParameter,
    carried: List[OwnedJoinParameter],
    entering: List[ScheduledDrop],
    enclosing: List[EnclosingBlock],
    loop_scope: Option[LoopScope],
}


-- Where a yielding arm discharges an obligation entering its join: on entry
-- when the arm never reads it, else at its last read there, a step or the
-- yield at the block's end, whose acquisitions precede the retirement.
private union EnteringDischarge:
    DropOnEntry(OwnerId, Span)
    LastReadInArm(ScheduledDrop)


-- How a loop header receives its initial value, decided once at the loop step.
-- A header takes the obligation of an owner whose last use is this entry and
-- that nothing else in the loop depends on; any other initial acquires.
private union HeaderEntry:
    AcquireAtEntry
    TakeOwner(OwnerId)


private record EnteringHeader { header: Lower.LoopHeader, entry: HeaderEntry }


-- `headers` are the loop's headers in order, each with its entry decision.
private record PendingOwnedLoop {
    loop: LoweredLoop,
    headers: List[EnteringHeader],
    result: OwnedJoinParameter,
    carried: List[OwnedJoinParameter],
    enclosing: List[EnclosingBlock],
}


-- A block's operations while it is inserted: complete ones, and joins whose
-- definitions complete_joins builds once their arms are inserted.
private union InsertedEntry:
    Inserted(OwnershipOperation)
    AwaitingArms(PendingOwnedJoin)
    AwaitingLoop(PendingOwnedLoop)


private record InsertedSteps {
    consumed: List[OwnerId],
    entries: List[InsertedEntry],
    sources: List[ResultOwnership],
    owners: List[ScheduledDrop],
    next_owner: Int,
}


-- The position after which the block drops an owner made at `position`.
private pure func drop_position(
    schedule: DropSchedule,
    value_slot: Int,
    step_position: Int,
    count: Int,
    span: Span,
) -> Result[Int, Diagnostic]:
    match schedule:
        DropInEachArm: Ok(count)
        DropAtLastUse(uses):
            match uses.get(value_slot):
                Some(Some(last)): Ok(last)
                Some(None): Ok(step_position)
                None: Err(internal_error(span, "missing value-use row"))


private record BuiltOutputs {
    result: OwnedJoinParameter,
    carried: List[OwnedJoinParameter],
    next_owner: Int,
}


private pure func owned_join_parameter(
    parameter: ValueParameter,
    next_owner: Int,
    unions: List[ConcreteUnion],
    records: List[ConcreteRecord],
) -> Result[OwnedJoinParameter, Diagnostic]:
    needs_owner ?= parameter.value_type.value_needs_ownership(unions, records)
    match needs_owner:
        False: Ok(UnmanagedJoinParameter(parameter))
        True: Ok(ManagedJoinParameter(parameter, owner_id(next_owner)))


private pure func build_outputs(
    result_parameter: ValueParameter,
    parameters: List[ValueParameter],
    next_owner: Int,
    unions: List[ConcreteUnion],
    records: List[ConcreteRecord],
) -> Result[BuiltOutputs, Diagnostic]:
    result ?= result_parameter.owned_join_parameter(next_owner, unions, records)
    var cursor = match result:
        UnmanagedJoinParameter(_): next_owner
        ManagedJoinParameter(_, _): next_owner + 1
    var carried: List[OwnedJoinParameter] = []
    var failure: Option[Diagnostic] = None
    for parameter in parameters:
        match parameter.owned_join_parameter(cursor, unions, records):
            Err(error):
                failure = Some(error)
                break
            Ok(output):
                carried = carried.append(output)
                match output:
                    UnmanagedJoinParameter(_): void
                    ManagedJoinParameter(_, _): cursor = cursor + 1
    match failure:
        Some(error): Err(error)
        None: Ok({ result = result, carried = carried, next_owner = cursor })


private record BuiltInputs { parameters: List[OwnedJoinParameter], next_owner: Int }


-- Canonical inputs own separate occurrences, even when an edge supplies the
-- same borrowed value more than once.
private pure func build_inputs(
    parameters: List[ValueParameter],
    initial_owner: Int,
    unions: List[ConcreteUnion],
    records: List[ConcreteRecord],
) -> Result[BuiltInputs, Diagnostic]:
    var inputs: List[OwnedJoinParameter] = []
    var next_owner = initial_owner
    var failure: Option[Diagnostic] = None
    for parameter in parameters:
        match parameter.owned_join_parameter(next_owner, unions, records):
            Err(error):
                failure = Some(error)
                break
            Ok(input):
                inputs = inputs.append(input)
                match input:
                    UnmanagedJoinParameter(_): void
                    ManagedJoinParameter(_, _): next_owner = next_owner + 1
    match failure:
        Some(error): Err(error)
        None: Ok({ parameters = inputs, next_owner = next_owner })


-- Borrow dependencies follow their published provenance, including projections.
private pure func dependency_owner(
    value: ValueId,
    sources: List[ResultOwnership],
    enclosing: List[EnclosingBlock],
    first_value: Int,
    span: Span,
) -> Result[Option[OwnerId], Diagnostic]:
    source ?= value.value_source(sources, enclosing, first_value, span)
    match source:
        OwnedResult(owner): Ok(Some(owner))
        BorrowedResult(OwnerBorrow(owner)): Ok(Some(owner))
        BorrowedResult(PayloadBorrow(parent)):
            parent.dependency_owner(sources, enclosing, first_value, span)
        _: Ok(None)


private pure func has_consumed(consumed: List[OwnerId], owner: OwnerId) -> Bool:
    var found: Bool = False
    for previous in consumed:
        if previous == owner:
            found = True
            break
    found


private pure func matches_last_use(
    rows: List[ScheduledDrop],
    owner: OwnerId,
    position: Int,
) -> Bool:
    var last: Bool = False
    for row in rows:
        if (row.owner == owner).and(row.last == position):
            last = True
            break
    last


-- An obligation ends at a point of a block when `ending` holds it, or it is a
-- row of the nearest loop whose last use is `position`, and nothing at an
-- earlier point consumed it. After a step, `ending` is the step's drop bucket,
-- whose rows all have that step as their last use; at an edge, it is the rows
-- the edge retires, and there are no loop rows.
private pure func transferable_here(
    ending: List[ScheduledDrop],
    loop_uses: List[ScheduledDrop],
    consumed: List[OwnerId],
    owner: OwnerId,
    position: Int,
) -> Bool:
    var listed: Bool = False
    for row in ending:
        if row.owner == owner:
            listed = True
            break
    listed
        .or(loop_uses.matches_last_use(owner, position))
        .and(
            consumed
                .has_consumed(owner)
                .not(),
        )


-- How one occurrence of a value fills an owned slot: a call's owned position,
-- a stored payload, a loop header's entry or an edge's output.
private union Transfer:
    Moves(OwnerId)
    Acquires


-- The one move rule, which every owned slot asks. An occurrence moves its
-- value's owner when that owner holds the value itself, the owner's
-- obligation ends at this point (`transferable_here`), and no earlier
-- occurrence at the point took it; any other occurrence acquires. A move ends
-- an obligation only where `own` already ends it: at its drop row, at an
-- edge that retires it, or at a loop row's last use, which any transfer may
-- consume. Callers add their own reasons an owner must stay: a call's
-- borrowed position or another read of a loop step that it backs.
private pure func transfer(
    source: ResultOwnership,
    ending: List[ScheduledDrop],
    loop_uses: List[ScheduledDrop],
    consumed: List[OwnerId],
    position: Int,
    taken: List[OwnerId],
) -> Transfer:
    match source:
        OwnedResult(owner):
            if (
                ending
                    .transferable_here(loop_uses, consumed, owner, position)
                    .and(
                        taken
                            .has_consumed(owner)
                            .not(),
                    )
            ):
                Moves(owner)
            else:
                Acquires
        _: Acquires


-- A join takes every obligation that may transfer at its step: the step's
-- drop bucket, which holds an arm's entering rows, and the loop rows.
private pure func join_entering(
    pre_step_drops: Option[List[ScheduledDrop]],
    loop_uses: List[ScheduledDrop],
    consumed: List[OwnerId],
    position: Int,
    span: Span,
) -> Result[List[ScheduledDrop], Diagnostic]:
    step_drops ?= pre_step_drops.or_internal_error(span, "missing drop schedule row")
    candidates = step_drops.concat(loop_uses)
    Ok(
        candidates.filter(
            pure func(row): step_drops.transferable_here(loop_uses, consumed, row.owner, position),
        ),
    )


-- How a call passes its operands, decided at its step: the owners it moves
-- into transferring positions, and the obligations it acquires for owned
-- positions whose owner may not move here. Acquisitions precede the call, so
-- they take the owner ordinals before its result.
private record PassedCall {
    definition: OwnedDefinition,
    acquisitions: List[OwnerAcquisition],
    taken: List[OwnerId],
    next_owner: Int,
}


-- Which positions of a call may move their argument's owner, and what an
-- unmovable owner gets: an in-place operand stays borrowed and its helper
-- copies; an owned parameter receives a fresh acquisition.
private union PassingRule:
    InPlaceOperand -- position 0 only; never acquires
    OwnedPositions(List[Bool]) -- one row per argument; acquires when unmovable


-- The one move rule. A position the `rule` marks moves its argument's owner
-- when that owner may transfer at this step, no borrowed position of the call
-- depends on it and no earlier position took it. Otherwise an owned parameter
-- receives a fresh acquisition: a reference count cannot see the caller's
-- remaining borrow, so passing the bare value would let the callee update a
-- live value in place. An in-place operand instead stays borrowed, and its
-- helper copies. None when the call transfers nothing.
private pure func pass_arguments(
    definition: OwnedDefinition,
    target: CallTarget,
    arguments: List[OwnedArgument],
    rule: PassingRule,
    first_owner: Int,
    pre_step_drops: Option[List[ScheduledDrop]],
    loop_uses: List[ScheduledDrop],
    consumed: List[OwnerId],
    position: Int,
    sources: List[ResultOwnership],
    enclosing: List[EnclosingBlock],
    first_value: Int,
) -> Result[Option[PassedCall], Diagnostic]:
    step_drops ?= pre_step_drops.or_internal_error(definition.span, "missing drop schedule row")
    transfers = match rule:
        InPlaceOperand:
            arguments
                .map(pure func(_: OwnedArgument) -> Bool: False)
                .set(0, True)
        OwnedPositions(rows): rows
    counted: Void ?= if arguments.length() == transfers.length():
        Ok(void)
    else:
        Err(internal_error(definition.span, "call argument count differs from its contract"))
    var borrowed_backers: List[Int] = []
    var failure: Option[Diagnostic] = None
    var index = 0
    for argument in arguments:
        match (argument, transfers.get(index)):
            (BorrowedArgument(borrow), Some(False)):
                match borrow.value.dependency_owner(
                    sources,
                    enclosing,
                    first_value,
                    definition.span,
                ):
                    Ok(Some(owner)):
                        borrowed_backers = borrowed_backers.append(owner.owner_number())
                    Ok(None): void
                    Err(error): failure = Some(error)
            _: void
        index = index + 1
    var passed: List[OwnedArgument] = []
    var acquisitions: List[OwnerAcquisition] = []
    var taken: List[OwnerId] = []
    var next = first_owner
    index = 0
    for argument in arguments:
        match (argument, transfers.get(index)):
            (BorrowedArgument(borrow), Some(True)):
                match borrow.value.value_source(sources, enclosing, first_value, definition.span):
                    Err(error): failure = Some(error)
                    Ok(source):
                        backs_borrow = match source:
                            OwnedResult(owner): borrowed_backers.contains(owner.owner_number())
                            _: False
                        decided: Transfer = if backs_borrow:
                            Acquires
                        else:
                            source.transfer(step_drops, loop_uses, consumed, position, taken)
                        match (decided, rule):
                            (Moves(owner), _):
                                passed = passed.append(ConsumedArgument(borrow.value, owner))
                                taken = taken.append(owner)
                            (Acquires, OwnedPositions(_)):
                                fresh = owner_id(next)
                                next = next + 1
                                acquisitions = acquisitions.append({
                                    owner = fresh,
                                    borrow = borrow,
                                })
                                passed = passed.append(ConsumedArgument(borrow.value, fresh))
                            (Acquires, InPlaceOperand): passed = passed.append(argument)
            -- An unmanaged value never fills an owned position; verify rejects one.
            _: passed = passed.append(argument)
        index = index + 1
    match failure:
        Some(error): Err(error)
        None:
            if (
                taken
                    .is_empty()
                    .and(acquisitions.is_empty())
            ):
                Ok(None)
            else:
                -- The result's owner follows the acquisitions made before the call.
                result: ResultOwnership = match definition.result:
                    OwnedResult(_): OwnedResult(owner_id(next))
                    _: definition.result
                after_result = match definition.result:
                    OwnedResult(_): next + 1
                    _: next
                Ok(
                    Some({
                        definition = { definition |
                            operation = CallDefinition(target, passed),
                            result = result,
                        },
                        acquisitions = acquisitions,
                        taken = taken,
                        next_owner = after_result,
                    }),
                )


-- A reusing runtime operand 0 may take its owner; an owned user position must
-- receive an obligation. Most definitions pass only borrows and return None
-- before any allocation; matches here avoid tuples, which allocate when an
-- element is managed.
-- `first_owner` is the owner ordinal before the call's definition.
private pure func pass_call(
    definition: OwnedDefinition,
    callees: CalleeContracts,
    first_owner: Int,
    pre_step_drops: Option[List[ScheduledDrop]],
    loop_uses: List[ScheduledDrop],
    consumed: List[OwnerId],
    position: Int,
    sources: List[ResultOwnership],
    enclosing: List[EnclosingBlock],
    first_value: Int,
) -> Result[Option[PassedCall], Diagnostic]:
    unchanged: Option[PassedCall] = None
    match definition.operation:
        CallDefinition(RuntimeFunction(operation), arguments):
            if operation.reuses_first_operand():
                definition.pass_arguments(
                    RuntimeFunction(operation),
                    arguments,
                    InPlaceOperand,
                    first_owner,
                    pre_step_drops,
                    loop_uses,
                    consumed,
                    position,
                    sources,
                    enclosing,
                    first_value,
                )
            else:
                Ok(unchanged)
        CallDefinition(UserFunction(callee), arguments):
            match callees:
                EveryCallBorrows: Ok(unchanged)
                InstanceRows(rows):
                    match rows.get(callee.function_number()):
                        None:
                            Err(
                                internal_error(
                                    definition.span,
                                    "call to an instance with no contract",
                                ),
                            )
                        Some(callee_rows):
                            if callee_rows.any(parameter_owned):
                                definition.pass_arguments(
                                    UserFunction(callee),
                                    arguments,
                                    OwnedPositions(callee_rows.map(parameter_owned)),
                                    first_owner,
                                    pre_step_drops,
                                    loop_uses,
                                    consumed,
                                    position,
                                    sources,
                                    enclosing,
                                    first_value,
                                )
                            else:
                                Ok(unchanged)
        _: Ok(unchanged)


-- The candidate enclosing obligations a block reads, directly or through a
-- borrow, each at its last read: a step, or the terminal after the last step.
-- Nested reads and outgoing occurrences participate in the same last use.
private pure func enclosing_owner_uses(
    steps: List[LoweredStep],
    terminal: List[ValueId],
    candidates: List[ScheduledDrop],
    enclosing: List[EnclosingBlock],
    span: Span,
) -> Result[List[ScheduledDrop], Diagnostic]:
    outer = enclosing.enclosing_intervals()
    var uses: List[ScheduledDrop] = []
    var failure: Option[Diagnostic] = None
    var position = 0
    for reads in (
        steps
            .map(step_reads)
            .append(terminal)
    ):
        for value in reads:
            if (
                value
                    .value_number()
                    .visible_outside(outer)
            ):
                match value.dependency_owner([], enclosing, 0, span):
                    Err(error): failure = Some(error)
                    Ok(None): void
                    Ok(Some(owner)):
                        match candidates.find(pure func(row): row.owner == owner):
                            None: void
                            Some(row):
                                var recorded: Option[Int] = None
                                var index = 0
                                for use in uses:
                                    if use.owner == owner:
                                        recorded = Some(index)
                                        break
                                    index = index + 1
                                read: ScheduledDrop = { row | last = position }
                                match recorded:
                                    Some(at): uses = uses.set(at, read)
                                    None: uses = uses.append(read)
        position = position + 1
    match failure:
        Some(error): Err(error)
        None: Ok(uses)


-- Only the nearest loop's enclosing values receive rows, once for this terminal
-- block. A row the block never reads stays live to the edge, which retires it.
private pure func loop_consumption_uses(
    steps: List[LoweredStep],
    exit: LoopExit,
    enclosing: List[EnclosingBlock],
    scope: LoopScope,
) -> Result[List[ScheduledDrop], Diagnostic]:
    var candidates: List[ScheduledDrop] = []
    var block_position = 0
    for block in enclosing:
        if block_position >= scope.pre_blocks:
            for owner in block.owners:
                if (owner.last >= block.position).and(
                    block.consumed
                        .has_consumed(owner.owner)
                        .not(),
                ):
                    candidates = candidates.append(owner)
        block_position = block_position + 1
    steps.enclosing_owner_uses(
        exit.loop_exit_values(),
        candidates,
        enclosing,
        exit.loop_exit_span(),
    )


-- A transferable owner moves into its header only when its own initial is
-- the one read of the loop step it backs: `reads` holds every header initial
-- and every body read. Two headers fed by one owner therefore both acquire.
private pure func sole_backer_entry(
    owner: OwnerId,
    reads: List[ValueId],
    sources: List[ResultOwnership],
    enclosing: List[EnclosingBlock],
    first_value: Int,
    span: Span,
) -> Result[HeaderEntry, Diagnostic]:
    var backed = 0
    var failure: Option[Diagnostic] = None
    for value in reads:
        match value.dependency_owner(sources, enclosing, first_value, span):
            Ok(Some(other)):
                if other == owner:
                    backed = backed + 1
            Ok(None): void
            Err(error):
                failure = Some(error)
                break
    match failure:
        Some(error): Err(error)
        None:
            if backed == 1:
                Ok(TakeOwner(owner))
            else:
                Ok(AcquireAtEntry)


-- A header takes its initial's obligation when the owner holds the initial
-- itself, may transfer at this step and backs no other read of the step.
private pure func header_entry(
    header: Lower.LoopHeader,
    reads: List[ValueId],
    step_drops: List[ScheduledDrop],
    loop_uses: List[ScheduledDrop],
    consumed: List[OwnerId],
    position: Int,
    sources: List[ResultOwnership],
    enclosing: List[EnclosingBlock],
    first_value: Int,
) -> Result[HeaderEntry, Diagnostic]:
    source ?= header.initial.value_source(sources, enclosing, first_value, header.parameter.span)
    -- Sole backing already keeps a second header from taking the same owner.
    match source.transfer(step_drops, loop_uses, consumed, position, []):
        Moves(owner):
            owner.sole_backer_entry(reads, sources, enclosing, first_value, header.parameter.span)
        Acquires: Ok(AcquireAtEntry)


private pure func entering_headers(
    loop: LoweredLoop,
    reads: List[ValueId],
    pre_step_drops: Option[List[ScheduledDrop]],
    loop_uses: List[ScheduledDrop],
    consumed: List[OwnerId],
    position: Int,
    sources: List[ResultOwnership],
    enclosing: List[EnclosingBlock],
    first_value: Int,
) -> Result[List[EnteringHeader], Diagnostic]:
    step_drops ?= pre_step_drops.or_internal_error(loop.result.span, "missing drop schedule row")
    var entering: List[EnteringHeader] = []
    var failure: Option[Diagnostic] = None
    for header in loop.headers:
        match header.header_entry(
            reads,
            step_drops,
            loop_uses,
            consumed,
            position,
            sources,
            enclosing,
            first_value,
        ):
            Ok(entry): entering = entering.append({ header = header, entry = entry })
            Err(error):
                failure = Some(error)
                break
    match failure:
        Some(error): Err(error)
        None: Ok(entering)


-- Each value's last read in this block, extended through the record
-- projections read from it: a projection that borrows keeps its parent in use.
-- Every projection counts, even one that later acquires, so an extent may only
-- overstate a parent's use.
private pure func borrowed_extents(
    steps: List[LoweredStep],
    uses: List[Option[Int]],
    first_value: Int,
) -> List[Option[Int]]:
    var extents = uses
    var position = steps.length()
    while position > 0:
        position = position - 1
        match steps.get(position):
            Some(Define(definition)):
                match definition.operation:
                    ReadRecordFieldValue(_, parent):
                        parent_slot = parent.value_number() - first_value
                        match extents.get(definition.id.value_number() - first_value):
                            Some(Some(read)):
                                if parent_slot >= 0:
                                    match extents.get(parent_slot):
                                        Some(Some(known)):
                                            if read > known:
                                                extents = extents.set(parent_slot, Some(read))
                                        Some(None): extents = extents.set(parent_slot, Some(read))
                                        None: void
                            _: void
                    _: void
            _: void
    extents


-- The first point of this block, from `position` on, where `owner`'s
-- obligation may end, asked of `transfer`'s own predicate: a step whose drop
-- bucket or loop row ends it, where it drops or moves, or else the block's
-- end, where an edge retires or moves it.
private pure func retirement(
    owner: OwnerId,
    drops: List[List[ScheduledDrop]],
    loop_uses: List[ScheduledDrop],
    consumed: List[OwnerId],
    position: Int,
) -> Int:
    var retired = drops.length()
    var at = position
    while at < drops.length():
        match drops.get(at):
            Some(bucket):
                if bucket.transferable_here(loop_uses, consumed, owner, at):
                    retired = at
                    break
            None: void
        at = at + 1
    retired


-- Whether a record projection may stay a borrow of `parent`: the obligation
-- behind the parent outlives the projection's extended last read, or both end
-- at the block's end, whose edges acquire their outputs before they move or
-- drop what they retire. At a step where the obligation ends, that step or
-- its arms may move the parent while they read the projection; a borrow there
-- would hold the parent back from moving and turn its in-place update into a
-- copy, so the projection acquires. A loop block whose tail is a match has no
-- extents: its arms take its owners, so only a projection of a borrowed
-- parameter borrows there.
private pure func projection_lasts(
    parent: ValueId,
    extents: Option[List[Option[Int]]],
    slot: Int,
    drops: List[List[ScheduledDrop]],
    loop_uses: List[ScheduledDrop],
    consumed: List[OwnerId],
    position: Int,
    sources: List[ResultOwnership],
    enclosing: List[EnclosingBlock],
    first_value: Int,
    span: Span,
) -> Result[Bool, Diagnostic]:
    backing ?= parent.dependency_owner(sources, enclosing, first_value, span)
    match (backing, extents):
        (None, _): Ok(True)
        (Some(_), None): Ok(False)
        (Some(owner), Some(rows)):
            match rows.get(slot):
                None: Err(internal_error(span, "missing value-use row"))
                -- An unread projection has no read after its parent's.
                Some(None): Ok(True)
                Some(Some(last)):
                    retired = owner.retirement(drops, loop_uses, consumed, position)
                    Ok((last < retired).or(retired == drops.length()))


private pure func insert_steps(
    steps: List[LoweredStep],
    schedule: DropSchedule,
    enclosing: List[EnclosingBlock],
    first_value: Int,
    initial_owner: Int,
    seed_inputs: List[OwnedJoinParameter],
    loop_scope: Option[LoopScope],
    loop_uses: List[ScheduledDrop],
    discharges: List[EnteringDischarge],
    contracts: CallContracts,
    unions: List[ConcreteUnion],
    records: List[ConcreteRecord],
) -> Result[InsertedSteps, Diagnostic]:
    count = steps.length()
    extents: Option[List[Option[Int]]] = match schedule:
        DropAtLastUse(uses): Some(steps.borrowed_extents(uses, first_value))
        DropInEachArm: None
    var drops = steps.map(pure func(_: LoweredStep) -> List[ScheduledDrop]: [])
    var consumed: List[OwnerId] = match enclosing.get(enclosing.length() - 1):
        Some(block): block.consumed
        None: []
    var entries: List[InsertedEntry] = []
    var sources = seed_inputs.map(join_ownership)
    var owners: List[ScheduledDrop] = []
    var next_owner = initial_owner
    var step_position: Int = 0
    var failure: Option[Diagnostic] = None

    var input_slot = 0
    for input in seed_inputs:
        match input.join_ownership():
            OwnedResult(owner):
                span = input.join_parameter().span
                match schedule:
                    DropInEachArm:
                        owners = owners.append({ owner = owner, span = span, last = count })
                    DropAtLastUse(uses):
                        match uses.get(input_slot):
                            None: failure = Some(internal_error(span, "missing input-use row"))
                            Some(None): entries = entries.append(Inserted(DropOwner(owner, span)))
                            Some(Some(last)):
                                owners = owners.append({ owner = owner, span = span, last = last })
                                if last < count:
                                    match drops.get(last):
                                        Some(bucket):
                                            drops = drops.set(
                                                last,
                                                bucket.append({
                                                    owner = owner,
                                                    span = span,
                                                    last = last,
                                                }),
                                            )
                                        None:
                                            failure = Some(
                                                internal_error(
                                                    span,
                                                    "invalid input last-use position",
                                                ),
                                            )
            _: void
        input_slot = input_slot + 1

    -- Entering obligations go into drop buckets, never into `owners`: the
    -- enclosing snapshot keeps the one row an abrupt edge retires. Each one
    -- discharged here joins `consumed`, so a later abrupt edge leaves it alone.
    for discharge in discharges:
        match discharge:
            DropOnEntry(owner, drop_span):
                entries = entries.append(Inserted(DropOwner(owner, drop_span)))
                consumed = consumed.append(owner)
            LastReadInArm(row):
                if row.last < count:
                    match drops.get(row.last):
                        Some(bucket): drops = drops.set(row.last, bucket.append(row))
                        None:
                            failure = Some(
                                internal_error(row.span, "invalid entering last-use position"),
                            )

    for step in steps:
        if failure.is_some():
            break
        value_slot = sources.length()
        span = step.step_span()
        var carried: List[OwnedJoinParameter] = []
        var taken_here: List[OwnerId] = []
        -- Candidates use the pre-call bucket; current-result scheduling below may
        -- add a new drop, so retirement must read the updated bucket afterward.
        pre_step_drops = drops.get(step_position)
        available_result: Result[ResultOwnership, Diagnostic] = match step:
            Join(join):
                match join.result.build_outputs(join.carried, next_owner, unions, records):
                    Err(error): Err(error)
                    Ok(built):
                        match join.selection.scrutinee.borrow_argument(
                            sources,
                            enclosing,
                            first_value,
                            join.result.span,
                        ):
                            Err(error): Err(error)
                            Ok(scrutinee):
                                match pre_step_drops.join_entering(
                                    loop_uses,
                                    consumed,
                                    step_position,
                                    span,
                                ):
                                    Err(error): Err(error)
                                    Ok(taken):
                                        -- The arms' snapshot precedes the transfer, so they can discharge
                                        -- what enters; only the continuation counts it consumed.
                                        entries = entries.append(
                                            AwaitingArms({
                                                join = join,
                                                scrutinee = scrutinee,
                                                result = built.result,
                                                carried = built.carried,
                                                entering = taken,
                                                enclosing = enclosing.append({
                                                    first_value = first_value,
                                                    sources = sources,
                                                    owners = owners,
                                                    position = step_position,
                                                    consumed = consumed,
                                                }),
                                                loop_scope = loop_scope,
                                            }),
                                        )
                                        consumed = consumed.concat(
                                            taken.map(pure func(row): row.owner),
                                        )
                                        next_owner = built.next_owner
                                        carried = built.carried
                                        Ok(built.result.join_ownership())
            Loop(loop):
                match loop.result.build_outputs(loop.carried, next_owner, unions, records):
                    Err(error): Err(error)
                    Ok(built):
                        match loop.entering_headers(
                            step.step_reads(),
                            pre_step_drops,
                            loop_uses,
                            consumed,
                            step_position,
                            sources,
                            enclosing,
                            first_value,
                        ):
                            Err(error): Err(error)
                            Ok(entering):
                                -- Taken owners belong to their headers: no drop after this step,
                                -- and no retirement at an enclosing loop's edge.
                                for decided in entering:
                                    match decided.entry:
                                        TakeOwner(owner): consumed = consumed.append(owner)
                                        AcquireAtEntry: void
                                entries = entries.append(
                                    AwaitingLoop({
                                        loop = loop,
                                        headers = entering,
                                        result = built.result,
                                        carried = built.carried,
                                        enclosing = enclosing.append({
                                            first_value = first_value,
                                            sources = sources,
                                            owners = owners,
                                            position = step_position,
                                            consumed = consumed,
                                        }),
                                    }),
                                )
                                next_owner = built.next_owner
                                carried = built.carried
                                Ok(built.result.join_ownership())
            Define(definition):
                match definition.build_definition(
                    sources,
                    enclosing,
                    first_value,
                    next_owner,
                    pre_step_drops,
                    loop_uses,
                    consumed,
                    step_position,
                    contracts.parameters,
                    unions,
                    records,
                ):
                    Err(error): Err(error)
                    Ok(built):
                        match built.definition.pass_call(
                            contracts.callees,
                            next_owner,
                            pre_step_drops,
                            loop_uses,
                            consumed,
                            step_position,
                            sources,
                            enclosing,
                            first_value,
                        ):
                            Err(error): Err(error)
                            -- A call stores no payloads: transfers are its only acquisitions.
                            Ok(Some(passed)):
                                match built.acquisitions:
                                    StoredAcquisitions([], []):
                                        taken_here = passed.taken
                                        next_owner = passed.next_owner
                                        for acquisition in passed.acquisitions:
                                            entries = entries.append(
                                                Inserted(
                                                    AcquireOwner(
                                                        acquisition.owner,
                                                        acquisition.borrow,
                                                        span,
                                                    ),
                                                ),
                                            )
                                        entries = entries.append(
                                            Inserted(DefineValue(passed.definition)),
                                        )
                                        Ok(passed.definition.result)
                                    _:
                                        Err(
                                            internal_error(
                                                span,
                                                "a call that transfers an obligation cannot store payloads",
                                            ),
                                        )
                            Ok(None):
                                next_owner = built.next_owner
                                -- Stored payloads are acquired before the definition, or take an
                                -- owner last used here; a projection that cannot borrow acquires
                                -- after its read and owns its value.
                                match built.acquisitions:
                                    StoredAcquisitions(acquired, taken):
                                        taken_here = taken
                                        for acquisition in acquired:
                                            entries = entries.append(
                                                Inserted(
                                                    AcquireOwner(
                                                        acquisition.owner,
                                                        acquisition.borrow,
                                                        span,
                                                    ),
                                                ),
                                            )
                                        entries = entries.append(
                                            Inserted(DefineValue(built.definition)),
                                        )
                                        Ok(built.definition.result)
                                    Projection(borrow):
                                        entries = entries.append(
                                            Inserted(DefineValue(built.definition)),
                                        )
                                        lasts: Result[Bool, Diagnostic] = match borrow.source:
                                            PayloadBorrow(parent):
                                                parent.projection_lasts(
                                                    extents,
                                                    value_slot,
                                                    drops,
                                                    loop_uses,
                                                    consumed,
                                                    step_position,
                                                    sources,
                                                    enclosing,
                                                    first_value,
                                                    span,
                                                )
                                            _:
                                                Err(
                                                    internal_error(
                                                        span,
                                                        "record projection has no parent borrow",
                                                    ),
                                                )
                                        match lasts:
                                            Err(error): Err(error)
                                            Ok(True): Ok(built.definition.result)
                                            Ok(False):
                                                owner = owner_id(next_owner)
                                                next_owner = next_owner + 1
                                                entries = entries.append(
                                                    Inserted(AcquireOwner(owner, borrow, span)),
                                                )
                                                Ok(OwnedResult(owner))

        match available_result:
            Err(error):
                failure = Some(error)
                break
            Ok(available):
                sources = sources.append(available)
                -- A loop row this step took is consumed: no later step or edge
                -- of the loop may take or retire it.
                for owner in taken_here:
                    if loop_uses.matches_last_use(owner, step_position):
                        consumed = consumed.append(owner)

                match available:
                    OwnedResult(owner):
                        match schedule.drop_position(value_slot, step_position, count, span):
                            Err(error):
                                failure = Some(error)
                                break
                            Ok(until):
                                owners = owners.append({ owner = owner, span = span, last = until })
                                -- A use at the block's end transfers or keeps this obligation.
                                if until < count:
                                    match drops.get(until):
                                        None:
                                            failure = Some(
                                                internal_error(span, "missing drop schedule row"),
                                            )
                                            break
                                        Some(bucket):
                                            match steps.get(until):
                                                None:
                                                    failure = Some(
                                                        internal_error(
                                                            span,
                                                            "invalid last-use position",
                                                        ),
                                                    )
                                                    break
                                                Some(last):
                                                    drops = drops.set(
                                                        until,
                                                        bucket.append({
                                                            owner = owner,
                                                            span = last.step_span(),
                                                            last = until,
                                                        }),
                                                    )
                    _: void

        -- Several outputs share one execution position, but each owns a value
        -- slot and, when managed, an independently scheduled obligation.
        for output in carried:
            parameter = output.join_parameter()
            slot = sources.length()
            sources = sources.append(output.join_ownership())
            match output:
                UnmanagedJoinParameter(_): void
                ManagedJoinParameter(_, owner):
                    match schedule.drop_position(slot, step_position, count, parameter.span):
                        Err(error): failure = Some(error)
                        Ok(until):
                            owners = owners.append({
                                owner = owner,
                                span = parameter.span,
                                last = until,
                            })
                            if until < count:
                                match drops.get(until):
                                    None:
                                        failure = Some(
                                            internal_error(
                                                parameter.span,
                                                "missing drop schedule row",
                                            ),
                                        )
                                    Some(bucket):
                                        match steps.get(until):
                                            Some(last):
                                                drops = drops.set(
                                                    until,
                                                    bucket.append({
                                                        owner = owner,
                                                        span = last.step_span(),
                                                        last = until,
                                                    }),
                                                )
                                            None:
                                                failure = Some(
                                                    internal_error(
                                                        parameter.span,
                                                        "invalid last-use position",
                                                    ),
                                                )
            if failure.is_some():
                break
        if failure.is_some():
            break

        match drops.get(step_position):
            Some(bucket):
                for dropped in bucket:
                    transferred_here = taken_here.has_consumed(dropped.owner)
                    -- An entering obligation read here leaves the arm at this step.
                    entering_here: Bool = discharges.any(pure func(discharge):
                        match discharge:
                            LastReadInArm(row): row.owner == dropped.owner
                            DropOnEntry(_, _): False
                    )
                    if (
                        consumed
                            .has_consumed(dropped.owner)
                            .not()
                    ):
                        if transferred_here.not():
                            entries = entries.append(
                                Inserted(DropOwner(dropped.owner, dropped.span)),
                            )
                        if entering_here:
                            consumed = consumed.append(dropped.owner)
            None:
                failure = Some(internal_error(span, "missing drop schedule row"))
                break

        step_position = step_position + 1

    match failure:
        Some(error): Err(error)
        None:
            Ok({
                consumed = consumed,
                entries = entries,
                sources = sources,
                owners = owners,
                next_owner = next_owner,
            })


-- How a managed value leaves its block on a return or yield edge: an owner
-- it already holds, or one acquired from its borrow now.
private record LeavingValue {
    entries: List[InsertedEntry],
    transfer: ReturnTransfer,
    next_owner: Int,
}


-- An owned result read as a borrow of its owner, so the edge acquires a fresh
-- owner instead of moving the existing one: every edge output that acquires,
-- and loop entries that acquire because the owner stays live after the entry.
private pure func borrowed_result(source: ResultOwnership) -> ResultOwnership:
    match source:
        OwnedResult(owner): BorrowedResult(OwnerBorrow(owner))
        _: source


-- An outgoing occurrence of a selection edge, yield or loop exit asks
-- `transfer` against the rows its edge retires: one that moves leaves with
-- its owner, any other with a borrow that `leave_with` acquires. Every
-- acquisition precedes the edge's drops, so a value borrowed from a retiring
-- owner is acquired while that owner is live.
private pure func leaving_source(source: ResultOwnership, decided: Transfer) -> ResultOwnership:
    match decided:
        Moves(owner): OwnedResult(owner)
        Acquires: source.borrowed_result()


-- The owners moved at one point, after one more occurrence.
private pure func after_transfer(moved: List[OwnerId], decided: Transfer) -> List[OwnerId]:
    match decided:
        Moves(owner): moved.append(owner)
        Acquires: moved


private pure func leave_with(
    value: ValueId,
    source: ResultOwnership,
    entries: List[InsertedEntry],
    next_owner: Int,
    span: Span,
) -> LeavingValue:
    match source:
        UnmanagedResult:
            { entries = entries, transfer = UnmanagedReturn(value), next_owner = next_owner }
        OwnedResult(owner):
            { entries = entries, transfer = OwnedReturn(value, owner), next_owner = next_owner }
        BorrowedResult(borrow):
            owner = owner_id(next_owner)
            {
                entries = entries.append(
                    Inserted(AcquireOwner(owner, { value = value, source = borrow }, span)),
                ),
                transfer = OwnedReturn(value, owner),
                next_owner = next_owner + 1,
            }


private record InsertedSelectionEdge { edge: OwnedSelectionEdge, next_value: Int, next_owner: Int }


-- Selection borrows enclosing values. Only newly acquired occurrences cross
-- the successful edge, so the complete enclosing owner snapshot stays live.
private pure func selection_value(definition: Lower.SelectionDefinition) -> ValueDefinition:
    match definition:
        BorrowRecordField(parameter, field, parent):
            {
                id = parameter.id,
                value_type = parameter.value_type,
                operation = ReadRecordFieldValue(field, parent),
                span = parameter.span,
            }
        BorrowUnionField(parameter, field, parent):
            {
                id = parameter.id,
                value_type = parameter.value_type,
                operation = PayloadValue(field, parent),
                span = parameter.span,
            }
        BorrowListElement(parameter, index, parent):
            {
                id = parameter.id,
                value_type = parameter.value_type,
                operation = ListElementValue(index, parent),
                span = parameter.span,
            }
        CopyListSuffix(parameter, parent, skipped):
            {
                id = parameter.id,
                value_type = parameter.value_type,
                operation = ListSuffixValue(parent, skipped),
                span = parameter.span,
            }


private pure func insert_selection_edge(
    edge: SelectionEdge,
    enclosing: List[EnclosingBlock],
    first_value: Int,
    initial_owner: Int,
    unions: List[ConcreteUnion],
    records: List[ConcreteRecord],
) -> Result[InsertedSelectionEdge, Diagnostic]:
    var sources: List[ResultOwnership] = []
    var operations: List[OwnershipOperation] = []
    var next_owner = initial_owner
    var failure: Option[Diagnostic] = None
    for definition in edge.definitions:
        lowered = definition.selection_value()
        -- An edge's projections store nothing, and no obligation ends before its
        -- outputs: an empty drop row and no loop rows.
        match lowered.build_definition(
            sources,
            enclosing,
            first_value,
            next_owner,
            Some([]),
            [],
            [],
            0,
            [],
            unions,
            records,
        ):
            Err(error):
                failure = Some(error)
                break
            Ok(built):
                match built.acquisitions:
                    StoredAcquisitions(acquisitions, _):
                        for acquired in acquisitions:
                            operations = operations.append(
                                AcquireOwner(acquired.owner, acquired.borrow, lowered.span),
                            )
                        operations = operations.append(DefineValue(built.definition))
                        sources = sources.append(built.definition.result)
                    -- The scrutinee outlives its selection edges, so a record field
                    -- stays borrowed; one that crosses the edge acquires there.
                    Projection(_):
                        operations = operations.append(DefineValue(built.definition))
                        sources = sources.append(built.definition.result)
                next_owner = built.next_owner
    -- Fresh suffix roots retire at the edge.
    -- Source wildcards never create a projection or acquisition.
    position = sources.length()
    var ending: List[ScheduledDrop] = []
    for source in sources:
        match source:
            OwnedResult(owner):
                ending = ending.append({ owner = owner, span = compiler_span(), last = position })
            _: void
    var transfers: List[ReturnTransfer] = []
    var moved: List[OwnerId] = []
    for value in edge.arguments:
        if failure.is_some():
            break
        match value.value_source(sources, enclosing, first_value, compiler_span()):
            Err(error): failure = Some(error)
            Ok(source):
                decided = source.transfer(ending, [], [], position, moved)
                moved = moved.after_transfer(decided)
                leaving = value.leave_with(
                    source.leaving_source(decided),
                    [],
                    next_owner,
                    compiler_span(),
                )
                for entry in leaving.entries:
                    match entry:
                        Inserted(operation): operations = operations.append(operation)
                        _:
                            failure = Some(
                                internal_error(
                                    compiler_span(),
                                    "selection edge contains control flow",
                                ),
                            )
                transfers = transfers.append(leaving.transfer)
                next_owner = leaving.next_owner
    for row in ending:
        if (
            moved
                .has_consumed(row.owner)
                .not()
        ):
            operations = operations.append(DropOwner(row.owner, row.span))
    match failure:
        Some(error): Err(error)
        None:
            Ok({
                edge = { arm = edge.arm, operations = operations, transfers = transfers },
                next_value = first_value + sources.length(),
                next_owner = next_owner,
            })


private record InsertedSelection { selection: OwnedSelection, next_value: Int, next_owner: Int }


private pure func insert_selection(
    selection: LoweredSelection,
    scrutinee: OwnedArgument,
    enclosing: List[EnclosingBlock],
    first_value: Int,
    initial_owner: Int,
    unions: List[ConcreteUnion],
    records: List[ConcreteRecord],
) -> Result[InsertedSelection, Diagnostic]:
    var nodes: List[OwnedDecisionNode] = []
    var next_value = first_value
    var next_owner = initial_owner
    var failure: Option[Diagnostic] = None
    for node in selection.nodes:
        match node:
            Lower.TestVariant(place, variant, yes, no):
                nodes = nodes.append(TestVariant(place, variant, yes, no))
            Lower.TestListLength(place, test, yes, no):
                nodes = nodes.append(TestListLength(place, test, yes, no))
            Lower.TestLiteral(place, literal, yes, no):
                nodes = nodes.append(TestLiteral(place, literal, yes, no))
            Lower.EnterArm(edge):
                match edge.insert_selection_edge(
                    enclosing,
                    next_value,
                    next_owner,
                    unions,
                    records,
                ):
                    Err(error):
                        failure = Some(error)
                        break
                    Ok(inserted):
                        nodes = nodes.append(EnterArm(inserted.edge))
                        next_value = inserted.next_value
                        next_owner = inserted.next_owner
    match failure:
        Some(error): Err(error)
        None:
            Ok({
                selection = { scrutinee = scrutinee, nodes = nodes, entry = selection.entry },
                next_value = next_value,
                next_owner = next_owner,
            })


private record InsertedJoinArm { arm: OwnedJoinArm, next_owner: Int, next_value: Int }


private record LeavingJoin {
    entries: List[InsertedEntry],
    transfer: ReturnTransfer,
    carried: List[ReturnTransfer],
    next_owner: Int,
}


-- The owners a yield retires: the arm's own sources still live at its end.
-- Sources already dropped by insert_steps, and all enclosing owners, remain
-- untouched.
private pure func terminal_owners(
    sources: List[ResultOwnership],
    uses: List[Option[Int]],
    position: Int,
    span: Span,
) -> Result[List[ScheduledDrop], Diagnostic]:
    var rows: List[ScheduledDrop] = []
    var slot = 0
    var failure: Option[Diagnostic] = None
    for source in sources:
        match uses.get(slot):
            None:
                failure = Some(internal_error(span, "missing value-use row"))
                break
            Some(last_use):
                match source:
                    OwnedResult(owner):
                        match last_use:
                            Some(last):
                                if last == position:
                                    rows = rows.append({
                                        owner = owner,
                                        span = span,
                                        last = position,
                                    })
                            _: void
                    _: void
        slot = slot + 1
    match failure:
        Some(error): Err(error)
        None: Ok(rows)


private pure func leave_join(
    outputs: Lower.JoinOutputs,
    step_count: Int,
    parameters: List[ValueParameter],
    inserted: InsertedSteps,
    uses: List[Option[Int]],
    discharges: List[EnteringDischarge],
    enclosing: List[EnclosingBlock],
    first_value: Int,
    span: Span,
) -> Result[LeavingJoin, Diagnostic]:
    ending ?= inserted.sources.terminal_owners(uses, step_count, span)
    result_source ?= outputs.value.value_source(inserted.sources, enclosing, first_value, span)
    result_transfer = result_source.transfer(ending, [], [], step_count, [])
    var moved = [].after_transfer(result_transfer)
    leaving = outputs.value.leave_with(
        result_source.leaving_source(result_transfer),
        inserted.entries,
        inserted.next_owner,
        span,
    )
    var entries = leaving.entries
    var next_owner = leaving.next_owner
    var carried: List[ReturnTransfer] = []
    var position = 0
    var failure: Option[Diagnostic] = None
    for parameter in parameters:
        match outputs.carried.get(position):
            None:
                failure = Some(internal_error(span, "join arm carries the wrong number of values"))
            Some(value):
                match value.value_source(inserted.sources, enclosing, first_value, parameter.span):
                    Err(error): failure = Some(error)
                    Ok(carrier_source):
                        decided = carrier_source.transfer(ending, [], [], step_count, moved)
                        moved = moved.after_transfer(decided)
                        left = value.leave_with(
                            carrier_source.leaving_source(decided),
                            entries,
                            next_owner,
                            parameter.span,
                        )
                        entries = left.entries
                        next_owner = left.next_owner
                        carried = carried.append(left.transfer)
        if failure.is_some():
            break
        position = position + 1
    ready: Void ?= match failure:
        Some(error): Err(error)
        None: Ok(void)
    -- Only after every acquisition of the yield may the owners it did not move
    -- retire. An entering obligation the yield reads has no slot in this arm;
    -- it retires here too.
    var completed = entries
    for row in ending:
        if (
            moved
                .has_consumed(row.owner)
                .not()
        ):
            completed = completed.append(Inserted(DropOwner(row.owner, row.span)))
    for discharge in discharges:
        match discharge:
            LastReadInArm(row):
                if row.last == step_count:
                    completed = completed.append(Inserted(DropOwner(row.owner, span)))
            DropOnEntry(_, _): void

    match failure:
        Some(error): Err(error)
        None:
            Ok({
                entries = completed,
                transfer = leaving.transfer,
                carried = carried,
                next_owner = next_owner,
            })


private pure func join_terminal_span(
    arm: JoinArm,
    result: ValueId,
    outer: List[ValueInterval],
) -> Result[Span, Diagnostic]:
    var input_span: Option[Span] = None
    for parameter in arm.inputs:
        if parameter.id == result:
            input_span = Some(parameter.span)
            break
    match input_span:
        Some(span): Ok(span)
        None: arm.steps.terminal_span(result, outer)


-- Where one yielding arm discharges each obligation entering its join.
private pure func entering_discharges(
    arm: JoinArm,
    outputs: Lower.JoinOutputs,
    entering: List[ScheduledDrop],
    enclosing: List[EnclosingBlock],
    span: Span,
) -> Result[List[EnteringDischarge], Diagnostic]:
    reads ?= arm.steps.enclosing_owner_uses(
        [outputs.value].concat(outputs.carried),
        entering,
        enclosing,
        span,
    )
    var discharges: List[EnteringDischarge] = []
    for row in entering:
        match reads.find(pure func(read): read.owner == row.owner):
            Some(read): discharges = discharges.append(LastReadInArm(read))
            None: discharges = discharges.append(DropOnEntry(row.owner, row.span))
    Ok(discharges)


private pure func insert_yielding_arm(
    arm: JoinArm,
    outputs: Lower.JoinOutputs,
    parameters: List[ValueParameter],
    result_span: Span,
    entering: List[ScheduledDrop],
    enclosing: List[EnclosingBlock],
    loop_scope: Option[LoopScope],
    first_value: Int,
    inputs: BuiltInputs,
    contracts: CallContracts,
    unions: List[ConcreteUnion],
    records: List[ConcreteRecord],
) -> Result[InsertedJoinArm, Diagnostic]:
    admitted: Void ?= if outputs.carried.length() == parameters.length():
        Ok(void)
    else:
        Err(internal_error(result_span, "join arm carries the wrong number of values"))
    outer = enclosing.enclosing_intervals()
    span ?= arm.join_terminal_span(outputs.value, outer)
    terminal: BlockTerminal = TerminalJoin(outputs.value, outputs.carried, parameters)
    uses ?= arm.steps.block_uses(terminal, outer, first_value, arm.inputs.length(), Ok(span))
    discharges ?= arm.entering_discharges(outputs, entering, enclosing, span)
    inserted ?= arm.steps.insert_steps(
        DropAtLastUse(uses),
        enclosing,
        first_value,
        inputs.next_owner,
        inputs.parameters,
        loop_scope,
        [],
        discharges,
        contracts,
        unions,
        records,
    )
    leaving ?= outputs.leave_join(
        arm.steps.length(),
        parameters,
        inserted,
        uses,
        discharges,
        enclosing,
        first_value,
        span,
    )
    completed ?= leaving.entries.complete_joins(
        first_value + inserted.sources.length(),
        leaving.next_owner,
        contracts,
        unions,
        records,
    )
    Ok({
        arm = {
            id = arm.id,
            inputs = inputs.parameters,
            operations = completed.operations,
            exit = Yield({ transfer = leaving.transfer, carried = leaving.carried }),
        },
        next_owner = completed.next_owner,
        next_value = completed.next_value,
    })


private pure func insert_abrupt_arm(
    arm: JoinArm,
    target: Lower.LoopTarget,
    tail: Lower.LoopTail,
    result_span: Span,
    enclosing: List[EnclosingBlock],
    loop_scope: Option[LoopScope],
    first_value: Int,
    inputs: BuiltInputs,
    contracts: CallContracts,
    unions: List[ConcreteUnion],
    records: List[ConcreteRecord],
) -> Result[InsertedJoinArm, Diagnostic]:
    scope ?= loop_scope.require_loop_scope(target, result_span)
    body ?= insert_loop_block(
        { steps = arm.steps, tail = tail },
        inputs.parameters,
        0,
        enclosing,
        scope,
        first_value,
        inputs.next_owner,
        result_span,
        contracts,
        unions,
        records,
    )
    Ok({
        arm = {
            id = arm.id,
            inputs = inputs.parameters,
            operations = body.body.operations,
            exit = TransferLoop(target, body.body.tail),
        },
        next_owner = body.next_owner,
        next_value = body.next_value,
    })


-- Abrupt arms receive no entering obligations: their edge retires every
-- live loop-scope owner, and the snapshot does not count those consumed.
private pure func insert_join_arm(
    arm: JoinArm,
    parameters: List[ValueParameter],
    result_span: Span,
    entering: List[ScheduledDrop],
    enclosing: List[EnclosingBlock],
    loop_scope: Option[LoopScope],
    first_value: Int,
    initial_owner: Int,
    contracts: CallContracts,
    unions: List[ConcreteUnion],
    records: List[ConcreteRecord],
) -> Result[InsertedJoinArm, Diagnostic]:
    inputs ?= arm.inputs.build_inputs(initial_owner, unions, records)
    match arm.exit:
        Lower.Yield(outputs):
            arm.insert_yielding_arm(
                outputs,
                parameters,
                result_span,
                entering,
                enclosing,
                loop_scope,
                first_value,
                inputs,
                contracts,
                unions,
                records,
            )
        Lower.TransferLoop(target, tail):
            arm.insert_abrupt_arm(
                target,
                tail,
                result_span,
                enclosing,
                loop_scope,
                first_value,
                inputs,
                contracts,
                unions,
                records,
            )


private record CompletedOwnedJoin { join: OwnedJoin, next_value: Int, next_owner: Int }


private pure func complete_pending_join(
    pending: PendingOwnedJoin,
    first_value: Int,
    initial_owner: Int,
    contracts: CallContracts,
    unions: List[ConcreteUnion],
    records: List[ConcreteRecord],
) -> Result[CompletedOwnedJoin, Diagnostic]:
    selected ?= pending.join.selection.insert_selection(
        pending.scrutinee,
        pending.enclosing,
        first_value,
        initial_owner,
        unions,
        records,
    )
    var next_value = selected.next_value
    var next_owner = selected.next_owner
    var arms: List[OwnedJoinArm] = []
    var failure: Option[Diagnostic] = None
    for arm in pending.join.arms:
        match arm.insert_join_arm(
            pending.join.carried,
            pending.join.result.span,
            pending.entering,
            pending.enclosing,
            pending.loop_scope,
            next_value,
            next_owner,
            contracts,
            unions,
            records,
        ):
            Err(error):
                failure = Some(error)
                break
            Ok(inserted):
                arms = arms.append(inserted.arm)
                next_value = inserted.next_value
                next_owner = inserted.next_owner
    match failure:
        Some(error): Err(error)
        None:
            Ok({
                join = {
                    result = pending.result,
                    carried = pending.carried,
                    entering = pending.entering.map(pure func(row): row.owner),
                    selection = selected.selection,
                    arms = arms,
                },
                next_value = next_value,
                next_owner = next_owner,
            })


private record CompletedJoins {
    operations: List[OwnershipOperation],
    next_owner: Int,
    next_value: Int,
}


-- Builds each join's definition once its block is complete: its arms are
-- inserted after the block's own values and owners: selection edges first,
-- then canonical inputs and ordinary arm bodies in arm order.
private pure func complete_joins(
    entries: List[InsertedEntry],
    first_value: Int,
    first_owner: Int,
    contracts: CallContracts,
    unions: List[ConcreteUnion],
    records: List[ConcreteRecord],
) -> Result[CompletedJoins, Diagnostic]:
    var operations: List[OwnershipOperation] = []
    var next_value = first_value
    var next_owner = first_owner
    var failure: Option[Diagnostic] = None
    for entry in entries:
        match entry:
            Inserted(operation): operations = operations.append(operation)
            AwaitingLoop(pending):
                match pending.loop.insert_loop(
                    pending.headers,
                    pending.enclosing,
                    next_value,
                    next_owner,
                    contracts,
                    unions,
                    records,
                ):
                    Err(error):
                        failure = Some(error)
                        break
                    Ok(built):
                        operations = operations.append(
                            ExecuteLoop({
                                entry_acquisitions = built.acquisitions,
                                headers = built.headers,
                                result = pending.result,
                                carried = pending.carried,
                                body = built.body,
                            }),
                        )
                        next_value = built.next_value
                        next_owner = built.next_owner
            AwaitingArms(join):
                match join.complete_pending_join(
                    next_value,
                    next_owner,
                    contracts,
                    unions,
                    records,
                ):
                    Err(error):
                        failure = Some(error)
                        break
                    Ok(completed):
                        operations = operations.append(ExecuteJoin(completed.join))
                        next_value = completed.next_value
                        next_owner = completed.next_owner
    match failure:
        Some(error): Err(error)
        None: Ok({ operations = operations, next_owner = next_owner, next_value = next_value })


private record InsertedLoopBlock { body: OwnedLoopBlock, next_value: Int, next_owner: Int }


private record InsertedLoop {
    acquisitions: List[OwnerAcquisition],
    headers: List[OwnedLoopHeader],
    body: OwnedLoopBlock,
    next_value: Int,
    next_owner: Int,
}


private record LoopEdgeEntries {
    entries: List[InsertedEntry],
    exit: OwnedLoopExit,
    next_owner: Int,
}


private pure func loop_exit_values(exit: LoopExit) -> List[ValueId]:
    match exit:
        Lower.Recur(arguments, _): arguments
        Lower.Break(outputs): [outputs.value].concat(outputs.carried)


private pure func loop_exit_span(exit: LoopExit) -> Span:
    match exit:
        Lower.Recur(_, span): span
        Lower.Break(outputs): outputs.span


private pure func require_loop_scope(
    scope: Option[LoopScope],
    target: Lower.LoopTarget,
    span: Span,
) -> Result[LoopScope, Diagnostic]:
    match scope:
        None: Err(internal_error(span, "loop transfer has no active loop"))
        Some(active):
            if active.target == target:
                Ok(active)
            else:
                Err(internal_error(span, "loop transfer does not target the nearest loop"))


-- The owners a loop edge retires: this block's and the loop scope's enclosing
-- owners still live at the edge. Scheduling records are frozen at the exact
-- occurrence. Earlier drops are excluded without walking or reconstructing
-- the enclosing source body.
private pure func edge_live_owners(
    inserted: InsertedSteps,
    enclosing: List[EnclosingBlock],
    scope: LoopScope,
    position: Int,
) -> List[ScheduledDrop]:
    live = pure func(owners: List[ScheduledDrop], at: Int) -> List[ScheduledDrop]:
        owners.filter(
            pure func(row): (row.last >= at).and(
                inserted.consumed
                    .has_consumed(row.owner)
                    .not(),
            ),
        )
    var rows = live(inserted.owners, position)
    var ordinal = 0
    for block in enclosing:
        if ordinal >= scope.pre_blocks:
            rows = rows.concat(live(block.owners, block.position))
        ordinal = ordinal + 1
    rows


-- Each outgoing occurrence asks `transfer` against the owners the edge
-- retires; the edge drops the rest after every acquisition.
private pure func leave_loop(
    exit: LoopExit,
    inserted: InsertedSteps,
    enclosing: List[EnclosingBlock],
    scope: LoopScope,
    first_value: Int,
    position: Int,
) -> Result[LoopEdgeEntries, Diagnostic]:
    span = exit.loop_exit_span()
    retiring = inserted.edge_live_owners(enclosing, scope, position)
    var entries = inserted.entries
    var next_owner = inserted.next_owner
    var transfers: List[ReturnTransfer] = []
    var moved: List[OwnerId] = []
    var failure: Option[Diagnostic] = None
    for value in exit.loop_exit_values():
        match value.value_source(inserted.sources, enclosing, first_value, span):
            Err(error):
                failure = Some(error)
                break
            Ok(source):
                decided = source.transfer(retiring, [], [], position, moved)
                moved = moved.after_transfer(decided)
                leaving = value.leave_with(
                    source.leaving_source(decided),
                    entries,
                    next_owner,
                    span,
                )
                entries = leaving.entries
                next_owner = leaving.next_owner
                transfers = transfers.append(leaving.transfer)
    ready: Void ?= match failure:
        Some(error): Err(error)
        None: Ok(void)
    for row in retiring:
        if (
            moved
                .has_consumed(row.owner)
                .not()
        ):
            entries = entries.append(Inserted(DropOwner(row.owner, row.span)))
    owned_exit: OwnedLoopExit ?= match exit:
        Lower.Recur(_, occurrence): Ok(Recur(transfers, occurrence))
        Lower.Break(outputs):
            match transfers:
                [first, ...carried]:
                    Ok(Break({ value = first, carried = carried, span = outputs.span }))
                []: Err(internal_error(span, "missing loop result transfer"))
    Ok({ entries = entries, exit = owned_exit, next_owner = next_owner })


private pure func insert_loop_exit_block(
    steps: List[LoweredStep],
    exit: LoopExit,
    seed_inputs: List[OwnedJoinParameter],
    held_headers: Int,
    enclosing: List[EnclosingBlock],
    scope: LoopScope,
    first_value: Int,
    initial_owner: Int,
    span: Span,
    contracts: CallContracts,
    unions: List[ConcreteUnion],
    records: List[ConcreteRecord],
) -> Result[InsertedLoopBlock, Diagnostic]:
    uses ?= steps.block_uses(
        TerminalArguments(exit.loop_exit_values()),
        enclosing.enclosing_intervals(),
        first_value,
        seed_inputs.length(),
        Ok(span),
    )
    -- Header obligations survive until the complete edge batch, including
    -- old values that are not outgoing. Arm inputs keep last-use scheduling.
    var held_uses = uses
    enclosing_uses ?= steps.loop_consumption_uses(exit, enclosing, scope)
    var loop_uses = enclosing_uses
    var input_slot = 0
    while input_slot < held_headers:
        match seed_inputs.get(input_slot):
            Some(ManagedJoinParameter(parameter, owner)):
                match uses.get(input_slot):
                    Some(Some(last)):
                        loop_uses = loop_uses.append({
                            owner = owner,
                            span = parameter.span,
                            last = last,
                        })
                    _: void
            _: void
        held_uses = held_uses.set(input_slot, Some(steps.length()))
        input_slot = input_slot + 1
    inserted ?= steps.insert_steps(
        DropAtLastUse(held_uses),
        enclosing,
        first_value,
        initial_owner,
        seed_inputs,
        Some(scope),
        loop_uses,
        [],
        contracts,
        unions,
        records,
    )
    leaving ?= exit.leave_loop(inserted, enclosing, scope, first_value, steps.length())
    completed ?= leaving.entries.complete_joins(
        first_value + inserted.sources.length(),
        leaving.next_owner,
        contracts,
        unions,
        records,
    )
    Ok({
        body = { operations = completed.operations, tail = ExitLoop(leaving.exit) },
        next_value = completed.next_value,
        next_owner = completed.next_owner,
    })


private pure func insert_loop_match_block(
    steps: List[LoweredStep],
    matched: Lower.LoopMatch,
    seed_inputs: List[OwnedJoinParameter],
    enclosing: List[EnclosingBlock],
    scope: LoopScope,
    first_value: Int,
    initial_owner: Int,
    span: Span,
    contracts: CallContracts,
    unions: List[ConcreteUnion],
    records: List[ConcreteRecord],
) -> Result[InsertedLoopBlock, Diagnostic]:
    prefix ?= steps.insert_steps(
        DropInEachArm,
        enclosing,
        first_value,
        initial_owner,
        seed_inputs,
        Some(scope),
        [],
        [],
        contracts,
        unions,
        records,
    )
    scrutinee ?= matched.selection.scrutinee.borrow_argument(
        prefix.sources,
        enclosing,
        first_value,
        span,
    )
    completed ?= prefix.entries.complete_joins(
        first_value + prefix.sources.length(),
        prefix.next_owner,
        contracts,
        unions,
        records,
    )
    outer: List[EnclosingBlock] = enclosing.append({
        first_value = first_value,
        sources = prefix.sources,
        owners = prefix.owners,
        position = steps.length(),
        consumed = prefix.consumed,
    })
    selected ?= matched.selection.insert_selection(
        scrutinee,
        outer,
        completed.next_value,
        completed.next_owner,
        unions,
        records,
    )
    var next_value = selected.next_value
    var next_owner = selected.next_owner
    var arms: List[OwnedLoopArm] = []
    var failure: Option[Diagnostic] = None
    for arm in matched.arms:
        match arm.inputs.build_inputs(next_owner, unions, records):
            Err(error): failure = Some(error)
            Ok(inputs):
                match arm.body.insert_loop_block(
                    inputs.parameters,
                    0,
                    outer,
                    scope,
                    next_value,
                    inputs.next_owner,
                    span,
                    contracts,
                    unions,
                    records,
                ):
                    Err(error): failure = Some(error)
                    Ok(built):
                        arms = arms.append({
                            id = arm.id,
                            inputs = inputs.parameters,
                            body = built.body,
                        })
                        next_value = built.next_value
                        next_owner = built.next_owner
        if failure.is_some():
            break
    match failure:
        Some(error): Err(error)
        None:
            Ok({
                body = {
                    operations = completed.operations,
                    tail = MatchLoop({ selection = selected.selection, arms = arms }),
                },
                next_value = next_value,
                next_owner = next_owner,
            })


private pure func insert_loop_block(
    block: Lower.LoopBlock,
    seed_inputs: List[OwnedJoinParameter],
    held_headers: Int,
    enclosing: List[EnclosingBlock],
    scope: LoopScope,
    first_value: Int,
    initial_owner: Int,
    span: Span,
    contracts: CallContracts,
    unions: List[ConcreteUnion],
    records: List[ConcreteRecord],
) -> Result[InsertedLoopBlock, Diagnostic]:
    match block.tail:
        Lower.ExitLoop(exit):
            block.steps.insert_loop_exit_block(
                exit,
                seed_inputs,
                held_headers,
                enclosing,
                scope,
                first_value,
                initial_owner,
                span,
                contracts,
                unions,
                records,
            )
        Lower.MatchLoop(matched):
            block.steps.insert_loop_match_block(
                matched,
                seed_inputs,
                enclosing,
                scope,
                first_value,
                initial_owner,
                span,
                contracts,
                unions,
                records,
            )


private pure func insert_loop(
    loop: LoweredLoop,
    entering: List[EnteringHeader],
    enclosing: List[EnclosingBlock],
    first_value: Int,
    initial_owner: Int,
    contracts: CallContracts,
    unions: List[ConcreteUnion],
    records: List[ConcreteRecord],
) -> Result[InsertedLoop, Diagnostic]:
    var acquisitions: List[OwnerAcquisition] = []
    var initials: List[ReturnTransfer] = []
    var next_owner = initial_owner
    var failure: Option[Diagnostic] = None
    for decided in entering:
        match decided.entry:
            TakeOwner(owner): initials = initials.append(OwnedReturn(decided.header.initial, owner))
            AcquireAtEntry:
                match decided.header.initial.value_source(
                    [],
                    enclosing,
                    first_value,
                    decided.header.parameter.span,
                ):
                    Err(error): failure = Some(error)
                    Ok(source):
                        left = decided.header.initial.leave_with(
                            source.borrowed_result(),
                            [],
                            next_owner,
                            decided.header.parameter.span,
                        )
                        for entry in left.entries:
                            match entry:
                                Inserted(AcquireOwner(owner, borrow, _)):
                                    acquisitions = acquisitions.append({
                                        owner = owner,
                                        borrow = borrow,
                                    })
                                _:
                                    failure = Some(
                                        internal_error(
                                            decided.header.parameter.span,
                                            "loop entry contains a non-acquisition operation",
                                        ),
                                    )
                        initials = initials.append(left.transfer)
                        next_owner = left.next_owner
        if failure.is_some():
            break
    ready: Void ?= match failure:
        Some(error): Err(error)
        None: Ok(void)
    inputs ?= entering
        .map(pure func(decided): decided.header.parameter)
        .build_inputs(next_owner, unions, records)
    var headers: List[OwnedLoopHeader] = []
    var position = 0
    for parameter in inputs.parameters:
        match initials.get(position):
            None:
                failure = Some(
                    internal_error(
                        parameter.join_parameter().span,
                        "missing loop initial transfer",
                    ),
                )
            Some(initial): headers = headers.append({ parameter = parameter, initial = initial })
        position = position + 1
    headers_ready: Void ?= match failure:
        Some(error): Err(error)
        None: Ok(void)
    scope: LoopScope = {
        target = Lower.loop_target(loop.result.id),
        pre_blocks = enclosing.length(),
    }
    body ?= loop.body.insert_loop_block(
        inputs.parameters,
        entering.length(),
        enclosing,
        scope,
        first_value,
        inputs.next_owner,
        loop.result.span,
        contracts,
        unions,
        records,
    )
    Ok({
        acquisitions = acquisitions,
        headers = headers,
        body = body.body,
        next_value = body.next_value,
        next_owner = body.next_owner,
    })


-- One inserted function with its owner and value ordinal counts, which size
-- the reach walk's tables.
private record InsertedFunction { function: OwnedFunction, owner_count: Int, value_count: Int }


private pure func insert_contracted_function(
    function: LoweredFunction,
    contracts: CallContracts,
    unions: List[ConcreteUnion],
    records: List[ConcreteRecord],
) -> Result[InsertedFunction, Diagnostic]:
    span ?= function.steps.terminal_span(function.result, [])
    uses ?= function.steps.block_uses(TerminalValue(function.result), [], 0, 0, Ok(span))
    inserted ?= function.steps.insert_steps(
        DropAtLastUse(uses),
        [],
        0,
        0,
        [],
        None,
        [],
        [],
        contracts,
        unions,
        records,
    )
    source ?= function.result.value_source(inserted.sources, [], 0, span)
    leaving = function.result.leave_with(source, inserted.entries, inserted.next_owner, span)
    completed ?= leaving.entries.complete_joins(
        inserted.sources.length(),
        leaving.next_owner,
        contracts,
        unions,
        records,
    )
    Ok({
        function = {
            label = function.label,
            parameters = contracts.parameters,
            return_type = function.signature.return_type,
            operations = completed.operations,
            result = leaving.transfer,
        },
        owner_count = completed.next_owner,
        value_count = completed.next_value,
    })


-- Every parameter borrowed: the rows insertion starts from.
private pure func borrowed_rows(
    parameters: List[TypeRef],
    unions: List[ConcreteUnion],
    records: List[ConcreteRecord],
) -> Result[List[OwnedParameter], Diagnostic]:
    var rows: List[OwnedParameter] = []
    var failure: Option[Diagnostic] = None
    for value_type in parameters:
        match value_type.value_needs_ownership(unions, records):
            Ok(True):
                rows = rows.append(ManagedParameter({ value_type = value_type, owned = False }))
            Ok(False): rows = rows.append(UnmanagedParameter(value_type))
            Err(error):
                failure = Some(error)
                break
    match failure:
        Some(error): Err(error)
        None: Ok(rows)


-- Insertion of one function on its own, with every parameter and call
-- borrowed. A test entry point: production inserts through `own`.
pure func insert_function(
    function: LoweredFunction,
    unions: List[ConcreteUnion],
    records: List[ConcreteRecord],
) -> Result[OwnedFunction, Diagnostic]:
    rows ?= function.signature.parameters.borrowed_rows(unions, records)
    inserted ?= function.insert_contracted_function(
        { parameters = rows, callees = EveryCallBorrows },
        unions,
        records,
    )
    Ok(inserted.function)


-- The walk of one inserted function that finds which owned parameters reach
-- reuse. Blocks are walked in execution order along a path and alternatives
-- one after another, which can only add labels. `ReachInputs` moves each
-- transfer's obligation into its parameter's owner.
private union ReachWork:
    ReachOperations(List[OwnershipOperation], Int, Option[OwnedLoop])
    ReachTail(OwnedLoopTail, Option[OwnedLoop])
    ReachInputs(List[ReturnTransfer], List[OwnedJoinParameter])


-- Each arm after the selection edges that enter it, which bind its inputs.
private pure func arm_work(
    selection: OwnedSelection,
    arm: MatchArmId,
    inputs: List[OwnedJoinParameter],
    enclosing: Option[OwnedLoop],
) -> List[ReachWork]:
    var work: List[ReachWork] = []
    for node in selection.nodes:
        match node:
            EnterArm(edge):
                if edge.arm == arm:
                    work = work.append(ReachOperations(edge.operations, 0, enclosing))
                    work = work.append(ReachInputs(edge.transfers, inputs))
            _: void
    work


-- A row of an inference table, which is sized for every index it is read
-- at; a miss is a compiler defect.
private pure func row_at[T](rows: List[T], index: Int) -> Result[T, Diagnostic]:
    match rows.get(index):
        Some(row): Ok(row)
        None: Err(internal_error(compiler_span(), "ownership inference row is missing"))


-- Parameter p reaches reuse when its owner, or an owner carrying its
-- obligation, is consumed at a reusing runtime operand or an owned user
-- position. An owner carries p's obligation when a loop header, join input
-- or join or loop output takes it, when a construction stores a carrier
-- of it, or when it was acquired from a carrier that is then dropped before
-- the acquisition is consumed: the acquisition may then hold the only
-- reference. An acquisition consumed while its carrier is still live, or a
-- carrier that is only dropped or returned, reaches nothing.
private pure func reached_parameters(inserted: InsertedFunction) -> Result[List[Bool], Diagnostic]:
    unset: Option[Int] = None
    var carrier = repeat(unset, inserted.owner_count)
    var pending = repeat(unset, inserted.owner_count)
    -- An upper bound on the pending rows, so a drop can skip scanning them.
    var pending_count = 0
    var backing = repeat(unset, inserted.value_count)
    unreached: Bool = False
    var reached = repeat(unreached, inserted.function.parameters.length())
    var failure: Option[Diagnostic] = None
    start: ReachWork = ReachOperations(inserted.function.operations, 0, None)
    var work: List[ReachWork] = [start]
    var depth = 1
    while (depth > 0).and(failure.is_none()):
        depth = depth - 1
        -- A list literal allocates, so an item that pushes nothing leaves this None.
        var nested: Option[List[ReachWork]] = None
        match work.get(depth):
            None: failure = Some(internal_error(compiler_span(), "ownership reach work is missing"))
            Some(ReachInputs(transfers, parameters)):
                var position = 0
                for parameter in parameters:
                    match parameter:
                        ManagedJoinParameter(value, owner):
                            match transfers.get(position):
                                Some(OwnedReturn(_, source)):
                                    backing = backing.set(
                                        value.id.value_number(),
                                        Some(owner.owner_number()),
                                    )
                                    match carrier.row_at(source.owner_number()):
                                        Ok(Some(origin)):
                                            carrier = carrier.set(
                                                owner.owner_number(),
                                                Some(origin),
                                            )
                                        Ok(None): void
                                        Err(error): failure = Some(error)
                                    match pending.row_at(source.owner_number()):
                                        Ok(Some(acquired_from)):
                                            pending = pending.set(
                                                owner.owner_number(),
                                                Some(acquired_from),
                                            )
                                            pending_count = pending_count + 1
                                        Ok(None): void
                                        Err(error): failure = Some(error)
                                _: void
                        UnmanagedJoinParameter(_): void
                    position = position + 1
            Some(ReachTail(tail, enclosing)):
                match tail:
                    -- A break links the loop's result and carried outputs, as a yield does.
                    ExitLoop(Break(outputs)):
                        match enclosing:
                            Some(loop):
                                nested = Some([
                                    ReachInputs(
                                        [outputs.value].concat(outputs.carried),
                                        [loop.result].concat(loop.carried),
                                    ),
                                ])
                            None: void
                    ExitLoop(Recur(_, _)): void
                    MatchLoop(matched):
                        var arms: List[ReachWork] = []
                        for arm in matched.arms:
                            arms = arms.concat(
                                matched.selection.arm_work(arm.id, arm.inputs, enclosing),
                            )
                            arms = arms.append(ReachOperations(arm.body.operations, 0, enclosing))
                            arms = arms.append(ReachTail(arm.body.tail, enclosing))
                        nested = Some(arms)
            Some(ReachOperations(operations, first, enclosing)):
                var index = first
                while (
                    (index < operations.length())
                        .and(nested.is_none())
                        .and(failure.is_none())
                ):
                    operation_at = operations.get(index)
                    index = index + 1
                    match operation_at:
                        None:
                            failure = Some(
                                internal_error(
                                    compiler_span(),
                                    "ownership reach operation is missing",
                                ),
                            )
                        Some(DefineValue(definition)):
                            backed: Result[Option[Int], Diagnostic] = match definition.result:
                                OwnedResult(owner): Ok(Some(owner.owner_number()))
                                BorrowedResult(OwnerBorrow(owner)): Ok(Some(owner.owner_number()))
                                BorrowedResult(PayloadBorrow(parent)):
                                    backing.row_at(parent.value_number())
                                _: Ok(None)
                            match backed:
                                Err(error): failure = Some(error)
                                Ok(backer):
                                    backing = backing.set(definition.id.value_number(), backer)
                            match definition.operation:
                                ParameterDefinition(position):
                                    match definition.result:
                                        OwnedResult(owner):
                                            carrier = carrier.set(
                                                owner.owner_number(),
                                                Some(position),
                                            )
                                        _: void
                                CallDefinition(_, arguments):
                                    for argument in arguments:
                                        match argument:
                                            ConsumedArgument(_, owner):
                                                match carrier.row_at(owner.owner_number()):
                                                    Ok(Some(origin)):
                                                        reached = reached.set(origin, True)
                                                    Ok(None): void
                                                    Err(error): failure = Some(error)
                                            _: void
                                ConstructRecordDefinition(_, _) | ConstructDefinition(_, _) | ConstructListDefinition(_) | CapturedCallableDefinition(_, _):
                                    match carrier.stored_carried(definition.operation):
                                        Err(error): failure = Some(error)
                                        Ok(CarriesParameter(origin)):
                                            match definition.result:
                                                OwnedResult(owner):
                                                    carrier = carrier.set(
                                                        owner.owner_number(),
                                                        Some(origin),
                                                    )
                                                _: void
                                        Ok(CarriesNothing) | Ok(CarriesSeveral): void
                                _: void
                        Some(AcquireOwner(owner, borrow, _)):
                            backer: Result[Option[Int], Diagnostic] = match borrow.source:
                                OwnerBorrow(source): Ok(Some(source.owner_number()))
                                PayloadBorrow(parent): backing.row_at(parent.value_number())
                                ParameterBorrow(_): Ok(None)
                            match backer:
                                Err(error): failure = Some(error)
                                Ok(None): void
                                Ok(Some(source)):
                                    match carrier.row_at(source):
                                        Ok(Some(_)):
                                            pending = pending.set(
                                                owner.owner_number(),
                                                Some(source),
                                            )
                                            pending_count = pending_count + 1
                                        Ok(None): void
                                        Err(error): failure = Some(error)
                        -- Dropping a carrier leaves the acquisitions still pending
                        -- on it as possibly the only reference to its value.
                        Some(DropOwner(owner, _)):
                            match carrier.row_at(owner.owner_number()):
                                Err(error): failure = Some(error)
                                Ok(None): void
                                Ok(Some(origin)):
                                    if pending_count > 0:
                                        var acquired = 0
                                        for acquired_from in pending:
                                            match acquired_from:
                                                Some(source):
                                                    if source == owner.owner_number():
                                                        carrier = carrier.set(
                                                            acquired,
                                                            Some(origin),
                                                        )
                                                        pending = pending.set(acquired, None)
                                                        pending_count = pending_count - 1
                                                None: void
                                            acquired = acquired + 1
                        Some(ExecuteJoin(join)):
                            for output in [join.result].concat(join.carried):
                                match output:
                                    ManagedJoinParameter(value, owner):
                                        backing = backing.set(
                                            value.id.value_number(),
                                            Some(owner.owner_number()),
                                        )
                                    UnmanagedJoinParameter(_): void
                            var arms: List[ReachWork] = []
                            for arm in join.arms:
                                arms = arms.concat(
                                    join.selection.arm_work(arm.id, arm.inputs, enclosing),
                                )
                                arms = arms.append(ReachOperations(arm.operations, 0, enclosing))
                                match arm.exit:
                                    Yield(outputs):
                                        arms = arms.append(
                                            ReachInputs(
                                                [outputs.transfer].concat(outputs.carried),
                                                [join.result].concat(join.carried),
                                            ),
                                        )
                                    TransferLoop(_, tail):
                                        arms = arms.append(ReachTail(tail, enclosing))
                            nested = Some(
                                arms.append(ReachOperations(operations, index, enclosing)),
                            )
                        Some(ExecuteLoop(loop)):
                            for output in [loop.result].concat(loop.carried):
                                match output:
                                    ManagedJoinParameter(value, owner):
                                        backing = backing.set(
                                            value.id.value_number(),
                                            Some(owner.owner_number()),
                                        )
                                    UnmanagedJoinParameter(_): void
                            nested = Some([
                                -- Entry acquisitions precede the headers, as acquisitions do.
                                ReachOperations(
                                    loop.entry_acquisitions.map(
                                        pure func(entry: OwnerAcquisition) -> OwnershipOperation: AcquireOwner(
                                            entry.owner,
                                            entry.borrow,
                                            loop.result.join_parameter().span,
                                        ),
                                    ),
                                    0,
                                    enclosing,
                                ),
                                ReachInputs(
                                    loop.headers.map(pure func(header): header.initial),
                                    loop.headers.map(pure func(header): header.parameter),
                                ),
                                ReachOperations(loop.body.operations, 0, Some(loop)),
                                ReachTail(loop.body.tail, Some(loop)),
                                ReachOperations(operations, index, enclosing),
                            ])
        match nested:
            None: void
            -- The stack pops its last entry, so nested work goes on in reverse.
            Some(items):
                var remaining = items.length()
                while remaining > 0:
                    remaining = remaining - 1
                    match items.get(remaining):
                        Some(item):
                            work = work.push_at(depth, item)
                            depth = depth + 1
                        None:
                            failure = Some(
                                internal_error(compiler_span(), "ownership reach work is missing"),
                            )
    match failure:
        Some(error): Err(error)
        None: Ok(reached)


-- The one parameter obligation a construction's stored owners carry, if any;
-- an owner acquired for the store while its source lives carries none yet.
private pure func stored_carried(
    carrier: List[Option[Int]],
    operation: OwnedValueOperation,
) -> Result[Carried, Diagnostic]:
    var stored: Result[Carried, Diagnostic] = Ok(CarriesNothing)
    match operation:
        ConstructRecordDefinition(_, fields):
            for field in fields:
                stored = carrier.carried_with(stored, field.value)
        ConstructDefinition(_, payloads) | ConstructListDefinition(payloads):
            for payload in payloads:
                stored = carrier.carried_with(stored, payload)
        CapturedCallableDefinition(_, payload): stored = carrier.carried_with(stored, payload)
        _: void
    stored


-- `stored` joined with what one stored payload's owner carries now.
private pure func carried_with(
    carrier: List[Option[Int]],
    stored: Result[Carried, Diagnostic],
    payload: StoredPayload,
) -> Result[Carried, Diagnostic]:
    known ?= stored
    match payload:
        UnmanagedPayload(_): Ok(known)
        OwnedPayload(_, owner):
            match carrier.row_at(owner.owner_number()):
                Ok(Some(origin)): Ok(known.carried_union(CarriesParameter(origin)))
                Ok(None): Ok(known)
                Err(error): Err(error)


-- Which parameters a value may carry an obligation of. It over-approximates
-- the owners the reach walk lets carry one: the parameter, its projections
-- and constructions of it; a loop header, what its initial carries; a join
-- or loop output, everything the join or loop reads; and an arm input, what
-- its scrutinee carries. Calls and literals carry nothing.
private union Carried:
    CarriesNothing
    CarriesParameter(Int)
    -- More than one parameter, which the inference counts as every parameter.
    CarriesSeveral


private pure func carried_union(left: Carried, right: Carried) -> Carried:
    match (left, right):
        (CarriesNothing, _): right
        (_, CarriesNothing): left
        (CarriesParameter(first), CarriesParameter(second)):
            if first == second:
                left
            else:
                CarriesSeveral
        _: CarriesSeveral


private pure func mark_carried(rows: List[Bool], carried: Carried) -> List[Bool]:
    match carried:
        CarriesNothing: rows
        CarriesParameter(index): rows.set(index, True)
        CarriesSeveral: rows.map(pure func(_: Bool) -> Bool: True)


-- A user call from one instance to another, with what each argument carries.
private record CallEdge { caller: Int, callee: Int, arguments: List[Carried] }


-- One function's calls as the inference reads them: the parameters that may
-- reach a reusing runtime operand, its user calls, and the instances it takes
-- as callables, which keep the borrowed callable ABI.
private record CallFacts { reusing: List[Bool], calls: List[CallEdge], taken: List[Int] }


-- What the scan writes for one value a join or loop introduces.
private record CarriedValue { value: ValueId, carried: Carried }


-- A block the scan visits, then its loop tail, if it ends in one.
private record ScannedBlock { steps: List[LoweredStep], tail: Option[Lower.LoopTail] }


private pure func carried_by(
    table: List[Carried],
    values: List[ValueId],
) -> Result[Carried, Diagnostic]:
    var carried: Carried = CarriesNothing
    var failure: Option[Diagnostic] = None
    for value in values:
        match table.row_at(value.value_number()):
            Ok(found): carried = carried.carried_union(found)
            Err(error): failure = Some(error)
    match failure:
        Some(error): Err(error)
        None: Ok(carried)


-- Blocks are visited breadth first, each after the block that encloses it,
-- so every value a step reads is already written. Values are numbered depth
-- first, so the table grows past values that are written later; until then
-- those rows hold the lattice's bottom.
private pure func call_facts(
    function: LoweredFunction,
    caller: Int,
) -> Result[CallFacts, Diagnostic]:
    unreached: Bool = False
    var reusing = repeat(unreached, function.signature.parameters.length())
    var calls: List[CallEdge] = []
    var taken: List[Int] = []
    var table: List[Carried] = []
    var failure: Option[Diagnostic] = None
    start: ScannedBlock = { steps = function.steps, tail = None }
    var blocks: List[ScannedBlock] = [start]
    var next = 0
    while (next < blocks.length()).and(failure.is_none()):
        var block: Option[ScannedBlock] = blocks.get(next)
        next = next + 1
        match block:
            None: failure = Some(internal_error(compiler_span(), "ownership scan block is missing"))
            Some(scanned):
                for step in scanned.steps:
                    match step:
                        Define(definition):
                            produced: Result[Carried, Diagnostic] = match definition.operation:
                                ParameterValue(position): Ok(CarriesParameter(position))
                                ReadRecordFieldValue(_, parent) | PayloadValue(_, parent) | ListElementValue(_, parent):
                                    table.row_at(parent.value_number())
                                CallValue(RuntimeFunction(operation), arguments):
                                    if operation.reuses_first_operand():
                                        match arguments.get(0):
                                            Some(operand):
                                                match table.row_at(operand.value_number()):
                                                    Ok(carried):
                                                        reusing = reusing.mark_carried(carried)
                                                        Ok(CarriesNothing)
                                                    Err(error): Err(error)
                                            None: Ok(CarriesNothing)
                                    else:
                                        Ok(CarriesNothing)
                                CallValue(UserFunction(callee), arguments):
                                    var carried: List[Carried] = []
                                    var missing: Option[Diagnostic] = None
                                    for argument in arguments:
                                        match table.row_at(argument.value_number()):
                                            Ok(found): carried = carried.append(found)
                                            Err(error): missing = Some(error)
                                    calls = calls.append({
                                        caller = caller,
                                        callee = callee.function_number(),
                                        arguments = carried,
                                    })
                                    match missing:
                                        Some(error): Err(error)
                                        None: Ok(CarriesNothing)
                                ConstructRecordValue(_, fields):
                                    table.carried_by(
                                        fields.map(pure func(field) -> ValueId: field.value),
                                    )
                                ConstructValue(_, values) | ConstructListValue(values):
                                    table.carried_by(values)
                                FreeCallableValue(body):
                                    taken = taken.append(body.function_number())
                                    Ok(CarriesNothing)
                                CapturedCallableValue(body, environment):
                                    taken = taken.append(body.function_number())
                                    table.row_at(environment.value_number())
                                _: Ok(CarriesNothing)
                            match produced:
                                Ok(carried):
                                    while table.length() <= definition.id.value_number():
                                        table = table.append(CarriesNothing)
                                    table = table.set(definition.id.value_number(), carried)
                                Err(error): failure = Some(error)
                        Join(join):
                            match (
                                table.carried_by(join.reads),
                                table.row_at(join.selection.scrutinee.value_number()),
                            ):
                                (Ok(read), Ok(matched)):
                                    var introduced: List[CarriedValue] = [join.result]
                                        .concat(join.carried)
                                        .map(
                                            pure func(output: ValueParameter) -> CarriedValue: {
                                                value = output.id,
                                                carried = read,
                                            },
                                        )
                                    for arm in join.arms:
                                        introduced = introduced.concat(
                                            arm.inputs.map(
                                                pure func(input: ValueParameter) -> CarriedValue: {
                                                    value = input.id,
                                                    carried = matched,
                                                },
                                            ),
                                        )
                                        exit_tail: Option[Lower.LoopTail] = match arm.exit:
                                            Lower.Yield(_): None
                                            Lower.TransferLoop(_, tail): Some(tail)
                                        blocks = blocks.append({
                                            steps = arm.steps,
                                            tail = exit_tail,
                                        })
                                    for written in introduced:
                                        while table.length() <= written.value.value_number():
                                            table = table.append(CarriesNothing)
                                        table = table.set(
                                            written.value.value_number(),
                                            written.carried,
                                        )
                                (Err(error), _): failure = Some(error)
                                (_, Err(error)): failure = Some(error)
                        Loop(loop):
                            match table.carried_by(
                                loop.headers
                                    .map(
                                        pure func(header: Lower.LoopHeader) -> ValueId: header.initial,
                                    )
                                    .concat(loop.body_reads),
                            ):
                                Err(error): failure = Some(error)
                                Ok(read):
                                    var introduced: List[CarriedValue] = [loop.result]
                                        .concat(loop.carried)
                                        .map(
                                            pure func(output: ValueParameter) -> CarriedValue: {
                                                value = output.id,
                                                carried = read,
                                            },
                                        )
                                    for header in loop.headers:
                                        match table.row_at(header.initial.value_number()):
                                            Ok(carried):
                                                introduced = introduced.append({
                                                    value = header.parameter.id,
                                                    carried = carried,
                                                })
                                            Err(error): failure = Some(error)
                                    for written in introduced:
                                        while table.length() <= written.value.value_number():
                                            table = table.append(CarriesNothing)
                                        table = table.set(
                                            written.value.value_number(),
                                            written.carried,
                                        )
                                    blocks = blocks.append({
                                        steps = loop.body.steps,
                                        tail = Some(loop.body.tail),
                                    })
                match scanned.tail:
                    Some(Lower.MatchLoop(matched)):
                        match table.row_at(matched.selection.scrutinee.value_number()):
                            Err(error): failure = Some(error)
                            Ok(carried):
                                for arm in matched.arms:
                                    for input in arm.inputs:
                                        while table.length() <= input.id.value_number():
                                            table = table.append(CarriesNothing)
                                        table = table.set(input.id.value_number(), carried)
                                    blocks = blocks.append({
                                        steps = arm.body.steps,
                                        tail = Some(arm.body.tail),
                                    })
                    _: void
    match failure:
        Some(error): Err(error)
        None: Ok({ reusing = reusing, calls = calls, taken = taken })


-- Labels only add owned positions, so two rows of one function compare by
-- how many positions they own.
private pure func owned_count(rows: List[OwnedParameter]) -> Int:
    var count = 0
    for row in rows:
        if row.parameter_owned():
            count = count + 1
    count


-- Marks the parameters a call's arguments carry into the positions `owned`
-- flags, which are the callee's, so they match the arguments.
private pure func mark_owned_positions(
    rows: List[Bool],
    arguments: List[Carried],
    owned: List[Bool],
) -> Result[List[Bool], Diagnostic]:
    var marked = rows
    var failure: Option[Diagnostic] = None
    var position = 0
    for argument in arguments:
        match owned.row_at(position):
            Ok(True): marked = marked.mark_carried(argument)
            Ok(False): void
            Err(error): failure = Some(error)
        position = position + 1
    match failure:
        Some(error): Err(error)
        None: Ok(marked)


-- `rows` with the managed parameters `owning` flags owned.
private pure func owning_rows(
    rows: List[OwnedParameter],
    owning: List[Bool],
) -> Result[List[OwnedParameter], Diagnostic]:
    var owned = rows
    var failure: Option[Diagnostic] = None
    var position = 0
    for row in rows:
        match (row, owning.row_at(position)):
            (ManagedParameter(passing), Ok(True)):
                owned = owned.set(position, ManagedParameter({ passing | owned = True }))
            (_, Err(error)): failure = Some(error)
            _: void
        position = position + 1
    match failure:
        Some(error): Err(error)
        None: Ok(owned)


-- One analysis: the insertion with provisional rows, and the labels the
-- reach walk's consumed parameters give.
private record Analysis {
    inserted: InsertedFunction,
    -- The current labels plus the parameters found consumed.
    merged: List[OwnedParameter],
}


private pure func analyse(
    function: LoweredFunction,
    tried: List[OwnedParameter],
    current: List[OwnedParameter],
    labels: List[List[OwnedParameter]],
    unions: List[ConcreteUnion],
    records: List[ConcreteRecord],
) -> Result[Analysis, Diagnostic]:
    inserted ?= function.insert_contracted_function(
        { parameters = tried, callees = InstanceRows(labels) },
        unions,
        records,
    )
    reached ?= inserted.reached_parameters()
    merged ?= current.owning_rows(reached)
    Ok({ inserted = inserted, merged = merged })


-- One function instance as the inference reads it: its body, its call facts,
-- and whether it is pinned borrowed. Instances taken as callables keep the
-- borrowed callable ABI, and the entry wrapper passes its arguments borrowed.
private record Instance { function: LoweredFunction, facts: CallFacts, pinned: Bool }


-- The labels of every instance, solved. Each instance is analysed with its
-- labels plus every managed parameter of an unpinned instance that the scan
-- says may reach an in-place operand provisionally owned, and keeps those
-- whose owners the reach walk finds consumed. Labels only flip from borrowed
-- to owned, so each parameter flips at most once. A flip re-analyses only the
-- callers that pass a parameter into the flipped position, and every caller
-- drops its kept insertion, whose calls to the flipped instance changed.
private record SolvedLabels {
    labels: List[List[OwnedParameter]],
    -- An analysis insertion whose rows equal the final labels, by instance.
    kept: List[Option[InsertedFunction]],
}


-- Whether `call` passes one of its caller's parameters into an `owned` position.
private pure func passes_a_parameter(
    call: CallEdge,
    instances: List[Instance],
    owned: List[Bool],
) -> Result[Bool, Diagnostic]:
    caller ?= instances.row_at(call.caller)
    reaches_nothing: Bool = False
    no_parameters = repeat(reaches_nothing, caller.facts.reusing.length())
    fed ?= no_parameters.mark_owned_positions(call.arguments, owned)
    Ok(fed.any(pure func(row): row))


private pure func solve_labels(
    instances: List[Instance],
    borrowed: List[List[OwnedParameter]],
    unions: List[ConcreteUnion],
    records: List[ConcreteRecord],
) -> Result[SolvedLabels, Diagnostic]:
    count = instances.length()
    var labels = borrowed
    no_insertion: Option[InsertedFunction] = None
    var kept = repeat(no_insertion, count)
    unqueued: Bool = False
    var queued = repeat(unqueued, count)
    -- Each instance's incoming calls.
    no_callers: List[CallEdge] = []
    var callers = repeat(no_callers, count)
    var failure: Option[Diagnostic] = None
    var index = 0
    for instance in instances:
        for call in instance.facts.calls:
            match callers.get(call.callee):
                Some(found): callers = callers.set(call.callee, found.append(call))
                None: failure = Some(internal_error(compiler_span(), "call to an unknown instance"))
        if (
            instance.pinned
                .not()
                .and(instance.facts.reusing.any(pure func(row): row))
        ):
            queued = queued.set(index, True)
        index = index + 1

    -- Instances are numbered as specialization reaches them from the entry,
    -- so a callee usually follows its callers. Visiting the highest queued
    -- number first settles callees before their callers more often; the order
    -- changes only the work, never the fixpoint.
    var cursor = count - 1
    while (cursor >= 0).and(failure.is_none()):
        analysed = cursor
        match (
            queued.get(analysed),
            instances.get(analysed),
            labels.get(analysed),
            callers.get(analysed),
        ):
            (Some(False), _, _, _): cursor = analysed - 1
            (Some(True), Some(instance), Some(current), Some(incoming)):
                queued = queued.set(analysed, False)
                -- Try the borrowed parameters that may reach reuse, directly or
                -- through an owned callee position.
                var reaching = instance.facts.reusing
                for call in instance.facts.calls:
                    match labels.row_at(call.callee):
                        Err(error): failure = Some(error)
                        Ok(callee):
                            match reaching.mark_owned_positions(
                                call.arguments,
                                callee.map(parameter_owned),
                            ):
                                Ok(marked): reaching = marked
                                Err(error): failure = Some(error)
                match current.owning_rows(reaching):
                    Err(error): failure = Some(error)
                    Ok(tried):
                        -- A pinned caller re-queued by a flip tries nothing.
                        if (
                            failure
                                .is_none()
                                .and(instance.pinned.not())
                                .and(tried.owned_count() > current.owned_count())
                        ):
                            match instance.function.analyse(
                                tried,
                                current,
                                labels,
                                unions,
                                records,
                            ):
                                Err(error): failure = Some(error)
                                Ok(analysis):
                                    merged = analysis.merged
                                    -- Keep the insertion only when its rows are final.
                                    if merged.owned_count() == tried.owned_count():
                                        kept = kept.set(analysed, Some(analysis.inserted))
                                    else:
                                        kept = kept.set(analysed, no_insertion)
                                    if merged.owned_count() > current.owned_count():
                                        labels = labels.set(analysed, merged)
                                        -- Once `analysed` flips to owned, its callers' calls to it pass obligations,
                                        -- so no caller's kept insertion stays final. A caller passing a parameter
                                        -- into a newly owned position may flip too: it is queued again, and the
                                        -- cursor rises to reach it.
                                        owned = merged.map(parameter_owned)
                                        for call in incoming:
                                            kept = kept.set(call.caller, None)
                                            match call.passes_a_parameter(instances, owned):
                                                Err(error): failure = Some(error)
                                                Ok(False): void
                                                Ok(True):
                                                    queued = queued.set(call.caller, True)
                                                    cursor = call.caller.max(cursor)
            _: failure = Some(internal_error(compiler_span(), "analysed instance is missing a row"))
    match failure:
        Some(error): Err(error)
        None: Ok({ labels = labels, kept = kept })


-- Which parameters own. Production infers them from insertion's own
-- transfers; tests use the other two to show labels never change behaviour.
union Labelling:
    InferredLabels
    AllBorrowed
    AllOwnedExceptPinned


-- Every instance inserted with its solved labels, in instance order.
private pure func inserted_instances(
    contents: LoweredFunctions,
    labelling: Labelling,
) -> Result[List[InsertedFunction], Diagnostic]:
    count = contents.functions.length()
    unpinned: Bool = False
    var pinned = repeat(unpinned, count).set(
        contents.entrypoint
            .entry_function()
            .function_number(),
        True,
    )
    var scanned: List[CallFacts] = []
    var borrowed: List[List[OwnedParameter]] = []
    var failure: Option[Diagnostic] = None
    for function in contents.functions:
        match (
            function.call_facts(scanned.length()),
            function.signature.parameters.borrowed_rows(contents.unions, contents.records),
        ):
            (Ok(found), Ok(rows)):
                for body in found.taken:
                    pinned = pinned.set(body, True)
                scanned = scanned.append(found)
                borrowed = borrowed.append(rows)
            (Err(error), _) | (_, Err(error)):
                failure = Some(error)
                break
    var instances: List[Instance] = []
    var index = 0
    for function in contents.functions:
        match (scanned.row_at(index), pinned.row_at(index)):
            (Ok(found), Ok(is_pinned)):
                instances = instances.append({
                    function = function,
                    facts = found,
                    pinned = is_pinned,
                })
            (Err(error), _) | (_, Err(error)): failure = Some(error)
        index = index + 1
    gathered: Void ?= match failure:
        Some(error): Err(error)
        None: Ok(void)

    no_insertion: Option[InsertedFunction] = None
    solved: SolvedLabels ?= match labelling:
        InferredLabels: instances.solve_labels(borrowed, contents.unions, contents.records)
        AllBorrowed: Ok({ labels = borrowed, kept = repeat(no_insertion, count) })
        AllOwnedExceptPinned:
            var owned: List[List[OwnedParameter]] = []
            for instance in instances:
                pin = instance.pinned
                match borrowed.row_at(owned.length()):
                    Err(error): failure = Some(error)
                    Ok(rows):
                        keep = rows.map(pure func(_: OwnedParameter) -> Bool: pin.not())
                        match rows.owning_rows(keep):
                            Ok(all_owned): owned = owned.append(all_owned)
                            Err(error): failure = Some(error)
            Ok({ labels = owned, kept = repeat(no_insertion, count) })

    var functions: List[InsertedFunction] = []
    index = 0
    for instance in instances:
        match (solved.kept.row_at(index), solved.labels.row_at(index)):
            (Ok(Some(kept)), _): functions = functions.append(kept)
            (Ok(None), Ok(rows)):
                match instance.function.insert_contracted_function(
                    { parameters = rows, callees = InstanceRows(solved.labels) },
                    contents.unions,
                    contents.records,
                ):
                    Ok(inserted): functions = functions.append(inserted)
                    Err(error): failure = Some(error)
            (Err(error), _) | (_, Err(error)): failure = Some(error)
        if failure.is_some():
            break
        index = index + 1
    match failure:
        Some(error): Err(error)
        None: Ok(functions)


pure func insert_ownership(
    program: LoweredProgram,
    labelling: Labelling,
) -> Result[OwnershipProgram, Diagnostic]:
    contents = program.lowered_functions()
    inserted ?= contents.inserted_instances(labelling)
    Ok({
        records = contents.records,
        unions = contents.unions,
        functions = inserted.map(pure func(function): function.function),
        entrypoint = contents.entrypoint,
    })


-- For tests: how many owned labels of the inferred program its final
-- insertion never consumes. Each would cost every caller an acquisition.
pure func unconsumed_owned_labels(program: LoweredProgram) -> Result[Int, Diagnostic]:
    inserted ?= program
        .lowered_functions()
        .inserted_instances(InferredLabels)
    var unconsumed = 0
    var failure: Option[Diagnostic] = None
    for function in inserted:
        match function.reached_parameters():
            Err(error): failure = Some(error)
            -- Only owned parameters have carriers, so reached ones are owned.
            Ok(reached):
                unconsumed = (
                    unconsumed
                    + function.function.parameters.owned_count()
                    - reached
                        .filter(pure func(row): row)
                        .length()
                )
    match failure:
        Some(error): Err(error)
        None: Ok(unconsumed)


pure func own(program: LoweredProgram) -> Result[OwnershipProgram, Diagnostic]:
    program.insert_ownership(InferredLabels)
