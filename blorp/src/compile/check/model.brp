---
The checked program model that checking publishes and specialization reads:
resolved types, signatures, bindings, values and function bodies.
---
import:
    bool: Bool methods
    dict: combine_hash
    int: Int methods
    ../../syntax/names: NameId
    ../../syntax/source: FunctionLabel, ModuleId
    ../../syntax/syntax:
        Entrypoint,
        FunctionExecution,
        LiteralPattern,
        Purity(Pure, Impure),
        Span,
        WrittenName,
    ../ids: TraitId, TraitMethodId, ConstantId, FunctionId, OpaqueId, RecordId, UnionId, VariantId
    ../namespace/builtins:
        IntegerFormat(Int64Format),
        integer_primitive,
        PrimitiveType(BuiltinInt, BuiltinFloat, BuiltinString, BuiltinVoid),
        RuntimeOperation,
        DesignatedBoolean,
        DesignatedOption,
    ../namespace/namespace: TypeHead(ListHead, PrimitiveHead, RecordHead, UnionHead, OpaqueHead)


-- Check admission owns these complete per-module lookups until body checking
-- ends. Signatures remain the contract authority; CheckedProgram keeps no scopes.
record ReceiverFunction {
    id: FunctionId,
    import_site: Option[Span],
}


-- Stored function rows are nonempty; an absent map entry is a semantic miss.
union ReceiverLookup:
    VisibleMethod(TraitMethodId)
    VisibleFunctions(List[ReceiverFunction])


record AdmittedReceiverScope {
    names: Dict[NameId, ReceiverLookup],
}


private fixed record FieldIdentity {
    owner: RecordId,
    position: Int,
}


opaque type FieldId = FieldIdentity


-- A declared record field: its identity, written name and type annotation.
record CheckedField {
    id: FieldId,
    name: WrittenName,
    value_type: TypeUse,
}


-- `fixed` is a declared promise checking has verified: every instance is
-- stored inline with no counted child.
record CheckedRecord {
    id: RecordId,
    type_parameters: List[TypeParameterId],
    -- The written bounds on the type parameters; every application proves them.
    requirements: List[TraitRequirement],
    fields: List[CheckedField],
    fixed: Bool,
}


union TypeParameterOwner:
    TraitDeclaration(TraitId)
    FunctionDeclaration(FunctionId)
    UnionDeclaration(UnionId)
    RecordDeclaration(RecordId)
    OpaqueDeclaration(OpaqueId)


-- Owner and declaration position identify a rigid parameter within this compilation.
private record TypeParameterIdentity {
    owner: TypeParameterOwner,
    position: Int,
}


opaque type TypeParameterId = TypeParameterIdentity


implements Equatable for TypeParameterId:
    pure func equals(left: Self, right: Self) -> Bool:
        from_opaque TypeParameterId(left) == from_opaque TypeParameterId(right)


union TypeRef:
    VoidType
    IntegerType(IntegerFormat)
    FloatType
    StringType
    ListType(TypeRef)
    TupleType(List[TypeRef])
    -- A record, union or opaque type applied to its type arguments, which
    -- match the declaration's arity; a nongeneric declaration has none.
    NominalType(NominalId, List[TypeRef])
    ParameterType(TypeParameterId)
    CallableType(Purity, List[TypeRef], TypeRef)


-- The types a type is built from, in visiting order: a callable's parameters
-- then its result, a tuple's elements, a List's element and a nominal type's
-- arguments. A leaf has none.
pure func type_children(value_type: TypeRef) -> List[TypeRef]:
    match value_type:
        ListType(element): [element]
        TupleType(elements): elements
        CallableType(_, parameters, result): parameters.append(result)
        NominalType(_, arguments): arguments
        -- No integer format has type children.
        VoidType | IntegerType(_) | FloatType | StringType | ParameterType(_): []


-- Whether a rigid type parameter occurs anywhere in the type.
pure func contains_parameter(value_type: TypeRef) -> Bool:
    match value_type:
        ParameterType(_):
            True
        _:
            value_type
                .type_children()
                .any(contains_parameter)


-- A declared variant: its identity, written name and ordered field annotations.
record CheckedVariant {
    id: VariantId,
    name: WrittenName,
    fields: List[TypeUse],
}


-- `fixed` is a declared promise checking has verified: every instance is
-- stored inline with no counted child.
record CheckedUnion {
    id: UnionId,
    type_parameters: List[TypeParameterId],
    -- The written bounds on the type parameters; every application proves them.
    requirements: List[TraitRequirement],
    variants: List[CheckedVariant],
    fixed: Bool,
}


record CheckedOpaque {
    id: OpaqueId,
    type_parameters: List[TypeParameterId],
    -- The written bounds on the type parameters; every application proves them.
    requirements: List[TraitRequirement],
    underlying_type: TypeUse,
}


record TypeUse {
    value_type: TypeRef,
    span: Span,
}


-- A declared bound belongs to one genuine parameter domain. Receiver goals
-- are substituted transiently at a call/reference, never retained in a registry.
record TraitRequirement {
    parameter: TypeParameterId,
    required_trait: TraitId,
    span: Span,
}


record FunctionSignature {
    type_parameters: List[TypeParameterId],
    requirements: List[TraitRequirement],
    purity: Purity,
    parameters: List[TypeUse],
    return_type: TypeUse,
}


record AcceptedTraitMethod {
    id: TraitMethodId,
    signature: FunctionSignature,
    default_body: Option[FunctionId],
}


-- Supertraits are the direct ones only; `entails` walks them for the closure.
record AcceptedTrait {
    id: TraitId,
    supertraits: List[LocatedTrait],
    methods: List[AcceptedTraitMethod],
}


-- Full receiver families own head/argument positions, not a fabricated
-- generic owner. These located bounds are resolved once at the header.
fixed record LocatedTrait {
    required_trait: TraitId,
    span: Span,
}


record ImplementationHeader {
    receiver_head: TypeHead,
    parameter_bounds: List[List[LocatedTrait]],
}


-- Authored methods normalize each header argument into their own function
-- domain. A default normalizes only whole Self into its actual function domain.
union ImplementedBody:
    AuthoredMethod(FunctionId)
    TraitDefault(FunctionId)
    StructuralEquality(AggregateId, CheckedEqualityBody)


union EqualityMember:
    EqualityField(FieldId)
    EqualityPayload(VariantId, Int)


-- A record or union declaration: the head of a nominal type, and the owner of
-- a derived structural equality.
union AggregateId:
    RecordAggregate(RecordId)
    UnionAggregate(UnionId)


-- The declaration a nominal type names. Only an aggregate has fields or
-- variants; an opaque type is distinct during checking and erased in
-- specialization.
union NominalId:
    AggregateNominal(AggregateId)
    OpaqueNominal(OpaqueId)


-- One ordinary template, owned by its canonical equals member.
record CheckedEqualityBody {
    label: FunctionLabel,
    signature: FunctionSignature,
    bindings: List[BindingDefinition],
    body: CheckedBody,
}


record ImplementedMethod {
    method: TraitMethodId,
    body: ImplementedBody,
}


record AcceptedImplementation {
    span: Span,
    trait_id: TraitId,
    receiver_head: TypeHead,
    parameter_bounds: List[List[LocatedTrait]],
    methods: List[ImplementedMethod],
    -- Written name-publication authority; None supplies automatic capability
    -- without publishing names, rather than denoting unknown body ownership.
    method_provider: Option[ModuleId],
}


-- One trait implemented for one receiver head: at most one accepted row.
record ImplementationKey {
    trait_id: TraitId,
    head: TypeHead,
}


implements Hashable for ImplementationKey:
    pure func hash(value: Self) -> Int:
        combine_hash(combine_hash(0, value.trait_id.trait_number()), value.head.hash())


-- Accepted implementations in acceptance order, with an index by trait and
-- receiver head derived from them in the same step. Only `implementation_table`
-- builds one, so the index cannot disagree with the rows.
private record ImplementationRows {
    ordered: List[AcceptedImplementation],
    by_key: Dict[ImplementationKey, AcceptedImplementation],
}


opaque type ImplementationTable = ImplementationRows


-- `rows` indexed, or None if two rows implement one trait for one head or a
-- row holds another trait's member. A method's body is then found in the one
-- family of its own trait for the receiver head.
pure func implementation_table(rows: List[AcceptedImplementation]) -> Option[ImplementationTable]:
    var by_key: Dict[ImplementationKey, AcceptedImplementation] = {}
    var valid: Bool = True
    for row in rows:
        key: ImplementationKey = { trait_id = row.trait_id, head = row.receiver_head }
        other_trait_member = row.methods.any(
            pure func(member): member.method.trait_method_owner() != row.trait_id,
        )
        if (
            by_key
                .contains(key)
                .not()
                .and(other_trait_member.not())
        ):
            by_key = by_key.set(key, row)
        else:
            valid = False
            break
    if valid:
        Some(into_opaque ImplementationTable({ ordered = rows, by_key = by_key }))
    else:
        None


-- The rows in acceptance order.
pure func implementation_rows(table: ImplementationTable) -> List[AcceptedImplementation]:
    from_opaque ImplementationTable(table).ordered


-- The one accepted implementation of `required` for `head`.
pure func family_for(
    traits: AcceptedTraits,
    required: TraitId,
    head: TypeHead,
) -> Option[AcceptedImplementation]:
    key: ImplementationKey = { trait_id = required, head = head }
    from_opaque ImplementationTable(traits.implementations).by_key.get(key)


private record CanonicalEqualityContents {
    equals: TraitMethodId,
    not_equals: Option[TraitMethodId],
}


opaque type CanonicalEquality = CanonicalEqualityContents


-- Admission supplies validated members of one canonical trait. Consumers keep
-- identities only; the equals member owns the descriptor's trait identity.
pure func canonical_equality(
    equals_method: TraitMethodId,
    not_equals_method: Option[TraitMethodId],
) -> CanonicalEquality:
    into_opaque CanonicalEquality({ equals = equals_method, not_equals = not_equals_method })


pure func canonical_equals(contract: CanonicalEquality) -> TraitMethodId:
    from_opaque CanonicalEquality(contract).equals


pure func canonical_not_equals(contract: CanonicalEquality) -> Option[TraitMethodId]:
    from_opaque CanonicalEquality(contract).not_equals


pure func canonical_owner(contract: CanonicalEquality) -> TraitId:
    contract
        .canonical_equals()
        .trait_method_owner()


-- Ordering requires all four members, so each operator has its own identity.
private fixed record CanonicalOrderingContents {
    less_than: TraitMethodId,
    greater_than: TraitMethodId,
    less_than_or_equal: TraitMethodId,
    greater_than_or_equal: TraitMethodId,
}


opaque type CanonicalOrdering = CanonicalOrderingContents


pure func canonical_ordering(
    less_than: TraitMethodId,
    greater_than: TraitMethodId,
    less_than_or_equal: TraitMethodId,
    greater_than_or_equal: TraitMethodId,
) -> CanonicalOrdering:
    into_opaque CanonicalOrdering({
        less_than = less_than,
        greater_than = greater_than,
        less_than_or_equal = less_than_or_equal,
        greater_than_or_equal = greater_than_or_equal,
    })


pure func canonical_less_than(contract: CanonicalOrdering) -> TraitMethodId:
    from_opaque CanonicalOrdering(contract).less_than


pure func canonical_greater_than(contract: CanonicalOrdering) -> TraitMethodId:
    from_opaque CanonicalOrdering(contract).greater_than


pure func canonical_less_than_or_equal(contract: CanonicalOrdering) -> TraitMethodId:
    from_opaque CanonicalOrdering(contract).less_than_or_equal


pure func canonical_greater_than_or_equal(contract: CanonicalOrdering) -> TraitMethodId:
    from_opaque CanonicalOrdering(contract).greater_than_or_equal


-- A trait's one abstract member, which its operator or an interpolation hole calls.
opaque type CanonicalOperation = TraitMethodId


pure func canonical_operation(member: TraitMethodId) -> CanonicalOperation:
    into_opaque CanonicalOperation(member)


pure func canonical_operation_member(contract: CanonicalOperation) -> TraitMethodId:
    from_opaque CanonicalOperation(contract)


-- The functions a Dict literal calls, found once at admission among the
-- functions declared by the module that declares the prelude's Dict.
record DictLiteralFunctions {
    empty: FunctionId,
    dict: FunctionId,
    set: FunctionId,
}


-- Every prelude-selected operator, hole and literal contract, each admitted once.
-- Each arithmetic operator has its own trait, so `a - b` is never `a + -b`.
record CanonicalContracts {
    equality: Option[CanonicalEquality],
    ordering: Option[CanonicalOrdering],
    addition: Option[CanonicalOperation],
    subtraction: Option[CanonicalOperation],
    multiplication: Option[CanonicalOperation],
    division: Option[CanonicalOperation],
    remainder: Option[CanonicalOperation],
    negation: Option[CanonicalOperation],
    stringable: Option[CanonicalOperation],
    dict_literal: Option[DictLiteralFunctions],
}


record AcceptedTraitContracts {
    declarations: List[AcceptedTrait],
    canonical: CanonicalContracts,
}


record AcceptedTraits {
    declarations: List[AcceptedTrait],
    implementations: ImplementationTable,
    canonical: CanonicalContracts,
}


private record MethodCallContents {
    method: TraitMethodId,
    receiver: TypeRef,
}


opaque type AcceptedMethodCall = MethodCallContents


pure func accepted_method(method: TraitMethodId, receiver: TypeRef) -> AcceptedMethodCall:
    into_opaque AcceptedMethodCall({ method = method, receiver = receiver })


pure func method_identity(call: AcceptedMethodCall) -> TraitMethodId:
    from_opaque AcceptedMethodCall(call).method


pure func method_receiver(call: AcceptedMethodCall) -> TypeRef:
    from_opaque AcceptedMethodCall(call).receiver


-- A transient projection into the ordinary function-request graph, not a
-- second dispatch table or a retained per-call proof.
record SelectedMethodBody {
    body: BodyOwner,
    arguments: List[TypeRef],
}


pure func receiver_arguments(receiver: TypeRef) -> List[TypeRef]:
    match receiver:
        NominalType(_, arguments): arguments
        ListType(element): [element]
        _: []


pure func method_body(
    traits: AcceptedTraits,
    call: AcceptedMethodCall,
) -> Option[SelectedMethodBody]:
    var found: Option[SelectedMethodBody] = None
    receiver = call.method_receiver()
    method = call.method_identity()
    family: Option[AcceptedImplementation] = match receiver.type_head():
        Some(head): traits.family_for(method.trait_method_owner(), head)
        None: None
    match family:
        None:
            void
        Some(implementation):
            for member in implementation.methods:
                if member.method == method:
                    found = match member.body:
                        AuthoredMethod(function):
                            Some({
                                body = DeclaredBody(function),
                                arguments = receiver.receiver_arguments(),
                            })
                        TraitDefault(function):
                            Some({ body = DeclaredBody(function), arguments = [receiver] })
                        StructuralEquality(aggregate, _):
                            Some({
                                body = DerivedEqualityBody(aggregate),
                                arguments = receiver.receiver_arguments(),
                            })
                    break
    found


private fixed record CallableParameterIdentity {
    owner: FunctionId,
    position: Int,
}


opaque type CallableParameterId = CallableParameterIdentity


implements Equatable for CallableParameterId:
    pure func equals(left: Self, right: Self) -> Bool:
        from_opaque CallableParameterId(left) == from_opaque CallableParameterId(right)


pure func callable_parameter(owner: FunctionId, position: Int) -> CallableParameterId:
    into_opaque CallableParameterId({ owner = owner, position = position })


pure func callable_owner(id: CallableParameterId) -> FunctionId:
    from_opaque CallableParameterId(id).owner


pure func callable_position(id: CallableParameterId) -> Int:
    from_opaque CallableParameterId(id).position


union CallableChoice:
    MethodCallable(AcceptedMethodCall)
    NamedCallable(FunctionId, List[TypeRef])
    ForwardedCallable(CallableParameterId)
    LambdaCallable(LambdaId, List[CheckedExpr])
    StoredCallable(CheckedExpr)


union CheckedCallOperand:
    ValueOperand(CheckedExpr)
    CallableOperand(CallableParameterId, CallableChoice, Span)


union CallIdentity:
    RuntimeTarget(RuntimeOperation[VariantId, TypeRef])
    MethodTarget(TraitMethodId)
    DeclaredTarget(FunctionId)
    ParameterTarget(CallableParameterId)
    ValueTarget(ScopedBindingId)
    ConstantTarget(ConstantId)


union CallTarget:
    TraitMethod(AcceptedMethodCall)
    UserFunction(FunctionId, List[TypeRef])
    CallableParameter(CallableParameterId)
    ValueCall(CheckedExpr)
    RuntimeFunction(RuntimeOperation[VariantId, TypeRef])


-- UFCS places its receiver first; values and callbacks retain written order.
-- Specialization erases callbacks or places their environments at those positions.
record CheckedCall {
    target: CallTarget,
    operands: List[CheckedCallOperand],
    span: Span,
}


pure func primitive_ref(value_type: PrimitiveType) -> TypeRef:
    match value_type:
        BuiltinVoid: VoidType
        BuiltinInt: IntegerType(Int64Format)
        BuiltinFloat: FloatType
        BuiltinString: StringType


-- A dense ordinal within one checked function, issued in binding order by body
-- checking. binding_id is public only so the checking modules can issue them;
-- an ordinal names a binding, never a role.
opaque type BindingId = Int


implements Equatable for BindingId:
    pure func equals(left: Self, right: Self) -> Bool:
        from_opaque BindingId(left) == from_opaque BindingId(right)


opaque type LambdaId = Int


implements Equatable for LambdaId:
    pure func equals(left: Self, right: Self) -> Bool:
        from_opaque LambdaId(left) == from_opaque LambdaId(right)


union BodyOwner:
    DeclaredBody(FunctionId)
    LambdaBody(LambdaId)
    DerivedEqualityBody(AggregateId)


record ScopedBindingId {
    owner: BodyOwner,
    binding: BindingId,
}


private fixed record CaptureIdentity {
    owner: LambdaId,
    position: Int,
}


opaque type CaptureId = CaptureIdentity


pure func capture_id(owner: LambdaId, position: Int) -> CaptureId:
    into_opaque CaptureId({ owner = owner, position = position })


pure func capture_owner(id: CaptureId) -> LambdaId:
    from_opaque CaptureId(id).owner


pure func capture_number(id: CaptureId) -> Int:
    from_opaque CaptureId(id).position


pure func lambda_id(ordinal: Int) -> LambdaId:
    into_opaque LambdaId(ordinal)


pure func lambda_number(id: LambdaId) -> Int:
    from_opaque LambdaId(id)


pure func aggregate_head(aggregate: AggregateId) -> TypeHead:
    match aggregate:
        RecordAggregate(record_row): RecordHead(record_row)
        UnionAggregate(union_row): UnionHead(union_row)


pure func aggregate_owner(aggregate: AggregateId) -> TypeParameterOwner:
    match aggregate:
        RecordAggregate(record_row): RecordDeclaration(record_row)
        UnionAggregate(union_row): UnionDeclaration(union_row)


pure func equality_body(
    traits: AcceptedTraits,
    aggregate: AggregateId,
) -> Option[CheckedEqualityBody]:
    var found: Option[CheckedEqualityBody] = None
    for implementation in traits.implementations.implementation_rows():
        for member in implementation.methods:
            match member.body:
                StructuralEquality(owner, body):
                    if owner == aggregate:
                        found = Some(body)
                _:
                    void
    found


union BindingOrigin:
    ParameterBinding(Int)
    CallableParameterBinding(CallableParameterId)
    BodyLocal
    MatchCapture


record BindingDefinition {
    origin: BindingOrigin,
    mutable: Bool,
    value_type: TypeRef,
    span: Span,
}


pure func binding_number(id: BindingId) -> Int:
    from_opaque BindingId(id)


record CheckedRecordField {
    field: FieldId,
    value: CheckedExpr,
    span: Span,
}


record RetainedRecordField {
    field: FieldId,
    value_type: TypeRef,
}


-- `replacements` are the written fields in written order, which is their
-- evaluation order; `inherited` are the remaining fields in declaration order.
-- Checking guarantees at construction that together they name each of the
-- record's declared fields exactly once (`plan_record_update` in constructors.brp).
record CheckedRecordUpdate {
    base: CheckedExpr,
    base_expression_span: Span,
    replacements: List[CheckedRecordField],
    inherited: List[RetainedRecordField],
}


-- What an expression computes. A payload-free variant has no arguments.
union CheckedForm:
    MakeCallable(CallableChoice)
    LiteralVoid
    LiteralInteger(Int)
    LiteralFloat(Float)
    LiteralString(String)
    ReadBinding(BindingId)
    ReadCapture(CaptureId)
    ConstructVariant(VariantId, List[CheckedExpr])
    ConstructRecord(RecordId, List[CheckedRecordField])
    ConstructList(List[CheckedExpr])
    ConstructTuple(List[CheckedExpr])
    ConstructOpaque(OpaqueId, CheckedExpr)
    ProjectOpaque(OpaqueId, CheckedExpr)
    -- A value match, including an ordinary function's tail expression.
    Match(CheckedJoin)
    UpdateRecord(RecordId, CheckedRecordUpdate)
    InvokeFunction(CheckedCall)
    ReadRecordField(CheckedExpr, FieldId)
    ReadTupleElement(CheckedExpr, Int)


-- One checked expression. `span` is the node's own occurrence: a written base's
-- extent, or a postfix's extent from the written base to that postfix. A call's
-- callee anchor is a separate fact, the span of its CheckedCall.
record CheckedExpr {
    form: CheckedForm,
    value_type: TypeRef,
    span: Span,
}


union CheckedStatement:
    InitializeBinding(BindingId, CheckedExpr)
    ReassignBinding(BindingId, CheckedExpr)
    DiscardExpression(CheckedExpr)
    RunWhile(CheckedWhile)
    RunFor(CheckedFor)
    BreakSourceLoop(Span)
    ContinueSourceLoop(Span)


-- Check owns the condition's designation and ordered enclosing writes. Locals
-- belong to the body; specialization decides header eligibility from layouts.
record CheckedWhile {
    condition: CheckedExpr,
    body: List[CheckedStatement],
    carried: List[BindingId],
    boolean: DesignatedBoolean[VariantId],
    span: Span,
}


union CheckedIteration:
    ListIteration(CheckedExpr, TypeRef, DesignatedOption[VariantId])
    AscendingIntRange(CheckedExpr, CheckedExpr, DesignatedBoolean[VariantId])


record CheckedFor {
    iteration: CheckedIteration,
    item: Option[BindingId],
    body: List[CheckedStatement],
    carried: List[BindingId],
    span: Span,
}


-- Selection identities live within one checked match and survive specialization.
opaque type MatchArmId = Int


implements Equatable for MatchArmId:
    pure func equals(left: Self, right: Self) -> Bool:
        from_opaque MatchArmId(left) == from_opaque MatchArmId(right)


opaque type DecisionNodeId = Int


pure func match_arm_id(ordinal: Int) -> MatchArmId:
    into_opaque MatchArmId(ordinal)


pure func match_arm_number(id: MatchArmId) -> Int:
    from_opaque MatchArmId(id)


pure func decision_node_id(ordinal: Int) -> DecisionNodeId:
    into_opaque DecisionNodeId(ordinal)


pure func decision_node_number(id: DecisionNodeId) -> Int:
    from_opaque DecisionNodeId(id)


record CheckedPatternPlace {
    value_type: TypeRef,
    route: CheckedPatternRoute,
}


union CheckedPatternRoute:
    MatchRoot
    UnionField(CheckedPatternPlace, VariantId, Int)
    ListElement(CheckedPatternPlace, Int)
    RecordField(CheckedPatternPlace, Int)


union ListLengthTest:
    ExactLength(Int)
    MinimumLength(Int)


union CheckedPatternArgument:
    BorrowPlace(CheckedPatternPlace)
    CopyListSuffix(CheckedPatternPlace, Int)


union CheckedDecisionNode:
    TestVariant(CheckedPatternPlace, VariantId, DecisionNodeId, DecisionNodeId)
    EnterArm(MatchArmId, List[CheckedPatternArgument])
    TestListLength(CheckedPatternPlace, ListLengthTest, DecisionNodeId, DecisionNodeId)
    TestLiteral(CheckedPatternPlace, LiteralPattern, DecisionNodeId, DecisionNodeId)


-- Successors precede their tests; exhaustive checking establishes the last entry.
record CheckedSelection {
    nodes: List[CheckedDecisionNode],
    entry: DecisionNodeId,
}


record CheckedArm {
    id: MatchArmId,
    inputs: List[BindingId],
    statements: List[CheckedStatement],
    body: CheckedExit,
}


record CheckedMatch {
    scrutinee: CheckedExpr,
    selection: CheckedSelection,
    arms: List[CheckedArm],
}


union CheckedExit:
    ReturnExpression(CheckedExpr)
    RecurWith(List[CheckedExpr], Span)


-- A value-match arm, including an ordinary function tail: after its
-- statements it yields `value` to the join, then the enclosing body continues.
record CheckedJoinArm {
    id: MatchArmId,
    inputs: List[BindingId],
    statements: List[CheckedStatement],
    value: CheckedExpr,
}


-- A value match: the enclosing body continues with the selected arm's value,
-- including the return after an ordinary function tail. The expression's type
-- is Void for a statement match; annotated root tails use CheckedMatchBody.
record CheckedJoin {
    scrutinee: CheckedExpr,
    selection: CheckedSelection,
    arms: List[CheckedJoinArm],
    carried: List[BindingId],
}


union CheckedBody:
    CheckedValueBody(CheckedExit)
    CheckedMatchBody(CheckedMatch)


record CheckedFunction {
    id: FunctionId,
    -- A debugging annotation in generated C, never semantics.
    label: FunctionLabel,
    execution: FunctionExecution,
    signature: FunctionSignature,
    bindings: List[BindingDefinition],
    statements: List[CheckedStatement],
    body: CheckedBody,
}


-- One global row per admitted site; local bindings belong to this body only.
record CheckedCapture {
    binding: ScopedBindingId,
    value_type: TypeUse,
}


record CheckedLambda {
    purity: Purity,
    root: FunctionId,
    parameters: List[TypeUse],
    return_type: TypeUse,
    bindings: List[BindingDefinition],
    captures: List[CheckedCapture],
    statements: List[CheckedStatement],
    body: CheckedBody,
}


-- Construction rows retain the lexical parent while descendants resolve free
-- reads. Only CheckedLambda rows pass the final Check publication boundary.
record PendingLambdaRow {
    parent: BodyOwner,
    captures: List[CheckedCapture],
}


union LambdaRow:
    CollectingLambda(PendingLambdaRow)
    CheckedLambdaRow(CheckedLambda)


record CheckedValueResult {
    value: CheckedExpr,
    lambdas: List[LambdaRow],
}


record ResolvedBody {
    bindings: List[BindingDefinition],
    statements: List[CheckedStatement],
    body: CheckedBody,
    lambdas: List[LambdaRow],
}


record CheckedBodies {
    functions: List[CheckedFunction],
    lambdas: List[CheckedLambda],
}


-- A checked construction template; every runtime read gets ordinary value identities.
record CheckedConstant {
    id: ConstantId,
    annotation: Span,
    value: CheckedExpr,
}


pure func constant_row(constants: List[CheckedConstant], id: ConstantId) -> Option[CheckedConstant]:
    constants.get(id.constant_number())


record CheckedFunctions {
    traits: AcceptedTraits,
    records: List[CheckedRecord],
    unions: List[CheckedUnion],
    opaques: List[CheckedOpaque],
    functions: List[CheckedFunction],
    lambdas: List[CheckedLambda],
    entrypoint: Entrypoint[FunctionId],
}


pure func field_owner(id: FieldId) -> RecordId:
    from_opaque FieldId(id).owner


pure func field_number(id: FieldId) -> Int:
    from_opaque FieldId(id).position


-- The namespace's identity for a type's outermost constructor. A rigid type
-- parameter names no visible type.
pure func type_head(value_type: TypeRef) -> Option[TypeHead]:
    match value_type:
        VoidType: Some(PrimitiveHead(BuiltinVoid))
        IntegerType(format): Some(PrimitiveHead(integer_primitive(format)))
        FloatType: Some(PrimitiveHead(BuiltinFloat))
        StringType: Some(PrimitiveHead(BuiltinString))
        ListType(_): Some(ListHead)
        NominalType(AggregateNominal(aggregate), _): Some(aggregate.aggregate_head())
        NominalType(OpaqueNominal(id), _): Some(OpaqueHead(id))
        ParameterType(_) | CallableType(_, _, _) | TupleType(_): None


-- Header arity is established before this semantic application is requested.
pure func receiver_type(head: TypeHead, arguments: List[TypeRef]) -> Option[TypeRef]:
    match head:
        PrimitiveHead(primitive):
            Some(primitive.primitive_ref())
        OpaqueHead(owner):
            Some(NominalType(OpaqueNominal(owner), arguments))
        RecordHead(owner):
            Some(NominalType(AggregateNominal(RecordAggregate(owner)), arguments))
        UnionHead(owner):
            Some(NominalType(AggregateNominal(UnionAggregate(owner)), arguments))
        ListHead:
            match arguments:
                [element]: Some(ListType(element))
                _: None


pure func parameter_owner(id: TypeParameterId) -> TypeParameterOwner:
    from_opaque TypeParameterId(id).owner


pure func parameter_position(id: TypeParameterId) -> Int:
    from_opaque TypeParameterId(id).position


-- A union type's declaration and its ordered type arguments; a nongeneric
-- union occurrence has none.
record UnionOccurrence {
    owner: UnionId,
    arguments: List[TypeRef],
}


pure func union_occurrence(value: TypeRef) -> Option[UnionOccurrence]:
    match value:
        NominalType(AggregateNominal(UnionAggregate(id)), arguments):
            Some({ owner = id, arguments = arguments })
        _:
            None


-- The expressions a callable choice evaluates when it is created or passed: a
-- stored value, or a lambda's capture reads. Its body is a separate request.
private pure func choice_expressions(choice: CallableChoice) -> List[CheckedExpr]:
    match choice:
        StoredCallable(child): [child]
        LambdaCallable(_, captures): captures
        MethodCallable(_) | NamedCallable(_, _) | ForwardedCallable(_): []


-- The expressions a form evaluates directly, in evaluation order: a call's
-- callee then its operands, a match's scrutinee then each arm's statements and
-- value. Every walk of checked bodies steps through these. A lambda's captures
-- are children; each is a variable read, so visiting them finds no call.
pure func child_expressions(form: CheckedForm) -> List[CheckedExpr]:
    match form:
        ConstructOpaque(_, child):
            [child]
        ProjectOpaque(_, child):
            [child]
        ReadTupleElement(child, _):
            [child]
        ReadRecordField(child, _):
            [child]
        ConstructTuple(elements):
            elements
        ConstructList(elements):
            elements
        ConstructVariant(_, elements):
            elements
        ConstructRecord(_, fields):
            fields.map(pure func(field): field.value)
        UpdateRecord(_, update):
            [update.base].concat(update.replacements.map(pure func(field): field.value))
        MakeCallable(choice):
            choice.choice_expressions()
        Match(join):
            var children = [join.scrutinee]
            for arm in join.arms:
                children = children
                    .concat(arm.statements.statement_expressions())
                    .append(arm.value)
            children
        InvokeFunction(call):
            var children: List[CheckedExpr] = match call.target:
                ValueCall(callee): [callee]
                TraitMethod(_) | UserFunction(_, _) | CallableParameter(_) | RuntimeFunction(_): []
            for operand in call.operands:
                match operand:
                    ValueOperand(argument):
                        children = children.append(argument)
                    CallableOperand(_, choice, _):
                        children = children.concat(choice.choice_expressions())
            children
        LiteralVoid | LiteralInteger(_) | LiteralFloat(_) | LiteralString(_) | ReadBinding(_) | ReadCapture(_):
            []


-- The expressions a statement list evaluates, in order; a loop's body follows
-- its header expressions.
pure func statement_expressions(statements: List[CheckedStatement]) -> List[CheckedExpr]:
    var values: List[CheckedExpr] = []
    for statement in statements:
        match statement:
            InitializeBinding(_, value):
                values = values.append(value)
            ReassignBinding(_, value):
                values = values.append(value)
            DiscardExpression(value):
                values = values.append(value)
            RunWhile(loop):
                values = values
                    .append(loop.condition)
                    .concat(loop.body.statement_expressions())
            RunFor(loop):
                match loop.iteration:
                    ListIteration(iterable, _, _):
                        values = values.append(iterable)
                    AscendingIntRange(start, end, _):
                        values = values
                            .append(start)
                            .append(end)
                values = values.concat(loop.body.statement_expressions())
            BreakSourceLoop(_) | ContinueSourceLoop(_):
                void
    values


-- Calls in evaluation order: a node's children left to right, then the node.
private pure func append_calls(
    collected: List[CheckedCall],
    values: List[CheckedExpr],
) -> List[CheckedCall]:
    var calls = collected

    for value in values:
        calls = calls.append_calls(value.form.child_expressions())

        match value.form:
            InvokeFunction(call): calls = calls.append(call)
            _: void

    calls


private pure func exit_expressions(exit: CheckedExit) -> List[CheckedExpr]:
    match exit:
        ReturnExpression(value): [value]
        RecurWith(arguments, _): arguments


pure func expression_calls(value: CheckedExpr) -> List[CheckedCall]:
    append_calls([], [value])


pure func function_calls(function: CheckedFunction) -> List[CheckedCall]:
    body_calls(function.statements, function.body)


pure func lambda_calls(lambda: CheckedLambda) -> List[CheckedCall]:
    body_calls(lambda.statements, lambda.body)


pure func body_calls(statements: List[CheckedStatement], body: CheckedBody) -> List[CheckedCall]:
    append_calls([], body_expressions(statements, body))


-- Every expression a body evaluates, in order: its statements, then its value
-- or its scrutinee with each arm's statements and exit.
private pure func body_expressions(
    statements: List[CheckedStatement],
    body: CheckedBody,
) -> List[CheckedExpr]:
    var values = statements.statement_expressions()

    match body:
        CheckedValueBody(exit):
            values.concat(exit.exit_expressions())
        CheckedMatchBody(matched):
            values = values.append(matched.scrutinee)

            for arm in matched.arms:
                values = values
                    .concat(arm.statements.statement_expressions())
                    .concat(arm.body.exit_expressions())

            values


pure func field_id(owner: RecordId, position: Int) -> FieldId:
    into_opaque FieldId({ owner = owner, position = position })


pure func type_parameter_id(owner: TypeParameterOwner, position: Int) -> TypeParameterId:
    into_opaque TypeParameterId({ owner = owner, position = position })


pure func binding_id(ordinal: Int) -> BindingId:
    into_opaque BindingId(ordinal)


pure func has_callable_parameters(signature: FunctionSignature) -> Bool:
    signature.parameters.any(pure func(parameter):
        match parameter.value_type:
            CallableType(_, _, _): True
            _: False
    )


-- Value creation requests a body instance but does not execute it. This walk
-- follows only evaluated operands; each lambda's body is a separate request.
private pure func callable_creations(values: List[CheckedExpr]) -> List[CheckedExpr]:
    var found: List[CheckedExpr] = []

    for value in values:
        match value.form:
            MakeCallable(_): found = found.append(value)
            _: void

        found = found.concat(
            value.form
                .child_expressions()
                .callable_creations(),
        )

    found


pure func body_callable_creations(
    statements: List[CheckedStatement],
    body: CheckedBody,
) -> List[CheckedExpr]:
    body_expressions(statements, body).callable_creations()


-- The callable parameters a body uses as values: a read of a parameter's own
-- binding (a returned or stored callable, or a nested lambda's capture) or a
-- forwarded creation. Specialization turns each into a runtime closure.
pure func body_callable_parameter_values(
    bindings: List[BindingDefinition],
    statements: List[CheckedStatement],
    body: CheckedBody,
) -> List[CallableParameterId]:
    callable_parameter_values(bindings, body_expressions(statements, body))


private pure func callable_parameter_values(
    bindings: List[BindingDefinition],
    values: List[CheckedExpr],
) -> List[CallableParameterId]:
    var found: List[CallableParameterId] = []
    for value in values:
        match value.form:
            MakeCallable(ForwardedCallable(parameter)):
                found = found.append(parameter)
            ReadBinding(id):
                match bindings.get(id.binding_number()):
                    Some(binding):
                        match binding.origin:
                            CallableParameterBinding(parameter): found = found.append(parameter)
                            _: void
                    -- Unreachable: check issues every ReadBinding id from this
                    -- body's own binding table.
                    None:
                        void
            _:
                void
        found = found.concat(callable_parameter_values(bindings, value.form.child_expressions()))
    found


pure func expression_callable_creations(value: CheckedExpr) -> List[CheckedExpr]:
    [value].callable_creations()
