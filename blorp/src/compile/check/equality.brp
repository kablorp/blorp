---
Ordinary checked equality templates for supported aggregates. Eligibility
belongs to traits; this module receives its accepted canonical method contract.
---
import:
    int: Int methods
    ../../syntax/source: FunctionLabel
    ../../syntax/syntax: Span
    ../ids: VariantId, TraitMethodId, RecordId, UnionId
    ../namespace/builtins: DesignatedBoolean
    ./declarations: Substitution, substitute_type
    ./errors: CheckError, checker_invariant, CheckerInvariant(InvalidFunctionContract)
    ./model as model


private pure func boolean_value(
    value: Bool,
    boolean: DesignatedBoolean[VariantId],
    span: Span,
) -> model.CheckedExpr:
    variant = match value:
        True: boolean.true_variant
        False: boolean.false_variant
    {
        form = model.ConstructVariant(variant, []),
        value_type = model.NominalType(
            model.AggregateNominal(model.UnionAggregate(variant.variant_owner())),
            [],
        ),
        span = span,
    }


-- Both successors precede the test. Only the successful comparison evaluates
-- the remaining fields, retaining normal checked join/control-flow semantics.
private pure func and_then(
    comparison: model.CheckedExpr,
    following: model.CheckedExpr,
    boolean: DesignatedBoolean[VariantId],
) -> model.CheckedExpr:
    span = comparison.span
    false_arm = model.match_arm_id(0)
    true_arm = model.match_arm_id(1)
    place: model.CheckedPatternPlace = {
        route = model.MatchRoot,
        value_type = comparison.value_type,
    }
    {
        form = model.Match({
            scrutinee = comparison,
            selection = {
                nodes = [
                    model.EnterArm(false_arm, []),
                    model.EnterArm(true_arm, []),
                    model.TestVariant(
                        place,
                        boolean.true_variant,
                        model.decision_node_id(1),
                        model.decision_node_id(0),
                    ),
                ],
                entry = model.decision_node_id(2),
            },
            arms = [
                {
                    id = false_arm,
                    inputs = [],
                    statements = [],
                    value = boolean_value(False, boolean, span),
                },
                { id = true_arm, inputs = [], statements = [], value = following },
            ],
            carried = [],
        }),
        value_type = following.value_type,
        span = span,
    }


private pure func read_parameter(
    position: Int,
    value_type: model.TypeRef,
    span: Span,
) -> model.CheckedExpr:
    { form = model.ReadBinding(model.binding_id(position)), value_type = value_type, span = span }


private pure func compare(
    left: model.CheckedExpr,
    right: model.CheckedExpr,
    method: model.AcceptedTraitMethod,
) -> model.CheckedExpr:
    {
        form = model.InvokeFunction({
            target = model.TraitMethod(model.accepted_method(method.id, left.value_type)),
            operands = [model.ValueOperand(left), model.ValueOperand(right)],
            span = left.span,
        }),
        value_type = method.signature.return_type.value_type,
        span = left.span,
    }


private pure func record_value(
    record_row: model.CheckedRecord,
    receiver: model.TypeRef,
    method: model.AcceptedTraitMethod,
    boolean: DesignatedBoolean[VariantId],
    span: Span,
) -> model.CheckedExpr:
    var result = boolean_value(True, boolean, span)
    var remaining = record_row.fields.length()
    while remaining > 0:
        remaining = remaining - 1
        match record_row.fields.get(remaining):
            Some(field):
                left: model.CheckedExpr = {
                    form = model.ReadRecordField(read_parameter(0, receiver, span), field.id),
                    value_type = field.value_type.value_type,
                    span = field.value_type.span,
                }
                right: model.CheckedExpr = {
                    form = model.ReadRecordField(read_parameter(1, receiver, span), field.id),
                    value_type = field.value_type.value_type,
                    span = field.value_type.span,
                }
                result = left
                    .compare(right, method)
                    .and_then(result, boolean)
            None:
                void
    result


private pure func parameter_binding(
    position: Int,
    value_type: model.TypeRef,
    span: Span,
) -> model.BindingDefinition:
    {
        origin = model.ParameterBinding(position),
        mutable = False,
        value_type = value_type,
        span = span,
    }


private pure func union_template(
    label: FunctionLabel,
    union_row: model.CheckedUnion,
    value_type: model.TypeRef,
    signature: model.FunctionSignature,
    method: model.AcceptedTraitMethod,
    boolean: DesignatedBoolean[VariantId],
    span: Span,
) -> model.CheckedEqualityBody:
    root: model.CheckedPatternPlace = { route = model.MatchRoot, value_type = value_type }
    var bindings = [parameter_binding(0, value_type, span), parameter_binding(1, value_type, span)]
    var arms: List[model.CheckedJoinArm] = []
    var nodes: List[model.CheckedDecisionNode] = []
    for variant in union_row.variants:
        var left_inputs: List[model.BindingId] = []
        var right_inputs: List[model.BindingId] = []
        var arguments: List[model.CheckedPatternArgument] = []
        var position = 0
        for field in variant.fields:
            left_inputs = left_inputs.append(model.binding_id(bindings.length()))
            bindings = bindings.append({
                origin = model.MatchCapture,
                mutable = False,
                value_type = field.value_type,
                span = field.span,
            })
            right_inputs = right_inputs.append(model.binding_id(bindings.length()))
            bindings = bindings.append({
                origin = model.MatchCapture,
                mutable = False,
                value_type = field.value_type,
                span = field.span,
            })
            arguments = arguments.append(
                model.BorrowPlace({
                    route = model.UnionField(root, variant.id, position),
                    value_type = field.value_type,
                }),
            )
            position = position + 1
        var equal_value = boolean_value(True, boolean, span)
        while position > 0:
            position = position - 1
            match variant.fields.get(position):
                Some(field):
                    match left_inputs.get(position):
                        Some(left):
                            match right_inputs.get(position):
                                Some(right):
                                    left_value: model.CheckedExpr = {
                                        form = model.ReadBinding(left),
                                        value_type = field.value_type,
                                        span = field.span,
                                    }
                                    right_value: model.CheckedExpr = {
                                        form = model.ReadBinding(right),
                                        value_type = field.value_type,
                                        span = field.span,
                                    }
                                    equal_value = left_value
                                        .compare(right_value, method)
                                        .and_then(equal_value, boolean)
                                None:
                                    void
                        None:
                            void
                None:
                    void
        mismatch = model.match_arm_id(0)
        singleton = union_row.variants.length() == 1
        matched_position = if singleton:
            0
        else:
            1
        matched = model.match_arm_id(matched_position)
        -- A singleton domain has no mismatching tag. Retain only its success
        -- arm, as ordinary exhaustive pattern compilation does.
        right_selection: model.CheckedSelection = if singleton:
            { nodes = [model.EnterArm(matched, arguments)], entry = model.decision_node_id(0) }
        else:
            {
                nodes = [
                    model.EnterArm(mismatch, []),
                    model.EnterArm(matched, arguments),
                    model.TestVariant(
                        root,
                        variant.id,
                        model.decision_node_id(1),
                        model.decision_node_id(0),
                    ),
                ],
                entry = model.decision_node_id(2),
            }
        right_arms: List[model.CheckedJoinArm] = if singleton:
            [{ id = matched, inputs = right_inputs, statements = [], value = equal_value }]
        else:
            [
                {
                    id = mismatch,
                    inputs = [],
                    statements = [],
                    value = boolean_value(False, boolean, span),
                },
                { id = matched, inputs = right_inputs, statements = [], value = equal_value },
            ]
        right_match: model.CheckedExpr = {
            form = model.Match({
                scrutinee = read_parameter(1, value_type, span),
                selection = right_selection,
                arms = right_arms,
                carried = [],
            }),
            value_type = signature.return_type.value_type,
            span = span,
        }
        arm = model.match_arm_id(arms.length())
        arms = arms.append({ id = arm, inputs = left_inputs, statements = [], value = right_match })
        nodes = nodes.append(model.EnterArm(arm, arguments))
    -- The last tag is the exhaustive fallback; each earlier test has one
    -- success arm and the previous fallback. This is linear in variant count.
    var entry = model.decision_node_id(nodes.length() - 1)
    var remaining = union_row.variants.length() - 1
    while remaining > 0:
        remaining = remaining - 1
        match union_row.variants.get(remaining):
            Some(variant):
                nodes = nodes.append(
                    model.TestVariant(root, variant.id, model.decision_node_id(remaining), entry),
                )
                entry = model.decision_node_id(nodes.length() - 1)
            None:
                void
    {
        label = label,
        signature = signature,
        bindings = bindings,
        body = model.CheckedValueBody(
            model.ReturnExpression({
                form = model.Match({
                    scrutinee = read_parameter(0, value_type, span),
                    selection = { nodes = nodes, entry = entry },
                    arms = arms,
                    carried = [],
                }),
                value_type = signature.return_type.value_type,
                span = span,
            }),
        ),
    }


-- The canonical contract is already accepted. Substitute its genuine Self
-- once; no parsed header, spelling or new implicit parameter domain is needed.
pure func equality_template(
    aggregate: model.AggregateId,
    label: FunctionLabel,
    type_parameters: List[model.TypeParameterId],
    requirements: List[model.TraitRequirement],
    records: List[model.CheckedRecord],
    unions: List[model.CheckedUnion],
    method: model.AcceptedTraitMethod,
    boolean: DesignatedBoolean[VariantId],
    span: Span,
) -> Result[model.CheckedEqualityBody, CheckError]:
    arguments = type_parameters.map(
        pure func(parameter) -> model.TypeRef: model.ParameterType(parameter),
    )
    receiver: model.TypeRef = model.NominalType(model.AggregateNominal(aggregate), arguments)
    substitution: Substitution = {
        owner = model.TraitDeclaration(method.id.trait_method_owner()),
        values = [receiver],
    }
    var parameters: List[model.TypeUse] = []
    var failure: Option[CheckError] = None
    for parameter in method.signature.parameters:
        match parameter.value_type.substitute_type(substitution, parameter.span):
            Ok(value):
                parameters = parameters.append({ value_type = value, span = parameter.span })
            Err(error):
                failure = Some(error)
                break
    _: Void ?= match failure:
        Some(error): Err(error)
        None: Ok(void)
    result ?= method.signature.return_type.value_type.substitute_type(substitution, span)
    signature: model.FunctionSignature = {
        type_parameters = type_parameters,
        requirements = requirements,
        purity = method.signature.purity,
        parameters = parameters,
        return_type = { value_type = result, span = span },
    }
    match aggregate:
        model.RecordAggregate(record_row):
            match records.get(record_row.record_number()):
                Some(row):
                    Ok({
                        label = label,
                        signature = signature,
                        bindings = [
                            parameter_binding(0, receiver, span),
                            parameter_binding(1, receiver, span),
                        ],
                        body = model.CheckedValueBody(
                            model.ReturnExpression(
                                row.record_value(receiver, method, boolean, span),
                            ),
                        ),
                    })
                None:
                    Err(checker_invariant(span, InvalidFunctionContract))
        model.UnionAggregate(union_row):
            match unions.get(union_row.union_number()):
                Some(row):
                    Ok(union_template(label, row, receiver, signature, method, boolean, span))
                None:
                    Err(checker_invariant(span, InvalidFunctionContract))
