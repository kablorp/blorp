---
Receiver visibility and accepted call contracts. Namespace owns which functions
a receiver call reaches; inference selects by type after declaration clashes
have been rejected. Contracts prove arity and purity once.
---
import:
    bool: Bool methods
    int: Int methods
    option: Option methods
    ../../syntax/names: NameId
    ../../syntax/source: ModuleId
    ../../syntax/syntax:
        Purity(Impure, Pure),
        Span,
        TypeSyntax,
        ValueExpression,
        WrittenName,
        ReceiverApplication,
    ../ids: TraitMethodId, TraitId, FunctionId, OpaqueRow, VariantId
    ../namespace/builtins:
        RuntimeOperation(StringConcat, StringAppendInt, ListAppend, ListSet, ListConcat),
        DesignatedBoolean,
        DesignatedOption,
    ../namespace/namespace:
        FunctionSource(DeclaredHere, ImportedAt),
        Namespace,
        NamedValue(NamedMethod, NamedFunction, NamedConstructor),
        OfferedValue(OfferedMethod, OfferedFunction),
        TypeHead,
        MethodImport,
        ValueBinding(MethodName),
        Entry,
    ./declarations: TypeScope
    ./errors:
        CallError(ArgumentCountMismatch, ImpureCall, ImpureCallableCall, UnknownFunction),
        CheckError,
        CheckerInvariant(InvalidResolvedFunction, InvalidFunctionContract, InvalidReceiverScope),
        call_error,
        checker_invariant,
        or_checker_invariant,
        trait_error,
        TraitError(MissingImplementation, DifferentMethodFamilies, FamilyFunctionConflict),
        MethodCandidateSite,
        MethodError(ConstructorUFCS),
        method_error,
    ./model:
        BodyOwner,
        ReceiverFunction,
        ReceiverLookup(VisibleMethod, VisibleFunctions),
        AdmittedReceiverScope,
        AcceptedTraits,
        AcceptedMethodCall,
        TraitRequirement,
        accepted_method,
        CallIdentity(RuntimeTarget, MethodTarget, DeclaredTarget, ParameterTarget),
        CheckedConstant,
        CheckedOpaque,
        FunctionSignature,
        TypeRef(ParameterType),
        CheckedRecord,
        CheckedUnion,
    ./scope: CallableBinding
    ./signatures: AcceptedFunction, AcceptedBody(BuiltinBody)
    ./traits: TraitAvailability
    ./well_formed: TraitAvailability methods


-- The active body owns purity independently of its root declaration.
record Caller {
    body: BodyOwner,
    purity: Purity,
}


-- A resolved call whose complete arity and purity have been validated.
-- The accepted signature owns its ordered parameter types and result type.
record FunctionContract {
    target: CallIdentity,
    signature: FunctionSignature,
    span: Span,
}


-- `arguments` excludes the receiver of a receiver call, which the arity adds.
pure func function_contract(
    caller: Caller,
    name: WrittenName,
    receiver_call: Bool,
    arguments: List[ValueExpression],
    callee: FunctionId,
    signatures: List[AcceptedFunction],
) -> Result[FunctionContract, CheckError]:
    accepted ?= accepted_function(name.span, callee, signatures)
    signature = accepted.signature
    count = if receiver_call:
        arguments.length() + 1
    else:
        arguments.length()
    arity ?= validate_arity(name, receiver_call, count, DeclaredTarget(callee), signature)
    pure_call ?= caller.validate_purity(name, callee, signature)
    Ok({ target = accepted.declared_call_target(), signature = signature, span = name.span })


-- A call to a function the checker located by identity, such as a Dict
-- literal's: no written name to report and an arity its caller supplies.
pure func declared_id_contract(
    span: Span,
    callee: FunctionId,
    signatures: List[AcceptedFunction],
) -> Result[FunctionContract, CheckError]:
    accepted ?= accepted_function(span, callee, signatures)
    Ok({ target = accepted.declared_call_target(), signature = accepted.signature, span = span })


pure func accepted_function(
    span: Span,
    callee: FunctionId,
    signatures: List[AcceptedFunction],
) -> Result[AcceptedFunction, CheckError]:
    signatures
        .get(callee.function_number())
        .or_checker_invariant(span, InvalidResolvedFunction(callee))


-- Accepted update builtins have direct consuming runtime contracts.
-- Callable values still name their declared borrowed wrappers.
private pure func declared_call_target(accepted: AcceptedFunction) -> CallIdentity:
    match accepted.body:
        BuiltinBody(operation, _):
            match operation:
                StringConcat | StringAppendInt | ListAppend(_) | ListSet(_) | ListConcat(_):
                    RuntimeTarget(operation)
                _:
                    DeclaredTarget(accepted.id)
        _:
            DeclaredTarget(accepted.id)


private pure func validate_arity(
    name: WrittenName,
    receiver_call: Bool,
    actual: Int,
    callee: CallIdentity,
    signature: FunctionSignature,
) -> Result[Void, CheckError]:
    expected = signature.parameters.length()
    if expected == actual:
        Ok(void)
    else:
        Err(
            call_error(
                name.span,
                ArgumentCountMismatch({
                    callee = name.id,
                    expected = expected,
                    actual = actual,
                    receiver_call = receiver_call,
                    target = callee,
                }),
            ),
        )


private pure func validate_purity(
    caller: Caller,
    name: WrittenName,
    callee: FunctionId,
    signature: FunctionSignature,
) -> Result[Void, CheckError]:
    if caller.calls_impure_from_pure(signature):
        Err(call_error(name.span, ImpureCall(caller.body, callee)))
    else:
        Ok(void)


private pure func calls_impure_from_pure(caller: Caller, signature: FunctionSignature) -> Bool:
    (caller.purity == Pure).and(signature.purity == Impure)


record ResolutionContext {
    traits: TraitAvailability,
    caller: Caller,
    root_function: FunctionId,
    module: ModuleId,
    namespace: Namespace,
    receiver_scope: AdmittedReceiverScope,
    body_types: TypeScope,
    signatures: List[AcceptedFunction],
    unions: List[CheckedUnion],
    records: List[CheckedRecord],
    opaque_declarations: List[OpaqueRow],
    opaques: List[CheckedOpaque],
    constants: List[CheckedConstant],
    boolean: DesignatedBoolean[VariantId],
    option: DesignatedOption[VariantId],
    in_source_loop: Bool,
}


-- A type written in a body, proved under the enclosing function's bounds.
pure func resolve_body_type(
    context: ResolutionContext,
    written: TypeSyntax,
) -> Result[TypeRef, CheckError]:
    resolved ?= context.body_types.resolve_type(written)
    accepted ?= context.signatures
        .get(context.root_function.function_number())
        .or_checker_invariant(written.type_span(), InvalidFunctionContract)
    _: Void ?= context.traits.prove_well_formed(written, resolved, accepted.signature.requirements)
    Ok(resolved)


union ResolvedReceiver:
    UniqueReceiver(FunctionContract)
    ReceiverCandidates(List[ReceiverFunction])


-- The head of `function`'s first parameter type, which UFCS dispatches on.
private pure func receiver_head(function: AcceptedFunction) -> Option[TypeHead]:
    match function.signature.parameters.get(0):
        Some(parameter): parameter.value_type.type_head()
        None: None


private pure func listed_function(candidates: List[ReceiverFunction], id: FunctionId) -> Bool:
    var present: Bool = False
    for candidate in candidates:
        if candidate.id == id:
            present = True
            break
    present


-- Build every ordinary receiver candidate once: the named function first,
-- then qualifying offered functions in method-import order. Repeated routes
-- keep the first introduction anchor for each function identity.
pure func receiver_functions(
    namespace: Namespace,
    signatures: List[AcceptedFunction],
    module: ModuleId,
) -> Result[Dict[NameId, ReceiverLookup], CheckError]:
    var found: Dict[NameId, ReceiverLookup] = {}
    var failure: Option[CheckError] = None
    for entry in namespace.module_entries(module):
        match entry.entry_value():
            Some(NamedFunction(id, source)):
                site: Option[Span] = match source:
                    DeclaredHere: None
                    ImportedAt(span): Some(span)
                match signatures.get(id.function_number()):
                    Some(_):
                        found = found.set(
                            entry.name.id,
                            VisibleFunctions([{ id = id, import_site = site }]),
                        )
                    None:
                        failure = Some(
                            checker_invariant(entry.name.span, InvalidResolvedFunction(id)),
                        )
            _:
                void
        if failure.is_some():
            break
    for imported in namespace.method_imports(module):
        if failure.is_some():
            break
        for entry in namespace.module_entries(imported.target):
            match entry.offered_function():
                Some(id):
                    match signatures.get(id.function_number()):
                        Some(function):
                            match function.receiver_head():
                                Some(head):
                                    if head == imported.receiver:
                                        key = entry.name.id
                                        match found.get(key):
                                            None:
                                                found = found.set(
                                                    key,
                                                    VisibleFunctions([
                                                        {
                                                            id = id,
                                                            import_site = Some(imported.name.span),
                                                        },
                                                    ]),
                                                )
                                            Some(VisibleFunctions(candidates)):
                                                if (
                                                    candidates
                                                        .listed_function(id)
                                                        .not()
                                                ):
                                                    found = found.set(
                                                        key,
                                                        VisibleFunctions(
                                                            candidates.append({
                                                                id = id,
                                                                import_site = Some(
                                                                    imported.name.span,
                                                                ),
                                                            }),
                                                        ),
                                                    )
                                            Some(VisibleMethod(_)):
                                                failure = Some(
                                                    checker_invariant(
                                                        entry.name.span,
                                                        InvalidReceiverScope,
                                                    ),
                                                )
                                None:
                                    void
                        None:
                            failure = Some(
                                checker_invariant(entry.name.span, InvalidResolvedFunction(id)),
                            )
                None:
                    void
            if failure.is_some():
                break
    match failure:
        Some(error): Err(error)
        None: Ok(found)


pure func method_sites(
    candidates: List[ReceiverFunction],
    signatures: List[AcceptedFunction],
    span: Span,
) -> Result[List[MethodCandidateSite], CheckError]:
    var sites: List[MethodCandidateSite] = []
    var failure: Option[CheckError] = None
    for candidate in candidates:
        match accepted_function(span, candidate.id, signatures):
            Err(error):
                failure = Some(error)
                break
            Ok(accepted):
                sites = sites.append(candidate.method_site(accepted.declaration.function_name.span))
    match failure:
        Some(error): Err(error)
        None: Ok(sites)


pure func method_site(candidate: ReceiverFunction, declaration: Span) -> MethodCandidateSite:
    { function = candidate.id, declaration = declaration, import_site = candidate.import_site }


-- Where the candidate entered the caller's module: its selection, else its own
-- declaration.
pure func candidate_span(candidate: ReceiverFunction, declaration: Span) -> Span:
    match candidate.import_site:
        Some(selection): selection
        None: declaration


pure func classify_receiver(
    application: ReceiverApplication,
    context: ResolutionContext,
) -> Result[ResolvedReceiver, CheckError]:
    name = application.callee

    match context.receiver_scope.names.get(name.id):
        Some(VisibleMethod(id)):
            match method_contract(
                name,
                application.arguments.length() + 1,
                True,
                id,
                context.traits.accepted_traits(),
            ):
                Ok(contract): Ok(UniqueReceiver(contract))
                Err(error): Err(error)
        Some(VisibleFunctions(candidates)):
            application.classify_function_receiver(context, candidates)
        None:
            application.classify_function_receiver(context, [])


private pure func classify_function_receiver(
    application: ReceiverApplication,
    context: ResolutionContext,
    candidates: List[ReceiverFunction],
) -> Result[ResolvedReceiver, CheckError]:
    name = application.callee
    match candidates:
        []:
            match context.namespace.named_value(context.module, name.id):
                Some(NamedConstructor(_)): Err(method_error(name.span, ConstructorUFCS(name.id)))
                _: Err(call_error(name.span, UnknownFunction(name.id)))
        [candidate]:
            match context.caller.function_contract(
                name,
                True,
                application.arguments,
                candidate.id,
                context.signatures,
            ):
                Ok(contract): Ok(UniqueReceiver(contract))
                Err(error): Err(error)
        _:
            Ok(ReceiverCandidates(candidates))


pure func callable_contract(
    caller: Caller,
    name: WrittenName,
    arguments: List[ValueExpression],
    binding: CallableBinding,
) -> Result[FunctionContract, CheckError]:
    accepted ?= binding.callable_parameter_contract()
    caller.value_callable_contract(
        name,
        arguments,
        ParameterTarget(accepted.parameter),
        accepted.signature,
    )


-- The resolved binding, not its name, identifies an ordinary stored callable.
pure func value_callable_contract(
    caller: Caller,
    name: WrittenName,
    arguments: List[ValueExpression],
    target: CallIdentity,
    signature: FunctionSignature,
) -> Result[FunctionContract, CheckError]:
    arity ?= validate_arity(name, False, arguments.length(), target, signature)
    _: Void ?= if caller.calls_impure_from_pure(signature):
        Err(call_error(name.span, ImpureCallableCall(caller.body)))
    else:
        Ok(void)
    Ok({ target = target, signature = signature, span = name.span })


pure func method_contract(
    name: WrittenName,
    count: Int,
    receiver_call: Bool,
    method: TraitMethodId,
    traits: AcceptedTraits,
) -> Result[FunctionContract, CheckError]:
    contract ?= method_id_contract(name.span, method, traits)
    arity ?= validate_arity(name, receiver_call, count, MethodTarget(method), contract.signature)
    Ok(contract)


pure func method_id_contract(
    span: Span,
    method: TraitMethodId,
    traits: AcceptedTraits,
) -> Result[FunctionContract, CheckError]:
    owner ?= traits.declarations
        .get(
            method
                .trait_method_owner()
                .trait_number(),
        )
        .or_checker_invariant(span, InvalidFunctionContract)
    accepted ?= owner.methods
        .get(method.trait_method_number())
        .or_checker_invariant(span, InvalidFunctionContract)
    Ok({ target = MethodTarget(method), signature = accepted.signature, span = span })


-- The receiver is already solved by ordinary equations. Implementation search
-- proves the obligation; it never supplies missing inference evidence.
pure func accept_method_call(
    traits: TraitAvailability,
    method: TraitMethodId,
    receiver: TypeRef,
    assumptions: List[TraitRequirement],
    span: Span,
) -> Result[AcceptedMethodCall, CheckError]:
    accepted = accepted_method(method, receiver)
    _: Void ?= match receiver:
        ParameterType(_):
            Ok(void)
        _:
            match (
                traits
                    .accepted_traits()
                    .method_body(accepted)
            ):
                Some(_):
                    Ok(void)
                None:
                    rejection: CheckError = match traits.equality_error(
                        method.trait_method_owner(),
                        receiver,
                        span,
                    ):
                        Some(error): error
                        None: trait_error(span, MissingImplementation(method, receiver))
                    Err(rejection)
    justified ?= traits.prove_trait(method.trait_method_owner(), receiver, assumptions, span)
    Ok(accepted)


private fixed record MethodBinding {
    method: TraitMethodId,
    span: Span,
}


-- The selected type exposes this provider's own accepted implementation. Once
-- exposed, the family remains the same across every implementing Self type.
pure func provider_owns_method(
    traits: AcceptedTraits,
    edge: MethodImport,
    method: TraitMethodId,
) -> Bool:
    match traits.family_for(method.trait_method_owner(), edge.receiver):
        Some(family):
            match family.method_provider:
                Some(provider):
                    (provider == edge.target).and(
                        family.methods.any(pure func(member): member.method == method),
                    )
                None:
                    False
        None:
            False


private pure func add_family(
    previous: Option[MethodBinding],
    method: TraitMethodId,
    span: Span,
    module: ModuleId,
) -> Result[Option[MethodBinding], CheckError]:
    match previous:
        None:
            Ok(Some({ method = method, span = span }))
        Some(held):
            if held.method == method:
                Ok(previous)
            else:
                if held.span.incoming_diagnostic_site(span, module):
                    Err(trait_error(span, DifferentMethodFamilies(method, held.method, held.span)))
                else:
                    Err(trait_error(held.span, DifferentMethodFamilies(held.method, method, span)))


pure func admit_method_family(
    namespace: Namespace,
    traits: AcceptedTraits,
    signatures: List[AcceptedFunction],
    module: ModuleId,
    name: WrittenName,
    functions: List[ReceiverFunction],
) -> Result[ReceiverLookup, CheckError]:
    var found: Option[MethodBinding] = match namespace.named_value(module, name.id):
        Some(NamedMethod(id)):
            match namespace.value_binding(module, name.id):
                Some(MethodName(written)): Some({ method = id, span = written.span })
                _: None
        _:
            None
    var failure: Option[CheckError] = None
    for imported in namespace.method_imports(module):
        match namespace.offered_value(imported.target, name.id):
            Ok(OfferedMethod(method)):
                if traits.provider_owns_method(imported, method):
                    match found.add_family(method, imported.name.span, module):
                        Ok(accepted): found = accepted
                        Err(error): failure = Some(error)
            _:
                void
        if failure.is_some():
            break
    _: Void ?= match failure:
        Some(error): Err(error)
        None: Ok(void)
    match found:
        None:
            Ok(VisibleFunctions(functions))
        Some(family):
            match functions:
                []:
                    Ok(VisibleMethod(family.method))
                [function, ..._]:
                    match accepted_function(name.span, function.id, signatures):
                        Err(error):
                            Err(error)
                        Ok(accepted):
                            function_span = function.candidate_span(
                                accepted.declaration.function_name.span,
                            )
                            if family.span.incoming_diagnostic_site(function_span, module):
                                Err(
                                    trait_error(
                                        function_span,
                                        FamilyFunctionConflict(
                                            family.method,
                                            function.id,
                                            family.span,
                                        ),
                                    ),
                                )
                            else:
                                Err(
                                    trait_error(
                                        family.span,
                                        FamilyFunctionConflict(
                                            family.method,
                                            function.id,
                                            function_span,
                                        ),
                                    ),
                                )


-- Local written order selects diagnostic sites only. Offsets in different
-- sources are unrelated; a local introduction takes priority over inheritance.
private pure func incoming_diagnostic_site(
    previous: Span,
    incoming: Span,
    module: ModuleId,
) -> Bool:
    if previous.source == incoming.source:
        (incoming.start < previous.start).not()
    else if incoming.source == module.module_source():
        True
    else if previous.source == module.module_source():
        False
    else:
        True
