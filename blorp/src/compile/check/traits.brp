---
Accepts abstract requirements and concrete authored implementations once, before
any body can use them. Inventory owns member identities; this phase publishes
the resolved requirement-to-body mapping consumed by checking and specialization.
---
import:
    bool: Bool methods
    int: Int methods
    list: List methods
    option: Option methods
    ../../syntax/names: NameTable, NameId
    ../../syntax/source: ModuleId, equality_label, ModuleKind(LibraryModule)
    ../../syntax/syntax:
        FunctionHeader,
        WrittenName,
        TypeSyntax(CallableTypeSyntax),
        Purity(Pure),
        Visibility(Public, Private),
        Span,
        compiler_span,
    ../assemble: ParsedContents
    ../ids:
        DeclarationInventory,
        RecordRow,
        UnionRow,
        FunctionId,
        VariantId,
        TraitMethodId,
        TraitMethodDeclaration(RequiredMethod, DefaultMethod),
        TraitRow,
        TraitMethodRow,
        ImplId,
        ImplRow,
        TraitId,
        RecordId,
        UnionId,
        OpaqueId,
    ../namespace/builtins: DesignatedBoolean
    ../namespace/namespace:
        Namespace,
        FunctionSource(DeclaredHere),
        NamedValue(NamedFunction),
        TypeHead(PrimitiveHead, ListHead, RecordHead, UnionHead, OpaqueHead),
    ./declarations:
        CheckedDeclarations,
        TypeScope,
        type_access,
        previous_declaration,
        Substitution,
        substitute_type,
    ./equality: equality_template
    ./errors:
        CheckError,
        checker_invariant,
        or_checker_invariant,
        type_term_error,
        TypeTermError(PrivateTypeInPublicDeclaration),
        CheckerInvariant(InvalidFunctionContract),
        TraitError(
            SupertraitUnknown,
            SupertraitCycle,
            SupertraitMethodInImplementation,
            CanonicalEquatableSupertraits,
            EqualityMemberUnsupported,
            DuplicateRequirementParameter,
            ImpureRequirement,
            GenericRequirement,
            FirstParameterMustBeSelf,
            CallableFormalDeferred,
            OrphanImplementation,
            DuplicateImplementation,
            MissingImplementationMethod,
            MissingTraitBound,
            UnknownImplementationMethod,
            DuplicateImplementationMethod,
            ImplementationSignatureMismatch,
            MalformedCanonicalTrait,
            MalformedCanonicalMember,
        ),
        ArithmeticTrait(
            AddableTrait,
            SubtractableTrait,
            MultipliableTrait,
            DivisibleTrait,
            ModulableTrait,
            NegatableTrait,
        ),
        ComparisonTrait(EquatableTrait, OrderableTrait),
        CanonicalFamily(ComparisonFamily, ArithmeticFamily),
        trait_error,
    ./model:
        AggregateId(RecordAggregate, UnionAggregate),
        NominalId(AggregateNominal, OpaqueNominal),
        EqualityMember(EqualityField, EqualityPayload),
        CheckedRecord,
        CheckedUnion,
        AcceptedTraits,
        AcceptedTraitContracts,
        CanonicalContracts,
        DictLiteralFunctions,
        ImplementationTable,
        implementation_table,
        CanonicalEquality,
        canonical_equality,
        CanonicalOrdering,
        canonical_ordering,
        CanonicalOperation,
        canonical_operation,
        AcceptedTrait,
        AcceptedTraitMethod,
        AcceptedImplementation,
        ImplementedMethod,
        ImplementedBody(AuthoredMethod, TraitDefault, StructuralEquality),
        TypeParameterId,
        LocatedTrait,
        TraitRequirement,
        receiver_type,
        ImplementationHeader,
        FunctionSignature,
        TypeUse,
        TypeRef(ParameterType, VoidType, NominalType),
        TypeParameterOwner(TraitDeclaration),
        type_parameter_id,
    ./signatures: AcceptedFunction


private pure func requirement(
    row: TraitMethodRow,
    scope: TypeScope,
    owner: TraitId,
    parsed: ParsedContents,
) -> Result[AcceptedTraitMethod, CheckError]:
    header ?= row
        .trait_method_header(parsed.declarations)
        .or_checker_invariant(row.span, InvalidFunctionContract)
    _: Void ?= if header.purity == Pure:
        Ok(void)
    else:
        Err(trait_error(header.function_name.span, ImpureRequirement(row.id)))
    _: Void ?= if header.type_parameters.is_empty():
        Ok(void)
    else:
        Err(trait_error(header.function_name.span, GenericRequirement(row.id)))
    var parameters: List[TypeUse] = []
    var failure: Option[CheckError] = None
    for parameter in header.parameters:
        resolved: Result[TypeRef, CheckError] = match parameter.type_name:
            CallableTypeSyntax(_, _, _, _):
                Err(trait_error(parameter.type_name.type_span(), CallableFormalDeferred(row.id)))
            _:
                scope.resolve_type(parameter.type_name)
        match resolved:
            Ok(value_type):
                parameters = parameters.append({
                    value_type = value_type,
                    span = parameter.type_name.type_span(),
                })
            Err(error):
                failure = Some(error)
                break
    _: Void ?= match failure:
        Some(error): Err(error)
        None: Ok(void)
    self = type_parameter_id(TraitDeclaration(owner), 0)
    _: Void ?= match parameters:
        [value, ..._]:
            if value.value_type == ParameterType(self):
                Ok(void)
            else:
                Err(trait_error(value.span, FirstParameterMustBeSelf(row.id)))
        []:
            Err(trait_error(header.function_name.span, FirstParameterMustBeSelf(row.id)))
    result ?= match header.return_type:
        Some(written): scope.resolve_type(written)
        None: Ok(VoidType)
    result_span = match header.return_type:
        Some(written): written.type_span()
        None: header.function_name.span
    unique ?= row.id.unique_requirement_parameters(header)
    default_body: Option[FunctionId] = match row.declaration:
        RequiredMethod(_): None
        DefaultMethod(function): Some(function)
    Ok({
        id = row.id,
        default_body = default_body,
        signature = {
            type_parameters = [self],
            requirements = [],
            purity = Pure,
            parameters = parameters,
            return_type = { value_type = result, span = result_span },
        },
    })


private pure func accept_trait(
    row: TraitRow,
    parsed: ParsedContents,
    namespace: Namespace,
) -> Result[AcceptedTrait, CheckError]:
    self = type_parameter_id(TraitDeclaration(row.id), 0)
    scope: TypeScope = {
        records = parsed.declarations.inventory_records(),
        unions = parsed.declarations.inventory_unions(),
        opaques = parsed.declarations.inventory_opaques(),
        namespace = namespace,
        module = row.module,
        access = type_access(row.visibility, row.type_name.id),
        parameters = [],
        self_binding = Some({
            name = parsed.names.contextual_words().self_word,
            value_type = ParameterType(self),
        }),
    }
    var supertraits: List[LocatedTrait] = []
    var failure: Option[CheckError] = None
    for written in row.supertraits:
        span = written.type_span()
        match namespace.resolve_trait(row.module, written):
            None:
                failure = Some(trait_error(span, SupertraitUnknown))
            Some(id):
                -- A public trait may not name a private supertrait, which code
                -- outside its module could bound by but never implement.
                hidden: Option[NameId] = match (
                    row.visibility,
                    parsed.declarations
                        .inventory_traits()
                        .get(id.trait_number()),
                ):
                    (Public, Some(named)):
                        match named.visibility:
                            Private(_): Some(named.type_name.id)
                            Public: None
                    _:
                        None
                match hidden:
                    Some(name):
                        failure = Some(
                            type_term_error(
                                span,
                                PrivateTypeInPublicDeclaration(name, row.type_name.id),
                            ),
                        )
                    None:
                        supertraits = supertraits.append({ required_trait = id, span = span })
        if failure.is_some():
            break
    var methods: List[AcceptedTraitMethod] = []
    if failure.is_none():
        for method in row.methods:
            match method.requirement(scope, row.id, parsed):
                Ok(accepted):
                    methods = methods.append(accepted)
                Err(error):
                    failure = Some(error)
                    break
    _: Void ?= match failure:
        Some(error): Err(error)
        None: Ok(void)
    Ok({ id = row.id, supertraits = supertraits, methods = methods })


-- Walks up from `root`; `walked` ends at `current`. An edge back to the root
-- closes a cycle, reported at that edge with the walk. A trait already on the
-- walk ends it: that cycle is reported from its own traits' walks.
private pure func supertrait_cycle(
    traits: List[AcceptedTrait],
    root: TraitId,
    current: TraitId,
    walked: List[TraitId],
) -> Result[Void, CheckError]:
    var failure: Option[CheckError] = None
    for supertrait in traits.direct_supertraits(current):
        next = supertrait.required_trait
        if failure.is_none():
            if next == root:
                failure = Some(trait_error(supertrait.span, SupertraitCycle(walked.append(next))))
            else if (
                walked
                    .any(pure func(earlier): earlier == next)
                    .not()
            ):
                match traits.supertrait_cycle(root, next, walked.append(next)):
                    Ok(_): void
                    Err(error): failure = Some(error)
    match failure:
        Some(error): Err(error)
        None: Ok(void)


-- Every issued TraitId has its accepted row, so the `None` arm never runs.
private pure func direct_supertraits(
    traits: List[AcceptedTrait],
    id: TraitId,
) -> List[LocatedTrait]:
    match traits.get(id.trait_number()):
        Some(accepted): accepted.supertraits
        None: []


-- A held bound proves itself and every trait above it. Acceptance rejects
-- supertrait cycles before any proof runs, so the walk ends.
pure func entails(traits: List[AcceptedTrait], held: TraitId, required: TraitId) -> Bool:
    if held == required:
        True
    else:
        traits
            .direct_supertraits(held)
            .any(pure func(supertrait): traits.entails(supertrait.required_trait, required))


private pure func canonical_header(
    row: TraitRow,
    method: TraitMethodId,
    parsed: ParsedContents,
) -> Result[FunctionHeader, CheckError]:
    written ?= row.methods
        .get(method.trait_method_number())
        .or_checker_invariant(row.type_name.span, InvalidFunctionContract)
    written
        .trait_method_header(parsed.declarations)
        .or_checker_invariant(row.type_name.span, InvalidFunctionContract)


-- The parameter and result types a canonical member must have. Each canonical
-- trait builds its shapes from its own Self, so admission compares types and
-- never a member's spelling.
private record MemberShape { parameters: List[TypeRef], result: TypeRef }


-- The shape of a member that compares two Self values and answers Bool.
private pure func binary_predicate(
    self: TypeRef,
    boolean: DesignatedBoolean[VariantId],
) -> MemberShape:
    {
        parameters = [self, self],
        result = NominalType(
            AggregateNominal(UnionAggregate(boolean.true_variant.variant_owner())),
            [],
        ),
    }


-- The shape of an arithmetic member: `(Self, Self) -> Self`, or
-- `(Self) -> Self` for negation.
private pure func binary_operation(self: TypeRef) -> MemberShape:
    { parameters = [self, self], result = self }


private pure func unary_operation(self: TypeRef) -> MemberShape:
    { parameters = [self], result = self }


private pure func has_shape(method: AcceptedTraitMethod, shape: MemberShape) -> Bool:
    (method.signature.parameters.map(pure func(parameter): parameter.value_type) == shape.parameters).and(
        method.signature.return_type.value_type == shape.result,
    )


-- A reserved member found by its spelling, with the name span diagnostics cite.
private record CanonicalMember { method: AcceptedTraitMethod, span: Span }


-- The namespace rejects two methods with one name in a trait, so the first
-- match is the only one.
private pure func named_member(
    row: TraitRow,
    accepted: AcceptedTrait,
    parsed: ParsedContents,
    word: NameId,
) -> Result[Option[CanonicalMember], CheckError]:
    var found: Option[CanonicalMember] = None
    var failure: Option[CheckError] = None
    for method in accepted.methods:
        match row.canonical_header(method.id, parsed):
            Err(error):
                failure = Some(error)
                break
            Ok(header):
                if header.function_name.id == word:
                    found = Some({ method = method, span = header.function_name.span })
                    break
    match failure:
        Some(error): Err(error)
        None: Ok(found)


-- Ordinary method signatures have already succeeded. A canonical trait's sole
-- abstract method is its one required member.
private pure func sole_abstract(
    row: TraitRow,
    accepted: AcceptedTrait,
    parsed: ParsedContents,
    family: CanonicalFamily,
    word: NameId,
    shape: MemberShape,
) -> Result[TraitMethodId, CheckError]:
    match accepted.methods.filter(pure func(method): method.default_body.is_none()):
        [method]:
            match row.canonical_header(method.id, parsed):
                Ok(header):
                    if (header.function_name.id == word).and(method.has_shape(shape)):
                        Ok(method.id)
                    else:
                        Err(
                            trait_error(
                                row.type_name.span,
                                MalformedCanonicalTrait(family, row.id),
                            ),
                        )
                Err(error):
                    Err(error)
        _:
            Err(trait_error(row.type_name.span, MalformedCanonicalTrait(family, row.id)))


-- A reserved member other than the abstract one is either absent or a default.
private pure func default_member(
    row: TraitRow,
    accepted: AcceptedTrait,
    parsed: ParsedContents,
    family: ComparisonTrait,
    word: NameId,
    shape: MemberShape,
) -> Result[Option[TraitMethodId], CheckError]:
    found ?= row.named_member(accepted, parsed, word)
    match found:
        None:
            Ok(None)
        Some(member):
            if (
                member.method.default_body
                    .is_some()
                    .and(member.method.has_shape(shape))
            ):
                Ok(Some(member.method.id))
            else:
                Err(trait_error(member.span, MalformedCanonicalMember(family, word)))


-- The sole abstract equals contract precedes validation of an optional
-- reserved inequality default.
private pure func accept_equality(
    row: TraitRow,
    accepted: AcceptedTrait,
    parsed: ParsedContents,
    boolean: DesignatedBoolean[VariantId],
) -> Result[CanonicalEquality, CheckError]:
    -- Automatic implementations require no other trait, so a supertrait would
    -- make every derived equality fail its obligation.
    _: Void ?= match accepted.supertraits:
        [first, ..._]: Err(trait_error(first.span, CanonicalEquatableSupertraits))
        []: Ok(void)
    self: TypeRef = ParameterType(type_parameter_id(TraitDeclaration(row.id), 0))
    shape = self.binary_predicate(boolean)
    words = parsed.names.foundation_words()
    equals ?= row.sole_abstract(
        accepted,
        parsed,
        ComparisonFamily(EquatableTrait),
        words.equals_word,
        shape,
    )
    not_equals ?= row.default_member(accepted, parsed, EquatableTrait, words.not_equals_word, shape)
    Ok(canonical_equality(equals, not_equals))


-- Every ordering operator calls its own member, so all three defaults are
-- required; a missing one is reported at the trait's name.
private pure func required_default(
    row: TraitRow,
    accepted: AcceptedTrait,
    parsed: ParsedContents,
    word: NameId,
    shape: MemberShape,
) -> Result[TraitMethodId, CheckError]:
    found ?= row.default_member(accepted, parsed, OrderableTrait, word, shape)
    match found:
        Some(present): Ok(present)
        None: Err(trait_error(row.type_name.span, MalformedCanonicalMember(OrderableTrait, word)))


private pure func accept_ordering(
    row: TraitRow,
    accepted: AcceptedTrait,
    parsed: ParsedContents,
    boolean: DesignatedBoolean[VariantId],
) -> Result[CanonicalOrdering, CheckError]:
    self: TypeRef = ParameterType(type_parameter_id(TraitDeclaration(row.id), 0))
    shape = self.binary_predicate(boolean)
    words = parsed.names.foundation_words()
    less_than ?= row.sole_abstract(
        accepted,
        parsed,
        ComparisonFamily(OrderableTrait),
        words.less_than_word,
        shape,
    )
    greater_than ?= row.required_default(accepted, parsed, words.greater_than_word, shape)
    less_than_or_equal ?= row.required_default(
        accepted,
        parsed,
        words.less_than_or_equal_word,
        shape,
    )
    greater_than_or_equal ?= row.required_default(
        accepted,
        parsed,
        words.greater_than_or_equal_word,
        shape,
    )
    Ok(canonical_ordering(less_than, greater_than, less_than_or_equal, greater_than_or_equal))


-- An arithmetic trait, the trait the prelude selects for it, and its member's word.
private record ArithmeticDesignation {
    arithmetic: ArithmeticTrait,
    designated: Option[TraitId],
    member: NameId,
}


-- An arithmetic trait's one member is its sole abstract method. As for
-- Equatable and Orderable, defaults and supertraits beside it are admitted.
private pure func accept_arithmetic(
    row: TraitRow,
    accepted: AcceptedTrait,
    parsed: ParsedContents,
    designation: ArithmeticDesignation,
) -> Result[CanonicalOperation, CheckError]:
    self: TypeRef = ParameterType(type_parameter_id(TraitDeclaration(row.id), 0))
    shape = match designation.arithmetic:
        NegatableTrait:
            self.unary_operation()
        AddableTrait | SubtractableTrait | MultipliableTrait | DivisibleTrait | ModulableTrait:
            self.binary_operation()
    member ?= row.sole_abstract(
        accepted,
        parsed,
        ArithmeticFamily(designation.arithmetic),
        designation.member,
        shape,
    )
    Ok(canonical_operation(member))


private pure func receiver_module(receiver: TypeHead, parsed: ParsedContents) -> Option[ModuleId]:
    match receiver:
        PrimitiveHead(_) | ListHead:
            Some(parsed.foundation.types)
        RecordHead(id):
            parsed.declarations
                .inventory_records()
                .get(id.record_number())
                .map(pure func(owner): owner.declaration.module)
        UnionHead(id):
            parsed.declarations
                .inventory_unions()
                .get(id.union_number())
                .map(pure func(owner): owner.module)
        OpaqueHead(id):
            parsed.declarations
                .inventory_opaques()
                .get(id.opaque_number())
                .map(pure func(owner): owner.declaration.module)


private pure func accept_implementation(
    row: ImplRow,
    header: ImplementationHeader,
    parsed: ParsedContents,
    namespace: Namespace,
    traits: List[AcceptedTrait],
    functions: List[AcceptedFunction],
    previous: List[AcceptedImplementation],
    canonical: Option[TraitId],
) -> Result[AcceptedImplementation, CheckError]:
    owner ?= namespace
        .implementation_trait(row.header.module, row.id)
        .or_checker_invariant(row.header.span, InvalidFunctionContract)
    written ?= parsed.declarations
        .inventory_traits()
        .get(owner.trait_number())
        .or_checker_invariant(row.header.span, InvalidFunctionContract)
    declaration ?= traits
        .get(owner.trait_number())
        .or_checker_invariant(row.header.span, InvalidFunctionContract)
    receiver_owner = header.receiver_head.receiver_module(parsed)
    own_receiver = match receiver_owner:
        Some(module): module == row.header.module
        None: False
    foundation_receiver = match receiver_owner:
        Some(module): module == parsed.foundation.types
        None: False
    canonical_library: Bool = match canonical:
        Some(selected):
            if selected == owner:
                match parsed.modules.get(written.module.module_number()):
                    Some(module):
                        match module.role:
                            LibraryModule: True
                            _: False
                    None:
                        False
            else:
                False
        None:
            False
    library = match parsed.modules.get(row.header.module.module_number()):
        Some(module):
            match module.role:
                LibraryModule:
                    foundation_receiver.and(
                        (written.module == parsed.foundation.types).or(canonical_library),
                    )
                _:
                    False
        None:
            False
    _: Void ?= if (written.module == row.header.module).or(own_receiver.or(library)):
        Ok(void)
    else:
        Err(trait_error(row.header.span, OrphanImplementation(owner, header.receiver_head)))
    var failure: Option[CheckError] = None
    for existing in previous:
        if (existing.trait_id == owner).and(existing.receiver_head == header.receiver_head):
            failure = Some(
                trait_error(
                    row.header.span,
                    DuplicateImplementation(owner, header.receiver_head, existing.span),
                ),
            )
            break
    var members: List[ImplementedMethod] = []
    var seen: List[AcceptedFunction] = []
    for body in row.methods:
        if failure.is_some():
            break
        match functions.get(body.function_number()):
            Some(function):
                var method: Option[AcceptedTraitMethod] = None
                for required in declaration.methods:
                    match written.methods.get(required.id.trait_method_number()):
                        Some(source):
                            match source.trait_method_header(parsed.declarations):
                                Some(source_header):
                                    if (
                                        source_header.function_name.id
                                        == function.declaration.function_name.id
                                    ):
                                        method = Some(required)
                                None:
                                    failure = Some(
                                        checker_invariant(source.span, InvalidFunctionContract),
                                    )
                        None:
                            failure = Some(
                                checker_invariant(row.header.span, InvalidFunctionContract),
                            )
                for earlier in seen:
                    if (
                        earlier.declaration.function_name.id
                        == function.declaration.function_name.id
                    ):
                        failure = Some(
                            trait_error(
                                function.declaration.function_name.span,
                                DuplicateImplementationMethod(
                                    function.declaration.function_name.id,
                                    earlier.declaration.function_name.span,
                                ),
                            ),
                        )
                if failure.is_none():
                    match method:
                        None:
                            name = function.declaration.function_name
                            failure = match traits.supertrait_declaring(
                                parsed.declarations,
                                owner,
                                name.id,
                            ):
                                Some(supertrait):
                                    Some(
                                        trait_error(
                                            name.span,
                                            SupertraitMethodInImplementation(
                                                name.id,
                                                supertrait,
                                                row.header.receiver,
                                            ),
                                        ),
                                    )
                                None:
                                    Some(
                                        trait_error(
                                            name.span,
                                            UnknownImplementationMethod(name.id),
                                        ),
                                    )
                        Some(required):
                            match required.member_contract(header, function):
                                Err(error):
                                    failure = Some(error)
                                Ok(_):
                                    member: ImplementedMethod = {
                                        method = required.id,
                                        body = AuthoredMethod(body),
                                    }
                                    members = members.append(member)
                seen = seen.append(function)
            None:
                failure = Some(checker_invariant(row.header.span, InvalidFunctionContract))
        if failure.is_some():
            break
    for required in declaration.methods:
        implemented = members.any(pure func(member): member.method == required.id)
        if (
            implemented
                .not()
                .and(failure.is_none())
        ):
            match required.default_body:
                Some(function):
                    members = members.append({
                        method = required.id,
                        body = TraitDefault(function),
                    })
                None:
                    failure = Some(
                        trait_error(row.header.span, MissingImplementationMethod(required.id)),
                    )
    match failure:
        Some(error):
            Err(error)
        None:
            Ok({
                trait_id = owner,
                receiver_head = header.receiver_head,
                parameter_bounds = header.parameter_bounds,
                methods = members,
                method_provider = Some(row.header.module),
                span = row.header.span,
            })


-- The supertrait, direct or further up, that declares a method named `name`.
-- The implemented trait itself does not, or the method would have matched.
private pure func supertrait_declaring(
    traits: List[AcceptedTrait],
    inventory: DeclarationInventory,
    owner: TraitId,
    name: NameId,
) -> Option[TraitId]:
    inventory
        .inventory_traits()
        .find(pure func(row) -> Bool:
            declares = row.methods.any(pure func(method) -> Bool:
                match method.trait_method_header(inventory):
                    Some(header): header.function_name.id == name
                    None: False
            )
            declares.and(traits.entails(owner, row.id))
        )
        .map(pure func(row): row.id)


private pure func member_contract(
    required: AcceptedTraitMethod,
    header: ImplementationHeader,
    function: AcceptedFunction,
) -> Result[Void, CheckError]:
    receiver ?= receiver_type(
        header.receiver_head,
        function.signature.type_parameters.map(pure func(parameter): ParameterType(parameter)),
    ).or_checker_invariant(function.declaration.function_name.span, InvalidFunctionContract)
    substitution: Substitution = {
        owner = TraitDeclaration(required.id.trait_method_owner()),
        values = [receiver],
    }
    var parameters: List[TypeUse] = []
    var failure: Option[CheckError] = None
    for parameter in required.signature.parameters:
        match parameter.value_type.substitute_type(substitution, parameter.span):
            Ok(value_type):
                parameters = parameters.append({ parameter | value_type = value_type })
            Err(error):
                failure = Some(error)
                break
    _: Void ?= match failure:
        Some(error): Err(error)
        None: Ok(void)
    result ?= required.signature.return_type.value_type.substitute_type(
        substitution,
        required.signature.return_type.span,
    )
    expected: FunctionSignature = {
        type_parameters = function.signature.type_parameters,
        requirements = function.signature.requirements,
        purity = required.signature.purity,
        parameters = parameters,
        return_type = { required.signature.return_type | value_type = result },
    }
    parameter_types = parameters.map(pure func(parameter): parameter.value_type)
    actual_types = function.signature.parameters.map(pure func(parameter): parameter.value_type)
    valid = (function.signature.type_parameters.length() == header.parameter_bounds.length()).and(
        (expected.purity == function.signature.purity).and(
            (parameter_types == actual_types).and(
                result == function.signature.return_type.value_type,
            ),
        ),
    )
    if valid:
        Ok(void)
    else:
        Err(
            trait_error(
                function.declaration.function_name.span,
                ImplementationSignatureMismatch(required.id, expected, function.signature),
            ),
        )


-- The configured prelude selects each canonical trait, named by a foundation
-- word, through its ordinary binding. Later shape checking and dispatch compare
-- the accepted TraitId.
pure func designated_trait(
    parsed: ParsedContents,
    namespace: Namespace,
    word: NameId,
) -> Option[TraitId]:
    namespace.named_trait(parsed.foundation.prelude, word)


-- A pure function `module` itself declares, public or not; an import never
-- counts. A literal is pure, so pure code may write one.
private pure func declared_function(
    parsed: ParsedContents,
    namespace: Namespace,
    module: ModuleId,
    word: NameId,
) -> Option[FunctionId]:
    match namespace.named_value(module, word):
        Some(NamedFunction(id, DeclaredHere)):
            match (
                parsed.declarations
                    .inventory_functions()
                    .get(id.function_number())
            ):
                Some(row):
                    if row.declaration.purity == Pure:
                        Some(id)
                    else:
                        None
                None:
                    None
        _:
            None


-- The prelude selects Dict through its ordinary binding, and a literal calls
-- the functions Dict's own module declares, so no name in the literal's
-- scope can stand in. A prelude without an opaque Dict offers no literals.
private pure func dict_literal_functions(
    parsed: ParsedContents,
    namespace: Namespace,
) -> Option[DictLiteralFunctions]:
    words = parsed.names.foundation_words()
    declaring: Option[ModuleId] = match (
        namespace
            .named_type(parsed.foundation.prelude, words.dict_word)
            .map(pure func(named): named.head)
    ):
        Some(OpaqueHead(id)):
            parsed.declarations
                .inventory_opaques()
                .get(id.opaque_number())
                .map(pure func(row): row.declaration.module)
        _:
            None
    match declaring:
        None:
            None
        Some(module):
            match (
                parsed.declared_function(namespace, module, words.empty_word),
                parsed.declared_function(namespace, module, words.dict_function_word),
                parsed.declared_function(namespace, module, words.set_word),
            ):
                (Some(empty), Some(dict), Some(set)):
                    Some({ empty = empty, dict = dict, set = set })
                _:
                    None


private pure func designates(designated: Option[TraitId], row: TraitRow) -> Bool:
    match designated:
        Some(owner): owner == row.id
        None: False


-- Each designated trait is admitted by its own contract. Once every trait is
-- accepted, supertrait cycles are rejected, before any proof walks them.
pure func accept_trait_contracts(
    parsed: ParsedContents,
    namespace: Namespace,
    boolean: DesignatedBoolean[VariantId],
) -> Result[AcceptedTraitContracts, CheckError]:
    words = parsed.names.foundation_words()
    equality = parsed.designated_trait(namespace, words.equatable_word)
    ordering = parsed.designated_trait(namespace, words.orderable_word)
    arithmetic: List[ArithmeticDesignation] = [
        {
            arithmetic = AddableTrait,
            designated = parsed.designated_trait(namespace, words.addable_word),
            member = words.add_word,
        },
        {
            arithmetic = SubtractableTrait,
            designated = parsed.designated_trait(namespace, words.subtractable_word),
            member = words.subtract_word,
        },
        {
            arithmetic = MultipliableTrait,
            designated = parsed.designated_trait(namespace, words.multipliable_word),
            member = words.multiply_word,
        },
        {
            arithmetic = DivisibleTrait,
            designated = parsed.designated_trait(namespace, words.divisible_word),
            member = words.divide_word,
        },
        {
            arithmetic = ModulableTrait,
            designated = parsed.designated_trait(namespace, words.modulable_word),
            member = words.remainder_word,
        },
        {
            arithmetic = NegatableTrait,
            designated = parsed.designated_trait(namespace, words.negatable_word),
            member = words.negate_word,
        },
    ]
    var canonical: CanonicalContracts = {
        equality = None,
        ordering = None,
        addition = None,
        subtraction = None,
        multiplication = None,
        division = None,
        remainder = None,
        negation = None,
        dict_literal = parsed.dict_literal_functions(namespace),
    }
    var declarations: List[AcceptedTrait] = []
    var failure: Option[CheckError] = None
    for row in parsed.declarations.inventory_traits():
        match row.accept_trait(parsed, namespace):
            Ok(accepted):
                declarations = declarations.append(accepted)
                if designates(equality, row):
                    match row.accept_equality(accepted, parsed, boolean):
                        Ok(contract): canonical = { canonical | equality = Some(contract) }
                        Err(error): failure = Some(error)
                if (
                    failure
                        .is_none()
                        .and(designates(ordering, row))
                ):
                    match row.accept_ordering(accepted, parsed, boolean):
                        Ok(contract): canonical = { canonical | ordering = Some(contract) }
                        Err(error): failure = Some(error)
                for designation in arithmetic:
                    if (
                        failure
                            .is_none()
                            .and(designates(designation.designated, row))
                    ):
                        match row.accept_arithmetic(accepted, parsed, designation):
                            Err(error):
                                failure = Some(error)
                            Ok(operation):
                                match designation.arithmetic:
                                    AddableTrait:
                                        canonical = { canonical | addition = Some(operation) }
                                    SubtractableTrait:
                                        canonical = { canonical | subtraction = Some(operation) }
                                    MultipliableTrait:
                                        canonical = { canonical | multiplication = Some(operation) }
                                    DivisibleTrait:
                                        canonical = { canonical | division = Some(operation) }
                                    ModulableTrait:
                                        canonical = { canonical | remainder = Some(operation) }
                                    NegatableTrait:
                                        canonical = { canonical | negation = Some(operation) }
            Err(error):
                failure = Some(error)
        if failure.is_some():
            break
    for accepted in declarations:
        if failure.is_none():
            match declarations.supertrait_cycle(accepted.id, accepted.id, [accepted.id]):
                Ok(_): void
                Err(error): failure = Some(error)
    match failure:
        Some(error): Err(error)
        None: Ok({ declarations = declarations, canonical = canonical })


-- Accepted rows always satisfy the table's invariants; a rejection is a
-- checker fault.
pure func checked_implementation_table(
    rows: List[AcceptedImplementation],
) -> Result[ImplementationTable, CheckError]:
    implementation_table(rows).or_checker_invariant(compiler_span(), InvalidFunctionContract)


-- Method contracts are already accepted. Authored implementation signatures
-- and default identities now complete this same authority without reacceptance.
pure func validate_implementations(
    parsed: ParsedContents,
    namespace: Namespace,
    headers: List[ImplementationHeader],
    functions: List[AcceptedFunction],
    contracts: AcceptedTraitContracts,
) -> Result[AcceptedTraits, CheckError]:
    canonical: Option[TraitId] = match contracts.canonical.equality:
        Some(contract): Some(contract.canonical_owner())
        None: None
    var implementations: List[AcceptedImplementation] = []
    var failure: Option[CheckError] = None
    for row in parsed.declarations.inventory_implementations():
        match headers.get(row.id.impl_number()):
            Some(header):
                match row.accept_implementation(
                    header,
                    parsed,
                    namespace,
                    contracts.declarations,
                    functions,
                    implementations,
                    canonical,
                ):
                    Ok(accepted): implementations = implementations.append(accepted)
                    Err(error): failure = Some(error)
            None:
                failure = Some(checker_invariant(row.header.span, InvalidFunctionContract))
        if failure.is_some():
            break
    table: ImplementationTable ?= match failure:
        Some(error): Err(error)
        None: implementations.checked_implementation_table()
    Ok({
        declarations = contracts.declarations,
        implementations = table,
        canonical = contracts.canonical,
    })


-- Abstract signatures have no body owner. Check their formal names only after
-- all annotations resolve, without manufacturing local binding identities.
private pure func unique_requirement_parameters(
    method: TraitMethodId,
    header: FunctionHeader,
) -> Result[Void, CheckError]:
    var names: List[WrittenName] = []
    var failure: Option[CheckError] = None
    for parameter in header.parameters:
        match names.previous_declaration(parameter.name.id):
            Some(previous):
                failure = Some(
                    trait_error(
                        parameter.name.span,
                        DuplicateRequirementParameter(method, previous),
                    ),
                )
                break
            None:
                names = names.append(parameter.name)
    match failure:
        Some(error): Err(error)
        None: Ok(void)


-- A rigid parameter is justified only by its declaration. A family checks each
-- bound on a strict child of the actual receiver, so proof always terminates.
pure func prove_trait(
    availability: TraitAvailability,
    required: TraitId,
    receiver: TypeRef,
    assumptions: List[TraitRequirement],
    span: Span,
) -> Result[Void, CheckError]:
    match receiver:
        ParameterType(parameter):
            traits = availability.accepted_traits().declarations
            known = assumptions.any(
                pure func(assumption): (assumption.parameter == parameter).and(
                    traits.entails(assumption.required_trait, required),
                ),
            )
            if known:
                Ok(void)
            else:
                Err(trait_error(span, MissingTraitBound(required, receiver)))
        _:
            availability.prove_family(required, receiver, assumptions, span)


private pure func prove_family(
    availability: TraitAvailability,
    required: TraitId,
    receiver: TypeRef,
    assumptions: List[TraitRequirement],
    span: Span,
) -> Result[Void, CheckError]:
    traits = availability.accepted_traits()
    head: TypeHead ?= match receiver.type_head():
        Some(present): Ok(present)
        None: Err(trait_error(span, MissingTraitBound(required, receiver)))
    family = traits.family_for(required, head)
    selected: Result[AcceptedImplementation, CheckError] = match family:
        Some(implementation):
            Ok(implementation)
        None:
            rejection: CheckError = match availability.equality_error(required, receiver, span):
                Some(error): error
                None: trait_error(span, MissingTraitBound(required, receiver))
            Err(rejection)
    accepted ?= selected
    arguments = receiver.receiver_arguments()
    var position = 0
    var failure: Option[CheckError] = None
    for bounds in accepted.parameter_bounds:
        match arguments.get(position):
            None:
                failure = Some(checker_invariant(span, InvalidFunctionContract))
            Some(argument):
                for bound in bounds:
                    match availability.prove_trait(
                        bound.required_trait,
                        argument,
                        assumptions,
                        span,
                    ):
                        Ok(_):
                            void
                        Err(error):
                            failure = Some(error)
                            break
        position = position + 1
        if failure.is_some():
            break
    match failure:
        Some(error): Err(error)
        None: Ok(void)


-- Source construction seals a callable's obligations. Invoking a stored or
-- forwarded callable later consumes that sealed callable type without reproving.
pure func prove_requirements(
    availability: TraitAvailability,
    signature: FunctionSignature,
    arguments: List[TypeRef],
    assumptions: List[TraitRequirement],
    span: Span,
) -> Result[Void, CheckError]:
    var failure: Option[CheckError] = None
    for required in signature.requirements:
        substitution: Substitution = {
            owner = required.parameter.parameter_owner(),
            values = arguments,
        }
        match substitute_type(ParameterType(required.parameter), substitution, span):
            Err(error):
                failure = Some(error)
            Ok(receiver):
                match availability.prove_trait(
                    required.required_trait,
                    receiver,
                    assumptions,
                    span,
                ):
                    Ok(_): void
                    Err(error): failure = Some(error)
        if failure.is_some():
            break
    match failure:
        Some(error): Err(error)
        None: Ok(void)


-- Negative causes are checker-local. Successful publication keeps only the
-- same accepted view; no partially supported body or proof cache escapes.
private record EqualityUnavailable {
    aggregate: AggregateId,
    member: EqualityMember,
    required_trait: TraitId,
    receiver: TypeRef,
}


-- `declarations` carries the written bounds that every application of a
-- record, union or opaque type proves. It is borrowed, not copied, and lives
-- here because proving those bounds is trait proof: body freezing, which
-- proves an `into_opaque` value's bounds, receives only this availability.
private record AvailabilityContents {
    accepted: AcceptedTraits,
    unavailable: List[EqualityUnavailable],
    declarations: CheckedDeclarations,
}


opaque type TraitAvailability = AvailabilityContents


pure func accepted_traits(availability: TraitAvailability) -> AcceptedTraits:
    from_opaque TraitAvailability(availability).accepted


-- Signature-only test observers may deliberately have no derivation candidates
-- and no declarations.
pure func authored_traits(traits: AcceptedTraits) -> TraitAvailability:
    into_opaque TraitAvailability({
        accepted = traits,
        unavailable = [],
        declarations = { unions = [], records = [], opaques = [] },
    })


-- The written bounds of the declaration a nominal type names.
pure func declared_requirements(
    availability: TraitAvailability,
    owner: NominalId,
) -> Option[List[TraitRequirement]]:
    declarations = from_opaque TraitAvailability(availability).declarations
    match owner:
        AggregateNominal(RecordAggregate(id)):
            declarations.records
                .get(id.record_number())
                .map(pure func(row): row.requirements)
        AggregateNominal(UnionAggregate(id)):
            declarations.unions
                .get(id.union_number())
                .map(pure func(row): row.requirements)
        OpaqueNominal(id):
            declarations.opaques
                .get(id.opaque_number())
                .map(pure func(row): row.requirements)


-- The member whose requirement made a head's automatic equality unavailable.
pure func unavailable_equality_member(
    availability: TraitAvailability,
    head: TypeHead,
) -> Option[EqualityMember]:
    from_opaque TraitAvailability(availability).unavailable
        .find(pure func(failure): failure.aggregate.aggregate_head() == head)
        .map(pure func(failure): failure.member)


-- Each candidate owns only its actual member requirements. Recursive goals
-- read the preceding round's summary, substituting real ordered arguments;
-- they never recursively reopen another declaration's fields.
private record EqualityCandidate { aggregate: AggregateId, requirements: List[TraitRequirement] }


private record EqualitySummary {
    requirements: List[TraitRequirement],
    failure: Option[EqualityUnavailable],
}


private pure func summarize_goal(
    traits: AcceptedTraits,
    required: TraitId,
    receiver: TypeRef,
    possible: List[EqualityCandidate],
    owner: AggregateId,
    member: EqualityMember,
    summary: EqualitySummary,
    span: Span,
) -> Result[EqualitySummary, CheckError]:
    match receiver:
        ParameterType(parameter):
            if parameter.parameter_owner() == owner.aggregate_owner():
                var requirements = summary.requirements
                var known: Bool = False
                var position = 0
                for bound in requirements:
                    if (bound.parameter == parameter).and(bound.required_trait == required):
                        known = True
                        -- Both spans are this aggregate's own member annotations.
                        -- Preserve atom order; refine only its outer provenance.
                        if span.start < bound.span.start:
                            requirements = requirements.set(position, { bound | span = span })
                        break
                    position = position + 1
                if known:
                    Ok({ summary | requirements = requirements })
                else:
                    inferred: TraitRequirement = {
                        parameter = parameter,
                        required_trait = required,
                        span = span,
                    }
                    Ok({ summary | requirements = requirements.append(inferred) })
            else:
                Err(checker_invariant(span, InvalidFunctionContract))
        _:
            traits.summarize_family(required, receiver, possible, owner, member, summary, span)


private pure func summarize_family(
    traits: AcceptedTraits,
    required: TraitId,
    receiver: TypeRef,
    possible: List[EqualityCandidate],
    owner: AggregateId,
    member: EqualityMember,
    summary: EqualitySummary,
    span: Span,
) -> Result[EqualitySummary, CheckError]:
    var result = summary
    var invalid: Option[CheckError] = None
    match receiver.type_head():
        None:
            result = { result |
                failure = Some({
                    aggregate = owner,
                    member = member,
                    required_trait = required,
                    receiver = receiver,
                }),
            }
        Some(head):
            arguments = receiver.receiver_arguments()
            match traits.family_for(required, head):
                Some(family):
                    var position = 0
                    for bounds in family.parameter_bounds:
                        match arguments.get(position):
                            Some(argument):
                                for bound in bounds:
                                    match traits.summarize_goal(
                                        bound.required_trait,
                                        argument,
                                        possible,
                                        owner,
                                        member,
                                        result,
                                        span,
                                    ):
                                        Ok(updated): result = updated
                                        Err(error): invalid = Some(error)
                                    if (
                                        result.failure
                                            .is_some()
                                            .or(invalid.is_some())
                                    ):
                                        break
                            None:
                                invalid = Some(checker_invariant(span, InvalidFunctionContract))
                        if (
                            result.failure
                                .is_some()
                                .or(invalid.is_some())
                        ):
                            break
                        position = position + 1
                None:
                    var provisional: Option[EqualityCandidate] = None
                    canonical: Bool = match traits.canonical.equality:
                        Some(canonical): canonical.canonical_owner() == required
                        None: False
                    if canonical:
                        -- `possible` holds one candidate per aggregate: complete_equality_availability
                        -- appends one per record and union row, and each round only filters it, so
                        -- heads are unique and the first head match is the only one.
                        for candidate in possible:
                            if candidate.aggregate.aggregate_head() == head:
                                provisional = Some(candidate)
                                break
                    match provisional:
                        None:
                            result = { result |
                                failure = Some({
                                    aggregate = owner,
                                    member = member,
                                    required_trait = required,
                                    receiver = receiver,
                                }),
                            }
                        Some(candidate):
                            substitution: Substitution = {
                                owner = candidate.aggregate.aggregate_owner(),
                                values = arguments,
                            }
                            for bound in candidate.requirements:
                                match substitute_type(
                                    ParameterType(bound.parameter),
                                    substitution,
                                    span,
                                ):
                                    Err(error):
                                        invalid = Some(error)
                                    Ok(argument):
                                        match traits.summarize_goal(
                                            bound.required_trait,
                                            argument,
                                            possible,
                                            owner,
                                            member,
                                            result,
                                            span,
                                        ):
                                            Ok(updated): result = updated
                                            Err(error): invalid = Some(error)
                                if (
                                    result.failure
                                        .is_some()
                                        .or(invalid.is_some())
                                ):
                                    break
    match invalid:
        Some(error): Err(error)
        None: Ok(result)


private pure func summarize_members(
    traits: AcceptedTraits,
    required: TraitId,
    candidate: EqualityCandidate,
    records: List[CheckedRecord],
    unions: List[CheckedUnion],
    possible: List[EqualityCandidate],
) -> Result[EqualitySummary, CheckError]:
    -- Atom order is first-established and never oscillates through recursive
    -- summaries. The written member walk can refine an atom's earlier span.
    var summary: EqualitySummary = { requirements = candidate.requirements, failure = None }
    var invalid: Option[CheckError] = None
    match candidate.aggregate:
        RecordAggregate(record_row):
            match records.get(record_row.record_number()):
                Some(row):
                    for field in row.fields:
                        match traits.summarize_goal(
                            required,
                            field.value_type.value_type,
                            possible,
                            candidate.aggregate,
                            EqualityField(field.id),
                            summary,
                            field.value_type.span,
                        ):
                            Ok(updated): summary = updated
                            Err(error): invalid = Some(error)
                        if (
                            summary.failure
                                .is_some()
                                .or(invalid.is_some())
                        ):
                            break
                None:
                    invalid = Some(checker_invariant(compiler_span(), InvalidFunctionContract))
        UnionAggregate(union_row):
            match unions.get(union_row.union_number()):
                Some(row):
                    for variant in row.variants:
                        var position = 0
                        for field in variant.fields:
                            match traits.summarize_goal(
                                required,
                                field.value_type,
                                possible,
                                candidate.aggregate,
                                EqualityPayload(variant.id, position),
                                summary,
                                field.span,
                            ):
                                Ok(updated): summary = updated
                                Err(error): invalid = Some(error)
                            if (
                                summary.failure
                                    .is_some()
                                    .or(invalid.is_some())
                            ):
                                break
                            position = position + 1
                        if (
                            summary.failure
                                .is_some()
                                .or(invalid.is_some())
                        ):
                            break
                None:
                    invalid = Some(checker_invariant(compiler_span(), InvalidFunctionContract))
    match invalid:
        Some(error): Err(error)
        None: Ok(summary)


pure func prepare_equality_availability(
    parsed: ParsedContents,
    traits: AcceptedTraits,
    declarations: CheckedDeclarations,
    boolean: DesignatedBoolean[VariantId],
) -> Result[TraitAvailability, CheckError]:
    match traits.canonical.equality:
        None:
            Ok(
                into_opaque TraitAvailability({
                    accepted = traits,
                    unavailable = [],
                    declarations = declarations,
                }),
            )
        Some(canonical):
            parsed.complete_equality_availability(
                traits,
                declarations,
                boolean,
                canonical.canonical_owner(),
            )


-- A candidate starts from its declaration's written bounds, which its derived
-- equality keeps, and adds what its members require.
private pure func complete_equality_availability(
    parsed: ParsedContents,
    traits: AcceptedTraits,
    declarations: CheckedDeclarations,
    boolean: DesignatedBoolean[VariantId],
    canonical: TraitId,
) -> Result[TraitAvailability, CheckError]:
    records = declarations.records
    unions = declarations.unions
    var possible: List[EqualityCandidate] = []
    for record_row in records:
        if (
            traits
                .family_for(canonical, RecordHead(record_row.id))
                .is_none()
        ):
            possible = possible.append({
                aggregate = RecordAggregate(record_row.id),
                requirements = record_row.requirements,
            })
    for union_row in unions:
        if (
            traits
                .family_for(canonical, UnionHead(union_row.id))
                .is_none()
        ):
            possible = possible.append({
                aggregate = UnionAggregate(union_row.id),
                requirements = union_row.requirements,
            })
    var unavailable: List[EqualityUnavailable] = []
    var invalid: Option[CheckError] = None
    var changed: Bool = True
    while changed.and(invalid.is_none()):
        changed = False
        var retained: List[EqualityCandidate] = []
        for candidate in possible:
            match traits.summarize_members(canonical, candidate, records, unions, possible):
                Ok(summary):
                    match summary.failure:
                        Some(failure):
                            unavailable = unavailable.append(failure)
                            changed = True
                        None:
                            if summary.requirements.length() != candidate.requirements.length():
                                changed = True
                            retained = retained.append(
                                { candidate | requirements = summary.requirements },
                            )
                Err(error):
                    invalid = Some(error)
                    break
        possible = retained
    _: Void ?= match invalid:
        Some(error): Err(error)
        None: Ok(void)
    contract ?= traits.declarations
        .get(canonical.trait_number())
        .or_checker_invariant(compiler_span(), InvalidFunctionContract)
    written_records = parsed.declarations.inventory_records()
    written_unions = parsed.declarations.inventory_unions()
    var implementations = traits.implementations.implementation_rows()
    var error: Option[CheckError] = None
    for candidate in possible:
        match supported_implementation(
            parsed.names,
            written_records,
            written_unions,
            candidate,
            records,
            unions,
            contract,
            boolean,
            canonical,
        ):
            Ok(implementation):
                implementations = implementations.append(implementation)
            Err(failure):
                error = Some(failure)
                break
    _: Void ?= match error:
        Some(failure): Err(failure)
        None: Ok(void)
    table ?= implementations.checked_implementation_table()
    Ok(
        into_opaque TraitAvailability({
            accepted = { traits | implementations = table },
            unavailable = unavailable,
            declarations = declarations,
        }),
    )


private pure func supported_implementation(
    names: NameTable,
    written_records: List[RecordRow],
    written_unions: List[UnionRow],
    candidate: EqualityCandidate,
    records: List[CheckedRecord],
    unions: List[CheckedUnion],
    contract: AcceptedTrait,
    boolean: DesignatedBoolean[VariantId],
    canonical: TraitId,
) -> Result[AcceptedImplementation, CheckError]:
    aggregate = candidate.aggregate
    name ?= aggregate_name(written_records, written_unions, aggregate)
    span = name.span
    spelling ?= names
        .name_spelling(name.id)
        .or_checker_invariant(span, InvalidFunctionContract)
    declared_parameters: Option[List[TypeParameterId]] = match aggregate:
        RecordAggregate(record_row):
            records
                .get(record_row.record_number())
                .map(pure func(row): row.type_parameters)
        UnionAggregate(union_row):
            unions
                .get(union_row.union_number())
                .map(pure func(row): row.type_parameters)
    parameters ?= declared_parameters.or_checker_invariant(span, InvalidFunctionContract)
    var parameter_bounds: List[List[LocatedTrait]] = []
    for parameter in parameters:
        var bounds: List[LocatedTrait] = []
        for inferred_bound in candidate.requirements:
            if inferred_bound.parameter == parameter:
                bounds = bounds.append({
                    required_trait = inferred_bound.required_trait,
                    span = inferred_bound.span,
                })
        parameter_bounds = parameter_bounds.append(bounds)
    var methods: List[ImplementedMethod] = []
    var error: Option[CheckError] = None
    for method in contract.methods:
        match method.default_body:
            Some(function):
                methods = methods.append({ method = method.id, body = TraitDefault(function) })
            None:
                match aggregate.equality_template(
                    equality_label(spelling),
                    parameters,
                    candidate.requirements,
                    records,
                    unions,
                    method,
                    boolean,
                    span,
                ):
                    Ok(template):
                        methods = methods.append({
                            method = method.id,
                            body = StructuralEquality(aggregate, template),
                        })
                    Err(failure):
                        error = Some(failure)
    _: Void ?= match error:
        Some(failure): Err(failure)
        None: Ok(void)
    Ok({
        trait_id = canonical,
        receiver_head = aggregate.aggregate_head(),
        parameter_bounds = parameter_bounds,
        methods = methods,
        method_provider = None,
        span = span,
    })


private pure func aggregate_name(
    written_records: List[RecordRow],
    written_unions: List[UnionRow],
    aggregate: AggregateId,
) -> Result[WrittenName, CheckError]:
    match aggregate:
        RecordAggregate(record_row):
            match written_records.get(record_row.record_number()):
                Some(row): Ok(row.declaration.type_name)
                None: Err(checker_invariant(compiler_span(), InvalidFunctionContract))
        UnionAggregate(union_row):
            match written_unions.get(union_row.union_number()):
                Some(row): Ok(row.type_name)
                None: Err(checker_invariant(compiler_span(), InvalidFunctionContract))


-- Canonical identity is checked before following checker-local negative
-- causes. Each cause points into an earlier removal round; substitute its
-- aggregate-owned parameters under the actual receiver before following it.
pure func equality_error(
    availability: TraitAvailability,
    required: TraitId,
    receiver: TypeRef,
    span: Span,
) -> Option[CheckError]:
    contents = from_opaque TraitAvailability(availability)
    canonical: Bool = match contents.accepted.canonical.equality:
        Some(owner): owner.canonical_owner() == required
        None: False
    var terminal: Option[EqualityUnavailable] = None
    var current = receiver
    var current_trait = required
    var searching = canonical
    var invalid: Option[CheckError] = None
    while searching:
        searching = False
        match current.type_head():
            None:
                void
            Some(head):
                if current_trait == required:
                    for failure in contents.unavailable:
                        if failure.aggregate.aggregate_head() == head:
                            substitution: Substitution = {
                                owner = failure.aggregate.aggregate_owner(),
                                values = current.receiver_arguments(),
                            }
                            match failure.receiver.substitute_type(substitution, span):
                                Err(error):
                                    invalid = Some(error)
                                Ok(actual):
                                    terminal = Some({ failure | receiver = actual })
                                    current = actual
                                    current_trait = failure.required_trait
                                    searching = True
                            break
    match invalid:
        Some(error):
            Some(error)
        None:
            match terminal:
                None:
                    None
                Some(failure):
                    Some(
                        trait_error(
                            span,
                            EqualityMemberUnsupported(
                                failure.required_trait,
                                failure.receiver,
                                failure.member,
                            ),
                        ),
                    )
