import:
    int: Int methods
    ../../syntax/syntax: Diagnostic, Span, internal_error
    ../lower/lower: ValueId
    ../own/own: OwnerId
    ../specialize/specialize: RecordInstanceId, UnionInstanceId


-- Aggregate worklists hold catalogue indices, not newly issued identities.
union AggregateKind:
    RecordAggregate
    UnionAggregate


union EmissionFailure:
    MissingUnionLayout(UnionInstanceId)
    MissingRecordLayout(RecordInstanceId)
    MissingOwnerType(OwnerId)
    MissingValueType(ValueId)
    MissingRuntimeArgument(ValueId, Int)
    MissingFunctionRow(ValueId)
    MissingJoinTransfer(ValueId)
    MissingSelectionArm(ValueId)
    MissingEnclosingLoop(ValueId)
    StatementOnlyValue(ValueId)
    InvalidOperationShape(ValueId)
    MissingAggregateWorkItem(Int)
    MissingAggregateVisit(AggregateKind, Int)
    CyclicByValueAggregate(AggregateKind, Int)
    MissingAggregateLayout(AggregateKind, Int)
    MissingAggregateMember(AggregateKind, Int, Int)
    MissingUnionPayloadField(Int, Int, Int)
    MissingInPlaceHelper(ValueId)


private pure func aggregate_name(kind: AggregateKind) -> String:
    match kind:
        RecordAggregate: "record"
        UnionAggregate: "union"


pure func render(span: Span, failure: EmissionFailure) -> Diagnostic:
    message = match failure:
        MissingUnionLayout(id):
            "missing emitted union layout #".append_int(id.union_number())
        MissingRecordLayout(id):
            "missing emitted record layout #".append_int(id.record_number())
        MissingOwnerType(id):
            "missing emitted owner type #".append_int(id.owner_number())
        MissingValueType(id):
            "missing emitted value type #".append_int(id.value_number())
        MissingRuntimeArgument(id, argument):
            "missing runtime argument #${argument.to_string()} for value #${id.value_number().to_string()}"
        MissingFunctionRow(id):
            "missing function row for callable value #".append_int(id.value_number())
        MissingJoinTransfer(id):
            "missing verified join transfer for value #".append_int(id.value_number())
        MissingSelectionArm(id):
            "missing selection arm for join value #".append_int(id.value_number())
        MissingEnclosingLoop(id):
            "missing enclosing loop for transfer to value #".append_int(id.value_number())
        StatementOnlyValue(id):
            "value #${id.value_number().to_string()} requires statement emission"
        InvalidOperationShape(id):
            "value #${id.value_number().to_string()} has an operation of the wrong shape here"
        MissingAggregateWorkItem(index):
            "missing aggregate work item #".append_int(index)
        MissingAggregateVisit(kind, index):
            "missing ${kind.aggregate_name()} aggregate visit #${index.to_string()}"
        CyclicByValueAggregate(kind, index):
            "by-value dependency cycle at ${kind.aggregate_name()} aggregate #${index.to_string()}"
        MissingAggregateLayout(kind, index):
            "missing ${kind.aggregate_name()} aggregate layout #${index.to_string()}"
        MissingAggregateMember(kind, index, member):
            label = match kind:
                RecordAggregate: "field"
                UnionAggregate: "variant"
            "missing ${label} #${member.to_string()} of ${kind.aggregate_name()} aggregate #${index.to_string()}"
        MissingUnionPayloadField(owner, variant, field):
            "missing field #${field.to_string()} of variant #${variant.to_string()} of union aggregate #${owner.to_string()}"
        MissingInPlaceHelper(id):
            "value #${id.value_number().to_string()} consumes an operand with no in-place helper"
    internal_error(span, message)
