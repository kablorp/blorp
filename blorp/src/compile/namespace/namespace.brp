---
The namespace: every module's scope, built once from the sealed parsed program
before checking. In one module a spelling denotes at most one entity per space,
and `enter` is the only place that rule is checked; `offer` is the only place
it is decided what a module offers its importers. Modules are built in
dependency order, so each import reads a finished scope. Building stops at the
first module with a problem: every later module depends on it or would be
reported after it, and checking reports one problem.

The sections run in this order: the data, identity, the rule and the offer,
building, selection, then the queries. Only `build_namespace`, the queries,
the identity helpers and the types they exchange are public; the rule, the
offer and the scopes being built stay private to this module.
---
import:
    bool: Bool methods
    dict as D
    int: Int methods
    list: repeat, List methods
    option: Option methods
    ../../syntax/names: NameId
    ../../syntax/parse:
        ImportSelection(NamedSelection, ConstructorSelection, MethodsSelection),
        ModulePath,
    ../../syntax/source:
        ModuleId,
        ModuleKind(UserModule, LibraryModule, FoundationTypesModule, FoundationPreludeModule),
    ../../syntax/syntax:
        ParsedBuiltinType(IntegerBuiltin, FloatBuiltin, StringBuiltin, VoidBuiltin, ListBuiltin),
        Span,
        TypeSyntax(AtomicType, QualifiedType),
        Visibility(Public, Private),
        WrittenName,
    ../assemble: ModuleImport, ParsedContents, ParsedModuleRow, ParsedProgram
    ../ids:
        TraitId,
        ImplId,
        TraitRow,
        TraitMethodRow,
        TraitMethodId,
        DeclarationInventory,
        FunctionRole(FreeFunctionBody, ImplementationBody, TraitDefaultBody),
        ConstantId,
        ConstantRow,
        FunctionId,
        FunctionRow,
        OpaqueId,
        RecordId,
        UnionId,
        UnionRow,
        VariantId,
        NominalRow(UnionDeclarationRow, RecordDeclarationRow, OpaqueDeclarationRow),
    ./builtins:
        PrimitiveType(BuiltinInt, BuiltinFloat, BuiltinString, BuiltinVoid),
        ParsedBuiltinType methods,


-- Data: what a module's names denote, and why a name does not enter.


-- The head a type name denotes; accepted type arguments stay in checking.
union TypeHead:
    PrimitiveHead(PrimitiveType)
    ListHead
    UnionHead(UnionId)
    RecordHead(RecordId)
    OpaqueHead(OpaqueId)


-- Declaration numbers are non-negative, so each built-in head, which carries
-- most implementations, takes its own negative hash. Union, record and opaque
-- heads with one number share a hash; equality tells them apart.
private INT_HEAD_HASH: Int = -1
private FLOAT_HEAD_HASH: Int = -2
private STRING_HEAD_HASH: Int = -3
private VOID_HEAD_HASH: Int = -4
private LIST_HEAD_HASH: Int = -5


implements Hashable for TypeHead:
    pure func hash(value: Self) -> Int:
        match value:
            PrimitiveHead(BuiltinInt): INT_HEAD_HASH
            PrimitiveHead(BuiltinFloat): FLOAT_HEAD_HASH
            PrimitiveHead(BuiltinString): STRING_HEAD_HASH
            PrimitiveHead(BuiltinVoid): VOID_HEAD_HASH
            ListHead: LIST_HEAD_HASH
            UnionHead(id): id.union_number()
            RecordHead(id): id.record_number()
            OpaqueHead(id): id.opaque_number()


implements D.DictKey for TypeHead


-- `path as Alias`: the module it names, and its path as written, which
-- qualified-name diagnostics quote.
record AliasedModule {
    target: ModuleId,
    path: ModulePath,
}


-- What a written name denotes in a module.
union Entity:
    Trait(TraitId)
    Method(TraitMethodId)
    Function(FunctionId)
    Constant(ConstantId)
    Constructor(VariantId)
    Type(TypeHead)
    Alias(AliasedModule)


-- How a name entered its module: declared there, written in its import block
-- (a selection or an alias), or supplied by the prelude.
union Origin:
    Declared(Visibility)
    Imported
    Implicit


-- The visible type head and the existing entry's access authority.
record NamedType {
    head: TypeHead,
    origin: Origin,
}


-- A value-space name already claimed in this module, with its original site.
union ValueBinding:
    MethodName(WrittenName)
    FunctionName(WrittenName)
    ConstantName(WrittenName)
    ConstructorName(WrittenName)
    ModuleAliasName(WrittenName)


-- One name of a module. `name.span` is where diagnostics point: the
-- declaration, the selection or alias, or the prelude's own selection.
record Entry {
    name: WrittenName,
    entity: Entity,
    origin: Origin,
}


-- A module's two name spaces: values (functions, constants, constructors) and types.
-- A module alias claims its spelling in both.
private union Space:
    Values
    Types


-- A type selection, or `T methods`, imports the target's public receiver
-- functions of `receiver`; checking resolves it after signatures.
record MethodImport {
    target: ModuleId,
    receiver: TypeHead,
    name: WrittenName,
}


fixed record ResolvedImplementation {
    id: ImplId,
    trait_id: TraitId,
}


-- One module's names, in the order they entered, keyed by `space_key`.
private record ModuleScope {
    names: Dict[Int, Entry],
    methods: List[MethodImport],
    implementations: List[ResolvedImplementation],
}


-- Why a module does not offer a name: none of that kind, a private
-- declaration, or a name it imports or receives from the prelude.
union Unoffered:
    UnknownName
    PrivateName
    ImportedThere(Entity)
    ProvidedThere(Entity)


-- Why a selection binds nothing. A name the target only imports may already be
-- in the selecting module's scope, through the prelude or an earlier import.
union SelectionProblem:
    NotOffered(Unoffered)
    AlreadyFromPrelude(Entity)
    AlreadyImported(Entity)
    AmbiguousFunction
    AmbiguousConstant
    BareConstructor(VariantId)
    NotAConstructor(WrittenName)
    ReceiverNotVisible


-- `incoming` reached a space `previous` already holds for its spelling.
record Conflict {
    incoming: Entry,
    previous: Entry,
}


union NamespaceProblem:
    NameConflict(Conflict)
    SelectionFailure(ModulePath, ImportSelection, SelectionProblem)
    InvalidImplementationTrait(TypeSyntax)
    InvalidTraitInventory(Span)


-- A module's scope as it is built, with its first problem in source order.
-- Its fields are flat so that each update can reuse them in place.
private record BuiltScope {
    names: Dict[Int, Entry],
    methods: List[MethodImport],
    implementations: List[ResolvedImplementation],
    problem: Option[NamespaceProblem],
}


-- One scope per module, indexed by module number, for one compilation.
opaque type Namespace = List[ModuleScope]


-- Where a function a module names comes from: its own declaration, or the
-- selection that imported it, whose span diagnostics cite.
union FunctionSource:
    DeclaredHere
    ImportedAt(Span)


-- What a name denotes in the value space.
union NamedValue:
    NamedMethod(TraitMethodId)
    NamedFunction(FunctionId, FunctionSource)
    NamedConstant(ConstantId)
    NamedConstructor(VariantId)
    NamedAlias(AliasedModule)


-- What a module offers importers in the value space: never an alias.
union OfferedValue:
    OfferedMethod(TraitMethodId)
    OfferedFunction(FunctionId)
    OfferedConstant(ConstantId)
    OfferedConstructor(VariantId)


-- Two aliases name the same entity when they name the same module, however
-- each wrote its path, so entities do not use automatic equality.


private pure func same_entity(left: Entity, right: Entity) -> Bool:
    match left:
        Trait(first):
            match right:
                Trait(second): first == second
                _: False
        Method(first):
            match right:
                Method(second): first == second
                _: False
        Function(first):
            match right:
                Function(second): first == second
                _: False
        Constant(first):
            match right:
                Constant(second): first == second
                _: False
        Constructor(first):
            match right:
                Constructor(second): first == second
                _: False
        Type(first):
            match right:
                Type(second): first == second
                _: False
        Alias(first):
            match right:
                Alias(second): first.target == second.target
                _: False


-- The head a builtin type declaration of the base declares.
pure func builtin_head(declaration: ParsedBuiltinType) -> TypeHead:
    match declaration:
        IntegerBuiltin(_): PrimitiveHead(BuiltinInt)
        FloatBuiltin(_): PrimitiveHead(BuiltinFloat)
        StringBuiltin(_): PrimitiveHead(BuiltinString)
        VoidBuiltin(_): PrimitiveHead(BuiltinVoid)
        ListBuiltin(_, _): ListHead


-- The rule and the offer.


private pure func empty_scope() -> ModuleScope:
    none: List[MethodImport] = []
    { names = {}, methods = none, implementations = [] }


-- A spelling's entry in each space has its own key: 2n for values and 2n + 1
-- for types, where n is the spelling's `name_number`.
private pure func space_key(space: Space, name: NameId) -> Int:
    values_key = name.name_number() * 2
    match space:
        Values: values_key
        Types: values_key + 1


-- The entry `names` holds for `name` in `space`; the rule leaves at most one.
private pure func holder(names: Dict[Int, Entry], space: Space, name: NameId) -> Option[Entry]:
    names.get(space_key(space, name))


-- A module reports its first problem in source order. Names do not enter in
-- source order (`methods` selections follow every row), but every
-- problem's span lies in the module's own source, so starts compare.
private pure func first_problem(
    found: Option[NamespaceProblem],
    later: NamespaceProblem,
) -> Option[NamespaceProblem]:
    match found:
        Some(earlier):
            if later.namespace_problem_span().start < earlier.namespace_problem_span().start:
                Some(later)
            else:
                found
        None:
            Some(later)


-- What `names` already holds in a space that `entity` named `name` claims.
private pure func claimant(names: Dict[Int, Entry], name: NameId, entity: Entity) -> Option[Entry]:
    match entity:
        Method(_) | Function(_) | Constant(_) | Constructor(_):
            names.holder(Values, name)
        Type(_) | Trait(_):
            names.holder(Types, name)
        Alias(_):
            match names.holder(Values, name):
                Some(held): Some(held)
                None: names.holder(Types, name)


-- `names` with `incoming` in each space it claims. This is a scope's only
-- writer, so a value key never holds a type, a type key never holds a function,
-- constant or constructor, and an alias, entered only by `import_row`, is always
-- `Imported`. The arms that read those states (in `named_value`, `named_type`,
-- `offered_value`, `offered_type`, `select_methods` and render) are
-- unreachable. Typed per-space entries would remove them, but measured they
-- cost a second copy of `enter` per space, about 37 more lines, and about 80
-- more allocations on a one-line program, so one `Entity` serves both spaces.
private pure func claimed(names: Dict[Int, Entry], incoming: Entry) -> Dict[Int, Entry]:
    name = incoming.name.id
    match incoming.entity:
        Method(_) | Function(_) | Constant(_) | Constructor(_):
            names.set(space_key(Values, name), incoming)
        Type(_) | Trait(_):
            names.set(space_key(Types, name), incoming)
        Alias(_):
            names
                .set(space_key(Values, name), incoming)
                .set(space_key(Types, name), incoming)


-- The scope rule. An import of an entity the module already sees (the
-- prelude's, and an explicit import of it) enters once; a declaration always
-- claims its spelling, so a second declaration of anything is a conflict.
-- Every path returns `built` or a record update of it: the host updates a
-- scope in place only then, and copies its map on every entry otherwise.
private pure func enter(built: BuiltScope, incoming: Entry) -> BuiltScope:
    match built.names.claimant(incoming.name.id, incoming.entity):
        None:
            { built | names = built.names.claimed(incoming) }
        Some(held):
            family_again = match held.entity:
                Method(first):
                    match incoming.entity:
                        Method(second): first == second
                        _: False
                _:
                    False
            arrives_again: Bool = match incoming.origin:
                Declared(_): False
                Imported | Implicit: held.entity.same_entity(incoming.entity)
            if family_again:
                match held.origin:
                    Declared(Public):
                        built
                    _:
                        match incoming.origin:
                            Imported | Implicit: built
                            Declared(_): { built | names = built.names.claimed(incoming) }
            else if arrives_again:
                built
            else:
                { built |
                    problem = built.problem.first_problem(
                        NameConflict(incoming.staged_conflict(held)),
                    ),
                }


-- Implementations enter after the module's ordinary declarations. Only this
-- new staged own-method case needs diagnostic orientation by written order.
private pure func staged_conflict(incoming: Entry, previous: Entry) -> Conflict:
    conflict: Conflict = { incoming = incoming, previous = previous }
    match incoming.entity:
        Method(_):
            match incoming.origin:
                Declared(_):
                    match previous.origin:
                        Declared(_):
                            if (incoming.name.span.source == previous.name.span.source).and(
                                incoming.name.span.start < previous.name.span.start,
                            ):
                                { incoming = previous, previous = incoming }
                            else:
                                conflict
                        _:
                            conflict
                _:
                    conflict
        _:
            conflict


-- A module offers importers only its own public declarations (decided
-- 2026-10-15: a module never reexports), to selections, qualified names and
-- method imports alike. An alias is never offered.
private pure func offer(found: Option[Entry]) -> Result[Entity, Unoffered]:
    match found:
        Some(entry):
            match entry.entity:
                Alias(_):
                    Err(UnknownName)
                Method(_) | Function(_) | Constant(_) | Constructor(_) | Type(_) | Trait(_):
                    match entry.origin:
                        Declared(Public): Ok(entry.entity)
                        Declared(Private(_)): Err(PrivateName)
                        Imported: Err(ImportedThere(entry.entity))
                        Implicit: Err(ProvidedThere(entry.entity))
        None:
            Err(UnknownName)


-- Building, in dependency order.


-- `entries` with a union's type, then each constructor with the union's visibility.
private pure func with_union(entries: List[Entry], row: UnionRow) -> List[Entry]:
    var grown: List[Entry] = entries.append({
        name = row.type_name,
        entity = Type(UnionHead(row.id)),
        origin = Declared(row.visibility),
    })
    for variant in row.variants:
        grown = grown.append({
            name = variant.declaration.name,
            entity = Constructor(variant.id),
            origin = Declared(row.visibility),
        })
    grown


private pure func nominal_module(row: NominalRow) -> ModuleId:
    match row:
        UnionDeclarationRow(union_row): union_row.module
        RecordDeclarationRow(record_row): record_row.declaration.module
        OpaqueDeclarationRow(opaque_row): opaque_row.declaration.module


private pure func nominal_start(row: NominalRow) -> Int:
    match row:
        UnionDeclarationRow(union_row): union_row.type_name.span.start
        RecordDeclarationRow(record_row): record_row.declaration.type_name.span.start
        OpaqueDeclarationRow(opaque_row): opaque_row.declaration.type_name.span.start


-- Whether a module's next nominal declaration is written before its next
-- function, if it has one left.
private pure func written_before(nominal: NominalRow, function: Option[FunctionRow]) -> Bool:
    match function:
        Some(next): nominal.nominal_start() < next.declaration.function_name.span.start
        None: True


-- Each module's declared entries in source order, indexed by module number.
-- Builtin types come first: the base owns them, so a union or record that
-- reuses a builtin's name is the one reported. Assembly appends each kind's
-- rows grouped by module in module order, so one cursor per kind reads each
-- row once; its next nominal declaration, function and constant are
-- taken in the order they are written.
private pure func declared_entries(
    parsed: ParsedContents,
) -> Result[List[List[Entry]], NamespaceProblem]:
    functions = parsed.declarations.inventory_functions()
    constants = parsed.declarations.inventory_constants()
    traits = parsed.declarations.inventory_traits()
    var failure: Option[NamespaceProblem] = None
    var traits_seen = 0
    var builtins_seen = 0
    var functions_seen = 0
    var constants_seen = 0
    var records_seen = 0
    var unions_seen = 0
    var opaques_seen = 0
    var declared: List[List[Entry]] = []
    for row in parsed.modules:
        var entries: List[Entry] = []
        var reading: Bool = True
        while reading:
            match parsed.builtin_types.get(builtins_seen):
                Some(primitive):
                    reading = primitive.module == row.module
                    if reading:
                        entries = entries.append({
                            name = primitive.declaration.builtin_type_name(),
                            entity = Type(primitive.declaration.builtin_head()),
                            origin = Declared(Public),
                        })
                        builtins_seen = builtins_seen + 1
                None:
                    reading = False
        reading = True
        while reading.and(failure.is_none()):
            function: Option[FunctionRow] = match functions.get(functions_seen):
                Some(candidate):
                    if candidate.declaration.module == row.module:
                        Some(candidate)
                    else:
                        None
                None:
                    None
            nominal: Option[NominalRow] = match parsed.declarations.next_nominal(
                records_seen,
                unions_seen,
                opaques_seen,
            ):
                Some(candidate):
                    if (candidate.nominal_module() == row.module).and(
                        candidate.written_before(function),
                    ):
                        Some(candidate)
                    else:
                        None
                None:
                    None
            constant: Option[ConstantRow] = match constants.get(constants_seen):
                Some(candidate):
                    before_function = match function:
                        Some(next):
                            (
                                candidate.declaration.name.span.start
                                < next.declaration.function_name.span.start
                            )
                        None:
                            True
                    before_nominal = match nominal:
                        Some(next): candidate.declaration.name.span.start < next.nominal_start()
                        None: True
                    if (
                        (candidate.declaration.module == row.module)
                            .and(before_function)
                            .and(before_nominal)
                    ):
                        Some(candidate)
                    else:
                        None
                None:
                    None
            trait_declaration: Option[TraitRow] = match traits.get(traits_seen):
                Some(candidate):
                    before_function = match function:
                        Some(next):
                            (
                                candidate.type_name.span.start
                                < next.declaration.function_name.span.start
                            )
                        None:
                            True
                    before_nominal = match nominal:
                        Some(next): candidate.type_name.span.start < next.nominal_start()
                        None: True
                    before_constant = match constant:
                        Some(next):
                            candidate.type_name.span.start < next.declaration.name.span.start
                        None:
                            True
                    if (
                        (candidate.module == row.module)
                            .and(before_function)
                            .and(before_nominal.and(before_constant))
                    ):
                        Some(candidate)
                    else:
                        None
                None:
                    None
            match trait_declaration:
                Some(trait_row):
                    entries = entries.append({
                        name = trait_row.type_name,
                        entity = Trait(trait_row.id),
                        origin = Declared(trait_row.visibility),
                    })
                    for method in trait_row.methods:
                        match method.trait_method_header(parsed.declarations):
                            Some(header):
                                entries = entries.append({
                                    name = header.function_name,
                                    entity = Method(method.id),
                                    origin = Declared(trait_row.visibility),
                                })
                            None:
                                failure = Some(InvalidTraitInventory(method.span))
                                break
                    traits_seen = traits_seen + 1
                None:
                    match constant:
                        Some(constant_row):
                            declaration = constant_row.declaration
                            entries = entries.append({
                                name = declaration.name,
                                entity = Constant(constant_row.id),
                                origin = Declared(declaration.visibility),
                            })
                            constants_seen = constants_seen + 1
                        None:
                            match nominal:
                                Some(UnionDeclarationRow(union_row)):
                                    entries = entries.with_union(union_row)
                                    unions_seen = unions_seen + 1
                                Some(RecordDeclarationRow(record_row)):
                                    declaration = record_row.declaration
                                    entries = entries.append({
                                        name = declaration.type_name,
                                        entity = Type(RecordHead(record_row.id)),
                                        origin = Declared(declaration.visibility),
                                    })
                                    records_seen = records_seen + 1
                                Some(OpaqueDeclarationRow(opaque_row)):
                                    declaration = opaque_row.declaration
                                    entries = entries.append({
                                        name = declaration.type_name,
                                        entity = Type(OpaqueHead(opaque_row.id)),
                                        origin = Declared(declaration.visibility),
                                    })
                                    opaques_seen = opaques_seen + 1
                                None:
                                    match function:
                                        Some(function_row):
                                            match function_row.role:
                                                FreeFunctionBody:
                                                    entries = entries.append({
                                                        name = function_row.declaration.function_name,
                                                        entity = Function(function_row.id),
                                                        origin = Declared(
                                                            function_row.declaration.visibility,
                                                        ),
                                                    })
                                                ImplementationBody | TraitDefaultBody:
                                                    void
                                            functions_seen = functions_seen + 1
                                        None:
                                            reading = False
        declared = declared.append(entries)
    match failure:
        Some(problem): Err(problem)
        None: Ok(declared)


-- The prelude's selections, as every user module receives them. Its aliases
-- and declarations stay its own.
private pure func provided(prelude: ModuleScope) -> List[Entry]:
    var entries: List[Entry] = []
    for entry in prelude.names.values():
        match entry.entity:
            Alias(_):
                void
            Method(_) | Function(_) | Constant(_) | Constructor(_) | Type(_) | Trait(_):
                match entry.origin:
                    Imported: entries = entries.append({ entry | origin = Implicit })
                    Declared(_) | Implicit: void
    entries


-- One module: the names it receives, then its import rows, its `methods`
-- selections, and its declarations, so a conflict is reported at the later
-- name, in this module. Each map is presized for the received and declared
-- names and one name per import row; a long selection list grows it. `empty`
-- is only the host `get` default: dependency order builds every target before
-- the modules that import it, so it is never read.
private pure func build_module(
    scopes: List[ModuleScope],
    empty: ModuleScope,
    row: ParsedModuleRow,
    declared: List[Entry],
    received: List[Entry],
    methods: List[MethodImport],
) -> BuiltScope:
    expected = received.length() + declared.length() + row.imports.length()
    var built: BuiltScope = {
        names = D.dict(expected),
        methods = methods,
        implementations = [],
        problem = None,
    }
    for entry in received:
        built = built.enter(entry)
    for request in row.imports:
        built = built.import_row(scopes.get_or(request.target.module_number(), empty), request)
    for request in row.imports:
        built = built.select_methods(scopes.get_or(request.target.module_number(), empty), request)
    for entry in declared:
        built = built.enter(entry)
    built


private pure func trait_reference(
    names: Dict[Int, Entry],
    scopes: List[ModuleScope],
    written: TypeSyntax,
) -> Option[TraitId]:
    found: Option[Entry] = match written:
        AtomicType(name):
            names.holder(Types, name.id)
        QualifiedType(qualified, [], _):
            match names.holder(Values, qualified.module.id):
                Some(entry):
                    match entry.entity:
                        Alias(aliased):
                            match scopes.get(aliased.target.module_number()):
                                Some(scope):
                                    match (
                                        scope.names
                                            .holder(Types, qualified.name.id)
                                            .offer()
                                    ):
                                        Ok(Trait(id)):
                                            Some({
                                                name = qualified.name,
                                                entity = Trait(id),
                                                origin = Imported,
                                            })
                                        _:
                                            None
                                None:
                                    None
                        _:
                            None
                None:
                    None
        _:
            None
    match found:
        Some(entry):
            match entry.entity:
                Trait(id): Some(id)
                _: None
        None:
            None


-- Bounds resolve through the same visible trait lookup as implementation heads.
pure func resolve_trait(
    namespace: Namespace,
    module: ModuleId,
    written: TypeSyntax,
) -> Option[TraitId]:
    scopes = from_opaque Namespace(namespace)
    match scopes.get(module.module_number()):
        Some(scope): scope.names.trait_reference(scopes, written)
        None: None


-- This is name resolution only. Check later accepts members/receiver/coherence.
-- The resolved TraitId is retained once; method membership stays in inventory.
private pure func publish_implementations(
    built: BuiltScope,
    scopes: List[ModuleScope],
    module: ModuleId,
    parsed: ParsedContents,
) -> BuiltScope:
    var next = built
    for implementation in parsed.declarations.inventory_implementations():
        if implementation.header.module == module:
            match next.names.trait_reference(scopes, implementation.header.trait_name):
                None:
                    next = { next |
                        problem = next.problem.first_problem(
                            InvalidImplementationTrait(implementation.header.trait_name),
                        ),
                    }
                Some(id):
                    resolved: ResolvedImplementation = { id = implementation.id, trait_id = id }
                    next = { next | implementations = next.implementations.append(resolved) }
                    match (
                        parsed.declarations
                            .inventory_traits()
                            .get(id.trait_number())
                    ):
                        Some(owner):
                            for method in owner.methods:
                                match method.trait_method_header(parsed.declarations):
                                    None:
                                        next = { next |
                                            problem = next.problem.first_problem(
                                                InvalidTraitInventory(method.span),
                                            ),
                                        }
                                    Some(header):
                                        var name: WrittenName = { header.function_name |
                                            span = implementation.header.span,
                                        }
                                        for body in implementation.methods:
                                            match (
                                                parsed.declarations
                                                    .inventory_functions()
                                                    .get(body.function_number())
                                            ):
                                                Some(function):
                                                    if (
                                                        function.declaration.function_name.id
                                                        == name.id
                                                    ):
                                                        name = function.declaration.function_name
                                                None:
                                                    void
                                        next = next.enter({
                                            name = name,
                                            entity = Method(method.id),
                                            origin = Declared(implementation.header.visibility),
                                        })
                        None:
                            next = { next |
                                problem = next.problem.first_problem(
                                    InvalidImplementationTrait(implementation.header.trait_name),
                                ),
                            }
    next


-- Host `get` defaults are unreachable: every index is a sealed module number,
-- and the prelude precedes every user module in dependency order.
pure func build_namespace(program: ParsedProgram) -> Result[Namespace, NamespaceProblem]:
    parsed = program.parsed_contents()
    declared ?= parsed.declared_entries()
    none: List[MethodImport] = []
    nothing: List[Entry] = []
    empty = empty_scope()
    var scopes: List[ModuleScope] = repeat(empty, parsed.modules.length())
    var prelude_entries = nothing
    var prelude_methods = none
    var failure: Option[NamespaceProblem] = None
    for row in parsed.dependency_order:
        number = row.module.module_number()
        var built = match row.role:
            UserModule:
                scopes.build_module(
                    empty,
                    row,
                    declared.get_or(number, nothing),
                    prelude_entries,
                    prelude_methods,
                )
            FoundationTypesModule | FoundationPreludeModule | LibraryModule:
                scopes.build_module(empty, row, declared.get_or(number, nothing), nothing, none)
        built = built.publish_implementations(scopes, row.module, parsed)
        failure = built.problem
        scope: ModuleScope = {
            names = built.names,
            methods = built.methods,
            implementations = built.implementations,
        }
        scopes = scopes.set(number, scope)
        if row.module == parsed.foundation.prelude:
            prelude_entries = scope.provided()
            prelude_methods = scope.methods
        if failure.is_some():
            break
    match failure:
        Some(problem): Err(problem)
        None: Ok(into_opaque Namespace(scopes))


-- Selection: how an import row enters names, its alias first and then each
-- selection, resolved against what the target offers. `methods`
-- selections are resolved after a module's rows, because a later row may
-- import the type they name.


-- A name the target only imports may already be in this module's scope.
private pure func seen_here(
    built: BuiltScope,
    name: NameId,
    problem: SelectionProblem,
) -> SelectionProblem:
    match problem:
        NotOffered(ImportedThere(entity)):
            match built.names.claimant(name, entity):
                Some(entry):
                    if entry.entity.same_entity(entity):
                        match entry.origin:
                            Implicit: AlreadyFromPrelude(entity)
                            Imported: AlreadyImported(entity)
                            Declared(_): problem
                    else:
                        problem
                None:
                    problem
        _:
            problem


private pure func fail(
    built: BuiltScope,
    request: ModuleImport,
    selection: ImportSelection,
    problem: SelectionProblem,
) -> BuiltScope:
    failure: NamespaceProblem = SelectionFailure(
        request.path,
        selection,
        built.seen_here(selection.selection_name().id, problem),
    )
    { built | problem = built.problem.first_problem(failure) }


-- With nothing selected, the more specific reason is reported: a private
-- declaration, then any reason but a name the target does not have.
private pure func more_specific(
    value_reason: SelectionProblem,
    type_reason: SelectionProblem,
) -> SelectionProblem:
    match value_reason:
        NotOffered(PrivateName):
            value_reason
        _:
            match type_reason:
                NotOffered(UnknownName): value_reason
                _: type_reason


-- A bare name selects the target's public value or public type of that
-- name; both make it ambiguous, and a public constructor is named with its
-- union.
private pure func bare_selection(
    target: ModuleScope,
    name: NameId,
) -> Result[Entity, SelectionProblem]:
    value: Result[Entity, SelectionProblem] = match (
        target.names
            .holder(Values, name)
            .offer()
    ):
        Ok(Constructor(variant)): Err(BareConstructor(variant))
        Ok(selected): Ok(selected)
        Err(reason): Err(NotOffered(reason))
    selected_type: Result[Entity, SelectionProblem] = match (
        target.names
            .holder(Types, name)
            .offer()
    ):
        Ok(selected): Ok(selected)
        Err(reason): Err(NotOffered(reason))
    match value:
        Ok(selected):
            match selected_type:
                Ok(_):
                    match selected:
                        Function(_) | Method(_): Err(AmbiguousFunction)
                        Constant(_): Err(AmbiguousConstant)
                        Constructor(variant): Err(BareConstructor(variant))
                        Type(_) | Trait(_) | Alias(_): Err(NotOffered(UnknownName))
                Err(_):
                    Ok(selected)
        Err(value_reason):
            match selected_type:
                Ok(selected): Ok(selected)
                Err(type_reason): Err(value_reason.more_specific(type_reason))


-- A selected name enters this module; a selected type also imports the
-- target's receiver functions of that type.
private pure func bind(
    built: BuiltScope,
    request: ModuleImport,
    name: WrittenName,
    entity: Entity,
) -> BuiltScope:
    entered = built.enter({ name = name, entity = entity, origin = Imported })
    match entity:
        Type(receiver):
            { entered |
                methods = entered.methods.append({
                    target = request.target,
                    receiver = receiver,
                    name = name,
                }),
            }
        Method(_) | Function(_) | Constant(_) | Constructor(_) | Alias(_) | Trait(_):
            entered


-- `Union(First, ...)` selects a public union of the target and the listed
-- constructors, which the target declares with it. Kind comes before privacy:
-- a private record behind `Secret(Hidden)` is unknown, as a public one is.
private pure func select_union(
    built: BuiltScope,
    target: ModuleScope,
    request: ModuleImport,
    selection: ImportSelection,
    name: WrittenName,
    listed: List[WrittenName],
) -> BuiltScope:
    found = target.names.holder(Types, name.id)
    match found:
        Some(entry):
            match entry.entity:
                Type(UnionHead(owner)):
                    match found.offer():
                        Err(reason):
                            built.fail(request, selection, NotOffered(reason))
                        Ok(union_type):
                            var next = built.bind(request, name, union_type)
                            for constructor in listed:
                                next = match (
                                    target.names
                                        .holder(Values, constructor.id)
                                        .offer()
                                ):
                                    Ok(Constructor(variant)):
                                        if variant.variant_owner() == owner:
                                            next.enter({
                                                name = constructor,
                                                entity = Constructor(variant),
                                                origin = Imported,
                                            })
                                        else:
                                            next.fail(
                                                request,
                                                selection,
                                                NotAConstructor(constructor),
                                            )
                                    _:
                                        next.fail(request, selection, NotAConstructor(constructor))
                            next
                _:
                    built.fail(request, selection, NotOffered(UnknownName))
        None:
            built.fail(request, selection, NotOffered(UnknownName))


-- One `path [as Alias]: selections` row; its target was built first.
private pure func import_row(
    built: BuiltScope,
    target: ModuleScope,
    request: ModuleImport,
) -> BuiltScope:
    var next = built
    match request.module_alias:
        Some(written):
            next = next.enter({
                name = written,
                entity = Alias({ target = request.target, path = request.path }),
                origin = Imported,
            })
        None:
            void
    for selection in request.symbols:
        next = match selection:
            NamedSelection(name):
                match target.bare_selection(name.id):
                    Ok(entity): next.bind(request, name, entity)
                    Err(problem): next.fail(request, selection, problem)
            ConstructorSelection(name, listed):
                next.select_union(target, request, selection, name, listed)
            MethodsSelection(_, _):
                next
    next


-- `T methods` enters no name. The target must hold the type, publicly or
-- by import, and this module must already see that same type.
private pure func select_methods(
    built: BuiltScope,
    target: ModuleScope,
    request: ModuleImport,
) -> BuiltScope:
    var next = built
    for selection in request.symbols:
        match selection:
            MethodsSelection(name, _):
                offered = target.names
                    .holder(Types, name.id)
                    .offer()
                holding: Result[Entity, Unoffered] = match offered:
                    Err(ImportedThere(entity)): Ok(entity)
                    Err(ProvidedThere(entity)): Ok(entity)
                    _: offered
                next = match holding:
                    Ok(Type(receiver)):
                        seen = match next.names.holder(Types, name.id):
                            Some(entry): entry.entity.same_entity(Type(receiver))
                            None: False
                        if seen:
                            { next |
                                methods = next.methods.append({
                                    target = request.target,
                                    receiver = receiver,
                                    name = name,
                                }),
                            }
                        else:
                            next.fail(request, selection, ReceiverNotVisible)
                    Ok(_):
                        next.fail(request, selection, NotOffered(UnknownName))
                    Err(reason):
                        next.fail(request, selection, NotOffered(reason))
            NamedSelection(_) | ConstructorSelection(_, _):
                void
    next


-- Queries: the checker reads the namespace only through these.


-- What `module` holds for `name` in `space`. Host `get` returns an Option even
-- for a sealed module number, which always has a scope.
private pure func held_in(
    namespace: Namespace,
    module: ModuleId,
    space: Space,
    name: NameId,
) -> Option[Entry]:
    scopes: List[ModuleScope] = from_opaque Namespace(namespace)
    match scopes.get(module.module_number()):
        Some(scope): scope.names.holder(space, name)
        None: None


-- What `name` denotes as a value in `module`. The scope rule leaves one entry,
-- so no caller chooses.
pure func named_value(namespace: Namespace, module: ModuleId, name: NameId) -> Option[NamedValue]:
    match namespace.held_in(module, Values, name):
        Some(entry): entry.entry_value()
        None: None


-- A namespace entry's value and original function introduction. Bulk consumers
-- use this same projection instead of reconstructing the origin policy.
pure func entry_value(entry: Entry) -> Option[NamedValue]:
    match entry.entity:
        Function(id):
            source: FunctionSource = match entry.origin:
                Declared(_): DeclaredHere
                Imported | Implicit: ImportedAt(entry.name.span)
            Some(NamedFunction(id, source))
        Constant(id):
            Some(NamedConstant(id))
        Constructor(variant):
            Some(NamedConstructor(variant))
        Alias(aliased):
            Some(NamedAlias(aliased))
        Method(id):
            Some(NamedMethod(id))
        Type(_) | Trait(_):
            None


-- The value-space conflict fact; type-only names cannot conflict with a local.
pure func value_binding(
    namespace: Namespace,
    module: ModuleId,
    name: NameId,
) -> Option[ValueBinding]:
    match namespace.held_in(module, Values, name):
        None:
            None
        Some(entry):
            match entry.entity:
                Method(_): Some(MethodName(entry.name))
                Function(_): Some(FunctionName(entry.name))
                Constant(_): Some(ConstantName(entry.name))
                Constructor(_): Some(ConstructorName(entry.name))
                Alias(_): Some(ModuleAliasName(entry.name))
                Type(_) | Trait(_): None


pure func named_trait(namespace: Namespace, module: ModuleId, name: NameId) -> Option[TraitId]:
    match namespace.held_in(module, Types, name):
        Some(entry):
            match entry.entity:
                Trait(id): Some(id)
                _: None
        None:
            None


pure func implementation_trait(
    namespace: Namespace,
    module: ModuleId,
    id: ImplId,
) -> Option[TraitId]:
    match from_opaque Namespace(namespace).get(module.module_number()):
        Some(scope):
            var found: Option[TraitId] = None
            for implementation in scope.implementations:
                if implementation.id == id:
                    found = Some(implementation.trait_id)
                    break
            found
        None:
            None


-- The type `name` denotes in `module`; a module alias, which also claims the
-- type space, denotes none.
pure func named_type(namespace: Namespace, module: ModuleId, name: NameId) -> Option[NamedType]:
    match namespace.held_in(module, Types, name):
        Some(entry):
            match entry.entity:
                Type(head): Some({ head = head, origin = entry.origin })
                Method(_) | Function(_) | Constant(_) | Constructor(_) | Alias(_) | Trait(_): None
        None:
            None


-- The function, constant or constructor `target` offers as `name`.
pure func offered_value(
    namespace: Namespace,
    target: ModuleId,
    name: NameId,
) -> Result[OfferedValue, Unoffered]:
    match (
        namespace
            .held_in(target, Values, name)
            .offer()
    ):
        Ok(Method(id)): Ok(OfferedMethod(id))
        Ok(Function(id)): Ok(OfferedFunction(id))
        Ok(Constant(id)): Ok(OfferedConstant(id))
        Ok(Constructor(variant)): Ok(OfferedConstructor(variant))
        Ok(_): Err(UnknownName)
        Err(reason): Err(reason)


-- The type `target` offers as `name`: `A.T`.
pure func offered_type(
    namespace: Namespace,
    target: ModuleId,
    name: NameId,
) -> Result[TypeHead, Unoffered]:
    match (
        namespace
            .held_in(target, Types, name)
            .offer()
    ):
        Ok(Type(head)): Ok(head)
        Ok(_): Err(UnknownName)
        Err(reason): Err(reason)


-- Host `get` returns an Option even for a sealed module number, which always
-- has a scope.
pure func method_imports(namespace: Namespace, module: ModuleId) -> List[MethodImport]:
    scopes: List[ModuleScope] = from_opaque Namespace(namespace)
    match scopes.get(module.module_number()):
        Some(scope): scope.methods
        None: []


-- The sealed scope's existing entries in namespace insertion order. The list
-- has value semantics; consumers project through the function queries below.
pure func module_entries(namespace: Namespace, module: ModuleId) -> List[Entry]:
    scopes: List[ModuleScope] = from_opaque Namespace(namespace)
    match scopes.get(module.module_number()):
        Some(scope): scope.names.values()
        None: []


-- One of this module's declarations, including its private functions.
pure func declared_function(entry: Entry) -> Option[FunctionId]:
    match entry.origin:
        Declared(_):
            match entry.entity:
                Function(id): Some(id)
                _: None
        Imported | Implicit:
            None


-- The same declaration when the namespace's one offer rule makes it public.
pure func offered_function(entry: Entry) -> Option[FunctionId]:
    match entry.declared_function():
        None:
            None
        Some(id):
            match offer(Some(entry)):
                Ok(_): Some(id)
                Err(_): None


pure func namespace_problem_span(problem: NamespaceProblem) -> Span:
    match problem:
        InvalidImplementationTrait(written): written.type_span()
        InvalidTraitInventory(span): span
        NameConflict(conflict): conflict.incoming.name.span
        SelectionFailure(_, _, NotAConstructor(constructor)): constructor.span
        SelectionFailure(_, selection, _): selection.selection_name().span


pure func offered_trait(
    namespace: Namespace,
    target: ModuleId,
    name: NameId,
) -> Result[TraitId, Unoffered]:
    match (
        namespace
            .held_in(target, Types, name)
            .offer()
    ):
        Ok(Trait(id)): Ok(id)
        Ok(_): Err(UnknownName)
        Err(reason): Err(reason)
