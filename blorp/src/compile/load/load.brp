import:
    bool: Bool methods
    dict: empty, Dict methods
    int: Int methods
    io/environment: get_current_directory
    io/error: to_string
    io/fs: EntryKind(File, Directory), entry_kind, read_text
    list: List methods
    option: Option methods
    path as path_ops
    string: String methods
    -- The one import that leaves src/: the module is generated into the build
    -- directory (see EMBEDDED_LIBRARY_PLAN.md), so build it first with
    -- `make -C blorp compiler`.
    ../../../build/generated/embedded_library: EMBEDDED_LIBRARY_PATHS, embedded_library_file
    ../../syntax/lex: lex
    ../../syntax/names: NameId, NameTable
    ../../syntax/parse:
        ParsedModule,
        ParsedImport,
        ImportOrigin(RelativeImport, LibraryImport),
        parse_module,
    ../../syntax/source:
        ModuleId,
        ModuleKind(UserModule, LibraryModule, FoundationTypesModule, FoundationPreludeModule),
        foundation_prelude_module_id,
        foundation_types_module_id,
        module_id,
        root_module_id,
    ../../syntax/syntax:
        Diagnostic,
        Span,
        compiler_span,
        diagnostic,
        internal_error,
        or_internal_error,
        path_error,
    ../assemble:
        ParsedAssembly,
        ParsedProgram,
        SealFailure(MalformedBundle, ImportCycle),
        begin_program,


-- Every module file ends in this; a name without it is a folder or another file.
private LIBRARY_SUFFIX: String = ".brp"

private FOUNDATION_TYPES_PATH: String = "_base.brp"

private FOUNDATION_PRELUDE_PATH: String = "prelude.brp"


record SourceFile {
    path: String,
    contents: String,
}


-- Module source rows use the same order as the parser's module inventory.
record SourceInputs {
    modules: List[SourceFile],
}


record LoadedProgram {
    sources: SourceInputs,
    program: ParsedProgram,
}


record LoadFailure {
    sources: SourceInputs,
    diagnostic: Diagnostic,
}


-- Caller path admission is distinct from failures while loading a program.
union SourceLoadFailure:
    DuplicateSourcePath(String)
    SourcePathContainsNul(String)
    LoadingFailed(LoadFailure)


-- Caller-supplied contents keyed by normalized absolute path. Only
-- `source_overrides` builds a non-empty one, so every key is NUL-free,
-- normalized and unique.
private opaque type SourceOverrides = Dict[String, String]


private pure func no_source_overrides() -> SourceOverrides:
    into_opaque SourceOverrides(empty())


private pure func failure(modules: List[SourceFile], error: Diagnostic) -> LoadFailure:
    { sources = { modules = modules }, diagnostic = error }


-- Where the library comes from, as the command line wrote it.
union LibrarySource:
    -- The copy built into the compiler.
    EmbeddedLibrary
    -- A directory, absolute or relative to the working directory.
    LibraryDirectory(String)


-- The root of embedded library paths in diagnostics. A relative name in angle
-- brackets cannot equal a path Load builds, which are absolute.
private EMBEDDED_LIBRARY_ROOT: String = "<standard library>"


private record LibraryContents {
    root: String,
    prefix: String,
    types_path: String,
    prelude_path: String,
}


-- The variants differ in where the text is read from. The embedded one holds
-- nothing: its paths always derive from EMBEDDED_LIBRARY_ROOT, so they cannot
-- disagree with it.
private union LibraryChoice:
    -- Library and foundation modules under a directory.
    ReadFromDirectory(LibraryContents)
    -- The embedded copy; its modules get paths under EMBEDDED_LIBRARY_ROOT.
    ReadFromEmbedded


-- The configured library is the only authority for module roles: the
-- foundation inputs are its two designated files, and every other file under it
-- is library code. Only library_layout builds one, so these paths always agree.
opaque type LibraryLayout = LibraryChoice


private pure func root_contents(root: String) -> LibraryContents:
    {
        root = root,
        prefix = path_ops.join(root, ""),
        types_path = path_ops.join(root, FOUNDATION_TYPES_PATH),
        prelude_path = path_ops.join(root, FOUNDATION_PRELUDE_PATH),
    }


private pure func embedded_contents() -> LibraryContents:
    root_contents(EMBEDDED_LIBRARY_ROOT)


private pure func layout_contents(layout: LibraryLayout) -> LibraryContents:
    match from_opaque LibraryLayout(layout):
        ReadFromDirectory(contents): contents
        ReadFromEmbedded: embedded_contents()


-- A directory root is joined to the working directory and normalized here,
-- like every path passed to module_role.
pure func library_layout(source: LibrarySource, working_directory: String) -> LibraryLayout:
    match source:
        EmbeddedLibrary:
            into_opaque LibraryLayout(ReadFromEmbedded)
        LibraryDirectory(root):
            directory = path_ops.normalize(path_ops.join(working_directory, root))
            into_opaque LibraryLayout(ReadFromDirectory(root_contents(directory)))


-- Decides the role of a normalized path, whether it was queued by an import or
-- named on the command line. The application root is the caller's concern: it
-- is a user module wherever it lives, and only foundation roles are rejected.
pure func module_role(layout: LibraryLayout, path: String) -> ModuleKind:
    contents = layout_contents(layout)
    if path == contents.types_path:
        FoundationTypesModule
    else if path == contents.prelude_path:
        FoundationPreludeModule
    else if path.starts_with(contents.prefix):
        LibraryModule
    else:
        UserModule


private func join_parts(
    directory: String,
    parts: List[NameId],
    position: Int,
    names: NameTable,
    layout: LibraryLayout,
    site: Span,
) -> Result[String, Diagnostic]:
    match parts.get(position):
        None:
            Ok(directory)
        Some(part):
            match (
                names
                    .name_spelling(part)
                    .or_internal_error(
                        compiler_span(),
                        "import path references an invalid spelling identity",
                    )
            ):
                Ok(spelling):
                    stem = path_ops.join(directory, spelling)
                    if layout.stem_is_ambiguous(stem):
                        Err(ambiguous_stem_diagnostic(stem, site))
                    else:
                        stem.join_parts(parts, position + 1, names, layout, site)
                Err(error):
                    Err(error)


-- `a.brp` beside the folder `a/` would make the import `a` or `a/b` read two
-- ways, so an import path that passes through such a name is refused.
pure func ambiguous_stem_diagnostic(stem: String, site: Span) -> Diagnostic:
    diagnostic(
        site,
        "${stem}${LIBRARY_SUFFIX} sits beside the folder ${stem}/, so the import path names both a module and a folder",
        "rename one of them; a module that belongs with the folder can move into it",
    )


-- Whether the embedded paths hold both a module file and a folder for `stem`,
-- which is relative to the library root. Embedded paths are the files, so a
-- folder exists when some path starts with `stem/`.
pure func embedded_stem_is_ambiguous(paths: List[String], stem: String) -> Bool:
    folder = "${stem}/"
    paths
        .contains("${stem}${LIBRARY_SUFFIX}")
        .and(paths.any(pure func(path): path.starts_with(folder)))


-- The embedded library's answer for `stem`, which is None when the layout does
-- not embed it: a directory layout, or a user module's path.
pure func embedded_stem_ambiguity(
    layout: LibraryLayout,
    paths: List[String],
    stem: String,
) -> Option[Bool]:
    match from_opaque LibraryLayout(layout):
        ReadFromDirectory(_):
            None
        ReadFromEmbedded:
            prefix = embedded_contents().prefix
            if stem.starts_with(prefix):
                stem
                    .slice(prefix.length(), stem.length())
                    .map(pure func(relative): embedded_stem_is_ambiguous(paths, relative))
            else:
                None


-- Whether `stem` names both a module file and a folder, which would make an
-- import path through it (`a`, `a/b`) read two ways. On disk a folder counts
-- even if it holds no module; the embedded library records only library files,
-- so there a folder counts only when it holds one. A stem whose kind cannot be
-- read counts as absent: reading the module reports that failure.
private func stem_is_ambiguous(layout: LibraryLayout, stem: String) -> Bool:
    match embedded_stem_ambiguity(layout, EMBEDDED_LIBRARY_PATHS, stem):
        Some(ambiguous):
            ambiguous
        None:
            match "${stem}${LIBRARY_SUFFIX}".entry_kind():
                Ok(Some(File)):
                    match stem.entry_kind():
                        Ok(Some(Directory)): True
                        _: False
                _:
                    False


-- This projection belongs to source loading, where filesystem paths are needed.
-- Semantic import resolution receives ModuleId targets instead of these strings.
func import_path(
    importer: String,
    request: ParsedImport,
    names: NameTable,
    layout: LibraryLayout,
) -> Result[String, Diagnostic]:
    base = match request.path.origin:
        LibraryImport:
            layout_contents(layout).root
        RelativeImport(parents):
            var directory = path_ops.dirname(importer)
            var remaining = parents
            while remaining > 0:
                directory = path_ops.dirname(directory)
                remaining = remaining - 1
            directory
    directory ?= base.join_parts(request.path.parts, 0, names, layout, request.span)
    -- Already normal: the importer and library root are normalized, relative parents
    -- are resolved with dirname on that normal path, and the parser admits only
    -- identifier parts ("interior dot segments are rejected" in
    -- test_grammar/test_imports.brp), so normalizing again would only reallocate.
    Ok("${directory}${LIBRARY_SUFFIX}")


-- The site is the import that discovered the file; designated inputs have none.
-- The role is fixed when the module is queued and is its only role authority.
private record RequestedModule {
    id: ModuleId,
    path: String,
    role: ModuleKind,
    site: Option[Span],
}


private pure func designated(id: ModuleId, path: String, role: ModuleKind) -> RequestedModule:
    { id = id, path = path, role = role, site = None }


-- Return the first queued module with this path.
private pure func known_module(
    requests: List[RequestedModule],
    path: String,
) -> Option[RequestedModule]:
    var known: Option[RequestedModule] = None
    for request in requests:
        if request.path == path:
            known = Some(request)
            break
    known


-- Where a module's text comes from. Only library and foundation modules of
-- an embedded layout are embedded; every other module is a file.
private union ModuleStore:
    DiskFile
    -- The path relative to the library root.
    EmbeddedFile(String)


private pure func module_store(
    layout: LibraryLayout,
    role: ModuleKind,
    path: String,
) -> Result[ModuleStore, Diagnostic]:
    match from_opaque LibraryLayout(layout):
        ReadFromDirectory(_):
            Ok(DiskFile)
        ReadFromEmbedded:
            match role:
                UserModule:
                    Ok(DiskFile)
                FoundationTypesModule | FoundationPreludeModule | LibraryModule:
                    prefix = embedded_contents().prefix
                    relative = if path.starts_with(prefix):
                        path.slice(prefix.length(), path.length())
                    else:
                        None
                    match relative:
                        Some(inside):
                            Ok(EmbeddedFile(inside))
                        None:
                            Err(
                                internal_error(
                                    compiler_span(),
                                    "a library module of the embedded layout has a path outside the embedded root",
                                ),
                            )


-- The failure to read a module. `reason` is the file system's description of
-- the path, or "path: no such file" for an embedded file. A module with no
-- import site was named by the command line, or is a foundation input; the
-- advice differs, since only the second depends on the library source.
private pure func unreadable(reason: String, site: Option[Span], role: ModuleKind) -> Diagnostic:
    message = "could not read module ${reason}"
    match site:
        Some(import_site):
            diagnostic(
                import_site,
                message,
                "check the import path and provide a readable .brp file under its source root",
            )
        None:
            help = match role:
                UserModule:
                    "check the path and provide a readable .brp file"
                FoundationTypesModule | FoundationPreludeModule | LibraryModule:
                    "check that --library-root names a directory that holds the standard library"
            path_error(compiler_span(), message, help)


-- Supplied contents win over the disk, including empty or malformed ones.
private func read_override_or_disk(
    current: RequestedModule,
    overrides: SourceOverrides,
) -> Result[String, Diagnostic]:
    match from_opaque SourceOverrides(overrides).get(current.path):
        Some(contents):
            Ok(contents)
        None:
            match current.path.read_text():
                Ok(contents):
                    Ok(contents)
                Err(error):
                    -- to_string names the path: "missing.brp: no such file".
                    Err(unreadable(error.to_string(), current.site, current.role))


private func read_module(
    layout: LibraryLayout,
    current: RequestedModule,
    overrides: SourceOverrides,
) -> Result[String, Diagnostic]:
    store ?= module_store(layout, current.role, current.path)
    match store:
        DiskFile:
            current.read_override_or_disk(overrides)
        EmbeddedFile(relative):
            match embedded_library_file(relative):
                Some(contents): Ok(contents)
                None: Err(unreadable("${current.path}: no such file", current.site, current.role))


-- Everything loading threads through the queue. Each queued file yields exactly
-- one row, so the row count is the next file's queue position.
private record LoadState {
    layout: LibraryLayout,
    overrides: SourceOverrides,
    root_path: String,
    requests: List[RequestedModule],
    assembly: ParsedAssembly,
    modules: List[SourceFile],
}


-- The imports of one module resolved in written order. Every import yields
-- exactly one target, so the target count is the next import's position.
private record ImportCursor {
    layout: LibraryLayout,
    importer: RequestedModule,
    names: NameTable,
    imports: List[ParsedImport],
    requests: List[RequestedModule],
    targets: List[ModuleId],
}


-- User modules receive the prelude implicitly, so it is reserved, and a module
-- under the library root importing a user module would close a cycle through it.
-- Nested matches, not a tuple, so the host checks that every role is covered.
private pure func import_diagnostic(
    importer: ModuleKind,
    target: ModuleKind,
    span: Span,
) -> Option[Diagnostic]:
    match target:
        FoundationPreludeModule:
            Some(
                diagnostic(
                    span,
                    "the prelude cannot be imported explicitly",
                    "remove this import; user modules receive the prelude automatically",
                ),
            )
        FoundationTypesModule | LibraryModule:
            None
        UserModule:
            match importer:
                UserModule:
                    None
                FoundationTypesModule | FoundationPreludeModule | LibraryModule:
                    Some(
                        diagnostic(
                            span,
                            "a library module cannot import a user module",
                            "library modules may import only other library modules and _base",
                        ),
                    )


-- A permitted import yields its request: the queued one, or a new request with
-- its layout role. The root is queued first, as a user module wherever it lives.
private pure func import_allowed(
    cursor: ImportCursor,
    known: Option[RequestedModule],
    path: String,
    span: Span,
) -> Result[RequestedModule, Diagnostic]:
    role = match known:
        Some(queued): queued.role
        None: cursor.layout.module_role(path)
    match cursor.importer.role.import_diagnostic(role, span):
        Some(error):
            Err(error)
        None:
            match known:
                Some(queued):
                    Ok(queued)
                None:
                    match module_id(cursor.requests.length()):
                        Some(id): Ok({ id = id, path = path, role = role, site = Some(span) })
                        None: Err(internal_error(compiler_span(), "module inventory is too large"))


private func resolve_imports(cursor: ImportCursor) -> Result[ImportCursor, Diagnostic]:
    match cursor.imports.get(cursor.targets.length()):
        None:
            Ok(cursor)
        Some(request):
            match cursor.importer.path.import_path(request, cursor.names, cursor.layout):
                Ok(path):
                    known = cursor.requests.known_module(path)
                    match cursor.import_allowed(known, path, request.span):
                        Ok(target):
                            requests = match known:
                                Some(_): cursor.requests
                                None: cursor.requests.append(target)
                            resolve_imports(
                                { cursor |
                                    requests = requests,
                                    targets = cursor.targets.append(target.id),
                                },
                            )
                        Err(error):
                            Err(error)
                Err(error):
                    Err(error)


-- Parse one file, resolve its imports, and add it to the assembly.
private func link_module(
    state: LoadState,
    current: RequestedModule,
    contents: String,
) -> Result[LoadState, Diagnostic]:
    lexed ?= lex(current.id.module_source(), contents, state.assembly.assembly_names())
    parsed ?= lexed.parse_module(current.id)
    resolved ?= resolve_imports({
        layout = state.layout,
        importer = current,
        names = parsed.module_names(),
        imports = parsed.module_imports(),
        requests = state.requests,
        targets = [],
    })
    assembly ?= state.assembly.append_module(parsed, resolved.targets, current.role, current.path)
    Ok({ state | requests = resolved.requests, assembly = assembly })


-- Readable bytes stay in the failure's sources even when parsing fails, so the
-- diagnostic has a source to render against.
private func load_module(
    state: LoadState,
    current: RequestedModule,
) -> Result[LoadState, LoadFailure]:
    match state.layout.read_module(current, state.overrides):
        Err(error):
            Err(failure(state.modules, error))
        Ok(contents):
            display_path = if current.id == root_module_id():
                state.root_path
            else:
                current.path
            with_source = { state |
                modules = state.modules.append({ path = display_path, contents = contents }),
            }
            match with_source.link_module(current, contents):
                Err(error): Err(failure(with_source.modules, error))
                Ok(linked): Ok(linked)


-- Recursion depth is the module count, which follows the program's files. The host
-- handles tens of thousands of frames (30,000 ran, 50,000 overflowed the stack).
private func load_queue(state: LoadState) -> Result[LoadState, LoadFailure]:
    match state.requests.get(state.modules.length()):
        None:
            Ok(state)
        Some(current):
            match state.load_module(current):
                Ok(next): next.load_queue()
                Err(error): Err(error)


private union LoadMode:
    ApplicationInput
    -- The written paths of the test suite roots after the first, in order.
    TestSuiteInput(List[String])


-- Queue the exact configured-library path after ordinary loading, so existing
-- source IDs never move. A local file or alias spelling cannot supply this role.
private func load_test_entry(
    state: LoadState,
    grouped: List[RequestedModule],
) -> Result[LoadState, LoadFailure]:
    path = path_ops.join(layout_contents(state.layout).root, "test.brp")
    known = state.requests.known_module(path)
    id: ModuleId ?= match known:
        Some(request):
            Ok(request.id)
        None:
            match module_id(state.requests.length()):
                Some(present):
                    Ok(present)
                None:
                    Err(
                        failure(
                            state.modules,
                            internal_error(
                                compiler_span(),
                                "test library module identity exceeds the source inventory",
                            ),
                        ),
                    )
    pending: LoadState = match known:
        Some(_): state
        None: { state | requests = state.requests.append(designated(id, path, LibraryModule)) }
    loaded ?= pending.load_queue()
    match loaded.assembly.prepare_test_entry(
        grouped.map(pure func(request): request.id),
        id,
        foundation_types_module_id(),
    ):
        Err(error): Err(failure(loaded.modules, error))
        Ok(assembly): Ok({ loaded | assembly = assembly })


private IMPORT_CYCLE_HELP: String = "move the declarations both modules need into a third module that both import"


-- Source rows follow module ordinals, so each module in a cycle has a display path.
private pure func display_paths(
    sources: SourceInputs,
    cycle: List[ModuleId],
    paths: List[String],
) -> Result[List[String], Diagnostic]:
    match cycle.get(paths.length()):
        None:
            Ok(paths)
        Some(module):
            match (
                sources.modules
                    .get(module.module_number())
                    .or_internal_error(
                        compiler_span(),
                        "import cycle names a module without a source",
                    )
            ):
                Ok(file): sources.display_paths(cycle, paths.append(file.path))
                Err(error): Err(error)


-- The shell queries once; this projection owns failure before any source is read.
pure func working_directory_result(result: Result[String, String]) -> Result[String, LoadFailure]:
    match result:
        Ok(directory):
            Ok(directory)
        Err(error):
            Err(
                failure(
                    [],
                    path_error(
                        compiler_span(),
                        "could not determine current directory: ${error}",
                        "run the compiler from an accessible working directory",
                    ),
                ),
            )


-- Every queued path has one identity, role, read, and parse in this invocation.
func load_program(root_path: String, library: LibrarySource) -> Result[LoadedProgram, LoadFailure]:
    directory ?= get_current_directory().working_directory_result()
    root_path.load_input(library, ApplicationInput, directory, no_source_overrides())


func load_test_program(
    root_path: String,
    grouped_paths: List[String],
    library: LibrarySource,
) -> Result[LoadedProgram, LoadFailure]:
    directory ?= get_current_directory().working_directory_result()
    root_path.load_input(library, TestSuiteInput(grouped_paths), directory, no_source_overrides())


-- Raw paths are checked before normalization can erase an invalid component.
private pure func contains_nul(path: String, position: Int) -> Bool:
    match path.byte_at(position):
        Some(byte):
            if byte == 0:
                True
            else:
                path.contains_nul(position + 1)
        None:
            False


-- Rows are admitted in order, so the first bad row is the one reported.
private pure func admit_sources(
    working_directory: String,
    sources: List[SourceFile],
    admitted: Dict[String, String],
    position: Int,
) -> Result[Dict[String, String], SourceLoadFailure]:
    match sources.get(position):
        None:
            Ok(admitted)
        Some(source):
            if source.path.contains_nul(0):
                Err(SourcePathContainsNul(source.path))
            else:
                path = path_ops.normalize(path_ops.join(working_directory, source.path))
                if admitted.contains(path):
                    Err(DuplicateSourcePath(path))
                else:
                    working_directory.admit_sources(
                        sources,
                        admitted.set(path, source.contents),
                        position + 1,
                    )


-- The one constructor of a non-empty SourceOverrides.
private pure func source_overrides(
    working_directory: String,
    sources: List[SourceFile],
) -> Result[SourceOverrides, SourceLoadFailure]:
    admitted ?= working_directory.admit_sources(sources, empty(), 0)
    Ok(into_opaque SourceOverrides(admitted))


func load_program_with_sources(
    root_path: String,
    library: LibrarySource,
    sources: List[SourceFile],
) -> Result[LoadedProgram, SourceLoadFailure]:
    _: Void ?= if root_path.contains_nul(0):
        Err(SourcePathContainsNul(root_path))
    else:
        Ok(void)
    directory: String ?= match get_current_directory().working_directory_result():
        Ok(present): Ok(present)
        Err(error): Err(LoadingFailed(error))
    overrides ?= directory.source_overrides(sources)
    match root_path.load_input(library, ApplicationInput, directory, overrides):
        Ok(loaded): Ok(loaded)
        Err(error): Err(LoadingFailed(error))


-- The later test suite roots, queued after the foundation inputs in
-- command-line order. They are user modules wherever they live, like the first;
-- a path already queued, a foundation input included, would be one module twice.
private pure func queue_roots(
    working_directory: String,
    paths: List[String],
    queued: List[RequestedModule],
    later: List[RequestedModule],
) -> Result[List[RequestedModule], LoadFailure]:
    match paths.get(later.length()):
        None:
            Ok(later)
        Some(written):
            path = path_ops.normalize(path_ops.join(working_directory, written))
            requests = queued.concat(later)
            match (requests.known_module(path), module_id(requests.length())):
                (Some(_), _):
                    Err(
                        failure(
                            [],
                            diagnostic(
                                compiler_span(),
                                "test suite input ${written} is already part of this compilation",
                                "list each test suite file once; foundation inputs come from the standard library",
                            ),
                        ),
                    )
                (None, Some(id)):
                    working_directory.queue_roots(
                        paths,
                        queued,
                        later.append(designated(id, path, UserModule)),
                    )
                (None, None):
                    Err(
                        failure(
                            [],
                            internal_error(compiler_span(), "module inventory is too large"),
                        ),
                    )


private func load_input(
    root_path: String,
    library: LibrarySource,
    mode: LoadMode,
    working_directory: String,
    overrides: SourceOverrides,
) -> Result[LoadedProgram, LoadFailure]:
    layout = library_layout(library, working_directory)
    foundation = layout_contents(layout)
    root_file = path_ops.normalize(path_ops.join(working_directory, root_path))
    -- Only the foundation inputs are barred from being the application root.
    _: Void ?= match layout.module_role(root_file):
        FoundationTypesModule | FoundationPreludeModule:
            Err(
                failure(
                    [{ path = root_path, contents = "" }],
                    diagnostic(
                        { source = root_module_id().module_source(), start = 0, end = 0 },
                        "foundation modules cannot be application roots",
                        "choose an application module; foundation inputs come from the standard library",
                    ),
                ),
            )
        LibraryModule | UserModule:
            Ok(void)
    designated_inputs = [
        designated(root_module_id(), root_file, UserModule),
        designated(foundation_types_module_id(), foundation.types_path, FoundationTypesModule),
        designated(
            foundation_prelude_module_id(),
            foundation.prelude_path,
            FoundationPreludeModule,
        ),
    ]
    later: List[RequestedModule] ?= match mode:
        ApplicationInput: Ok([])
        TestSuiteInput(paths): working_directory.queue_roots(paths, designated_inputs, [])
    initial ?= load_queue({
        layout = layout,
        overrides = overrides,
        root_path = root_path,
        requests = designated_inputs.concat(later),
        assembly = begin_program(),
        modules = [],
    })
    loaded: LoadState ?= match mode:
        ApplicationInput: Ok(initial)
        TestSuiteInput(_): initial.load_test_entry(later)
    sources: SourceInputs = { modules = loaded.modules }
    match loaded.assembly.seal_program():
        Ok(program):
            Ok({ sources = sources, program = program })
        Err(MalformedBundle(error)):
            Err(failure(loaded.modules, error))
        -- Import cycles are banned; sealing reports the first at the import that closes it.
        Err(ImportCycle(cycle, closing)):
            match sources.display_paths(cycle, []):
                Err(error):
                    Err(failure(loaded.modules, error))
                Ok(paths):
                    Err(
                        failure(
                            loaded.modules,
                            diagnostic(
                                closing,
                                "import cycle: ${paths.join(" -> ")}",
                                IMPORT_CYCLE_HELP,
                            ),
                        ),
                    )
