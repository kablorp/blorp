-- IDs are scoped to one table and its extensions, never to another parse.
opaque type NameId = Int


implements Equatable for NameId:
    pure func equals(left: Self, right: Self) -> Bool:
        from_opaque NameId(left) == from_opaque NameId(right)


implements Hashable for NameId:
    pure func hash(value: Self) -> Int:
        from_opaque NameId(value)


fixed record SpecialNames {
    main: NameId,
    integer: NameId,
    float: NameId,
    string: NameId,
    unit: NameId,
    list: NameId,
}


-- Identifiers the parser recognises by identity where a declaration or
-- annotation begins: words the host also treats as names (GRAMMAR 1.4
-- reserves none of them). The program seed mints them, so every table
-- extended from it has these IDs.
fixed record ContextualWords {
    self_word: NameId,
    fixed_word: NameId,
    methods_word: NameId,
    int_word: NameId,
    float_word: NameId,
    string_word: NameId,
    void_word: NameId,
    list_word: NameId,
    tail_recursive_word: NameId,
}


-- The wired-in names of the foundation's designated unions and their
-- constructors, and of the canonical operator traits, Stringable and their
-- members. The foundation check finds Bool, Option and Result by these IDs in
-- the foundation module only, and the prelude selects Equatable, Orderable,
-- the arithmetic traits, Stringable and Dict by them. A Dict literal calls the functions of these names
-- that Dict's own module declares. Elsewhere they are ordinary names.
fixed record FoundationWords {
    equatable_word: NameId,
    equals_word: NameId,
    not_equals_word: NameId,
    orderable_word: NameId,
    less_than_word: NameId,
    greater_than_word: NameId,
    less_than_or_equal_word: NameId,
    greater_than_or_equal_word: NameId,
    addable_word: NameId,
    add_word: NameId,
    subtractable_word: NameId,
    subtract_word: NameId,
    multipliable_word: NameId,
    multiply_word: NameId,
    divisible_word: NameId,
    divide_word: NameId,
    modulable_word: NameId,
    remainder_word: NameId,
    negatable_word: NameId,
    negate_word: NameId,
    bool_word: NameId,
    true_word: NameId,
    false_word: NameId,
    option_word: NameId,
    some_word: NameId,
    none_word: NameId,
    result_word: NameId,
    ok_word: NameId,
    err_word: NameId,
    dict_word: NameId,
    empty_word: NameId,
    -- The function `dict`; `dict_word` is the type `Dict`.
    dict_function_word: NameId,
    set_word: NameId,
    stringable_word: NameId,
    to_string_word: NameId,
}


-- An ID is its spelling's position among `by_spelling`'s keys, and the
-- spelling's value is that same ID. Only `seed_word` and `intern_names` add
-- keys, each taking the ID from the length before its `set`; the seed's
-- spellings are distinct and `intern_names` sets only absent ones. Never
-- remove a name: positions would shift and `keys()` would copy. The table and
-- the seed's `words` live as long as the compilation.
private record NameRows {
    by_spelling: Dict[String, NameId],
    words: ContextualWords,
    foundation: FoundationWords,
}


opaque type NameTable = NameRows


-- `ids` holds the ID of each given spelling, in the given order.
record InternedNames {
    names: NameTable,
    ids: List[NameId],
}


record InitialNames {
    names: NameTable,
    special: SpecialNames,
}


record EntrypointNames {
    names: NameTable,
    main: NameId,
}


private record SeededWord {
    by_spelling: Dict[String, NameId],
    id: NameId,
}


-- Adds `spelling` to the seed and returns the ID it receives there.
private pure func seed_word(by_spelling: Dict[String, NameId], spelling: String) -> SeededWord:
    id = into_opaque NameId(by_spelling.length())
    { by_spelling = by_spelling.set(spelling, id), id = id }


pure func program_names() -> EntrypointNames:
    -- The executable entrypoint is an ABI spelling. Types come from the designated foundation module.
    main = seed_word({}, "main")
    fixed_word = main.by_spelling.seed_word("fixed")
    methods_word = fixed_word.by_spelling.seed_word("methods")
    int_word = methods_word.by_spelling.seed_word("Int")
    float_word = int_word.by_spelling.seed_word("Float")
    string_word = float_word.by_spelling.seed_word("String")
    void_word = string_word.by_spelling.seed_word("Void")
    list_word = void_word.by_spelling.seed_word("List")
    tail_recursive_word = list_word.by_spelling.seed_word("tail_recursive")
    bool_word = tail_recursive_word.by_spelling.seed_word("Bool")
    true_word = bool_word.by_spelling.seed_word("True")
    false_word = true_word.by_spelling.seed_word("False")
    option_word = false_word.by_spelling.seed_word("Option")
    some_word = option_word.by_spelling.seed_word("Some")
    none_word = some_word.by_spelling.seed_word("None")
    result_word = none_word.by_spelling.seed_word("Result")
    ok_word = result_word.by_spelling.seed_word("Ok")
    err_word = ok_word.by_spelling.seed_word("Err")
    self_word = err_word.by_spelling.seed_word("Self")
    equatable_word = self_word.by_spelling.seed_word("Equatable")
    equals_word = equatable_word.by_spelling.seed_word("equals")
    not_equals_word = equals_word.by_spelling.seed_word("not_equals")
    orderable_word = not_equals_word.by_spelling.seed_word("Orderable")
    less_than_word = orderable_word.by_spelling.seed_word("less_than")
    greater_than_word = less_than_word.by_spelling.seed_word("greater_than")
    less_than_or_equal_word = greater_than_word.by_spelling.seed_word("less_than_or_equal")
    greater_than_or_equal_word = less_than_or_equal_word.by_spelling.seed_word(
        "greater_than_or_equal",
    )
    addable_word = greater_than_or_equal_word.by_spelling.seed_word("Addable")
    add_word = addable_word.by_spelling.seed_word("add")
    subtractable_word = add_word.by_spelling.seed_word("Subtractable")
    subtract_word = subtractable_word.by_spelling.seed_word("subtract")
    multipliable_word = subtract_word.by_spelling.seed_word("Multipliable")
    multiply_word = multipliable_word.by_spelling.seed_word("multiply")
    divisible_word = multiply_word.by_spelling.seed_word("Divisible")
    divide_word = divisible_word.by_spelling.seed_word("divide")
    modulable_word = divide_word.by_spelling.seed_word("Modulable")
    remainder_word = modulable_word.by_spelling.seed_word("remainder")
    negatable_word = remainder_word.by_spelling.seed_word("Negatable")
    negate_word = negatable_word.by_spelling.seed_word("negate")
    dict_word = negate_word.by_spelling.seed_word("Dict")
    empty_word = dict_word.by_spelling.seed_word("empty")
    dict_function_word = empty_word.by_spelling.seed_word("dict")
    set_word = dict_function_word.by_spelling.seed_word("set")
    stringable_word = set_word.by_spelling.seed_word("Stringable")
    to_string_word = stringable_word.by_spelling.seed_word("to_string")
    words: ContextualWords = {
        self_word = self_word.id,
        fixed_word = fixed_word.id,
        methods_word = methods_word.id,
        int_word = int_word.id,
        float_word = float_word.id,
        string_word = string_word.id,
        void_word = void_word.id,
        list_word = list_word.id,
        tail_recursive_word = tail_recursive_word.id,
    }
    foundation: FoundationWords = {
        equatable_word = equatable_word.id,
        equals_word = equals_word.id,
        not_equals_word = not_equals_word.id,
        orderable_word = orderable_word.id,
        less_than_word = less_than_word.id,
        greater_than_word = greater_than_word.id,
        less_than_or_equal_word = less_than_or_equal_word.id,
        greater_than_or_equal_word = greater_than_or_equal_word.id,
        addable_word = addable_word.id,
        add_word = add_word.id,
        subtractable_word = subtractable_word.id,
        subtract_word = subtract_word.id,
        multipliable_word = multipliable_word.id,
        multiply_word = multiply_word.id,
        divisible_word = divisible_word.id,
        divide_word = divide_word.id,
        modulable_word = modulable_word.id,
        remainder_word = remainder_word.id,
        negatable_word = negatable_word.id,
        negate_word = negate_word.id,
        bool_word = bool_word.id,
        true_word = true_word.id,
        false_word = false_word.id,
        option_word = option_word.id,
        some_word = some_word.id,
        none_word = none_word.id,
        result_word = result_word.id,
        ok_word = ok_word.id,
        err_word = err_word.id,
        dict_word = dict_word.id,
        empty_word = empty_word.id,
        dict_function_word = dict_function_word.id,
        set_word = set_word.id,
        stringable_word = stringable_word.id,
        to_string_word = to_string_word.id,
    }
    {
        names = into_opaque NameTable({
            by_spelling = to_string_word.by_spelling,
            words = words,
            foundation = foundation,
        }),
        main = main.id,
    }


pure func contextual_words(names: NameTable) -> ContextualWords:
    from_opaque NameTable(names).words


pure func foundation_words(names: NameTable) -> FoundationWords:
    from_opaque NameTable(names).foundation


-- An ID's position in its table: a dense key for tables indexed by spelling identity.
pure func name_number(id: NameId) -> Int:
    from_opaque NameId(id)


-- Assembly checks the complete spelling-to-ID mapping before accepting a
-- lexer extension. Independent or stale extensions cannot silently mix IDs.
-- IDs are key positions, so equal key lists are equal mappings.
pure func same_name_table(left: NameTable, right: NameTable) -> Bool:
    (
        from_opaque NameTable(left).by_spelling.keys()
        == from_opaque NameTable(right).by_spelling.keys()
    )


pure func name_spelling(names: NameTable, id: NameId) -> Option[String]:
    from_opaque NameTable(names).by_spelling
        .keys()
        .get(from_opaque NameId(id))


-- Builds one extension locally: the first new spelling copies the shared
-- input table, and later ones grow the private copy in place.
pure func intern_names(names: NameTable, spellings: List[String]) -> InternedNames:
    rows = from_opaque NameTable(names)
    var known = rows.by_spelling
    var ids: List[NameId] = []

    for spelling in spellings:
        match known.get(spelling):
            Some(id):
                ids = ids.append(id)
            None:
                id = into_opaque NameId(known.length())
                ids = ids.append(id)
                known = known.set(spelling, id)

    { names = into_opaque NameTable({ rows | by_spelling = known }), ids = ids }
