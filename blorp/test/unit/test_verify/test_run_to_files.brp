import:
	../../../src/lower/lower as Lower
	../../../src/own/own as Own
	../../../src/specialize/specialize as Concrete
	../../../src/verify/verify: verify
	../run_to_files_inputs: process_seed
	../module_input: test_base
	int: Int methods
	string: String methods
	list: List methods
	bool: Bool methods
	test: TestSuite


pure func test_inserted_process_call_verifies() -> Bool:
	match process_seed(test_base()):
		Err(_): False
		Ok(seed):
			match Own.own(seed.lowered):
				Err(_): False
				Ok(program):
					match verify(program):
						Ok(_): True
						Err(_): False


pure func test_independent_verifier_rejects_string_in_list_slot() -> Bool:
	match process_seed(test_base()):
		Err(_): False
		Ok(seed):
			match Own.own(seed.lowered):
				Err(_): False
				Ok(program):
					match program.functions.get(Concrete.function_number(seed.query_id)):
						None: False
						Some(query):
							match query.operations:
								[first, second, third, fourth, fifth, Own.DefineValue(result)]:
									match result.operation:
										Own.CallDefinition(target, [program_arg, _, out, err, timeout]):
											wrong = { result | operation = Own.CallDefinition(target, [program_arg, program_arg, out, err, timeout]) }
											changed = { query | operations = [first, second, third, fourth, fifth, Own.DefineValue(wrong)] }
											functions = program.functions.set(Concrete.function_number(seed.query_id), changed)
											match verify({ program | functions = functions }):
												Ok(_): False
												Err(error): error.message.equals("ownership verification failed: call argument type does not match its contract").and(error.span.start.equals(result.span.start)).and(error.span.end.equals(result.span.end))
										_: False
								_: False


tests: TestSuite = {
	description = "Process builtin independent verification",
	tests = [
		("ordinary inserted process call verifies", test_inserted_process_call_verifies),
		("String cannot replace String list in raw owned IR", test_independent_verifier_rejects_string_in_list_slot),
	]
}
