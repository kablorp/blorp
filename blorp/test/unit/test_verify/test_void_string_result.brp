import:
	../../../src/own/own: own
	../../../src/verify/verify: verify
	../module_input: test_base
	../void_string_result_inputs: lowered_result
	test: TestSuite


pure func test_mixed_result_is_verified_without_a_builtin() -> Bool:
	lowered_result(test_base()).and_then(own).and_then(verify).is_ok()


tests: TestSuite = {
	description = "Blorp 2 ordinary Void/String Result verification",
	tests = [("ordinary mixed Result has complete ownership and payload proofs", test_mixed_result_is_verified_without_a_builtin)]
}
