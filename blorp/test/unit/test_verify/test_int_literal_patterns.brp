import:
    bool: Bool methods
    option: Option methods
    result: Result methods
    test: TestSuite
    ../../../src/own/own as Own
    ../../../src/utils/source: module_source, root_module_id
    ../../../src/utils/syntax: Diagnostic, LiteralPattern(ExactBytes, ExactInt)
    ../../../src/verify/verify: verify
    ../int_pattern_inputs: owned_int_patterns
    ../managed_union_inputs: lowered


-- A selection reports the scrutinee's definition: the parameter `text`, at
-- bytes 15 to 19.
private STRING_MATCH: String =
    |pure func flag(text: String) -> Int:
    |	match text:
    |		"x": 1
    |		_: 0
    |func main() -> Int:
    |	flag("x")
    |


private pure func owned(source: String) -> Result[Own.OwnershipProgram, Diagnostic]:
    program ?= lowered(source)
    Own.own(program)


-- The same program with every String literal test replaced by an Int one.
private pure func int_test_on_strings(program: Own.OwnershipProgram) -> Own.OwnershipProgram:
    functions = program.functions.map(pure func(function: Own.OwnedFunction) -> Own.OwnedFunction:
        operations = function.operations.map(
            pure func(operation: Own.OwnershipOperation) -> Own.OwnershipOperation:
                match operation:
                    Own.ExecuteJoin(join):
                        nodes = join.selection.nodes.map(
                            pure func(node: Own.OwnedDecisionNode) -> Own.OwnedDecisionNode:
                                match node:
                                    Own.TestLiteral(place, ExactBytes(_), yes, no):
                                        Own.TestLiteral(place, ExactInt(0), yes, no)
                                    _: node
                        )
                        Own.ExecuteJoin({ join | selection = { join.selection | nodes = nodes } })
                    _: operation
        )
        { function | operations = operations }
    )
    { program | functions = functions }


pure func test_int_literal_tests_on_int_places_verify() -> Bool:
    owned_int_patterns().and_then(verify).is_ok()


pure func test_an_int_literal_test_on_a_string_place_is_rejected() -> Bool:
    match owned(STRING_MATCH):
        Err(_): False
        Ok(program):
            match verify(int_test_on_strings(program)):
                Ok(_): False
                Err(error):
                    (error.message == "ownership verification failed: integer literal test requires an Int place")
                        .and(error.help == "report this compiler error with the input program")
                        .and(error.note.is_none())
                        .and(
                            (
                                error.span
                                == {
                                    source = module_source(root_module_id()),
                                    start = 15,
                                    end = 19,
                                }
                            ),
                        )


tests: TestSuite = {
    description = "Blorp Int literal pattern verification",
    tests = [
        ("Int literal tests on Int places verify", test_int_literal_tests_on_int_places_verify),
        (
            "an Int literal test on a String place is rejected",
            test_an_int_literal_test_on_a_string_place_is_rejected,
        ),
    ],
}
