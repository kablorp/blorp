import:
    bool: Bool methods
    int: Int methods
    list: List methods
    option: Option methods
    string: String methods
    test: TestSuite
    ../../../src/check/check: check
    ../../../src/check/render: render_failure
    ../../../src/utils/source: module_source, root_module_id
    ../module_input: parse_modules


private HELP: String = "declare an impure nongeneric function with two String parameters returning Result[Void, Int]"


private pure func body() -> String:
    "\n    builtin(\"fs.write_text\")\nfunc main() -> Int:\n    0\n"


private pure func accepts(header: String) -> Bool:
    match parse_modules([{ source = "${header}${body()}", targets = [] }]):
        Err(_): False
        Ok(parsed):
            match check(parsed):
                Ok(_): True
                Err(_): False


-- The declaration must be refused where the label is written, with the help
-- rendered from the operation's contract row.
private pure func rejects(header: String) -> Bool:
    match parse_modules([{ source = "${header}${body()}", targets = [] }]):
        Err(_): False
        Ok(parsed):
            match check(parsed):
                Ok(_): False
                Err(failure):
                    errors = render_failure(failure)
                    actual = errors.first
                    start = header.length() + ("\n    builtin(".length())
                    actual.message
                        .equals("builtin declaration does not match its runtime contract")
                        .and(actual.help.equals(HELP))
                        .and(actual.span.start.equals(start))
                        .and(actual.span.end.equals(start + ("\"fs.write_text\"".length())))
                        .and(actual.span.source == module_source(root_module_id()))
                        .and(errors.remaining.is_empty())
                        .and(actual.note.is_none())


pure func test_exact_contract_is_accepted() -> Bool:
    accepts("func store(path: String, text: String) -> Result[Void, Int]:")


-- A String error is not this contract: the native reports an Int code.
pure func test_string_error_is_rejected() -> Bool:
    rejects("func store(path: String, text: String) -> Result[Void, String]:")


pure func test_arity_parameters_and_payloads_are_closed() -> Bool:
    [
        "func store(path: String) -> Result[Void, Int]:",
        "func store(path: String, text: Int) -> Result[Void, Int]:",
        "func store(path: String, text: String) -> Result[Int, Int]:",
        "func store(path: String, text: String) -> Result[String, Int]:",
        "pure func store(path: String, text: String) -> Result[Void, Int]:",
        "func store[Element](path: String, text: String) -> Result[Void, Int]:",
    ].all(rejects)


tests: TestSuite = {
    description = "fs write builtin contract",
    tests = [
        ("the exact contract is accepted", test_exact_contract_is_accepted),
        ("fs.write_text returns an Int code, never a String error", test_string_error_is_rejected),
        (
            "fs.write_text takes two Strings, is impure and nongeneric, and succeeds with Void",
            test_arity_parameters_and_payloads_are_closed,
        ),
    ],
}
