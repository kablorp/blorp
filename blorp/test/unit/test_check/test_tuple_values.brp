import:
	../../../src/check/check: checked_functions
	../../../src/check/model as Checked
	../input: checked_source
	test: TestSuite


pure func test_tuple_literal_publishes_ordered_structural_types() -> Bool:
	source: String =
		|func main() -> Int:
		|    value = (1, "two", void)
		|    value[0]
		|
	match checked_source(source):
		Ok(program):
			match checked_functions(program).functions:
				[function]:
					match function.bindings:
						[binding]:
							match binding.value_type:
								Checked.TupleType([Checked.IntType, Checked.StringType, Checked.VoidType]): True
								_: False
						_: False
				_: False
		Err(_): False


pure func test_generic_tuple_argument_infers_each_member() -> Bool:
	source: String =
		|pure func first[A, B](value: (A, B)) -> A:
		|    value[0]
		|func main() -> Int:
		|    first((42, "answer"))
		|
	checked_source(source).is_ok()


pure func test_nested_tuple_hint_reaches_empty_list() -> Bool:
	source: String =
		|pure func value() -> (Int, (List[String], Int)):
		|    (1, ([], 2))
		|func main() -> Int:
		|    value()[1][1]
		|
	checked_source(source).is_ok()


pure func test_tuple_members_accept_contextual_callables() -> Bool:
	source: String =
		|pure func value() -> (pure (Int) -> Int, Int):
		|    (pure func(number): number, 2)
		|func main() -> Int:
		|    0
		|
	checked_source(source).is_ok()


pure func test_tuple_types_compare_order_and_arity() -> Bool:
	left = Checked.TupleType([Checked.IntType, Checked.StringType])
	(
		left == Checked.TupleType([Checked.IntType, Checked.StringType])
		and not (left == Checked.TupleType([Checked.StringType, Checked.IntType]))
		and not (left == Checked.TupleType([Checked.IntType, Checked.StringType, Checked.IntType]))
	)


private pure func rejects_index(prefix: String, marked: String, suffix: String, message: String, help: String) -> Bool:
	match checked_source(prefix + marked + suffix):
		Err(error):
			(
				error.span.start == prefix.length() and error.span.end == prefix.length() + marked.length()
				and error.message == message and error.help == help
			)
		Ok(_): False


pure func test_computed_index_has_exact_teaching_diagnostic() -> Bool:
	rejects_index("func main() -> Int:\n    pair = (1, 2)\n    index = 0\n    pair[", "index", "]\n",
		"a tuple index must be an integer literal", "use a literal index such as value[0], or destructure the tuple")


pure func test_out_of_range_index_names_the_valid_range() -> Bool:
	rejects_index("func main() -> Int:\n    pair = (1, 2)\n    pair[", "2", "]\n",
		"tuple index is out of range", "use a literal index from 0 through 1")


pure func test_index_on_scalar_rejects_at_index_expression() -> Bool:
	rejects_index("func main() -> Int:\n    value = 1\n    value[", "0", "]\n",
		"indexed field access requires a tuple", "use a tuple value with a literal index, such as value[0]")


pure func test_structural_tuple_does_not_coerce_to_named_record() -> Bool:
	rejects_index("record Pair { first: Int, second: Int }\nfunc main() -> Int:\n    value: Pair = ", "(1, 2)", "\n    0\n",
		"expression does not match the expected type", "use an expression of type Pair here")


pure func test_contextual_tuple_rejects_wrong_member_type() -> Bool:
	rejects_index("pure func pair() -> (Int, String):\n    ", "(1, 2)", "\nfunc main() -> Int:\n    0\n",
		"expression does not match the expected type", "use an expression of type (Int, String) here")


tests: TestSuite = {
	description = "Blorp 2 structural tuple values and inference",
	tests = [
		("computed tuple index teaches literal access", test_computed_index_has_exact_teaching_diagnostic),
		("out-of-range tuple index teaches valid range", test_out_of_range_index_names_the_valid_range),
		("scalar index rejects at index expression", test_index_on_scalar_rejects_at_index_expression),
		("tuples do not coerce to named records", test_structural_tuple_does_not_coerce_to_named_record),
		("tuple annotation checks every member", test_contextual_tuple_rejects_wrong_member_type),
		("tuple literal retains ordered structural types", test_tuple_literal_publishes_ordered_structural_types),
		("generic tuple arguments infer every member", test_generic_tuple_argument_infers_each_member),
		("nested tuple hints reach empty Lists", test_nested_tuple_hint_reaches_empty_list),
		("tuple members receive callable context", test_tuple_members_accept_contextual_callables),
		("tuple equality includes order and arity", test_tuple_types_compare_order_and_arity),
	]
}
