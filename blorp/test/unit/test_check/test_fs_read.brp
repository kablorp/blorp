import:
    bool: Bool methods
    int: Int methods
    list: List methods
    option: Option methods
    string: String methods
    test: TestSuite
    ../../../src/check/check: check
    ../../../src/check/render: render_failure
    ../../../src/utils/source: module_source, root_module_id
    ../module_input: parse_modules


private HELP_READ_TEXT: String = "declare an impure nongeneric function with one String parameter returning Result[String, Int]"


private HELP_ENTRY_KIND: String = "declare an impure nongeneric function with one String parameter returning Result[Int, Int]"


private pure func body_for(label: String) -> String:
    "\n    builtin(\"${label}\")\nfunc main() -> Int:\n    0\n"


private pure func accepts(header: String, label: String) -> Bool:
    match parse_modules([{ source = "${header}${body_for(label)}", targets = [] }]):
        Err(_): False
        Ok(parsed):
            match check(parsed):
                Ok(_): True
                Err(_): False


-- The declaration must be refused where the label is written, with the help
-- rendered from the operation's contract row.
private pure func rejects(header: String, label: String, help: String) -> Bool:
    match parse_modules([{ source = "${header}${body_for(label)}", targets = [] }]):
        Err(_): False
        Ok(parsed):
            match check(parsed):
                Ok(_): False
                Err(failure):
                    errors = render_failure(failure)
                    actual = errors.first
                    start = header.length() + ("\n    builtin(".length())
                    actual.message
                        .equals("builtin declaration does not match its runtime contract")
                        .and(actual.help.equals(help))
                        .and(actual.span.start.equals(start))
                        .and(actual.span.end.equals(start + ("\"${label}\"".length())))
                        .and(actual.span.source == module_source(root_module_id()))
                        .and(errors.remaining.is_empty())
                        .and(actual.note.is_none())


private pure func read_text_rejects(header: String) -> Bool:
    rejects(header, "fs.read_text", HELP_READ_TEXT)


private pure func entry_kind_rejects(header: String) -> Bool:
    rejects(header, "fs.entry_kind", HELP_ENTRY_KIND)


pure func test_exact_contracts_are_accepted() -> Bool:
    accepts("func query(path: String) -> Result[String, Int]:", "fs.read_text").and(
        accepts("func query(path: String) -> Result[Int, Int]:", "fs.entry_kind"),
    )


pure func test_read_text_arity_and_parameter_are_closed() -> Bool:
    [
        "func query() -> Result[String, Int]:",
        "func query(path: Int) -> Result[String, Int]:",
        "func query(path: String, extra: String) -> Result[String, Int]:",
        "func query(paths: List[String]) -> Result[String, Int]:",
    ].all(read_text_rejects)


-- A String error is not this contract: the native reports an Int code.
pure func test_read_text_payloads_are_closed() -> Bool:
    [
        "func query(path: String) -> Result[String, String]:",
        "func query(path: String) -> Result[Int, Int]:",
        "func query(path: String) -> Result[Void, Int]:",
    ].all(read_text_rejects)


pure func test_read_text_purity_and_generics_are_closed() -> Bool:
    [
        "pure func query(path: String) -> Result[String, Int]:",
        "func query[Element](path: String) -> Result[String, Int]:",
    ].all(read_text_rejects)


pure func test_entry_kind_arity_and_parameter_are_closed() -> Bool:
    [
        "func query() -> Result[Int, Int]:",
        "func query(path: Int) -> Result[Int, Int]:",
        "func query(path: String, extra: String) -> Result[Int, Int]:",
    ].all(entry_kind_rejects)


pure func test_entry_kind_payloads_are_closed() -> Bool:
    [
        "func query(path: String) -> Result[Int, String]:",
        "func query(path: String) -> Result[String, Int]:",
        "func query(path: String) -> Result[Void, Int]:",
    ].all(entry_kind_rejects)


pure func test_entry_kind_purity_and_generics_are_closed() -> Bool:
    [
        "pure func query(path: String) -> Result[Int, Int]:",
        "func query[Element](path: String) -> Result[Int, Int]:",
    ].all(entry_kind_rejects)


tests: TestSuite = {
    description = "fs builtin contracts",
    tests = [
        ("each exact contract is accepted", test_exact_contracts_are_accepted),
        ("fs.read_text takes one String", test_read_text_arity_and_parameter_are_closed),
        (
            "fs.read_text returns a String or an Int code, never a String error",
            test_read_text_payloads_are_closed,
        ),
        ("fs.read_text is impure and nongeneric", test_read_text_purity_and_generics_are_closed),
        ("fs.entry_kind takes one String", test_entry_kind_arity_and_parameter_are_closed),
        ("fs.entry_kind returns an Int kind or an Int code", test_entry_kind_payloads_are_closed),
        ("fs.entry_kind is impure and nongeneric", test_entry_kind_purity_and_generics_are_closed),
    ],
}
