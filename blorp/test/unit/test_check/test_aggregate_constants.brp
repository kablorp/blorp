import:
	../../../src/check/check: checked_functions
	../../../src/check/model as Model
	../../../src/utils/ids: function_number, variant_owner
	../../../src/utils/syntax: Purity(Impure)
	../input: checked_source
	test: TestSuite


private AGGREGATE: String =
	|record Bundle { pair: (Int, String), values: List[String], run: pure (Int) -> Int }
	|pure func identity[T](value: T) -> T:
	|    value
	|VALUE: Bundle = { pair = (7, "seven"), values = ["left", "right"], run = identity }
	|pure func fetch() -> Bundle:
	|    VALUE
	|func main() -> Int:
	|    0
	|


pure func test_closed_aggregate_keeps_tuple_list_and_genuine_generic_callback() -> Bool:
	match checked_source(AGGREGATE):
		Err(_): False
		Ok(program):
			match checked_functions(program).functions:
				[identity, fetch, _]:
					match fetch.body:
						Model.CheckedValueBody(Model.ReturnExpression(value)):
							match value.form:
								Model.ConstructRecord(owner, [pair, values, callback]):
									match (pair.value.form, values.value.form, callback.value.form):
										(Model.ConstructTuple([number, text]), Model.ConstructList([left, right]), Model.MakeCallable(Model.NamedCallable(target, [argument]))):
											match (number.form, text.form, left.form, right.form):
												(Model.LiteralInteger(7), Model.LiteralString("seven"), Model.LiteralString("left"), Model.LiteralString("right")):
													(value.value_type == Model.NominalType(Model.AggregateNominal(Model.RecordAggregate(owner)), [])
														and function_number(target) == function_number(identity.id)
														and argument == Model.IntType
														and Some(value.span.start) == AGGREGATE.index_of("VALUE\n"))
												_: False
										_: False
								_: False
						_: False
				_: False


pure func test_callable_constant_uses_stored_invocation_and_declared_purity_view() -> Bool:
	source: String =
		|pure func identity[T](value: T) -> T:
		|    value
		|CALLBACK: (Int) -> Int = identity
		|func main() -> Int:
		|    CALLBACK(7)
		|
	match checked_source(source):
		Err(_): False
		Ok(program):
			match checked_functions(program).functions:
				[identity, main]:
					match main.body:
						Model.CheckedValueBody(Model.ReturnExpression(value)):
							match value.form:
								Model.InvokeFunction(call):
									match (call.target, call.operands):
										(Model.ValueCall(callee), [Model.ValueOperand(argument)]):
											match (callee.form, argument.form):
												(Model.MakeCallable(Model.NamedCallable(target, [actual])), Model.LiteralInteger(7)):
													(function_number(target) == function_number(identity.id)
														and actual == Model.IntType
														and callee.value_type == Model.CallableType(Impure, [Model.IntType], Model.IntType))
												_: False
										_: False
								_: False
						_: False
				_: False


pure func test_nested_union_void_and_empty_list_keep_their_annotated_types() -> Bool:
	source: String =
		|union Choice:
		|    Number(Int)
		|    Empty
		|VALUE: (Choice, Void, List[Int]) = (Number(7), void, [])
		|pure func fetch() -> (Choice, Void, List[Int]):
		|    VALUE
		|func main() -> Int:
		|    0
		|
	match checked_source(source):
		Err(_): False
		Ok(program):
			match checked_functions(program).functions:
				[fetch, _]:
					match fetch.body:
						Model.CheckedValueBody(Model.ReturnExpression(value)):
							match value.form:
								Model.ConstructTuple([choice, unit, empty]):
									match (choice.form, unit.form, empty.form):
										(Model.ConstructVariant(variant, [number]), Model.LiteralVoid, Model.ConstructList([])):
											match number.form:
												Model.LiteralInteger(7):
													(choice.value_type == Model.NominalType(Model.AggregateNominal(Model.UnionAggregate(variant_owner(variant))), [])
														and unit.value_type == Model.VoidType
														and empty.value_type == Model.ListType(Model.IntType)
														and value.value_type == Model.TupleType([choice.value_type, unit.value_type, empty.value_type]))
												_: False
										_: False
								_: False
						_: False
				_: False


tests: TestSuite = {
	description = "Closed aggregate constant checking",
	tests = [
		("closed aggregate retains tuple List and genuine generic callback", test_closed_aggregate_keeps_tuple_list_and_genuine_generic_callback),
		("callable constant invokes stored value with declared purity", test_callable_constant_uses_stored_invocation_and_declared_purity_view),
		("nested union Void and empty List retain annotation types", test_nested_union_void_and_empty_list_keep_their_annotated_types),
	]
}
