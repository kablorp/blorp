import:
	../../../src/check/check: CheckedProgram, check
	../../../src/utils/syntax: Diagnostic
	../input: setup_diagnostic
	../module_input: test_base, parse_modules_with_base
	result: map_err
	test: TestSuite


private pure func checked_source(source: String) -> Result[CheckedProgram, Diagnostic]:
	parsed ?= parse_modules_with_base([{ source = source, targets = [] }], test_base())
	check(parsed).map_err(setup_diagnostic)


-- Reduced from check/inference.brp's nested lookup of an existing hint.
pure func test_nested_option_pattern_keeps_the_inner_capture() -> Bool:
	source: String =
		|pure func hint(value: Option[Option[Int]]) -> Int:
		|    match value:
		|        Some(Some(previous)): previous
		|        _: 0
		|func main() -> Int:
		|    hint(Some(Some(42)))
		|
	checked_source(source).is_ok()


-- Reduced from check/declarations.brp's singleton generic argument list.
pure func test_exact_singleton_list_does_not_cover_other_lengths() -> Bool:
	source: String =
		|pure func choose(values: List[Int]) -> Int:
		|    match values:
		|        []: 0
		|        [element]: element
		|        _: 2
		|func main() -> Int:
		|    choose([42])
		|
	checked_source(source).is_ok()


-- Reduced from check/render.brp's recursive first/rest renderers.
pure func test_list_rest_capture_has_the_original_list_type() -> Bool:
	source: String =
		|pure func rest(values: List[String]) -> List[String]:
		|    match values:
		|        []: []
		|        [first, ...remaining]: remaining
		|func main() -> Int:
		|    0
		|
	checked_source(source).is_ok()


-- Reduced from main.brp's exact command-line shape and literal option name.
pure func test_string_test_inside_exact_list_keeps_following_binders() -> Bool:
	source: String =
		|pure func input(args: List[String]) -> String:
		|    match args:
		|        [_, "--library-root", library_root, input_path, output_path]: input_path
		|        _: ""
		|func main() -> Int:
		|    0
		|
	checked_source(source).is_ok()


-- Reduced from lex/lex.brp's keyword table; byte-sensitive values extend it.
pure func test_string_patterns_preserve_utf8_and_embedded_nul() -> Bool:
	source = "pure func keyword(text: String) -> Int:\n    match text:\n        \"func\": 1\n        \"é\\0x\": 2\n        _: 0\nfunc main() -> Int:\n    0\n"
	checked_source(source).is_ok()


-- Reduced from check/model.brp's grouped non-binding type constructors.
pure func test_nonbinding_alternatives_keep_one_useful_arm() -> Bool:
	source: String =
		|union Type:
		|    Parameter(Int)
		|    Callable(Int, Int)
		|    Plain
		|pure func classify(value: Type) -> Int:
		|    match value:
		|        Parameter(_) | Callable(_, _): 1
		|        Plain: 0
		|func main() -> Int:
		|    classify(Plain)
		|
	checked_source(source).is_ok()


-- Binding identity is semantic: corresponding captures need not occupy the
-- same constructor field, but both occurrences must have the same type.
pure func test_alternative_binders_can_have_different_field_ordinals() -> Bool:
	source: String =
		|union Side:
		|    Left(String, Int)
		|    Right(Int, String)
		|pure func selected(value: Side) -> String:
		|    match value:
		|        Left(item, _) | Right(_, item): item
		|func main() -> Int:
		|    0
		|
	checked_source(source).is_ok()


pure func test_overlapping_nested_arms_keep_ordered_fallthrough() -> Bool:
	source: String =
		|pure func choose(value: Option[Option[Int]]) -> Int:
		|    match value:
		|        Some(Some(number)): number
		|        Some(None): 7
		|        None: 0
		|func main() -> Int:
		|    choose(Some(None))
		|
	checked_source(source).is_ok()


tests: TestSuite = {
	description = "Compiler-source structural pattern admission",
	tests = [
		("nested Option binds the inner value", test_nested_option_pattern_keeps_the_inner_capture),
		("exact singleton preserves other lengths", test_exact_singleton_list_does_not_cover_other_lengths),
		("rest capture retains its List type", test_list_rest_capture_has_the_original_list_type),
		("String test inside an exact List", test_string_test_inside_exact_list_keeps_following_binders),
		("String patterns retain UTF8 and NUL bytes", test_string_patterns_preserve_utf8_and_embedded_nul),
		("nonbinding alternatives share an arm", test_nonbinding_alternatives_keep_one_useful_arm),
		("alternative binders use semantic field types", test_alternative_binders_can_have_different_field_ordinals),
		("nested overlapping arms preserve fallthrough", test_overlapping_nested_arms_keep_ordered_fallthrough),
	]
}
