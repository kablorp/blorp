import:
	../../../src/check/check: check_errors, checked_functions
	../../../src/check/model as Model
	../../../src/utils/ids: function_number
	../../../src/utils/syntax: Purity(Pure)
	../../../src/check/errors as Errors
	../../../src/check/render: render_check_error
	../../../src/utils/source: module_source, root_module_id
	../input: check, singleton_check_error
	../module_input: parse_modules
	test: TestSuite


private pure func rejects_callback(prefix: String, callback: String, suffix: String) -> Bool:
	match parse_modules([{ source = prefix + callback + suffix, targets = [] }]):
		Err(_): False
		Ok(program):
			match check(program):
				Ok(_): False
				Err(failure):
					match singleton_check_error(check_errors(failure)):
						Some(error):
							match error.kind:
								Errors.TypeTermRejection(Errors.UnknownType(_)):
									diagnostic = render_check_error(program, error)
									(
										error.span.source == module_source(root_module_id())
										and error.span.start == prefix.length() and error.span.end == prefix.length() + callback.length()
										and diagnostic.span.source == error.span.source
										and diagnostic.span.start == error.span.start and diagnostic.span.end == error.span.end
										and diagnostic.message == "unknown type"
										and diagnostic.help == "declare or import this type; builtin types and declared type parameters are also available"
										and diagnostic.note.is_none()
									)
								_: False
						None: False


private pure func nested_return_facts() -> Bool:
	source =
		|pure func make() -> pure (Int) -> pure () -> Int:
		|    pure func(value: Int) -> pure () -> Int:
		|        pure func() -> Int: value
		|func main() -> Int:
		|    0
	match parse_modules([{ source = source, targets = [] }]):
		Err(_): False
		Ok(parsed):
			match check(parsed):
				Err(_): False
				Ok(program):
					match (checked_functions(program).functions, checked_functions(program).lambdas):
						([make, _], [outer, inner]):
							match make.signature.return_type.value_type:
								Model.CallableType(Pure, [Model.IntType], Model.CallableType(Pure, [], Model.IntType)):
									match (make.body, outer.body, inner.body):
										(Model.CheckedValueBody(Model.ReturnExpression(created)), Model.CheckedValueBody(Model.ReturnExpression(returned)), Model.CheckedValueBody(Model.ReturnExpression(read))):
											match (created.form, returned.form, read.form):
												(Model.MakeCallable(Model.LambdaCallable(first, [])), Model.MakeCallable(Model.LambdaCallable(second, [operand])), Model.ReadCapture(id)):
													match (operand.form, operand.value_type):
														(Model.ReadBinding(binding), Model.IntType):
															match inner.captures:
																[capture]:
																	(Model.binding_number(binding) == 0 and Model.lambda_number(first) == 0 and Model.lambda_number(second) == 1
																		and Model.lambda_number(Model.capture_owner(id)) == 1 and Model.capture_number(id) == 0
																		and capture.binding.owner == Model.LambdaBody(first)
																		and Model.binding_number(capture.binding.binding) == 0
																		and capture.value_type.value_type == Model.IntType
																		and outer.root == make.id
																		and inner.root == make.id)
																_: False
														_: False
												_: False
										_: False
								_: False
						_: False



pure func test_nested_callable_return_preserves_captures_and_rejects_unknown_children() -> Bool:
	-- Callable placement is supported; the original unresolved child still fails.
	nested_return_facts() and rejects_callback("func make() -> pure (", "MissingInput", ") -> pure () -> MissingOutput:\n\t0\n")


pure func test_named_generic_callback() -> Bool:
	source: String =
		|pure func identity[T](value: T) -> T:
		|	value
		|
		|pure func apply[T, U](value: T, f: pure (T) -> U) -> U:
		|	f(value)
		|
		|func main() -> Int:
		|	apply(17, identity)
		|
	match parse_modules([{ source = source, targets = [] }]):
		Err(_): False
		Ok(program): check(program).is_ok()


pure func test_named_callback_infers_a_callable_type_argument() -> Bool:
	declarations: String =
		|pure func higher(g: pure (Int) -> Int) -> Int:
		|	g(1)
		|pure func ignore[T](f: pure (T) -> Int) -> Int:
		|	0
		|func main() -> Int:
		|
	prefix = declarations + "\tignore("
	match parse_modules([{ source = prefix + "higher)\n", targets = [] }]):
		Err(_): False
		Ok(parsed):
			match check(parsed):
				Err(_): False
				Ok(program):
					match checked_functions(program).functions:
						[higher, ignore, main]:
							match main.body:
								Model.CheckedValueBody(Model.ReturnExpression(value)):
									match value.form:
										Model.InvokeFunction(call):
											match (call.target, call.operands):
												(Model.UserFunction(target, [Model.CallableType(Pure, [Model.IntType], Model.IntType)]), [Model.CallableOperand(formal, Model.NamedCallable(named, []), _)]):
													(function_number(target) == 1 and function_number(ignore.id) == 1
														and function_number(named) == 0 and function_number(higher.id) == 0
														and formal == Model.callable_parameter(ignore.id, 0))
												_: False
										_: False
								_: False
						_: False



tests: TestSuite = {
	description = "Callable parameters, storage and nested types",
	tests = [
		("named callback infers a callable type argument", test_named_callback_infers_a_callable_type_argument),
		("named generic callback", test_named_generic_callback),
		("nested callable return preserves captures and rejects unknown children", test_nested_callable_return_preserves_captures_and_rejects_unknown_children),
	]
}
