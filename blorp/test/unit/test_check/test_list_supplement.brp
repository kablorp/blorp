import:
	../../../src/load/load: load_program
	../../../src/parse/assemble: parsed_contents
	../../../src/check/check: check, checked_functions, check_errors
	../../../src/check/model as Model
	../../../src/check/errors as Errors
	../../../src/utils/ids: inventory_functions, inventory_unions, function_number, union_number, VariantId
	../../../src/utils/names: name_spelling, foundation_words
	../../../src/utils/source: module_source, root_module_id
	../../../src/utils/syntax: Purity(Pure)
	../input: setup_diagnostic, singleton_check_error, checked_tail_join
	fs: temporary_directory, resource_path, message
	system: temp_dir, write_file
	test: TestSuite


private func with_helpers(assertions: pure (List[Model.CheckedFunction], Model.CheckedUnion, Model.CheckedUnion) -> Bool) -> Bool:
	match load_program("blorp/test/e2e/fixtures/list/supplement/predicates.brp", "blorp/standard_library"):
		Err(_): False
		Ok(loaded):
			parsed = parsed_contents(loaded.program)
			match (parsed.modules.filter(pure func(row): row.module == root_module_id()), check(loaded.program)):
				([root], Ok(program)):
					rows = checked_functions(program)
					list_imports = root.imports.filter(pure func(request): request.path.parts.map(pure func(part): name_spelling(parsed.names, part)) == [Some("list")])
					booleans = inventory_unions(parsed.declarations).filter(pure func(row):
						row.module == parsed.foundation.types and row.type_name.id == foundation_words(parsed.names).bool_word
					)
					optionals = inventory_unions(parsed.declarations).filter(pure func(row): row.module == parsed.foundation.types and row.type_name.id == foundation_words(parsed.names).option_word)
					match (list_imports, booleans, optionals):
						([list_import], [boolean], [optional]):
							-- Literal API names select issued IDs only within this loaded List module.
							helpers = ["take", "drop", "remove", "reverse", "find", "all"].map(pure func(name):
								declarations = inventory_functions(parsed.declarations).filter(pure func(row):
									row.declaration.module == list_import.target and name_spelling(parsed.names, row.declaration.function_name.id) == Some(name)
								)
								match declarations:
									[declaration]: rows.functions.get(function_number(declaration.id))
									_: None
							)
							match (helpers, rows.unions.get(union_number(boolean.id)), rows.unions.get(union_number(optional.id))):
								([Some(taken), Some(dropped), Some(removed), Some(reversed), Some(found), Some(every)], Some(owner), Some(optional)):
									assertions([taken, dropped, removed, reversed, found, every], owner, optional)
								_: False
						_: False
				_: False


private pure func owns_rigids(function: Model.CheckedFunction) -> Bool:
	function.signature.purity == Pure and function.signature.type_parameters.all(pure func(parameter):
		match Model.parameter_owner(parameter):
			Model.FunctionDeclaration(owner): function_number(owner) == function_number(function.id)
			_: False
	)


func test_supplement_signatures_keep_owned_rigids_and_foundation_types() -> Bool:
	with_helpers(pure func(functions, boolean, optional):
		match functions:
			[taken, dropped, removed, reversed, found, every]:
				functions.all(owns_rigids) and [taken, dropped, removed, reversed, found, every].all(pure func(function):
					match function.signature.type_parameters:
						[element]:
							value_type = Model.ParameterType(element)
							list_type = Model.ListType(value_type)
							if function_number(function.id) == function_number(reversed.id):
								match function.signature.parameters:
									[values]: values.value_type == list_type and function.signature.return_type.value_type == list_type
									_: False
							else:
								match function.signature.parameters:
									[values, argument]:
										callback = function_number(function.id) == function_number(found.id) or function_number(function.id) == function_number(every.id)
										expected_argument = if callback:
											Model.CallableType(Pure, [value_type], Model.NominalType(Model.AggregateNominal(Model.UnionAggregate(boolean.id)), []))
										else:
											Model.IntType
										expected_result = if function_number(function.id) == function_number(found.id):
											Model.NominalType(Model.AggregateNominal(Model.UnionAggregate(optional.id)), [value_type])
										else if function_number(function.id) == function_number(every.id):
											Model.NominalType(Model.AggregateNominal(Model.UnionAggregate(boolean.id)), [])
										else if function_number(function.id) == function_number(removed.id):
											Model.NominalType(Model.AggregateNominal(Model.UnionAggregate(optional.id)), [list_type])
										else:
											list_type
										values.value_type == list_type and argument.value_type == expected_argument and function.signature.return_type.value_type == expected_result
									_: False
						_: False
				)
			_: False
	)



private NEGATIVE_MAIN: String =
	|import:
	|    list: find, all
	|pure func predicate(value: Int) -> Bool:
	|    True
	|pure func string_predicate(value: String) -> Bool:
	|    True
	|pure func integer(value: Int) -> Int:
	|    value
	|pure func binary(first: Int, second: Int) -> Bool:
	|    True
	|func impure(value: Int) -> Bool:
	|    True
	|func main() -> Int:
	|
private END: String =
	|
	|    0
	|


private func rejects(prefix: String, marked: String, suffix: String, help: String, kind_matches: pure (Errors.CheckErrorKind) -> Bool) -> Result[Bool, String]:
	with directory ?= temporary_directory(temp_dir(), "blorp-2-list-supplement-negative-") on error => message(error):
		path = directory.resource_path() + "/main.brp"
		written ?= write_file(path, prefix + marked + suffix + END)
		loaded ?= load_program(path, "blorp/standard_library").map_err(func(failure): failure.diagnostic.message)
		match check(loaded.program):
			Ok(_): Ok(False)
			Err(failure):
				diagnostic = setup_diagnostic(failure)
				match singleton_check_error(check_errors(failure)):
					None: Ok(False)
					Some(error):
						message = match error.kind:
							Errors.CallRejection(Errors.ImpureCallback(_)): "pure callback requires a pure function"
							_: "argument type does not match the parameter type"
						Ok(
							kind_matches(error.kind) and diagnostic.message == message and diagnostic.help == help and diagnostic.note.is_none()
							and error.span.source == module_source(root_module_id())
							and error.span.start == prefix.length() and error.span.end == prefix.length() + marked.length()
							and diagnostic.span.source == error.span.source
							and diagnostic.span.start == error.span.start and diagnostic.span.end == error.span.end
						)


func test_find_predicate_input_agrees_with_the_list() -> Bool:
	rejects(NEGATIVE_MAIN + "    find([1], ", "string_predicate", ")", "use an expression of type pure (Int) -> Bool here", pure func(kind):
		match kind:
			Errors.CallRejection(Errors.GenericArgumentConflict(conflict)):
				match (conflict.mismatch.expected, conflict.mismatch.actual.value_type):
					(Model.CallableType(Pure, [Model.IntType], expected), Model.CallableType(Pure, [Model.StringType], actual)):
						(conflict.mismatch.argument_position == 1 and expected == actual and conflict.previous.value_type == Model.IntType and conflict.current.value_type == Model.StringType
							and conflict.previous.span.source == module_source(root_module_id())
							and conflict.previous.span.start == (NEGATIVE_MAIN + "    find(").length() and conflict.previous.span.end == (NEGATIVE_MAIN + "    find([1]").length()
							and conflict.current.span.source == module_source(root_module_id())
							and conflict.current.span.start == (NEGATIVE_MAIN + "    find([1], ").length() and conflict.current.span.end == (NEGATIVE_MAIN + "    find([1], string_predicate").length())
					_: False
			_: False
	).get_or(False)


func test_find_predicate_result_is_bool() -> Bool:
	rejects(NEGATIVE_MAIN + "    find([1], ", "integer", ")", "use an expression of type pure (Int) -> Bool here", pure func(kind):
		match kind:
			Errors.CallRejection(Errors.ArgumentTypeMismatch(mismatch)):
				match (mismatch.expected, mismatch.actual.value_type):
					(Model.CallableType(Pure, [Model.IntType], Model.NominalType(Model.AggregateNominal(Model.UnionAggregate(_)), [])), Model.CallableType(Pure, [Model.IntType], Model.IntType)): mismatch.argument_position == 1
					_: False
			_: False
	).get_or(False)


func test_find_predicate_must_be_pure() -> Bool:
	rejects(NEGATIVE_MAIN + "    find([1], ", "impure", ")", "pass a pure named function; impure functions cannot satisfy a pure callable parameter", pure func(kind):
		match kind:
			Errors.CallRejection(Errors.ImpureCallback(_)): True
			_: False
	).get_or(False)


func test_all_predicate_input_agrees_with_the_list() -> Bool:
	rejects(NEGATIVE_MAIN + "    all([1], ", "string_predicate", ")", "use an expression of type pure (Int) -> Bool here", pure func(kind):
		match kind:
			Errors.CallRejection(Errors.GenericArgumentConflict(conflict)):
				match (conflict.mismatch.expected, conflict.mismatch.actual.value_type):
					(Model.CallableType(Pure, [Model.IntType], expected), Model.CallableType(Pure, [Model.StringType], actual)):
						(conflict.mismatch.argument_position == 1 and expected == actual and conflict.previous.value_type == Model.IntType and conflict.current.value_type == Model.StringType
							and conflict.previous.span.source == module_source(root_module_id())
							and conflict.previous.span.start == (NEGATIVE_MAIN + "    all(").length() and conflict.previous.span.end == (NEGATIVE_MAIN + "    all([1]").length()
							and conflict.current.span.source == module_source(root_module_id())
							and conflict.current.span.start == (NEGATIVE_MAIN + "    all([1], ").length() and conflict.current.span.end == (NEGATIVE_MAIN + "    all([1], string_predicate").length())
					_: False
			_: False
	).get_or(False)


func test_all_predicate_result_is_bool() -> Bool:
	rejects(NEGATIVE_MAIN + "    all([1], ", "integer", ")", "use an expression of type pure (Int) -> Bool here", pure func(kind):
		match kind:
			Errors.CallRejection(Errors.ArgumentTypeMismatch(mismatch)):
				match (mismatch.expected, mismatch.actual.value_type):
					(Model.CallableType(Pure, [Model.IntType], Model.NominalType(Model.AggregateNominal(Model.UnionAggregate(_)), [])), Model.CallableType(Pure, [Model.IntType], Model.IntType)): mismatch.argument_position == 1
					_: False
			_: False
	).get_or(False)


func test_all_predicate_must_be_pure() -> Bool:
	rejects(NEGATIVE_MAIN + "    all([1], ", "impure", ")", "pass a pure named function; impure functions cannot satisfy a pure callable parameter", pure func(kind):
		match kind:
			Errors.CallRejection(Errors.ImpureCallback(_)): True
			_: False
	).get_or(False)

tests: TestSuite = {
	description = "Target List supplement typed contracts",
	tests = [
		("List supplement signatures preserve function-owned rigids", test_supplement_signatures_keep_owned_rigids_and_foundation_types),
		("List find predicate input agrees with the List", test_find_predicate_input_agrees_with_the_list),
		("List find predicate result is Bool", test_find_predicate_result_is_bool),
		("List find predicate rejects impure callbacks", test_find_predicate_must_be_pure),
		("List all predicate input agrees with the List", test_all_predicate_input_agrees_with_the_list),
		("List all predicate result is Bool", test_all_predicate_result_is_bool),
		("List all predicate rejects impure callbacks", test_all_predicate_must_be_pure),
	]
}
