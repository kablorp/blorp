import:
    int as IntOps: add, negate
    float as FloatOps
    string as StringOps: add

-- Every spelling of an arithmetic call reaches a trait member: a selected name,
-- UFCS, and a module alias, on Int, Float and String.
pure func forms() -> List[Int]:
    [add(1, 2), 1.add(2), IntOps.add(1, 2), IntOps.subtract(3, 1), 3.multiply(2), IntOps.divide(7, 2), 7.remainder(2), negate(4), IntOps.negate(4)]

pure func float_forms() -> List[Float]:
    [add(1.0, 2.0), FloatOps.subtract(3.0, 1.0), 1.5.multiply(2.0), FloatOps.divide(1.0, 2.0), 7.5.remainder(2.0), 0.5.negate()]

pure func text_forms() -> List[String]:
    [add("a", "b"), "a".add("b"), StringOps.add("a", "b")]

func main() -> Int:
    0
