import:
	../compilation: compile
	io: print_error
	test: TestSuite


-- UFCS is only syntax: `x.f(args)` compiles exactly as `f(x, args)`. Each case
-- compiles a program written with receivers and the same program written with
-- plain calls, and requires one emitted C text for both. The text itself is not
-- pinned, so emission can change freely. This checks only that the receiver and
-- call forms emit the same C; absolute evaluation order is owned by
-- test_ordered_call_operands.brp.
private DECLARATIONS: String =
	|pure func one() -> Int:
	|	1
	|pure func one_of(value: Int) -> Int:
	|	1
	|pure func identity(value: Int) -> Int:
	|	value
	|pure func zero(value: Int) -> Int:
	|	0
	|


private pure func program(body: String) -> String:
	DECLARATIONS + "func main() -> Int:\n\t" + body + "\n"


-- True only when both sources compile and emit the same C.
private func emit_the_same(receiver_body: String, call_body: String) -> Bool:
	match (compile(program(receiver_body)), compile(program(call_body))):
		(Ok(receiver_form), Ok(call_form)):
			if receiver_form == call_form:
				True
			else:
				print_error(receiver_body + " and " + call_body + " emitted different C")
				False
		_:
			print_error(receiver_body + " and " + call_body + " must both compile")
			False


func test_a_receiver_call_emits_the_direct_call() -> Bool:
	emit_the_same("one().identity()", "identity(one())")


func test_a_chain_emits_left_to_right() -> Bool:
	emit_the_same("1.one_of().zero()", "zero(one_of(1))")


func test_prefix_and_postfix_calls_interleave() -> Bool:
	emit_the_same("zero(identity(1).one_of()).identity()", "identity(zero(one_of(identity(1))))")


-- The comparison can fail: the same calls in a different order emit different C.
func test_a_different_call_order_emits_different_c() -> Bool:
	match (compile(program("zero(one_of(1))")), compile(program("one_of(zero(1))"))):
		(Ok(first), Ok(second)):
			first != second
		_:
			False


tests: TestSuite = {
	description = "UFCS is plain call syntax",
	tests = [
		("a receiver call emits the direct call", test_a_receiver_call_emits_the_direct_call),
		("a chain emits left to right", test_a_chain_emits_left_to_right),
		("prefix and postfix calls interleave", test_prefix_and_postfix_calls_interleave),
		("a different call order emits different C", test_a_different_call_order_emits_different_c),
	],
}
