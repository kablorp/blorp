import:
    bool: Bool methods, not
    test: TestSuite
    ../../../src/runtime/system: SYSTEM_CURRENT_DIRECTORY_RUNTIME
    ../text_search: has_text


pure func test_current_directory_fragment_publishes_its_total_out_pointer_abi() -> Bool:
    has_text(
        SYSTEM_CURRENT_DIRECTORY_RUNTIME,
        "uint8_t blorp_get_current_directory(struct blorp_string **directory,struct blorp_string **error)",
    ).and(not(has_text(SYSTEM_CURRENT_DIRECTORY_RUNTIME, "struct blorp_Result")))


tests: TestSuite = {
    description = "Blorp system runtime fragment",
    tests = [
        (
            "current directory publishes target String out-pointer ABI",
            test_current_directory_fragment_publishes_its_total_out_pointer_abi,
        ),
    ],
}
