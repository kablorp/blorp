import:
    bool: Bool methods, not
    test: TestSuite
    ../../../../src/compile/lower/lower as Lower
    ../../../../src/compile/namespace/builtins as Builtins
    ../../../../src/compile/specialize/specialize as Concrete
    ../../../../src/syntax/source: module_source, root_module_id
    ../../../../src/syntax/syntax: SystemOperation(FsWriteText)
    ../../fs_write_inputs: fs_write_seed
    ../../module_input: test_base


private pure func preserves_query(query: Lower.LoweredFunction) -> Bool:
    label_start = "func query(path: String, contents: String) -> Result[Void, Int]:\n    builtin(".length()
    label_end = label_start + "\"fs.write_text\"".length()
    match query.steps:
        [Lower.Define(path), Lower.Define(contents), Lower.Define(result)]:
            match (path.operation, contents.operation, result.operation, result.value_type):
                (Lower.ParameterValue(path_position), Lower.ParameterValue(contents_position), Lower.CallValue(call, [first, second]), Concrete.UnionType(owner)):
                    match call:
                        Concrete.RuntimeFunction(Builtins.SystemCall(FsWriteText, constructors)):
                            (path_position == 0)
                                .and(contents_position == 1)
                                .and(Lower.value_number(first) == Lower.value_number(path.id))
                                .and(Lower.value_number(second) == Lower.value_number(contents.id))
                                .and(
                                    (
                                        Concrete.union_number(owner)
                                        == Concrete.union_number(
                                            Concrete.variant_owner(constructors.ok),
                                        )
                                    ),
                                )
                                .and(result.span.source == module_source(root_module_id()))
                                .and(result.span.start == label_start)
                                .and(result.span.end == label_end)
                        _:
                            False
                _:
                    False
        _:
            False


pure func test_fs_write_lowering_keeps_both_arguments_and_span() -> Bool:
    match fs_write_seed(test_base()):
        Err(_): False
        Ok(seed): preserves_query(seed.query)


-- Moving the recorded label by one byte must fail the span comparison above.
pure func test_shifted_callee_definition_span_rejects() -> Bool:
    match fs_write_seed(test_base()):
        Err(_):
            False
        Ok(seed):
            match seed.query.steps:
                [Lower.Define(path), Lower.Define(contents), Lower.Define(result)]:
                    shifted = { result.span |
                        start = result.span.start + 1,
                        end = result.span.end + 1,
                    }
                    changed = { result | span = shifted }
                    not(
                        preserves_query(
                            { seed.query |
                                steps = [
                                    Lower.Define(path),
                                    Lower.Define(contents),
                                    Lower.Define(changed),
                                ],
                            },
                        ),
                    )
                _:
                    False


tests: TestSuite = {
    description = "Blorp fs.write_text lowering",
    tests = [
        (
            "fs.write_text preserves two operands and their literal source occurrence",
            test_fs_write_lowering_keeps_both_arguments_and_span,
        ),
        ("shifted callee definition span rejects", test_shifted_callee_definition_span_rejects),
    ],
}
