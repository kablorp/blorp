import:
    list: List methods
    test: TestSuite
    ../../../../src/compile/lower/lower as Lower
    ../../../../src/compile/specialize/specialize as Concrete
    ../../../../src/syntax/syntax: LiteralPattern(ExactInt)
    ../../int_pattern_inputs: INT_PATTERNS, IntLiteralTests, int_pattern_tests_are_complete
    ../../managed_union_inputs: lowered, lowered_tail_join


-- The Int literal tests of the tail joins. Every tested place must be an Int.
private pure func int_tests(functions: List[Lower.LoweredFunction]) -> IntLiteralTests:
    var found: IntLiteralTests = { at_root = [], in_fields = [] }
    for function in functions:
        match lowered_tail_join(function):
            Some(join):
                for node in join.selection.nodes:
                    match node:
                        Lower.TestLiteral(place, ExactInt(value), _, _):
                            if place.value_type == Concrete.IntType:
                                match place.route:
                                    Concrete.MatchRoot:
                                        found = { found | at_root = found.at_root.append(value) }
                                    _: found = { found | in_fields = found.in_fields.append(value) }
                        _: void
            None: void
    found


pure func test_int_literal_tests_reach_the_lowered_selection() -> Bool:
    match lowered(INT_PATTERNS):
        Err(_): False
        Ok(program):
            int_tests(Lower.lowered_functions(program).functions).int_pattern_tests_are_complete()


tests: TestSuite = {
    description = "Blorp Int literal pattern lowering",
    tests = [
        (
            "Int literal tests reach the lowered selection",
            test_int_literal_tests_reach_the_lowered_selection,
        ),
    ],
}
