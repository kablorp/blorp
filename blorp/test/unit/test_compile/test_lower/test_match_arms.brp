import:
    bool: Bool methods
    int: Int methods
    io/fs: read_text
    list: List methods
    test: TestSuite
    ../../../../src/compile/check/model: match_arm_number
    ../../../../src/compile/lower/lower as lower
    ../../managed_union_inputs: lowered, lowered_tail_join


-- A match with one arm for each of 256 constructors of one union. Lowering gives
-- every arm of the join one body, and every arm one EnterArm node entering it.
-- Emission's brace depth is not checked here; it is emit's property.
private MANY_ARMS: String = "blorp/test/e2e/fixtures/match/many_arms.brp"
private ARM_COUNT: Int = 256


private func many_arms_join() -> Option[lower.LoweredJoin]:
    match read_text(MANY_ARMS):
        Err(_):
            None
        Ok(source):
            match lowered(source):
                Err(_):
                    None
                Ok(program):
                    var found: Option[lower.LoweredJoin] = None
                    for function in lower.lowered_functions(program).functions:
                        match lowered_tail_join(function):
                            Some(join): found = Some(join)
                            None: void
                    found


func test_each_arm_has_one_body_and_one_incoming_edge() -> Bool:
    match many_arms_join():
        Some(join):
            var entered: List[Int] = []
            for node in join.selection.nodes:
                match node:
                    lower.EnterArm(edge): entered = entered.append(match_arm_number(edge.arm))
                    _: void
            var valid: Bool = entered
                .length()
                .equals(ARM_COUNT)
            for number in 0..ARM_COUNT:
                bodies = join.arms.filter(
                    pure func(arm: lower.JoinArm): match_arm_number(arm.id).equals(number),
                )
                edges = entered.filter(pure func(arm: Int): arm.equals(number))
                valid = valid
                    .and(
                        bodies
                            .length()
                            .equals(1),
                    )
                    .and(
                        edges
                            .length()
                            .equals(1),
                    )
            valid
        None:
            False


TESTS: TestSuite = {
    description = "Lowered match with 256 constructor arms",
    tests = [
        (
            "each arm has one body and one incoming edge",
            test_each_arm_has_one_body_and_one_incoming_edge,
        ),
    ],
}
