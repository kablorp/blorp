---
Tests for the library embedded in the compiler: the generated module still
matches `blorp/standard_library`, and Load treats `EmbeddedLibrary` as a layout
whose modules have paths under `<standard library>`.

The generated module is built by `make -C blorp test-compiler`, so these tests
run against the library as it was at the last build.
---
import:
    bool: Bool methods, and, not
    fs: Entry, EntryKind(File, Directory), list_directory, read_text
    int: Int methods
    io: print_error, to_string
    list: List methods
    option: Option methods
    path as Path
    result: Result methods
    string: String methods
    test: TestSuite
    ../../../../build/generated/embedded_library: EMBEDDED_LIBRARY_PATHS, embedded_library_file
    ../../../../src/cli: has_source_suffix
    ../../../../src/compile/load/load:
        LibrarySource(EmbeddedLibrary, LibraryDirectory),
        LibraryLayout,
        ambiguous_stem_diagnostic,
        embedded_stem_ambiguity,
        embedded_stem_is_ambiguous,
        import_path,
        library_layout,
        load_program,
        load_test_program,
        module_role,
    ../../../../src/syntax/names: intern_names, program_names
    ../../../../src/syntax/parse: ImportOrigin(LibraryImport), ParsedImport
    ../../../../src/syntax/source:
        ModuleKind(UserModule, LibraryModule, FoundationTypesModule, FoundationPreludeModule),
        compiler_source,
    ../../../../src/syntax/syntax: Span
    ../../../../src/utils/text: byte_order_before


private LIBRARY_ROOT: String = "blorp/standard_library"

private PROGRAM: String = "blorp/test/e2e/fixtures/return/zero.brp"


-- The library files among `entries`, which are those of the library folder
-- `folder` ("" or "io/"), and below it at any depth, as paths relative to the
-- library root in discovery order.
private func files_among(
    folder: String,
    entries: List[Entry],
    found: List[String],
) -> Result[List[String], String]:
    match entries:
        []:
            Ok(found)
        [entry, ...later]:
            relative = "${folder}${entry.name}"
            match entry.kind:
                Directory:
                    match library_file_names("${relative}/"):
                        Ok(nested): files_among(folder, later, found.concat(nested))
                        Err(message): Err(message)
                File:
                    if entry.name.has_source_suffix():
                        files_among(folder, later, found.append(relative))
                    else:
                        files_among(folder, later, found)
                _:
                    files_among(folder, later, found)


private func library_file_names(folder: String) -> Result[List[String], String]:
    entries ?= list_directory("${LIBRARY_ROOT}/${folder}").map_err(to_string)
    files_among(folder, entries, [])


-- The first file whose embedded text differs from the file on disk.
private func stale_file(names: List[String]) -> Result[Option[String], String]:
    match names:
        []:
            Ok(None)
        [name, ...later]:
            match read_text(Path.join(LIBRARY_ROOT, name)):
                Err(error):
                    Err(error.to_string())
                Ok(disk):
                    if embedded_library_file(name) == Some(disk):
                        stale_file(later)
                    else:
                        Ok(Some(name))


-- Whether each path sorts strictly before the next, in bytes.
private pure func in_byte_order(paths: List[String]) -> Bool:
    var ordered: Bool = True
    for position in 1..paths.length():
        match (paths.get(position - 1), paths.get(position)):
            (Some(earlier), Some(later)): ordered = ordered.and(byte_order_before(earlier, later))
            _: ordered = False
    ordered


-- The embedded paths are the directory's files, each once, in byte order.
private pure func same_paths(names: List[String]) -> Bool:
    (EMBEDDED_LIBRARY_PATHS.length() == names.length())
        .and(names.all(pure func(name): EMBEDDED_LIBRARY_PATHS.contains(name)))
        .and(in_byte_order(EMBEDDED_LIBRARY_PATHS))


private func freshness_problem() -> Result[Void, String]:
    names ?= library_file_names("")
    stale ?= stale_file(names)
    if not(same_paths(names)):
        Err(
            "embedded paths [${EMBEDDED_LIBRARY_PATHS.join(", ")}] differ from the directory's [${names.join(", ")}]; run make -C blorp compiler",
        )
    else:
        match stale:
            None:
                Ok(void)
            Some(name):
                Err(
                    "embedded ${name} differs from ${LIBRARY_ROOT}/${name}; run make -C blorp compiler",
                )


-- Embedded paths are the directory's `.brp` files, and each file's text is the
-- embedded text byte for byte.
func test_embedded_library_is_the_library_directory() -> Bool:
    match freshness_problem():
        Ok(_):
            True
        Err(message):
            print_error(message)
            False


pure func test_a_file_that_is_not_embedded_is_absent() -> Bool:
    and(
        embedded_library_file("missing.brp").is_none(),
        embedded_library_file("README.md").is_none(),
    )


private pure func embedded_layout() -> LibraryLayout:
    library_layout(EmbeddedLibrary, "/project")


pure func test_embedded_roles_use_the_embedded_root() -> Bool:
    layout = embedded_layout()
    and(
        and(
            module_role(layout, "<standard library>/_base.brp") == FoundationTypesModule,
            module_role(layout, "<standard library>/prelude.brp") == FoundationPreludeModule,
        ),
        and(
            and(
                module_role(layout, "<standard library>/int.brp") == LibraryModule,
                module_role(layout, "<standard library>_copy/int.brp") == UserModule,
            ),
            and(
                module_role(layout, "/project/<standard library>/int.brp") == UserModule,
                module_role(layout, "/project/main.brp") == UserModule,
            ),
        ),
    )


pure func test_a_directory_layout_joins_a_relative_root_to_the_working_directory() -> Bool:
    layout = library_layout(LibraryDirectory("lib/../std"), "/project")
    and(
        and(
            module_role(layout, "/project/std/int.brp") == LibraryModule,
            module_role(layout, "/project/std/_base.brp") == FoundationTypesModule,
        ),
        module_role(layout, "/project/lib/int.brp") == UserModule,
    )


func test_an_embedded_library_import_has_the_embedded_path() -> Bool:
    part = intern_names(program_names().names, ["int"])
    request: ParsedImport = {
        path = { origin = LibraryImport, parts = part.ids },
        module_alias = None,
        symbols = [],
        span = { source = compiler_source(), start = 0, end = 0 },
    }
    match import_path("/project/main.brp", request, part.names, embedded_layout()):
        Ok(actual): actual == "<standard library>/int.brp"
        Err(_): False


private EMBEDDED_PREFIX: String = "<standard library>/"

private MISSING_IMPORT: String = "blorp/test/e2e/fixtures/test_entry/missing_library_import.brp"

private TEST_ENTRY: String = "blorp/test/e2e/fixtures/test_entry/passing.brp"


private pure func embedded_rows(paths: List[String]) -> Int:
    paths
        .filter(pure func(path): path.starts_with(EMBEDDED_PREFIX))
        .length()


-- A program compiled against the embedded library reads no library directory:
-- every module but the root has an embedded path.
func test_a_program_loads_against_the_embedded_library() -> Bool:
    match load_program(PROGRAM, EmbeddedLibrary):
        Err(_):
            False
        Ok(loaded):
            paths = loaded.sources.modules.map(pure func(row): row.path)
            and(
                and(
                    paths.contains("<standard library>/_base.brp"),
                    paths.contains("<standard library>/prelude.brp"),
                ),
                embedded_rows(paths) == paths.length() - 1,
            )


-- A library import with no embedded file is the ordinary missing-import
-- diagnostic, naming the embedded path.
func test_a_missing_embedded_module_is_a_missing_import() -> Bool:
    match load_program(MISSING_IMPORT, EmbeddedLibrary):
        Ok(_):
            False
        Err(failure):
            and(
                (
                    failure.diagnostic.message
                    == "could not read module <standard library>/no_such_library_module.brp: no such file"
                ),
                (
                    failure.diagnostic.help
                    == "check the import path and provide a readable .brp file under its source root"
                ),
            )


-- The test entry module is queued from the layout's root, so under the
-- embedded layout it is the embedded test.brp.
func test_the_test_entry_is_read_from_the_embedded_library() -> Bool:
    no_later_roots: List[String] = []
    match load_test_program(TEST_ENTRY, no_later_roots, EmbeddedLibrary):
        Err(_):
            False
        Ok(loaded):
            paths = loaded.sources.modules.map(pure func(row): row.path)
            paths.contains("<standard library>/test.brp")


private NESTED_PATHS: List[String] = ["a.brp", "io.brp", "io/error.brp", "shadow/inner.brp"]


-- A stem is ambiguous when the paths hold its module file and a path below it.
pure func test_an_embedded_module_beside_its_folder_is_ambiguous() -> Bool:
    embedded_stem_is_ambiguous(NESTED_PATHS, "io")
        .and(not(embedded_stem_is_ambiguous(NESTED_PATHS, "a")))
        .and(not(embedded_stem_is_ambiguous(NESTED_PATHS, "shadow")))
        .and(not(embedded_stem_is_ambiguous(NESTED_PATHS, "io/error")))


-- The embedded layout turns an absolute stem into one relative to the library
-- root before looking it up; a user path and a directory layout have no answer.
pure func test_an_embedded_stem_is_looked_up_relative_to_the_library_root() -> Bool:
    directory = library_layout(LibraryDirectory("std"), "/project")
    (embedded_stem_ambiguity(embedded_layout(), NESTED_PATHS, "<standard library>/io") == Some(True))
        .and(
            (
                embedded_stem_ambiguity(embedded_layout(), NESTED_PATHS, "<standard library>/a")
                == Some(False)
            ),
        )
        .and(
            (
                embedded_stem_ambiguity(
                    embedded_layout(),
                    NESTED_PATHS,
                    "<standard library>/io/error",
                )
                == Some(False)
            ),
        )
        .and(embedded_stem_ambiguity(embedded_layout(), NESTED_PATHS, "/project/io").is_none())
        .and(embedded_stem_ambiguity(directory, NESTED_PATHS, "/project/std/io").is_none())


pure func test_an_embedded_collision_names_the_embedded_files() -> Bool:
    site: Span = { source = compiler_source(), start = 3, end = 9 }
    error = ambiguous_stem_diagnostic("<standard library>/io", site)
    (error.message == "<standard library>/io.brp sits beside the folder <standard library>/io/, so the import path names both a module and a folder")
        .and(
            (
                error.help
                == "rename one of them; a module that belongs with the folder can move into it"
            ),
        )
        .and(error.span == site)


tests: TestSuite = {
    description = "Blorp embedded standard library",
    tests = [
        (
            "an embedded module beside its folder is ambiguous",
            test_an_embedded_module_beside_its_folder_is_ambiguous,
        ),
        (
            "an embedded stem is looked up relative to the library root",
            test_an_embedded_stem_is_looked_up_relative_to_the_library_root,
        ),
        (
            "an embedded collision names the embedded files",
            test_an_embedded_collision_names_the_embedded_files,
        ),
        (
            "embedded library is the library directory",
            test_embedded_library_is_the_library_directory,
        ),
        ("a file that is not embedded is absent", test_a_file_that_is_not_embedded_is_absent),
        ("embedded roles use the embedded root", test_embedded_roles_use_the_embedded_root),
        (
            "a directory layout joins a relative root to the working directory",
            test_a_directory_layout_joins_a_relative_root_to_the_working_directory,
        ),
        (
            "an embedded library import has the embedded path",
            test_an_embedded_library_import_has_the_embedded_path,
        ),
        (
            "a program loads against the embedded library",
            test_a_program_loads_against_the_embedded_library,
        ),
        (
            "a missing embedded module is a missing import",
            test_a_missing_embedded_module_is_a_missing_import,
        ),
        (
            "the test entry is read from the embedded library",
            test_the_test_entry_is_read_from_the_embedded_library,
        ),
    ],
}
