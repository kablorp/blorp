import:
    test: TestSuite
    ../../../../src/compile/specialize/specialize as specialized
    ../../module_input: test_base
    ../../void_string_result_inputs: specialized_result


pure func test_ordinary_result_preserves_both_payload_types() -> Bool:
    match specialized_result(test_base()):
        Err(_):
            False
        Ok(program):
            match specialized.specialized_contents(program).unions:
                [row]:
                    match (specialized.union_variants(row), row):
                        ([[specialized.VoidType], [specialized.StringType]], specialized.OwningCases(_)):
                            True
                        _:
                            False
                _:
                    False


TESTS: TestSuite = {
    description = "Blorp ordinary Void/String Result specialization",
    tests = [
        (
            "Void and String retain their distinct stored payload roles",
            test_ordinary_result_preserves_both_payload_types,
        ),
    ],
}
