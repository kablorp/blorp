import:
    list: List methods
    test: TestSuite
    ../../../../src/compile/namespace/builtins: IntegerFormat(Int64Format)
    ../../../../src/compile/specialize/specialize as specialized
    ../../../../src/syntax/syntax: Diagnostic, LiteralPattern(ExactInt)
    ../../input: checked_source
    ../../int_pattern_inputs: INT_PATTERNS, IntLiteralTests, int_pattern_tests_are_complete
    ../../managed_union_inputs: concrete_tail_join


-- The Int literal tests of the tail joins. Every tested place must be an Int.
private pure func int_tests(contents: specialized.SpecializedContents) -> IntLiteralTests:
    var found: IntLiteralTests = { at_root = [], in_fields = [] }
    for function in contents.functions:
        match concrete_tail_join(function.body):
            Some(join):
                for node in join.selection.nodes:
                    match node:
                        specialized.TestLiteral(place, ExactInt(value), _, _):
                            if place.value_type == specialized.IntegerType(Int64Format):
                                match place.route:
                                    specialized.MatchRoot:
                                        found = { found | at_root = found.at_root.append(value) }
                                    _:
                                        found = { found |
                                            in_fields = found.in_fields.append(value),
                                        }
                        _:
                            void
            None:
                void
    found


private pure func specialize_source(
    source: String,
) -> Result[specialized.SpecializedContents, Diagnostic]:
    checked ?= checked_source(source)
    program ?= specialized.specialize(checked)
    Ok(specialized.specialized_contents(program))


pure func test_int_literal_tests_keep_their_values_and_int_places() -> Bool:
    match specialize_source(INT_PATTERNS):
        Err(_): False
        Ok(contents): int_tests(contents).int_pattern_tests_are_complete()


TESTS: TestSuite = {
    description = "Blorp Int literal pattern specialization",
    tests = [
        (
            "Int literal tests keep their values and Int places",
            test_int_literal_tests_keep_their_values_and_int_places,
        ),
    ],
}
