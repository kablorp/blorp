---
A capture environment that no instance turns into a runtime closure is sealed
by value. A created lambda value, a callee returning its callable parameter,
and a nested lambda capturing that parameter each turn it into a runtime
closure, which keeps the counted cell.
---
import:
    int: Int methods
    test: TestSuite
    ../../../../src/compile/check/check: check
    ../../../../src/compile/specialize/specialize as Concrete
    ../../module_input: parse_modules


-- The layout of the one record whose only field is an Int, the environment
-- in every source here; None when no record, or more than one, has it.
private pure func int_environment(source: String) -> Option[Concrete.ConcreteRecord]:
    match parse_modules([{ source = source, targets = [] }]):
        Err(_):
            None
        Ok(parsed):
            match check(parsed):
                Err(_):
                    None
                Ok(accepted):
                    match Concrete.specialize(accepted):
                        Err(_):
                            None
                        Ok(program):
                            var found: Option[Concrete.ConcreteRecord] = None
                            var matches = 0
                            for layout in Concrete.specialized_contents(program).records:
                                match Concrete.record_fields(layout):
                                    [Concrete.IntType]:
                                        matches = matches + 1
                                        found = Some(layout)
                                    _:
                                        void
                            if matches == 1:
                                found
                            else:
                                None


pure func test_environment_passed_only_to_a_static_callee_is_stored_by_value() -> Bool:
    source: String =
        |pure func apply(callback: pure (Int) -> Int, value: Int) -> Int:
        |    callback(value)
        |func main() -> Int:
        |    amount = 2
        |    apply(pure func(item: Int) -> Int: amount, 40)
        |
    match int_environment(source):
        Some(Concrete.ValueFields(_)): True
        _: False


pure func test_created_lambda_value_keeps_a_counted_environment() -> Bool:
    source: String =
        |func main() -> Int:
        |    amount = 2
        |    callback: pure (Int) -> Int = pure func(item: Int) -> Int: amount
        |    callback(40)
        |
    match int_environment(source):
        Some(Concrete.CountedFields(_)): True
        _: False


pure func test_callee_returning_its_callable_parameter_keeps_a_counted_environment() -> Bool:
    source: String =
        |pure func keep(callback: pure (Int) -> Int) -> pure (Int) -> Int:
        |    callback
        |func main() -> Int:
        |    amount = 2
        |    kept = keep(pure func(item: Int) -> Int: amount)
        |    kept(40)
        |
    match int_environment(source):
        Some(Concrete.CountedFields(_)): True
        _: False


pure func test_nested_capture_of_a_callable_parameter_keeps_a_counted_environment() -> Bool:
    source: String =
        |pure func wrapped(callback: pure (Int) -> Int, value: Int) -> Int:
        |    inner = pure func(item: Int) -> Int: callback(item)
        |    inner(value)
        |func main() -> Int:
        |    amount = 2
        |    wrapped(pure func(item: Int) -> Int: amount, 40)
        |
    match int_environment(source):
        Some(Concrete.CountedFields(_)): True
        _: False


-- `both` forwards its parameter to `apply`, which only calls it, and to `keep`,
-- which returns it. Forwarding keeps the environment, so `apply`'s and `keep`'s
-- instances share the one environment type, and `keep`'s value use counts it.
pure func test_parameter_forwarded_to_a_converting_callee_keeps_a_counted_environment() -> Bool:
    source: String =
        |pure func apply(callback: pure (Int) -> Int, value: Int) -> Int:
        |    callback(value)
        |pure func keep(callback: pure (Int) -> Int) -> pure (Int) -> Int:
        |    callback
        |pure func both(callback: pure (Int) -> Int) -> Int:
        |    first = apply(callback, 1)
        |    kept = keep(callback)
        |    kept(first)
        |func main() -> Int:
        |    amount = 40
        |    both(pure func(item: Int) -> Int: amount)
        |
    match int_environment(source):
        Some(Concrete.CountedFields(_)): True
        _: False


-- `run` passes its static `callback` as an argument to the callable it calls,
-- which needs a runtime closure: a forwarded creation.
pure func test_parameter_passed_to_a_called_callable_keeps_a_counted_environment() -> Bool:
    source: String =
        |pure func run(callback: pure (Int) -> Int, runner: pure (pure (Int) -> Int) -> Int) -> Int:
        |    runner(callback)
        |func main() -> Int:
        |    amount = 40
        |    run(pure func(item: Int) -> Int: amount, pure func(inner: pure (Int) -> Int) -> Int: inner(2))
        |
    match int_environment(source):
        Some(Concrete.CountedFields(_)): True
        _: False


tests: TestSuite = {
    description = "Capture environments sealed by value or counted",
    tests = [
        (
            "an environment passed only to a static callee is stored by value",
            test_environment_passed_only_to_a_static_callee_is_stored_by_value,
        ),
        (
            "a created lambda value keeps a counted environment",
            test_created_lambda_value_keeps_a_counted_environment,
        ),
        (
            "a callee returning its callable parameter keeps a counted environment",
            test_callee_returning_its_callable_parameter_keeps_a_counted_environment,
        ),
        (
            "a nested capture of a callable parameter keeps a counted environment",
            test_nested_capture_of_a_callable_parameter_keeps_a_counted_environment,
        ),
        (
            "a parameter forwarded to a converting callee keeps a counted environment",
            test_parameter_forwarded_to_a_converting_callee_keeps_a_counted_environment,
        ),
        (
            "a parameter passed to a called callable keeps a counted environment",
            test_parameter_passed_to_a_called_callable_keeps_a_counted_environment,
        ),
    ],
}
