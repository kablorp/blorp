import:
    bool: Bool methods
    int: Int methods
    test: TestSuite
    ../../../../src/compile/lower/lower as lower
    ../../../../src/compile/namespace/builtins as builtins: IntegerFormat(Int64Format)
    ../../../../src/compile/specialize/specialize as specialized
    ../../../../src/syntax/syntax: SystemOperation(RunToFiles)
    ../../module_input: test_base
    ../../run_to_files_inputs: process_seed


pure func test_process_signature_has_string_list_and_integer_result() -> Bool:
    match process_seed(test_base()):
        Err(_):
            False
        Ok(seed):
            signature = specialized.runtime_signature(
                builtins.SystemCall(RunToFiles, seed.constructors),
            )
            match (signature.parameters, signature.return_type):
                ([specialized.StringType, specialized.ListType(specialized.StringType), specialized.StringType, specialized.StringType, specialized.IntegerType(Int64Format)], specialized.UnionType(owner)):
                    match lower.lowered_functions(seed.lowered).unions.get(
                        specialized.union_number(owner),
                    ):
                        Some(layout):
                            match specialized.union_variants(layout):
                                [[specialized.IntegerType(Int64Format)], [specialized.StringType]]:
                                    specialized.union_number(owner)
                                        .equals(
                                            specialized.union_number(
                                                specialized.variant_owner(seed.constructors.ok),
                                            ),
                                        )
                                        .and(
                                            specialized.union_number(owner).equals(
                                                specialized.union_number(
                                                    specialized.variant_owner(
                                                        seed.constructors.err,
                                                    ),
                                                ),
                                            ),
                                        )
                                _:
                                    False
                        None:
                            False
                _:
                    False


TESTS: TestSuite = {
    description = "Process builtin specialization",
    tests = [
        (
            "String list and designated Int/String Result",
            test_process_signature_has_string_list_and_integer_result,
        ),
    ],
}
