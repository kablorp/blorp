---
A rejection that a lookup reports when it finds nothing. Each such error is
built only in the lookup's `None` arm, so these programs pin the error, help
and span that arm produces. Each program has exactly one problem.
---
import:
    bool: and, not
    int: Int methods
    list: List methods
    result: map_err
    string: String methods
    test: TestSuite
    ../../../../src/main: compile
    ../../../../src/syntax/lex: lex
    ../../../../src/syntax/names: program_names
    ../../../../src/syntax/source: module_source, root_module_id
    ../../../../src/syntax/syntax: Diagnostics, singleton_diagnostic
    ../../input: parse


private pure func compiled(source: String) -> Result[String, Diagnostics]:
    lexed ?= lex(module_source(root_module_id()), source, program_names().names).map_err(
        singleton_diagnostic,
    )
    parsed ?= parse(lexed).map_err(singleton_diagnostic)
    compile(parsed)


-- The single diagnostic, compared exactly; a mismatch prints what was reported.
private func rejects(source: String, start: Int, end: Int, message: String, help: String) -> Bool:
    match compiled(source):
        Ok(_):
            print_error("compiled without a diagnostic")
            False
        Err(diagnostics):
            first = diagnostics.first
            located = and(
                first.span.source == module_source(root_module_id()),
                and(first.span.start == start, first.span.end == end),
            )
            exact = and(
                and(located, diagnostics.remaining.is_empty()),
                and(first.message == message, first.help == help),
            )
            if exact.not():
                print_error(
                    "reported ${first.span.start}..${first.span.end} ${first.message} / ${first.help} and ${diagnostics.remaining.length()} more",
                )
            exact


func test_a_record_literal_without_an_expected_type() -> Bool:
    source: String =
        |record Point {
        |	x: Int
        |}
        |func main() -> Int:
        |	point = { x = 1 }
        |	0
        |
    rejects(
        source,
        54,
        63,
        "record literal needs an expected record type",
        "pass the literal to a concrete record parameter or return it from a helper declaring that record",
    )


func test_a_read_of_an_unknown_record_field() -> Bool:
    source: String =
        |record Point {
        |	x: Int
        |}
        |func main() -> Int:
        |	point: Point = { x = 1 }
        |	point.y
        |
    rejects(
        source,
        78,
        79,
        "unknown field 'y' in Point",
        "use a field declared by the receiving record",
    )


func test_a_constructor_without_an_expected_type() -> Bool:
    source: String =
        |union Shape:
        |	Circle(Int)
        |	Square(Int)
        |func main() -> Int:
        |	shape = Circle(1)
        |	0
        |
    rejects(
        source,
        68,
        74,
        "constructor needs an expected union type",
        "pass an already-typed union value or call a concrete helper returning the union",
    )


func test_a_tuple_index_past_its_last_element() -> Bool:
    source: String =
        |func main() -> Int:
        |	pair = (1, 2)
        |	pair[2]
        |
    rejects(source, 41, 42, "tuple index is out of range", "use a literal index from 0 through 1")


func test_a_constructor_pattern_on_a_string() -> Bool:
    source: String =
        |func main() -> Int:
        |	match "text":
        |		Some(value): 1
        |		_: 0
        |
    rejects(
        source,
        37,
        48,
        "pattern does not match the value's type",
        "use a constructor of that union, a List pattern for a List, a String literal for a String, or an Int literal for an Int",
    )


func test_a_program_without_main() -> Bool:
    source: String =
        |func helper() -> Int:
        |	0
        |
    rejects(
        source,
        25,
        25,
        "expected a main function",
        "declare func main() -> Int: as the entrypoint",
    )


func test_a_dict_literal_without_the_prelude_dict() -> Bool:
    source: String =
        |func main() -> Int:
        |	table = { 1 => 2 }
        |	0
        |
    rejects(
        source,
        29,
        39,
        "Dict literals require the prelude's Dict",
        "select a Dict whose module declares pure empty, dict and set functions in the configured prelude",
    )


tests: TestSuite = {
    description = "lookup rejections",
    tests = [
        (
            "a record literal without an expected type",
            test_a_record_literal_without_an_expected_type,
        ),
        ("a read of an unknown record field", test_a_read_of_an_unknown_record_field),
        ("a constructor without an expected type", test_a_constructor_without_an_expected_type),
        ("a tuple index past its last element", test_a_tuple_index_past_its_last_element),
        ("a constructor pattern on a String", test_a_constructor_pattern_on_a_string),
        ("a program without main", test_a_program_without_main),
        ("a Dict literal without the prelude's Dict", test_a_dict_literal_without_the_prelude_dict),
    ],
}
