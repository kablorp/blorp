import:
    bool: and
    int: Int methods
    list: List methods
    option: Option methods
    result: Result methods
    string: String methods
    test: TestSuite
    ../../../../src/compile/assemble:
        ParsedAssembly,
        ParsedProgram,
        append_module,
        assembly_names,
        begin_program,
        parsed_contents,
    ../../../../src/compile/check/check: check, checked_functions
    ../../../../src/compile/check/model as Model
    ../../../../src/compile/check/render: render_failure
    ../../../../src/compile/ids: FunctionId, function_number, inventory_functions
    ../../../../src/syntax/lex: lex
    ../../../../src/syntax/parse: parse_module
    ../../../../src/syntax/source:
        ModuleId,
        ModuleKind(UserModule, LibraryModule, FoundationTypesModule, FoundationPreludeModule),
        module_id,
        module_source,
        root_module_id,
    ../../../../src/syntax/syntax: Diagnostic, diagnostic
    ../../module_input: FOUNDATION_TYPES, sealed


-- Each fixture has four modules: the root at 0, a Dict library at 1, the base
-- at 2 and the prelude at 3, which selects the base types and, when the
-- fixture offers literals, the library's Dict.
private DICT_POSITION: Int = 1
private BASE_POSITION: Int = 2


private BASE_SELECTIONS: String = "Int, Float, String, Void, List, Bool(True, False), Option(Some, None), Result(Ok, Err)"


private DICT_LIBRARY: String =
    |import:
    |    _base: Int, String, List
    |trait Hashable:
    |    pure func hash(key: Self) -> Int
    |implements Hashable for Int:
    |    pure func hash(key: Self) -> Int:
    |        key
    |implements Hashable for String:
    |    pure func hash(key: Self) -> Int:
    |        0
    |opaque type Dict[K: Hashable, V] = List[V]
    |pure func empty[K: Hashable, V]() -> Dict[K, V]:
    |    into_opaque Dict([])
    |pure func dict[K: Hashable, V](initial_capacity: Int) -> Dict[K, V]:
    |    into_opaque Dict([])
    |


-- Fixtures write `pure ` before this unless they test an impure `set`.
private DICT_SET: String = "func set[K: Hashable, V](self: Dict[K, V], key: K, value: V) -> Dict[K, V]:\n    self\n"


private ENTRY: String = "func main() -> Int:\n    0\n"
private MISSING_BOUND: String = "type does not satisfy the required trait bound"


private MISSING_BOUND_HELP: String = "add the required trait to this function's type parameter bounds, or provide an implementation for the concrete receiver"


private pure func append_source(
    assembly: ParsedAssembly,
    position: Int,
    source: String,
    targets: List[ModuleId],
    role: ModuleKind,
) -> Result[ParsedAssembly, Diagnostic]:
    invalid = diagnostic(
        { source = module_source(root_module_id()), start = 0, end = 0 },
        "invalid Dict literal fixture module",
        "use the four fixture module positions",
    )
    module ?= module_id(position).to_result(invalid)
    tokens ?= lex(module_source(module), source, assembly_names(assembly))
    parsed ?= parse_module(tokens, module)
    append_module(assembly, parsed, targets, role, "module_".append_int(position))


-- The Dict library's source, whether the prelude selects its Dict, and
-- whether the root module imports it as `D`.
private record Fixture {
    library: String,
    offered: Bool,
    imported: Bool,
}


private pure func standard() -> Fixture:
    { library = DICT_LIBRARY + "pure " + DICT_SET, offered = True, imported = False }


private pure func program(source: String, fixture: Fixture) -> Result[ParsedProgram, Diagnostic]:
    invalid = diagnostic(
        { source = module_source(root_module_id()), start = 0, end = 0 },
        "invalid Dict literal fixture module",
        "use the four fixture module positions",
    )
    base ?= module_id(BASE_POSITION).to_result(invalid)
    library ?= module_id(DICT_POSITION).to_result(invalid)
    selections = "import:\n    _base: " + BASE_SELECTIONS + "\n"
    prelude_source: String = if fixture.offered:
        selections + "    dict: Dict\n"
    else:
        selections
    prelude_targets: List[ModuleId] = if fixture.offered:
        [base, library]
    else:
        [base]
    root_targets: List[ModuleId] = if fixture.imported:
        [library]
    else:
        []
    root ?= append_source(begin_program(), 0, source, root_targets, UserModule)
    dict ?= append_source(root, DICT_POSITION, fixture.library, [base], LibraryModule)
    types ?= append_source(dict, BASE_POSITION, FOUNDATION_TYPES, [], FoundationTypesModule)
    prelude ?= append_source(types, 3, prelude_source, prelude_targets, FoundationPreludeModule)
    sealed(prelude)


-- The single diagnostic, compared exactly, in the root module.
private pure func rejects_in(
    source: String,
    fixture: Fixture,
    start: Int,
    end: Int,
    message: String,
    help: String,
) -> Bool:
    match program(source, fixture):
        Err(_):
            False
        Ok(parsed):
            match check(parsed):
                Ok(_):
                    False
                Err(failure):
                    diagnostics = render_failure(failure)
                    first = diagnostics.first
                    (first.span.source == module_source(root_module_id()))
                        .and(first.span.start.equals(start))
                        .and(first.span.end.equals(end))
                        .and(first.message == message)
                        .and(first.help == help)
                        .and(first.note.is_none())
                        .and(diagnostics.remaining.is_empty())


private pure func rejects(
    source: String,
    start: Int,
    end: Int,
    message: String,
    help: String,
) -> Bool:
    rejects_in(source, standard(), start, end, message, help)


private pure func accepts(source: String) -> Bool:
    match program(source, standard()):
        Err(_): False
        Ok(parsed): check(parsed).is_ok()


-- The `{` of a literal on the second line of `func main() -> Int:\n    ...`
-- is at byte 24 plus its column within the line's code.
private LINE_START: Int = 24


pure func test_empty_literal_needs_its_type() -> Bool:
    rejects(
        "func main() -> Int:\n    x = {}\n    0\n",
        LINE_START + 4,
        LINE_START + 6,
        "an empty Dict needs its type",
        "write `name: Dict[K, V] = {}`",
    )


-- The expected type supplies K and V, here and as a nested value.
pure func test_expected_types_type_empty_literals() -> Bool:
    accepts("func main() -> Int:\n    x: Dict[String, Int] = {}\n    0\n")
        .and(
            accepts(
                "func main() -> Int:\n    x: Dict[String, Dict[Int, Int]] = {\"a\" => {}, \"b\" => {1 => 2}}\n    0\n",
            ),
        )
        .and(
            accepts(
                "pure func size(d: Dict[Int, String]) -> Int:\n    0\nfunc main() -> Int:\n    size({})\n",
            ),
        )


pure func test_entries_supply_their_types() -> Bool:
    accepts(
        "func main() -> Int:\n    x = {\"a\" => 1, \"b\" => 2,}\n    y: Dict[String, Int] = x\n    0\n",
    )


-- A later entry meets the types the first one decided, as a List element does.
pure func test_mismatched_entries_use_the_argument_mismatch() -> Bool:
    rejects(
        "func main() -> Int:\n    x = {\"a\" => 1, \"b\" => \"c\"}\n    0\n",
        LINE_START + 22,
        LINE_START + 25,
        "argument type does not match the parameter type",
        "use an expression of type Int here",
    ).and(
        rejects(
            "func main() -> Int:\n    x = {\"a\" => 1, 2 => 3}\n    0\n",
            LINE_START + 15,
            LINE_START + 16,
            "argument type does not match the parameter type",
            "use an expression of type String here",
        ),
    )


-- A written Dict type meets the declaration bound at its argument; a
-- literal's key meets the bound its calls declare.
pure func test_non_dict_keys_meet_the_existing_bounds() -> Bool:
    point = "record Point { x: Int }\n"
    rejects(
        point + "func main() -> Int:\n    x: Dict[Point, Int] = {}\n    0\n",
        point.length() + LINE_START + 8,
        point.length() + LINE_START + 13,
        "Dict[Point, Int] requires Point: Hashable",
        "implement Hashable for Point, or use a type that implements it",
    ).and(
        rejects(
            point + "func main() -> Int:\n    p: Point = { x = 1 }\n    x = {p => 1}\n    0\n",
            point.length() + LINE_START + 25 + 4,
            point.length() + LINE_START + 25 + 12,
            MISSING_BOUND,
            MISSING_BOUND_HELP,
        ),
    )


-- Blorp has no empty records, so `{}` is a Dict wherever it stands. An
-- expected type of another head is the mismatch, not uninferable K and V, for
-- the literal and for the call it stands for alike.
pure func test_empty_literal_against_a_record_is_a_mismatch() -> Bool:
    point = "record Point { x: Int }\n"
    imported = "import:\n    dict as D\n" + point
    rejects(
        point + "func main() -> Int:\n    p: Point = {}\n    0\n",
        point.length() + LINE_START + 11,
        point.length() + LINE_START + 13,
        "expression does not match the expected type",
        "use an expression of type Point here",
    ).and(
        rejects_in(
            imported + "func main() -> Int:\n    p: Point = D.empty()\n    0\n",
            { standard() | imported = True },
            imported.length() + LINE_START + 11,
            imported.length() + LINE_START + 20,
            "expression does not match the expected type",
            "use an expression of type Point here",
        ),
    )


-- The library function of each call, when `module` declares it.
private pure func declared_in(
    parsed: ParsedProgram,
    call: Model.CheckedCall,
    expected: FunctionId,
    module: ModuleId,
) -> Bool:
    match call.target:
        Model.UserFunction(id, _):
            declared = match inventory_functions(parsed_contents(parsed).declarations).get(
                function_number(id),
            ):
                Some(row): row.declaration.module == module
                None: False
            (id == expected).and(declared)
        _:
            False


-- A user `set` or `dict` cannot redirect a literal: it calls the
-- functions of the module declaring the prelude's Dict. `main` comes first,
-- so it is the program's first function.
private pure func calls_library(declarations: String) -> Bool:
    source = "func main() -> Int:\n    x = {1 => 2}\n    0\n" + declarations
    match (program(source, standard()), module_id(DICT_POSITION)):
        (Ok(parsed), Some(library)):
            match check(parsed):
                Err(_):
                    False
                Ok(checked):
                    functions = checked_functions(checked)
                    match (functions.functions.get(0), functions.traits.canonical.dict_literal):
                        (Some(main), Some(literal)):
                            match Model.function_calls(main):
                                [reserve, insert]:
                                    declared_in(parsed, reserve, literal.dict, library).and(
                                        declared_in(parsed, insert, literal.set, library),
                                    )
                                _:
                                    False
                        _:
                            False
        _:
            False


pure func test_user_functions_do_not_redirect_literals() -> Bool:
    decoys: String =
        |pure func dict(initial_capacity: Int) -> Int:
        |    initial_capacity
        |pure func set(self: Int, key: Int, value: Int) -> Int:
        |    value
        |
    calls_library("").and(calls_library(decoys))


-- With no Dict selected, or one whose `set` is impure, a literal has no
-- functions to call; a literal is pure, so pure code may always write one.
pure func test_literals_need_the_prelude_dict() -> Bool:
    source = "func main() -> Int:\n    x = {1 => 2}\n    0\n"
    impure = DICT_LIBRARY + DICT_SET
    message = "Dict literals require the prelude's Dict"
    help = "select a Dict whose module declares pure empty, dict and set functions in the configured prelude"
    rejects_in(
        source,
        { standard() | offered = False },
        LINE_START + 4,
        LINE_START + 12,
        message,
        help,
    ).and(
        rejects_in(
            source,
            { standard() | library = impure },
            LINE_START + 4,
            LINE_START + 12,
            message,
            help,
        ),
    )


tests: TestSuite = {
    description = "Dict literal checking",
    tests = [
        ("an empty literal needs its type", test_empty_literal_needs_its_type),
        ("expected types type empty literals", test_expected_types_type_empty_literals),
        ("entries supply their types", test_entries_supply_their_types),
        (
            "mismatched entries use the argument mismatch",
            test_mismatched_entries_use_the_argument_mismatch,
        ),
        ("non-Hashable keys meet the existing bounds", test_non_dict_keys_meet_the_existing_bounds),
        (
            "an empty literal against a record is a mismatch",
            test_empty_literal_against_a_record_is_a_mismatch,
        ),
        ("user functions do not redirect literals", test_user_functions_do_not_redirect_literals),
        ("literals need the prelude's Dict", test_literals_need_the_prelude_dict),
    ],
}
