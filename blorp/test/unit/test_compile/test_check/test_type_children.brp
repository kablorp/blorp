---
`type_children` lists the types a type is built from, in the order the
walkers visit them: a callable's parameters then its result, a tuple's
elements, a List's element and a nominal type's arguments.
---
import:
    test: TestSuite
    ../../../../src/compile/check/check: check, checked_functions
    ../../../../src/compile/check/model as Model
    ../../module_input: parse_modules


private SOURCE: String =
    |union Box[T]:
    |    Box(T)
    |pure func inspect[T](
    |    plain: T,
    |    boxed: Box[T],
    |    listed: List[T],
    |    pair: (T, Int),
    |    call: pure (T, Int) -> Box[T],
    |) -> Int:
    |    0
    |func main() -> Int:
    |    0
    |


-- The checked parameter types of `inspect`, the source's first function.
private pure func parameter_types() -> List[Model.TypeRef]:
    match parse_modules([{ source = SOURCE, targets = [] }]):
        Err(_):
            []
        Ok(parsed):
            match check(parsed):
                Err(_):
                    []
                Ok(accepted):
                    match checked_functions(accepted).functions.get(0):
                        None:
                            []
                        Some(function):
                            function.signature.parameters.map(
                                pure func(parameter): parameter.value_type,
                            )


pure func test_leaf_types_have_no_children() -> Bool:
    match parameter_types():
        [plain, _, _, _, _]:
            leaves: List[Model.TypeRef] = [
                Model.VoidType,
                Model.IntType,
                Model.FloatType,
                Model.StringType,
                plain,
            ]
            none: List[Model.TypeRef] = []
            leaves.all(pure func(leaf): Model.type_children(leaf) == none)
        _:
            False


pure func test_compound_types_list_their_parts_in_visiting_order() -> Bool:
    match parameter_types():
        [plain, boxed, listed, pair, call]:
            int: Model.TypeRef = Model.IntType
            boxed_children = Model.type_children(boxed) == [plain]
            listed_children = Model.type_children(listed) == [plain]
            pair_children = Model.type_children(pair) == [plain, int]
            -- The result `Box[T]` follows both parameters.
            call_children = Model.type_children(call) == [plain, int, boxed]
            [boxed_children, listed_children, pair_children, call_children].all(
                pure func(holds: Bool) -> Bool: holds,
            )
        _:
            False


tests: TestSuite = {
    description = "Type children",
    tests = [
        ("leaf types have no children", test_leaf_types_have_no_children),
        (
            "compound types list their parts in visiting order",
            test_compound_types_list_their_parts_in_visiting_order,
        ),
    ],
}
