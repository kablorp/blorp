---
A generic opaque type is a nominal application like a generic record: its
declaration owns its type parameters, and each conversion infers the
arguments as a call infers a generic function's.
---
import:
    bool: and, not
    int: Int methods
    result: Result methods
    string: String methods
    test: TestSuite
    ../../../../src/compile/check/check: check, checked_functions
    ../../../../src/compile/check/model as model
    ../../../../src/compile/check/render: render_failure
    ../../../../src/compile/ids: opaque_number
    ../../../../src/compile/namespace/builtins: IntegerFormat(Int64Format)
    ../../../../src/syntax/source: module_source, root_module_id
    ../../module_input: parse_modules


private SOURCE: String =
    |record Rows[V] { entries: List[V] }
    |record User { name: String }
    |record Order { total: Int }
    |opaque type Box[V] = Rows[V]
    |opaque type Id[T] = Int
    |opaque type Name = String
    |pure func inspect(ints: Box[Int], texts: Box[String], user: Id[User], order: Id[Order], name: Name) -> Int:
    |    0
    |pure func wrap(value: Int) -> Box[Int]:
    |    into_opaque Box({ entries = [value] })
    |pure func unwrap(box: Box[String]) -> Rows[String]:
    |    from_opaque Box(box)
    |func main() -> Int:
    |    0
    |


private pure func checked() -> Option[model.CheckedFunctions]:
    match parse_modules([{ source = SOURCE, targets = [] }]):
        Err(_):
            None
        Ok(parsed):
            match check(parsed):
                Err(_): None
                Ok(accepted): Some(checked_functions(accepted))


private pure func returned(
    functions: model.CheckedFunctions,
    position: Int,
) -> Option[model.CheckedExpr]:
    match functions.functions.get(position):
        Some(function):
            match function.body:
                model.CheckedValueBody(model.ReturnExpression(value)): Some(value)
                _: None
        None:
            None


pure func test_opaque_declaration_owns_its_parameters() -> Bool:
    match checked():
        None:
            False
        Some(functions):
            match functions.opaques.get(0):
                None:
                    False
                Some(box):
                    match (box.type_parameters, box.underlying_type.value_type):
                        ([parameter], model.NominalType(model.AggregateNominal(model.RecordAggregate(_)), [model.ParameterType(used)])):
                            owned: Bool = match model.parameter_owner(parameter):
                                model.OpaqueDeclaration(owner):
                                    opaque_number(owner) == opaque_number(box.id)
                                _:
                                    False
                            and(owned, parameter == used)
                        _:
                            False


pure func test_applied_opaque_types_are_nominal_applications() -> Bool:
    match checked():
        None:
            False
        Some(functions):
            match functions.functions.get(0):
                None:
                    False
                Some(inspect):
                    match inspect.signature.parameters.map(
                        pure func(parameter): parameter.value_type,
                    ):
                        [ints, texts, user, order, name]:
                            shapes: Bool = match (ints, user, name):
                                (model.NominalType(model.OpaqueNominal(_), [model.IntegerType(Int64Format)]), model.NominalType(model.OpaqueNominal(_), [model.NominalType(model.AggregateNominal(_), [])]), model.NominalType(model.OpaqueNominal(_), [])):
                                    True
                                _:
                                    False
                            distinct = and(not(ints == texts), not(user == order))
                            and(shapes, and(distinct, user == user))
                        _:
                            False


pure func test_wrapping_infers_arguments_from_the_operand() -> Bool:
    match checked():
        None:
            False
        Some(functions):
            match returned(functions, 1):
                None:
                    False
                Some(value):
                    match (value.form, value.value_type):
                        (model.ConstructOpaque(_, operand), model.NominalType(model.OpaqueNominal(_), [model.IntegerType(Int64Format)])):
                            match operand.value_type:
                                model.NominalType(model.AggregateNominal(model.RecordAggregate(_)), [model.IntegerType(Int64Format)]):
                                    True
                                _:
                                    False
                        _:
                            False


pure func test_unwrapping_substitutes_the_operand_arguments() -> Bool:
    match checked():
        None:
            False
        Some(functions):
            match returned(functions, 2):
                None:
                    False
                Some(value):
                    match (value.form, value.value_type):
                        (model.ProjectOpaque(_, _), model.NominalType(model.AggregateNominal(model.RecordAggregate(_)), [model.StringType])):
                            True
                        _:
                            False


-- The rejection's first diagnostic covers exactly `marked`, which follows `prefix`.
private pure func rejects(
    prefix: String,
    marked: String,
    rest: String,
    message: String,
    help: String,
) -> Bool:
    match parse_modules([{ source = "${prefix}${marked}${rest}", targets = [] }]):
        Err(_):
            False
        Ok(parsed):
            match check(parsed):
                Ok(_):
                    False
                Err(failure):
                    errors = render_failure(failure)
                    error = errors.first
                    error.message
                        .equals(message)
                        .and(error.help.equals(help))
                        .and(error.span.source == module_source(root_module_id()))
                        .and(error.span.start.equals(prefix.length()))
                        .and(error.span.end.equals(prefix.length() + (marked.length())))
                        .and(errors.remaining.is_empty())


private pure func accepts(source: String) -> Bool:
    match parse_modules([{ source = source, targets = [] }]):
        Err(_): False
        Ok(parsed): check(parsed).is_ok()


pure func test_an_unfixed_phantom_parameter_is_rejected_at_the_conversion() -> Bool:
    rejects(
        "opaque type Id[T] = Int\nfunc main() -> Int:\n    id = ",
        "into_opaque Id(7)",
        "\n    0\n",
        "cannot infer type parameter T of opaque type Id",
        "give into_opaque an expected type, as in value: Id[...] = into_opaque Id(...), or give from_opaque an operand whose Id type is known",
    )


pure func test_an_expected_type_fixes_a_phantom_parameter() -> Bool:
    source = "record User { name: String }\nopaque type Id[T] = Int\nfunc main() -> Int:\n    id: Id[User] = into_opaque Id(7)\n    0\n"
    accepts(source)


-- An applied opaque that holds its union behind a pointer, or not at all, is no
-- by-value cycle: Id erases to Int and Rows to a List.
pure func test_an_opaque_over_a_pointer_to_its_union_is_accepted() -> Bool:
    source: String =
        |opaque type Id[T] = Int
        |opaque type Rows[V] = List[V]
        |union U:
        |    Named(Id[U])
        |    Nested(Rows[U])
        |    Empty
        |func main() -> Int:
        |    0
        |
    accepts(source)


private NAMED_BOX: String =
    |trait Named:
    |    pure func name(value: Self) -> Int
    |opaque type Box[V] = List[V]
    |pure func wrap[V](value: V) -> Box[V]:
    |    into_opaque Box([value])
    |


-- Box's implementation is conditional on V: Named, so it serves Box[Int] once
-- Int is Named and is unavailable for Box[String].
pure func test_a_generic_opaque_implementation_is_conditional_on_its_bounds() -> Bool:
    declarations: String =
        |implements Named for Int:
        |    pure func name(value: Self) -> Int:
        |        value
        |implements Named for Box[V: Named]:
        |    pure func name(value: Self) -> Int:
        |        1
        |func main() -> Int:
        |
    accepts(NAMED_BOX + declarations + "    wrap(7).name()\n").and(
        rejects(
            NAMED_BOX + declarations + "    wrap(\"seven\").",
            "name",
            "()\n",
            "type does not satisfy the required trait bound",
            "add the required trait to this function's type parameter bounds, or provide an implementation for the concrete receiver",
        ),
    )


pure func test_a_generic_opaque_receiver_introduces_every_parameter() -> Bool:
    rejects(
        NAMED_BOX + "implements Named for ",
        "Box",
        ":\n    pure func name(value: Self) -> Int:\n        0\nfunc main() -> Int:\n    0\n",
        "implementation receiver must introduce its complete type parameter family",
        "write one distinct fresh parameter for every receiver argument; specialized or nested receiver patterns are not supported",
    )


pure func test_a_generic_opaque_implementation_meets_its_supertrait_obligations() -> Bool:
    rejects(
        NAMED_BOX + "trait Keyed: Named\nimplements ",
        "Keyed",
        " for Box[V: Keyed]\nfunc main() -> Int:\n    0\n",
        "implementing Keyed for Box requires an implementation of Named",
        "add implements Named for Box",
    )


TESTS: TestSuite = {
    description = "Generic opaque types",
    tests = [
        (
            "an opaque declaration owns its type parameters",
            test_opaque_declaration_owns_its_parameters,
        ),
        (
            "applied opaque types are nominal applications distinct by argument",
            test_applied_opaque_types_are_nominal_applications,
        ),
        (
            "wrapping infers the opaque arguments from the operand",
            test_wrapping_infers_arguments_from_the_operand,
        ),
        (
            "unwrapping substitutes the operand's arguments into the underlying type",
            test_unwrapping_substitutes_the_operand_arguments,
        ),
        (
            "an unfixed phantom parameter is rejected at the conversion",
            test_an_unfixed_phantom_parameter_is_rejected_at_the_conversion,
        ),
        (
            "an expected type fixes a phantom parameter",
            test_an_expected_type_fixes_a_phantom_parameter,
        ),
        (
            "an opaque over a pointer to its union is accepted",
            test_an_opaque_over_a_pointer_to_its_union_is_accepted,
        ),
        (
            "a generic opaque implementation is conditional on its bounds",
            test_a_generic_opaque_implementation_is_conditional_on_its_bounds,
        ),
        (
            "a generic opaque receiver introduces every parameter",
            test_a_generic_opaque_receiver_introduces_every_parameter,
        ),
        (
            "a generic opaque implementation meets its supertrait obligations",
            test_a_generic_opaque_implementation_meets_its_supertrait_obligations,
        ),
    ],
}
