-- `to_string` named as a value is Stringable's member, so importing it from
-- int reaches Float's implementation too.
import:
    int: to_string
    list: List methods


func show(counts: List[Int], ratios: List[Float]) -> List[String]:
    counts
        .map(to_string)
        .concat(ratios.map(to_string))


func main() -> Int:
    0
