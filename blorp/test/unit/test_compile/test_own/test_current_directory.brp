import:
    bool: Bool methods
    option: Option methods
    result: Result methods
    test: TestSuite
    ../../../../src/compile/check/model: match_arm_number
    ../../../../src/compile/lower/lower as lower
    ../../../../src/compile/own/own as own
    ../../../../src/compile/specialize/specialize as specialized
    ../../../../src/syntax/syntax: entry_function
    ../../current_directory_inputs:
        CURRENT_DIRECTORY_SOURCE,
        current_directory_seed,
        current_directory_seed_from_source,
    ../../module_input: test_base
    ../../text_search: replace_first


pure func test_native_result_returns_its_single_owner() -> Bool:
    match current_directory_seed(test_base()):
        Err(_):
            False
        Ok(seed):
            match own.insert_function(seed.query, lower.lowered_functions(seed.lowered).unions, []):
                Err(_):
                    False
                Ok(function):
                    match (function.operations, function.result):
                        ([own.DefineValue(result)], own.OwnedReturn(value, transferred)):
                            match result.result:
                                own.OwnedResult(owner):
                                    (own.owner_number(owner) == own.owner_number(transferred)).and(
                                        lower.value_number(result.id) == lower.value_number(value),
                                    )
                                _:
                                    False
                        _:
                            False


pure func test_both_result_payloads_acquire_before_parent_drop() -> Bool:
    match current_directory_seed(test_base()):
        Err(_):
            False
        Ok(seed):
            match own.own(seed.lowered).map(
                pure func(program): program.functions.get(specialized.function_number(seed.escape)),
            ):
                Ok(Some(escaped)):
                    match (escaped.operations, escaped.result):
                        ([own.DefineValue(parent), own.ExecuteJoin(matched)], own.OwnedReturn(joined, transferred)):
                            match (parent.result, matched.result):
                                (own.OwnedResult(parent_owner), own.ManagedJoinParameter(result, result_owner)):
                                    (matched.entering.map(pure func(owner): own.owner_number(owner)) == [
                                        own.owner_number(parent_owner),
                                    ])
                                        .and(
                                            (
                                                lower.value_number(joined)
                                                == lower.value_number(result.id)
                                            ),
                                        )
                                        .and(
                                            (
                                                own.owner_number(transferred)
                                                == own.owner_number(result_owner)
                                            ),
                                        )
                                        .and(matched.arms.length() == 2)
                                        .and(
                                            matched.arms.all(pure func(arm):
                                                match (arm.inputs, arm.operations, arm.exit):
                                                    ([own.ManagedJoinParameter(input, canonical)], [own.DropOwner(dropped, _)], own.Yield(outputs)):
                                                        matched.selection.nodes.any(pure func(node):
                                                            match node:
                                                                own.EnterArm(edge):
                                                                    match (
                                                                        edge.operations,
                                                                        edge.transfers,
                                                                        outputs.transfer,
                                                                    ):
                                                                        ([own.DefineValue(child), own.AcquireOwner(owner, borrow, _)], [own.OwnedReturn(selected, moved)], own.OwnedReturn(value, returned)):
                                                                            match (
                                                                                child.operation,
                                                                                child.result,
                                                                                borrow.source,
                                                                            ):
                                                                                (own.PayloadDefinition(_, projected), own.BorrowedResult(own.PayloadBorrow(source)), own.PayloadBorrow(borrowed)):
                                                                                    (own.owner_number(
                                                                                        dropped,
                                                                                    ) == own.owner_number(
                                                                                        parent_owner,
                                                                                    ))
                                                                                        .and(
                                                                                            (
                                                                                                match_arm_number(
                                                                                                    edge.arm,
                                                                                                )
                                                                                                == match_arm_number(
                                                                                                    arm.id,
                                                                                                )
                                                                                            ),
                                                                                        )
                                                                                        .and(
                                                                                            (
                                                                                                lower.value_number(
                                                                                                    projected,
                                                                                                )
                                                                                                == lower.value_number(
                                                                                                    parent.id,
                                                                                                )
                                                                                            ),
                                                                                        )
                                                                                        .and(
                                                                                            (
                                                                                                lower.value_number(
                                                                                                    source,
                                                                                                )
                                                                                                == lower.value_number(
                                                                                                    parent.id,
                                                                                                )
                                                                                            ),
                                                                                        )
                                                                                        .and(
                                                                                            (
                                                                                                lower.value_number(
                                                                                                    borrowed,
                                                                                                )
                                                                                                == lower.value_number(
                                                                                                    parent.id,
                                                                                                )
                                                                                            ),
                                                                                        )
                                                                                        .and(
                                                                                            (
                                                                                                lower.value_number(
                                                                                                    borrow.value,
                                                                                                )
                                                                                                == lower.value_number(
                                                                                                    child.id,
                                                                                                )
                                                                                            ),
                                                                                        )
                                                                                        .and(
                                                                                            (
                                                                                                lower.value_number(
                                                                                                    selected,
                                                                                                )
                                                                                                == lower.value_number(
                                                                                                    child.id,
                                                                                                )
                                                                                            ),
                                                                                        )
                                                                                        .and(
                                                                                            (
                                                                                                own.owner_number(
                                                                                                    owner,
                                                                                                )
                                                                                                == own.owner_number(
                                                                                                    moved,
                                                                                                )
                                                                                            ),
                                                                                        )
                                                                                        .and(
                                                                                            (
                                                                                                own.owner_number(
                                                                                                    owner,
                                                                                                )
                                                                                                != own.owner_number(
                                                                                                    canonical,
                                                                                                )
                                                                                            ),
                                                                                        )
                                                                                        .and(
                                                                                            (
                                                                                                lower.value_number(
                                                                                                    input.id,
                                                                                                )
                                                                                                != lower.value_number(
                                                                                                    child.id,
                                                                                                )
                                                                                            ),
                                                                                        )
                                                                                        .and(
                                                                                            (
                                                                                                lower.value_number(
                                                                                                    value,
                                                                                                )
                                                                                                == lower.value_number(
                                                                                                    input.id,
                                                                                                )
                                                                                            ),
                                                                                        )
                                                                                        .and(
                                                                                            (
                                                                                                own.owner_number(
                                                                                                    returned,
                                                                                                )
                                                                                                == own.owner_number(
                                                                                                    canonical,
                                                                                                )
                                                                                            ),
                                                                                        )
                                                                                        .and(
                                                                                            outputs.carried.is_empty(),
                                                                                        )
                                                                                _:
                                                                                    False
                                                                        _:
                                                                            False
                                                                _:
                                                                    False
                                                        )
                                                    _:
                                                        False
                                            ),
                                        )
                                _:
                                    False
                        _:
                            False
                _:
                    False


private pure func owned_main(source: String) -> Option[own.OwnedFunction]:
    match current_directory_seed_from_source(source, test_base()).and_then(
        pure func(seed): own.own(seed.lowered),
    ):
        Err(_):
            None
        Ok(program):
            program.functions.get(specialized.function_number(entry_function(program.entrypoint)))


pure func test_unused_result_drops_its_owner_once() -> Bool:
    match owned_main(CURRENT_DIRECTORY_SOURCE):
        Some(main):
            match main.operations.get(0):
                Some(own.DefineValue(unused)):
                    match unused.result:
                        own.OwnedResult(owner):
                            (
                                main.operations
                                    .filter(pure func(operation):
                                        match operation:
                                            own.DropOwner(dropped, _):
                                                own.owner_number(dropped) == own.owner_number(owner)
                                            _:
                                                False
                                    )
                                    .length()
                                == 1
                            )
                        _:
                            False
                _:
                    False
        None:
            False


pure func test_duplicate_results_acquire_distinct_stored_owners() -> Bool:
    source = replace_first(
        CURRENT_DIRECTORY_SOURCE,
        "    escaped = escape()\n",
        "    escaped = escape()\n    copies = [unused, unused]\n",
    )
    match owned_main(source):
        None:
            False
        Some(main):
            main.operations.any(pure func(operation):
                match operation:
                    own.DefineValue(definition):
                        match definition.operation:
                            own.ConstructListDefinition([own.OwnedPayload(first, first_owner), own.OwnedPayload(second, second_owner)]):
                                (lower.value_number(first) == lower.value_number(second)).and(
                                    own.owner_number(first_owner) != own.owner_number(second_owner),
                                )
                            _:
                                False
                    _:
                        False
            )


TESTS: TestSuite = {
    description = "Blorp native Result ownership",
    tests = [
        ("unused Result drops once", test_unused_result_drops_its_owner_once),
        (
            "duplicate Result slots have distinct owners",
            test_duplicate_results_acquire_distinct_stored_owners,
        ),
        ("native Result transfers its fresh owner", test_native_result_returns_its_single_owner),
        (
            "both payloads escape before parent destruction",
            test_both_result_payloads_acquire_before_parent_drop,
        ),
    ],
}
