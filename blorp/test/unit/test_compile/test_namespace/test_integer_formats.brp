import:
    bool: Bool methods
    test: TestSuite
    ../../../../src/compile/namespace/builtins as Builtins:
        IntegerFormat(Int64Format),
        integer_fits,
        integer_primitive,
    ../../../../src/syntax/syntax:
        ParsedRuntimeOperation(
            IntegerAddBuiltin,
            IntegerSubtractBuiltin,
            IntegerMultiplyBuiltin,
            IntegerDivideBuiltin,
            IntegerRemainderBuiltin,
            IntegerToStringBuiltin,
        ),
        Purity(Pure),


pure func test_int64_format_accepts_the_complete_literal_carrier() -> Bool:
    integer_fits(Int64Format, -9223372036854775808)
        .and(integer_fits(Int64Format, -1))
        .and(integer_fits(Int64Format, 0))
        .and(integer_fits(Int64Format, 9223372036854775807))


pure func test_int64_format_projects_to_the_existing_primitive() -> Bool:
    integer_primitive(Int64Format) == Builtins.BuiltinInt


pure func test_integer_builtin_labels_preserve_the_int64_format() -> Bool:
    operations: List[Option[Builtins.RuntimeOperation[Int, Int]]] = [
        Builtins.primitive_operation(IntegerAddBuiltin),
        Builtins.primitive_operation(IntegerSubtractBuiltin),
        Builtins.primitive_operation(IntegerMultiplyBuiltin),
        Builtins.primitive_operation(IntegerDivideBuiltin),
        Builtins.primitive_operation(IntegerRemainderBuiltin),
        Builtins.primitive_operation(IntegerToStringBuiltin),
    ]
    expected: List[Option[Builtins.RuntimeOperation[Int, Int]]] = [
        Some(Builtins.IntegerAdd(Int64Format)),
        Some(Builtins.IntegerSubtract(Int64Format)),
        Some(Builtins.IntegerMultiply(Int64Format)),
        Some(Builtins.IntegerDivide(Int64Format)),
        Some(Builtins.IntegerRemainder(Int64Format)),
        Some(Builtins.IntegerToString(Int64Format)),
    ]
    operations == expected


pure func test_every_integer_arithmetic_contract_uses_its_format() -> Bool:
    operations: List[Builtins.RuntimeOperation[Int, Int]] = [
        Builtins.IntegerAdd(Int64Format),
        Builtins.IntegerSubtract(Int64Format),
        Builtins.IntegerMultiply(Int64Format),
        Builtins.IntegerDivide(Int64Format),
        Builtins.IntegerRemainder(Int64Format),
    ]
    var accepted: Bool = True
    for operation in operations:
        contract = Builtins.runtime_contract(operation)
        match (contract.purity, contract.parameters, contract.return_type):
            (Pure, [Builtins.PrimitiveRuntimeType(Builtins.BuiltinInt), Builtins.PrimitiveRuntimeType(Builtins.BuiltinInt)], Builtins.ValueResult(Builtins.PrimitiveRuntimeType(Builtins.BuiltinInt))):
                void
            _:
                accepted = False
    accepted


pure func test_integer_comparison_contracts_preserve_the_designated_boolean() -> Bool:
    boolean: Builtins.DesignatedBoolean[Int] = { true_variant = 3, false_variant = 7 }
    operations: List[Builtins.RuntimeOperation[Int, Int]] = [
        Builtins.IntegerEquals(Int64Format, boolean),
        Builtins.IntegerLessThan(Int64Format, boolean),
    ]
    var accepted: Bool = True
    for operation in operations:
        contract = Builtins.runtime_contract(operation)
        match (contract.purity, contract.parameters, contract.return_type):
            (Pure, [Builtins.PrimitiveRuntimeType(Builtins.BuiltinInt), Builtins.PrimitiveRuntimeType(Builtins.BuiltinInt)], Builtins.BooleanResult(designated)):
                accepted = accepted.and(designated == boolean)
            _:
                accepted = False
    accepted


tests: TestSuite = {
    description = "Blorp integer format facts",
    tests = [
        (
            "Int64 format accepts the complete literal carrier",
            test_int64_format_accepts_the_complete_literal_carrier,
        ),
        (
            "Int64 format projects to the existing primitive",
            test_int64_format_projects_to_the_existing_primitive,
        ),
        (
            "integer builtin labels preserve the Int64 format",
            test_integer_builtin_labels_preserve_the_int64_format,
        ),
        (
            "every integer arithmetic contract uses its format",
            test_every_integer_arithmetic_contract_uses_its_format,
        ),
        (
            "integer comparison contracts preserve the designated Boolean",
            test_integer_comparison_contracts_preserve_the_designated_boolean,
        ),
    ],
}
