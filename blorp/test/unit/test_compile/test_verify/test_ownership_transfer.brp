import:
    bool: Bool methods
    int: Int methods
    list: List methods
    option: Option methods
    result: Result methods
    string: String methods
    test: TestSuite
    ../../../../src/compile/check/model as Model
    ../../../../src/compile/lower/lower as Lower
    ../../../../src/compile/namespace/builtins as Builtins: IntegerFormat(Int64Format)
    ../../../../src/compile/own/own as Own
    ../../../../src/compile/specialize/specialize as Concrete
    ../../../../src/compile/verify/verify: verify
    ../../../../src/syntax/syntax:
        Diagnostic,
        DiagnosticKind(ProgramProblem),
        Span,
        Entrypoint(NoArguments),
        EntryResult(IntegerExitStatus),
        entry_function,
    ../../list_update_inputs: lowered, owned_source, placeholder_label, span


record TransferIds {
    first: Lower.ValueId,
    second: Lower.ValueId,
    third: Lower.ValueId,
    fourth: Lower.ValueId,
    fifth: Lower.ValueId,
    sixth: Lower.ValueId,
    seventh: Lower.ValueId,
    eighth: Lower.ValueId,
    ninth: Lower.ValueId,
    entrypoint: Concrete.FunctionInstanceId,
}


-- Mint opaque identities through lowering; this seed supplies no ownership facts.
private pure func transfer_ids() -> Result[TransferIds, Diagnostic]:
    source: String =
        |func main() -> Int:
        |    first = 1
        |    second = 2
        |    third = 3
        |    fourth = 4
        |    fifth = 5
        |    sixth = 6
        |    seventh = 7
        |    eighth = 8
        |    9
        |
    program ?= lowered(source).map(Lower.lowered_functions)
    failure: Diagnostic = {
        span = span(0),
        kind = ProgramProblem,
        note = None,
        message = "expected nine identity seed definitions",
        help = "fix the ownership transfer test seed",
    }
    match program.functions:
        [seed]:
            match seed.steps:
                [Lower.Define(first), Lower.Define(second), Lower.Define(third), Lower.Define(fourth), Lower.Define(fifth), Lower.Define(sixth), Lower.Define(seventh), Lower.Define(eighth), Lower.Define(ninth)]:
                    Ok({
                        first = first.id,
                        second = second.id,
                        third = third.id,
                        fourth = fourth.id,
                        fifth = fifth.id,
                        sixth = sixth.id,
                        seventh = seventh.id,
                        eighth = eighth.id,
                        ninth = ninth.id,
                        entrypoint = entry_function(program.entrypoint),
                    })
                _:
                    Err(failure)
        _:
            Err(failure)


private pure func rejects(program: Own.OwnershipProgram, message: String, at: Int) -> Bool:
    match verify(program):
        Ok(_):
            False
        Err(error):
            error.message
                .equals("ownership verification failed: " + message)
                .and(error.help.equals("report this compiler error with the input program"))
                .and(error.span.source == span(at).source)
                .and(error.span.start.equals(at))
                .and(error.span.end.equals(at + 1))
                .and(error.note.is_none())


private pure func list_type() -> Concrete.TypeRef:
    Concrete.ListType(Concrete.IntegerType(Int64Format))


private pure func empty_list(id: Lower.ValueId, owner: Int, at: Int) -> Own.OwnershipOperation:
    Own.DefineValue({
        id = id,
        value_type = list_type(),
        operation = Own.ConstructListDefinition([]),
        result = Own.OwnedResult(Own.owner_id(owner)),
        span = span(at),
    })


private pure func integer(id: Lower.ValueId, value: Int, at: Int) -> Own.OwnershipOperation:
    Own.DefineValue({
        id = id,
        value_type = Concrete.IntegerType(Int64Format),
        operation = Own.IntegerDefinition(value),
        result = Own.UnmanagedResult,
        span = span(at),
    })


private pure func length_of(
    id: Lower.ValueId,
    list: Lower.ValueId,
    owner: Int,
    at: Int,
) -> Own.OwnershipOperation:
    argument: Own.OwnedArgument = Own.BorrowedArgument({
        value = list,
        source = Own.OwnerBorrow(Own.owner_id(owner)),
    })
    Own.DefineValue({
        id = id,
        value_type = Concrete.IntegerType(Int64Format),
        operation = Own.CallDefinition(
            Concrete.RuntimeFunction(Builtins.ListLength(Concrete.IntegerType(Int64Format))),
            [argument],
        ),
        result = Own.UnmanagedResult,
        span = span(at),
    })


private pure func header(
    id: Lower.ValueId,
    owner: Int,
    initial: Own.ReturnTransfer,
    at: Int,
) -> Own.OwnedLoopHeader:
    {
        parameter = Own.ManagedJoinParameter(
            { id = id, value_type = list_type(), span = span(at) },
            Own.owner_id(owner),
        ),
        initial = initial,
    }


private pure func program_with(ids: TransferIds, worker: Own.OwnedFunction) -> Own.OwnershipProgram:
    main: Own.OwnedFunction = {
        label = placeholder_label("main"),
        parameters = [],
        return_type = Concrete.IntegerType(Int64Format),
        operations = [integer(ids.first, 0, 1)],
        result = Own.UnmanagedReturn(ids.first),
    }
    {
        records = [],
        unions = [],
        functions = [main, worker],
        entrypoint = NoArguments(ids.entrypoint, IntegerExitStatus),
    }


-- One raw contract per fault. Its accepted form: v0 and v1 own fresh Lists;
-- the loop header takes v0's owner 0 with no entry acquisition, reads its own
-- header in the body and drops it at the break; the continuation drops only
-- owner 1. The loop body's values and owners follow the block (v4, owner 2).
private union HeaderFault:
    NoFault
    AcquiredOwnerTransfers
    DropAfterLoop
    ReadAfterLoop
    DropInBody
    ReadInBody
    NotItsInitial
    TakenTwice
    AcquiresFromTaken


private pure func header_program(ids: TransferIds, fault: HeaderFault) -> Own.OwnershipProgram:
    var prefix: List[Own.OwnershipOperation] = [
        empty_list(ids.first, 0, 10),
        empty_list(ids.second, 1, 11),
    ]
    var acquisitions: List[Own.OwnerAcquisition] = []
    var headers = [header(ids.fifth, 2, Own.OwnedReturn(ids.first, Own.owner_id(0)), 40)]
    var body: List[Own.OwnershipOperation] = [
        length_of(ids.sixth, ids.fifth, 2, 45),
        Own.DropOwner(Own.owner_id(2), span(46)),
    ]
    var after: List[Own.OwnershipOperation] = [
        integer(ids.fourth, 0, 60),
        Own.DropOwner(Own.owner_id(1), span(61)),
    ]
    match fault:
        NoFault:
            void
        AcquiredOwnerTransfers:
            -- Owner 1 is an acquisition of v0 made before the loop, as a
            -- projection's owner is; the header takes it and owner 0 drops later.
            prefix = [
                empty_list(ids.first, 0, 10),
                Own.AcquireOwner(
                    Own.owner_id(1),
                    { value = ids.first, source = Own.OwnerBorrow(Own.owner_id(0)) },
                    span(11),
                ),
                integer(ids.second, 0, 12),
            ]
            headers = [header(ids.fifth, 2, Own.OwnedReturn(ids.first, Own.owner_id(1)), 40)]
            after = [integer(ids.fourth, 0, 60), Own.DropOwner(Own.owner_id(0), span(61))]
        DropAfterLoop:
            after = after.append(Own.DropOwner(Own.owner_id(0), span(62)))
        ReadAfterLoop:
            after = [
                length_of(ids.fourth, ids.first, 0, 60),
                Own.DropOwner(Own.owner_id(1), span(61)),
            ]
        DropInBody:
            body = [Own.DropOwner(Own.owner_id(0), span(44))].concat(body)
        ReadInBody:
            body = [
                length_of(ids.sixth, ids.first, 0, 45),
                Own.DropOwner(Own.owner_id(2), span(46)),
            ]
        NotItsInitial:
            headers = [header(ids.fifth, 2, Own.OwnedReturn(ids.first, Own.owner_id(1)), 40)]
        TakenTwice:
            headers = headers.append(
                header(ids.sixth, 3, Own.OwnedReturn(ids.first, Own.owner_id(0)), 41),
            )
            body = [
                length_of(ids.seventh, ids.fifth, 2, 45),
                Own.DropOwner(Own.owner_id(2), span(46)),
                Own.DropOwner(Own.owner_id(3), span(47)),
            ]
        AcquiresFromTaken:
            acquisitions = [
                {
                    owner = Own.owner_id(2),
                    borrow = { value = ids.first, source = Own.OwnerBorrow(Own.owner_id(0)) },
                },
            ]
            headers = [
                header(ids.fifth, 3, Own.OwnedReturn(ids.first, Own.owner_id(0)), 40),
                header(ids.sixth, 4, Own.OwnedReturn(ids.first, Own.owner_id(2)), 41),
            ]
            body = [
                length_of(ids.seventh, ids.fifth, 3, 45),
                Own.DropOwner(Own.owner_id(3), span(46)),
                Own.DropOwner(Own.owner_id(4), span(47)),
            ]
    result = match body.get(0):
        Some(Own.DefineValue(definition)): definition.id
        _: ids.sixth
    loop: Own.OwnedLoop = {
        entry_acquisitions = acquisitions,
        headers = headers,
        result = Own.UnmanagedJoinParameter({
            id = ids.third,
            value_type = Concrete.IntegerType(Int64Format),
            span = span(30),
        }),
        carried = [],
        body = {
            operations = body,
            tail = Own.ExitLoop(
                Own.Break({ value = Own.UnmanagedReturn(result), carried = [], span = span(50) }),
            ),
        },
    }
    program_with(ids, {
        label = placeholder_label("worker"),
        parameters = [],
        return_type = Concrete.IntegerType(Int64Format),
        operations = prefix
            .append(Own.ExecuteLoop(loop))
            .concat(after),
        result = Own.UnmanagedReturn(ids.fourth),
    })


private pure func header_rejects(fault: HeaderFault, message: String, at: Int) -> Bool:
    match transfer_ids():
        Err(_):
            False
        Ok(ids):
            verify(header_program(ids, NoFault))
                .is_ok()
                .and(rejects(header_program(ids, fault), message, at))


pure func test_header_takes_a_dying_owner() -> Bool:
    match transfer_ids():
        Err(_): False
        Ok(ids): verify(header_program(ids, NoFault)).is_ok()


pure func test_acquired_owner_transfers_by_membership_not_origin() -> Bool:
    match transfer_ids():
        Err(_): False
        Ok(ids): verify(header_program(ids, AcquiredOwnerTransfers)).is_ok()


pure func test_taken_owner_cannot_drop_after_the_loop() -> Bool:
    header_rejects(DropAfterLoop, "owner 0 has already been discharged", 62)


pure func test_taken_owner_cannot_be_read_after_the_loop() -> Bool:
    header_rejects(ReadAfterLoop, "borrow refers to discharged owner 0", 60)


pure func test_taken_owner_cannot_drop_in_the_body() -> Bool:
    header_rejects(DropInBody, "owner 0 has already been discharged", 44)


pure func test_taken_owner_cannot_be_read_in_the_body() -> Bool:
    header_rejects(ReadInBody, "borrow refers to discharged owner 0", 45)


pure func test_taken_owner_must_own_its_initial() -> Bool:
    header_rejects(NotItsInitial, "owner 1 does not own value 0", 40)


pure func test_two_headers_cannot_take_one_owner() -> Bool:
    header_rejects(TakenTwice, "owner 0 has already been discharged", 41)


pure func test_entry_acquisition_cannot_borrow_a_taken_owner() -> Bool:
    header_rejects(AcquiresFromTaken, "borrow refers to discharged owner 0", 30)


-- A loop in a yielding arm may take only an owner entering its join. With
-- `takes_entering`, owner 0 enters and the loop's header takes it; otherwise
-- the continuation keeps owner 0 and drops it after the join.
private pure func arm_loop_program(ids: TransferIds, takes_entering: Bool) -> Own.OwnershipProgram:
    loop: Own.OwnedLoop = {
        entry_acquisitions = [],
        headers = [header(ids.fifth, 1, Own.OwnedReturn(ids.first, Own.owner_id(0)), 40)],
        result = Own.UnmanagedJoinParameter({
            id = ids.fourth,
            value_type = Concrete.IntegerType(Int64Format),
            span = span(30),
        }),
        carried = [],
        body = {
            operations = [
                length_of(ids.sixth, ids.fifth, 1, 45),
                Own.DropOwner(Own.owner_id(1), span(46)),
            ],
            tail = Own.ExitLoop(
                Own.Break({
                    value = Own.UnmanagedReturn(ids.sixth),
                    carried = [],
                    span = span(50),
                }),
            ),
        },
    }
    entering: List[Own.OwnerId] = if takes_entering:
        [Own.owner_id(0)]
    else:
        []
    join: Own.OwnedJoin = {
        result = Own.UnmanagedJoinParameter({
            id = ids.third,
            value_type = Concrete.IntegerType(Int64Format),
            span = span(20),
        }),
        carried = [],
        entering = entering,
        selection = {
            scrutinee = Own.UnmanagedArgument(ids.second),
            entry = Model.decision_node_id(0),
            nodes = [
                Own.EnterArm({ arm = Model.match_arm_id(0), operations = [], transfers = [] }),
            ],
        },
        arms = [
            {
                id = Model.match_arm_id(0),
                inputs = [],
                operations = [Own.ExecuteLoop(loop)],
                exit = Own.Yield({ transfer = Own.UnmanagedReturn(ids.fourth), carried = [] }),
            },
        ],
    }
    var operations = [
        empty_list(ids.first, 0, 10),
        integer(ids.second, 7, 11),
        Own.ExecuteJoin(join),
    ]
    if takes_entering.not():
        operations = operations.append(Own.DropOwner(Own.owner_id(0), span(61)))
    program_with(ids, {
        label = placeholder_label("worker"),
        parameters = [],
        return_type = Concrete.IntegerType(Int64Format),
        operations = operations,
        result = Own.UnmanagedReturn(ids.third),
    })


pure func test_loop_in_a_yielding_arm_takes_an_entering_owner() -> Bool:
    match transfer_ids():
        Err(_): False
        Ok(ids): verify(arm_loop_program(ids, True)).is_ok()


pure func test_loop_in_a_yielding_arm_cannot_take_a_non_entering_owner() -> Bool:
    match transfer_ids():
        Err(_):
            False
        Ok(ids):
            rejects(
                arm_loop_program(ids, False),
                "join arm discharges owner 0, which does not enter its join",
                20,
            )


-- One raw contract per join fault. Its accepted form: v0 and v1 own fresh
-- Lists, owners 0 and 1; owner 0 enters the join on Int v2, whose one arm
-- reads v0 and drops owner 0; the continuation defines v4 and drops owner 1.
-- The arm's value v5 follows the block's values. `StoresEntering` is a second
-- accepted form: the arm discharges owner 0 by storing v0 in a new List.
private union JoinFault:
    NoJoinFault
    StoresEntering
    StoresNonEntering
    InactiveEntering
    RepeatedEntering
    UnknownEntering
    DropAfterJoin
    ReadAfterJoin
    LeavesEnteringLive
    DischargesNonEntering
    EdgeDischargesEntering


private pure func join_program(ids: TransferIds, fault: JoinFault) -> Own.OwnershipProgram:
    var prefix: List[Own.OwnershipOperation] = [
        empty_list(ids.first, 0, 10),
        empty_list(ids.second, 1, 11),
        integer(ids.third, 7, 12),
    ]
    var entering = [Own.owner_id(0)]
    var edge: List[Own.OwnershipOperation] = []
    var arm: List[Own.OwnershipOperation] = [
        length_of(ids.sixth, ids.first, 0, 45),
        Own.DropOwner(Own.owner_id(0), span(46)),
    ]
    var after: List[Own.OwnershipOperation] = [
        integer(ids.fifth, 0, 60),
        Own.DropOwner(Own.owner_id(1), span(61)),
    ]
    match fault:
        NoJoinFault:
            void
        InactiveEntering:
            prefix = prefix.append(Own.DropOwner(Own.owner_id(0), span(13)))
        RepeatedEntering:
            entering = entering.append(Own.owner_id(0))
        UnknownEntering:
            entering = entering.append(Own.owner_id(7))
        DropAfterJoin:
            after = after.append(Own.DropOwner(Own.owner_id(0), span(62)))
        ReadAfterJoin:
            after = [
                length_of(ids.fifth, ids.first, 0, 60),
                Own.DropOwner(Own.owner_id(1), span(61)),
            ]
        LeavesEnteringLive:
            arm = [length_of(ids.sixth, ids.first, 0, 45)]
        DischargesNonEntering:
            arm = arm.append(Own.DropOwner(Own.owner_id(1), span(47)))
        EdgeDischargesEntering:
            edge = [Own.DropOwner(Own.owner_id(0), span(15))]
        StoresEntering:
            arm = stored_in_list(ids, ids.first, 0)
        StoresNonEntering:
            arm = stored_in_list(ids, ids.second, 1).append(
                Own.DropOwner(Own.owner_id(0), span(48)),
            )
    yielded = match fault:
        StoresEntering | StoresNonEntering: ids.seventh
        _: ids.sixth
    join: Own.OwnedJoin = {
        result = Own.UnmanagedJoinParameter({
            id = ids.fourth,
            value_type = Concrete.IntegerType(Int64Format),
            span = span(20),
        }),
        carried = [],
        entering = entering,
        selection = {
            scrutinee = Own.UnmanagedArgument(ids.third),
            entry = Model.decision_node_id(0),
            nodes = [
                Own.EnterArm({ arm = Model.match_arm_id(0), operations = edge, transfers = [] }),
            ],
        },
        arms = [
            {
                id = Model.match_arm_id(0),
                inputs = [],
                operations = arm,
                exit = Own.Yield({ transfer = Own.UnmanagedReturn(yielded), carried = [] }),
            },
        ],
    }
    program_with(ids, {
        label = placeholder_label("worker"),
        parameters = [],
        return_type = Concrete.IntegerType(Int64Format),
        operations = prefix
            .append(Own.ExecuteJoin(join))
            .concat(after),
        result = Own.UnmanagedReturn(ids.fourth),
    })


-- An arm that stores `stored`, with its owner, as the one element of a new
-- List v5 (owner 2), measures it as v6 and drops the new List.
private pure func stored_in_list(
    ids: TransferIds,
    stored: Lower.ValueId,
    owner: Int,
) -> List[Own.OwnershipOperation]:
    nested: Concrete.TypeRef = Concrete.ListType(list_type())
    borrow: Own.OwnedArgument = Own.BorrowedArgument({
        value = ids.sixth,
        source = Own.OwnerBorrow(Own.owner_id(2)),
    })
    [
        Own.DefineValue({
            id = ids.sixth,
            value_type = nested,
            operation = Own.ConstructListDefinition([
                Own.OwnedPayload(stored, Own.owner_id(owner)),
            ]),
            result = Own.OwnedResult(Own.owner_id(2)),
            span = span(45),
        }),
        Own.DefineValue({
            id = ids.seventh,
            value_type = Concrete.IntegerType(Int64Format),
            operation = Own.CallDefinition(
                Concrete.RuntimeFunction(Builtins.ListLength(list_type())),
                [borrow],
            ),
            result = Own.UnmanagedResult,
            span = span(46),
        }),
        Own.DropOwner(Own.owner_id(2), span(47)),
    ]


private pure func join_rejects(fault: JoinFault, message: String, at: Int) -> Bool:
    match transfer_ids():
        Err(_):
            False
        Ok(ids):
            verify(join_program(ids, NoJoinFault))
                .is_ok()
                .and(rejects(join_program(ids, fault), message, at))


