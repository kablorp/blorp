-- Rewrites every join's arms in these operations and the blocks nested in them.
private pure func map_joins(
    operations: List[Own.OwnershipOperation],
    change: pure (Own.OwnedJoin) -> Own.OwnedJoin,
) -> List[Own.OwnershipOperation]:
    operations.map(pure func(operation):
        match operation:
            Own.ExecuteJoin(join):
                arms = join.arms.map(
                    pure func(arm): { arm | operations = map_joins(arm.operations, change) },
                )
                Own.ExecuteJoin(change({ join | arms = arms }))
            Own.ExecuteLoop(loop):
                Own.ExecuteLoop({ loop | body = map_loop_joins(loop.body, change) })
            _:
                operation
    )


private pure func map_loop_joins(
    block: Own.OwnedLoopBlock,
    change: pure (Own.OwnedJoin) -> Own.OwnedJoin,
) -> Own.OwnedLoopBlock:
    tail: Own.OwnedLoopTail = match block.tail:
        Own.ExitLoop(_):
            block.tail
        Own.MatchLoop(matched):
            Own.MatchLoop(
                { matched |
                    arms = matched.arms.map(
                        pure func(arm): { arm | body = map_loop_joins(arm.body, change) },
                    ),
                },
            )
    { operations = map_joins(block.operations, change), tail = tail }


-- A `break` arm discharges an entering owner once, at its edge, which moves
-- it into the loop's output. These faults drop it before the edge, at 77 and
-- then at each later position up to `last`.
private pure func drop_entering_until(join: Own.OwnedJoin, last: Int) -> Own.OwnedJoin:
    match join.entering:
        [owner, ..._]:
            { join |
                arms = join.arms.map(pure func(arm):
                    match arm.exit:
                        Own.TransferLoop(_, _):
                            var operations = arm.operations
                            var at = 77
                            while at <= last:
                                operations = operations.append(Own.DropOwner(owner, span(at)))
                                at = at + 1
                            { arm | operations = operations }
                        Own.Yield(_):
                            arm
                ),
            }
        []:
            join


-- The joins directly inside the arms of each function's match loop.
private pure func loop_arm_joins(functions: List[Own.OwnedFunction]) -> List[Own.OwnedJoin]:
    var joins: List[Own.OwnedJoin] = []
    for function in functions:
        for operation in function.operations:
            match operation:
                Own.ExecuteLoop(loop):
                    match loop.body.tail:
                        Own.MatchLoop(matched):
                            for arm in matched.arms:
                                for nested in arm.body.operations:
                                    match nested:
                                        Own.ExecuteJoin(join): joins = joins.append(join)
                                        _: void
                        Own.ExitLoop(_):
                            void
                _:
                    void
    joins


private BREAK_ARM_SOURCE: String =
    |pure func collect() -> List[Int]:
    |    var values: List[Int] = []
    |    while less_than(length(values), 12):
    |        if less_than(length(values), 3):
    |            values = append(values, 1)
    |        else:
    |            break
    |    values
    |func main() -> Int:
    |    unused = collect()
    |    0
    |


pure func test_abrupt_arm_cannot_discharge_an_entering_owner_twice() -> Bool:
    match owned_source(BREAK_ARM_SOURCE):
        Err(_):
            False
        Ok(program):
            changed = program.functions.map(
                pure func(function): { function |
                    operations = map_joins(
                        function.operations,
                        pure func(join): drop_entering_until(join, 78),
                    ),
                },
            )
            match loop_arm_joins(changed).map(pure func(join) -> List[Own.OwnerId]: join.entering):
                [[owner]]:
                    verify(program)
                        .is_ok()
                        .and(
                            rejects(
                                { program | functions = changed },
                                "owner ${Own.owner_number(owner).to_string()} has already been discharged",
                                78,
                            ),
                        )
                _:
                    False


-- Loop edges consume an owner made in their own block, by the same rule as a
-- yield. Accepted form: v0 and v1 own fresh Lists (owners 0 and 1); the
-- header (v4, owner 2) takes owner 0; the body makes v5 (owner 3), retires
-- the old header and moves owner 3 into the header on its back edge.
private union EdgeFault:
    EdgeMovesBodyOwner
    EdgeMovesHeaderOwner
    EdgeMovesPreLoopOwner
    EdgeMovesDroppedOwner


private pure func edge_program(ids: TransferIds, fault: EdgeFault) -> Own.OwnershipProgram:
    var body: List[Own.OwnershipOperation] = [
        empty_list(ids.sixth, 3, 45),
        Own.DropOwner(Own.owner_id(2), span(46)),
    ]
    var outgoing = Own.OwnedReturn(ids.sixth, Own.owner_id(3))
    match fault:
        EdgeMovesBodyOwner:
            void
        EdgeMovesHeaderOwner:
            body = [empty_list(ids.sixth, 3, 45), Own.DropOwner(Own.owner_id(3), span(46))]
            outgoing = Own.OwnedReturn(ids.fifth, Own.owner_id(2))
        EdgeMovesPreLoopOwner:
            body = [
                empty_list(ids.sixth, 3, 45),
                Own.DropOwner(Own.owner_id(2), span(46)),
                Own.DropOwner(Own.owner_id(3), span(47)),
            ]
            outgoing = Own.OwnedReturn(ids.second, Own.owner_id(1))
        EdgeMovesDroppedOwner:
            body = body.append(Own.DropOwner(Own.owner_id(3), span(47)))
    loop: Own.OwnedLoop = {
        entry_acquisitions = [],
        headers = [header(ids.fifth, 2, Own.OwnedReturn(ids.first, Own.owner_id(0)), 40)],
        result = Own.UnmanagedJoinParameter({
            id = ids.third,
            value_type = Concrete.IntegerType(Int64Format),
            span = span(30),
        }),
        carried = [],
        body = { operations = body, tail = Own.ExitLoop(Own.Recur([outgoing], span(50))) },
    }
    program_with(ids, {
        label = placeholder_label("worker"),
        parameters = [],
        return_type = Concrete.IntegerType(Int64Format),
        operations = [
            empty_list(ids.first, 0, 10),
            empty_list(ids.second, 1, 11),
            Own.ExecuteLoop(loop),
            integer(ids.fourth, 0, 60),
            Own.DropOwner(Own.owner_id(1), span(61)),
        ],
        result = Own.UnmanagedReturn(ids.fourth),
    })


private pure func edge_rejects(fault: EdgeFault, message: String, at: Int) -> Bool:
    match transfer_ids():
        Err(_):
            False
        Ok(ids):
            verify(edge_program(ids, EdgeMovesBodyOwner))
                .is_ok()
                .and(rejects(edge_program(ids, fault), message, at))


pure func test_a_back_edge_moves_an_owner_its_body_made() -> Bool:
    match transfer_ids():
        Err(_):
            False
        Ok(ids):
            verify(edge_program(ids, EdgeMovesBodyOwner))
                .is_ok()
                .and(verify(edge_program(ids, EdgeMovesHeaderOwner)).is_ok())


pure func test_a_back_edge_cannot_move_an_owner_made_before_the_loop() -> Bool:
    edge_rejects(
        EdgeMovesPreLoopOwner,
        "yield must transfer an owner made in its arm, not owner 1",
        50,
    )


pure func test_a_back_edge_cannot_move_a_dropped_owner() -> Bool:
    edge_rejects(EdgeMovesDroppedOwner, "yield refers to discharged owner 3", 50)


-- A loop exit may move a loop-local owner only of its own loop. The outer
-- loop's body makes v5 (owner 3); an inner loop with result v6 acquires owner
-- 4 from it for its header (v7, owner 5). The accepted inner loop drops its header and
-- breaks; the faulty one moves the outer body's owner 3 on its back edge.
private pure func nested_program(ids: TransferIds, inner_moves_outer: Bool) -> Own.OwnershipProgram:
    inner_body: Own.OwnedLoopBlock = if inner_moves_outer:
        {
            operations = [Own.DropOwner(Own.owner_id(5), span(55))],
            tail = Own.ExitLoop(Own.Recur([Own.OwnedReturn(ids.sixth, Own.owner_id(3))], span(56))),
        }
    else:
        {
            operations = [integer(ids.ninth, 0, 54), Own.DropOwner(Own.owner_id(5), span(55))],
            tail = Own.ExitLoop(
                Own.Break({
                    value = Own.UnmanagedReturn(ids.ninth),
                    carried = [],
                    span = span(56),
                }),
            ),
        }
    inner: Own.OwnedLoop = {
        entry_acquisitions = [
            {
                owner = Own.owner_id(4),
                borrow = { value = ids.sixth, source = Own.OwnerBorrow(Own.owner_id(3)) },
            },
        ],
        headers = [header(ids.eighth, 5, Own.OwnedReturn(ids.sixth, Own.owner_id(4)), 52)],
        result = Own.UnmanagedJoinParameter({
            id = ids.seventh,
            value_type = Concrete.IntegerType(Int64Format),
            span = span(53),
        }),
        carried = [],
        body = inner_body,
    }
    outer: Own.OwnedLoop = {
        entry_acquisitions = [],
        headers = [header(ids.fifth, 2, Own.OwnedReturn(ids.first, Own.owner_id(0)), 40)],
        result = Own.UnmanagedJoinParameter({
            id = ids.third,
            value_type = Concrete.IntegerType(Int64Format),
            span = span(30),
        }),
        carried = [],
        body = {
            operations = [
                empty_list(ids.sixth, 3, 45),
                Own.DropOwner(Own.owner_id(2), span(46)),
                Own.ExecuteLoop(inner),
            ],
            tail = Own.ExitLoop(Own.Recur([Own.OwnedReturn(ids.sixth, Own.owner_id(3))], span(50))),
        },
    }
    program_with(ids, {
        label = placeholder_label("worker"),
        parameters = [],
        return_type = Concrete.IntegerType(Int64Format),
        operations = [
            empty_list(ids.first, 0, 10),
            empty_list(ids.second, 1, 11),
            Own.ExecuteLoop(outer),
            integer(ids.fourth, 0, 60),
            Own.DropOwner(Own.owner_id(1), span(61)),
        ],
        result = Own.UnmanagedReturn(ids.fourth),
    })


pure func test_an_inner_loop_cannot_move_an_outer_loop_owner() -> Bool:
    match transfer_ids():
        Err(_):
            False
        Ok(ids):
            verify(nested_program(ids, False))
                .is_ok()
                .and(
                    rejects(
                        nested_program(ids, True),
                        "yield must transfer an owner made in its arm, not owner 3",
                        56,
                    ),
                )


-- A list literal stores v0's own owner 0, moved rather than acquired; the
-- faulty form also drops owner 0 after the store.
private pure func stored_program(ids: TransferIds, drops_stored: Bool) -> Own.OwnershipProgram:
    stored: Own.OwnershipOperation = Own.DefineValue({
        id = ids.second,
        value_type = Concrete.ListType(list_type()),
        operation = Own.ConstructListDefinition([Own.OwnedPayload(ids.first, Own.owner_id(0))]),
        result = Own.OwnedResult(Own.owner_id(1)),
        span = span(11),
    })
    var operations = [
        empty_list(ids.first, 0, 10),
        stored,
        integer(ids.third, 0, 20),
        Own.DropOwner(Own.owner_id(1), span(21)),
    ]
    if drops_stored:
        operations = operations.append(Own.DropOwner(Own.owner_id(0), span(22)))
    program_with(ids, {
        label = placeholder_label("worker"),
        parameters = [],
        return_type = Concrete.IntegerType(Int64Format),
        operations = operations,
        result = Own.UnmanagedReturn(ids.third),
    })


pure func test_a_moved_store_cannot_also_be_dropped() -> Bool:
    match transfer_ids():
        Err(_):
            False
        Ok(ids):
            verify(stored_program(ids, False))
                .is_ok()
                .and(rejects(stored_program(ids, True), "owner 0 has already been discharged", 22))


-- The same `break` moves the header, an owner of the loop body's prefix, out
-- through its edge; dropping it first leaves the edge moving a discharged owner.
pure func test_a_break_cannot_move_an_enclosing_owner_it_dropped() -> Bool:
    match owned_source(BREAK_ARM_SOURCE):
        Err(_):
            False
        Ok(program):
            changed = program.functions.map(
                pure func(function): { function |
                    operations = map_joins(
                        function.operations,
                        pure func(join): drop_entering_until(join, 77),
                    ),
                },
            )
            var breaks: List[Span] = []
            for join in loop_arm_joins(changed):
                for arm in join.arms:
                    match arm.exit:
                        Own.TransferLoop(_, Own.ExitLoop(Own.Break(outputs))):
                            breaks = breaks.append(outputs.span)
                        _:
                            void
            match (
                loop_arm_joins(changed).map(pure func(join) -> List[Own.OwnerId]: join.entering),
                breaks,
                verify({ program | functions = changed }),
            ):
                ([[owner]], [at], Err(error)):
                    verify(program)
                        .is_ok()
                        .and(
                            error.message.equals(
                                "ownership verification failed: yield refers to discharged owner ${Own.owner_number(owner).to_string()}",
                            ),
                        )
                        .and(error.span.source == at.source)
                        .and(error.span.start.equals(at.start))
                        .and(error.span.end.equals(at.end))
                _:
                    False


tests: TestSuite = {
    description = "Loop entry and join ownership transfer verification",
    tests = [
        (
            "a header takes a dying owner without an entry acquisition",
            test_header_takes_a_dying_owner,
        ),
        (
            "an acquired owner transfers by membership, not origin",
            test_acquired_owner_transfers_by_membership_not_origin,
        ),
        (
            "a taken owner cannot be dropped after the loop",
            test_taken_owner_cannot_drop_after_the_loop,
        ),
        (
            "a taken owner cannot be read after the loop",
            test_taken_owner_cannot_be_read_after_the_loop,
        ),
        (
            "a taken owner cannot be dropped in the loop body",
            test_taken_owner_cannot_drop_in_the_body,
        ),
        (
            "a taken owner cannot be read in the loop body",
            test_taken_owner_cannot_be_read_in_the_body,
        ),
        ("a taken owner must own its header initial", test_taken_owner_must_own_its_initial),
        ("two headers cannot take one owner", test_two_headers_cannot_take_one_owner),
        (
            "an entry acquisition cannot borrow a taken owner",
            test_entry_acquisition_cannot_borrow_a_taken_owner,
        ),
        (
            "a loop in a yielding arm takes an entering owner",
            test_loop_in_a_yielding_arm_takes_an_entering_owner,
        ),
        (
            "a loop in a yielding arm cannot take a non-entering owner",
            test_loop_in_a_yielding_arm_cannot_take_a_non_entering_owner,
        ),
        ("a join takes an entering owner its arm discharges", test_join_takes_an_entering_owner),
        ("a join arm may store an entering owner", test_arm_may_store_an_entering_owner),
        (
            "a join arm cannot store a non-entering owner",
            test_arm_cannot_store_a_non_entering_owner,
        ),
        (
            "an entering owner must be live at the join",
            test_entering_owner_must_be_live_at_the_join,
        ),
        ("an entering owner cannot repeat", test_entering_owner_cannot_repeat),
        ("an entering owner must be defined", test_entering_owner_must_be_defined),
        (
            "an entering owner cannot be dropped after the join",
            test_entering_owner_cannot_drop_after_the_join,
        ),
        (
            "an entering owner cannot be read after the join",
            test_entering_owner_cannot_be_read_after_the_join,
        ),
        (
            "a join arm cannot leave an entering owner live",
            test_arm_cannot_leave_an_entering_owner_live,
        ),
        (
            "a join arm cannot discharge a non-entering owner",
            test_arm_cannot_discharge_a_non_entering_owner,
        ),
        (
            "a selection edge cannot discharge an entering owner",
            test_selection_edge_cannot_discharge_an_entering_owner,
        ),
        (
            "an abrupt arm cannot discharge an entering owner twice",
            test_abrupt_arm_cannot_discharge_an_entering_owner_twice,
        ),
        ("a back edge moves an owner its body made", test_a_back_edge_moves_an_owner_its_body_made),
        (
            "a back edge cannot move an owner made before the loop",
            test_a_back_edge_cannot_move_an_owner_made_before_the_loop,
        ),
        (
            "an inner loop cannot move an outer loop's owner",
            test_an_inner_loop_cannot_move_an_outer_loop_owner,
        ),
        ("a back edge cannot move a dropped owner", test_a_back_edge_cannot_move_a_dropped_owner),
        ("a moved store cannot also be dropped", test_a_moved_store_cannot_also_be_dropped),
        (
            "a break cannot move an enclosing owner it dropped",
            test_a_break_cannot_move_an_enclosing_owner_it_dropped,
        ),
    ],
}
