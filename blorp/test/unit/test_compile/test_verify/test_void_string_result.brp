import:
    test: TestSuite
    ../../../../src/compile/own/own: own
    ../../../../src/compile/verify/verify: verify
    ../../module_input: test_base
    ../../void_string_result_inputs: lowered_result


pure func test_mixed_result_is_verified_without_a_builtin() -> Bool:
    lowered_result(test_base())
        .and_then(own)
        .and_then(verify)
        .is_ok()


TESTS: TestSuite = {
    description = "Blorp ordinary Void/String Result verification",
    tests = [
        (
            "ordinary mixed Result has complete ownership and payload proofs",
            test_mixed_result_is_verified_without_a_builtin,
        ),
    ],
}
