import:
    io/environment: read_file
    option: to_result
    result: get_or
    test: TestSuite
    ../../../../src/compile/check/model as model
    ../../../../src/compile/emit/emit: emit
    ../../../../src/compile/lower/lower as lower
    ../../../../src/compile/namespace/builtins as builtins:
        RuntimeOperation(IntegerToString),
        IntegerFormat(Int64Format),
    ../../../../src/compile/own/own as owned
    ../../../../src/compile/runtime/memory: MEMORY_RUNTIME
    ../../../../src/compile/runtime/string: string_runtime
    ../../../../src/compile/specialize/specialize as specialized
    ../../../../src/compile/verify/verify: verify
    ../../../../src/syntax/syntax:
        Diagnostic,
        Entrypoint(NoArguments),
        EntryResult(IntegerExitStatus),
        entry_function,
    ../../../../src/utils/text: concat
    ../../managed_union_inputs: lowered, lowered_modules, lowered_tail_join
    ../../module_input: INTEGER_OPERATIONS, STRING_OPERATIONS
    ../../ownership_inputs: borrowed_rows
    ../../ownership_inputs: InputIds, input_ids, span
    ../test_verify/selection_inputs as selection_inputs


private BOX_SEED: String =
    |union Box[T]:
    |    Box(T)
    |pure func inspect(value: Box[Int]) -> Int:
    |    match value:
    |        Box(item): item
    |func main() -> Int:
    |    unused = inspect(Box(0))
    |    0
    |


private CHOICE_SEED: String =
    |union Choice[T]:
    |    Left(T)
    |    Right(T)
    |pure func inspect(value: Choice[Int]) -> Int:
    |    match value:
    |        Left(item): item
    |        Right(item): item
    |func main() -> Int:
    |    unused = inspect(Left(0))
    |    0
    |


private MIXED_SEED: String =
    |union Mixed[T]:
    |    Text(T)
    |    Empty
    |    Number(Int)
    |pure func inspect(value: Mixed[Int]) -> Int:
    |    match value:
    |        Text(item): item
    |        Empty: 0
    |        Number(item): item
    |func main() -> Int:
    |    unused = inspect(Text(0))
    |    0
    |


private NESTED_SEED: String =
    |union Box[T]:
    |    Box(T)
    |pure func inner(value: Box[Int]) -> Int:
    |    match value:
    |        Box(item): item
    |pure func outer(value: Box[Box[Int]]) -> Box[Int]:
    |    match value:
    |        Box(item): item
    |func main() -> Int:
    |    unused = inner(Box(0))
    |    nested = outer(Box(Box(0)))
    |    0
    |


-- These are independent complete C oracles. No emitter naming or storage
-- helper builds expected text. Only the separately tested runtime prefix is
-- reused; equality includes every declaration, helper, function and entrypoint.
private MAIN_DECL: String = "int64_t blorp_f_0(void);"


private pure func expected_main_body() -> String:
    "int64_t blorp_f_0(void){const int64_t "
        .concat("blorp_vl_0=INT64_C(0);(void)blorp_vl_0;return ")
        .concat("blorp_vl_0;}\n")


-- Every catalogue below except the unmanaged one has Strings.
private ENTRYPOINT: String = "static int blorp_program_finish(int status){return blorp_memory_finish(blorp_string_literals_finish(status));}\nint main(void){blorp_memory_start();return blorp_program_finish((int)blorp_f_0());}\n"


private PLAIN_ENTRYPOINT: String = "static int blorp_program_finish(int status){return blorp_memory_finish(status);}\nint main(void){blorp_memory_start();return blorp_program_finish((int)blorp_f_0());}\n"


private pure func expected_box_c() -> String:
    "enum blorp_tag_0{blorp_v_0_0};struct blorp_u_0{enum "
        .concat("blorp_tag_0 tag;union{struct{struct blorp_string* blorp_uf_0;} blorp_up_0;}")
        .concat("payload;};")
        .concat(
            "void blorp_union_dup_0(struct blorp_u_0 value){"
                .concat("switch(value.tag){case blorp_v_0_0:")
                .concat("blorp_string_retain(value.payload.blorp_up_0.blorp_uf_0);break;}}"),
        )
        .concat(
            "void blorp_union_drop_0(struct blorp_u_0 value){"
                .concat("switch(value.tag){case blorp_v_0_0:blorp_string_release(")
                .concat("value.payload.blorp_up_0.blorp_uf_0);break;}}"),
        )


private pure func expected_choice_c() -> String:
    "enum blorp_tag_0{blorp_v_0_0,blorp_v_0_1};struct "
        .concat("blorp_u_0{enum blorp_tag_0 tag;union{struct{struct ")
        .concat("blorp_string* blorp_uf_0;} blorp_up_0;struct{struct blorp_string* ")
        .concat("blorp_uf_0;} blorp_up_1;}payload;};")
        .concat(
            "void blorp_union_dup_0(struct blorp_u_0 value){"
                .concat("switch(value.tag){case blorp_v_0_0:")
                .concat("blorp_string_retain(value.payload.blorp_up_0.blorp_uf_0);break;")
                .concat("case blorp_v_0_1:")
                .concat("blorp_string_retain(value.payload.blorp_up_1.blorp_uf_0);break;}}"),
        )
        .concat(
            "void blorp_union_drop_0(struct blorp_u_0 value){"
                .concat("switch(value.tag){case blorp_v_0_0:blorp_string_release(")
                .concat("value.payload.blorp_up_0.blorp_uf_0);break;case ")
                .concat("blorp_v_0_1:")
                .concat("blorp_string_release(value.payload.blorp_up_1.blorp_uf_0);break;}}"),
        )


private pure func expected_mixed_c() -> String:
    "enum blorp_tag_0{blorp_v_0_0,blorp_v_0_1,blorp_v_0_2};"
        .concat("struct blorp_u_0{enum blorp_tag_0 tag;union{struct{struct ")
        .concat(
            "blorp_string* blorp_uf_0;} blorp_up_0;struct{int64_t blorp_uf_0;} blorp_up_2;}payload;};",
        )
        .concat(
            "void blorp_union_dup_0(struct blorp_u_0 value){"
                .concat("switch(value.tag){case blorp_v_0_0:")
                .concat("blorp_string_retain(value.payload.blorp_up_0.blorp_uf_0);break;")
                .concat("case blorp_v_0_1:break;")
                .concat("case blorp_v_0_2:break;}}"),
        )
        .concat(
            "void blorp_union_drop_0(struct blorp_u_0 value){"
                .concat("switch(value.tag){case blorp_v_0_0:blorp_string_release(")
                .concat("value.payload.blorp_up_0.blorp_uf_0);break;case blorp_v_0_1:break;")
                .concat("case blorp_v_0_2:break;}}"),
        )


private pure func expected_outer_c() -> String:
    "enum blorp_tag_1{blorp_v_1_0};struct blorp_u_1{enum "
        .concat("blorp_tag_1 tag;union{struct{struct blorp_u_0 blorp_uf_0;} blorp_up_0;}")
        .concat("payload;};")
        .concat(
            "void blorp_union_dup_1(struct blorp_u_1 value){"
                .concat("switch(value.tag){case blorp_v_1_0:")
                .concat("blorp_union_dup_0(value.payload.blorp_up_0.blorp_uf_0);break;}}"),
        )
        .concat(
            "void blorp_union_drop_1(struct blorp_u_1 value){"
                .concat("switch(value.tag){case blorp_v_1_0:")
                .concat("blorp_union_drop_0(value.payload.blorp_up_0.blorp_uf_0);break;}}"),
        )


private record EmitIds {
    values: InputIds,
    owner: specialized.UnionInstanceId,
    variants: List[specialized.VariantInstanceId],
}


private pure func seed_error() -> Diagnostic:
    {
        span = span(0),
        note = None,
        message = "missing managed union emission identity seed",
        help = "fix the emission test seed",
    }


private pure func seed_variant(
    selection: lower.LoweredSelection,
    arm: lower.JoinArm,
) -> Result[specialized.VariantInstanceId, Diagnostic]:
    var found: Option[specialized.VariantInstanceId] = None
    for node in selection.nodes:
        match node:
            lower.EnterArm(edge):
                if model.match_arm_number(edge.arm) == model.match_arm_number(arm.id):
                    match edge.definitions:
                        [lower.BorrowUnionField(_, field, _)]:
                            found = Some(specialized.variant_field_variant(field))
                        _:
                            void
            lower.TestVariant(_, variant, yes, _):
                match selection.nodes.get(model.decision_node_number(yes)):
                    Some(lower.EnterArm(edge)):
                        if model.match_arm_number(edge.arm) == model.match_arm_number(arm.id):
                            found = Some(variant)
                    _:
                        void
            lower.TestListLength(_, _, _, _) | lower.TestLiteral(_, _, _, _):
                void
    match found:
        Some(variant): Ok(variant)
        None: Err(seed_error())


-- Lowering mints opaque identities only. Every tested layout and ownership
-- operation below is supplied directly; own() never supplies an expected fact.
private pure func seed(source: String, function_index: Int) -> Result[EmitIds, Diagnostic]:
    ids ?= input_ids()
    input ?= lowered(source)
    function ?= lower.lowered_functions(input).functions
        .get(function_index + 1)
        .to_result(seed_error())
    match lowered_tail_join(function):
        Some(matched):
            var variants: List[specialized.VariantInstanceId] = []
            var failure: Option[Diagnostic] = None
            for arm in matched.arms:
                match seed_variant(matched.selection, arm):
                    Ok(variant):
                        variants = variants.append(variant)
                    Err(error):
                        failure = Some(error)
                        break
            match failure:
                Some(error):
                    Err(error)
                None:
                    match variants.get(0):
                        Some(first):
                            Ok({
                                values = ids,
                                owner = specialized.variant_owner(first),
                                variants = variants,
                            })
                        None:
                            Err(seed_error())
        _:
            Err(seed_error())


private pure func boxed_layout() -> specialized.ConcreteUnion:
    specialized.OwningCases([[specialized.StringType]])


private pure func mixed_layout() -> specialized.ConcreteUnion:
    specialized.OwningCases([[specialized.StringType], [], [specialized.IntegerType(Int64Format)]])


private pure func definition(
    id: lower.ValueId,
    value_type: specialized.TypeRef,
    operation: owned.OwnedValueOperation,
    result: owned.ResultOwnership,
) -> owned.OwnershipOperation:
    owned.DefineValue({
        id = id,
        value_type = value_type,
        operation = operation,
        result = result,
        span = span(10),
    })


private pure func integer(id: lower.ValueId, number: Int) -> owned.OwnershipOperation:
    definition(
        id,
        specialized.IntegerType(Int64Format),
        owned.IntegerDefinition(number),
        owned.UnmanagedResult,
    )


private pure func parameter(
    id: lower.ValueId,
    value_type: specialized.TypeRef,
) -> owned.OwnershipOperation:
    definition(
        id,
        value_type,
        owned.ParameterDefinition(0),
        owned.BorrowedResult(owned.ParameterBorrow(id)),
    )


private pure func acquire(
    owner: Int,
    id: lower.ValueId,
    source: owned.BorrowSource,
) -> owned.OwnershipOperation:
    owned.AcquireOwner(owned.owner_id(owner), { value = id, source = source }, span(20))


private pure func string(id: lower.ValueId, argument: lower.ValueId) -> owned.OwnershipOperation:
    definition(
        id,
        specialized.StringType,
        owned.CallDefinition(specialized.RuntimeFunction(builtins.IntegerToString(Int64Format)), [
            owned.UnmanagedArgument(argument),
        ]),
        owned.OwnedResult(owned.owner_id(0)),
    )


-- `layouts` are the unions of the program the function joins.
private pure func function(
    parameters: List[specialized.TypeRef],
    return_type: specialized.TypeRef,
    operations: List[owned.OwnershipOperation],
    result: owned.ReturnTransfer,
    layouts: List[specialized.ConcreteUnion],
) -> owned.OwnedFunction:
    {
        parameters = borrowed_rows(parameters, layouts, []),
        return_type = return_type,
        operations = operations,
        result = result,
    }


private pure func main_function(ids: InputIds) -> owned.OwnedFunction:
    function(
        [],
        specialized.IntegerType(Int64Format),
        [integer(ids.first, 0)],
        owned.UnmanagedReturn(ids.first),
        [],
    )


private pure func returned(id: lower.ValueId, owner: Int) -> owned.ReturnTransfer:
    owned.OwnedReturn(id, owned.owner_id(owner))


private pure func exact(
    ids: InputIds,
    layouts: List[specialized.ConcreteUnion],
    functions: List[owned.OwnedFunction],
    prefix: String,
    expected: String,
) -> Bool:
    input: owned.OwnershipProgram = {
        records = [],
        unions = layouts,
        functions = functions,
        entrypoint = NoArguments(ids.entrypoint, IntegerExitStatus),
    }
    (
        verify(input)
            .and_then(emit)
            .get_or("")
        == MEMORY_RUNTIME + prefix.concat(expected)
    )


private pure func unused_catalog(
    layouts: List[specialized.ConcreteUnion],
    expected: String,
) -> Bool:
    match input_ids():
        Err(_):
            False
        Ok(ids):
            exact(
                ids,
                layouts,
                [main_function(ids)],
                string_runtime(),
                expected
                    .concat(MAIN_DECL)
                    .concat(expected_main_body())
                    .concat(ENTRYPOINT),
            )


pure func test_string_layout_and_helpers_include_the_runtime_for_an_unused_catalog() -> Bool:
    unused_catalog([boxed_layout()], expected_box_c())


private pure func typed_alias_case() -> Result[Bool, Diagnostic]:
    seed ?= seed(BOX_SEED, 0)
    ids = seed.values
    value_type = specialized.UnionType(seed.owner)
    helper = function(
        [value_type],
        specialized.IntegerType(Int64Format),
        [
            parameter(ids.first, value_type),
            acquire(0, ids.first, owned.ParameterBorrow(ids.first)),
            owned.DropOwner(owned.owner_id(0), span(30)),
            integer(ids.second, 0),
        ],
        owned.UnmanagedReturn(ids.second),
        [boxed_layout()],
    )
    expected = expected_box_c()
        .concat(MAIN_DECL)
        .concat("int64_t blorp_f_1(struct blorp_u_0 blorp_p_0);")
        .concat(expected_main_body())
        .concat(
            "int64_t blorp_f_1(struct blorp_u_0 blorp_p_0){const ".concat(
                "struct blorp_u_0 blorp_vl_0=blorp_p_0;(void)blorp_vl_0;",
            ),
        )
        .concat(
            "blorp_union_dup_0(blorp_vl_0);const struct blorp_u_0 "
                .concat("blorp_owner_0=blorp_vl_0;(void)blorp_owner_0;")
                .concat("blorp_union_drop_0(blorp_owner_0);"),
        )
        .concat(
            "const int64_t blorp_vl_1=INT64_C(0);(void)blorp_vl_1;".concat("return blorp_vl_1;}\n"),
        )
        .concat(ENTRYPOINT)
    Ok(exact(ids, [boxed_layout()], [main_function(ids), helper], string_runtime(), expected))


pure func test_union_acquire_and_drop_use_a_struct_owner_alias() -> Bool:
    typed_alias_case().get_or(False)


private pure func final_child_case() -> Result[Bool, Diagnostic]:
    seed ?= seed(BOX_SEED, 0)
    boxed ?= seed.variants
        .get(0)
        .to_result(seed_error())
    ids = seed.values
    value_type = specialized.UnionType(seed.owner)
    helper = function(
        [],
        value_type,
        [
            integer(ids.first, 7),
            string(ids.second, ids.first),
            definition(
                ids.third,
                value_type,
                owned.ConstructDefinition(boxed, [
                    owned.OwnedPayload(ids.second, owned.owner_id(0)),
                ]),
                owned.OwnedResult(owned.owner_id(1)),
            ),
        ],
        returned(ids.third, 1),
        [boxed_layout()],
    )
    expected = expected_box_c()
        .concat(MAIN_DECL)
        .concat("struct blorp_u_0 blorp_f_1(void);")
        .concat(expected_main_body())
        .concat(
            "struct blorp_u_0 blorp_f_1(void){const int64_t ".concat(
                "blorp_vl_0=INT64_C(7);(void)blorp_vl_0;",
            ),
        )
        .concat(
            "struct blorp_string* const "
                .concat("blorp_vl_1=blorp_int_to_string(blorp_vl_0);")
                .concat("(void)blorp_vl_1;struct blorp_string* const ")
                .concat("blorp_owner_0=blorp_vl_1;(void)blorp_owner_0;"),
        )
        .concat(
            "const struct blorp_u_0 blorp_vl_2=((struct blorp_u_0){"
                .concat(".tag=blorp_v_0_0,.payload.blorp_up_0={.blorp_uf_0=blorp_owner_0}});")
                .concat("(void)blorp_vl_2;"),
        )
        .concat(
            "const struct blorp_u_0 blorp_owner_1=blorp_vl_2;".concat(
                "(void)blorp_owner_1;return blorp_owner_1;}\n",
            ),
        )
        .concat(ENTRYPOINT)
    Ok(exact(ids, [boxed_layout()], [main_function(ids), helper], string_runtime(), expected))


pure func test_final_owned_child_constructs_from_its_owner_without_extra_arc_work() -> Bool:
    final_child_case().get_or(False)


private pure func borrowed_child_case() -> Result[Bool, Diagnostic]:
    seed ?= seed(BOX_SEED, 0)
    boxed ?= seed.variants
        .get(0)
        .to_result(seed_error())
    ids = seed.values
    value_type = specialized.UnionType(seed.owner)
    helper = function(
        [specialized.StringType],
        value_type,
        [
            parameter(ids.first, specialized.StringType),
            acquire(0, ids.first, owned.ParameterBorrow(ids.first)),
            definition(
                ids.second,
                value_type,
                owned.ConstructDefinition(boxed, [
                    owned.OwnedPayload(ids.first, owned.owner_id(0)),
                ]),
                owned.OwnedResult(owned.owner_id(1)),
            ),
        ],
        returned(ids.second, 1),
        [boxed_layout()],
    )
    expected = expected_box_c()
        .concat(MAIN_DECL)
        .concat("struct blorp_u_0 blorp_f_1(struct blorp_string* ".concat("blorp_p_0);"))
        .concat(expected_main_body())
        .concat(
            "struct blorp_u_0 blorp_f_1(struct blorp_string* "
                .concat("blorp_p_0){struct blorp_string* const ")
                .concat("blorp_vl_0=blorp_p_0;(void)blorp_vl_0;"),
        )
        .concat(
            "blorp_string_retain(blorp_vl_0);struct blorp_string* ".concat(
                "const blorp_owner_0=blorp_vl_0;(void)blorp_owner_0;",
            ),
        )
        .concat(
            "const struct blorp_u_0 blorp_vl_1=((struct blorp_u_0){"
                .concat(".tag=blorp_v_0_0,.payload.blorp_up_0={.blorp_uf_0=blorp_owner_0}});")
                .concat("(void)blorp_vl_1;"),
        )
        .concat(
            "const struct blorp_u_0 blorp_owner_1=blorp_vl_1;".concat(
                "(void)blorp_owner_1;return blorp_owner_1;}\n",
            ),
        )
        .concat(ENTRYPOINT)
    Ok(exact(ids, [boxed_layout()], [main_function(ids), helper], string_runtime(), expected))


pure func test_borrowed_string_parameter_is_acquired_before_constructor_transfer() -> Bool:
    borrowed_child_case().get_or(False)


private pure func projected_child_case() -> Result[Bool, Diagnostic]:
    seed ?= seed(BOX_SEED, 0)
    boxed ?= seed.variants
        .get(0)
        .to_result(seed_error())
    field ?= specialized.variant_field(boxed, 0, [boxed_layout()], span(0))
    ids = seed.values
    selection = selection_inputs.direct(
        owned.BorrowedArgument({ value = ids.first, source = owned.ParameterBorrow(ids.first) }),
    )
    helper = function(
        [specialized.UnionType(seed.owner)],
        specialized.StringType,
        [parameter(ids.first, specialized.UnionType(seed.owner))].append(
            owned.ExecuteJoin({
                result = owned.ManagedJoinParameter(
                    { id = ids.second, value_type = specialized.StringType, span = span(30) },
                    owned.owner_id(0),
                ),
                carried = [],
                entering = [],
                selection = { selection |
                    nodes = [
                        owned.EnterArm({
                            arm = model.match_arm_id(0),
                            operations = [
                                definition(
                                    ids.third,
                                    specialized.StringType,
                                    owned.PayloadDefinition(field, ids.first),
                                    owned.BorrowedResult(owned.PayloadBorrow(ids.first)),
                                ),
                                acquire(1, ids.third, owned.PayloadBorrow(ids.first)),
                            ],
                            transfers = [returned(ids.third, 1)],
                        }),
                    ],
                },
                arms = [
                    {
                        id = model.match_arm_id(0),
                        inputs = [
                            owned.ManagedJoinParameter(
                                {
                                    id = ids.fourth,
                                    value_type = specialized.StringType,
                                    span = span(30),
                                },
                                owned.owner_id(2),
                            ),
                        ],
                        operations = [],
                        exit = owned.Yield({ transfer = returned(ids.fourth, 2), carried = [] }),
                    },
                ],
            }),
        ),
        returned(ids.second, 0),
        [boxed_layout()],
    )
    expected = expected_box_c()
        .concat(MAIN_DECL)
        .concat("struct blorp_string* blorp_f_1(struct blorp_u_0 blorp_p_0);")
        .concat(expected_main_body())
        .concat("struct blorp_string* blorp_f_1(struct blorp_u_0 blorp_p_0){")
        .concat("const struct blorp_u_0 blorp_vl_0=blorp_p_0;(void)blorp_vl_0;")
        .concat("struct blorp_string* blorp_vl_1;struct blorp_string* blorp_vl_3;")
        .concat("goto blorp_selection_1_node_0;blorp_selection_1_node_0:{")
        .concat(
            "struct blorp_string* const blorp_vl_2=blorp_vl_0.payload.blorp_up_0.blorp_uf_0;(void)blorp_vl_2;",
        )
        .concat(
            "blorp_string_retain(blorp_vl_2);struct blorp_string* const blorp_owner_1=blorp_vl_2;(void)blorp_owner_1;",
        )
        .concat("blorp_vl_3=blorp_owner_1;goto blorp_selection_1_arm_0;}")
        .concat(
            "blorp_selection_1_arm_0:{(void)blorp_vl_3;struct blorp_string* const blorp_owner_2=blorp_vl_3;(void)blorp_owner_2;",
        )
        .concat("blorp_vl_1=blorp_owner_2;goto blorp_selection_1_done;}")
        .concat(
            "blorp_selection_1_done:;(void)blorp_vl_1;struct blorp_string* const blorp_owner_0=blorp_vl_1;(void)blorp_owner_0;return blorp_owner_0;}\n",
        )
        .concat(ENTRYPOINT)
    Ok(exact(ids, [boxed_layout()], [main_function(ids), helper], string_runtime(), expected))


pure func test_selected_payload_is_acquired_inside_its_arm_before_owned_return() -> Bool:
    projected_child_case().get_or(False)


pure func test_two_managed_variants_touch_only_their_matching_payload_slot() -> Bool:
    unused_catalog(
        [specialized.OwningCases([[specialized.StringType], [specialized.StringType]])],
        expected_choice_c(),
    )


private pure func nullary_case() -> Result[Bool, Diagnostic]:
    seed ?= seed(MIXED_SEED, 0)
    empty ?= seed.variants
        .get(1)
        .to_result(seed_error())
    ids = seed.values
    value_type = specialized.UnionType(seed.owner)
    helper = function(
        [],
        value_type,
        [
            definition(
                ids.first,
                value_type,
                owned.ConstructDefinition(empty, []),
                owned.OwnedResult(owned.owner_id(0)),
            ),
        ],
        returned(ids.first, 0),
        [mixed_layout()],
    )
    expected = expected_mixed_c()
        .concat(MAIN_DECL)
        .concat("struct blorp_u_0 blorp_f_1(void);")
        .concat(expected_main_body())
        .concat(
            "struct blorp_u_0 blorp_f_1(void){const struct blorp_u_0 "
                .concat("blorp_vl_0=((struct blorp_u_0){.tag=blorp_v_0_1});")
                .concat("(void)blorp_vl_0;"),
        )
        .concat(
            "const struct blorp_u_0 blorp_owner_0=blorp_vl_0;".concat(
                "(void)blorp_owner_0;return blorp_owner_0;}\n",
            ),
        )
        .concat(ENTRYPOINT)
    Ok(exact(ids, [mixed_layout()], [main_function(ids), helper], string_runtime(), expected))


pure func test_nullary_variant_keeps_the_aggregate_owner_without_child_work() -> Bool:
    nullary_case().get_or(False)


private pure func integer_variant_case() -> Result[Bool, Diagnostic]:
    seed ?= seed(MIXED_SEED, 0)
    number ?= seed.variants
        .get(2)
        .to_result(seed_error())
    ids = seed.values
    value_type = specialized.UnionType(seed.owner)
    helper = function(
        [],
        value_type,
        [
            integer(ids.first, 9),
            definition(
                ids.second,
                value_type,
                owned.ConstructDefinition(number, [owned.UnmanagedPayload(ids.first)]),
                owned.OwnedResult(owned.owner_id(0)),
            ),
        ],
        returned(ids.second, 0),
        [mixed_layout()],
    )
    expected = expected_mixed_c()
        .concat(MAIN_DECL)
        .concat("struct blorp_u_0 blorp_f_1(void);")
        .concat(expected_main_body())
        .concat(
            "struct blorp_u_0 blorp_f_1(void){const int64_t ".concat(
                "blorp_vl_0=INT64_C(9);(void)blorp_vl_0;",
            ),
        )
        .concat(
            "const struct blorp_u_0 blorp_vl_1=((struct blorp_u_0){"
                .concat(".tag=blorp_v_0_2,.payload.blorp_up_2={.blorp_uf_0=blorp_vl_0}});")
                .concat("(void)blorp_vl_1;"),
        )
        .concat(
            "const struct blorp_u_0 blorp_owner_0=blorp_vl_1;".concat(
                "(void)blorp_owner_0;return blorp_owner_0;}\n",
            ),
        )
        .concat(ENTRYPOINT)
    Ok(exact(ids, [mixed_layout()], [main_function(ids), helper], string_runtime(), expected))


pure func test_integer_variant_keeps_the_aggregate_owner_without_child_work() -> Bool:
    integer_variant_case().get_or(False)


private pure func nested_case() -> Result[Bool, Diagnostic]:
    child ?= seed(NESTED_SEED, 0)
    parent ?= seed(NESTED_SEED, 1)
    boxed ?= child.variants
        .get(0)
        .to_result(seed_error())
    wrapped ?= parent.variants
        .get(0)
        .to_result(seed_error())
    ids = child.values
    child_type = specialized.UnionType(child.owner)
    parent_type = specialized.UnionType(parent.owner)
    layouts: List[specialized.ConcreteUnion] = [
        boxed_layout(),
        specialized.OwningCases([[child_type]]),
    ]
    helper = function(
        [],
        parent_type,
        [
            integer(ids.first, 7),
            string(ids.second, ids.first),
            definition(
                ids.third,
                child_type,
                owned.ConstructDefinition(boxed, [
                    owned.OwnedPayload(ids.second, owned.owner_id(0)),
                ]),
                owned.OwnedResult(owned.owner_id(1)),
            ),
            definition(
                ids.fourth,
                parent_type,
                owned.ConstructDefinition(wrapped, [
                    owned.OwnedPayload(ids.third, owned.owner_id(1)),
                ]),
                owned.OwnedResult(owned.owner_id(2)),
            ),
        ],
        returned(ids.fourth, 2),
        layouts,
    )
    expected = expected_box_c()
        .concat("\n")
        .concat(expected_outer_c())
        .concat(MAIN_DECL)
        .concat("struct blorp_u_1 blorp_f_1(void);")
        .concat(expected_main_body())
        .concat(
            "struct blorp_u_1 blorp_f_1(void){const int64_t ".concat(
                "blorp_vl_0=INT64_C(7);(void)blorp_vl_0;",
            ),
        )
        .concat(
            "struct blorp_string* const "
                .concat("blorp_vl_1=blorp_int_to_string(blorp_vl_0);")
                .concat("(void)blorp_vl_1;struct blorp_string* const ")
                .concat("blorp_owner_0=blorp_vl_1;(void)blorp_owner_0;"),
        )
        .concat(
            "const struct blorp_u_0 blorp_vl_2=((struct blorp_u_0){"
                .concat(".tag=blorp_v_0_0,.payload.blorp_up_0={.blorp_uf_0=blorp_owner_0}});")
                .concat("(void)blorp_vl_2;const struct blorp_u_0 ")
                .concat("blorp_owner_1=blorp_vl_2;(void)blorp_owner_1;"),
        )
        .concat(
            "const struct blorp_u_1 blorp_vl_3=((struct blorp_u_1){"
                .concat(".tag=blorp_v_1_0,.payload.blorp_up_0={.blorp_uf_0=blorp_owner_1}});")
                .concat("(void)blorp_vl_3;const struct blorp_u_1 ")
                .concat("blorp_owner_2=blorp_vl_3;(void)blorp_owner_2;return ")
                .concat("blorp_owner_2;}\n"),
        )
        .concat(ENTRYPOINT)
    Ok(exact(ids, layouts, [main_function(ids), helper], string_runtime(), expected))


pure func test_nested_helpers_precede_parents_and_delegate_one_child_obligation() -> Bool:
    nested_case().get_or(False)


private pure func arm_owner_case() -> Result[Bool, Diagnostic]:
    seed ?= seed(CHOICE_SEED, 0)
    left ?= seed.variants
        .get(0)
        .to_result(seed_error())
    right ?= seed.variants
        .get(1)
        .to_result(seed_error())
    ids = seed.values
    value_type = specialized.UnionType(seed.owner)
    layout: specialized.ConcreteUnion = specialized.OwningCases([
        [specialized.StringType],
        [specialized.StringType],
    ])
    left_field ?= specialized.variant_field(left, 0, [layout], span(0))
    right_field ?= specialized.variant_field(right, 0, [layout], span(0))
    selection = selection_inputs.branches(
        owned.BorrowedArgument({ value = ids.first, source = owned.ParameterBorrow(ids.first) }),
        left,
    )
    nodes = selection.nodes
        .set(
            0,
            owned.EnterArm({
                arm = model.match_arm_id(0),
                operations = [
                    definition(
                        ids.third,
                        specialized.StringType,
                        owned.PayloadDefinition(left_field, ids.first),
                        owned.BorrowedResult(owned.PayloadBorrow(ids.first)),
                    ),
                    acquire(1, ids.third, owned.PayloadBorrow(ids.first)),
                ],
                transfers = [returned(ids.third, 1)],
            }),
        )
        .set(
            1,
            owned.EnterArm({
                arm = model.match_arm_id(1),
                operations = [
                    acquire(2, ids.first, owned.ParameterBorrow(ids.first)),
                    owned.DropOwner(owned.owner_id(2), span(30)),
                    definition(
                        ids.fourth,
                        specialized.StringType,
                        owned.PayloadDefinition(right_field, ids.first),
                        owned.BorrowedResult(owned.PayloadBorrow(ids.first)),
                    ),
                    acquire(3, ids.fourth, owned.PayloadBorrow(ids.first)),
                ],
                transfers = [returned(ids.fourth, 3)],
            }),
        )
    helper = function(
        [value_type],
        specialized.StringType,
        [parameter(ids.first, value_type)].append(
            owned.ExecuteJoin({
                result = owned.ManagedJoinParameter(
                    { id = ids.second, value_type = specialized.StringType, span = span(30) },
                    owned.owner_id(0),
                ),
                carried = [],
                entering = [],
                selection = { selection | nodes = nodes },
                arms = [
                    {
                        id = model.match_arm_id(0),
                        inputs = [
                            owned.ManagedJoinParameter(
                                {
                                    id = ids.fifth,
                                    value_type = specialized.StringType,
                                    span = span(30),
                                },
                                owned.owner_id(4),
                            ),
                        ],
                        operations = [],
                        exit = owned.Yield({ transfer = returned(ids.fifth, 4), carried = [] }),
                    },
                    {
                        id = model.match_arm_id(1),
                        inputs = [
                            owned.ManagedJoinParameter(
                                {
                                    id = ids.sixth,
                                    value_type = specialized.StringType,
                                    span = span(30),
                                },
                                owned.owner_id(5),
                            ),
                        ],
                        operations = [],
                        exit = owned.Yield({ transfer = returned(ids.sixth, 5), carried = [] }),
                    },
                ],
            }),
        ),
        returned(ids.second, 0),
        [layout],
    )
    expected = expected_choice_c()
        .concat(MAIN_DECL)
        .concat("struct blorp_string* blorp_f_1(struct blorp_u_0 blorp_p_0);")
        .concat(expected_main_body())
        .concat(
            "struct blorp_string* blorp_f_1(struct blorp_u_0 blorp_p_0){const struct blorp_u_0 blorp_vl_0=blorp_p_0;(void)blorp_vl_0;",
        )
        .concat(
            "struct blorp_string* blorp_vl_1;struct blorp_string* blorp_vl_4;struct blorp_string* blorp_vl_5;goto blorp_selection_1_node_2;",
        )
        .concat(
            "blorp_selection_1_node_0:{struct blorp_string* const blorp_vl_2=blorp_vl_0.payload.blorp_up_0.blorp_uf_0;(void)blorp_vl_2;",
        )
        .concat(
            "blorp_string_retain(blorp_vl_2);struct blorp_string* const blorp_owner_1=blorp_vl_2;(void)blorp_owner_1;blorp_vl_4=blorp_owner_1;goto blorp_selection_1_arm_0;}",
        )
        .concat(
            "blorp_selection_1_node_1:{blorp_union_dup_0(blorp_vl_0);const struct blorp_u_0 blorp_owner_2=blorp_vl_0;(void)blorp_owner_2;blorp_union_drop_0(blorp_owner_2);",
        )
        .concat(
            "struct blorp_string* const blorp_vl_3=blorp_vl_0.payload.blorp_up_1.blorp_uf_0;(void)blorp_vl_3;blorp_string_retain(blorp_vl_3);struct blorp_string* const blorp_owner_3=blorp_vl_3;(void)blorp_owner_3;",
        )
        .concat("blorp_vl_5=blorp_owner_3;goto blorp_selection_1_arm_1;}")
        .concat(
            "blorp_selection_1_node_2:{if((blorp_vl_0).tag==blorp_v_0_0)goto blorp_selection_1_node_0;goto blorp_selection_1_node_1;}",
        )
        .concat(
            "blorp_selection_1_arm_0:{(void)blorp_vl_4;struct blorp_string* const blorp_owner_4=blorp_vl_4;(void)blorp_owner_4;blorp_vl_1=blorp_owner_4;goto blorp_selection_1_done;}",
        )
        .concat(
            "blorp_selection_1_arm_1:{(void)blorp_vl_5;struct blorp_string* const blorp_owner_5=blorp_vl_5;(void)blorp_owner_5;blorp_vl_1=blorp_owner_5;goto blorp_selection_1_done;}",
        )
        .concat(
            "blorp_selection_1_done:;(void)blorp_vl_1;struct blorp_string* const blorp_owner_0=blorp_vl_1;(void)blorp_owner_0;return blorp_owner_0;}\n",
        )
        .concat(ENTRYPOINT)
    Ok(exact(ids, [layout], [main_function(ids), helper], string_runtime(), expected))


pure func test_owner_type_projection_keeps_global_arm_ids_and_different_storage_types() -> Bool:
    arm_owner_case().get_or(False)


private pure func function_owner_case() -> Result[Bool, Diagnostic]:
    seed ?= seed(BOX_SEED, 0)
    ids = seed.values
    string_identity = function(
        [specialized.StringType],
        specialized.StringType,
        [
            parameter(ids.first, specialized.StringType),
            acquire(0, ids.first, owned.ParameterBorrow(ids.first)),
        ],
        returned(ids.first, 0),
    )
    union_identity = function(
        [specialized.UnionType(seed.owner)],
        specialized.UnionType(seed.owner),
        [
            parameter(ids.first, specialized.UnionType(seed.owner)),
            acquire(0, ids.first, owned.ParameterBorrow(ids.first)),
        ],
        returned(ids.first, 0),
    )
    expected = expected_box_c()
        .concat(MAIN_DECL)
        .concat(
            "struct blorp_string* blorp_f_1(struct blorp_string* "
                .concat("blorp_p_0);struct blorp_u_0 blorp_f_2(struct blorp_u_0 ")
                .concat("blorp_p_0);"),
        )
        .concat(expected_main_body())
        .concat(
            "struct blorp_string* blorp_f_1(struct blorp_string* "
                .concat("blorp_p_0){struct blorp_string* const ")
                .concat("blorp_vl_0=blorp_p_0;(void)blorp_vl_0;")
                .concat("blorp_string_retain(blorp_vl_0);struct blorp_string* ")
                .concat("const blorp_owner_0=blorp_vl_0;(void)blorp_owner_0;")
                .concat("return blorp_owner_0;}\n"),
        )
        .concat(
            "struct blorp_u_0 blorp_f_2(struct blorp_u_0 blorp_p_0){"
                .concat("const struct blorp_u_0 blorp_vl_0=blorp_p_0;")
                .concat("(void)blorp_vl_0;blorp_union_dup_0(blorp_vl_0);const ")
                .concat("struct blorp_u_0 blorp_owner_0=blorp_vl_0;")
                .concat("(void)blorp_owner_0;return blorp_owner_0;}\n"),
        )
        .concat(ENTRYPOINT)
    Ok(
        exact(
            ids,
            [boxed_layout()],
            [main_function(ids), string_identity, union_identity],
            string_runtime(),
            expected,
        ),
    )


pure func test_owner_type_projection_restarts_for_each_function() -> Bool:
    function_owner_case().get_or(False)


pure func test_unmanaged_union_output_has_no_owning_helpers_or_string_runtime() -> Bool:
    match input_ids():
        Err(_):
            False
        Ok(ids):
            expected = "enum blorp_tag_0{blorp_v_0_0};struct blorp_u_0{enum "
                .concat("blorp_tag_0 tag;union{struct{int64_t blorp_uf_0;} blorp_up_0;}payload;};")
                .concat(MAIN_DECL)
                .concat(expected_main_body())
                .concat(PLAIN_ENTRYPOINT)
            exact(
                ids,
                [specialized.PlainCases([[specialized.IntegerType(Int64Format)]])],
                [main_function(ids)],
                "#include <stdint.h>\n",
                expected,
            )


-- This dynamic input prevents host CTFE from replacing the stage-lifetime
-- probe. Exact raw-IR ownership oracles above remain independent of own().
func test_dynamic_fixture_reaches_emission_without_host_lifetime_leaks() -> Bool:
    match read_file("blorp/test/e2e/fixtures/generic/managed/basic.brp"):
        Err(error):
            print_error(error)
            False
        Ok(source):
            match (
                lowered_modules([
                    { source = source, targets = [1, 2] },
                    { source = INTEGER_OPERATIONS, targets = [] },
                    { source = STRING_OPERATIONS, targets = [] },
                ])
                    .and_then(pure func(program): owned.own(program))
                    .and_then(verify)
                    .and_then(emit)
            ):
                Err(error):
                    print_error(error.message)
                    False
                Ok(_):
                    True


TESTS: TestSuite = {
    description = "Blorp managed union emission",
    tests = [
        (
            "String helpers and unused catalog include runtime",
            test_string_layout_and_helpers_include_the_runtime_for_an_unused_catalog,
        ),
        (
            "union acquire and drop use a struct owner alias",
            test_union_acquire_and_drop_use_a_struct_owner_alias,
        ),
        (
            "final owned child transfers without extra ARC work",
            test_final_owned_child_constructs_from_its_owner_without_extra_arc_work,
        ),
        (
            "borrowed String acquires before construction",
            test_borrowed_string_parameter_is_acquired_before_constructor_transfer,
        ),
        (
            "selected payload acquires inside its returning arm",
            test_selected_payload_is_acquired_inside_its_arm_before_owned_return,
        ),
        (
            "managed variants touch only matching payload slots",
            test_two_managed_variants_touch_only_their_matching_payload_slot,
        ),
        (
            "nullary variant has a uniform aggregate owner",
            test_nullary_variant_keeps_the_aggregate_owner_without_child_work,
        ),
        (
            "Int active variant retains uniform aggregate obligation",
            test_integer_variant_keeps_the_aggregate_owner_without_child_work,
        ),
        (
            "nested helpers precede parents and delegate child work",
            test_nested_helpers_precede_parents_and_delegate_one_child_obligation,
        ),
        (
            "global arm owner IDs preserve different storage types",
            test_owner_type_projection_keeps_global_arm_ids_and_different_storage_types,
        ),
        (
            "owner type projection restarts per function",
            test_owner_type_projection_restarts_for_each_function,
        ),
        (
            "unmanaged output omits owning helpers and runtime",
            test_unmanaged_union_output_has_no_owning_helpers_or_string_runtime,
        ),
        (
            "dynamic fixture emission lifetime",
            test_dynamic_fixture_reaches_emission_without_host_lifetime_leaks,
        ),
    ],
}
