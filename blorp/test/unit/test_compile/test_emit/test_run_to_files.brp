import:
    bool: Bool methods
    int: Int methods
    option: Option methods
    result: Result methods
    string: String methods
    test: TestSuite
    ../../../../src/compile/check/check: check
    ../../../../src/compile/check/render: render_failure
    ../../../../src/compile/emit/emit: emit
    ../../../../src/compile/lower/lower: lower
    ../../../../src/compile/own/own: own
    ../../../../src/compile/runtime/process: PROCESS_POSIX_PRELUDE
    ../../../../src/compile/specialize/specialize: specialize
    ../../../../src/compile/verify/verify: verify
    ../../../../src/syntax/syntax: Diagnostic
    ../../module_input: test_base, parse_modules
    ../../run_to_files_inputs: process_seed
    ../../text_search: find_text


private pure func process_c() -> Result[String, Diagnostic]:
    seed ?= process_seed(test_base())
    owned ?= own(seed.lowered)
    verified ?= verify(owned)
    emit(verified)


pure func test_posix_prelude_and_list_layout_precede_helper() -> Bool:
    match process_c():
        Err(_):
            False
        Ok(code):
            match (
                find_text(code, "struct blorp_l_0_s{", 0),
                find_text(code, "uint8_t blorp_process_run_to_files(", 0),
            ):
                (Some(layout), Some(helper)):
                    code
                        .starts_with(PROCESS_POSIX_PRELUDE)
                        .and(layout < helper)
                _:
                    False


pure func test_result_owns_only_the_error_string() -> Bool:
    match process_c():
        Err(_):
            False
        Ok(code):
            find_text(
                code,
                "int64_t blorp_runtime_5_value=0;struct blorp_string *blorp_runtime_5_error=NULL;",
                0,
            )
                .is_some()
                .and(
                    find_text(
                        code,
                        "blorp_process_run_to_files(blorp_vl_0,blorp_vl_1,blorp_vl_2,blorp_vl_3,blorp_vl_4,&blorp_runtime_5_value,&blorp_runtime_5_error)",
                        0,
                    ).is_some(),
                )
                .and(find_text(code, ".blorp_uf_0=blorp_runtime_5_value", 0).is_some())
                .and(find_text(code, ".blorp_uf_0=blorp_runtime_5_error", 0).is_some())
                .and(find_text(code, "blorp_string_release(blorp_runtime_5_error)", 0).is_none())


pure func test_unused_process_declaration_selects_no_posix_or_native_helper() -> Bool:
    source = "func query(program: String, args: List[String], out: String, err: String, timeout: Int) -> Result[Int, String]:\n    builtin(\"process.run_to_files\")\nfunc main() -> Int:\n    0\n"
    match parse_modules([{ source = source, targets = [] }]):
        Err(_):
            False
        Ok(parsed):
            match check(parsed):
                Err(_):
                    False
                Ok(checked):
                    match (
                        specialize(checked)
                            .and_then(lower)
                            .and_then(own)
                            .and_then(verify)
                            .and_then(emit)
                    ):
                        Err(_):
                            False
                        Ok(code):
                            find_text(code, "_POSIX_C_SOURCE", 0)
                                .is_none()
                                .and(find_text(code, "blorp_process_run_to_files", 0).is_none())


TESTS: TestSuite = {
    description = "Process builtin C emission",
    tests = [
        (
            "POSIX feature prelude first and helper after String list layout",
            test_posix_prelude_and_list_layout_precede_helper,
        ),
        (
            "ordinary Result receives primitive success or owned error",
            test_result_owns_only_the_error_string,
        ),
        (
            "unused process declaration selects no process fragments",
            test_unused_process_declaration_selects_no_posix_or_native_helper,
        ),
    ],
}
