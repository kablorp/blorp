import:
    bool: Bool methods
    test: TestSuite
    ../../../../src/compile/emit/emit: emit
    ../../../../src/compile/verify/verify: verify
    ../../../../src/syntax/syntax: Diagnostic
    ../../int_pattern_inputs: owned_int_patterns
    ../../text_search: has_text, occurrences


private pure func emitted() -> Result[String, Diagnostic]:
    owned ?= owned_int_patterns()
    verified ?= verify(owned)
    emit(verified)


-- Each test compares the place with `==` and branches; INT64_MIN is spelled
-- as itself, because negating its magnitude would overflow.
pure func test_int_literal_tests_compare_with_c_integer_constants() -> Bool:
    match emitted():
        Err(_):
            False
        Ok(code):
            (occurrences(code, ")==INT64_C(0))goto ") == 2)
                .and(has_text(code, ")==(-INT64_C(1)))goto "))
                .and(has_text(code, ")==INT64_MIN)goto "))


tests: TestSuite = {
    description = "Blorp Int literal pattern C emission",
    tests = [
        (
            "Int literal tests compare with C integer constants",
            test_int_literal_tests_compare_with_c_integer_constants,
        ),
    ],
}
