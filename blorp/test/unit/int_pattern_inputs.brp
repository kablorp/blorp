-- Programs whose matches test Int literals, shared by the specialization,
-- lowering, ownership, verification and emission suites.
import:
    bool: Bool methods
    int: INT_MIN
    list: List methods
    ../../src/compile/own/own as own
    ../../src/syntax/syntax: Diagnostic
    ./managed_union_inputs: lowered


-- `classify` tests its Int root against 0, -1 and the Int64 minimum; `code`
-- tests the Int field of `Exited` against 0.
INT_PATTERNS: String =
    |union Exit:
    |	Exited(Int)
    |	Signaled(Int)
    |pure func code(exit: Exit) -> Int:
    |	match exit:
    |		Exited(0): 1
    |		Exited(status): status
    |		Signaled(_): 2
    |pure func classify(count: Int) -> Int:
    |	match count:
    |		0: 1
    |		-1: 2
    |		-9223372036854775808: 3
    |		_: 4
    |func main() -> Int:
    |	code(Exited(classify(0)))
    |


-- The values a phase's Int literal tests compare with, split by whether the
-- tested Int is the match root or a field below it.
record IntLiteralTests {
    at_root: List[Int],
    in_fields: List[Int],
}


-- Exactly the tests INT_PATTERNS makes: 0, -1 and the Int64 minimum at the
-- root of `classify`, and 0 in the field of `Exited`.
pure func int_pattern_tests_are_complete(tests: IntLiteralTests) -> Bool:
    (tests.in_fields == [0])
        .and(tests.at_root.length() == 3)
        .and(tests.at_root.contains(0))
        .and(tests.at_root.contains(-1))
        .and(tests.at_root.contains(INT_MIN))


pure func owned_int_patterns() -> Result[own.OwnershipProgram, Diagnostic]:
    program ?= lowered(INT_PATTERNS)
    own.own(program)


-- Every join a function executes at its top level, in order.
pure func top_level_joins(function: own.OwnedFunction) -> List[own.OwnedJoin]:
    var joins: List[own.OwnedJoin] = []
    for operation in function.operations:
        match operation:
            own.ExecuteJoin(join): joins = joins.append(join)
            _: void
    joins
