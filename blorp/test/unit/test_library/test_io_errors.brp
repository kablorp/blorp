import:
    bool: Bool methods
    int: INT_MIN
    io/_codes: decode_error
    io/error:
        IOError,
        IOErrorKind(
            NotFound,
            PermissionDenied,
            AlreadyExists,
            NotADirectory,
            IsADirectory,
            DirectoryNotEmpty,
            NotARegularFile,
            ReadOnlyFilesystem,
            NoSpace,
            FileTooLarge,
            CrossesDevices,
            PathContainsNul,
            InvalidUtf8,
            ChangedDuringRemoval,
            OtherOs,
        ),
        to_string,
    io/fs: default_if_not_found
    test: TestSuite


-- Literal inputs independently bind the library decoder to the native ABI.
private pure func test_named_native_codes_keep_their_error_kinds() -> Bool:
    cases: List[(Int, IOErrorKind)] = [
        (1, NotFound),
        (2, PermissionDenied),
        (3, AlreadyExists),
        (4, NotADirectory),
        (5, IsADirectory),
        (6, DirectoryNotEmpty),
        (7, NotARegularFile),
        (8, ReadOnlyFilesystem),
        (9, NoSpace),
        (10, FileTooLarge),
        (11, CrossesDevices),
        (12, PathContainsNul),
        (13, InvalidUtf8),
        (14, ChangedDuringRemoval),
    ]
    var correct: Bool = True
    for (code, expected) in cases:
        correct = correct.and(decode_error(code) == expected)
    correct


private pure func test_unnamed_codes_preserve_existing_negation() -> Bool:
    (decode_error(-37) == OtherOs(37))
        .and(decode_error(0) == OtherOs(0))
        .and(decode_error(15) == OtherOs(-15))
        .and(decode_error(INT_MIN) == OtherOs(INT_MIN))


private pure func test_io_error_type_selection_supplies_unchanged_descriptions() -> Bool:
    cases: List[(IOErrorKind, String)] = [
        (NotFound, "no such file"),
        (PermissionDenied, "permission denied"),
        (AlreadyExists, "already exists"),
        (NotADirectory, "not a directory"),
        (IsADirectory, "is a directory"),
        (DirectoryNotEmpty, "directory not empty"),
        (NotARegularFile, "not a regular file"),
        (ReadOnlyFilesystem, "read-only file system"),
        (NoSpace, "no space left on device"),
        (FileTooLarge, "file too large"),
        (CrossesDevices, "crosses devices"),
        (PathContainsNul, "path contains a NUL byte"),
        (InvalidUtf8, "contents are not valid UTF-8"),
        (ChangedDuringRemoval, "changed during removal"),
        (OtherOs(37), "operating system error 37"),
    ]
    var correct: Bool = True
    for (kind, phrase) in cases:
        error: IOError = { path = "settings.conf", destination = None, kind = kind }
        correct = correct.and(error.to_string() == "settings.conf: ${phrase}")
    moved: IOError = { path = "a", destination = Some("b"), kind = CrossesDevices }
    correct.and(moved.to_string() == "a -> b: crosses devices")


private pure func test_interpolation_and_to_string_agree_on_a_two_path_error() -> Bool:
    moved: IOError = { path = "a", destination = Some("b"), kind = CrossesDevices }
    ("${moved}" == "a -> b: crosses devices").and(moved.to_string() == "a -> b: crosses devices")


private pure func test_fs_default_uses_the_io_owned_error_identity() -> Bool:
    missing: Result[String, IOError] = Err({
        path = "settings.conf",
        destination = None,
        kind = NotFound,
    })
    refused: Result[String, IOError] = Err({
        path = "settings.conf",
        destination = None,
        kind = PermissionDenied,
    })
    (default_if_not_found(missing, "fallback") == Ok("fallback")).and(
        default_if_not_found(refused, "fallback") == refused,
    )


tests: TestSuite = {
    description = "Shared I/O error ownership and native decoding",
    tests = [
        (
            "named native codes preserve every error kind",
            test_named_native_codes_keep_their_error_kinds,
        ),
        (
            "unnamed native codes preserve negated errno and wrap behavior",
            test_unnamed_codes_preserve_existing_negation,
        ),
        (
            "selecting io IOError supplies unchanged descriptions",
            test_io_error_type_selection_supplies_unchanged_descriptions,
        ),
        (
            "interpolation and to_string agree on a two-path error",
            test_interpolation_and_to_string_agree_on_a_two_path_error,
        ),
        (
            "fs default helper accepts io owned errors",
            test_fs_default_uses_the_io_owned_error_identity,
        ),
    ],
}
