import:
    _base: Hashable
    bool: and
    int as IntOps: Int methods
    test: TestSuite


record Collision { value: Int }


implements Hashable for Collision:
    pure func hash(value: Self) -> Int:
        7


private pure func hash_value[Key: Hashable](value: Key) -> Int:
    value.hash()


private pure func test_zero_hashes_to_itself() -> Bool:
    IntOps.hash(0) == 0


private pure func test_positive_int_hashes_to_itself() -> Bool:
    IntOps.hash(42) == 42


private pure func test_negative_int_hashes_to_itself() -> Bool:
    IntOps.hash(-42) == -42


private pure func test_minimum_int_hashes_to_itself() -> Bool:
    IntOps.hash(IntOps.INT_MIN) == IntOps.INT_MIN


private pure func test_maximum_int_hashes_to_itself() -> Bool:
    IntOps.hash(IntOps.INT_MAX) == IntOps.INT_MAX


private pure func test_generic_hash_dispatches_to_int() -> Bool:
    hash_value(-17) == -17


private pure func test_generic_hash_dispatches_to_record() -> Bool:
    value: Collision = { value = 19 }
    hash_value(value) == 7


private pure func test_unequal_values_may_have_equal_hashes() -> Bool:
    first: Collision = { value = 1 }
    second: Collision = { value = 2 }
    and(first != second, hash_value(first) == hash_value(second))


private pure func test_equal_values_have_equal_hashes() -> Bool:
    first: Collision = { value = 5 }
    second: Collision = { value = 5 }
    and(first == second, hash_value(first) == hash_value(second))


private pure func test_bool_hashes_are_zero_and_one() -> Bool:
    no: Bool = False
    yes: Bool = True
    and(hash_value(no) == 0, hash_value(yes) == 1)


private pure func test_equal_strings_have_equal_hashes() -> Bool:
    and(hash_value("alpha") == hash_value("al" + "pha"), hash_value("") == hash_value(""))


-- The byte fold is order sensitive, so anagrams and prefixes differ.
private pure func test_strings_that_differ_in_order_or_length_hash_differently() -> Bool:
    and(hash_value("ab") != hash_value("ba"), hash_value("ab") != hash_value("abc"))


tests: TestSuite = {
    description = "Ordinary Hashable trait and Int, Bool and String hashing",
    tests = [
        ("zero hashes to itself", test_zero_hashes_to_itself),
        ("positive Int hashes to itself", test_positive_int_hashes_to_itself),
        ("negative Int hashes to itself", test_negative_int_hashes_to_itself),
        ("minimum Int hashes to itself", test_minimum_int_hashes_to_itself),
        ("maximum Int hashes to itself", test_maximum_int_hashes_to_itself),
        ("generic hash dispatches to Int", test_generic_hash_dispatches_to_int),
        ("generic hash dispatches to a record", test_generic_hash_dispatches_to_record),
        ("unequal values may have equal hashes", test_unequal_values_may_have_equal_hashes),
        ("equal values have equal hashes", test_equal_values_have_equal_hashes),
        ("Bool hashes to zero and one", test_bool_hashes_are_zero_and_one),
        ("equal Strings hash equally", test_equal_strings_have_equal_hashes),
        (
            "Strings differing in order or length hash differently",
            test_strings_that_differ_in_order_or_length_hash_differently,
        ),
    ],
}
