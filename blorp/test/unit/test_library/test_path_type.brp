import:
    _base: Option(Some, None), Result(Ok, Err)
    bool: Bool methods, and
    dict: Dict
    option: Option methods
    path: Path, PathError(Empty, ContainsNul), extension, is_within, name, parent, stem, to_path
    string: from_codepoint
    test: TestSuite


-- Runs `check` on the path for `text`. A fixture text the constructor refuses
-- is a defect in the test, so it fails the test instead of testing another path.
private pure func holds(text: String, check: pure (Path) -> Bool) -> Bool:
    match to_path(text):
        Ok(path): check(path)
        Err(_): False


private pure func holds_both(
    first: String,
    second: String,
    check: pure (Path, Path) -> Bool,
) -> Bool:
    holds(first, pure func(left: Path): holds(second, pure func(right: Path): check(left, right)))


private pure func spelling(path: Path) -> String:
    "${path}"


private pure func is_refused_with(text: String, expected: PathError) -> Bool:
    match to_path(text):
        Ok(_): False
        Err(error): error == expected


private pure func error_text(error: PathError) -> String:
    "${error}"


private pure func parent_is(text: String, expected: String) -> Bool:
    text.holds(
        pure func(path: Path): (
            path
                .parent()
                .spelling()
            == expected
        ),
    )


private pure func name_is(text: String, expected: Option[String]) -> Bool:
    text.holds(pure func(path: Path): path.name() == expected)


private pure func stem_is(text: String, expected: Option[String]) -> Bool:
    text.holds(pure func(path: Path): path.stem() == expected)


private pure func extension_is(text: String, expected: Option[String]) -> Bool:
    text.holds(pure func(path: Path): path.extension() == expected)


private pure func within(text: String, root: String) -> Bool:
    text.holds_both(root, pure func(path: Path, root_path: Path): path.is_within(root_path))


private pure func sum_is(left: String, right: String, expected: String) -> Bool:
    left.holds_both(
        right,
        pure func(first: Path, second: Path): (first + second).spelling() == expected,
    )


private pure func test_empty_text_is_refused() -> Bool:
    "".is_refused_with(Empty)


private pure func test_nul_byte_is_refused() -> Bool:
    nul = from_codepoint(0).get_or("")
    "a${nul}b".is_refused_with(ContainsNul)


private pure func test_ordinary_text_is_kept_as_written() -> Bool:
    "a//b/./c/".holds(pure func(path: Path): path.spelling() == "a//b/./c/")


private pure func test_error_text() -> Bool:
    and(
        error_text(Empty) == "a path cannot be empty",
        error_text(ContainsNul) == "a path cannot contain a NUL byte",
    )


private pure func test_equal_spellings_are_equal_and_hash_equally() -> Bool:
    "a/b".holds_both(
        "a/b",
        pure func(left: Path, right: Path): and(left == right, left.hash() == right.hash()),
    )


private pure func test_repeated_separator_is_a_different_path() -> Bool:
    "a//b".holds_both(
        "a/b",
        pure func(left: Path, right: Path): and(left != right, left.hash() != right.hash()),
    )


private pure func is_stored_under(stored: Path, probe: Path) -> Bool:
    table: Dict[Path, Int] = { stored => 1 }
    table.get(probe) == Some(1)


private pure func test_path_is_a_dict_key() -> Bool:
    "a/b".holds_both("a/b", is_stored_under)


private pure func test_parent_is_total() -> Bool:
    and(
        and(parent_is("a/b/c", "a/b"), parent_is("a", ".")),
        and(
            and(parent_is("/", "/"), parent_is("/a", "/")),
            and(parent_is("a/b/", "a"), and(parent_is("a//b", "a"), parent_is("a/..", "a"))),
        ),
    )


private pure func test_name_is_the_whole_last_component() -> Bool:
    and(
        and(name_is("a/b", Some("b")), name_is("a/b//", Some("b"))),
        and(name_is("a", Some("a")), name_is("x.brp", Some("x.brp"))),
    )


private pure func test_navigation_components_have_no_name() -> Bool:
    and(
        and(name_is("/", None), name_is("//", None)),
        and(
            and(name_is("..", None), name_is("a/..", None)),
            and(name_is(".", None), name_is("a/./", None)),
        ),
    )


private pure func test_stem_and_extension_split_at_the_last_dot() -> Bool:
    and(stem_is("src/x.test.brp", Some("x.test")), extension_is("src/x.test.brp", Some("brp")))


private pure func test_leading_dot_is_not_an_extension() -> Bool:
    and(stem_is("a/.hidden", Some(".hidden")), extension_is("a/.hidden", None))


private pure func test_hidden_name_keeps_its_extension() -> Bool:
    and(stem_is(".hidden.brp", Some(".hidden")), extension_is(".hidden.brp", Some("brp")))


private pure func test_trailing_dot_is_an_empty_extension() -> Bool:
    and(stem_is("a.", Some("a")), extension_is("a.", Some("")))


private pure func test_only_dots_split_after_the_first() -> Bool:
    and(stem_is("...", Some("..")), extension_is("...", Some("")))


private pure func test_name_without_dot_has_no_extension() -> Bool:
    and(stem_is("a/b/", Some("b")), extension_is("a/b/", None))


private pure func test_navigation_components_have_no_stem_or_extension() -> Bool:
    and(
        and(stem_is("/", None), extension_is("/", None)),
        and(stem_is("..", None), extension_is("a/.", None)),
    )


private pure func test_plus_concatenates_spellings_exactly() -> Bool:
    and(sum_is("a", "b", "ab"), sum_is("a/", "b/c", "a/b/c"))


private pure func sums_agree(first: Path, second: Path, third: Path, fourth: Path) -> Bool:
    left = first + second
    right = third + fourth
    and(left == right, left.hash() == right.hash())


private pure func test_sums_with_one_spelling_are_equal_and_hash_equally() -> Bool:
    "a".holds_both(
        "/b",
        pure func(first: Path, second: Path): "a/".holds_both(
            "b",
            pure func(third: Path, fourth: Path): sums_agree(first, second, third, fourth),
        ),
    )


private pure func sum_revalidates(first: Path, second: Path) -> Bool:
    sum = first + second
    match to_path(sum.spelling()):
        Ok(again): and(again == sum, sum.spelling() == "a/b")
        Err(_): False


private pure func test_sum_of_valid_paths_is_a_valid_path() -> Bool:
    "a".holds_both("/b", sum_revalidates)


private pure func test_within_compares_components() -> Bool:
    and(
        and(within("a/b/c.brp", "a/b"), within("a/b", "a/b")),
        and(within("a/bc.brp", "a/b").not(), within("a", "a/b").not()),
    )


private pure func test_within_root_and_current_directory() -> Bool:
    and(
        and(within("/a/b", "/"), within("a/b", "/").not()),
        and(within("a/b", "."), within("/a", ".").not()),
    )


private pure func test_within_ignores_repeats_and_dots() -> Bool:
    and(within("a//b/./c", "a/b/"), within("./a", "."))


private pure func test_within_refuses_a_parent_component_below_the_root() -> Bool:
    and(
        and(within("a/../b", "a").not(), within("../a", ".").not()),
        and(within("..", ".").not(), within("../x/y", "../x")),
    )


tests: TestSuite = {
    description = "Path type",
    tests = [
        ("empty text is refused", test_empty_text_is_refused),
        ("a NUL byte is refused", test_nul_byte_is_refused),
        ("ordinary text is kept as written", test_ordinary_text_is_kept_as_written),
        ("PathError text", test_error_text),
        (
            "equal spellings are equal and hash equally",
            test_equal_spellings_are_equal_and_hash_equally,
        ),
        (
            "a repeated separator makes a different path",
            test_repeated_separator_is_a_different_path,
        ),
        ("a Path is a Dict key", test_path_is_a_dict_key),
        ("parent is total", test_parent_is_total),
        ("name is the whole last component", test_name_is_the_whole_last_component),
        ("navigation components have no name", test_navigation_components_have_no_name),
        ("stem and extension split at the last dot", test_stem_and_extension_split_at_the_last_dot),
        ("a leading dot is not an extension", test_leading_dot_is_not_an_extension),
        ("a hidden name keeps its extension", test_hidden_name_keeps_its_extension),
        ("a trailing dot is an empty extension", test_trailing_dot_is_an_empty_extension),
        ("a run of dots splits after the first", test_only_dots_split_after_the_first),
        ("a name without a dot has no extension", test_name_without_dot_has_no_extension),
        (
            "navigation components have no stem or extension",
            test_navigation_components_have_no_stem_or_extension,
        ),
        ("plus concatenates spellings exactly", test_plus_concatenates_spellings_exactly),
        (
            "sums with one spelling are equal and hash equally",
            test_sums_with_one_spelling_are_equal_and_hash_equally,
        ),
        ("the sum of valid paths is valid", test_sum_of_valid_paths_is_a_valid_path),
        ("is_within compares components", test_within_compares_components),
        ("is_within root and current directory", test_within_root_and_current_directory),
        ("is_within ignores repeats and dots", test_within_ignores_repeats_and_dots),
        (
            "is_within refuses a parent component",
            test_within_refuses_a_parent_component_below_the_root,
        ),
    ],
}
