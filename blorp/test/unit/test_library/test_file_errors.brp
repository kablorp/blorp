TESTS: TestSuite = {
    description = "Exact file error decoding and text",
    tests = [
        ("read decoder maps each named code and wraps the rest", test_read_decoder),
        ("read errors have the fixed text of each variant", test_read_text),
        ("write decoder maps each named code and wraps the rest", test_write_decoder),
        ("write errors have the fixed text of each variant", test_write_text),
        ("entry decoder maps each named code and wraps the rest", test_entry_decoder),
        ("entry errors have the fixed text of each variant", test_entry_text),
        ("list decoder maps each named code and wraps the rest", test_list_decoder),
        ("list errors have the fixed text of each variant", test_list_text),
        (
            "create_directory decoder maps each named code and wraps the rest",
            test_create_directory_decoder,
        ),
        ("create_directory errors have the fixed text of each variant", test_create_directory_text),
        ("remove_file decoder maps each named code and wraps the rest", test_remove_file_decoder),
        ("remove_file errors have the fixed text of each variant", test_remove_file_text),
        (
            "remove_directory decoder maps each named code and wraps the rest",
            test_remove_directory_decoder,
        ),
        ("remove_directory errors have the fixed text of each variant", test_remove_directory_text),
        ("remove_tree decoder maps each named code and wraps the rest", test_remove_tree_decoder),
        ("remove_tree errors have the fixed text of each variant", test_remove_tree_text),
        ("rename decoder maps each named code and wraps the rest", test_rename_decoder),
        ("rename errors have the fixed text of each variant", test_rename_text),
        (
            "temporary_directory decoder maps each named code and wraps the rest",
            test_temporary_directory_decoder,
        ),
        (
            "temporary_directory errors have the fixed text of each variant",
            test_temporary_directory_text,
        ),
    ],
}
