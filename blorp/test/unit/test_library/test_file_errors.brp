import:
    bool: Bool methods
    int: INT_MIN
    io/fs/create_directory: CreateDirectoryError, decode_create_directory_error
    io/fs/entry: EntryError, decode_entry_error
    io/fs/list: ListError, decode_list_error
    io/fs/read: ReadError, decode_read_error
    io/fs/remove_directory: RemoveDirectoryError, decode_remove_directory_error
    io/fs/remove_file: RemoveFileError, decode_remove_file_error
    io/fs/remove_tree: RemoveTreeError, decode_remove_tree_error
    io/fs/rename: RenameError, decode_rename_error
    io/fs/temporary_directory: TemporaryDirectoryError, decode_temporary_directory_error
    io/fs/write: WriteError, decode_write_error
    list: List methods
    test: TestSuite


-- Literal codes independently bind each decoder to the native protocol of
-- src/common/codegen/runtime/fs.brp. A code a union does not name is OtherOs
-- with the code negated: an unnamed errno arrives negated and keeps the
-- platform's number, and a positive code no variant names stays visible as a
-- negative one.
private pure func decodes_all[T: Equatable](decode: pure (Int) -> T, cases: List[(Int, T)]) -> Bool:
    cases.all(pure func(case: (Int, T)) -> Bool:
        match case:
            (code, expected): decode(code) == expected
    )


private pure func texts_all[T: Stringable](cases: List[(T, String)]) -> Bool:
    cases.all(pure func(case: (T, String)) -> Bool:
        match case:
            (value, phrase): "${value}" == phrase
    )


private pure func test_read_decoder() -> Bool:
    cases: List[(Int, ReadError)] = [
        (1, ReadError.NotFound),
        (2, ReadError.PermissionDenied),
        (4, ReadError.NotADirectory),
        (5, ReadError.IsADirectory),
        (10, ReadError.FileTooLarge),
        (13, ReadError.InvalidUtf8),
        (-37, ReadError.OtherOs(37)),
        (0, ReadError.OtherOs(0)),
        (12, ReadError.OtherOs(-12)),
        (99, ReadError.OtherOs(-99)),
        (INT_MIN, ReadError.OtherOs(INT_MIN)),
    ]
    decodes_all(decode_read_error, cases)


private pure func test_read_text() -> Bool:
    cases: List[(ReadError, String)] = [
        (ReadError.NotFound, "no such file"),
        (ReadError.PermissionDenied, "permission denied"),
        (ReadError.NotADirectory, "not a directory"),
        (ReadError.IsADirectory, "is a directory"),
        (ReadError.FileTooLarge, "file too large"),
        (ReadError.InvalidUtf8, "contents are not valid UTF-8"),
        (ReadError.OtherOs(37), "operating system error 37"),
    ]
    texts_all(cases)


