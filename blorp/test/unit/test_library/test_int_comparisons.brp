import:
    io: print_error
    test: TestSuite
    ../../../src/check/check: check
    ../../../src/load/load: load_program
    ../input: setup_diagnostic


-- Use the configured target module, including its ordinary pure helper bodies
-- and selected scalar constants. Native value assertions belong to this main.
func test_target_numeric_API_checks_through_ordinary_imports() -> Bool:
    match load_program("blorp/test/e2e/fixtures/int/comparisons.brp", "blorp/standard_library"):
        Err(failure):
            print_error(failure.diagnostic.message)
            False
        Ok(loaded):
            match check(loaded.program):
                Err(failure):
                    print_error(setup_diagnostic(failure).message)
                    False
                Ok(_): True


tests: TestSuite = {
    description = "Target signed Int library imports",
    tests = [
        (
            "seven numeric functions and both constants check",
            test_target_numeric_API_checks_through_ordinary_imports,
        ),
    ],
}
