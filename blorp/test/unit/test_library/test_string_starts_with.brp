import:
	../../../src/load/load: SourceInputs, load_program
	../../../src/check/check: check
	../../../src/check/render: render_failure
	../../../src/main: render_diagnostics
	../../../src/utils/syntax: Diagnostics, singleton_diagnostic
	io: print_error
	test: TestSuite


private func report_diagnostics(inputs: SourceInputs, errors: Diagnostics) -> Void:
	print_error(render_diagnostics(inputs, errors))
	for error in [errors.first].concat(errors.remaining):
		print_error("diagnostic byte span [" + error.span.start.to_string() + ", " + error.span.end.to_string() + ")")
	void


-- Load the actual target module through its configured library, then check its
-- pure caller. No host library function supplies the behavior under test.
private func checks_fixture(fixture: String) -> Bool:
	match load_program(fixture, "blorp/standard_library"):
		Err(failure):
			report_diagnostics(failure.sources, singleton_diagnostic(failure.diagnostic))
			False
		Ok(loaded):
			match check(loaded.program):
				Err(failure):
					report_diagnostics(loaded.sources, render_failure(failure))
					False
				Ok(_):
					True


func test_string_starts_with_arguments_checks() -> Bool:
	checks_fixture("blorp/test/e2e/fixtures/string_starts_with/arguments.brp")


func test_string_starts_with_counted_aliases_checks() -> Bool:
	checks_fixture("blorp/test/e2e/fixtures/string_starts_with/counted_aliases.brp")


tests: TestSuite = {
	description = "Blorp target string_starts_with module checking",
	tests = [
		("actual target string_starts_with arguments module admission", test_string_starts_with_arguments_checks),
		("actual target string_starts_with counted_aliases module admission", test_string_starts_with_counted_aliases_checks),
	]
}
