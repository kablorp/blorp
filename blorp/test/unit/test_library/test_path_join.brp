import:
    test: TestSuite
    ../../../src/compile/check/check: check
    ../../../src/compile/load/load: LibrarySource(LibraryDirectory), load_program
    ../input: setup_diagnostic


-- Load the actual target module through its configured library, then check its
-- pure caller. No host path function supplies the behavior under test.
private func checks_fixture(fixture: String) -> Bool:
    match load_program(fixture, LibraryDirectory("blorp/standard_library")):
        Err(failure):
            print_error(failure.diagnostic.message)
            False
        Ok(loaded):
            match check(loaded.program):
                Err(failure):
                    print_error(setup_diagnostic(failure).message)
                    False
                Ok(_):
                    True


func test_target_join_can_be_called_from_a_pure_function() -> Bool:
    checks_fixture("blorp/test/e2e/fixtures/path_join/arguments.brp")


func test_counted_alias_fixture_uses_the_same_pure_target_join() -> Bool:
    checks_fixture("blorp/test/e2e/fixtures/path_join/counted_aliases.brp")


TESTS: TestSuite = {
    description = "Blorp target path join purity and checking",
    tests = [
        (
            "actual target join is callable from pure source",
            test_target_join_can_be_called_from_a_pure_function,
        ),
        (
            "counted alias fixture checks through actual target join",
            test_counted_alias_fixture_uses_the_same_pure_target_join,
        ),
    ],
}
