import:
    bool: Bool methods
    dict: Dict, empty
    int: INT_MIN, INT_MAX
    json:
        Json(Null, Boolean, Number, Text, Array, Object),
        JsonNumber,
        MAX_NESTING_DEPTH,
        ParseError,
        ParseErrorKind(
            ExpectedValue,
            ExpectedNull,
            ExpectedTrue,
            ExpectedFalse,
            ExpectedNumberDigit,
            ExpectedFractionDigit,
            ExpectedExponentDigit,
            TrailingNumberData,
            ExpectedArrayDelimiter,
            ExpectedObjectName,
            ExpectedColon,
            ExpectedObjectDelimiter,
            DuplicateName,
            UnclosedString,
            UnescapedControl,
            ExpectedEscape,
            ExpectedHexDigits,
            UnpairedSurrogate,
            TrailingData,
            TooDeep,
        ),
        as_int,
        to_string,
        parse,
        render,
        number,
        number_text,
        integer,
    string: from_codepoint
    test: TestSuite


private pure func test_numeric_id_keeps_every_digit() -> Bool:
    match parse("{\"id\":9007199254740993,\"result\":null}"):
        Ok(Object(fields)):
            match fields.get("id"):
                Some(Number(value)): number_text(value) == "9007199254740993"
                _: False
        _:
            False


private pure func test_surrogate_pair_decodes_to_scalar() -> Bool:
    match parse("\"\\uD834\\uDD1E\""):
        Ok(Text(value)): value == "𝄞"
        _: False


private pure func test_explicit_null_differs_from_absent_name() -> Bool:
    match parse("{\"result\":null}"):
        Ok(Object(fields)):
            present: Bool = match fields.get("result"):
                Some(Null): True
                _: False
            absent: Bool = match fields.get("missing"):
                None: True
                _: False
            present.and(absent)
        _:
            False


private pure func renders(source: String, expected: String) -> Bool:
    match parse(source):
        Err(_):
            False
        Ok(value):
            first = render(value)
            match parse(first):
                Err(_): False
                Ok(reparsed): (first == expected).and(render(reparsed) == expected)


private pure func rejects(source: String, offset: Int, kind: ParseErrorKind) -> Bool:
    match parse(source):
        Ok(_): False
        Err(error): (error.offset == offset).and(error.kind == kind)


private pure func test_scalars_containers_and_whitespace() -> Bool:
    cases: List[(String, String)] = [
        (" \t\r\nnull\r\n", "null"),
        (" true ", "true"),
        (" false ", "false"),
        (" [ ] ", "[]"),
        (" { } ", "{}"),
        ("[null,true,false,[],{}]", "[null,true,false,[],{}]"),
        (
            " { \"b\" : [1, -2.00e+003], \"a\": {\"x\":false} } ",
            "{\"b\":[1,-2.00e+003],\"a\":{\"x\":false}}",
        ),
        ("{\"a\":{\"a\":1}}", "{\"a\":{\"a\":1}}"),
    ]
    var correct: Bool = True
    for (source, expected) in cases:
        correct = correct.and(renders(source, expected))
    correct


private pure func test_numbers_keep_spelling_without_float_conversion() -> Bool:
    var correct: Bool = True
    for spelling in [
        "0",
        "-0",
        "-0.0",
        "9007199254740993",
        "18446744073709551616",
        "1E400",
        "1e-9999",
        "-123.456789012345678901234567890E+003",
    ]:
        match number(spelling):
            Err(_):
                correct = False
            Ok(value):
                correct = correct.and(number_text(value) == spelling)
                correct = correct.and(render(Number(value)) == spelling)
                correct = correct.and(renders(spelling, spelling))
    correct.and(
        (number_text(integer(INT_MIN)) == "-9223372036854775808").and(
            number_text(integer(INT_MAX)) == "9223372036854775807",
        ),
    )


private pure func test_number_constructor_rejects_nonlexemes() -> Bool:
    cases: List[(String, Int, ParseErrorKind)] = [
        ("", 0, ExpectedNumberDigit),
        ("-", 1, ExpectedNumberDigit),
        ("+1", 0, ExpectedNumberDigit),
        ("01", 1, TrailingNumberData),
        (" 1", 0, ExpectedNumberDigit),
        ("1 ", 1, TrailingNumberData),
        ("1e", 2, ExpectedExponentDigit),
        ("1.", 2, ExpectedFractionDigit),
        ("NaN", 0, ExpectedNumberDigit),
        ("Infinity", 0, ExpectedNumberDigit),
    ]
    var correct: Bool = True
    for (source, offset, kind) in cases:
        match number(source):
            Ok(_): correct = False
            Err(error): correct = correct.and((error.offset == offset).and(error.kind == kind))
    correct


private pure func test_all_short_escapes_and_embedded_nul() -> Bool:
    source = "\"\\\"\\\\\\/\\b\\f\\n\\r\\t\\u0000\""
    match parse(source):
        Ok(Text(text)):
            expected = "\"\\/\u{8}\u{C}\n\r\t\0"
            (text == expected).and(renders(source, "\"\\\"\\\\/\\b\\f\\n\\r\\t\\u0000\""))
        _:
            False


private pure func test_unicode_spelling_and_scalar_boundaries() -> Bool:
    cases: List[(String, String)] = [
        ("\"\\u0041\\u00e9\\u00E9\"", "\"Aéé\""),
        ("\"é𝄞😀\"", "\"é𝄞😀\""),
        ("\"\\uD834\\uDd1e\"", "\"𝄞\""),
        ("\"\\ud800\\udc00\"", "\"𐀀\""),
        ("\"\\uDBFF\\uDFFF\"", "\"\u{10FFFF}\""),
        ("\"\\uD7FF\\uE000\"", "\"\u{D7FF}\u{E000}\""),
        ("{\"\\u0061\":\"é\"}", "{\"a\":\"é\"}"),
        ("{\"é\":1,\"e\\u0301\":2}", "{\"é\":1,\"é\":2}"),
    ]
    var correct: Bool = True
    for (source, expected) in cases:
        correct = correct.and(renders(source, expected))
    correct


private pure func test_all_control_bytes_render_and_parse() -> Bool:
    var text = ""
    for point in 0..32:
        match from_codepoint(point):
            Some(character): text = text + character
            None: void
    encoded = render(Text(text))
    match parse(encoded):
        Ok(Text(decoded)): (decoded == text).and(renders(encoded, encoded))
        _: False


private pure func test_rejects_invalid_tokens_and_container_grammar() -> Bool:
    cases: List[(String, Int, ParseErrorKind)] = [
        ("", 0, ExpectedValue),
        (" ", 1, ExpectedValue),
        ("True", 0, ExpectedValue),
        ("tru", 3, ExpectedTrue),
        ("nulx", 3, ExpectedNull),
        ("true false", 5, TrailingData),
        ("/*comment*/null", 0, ExpectedValue),
        ("\u{FEFF}null", 0, ExpectedValue),
        ("\u{A0}null", 0, ExpectedValue),
        ("NaN", 0, ExpectedValue),
        ("Infinity", 0, ExpectedValue),
        ("+1", 0, ExpectedValue),
        (".1", 0, ExpectedValue),
        ("01", 1, TrailingData),
        ("-", 1, ExpectedNumberDigit),
        ("1.", 2, ExpectedFractionDigit),
        ("1e+", 3, ExpectedExponentDigit),
        ("[", 1, ExpectedValue),
        ("[0", 2, ExpectedArrayDelimiter),
        ("[0,]", 3, ExpectedValue),
        ("[0 1]", 3, ExpectedArrayDelimiter),
        ("{", 1, ExpectedObjectName),
        ("{a:0}", 1, ExpectedObjectName),
        ("{\"a\" 0}", 5, ExpectedColon),
        ("{\"a\":}", 5, ExpectedValue),
        ("{\"a\":0,}", 7, ExpectedObjectName),
        ("{\"a\":0 \"b\":1}", 7, ExpectedObjectDelimiter),
        ("[\"é\",x]", 6, ExpectedValue),
        ("null\0", 4, TrailingData),
    ]
    var correct: Bool = True
    for (source, offset, kind) in cases:
        correct = correct.and(rejects(source, offset, kind))
    correct


private pure func test_rejects_bad_escapes_and_unpaired_surrogates() -> Bool:
    cases: List[(String, Int, ParseErrorKind)] = [
        ("\"text", 5, UnclosedString),
        ("\"\\x\"", 1, ExpectedEscape),
        ("\"\\", 2, ExpectedEscape),
        ("\"\n\"", 1, UnescapedControl),
        ("\"\0\"", 1, UnescapedControl),
        ("\"\\u12x4\"", 5, ExpectedHexDigits),
        ("\"\\u12\"", 5, ExpectedHexDigits),
        ("\"\\u12", 5, ExpectedHexDigits),
        ("\"\\uD800\"", 1, UnpairedSurrogate),
        ("\"\\uDEAD\"", 1, UnpairedSurrogate),
        ("\"\\uD800\\u0041\"", 1, UnpairedSurrogate),
        ("\"\\uD800\\uD800\"", 1, UnpairedSurrogate),
        ("\"\\uD800\\uZZZZ\"", 9, ExpectedHexDigits),
    ]
    var correct: Bool = True
    for (source, offset, kind) in cases:
        correct = correct.and(rejects(source, offset, kind))
    correct


private pure func test_duplicate_decoded_object_names_reject_at_second_quote() -> Bool:
    rejects("{\"a\":1,\"a\":2}", 7, DuplicateName).and(
        rejects("{\"a\":1,\"\\u0061\":2}", 7, DuplicateName).and(
            rejects("{\"é\":1,\"\\u00e9\":2}", 8, DuplicateName).and(
                rejects("{\"a\":0,\"a\"", 7, DuplicateName),
            ),
        ),
    )


private pure func test_constructed_tree_roundtrips_and_keeps_object_order() -> Bool:
    var fields: Dict[String, Json] = empty()
    fields = fields.set("b", Array([Null, Boolean(True), Number(integer(-12)), Text("é\0")]))
    fields = fields.set("a", Object(empty()))
    value: Json = Object(fields)
    expected = "{\"b\":[null,true,-12,\"é\\u0000\"],\"a\":{}}"
    (render(value) == expected).and(renders(render(value), expected))


private pure func test_moderate_nesting_and_many_siblings() -> Bool:
    var nested: Json = Null
    var nested_source = "null"
    for _ in 0..96:
        nested = Array([nested])
        nested_source = "[" + nested_source + "]"
    var values: List[Json] = []
    for value in 0..256:
        values = values.append(Number(integer(value)))
    wide: Json = Array(values)
    wide_correct = match parse(render(wide)):
        Ok(Array(found)):
            var correct = found.length() == 256
            for index in 0..256:
                match found.get(index):
                    Some(Number(value)):
                        correct = correct.and(number_text(value) == index.to_string())
                    _:
                        correct = False
            correct
        _:
            False
    renders(render(nested), nested_source).and(wide_correct)


private pure func repeated(piece: String, count: Int) -> String:
    var text = ""
    for _ in 0..count:
        text = text + piece
    text


private pure func test_malformed_numbers_name_their_kind_and_offset() -> Bool:
    cases: List[(String, Int, ParseErrorKind)] = [
        ("-01", 2, TrailingData),
        ("1.e3", 2, ExpectedFractionDigit),
        ("-.5", 1, ExpectedNumberDigit),
        ("0e", 2, ExpectedExponentDigit),
        ("[1E+]", 4, ExpectedExponentDigit),
    ]
    var correct: Bool = True
    for (source, offset, kind) in cases:
        correct = correct.and(rejects(source, offset, kind))
    correct


private pure func test_malformed_unicode_escapes_name_their_kind_and_offset() -> Bool:
    cases: List[(String, Int, ParseErrorKind)] = [
        ("\"\\uDC00\\uD800\"", 1, UnpairedSurrogate),
        ("\"\\uD800\\", 1, UnpairedSurrogate),
        ("\"\\uD800\\u12\"", 11, ExpectedHexDigits),
    ]
    var correct: Bool = True
    for (source, offset, kind) in cases:
        correct = correct.and(rejects(source, offset, kind))
    correct


private pure func test_duplicate_names_that_decode_to_nul_reject() -> Bool:
    rejects("{\"\\u0000\":1,\"\\u0000\":2}", 12, DuplicateName)


private pure func test_trailing_data_after_a_container_rejects() -> Bool:
    rejects("{\"a\":1}x", 7, TrailingData).and(rejects("[1]]", 3, TrailingData))


private pure func test_del_and_line_separator_pass_through_unescaped() -> Bool:
    source = "\"\u{7F}\u{2028}\""
    match parse(source):
        Ok(Text(text)): (text == "\u{7F}\u{2028}").and(renders(source, source))
        _: False


private pure func test_object_names_keep_source_order() -> Bool:
    match parse("{\"b\":1,\"a\":2}"):
        Ok(Object(fields)): fields.keys() == ["b", "a"]
        _: False


private pure func nested_arrays(levels: Int) -> String:
    repeated("[", levels) + repeated("]", levels)


private pure func test_nesting_up_to_the_limit_parses_and_roundtrips() -> Bool:
    below = nested_arrays(MAX_NESTING_DEPTH - 1)
    at_limit = nested_arrays(MAX_NESTING_DEPTH)
    objects = repeated("{\"a\":", MAX_NESTING_DEPTH) + "null" + repeated("}", MAX_NESTING_DEPTH)
    renders(below, below).and(renders(at_limit, at_limit).and(renders(objects, objects)))


private pure func test_nesting_past_the_limit_is_too_deep_at_the_bracket() -> Bool:
    arrays = nested_arrays(MAX_NESTING_DEPTH + 1)
    objects = (
        repeated("{\"a\":", MAX_NESTING_DEPTH + 1)
        + "null"
        + repeated("}", MAX_NESTING_DEPTH + 1)
    )
    mixed = (
        repeated("[{\"a\":", MAX_NESTING_DEPTH / 2)
        + "[]"
        + repeated("}]", MAX_NESTING_DEPTH / 2)
    )
    rejects(arrays, MAX_NESTING_DEPTH, TooDeep).and(
        rejects(objects, 5 * MAX_NESTING_DEPTH, TooDeep).and(
            rejects(mixed, 6 * (MAX_NESTING_DEPTH / 2), TooDeep),
        ),
    )


private pure func test_hostile_unclosed_nesting_stops_at_the_limit() -> Bool:
    rejects(repeated("[", 100000), MAX_NESTING_DEPTH, TooDeep)


private pure func test_ten_thousand_siblings_parse_and_roundtrip() -> Bool:
    source = "[" + repeated("0,", 9999) + "0]"
    match parse(source):
        Ok(Array(found)): (found.length() == 10000).and(renders(source, source))
        _: False


private pure func test_hundred_kilobyte_escaped_string_roundtrips() -> Bool:
    repetitions = 12500
    -- Each piece is 8 source bytes (about 100 KB in all) and decodes to 5.
    source = "\"" + repeated("ab\\n\\\"\\t", repetitions) + "\""
    match parse(source):
        Ok(Text(text)):
            (text.length() == repetitions * 5).and(
                (source.length() == repetitions * 8 + 2).and(renders(source, source)),
            )
        _:
            False


private pure func test_multibyte_characters_next_to_escapes_roundtrip() -> Bool:
    -- Rendering cuts its literal runs at escapes; none may split a character.
    source = "\"é\\\"ü\\\\𝄞\\n\u{7F}é\\t\u{2028}\""
    match parse(source):
        Ok(Text(text)): (text == "é\"ü\\𝄞\n\u{7F}é\t\u{2028}").and(renders(source, source))
        _: False


private pure func test_as_int_accepts_only_whole_integer_lexemes_in_range() -> Bool:
    cases: List[(String, Option[Int])] = [
        ("0", Some(0)),
        ("-0", Some(0)),
        ("42", Some(42)),
        ("-17", Some(-17)),
        ("9223372036854775807", Some(INT_MAX)),
        ("-9223372036854775808", Some(INT_MIN)),
        ("9223372036854775808", None),
        ("-9223372036854775809", None),
        ("18446744073709551616", None),
        ("1.5", None),
        ("1.0", None),
        ("-0.0", None),
        ("1e3", None),
        ("1E+2", None),
        ("5e-1", None),
    ]
    var correct: Bool = True
    for (spelling, expected) in cases:
        match number(spelling):
            Err(_): correct = False
            Ok(value): correct = correct.and(value.as_int() == expected)
    correct


private pure func test_interpolation_and_to_string_agree_on_a_parse_error() -> Bool:
    error: ParseError = { offset = 3, kind = ExpectedColon }
    ("${error}" == "expected ':' after object name").and(
        error.to_string() == "expected ':' after object name",
    )


private pure func test_to_string_words_each_error_kind() -> Bool:
    cases: List[(ParseErrorKind, String)] = [
        (ExpectedValue, "expected a JSON value"),
        (ExpectedNull, "expected 'null'"),
        (ExpectedTrue, "expected 'true'"),
        (ExpectedFalse, "expected 'false'"),
        (ExpectedNumberDigit, "expected a digit in JSON number"),
        (ExpectedFractionDigit, "expected a digit after decimal point"),
        (ExpectedExponentDigit, "expected a digit in exponent"),
        (TrailingNumberData, "unexpected data after JSON number"),
        (ExpectedArrayDelimiter, "expected ',' or ']' after array value"),
        (ExpectedObjectName, "expected a quoted object name"),
        (ExpectedColon, "expected ':' after object name"),
        (ExpectedObjectDelimiter, "expected ',' or '}' after object value"),
        (DuplicateName, "duplicate object name"),
        (UnclosedString, "expected closing quote for JSON string"),
        (UnescapedControl, "control character must be escaped in JSON string"),
        (ExpectedEscape, "expected a JSON escape after backslash"),
        (ExpectedHexDigits, "expected four hexadecimal digits after \\u"),
        (UnpairedSurrogate, "unpaired Unicode surrogate"),
        (TrailingData, "unexpected data after JSON value"),
        (TooDeep, "JSON nesting is deeper than ${MAX_NESTING_DEPTH.to_string()} levels"),
    ]
    var correct: Bool = True
    for (kind, wording) in cases:
        error: ParseError = { offset = 0, kind = kind }
        correct = correct.and(error.to_string() == wording)
    correct


tests: TestSuite = {
    description = "Pure JSON codec",
    tests = [
        (
            "malformed numbers name their kind and offset",
            test_malformed_numbers_name_their_kind_and_offset,
        ),
        (
            "malformed Unicode escapes name their kind and offset",
            test_malformed_unicode_escapes_name_their_kind_and_offset,
        ),
        (
            "names decoding to NUL reject as duplicates",
            test_duplicate_names_that_decode_to_nul_reject,
        ),
        ("trailing data after a container rejects", test_trailing_data_after_a_container_rejects),
        (
            "DEL and U+2028 pass through unescaped",
            test_del_and_line_separator_pass_through_unescaped,
        ),
        ("object names keep source order", test_object_names_keep_source_order),
        (
            "nesting up to the limit parses and roundtrips",
            test_nesting_up_to_the_limit_parses_and_roundtrips,
        ),
        (
            "nesting past the limit is TooDeep at the bracket",
            test_nesting_past_the_limit_is_too_deep_at_the_bracket,
        ),
        (
            "hostile unclosed nesting stops at the limit",
            test_hostile_unclosed_nesting_stops_at_the_limit,
        ),
        (
            "ten thousand siblings parse and roundtrip",
            test_ten_thousand_siblings_parse_and_roundtrip,
        ),
        ("a 100 KB escaped string roundtrips", test_hundred_kilobyte_escaped_string_roundtrips),
        (
            "as_int accepts only whole integer lexemes in range",
            test_as_int_accepts_only_whole_integer_lexemes_in_range,
        ),
        (
            "multibyte characters next to escapes roundtrip",
            test_multibyte_characters_next_to_escapes_roundtrip,
        ),
        ("to_string words each error kind", test_to_string_words_each_error_kind),
        (
            "interpolation and to_string agree on a parse error",
            test_interpolation_and_to_string_agree_on_a_parse_error,
        ),
        ("numeric IDs keep every decimal digit", test_numeric_id_keeps_every_digit),
        ("UTF-16 surrogate pair becomes one scalar", test_surrogate_pair_decodes_to_scalar),
        (
            "explicit null differs from an absent object name",
            test_explicit_null_differs_from_absent_name,
        ),
        ("all value kinds and JSON whitespace roundtrip", test_scalars_containers_and_whitespace),
        (
            "number spelling survives without Float conversion",
            test_numbers_keep_spelling_without_float_conversion,
        ),
        (
            "number constructor rejects nonlexemes with exact errors",
            test_number_constructor_rejects_nonlexemes,
        ),
        ("all JSON short escapes and embedded NUL decode", test_all_short_escapes_and_embedded_nul),
        (
            "Unicode scalar boundaries and spellings roundtrip",
            test_unicode_spelling_and_scalar_boundaries,
        ),
        ("every control byte renders and parses", test_all_control_bytes_render_and_parse),
        (
            "invalid token and container grammar errors have exact byte offsets",
            test_rejects_invalid_tokens_and_container_grammar,
        ),
        (
            "bad escapes and unpaired surrogate errors are exact",
            test_rejects_bad_escapes_and_unpaired_surrogates,
        ),
        (
            "duplicate decoded names reject at their second quote",
            test_duplicate_decoded_object_names_reject_at_second_quote,
        ),
        (
            "constructed values roundtrip with object order",
            test_constructed_tree_roundtrips_and_keeps_object_order,
        ),
        ("moderate nesting and sibling width roundtrip", test_moderate_nesting_and_many_siblings),
    ],
}
