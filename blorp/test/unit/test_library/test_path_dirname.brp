import:
    io: print_error
    test: TestSuite
    ../../../src/compile/check/check: check
    ../../../src/compile/check/render: render_failure
    ../../../src/compile/load/load: LibrarySource(LibraryDirectory), SourceInputs, load_program
    ../../../src/main: render_diagnostics
    ../../../src/syntax/syntax: Diagnostics, singleton_diagnostic


private func report_diagnostics(inputs: SourceInputs, errors: Diagnostics) -> Void:
    print_error(render_diagnostics(inputs, errors))
    for error in [errors.first].concat(errors.remaining):
        print_error(
            (
                "diagnostic byte span ["
                + error.span.start.to_string()
                + ", "
                + error.span.end.to_string()
                + ")"
            ),
        )
    void


-- Load the actual target module through its configured library, then check its
-- pure caller. No host path function supplies the behavior under test.
private func checks_fixture(fixture: String) -> Bool:
    match load_program(fixture, LibraryDirectory("blorp/standard_library")):
        Err(failure):
            report_diagnostics(failure.sources, singleton_diagnostic(failure.diagnostic))
            False
        Ok(loaded):
            match check(loaded.program):
                Err(failure):
                    report_diagnostics(loaded.sources, render_failure(failure))
                    False
                Ok(_):
                    True


func test_pure_dirname_and_counted_alias_routes_check() -> Bool:
    checks_fixture("blorp/test/e2e/fixtures/path_dirname/edges.brp")


tests: TestSuite = {
    description = "Blorp target dirname purity and checking",
    tests = [
        (
            "actual target dirname supports pure, named, UFCS and counted alias routes",
            test_pure_dirname_and_counted_alias_routes_check,
        ),
    ],
}
