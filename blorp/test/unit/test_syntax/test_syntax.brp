import:
    bool: and, not
    int as int_ops
    option: is_none
    test: TestSuite
    ../../../src/syntax/names: contextual_words, program_names
    ../../../src/syntax/source: compiler_source, module_source, root_module_id
    ../../../src/syntax/syntax:
        Visibility(Public),
        ExpressionBase(IntegerExpression),
        LexedProgram,
        ParsedBinding,
        ParsedMatchArm,
        ParsedPattern(PatternWildcard),
        ParsedStatement(BindingStatement),
        ParsedUnion,
        ParsedVariant,
        Purity(Pure, Impure),
        NameForm(LowerSnake),
        Spacing(Adjacent),
        Span,
        Token,
        TokenKind(IdentifierToken),
        ValueExpression,
        WrittenName,
        TypeSyntax(AtomicType),
        type_span,
        compiler_span,
        internal_error,
        or_internal_error,


pure func test_token_update_preserves_original_payload_and_span() -> Bool:
    seed = program_names()
    other = contextual_words(seed.names).fixed_word
    original: Token = {
        kind = IdentifierToken(seed.main, LowerSnake),
        span = { source = module_source(root_module_id()), start = 5, end = 9 },
        spacing = Adjacent,
    }
    changed: Token = { original | kind = IdentifierToken(other, LowerSnake) }

    match original.kind:
        IdentifierToken(name, _):
            match changed.kind:
                IdentifierToken(changed_name, _):
                    and(
                        name == seed.main,
                        and(
                            changed_name == other,
                            and(
                                int_ops.equals(original.span.start, 5),
                                and(
                                    int_ops.equals(original.span.end, 9),
                                    and(
                                        int_ops.equals(changed.span.start, 5),
                                        int_ops.equals(changed.span.end, 9),
                                    ),
                                ),
                            ),
                        ),
                    )
                _:
                    False
        _:
            False


pure func test_published_tokens_are_independent_of_local_builder() -> Bool:
    seed = program_names()
    first: Token = {
        kind = IdentifierToken(seed.main, LowerSnake),
        span = { source = module_source(root_module_id()), start = 0, end = 4 },
        spacing = Adjacent,
    }
    var builder: List[Token] = [first]
    published: LexedProgram = {
        source_text = "main",
        tokens = builder,
        end = { source = module_source(root_module_id()), start = 4, end = 4 },
        base_names = seed.names,
        names = seed.names,
    }
    builder = builder.append({
        kind = IdentifierToken(seed.main, LowerSnake),
        span = { source = module_source(root_module_id()), start = 5, end = 9 },
        spacing = Adjacent,
    })
    and(
        int_ops.equals(published.tokens.length(), 1),
        and(
            int_ops.equals(builder.length(), 2),
            and(int_ops.equals(published.end.start, 4), int_ops.equals(published.end.end, 4)),
        ),
    )


pure func test_union_publication_and_expression_updates_preserve_original() -> Bool:
    name: WrittenName = {
        id = program_names().main,
        span = { source = module_source(root_module_id()), start = 12, end = 15 },
    }
    variant: ParsedVariant = { name = name, fields = [] }
    var variants: List[ParsedVariant] = [variant]
    published: ParsedUnion = {
        start = name.span,
        module = root_module_id(),
        visibility = Public,
        type_name = name,
        type_parameters = [],
        variants = variants,
        fixed = False,
    }
    variants = variants.append(
        { variant |
            fields = [AtomicType(name)],
            name = { name |
                span = { source = module_source(root_module_id()), start = 20, end = 23 },
            },
        },
    )
    original: ValueExpression = {
        base = IntegerExpression(42),
        base_span = { source = module_source(root_module_id()), start = 21, end = 23 },
        applications = [],
        parentheses = [],
        span = { source = module_source(root_module_id()), start = 21, end = 23 },
    }
    changed: ValueExpression = { original | base = IntegerExpression(-42) }

    payloads_unchanged = match published.variants:
        [first]:
            match first.fields:
                []:
                    match variants:
                        [_, second]:
                            match second.fields:
                                [field]:
                                    and(
                                        int_ops.equals(type_span(field).start, 12),
                                        int_ops.equals(type_span(field).end, 15),
                                    )
                                _:
                                    False
                        _:
                            False
                _:
                    False
        _:
            False

    match original.base:
        IntegerExpression(original_value):
            match changed.base:
                IntegerExpression(changed_value):
                    if and(
                        int_ops.equals(original_value, 42),
                        and(int_ops.equals(changed_value, -42), payloads_unchanged),
                    ):
                        match published.variants.get(0):
                            Some(first):
                                and(
                                    int_ops.equals(published.variants.length(), 1),
                                    and(
                                        int_ops.equals(variants.length(), 2),
                                        and(
                                            int_ops.equals(first.name.span.start, 12),
                                            and(
                                                int_ops.equals(original.span.start, 21),
                                                and(
                                                    int_ops.equals(original.span.end, 23),
                                                    and(
                                                        int_ops.equals(changed.span.start, 21),
                                                        int_ops.equals(changed.span.end, 23),
                                                    ),
                                                ),
                                            ),
                                        ),
                                    ),
                                )
                            None:
                                False
                    else:
                        False
                _:
                    False
        _:
            False


pure func test_arm_binding_publication_is_independent_of_builder() -> Bool:
    span: Span = { source = module_source(root_module_id()), start = 10, end = 12 }
    value: ValueExpression = {
        base = IntegerExpression(42),
        base_span = span,
        applications = [],
        parentheses = [],
        span = span,
    }
    binding: ParsedBinding = {
        name = { id = program_names().main, span = span },
        annotation = None,
        mutable = True,
        initializer = value,
    }
    var bindings: List[ParsedBinding] = [binding]
    arm: ParsedMatchArm = {
        pattern = PatternWildcard(span),
        block = {
            statements = bindings.map(pure func(item): BindingStatement(item)),
            value = Some(value),
            span = span,
        },
        span = span,
    }
    bindings = bindings.append(binding)
    and(
        int_ops.equals(arm.block.statements.length(), 1),
        and(int_ops.equals(bindings.length(), 2), int_ops.equals(arm.block.span.start, 10)),
    )


pure func test_purity_equality_covers_each_variant_pair() -> Bool:
    pure_value: Purity = Pure
    impure_value: Purity = Impure
    and(
        pure_value == Pure,
        and(impure_value == Impure, and(pure_value != Impure, impure_value != Pure)),
    )


pure func test_internal_error_names_the_compiler_as_its_origin() -> Bool:
    span = compiler_span()
    error = internal_error(span, "missing row")
    and(
        and(
            error.span.source == compiler_source(),
            and(error.span.start == 0, error.span.end == 0),
        ),
        and(
            and(
                error.message == "internal compiler error: missing row",
                error.help == "report this compiler error with the input program",
            ),
            error.note.is_none(),
        ),
    )


pure func test_a_present_fact_is_returned_and_a_missing_one_is_an_internal_error() -> Bool:
    span = compiler_span()
    present: Option[Int] = Some(7)
    missing: Option[Int] = None
    found: Bool = match present.or_internal_error(span, "missing row"):
        Ok(value): value == 7
        Err(_): False
    absent: Bool = match missing.or_internal_error(span, "missing row"):
        Ok(_): False
        Err(error): error == internal_error(span, "missing row")
    and(found, absent)


TESTS: TestSuite = {
    description = "Blorp syntax data",
    tests = [
        ("purity equality covers each pair", test_purity_equality_covers_each_variant_pair),
        (
            "arm bindings publish independently of builder",
            test_arm_binding_publication_is_independent_of_builder,
        ),
        (
            "published union and updated expression preserve original",
            test_union_publication_and_expression_updates_preserve_original,
        ),
        ("token update preserves original", test_token_update_preserves_original_payload_and_span),
        (
            "internal error names the compiler as its origin",
            test_internal_error_names_the_compiler_as_its_origin,
        ),
        (
            "a present fact is returned and a missing one is an internal error",
            test_a_present_fact_is_returned_and_a_missing_one_is_an_internal_error,
        ),
        (
            "published tokens are independent of builder",
            test_published_tokens_are_independent_of_local_builder,
        ),
    ],
}
