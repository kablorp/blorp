import:
    bool: and
    int: Int methods
    list: List methods
    option: Option methods
    string: String methods
    test: TestSuite
    ../../../../src/syntax/lex: lex
    ../../../../src/syntax/names: program_names
    ../../../../src/syntax/parse: ParsedModule, module_contents, parse_module
    ../../../../src/syntax/source: module_source, root_module_id
    ../../../../src/syntax/syntax:
        Diagnostic,
        Span,
        ValueExpression,
        ParsedDictEntry,
        ExpressionBase(
            DictExpression,
            RecordExpression,
            RecordUpdateExpression,
            ArithmeticExpression,
            StringExpression,
            IntegerExpression,
            NameExpression,
        ),
        ParsedBody(ParsedValueBody),
    ../../parse_function_inputs: free_functions


-- HEADER is 20 bytes, so a body written as "\t..." starts at byte 21.
private HEADER: String = "func main() -> Int:\n"
private FAT_ARROW: String = "'=>' is not an operator"
private FAT_ARROW_HELP: String = "write '>=' to compare, or 'func(x): expr' for a lambda"
private BRACED: String = "expected '|' or '=>' after the first expression in braces"


private BRACED_HELP: String = "write { record | field = value } to update a record, or { key => value } for a Dict"


private ENTRY_END: String = "expected ',' or '}' after the Dict entry"


private ENTRY_END_HELP: String = "separate Dict entries with commas, then close the literal with '}'"


private MISSING_KEY: String = "expected a key before '=>'"
private MISSING_KEY_HELP: String = "write { key => value }; every Dict entry starts with its key"


private pure func parse_source(source: String) -> Result[ParsedModule, Diagnostic]:
    tokens ?= lex(module_source(root_module_id()), source, program_names().names)
    parse_module(tokens, root_module_id())


private pure func value(source: String) -> Option[ValueExpression]:
    match parse_source(HEADER + source):
        Err(_): None
        Ok(parsed):
            match free_functions(module_contents(parsed).functions).get(0).map(
                pure func(function): function.body,
            ):
                Some(ParsedValueBody(body)): Some(body)
                _: None


private pure func entries(source: String) -> Option[List[ParsedDictEntry]]:
    match value(source):
        Some(body):
            match body.base:
                DictExpression(written): Some(written)
                _: None
        None: None


private pure func rejects(
    source: String,
    start: Int,
    end: Int,
    message: String,
    help: String,
) -> Bool:
    match parse_source(HEADER + source):
        Ok(_): False
        Err(error):
            error.span.start
                .equals(start)
                .and(error.span.end.equals(end))
                .and(error.message == message)
                .and(error.help == help)
                .and(error.note.is_none())


private pure func spans(span: Span, start: Int, end: Int) -> Bool:
    span.start.equals(start).and(span.end.equals(end))


private pure func integer_entry(entry: ParsedDictEntry, key: Int, stored: Int) -> Bool:
    match (entry.key.base, entry.value.base):
        (IntegerExpression(written_key), IntegerExpression(written_value)):
            (written_key == key).and(written_value == stored)
        _: False


-- `{}` is an empty Dict, not an empty record, and spans both braces.
pure func test_empty_braces_are_an_empty_dict() -> Bool:
    match value("\t{}\n"):
        Some(body):
            match body.base:
                DictExpression([]): spans(body.base_span, 21, 23).and(spans(body.span, 21, 23))
                _: False
        None: False


pure func test_one_entry_keeps_key_and_value_spans() -> Bool:
    match value("\t{\"a\" => 1}\n"):
        Some(body):
            match body.base:
                DictExpression([entry]):
                    key: Bool = match entry.key.base:
                        StringExpression(text): text == "a"
                        _: False
                    key
                        .and(spans(entry.key.span, 22, 25))
                        .and(spans(entry.value.span, 29, 30))
                        .and(spans(body.base_span, 21, 31))
                _: False
        None: False


pure func test_entries_keep_source_order() -> Bool:
    match entries("\t{3 => 30, 1 => 10, 2 => 20}\n"):
        Some([first, second, third]):
            integer_entry(first, 3, 30)
                .and(integer_entry(second, 1, 10))
                .and(integer_entry(third, 2, 20))
        _: False


pure func test_trailing_comma_and_line_breaks_are_accepted() -> Bool:
    one_line: Bool = match entries("\t{1 => 10, 2 => 20,}\n"):
        Some([first, second]): integer_entry(first, 1, 10).and(integer_entry(second, 2, 20))
        _: False
    broken: Bool = match entries("\t{\n\t\t1 => 10,\n\t\t2 => 20,\n\t}\n"):
        Some([first, second]): integer_entry(first, 1, 10).and(integer_entry(second, 2, 20))
        _: False
    one_line.and(broken)


pure func test_record_literal_and_update_keep_their_forms() -> Bool:
    literal: Bool = match value("\t{ first = 7 }\n"):
        Some(body):
            match body.base:
                RecordExpression([_]): True
                _: False
        None: False
    update: Bool = match value("\t{ base | first = 7 }\n"):
        Some(body):
            match body.base:
                RecordUpdateExpression(_, [_]): True
                _: False
        None: False
    literal.and(update)


pure func test_values_may_be_dicts() -> Bool:
    match entries("\t{\"a\" => {\"b\" => 1}, \"c\" => {}}\n"):
        Some([outer, empty]):
            nested: Bool = match outer.value.base:
                DictExpression([inner]):
                    match inner.value.base:
                        IntegerExpression(written): written == 1
                        _: False
                _: False
            empty_value: Bool = match empty.value.base:
                DictExpression([]): True
                _: False
            nested.and(empty_value)
        _: False


-- A key is any expression: the first one decides the braced form.
pure func test_keys_are_arbitrary_expressions() -> Bool:
    match entries("\t{n + 1 => \"x\", n => \"y\"}\n"):
        Some([sum, name]):
            arithmetic: Bool = match sum.key.base:
                ArithmeticExpression(_, _, _, _): spans(sum.key.span, 22, 27)
                _: False
            named: Bool = match name.key.base:
                NameExpression(_): True
                _: False
            arithmetic.and(named)
        _: False


-- Outside a Dict entry `=>` keeps the lexer's former teaching message, where
-- a comparison, a lambda arrow or an argument expected something else.
pure func test_stray_fat_arrow_teaches_comparison_and_lambda() -> Bool:
    rejects("\ta => b\n", 23, 25, FAT_ARROW, FAT_ARROW_HELP)
        .and(rejects("\ta=>b\n", 22, 24, FAT_ARROW, FAT_ARROW_HELP))
        .and(rejects("\tapply(func(x: Int) => x)\n", 40, 42, FAT_ARROW, FAT_ARROW_HELP))
        .and(rejects("\tf(a => b)\n", 25, 27, FAT_ARROW, FAT_ARROW_HELP))
        .and(rejects("\t[a => b]\n", 24, 26, FAT_ARROW, FAT_ARROW_HELP))
        .and(rejects("\t{a | x => 1}\n", 28, 30, FAT_ARROW, FAT_ARROW_HELP))


pure func test_entry_without_value_names_the_missing_arrow() -> Bool:
    rejects(
        "\t{\"a\" => 1, \"b\"}\n",
        35,
        36,
        "expected '=>' after the Dict key",
        "write key => value; every Dict entry needs a value",
    )


-- A second `=>` in one entry is Dict syntax, not a comparison or lambda.
pure func test_entries_need_commas() -> Bool:
    rejects("\t{1 => 10 2 => 20}\n", 30, 31, ENTRY_END, ENTRY_END_HELP).and(
        rejects("\t{\"a\" => 1 => 2}\n", 31, 33, ENTRY_END, ENTRY_END_HELP),
    )


pure func test_entries_need_keys() -> Bool:
    rejects("\t{=> 1}\n", 22, 24, MISSING_KEY, MISSING_KEY_HELP).and(
        rejects("\t{1 => 2, => 3}\n", 30, 32, MISSING_KEY, MISSING_KEY_HELP),
    )


-- After the first expression only `|` or `=>` can follow, and the error names both.
pure func test_other_braced_forms_name_update_and_dict() -> Bool:
    rejects("\t{\"a\": 1}\n", 25, 26, BRACED, BRACED_HELP)
        .and(rejects("\t{1, 2}\n", 23, 24, BRACED, BRACED_HELP))
        .and(rejects("\t{x}\n", 23, 24, BRACED, BRACED_HELP))


tests: TestSuite = {
    description = "Dict literal syntax",
    tests = [
        ("{} is an empty Dict", test_empty_braces_are_an_empty_dict),
        ("one entry keeps its key and value spans", test_one_entry_keeps_key_and_value_spans),
        ("entries keep source order", test_entries_keep_source_order),
        (
            "a trailing comma and line breaks are accepted",
            test_trailing_comma_and_line_breaks_are_accepted,
        ),
        (
            "record literals and updates keep their forms",
            test_record_literal_and_update_keep_their_forms,
        ),
        ("values may be Dicts", test_values_may_be_dicts),
        ("keys are arbitrary expressions", test_keys_are_arbitrary_expressions),
        (
            "a stray '=>' teaches comparison and lambda forms",
            test_stray_fat_arrow_teaches_comparison_and_lambda,
        ),
        (
            "an entry without a value names the missing '=>'",
            test_entry_without_value_names_the_missing_arrow,
        ),
        ("entries need commas", test_entries_need_commas),
        ("entries need keys", test_entries_need_keys),
        (
            "other braced forms name the update and Dict forms",
            test_other_braced_forms_name_update_and_dict,
        ),
    ],
}
