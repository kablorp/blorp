import:
    test: TestSuite
    ../../../../src/compile/assemble: parsed_contents
    ../../../../src/compile/ids: inventory_functions
    ../../../../src/syntax/syntax:
        ParsedBody(ParsedBuiltinBody),
        ParsedRuntimeOperation(SystemBuiltin),
        SystemOperation(
            FsListDirectory,
            FsCreateDirectory,
            FsCreateDirectories,
            FsRemoveFile,
            FsRemoveDirectory,
            FsRename,
            FsRemoveDirectoryTree,
            FsCreateTemporaryDirectory,
        ),
    ../../module_input: parse_modules


-- The label is spelled out here, so the test does not follow system_operation_label.
-- Parsing a label does not check the signature, so every label shares one.
private pure func label_parses_to(label: String, expected: SystemOperation) -> Bool:
    source = "func operate(path: String) -> Result[Void, Int]:\n    builtin(\"${label}\")\nfunc main() -> Int:\n    0\n"
    match parse_modules([{ source = source, targets = [] }]):
        Err(_): False
        Ok(program):
            match inventory_functions(parsed_contents(program).declarations).get(0):
                Some(row):
                    match row.declaration.body:
                        ParsedBuiltinBody(SystemBuiltin(parsed), _): parsed == expected
                        _: False
                None: False


pure func test_list_directory_label() -> Bool:
    label_parses_to("fs.list_directory", FsListDirectory)


pure func test_create_directory_label() -> Bool:
    label_parses_to("fs.create_directory", FsCreateDirectory)


pure func test_create_directories_label() -> Bool:
    label_parses_to("fs.create_directories", FsCreateDirectories)


pure func test_remove_file_label() -> Bool:
    label_parses_to("fs.remove_file", FsRemoveFile)


pure func test_remove_directory_label() -> Bool:
    label_parses_to("fs.remove_directory", FsRemoveDirectory)


pure func test_rename_label() -> Bool:
    label_parses_to("fs.rename", FsRename)


pure func test_remove_directory_tree_label() -> Bool:
    label_parses_to("fs.remove_directory_tree", FsRemoveDirectoryTree)


pure func test_create_temporary_directory_label() -> Bool:
    label_parses_to("fs.create_temporary_directory", FsCreateTemporaryDirectory)


tests: TestSuite = {
    description = "Blorp fs directory labels",
    tests = [
        ("fs.list_directory parses to FsListDirectory", test_list_directory_label),
        ("fs.create_directory parses to FsCreateDirectory", test_create_directory_label),
        ("fs.create_directories parses to FsCreateDirectories", test_create_directories_label),
        ("fs.remove_file parses to FsRemoveFile", test_remove_file_label),
        ("fs.remove_directory parses to FsRemoveDirectory", test_remove_directory_label),
        ("fs.rename parses to FsRename", test_rename_label),
        (
            "fs.remove_directory_tree parses to FsRemoveDirectoryTree",
            test_remove_directory_tree_label,
        ),
        (
            "fs.create_temporary_directory parses to FsCreateTemporaryDirectory",
            test_create_temporary_directory_label,
        ),
    ],
}
