import:
    bool: and
    int: Int methods
    list: List methods
    result: and_then
    string: String methods
    test: TestSuite
    ../../../../src/syntax/lex: lex
    ../../../../src/syntax/names: program_names
    ../../../../src/syntax/parse: module_contents, parse_module
    ../../../../src/syntax/source: module_source, root_module_id
    ../../../../src/syntax/syntax:
        Diagnostic,
        ExpressionBase(
            ArithmeticExpression,
            DirectApplication,
            IfExpression,
            IntegerExpression,
            InterpolatedString,
            NameExpression,
            NegationExpression,
            TupleExpression,
        ),
        ElseBranch,
        ParsedBody(ParsedValueBody),
        ParsedFunction,
        ParsedFunctionGroup(FreeFunction),
        ParsedStatement(ExpressionStatement, WhileLoop),
        PostfixOperation(FieldAccess, ReceiverInvocation),
        ValueExpression,


private HEADER: String = "func main() -> Int:\n"


private EXPRESSION_HELP: String = "use a literal, a parameter or variant name, or a call as the entire body"


-- The only function in `source`, parsed on its own.
private pure func only_function(source: String) -> Option[ParsedFunction]:
    parsed = lex(module_source(root_module_id()), source, program_names().names).and_then(
        pure func(tokens): parse_module(tokens, root_module_id()),
    )
    match parsed:
        Ok(module):
            match module_contents(module).functions:
                [FreeFunction(function)]: Some(function)
                _: None
        Err(_):
            None


private pure func only_value(source: String) -> Option[ValueExpression]:
    match only_function(source):
        Some(function):
            match function.body:
                ParsedValueBody(value): Some(value)
                _: None
        None:
            None


private pure func rejects(
    source: String,
    start: Int,
    end: Int,
    message: String,
    help: String,
) -> Bool:
    parsed = lex(module_source(root_module_id()), source, program_names().names).and_then(
        pure func(tokens): parse_module(tokens, root_module_id()),
    )
    match parsed:
        Err(diagnostic):
            and(
                and(diagnostic.span.start == start, diagnostic.span.end == end),
                and(diagnostic.message == message, diagnostic.help == help),
            )
        Ok(_):
            False


-- The recorded pairs, outermost first, as `start..end` offsets.
private pure func pair_offsets(value: ValueExpression) -> List[String]:
    value.parentheses.map(pure func(pair): "${pair.start}..${pair.end}")


-- Parentheses group one expression: the grouped expression is the result,
-- with its span widened to the parentheses and the pair recorded.
pure func test_parentheses_group_a_literal() -> Bool:
    match only_value(HEADER + "\t( 7 )\n"):
        Some(value):
            match value.base:
                IntegerExpression(number):
                    and(
                        and(
                            number == 7,
                            and(
                                value.applications.length() == 0,
                                pair_offsets(value) == ["21..26"],
                            ),
                        ),
                        and(
                            and(value.base_span.start == 23, value.base_span.end == 24),
                            and(value.span.start == 21, value.span.end == 26),
                        ),
                    )
                _:
                    False
        None:
            False


pure func test_postfix_operations_follow_the_closing_parenthesis() -> Bool:
    match only_value(HEADER + "\t(f(1).first).second\n"):
        Some(value):
            match (value.base, value.applications):
                (DirectApplication(_, arguments), [FieldAccess(_), FieldAccess(_)]):
                    and(arguments.length() == 1, and(value.span.start == 21, value.span.end == 40))
                _:
                    False
        None:
            False


pure func test_grouped_expression_may_span_lines() -> Bool:
    source: String = "\t(\n\t\t7\n\t)\n"

    match only_value(HEADER + source):
        Some(value):
            match value.base:
                IntegerExpression(number):
                    and(number == 7, and(value.span.start == 21, value.span.end == 29))
                _:
                    False
        None:
            False


-- The formatter keeps the pair around `1 + 2`; the tree shape alone cannot say it.
pure func test_group_records_its_parentheses_on_the_grouped_operand() -> Bool:
    match only_value(HEADER + "\t(1 + 2) * 3\n"):
        Some(value):
            match value.base:
                ArithmeticExpression(_, _, left, right):
                    and(
                        pair_offsets(left) == ["21..28"],
                        and(right.parentheses.is_empty(), value.parentheses.is_empty()),
                    )
                _:
                    False
        None:
            False


pure func test_nested_groups_record_both_pairs_outermost_first() -> Bool:
    match only_value(HEADER + "\t((7))\n"):
        Some(value):
            match value.base:
                IntegerExpression(number):
                    and(
                        number == 7,
                        and(
                            pair_offsets(value) == ["21..26", "22..25"],
                            and(value.base_span.start == 23, value.base_span.end == 24),
                        ),
                    )
                _:
                    False
        None:
            False


pure func test_group_before_a_postfix_call_stays_one_application_list() -> Bool:
    match only_value(HEADER + "\t(x).f()\n"):
        Some(value):
            match (value.base, value.applications):
                (NameExpression(_), [ReceiverInvocation(_)]): pair_offsets(value) == ["21..24"]
                _: False
        None:
            False


-- A tuple is not a group, so it records no pair.
pure func test_tuple_records_no_parentheses() -> Bool:
    match only_value(HEADER + "\t(1, 2)\n"):
        Some(value):
            match value.base:
                TupleExpression(elements):
                    and(
                        value.parentheses.is_empty(),
                        elements.all(pure func(element): element.parentheses.is_empty()),
                    )
                _:
                    False
        None:
            False


-- Only `-5` folds; `-(5)` stays a negation, and the formatter sees the pair.
pure func test_negated_group_keeps_its_tree_and_records_the_pair() -> Bool:
    match only_value(HEADER + "\t-(5)\n"):
        Some(value):
            match value.base:
                NegationExpression(_, operand):
                    match operand.base:
                        IntegerExpression(number):
                            and(
                                number == 5,
                                and(
                                    value.parentheses.is_empty(),
                                    pair_offsets(operand) == ["22..25"],
                                ),
                            )
                        _:
                            False
                _:
                    False
        None:
            False


-- The inner pair covers only `a` although the value has an application; each
-- pair's span, not its list position, says what it wraps.
pure func test_group_inside_a_group_with_a_postfix_keeps_each_span() -> Bool:
    match only_value(HEADER + "\t((a).f())\n"):
        Some(value):
            match (value.base, value.applications):
                (NameExpression(_), [ReceiverInvocation(_)]):
                    and(
                        pair_offsets(value) == ["21..30", "22..25"],
                        and(value.span.start == 21, value.span.end == 30),
                    )
                _:
                    False
        None:
            False


-- A group opening a statement line is read through the parenthesized-line path.
pure func test_group_at_the_start_of_a_statement_is_recorded() -> Bool:
    match only_function(HEADER + "\t(1 + 2) * 3\n\t0\n"):
        Some(function):
            match function.statements:
                [ExpressionStatement(value)]:
                    match value.base:
                        ArithmeticExpression(_, _, left, _): pair_offsets(left) == ["21..28"]
                        _: False
                _:
                    False
        None:
            False


pure func test_parenthesized_if_condition_is_recorded() -> Bool:
    match only_value(HEADER + "\tif (1 == 1):\n\t\t0\n\telse:\n\t\t1\n"):
        Some(value):
            match value.base:
                IfExpression(parsed): pair_offsets(parsed.condition) == ["24..32"]
                _: False
        None:
            False


pure func test_parenthesized_while_condition_is_recorded() -> Bool:
    match only_function(HEADER + "\twhile (1 == 1):\n\t\tbreak\n\t0\n"):
        Some(function):
            match function.statements:
                [WhileLoop(loop)]: pair_offsets(loop.condition) == ["27..35"]
                _: False
        None:
            False


pure func test_parenthesized_interpolation_hole_is_recorded() -> Bool:
    match only_value(HEADER + "\t\"$" + "{(a)}\"\n"):
        Some(value):
            match value.base:
                InterpolatedString(parts):
                    parts.any(pure func(part): pair_offsets(part) == ["24..27"])
                _:
                    False
        None:
            False


pure func test_empty_parentheses_are_not_an_expression() -> Bool:
    rejects(HEADER + "\t()\n", 22, 23, "expected a return expression", EXPRESSION_HELP)


pure func test_unclosed_group_is_reported_at_the_next_token() -> Bool:
    rejects(
        HEADER + "\t(7 8)\n",
        24,
        25,
        "expected ')' after the grouped expression",
        "close the parentheses after one expression; UFCS and field reads may follow ')'",
    )


TESTS: TestSuite = {
    description = "Blorp grouping parentheses",
    tests = [
        ("parentheses group a literal", test_parentheses_group_a_literal),
        (
            "postfix operations follow the closing parenthesis",
            test_postfix_operations_follow_the_closing_parenthesis,
        ),
        ("grouped expression may span lines", test_grouped_expression_may_span_lines),
        (
            "group records its parentheses on the grouped operand",
            test_group_records_its_parentheses_on_the_grouped_operand,
        ),
        (
            "nested groups record both pairs outermost first",
            test_nested_groups_record_both_pairs_outermost_first,
        ),
        (
            "group before a postfix call stays one application list",
            test_group_before_a_postfix_call_stays_one_application_list,
        ),
        ("tuple records no parentheses", test_tuple_records_no_parentheses),
        (
            "negated group keeps its tree and records the pair",
            test_negated_group_keeps_its_tree_and_records_the_pair,
        ),
        (
            "group inside a group with a postfix keeps each span",
            test_group_inside_a_group_with_a_postfix_keeps_each_span,
        ),
        (
            "group at the start of a statement is recorded",
            test_group_at_the_start_of_a_statement_is_recorded,
        ),
        ("parenthesized if condition is recorded", test_parenthesized_if_condition_is_recorded),
        (
            "parenthesized while condition is recorded",
            test_parenthesized_while_condition_is_recorded,
        ),
        (
            "parenthesized interpolation hole is recorded",
            test_parenthesized_interpolation_hole_is_recorded,
        ),
        ("empty parentheses are not an expression", test_empty_parentheses_are_not_an_expression),
        (
            "unclosed group is reported at the next token",
            test_unclosed_group_is_reported_at_the_next_token,
        ),
    ],
}
