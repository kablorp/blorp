import:
    bool: and
    option: Option methods
    result: and_then, is_ok
    test: TestSuite
    ../../../../src/syntax/lex: lex
    ../../../../src/syntax/names: program_names
    ../../../../src/syntax/parse: ParsedModule, parse_module
    ../../../../src/syntax/source: module_source, root_module_id
    ../../../../src/syntax/syntax: Diagnostic, LexedProgram


private pure func accepts(source: String) -> Bool:
    lex(module_source(root_module_id()), source, program_names().names)
        .and_then(
            pure func(tokens: LexedProgram) -> Result[ParsedModule, Diagnostic]: parse_module(
                tokens,
                root_module_id(),
            ),
        )
        .is_ok()


pure func test_copy_sign_label_is_accepted() -> Bool:
    source: String =
        |pure func copy_sign(value: Float, sign: Float) -> Float:
        |    builtin("float.copysign")
        |func main() -> Int:
        |    0
        |
    accepts(source)


pure func test_equality_label_is_accepted() -> Bool:
    source: String =
        |pure func equal(first: Float, second: Float) -> Bool:
        |    builtin("float.equals")
        |
    accepts(source)


pure func test_ordering_label_is_accepted() -> Bool:
    source: String =
        |pure func ordered(first: Float, second: Float) -> Bool:
        |    builtin("float.less_than")
        |
    accepts(source)


private BUILTIN_LABEL_HELP: String = "use system.get_current_directory, system.current_directory, process.run_to_files, process.capture, process.find_program, process.fault, fs.read_text, fs.write_text, fs.entry_kind, fs.list_directory, fs.create_directory, fs.create_directories, fs.remove_file, fs.remove_directory, fs.rename, fs.remove_directory_tree, fs.create_temporary_directory, fs.open_read, fs.next_lines, fs.close, int.equals, int.less_than, int.add, int.subtract, int.multiply, int.divide, int.remainder, int.to_string, float.add, float.subtract, float.multiply, float.divide, float.remainder, float.to_string, float.copysign, float.equals, float.less_than, string.length, string.add, string.append_int, string.print, string.print_error, string.parse_int, string.parse_float, string.byte_at, string.from_codepoint, string.slice, string.equals, list.repeat, list.length, list.get, list.append, list.set or list.concat"


private pure func rejects_removed_label(label: String) -> Bool:
    prefix = "pure func classify(value: Float) -> Bool:\n    builtin("
    quoted = "\"${label}\""
    source = "${prefix}${quoted})\n"
    parsed = lex(module_source(root_module_id()), source, program_names().names).and_then(
        pure func(tokens: LexedProgram) -> Result[ParsedModule, Diagnostic]: parse_module(
            tokens,
            root_module_id(),
        ),
    )
    match parsed:
        Ok(_):
            False
        Err(error):
            and(
                and(error.message == "unknown builtin operation", error.help == BUILTIN_LABEL_HELP),
                and(
                    (
                        error.span
                        == {
                            source = module_source(root_module_id()),
                            start = prefix.length(),
                            end = prefix.length() + (quoted.length()),
                        }
                    ),
                    error.note.is_none(),
                ),
            )


pure func test_nan_builtin_is_rejected() -> Bool:
    rejects_removed_label("float.is_nan")


pure func test_finite_builtin_is_rejected() -> Bool:
    rejects_removed_label("float.is_finite")


TESTS: TestSuite = {
    description = "Blorp required Float builtin labels",
    tests = [
        ("copy sign label is accepted", test_copy_sign_label_is_accepted),
        ("equality label is accepted", test_equality_label_is_accepted),
        ("ordering label is accepted", test_ordering_label_is_accepted),
        ("NaN builtin has exact unknown-operation diagnostic", test_nan_builtin_is_rejected),
        ("finite builtin has exact unknown-operation diagnostic", test_finite_builtin_is_rejected),
    ],
}
