import:
    bool: and, not
    int: Int methods
    list: List methods
    option: Option methods
    string: String methods
    test: TestSuite
    ../../../../src/syntax/lex: lex
    ../../../../src/syntax/names: program_names
    ../../../../src/syntax/parse: ParsedModule, module_contents, parse_module
    ../../../../src/syntax/source: module_source, root_module_id
    ../../../../src/syntax/syntax:
        Diagnostic,
        ParsedBinder(NamedBinder, DiscardBinder),
        ParsedParameter,
    ../../parse_function_inputs: free_functions


-- `_` is a discard in a function, method or requirement signature, as in a
-- lambda: it takes an argument and binds no name, and may repeat.

private pure func parse_source(source: String) -> Result[ParsedModule, Diagnostic]:
    tokens ?= lex(module_source(root_module_id()), source, program_names().names)
    parse_module(tokens, root_module_id())


private pure func is_discard(parameter: ParsedParameter) -> Bool:
    match parameter.binder:
        DiscardBinder(_): True
        NamedBinder(_): False


-- Whether the first free function's parameters are discards exactly as `expected`.
private pure func discards_are(source: String, expected: List[Bool]) -> Bool:
    match parse_source(source):
        Err(_):
            False
        Ok(parsed):
            match free_functions(module_contents(parsed).functions).get(0):
                Some(function): function.parameters.map(is_discard) == expected
                None: False


private pure func accepts(source: String) -> Bool:
    match parse_source(source):
        Ok(_): True
        Err(_): False


private pure func rejects(
    source: String,
    start: Int,
    end: Int,
    message: String,
    help: String,
) -> Bool:
    match parse_source(source):
        Ok(_):
            False
        Err(error):
            error.span.start
                .equals(start)
                .and(error.span.end.equals(end))
                .and(error.message == message)
                .and(error.help == help)


pure func test_a_function_may_take_several_discard_parameters() -> Bool:
    discards_are("func pick(_: Int, value: Int, _: String) -> Int:\n    value\n", [
        True,
        False,
        True,
    ])


pure func test_a_requirement_and_its_implementation_may_take_discard_parameters() -> Bool:
    accepted = "trait Pick:\n    pure func pick(value: Self, _: Int, _: Int) -> Int\n"
    implemented = "implements Pick for Int:\n    pure func pick(value: Self, _: Int, _: Int) -> Int:\n        value\n"
    accepts(accepted).and(accepts(implemented))


pure func test_using_a_discard_parameter_in_the_body_is_refused() -> Bool:
    rejects(
        "func f(_: Int) -> Int:\n    _\n",
        27,
        28,
        "`_` is not a value",
        "use a named value or void; use _ only as a binder or pattern",
    )


pure func test_a_discard_parameter_may_have_a_function_type() -> Bool:
    discards_are("func f(_: (Int) -> Int, value: Int) -> Int:\n    value\n", [True, False])


pure func test_a_record_field_cannot_be_a_discard() -> Bool:
    rejects(
        "record Point {\n    _: Int,\n}\n",
        19,
        20,
        "expected a record field name",
        "use an ASCII identifier starting with a letter; keywords and lone '_' are reserved",
    )


TESTS: TestSuite = {
    description = "Discarded parameters",
    tests = [
        (
            "a function may take several discard parameters",
            test_a_function_may_take_several_discard_parameters,
        ),
        (
            "a requirement and its implementation may take discard parameters",
            test_a_requirement_and_its_implementation_may_take_discard_parameters,
        ),
        (
            "using a discard parameter in the body is refused",
            test_using_a_discard_parameter_in_the_body_is_refused,
        ),
        (
            "a discard parameter may have a function type",
            test_a_discard_parameter_may_have_a_function_type,
        ),
        ("a record field cannot be a discard", test_a_record_field_cannot_be_a_discard),
    ],
}
