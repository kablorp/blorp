import:
    bool: and
    int: Int methods
    string as string_ops
    test: TestSuite
    ../../../../src/syntax/lex: lex
    ../../../../src/syntax/names: program_names
    ../../../../src/syntax/parse: ParsedModule, parse_module
    ../../../../src/syntax/source: module_source, root_module_id
    ../../../../src/syntax/syntax: Diagnostic


-- A declared name in the wrong form is a parse error at the name, naming the
-- role and the form, with the converted spelling as help. A used name is never
-- checked, except a member after a dot.

private pure func parse_source(source: String) -> Result[ParsedModule, Diagnostic]:
    tokens ?= lex(module_source(root_module_id()), source, program_names().names)
    parse_module(tokens, root_module_id())


-- `marked` sits between `prefix` and `suffix`; the error spans exactly it.
private pure func rejects_marked(
    prefix: String,
    marked: String,
    suffix: String,
    message: String,
    help: String,
) -> Bool:
    match parse_source(prefix + marked + suffix):
        Ok(_):
            False
        Err(error):
            error.span.start
                .equals(prefix.length())
                .and(error.span.end.equals(prefix.length() + marked.length()))
                .and(string_ops.equals(error.message, message))
                .and(string_ops.equals(error.help, help))


private pure func accepts_source(source: String) -> Bool:
    match parse_source(source):
        Ok(_): True
        Err(_): False


private CAMEL: String = "CapitalizedCamelCase"

private SNAKE: String = "lower_snake_case"

private UPPER: String = "UPPER_SNAKE_CASE"


pure func test_a_union_name_is_a_type() -> Bool:
    rejects_marked(
        "union ",
        "shape_kind",
        ":\n\tCircle\n\tSquare\n",
        "a type is written in ${CAMEL}",
        "write `ShapeKind`",
    )


pure func test_a_record_name_is_a_type() -> Bool:
    rejects_marked(
        "record ",
        "point_2d",
        " {\n\tx: Int,\n}\n",
        "a type is written in ${CAMEL}",
        "write `Point2d`",
    )


pure func test_an_opaque_name_is_a_type() -> Bool:
    rejects_marked(
        "opaque type ",
        "user_id",
        " = Int\n",
        "a type is written in ${CAMEL}",
        "write `UserId`",
    )


pure func test_a_variant_name_is_a_variant() -> Bool:
    rejects_marked(
        "union ShapeKind:\n\t",
        "circle",
        "\n\tSquare\n",
        "a variant is written in ${CAMEL}",
        "write `Circle`",
    )


pure func test_a_variant_payload_declares_no_names() -> Bool:
    accepts_source("union Shape:\n\tCircle(Int)\n\tSquare(Int, Int)\n")


pure func test_a_trait_name_is_a_trait() -> Bool:
    rejects_marked(
        "trait ",
        "shown",
        ":\n\tfunc show(value: Self) -> String\n",
        "a trait is written in ${CAMEL}",
        "write `Shown`",
    )


pure func test_a_type_parameter_is_a_type_parameter() -> Bool:
    rejects_marked(
        "func f[",
        "t",
        "](value: t) -> t:\n\tvalue\n",
        "a type parameter is written in ${CAMEL}",
        "write `T`",
    ).and(
        rejects_marked(
            "func f[",
            "T_",
            "](value: T_) -> T_:\n\tvalue\n",
            "a type parameter is written in ${CAMEL}",
            "write `T`",
        ),
    )


pure func test_a_constant_is_upper_snake_case() -> Bool:
    rejects_marked(
        "",
        "lower_constant",
        ": Int = 3\n",
        "a constant is written in ${UPPER}",
        "write `LOWER_CONSTANT`",
    ).and(
        rejects_marked(
            "",
            "MaxDepth",
            ": Int = 3\n",
            "a constant is written in ${UPPER}",
            "write `MAX_DEPTH`",
        ),
    )


pure func test_a_lowercase_suite_constant_is_told_to_write_tests() -> Bool:
    rejects_marked(
        "import:\n\ttest: TestSuite\n",
        "tests",
        ": TestSuite = { description = \"d\", tests = [] }\n",
        "a constant is written in ${UPPER}",
        "write `TESTS`",
    )


pure func test_a_function_name_is_a_function() -> Bool:
    rejects_marked(
        "func ",
        "Area",
        "() -> Int:\n\t0\n",
        "a function is written in ${SNAKE}",
        "write `area`",
    ).and(
        rejects_marked(
            "func ",
            "readFile",
            "() -> Int:\n\t0\n",
            "a function is written in ${SNAKE}",
            "write `read_file`",
        ),
    )


pure func test_a_parameter_is_a_parameter() -> Bool:
    rejects_marked(
        "func f(",
        "Width",
        ": Int) -> Int:\n\t0\n",
        "a parameter is written in ${SNAKE}",
        "write `width`",
    )


pure func test_a_lambda_parameter_is_a_parameter() -> Bool:
    rejects_marked(
        "func f() -> Int:\n\tg = pure func(",
        "Item",
        "): 1\n\t0\n",
        "a parameter is written in ${SNAKE}",
        "write `item`",
    )


pure func test_a_record_field_is_a_field() -> Bool:
    rejects_marked(
        "record Point {\n\t",
        "X",
        ": Int,\n}\n",
        "a field is written in ${SNAKE}",
        "write `x`",
    )


pure func test_a_local_is_a_local() -> Bool:
    rejects_marked(
        "func f() -> Int:\n\t",
        "Kind",
        " = 1\n\t0\n",
        "a local is written in ${SNAKE}",
        "write `kind`",
    )


pure func test_a_var_binding_is_a_local() -> Bool:
    rejects_marked(
        "func f() -> Int:\n\tvar ",
        "Count",
        " = 1\n\t0\n",
        "a local is written in ${SNAKE}",
        "write `count`",
    )


pure func test_a_propagating_binder_is_a_local() -> Bool:
    rejects_marked(
        "func f() -> Result[Int, Int]:\n\t",
        "Value",
        " ?= Ok(1)\n\tOk(Value)\n",
        "a local is written in ${SNAKE}",
        "write `value`",
    )


pure func test_a_loop_binder_is_a_local() -> Bool:
    rejects_marked(
        "func f(items: List[Int]) -> Int:\n\tfor ",
        "Item",
        " in items:\n\t\tvoid\n\t0\n",
        "a local is written in ${SNAKE}",
        "write `item`",
    )


pure func test_a_tuple_destructuring_binder_is_a_local() -> Bool:
    rejects_marked(
        "func f() -> Int:\n\t(",
        "First",
        ", second) = (1, 2)\n\t0\n",
        "a local is written in ${SNAKE}",
        "write `first`",
    )


pure func test_a_capitalized_name_in_a_for_tuple_binder_is_refused_as_a_local() -> Bool:
    rejects_marked(
        "func f(pairs: List[(Int, Int)]) -> Int:\n\tfor (",
        "Key",
        ", value) in pairs:\n\t\tvoid\n\t0\n",
        "a local is written in ${SNAKE}",
        "write `key`",
    )


pure func test_a_leading_underscore_parameter_is_refused_with_the_name_without_it() -> Bool:
    rejects_marked(
        "func f(",
        "_count",
        ": Int) -> Int:\n\t0\n",
        "a parameter is written in ${SNAKE}",
        "write `count`",
    )


pure func test_a_list_pattern_rest_is_a_local() -> Bool:
    rejects_marked(
        "func f(items: List[Int]) -> Int:\n\tmatch items:\n\t\t[...",
        "Rest",
        "]: 0\n\t\t_: 1\n",
        "a local is written in ${SNAKE}",
        "write `rest`",
    )


pure func test_a_pattern_binder_is_a_local_but_a_capital_may_be_a_variant() -> Bool:
    rejects_marked(
        "func f(value: Option[Int]) -> Int:\n\tmatch value:\n\t\tSome(",
        "badName",
        "): 0\n\t\tNone: 1\n",
        "a local is written in ${SNAKE}",
        "write `bad_name`",
    ).and(
        accepts_source(
            "func f(value: Option[Int]) -> Int:\n\tmatch value:\n\t\tSome(n): n\n\t\tNone: 1\n",
        ),
    )


pure func test_an_import_alias_is_an_import_alias() -> Bool:
    rejects_marked(
        "import:\n\tint as ",
        "IntOps",
        "\n",
        "a module alias is written in ${SNAKE}",
        "write `int_ops`",
    )


pure func test_a_member_after_a_dot_is_lower_snake_case() -> Bool:
    rejects_marked(
        "func f(x: Int) -> Int:\n\tx.",
        "Foo",
        "\n",
        "fields and methods are lower_snake_case",
        "write `foo`",
    ).and(
        rejects_marked(
            "func f(x: Int) -> Int:\n\tx.",
            "Foo",
            "()\n",
            "fields and methods are lower_snake_case",
            "write `foo`",
        ),
    )


pure func test_conforming_names_and_the_discard_are_accepted() -> Bool:
    accepts_source("MAX: Int = 3\n\nT_LIMIT: Int = 4\n")
        .and(accepts_source("func f[T, IO2](value: T) -> T:\n\tvalue\n"))
        .and(accepts_source("record Point2d {\n\tx: Int,\n}\n"))
        .and(accepts_source("func f(items: List[Int]) -> Int:\n\tfor _ in items:\n\t\tvoid\n\t0\n"))
        .and(accepts_source("func f() -> Int:\n\t(_, second) = (1, 2)\n\tsecond\n"))


pure func test_the_first_bad_name_is_the_one_reported() -> Bool:
    rejects_marked(
        "union ",
        "shape_kind",
        ":\n\tcircle\n\tSquare\n",
        "a type is written in ${CAMEL}",
        "write `ShapeKind`",
    )


TESTS: TestSuite = {
    description = "Declared name case rules",
    tests = [
        ("a union name is a type", test_a_union_name_is_a_type),
        ("a record name is a type", test_a_record_name_is_a_type),
        ("an opaque name is a type", test_an_opaque_name_is_a_type),
        ("a variant name is a variant", test_a_variant_name_is_a_variant),
        ("a variant payload declares no names", test_a_variant_payload_declares_no_names),
        ("a trait name is a trait", test_a_trait_name_is_a_trait),
        ("a type parameter is a type parameter", test_a_type_parameter_is_a_type_parameter),
        ("a constant is upper snake case", test_a_constant_is_upper_snake_case),
        (
            "a lowercase suite constant is told to write TESTS",
            test_a_lowercase_suite_constant_is_told_to_write_tests,
        ),
        ("a function name is a function", test_a_function_name_is_a_function),
        ("a parameter is a parameter", test_a_parameter_is_a_parameter),
        ("a lambda parameter is a parameter", test_a_lambda_parameter_is_a_parameter),
        ("a record field is a field", test_a_record_field_is_a_field),
        ("a local is a local", test_a_local_is_a_local),
        ("a var binding is a local", test_a_var_binding_is_a_local),
        ("a propagating binder is a local", test_a_propagating_binder_is_a_local),
        ("a loop binder is a local", test_a_loop_binder_is_a_local),
        ("a tuple destructuring binder is a local", test_a_tuple_destructuring_binder_is_a_local),
        (
            "a capitalized name in a for tuple binder is refused as a local",
            test_a_capitalized_name_in_a_for_tuple_binder_is_refused_as_a_local,
        ),
        (
            "a leading underscore parameter is refused with the name without it",
            test_a_leading_underscore_parameter_is_refused_with_the_name_without_it,
        ),
        ("a list pattern rest is a local", test_a_list_pattern_rest_is_a_local),
        (
            "a pattern binder is a local but a capital may be a variant",
            test_a_pattern_binder_is_a_local_but_a_capital_may_be_a_variant,
        ),
        ("an import alias is an import alias", test_an_import_alias_is_an_import_alias),
        ("a member after a dot is lower snake case", test_a_member_after_a_dot_is_lower_snake_case),
        (
            "conforming names and the discard are accepted",
            test_conforming_names_and_the_discard_are_accepted,
        ),
        ("the first bad name is the one reported", test_the_first_bad_name_is_the_one_reported),
    ],
}
