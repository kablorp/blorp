import:
    bool: and, not
    list: List methods
    string as string_ops
    test: TestSuite
    ../../../src/syntax/naming:
        NameRole(
            DeclaredType,
            DeclaredVariant,
            DeclaredTrait,
            DeclaredTypeParameter,
            DeclaredConstant,
            DeclaredFunction,
            DeclaredParameter,
            DeclaredLocal,
            DeclaredField,
            DeclaredImportAlias,
        ),
        accepts,
        misnamed_help,
        misnamed_message,
    ../../../src/syntax/syntax:
        NameForm(CapitalizedCamel, LowerSnake, Malformed, SingleCapitalWord, UpperSnake),


pure func test_types_variants_traits_and_type_parameters_take_camel_case() -> Bool:
    roles: List[NameRole] = [DeclaredType, DeclaredVariant, DeclaredTrait, DeclaredTypeParameter]
    roles.all(pure func(role):
        accepts(role, CapitalizedCamel)
            .and(accepts(role, SingleCapitalWord))
            .and(accepts(role, LowerSnake).not())
            .and(accepts(role, UpperSnake).not())
            .and(accepts(role, Malformed).not())
    )


pure func test_constants_take_upper_snake_case() -> Bool:
    accepts(DeclaredConstant, UpperSnake)
        .and(accepts(DeclaredConstant, SingleCapitalWord))
        .and(accepts(DeclaredConstant, CapitalizedCamel).not())
        .and(accepts(DeclaredConstant, LowerSnake).not())
        .and(accepts(DeclaredConstant, Malformed).not())


pure func test_everything_else_takes_lower_snake_case() -> Bool:
    roles: List[NameRole] = [
        DeclaredFunction,
        DeclaredParameter,
        DeclaredLocal,
        DeclaredField,
        DeclaredImportAlias,
    ]
    roles.all(pure func(role):
        accepts(role, LowerSnake)
            .and(accepts(role, SingleCapitalWord).not())
            .and(accepts(role, CapitalizedCamel).not())
            .and(accepts(role, UpperSnake).not())
            .and(accepts(role, Malformed).not())
    )


pure func test_messages_name_the_role_and_the_form() -> Bool:
    string_ops.equals(misnamed_message(DeclaredType), "a type is written in CapitalizedCamelCase")
        .and(
            string_ops.equals(
                misnamed_message(DeclaredConstant),
                "a constant is written in UPPER_SNAKE_CASE",
            ),
        )
        .and(
            string_ops.equals(
                misnamed_message(DeclaredImportAlias),
                "a module alias is written in lower_snake_case",
            ),
        )
        .and(
            string_ops.equals(
                misnamed_message(DeclaredTypeParameter),
                "a type parameter is written in CapitalizedCamelCase",
            ),
        )


pure func test_conversion_to_lower_snake_case_splits_words() -> Bool:
    string_ops.equals(misnamed_help(DeclaredLocal, "ReadError"), "write `read_error`")
        .and(string_ops.equals(misnamed_help(DeclaredLocal, "IOError"), "write `io_error`"))
        .and(string_ops.equals(misnamed_help(DeclaredLocal, "UInt8"), "write `u_int8`"))
        .and(string_ops.equals(misnamed_help(DeclaredLocal, "a__b"), "write `a_b`"))
        .and(string_ops.equals(misnamed_help(DeclaredLocal, "_x"), "write `x`"))
        .and(string_ops.equals(misnamed_help(DeclaredLocal, "a_"), "write `a`"))
        .and(string_ops.equals(misnamed_help(DeclaredLocal, "mixedCase"), "write `mixed_case`"))
        .and(string_ops.equals(misnamed_help(DeclaredLocal, "X"), "write `x`"))
        .and(string_ops.equals(misnamed_help(DeclaredLocal, "HTTP_2"), "write `http_2`"))


pure func test_conversion_to_upper_snake_case_upper_cases_the_words() -> Bool:
    string_ops.equals(misnamed_help(DeclaredConstant, "lower_constant"), "write `LOWER_CONSTANT`")
        .and(string_ops.equals(misnamed_help(DeclaredConstant, "tests"), "write `TESTS`"))
        .and(string_ops.equals(misnamed_help(DeclaredConstant, "MaxDepth"), "write `MAX_DEPTH`"))


pure func test_conversion_to_camel_case_capitalizes_each_word() -> Bool:
    string_ops.equals(misnamed_help(DeclaredType, "shape_kind"), "write `ShapeKind`")
        .and(string_ops.equals(misnamed_help(DeclaredVariant, "circle"), "write `Circle`"))
        .and(string_ops.equals(misnamed_help(DeclaredType, "mixedCase"), "write `MixedCase`"))
        .and(string_ops.equals(misnamed_help(DeclaredType, "HTTP_2"), "write `Http2`"))


pure func test_a_rewrite_that_is_a_reserved_word_is_not_suggested() -> Bool:
    string_ops.equals(
        misnamed_help(DeclaredLocal, "If"),
        "`if` is a reserved word; choose another name",
    )


pure func test_a_name_with_no_leading_letter_has_no_rewrite() -> Bool:
    string_ops.equals(
        misnamed_help(DeclaredLocal, "__"),
        "start the name with a letter and write it in lower_snake_case",
    ).and(
        string_ops.equals(
            misnamed_help(DeclaredConstant, "_1x"),
            "start the name with a letter and write it in UPPER_SNAKE_CASE",
        ),
    )


TESTS: TestSuite = {
    description = "Declared name roles",
    tests = [
        (
            "types, variants, traits and type parameters take camel case",
            test_types_variants_traits_and_type_parameters_take_camel_case,
        ),
        ("constants take upper snake case", test_constants_take_upper_snake_case),
        ("everything else takes lower snake case", test_everything_else_takes_lower_snake_case),
        ("messages name the role and the form", test_messages_name_the_role_and_the_form),
        (
            "conversion to lower snake case splits words",
            test_conversion_to_lower_snake_case_splits_words,
        ),
        (
            "conversion to upper snake case upper-cases the words",
            test_conversion_to_upper_snake_case_upper_cases_the_words,
        ),
        (
            "conversion to camel case capitalizes each word",
            test_conversion_to_camel_case_capitalizes_each_word,
        ),
        (
            "a rewrite that is a reserved word is not suggested",
            test_a_rewrite_that_is_a_reserved_word_is_not_suggested,
        ),
        (
            "a name with no leading letter has no rewrite",
            test_a_name_with_no_leading_letter_has_no_rewrite,
        ),
    ],
}
