import:
	../../../src/namespace/builtins as Builtins
	../../../src/verify/verify: verify
	../../../src/own/own as Own
	../../../src/specialize/specialize as Concrete: function_number
	../../../src/utils/syntax: entry_function
	../source_while_inputs as Input
	../nested_while_inputs as Nested
	test: TestSuite


private pure func first_loop(operations: List[Own.OwnershipOperation]) -> Option[Own.OwnedLoop]:
	var found: Option[Own.OwnedLoop] = None
	for operation in operations:
		match operation:
			Own.ExecuteLoop(loop):
				found = Some(loop)
				break
			_: void
	found


private pure func first_concat_owner(operations: List[Own.OwnershipOperation]) -> Option[Own.OwnerId]:
	var found: Option[Own.OwnerId] = None
	for operation in operations:
		match operation:
			Own.ExecuteLoop(_): break
			Own.DefineValue(definition):
				match (definition.operation, definition.result):
					(Own.CallDefinition(Concrete.RuntimeFunction(Builtins.StringConcat), _), Own.OwnedResult(owner)):
						found = Some(owner)
						break
					_: void
			_: void
	found


private pure func terminations(operations: List[Own.OwnershipOperation], owner: Own.OwnerId) -> Int:
	var count = 0
	for operation in operations:
		match operation:
			Own.DropOwner(id, _):
				if Own.owner_number(id) == Own.owner_number(owner):
					count = count + 1
			Own.DefineValue(definition):
				match definition.operation:
					Own.CallDefinition(Concrete.RuntimeFunction(Builtins.StringConcat), [Own.ConsumedArgument(_, id), _]):
						if Own.owner_number(id) == Own.owner_number(owner):
							count = count + 1
					_: void
			_: void
	count


private pure func nested_pre_facts() -> Option[Bool]:
	lowered ?= Input.lowered(Nested.MANAGED_PRE).to_option()
	program ?= Own.own(lowered).to_option()
	function ?= program.functions.get(function_number(entry_function(program.entrypoint)))
	outer ?= first_loop(function.operations)
	pre ?= first_concat_owner(function.operations)
	match outer.body.tail:
		Own.ExitLoop(_): None
		Own.MatchLoop(branch):
			body ?= branch.arms.get(0)
			local ?= first_concat_owner(body.body.operations)
			inner ?= first_loop(body.body.operations)
			match inner.body.tail:
				Own.ExitLoop(_): None
				Own.MatchLoop(inner_branch):
					var preserved = True
					for arm in inner_branch.arms:
						preserved = (preserved and terminations(arm.body.operations, pre) == 0
							and terminations(arm.body.operations, local) == 0)
					Some(preserved and terminations(function.operations, pre) == 1
						and terminations(body.body.operations, local) == 1
						and terminations(outer.body.operations, pre) == 0
						and terminations(inner.body.operations, pre) == 0
						and terminations(inner.body.operations, local) == 0 and verify(program).is_ok())


pure func test_nested_edges_preserve_both_function_and_outer_iteration_pre() -> Bool:
	nested_pre_facts().get_or(False)


tests: TestSuite = {
	description = "Blorp 2 nested scalar while ownership",
	tests = [("inner edges preserve function and outer iteration PRE", test_nested_edges_preserve_both_function_and_outer_iteration_pre)]
}
