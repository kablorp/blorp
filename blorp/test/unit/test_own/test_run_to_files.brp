import:
	../../../src/lower/lower as Lower
	../../../src/own/own as Own
	../run_to_files_inputs: process_seed
	../module_input: test_base
	int: Int methods
	bool: Bool methods
	test: TestSuite


pure func test_inputs_borrow_and_result_transfers_once() -> Bool:
	match process_seed(test_base()):
		Err(_): False
		Ok(seed):
			match Own.insert_function(seed.query, Lower.lowered_functions(seed.lowered).unions, []):
				Err(_): False
				Ok(function):
					match (function.operations, function.result):
						([_, _, _, _, _, Own.DefineValue(result)], Own.OwnedReturn(returned, moved)):
							match (result.operation, result.result):
								(Own.CallDefinition(_, [Own.BorrowedArgument(_), Own.BorrowedArgument(_), Own.BorrowedArgument(_), Own.BorrowedArgument(_), Own.UnmanagedArgument(_)]), Own.OwnedResult(owner)):
									Lower.value_number(returned).equals(Lower.value_number(result.id)).and(Own.owner_number(owner).equals(Own.owner_number(moved)))
								_: False
						_: False


tests: TestSuite = {
	description = "Process builtin ownership",
	tests = [("four borrowed inputs one unmanaged input one owned Result", test_inputs_borrow_and_result_transfers_once)]
}
