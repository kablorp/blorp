import:
    ../../src/compile/assemble: ParsedProgram, parsed_contents
    ../../src/compile/check/check: check
    ../../src/compile/check/constants: constant_annotations, validate_constants
    ../../src/compile/check/declarations: validate_declarations
    ../../src/compile/check/errors: CheckError
    ../../src/compile/check/model: CheckedConstant
    ../../src/compile/lower/lower as lower
    ../../src/compile/namespace/namespace: Namespace
    ../../src/compile/own/own as own
    ../../src/compile/specialize/specialize as specialized
    ../../src/syntax/syntax: Diagnostic
    ./input: prepare_signatures, accepted_traits, setup_diagnostic
    ./module_input: parse_modules


-- Two uses materialize independently. The unused constant must create nothing.
TWICE: String =
    |private UNUSED: String = "absent"
    |private TEXT: String = "kept λ"
    |func main() -> Int:
    |    first = TEXT
    |    second = TEXT
    |    0
    |


AGGREGATE_TWICE: String =
    |record Box { text: String }
    |VALUE: Box = { text = "kept λ" }
    |func main() -> Int:
    |    first = VALUE
    |    second = VALUE
    |    0
    |


NAMED_CALLBACK: String =
    |pure func identity[T](value: T) -> T:
    |    value
    |CALLBACK: pure (Int) -> Int = identity
    |func main() -> Int:
    |    saved = CALLBACK
    |    0
    |


pure func concrete(source: String) -> Result[specialized.SpecializedProgram, Diagnostic]:
    parsed ?= parse_modules([{ source = source, targets = [] }])
    checked ?= check(parsed).map_err(setup_diagnostic)
    specialized.specialize(checked)


pure func lowered(source: String) -> Result[lower.LoweredProgram, Diagnostic]:
    concrete(source).and_then(pure func(program): lower.lower(program))


pure func owned(source: String) -> Result[own.OwnershipProgram, Diagnostic]:
    lowered(source).and_then(pure func(program): own.own(program))


-- Phase observers see actual declaration rows, including unused initializers.
pure func admitted_constants(
    program: ParsedProgram,
    namespace: Namespace,
) -> Result[List[CheckedConstant], CheckError]:
    parsed = parsed_contents(program)
    declarations ?= validate_declarations(parsed, namespace)
    annotations ?= constant_annotations(parsed, namespace)
    prepared ?= prepare_signatures(program, namespace)
    signatures = prepared.signatures
    traits ?= accepted_traits(program, namespace, prepared, declarations)
    validate_constants(
        parsed,
        namespace,
        annotations,
        declarations.records,
        declarations.unions,
        signatures.functions,
        traits,
    )
