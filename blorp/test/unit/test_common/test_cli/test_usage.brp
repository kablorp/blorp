---
Tests for the source-path helpers the command line parsers share.
---
import:
    bool: and
    option: Option methods
    path: to_path
    result: Result methods
    test: TestSuite
    ../../../../src/common/cli/usage: path_argument, source_stem


-- The name before `.brp` of a text that is a source path, else None.
private pure func stem_of(text: String) -> Option[String]:
    match text.to_path():
        Ok(path): source_stem(path)
        Err(_): None


pure func test_source_stem_needs_a_name_before_the_extension() -> Bool:
    and(
        and(stem_of("main.brp") == Some("main"), stem_of("a/b/main.brp") == Some("main")),
        and(
            stem_of("a.b.brp") == Some("a.b"),
            and(
                stem_of(".brp").is_none(),
                and(
                    stem_of("src/.brp").is_none(),
                    and(stem_of("main.c").is_none(), stem_of("brp").is_none()),
                ),
            ),
        ),
    )


pure func test_path_argument_refuses_only_the_empty_text() -> Bool:
    and(
        (
            path_argument("")
            == Err("blorp: error: a path cannot be empty\nhelp: write a nonempty path")
        ),
        path_argument("a//b").is_ok(),
    )


TESTS: TestSuite = {
    description = "The command line's shared usage helpers",
    tests = [
        (
            "a source stem needs a name before the extension",
            test_source_stem_needs_a_name_before_the_extension,
        ),
        (
            "a path argument refuses only the empty text",
            test_path_argument_refuses_only_the_empty_text,
        ),
    ],
}
