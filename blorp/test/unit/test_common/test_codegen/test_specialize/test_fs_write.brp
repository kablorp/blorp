import:
    bool: Bool methods
    result: Result methods
    test: TestSuite
    ../../../../../src/common/analysis/namespace/builtins as builtins
    ../../../../../src/common/codegen/lower/lower as lower
    ../../../../../src/common/codegen/specialize/specialize as specialized
    ../../../../../src/common/syntax/syntax:
        IntegerFormat(Int64Format),
        SystemOperation(FsWriteText),
    ../../../fs_write_inputs: fs_write_seed
    ../../../module_input: test_base
    ../../../text_search: replace_first


pure func test_fs_write_result_has_void_success_and_int_error() -> Bool:
    match fs_write_seed(test_base()):
        Err(_):
            False
        Ok(seed):
            signature = specialized.runtime_signature(
                builtins.SystemCall(FsWriteText, seed.constructors),
            )
            match (
                signature.parameters,
                signature.return_type,
                lower.lowered_functions(seed.lowered).unions,
            ):
                ([specialized.StringType, specialized.StringType], specialized.UnionType(owner), [layout]):
                    match specialized.union_variants(layout):
                        [[specialized.VoidType], [specialized.IntegerType(Int64Format)]]:
                            (
                                specialized.union_number(owner)
                                == specialized.union_number(
                                    specialized.variant_owner(seed.constructors.ok),
                                )
                            )
                        _:
                            False
                _:
                    False


pure func test_reversed_result_preserves_constructor_roles() -> Bool:
    foundation = { test_base() |
        types = replace_first(
            test_base().types,
            "    Ok(Value)\n    Err(Error)",
            "    Err(Error)\n    Ok(Value)",
        ),
    }
    match fs_write_seed(foundation):
        Err(_):
            False
        Ok(seed):
            (specialized.variant_number(seed.constructors.ok) == 1).and(
                specialized.variant_number(seed.constructors.err) == 0,
            )


TESTS: TestSuite = {
    description = "Blorp fs.write_text specialization",
    tests = [
        (
            "two Strings return a Result with Void success and Int error",
            test_fs_write_result_has_void_success_and_int_error,
        ),
        (
            "reversed declarations retain Ok and Err roles",
            test_reversed_result_preserves_constructor_roles,
        ),
    ],
}
