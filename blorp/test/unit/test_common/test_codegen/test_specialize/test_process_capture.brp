import:
    bool: Bool methods
    int: Int methods
    test: TestSuite
    ../../../../../src/common/analysis/namespace/builtins as builtins
    ../../../../../src/common/codegen/lower/lower as lower
    ../../../../../src/common/codegen/specialize/specialize as specialized
    ../../../../../src/common/syntax/syntax:
        IntegerFormat(Int64Format),
        SystemOperation(ProcessCapture),
    ../../../module_input: test_base
    ../../../process_capture_inputs: process_seed


pure func test_process_signature_has_string_lists_and_a_list_result() -> Bool:
    match process_seed(test_base()):
        Err(_):
            False
        Ok(seed):
            signature = specialized.runtime_signature(
                builtins.SystemCall(ProcessCapture, seed.constructors),
            )
            match (signature.parameters, signature.return_type):
                ([specialized.StringType, specialized.ListType(specialized.StringType), specialized.ListType(specialized.StringType), specialized.ListType(specialized.StringType), specialized.ListType(specialized.StringType), specialized.IntegerType(Int64Format)], specialized.UnionType(owner)):
                    match lower.lowered_functions(seed.lowered).unions.get(
                        specialized.union_number(owner),
                    ):
                        Some(layout):
                            match specialized.union_variants(layout):
                                [[specialized.ListType(specialized.StringType)], [specialized.IntegerType(Int64Format)]]:
                                    specialized.union_number(owner)
                                        .equals(
                                            specialized.union_number(
                                                specialized.variant_owner(seed.constructors.ok),
                                            ),
                                        )
                                        .and(
                                            specialized.union_number(owner).equals(
                                                specialized.union_number(
                                                    specialized.variant_owner(
                                                        seed.constructors.err,
                                                    ),
                                                ),
                                            ),
                                        )
                                _:
                                    False
                        None:
                            False
                _:
                    False


TESTS: TestSuite = {
    description = "Process builtin specialization",
    tests = [
        (
            "four String lists and a designated List[String]/Int Result",
            test_process_signature_has_string_lists_and_a_list_result,
        ),
    ],
}
