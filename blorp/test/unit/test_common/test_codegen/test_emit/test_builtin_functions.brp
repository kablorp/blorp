import:
    bool: Bool methods, not
    int as int_ops
    option: Option methods
    result: Result methods
    test: TestSuite
    ../../../../../src/common/analysis/assemble: parsed_contents
    ../../../../../src/common/analysis/check/check: CheckedProgram, check, checked_functions
    ../../../../../src/common/analysis/check/model as model
    ../../../../../src/common/analysis/ids: function_number, inventory_functions
    ../../../../../src/common/analysis/namespace/builtins as builtins:
        IntegerFormat(Int64Format),
        PrimitiveType(BuiltinInt),
        RuntimeOperation(IntegerAdd, IntegerToString, StringLength),
        RuntimeResult(ValueResult),
        BuiltinTypeErrorKind(FoundationFunctions),
        check_builtin_types,
        runtime_contract,
    ../../../../../src/common/codegen/emit/emit: emit
    ../../../../../src/common/codegen/lower/lower: lower, value_number
    ../../../../../src/common/codegen/own/own as own
    ../../../../../src/common/codegen/runtime/memory: MEMORY_RUNTIME
    ../../../../../src/common/codegen/specialize/specialize as specialized
    ../../../../../src/common/codegen/verify/verify: verify
    ../../../../../src/common/syntax/source: module_id, module_source
    ../../../../../src/common/syntax/syntax:
        Entrypoint(NoArguments),
        EntryResult(IntegerExitStatus),
        Diagnostic,
        ParsedBody(ParsedBuiltinBody),
        ParsedRuntimeOperation(IntegerAddBuiltin),
        Purity(Pure),
    ../../../input: setup_diagnostic
    ../../../list_update_inputs: placeholder_label
    ../../../module_input:
        ModuleInput,
        primitive_base,
        test_base,
        parse_modules,
        parse_modules_with_base,
    ../../../ownership_inputs: InputIds, input_ids, span
    ../../../string_integer_inputs: STRING_INTEGER_SOURCE
    ../../../text_search: has_text, occurrences
    ../test_verify/selection_inputs as selection_inputs


private ROOT: String =
    |import:
    |    ./int: add
    |func main() -> Int:
    |    add(20, 22)
    |


private ADD: String =
    |pure func add(first: Int, second: Int) -> Int:
    |    builtin("int.add")
    |


private pure func checked_add(helper: String) -> Result[CheckedProgram, Diagnostic]:
    parsed ?= parse_modules([{ source = ROOT, targets = [1] }, { source = helper, targets = [] }])
    check(parsed).map_err(setup_diagnostic)


private pure func owned_sources(
    sources: List[ModuleInput],
) -> Result[own.OwnershipProgram, Diagnostic]:
    parsed ?= parse_modules(sources)
    checked ?= check(parsed).map_err(setup_diagnostic)
    concrete ?= specialized.specialize(checked)
    lowered ?= lower(concrete)
    own.own(lowered)


pure func emitted_sources(sources: List[ModuleInput]) -> Result[String, Diagnostic]:
    owned ?= owned_sources(sources)
    verified ?= verify(owned)
    emit(verified)


pure func test_module_builtin_add_is_accepted() -> Bool:
    match (parse_modules([{ source = ROOT, targets = [1] }, { source = ADD, targets = [] }])):
        Err(_): False
        Ok(parsed): check(parsed).is_ok()


pure func test_parser_publishes_typed_builtin_and_source_span() -> Bool:
    match ((parse_modules([{ source = ADD, targets = [] }]), module_id(0))):
        (Ok(program), Some(module)):
            match inventory_functions(parsed_contents(program).declarations).map(
                pure func(row): row.declaration,
            ):
                [function]:
                    match function.body:
                        ParsedBuiltinBody(IntegerAddBuiltin, occurrence):
                            start = "pure func add(first: Int, second: Int) -> Int:\n    builtin(".length()
                            (occurrence.source == module_source(module))
                                .and(occurrence.start == start)
                                .and(occurrence.end == start + "\"int.add\"".length())
                                .and(function.statements.is_empty())
                        _:
                            False
                _:
                    False
        _:
            False


private pure func int_result(result: builtins.RuntimeResult[Void, specialized.TypeRef]) -> Bool:
    match result:
        ValueResult(builtins.PrimitiveRuntimeType(BuiltinInt)): True
        _: False


private pure func int_pair(parameters: List[builtins.RuntimeType[specialized.TypeRef]]) -> Bool:
    match parameters:
        [builtins.PrimitiveRuntimeType(BuiltinInt), builtins.PrimitiveRuntimeType(BuiltinInt)]: True
        _: False


pure func test_binary_runtime_contract_is_complete() -> Bool:
    operation: RuntimeOperation[Void, specialized.TypeRef] = builtins.IntegerAdd(Int64Format)
    contract = runtime_contract(operation)
    result_matches = int_result(contract.return_type)
    parameters_match = int_pair(contract.parameters)
    (contract.purity == Pure)
        .and(parameters_match)
        .and(result_matches)


pure func test_foundation_builtin_function_uses_ordinary_parser_and_rejects_at_role_boundary() -> Bool:
    root: String =
        |func main() -> Int:
        |    0
        |
    match parse_modules_with_base(
        [{ source = root, targets = [] }],
        { test_base() | types = test_base().types + ADD },
    ):
        Err(_):
            False
        Ok(program):
            parsed = parsed_contents(program)
            match (
                inventory_functions(parsed.declarations)
                    .get(1)
                    .map(pure func(row): row.declaration),
                check_builtin_types(program),
            ):
                (Some(function), Err(error)):
                    match (function.body, error.kind):
                        (ParsedBuiltinBody(IntegerAddBuiltin, occurrence), FoundationFunctions):
                            (occurrence.source == module_source(parsed.foundation.types)).and(
                                (
                                    error.span.start
                                    == test_base().types.length() + "pure func ".length()
                                ),
                            )
                        _:
                            False
                _:
                    False


pure func test_unknown_builtin_label_is_rejected_before_checking() -> Bool:
    source: String =
        |pure func add(first: Int, second: Int) -> Int:
        |    builtin("int.unknown")
        |
    start = "pure func add(first: Int, second: Int) -> Int:\n    builtin(".length()

    match (parse_modules([{ source = source, targets = [] }])):
        Ok(_):
            False
        Err(error):
            (error.span.start == start)
                .and(error.span.end == start + "\"int.unknown\"".length())
                .and(error.message == "unknown builtin operation")
                .and(
                    (
                        error.help
                        == "use system.get_current_directory, system.current_directory, process.run_to_files, process.capture, process.find_program, process.fault, fs.read_text, fs.write_text, fs.entry_kind, fs.list_directory, fs.create_directory, fs.create_directories, fs.remove_file, fs.remove_directory, fs.rename, fs.remove_directory_tree, fs.create_temporary_directory, fs.open_read, fs.next_lines, fs.close, int.equals, int.less_than, int.add, int.subtract, int.multiply, int.divide, int.remainder, int.to_string, float.add, float.subtract, float.multiply, float.divide, float.remainder, float.to_string, float.copysign, float.equals, float.less_than, string.length, string.add, string.append_int, string.print, string.print_error, string.parse_int, string.parse_float, string.byte_at, string.from_codepoint, string.slice, string.equals, list.repeat, list.length, list.get, list.append, list.set or list.concat"
                    ),
                )


pure func test_builtin_body_cannot_have_a_trailing_expression() -> Bool:
    source: String =
        |pure func add(first: Int, second: Int) -> Int:
        |    builtin("int.add").length()
        |
    start = "pure func add(first: Int, second: Int) -> Int:\n    builtin(\"int.add\")".length()

    match (parse_modules([{ source = source, targets = [] }])):
        Ok(_):
            False
        Err(error):
            (error.span.start == start)
                .and(error.span.end == start + 1)
                .and(error.message == "expected a newline after the return expression")
                .and(error.help == "put each declaration on a new line")


pure func test_builtin_rejects_prefix_bindings() -> Bool:
    helper: String =
        |pure func add(first: Int, second: Int) -> Int:
        |    local = first
        |    builtin("int.add")
        |
    start = "pure func add(first: Int, second: Int) -> Int:\n    local = first\n    ".length()

    match (parse_modules([{ source = helper, targets = [] }])):
        Ok(_):
            False
        Err(error):
            (error.span.start == start)
                .and(error.span.end == start + "builtin".length())
                .and(error.message == "builtin must be the entire function body")
                .and(
                    (
                        error.help
                        == (
                            "use builtin as the entire function body; put other work in an ordinary wrapper "
                            + "function"
                        )
                    ),
                )


pure func test_checked_builtin_reads_its_ordered_parameter_identities() -> Bool:
    match checked_add(ADD):
        Err(_):
            False
        Ok(program):
            match checked_functions(program).functions.get(1):
                Some(function):
                    match function.body:
                        model.CheckedValueBody(model.ReturnExpression(value)):
                            match value.form:
                                model.InvokeFunction(call):
                                    match call.operands:
                                        [model.ValueOperand(first), model.ValueOperand(second)]:
                                            match (call.target, first.form, second.form):
                                                (model.RuntimeFunction(builtins.IntegerAdd(Int64Format)), model.ReadBinding(first_id), model.ReadBinding(second_id)):
                                                    (model.binding_number(first_id) == 0)
                                                        .and(model.binding_number(second_id) == 1)
                                                        .and(function.bindings.length() == 2)
                                                        .and(function.statements.is_empty())
                                                        .and(
                                                            (
                                                                value.value_type
                                                                == model.IntegerType(Int64Format)
                                                            ),
                                                        )
                                                _:
                                                    False
                                        _:
                                            False
                                _:
                                    False
                        _:
                            False
                None:
                    False


pure func test_specialization_keeps_binary_runtime_contract() -> Bool:
    contract = specialized.runtime_signature(builtins.IntegerAdd(Int64Format))

    match checked_add(ADD).and_then(pure func(checked): specialized.specialize(checked)):
        Err(_):
            False
        Ok(program):
            match specialized.specialized_contents(program).functions.get(1):
                Some(function):
                    match function.body:
                        specialized.ConcreteValueBody(specialized.ReturnExpression(value)):
                            match value.form:
                                specialized.InvokeFunction(call, [_, _]):
                                    match (
                                        call.target,
                                        contract.parameters,
                                        function.signature.parameters,
                                    ):
                                        (specialized.RuntimeFunction(builtins.IntegerAdd(Int64Format)), [specialized.IntegerType(Int64Format), specialized.IntegerType(Int64Format)], [specialized.IntegerType(Int64Format), specialized.IntegerType(Int64Format)]):
                                            (
                                                contract.return_type
                                                == specialized.IntegerType(Int64Format)
                                            )
                                        _:
                                            False
                                _:
                                    False
                        _:
                            False
                None:
                    False


private pure func owned_add(
    ids: InputIds,
    arguments: List[own.OwnedArgument],
) -> own.OwnershipProgram:
    {
        records = [],
        unions = [],
        entrypoint = NoArguments(ids.entrypoint, IntegerExitStatus),
        functions = [
            {
                label = placeholder_label("main"),
                parameters = [],
                return_type = specialized.IntegerType(Int64Format),
                operations = [
                    own.DefineValue({
                        id = ids.first,
                        value_type = specialized.IntegerType(Int64Format),
                        operation = own.IntegerDefinition(20),
                        result = own.UnmanagedResult,
                        span = span(10),
                    }),
                    own.DefineValue({
                        id = ids.second,
                        value_type = specialized.IntegerType(Int64Format),
                        operation = own.IntegerDefinition(22),
                        result = own.UnmanagedResult,
                        span = span(20),
                    }),
                    own.DefineValue({
                        id = ids.third,
                        value_type = specialized.IntegerType(Int64Format),
                        operation = own.CallDefinition(
                            specialized.RuntimeFunction(builtins.IntegerAdd(Int64Format)),
                            arguments,
                        ),
                        result = own.UnmanagedResult,
                        span = span(30),
                    }),
                ],
                result = own.UnmanagedReturn(ids.third),
            },
        ],
    }


pure func test_verifier_accepts_two_unmanaged_runtime_arguments() -> Bool:
    match input_ids():
        Err(_):
            False
        Ok(ids):
            verify(
                owned_add(ids, [
                    own.UnmanagedArgument(ids.first),
                    own.UnmanagedArgument(ids.second),
                ]),
            ).is_ok()


pure func test_verifier_rejects_a_missing_runtime_argument() -> Bool:
    match input_ids():
        Err(_):
            False
        Ok(ids):
            match verify(owned_add(ids, [own.UnmanagedArgument(ids.first)])):
                Ok(_):
                    False
                Err(error):
                    (error.span.start == 30)
                        .and(error.span.end == 31)
                        .and(
                            (
                                error.message
                                == "ownership verification failed: call is missing its argument"
                            ),
                        )
                        .and(error.help == "report this compiler error with the input program")


pure func test_emitter_includes_portable_addition_only_for_runtime_calls() -> Bool:
    match input_ids():
        Err(_):
            False
        Ok(ids):
            match (verify(
                owned_add(ids, [
                    own.UnmanagedArgument(ids.first),
                    own.UnmanagedArgument(ids.second),
                ]),
            ).and_then(pure func(program): emit(program))):
                Err(_):
                    False
                Ok(code):
                    has_text(code, "uint64_t sum=(uint64_t)first+(uint64_t)second;")
                        .and(
                            has_text(
                                code,
                                "sum<=INT64_MAX?(int64_t)sum:-INT64_C(1)-(int64_t)(UINT64_MAX-sum)",
                            ),
                        )
                        .and(has_text(code, "blorp_int_add(blorp_vl_0,blorp_vl_1)"))
                        .and(not(has_text(code, "blorp_int_to_string")))


