pure func test_verifier_checks_second_runtime_argument_type() -> Bool:
    match input_ids():
        Err(_):
            False
        Ok(ids):
            original = owned_add(ids, [
                own.UnmanagedArgument(ids.first),
                own.UnmanagedArgument(ids.second),
            ])

            match original.functions:
                [function]:
                    wrong = { function |
                        label = placeholder_label("worker"),
                        parameters = [
                            own.ManagedParameter({
                                value_type = specialized.StringType,
                                owned = False,
                            }),
                        ],
                        return_type = specialized.IntegerType(Int64Format),
                        operations = [
                            own.DefineValue({
                                id = ids.first,
                                value_type = specialized.IntegerType(Int64Format),
                                operation = own.IntegerDefinition(20),
                                result = own.UnmanagedResult,
                                span = span(10),
                            }),
                            own.DefineValue({
                                id = ids.second,
                                value_type = specialized.StringType,
                                operation = own.ParameterDefinition(0),
                                result = own.BorrowedResult(own.ParameterBorrow(ids.second)),
                                span = span(20),
                            }),
                            own.DefineValue({
                                id = ids.third,
                                value_type = specialized.IntegerType(Int64Format),
                                operation = own.CallDefinition(
                                    specialized.RuntimeFunction(builtins.IntegerAdd(Int64Format)),
                                    [
                                        own.UnmanagedArgument(ids.first),
                                        own.BorrowedArgument({
                                            value = ids.second,
                                            source = own.ParameterBorrow(ids.second),
                                        }),
                                    ],
                                ),
                                result = own.UnmanagedResult,
                                span = span(30),
                            }),
                        ],
                    }

                    match (verify({ original | functions = [function, wrong] })):
                        Ok(_):
                            False
                        Err(error):
                            (error.span.start == 30)
                                .and(error.span.end == 31)
                                .and(
                                    (
                                        error.message
                                        == "ownership verification failed: call argument type does not match its contract"
                                    ),
                                )
                                .and(
                                    (
                                        error.help
                                        == "report this compiler error with the input program"
                                    ),
                                )
                _:
                    False


private UNARY_ROOT: String =
    |import:
    |    ./string: count, to_string
    |func main() -> Int:
    |    count(42.to_string())
    |


private UNARY_HELPER: String =
    |pure func count(value: String) -> Int:
    |    builtin("string.length")
    |pure func to_string(value: Int) -> String:
    |    builtin("int.to_string")
    |


private pure func borrows_parameter(function: own.OwnedFunction) -> Bool:
    match function.operations:
        [own.DefineValue(parameter), own.DefineValue(result)]:
            match (parameter.operation, parameter.result, result.operation):
                (own.ParameterDefinition(position), own.BorrowedResult(own.ParameterBorrow(source)), own.CallDefinition(call, [own.BorrowedArgument(argument)])):
                    match (call, argument.source, result.result):
                        (specialized.RuntimeFunction(builtins.StringLength), own.ParameterBorrow(argument_source), own.UnmanagedResult):
                            (position == 0)
                                .and(value_number(source) == value_number(parameter.id))
                                .and(value_number(argument.value) == value_number(parameter.id))
                                .and(value_number(argument_source) == value_number(parameter.id))
                                .and(parameter.value_type == specialized.StringType)
                                .and(result.value_type == specialized.IntegerType(Int64Format))
                        _:
                            False
                _:
                    False
        _:
            False


pure func test_unary_module_builtin_preserves_managed_parameter_borrow() -> Bool:
    match (owned_sources([
        { source = UNARY_ROOT, targets = [1] },
        { source = UNARY_HELPER, targets = [] },
    ])):
        Err(_):
            False
        Ok(program):
            match program.functions:
                [caller, _, helper]:
                    var dropped: Bool = False

                    for operation in caller.operations:
                        match operation:
                            own.DropOwner(owner, _):
                                dropped = dropped.or(own.owner_number(owner) == 0)
                            _:
                                void

                    borrows_parameter(helper)
                        .and(dropped)
                        .and(verify(program).is_ok())
                _:
                    False


pure func test_unary_module_builtin_emits_caller_cleanup() -> Bool:
    match (emitted_sources([
        { source = UNARY_ROOT, targets = [1] },
        { source = UNARY_HELPER, targets = [] },
    ])):
        Err(_):
            False
        Ok(code):
            has_text(code, "blorp_string_length(blorp_vl_0)")
                .and(has_text(code, "blorp_string_release(blorp_owner_0);"))
                .and(not(has_text(code, "blorp_int_add")))


pure func test_module_builtin_transfers_its_fresh_string_result() -> Bool:
    root: String =
        |import:
        |    ./int: format, length
        |func main() -> Int:
        |    format(42).length()
        |
    helper: String =
        |pure func format(value: Int) -> String:
        |    builtin("int.to_string")
        |pure func length(value: String) -> Int:
        |    builtin("string.length")
        |
    sources: List[ModuleInput] = [
        { source = root, targets = [1] },
        { source = helper, targets = [] },
    ]

    match parse_modules(sources).and_then(
        pure func(parsed): check(parsed).map_err(setup_diagnostic),
    ):
        Err(_):
            False
        Ok(checked):
            var checked_result: Bool = False

            match checked_functions(checked).functions.get(1):
                Some(function):
                    match function.body:
                        model.CheckedValueBody(model.ReturnExpression(value)):
                            match value.form:
                                model.InvokeFunction(call):
                                    match call.operands:
                                        [model.ValueOperand(argument)]:
                                            match (call.target, argument.form):
                                                (model.RuntimeFunction(builtins.IntegerToString(Int64Format)), model.ReadBinding(parameter)):
                                                    checked_result = (value.value_type == model.StringType)
                                                        .and(
                                                            (
                                                                argument.value_type
                                                                == model.IntegerType(Int64Format)
                                                            ),
                                                        )
                                                        .and(model.binding_number(parameter) == 0)
                                                _:
                                                    void
                                        _:
                                            void
                                _:
                                    void
                        _:
                            void
                None:
                    void

            match owned_sources(sources):
                Err(_):
                    False
                Ok(program):
                    match program.functions:
                        [caller, formatter, _]:
                            match (caller.operations, formatter.operations, formatter.result):
                                ([own.DefineValue(_), own.DefineValue(formatted), own.DefineValue(_), own.DropOwner(dropped, _)], [own.DefineValue(parameter), own.DefineValue(result)], own.OwnedReturn(value, transferred)):
                                    match (
                                        parameter.operation,
                                        result.operation,
                                        result.result,
                                        formatted.result,
                                    ):
                                        (own.ParameterDefinition(position), own.CallDefinition(call, [own.UnmanagedArgument(argument)]), own.OwnedResult(created), own.OwnedResult(caller_owner)):
                                            match call:
                                                specialized.RuntimeFunction(builtins.IntegerToString(Int64Format)):
                                                    checked_result
                                                        .and(position == 0)
                                                        .and(
                                                            (
                                                                result.value_type
                                                                == specialized.StringType
                                                            ),
                                                        )
                                                        .and(
                                                            (
                                                                value_number(argument)
                                                                == value_number(parameter.id)
                                                            ),
                                                        )
                                                        .and(
                                                            (
                                                                value_number(value)
                                                                == value_number(result.id)
                                                            ),
                                                        )
                                                        .and(
                                                            (
                                                                own.owner_number(created)
                                                                == own.owner_number(transferred)
                                                            ),
                                                        )
                                                        .and(
                                                            (
                                                                own.owner_number(caller_owner)
                                                                == own.owner_number(dropped)
                                                            ),
                                                        )
                                                        .and(verify(program).is_ok())
                                                _:
                                                    False
                                        _:
                                            False
                                _:
                                    False
                        _:
                            False


pure func test_imported_builtin_call_keeps_ordinary_declaration_identity() -> Bool:
    match checked_add(ADD):
        Err(_):
            False
        Ok(program):
            match checked_functions(program).functions.get(0):
                None:
                    False
                Some(caller):
                    match model.function_calls(caller):
                        [call]:
                            ordinary = call.operands.all(pure func(operand):
                                match operand:
                                    model.ValueOperand(_): True
                                    model.CallableOperand(_, _, _): False
                            )
                            match (call.target, ordinary):
                                (model.UserFunction(id, []), True): function_number(id) == 1
                                _: False
                        _:
                            False


pure func test_addition_helper_is_absent_without_runtime_calls() -> Bool:
    source: String =
        |func main() -> Int:
        |    42
        |

    -- Exact minimal output requires only primitive types, with no nominal catalog.
    emitted = parse_modules_with_base([{ source = source, targets = [] }], primitive_base())
        .and_then(pure func(parsed): check(parsed).map_err(setup_diagnostic))
        .and_then(pure func(program): specialized.specialize(program))
        .and_then(lower)
        .and_then(pure func(program): own.own(program))
        .and_then(verify)
        .and_then(emit)
    match emitted:
        Err(_):
            False
        Ok(code):
            (
                code
                == MEMORY_RUNTIME + "#include <stdint.h>\nint64_t blorp_f_0(void);/* module_0.main */ int64_t blorp_f_0(void){const int64_t blorp_vl_0=INT64_C(42);(void)blorp_vl_0;return blorp_vl_0;}\nstatic int blorp_program_finish(int status){return blorp_memory_finish(status);}\nint main(void){blorp_memory_start();return blorp_program_finish((int)blorp_f_0());}\n"
            )


pure func test_emitter_finds_runtime_addition_inside_a_match_arm() -> Bool:
    match input_ids():
        Err(_):
            False
        Ok(ids):
            original = owned_add(ids, [
                own.UnmanagedArgument(ids.first),
                own.UnmanagedArgument(ids.third),
            ])

            match original.functions:
                [function]:
                    matched = { function |
                        operations = [
                            own.DefineValue({
                                id = ids.first,
                                value_type = specialized.UnionType(ids.union_id),
                                operation = own.ConstructDefinition(ids.second_variant, []),
                                result = own.UnmanagedResult,
                                span = span(1),
                            }),
                            own.ExecuteJoin({
                                result = own.UnmanagedJoinParameter({
                                    id = ids.second,
                                    value_type = specialized.IntegerType(Int64Format),
                                    span = span(30),
                                }),
                                carried = [],
                                entering = [],
                                selection = selection_inputs.direct(
                                    own.UnmanagedArgument(ids.first),
                                ),
                                arms = [
                                    {
                                        id = model.match_arm_id(0),
                                        inputs = [],
                                        operations = [
                                            own.DefineValue({
                                                id = ids.third,
                                                value_type = specialized.IntegerType(Int64Format),
                                                operation = own.IntegerDefinition(20),
                                                result = own.UnmanagedResult,
                                                span = span(10),
                                            }),
                                            own.DefineValue({
                                                id = ids.fourth,
                                                value_type = specialized.IntegerType(Int64Format),
                                                operation = own.IntegerDefinition(22),
                                                result = own.UnmanagedResult,
                                                span = span(20),
                                            }),
                                            own.DefineValue({
                                                id = ids.fifth,
                                                value_type = specialized.IntegerType(Int64Format),
                                                operation = own.CallDefinition(
                                                    specialized.RuntimeFunction(
                                                        builtins.IntegerAdd(Int64Format),
                                                    ),
                                                    [
                                                        own.UnmanagedArgument(ids.third),
                                                        own.UnmanagedArgument(ids.fourth),
                                                    ],
                                                ),
                                                result = own.UnmanagedResult,
                                                span = span(30),
                                            }),
                                        ],
                                        exit = own.Yield({
                                            transfer = own.UnmanagedReturn(ids.fifth),
                                            carried = [],
                                        }),
                                    },
                                ],
                            }),
                        ],
                        result = own.UnmanagedReturn(ids.second),
                    }

                    match verify({ original | unions = ids.unions, functions = [matched] }).and_then(
                        pure func(program): emit(program),
                    ):
                        Err(_):
                            False
                        Ok(code):
                            has_text(code, "static int64_t blorp_int_add(").and(
                                has_text(code, "blorp_int_add(blorp_vl_2,blorp_vl_3)"),
                            )
                _:
                    False


pure func test_unused_builtin_declaration_omits_its_runtime_helper() -> Bool:
    source = ADD + "func main() -> Int:\n    42\n"

    match (emitted_sources([{ source = source, targets = [] }])):
        Err(_):
            False
        Ok(code):
            not(has_text(code, "blorp_int_add"))
                .and(not(has_text(code, "blorp_f_1")))
                .and(has_text(code, "return blorp_program_finish((int)blorp_f_0());"))


pure func test_byte_at_emission_selects_some_zero_by_status() -> Bool:
    match emitted_sources([{ source = STRING_INTEGER_SOURCE, targets = [] }]):
        Err(_):
            False
        Ok(output):
            has_text(
                output,
                "int64_t blorp_runtime_2=0;const uint8_t blorp_runtime_2_some=blorp_string_byte_at(blorp_vl_0,blorp_vl_1,&blorp_runtime_2);",
            )
                .and(has_text(output, "blorp_vl_2=blorp_runtime_2_some?((struct blorp_u_"))
                .and(has_text(output, ".blorp_uf_0=blorp_runtime_2"))
                .and(occurrences(output, "_some=blorp_string_byte_at(") == 1)


pure func test_encoder_emission_moves_one_fresh_root_into_some() -> Bool:
    match emitted_sources([{ source = STRING_INTEGER_SOURCE, targets = [] }]):
        Err(_):
            False
        Ok(output):
            has_text(
                output,
                "struct blorp_string *blorp_runtime_1=NULL;const uint8_t blorp_runtime_1_some=blorp_string_from_codepoint(blorp_vl_0,&blorp_runtime_1);",
            )
                .and(has_text(output, "blorp_vl_1=blorp_runtime_1_some?((struct blorp_u_"))
                .and(has_text(output, ".blorp_uf_0=blorp_runtime_1"))
                .and(occurrences(output, "_some=blorp_string_from_codepoint(") == 1)
                .and(occurrences(output, "blorp_string_retain(blorp_runtime_1)") == 0)
                .and(occurrences(output, "blorp_string_release(blorp_runtime_1)") == 0)


TESTS: TestSuite = {
    description = "Blorp builtin function declarations",
    tests = [
        (
            "byte_at emission selects Some zero by status",
            test_byte_at_emission_selects_some_zero_by_status,
        ),
        (
            "encoder emission moves one fresh root into Some",
            test_encoder_emission_moves_one_fresh_root_into_some,
        ),
        ("module builtin addition is accepted", test_module_builtin_add_is_accepted),
        (
            "parser publishes typed builtin source span",
            test_parser_publishes_typed_builtin_and_source_span,
        ),
        ("binary runtime contract is complete", test_binary_runtime_contract_is_complete),
        (
            "foundation function parses ordinarily then rejects at role boundary",
            test_foundation_builtin_function_uses_ordinary_parser_and_rejects_at_role_boundary,
        ),
        (
            "unknown builtin label is rejected by parser",
            test_unknown_builtin_label_is_rejected_before_checking,
        ),
        (
            "builtin body rejects trailing expression",
            test_builtin_body_cannot_have_a_trailing_expression,
        ),
        ("builtin rejects prefix bindings", test_builtin_rejects_prefix_bindings),
        (
            "checker reads ordered parameter identities",
            test_checked_builtin_reads_its_ordered_parameter_identities,
        ),
        (
            "specialization keeps binary runtime contract",
            test_specialization_keeps_binary_runtime_contract,
        ),
        (
            "verifier accepts two unmanaged runtime arguments",
            test_verifier_accepts_two_unmanaged_runtime_arguments,
        ),
        (
            "verifier rejects missing runtime argument",
            test_verifier_rejects_a_missing_runtime_argument,
        ),
        (
            "emitter includes portable addition helper",
            test_emitter_includes_portable_addition_only_for_runtime_calls,
        ),
        (
            "label selects renamed local operation",
            test_label_selects_operation_for_a_renamed_local_function,
        ),
        ("imported builtin uses normal UFCS", test_imported_builtin_uses_normal_ufcs),
        (
            "verifier checks second runtime argument type",
            test_verifier_checks_second_runtime_argument_type,
        ),
        (
            "unary module builtin borrows managed parameter",
            test_unary_module_builtin_preserves_managed_parameter_borrow,
        ),
        (
            "unary module builtin emits caller cleanup",
            test_unary_module_builtin_emits_caller_cleanup,
        ),
        (
            "module builtin transfers fresh String result",
            test_module_builtin_transfers_its_fresh_string_result,
        ),
        (
            "imported builtin keeps ordinary declaration identity",
            test_imported_builtin_call_keeps_ordinary_declaration_identity,
        ),
        (
            "addition helper absent without runtime calls",
            test_addition_helper_is_absent_without_runtime_calls,
        ),
        (
            "emitter finds addition inside match arm",
            test_emitter_finds_runtime_addition_inside_a_match_arm,
        ),
        (
            "unused builtin omits runtime helper",
            test_unused_builtin_declaration_omits_its_runtime_helper,
        ),
    ],
}
