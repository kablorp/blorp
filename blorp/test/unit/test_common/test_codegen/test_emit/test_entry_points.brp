import:
    test: TestSuite
    ./test_builtin_functions: emitted_sources


-- Purity is checked before emission and the program's entry has one C shape,
-- so declaring `main` pure must not change the C it emits.
pure func test_pure_main_emits_the_same_program_as_an_effectful_main() -> Bool:
    pure_main = emitted_sources([{ source = "pure func main() -> Int:\n    1\n", targets = [] }])
    effectful_main = emitted_sources([{ source = "func main() -> Int:\n    1\n", targets = [] }])
    match (pure_main, effectful_main):
        (Ok(pure_code), Ok(effectful_code)): pure_code == effectful_code
        _: False


TESTS: TestSuite = {
    description = "Blorp entry point emission",
    tests = [
        (
            "a pure main emits the same program as an effectful main",
            test_pure_main_emits_the_same_program_as_an_effectful_main,
        ),
    ],
}
