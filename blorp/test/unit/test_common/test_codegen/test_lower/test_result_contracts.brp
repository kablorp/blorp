import:
    bool: Bool methods
    test: TestSuite
    ../../../../../src/common/analysis/namespace/builtins as builtins
    ../../../../../src/common/codegen/lower/lower as lower
    ../../../../../src/common/codegen/specialize/specialize as specialized
    ../../../../../src/common/syntax/syntax: SystemOperation(CurrentDirectory)
    ../../../current_directory_inputs: current_directory_seed
    ../../../module_input: test_base


pure func test_current_directory_lowers_complete_zero_argument_call() -> Bool:
    match current_directory_seed(test_base()):
        Err(_):
            False
        Ok(seed):
            match seed.query.steps:
                [lower.Define(result)]:
                    match (result.value_type, result.operation):
                        (specialized.UnionType(owner), lower.CallValue(call, [])):
                            match call:
                                specialized.RuntimeFunction(builtins.SystemCall(CurrentDirectory, designated)):
                                    (specialized.union_number(owner) == specialized.union_number(
                                        specialized.variant_owner(designated.ok),
                                    ))
                                        .and(
                                            (
                                                specialized.union_number(owner)
                                                == specialized.union_number(
                                                    specialized.variant_owner(designated.err),
                                                )
                                            ),
                                        )
                                        .and(result.span.start == 49)
                                        .and(result.span.end == 75)
                                _:
                                    False
                        _:
                            False
                _:
                    False


TESTS: TestSuite = {
    description = "Blorp runtime Result lowering",
    tests = [
        (
            "current directory preserves its concrete call and source span",
            test_current_directory_lowers_complete_zero_argument_call,
        ),
    ],
}
