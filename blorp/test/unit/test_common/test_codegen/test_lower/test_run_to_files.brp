import:
    bool: Bool methods
    int: Int methods
    string: String methods
    test: TestSuite
    ../../../../../src/common/analysis/namespace/builtins as builtins
    ../../../../../src/common/codegen/lower/lower as lower
    ../../../../../src/common/codegen/specialize/specialize as specialized
    ../../../../../src/common/syntax/syntax: SystemOperation(RunToFiles)
    ../../../module_input: test_base
    ../../../run_to_files_inputs: PROCESS_HEADER, process_seed


pure func test_ordered_five_operands_and_operator_span_are_preserved() -> Bool:
    match process_seed(test_base()):
        Err(_):
            False
        Ok(seed):
            match seed.query.steps:
                [lower.Define(program), lower.Define(arguments), lower.Define(out), lower.Define(err), lower.Define(timeout), lower.Define(result)]:
                    match result.operation:
                        lower.CallValue(specialized.RuntimeFunction(builtins.SystemCall(RunToFiles, _)), [first, second, third, fourth, fifth]):
                            lower.value_number(first)
                                .equals(lower.value_number(program.id))
                                .and(
                                    lower.value_number(second).equals(
                                        lower.value_number(arguments.id),
                                    ),
                                )
                                .and(lower.value_number(third).equals(lower.value_number(out.id)))
                                .and(lower.value_number(fourth).equals(lower.value_number(err.id)))
                                .and(
                                    lower.value_number(fifth).equals(
                                        lower.value_number(timeout.id),
                                    ),
                                )
                                .and(result.span.start.equals(PROCESS_HEADER.length()))
                                .and(
                                    result.span.end.equals(
                                        (
                                            PROCESS_HEADER.length()
                                            + ("\"process.run_to_files\"".length())
                                        ),
                                    ),
                                )
                        _:
                            False
                _:
                    False


TESTS: TestSuite = {
    description = "Process builtin lowering",
    tests = [
        (
            "five operand identities and builtin span",
            test_ordered_five_operands_and_operator_span_are_preserved,
        ),
    ],
}
