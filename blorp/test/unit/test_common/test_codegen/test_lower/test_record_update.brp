import:
    bool: Bool methods
    int as int_ops
    list: find, last, length
    option: to_result
    test: TestSuite
    ../../../../../src/common/analysis/namespace/builtins: IntegerFormat(Int64Format)
    ../../../../../src/common/codegen/lower/lower as lower
    ../../../../../src/common/codegen/specialize/specialize as specialized
    ../../../../../src/common/syntax/source: module_source, root_module_id
    ../../../../../src/common/syntax/syntax:
        Diagnostic,
        DiagnosticKind(ProgramProblem),
        entry_function,
    ../../../../../src/common/utils/text: concat
    ../../../list_update_inputs: lowered


private PAIR: String =
    |record Pair { first: Int, second: Int }
    |func observe(value: Int) -> Int:
    |    value
    |func base() -> Pair:
    |    { first = 1, second = 2 }
    |


private pure func setup_error() -> Diagnostic:
    {
        span = { source = module_source(root_module_id()), start = 0, end = 0 },
        kind = ProgramProblem,
        note = None,
        message = "invalid record update lowering seed",
        help = "fix the test's normal main and returned record field",
    }


private pure func ordinary_value(
    function: lower.LoweredFunction,
    id: lower.ValueId,
) -> Result[lower.ValueDefinition, Diagnostic]:
    found = function.steps.find(pure func(step):
        match step:
            lower.Define(definition): definition.id == id
            _: False
    )
    match found:
        Some(lower.Define(definition)): Ok(definition)
        _: Err(setup_error())


private pure func projected_parent(
    definition: lower.ValueDefinition,
) -> Result[lower.ValueId, Diagnostic]:
    match definition.operation:
        lower.ReadRecordFieldValue(_, parent): Ok(parent)
        _: Err(setup_error())


-- The function's final step when it is a join whose result is the function's.
private pure func lowered_tail_join(function: lower.LoweredFunction) -> Option[lower.LoweredJoin]:
    match function.steps.last():
        Some(lower.Join(join)):
            match int_ops.equals(
                lower.value_number(join.result.id),
                lower.value_number(function.result),
            ):
                True: Some(join)
                False: None
        _:
            None


-- The real entrypoint's returned field identifies the callee under test.
private pure func changed(source: String) -> Result[lower.LoweredFunction, Diagnostic]:
    program ?= lowered(source)
    facts = lower.lowered_functions(program)
    main ?= facts.functions
        .get(specialized.function_number(entry_function(facts.entrypoint)))
        .to_result(setup_error())
    result = main.result
    definition ?= ordinary_value(main, result)
    parent ?= projected_parent(definition)
    invocation ?= ordinary_value(main, parent)
    match invocation.operation:
        lower.CallValue(target, _):
            match target:
                specialized.UserFunction(id):
                    facts.functions
                        .get(specialized.function_number(id))
                        .to_result(setup_error())
                _:
                    Err(setup_error())
        _:
            Err(setup_error())


private pure func literal(definition: lower.ValueDefinition, expected: Int) -> Bool:
    match definition.operation:
        lower.IntegerValue(value):
            int_ops.equals(value, expected).and(
                definition.value_type == specialized.IntegerType(Int64Format),
            )
        _:
            False


private pure func argument_is(definition: lower.ValueDefinition, operand: lower.ValueId) -> Bool:
    match definition.operation:
        lower.CallValue(_, [value]):
            int_ops.equals(lower.value_number(value), lower.value_number(operand))
        _:
            False


private pure func returned(function: lower.LoweredFunction, value: lower.ValueId) -> Bool:
    result = function.result
    int_ops.equals(lower.value_number(result), lower.value_number(value))


private pure func projects(
    definition: lower.ValueDefinition,
    parent: lower.ValueDefinition,
    ordinal: Int,
    expected: specialized.TypeRef,
) -> Bool:
    match definition.operation:
        lower.ReadRecordFieldValue(field, value):
            int_ops.equals(specialized.field_number(field), ordinal)
                .and(int_ops.equals(lower.value_number(value), lower.value_number(parent.id)))
                .and(specialized.RecordType(specialized.field_owner(field)) == parent.value_type)
                .and(definition.value_type == expected)
        _:
            False


-- Storage order is the replacements as written, then the inherited fields.
private pure func constructs(
    definition: lower.ValueDefinition,
    leading_field: Int,
    first: lower.ValueId,
    trailing_field: Int,
    second: lower.ValueId,
) -> Bool:
    match definition.operation:
        lower.ConstructRecordValue(owner, [left, right]):
            int_ops.equals(specialized.field_number(left.field), leading_field)
                .and(int_ops.equals(specialized.field_number(right.field), trailing_field))
                .and(
                    (
                        specialized.RecordType(specialized.field_owner(left.field))
                        == specialized.RecordType(owner)
                    ),
                )
                .and(
                    (
                        specialized.RecordType(specialized.field_owner(right.field))
                        == specialized.RecordType(owner)
                    ),
                )
                .and(definition.value_type == specialized.RecordType(owner))
                .and(int_ops.equals(lower.value_number(left.value), lower.value_number(first)))
                .and(int_ops.equals(lower.value_number(right.value), lower.value_number(second)))
        _:
            False


pure func test_base_call_and_rhs_order_precede_written_order_storage() -> Bool:
    source = PAIR.concat(
        |func change() -> Pair:
        |    { base() | second = observe(9), first = observe(7) }
        |func main() -> Int:
        |    change().first
        |
    )
    match changed(source):
        Err(_):
            False
        Ok(function):
            match function.steps:
                [lower.Define(base), lower.Define(nine), lower.Define(second), lower.Define(seven), lower.Define(first), lower.Define(result)]:
                    base_once = match base.operation:
                        lower.CallValue(_, arguments): int_ops.equals(arguments.length(), 0)
                        _: False
                    ordered_fields = match result.operation:
                        lower.ConstructRecordValue(owner, [left, right]):
                            int_ops.equals(specialized.field_number(left.field), 1)
                                .and(int_ops.equals(specialized.field_number(right.field), 0))
                                .and(
                                    int_ops.equals(
                                        lower.value_number(left.value),
                                        lower.value_number(second.id),
                                    ),
                                )
                                .and(
                                    int_ops.equals(
                                        lower.value_number(right.value),
                                        lower.value_number(first.id),
                                    ),
                                )
                                .and(result.value_type == specialized.RecordType(owner))
                                .and(
                                    int_ops.equals(
                                        specialized.record_number(
                                            specialized.field_owner(left.field),
                                        ),
                                        specialized.record_number(owner),
                                    ),
                                )
                                .and(
                                    int_ops.equals(
                                        specialized.record_number(
                                            specialized.field_owner(right.field),
                                        ),
                                        specialized.record_number(owner),
                                    ),
                                )
                        _:
                            False
                    base_once
                        .and(literal(nine, 9))
                        .and(literal(seven, 7))
                        .and(argument_is(second, nine.id))
                        .and(argument_is(first, seven.id))
                        .and(ordered_fields)
                        .and(returned(function, result.id))
                _:
                    False


pure func test_binding_alias_reuses_identity_and_inherited_projection() -> Bool:
    prefix = PAIR.concat(
        |func change(value: Pair) -> Pair:
        |    other = value
        |    {
    )
    base = "other"
    suffix: String =
        | | second = observe(7) }
        |func main() -> Int:
        |    change(base()).first
        |
    source = prefix
        .concat(" ")
        .concat(base)
        .concat(suffix)
    match changed(source):
        Err(_):
            False
        Ok(function):
            match function.steps:
                [lower.Define(parent), lower.Define(projection), lower.Define(seven), lower.Define(replacement), lower.Define(result)]:
                    parameter = match parent.operation:
                        lower.ParameterValue(index): int_ops.equals(index, 0)
                        _: False
                    inherited = match projection.operation:
                        lower.ReadRecordFieldValue(field, value):
                            int_ops.equals(specialized.field_number(field), 0)
                                .and(
                                    int_ops.equals(
                                        lower.value_number(value),
                                        lower.value_number(parent.id),
                                    ),
                                )
                                .and(int_ops.equals(projection.span.start, prefix.length() + 1))
                                .and(
                                    int_ops.equals(
                                        projection.span.end,
                                        (prefix.length() + 1) + base.length(),
                                    ),
                                )
                                .and(projection.value_type == specialized.IntegerType(Int64Format))
                                .and(
                                    (
                                        specialized.RecordType(specialized.field_owner(field))
                                        == parent.value_type
                                    ),
                                )
                        _:
                            False
                    stored = match result.operation:
                        lower.ConstructRecordValue(_, [second, first]):
                            int_ops.equals(specialized.field_number(second.field), 1)
                                .and(int_ops.equals(specialized.field_number(first.field), 0))
                                .and(
                                    int_ops.equals(
                                        lower.value_number(second.value),
                                        lower.value_number(replacement.id),
                                    ),
                                )
                                .and(
                                    int_ops.equals(
                                        lower.value_number(first.value),
                                        lower.value_number(projection.id),
                                    ),
                                )
                        _:
                            False
                    parameter
                        .and(literal(seven, 7))
                        .and(argument_is(replacement, seven.id))
                        .and(inherited)
                        .and(stored)
                        .and(returned(function, result.id))
                _:
                    False


pure func test_postfix_base_is_evaluated_once_and_preserves_projection_span() -> Bool:
    prefix = PAIR
        .concat(
            |record Outer { inner: Pair, ignored: Int }
            |pure func outer() -> Outer:
            |    { inner = { first = 1, second = 2 }, ignored = 3 }
            |func change() -> Pair:
            |    {
        )
        .concat(" ")
    base = "outer().inner"
    suffix: String =
        | | second = observe(7) }
        |func main() -> Int:
        |    change().first
        |
    match changed(
        prefix
            .concat(base)
            .concat(suffix),
    ):
        Err(_):
            False
        Ok(function):
            match function.steps:
                [lower.Define(call), lower.Define(selected), lower.Define(inherited), lower.Define(seven), lower.Define(replacement), lower.Define(result)]:
                    call_once = match call.operation:
                        lower.CallValue(_, arguments): int_ops.equals(arguments.length(), 0)
                        _: False
                    call_once
                        .and(projects(selected, call, 0, function.signature.return_type))
                        .and(projects(inherited, selected, 0, specialized.IntegerType(Int64Format)))
                        .and(int_ops.equals(inherited.span.start, prefix.length()))
                        .and(int_ops.equals(inherited.span.end, prefix.length() + base.length()))
                        .and(literal(seven, 7))
                        .and(argument_is(replacement, seven.id))
                        .and(constructs(result, 1, replacement.id, 0, inherited.id))
                        .and(returned(function, result.id))
                _:
                    False


pure func test_nested_updates_use_the_completed_inner_record() -> Bool:
    source = PAIR.concat(
        |func change(value: Pair) -> Pair:
        |    { { value | first = observe(7) } | second = observe(9) }
        |func main() -> Int:
        |    change(base()).first
        |
    )
    match changed(source):
        Err(_):
            False
        Ok(function):
            match function.steps:
                [lower.Define(parent), lower.Define(old_second), lower.Define(seven), lower.Define(first), lower.Define(inner), lower.Define(new_first), lower.Define(nine), lower.Define(second), lower.Define(outer)]:
                    literal(seven, 7)
                        .and(argument_is(first, seven.id))
                        .and(projects(old_second, parent, 1, specialized.IntegerType(Int64Format)))
                        .and(constructs(inner, 0, first.id, 1, old_second.id))
                        .and(literal(nine, 9))
                        .and(argument_is(second, nine.id))
                        .and(projects(new_first, inner, 0, specialized.IntegerType(Int64Format)))
                        .and(constructs(outer, 1, second.id, 0, new_first.id))
                        .and(
                            int_ops.equals(
                                lower.value_number(inner.id),
                                lower.value_number(outer.id),
                            ).not(),
                        )
                        .and(returned(function, outer.id))
                _:
                    False


pure func test_replacing_a_field_with_itself_still_constructs_a_result() -> Bool:
    source = PAIR.concat(
        |func change(value: Pair) -> Pair:
        |    { value | first = value.first }
        |func main() -> Int:
        |    change(base()).first
        |
    )
    match changed(source):
        Err(_):
            False
        Ok(function):
            match function.steps:
                [lower.Define(parent), lower.Define(replacement), lower.Define(inherited), lower.Define(result)]:
                    projects(replacement, parent, 0, specialized.IntegerType(Int64Format))
                        .and(projects(inherited, parent, 1, specialized.IntegerType(Int64Format)))
                        .and(constructs(result, 0, replacement.id, 1, inherited.id))
                        .and(
                            int_ops.equals(
                                lower.value_number(result.id),
                                lower.value_number(parent.id),
                            ).not(),
                        )
                        .and(returned(function, result.id))
                _:
                    False


pure func test_storage_appends_written_replacements_then_inherited_fields() -> Bool:
    source: String =
        |record Triple { first: Int, second: Int, third: Int }
        |func base() -> Triple:
        |    { first = 1, second = 2, third = 3 }
        |func change() -> Triple:
        |    { base() | third = 9, first = 7 }
        |func main() -> Int:
        |    change().first
        |
    match changed(source):
        Err(_):
            False
        Ok(function):
            match function.steps:
                [lower.Define(parent), lower.Define(second), lower.Define(nine), lower.Define(seven), lower.Define(result)]:
                    match result.operation:
                        lower.ConstructRecordValue(_, [third_field, first_field, second_field]):
                            literal(nine, 9)
                                .and(literal(seven, 7))
                                .and(
                                    projects(
                                        second,
                                        parent,
                                        1,
                                        specialized.IntegerType(Int64Format),
                                    ),
                                )
                                .and(int_ops.equals(specialized.field_number(third_field.field), 2))
                                .and(int_ops.equals(specialized.field_number(first_field.field), 0))
                                .and(
                                    int_ops.equals(specialized.field_number(second_field.field), 1),
                                )
                                .and(
                                    int_ops.equals(
                                        lower.value_number(third_field.value),
                                        lower.value_number(nine.id),
                                    ),
                                )
                                .and(
                                    int_ops.equals(
                                        lower.value_number(first_field.value),
                                        lower.value_number(seven.id),
                                    ),
                                )
                                .and(
                                    int_ops.equals(
                                        lower.value_number(second_field.value),
                                        lower.value_number(second.id),
                                    ),
                                )
                                .and(returned(function, result.id))
                        _:
                            False
                _:
                    False


-- Replacement reads of the base are projected once, before any replacement
-- runs, so the base's last use precedes the first replacement. Projections
-- keep the order in which the replacements first read them.
pure func test_replacement_reads_are_projected_before_replacements_run() -> Bool:
    source = PAIR.concat(
        |func change(value: Pair) -> Pair:
        |    { value | first = observe(value.second), second = observe(value.first) }
        |func main() -> Int:
        |    change(base()).first
        |
    )
    match changed(source):
        Err(_):
            False
        Ok(function):
            match function.steps:
                [lower.Define(parent), lower.Define(second_read), lower.Define(first_read), lower.Define(first), lower.Define(second), lower.Define(result)]:
                    projects(second_read, parent, 1, specialized.IntegerType(Int64Format))
                        .and(projects(first_read, parent, 0, specialized.IntegerType(Int64Format)))
                        .and(argument_is(first, second_read.id))
                        .and(argument_is(second, first_read.id))
                        .and(constructs(result, 0, first.id, 1, second.id))
                        .and(returned(function, result.id))
                _:
                    False


-- A field no replacement names is projected before the first replacement runs,
-- so the base has no read left once the replacement starts.
pure func test_inherited_fields_are_projected_before_the_replacement_runs() -> Bool:
    source = PAIR.concat(
        |func change(value: Pair) -> Pair:
        |    { value | first = observe(value.first) }
        |func main() -> Int:
        |    change(base()).first
        |
    )
    match changed(source):
        Err(_):
            False
        Ok(function):
            match function.steps:
                [lower.Define(parent), lower.Define(first_read), lower.Define(second_read), lower.Define(first), lower.Define(result)]:
                    projects(first_read, parent, 0, specialized.IntegerType(Int64Format))
                        .and(projects(second_read, parent, 1, specialized.IntegerType(Int64Format)))
                        .and(argument_is(first, first_read.id))
                        .and(constructs(result, 0, first.id, 1, second_read.id))
                        .and(returned(function, result.id))
                _:
                    False


-- A field that is read by a replacement and inherited is projected once.
pure func test_inherited_field_read_by_a_replacement_is_projected_once() -> Bool:
    source = PAIR.concat(
        |func change(value: Pair) -> Pair:
        |    { value | first = observe(value.second) }
        |func main() -> Int:
        |    change(base()).first
        |
    )
    match changed(source):
        Err(_):
            False
        Ok(function):
            match function.steps:
                [lower.Define(parent), lower.Define(second_read), lower.Define(first), lower.Define(result)]:
                    projects(second_read, parent, 1, specialized.IntegerType(Int64Format))
                        .and(argument_is(first, second_read.id))
                        .and(constructs(result, 0, first.id, 1, second_read.id))
                        .and(returned(function, result.id))
                _:
                    False


-- Only reads of the base binding are hoisted; another record's field is not.
pure func test_reads_of_another_binding_are_not_hoisted() -> Bool:
    source = PAIR.concat(
        |func change(value: Pair, other: Pair) -> Pair:
        |    { value | first = observe(other.first) }
        |func main() -> Int:
        |    change(base(), base()).first
        |
    )
    match changed(source):
        Err(_):
            False
        Ok(function):
            match function.steps:
                [lower.Define(parent), lower.Define(other), lower.Define(inherited), lower.Define(other_first), lower.Define(first), lower.Define(result)]:
                    projects(other_first, other, 0, specialized.IntegerType(Int64Format))
                        .and(argument_is(first, other_first.id))
                        .and(projects(inherited, parent, 1, specialized.IntegerType(Int64Format)))
                        .and(constructs(result, 0, first.id, 1, inherited.id))
                        .and(returned(function, result.id))
                _:
                    False


-- The inner update's base `value.inner` is the outer projection. The inner
-- update scans nothing, because its base is not a binding, but its inherited
-- field is projected before its replacement and the replacement's read of that
-- field resolves to it.
pure func test_nested_update_base_resolves_to_the_outer_projection() -> Bool:
    source = PAIR.concat(
        |record Outer { inner: Pair, ignored: Int }
        |func outer() -> Outer:
        |    { inner = base(), ignored = 3 }
        |func change(value: Outer) -> Outer:
        |    { value | inner = { value.inner | first = observe(value.inner.second) } }
        |func main() -> Int:
        |    change(outer()).ignored
        |
    )
    match changed(source):
        Err(_):
            False
        Ok(function):
            match function.steps:
                [lower.Define(parent), lower.Define(inner_read), lower.Define(ignored), lower.Define(second), lower.Define(first), lower.Define(inner), lower.Define(outer)]:
                    projects(inner_read, parent, 0, inner.value_type)
                        .and(projects(ignored, parent, 1, specialized.IntegerType(Int64Format)))
                        .and(projects(second, inner_read, 1, specialized.IntegerType(Int64Format)))
                        .and(argument_is(first, second.id))
                        .and(constructs(inner, 0, first.id, 1, second.id))
                        .and(constructs(outer, 0, inner.id, 1, ignored.id))
                        .and(returned(function, outer.id))
                _:
                    False


-- A nested update's replacement reads a field the outer update reads too. The
-- field is projected once. A nested update on the same base value, which would
-- project it a second time, cannot be written yet: the field would need the
-- record's own type, and recursive records are deferred.
pure func test_a_field_read_twice_by_nested_replacements_is_projected_once() -> Bool:
    source = PAIR.concat(
        |record Outer { inner: Pair, count: Int }
        |func outer() -> Outer:
        |    { inner = base(), count = 3 }
        |func change(whole: Outer, other: Pair) -> Outer:
        |    { whole | inner = { other | first = whole.count }, count = whole.count }
        |func main() -> Int:
        |    change(outer(), base()).count
        |
    )
    match changed(source):
        Err(_):
            False
        Ok(function):
            match function.steps:
                [lower.Define(whole), lower.Define(other), lower.Define(count_read), lower.Define(old_second), lower.Define(inner), lower.Define(result)]:
                    projects(count_read, whole, 1, specialized.IntegerType(Int64Format))
                        .and(projects(old_second, other, 1, specialized.IntegerType(Int64Format)))
                        .and(constructs(inner, 0, count_read.id, 1, old_second.id))
                        .and(constructs(result, 0, inner.id, 1, count_read.id))
                        .and(returned(function, result.id))
                _:
                    False


private pure func update_arm(
    arm: lower.JoinArm,
    parent: lower.ValueDefinition,
    start: Int,
    ordinal: Int,
    number: Int,
) -> Bool:
    match (arm.steps, arm.exit):
        ([lower.Define(inherited), lower.Define(value), lower.Define(replacement), lower.Define(result)], lower.Yield(outputs)):
            yielded = int_ops.equals(
                lower.value_number(outputs.value),
                lower.value_number(result.id),
            )
            stored = constructs(result, ordinal, replacement.id, 1 - ordinal, inherited.id)
            yielded
                .and(stored)
                .and(literal(value, number))
                .and(argument_is(replacement, value.id))
                .and(projects(inherited, parent, 1 - ordinal, specialized.IntegerType(Int64Format)))
                .and(int_ops.equals(lower.value_number(inherited.id), start))
                .and(int_ops.equals(lower.value_number(value.id), start + 1))
                .and(int_ops.equals(lower.value_number(replacement.id), start + 2))
                .and(int_ops.equals(lower.value_number(result.id), start + 3))
        _:
            False


pure func test_match_arms_keep_updates_local_and_value_ids_distinct() -> Bool:
    source = PAIR.concat(
        |union Flag:
        |    First
        |    Second
        |func change(flag: Flag, value: Pair) -> Pair:
        |    match flag:
        |        First: { value | first = observe(7) }
        |        Second: { value | second = observe(9) }
        |func main() -> Int:
        |    change(First, base()).first
        |
    )
    match changed(source):
        Err(_):
            False
        Ok(function):
            match function.steps:
                [lower.Define(flag), lower.Define(parent), lower.Join(_)]:
                    match lowered_tail_join(function):
                        Some(matched):
                            match matched.arms:
                                [first, second]:
                                    int_ops.equals(
                                        lower.value_number(matched.selection.scrutinee),
                                        lower.value_number(flag.id),
                                    )
                                        .and(update_arm(first, parent, 3, 0, 7))
                                        .and(update_arm(second, parent, 7, 1, 9))
                                _:
                                    False
                        _:
                            False
                _:
                    False


TESTS: TestSuite = {
    description = "Record update lowering",
    tests = [
        (
            "base call and RHS order precede written-order storage",
            test_base_call_and_rhs_order_precede_written_order_storage,
        ),
        (
            "binding alias reuses identity and inherited projection",
            test_binding_alias_reuses_identity_and_inherited_projection,
        ),
        (
            "postfix base is evaluated once with full span",
            test_postfix_base_is_evaluated_once_and_preserves_projection_span,
        ),
        (
            "nested update reads the completed inner record",
            test_nested_updates_use_the_completed_inner_record,
        ),
        (
            "storage appends written replacements then inherited fields",
            test_storage_appends_written_replacements_then_inherited_fields,
        ),
        (
            "same field value still constructs a result",
            test_replacing_a_field_with_itself_still_constructs_a_result,
        ),
        (
            "match updates have local distinct identities",
            test_match_arms_keep_updates_local_and_value_ids_distinct,
        ),
        (
            "replacement reads are projected before replacements run",
            test_replacement_reads_are_projected_before_replacements_run,
        ),
        (
            "inherited fields are projected before the replacement runs",
