-- Direct raw-IR constructors shared by independent verifier tests. These
-- create decision graphs only; no insertion, parsing or expected result oracle.
import:
    ../../../../../src/common/analysis/check/model as model
    ../../../../../src/common/codegen/lower/lower as lower
    ../../../../../src/common/codegen/own/own as own
    ../../../../../src/common/codegen/specialize/specialize as specialized


pure func direct(scrutinee: own.OwnedArgument) -> own.OwnedSelection:
    {
        scrutinee = scrutinee,
        nodes = [own.EnterArm({ arm = model.match_arm_id(0), operations = [], transfers = [] })],
        entry = model.decision_node_id(0),
    }


pure func branches(
    scrutinee: own.OwnedArgument,
    variant: specialized.VariantInstanceId,
) -> own.OwnedSelection:
    {
        scrutinee = scrutinee,
        nodes = [
            own.EnterArm({ arm = model.match_arm_id(0), operations = [], transfers = [] }),
            own.EnterArm({ arm = model.match_arm_id(1), operations = [], transfers = [] }),
            own.TestVariant(
                {
                    value_type = specialized.UnionType(specialized.variant_owner(variant)),
                    route = specialized.MatchRoot,
                },
                variant,
                model.decision_node_id(0),
                model.decision_node_id(1),
            ),
        ],
        entry = model.decision_node_id(2),
    }


pure func lowered_direct(scrutinee: lower.ValueId) -> lower.LoweredSelection:
    {
        scrutinee = scrutinee,
        nodes = [lower.EnterArm({ arm = model.match_arm_id(0), definitions = [], arguments = [] })],
        entry = model.decision_node_id(0),
    }


pure func lowered_branches(
    scrutinee: lower.ValueId,
    variant: specialized.VariantInstanceId,
) -> lower.LoweredSelection:
    {
        scrutinee = scrutinee,
        nodes = [
            lower.EnterArm({ arm = model.match_arm_id(0), definitions = [], arguments = [] }),
            lower.EnterArm({ arm = model.match_arm_id(1), definitions = [], arguments = [] }),
            lower.TestVariant(
                {
                    value_type = specialized.UnionType(specialized.variant_owner(variant)),
                    route = specialized.MatchRoot,
                },
                variant,
                model.decision_node_id(0),
                model.decision_node_id(1),
            ),
        ],
        entry = model.decision_node_id(2),
    }


-- Copy only structural identity/tests from a Lower seed. Tested operations and
-- input signatures remain authored by the caller, independently of insertion.
pure func empty_from_lower(
    selection: lower.LoweredSelection,
    scrutinee: own.OwnedArgument,
) -> own.OwnedSelection:
    { scrutinee = scrutinee, entry = selection.entry, nodes = selection.nodes.map(empty_node) }


private pure func empty_node(node: lower.LoweredDecisionNode) -> own.OwnedDecisionNode:
    match node:
        lower.TestVariant(place, variant, yes, no): own.TestVariant(place, variant, yes, no)
        lower.TestListLength(place, test, yes, no): own.TestListLength(place, test, yes, no)
        lower.TestLiteral(place, literal, yes, no): own.TestLiteral(place, literal, yes, no)
        lower.EnterArm(edge): own.EnterArm({ arm = edge.arm, operations = [], transfers = [] })
