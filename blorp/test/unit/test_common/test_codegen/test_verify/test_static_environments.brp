---
A runtime closure keeps its environment alive through the cell's count, so
verification rejects a by-value environment in one, whatever produced it,
and accepts a by-value environment passed only to static callees.
---
import:
    bool: and
    result: Result methods
    test: TestSuite
    ../../../../../src/common/codegen/own/own as own
    ../../../../../src/common/codegen/specialize/specialize as specialized
    ../../../../../src/common/codegen/verify/verify: verify
    ../../../../../src/common/syntax/syntax: IntegerFormat(Int64Format), Span
    ../../../list_update_inputs: lowered


private pure func owned_program(source: String) -> Option[own.OwnershipProgram]:
    match lowered(source).and_then(own.own):
        Ok(program): Some(program)
        Err(_): None


-- The span of the one captured-callable creation, the runtime closure.
private pure func closure_creation(program: own.OwnershipProgram) -> Option[Span]:
    var found: Option[Span] = None
    for function in program.functions:
        for operation in function.operations:
            match operation:
                own.DefineValue(definition):
                    match definition.operation:
                        own.CapturedCallableDefinition(_, _): found = Some(definition.span)
                        _: void
                _:
                    void
    found


pure func test_static_environment_stored_by_value_verifies() -> Bool:
    source: String =
        |pure func apply(callback: pure (Int) -> Int, value: Int) -> Int:
        |    callback(value)
        |func main() -> Int:
        |    amount = 2
        |    apply(pure func(item: Int) -> Int: amount, 40)
        |
    match owned_program(source):
        None:
            False
        Some(program):
            and(
                program.records.any(pure func(layout: specialized.ConcreteRecord) -> Bool:
                    match layout:
                        specialized.ValueFields([specialized.IntegerType(Int64Format)]): True
                        _: False
                ),
                verify(program).is_ok(),
            )


pure func test_by_value_environment_in_a_runtime_closure_is_rejected() -> Bool:
    source: String =
        |func main() -> Int:
        |    amount = 2
        |    callback: pure (Int) -> Int = pure func(item: Int) -> Int: amount
        |    callback(40)
        |
    match owned_program(source):
        None:
            False
        Some(program):
            records = program.records.map(
                pure func(layout: specialized.ConcreteRecord) -> specialized.ConcreteRecord:
                    match layout:
                        specialized.CountedFields(fields): specialized.ValueFields(fields)
                        _: layout
            )
            match (
                closure_creation(program),
                verify(program).is_ok(),
                verify({ program | records = records }),
            ):
                (Some(span), True, Err(error)):
                    and(
                        and(
                            (
                                error.message
                                == "ownership verification failed: callable environment must be a counted record"
                            ),
                            error.help == "report this compiler error with the input program",
                        ),
                        error.span == span,
                    )
                _:
                    False


TESTS: TestSuite = {
    description = "Verified by-value capture environments",
    tests = [
        (
            "a static environment stored by value verifies",
            test_static_environment_stored_by_value_verifies,
        ),
        (
            "a by-value environment in a runtime closure is rejected",
            test_by_value_environment_in_a_runtime_closure_is_rejected,
        ),
    ],
}
