import:
    bool: Bool methods
    int: Int methods
    list: List methods
    option: Option methods
    result: Result methods
    string: String methods
    test: TestSuite
    ../../../../../src/common/codegen/own/own as own
    ../../../../../src/common/codegen/specialize/specialize as specialized
    ../../../../../src/common/codegen/verify/verify: verify
    ../../../../../src/common/syntax/syntax:
        IntegerFormat(Int64Format),
        Entrypoint(WithArguments),
        EntryResult(IntegerExitStatus),
        entry_function,
    ../../../list_update_inputs: lowered, UPDATE_DECLARATIONS


-- Inferred labels, named explicitly so these negatives do not depend on
-- which labelling production uses.
private pure func owned_program(body: String) -> Option[own.OwnershipProgram]:
    match lowered(UPDATE_DECLARATIONS + body).and_then(
        pure func(program): own.insert_ownership(program, own.InferredLabels),
    ):
        Ok(program): Some(program)
        Err(_): None


private pure func rewrite_operations(
    function: own.OwnedFunction,
    rewrite: pure (own.OwnedDefinition) -> own.OwnedDefinition,
) -> own.OwnedFunction:
    operations = function.operations.map(
        pure func(operation: own.OwnershipOperation) -> own.OwnershipOperation:
            match operation:
                own.DefineValue(definition): own.DefineValue(rewrite(definition))
                _: operation
    )
    { function | operations = operations }


-- Rewrites the arguments of every user call in the entry function.
private pure func rewrite_entry_calls(
    program: own.OwnershipProgram,
    rewrite: pure (List[own.OwnedArgument]) -> List[own.OwnedArgument],
) -> own.OwnershipProgram:
    index = specialized.function_number(entry_function(program.entrypoint))
    match program.functions.get(index):
        None:
            program
        Some(entry):
            rewritten = rewrite_operations(
                entry,
                pure func(definition: own.OwnedDefinition) -> own.OwnedDefinition:
                    match definition.operation:
                        own.CallDefinition(specialized.UserFunction(callee), arguments):
                            { definition |
                                operation = own.CallDefinition(
                                    specialized.UserFunction(callee),
                                    rewrite(arguments),
                                ),
                            }
                        _:
                            definition
            )
            { program | functions = program.functions.set(index, rewritten) }


-- The instance the entry calls first.
private pure func entry_callee(
    program: own.OwnershipProgram,
) -> Option[specialized.FunctionInstanceId]:
    var found: Option[specialized.FunctionInstanceId] = None
    match program.functions.get(specialized.function_number(entry_function(program.entrypoint))):
        None:
            void
        Some(entry):
            for operation in entry.operations:
                match operation:
                    own.DefineValue(definition):
                        match definition.operation:
                            own.CallDefinition(specialized.UserFunction(callee), _):
                                if found.is_none():
                                    found = Some(callee)
                            _:
                                void
                    _:
                        void
    found


private pure func rejects(program: own.OwnershipProgram, message: String) -> Bool:
    match verify(program):
        Ok(_): False
        Err(error): error.message.equals("ownership verification failed: ${message}")


-- Both positions own; the call moves `first` into position 0 and acquires
-- for position 1.
BOTH_OWNED: String =
    |pure func both(left: List[Int], right: List[Int]) -> Int:
    |    length(append(left, length(append(right, 1))))
    |func main() -> Int:
    |    first: List[Int] = []
    |    both(first, first)
    |


-- Position 0 owns and position 1 borrows; the borrow of `first` keeps the
-- call from moving its owner, so position 0 acquires.
OWNED_THEN_BORROWED: String =
    |pure func grow(items: List[Int], other: List[Int]) -> List[Int]:
    |    append(items, length(other))
    |func main() -> Int:
    |    first: List[Int] = []
    |    length(grow(first, first))
    |


-- `box` owns: its projection is acquired after its last use, so the
-- acquisition may be unique and is consumed. The entry passes `b.items`
-- through its own acquired owner.
PROJECTED: String =
    |record Box { items: List[Int] }
    |pure func take(box: Box, other: List[Int]) -> Int:
    |    length(append(box.items, length(other)))
    |func main() -> Int:
    |    b: Box = { items = [1] }
    |    take(b, b.items)
    |


pure func test_inserted_owned_calls_verify() -> Bool:
    match (owned_program(BOTH_OWNED), owned_program(OWNED_THEN_BORROWED), owned_program(PROJECTED)):
        (Some(both), Some(grow), Some(projected)):
            verify(both)
                .is_ok()
                .and(verify(grow).is_ok())
                .and(verify(projected).is_ok())
        _:
            False


pure func test_one_owner_consumed_at_two_owned_positions_is_rejected() -> Bool:
    match owned_program(BOTH_OWNED):
        None:
            False
        Some(program):
            doubled = rewrite_entry_calls(
                program,
                pure func(arguments: List[own.OwnedArgument]) -> List[own.OwnedArgument]:
                    match arguments:
                        [own.ConsumedArgument(first, owner), own.ConsumedArgument(second, _)]:
                            [
                                own.ConsumedArgument(first, owner),
                                own.ConsumedArgument(second, owner),
                            ]
                        _:
                            arguments
            )
            -- `first` is the entry's first owner.
            rejects(doubled, "owner 0 has already been discharged")


pure func test_a_borrow_backed_by_a_moved_owner_is_rejected() -> Bool:
    match owned_program(OWNED_THEN_BORROWED):
        None:
            False
        Some(program):
            moved = rewrite_entry_calls(
                program,
                pure func(arguments: List[own.OwnedArgument]) -> List[own.OwnedArgument]:
                    match arguments:
                        [own.ConsumedArgument(first, _), own.BorrowedArgument(borrow)]:
                            match borrow.source:
                                own.OwnerBorrow(owner):
                                    [
                                        own.ConsumedArgument(first, owner),
                                        own.BorrowedArgument(borrow),
                                    ]
                                _:
                                    arguments
                        _:
                            arguments
            )
            rejects(moved, "borrow refers to discharged owner 0")


-- The borrowed position names the projection through its parent rather
-- than its acquired owner, so only projection ancestry reaches the moved box.
pure func test_a_projection_of_a_moved_owner_is_rejected() -> Bool:
    match owned_program(PROJECTED):
        None:
            False
        Some(program):
            through_parent = rewrite_entry_calls(
                program,
                pure func(arguments: List[own.OwnedArgument]) -> List[own.OwnedArgument]:
                    match arguments:
                        [own.ConsumedArgument(box, owner), own.BorrowedArgument(items)]:
                            [
                                own.ConsumedArgument(box, owner),
                                own.BorrowedArgument({
                                    value = items.value,
                                    source = own.PayloadBorrow(box),
                                }),
                            ]
                        _:
                            arguments
            )
            -- The box is the entry's second owner: the List literal moves into it.
            rejects(through_parent, "borrow refers to discharged owner 1")


pure func test_a_borrowed_argument_at_an_owned_position_is_rejected() -> Bool:
    match owned_program(OWNED_THEN_BORROWED):
        None:
            False
        Some(program):
            borrowed = rewrite_entry_calls(
                program,
                pure func(arguments: List[own.OwnedArgument]) -> List[own.OwnedArgument]:
                    match arguments:
                        [own.ConsumedArgument(first, owner), other]:
                            [
                                own.BorrowedArgument({
                                    value = first,
                                    source = own.OwnerBorrow(owner),
                                }),
                                other,
                            ]
                        _:
                            arguments
            )
            rejects(borrowed, "owned parameter requires a transferred argument")


pure func test_a_consumed_argument_at_a_borrowed_position_is_rejected() -> Bool:
    match owned_program(OWNED_THEN_BORROWED):
        None:
            False
        Some(program):
            consumed = rewrite_entry_calls(
                program,
                pure func(arguments: List[own.OwnedArgument]) -> List[own.OwnedArgument]:
                    match arguments:
                        [first, own.BorrowedArgument(borrow)]:
                            match borrow.source:
                                own.OwnerBorrow(owner):
                                    [first, own.ConsumedArgument(borrow.value, owner)]
                                _:
                                    arguments
                        _:
                            arguments
            )
            rejects(
                consumed,
                "consumed argument requires an owned parameter or an in-place operand",
            )


-- The callee keeps its owned parameter's obligation instead of handing it
-- to the in-place append.
pure func test_an_owned_parameter_live_at_return_is_rejected() -> Bool:
    match owned_program(OWNED_THEN_BORROWED):
        None:
            False
        Some(program):
            match entry_callee(program):
                None:
                    False
                Some(callee):
                    index = specialized.function_number(callee)
                    match program.functions.get(index):
                        None:
                            False
                        Some(grow):
                            kept = rewrite_operations(
                                grow,
                                pure func(definition: own.OwnedDefinition) -> own.OwnedDefinition:
                                    match definition.operation:
                                        own.CallDefinition(target, [own.ConsumedArgument(value, owner), ...rest]):
                                            { definition |
                                                operation = own.CallDefinition(
                                                    target,
                                                    [
                                                        own.BorrowedArgument({
                                                            value = value,
                                                            source = own.OwnerBorrow(owner),
                                                        }),
                                                    ].concat(rest),
                                                ),
                                            }
                                        _:
                                            definition
                            )
                            rejects(
                                { program | functions = program.functions.set(index, kept) },
                                "owner 0 remains live at return",
                            )


-- The entry wrapper passes its arguments borrowed. `helper` owns its
-- parameter and has the entry's signature, so only the pin rejects it.
pure func test_a_pinned_instance_with_an_owned_row_is_rejected() -> Bool:
    body: String =
        |pure func helper(values: List[String]) -> Int:
        |    length(append(values, "x"))
        |func main(arguments: List[String]) -> Int:
        |    helper(arguments)
        |
    match owned_program(body):
        None:
            False
        Some(program):
            match entry_callee(program):
                None:
                    False
                Some(helper):
                    verify(program)
                        .is_ok()
                        .and(
                            rejects(
                                { program | entrypoint = WithArguments(helper, IntegerExitStatus) },
                                "pinned instance has an owned parameter",
                            ),
                        )


-- `push_one` owns its parameter because the entry calls it directly. Taking
-- it as the entry's stored callable instead of the identically typed,
-- pinned `push_two` leaves a callable instance with an owned row.
pure func test_a_callable_instance_with_an_owned_row_is_rejected() -> Bool:
    body: String =
        |pure func push_one(values: List[Int]) -> List[Int]:
        |    append(values, 1)
        |pure func push_two(values: List[Int]) -> List[Int]:
        |    append(values, 2)
        |func main() -> Int:
        |    first: List[Int] = []
        |    second = push_one(first)
        |    callbacks: List[pure (List[Int]) -> List[Int]] = [push_two]
        |    match callbacks:
        |        [callback]: length(callback(second))
        |        _: 0
        |
    match owned_program(body):
        None:
            False
        Some(program):
            match (
                entry_callee(program),
                program.functions.get(
                    specialized.function_number(entry_function(program.entrypoint)),
                ),
            ):
                (Some(push_one), Some(entry)):
                    taken = rewrite_operations(
                        entry,
                        pure func(definition: own.OwnedDefinition) -> own.OwnedDefinition:
                            match definition.operation:
                                own.FreeCallableDefinition(_):
                                    { definition |
                                        operation = own.FreeCallableDefinition(push_one),
                                    }
                                _:
                                    definition
                    )
                    entry_index = specialized.function_number(entry_function(program.entrypoint))
                    verify(program)
                        .is_ok()
                        .and(
                            rejects(
                                { program | functions = program.functions.set(entry_index, taken) },
                                "pinned instance has an owned parameter",
                            ),
                        )
                _:
                    False


pure func test_a_row_that_disagrees_with_its_type_is_rejected() -> Bool:
    match owned_program(OWNED_THEN_BORROWED):
        None:
            False
        Some(program):
            match entry_callee(program):
                None:
                    False
                Some(callee):
                    index = specialized.function_number(callee)
                    match program.functions.get(index):
                        None:
                            False
                        Some(grow):
                            -- `other` is a managed List; claim it needs no ownership.
                            mislabelled = { grow |
                                parameters = grow.parameters.set(
                                    1,
                                    own.UnmanagedParameter(
                                        specialized.ListType(specialized.IntegerType(Int64Format)),
                                    ),
                                ),
                            }
                            rejects(
                                { program | functions = program.functions.set(index, mislabelled) },
                                "parameter row disagrees with its type's ownership",
                            )


-- The first failure in a function's signature wins. The entry's return type
-- names `take`'s record, which this program lacks; its argument row would be
-- rejected later for disagreeing with its type.
pure func test_the_first_invalid_signature_fact_is_reported() -> Bool:
    entry_body: String =
        |func main(arguments: List[String]) -> Int:
        |    length(arguments)
        |
    match (owned_program(PROJECTED), owned_program(entry_body)):
        (Some(boxed), Some(program)):
            entry_index = specialized.function_number(entry_function(program.entrypoint))
            match (entry_callee(boxed), program.functions.get(entry_index)):
                (Some(take_id), Some(entry)):
                    match boxed.functions.get(specialized.function_number(take_id)):
                        None:
                            False
                        Some(take):
                            match take.parameters.get(0):
                                None:
                                    False
                                Some(box_row):
                                    missing_record = own.parameter_type(box_row)
                                    disagreeing = own.UnmanagedParameter(
                                        specialized.ListType(specialized.StringType),
                                    )
                                    broken = { entry |
                                        return_type = missing_record,
                                        parameters = [disagreeing],
                                    }
                                    match verify(
                                        { program |
                                            functions = program.functions.set(entry_index, broken),
                                        },
                                    ):
                                        Ok(_):
                                            False
                                        Err(error):
                                            error.message.equals(
                                                "internal compiler error: invalid record identity in ownership representation",
                                            )
                _:
                    False
        _:
            False


-- `values` moves into `Done`, which the call to `extend` consumes.
STORED: String =
    |union Outcome:
    |    Done(List[Int])
    |    Failed(Int)
    |pure func extend(outcome: Outcome) -> Outcome:
    |    match outcome:
    |        Done(values): Done(append(values, 1))
    |        Failed(code): Failed(code)
    |pure func start(values: List[Int]) -> Outcome:
    |    extend(Done(values))
    |func main() -> Int:
    |    first: List[Int] = []
    |    match start(first):
    |        Done(values): length(values)
    |        Failed(code): code
    |


-- A mutation oracle independent of inference: every label owned, then the
-- owner `start` moves into `Done` dropped again straight after.
pure func test_an_owner_dropped_after_a_construction_moves_it_is_rejected() -> Bool:
    match lowered(UPDATE_DECLARATIONS + STORED).and_then(
        pure func(program): own.insert_ownership(program, own.AllOwnedExceptPinned),
    ):
        Err(_):
            False
        Ok(program):
            match entry_callee(program):
                None:
                    False
                Some(callee):
                    index = specialized.function_number(callee)
                    match program.functions.get(index):
                        None:
                            False
                        Some(start):
                            var operations: List[own.OwnershipOperation] = []
                            var moved: Option[own.OwnerId] = None
                            for operation in start.operations:
                                operations = operations.append(operation)
                                match operation:
                                    own.DefineValue(definition):
                                        match definition.operation:
                                            own.ConstructDefinition(_, [own.OwnedPayload(_, owner)]):
                                                moved = Some(owner)
                                                operations = operations.append(
                                                    own.DropOwner(owner, definition.span),
                                                )
                                            _:
                                                void
                                    _:
                                        void
                            match moved:
                                None:
                                    False
                                Some(owner):
                                    dropped_twice = { program |
                                        functions = program.functions.set(
                                            index,
                                            { start | operations = operations },
                                        ),
                                    }
                                    verify(program)
                                        .is_ok()
                                        .and(
                                            rejects(
                                                dropped_twice,
                                                "owner ${own.owner_number(owner)} has already been discharged",
                                            ),
                                        )


TESTS: TestSuite = {
    description = "Owned-parameter contract verification",
    tests = [
        ("inserted owned calls verify", test_inserted_owned_calls_verify),
        (
            "one owner consumed at two owned positions is rejected",
            test_one_owner_consumed_at_two_owned_positions_is_rejected,
        ),
        (
            "a borrow backed by a moved owner is rejected",
            test_a_borrow_backed_by_a_moved_owner_is_rejected,
        ),
        (
            "a projection of a moved owner is rejected",
            test_a_projection_of_a_moved_owner_is_rejected,
        ),
        (
            "a borrowed argument at an owned position is rejected",
            test_a_borrowed_argument_at_an_owned_position_is_rejected,
        ),
        (
            "a consumed argument at a borrowed position is rejected",
            test_a_consumed_argument_at_a_borrowed_position_is_rejected,
        ),
        (
            "an owned parameter live at return is rejected",
            test_an_owned_parameter_live_at_return_is_rejected,
        ),
        (
            "a pinned instance with an owned row is rejected",
            test_a_pinned_instance_with_an_owned_row_is_rejected,
        ),
        (
            "a callable instance with an owned row is rejected",
            test_a_callable_instance_with_an_owned_row_is_rejected,
        ),
        (
            "a row that disagrees with its type is rejected",
            test_a_row_that_disagrees_with_its_type_is_rejected,
        ),
        (
            "the first invalid signature fact is reported",
            test_the_first_invalid_signature_fact_is_reported,
        ),
        (
            "an owner dropped after a construction moves it is rejected",
            test_an_owner_dropped_after_a_construction_moves_it_is_rejected,
        ),
    ],
}
