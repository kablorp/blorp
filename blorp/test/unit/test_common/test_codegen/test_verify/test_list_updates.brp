private pure func rejects(program: own.OwnershipProgram, message: String, at: Int) -> Bool:
    match verify(program):
        Ok(_):
            False
        Err(error):
            error.message
                .equals("ownership verification failed: " + message)
                .and(error.help.equals("report this compiler error with the input program"))
                .and(error.span.source == span(at).source)
                .and(error.span.start.equals(at))
                .and(error.span.end.equals(at + 1))
                .and(error.note.is_none())


pure func test_independent_consuming_append_verifies() -> Bool:
    match input_ids():
        Err(_):
            False
        Ok(ids):
            verify(
                raw_append(ids, append_arguments(ids), [own.DropOwner(own.owner_id(1), span(40))]),
            ).is_ok()


pure func test_trailing_old_owner_drop_rejected() -> Bool:
    match input_ids():
        Err(_):
            False
        Ok(ids):
            rejects(
                raw_append(ids, append_arguments(ids), [own.DropOwner(own.owner_id(0), span(40))]),
                "owner 0 has already been discharged",
                40,
            )


pure func test_second_operand_cannot_be_consumed() -> Bool:
