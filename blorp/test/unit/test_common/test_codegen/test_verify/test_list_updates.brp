pure func test_stale_list_borrow_rejected() -> Bool:
    match input_ids():
        Err(_):
            False
        Ok(ids):
            read: own.OwnedDefinition = {
                id = ids.fourth,
                value_type = specialized.IntegerType(Int64Format),
                operation = own.CallDefinition(
                    specialized.RuntimeFunction(builtins.ListLength(specialized.StringType)),
                    [
                        own.BorrowedArgument({
                            value = ids.first,
                            source = own.OwnerBorrow(own.owner_id(0)),
                        }),
                    ],
                ),
                result = own.UnmanagedResult,
                span = span(40),
            }
            rejects(
                raw_append(ids, append_arguments(ids), [own.DefineValue(read)]),
                "borrow refers to discharged owner 0",
                40,
            )


pure func test_consumed_list_with_unmanaged_integer_verifies() -> Bool:
    match input_ids():
        Err(_): False
        Ok(ids): verify(raw_integer_append(ids, True)).is_ok()


pure func test_wrong_runtime_target_rejected() -> Bool:
    match input_ids():
        Err(_):
            False
        Ok(ids):
            program = raw_integer_append(ids, True)
            match program.functions:
                [main, worker]:
                    operations = worker.operations.map(
                        pure func(operation) -> own.OwnershipOperation:
                            match operation:
                                own.DefineValue(definition):
                                    match definition.operation:
                                        own.CallDefinition(_, _):
                                            own.DefineValue(
                                                { definition |
                                                    value_type = specialized.IntegerType(
                                                        Int64Format,
                                                    ),
                                                    operation = own.CallDefinition(
                                                        specialized.RuntimeFunction(
                                                            builtins.ListLength(
                                                                specialized.IntegerType(
                                                                    Int64Format,
                                                                ),
                                                            ),
                                                        ),
                                                        [
                                                            own.ConsumedArgument(
                                                                ids.first,
                                                                own.owner_id(0),
                                                            ),
                                                        ],
                                                    ),
                                                    result = own.UnmanagedResult,
                                                },
                                            )
                                        _:
                                            operation
                                _:
                                    operation
                    )
                    updated = { worker |
                        parameters = [],
                        return_type = specialized.IntegerType(Int64Format),
                        operations = operations.append(own.DropOwner(own.owner_id(0), span(40))),
                        result = own.UnmanagedReturn(ids.third),
                    }
                    rejects(
                        { program | functions = [main, updated] },
                        "consumed argument requires an owned parameter or an in-place operand",
                        30,
                    )
                _:
                    False


