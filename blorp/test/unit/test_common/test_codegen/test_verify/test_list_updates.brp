-- The guarded edge is authored directly, independently of ownership insertion.
-- Calls are forbidden here before transfer/lifetime checking can be reached.
private pure func forbidden_selection_call(ids: InputIds) -> own.OwnershipProgram:
    base = raw_append(ids, [], [])
    element: specialized.TypeRef = specialized.ListType(specialized.StringType)
    list_type: specialized.TypeRef = specialized.ListType(element)
    root: own.BorrowedValue = { value = ids.first, source = own.OwnerBorrow(own.owner_id(0)) }
    left: own.OwnedArgument = own.ConsumedArgument(ids.first, own.owner_id(0))
    projected: own.OwnedDefinition = {
        id = ids.third,
        value_type = element,
        operation = own.ListElementDefinition(0, ids.first),
        result = own.BorrowedResult(own.PayloadBorrow(ids.first)),
        span = span(20),
    }
    appended: own.OwnedDefinition = {
        id = ids.fourth,
        value_type = list_type,
        operation = own.CallDefinition(specialized.RuntimeFunction(builtins.ListAppend(element)), [
            left,
            own.BorrowedArgument({ value = ids.third, source = own.PayloadBorrow(ids.first) }),
        ]),
        result = own.OwnedResult(own.owner_id(2)),
        span = span(30),
    }
    join: own.OwnedJoin = {
        result = own.ManagedJoinParameter(
            { id = ids.second, value_type = list_type, span = span(15) },
            own.owner_id(1),
        ),
        carried = [],
        entering = [],
        selection = {
            scrutinee = own.BorrowedArgument(root),
            entry = model.decision_node_id(2),
            nodes = [
                own.EnterArm({
                    arm = model.match_arm_id(0),
                    operations = [own.DefineValue(projected), own.DefineValue(appended)],
                    transfers = [own.OwnedReturn(ids.fourth, own.owner_id(2))],
                }),
                own.EnterArm({
                    arm = model.match_arm_id(0),
                    operations = [own.AcquireOwner(own.owner_id(3), root, span(31))],
                    transfers = [own.OwnedReturn(ids.first, own.owner_id(3))],
                }),
                own.TestListLength(
                    { value_type = list_type, route = specialized.MatchRoot },
                    model.MinimumLength(1),
                    model.decision_node_id(0),
                    model.decision_node_id(1),
                ),
            ],
        },
        arms = [
            {
                id = model.match_arm_id(0),
                inputs = [
                    own.ManagedJoinParameter(
                        { id = ids.fifth, value_type = list_type, span = span(32) },
                        own.owner_id(4),
                    ),
                ],
                operations = [],
                exit = own.Yield({
                    transfer = own.OwnedReturn(ids.fifth, own.owner_id(4)),
                    carried = [],
                }),
            },
        ],
    }
    match base.functions:
        [main, worker]:
            { base |
                functions = [
                    main,
                    { worker |
                        parameters = [],
                        return_type = list_type,
                        operations = [
                            own.DefineValue({
                                id = ids.first,
                                value_type = list_type,
                                operation = own.ConstructListDefinition([]),
                                result = own.OwnedResult(own.owner_id(0)),
                                span = span(10),
                            }),
                            own.ExecuteJoin(join),
                            own.DropOwner(own.owner_id(0), span(40)),
                        ],
                        result = own.OwnedReturn(ids.second, own.owner_id(1)),
                    },
                ],
            }
        _:
            base


pure func test_selection_edge_cannot_append_a_projected_child() -> Bool:
    match input_ids():
        Err(_):
            False
        Ok(ids):
            rejects(
                forbidden_selection_call(ids),
                "selection edge contains an operation outside its local projections",
                10,
            )


