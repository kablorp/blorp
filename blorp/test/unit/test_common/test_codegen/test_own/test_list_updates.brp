-- Bounds are established upstream; this isolates Own's third-argument guard.
-- It deliberately does not use the independent verifier as its oracle.
pure func test_set_third_payload_dependency_prevents_transfer() -> Bool:
    match input_ids():
        Err(_):
            False
        Ok(ids):
            list_type: specialized.TypeRef = specialized.ListType(specialized.StringType)
            definitions: List[lower.ValueDefinition] = [
                child(ids.first),
                {
                    id = ids.second,
                    value_type = list_type,
                    operation = lower.ConstructListValue([ids.first]),
                    span = span(20),
                },
                {
                    id = ids.third,
                    value_type = specialized.StringType,
                    operation = lower.ListElementValue(0, ids.second),
                    span = span(25),
                },
                integer(ids.fourth, 0, 26),
                runtime(
                    ids.fifth,
                    builtins.ListSet(specialized.StringType),
                    [ids.second, ids.fourth, ids.third],
                    list_type,
                    30,
                ),
            ]
            match own.insert_function(
                lowered_function(definitions, ids.fifth, [], list_type),
                [],
                [],
            ):
                Err(_):
                    False
                Ok(owned):
                    var guarded: Bool = False
                    for operation in owned.operations:
                        match operation:
                            own.DefineValue(definition):
                                match definition.operation:
                                    own.CallDefinition(specialized.RuntimeFunction(builtins.ListSet(_)), [own.BorrowedArgument(left), own.UnmanagedArgument(index), own.BorrowedArgument(replacement)]):
                                        match replacement.source:
                                            own.PayloadBorrow(parent):
                                                guarded = lower.value_number(parent)
                                                    .equals(lower.value_number(left.value))
                                                    .and(
                                                        lower.value_number(index).equals(
                                                            lower.value_number(ids.fourth),
                                                        ),
                                                    )
                                            _:
                                                void
                                    _:
                                        void
                            _:
                                void
                    guarded.and(consumed_updates(owned.operations).equals(0))


pure func test_set_captured_owner_stays_borrowed() -> Bool:
    body: String =
        |pure func collect() -> List[Int]:
        |    original = [1]
        |    var again: Bool = True
        |    while again:
        |        unused = set(original, 0, 2)
        |        again = False
        |    original
        |func main() -> Int:
        |    unused = collect()
        |    0
        |
    source_consumes(body, 0)


pure func test_concat_in_an_arm_borrows_an_owner_read_after_the_join() -> Bool:
    body: String =
        |func main() -> Int:
        |    original = [1]
        |    flag: Bool = True
        |    selected = if flag:
        |        concat(original, [2])
        |    else:
        |        original
        |    length(original)
        |
    source_consumes(body, 0)


TESTS: TestSuite = {
    description = "List update ownership insertion",
    tests = [
        ("set local last use transfers first owner without old drop", test_set_local_transfers),
        (
            "concat local last use transfers first owner without old drop",
            test_concat_local_transfers,
        ),
        ("set parameter retains borrowed contract", test_set_parameter_borrows),
        ("concat parameter retains borrowed contract", test_concat_parameter_borrows),
        ("set later snapshot read prevents transfer", test_set_later_use_borrows),
        ("concat later snapshot read prevents transfer", test_concat_later_use_borrows),
        ("set loop accumulator transfers three-operand update", test_set_loop_transfers),
        ("concat loop accumulator transfers first input", test_concat_loop_transfers),
        ("concat same owner RHS prevents transfer", test_concat_same_owner_stays_borrowed),
        (
            "set third argument payload dependency prevents transfer",
            test_set_third_payload_dependency_prevents_transfer,
        ),
        ("set captured outer owner remains borrowed", test_set_captured_owner_stays_borrowed),
        (
            "concat in an arm borrows an owner read after the join",
            test_concat_in_an_arm_borrows_an_owner_read_after_the_join,
        ),
        (
            "later snapshot use keeps its old List root borrowed",
            test_later_snapshot_read_keeps_input_borrowed,
        ),
        ("captured outer-loop List stays borrowed", test_captured_outer_owner_stays_borrowed),
        (
            "an update in an arm borrows an owner read after the join",
            test_update_in_an_arm_borrows_an_owner_read_after_the_join,
        ),
        (
            "nearest nested loop consumes its own List",
            test_nearest_nested_loop_consumes_its_accumulator,
        ),
        (
            "an edge-acquired child lets its entering root transfer",
            test_edge_acquired_child_lets_its_entering_root_transfer,
        ),
        (
            "RHS payload dependency prevents consuming its List root",
            test_rhs_payload_dependency_prevents_root_consumption,
        ),
        (
            "nested payload List cannot transfer its ancestor owner",
            test_nested_payload_root_remains_borrowed,
        ),
        (
            "last local use transfers List owner without a second drop",
            test_local_last_use_transfers_without_old_drop,
        ),
        ("borrowed List parameter remains borrowed", test_parameter_keeps_borrowed_contract),
        (
            "direct accumulator loop consumes its carried List",
            test_direct_loop_consumes_carried_list,
        ),
    ],
}
