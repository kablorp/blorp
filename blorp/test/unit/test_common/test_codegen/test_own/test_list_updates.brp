import:
    bool: Bool methods
    int: Int methods
    list: List methods
    result: Result methods
    string: String methods
    test: TestSuite
    ../../../../../src/common/analysis/namespace/builtins as builtins
    ../../../../../src/common/codegen/lower/lower as lower
    ../../../../../src/common/codegen/own/own as own
    ../../../../../src/common/codegen/specialize/specialize as specialized
    ../../../../../src/common/codegen/verify/verify: verify
    ../../../../../src/common/syntax/syntax: IntegerFormat(Int64Format)
    ../../../list_update_inputs:
        input_ids,
        lowered_function,
        parameter,
        runtime,
        integer,
        span,
        child,
        empty_list,
        consumed_updates,
        no_consumed_drop,
        owned_source,
        program_consumed,
        program_updates,


pure func test_local_last_use_transfers_without_old_drop() -> Bool:
    match input_ids():
        Err(_):
            False
        Ok(ids):
            definitions = [
                empty_list(ids.first, specialized.StringType),
                child(ids.second),
                runtime(
                    ids.third,
                    builtins.ListAppend(specialized.StringType),
                    [ids.first, ids.second],
                    specialized.ListType(specialized.StringType),
                    30,
                ),
            ]
            match own.insert_function(
                lowered_function(
                    definitions,
                    ids.third,
                    [],
                    specialized.ListType(specialized.StringType),
                ),
                [],
                [],
            ):
                Err(_):
                    False
                Ok(owned):
                    consumed_updates(owned.operations)
                        .equals(1)
                        .and(no_consumed_drop(owned.operations))


pure func test_parameter_keeps_borrowed_contract() -> Bool:
    match input_ids():
        Err(_):
            False
        Ok(ids):
            definitions = [
                parameter(ids.first, specialized.ListType(specialized.StringType)),
                child(ids.second),
                runtime(
                    ids.third,
                    builtins.ListAppend(specialized.StringType),
                    [ids.first, ids.second],
                    specialized.ListType(specialized.StringType),
                    30,
                ),
            ]
            match own.insert_function(
                lowered_function(
                    definitions,
                    ids.third,
                    [specialized.ListType(specialized.StringType)],
                    specialized.ListType(specialized.StringType),
                ),
                [],
                [],
            ):
                Err(_): False
                Ok(owned): consumed_updates(owned.operations).equals(0)


pure func test_direct_loop_consumes_carried_list() -> Bool:
    body: String =
        |pure func collect() -> List[Int]:
        |    var values: List[Int] = []
        |    while less_than(length(values), 12):
        |        values = append(values, 7)
        |    values
        |func main() -> Int:
        |    unused = collect()
        |    0
        |
    match owned_source(body):
        Err(_):
            False
        Ok(program):
            program_consumed(program)
                .equals(1)
                .and(program_updates(program).equals(1))
                .and(verify(program).is_ok())
                .and(program.functions.all(pure func(owned): no_consumed_drop(owned.operations)))


private pure func source_consumes(body: String, expected: Int) -> Bool:
    match owned_source(body):
        Err(_):
            False
        Ok(program):
            program_consumed(program)
                .equals(expected)
                .and(program_updates(program).equals(1))
                .and(verify(program).is_ok())
                .and(program.functions.all(pure func(owned): no_consumed_drop(owned.operations)))


pure func test_later_snapshot_read_keeps_input_borrowed() -> Bool:
    match input_ids():
        Err(_):
            False
        Ok(ids):
            definitions = [
                empty_list(ids.first, specialized.StringType),
                child(ids.second),
                runtime(
                    ids.third,
                    builtins.ListAppend(specialized.StringType),
                    [ids.first, ids.second],
                    specialized.ListType(specialized.StringType),
                    30,
                ),
                runtime(
                    ids.fourth,
                    builtins.ListLength(specialized.StringType),
                    [ids.first],
                    specialized.IntegerType(Int64Format),
                    40,
                ),
            ]
            match own.insert_function(
                lowered_function(definitions, ids.fourth, [], specialized.IntegerType(Int64Format)),
                [],
                [],
            ):
                Err(_): False
                Ok(owned): consumed_updates(owned.operations).equals(0)


pure func test_captured_outer_owner_stays_borrowed() -> Bool:
    body: String =
        |pure func collect() -> List[Int]:
        |    original: List[Int] = []
        |    var again: Bool = True
        |    while again:
        |        unused = append(original, 7)
        |        again = False
        |    original
        |func main() -> Int:
        |    unused = collect()
        |    0
        |
    source_consumes(body, 0)


pure func test_update_in_an_arm_borrows_an_owner_read_after_the_join() -> Bool:
    body: String =
        |func main() -> Int:
        |    original: List[Int] = []
        |    flag: Bool = True
        |    selected = if flag:
        |        append(original, 7)
        |    else:
        |        original
        |    length(original)
        |
    source_consumes(body, 0)


pure func test_nearest_nested_loop_consumes_its_accumulator() -> Bool:
    body: String =
        |pure func collect() -> List[Int]:
        |    var result: List[Int] = []
        |    var again: Bool = True
        |    while again:
        |        var local: List[Int] = []
        |        while less_than(length(local), 12):
        |            local = append(local, 7)
        |        result = local
        |        again = False
        |    result
        |func main() -> Int:
        |    unused = collect()
        |    0
        |
    source_consumes(body, 1)


-- The selection edge acquires `first` as its own occurrence, so the dying
-- root enters the join and the arm's update may consume it.
pure func test_edge_acquired_child_lets_its_entering_root_transfer() -> Bool:
    body: String =
        |pure func collect() -> List[List[String]]:
        |    values = [["child"]]
        |    match values:
        |        [first, ..._]: append(values, first)
        |        []: values
        |func main() -> Int:
        |    unused = collect()
        |    0
        |
    source_consumes(body, 1)


-- Selection establishes projection bounds upstream. This direct Lower input
-- isolates insertion's RHS dependency decision; it is not a verifier oracle.
pure func test_rhs_payload_dependency_prevents_root_consumption() -> Bool:
    match input_ids():
        Err(_):
            False
        Ok(ids):
            definitions: List[lower.ValueDefinition] = [
                child(ids.first),
                {
                    id = ids.second,
                    value_type = specialized.ListType(specialized.StringType),
                    operation = lower.ConstructListValue([ids.first]),
                    span = span(20),
                },
                {
                    id = ids.third,
                    value_type = specialized.StringType,
                    operation = lower.ListElementValue(0, ids.second),
                    span = span(25),
                },
                runtime(
                    ids.fourth,
                    builtins.ListAppend(specialized.StringType),
                    [ids.second, ids.third],
                    specialized.ListType(specialized.StringType),
                    30,
                ),
            ]
            match own.insert_function(
                lowered_function(
                    definitions,
                    ids.fourth,
                    [],
                    specialized.ListType(specialized.StringType),
                ),
                [],
                [],
            ):
                Err(_):
                    False
                Ok(owned):
                    var borrowed: Bool = False
                    for operation in owned.operations:
                        match operation:
                            own.DefineValue(definition):
                                match definition.operation:
                                    own.CallDefinition(specialized.RuntimeFunction(builtins.ListAppend(_)), [own.BorrowedArgument(left), own.BorrowedArgument(right)]):
                                        match (left.source, right.source):
                                            (own.OwnerBorrow(_), own.PayloadBorrow(parent)):
                                                borrowed = lower.value_number(left.value)
                                                    .equals(lower.value_number(ids.second))
                                                    .and(
                                                        lower.value_number(right.value).equals(
                                                            lower.value_number(ids.third),
                                                        ),
                                                    )
                                                    .and(
                                                        lower.value_number(parent).equals(
                                                            lower.value_number(ids.second),
                                                        ),
                                                    )
                                            _:
                                                void
                                    _:
                                        void
                            _:
                                void
                    borrowed.and(consumed_updates(owned.operations).equals(0))


pure func test_nested_payload_root_remains_borrowed() -> Bool:
    match input_ids():
        Err(_):
            False
        Ok(ids):
            definitions: List[lower.ValueDefinition] = [
                empty_list(
                    ids.first,
                    specialized.ListType(specialized.ListType(specialized.StringType)),
                ),
                {
                    id = ids.second,
                    value_type = specialized.ListType(specialized.ListType(specialized.StringType)),
                    operation = lower.ListElementValue(0, ids.first),
                    span = span(15),
                },
                {
                    id = ids.third,
                    value_type = specialized.ListType(specialized.StringType),
                    operation = lower.ListElementValue(0, ids.second),
                    span = span(20),
                },
                child(ids.fourth),
                runtime(
                    ids.fifth,
                    builtins.ListAppend(specialized.StringType),
                    [ids.third, ids.fourth],
                    specialized.ListType(specialized.StringType),
                    30,
                ),
            ]
            match own.insert_function(
                lowered_function(
                    definitions,
                    ids.fifth,
                    [],
                    specialized.ListType(specialized.StringType),
                ),
                [],
                [],
            ):
                Err(_): False
                Ok(owned): consumed_updates(owned.operations).equals(0)


private pure func local_update(is_set: Bool, borrowed_parameter: Bool, later_read: Bool) -> Bool:
    match input_ids():
        Err(_):
            False
        Ok(ids):
            list_type: specialized.TypeRef = specialized.ListType(specialized.StringType)
            left = if borrowed_parameter:
                parameter(ids.first, list_type)
            else:
                empty_list(ids.first, specialized.StringType)
            right = if is_set:
                child(ids.second)
            else:
                empty_list(ids.second, specialized.StringType)
            index = integer(ids.third, 0, 25)
            update = if is_set:
                runtime(
                    ids.fourth,
                    builtins.ListSet(specialized.StringType),
                    [ids.first, ids.third, ids.second],
                    list_type,
                    30,
                )
            else:
                runtime(
                    ids.fourth,
                    builtins.ListConcat(specialized.StringType),
                    [ids.first, ids.second],
                    list_type,
                    30,
                )
            definitions = if later_read:
                [
                    left,
                    right,
                    index,
                    update,
                    runtime(
                        ids.fifth,
                        builtins.ListLength(specialized.StringType),
                        [ids.first],
                        specialized.IntegerType(Int64Format),
                        40,
                    ),
                ]
            else:
                [left, right, index, update]
            result = if later_read:
                ids.fifth
            else:
                ids.fourth
            return_type = if later_read:
                specialized.IntegerType(Int64Format)
            else:
                list_type
            parameters: List[specialized.TypeRef] = if borrowed_parameter:
                [list_type]
            else:
                []
            expected = if borrowed_parameter.or(later_read):
                0
            else:
                1
            match own.insert_function(
                lowered_function(definitions, result, parameters, return_type),
                [],
                [],
            ):
                Err(_):
                    False
                Ok(owned):
                    consumed_updates(owned.operations)
                        .equals(expected)
                        .and(no_consumed_drop(owned.operations))


pure func test_set_local_transfers() -> Bool:
    local_update(True, False, False)


pure func test_concat_local_transfers() -> Bool:
    local_update(False, False, False)


pure func test_set_parameter_borrows() -> Bool:
    local_update(True, True, False)


pure func test_concat_parameter_borrows() -> Bool:
    local_update(False, True, False)


pure func test_set_later_use_borrows() -> Bool:
    local_update(True, False, True)


pure func test_concat_later_use_borrows() -> Bool:
    local_update(False, False, True)


pure func test_set_loop_transfers() -> Bool:
    body: String =
        |pure func collect() -> List[Int]:
        |    var values: List[Int] = [1]
        |    var again: Bool = True
        |    while again:
        |        values = set(values, 0, 2)
        |        again = False
        |    values
        |func main() -> Int:
        |    unused = collect()
        |    0
        |
    source_consumes(body, 1)


pure func test_concat_loop_transfers() -> Bool:
    body: String =
        |pure func collect() -> List[Int]:
        |    var values: List[Int] = []
        |    while less_than(length(values), 12):
        |        values = concat(values, [7])
        |    values
        |func main() -> Int:
        |    unused = collect()
        |    0
        |
    source_consumes(body, 1)


