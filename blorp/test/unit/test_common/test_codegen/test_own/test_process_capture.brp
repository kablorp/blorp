import:
    bool: Bool methods
    int: Int methods
    test: TestSuite
    ../../../../../src/common/codegen/lower/lower as lower
    ../../../../../src/common/codegen/own/own as own
    ../../../module_input: test_base
    ../../../process_capture_inputs: process_seed


pure func test_lists_borrow_the_int_is_unmanaged_and_result_transfers_once() -> Bool:
    match process_seed(test_base()):
        Err(_):
            False
        Ok(seed):
            match own.insert_function(seed.query, lower.lowered_functions(seed.lowered).unions, []):
                Err(_):
                    False
                Ok(function):
                    match (function.operations, function.result):
                        ([_, _, _, _, _, _, own.DefineValue(result)], own.OwnedReturn(returned, moved)):
                            match (result.operation, result.result):
                                (own.CallDefinition(_, [own.BorrowedArgument(_), own.BorrowedArgument(_), own.BorrowedArgument(_), own.BorrowedArgument(_), own.BorrowedArgument(_), own.UnmanagedArgument(_)]), own.OwnedResult(owner)):
                                    lower.value_number(returned)
                                        .equals(lower.value_number(result.id))
                                        .and(
                                            own.owner_number(owner).equals(own.owner_number(moved)),
                                        )
                                _:
                                    False
                        _:
                            False


TESTS: TestSuite = {
    description = "Process builtin ownership",
    tests = [
        (
            "a String and four List[String] borrowed, the Int unmanaged, one owned Result",
            test_lists_borrow_the_int_is_unmanaged_and_result_transfers_once,
        ),
    ],
}
