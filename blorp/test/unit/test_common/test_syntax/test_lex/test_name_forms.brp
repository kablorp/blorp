import:
    list: join
    string as string_ops
    test: TestSuite
    ../../../../../src/common/syntax/lex: lex
    ../../../../../src/common/syntax/names: program_names
    ../../../../../src/common/syntax/source: module_source, root_module_id
    ../../../../../src/common/syntax/syntax:
        NameForm(CapitalizedCamel, LowerSnake, Malformed, SingleCapitalWord, UpperSnake),
        Symbol(Wildcard),
        TokenKind(IdentifierToken, SymbolToken),


-- The lexer classifies each identifier once; no later phase reads a spelling to
-- decide a naming rule.
private pure func form_word(form: NameForm) -> String:
    match form:
        LowerSnake: "lower"
        UpperSnake: "upper"
        SingleCapitalWord: "single"
        CapitalizedCamel: "camel"
        Malformed: "malformed"


-- The form of each identifier in `source`, in order; a wildcard shows as `_`.
private pure func forms(source: String) -> String:
    match lex(module_source(root_module_id()), source, program_names().names):
        Err(_):
            "lex error"
        Ok(program):
            var words: List[String] = []
            for token in program.tokens:
                match token.kind:
                    IdentifierToken(_, form): words = words.append(form_word(form))
                    SymbolToken(Wildcard): words = words.append("_")
                    _: void
            words.join(" ")


pure func test_lower_snake_words() -> Bool:
    string_ops.equals(forms("read_text x1 utf8_valid a_1 x"), "lower lower lower lower lower")


pure func test_upper_snake_words_have_an_underscore_and_no_lowercase() -> Bool:
    string_ops.equals(forms("MAX_DEPTH HTTP_2 A_1"), "upper upper upper")


pure func test_single_capital_words_fit_type_and_constant() -> Bool:
    string_ops.equals(forms("MAX T IO A1"), "single single single single")


pure func test_capitalized_camel_words_keep_consecutive_capitals() -> Bool:
    string_ops.equals(forms("ReadError IOError UInt8 Int"), "camel camel camel camel")


pure func test_misplaced_underscores_and_mixed_case_are_malformed() -> Bool:
    string_ops.equals(
        forms("_x a__b a_ A_b mixedCase _if __ A__B"),
        "malformed malformed malformed malformed malformed malformed malformed malformed",
    )


pure func test_lone_underscore_stays_the_wildcard() -> Bool:
    string_ops.equals(forms("_ x"), "_ lower")


TESTS: TestSuite = {
    description = "Identifier name forms",
    tests = [
        ("lower snake words", test_lower_snake_words),
        (
            "upper snake words have an underscore and no lowercase",
            test_upper_snake_words_have_an_underscore_and_no_lowercase,
        ),
        (
            "single capital words fit type and constant",
            test_single_capital_words_fit_type_and_constant,
        ),
        (
            "capitalized camel words keep consecutive capitals",
            test_capitalized_camel_words_keep_consecutive_capitals,
        ),
        (
            "misplaced underscores and mixed case are malformed",
            test_misplaced_underscores_and_mixed_case_are_malformed,
        ),
        ("lone underscore stays the wildcard", test_lone_underscore_stays_the_wildcard),
    ],
}
