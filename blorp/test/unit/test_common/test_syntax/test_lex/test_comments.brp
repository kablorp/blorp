import:
    string as string_ops
    test: TestSuite
    ../../../../../src/common/syntax/lex: lex
    ../../../../../src/common/syntax/names: program_names
    ../../../../../src/common/syntax/source: module_source, root_module_id
    ../../../../../src/common/utils/text as text_utils: concat
    ./test_lex: span_text


-- Each comment the lexer returned as `start:end`, with `:doc` for a
-- documentation block, one per line; or the lexing error's message.
private pure func comments_of(source: String) -> String:
    match lex(module_source(root_module_id()), source, program_names().names):
        Err(failure):
            "error: " + failure.error.message
        Ok(program):
            var text: String = ""

            for comment in program.comments:
                suffix: String = if comment.documentation:
                    ":doc\n"
                else:
                    "\n"
                text = (text + span_text(comment.span)) + suffix

            text


pure func test_comment_after_code_on_its_line() -> Bool:
    string_ops.equals(comments_of("x = 1 -- note\ny = 2\n"), "6:13\n")


pure func test_comment_only_line_between_code_lines() -> Bool:
    string_ops.equals(comments_of("a\n-- mid\nb\n"), "2:8\n")


pure func test_comment_lines_before_the_first_code_line() -> Bool:
    string_ops.equals(comments_of("-- one\n-- two\na\n"), "0:6\n7:13\n")


pure func test_documentation_block_is_one_comment_without_its_final_lf() -> Bool:
    string_ops.equals(comments_of("---\ndoc\n---\nx\n"), "0:11:doc\n")


pure func test_documentation_block_ending_the_source() -> Bool:
    string_ops.equals(comments_of("---\ndoc\n--- "), "0:12:doc\n")


pure func test_comment_on_a_continuation_line_inside_brackets() -> Bool:
    string_ops.equals(comments_of("f(\n    -- inside\n    1)\n"), "7:16\n")


pure func test_comment_ending_the_source_without_a_line_feed() -> Bool:
    string_ops.equals(comments_of("a -- end"), "2:8\n")


pure func test_comment_keeps_its_trailing_spaces() -> Bool:
    string_ops.equals(comments_of("a -- pad  \n"), "2:10\n")


pure func test_every_kind_of_comment_is_listed_in_source_order() -> Bool:
    string_ops.equals(
        comments_of("-- top\na -- trail\n---\ndoc\n---\n-- own\nf(\n    -- inside\n    1) -- last"),
        "0:6\n9:17\n18:29:doc\n30:36\n44:53\n61:68\n",
    )


pure func test_source_without_comments_has_none() -> Bool:
    string_ops.equals(comments_of("a\n\nb\n"), "")


pure func test_trailing_comment_on_a_continuation_line_after_code() -> Bool:
    string_ops.equals(comments_of("f(1, -- c\n    2)\n"), "5:9\n")


pure func test_documentation_block_after_code_and_trivia_lines() -> Bool:
    string_ops.equals(
        comments_of("a -- one\n\n-- two\n---\ndoc\n---\nb\n"),
        "2:8\n10:16\n17:28:doc\n",
    )


pure func test_comment_inside_an_interpolation_is_an_error_and_records_nothing() -> Bool:
    -- `"${x -- c}"`, with the opener built so this file's own string has no hole.
    source = "\""
        .concat(text_utils.concat("$", "{"))
        .concat("x -- c}\"")
    string_ops.equals(comments_of(source), "error: unterminated interpolation hole")


TESTS: TestSuite = {
    description = "Blorp lexer comments",
    tests = [
        ("comment after code on its line", test_comment_after_code_on_its_line),
        ("comment-only line between code lines", test_comment_only_line_between_code_lines),
        ("comment lines before the first code line", test_comment_lines_before_the_first_code_line),
        (
            "documentation block is one comment without its final LF",
            test_documentation_block_is_one_comment_without_its_final_lf,
        ),
        ("documentation block ending the source", test_documentation_block_ending_the_source),
        (
            "comment on a continuation line inside brackets",
            test_comment_on_a_continuation_line_inside_brackets,
        ),
        (
            "comment ending the source without an LF",
            test_comment_ending_the_source_without_a_line_feed,
        ),
        ("comment keeps its trailing spaces", test_comment_keeps_its_trailing_spaces),
        (
            "every kind of comment is listed in source order",
            test_every_kind_of_comment_is_listed_in_source_order,
        ),
        ("source without comments has none", test_source_without_comments_has_none),
        (
            "trailing comment on a continuation line after code",
            test_trailing_comment_on_a_continuation_line_after_code,
        ),
        (
            "documentation block after code and trivia lines",
            test_documentation_block_after_code_and_trivia_lines,
        ),
        (
            "comment inside an interpolation is an error and records nothing",
            test_comment_inside_an_interpolation_is_an_error_and_records_nothing,
        ),
    ],
}
