import:
    bool: Bool methods
    int: Int methods
    string: String methods
    test: TestSuite
    ../../../../../src/common/analysis/assemble: parsed_contents
    ../../../../../src/common/analysis/ids: inventory_functions
    ../../../../../src/common/syntax/syntax: ParsedBody(ParsedBuiltinBody)
    ../../../module_input: parse_modules


pure func test_process_label_has_the_literal_span() -> Bool:
    header = "func run(program: String, args: List[String], out: String, err: String, timeout: Int) -> Result[Int, String]:\n    builtin("
    source = "${header}\"process.run_to_files\")\nfunc main() -> Int:\n    0\n"
    match parse_modules([{ source = source, targets = [] }]):
        Err(_):
            False
        Ok(parsed):
            match inventory_functions(parsed_contents(parsed).declarations).get(0):
                Some(row):
                    match row.declaration.body:
                        ParsedBuiltinBody(_, span):
                            span.start
                                .equals(header.length())
                                .and(
                                    span.end.equals(
                                        header.length() + ("\"process.run_to_files\"".length()),
                                    ),
                                )
                        _:
                            False
                None:
                    False


TESTS: TestSuite = {
    description = "Process builtin label",
    tests = [("process label retains exact literal span", test_process_label_has_the_literal_span)],
}
