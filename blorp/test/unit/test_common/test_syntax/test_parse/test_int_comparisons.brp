import:
    int as int_ops
    option: is_none
    string as string_ops
    test: TestSuite
    ../../../../../src/common/analysis/assemble: parsed_contents
    ../../../../../src/common/analysis/ids: inventory_functions
    ../../../../../src/common/syntax/source: module_source, root_module_id
    ../../../../../src/common/syntax/syntax:
        ParsedBody(ParsedBuiltinBody),
        ParsedRuntimeOperation(IntegerLessThanBuiltin),
    ../../../module_input: parse_modules


func test_less_than_label_is_accepted_with_its_span() -> Bool:
    source: String =
        |pure func compare(left: Int, right: Int) -> Bool:
        |    builtin("int.less_than")
        |func main() -> Int:
        |    0
        |
    match parse_modules([{ source = source, targets = [] }]):
        Err(error):
            print_error(error.message)
            print_error(error.help)
            print_error(
                (int_ops.to_string(error.span.start) + "..") + int_ops.to_string(error.span.end),
            )
            False
        Ok(program):
            match inventory_functions(parsed_contents(program).declarations).get(0):
                Some(row):
                    match row.declaration.body:
                        ParsedBuiltinBody(IntegerLessThanBuiltin, span):
                            match span.source == module_source(root_module_id()):
                                False:
                                    False
                                True:
                                    match int_ops.equals(span.start, 62):
                                        False: False
                                        True: int_ops.equals(span.end, 77)
                        _:
                            False
                None:
                    False


pure func test_constructor_arguments_after_the_label_are_rejected() -> Bool:
    source: String =
        |pure func compare(left: Int, right: Int) -> Bool:
        |    builtin("int.less_than", True, False)
        |func main() -> Int:
        |    0
        |
    match parse_modules([{ source = source, targets = [] }]):
        Ok(_):
            False
        Err(error):
            match string_ops.equals(error.message, "expected ')' after the builtin label"):
                False:
                    False
                True:
                    match string_ops.equals(
                        error.help,
                        "give the builtin one quoted label; Bool and Option results use the foundation's unions",
                    ):
                        False:
                            False
                        True:
                            match int_ops.equals(error.span.start, 77):
                                False:
                                    False
                                True:
                                    match int_ops.equals(error.span.end, 78):
                                        False: False
                                        True: error.note.is_none()


TESTS: TestSuite = {
    description = "Signed Int ordering label admission",
    tests = [
        (
            "int.less_than accepts an ordinary comparison declaration",
            test_less_than_label_is_accepted_with_its_span,
        ),
        (
            "constructor arguments do not configure Bool tags",
            test_constructor_arguments_after_the_label_are_rejected,
        ),
    ],
}
