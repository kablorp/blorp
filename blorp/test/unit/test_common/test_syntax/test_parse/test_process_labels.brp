import:
    bool: Bool methods
    string: String methods
    test: TestSuite
    ../../../../../src/common/analysis/assemble: parsed_contents
    ../../../../../src/common/analysis/ids: inventory_functions
    ../../../../../src/common/syntax/syntax:
        ParsedBody(ParsedBuiltinBody),
        ParsedRuntimeOperation(SystemBuiltin),
        SystemOperation(ProcessCapture, ProcessFindProgram, ProcessFault),
    ../../../module_input: parse_modules


-- The label is spelled out here, so the test does not follow system_operation_label.
-- Parsing a label does not check the signature, so every label shares one. The
-- body keeps the span of the quoted label.
private pure func label_parses_to(label: String, expected: SystemOperation) -> Bool:
    header = "func operate(name: String) -> Result[String, Int]:\n    builtin("
    source = "${header}\"${label}\")\nfunc main() -> Int:\n    0\n"
    match parse_modules([{ source = source, targets = [] }]):
        Err(_):
            False
        Ok(program):
            match inventory_functions(parsed_contents(program).declarations).get(0):
                Some(row):
                    match row.declaration.body:
                        ParsedBuiltinBody(SystemBuiltin(parsed), span):
                            (parsed == expected)
                                .and(span.start == header.length())
                                .and(span.end == header.length() + "\"${label}\"".length())
                        _:
                            False
                None:
                    False


pure func test_capture_label() -> Bool:
    label_parses_to("process.capture", ProcessCapture)


pure func test_find_program_label() -> Bool:
    label_parses_to("process.find_program", ProcessFindProgram)


pure func test_fault_label() -> Bool:
    label_parses_to("process.fault", ProcessFault)


TESTS: TestSuite = {
    description = "Blorp process labels",
    tests = [
        ("process.capture parses to ProcessCapture", test_capture_label),
        ("process.find_program parses to ProcessFindProgram", test_find_program_label),
        ("process.fault parses to ProcessFault", test_fault_label),
    ],
}
