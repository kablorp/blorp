---
Tests for modules in folders, loaded from a library directory: nested, aliased
and relative imports load, and a module file beside a folder of the same name is
refused wherever an import passes through that name. The embedded layout's half
of the rule is in test_embedded_library.brp.
---
import:
    bool: Bool methods
    int: Int methods
    io/environment: get_current_directory
    list: List methods
    option: Option methods
    path as path_ops
    string: String methods
    test: TestSuite
    ../../../../../src/common/analysis/load/load: LibrarySource(LibraryDirectory), load_program
    ../../../../../src/common/syntax/source: SourceFile
    ../../../../../src/common/syntax/syntax: Diagnostic


private INPUTS: String = "blorp/test/unit/test_common/test_analysis/test_load/library_inputs/"


-- Each fixture's import block is "import:" and a line feed, then the row indented four spaces.
private IMPORT_ROW_START: Int = 12


private AMBIGUITY_HELP: String = "rename one of them; a module that belongs with the folder can move into it"


private func load(name: String) -> Result[List[SourceFile], Diagnostic]:
    match load_program("${INPUTS}${name}.brp", LibraryDirectory("${INPUTS}library")):
        Ok(loaded): Ok(loaded.sources.modules)
        Err(failure): Err(failure.diagnostic)


private func loaded_path(relative: String) -> String:
    match get_current_directory():
        Ok(directory): path_ops.normalize(path_ops.join(directory, "${INPUTS}${relative}"))
        Err(error): error


private func loads_with(name: String, module: String) -> Bool:
    expected = loaded_path(module)
    match load(name):
        Ok(rows): rows.any(pure func(row): row.path == expected)
        Err(_): False


func test_a_nested_library_module_loads() -> Bool:
    loads_with("nested", "library/io/error.brp")


func test_an_aliased_nested_library_module_loads() -> Bool:
    loads_with("aliased", "library/io/error.brp")


-- io/console.brp imports ./error, which resolves inside the folder.
func test_a_relative_import_inside_a_folder_loads() -> Bool:
    loads_with("relative_inside_folder", "library/io/console.brp").and(
        loads_with("relative_inside_folder", "library/io/error.brp"),
    )


-- The refusal of the import row `row`, which starts at `start` bytes into the
-- importing file, for the module or folder named `stem`.
private func refused(name: String, stem: String, start: Int, row: String) -> Bool:
    path = loaded_path(stem)
    match load(name):
        Ok(_):
            False
        Err(error):
            (error.message == "${path}.brp sits beside the folder ${path}/, so the import path names both a module and a folder")
                .and(error.help == AMBIGUITY_HELP)
                .and(error.span.start == start)
                .and(error.span.end == start + row.length())


-- `import: shadow` with shadow.brp beside shadow/.
func test_a_module_beside_its_folder_is_refused() -> Bool:
    refused("module_beside_folder", "library/shadow", IMPORT_ROW_START, "shadow: shadow_code")


-- `import: shadow/inner` passes through the name shadow.brp also owns.
func test_a_path_through_a_module_name_is_refused() -> Bool:
    refused(
        "path_through_module_name",
        "library/shadow",
        IMPORT_ROW_START,
        "shadow/inner: inner_code",
    )


func test_a_user_module_beside_its_folder_is_refused() -> Bool:
    refused("user/module_beside_folder", "user/helper", IMPORT_ROW_START, "./helper: helper_code")


func test_a_user_path_through_a_module_name_is_refused() -> Bool:
    refused(
        "user/path_through_module_name",
        "user/helper",
        IMPORT_ROW_START,
        "./helper/deep: deep_code",
    )


-- user/unrelated.brp and user/unrelated/ coexist, and nothing imports either.
func test_a_same_named_pair_that_nothing_imports_is_accepted() -> Bool:
    loads_with("user/accepted", "user/neighbor.brp")


TESTS: TestSuite = {
    description = "Blorp nested modules",
    tests = [
        ("a nested library module loads", test_a_nested_library_module_loads),
        ("an aliased nested library module loads", test_an_aliased_nested_library_module_loads),
        ("a relative import inside a folder loads", test_a_relative_import_inside_a_folder_loads),
        ("a module beside its folder is refused", test_a_module_beside_its_folder_is_refused),
        ("a path through a module name is refused", test_a_path_through_a_module_name_is_refused),
        (
            "a user module beside its folder is refused",
            test_a_user_module_beside_its_folder_is_refused,
        ),
        (
            "a user path through a module name is refused",
            test_a_user_path_through_a_module_name_is_refused,
        ),
        (
            "a same-named pair that nothing imports is accepted",
            test_a_same_named_pair_that_nothing_imports_is_accepted,
        ),
    ],
}
