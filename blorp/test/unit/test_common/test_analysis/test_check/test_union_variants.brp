---
`Union.Variant` in values and patterns: the union is found by name, so a
variant needs no annotation and no variant import, and a pattern's variant must
belong to the matched union. Each rejection program has exactly one problem and
pins its message, help and span.
---
import:
    bool: and, not
    int: Int methods
    list: List methods
    result: map_err
    string: String methods
    test: TestSuite
    ../../../../../src/common/codegen/generate_c: generate_c
    ../../../../../src/common/syntax/lex: lex
    ../../../../../src/common/syntax/names: program_names
    ../../../../../src/common/syntax/source: module_source, root_module_id
    ../../../../../src/common/syntax/syntax: Diagnostics, singleton_diagnostic
    ../../../input: parse


private pure func compiled(source: String) -> Result[String, Diagnostics]:
    lexed ?= lex(module_source(root_module_id()), source, program_names().names).map_err(
        pure func(failure): singleton_diagnostic(failure.error),
    )
    parsed ?= parse(lexed).map_err(singleton_diagnostic)
    generate_c(parsed)


private func compiles(source: String) -> Bool:
    match compiled(source):
        Ok(_):
            True
        Err(diagnostics):
            print_error(
                "${diagnostics.first.span.start} ${diagnostics.first.message} / ${diagnostics.first.help}",
            )
            False


-- `marked` sits between `prefix` and `suffix`; the single diagnostic spans
-- exactly it, and a mismatch prints what was reported.
private func rejects_marked(
    prefix: String,
    marked: String,
    suffix: String,
    message: String,
    help: String,
) -> Bool:
    match compiled(prefix + marked + suffix):
        Ok(_):
            print_error("compiled without a diagnostic")
            False
        Err(diagnostics):
            first = diagnostics.first
            exact = and(
                and(
                    first.span.start == prefix.length(),
                    first.span.end == prefix.length() + marked.length(),
                ),
                and(
                    and(diagnostics.remaining.is_empty(), first.message == message),
                    first.help == help,
                ),
            )
            if exact.not():
                print_error(
                    "reported ${first.span.start}..${first.span.end} ${first.message} / ${first.help} and ${diagnostics.remaining.length()} more",
                )
            exact


private DECLARATIONS: String = "union Kind:\n\tNotFound\n\tOther(Int)\n\n\nunion Choice:\n\tFirst\n\tSecond\n\n\nunion Held[T]:\n\tFull(T)\n\tAbsent\n\n\nrecord Point {\n\tx: Int,\n}\n\n\nMAX: Int = 3\n\n\ntrait Shape:\n\tpure func area(self: Self) -> Int\n\n\nopaque type Token = Int\n\n\n"


private MAIN: String = "func main() -> Int:\n\t"

private NOT_A_UNION_HELP: String = "only a union's variants are written Type.Variant"


func test_qualified_variants_need_no_annotation_and_no_import() -> Bool:
    compiles(
        (
            DECLARATIONS
            + "pure func code(kind: Kind) -> Int:\n\tmatch kind:\n\t\tKind.NotFound: 1\n\t\tKind.Other(number): number\n\n\nDEFAULT: Kind = Kind.NotFound\n\n\n"
            + MAIN
            + "missing = Kind.NotFound\n\tfirst = code(missing)\n\tsecond = code(Kind.Other(4))\n\tcode(DEFAULT)\n"
        ),
    )


-- A generic union still takes its arguments from the expected type, but the
-- name picks the variant, so the pattern needs no expected type.
func test_generic_unions_take_their_variants_through_their_names() -> Bool:
    compiles(
        (
            DECLARATIONS
            + "pure func unwrap(value: Held[Int]) -> Int:\n\tmatch value:\n\t\tHeld.Full(inner): inner\n\t\tHeld.Absent: 0\n\n\n"
            + MAIN
            + "present: Held[Int] = Held.Full(3)\n\tunwrap(present)\n"
        ),
    )


func test_nested_and_or_patterns_take_qualified_variants() -> Bool:
    compiles(
        (
            DECLARATIONS
            + "pure func code(held: Held[Kind]) -> Int:\n\tmatch held:\n\t\tHeld.Full(Kind.NotFound) | Held.Full(Kind.Other(0)): 1\n\t\tHeld.Full(Kind.Other(number)): number\n\t\tHeld.Absent: 0\n\n\n"
            + MAIN
            + "code(Held.Full(Kind.NotFound))\n"
        ),
    )


func test_a_union_declared_after_its_use_is_found() -> Bool:
    compiles(
        (
            MAIN
            + "code(Later.Second)\n\n\npure func code(later: Later) -> Int:\n\tmatch later:\n\t\tLater.First: 1\n\t\tLater.Second: 2\n\n\nunion Later:\n\tFirst\n\tSecond\n"
        ),
    )


func test_a_variant_the_union_lacks_is_refused_in_a_value() -> Bool:
    rejects_marked(
        DECLARATIONS + MAIN + "x = Kind.",
        "Missing",
        "\n\t0\n",
        "Kind has no variant Missing",
        "its variants are NotFound, Other",
    )


func test_a_variant_the_union_lacks_is_refused_in_a_pattern() -> Bool:
    rejects_marked(
        DECLARATIONS + "pure func f(kind: Kind) -> Int:\n\tmatch kind:\n\t\tKind.",
        "Missing",
        ": 1\n\t\t_: 0\n\n\n" + MAIN + "0\n",
        "Kind has no variant Missing",
        "its variants are NotFound, Other",
    )


func test_a_pattern_variant_of_another_union_is_refused() -> Bool:
    rejects_marked(
        DECLARATIONS + "pure func f(kind: Kind) -> Int:\n\tmatch kind:\n\t\t",
        "Choice.First",
        ": 1\n\t\t_: 0\n\n\n" + MAIN + "0\n",
        "Choice.First is a variant of Choice, but the matched value has type Kind",
        "match a variant of Kind, or match a value of type Choice",
    )


func test_a_record_is_not_a_union() -> Bool:
    rejects_marked(
        DECLARATIONS + MAIN + "x = ",
        "Point",
        ".X\n\t0\n",
        "Point is a record, not a union",
        NOT_A_UNION_HELP,
    )


func test_a_constant_is_not_a_union() -> Bool:
    rejects_marked(
        DECLARATIONS + MAIN + "x = ",
        "MAX",
        ".Foo\n\t0\n",
        "MAX is a constant, not a union",
        NOT_A_UNION_HELP,
    )


func test_a_builtin_type_is_not_a_union() -> Bool:
    rejects_marked(
        DECLARATIONS + MAIN + "x = ",
        "Int",
        ".Foo\n\t0\n",
        "Int is a builtin type, not a union",
        NOT_A_UNION_HELP,
    )


func test_an_opaque_type_is_not_a_union() -> Bool:
    rejects_marked(
        DECLARATIONS + MAIN + "x = ",
        "Token",
        ".Foo\n\t0\n",
        "Token is an opaque type, not a union",
        NOT_A_UNION_HELP,
    )


func test_a_trait_is_not_a_union() -> Bool:
    rejects_marked(
        DECLARATIONS + MAIN + "x = ",
        "Shape",
        ".Foo\n\t0\n",
        "Shape is a trait, not a union",
        NOT_A_UNION_HELP,
    )


func test_a_type_parameter_is_not_a_union() -> Bool:
    rejects_marked(
        DECLARATIONS + "pure func f[T](value: T) -> Int:\n\tx = ",
        "T",
        ".Foo\n\t0\n\n\n" + MAIN + "0\n",
        "T is a type parameter, not a union",
        NOT_A_UNION_HELP,
    )


func test_a_name_in_no_scope_is_not_a_union_in_scope() -> Bool:
    rejects_marked(
        DECLARATIONS + MAIN + "x = ",
        "Nowhere",
        ".Foo\n\t0\n",
        "Nowhere is not a union in scope",
        "import the union from the module that declares it, as in `module_name: Nowhere`",
    )


func test_a_payload_free_variant_cannot_be_called() -> Bool:
    rejects_marked(
        DECLARATIONS + MAIN + "x = Kind.",
        "NotFound",
        "()\n\t0\n",
        "payload-free variants cannot be called",
        "remove the parentheses: a payload-free variant is written without a call",
    )


func test_a_payload_variant_takes_its_payload() -> Bool:
    rejects_marked(
        DECLARATIONS + MAIN + "x = Kind.",
        "Other",
        "\n\t0\n",
        "constructor field count does not match its declaration",
        "expected 1 fields, got 0; pass one expression per declared field",
    )


func test_a_pattern_payload_count_must_match() -> Bool:
    rejects_marked(
        DECLARATIONS + "pure func f(kind: Kind) -> Int:\n\tmatch kind:\n\t\t",
        "Kind.NotFound(1)",
        ": 1\n\t\t_: 0\n\n\n" + MAIN + "0\n",
        "constructor pattern field count does not match its declaration",
        "expected 0 fields, got 1; write one name or '_' per declared field",
    )


func test_a_generic_variant_without_an_expected_type_asks_for_an_annotation() -> Bool:
    rejects_marked(
        DECLARATIONS + MAIN + "x = Held.",
        "Absent",
        "\n\t0\n",
        "constructor needs an expected union type",
        "annotate the binding: x: Held[T] = Held.Absent",
    )


func test_a_bare_variant_without_an_expected_type_names_its_union() -> Bool:
    rejects_marked(
        DECLARATIONS + MAIN + "x = ",
        "NotFound",
        "\n\t0\n",
        "constructor needs an expected union type",
        "write Kind.NotFound, which names its union",
    )


func test_a_lowercase_member_of_a_union_name_is_an_unknown_value() -> Bool:
    rejects_marked(
        DECLARATIONS + MAIN + "x = ",
        "Kind",
        ".a\n\t0\n",
        "unknown value",
        "use this function's parameter name, a declared variant, or a call",
    )


TESTS: TestSuite = {
    description = "qualified union variants",
    tests = [
        (
            "qualified variants need no annotation and no import",
            test_qualified_variants_need_no_annotation_and_no_import,
        ),
        (
            "generic unions take their variants through their names",
            test_generic_unions_take_their_variants_through_their_names,
        ),
        (
            "nested and or-patterns take qualified variants",
            test_nested_and_or_patterns_take_qualified_variants,
        ),
        ("a union declared after its use is found", test_a_union_declared_after_its_use_is_found),
        (
            "a variant the union lacks is refused in a value",
            test_a_variant_the_union_lacks_is_refused_in_a_value,
        ),
        (
            "a variant the union lacks is refused in a pattern",
            test_a_variant_the_union_lacks_is_refused_in_a_pattern,
        ),
        (
            "a pattern variant of another union is refused",
            test_a_pattern_variant_of_another_union_is_refused,
        ),
        ("a record is not a union", test_a_record_is_not_a_union),
        ("a constant is not a union", test_a_constant_is_not_a_union),
        ("a builtin type is not a union", test_a_builtin_type_is_not_a_union),
        ("an opaque type is not a union", test_an_opaque_type_is_not_a_union),
        ("a trait is not a union", test_a_trait_is_not_a_union),
        ("a type parameter is not a union", test_a_type_parameter_is_not_a_union),
        (
            "a name in no scope is not a union in scope",
            test_a_name_in_no_scope_is_not_a_union_in_scope,
        ),
        ("a payload-free variant cannot be called", test_a_payload_free_variant_cannot_be_called),
        ("a payload variant takes its payload", test_a_payload_variant_takes_its_payload),
        ("a pattern payload count must match", test_a_pattern_payload_count_must_match),
        (
            "a generic variant without an expected type asks for an annotation",
            test_a_generic_variant_without_an_expected_type_asks_for_an_annotation,
        ),
        (
            "a bare variant without an expected type names its union",
            test_a_bare_variant_without_an_expected_type_names_its_union,
        ),
        (
            "a lowercase member of a union name is an unknown value",
            test_a_lowercase_member_of_a_union_name_is_an_unknown_value,
        ),
    ],
}
