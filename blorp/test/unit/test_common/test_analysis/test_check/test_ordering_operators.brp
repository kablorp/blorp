import:
    bool: and
    int: Int methods
    list: List methods
    option: Option methods
    result: Result methods
    string: String methods
    test: TestSuite
    ../../../../../src/common/analysis/assemble:
        ParsedAssembly,
        ParsedProgram,
        append_module,
        assembly_names,
        begin_program,
        parsed_contents,
    ../../../../../src/common/analysis/check/check: check, checked_functions
    ../../../../../src/common/analysis/check/model as model
    ../../../../../src/common/analysis/check/render: render_failure
    ../../../../../src/common/analysis/ids:
        TraitMethodId,
        inventory_traits,
        trait_method_header,
        trait_method_number,
        trait_method_owner,
        trait_number,
    ../../../../../src/common/analysis/namespace/builtins: IntegerFormat(Int64Format)
    ../../../../../src/common/syntax/lex: lex
    ../../../../../src/common/syntax/names: name_spelling
    ../../../../../src/common/syntax/parse: parse_module
