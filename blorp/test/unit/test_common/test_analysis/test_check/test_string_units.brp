import:
    bool: Bool methods
    int: Int methods
    list: List methods
    option: Option methods
    string: String methods
    test: TestSuite
    ../../../../../src/common/analysis/check/check: check
    ../../../../../src/common/analysis/check/render: render_failure
    ../../../../../src/common/syntax/source: module_source, root_module_id
    ../../../module_input: parse_modules


private HELP_LENGTH: String = "declare a pure function with one String parameter returning Int"


private HELP_BYTE_SLICE: String = "declare a pure nongeneric function with String, Int and Int parameters returning Option[String]"


private HELP_CODEPOINT_SLICE: String = "declare a pure nongeneric function with String, Int and Int parameters returning String"


private HELP_CODEPOINT_AT: String = "declare a pure nongeneric function with String and Int parameters returning Option[Int]"


private pure func body_for(label: String) -> String:
    "\n    builtin(\"${label}\")\nfunc main() -> Int:\n    0\n"


private pure func accepts(header: String, label: String) -> Bool:
    match parse_modules([{ source = "${header}${body_for(label)}", targets = [] }]):
        Err(_):
            False
        Ok(parsed):
            match check(parsed):
                Ok(_): True
                Err(_): False


-- The declaration is refused where the label is written, with the help
-- rendered from the operation's contract row.
private pure func rejects(header: String, label: String, help: String) -> Bool:
    match parse_modules([{ source = "${header}${body_for(label)}", targets = [] }]):
        Err(_):
            False
        Ok(parsed):
            match check(parsed):
                Ok(_):
                    False
                Err(failure):
                    errors = render_failure(failure)
                    actual = errors.first
                    start = header.length() + ("\n    builtin(".length())
                    actual.message
                        .equals("builtin declaration does not match its runtime contract")
                        .and(actual.help.equals(help))
                        .and(actual.span.start.equals(start))
                        .and(actual.span.end.equals(start + ("\"${label}\"".length())))
                        .and(actual.span.source == module_source(root_module_id()))
                        .and(errors.remaining.is_empty())
                        .and(actual.note.is_none())


pure func test_the_library_shapes_are_accepted() -> Bool:
    accepts("pure func byte_length(value: String) -> Int:", "string.byte_length")
        .and(accepts("pure func length(value: String) -> Int:", "string.codepoint_length"))
        .and(
            accepts(
                "pure func byte_slice(value: String, start: Int, end: Int) -> Option[String]:",
                "string.byte_slice",
            ),
        )
        .and(
            accepts(
                "pure func slice(value: String, start: Int, end: Int) -> String:",
                "string.codepoint_slice",
            ),
        )
        .and(
            accepts(
                "pure func codepoint_at(value: String, index: Int) -> Option[Int]:",
                "string.codepoint_at",
            ),
        )


pure func test_lengths_take_exactly_one_string() -> Bool:
    rejects("pure func length(value: Int) -> Int:", "string.byte_length", HELP_LENGTH)
        .and(
            rejects(
                "pure func length(value: String) -> String:",
                "string.byte_length",
                HELP_LENGTH,
            ),
        )
        .and(
            rejects(
                "pure func length(value: String, extra: Int) -> Int:",
                "string.codepoint_length",
                HELP_LENGTH,
            ),
        )
        .and(rejects("func length(value: String) -> Int:", "string.codepoint_length", HELP_LENGTH))


-- A byte offset can land inside a character, so byte_slice keeps its Option;
-- every code point index is a boundary, so codepoint_slice cannot fail.
pure func test_only_the_byte_slice_is_optional() -> Bool:
    rejects(
        "pure func byte_slice(value: String, start: Int, end: Int) -> String:",
        "string.byte_slice",
        HELP_BYTE_SLICE,
    )
        .and(
            rejects(
                "pure func slice(value: String, start: Int, end: Int) -> Option[String]:",
                "string.codepoint_slice",
                HELP_CODEPOINT_SLICE,
            ),
        )
        .and(
            rejects(
                "pure func slice(value: String, start: Int) -> String:",
                "string.codepoint_slice",
                HELP_CODEPOINT_SLICE,
            ),
        )


pure func test_codepoint_at_gives_an_optional_scalar() -> Bool:
    rejects(
        "pure func codepoint_at(value: String, index: Int) -> Int:",
        "string.codepoint_at",
        HELP_CODEPOINT_AT,
    ).and(
        rejects(
            "pure func codepoint_at(value: String, index: Int) -> Option[String]:",
            "string.codepoint_at",
            HELP_CODEPOINT_AT,
        ),
    )


TESTS: TestSuite = {
    description = "String byte and code point contracts",
    tests = [
        ("the library shapes are accepted", test_the_library_shapes_are_accepted),
        ("lengths take exactly one String", test_lengths_take_exactly_one_string),
        ("only the byte slice is optional", test_only_the_byte_slice_is_optional),
        ("codepoint_at gives an optional scalar", test_codepoint_at_gives_an_optional_scalar),
    ],
}
