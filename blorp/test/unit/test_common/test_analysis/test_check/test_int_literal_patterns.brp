---
Int literal patterns: an Int is a scrutinee, and its column is open, so
literals never cover it and a repeated literal is unreachable. Rejections
compare the rendered message, help and span of the single diagnostic.
---
import:
    bool: Bool methods, and, not
    int: Int methods
    list: List methods
    result: map_err
    string: String methods
    test: TestSuite
    ../../../../../src/common/analysis/check/check: checked_functions
    ../../../../../src/common/analysis/check/model as model
    ../../../../../src/common/analysis/namespace/builtins: IntegerFormat(Int64Format)
    ../../../../../src/common/codegen/generate_c: generate_c
    ../../../../../src/common/syntax/lex: lex
    ../../../../../src/common/syntax/names: program_names
    ../../../../../src/common/syntax/source: module_source, root_module_id
    ../../../../../src/common/syntax/syntax:
        Diagnostics,
        LiteralPattern(ExactInt),
        singleton_diagnostic,
    ../../../input: checked_source, checked_tail_join, parse


private UNREACHABLE: String = "match arm is unreachable"


private UNREACHABLE_HELP: String = "remove this arm; earlier arms already cover all values it could match"


private MISMATCH: String = "pattern does not match the value's type"


private MISMATCH_HELP: String = "use a constructor of that union, a List pattern for a List, a String literal for a String, or an Int literal for an Int"


private pure func compiled(source: String) -> Result[String, Diagnostics]:
    lexed ?= lex(module_source(root_module_id()), source, program_names().names).map_err(
        pure func(failure): singleton_diagnostic(failure.error),
    )
    parsed ?= parse(lexed).map_err(singleton_diagnostic)
    generate_c(parsed)


private func accepts(source: String) -> Bool:
    match compiled(source):
        Ok(_):
            True
        Err(diagnostics):
            print_error("rejected: ${diagnostics.first.message}")
            False


-- The single diagnostic, compared exactly; a mismatch prints what was reported.
private func rejects(source: String, start: Int, end: Int, message: String, help: String) -> Bool:
    match compiled(source):
        Ok(_):
            print_error("compiled without a diagnostic")
            False
        Err(diagnostics):
            first = diagnostics.first
            located = and(
                first.span.source == module_source(root_module_id()),
                and(first.span.start == start, first.span.end == end),
            )
            exact = and(
                and(located, diagnostics.remaining.is_empty()),
                and(first.message == message, first.help == help),
            )
            if exact.not():
                print_error(
                    "reported ${first.span.start}..${first.span.end} ${first.message} / ${first.help} and ${diagnostics.remaining.length()} more",
                )
            exact


private EXIT: String =
    |union Exit:
    |	Exited(Int)
    |	Signaled(Int)
    |


func test_an_int_root_with_literals_and_a_catch_all_checks() -> Bool:
    source: String =
        |pure func classify(count: Int) -> Int:
        |	match count:
        |		0: 1
        |		-1: 2
        |		_: 3
        |func main() -> Int:
        |	classify(0)
        |
    accepts(source)


pure func test_an_int_root_selection_tests_each_literal_on_the_int() -> Bool:
    source: String =
        |pure func classify(count: Int) -> Int:
        |	match count:
        |		0: 1
        |		-1: 2
        |		_: 3
        |func main() -> Int:
        |	classify(0)
        |
    match checked_source(source):
        Err(_):
            False
        Ok(checked):
            var values: List[Int] = []
            for function in checked_functions(checked).functions:
                match checked_tail_join(function.body):
                    Some(join):
                        for node in join.selection.nodes:
                            match node:
                                model.TestLiteral(place, ExactInt(value), _, _):
                                    match place.route:
                                        model.MatchRoot:
                                            if place.value_type == model.IntegerType(Int64Format):
                                                values = values.append(value)
                                        _:
                                            void
                                _:
                                    void
                    None:
                        void
            (values.length() == 2)
                .and(values.contains(0))
                .and(values.contains(-1))


func test_literals_alone_never_cover_an_int() -> Bool:
    source: String =
        |pure func classify(count: Int) -> Int:
        |	match count:
        |		0: 1
        |		-1: 2
        |func main() -> Int:
        |	classify(0)
        |
    rejects(source, 40, 45, "non-exhaustive match", "add an arm for the missing pattern: _")


func test_a_repeated_int_literal_is_unreachable() -> Bool:
    repeated: String =
        |pure func classify(count: Int) -> Int:
        |	match count:
        |		0: 1
        |		0: 2
        |		_: 3
        |func main() -> Int:
        |	classify(0)
        |
    negative_zero: String =
        |pure func classify(count: Int) -> Int:
        |	match count:
        |		0: 1
        |		-0: 2
        |		_: 3
        |func main() -> Int:
        |	classify(0)
        |
    rejects(repeated, 62, 63, UNREACHABLE, UNREACHABLE_HELP).and(
        rejects(negative_zero, 62, 64, UNREACHABLE, UNREACHABLE_HELP),
    )


func test_a_repeated_int_alternative_is_unreachable() -> Bool:
    source: String =
        |pure func classify(count: Int) -> Int:
        |	match count:
        |		0 | 0: 1
        |		_: 3
        |func main() -> Int:
        |	classify(0)
        |
    rejects(source, 59, 60, UNREACHABLE, UNREACHABLE_HELP)


-- At the root a bare name is a constructor, so the alternatives sit in a field.
func test_int_alternatives_must_bind_the_same_names() -> Bool:
    source: String =
        |pure func code(exit: Exit) -> Int:
        |	match exit:
        |		Exited(0) | Exited(n): 1
        |		_: 3
        |func main() -> Int:
        |	code(Exited(0))
        |
    rejects(
        EXIT + source,
        102,
        111,
        "or-pattern alternatives bind different names",
        "bind the same names in every alternative, or use '_' for fields the arm does not need",
    )


func test_an_int_field_literal_beside_its_capture_is_exhaustive() -> Bool:
    source: String =
        |pure func code(exit: Exit) -> Int:
        |	match exit:
        |		Exited(0): 0
        |		Exited(status): status
        |		Signaled(signal): signal
        |func main() -> Int:
        |	code(Exited(3))
        |
    accepts(EXIT + source)


func test_int_list_elements_need_a_catch_all() -> Bool:
    covered: String =
        |pure func head(values: List[Int]) -> Int:
        |	match values:
        |		[0, ...rest]: 1
        |		[_, 0]: 2
        |		_: 3
        |func main() -> Int:
        |	head([0])
        |
    first_only: String =
        |pure func head(values: List[Int]) -> Int:
        |	match values:
        |		[0, ...rest]: 1
        |		[]: 2
        |func main() -> Int:
        |	head([0])
        |
    second_only: String =
        |pure func head(values: List[Int]) -> Int:
        |	match values:
        |		[_, 0]: 2
        |		[]: 2
        |		[_]: 2
        |		[_, _, _, ..._]: 2
        |func main() -> Int:
        |	head([0])
        |
    accepts(covered)
        .and(
            rejects(
                first_only,
                43,
                48,
                "non-exhaustive match",
                "add an arm for the missing pattern: [_, ..._]",
            ),
        )
        .and(
            rejects(
                second_only,
                43,
                48,
                "non-exhaustive match",
                "add an arm for the missing pattern: [_, _]",
            ),
        )


func test_literals_must_match_the_place_type() -> Bool:
    string_on_int: String =
        |pure func classify(count: Int) -> Int:
        |	match count:
        |		"0": 1
        |		_: 3
        |func main() -> Int:
        |	classify(0)
        |
    int_on_string: String =
        |pure func classify(text: String) -> Int:
        |	match text:
        |		0: 1
        |		_: 3
        |func main() -> Int:
        |	classify("0")
        |
    int_on_float: String =
        |union Reading:
        |	Value(Float)
        |pure func zero(reading: Reading) -> Int:
        |	match reading:
        |		Value(0): 1
        |		Value(_): 0
        |func main() -> Int:
        |	zero(Value(0.5))
        |
    rejects(string_on_int, 55, 58, MISMATCH, MISMATCH_HELP)
        .and(rejects(int_on_string, 56, 57, MISMATCH, MISMATCH_HELP))
        .and(rejects(int_on_float, 94, 95, MISMATCH, MISMATCH_HELP))


func test_a_float_scrutinee_names_every_matchable_type() -> Bool:
    source: String =
        |pure func classify(value: Float) -> Int:
        |	match value:
        |		_: 3
        |func main() -> Int:
        |	classify(0.5)
        |
    rejects(
        source,
        48,
        53,
        "match requires a union, List, String, Int or tuple value",
        "match one of those; use if for a Boolean condition",
    )


TESTS: TestSuite = {
    description = "Int literal patterns",
    tests = [
        (
            "an Int root with literals and a catch-all checks",
            test_an_int_root_with_literals_and_a_catch_all_checks,
        ),
        (
            "an Int root selection tests each literal on the Int",
            test_an_int_root_selection_tests_each_literal_on_the_int,
        ),
        ("literals alone never cover an Int", test_literals_alone_never_cover_an_int),
        ("a repeated Int literal is unreachable", test_a_repeated_int_literal_is_unreachable),
        (
            "a repeated Int alternative is unreachable",
            test_a_repeated_int_alternative_is_unreachable,
        ),
        (
            "Int alternatives must bind the same names",
            test_int_alternatives_must_bind_the_same_names,
        ),
        (
            "an Int field literal beside its capture is exhaustive",
            test_an_int_field_literal_beside_its_capture_is_exhaustive,
        ),
        ("Int List elements need a catch-all", test_int_list_elements_need_a_catch_all),
        ("literals must match the place type", test_literals_must_match_the_place_type),
        (
            "a Float scrutinee names every matchable type",
            test_a_float_scrutinee_names_every_matchable_type,
        ),
    ],
}
