import:
    bool: not, or
    int: Int methods
    list: List methods
    option: Option methods
    path: Path, parent, to_path
    result: Result methods
    string: String methods
    test: TestSuite
    ../../../src/common/syntax/names: name_spelling
    ../../../src/common/syntax/parse:
        ImportOrigin(RelativeImport, LibraryImport),
        ParsedModuleContents,
    ../test_format/repository_sources: SourceFile, parsed_source, repository_sources


-- A layer's directory (or, for `main.brp`, its file) and the only directories
-- and files its modules may import from, as allow-lists so that an import of
-- `main`, another command or a new sibling is rejected too. Library imports name
-- no file.
--
-- Inside `common/`, layers import only downward: `utils/`; `syntax/` and
-- `utils/`; `analysis/`, `syntax/` and `utils/` (and the generated embedded
-- library); `codegen/` and all of those; `cli/`, `syntax/` and `utils/`. A
-- command directory imports itself and `common/`, and the formatter only
-- `common/syntax`, `common/cli` and `common/utils`. `main.brp` imports the
-- commands and `common/cli`. Because every `common/` layer lists only `common/`
-- directories, no `common/` module imports `main.brp` or a command, and no
-- command imports `main.brp` or another command.
private record Layer {
    directory: String,
    allowed: List[String],
}


private UTILS_LAYER: Layer = {
    directory = "blorp/src/common/utils",
    allowed = ["blorp/src/common/utils"],
}


private SYNTAX_LAYER: Layer = {
    directory = "blorp/src/common/syntax",
    allowed = ["blorp/src/common/syntax", "blorp/src/common/utils"],
}


-- `blorp/build/generated` is the embedded library `load.brp` imports.
private ANALYSIS_LAYER: Layer = {
    directory = "blorp/src/common/analysis",
    allowed = [
        "blorp/src/common/analysis",
        "blorp/src/common/syntax",
        "blorp/src/common/utils",
        "blorp/build/generated",
    ],
}


private CODEGEN_LAYER: Layer = {
    directory = "blorp/src/common/codegen",
    allowed = [
        "blorp/src/common/codegen",
        "blorp/src/common/analysis",
        "blorp/src/common/syntax",
        "blorp/src/common/utils",
    ],
}


private CLI_LAYER: Layer = {
    directory = "blorp/src/common/cli",
    allowed = ["blorp/src/common/cli", "blorp/src/common/syntax", "blorp/src/common/utils"],
}


private COMPILE_LAYER: Layer = {
    directory = "blorp/src/compile",
    allowed = [
        "blorp/src/compile",
        "blorp/src/common/analysis",
        "blorp/src/common/cli",
        "blorp/src/common/codegen",
        "blorp/src/common/syntax",
        "blorp/src/common/utils",
    ],
}


-- `format/` never imports `analysis/` or `codegen/`.
private FORMAT_LAYER: Layer = {
    directory = "blorp/src/format",
    allowed = [
        "blorp/src/format",
        "blorp/src/common/syntax",
        "blorp/src/common/cli",
        "blorp/src/common/utils",
    ],
}


private MAIN_LAYER: Layer = {
    directory = "blorp/src/main.brp",
    allowed = ["blorp/src/compile", "blorp/src/format", "blorp/src/common/cli"],
}


-- A function, because a constant cannot name other constants. A new command
-- directory under `blorp/src` fails `owner_violations` until it is listed here.
private pure func all_layers() -> List[Layer]:
    [
        UTILS_LAYER,
        SYNTAX_LAYER,
        ANALYSIS_LAYER,
        CODEGEN_LAYER,
        CLI_LAYER,
        COMPILE_LAYER,
        FORMAT_LAYER,
        MAIN_LAYER,
    ]


private SOURCE_DIRECTORY: String = "blorp/src"


private pure func is_inside(path: String, directory: String) -> Bool:
    or(path == directory, path.starts_with(directory + "/"))


-- Each relative import of `contents`, resolved against `file_path`'s directory
-- into the repository-relative path it names. A part with no spelling resolves
-- to a path inside no layer, so it is reported like any other bad import.
private pure func relative_import_targets(
    file: Path,
    contents: ParsedModuleContents,
) -> List[String]:
    var targets: List[String] = []
    for row in contents.imports:
        match row.path.origin:
            LibraryImport:
                void
            RelativeImport(parents):
                var directory = parent(file)
                for _ in 0..parents:
                    directory = parent(directory)
                var target = "${directory}"
                for part in row.path.parts:
                    spelling = name_spelling(contents.names, part).get_or("<unspelled>")
                    target = target + "/" + spelling
                targets = targets.append(target)
    targets


-- A source path is never empty; the empty one, which is no path, imports nothing.
private pure func import_targets(file_path: String, contents: ParsedModuleContents) -> List[String]:
    match file_path.to_path():
        Ok(file): relative_import_targets(file, contents)
        Err(_): []


-- One line per import of `file` outside what `layer` allows, naming the file
-- and the resolved path; a file that does not parse is one line too.
private pure func layer_violations(layer: Layer, file: SourceFile) -> List[String]:
    match parsed_source(file.text):
        Err(_):
            ["${file.path}: does not parse"]
        Ok(parsed):
            import_targets(file.path, parsed.contents)
                .filter(
                    pure func(target: String): layer.allowed
                        .any(pure func(directory: String): target.is_inside(directory))
                        .not(),
                )
                .map(
                    pure func(target: String): "${file.path} imports ${target}, outside what ${layer.directory} may import",
                )


private pure func files_in(layer: Layer, files: List[SourceFile]) -> List[SourceFile]:
    files.filter(pure func(file: SourceFile): file.path.is_inside(layer.directory))


-- One line unless exactly one of `layers` owns `file`, so that a file in a new
-- directory is not silently exempt from every rule, and no file answers to two.
private pure func owner_violations(layers: List[Layer], file: SourceFile) -> List[String]:
    owners = layers.filter(pure func(layer: Layer): file.path.is_inside(layer.directory))
    if owners.length() == 1:
        []
    else:
        [
            "${file.path} belongs to ${owners.length()} layers; give its directory exactly one layer in all_layers",
        ]


pure func all_violations(files: List[SourceFile]) -> List[String]:
    var violations: List[String] = []
    for file in files.filter(pure func(file: SourceFile): file.path.is_inside(SOURCE_DIRECTORY)):
        violations = violations.concat(owner_violations(all_layers(), file))
    for layer in all_layers():
        for file in files_in(layer, files):
            violations = violations.concat(layer_violations(layer, file))
    violations


func test_every_layer_imports_only_what_it_may() -> Bool:
    match repository_sources():
        Err(error):
            print_error(error)
            False
        Ok(files):
            violations = all_violations(files)
            for violation in violations:
                print_error(violation)
            violations.is_empty()


-- The rules are checked on text, so they are proved by imports they must reject.
pure func test_a_format_module_importing_analysis_is_reported() -> Bool:
    file: SourceFile = {
        path = "blorp/src/format/example.brp",
        text = "import:\n    ../common/analysis/check/check: check\n    ../common/syntax/lex: lex\n\n\nVALUE: Int = 1\n",
    }
    expected = [
        "blorp/src/format/example.brp imports blorp/src/common/analysis/check/check, outside what blorp/src/format may import",
    ]
    layer_violations(FORMAT_LAYER, file) == expected


pure func test_a_syntax_module_importing_the_formatter_or_main_is_reported() -> Bool:
    file: SourceFile = {
        path = "blorp/src/common/syntax/example.brp",
        text = "import:\n    ./lex: lex\n    ../../format/format: format_source\n    ../../main: main\n    ../utils/text: concat\n\n\nVALUE: Int = 1\n",
    }
    expected = [
        "blorp/src/common/syntax/example.brp imports blorp/src/format/format, outside what blorp/src/common/syntax may import",
        "blorp/src/common/syntax/example.brp imports blorp/src/main, outside what blorp/src/common/syntax may import",
    ]
    layer_violations(SYNTAX_LAYER, file) == expected


pure func test_a_utils_module_importing_a_command_is_reported() -> Bool:
    file: SourceFile = {
        path = "blorp/src/common/utils/example.brp",
        text = "import:\n    ../../compile/compile_command: compile_request\n\n\nVALUE: Int = 1\n",
    }
    expected = [
        "blorp/src/common/utils/example.brp imports blorp/src/compile/compile_command, outside what blorp/src/common/utils may import",
    ]
    layer_violations(UTILS_LAYER, file) == expected


pure func test_syntax_importing_analysis_is_reported() -> Bool:
    file: SourceFile = {
        path = "blorp/src/common/syntax/example.brp",
        text = "import:\n    ../analysis/check/check: check\n\n\nVALUE: Int = 1\n",
    }
    expected = [
        "blorp/src/common/syntax/example.brp imports blorp/src/common/analysis/check/check, outside what blorp/src/common/syntax may import",
    ]
    layer_violations(SYNTAX_LAYER, file) == expected


pure func test_analysis_importing_codegen_is_reported() -> Bool:
    file: SourceFile = {
        path = "blorp/src/common/analysis/check/example.brp",
        text = "import:\n    ../../codegen/emit/emit: emit\n    ../../syntax/syntax: Span\n    ../../../../build/generated/embedded_library: EMBEDDED_LIBRARY\n\n\nVALUE: Int = 1\n",
    }
    expected = [
        "blorp/src/common/analysis/check/example.brp imports blorp/src/common/codegen/emit/emit, outside what blorp/src/common/analysis may import",
    ]
    layer_violations(ANALYSIS_LAYER, file) == expected


pure func test_a_common_module_importing_a_command_directory_is_reported() -> Bool:
    file: SourceFile = {
        path = "blorp/src/common/codegen/example.brp",
        text = "import:\n    ../../format/format_command: format_request\n\n\nVALUE: Int = 1\n",
    }
    expected = [
        "blorp/src/common/codegen/example.brp imports blorp/src/format/format_command, outside what blorp/src/common/codegen may import",
    ]
    layer_violations(CODEGEN_LAYER, file) == expected


pure func test_one_command_importing_another_is_reported() -> Bool:
    file: SourceFile = {
        path = "blorp/src/compile/example.brp",
        text = "import:\n    ../format/format: format_source\n    ../common/syntax/lex: lex\n\n\nVALUE: Int = 1\n",
    }
    expected = [
        "blorp/src/compile/example.brp imports blorp/src/format/format, outside what blorp/src/compile may import",
    ]
    layer_violations(COMPILE_LAYER, file) == expected


pure func test_a_command_importing_main_is_reported() -> Bool:
    file: SourceFile = {
        path = "blorp/src/format/example.brp",
        text = "import:\n    ../main: Command\n    ./format: format_source\n\n\nVALUE: Int = 1\n",
    }
    expected = [
        "blorp/src/format/example.brp imports blorp/src/main, outside what blorp/src/format may import",
    ]
    layer_violations(FORMAT_LAYER, file) == expected


pure func test_cli_importing_analysis_is_reported() -> Bool:
    file: SourceFile = {
        path = "blorp/src/common/cli/example.brp",
        text = "import:\n    ../analysis/check/check: check\n    ../syntax/syntax: Span\n\n\nVALUE: Int = 1\n",
    }
    expected = [
        "blorp/src/common/cli/example.brp imports blorp/src/common/analysis/check/check, outside what blorp/src/common/cli may import",
    ]
    layer_violations(CLI_LAYER, file) == expected


pure func test_main_importing_analysis_is_reported() -> Bool:
    file: SourceFile = {
        path = "blorp/src/main.brp",
        text = "import:\n    ./common/analysis/assemble: ParsedProgram\n    ./compile/compile_command: compile_request\n\n\nVALUE: Int = 1\n",
    }
    expected = [
        "blorp/src/main.brp imports blorp/src/common/analysis/assemble, outside what blorp/src/main.brp may import",
    ]
    layer_violations(MAIN_LAYER, file) == expected


pure func test_a_file_in_a_new_directory_is_reported_until_it_has_a_layer() -> Bool:
    file: SourceFile = { path = "blorp/src/lsp/lsp_command.brp", text = "VALUE: Int = 1\n" }
    expected = [
        "blorp/src/lsp/lsp_command.brp belongs to 0 layers; give its directory exactly one layer in all_layers",
    ]
    owner_violations(all_layers(), file) == expected


pure func test_a_file_in_a_layer_has_no_owner_violation() -> Bool:
    file: SourceFile = { path = "blorp/src/compile/compile_command.brp", text = "VALUE: Int = 1\n" }
    owner_violations(all_layers(), file).is_empty()


pure func test_a_file_two_layers_own_is_reported() -> Bool:
    all_of_common: Layer = { directory = "blorp/src/common", allowed = [] }
    file: SourceFile = { path = "blorp/src/common/syntax/lex.brp", text = "VALUE: Int = 1\n" }
    expected = [
        "blorp/src/common/syntax/lex.brp belongs to 2 layers; give its directory exactly one layer in all_layers",
    ]
    owner_violations([SYNTAX_LAYER, all_of_common], file) == expected


pure func test_a_file_that_does_not_parse_is_reported() -> Bool:
    file: SourceFile = { path = "blorp/src/compile/example.brp", text = "func (((\n" }
    layer_violations(COMPILE_LAYER, file) == ["blorp/src/compile/example.brp: does not parse"]


TESTS: TestSuite = {
    description = "Source layer dependencies",
    tests = [
        ("every layer imports only what it may", test_every_layer_imports_only_what_it_may),
        (
            "a format module importing analysis is reported",
            test_a_format_module_importing_analysis_is_reported,
        ),
        (
            "a syntax module importing the formatter or main is reported, every one",
            test_a_syntax_module_importing_the_formatter_or_main_is_reported,
        ),
        (
            "a utils module importing a command is reported",
            test_a_utils_module_importing_a_command_is_reported,
        ),
        ("syntax importing analysis is reported", test_syntax_importing_analysis_is_reported),
        ("analysis importing codegen is reported", test_analysis_importing_codegen_is_reported),
        (
            "a common module importing a command directory is reported",
            test_a_common_module_importing_a_command_directory_is_reported,
        ),
        (
            "one command importing another is reported",
            test_one_command_importing_another_is_reported,
        ),
        ("a command importing main is reported", test_a_command_importing_main_is_reported),
        ("cli importing analysis is reported", test_cli_importing_analysis_is_reported),
        ("main importing analysis is reported", test_main_importing_analysis_is_reported),
        (
            "a file in a new directory is reported until it has a layer",
            test_a_file_in_a_new_directory_is_reported_until_it_has_a_layer,
        ),
        ("a file in a layer has no owner violation", test_a_file_in_a_layer_has_no_owner_violation),
        ("a file two layers own is reported", test_a_file_two_layers_own_is_reported),
        ("a file that does not parse is reported", test_a_file_that_does_not_parse_is_reported),
    ],
}
