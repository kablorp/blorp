-- Pure unit observers read identities established by Check and Specialize.
-- A final nullary exhaustive entry has no tag; callers test its exclusions.
import:
    ../../src/compile/check/model as checked
    ../../src/compile/ids: VariantId
    ../../src/compile/specialize/specialize as specialized


pure func checked_arm_variant(
    selection: checked.CheckedSelection,
    arm: checked.MatchArmId,
) -> Option[VariantId]:
    var found: Option[VariantId] = None
    for node in selection.nodes:
        match node:
            checked.EnterArm(id, arguments):
                if checked.match_arm_number(id) == checked.match_arm_number(arm):
                    for argument in arguments:
                        match argument:
                            checked.BorrowPlace(place):
                                match place.route:
                                    checked.UnionField(_, variant, _): found = Some(variant)
                                    _: void
                            checked.CopyListSuffix(_, _):
                                void
            checked.TestVariant(_, variant, yes, _):
                match selection.nodes.get(checked.decision_node_number(yes)):
                    Some(checked.EnterArm(id, _)):
                        if checked.match_arm_number(id) == checked.match_arm_number(arm):
                            found = Some(variant)
                    _:
                        void
            _:
                void
    found


pure func concrete_arm_variant(
    selection: specialized.ConcreteSelection,
    arm: checked.MatchArmId,
) -> Option[specialized.VariantInstanceId]:
    var found: Option[specialized.VariantInstanceId] = None
    for node in selection.nodes:
        match node:
            specialized.EnterArm(id, arguments):
                if checked.match_arm_number(id) == checked.match_arm_number(arm):
                    for argument in arguments:
                        match argument:
                            specialized.BorrowPlace(place):
                                match place.route:
                                    specialized.UnionField(_, field):
                                        found = Some(specialized.variant_field_variant(field))
                                    _:
                                        void
                            specialized.CopyListSuffix(_, _):
                                void
            specialized.TestVariant(_, variant, yes, _):
                match selection.nodes.get(checked.decision_node_number(yes)):
                    Some(specialized.EnterArm(id, _)):
                        if checked.match_arm_number(id) == checked.match_arm_number(arm):
                            found = Some(variant)
                    _:
                        void
            _:
                void
    found
