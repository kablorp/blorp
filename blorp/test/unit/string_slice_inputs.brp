import:
    ../../src/common/analysis/check/check: check
    ../../src/common/analysis/namespace/builtins as builtins
    ../../src/common/codegen/lower/lower as lower
    ../../src/common/codegen/specialize/specialize as specialized
    ../../src/common/syntax/syntax: Diagnostic, DiagnosticKind(ProgramProblem)
    ./input: setup_diagnostic
    ./module_input: parse_modules
    ./ownership_inputs: span


SLICE_DECLARATION: String =
    |pure func slice_text(value: String, start: Int, end: Int) -> Option[String]:
    |    builtin("string.slice")
    |


SLICE_SOURCE: String =
    |pure func slice_text(value: String, start: Int, end: Int) -> Option[String]:
    |    builtin("string.slice")
    |pure func escape(value: String) -> String:
    |    match slice_text(value, 0, 2):
    |        Some(text): text
    |        None: "none"
    |func main() -> Int:
    |    unused = slice_text("é", 0, 2)
    |    escaped = escape("é")
    |    0
    |


record SliceSeed {
    lowered: lower.LoweredProgram,
    query: lower.LoweredFunction,
    escape: lower.LoweredFunction,
    option: builtins.DesignatedOption[specialized.VariantInstanceId],
}


pure func slice_seed() -> Result[SliceSeed, Diagnostic]:
    parsed ?= parse_modules([{ source = SLICE_SOURCE, targets = [] }])
    checked ?= check(parsed).map_err(setup_diagnostic)
    concrete ?= specialized.specialize(checked)
    lowered ?= lower.lower(concrete)
    match lower.lowered_functions(lowered).functions:
        [_, query, escape]:
            match query.steps:
                [_, _, _, lower.Define(result)]:
                    match result.operation:
                        lower.CallValue(target, [_, _, _]):
                            match target:
                                specialized.RuntimeFunction(builtins.StringSlice(option)):
                                    Ok({
                                        lowered = lowered,
                                        query = query,
                                        escape = escape,
                                        option = option,
                                    })
                                _:
                                    Err(invalid_seed())
                        _:
                            Err(invalid_seed())
                _:
                    Err(invalid_seed())
        _:
            Err(invalid_seed())


private pure func invalid_seed() -> Diagnostic:
    {
        span = span(0),
        kind = ProgramProblem,
        note = None,
        message = "invalid slice test seed",
        help = "keep the explicit slice and escape fixture",
    }
