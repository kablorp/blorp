import:
    ../../src/compile/check/check: CheckedProgram, check
    ../../src/compile/lower/lower: LoweredProgram, lower
    ../../src/compile/specialize/specialize: specialize
    ../../src/syntax/syntax: Diagnostic
    ./input: setup_diagnostic
    ./module_input: TestFoundation, parse_modules_with_base


COMPARISON_SOURCE: String =
    |pure func compare(left: Int, right: Int) -> Bool:
    |    builtin("int.less_than")
    |func main() -> Int:
    |    compared = compare(20, 22)
    |    0
    |


pure func checked_comparison(foundation: TestFoundation) -> Result[CheckedProgram, Diagnostic]:
    parsed ?= parse_modules_with_base([{ source = COMPARISON_SOURCE, targets = [] }], foundation)
    check(parsed).map_err(setup_diagnostic)


pure func lowered_comparison(foundation: TestFoundation) -> Result[LoweredProgram, Diagnostic]:
    checked ?= checked_comparison(foundation)
    concrete ?= specialize(checked)
    lower(concrete)
