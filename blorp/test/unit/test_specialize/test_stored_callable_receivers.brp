import:
	../input: checked_source
	../../../src/check/model as Checked
	../../../src/specialize/specialize as Concrete
	../../../src/utils/syntax: Diagnostic
	test: TestSuite


private SAME_PURITY: String =
	|pure func identity(value: Int) -> Int:
	|    value
	|pure func use(callback: pure (Int) -> Int, value: Int) -> Int:
	|    callback(value)
	|func main() -> Int:
	|    saved: pure (Int) -> Int = identity
	|    saved.use(17)
	|


private INTERLEAVED: String =
	|pure func identity(value: Int) -> Int:
	|    value
	|pure func use(callback: pure (Int) -> Int, value: Int, later: pure (Int) -> Int) -> Int:
	|    later(callback(value))
	|func main() -> Int:
	|    saved: pure (Int) -> Int = identity
	|    saved.use(17, identity)
	|


private pure func specialized(source: String) -> Result[Concrete.SpecializedContents, Diagnostic]:
	checked ?= checked_source(source)
	program ?= Concrete.specialize(checked)
	Ok(Concrete.specialized_contents(program))


pure func test_receiver_selects_a_runtime_callable_abi_and_indirect_body() -> Bool:
	match specialized(SAME_PURITY):
		Err(_): False
		Ok(program):
			var matching = 0
			for function in program.functions:
				match function.signature.parameters:
					[Concrete.CallableType([Concrete.IntType], Concrete.IntType), Concrete.IntType]:
						match function.body:
							Concrete.ConcreteValueBody(Concrete.ReturnExpression(value)):
								match value.form:
									Concrete.InvokeCallable(callee, [argument]):
										match (callee.form, argument.form):
											(Concrete.ReadBinding(first), Concrete.ReadBinding(second)):
												if Checked.binding_number(first) == 0 and Checked.binding_number(second) == 1:
													matching = matching + 1
											_: void
									_: void
							_: void
					_: void
			matching == 1


pure func test_later_static_callable_erasure_does_not_shift_receiver_or_ordinary_binding() -> Bool:
	match specialized(INTERLEAVED):
		Err(_): False
		Ok(program):
			var matching = 0
			for function in program.functions:
				match function.signature.parameters:
					[Concrete.CallableType([Concrete.IntType], Concrete.IntType), Concrete.IntType]:
						match function.body:
							Concrete.ConcreteValueBody(Concrete.ReturnExpression(value)):
								match value.form:
									Concrete.InvokeFunction(call, [argument]):
										match (call.target, argument.form):
											(Concrete.UserFunction(target), Concrete.InvokeCallable(callee, [input])):
												match (callee.form, input.form, program.functions.get(Concrete.function_number(target))):
													(Concrete.ReadBinding(first), Concrete.ReadBinding(second), Some(called)):
														match called.signature.parameters:
															[Concrete.IntType]:
																if Checked.binding_number(first) == 0 and Checked.binding_number(second) == 1:
																	matching = matching + 1
															_: void
													_: void
											_: void
									_: void
							_: void
					_: void
			matching == 1


tests: TestSuite = {
	description = "Stored receiver runtime and static specialization modes",
	tests = [
		("receiver selects exact runtime callable ABI and indirect body", test_receiver_selects_a_runtime_callable_abi_and_indirect_body),
		("later static callable cannot shift runtime receiver binding", test_later_static_callable_erasure_does_not_shift_receiver_or_ordinary_binding),
	]
}
