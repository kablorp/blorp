import:
	../../../src/lower/lower as Lower
	../../../src/namespace/builtins as Builtins
	../../../src/utils/syntax: SystemOperation(FsWriteText)
	../../../src/specialize/specialize as Concrete
	../fs_write_inputs: fs_write_seed
	../module_input: test_base
	../text_search: replace_first
	bool: Bool methods
	result: Result methods
	test: TestSuite


pure func test_fs_write_result_has_void_success_and_int_error() -> Bool:
	match fs_write_seed(test_base()):
		Err(_): False
		Ok(seed):
			signature = Concrete.runtime_signature(Builtins.SystemCall(FsWriteText, seed.constructors))
			match (signature.parameters, signature.return_type, Lower.lowered_functions(seed.lowered).unions):
				([Concrete.StringType, Concrete.StringType], Concrete.UnionType(owner), [layout]):
					match Concrete.union_variants(layout):
						[[Concrete.VoidType], [Concrete.IntType]]:
							Concrete.union_number(owner) == Concrete.union_number(Concrete.variant_owner(seed.constructors.ok))
						_: False
				_: False


pure func test_reversed_result_preserves_constructor_roles() -> Bool:
	foundation = { test_base() | types = replace_first(test_base().types, "    Ok(Value)\n    Err(Error)", "    Err(Error)\n    Ok(Value)") }
	match fs_write_seed(foundation):
		Err(_): False
		Ok(seed): (Concrete.variant_number(seed.constructors.ok) == 1).and(Concrete.variant_number(seed.constructors.err) == 0)


tests: TestSuite = {
	description = "Blorp fs.write_text specialization",
	tests = [
		("two Strings return a Result with Void success and Int error", test_fs_write_result_has_void_success_and_int_error),
		("reversed declarations retain Ok and Err roles", test_reversed_result_preserves_constructor_roles),
	]
}
