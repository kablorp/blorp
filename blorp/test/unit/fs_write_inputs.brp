import:
    option: to_result
    result: Result methods
    ../../src/check/check: check
    ../../src/lower/lower as Lower
    ../../src/namespace/builtins as Builtins
    ../../src/specialize/specialize as Concrete
    ../../src/utils/source: compiler_source
    ../../src/utils/syntax: Diagnostic, entry_function, SystemOperation(FsWriteText)
    ./input: setup_diagnostic
    ./module_input: TestFoundation, parse_modules_with_base


-- `fs.write_text` is the one system operation with two String operands, and
-- its Result[Void, Int] carries no managed payload.
FS_WRITE_SOURCE: String =
    |func query(path: String, contents: String) -> Result[Void, Int]:
    |    builtin("fs.write_text")
    |func escape(path: String) -> Int:
    |    match query(path, path):
    |        Ok(done): 0
    |        Err(code): code
    |func main() -> Int:
    |    unused = query("input", "contents")
    |    escaped = escape("input")
    |    0
    |


record FsWriteSeed {
    lowered: Lower.LoweredProgram,
    query: Lower.LoweredFunction,
    escape: Concrete.FunctionInstanceId,
    constructors: Builtins.DesignatedResult[Concrete.VariantInstanceId],
}


pure func fs_write_seed(foundation: TestFoundation) -> Result[FsWriteSeed, Diagnostic]:
    fs_write_seed_from_source(FS_WRITE_SOURCE, foundation)


pure func fs_write_seed_from_source(
    source: String,
    foundation: TestFoundation,
) -> Result[FsWriteSeed, Diagnostic]:
    parsed ?= parse_modules_with_base([{ source = source, targets = [] }], foundation)
    checked ?= check(parsed).map_err(setup_diagnostic)
    concrete ?= Concrete.specialize(checked)
    lowered ?= Lower.lower(concrete)
    contents = Lower.lowered_functions(lowered)
    main ?= contents.functions
        .get(Concrete.function_number(entry_function(contents.entrypoint)))
        .to_result(invalid_seed())
    match main.steps.filter(pure func(step): called_function(step).is_ok()):
        [query_call, escape_call, ...remaining]:
            fs_write_seed_from_calls(lowered, contents, query_call, escape_call)
        _: Err(invalid_seed())


-- The checker's nesting limit and the ban on `?=` inside match arms mean each arm that needs a Result binding lives in its own function.
private pure func fs_write_seed_from_calls(
    lowered: Lower.LoweredProgram,
    contents: Lower.LoweredFunctions,
    query_call: Lower.LoweredStep,
    escape_call: Lower.LoweredStep,
) -> Result[FsWriteSeed, Diagnostic]:
    query_id ?= called_function(query_call)
    escape_id ?= called_function(escape_call)
    query ?= contents.functions.get(Concrete.function_number(query_id)).to_result(invalid_seed())
    match query.steps:
        [Lower.Define(_), Lower.Define(_), Lower.Define(result)]:
            match result.operation:
                Lower.CallValue(call, [_, _]):
                    match call:
                        Concrete.RuntimeFunction(Builtins.SystemCall(FsWriteText, constructors)):
                            Ok({
                                lowered = lowered,
                                query = query,
                                escape = escape_id,
                                constructors = constructors,
                            })
                        _: Err(invalid_seed())
                _: Err(invalid_seed())
        _: Err(invalid_seed())


private pure func called_function(
    step: Lower.LoweredStep,
) -> Result[Concrete.FunctionInstanceId, Diagnostic]:
    match step:
        Lower.Define(definition):
            match definition.operation:
                Lower.CallValue(call, _):
                    match call:
                        Concrete.UserFunction(id): Ok(id)
                        _: Err(invalid_seed())
                _: Err(invalid_seed())
        _: Err(invalid_seed())


private pure func invalid_seed() -> Diagnostic:
    {
        span = { source = compiler_source(), start = 0, end = 0 },
        note = None,
        message = "invalid fs-write test seed",
        help = "keep the explicit query, escape and main fixture",
    }
