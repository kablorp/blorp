import:
    option: to_result
    result: Result methods
    ../../src/common/analysis/check/check: CheckedProgram, check
    ../../src/common/analysis/namespace/builtins as builtins
    ../../src/common/codegen/lower/lower as lower
    ../../src/common/codegen/specialize/specialize as specialized
    ../../src/common/syntax/source: compiler_source
    ../../src/common/syntax/syntax:
        Diagnostic,
        DiagnosticKind(ProgramProblem),
        entry_function,
        SystemOperation(GetCurrentDirectory),
    ./input: setup_diagnostic
    ./module_input: TestFoundation, parse_modules_with_base


CURRENT_DIRECTORY_SOURCE: String =
    |func query() -> Result[String, String]:
    |    builtin("system.get_current_directory")
    |func escape() -> String:
    |    match query():
    |        Ok(path): path
    |        Err(error): error
    |func main() -> Int:
    |    unused = query()
    |    escaped = escape()
    |    0
    |


record CurrentDirectorySeed {
    lowered: lower.LoweredProgram,
    query: lower.LoweredFunction,
    escape: specialized.FunctionInstanceId,
    constructors: builtins.DesignatedResult[specialized.VariantInstanceId],
}


pure func checked_current_directory(
    foundation: TestFoundation,
) -> Result[CheckedProgram, Diagnostic]:
    parsed ?= parse_modules_with_base(
        [{ source = CURRENT_DIRECTORY_SOURCE, targets = [] }],
        foundation,
    )
    check(parsed).map_err(setup_diagnostic)


pure func current_directory_seed(
    foundation: TestFoundation,
) -> Result[CurrentDirectorySeed, Diagnostic]:
    current_directory_seed_from_source(CURRENT_DIRECTORY_SOURCE, foundation)


-- Both callers supply the same query/escape prefix; verifier alone adds a foreign union.
pure func current_directory_seed_from_source(
    source: String,
    foundation: TestFoundation,
) -> Result[CurrentDirectorySeed, Diagnostic]:
    parsed ?= parse_modules_with_base([{ source = source, targets = [] }], foundation)
    checked ?= check(parsed).map_err(setup_diagnostic)
    concrete ?= specialized.specialize(checked)
    lowered ?= lower.lower(concrete)
    contents = lower.lowered_functions(lowered)
    main ?= contents.functions
        .get(specialized.function_number(entry_function(contents.entrypoint)))
        .to_result(invalid_seed())
    match main.steps:
        [lower.Define(query_call), lower.Define(escape_call), ...remaining]:
            current_directory_seed_from_calls(lowered, contents, query_call, escape_call)
        _:
            Err(invalid_seed())


-- The checker's nesting limit and the ban on `?=` inside match arms mean each arm that needs a Result binding lives in its own function.
private pure func current_directory_seed_from_calls(
    lowered: lower.LoweredProgram,
    contents: lower.LoweredFunctions,
    query_call: lower.ValueDefinition,
    escape_call: lower.ValueDefinition,
) -> Result[CurrentDirectorySeed, Diagnostic]:
    query_id ?= called_function(query_call)
    escape_id ?= called_function(escape_call)
    query ?= contents.functions
        .get(specialized.function_number(query_id))
        .to_result(invalid_seed())
    match query.steps:
        [lower.Define(result)]:
            match result.operation:
                lower.CallValue(call, []):
                    match call:
                        specialized.RuntimeFunction(builtins.SystemCall(GetCurrentDirectory, constructors)):
                            Ok({
                                lowered = lowered,
                                query = query,
                                escape = escape_id,
                                constructors = constructors,
                            })
                        _:
                            Err(invalid_seed())
                _:
                    Err(invalid_seed())
        _:
            Err(invalid_seed())


pure func called_function(
    definition: lower.ValueDefinition,
) -> Result[specialized.FunctionInstanceId, Diagnostic]:
    match definition.operation:
        lower.CallValue(call, []):
            match call:
                specialized.UserFunction(id): Ok(id)
                _: Err(invalid_seed())
        _:
            Err(invalid_seed())


private pure func invalid_seed() -> Diagnostic:
    {
        span = { source = compiler_source(), start = 0, end = 0 },
        kind = ProgramProblem,
        note = None,
        message = "invalid current-directory test seed",
        help = "keep the explicit query and main fixture",
    }
