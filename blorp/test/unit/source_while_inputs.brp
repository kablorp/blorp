import:
	../../src/check/check: CheckedProgram, check
	../../src/lower/lower: LoweredProgram, lower
	../../src/specialize/specialize: SpecializedProgram, specialize
	../../src/utils/syntax: Diagnostic
	./input: setup_diagnostic
	./module_input: test_base, TestFoundation, parse_modules_with_base


ZERO_ITERATIONS: String =
	|func main() -> Int:
	|    var cursor: Int = 0
	|    while False:
	|        cursor = 1
	|    cursor
	|


HEADER_SWAP: String =
	|func main() -> Int:
	|    var first: Int = 1
	|    var second: Int = 2
	|    var again: Bool = True
	|    while again:
	|        previous = first
	|        first = second
	|        second = previous
	|        again = False
	|    first
	|


STATEMENT_IF: String =
	|func main() -> Int:
	|    var number: Int = 0
	|    if True:
	|        number = 7
	|    number
	|


-- The condition's final False edge must publish the write to total, even
-- though the ordinary body is skipped. This uses the parser's block header.
CONDITION_WRITES: String =
	|func main() -> Int:
	|    var total: Int = 0
	|    flag: Bool = False
	|    while match flag:
	|        True:
	|            total = 7
	|            True
	|        False:
	|            total = 9
	|            False
	|    :
	|        total = 1
	|    total
	|


-- The parameter is borrowed PRE, the concatenation is a mortal iteration
-- owner, and its alias must not turn either managed value into H.
MANAGED_LOCAL: String =
	|pure func append(left: String, right: String) -> String:
	|    builtin("string.add")
	|pure func run(text: String) -> String:
	|    var again: Bool = True
	|    while again:
	|        local = append(text, "suffix")
	|        retained_local = local
	|        again = False
	|        unused = retained_local
	|    text
	|func main() -> Int:
	|    result = run("PRE")
	|    0
	|


pure func checked_with(source: String, foundation: TestFoundation) -> Result[CheckedProgram, Diagnostic]:
	parsed ?= parse_modules_with_base([{ source = source, targets = [] }], foundation)
	check(parsed).map_err(setup_diagnostic)


pure func checked(source: String) -> Result[CheckedProgram, Diagnostic]:
	checked_with(source, test_base())


pure func concrete(source: String) -> Result[SpecializedProgram, Diagnostic]:
	checked(source).and_then(specialize)


pure func lowered(source: String) -> Result[LoweredProgram, Diagnostic]:
	concrete(source).and_then(lower)


MANAGED_OWNER: String =
	|pure func append(left: String, right: String) -> String:
	|    builtin("string.add")
	|func main() -> Int:
	|    pre = append("left", "right")
	|    var again: Bool = True
	|    while again:
	|        local = append(pre, "tail")
	|        again = False
	|        retained_local = local
	|    retained = pre
	|    0
	|
