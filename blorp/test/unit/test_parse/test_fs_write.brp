import:
    test: TestSuite
    ../../../src/parse/assemble: parsed_contents
    ../../../src/utils/ids: inventory_functions
    ../../../src/utils/syntax:
        ParsedBody(ParsedBuiltinBody),
        ParsedRuntimeOperation(SystemBuiltin),
        SystemOperation(FsWriteText),
    ../module_input: parse_modules


-- The label is spelled out here, so the test does not follow system_operation_label.
pure func test_write_text_label() -> Bool:
    source = "func store(path: String, text: String) -> Result[Void, Int]:\n    builtin(\"fs.write_text\")\nfunc main() -> Int:\n    0\n"
    match parse_modules([{ source = source, targets = [] }]):
        Err(_): False
        Ok(program):
            match inventory_functions(parsed_contents(program).declarations).get(0):
                Some(row):
                    match row.declaration.body:
                        ParsedBuiltinBody(SystemBuiltin(parsed), _): parsed == FsWriteText
                        _: False
                None: False


tests: TestSuite = {
    description = "Blorp fs write label",
    tests = [("fs.write_text parses to FsWriteText", test_write_text_label)],
}
