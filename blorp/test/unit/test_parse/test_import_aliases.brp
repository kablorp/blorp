import:
	../../../src/lex/lex: lex
	../../../src/parse/assemble: assembly_names, begin_program
	../../../src/parse/parse: ImportSelection(ConstructorSelection, NamedSelection), ParsedImport, ParsedModule, module_imports, module_names, parse_module
	../../../src/utils/names: name_spelling
	../../../src/utils/source: module_source, root_module_id
	../../../src/utils/syntax: Diagnostic
	test: TestSuite


private pure func root_module(source: String) -> Result[ParsedModule, Diagnostic]:
	assembly = begin_program()
	tokens ?= lex(module_source(root_module_id()), source, assembly_names(assembly))
	parse_module(tokens, root_module_id())


private pure func rows(source: String) -> List[ParsedImport]:
	match root_module(source):
		Ok(parsed):
			module_imports(parsed)
		Err(_):
			[]


-- `path as Alias` records the alias on the row and selects nothing.
pure func test_alias_row_selects_nothing() -> Bool:
	source: String =
		|import:
		|    int as IntOps
		|
	match root_module(source):
		Err(_):
			False
		Ok(parsed):
			match module_imports(parsed):
				[row]:
					match row.module_alias:
						Some(module_alias):
							(
								name_spelling(module_names(parsed), module_alias.id) == Some("IntOps")
								and module_alias.span.start == 19 and module_alias.span.end == 25
								and row.symbols.length() == 0
								and row.span.start == 12 and row.span.end == 25
							)
						None:
							False
				_:
					False


pure func test_alias_row_may_select_names_inline_and_in_a_block() -> Bool:
	source: String =
		|import:
		|    string as StringOps: length, Choice(One)
		|    ../shared as Shared:
		|        answer,
		|        other
		|
	match rows(source):
		[inline, block]:
			match (inline.symbols, block.symbols):
				([NamedSelection(_), ConstructorSelection(_, _)], [NamedSelection(_), NamedSelection(_)]):
					inline.module_alias.is_some() and block.module_alias.is_some()
				_:
					False
		_:
			False


pure func test_rows_without_as_have_no_alias() -> Bool:
	match rows("import:\n    int: add\n"):
		[row]:
			row.module_alias.is_none()
		_:
			False


tests: TestSuite = {
	description = "Blorp 2 module alias rows",
	tests = [
		("alias row selects nothing", test_alias_row_selects_nothing),
		("alias row may select names inline and in a block", test_alias_row_may_select_names_inline_and_in_a_block),
		("rows without as have no alias", test_rows_without_as_have_no_alias),
	]
}
