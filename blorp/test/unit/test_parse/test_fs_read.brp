import:
    test: TestSuite
    ../../../src/parse/assemble: parsed_contents
    ../../../src/utils/ids: inventory_functions
    ../../../src/utils/syntax:
        ParsedBody(ParsedBuiltinBody),
        ParsedRuntimeOperation(SystemBuiltin),
        SystemOperation(FsReadText, FsEntryKind),
    ../module_input: parse_modules


-- The label is spelled out here, so the test does not follow system_operation_label.
private pure func label_parses_to(label: String, expected: SystemOperation) -> Bool:
    source = "func query(path: String) -> Result[String, Int]:\n    builtin(\"${label}\")\nfunc main() -> Int:\n    0\n"
    match parse_modules([{ source = source, targets = [] }]):
        Err(_): False
        Ok(program):
            match inventory_functions(parsed_contents(program).declarations).get(0):
                Some(row):
                    match row.declaration.body:
                        ParsedBuiltinBody(SystemBuiltin(parsed), _): parsed == expected
                        _: False
                None: False


pure func test_read_text_label() -> Bool:
    label_parses_to("fs.read_text", FsReadText)


pure func test_entry_kind_label() -> Bool:
    label_parses_to("fs.entry_kind", FsEntryKind)


tests: TestSuite = {
    description = "Blorp fs operation labels",
    tests = [
        ("fs.read_text parses to FsReadText", test_read_text_label),
        ("fs.entry_kind parses to FsEntryKind", test_entry_kind_label),
    ],
}
