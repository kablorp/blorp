import:
	../../../src/parse/assemble: parsed_contents
	../../../src/utils/ids: inventory_functions
	../../../src/utils/syntax: ParsedBody(ParsedBuiltinBody), ParsedRuntimeOperation(SystemBuiltin), SystemOperation, SYSTEM_OPERATIONS, system_operation_label
	../module_input: parse_modules
	test: TestSuite


-- Parsing does not check the contract, so one header serves every label.
-- A label shared by two operations parses to the first, so the other fails.
private pure func parses_to(operation: SystemOperation) -> Bool:
	source = "func query() -> Int:\n    builtin(\"${system_operation_label(operation)}\")\nfunc main() -> Int:\n    0\n"
	match parse_modules([{ source = source, targets = [] }]):
		Err(_): False
		Ok(program):
			match inventory_functions(parsed_contents(program).declarations).get(0):
				Some(row):
					match row.declaration.body:
						ParsedBuiltinBody(SystemBuiltin(parsed), _): parsed == operation
						_: False
				None: False


pure func test_system_labels_are_distinct_and_round_trip() -> Bool:
	SYSTEM_OPERATIONS.all(pure func(operation: SystemOperation) -> Bool: parses_to(operation))


tests: TestSuite = {
	description = "Blorp system operation labels",
	tests = [
		("system labels are distinct and each parses back to its own operation", test_system_labels_are_distinct_and_round_trip),
	]
}
