import:
	../../../src/lex/lex: lex
	../../../src/parse/assemble: ParsedAssembly, append_module, assembly_names, begin_program
	../../../src/parse/parse: parse_module
	../../../src/utils/source: ModuleKind(UserModule), module_source, root_module_id
	../../../src/utils/syntax: Diagnostic
	bool: Bool methods
	result: Result methods
	test: TestSuite


private pure func appended_at(path: String) -> Result[ParsedAssembly, Diagnostic]:
	assembly = begin_program()
	tokens ?= lex(module_source(root_module_id()), "func main() -> Int:\n    0\n", assembly_names(assembly))
	parsed ?= parse_module(tokens, root_module_id())
	append_module(assembly, parsed, [], UserModule, path)


private pure func rejected_without_a_file_name(path: String) -> Bool:
	match appended_at(path):
		Err(error):
			error.message == "module path has no file name"
		Ok(_):
			False


pure func test_a_path_without_a_file_name_is_rejected() -> Bool:
	rejected_without_a_file_name("").and(rejected_without_a_file_name("dir/"))


pure func test_a_path_with_a_file_name_is_accepted() -> Bool:
	match appended_at("dir/main.brp"):
		Ok(_): True
		Err(_): False


tests: TestSuite = {
	description = "Blorp 2 module paths at assembly",
	tests = [
		("path without a file name is rejected", test_a_path_without_a_file_name_is_rejected),
		("path with a file name is accepted", test_a_path_with_a_file_name_is_accepted),
	]
}
