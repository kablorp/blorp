import:
	../../../src/utils/names: program_names
	../../../src/lex/lex: lex
	../../../src/parse/assemble: ParsedProgram, parsed_contents
	../../../src/utils/ids: inventory_functions
	../../../src/utils/source: module_source, root_module_id
	../../../src/utils/syntax:
		Diagnostic,
		ExpressionBase(StringExpression),
		ParsedBody(ParsedMatchBody, ParsedValueBody),
		ParsedFunction,
		ParsedStatement(ExpressionStatement),
		ValueExpression,
	../input: parse
	test: TestSuite


private pure func root_functions(source: String) -> List[ParsedFunction]:
	match lex(module_source(root_module_id()), source, program_names().names).and_then(pure func(tokens): parse(tokens)):
		Ok(parsed):
			inventory_functions(parsed_contents(parsed).declarations)
				.filter(pure func(row): row.declaration.module == root_module_id())
				.map(pure func(row): row.declaration)
		Err(_):
			[]


private pure func string_of(value: ValueExpression) -> Option[String]:
	match value.base:
		StringExpression(text):
			Some(text)
		_:
			None


-- A pipe String is a String expression whose value is the joined lines; the
-- expression spans from the first marker to the end of the last line.
pure func test_pipe_string_is_the_function_value() -> Bool:
	source: String =
		|func main() -> String:
		|	|one
		|	|two
		|

	match root_functions(source):
		[function]:
			match function.body:
				ParsedValueBody(value):
					string_of(value) == Some("one\ntwo") and value.span.start == 24 and value.span.end == 34
				_:
					False
		_:
			False


pure func test_raw_block_is_the_function_value() -> Bool:
	source: String =
		|func main() -> String:
		|	raw
		|		|a\n
		|		||
		|		|
		|

	match root_functions(source):
		[function]:
			match function.body:
				ParsedValueBody(value):
					string_of(value) == Some("a\\n\n|\n") and value.span.start == 24 and value.span.end == 43
				_:
					False
		_:
			False


pure func test_pipe_string_may_be_a_statement_before_the_value() -> Bool:
	source: String =
		|func main() -> Int:
		|	|discarded
		|	0
		|

	match root_functions(source):
		[function]:
			match function.statements:
				[ExpressionStatement(value)]:
					string_of(value) == Some("discarded")
				_:
					False
		_:
			False


pure func test_pipe_string_may_be_an_arm_result() -> Bool:
	source: String =
		|func main() -> String:
		|	match value:
		|		First:
		|			|one
		|		Second:
		|			|two
		|

	match root_functions(source):
		[function]:
			match function.body:
				ParsedMatchBody(body):
					body.arms.map(pure func(arm): arm.block.value.and_then(pure func(value): string_of(value))) == [Some("one"), Some("two")]
				_:
					False
		_:
			False


tests: TestSuite = {
	description = "Blorp 2 pipe String expressions",
	tests = [
		("pipe string is the function value", test_pipe_string_is_the_function_value),
		("raw block is the function value", test_raw_block_is_the_function_value),
		("pipe string may be a statement before the value", test_pipe_string_may_be_a_statement_before_the_value),
		("pipe string may be an arm result", test_pipe_string_may_be_an_arm_result),
	]
}
