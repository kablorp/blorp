import:
	../../../src/utils/source: module_source, root_module_id
	../../../src/lex/lex: lex
	../../../src/utils/names: name_spelling, program_names
	../../../src/parse/assemble: parsed_contents as program_contents
	../../../src/utils/ids: inventory_functions, inventory_records
	../input: parse
	../../../src/utils/syntax:
		ExpressionBase(RecordExpression),
		ParsedBody(ParsedValueBody),
		PostfixOperation(FieldAccess, ReceiverInvocation),
		Symbol(LeftBrace, RightBrace),
		TokenKind(SymbolToken),
	test: TestSuite


pure func test_brace_token_spans() -> Bool:
	match lex(module_source(root_module_id()), "{}", program_names().names):
		Ok(tokens):
			match tokens.tokens:
				[opening, closing, _]:
					match opening.kind:
						SymbolToken(LeftBrace):
							match closing.kind:
								SymbolToken(RightBrace):
									(
										opening.span.start == 0
										and opening.span.end == 1
										and closing.span.start == 1
										and closing.span.end == 2
									)
								_:
									False
						_:
							False
				_:
					False
		_:
			False


pure func test_written_field_order_and_mixed_postfix() -> Bool:
	source: String =
		|record Pair { first: Int, second: Int }
		|func main() -> Int:
		|	{ second = 9, first = 7 }.read().first
		|
	result = lex(module_source(root_module_id()), source, program_names().names).and_then(parse)

	match result:
		Ok(program):
			parsed = program_contents(program)
			records = inventory_records(parsed.declarations)
				.filter(pure func(row): row.declaration.module == root_module_id())
				.map(pure func(row): row.declaration)
			functions = inventory_functions(parsed.declarations)
				.filter(pure func(row): row.declaration.module == root_module_id())
				.map(pure func(row): row.declaration)

			match records:
				[declaration]:
					match functions:
						[function]:
							match function.body:
								ParsedValueBody(value):
									match value.base:
										RecordExpression([second, first]):
											match value.applications:
												[ReceiverInvocation(call), FieldAccess(field)]:
													(
														name_spelling(
															parsed.names,
															declaration.type_name.id,
														) == Some("Pair")
														and name_spelling(
															parsed.names,
															second.name.id,
														) == Some("second")
														and name_spelling(
															parsed.names,
															first.name.id,
														) == Some("first")
														and name_spelling(
															parsed.names,
															call.callee.id,
														) == Some("read")
														and name_spelling(
															parsed.names,
															field.id,
														) == Some("first")
													)
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False
		_:
			False


tests: TestSuite = {
	description = "Record syntax",
	tests = [
		("brace tokens retain byte spans", test_brace_token_spans),
		(
			"literal fields and mixed postfix retain written order",
			test_written_field_order_and_mixed_postfix,
		),
	]
}
