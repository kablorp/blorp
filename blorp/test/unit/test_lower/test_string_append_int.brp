import:
	../../../src/lower/lower as Lower
	../../../src/namespace/builtins as Builtins
	../../../src/specialize/specialize as Concrete
	../../../src/utils/source: module_source, root_module_id
	../source_while_inputs as Input
	../string_append_int_inputs: APPEND_DECLARATION, DIRECT_APPEND, RECEIVER_APPEND, WRAPPED_APPEND, NAMED_APPEND, STORED_APPEND
	test: TestSuite


private pure func append_body(function: Lower.LoweredFunction) -> Bool:
	match (function.signature.parameters, function.signature.return_type, function.steps):
		([Concrete.StringType, Concrete.IntType], Concrete.StringType,
			[Lower.Define(text), Lower.Define(number), Lower.Define(result)]):
			match (text.operation, number.operation, result.operation):
				(Lower.ParameterValue(0), Lower.ParameterValue(1), Lower.CallValue(Concrete.RuntimeFunction(Builtins.StringAppendInt), [left, right])):
					(Lower.value_number(left) == Lower.value_number(text.id)
						and Lower.value_number(right) == Lower.value_number(number.id)
						and Lower.value_number(function.result) == Lower.value_number(result.id))
				_: False
		_: False


private pure func direct_append_keeps_span_without_digits(source: String, anchor: String) -> Bool:
	complete = APPEND_DECLARATION + source
	start = complete.index_of(anchor).get_or(-1)
	match Input.lowered(complete):
		Err(_): False
		Ok(program):
			match Lower.lowered_functions(program).functions:
				[_, function]:
					match function.steps.last():
						Some(Lower.Define(result)):
							(append_body(function) and result.span.source == module_source(root_module_id())
								and result.span.start == start and result.span.end == start + "append_number".length())
						_: False
				_: False


private pure func callable_wrapper_remains_reachable(source: String) -> Bool:
	match Input.lowered(APPEND_DECLARATION + source):
		Err(_): False
		Ok(program): Lower.lowered_functions(program).functions.any(append_body)


tests: TestSuite = {
	description = "Blorp 2 integer append lowering",
	tests = [
		("direct call lowers one operation without managed digits", pure func(): direct_append_keeps_span_without_digits(DIRECT_APPEND, "append_number(text, number)")),
		("UFCS call retains call span and scalar operand", pure func(): direct_append_keeps_span_without_digits(RECEIVER_APPEND, "append_number(number)")),
		("ordinary wrapper remains reachable", pure func(): callable_wrapper_remains_reachable(WRAPPED_APPEND)),
		("named callable retains its borrowed wrapper", pure func(): callable_wrapper_remains_reachable(NAMED_APPEND)),
		("stored callable retains its borrowed wrapper", pure func(): callable_wrapper_remains_reachable(STORED_APPEND)),
	]
}
