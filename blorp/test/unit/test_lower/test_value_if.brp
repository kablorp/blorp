import:
	../../../src/lower/lower as Lower
	../../../src/specialize/specialize as Concrete
	../value_if_inputs as Input
	test: TestSuite


private pure func alias_edges(source: String) -> Option[Bool]:
	program ?= Input.lowered(source).to_option()
	var joins: List[Lower.LoweredJoin] = []
	for function in Lower.lowered_functions(program).functions:
		for step in function.steps:
			match step:
				Lower.Join(join): joins = joins.append(join)
				_: void
	join ?= joins.get(0)
	changed ?= join.arms.get(0)
	unchanged ?= join.arms.get(1)
	match (changed.exit, unchanged.exit):
		(Lower.Yield(changed_outputs), Lower.Yield(unchanged_outputs)):
			match (changed_outputs.carried.get(0), unchanged_outputs.carried.get(0)):
				(Some(changed_carrier), Some(unchanged_carrier)):
					Some(joins.length() == 1 and join.carried.length() == 1
						and join.arms.length() == 2
						and Lower.value_number(changed_outputs.value) != Lower.value_number(changed_carrier)
						and Lower.value_number(unchanged_outputs.value) == Lower.value_number(unchanged_carrier))
				_: None
		_: None


pure func test_result_and_carrier_keep_independent_source_occurrences() -> Bool:
	alias_edges(Input.STRING_ALIAS).get_or(False) and alias_edges(Input.LIST_ALIAS).get_or(False)


tests: TestSuite = {
	description = "Blorp 2 value if lowering",
	tests = [("result and carrier preserve aliased occurrences", test_result_and_carrier_keep_independent_source_occurrences)]
}
