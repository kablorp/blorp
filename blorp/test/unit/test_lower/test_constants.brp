import:
	../../../src/lower/lower as Lower
	../../../src/specialize/specialize: record_number
	../../../src/utils/source: module_source, root_module_id
	../constant_inputs: TWICE, AGGREGATE_TWICE, lowered
	test: TestSuite


pure func test_each_string_read_gets_a_fresh_value_identity_and_use_span() -> Bool:
	match lowered(TWICE):
		Err(_): False
		Ok(program):
			match Lower.lowered_functions(program).functions:
				[main]:
					match main.steps:
						[Lower.Define(first), Lower.Define(second), Lower.Define(zero)]:
							match (first.operation, second.operation, zero.operation):
								(Lower.StringValue(left), Lower.StringValue(right), Lower.IntegerValue(0)):
									prefix = "private UNUSED: String = \"absent\"\nprivate TEXT: String = \"kept λ\"\nfunc main() -> Int:\n    first = "
									second_prefix = prefix + "TEXT\n    second = "
									(left == "kept λ" and right == left
										and Lower.value_number(first.id) == 0 and Lower.value_number(second.id) == 1
										and Lower.value_number(zero.id) == 2
										and first.span.start == prefix.length() and first.span.end == prefix.length() + 4
										and second.span.start == second_prefix.length() and second.span.end == second_prefix.length() + 4
										and first.span.source == module_source(root_module_id())
										and second.span.source == first.span.source)
								_: False
						_: False
				_: False


pure func test_aggregate_reads_create_distinct_children_and_roots() -> Bool:
	match lowered(AGGREGATE_TWICE):
		Err(_): False
		Ok(program):
			match Lower.lowered_functions(program).functions:
				[main]:
					match main.steps:
						[Lower.Define(first_child), Lower.Define(first), Lower.Define(second_child), Lower.Define(second), Lower.Define(zero)]:
							match (first.operation, second.operation):
								(Lower.ConstructRecordValue(left, [first_field]), Lower.ConstructRecordValue(right, [second_field])):
									match (first_child.operation, second_child.operation, zero.operation):
										(Lower.StringValue("kept λ"), Lower.StringValue("kept λ"), Lower.IntegerValue(0)):
											(record_number(left) == record_number(right)
												and Lower.value_number(first_field.value) == Lower.value_number(first_child.id)
												and Lower.value_number(second_field.value) == Lower.value_number(second_child.id)
												and Lower.value_number(first_child.id) != Lower.value_number(second_child.id)
												and Lower.value_number(first.id) != Lower.value_number(second.id)
												and first.span.source == module_source(root_module_id())
												and first_child.span.start == second_child.span.start and first.span.start != second.span.start)
										_: False
								_: False
						_: False
				_: False


tests: TestSuite = {
	description = "Constant use value identity",
	tests = [
		("each materialized String has its own value and occurrence", test_each_string_read_gets_a_fresh_value_identity_and_use_span),
		("aggregate reads construct independent children and roots", test_aggregate_reads_create_distinct_children_and_roots),
	],
}
