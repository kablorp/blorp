import:
	../../../src/lower/lower as Lower
	../../../src/namespace/builtins as Builtins
	../../../src/specialize/specialize as Concrete
	../../../src/utils/source: module_source, root_module_id
	../string_slice_inputs: slice_seed
	test: TestSuite


pure func test_slice_lowering_preserves_operands_and_result() -> Bool:
	match slice_seed():
		Err(_): False
		Ok(seed):
			match seed.query.steps:
				[Lower.Define(text), Lower.Define(start), Lower.Define(end), Lower.Define(result)]:
					match (text.operation, start.operation, end.operation, result.operation):
						(Lower.ParameterValue(0), Lower.ParameterValue(1), Lower.ParameterValue(2), Lower.CallValue(target, [text_id, start_id, end_id])):
							match target:
								Concrete.RuntimeFunction(Builtins.StringSlice(option)):
									(
										Lower.value_number(text_id) == Lower.value_number(text.id)
										and Lower.value_number(start_id) == Lower.value_number(start.id)
										and Lower.value_number(end_id) == Lower.value_number(end.id)
										and result.value_type == Concrete.UnionType(Concrete.variant_owner(option.some))
										and result.span.source == module_source(root_module_id())
										and result.span.start == 89 and result.span.end == 103
									)
								_: False
						_: False
				_: False


tests: TestSuite = {
	description = "Blorp 2 String slice lowering",
	tests = [("slice preserves all three operand identities, result and occurrence span", test_slice_lowering_preserves_operands_and_result)]
}
