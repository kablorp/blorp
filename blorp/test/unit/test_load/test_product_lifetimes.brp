import:
	../../../src/load/load: SourceFile, SourceInputs
	test: TestSuite


private pure func source_row(index: Int) -> SourceFile:
	{
		path = "module_" + index.to_string() + ".brp",
		contents = "-- source é λ\nfunc main() -> Int:\n\t" + index.to_string() + "\n"
	}


private pure func inventory_child(width: Int) -> Option[SourceFile]:
	var rows: List[SourceFile] = []
	for index in 0..width:
		rows = rows.append(source_row(index))
	inputs: SourceInputs = { modules = rows }
	inputs.modules.get(width / 2)


private pure func inventory_product_survives(width: Int) -> Bool:
	match inventory_child(width):
		Some(saved):
			expected = source_row(width / 2)
			saved.path == expected.path and saved.contents == expected.contents
		None: False


-- Both slots own the same mortal path/content allocations. Returning one row
-- keeps it live when the inventory and its repeated occurrence are released.
private pure func repeated_source(index: Int) -> Option[SourceFile]:
	row = source_row(index)
	inputs: SourceInputs = { modules = [row, row] }
	inputs.modules.get(1)


pure func test_repeated_source_survives_inventory() -> Bool:
	match repeated_source(73):
		Some(saved):
			saved.path == "module_73.brp" and saved.contents == "-- source é λ\nfunc main() -> Int:\n\t73\n"
		None: False


tests: TestSuite = {
	description = "Retained compiler source inventories",
	tests = [
		("a source survives a 16-row inventory", pure func(): inventory_product_survives(16)),
		("a source survives a 32-row inventory", pure func(): inventory_product_survives(32)),
		("a source survives a 64-row inventory", pure func(): inventory_product_survives(64)),
		("a source survives a 128-row inventory", pure func(): inventory_product_survives(128)),
		("a repeated source row survives its inventory", test_repeated_source_survives_inventory),
	]
}
