MANY_ITERATIONS: String =
	|pure func add(left: Int, right: Int) -> Int:
	|    builtin("int.add")
	|pure func less(left: Int, right: Int) -> Bool:
	|    builtin("int.less_than")
	|func main() -> Int:
	|    var outer: Int = 0
	|    var total: Int = 0
	|    while less(outer, 3):
	|        var inner: Int = 0
	|        while less(inner, 2):
	|            total = add(total, 1)
	|            inner = add(inner, 1)
	|        outer = add(outer, 1)
	|    total
	|


FINAL_FALSE_WRITES: String =
	|func main() -> Int:
	|    var total: Int = 0
	|    var outer: Bool = True
	|    while outer:
	|        while match outer:
	|            True:
	|                total = 7
	|                False
	|            False:
	|                False
	|        :
	|            void
	|        outer = False
	|    total
	|


MANAGED_INNER_HEADER: String =
	|func main() -> Int:
	|    while False:
	|        var text: String = "old"
	|        while False:
	|            text = "new"
	|    0
	|


MANAGED_CONDITION_HEADER: String =
	|func main() -> Int:
	|    flag: Bool = False
	|    while match flag:
	|        True:
	|            var text: String = "old"
	|            while False:
	|                text = "new"
	|            False
	|        False:
	|            False
	|    :
	|        void
	|    0
	|


MANAGED_PRE: String =
	|pure func append(left: String, right: String) -> String:
	|    builtin("string.add")
	|pure func length(text: String) -> Int:
	|    builtin("string.length")
	|func main() -> Int:
	|    pre = append("pre", "!")
	|    var outer: Bool = True
	|    while outer:
	|        local = append(pre, "x")
	|        var inner: Bool = True
	|        while inner:
	|            iteration = append(local, "y")
	|            inner = False
	|        after = append(local, "z")
	|        outer = False
	|    retained = pre
	|    length(retained)
	|
