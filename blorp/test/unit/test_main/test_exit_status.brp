---
Tests for the exit status a failed compilation asks for: each diagnostic kind
maps to its own status, the constructors set the kind, and a report with
several diagnostics takes the most severe.
---
import:
    bool: and
    list: List methods
    test: TestSuite
    ../../../src/cli: EXIT_INTERNAL, EXIT_PATH, EXIT_REJECTED
    ../../../src/main: diagnostics_status, kind_status
    ../../../src/syntax/source: module_source, root_module_id
    ../../../src/syntax/syntax:
        Diagnostics,
        Span,
        DiagnosticKind(ProgramProblem, PathProblem, CompilerFault),
        compiler_span,
        diagnostic,
        internal_error,
        path_error,


pure func test_each_kind_has_its_own_status() -> Bool:
    and(
        kind_status(ProgramProblem) == EXIT_REJECTED,
        and(kind_status(PathProblem) == EXIT_PATH, kind_status(CompilerFault) == EXIT_INTERNAL),
    )


private pure func statuses_for(span: Span) -> List[Int]:
    [
        diagnostic(span, "m", "h").kind.kind_status(),
        path_error(span, "m", "h").kind.kind_status(),
        internal_error(span, "m").kind.kind_status(),
    ]


-- The constructors are the only way a phase picks a kind.
pure func test_constructors_set_the_kind_whatever_the_span() -> Bool:
    in_compiler = compiler_span()
    in_module: Span = { source = module_source(root_module_id()), start = 0, end = 0 }
    and(
        statuses_for(in_compiler) == [EXIT_REJECTED, EXIT_PATH, EXIT_INTERNAL],
        statuses_for(in_module) == [EXIT_REJECTED, EXIT_PATH, EXIT_INTERNAL],
    )


pure func test_a_report_takes_the_most_severe_status() -> Bool:
    span = compiler_span()
    program = diagnostic(span, "m", "h")
    path = path_error(span, "m", "h")
    fault = internal_error(span, "m")
    and(
        diagnostics_status({ first = program, remaining = [] }) == EXIT_REJECTED,
        and(
            diagnostics_status({ first = program, remaining = [path] }) == EXIT_PATH,
            (
                diagnostics_status({ first = path, remaining = [program, fault, program] })
                == EXIT_INTERNAL
            ),
        ),
    )


TESTS: TestSuite = {
    description = "Exit statuses of failed compilations",
    tests = [
        ("each kind has its own status", test_each_kind_has_its_own_status),
        (
            "the constructors set the kind whatever the span",
            test_constructors_set_the_kind_whatever_the_span,
        ),
        ("a report takes the most severe status", test_a_report_takes_the_most_severe_status),
    ],
}
