import:
	../compilation: compile
	test: TestSuite


private WALK: String =
	|union Step:
	|	Stop
	|	Once
	|@tail_recursive
	|pure func walk(step: Step, left: Int, right: Int) -> Int:
	|	match step:
	|		Stop: right
	|		Once: walk(Stop, right, left)
	|func main() -> Int:
	|	walk(Once, 7, 9)
	|


pure func test_direct_self_tail_emits_loop() -> Bool:
	match compile(WALK):
		Err(_):
			False
		Ok(output):
			(
				output.count("blorp_loop_3_header:{") == 1
				and output.count("goto blorp_loop_3_header;") == 2
				and output.count("blorp_loop_3_break:;") == 1
				and output.count("blorp_f_1(") == 3
			)


tests: TestSuite = {
	description = "Guaranteed self-tail recursion",
	tests = [("direct self tail emits a loop", test_direct_self_tail_emits_loop)]
}
