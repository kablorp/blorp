import:
    int as IntOps
    string as StringOps
    ../../src/compile/ids: DeclarationInventory, issue_inventory
    ../../src/syntax/names: intern_names, program_names
    ../../src/syntax/source: foundation_prelude_module_id, module_source, root_module_id
    ../../src/syntax/syntax:
        ParsedFunctionGroup(FreeFunction),
        Visibility(Public),
        ExpressionBase(IntegerExpression),
        ParsedBody(ParsedValueBody),
        ParsedFunction,
        ParsedRecord,
        ParsedUnion,
        ParsedVariant,
        Purity(Impure),
        Span,


-- Direct syntax fixtures exercise the actual identity producer without parsing
-- or semantic checking. Every ID refers to one of these supplied declarations.
pure func sample_inventory() -> DeclarationInventory:
    var names = program_names().names
    var functions: List[ParsedFunction] = []
    var records: List[ParsedRecord] = []
    var unions: List[ParsedUnion] = []
    for position in [0, 1, 2, 3]:
        module = if position < 2:
            root_module_id()
        else:
            foundation_prelude_module_id()
        span: Span = {
            source = module_source(module),
            start = ((position % 2) * 40) + 10,
            end = ((position % 2) * 40) + 11,
        }
        -- One-spelling batches: each `ids` is exactly this declaration's ID.
        function_name = intern_names(names, ["function" + position.to_string()])
        names = function_name.names
        match function_name.ids:
            [function_id]:
                functions = functions.append({
                    start = span,
                    module = module,
                    visibility = Public,
                    tail_annotation = None,
                    purity = Impure,
                    function_name = { id = function_id, span = span },
                    type_parameters = [],
                    parameters = [],
                    return_type = None,
                    statements = [],
                    body = ParsedValueBody({
                        base = IntegerExpression(0),
                        base_span = span,
                        applications = [],
                        parentheses = [],
                        span = span,
                    }),
                })
            _:
                void
        record_name = intern_names(names, ["Record" + position.to_string()])
        names = record_name.names
        match record_name.ids:
            [record_id]:
                records = records.append({
                    start = span,
                    module = module,
                    visibility = Public,
                    type_name = { id = record_id, span = span },
                    type_parameters = [],
                    fields = [],
                    fixed = False,
                })
            _:
                void
    for position in [0, 1, 2, 3, 4]:
        module = if position < 2:
            root_module_id()
        else:
            foundation_prelude_module_id()
        start = if position < 2:
            (position * 40) + 30
        else:
            (position - 2) * 40
        span: Span = { source = module_source(module), start = start, end = start + 1 }
        union_name = intern_names(names, ["Union" + position.to_string()])
        names = union_name.names
        var variants: List[ParsedVariant] = []
        for variant_position in [0, 1, 2]:
            variant_name = intern_names(names, ["Variant" + variant_position.to_string()])
            names = variant_name.names
            match variant_name.ids:
                [variant_id]:
                    variants = variants.append({
                        name = { id = variant_id, span = span },
                        fields = [],
                    })
                _:
                    void
        match union_name.ids:
            [union_id]:
                unions = unions.append({
                    start = span,
                    module = module,
                    visibility = Public,
                    type_name = { id = union_id, span = span },
                    type_parameters = [],
                    variants = variants,
                    fixed = False,
                })
            _:
                void
    issue_inventory(
        functions.map(pure func(function): FreeFunction(function)),
        records,
        unions,
        [],
        [],
        [],
    )
