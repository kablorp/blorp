import:
    bool: Bool methods
    int: Int methods
    list: List methods
    result: Result methods
    string: String methods
    ../../src/compile/check/check: check
    ../../src/compile/check/render: render_failure
    ../../src/compile/lower/lower as lower
    ../../src/compile/namespace/builtins as builtins: IntegerFormat(Int64Format)
    ../../src/compile/own/own as own
    ../../src/compile/specialize/specialize as specialized
    ../../src/syntax/source: FunctionLabel, equality_label, module_source, root_module_id
    ../../src/syntax/syntax:
        Diagnostic,
        DiagnosticKind(ProgramProblem),
        Span,
        Entrypoint(NoArguments),
        EntryResult(IntegerExitStatus),
        entry_function,
    ./module_input: parse_modules


-- Raw phase inputs never read their function labels; `equality_label` only
-- supplies a label whose text nobody reads.
pure func placeholder_label(name: String) -> FunctionLabel:
    equality_label(name)


pure func lowered(source: String) -> Result[lower.LoweredProgram, Diagnostic]:
    parsed ?= parse_modules([{ source = source, targets = [] }])
    checked ?= check(parsed).map_err(pure func(failure): render_failure(failure).first)
    concrete ?= specialized.specialize(checked)
    lower.lower(concrete)


record InputIds {
    first: lower.ValueId,
    second: lower.ValueId,
    third: lower.ValueId,
    fourth: lower.ValueId,
    fifth: lower.ValueId,
    entrypoint: specialized.FunctionInstanceId,
}


pure func span(start: Int) -> Span:
    { source = module_source(root_module_id()), start = start, end = start + 1 }


-- Mint opaque identities through lowering; this seed supplies no ownership facts.
pure func input_ids() -> Result[InputIds, Diagnostic]:
    source: String =
        |func main() -> Int:
        |    first = 1
        |    second = 2
        |    third = 3
        |    fourth = 4
        |    5
        |
    program ?= lowered(source).map(lower.lowered_functions)
    match program.functions:
        [seed]:
            match seed.steps:
                [lower.Define(first), lower.Define(second), lower.Define(third), lower.Define(fourth), lower.Define(fifth)]:
                    Ok({
                        first = first.id,
                        second = second.id,
                        third = third.id,
                        fourth = fourth.id,
                        fifth = fifth.id,
                        entrypoint = entry_function(program.entrypoint),
                    })
                _:
                    Err({
                        span = span(0),
                        kind = ProgramProblem,
                        note = None,
                        message = "expected five identity seed definitions",
                        help = "fix List append test seed",
                    })
        _:
            Err({
                span = span(0),
                kind = ProgramProblem,
                note = None,
                message = "expected one identity seed function",
                help = "fix List append test seed",
            })


pure func integer(id: lower.ValueId, value: Int, start: Int) -> lower.ValueDefinition:
    {
        id = id,
        value_type = specialized.IntegerType(Int64Format),
        operation = lower.IntegerValue(value),
        span = span(start),
    }


pure func parameter(id: lower.ValueId, value_type: specialized.TypeRef) -> lower.ValueDefinition:
    { id = id, value_type = value_type, operation = lower.ParameterValue(0), span = span(10) }


pure func runtime(
    id: lower.ValueId,
    operation: builtins.RuntimeOperation[specialized.VariantInstanceId, specialized.TypeRef],
    arguments: List[lower.ValueId],
    value_type: specialized.TypeRef,
    start: Int,
) -> lower.ValueDefinition:
    {
        id = id,
        value_type = value_type,
        operation = lower.CallValue(specialized.RuntimeFunction(operation), arguments),
        span = span(start),
    }


pure func lowered_function(
    definitions: List[lower.ValueDefinition],
    result: lower.ValueId,
    parameters: List[specialized.TypeRef],
    return_type: specialized.TypeRef,
) -> lower.LoweredFunction:
    {
        label = placeholder_label("lowered"),
        signature = { parameters = parameters, return_type = return_type },
        steps = definitions.map(pure func(definition): lower.Define(definition)),
        result = result,
    }


UPDATE_DECLARATIONS: String =
    |pure func append[T](values: List[T], value: T) -> List[T]:
    |    builtin("list.append")
    |pure func set[T](values: List[T], index: Int, value: T) -> List[T]:
    |    builtin("list.set")
    |pure func concat[T](left: List[T], right: List[T]) -> List[T]:
    |    builtin("list.concat")
    |pure func length[T](values: List[T]) -> Int:
    |    builtin("list.length")
    |pure func less_than(left: Int, right: Int) -> Bool:
    |    builtin("int.less_than")
    |


pure func owned_source(body: String) -> Result[own.OwnershipProgram, Diagnostic]:
    lowered(UPDATE_DECLARATIONS + body).and_then(own.own)


pure func empty_list(id: lower.ValueId, element: specialized.TypeRef) -> lower.ValueDefinition:
    {
        id = id,
        value_type = specialized.ListType(element),
        operation = lower.ConstructListValue([]),
        span = span(10),
    }


pure func child(id: lower.ValueId) -> lower.ValueDefinition:
    {
        id = id,
        value_type = specialized.StringType,
        operation = lower.StringValue("child"),
        span = span(20),
    }


-- Independent verifier inputs: no ownership insertion supplies their oracle.
pure func raw_append(
    ids: InputIds,
    arguments: List[own.OwnedArgument],
    after: List[own.OwnershipOperation],
) -> own.OwnershipProgram:
    values: own.OwnedDefinition = {
        id = ids.first,
        value_type = specialized.ListType(specialized.StringType),
        operation = own.ConstructListDefinition([]),
        result = own.OwnedResult(own.owner_id(0)),
        span = span(10),
    }
    item: own.OwnedDefinition = {
        id = ids.second,
        value_type = specialized.StringType,
        operation = own.StringDefinition("child"),
        result = own.OwnedResult(own.owner_id(1)),
        span = span(20),
    }
    appended: own.OwnedDefinition = {
        id = ids.third,
        value_type = specialized.ListType(specialized.StringType),
        operation = own.CallDefinition(
            specialized.RuntimeFunction(builtins.ListAppend(specialized.StringType)),
            arguments,
        ),
        result = own.OwnedResult(own.owner_id(2)),
        span = span(30),
    }
    worker: own.OwnedFunction = {
        label = placeholder_label("worker"),
        parameters = [],
        return_type = specialized.ListType(specialized.StringType),
        operations = [own.DefineValue(values), own.DefineValue(item), own.DefineValue(appended)].concat(
            after,
        ),
        result = own.OwnedReturn(ids.third, own.owner_id(2)),
    }
    zero: own.OwnedDefinition = {
        id = ids.first,
        value_type = specialized.IntegerType(Int64Format),
        operation = own.IntegerDefinition(0),
        result = own.UnmanagedResult,
        span = span(50),
    }
    main: own.OwnedFunction = {
        label = placeholder_label("main"),
        parameters = [],
        return_type = specialized.IntegerType(Int64Format),
        operations = [own.DefineValue(zero)],
        result = own.UnmanagedReturn(ids.first),
    }
    {
        records = [],
        unions = [],
        functions = [main, worker],
        entrypoint = NoArguments(ids.entrypoint, IntegerExitStatus),
    }


pure func append_arguments(ids: InputIds) -> List[own.OwnedArgument]:
    [
        own.ConsumedArgument(ids.first, own.owner_id(0)),
        own.BorrowedArgument({ value = ids.second, source = own.OwnerBorrow(own.owner_id(1)) }),
    ]


private pure func tail_updates(tail: own.OwnedLoopTail, consumed_only: Bool) -> Int:
    match tail:
        own.ExitLoop(_):
            0
        own.MatchLoop(matched):
            var count = 0
            for arm in matched.arms:
                count = (
                    count
                    + count_updates(arm.body.operations, consumed_only)
                    + tail_updates(arm.body.tail, consumed_only)
                )
            count


private pure func count_updates(
    operations: List[own.OwnershipOperation],
    consumed_only: Bool,
) -> Int:
    var count = 0
    for operation in operations:
        match operation:
            own.DefineValue(definition):
                match definition.operation:
                    own.CallDefinition(specialized.RuntimeFunction(builtins.ListAppend(_) | builtins.ListSet(_) | builtins.ListConcat(_)), arguments):
                        match arguments.get(0):
                            Some(own.ConsumedArgument(_, _)):
                                count = count + 1
                            _:
                                if consumed_only.not():
                                    count = count + 1
                    _:
                        void
            own.ExecuteJoin(join):
                for arm in join.arms:
                    count = count + count_updates(arm.operations, consumed_only)
            own.ExecuteLoop(loop):
                count = (
                    count
                    + count_updates(loop.body.operations, consumed_only)
                    + tail_updates(loop.body.tail, consumed_only)
                )
            _:
                void
    count


pure func consumed_updates(operations: List[own.OwnershipOperation]) -> Int:
    count_updates(operations, True)


pure func program_updates(program: own.OwnershipProgram) -> Int:
    var count = 0
    for function in program.functions:
        count = count + count_updates(function.operations, False)
    count


pure func program_consumed(program: own.OwnershipProgram) -> Int:
    var count = 0
    for function in program.functions:
        count = count + consumed_updates(function.operations)
    count


private pure func tail_cleanup_valid(tail: own.OwnedLoopTail) -> Bool:
    match tail:
        own.ExitLoop(_):
            True
        own.MatchLoop(matched):
            var valid: Bool = True
            for arm in matched.arms:
                valid = valid
                    .and(no_consumed_drop(arm.body.operations))
                    .and(tail_cleanup_valid(arm.body.tail))
            valid


-- Observe every ordinary block recursively, without depending on IR positions.
pure func no_consumed_drop(operations: List[own.OwnershipOperation]) -> Bool:
    var valid: Bool = True
    for operation in operations:
        match operation:
            own.DefineValue(definition):
                match definition.operation:
                    own.CallDefinition(specialized.RuntimeFunction(builtins.ListAppend(_) | builtins.ListSet(_) | builtins.ListConcat(_)), arguments):
                        match arguments.get(0):
                            Some(own.ConsumedArgument(_, owner)):
                                for later in operations:
                                    match later:
                                        own.DropOwner(dropped, _):
                                            valid = valid.and(
                                                own.owner_number(dropped).not_equals(
                                                    own.owner_number(owner),
                                                ),
                                            )
                                        _:
                                            void
                            _:
                                void
                    _:
                        void
            own.ExecuteJoin(join):
                for arm in join.arms:
                    valid = valid.and(no_consumed_drop(arm.operations))
            own.ExecuteLoop(loop):
                valid = valid
                    .and(no_consumed_drop(loop.body.operations))
                    .and(tail_cleanup_valid(loop.body.tail))
            _:
                void
    valid


pure func raw_integer_append(ids: InputIds, consumed: Bool) -> own.OwnershipProgram:
    program = raw_append(ids, [], [])
    match program.functions:
        [main, worker]:
            values: own.OwnedDefinition = {
                id = ids.first,
                value_type = specialized.ListType(specialized.IntegerType(Int64Format)),
                operation = own.ConstructListDefinition([]),
                result = own.OwnedResult(own.owner_id(0)),
                span = span(10),
            }
            item: own.OwnedDefinition = {
                id = ids.second,
                value_type = specialized.IntegerType(Int64Format),
                operation = own.IntegerDefinition(7),
                result = own.UnmanagedResult,
                span = span(20),
            }
            left: own.OwnedArgument = if consumed:
                own.ConsumedArgument(ids.first, own.owner_id(0))
            else:
                own.BorrowedArgument({
                    value = ids.first,
                    source = own.OwnerBorrow(own.owner_id(0)),
                })
            appended: own.OwnedDefinition = {
                id = ids.third,
                value_type = specialized.ListType(specialized.IntegerType(Int64Format)),
                operation = own.CallDefinition(
                    specialized.RuntimeFunction(
                        builtins.ListAppend(specialized.IntegerType(Int64Format)),
                    ),
                    [left, own.UnmanagedArgument(ids.second)],
                ),
                result = own.OwnedResult(own.owner_id(1)),
                span = span(30),
            }
            cleanup: List[own.OwnershipOperation] = if consumed:
                []
            else:
                [own.DropOwner(own.owner_id(0), span(40))]
            { program |
                functions = [
                    main,
                    { worker |
                        parameters = [],
                        return_type = specialized.ListType(specialized.IntegerType(Int64Format)),
                        operations = [
                            own.DefineValue(values),
                            own.DefineValue(item),
                            own.DefineValue(appended),
                        ].concat(cleanup),
                        result = own.OwnedReturn(ids.third, own.owner_id(1)),
                    },
                ],
            }
        _:
            program


-- The raw set/concat programs define their contracts and obligations directly.
-- The unmanaged index is present in both seeds so callers share minted ids.
pure func raw_list_update(
    ids: InputIds,
    is_set: Bool,
    arguments: List[own.OwnedArgument],
    after: List[own.OwnershipOperation],
) -> own.OwnershipProgram:
    base = raw_append(ids, [], [])
    list_type: specialized.TypeRef = specialized.ListType(specialized.StringType)
    left: own.OwnedDefinition = {
        id = ids.first,
        value_type = list_type,
        operation = own.ConstructListDefinition([]),
        result = own.OwnedResult(own.owner_id(0)),
        span = span(10),
    }
    right: own.OwnedDefinition = if is_set:
        {
            id = ids.second,
            value_type = specialized.StringType,
            operation = own.StringDefinition("replacement"),
            result = own.OwnedResult(own.owner_id(1)),
            span = span(20),
        }
    else:
        {
            id = ids.second,
            value_type = list_type,
            operation = own.ConstructListDefinition([]),
            result = own.OwnedResult(own.owner_id(1)),
            span = span(20),
        }
    index: own.OwnedDefinition = {
        id = ids.third,
        value_type = specialized.IntegerType(Int64Format),
        operation = own.IntegerDefinition(0),
        result = own.UnmanagedResult,
        span = span(25),
    }
    target: builtins.RuntimeOperation[specialized.VariantInstanceId, specialized.TypeRef] = if is_set:
        builtins.ListSet(specialized.StringType)
    else:
        builtins.ListConcat(specialized.StringType)
    updated: own.OwnedDefinition = {
        id = ids.fourth,
        value_type = list_type,
        operation = own.CallDefinition(specialized.RuntimeFunction(target), arguments),
        result = own.OwnedResult(own.owner_id(2)),
        span = span(30),
    }
    match base.functions:
        [main, worker]:
            { base |
                functions = [
                    main,
                    { worker |
                        parameters = [],
                        return_type = list_type,
                        operations = [
                            own.DefineValue(left),
                            own.DefineValue(right),
                            own.DefineValue(index),
                            own.DefineValue(updated),
                        ].concat(after),
                        result = own.OwnedReturn(ids.fourth, own.owner_id(2)),
                    },
                ],
            }
        _:
            base


pure func update_arguments(ids: InputIds, is_set: Bool, consumed: Bool) -> List[own.OwnedArgument]:
    left: own.OwnedArgument = if consumed:
        own.ConsumedArgument(ids.first, own.owner_id(0))
    else:
        own.BorrowedArgument({ value = ids.first, source = own.OwnerBorrow(own.owner_id(0)) })
    right: own.OwnedArgument = own.BorrowedArgument({
        value = ids.second,
        source = own.OwnerBorrow(own.owner_id(1)),
    })
    if is_set:
        [left, own.UnmanagedArgument(ids.third), right]
    else:
        [left, right]
