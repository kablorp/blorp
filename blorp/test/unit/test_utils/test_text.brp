import:
    string as StringOps
    test: TestSuite
    ../../../src/utils/text: concat


pure func test_concatenation_preserves_both_values() -> Bool:
    match StringOps.equals(concat("left", "right"), "leftright"):
        False:
            False
        True:
            match StringOps.equals(concat("", "right"), "right"):
                False: False
                True: StringOps.equals(concat("left", ""), "left")


tests: TestSuite = {
    description = "Blorp text primitives",
    tests = [("concatenation preserves both values", test_concatenation_preserves_both_values)],
}
