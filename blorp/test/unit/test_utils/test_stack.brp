---
Tests for `push_at`, the one set-or-append step of every list-backed stack: a
walk pops by lowering its depth, so the next push overwrites the stale slot.
---
import:
    test: TestSuite
    ../../../src/utils/stack: push_at


pure func test_pushing_at_the_end_appends() -> Bool:
    push_at([1, 2], 2, 3) == [1, 2, 3]


pure func test_pushing_at_the_start_of_an_empty_list_appends() -> Bool:
    push_at([], 0, 7) == [7]


pure func test_pushing_below_the_end_overwrites_the_stale_slot() -> Bool:
    push_at([1, 2, 3], 1, 9) == [1, 9, 3]


pure func test_pushing_at_the_last_slot_keeps_the_length() -> Bool:
    push_at(["a", "b"], 1, "c") == ["a", "c"]


tests: TestSuite = {
    description = "Blorp list-backed stacks",
    tests = [
        ("pushing at the end appends", test_pushing_at_the_end_appends),
        (
            "pushing at the start of an empty list appends",
            test_pushing_at_the_start_of_an_empty_list_appends,
        ),
        (
            "pushing below the end overwrites the stale slot",
            test_pushing_below_the_end_overwrites_the_stale_slot,
        ),
        (
            "pushing at the last slot keeps the length",
            test_pushing_at_the_last_slot_keeps_the_length,
        ),
    ],
}
