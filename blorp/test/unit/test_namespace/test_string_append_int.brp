import:
	../../../src/namespace/builtins as Builtins
	../../../src/utils/syntax: Purity(Pure), ParsedRuntimeOperation(StringAppendIntBuiltin)
	test: TestSuite


pure func test_append_contract_is_pure_string_and_int_to_string() -> Bool:
	operation: Builtins.RuntimeOperation[Int, Int] = Builtins.StringAppendInt
	contract = Builtins.runtime_contract(operation)
	match (contract.purity, contract.parameters, contract.return_type):
		(Pure, [Builtins.PrimitiveRuntimeType(Builtins.BuiltinString), Builtins.PrimitiveRuntimeType(Builtins.BuiltinInt)], Builtins.ValueResult(Builtins.PrimitiveRuntimeType(Builtins.BuiltinString))): True
		_: False


pure func test_parsed_append_selects_the_typed_operation() -> Bool:
	operation: Option[Builtins.RuntimeOperation[String, Int]] = Builtins.primitive_operation(StringAppendIntBuiltin)
	match operation:
		Some(Builtins.StringAppendInt): True
		_: False


tests: TestSuite = {
	description = "Blorp 2 integer append runtime contract",
	tests = [
		("pure nongeneric String and Int contract returns String", test_append_contract_is_pure_string_and_int_to_string),
		("parsed builtin selects typed runtime operation", test_parsed_append_selects_the_typed_operation),
	]
}
