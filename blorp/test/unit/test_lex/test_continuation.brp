import:
	string as StringOps
	int as IntOps
	../../../src/utils/names: program_names
	../../../src/lex/lex: lex
	../../../src/utils/source: module_source, root_module_id
	test: TestSuite
	../test_lex/test_lex: trace


-- Inside an open bracket a line break and the next line's indentation are
-- not layout: no Newline, Indent or Dedent is produced until the bracket
-- depth returns to zero.
pure func test_line_break_inside_parentheses_produces_no_layout_tokens() -> Bool:
	StringOps.equals(trace("f(\n1,\n2)"), "name=f@0:1\n(@1:2\ninteger=1@3:4\n,@4:5\ninteger=2@6:7\n)@7:8\nLF@8:8\nEOF@8:8")


pure func test_indentation_inside_brackets_is_not_layout() -> Bool:
	StringOps.equals(trace("f(\n\t\t\t1\n)"), "name=f@0:1\n(@1:2\ninteger=1@6:7\n)@8:9\nLF@9:9\nEOF@9:9")


pure func test_mixed_indentation_inside_brackets_is_accepted() -> Bool:
	StringOps.equals(trace("f(\n \t1)"), "name=f@0:1\n(@1:2\ninteger=1@5:6\n)@6:7\nLF@7:7\nEOF@7:7")


pure func test_blank_and_comment_lines_inside_brackets_are_trivia() -> Bool:
	StringOps.equals(trace("f( -- open\n\n\t-- inside\n1)"), "name=f@0:1\n(@1:2\ninteger=1@23:24\n)@24:25\nLF@25:25\nEOF@25:25")


pure func test_every_bracket_kind_counts_toward_depth() -> Bool:
	StringOps.equals(trace("{\n[\n(\n0\n)\n]\n}"), "{@0:1\n[@2:3\n(@4:5\ninteger=0@6:7\n)@8:9\n]@10:11\n}@12:13\nLF@13:13\nEOF@13:13")


pure func test_layout_resumes_after_the_closing_bracket() -> Bool:
	StringOps.equals(trace("f(\n1)\n\tx"), "name=f@0:1\n(@1:2\ninteger=1@3:4\n)@4:5\nLF@5:6\nINDENT@6:7\nname=x@7:8\nLF@8:8\nDEDENT@8:8\nEOF@8:8")


pure func test_closing_bracket_at_depth_zero_keeps_layout() -> Bool:
	StringOps.equals(trace(")\nx"), ")@0:1\nLF@1:2\nname=x@2:3\nLF@3:3\nEOF@3:3")


pure func test_unclosed_bracket_ends_at_eof_without_dedent_errors() -> Bool:
	StringOps.equals(trace("f(\n\t1"), "name=f@0:1\n(@1:2\ninteger=1@4:5\nLF@5:5\nEOF@5:5")


-- As on any line, a `|` first on a continuation line starts a pipe String;
-- the host reads a pipe String argument the same way.
pure func test_bar_first_on_a_continuation_line_starts_a_pipe_string() -> Bool:
	StringOps.equals(trace("f(\n\t|a\n\t|b\n)"), "name=f@0:1\n(@1:2\npipe=a\nb@4:10\n)@11:12\nLF@12:12\nEOF@12:12")


pure func test_fence_inside_brackets_is_rejected() -> Bool:
	match lex(module_source(root_module_id()), "f(\n---\ndoc\n---\n1)", program_names().names):
		Ok(_):
			False
		Err(error):
			match IntOps.equals(error.span.start, 3):
				False: False
				True:
					match IntOps.equals(error.span.end, 6):
						False: False
						True:
							match StringOps.equals(error.message, "documentation block inside brackets"):
								False: False
								True:
									StringOps.equals(error.help, "close the bracket before the --- fence, or put the block before a declaration")


tests: TestSuite = {
	description = "Blorp 2 bracket continuation lines",
	tests = [
		(
			"line break inside parentheses produces no layout tokens",
			test_line_break_inside_parentheses_produces_no_layout_tokens,
		),
		("indentation inside brackets is not layout", test_indentation_inside_brackets_is_not_layout),
		("mixed indentation inside brackets is accepted", test_mixed_indentation_inside_brackets_is_accepted),
		(
			"blank and comment lines inside brackets are trivia",
			test_blank_and_comment_lines_inside_brackets_are_trivia,
		),
		("every bracket kind counts toward depth", test_every_bracket_kind_counts_toward_depth),
		("layout resumes after the closing bracket", test_layout_resumes_after_the_closing_bracket),
		("closing bracket at depth zero keeps layout", test_closing_bracket_at_depth_zero_keeps_layout),
		(
			"unclosed bracket ends at EOF without dedent errors",
			test_unclosed_bracket_ends_at_eof_without_dedent_errors,
		),
		(
			"bar first on a continuation line starts a pipe string",
			test_bar_first_on_a_continuation_line_starts_a_pipe_string,
		),
		("fence inside brackets is rejected", test_fence_inside_brackets_is_rejected),
	]
}
