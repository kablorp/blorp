import:
	string as StringOps
	int as IntOps
	../../../src/utils/names: program_names
	../../../src/lex/lex: lex
	../../../src/utils/source: module_source, root_module_id
	test: TestSuite
	../test_lex/test_lex: trace


private UNTERMINATED_MESSAGE: String = "unterminated documentation block"

private UNTERMINATED_HELP: String = "close the block with a line holding only --- at column 1"


private pure func rejects(source: String, start: Int, end: Int, message: String, help: String) -> Bool:
	match lex(module_source(root_module_id()), source, program_names().names):
		Ok(_):
			False
		Err(error):
			match IntOps.equals(error.span.start, start):
				False: False
				True:
					match IntOps.equals(error.span.end, end):
						False: False
						True:
							match StringOps.equals(error.message, message):
								False: False
								True:
									StringOps.equals(error.help, help)


-- A line holding only --- at column 1 opens a documentation block; the next
-- such line closes it. The block is trivia and produces no tokens.
pure func test_documentation_block_is_trivia() -> Bool:
	StringOps.equals(trace("---\ndoc\n---\n0"), "integer=0@12:13\nLF@13:13\nEOF@13:13")


pure func test_closing_fence_may_end_the_source() -> Bool:
	StringOps.equals(trace("---\ndoc\n---"), "EOF@11:11")


pure func test_fences_may_carry_trailing_spaces() -> Bool:
	StringOps.equals(trace("---  \ndoc\n--- \n0"), "integer=0@15:16\nLF@16:16\nEOF@16:16")


pure func test_documentation_text_admits_any_bytes_except_cr() -> Bool:
	StringOps.equals(trace("---\n\t-- é {} \"\n--\n---\n0"), "integer=0@23:24\nLF@24:24\nEOF@24:24")


pure func test_longer_or_followed_dashes_are_comments() -> Bool:
	match StringOps.equals(trace("----\n0"), "integer=0@5:6\nLF@6:6\nEOF@6:6"):
		False: False
		True:
			StringOps.equals(trace("--- x\n0"), "integer=0@6:7\nLF@7:7\nEOF@7:7")


pure func test_indented_fence_is_a_comment() -> Bool:
	StringOps.equals(trace("\t---\n0"), "integer=0@5:6\nLF@6:6\nEOF@6:6")


pure func test_documentation_block_does_not_change_layout() -> Bool:
	StringOps.equals(trace("0\n\t1\n---\nx\n---\n\t2\n3"), "integer=0@0:1\nLF@1:2\nINDENT@2:3\ninteger=1@3:4\nLF@4:5\ninteger=2@16:17\nLF@17:18\nDEDENT@18:18\ninteger=3@18:19\nLF@19:19\nEOF@19:19")


pure func test_unterminated_block_is_reported_at_its_fence() -> Bool:
	rejects("---\ndoc\n", 0, 3, UNTERMINATED_MESSAGE, UNTERMINATED_HELP)


pure func test_cr_inside_documentation_is_rejected() -> Bool:
	rejects("---\na\r\n---\n", 5, 6, "only LF line endings are supported", "replace CRLF or CR line endings with LF")


tests: TestSuite = {
	description = "Blorp 2 documentation blocks",
	tests = [
		("documentation block is trivia", test_documentation_block_is_trivia),
		("closing fence may end the source", test_closing_fence_may_end_the_source),
		("fences may carry trailing spaces", test_fences_may_carry_trailing_spaces),
		("documentation text admits any bytes except CR", test_documentation_text_admits_any_bytes_except_cr),
		("longer or followed dashes are comments", test_longer_or_followed_dashes_are_comments),
		("indented fence is a comment", test_indented_fence_is_a_comment),
		("documentation block does not change layout", test_documentation_block_does_not_change_layout),
		("unterminated block is reported at its fence", test_unterminated_block_is_reported_at_its_fence),
		("CR inside documentation is rejected", test_cr_inside_documentation_is_rejected),
	]
}
