import:
    bool: and
    list: List methods
    test: TestSuite
    ./test_lex: trace


private AFTER_VALUE: String = "'--' directly after a value starts a comment"


private AFTER_VALUE_HELP: String = "write a - -1 to subtract a negative number, or add a space before the comment"


-- Spacing never changes the tokens: each form is a name, an operator and a literal.
pure func test_spacing_gives_the_same_binary_tokens() -> Bool:
    [
        ("a-1", "name=a@0:1\n-@1:2\ninteger=1@2:3\nLF@3:3\nEOF@3:3"),
        ("a -1", "name=a@0:1\n-@2:3\ninteger=1@3:4\nLF@4:4\nEOF@4:4"),
        ("a - 1", "name=a@0:1\n-@2:3\ninteger=1@4:5\nLF@5:5\nEOF@5:5"),
        ("a+1", "name=a@0:1\n+@1:2\ninteger=1@2:3\nLF@3:3\nEOF@3:3"),
        ("a +1", "name=a@0:1\n+@2:3\ninteger=1@3:4\nLF@4:4\nEOF@4:4"),
    ].all(pure func(case): trace(case[0]) == case[1])


pure func test_multiplicative_symbols_have_exact_spans() -> Bool:
    (
        trace("a*b a/b a%b -0.5")
        == "name=a@0:1\n*@1:2\nname=b@2:3\nname=a@4:5\n/@5:6\nname=b@6:7\nname=a@8:9\n%@9:10\nname=b@10:11\n-@12:13\nfloat=0.5@13:16\nLF@16:16\nEOF@16:16"
    )


-- An exponent's sign belongs to its number; a leading sign never does.
pure func test_exponent_signs_stay_inside_numbers() -> Bool:
    and(
        trace("1e+5 1e-5") == "float=1e+5@0:4\nfloat=1e-5@5:9\nLF@9:9\nEOF@9:9",
        trace("+1e5") == "+@0:1\nfloat=1e5@1:4\nLF@4:4\nEOF@4:4",
    )


-- `->` and comments keep their meaning; `--` after an operator, a comma, an
-- opening bracket or a space is a comment.
pure func test_arrow_and_comments_are_unchanged() -> Bool:
    and(
        and(
            trace("a->b") == "name=a@0:1\n->@1:3\nname=b@3:4\nLF@4:4\nEOF@4:4",
            trace("a - --1") == "name=a@0:1\n-@2:3\nLF@7:7\nEOF@7:7",
        ),
        and(
            (
                trace("one(-- argument\n1)")
                == "name=one@0:3\n(@3:4\ninteger=1@16:17\n)@17:18\nLF@18:18\nEOF@18:18"
            ),
            (
                trace("[1,--x\n2] --y")
                == "[@0:1\ninteger=1@1:2\n,@2:3\ninteger=2@7:8\n]@8:9\nLF@13:13\nEOF@13:13"
            ),
        ),
    )


-- `a--1` would otherwise compile as `a`, so `--` directly after a name, a
-- literal, `void` or a closing bracket is rejected at the two dashes.
pure func test_comment_directly_after_a_value_is_rejected() -> Bool:
    expected: List[(String, String)] = [
        ("a--1", "error@1:3\n"),
        ("1--", "error@1:3\n"),
        ("1.5--", "error@3:5\n"),
        ("f()--x", "error@3:5\n"),
        ("[a]--x", "error@3:5\n"),
        ("{ a = 1 }--x", "error@9:11\n"),
        ("\"s\"--x", "error@3:5\n"),
        ("\"$\{a--1}\"", "error@4:6\n"),
        ("'a'--x", "error@3:5\n"),
        ("\"$\{a}\"--x", "error@6:8\n"),
        ("void--x", "error@4:6\n"),
    ]
    expected.all(pure func(case): trace(case[0]) == case[1] + AFTER_VALUE + "\n" + AFTER_VALUE_HELP)


-- Each spelling from another language is rejected over both bytes.
pure func test_foreign_spellings_teach_blorp_forms() -> Bool:
    [
        ("x += 1", "error@2:4\n'+=' is not supported yet\nwrite x = x + 1"),
        ("x-=1", "error@1:3\n'-=' is not supported yet\nwrite x = x - 1"),
        ("x *= 2", "error@2:4\n'*=' is not supported yet\nwrite x = x * 2"),
        ("x %= 2", "error@2:4\n'%=' is not supported yet\nwrite x = x % 2"),
        (
            "x /= 2",
            "error@2:4\n'/=' is not supported yet\nwrite x = x / 2, or write != for inequality",
        ),
        ("a ** b", "error@2:4\n'**' is not an operator\nmultiply, or call a power function"),
        (
            "a // b",
            "error@2:4\n'//' is not an operator\ncomments start with --; write a / b to divide",
        ),
    ].all(pure func(case): trace(case[0]) == case[1])


-- Neighbouring forms keep their tokens: a doubled minus with a space between
-- is two operators, and `=-` is an assignment followed by a minus.
pure func test_neighbouring_spellings_keep_their_tokens() -> Bool:
    and(
        trace("a - -1") == "name=a@0:1\n-@2:3\n-@4:5\ninteger=1@5:6\nLF@6:6\nEOF@6:6",
        (
            trace("x=-1 y==-2")
            == "name=x@0:1\n=@1:2\n-@2:3\ninteger=1@3:4\nname=y@5:6\n==@6:8\n-@8:9\ninteger=2@9:10\nLF@10:10\nEOF@10:10"
        ),
    )


tests: TestSuite = {
    description = "arithmetic operator punctuation",
    tests = [
        ("spacing gives the same binary tokens", test_spacing_gives_the_same_binary_tokens),
        ("multiplicative symbols have exact spans", test_multiplicative_symbols_have_exact_spans),
        ("exponent signs stay inside numbers", test_exponent_signs_stay_inside_numbers),
        ("arrow and comments are unchanged", test_arrow_and_comments_are_unchanged),
        (
            "'--' directly after a value is rejected",
            test_comment_directly_after_a_value_is_rejected,
        ),
        ("foreign spellings teach Blorp forms", test_foreign_spellings_teach_blorp_forms),
        ("neighbouring spellings keep their tokens", test_neighbouring_spellings_keep_their_tokens),
    ],
}
