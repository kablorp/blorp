import:
    result: Result methods
    ../../src/common/codegen/own/own as own
    ../../src/common/syntax/syntax: Diagnostic
    ./list_update_inputs: lowered


-- No record or union at all.
EMPTY_CATALOGUES: String =
    |func main() -> Int:
    |    0
    |


-- Four inline records: Top stores Left and Right, and both store Leaf.
DIAMOND: String =
    |fixed record Leaf { value: Int }
    |fixed record Left { leaf: Leaf }
    |fixed record Right { leaf: Leaf }
    |fixed record Top { left: Left, right: Right }
    |func main() -> Int:
    |    top: Top = { left = { leaf = { value = 1 } }, right = { leaf = { value = 2 } } }
    |    0
    |


-- Records and unions stored inside each other by value, down a chain from
-- the managed Log to the fixed Signal, with Reading also storing Stamp.
MIXED: String =
    |fixed union Signal:
    |    Quiet
    |    Level(Int)
    |fixed record Stamp { at: Int }
    |fixed record Reading { signal: Signal, stamp: Stamp }
    |union Event:
    |    Idle
    |    Seen(Reading)
    |record Log { event: Event, note: String }
    |func main() -> Int:
    |    reading: Reading = { signal = Level(3), stamp = { at = 4 } }
    |    log: Log = { event = Seen(reading), note = "seen" }
    |    0
    |


-- Layouts reached only through references: a boxed union, a managed record
-- holding a List of itself, and a callable field. Each stores Point by value.
ROOTS: String =
    |fixed record Point { x: Int }
    |union Chain:
    |    End(Point)
    |    Link(Int, Chain)
    |record Folder { name: String, children: List[Folder], origin: Point }
    |record Handler { run: pure (Int) -> Int, origin: Point }
    |pure func double(value: Int) -> Int:
    |    value
    |func main() -> Int:
    |    origin: Point = { x = 1 }
    |    chain: Chain = Link(2, End(origin))
    |    folder: Folder = { name = "top", children = [], origin = origin }
    |    handler: Handler = { run = double, origin = origin }
    |    0
    |


pure func owned(source: String) -> Result[own.OwnershipProgram, Diagnostic]:
    lowered(source).and_then(own.own)
