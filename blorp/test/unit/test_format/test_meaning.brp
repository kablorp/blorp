import:
    bool: and
    int: Int methods
    list: List methods
    option: Option methods
    string: String methods
    test: TestSuite
    ../../../src/format/format: format_source
    ../../../src/format/printer: SourceView, written
    ../../../src/format/trivia:
        Trivia(TrailingComment, OwnLineComment, BlankLine, DocumentationBlock),
        source_trivia,
        trivia_start,
    ../../../src/syntax/source: module_source, root_module_id
    ../../../src/syntax/syntax:
        Token,
        Symbol(LeftParen, RightParen, LeftBracket, RightBracket, LeftBrace, RightBrace),
        TokenKind(
            IdentifierToken,
            KeywordToken,
            SymbolToken,
            IntegerLiteral,
            FloatLiteral,
            QuotedString,
            PipeString,
            StringStart,
            CharLiteral,
        ),
    ./repository_sources: ParsedSource, SourceFile, parsed_source, repository_sources
    ./syntax_nodes:
        declaration_order,
        first_declaration_start,
        layout_brackets,
        module_nodes,
        node_labels,
        string_less,


-- How many changed files a failing run names.
private REPORTED_FAILURES: Int = 20


-- The first label where two trees differ, for a failing file's report.
private pure func first_difference(left: List[String], right: List[String]) -> String:
    var position = 0
    var found: Option[String] = None
    while and(
        found.is_none(),
        (
            position
            < left
                .length()
                .max(right.length())
        ),
    ):
        if left.get(position) != right.get(position):
            found = Some(
                "node ${position.to_string()}: ${left.get(position).get_or("<none>")} became ${right.get(position).get_or("<none>")}",
            )
        position = position + 1
    found.get_or("same labels")


-- A name, keyword or literal: the tokens formatting never adds, removes or
-- reorders outside the import block. Punctuation it may: commas,
-- parentheses at whole values, and the side of a line an operator is on.
private pure func significant(token: Token) -> Bool:
    match token.kind:
        IdentifierToken(_) | KeywordToken(_) | IntegerLiteral(_) | FloatLiteral(_): True
        QuotedString(_) | PipeString(_) | StringStart(_) | CharLiteral: True
        _: False


-- How a token changes the bracket depth.
private pure func depth_change(token: Token) -> Int:
    match token.kind:
        SymbolToken(LeftParen) | SymbolToken(LeftBracket) | SymbolToken(LeftBrace): 1
        SymbolToken(RightParen) | SymbolToken(RightBracket) | SymbolToken(RightBrace): -1
        _: 0


private pure func sorted_labels(labels: List[String]) -> List[String]:
    var sorted: List[String] = []
    for label in labels:
        var position = sorted.length()
        while and(
            position > 0,
            string_less(
                label,
                sorted
                    .get(position - 1)
                    .get_or(label),
            ),
        ):
            position = position - 1
        sorted = sorted
            .take(position)
            .append(label)
            .concat(sorted.drop(position))
    sorted


-- Each comment and documentation block of a source: whether it trails code
-- or has its own line, its text, how many significant tokens precede it and
-- how deep in brackets it is, so a comment moved past a name, or out of the
-- brackets it was in, shows. Layout pairs do not count towards the depth. The
-- import block's comments move with their rows when the rows sort, so they
-- are compared without counts, in sorted order, ahead of the rest.
private pure func comment_labels(
    parsed: ParsedSource,
    text: String,
    layout: List[Int],
) -> List[String]:
    match source_trivia(module_source(root_module_id()), text, parsed.tokens):
        Err(error):
            ["the trivia does not scan: ${error.message}"]
        Ok(items):
            view: SourceView = { text = text, tokens = parsed.tokens, trivia = items }
            imports_end = parsed.contents.first_declaration_start()
            var in_imports: List[String] = []
            var after_imports: List[String] = []
            var preceding = 0
            var depth = 0
            var next_layout = 0
            var next_token = 0
            for item in items:
                start = item.trivia_start()
                var counting: Bool = True
                while counting:
                    counting = False
                    match parsed.tokens.get(next_token):
                        Some(token):
                            if token.span.start < start:
                                if token.significant():
                                    preceding = preceding + 1
                                while and(
                                    next_layout < layout.length(),
                                    (
                                        layout
                                            .get(next_layout)
                                            .get_or(0)
                                        < token.span.start
                                    ),
                                ):
                                    next_layout = next_layout + 1
                                if layout.get(next_layout) != Some(token.span.start):
                                    depth = depth + token.depth_change()
                                next_token = next_token + 1
                                counting = True
                        None:
                            void
                label: Option[String] = match item:
                    TrailingComment(span): Some("trailing ${view.written(span)}")
                    OwnLineComment(span, _): Some("own line ${view.written(span)}")
                    DocumentationBlock(span): Some("documentation ${view.written(span)}")
                    BlankLine(_): None
                match label:
                    Some(written_label):
                        if start < imports_end:
                            in_imports = in_imports.append(written_label)
                        else:
                            after_imports = after_imports.append(
                                "${written_label} after ${preceding.to_string()} at depth ${depth.to_string()}",
                            )
                    None:
                        void
            sorted_labels(in_imports).concat(after_imports)


-- Why formatting `file` changed or lost its program, or gave a layout that
-- formatting changes again; None when neither happened.
private pure func meaning_change(file: SourceFile) -> Option[String]:
    match parsed_source(file.text):
        Err(_):
            None
        Ok(original):
            match format_source(file.text):
                Err(error):
                    Some("${file.path}: ${error.message}")
                Ok(formatted):
                    match parsed_source(formatted):
                        Err(error):
                            Some(
                                "${file.path}: the formatted file does not parse: ${error.message}",
                            )
                        Ok(reformatted):
                            original_nodes = original.contents.module_nodes()
                            reformatted_nodes = reformatted.contents.module_nodes()
                            before = original_nodes
                                .node_labels()
                                .concat(original.contents.declaration_order())
                                .concat(
                                    original.comment_labels(
                                        file.text,
                                        original_nodes.layout_brackets(),
                                    ),
                                )
                            after = reformatted_nodes
                                .node_labels()
                                .concat(reformatted.contents.declaration_order())
                                .concat(
                                    reformatted.comment_labels(
                                        formatted,
                                        reformatted_nodes.layout_brackets(),
                                    ),
                                )
                            if before == after:
                                match format_source(formatted):
                                    Ok(again):
                                        if again == formatted:
                                            None
                                        else:
                                            Some(
                                                "${file.path}: formatting the formatted file changes it",
                                            )
                                    Err(error):
                                        Some(
                                            "${file.path}: formatting the formatted file fails: ${error.message}",
                                        )
                            else:
                                Some("${file.path}: ${first_difference(before, after)}")


-- Formatting keeps every program: for each repository source that parses, the
-- formatted text parses to the same tree, compared without spans or the
-- parentheses it may remove and add, with imports sorted; its declarations
-- stay in written order across kinds; every comment keeps its text, its kind
-- and its place among the significant tokens; and formatting it again
-- changes nothing. A source that does not parse is
-- counted and skipped; the formatter rejects it with the parser's own
-- diagnostic.
func test_formatting_keeps_every_repository_program_and_is_stable() -> Bool:
    match repository_sources():
        Err(error):
            print_error(error)
            False
        Ok(files):
            var compared = 0
            var skipped = 0
            var failures: List[String] = []
            for file in files:
                match parsed_source(file.text):
                    Err(_):
                        skipped = skipped + 1
                    Ok(_):
                        compared = compared + 1
                        match meaning_change(file):
                            Some(failure): failures = failures.append(failure)
                            None: void
            print(
                "  ${compared.to_string()} sources compared, ${skipped.to_string()} that do not parse skipped, ${failures.length().to_string()} changed",
            )
            for failure in failures.take(REPORTED_FAILURES):
                print_error(failure)
            and(failures.is_empty(), compared > 0)


tests: TestSuite = {
    description = "Blorp formatter meaning",
    tests = [
        (
            "formatting keeps every repository program and is stable",
            test_formatting_keeps_every_repository_program_and_is_stable,
        ),
    ],
}
