import:
    bool: and, not
    fs: read_text
    int: Int methods
    io: print_error, to_string
    list: List methods
    option: Option methods
    string: String methods
    test: TestSuite
    ../../../src/format/format: format_source
    ../../../src/format/printer: split_lines
    ../../../src/format/trivia: LINE_FEED_BYTE
    ../../../src/syntax/syntax:
        ParsedBody(ParsedBuiltinBody, ParsedValueBody, ParsedMatchBody),
        ParsedFunctionGroup(FreeFunction, ImplementationGroup),
        ParsedStatement(
            BindingStatement,
            TupleBinding,
            PropagatingBinding,
            ExpressionStatement,
            WhileLoop,
            ForLoop,
            Break,
            Continue,
        ),
    ./repository_sources: parsed_source


-- Long enough to push any line past the width.
private LENGTHENING: String = "_lengthened_well_past_the_line_width_so_that_the_statement_holding_it_must_reflow"


-- One chosen edit: in `path`, formatted, the first occurrence of `name` after
-- `anchor` is an argument of a top-level statement of a free function.
private record LocalityCase {
    path: String,
    anchor: String,
    name: String,
}


private pure func find_from(text: String, needle: String, from_offset: Int) -> Option[Int]:
    var position = from_offset
    var found: Option[Int] = None
    while and(found.is_none(), position + needle.length() <= text.length()):
        if text.slice(position, position + needle.length()) == Some(needle):
            found = Some(position)
        position = position + 1
    found


private pure func statement_bounds(statement: ParsedStatement) -> (Int, Int):
    match statement:
        BindingStatement(binding): (binding.name.span.start, binding.initializer.span.end)
        TupleBinding(_, value, span): (span.start, value.span.end)
        PropagatingBinding(propagation): (propagation.span.start, propagation.span.end)
        ExpressionStatement(value): (value.span.start, value.span.end)
        WhileLoop(loop): (loop.span.start, loop.span.end)
        ForLoop(loop): (loop.span.start, loop.span.end)
        Break(span): (span.start, span.end)
        Continue(span): (span.start, span.end)


-- The source range of the top-level statement or final value of a free
-- function that holds `offset`.
private pure func containing_statement(text: String, offset: Int) -> Option[(Int, Int)]:
    match parsed_source(text):
        Err(_):
            None
        Ok(parsed):
            var found: Option[(Int, Int)] = None
            for group in parsed.contents.functions:
                match group:
                    FreeFunction(function):
                        var ranges: List[(Int, Int)] = function.statements.map(statement_bounds)
                        final: (Int, Int) = match function.body:
                            ParsedValueBody(value): (value.span.start, value.span.end)
                            ParsedMatchBody(form): (form.span.start, form.span.end)
                            ParsedBuiltinBody(_, label): (label.start, label.end)
                        ranges = ranges.append(final)
                        for (start, end) in ranges:
                            if and(start <= offset, offset < end):
                                found = Some((start, end))
                    ImplementationGroup(_, _):
                        void
            found


private pure func line_of(text: String, offset: Int) -> Int:
    var line = 0
    var position = 0
    while position < offset:
        if text.byte_at(position) == Some(LINE_FEED_BYTE):
            line = line + 1
        position = position + 1
    line


-- Lengthening one argument changes only the lines of the statement holding
-- it: every line before the statement and after it is the same, so an edit
-- reflows the constructs that contain it and nothing beside them.
private func reflows_only_its_statement(case: LocalityCase) -> Bool:
    match read_text(case.path):
        Err(error):
            print_error(error.to_string())
            False
        Ok(original):
            match original.format_source():
                Err(error):
                    print_error("${case.path}: ${error.message}")
                    False
                Ok(formatted):
                    target: Option[Int] = match formatted.find_from(case.anchor, 0):
                        Some(anchor_at): formatted.find_from(case.name, anchor_at)
                        None: None
                    statement: Option[(Int, Int)] = match target:
                        Some(offset): formatted.containing_statement(offset)
                        None: None
                    match (target, statement):
                        (Some(offset), Some((start, end))):
                            name_end = offset + case.name.length()
                            edited = "${formatted.slice(0, name_end).get_or("")}${LENGTHENING}${formatted.slice(name_end, formatted.length()).get_or("")}"
                            match edited.format_source():
                                Err(error):
                                    print_error("${case.path}: ${error.message}")
                                    False
                                Ok(reflowed):
                                    before = formatted.split_lines()
                                    after = reflowed.split_lines()
                                    first_line = formatted.line_of(start)
                                    last_line = formatted.line_of(end)
                                    following = before.length() - last_line - 1
                                    kept_before = before.take(first_line) == after.take(first_line)
                                    kept_after = (
                                        before.drop(before.length() - following)
                                        == after.drop(after.length() - following)
                                    )
                                    changed = before != after
                                    if and(changed, and(kept_before, kept_after)):
                                        True
                                    else:
                                        print_error(
                                            "${case.path}: lengthening ${case.name} changed lines outside ${(first_line + 1).to_string()}-${(last_line + 1).to_string()}, or none",
                                        )
                                        False
                        _:
                            print_error(
                                "${case.path}: ${case.name} after ${case.anchor} is not in a free function's statement",
                            )
                            False


func test_lengthening_an_argument_in_the_driver_reflows_only_its_statement() -> Bool:
    reflows_only_its_statement({
        path = "blorp/test/e2e/self_hosted.brp",
        anchor = "func report_deferred(",
        name = "deferral_line(directory",
    })


func test_lengthening_an_argument_in_main_reflows_only_its_statement() -> Bool:
    reflows_only_its_statement({
        path = "blorp/src/main.brp",
        anchor = "func located_texts(",
        name = "diagnostic.span",
    })


func test_lengthening_an_argument_in_the_parser_reflows_only_its_statement() -> Bool:
    reflows_only_its_statement({
        path = "blorp/src/syntax/parse.brp",
        anchor = "func consume_lambda(start",
        name = "consume_lambda_parameter",
    })


tests: TestSuite = {
    description = "Blorp formatter locality",
    tests = [
        (
            "lengthening an argument in the driver reflows only its statement",
            test_lengthening_an_argument_in_the_driver_reflows_only_its_statement,
        ),
        (
            "lengthening an argument in main reflows only its statement",
            test_lengthening_an_argument_in_main_reflows_only_its_statement,
        ),
        (
            "lengthening an argument in the parser reflows only its statement",
            test_lengthening_an_argument_in_the_parser_reflows_only_its_statement,
        ),
    ],
}
