union ReadError:
    NotFound
    Failed(Int)


DEFAULT_ERROR: ReadError = ReadError.NotFound


pure func describe(result: Result[Int, ReadError]) -> String:
    match result:
        Err(ReadError.NotFound) | Err(ReadError.Failed(0)):
            "missing"
        Err(ReadError.Failed(code)):
            ReadError.Failed(code)
                .to_string()
                .add("!")
        Ok(_):
            "fine"


func main() -> Int:
    missing = ReadError.NotFound
    shown = "${ReadError.Failed(4)}"
    describe(Err(missing)).length()
