record Pair { first: Int, second: Int }


func add(left: Int, right: Int) -> Int:
    total = left + right * 2
    pair: Pair = { first = total, second = -left }
    items = [total, pair.first]
    grouped = (total, left)
    shown = { pair | first = 1 }
    keys = { "a" => 1, "b" => 2 }
    if total >= right:
        total - 1
    else:
        items.get(0) % 3
