record Box { value: Int }


func pick(flag: Bool, number: Int) -> Result[Int, String]:
    bound = number + 1
    called = describe(number)
    listed = [number, number * 2]
    boxed: Box = { value = number }
    mapped = { "key" => number }
    checked ?= validate(number)
    if flag:
        void
    while flag:
        break
    Ok(bound)
