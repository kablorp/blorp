record Configuration {
    name: String,
    description: String,
    maximum_count: Int,
    minimum_count: Int,
    flag: Bool,
}


union Shape:
    Circle(Float)
    Rectangle(Float, Float)
    Nothing


trait Describable:
    pure func describe(value: Self) -> String


implements Describable for Shape:
    pure func describe(value: Self) -> String:
        "shape"

    pure func other(value: Self) -> Int:
        1


private fixed record Point { x: Int, y: Int }


opaque type Handle[T] = Int


trait Bundle: Describable + Showable


implements Describable for Box[T: Describable]


private @tail_recursive
pure func loop(count: Int) -> Int:
    if count == 0:
        0
    else:
        loop(count - 1)
