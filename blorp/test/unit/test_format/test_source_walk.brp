---
Tests for the lexical containment rule `--exclude` uses: an excluded path
removes a file, or a directory and everything below it on component
boundaries.
---
import:
    bool: and, not
    test: TestSuite
    ../../../src/format/source_walk: is_at_or_below


pure func test_a_path_is_below_its_directory_on_component_boundaries() -> Bool:
    and(
        is_at_or_below("a/b/c.brp", "a/b"),
        and(is_at_or_below("a/b", "a/b"), is_at_or_below("a/b/c/d.brp", "a")),
    )


pure func test_a_longer_name_sharing_the_prefix_is_not_below() -> Bool:
    and(
        is_at_or_below("a/bc.brp", "a/b").not(),
        and(is_at_or_below("a/b.brp", "a/b").not(), is_at_or_below("ab", "a").not()),
    )


pure func test_the_current_directory_contains_every_relative_path_below_it() -> Bool:
    and(
        is_at_or_below("src/a.brp", "."),
        and(is_at_or_below("a.brp", "."), is_at_or_below(".", ".")),
    )


pure func test_the_current_directory_does_not_contain_a_parent_or_absolute_path() -> Bool:
    and(
        is_at_or_below("../x", ".").not(),
        and(
            is_at_or_below("..", ".").not(),
            and(is_at_or_below("/etc/x", ".").not(), is_at_or_below("..x", ".")),
        ),
    )


pure func test_a_parent_root_contains_paths_below_the_parent() -> Bool:
    and(is_at_or_below("../x/y.brp", ".."), is_at_or_below("x", "..").not())


pure func test_the_filesystem_root_contains_every_absolute_path() -> Bool:
    and(is_at_or_below("/a/b.brp", "/"), is_at_or_below("a/b.brp", "/").not())


TESTS: TestSuite = {
    description = "Source walk exclusion containment",
    tests = [
        (
            "a path is below its directory on component boundaries",
            test_a_path_is_below_its_directory_on_component_boundaries,
        ),
        (
            "a longer name sharing the prefix is not below",
            test_a_longer_name_sharing_the_prefix_is_not_below,
        ),
        (
            "the current directory contains every relative path below it",
            test_the_current_directory_contains_every_relative_path_below_it,
        ),
        (
            "the current directory does not contain a parent or absolute path",
            test_the_current_directory_does_not_contain_a_parent_or_absolute_path,
        ),
        (
            "a parent root contains paths below the parent",
            test_a_parent_root_contains_paths_below_the_parent,
        ),
        (
            "the filesystem root contains every absolute path",
            test_the_filesystem_root_contains_every_absolute_path,
        ),
    ],
}
