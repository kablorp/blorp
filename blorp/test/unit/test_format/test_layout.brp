-- Every expected output is already in the canonical layout.
func test_every_expected_layout_formats_to_itself() -> Bool:
    var stable: Bool = True
    for name in LAYOUT_PAIRS:
        stable = and(formats_to_itself(name), stable)
    stable


-- Blank lines ending a file go too. This case is inline, as a fixture file
-- ending in blank lines would fail `git diff --check`.
func test_blank_lines_at_the_end_of_a_file_go() -> Bool:
    match format_source("func main() -> Int:\n    0\n\n\n"):
        Ok(formatted): formatted == "func main() -> Int:\n    0\n"
        Err(_): False


private REFUSED_HELP: String = "move this comment above the line; the formatter keeps comments only between items it can break, and left the file unchanged"


-- Patterns, types and header lines never break, so a comment inside one has
-- no line of its own: the formatter refuses the file, at the comment, rather
-- than move it.
private pure func refuses_comment(source: String, start: Int, end: Int, construct: String) -> Bool:
    match format_source(source):
        Ok(_):
            False
        Err(error):
            and(
                and(error.span.start == start, error.span.end == end),
                and(
                    error.message == "the formatter cannot keep a comment inside ${construct}",
                    error.help == REFUSED_HELP,
                ),
            )


func test_a_comment_inside_a_type_is_refused() -> Bool:
    refuses_comment(
        "func f(a: Dict[String, -- key type\n        Int]) -> Int:\n    0\n",
        23,
        34,
        "a type",
    )


func test_a_comment_inside_a_pattern_is_refused() -> Bool:
    refuses_comment(
        "func f(a: Int, b: Int) -> Int:\n    match (a, b):\n        (first, -- part\n            second): 1\n",
        65,
        72,
        "a pattern",
    )


func test_a_comment_inside_a_header_line_is_refused() -> Bool:
    refuses_comment(
        "record Pair[A, -- first\n    B] { first: A, second: B }\n",
        15,
        23,
        "a declaration's header line",
    )


func test_unparsable_input_returns_the_parser_diagnostic() -> Bool:
    match read_text("${FIXTURES}unparsable.input.brp"):
        Ok(input):
            match format_source(input):
                Ok(_):
                    False
                Err(error):
                    and(
                        and(
                            error.span.start == 11,
                            error.message == "expected a parameter name or ')'",
                        ),
                        (
                            error.help
                            == "use an ASCII identifier starting with a letter or underscore; keywords and lone '_' are reserved"
                        ),
                    )
        Err(error):
            print_error(error.to_string())
            False


