import:
    bool: and
    fs: read_text
    int: Int methods
    io: print_error, to_string
    list: List methods
    string: String methods
    test: TestSuite
    ../../../src/format/format: first_changed_line, format_source


private FIXTURES: String = "blorp/test/unit/test_format/fixtures/"


-- Formatting `name`'s input gives exactly its expected output.
private func formats_to_expected(name: String) -> Bool:
    match (read_text("${FIXTURES}${name}.input.brp"), read_text("${FIXTURES}${name}.expected.brp")):
        (Ok(input), Ok(expected)):
            match format_source(input):
                Ok(formatted):
                    if formatted == expected:
                        True
                    else:
                        print_error(
                            "${name}: first difference at line ${first_changed_line(expected, formatted).to_string()}; got:\n${formatted}",
                        )
                        False
                Err(error):
                    print_error("${name}: ${error.message}")
                    False
        (Err(error), _):
            print_error(error.to_string())
            False
        (_, Err(error)):
            print_error(error.to_string())
            False


-- Formatting an expected output leaves it unchanged.
private func formats_to_itself(name: String) -> Bool:
    match read_text("${FIXTURES}${name}.expected.brp"):
        Ok(expected):
            match format_source(expected):
                Ok(formatted):
                    if formatted == expected:
                        True
                    else:
                        print_error(
                            "${name}: reformatting differs at line ${first_changed_line(expected, formatted).to_string()}; got:\n${formatted}",
                        )
                        False
                Err(error):
                    print_error("${name}: ${error.message}")
                    False
        Err(error):
            print_error(error.to_string())
            False


