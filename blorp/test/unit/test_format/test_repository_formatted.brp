import:
    bool: and
    int: Int methods
    io: print, print_error
    list: List methods
    option: Option methods
    string: String methods
    test: TestSuite
    ../../../src/format/format: first_changed_line, format_source
    ../../../src/format/printer: split_lines
    ./repository_sources: SourceFile, parsed_source, repository_sources


-- How many unformatted files a failing run names.
private REPORTED_FAILURES: Int = 20

private FIXTURES: String = "blorp/test/unit/test_format/fixtures/"

private LAYOUT_INPUT_SUFFIX: String = ".input.brp"


-- The sources that are unformatted on purpose. Each layout fixture's input
-- is the unformatted text its expected output is formatted from. Sources
-- that do not parse are not excluded here: formatting leaves them as they
-- are, and this test skips them.
private pure func excluded_from_formatting(path: String) -> Bool:
    length = path.length()
    is_layout_input = (
        path.slice(length - LAYOUT_INPUT_SUFFIX.length(), length)
        == Some(LAYOUT_INPUT_SUFFIX)
    )
    and(path.starts_with(FIXTURES), is_layout_input)


-- The first line where `file` is not in canonical layout, for the report; None
-- when it is, when it does not parse, or when it is excluded.
private pure func unformatted_line(file: SourceFile) -> Option[String]:
    if file.path.excluded_from_formatting():
        None
    else:
        match parsed_source(file.text):
            Err(_):
                None
            Ok(_):
                match format_source(file.text):
                    Err(error):
                        Some("${file.path}: ${error.message}")
                    Ok(formatted):
                        if formatted == file.text:
                            None
                        else:
                            line = first_changed_line(file.text, formatted)
                            Some(
                                "${file.path}:${line.to_string()}: ${split_lines(file.text).get(line - 1).get_or("")}\nrun blorp/build/blorp format ${file.path}",
                            )


-- Every repository source that parses is already in the layout `blorp format`
-- gives it. This walks the sources on its own, apart from the meaning test, so
-- a layout failure and a meaning failure are reported separately.
func test_every_repository_source_is_formatted() -> Bool:
    match repository_sources():
        Err(error):
            print_error(error)
            False
        Ok(files):
            var failures: List[String] = []
            for file in files:
                match file.unformatted_line():
                    Some(failure): failures = failures.append(failure)
                    None: void
            for failure in failures.take(REPORTED_FAILURES):
                print_error(failure)
            if failures.is_empty():
                True
            else:
                print(
                    "  ${failures.length().to_string()} sources are not formatted; the first ${failures.take(REPORTED_FAILURES).length().to_string()} are shown above",
                )
                False


tests: TestSuite = {
    description = "Blorp repository formatting",
    tests = [
        (
            "every repository source that parses is formatted",
            test_every_repository_source_is_formatted,
        ),
    ],
}
