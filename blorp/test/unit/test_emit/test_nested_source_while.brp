import:
	../../../src/emit/emit: emit
	../../../src/lower/lower as Lower
	../../../src/specialize/specialize as Concrete
	../../../src/utils/syntax: entry_function
	../../../src/own/own: own
	../../../src/verify/verify: verify
	../source_while_inputs as Input
	../nested_while_inputs as Nested
	test: TestSuite


private pure func first_loop(steps: List[Lower.LoweredStep]) -> Option[Lower.LoweredLoop]:
	var found: Option[Lower.LoweredLoop] = None
	for step in steps:
		match step:
			Lower.Loop(loop):
				found = Some(loop)
				break
			_: void
	found


private pure func has_loop_labels(code: String, root: String) -> Bool:
	(code.count(root + "_header:{") == 1 and code.count(root + "_break:;") == 1
		and code.count("goto " + root + "_header;") == 2
		and code.count("goto " + root + "_break;") == 2)


private pure func two_common_loops_emit() -> Option[Bool]:
	lowered ?= Input.lowered(Nested.MANY_ITERATIONS).to_option()
	contents = Lower.lowered_functions(lowered)
	function ?= contents.functions.get(Concrete.function_number(entry_function(contents.entrypoint)))
	outer ?= first_loop(function.steps)
	body = match outer.body.tail:
		Lower.MatchLoop(branch): branch.arms.get(0)
		Lower.ExitLoop(_): None
	outer_body ?= body
	inner ?= first_loop(outer_body.body.steps)
	code ?= own(lowered).and_then(verify).and_then(emit).to_option()
	outer_root = "blorp_loop_" + Lower.value_number(outer.result.id).to_string()
	inner_root = "blorp_loop_" + Lower.value_number(inner.result.id).to_string()
	outer_header ?= code.index_of(outer_root + "_header:{")
	inner_header ?= code.index_of(inner_root + "_header:{")
	inner_break ?= code.index_of(inner_root + "_break:;")
	outer_break ?= code.index_of(outer_root + "_break:;")
	outer_resume ?= code.slice(inner_break, outer_break)
	Some(Lower.value_number(outer.result.id) != Lower.value_number(inner.result.id)
		and has_loop_labels(code, outer_root) and has_loop_labels(code, inner_root)
		and outer_header < inner_header and inner_header < inner_break and inner_break < outer_break
		and outer_resume.contains("goto " + outer_root + "_header;"))


pure func test_nested_source_while_emits_two_common_runtime_loops() -> Bool:
	two_common_loops_emit().get_or(False)


tests: TestSuite = {
	description = "Blorp 2 nested scalar while emission",
	tests = [("nested source while emits two common runtime loops", test_nested_source_while_emits_two_common_runtime_loops)]
}
