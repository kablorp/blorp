import:
	../../../src/runtime/string_concat: string_concat_runtime, string_append_int_runtime
	../string_append_int_inputs: APPEND_DECLARATION, DIRECT_APPEND, NAMED_APPEND, STORED_APPEND, MIXED_LOOP
	../string_concat_inputs: CONCAT_SOURCE
	./test_builtin_functions: emitted_sources
	test: TestSuite


pure func test_consuming_append_selects_shared_storage_without_managed_digits() -> Bool:
	source: String =
		|func main() -> Int:
		|    unused = append_number("value=", -7)
		|    0
		|
	match emitted_sources([{ source = APPEND_DECLARATION + source, targets = [] }]):
		Err(_): False
		Ok(code):
			(code.split(string_concat_runtime()).length() == 2
				and code.split(string_append_int_runtime()).length() == 2
				and code.contains("=blorp_string_append_int_take_left(blorp_vl_0,blorp_vl_1);")
				and not code.contains("=blorp_int_to_string(")
				and not code.contains("blorp_string_release(blorp_owner_0);")
				and code.split("blorp_string_release(blorp_owner_1);").length() == 2)


private pure func borrowed_append_helper(source: String) -> Bool:
	match emitted_sources([{ source = APPEND_DECLARATION + source, targets = [] }]):
		Err(_): False
		Ok(code):
			(code.contains("=blorp_string_append_int(blorp_vl_0,blorp_vl_1);")
				and not code.contains("=blorp_int_to_string("))


pure func test_unreachable_append_selects_no_fragment() -> Bool:
	match emitted_sources([{ source = APPEND_DECLARATION + "func main() -> Int:\n    0\n", targets = [] }]):
		Err(_): False
		Ok(code): not code.contains("blorp_string_append_int")


pure func test_concat_only_omits_decimal_fragment() -> Bool:
	match emitted_sources([{ source = CONCAT_SOURCE, targets = [] }]):
		Err(_): False
		Ok(code):
			(code.split(string_concat_runtime()).length() == 2
				and not code.contains(string_append_int_runtime()))


pure func test_mixed_loop_selects_storage_and_decimal_fragments_once() -> Bool:
	match emitted_sources([{ source = APPEND_DECLARATION + MIXED_LOOP, targets = [] }]):
		Err(_): False
		Ok(code):
			(code.split(string_concat_runtime()).length() == 2
				and code.split(string_append_int_runtime()).length() == 2)


tests: TestSuite = {
	description = "Blorp 2 integer append emission",
	tests = [
		("consuming append selects one shared storage fragment without digits String", test_consuming_append_selects_shared_storage_without_managed_digits),
		("borrowed parameter selects borrowed decimal helper", pure func(): borrowed_append_helper(DIRECT_APPEND)),
		("named callable emits reachable borrowed wrapper", pure func(): borrowed_append_helper(NAMED_APPEND)),
		("stored callable emits reachable borrowed wrapper", pure func(): borrowed_append_helper(STORED_APPEND)),
		("unreachable declaration emits no integer append fragment", test_unreachable_append_selects_no_fragment),
		("concat-only source omits decimal append fragment", test_concat_only_omits_decimal_fragment),
		("mixed loop selects shared storage and decimal fragment once", test_mixed_loop_selects_storage_and_decimal_fragments_once),
	]
}
