import:
    bool: Bool methods, not
    test: TestSuite
    ../../../src/emit/emit: emit
    ../../../src/own/own: own
    ../../../src/utils/syntax: Diagnostic
    ../../../src/verify/verify: verify
    ../current_directory_inputs: current_directory_seed
    ../module_input: test_base, TestFoundation
    ../text_search: has_text, occurrences, replace_first
    ./test_builtin_functions: emitted_sources


-- This fixture instantiates only Result[String, String], whose first value is id 0.
private OK_PAYLOAD: String = "((struct blorp_u_0){.tag=blorp_v_0_0,.payload.blorp_up_0={.blorp_uf_0=blorp_runtime_0_value}})"


private ERR_PAYLOAD: String = "((struct blorp_u_0){.tag=blorp_v_0_1,.payload.blorp_up_1={.blorp_uf_0=blorp_runtime_0_error}})"


private REVERSED_OK_PAYLOAD: String = "((struct blorp_u_0){.tag=blorp_v_0_1,.payload.blorp_up_1={.blorp_uf_0=blorp_runtime_0_value}})"


private REVERSED_ERR_PAYLOAD: String = "((struct blorp_u_0){.tag=blorp_v_0_0,.payload.blorp_up_0={.blorp_uf_0=blorp_runtime_0_error}})"


private pure func emitted_directory(foundation: TestFoundation) -> Result[String, Diagnostic]:
    seed ?= current_directory_seed(foundation)
    owned ?= own(seed.lowered)
    verified ?= verify(owned)
    emit(verified)


pure func test_current_directory_emits_one_call_and_transfers_its_scratch() -> Bool:
    match emitted_directory(test_base()):
        Err(_): False
        Ok(code):
            (occurrences(code, "=blorp_get_current_directory(") == 1)
                .and(has_text(code, "blorp_runtime_0_ok?" + OK_PAYLOAD + ":" + ERR_PAYLOAD))
                .and(has_text(code, "blorp_union_drop_0("))
                .and(not(has_text(code, "blorp_string_retain(blorp_runtime_")))
                .and(not(has_text(code, "blorp_string_release(blorp_runtime_")))


pure func test_reversed_result_emits_the_actual_designated_tags() -> Bool:
    foundation = { test_base() |
        types = replace_first(
            test_base().types,
            "    Ok(Value)\n    Err(Error)",
            "    Err(Error)\n    Ok(Value)",
        ),
    }
    match emitted_directory(foundation):
        Err(_): False
        Ok(code):
            has_text(code, "blorp_runtime_0_ok?" + REVERSED_OK_PAYLOAD + ":" + REVERSED_ERR_PAYLOAD)


pure func test_ignored_native_result_still_selects_string_runtime() -> Bool:
    source: String =
        |func query() -> Result[String, String]:
        |    builtin("system.get_current_directory")
        |func main() -> Int:
        |    unused = query()
        |    0
        |
    match emitted_sources([{ source = source, targets = [] }]):
        Err(_): False
        Ok(code):
            has_text(code, "struct blorp_string {")
                .and(has_text(code, "=blorp_get_current_directory("))
                .and(has_text(code, "blorp_union_drop_0("))


pure func test_unused_declaration_does_not_select_current_directory_helper() -> Bool:
    source: String =
        |func query() -> Result[String, String]:
        |    builtin("system.get_current_directory")
        |func main() -> Int:
        |    0
        |
    match emitted_sources([{ source = source, targets = [] }]):
        Err(_): False
        Ok(code): not(has_text(code, "blorp_get_current_directory"))


tests: TestSuite = {
    description = "Blorp current-directory C emission",
    tests = [
        (
            "normal tags transfer one fresh scratch",
            test_current_directory_emits_one_call_and_transfers_its_scratch,
        ),
        (
            "reversed tags retain designated roles",
            test_reversed_result_emits_the_actual_designated_tags,
        ),
        (
            "ignored native result selects String ABI",
            test_ignored_native_result_still_selects_string_runtime,
        ),
        (
            "unused declaration selects no native helper",
            test_unused_declaration_does_not_select_current_directory_helper,
        ),
    ],
}
