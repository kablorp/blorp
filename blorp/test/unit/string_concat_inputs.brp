-- The same small real call supplies predecessors for each phase's own checks.
CONCAT_SOURCE: String =
	|pure func concatenate(left: String, right: String) -> String:
	|    builtin("string.add")
	|func main() -> Int:
	|    unused = concatenate("left", "right")
	|    0
	|


APPEND_INT_CALLER: String =
	|import:
	|    ./strings: String methods
	|func main() -> Int:
	|    unused = "left".append_int(17)
	|    0
	|


APPEND_INT_METHOD: String =
	|pure func digits(value: Int) -> String:
	|    builtin("int.to_string")
	|pure func concatenate(left: String, right: String) -> String:
	|    builtin("string.add")
	|pure func append_int(self: String, value: Int) -> String:
	|    concatenate(self, digits(value))
	|
