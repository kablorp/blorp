-- The census's name for a stop reason: its variant name in kebab case. The
-- match is exhaustive, so a reason added without a label does not compile.
import:
	../../../src/compiler_new/stage_01_discovery/parse/stop_reason: StopReason
	../../../src/compiler_new/stage_01_discovery/parse/tree_module_declaration_scan: DeclinedKind(DeclinedFunction, DeclinedTrait, DeclinedImplementation, DeclinedGlobalInitializer)


pure func stop_reason_label(reason: StopReason) -> String:
	match reason:
		LeadingDotContinuation: "leading-dot-continuation"
		IndentedMethodChain: "indented-method-chain"
		IndentedContinuation: "indented-continuation"
		TokenAfterExpression: "token-after-expression"
		OperandOnNextLine: "operand-on-next-line"
		MemberNameOnNextLine: "member-name-on-next-line"
		UnexpectedTokenInBrackets: "unexpected-token-in-brackets"
		MissingDictArrow: "missing-dict-arrow"
		TrailingCommaAtEndOfSource: "trailing-comma-at-end-of-source"
		SoftKeywordFieldName: "soft-keyword-field-name"
		InterpolationHoleNotLexed: "interpolation-hole-not-lexed"
		InterpolationHoleTrailingTokens: "interpolation-hole-trailing-tokens"
		InterpolationHoleRejected: "interpolation-hole-rejected"
		SelectBlock: "select-block"
		WithBlock: "with-block"
		ConcurrentBlock: "concurrent-block"
		DebugBlock: "debug-block"
		BuiltinBody: "builtin-body"
		OpaqueConversion: "opaque-conversion"
		SoftKeywordName: "soft-keyword-name"
		StatementKeywordInExpression: "statement-keyword-in-expression"
		LoopExitInExpression: "loop-exit-in-expression"
		DeclarationKeywordInExpression: "declaration-keyword-in-expression"
		OperatorWithoutLeftOperand: "operator-without-left-operand"
		PunctuationInExpression: "punctuation-in-expression"
		DimensionNameInExpression: "dimension-name-in-expression"
		RejectedLiteral: "rejected-literal"
		DocStringInExpression: "doc-string-in-expression"
		UnexpectedIndent: "unexpected-indent"
		UnexpectedDedent: "unexpected-dedent"
		MalformedTokenPayload: "malformed-token-payload"
		ExpressionSyntaxError: "expression-syntax-error"
		LocalFunctionHeaderRejected: "local-function-header-rejected"
		LambdaInInterpolationHole: "lambda-in-interpolation-hole"
		MalformedLambdaHeader: "malformed-lambda-header"
		ConcurrentlyLoop: "concurrently-loop"
		ValueOnNextLine: "value-on-next-line"
		GlobalInitializerNotAtHeaderEnd: "global-initializer-not-at-header-end"
		TupleDestructuring: "tuple-destructuring"
		FieldAssignment: "field-assignment"
		NonPlaceAssignmentTarget: "non-place-assignment-target"
		AssignmentTargetRoutedElsewhere: "assignment-target-routed-elsewhere"
		LoopExitOutsideLoop: "loop-exit-outside-loop"
		QuestionBindingInLoop: "question-binding-in-loop"
		InvalidType: "invalid-type"
		InvalidPattern: "invalid-pattern"
		MalformedTypedBinding: "malformed-typed-binding"
		VarWithoutName: "var-without-name"
		VarWithoutInitializer: "var-without-initializer"
		HeaderWithoutColon: "header-without-colon"
		InvalidLoopBinding: "invalid-loop-binding"
		ForWithoutIn: "for-without-in"
		MalformedElse: "malformed-else"
		OperatorAfterBlock: "operator-after-block"
		SelectWithoutArms: "select-without-arms"
		SelectNotClosed: "select-not-closed"
		SelectArmMalformed: "select-arm-malformed"
		WithBindingMalformed: "with-binding-malformed"
		WithHeaderWithoutColon: "with-header-without-colon"
		WithErrorMapMalformed: "with-error-map-malformed"
		ConcurrentHeaderWithoutColon: "concurrent-header-without-colon"
		ConcurrentParametersMalformed: "concurrent-parameters-malformed"
		ConcurrentParameterUnknown: "concurrent-parameter-unknown"
		ConcurrentParameterRepeated: "concurrent-parameter-repeated"
		ConcurrentCountNotLiteral: "concurrent-count-not-literal"
		BlockWithoutIndent: "block-without-indent"
		BlockNotClosed: "block-not-closed"
		MatchWithoutBlock: "match-without-block"
		MatchNotClosed: "match-not-closed"
		CaseWithoutColon: "case-without-colon"
		NestedBlockInCaseLine: "nested-block-in-case-line"
		BodylessFunction: "bodyless-function"
		ReplayReported: "replay-reported"
		BodyReplayDisagrees: "body-replay-disagrees"
		OwnerReplayDisagrees: "owner-replay-disagrees"


pure func declined_kind_label(kind: DeclinedKind) -> String:
	match kind:
		DeclinedFunction: "function"
		DeclinedTrait: "trait"
		DeclinedImplementation: "implementation"
		DeclinedGlobalInitializer: "global-initializer"
