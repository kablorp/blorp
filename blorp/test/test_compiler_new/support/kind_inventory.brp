---
Upper bound on the walk, so a cycle in a chain ends it instead of looping.
---
INVENTORY_WALK_LIMIT: Int = 1000


---
Every node kind, in declaration order.
---
pure func all_node_kinds() -> List[NodeKind]:
	var kinds: List[NodeKind] = [IdentifierNode]
	var current: NodeKind = IdentifierNode
	var more: Bool = True

	while more and kinds.length() < INVENTORY_WALK_LIMIT:
		match next_node_kind(current):
			Some(following):
				kinds = kinds.append(following)
				current = following
			None:
				more = False

	kinds


---
Every token kind, in declaration order.
---
pure func all_token_kinds() -> List[TokenKind]:
	var kinds: List[TokenKind] = [FuncKeyword]
	var current: TokenKind = FuncKeyword
	var more: Bool = True

	while more and kinds.length() < INVENTORY_WALK_LIMIT:
		match next_token_kind(current):
			Some(following):
				kinds = kinds.append(following)
				current = following
			None:
				more = False

	kinds
