-- The should_pass corpus the discovery stage's parser answers to: which
-- directories it is read from, and which node and token kinds it produces.
--
-- Every file of every directory is read in place, so each fixture has one
-- copy. The directories are whole, with no manifest of included files: the
-- existing compiler's parser accepts every file of the typecheck and infer
-- directories (a file that fails there fails in typecheck, never in parsing),
-- and a manifest would be a second list to keep equal to the directory. A new
-- fixture dropped in one of them is therefore parsed by the stage too, and a
-- fixture that uses syntax the stage rejects fails this suite.
--
-- Subdirectories are not walked: a new subdirectory of a listed directory must
-- be added to `SHOULD_PASS_DIRECTORIES` by hand, and
-- `test_every_subdirectory_of_a_corpus_directory_is_listed` fails until it is.
import:
	../../../src/compiler_new/stage_01_discovery/tables/builder: DiscoveryBuilder
	../../../src/compiler_new/stage_01_discovery/tables/row_kinds: node_kind_name
	../../../src/compiler_new/stage_01_discovery/tables/token: token_kind_name
	./parser_fixtures: fixture_paths, fixture_text, parsed_fixture
	set: Set, combine, from_list, set


LEGACY_FIXTURES: String = "blorp/test/test_compiler/test_stage_03_parse/fixtures/parser/"

OWN_FIXTURES: String = "blorp/test/test_compiler_new/test_stage_01_discovery/test_parse/fixtures/"

TYPECHECK_FIXTURES: String = "blorp/test/test_compiler/test_stage_06_typecheck/fixtures/typecheck/"

INFER_FIXTURES: String = "blorp/test/test_compiler/test_stage_06_typecheck/infer_fixtures/infer/"

CODEGEN_AUDIT_FIXTURES: String = "blorp/test/test_compiler/test_pipeline/codegen_audit/"

---
The directories of `should_pass` programs, each read whole. `pkg/` under the
typecheck fixtures holds the module a fixture beside it imports; the
codegen audit's `helpers/` and `cross_module_struct_field/` hold the modules
its programs import. The audit's expected-C lines are comments in the programs
themselves, so there are no sidecar files.
---
SHOULD_PASS_DIRECTORIES: List[String] = [
	LEGACY_FIXTURES + "should_pass/",
	TYPECHECK_FIXTURES + "should_pass/",
	TYPECHECK_FIXTURES + "should_pass/pkg/",
	INFER_FIXTURES + "should_pass/",
	CODEGEN_AUDIT_FIXTURES + "should_pass/",
	CODEGEN_AUDIT_FIXTURES + "should_pass/cross_module_struct_field/",
	CODEGEN_AUDIT_FIXTURES + "should_pass/helpers/",
	OWN_FIXTURES + "should_pass/",
]


---
The kinds a corpus produced: the spellings (`node_kind_name`,
`token_kind_name`) of every node kind in a parsed module's node table, and of
every token the lexer produced for it, interpolation holes included.
---
record CorpusKinds {
	node_names: Set[String],
	token_names: Set[String]
}


pure func no_corpus_kinds() -> CorpusKinds:
	{
		node_names = set(),
		token_names = set()
	}


---
`kinds` and the kinds of the module in `text`, parsed alone.
---
pure func with_kinds_of(kinds: CorpusKinds, path: String, text: String) -> CorpusKinds:
	builder: DiscoveryBuilder = parsed_fixture(path, text)

	{
		node_names = kinds.node_names.combine(from_list(builder.nodes.map(
				pure func(row): row.kind.node_kind_name(),
			))),
		token_names = kinds.token_names.combine(from_list(builder.tokens.map(
				pure func(token): token.kind.token_kind_name(),
			)))
	}


---
How many files one directory of the corpus contributed.
---
record DirectoryRead {
	directory: String,
	file_count: Int
}


---
The kinds of every file of `SHOULD_PASS_DIRECTORIES`, parsed once, and what
each directory contributed; a directory that cannot be listed contributes zero
files (the fixture suite fails on it).
---
record CorpusFiles {
	kinds: CorpusKinds,
	directories: List[DirectoryRead]
}


pure func total_file_count(corpus: CorpusFiles) -> Int:
	var total: Int = 0

	for read in corpus.directories:
		total += read.file_count

	total


func read_corpus() -> CorpusFiles:
	var kinds: CorpusKinds = no_corpus_kinds()
	var directories: List[DirectoryRead] = []

	for directory in SHOULD_PASS_DIRECTORIES:
		paths: List[String] = fixture_paths(directory).get_or([])

		for path in paths:
			kinds = kinds.with_kinds_of(path, fixture_text(path))

		directories = directories.append({
			directory = directory,
			file_count = paths.length(),
		})

	{
		kinds = kinds,
		directories = directories
	}
