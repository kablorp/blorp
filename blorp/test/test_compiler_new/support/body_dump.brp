-- Renders parsed bodies as trees, one body per line, for body parser tests:
-- `name = (Kind payload child ...)`. A name payload renders as the name, a
-- literal payload as the quoted text, a codepoint as `'<n>'`, and a local
-- function as `def<n>`, as `node_payload_reference` classifies each kind.
import:
	../../../src/compiler_new/stage_01_discovery/tables/builder: DiscoveryBuilder
	../../../src/compiler_new/stage_01_discovery/tables/ids:
		NodeId,
		definition_id_index,
		name_id_index,
		node_id_index,
	../../../src/compiler_new/stage_01_discovery/tables/row_kinds:
		NodePayloadReference(
			CodepointPayload, DefinitionPayload, DiagnosticPayload, LiteralPayload, NamePayload,
			NoPayload,
		),
		node_kind_name,
		node_payload_reference,
	../../../src/compiler_new/stage_01_discovery/tables/rows: NodeRow
	declarations_dump: literal, quoted, spelling


pure func payload_text(builder: DiscoveryBuilder, row: NodeRow) -> String:
	match row.kind.node_payload_reference():
		NamePayload:
			" " + builder.spelling(row.payload)
		LiteralPayload:
			" " + quoted(builder.literal(row.payload))
		CodepointPayload:
			" '${row.payload}'"
		DefinitionPayload:
			" def${row.payload}"
		DiagnosticPayload:
			-- The linked diagnostic is checked by its own test; the dump stays a tree.
			""
		NoPayload:
			""


---
The tree rooted at `node`.
---
pure func node_tree(builder: DiscoveryBuilder, node: NodeId) -> String:
	match builder.nodes.get(node.node_id_index()):
		Some(row):
			var text: String = "(" + row.kind.node_kind_name() + builder.payload_text(row)
			var position: Int = 0

			while position < row.children.count:
				match builder.node_children.get(row.children.first + position):
					Some(child):
						text += " " + builder.node_tree(child)
					None:
						text += " ?"

				position += 1

			text + ")"
		None:
			"?"


---
Every body row as `definition-name = tree`, in row order.
---
pure func bodies_dump(builder: DiscoveryBuilder) -> List[String]:
	var lines: List[String] = []

	for body in builder.bodies:
		name: String = match builder.definitions.get(body.definition.definition_id_index()):
			Some(definition):
				builder.spelling(definition.name.name_id_index())
			None:
				"?"

		lines = lines.append(name + " = " + builder.node_tree(body.root))

	lines
