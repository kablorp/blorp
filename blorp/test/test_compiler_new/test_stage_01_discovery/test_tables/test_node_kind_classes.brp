-- The node kind classes each appender takes agree with `node_schema`: every kind
-- of a class has the payload, children and name span row its appender writes, and
-- every `NodeKind` is in a class, except the ones with appenders of their own
-- (the recovery kinds and `LocalFunctionNode`).
import:
	../../../../src/compiler_new/stage_01_discovery/tables/node_kind_classes:
		ALL_CODEPOINT_LEAF_KINDS,
		ALL_LITERAL_LEAF_KINDS,
		ALL_NAMED_PARENT_KINDS,
		ALL_NAMED_SPANNED_LEAF_KINDS,
		ALL_NAME_LEAF_KINDS,
		ALL_NAME_ONLY_PARENT_KINDS,
		ALL_PLAIN_LEAF_KINDS,
		ALL_PLAIN_PARENT_KINDS,
		ALL_SPANNED_LEAF_KINDS,
		node_kind_of_codepoint_leaf,
		node_kind_of_literal_leaf,
		node_kind_of_name_leaf,
		node_kind_of_name_only_parent,
		node_kind_of_named_parent,
		node_kind_of_named_spanned_leaf,
		node_kind_of_plain_leaf,
		node_kind_of_plain_parent,
		node_kind_of_spanned_leaf,
	../../../../src/compiler_new/stage_01_discovery/tables/row_kinds:
		ChildArity(NoChildren),
		NameSpanRule(NameSpanRowRequired, NameSpanRowWhenItHasChildren, NoNameSpanRow),
		NodeKind,
		NodePayloadReference(
			CodepointPayload, DefinitionPayload, DiagnosticPayload, LiteralPayload, NamePayload,
			NoPayload,
		),
		NodeSchema,
		node_schema,
	../../support/kind_inventory: all_node_kinds
	test: TestSuite


---
Whether every kind of `kinds`, mapped by `to_kind`, has a schema `fits` accepts.
---
pure func all_fit[Kind](
	kinds: List[Kind],
	to_kind: pure (Kind) -> NodeKind,
	fits: pure (NodeSchema) -> Bool,
) -> Bool:
	kinds.all(pure func(kind): fits(node_schema(to_kind(kind))))


pure func leaf_with(schema: NodeSchema, payload: NodePayloadReference, span: NameSpanRule) -> Bool:
	schema.payload == payload and schema.arity == NoChildren and schema.name_span == span


pure func test_every_leaf_class_matches_the_schema() -> Bool:
	all_fit(
		ALL_PLAIN_LEAF_KINDS,
		node_kind_of_plain_leaf,
		pure func(schema): leaf_with(schema, NoPayload, NoNameSpanRow),
	) and all_fit(
		ALL_SPANNED_LEAF_KINDS,
		node_kind_of_spanned_leaf,
		pure func(schema): leaf_with(schema, NoPayload, NameSpanRowRequired),
	) and all_fit(
		ALL_NAME_LEAF_KINDS,
		node_kind_of_name_leaf,
		pure func(
			schema,
		): schema.payload == NamePayload and schema.name_span != NameSpanRowRequired,
	) and all_fit(
		ALL_NAMED_SPANNED_LEAF_KINDS,
		node_kind_of_named_spanned_leaf,
		pure func(schema): leaf_with(schema, NamePayload, NameSpanRowRequired),
	) and all_fit(
		ALL_LITERAL_LEAF_KINDS,
		node_kind_of_literal_leaf,
		pure func(schema): leaf_with(schema, LiteralPayload, NoNameSpanRow),
	) and all_fit(
		ALL_CODEPOINT_LEAF_KINDS,
		node_kind_of_codepoint_leaf,
		pure func(schema): leaf_with(schema, CodepointPayload, NoNameSpanRow),
	)


pure func test_every_parent_class_matches_the_schema() -> Bool:
	all_fit(
		ALL_PLAIN_PARENT_KINDS,
		node_kind_of_plain_parent,
		pure func(
			schema,
		): (
			schema.payload == NoPayload
			and schema.arity != NoChildren
			and schema.name_span == NoNameSpanRow
		),
	) and all_fit(
		ALL_NAMED_PARENT_KINDS,
		node_kind_of_named_parent,
		pure func(
			schema,
		): (
			schema.payload == NamePayload
			and schema.arity != NoChildren
			and schema.name_span != NoNameSpanRow
		),
	) and all_fit(
		ALL_NAME_ONLY_PARENT_KINDS,
		node_kind_of_name_only_parent,
		pure func(
			schema,
		): schema.payload == NamePayload and schema.name_span == NameSpanRowWhenItHasChildren,
	)


---
How many classes map to `kind`.
---
pure func class_count(kind: NodeKind) -> Int:
	ALL_PLAIN_LEAF_KINDS
		.filter(pure func(k): node_kind_of_plain_leaf(k) == kind)
		.length() + ALL_SPANNED_LEAF_KINDS
		.filter(pure func(k): node_kind_of_spanned_leaf(k) == kind)
		.length() + ALL_NAME_LEAF_KINDS
		.filter(pure func(k): node_kind_of_name_leaf(k) == kind)
		.length() + ALL_NAMED_SPANNED_LEAF_KINDS
		.filter(pure func(k): node_kind_of_named_spanned_leaf(k) == kind)
		.length() + ALL_LITERAL_LEAF_KINDS
		.filter(pure func(k): node_kind_of_literal_leaf(k) == kind)
		.length() + ALL_CODEPOINT_LEAF_KINDS
		.filter(pure func(k): node_kind_of_codepoint_leaf(k) == kind)
		.length() + ALL_PLAIN_PARENT_KINDS
		.filter(pure func(k): node_kind_of_plain_parent(k) == kind)
		.length() + ALL_NAMED_PARENT_KINDS
		.filter(pure func(k): node_kind_of_named_parent(k) == kind)
		.length() + ALL_NAME_ONLY_PARENT_KINDS
		.filter(pure func(k): node_kind_of_name_only_parent(k) == kind)
		.length()


---
How many classes `kind` belongs to when it has no appender of its own. One, except
the two kinds the schema lets a caller write in two child forms: a type name with or
without arguments is a name leaf or a named parent, and a lambda parameter with or
without a written type is a named parent or a name-only parent. `kind` ranges over every
`NodeKind` (`all_node_kinds`), so a kind missing from every `ALL_*` list fails.
---
pure func expected_class_count(kind: NodeKind) -> Int:
	match kind:
		NamedTypeNode | LambdaParameterNode:
			2
		_:
			1


pure func is_classified_correctly(kind: NodeKind) -> Bool:
	schema: NodeSchema = node_schema(kind)
	own_appender: Bool = schema.payload == DiagnosticPayload or schema.payload == DefinitionPayload

	if own_appender:
		class_count(kind) == 0
	else:
		class_count(kind) == expected_class_count(kind)


pure func test_every_node_kind_is_in_a_class_unless_it_has_its_own_appender() -> Bool:
	all_node_kinds().all(is_classified_correctly)


tests: TestSuite = {
	description = "Node kind classes",
	tests = [
		("every leaf class matches the schema", test_every_leaf_class_matches_the_schema),
		("every parent class matches the schema", test_every_parent_class_matches_the_schema),
		(
			"every node kind is in a class unless it has its own appender",
			test_every_node_kind_is_in_a_class_unless_it_has_its_own_appender,
		),
	]
}
