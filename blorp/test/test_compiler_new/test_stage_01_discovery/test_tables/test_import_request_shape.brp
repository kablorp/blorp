-- The shape of an import request: its kind and, for a relative one, how many
-- `../` it climbs, held as one value so the two cannot disagree.
import:
	../../../../src/compiler_new/stage_01_discovery/tables/row_kinds:
		ImportRequestKind(BareModuleRequest, NativePackageRequest, RelativeModuleRequest),
		bare_request,
		native_package_request,
		relative_request,
		request_kind,
		request_parent_steps,
		written_import_request,
	test: TestSuite


pure func test_a_bare_or_native_request_climbs_no_parents() -> Bool:
	(
		bare_request().request_kind() == BareModuleRequest
		and bare_request().request_parent_steps() == 0
		and native_package_request().request_kind() == NativePackageRequest
		and native_package_request().request_parent_steps() == 0
	)


pure func test_a_relative_request_keeps_its_parent_steps() -> Bool:
	(
		relative_request(0).request_kind() == RelativeModuleRequest
		and relative_request(0).request_parent_steps() == 0
		and relative_request(3).request_kind() == RelativeModuleRequest
		and relative_request(3).request_parent_steps() == 3
	)


pure func test_a_request_is_written_from_its_shape_and_parts() -> Bool:
	written_import_request(
		bare_request(),
		["lib", "source"],
	) == "lib/source" and written_import_request(
		native_package_request(),
		["pkg", "net"],
	) == "pkg/net" and written_import_request(
		relative_request(0),
		["a", "b"],
	) == "./a/b" and written_import_request(relative_request(2), ["x"]) == "../../x"


tests: TestSuite = {
	description = "Discovery import request shape",
	tests = [
		(
			"a bare or native request climbs no parents",
			test_a_bare_or_native_request_climbs_no_parents,
		),
		(
			"a relative request keeps its parent steps",
			test_a_relative_request_keeps_its_parent_steps,
		),
		(
			"a request is written from its shape and parts",
			test_a_request_is_written_from_its_shape_and_parts,
		),
	]
}
