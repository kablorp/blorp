func test_appending_rows_copies_no_table() -> Bool:
	var builder: DiscoveryBuilder = empty_discovery_builder()
	reset_mem_stats()
	active_before = read_memory_counter(MemoryStatsActive) == 1 and read_memory_counter(OracleStatsActive) == 1
	var index: Int = 0

	while index < REPEATS:
		builder = builder.append_definition({
			module = module_id_at_row(0),
			kind = FunctionDefinition,
			name = name_id_at_row(0),
			name_span = pack_span(source_id_at_row(0), 0, 0),
			visibility = PublicVisibility,
			span = pack_span(source_id_at_row(0), 0, 0),
		})
		builder = builder.append_plain_leaf_node(
			BreakLeaf,
			pack_span(source_id_at_row(0), 0, 0),
		)
		index += 1

	allocations = read_memory_counter(ManagedAllocations)

	(
		active_before and read_memory_counter(MemoryStatsActive) == 1
		and read_memory_counter(OracleStatsActive) == 1
		and builder.definitions.length() == REPEATS
		and builder.nodes.length() == REPEATS
		and allocations > ROW_APPEND_ALLOCATIONS - EXACT_TOLERANCE
		and allocations < ROW_APPEND_ALLOCATIONS + EXACT_TOLERANCE
	)


