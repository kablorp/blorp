-- Measurements: benchmarks/results/discovery_merge_allocations_2026-10-04.md
-- Exact per-family pins guard builder threading with managed discovery rows.
-- The fixed tolerance remains far below one extra copy per 2,000 repeats;
-- larger admitted row costs do not increase tolerated table-copy traffic.
import:
	../../../../src/compiler_new/stage_01_discovery/lex/lexed_module: LexedModule
	../../../../src/compiler_new/stage_01_discovery/lex/lexer: lex_module
	../../../../src/compiler_new/stage_01_discovery/parse/declaration_parser:
		parse_module_declarations,
	../../../../src/compiler_new/stage_01_discovery/parse/lexed_bridge: bridge_lexed_module
	../../../../src/compiler_new/stage_01_discovery/sources/source_admission:
		admit_source_with_line_starts,
	../../../../src/compiler_new/stage_01_discovery/tables/builder:
		DiscoveryBuilder,
		ModuleOpening,
		close_module,
		empty_discovery_builder,
		next_module_id,
		open_module,
		opened_module,
	../../../../src/compiler_new/stage_01_discovery/tables/ids:
		module_id_at_row,
		name_id_at_row,
		source_id_at_row,
	../../../../src/compiler_new/stage_01_discovery/tables/node_builder: append_plain_leaf_node
	../../../../src/compiler_new/stage_01_discovery/tables/node_kind_classes:
		PlainLeafKind(BreakLeaf),
	../../../../src/compiler_new/stage_01_discovery/tables/row_kinds:
		DefinitionKind(FunctionDefinition),
		ModuleOriginKind(UserModule),
		ModuleReach(RootModule),
		Visibility(PublicVisibility),
	../../../../src/compiler_new/stage_01_discovery/tables/span: pack_span
	../../support/raw_rows: append_definition
	memory:
		MemoryCounter(ManagedAllocations, MemoryStatsActive, OracleStatsActive),
		read_memory_counter,
		reset_mem_stats,
	test: TestSuite


---
Statements or rows per measured run.
---
REPEATS: Int = 2000

---
A module that is `prefix` followed by `item` repeated `REPEATS` times; the
names and literals it uses are interned by its first copy.
---
pure func repeated_text(prefix: String, item: String) -> String:
	var text: String = prefix
	var index: Int = 0

	while index < REPEATS:
		text += item
		index += 1

	text


---
The allocations parsing `text` as a module made, or `None` when the parse
rejected it or lost its repeated items: either would pass a budget vacuously.
Lexing and bridging the module happen before the counters reset: the budget
guards the parser's builder threading, and the lexer is a pure function whose
own allocations `test_lexer_allocations` pins.
---
func parse_allocations(text: String) -> Option[Int]:
	empty: DiscoveryBuilder = empty_discovery_builder()
	lexed: LexedModule = lex_module(empty.next_module_id(), text)
	admitted: DiscoveryBuilder = empty.admit_source_with_line_starts(
		"budget.brp",
		text,
		lexed.line_starts,
	)
	opening: ModuleOpening = admitted.open_module(UserModule, RootModule)
	prepared: DiscoveryBuilder = admitted.bridge_lexed_module(lexed)
	reset_mem_stats()
	active_before = read_memory_counter(MemoryStatsActive) == 1 and read_memory_counter(OracleStatsActive) == 1
	builder: DiscoveryBuilder = prepared
		.parse_module_declarations(opening.opened_module())
		.close_module(opening)
	allocations = read_memory_counter(ManagedAllocations)

	if (
		active_before and read_memory_counter(MemoryStatsActive) == 1
		and read_memory_counter(OracleStatsActive) == 1
		and builder.diagnostics.length() == 0 and builder.tokens.length() > REPEATS
	):
		Some(allocations)
	else:
		None


---
How far from its pinned count a run of a per-use-allocating family may be.
A builder or table copy per use adds at least one allocation per repeat,
`REPEATS` in all, far above this.
---
EXACT_TOLERANCE: Int = 100


-- Two list-growth sequences plus one DefinitionRow, NodeRow, and child span
-- record per iteration: 6,000 owned products and 20 growth allocations.
private ROW_APPEND_ALLOCATIONS: Int = 6020


---
Whether parsing `item` after `prefix`, `REPEATS` times, allocates within
`EXACT_TOLERANCE` of `expected_allocations`, both ways. Managed discovery rows
allocate per use without enlarging the tolerated overhead. The count is measured,
not derived: a drop is as worth noticing as a rise, so tighten the pin when
an allocation goes away.
---
func family_allocates(prefix: String, item: String, expected_allocations: Int) -> Bool:
	match parse_allocations(repeated_text(prefix, item)):
		Some(allocations):
			if allocations <= expected_allocations - EXACT_TOLERANCE or allocations >= expected_allocations + EXACT_TOLERANCE:
				print("parser allocation pin: expected=${expected_allocations} actual=${allocations}")
			(
				allocations > expected_allocations - EXACT_TOLERANCE
				and allocations < expected_allocations + EXACT_TOLERANCE
			)
		None:
			False


---
As `family_allocates`, for statements in one function body.
---
func statement_family_allocates(statement: String, expected_allocations: Int) -> Bool:
	family_allocates("func f(a, b, c, x):\n", statement, expected_allocations)


---
The allocations bridging `text`, lexed before the counters reset, into a
builder made, or `None` when the counters did not run or the bridge lost the
repeated tokens: either would pass a budget vacuously.
---
func bridge_allocations(text: String) -> Option[Int]:
	empty: DiscoveryBuilder = empty_discovery_builder()
	lexed: LexedModule = lex_module(empty.next_module_id(), text)
	admitted: DiscoveryBuilder = empty.admit_source_with_line_starts(
		"budget.brp",
		text,
		lexed.line_starts,
	)
	reset_mem_stats()
	active_before = read_memory_counter(MemoryStatsActive) == 1 and read_memory_counter(OracleStatsActive) == 1
	bridged: DiscoveryBuilder = admitted.bridge_lexed_module(lexed)
	allocations = read_memory_counter(ManagedAllocations)

	if (
		active_before and read_memory_counter(MemoryStatsActive) == 1
		and read_memory_counter(OracleStatsActive) == 1
		and allocations > 0 and bridged.tokens.length() > REPEATS
	):
		Some(allocations)
	else:
		None


---
What bridging a module may allocate beyond `allocations_per_repeat` for each
repeat of its item: the builder's tables growing and the module's setup.
A builder or table copied per repeat adds at least one allocation to every
repeat, `REPEATS` in all, far above this.
---
BRIDGE_SETUP_ALLOWANCE: Int = 100


---
Whether bridging `item` repeated `REPEATS` times allocates `allocations_per_repeat`
for each repeat, give or take `BRIDGE_SETUP_ALLOWANCE` for table growth: names and
literals the builder has met allocate nothing, and what an item does allocate
is a count per use that the item's test explains.
---
func bridging_allocates_per_repeat(item: String, allocations_per_repeat: Int) -> Bool:
	match bridge_allocations(repeated_text("", item)):
		Some(allocations):
			if allocations < allocations_per_repeat * REPEATS or allocations >= allocations_per_repeat * REPEATS + BRIDGE_SETUP_ALLOWANCE:
				print("bridge allocation pin ${item}: expected_per_repeat=${allocations_per_repeat} actual=${allocations}")
			(
				allocations >= allocations_per_repeat * REPEATS
				and allocations < allocations_per_repeat * REPEATS + BRIDGE_SETUP_ALLOWANCE
			)
		None:
			False


-- Five rewritten identifier/dimension tokens per repeat; seeded spellings
-- contribute setup costs rather than a copied spelling table per occurrence.
func test_bridging_repeated_names_copies_no_table() -> Bool:
	bridging_allocates_per_repeat("alpha beta alpha #Rows beta\n", 5)


-- Six rewritten name/literal tokens per repeat; repeated literals reuse
-- their interned texts. No other token must be reconstructed.
func test_bridging_repeated_literals_copies_no_table() -> Bool:
	bridging_allocates_per_repeat("x = 1 + 2.5 + 1 + \"text\" + \"text\"\n", 6)


-- Four per rejected number: the name token, two rejected-token updates
-- (kind then literal payload), and the diagnostic row. Both rejection
-- families share this path; the rejected digits are interned only once.
func test_bridging_repeated_rejected_integers_copies_no_table() -> Bool:
	bridging_allocates_per_repeat("x = 170141183460469231731687303715884105728\n", 4)


-- The same four-product rejection path as integers.
func test_bridging_repeated_rejected_floats_copies_no_table() -> Bool:
	bridging_allocates_per_repeat("x = 1" + "0".repeat(400) + ".5\n", 4)


-- Ten per interpolated string: eight bridged piece/interpolation products
-- plus two rewritten tokens (the binding name and the interpolation token).
func test_bridging_repeated_interpolations_copies_no_table() -> Bool:
	-- The `${` is split across two literals so this file does not interpolate it.
	bridging_allocates_per_repeat("y = \"a $" + "{a} b $" + "{b + c}\"\n", 10)


func test_parsing_repeated_expression_statements_copies_no_table() -> Bool:
	statement_family_allocates("\tx = a + b * c\n", 34086)

func test_parsing_repeated_blocks_and_calls_copies_no_table() -> Bool:
	statement_family_allocates("\tif a > b:\n\t\tf(a, [b, c])\n\telse:\n\t\tx\n", 76088)

