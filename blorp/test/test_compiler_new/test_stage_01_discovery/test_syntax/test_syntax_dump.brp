-- The canonical text of a module's syntax: every node with its id and span,
-- names as their text, one statement or member per line, and long chains
-- written without deep recursion.
import:
	../../../../src/compiler_new/stage_01_discovery/syntax/declarations: RecordDeclarationForm(OrdinaryRecord), GlobalForm(ConstantGlobal), AliasForm(TransparentAlias), UnionDeclarationForm(OrdinaryUnion, FixedUnion)
	../../../../src/compiler_new/stage_01_discovery/syntax/dump: dumped_module
	../../../../src/compiler_new/stage_01_discovery/syntax/expressions:
		BinaryOperator(Add, Divide, Equal, Greater, GreaterEqual, LessEqual, Modulo, Multiply, NotEqual, Subtract),
		Body(BlockBody),
		CompoundOperator(DivideAssign, MultiplyAssign, SubtractAssign),
		ElseBody(ElseBlock, ElseIf),
		Expression,
		ExpressionKind(Binary, If, IntegerLiteral, Lambda, StringLiteral),
		Statement,
	../../../../src/compiler_new/stage_01_discovery/syntax/ids:
		minted_else_if,
		minted_field,
		minted_alias,
		minted_global,
		minted_record,
		minted_union,
	../../../../src/compiler_new/stage_01_discovery/syntax/module_syntax:
		ModuleItem(GlobalItem, RecordItem, AliasItem, UnionItem),
	../../../../src/compiler_new/stage_01_discovery/syntax/patterns: StringForm(PipeString, RawPipeString)
	../../../../src/compiler_new/stage_01_discovery/tables/row_kinds:
		Purity(PureFunction),
		Visibility(PrivateVisibility, PublicVisibility),
	../../../../src/compiler_new/stage_01_discovery/syntax/types:
		DimensionOperator(AddDimensions, DivideDimensions, SubtractDimensions),
		WrittenTypeKind(FunctionType),
	../../support/syntax_samples:
		SampleBuild,
		block,
		block_of,
		every_form_module,
		expression,
		module_syntax,
		name_expression,
		named_type,
		next_span,
		sample_annotation_function,
		sample_binary,
		sample_build,
		sample_bounded_type,
		written_type,
		sample_compound,
		sample_dimension_arithmetic,
		sample_from_opaque,
		sample_logical_not,
		sample_logical_or,
		sample_pipe_interpolation,
		sample_quadruple,
		written,
	test: TestSuite


---
The dump of a module whose one item is the global `value = <value>`.
---
pure func dump_of_global(build: SampleBuild, value: Expression) -> String:
	(b1, name) = build.written("value")
	(b2, span) = b1.next_span()
	(m1, global) = b2.mint.minted_global(
		PublicVisibility,
		None,
		ConstantGlobal,
		name,
		None,
		value,
		span,
	)
	finished: SampleBuild = { b2 | mint = m1 }
	dumped_module(
		finished.module_syntax([GlobalItem(global)], None),
		finished.spellings,
	)


---
Whether `dump` mentions each of the `count` ids of the family written with
`prefix`, followed by `after` (a space for a node, `:` for a name).
---
pure func mentions_every_id(
	dump: String,
	prefix: String,
	count: Int,
	after: String,
) -> Bool:
	var index: Int = 0
	var found: Bool = True

	while found and index < count:
		found = dump.contains(prefix + index.to_string() + after)
		index += 1

	found


pure func test_every_issued_id_is_in_the_dump() -> Bool:
	(syntax, spellings) = every_form_module()
	dump: String = dumped_module(syntax, spellings)
	counts = syntax.counts
	(
		mentions_every_id(dump, "def", syntax.definitions.length(), " ")
		and mentions_every_id(dump, "imp", syntax.imports.length(), " ")
		and mentions_every_id(dump, "stmt", counts.statements, " ")
		and mentions_every_id(dump, "block", counts.blocks, " ")
		and mentions_every_id(dump, "expr", counts.expressions, " ")
		and mentions_every_id(dump, "pat", counts.patterns, " ")
		and mentions_every_id(dump, "type", counts.written_types, " ")
		and mentions_every_id(dump, "dim", counts.dimensions, " ")
		and mentions_every_id(dump, "use", counts.name_uses, ":")
		and mentions_every_id(dump, "bind", counts.binders, ":")
		and mentions_every_id(dump, "tbind", counts.type_binders, ":")
	)


---
`value = (a + b) * c`: operands before operators, ids in completion order.
---
pure func test_an_expression_dumps_its_ids_spans_and_names() -> Bool:
	(b1, a) = sample_build().name_expression("a")
	(b2, b) = b1.name_expression("b")
	(b3, sum) = b2.expression(Binary(Add, a, b))
	(b4, c) = b3.name_expression("c")
	(b5, product) = b4.expression(Binary(Multiply, sum, c))
	b5.dump_of_global(
		product,
	) == "(module\n" + "  (global def0 public @22..23 constant \"value\"@16..21 - " + "(binary expr4 @14..15 multiply " + "(binary expr2 @8..9 add (name expr0 @2..3 use0:\"a\"@0..1) (name expr1 @6..7 use1:\"b\"@4..5)) " + "(name expr3 @12..13 use2:\"c\"@10..11))))"


pure func test_text_is_quoted_on_one_line() -> Bool:
	(b1, text) = sample_build().expression(StringLiteral(PipeString, "say \"hi\"\n\tback\\slash"))
	b1
		.dump_of_global(text)
		.contains("(string expr0 @0..1 pipe \"say \\\"hi\\\"\\n\\tback\\\\slash\")")


---
`record Pair[T] { left: Int }` with a docstring: the field, minted first, on
its own line one level in.
---
pure func test_a_declaration_dumps_its_members_one_level_in() -> Bool:
	(b1, field_type) = sample_build().named_type("Int")
	(b2, field_name) = b1.written("left")
	(b3, span) = b2.next_span()
	(m1, field) = b3.mint.minted_field(field_name, field_type, span)
	(b4, record_name) = { b3 | mint = m1 }.written("Pair")
	(m2, record_declaration) = b4.mint.minted_record(PrivateVisibility, Some({
			text = "Two things.",
			span = span,
		}), OrdinaryRecord, record_name, [], [field], span)
	finished: SampleBuild = { b4 | mint = m2 }
	dumped_module(
		finished.module_syntax([RecordItem(record_declaration)], None),
		finished.spellings,
	) == "(module\n" + "  (record def1 private @11..12 (documentation \"Two things.\" @11..12) \"Pair\"@13..17 (type-parameters)\n" + "    (field def0 @11..12 \"left\"@6..10 (named-type type0 @4..5 use0:\"Int\"@0..3))))"


---
`if a: 1 else if b: 2 else: 3`: an `else if`'s blocks indent as the first
`if`'s do.
---
pure func test_an_else_if_chain_stays_at_one_depth() -> Bool:
	(b1, condition) = sample_build().name_expression("a")
	(b2, one) = b1.expression(IntegerLiteral(to_int128(1)))
	(b3, then_block) = b2.block_of(one)
	(b4, inner_condition) = b3.name_expression("b")
	(b5, two) = b4.expression(IntegerLiteral(to_int128(2)))
	(b6, inner_block) = b5.block_of(two)
	(b7, three) = b6.expression(IntegerLiteral(to_int128(3)))
	(b8, else_block) = b7.block_of(three)
	(b9, keyword) = b8.next_span()
	(m1, else_if) = b9.mint.minted_else_if(
		keyword,
		{
			condition = inner_condition,
			then_block = inner_block,
			else_branch = Some({
				keyword = keyword,
				body = ElseBlock(else_block),
			})
		},
	)
	(b10, conditional) = { b9 | mint = m1 }.expression(If({
		condition = condition,
		then_block = then_block,
		else_branch = Some({
			keyword = keyword,
			body = ElseIf(else_if),
		}),
	}))
	b10.dump_of_global(
		conditional,
	) == "(module\n" + "  (global def0 public @36..37 constant \"value\"@30..35 - (if expr6 @28..29 (name expr0 @2..3 use0:\"a\"@0..1) (block block0 @8..9\n" + "    (expression-statement stmt0 @6..7 (integer expr1 @4..5 1))) " + "(else @26..27 (else-if expr5 @26..27 (name expr2 @12..13 use1:\"b\"@10..11) (block block1 @18..19\n" + "    (expression-statement stmt1 @16..17 (integer expr3 @14..15 2))) " + "(else @26..27 (block block2 @24..25\n" + "    (expression-statement stmt2 @22..23 (integer expr4 @20..21 3)))))))))"


pure func test_a_five_thousand_term_sum_dumps_every_term() -> Bool:
	(b1, first) = sample_build().expression(IntegerLiteral(to_int128(1)))
	var current: SampleBuild = b1
	var sum: Expression = first
	var added: Int = 1

	while added < 5000:
		(with_term, term) = current.expression(IntegerLiteral(to_int128(1)))
		(with_sum, next_sum) = with_term.expression(Binary(Add, sum, term))
		current = with_sum
		sum = next_sum
		added += 1

	dump: String = current.dump_of_global(sum)
	dump.count("(integer ") == 5000 and dump.count("(binary ") == 4999 and dump.count("\n") == 1


pure func test_records_keep_their_written_form() -> Bool:
	(syntax, spellings) = every_form_module()
	dump: String = dumped_module(syntax, spellings)
	dump.contains("(record ") and dump.contains("(fixed-record ")


pure func test_unions_keep_their_written_form() -> Bool:
	(b1, name) = sample_build().written("Choice")
	(b2, span) = b1.next_span()
	(m1, ordinary) = b2.mint.minted_union(PublicVisibility, None, OrdinaryUnion, name, [], [], span)
	(m2, fixed) = m1.minted_union(PublicVisibility, None, FixedUnion, name, [], [], span)
	finished: SampleBuild = { b2 | mint = m2 }
	dump: String = dumped_module(finished.module_syntax([UnionItem(ordinary), UnionItem(fixed)], None), finished.spellings)
	dump.contains("(union def0 ") and dump.contains("(fixed-union def1 ")


---
A statement retained in a one-statement lambda block, then in a global.
---
pure func dump_of_statement(build: SampleBuild, value: Statement) -> String:
	(b1, body) = build.block([], value)
	(b2, lambda) = b1.expression(Lambda({
		purity = PureFunction,
		parameters = [],
		return_type = None,
		body = BlockBody(body),
	}))
	b2.dump_of_global(lambda)


pure func test_binary_alternatives_keep_both_operands_in_order() -> Bool:
	var correct: Bool = True

	for (operator, text) in [
		(Subtract, "subtract"), (Divide, "divide"), (Modulo, "modulo"),
		(Equal, "equal"), (NotEqual, "not-equal"), (LessEqual, "less-equal"),
		(Greater, "greater"), (GreaterEqual, "greater-equal"),
	]:
		(build, value) = sample_build().sample_binary(operator)
		correct = correct and build.dump_of_global(value).contains(
			"(binary expr2 @4..5 " + text + " (integer expr0 @0..1 7) (integer expr1 @2..3 2))",
		)

	correct


pure func test_dimension_alternatives_keep_both_operands_in_order() -> Bool:
	var correct: Bool = True

	for (operator, text) in [
		(AddDimensions, "add"), (SubtractDimensions, "subtract"), (DivideDimensions, "divide"),
	]:
		(build, value) = sample_build().sample_dimension_arithmetic(operator)
		correct = correct and build.dump_of_statement(value).contains(
			"(typed-binding stmt0 @15..16 bind0:\"size\"@8..12 " +
			"(dimension-type type0 @6..7 (dimension-arithmetic dim2 @4..5 " + text +
			" (literal-dimension dim0 @0..1 7) (literal-dimension dim1 @2..3 2))) " +
			"(integer expr0 @13..14 5))",
		)

	correct


pure func test_compound_alternatives_keep_the_target_before_the_value() -> Bool:
	var correct: Bool = True

	for (operator, text) in [
		(SubtractAssign, "subtract"), (MultiplyAssign, "multiply"), (DivideAssign, "divide"),
	]:
		(build, value) = sample_build().sample_compound(operator)
		correct = correct and build.dump_of_statement(value).contains(
			"(compound-assignment stmt0 @8..9 " + text +
			" use0:\"total\"@0..5 (integer expr0 @6..7 2))",
		)

	correct


pure func test_quadruple_keeps_all_four_elements_in_order() -> Bool:
	(build, value) = sample_build().sample_quadruple()
	build.dump_of_global(value).contains(
		"(tuple expr4 @8..9 (integer expr0 @0..1 1) (integer expr1 @2..3 2) " +
		"(integer expr2 @4..5 3) (integer expr3 @6..7 4))",
	)


pure func test_logical_alternatives_keep_their_operands() -> Bool:
	(not_build, logical_not) = sample_build().sample_logical_not()
	(or_build, logical_or) = sample_build().sample_logical_or()
	not_build.dump_of_global(logical_not).contains(
		"(unary expr1 @2..3 not (boolean expr0 @0..1 True))",
	) and or_build.dump_of_global(logical_or).contains(
		"(short-circuit expr2 @4..5 or (boolean expr0 @0..1 False) (boolean expr1 @2..3 True))",
	)


pure func test_from_opaque_keeps_its_type_before_its_value() -> Bool:
	(build, value) = sample_build().sample_from_opaque()
	build.dump_of_global(value).contains(
		"(opaque expr1 @10..11 from (named-type type0 @6..7 use0:\"Token\"@0..5) " +
		"(integer expr0 @8..9 7))",
	)


pure func test_pipe_interpolation_keeps_text_and_hole_in_order() -> Bool:
	(build, value) = sample_build().sample_pipe_interpolation()
	build.dump_of_global(value).contains(
		"(interpolated expr2 @4..5 pipe (text \"before \") " +
		"(hole expr1 @2..3 (integer expr0 @0..1 7)) (text \" after\"))",
	)


pure func test_raw_pipe_string_keeps_its_form_and_text() -> Bool:
	(build, value) = sample_build().expression(StringLiteral(RawPipeString, "raw\\text\nnext"))
	build.dump_of_global(value).contains("(string expr0 @0..1 raw-pipe \"raw\\\\text\\nnext\")")


pure func test_annotation_alternatives_keep_their_order_and_spans() -> Bool:
	(build, item) = sample_build().sample_annotation_function()
	dumped_module(build.module_syntax([item], None), build.spellings) == "(module\n  (function def0 public @14..15 (annotation debug-only @10..11) " + "(annotation resource-result-ordinary @12..13) " + "(signature impure @14..15 \"annotated\"@0..9 (parameters) -) " + "(type-parameters) (where) -))"


-- The nested bounded form retains its own span as well as the wrapper's
-- WrittenTypeId/span, and uses are printed in source order.
private pure func bounded_type_dump() -> String:
	("(bounded-type type0 @12..13 (bounded @0..11 use0:\"T\"@0..1 " +
		"(trait @2..6 use1:\"m\"@2..3 use2:\"Eq\"@4..6) (trait @7..11 - use3:\"Hash\"@7..11)))")


pure func test_standalone_bounded_type_dump_retains_outer_id_and_every_bound_use() -> Bool:
	(build, bounded) = sample_build().sample_bounded_type()
	(named, name) = build.written("Receiver")
	(spanned, span) = named.next_span()
	(mint, declaration) = spanned.mint.minted_alias(PublicVisibility, None, TransparentAlias, name, [], bounded, span)
	owned = { spanned | mint = mint }.module_syntax([AliasItem(declaration)], None)
	actual: String = dumped_module(owned, spanned.spellings)
	(actual == "(module\n  (alias def0 public @23..24 transparent \"Receiver\"@14..22 (type-parameters) " + bounded_type_dump() + "))"
		and actual == dumped_module(owned, spanned.spellings))


pure func test_function_result_keeps_standalone_bounded_type_dump() -> Bool:
	(b1, bounded) = sample_build().sample_bounded_type()
	(b2, function) = b1.written_type(FunctionType(PureFunction, [], bounded))
	(named, name) = b2.written("Receiver")
	(spanned, span) = named.next_span()
	(mint, declaration) = spanned.mint.minted_alias(PublicVisibility, None, TransparentAlias, name, [], function, span)
	owned = { spanned | mint = mint }.module_syntax([AliasItem(declaration)], None)
	(dumped_module(owned, spanned.spellings) == "(module\n  (alias def0 public @25..26 transparent \"Receiver\"@16..24 (type-parameters) " +
		"(function-type type1 @14..15 pure (parameters) " + bounded_type_dump() + ")))")


tests: TestSuite = {
	description = "Discovery syntax dump",
	tests = [
		("unions keep their written form", test_unions_keep_their_written_form),
		("standalone bounded type retains outer ID and bound uses", test_standalone_bounded_type_dump_retains_outer_id_and_every_bound_use),
		("function result retains standalone bounded type", test_function_result_keeps_standalone_bounded_type_dump),
		("binary alternatives keep both operands in order", test_binary_alternatives_keep_both_operands_in_order),
		("dimension alternatives keep both operands in order", test_dimension_alternatives_keep_both_operands_in_order),
		("compound alternatives keep the target before the value", test_compound_alternatives_keep_the_target_before_the_value),
		("quadruple keeps all four elements in order", test_quadruple_keeps_all_four_elements_in_order),
		("logical alternatives keep their operands", test_logical_alternatives_keep_their_operands),
		("from opaque keeps its type before its value", test_from_opaque_keeps_its_type_before_its_value),
		("pipe interpolation keeps text and hole in order", test_pipe_interpolation_keeps_text_and_hole_in_order),
		("raw pipe string keeps its form and text", test_raw_pipe_string_keeps_its_form_and_text),
		("annotation alternatives keep their order and spans", test_annotation_alternatives_keep_their_order_and_spans),
		("every issued id is in the dump", test_every_issued_id_is_in_the_dump),
		("records keep their written form", test_records_keep_their_written_form),
		(
			"an expression dumps its ids, spans and names",
			test_an_expression_dumps_its_ids_spans_and_names,
		),
		("text is quoted on one line", test_text_is_quoted_on_one_line),
		(
			"a declaration dumps its members one level in",
			test_a_declaration_dumps_its_members_one_level_in,
		),
		("an else if chain stays at one depth", test_an_else_if_chain_stays_at_one_depth),
		(
			"a five thousand term sum dumps every term",
			test_a_five_thousand_term_sum_dumps_every_term,
		),
	]
}
