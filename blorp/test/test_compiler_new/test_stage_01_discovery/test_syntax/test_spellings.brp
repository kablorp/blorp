-- One module's spellings: interned once, found by slice, and unreadable
-- against another module's table.
import:
	../../../../src/compiler_new/stage_01_discovery/syntax/ids: SpellingId, spelling_index, spelling_module
	../../../../src/compiler_new/stage_01_discovery/syntax/spellings:
		Spellings,
		interned_spelling,
		new_spellings,
		spelling_count,
		spelling_text,
		spelling_text_at,
	../../../../src/compiler_new/stage_01_discovery/tables/ids: module_id_at_row, module_id_index
	test: TestSuite


pure func test_a_new_table_has_no_spellings() -> Bool:
	spelling_count(new_spellings(module_id_at_row(0))) == 0


pure func test_a_spelling_interns_once_and_reads_back() -> Bool:
	source: String = "alpha beta alpha"
	(first_table, first) = interned_spelling(new_spellings(module_id_at_row(3)), source, 0, 5)
	(second_table, second) = interned_spelling(first_table, source, 6, 10)
	(third_table, third) = interned_spelling(second_table, source, 11, 16)
	(
		spelling_index(first) == 0
		and spelling_index(second) == 1
		and spelling_index(third) == spelling_index(first)
		and spelling_count(third_table) == 2
		and spelling_text(third_table, first) == Some("alpha")
		and spelling_text(third_table, second) == Some("beta")
	)


pure func test_a_keyword_used_as_a_name_interns_at_first_occurrence() -> Bool:
	(table, keyword) = interned_spelling(new_spellings(module_id_at_row(0)), "match", 0, 5)
	spelling_index(keyword) == 0 and spelling_count(table) == 1


pure func test_the_id_carries_its_module() -> Bool:
	(_, spelling) = interned_spelling(new_spellings(module_id_at_row(7)), "x", 0, 1)
	module_id_index(spelling_module(spelling)) == 7


pure func test_a_spelling_is_not_readable_against_another_modules_table() -> Bool:
	(_, mine) = interned_spelling(new_spellings(module_id_at_row(1)), "name", 0, 4)
	(other_table, theirs) = interned_spelling(new_spellings(module_id_at_row(2)), "name", 0, 4)
	(
		spelling_text(other_table, mine).is_none()
		and spelling_text(other_table, theirs) == Some("name")
	)


pure func test_two_tables_that_diverged_each_intern_a_spelling_once_under_their_own_ids() -> Bool:
	base: Spellings = new_spellings(module_id_at_row(0))
	(left_base, _) = interned_spelling(base, "x", 0, 1)
	(right_base, _) = interned_spelling(base, "y", 0, 1)
	(left, left_id) = interned_spelling(left_base, "y x", 2, 3)
	(right, right_id) = interned_spelling(right_base, "y x", 2, 3)
	(left_again, left_again_id) = interned_spelling(left, "x", 0, 1)
	(right_again, right_again_id) = interned_spelling(right, "x", 0, 1)
	(
		spelling_count(left) == 1
		and spelling_count(right) == 2
		and spelling_index(left_id) == 0
		and spelling_index(right_id) == 1
		and spelling_index(left_again_id) == spelling_index(left_id)
		and spelling_index(right_again_id) == spelling_index(right_id)
		and spelling_count(left_again) == spelling_count(left)
		and spelling_count(right_again) == spelling_count(right)
		and spelling_text_at(left, 0) == Some("x")
		and spelling_text_at(right, 0) == Some("y")
		and spelling_text_at(right, 1) == Some("x")
	)


pure func test_a_met_spelling_returns_the_same_table_and_its_id() -> Bool:
	(table, first) = interned_spelling(new_spellings(module_id_at_row(0)), "alpha alpha", 0, 5)
	(again, second) = interned_spelling(table, "alpha alpha", 6, 11)
	(
		spelling_count(again) == spelling_count(table)
		and spelling_index(second) == spelling_index(first)
	)


pure func test_a_text_is_found_by_its_slice_and_read_by_index() -> Bool:
	(table, _) = interned_spelling(new_spellings(module_id_at_row(0)), "xx gamma", 3, 8)
	(
		spelling_text_at(table, 0) == Some("gamma")
		and spelling_text_at(table, 1).is_none()
	)


pure func test_many_spellings_survive_growing_the_slot_table() -> Bool:
	var words: List[String] = []

	for index in 0..3000:
		words = words.append("n" + index.to_string())

	text: String = words.join(" ")
	var table: Spellings = new_spellings(module_id_at_row(0))
	var ids: List[SpellingId] = []
	var start: Int = 0

	for word in words:
		(grown, spelling) = interned_spelling(table, text, start, start + word.length())
		table = grown
		ids = ids.append(spelling)
		start += word.length() + 1

	var read_back: Int = 0
	var position: Int = 0

	for word in words:
		match ids.get(position):
			Some(spelling):
				if spelling_text(table, spelling) == Some(word):
					read_back += 1
			None:
				void

		position += 1

	read_back == 3000 and spelling_count(table) == 3000


tests: TestSuite = {
	description = "Discovery per-module spellings",
	tests = [
		("a new table has no spellings", test_a_new_table_has_no_spellings),
		("a spelling interns once and reads back", test_a_spelling_interns_once_and_reads_back),
		("a keyword used as a name interns at first occurrence", test_a_keyword_used_as_a_name_interns_at_first_occurrence),
		("the id carries its module", test_the_id_carries_its_module),
		(
			"a spelling is not readable against another module's table",
			test_a_spelling_is_not_readable_against_another_modules_table,
		),
		(
			"two tables that diverged each intern a spelling once under their own ids",
			test_two_tables_that_diverged_each_intern_a_spelling_once_under_their_own_ids,
		),
		(
			"a met spelling returns the same table and its id",
			test_a_met_spelling_returns_the_same_table_and_its_id,
		),
		(
			"a text is found by its slice and read by index",
			test_a_text_is_found_by_its_slice_and_read_by_index,
		),
		(
			"many spellings survive growing the slot table",
			test_many_spellings_survive_growing_the_slot_table,
		),
	]
}
