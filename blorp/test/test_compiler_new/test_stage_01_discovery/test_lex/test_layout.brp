-- Layout tests: what `plan_line_start` decides for each kind of line start,
-- from the indentation stacks alone.
import:
	../../../../src/compiler_new/stage_01_discovery/lex/layout:
		DedentOutcome(DedentedBetweenLevels, DedentedToLevel, NoDedent),
		LayoutStacks,
		LineStartPlan,
		plan_line_start,
	../../../../src/compiler_new/stage_01_discovery/tables/token:
		TokenKind(ColonSymbol, DedentToken, IndentToken, NewlineToken),
	test: TestSuite


---
Stacks holding the top level, an indent of 4 and an indent of 8.
---
pure func nested_stacks() -> LayoutStacks:
	{
		indent_levels = [0, 4, 8],
		indent_depth = 3,
		lambda_groups = [],
		lambda_bases = [],
		lambda_count = 0
	}


pure func test_equal_indentation_emits_the_owed_newline() -> Bool:
	plan: LineStartPlan = nested_stacks().plan_line_start(0, 8, True, True, ColonSymbol)

	(
		plan.emits_newline
		and not plan.opens_indent
		and plan.dedent == NoDedent
		and not plan.pending_newline
		and not plan.at_line_start
		and plan.previous_kind == NewlineToken
	)


pure func test_equal_indentation_without_owed_newline_emits_nothing() -> Bool:
	plan: LineStartPlan = nested_stacks().plan_line_start(0, 8, True, False, ColonSymbol)

	not plan.emits_newline and plan.previous_kind == ColonSymbol


pure func test_deeper_indentation_opens_an_indent() -> Bool:
	plan: LineStartPlan = nested_stacks().plan_line_start(0, 12, True, True, ColonSymbol)

	(
		plan.emits_newline
		and plan.opens_indent
		and plan.indent == 12
		and plan.dedent_count == 0
		and plan.previous_kind == IndentToken
	)


pure func test_dedent_to_a_level_pops_the_deeper_levels() -> Bool:
	plan: LineStartPlan = nested_stacks().plan_line_start(0, 4, True, True, ColonSymbol)

	(
		not plan.emits_newline
		and plan.dedent == DedentedToLevel
		and plan.dedent_count == 1
		and not plan.pending_newline
		and plan.previous_kind == DedentToken
	)


pure func test_dedent_between_levels_is_inconsistent() -> Bool:
	plan: LineStartPlan = nested_stacks().plan_line_start(0, 6, True, True, ColonSymbol)

	plan.dedent == DedentedBetweenLevels and plan.dedent_count == 1


pure func test_newline_inside_brackets_is_insignificant() -> Bool:
	plan: LineStartPlan = nested_stacks().plan_line_start(1, 0, True, True, ColonSymbol)

	(
		not plan.emits_newline
		and not plan.opens_indent
		and plan.dedent == NoDedent
		and not plan.pending_newline
		and not plan.at_line_start
	)


pure func test_blank_line_keeps_the_scan_at_a_line_start() -> Bool:
	plan: LineStartPlan = nested_stacks().plan_line_start(0, 0, False, True, ColonSymbol)

	(
		plan.at_line_start
		and plan.pending_newline
		and not plan.emits_newline
		and plan.dedent_count == 0
	)


pure func test_line_between_a_lambda_bodys_base_and_level_closes_the_body() -> Bool:
	stacks: LayoutStacks = {
		indent_levels = [0, 8],
		indent_depth = 2,
		lambda_groups = [1],
		lambda_bases = [0],
		lambda_count = 1
	}
	plan: LineStartPlan = stacks.plan_line_start(1, 4, True, False, ColonSymbol)

	plan.dedent_count == 1 and plan.dedent == DedentedToLevel


tests: TestSuite = {
	description = "Discovery layout",
	tests = [
		("equal indentation emits the owed newline", test_equal_indentation_emits_the_owed_newline),
		(
			"equal indentation without an owed newline emits nothing",
			test_equal_indentation_without_owed_newline_emits_nothing,
		),
		("deeper indentation opens an indent", test_deeper_indentation_opens_an_indent),
		("dedent to a level pops the deeper levels", test_dedent_to_a_level_pops_the_deeper_levels),
		("dedent between levels is inconsistent", test_dedent_between_levels_is_inconsistent),
		("newline inside brackets is insignificant", test_newline_inside_brackets_is_insignificant),
		(
			"blank line keeps the scan at a line start",
			test_blank_line_keeps_the_scan_at_a_line_start,
		),
		(
			"line between a lambda body's base and level closes the body",
			test_line_between_a_lambda_bodys_base_and_level_closes_the_body,
		),
	]
}
