-- Exact allocations of the pure lexer in TestSuite compilation mode, on the
-- current managed-record bootstrap. Tokens, line plans, number scans and symbol
-- matches are managed products; their spellings do not promise inline storage.
-- benchmarks/results/discovery_merge_allocations_2026-10-04.md
-- retains the 0/1/2/10/2000/4000-repeat samples.
-- Exact pins catch an additional table/spelling copy per item without slack.
import:
	../../../../src/compiler_new/stage_01_discovery/lex/lexed_module: LexedModule
	../../../../src/compiler_new/stage_01_discovery/lex/lexer: lex_module
	../../../../src/compiler_new/stage_01_discovery/tables/ids: module_id_at_row
	memory:
		MemoryCounter(ManagedAllocations, MemoryStatsActive, OracleStatsActive),
		read_memory_counter,
		reset_mem_stats,
	test: TestSuite


---
Items per measured run.
---
REPEATS: Int = 2000


---
The allocations lexing `text` made, or `None` when the counters did not run
or the lexer lost the text's tokens.
---
func lexing_text_allocations(text: String) -> Option[Int]:
	reset_mem_stats()
	active_before = read_memory_counter(MemoryStatsActive) == 1 and read_memory_counter(OracleStatsActive) == 1
	lexed: LexedModule = lex_module(module_id_at_row(0), text)
	allocations = read_memory_counter(ManagedAllocations)

	if (
		active_before and read_memory_counter(MemoryStatsActive) == 1
		and read_memory_counter(OracleStatsActive) == 1
		and allocations > 0 and lexed.tokens.length() > REPEATS
	):
		Some(allocations)
	else:
		None


---
The allocations lexing `item` repeated `REPEATS` times made.
---
func lexing_allocations(item: String) -> Option[Int]:
	var text: String = ""

	for index in 0..REPEATS:
		text += item

	lexing_text_allocations(text)


---
Whether lexing `item` repeated `REPEATS` times made exactly `expected_allocations`.
For the pins that are one known cause per word and nothing else: a count that
moves either way is worth a look, so there is no tolerance.
---
func allocates_exactly(item: String, expected_allocations: Int) -> Bool:
	match lexing_allocations(item):
		Some(actual):
			if actual != expected_allocations:
				print("lexer allocation pin ${item}: expected=${expected_allocations} actual=${actual}")

			actual == expected_allocations
		None:
			False


-- Exact current-bootstrap count; managed scanner/token products and list
-- growth are included. The measurement ledger records the per-repeat slope.
func test_name_interning_and_keyword_setup_allocations() -> Bool:
	allocates_exactly("foo bar baz\n", 16047) and allocates_exactly("if match func\n", 10035)


func test_symbols_allocate_managed_tokens_and_matches() -> Bool:
	allocates_exactly("( ) [ ] + -\n", 28036)


-- Exact current-bootstrap count; managed scanner/token products and list
-- growth are included. The measurement ledger records the per-repeat slope.
func test_layout_allocates_managed_tokens_and_name_results() -> Bool:
	allocates_exactly("if a:\n\tb\n", 24047)


-- Exact current-bootstrap count; managed scanner/token products and list
-- growth are included. The measurement ledger records the per-repeat slope.
func test_comments_and_blank_lines_allocate_managed_tokens_and_names() -> Bool:
	allocates_exactly("-- note\n\nx\n", 12040)


-- Exact current-bootstrap count; managed scanner/token products and list
-- growth are included. The measurement ledger records the per-repeat slope.
func test_a_new_spelling_allocates_its_text_and_a_table_copy() -> Bool:
	var text: String = ""

	for index in 0..REPEATS:
		text += "word" + index.to_string() + "\n"

	match lexing_text_allocations(text):
		Some(actual):
			if actual != 16034:
				print("lexer new spelling allocation pin: expected=16034 actual=${actual}")
			actual == 16034
		None:
			False


-- Exact current-bootstrap count; managed scanner/token products and list
-- growth are included. The measurement ledger records the per-repeat slope.
func test_integers_allocate_their_checked_value() -> Bool:
	allocates_exactly("1 22 333\n", 40047)


-- Exact current-bootstrap count; managed scanner/token products and list
-- growth are included. The measurement ledger records the per-repeat slope.
func test_floats_allocate_their_digits_and_value() -> Bool:
	allocates_exactly("1.5 2.25\n", 24046)


-- Exact current-bootstrap count; managed scanner/token products and list
-- growth are included. The measurement ledger records the per-repeat slope.
func test_strings_allocate_their_text_and_value() -> Bool:
	allocates_exactly("\"ab\" \"cd\"\n", 16046)


-- Exact current-bootstrap count; managed scanner/token products and list
-- growth are included. The measurement ledger records the per-repeat slope.
func test_dimension_names_allocate_managed_tokens_and_name_results() -> Bool:
	allocates_exactly("#N #M\n", 12043)


-- Exact current-bootstrap count; managed scanner/token products and list
-- growth are included. The measurement ledger records the per-repeat slope.
func test_raw_strings_allocate_per_literal() -> Bool:
	allocates_exactly("raw\"a\" raw\"b\"\n", 24046)


-- Exact current-bootstrap count; managed scanner/token products and list
-- growth are included. The measurement ledger records the per-repeat slope.
func test_character_literals_allocate_per_literal() -> Bool:
	allocates_exactly("'a' 'b'\n", 16035)


-- Exact current-bootstrap count; managed scanner/token products and list
-- growth are included. The measurement ledger records the per-repeat slope.
-- The `${` is split across two literals so this file does not interpolate it.
func test_interpolated_strings_allocate_their_pieces() -> Bool:
	allocates_exactly("\"a $" + "{b} c\"\n", 70044)


tests: TestSuite = {
	description = "Discovery lexer allocations",
	tests = [
		("name interning and keyword setup allocations", test_name_interning_and_keyword_setup_allocations),
		("symbols allocate managed tokens and matches", test_symbols_allocate_managed_tokens_and_matches),
		(
			"layout allocates managed tokens and name results",
			test_layout_allocates_managed_tokens_and_name_results,
		),
		(
			"comments and blank lines allocate managed tokens and names",
			test_comments_and_blank_lines_allocate_managed_tokens_and_names,
		),
		(
			"a new spelling allocates its text and a table copy",
			test_a_new_spelling_allocates_its_text_and_a_table_copy,
		),
		("integers allocate their checked value", test_integers_allocate_their_checked_value),
		("floats allocate their digits and value", test_floats_allocate_their_digits_and_value),
		("strings allocate their text and value", test_strings_allocate_their_text_and_value),
		(
			"dimension names allocate managed tokens and name results",
			test_dimension_names_allocate_managed_tokens_and_name_results,
		),
		("raw strings allocate per literal", test_raw_strings_allocate_per_literal),
		("character literals allocate per literal", test_character_literals_allocate_per_literal),
		(
			"interpolated strings allocate their pieces",
			test_interpolated_strings_allocate_their_pieces,
		),
	]
}
