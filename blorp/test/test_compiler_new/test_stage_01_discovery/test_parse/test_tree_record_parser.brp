-- Direct ordinary-record declaration leaf; caller already consumed `record`.
-- Expected API: parse_record(state, visibility, documentation, start)
--     -> (ParseState, RecordParse(ParsedRecord, RejectedRecord)).
import:
	../../../../src/compiler_new/stage_01_discovery/lex/lexer: lex_module
	../../../../src/compiler_new/stage_01_discovery/parse/parse_state:
		new_parse_state, advanced, current_kind, current_span, diagnostics, diagnostic_count, issued_counts, spellings
	../../../../src/compiler_new/stage_01_discovery/parse/tree_record_parser: parse_record, RecordParse(ParsedRecord, RejectedRecord)
	../../../../src/compiler_new/stage_01_discovery/syntax/declarations: TypeParameter(TypeVariable, DimensionVariable, WildcardDimensionParameter)
	../../../../src/compiler_new/stage_01_discovery/syntax/ids: definition_local_index, type_binder_local_index, name_use_local_index, written_type_local_index, dimension_local_index
	../../../../src/compiler_new/stage_01_discovery/syntax/module_syntax: Documentation
	../../../../src/compiler_new/stage_01_discovery/syntax/spellings: spelling_text
	../../../../src/compiler_new/stage_01_discovery/syntax/types: WrittenTypeKind(NamedType, ArrayType), DimensionKind(NamedDimension)
	../../../../src/compiler_new/stage_01_discovery/syntax/diagnostics: SyntaxDiagnostic(ExpectedToken, Plain, DuplicateField, ReservedKeywordAsName)
	../../../../src/compiler_new/stage_01_discovery/tables/diagnostic_code: PlainSyntaxCode(DimensionParameterBoundsDiagnostic, ExpectedTypeDiagnostic)
	../../../../src/compiler_new/stage_01_discovery/tables/expected_token:
		ExpectedTokenDiagnostic(ExpectedLeftBrace, ExpectedRightBrace, ExpectedRightBracket, ExpectedColon, ExpectedName),
		LeftBraceConstruct(LeftBraceInRecordFields), RightBraceConstruct(RightBraceInRecordFields),
		RightBracketConstruct(RightBracketInTypeParameters), ColonConstruct(ColonInFieldName), NameConstruct(NameInTypeName, NameInTraitName, NameInFieldName)
	../../../../src/compiler_new/stage_01_discovery/tables/ids: module_id_at_row
	../../../../src/compiler_new/stage_01_discovery/tables/row_kinds: Visibility(PublicVisibility, PrivateVisibility)
	../../../../src/compiler_new/stage_01_discovery/tables/span: Span, span_start, span_end, spans_equal
	../../../../src/compiler_new/stage_01_discovery/tables/token: TokenKind(IfKeyword, IdentifierToken, LeftBraceSymbol, LeftBracketSymbol, EndOfFileToken)
	test: TestSuite


private pure func covers(span: Span, start: Int, end: Int) -> Bool:
	span.span_start() == start and span.span_end() == end


pure func test_generic_record_mints_parameters_fields_and_record_in_order() -> Bool:
	text: String = "record Box[T: m.Eq + Hashable, #N, #_] { value: T, items: T[#N], } if"
	match new_parse_state(lex_module(module_id_at_row(3), text)):
		Ok(state):
			(parsed, result) = parse_record(state.advanced(), PublicVisibility, None, state.current_span())

			match result:
				ParsedRecord(value):
					match (value.type_parameters, value.fields):
						([TypeVariable(variable), DimensionVariable(dimension), WildcardDimensionParameter(wildcard)], [first, second]):
							match (variable.bounds, first.field_type.kind, second.field_type.kind):
								([qualified, bare], NamedType(first_use, []), ArrayType(base, dimensions)):
									match (qualified.qualifier, bare.qualifier, base.kind, dimensions.first.kind):
										(Some(qualifier), None, NamedType(base_use, []), NamedDimension(dimension_use)):
											(variable.binder.binder.type_binder_local_index() == 0
												and dimension.binder.type_binder_local_index() == 1
												and qualifier.use.name_use_local_index() == 0
												and qualified.trait_name.use.name_use_local_index() == 1
												and bare.trait_name.use.name_use_local_index() == 2
												and first_use.use.name_use_local_index() == 3
												and base_use.use.name_use_local_index() == 4
												and dimension_use.use.name_use_local_index() == 5
												and parsed.spellings().spelling_text(qualifier.name.spelling) == Some("m")
												and parsed.spellings().spelling_text(qualified.trait_name.name.spelling) == Some("Eq")
												and parsed.spellings().spelling_text(bare.trait_name.name.spelling) == Some("Hashable")
												and parsed.spellings().spelling_text(first_use.name.spelling) == Some("T")
												and parsed.spellings().spelling_text(base_use.name.spelling) == Some("T")
												and parsed.spellings().spelling_text(dimension_use.name.spelling) == Some("N")
												and variable.binder.name.span.covers(11, 12) and variable.span.covers(11, 29)
												and qualified.span.covers(14, 18) and bare.span.covers(21, 29)
												and dimension.name.span.covers(31, 33) and wildcard.covers(35, 37)
												and value.name.span.covers(7, 10) and value.span.covers(0, 66)
												and first.name.span.covers(41, 46) and first.span.covers(41, 49)
												and first.field_type.span.covers(48, 49)
												and second.name.span.covers(51, 56) and second.span.covers(51, 63)
												and second.field_type.span.covers(58, 63) and base.span.covers(58, 59)
												and dimensions.first.span.covers(60, 62) and dimensions.rest.is_empty()
												and first.id.definition_local_index() == 0 and second.id.definition_local_index() == 1
												and value.id.definition_local_index() == 2
												and first.field_type.id.written_type_local_index() == 0
												and base.id.written_type_local_index() == 1 and second.field_type.id.written_type_local_index() == 2
												and dimensions.first.id.dimension_local_index() == 0
												and parsed.issued_counts().type_binders == 2 and parsed.issued_counts().written_types == 3
												and value.visibility == PublicVisibility and value.documentation.is_none()
												and parsed.diagnostic_count() == 0 and parsed.current_kind() == IfKeyword
												and parsed.current_span().covers(67, 69))
										_:
											False
								_:
									False
						_:
							False
				_:
					False
		Err(_):
			False


private pure func empty_record(text: String) -> Bool:
	match new_parse_state(lex_module(module_id_at_row(0), text)):
		Ok(state):
			documentation: Documentation = { text = "An empty record.", span = state.current_span() }
			(parsed, result) = parse_record(state.advanced(), PrivateVisibility, Some(documentation), state.current_span())

			match result:
				ParsedRecord(value):
					match value.documentation:
						Some(doc):
							(value.type_parameters.is_empty() and value.fields.is_empty()
								and value.id.definition_local_index() == 0 and value.visibility == PrivateVisibility
								and value.name.span.covers(7, 12) and value.span.covers(0, text.length() - 3)
								and parsed.spellings().spelling_text(value.name.spelling) == Some("Empty")
								and doc.text == documentation.text and doc.span.spans_equal(documentation.span)
								and parsed.issued_counts().type_binders == 0 and parsed.issued_counts().written_types == 0
								and parsed.diagnostic_count() == 0 and parsed.current_kind() == IfKeyword
								and parsed.current_span().covers(text.length() - 2, text.length()))
						None:
							False
				_:
					False
		Err(_):
			False


pure func test_absent_and_written_empty_parameters_parse_and_preserve_metadata() -> Bool:
	-- RecordDeclaration intentionally stores the same empty parameter list in
	-- both cases; distinct source spans/cursors prove brackets were consumed.
	empty_record("record Empty {} if") and empty_record("record Empty[] {} if")


private union ExpectedDiagnostic:
	TokenDiagnostic(ExpectedTokenDiagnostic)
	PlainDiagnostic(PlainSyntaxCode)
	DuplicateFirstField


private pure func diagnostic_matches(actual: SyntaxDiagnostic, expected: ExpectedDiagnostic) -> Bool:
	match (actual, expected):
		(ExpectedToken(ExpectedLeftBrace(actual_construct)), TokenDiagnostic(ExpectedLeftBrace(expected_construct))):
			actual_construct == expected_construct
		(ExpectedToken(ExpectedRightBrace(actual_construct)), TokenDiagnostic(ExpectedRightBrace(expected_construct))):
			actual_construct == expected_construct
		(ExpectedToken(ExpectedRightBracket(actual_construct)), TokenDiagnostic(ExpectedRightBracket(expected_construct))):
			actual_construct == expected_construct
		(ExpectedToken(ExpectedColon(actual_construct)), TokenDiagnostic(ExpectedColon(expected_construct))):
			actual_construct == expected_construct
		(ExpectedToken(ExpectedName(actual_construct)), TokenDiagnostic(ExpectedName(expected_construct))):
			actual_construct == expected_construct
		(Plain(actual_code), PlainDiagnostic(expected_code)):
			actual_code == expected_code
		(DuplicateField(first), DuplicateFirstField):
			first.definition_local_index() == 0
		_:
			False


private pure func rejection_matches(text: String, expected: List[(ExpectedDiagnostic, Int, Int)], cursor: TokenKind, start: Int, end: Int) -> Bool:
	match new_parse_state(lex_module(module_id_at_row(0), text)):
		Ok(state):
			(parsed, result) = parse_record(state.advanced(), PublicVisibility, None, state.current_span())
			var correct: Bool = match result:
				RejectedRecord:
					True
				_:
					False
			correct = correct and parsed.diagnostic_count() == expected.length()
			var index: Int = 0

			for (diagnostic, diagnostic_start, diagnostic_end) in expected:
				match parsed.diagnostics().get(index):
					Some(at):
						correct = correct and diagnostic_matches(at.diagnostic, diagnostic) and at.span.covers(diagnostic_start, diagnostic_end)
					None:
						correct = False
				index = index + 1

			correct and parsed.current_kind() == cursor and parsed.current_span().covers(start, end)
		Err(_):
			False


-- Definition counts are not exposed by ParseState. Check rejection and
-- the exact public counts: only the parameter parser may have minted children.
private pure func rejected_parameters_mint_no_field_children(text: String, parameter_name_uses: Int) -> Bool:
	match new_parse_state(lex_module(module_id_at_row(0), text)):
		Ok(state):
			(parsed, result) = parse_record(state.advanced(), PublicVisibility, None, state.current_span())

			match result:
				RejectedRecord:
					(parsed.issued_counts().type_binders == 1 and parsed.issued_counts().written_types == 0
						and parsed.issued_counts().dimensions == 0 and parsed.issued_counts().name_uses == parameter_name_uses)
				_:
					False
		Err(_):
			False


pure func test_malformed_parameters_reject_without_entering_fields() -> Bool:
	(rejection_matches("record Box[T U] {} if", [(TokenDiagnostic(ExpectedRightBracket(RightBracketInTypeParameters)), 13, 13)], IdentifierToken, 13, 14)
		and rejection_matches("record Box[T", [(TokenDiagnostic(ExpectedRightBracket(RightBracketInTypeParameters)), 12, 12)], EndOfFileToken, 12, 12)
		and rejected_parameters_mint_no_field_children("record Box[T U] { value: Int } if", 0)
		and rejected_parameters_mint_no_field_children("record Box[T", 0))


pure func test_dimension_bounds_reject_with_parameter_diagnostics_in_order() -> Bool:
	(rejection_matches("record Box[#N: ] {} if", [
		(PlainDiagnostic(DimensionParameterBoundsDiagnostic), 13, 14),
		(TokenDiagnostic(ExpectedName(NameInTraitName)), 15, 15)
	], LeftBraceSymbol, 17, 18)
		and rejected_parameters_mint_no_field_children("record Box[#N: ] { value: Int } if", 1))


pure func test_duplicate_field_reports_after_its_type_diagnostic() -> Bool:
	(rejection_matches("record Box { x: Int, x: , } if", [
		(PlainDiagnostic(ExpectedTypeDiagnostic), 24, 24), (DuplicateFirstField, 21, 22)
	], IfKeyword, 28, 30)
		and rejection_matches("record Box { x: Int, x: Bool } if", [(DuplicateFirstField, 21, 22)], IfKeyword, 31, 33))


pure func test_missing_braces_use_ordinary_record_constructs() -> Bool:
	(rejection_matches("record Box if", [(TokenDiagnostic(ExpectedLeftBrace(LeftBraceInRecordFields)), 11, 11)], IfKeyword, 11, 13)
		and rejection_matches("record Box { x: Int if", [(TokenDiagnostic(ExpectedRightBrace(RightBraceInRecordFields)), 20, 20)], IfKeyword, 20, 22)
		and rejection_matches("record Box { x: Int", [(TokenDiagnostic(ExpectedRightBrace(RightBraceInRecordFields)), 19, 19)], EndOfFileToken, 19, 19))


pure func test_missing_colon_and_comma_preserve_recovery_cursor() -> Bool:
	(rejection_matches("record Box { x Int } if", [(TokenDiagnostic(ExpectedColon(ColonInFieldName)), 15, 15)], IfKeyword, 21, 23)
		and rejection_matches("record Box { x: Int y: Bool } if", [(TokenDiagnostic(ExpectedRightBrace(RightBraceInRecordFields)), 20, 20)], IdentifierToken, 20, 21))


pure func test_missing_names_reject_without_diagnostic_cascades() -> Bool:
	(rejection_matches("record {} if", [(TokenDiagnostic(ExpectedName(NameInTypeName)), 7, 7)], LeftBraceSymbol, 7, 8)
		and rejection_matches("record Box { : Int } if", [(TokenDiagnostic(ExpectedName(NameInFieldName)), 13, 13)], IfKeyword, 21, 23))


pure func test_reserved_record_name_rejects_before_parameters() -> Bool:
	match new_parse_state(lex_module(module_id_at_row(0), "record if[T] {}")):
		Ok(state):
			(parsed, result) = parse_record(state.advanced(), PublicVisibility, None, state.current_span())

			match (result, parsed.diagnostics()):
				(RejectedRecord, [at]):
					match at.diagnostic:
						ReservedKeywordAsName(name):
							(at.span.covers(7, 7) and parsed.spellings().spelling_text(name) == Some("if")
								and parsed.current_kind() == LeftBracketSymbol and parsed.current_span().covers(9, 10) and parsed.issued_counts().type_binders == 0
								and parsed.issued_counts().written_types == 0)
						_:
							False
				_:
					False
		Err(_):
			False


pure func test_dimension_record_name_rejects_before_fields() -> Bool:
	rejection_matches("record #Box {} if", [(TokenDiagnostic(ExpectedName(NameInTypeName)), 7, 7)], LeftBraceSymbol, 12, 13)


pure func test_soft_keyword_record_and_field_names_are_preserved() -> Bool:
	match new_parse_state(lex_module(module_id_at_row(0), "record debug { debug: Int } if")):
		Ok(state):
			(parsed, result) = parse_record(state.advanced(), PublicVisibility, None, state.current_span())

			match result:
				ParsedRecord(value):
					match value.fields:
						[field]:
							(parsed.spellings().spelling_text(value.name.spelling) == Some("debug")
								and parsed.spellings().spelling_text(field.name.spelling) == Some("debug")
								and value.name.span.covers(7, 12) and field.name.span.covers(15, 20)
								and field.id.definition_local_index() == 0 and value.id.definition_local_index() == 1
								and value.type_parameters.is_empty() and parsed.diagnostic_count() == 0
								and parsed.current_kind() == IfKeyword and parsed.current_span().covers(28, 30))
						_:
							False
				_:
					False
		Err(_):
			False


tests: TestSuite = {
	description = "Direct tree ordinary record declaration leaf",
	tests = [
		("reserved record name rejects before parameters", test_reserved_record_name_rejects_before_parameters),
		("dimension record name rejects before fields", test_dimension_record_name_rejects_before_fields),
		("soft keyword record and field names are preserved", test_soft_keyword_record_and_field_names_are_preserved),
		("generic record mints parameters fields and record in order", test_generic_record_mints_parameters_fields_and_record_in_order),
		("absent and written empty parameters preserve metadata", test_absent_and_written_empty_parameters_parse_and_preserve_metadata),
		("malformed parameters reject without entering fields", test_malformed_parameters_reject_without_entering_fields),
		("dimension bounds reject with ordered parameter diagnostics", test_dimension_bounds_reject_with_parameter_diagnostics_in_order),
		("duplicate field reports after its type diagnostic", test_duplicate_field_reports_after_its_type_diagnostic),
		("missing braces use ordinary record constructs", test_missing_braces_use_ordinary_record_constructs),
		("missing colon and comma preserve recovery cursor", test_missing_colon_and_comma_preserve_recovery_cursor),
		("missing names reject without diagnostic cascades", test_missing_names_reject_without_diagnostic_cascades)
	]
}
