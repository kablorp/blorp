-- Direct alias declaration leaf; caller consumed only `type` or `opaque`.
import:
	../../../../src/compiler_new/stage_01_discovery/lex/lexer: lex_module
	../../../../src/compiler_new/stage_01_discovery/parse/parse_state: new_parse_state, advanced, current_kind, current_span, diagnostics, diagnostic_count, issued_counts, spellings
	../../../../src/compiler_new/stage_01_discovery/parse/tree_alias_parser: parse_alias, AliasParse(ParsedAlias, RejectedAlias)
	../../../../src/compiler_new/stage_01_discovery/syntax/declarations: AliasForm(TransparentAlias, OpaqueAlias), TypeParameter(TypeVariable, DimensionVariable, WildcardDimensionParameter)
	../../../../src/compiler_new/stage_01_discovery/syntax/ids: definition_local_index, type_binder_local_index, name_use_local_index, written_type_local_index, dimension_local_index
	../../../../src/compiler_new/stage_01_discovery/syntax/module_syntax: Documentation
	../../../../src/compiler_new/stage_01_discovery/syntax/spellings: spelling_text
	../../../../src/compiler_new/stage_01_discovery/syntax/types: WrittenTypeKind(NamedType, ArrayType), DimensionKind(NamedDimension)
	../../../../src/compiler_new/stage_01_discovery/syntax/diagnostics: SyntaxDiagnostic(ExpectedToken, Plain, ReservedKeywordAsName)
	../../../../src/compiler_new/stage_01_discovery/tables/diagnostic_code: PlainSyntaxCode(DimensionParameterBoundsDiagnostic, ExpectedTypeDiagnostic)
	../../../../src/compiler_new/stage_01_discovery/tables/expected_token:
		ExpectedTokenDiagnostic(ExpectedKeyword, ExpectedEqual, ExpectedName, ExpectedRightBracket),
		KeywordConstruct(KeywordInTypeAliasKeyword, KeywordInOpaqueType), EqualConstruct(EqualInTypeAliasTarget),
		NameConstruct(NameInTypeAliasName, NameInTraitName), RightBracketConstruct(RightBracketInTypeParameters, RightBracketInTypeArguments)
	../../../../src/compiler_new/stage_01_discovery/tables/ids: module_id_at_row
	../../../../src/compiler_new/stage_01_discovery/tables/row_kinds: Visibility(PublicVisibility, PrivateVisibility)
	../../../../src/compiler_new/stage_01_discovery/tables/span: Span, span_start, span_end, spans_equal
	../../../../src/compiler_new/stage_01_discovery/tables/token: TokenKind(IfKeyword, IdentifierToken, EqualSymbol, LeftBracketSymbol, EndOfFileToken)
	test: TestSuite


private pure func covers(span: Span, start: Int, end: Int) -> Bool:
	span.span_start() == start and span.span_end() == end


private pure func generic_alias(text: String, form: AliasForm, offset: Int) -> Bool:
	match new_parse_state(lex_module(module_id_at_row(3), text)):
		Ok(state):
			(parsed, result) = parse_alias(state.advanced(), PublicVisibility, None, state.current_span(), form)

			match result:
				ParsedAlias(value):
					match (value.type_parameters, value.target.kind):
						([TypeVariable(variable), DimensionVariable(dimension), WildcardDimensionParameter(wildcard)], ArrayType(base, dimensions)):
							match (variable.bounds, base.kind, dimensions.first.kind):
								([qualified, bare], NamedType(base_use, []), NamedDimension(dimension_use)):
									match (qualified.qualifier, bare.qualifier):
										(Some(qualifier), None):
											(value.form == form and value.id.definition_local_index() == 0
												and variable.binder.binder.type_binder_local_index() == 0 and dimension.binder.type_binder_local_index() == 1
												and qualifier.use.name_use_local_index() == 0 and qualified.trait_name.use.name_use_local_index() == 1
												and bare.trait_name.use.name_use_local_index() == 2 and base_use.use.name_use_local_index() == 3
												and dimension_use.use.name_use_local_index() == 4
												and base.id.written_type_local_index() == 0 and value.target.id.written_type_local_index() == 1
												and dimensions.first.id.dimension_local_index() == 0 and dimensions.rest.is_empty()
												and parsed.spellings().spelling_text(value.name.spelling) == Some("Buffer")
												and parsed.spellings().spelling_text(qualifier.name.spelling) == Some("m")
												and parsed.spellings().spelling_text(qualified.trait_name.name.spelling) == Some("Eq")
												and parsed.spellings().spelling_text(bare.trait_name.name.spelling) == Some("Hashable")
												and parsed.spellings().spelling_text(base_use.name.spelling) == Some("T")
												and parsed.spellings().spelling_text(dimension_use.name.spelling) == Some("N")
												and value.name.span.covers(11 + offset, 17 + offset) and value.span.covers(0, 53 + offset)
												and variable.binder.name.span.covers(18 + offset, 19 + offset) and variable.span.covers(18 + offset, 36 + offset)
												and qualifier.name.span.covers(21 + offset, 22 + offset)
												and qualified.trait_name.name.span.covers(23 + offset, 25 + offset)
												and qualified.span.covers(21 + offset, 25 + offset) and bare.span.covers(28 + offset, 36 + offset)
												and dimension.name.span.covers(38 + offset, 40 + offset) and wildcard.covers(42 + offset, 44 + offset)
												and base.span.covers(48 + offset, 49 + offset) and value.target.span.covers(48 + offset, 53 + offset)
												and dimensions.first.span.covers(50 + offset, 52 + offset)
												and parsed.issued_counts().type_binders == 2 and parsed.issued_counts().name_uses == 5
												and parsed.issued_counts().written_types == 2 and parsed.issued_counts().dimensions == 1
												and value.visibility == PublicVisibility and value.documentation.is_none()
												and parsed.diagnostic_count() == 0 and parsed.current_kind() == IfKeyword
												and parsed.current_span().covers(54 + offset, 56 + offset))
										_:
											False
								_:
									False
						_:
							False
				_:
					False
		Err(_):
			False


pure func test_both_forms_mint_parameters_then_target_then_alias() -> Bool:
	(generic_alias("type alias Buffer[T: m.Eq + Hashable, #N, #_] = T[#N] if", TransparentAlias, 0)
		and generic_alias("opaque type Buffer[T: m.Eq + Hashable, #N, #_] = T[#N] if", OpaqueAlias, 1))


private pure func simple_alias(text: String, form: AliasForm) -> Bool:
	match new_parse_state(lex_module(module_id_at_row(0), text)):
		Ok(state):
			documentation: Documentation = { text = "An alias.", span = state.current_span() }
			(parsed, result) = parse_alias(state.advanced(), PrivateVisibility, Some(documentation), state.current_span(), form)

			match result:
				ParsedAlias(value):
					match value.documentation:
						Some(doc):
							(value.form == form and value.visibility == PrivateVisibility and value.type_parameters.is_empty()
								and doc.text == documentation.text and doc.span.spans_equal(documentation.span)
								and value.id.definition_local_index() == 0 and value.span.covers(0, text.length() - 3)
								and parsed.issued_counts().type_binders == 0 and parsed.diagnostic_count() == 0
								and parsed.current_kind() == IfKeyword and parsed.current_span().covers(text.length() - 2, text.length()))
						None:
							False
				_:
					False
		Err(_):
			False


pure func test_absent_and_written_empty_parameters_preserve_metadata() -> Bool:
	(simple_alias("type alias Empty = () if", TransparentAlias) and simple_alias("type alias Empty[] = () if", TransparentAlias)
		and simple_alias("opaque type Empty = () if", OpaqueAlias) and simple_alias("opaque type Empty[] = () if", OpaqueAlias))


pure func test_target_shapes_end_at_trailing_keyword() -> Bool:
	(simple_alias("type alias A = m.Value if", TransparentAlias)
		and simple_alias("type alias A = List[Int] if", TransparentAlias)
		and simple_alias("type alias A = pure (Int) -> Bool if", TransparentAlias)
		and simple_alias("type alias A = (Int, Bool) if", TransparentAlias)
		and simple_alias("type alias A = ..#3 if", TransparentAlias))


private union ExpectedDiagnostic:
	TokenDiagnostic(ExpectedTokenDiagnostic)
	PlainDiagnostic(PlainSyntaxCode)


private pure func diagnostic_matches(actual: SyntaxDiagnostic, expected: ExpectedDiagnostic) -> Bool:
	match (actual, expected):
		(ExpectedToken(ExpectedKeyword(actual_construct)), TokenDiagnostic(ExpectedKeyword(expected_construct))):
			actual_construct == expected_construct
		(ExpectedToken(ExpectedEqual(actual_construct)), TokenDiagnostic(ExpectedEqual(expected_construct))):
			actual_construct == expected_construct
		(ExpectedToken(ExpectedName(actual_construct)), TokenDiagnostic(ExpectedName(expected_construct))):
			actual_construct == expected_construct
		(ExpectedToken(ExpectedRightBracket(actual_construct)), TokenDiagnostic(ExpectedRightBracket(expected_construct))):
			actual_construct == expected_construct
		(Plain(actual_code), PlainDiagnostic(expected_code)):
			actual_code == expected_code
		_:
			False


private pure func rejection_matches(text: String, form: AliasForm, expected: List[(ExpectedDiagnostic, Int, Int)], cursor: TokenKind, start: Int, end: Int, types: Int) -> Bool:
	match new_parse_state(lex_module(module_id_at_row(0), text)):
		Ok(state):
			(parsed, result) = parse_alias(state.advanced(), PublicVisibility, None, state.current_span(), form)
			var correct: Bool = match result:
				RejectedAlias:
					True
				_:
					False
			correct = correct and parsed.diagnostic_count() == expected.length()
			var index: Int = 0

			for (diagnostic, diagnostic_start, diagnostic_end) in expected:
				match parsed.diagnostics().get(index):
					Some(at):
						correct = correct and diagnostic_matches(at.diagnostic, diagnostic) and at.span.covers(diagnostic_start, diagnostic_end)
					None:
						correct = False
				index = index + 1

			(correct and parsed.current_kind() == cursor and parsed.current_span().covers(start, end)
				and parsed.issued_counts().written_types == types)
		Err(_):
			False


pure func test_missing_second_keyword_uses_form_specific_construct_and_continues() -> Bool:
	(rejection_matches("type Buffer = Int if", TransparentAlias, [(TokenDiagnostic(ExpectedKeyword(KeywordInTypeAliasKeyword)), 5, 5)], IfKeyword, 18, 20, 1)
		and rejection_matches("opaque Buffer = Int if", OpaqueAlias, [(TokenDiagnostic(ExpectedKeyword(KeywordInOpaqueType)), 7, 7)], IfKeyword, 20, 22, 1))


pure func test_missing_name_rejects_before_target() -> Bool:
	rejection_matches("type alias [T] = Int if", TransparentAlias, [(TokenDiagnostic(ExpectedName(NameInTypeAliasName)), 11, 11)], LeftBracketSymbol, 11, 12, 0)


pure func test_reserved_name_rejects_before_parameters() -> Bool:
	match new_parse_state(lex_module(module_id_at_row(0), "type alias if[T] = Int")):
		Ok(state):
			(parsed, result) = parse_alias(state.advanced(), PublicVisibility, None, state.current_span(), TransparentAlias)

			match (result, parsed.diagnostics()):
				(RejectedAlias, [at]):
					match at.diagnostic:
						ReservedKeywordAsName(name):
							(at.span.covers(11, 11) and parsed.spellings().spelling_text(name) == Some("if")
								and parsed.current_kind() == LeftBracketSymbol and parsed.current_span().covers(13, 14)
								and parsed.issued_counts().type_binders == 0 and parsed.issued_counts().written_types == 0)
						_:
							False
				_:
					False
		Err(_):
			False


pure func test_malformed_parameters_reject_before_target() -> Bool:
	(rejection_matches("type alias A[T U] = Int if", TransparentAlias, [(TokenDiagnostic(ExpectedRightBracket(RightBracketInTypeParameters)), 15, 15)], IdentifierToken, 15, 16, 0)
		and rejection_matches("type alias A[T", TransparentAlias, [(TokenDiagnostic(ExpectedRightBracket(RightBracketInTypeParameters)), 14, 14)], EndOfFileToken, 14, 14, 0)
		and rejection_matches("type alias A[#N: ] = Int if", TransparentAlias, [
			(PlainDiagnostic(DimensionParameterBoundsDiagnostic), 15, 16),
			(TokenDiagnostic(ExpectedName(NameInTraitName)), 17, 17)
		], EqualSymbol, 19, 20, 0))


pure func test_missing_equal_parses_target_before_rejecting_declaration() -> Bool:
	rejection_matches("type alias A Int if", TransparentAlias, [(TokenDiagnostic(ExpectedEqual(EqualInTypeAliasTarget)), 13, 13)], IfKeyword, 17, 19, 1)


pure func test_missing_and_malformed_target_preserve_type_recovery() -> Bool:
	(rejection_matches("type alias A =", TransparentAlias, [(PlainDiagnostic(ExpectedTypeDiagnostic), 14, 14)], EndOfFileToken, 14, 14, 1)
		and rejection_matches("type alias A = if", TransparentAlias, [(PlainDiagnostic(ExpectedTypeDiagnostic), 15, 15)], EndOfFileToken, 17, 17, 1)
		and rejection_matches("type alias A = List[Int if", TransparentAlias, [(TokenDiagnostic(ExpectedRightBracket(RightBracketInTypeArguments)), 24, 24)], IfKeyword, 24, 26, 2))


pure func test_unexpected_trailing_name_remains_untouched() -> Bool:
	match new_parse_state(lex_module(module_id_at_row(0), "type alias A = Int surplus")):
		Ok(state):
			(parsed, result) = parse_alias(state.advanced(), PublicVisibility, None, state.current_span(), TransparentAlias)

			match result:
				ParsedAlias(value):
					(value.span.covers(0, 18) and parsed.diagnostic_count() == 0
						and parsed.current_kind() == IdentifierToken and parsed.current_span().covers(19, 26))
				_:
					False
		Err(_):
			False


tests: TestSuite = {
	description = "Direct tree alias declaration leaf",
	tests = [
		("both forms mint parameters then target then alias", test_both_forms_mint_parameters_then_target_then_alias),
		("absent and written empty parameters preserve metadata", test_absent_and_written_empty_parameters_preserve_metadata),
		("target shapes end at trailing keyword", test_target_shapes_end_at_trailing_keyword),
		("missing second keyword uses form specific construct and continues", test_missing_second_keyword_uses_form_specific_construct_and_continues),
		("missing name rejects before target", test_missing_name_rejects_before_target),
		("reserved name rejects before parameters", test_reserved_name_rejects_before_parameters),
		("malformed parameters reject before target", test_malformed_parameters_reject_before_target),
		("missing equal parses target before rejecting declaration", test_missing_equal_parses_target_before_rejecting_declaration),
		("missing and malformed target preserve type recovery", test_missing_and_malformed_target_preserve_type_recovery),
		("unexpected trailing name remains untouched", test_unexpected_trailing_name_remains_untouched)
	]
}
