-- RUN-BLORP-CHECK
-- EXPECT-BLORP: error: a bound cannot be written inside a type
-- EXPECT-BLORP: help: declare the type parameter with its bounds in brackets, such as `func show[T: Equatable](x: T)`
-- EXPECT-BLORP-CONTAINS: :7:19: error:
-- EXPECT-DISCOVERY: BoundInTypeDiagnostic 7:19
-- A bound belongs on a declared type parameter, not on the parameter's type
func same(value: (T: Equatable)) -> Bool:
	value == value
