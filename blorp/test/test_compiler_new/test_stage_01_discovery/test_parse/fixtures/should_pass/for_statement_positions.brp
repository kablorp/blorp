-- A `for` is a statement wherever a statement may stand, including the last
-- one of a block, a branch or an arm. Only a position that needs a value
-- rejects it.
func each(items: List[Int], flag: Bool, choice: Option[Int]) -> Void:
	if flag:
		for item in items:
			print(item)
	else:
		for item in items concurrently(limit: 2):
			print(item)

	match choice:
		Some(count):
			for index in 0..count:
				print(index)
		None:
			void

	run = func(values: List[Int]):
		for value in values:
			print(value)
	run(items)

	for (index, item) in enumerate(items):
		print(index + item)
