-- Trait references through an import alias, in every position that names a
-- trait in a list: type parameter bounds, an impl's inline bounds and
-- supertraits. The alias is resolved after discovery, so the module need not exist.
pure func total_area[T: shapes.Shape + Equatable](first: T, second: T) -> Int:
	0


record Box[T: shapes.Shape] {
	value: T
}


implements Showable for Box[T: shapes.Shape + Equatable]:
	pure func show(b: Box[T]) -> String:
		"box"


trait Measured: shapes.Shape + Stringable:
	pure func name(self: Self) -> String
