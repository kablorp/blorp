-- A forward declaration is a header with a colon and no body, before or after
-- the function of the same name that has the body.
func twice(f: (Int) -> Int, x: Int) -> Int:
pure func twice(f: pure (Int) -> Int, x: Int) -> Int:
	f(f(x))


pure func thrice(f: pure (Int) -> Int, x: Int) -> Int:
	f(f(f(x)))
func thrice(f: (Int) -> Int, x: Int) -> Int:
