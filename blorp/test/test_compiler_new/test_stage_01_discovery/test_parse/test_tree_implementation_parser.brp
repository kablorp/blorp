-- A single frozen declaration call includes top-level prefix recovery.
-- An implementation reads each method in full, then mints itself last.
import:
	../../../../src/compiler_new/stage_01_discovery/lex/lexer: lex_module
	../../../../src/compiler_new/stage_01_discovery/parse/parse_state: ParseState, new_parse_state, advanced, current_kind, current_span, position, diagnostics, diagnostic_count, issued_counts, spellings, report_at_current, finished_builtin_type, consume_declared_name
	../../../../src/compiler_new/stage_01_discovery/parse/tree_implementation_parser: ImplementationParse(ParsedImplementation, RejectedImplementation, DeclinedImplementation), parse_implementation
	../../../../src/compiler_new/stage_01_discovery/parse/stop_reason: StopReason(OpaqueConversion)
	../../../../src/compiler_new/stage_01_discovery/parse/tree_declaration_prefix_parser: parse_declaration_prefix
	../../../../src/compiler_new/stage_01_discovery/parse/declaration_parser: parse_declaration
	../../../../src/compiler_new/stage_01_discovery/parse/lexed_bridge: bridge_lexed_module
	../../../../src/compiler_new/stage_01_discovery/parse/parser_cursor as FrozenCursor
	../../../../src/compiler_new/stage_01_discovery/sources/source_admission: admit_source
	../../../../src/compiler_new/stage_01_discovery/tables/builder: DiscoveryBuilder, empty_discovery_builder
	../../../../src/compiler_new/stage_01_discovery/tables/diagnostic_code as FrozenDiagnostics
	../../../../src/compiler_new/stage_01_discovery/syntax/diagnostics as TreeDiagnostics
	../../../../src/compiler_new/stage_01_discovery/syntax/declarations: ParameterBinding(NamedParameter)
	../../../../src/compiler_new/stage_01_discovery/syntax/types: WrittenType, WrittenTypeKind(NamedType, BoundedType, FunctionType), TypeArgument(TypeArgumentType, BoundedArgument, DimensionArgument)
	../../../../src/compiler_new/stage_01_discovery/syntax/spellings: spelling_text
	../../../../src/compiler_new/stage_01_discovery/syntax/ids: definition_local_index, type_binder_local_index, name_use_local_index, binder_local_index, written_type_local_index, dimension_local_index
	../../../../src/compiler_new/stage_01_discovery/tables/expected_token: ExpectedTokenDiagnostic(ExpectedName, ExpectedColon, ExpectedRightBracket, ExpectedRightParen, ExpectedNewline, ExpectedIndent, ExpectedKeyword, ExpectedLeftParen, ExpectedArrow), NameConstruct(NameInTraitName)
	../../../../src/compiler_new/stage_01_discovery/tables/ids: module_id_at_row, name_id_index
	../../../../src/compiler_new/stage_01_discovery/tables/row_kinds: Visibility(PublicVisibility, PrivateVisibility), Purity(PureFunction, ImpureFunction)
