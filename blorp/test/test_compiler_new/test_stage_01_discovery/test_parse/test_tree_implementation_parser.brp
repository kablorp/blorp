	test: TestSuite


private pure func covers(span: Span, first: Int, last: Int) -> Bool:
	span.span_start() == first and span.span_end() == last


private pure func frozen(text: String) -> DiscoveryBuilder:
	lexed = lex_module(module_id_at_row(0), text)
	prepared = empty_discovery_builder().admit_source("implementation.brp", text).bridge_lexed_module(lexed)
	parse_declaration(prepared, module_id_at_row(0))


private pure func expected_token_matches(actual: ExpectedTokenDiagnostic, wanted: ExpectedTokenDiagnostic) -> Bool:
	match (actual, wanted):
		(ExpectedName(actual), ExpectedName(wanted)):
			actual == wanted
		(ExpectedColon(actual), ExpectedColon(wanted)):
			actual == wanted
		(ExpectedRightBracket(actual), ExpectedRightBracket(wanted)):
			actual == wanted
		(ExpectedRightParen(actual), ExpectedRightParen(wanted)):
			actual == wanted
		(ExpectedNewline(actual), ExpectedNewline(wanted)):
			actual == wanted
		(ExpectedIndent(actual), ExpectedIndent(wanted)):
			actual == wanted
		(ExpectedKeyword(actual), ExpectedKeyword(wanted)):
			actual == wanted
		(ExpectedLeftParen(actual), ExpectedLeftParen(wanted)):
			actual == wanted
		(ExpectedArrow(actual), ExpectedArrow(wanted)):
			actual == wanted
		_:
			False


private pure func matches_frozen(state: ParseState, reference: DiscoveryBuilder) -> Bool:
	var correct: Bool = (state.diagnostic_count() == reference.diagnostics.length() and state.position() == reference.token_cursor
		and state.current_kind() == FrozenCursor.current_kind(reference) and state.current_span().spans_equal(FrozenCursor.current_span(reference)))
	for (actual, wanted) in state.diagnostics().zip(reference.diagnostics):
		correct = correct and actual.span.spans_equal(wanted.span)
		match (actual.diagnostic, wanted.diagnostic):
			(TreeDiagnostics.Plain(actual), FrozenDiagnostics.Plain(wanted)):
				correct = correct and actual == wanted
			(TreeDiagnostics.ExpectedToken(actual), FrozenDiagnostics.ExpectedToken(wanted)):
				correct = correct and expected_token_matches(actual, wanted)
			(TreeDiagnostics.ReservedKeywordAsName(actual), FrozenDiagnostics.ReservedKeywordAsName(wanted)):
				correct = correct and state.spellings().spelling_text(actual) == reference.name_spellings.get(wanted.name_id_index())
			(TreeDiagnostics.UnknownAnnotation(actual), FrozenDiagnostics.UnknownAnnotation(wanted)):
				correct = correct and state.spellings().spelling_text(actual) == reference.name_spellings.get(wanted.name_id_index())
			_:
				-- Exact variant/construct/order/span parity; no code-name normalization.
				correct = False
	correct


-- No method body, statement or pattern was minted.
private pure func no_bodies(state: ParseState) -> Bool:
	counts = state.issued_counts()
	counts.expressions == 0 and counts.blocks == 0 and counts.statements == 0 and counts.patterns == 0


-- The mint issued exactly `count` definitions.
private pure func definitions_issued(state: ParseState, count: Int) -> Bool:
	match new_parse_state(lex_module(module_id_at_row(0), "witness")):
		Ok(witness_state):
			(_, name) = witness_state.consume_declared_name(NameInTraitName)
			match name:
				Some(name):
					(_, witness) = state.finished_builtin_type(PublicVisibility, None, name, [], name.span)
					witness.id.definition_local_index() == count
				None:
					False
		Err(_):
			False


-- Direct owner tolerates existing diagnostics; composition rejects its own delta.
private pure func composed(text: String) -> Option[(ParseState, ImplementationParse)]:
	match new_parse_state(lex_module(module_id_at_row(0), text)):
		Ok(state):
			before: Int = state.diagnostic_count()
			(after_prefix, prefix) = parse_declaration_prefix(state)
			(parsed, result) = parse_implementation(after_prefix, prefix.visibility, prefix.documentation, prefix.start)
			if parsed.diagnostic_count() != before:
				Some((parsed, RejectedImplementation))
			else:
				Some((parsed, result))
		Err(_):
			None


private pure func accepted(text: String, method_names: List[String]) -> Bool:
	reference = frozen(text)
	match composed(text):
		Some((parsed, ParsedImplementation(preview))):
			match (reference.definitions.get(0), reference.impls.get(0)):
				(Some(owner), Some(implementation)):
					var correct: Bool = (matches_frozen(parsed, reference) and parsed.diagnostic_count() == 0
						and preview.span.spans_equal(owner.span) and preview.trait_name.name.span.spans_equal(implementation.trait_span)
						and preview.methods.length() == method_names.length() and definitions_issued(parsed, method_names.length() + 1)
						and preview.id.definition_local_index() == method_names.length())
					for (method, name) in preview.methods.zip(method_names):
						correct = correct and parsed.spellings().spelling_text(method.function.signature.name.spelling) == Some(name)
						correct = correct and method.function.body.is_some()
					correct
				_:
					False
		_:
			False


private pure func rejected(text: String) -> Bool:
	match composed(text):
		Some((parsed, RejectedImplementation)):
			matches_frozen(parsed, frozen(text)) and parsed.diagnostic_count() > 0 and no_bodies(parsed)
		_:
			False


private pure func rich_receiver_ids(receiver: WrittenType) -> Bool:
	match receiver.kind:
		NamedType(_, [BoundedArgument(bound), TypeArgumentType(unbounded), DimensionArgument(dimension)]):
			match (bound.bounds.rest.get(0), unbounded.kind):
				(Some(qualified), NamedType(unbounded_name, [])):
					match qualified.qualifier:
						Some(qualifier):
							(qualifier.use.name_use_local_index() == 4 and qualified.trait_name.use.name_use_local_index() == 5
								and unbounded_name.use.name_use_local_index() == 6 and dimension.id.dimension_local_index() == 0)
						None:
							False
				_:
					False
		_:
			False


pure func test_private_documented_bounded_receiver_and_two_methods_keep_child_ids() -> Bool:
	text: String = "---\nDoc\n---\nprivate implements Eq for Box[T: Eq + mm.Hash,U,#N]:\n\tfunc f(x: T) -> U: x\n\tpure func g(y: U) -> T: y\nnext"
	match composed(text):
		Some((parsed, ParsedImplementation(preview))):
			match (preview.documentation, preview.receiver.kind, preview.methods):
				(Some(doc), NamedType(box, [BoundedArgument(bound), TypeArgumentType(unbounded), DimensionArgument(_)]), [first, second]):
					match (first.function.signature.parameters, second.function.signature.parameters, first.function.signature.return_type, second.function.signature.return_type):
						([x], [y], Some(first_return), Some(second_return)):
							match (x.binding, y.binding, x.declared_type, y.declared_type):
								(NamedParameter(x_name), NamedParameter(y_name), Some(x_type), Some(y_type)):
									(accepted(text, ["f", "g"]) and preview.visibility == PrivateVisibility and doc.text == "Doc" and doc.span.covers(0, 12)
										and preview.keyword.covers(20, 30) and preview.trait_name.use.name_use_local_index() == 0 and box.use.name_use_local_index() == 1
										and bound.parameter.use.name_use_local_index() == 2 and bound.bounds.rest.length() == 1 and bound.bounds.first.trait_name.use.name_use_local_index() == 3 and unbounded.id.written_type_local_index() == 0
										and rich_receiver_ids(preview.receiver) and preview.receiver.id.written_type_local_index() == 1 and x_type.id.written_type_local_index() == 2 and first_return.id.written_type_local_index() == 3
										and y_type.id.written_type_local_index() == 4 and second_return.id.written_type_local_index() == 5
										and x_name.binder.binder_local_index() == 0 and y_name.binder.binder_local_index() == 1
										and first.function.signature.purity == ImpureFunction and second.function.signature.purity == PureFunction
										and first.span.covers(66, 86) and second.span.covers(88, 113)
										and first.function.body.is_some() and second.function.body.is_some() and parsed.issued_counts().expressions == 2
										and preview.span.covers(0, 114) and parsed.current_kind() == IdentifierToken and parsed.current_span().covers(114, 118)
										and parsed.issued_counts().written_types == 6 and parsed.issued_counts().name_uses == 14 and parsed.issued_counts().dimensions == 1
										and parsed.issued_counts().type_binders == 0 and parsed.issued_counts().binders == 2)
								_:
									False
						_:
							False
				_:
					False
		_:
			False


pure func test_empty_region_owns_dedent_and_preserves_sibling() -> Bool:
	text: String = "implements Eq for Int:\n\t\nnext"
	-- Blank lines do not manufacture an IndentToken: pin the resulting layout
	-- recovery rather than treating a visually indented blank as an empty region.
	(rejected(text) and rejected("implements Eq for Int:\nnext") and rejected("implements Eq for Int:\n"))


pure func test_grouped_bounded_and_function_receivers_are_owner_types() -> Bool:
	(accepted("implements Eq for (T: Eq):\n\tfunc f(): 1\nnext", ["f"])
		and accepted("implements Eq for (Box[T: Eq]):\n\tfunc f(): 1\nnext", ["f"])
		and accepted("implements Eq for () -> (T: Eq):\n\tfunc f(): 1\nnext", ["f"])
		and accepted("implements Eq for pure (T: Eq) -> Int:\n\tfunc f(): 1\nnext", ["f"]))


pure func test_punctuation_and_layout_omissions_follow_frozen_order() -> Bool:
	(rejected("implements Eq Int:") and rejected("implements Eq for Int")
		and rejected("implements Eq for Int: func f():") and rejected("implements Eq for Int:\nfunc f():"))


pure func test_trait_name_is_one_reference_without_qualifier_or_arguments() -> Bool:
	(accepted("implements Eq for Int:\n\tfunc f(): 1\nnext", ["f"])
		and rejected("implements m.Eq for Int:") and rejected("implements Eq[T] for Int:")
		and rejected("implements if for Int:") and rejected("implements 123 for Int:") and rejected("implements for Int:"))


pure func test_unsupported_and_missing_body_children_continue_unfiltered() -> Bool:
	-- No malformed expression bodies: exact frozen recovery ends at header/layout.
	(rejected("implements Eq for Int:\n\tprivate func f()\n\tfunc good()\nnext")
		and rejected("implements Eq for Int:\n\t123\n\tfunc good()\nnext")
		and rejected("implements Eq for Int:\n\tfunc bad():\n\tfunc good()\nnext")
		and rejected("implements Eq for Int:\n\t@unknown func bad()\n\tfunc good()\nnext"))


pure func test_missing_indent_consumes_unindented_method_siblings() -> Bool:
	text: String = "implements Eq for Int:\nfunc f()\nfunc g()"
	match composed(text):
		Some((parsed, RejectedImplementation)):
			(rejected(text) and parsed.current_kind() == EndOfFileToken and parsed.current_span().covers(40, 40)
				and parsed.issued_counts().written_types == 1 and parsed.issued_counts().name_uses == 2)
		_:
			False


-- Without a real indent the frozen owner still closes at the receiver span;
-- the rejected preview carries no owner. Pin that recovery boundary explicitly.
private pure func rejected_eof_fallback() -> Bool:
	text: String = "implements Eq for Int:"
	reference = frozen(text)
	match (composed(text), reference.definitions.get(0)):
		(Some((parsed, RejectedImplementation)), Some(owner)):
			(owner.span.covers(0, 21) and matches_frozen(parsed, reference) and parsed.current_kind() == EndOfFileToken
				and parsed.current_span().covers(22, 22) and no_bodies(parsed) and definitions_issued(parsed, 0))
		_:
			False


pure func test_dedent_span_and_eof_fallback_keep_receiver_endpoint() -> Bool:
	text: String = "implements Eq for Int:\n\tfunc f(): 1\nnext"
	match composed(text):
		Some((parsed, ParsedImplementation(preview))):
			match preview.methods:
				[method]:
					(accepted(text, ["f"]) and preview.span.covers(0, 36) and preview.receiver.span.covers(18, 21)
						and method.span.covers(24, 35) and method.function.body.is_some()
						and parsed.current_kind() == IdentifierToken and parsed.current_span().covers(36, 40)
						and rejected_eof_fallback() and rejected("implements Eq for Int:\n"))
				_:
					False
		_:
			False


pure func test_purity_is_ignored_and_annotations_reject_at_prefix_boundary() -> Bool:
	(accepted("pure implements Eq for Int:\n\tfunc f(): 1\nnext", ["f"])
		and accepted("private pure implements Eq for Int:\n\tfunc f(): 1\nnext", ["f"])
		and rejected("@no_copy implements Eq for Int:") and rejected("@unknown implements Eq for Int:"))


-- A method body the tree parser does not read declines the implementation. It
-- hands back its header, through its receiver, and keeps only the header's
-- ids: none of its methods' and no definition.
pure func test_unread_body_declines_the_implementation_with_its_header() -> Bool:
	match composed("implements Eq for Box[Int]:\n\tfunc f(x: Int) -> Int: into_opaque Count(x)\nnext"):
		Some((parsed, DeclinedImplementation(header, stop))):
			counts = parsed.issued_counts()
			(stop.reason == OpaqueConversion and header.span.covers(0, 26) and header.keyword.covers(0, 10)
				and header.receiver.span.covers(18, 26) and parsed.diagnostic_count() == 0
				and counts.name_uses == 3 and counts.written_types == 2 and counts.binders == 0
				and no_bodies(parsed) and definitions_issued(parsed, 0))
		_:
			False


-- A diagnostic in a method before a body the parser does not read still
-- rejects the implementation.
pure func test_diagnostic_before_an_unread_body_rejects_the_implementation() -> Bool:
	match composed("implements Eq for Int:\n\tfunc 123()\n\tfunc f() -> Int: into_opaque Count(1)\nnext"):
		Some((parsed, RejectedImplementation)):
			parsed.diagnostic_count() > 0
		_:
			False


pure func test_direct_earlier_start_and_existing_diagnostic_are_retained() -> Bool:
	text: String = "prefix implements Eq for Int:\n\tfunc f(): 1\nnext"
	match new_parse_state(lex_module(module_id_at_row(0), text)):
		Ok(state):
			entry = state.advanced().report_at_current(FrozenDiagnostics.ExpectedImplMethodDiagnostic)
			(parsed, result) = parse_implementation(entry, PrivateVisibility, None, state.current_span())
			match (result, parsed.diagnostics().get(0)):
				(ParsedImplementation(preview), Some(diagnostic)):
					match diagnostic.diagnostic:
						TreeDiagnostics.Plain(FrozenDiagnostics.ExpectedImplMethodDiagnostic):
							(preview.span.covers(0, 43) and preview.keyword.covers(7, 17) and preview.visibility == PrivateVisibility and preview.documentation.is_none()
								and diagnostic.span.covers(7, 7) and parsed.diagnostic_count() == 1 and definitions_issued(parsed, 2)
								and parsed.current_kind() == IdentifierToken and parsed.current_span().covers(43, 47))
						_:
							False
				_:
					False
		Err(_):
			False


tests: TestSuite = {
	description = "Implementations read in full and frozen header recovery",
	tests = [
		("private documentation receiver and child IDs", test_private_documented_bounded_receiver_and_two_methods_keep_child_ids),
		("empty region layout recovery preserves sibling", test_empty_region_owns_dedent_and_preserves_sibling),
		("grouped and function receivers", test_grouped_bounded_and_function_receivers_are_owner_types),
		("punctuation and layout omissions", test_punctuation_and_layout_omissions_follow_frozen_order),
		("single trait reference quirks", test_trait_name_is_one_reference_without_qualifier_or_arguments),
		("unsupported missing-body children continue", test_unsupported_and_missing_body_children_continue_unfiltered),
		("missing indent consumes siblings", test_missing_indent_consumes_unindented_method_siblings),
		("dedent and eof owner span", test_dedent_span_and_eof_fallback_keep_receiver_endpoint),
		("prefix purity and annotation rejection", test_purity_is_ignored_and_annotations_reject_at_prefix_boundary),
		("unread body declines the implementation with its header", test_unread_body_declines_the_implementation_with_its_header),
		("diagnostic before an unread body rejects the implementation", test_diagnostic_before_an_unread_body_rejects_the_implementation),
		("earlier start and existing diagnostic", test_direct_earlier_start_and_existing_diagnostic_are_retained)
	]
}
