		ExpectedTokenDiagnostic(ExpectedLeftParen, ExpectedRightParen, ExpectedName), LeftParenConstruct(LeftParenInFunctionName, LeftParenInTraitMethodName), RightParenConstruct(RightParenInFunctionParameters, RightParenInTupleParameterNames), NameConstruct(NameInFunctionName, NameInParameterName)
