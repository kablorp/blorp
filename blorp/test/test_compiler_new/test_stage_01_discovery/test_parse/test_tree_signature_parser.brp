-- Shared header grammar only: parameters, optional return and constraints.
import:
	../../../../src/compiler_new/stage_01_discovery/lex/lexer: lex_module
	../../../../src/compiler_new/stage_01_discovery/parse/parse_state: new_parse_state, advanced, consume_ordinary_name, current_kind, current_span, diagnostics, diagnostic_count, issued_counts, spellings, report_at_current
