	test: TestSuite


private pure func covers(span: Span, start: Int, end: Int) -> Bool:
	span.span_start() == start and span.span_end() == end


pure func test_parameter_shapes_spans_and_completion_order() -> Bool:
	text: String = "(x, y: List[T], _, _: Int, (a, b): (Int, Bool), (c, d, e), (f, g, h, i),) if"
	match new_parse_state(lex_module(module_id_at_row(3), text)):
		Ok(state):
			(parsed, result) = parse_parenthesized_parameters(state, LeftParenInFunctionName)

			match result:
				ParsedParameters([named, typed, wildcard, discard, pair, triple, quad], closing):
					match (named.binding, typed.binding, wildcard.binding, discard.binding):
						(NamedParameter(first), NamedParameter(second), WildcardParameter(wildcard_span), NamedParameter(discard_binder)):
							match (pair.binding, triple.binding, quad.binding):
								(TupleParameter(two), TupleParameter(three), TupleParameter(four)):
									match (two.names, three.names, four.names):
										(Pair(a, b), Triple(c, d, e), Quadruple(f, g, h, i)):
											match (typed.declared_type, discard.declared_type, pair.declared_type):
												(Some(list), Some(integer), Some(tuple)):
													match list.kind:
														NamedType(list_use, [TypeArgumentType(element)]):
															(first.binder.binder_local_index() == 0 and second.binder.binder_local_index() == 1 and discard_binder.binder.binder_local_index() == 2
																and a.binder.binder_local_index() == 3 and b.binder.binder_local_index() == 4 and c.binder.binder_local_index() == 5
																and d.binder.binder_local_index() == 6 and e.binder.binder_local_index() == 7 and f.binder.binder_local_index() == 8
																and g.binder.binder_local_index() == 9 and h.binder.binder_local_index() == 10 and i.binder.binder_local_index() == 11
																and list_use.use.name_use_local_index() == 0 and element.id.written_type_local_index() == 0 and list.id.written_type_local_index() == 1
																and integer.id.written_type_local_index() == 2 and tuple.id.written_type_local_index() == 5
																and named.span.covers(1, 2) and typed.span.covers(4, 14) and wildcard_span.covers(16, 17) and wildcard.span.covers(16, 17)
																and discard_binder.name.span.covers(19, 20) and discard.span.covers(19, 25) and pair.span.covers(27, 46) and two.span.covers(27, 33)
																and three.span.covers(48, 57) and four.span.covers(59, 71) and closing.covers(72, 73)
																and parsed.spellings().spelling_text(discard_binder.name.spelling) == Some("_")
																and named.declared_type.is_none() and wildcard.declared_type.is_none() and triple.declared_type.is_none() and quad.declared_type.is_none()
																and parsed.issued_counts().binders == 12 and parsed.issued_counts().name_uses == 5 and parsed.issued_counts().written_types == 6 and parsed.issued_counts().dimensions == 0
																and parsed.diagnostic_count() == 0 and parsed.current_kind() == IfKeyword and parsed.current_span().covers(74, 76))
														_:
															False
												_:
													False
										_:
											False
								_:
									False
						_:
							False
				_:
					False
		Err(_):
			False


pure func test_empty_and_multiline_trailing_comma_parameters() -> Bool:
	var correct: Bool = True

	for text in ["() if", "(\n\tx: Int,\n\t_: T,\n) if"]:
		match new_parse_state(lex_module(module_id_at_row(0), text)):
			Ok(state):
				(parsed, result) = parse_parenthesized_parameters(state, LeftParenInFunctionName)
				match result:
					ParsedParameters(parameters, closing):
						expected_count: Int = if text == "() if":
							0
						else:
							2
						correct = (parameters.length() == expected_count and closing.covers(text.length() - 4, text.length() - 3)
							and parsed.diagnostic_count() == 0 and parsed.current_kind() == IfKeyword and parsed.current_span().covers(text.length() - 2, text.length()) and correct)
					_:
						correct = False
			Err(_):
				correct = False

	correct


pure func test_signature_preserves_purity_keyword_name_and_optional_rich_return() -> Bool:
	text: String = "func transform(x: T) -> m.Result[List[T], #N] if"
	match new_parse_state(lex_module(module_id_at_row(3), text)):
		Ok(state):
			(after_name, name) = state.advanced().consume_ordinary_name(NameInFunctionName)
			match name:
				Some(name):
					(parsed, result) = parse_signature(after_name, PureFunction, state.current_span(), name, LeftParenInFunctionName)
					match result:
						ParsedSignature(signature, end):
							match signature.return_type:
								Some(target):
									match target.kind:
										QualifiedType(qualifier, result_name, [TypeArgumentType(list), DimensionArgument(dimension)]):
											(signature.purity == PureFunction and signature.keyword.covers(0, 4) and signature.name.span.spans_equal(name.span)
												and signature.parameters.length() == 1 and target.span.covers(24, 45) and end.spans_equal(target.span)
												and qualifier.use.name_use_local_index() == 1 and result_name.use.name_use_local_index() == 2
												and list.id.written_type_local_index() == 2 and target.id.written_type_local_index() == 3 and dimension.id.dimension_local_index() == 0
												and parsed.issued_counts().binders == 1 and parsed.issued_counts().name_uses == 6 and parsed.issued_counts().written_types == 4 and parsed.issued_counts().dimensions == 1
												and parsed.diagnostic_count() == 0 and parsed.current_kind() == IfKeyword and parsed.current_span().covers(46, 48))
										_:
											False
								None:
									False
						_:
							False
				None:
					False
		Err(_):
			False


pure func test_signature_without_return_ends_at_closing_parenthesis() -> Bool:
	match new_parse_state(lex_module(module_id_at_row(0), "func f() if")):
		Ok(state):
			(after_name, name) = state.advanced().consume_ordinary_name(NameInFunctionName)
			match name:
				Some(name):
					(parsed, result) = parse_signature(after_name, PureFunction, state.current_span(), name, LeftParenInFunctionName)
					match result:
						ParsedSignature(signature, end):
							signature.return_type.is_none() and signature.parameters.is_empty() and end.covers(7, 8) and parsed.current_kind() == IfKeyword and parsed.diagnostic_count() == 0
						_:
							False
				None:
					False
		Err(_):
			False


pure func test_signature_rejects_missing_return_type_with_authored_cursor() -> Bool:
	match new_parse_state(lex_module(module_id_at_row(0), "func f() -> if")):
		Ok(state):
			(after_name, name) = state.advanced().consume_ordinary_name(NameInFunctionName)
			match name:
				Some(name):
					(parsed, result) = parse_signature(after_name, PureFunction, state.current_span(), name, LeftParenInFunctionName)
					match (result, parsed.diagnostics()):
						(RejectedSignature, [at]):
							match at.diagnostic:
								Plain(ExpectedTypeDiagnostic):
									at.span.covers(12, 12) and parsed.current_kind() == EndOfFileToken and parsed.current_span().covers(14, 14) and parsed.issued_counts().written_types == 1
								_:
									False
						_:
							False
				None:
					False
		Err(_):
			False


pure func test_constraints_mint_arithmetic_children_before_parents() -> Bool:
	match new_parse_state(lex_module(module_id_at_row(3), "where #N + 1 == #M * 2, (#K - 3) == #4 if")):
		Ok(state):
			(parsed, result) = parse_dimension_constraints(state)
			match result:
				ParsedDimensionConstraints([first, second], end):
					match (first.left.kind, first.right.kind, second.left.kind, second.right.kind):
						(DimensionArithmetic(AddDimensions, left, one), DimensionArithmetic(MultiplyDimensions, right, two), DimensionArithmetic(SubtractDimensions, third, three), LiteralDimension(four)):
							match (left.kind, right.kind, third.kind):
								(NamedDimension(left_use), NamedDimension(right_use), NamedDimension(third_use)):
									(left.id.dimension_local_index() == 0 and one.id.dimension_local_index() == 1 and first.left.id.dimension_local_index() == 2
										and right.id.dimension_local_index() == 3 and two.id.dimension_local_index() == 4 and first.right.id.dimension_local_index() == 5
										and third.id.dimension_local_index() == 6 and three.id.dimension_local_index() == 7 and second.left.id.dimension_local_index() == 8 and second.right.id.dimension_local_index() == 9
										and left_use.use.name_use_local_index() == 0 and right_use.use.name_use_local_index() == 1 and third_use.use.name_use_local_index() == 2
										and four == to_int128(4) and first.span.covers(6, 22) and second.span.covers(25, 38) and end.spans_equal(second.span)
										and parsed.issued_counts().dimensions == 10 and parsed.issued_counts().name_uses == 3 and parsed.issued_counts().written_types == 0 and parsed.issued_counts().binders == 0
										and parsed.diagnostic_count() == 0 and parsed.current_kind() == IfKeyword and parsed.current_span().covers(39, 41))
								_:
									False
						_:
							False
				_:
					False
		Err(_):
			False


pure func test_absent_constraints_preserve_cursor_and_issue_no_ids() -> Bool:
	match new_parse_state(lex_module(module_id_at_row(0), "if")):
		Ok(state):
			(parsed, result) = parse_dimension_constraints(state)
			match result:
				NoDimensionConstraints:
					parsed.current_kind() == IfKeyword and parsed.current_span().covers(0, 2) and parsed.issued_counts().dimensions == 0 and parsed.diagnostic_count() == 0
				_:
					False
		Err(_):
			False


private union ExpectedDiagnostic:
	TokenDiagnostic(ExpectedTokenDiagnostic)
	PlainDiagnostic(PlainSyntaxCode)
	ReservedName


private pure func diagnostic_matches(actual: SyntaxDiagnostic, expected: ExpectedDiagnostic) -> Bool:
	match (actual, expected):
		(ExpectedToken(ExpectedLeftParen(actual)), TokenDiagnostic(ExpectedLeftParen(wanted))):
			actual == wanted
		(ExpectedToken(ExpectedRightParen(actual)), TokenDiagnostic(ExpectedRightParen(wanted))):
			actual == wanted
		(ExpectedToken(ExpectedName(actual)), TokenDiagnostic(ExpectedName(wanted))):
			actual == wanted
		(Plain(actual), PlainDiagnostic(wanted)):
			actual == wanted
		(ReservedKeywordAsName(_), ReservedName):
			True
		_:
			False


private pure func rejection_matches(text: String, is_constraint: Bool, construct: LeftParenConstruct, expected: List[(ExpectedDiagnostic, Int, Int)], cursor: TokenKind, start: Int, end: Int) -> Bool:
	match new_parse_state(lex_module(module_id_at_row(0), text)):
		Ok(state):
			(parsed, rejected) = if is_constraint:
				(parsed_state, result) = parse_dimension_constraints(state)
				is_rejected: Bool = match result:
					RejectedDimensionConstraints:
						True
					_:
						False
				(parsed_state, is_rejected)
			else:
				(parsed_state, result) = parse_parenthesized_parameters(state, construct)
				is_rejected: Bool = match result:
					RejectedParameters:
						True
					_:
						False
				(parsed_state, is_rejected)
			var correct: Bool = rejected and parsed.diagnostic_count() == expected.length()
			var index: Int = 0
			for (diagnostic, first, last) in expected:
				match parsed.diagnostics().get(index):
					Some(at):
						correct = correct and diagnostic_matches(at.diagnostic, diagnostic) and at.span.covers(first, last)
					None:
						correct = False
				index += 1
			correct and parsed.current_kind() == cursor and parsed.current_span().covers(start, end)
		Err(_):
			False


pure func test_parameter_delimiters_names_and_type_errors_reject_with_exact_recovery() -> Bool:
	(rejection_matches("if", False, LeftParenInTraitMethodName, [(TokenDiagnostic(ExpectedLeftParen(LeftParenInTraitMethodName)), 0, 0)], IfKeyword, 0, 2)
		and rejection_matches("(x", False, LeftParenInFunctionName, [(TokenDiagnostic(ExpectedRightParen(RightParenInFunctionParameters)), 2, 2)], EndOfFileToken, 2, 2)
		and rejection_matches("(123) if", False, LeftParenInFunctionName, [(TokenDiagnostic(ExpectedName(NameInParameterName)), 1, 1)], IfKeyword, 6, 8)
		and rejection_matches("(if) if", False, LeftParenInFunctionName, [(ReservedName, 1, 1)], IfKeyword, 5, 7)
		and rejection_matches("(x: ) if", False, LeftParenInFunctionName, [(PlainDiagnostic(ExpectedTypeDiagnostic), 4, 4)], IfKeyword, 6, 8))


pure func test_invalid_tuple_arities_reject_without_constructing_small_tuple() -> Bool:
	(rejection_matches("(()) if", False, LeftParenInFunctionName, [(TokenDiagnostic(ExpectedName(NameInParameterName)), 2, 2), (PlainDiagnostic(TupleArityDiagnostic), 1, 3)], IfKeyword, 5, 7)
		and rejection_matches("((a)) if", False, LeftParenInFunctionName, [(PlainDiagnostic(TupleArityDiagnostic), 1, 4)], IfKeyword, 6, 8)
		and rejection_matches("((a,b,c,d,e)) if", False, LeftParenInFunctionName, [(PlainDiagnostic(TupleArityDiagnostic), 1, 12)], IfKeyword, 14, 16))


-- `(T,)` is a rejected tuple type, while `(T)` is grouping and `(T,) -> R` a function type.
pure func test_singleton_tuple_type_rejects_but_grouping_and_function_types_do_not() -> Bool:
	var accepted: Bool = True

	for text in ["(x: (Int)) if", "(x: (Int,) -> Int) if"]:
		match new_parse_state(lex_module(module_id_at_row(0), text)):
			Ok(state):
				(parsed, result) = parse_parenthesized_parameters(state, LeftParenInFunctionName)
				match result:
					ParsedParameters(parameters, _):
						accepted = parameters.length() == 1 and parsed.diagnostic_count() == 0 and accepted
					_:
						accepted = False
			Err(_):
				accepted = False

	accepted and rejection_matches("(x: (Int,)) if", False, LeftParenInFunctionName, [(PlainDiagnostic(SingletonTupleTypeDiagnostic), 4, 10)], IfKeyword, 12, 14)


-- Tuple arity counts every authored slot even when a name cannot mint a binder.
pure func test_invalid_tuple_names_keep_authored_two_and_five_slot_arity() -> Bool:
	two_slots: Bool = rejection_matches("((123,b)) if", False, LeftParenInFunctionName, [
		(TokenDiagnostic(ExpectedName(NameInParameterName)), 2, 2)
	], IfKeyword, 10, 12)
	five_slots: Bool = rejection_matches("((123,b,c,d,e)) if", False, LeftParenInFunctionName, [
		(TokenDiagnostic(ExpectedName(NameInParameterName)), 2, 2),
		(PlainDiagnostic(TupleArityDiagnostic), 1, 14)
	], IfKeyword, 16, 18)

	two_slots and five_slots


-- A missing close uses the full current token as the frozen tuple end,
-- then still parses a following annotation and the outer parameter close.
pure func test_missing_tuple_close_arity_span_includes_current_token_fallback() -> Bool:
	rejection_matches("((a: Int) if", False, LeftParenInFunctionName, [
		(TokenDiagnostic(ExpectedRightParen(RightParenInTupleParameterNames)), 3, 3),
		(PlainDiagnostic(TupleArityDiagnostic), 1, 4)
	], IfKeyword, 10, 12)


pure func test_constraint_errors_preserve_order_and_available_dimensions() -> Bool:
	(rejection_matches("where #N #M if", True, LeftParenInFunctionName, [(PlainDiagnostic(ExpectedEqualEqualDiagnostic), 9, 9)], IfKeyword, 12, 14)
		and rejection_matches("where #N == :", True, LeftParenInFunctionName, [(PlainDiagnostic(ExpectedDimensionDiagnostic), 12, 12)], ColonSymbol, 12, 13)
		and rejection_matches("where == #N :", True, LeftParenInFunctionName, [(PlainDiagnostic(ExpectedDimensionDiagnostic), 6, 6)], ColonSymbol, 12, 13)
		and rejection_matches("where #N == #M, :", True, LeftParenInFunctionName, [
			(PlainDiagnostic(ExpectedDimensionDiagnostic), 16, 16), (PlainDiagnostic(ExpectedEqualEqualDiagnostic), 16, 16), (PlainDiagnostic(ExpectedDimensionDiagnostic), 16, 16)
		], ColonSymbol, 16, 17))


pure func test_rejection_uses_only_new_diagnostic_delta() -> Bool:
	match new_parse_state(lex_module(module_id_at_row(0), "() if")):
		Ok(state):
			seeded = state.report_at_current(ExpectedTypeDiagnostic)
			(parsed, result) = parse_parenthesized_parameters(seeded, LeftParenInFunctionName)
			match result:
				ParsedParameters([], closing):
					closing.covers(1, 2) and parsed.diagnostic_count() == 1 and parsed.current_kind() == IfKeyword
				_:
					False
		Err(_):
			False


tests: TestSuite = {
	description = "Direct tree reusable signature grammar",
	tests = [
		("invalid tuple names keep authored two and five slot arity", test_invalid_tuple_names_keep_authored_two_and_five_slot_arity),
		("missing tuple close arity span includes current token fallback", test_missing_tuple_close_arity_span_includes_current_token_fallback),
		("signature rejects missing return type with authored cursor", test_signature_rejects_missing_return_type_with_authored_cursor),
		("parameter shapes spans and completion order", test_parameter_shapes_spans_and_completion_order),
		("empty and multiline trailing comma parameters", test_empty_and_multiline_trailing_comma_parameters),
		("signature preserves purity keyword name and rich return", test_signature_preserves_purity_keyword_name_and_optional_rich_return),
		("signature without return ends at closing parenthesis", test_signature_without_return_ends_at_closing_parenthesis),
		("constraints mint arithmetic children before parents", test_constraints_mint_arithmetic_children_before_parents),
		("absent constraints preserve cursor and issue no ids", test_absent_constraints_preserve_cursor_and_issue_no_ids),
		("parameter delimiters names and type errors preserve recovery", test_parameter_delimiters_names_and_type_errors_reject_with_exact_recovery),
		("invalid tuple arities reject without constructing small tuple", test_invalid_tuple_arities_reject_without_constructing_small_tuple),
		("singleton tuple type rejects but grouping and function types do not", test_singleton_tuple_type_rejects_but_grouping_and_function_types_do_not),
		("constraint errors preserve order and dimensions", test_constraint_errors_preserve_order_and_available_dimensions),
		("rejection uses only new diagnostic delta", test_rejection_uses_only_new_diagnostic_delta)
	]
}
