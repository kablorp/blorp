	../../../../src/compiler_new/stage_01_discovery/parse/tree_signature_parser: SignatureParse(ParsedSignature, RejectedSignature), parse_signature
	../../../../src/compiler_new/stage_01_discovery/parse/tree_dimension_constraint_parser: DimensionConstraintsParse(NoDimensionConstraints, ParsedDimensionConstraints, RejectedDimensionConstraints), parse_dimension_constraints
	../../../../src/compiler_new/stage_01_discovery/syntax/declarations: ParameterBinding(NamedParameter, WildcardParameter, TupleParameter)
	../../../../src/compiler_new/stage_01_discovery/syntax/ids: binder_local_index, name_use_local_index, written_type_local_index, dimension_local_index
	../../../../src/compiler_new/stage_01_discovery/syntax/sequences: SmallTuple(Pair, Triple, Quadruple)
	../../../../src/compiler_new/stage_01_discovery/syntax/spellings: spelling_text
	../../../../src/compiler_new/stage_01_discovery/syntax/types: WrittenTypeKind(NamedType, QualifiedType), TypeArgument(TypeArgumentType, DimensionArgument), DimensionKind(NamedDimension, LiteralDimension, DimensionArithmetic), DimensionOperator(AddDimensions, MultiplyDimensions, SubtractDimensions)
	../../../../src/compiler_new/stage_01_discovery/syntax/diagnostics: SyntaxDiagnostic(ExpectedToken, Plain, ReservedKeywordAsName)
