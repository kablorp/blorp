	../../../../src/compiler_new/stage_01_discovery/lex/lexer: lex_module
	../../../../src/compiler_new/stage_01_discovery/parse/parse_state:
		MAX_SYNTAX_NESTING,
		ParseState, new_parse_state, diagnostic_count, issued_counts, issued_ids, spellings, position, current_kind, current_span
