-- The statement-and-block slice: source-order ids, exact rollback of every
-- unsupported shape, and loops over long statement lists and `else if` chains.
import:
	../../../../src/compiler_new/stage_01_discovery/lex/lexer: lex_module
	../../../../src/compiler_new/stage_01_discovery/parse/parse_state:
		ParseState, new_parse_state, diagnostic_count, issued_counts, issued_ids, spellings
	../../../../src/compiler_new/stage_01_discovery/parse/tree_declaration_preview_parser:
		DeclarationPreview(CompletedFunctionPreview, CompletedTraitPreview, CompletedImplementationPreview, FunctionDeclarationPreview, TraitDeclarationPreview, ImplementationDeclarationPreview)
	../../../../src/compiler_new/stage_01_discovery/parse/tree_module_declaration_scan:
		ModuleDeclarationPreviewScan, ModuleDeclarationScanStop(StoppedAtGlobalInitializer), scan_module_declaration_prefix_with_bodies, scan_module_declaration_prefix_with_expressions
	../../../../src/compiler_new/stage_01_discovery/syntax/dump: dumped_module
	../../../../src/compiler_new/stage_01_discovery/syntax/expressions:
		Body(BlockBody), ElseBody(ElseBlock, ElseIf), ElseBranch, ExpressionKind(If), StatementKind(Assignment, ExpressionStatement)
	../../../../src/compiler_new/stage_01_discovery/syntax/declarations: FunctionDeclaration
	../../../../src/compiler_new/stage_01_discovery/syntax/definitions: Definition(FunctionDefinition, LocalFunctionDefinition)
	../../../../src/compiler_new/stage_01_discovery/syntax/id_census: id_census
	../../../../src/compiler_new/stage_01_discovery/syntax/spellings: Spellings, spelling_count, spelling_text
	../../../../src/compiler_new/stage_01_discovery/syntax/ids: block_local_index, expression_local_index, statement_local_index
	../../../../src/compiler_new/stage_01_discovery/syntax/module_syntax: ModuleItem(FunctionItem, TraitItem, ImplementationItem), ModuleSyntax
	../../../../src/compiler_new/stage_01_discovery/tables/ids: module_id_at_row
	test: TestSuite


private pure func source_lines(lines: List[String]) -> String:
	lines.join("\n") + "\n"


private pure func joined_lines(lines: List[String]) -> String:
	lines.join("\n")


-- An interpolation hole, spelled without opening one in this file's own string.
private pure func hole(text: String) -> String:
	"$" + "{" + text + "}"


private pure func scanned(text: String) -> Option[(ParseState, ModuleDeclarationPreviewScan)]:
	match new_parse_state(lex_module(module_id_at_row(0), text)):
		Ok(state):
			Some(scan_module_declaration_prefix_with_bodies(state))
		Err(_):
			None


-- A fixture assembled from the scan's actual issued indexes, never a
-- production accepted module. Only completed functions become items.
private pure func completed_module(state: ParseState, scan: ModuleDeclarationPreviewScan) -> ModuleSyntax:
	issued = issued_ids(state)
	var items: List[ModuleItem] = []
	for declaration in scan.declarations:
		match declaration:
			CompletedFunctionPreview(function):
				items = items.append(FunctionItem(function))
			CompletedTraitPreview(owner):
				items = items.append(TraitItem(owner))
			CompletedImplementationPreview(owner):
				items = items.append(ImplementationItem(owner))
			_:
				void
	{ documentation = None, items = items, definitions = issued.definitions, imports = issued.imports, counts = issued.counts }


-- The dump of the one function `text` completes, when its scan reports nothing
-- and its ids pass the census.
private pure func completed_dump(text: String) -> Option[String]:
	match scanned(text):
		Some((state, scan)):
			syntax = completed_module(state, scan)
			if completed_count(scan) == 1 and deferred_count(scan) == 0 and state.diagnostic_count() == 0 and id_census(module_id_at_row(0), syntax).is_empty():
				Some(syntax.dumped_module(spellings(state)))
			else:
				None
		None:
			None


private pure func completed_count(scan: ModuleDeclarationPreviewScan) -> Int:
	scan.declarations
		.filter(pure func(declaration):
			match declaration:
				CompletedFunctionPreview(_): True
				_: False
		)
		.length()


private pure func completed_owner_count(scan: ModuleDeclarationPreviewScan) -> Int:
	scan.declarations
		.filter(pure func(declaration):
			match declaration:
				CompletedTraitPreview(_) | CompletedImplementationPreview(_): True
				_: False
		)
		.length()


private pure func deferred_owner_count(scan: ModuleDeclarationPreviewScan) -> Int:
	scan.declarations
		.filter(pure func(declaration):
			match declaration:
				TraitDeclarationPreview(_) | ImplementationDeclarationPreview(_): True
				_: False
		)
		.length()


private pure func deferred_count(scan: ModuleDeclarationPreviewScan) -> Int:
	scan.declarations
		.filter(pure func(declaration):
			match declaration:
				FunctionDeclarationPreview(_): True
				_: False
		)
		.length()


private pure func id_counts(state: ParseState) -> List[Int]:
	counts = state.issued_counts()
	[counts.statements, counts.blocks, counts.expressions, counts.patterns, counts.written_types,
		counts.dimensions, counts.name_uses, counts.binders, counts.type_binders]


func test_ids_follow_source_order_and_the_function_comes_last() -> Bool:
	text = source_lines(["func f(x: Int) -> Int:", "\ty = x + 1", "\ty * 2"])
	match scanned(text):
		Some((state, scan)):
			completed_module(state, scan).dumped_module(spellings(state)) == joined_lines([
				"(module",
				"  (function def0 public @0..40 (signature impure @0..4 \"f\"@5..6 (parameters (parameter @7..13 bind0:\"x\"@7..8 (named-type type0 @10..13 use0:\"Int\"@10..13))) (named-type type1 @18..21 use1:\"Int\"@18..21)) (type-parameters) (where) (block block0 @24..40",
				"    (assignment stmt0 @24..33 use2:\"y\"@24..25 (binary expr2 @28..33 add (name expr0 @28..29 use3:\"x\"@28..29) (integer expr1 @32..33 1)))",
				"    (expression-statement stmt1 @35..40 (binary expr5 @35..40 multiply (name expr3 @35..36 use4:\"y\"@35..36) (integer expr4 @39..40 2))))))"
			])
		None: False


func test_function_body_is_complete_syntax_with_an_exact_census() -> Bool:
	text = source_lines([
		"func g(xs: List[Int]) -> Int:",
		"\tvar total: Int = 0",
		"\tfor x in xs:",
		"\t\tif x < 0:",
		"\t\t\tcontinue",
		"\t\telse:",
		"\t\t\ttotal += x",
		"\twhile total > 100:",
		"\t\ttotal -= 1",
		"\txs[0] = total",
		"\tmatch total:",
		"\t\t0: total",
		"\t\tSome(v):",
		"\t\t\tv + 1",
		"\t\t_: 0",
		"\ttotal"
	])
	match scanned(text):
		Some((state, scan)):
			syntax = completed_module(state, scan)
			completed_count(scan) == 1 and deferred_count(scan) == 0 and state.diagnostic_count() == 0 and id_census(module_id_at_row(0), syntax).is_empty() and syntax.definitions.length() == 1
		None: False


-- Each shape is read in full by the frozen grammar or reported by it; this
-- slice leaves it to a later one. The scan keeps the skipped-body preview and
-- every id of the whole body is rolled back, even those minted by statements
-- the slice does support before the unsupported one.
func test_unsupported_bodies_roll_back_exactly() -> Bool:
	var correct: Bool = True
	for body in [
		["\tfor x in xs:", "\t\ty ?= f(x)"],
		["\tfor x in xs:", "\t\tif x:", "\t\t\ty: Int ?= f(x)"],
		["\ta = 1", "\t(b, c) = pair"],
		["\t_ ?= f()"],
		["\tfor (k) in pairs:", "\t\tk"],
		["\tfor (a, b, c, d, e) in rows:", "\t\ta"],
		["\tfor (a, b in pairs:", "\t\ta"],
		["\tfor (a, 1) in pairs:", "\t\ta"],
		["\t(a, b) = pair"],
		["\tx =", "\t\t1"],
		["\tvalue = if flag: 1 else: 2"],
		["\tvalue = 1 + if flag:", "\t\t1", "\telse:", "\t\t2"],
		["\tvalue = f(if flag:", "\t\t1", "\telse:", "\t\t2", "\t)"],
		["\tvalue = if flag:", "\t\t1", "\telse:", "\t\t2", "\t-z"],
		["\tvalue = match flag:", "\t\t_: 1", "\t-z"],
		["\tvalue = (if flag:", "\t\t1", "\telse:", "\t\t2)"],
		["\tfor x in xs:", "\t\tvalue = if x:", "\t\t\tbreak", "\t\telse:", "\t\t\t1"],
		["\tvalue = if flag:", "\t\t1", "\telse:", "\t\t2", "\t\t.map(f)"],
		["\tvalue = if flag:", "\t\t1", "\telse if", "\t\t2"],
		["\tvalue = if flag:", "\t\t1", "\telse:", "\t\t2", "\t.map(f)"],
		["\tfor (k, v) in pairs concurrently(limit: 2):", "\t\tk"],
		["\tfor x in xs concurrently(limit: 2):", "\t\tx"],
		["\tbreak"],
		["\tcontinue"],
		["\tf(a, b).g()", "\t\t.h()"],
		["\tmatch x:", "\t\t1: if y:", "\t\t\tz"],
		["\tmatch x:", "\t\t1: 2", "\tmatch y:", "\t\t_: 3", "\t-z"],
		["\tx: Int", "\ty"],
		["\tif a:", "\t\tb", "\telse", "\t\tc"],
		["\tp.x = 1"],
		["\ta = 1", "\tb = [", "\t\t1", "\t]"],
		["\tvalue = \"" + hole("a b") + "\""],
		["\tvalue = \"" + hole("") + "\""],
		["\tvalue = \"" + hole("first") + " and " + hole("second third") + "\""],
		["\tf = func(x):", "\t\t(a, b) = x"],
		["\tvalue = \"" + hole("(func(x): x)(1)") + "\""],
		["\ta = 1", "\tfunc helper(x: Int) -> Int:", "\t\t(a, b) = x"],
		["\tfunc helper(x: Int) -> Int"],
		["\tf = func(x: Int, y): x", "\tg = func(z): (a, b) = z"],
		["\tfor x in xs:", "\t\tf = func(): break"],
		-- A type and a pattern parsed to find their ends issue no ids that survive.
		["\tcount: Int = 1", "\tmatch count:", "\t\tSome(inner): inner", "\t(flag, other) = pair"]
	]:
		text = source_lines(["func f() -> Int:"].concat(body))
		match (scanned(text), new_parse_state(lex_module(module_id_at_row(0), text))):
			(Some((state, scan)), Ok(entry)):
				(plain, _) = scan_module_declaration_prefix_with_expressions(entry)
				same_ids: Bool = id_counts(state) == id_counts(plain)
				if completed_count(scan) != 0 or deferred_count(scan) != 1 or not same_ids:
					print("not rolled back: ${body}")
					correct = False
			_: correct = False
	correct


-- A written type and a pattern are read once to find where they end and again
-- when minted, so their ids and the name uses inside them follow the
-- expressions written before them, not the whole body's.
func test_types_and_patterns_are_minted_in_source_order() -> Bool:
	text = source_lines([
		"func f(v: Int) -> Int:",
		"\tcount: Int = v",
		"\tmatch v:",
		"\t\tSome(inner): inner",
		"\t\t_: count"
	])
	match scanned(text):
		Some((state, scan)):
			dumped = completed_module(state, scan).dumped_module(spellings(state))
			-- Header: `Int` twice (uses 0, 1). Body: the binding's `Int` (2), `v` (3),
			-- the scrutinee `v` (4), `Some` (5), `inner` (6), then the case bodies (7, 8).
			-- The replay of each type and pattern reports nothing.
			state.diagnostic_count() == 0 and dumped.split("use2:\"Int\"").length() == 2 and dumped.split("use3:\"v\"").length() == 2 and dumped.split("use4:\"v\"").length() == 2 and dumped.split("(constructor-pattern pat1 @").length() == 2 and dumped.split("use5:\"Some\"").length() == 2 and dumped.split("use6:\"inner\"").length() == 2 and dumped.split("use7:\"inner\"").length() == 2
		None: False


-- A hole's value is minted before the hole, and the string after all of them;
-- the hole's own id is an expression id.
func test_interpolation_holes_are_minted_in_source_order() -> Bool:
	text = source_lines(["func f(a: Int, b: Int):", "\t\"x " + hole("a") + " y " + hole("b + 1") + "\""])
	match scanned(text):
		Some((state, scan)):
			dumped = completed_module(state, scan).dumped_module(spellings(state))
			counts = state.issued_counts()
			completed_count(scan) == 1 and state.diagnostic_count() == 0 and counts.expressions == 7 and dumped.split("(hole expr1 ").length() == 2 and dumped.split("(name expr2 ").length() == 2 and dumped.split("(hole expr5 ").length() == 2 and dumped.split("(interpolated expr6 ").length() == 2
		None: False


-- Each method is read header, body, definition, in turn; the owner is last.
func test_owner_methods_are_minted_in_source_order() -> Bool:
	text = source_lines([
		"trait Shape:",
		"\tfunc first(x: Int) -> Int:",
		"\t\tx",
		"\tfunc second(y: Int) -> Int",
		"\tfunc third(z: Int) -> Int: z",
		"implements Shape for Int:",
		"\tfunc first(x: Int) -> Int: x",
		"\tfunc second(y: Int) -> Int: y"
	])
	match scanned(text):
		Some((state, scan)):
			syntax = completed_module(state, scan)
			dumped = syntax.dumped_module(spellings(state))
			-- Definitions: three trait methods then the trait, two implementation
			-- methods then the implementation.
			completed_owner_count(scan) == 2 and deferred_owner_count(scan) == 0 and state.diagnostic_count() == 0 and id_census(module_id_at_row(0), syntax).is_empty() and syntax.definitions.length() == 7 and dumped.split("(trait def3 ").length() == 2 and dumped.split("(implementation def6 ").length() == 2 and dumped.split("(trait-method def0 ").length() == 2 and dumped.split("(trait-method def2 ").length() == 2
		None: False


-- One body outside the slice leaves the whole owner a preview, and every id
-- its methods minted before that body is rolled back.
func test_owner_with_an_unsupported_body_stays_a_preview_with_no_ids() -> Bool:
	var correct: Bool = True
	for text in [
		source_lines(["trait Shape:", "\tfunc first(x: Int) -> Int: x", "\tfunc second(y: Int) -> Int:", "\t\t(a, b) = y"]),
		source_lines(["implements Shape for Int:", "\tfunc first(x: Int) -> Int: x", "\tfunc second(y: Int) -> Int:", "\t\t(a, b) = y"]),
	]:
		match (scanned(text), new_parse_state(lex_module(module_id_at_row(0), text))):
			(Some((state, scan)), Ok(entry)):
				(plain, _) = scan_module_declaration_prefix_with_expressions(entry)
				if completed_owner_count(scan) != 0 or deferred_owner_count(scan) != 1 or id_counts(state) != id_counts(plain) or state.diagnostic_count() != 0:
					print("owner not rolled back: ${text}")
					correct = False
			_: correct = False
	correct


-- The name each definition of the module was written with, by definition id.
private pure func definition_names(syntax: ModuleSyntax, written: Spellings) -> List[Option[String]]:
	syntax.definitions.map(pure func(definition):
		match definition:
			LocalFunctionDefinition(local): written.spelling_text(local.function.signature.name.spelling)
			FunctionDefinition(function): written.spelling_text(function.function.signature.name.spelling)
			_: None
	)


-- A local function is minted after everything declared inside it, so its
-- definition id sits before its enclosing function's; a lambda owns its
-- parameters' ids and its body's, in that order.
func test_lambda_and_local_function_ids_follow_source_order() -> Bool:
	text = source_lines([
		"func f(a: Int) -> Int:",
		"\tg = func(x: Int) -> Int: x + a",
		"\tfunc local(y: Int) -> Int:",
		"\t\tfunc inner(z: Int) -> Int: z",
		"\t\tinner(y)",
		"\tg(local(1))"
	])
	match scanned(text):
		Some((state, scan)):
			syntax = completed_module(state, scan)
			completed_count(scan) == 1 and state.diagnostic_count() == 0 and id_census(module_id_at_row(0), syntax).is_empty() and definition_names(syntax, spellings(state)) == [Some("inner"), Some("local"), Some("f")]
		None: False


-- Nested lambdas are right nesting: depth in the source is depth in the
-- parser, the minting, the dump and the census, but no walk follows a chain's
-- length with a frame per link beyond that.
func test_nested_lambdas_survive_parse_dump_and_census() -> Bool:
	depth = NESTED_LAMBDA_DEPTH
	var text: String = "func f() -> Int: "
	var level: Int = 0
	while level < depth:
		text += "func(a${level}): "
		level += 1
	text += "a0\n"
	match scanned(text):
		Some((state, scan)):
			syntax = completed_module(state, scan)
			dumped = syntax.dumped_module(spellings(state))
			completed_count(scan) == 1 and state.diagnostic_count() == 0 and id_census(module_id_at_row(0), syntax).is_empty() and state.issued_counts().expressions == depth + 1 and dumped.split("(lambda expr").length() == depth + 1
		None: False


-- How deep a lambda chain the tests carry. Measured on Linux arm64 after the
-- tuple, braced and control merges: 500 passes and 700 overflows the native
-- stack, so this keeps a margin of 2.5 below the last depth known to pass.
-- The depth that is still owed is open item D7 (section 9).
NESTED_LAMBDA_DEPTH: Int = 200


func test_break_and_continue_are_supported_only_inside_loops() -> Bool:
	inside = source_lines(["func f(xs: List[Int]):", "\tfor x in xs:", "\t\tif x:", "\t\t\tbreak", "\t\tcontinue", "\tvoid"])
	match scanned(inside):
		Some((state, scan)): completed_count(scan) == 1 and state.diagnostic_count() == 0
		None: False


-- The expression ids of a function's final `if` and of the `else if`s after
-- it, in chain order.
private pure func chain_expression_ids(function: FunctionDeclaration) -> Option[(Int, List[Int])]:
	match function.function.body:
		Some(BlockBody(block)):
			match block.last.kind:
				ExpressionStatement(outer):
					match outer.kind:
						If(first):
							var ids: List[Int] = []
							var branch: Option[ElseBranch] = first.else_branch
							while branch.is_some():
								match branch:
									Some(written):
										match written.body:
											ElseIf(else_if):
												ids = ids.append(else_if.id.expression_local_index())
												branch = else_if.conditional.else_branch
											_:
												branch = None
									None:
										branch = None
							Some((outer.id.expression_local_index(), ids))
						_:
							None
				_:
					None
		_:
			None


func test_else_if_chain_mints_inner_links_before_outer_ones() -> Bool:
	text = source_lines([
		"func f(a: Int) -> Int:",
		"\tif a:",
		"\t\t1",
		"\telse if a:",
		"\t\t2",
		"\telse if a:",
		"\t\t3",
		"\telse:",
		"\t\t4"
	])
	match scanned(text):
		Some((state, scan)):
			match scan.declarations.get(0):
				Some(CompletedFunctionPreview(function)):
					-- Source order: every condition and block, then the `else if`s
					-- from the innermost out, then the outermost `if`.
					expressions = state.issued_counts().expressions
					chain_expression_ids(function) == Some((expressions - 1, [expressions - 2, expressions - 3]))
				_: False
		None: False


-- The deferred function mints no body and no definition; the function after
-- it is the module's first definition and issues only its own statements.
func test_function_after_a_deferred_function_issues_only_its_own_ids() -> Bool:
	text = source_lines([
		"func first() -> Int:",
		"\ta = 1",
		"\t(b, c) = pair",
		"func second() -> Int:",
		"\tc = 2",
		"\tc"
	])
	match scanned(text):
		Some((state, scan)):
			counts = state.issued_counts()
			completed_count(scan) == 1 and deferred_count(scan) == 1 and state.diagnostic_count() == 0 and counts.statements == 2 and counts.blocks == 1 and counts.expressions == 2 and issued_ids(state).definitions.length() == 1
		None: False


func test_long_statement_list_is_read_and_minted_by_loops() -> Bool:
	count = 5000
	var lines: List[String] = ["func f() -> Int:"]
	var written: Int = 0
	while written < count:
		lines = lines.append("\tvalue${written} = ${written}")
		written += 1
	lines = lines.append("\tvalue0")
	match scanned(source_lines(lines)):
		Some((state, scan)):
			syntax = completed_module(state, scan)
			counts = state.issued_counts()
			completed_count(scan) == 1 and counts.statements == count + 1 and counts.blocks == 1 and id_census(module_id_at_row(0), syntax).is_empty()
		None: False


func test_deep_else_if_chain_survives_parse_dump_and_census() -> Bool:
	links = 2000
	var lines: List[String] = ["func f(a: Int) -> Int:", "\tif a:", "\t\t0"]
	var written: Int = 1
	while written < links:
		lines = lines.append("\telse if a:")
		lines = lines.append("\t\t${written}")
		written += 1
	lines = lines.append("\telse:")
	lines = lines.append("\t\t${links}")
	match scanned(source_lines(lines)):
		Some((state, scan)):
			syntax = completed_module(state, scan)
			dumped = dumped_module(syntax, spellings(state))
			counts = state.issued_counts()
			-- One block per `if`, `else if` and `else` arm, and the function's own.
			completed_count(scan) == 1 and id_census(module_id_at_row(0), syntax).is_empty() and counts.blocks == links + 2 and dumped.split("(else-if expr").length() == links
		None: False


-- A control expression is a whole value after `=` or `op=`, and its blocks
-- end on dedents. Both sides are pinned: that shape completes, and every other
-- way of continuing past a block or indenting a tail stays deferred.
func test_control_expression_is_only_a_whole_value() -> Bool:
	accepted = source_lines([
		"func f(a: Int) -> Int:",
		"\tx = if a:",
		"\t\t1",
		"\telse if a:",
		"\t\t2",
		"\telse:",
		"\t\t3",
		"\tvar y: Int = match x:",
		"\t\t0: 1",
		"\t\t_: 2",
		"\tx += if a:",
		"\t\ty",
		"\tx"
	])
	deferred = source_lines(["func f(a: Int) -> Int:", "\tx = if a:", "\t\t1", "\telse:", "\t\t2", "\t\t.tail()", "\tx"])
	global_value = source_lines(["g = if a:", "\t1", "else:", "\t2"])
	var correct: Bool = true_if_completed(accepted) and not true_if_completed(deferred)
	match new_parse_state(lex_module(module_id_at_row(0), global_value)):
		Ok(entry):
			(state, scan) = scan_module_declaration_prefix_with_expressions(entry)
			stopped = match scan.stop:
				StoppedAtGlobalInitializer(_): True
				_: False
			correct = correct and stopped and scan.declarations.is_empty() and state.issued_counts().expressions == 0
		Err(_): correct = False
	correct


private pure func true_if_completed(text: String) -> Bool:
	match scanned(text):
		Some((state, scan)):
			completed_count(scan) == 1 and deferred_count(scan) == 0 and state.diagnostic_count() == 0 and id_census(module_id_at_row(0), completed_module(state, scan)).is_empty()
		None: False


-- A value `if` mints its condition, its blocks' statements, then itself, and
-- the assignment that owns it after all of them. Swapping any two would lower
-- an owner's index below a child's.
func test_control_value_ids_follow_source_order() -> Bool:
	text = source_lines(["func f(a: Int) -> Int:", "\tx = if a:", "\t\t1", "\telse:", "\t\t2", "\tx"])
	match scanned(text):
		Some((state, scan)):
			match scan.declarations.get(0):
				Some(CompletedFunctionPreview(function)):
					match function.function.body:
						Some(BlockBody(block)):
							match block.leading.get(0):
								Some(assignment_statement):
									match assignment_statement.kind:
										Assignment(assignment):
											match assignment.value.kind:
												If(conditional):
													match conditional.else_branch:
														Some(branch):
															match branch.body:
																ElseBlock(else_block):
																	assignment_index = assignment_statement.id.statement_local_index()
																	(conditional.condition.id.expression_local_index() < assignment.value.id.expression_local_index() and conditional.then_block.last.id.statement_local_index() < else_block.last.id.statement_local_index() and else_block.last.id.statement_local_index() < assignment_index and conditional.then_block.id.block_local_index() < else_block.id.block_local_index() and id_census(module_id_at_row(0), completed_module(state, scan)).is_empty())
																_: False
														None: False
												_: False
										_: False
								None: False
						_: False
				_: False
		None: False


-- Value `if`s nest by indentation, one level per line.
func test_deeply_nested_value_ifs_survive_parse_dump_and_census() -> Bool:
	depth = 1000
	var lines: List[String] = ["func f(a: Int) -> Int:"]
	var level: Int = 0
	while level < depth:
		lines = lines.append("\t".repeat(level + 1) + "v${level} = if a:")
		level += 1
	lines = lines.append("\t".repeat(depth + 1) + "1")
	match scanned(source_lines(lines)):
		Some((state, scan)):
			syntax = completed_module(state, scan)
			dumped = dumped_module(syntax, spellings(state))
			completed_count(scan) == 1 and id_census(module_id_at_row(0), syntax).is_empty() and dumped.split("(if expr").length() == depth + 1
		None: False


func test_long_else_if_value_survives_parse_dump_and_census() -> Bool:
	links = 2000
	var lines: List[String] = ["func f(a: Int) -> Int:", "\tx = if a:", "\t\t0"]
	var written: Int = 1
	while written < links:
		lines = lines.append("\telse if a:")
		lines = lines.append("\t\t${written}")
		written += 1
	lines = lines.append("\telse:")
	lines = lines.append("\t\t${links}")
	lines = lines.append("\tx")
	match scanned(source_lines(lines)):
		Some((state, scan)):
			syntax = completed_module(state, scan)
			dumped = dumped_module(syntax, spellings(state))
			completed_count(scan) == 1 and id_census(module_id_at_row(0), syntax).is_empty() and state.issued_counts().blocks == links + 2 and dumped.split("(else-if expr").length() == links
		None: False


func test_long_match_value_survives_parse_dump_and_census() -> Bool:
	arms = 2000
	var lines: List[String] = ["func f(a: Int) -> Int:", "\tx = match a:"]
	var written: Int = 0
	while written < arms:
		lines = lines.append("\t\t${written}: ${written}")
		written += 1
	lines = lines.append("\t\t_: 0")
	lines = lines.append("\tx")
	match scanned(source_lines(lines)):
		Some((state, scan)):
			syntax = completed_module(state, scan)
			dumped = dumped_module(syntax, spellings(state))
			completed_count(scan) == 1 and id_census(module_id_at_row(0), syntax).is_empty() and dumped.split("(case @").length() == arms + 2
		None: False


-- A `with` mints its binder, type, value, error binder and error value, then its block, then itself.
func test_with_ids_follow_source_order() -> Bool:
	text = source_lines([
		"func f(p: Int):",
		"\twith r: File ?= open(p) on e => close(e):",
		"\t\tr.read()",
		"\t\tr.read()"
	])
	expected = joined_lines([
		"(module",
		"  (function def0 public @0..80 (signature impure @0..4 \"f\"@5..6 (parameters (parameter @7..13 bind0:\"p\"@7..8 (named-type type0 @10..13 use0:\"Int\"@10..13))) -) (type-parameters) (where) (block block1 @17..80",
		"    (expression-statement stmt2 @17..80 (with expr12 @17..80 (with-try @22..57 bind1:\"r\"@22..23 (named-type type1 @25..29 use1:\"File\"@25..29) (call expr2 @33..40 (name expr0 @33..37 use2:\"open\"@33..37) (arguments (name expr1 @38..39 use3:\"p\"@38..39))) (on-error @44..57 bind2:\"e\"@44..45 (call expr5 @49..57 (name expr3 @49..54 use4:\"close\"@49..54) (arguments (name expr4 @55..56 use5:\"e\"@55..56))))) (block block0 @61..80",
		"      (expression-statement stmt0 @61..69 (call expr8 @61..69 (field expr7 @61..67 (name expr6 @61..62 use6:\"r\"@61..62) use7:\"read\"@63..67) (arguments)))",
		"      (expression-statement stmt1 @72..80 (call expr11 @72..80 (field expr10 @72..78 (name expr9 @72..73 use8:\"r\"@72..73) use9:\"read\"@74..78) (arguments)))))))))"
	])
	completed_dump(text) == Some(expected)


-- A count parameter is a checked literal and mints nothing; the timeout value is minted before the block, whichever parameter is written first.
func test_concurrent_ids_follow_source_order() -> Bool:
	text = source_lines([
		"func f(t: Int):",
		"\tconcurrent(timeout: t + 1, max_threads: 4):",
		"\t\twork(t)",
		"\t\twork(t)"
	])
	expected = joined_lines([
		"(module",
		"  (function def0 public @0..80 (signature impure @0..4 \"f\"@5..6 (parameters (parameter @7..13 bind0:\"t\"@7..8 (named-type type0 @10..13 use0:\"Int\"@10..13))) -) (type-parameters) (where) (block block1 @17..80",
		"    (expression-statement stmt2 @17..80 (concurrent expr9 @17..80 (count @44..58 @44..55 4) (timeout @28..42 @28..35 (binary expr2 @37..42 add (name expr0 @37..38 use1:\"t\"@37..38) (integer expr1 @41..42 1))) (block block0 @63..80",
		"      (expression-statement stmt0 @63..70 (call expr5 @63..70 (name expr3 @63..67 use2:\"work\"@63..67) (arguments (name expr4 @68..69 use3:\"t\"@68..69))))",
		"      (expression-statement stmt1 @73..80 (call expr8 @73..80 (name expr6 @73..77 use4:\"work\"@73..77) (arguments (name expr7 @78..79 use5:\"t\"@78..79))))))))))"
	])
	completed_dump(text) == Some(expected)


-- Each arm mints its binder and channel before its block; the select follows its last arm.
func test_select_ids_follow_source_order() -> Bool:
	text = source_lines([
		"func f(a: Chan, b: Chan):",
		"\tselect:",
		"\t\tv from a:",
		"\t\t\tv",
		"\t\tsealed b:",
		"\t\t\t0",
		"\t\t_ after 3:",
		"\t\t\t1"
	])
	expected = joined_lines([
		"(module",
		"  (function def0 public @0..87 (signature impure @0..4 \"f\"@5..6 (parameters (parameter @7..14 bind0:\"a\"@7..8 (named-type type0 @10..14 use0:\"Chan\"@10..14)) (parameter @16..23 bind1:\"b\"@16..17 (named-type type1 @19..23 use1:\"Chan\"@19..23))) -) (type-parameters) (where) (block block3 @27..87",
		"    (expression-statement stmt3 @27..87 (select expr6 @27..87",
		"      (receive-arm @37..51 bind2:\"v\"@37..38 (name expr0 @44..45 use2:\"a\"@44..45) (block block0 @50..51",
		"        (expression-statement stmt0 @50..51 (name expr1 @50..51 use3:\"v\"@50..51))))",
		"      (sealed-arm @54..68 (name expr2 @61..62 use4:\"b\"@61..62) (block block1 @67..68",
		"        (expression-statement stmt1 @67..68 (integer expr3 @67..68 0))))",
		"      (after-arm @71..86 (integer expr4 @79..80 3) (block block2 @85..86",
		"        (expression-statement stmt2 @85..86 (integer expr5 @85..86 1)))))))))"
	])
	completed_dump(text) == Some(expected)


-- A `debug:` block is minted block first, then itself; `detach` follows its operand.
func test_debug_and_detach_ids_follow_source_order() -> Bool:
	text = source_lines([
		"func f(a: Int):",
		"\tdebug:",
		"\t\tshow(a)",
		"\tdetach go(a)"
	])
	expected = joined_lines([
		"(module",
		"  (function def0 public @0..47 (signature impure @0..4 \"f\"@5..6 (parameters (parameter @7..13 bind0:\"a\"@7..8 (named-type type0 @10..13 use0:\"Int\"@10..13))) -) (type-parameters) (where) (block block1 @17..47",
		"    (expression-statement stmt1 @17..33 (debug expr3 @17..33 (block block0 @26..33",
		"      (expression-statement stmt0 @26..33 (call expr2 @26..33 (name expr0 @26..30 use1:\"show\"@26..30) (arguments (name expr1 @31..32 use2:\"a\"@31..32)))))))",
		"    (expression-statement stmt2 @35..47 (detach expr7 @35..47 (call expr6 @42..47 (name expr4 @42..44 use3:\"go\"@42..44) (arguments (name expr5 @45..46 use4:\"a\"@45..46))))))))"
	])
	completed_dump(text) == Some(expected)


-- A select that is a statement's value is minted before the assignment that owns it.
func test_select_value_ids_follow_source_order() -> Bool:
	text = source_lines([
		"func f(a: Chan) -> Int:",
		"\tpicked = select:",
		"\t\tv from a:",
		"\t\t\tv",
		"\tpicked"
	])
	expected = joined_lines([
		"(module",
		"  (function def0 public @0..66 (signature impure @0..4 \"f\"@5..6 (parameters (parameter @7..14 bind0:\"a\"@7..8 (named-type type0 @10..14 use0:\"Chan\"@10..14))) (named-type type1 @19..22 use1:\"Int\"@19..22)) (type-parameters) (where) (block block1 @25..66",
		"    (assignment stmt1 @25..60 use2:\"picked\"@25..31 (select expr2 @34..60",
		"      (receive-arm @44..58 bind1:\"v\"@44..45 (name expr0 @51..52 use3:\"a\"@51..52) (block block0 @57..58",
		"        (expression-statement stmt0 @57..58 (name expr1 @57..58 use4:\"v\"@57..58))))))",
		"    (expression-statement stmt2 @60..66 (name expr3 @60..66 use5:\"picked\"@60..66)))))"
	])
	completed_dump(text) == Some(expected)


-- Each shape is read in full by the frozen grammar or reported by it; this
-- slice leaves it to a later one. Nothing the body parsed before it survives:
-- ids, diagnostics and the interned names all return to the entry state.
func test_unsupported_block_forms_roll_back_exactly() -> Bool:
	var correct: Bool = True
	for body in [
		["\twith a = x, b = y:", "\t\ta"],
		["\twith a = x", "\t\ta"],
		["\twith a:", "\t\ta"],
		["\twith a = x on e => 0:", "\t\ta"],
		["\twith a ?= x on 5 => 0:", "\t\ta"],
		["\twith a ?= x on e 0:", "\t\ta"],
		["\twith a ?= x on e => :", "\t\ta"],
		["\twith a = x: a"],
		["\twith a = x:", "\t\ta", "\t-z"],
		["\ty = with a = x:", "\t\ta"],
		["\ty = concurrent:", "\t\ta"],
		["\ty = debug:", "\t\ta"],
		["\t1 + with a = x:", "\t\ta"],
		["\tf(with a = x:", "\t\ta", "\t)"],
		["\tfor x in xs:", "\t\twith a = f(x):", "\t\t\tb ?= g(a)"],
		["\tfor x in xs:", "\t\tconcurrent:", "\t\t\tbreak"],
		["\tfor x in xs:", "\t\tconcurrent:", "\t\t\tcontinue"],
		["\tconcurrent():", "\t\ta"],
		["\tconcurrent(max_threads: 0):", "\t\ta"],
		["\tconcurrent(max_threads: -1):", "\t\ta"],
		["\tconcurrent(max_threads: n):", "\t\ta"],
		["\tconcurrent(max_threads: 2 + 1):", "\t\ta"],
		["\tconcurrent(max_threads: 9223372036854775808):", "\t\ta"],
		["\tconcurrent(max_threads: 2, max_threads: 3):", "\t\ta"],
		["\tconcurrent(timeout: 1, timeout: 2):", "\t\ta"],
		["\tconcurrent(limit: 2):", "\t\ta"],
		["\tconcurrent(max_threads: 2 timeout: 3):", "\t\ta"],
		["\tconcurrent(max_threads: 2:", "\t\ta"],
		["\tconcurrent(max_threads 2):", "\t\ta"],
		["\tconcurrent(,):", "\t\ta"],
		["\tconcurrent a:", "\t\ta"],
		["\tconcurrent:", "\ta"],
		["\tconcurrent: a"],
		["\tconcurrent:", "\t\ta", "\t-z"],
		["\tdebug.print(x)"],
		["\tdebug: x"],
		["\tdebug:", "\ta"],
		["\tmatch xs:", "\t\t_: with a = x:", "\t\t\ta"],
		["\tmatch xs:", "\t\t_: concurrent:", "\t\t\ta"],
		["\tmatch xs:", "\t\t_: debug:", "\t\t\ta"],
		["\tmatch xs:", "\t\t_: select:", "\t\t\tv from xs:", "\t\t\t\tv"],
		-- A supported statement before the unsupported form leaves no ids behind.
		["\ta = 1", "\tdebug:", "\t\tb = 2", "\twith r = x:", "\t\tc", "\tconcurrent(max_threads: 0):", "\t\td"],
		["\tselect:", "\t\tv from xs:", "\t\t\tv", "\twith r = x, s = y:", "\t\tr"],
		-- A lambda whose block ends on a later line cannot end the header's line.
		["\twith r = open(func():", "\t\t1", "\t):", "\t\tr"],
		["\tselect:", "\t\tv from pick(func():", "\t\t\txs", "\t\t):", "\t\t\tv"],
		["\tconcurrent(timeout: pick(func():", "\t\t5", "\t)):", "\t\tf()"],
		["\tdetach"],
		["\tdetach with a = x:", "\t\ta"],
		["\tdetach f(x)", "\t\t.g()"],
		["\tselect:"],
		["\tselect", "\t\tv from xs:", "\t\t\tv"],
		["\tselect:", "\t\tafter from xs:", "\t\t\t0"],
		["\tselect:", "\t\tv from xs", "\t\t\tv"],
		["\tselect:", "\t\tv xs:", "\t\t\tv"],
		["\tselect:", "\t\tsealed:", "\t\t\t0"],
		["\tselect:", "\t\t_ after:", "\t\t\t0"],
		["\tselect:", "\t\tv from xs: v"],
		["\tselect:", "\t\tv from xs:", "\t\t\tv", "\t-z"],
		["\tfor x in xs:", "\t\ty = select:", "\t\t\tv from x:", "\t\t\t\tbreak"],
		["\ty = select:", "\t\tv from xs:", "\t\t\tv", "\t.map(f)"]
	]:
		text = source_lines(["func f(xs: List[Int]) -> Int:"].concat(body))
		match (scanned(text), new_parse_state(lex_module(module_id_at_row(0), text))):
			(Some((state, scan)), Ok(entry)):
				(plain, _) = scan_module_declaration_prefix_with_expressions(entry)
				same_state: Bool = id_counts(state) == id_counts(plain) and state.diagnostic_count() == plain.diagnostic_count() and spelling_count(spellings(state)) == spelling_count(spellings(plain))
				if completed_count(scan) != 0 or deferred_count(scan) != 1 or not same_state:
					print("not rolled back: ${body}")
					correct = False
			_: correct = False
	correct


-- `break` and `continue` leave the loop around a `with`, `debug` or `select`,
-- and so does a `?=`'s refusal; a `concurrent` block is a task of its own, so
-- it leaves every loop outside itself.
func test_block_forms_follow_the_enclosing_loop_scope() -> Bool:
	var correct: Bool = True
	for body in [
		["\tfor x in xs:", "\t\twith r = open(x):", "\t\t\tbreak"],
		["\tfor x in xs:", "\t\tdebug:", "\t\t\tcontinue"],
		["\tfor x in xs:", "\t\twith a ?= f(x):", "\t\t\ta"],
		["\tfor x in xs:", "\t\tselect:", "\t\t\tv from x:", "\t\t\t\tbreak", "\t\t\tsealed x:", "\t\t\t\tcontinue"],
		["\tfor x in xs:", "\t\tconcurrent:", "\t\t\tgot ?= load(x)", "\t\t\tgot"],
		["\tfor x in xs:", "\t\tconcurrent:", "\t\t\tfor y in x:", "\t\t\t\tbreak"],
		["\twith r = open(xs):", "\t\tgot ?= load(r)", "\t\tgot"]
	]:
		if not true_if_completed(source_lines(["func f(xs: List[Int]) -> Int:"].concat(body).concat(["\t0"]))):
			print("not completed: ${body}")
			correct = False
	correct


-- Blocks nest by indentation, one level per form.
private pure func nested_with_lines(depth: Int) -> List[String]:
	var lines: List[String] = ["func f(p: Int) -> Int:"]
	var level: Int = 0
	while level < depth:
		lines = lines.append("\t".repeat(level + 1) + "with r${level} = open(p):")
		level += 1
	lines.append("\t".repeat(depth + 1) + "1")


private pure func nested_concurrent_lines(depth: Int) -> List[String]:
	var lines: List[String] = ["func f(p: Int) -> Int:"]
	var level: Int = 0
	while level < depth:
		lines = lines.append("\t".repeat(level + 1) + "concurrent(max_threads: 2, timeout: p):")
		level += 1
	lines.append("\t".repeat(depth + 1) + "1")


private pure func nested_debug_lines(depth: Int) -> List[String]:
	var lines: List[String] = ["func f(p: Int) -> Int:"]
	var level: Int = 0
	while level < depth:
		lines = lines.append("\t".repeat(level + 1) + "debug:")
		level += 1
	lines.append("\t".repeat(depth + 1) + "1")


-- A `select` nests two levels of indentation per level: its arm, then its block.
private pure func nested_select_lines(depth: Int) -> List[String]:
	var lines: List[String] = ["func f(p: Int) -> Int:"]
	var level: Int = 0
	while level < depth:
		lines = lines.append("\t".repeat(2 * level + 1) + "select:")
		lines = lines.append("\t".repeat(2 * level + 2) + "v${level} from p:")
		level += 1
	lines.append("\t".repeat(2 * depth + 1) + "1")


-- Whether `lines` complete as one function whose dump holds `form` exactly
-- `count` times.
private pure func nests_to_depth(lines: List[String], form: String, count: Int) -> Bool:
	match scanned(source_lines(lines)):
		Some((state, scan)):
			syntax = completed_module(state, scan)
			completed_count(scan) == 1 and state.diagnostic_count() == 0 and id_census(module_id_at_row(0), syntax).is_empty() and dumped_module(syntax, spellings(state)).split(form).length() == count + 1
		None: False


func test_deeply_nested_with_blocks_survive_parse_dump_and_census() -> Bool:
	depth = 1000
	nests_to_depth(nested_with_lines(depth), "(with expr", depth)


func test_deeply_nested_concurrent_blocks_survive_parse_dump_and_census() -> Bool:
	depth = 1000
	nests_to_depth(nested_concurrent_lines(depth), "(concurrent expr", depth)


func test_deeply_nested_debug_blocks_survive_parse_dump_and_census() -> Bool:
	depth = 1000
	nests_to_depth(nested_debug_lines(depth), "(debug expr", depth)


func test_deeply_nested_selects_survive_parse_dump_and_census() -> Bool:
	depth = 1000
	nests_to_depth(nested_select_lines(depth), "(select expr", depth)


func test_long_select_survives_parse_dump_and_census() -> Bool:
	arms = 2000
	var lines: List[String] = ["func f(p: Int) -> Int:", "\tx = select:"]
	var written: Int = 0
	while written < arms:
		lines = lines.append("\t\tv${written} from p:")
		lines = lines.append("\t\t\t${written}")
		written += 1
	lines = lines.append("\tx")
	nests_to_depth(lines, "(receive-arm @", arms)


tests: TestSuite = {
	description = "Tree statements, blocks and function bodies",
	tests = [
		("ids follow source order and the function comes last", test_ids_follow_source_order_and_the_function_comes_last),
		("a function body is complete syntax with an exact census", test_function_body_is_complete_syntax_with_an_exact_census),
		("unsupported bodies roll back exactly", test_unsupported_bodies_roll_back_exactly),
		("types and patterns are minted in source order", test_types_and_patterns_are_minted_in_source_order),
		("interpolation holes are minted in source order", test_interpolation_holes_are_minted_in_source_order),
		("owner methods are minted in source order", test_owner_methods_are_minted_in_source_order),
		("an owner with an unsupported body stays a preview", test_owner_with_an_unsupported_body_stays_a_preview_with_no_ids),
		("lambda and local function ids follow source order", test_lambda_and_local_function_ids_follow_source_order),
		("nested lambdas", test_nested_lambdas_survive_parse_dump_and_census),
		("break and continue are supported only inside loops", test_break_and_continue_are_supported_only_inside_loops),
		("else if links are minted inner before outer", test_else_if_chain_mints_inner_links_before_outer_ones),
		("a function after a deferred function issues only its own ids", test_function_after_a_deferred_function_issues_only_its_own_ids),
		("5000 statements", test_long_statement_list_is_read_and_minted_by_loops),
		("2000 link else if chain", test_deep_else_if_chain_survives_parse_dump_and_census),
		("a control expression is only a whole value", test_control_expression_is_only_a_whole_value),
		("control value ids follow source order", test_control_value_ids_follow_source_order),
		("1000 nested value ifs", test_deeply_nested_value_ifs_survive_parse_dump_and_census),
		("2000 link else if value", test_long_else_if_value_survives_parse_dump_and_census),
		("2000 arm match value", test_long_match_value_survives_parse_dump_and_census),
		("with ids follow source order", test_with_ids_follow_source_order),
		("concurrent ids follow source order", test_concurrent_ids_follow_source_order),
		("select ids follow source order", test_select_ids_follow_source_order),
		("debug and detach ids follow source order", test_debug_and_detach_ids_follow_source_order),
		("select value ids follow source order", test_select_value_ids_follow_source_order),
		("unsupported block forms roll back exactly", test_unsupported_block_forms_roll_back_exactly),
		("block forms follow the enclosing loop scope", test_block_forms_follow_the_enclosing_loop_scope),
		("1000 nested with blocks", test_deeply_nested_with_blocks_survive_parse_dump_and_census),
		("1000 nested concurrent blocks", test_deeply_nested_concurrent_blocks_survive_parse_dump_and_census),
		("1000 nested debug blocks", test_deeply_nested_debug_blocks_survive_parse_dump_and_census),
		("1000 nested selects", test_deeply_nested_selects_survive_parse_dump_and_census),
		("2000 arm select", test_long_select_survives_parse_dump_and_census)
	]
}
